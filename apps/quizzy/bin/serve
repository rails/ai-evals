#!/usr/bin/env bash
# Starts the app in production mode on $PORT (default 3000), plain HTTP:
# Thruster serves the app and AnyCable WebSockets (/cable), proxying to Puma.
set -euo pipefail
cd "$(dirname "$0")/.."

export RAILS_ENV="${RAILS_ENV:-production}"
export PORT="${PORT:-3000}"

# Keep a generated secret in storage/ when none is given, so sessions survive restarts
if [ -z "${SECRET_KEY_BASE:-}" ]; then
  mkdir -p storage
  [ -s storage/secret_key_base ] || bin/rails secret > storage/secret_key_base
  SECRET_KEY_BASE="$(cat storage/secret_key_base)"
  export SECRET_KEY_BASE
fi
# Rails signs Turbo stream names with the AnyCable secret, and AnyCable verifies them
export ANYCABLE_SECRET="${ANYCABLE_SECRET:-$SECRET_KEY_BASE}"
export ANYCABLE_DISABLE_TELEMETRY=true

bin/rails db:prepare
bin/rails assets:precompile

export HTTP_PORT="$PORT" TARGET_PORT="$((PORT + 1))"
exec bin/thrust bin/rails server
