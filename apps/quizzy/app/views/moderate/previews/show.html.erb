<% content_for :title, "Preview · #{@quiz.title}" %>

<div class="preview-banner">
  <span>Preview · answers are not saved</span>
  <span class="buttons">
    <%= button_to "Start over", moderate_quiz_preview_path(@quiz), method: :delete, class: "btn btn--light btn--sm" %>
    <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
  </span>
</div>

<div class="play">
  <div class="play__top">
    <%= logo class: "play__logo" %>
  </div>

  <% if @questions.empty? %>
    <div class="play__body"><p class="play-lead">The quiz has no active questions.</p></div>
  <% elsif @question %>
    <% picked = @answers[@question.id.to_s] %>
    <div class="play__body play__body--top">
      <%= render "shared/play_question", question: @question, number: @step + 1, total: @questions.size,
            picked:, reveal: !picked.nil?,
            answer_url: (moderate_quiz_preview_path(@quiz) if picked.nil?), extra_params: {step: @step} %>

      <% unless picked.nil? %>
        <div class="play-status <%= @question.correct_option?(picked) ? "play-status--right" : "play-status--wrong" %>">
          <%= @question.correct_option?(picked) ? "Correct!" : "Wrong!" %>
        </div>
        <div class="buttons mt-2">
          <%= link_to @step + 1 < @questions.size ? "Next question" : "See score", moderate_quiz_preview_path(@quiz, step: @step + 1), class: "btn btn--pink" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="play__body">
      <div class="result-card">
        <div class="result-card__place"><span class="result-card__prefix">Score:</span> <%= @score %>/<%= @questions.size %></div>
        <div class="result-card__label">correct answers</div>
        <div class="buttons" style="justify-content: center">
          <%= button_to "Start over", moderate_quiz_preview_path(@quiz), method: :delete, class: "btn btn--pink" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
