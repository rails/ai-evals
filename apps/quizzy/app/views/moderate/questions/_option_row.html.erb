<div class="option-row" data-options-target="row">
  <%= text_field_tag "question[options][#{index}][title]", option["title"], class: "input", placeholder: "Option #{number}", "aria-label": "Option #{number}", data: {label: "Option %"} %>
  <label class="checkbox">
    <%= hidden_field_tag "question[options][#{index}][correct]", "0", id: nil %>
    <%= check_box_tag "question[options][#{index}][correct]", "1", option["correct"], id: nil, "aria-label": "Option #{number} is correct", data: {label: "Option % is correct"} %>
    Correct
  </label>
  <button type="button" class="btn btn--danger btn--icon" data-action="options#remove" title="Remove option" aria-label="Remove option <%= number %>" data-label="Remove option %">✕</button>
</div>
