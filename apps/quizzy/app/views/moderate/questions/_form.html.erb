<%= form_with model: question.new_record? ? [:moderate, question.quiz, question] : [:moderate, question], class: "card", data: {controller: "options"} do |f| %>
  <%= render "shared/errors", record: question %>

  <div class="field">
    <%= f.label :body, "Question" %>
    <%= f.text_area :body, class: "input", required: true, autofocus: question.new_record?, rows: 3 %>
  </div>

  <div class="field">
    <span class="field-label">Options</span>
    <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
  </div>

  <div class="option-rows" data-options-target="list">
    <% question.options.each_with_index do |option, index| %>
      <%= render "moderate/questions/option_row", index:, number: index + 1, option: %>
    <% end %>
  </div>

  <template data-options-target="template">
    <%= render "moderate/questions/option_row", index: "NEW_INDEX", number: "NEW_NUMBER", option: {} %>
  </template>

  <div class="buttons" style="margin-bottom: 28px">
    <button type="button" class="btn btn--ghost btn--sm" data-action="options#add">+ Add option</button>
  </div>

  <div class="field">
    <label class="checkbox">
      <%= f.check_box :active %>
      Active
    </label>
    <span class="field-hint">Only active questions are played.</span>
  </div>

  <div class="buttons">
    <%= f.submit "Save question", class: "btn btn--pink" %>
    <%= link_to "Cancel", moderate_quiz_path(question.quiz), class: "btn btn--ghost" %>
  </div>
<% end %>
