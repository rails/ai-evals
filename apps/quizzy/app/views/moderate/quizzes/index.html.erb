<% content_for :title, "Quizzes · Moderator" %>

<div class="page-head">
  <h1>Quizzes</h1>
  <div class="buttons">
    <%= link_to "Import quiz", new_moderate_import_path, class: "btn btn--ghost" %>
    <%= link_to "New quiz", new_moderate_quiz_path, class: "btn btn--pink" %>
  </div>
</div>

<% if @quizzes.any? %>
  <ul class="quiz-list">
    <% @quizzes.each do |quiz| %>
      <li id="<%= dom_id(quiz) %>">
        <%= link_to moderate_quiz_path(quiz), class: "card quiz-tile" do %>
          <h3><%= quiz.title %></h3>
          <div class="meta">
            <%= t("counts.questions", count: quiz.questions.size) %>,
            <%= quiz.active_questions.size %> active ·
            <%= t("counts.runs", count: quiz.runs.size) %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="empty">No quizzes yet. Create the first one!</div>
<% end %>
