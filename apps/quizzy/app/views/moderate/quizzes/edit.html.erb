<% content_for :title, "Settings · #{@quiz.title}" %>

<div class="breadcrumbs"><%= link_to "← #{@quiz.title}", moderate_quiz_path(@quiz) %></div>
<div class="page-head"><h1>Settings</h1></div>

<%= render "form", quiz: @quiz %>

<div class="section">
  <%= button_to "Delete quiz", moderate_quiz_path(@quiz), method: :delete, class: "btn btn--danger",
        form: {data: {turbo_confirm: "Delete this quiz with all its questions and games?"}} %>
</div>
