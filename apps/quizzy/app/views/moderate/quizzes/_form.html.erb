<%= form_with model: [:moderate, quiz], class: "card" do |f| %>
  <%= render "shared/errors", record: quiz %>

  <div class="field">
    <%= f.label :title, "Title" %>
    <%= f.text_field :title, class: "input", required: true, autofocus: quiz.new_record?, placeholder: "Friday keynote quiz" %>
  </div>

  <div class="field">
    <%= f.label :winners_count, "Number of winners" %>
    <%= f.number_field :winners_count, class: "input input--number", min: 1, required: true %>
    <span class="field-hint">How many players get a prize. Pick them from the leaderboard or draw them.</span>
  </div>

  <fieldset class="field field--inline">
    <legend>Timer</legend>
    <div class="timer-fields">
      <%= f.label :timer_minutes, "Timer minutes", class: "visually-hidden" %>
      <%= f.number_field :timer_minutes, class: "input input--number", min: 0, max: 59, required: true %>
      <span aria-hidden="true">min</span>
      <%= f.label :timer_seconds, "Timer seconds", class: "visually-hidden" %>
      <%= f.number_field :timer_seconds, class: "input input--number", min: 0, max: 59, required: true %>
      <span aria-hidden="true">sec</span>
    </div>
    <span class="field-hint">Time per question. When it runs out, the question finishes by itself. 0 min 0 sec turns the timer off.</span>
  </fieldset>

  <div class="buttons">
    <%= f.submit "Save quiz", class: "btn btn--pink" %>
    <%= link_to "Cancel", quiz.new_record? ? moderate_root_path : moderate_quiz_path(quiz), class: "btn btn--ghost" %>
  </div>
<% end %>
