<% winners_count = run.quiz.winners_count %>
<% leaders = run.leaderboard.limit([10, winners_count].max).to_a %>
<% extra_winners = run.winners.where.not(id: leaders.map(&:id)).to_a %>
<% any_winners = leaders.any?(&:winner?) || extra_winners.any? %>
<% tied_ids = any_winners ? [] : run.cutoff_ties.map(&:id) %>
<section class="cover cover--night">
  <div class="screen">
    <div class="screen__top">
      <%= logo class: "screen__logo" %>
      <span><%= run.quiz.title %></span>
    </div>
    <div class="screen__body">
      <div class="leaderboard-layout">
        <div>
          <p class="screen__kicker">The quiz is over</p>
          <h1 class="leaderboard-layout__title"><%= any_winners ? "Winners!" : "Leaderboard" %></h1>
          <p class="counter-pill"><%= t("counts.participants", count: run.participations.count) %></p>
          <% if tied_ids.any? %>
            <p class="mt-2">
              <%= t("counts.participants", count: tied_ids.size) %> share the score at the prize cutoff.
              You can draw the remaining places.
            </p>
          <% end %>
        </div>
        <% if leaders.any? %>
          <ol class="leaderboard" aria-label="Leaderboard">
            <% (leaders + extra_winners).each do |participation| %>
              <li class="leader <%= "is-winner" if participation.winner? %> <%= "is-tied" if tied_ids.include?(participation.id) %>" id="<%= dom_id(participation) %>">
                <span class="leader__place"><%= leaders.index(participation)&.+(1) || "…" %></span>
                <span class="leader__name"><%= participation.name %><% if participation.winner? %> <span class="leader__badge">Winner</span><% end %></span>
                <span class="leader__score">
                  <%= t("counts.points", count: participation.score) %>
                  <% if participation.score.positive? %><span class="leader__time"><%= format_duration(participation.correct_time_ms) %></span><% end %>
                </span>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p>Nobody played.</p>
        <% end %>
      </div>
    </div>
  </div>
</section>
