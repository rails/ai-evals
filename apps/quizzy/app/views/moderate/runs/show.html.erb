<% content_for :title, "#{@run.quiz.title} · #{@run.code}" %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @run, :moderator %>
<%= presence_source @run, id: "quizzy-screen-#{@run.code}", watcher: true %>

<%= tag.div class: "game", data: {
      controller: ("countdown" if @run.question_deadline && @run.showing_question?),
      countdown_deadline_value: @run.question_deadline&.iso8601(3),
      countdown_now_value: Time.current.iso8601(3)
    } do %>
  <% if @run.idle? %>
    <%= render "lobby", run: @run %>
  <% elsif @run.running? && @question %>
    <%= render "stage_question", run: @run, question: @question %>
  <% else %>
    <%= render "leaderboard", run: @run %>
  <% end %>

  <nav class="screen-controls" aria-label="Game controls">
    <div class="screen-controls__info">
      <%= link_to "← Back to quiz", moderate_quiz_path(@run.quiz) %>
      <span>Code: <strong><%= @run.code %></strong></span>
      <%= render "participants_counter", run: @run %>
      <% if @run.finished? %><%= link_to "Responses", moderate_run_responses_path(@run), target: "_blank", rel: "noopener" %><% end %>
      <% if @run.running? && @question %>
        <%= render "answers_counter", run: @run, question: @question %>
      <% end %>
    </div>

    <div class="buttons">
      <% if @run.idle? %>
        <%= button_to "Start", start_moderate_run_path(@run), class: "btn btn--pink btn--lg" %>
      <% elsif @run.running? && @run.showing_question? %>
        <%= button_to "Finish", close_question_moderate_run_path(@run), class: "btn btn--pink btn--lg",
              form: {data: {countdown_target: "finish"}} %>
      <% elsif @run.running? %>
        <%= button_to @run.last_question? ? "End quiz" : "Next", advance_moderate_run_path(@run), class: "btn btn--pink btn--lg" %>
      <% elsif @run.finished? %>
        <%= button_to "Top #{@run.quiz.winners_count}", pick_winners_moderate_run_path(@run), class: "btn btn--light",
              title: "Winners are the top places of the leaderboard (on equal points, the faster player ranks higher)" %>
        <%= button_to "Draw", pick_winners_moderate_run_path(@run, random: 1), class: "btn btn--pink",
              title: "Draw the remaining prizes at random among the players tied at the cutoff" %>
        <% if @run.winners.exists? %>
          <%= button_to "Reset winners", winners_moderate_run_path(@run), method: :delete, class: "btn btn--light" %>
        <% end %>
      <% end %>
    </div>
  </nav>
<% end %>
