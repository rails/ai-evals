<% content_for :title, "Responses · #{@run.quiz.title} · #{@run.code}" %>

<%= render "moderate/runs/responses_header", run: @run %>

<div class="page-head">
  <div>
    <h1>Responses</h1>
    <div class="meta mt-2">
      Game <%= @run.code %> of <%= l @run.created_at, format: :short %> ·
      <%= t("counts.participants", count: @participations.size) %> ·
      <%= t("counts.questions", count: @questions.size) %>
    </div>
  </div>
</div>

<nav class="tabs" aria-label="View">
  <%= link_to "By question", moderate_run_responses_path(@run), class: ["tab", ("is-active" if @tab == "questions")] %>
  <%= link_to "By player", moderate_run_responses_path(@run, tab: "participants"), class: ["tab", ("is-active" if @tab == "participants")] %>
</nav>

<div class="card">
  <% if @tab == "questions" %>
    <table class="runs-table">
      <thead>
        <tr><th>#</th><th>Question</th><th>Answers</th><th>Correct</th></tr>
      </thead>
      <tbody>
        <% @questions.each_with_index do |question, index| %>
          <% answered = @answers_count.fetch(question.id, 0) %>
          <% correct = @correct_count.fetch(question.id, 0) %>
          <tr id="<%= dom_id(question) %>">
            <td><%= index + 1 %></td>
            <td><%= link_to question.body, moderate_run_question_response_path(@run, question) %></td>
            <td><%= answered %> / <%= @participations.size %></td>
            <td>
              <%= correct %>
              <% if answered.positive? %><span class="muted">(<%= number_to_percentage(correct * 100.0 / answered, precision: 0) %>)</span><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% elsif @participations.any? %>
    <table class="runs-table">
      <thead>
        <tr><th>Place</th><th>Player</th><th>Points</th><th>Time of correct answers</th></tr>
      </thead>
      <tbody>
        <% @participations.each_with_index do |participation, index| %>
          <tr id="<%= dom_id(participation) %>">
            <td><%= index + 1 %></td>
            <td>
              <%= link_to participation.name, moderate_run_participant_response_path(@run, participation) %>
              <% if participation.winner? %><span class="mark mark--winner">winner</span><% end %>
            </td>
            <td><%= participation.score %></td>
            <td><%= format_duration(participation.correct_time_ms) if participation.score.positive? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted">Nobody played.</p>
  <% end %>
</div>
