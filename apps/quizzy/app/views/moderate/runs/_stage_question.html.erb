<% results = run.showing_results? %>
<% counts = results ? run.answers_for(question).group(:option_index).count : {} %>
<% total = counts.values.sum %>
<section class="cover cover--blue cover--calm">
  <div class="screen">
    <div class="screen__top">
      <%= logo class: "screen__logo" %>
      <span><%= run.quiz.title %></span>
    </div>
    <div class="screen__body">
      <div class="stage-question__head">
        <div class="stage-question__num"><%= question_progress(run.current_question_number, run.questions.size) %></div>
        <% if run.showing_question? && run.question_deadline %>
          <div class="countdown" data-countdown-target="display" aria-label="Time left" role="timer"></div>
        <% end %>
      </div>
      <div class="stage-question__body"><%= question.body %></div>
      <ol class="stage-options <%= "stage-options--results" if results %>">
        <% question.options.each_with_index do |option, index| %>
          <% count = counts.fetch(index, 0) %>
          <li class="stage-option <%= "is-correct" if results && option["correct"] %>"
              style="--share: <%= total.zero? ? 0 : (count * 100.0 / total).round(1) %>%">
            <% if results %><span class="stage-option__bar"></span><% end %>
            <span class="stage-option__letter"><%= option_letter(index) %></span>
            <span class="stage-option__title"><%= option["title"] %></span>
            <% if results && option["correct"] %><span class="stage-option__mark">Correct</span><% end %>
            <% if results %><span class="stage-option__count" title="Answers"><%= count %></span><% end %>
          </li>
        <% end %>
      </ol>
    </div>
  </div>
</section>
