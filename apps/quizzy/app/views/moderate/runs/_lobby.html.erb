<% url = play_url(run) %>
<section class="cover">
  <div class="screen">
    <div class="screen__top">
      <%= logo class: "screen__logo" %>
      <span>Game <%= run.code %></span>
    </div>
    <div class="screen__body">
      <div class="lobby">
        <div>
          <h1 class="lobby__title"><%= run.quiz.title %></h1>
          <div class="lobby__join">Scan the QR code or open</div>
          <div class="lobby__url"><%= url.delete_prefix("https://").delete_prefix("http://") %></div>
          <div class="counter-pill">
            Players: <strong id="lobby_participants_counter" data-presence-count><%= run.participations.count %></strong>
          </div>
        </div>
        <div class="qr" role="img" aria-label="QR code with the link <%= url %>"><%= qr_code_svg(url) %></div>
      </div>
    </div>
  </div>
</section>
