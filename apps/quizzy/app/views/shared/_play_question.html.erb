<%# Participant view of a question.
    Locals: question, number, total, picked (option index or nil),
            reveal (show correct answers), answer_url (nil when answering is closed),
            extra_params (hidden fields to submit with the answer) %>
<% locked = answer_url.nil? %>
<div class="play-question__num"><%= question_progress(number, total) %></div>
<div class="play-question__body"><%= question.body %></div>

<div class="play-options <%= "is-locked" if locked %> <%= "is-revealed" if reveal %>">
  <% question.options.each_with_index do |option, index| %>
    <% classes = ["play-option", ("is-picked" if picked == index), ("is-correct" if reveal && option["correct"])] %>
    <% content = capture do %>
      <span class="play-option__letter"><%= option_letter(index) %></span>
      <span class="play-option__title"><%= option["title"] %></span>
      <% if picked == index %><span class="play-option__mark">Your answer</span><% end %>
      <% if reveal && option["correct"] %><span class="play-option__mark">Correct answer</span><% end %>
    <% end %>
    <% if locked %>
      <div class="<%= classes.compact.join(" ") %>"><%= content %></div>
    <% else %>
      <%= button_to answer_url, params: {question_id: question.id, option_index: index, **extra_params}, class: classes.compact.join(" ") do %>
        <%= content %>
      <% end %>
    <% end %>
  <% end %>
</div>
