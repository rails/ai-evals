<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Quizzy" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Quizzy">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#e9e6ff">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <%# Lets the AnyCable client catch up on broadcasts made between rendering and connecting %>
    <meta name="cable-history-timestamp" content="<%= Time.now.to_i %>">

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class) %>">
    <%= content_for?(:content) ? yield(:content) : yield %>
    <%= flash_messages %>
  </body>
</html>
