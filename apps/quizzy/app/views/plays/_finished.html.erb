<% place = @participation.place %>
<div class="play__body">
  <div class="result-card">
    <p class="play-lead">The quiz is over</p>
    <div class="result-card__place" aria-hidden="true"><%= place %></div>
    <div class="result-card__label">Place <%= place %> of <%= @run.participations.count %></div>
    <div class="result-card__score"><%= t("counts.points", count: @participation.score) %></div>
    <% if @participation.winner? %>
      <div class="winner-banner">
        You won!
        <small>Come to the organizers' desk for your prize</small>
      </div>
    <% else %>
      <p class="play-lead mt-2">Thanks for playing!</p>
    <% end %>
  </div>
</div>
