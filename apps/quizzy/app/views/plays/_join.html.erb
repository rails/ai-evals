<div class="play__body">
  <h1 class="play-title"><%= @run.quiz.title %></h1>
  <% if @run.finished? %>
    <p class="play-lead">The quiz is over. Thanks!</p>
  <% else %>
    <p class="play-lead">What name should we show on the leaderboard?</p>
    <%= form_with url: participation_path(code: @run.code), class: "join-form" do |f| %>
      <% if @participation&.errors&.any? %>
        <div class="errors"><%= @participation.errors.full_messages.to_sentence %></div>
      <% end %>
      <%= f.text_field :name, value: @participation&.name || remembered_name, class: "input", placeholder: "Your name",
            required: true, maxlength: 40, autocomplete: "nickname", "aria-label": "Your name" %>
      <%= f.submit "Join", class: "btn btn--pink" %>
    <% end %>
  <% end %>
</div>
