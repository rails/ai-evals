<% content_for :title, @run.quiz.title %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @run %>
<% if @participation&.persisted? && !@run.finished? %><%= presence_source @run, id: "quizzy-player-#{@participation.id}" %><% end %>

<div class="play">
  <div class="play__top">
    <%= logo class: "play__logo" %>
    <% if @participation&.persisted? %><span><%= @participation.name %></span><% end %>
  </div>

  <% if @participation.nil? || @participation.new_record? %>
    <%= render "plays/join" %>
  <% elsif @run.idle? %>
    <%= render "plays/waiting" %>
  <% elsif @run.running? && @question %>
    <%= render "plays/question", question: @question %>
  <% else %>
    <%= render "plays/finished" %>
  <% end %>
</div>
