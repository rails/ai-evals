+  def with_secret_key_base_sources(env: nil, credentials: nil, secrets_file: nil)
+    previous_env = ENV['SECRET_KEY_BASE']
+    ENV['SECRET_KEY_BASE'] = env
+    Dir.mktmpdir do |root|
+      FileUtils.mkdir_p(File.join(root, 'config'))
+      File.write(File.join(root, 'config', 'secrets.yml'), secrets_file) if secrets_file
+      config = Struct.new(:secret_key_base).new('from secret_token.rb')
+      app = stub(:root => Pathname.new(root), :credentials => stub(:secret_key_base => credentials), :config => config)
