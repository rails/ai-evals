+module Redmine
+  # Emits Redmine deprecation warnings, according to
+  # config.active_support.deprecation. Use Redmine::Deprecator.warn instead of
+  # ActiveSupport::Deprecation.warn, which Rails 7.2 removed.
+  module Deprecator
+    class << self
+      def warn(message, callstack = caller_locations(1))
+        deprecator.warn(message, callstack)
+      end
+
+      def deprecator
+        @deprecator ||=
+          if Rails.application.respond_to?(:deprecators)
+            # Rails >= 7.1 applies the configuration to registered deprecators
+            ActiveSupport::Deprecation.new('6.0', 'Redmine').tap do |deprecator|
+              Rails.application.deprecators[:redmine] = deprecator
+            end
+          else
+            # TODO: remove once Rails 7.0 is gone
+            ActiveSupport::Deprecation.instance
+          end
+      end
+    end
+  end
+end
