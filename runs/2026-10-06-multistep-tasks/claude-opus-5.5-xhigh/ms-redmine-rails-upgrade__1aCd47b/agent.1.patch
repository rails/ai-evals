--- a/app/controllers/application_controller.rb
+++ b/app/controllers/application_controller.rb
@@ -791,4 +791,18 @@ class ApplicationController < ActionController::Base
   def _include_layout?(*args)
     api_request? ? false : super
   end
+
+  private
+
+  # Rollback compatibility (see docs/UPGRADE.md): the Rails 7.0 release runs
+  # with per_form_csrf_tokens enabled and renders forms with per-form tokens.
+  # Accept them even though this release keeps generating global tokens (which
+  # the previous release can verify), so that a form rendered before a
+  # rollback can still be submitted: an invalid token signs the user out.
+  def valid_per_form_csrf_token?(token, session = nil)
+    return super if per_form_csrf_tokens
+
+    correct_token = per_form_csrf_token(session, request.path.chomp('/'), request.request_method)
+    ActiveSupport::SecurityUtils.fixed_length_secure_compare(token, correct_token)
+  end
 end
