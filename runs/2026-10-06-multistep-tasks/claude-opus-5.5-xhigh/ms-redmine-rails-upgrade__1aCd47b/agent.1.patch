diff --git a/Gemfile.next b/Gemfile.next
new file mode 100644
index 0000000..cfd62e0
--- /dev/null
+++ b/Gemfile.next
@@ -0,0 +1,18 @@
+# frozen_string_literal: true
+
+# Dependencies for running Redmine on the next Rails version (Rails 7.0).
+#
+# Production keeps using Gemfile (Rails 6.1). This file only flips the Rails
+# version: every other dependency comes from Gemfile so that both builds stay
+# in sync. Bundler locks it into Gemfile.next.lock.
+#
+#   BUNDLE_GEMFILE=Gemfile.next bundle install
+#   BUNDLE_GEMFILE=Gemfile.next bin/rails test
+#
+# See docs/UPGRADE.md.
+
+def next_rails?
+  true
+end
+
+eval_gemfile File.expand_path('Gemfile', __dir__)
