+  def setup
+    super
+    Rails.application.config.redmine_verify_sessions = true
+  end
+
+  def teardown
+    Rails.application.config.redmine_verify_sessions = false
+    ActionController::Base.allow_forgery_protection = false
+    super
+  end
+
+  # Session cookies
+
+  def test_session_cookie_written_by_the_previous_release_keeps_the_user_logged_in
+    set_session_cookie json_session_cookie(session_data(User.find(2)))
+
+    get '/my/page'
+    assert_response :success
+    assert_logged_in_as 'jsmith'
+    assert_equal 2, read_session_as_previous_release['user_id']
+  end
+
+  def test_session_cookie_written_by_rails_7_2_keeps_the_user_logged_in
+    # Decrypted like the hand-built cookies of the previous release
+    payload = gcm_encryptor(OpenSSL::Digest::SHA256).decrypt_and_verify(RAILS_72_SESSION_COOKIE, :purpose => "cookie.#{SESSION_COOKIE}")
+    assert_equal RAILS_72_SESSION, ActiveSupport::JSON.decode(payload)
+    token = Token.create!(:user_id => 2, :action => 'session')
+    token.update_column(:value, RAILS_72_SESSION['tk'])
+    set_session_cookie RAILS_72_SESSION_COOKIE
+
+    get '/my/page'
+    assert_response :success
+    assert_logged_in_as 'jsmith'
+  end
+
+  def test_session_cookie_written_by_rails_6_1_keeps_the_user_logged_in
+    set_session_cookie rails61_session_cookie(session_data(User.find(2)))
+
+    get '/my/page'
+    assert_response :success
+    assert_logged_in_as 'jsmith'
+    # Rewritten in the format of this release, which the previous release reads
+    assert_not cookies[SESSION_COOKIE].start_with?(rails61_session_cookie({}).split('--').first)
+    payload = gcm_encryptor(OpenSSL::Digest::SHA256).decrypt_and_verify(cookies[SESSION_COOKIE], :purpose => "cookie.#{SESSION_COOKIE}")
+    assert_equal 2, ActiveSupport::JSON.decode(payload)['user_id']
+  end
+
+  def test_session_cookie_encrypted_with_aes_gcm_and_a_sha1_derived_key_keeps_the_user_logged_in
+    set_session_cookie json_session_cookie(session_data(User.find(2)), :key_digest => OpenSSL::Digest::SHA1)
+
+    get '/my/page'
+    assert_logged_in_as 'jsmith'
+  end
+
+  def test_session_cookie_from_another_secret_is_ignored
+    set_session_cookie json_session_cookie(session_data(User.find(2)), :secret_key_base => 'another secret' * 4)
+
+    get '/my/page'
+    assert_redirected_to %r{/login}
+  end
+
+  def test_sessions_are_written_in_a_format_the_previous_release_reads
+    log_user('jsmith', 'jsmith')
+    get '/my/page'
+
+    # AES-256-GCM with a SHA256 derived key and purpose metadata, and JSON
+    # (:hybrid writes JSON, like the previous release)
+    payload = gcm_encryptor(OpenSSL::Digest::SHA256).decrypt_and_verify(cookies[SESSION_COOKIE], :purpose => "cookie.#{SESSION_COOKIE}")
+    assert_not payload.start_with?(MARSHAL_SIGNATURE)
+    assert_equal 2, ActiveSupport::JSON.decode(payload)['user_id']
+    assert_equal 2, read_session_as_previous_release['user_id']
+  end
+
