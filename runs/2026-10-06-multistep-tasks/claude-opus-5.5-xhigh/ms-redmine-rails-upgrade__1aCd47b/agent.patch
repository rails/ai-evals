+  # Active Job serializers known to Rails 7.2 (the previous release): a job
+  # with an argument serialized by another one (eg.
+  # ActionControllerParametersSerializer, new in Rails 8.1) fails there after
+  # a rollback.
+  RAILS_72_JOB_SERIALIZERS = %w(
+    Symbol Duration DateTime Date TimeWithZone Time Module Range BigDecimal
+  ).map {|name| "ActiveJob::Serializers::#{name}Serializer"}.freeze
+  # Keys of the jobs Rails 7.2 enqueues (and reads)
+  RAILS_72_JOB_KEYS = %w(
+    job_class job_id provider_job_id queue_name priority arguments executions
+    exception_executions locale timezone enqueued_at scheduled_at
+  ).freeze
