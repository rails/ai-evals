+  def test_global_token_rendered_by_the_previous_release_is_accepted
+    ActionController::Base.allow_forgery_protection = true
+    csrf_token = SecureRandom.urlsafe_base64(32)
+    set_session_cookie json_session_cookie(session_data(User.find(2)).merge('_csrf_token' => csrf_token))
+
+    put '/my/account', :params => {:user => {:firstname => 'Johnny'}},
+                       :headers => {'X-CSRF-Token' => urlsafe_masked_token(global_csrf_token(csrf_token))}
+    assert_redirected_to '/my/account'
+    assert_equal 'Johnny', User.find(2).firstname
+  end
+
+  def test_form_rendered_by_rails_6_1_can_be_submitted
+    ActionController::Base.allow_forgery_protection = true
+    # Not urlsafe: contains "+", "/" and padding
+    csrf_token = Base64.strict_encode64(("\xfb\xff\xff".b * 10) + SecureRandom.random_bytes(2))
+    set_session_cookie rails61_session_cookie(session_data(User.find(2)).merge('_csrf_token' => csrf_token))
+
+    put '/my/account', :params => {
+      :authenticity_token => Base64.strict_encode64(mask(global_csrf_token(csrf_token))),
+      :user => {:firstname => 'Johnny'}
+    }
+    assert_redirected_to '/my/account'
+    assert_equal 'Johnny', User.find(2).firstname
+    get '/my/page'
+    assert_logged_in_as 'jsmith'
+  end
+
+  def test_per_form_token_for_another_form_is_rejected
+    ActionController::Base.allow_forgery_protection = true
+    csrf_token = SecureRandom.urlsafe_base64(32)
+    set_session_cookie json_session_cookie(session_data(User.find(2)).merge('_csrf_token' => csrf_token))
+
+    put '/my/account', :params => {
+      :authenticity_token => urlsafe_masked_token(csrf_hmac(csrf_token, '/my/password#post')),
+      :user => {:firstname => 'Johnny'}
+    }
+    assert_response 422
+    assert_equal 'John', User.find(2).firstname
+  end
+
+  def test_forms_use_tokens_the_previous_release_accepts
+    log_user('jsmith', 'jsmith')
+    ActionController::Base.allow_forgery_protection = true
+
+    get '/my/account'
+    assert_response :success
+    # urlsafe per-form and global tokens, like the previous release
+    csrf_token = read_session_as_previous_release['_csrf_token']
+    form_token = css_select('form#my_account_form input[name=authenticity_token]').first['value']
+    assert_equal csrf_hmac(csrf_token, '/my/account#put'), unmask(form_token)
+    meta_token = css_select('meta[name=csrf-token]').first['content']
+    assert_equal global_csrf_token(csrf_token), unmask(meta_token)
+  end
