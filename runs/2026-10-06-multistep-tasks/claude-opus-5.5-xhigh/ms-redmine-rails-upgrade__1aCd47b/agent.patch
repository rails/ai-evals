+  def test_mail_links_are_signed_in_a_format_the_previous_release_reads
+    token = Mailer.mail_link_token(:unwatch, 'user_id' => 3, 'issue_id' => 2)
+
+    # Key derived with SHA256, JSON data and metadata serialized together:
+    # exactly what the previous release writes (and reads)
+    data, digest = token.split('--')
+    assert_equal OpenSSL::HMAC.hexdigest('SHA1', derive_key('mail_links', 64, OpenSSL::Digest::SHA256), data), digest
+    payload = ActiveSupport::JSON.decode(Base64.strict_decode64(data))
+    assert_equal 'unwatch', payload['_rails']['pur']
+    expires_at = Time.zone.parse(payload['_rails']['exp'])
+    assert_equal previous_release_mail_link_token({'user_id' => 3, 'issue_id' => 2}, :expires_at => expires_at), token
+    verifier = previous_release_message_verifier('mail_links')
+    assert_equal({'user_id' => 3, 'issue_id' => 2}, verifier.verified(token, :purpose => :unwatch))
+    assert_nil verifier.verified(token, :purpose => :other)
+  end
