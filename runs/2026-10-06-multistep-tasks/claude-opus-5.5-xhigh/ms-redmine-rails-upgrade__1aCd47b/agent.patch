+
+  def test_records_marshaled_by_the_previous_release_are_loaded
+    issue = Issue.find(1)
+    issue.project # cached association
+    # The 6.1 format: the plain Marshal dump of the record
+    dumped = as_previous_release {Marshal.dump(issue)}
+    assert_equal 'o', dumped[2]
+
+    loaded = Marshal.load(dumped) # rubocop:disable Security/MarshalLoad
+    assert_equal issue.attributes, loaded.attributes
+    assert loaded.association(:project).loaded?
