+require_relative '../../../test_helper'
+
+class Redmine::RollbackCompatibilityTest < ActiveSupport::TestCase
+  def test_derive_key_matches_the_rails_key_generator
+    [OpenSSL::Digest::SHA1, OpenSSL::Digest::SHA256].each do |digest|
+      generator = ActiveSupport::KeyGenerator.new('secret', :iterations => 1000, :hash_digest_class => digest)
+      assert_equal generator.generate_key('salt', 32),
+                   Redmine::RollbackCompatibility.derive_key('secret', 'salt', 32, digest)
+    end
+  end
+
+  def test_message_verifiers_accept_keys_derived_with_sha1_and_sha256
+    [OpenSSL::Digest::SHA1, OpenSSL::Digest::SHA256].each do |digest|
+      key = Redmine::RollbackCompatibility.derive_key(Rails.application.secret_key_base, 'rollback_test', 64, digest)
+      message = ActiveSupport::MessageVerifier.new(key).generate('data', :purpose => :test)
+
+      assert_equal 'data', Rails.application.message_verifier(:rollback_test).verify(message, :purpose => :test),
+                   "message signed with a #{digest.name} derived key was rejected"
+    end
+  end
+
+  def test_message_verifiers_reject_other_secrets
+    key = Redmine::RollbackCompatibility.derive_key('another secret' * 4, 'rollback_test', 64, OpenSSL::Digest::SHA256)
+    message = ActiveSupport::MessageVerifier.new(key).generate('data')
+
+    assert_raise ActiveSupport::MessageVerifier::InvalidSignature do
+      Rails.application.message_verifier(:rollback_test).verify(message)
+    end
+  end
+
+  def test_message_verifiers_are_rotated_once
+    verifier = Rails.application.message_verifier(:rollback_test_once)
+    rotations = verifier.instance_variable_get(:@rotations).size
+    Rails.application.message_verifier(:rollback_test_once)
+
+    assert_equal 2, rotations
+    assert_equal rotations, verifier.instance_variable_get(:@rotations).size
+  end
+
+  def test_cookie_rotations_are_registered_once
+    rotations = Rails.application.config.action_dispatch.cookies_rotations
+    encrypted = rotations.encrypted.size
+    signed = rotations.signed.size
+    Redmine::RollbackCompatibility.register_cookie_rotations(Rails.application)
+
+    assert_operator encrypted, :>=, 4
+    assert_operator signed, :>=, 2
+    assert_equal encrypted, rotations.encrypted.size
+    assert_equal signed, rotations.signed.size
+  end
+
+  def test_signed_cookie_from_the_previous_release_is_read
+    secret = Redmine::RollbackCompatibility.derive_key(Rails.application.secret_key_base, 'signed cookie', 64, OpenSSL::Digest::SHA256)
+    value = ActiveSupport::MessageVerifier.new(secret, :serializer => ActiveSupport::MessageEncryptor::NullSerializer).
+              generate(ActiveSupport::JSON.encode('data'), :purpose => 'cookie.foo')
+    request = ActionDispatch::TestRequest.create(Rails.application.env_config)
+    request.cookie_jar['foo'] = value
+
+    assert_equal 'data', request.cookie_jar.signed['foo']
+  end
+
+  def test_missing_secret_key_base_does_not_prevent_booting
+    app = mock
+    app.stubs(:secret_key_base).raises(ArgumentError, 'Missing `secret_key_base`')
+    app.expects(:config).never
+
+    assert_nil Redmine::RollbackCompatibility.register_cookie_rotations(app)
+  end
+
+  # Messages signed by Rails >= 7.1 on its framework defaults (eg. mail links
+  # of the previous release, Rails 7.2), or with other serializers
+
+  def test_message_verifiers_read_json_messages_with_metadata
+    message = newer_message({'_rails' => {'data' => {'id' => 1}, 'exp' => 1.day.from_now.utc.iso8601(3), 'pur' => 'test'}})
+
+    assert_equal({'id' => 1}, Rails.application.message_verifier(:rollback_test).verify(message, :purpose => :test))
+  end
+
+  def test_message_verifiers_read_json_messages_in_a_metadata_envelope
+    message = newer_message(
+      {'_rails' => {'message' => Base64.strict_encode64('{"id":1}'), 'exp' => 1.day.from_now.utc.iso8601(3), 'pur' => :test}}
+    )
+
+    assert_equal({'id' => 1}, Rails.application.message_verifier(:rollback_test).verify(message, :purpose => :test))
+  end
+
+  def test_message_verifiers_read_marshal_messages_with_metadata
+    message = sign(Marshal.dump({'_rails' => {'data' => [1, 2], 'exp' => 1.day.from_now.utc.iso8601(3), 'pur' => 'test'}}))
+
+    assert_equal [1, 2], Rails.application.message_verifier(:rollback_test).verify(message, :purpose => :test)
+  end
+
+  def test_message_verifiers_read_json_messages_without_metadata
+    verifier = Rails.application.message_verifier(:rollback_test)
+
+    assert_equal [1, 'a'], verifier.verify(newer_message([1, 'a']))
+    assert_raise(ActiveSupport::MessageVerifier::InvalidSignature) {verifier.verify(newer_message([1, 'a']), :purpose => :test)}
+  end
+
+  def test_message_verifiers_read_json_messages_signed_with_a_sha1_derived_key
+    message = newer_message({'_rails' => {'data' => 'data', 'pur' => 'test'}}, :digest => OpenSSL::Digest::SHA1)
+
+    assert_equal 'data', Rails.application.message_verifier(:rollback_test).verify(message, :purpose => :test)
+  end
+
+  def test_message_verifiers_reject_json_messages_for_another_purpose_or_expired
+    verifier = Rails.application.message_verifier(:rollback_test)
+    other_purpose = newer_message({'_rails' => {'data' => 'data', 'pur' => 'other'}})
+    expired = newer_message({'_rails' => {'data' => 'data', 'exp' => 1.second.ago.utc.iso8601(3), 'pur' => 'test'}})
+
+    assert_nil verifier.verified(other_purpose, :purpose => :test)
+    assert_nil verifier.verified(other_purpose)
+    assert_nil verifier.verified(expired, :purpose => :test)
+  end
+
+  def test_message_verifiers_reject_json_messages_signed_with_other_secrets
+    message = newer_message({'_rails' => {'data' => 'data', 'pur' => 'test'}}, :secret_key_base => 'another secret' * 4)
+
+    assert_raise ActiveSupport::MessageVerifier::InvalidSignature do
+      Rails.application.message_verifier(:rollback_test).verify(message, :purpose => :test)
+    end
+  end
+
+  def test_message_verifiers_write_messages_the_previous_release_reads
+    expires_at = 1.day.from_now
+    message = Rails.application.message_verifier(:rollback_test).generate({'id' => 1}, :purpose => :test, :expires_at => expires_at)
+
+    # JSON data and metadata (Rails >= 7.1 defaults), which the previous
+    # release (Rails 7.2) writes and reads natively
+    assert_equal newer_message({'_rails' => {'data' => {'id' => 1}, 'exp' => expires_at.utc.iso8601(3), 'pur' => 'test'}}), message
+    key = Redmine::RollbackCompatibility.derive_key(Rails.application.secret_key_base, 'rollback_test', 64, OpenSSL::Digest::SHA256)
+    previous_release_verifier = ActiveSupport::MessageVerifier.new(key, :serializer => :json_allow_marshal)
+    assert_equal({'id' => 1}, previous_release_verifier.verified(message, :purpose => :test))
+    assert_nil previous_release_verifier.verified(message, :purpose => :other)
+  end
+
+  def test_newer_message_format_matches_rails
+    metadata = ActiveSupport::Messages::Metadata
+    use_message_serializer_for_metadata = metadata.use_message_serializer_for_metadata
+    begin
+      metadata.use_message_serializer_for_metadata = true
+      key = Redmine::RollbackCompatibility.derive_key(Rails.application.secret_key_base, 'rollback_test', 64, OpenSSL::Digest::SHA256)
+      expires_at = 1.day.from_now
+      message = ActiveSupport::MessageVerifier.new(key, :serializer => :json_allow_marshal).
+                  generate({'id' => 1}, :purpose => :test, :expires_at => expires_at)
+
+      assert_equal newer_message({'_rails' => {'data' => {'id' => 1}, 'exp' => expires_at.utc.iso8601(3), 'pur' => 'test'}}), message
+    ensure
+      metadata.use_message_serializer_for_metadata = use_message_serializer_for_metadata
+    end
+  end
+
+  # secret_key_base: Rails 7.0 and Rails >= 7.2 take it from different
+  # sources, and every release since keeps the one Rails 7.0 used
+
+  def test_secret_key_base_is_taken_from_the_environment_first_in_production
+    with_secret_key_base_sources(:env => 'from env', :credentials => 'from credentials', :secrets_file => <<~YAML) do |app|
+      production:
+        secret_key_base: from secrets.yml
+    YAML
+      assert_equal :env, Redmine::RollbackCompatibility.keep_secret_key_base(app, :env => 'production')
+      assert_equal 'from env', app.config.secret_key_base
+    end
+  end
+
+  def test_secret_key_base_is_taken_from_the_credentials_before_secrets_yml_in_production
+    with_secret_key_base_sources(:credentials => 'from credentials', :secrets_file => <<~YAML) do |app|
+      production:
+        secret_key_base: from secrets.yml
+    YAML
+      assert_equal :credentials, Redmine::RollbackCompatibility.keep_secret_key_base(app, :env => 'production')
+      assert_equal 'from credentials', app.config.secret_key_base
+    end
+  end
+
+  def test_secret_key_base_is_taken_from_secrets_yml_before_secret_token_rb
+    with_secret_key_base_sources(:secrets_file => <<~YAML) do |app|
+      shared:
+        secret_key_base: shared secret
+        other: value
+      production:
+        secret_key_base: <%= 'from ' + 'secrets.yml' %>
+    YAML
+      assert_equal :secrets_file, Redmine::RollbackCompatibility.keep_secret_key_base(app, :env => 'production')
+      assert_equal 'from secrets.yml', app.config.secret_key_base
+    end
+  end
+
+  def test_secret_key_base_is_taken_from_the_shared_section_of_secrets_yml
+    with_secret_key_base_sources(:secrets_file => <<~YAML) do |app|
+      shared:
+        secret_key_base: shared secret
+      production:
+        other: value
+    YAML
+      Redmine::RollbackCompatibility.keep_secret_key_base(app, :env => 'production')
+      assert_equal 'shared secret', app.config.secret_key_base
+    end
+  end
+
+  def test_secret_key_base_from_secret_token_rb_is_kept_without_other_sources
+    with_secret_key_base_sources(:secrets_file => <<~YAML) do |app|
+      development:
+        secret_key_base: development secret
+      production:
+        secret_key_base: ''
+    YAML
+      assert_nil Redmine::RollbackCompatibility.keep_secret_key_base(app, :env => 'production')
+      assert_equal 'from secret_token.rb', app.config.secret_key_base
+    end
+  end
+
+  def test_secret_key_base_ignores_the_environment_and_the_credentials_in_development_and_test
+    %w(development test).each do |env|
+      with_secret_key_base_sources(:env => 'from env', :credentials => 'from credentials') do |app|
+        assert_nil Redmine::RollbackCompatibility.keep_secret_key_base(app, :env => env)
+        assert_equal 'from secret_token.rb', app.config.secret_key_base
+      end
+      with_secret_key_base_sources(:env => 'from env', :secrets_file => "#{env}:\n  secret_key_base: from secrets.yml\n") do |app|
+        assert_equal :secrets_file, Redmine::RollbackCompatibility.keep_secret_key_base(app, :env => env)
+        assert_equal 'from secrets.yml', app.config.secret_key_base
+      end
+    end
+  end
+
+  def test_application_secret_key_base
+    # config/environments/test.rb, no config/secrets.yml
+    assert_equal 'a secret token for running the tests', Rails.application.secret_key_base
+    assert_equal Rails.application.config.secret_key_base, Rails.application.secret_key_base
+  end
+
+  private
+
+  # Yields an application whose config.secret_key_base is set (like
+  # config/initializers/secret_token.rb does), with the given other sources
+  # of secret_key_base.
+  def with_secret_key_base_sources(env: nil, credentials: nil, secrets_file: nil)
+    previous_env = ENV['SECRET_KEY_BASE']
+    ENV['SECRET_KEY_BASE'] = env
+    Dir.mktmpdir do |root|
+      FileUtils.mkdir_p(File.join(root, 'config'))
+      File.write(File.join(root, 'config', 'secrets.yml'), secrets_file) if secrets_file
+      config = Struct.new(:secret_key_base).new('from secret_token.rb')
+      app = stub(:root => Pathname.new(root), :credentials => stub(:secret_key_base => credentials), :config => config)
+      yield app
+    end
+  ensure
+    ENV['SECRET_KEY_BASE'] = previous_env
+  end
+
+  def sign(payload, digest: OpenSSL::Digest::SHA256, secret_key_base: Rails.application.secret_key_base)
+    key = Redmine::RollbackCompatibility.derive_key(secret_key_base, 'rollback_test', 64, digest)
+    data = Base64.strict_encode64(payload)
+    "#{data}--#{OpenSSL::HMAC.hexdigest('SHA1', key, data)}"
+  end
+
+  # A message serialized like Rails >= 7.1 does with message_serializer =
+  # :json_allow_marshal
+  def newer_message(value, **options)
+    sign(ActiveSupport::JSON.encode(value), **options)
+  end
+end
