+  # Jobs in a persistent queue
+
+  def test_jobs_are_enqueued_in_a_format_the_previous_release_runs
+    jobs = with_test_queue_adapter do
+      with_settings :notified_events => %w(issue_added) do
+        Issue.generate!(:project_id => 1, :author_id => 2, :assigned_to_id => 3)
+      end
+      Mailer.deliver_security_notification(User.find(2), User.find(1), :message => :mail_body_security_notification_change,
+                                           :field => :field_mail, :url => {:controller => 'my', :action => 'account'})
+    end
+    assert jobs.any?
+
+    jobs.each do |job|
+      assert_equal 'mailers', job['queue_name']
+      assert_empty job.keys - RAILS_72_JOB_KEYS
+      serializers = []
+      collect_job_serializers(job['arguments'], serializers)
+      assert_empty serializers - RAILS_72_JOB_SERIALIZERS, "#{job['job_class']} can't be run by the previous release"
+    end
+  end
+
+  def test_jobs_enqueued_by_the_previous_release_are_run
+    ActionMailer::Base.deliveries.clear
+    job = ActiveSupport::JSON.decode(RAILS_72_JOB)
+    assert_equal RAILS_72_JOB_KEYS.sort, job.keys.sort
+
+    ActiveJob::Base.execute(job)
+    assert_equal ['admin@somenet.foo'], ActionMailer::Base.deliveries.last&.to
+  end
+
+  def test_jobs_enqueued_by_rails_7_0_are_run
+    ActionMailer::Base.deliveries.clear
+    # ActionMailer::MailDeliveryJob as enqueued by Rails 7.0.8.7
+    ActiveJob::Base.execute(
+      'job_class' => 'ActionMailer::MailDeliveryJob', 'job_id' => SecureRandom.uuid, 'provider_job_id' => nil,
+      'queue_name' => 'mailers', 'priority' => nil,
+      'arguments' => ['Mailer', 'test_email', 'deliver_now',
+                      {'args' => [{'_aj_globalid' => User.find(1).to_global_id.to_s}], '_aj_ruby2_keywords' => ['args']}],
+      'executions' => 0, 'exception_executions' => {}, 'locale' => 'en', 'timezone' => 'UTC',
+      'enqueued_at' => Time.now.utc.iso8601
+    )
+    assert_equal ['admin@somenet.foo'], ActionMailer::Base.deliveries.last&.to
+  end
