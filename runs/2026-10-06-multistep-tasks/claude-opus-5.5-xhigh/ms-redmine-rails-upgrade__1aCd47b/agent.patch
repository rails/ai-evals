+  # Cache entries
+
+  def test_cache_entries_are_written_in_a_format_the_previous_release_reads
+    with_file_store do |store|
+      # The 7.1 format (Rails 8.1 defaults), which the previous release reads
+      # whatever format it writes itself
+      values = {'small' => 'value', 'large' => 'x' * 5000, 'object' => {:id => 1, 'names' => ['a']}}
+      values.each {|key, value| store.write(key, value)}
+      assert File.binread(cache_file(store, 'small')).start_with?(CACHE_71_SIGNATURE)
+      assert File.binread(cache_file(store, 'large')).start_with?(CACHE_71_SIGNATURE)
+
+      previous_release_store = previous_release_cache_store(store.cache_path)
+      values.each {|key, value| assert_equal value, previous_release_store.read(key)}
+    end
+  end
+
+  def test_cache_entries_written_by_the_previous_release_are_read
+    with_file_store do |store|
+      previous_release_store = previous_release_cache_store(store.cache_path)
+      values = {'small' => 'value', 'large' => 'x' * 5000, 'object' => {:id => 1, 'names' => ['a']}}
+      values.each {|key, value| previous_release_store.write(key, value)}
+      # The 7.0 format: a mark (\x00, or \x01 if compressed) and the Marshal
+      # dump of the packed entry
+      assert File.binread(cache_file(store, 'small')).start_with?("\x00".b)
+      assert File.binread(cache_file(store, 'large')).start_with?("\x01".b)
+
+      values.each {|key, value| assert_equal value, store.read(key)}
+    end
+  end
+
+  def test_cache_entries_written_like_the_previous_release_match_rails_7_2
+    with_file_store do |store|
+      previous_release_store = previous_release_cache_store(store.cache_path)
+      previous_release_store.write('small', 'value')
+      previous_release_store.write('large', 'x' * 5000)
+      assert_equal Base64.strict_decode64(RAILS_72_CACHE_ENTRY), File.binread(cache_file(store, 'small'))
+      assert_equal Base64.strict_decode64(RAILS_72_COMPRESSED_CACHE_ENTRY), File.binread(cache_file(store, 'large'))
+
+      assert_equal 'value', store.read('small')
+      assert_equal 'x' * 5000, store.read('large')
+    end
+  end
+
+  def test_cache_entries_written_by_rails_7_0_are_read
+    with_file_store do |store|
+      store.write('small', 'old')
+      store.write('large', 'old')
+      File.binwrite(cache_file(store, 'small'), rails70_cache_entry('value'))
+      File.binwrite(cache_file(store, 'large'), rails70_cache_entry('x' * 5000, :compress => true))
+
+      assert_equal 'value', store.read('small')
+      assert_equal 'x' * 5000, store.read('large')
+    end
+  end
+
+  def test_cache_entries_hand_built_like_rails_7_0_match_rails_7_0
+    assert_equal Base64.strict_decode64(RAILS_70_CACHE_ENTRY), rails70_cache_entry('value')
+    assert_equal Base64.strict_decode64(RAILS_70_COMPRESSED_CACHE_ENTRY), rails70_cache_entry('x' * 5000, :compress => true)
+  end
+
+  # Records marshaled into a cache (eg. by plugins)
+
+  def test_records_are_marshaled_in_a_format_the_previous_release_loads
+    issue = Issue.find(1)
+    issue.project # cached association
+    # The 7.1 format (Rails 8.1 defaults), which the previous release loads
+    # whatever format it writes itself
+    assert_equal 7.1, ActiveRecord::Marshalling.format_version
+    dumped = Marshal.dump(issue)
+    assert_equal 'U', dumped[2]
+
+    loaded = as_previous_release {Marshal.load(dumped)} # rubocop:disable Security/MarshalLoad
+    assert_equal issue.attributes, loaded.attributes
+    assert loaded.association(:project).loaded?
