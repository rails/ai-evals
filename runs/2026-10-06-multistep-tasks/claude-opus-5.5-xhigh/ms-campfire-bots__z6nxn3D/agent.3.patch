+    assert_includes rooms(:designers).users, users(:deploy_bot)
+
+    room = rooms(:designers).becomes!(Rooms::Open)
+    room.save!
+
+    assert_includes room.users, everywhere_bot
+    assert_includes room.users, users(:deploy_bot)
