diff --git a/app/views/bots/index.html.erb b/app/views/bots/index.html.erb
new file mode 100644
index 0000000..c690962
--- /dev/null
+++ b/app/views/bots/index.html.erb
@@ -0,0 +1,42 @@
+<% @page_title = "Chat bots" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to edit_account_path %>
+  </div>
+<% end %>
+
+<section class="panel panel--wide flex flex-column gap" style="view-transition-name: bots">
+  <header class="txt-align-center">
+    <h1 class="txt-x-large margin-none">Chat bots</h1>
+    <p class="margin-none-block-end">Bots post messages from scripts and CI jobs. Give them access to rooms like anyone else, or add them to all open rooms.</p>
+  </header>
+
+  <div class="pad-inline pad-block fill-shade border-radius">
+    <% if @bots.any? %>
+      <menu class="flex flex-column gap margin-none pad">
+        <%= render partial: "bots/bot", collection: @bots %>
+      </menu>
+    <% else %>
+      <p class="txt-align-center txt-subtle margin-none">No chat bots yet</p>
+    <% end %>
+  </div>
+
+  <% if Current.user.reached_bot_limit? %>
+    <p class="txt-align-center txt-subtle margin-none">You’ve reached the limit of <%= pluralize(Current.account.bots_per_member, "chat bot") %> per member.</p>
+  <% else %>
+    <%= button_to new_bot_path, method: :get, class: "btn btn--reversed center", form_class: "flex justify-center" do %>
+      <%= image_tag "add.svg", size: 20, aria: { hidden: "true" } %>
+      <span>Add a chat bot</span>
+    <% end %>
+  <% end %>
+
+  <div class="flex flex-column gap txt-small" style="--row-gap: 0.5em">
+    <p class="margin-none">To post as a bot, send the message as the request body. The room ID is the number in the room’s URL.</p>
+    <code class="input input--code fill-white"><%= %(curl -d "Deploy of v1.2.3 finished ✅" #{room_bot_messages_url(room_id: "ROOM_ID", bot_key: "BOT_CODE")}) %></code>
+    <p class="margin-none">To have a bot answer when someone @mentions it, or say hello when it’s added to a room, give it a webhook URL. Campfire posts the event there as JSON; reply with a <code>text/plain</code> or <code>text/html</code> body to answer in the room, or with a 204 to stay quiet.</p>
+    <p class="margin-none">Bots can post up to <%= User::RateLimited::MESSAGES_LIMIT %> messages in <%= User::RateLimited::MESSAGES_PERIOD.inspect %>, webhook replies included. A bot that goes over has to wait <%= User::RateLimited::COOLDOWN.inspect %>, during which Campfire answers with a 429 and a <code>Retry-After</code> header. Bots that keep posting anyway, or whose webhook fails <%= Webhook::SUSPENDING_FAILURES %> times in a row, are suspended until an administrator reactivates them.</p>
+    <p class="margin-none">Keep bot codes secret: anyone with a bot’s code can post as that bot.</p>
+  </div>
+</section>
