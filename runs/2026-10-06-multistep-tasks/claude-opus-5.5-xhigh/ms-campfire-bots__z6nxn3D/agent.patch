+
+    sign_in :jz
+    get bots_url
+
+    assert_select "menu li", count: 2
+    assert_select "button", text: "Add a chat bot", count: 0
+    assert_select "p", text: /reached the limit/
+  end
+
+  test "new and create are refused at the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in :jz
+
+    get new_bot_url
+    assert_response :forbidden
+
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: "Release Bot" } }
+    end
+    assert_response :forbidden
+  end
+
+  test "create is refused when the limit is reached in the meantime" do
+    sign_in :jz
+    BotsController.any_instance.stubs(:ensure_can_add_bots)
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: "Release Bot" } }
+    end
+
+    assert_response :unprocessable_content
+    assert_select "[role=alert]", text: "You’ve reached the limit of 1 chat bot per member"
+  end
+
+  test "members can add bots again after deleting one" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in :jz
+
+    delete bot_url(@bot)
+
+    get bots_url
+    assert_select "button", text: "Add a chat bot"
+
+    assert_difference -> { User.bot.active.count }, +1 do
+      post bots_url, params: { bot: { name: "Release Bot" } }
+    end
+    assert_redirected_to bots_url
+  end
+
+  test "administrators aren't limited" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    sign_in :david
+
+    get bots_url
+    assert_select "button", text: "Add a chat bot"
+    assert_no_match "reached the limit", response.body
+
+    get new_bot_url
+    assert_response :success
+
+    assert_difference -> { User.bot.count }, +1 do
+      post bots_url, params: { bot: { name: "Admin Bot" } }
+    end
+    assert_redirected_to bots_url
+  end
+
+  test "lowering the limit doesn't stop people from managing the bots they have" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    sign_in :jz
+
+    get edit_bot_url(@bot)
+    assert_response :success
+
+    patch bot_url(@bot), params: { bot: { name: "Release Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", @bot.reload.name
+
+    patch bot_key_url(@bot)
+    assert_redirected_to bots_url
+
+    delete bot_url(@bot)
+    assert_redirected_to bots_url
+    assert @bot.reload.deactivated?
+  end
+
+  test "requires signing in" do
+    get bots_url
+    assert_redirected_to new_session_url
+  end
+end
diff --git a/test/controllers/messages/by_bots_controller_test.rb b/test/controllers/messages/by_bots_controller_test.rb
new file mode 100644
index 0000000..3705a59
--- /dev/null
+++ b/test/controllers/messages/by_bots_controller_test.rb
@@ -0,0 +1,248 @@
+require "test_helper"
+
+class Messages::ByBotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = users(:deploy_bot)
+    @room = rooms(:designers)
+  end
+
+  test "create posts the raw request body as a message by the bot" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post_as_bot "Deploy of v1.2.3 finished ✅"
+    end
+
+    assert_response :created
+    message = Message.last
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+    assert_equal @bot, message.creator
+  end
+
+  test "create accepts text that isn't valid form encoding, the way curl -d sends it" do
+    post_as_bot "Build 100% done & shipped = yes", headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    assert_equal "Build 100% done & shipped = yes", Message.last.plain_text_body
+  end
+
+  test "create treats the body as plain text whatever its content type" do
+    post_as_bot '{"text": "not an envelope"', headers: { "Content-Type" => "application/json" }
+
+    assert_response :created
+    assert_equal '{"text": "not an envelope"', Message.last.plain_text_body
+  end
+
+  test "create escapes HTML and keeps line breaks" do
+    post_as_bot "Expected <nil>\n<script>alert(1)</script>\n"
+
+    assert_response :created
+    assert_equal "Expected <nil>\n<script>alert(1)</script>", Message.last.plain_text_body
+    assert_no_match "<script>", Message.last.body.body.to_html
+  end
+
+  test "create with an attachment" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.bot_key), params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+    end
+
+    assert_response :created
+    assert_equal "moon.jpg", Message.last.attachment.filename.to_s
+    assert_equal "/messages/#{Message.last.id}", response.headers["Location"]
+  end
+
+  test "create broadcasts the message and unread room to members" do
+    assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+      assert_broadcasts UnreadRoomsChannel.stream_name_for(users(:jz).id), 1 do
+        post_as_bot "Broadcast me"
+      end
+    end
+  end
+
+  test "create pushes notifications like a human message" do
+    pushes = []
+    Rails.configuration.x.web_push_pool.stubs(:queue).with { |payload, subscriptions| pushes << [ payload, subscriptions.to_a ] }
+
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      post_as_bot "Push me"
+    end
+
+    assert_equal [ "Deploy Bot: Push me" ], pushes.map { |payload, _| payload[:body] }.uniq
+    assert_equal push_subscriptions(:jason_chrome, :jz_chrome).sort, pushes.flat_map(&:last).sort
+  end
+
+  test "create marks the room unread for other members" do
+    post_as_bot "Unread me"
+
+    assert memberships(:jz_designers).reload.unread?
+    assert_not memberships(:deploy_bot_designers).reload.unread?
+  end
+
+  test "create with an empty body is unprocessable" do
+    assert_no_difference -> { Message.count } do
+      post_as_bot ""
+      assert_response :unprocessable_content
+
+      post_as_bot " \n "
+      assert_response :unprocessable_content
+
+      post_as_bot multipart_body(attachment: "not a file"), headers: { "Content-Type" => "multipart/form-data; boundary=BOUNDARY" }
+      assert_response :unprocessable_content
+    end
+  end
+
+  test "create in a room that doesn't exist is not found" do
+    post room_bot_messages_url(room_id: "nope", bot_key: @bot.bot_key), params: "Hello"
+    assert_response :not_found
+
+    post room_bot_messages_url(room_id: Room.maximum(:id) + 1, bot_key: @bot.bot_key), params: "Hello"
+    assert_response :not_found
+  end
+
+  test "create in a room the bot isn't a member of is not found" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(rooms(:watercooler), @bot.bot_key), params: "Hello"
+    end
+
+    assert_response :not_found
+  end
+
+  test "create with an invalid bot key is unauthorized" do
+    assert_no_difference -> { Message.count } do
+      [ "#{@bot.id}-wrong", "#{users(:jz).id}-#{@bot.bot_token}", "garbage", @bot.bot_token ].each do |bot_key|
+        post room_bot_messages_url(@room, bot_key), params: "Hello"
+        assert_response :unauthorized
+      end
+    end
+  end
+
+  test "create is unauthorized for a deleted bot" do
+    bot_key = @bot.bot_key
+    @bot.deactivate
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, bot_key), params: "Hello"
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "create is unauthorized with an old bot key after it was reset" do
+    bot_key = @bot.bot_key
+    @bot.reset_bot_key
+
+    post room_bot_messages_url(@room, bot_key), params: "Hello"
+    assert_response :unauthorized
+
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Hello"
+    assert_response :created
+  end
+
+  test "create refuses the message that goes over 10 in 10 seconds with a 429 and starts a 30-second cooldown" do
+    freeze_time
+
+    10.times do
+      post_as_bot "Deploying"
+      assert_response :created
+    end
+
+    assert_no_difference -> { Message.count } do
+      post_as_bot "One too many"
+    end
+
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+  end
+
+  test "create keeps refusing messages during the cooldown, with the seconds left" do
+    freeze_time
+    11.times { post_as_bot "Deploying" }
+
+    travel 12.seconds
+    assert_no_difference -> { Message.count } do
+      post_as_bot "Now?"
+    end
+    assert_response :too_many_requests
+    assert_equal "18", response.headers["Retry-After"]
+
+    travel 18.seconds
+    post_as_bot "Now?"
+    assert_response :created
+  end
+
+  test "create counts attachments and webhook replies towards the limit" do
+    freeze_time
+    5.times { @room.messages.create!(body: "A webhook reply", creator: @bot) }
+    4.times { post_as_bot "Deploying" }
+
+    post room_bot_messages_url(@room, @bot.bot_key), params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+    assert_response :created
+
+    post_as_bot "One too many"
+    assert_response :too_many_requests
+  end
+
+  test "five more attempts during the same cooldown suspend the bot, which is forbidden from then on" do
+    freeze_time
+    11.times { post_as_bot "Deploying" }
+
+    5.times do
+      post_as_bot "Let me in"
+      assert_response :too_many_requests
+    end
+    assert @bot.reload.suspended_for_flooding?
+
+    post_as_bot "Let me in"
+    assert_response :forbidden
+    assert_nil response.headers["Retry-After"]
+
+    travel 1.hour
+    assert_no_difference -> { Message.count } do
+      post_as_bot "Still me"
+    end
+    assert_response :forbidden
+  end
+
+  test "create is forbidden for a suspended bot, whatever the room or message" do
+    @bot.suspend :failing_webhook
+
+    assert_no_difference -> { Message.count } do
+      post_as_bot "Hello"
+      assert_response :forbidden
+
+      post room_bot_messages_url(rooms(:watercooler), @bot.bot_key), params: "Hello"
+      assert_response :forbidden
+
+      post_as_bot ""
+      assert_response :forbidden
+    end
+  end
+
+  test "create works again once a suspended bot is reactivated" do
+    @bot.suspend :flooding
+    @bot.reactivate
+
+    post_as_bot "I'm back"
+    assert_response :created
+  end
+
+  test "a signed in person can't post through the bot endpoint without the bot key" do
+    sign_in :jz
+
+    post room_bot_messages_url(@room, "#{@bot.id}-wrong"), params: "Hello"
+    assert_response :unauthorized
+  end
+
+  test "the bot key doesn't authenticate anywhere else" do
+    get room_messages_url(@room, bot_key: @bot.bot_key)
+    assert_redirected_to new_session_url
+  end
+
+  private
+    def post_as_bot(body, headers: {})
+      post room_bot_messages_url(@room, @bot.bot_key), params: body, headers: { "Content-Type" => "text/plain" }.merge(headers)
+    end
+
+    def multipart_body(fields)
+      fields.map { |name, value| "--BOUNDARY\r\nContent-Disposition: form-data; name=\"#{name}\"\r\n\r\n#{value}\r\n" }.join + "--BOUNDARY--\r\n"
+    end
+end
