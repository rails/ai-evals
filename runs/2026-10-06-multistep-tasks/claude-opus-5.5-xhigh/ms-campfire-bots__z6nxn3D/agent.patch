+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,224 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:deploy_bot)
+  end
+
+  test "creating a bot gives it a bot key and an unusable password" do
+    bot = users(:kevin).bots.create!(name: "CI Bot")
+
+    assert bot.bot?
+    assert_equal users(:kevin), bot.creator
+    assert_match /\A#{bot.id}-[[:alnum:]]{32}\z/, bot.bot_key
+    assert_equal "", bot.password_digest
+  end
+
+  test "creating a bot doesn't grant membership to the open rooms" do
+    bot = users(:kevin).bots.create!(name: "CI Bot")
+    assert_empty bot.rooms
+  end
+
+  test "creating a bot that joins all open rooms grants membership to the open rooms" do
+    bot = users(:kevin).bots.create!(name: "CI Bot", joins_all_open_rooms: true)
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+  end
+
+  test "turning on joining all open rooms grants membership to the open rooms" do
+    bot = users(:kevin).bots.create!(name: "CI Bot")
+    rooms(:watercooler).memberships.grant_to(bot)
+
+    bot.update!(joins_all_open_rooms: true)
+    assert_equal (Rooms::Open.ids + [ rooms(:watercooler).id ]).sort, bot.rooms.ids.sort
+  end
+
+  test "turning off joining all open rooms keeps the bot's memberships" do
+    bot = users(:kevin).bots.create!(name: "CI Bot", joins_all_open_rooms: true)
+
+    bot.update!(joins_all_open_rooms: false)
+    assert_equal Rooms::Open.ids.sort, bot.reload.rooms.ids.sort
+
+    room = Rooms::Open.create!(name: "Ops", creator: users(:david))
+    assert_not_includes room.users, bot
+  end
+
+  test "joining all open rooms says hello in each of them, once" do
+    bot = users(:kevin).bots.create!(name: "CI Bot", webhook_url: "https://ci.example.com/campfire")
+    rooms(:hq).memberships.grant_to(bot)
+    clear_enqueued_jobs
+
+    bot.update!(joins_all_open_rooms: true)
+    assert_enqueued_jobs 1, only: Webhook::JoinedDeliveryJob
+    assert_enqueued_with job: Webhook::JoinedDeliveryJob, args: [ bot.webhook, rooms(:pets), { origin: nil } ]
+
+    assert_no_enqueued_jobs only: Webhook::JoinedDeliveryJob do
+      bot.update!(joins_all_open_rooms: false)
+      bot.update!(joins_all_open_rooms: true)
+    end
+  end
+
+  test "people join the open rooms whether or not they're set to" do
+    person = User.create!(name: "Newcomer", email_address: "newcomer@37signals.com", password: "secret123456")
+    assert_equal Rooms::Open.ids.sort, person.rooms.ids.sort
+  end
+
+  test "joining all open rooms" do
+    everywhere_bot = users(:kevin).bots.create!(name: "Everywhere Bot", joins_all_open_rooms: true)
+
+    assert_includes User.joining_all_open_rooms, users(:kevin)
+    assert_includes User.joining_all_open_rooms, everywhere_bot
+    assert_not_includes User.joining_all_open_rooms, users(:deploy_bot)
+  end
+
+  test "bots need a name" do
+    assert_not users(:kevin).bots.new(name: "").valid?
+  end
+
+  test "people don't have bot keys" do
+    assert_nil users(:kevin).bot_key
+    assert_nil users(:kevin).bot_token
+  end
+
+  test "authenticate bot" do
+    assert_equal @bot, User.authenticate_bot(@bot.bot_key)
+    assert_equal @bot, User.authenticate_bot(" #{@bot.bot_key}\n")
+  end
+
+  test "authenticate bot rejects bad keys" do
+    [ nil, "", "garbage", @bot.bot_token, "#{@bot.id}-", "#{@bot.id}-wrong", "#{@bot.id}-#{@bot.bot_token}x", "#{users(:kevin).id}-#{@bot.bot_token}" ].each do |bot_key|
+      assert_nil User.authenticate_bot(bot_key), "expected #{bot_key.inspect} to be rejected"
+    end
+  end
+
+  test "authenticate bot rejects deactivated and banned bots" do
+    bot_key = @bot.bot_key
+
+    @bot.ban
+    assert_nil User.authenticate_bot(bot_key)
+
+    @bot.unban
+    assert_equal @bot, User.authenticate_bot(bot_key)
+
+    @bot.deactivate
+    assert_nil User.authenticate_bot(bot_key)
+    assert_nil @bot.reload.bot_key
+  end
+
+  test "reset bot key" do
+    bot_key = @bot.bot_key
+    @bot.reset_bot_key
+
+    assert_not_equal bot_key, @bot.bot_key
+    assert_nil User.authenticate_bot(bot_key)
+    assert_equal @bot, User.authenticate_bot(@bot.bot_key)
+  end
+
+  test "bots can't sign in with a password" do
+    assert_nil User.active.without_bots.authenticate_by(email_address: nil, password: "secret123456")
+  end
+
+  test "creators can administer their bots" do
+    assert users(:jz).can_administer?(@bot)
+    assert users(:david).can_administer?(@bot)
+    assert_not users(:kevin).can_administer?(@bot)
+  end
+
+  test "without bots" do
+    assert_not_includes User.without_bots, @bot
+    assert_includes User.without_bots, users(:kevin)
+  end
+
+  test "webhook URL" do
+    assert_equal "https://bots.example.com/deploy", @bot.webhook_url
+
+    @bot.update!(webhook_url: "https://bots.example.com/v2")
+    assert_equal "https://bots.example.com/v2", @bot.reload.webhook_url
+    assert_equal webhooks(:deploy_bot), @bot.webhook
+
+    @bot.update!(webhook_url: " ")
+    assert_nil @bot.reload.webhook
+    assert_nil @bot.webhook_url
+  end
+
+  test "an invalid webhook URL makes the bot invalid" do
+    @bot.webhook_url = "ftp://bots.example.com"
+
+    assert_not @bot.save
+    assert_equal "https://bots.example.com/deploy", @bot.reload.webhook_url
+  end
+
+  test "deactivating a bot removes its webhook" do
+    @bot.deactivate
+    assert_not Webhook.exists?(user: @bot)
+  end
+
+  test "members can have as many bots as the account allows" do
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+
+    users(:kevin).bots.create!(name: "One")
+    assert_not users(:kevin).reached_bot_limit?
+
+    users(:kevin).bots.create!(name: "Two")
+    assert users(:kevin).reached_bot_limit?
+
+    bot = users(:kevin).bots.new(name: "Three")
+    assert_not bot.save
+    assert_equal [ "You’ve reached the limit of 2 chat bots per member" ], bot.errors.full_messages
+    assert_equal 2, users(:kevin).bots.count
+  end
+
+  test "members can have 5 bots by default" do
+    4.times { |i| users(:jz).bots.create!(name: "Bot #{i}") }
+    assert users(:jz).reached_bot_limit?
+
+    assert_raises(ActiveRecord::RecordInvalid) { users(:jz).bots.create!(name: "One too many") }
+  end
+
+  test "deleted bots don't count toward the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    assert users(:jz).reached_bot_limit?
+
+    users(:deploy_bot).deactivate
+    assert_not users(:jz).reached_bot_limit?
+    assert users(:jz).bots.create!(name: "Release Bot").persisted?
+  end
+
+  test "banned bots count toward the limit, since they can be unbanned" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    users(:deploy_bot).ban
+    assert users(:jz).reached_bot_limit?
+  end
+
+  test "administrators can have any number of bots" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+    assert_not users(:david).reached_bot_limit?
+    assert users(:david).bots.create!(name: "Admin Bot").persisted?
+  end
+
+  test "lowering the limit keeps existing bots, and they can still be changed" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+    assert users(:jz).reached_bot_limit?
+    assert @bot.reload.active?
+
+    @bot.update!(name: "Release Bot", webhook_url: "https://bots.example.com/v2")
+    @bot.reset_bot_key
+    assert_equal "Release Bot", @bot.reload.name
+  end
+
+  test "administrators who become members are limited from then on" do
+    users(:david).bots.create!(name: "Admin Bot")
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    users(:david).member!
+
+    assert users(:david).reached_bot_limit?
+    assert_not users(:david).bots.new(name: "Another Bot").save
+  end
+
+  test "bots without a creator aren't limited" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    assert User.create!(name: "Orphan Bot", role: :bot).persisted?
+  end
+end
diff --git a/test/models/user/rate_limited_test.rb b/test/models/user/rate_limited_test.rb
new file mode 100644
index 0000000..471f141
--- /dev/null
+++ b/test/models/user/rate_limited_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class User::RateLimitedTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:deploy_bot)
+    @room = rooms(:designers)
+
+    freeze_time
+  end
+
+  test "a bot can post 10 messages in 10 seconds" do
+    assert_difference -> { @bot.messages.count }, +10 do
+      10.times { assert post_as_bot }
+    end
+
+    assert_not @bot.cooling_down?
+  end
+
+  test "the message that goes over the limit is refused and starts a 30-second cooldown" do
+    10.times { post_as_bot }
+
+    assert_no_difference -> { Message.count } do
+      assert_nil post_as_bot
+    end
+
+    assert @bot.cooling_down?
+    assert_equal 30, @bot.cooldown_seconds_left
+    assert_not @bot.suspended?
+  end
+
+  test "the limit applies to any 10 seconds, so messages count until they're 10 seconds old" do
+    5.times { post_as_bot }
+    travel 6.seconds
+    5.times { post_as_bot }
+
+    travel 4.seconds
+    5.times { assert post_as_bot }
+    assert_nil post_as_bot
+  end
+
+  test "every message is refused during the cooldown, and the bot can post again after it" do
+    11.times { post_as_bot }
+
+    travel 29.seconds
+    assert_nil post_as_bot
+    assert_equal 1, @bot.cooldown_seconds_left
+
+    travel 1.second
+    assert_not @bot.cooling_down?
+    assert_equal 0, @bot.cooldown_seconds_left
+    assert post_as_bot
+  end
+
+  test "five more attempts to post during the same cooldown suspend the bot for flooding" do
+    11.times { post_as_bot }
+
+    4.times { assert_nil post_as_bot }
+    assert_not @bot.reload.suspended?
+
+    assert_nil post_as_bot
+    assert @bot.reload.suspended?
+    assert @bot.suspended_for_flooding?
+    assert_equal Time.current, @bot.suspended_at
+  end
+
+  test "attempts only count towards suspension within the same cooldown" do
+    11.times { post_as_bot }
+    4.times { post_as_bot }
+
+    travel 30.seconds
+    10.times { assert post_as_bot }
+    assert_nil post_as_bot
+    4.times { post_as_bot }
+
+    assert_not @bot.reload.suspended?
+  end
+
+  test "replies refused during the cooldown don't count as attempts" do
+    11.times { post_as_bot }
+    10.times { assert_nil post_as_bot(counting_attempts: false) }
+
+    assert @bot.cooling_down?
+    assert_not @bot.reload.suspended?
+  end
+
+  test "replies count towards the limit and can start the cooldown too" do
+    9.times { post_as_bot }
+    assert post_as_bot(counting_attempts: false)
+
+    assert_nil post_as_bot(counting_attempts: false)
+    assert @bot.cooling_down?
+  end
+
+  test "a suspended bot can't post" do
+    @bot.suspend :failing_webhook
+
+    assert_no_difference -> { Message.count } do
+      assert_nil post_as_bot
+    end
+  end
+
+  test "the cooldown doesn't change the bot's updated_at, which versions its avatar URL" do
+    10.times { post_as_bot }
+    travel 1.second
+
+    assert_no_changes -> { @bot.reload.updated_at } do
+      2.times { assert_nil post_as_bot }
+    end
+  end
+
+  private
+    def post_as_bot(**options)
+      @bot.post_within_rate_limit(**options) { @room.messages.create!(body: "Deploying", creator: @bot) }
+    end
+end
diff --git a/test/models/user/suspendable_test.rb b/test/models/user/suspendable_test.rb
new file mode 100644
index 0000000..ff449c9
--- /dev/null
+++ b/test/models/user/suspendable_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class User::SuspendableTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:deploy_bot)
+  end
+
+  test "suspending a bot records when and why" do
+    freeze_time
+
+    @bot.suspend :failing_webhook
+
+    assert @bot.reload.suspended?
+    assert @bot.suspended_for_failing_webhook?
+    assert_equal Time.current, @bot.suspended_at
+    assert_includes User.suspended, @bot
+    assert_not_includes User.not_suspended, @bot
+  end
+
+  test "suspending a suspended bot keeps its first reason" do
+    @bot.suspend :flooding
+    suspended_at = @bot.suspended_at
+
+    travel 1.minute
+    @bot.suspend :failing_webhook
+
+    assert @bot.reload.suspended_for_flooding?
+    assert_equal suspended_at, @bot.suspended_at
+  end
+
+  test "a suspended bot keeps its rooms and messages, and stays active" do
+    message = rooms(:designers).messages.create!(body: "Deployed", creator: @bot)
+    room_ids = @bot.rooms.ids.sort
+
+    @bot.suspend :flooding
+
+    assert @bot.reload.active?
+    assert_equal room_ids, @bot.rooms.ids.sort
+    assert Message.exists?(message.id)
+    assert_equal @bot, User.authenticate_bot(@bot.bot_key)
+  end
+
+  test "a suspended bot still counts towards its creator's bot limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    @bot.suspend :flooding
+
+    assert users(:jz).reached_bot_limit?
+  end
+
+  test "reactivating gives the bot a clean slate" do
+    freeze_time
+    room = rooms(:designers)
+    10.times { @bot.post_within_rate_limit { room.messages.create!(body: "Deploying", creator: @bot) } }
+    6.times { @bot.post_within_rate_limit { flunk "posted during the cooldown" } }
+    webhooks(:deploy_bot).update!(consecutive_failures: 4)
+    assert @bot.reload.suspended?
+
+    @bot.reactivate
+
+    assert_not @bot.reload.suspended?
+    assert_nil @bot.suspension_reason
+    assert_not @bot.cooling_down?
+    assert_equal 0, @bot.cooldown_attempts
+    assert_equal 0, webhooks(:deploy_bot).reload.consecutive_failures
+  end
+
+  test "reactivating a bot without a webhook" do
+    bot = users(:kevin).bots.create!(name: "Quiet Bot")
+    bot.suspend :flooding
+
+    bot.reactivate
+    assert_not bot.reload.suspended?
+  end
+end
diff --git a/test/models/webhook/payload_test.rb b/test/models/webhook/payload_test.rb
