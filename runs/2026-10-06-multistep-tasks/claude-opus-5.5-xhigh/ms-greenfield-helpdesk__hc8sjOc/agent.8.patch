index 0000000..4dedca6
--- /dev/null
+++ b/db/migrate/20250101000020_add_account_id_and_id_indexes.rb
@@ -0,0 +1,15 @@
+# Users (every customer who ever wrote in) and invitations are listed by ID
+# within a business. Paging such a list by cursor asks for the business's
+# records after an ID, which these indexes answer directly however deep the
+# page is; without them the database sorts all of the business's records, or
+# skips past other businesses' in the primary key. (Tickets and comments
+# already have indexes in their list order; groups and memberships stay small.)
+# Built concurrently so the tables stay writable meanwhile.
+class AddAccountIdAndIdIndexes < ActiveRecord::Migration[8.1]
+  disable_ddl_transaction!
+
+  def change
+    add_index :users, [ :account_id, :id ], name: "index_users_on_account_id_and_id", algorithm: :concurrently
+    add_index :invitations, [ :account_id, :id ], name: "index_invitations_on_account_id_and_id", algorithm: :concurrently
+  end
+end
