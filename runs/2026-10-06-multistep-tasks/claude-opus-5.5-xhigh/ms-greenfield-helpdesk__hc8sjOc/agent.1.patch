+# Links into the separate frontend app (HELPDESK_FRONTEND_URL).
+module FrontendUrl
+  module_function
+
+  def email_verification(account, token)
+    build("/verify-email", account: account.subdomain, token: token)
+  end
+
+  def password_reset(account, token)
+    build("/reset-password", account: account.subdomain, token: token)
+  end
+
+  def build(path, **query)
+    "#{Rails.configuration.x.frontend_url}#{path}?#{URI.encode_www_form(query)}"
+  end
+end
diff --git a/lib/opaque_token.rb b/lib/opaque_token.rb
new file mode 100644
index 0000000..54c88a2
--- /dev/null
+++ b/lib/opaque_token.rb
@@ -0,0 +1,17 @@
+# Random, unguessable tokens handed to clients (session tokens, email links).
+# Only their SHA-256 digest is persisted, so a database leak does not expose
+# usable credentials. A fast hash is fine here because the tokens carry 256
+# bits of entropy.
+module OpaqueToken
+  BYTES = 32
+
+  module_function
+
+  def generate
+    SecureRandom.urlsafe_base64(BYTES)
+  end
+
+  def digest(token)
+    OpenSSL::Digest::SHA256.hexdigest(token.to_s)
+  end
+end
