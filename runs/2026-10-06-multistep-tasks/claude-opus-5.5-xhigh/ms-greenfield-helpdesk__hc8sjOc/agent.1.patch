+++ b/test/models/account_registration_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class AccountRegistrationTest < ActiveSupport::TestCase
+  setup do
+    @registration = AccountRegistration.new(name: "Initech", subdomain: "initech",
+      admin: { name: "Jo", email: "jo@initech.test", password: "my-first-password" })
+  end
+
+  test "creates the account with a verified-pending admin owner" do
+    assert @registration.save
+    assert @registration.account.persisted?
+    user = @registration.user
+    assert user.persisted?
+    assert_equal [ "admin", true, false ], [ user.role, user.owner?, user.verified? ]
+    assert user.email_verification_token_digest.present?
+  end
+
+  test "losing a race on the subdomain after validation is a validation error" do
+    @registration.account.define_singleton_method(:save!) do |**options|
+      Account.create!(name: "Rival", subdomain: "initech")
+      super(**options)
+    end
+
+    assert_not @registration.save
+    assert_equal({ subdomain: [ "has already been taken" ] }, @registration.errors.to_hash)
+  end
+
+  test "a unique index violation on the subdomain is a validation error" do
+    @registration.account.define_singleton_method(:save!) { |**| raise ActiveRecord::RecordNotUnique, "duplicate key" }
+
+    assert_not @registration.save
+    assert_equal({ subdomain: [ "has already been taken" ] }, @registration.errors.to_hash)
+  end
+
+  test "a mail server failure does not fail the signup" do
+    failing = Class.new { def initialize(*) = nil; def deliver!(*) = raise(Errno::ECONNREFUSED) }
+    ActionMailer::Base.add_delivery_method :failing, failing
+    original, ActionMailer::Base.delivery_method = ActionMailer::Base.delivery_method, :failing
+
+    assert @registration.save
+    assert @registration.account.persisted?
+  ensure
+    ActionMailer::Base.delivery_method = original
+  end
+end
diff --git a/test/models/account_test.rb b/test/models/account_test.rb
new file mode 100644
index 0000000..687e306
--- /dev/null
+++ b/test/models/account_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class AccountTest < ActiveSupport::TestCase
+  test "purge deletes accounts cancelled more than 90 days ago with all their data" do
+    acme = accounts(:acme)
+    acme.cancel!
+    acme.users.first.sessions.create!
+    globex = accounts(:globex)
+    globex.cancel!
+
+    travel_to acme.cancelled_at + 90.days + 1.second do
+      globex.update_columns(cancelled_at: 10.days.ago)
+      assert_equal 1, Account.purge_cancelled!
+    end
+
+    assert_not Account.exists?(acme.id)
+    assert_equal 0, User.where(account_id: acme.id).count
+    assert_equal 0, Session.joins(:user).where(users: { account_id: acme.id }).count
+    assert Account.exists?(globex.id)
+    assert User.where(account_id: globex.id).exists?
+  end
+
+  test "purge leaves active and recently cancelled accounts alone" do
+    accounts(:acme).cancel!
+    travel 89.days do
+      assert_equal 0, Account.purge_cancelled!
+    end
+    assert_equal 2, Account.count
+  end
+
+  test "the purge rake task" do
+    Rails.application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+    accounts(:acme).update_columns(cancelled_at: 91.days.ago)
+
+    assert_output(/Purged 1 cancelled account/) do
+      Rake::Task["helpdesk:purge_cancelled_accounts"].execute
+    end
+    assert_not Account.exists?(accounts(:acme).id)
+  end
+
+  test "subdomain format" do
+    %w[initech initech-2 a1 x 0-0].each { |s| assert Account.new(name: "A", subdomain: s).valid?, s }
+    [ "-initech", "initech-", "ini_tech", "ini.tech", "ini tech", "a" * 64, "admin", "acme" ].each do |s|
+      assert_not Account.new(name: "A", subdomain: s).valid?, s
+    end
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
new file mode 100644
index 0000000..09cdb36
--- /dev/null
+++ b/test/test_helper.rb
@@ -0,0 +1,65 @@
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+require "rails/test_help"
+
+module ActiveSupport
+  class TestCase
+    # Run tests in parallel with specified workers
+    parallelize(workers: :number_of_processors)
+
+    # Setup all fixtures in test/fixtures/*.yml for all tests in alphabetical order.
+    fixtures :all
+  end
+end
+
+# Helpers for exercising the JSON API.
+module ApiTestHelpers
+  PASSWORD = "password123".freeze
+
+  def json
+    JSON.parse(response.body)
+  end
+
+  def api_headers(account: nil, token: nil)
+    headers = { "Content-Type" => "application/json", "Accept" => "application/json" }
+    headers["X-Helpdesk-Account"] = account.respond_to?(:subdomain) ? account.subdomain : account if account
+    headers["Authorization"] = "Bearer #{token}" if token
+    headers
+  end
+
+  %i[get post put patch delete].each do |verb|
+    define_method(:"api_#{verb}") do |path, body = nil, account: nil, token: nil|
+      public_send(verb, "/api/v1#{path}", params: body&.to_json, headers: api_headers(account: account, token: token))
+    end
+  end
+
+  def sign_in(user, password: PASSWORD)
+    api_post "/sessions", { session: { email: user.email, password: password } }, account: user.account
+    assert_response :created
+    json.dig("session", "token")
+  end
+
+  def sign_up(subdomain: "initech", email: "jo@initech.test", password: "my-first-password")
+    api_post "/account/create", {
+      account: { name: "Initech", subdomain: subdomain, admin: { name: "Jo", email: email, password: password } }
+    }
+  end
+
+  def last_email
+    ActionMailer::Base.deliveries.last
+  end
+
+  # Extracts the token from the frontend link in an email's text part.
+  def token_from_email(mail, path)
+    body = (mail.text_part || mail).body.decoded
+    link = body[%r{#{Regexp.escape(Rails.configuration.x.frontend_url)}#{path}\?\S+}]
+    assert link, "Expected a #{path} link in:\n#{body}"
+    Rack::Utils.parse_query(URI.parse(link).query).fetch("token")
+  end
+end
+
+class ActionDispatch::IntegrationTest
+  include ApiTestHelpers
+
+  setup { ActionMailer::Base.deliveries.clear }
+end
