new file mode 100644
index 0000000..8827819
--- /dev/null
+++ b/Gemfile
@@ -0,0 +1,14 @@
+source "https://rubygems.org"
+
+gem "rails", "~> 8.1.4"
+# PostgreSQL adapter for Active Record
+gem "pg", "~> 1.1"
+# Application server
+gem "puma", ">= 5.0"
