diff --git a/config/application.rb b/config/application.rb
new file mode 100644
index 0000000..30f2b60
--- /dev/null
+++ b/config/application.rb
@@ -0,0 +1,78 @@
+require_relative "boot"
+
+require "rails"
+# Pick the frameworks you want:
+require "active_model/railtie"
+require "active_job/railtie"
+require "active_record/railtie"
+# require "active_storage/engine"
+require "action_controller/railtie"
+require "action_mailer/railtie"
+# require "action_mailbox/engine"
+# require "action_text/engine"
+require "action_view/railtie"
+# require "action_cable/engine"
+require "rails/test_unit/railtie"
+
+# Require the gems listed in Gemfile, including any gems
+# you've limited to :test, :development, or :production.
+Bundler.require(*Rails.groups)
+
+# DATABASE_URL overrides config/database.yml for whichever environment is
+# running. Guard against the test suite (which truncates tables) running
+# against the development database when DATABASE_URL points at it.
+if Rails.env.test?
+  if ENV["TEST_DATABASE_URL"].present?
+    ENV["DATABASE_URL"] = ENV["TEST_DATABASE_URL"]
+  elsif ENV["DATABASE_URL"].present?
+    ENV["DATABASE_URL"] = ENV["DATABASE_URL"].sub(%r{/([^/?]+)_development(?=\?|\z)}, '/\1_test')
+  end
+end
+
+module Helpdesk
+  class Application < Rails::Application
+    # Initialize configuration defaults for originally generated Rails version.
+    config.load_defaults 8.1
+
+    # Please, add to the `ignore` list any other `lib` subdirectories that do
+    # not contain `.rb` files, or that should not be reloaded or eager loaded.
+    # Common ones are `templates`, `generators`, or `middleware`, for example.
+    config.autoload_lib(ignore: %w[assets tasks])
+
+    config.time_zone = "UTC"
+
+    # Only loads a smaller set of middleware suitable for API only apps.
+    config.api_only = true
+
+    # --- Helpdesk settings -------------------------------------------------
+
+    # Base URL of the separate frontend app. Email links point here and it is
+    # the only origin allowed to make cross-origin requests.
+    config.x.frontend_url = (ENV["HELPDESK_FRONTEND_URL"].presence || "http://localhost:3001").chomp("/")
+    config.x.frontend_origin = begin
+      uri = URI.parse(config.x.frontend_url)
+      port = ":#{uri.port}" if uri.port && uri.port != uri.default_port
+      "#{uri.scheme}://#{uri.host}#{port}".downcase
+    rescue URI::InvalidURIError
+      raise ArgumentError, "HELPDESK_FRONTEND_URL is not a valid URL: #{config.x.frontend_url.inspect}"
+    end
+
+    # Sender address for all outgoing email.
+    config.x.mail_from = ENV["HELPDESK_MAIL_FROM"].presence || "support@example.test"
+
+    # Outgoing mail goes over SMTP. Defaults to localhost:25 (the Action Mailer
+    # default); point it elsewhere with the SMTP_* variables.
+    if ENV["SMTP_ADDRESS"].present?
+      config.action_mailer.delivery_method = :smtp
+      config.action_mailer.smtp_settings = {
+        address: ENV["SMTP_ADDRESS"],
+        port: Integer(ENV.fetch("SMTP_PORT", 587)),
+        domain: ENV["SMTP_DOMAIN"],
+        user_name: ENV["SMTP_USERNAME"],
+        password: ENV["SMTP_PASSWORD"],
+        authentication: ENV["SMTP_AUTHENTICATION"]&.to_sym,
+        enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+      }.compact
+    end
+  end
+end
