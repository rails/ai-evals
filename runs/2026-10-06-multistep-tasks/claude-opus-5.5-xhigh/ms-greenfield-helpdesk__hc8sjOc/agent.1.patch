index 0000000..de38a3a
--- /dev/null
+++ b/app/mailers/application_mailer.rb
@@ -0,0 +1,13 @@
+class ApplicationMailer < ActionMailer::Base
+  default from: -> { Rails.configuration.x.mail_from }
+  layout "mailer"
+
+  # A mail server outage must not fail the request that triggered the email
+  # (the account or token has already been saved); users can request another
+  # link. Log and report the failure instead.
+  rescue_from Net::SMTPError, Net::ProtocolError, IOError, SocketError, SystemCallError,
+    Timeout::Error, OpenSSL::SSL::SSLError do |error|
+    Rails.error.report(error, handled: true, source: "application.action_mailer")
+    logger&.error("[#{self.class.name}##{action_name}] Email delivery failed: #{error.class}: #{error.message}")
+  end
+end
