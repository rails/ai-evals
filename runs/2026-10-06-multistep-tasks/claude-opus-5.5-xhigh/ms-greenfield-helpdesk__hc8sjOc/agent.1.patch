+module Api
+  module V1
+    class PasswordChangesController < BaseController
+      # PUT /api/v1/me/password
+      #
+      # Every existing session is signed out, including the one making the
+      # request; a fresh session is returned so this client stays signed in.
+      def update
+        change = PasswordChange.new(user: Current.user, **password_change_params.to_h.symbolize_keys)
+
+        if change.save
+          render json: {
+            user: UserSerializer.new(Current.user),
+            session: SessionSerializer.new(start_session_for(Current.user))
+          }
+        else
+          render_validation_errors change.errors
+        end
+      end
+
+      private
+        def password_change_params
+          params.expect(password_change: [ :current_password, :password, :password_confirmation ])
+        end
+    end
+  end
+end
