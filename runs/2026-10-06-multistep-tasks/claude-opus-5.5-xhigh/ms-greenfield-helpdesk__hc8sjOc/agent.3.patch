+      private
+        def set_user
+          @user = Current.account.users.find(params[:id])
+        end
+
+        def render_user_error(message)
+          errors = ActiveModel::Errors.new(@user)
+          errors.add(:suspended, message)
+          render_validation_errors errors
+        end
+    end
+  end
+end
