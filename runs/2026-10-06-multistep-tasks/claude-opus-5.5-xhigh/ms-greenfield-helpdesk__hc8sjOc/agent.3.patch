diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..0f8a1b8
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,35 @@
+module Api
+  module V1
+    # The invitee accepts: creates their staff user, which is already verified
+    # (the emailed link proves they own the address), so they can sign in.
+    class InvitationAcceptancesController < BaseController
+      include InvitationTokenLookup
+
+      allow_unauthenticated_access
+      skip_before_action :require_active_account!
+      before_action :load_requested_account
+
+      # POST /api/v1/invitation_acceptances
+      def create
+        attributes = params.expect(invitation_acceptance: [ :token, :name, :password, :password_confirmation ])
+        invitation = find_pending_invitation(attributes[:token])
+        return unless invitation
+
+        acceptance = InvitationAcceptance.new(invitation: invitation,
+          **attributes.to_h.symbolize_keys.slice(:name, :password, :password_confirmation))
+
+        if acceptance.save
+          render json: {
+            user: UserSerializer.new(acceptance.user),
+            account: AccountSerializer.new(invitation.account)
+          }, status: :created
+        else
+          render_validation_errors acceptance.errors
+        end
+      rescue Invitation::StateError
+        # Accepted, revoked or expired since it was looked up.
+        render_invalid_invitation(invitation.reload.status)
+      end
+    end
+  end
+end
