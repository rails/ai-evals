+# PostgreSQL. Connection details come from DATABASE_URL, which takes
+# precedence over the values below for the running environment, e.g.
+#
+#   DATABASE_URL=postgresql:///helpdesk_development?host=/var/lib/postgresql
+#
+# When running the test suite, a DATABASE_URL ending in "_development" is
+# rewritten to "_test" (see config/application.rb), or set TEST_DATABASE_URL.
+default: &default
+  adapter: postgresql
+  encoding: unicode
+  # https://guides.rubyonrails.org/configuring.html#database-pooling
+  max_connections: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>
+
+development:
+  <<: *default
+  database: helpdesk_development
+
+test:
+  <<: *default
+  database: helpdesk_test
+
+production:
+  <<: *default
+  database: helpdesk_production
