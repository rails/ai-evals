diff --git a/app/controllers/concerns/account_scoping.rb b/app/controllers/concerns/account_scoping.rb
new file mode 100644
index 0000000..e5b98ad
--- /dev/null
+++ b/app/controllers/concerns/account_scoping.rb
@@ -0,0 +1,42 @@
+# Requests choose a business with the X-Helpdesk-Account header, whose value
+# is the account's subdomain.
+module AccountScoping
+  extend ActiveSupport::Concern
+
+  ACCOUNT_HEADER = "X-Helpdesk-Account".freeze
+
+  private
+    def requested_subdomain
+      return @requested_subdomain if defined?(@requested_subdomain)
+
+      @requested_subdomain = request.headers[ACCOUNT_HEADER].to_s.strip.downcase.presence
+    end
+
+    # Before action: the header is mandatory.
+    def require_account!
+      if requested_subdomain.nil?
+        render_error :bad_request, "account_required", "Choose a business with the #{ACCOUNT_HEADER} header."
+      else
+        load_requested_account
+      end
+    end
+
+    # Before action: the header is optional, but must name an existing
+    # business when given.
+    def load_requested_account
+      return if requested_subdomain.nil?
+
+      Current.account = Account.find_by(subdomain: requested_subdomain)
+      render_error :not_found, "account_not_found", "No business uses the subdomain #{requested_subdomain.inspect}." unless Current.account
+    end
+
+    # Before action: a cancelled business is closed for ordinary use. Its
+    # owner may still sign in in order to reactivate it.
+    def require_active_account!
+      render_account_cancelled if Current.account&.cancelled?
+    end
+
+    def render_account_cancelled
+      render_error :forbidden, "account_cancelled", "This business account has been cancelled."
+    end
+end
diff --git a/app/controllers/concerns/authentication.rb b/app/controllers/concerns/authentication.rb
new file mode 100644
index 0000000..a22db67
--- /dev/null
+++ b/app/controllers/concerns/authentication.rb
@@ -0,0 +1,37 @@
+# Bearer token authentication:  Authorization: Bearer <session token>
+module Authentication
+  extend ActiveSupport::Concern
+
+  include ActionController::HttpAuthentication::Token::ControllerMethods
+
+  included do
+    before_action :authenticate!
+  end
+
+  class_methods do
+    def allow_unauthenticated_access(**options)
+      skip_before_action :authenticate!, **options
+    end
+  end
+
+  private
+    def authenticate!
+      user_session = authenticate_with_http_token { |token, _options| Session.find_by_token(token) }
+
+      # A session only works for the business it was created in. Suspension
+      # revokes sessions; checking here as well covers one being created
+      # concurrently with the suspension.
+      if user_session.nil? || user_session.user.suspended? ||
+          (requested_subdomain && requested_subdomain != user_session.user.account.subdomain)
+        response.headers["WWW-Authenticate"] = %(Bearer realm="Helpdesk")
+        render_error :unauthorized, "unauthorized", "Sign in to continue."
+      else
+        Current.session = user_session
+        Current.account = user_session.user.account
+      end
+    end
+
+    def start_session_for(user)
+      user.sessions.create!(ip_address: request.remote_ip, user_agent: request.user_agent.to_s.first(255).presence)
+    end
+end
diff --git a/app/controllers/concerns/error_rendering.rb b/app/controllers/concerns/error_rendering.rb
new file mode 100644
index 0000000..c20c894
--- /dev/null
+++ b/app/controllers/concerns/error_rendering.rb
@@ -0,0 +1,43 @@
+# Consistent JSON error bodies:
+#
+#   { "error": { "code": "invalid_credentials", "message": "..." } }
+#
+# Validation failures also list messages per field, under both
+# error.details and errors.
+module ErrorRendering
+  extend ActiveSupport::Concern
+
+  included do
+    rescue_from ActionController::ParameterMissing, ActionDispatch::Http::Parameters::ParseError,
+      with: :render_bad_request
+    rescue_from ActiveRecord::RecordNotFound, with: :render_not_found
+  end
+
+  private
+    def render_error(status, code, message, **extra)
+      render json: { error: { code: code, message: message, **extra } }, status: status
+    end
+
+    def render_validation_errors(errors)
+      details = errors.to_hash
+      render json: {
+        error: { code: "validation_failed", message: errors.full_messages.to_sentence, details: details },
+        errors: details
+      }, status: :unprocessable_content
+    end
+
+    def render_bad_request(exception)
+      message = exception.is_a?(ActionController::ParameterMissing) ?
+        "Missing or invalid parameter: #{exception.param}" : "The request body is not valid JSON."
+      render_error :bad_request, "bad_request", message
+    end
+
+    def render_not_found(_exception = nil)
+      render_error :not_found, "not_found", "Not found."
+    end
+
+    def render_too_many_requests(retry_after: 1.minute)
+      response.headers["Retry-After"] = retry_after.to_i.to_s
+      render_error :too_many_requests, "too_many_requests", "Too many attempts. Please try again later."
+    end
+end
diff --git a/app/controllers/concerns/invitation_token_lookup.rb b/app/controllers/concerns/invitation_token_lookup.rb
new file mode 100644
index 0000000..5ddffa2
--- /dev/null
+++ b/app/controllers/concerns/invitation_token_lookup.rb
@@ -0,0 +1,41 @@
+# Finds the invitation for an emailed token, for the public acceptance flow.
+# Like the other token endpoints, X-Helpdesk-Account is optional (tokens are
+# unique), but if given it must be the invitation's business.
+#
+# Unusable tokens are 422 invalid_token. For an invitation that exists but is
+# no longer pending, error.reason says why ("expired", "revoked" or
+# "accepted") so the frontend can explain what to do next.
+module InvitationTokenLookup
+  extend ActiveSupport::Concern
+
+  INVALID_MESSAGES = {
+    nil => "This invitation link is invalid. Ask an admin to send you a new one.",
+    "expired" => "This invitation has expired. Ask an admin to resend it.",
+    "revoked" => "This invitation has been revoked.",
+    "accepted" => "This invitation has already been accepted. Please sign in."
+  }.freeze
+
+  private
+    # Returns the pending invitation, or renders an error and returns nil.
+    def find_pending_invitation(token)
+      scope = Current.account ? Current.account.invitations : Invitation.all
+      invitation = scope.includes(:account, :invited_by).find_by_token(token.to_s)
+
+      if invitation.nil?
+        render_invalid_invitation(nil)
+      elsif invitation.account.cancelled?
+        render_account_cancelled
+      elsif !invitation.pending?
+        render_invalid_invitation(invitation.status)
+      else
+        return invitation
+      end
+
+      nil
+    end
+
+    def render_invalid_invitation(reason)
+      extra = reason ? { reason: reason } : {}
+      render_error :unprocessable_content, "invalid_token", INVALID_MESSAGES.fetch(reason), **extra
+    end
+end
diff --git a/app/controllers/concerns/list_filters.rb b/app/controllers/concerns/list_filters.rb
new file mode 100644
index 0000000..85eee07
--- /dev/null
+++ b/app/controllers/concerns/list_filters.rb
@@ -0,0 +1,87 @@
+# Optional query parameters that narrow a list:  ?role=agent&suspended=false
+#
+# A blank value means "no filter". Any other value that isn't allowed (or
+# isn't a single value, like ?role[]=agent) is 400 bad_request, rather than
+# silently returning everything or nothing.
+module ListFilters
+  extend ActiveSupport::Concern
+
+  class InvalidFilter < StandardError
+    attr_reader :param
+
+    def initialize(param, requirement)
+      @param = param
+      super("#{param} #{requirement}")
+    end
+  end
+
+  included do
+    rescue_from InvalidFilter do |error|
+      render_error :bad_request, "bad_request", error.message
+    end
+  end
+
+  private
+    # The value of query parameter +name+ if it is one of +allowed+ (ignoring
+    # case); nil if it is absent or blank.
+    def enum_filter(name, allowed)
+      parse_filter(name, "must be one of: #{allowed.join(", ")}.") do |text|
+        text.downcase.presence_in(allowed)
+      end
+    end
+
+    # true or false if query parameter +name+ is "true" or "false"; nil if it
+    # is absent or blank.
+    def boolean_filter(name)
+      value = enum_filter(name, %w[true false])
+      value && value == "true"
+    end
+
+    # A record ID (a positive integer) given in query parameter +name+, or one
+    # of the +keywords+ (ignoring case, e.g. "unassigned"); nil if it is absent
+    # or blank. An ID that matches nothing is still valid: it filters
+    # everything out.
+    def id_filter(name, keywords: [])
+      parse_filter(name, "must be #{[ "a positive integer ID", *keywords ].join(" or ")}.") do |text|
+        if keywords.include?(text.downcase)
+          text.downcase
+        elsif text.match?(/\A\d+\z/) && text.to_i.positive?
+          text.to_i
+        end
+      end
+    end
+
+    # Free text to search for, from query parameter +name+, with surrounding
+    # whitespace removed; nil if it is absent or blank. The text is taken
+    # literally. NUL characters can't occur in stored text (and the database
+    # rejects them), so they are a bad request.
+    def search_filter(name)
+      parse_filter(name, "must be text without NUL characters.") do |text|
+        text unless text.include?("\0")
+      end
+    end
+
+    # Yields the value of query parameter +name+, without surrounding
+    # whitespace, to the block, which returns the filter value or nil if the
+    # text isn't allowed. Returns nil if the parameter is absent or blank.
+    # Raises InvalidFilter, saying the parameter +requirement+, for values that
+    # aren't allowed or aren't strings.
+    def parse_filter(name, requirement)
+      value = params[name]
+      return if value.nil?
+
+      text = strip_whitespace(value) if value.is_a?(String)
+      return if text == ""
+
+      filter = yield(text) unless text.nil?
+      raise InvalidFilter.new(name, requirement) if filter.nil?
+
+      filter
+    end
+
+    # Like String#strip, but for any Unicode whitespace (e.g. a pasted
+    # non-breaking space), and not for NUL characters.
+    def strip_whitespace(text)
+      text.gsub(/\A[[:space:]]+|[[:space:]]+\z/, "")
+    end
+end
diff --git a/app/controllers/concerns/pagination.rb b/app/controllers/concerns/pagination.rb
new file mode 100644
index 0000000..bd9f42c
--- /dev/null
+++ b/app/controllers/concerns/pagination.rb
@@ -0,0 +1,137 @@
+# Lists come in pages, numbered or by cursor.
+#
+# Page-numbered:  ?page=2&per_page=50
+#
+#   { "<records>": [...], "count": 120, "page": 2, "per_page": 50,
+#     "next_page": 3, "previous_page": 1 }
+#
+# count is the total number of records across all pages; next_page and
+# previous_page are page numbers, or null when there is no such page.
+#
+# By cursor:  ?page[size]=50, then ?page[size]=50&page[after]=<cursor>
+# (or page[before]=<cursor>)
+#
+#   { "<records>": [...],
+#     "meta": { "has_more": true, "after_cursor": "...", "before_cursor": "..." },
+#     "links": { "next": "https://.../tickets?page[after]=...&page[size]=50", "prev": null } }
+#
+# after_cursor and before_cursor belong to the page's last and first records
+# (null for an empty page). has_more says whether there are more records in
+# the direction being browsed. next and prev are URLs of the neighbouring
+# pages, with the same filters, or null when there's nothing that way. Every
+# page costs about the same however deep it is, and pages don't shift while
+# others add, change or delete records (see CursorPage). There's no count:
+# counting a long list is exactly what gets slow.
+module Pagination
+  extend ActiveSupport::Concern
+
+  DEFAULT_PER_PAGE = 25
+  MAX_PER_PAGE = 100
+  CURSOR_PARAMS = %w[size after before].freeze
+
+  class InvalidParameter < StandardError
+    attr_reader :param, :requirement
+
+    def initialize(param, requirement = "must be a positive integer")
+      @param = param
+      @requirement = requirement
+      super("#{param} #{requirement}")
+    end
+  end
+
+  included do
+    rescue_from InvalidParameter do |error|
+      render_error :bad_request, "bad_request", "#{error.param} #{error.requirement}."
+    end
+  end
+
+  private
+    # Renders one page of +scope+ (which should already be ordered) under
+    # +key+, serializing each record with +serializer+. page[...] parameters
+    # ask for a page by cursor, which needs the order to suit CursorPage;
+    # otherwise pages are numbered.
+    def render_page(scope, key:, serializer:)
+      if params[:page].is_a?(ActionController::Parameters)
+        render_cursor_page(scope, key: key, serializer: serializer)
+      else
+        render_numbered_page(scope, key: key, serializer: serializer)
+      end
+    end
+
+    def render_numbered_page(scope, key:, serializer:)
+      page = positive_integer(params[:page], "page", default: 1)
+      per_page = [ positive_integer(params[:per_page], "per_page", default: DEFAULT_PER_PAGE), MAX_PER_PAGE ].min
+
+      count = scope.count
+      offset = (page - 1) * per_page
+      # Skip the query (and any out-of-range OFFSET) past the last page.
+      records = offset < count ? scope.offset(offset).limit(per_page).to_a : []
+      total_pages = (count + per_page - 1) / per_page
+
+      render json: {
+        key => records.map { |record| serializer.new(record) },
+        count: count,
+        page: page,
+        per_page: per_page,
+        next_page: (page + 1 if page < total_pages),
+        # From beyond the last page, "previous" is the last page.
+        previous_page: ([ page - 1, total_pages ].min if page > 1 && total_pages > 0)
+      }
+    end
+
+    def render_cursor_page(scope, key:, serializer:)
+      cursor_params = params[:page]
+      unknown = cursor_params.keys - CURSOR_PARAMS
+      if unknown.any?
+        raise InvalidParameter.new("page[#{unknown.first}]", "is not a page parameter; use page[size] with page[after] or page[before]")
+      end
+      # Sizes come from page[size], so there's no telling which one was meant.
+      raise InvalidParameter.new("per_page", "can't be combined with page[...]; use page[size]") if params[:per_page].present?
+
+      size = [ positive_integer(cursor_params[:size], "page[size]", default: DEFAULT_PER_PAGE), MAX_PER_PAGE ].min
+      after = cursor_param(cursor_params, :after)
+      before = cursor_param(cursor_params, :before)
+      raise InvalidParameter.new("page[after]", "can't be combined with page[before]") if after && before
+
+      page = CursorPage.new(scope, list: key.to_s, size: size, after: after, before: before)
+
+      render json: {
+        key => page.records.map { |record| serializer.new(record) },
+        meta: { has_more: page.has_more?, after_cursor: page.after_cursor, before_cursor: page.before_cursor },
+        links: {
+          next: page.next_cursor && cursor_page_url(size: size, after: page.next_cursor),
+          prev: page.previous_cursor && cursor_page_url(size: size, before: page.previous_cursor)
+        }
+      }
+    rescue CursorPage::InvalidCursor => error
+      raise InvalidParameter.new("page[#{error.side}]", "is not a cursor of this list")
+    end
+
+    # A cursor from page[after] or page[before]; nil if it's absent or blank.
+    def cursor_param(cursor_params, side)
+      value = cursor_params[side]
+      return if value.nil? || value == ""
+      raise InvalidParameter.new("page[#{side}]", "is not a cursor of this list") unless value.is_a?(String)
+
+      value.strip.presence
+    end
+
+    # This list's URL with the same query (filters), for the page of +size+
+    # records after or before a cursor. Absolute, because clients run on
+    # another origin.
+    def cursor_page_url(size:, **cursor)
+      query = request.query_parameters.except("page", "per_page")
+        .merge("page" => { "size" => size, **cursor.transform_keys(&:to_s) })
+      "#{request.base_url}#{request.path}?#{query.to_query}"
+    end
+
+    def positive_integer(value, name, default:)
+      return default if value.blank?
+
+      text = value.is_a?(String) || value.is_a?(Integer) ? value.to_s.strip : ""
+      integer = text.match?(/\A\d+\z/) ? text.to_i : nil
+      raise InvalidParameter, name if integer.nil? || integer < 1
+
+      integer
+    end
+end
