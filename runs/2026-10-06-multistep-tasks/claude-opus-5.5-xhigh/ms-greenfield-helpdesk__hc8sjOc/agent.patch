+# Links into the separate frontend app (HELPDESK_FRONTEND_URL).
+module FrontendUrl
+  module_function
+
+  def email_verification(account, token)
+    build("/verify-email", account: account.subdomain, token: token)
+  end
+
+  def password_reset(account, token)
+    build("/reset-password", account: account.subdomain, token: token)
+  end
