diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..bd6ec18
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,155 @@
+# A business using the helpdesk. Each account is a tenant with its own users,
+# addressed by its subdomain (sent by clients in the X-Helpdesk-Account header).
+class Account < ApplicationRecord
+  class StateError < StandardError; end
+  class AlreadyCancelled < StateError; end
+  class NotCancelled < StateError; end
+  class ReactivationWindowExpired < StateError; end
+
+  # Cancelled accounts can be reactivated for this long, then they are purged.
+  REACTIVATION_WINDOW = 90.days
+
+  SUBDOMAIN_FORMAT = /\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z/
+  RESERVED_SUBDOMAINS = %w[
+    admin api app assets cdn ftp imap mail pop root smtp static status system www
+  ].freeze
+
+  has_many :users, dependent: :delete_all
+  # Removed by ON DELETE CASCADE foreign keys along with the users.
+  has_many :tickets
+  has_many :invitations
+  has_many :groups
+  has_many :group_memberships, through: :groups
+  has_one :owner, -> { where(owner: true) }, class_name: "User", inverse_of: :account
+
+  normalizes :name, with: ->(name) { name.squish }
+  normalizes :subdomain, with: ->(subdomain) { subdomain.strip.downcase }
+
+  validates :name, presence: true, length: { maximum: 100 }
+  validates :subdomain, presence: true,
+    length: { maximum: 63 },
+    format: { with: SUBDOMAIN_FORMAT, message: "may only contain lowercase letters, numbers and hyphens, and must start and end with a letter or number" },
+    exclusion: { in: RESERVED_SUBDOMAINS, message: "is reserved" },
+    uniqueness: true
+
+  scope :active, -> { where(cancelled_at: nil) }
+  scope :cancelled, -> { where.not(cancelled_at: nil) }
+  # Accounts cancelled more than REACTIVATION_WINDOW ago.
+  scope :purgeable, ->(now = Time.current) { where(cancelled_at: ..(now - REACTIVATION_WINDOW)) }
+
+  # Permanently deletes every account (and, via cascading foreign keys, all of
+  # its data) that has stayed cancelled past the reactivation window.
+  # Returns the number of accounts deleted.
+  def self.purge_cancelled!(now: Time.current)
+    purgeable(now).find_each.count { |account| account.purge!(now: now) }
+  end
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def active?
+    !cancelled?
+  end
+
+  def status
+    cancelled? ? "cancelled" : "active"
+  end
+
+  # Where customers email the business, e.g. acme@support.example.test.
+  def support_email
+    SupportAddress.for_account(self)
+  end
+
+  # When a cancelled account will be permanently deleted.
+  def deletion_scheduled_at
+    cancelled_at && cancelled_at + REACTIVATION_WINDOW
+  end
+
+  def reactivatable?(now = Time.current)
+    cancelled? && deletion_scheduled_at > now
+  end
+
+  def purgeable?(now = Time.current)
+    cancelled? && !reactivatable?(now)
+  end
+
+  # Cancels the account and signs out all of its users.
+  def cancel!
+    with_lock do
+      raise AlreadyCancelled, "Account is already cancelled" if cancelled?
+
+      update!(cancelled_at: Time.current)
+      revoke_all_sessions!
+    end
+  end
+
+  def reactivate!
+    with_lock do
+      raise NotCancelled, "Account is not cancelled" unless cancelled?
+      raise ReactivationWindowExpired, "Account can no longer be reactivated" unless reactivatable?
+
+      update!(cancelled_at: nil)
+    end
+  end
+
+  # Deletes the account if it is (still) past its reactivation window. The row
+  # lock guards against a concurrent reactivation. Returns true if deleted.
+  def purge!(now: Time.current)
+    with_lock do
+      if purgeable?(now)
+        destroy!
+        true
+      else
+        false
+      end
+    end
+  end
+
+  def revoke_all_sessions!
+    Session.where(user_id: users.select(:id)).delete_all
+  end
+
+  # Runs the block in a transaction holding a lock on +email+ within this
+  # business. Everything that claims an address (inviting it, resending an
+  # invitation, a customer registering with it) takes this lock, so checks
+  # such as "nobody uses this email and it has no pending invitation" can't
+  # race each other. The lock is released when the transaction ends.
+  def with_email_lock(email)
+    self.class.transaction do
+      take_advisory_lock("helpdesk-email:#{id}:#{email.to_s.strip.downcase}")
+      yield
+    end
+  end
+
+  # Waits for, and takes, a lock on the received email with +message_id+
+  # within this business, so concurrent deliveries of it are taken in one at
+  # a time (see EmailIntake). Must be called inside a transaction, which
+  # holds the lock until it ends.
+  def lock_message_id(message_id)
+    take_advisory_lock("helpdesk-message-id:#{id}:#{message_id}")
+  end
+
+  # Waits for, and takes, a lock on this business's groups and memberships.
+  # Changes to them (which check names, memberships and default groups, and
+  # clean up assignments they make invalid) take it exclusively, so they are
+  # made one at a time. Ticket updates that change a group or an assignee
+  # take it shared (+shared: true+), so they run alongside each other but
+  # never alongside a change that could make them invalid, e.g. assigning a
+  # member while their membership is being removed. Must be called inside a
+  # transaction, which holds the lock until it ends, and before locking any
+  # tickets.
+  def lock_groups(shared: false)
+    take_advisory_lock("helpdesk-groups:#{id}", shared: shared)
+  end
+
+  private
+    # A PostgreSQL advisory lock on +key+, released when the transaction ends.
+    # Shared locks only exclude exclusive ones.
+    def take_advisory_lock(key, shared: false)
+      function = shared ? "pg_advisory_xact_lock_shared" : "pg_advisory_xact_lock"
+      self.class.connection.select_value(
+        self.class.sanitize_sql_array([ "SELECT 1 FROM #{function}(hashtextextended(?, 0))", key ])
+      )
+    end
+end
diff --git a/app/models/account_registration.rb b/app/models/account_registration.rb
new file mode 100644
index 0000000..6eb2423
--- /dev/null
+++ b/app/models/account_registration.rb
@@ -0,0 +1,41 @@
+# Signs up a new business: creates the account together with its owner, an
+# admin who must verify their email address before signing in.
+class AccountRegistration
+  include ActiveModel::Model
+
+  attr_reader :account, :user
+
+  def initialize(name: nil, subdomain: nil, admin: nil)
+    admin = admin.to_h.with_indifferent_access
+    @account = Account.new(name: name, subdomain: subdomain)
+    @user = @account.users.new(
+      name: admin[:name], email: admin[:email], password: admin[:password],
+      role: "admin", owner: true
+    )
+  end
+
+  # Errors on the admin are reported as "admin.<attribute>", mirroring the
+  # request body.
+  def valid?
+    errors.clear
+    account.valid?
+    user.valid?
+    account.errors.each { |error| errors.import(error) unless error.attribute == :users }
+    user.errors.each { |error| errors.import(error, attribute: :"admin.#{error.attribute}") unless error.attribute == :account }
+    errors.empty?
+  end
+
+  def save
+    return false unless valid?
+
+    token = user.generate_email_verification_token
+    account.save!
+    user.deliver_email_verification(token)
+    true
+  rescue ActiveRecord::RecordInvalid, ActiveRecord::RecordNotUnique
+    # Lost a race with a concurrent signup for the same subdomain.
+    valid?
+    errors.import(account.errors.add(:subdomain, :taken)) unless errors.of_kind?(:subdomain, :taken)
+    false
+  end
+end
