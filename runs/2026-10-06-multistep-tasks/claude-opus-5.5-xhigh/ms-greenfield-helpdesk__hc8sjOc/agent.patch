@@ -0,0 +1,63 @@
+require "test_helper"
+
+class InboundSupportEmailTest < ActiveSupport::TestCase
+  def email(source)
+    InboundSupportEmail.new(Mail.from_source(source.gsub(/\r?\n/, "\r\n")))
+  end
+
+  test "reads the sender, recipients, subject and message" do
+    parsed = email(<<~MAIL)
+      From: =?UTF-8?B?w4l0aWVubmUgRMO8cg==?= <Etienne@Example.test>
+      To: Acme <acme@support.example.test>, someone@example.test
+      Cc: reply+0123456789abcdef0123456789abcdef@support.example.test
+      Subject: =?UTF-8?Q?Caf=C3=A9?=
+      Message-ID: <abc@example.test>
+      Content-Type: text/plain; charset=ISO-8859-1
+      Content-Transfer-Encoding: quoted-printable
+
+      Bonjour =E0 tous\r
+    MAIL
+
+    assert_equal "etienne@example.test", parsed.sender_email
+    assert_equal "Étienne Dür", parsed.sender_name
+    assert_equal "abc@example.test", parsed.message_id
+    assert_equal "Café", parsed.subject
+    assert_equal "Bonjour à tous\n", parsed.body
+    assert_equal [ SupportAddress::Recipient.new(subdomain: "acme", reply_token: nil),
+      SupportAddress::Recipient.new(subdomain: nil, reply_token: "0123456789abcdef0123456789abcdef") ], parsed.support_recipients
+  end
+
+  test "envelope recipients count" do
+    parsed = email(<<~MAIL)
+      From: a@example.test
+      To: someone@example.test
+      X-Original-To: acme@support.example.test
+      Delivered-To: globex@support.example.test
+      Subject: Hi
+
+      Hi
+    MAIL
+    assert_equal %w[acme globex], parsed.support_recipients.map(&:subdomain)
+  end
+
+  test "malformed headers count as missing" do
+    parsed = email(<<~MAIL)
+      From: <<<not valid
+      To: ;;;
+      Subject: Hi
+
+      Hi
+    MAIL
+    assert_nil parsed.sender_email
+    assert_empty parsed.support_recipients
+  end
+
+  test "strips NUL characters and normalizes line endings" do
+    parsed = email("From: a@example.test\nSubject: Hi\n\nline one\r\nline\u0000 two\r")
+    assert_equal "line one\nline two\n", parsed.body
+  end
+
+  test "a person's mail isn't automated" do
+    assert_not email("From: a@example.test\nSubject: Hi\nAuto-Submitted: no\nPrecedence: normal\n\nHi").automated?
+  end
+end
diff --git a/test/models/invitation_test.rb b/test/models/invitation_test.rb
new file mode 100644
index 0000000..ad94e46
--- /dev/null
+++ b/test/models/invitation_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+
+# Simulates losing a race: the uniqueness validation doesn't see the row a
+# concurrent transaction is inserting, so only the unique index catches it.
+module UniquenessRace
+  def with_email_uniqueness_unchecked
+    validator = User.validators_on(:email).find { |v| v.is_a?(ActiveRecord::Validations::UniquenessValidator) }
+    validator.define_singleton_method(:validate_each) { |*| }
+    yield
+  ensure
+    validator.singleton_class.remove_method(:validate_each)
+  end
+end
+
+class InvitationTest < ActiveSupport::TestCase
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @invitation = accounts(:acme).invitations.new(email: "new@example.test", role: "agent", invited_by: users(:jo))
+    assert @invitation.send_invitation
+  end
+
+  test "status follows acceptance, revocation and expiry" do
+    assert_equal "pending", @invitation.status
+    assert_equal "pending", @invitation.status(@invitation.expires_at - 1.second)
+    assert_equal "expired", @invitation.status(@invitation.expires_at)
+
+    @invitation.revoke!
+    assert_equal "revoked", @invitation.status
+    assert_equal "revoked", @invitation.status(@invitation.expires_at + 1.day)
+  end
+
+  test "status scopes agree with status" do
+    @invitation.update_columns(expires_at: @invitation.expires_at.change(usec: 0)) # travel_to has 1s precision
+    travel_to @invitation.expires_at - 1.second do
+      assert_equal [ @invitation ], Invitation.pending.to_a
+      assert_empty Invitation.expired
+    end
+    travel_to @invitation.expires_at do
+      assert_empty Invitation.pending
+      assert_equal [ @invitation ], Invitation.expired.to_a
+      assert @invitation.expired?
+    end
+    assert_raises(ArgumentError) { Invitation.with_status("destroy_all") }
+  end
+
+  test "only stores a digest of the token, and finds by token" do
+    token = @invitation.token
+    assert token.present?
+    assert_equal OpaqueToken.digest(token), @invitation.token_digest
+    assert_equal @invitation, Invitation.find_by_token(token)
+    assert_equal @invitation, accounts(:acme).invitations.find_by_token(token)
+    assert_nil accounts(:globex).invitations.find_by_token(token)
+    assert_nil Invitation.find_by_token("")
+    assert_nil Invitation.find_by_token(nil)
+  end
+
+  test "an accepted invitation can't be accepted, revoked or resent" do
+    user = accounts(:acme).users.create!(name: "New", email: "other@example.test", password: "password123", role: "agent")
+    @invitation.with_lock { @invitation.accept!(user) }
+    assert @invitation.accepted?
+    assert_raises(Invitation::AlreadyAccepted) { @invitation.with_lock { @invitation.accept!(user) } }
+    assert_raises(Invitation::AlreadyAccepted) { @invitation.revoke! }
+    assert_raises(Invitation::AlreadyAccepted) { @invitation.resend }
+  end
+
+  test "a failed resend leaves the invitation as it was" do
+    digest, expires_at = @invitation.token_digest, @invitation.expires_at
+    travel Invitation::TTL + 1.second do
+      accounts(:acme).users.create!(name: "New", email: "new@example.test", password: "password123", role: "customer")
+      assert_not @invitation.resend
+      assert_equal [ "has already been taken" ], @invitation.errors[:email]
+      assert_equal [ digest, expires_at, nil ], [ @invitation.token_digest, @invitation.expires_at, @invitation.token ]
+      assert @invitation.expired?
+      assert_equal digest, @invitation.reload.token_digest
+    end
+  end
+
+  test "the database rejects invalid roles and uppercase emails" do
+    assert_raises(ActiveRecord::StatementInvalid) { Invitation.transaction(requires_new: true) { @invitation.update_columns(role: "customer") } }
+    # Raw SQL, since normalizes would lowercase the email first.
+    assert_raises(ActiveRecord::StatementInvalid) do
+      Invitation.transaction(requires_new: true) do
+        Invitation.connection.execute("UPDATE invitations SET email = 'NEW@example.test' WHERE id = #{@invitation.id}")
+      end
+    end
+    assert_raises(ActiveRecord::StatementInvalid) do
+      Invitation.transaction(requires_new: true) { @invitation.update_columns(accepted_at: Time.current, revoked_at: Time.current) }
+    end
+  end
+
+  test "an email can't be invited to the same business twice" do
+    second = accounts(:acme).invitations.new(email: "NEW@example.test", role: "admin")
+    assert_not second.send_invitation
+    assert_equal [ "already has a pending invitation" ], second.errors[:email]
+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    assert accounts(:globex).invitations.new(email: "new@example.test", role: "admin").send_invitation
+  end
+end
+
+class InvitationAcceptanceTest < ActiveSupport::TestCase
+  include UniquenessRace
+
+  test "a lost race for the email is reported as taken" do
+    invitation = accounts(:acme).invitations.new(email: "new@example.test", role: "agent")
+    assert invitation.send_invitation
+    accounts(:acme).users.create!(name: "Squatter", email: "new@example.test", password: "password123", role: "customer")
+    acceptance = InvitationAcceptance.new(invitation: invitation, name: "New", password: "password123")
+
+    with_email_uniqueness_unchecked { assert_not acceptance.save }
+    assert_equal [ "has already been taken" ], acceptance.errors[:email]
+    assert invitation.reload.pending?
+  end
+
+  test "an expired invitation can't be accepted" do
+    invitation = accounts(:acme).invitations.new(email: "new@example.test", role: "agent")
+    assert invitation.send_invitation
+    travel Invitation::TTL + 1.second do
+      assert_raises(Invitation::Expired) do
+        InvitationAcceptance.new(invitation: invitation, name: "New", password: "password123").save
+      end
+    end
+  end
+end
+
+class CustomerRegistrationRaceTest < ActiveSupport::TestCase
+  include UniquenessRace
+
+  test "a lost race for the email is reported as taken" do
+    accounts(:acme).users.create!(name: "First", email: "new@example.test", password: "password123", role: "customer")
+    registration = CustomerRegistration.new(account: accounts(:acme), name: "New", email: "new@example.test", password: "password123")
+
+    with_email_uniqueness_unchecked { assert_not registration.save }
+    assert_equal [ "has already been taken" ], registration.errors[:email]
+    assert_equal [ "Email has already been taken" ], registration.errors.full_messages
+  end
+end
