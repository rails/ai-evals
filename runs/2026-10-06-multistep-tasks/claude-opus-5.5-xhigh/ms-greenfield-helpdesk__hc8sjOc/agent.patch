+ruby-4.0.7
diff --git a/Gemfile b/Gemfile
new file mode 100644
index 0000000..8827819
--- /dev/null
+++ b/Gemfile
@@ -0,0 +1,14 @@
+source "https://rubygems.org"
+
+gem "rails", "~> 8.1.4"
+# PostgreSQL adapter for Active Record
+gem "pg", "~> 1.1"
+# Application server
+gem "puma", ">= 5.0"
+# Password hashing for has_secure_password
+gem "bcrypt", "~> 3.1.7"
+# Cross-Origin Resource Sharing for the separate frontend app
+gem "rack-cors", "~> 3.0"
+
+# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
+gem "tzinfo-data", platforms: %i[ windows jruby ]
