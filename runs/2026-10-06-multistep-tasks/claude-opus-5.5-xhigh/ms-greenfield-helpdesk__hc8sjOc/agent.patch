diff --git a/app/mailboxes/support_mailbox.rb b/app/mailboxes/support_mailbox.rb
new file mode 100644
index 0000000..2fc9b76
--- /dev/null
+++ b/app/mailboxes/support_mailbox.rb
@@ -0,0 +1,18 @@
+# Mail to the support domain: customers emailing a business, and replying on
+# their tickets. See EmailIntake for what is taken in and what is ignored.
+class SupportMailbox < ApplicationMailbox
+  def process
+    result = EmailIntake.new(InboundSupportEmail.new(mail, message_id: inbound_email.message_id)).process
+
+    if result.ignored?
+      logger.info "[SupportMailbox] Ignored inbound email #{inbound_email.id} <#{inbound_email.message_id}>: #{result.reason}"
+      # Recorded as bounced, but no bounce is sent: ignored mail is mostly
+      # automated or unsolicited, and answering it would invite mail loops or
+      # backscatter to forged senders.
+      bounced!
+    else
+      logger.info "[SupportMailbox] Inbound email #{inbound_email.id} <#{inbound_email.message_id}>: #{result.outcome}" \
+        "#{" (ticket #{result.ticket.id})" if result.ticket}"
+    end
+  end
+end
diff --git a/app/mailers/application_mailer.rb b/app/mailers/application_mailer.rb
new file mode 100644
index 0000000..de38a3a
--- /dev/null
+++ b/app/mailers/application_mailer.rb
@@ -0,0 +1,13 @@
+class ApplicationMailer < ActionMailer::Base
+  default from: -> { Rails.configuration.x.mail_from }
+  layout "mailer"
+
+  # A mail server outage must not fail the request that triggered the email
+  # (the account or token has already been saved); users can request another
+  # link. Log and report the failure instead.
+  rescue_from Net::SMTPError, Net::ProtocolError, IOError, SocketError, SystemCallError,
+    Timeout::Error, OpenSSL::SSL::SSLError do |error|
+    Rails.error.report(error, handled: true, source: "application.action_mailer")
+    logger&.error("[#{self.class.name}##{action_name}] Email delivery failed: #{error.class}: #{error.message}")
+  end
+end
