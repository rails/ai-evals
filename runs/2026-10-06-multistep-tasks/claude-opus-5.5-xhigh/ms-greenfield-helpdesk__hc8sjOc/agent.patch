+# A ticket as its requester (a customer) sees it. Nothing internal shows: no
+# assignee or priority, and updated_at is the last activity the requester can
+# see (private notes and assignment and priority changes don't count).
+# merged_into_id is the request a closed request was merged into, where the
+# conversation continues (null unless it was merged): it is the requester's
+# own request too.
+class RequestSerializer
+  def initialize(ticket)
+    @ticket = ticket
+  end
+
+  def as_json(*)
+    {
+      id: @ticket.id,
+      subject: @ticket.subject,
+      status: @ticket.status,
+      requester_id: @ticket.requester_id,
+      merged_into_id: @ticket.merged_into_id,
+      created_at: @ticket.created_at,
+      updated_at: @ticket.public_updated_at
+    }
+  end
+end
