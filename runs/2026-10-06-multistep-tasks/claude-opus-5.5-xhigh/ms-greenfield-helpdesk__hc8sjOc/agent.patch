index 0000000..1c317b4
--- /dev/null
+++ b/config/puma.rb
@@ -0,0 +1,39 @@
+# This configuration file will be evaluated by Puma. The top-level methods that
+# are invoked here are part of Puma's configuration DSL. For more information
+# about methods provided by the DSL, see https://puma.io/puma/Puma/DSL.html.
+#
+# Puma starts a configurable number of processes (workers) and each process
+# serves each request in a thread from an internal thread pool.
+#
+# You can control the number of workers using ENV["WEB_CONCURRENCY"]. You
+# should only set this value when you want to run 2 or more workers. The
+# default is already 1. You can set it to `auto` to automatically start a worker
+# for each available processor.
+#
+# The ideal number of threads per worker depends both on how much time the
+# application spends waiting for IO operations and on how much you wish to
+# prioritize throughput over latency.
+#
+# As a rule of thumb, increasing the number of threads will increase how much
+# traffic a given process can handle (throughput), but due to CRuby's
+# Global VM Lock (GVL) it has diminishing returns and will degrade the
+# response time (latency) of the application.
+#
+# The default is set to 3 threads as it's deemed a decent compromise between
+# throughput and latency for the average Rails application.
+#
+# Any libraries that use a connection pool or another resource pool should
+# be configured to provide at least as many connections as the number of
+# threads. This includes Active Record's `pool` parameter in `database.yml`.
+threads_count = ENV.fetch("RAILS_MAX_THREADS", 3)
+threads threads_count, threads_count
+
+# Specifies the `port` that Puma will listen on to receive requests; default is 3000.
+port ENV.fetch("PORT", 3000)
+
+# Allow puma to be restarted by `bin/rails restart` command.
+plugin :tmp_restart
+
+# Specify the PID file. Defaults to tmp/pids/server.pid in development.
+# In other environments, only set the PID file if requested.
+pidfile ENV["PIDFILE"] if ENV["PIDFILE"]
diff --git a/config/routes.rb b/config/routes.rb
new file mode 100644
index 0000000..3276ffd
--- /dev/null
+++ b/config/routes.rb
@@ -0,0 +1,62 @@
+Rails.application.routes.draw do
+  # Health check for load balancers and uptime monitors.
+  get "up" => "rails/health#show", as: :rails_health_check
+
+  namespace :api, defaults: { format: :json } do
+    namespace :v1 do
+      # Business signup and lifecycle. Everything except signup is scoped to
+      # the business named by the X-Helpdesk-Account header.
+      post "account/create", to: "accounts#create", as: :account_signup
+      get "account", to: "accounts#show", as: :account
+      post "account/cancel", to: "accounts#cancel", as: :account_cancel
+      post "account/reactivate", to: "accounts#reactivate", as: :account_reactivate
+
+      get "portal", to: "portals#show", as: :portal
+      # Customers sign up through the portal of the business in the header.
+      post "registrations", to: "registrations#create", as: :registrations
+
+      post "sessions", to: "sessions#create", as: :sessions
+      delete "session", to: "sessions#destroy", as: :session
+
+      get "me", to: "profiles#show", as: :me
+      match "me", to: "profiles#update", via: %i[patch put]
+      match "me/password", to: "password_changes#update", via: %i[put patch], as: :me_password
+
+      post "email_verifications", to: "email_verifications#create", as: :email_verifications
+      post "email_verifications/confirm", to: "email_verifications#confirm", as: :confirm_email_verification
+      post "password_resets", to: "password_resets#create", as: :password_resets
+      post "password_resets/confirm", to: "password_resets#confirm", as: :confirm_password_reset
+
+      # Customers' own tickets ("requests").
+      resources :requests, only: %i[index show create update] do
+        get :comments, on: :member
+      end
+
+      # Every ticket of the business, for staff, who can also merge a
+      # duplicate into another ticket of the same customer.
+      resources :tickets, only: %i[index show update] do
+        get :comments, on: :member
+        post :merge, on: :member
+      end
+      # Active staff, as choices for assigning tickets.
+      get "staff", to: "staff#index", as: :staff
+
+      # Groups of staff (departments), and who belongs to them. Staff browse
+      # them; admins manage them.
+      resources :groups, only: %i[index show create update destroy]
+      resources :group_memberships, only: %i[index show create destroy] do
+        put :make_default, on: :member
+      end
+
+      # Admins manage people: invitations for new staff, and existing users.
+      resources :invitations, only: %i[index show create destroy] do
+        post :resend, on: :member
+      end
+      resources :users, only: %i[index show update]
+
+      # Public: an invitee previews and accepts an emailed invitation.
+      post "invitation_previews", to: "invitation_previews#create", as: :invitation_previews
+      post "invitation_acceptances", to: "invitation_acceptances#create", as: :invitation_acceptances
+    end
+  end
+end
