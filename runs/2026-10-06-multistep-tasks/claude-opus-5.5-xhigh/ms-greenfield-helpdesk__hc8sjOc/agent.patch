+require "test_helper"
+
+class ProfileTest < ActionDispatch::IntegrationTest
+  setup { @token = sign_in(users(:jo)) }
+
+  test "shows the signed-in user" do
+    api_get "/me", token: @token, account: "acme"
+    assert_response :ok
+    assert_equal({ "id" => users(:jo).id, "name" => "Jo", "role" => "admin", "verified" => true },
+      json["user"].slice("id", "name", "role", "verified"))
+  end
+
+  test "updates the name" do
+    api_patch "/me", { user: { name: "Jo Smith" } }, token: @token, account: "acme"
+    assert_response :ok
+    assert_equal "Jo Smith", json.dig("user", "name")
+    assert_equal "Jo Smith", users(:jo).reload.name
