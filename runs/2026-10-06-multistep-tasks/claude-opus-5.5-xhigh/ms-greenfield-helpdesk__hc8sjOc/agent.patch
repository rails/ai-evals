index 0000000..d80c6fa
--- /dev/null
+++ b/test/integration/sessions_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class SessionsTest < ActionDispatch::IntegrationTest
+  test "signs in and returns the session token, user and account" do
+    api_post "/sessions", { session: { email: "JO@acme.test", password: PASSWORD } }, account: "acme"
+    assert_response :created
+
+    token = json.dig("session", "token")
+    assert token.present?
+    assert_equal users(:jo).id, json.dig("user", "id")
+    assert_equal true, json.dig("user", "verified")
+    assert_equal "acme", json.dig("account", "subdomain")
+    assert_not_equal token, Session.last.token_digest, "only a digest of the token is stored"
+
+    api_get "/me", token: token, account: "acme"
+    assert_response :ok
+    assert_equal "jo@acme.test", json.dig("user", "email")
+  end
+
+  test "users sign in to the business named in the header" do
+    api_post "/sessions", { session: { email: "jo@acme.test", password: PASSWORD } }, account: "globex"
+    assert_response :created
+    assert_equal users(:globex_jo).id, json.dig("user", "id")
+    assert_equal "globex", json.dig("account", "subdomain")
+  end
+
+  test "wrong password or unknown email is unauthorized" do
+    api_post "/sessions", { session: { email: "jo@acme.test", password: "wrong-password" } }, account: "acme"
+    assert_response :unauthorized
+    assert_equal "invalid_credentials", json.dig("error", "code")
+
+    api_post "/sessions", { session: { email: "ghost@acme.test", password: PASSWORD } }, account: "acme"
+    assert_response :unauthorized
+  end
+
+  test "unverified users cannot sign in" do
+    api_post "/sessions", { session: { email: "una@acme.test", password: PASSWORD } }, account: "acme"
+    assert_response :forbidden
+    assert_equal "email_not_verified", json.dig("error", "code")
+  end
+
+  test "requires the account header" do
+    api_post "/sessions", { session: { email: "jo@acme.test", password: PASSWORD } }
+    assert_response :bad_request
+  end
+
+  test "repeated failures are throttled" do
+    original_cache, Rails.cache = Rails.cache, ActiveSupport::Cache::MemoryStore.new
+    LoginThrottle::MAX_FAILURES.times do
+      api_post "/sessions", { session: { email: "jo@acme.test", password: "guess" } }, account: "acme"
+      assert_response :unauthorized
+    end
+    api_post "/sessions", { session: { email: "jo@acme.test", password: PASSWORD } }, account: "acme"
+    assert_response :too_many_requests
+    assert response.headers["Retry-After"].present?
+  ensure
+    Rails.cache = original_cache
+  end
+
+  test "signing out revokes only that session" do
+    token = sign_in(users(:jo))
+    other_token = sign_in(users(:jo))
+
+    api_delete "/session", token: token, account: "acme"
+    assert_response :no_content
+
+    api_get "/me", token: token, account: "acme"
+    assert_response :unauthorized
+    api_get "/me", token: other_token, account: "acme"
+    assert_response :ok
+  end
+
+  test "tokens are bound to their business" do
+    token = sign_in(users(:jo))
+    api_get "/me", token: token, account: "globex"
+    assert_response :unauthorized
+  end
+
+  test "missing, invalid and expired tokens are unauthorized" do
+    api_get "/me", account: "acme"
+    assert_response :unauthorized
+    assert_match "Bearer", response.headers["WWW-Authenticate"]
+
+    api_get "/me", token: "not-a-token", account: "acme"
+    assert_response :unauthorized
+
+    token = sign_in(users(:jo))
+    travel Session::TTL + 1.minute do
+      api_get "/me", token: token, account: "acme"
+      assert_response :unauthorized
+    end
+  end
+end
diff --git a/test/integration/signup_test.rb b/test/integration/signup_test.rb
new file mode 100644
index 0000000..99af5c2
--- /dev/null
+++ b/test/integration/signup_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class SignupTest < ActionDispatch::IntegrationTest
+  test "registers a business with an unverified admin owner and emails a verification link" do
+    assert_difference -> { Account.count } => 1, -> { User.count } => 1 do
+      sign_up
+    end
+    assert_response :created
+
+    account = json.fetch("account")
+    assert_equal "Initech", account["name"]
+    assert_equal "initech", account["subdomain"]
+    assert_equal "active", account["status"]
+    assert account["id"].present?
+    assert account["created_at"].present?
+    assert account["updated_at"].present?
+
+    user = json.fetch("user")
+    assert_equal "Jo", user["name"]
+    assert_equal "jo@initech.test", user["email"]
+    assert_equal "admin", user["role"]
+    assert_equal false, user["verified"]
+    assert_equal true, user["owner"]
+    assert_equal account["id"], user["account_id"]
+    assert user["id"].present?
+    assert user["created_at"].present?
+    assert_not_includes response.body, "password"
+
+    mail = last_email
+    assert_equal [ "jo@initech.test" ], mail.to
+    assert_equal [ Rails.configuration.x.mail_from ], mail.from
+    assert_match "#{Rails.configuration.x.frontend_url}/verify-email?account=initech&token=", mail.text_part.body.decoded
+    assert_match "/verify-email?account=initech&amp;token=", mail.html_part.body.decoded
+  end
+
+  test "normalizes subdomain and email" do
+    sign_up subdomain: "  InitECH ", email: " Jo@Initech.TEST "
+    assert_response :created
+    assert_equal "initech", json.dig("account", "subdomain")
+    assert_equal "jo@initech.test", json.dig("user", "email")
+  end
+
+  test "rejects invalid input with per-field errors and creates nothing" do
+    assert_no_difference -> { Account.count } do
+      api_post "/account/create", { account: { name: "", subdomain: "-bad_sub-", admin: { name: "", email: "nope", password: "short" } } }
+    end
+    assert_response :unprocessable_content
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert_equal %w[admin.email admin.name admin.password name subdomain], json["errors"].keys.sort
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "subdomains are unique across businesses" do
+    sign_up subdomain: "ACME"
+    assert_response :unprocessable_content
+    assert_includes json.dig("errors", "subdomain"), "has already been taken"
+  end
+
+  test "reserved subdomains are rejected" do
+    sign_up subdomain: "www"
+    assert_response :unprocessable_content
+    assert_includes json.dig("errors", "subdomain"), "is reserved"
+  end
+
+  test "the same email can sign up a different business" do
+    sign_up email: users(:jo).email
+    assert_response :created
+    assert_equal 3, User.where(email: users(:jo).email).count
+  end
+
+  test "missing envelope is a bad request" do
+    api_post "/account/create", { name: "Initech" }
+    assert_response :bad_request
+    assert_equal "bad_request", json.dig("error", "code")
+  end
+
+  test "malformed JSON is a bad request" do
+    post "/api/v1/account/create", params: "{oops", headers: api_headers
+    assert_response :bad_request
+  end
+end
diff --git a/test/integration/ticket_filters_test.rb b/test/integration/ticket_filters_test.rb
new file mode 100644
index 0000000..91dc980
--- /dev/null
+++ b/test/integration/ticket_filters_test.rb
@@ -0,0 +1,219 @@
+require "test_helper"
+
+# Narrowing the staff inbox (GET /tickets) and the customer's own list
+# (GET /requests) with query parameters.
+class TicketFiltersTest < ActionDispatch::IntegrationTest
+  setup do
+    @avery = users(:avery)
+    @blake = users(:blake)
+    @ari = users(:ari)
+    @token = sign_in(users(:jo))
+  end
+
+  def ticket_ids(query)
+    api_get "/tickets?#{query}", token: @token, account: "acme"
+    assert_response :ok, query
+    json["tickets"].pluck("id")
+  end
+
+  test "the example from the inbox: open, unassigned, high priority, mentioning a receipt" do
+    match = travel_to(3.hours.ago) { open_request(@avery, subject: "Where is my RECEIPT?") }
+    match.update!(priority: "high")
+    # Each of these fails exactly one of the filters.
+    travel_to(2.hours.ago) { open_request(@avery, subject: "Receipt missing") }.update!(priority: "high", status: "pending")
+    travel_to(2.hours.ago) { open_request(@avery, subject: "Receipt again") }.update!(priority: "high", assignee: @ari)
+    travel_to(2.hours.ago) { open_request(@avery, subject: "Receipt, normal") }
+    travel_to(2.hours.ago) { open_request(@avery, subject: "Login trouble") }.update!(priority: "high")
+    open_request(users(:globex_avery), subject: "Receipt").update!(priority: "high")
+
+    api_get "/tickets?status=open&assignee_id=unassigned&priority=high&q=receipt", token: @token, account: "acme"
+    assert_response :ok
+    assert_equal [ match.id ], json["tickets"].pluck("id")
+    assert_equal({ "count" => 1, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil }, json.except("tickets"))
+    assert_equal [ "high", "open", nil ], json["tickets"].first.values_at("priority", "status", "assignee_id")
+  end
+
+  test "filters by status" do
+    open_ticket = open_request(@avery)
+    pending = open_request(@avery).tap { |t| t.update!(status: "pending") }
+    solved = open_request(@blake).tap { |t| t.update!(status: "solved") }
+
+    assert_equal [ open_ticket.id ], ticket_ids("status=open")
+    assert_equal [ pending.id ], ticket_ids("status=pending")
+    assert_equal [ solved.id ], ticket_ids("status=SOLVED")
+  end
+
+  test "filters by priority" do
+    normal = travel_to(1.hour.ago) { open_request(@avery) }
+    high = open_request(@avery).tap { |t| t.update!(priority: "high") }
+
+    assert_equal [ high.id ], ticket_ids("priority=high")
+    assert_equal [ normal.id ], ticket_ids("priority=normal")
+    assert_equal [ high.id, normal.id ], ticket_ids("priority=")
+  end
+
+  test "filters by assignee, or for tickets nobody is assigned" do
+    aris = travel_to(3.hours.ago) { open_request(@avery) }.tap { |t| t.update!(assignee: @ari) }
+    sams = travel_to(2.hours.ago) { open_request(@avery) }.tap { |t| t.update!(assignee: users(:sam)) }
+    nobodys = travel_to(1.hour.ago) { open_request(@blake) }
+
+    assert_equal [ aris.id ], ticket_ids("assignee_id=#{@ari.id}")
+    assert_equal [ sams.id ], ticket_ids("assignee_id=#{users(:sam).id}")
+    assert_equal [ nobodys.id ], ticket_ids("assignee_id=unassigned")
+    assert_equal [ nobodys.id ], ticket_ids("assignee_id=Unassigned")
+    assert_equal [ aris.id ], ticket_ids("assignee_id=%20#{@ari.id}%20")
+
+    # People without tickets here, including other businesses' staff: nothing.
+    assert_equal [], ticket_ids("assignee_id=#{users(:unverified).id}")
+    assert_equal [], ticket_ids("assignee_id=#{users(:globex_jo).id}")
+    assert_equal [], ticket_ids("assignee_id=999999999")
+    assert_equal [], ticket_ids("assignee_id=99999999999999999999999")
+  end
+
+  test "filters by requester" do
+    averys = travel_to(1.hour.ago) { open_request(@avery) }
+    blakes = open_request(@blake)
+    open_request(users(:globex_avery))
+
+    assert_equal [ averys.id ], ticket_ids("requester_id=#{@avery.id}")
+    assert_equal [ blakes.id ], ticket_ids("requester_id=#{@blake.id}")
+    assert_equal [], ticket_ids("requester_id=#{users(:globex_avery).id}")
+    assert_equal [ blakes.id ], ticket_ids("requester_id=#{@blake.id}&assignee_id=unassigned&status=open&priority=normal")
+  end
+
+  test "q searches subjects and public comments, ignoring case" do
+    by_subject = travel_to(4.hours.ago) { open_request(@avery, subject: "Download a RECEIPT", body: "Hi") }
+    by_first_comment = travel_to(3.hours.ago) { open_request(@avery, subject: "Billing", body: "Where's my receipt?") }
+    by_reply = travel_to(2.hours.ago) { open_request(@blake, subject: "Question", body: "Hello") }
+    TicketUpdate.new(ticket: by_reply, author: @ari, comment: { body: "I've emailed the Receipt." }).save!
+    travel_to(1.hour.ago) { open_request(@blake, subject: "Login", body: "Can't sign in") }
+    open_request(users(:globex_avery), subject: "Receipt")
+
+    assert_equal [ by_reply.id, by_first_comment.id, by_subject.id ], ticket_ids("q=receipt")
+    assert_equal [ by_reply.id, by_first_comment.id, by_subject.id ], ticket_ids("q=rEcEiPt")
+    assert_equal [ by_first_comment.id ], ticket_ids("q=where's+my")
+    assert_equal [ by_reply.id ], ticket_ids("q=receipt&requester_id=#{@blake.id}")
+  end
+
+  test "q finds non-ASCII text regardless of case" do
+    ticket = open_request(@avery, subject: "ÄRGER mit der Quittung")
+    assert_equal [ ticket.id ], ticket_ids("q=#{CGI.escape("ärger")}")
+  end
+
+  test "q doesn't search internal notes" do
+    ticket = open_request(@avery, subject: "Billing", body: "Charged twice")
+    TicketUpdate.new(ticket: ticket, author: @ari, comment: { body: "Secret refund code", public: false }).save!
+
+    assert_equal [], ticket_ids("q=secret")
+    assert_equal [ ticket.id ], ticket_ids("q=twice")
+  end
+
+  test "a ticket with several matching comments is listed and counted once" do
+    ticket = open_request(@avery, subject: "Receipt", body: "receipt receipt")
+    TicketUpdate.new(ticket: ticket, author: @ari, comment: { body: "Your receipt." }).save!
+    TicketUpdate.new(ticket: ticket, author: @avery, comment: { body: "Thanks for the receipt!" }).save!
+
+    assert_equal [ ticket.id ], ticket_ids("q=receipt")
+    assert_equal 1, json["count"]
+  end
+
+  test "q is literal text: wildcards, backslashes and quotes match only themselves" do
+    percent = open_request(@avery, subject: "Is the 100% discount real?")
+    underscore = open_request(@avery, subject: "Error code E_42")
+    backslash = open_request(@avery, subject: 'Path C:\Users\avery')
+    quote = open_request(@avery, subject: "O'Brien's order")
+    open_request(@avery, subject: "1000 discount, E142, C:Usersavery, OBriens")
+
+    assert_equal [ percent.id ], ticket_ids("q=#{CGI.escape("0%")}")
+    assert_equal [ percent.id ], ticket_ids("q=%25")
+    assert_equal [ underscore.id ], ticket_ids("q=_")
+    assert_equal [ underscore.id ], ticket_ids("q=#{CGI.escape("E_4")}")
+    assert_equal [ backslash.id ], ticket_ids("q=#{CGI.escape('C:\Users')}")
+    assert_equal [ quote.id ], ticket_ids("q=#{CGI.escape("O'Brien")}")
+    assert_equal [], ticket_ids("q=#{CGI.escape("discount real?')) OR 1=1 --")}")
+  end
+
+  test "q is trimmed, and a blank q is no filter" do
+    ticket = open_request(@avery, subject: "Receipt")
+    other = travel_to(1.hour.ago) { open_request(@avery, subject: "Login") }
+
+    assert_equal [ ticket.id ], ticket_ids("q=%20%20receipt%20")
+    assert_equal [ ticket.id, other.id ], ticket_ids("q=")
+    assert_equal [ ticket.id, other.id ], ticket_ids("q=%20%20")
+  end
+
+  test "blank filters are ignored" do
+    ticket = open_request(@avery)
+    assert_equal [ ticket.id ], ticket_ids("status=&priority=&assignee_id=&requester_id=&q=")
+  end
+
+  test "unknown or malformed filter values are bad requests" do
+    [ "status=archived", "status[]=open", "priority=urgent", "priority=1", "priority[]=high",
+      "assignee_id=abc", "assignee_id=0", "assignee_id=-1", "assignee_id=1.5", "assignee_id=null",
+      "assignee_id=me", "assignee_id[]=1", "requester_id=unassigned", "requester_id=abc", "requester_id=0",
+      "q[]=receipt", "q[a]=b", "q=a%00b" ].each do |query|
+      api_get "/tickets?#{query}", token: @token, account: "acme"
+      assert_response :bad_request, query
+      assert_equal "bad_request", json.dig("error", "code"), query
+      assert_match(/\A#{query[/\A[a-z_]+/]} /, json.dig("error", "message"), query)
+    end
+  end
+
+  test "filtered lists are paginated and counted after filtering" do
+    highs = 3.times.map { |i| travel_to((10 - i).hours.ago) { open_request(@avery, subject: "High #{i}") } }
+    highs.each { |t| t.update_columns(priority: "high") }
+    2.times { |i| travel_to((5 - i).hours.ago) { open_request(@avery, subject: "Normal #{i}") } }
+
+    api_get "/tickets?priority=high&per_page=2&page=2", token: @token, account: "acme"
+    assert_response :ok
+    assert_equal [ highs.first.id ], json["tickets"].pluck("id")
+    assert_equal({ "count" => 3, "page" => 2, "per_page" => 2, "next_page" => nil, "previous_page" => 1 }, json.except("tickets"))
+  end
+
+  # --- Customers ----------------------------------------------------------------
+
+  test "customers filter their own requests by status" do
+    open_one = travel_to(2.hours.ago) { open_request(@avery) }
+    solved = travel_to(1.hour.ago) { open_request(@avery) }
+    TicketUpdate.new(ticket: solved, author: @avery, status: "solved").save!
+    open_request(@blake)
+    customer_token = sign_in(@avery)
+
+    { "status=open" => [ open_one.id ], "status=solved" => [ solved.id ], "status=pending" => [],
+      "status=Solved" => [ solved.id ], "status=" => [ solved.id, open_one.id ] }.each do |query, expected|
+      api_get "/requests?#{query}", token: customer_token, account: "acme"
+      assert_response :ok, query
+      assert_equal expected, json["requests"].pluck("id"), query
+      assert_equal expected.size, json["count"], query
+    end
+
+    [ "status=archived", "status[]=open" ].each do |query|
+      api_get "/requests?#{query}", token: customer_token, account: "acme"
+      assert_response :bad_request, query
+      assert_equal "bad_request", json.dig("error", "code")
+    end
+  end
+
+  test "customers can't use the staff filters, so priority and others' requests stay hidden" do
+    normal = travel_to(2.hours.ago) { open_request(@avery, subject: "Normal") }
+    high = travel_to(1.hour.ago) { open_request(@avery, subject: "Urgent") }
+    high.update!(priority: "high", assignee: @ari)
+    TicketUpdate.new(ticket: normal, author: @ari, comment: { body: "secret note", public: false }).save!
+    open_request(@blake, subject: "Blake's receipt")
+    customer_token = sign_in(@avery)
+
+    [ "priority=high", "priority=bogus", "assignee_id=#{@ari.id}", "assignee_id=unassigned",
+      "requester_id=#{@blake.id}", "q=secret", "q=receipt" ].each do |query|
+      api_get "/requests?#{query}", token: customer_token, account: "acme"
+      assert_response :ok, query
+      assert_equal [ high.id, normal.id ], json["requests"].pluck("id"), query
+      assert_not_includes response.body, "priority", query
+    end
+  end
+
+  test "customers can't filter /tickets at all" do
+    api_get "/tickets?priority=high", token: sign_in(@avery), account: "acme"
+    assert_response :forbidden
+    assert_equal "staff_required", json.dig("error", "code")
+  end
+end
diff --git a/test/integration/ticket_groups_test.rb b/test/integration/ticket_groups_test.rb
new file mode 100644
index 0000000..4615e84
--- /dev/null
+++ b/test/integration/ticket_groups_test.rb
@@ -0,0 +1,272 @@
+require "test_helper"
+
+# Tickets in groups, and how groups and assignees go together.
+class TicketGroupsTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme = accounts(:acme)
+    @avery = users(:avery)
+    @ari = users(:ari)
+    @sam = users(:sam)
+    @billing = @acme.groups.create!(name: "Billing")
+    @support = @acme.groups.create!(name: "Technical Support")
+    GroupMembership.create!(group: @billing, user: @ari)
+    GroupMembership.create!(group: @support, user: @ari)
+    GroupMembership.create!(group: @support, user: @sam)
+    @ticket = open_request(@avery)
+    @token = sign_in(users(:jo))
+  end
+
+  def update_ticket(ticket: @ticket, token: @token, **attributes)
+    api_patch "/tickets/#{ticket.id}", { ticket: attributes }, token: token, account: "acme"
+  end
+
+  def group_and_assignee(ticket = @ticket)
+    ticket.reload.values_at(:group_id, :assignee_id)
+  end
+
+  test "staff move a ticket to a group and back out of it" do
+    update_ticket group_id: @billing.id
+    assert_response :ok
+    assert_equal [ @billing.id, { "id" => @billing.id, "name" => "Billing" } ], json["ticket"].values_at("group_id", "group")
+    assert_equal @billing, @ticket.reload.group
+
+    # Agents too, and IDs may be strings.
+    update_ticket(group_id: @support.id.to_s, token: sign_in(@ari))
+    assert_response :ok
+    assert_equal @support.id, json.dig("ticket", "group_id")
+
+    api_get "/tickets/#{@ticket.id}", token: @token, account: "acme"
+    assert_equal({ "id" => @support.id, "name" => "Technical Support" }, json.dig("ticket", "group"))
+    api_get "/tickets", token: @token, account: "acme"
+    assert_equal({ "id" => @support.id, "name" => "Technical Support" }, json["tickets"].first["group"])
+
+    update_ticket group_id: nil
+    assert_response :ok
+    assert_equal [ nil, nil ], json["ticket"].values_at("group_id", "group")
+    assert_equal [ nil, nil ], group_and_assignee
+    assert_equal 1, @ticket.comments.count
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "only groups of the business can be chosen" do
+    globex = accounts(:globex).groups.create!(name: "Globex")
+    [ globex.id, 999999999, 0, -1, "abc", "1.5", 1.5, "", true ].each do |id|
+      update_ticket group_id: id
+      assert_response :unprocessable_content, id.inspect
+      assert_equal [ "must be a group of this business" ], json.dig("errors", "group_id"), id.inspect
+    end
+
+    # An invalid group fails the whole update.
+    update_ticket group_id: globex.id, status: "solved", comment: { body: "Done" }
+    assert_response :unprocessable_content
+    assert_equal [ "open", nil, 1 ], [ @ticket.reload.status, @ticket.group_id, @ticket.comments.count ]
+  end
+
+  test "assigning someone to an ungrouped ticket uses their default group" do
+    update_ticket assignee_id: @ari.id
+    assert_response :ok
+    assert_equal [ @billing.id, "Billing", @ari.id ], [ json.dig("ticket", "group_id"), json.dig("ticket", "group", "name"),
+      json.dig("ticket", "assignee_id") ]
+    assert_equal [ @billing.id, @ari.id ], group_and_assignee
+
+    # Staff in no group can still be assigned ungrouped tickets.
+    other = open_request(@avery)
+    update_ticket(assignee_id: users(:jo).id, ticket: other)
+    assert_response :ok
+    assert_equal [ nil, users(:jo).id ], group_and_assignee(other)
+
+    # Choosing the group in the same update wins over the default.
+    third = open_request(@avery)
+    update_ticket(assignee_id: @ari.id, group_id: @support.id, ticket: third)
+    assert_response :ok
+    assert_equal [ @support.id, @ari.id ], group_and_assignee(third)
+  end
+
+  test "the assignee must belong to the ticket's group" do
+    @ticket.update!(group: @billing)
+    update_ticket assignee_id: @sam.id
+    assert_response :unprocessable_content
+    assert_equal [ "must be a member of the ticket's group" ], json.dig("errors", "assignee_id")
+    assert_equal [ @billing.id, nil ], group_and_assignee
+
+    update_ticket assignee_id: users(:jo).id, status: "pending"
+    assert_response :unprocessable_content
+    assert_equal "open", @ticket.reload.status
+
+    update_ticket group_id: @billing.id, assignee_id: @sam.id
+    assert_response :unprocessable_content
+    assert_equal [ "must be a member of the ticket's group" ], json.dig("errors", "assignee_id")
+
+    update_ticket assignee_id: @ari.id
+    assert_response :ok
+    assert_equal [ @billing.id, @ari.id ], group_and_assignee
+
+    # Moving the ticket and assigning a member of the new group at once.
+    update_ticket group_id: @support.id, assignee_id: @sam.id
+    assert_response :ok
+    assert_equal [ @support.id, @sam.id ], group_and_assignee
+
+    # Suspended staff still can't be assigned, whatever their groups.
+    @sam.suspend!
+    update_ticket assignee_id: @sam.id
+    assert_response :unprocessable_content
+    assert_equal [ "must be an active staff member of this business" ], json.dig("errors", "assignee_id")
+  end
+
+  test "moving a ticket to another group keeps an assignee who belongs there and clears one who doesn't" do
+    update_ticket assignee_id: @ari.id
+    update_ticket group_id: @support.id
+    assert_response :ok
+    assert_equal [ @support.id, @ari.id ], json["ticket"].values_at("group_id", "assignee_id")
+
+    update_ticket assignee_id: @sam.id
+    update_ticket group_id: @billing.id
+    assert_response :ok
+    assert_equal [ @billing.id, nil, nil ], json["ticket"].values_at("group_id", "assignee_id", "assignee")
+    assert_equal [ @billing.id, nil ], group_and_assignee
+
+    # Moving an ungrouped ticket's assignee along into a group they're in.
+    other = open_request(@avery)
+    update_ticket(assignee_id: users(:jo).id, ticket: other)
+    update_ticket(group_id: @support.id, ticket: other)
+    assert_equal [ @support.id, nil ], group_and_assignee(other)
+  end
+
+  test "clearing the assignee keeps the group; clearing the group also clears the assignee" do
+    update_ticket assignee_id: @ari.id
+    update_ticket assignee_id: nil
+    assert_response :ok
+    assert_equal [ @billing.id, nil ], group_and_assignee
+
+    update_ticket assignee_id: @ari.id
+    update_ticket group_id: nil
+    assert_response :ok
+    assert_equal [ nil, nil, nil, nil ], json["ticket"].values_at("group_id", "group", "assignee_id", "assignee")
+
+    # Unless the same update names an assignee.
+    update_ticket group_id: nil, assignee_id: @ari.id
+    assert_response :ok
+    assert_equal [ nil, @ari.id ], group_and_assignee
+  end
+
+  test "group changes are internal activity" do
+    ticket = travel_to(1.hour.ago) { open_request(@avery) }
+    older = travel_to(2.hours.ago) { open_request(users(:blake)) }
+    customer_token = sign_in(users(:blake))
+    api_get "/requests/#{older.id}", token: customer_token, account: "acme"
+    before = json["request"]
+
+    update_ticket(group_id: @billing.id, ticket: older)
+    api_get "/tickets", token: @token, account: "acme"
+    assert_equal [ older.id, @ticket.id, ticket.id ], json["tickets"].pluck("id")
+
+    api_get "/requests/#{older.id}", token: customer_token, account: "acme"
+    assert_equal before, json["request"]
+    assert_not_includes response.body, "group"
+
+    # Choosing the current group again isn't activity.
+    updated_at = older.reload.updated_at
+    travel 1.minute do
+      update_ticket(group_id: @billing.id, ticket: older)
+      assert_response :ok
+    end
+    assert_equal updated_at, older.reload.updated_at
+  end
+
+  test "customers can't change the group" do
+    customer_token = sign_in(@avery)
+    update_ticket(group_id: @billing.id, token: customer_token)
+    assert_response :forbidden
+    api_patch "/requests/#{@ticket.id}", { request: { group_id: @billing.id } }, token: customer_token, account: "acme"
+    assert_response :bad_request
+    api_patch "/requests/#{@ticket.id}", { request: { group_id: @billing.id, comment: { body: "Hi" } } },
+      token: customer_token, account: "acme"
+    assert_response :ok
+    assert_nil @ticket.reload.group_id
+
+    update = TicketUpdate.new(ticket: @ticket, author: @avery, group_id: @billing.id)
+    assert_not update.valid?
+    assert update.errors.include?(:group_id)
+  end
+
+  # --- Filtering ------------------------------------------------------------------
+
+  test "staff filter the inbox by group, or for ungrouped tickets" do
+    billing_ticket = travel_to(3.hours.ago) { open_request(@avery) }.tap { |t| t.update!(group: @billing) }
+    support_ticket = travel_to(2.hours.ago) { open_request(@avery) }.tap { |t| t.update!(group: @support, assignee: @sam) }
+    @ticket.update!(updated_at: 4.hours.ago)
+
+    ids = ->(query) do
+      api_get "/tickets?#{query}", token: sign_in(@ari), account: "acme"
+      assert_response :ok, query
+      json["tickets"].pluck("id")
+    end
+    assert_equal [ billing_ticket.id ], ids.("group_id=#{@billing.id}")
+    assert_equal [ support_ticket.id ], ids.("group_id=%20#{@support.id}%20")
+    assert_equal [ @ticket.id ], ids.("group_id=unassigned")
+    assert_equal [ @ticket.id ], ids.("group_id=Unassigned")
+    assert_equal [ support_ticket.id ], ids.("group_id=#{@support.id}&assignee_id=#{@sam.id}&status=open")
+    assert_equal [], ids.("group_id=#{@support.id}&assignee_id=unassigned")
+    assert_equal [ support_ticket.id, billing_ticket.id, @ticket.id ], ids.("group_id=")
+    assert_equal [], ids.("group_id=#{accounts(:globex).groups.create!(name: "Globex").id}")
+    assert_equal [], ids.("group_id=999999999")
+
+    [ "group_id=abc", "group_id=0", "group_id=-1", "group_id=none", "group_id=null", "group_id[]=1" ].each do |query|
+      api_get "/tickets?#{query}", token: @token, account: "acme"
+      assert_response :bad_request, query
+      assert_match(/\Agroup_id /, json.dig("error", "message"), query)
+    end
+
+    # Customers can't use it: it's ignored.
+    api_get "/requests?group_id=#{@billing.id}", token: sign_in(@avery), account: "acme"
+    assert_response :ok
+    assert_equal [ @ticket.id, billing_ticket.id, support_ticket.id ].sort, json["requests"].pluck("id").sort
+  end
+
+  # --- Deleting groups and memberships ------------------------------------------
+
+  test "removing a membership unassigns the member from the group's tickets only" do
+    in_billing = @ticket.tap { update_ticket assignee_id: @ari.id }
+    in_support = open_request(@avery).tap { |t| update_ticket(group_id: @support.id, assignee_id: @ari.id, ticket: t) }
+    sams = open_request(@avery).tap { |t| update_ticket(group_id: @billing.id, ticket: t) }
+    GroupMembership.create!(group: @billing, user: @sam)
+    update_ticket(assignee_id: @sam.id, ticket: sams)
+    updated_at = in_billing.reload.updated_at
+
+    api_delete "/group_memberships/#{@ari.group_memberships.find_by!(group: @billing).id}", token: @token, account: "acme"
+    assert_response :no_content
+    assert_equal [ @billing.id, nil ], group_and_assignee(in_billing)
+    assert_equal updated_at, in_billing.updated_at, "unassigning isn't ticket activity"
+    assert_equal [ @support.id, @ari.id ], group_and_assignee(in_support)
+    assert_equal [ @billing.id, @sam.id ], group_and_assignee(sams)
+  end
+
+  test "deleting a group ungroups and unassigns its tickets" do
+    in_billing = @ticket.tap { update_ticket assignee_id: @ari.id }
+    unassigned = open_request(@avery).tap { |t| update_ticket(group_id: @billing.id, ticket: t) }
+    in_support = open_request(@avery).tap { |t| update_ticket(group_id: @support.id, assignee_id: @ari.id, ticket: t) }
+    updated_at = in_billing.reload.updated_at
+
+    api_delete "/groups/#{@billing.id}", token: @token, account: "acme"
+    assert_response :no_content
+    assert_equal [ nil, nil ], group_and_assignee(in_billing)
+    assert_equal updated_at, in_billing.updated_at, "ungrouping isn't ticket activity"
+    assert_equal [ nil, nil ], group_and_assignee(unassigned)
+    assert_equal [ @support.id, @ari.id ], group_and_assignee(in_support)
+
+    api_get "/tickets/#{in_billing.id}", token: @token, account: "acme"
+    assert_equal [ nil, nil, nil, nil ], json["ticket"].values_at("group_id", "group", "assignee_id", "assignee")
+  end
+
+  test "suspension unassigns tickets but keeps their group, and the member's groups" do
+    update_ticket assignee_id: @ari.id
+    @ari.suspend!
+    assert_equal [ @billing.id, nil ], group_and_assignee
+    assert_equal 2, @ari.group_memberships.count
+
+    @ari.unsuspend!
+    update_ticket assignee_id: @ari.id
+    assert_response :ok
+    assert_equal [ @billing.id, @ari.id ], group_and_assignee
+  end
+end
diff --git a/test/integration/ticket_merges_test.rb b/test/integration/ticket_merges_test.rb
