+# Customers (people contacting a business through its portal) are users with
+# the "customer" role. They share sign-in, verification and recovery with
+# staff, and their emails are unique per business like everyone else's.
+class AddCustomerRoleToUsers < ActiveRecord::Migration[8.1]
+  def up
+    remove_check_constraint :users, name: "users_role_valid"
+    add_check_constraint :users, "role IN ('admin', 'agent', 'customer')", name: "users_role_valid"
+    # Only staff can own a business.
+    add_check_constraint :users, "NOT owner OR role <> 'customer'", name: "users_customer_not_owner"
+  end
+
+  def down
+    remove_check_constraint :users, name: "users_customer_not_owner"
+    remove_check_constraint :users, name: "users_role_valid"
+    add_check_constraint :users, "role IN ('admin', 'agent')", name: "users_role_valid"
