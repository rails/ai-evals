diff --git a/app/models/customer_registration.rb b/app/models/customer_registration.rb
new file mode 100644
index 0000000..f90f43a
--- /dev/null
+++ b/app/models/customer_registration.rb
@@ -0,0 +1,54 @@
+# A customer signing up through a business's portal. Like staff, customers
+# must verify their email address before they can sign in.
+#
+# An email that belongs to a user of the business, or that has a pending
+# staff invitation, is taken.
+class CustomerRegistration
+  include ActiveModel::Model
+
+  attr_reader :user
+
+  # For error messages about the email (e.g. "has already been taken").
+  delegate :email, to: :user
+
+  def initialize(account:, name: nil, email: nil, password: nil, password_confirmation: nil)
+    # The role is fixed here: nobody can register themselves as staff.
+    @user = account.users.new(
+      name: name, email: email, password: password, password_confirmation: password_confirmation,
+      role: User::CUSTOMER_ROLE, owner: false
+    )
+  end
+
+  def valid?
+    errors.clear
+    user.valid?
+    user.errors.each { |error| errors.import(error) unless error.attribute == :account }
+    errors.add(:email, :taken) if invited? && !errors.of_kind?(:email, :taken)
+    errors.empty?
+  end
+
+  def save
+    token = nil
+
+    # Under the email lock, so an invitation for this email can't be sent
+    # between the check and the insert.
+    saved = user.account.with_email_lock(user.email) do
+      next false unless valid?
+
+      token = user.generate_email_verification_token
+      user.save!
+    end
+
+    user.deliver_email_verification(token) if saved
+    saved
+  rescue ActiveRecord::RecordNotUnique
+    # Lost a race with a concurrent registration for the same email.
+    errors.add(:email, :taken)
+    false
+  end
+
+  private
+    def invited?
+      user.email.present? && user.account.invitations.pending.exists?(email: user.email)
+    end
+end
diff --git a/app/models/email_intake.rb b/app/models/email_intake.rb
new file mode 100644
index 0000000..b21f643
--- /dev/null
+++ b/app/models/email_intake.rb
@@ -0,0 +1,216 @@
+# Takes in an email sent to the support domain (see SupportMailbox):
+#
+# * To a business's address (acme@support.example.test): opens a ticket with
+#   the email's subject and plain-text message.
+# * To a ticket's private reply address: adds the message to the ticket as a
+#   reply from the requester, which reopens a pending or solved ticket.
+#
+# The business is the one whose addresses are among the recipients, in To,
+# Cc or Bcc, or as an envelope recipient. If the reply address of a ticket is
+# among them, it's a reply on that ticket, even if the business's address is
+# copied in.
+#
+# The sender is found among the business's customers by their address. If
+# they aren't one yet, they are created (unverified, with a random password)
+# and sent a link to verify their address, so they can use the portal later.
+# Emailing never verifies an address.
+#
+# An email is ignored, changing nothing, if:
+#
+# * a machine sent it (auto-replies, bounces, mailing lists, bulk mail),
+# * it has no sender, or comes from the support domain itself,
+# * it isn't addressed to exactly one business, or the business is cancelled,
+# * it's addressed to the reply addresses of more than one ticket,
+# * the sender is staff, suspended, or has a pending staff invitation,
+# * it's a reply from anyone but the ticket's requester,
+# * it's a reply to a closed ticket (one merged into another), or
+# * it has no subject (for a new ticket) or message, or either is too long.
+#
+# Emails are deduplicated by Message-ID: an email with the Message-ID of one
+# the business has already taken in is a duplicate, and also changes nothing.
+# Only emails that were taken in count, so a delivery that was ignored never
+# blocks a later, valid one with the same Message-ID.
+class EmailIntake
+  # outcome: :opened (a new ticket), :replied, :duplicate or :ignored.
+  # reason:  why it was ignored, e.g. :automated or :multiple_businesses.
+  Result = Data.define(:outcome, :reason, :ticket) do
+    def ignored?
+      outcome == :ignored
+    end
+  end
+
+  attr_reader :email
+
+  # email: an InboundSupportEmail.
+  def initialize(email)
+    @email = email
+  end
+
+  def process
+    if (reason = rejection_reason)
+      ignored(reason)
+    elsif addressed_tickets.any?
+      reply(addressed_tickets.sole)
+    else
+      open_ticket(businesses.sole)
+    end
+  end
+
+  private
+    def sender
+      email.sender_email
+    end
+
+    # Why the email is ignored before looking at its sender; nil if it isn't.
+    def rejection_reason
+      if email.automated?
+        :automated
+      elsif sender.nil? || sender.length > 254 || !sender.match?(URI::MailTo::EMAIL_REGEXP)
+        :no_sender
+      elsif SupportAddress.at_domain?(sender) || sender == own_sender_address
+        :own_address
+      elsif businesses.empty?
+        :no_business
+      elsif businesses.many?
+        :multiple_businesses
+      elsif businesses.sole.cancelled?
+        :account_cancelled
+      elsif addressed_tickets.many?
+        :multiple_tickets
+      end
+    end
+
+    # The businesses the email is addressed to, directly or through the reply
+    # address of one of their tickets.
+    def businesses
+      @businesses ||= begin
+        subdomains = email.support_recipients.reject(&:reply?).map(&:subdomain)
+        accounts = subdomains.any? ? Account.where(subdomain: subdomains).to_a : []
+        (accounts + addressed_tickets.map(&:account)).uniq(&:id)
+      end
+    end
+
+    # The tickets whose reply addresses the email was sent to.
+    def addressed_tickets
+      @addressed_tickets ||= begin
+        tokens = email.support_recipients.select(&:reply?).map(&:reply_token)
+        tokens.any? ? Ticket.where(reply_token: tokens).includes(:account).to_a : []
+      end
+    end
+
+    # Our own outgoing mail (e.g. a reply bounced back to us) is never taken in.
+    def own_sender_address
+      Mail::Address.new(Rails.configuration.x.mail_from).address&.downcase
+    rescue Mail::Field::ParseError
+      nil
+    end
+
+    # A new ticket from the sender, who may be a new customer.
+    def open_ticket(account)
+      token = nil
+
+      result = with_locks(account) do
+        user = account.users.find_by(email: sender)
+
+        if user&.staff?
+          next ignored(:staff_sender)
+        elsif user&.suspended?
+          next ignored(:suspended_sender)
+        elsif taken_in?(account)
+          next duplicate
+        elsif user.nil? && account.invitations.pending.exists?(email: sender)
+          next ignored(:invited_staff)
+        end
+
+        customer = user || new_customer(account)
+        submission = RequestSubmission.new(requester: customer, subject: email.subject,
+          comment: { body: email.body }, origin: "email", message_id: email.message_id)
+
+        # Validate first, so an ignored email doesn't create the customer.
+        next ignored(:invalid_sender) unless customer.persisted? || customer.valid?
+        next ignored(:invalid_message) unless submission.valid?
+
+        if customer.new_record?
+          token = customer.generate_email_verification_token
+          customer.save!
+        end
+        submission.save!
+        opened(submission.ticket)
+      end
+
+      if token
+        customer = result.ticket.requester
+        ActiveRecord.after_all_transactions_commit { customer.deliver_email_verification(token, contacted_by_email: true) }
+      end
+      result
+    end
+
+    # The requester's reply on +ticket+, which reopens it if it's pending or
+    # solved. Nobody else may reply by email, and a closed ticket takes no
+    # replies (checked by TicketUpdate under the ticket's lock).
+    def reply(ticket)
+      with_locks(ticket.account) do
+        requester = ticket.requester
+
+        if requester.email != sender
+          next ignored(:not_requester)
+        elsif requester.suspended?
+          next ignored(:suspended_sender)
+        elsif taken_in?(ticket.account)
+          next duplicate
+        end
+
+        update = TicketUpdate.new(ticket: ticket, author: requester, comment: { body: email.body },
+          message_id: email.message_id)
+        if update.save
+          replied(ticket)
+        else
+          ignored(update.ticket_closed? ? :ticket_closed : :invalid_message)
+        end
+      end
+    end
+
+    # A customer for the sender, named as in their From header (or after
+    # their address). They get a random password: to sign in, they verify
+    # their address and choose a password with a password reset.
+    def new_customer(account)
+      name = email.sender_name.presence || sender.split("@").first
+      account.users.new(
+        name: name.truncate(100, omission: ""), email: sender, password: SecureRandom.base58(32),
+        role: User::CUSTOMER_ROLE, owner: false
+      )
+    end
+
+    # Runs the block in a transaction holding the sender's email lock (which
+    # registrations and invitations take as well, so the customer can't be
+    # created twice) and a lock on the email's Message-ID, so deliveries of
+    # the same email are taken in one at a time.
+    def with_locks(account, &block)
+      account.with_email_lock(sender) do
+        account.lock_message_id(email.message_id) if email.message_id
+        block.call
+      end
+    end
+
+    # Whether the business already took this email in (a redelivery).
+    def taken_in?(account)
+      email.message_id.present? &&
+        Comment.joins(:ticket).where(message_id: email.message_id, tickets: { account_id: account.id }).exists?
+    end
+
+    def opened(ticket)
+      Result.new(outcome: :opened, reason: nil, ticket: ticket)
+    end
+
+    def replied(ticket)
+      Result.new(outcome: :replied, reason: nil, ticket: ticket)
+    end
+
+    def duplicate
+      Result.new(outcome: :duplicate, reason: nil, ticket: nil)
+    end
+
+    def ignored(reason)
+      Result.new(outcome: :ignored, reason: reason, ticket: nil)
+    end
+end
diff --git a/app/models/group.rb b/app/models/group.rb
new file mode 100644
index 0000000..cc7ece9
--- /dev/null
+++ b/app/models/group.rb
@@ -0,0 +1,48 @@
+# A group of a business's staff, such as a department (Billing, Technical
+# Support). Groups organize work: a ticket may belong to a group, and then
+# only members of that group may be assigned it. They don't hide anything:
+# every staff member still sees every ticket. Staff may belong to several
+# groups (see GroupMembership).
+#
+# Names are unique within a business, ignoring case.
+#
+# Deleting a group removes its memberships (members whose default group it
+# was get another of their groups as default) and ungroups its tickets,
+# which also unassigns them, just like clearing a ticket's group. Neither is
+# activity on the tickets, so their updated_at is left alone.
+class Group < ApplicationRecord
+  NAME_MAX_LENGTH = 100
+
+  belongs_to :account
+  # Removed along with the group (see #release_tickets_and_memberships).
+  has_many :group_memberships, inverse_of: :group
+  has_many :users, through: :group_memberships
+  has_many :tickets, inverse_of: :group
+
+  normalizes :name, with: ->(name) { name.squish }
+
+  validates :name, presence: true, length: { maximum: NAME_MAX_LENGTH },
+    uniqueness: { scope: :account_id, case_sensitive: false }
+
+  # Changes to a business's groups and memberships are made one at a time,
+  # so checks such as name uniqueness hold (see Account#lock_groups).
+  before_validation :lock_account_groups
+  before_destroy :lock_account_groups
+  before_destroy :release_tickets_and_memberships
+
+  private
+    def lock_account_groups
+      account.lock_groups if account && self.class.connection.transaction_open?
+    end
+
+    # Under the groups lock, so no ticket update can move a ticket into the
+    # group or assign one of its members meanwhile.
+    def release_tickets_and_memberships
+      tickets.update_all_in_id_order(group_id: nil, assignee_id: nil)
+
+      memberships = GroupMembership.where(group_id: id)
+      lost_default = memberships.defaults.pluck(:user_id)
+      memberships.delete_all
+      GroupMembership.assign_missing_defaults(lost_default)
+    end
+end
diff --git a/app/models/group_membership.rb b/app/models/group_membership.rb
new file mode 100644
index 0000000..059c3ce
--- /dev/null
+++ b/app/models/group_membership.rb
@@ -0,0 +1,118 @@
+# A staff member's membership of one of the business's groups. Staff may
+# belong to several groups.
+#
+# Every staff member with memberships has exactly one default membership.
+# Their default group is where an ungrouped ticket goes when they are
+# assigned it (see TicketUpdate):
+#
+# * a staff member's first membership becomes their default, even if it was
+#   created with default: false;
+# * a membership saved with default: true (see #make_default!) takes over
+#   from their previous default;
+# * when the default membership is removed, the oldest remaining one (if
+#   any) becomes the default. The default can't be turned off otherwise.
+#
+# Removing a membership unassigns the member from the group's tickets, since
+# assignees must belong to the ticket's group. That isn't activity on the
+# tickets, so their updated_at is left alone. Suspending a staff member keeps
+# their memberships for when the suspension is lifted.
+class GroupMembership < ApplicationRecord
+  GROUP_ERROR = "must be a group of this business".freeze
+  USER_ERROR = "must be a staff member of this business".freeze
+
+  # Presence is validated below, and reported under group_id and user_id
+  # like the request body.
+  belongs_to :group, optional: true
+  belongs_to :user, optional: true
+
+  attr_readonly :group_id, :user_id
+
+  validate :group_must_exist, on: :create
+  validate :user_must_be_staff_of_the_business, on: :create
+  validates :user_id, uniqueness: { scope: :group_id, message: "is already a member of this group" },
+    if: -> { group && user }
+  validate :default_cannot_be_turned_off, on: :update
+
+  # Changes to a business's groups and memberships are made one at a time
+  # (see Account#lock_groups), so the checks above and the choice of default
+  # can't race each other.
+  before_validation :lock_account_groups
+  before_destroy :lock_account_groups
+  before_create :become_default_if_none
+  before_save :take_over_default, if: -> { default? && will_save_change_to_default? }
+  after_destroy :unassign_tickets, :hand_over_default
+
+  scope :defaults, -> { where(default: true) }
+
+  # Gives each of the users who has memberships but no default one their
+  # oldest membership as default.
+  def self.assign_missing_defaults(user_ids)
+    user_ids.uniq.each do |user_id|
+      next if defaults.exists?(user_id: user_id)
+
+      where(id: where(user_id: user_id).order(:id).limit(1).select(:id))
+        .update_all(default: true, updated_at: Time.current)
+    end
+  end
+
+  # Makes this the member's default membership, in place of their previous
+  # one. Raises ActiveRecord::RecordNotFound if the membership has been
+  # removed meanwhile.
+  def make_default!
+    transaction do
+      lock_account_groups
+      reload
+      update!(default: true)
+    end
+  end
+
+  private
+    def account
+      group&.account
+    end
+
+    def lock_account_groups
+      account.lock_groups if account && self.class.connection.transaction_open?
+    end
+
+    # Checked against the database, as the group may have been deleted since
+    # it was loaded.
+    def group_must_exist
+      errors.add(:group_id, GROUP_ERROR) unless group && Group.exists?(id: group.id)
+    end
+
+    def user_must_be_staff_of_the_business
+      if user.nil? || !user.staff? || (group && user.account_id != group.account_id)
+        errors.add(:user_id, USER_ERROR)
+      end
+    end
+
+    def default_cannot_be_turned_off
+      if will_save_change_to_default?(from: true, to: false)
+        errors.add(:default, "can't be turned off; make another membership the default instead")
+      end
+    end
+
+    def become_default_if_none
+      self.default = true unless self.class.defaults.exists?(user_id: user_id)
+    end
+
+    # Before saving, so the unique index never sees two defaults.
+    def take_over_default
+      others = self.class.defaults.where(user_id: user_id)
+      others = others.where.not(id: id) if persisted?
+      others.update_all(default: false, updated_at: Time.current)
+    end
+
+    # Under the groups lock, so no ticket update can assign the member to one
+    # of the group's tickets meanwhile.
+    def unassign_tickets
+      Ticket.where(group_id: group_id, assignee_id: user_id).update_all_in_id_order(assignee_id: nil)
+    end
+
+    # Checked against the database (under the lock) rather than #default?, as
+    # this membership may have become the default since it was loaded.
+    def hand_over_default
+      self.class.assign_missing_defaults([ user_id ])
+    end
+end
diff --git a/app/models/inbound_support_email.rb b/app/models/inbound_support_email.rb
new file mode 100644
index 0000000..4374707
--- /dev/null
+++ b/app/models/inbound_support_email.rb
@@ -0,0 +1,193 @@
+# An email that arrived at the support domain, as the helpdesk sees it: who
+# sent it, which business and ticket addresses it was sent to, whether a
+# machine sent it, and its subject and plain-text message.
+class InboundSupportEmail
+  # Precedence values of bulk mail, mailing lists and auto-replies.
+  AUTOMATED_PRECEDENCES = %w[bulk list junk auto_reply].freeze
+  # Headers that auto-responders (e.g. vacation replies) add.
+  AUTORESPONDER_HEADERS = %w[
+    X-Autoreply X-Autorespond X-Autoresponder X-Auto-Reply X-Autoreply-From X-Mail-Autoreply X-FC-MachineGenerated
+  ].freeze
+  # Envelope recipients, as recorded by relays (so Bcc'd mail is found too).
+  ENVELOPE_RECIPIENT_HEADERS = %w[X-Original-To X-Forwarded-To Delivered-To].freeze
+  # Mail systems rather than people: bounces, no-reply senders.
+  AUTOMATED_SENDER = /\A(?:mailer-daemon|postmaster|no-?reply|do-?not-?reply)(?:[+._-].*)?\z/i
+  # HTML elements that start a new line when converting HTML to text.
+  HTML_BLOCKS = %w[address article blockquote dd div dl dt footer h1 h2 h3 h4 h5 h6 header hr li ol p pre section table tr ul].freeze
+  HTML_IGNORED = %w[head script style template title].freeze
+
+  attr_reader :mail, :message_id
+
+  # message_id: the Message-ID Action Mailbox recorded for the email, which
+  # it generates (from the content) if the email has none.
+  def initialize(mail, message_id: nil)
+    @mail = mail
+    @message_id = (message_id.presence || safely { mail.message_id }).to_s.strip.delete_prefix("<").delete_suffix(">").presence
+  end
+
+  # --- Sender ------------------------------------------------------------------
+
+  # The sender's address (from From), lowercased; nil if there is none.
+  def sender_email
+    return @sender_email if defined?(@sender_email)
+
+    @sender_email = safely { from&.address }.to_s.strip.downcase.presence
+  end
+
+  # The sender's name, if the From header gives one.
+  def sender_name
+    clean(safely { from&.display_name }.to_s).squish.presence
+  end
+
+  # --- Recipients --------------------------------------------------------------
+
+  # The addresses at the support domain that the email was sent to, in To,
+  # Cc or Bcc, or as an envelope recipient. See SupportAddress.
+  def support_recipients
+    @support_recipients ||= recipient_addresses.filter_map { |address| SupportAddress.parse(address) }.uniq
+  end
+
+  # --- Automated mail ------------------------------------------------------------
+
+  # Whether a machine rather than a person sent the email: auto-replies (e.g.
+  # out-of-office), bounces and other reports, mailing lists and bulk mail.
+  # Answering these, or opening tickets for them, invites mail loops.
+  def automated?
+    auto_submitted? || bulk_precedence? || mailing_list? || autoresponder? || delivery_report? ||
+      null_sender? || automated_sender?
+  end
+
+  # --- Content -----------------------------------------------------------------
+
+  def subject
+    clean(safely { mail.subject }.to_s)
+  end
+
+  # The plain-text message. If the email has no plain-text part, the text of
+  # its HTML part.
+  def body
+    @body ||= clean(plain_text || html_text || "")
+  end
+
+  private
+    def from
+      return @from if defined?(@from)
+
+      @from = safely { mail.from_address }
+    end
+
+    # Every recipient address given in To, Cc and Bcc, and in the envelope
+    # recipient headers.
+    def recipient_addresses
+      listed = %i[to cc bcc].flat_map { |field| Array(safely { mail.public_send(field) }) }
+      envelope = ENVELOPE_RECIPIENT_HEADERS.flat_map { |name| header_values(name) }.flat_map { |value| value.split(",") }
+
+      (listed + envelope).filter_map do |address|
+        safely { Mail::Address.new(address.to_s).address } || address.to_s.strip.delete_prefix("<").delete_suffix(">")
+      end
+    end
+
+    # RFC 3834: anything but "no" means the message was generated automatically.
+    def auto_submitted?
+      header_values("Auto-Submitted").any? { |value| value.split(";").first.to_s.strip.downcase != "no" }
+    end
+
+    def bulk_precedence?
+      (header_values("Precedence") + header_values("X-Precedence")).any? do |value|
+        AUTOMATED_PRECEDENCES.include?(value.strip.downcase)
+      end
+    end
+
+    # RFC 2369 and 2919 (List-Id, List-Unsubscribe, ...).
+    def mailing_list?
+      header_names.any? { |name| name.start_with?("list-") }
+    end
+
+    def autoresponder?
+      AUTORESPONDER_HEADERS.any? { |name| header_values(name).any?(&:present?) }
+    end
+
+    # Delivery status notifications, read receipts and feedback reports.
+    def delivery_report?
+      safely { mail.mime_type }.to_s.downcase == "multipart/report"
+    end
+
+    # Bounces are sent with an empty envelope sender ("Return-Path: <>",
+    # which Mail reads as an empty value).
+    def null_sender?
+      header_values("Return-Path").any? { |value| value.delete("<>").strip.empty? }
+    end
+
+    def automated_sender?
+      sender_email.to_s.split("@").first.to_s.match?(AUTOMATED_SENDER)
+    end
+
+    def header_names
+      safely { mail.header.fields.map { |field| field.name.to_s.downcase } } || []
+    end
+
+    def header_values(name)
+      safely { mail.header.fields.select { |field| field.name.to_s.casecmp?(name) }.map { |field| field.value.to_s } } || []
+    end
+
+    def plain_text
+      part = mail.multipart? ? mail.text_part : (mail if [ nil, "text/plain" ].include?(safely { mail.mime_type }))
+      decode(part) if part
+    end
+
+    def html_text
+      part = mail.multipart? ? mail.html_part : (mail if safely { mail.mime_type } == "text/html")
+      html = decode(part) if part
+      html_to_text(html) if html
+    end
+
+    # The part's text, in UTF-8.
+    def decode(part)
+      text = safely { part.decoded }
+      return if text.nil?
+
+      text = text.dup
+      if text.encoding == Encoding::BINARY || text.encoding == Encoding::UTF_8
+        text.force_encoding(Encoding::UTF_8)
+      else
+        text = text.encode(Encoding::UTF_8, invalid: :replace, undef: :replace)
+      end
+      text.scrub
+    end
+
+    def html_to_text(html)
+      lines = +""
+      append_text(Nokogiri::HTML5(html), lines)
+      lines.gsub(/[ \t]*\n[ \t]*/, "\n").gsub(/\n{3,}/, "\n\n")
+    end
+
+    def append_text(node, out)
+      node.children.each do |child|
+        if child.text?
+          out << child.text.gsub(/[[:space:]]+/, " ")
+        elsif child.element? && !HTML_IGNORED.include?(child.name)
+          next out << "\n" if child.name == "br"
+
+          block = HTML_BLOCKS.include?(child.name)
+          out << "\n" if block
+          append_text(child, out)
+          out << "\n" if block
+        end
+      end
+    end
+
+    # Text as the database can store it: valid UTF-8, without NUL characters,
+    # and with Unix line endings.
+    def clean(text)
+      text = text.dup.force_encoding(Encoding::UTF_8) unless text.encoding == Encoding::UTF_8
+      text.scrub.delete("\0").gsub(/\r\n?/, "\n")
+    end
+
+    # Mail parses headers leniently and lazily, so a malformed one may raise
+    # only when it is read. Such a header counts as missing.
+    def safely
+      yield
+    rescue StandardError
+      nil
+    end
+end
diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..fc6c2d4
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,147 @@
+# An admin's invitation for someone to join the business's staff as an admin
+# or an agent. The invitee gets an emailed link with a one-time token (only
+# its digest is stored) and accepts it with InvitationAcceptance.
+#
+#   pending   sent, not yet accepted, revoked or expired
+#   accepted  the invitee created their user
+#   revoked   an admin withdrew it
+#   expired   not accepted within TTL; an admin can resend it
+#
+# A business has at most one pending invitation per email, and never invites
+# an email that already belongs to one of its users. Customer registration
+# can't take the email of a pending invitation either.
+class Invitation < ApplicationRecord
+  class StateError < StandardError; end
+  class AlreadyAccepted < StateError; end
+  class AlreadyRevoked < StateError; end
+  class Expired < StateError; end
+
+  TTL = 7.days
+  ROLES = User::STAFF_ROLES
+  STATUSES = %w[pending accepted revoked expired].freeze
+
+  belongs_to :account
+  belongs_to :invited_by, class_name: "User", optional: true
+  belongs_to :accepted_user, class_name: "User", optional: true
+
+  # Plaintext token, only available on the instance that (re)issued it.
+  attr_reader :token
+
+  normalizes :email, with: ->(email) { email.strip.downcase }
+
+  validates :email, presence: true,
+    length: { maximum: 254 },
+    format: { with: URI::MailTo::EMAIL_REGEXP, allow_blank: true }
+  validates :role, inclusion: { in: ROLES, message: "must be admin or agent" }
+  # Only checked when (re)issuing, under the email lock.
+  validate :email_available, on: %i[create resend]
+
+  scope :accepted, -> { where.not(accepted_at: nil) }
+  scope :revoked, -> { where.not(revoked_at: nil) }
+  scope :unanswered, -> { where(accepted_at: nil, revoked_at: nil) }
+  scope :pending, ->(now = Time.current) { unanswered.where(arel_table[:expires_at].gt(now)) }
+  scope :expired, ->(now = Time.current) { unanswered.where(expires_at: ..now) }
+
+  def self.with_status(status)
+    raise ArgumentError, "unknown invitation status: #{status.inspect}" unless STATUSES.include?(status)
+
+    public_send(status)
+  end
+
+  # Any invitation with this token, whatever its status (callers check it).
+  # Scoped by the relation it is called on (e.g. account.invitations).
+  def self.find_by_token(token)
+    return if token.blank?
+
+    find_by(token_digest: OpaqueToken.digest(token))
+  end
+
+  def status(now = Time.current)
+    if accepted_at then "accepted"
+    elsif revoked_at then "revoked"
+    elsif expires_at && expires_at <= now then "expired"
+    else "pending"
+    end
+  end
+
+  STATUSES.each do |status|
+    define_method(:"#{status}?") { self.status == status }
+  end
+
+  # Saves a new invitation and emails the link. Returns false (with errors)
+  # if it is invalid, e.g. the email is taken or already invited.
+  def send_invitation
+    raise ArgumentError, "use resend for saved invitations" if persisted?
+
+    saved = account.with_email_lock(email) do
+      issue_token
+      save(context: :create)
+    end
+    deliver if saved
+    saved
+  end
+
+  # Emails a new link, invalidating the previous one, and restarts the expiry
+  # clock (so an expired invitation becomes pending again). Returns false
+  # (with errors) if the email has since been taken or invited again. Raises
+  # AlreadyAccepted or AlreadyRevoked for answered invitations.
+  def resend
+    saved = account.with_email_lock(email) do
+      lock!
+      ensure_unanswered!
+      issue_token
+      save(context: :resend)
+    end
+
+    if saved
+      deliver
+    else
+      restore_attributes # keep showing the link and expiry that are in effect
+      @token = nil
+    end
+    saved
+  end
+
+  # Withdraws a pending or expired invitation, so its link stops working.
+  # Revoking a revoked invitation changes nothing. Raises AlreadyAccepted.
+  def revoke!
+    with_lock do
+      raise AlreadyAccepted, "Invitation #{id} has been accepted" if accepted_at
+      update!(revoked_at: Time.current) unless revoked_at
+    end
+  end
+
+  # Marks the invitation accepted by +user+. Call it with the row locked.
+  def accept!(user)
+    ensure_unanswered!
+    update!(accepted_at: Time.current, accepted_user: user)
+  end
+
+  def ensure_unanswered!
+    raise AlreadyAccepted, "Invitation #{id} has been accepted" if accepted_at
+    raise AlreadyRevoked, "Invitation #{id} has been revoked" if revoked_at
+  end
+
+  private
+    def issue_token
+      @token = OpaqueToken.generate
+      now = Time.current
+      self.token_digest = OpaqueToken.digest(@token)
+      self.sent_at = now
+      self.expires_at = now + TTL
+    end
+
+    def deliver
+      InvitationMailer.with(invitation: self, token: token).invitation.deliver_now
+    end
+
+    def email_available
+      return if email.blank? || account.nil?
+
+      if account.users.exists?(email: email)
+        errors.add(:email, :taken)
+      elsif account.invitations.pending.where.not(id: id).exists?(email: email)
+        errors.add(:email, "already has a pending invitation")
+      end
+    end
+end
diff --git a/app/models/invitation_acceptance.rb b/app/models/invitation_acceptance.rb
new file mode 100644
index 0000000..9ae036f
--- /dev/null
+++ b/app/models/invitation_acceptance.rb
@@ -0,0 +1,58 @@
+# Someone accepting an invitation: creates their staff user (with the
+# invitation's email and role) and marks the invitation accepted. Following
+# the emailed link proves they own the address, so the user is verified and
+# can sign in straight away.
+class InvitationAcceptance
+  include ActiveModel::Model
+
+  attr_reader :invitation, :user
+
+  # For error messages about the email (e.g. "has already been taken").
+  delegate :email, to: :invitation
+
+  def initialize(invitation:, name: nil, password: nil, password_confirmation: nil)
+    @invitation = invitation
+    @attributes = { name: name, password: password, password_confirmation: password_confirmation }
+  end
+
+  # Returns false with validation errors (the invitation stays usable). Raises
+  # an Invitation::StateError unless the invitation is pending.
+  def save
+    saved = false
+
+    # Lock the invitation so it is accepted at most once.
+    invitation.with_lock do
+      invitation.ensure_unanswered!
+      raise Invitation::Expired, "Invitation #{invitation.id} has expired" if invitation.expired?
+
+      build_user
+      if valid?
+        user.save!
+        invitation.accept!(user)
+        saved = true
+      end
+    end
+
+    saved
+  rescue ActiveRecord::RecordNotUnique
+    # Someone took the email in the meantime.
+    errors.add(:email, :taken)
+    false
+  end
+
+  def valid?
+    errors.clear
+    user.valid?
+    user.errors.each { |error| errors.import(error) unless error.attribute == :account }
+    errors.empty?
+  end
+
+  private
+    def build_user
+      @user = invitation.account.users.new(
+        **@attributes,
+        email: invitation.email, role: invitation.role, owner: false,
+        email_verified_at: Time.current
+      )
+    end
+end
diff --git a/app/models/login_throttle.rb b/app/models/login_throttle.rb
new file mode 100644
index 0000000..8dec43f
--- /dev/null
+++ b/app/models/login_throttle.rb
@@ -0,0 +1,31 @@
+# Slows down password guessing: after too many failed sign-ins for the same
+# email, business and IP address, further attempts are refused for a while.
+class LoginThrottle
+  MAX_FAILURES = 10
+  PERIOD = 15.minutes
+
+  def initialize(account:, email:, ip:)
+    @key = "login-failures:#{account.id}:#{ip}:#{OpaqueToken.digest(email.to_s.strip.downcase)}"
+  end
+
+  def blocked?
+    cache.read(@key, raw: true).to_i >= MAX_FAILURES
+  end
+
+  def record_failure
+    cache.increment(@key, 1, expires_in: PERIOD)
+  end
+
+  def reset
+    cache.delete(@key)
+  end
+
+  def retry_after
+    PERIOD
+  end
+
+  private
+    def cache
+      Rails.cache
+    end
+end
diff --git a/app/models/password_change.rb b/app/models/password_change.rb
new file mode 100644
index 0000000..841ce34
--- /dev/null
+++ b/app/models/password_change.rb
@@ -0,0 +1,22 @@
+# A signed-in user changing their password. Requires the current password and
+# signs out all existing sessions on success.
+class PasswordChange
+  include ActiveModel::Model
+
+  attr_accessor :user, :current_password, :password, :password_confirmation
+
+  def save
+    errors.clear
+
+    unless user.authenticate(current_password.to_s)
+      errors.add(:current_password, "is incorrect")
+      return false
+    end
+
+    return true if user.update_password(password, password_confirmation)
+
+    user.errors.each { |error| errors.import(error) }
+    user.restore_attributes
+    false
+  end
+end
diff --git a/app/models/request_submission.rb b/app/models/request_submission.rb
new file mode 100644
index 0000000..ced9cd9
--- /dev/null
+++ b/app/models/request_submission.rb
@@ -0,0 +1,41 @@
+# A customer opening a request: creates an open ticket together with its first
+# (public) comment. Errors on the comment are reported as "comment.<attribute>",
+# mirroring the request body.
+#
+# Requests come from the portal, or by email (see EmailIntake), in which case
+# the first comment records the email's Message-ID.
+class RequestSubmission
+  include ActiveModel::Model
+
+  attr_reader :ticket, :comment
+
+  def initialize(requester:, subject: nil, comment: nil, origin: "portal", message_id: nil)
+    comment = comment.respond_to?(:to_h) ? comment.to_h.with_indifferent_access : {}
+    @ticket = requester.account.tickets.new(requester: requester, subject: subject, status: "open", origin: origin)
+    @comment = @ticket.comments.new(author: requester, body: comment[:body], public: true, message_id: message_id)
+  end
+
+  def valid?
+    errors.clear
+    ticket.valid?
+    comment.valid?
+    ticket.errors.each { |error| errors.import(error) unless error.attribute == :comments }
+    comment.errors.each { |error| errors.import(error, attribute: :"comment.#{error.attribute}") unless error.attribute == :ticket }
+    errors.empty?
+  end
+
+  def save!
+    save || raise(ActiveModel::ValidationError, self)
+  end
+
+  def save
+    return false unless valid?
+
+    # One timestamp for the ticket and its first comment.
+    now = Time.current
+    ticket.created_at = ticket.updated_at = ticket.public_updated_at = now
+    comment.created_at = comment.updated_at = now
+    Ticket.no_touching { ticket.save! }
+    true
+  end
+end
diff --git a/app/models/session.rb b/app/models/session.rb
new file mode 100644
index 0000000..df4b35f
--- /dev/null
+++ b/app/models/session.rb
@@ -0,0 +1,27 @@
+# A signed-in client. Clients authenticate with the opaque bearer token that is
+# returned once, when the session is created.
+class Session < ApplicationRecord
+  TTL = 30.days
+
+  belongs_to :user
+
+  # Plaintext token, only available on the instance that created it.
+  attr_reader :token
+
+  before_validation :generate_token, on: :create
+
+  scope :unexpired, -> { where(expires_at: Time.current..) }
+
+  def self.find_by_token(token)
+    return if token.blank?
+
+    unexpired.includes(user: :account).find_by(token_digest: OpaqueToken.digest(token))
+  end
+
+  private
+    def generate_token
+      @token = OpaqueToken.generate
+      self.token_digest = OpaqueToken.digest(@token)
+      self.expires_at ||= TTL.from_now
+    end
+end
diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..6a99e9b
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,179 @@
+# A conversation between a customer (the requester) and a business's staff.
+# Customers see their own tickets as "requests" (/requests); staff see every
+# ticket of their business (/tickets).
+#
+#   open     waiting for staff
+#   pending  staff are waiting for the customer
+#   solved   staff (or the customer) consider it done
+#   closed   merged into another ticket of the same customer (see
+#            TicketMerge), which is where the conversation continues
+#
+# How replies move tickets between the first three is up to TicketUpdate.
+# Only merging closes a ticket, and a closed ticket stays as it was: it can
+# still be read, but takes no more replies or changes (assignment cleanup
+# still applies; see update_all_in_id_order). merged_into_id points at the
+# ticket it was merged into, and is never changed afterwards, even if that
+# ticket is merged too.
+#
+# A ticket may belong to one of the business's groups (e.g. Billing) and be
+# assigned to one active staff member of the business, who must be a member
+# of the ticket's group if it has one. Staff may mark it normal (the default)
+# or high priority. All of these are internal: the requester never sees them.
+# How assignment and groups interact is up to TicketUpdate.
+#
+# A ticket is opened in the portal or by email (its origin). Every ticket has
+# a private reply address (see SupportAddress); staff's public replies to
+# email tickets are emailed to the requester from it, so the customer's
+# answers return to the ticket.
+#
+# Two activity times are kept, because internal work must not show on the
+# customer's side:
+#
+#   updated_at         last activity of any kind (comments including private
+#                      notes; status, assignment and priority changes); for
+#                      staff
+#   public_updated_at  last activity the requester can see (public comments
+#                      and status changes); the request's updated_at
+class Ticket < ApplicationRecord
+  # The statuses replies and status changes move a ticket between.
+  OPEN_STATUSES = %w[open pending solved].freeze
+  CLOSED = "closed".freeze
+  STATUSES = (OPEN_STATUSES + [ CLOSED ]).freeze
+  PRIORITIES = %w[normal high].freeze
+  ORIGINS = %w[portal email].freeze
+  SUBJECT_MAX_LENGTH = 255
+
+  belongs_to :account
+  belongs_to :requester, class_name: "User", inverse_of: :requested_tickets
+  belongs_to :assignee, class_name: "User", optional: true, inverse_of: :assigned_tickets
+  # Ungrouped (ON DELETE SET NULL) if the group is deleted.
+  belongs_to :group, optional: true, inverse_of: :tickets
+  # Removed by an ON DELETE CASCADE foreign key.
+  has_many :comments, -> { chronological }, inverse_of: :ticket
+  # The ticket this one was merged into (closing it), and the tickets merged
+  # into this one.
+  belongs_to :merged_into, class_name: "Ticket", optional: true, inverse_of: :merged_tickets
+  has_many :merged_tickets, class_name: "Ticket", foreign_key: :merged_into_id, inverse_of: :merged_into
+
+  attribute :status, default: "open"
+  attribute :priority, default: "normal"
+  attribute :origin, default: "portal"
+
+  normalizes :subject, with: ->(subject) { subject.squish }
+
+  validates :subject, presence: true, length: { maximum: SUBJECT_MAX_LENGTH }
+  validates :status, inclusion: { in: STATUSES }
+  validates :priority, inclusion: { in: PRIORITIES }
+  validates :origin, inclusion: { in: ORIGINS }
+  validate :requester_belongs_to_account
+  validate :assignee_is_active_staff_of_account, if: :assignee_id_changed?
+  validate :group_belongs_to_account, if: :group_id_changed?
+  validate :assignee_belongs_to_group, if: -> { assignee_id_changed? || group_id_changed? }
+  validate :closed_exactly_when_merged
+  validate :merge_is_final, on: :update
+  validate :merged_into_a_ticket_of_the_same_customer, if: -> { merged_into_id_changed? && merged_into_id }
+
+  # Runs after the created_at/updated_at timestamps have been filled in.
+  before_create { self.public_updated_at ||= updated_at }
+  # The database would generate one as well, but then the record wouldn't
+  # know it without a reload.
+  before_create { self.reply_token ||= SupportAddress.generate_reply_token }
+
+  # Staff list: most recent activity of any kind first.
+  scope :recently_active_first, -> { order(updated_at: :desc, id: :desc) }
+  # Customer list: most recent activity the requester can see first.
+  scope :recent_public_activity_first, -> { order(public_updated_at: :desc, id: :desc) }
+
+  # Tickets whose subject or a public comment contains +text+, ignoring case.
+  # The text is literal: % and _ are not wildcards. Internal notes aren't
+  # searched. Each ticket appears once, however many of its comments match.
+  scope :matching, ->(text) {
+    pattern = "%#{sanitize_sql_like(text)}%"
+    comments = Comment.arel_table
+    public_comment_matches = Comment.publicly_visible
+      .where(comments[:ticket_id].eq(arel_table[:id]))
+      .where(comments[:body].matches(pattern, "\\"))
+      .arel.exists
+
+    where(arel_table[:subject].matches(pattern, "\\").or(public_comment_matches))
+  }
+
+  STATUSES.each do |status|
+    define_method(:"#{status}?") { self.status == status }
+  end
+
+  # Bulk changes that aren't activity on the tickets (unassigning a suspended
+  # user's tickets, cleaning up after deleting a group or a membership). The
+  # tickets are locked in ID order first, so bulk changes of overlapping
+  # tickets wait for each other instead of deadlocking.
+  def self.update_all_in_id_order(updates)
+    order(:id).lock.pluck(:id)
+    update_all(updates)
+  end
+
+  # Comments the requester is allowed to see.
+  def public_comments
+    comments.publicly_visible
+  end
+
+  def email_origin?
+    origin == "email"
+  end
+
+  # The private address through which the requester replies by email, e.g.
+  # reply+<token>@support.example.test.
+  def reply_address
+    SupportAddress.for_ticket(self)
+  end
+
+  private
+    def requester_belongs_to_account
+      errors.add(:requester, "must belong to the same business") if requester && requester.account_id != account_id
+    end
+
+    def assignee_is_active_staff_of_account
+      return if assignee_id.nil?
+
+      if assignee.nil? || assignee.account_id != account_id || !assignee.staff? || assignee.suspended?
+        errors.add(:assignee_id, "must be an active staff member of this business")
+      end
+    end
+
+    def group_belongs_to_account
+      return if group_id.nil?
+
+      errors.add(:group_id, "must be a group of this business") if group.nil? || group.account_id != account_id
+    end
+
+    def assignee_belongs_to_group
+      return if assignee_id.nil? || group_id.nil?
+
+      unless GroupMembership.exists?(group_id: group_id, user_id: assignee_id)
+        errors.add(:assignee_id, "must be a member of the ticket's group")
+      end
+    end
+
+    # Only merging closes a ticket.
+    def closed_exactly_when_merged
+      if closed? && merged_into_id.nil?
+        errors.add(:status, "can only be closed by merging the ticket into another")
+      elsif !closed? && merged_into_id
+        errors.add(:status, "must be closed for a merged ticket")
+      end
+    end
+
+    # A merged ticket stays closed, and keeps pointing at the ticket it was
+    # merged into.
+    def merge_is_final
+      errors.add(:status, "can't be changed once the ticket is closed") if status_changed? && status_was == CLOSED
+      errors.add(:merged_into_id, "can't be changed once set") if merged_into_id_changed? && merged_into_id_was
+    end
+
+    def merged_into_a_ticket_of_the_same_customer
+      if merged_into_id == id
+        errors.add(:merged_into_id, "can't be the ticket itself")
+      elsif merged_into.nil? || merged_into.account_id != account_id || merged_into.requester_id != requester_id
+        errors.add(:merged_into_id, "must be a ticket of the same customer")
+      end
+    end
+end
diff --git a/app/models/ticket_merge.rb b/app/models/ticket_merge.rb
new file mode 100644
index 0000000..88a1c87
--- /dev/null
+++ b/app/models/ticket_merge.rb
@@ -0,0 +1,158 @@
+# Merges a duplicate ticket (the source) into another ticket of the same
+# customer (the target), where the conversation continues:
+#
+# * The source is closed and points at the target (merged_into_id). It stays
+#   readable by staff and by the requester, but takes no more replies or
+#   changes (see TicketUpdate), including replies by email (see
+#   EmailIntake). Its comments stay where they are.
+# * The target's status, group, assignee, priority, origin and reply address
+#   are left alone, so its email conversation carries on as before.
+# * Each side gets a note by the staff member merging, explaining the merge.
+#   Notes are private unless staff make them public, and get a default text
+#   unless staff supply their own. They are never emailed.
+#
+# Both tickets must be open (not closed) tickets of the same requester. If
+# the target is merged into a third ticket later, the source keeps pointing
+# at the target: history isn't rewritten.
+#
+# Closing the source is a status change: activity on it that staff and the
+# requester both see. The note on the target is activity on the target,
+# which the requester sees only if the note is public.
+class TicketMerge
+  include ActiveModel::Model
+
+  PUBLIC_FLAGS = TicketUpdate::PUBLIC_FLAGS
+  TARGET_ERROR = "must be a ticket of this business".freeze
+  SAME_CUSTOMER_ERROR = "must be a ticket of the same customer".freeze
+  SAME_TICKET_ERROR = "can't be the ticket being merged".freeze
+
+  attr_reader :source, :target, :target_id, :author, :source_comment, :target_comment
+
+  # source:         the ticket to close.
+  # target_id:      the ID of the ticket to merge it into.
+  # source_comment, target_comment:
+  #                 nil for a default private note, else a hash with "body"
+  #                 (blank for the default text) and/or "public" (true or
+  #                 false, default false).
+  def initialize(source:, author:, target_id: nil, source_comment: nil, target_comment: nil)
+    @source = source
+    @author = author
+    @target_id = target_id
+    @note_attributes = { source_comment: note_attributes(source_comment), target_comment: note_attributes(target_comment) }
+  end
+
+  def save!
+    save || raise(ActiveModel::ValidationError, self)
+  end
+
+  def save
+    saved = false
+
+    Ticket.transaction do
+      # Lock both tickets in ID order (as bulk changes do, see
+      # Ticket.update_all_in_id_order), so merges and updates of the same
+      # tickets are made one at a time without deadlocking, then check them
+      # as they are now.
+      ids = [ source.id, RecordId.parse(@target_id) ].compact.uniq.sort
+      Ticket.where(account_id: source.account_id, id: ids).order(:id).lock.pluck(:id)
+      source.reload
+
+      if valid?
+        persist!
+        saved = true
+      end
+    end
+
+    saved
+  end
+
+  def valid?
+    errors.clear
+    @target = @source_comment = @target_comment = nil
+
+    if !author.staff?
+      errors.add(:base, "Only staff can merge tickets.")
+    elsif source.closed?
+      errors.add(:base, :ticket_closed, message: "This ticket is closed: it was merged into ticket ##{source.merged_into_id}.")
+    else
+      validate_target
+      @note_attributes.each { |key, attributes| validate_public_flag(key, attributes) }
+      build_notes if errors.empty?
+    end
+
+    errors.empty?
+  end
+
+  # Whether the merge failed because the source is already closed.
+  def ticket_closed?
+    errors.of_kind?(:base, :ticket_closed)
+  end
+
+  private
+    def note_attributes(comment)
+      # NB: nil responds to to_h, so check for it explicitly.
+      !comment.nil? && comment.respond_to?(:to_h) ? comment.to_h.with_indifferent_access : {}
+    end
+
+    def validate_target
+      return errors.add(:target_id, :blank) if @target_id.blank?
+
+      id = RecordId.parse(@target_id)
+      @target = id && source.account.tickets.find_by(id: id)
+
+      if @target.nil?
+        errors.add(:target_id, TARGET_ERROR)
+      elsif @target.id == source.id
+        errors.add(:target_id, SAME_TICKET_ERROR)
+      elsif @target.requester_id != source.requester_id
+        errors.add(:target_id, SAME_CUSTOMER_ERROR)
+      elsif @target.closed?
+        errors.add(:target_id, "is closed: it was merged into ticket ##{@target.merged_into_id}")
+      end
+      @target = nil if errors.include?(:target_id)
+    end
+
+    # Like replies' flags, "public" must be exactly true or false, so a note
+    # is never published by mistake.
+    def validate_public_flag(key, attributes)
+      raw = attributes[:public]
+      errors.add(:"#{key}.public", "must be true or false") unless raw.nil? || PUBLIC_FLAGS.key?(raw)
+    end
+
+    def build_notes
+      @source_comment = build_note(source, :source_comment,
+        "This ticket was merged into ticket ##{target.id} (#{target.subject}).")
+      @target_comment = build_note(target, :target_comment,
+        "Ticket ##{source.id} (#{source.subject}) was merged into this ticket.")
+
+      { source_comment: @source_comment, target_comment: @target_comment }.each do |key, note|
+        note.valid?
+        note.errors.each { |error| errors.import(error, attribute: :"#{key}.#{error.attribute}") unless error.attribute == :ticket }
+      end
+    end
+
+    def build_note(ticket, key, default_body)
+      attributes = @note_attributes.fetch(key)
+      body = attributes[:body].blank? ? default_body : attributes[:body]
+      ticket.comments.new(author: author, body: body, public: PUBLIC_FLAGS.fetch(attributes[:public], false))
+    end
+
+    def persist!
+      now = Time.current
+      source.status = Ticket::CLOSED
+      source.merged_into = target
+
+      source.updated_at = source.public_updated_at = now
+      target.updated_at = now
+      target.public_updated_at = now if target_comment.public?
+      [ source_comment, target_comment ].each { |note| note.assign_attributes(created_at: now, updated_at: now) }
+
+      # The notes get no Message-ID: they aren't emailed.
+      Ticket.no_touching do
+        source_comment.save!
+        target_comment.save!
+        source.save!
+        target.save!
+      end
+    end
+end
diff --git a/app/models/ticket_update.rb b/app/models/ticket_update.rb
new file mode 100644
index 0000000..917d240
--- /dev/null
+++ b/app/models/ticket_update.rb
@@ -0,0 +1,320 @@
+# A reply to a ticket, a change of its status and/or (for staff) a change of
+# its group, assignee or priority, by staff or by the requester.
+#
+# Staff may set any status, with or without a comment, and may make their
+# comment private (an internal note). A staff comment alone never changes
+# the status. Staff may also move the ticket to one of the business's groups
+# or ungroup it, assign it to an active staff member of the business or
+# unassign it, and mark it normal or high priority.
+#
+# Groups and assignees go together (see #resolve_assignment):
+#
+# * The assignee must be a member of the ticket's group, if it has one.
+# * Assigning someone to an ungrouped ticket (without choosing a group in the
+#   same update) moves it to their default group, if they have one.
+# * Moving the ticket to another group unassigns an assignee who isn't a
+#   member there.
+# * Unassigning keeps the group; ungrouping (group_id: null) also unassigns,
+#   unless the same update names an assignee.
+#
+# Customers may only mark their request solved. A customer comment reopens a
+# pending or solved request, unless the same update marks it solved.
+#
+# Internal activity (private notes; group, assignment and priority changes)
+# only bumps the ticket's updated_at, which staff see. Public comments and
+# status changes also bump public_updated_at, which is what the requester
+# sees.
+#
+# Staff's public comments on tickets opened by email are emailed to the
+# requester (unless they are suspended), once the update is committed. The
+# requester's own replies may arrive by email too (see EmailIntake).
+#
+# A closed ticket (one merged into another, see TicketMerge) takes no
+# updates at all: the error is on :base, of kind :ticket_closed (see
+# #ticket_closed?). Nobody can close a ticket with an update.
+class TicketUpdate
+  include ActiveModel::Model
+
+  CUSTOMER_STATUSES = %w[solved].freeze
+  # Accepted values for a comment's "public" flag. Anything else is rejected
+  # rather than guessed at, so an internal note is never published by mistake.
+  PUBLIC_FLAGS = { true => true, false => false, "true" => true, "false" => false }.freeze
+  ASSIGNEE_ERROR = "must be an active staff member of this business".freeze
+  GROUP_ERROR = "must be a group of this business".freeze
+  GROUP_MEMBER_ERROR = "must be a member of the ticket's group".freeze
+
+  # Default for group_id, assignee_id and priority: leave them alone. (nil
+  # ungroups or unassigns; it is not a priority.)
+  UNCHANGED = Object.new.freeze
+
+  attr_reader :ticket, :author, :comment, :status
+
+  # status:      nil to leave the status alone.
+  # comment:     nil for no comment, else a hash with "body" (and, for staff,
+  #              "public", which defaults to true).
+  # assignee_id: a staff member's ID, nil to unassign, or leave it out to
+  #              keep the current assignee. Staff only.
+  # group_id:    a group's ID, nil to ungroup (and unassign), or leave it out
+  #              to keep the current group. Staff only.
+  # priority:    "normal" or "high", or leave it out to keep the current
+  #              priority. Staff only.
+  # message_id:  the Message-ID of the email the comment arrived as, if any.
+  def initialize(ticket:, author:, status: nil, comment: nil, assignee_id: UNCHANGED, priority: UNCHANGED,
+    group_id: UNCHANGED, message_id: nil)
+    @ticket = ticket
+    @author = author
+    @status = status
+    @message_id = message_id
+    # NB: nil responds to to_h, so check for it explicitly.
+    @comment_attributes = !comment.nil? && comment.respond_to?(:to_h) ? comment.to_h.with_indifferent_access : nil
+    @assignee_id = assignee_id
+    @priority = priority
+    @group_id = group_id
+  end
+
+  # The requested priority; nil if it is to be left alone.
+  def priority
+    @priority if priority_given?
+  end
+
+  def save!
+    save || raise(ActiveModel::ValidationError, self)
+  end
+
+  def save
+    saved = false
+
+    Ticket.transaction do
+      if group_given? || assignee_given?
+        # Changes to groups and memberships wait for this update, and it
+        # waits for them, so the group and assignee it checks stay valid
+        # until it is saved (see Account#lock_groups).
+        ticket.account.lock_groups(shared: true)
+        # Before the ticket, in the order a suspension locks them (the user,
+        # then their tickets), so the two can't deadlock.
+        lock_new_assignee
+      end
+
+      # Lock (and reload) the ticket so concurrent replies are applied one at
+      # a time, each against the current status.
+      ticket.with_lock do
+        @comment = nil # rebuilt by valid? against the freshly locked ticket
+        if valid?
+          persist!
+          saved = true
+        end
+      end
+    end
+
+    if saved && emails_requester?
+      # Not before the comment is committed (the caller may have a
+      # transaction open), so a rollback never leaves a stray email.
+      reply = comment
+      ActiveRecord.after_all_transactions_commit { TicketMailer.with(comment: reply).reply.deliver_now }
+    end
+
+    saved
+  end
+
+  def valid?
+    errors.clear
+
+    # Checked against the locked ticket when saving, so a reply can't slip
+    # into a ticket that is being merged.
+    if ticket.closed?
+      errors.add(:base, :ticket_closed, message: "This ticket is closed: it was merged into ticket ##{ticket.merged_into_id}.")
+      return false
+    end
+
+    build_comment if @comment.nil?
+
+    if @status.nil? && @comment_attributes.nil? && !assignee_given? && !priority_given? && !group_given?
+      errors.add(:base, staff? ? "Add a comment, or change the status, group, assignee or priority." : "Add a comment or change the status.")
+    end
+
+    validate_status unless @status.nil?
+    validate_group if group_given?
+    validate_assignee if assignee_given?
+    resolve_assignment if (group_given? || assignee_given?) && !errors.include?(:group_id) && !errors.include?(:assignee_id)
+    validate_priority if priority_given?
+
+    if comment
+      validate_public_flag
+      comment.valid?
+      comment.errors.each do |error|
+        errors.import(error, attribute: :"comment.#{error.attribute}") unless error.attribute == :ticket
+      end
+    end
+
+    errors.empty?
+  end
+
+  # Whether the update failed because the ticket is closed.
+  def ticket_closed?
+    errors.of_kind?(:base, :ticket_closed)
+  end
+
+  private
+    def staff?
+      author.staff?
+    end
+
+    def assignee_given?
+      !UNCHANGED.equal?(@assignee_id)
+    end
+
+    def priority_given?
+      !UNCHANGED.equal?(@priority)
+    end
+
+    def group_given?
+      !UNCHANGED.equal?(@group_id)
+    end
+
+    def build_comment
+      return @comment = nil if @comment_attributes.nil?
+
+      @comment = ticket.comments.new(author: author, body: @comment_attributes[:body], public: public_flag,
+        message_id: @message_id)
+    end
+
+    # Staff's public replies continue an email conversation by email.
+    def emails_requester?
+      comment.present? && comment.public? && staff? && ticket.email_origin? && !ticket.requester.suspended?
+    end
+
+    # Customers' comments are always public: they are part of the conversation
+    # with the requester, who is the customer themselves.
+    def public_flag
+      return true unless staff?
+
+      raw = @comment_attributes[:public]
+      raw.nil? ? true : PUBLIC_FLAGS.fetch(raw, true)
+    end
+
+    def validate_public_flag
+      raw = @comment_attributes[:public]
+      if staff? && !raw.nil? && !PUBLIC_FLAGS.key?(raw)
+        errors.add(:"comment.public", "must be true or false")
+      end
+    end
+
+    def validate_status
+      if staff?
+        # Not "closed": only merging closes a ticket.
+        errors.add(:status, :inclusion, value: @status) unless Ticket::OPEN_STATUSES.include?(@status)
+      elsif !CUSTOMER_STATUSES.include?(@status)
+        errors.add(:status, "can only be set to solved")
+      end
+    end
+
+    # Finds the new group (nil to ungroup). Groups can't be deleted meanwhile
+    # (see #save).
+    def validate_group
+      @group = nil
+      return errors.add(:group_id, "can only be changed by staff") unless staff?
+      return if @group_id.nil?
+
+      id = RecordId.parse(@group_id)
+      @group = id && ticket.account.groups.find_by(id: id)
+      errors.add(:group_id, GROUP_ERROR) if @group.nil?
+    end
+
+    # Share-locks the user row of the new assignee (if any), so a concurrent
+    # suspension (which locks the user for update, then clears their
+    # assignments) can't slip in between checking them and the save.
+    def lock_new_assignee
+      return if !assignee_given? || @assignee_id.nil?
+
+      id = RecordId.parse(@assignee_id)
+      ticket.account.users.where(id: id).lock("FOR SHARE").pluck(:id) if id
+    end
+
+    # Finds the new assignee (nil to unassign). When saving, their row is
+    # already share-locked (see #lock_new_assignee).
+    def validate_assignee
+      @assignee = nil
+      return errors.add(:assignee_id, "can only be changed by staff") unless staff?
+      return if @assignee_id.nil?
+
+      id = RecordId.parse(@assignee_id)
+      @assignee = id && ticket.account.users.staff.active.find_by(id: id)
+      errors.add(:assignee_id, ASSIGNEE_ERROR) if @assignee.nil?
+    end
+
+    # Works out the ticket's group and assignee after the update (see the
+    # rules at the top), from the validated group and assignee. Groups and
+    # memberships can't change meanwhile (see #save).
+    def resolve_assignment
+      @new_group = group_given? ? @group : ticket.group
+      @new_assignee = assignee_given? ? @assignee : ticket.assignee
+
+      if assignee_given? && @assignee
+        @new_group = default_group_of(@assignee) if !group_given? && ticket.group_id.nil?
+        errors.add(:assignee_id, GROUP_MEMBER_ERROR) if @new_group && !member?(@assignee, @new_group)
+      elsif group_given? && @new_group.nil?
+        # Ungrouping also unassigns.
+        @new_assignee = nil
+      elsif group_given? && @new_group.id != ticket.group_id && @new_assignee && !member?(@new_assignee, @new_group)
+        # Moved to a group the assignee isn't a member of.
+        @new_assignee = nil
+      end
+    end
+
+    # The user's default group, or nil if they have none.
+    def default_group_of(user)
+      user.default_group_membership&.group
+    end
+
+    def member?(user, group)
+      GroupMembership.exists?(user_id: user.id, group_id: group.id)
+    end
+
+    # Priority is internal, so only staff may change it. Values are exact
+    # ("high", not "HIGH"), like statuses.
+    def validate_priority
+      if !staff?
+        errors.add(:priority, "can only be changed by staff")
+      elsif !Ticket::PRIORITIES.include?(@priority)
+        errors.add(:priority, :inclusion, value: @priority)
+      end
+    end
+
+    def new_status
+      if !@status.nil?
+        @status
+      elsif comment && !staff? && (ticket.pending? || ticket.solved?)
+        "open"
+      else
+        ticket.status
+      end
+    end
+
+    def persist!
+      now = Time.current
+      ticket.status = new_status
+      if group_given? || assignee_given?
+        ticket.group = @new_group
+        ticket.assignee = @new_assignee
+      end
+      ticket.priority = @priority if priority_given?
+
+      # Only a comment or an actual change of status, group, assignee or
+      # priority counts as activity; only public comments and status changes
+      # are activity the requester can see.
+      publicly_visible = comment&.public? || ticket.status_changed?
+
+      if comment || ticket.status_changed? || ticket.group_id_changed? || ticket.assignee_id_changed? || ticket.priority_changed?
+        ticket.updated_at = now
+        ticket.public_updated_at = now if publicly_visible
+        comment&.assign_attributes(created_at: now, updated_at: now)
+        # The Message-ID it is emailed with, which the customer's reply refers to.
+        comment.message_id ||= SupportAddress.generate_message_id if emails_requester?
+
+        Ticket.no_touching do
+          comment&.save!
+          ticket.save!
+        end
+      end
+    end
+end
diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..585a5e4
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,203 @@
+# A person using a business's (account's) helpdesk: either staff (admins and
+# agents), who work the tickets, or customers, who register through the
+# portal and open requests. Emails are unique per account, so the same address
+# can belong to users of different businesses.
+class User < ApplicationRecord
+  # Raised when suspending a user would leave the business without an active
+  # (unsuspended) admin to manage it.
+  class LastActiveAdmin < StandardError; end
+
+  STAFF_ROLES = %w[admin agent].freeze
+  CUSTOMER_ROLE = "customer".freeze
+  ROLES = (STAFF_ROLES + [ CUSTOMER_ROLE ]).freeze
+
+  EMAIL_VERIFICATION_TTL = 24.hours
+  PASSWORD_RESET_TTL = 2.hours
+  PASSWORD_MIN_LENGTH = 8
+
+  belongs_to :account
+  has_many :sessions, dependent: :delete_all
+  # Tickets and comments are removed by ON DELETE CASCADE foreign keys.
+  has_many :requested_tickets, class_name: "Ticket", foreign_key: :requester_id, inverse_of: :requester
+  has_many :comments, foreign_key: :author_id, inverse_of: :author
+  # Unassigned (ON DELETE SET NULL) if the user is ever deleted.
+  has_many :assigned_tickets, class_name: "Ticket", foreign_key: :assignee_id, inverse_of: :assignee
+  # Staff's groups (see GroupMembership). Removed by an ON DELETE CASCADE
+  # foreign key.
+  has_many :group_memberships, inverse_of: :user
+  has_many :groups, through: :group_memberships
+  has_one :default_group_membership, -> { defaults }, class_name: "GroupMembership", inverse_of: false
+  has_one :default_group, through: :default_group_membership, source: :group
+
+  has_secure_password
+
+  normalizes :name, with: ->(name) { name.squish }
+  normalizes :email, with: ->(email) { email.strip.downcase }
+
+  validates :name, presence: true, length: { maximum: 100 }
+  validates :email, presence: true,
+    length: { maximum: 254 },
+    format: { with: URI::MailTo::EMAIL_REGEXP, allow_blank: true },
+    uniqueness: { scope: :account_id }
+  validates :password, length: { minimum: PASSWORD_MIN_LENGTH }, allow_nil: true
+  validates :role, inclusion: { in: ROLES }
+  validate :customers_cannot_own_the_business
+
+  scope :staff, -> { where(role: STAFF_ROLES) }
+  scope :admins, -> { where(role: "admin") }
+  scope :active, -> { where(suspended_at: nil) }
+  scope :suspended, -> { where.not(suspended_at: nil) }
+
+  # --- Lookup by one-time token ----------------------------------------------
+  # These are scoped by the relation they are called on (e.g. account.users).
+
+  def self.find_by_email_verification_token(token)
+    return if token.blank?
+
+    where(email_verification_sent_at: EMAIL_VERIFICATION_TTL.ago..)
+      .find_by(email_verification_token_digest: OpaqueToken.digest(token))
+  end
+
+  def self.find_by_password_reset_token(token)
+    return if token.blank?
+
+    where(password_reset_sent_at: PASSWORD_RESET_TTL.ago..)
+      .find_by(password_reset_token_digest: OpaqueToken.digest(token))
+  end
+
+  def verified?
+    email_verified_at.present?
+  end
+
+  def admin?
+    role == "admin"
+  end
+
+  def staff?
+    STAFF_ROLES.include?(role)
+  end
+
+  def customer?
+    role == CUSTOMER_ROLE
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  # --- Suspension ---------------------------------------------------------------
+
+  # Suspends the user: they can no longer sign in, all of their sessions are
+  # revoked, and the tickets assigned to them become unassigned (the tickets
+  # keep their group). Their group memberships are kept for when the
+  # suspension is lifted. Suspending a suspended user changes nothing. Raises
+  # LastActiveAdmin rather than leave the business without an active admin.
+  def suspend!
+    # Suspensions within a business are serialized on the account row, so two
+    # admins can't suspend each other at the same time and leave nobody.
+    account.with_lock do
+      lock! # also waits for in-flight assignments to this user (see TicketUpdate)
+
+      unless suspended?
+        if admin? && !account.users.admins.active.where.not(id: id).exists?
+          raise LastActiveAdmin, "#{email} is the last active admin of #{account.subdomain}"
+        end
+
+        update!(suspended_at: Time.current)
+        sessions.delete_all
+        # Not activity on the tickets, so their updated_at is left alone.
+        assigned_tickets.update_all_in_id_order(assignee_id: nil)
+      end
+    end
+  end
+
+  # Lets a suspended user sign in again, in the groups they belonged to. Their
+  # old assignments are not restored.
+  def unsuspend!
+    with_lock { update!(suspended_at: nil) if suspended? }
+  end
+
+  # Ordinary users lose access when the business cancels; the owner keeps it
+  # so they can sign in and reactivate.
+  def account_access_allowed?
+    account.active? || owner?
+  end
+
+  # --- Email verification ----------------------------------------------------
+
+  # Sets a fresh verification token (replacing any previous one) without
+  # saving, and returns the plaintext token for the email link.
+  def generate_email_verification_token
+    token = OpaqueToken.generate
+    self.email_verification_token_digest = OpaqueToken.digest(token)
+    self.email_verification_sent_at = Time.current
+    token
+  end
+
+  def issue_email_verification_token!
+    generate_email_verification_token.tap { save! }
+  end
+
+  # Emails a new verification link, invalidating any previous one.
+  def send_email_verification
+    deliver_email_verification(issue_email_verification_token!)
+  end
+
+  # contacted_by_email: the user was created because they emailed the
+  # business, rather than signing up (the email explains that).
+  def deliver_email_verification(token, contacted_by_email: false)
+    UserMailer.with(user: self, token: token, contacted_by_email: contacted_by_email).email_verification.deliver_now
+  end
+
+  def verify_email!
+    update!(email_verified_at: email_verified_at || Time.current,
+      email_verification_token_digest: nil, email_verification_sent_at: nil)
+  end
+
+  # --- Passwords --------------------------------------------------------------
+
+  def issue_password_reset_token!
+    token = OpaqueToken.generate
+    update!(password_reset_token_digest: OpaqueToken.digest(token), password_reset_sent_at: Time.current)
+    token
+  end
+
+  # Emails a new password reset link, invalidating any previous one.
+  def send_password_reset
+    UserMailer.with(user: self, token: issue_password_reset_token!).password_reset.deliver_now
+  end
+
+  # Sets a new password and signs out every existing session. Outstanding
+  # password reset links stop working. Returns false (with errors) if invalid.
+  def update_password(password, password_confirmation = nil, verify_email: false)
+    if password.blank?
+      errors.add(:password, :blank)
+      return false
+    end
+
+    self.password = password
+    self.password_confirmation = password_confirmation unless password_confirmation.nil?
+    self.password_reset_token_digest = nil
+    self.password_reset_sent_at = nil
+
+    if verify_email && !verified?
+      # Following a link sent to the address proves the user controls it.
+      self.email_verified_at = Time.current
+      self.email_verification_token_digest = nil
+      self.email_verification_sent_at = nil
+    end
+
+    transaction do
+      save!
+      sessions.delete_all
+    end
+    true
+  rescue ActiveRecord::RecordInvalid
+    false
+  end
+
+  private
+    def customers_cannot_own_the_business
+      errors.add(:owner, "must be a staff member") if owner? && customer?
+    end
+end
