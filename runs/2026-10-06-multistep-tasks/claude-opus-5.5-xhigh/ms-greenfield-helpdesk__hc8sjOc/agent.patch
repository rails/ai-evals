new file mode 100644
index 0000000..148dd80
--- /dev/null
+++ b/test/models/account_registration_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class AccountRegistrationTest < ActiveSupport::TestCase
+  setup do
+    @registration = AccountRegistration.new(name: "Initech", subdomain: "initech",
+      admin: { name: "Jo", email: "jo@initech.test", password: "my-first-password" })
+  end
+
+  test "creates the account with a verified-pending admin owner" do
+    assert @registration.save
+    assert @registration.account.persisted?
+    user = @registration.user
+    assert user.persisted?
+    assert_equal [ "admin", true, false ], [ user.role, user.owner?, user.verified? ]
+    assert user.email_verification_token_digest.present?
+  end
+
+  test "losing a race on the subdomain after validation is a validation error" do
+    @registration.account.define_singleton_method(:save!) do |**options|
+      Account.create!(name: "Rival", subdomain: "initech")
+      super(**options)
+    end
+
+    assert_not @registration.save
+    assert_equal({ subdomain: [ "has already been taken" ] }, @registration.errors.to_hash)
+  end
+
+  test "a unique index violation on the subdomain is a validation error" do
+    @registration.account.define_singleton_method(:save!) { |**| raise ActiveRecord::RecordNotUnique, "duplicate key" }
+
+    assert_not @registration.save
+    assert_equal({ subdomain: [ "has already been taken" ] }, @registration.errors.to_hash)
+  end
+
+  test "a mail server failure does not fail the signup" do
+    failing = Class.new { def initialize(*) = nil; def deliver!(*) = raise(Errno::ECONNREFUSED) }
+    ActionMailer::Base.add_delivery_method :failing, failing
+    original, ActionMailer::Base.delivery_method = ActionMailer::Base.delivery_method, :failing
+
+    assert @registration.save
+    assert @registration.account.persisted?
+  ensure
+    ActionMailer::Base.delivery_method = original
+  end
+end
