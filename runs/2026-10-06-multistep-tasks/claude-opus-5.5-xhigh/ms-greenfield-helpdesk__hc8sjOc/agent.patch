diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..a08623e
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,55 @@
+module Api
+  module V1
+    class AccountsController < BaseController
+      allow_unauthenticated_access only: :create
+      skip_before_action :require_active_account!, only: %i[create reactivate]
+      before_action :require_owner!, only: %i[cancel reactivate]
+
+      # POST /api/v1/account/create
+      def create
+        registration = AccountRegistration.new(**registration_params.to_h.symbolize_keys)
+
+        if registration.save
+          render json: {
+            account: AccountSerializer.new(registration.account),
+            user: UserSerializer.new(registration.user)
+          }, status: :created
+        else
+          render_validation_errors registration.errors
+        end
+      end
+
+      # GET /api/v1/account
+      def show
+        render json: { account: AccountSerializer.new(Current.account) }
+      end
+
+      # POST /api/v1/account/cancel
+      # Signs everyone out, including the owner, who can sign back in to reactivate.
+      def cancel
+        Current.account.cancel!
+        render json: { account: AccountSerializer.new(Current.account) }
+      end
+
+      # POST /api/v1/account/reactivate
+      def reactivate
+        Current.account.reactivate!
+        render json: { account: AccountSerializer.new(Current.account) }
+      rescue Account::NotCancelled
+        render_error :conflict, "account_not_cancelled", "This account is not cancelled."
+      rescue Account::ReactivationWindowExpired
+        render_error :forbidden, "reactivation_window_expired",
+          "Accounts can only be reactivated within #{Account::REACTIVATION_WINDOW.inspect} of cancellation."
+      end
+
+      private
+        def registration_params
+          params.expect(account: [ :name, :subdomain, admin: [ :name, :email, :password ] ])
+        end
+
+        def require_owner!
+          render_error :forbidden, "owner_required", "Only the account owner can do this." unless Current.user.owner?
+        end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..a9f37c6
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,53 @@
+module Api
+  module V1
+    # By default actions require a signed-in user of an active business.
+    class BaseController < ApplicationController
+      include ErrorRendering
+      include AccountScoping
+      include Authentication
+
+      before_action :require_active_account!
+
+      # Request bodies use explicit envelopes ({"session": {...}}); don't
+      # guess them from model attributes.
+      wrap_parameters false
+
+      private
+        # Before actions restricting an endpoint to one side of the helpdesk.
+        def require_staff!
+          render_error :forbidden, "staff_required", "Only staff can do this." unless Current.user.staff?
+        end
+
+        def require_customer!
+          render_error :forbidden, "customer_required", "Only customers can do this." unless Current.user.customer?
+        end
+
+        # Managing people (invitations, users) is for admins only.
+        def require_admin!
+          render_error :forbidden, "admin_required", "Only admins can do this." unless Current.user.admin?
+        end
+
+        # A closed ticket (one merged into another) takes no more replies or
+        # changes. The error points at the ticket the conversation continues
+        # in. Customers call tickets requests.
+        def render_ticket_closed(ticket, noun: "ticket")
+          render_error :conflict, "ticket_closed",
+            "This #{noun} is closed: it was merged into #{noun} ##{ticket.merged_into_id}.",
+            merged_into_id: ticket.merged_into_id
+        end
+
+        # Users that an emailed token may belong to. Tokens are unique across
+        # businesses, so the account header is optional for these lookups.
+        def token_user_scope
+          Current.account ? Current.account.users : User.all
+        end
+
+        # Rate-limit key for endpoints that send email to an address.
+        def email_rate_limit_key(envelope)
+          attributes = params[envelope]
+          email = attributes.is_a?(ActionController::Parameters) ? attributes[:email].to_s.strip.downcase : ""
+          [ request.remote_ip, requested_subdomain, email ].join(":")
+        end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..5844b2c
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,40 @@
+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      allow_unauthenticated_access
+      skip_before_action :require_active_account!
+      before_action :require_account!, only: :create
+      before_action :load_requested_account, only: :confirm
+
+      rate_limit to: 10, within: 15.minutes, only: :create,
+        by: -> { email_rate_limit_key(:email_verification) },
+        with: -> { render_too_many_requests(retry_after: 15.minutes) }
+
+      # POST /api/v1/email_verifications
+      # Sends a new link. The response never reveals whether the email exists.
+      def create
+        email = params.expect(email_verification: [ :email ])[:email].to_s
+        user = Current.account.users.find_by(email: email)
+        user.send_email_verification if user && !user.verified? && !user.suspended? && user.account_access_allowed?
+
+        render json: { message: "If that email belongs to an unverified user, we've sent a new verification link." },
+          status: :accepted
+      end
+
+      # POST /api/v1/email_verifications/confirm
+      def confirm
+        token = params.expect(email_verification: [ :token ])[:token].to_s
+        user = token_user_scope.find_by_email_verification_token(token)
+
+        if user.nil?
+          render_error :unprocessable_content, "invalid_token", "This verification link is invalid or has expired."
+        elsif !user.account_access_allowed?
+          render_account_cancelled
+        else
+          user.verify_email!
+          render json: { message: "Your email address is verified. Please sign in.", user: UserSerializer.new(user) }
+        end
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/group_memberships_controller.rb b/app/controllers/api/v1/group_memberships_controller.rb
new file mode 100644
index 0000000..6267f07
--- /dev/null
+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,86 @@
+module Api
+  module V1
+    # Which staff belong to which groups. Any staff member may browse the
+    # memberships; only admins add and remove them and choose each staff
+    # member's default (see GroupMembership).
+    class GroupMembershipsController < BaseController
+      include Pagination
+      include ListFilters
+
+      DEFAULT_FLAGS = TicketUpdate::PUBLIC_FLAGS
+
+      before_action :require_staff!, only: %i[index show]
+      before_action :require_admin!, except: %i[index show]
+      before_action :set_membership, only: %i[show destroy make_default]
+
+      # GET /api/v1/group_memberships?group_id=20&user_id=12
+      def index
+        memberships = Current.account.group_memberships.includes(:group, :user).order(:id)
+        group_id = id_filter(:group_id)
+        memberships = memberships.where(group_id: group_id) if group_id
+        user_id = id_filter(:user_id)
+        memberships = memberships.where(user_id: user_id) if user_id
+
+        render_page memberships, key: :group_memberships, serializer: GroupMembershipSerializer
+      end
+
+      # GET /api/v1/group_memberships/:id
+      def show
+        render_membership
+      end
+
+      # POST /api/v1/group_memberships  {"group_membership": {"group_id": 20, "user_id": 12, "default": true}}
+      # "default" is optional; a staff member's first membership is their
+      # default anyway.
+      def create
+        attributes = params.expect(group_membership: [ :group_id, :user_id, :default ])
+        default = attributes[:default].nil? ? false : DEFAULT_FLAGS.fetch(attributes[:default], nil)
+        @membership = GroupMembership.new(
+          group: find_by_record_id(Current.account.groups, attributes[:group_id]),
+          user: find_by_record_id(Current.account.users, attributes[:user_id]),
+          default: default
+        )
+
+        if default.nil?
+          @membership.validate
+          @membership.errors.add(:default, "must be true or false")
+          render_validation_errors @membership.errors
+        elsif @membership.save
+          render_membership status: :created
+        else
+          render_validation_errors @membership.errors
+        end
+      end
+
+      # PUT /api/v1/group_memberships/:id/make_default
+      # Makes this the staff member's default membership, in place of their
+      # previous one.
+      def make_default
+        @membership.make_default!
+        render_membership
+      end
+
+      # DELETE /api/v1/group_memberships/:id
+      # If it was the staff member's default, another of their memberships
+      # becomes the default. They are unassigned from the group's tickets.
+      def destroy
+        @membership.destroy!
+        head :no_content
+      end
+
+      private
+        def set_membership
+          @membership = Current.account.group_memberships.includes(:group, :user).find(params[:id])
+        end
+
+        def find_by_record_id(scope, value)
+          id = RecordId.parse(value)
+          id && scope.find_by(id: id)
+        end
+
+        def render_membership(status: :ok)
+          render json: { group_membership: GroupMembershipSerializer.new(@membership) }, status: status
+        end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/groups_controller.rb b/app/controllers/api/v1/groups_controller.rb
new file mode 100644
index 0000000..a35d3bb
--- /dev/null
+++ b/app/controllers/api/v1/groups_controller.rb
@@ -0,0 +1,62 @@
+module Api
+  module V1
+    # Groups of staff, such as departments (Billing, Technical Support). Any
+    # staff member may browse them; only admins create, rename and delete
+    # them. Groups organize work: they don't hide tickets from other staff.
+    class GroupsController < BaseController
+      include Pagination
+
+      before_action :require_staff!, only: %i[index show]
+      before_action :require_admin!, except: %i[index show]
+      before_action :set_group, only: %i[show update destroy]
+
+      # GET /api/v1/groups
+      def index
+        render_page Current.account.groups.order(:id), key: :groups, serializer: GroupSerializer
+      end
+
+      # GET /api/v1/groups/:id
+      def show
+        render json: { group: GroupSerializer.new(@group) }
+      end
+
+      # POST /api/v1/groups  {"group": {"name": "Billing"}}
+      def create
+        group = Current.account.groups.new(name: group_params[:name])
+
+        if group.save
+          render json: { group: GroupSerializer.new(group) }, status: :created
+        else
+          render_validation_errors group.errors
+        end
+      end
+
+      # PATCH /api/v1/groups/:id  {"group": {"name": "Payments"}}
+      # Renames the group; nothing else about it can be changed.
+      def update
+        if @group.update(name: group_params[:name])
+          render json: { group: GroupSerializer.new(@group) }
+        else
+          render_validation_errors @group.errors
+        end
+      end
+
+      # DELETE /api/v1/groups/:id
+      # Removes the group's memberships, and ungroups and unassigns its
+      # tickets (see Group).
+      def destroy
+        @group.destroy!
+        head :no_content
+      end
+
+      private
+        def set_group
+          @group = Current.account.groups.find(params[:id])
+        end
+
+        def group_params
+          params.expect(group: [ :name ])
+        end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
