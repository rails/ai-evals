@@ -0,0 +1,40 @@
+require "test_helper"
+
+class SupportAddressTest < ActiveSupport::TestCase
+  test "businesses' and tickets' addresses" do
+    assert_equal "acme@support.example.test", SupportAddress.for_account(accounts(:acme))
+    assert_equal "acme@support.example.test", accounts(:acme).support_email
+
+    ticket = Ticket.new(reply_token: "0123456789abcdef0123456789abcdef")
+    assert_equal "reply+0123456789abcdef0123456789abcdef@support.example.test", ticket.reply_address
+  end
+
+  test "parses business and reply addresses at the support domain, ignoring case" do
+    assert_equal SupportAddress::Recipient.new(subdomain: "acme", reply_token: nil), SupportAddress.parse(" ACME@Support.Example.Test ")
+    assert_equal SupportAddress::Recipient.new(subdomain: nil, reply_token: "0123456789abcdef0123456789abcdef"),
+      SupportAddress.parse("Reply+0123456789ABCDEF0123456789ABCDEF@support.example.test")
+    assert SupportAddress.parse("reply+0123456789abcdef0123456789abcdef@support.example.test").reply?
+  end
+
+  test "other addresses are not ours" do
+    [
+      nil, "", "acme", "acme@example.test", "acme@sub.support.example.test", "acme@support.example.test.evil.test",
+      "-acme@support.example.test", "ac_me@support.example.test", "acme+tag@support.example.test",
+      "reply+short@support.example.test", "reply+@support.example.test", "@support.example.test",
+      "#{"a" * 64}@support.example.test"
+    ].each do |address|
+      assert_nil SupportAddress.parse(address), "#{address.inspect} shouldn't be ours"
+    end
+  end
+
+  test "reply addresses fit in the 64 characters SMTP allows before the @" do
+    assert_operator SupportAddress.for_ticket(Ticket.new(reply_token: SupportAddress.generate_reply_token)).split("@").first.length, :<=, 64
+  end
+
+  test "new tickets get random reply tokens" do
+    ticket = RequestSubmission.new(requester: users(:avery), subject: "Hi", comment: { body: "Hello" }).tap(&:save!).ticket
+    assert_match(/\A[0-9a-f]{32}\z/, ticket.reply_token)
+    assert_equal ticket.reply_token, ticket.reload.reply_token
+    assert_not_equal ticket.reply_token, RequestSubmission.new(requester: users(:avery), subject: "Hi", comment: { body: "Hello" }).tap(&:save!).ticket.reply_token
+  end
+end
diff --git a/test/models/ticket_test.rb b/test/models/ticket_test.rb
new file mode 100644
index 0000000..17a5366
--- /dev/null
+++ b/test/models/ticket_test.rb
@@ -0,0 +1,220 @@
+require "test_helper"
+
+class TicketTest < ActiveSupport::TestCase
+  include ApiTestHelpers
+
+  setup { @ticket = open_request(users(:avery)) }
+
+  test "new tickets are open" do
+    assert Ticket.new.open?
+    assert_equal "open", @ticket.status
+  end
+
+  test "the requester must belong to the ticket's business" do
+    ticket = accounts(:acme).tickets.new(requester: users(:globex_avery), subject: "Hi")
+    assert_not ticket.valid?
+    assert ticket.errors.include?(:requester)
+  end
+
+  test "status must be known" do
+    @ticket.status = "closed"
+    assert_not @ticket.valid?
+  end
+
+  test "new tickets are normal priority, and priority must be normal or high" do
+    assert_equal "normal", Ticket.new.priority
+    assert_equal "normal", @ticket.priority
+
+    @ticket.priority = "high"
+    assert @ticket.valid?
+    [ "urgent", "HIGH", nil, "" ].each do |priority|
+      @ticket.priority = priority
+      assert_not @ticket.valid?, priority.inspect
+      assert @ticket.errors.include?(:priority)
+    end
+  end
+
+  test "a priority change alone is internal activity" do
+    ticket = travel_to(1.day.ago) { open_request(users(:avery)) }
+    public_before = ticket.public_updated_at
+
+    update = TicketUpdate.new(ticket: ticket, author: users(:ari), priority: "high")
+    assert_equal "high", update.priority
+    assert update.save
+    ticket.reload
+    assert_equal "high", ticket.priority
+    assert_in_delta Time.current, ticket.updated_at, 1.minute
+    assert_equal public_before, ticket.public_updated_at
+    assert_equal 1, ticket.comments.count
+
+    assert_nil TicketUpdate.new(ticket: ticket, author: users(:ari), comment: { body: "Hi" }).priority
+    assert_not TicketUpdate.new(ticket: ticket, author: users(:ari), priority: nil).valid?
+  end
+
+  test "search matches subjects and public comments literally, ignoring case" do
+    other = open_request(users(:blake), subject: "100% off_code", body: "Thanks")
+    TicketUpdate.new(ticket: @ticket, author: users(:sam), comment: { body: "Internal: VIP", public: false }).save!
+
+    assert_equal [ other ], Ticket.matching("% OFF_").to_a
+    assert_equal [ @ticket ], Ticket.matching("please HELP").to_a
+    assert_empty Ticket.matching("vip")
+    assert_empty Ticket.matching("100_")
+  end
+
+  test "comment authors must be staff of the business or the requester" do
+    assert @ticket.comments.new(author: users(:sam), body: "Staff", public: false).valid?
+    assert @ticket.comments.new(author: users(:avery), body: "Requester").valid?
+
+    assert_not @ticket.comments.new(author: users(:blake), body: "Another customer").valid?
+    assert_not @ticket.comments.new(author: users(:globex_jo), body: "Another business").valid?
+  end
+
+  test "customers can't write private comments" do
+    comment = @ticket.comments.new(author: users(:avery), body: "Hidden?", public: false)
+    assert_not comment.valid?
+    assert comment.errors.include?(:public)
+  end
+
+  test "customers can't own a business" do
+    user = users(:avery)
+    user.owner = true
+    assert_not user.valid?
+  end
+
+  test "comment bodies are stripped" do
+    TicketUpdate.new(ticket: @ticket, author: users(:sam), comment: { body: "  Hi there \n\n" }).save!
+    assert_equal "Hi there", @ticket.comments.last.body
+  end
+
+  test "an update is applied against the current status, not a stale copy" do
+    stale = Ticket.find(@ticket.id)
+    Ticket.find(@ticket.id).update!(status: "solved")
+
+    TicketUpdate.new(ticket: stale, author: users(:avery), comment: { body: "Still broken" }).save!
+    assert_equal "open", @ticket.reload.status
+  end
+
+  test "an update can be validated before saving, and saves exactly one comment" do
+    update = TicketUpdate.new(ticket: @ticket, author: users(:sam), comment: { body: " " })
+    assert_not update.valid?
+    assert update.errors.include?(:"comment.body")
+
+    update = TicketUpdate.new(ticket: @ticket, author: users(:sam), comment: { body: "Hi" }, status: "pending")
+    assert update.valid?
+    assert_difference -> { @ticket.comments.count } => 1 do
+      assert update.save
+    end
+    assert_equal "pending", @ticket.reload.status
+  end
+
+  test "purging a business deletes its tickets and comments" do
+    TicketUpdate.new(ticket: @ticket, author: users(:sam), comment: { body: "Hi" }).save!
+    other = open_request(users(:globex_avery))
+    accounts(:acme).update_columns(cancelled_at: 91.days.ago)
+
+    assert_equal 1, Account.purge_cancelled!
+    assert_not Ticket.exists?(@ticket.id)
+    assert_equal 0, Comment.where(ticket_id: @ticket.id).count
+    assert Ticket.exists?(other.id)
+    assert_equal 1, other.comments.count
+  end
+
+  test "assignees must be active staff of the ticket's business" do
+    @ticket.assignee = users(:ari)
+    assert @ticket.valid?
+
+    [ users(:avery), users(:globex_jo) ].each do |user|
+      @ticket.assignee = user
+      assert_not @ticket.valid?, user.name
+      assert @ticket.errors.include?(:assignee_id)
+    end
+
+    users(:sam).update_columns(suspended_at: Time.current)
+    @ticket.assignee = users(:sam)
+    assert_not @ticket.valid?
+
+    @ticket.assignee = nil
+    assert @ticket.valid?
+  end
+
+  # --- Merging --------------------------------------------------------------------
+
+  test "only merging closes a ticket, and a merged ticket is closed" do
+    target = open_request(users(:avery))
+    @ticket.status = "closed"
+    assert_not @ticket.valid?
+    assert @ticket.errors.include?(:status)
+
+    @ticket.status = "open"
+    @ticket.merged_into = target
+    assert_not @ticket.valid?
+
+    @ticket.status = "closed"
+    assert @ticket.valid?
+    assert @ticket.save
+    assert @ticket.closed?
+  end
+
+  test "a merge is final: the ticket stays closed and keeps its link" do
+    target = open_request(users(:avery))
+    other = open_request(users(:avery))
+    TicketMerge.new(source: @ticket, author: users(:jo), target_id: target.id).save!
+    @ticket.reload
+
+    @ticket.assign_attributes(status: "open", merged_into: nil)
+    assert_not @ticket.valid?
+    @ticket.reload.merged_into = other
+    assert_not @ticket.valid?
+    assert_equal [ "can't be changed once set" ], @ticket.errors[:merged_into_id]
+  end
+
+  test "tickets are only merged into another ticket of the same customer and business" do
+    @ticket.status = "closed"
+    [ open_request(users(:blake)), open_request(users(:globex_avery)), @ticket ].each do |other|
+      @ticket.merged_into = other
+      assert_not @ticket.valid?, other.subject
+      assert @ticket.errors.include?(:merged_into_id)
+    end
+  end
+
+  test "the database keeps closed and merged together" do
+    target = open_request(users(:avery))
+    [ { status: "closed" }, { merged_into_id: target.id }, { status: "closed", merged_into_id: @ticket.id },
+      { status: "archived" } ].each do |columns|
+      assert_raises(ActiveRecord::StatementInvalid, columns.inspect) do
+        Ticket.transaction(requires_new: true) { Ticket.where(id: @ticket.id).update_all(columns) }
+      end
+    end
+    @ticket.update_columns(status: "closed", merged_into_id: target.id)
+    assert @ticket.reload.closed?
+  end
+
+  test "deleting a customer or their business deletes merged tickets too" do
+    [ :avery, :blake ].each do |name|
+      customer = users(name)
+      first, second, third = 3.times.map { open_request(customer) }
+      # Links in both directions of ID order.
+      TicketMerge.new(source: third, author: users(:jo), target_id: second.id).save!
+      TicketMerge.new(source: first, author: users(:jo), target_id: second.id).save!
+    end
+
+    users(:avery).destroy!
+    assert_equal 0, Ticket.where(requester_id: users(:avery).id).count
+    assert_equal 3, Ticket.where(requester_id: users(:blake).id).count
+
+    accounts(:acme).destroy!
+    assert_equal 0, Ticket.where(account_id: accounts(:acme).id).count
+  end
+
+  test "a ticket that others were merged into can't be deleted by itself" do
+    target = open_request(users(:avery))
+    TicketMerge.new(source: @ticket, author: users(:jo), target_id: target.id).save!
+    assert_raises(ActiveRecord::InvalidForeignKey) { target.delete }
+  end
+
+  test "new tickets start with matching activity times" do
+    ticket = accounts(:acme).tickets.create!(requester: users(:avery), subject: "Direct")
+    assert_equal ticket.updated_at, ticket.public_updated_at
+    assert_equal @ticket.updated_at, @ticket.public_updated_at
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
new file mode 100644
index 0000000..db3b15b
--- /dev/null
+++ b/test/test_helper.rb
@@ -0,0 +1,72 @@
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+require "rails/test_help"
+
+module ActiveSupport
+  class TestCase
+    # Run tests in parallel with specified workers
+    parallelize(workers: :number_of_processors)
+
+    # Setup all fixtures in test/fixtures/*.yml for all tests in alphabetical order.
+    fixtures :all
+  end
+end
+
+# Helpers for exercising the JSON API.
+module ApiTestHelpers
+  PASSWORD = "password123".freeze
+
+  def json
+    JSON.parse(response.body)
+  end
+
+  def api_headers(account: nil, token: nil)
+    headers = { "Content-Type" => "application/json", "Accept" => "application/json" }
+    headers["X-Helpdesk-Account"] = account.respond_to?(:subdomain) ? account.subdomain : account if account
+    headers["Authorization"] = "Bearer #{token}" if token
+    headers
+  end
+
+  %i[get post put patch delete].each do |verb|
+    define_method(:"api_#{verb}") do |path, body = nil, account: nil, token: nil|
+      public_send(verb, "/api/v1#{path}", params: body&.to_json, headers: api_headers(account: account, token: token))
+    end
+  end
+
+  def sign_in(user, password: PASSWORD)
+    api_post "/sessions", { session: { email: user.email, password: password } }, account: user.account
+    assert_response :created
+    json.dig("session", "token")
+  end
+
+  def sign_up(subdomain: "initech", email: "jo@initech.test", password: "my-first-password")
+    api_post "/account/create", {
+      account: { name: "Initech", subdomain: subdomain, admin: { name: "Jo", email: email, password: password } }
+    }
+  end
+
+  # Opens a request as +customer+ directly through the model.
+  def open_request(customer, subject: "Help", body: "Please help.")
+    submission = RequestSubmission.new(requester: customer, subject: subject, comment: { body: body })
+    assert submission.save, submission.errors.full_messages.to_sentence
+    submission.ticket
+  end
+
+  def last_email
+    ActionMailer::Base.deliveries.last
+  end
+
+  # Extracts the token from the frontend link in an email's text part.
+  def token_from_email(mail, path)
+    body = (mail.text_part || mail).body.decoded
+    link = body[%r{#{Regexp.escape(Rails.configuration.x.frontend_url)}#{path}\?\S+}]
+    assert link, "Expected a #{path} link in:\n#{body}"
+    Rack::Utils.parse_query(URI.parse(link).query).fetch("token")
+  end
+end
+
+class ActionDispatch::IntegrationTest
+  include ApiTestHelpers
+
+  setup { ActionMailer::Base.deliveries.clear }
+end
