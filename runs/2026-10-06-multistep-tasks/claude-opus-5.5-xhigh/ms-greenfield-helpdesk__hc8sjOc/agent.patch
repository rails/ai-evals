@@ -0,0 +1,11 @@
+# The inbox is most often narrowed to one status (e.g. ?status=open), still
+# most recently active first. Built concurrently so a busy tickets table stays
+# writable while the index is created.
+class AddStatusIndexToTickets < ActiveRecord::Migration[8.1]
+  disable_ddl_transaction!
+
+  def change
+    add_index :tickets, [ :account_id, :status, :updated_at, :id ], order: { updated_at: :desc, id: :desc },
+      name: "index_tickets_on_account_id_and_status_and_activity", algorithm: :concurrently
+  end
+end
diff --git a/db/migrate/20250101000012_add_search_index_to_comments.rb b/db/migrate/20250101000012_add_search_index_to_comments.rb
new file mode 100644
index 0000000..0149669
--- /dev/null
+++ b/db/migrate/20250101000012_add_search_index_to_comments.rb
@@ -0,0 +1,18 @@
+# Ticket search (GET /tickets?q=) looks for text anywhere in public comments,
+# which a B-tree index can't help with. A trigram index can, for searches of
+# three or more characters. Internal notes aren't searched, so they aren't
+# indexed. (Subjects are only checked on a business's own tickets, which are
+# found through their account_id indexes.)
+#
+# pg_trgm ships with PostgreSQL and is a trusted extension: the database owner
+# can enable it without superuser rights. The index is built concurrently so a
+# busy comments table stays writable meanwhile.
+class AddSearchIndexToComments < ActiveRecord::Migration[8.1]
+  disable_ddl_transaction!
+
+  def change
+    enable_extension "pg_trgm"
+    add_index :comments, :body, using: :gin, opclass: :gin_trgm_ops, where: "public",
+      name: "index_comments_on_body_trigram_where_public", algorithm: :concurrently
+  end
+end
