+  # --- Deduplication ----------------------------------------------------------------
+
+  test "an email delivered twice opens one ticket" do
+    source = compose(message_id: "once@example.test")
+    assert_difference -> { Ticket.count } => 1, -> { User.count } => 1 do
+      2.times { relay(source) }
+    end
+    assert_equal 1, ActionMailer::Base.deliveries.size, "one verification email"
+
+    # Redelivered with different headers (e.g. Received lines), but the same Message-ID.
+    assert_no_difference -> { Ticket.count } do
+      deliver(message_id: "once@example.test", headers: { "Received" => "from mx2.example.test" })
+    end
+    assert_equal "delivered", ActionMailbox::InboundEmail.last.status
+  end
