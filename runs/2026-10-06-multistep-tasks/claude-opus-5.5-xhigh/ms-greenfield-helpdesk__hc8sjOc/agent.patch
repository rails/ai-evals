diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
new file mode 100644
index 0000000..7bf467a
--- /dev/null
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,102 @@
+module Api
+  module V1
+    # The staff side of the conversation: every ticket of the business.
+    class TicketsController < BaseController
+      include Pagination
+      include ListFilters
+
+      UNASSIGNED = "unassigned".freeze
+
+      before_action :require_staff!
+      before_action :set_ticket, only: %i[show update comments merge]
+
+      # GET /api/v1/tickets?status=open&group_id=unassigned&assignee_id=unassigned&priority=high&q=...
+      # Filters combine: a ticket is listed only if it matches all of them.
+      def index
+        render_page filtered_tickets.recently_active_first.includes(:requester, :assignee, :group),
+          key: :tickets, serializer: TicketSerializer
+      end
+
+      # GET /api/v1/tickets/:id
+      def show
+        render json: { ticket: TicketSerializer.new(@ticket) }
+      end
+
+      # PATCH /api/v1/tickets/:id
+      # Reply (publicly or as a private note), change the status, move the
+      # ticket to a group ("group_id": a group's ID, or null), assign it
+      # ("assignee_id": a staff member's ID, or null) and/or change its
+      # priority, in any combination.
+      def update
+        attributes = params.expect(ticket: [ :status, :group_id, :assignee_id, :priority, comment: [ :body, :public ] ])
+        # Left out means unchanged; null is a value (it ungroups or unassigns).
+        changes = attributes.slice(:group_id, :assignee_id, :priority).to_h.symbolize_keys
+        update = TicketUpdate.new(ticket: @ticket, author: Current.user,
+          status: attributes[:status], comment: attributes[:comment], **changes)
+
+        if update.save
+          render json: { ticket: TicketSerializer.new(@ticket) }
+        elsif update.ticket_closed?
+          render_ticket_closed @ticket
+        else
+          render_validation_errors update.errors
+        end
+      end
+
+      # POST /api/v1/tickets/:id/merge
+      # {"merge": {"target_id": 57, "source_comment": {"body", "public"}, "target_comment": {"body", "public"}}}
+      # Closes this ticket, a duplicate, in favour of another ticket of the
+      # same customer, and leaves a note on each (see TicketMerge).
+      def merge
+        attributes = params.expect(merge: [ :target_id, source_comment: [ :body, :public ], target_comment: [ :body, :public ] ])
+        merge = TicketMerge.new(source: @ticket, author: Current.user, target_id: attributes[:target_id],
+          source_comment: attributes[:source_comment], target_comment: attributes[:target_comment])
+
+        if merge.save
+          render json: { source: TicketSerializer.new(merge.source), target: TicketSerializer.new(merge.target) }
+        elsif merge.ticket_closed?
+          render_ticket_closed @ticket
+        else
+          render_validation_errors merge.errors
+        end
+      end
+
+      # GET /api/v1/tickets/:id/comments
+      # All comments, including private (internal) ones.
+      def comments
+        render_page @ticket.comments.includes(:author), key: :comments, serializer: CommentSerializer
+      end
+
+      private
+        def set_ticket
+          @ticket = Current.account.tickets.includes(:requester, :assignee, :group).find(params[:id])
+        end
+
+        # The business's tickets, narrowed by the query parameters. An unknown
+        # or malformed value is 400 bad_request (see ListFilters).
+        def filtered_tickets
+          tickets = Current.account.tickets
+
+          status = enum_filter(:status, Ticket::STATUSES)
+          tickets = tickets.where(status: status) if status
+
+          priority = enum_filter(:priority, Ticket::PRIORITIES)
+          tickets = tickets.where(priority: priority) if priority
+
+          group_id = id_filter(:group_id, keywords: [ UNASSIGNED ])
+          tickets = tickets.where(group_id: group_id == UNASSIGNED ? nil : group_id) if group_id
+
+          assignee_id = id_filter(:assignee_id, keywords: [ UNASSIGNED ])
+          tickets = tickets.where(assignee_id: assignee_id == UNASSIGNED ? nil : assignee_id) if assignee_id
+
+          requester_id = id_filter(:requester_id)
+          tickets = tickets.where(requester_id: requester_id) if requester_id
+
+          query = search_filter(:q)
+          tickets = tickets.matching(query) if query
+
+          tickets
+        end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..fc1ad59
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,56 @@
+module Api
+  module V1
+    # Admins manage the business's people: staff and customers.
+    class UsersController < BaseController
+      include Pagination
+      include ListFilters
+
+      SUSPENDED_FLAGS = TicketUpdate::PUBLIC_FLAGS
+
+      before_action :require_admin!
+      before_action :set_user, only: %i[show update]
+
+      # GET /api/v1/users?role=agent&suspended=false
+      def index
+        users = Current.account.users.order(:id)
+        role = enum_filter(:role, User::ROLES)
+        users = users.where(role: role) if role
+        suspended = boolean_filter(:suspended)
+        users = suspended ? users.suspended : users.active unless suspended.nil?
+
+        render_page users, key: :users, serializer: UserSerializer
+      end
+
+      # GET /api/v1/users/:id
+      def show
+        render json: { user: UserSerializer.new(@user) }
+      end
+
+      # PATCH /api/v1/users/:id  {"user": {"suspended": true}}
+      def update
+        attributes = params.expect(user: [ :suspended ])
+        suspended = attributes[:suspended]
+
+        unless SUSPENDED_FLAGS.key?(suspended)
+          return render_user_error("must be true or false")
+        end
+
+        SUSPENDED_FLAGS.fetch(suspended) ? @user.suspend! : @user.unsuspend!
+        render json: { user: UserSerializer.new(@user) }
+      rescue User::LastActiveAdmin
+        render_user_error("can't be true for the last active admin; another admin must stay active")
+      end
+
+      private
+        def set_user
+          @user = Current.account.users.find(params[:id])
+        end
+
+        def render_user_error(message)
+          errors = ActiveModel::Errors.new(@user)
+          errors.add(:suspended, message)
+          render_validation_errors errors
+        end
+    end
+  end
+end
