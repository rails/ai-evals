diff --git a/app/controllers/api/v1/requests_controller.rb b/app/controllers/api/v1/requests_controller.rb
new file mode 100644
index 0000000..d4212ce
--- /dev/null
+++ b/app/controllers/api/v1/requests_controller.rb
@@ -0,0 +1,74 @@
+module Api
+  module V1
+    # The customer's side of the conversation: their own tickets, which they
+    # call requests. Other customers' requests are not found.
+    class RequestsController < BaseController
+      include Pagination
+      include ListFilters
+
+      before_action :require_customer!
+      before_action :set_ticket, only: %i[show update comments]
+
+      # GET /api/v1/requests?status=open
+      # Customers can only filter by status (including closed, for merged
+      # requests). Staff-only filters (priority,
+      # assignee, ...) are ignored, so they reveal nothing internal.
+      def index
+        requests = own_tickets
+        status = enum_filter(:status, Ticket::STATUSES)
+        requests = requests.where(status: status) if status
+
+        # Ordered by the activity the customer can see, not internal notes.
+        render_page requests.recent_public_activity_first, key: :requests, serializer: RequestSerializer
+      end
+
+      # GET /api/v1/requests/:id
+      def show
+        render json: { request: RequestSerializer.new(@ticket) }
+      end
+
+      # POST /api/v1/requests
+      def create
+        attributes = params.expect(request: [ :subject, comment: [ :body ] ])
+        submission = RequestSubmission.new(requester: Current.user,
+          subject: attributes[:subject], comment: attributes[:comment])
+
+        if submission.save
+          render json: { request: RequestSerializer.new(submission.ticket) }, status: :created
+        else
+          render_validation_errors submission.errors
+        end
+      end
+
+      # PATCH /api/v1/requests/:id
+      def update
+        attributes = params.expect(request: [ :status, comment: [ :body ] ])
+        update = TicketUpdate.new(ticket: @ticket, author: Current.user,
+          status: attributes[:status], comment: attributes[:comment])
+
+        if update.save
+          render json: { request: RequestSerializer.new(@ticket) }
+        elsif update.ticket_closed?
+          render_ticket_closed @ticket, noun: "request"
+        else
+          render_validation_errors update.errors
+        end
+      end
+
+      # GET /api/v1/requests/:id/comments
+      # Only public comments: staff's internal notes are never shown.
+      def comments
+        render_page @ticket.public_comments.includes(:author), key: :comments, serializer: CommentSerializer
+      end
+
+      private
+        def own_tickets
+          Current.account.tickets.where(requester: Current.user)
+        end
+
+        def set_ticket
+          @ticket = own_tickets.find(params[:id])
+        end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/sessions_controller.rb b/app/controllers/api/v1/sessions_controller.rb
new file mode 100644
index 0000000..954f5d9
--- /dev/null
+++ b/app/controllers/api/v1/sessions_controller.rb
@@ -0,0 +1,43 @@
+module Api
+  module V1
+    class SessionsController < BaseController
+      allow_unauthenticated_access only: :create
+      # Owners of cancelled accounts may sign in (to reactivate) and out.
+      skip_before_action :require_active_account!
+      before_action :require_account!, only: :create
+
+      # POST /api/v1/sessions
+      def create
+        credentials = params.expect(session: [ :email, :password ])
+        throttle = LoginThrottle.new(account: Current.account, email: credentials[:email], ip: request.remote_ip)
+        return render_too_many_requests(retry_after: throttle.retry_after) if throttle.blocked?
+
+        user = Current.account.users.authenticate_by(email: credentials[:email].to_s, password: credentials[:password].to_s)
+
+        if user.nil?
+          throttle.record_failure
+          render_error :unauthorized, "invalid_credentials", "Invalid email or password."
+        elsif !user.account_access_allowed?
+          render_account_cancelled
+        elsif user.suspended?
+          render_error :forbidden, "user_suspended", "Your access to this helpdesk has been suspended."
+        elsif !user.verified?
+          render_error :forbidden, "email_not_verified", "Verify your email address before signing in."
+        else
+          throttle.reset
+          render json: {
+            session: SessionSerializer.new(start_session_for(user)),
+            user: UserSerializer.new(user),
+            account: AccountSerializer.new(user.account)
+          }, status: :created
+        end
+      end
+
+      # DELETE /api/v1/session
+      def destroy
+        Current.session.destroy!
+        head :no_content
+      end
+    end
+  end
+end
