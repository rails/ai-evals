+# Groups (departments such as Billing or Technical Support) organize the
+# staff's work. Staff may belong to several groups; each staff member with
+# memberships has exactly one default membership, which the app maintains
+# (see GroupMembership). The partial unique index is the safety net: it allows
+# at most one default per user.
+#
+# Group names are unique within a business, ignoring case.
+class CreateGroups < ActiveRecord::Migration[8.1]
+  def change
+    create_table :groups do |t|
+      # Deleting a business deletes its groups.
+      t.references :account, null: false, index: false, foreign_key: { on_delete: :cascade }
+      t.string :name, null: false
+
