+
+    [ "group_id=abc", "group_id=0", "user_id=-1", "user_id=unassigned", "group_id[]=1" ].each do |query|
+      api_get "/group_memberships?#{query}", token: agent_token, account: "acme"
+      assert_response :bad_request, query
+      assert_equal "bad_request", json.dig("error", "code")
+    end
+
+    api_get "/group_memberships", token: sign_in(users(:avery)), account: "acme"
+    assert_response :forbidden
+    assert_equal "staff_required", json.dig("error", "code")
+  end
+
+  test "only admins add and remove memberships" do
+    billing = @acme.groups.create!(name: "Billing")
