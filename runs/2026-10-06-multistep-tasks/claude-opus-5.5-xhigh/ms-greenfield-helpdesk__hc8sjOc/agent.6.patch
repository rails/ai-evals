+      api_post "/group_memberships", { group_membership: { group_id: billing.id, user_id: id } }, token: @token, account: "acme"
+      assert_response :unprocessable_content, id.inspect
+      assert_equal [ "must be a staff member of this business" ], json.dig("errors", "user_id"), id.inspect
+    end
+
+    add_member globex, @ari
+    assert_response :unprocessable_content
+    assert_equal [ "must be a group of this business" ], json.dig("errors", "group_id")
