+++ b/db/migrate/20250101000018_add_group_to_tickets.rb
@@ -0,0 +1,26 @@
+# Tickets can belong to a group. Existing tickets stay ungrouped.
+#
+# The foreign key clears the group of a deleted group's tickets as a safety
+# net; the app clears their assignees along with it (see Group). It is added
+# without validation and then validated, so the tickets table isn't locked
+# against writes while every row is checked. The index serves the inbox
+# filtered by group (still most recently active first) and finds a group's
+# tickets when it is deleted. It is built concurrently so a busy tickets table
+# stays writable meanwhile.
+class AddGroupToTickets < ActiveRecord::Migration[8.1]
+  disable_ddl_transaction!
+
+  def up
+    add_column :tickets, :group_id, :bigint
+    add_foreign_key :tickets, :groups, on_delete: :nullify, validate: false
+    validate_foreign_key :tickets, :groups
+    add_index :tickets, [ :group_id, :updated_at, :id ], order: { updated_at: :desc, id: :desc },
+      name: "index_tickets_on_group_id_and_activity", algorithm: :concurrently
+  end
+
+  def down
+    remove_index :tickets, name: "index_tickets_on_group_id_and_activity", algorithm: :concurrently
+    remove_foreign_key :tickets, :groups
+    remove_column :tickets, :group_id
+  end
+end
