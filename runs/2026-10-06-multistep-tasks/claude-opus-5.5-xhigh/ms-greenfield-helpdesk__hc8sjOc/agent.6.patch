diff --git a/lib/record_id.rb b/lib/record_id.rb
new file mode 100644
index 0000000..23600b4
--- /dev/null
+++ b/lib/record_id.rb
@@ -0,0 +1,8 @@
+# A record's ID given in a request body: a JSON integer or a string of digits
+# ("12"). Anything else (1.5, "1.5", "", true, -1) isn't an ID.
+module RecordId
+  def self.parse(value)
+    text = value.is_a?(Integer) || value.is_a?(String) ? value.to_s.strip : ""
+    text.to_i if text.match?(/\A\d{1,18}\z/)
+  end
+end
diff --git a/test/integration/groups_test.rb b/test/integration/groups_test.rb
new file mode 100644
index 0000000..361125a
--- /dev/null
+++ b/test/integration/groups_test.rb
@@ -0,0 +1,362 @@
+require "test_helper"
+
+# Groups of staff (departments) and their memberships: /groups and
+# /group_memberships.
+class GroupsTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme = accounts(:acme)
+    @ari = users(:ari)
+    @sam = users(:sam)
+    @token = sign_in(users(:jo))
+  end
+
+  def create_group(name, token: @token)
+    api_post "/groups", { group: { name: name } }, token: token, account: "acme"
+  end
+
+  def add_member(group, user, default: nil, token: @token)
+    attributes = { group_id: group.id, user_id: user.id }
+    attributes[:default] = default unless default.nil?
+    api_post "/group_memberships", { group_membership: attributes }, token: token, account: "acme"
+  end
+
+  def memberships_of(user)
+    GroupMembership.where(user: user).order(:id).pluck(:group_id, :default)
+  end
+
+  # --- Groups -------------------------------------------------------------------
+
+  test "admins create, rename and delete groups" do
+    create_group "Billing"
+    assert_response :created
+    group = json["group"]
+    assert_equal %w[created_at id name updated_at], group.keys.sort
+    assert_equal "Billing", group["name"]
+    billing = @acme.groups.find(group["id"])
+
+    api_patch "/groups/#{billing.id}", { group: { name: "  Payments   and Billing " } }, token: @token, account: "acme"
+    assert_response :ok
+    assert_equal "Payments and Billing", json.dig("group", "name")
+    assert_equal "Payments and Billing", billing.reload.name
+
+    api_delete "/groups/#{billing.id}", token: @token, account: "acme"
+    assert_response :no_content
+    assert_not Group.exists?(billing.id)
+    api_get "/groups/#{billing.id}", token: @token, account: "acme"
+    assert_response :not_found
+  end
+
+  test "staff list groups by ID and show them; customers can't" do
+    support = @acme.groups.create!(name: "Technical Support")
+    billing = @acme.groups.create!(name: "Billing")
+    accounts(:globex).groups.create!(name: "Globex billing")
+
+    [ users(:jo), @ari ].each do |staff|
+      api_get "/groups", token: sign_in(staff), account: "acme"
+      assert_response :ok
+      assert_equal [ support.id, billing.id ], json["groups"].pluck("id")
+      assert_equal({ "count" => 2, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil },
+        json.except("groups"))
+    end
+
+    api_get "/groups/#{billing.id}", token: sign_in(@ari), account: "acme"
+    assert_response :ok
+    assert_equal({ "id" => billing.id, "name" => "Billing" }, json["group"].slice("id", "name"))
+
+    api_get "/groups?per_page=1&page=2", token: @token, account: "acme"
+    assert_equal [ billing.id ], json["groups"].pluck("id")
+
+    customer_token = sign_in(users(:avery))
+    api_get "/groups", token: customer_token, account: "acme"
+    assert_response :forbidden
+    assert_equal "staff_required", json.dig("error", "code")
+    api_get "/groups/#{billing.id}", token: customer_token, account: "acme"
+    assert_response :forbidden
+  end
+
+  test "only admins manage groups" do
+    billing = @acme.groups.create!(name: "Billing")
+    [ @ari, users(:avery) ].each do |user|
+      token = sign_in(user)
+      create_group "Sales", token: token
+      assert_response :forbidden
+      assert_equal "admin_required", json.dig("error", "code")
+      api_patch "/groups/#{billing.id}", { group: { name: "Payments" } }, token: token, account: "acme"
+      assert_response :forbidden
+      api_delete "/groups/#{billing.id}", token: token, account: "acme"
+      assert_response :forbidden
+    end
+    assert_equal [ "Billing" ], @acme.groups.pluck(:name)
+
+    api_get "/groups", account: "acme"
+    assert_response :unauthorized
+  end
+
+  test "group names are required and unique within a business, ignoring case" do
+    @acme.groups.create!(name: "Billing")
+    accounts(:globex).groups.create!(name: "Support")
+
+    { "" => "can't be blank", "   " => "can't be blank", nil => "can't be blank", "billing" => "has already been taken",
+      " BILLING " => "has already been taken", "x" * 101 => "is too long (maximum is 100 characters)" }.each do |name, message|
+      create_group name
+      assert_response :unprocessable_content, name.inspect
+      assert_equal "validation_failed", json.dig("error", "code")
+      assert_equal [ message ], json.dig("errors", "name"), name.inspect
+    end
+
+    # Another business may use the same name.
+    create_group "Support"
+    assert_response :created
+
+    support = @acme.groups.find(json.dig("group", "id"))
+    api_patch "/groups/#{support.id}", { group: { name: "BILLING" } }, token: @token, account: "acme"
+    assert_response :unprocessable_content
+    assert_equal "Support", support.reload.name
+    # Changing only the case of its own name is fine.
+    api_patch "/groups/#{support.id}", { group: { name: "SUPPORT" } }, token: @token, account: "acme"
+    assert_response :ok
+
+    api_post "/groups", {}, token: @token, account: "acme"
+    assert_response :bad_request
+  end
+
+  test "other businesses' groups are not found" do
+    group = accounts(:globex).groups.create!(name: "Globex")
+    api_get "/groups/#{group.id}", token: @token, account: "acme"
+    assert_response :not_found
+    api_patch "/groups/#{group.id}", { group: { name: "Mine" } }, token: @token, account: "acme"
+    assert_response :not_found
+    api_delete "/groups/#{group.id}", token: @token, account: "acme"
+    assert_response :not_found
+    assert_equal "Globex", group.reload.name
+  end
+
+  # --- Memberships ----------------------------------------------------------------
+
+  test "admins add staff to several groups, and the first membership is the default" do
+    billing = @acme.groups.create!(name: "Billing")
+    support = @acme.groups.create!(name: "Support")
+
+    add_member billing, @ari
+    assert_response :created
+    membership = json["group_membership"]
+    assert_equal %w[created_at default group group_id id updated_at user user_id], membership.keys.sort
+    assert_equal({ "group_id" => billing.id, "group" => { "id" => billing.id, "name" => "Billing" },
+      "user_id" => @ari.id, "user" => { "id" => @ari.id, "name" => "Ari" }, "default" => true },
+      membership.slice("group_id", "group", "user_id", "user", "default"))
+
+    add_member support, @ari
+    assert_response :created
+    assert_equal false, json.dig("group_membership", "default")
+    assert_equal [ [ billing.id, true ], [ support.id, false ] ], memberships_of(@ari)
+    assert_equal billing, @ari.reload.default_group
+
+    # Admins can be members too, and a first membership is the default even if
+    # it was asked not to be.
+    add_member support, @sam, default: false
+    assert_equal true, json.dig("group_membership", "default")
+  end
+
+  test "a membership created as the default replaces the previous default" do
+    billing = @acme.groups.create!(name: "Billing")
+    support = @acme.groups.create!(name: "Support")
+    add_member billing, @ari
+    add_member support, @ari, default: true
+    assert_response :created
+    assert_equal true, json.dig("group_membership", "default")
+    assert_equal [ [ billing.id, false ], [ support.id, true ] ], memberships_of(@ari)
+
+    add_member billing, @sam, default: "true"
+    assert_response :created
+  end
+
+  test "admins choose a staff member's default with make_default" do
+    billing = @acme.groups.create!(name: "Billing")
+    support = @acme.groups.create!(name: "Support")
+    add_member billing, @ari
+    add_member support, @ari
+    membership = GroupMembership.find(json.dig("group_membership", "id"))
+    add_member support, @sam
+    sams = memberships_of(@sam)
+
+    api_put "/group_memberships/#{membership.id}/make_default", nil, token: @token, account: "acme"
+    assert_response :ok
+    assert_equal({ "id" => membership.id, "default" => true }, json["group_membership"].slice("id", "default"))
+    assert_equal [ [ billing.id, false ], [ support.id, true ] ], memberships_of(@ari)
+    assert_equal sams, memberships_of(@sam), "other staff keep their defaults"
+
+    # Again changes nothing.
+    api_put "/group_memberships/#{membership.id}/make_default", nil, token: @token, account: "acme"
+    assert_response :ok
+    assert_equal [ [ billing.id, false ], [ support.id, true ] ], memberships_of(@ari)
+
+    api_put "/group_memberships/#{membership.id}/make_default", nil, token: sign_in(@ari), account: "acme"
+    assert_response :forbidden
+    assert_equal "admin_required", json.dig("error", "code")
+  end
+
+  test "removing the default membership makes another remaining one the default" do
+    billing = @acme.groups.create!(name: "Billing")
+    support = @acme.groups.create!(name: "Support")
+    sales = @acme.groups.create!(name: "Sales")
+    [ billing, support, sales ].each { |group| add_member group, @ari }
+    first = @ari.group_memberships.find_by!(group: billing)
+
+    api_delete "/group_memberships/#{first.id}", token: @token, account: "acme"
+    assert_response :no_content
+    assert_equal [ [ support.id, true ], [ sales.id, false ] ], memberships_of(@ari)
+
+    # Removing one that isn't the default leaves the default alone.
+    api_delete "/group_memberships/#{@ari.group_memberships.find_by!(group: sales).id}", token: @token, account: "acme"
+    assert_equal [ [ support.id, true ] ], memberships_of(@ari)
+
+    api_delete "/group_memberships/#{@ari.group_memberships.sole.id}", token: @token, account: "acme"
+    assert_response :no_content
+    assert_empty memberships_of(@ari)
+    assert_nil @ari.reload.default_group
+  end
+
+  test "deleting a group removes its memberships, and its members get another default" do
+    billing = @acme.groups.create!(name: "Billing")
+    support = @acme.groups.create!(name: "Support")
+    add_member billing, @ari
+    add_member support, @ari
+    add_member support, @sam
+    add_member billing, @sam, default: true
+
+    api_delete "/groups/#{billing.id}", token: @token, account: "acme"
+    assert_response :no_content
+    assert_equal [ [ support.id, true ] ], memberships_of(@ari)
+    assert_equal [ [ support.id, true ] ], memberships_of(@sam)
+    assert_empty GroupMembership.where(group_id: billing.id)
+  end
+
+  test "staff list memberships by ID, filtered by group and user" do
+    billing = @acme.groups.create!(name: "Billing")
+    support = @acme.groups.create!(name: "Support")
+    add_member billing, @ari
+    add_member support, @ari
+    add_member billing, @sam
+    ids = GroupMembership.order(:id).ids
+    globex = accounts(:globex).groups.create!(name: "Globex")
+    GroupMembership.create!(group: globex, user: users(:globex_jo))
+
+    agent_token = sign_in(@ari)
+    { "" => ids, "group_id=#{billing.id}" => [ ids[0], ids[2] ], "user_id=#{@ari.id}" => ids[0, 2],
+      "group_id=#{support.id}&user_id=#{@ari.id}" => [ ids[1] ], "user_id=#{@sam.id}" => [ ids[2] ],
