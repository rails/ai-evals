+module Api
+  module V1
+    # Groups of staff, such as departments (Billing, Technical Support). Any
+    # staff member may browse them; only admins create, rename and delete
+    # them. Groups organize work: they don't hide tickets from other staff.
+    class GroupsController < BaseController
+      include Pagination
+
+      before_action :require_staff!, only: %i[index show]
+      before_action :require_admin!, except: %i[index show]
+      before_action :set_group, only: %i[show update destroy]
+
+      # GET /api/v1/groups
+      def index
+        render_page Current.account.groups.order(:id), key: :groups, serializer: GroupSerializer
+      end
+
+      # GET /api/v1/groups/:id
+      def show
+        render json: { group: GroupSerializer.new(@group) }
+      end
+
+      # POST /api/v1/groups  {"group": {"name": "Billing"}}
+      def create
+        group = Current.account.groups.new(name: group_params[:name])
+
+        if group.save
+          render json: { group: GroupSerializer.new(group) }, status: :created
+        else
+          render_validation_errors group.errors
+        end
+      end
+
+      # PATCH /api/v1/groups/:id  {"group": {"name": "Payments"}}
+      # Renames the group; nothing else about it can be changed.
+      def update
+        if @group.update(name: group_params[:name])
+          render json: { group: GroupSerializer.new(@group) }
+        else
+          render_validation_errors @group.errors
+        end
+      end
+
+      # DELETE /api/v1/groups/:id
+      # Removes the group's memberships, and ungroups and unassigns its
+      # tickets (see Group).
+      def destroy
+        @group.destroy!
+        head :no_content
+      end
+
+      private
+        def set_group
+          @group = Current.account.groups.find(params[:id])
+        end
+
+        def group_params
+          params.expect(group: [ :name ])
+        end
+    end
+  end
+end
