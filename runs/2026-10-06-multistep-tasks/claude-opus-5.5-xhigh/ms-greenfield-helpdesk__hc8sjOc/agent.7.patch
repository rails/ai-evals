+    api_post "/tickets/0/merge", { merge: { target_id: @target.id } }, token: @token, account: "acme"
+    assert_response :not_found
+
+    api_post "/tickets/#{@source.id}/merge", { merge: { target_id: @target.id } }, account: "acme"
+    assert_response :unauthorized
+    assert @source.reload.open?
+  end
+
+  test "the envelope is required" do
+    api_post "/tickets/#{@source.id}/merge", { target_id: @target.id }, token: @token, account: "acme"
