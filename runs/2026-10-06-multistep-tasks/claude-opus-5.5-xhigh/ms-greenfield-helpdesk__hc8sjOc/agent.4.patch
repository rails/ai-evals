diff --git a/test/integration/ticket_filters_test.rb b/test/integration/ticket_filters_test.rb
new file mode 100644
index 0000000..6ce060b
--- /dev/null
+++ b/test/integration/ticket_filters_test.rb
@@ -0,0 +1,219 @@
+require "test_helper"
+
+# Narrowing the staff inbox (GET /tickets) and the customer's own list
+# (GET /requests) with query parameters.
+class TicketFiltersTest < ActionDispatch::IntegrationTest
+  setup do
+    @avery = users(:avery)
+    @blake = users(:blake)
+    @ari = users(:ari)
+    @token = sign_in(users(:jo))
+  end
+
+  def ticket_ids(query)
+    api_get "/tickets?#{query}", token: @token, account: "acme"
+    assert_response :ok, query
+    json["tickets"].pluck("id")
+  end
+
+  test "the example from the inbox: open, unassigned, high priority, mentioning a receipt" do
+    match = travel_to(3.hours.ago) { open_request(@avery, subject: "Where is my RECEIPT?") }
+    match.update!(priority: "high")
+    # Each of these fails exactly one of the filters.
+    travel_to(2.hours.ago) { open_request(@avery, subject: "Receipt missing") }.update!(priority: "high", status: "pending")
+    travel_to(2.hours.ago) { open_request(@avery, subject: "Receipt again") }.update!(priority: "high", assignee: @ari)
+    travel_to(2.hours.ago) { open_request(@avery, subject: "Receipt, normal") }
+    travel_to(2.hours.ago) { open_request(@avery, subject: "Login trouble") }.update!(priority: "high")
+    open_request(users(:globex_avery), subject: "Receipt").update!(priority: "high")
+
+    api_get "/tickets?status=open&assignee_id=unassigned&priority=high&q=receipt", token: @token, account: "acme"
+    assert_response :ok
+    assert_equal [ match.id ], json["tickets"].pluck("id")
+    assert_equal({ "count" => 1, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil }, json.except("tickets"))
+    assert_equal [ "high", "open", nil ], json["tickets"].first.values_at("priority", "status", "assignee_id")
+  end
+
+  test "filters by status" do
+    open_ticket = open_request(@avery)
+    pending = open_request(@avery).tap { |t| t.update!(status: "pending") }
+    solved = open_request(@blake).tap { |t| t.update!(status: "solved") }
+
+    assert_equal [ open_ticket.id ], ticket_ids("status=open")
+    assert_equal [ pending.id ], ticket_ids("status=pending")
+    assert_equal [ solved.id ], ticket_ids("status=SOLVED")
+  end
+
+  test "filters by priority" do
+    normal = travel_to(1.hour.ago) { open_request(@avery) }
+    high = open_request(@avery).tap { |t| t.update!(priority: "high") }
+
+    assert_equal [ high.id ], ticket_ids("priority=high")
+    assert_equal [ normal.id ], ticket_ids("priority=normal")
+    assert_equal [ high.id, normal.id ], ticket_ids("priority=")
+  end
+
+  test "filters by assignee, or for tickets nobody is assigned" do
+    aris = travel_to(3.hours.ago) { open_request(@avery) }.tap { |t| t.update!(assignee: @ari) }
+    sams = travel_to(2.hours.ago) { open_request(@avery) }.tap { |t| t.update!(assignee: users(:sam)) }
+    nobodys = travel_to(1.hour.ago) { open_request(@blake) }
+
+    assert_equal [ aris.id ], ticket_ids("assignee_id=#{@ari.id}")
+    assert_equal [ sams.id ], ticket_ids("assignee_id=#{users(:sam).id}")
+    assert_equal [ nobodys.id ], ticket_ids("assignee_id=unassigned")
+    assert_equal [ nobodys.id ], ticket_ids("assignee_id=Unassigned")
+    assert_equal [ aris.id ], ticket_ids("assignee_id=%20#{@ari.id}%20")
+
+    # People without tickets here, including other businesses' staff: nothing.
+    assert_equal [], ticket_ids("assignee_id=#{users(:unverified).id}")
+    assert_equal [], ticket_ids("assignee_id=#{users(:globex_jo).id}")
+    assert_equal [], ticket_ids("assignee_id=999999999")
+    assert_equal [], ticket_ids("assignee_id=99999999999999999999999")
+  end
+
+  test "filters by requester" do
+    averys = travel_to(1.hour.ago) { open_request(@avery) }
+    blakes = open_request(@blake)
+    open_request(users(:globex_avery))
+
+    assert_equal [ averys.id ], ticket_ids("requester_id=#{@avery.id}")
+    assert_equal [ blakes.id ], ticket_ids("requester_id=#{@blake.id}")
+    assert_equal [], ticket_ids("requester_id=#{users(:globex_avery).id}")
+    assert_equal [ blakes.id ], ticket_ids("requester_id=#{@blake.id}&assignee_id=unassigned&status=open&priority=normal")
+  end
+
+  test "q searches subjects and public comments, ignoring case" do
+    by_subject = travel_to(4.hours.ago) { open_request(@avery, subject: "Download a RECEIPT", body: "Hi") }
+    by_first_comment = travel_to(3.hours.ago) { open_request(@avery, subject: "Billing", body: "Where's my receipt?") }
+    by_reply = travel_to(2.hours.ago) { open_request(@blake, subject: "Question", body: "Hello") }
+    TicketUpdate.new(ticket: by_reply, author: @ari, comment: { body: "I've emailed the Receipt." }).save!
+    travel_to(1.hour.ago) { open_request(@blake, subject: "Login", body: "Can't sign in") }
+    open_request(users(:globex_avery), subject: "Receipt")
+
+    assert_equal [ by_reply.id, by_first_comment.id, by_subject.id ], ticket_ids("q=receipt")
+    assert_equal [ by_reply.id, by_first_comment.id, by_subject.id ], ticket_ids("q=rEcEiPt")
+    assert_equal [ by_first_comment.id ], ticket_ids("q=where's+my")
+    assert_equal [ by_reply.id ], ticket_ids("q=receipt&requester_id=#{@blake.id}")
+  end
+
+  test "q finds non-ASCII text regardless of case" do
+    ticket = open_request(@avery, subject: "ÄRGER mit der Quittung")
+    assert_equal [ ticket.id ], ticket_ids("q=#{CGI.escape("ärger")}")
+  end
+
+  test "q doesn't search internal notes" do
+    ticket = open_request(@avery, subject: "Billing", body: "Charged twice")
+    TicketUpdate.new(ticket: ticket, author: @ari, comment: { body: "Secret refund code", public: false }).save!
+
+    assert_equal [], ticket_ids("q=secret")
+    assert_equal [ ticket.id ], ticket_ids("q=twice")
+  end
+
+  test "a ticket with several matching comments is listed and counted once" do
+    ticket = open_request(@avery, subject: "Receipt", body: "receipt receipt")
+    TicketUpdate.new(ticket: ticket, author: @ari, comment: { body: "Your receipt." }).save!
+    TicketUpdate.new(ticket: ticket, author: @avery, comment: { body: "Thanks for the receipt!" }).save!
+
+    assert_equal [ ticket.id ], ticket_ids("q=receipt")
+    assert_equal 1, json["count"]
+  end
+
+  test "q is literal text: wildcards, backslashes and quotes match only themselves" do
+    percent = open_request(@avery, subject: "Is the 100% discount real?")
+    underscore = open_request(@avery, subject: "Error code E_42")
+    backslash = open_request(@avery, subject: 'Path C:\Users\avery')
+    quote = open_request(@avery, subject: "O'Brien's order")
+    open_request(@avery, subject: "1000 discount, E142, C:Usersavery, OBriens")
+
+    assert_equal [ percent.id ], ticket_ids("q=#{CGI.escape("0%")}")
+    assert_equal [ percent.id ], ticket_ids("q=%25")
+    assert_equal [ underscore.id ], ticket_ids("q=_")
+    assert_equal [ underscore.id ], ticket_ids("q=#{CGI.escape("E_4")}")
+    assert_equal [ backslash.id ], ticket_ids("q=#{CGI.escape('C:\Users')}")
+    assert_equal [ quote.id ], ticket_ids("q=#{CGI.escape("O'Brien")}")
+    assert_equal [], ticket_ids("q=#{CGI.escape("discount real?')) OR 1=1 --")}")
+  end
+
+  test "q is trimmed, and a blank q is no filter" do
+    ticket = open_request(@avery, subject: "Receipt")
+    other = travel_to(1.hour.ago) { open_request(@avery, subject: "Login") }
+
+    assert_equal [ ticket.id ], ticket_ids("q=%20%20receipt%20")
+    assert_equal [ ticket.id, other.id ], ticket_ids("q=")
+    assert_equal [ ticket.id, other.id ], ticket_ids("q=%20%20")
+  end
+
+  test "blank filters are ignored" do
+    ticket = open_request(@avery)
+    assert_equal [ ticket.id ], ticket_ids("status=&priority=&assignee_id=&requester_id=&q=")
+  end
+
+  test "unknown or malformed filter values are bad requests" do
+    [ "status=closed", "status[]=open", "priority=urgent", "priority=1", "priority[]=high",
+      "assignee_id=abc", "assignee_id=0", "assignee_id=-1", "assignee_id=1.5", "assignee_id=null",
+      "assignee_id=me", "assignee_id[]=1", "requester_id=unassigned", "requester_id=abc", "requester_id=0",
+      "q[]=receipt", "q[a]=b", "q=a%00b" ].each do |query|
+      api_get "/tickets?#{query}", token: @token, account: "acme"
+      assert_response :bad_request, query
+      assert_equal "bad_request", json.dig("error", "code"), query
+      assert_match(/\A#{query[/\A[a-z_]+/]} /, json.dig("error", "message"), query)
+    end
+  end
+
+  test "filtered lists are paginated and counted after filtering" do
+    highs = 3.times.map { |i| travel_to((10 - i).hours.ago) { open_request(@avery, subject: "High #{i}") } }
+    highs.each { |t| t.update_columns(priority: "high") }
+    2.times { |i| travel_to((5 - i).hours.ago) { open_request(@avery, subject: "Normal #{i}") } }
+
+    api_get "/tickets?priority=high&per_page=2&page=2", token: @token, account: "acme"
+    assert_response :ok
+    assert_equal [ highs.first.id ], json["tickets"].pluck("id")
+    assert_equal({ "count" => 3, "page" => 2, "per_page" => 2, "next_page" => nil, "previous_page" => 1 }, json.except("tickets"))
+  end
+
+  # --- Customers ----------------------------------------------------------------
+
+  test "customers filter their own requests by status" do
+    open_one = travel_to(2.hours.ago) { open_request(@avery) }
+    solved = travel_to(1.hour.ago) { open_request(@avery) }
+    TicketUpdate.new(ticket: solved, author: @avery, status: "solved").save!
+    open_request(@blake)
+    customer_token = sign_in(@avery)
+
+    { "status=open" => [ open_one.id ], "status=solved" => [ solved.id ], "status=pending" => [],
+      "status=Solved" => [ solved.id ], "status=" => [ solved.id, open_one.id ] }.each do |query, expected|
+      api_get "/requests?#{query}", token: customer_token, account: "acme"
+      assert_response :ok, query
+      assert_equal expected, json["requests"].pluck("id"), query
+      assert_equal expected.size, json["count"], query
+    end
+
+    [ "status=closed", "status[]=open" ].each do |query|
+      api_get "/requests?#{query}", token: customer_token, account: "acme"
+      assert_response :bad_request, query
+      assert_equal "bad_request", json.dig("error", "code")
+    end
+  end
+
+  test "customers can't use the staff filters, so priority and others' requests stay hidden" do
+    normal = travel_to(2.hours.ago) { open_request(@avery, subject: "Normal") }
+    high = travel_to(1.hour.ago) { open_request(@avery, subject: "Urgent") }
+    high.update!(priority: "high", assignee: @ari)
+    TicketUpdate.new(ticket: normal, author: @ari, comment: { body: "secret note", public: false }).save!
+    open_request(@blake, subject: "Blake's receipt")
+    customer_token = sign_in(@avery)
+
+    [ "priority=high", "priority=bogus", "assignee_id=#{@ari.id}", "assignee_id=unassigned",
+      "requester_id=#{@blake.id}", "q=secret", "q=receipt" ].each do |query|
+      api_get "/requests?#{query}", token: customer_token, account: "acme"
+      assert_response :ok, query
+      assert_equal [ high.id, normal.id ], json["requests"].pluck("id"), query
+      assert_not_includes response.body, "priority", query
+    end
+  end
+
+  test "customers can't filter /tickets at all" do
+    api_get "/tickets?priority=high", token: sign_in(@avery), account: "acme"
+    assert_response :forbidden
+    assert_equal "staff_required", json.dig("error", "code")
+  end
+end
