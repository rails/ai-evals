--- /dev/null
+++ b/db/migrate/20250101000010_add_priority_to_tickets.rb
@@ -0,0 +1,9 @@
+# Staff mark tickets normal or high priority. Priority is internal: customers
+# never see it. Existing tickets become normal.
+class AddPriorityToTickets < ActiveRecord::Migration[8.1]
+  def change
+    # A constant default doesn't rewrite the table (PostgreSQL 11+).
+    add_column :tickets, :priority, :string, null: false, default: "normal"
+    add_check_constraint :tickets, "priority IN ('normal', 'high')", name: "tickets_priority_valid"
+  end
+end
