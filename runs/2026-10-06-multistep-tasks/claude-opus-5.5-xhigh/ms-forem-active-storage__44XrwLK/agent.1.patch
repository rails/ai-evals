diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
new file mode 100644
index 0000000..ef96288
--- /dev/null
+++ b/config/initializers/active_storage.rb
@@ -0,0 +1,13 @@
+# Active Storage serves the profile images of users and organizations (see ProfileImageStorage).
+#
+# Rails loads its routes after the ones of config/routes.rb, whose catch-all routes (e.g.
+# "/:slug_0/:slug_1/...") would then take them over: load them first instead.
+active_storage_routes = ActiveStorage::Engine.paths["config/routes.rb"].existent
+routes_paths = Rails.application.routes_reloader.paths
+routes_paths.replace((routes_paths & active_storage_routes) + (routes_paths - active_storage_routes))
+
+# Profile images are only uploaded through Forem itself, which runs them through the checks of
+# ProfileImageUploader: files are never uploaded directly to the storage.
+Rails.application.config.to_prepare do
+  ActiveStorage::DirectUploadsController.before_action { head :forbidden }
+end
