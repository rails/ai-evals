diff --git a/app/uploaders/legacy_profile_image_uploader.rb b/app/uploaders/legacy_profile_image_uploader.rb
new file mode 100644
index 0000000..9ad51f9
--- /dev/null
+++ b/app/uploaders/legacy_profile_image_uploader.rb
@@ -0,0 +1,8 @@
+# Serves the profile images of users and organizations uploaded before they moved to Active
+# Storage (see ProfileImageStorage). They stay where CarrierWave stored them, so their path must
+# not depend on the name this uploader is mounted as: it is what their URLs are made of.
+class LegacyProfileImageUploader < ProfileImageUploader
+  def store_dir
+    "uploads/#{model.class.to_s.underscore}/profile_image/#{model.id}"
+  end
+end
