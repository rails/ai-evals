+        expect(uploader.url)
+          .to eq("https://forem-bucket.s3.amazonaws.com/uploads/user/profile_image/#{user.id}/#{uploader.identifier}")
+        expect(copier.copy(User.find(user.id))).to eq(:copied)
+        expect(User.find(user.id).profile_image.download).to eq(File.binread(png_path))
