+<% content_for :title, "Import quiz" %>
+<%# The only text on this page containing "Import" is the button, so it is unambiguous. %>
+
+<div class="breadcrumbs"><%= back_link("All quizzes", moderate_root_path) %></div>
+<div class="page-head"><h1>New quiz from JSON</h1></div>
+
+<%= form_with model: @import, scope: :import, url: moderate_imports_path, method: :post, class: "card" do |form| %>
+  <% if @import.errors.any? %>
+    <div class="errors" role="alert">
+      <p class="errors__lead">Nothing was created. Fix the JSON and try again.</p>
+      <% @import.errors.full_messages.each do |message| %>
+        <p class="errors__item"><%= message %></p>
+      <% end %>
+    </div>
+  <% end %>
+
+  <div class="field">
+    <%= form.label :json, "Quiz JSON" %>
+    <%= form.text_area :json, class: "input input--code transfer__json", rows: 16, autofocus: true,
+          spellcheck: false, autocomplete: "off", autocapitalize: "off",
+          aria: { required: true, describedby: "import_json_hint" } %>
+    <span class="field-hint" id="import_json_hint">Paste the JSON from the Export page of a quiz, on this Quizzy or another one. It always creates a new quiz, even if one with the same title exists.</span>
+  </div>
+
+  <div class="buttons">
+    <%= form.button "Import", class: "btn btn--pink" %>
+    <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+  </div>
+<% end %>
