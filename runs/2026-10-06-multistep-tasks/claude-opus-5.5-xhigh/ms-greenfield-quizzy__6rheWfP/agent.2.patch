diff --git a/app/javascript/controllers/clipboard_controller.js b/app/javascript/controllers/clipboard_controller.js
new file mode 100644
index 0000000..addac80
--- /dev/null
+++ b/app/javascript/controllers/clipboard_controller.js
@@ -0,0 +1,50 @@
+import { Controller } from "@hotwired/stimulus"
+
+// "Copy JSON" on the export page.
+//
+// The Clipboard API only exists in secure contexts (HTTPS or localhost), and
+// Quizzy is usually served over plain HTTP on a venue's network. So when it is
+// missing or refused, the text is selected and copied with execCommand("copy");
+// if even that fails, the text stays selected for Ctrl+C / Cmd+C.
+export default class extends Controller {
+  static targets = [ "source", "status" ]
+
+  copy() {
+    const text = this.sourceTarget.textContent
+
+    Promise.resolve()
+      .then(() => this.write(text))
+      .catch(() => false)
+      .then((copied) => this.report(copied || this.copyBySelection()))
+      .catch((error) => console.error("Could not copy", error))
+  }
+
+  disconnect() {
+    clearTimeout(this.statusTimer)
+  }
+
+  write(text) {
+    if (!window.isSecureContext || !navigator.clipboard?.writeText) return Promise.resolve(false)
+    return navigator.clipboard.writeText(text).then(() => true)
+  }
+
+  copyBySelection() {
+    const range = document.createRange()
+    range.selectNodeContents(this.sourceTarget)
+    const selection = window.getSelection()
+    selection.removeAllRanges()
+    selection.addRange(range)
+
+    try {
+      return document.execCommand("copy")
+    } catch {
+      return false
+    }
+  }
+
+  report(copied) {
+    this.statusTarget.textContent = copied ? "Copied to the clipboard" : "Selected: press Ctrl+C (⌘C on a Mac) to copy"
+    clearTimeout(this.statusTimer)
+    this.statusTimer = setTimeout(() => { this.statusTarget.textContent = "" }, 4000)
+  }
+}
