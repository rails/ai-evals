new file mode 100644
index 0000000..5b0d510
--- /dev/null
+++ b/db/migrate/20261008085500_add_prizes.rb
@@ -0,0 +1,35 @@
+# Prizes: each quiz has a number of winners, answers remember how fast they
+# came (speed breaks ties between players with the same points), and players
+# can be marked as winners once the game is over.
+#
+# Careful with SQLite: changing or removing a column the Rails way rebuilds
+# the table, and dropping the old table cascade-deletes its children (every
+# answer, game, ...), because PRAGMA foreign_keys = OFF is ignored inside the
+# migration's transaction. So: only add_column on the way up (rounds.opened_at
+# stays nullable; Round always sets it), and SQLite's own DROP COLUMN, which
+# does not rebuild anything, on the way down.
+class AddPrizes < ActiveRecord::Migration[8.1]
+  COLUMNS = { quizzes: :winners_count, rounds: :opened_at, answers: :elapsed_us, players: :winner }.freeze
+
+  def up
+    add_column :quizzes, :winners_count, :integer, null: false, default: 3
+    # The moment the question opened (the start of every answer's time).
+    add_column :rounds, :opened_at, :datetime
+    # Microseconds from the round's opening to the player's last pick.
+    add_column :answers, :elapsed_us, :integer, null: false, default: 0
+    add_column :players, :winner, :boolean, null: false, default: false
+
+    execute "UPDATE rounds SET opened_at = created_at"
+    execute <<~SQL
+      UPDATE answers SET elapsed_us = MAX(0, CAST(ROUND(
+        (julianday(answers.updated_at) - julianday((SELECT rounds.created_at FROM rounds WHERE rounds.id = answers.round_id))) * 86400000000
+      ) AS INTEGER))
+    SQL
+  end
+
+  def down
+    COLUMNS.each do |table, column|
+      execute "ALTER TABLE #{quote_table_name(table)} DROP COLUMN #{quote_column_name(column)}"
+    end
+  end
+end
