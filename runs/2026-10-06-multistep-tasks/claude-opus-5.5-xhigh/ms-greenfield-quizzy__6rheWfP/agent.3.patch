+# The player's current stage as JSON ({ version, revision, html }), for phones
+# that cannot keep a live connection (play_controller.js polls it then) or
+# that just woke up. 204 when the phone already shows it.
+class Play::StagesController < Play::BaseController
+  before_action :require_player
+
+  def show
+    seen_over_http if params[:fallback].present?
+
+    if params[:version].present? && [ params[:version].to_i, params[:revision].to_i ] == [ stage.version, stage.revision ]
+      head :no_content
+    else
+      render json: stage_payload
+    end
+  end
+end
