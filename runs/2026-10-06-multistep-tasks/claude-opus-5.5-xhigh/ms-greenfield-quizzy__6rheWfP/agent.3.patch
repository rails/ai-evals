diff --git a/app/javascript/controllers/play_controller.js b/app/javascript/controllers/play_controller.js
new file mode 100644
index 0000000..fd2d948
--- /dev/null
+++ b/app/javascript/controllers/play_controller.js
@@ -0,0 +1,286 @@
+import { Controller } from "@hotwired/stimulus"
+import { cable } from "@hotwired/turbo-rails"
+
+// A player's phone (play/games/show). The server renders the stage (lobby,
+// question, results, end) and this controller keeps it live, on crowded
+// conference Wi-Fi too:
+//
+// - PlayChannel pushes every step of the game. Right after (re)connecting and
+//   then every SYNC_INTERVAL, the phone sends "sync" with the version it shows;
+//   the server answers only if it has something newer. Syncing is also the
+//   heartbeat that keeps the player counted on the big screen.
+// - Without a live connection (WebSockets blocked, Wi-Fi trouble), the phone
+//   polls the stage over HTTP instead, and stops as soon as the cable is back.
+// - Tapping an option marks it right away and posts it. Picks are sent one at
+//   a time, only the latest one is kept, and failed posts are retried while
+//   the question is still open. The server's reply (the stage with the saved
+//   pick) is what stays on screen.
+//
+// Every stage carries data-version (bumped by each step of the game) and
+// data-revision (bumped by each change of the player's pick); older stages
+// arriving late are ignored.
+const SYNC_INTERVAL = 10_000
+const POLL_INTERVAL = 3_000
+const CABLE_GRACE = 3_000
+const SLOW_SEND = 1_500
+
+export default class extends Controller {
+  static targets = [ "stage", "connection" ]
+  static values = { code: String, stageUrl: String, answerUrl: String }
+
+  connect() {
+    this.disconnected = false
+    this.away = false
+    this.pending = null
+    this.sending = false
+    this.cableConnected = false
+    this.schedulePoll(CABLE_GRACE)
+    this.subscribe()
+
+    this.onVisibilityChange = () => { if (document.visibilityState === "visible") this.refresh() }
+    this.onOnline = () => this.refresh()
+    this.onPageHide = () => this.leave()
+    this.onPageShow = (event) => { if (event.persisted) this.comeBack() }
+    document.addEventListener("visibilitychange", this.onVisibilityChange)
+    window.addEventListener("online", this.onOnline)
+    window.addEventListener("pagehide", this.onPageHide)
+    window.addEventListener("pageshow", this.onPageShow)
+  }
+
+  disconnect() {
+    this.disconnected = true
+    clearTimeout(this.pollTimer)
+    clearInterval(this.syncTimer)
+    clearTimeout(this.slowTimer)
+    this.subscription?.unsubscribe()
+    this.subscription = null
+    document.removeEventListener("visibilitychange", this.onVisibilityChange)
+    window.removeEventListener("online", this.onOnline)
+    window.removeEventListener("pagehide", this.onPageHide)
+    window.removeEventListener("pageshow", this.onPageShow)
+  }
+
+  // Leaving the page (closing it, going elsewhere) leaves the game at once: the
+  // browser may keep the page, and its WebSocket, alive in its back/forward
+  // cache. Coming back from that cache joins in again.
+  leave() {
+    this.away = true
+    clearTimeout(this.pollTimer)
+    clearInterval(this.syncTimer)
+    this.cableConnected = false
+    this.subscription?.unsubscribe()
+    this.subscription = null
+    this.consumer?.disconnect()
+  }
+
+  comeBack() {
+    this.away = false
+    this.consumer?.connect()
+    this.schedulePoll(CABLE_GRACE)
+    this.subscribe()
+    this.refresh()
+  }
+
+  // The stage shown now.
+
+  get stage() {
+    return this.stageTarget.firstElementChild
+  }
+
+  get version() {
+    return Number(this.stage?.dataset.version ?? -1)
+  }
+
+  get revision() {
+    return Number(this.stage?.dataset.revision ?? 0)
+  }
+
+  // Shows a stage from the server unless the one on screen is newer.
+  apply(payload) {
+    if (!payload || this.disconnected) return
+    if (payload.gone) return this.reload()
+
+    const { version, revision, html } = payload
+    if (version < this.version) return
+    if (version === this.version && revision <= this.revision && !this.pending) return
+    if (version === this.version && revision < this.revision) return
+
+    this.stageTarget.innerHTML = html
+
+    if (this.pending) {
+      if (this.pending.version === version) {
+        this.markPicked(this.pending.optionId) // not confirmed yet: keep showing the tap
+      } else {
+        this.pending = null // the question has moved on
+      }
+    }
+  }
+
+  // Live connection.
+
+  async subscribe() {
+    this.consumer = await cable.getConsumer()
+    const subscription = this.consumer.subscriptions.create({ channel: "PlayChannel", code: this.codeValue }, {
+      connected: () => this.cableConnectedChanged(true),
+      disconnected: () => this.cableConnectedChanged(false),
+      rejected: () => this.cableConnectedChanged(false), // polling finds out why (a 404 reloads the page)
+      received: (payload) => this.apply(payload)
+    })
+
+    if (this.disconnected || this.away) {
+      subscription.unsubscribe()
+    } else {
+      this.subscription = subscription
+    }
+  }
+
+  cableConnectedChanged(connected) {
+    this.cableConnected = connected
+    clearInterval(this.syncTimer)
+
+    if (connected) {
+      clearTimeout(this.pollTimer)
+      this.showProblem(null)
+      this.sync()
+      this.syncTimer = setInterval(() => this.sync(), SYNC_INTERVAL)
+    } else {
+      this.schedulePoll(1_000)
+    }
+  }
+
+  sync() {
+    this.subscription?.perform("sync", { version: this.version, revision: this.revision })
+  }
+
+  // Polling (only while the cable is down) and catching up after a phone wakes up.
+
+  schedulePoll(delay) {
+    clearTimeout(this.pollTimer)
+    this.pollTimer = setTimeout(() => this.poll({ fallback: true }), delay)
+  }
+
+  refresh() {
+    if (this.cableConnected) this.sync()
+    this.poll({ fallback: !this.cableConnected })
+  }
+
+  async poll({ fallback }) {
+    if (this.disconnected || this.away) return
+    if (fallback && this.cableConnected) return
+
+    const url = new URL(this.stageUrlValue, window.location.href)
+    url.searchParams.set("version", this.version)
+    url.searchParams.set("revision", this.revision)
+    if (fallback) url.searchParams.set("fallback", "1")
+
+    try {
+      const response = await fetch(url, { headers: { Accept: "application/json" }, credentials: "same-origin", cache: "no-store" })
+      if (response.status === 404) return this.reload()
+      if (response.ok && response.status !== 204) this.apply(await response.json())
+      if (response.ok) this.showProblem(null)
+    } catch (error) {
+      if (!this.cableConnected) this.showProblem("No connection. Trying again…")
+    }
+
+    if (fallback && !this.cableConnected) this.schedulePoll(POLL_INTERVAL)
+  }
+
+  // Picks.
+
+  pick(event) {
+    const form = event.target
+    if (!(form instanceof HTMLFormElement) || !this.stageTarget.contains(form)) return
+
+    event.preventDefault()
+    const button = form.querySelector("button")
+    const optionId = form.elements.option_id?.value
+    if (!optionId || button?.disabled) return
+
+    this.pending = { optionId, version: this.version }
+    this.markPicked(optionId)
+    this.send()
+  }
+
+  async send() {
+    if (this.sending) return
+    this.sending = true
+    let failures = 0
+
+    while (this.pending && !this.disconnected) {
+      const pick = this.pending
+      clearTimeout(this.slowTimer)
+      this.slowTimer = setTimeout(() => this.showProblem("Sending…"), SLOW_SEND)
+
+      try {
+        const response = await fetch(this.answerUrlValue, {
+          method: "POST",
+          credentials: "same-origin",
+          headers: { Accept: "application/json", "X-CSRF-Token": csrfToken() },
+          body: new URLSearchParams({ option_id: pick.optionId })
+        })
+
+        if (response.status === 404 || response.status === 422) return this.reload() // gone, or an outdated page
+        if (!response.ok && response.status !== 409) throw new Error(`HTTP ${response.status}`)
+
+        const payload = await response.json()
+        if (this.pending === pick) this.pending = null
+        this.apply(payload)
+        failures = 0
+        clearTimeout(this.slowTimer)
+        this.showProblem(null)
+      } catch (error) {
+        clearTimeout(this.slowTimer)
+        this.showProblem("Not sent yet. Trying again…")
+        await sleep(Math.min(1_000 * ++failures, 5_000))
+        if (this.pending && this.pending.version !== this.version) this.pending = null
+      }
+    }
+
+    this.sending = false
+    if (!this.pending) this.showProblem(null)
+  }
+
+  // Marks the tapped option the way the server renders a saved pick.
+  markPicked(optionId) {
+    this.stageTarget.querySelectorAll("form").forEach((form) => {
+      const button = form.querySelector("button.play-option")
+      if (!button) return
+
+      const picked = form.elements.option_id?.value === String(optionId)
+      button.classList.toggle("is-picked", picked)
+      button.setAttribute("aria-pressed", String(picked))
+
+      const mark = button.querySelector("[data-pick-mark]")
+      if (picked && !mark) {
+        const element = document.createElement("span")
+        element.className = "play-option__mark"
+        element.setAttribute("aria-hidden", "true")
+        element.dataset.pickMark = ""
+        element.textContent = "Your answer"
+        button.querySelector(".play-option__title")?.after(element)
+      } else if (!picked && mark) {
+        mark.remove()
+      }
+    })
+  }
+
+  showProblem(message) {
+    if (!this.hasConnectionTarget) return
+    this.connectionTarget.textContent = message ?? ""
+    this.connectionTarget.hidden = !message
+  }
+
+  reload() {
+    if (this.reloading) return
+    this.reloading = true
+    window.location.reload()
+  }
+}
+
+function csrfToken() {
+  return document.querySelector("meta[name=csrf-token]")?.content ?? ""
+}
+
+function sleep(milliseconds) {
+  return new Promise((resolve) => setTimeout(resolve, milliseconds))
+}
diff --git a/app/javascript/controllers/screen_controller.js b/app/javascript/controllers/screen_controller.js
new file mode 100644
index 0000000..30649b9
--- /dev/null
+++ b/app/javascript/controllers/screen_controller.js
@@ -0,0 +1,62 @@
+import { Controller } from "@hotwired/stimulus"
+
+// The big screen of a game (moderate/games/show). Polls the live numbers
+// once a second ("Players: 2", "Answers: 1 / 2") and, when the game was moved
+// on from somewhere else (a second screen), refreshes the page in place
+// (Turbo morphing). The moderator's own buttons re-render the page directly.
+//
+// The big screen is one or two browsers, so plain polling is cheap, needs no
+// WebSocket and catches up by itself after a network hiccup.
+const POLL_INTERVAL = 1_000
+const REFRESH_RETRY = 5_000
+
+export default class extends Controller {
+  static targets = [ "players", "answers" ]
+  static values = { countersUrl: String, version: Number }
+
+  connect() {
+    this.running = true
+    this.schedule(POLL_INTERVAL)
+  }
+
+  disconnect() {
+    this.running = false
+    clearTimeout(this.timer)
+  }
+
+  schedule(delay) {
+    clearTimeout(this.timer)
+    this.timer = setTimeout(() => this.poll(), delay)
+  }
+
+  async poll() {
+    try {
+      const response = await fetch(this.countersUrlValue, {
+        headers: { Accept: "application/json" }, credentials: "same-origin", cache: "no-store"
+      })
+      if (response.ok) this.update(await response.json())
+    } catch (error) {
+      // Offline for a moment: try again on the next tick.
+    }
+
+    if (this.running) this.schedule(POLL_INTERVAL)
+  }
+
+  update({ version, players, answers }) {
+    this.playersTargets.forEach((element) => { element.textContent = players })
+    this.answersTargets.forEach((element) => { element.textContent = answers })
+
+    if (version === this.versionValue) return
+
+    // One refresh at a time; try again if it has not landed after a while.
+    const now = Date.now()
+    if (this.refreshing && this.refreshing.version === version && now - this.refreshing.at < REFRESH_RETRY) return
+
+    this.refreshing = { version, at: now }
+    window.Turbo.visit(window.location.href, { action: "replace" })
+  }
+
+  versionValueChanged() {
+    this.refreshing = null
+  }
+}
