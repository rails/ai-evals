+# The join link. Asks for a name, or continues the game for a browser that
+# already joined. After the end, nobody can join any more.
+class Play::GamesController < Play::BaseController
+  def show
+    set_player
+
+    if @player
+      seen_over_http # counted right away, before the live connection is up
+      @stage = stage
+    elsif @game.ended?
+      render :over
+    else
+      @new_player = @game.players.new
+      render :join
+    end
+  end
+end
diff --git a/app/controllers/play/players_controller.rb b/app/controllers/play/players_controller.rb
