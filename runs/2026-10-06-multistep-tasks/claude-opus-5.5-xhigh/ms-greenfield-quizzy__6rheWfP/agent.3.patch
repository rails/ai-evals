diff --git a/app/views/play/_stage.html.erb b/app/views/play/_stage.html.erb
new file mode 100644
index 0000000..9bc40ae
--- /dev/null
+++ b/app/views/play/_stage.html.erb
@@ -0,0 +1,58 @@
+<%# A player's stage (Game::Stage): rendered for the play page, the live
+    connection, polling and answer replies. While a question is open, nothing
+    in here may tell which options are correct. %>
+<div class="play__body<%= " play__body--top" if stage.question? %>" data-version="<%= stage.version %>" data-revision="<%= stage.revision %>" data-phase="<%= stage.phase %>">
+  <% case stage.phase %>
+  <% when :lobby %>
+    <div class="waiting">
+      <div class="waiting__gem" aria-hidden="true">?</div>
+      <h1 class="play-title"><%= stage.game.quiz.title %></h1>
+      <p class="play-lead">You’re in! Keep this page open: the questions show up here.</p>
+    </div>
+  <% when :open, :closed %>
+    <% if stage.question? %>
+      <div class="play-question__num">Question <%= stage.position %> of <%= stage.total %></div>
+      <div class="play-question__body"><%= stage.question.text %></div>
+
+      <ul class="play-options<%= " is-locked is-revealed" if stage.revealed? %>">
+        <% stage.options.each_with_index do |option, index| %>
+          <% picked = stage.picked?(option) %>
+          <li class="play-options__item">
+            <%= form_with url: play_answer_path(stage.game.code), method: :post, data: { turbo: false } do %>
+              <%= hidden_field_tag :option_id, option.id, id: nil %>
+              <%= tag.button type: "submit", disabled: stage.phase == :closed, aria: { pressed: picked },
+                    class: [ "play-option", ("is-picked" if picked), ("is-correct" if stage.correct?(option)) ] do %>
+                <span class="play-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+                <span class="play-option__title"><%= option.text %></span>
+                <% if picked %><span class="play-option__mark" data-pick-mark aria-hidden="true">Your answer</span><% end %>
+                <% if stage.correct?(option) %><span class="play-option__mark" aria-hidden="true">✓</span><% end %>
+              <% end %>
+            <% end %>
+          </li>
+        <% end %>
+      </ul>
+
+      <% if stage.revealed? %>
+        <% css, text = { right: [ "right", "Correct!" ], wrong: [ "wrong", "Wrong!" ], none: [ "neutral", "No answer" ] }.fetch(stage.result) %>
+        <div class="play-status play-status--<%= css %>" role="status"><%= text %></div>
+        <p class="play-hint">Eyes on the big screen for what comes next.</p>
+      <% else %>
+        <p class="play-hint">Tap an option. You can change it until the question closes.</p>
+      <% end %>
+    <% else %>
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <p class="play-lead">Hang on, the quiz goes on in a moment.</p>
+      </div>
+    <% end %>
+  <% when :ended %>
+    <div class="waiting">
+      <h1 class="play-title">The quiz is over</h1>
+      <% if stage.rounds_count.to_i.positive? && stage.score %>
+        <p class="play-lead">You got <%= stage.score %> of <%= stage.rounds_count %> right. Thanks for playing!</p>
+      <% else %>
+        <p class="play-lead">Thanks for playing!</p>
+      <% end %>
+    </div>
+  <% end %>
+</div>
