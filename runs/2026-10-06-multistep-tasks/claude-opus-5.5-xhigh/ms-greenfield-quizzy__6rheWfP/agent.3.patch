+++ b/test/models/presence_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class PresenceTest < ActiveSupport::TestCase
+  setup { Presence.reset }
+  teardown { Presence.reset }
+
+  test "counts distinct players until they leave or stop showing up" do
+    Presence.touch(1, 10, "cable:a", ttl: 30.seconds)
+    Presence.touch(1, 10, "cable:b", ttl: 30.seconds) # a second tab
+    Presence.touch(1, 11, Presence.poll_key(11), ttl: 12.seconds)
+    Presence.touch(2, 12, "cable:c", ttl: 30.seconds)
+    assert_equal 2, Presence.count(1)
+
+    Presence.leave(1, "cable:a")
+    assert_equal 2, Presence.count(1)
+
+    travel 13.seconds do
+      assert_equal 1, Presence.count(1)
+    end
+
+    Presence.leave(1, "cable:b")
+    Presence.leave(1, Presence.poll_key(11))
+    assert_equal 0, Presence.count(1)
+    assert_equal 1, Presence.count(2)
+    assert_equal 0, Presence.count(3)
+  end
+end
