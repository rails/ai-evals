diff --git a/lib/tasks/assets.rake b/lib/tasks/assets.rake
new file mode 100644
index 0000000..329e551
--- /dev/null
+++ b/lib/tasks/assets.rake
@@ -0,0 +1,26 @@
+namespace :assets do
+  # Phones on crowded conference Wi-Fi: ActionDispatch::Static serves "x.js.gz"
+  # in place of "x.js" to browsers that accept gzip, so the compiled scripts and
+  # stylesheets travel at about a third of their size, with no work per request.
+  desc "Write gzip copies of the compiled text assets (run after assets:precompile and assets:clean)"
+  task compress: :environment do
+    require "zlib"
+    output = Pathname(Rails.application.config.assets.output_path)
+    next unless output.directory?
+
+    # Copies of files that assets:clean removed.
+    Dir.glob(output.join("**/*.gz").to_s).each do |copy|
+      File.delete(copy) unless File.exist?(copy.delete_suffix(".gz"))
+    end
+
+    Dir.glob(output.join("**/*.{js,css,svg}").to_s).each do |file|
+      copy = "#{file}.gz"
+      next if File.exist?(copy) && File.mtime(copy) >= File.mtime(file)
+
+      Zlib::GzipWriter.open(copy, Zlib::BEST_COMPRESSION) do |gzip|
+        gzip.mtime = File.mtime(file)
+        gzip.write(File.binread(file))
+      end
+    end
+  end
+end
diff --git a/script/load_test.rb b/script/load_test.rb
new file mode 100644
index 0000000..5f92441
--- /dev/null
+++ b/script/load_test.rb
@@ -0,0 +1,145 @@
+# Plays one game against a running Quizzy with N simulated phones and reports
+# how long the steps take to reach them (see docs/architecture.md, Verifying).
+#
+#   N=300 QUIZZY_MODERATOR_USERNAME=mod QUIZZY_MODERATOR_PASSWORD=secret \
+#     bundle exec ruby script/load_test.rb
+#
+# Each phone joins over HTTP and opens a real Action Cable WebSocket (via the
+# websocket-driver gem that Action Cable uses), like play_controller.js does.
+# It creates a quiz named "Load test ..." in the target's database. For more
+# than ~1000 phones, raise this shell's open files limit (ulimit -n).
+require "bundler/setup"
+require "json"
+require "net/http"
+require "socket"
+require "uri"
+require "websocket/driver"
+
+HOST = ENV.fetch("HOST", "localhost")
+PORT = Integer(ENV.fetch("PORT", 3000))
+PHONES = Integer(ENV.fetch("N", 200))
+MODERATOR = [ ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "moderator") ]
+
+def request(method, path, cookies:, form: nil, moderator: false, headers: {})
+  request = (method == :get ? Net::HTTP::Get : Net::HTTP::Post).new(path)
+  request["Cookie"] = cookies.map { |name, value| "#{name}=#{value}" }.join("; ") if cookies.any?
+  request.basic_auth(*MODERATOR) if moderator
+  headers.each { |name, value| request[name] = value }
+  request.set_form_data(form) if form
+  response = Net::HTTP.start(HOST, PORT) { |http| http.request(request) }
+  Array(response.get_fields("set-cookie")).each do |cookie|
+    name, value = cookie.split(";").first.split("=", 2)
+    cookies[name] = value
+  end
+  response
+end
+
+def form_token(html, action = nil)
+  html = html[/action="#{Regexp.escape(action)}".*/m] if action
+  html[/name="authenticity_token" value="([^"]+)"/, 1]
+end
+
+def moderate(method, path, form = {})
+  @moderator_cookies ||= {}
+  if method == :post
+    page = request(:get, form.delete(:page), cookies: @moderator_cookies, moderator: true).body
+    form["authenticity_token"] = form_token(page, path)
+  end
+  request(method, path, cookies: @moderator_cookies, moderator: true, form: (form if method == :post))
+end
+
+def elapsed(started)
+  Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
+end
+
+def now
+  Process.clock_gettime(Process::CLOCK_MONOTONIC)
+end
+
+# The moderator's quiz (one question, "A" is correct) and game.
+quiz_path = URI(moderate(:post, "/moderate/quizzes", page: "/moderate/quizzes/new", "quiz[title]" => "Load test #{Time.now.to_i}")["location"]).path
+moderate(:post, "#{quiz_path}/questions", page: "#{quiz_path}/questions/new", "question[text]" => "Load?", "question[active]" => "1",
+  "question[options][0][text]" => "A", "question[options][0][correct]" => "1",
+  "question[options][1][text]" => "B", "question[options][1][correct]" => "0")
+game_path = URI(moderate(:post, "#{quiz_path}/games", page: quiz_path)["location"]).path
+code = moderate(:get, game_path).body[%r{/play/([A-Z0-9]{5})}, 1]
+puts "Game #{code} (#{game_path}), #{PHONES} phones"
+
+started = now
+phones = Array.new(PHONES) do |index|
+  cookies = {}
+  token = form_token(request(:get, "/play/#{code}", cookies: cookies).body)
+  request(:post, "/play/#{code}/player", cookies: cookies, form: { "authenticity_token" => token, "player[name]" => "Phone #{index}" })
+  page = request(:get, "/play/#{code}", cookies: cookies).body
+  { cookies: cookies, csrf: page[/name="csrf-token" content="([^"]+)"/, 1], received: [] }
+end
+puts format("Joined over HTTP:      %5.2fs (%.1f ms per phone, one after the other)", elapsed(started), elapsed(started) * 1000 / PHONES)
+
+CableSocket = Struct.new(:url, :io) do
+  def write(data) = io.write(data)
+end
+
+identifier = { channel: "PlayChannel", code: code }.to_json
+drivers = {}
+phones.each do |phone|
+  io = TCPSocket.new(HOST, PORT)
+  driver = WebSocket::Driver.client(CableSocket.new("ws://#{HOST}:#{PORT}/cable", io), protocols: [ "actioncable-v1-json" ])
+  driver.set_header("Cookie", phone[:cookies].map { |name, value| "#{name}=#{value}" }.join("; "))
+  driver.set_header("Origin", "http://#{HOST}:#{PORT}")
+  driver.on(:open) { driver.text({ command: "subscribe", identifier: identifier }.to_json) }
+  driver.on(:message) do |event|
+    message = JSON.parse(event.data)
+    if message["type"] == "confirm_subscription"
+      driver.text({ command: "message", identifier: identifier, data: { action: "sync", version: 0, revision: 0 }.to_json }.to_json)
+    elsif message["type"].nil? && (payload = message["message"]).is_a?(Hash) # not a ping
+      phone[:received] << [ now, payload["version"], payload["html"].to_s[/play-status--(\w+)/, 1] ]
+    end
+  end
+  driver.start
+  drivers[io] = driver
+end
+Thread.new do
+  loop do
+    ready, = IO.select(drivers.keys, nil, nil, 1)
+    Array(ready).each do |io|
+      drivers[io].parse(io.read_nonblock(65_536))
+    rescue IO::WaitReadable
+    rescue EOFError, Errno::ECONNRESET
+      drivers.delete(io)
+    end
+  end
+end
+sleep 3
+puts "Big screen counters:   #{JSON.parse(moderate(:get, "#{game_path}/counters").body)}"
+
+def step(game_path, phones, name)
+  page = moderate(:get, game_path).body
+  version = page[/name="version" value="(\d+)"/, 1].to_i
+  started = now
+  moderate(:post, "#{game_path}/step", page: game_path, "step" => name, "version" => version.to_s)
+  deadline = now + 20
+  sleep 0.02 until now > deadline || phones.all? { |phone| phone[:received].any? { |(_, v)| v == version + 1 } }
+  arrivals = phones.filter_map { |phone| phone[:received].find { |(_, v)| v == version + 1 } }
+  results = arrivals.filter_map(&:last).tally
+  puts format("%-22s %d/%d phones, the last after %.2fs %s", "#{name.capitalize}:", arrivals.size, phones.size,
+    arrivals.map { |(time, _)| time - started }.max.to_f, results.any? ? results.inspect : "")
+end
+
+step(game_path, phones, "start")
+
+option_ids = request(:get, "/play/#{code}", cookies: phones.first[:cookies]).body.scan(/name="option_id" value="(\d+)"/).flatten
+started = now
+phones.each_slice((PHONES / 10.0).ceil).map do |slice|
+  Thread.new do
+    slice.each_with_index do |phone, index|
+      response = request(:post, "/play/#{code}/answer", cookies: phone[:cookies], form: { "option_id" => option_ids[index % 2] },
+        headers: { "X-CSRF-Token" => phone[:csrf], "Accept" => "application/json" })
+      warn "Answer refused: #{response.code}" unless response.code == "200"
+    end
+  end
+end.each(&:join)
+puts format("Answered:              %5.2fs (10 phones at a time)", elapsed(started))
+puts "Big screen counters:   #{JSON.parse(moderate(:get, "#{game_path}/counters").body)}"
+
+step(game_path, phones, "finish")
+step(game_path, phones, "end")
diff --git a/test/channels/play_channel_test.rb b/test/channels/play_channel_test.rb
new file mode 100644
index 0000000..b8de29b
--- /dev/null
+++ b/test/channels/play_channel_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class PlayChannelTest < ActionCable::Channel::TestCase
+  setup do
+    Presence.reset
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    @question = create_question(quiz, "Which status code means Too Many Requests?", { "418" => false, "429" => true })
+    @game = quiz.games.create!
+    @alice = @game.players.create!(name: "Alice", browser_token: "alice-token")
+    @wrong, @right = @question.options
+  end
+
+  def step(name)
+    @game.reload.take_step(name, seen_version: @game.version)
+  end
+
+  test "rejects browsers that have not joined the game" do
+    stub_connection browser_token: nil
+    subscribe code: @game.code
+    assert subscription.rejected?
+
+    stub_connection browser_token: "someone-else"
+    subscribe code: @game.code
+    assert subscription.rejected?
+  end
+
+  test "streams the game and counts the player while subscribed" do
+    stub_connection browser_token: "alice-token"
+    subscribe code: @game.code.downcase
+
+    assert subscription.confirmed?
+    assert_has_stream_for @game
+    assert_equal 1, Presence.count(@game.id)
+
+    unsubscribe
+    assert_equal 0, Presence.count(@game.id)
+  end
+
+  test "sync transmits the stage only when the phone is behind" do
+    stub_connection browser_token: "alice-token"
+    subscribe code: @game.code
+
+    perform :sync, version: 0, revision: 0
+    assert_empty transmissions
+
+    step("start")
+    perform :sync, version: 0, revision: 0
+    assert_equal 1, transmissions.last["version"]
+    assert_match @question.text, transmissions.last["html"]
+    assert_no_match(/correct/i, transmissions.last["html"])
+  end
+
+  test "broadcasts render each variant once; subscriptions pick the player's" do
+    stub_connection browser_token: "alice-token"
+    subscribe code: @game.code
+    step("start")
+    @game.current_round.record_answer(@alice, @right.id)
+
+    assert_broadcasts(PlayChannel.broadcasting_for(@game), 1) { step("finish") }
+    message = ActiveSupport::JSON.decode(broadcasts(PlayChannel.broadcasting_for(@game)).last)
+    assert_equal [ "", @wrong.id.to_s, @right.id.to_s ], message["variants"].keys
+
+    subscription.send(:deliver, message)
+    assert_equal [ 2, 1 ], transmissions.last.values_at("version", "revision")
+    assert_match "Correct!", transmissions.last["html"]
+  end
+
+  test "tells the phone when the player is gone" do
+    stub_connection browser_token: "alice-token"
+    subscribe code: @game.code
+    @alice.destroy!
+
+    perform :sync, version: 0, revision: 0
+    assert_equal({ "gone" => true }, transmissions.last)
+  end
+end
diff --git a/test/integration/moderate_games_test.rb b/test/integration/moderate_games_test.rb
new file mode 100644
index 0000000..1ce8a3b
--- /dev/null
+++ b/test/integration/moderate_games_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class ModerateGamesTest < ActionDispatch::IntegrationTest
+  setup do
+    Presence.reset
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+    @question = create_question(@quiz, "Which status code means Too Many Requests?", { "418" => false, "429" => true })
+    create_question(@quiz, "Which protocol?", { "WebSocket" => true, "SMTP" => false })
+  end
+
+  test "everything about games requires the moderator" do
+    game = @quiz.games.create!
+    post "/moderate/quizzes/#{@quiz.id}/games"
+    assert_response :unauthorized
+    [ "/moderate/games/#{game.id}", "/moderate/games/#{game.id}/counters" ].each do |path|
+      get path
+      assert_response :unauthorized
+    end
+    post "/moderate/games/#{game.id}/step", params: { step: "start", version: 0 }
+    assert_response :unauthorized
+    assert_equal :lobby, game.reload.phase
+  end
+
+  test "Start a game opens the big screen with the join link and a QR code" do
+    get "/moderate/quizzes/#{@quiz.id}", headers: moderator_headers
+    assert_select "button", text: "Start a game"
+
+    post "/moderate/quizzes/#{@quiz.id}/games", headers: moderator_headers
+    game = @quiz.games.sole
+    assert_redirected_to "/moderate/games/#{game.id}"
+
+    get "/moderate/games/#{game.id}", headers: moderator_headers
+    assert_select "h1", text: "Frontend Fest 2026"
+    assert_select ".lobby__url", text: "www.example.com/play/#{game.code}"
+    assert_select ".qr svg[role=img][aria-label] path"
+    assert_select ".counter-pill", text: "Players: 0"
+    assert_select "button", text: "Start"
+
+    get "/moderate/quizzes/#{@quiz.id}", headers: moderator_headers
+    assert_select "#quiz_games tr##{dom_id(game)} a[href='/moderate/games/#{game.id}']", text: "Big screen"
+  end
+
+  test "the steps of a game on the big screen" do
+    game = @quiz.games.create!
+    alice = game.players.create!(name: "Alice", browser_token: "alice")
+    Presence.touch(game.id, alice.id, "cable:alice", ttl: 30.seconds)
+    screen = "/moderate/games/#{game.id}"
+
+    post "#{screen}/step", params: { step: "start", version: 0 }, headers: moderator_headers
+    assert_redirected_to screen
+    get screen, headers: moderator_headers
+    assert_select ".stage-question__num", text: "Question 1 of 2"
+    assert_select ".answers-counter", text: "Answers: 0 / 1"
+    assert_select "li.stage-option", 2
+    assert_no_match(/Correct/, response.body)
+    assert_select "button", text: "Finish"
+
+    post "#{screen}/step", params: { step: "start", version: 0 }, headers: moderator_headers # a second click
+    assert_equal 1, game.reload.version
+
+    game.current_round.record_answer(alice, @question.options.last.id)
+    get "#{screen}/counters", headers: moderator_headers
+    assert_equal({ "version" => 1, "players" => 1, "answers" => 1 }, response.parsed_body)
+
+    post "#{screen}/step", params: { step: "finish", version: 1 }, headers: moderator_headers
+    get screen, headers: moderator_headers
+    assert_select "li.stage-option.is-correct", count: 1 do
+      assert_select ".stage-option__title", text: "429"
+      assert_select ".stage-option__mark", text: "Correct"
+      assert_select ".stage-option__count", text: "1"
+    end
+    assert_select "li.stage-option:not(.is-correct) .stage-option__count", text: "0"
+    assert_select "button", text: "Next"
+    assert_select "button", text: "End quiz", count: 0
+
+    post "#{screen}/step", params: { step: "next", version: 2 }, headers: moderator_headers
+    post "#{screen}/step", params: { step: "finish", version: 3 }, headers: moderator_headers
+    get screen, headers: moderator_headers
+    assert_select ".stage-question__num", text: "Question 2 of 2"
+    assert_select "button", text: "End quiz"
+    assert_select "button", text: "Next", count: 0
+
+    post "#{screen}/step", params: { step: "end", version: 4 }, headers: moderator_headers
+    get screen, headers: moderator_headers
+    assert_select "h1", text: "The quiz is over"
+    assert_select ".screen-controls button", count: 0
+  end
+
+  test "deleting the question on screen does not break the game" do
+    game = @quiz.games.create!
+    alice = game.players.create!(name: "Alice", browser_token: "alice")
+    game.take_step("start", seen_version: 0)
+    @question.destroy!
+
+    get "/moderate/games/#{game.id}", headers: moderator_headers
+    assert_response :success
+    assert_select "button", text: "Next"
+    assert_equal "", Game::Stage.new(game.reload).for_player(alice).then { |stage| PlayChannel.render_stage(stage) }[/Which status code/].to_s
+
+    post "/moderate/games/#{game.id}/step", params: { step: "next", version: 1 }, headers: moderator_headers
+    get "/moderate/games/#{game.id}", headers: moderator_headers
+    assert_select ".stage-question__num", text: "Question 1 of 1"
+    assert_select ".stage-question__body", text: "Which protocol?"
+  end
+
+  test "Start without active questions explains why nothing happens" do
+    @quiz.questions.update_all(active: false)
+    game = @quiz.games.create!
+    get "/moderate/games/#{game.id}", headers: moderator_headers
+    assert_select ".lobby__note", text: "This quiz has no active questions yet."
+
+    post "/moderate/games/#{game.id}/step", params: { step: "start", version: 0 }, headers: moderator_headers
+    follow_redirect!(headers: moderator_headers)
+    assert_select ".flash--alert", text: "This quiz has no active questions yet"
+    assert_equal :lobby, game.reload.phase
+  end
+
+  test "QUIZZY_PUBLIC_URL sets the address in the join link" do
+    game = @quiz.games.create!
+    with_env("QUIZZY_PUBLIC_URL" => "http://192.168.1.20:3000/") do
+      get "/moderate/games/#{game.id}", headers: moderator_headers
+    end
+    assert_select ".lobby__url", text: "192.168.1.20:3000/play/#{game.code}"
+  end
+
+  private
+    def with_env(values)
+      saved = values.keys.index_with { |key| ENV[key] }
+      values.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      saved.each { |key, value| ENV[key] = value }
+    end
+end
diff --git a/test/integration/play_test.rb b/test/integration/play_test.rb
new file mode 100644
index 0000000..954d991
--- /dev/null
+++ b/test/integration/play_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class PlayTest < ActionDispatch::IntegrationTest
+  setup do
+    Presence.reset
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+    @question = create_question(@quiz, "Which status code means Too Many Requests?", { "418" => false, "429" => true })
+    @game = @quiz.games.create!
+    @wrong, @right = @question.options
+  end
+
+  def join(name = "Alice")
+    post "/play/#{@game.code}/player", params: { player: { name: name } }
+  end
+
+  def step(name)
+    @game.reload.take_step(name, seen_version: @game.version)
+  end
+
+  test "joining with a name, then being recognized by the browser" do
+    get "/play/#{@game.code.downcase}"
+    assert_response :success
+    assert_select "label", text: "Your name"
+    assert_select "input[placeholder='Your name']"
+    assert_select "button", text: "Join"
+
+    join "  Alice  "
+    assert_redirected_to "/play/#{@game.code}"
+    follow_redirect!
+    assert_select ".play__greeting", text: "Hi, Alice!"
+    assert_select "input[name='player[name]']", count: 0
+    assert_equal 1, Presence.count(@game.id), "counted before the live connection is up"
+
+    join "Alice again"
+    assert_equal [ "Alice" ], @game.players.pluck(:name)
+  end
+
+  test "a name is required" do
+    join "   "
+    assert_response :unprocessable_content
+    assert_select ".errors", text: "Please type a name first"
+    assert_equal 0, @game.players.count
+  end
+
+  test "after the end, nobody can join" do
+    step("start")
+    step("finish")
+    step("end")
+
+    get "/play/#{@game.code}"
+    assert_select "h1", text: "The quiz is over"
+    assert_select "form", count: 0
+
+    join
+    assert_response :gone
+    assert_equal 0, @game.players.count
+  end
+
+  test "an unknown code" do
+    get "/play/NOPE1"
+    assert_response :not_found
+    assert_select "h1", text: "No game here"
+  end
+
+  test "answering, changing the answer and seeing the result" do
+    join
+    step("start")
+
+    get "/play/#{@game.code}"
+    assert_select ".play-question__body", text: @question.text
+    assert_select "button.play-option", 2
+    assert_no_match(/correct/i, response.body, "the page source must not tell the correct option")
+
+    post "/play/#{@game.code}/answer", params: { option_id: @wrong.id }, as: :json
+    post "/play/#{@game.code}/answer", params: { option_id: @right.id }, as: :json
+    assert_response :success
+    payload = response.parsed_body
+    assert_equal [ 1, 2 ], [ payload["version"], payload["revision"] ]
+    assert_no_match(/correct/i, payload["html"])
+    picked = Nokogiri::HTML5.fragment(payload["html"]).at("button.is-picked")
+    assert_equal "429", picked.at(".play-option__title").text
+    assert_equal "Your answer", picked.at("[data-pick-mark]").text
+
+    step("finish")
+    get "/play/#{@game.code}"
+    assert_select ".play-status", text: "Correct!"
+    assert_select "button.play-option[disabled]", 2
+
+    post "/play/#{@game.code}/answer", params: { option_id: @wrong.id }, as: :json
+    assert_response :conflict
+    assert_match "Correct!", response.parsed_body["html"]
+    assert_equal @right, Answer.sole.option
+  end
+
+  test "a player who did not answer, and a wrong answer" do
+    join "Alice"
+    alice_cookies = cookies.to_hash
+    reset!
+    join "Bob"
+    step("start")
+    post "/play/#{@game.code}/answer", params: { option_id: @wrong.id }, as: :json
+    step("finish")
+
+    get "/play/#{@game.code}"
+    assert_select ".play-status", text: "Wrong!"
+
+    reset!
+    alice_cookies.each { |name, value| cookies[name] = value }
+    get "/play/#{@game.code}"
+    assert_select ".play__greeting", text: "Hi, Alice!"
+    assert_select ".play-status", text: "No answer"
+  end
+
+  test "answers without JavaScript go back to the page" do
+    join
+    step("start")
+    post "/play/#{@game.code}/answer", params: { option_id: @right.id }
+    assert_redirected_to "/play/#{@game.code}"
+    assert_equal @right, Answer.sole.option
+  end
+
+  test "the stage for phones without a live connection" do
+    join
+    get "/play/#{@game.code}/stage", params: { version: 0, revision: 0 }, as: :json
+    assert_response :no_content
+
+    step("start")
+    get "/play/#{@game.code}/stage", params: { version: 0, revision: 0, fallback: 1 }, as: :json
+    assert_response :success
+    assert_equal 1, response.parsed_body["version"]
+    assert_match @question.text, response.parsed_body["html"]
+  end
+
+  test "strangers cannot answer or poll" do
+    step("start")
+    post "/play/#{@game.code}/answer", params: { option_id: @right.id }, as: :json
+    assert_response :not_found
+    get "/play/#{@game.code}/stage", as: :json
+    assert_response :not_found
+    assert_equal 0, Answer.count
+  end
+end
diff --git a/test/models/game/stage_test.rb b/test/models/game/stage_test.rb
new file mode 100644
index 0000000..c028c82
--- /dev/null
+++ b/test/models/game/stage_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Game::StageTest < ActiveSupport::TestCase
+  setup do
+    quiz = Quiz.create!(title: "Quiz")
+    @question = create_question(quiz, "Which?", { "Right" => true, "Also right" => true, "Wrong" => false })
+    @game = quiz.games.create!
+    @alice = @game.players.create!(name: "Alice", browser_token: "alice")
+    @bob = @game.players.create!(name: "Bob", browser_token: "bob")
+    @right, @also_right, @wrong = @question.options
+  end
+
+  def step(name)
+    @game.take_step(name, seen_version: @game.version)
+  end
+
+  test "an open question tells nothing about the correct options" do
+    step("start")
+    @game.current_round.record_answer(@alice, @right.id)
+    stage = Game::Stage.new(@game).for_player(@alice)
+
+    assert_equal [ :open, @right.id, 1 ], [ stage.phase, stage.answer_option_id, stage.revision ]
+    assert_not stage.revealed?
+    assert_nil stage.result
+    assert @question.options.none? { |option| stage.correct?(option) }
+    assert_equal [ "" ], Game::Stage.new(@game).variants.keys
+  end
+
+  test "a closed question tells each player how they did" do
+    step("start")
+    @game.current_round.record_answer(@alice, @also_right.id)
+    @game.current_round.record_answer(@bob, @wrong.id)
+    step("finish")
+    stage = Game::Stage.new(@game)
+
+    assert_equal :right, stage.for_player(@alice).result
+    assert_equal :wrong, stage.for_player(@bob).result
+    assert_equal :none, stage.for_player(@game.players.create!(name: "Carol", browser_token: "carol")).result
+    assert_equal [ @right, @also_right ], @question.options.select { |option| stage.correct?(option) }
+    assert_equal [ "", *@question.options.map { |option| option.id.to_s } ], stage.variants.keys
+    assert_equal :wrong, stage.variants[@wrong.id.to_s].result
+  end
+
+  test "the end shows the player's score" do
+    step("start")
+    @game.current_round.record_answer(@alice, @right.id)
+    step("finish")
+    step("end")
+    stage = Game::Stage.new(@game)
+
+    assert_equal [ :ended, 1, 1 ], [ stage.phase, stage.rounds_count, stage.for_player(@alice).score ]
+    assert_equal %w[ 0 1 ], stage.variants.keys
+  end
+end
diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..d2e2766
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+    @first = create_question(@quiz, "First?", { "A" => true, "B" => false })
+    @inactive = create_question(@quiz, "Skipped?", { "Yes" => true, "No" => false }, false)
+    @second = create_question(@quiz, "Second?", { "C" => false, "D" => true })
+    @game = @quiz.games.create!
+  end
+
+  def step(name)
+    @game.take_step(name, seen_version: @game.version)
+  end
+
+  test "gets a short code from an unambiguous alphabet, found in any case" do
+    assert_match(/\A[A-HJKMNP-Z2-9]{5}\z/, @game.code)
+    assert_equal @game, Game.find_by_code(" #{@game.code.downcase} ")
+    assert_nil Game.find_by_code("nope")
+    assert_not_equal @game.code, @quiz.games.create!.code
+  end
+
+  test "plays the active questions in quiz order and ends" do
+    assert_equal :lobby, @game.phase
+    assert_equal 2, @game.questions_total
+
+    assert step("start")
+    assert_equal [ :open, @first, 1, 1 ], [ @game.phase, @game.current_round.question, @game.current_round.position, @game.version ]
+    assert_not @game.last_question?
+
+    assert step("finish")
+    assert_equal :closed, @game.phase
+
+    assert step("next")
+    assert_equal [ :open, @second, 2 ], [ @game.phase, @game.current_round.question, @game.current_round.position ]
+    assert @game.last_question?
+    assert_equal 2, @game.questions_total
+
+    assert step("finish")
+    assert step("end")
+    assert_equal :ended, @game.phase
+    assert @game.ended_at
+    assert_equal 5, @game.version
+  end
+
+  test "ignores steps from an outdated screen and steps that do not fit the phase" do
+    assert step("start")
+    assert_not @game.take_step("start", seen_version: 0), "a second click on Start"
+    assert_not @game.take_step("finish", seen_version: 0), "an outdated screen"
+    assert_not step("next"), "the question is still open"
+    assert_not step("bogus")
+    assert_equal [ :open, 1, 1 ], [ @game.phase, @game.version, @game.rounds.count ]
+  end
+
+  test "Next ends the game when no active question is left" do
+    @second.update!(active: false)
+    step("start")
+    step("finish")
+    assert @game.last_question?
+
+    assert step("next")
+    assert_equal :ended, @game.phase
+  end
+
+  test "takes questions switched on or off during the game into account" do
+    step("start")
+    @inactive.update!(active: true)
+    assert_equal 3, @game.questions_total
+
+    step("finish")
+    step("next")
+    assert_equal @inactive, @game.current_round.question
+  end
+
+  test "cannot start without active questions" do
+    @quiz.questions.update_all(active: false)
+    assert_not step("start")
+    assert_equal :lobby, @game.phase
+  end
+
+  test "games are deleted with their quiz" do
+    @game.players.create!(name: "Alice", browser_token: "token")
+    @quiz.destroy!
+    assert_not Game.exists?(@game.id)
+    assert_equal 0, Player.count
+  end
+end
diff --git a/test/models/presence_test.rb b/test/models/presence_test.rb
