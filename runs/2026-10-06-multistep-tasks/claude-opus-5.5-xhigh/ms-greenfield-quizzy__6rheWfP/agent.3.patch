index 0000000..e1c4a69
--- /dev/null
+++ b/app/controllers/play/players_controller.rb
@@ -0,0 +1,20 @@
+# "Join": the browser becomes a player of the game.
+class Play::PlayersController < Play::BaseController
+  def create
+    return render("play/games/over", status: :gone) if @game.ended?
+
+    set_player
+    return redirect_to(play_path(@game.code), status: :see_other) if @player
+
+    @new_player = @game.players.new(name: params.dig(:player, :name).to_s, browser_token: remember_browser)
+
+    if @new_player.save
+      redirect_to play_path(@game.code), status: :see_other
+    else
+      render "play/games/join", status: :unprocessable_content
+    end
+  rescue ActiveRecord::RecordNotUnique
+    # The same browser joined twice at once (a double tap): it is in.
+    redirect_to play_path(@game.code), status: :see_other
+  end
+end
