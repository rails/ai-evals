diff --git a/app/views/moderate/questions/_option_row.html.erb b/app/views/moderate/questions/_option_row.html.erb
new file mode 100644
index 0000000..46e78ef
--- /dev/null
+++ b/app/views/moderate/questions/_option_row.html.erb
@@ -0,0 +1,26 @@
+<%#
+  One option row of the question form.
+  `index` keeps the submitted rows apart (question[options][<index>]); `number` is what the moderator sees.
+  The template for "Add option" renders this with the __INDEX__ / __NUMBER__ placeholders.
+%>
+<% field = "question[options][#{index}]" %>
+<div class="option-row" data-option-rows-target="row">
+  <% if row.id.present? %>
+    <%= hidden_field_tag "#{field}[id]", row.id, id: nil %>
+  <% end %>
+
+  <%= text_field_tag "#{field}[text]", row.text, id: "question_option_#{index}_text", class: "input option-row__text",
+        placeholder: "Option #{number}", autocomplete: "off",
+        aria: { label: "Option #{number}" }, data: { option_rows_target: "text" } %>
+
+  <label class="checkbox option-row__correct">
+    <%= hidden_field_tag "#{field}[correct]", "0", id: nil %>
+    <%= check_box_tag "#{field}[correct]", "1", row.correct?, id: "question_option_#{index}_correct",
+          aria: { label: "Option #{number} is correct" }, data: { option_rows_target: "correct" } %>
+    <span class="visually-hidden" data-option-rows-target="correctLabel">Option <%= number %> is correct</span>
+    <span aria-hidden="true">Correct</span>
+  </label>
+
+  <button type="button" class="btn btn--danger btn--icon" title="Remove option <%= number %>"
+          aria-label="Remove option <%= number %>" data-option-rows-target="remove" data-action="option-rows#remove">✕</button>
+</div>
diff --git a/app/views/moderate/questions/_question.html.erb b/app/views/moderate/questions/_question.html.erb
