@@ -0,0 +1,24 @@
+require "test_helper"
+require "capybara/cuprite"
+
+Capybara.enable_aria_label = true
+Capybara.default_max_wait_time = 5
+
+class ApplicationSystemTestCase < ActionDispatch::SystemTestCase
+  driven_by :cuprite, screen_size: [ 1280, 900 ], options: {
+    browser_path: ENV.fetch("CHROMIUM_PATH", "/usr/bin/chromium"),
+    headless: true,
+    process_timeout: 30,
+    timeout: 15,
+    js_errors: true,
+    browser_options: { "no-sandbox" => nil }
+  }
+
+  setup do
+    page.driver.basic_authorize(MODERATOR_USERNAME, MODERATOR_PASSWORD)
+  end
+
+  def question_item(text)
+    find("li", text: text, match: :first)
+  end
+end
