+.lobby__join { font-size: clamp(20px, 2.2vw, 40px); font-weight: 600; margin-bottom: 0.3em; }
+.lobby__url { font-family: var(--f-display); font-weight: 800; font-size: clamp(28px, 3.6vw, 72px); line-height: 1; overflow-wrap: anywhere; }
+
+.qr {
+  background: var(--c-white);
