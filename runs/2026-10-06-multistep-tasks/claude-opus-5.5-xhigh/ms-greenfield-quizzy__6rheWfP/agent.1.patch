+module ApplicationHelper
+  LETTERS = ("A".."Z").to_a.freeze
+
+  # A, B, C, ... for option 0, 1, 2, ...
+  def option_letter(index)
+    LETTERS.fetch(index) { (index + 1).to_s }
+  end
+
+  # "← Text" link; the arrow is decoration and stays out of the link name.
+  def back_link(text, path)
+    link_to path do
+      safe_join([ tag.span("←", aria: { hidden: true }), " ", text ])
+    end
+  end
+
+  def questions_count(quiz)
+    total = quiz.questions.size
+    active = quiz.active_questions.size
+    text = pluralize(total, "question")
+    total.positive? && active < total ? "#{text} · #{active} active" : text
+  end
+end
