+  font-size: clamp(18px, 1.8vw, 30px);
+}
+
+.screen__logo { font-size: clamp(28px, 3vw, 52px); }
+
+.screen__body { flex: 1; display: flex; flex-direction: column; justify-content: center; }
+
+.screen-controls {
+  position: fixed;
+  left: 0;
+  right: 0;
+  bottom: 0;
