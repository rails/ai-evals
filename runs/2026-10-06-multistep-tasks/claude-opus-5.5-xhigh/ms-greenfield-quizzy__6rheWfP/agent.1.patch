+  <link rel="icon" href="/icon.svg" type="image/svg+xml">
+  <style>
+    *, *::before, *::after { box-sizing: border-box; }
+    body { margin: 0; min-height: 100vh; min-height: 100dvh; display: grid; place-items: center; padding: clamp(16px, 4vw, 60px);
+      background: #2a12c9; color: #fff; font: 18px/1.35 system-ui, -apple-system, sans-serif; letter-spacing: -0.01em; }
+    main { max-width: 640px; }
+    .mark { display: inline-grid; place-items: center; width: 1.05em; height: 1.05em; border-radius: 50% 50% 50% 12%;
+      background: #ffd23f; color: #0d0640; font: 900 72px/1 system-ui, sans-serif; }
+    .code { font-weight: 900; font-size: clamp(64px, 14vw, 160px); line-height: 0.9; letter-spacing: -0.05em; margin: 24px 0 8px; }
