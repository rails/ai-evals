diff --git a/app/javascript/controllers/countdown_controller.js b/app/javascript/controllers/countdown_controller.js
new file mode 100644
index 0000000..85d8903
--- /dev/null
+++ b/app/javascript/controllers/countdown_controller.js
@@ -0,0 +1,69 @@
+import { Controller } from "@hotwired/stimulus"
+
+// The countdown on the big screen while a question with a timer is open
+// ("1:30", "0:05"; players never see it).
+//
+// The server renders the time left when it renders the page (leftValue, in
+// ms), so a reload carries on where the countdown was, and the clock of the
+// moderator's computer does not matter. A morph that brings a newer time left
+// (another step re-rendered the page) takes over from it.
+//
+// At 0:00 it stops and dispatches "countdown:expired". The question finishes
+// by itself on the server at that moment (Game::Timer), which pushes the
+// change; the screen also polls right away (screen#timeUp) in case the push
+// does not arrive.
+const URGENT_SECONDS = 5
+
+export default class extends Controller {
+  static targets = [ "time" ]
+  static values = { left: Number, duration: Number }
+
+  connect() {
+    this.connected = true
+    this.endsAt ??= Date.now() + this.leftValue
+    this.tick()
+  }
+
+  disconnect() {
+    this.connected = false
+    clearTimeout(this.timer)
+  }
+
+  // Stimulus calls this before every connect too: only a new value (a newer
+  // render of the page) sets the end again, so reconnecting does not restart.
+  leftValueChanged(value) {
+    if (value === this.renderedLeft) return
+
+    this.renderedLeft = value
+    this.endsAt = Date.now() + value
+    this.expired = false
+    if (this.connected) this.tick()
+  }
+
+  tick() {
+    clearTimeout(this.timer)
+    const left = Math.max(0, this.endsAt - Date.now())
+    const seconds = Math.ceil(left / 1000)
+
+    if (this.hasTimeTarget) this.timeTarget.textContent = formatTime(seconds)
+    this.element.classList.toggle("is-urgent", seconds <= URGENT_SECONDS)
+    if (this.durationValue > 0) this.element.style.setProperty("--left", (left / this.durationValue).toFixed(4))
+
+    if (left <= 0) {
+      this.timer = null
+      if (!this.expired) {
+        this.expired = true
+        this.dispatch("expired")
+      }
+      return
+    }
+
+    // Next time the display changes: when the time left crosses a whole second.
+    this.timer = setTimeout(() => this.tick(), (left % 1000 || 1000) + 5)
+  }
+}
+
+// M:SS, like GamesHelper#countdown_text.
+function formatTime(seconds) {
+  return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`
+}
