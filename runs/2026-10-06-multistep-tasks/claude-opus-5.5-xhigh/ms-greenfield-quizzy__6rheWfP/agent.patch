+}
+.qr svg { width: 100%; height: 100%; display: block; }
+
+.counter-pill {
+  display: inline-flex;
+  align-items: baseline;
+  gap: 0.4em;
+  margin-top: 1.2em;
+  padding: 0.4em 0.9em;
