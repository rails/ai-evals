diff --git a/app/views/moderate/games/_ended.html.erb b/app/views/moderate/games/_ended.html.erb
new file mode 100644
index 0000000..8310be9
--- /dev/null
+++ b/app/views/moderate/games/_ended.html.erb
@@ -0,0 +1,28 @@
+<%# After the end: the leaderboard (every player, in order), with the winners
+    the moderator picked. "Top N", "Draw" and "Reset winners" are in the
+    controls bar, outside the list. Apart from "Reset winners", the winners'
+    marks are the only text that says "winner". %>
+<div class="leaderboard-layout screen-end">
+  <div>
+    <h1 class="leaderboard-layout__title">The quiz is over</h1>
+    <p class="screen-end__lead">Thanks for playing!</p>
+    <p class="screen-end__meta"><%= pluralize(screen.leaderboard.size, "player") %> · <%= pluralize(screen.game.rounds.count, "question") %></p>
+  </div>
+
+  <% if screen.leaderboard.any? %>
+    <ol class="leaderboard" aria-label="Leaderboard">
+      <% screen.leaderboard.each do |entry| %>
+        <li class="leader<%= " is-winner" if entry.winner? %><%= " is-tied" if screen.in_draw?(entry) %>" id="leader_<%= entry.player_id %>">
+          <span class="leader__place"><%= entry.place %></span>
+          <span class="leader__name"><%= entry.name %></span>
+          <span class="leader__score"<% if entry.points? %> title="<%= leader_time(entry) %>"<% end %>><%= pluralize(entry.points, "point") %></span>
+          <% if entry.winner? %>
+            <span class="leader__badge">Winner</span>
+          <% end %>
+        </li>
+      <% end %>
+    </ol>
+  <% else %>
+    <p class="screen-end__meta">Nobody joined this game.</p>
+  <% end %>
+</div>
