diff --git a/test/models/game/leaderboard_test.rb b/test/models/game/leaderboard_test.rb
new file mode 100644
index 0000000..bf1a998
--- /dev/null
+++ b/test/models/game/leaderboard_test.rb
@@ -0,0 +1,129 @@
+require "test_helper"
+
+class Game::LeaderboardTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Quiz", winners_count: 2)
+    @first = create_question(@quiz, "First?", { "Right" => true, "Also right" => true, "Wrong" => false })
+    @second = create_question(@quiz, "Second?", { "Yes" => true, "No" => false })
+    @game = @quiz.games.create!
+    @alice, @bob, @carol, @dave, @eve = %w[ Alice Bob Carol Dave Eve ].map { |name| @game.players.create!(name: name, browser_token: name) }
+  end
+
+  def step(name)
+    @game.take_step(name, seen_version: @game.version)
+  end
+
+  # Opens a question, lets each player pick an option the given seconds after
+  # the opening, and closes it.
+  def play(question, picks)
+    travel_to Time.zone.local(2026, 10, 8, 10, 0, 0) do
+      @game.lobby? ? step("start") : step("next")
+      round = @game.current_round
+      assert_equal question, round.question
+
+      picks.sort_by { |(_player, _option, seconds)| seconds }.each do |player, option, seconds|
+        travel_to round.opened_at + seconds
+        round.record_answer(player, question.options.find_by!(text: option).id)
+      end
+      step("finish")
+    end
+  end
+
+  def board
+    @game.leaderboard
+  end
+
+  def names(entries)
+    entries.map(&:name)
+  end
+
+  test "ranks by points, then by the total time of the correct answers, then by joining" do
+    play @first, [ [ @alice, "Right", 9 ], [ @bob, "Also right", 2 ], [ @carol, "Wrong", 1 ], [ @dave, "Right", 3 ] ]
+    play @second, [ [ @alice, "Yes", 1 ], [ @bob, "No", 1 ], [ @carol, "Yes", 4 ] ]
+    step("end")
+
+    assert_equal %w[ Alice Bob Dave Carol Eve ], names(board.entries)
+    assert_equal [ 1, 2, 3, 4, 5 ], board.entries.map(&:place)
+    assert_equal [ 2, 1, 1, 1, 0 ], board.entries.map(&:points)
+    assert_equal [ 10, 2, 3, 4, 0 ].map { |seconds| seconds * 1_000_000 }, board.entries.map(&:time_us),
+      "only correct answers count, wrong ones add no time"
+    assert_equal 5, board.size
+  end
+
+  test "an answer's time runs to the player's last pick" do
+    travel_to Time.zone.local(2026, 10, 8, 10, 0, 0) do
+      step("start")
+      round = @game.current_round
+      right, also_right, wrong = @first.options
+
+      travel 1.second
+      round.record_answer(@alice, wrong.id)
+      round.record_answer(@bob, right.id)
+      travel 2.seconds
+      round.record_answer(@alice, right.id) # changed: the time is now 3 s
+      round.record_answer(@bob, right.id)   # the same pick again: still 1 s
+      travel 1.second
+      round.record_answer(@carol, wrong.id)
+      round.record_answer(@carol, also_right.id)
+
+      assert_equal({ "Alice" => 3_000_000, "Bob" => 1_000_000, "Carol" => 4_000_000 },
+        round.answers.includes(:player).to_h { |answer| [ answer.player.name, answer.elapsed_us ] })
+    end
+  end
+
+  test "Top N takes the first N players, never those with 0 points" do
+    play @first, [ [ @alice, "Right", 1 ], [ @bob, "Right", 2 ], [ @carol, "Right", 3 ] ]
+    play @second, [ [ @carol, "Yes", 1 ] ]
+
+    assert_equal %w[ Carol Alice ], names(board.top(2))
+    assert_equal %w[ Carol Alice Bob ], names(board.top(10)), "fewer than N players with points: all of them"
+    assert_equal %w[ Carol ], names(board.top(1))
+  end
+
+  test "Draw: everyone above the N-th place's points wins, the rest is drawn among the tied" do
+    @quiz.update!(winners_count: 3)
+    play @first, [ [ @alice, "Right", 1 ], [ @bob, "Right", 2 ], [ @carol, "Right", 3 ], [ @dave, "Right", 4 ] ]
+    play @second, [ [ @dave, "Yes", 1 ] ]
+    # Dave 2 points; Alice, Bob, Carol 1 point (in that order by speed); Eve 0.
+
+    assert_equal %w[ Dave Alice Bob ], names(board.top(3))
+    assert_equal %w[ Alice Bob Carol ], names(board.draw_pool(3))
+
+    draws = 60.times.map { board.draw(3) }
+    assert draws.all? { |winners| winners.size == 3 && winners.first.name == "Dave" }
+    assert_equal %w[ Alice Bob Carol ], draws.flat_map { |winners| names(winners.drop(1)) }.uniq.sort, "speed does not matter in a draw"
+    assert draws.all? { |winners| winners.none? { |entry| entry.name == "Eve" } }
+
+    assert_equal names(board.draw(3, random: Random.new(1))), names(board.draw(3, random: Random.new(1)))
+  end
+
+  test "Draw without a tie on the N-th place, and with fewer players with points than prizes" do
+    play @first, [ [ @alice, "Right", 1 ], [ @bob, "Right", 2 ] ]
+    play @second, [ [ @alice, "Yes", 1 ] ]
+
+    assert_empty board.draw_pool(2)
+    assert_equal %w[ Alice Bob ], names(board.draw(2))
+    assert_equal %w[ Alice ], names(board.draw(1))
+    assert_equal %w[ Alice Bob ], names(board.draw(4))
+  end
+
+  test "a tie entirely inside the first N is not a draw" do
+    play @first, [ [ @alice, "Right", 1 ], [ @bob, "Right", 2 ], [ @carol, "Wrong", 3 ] ]
+    play @second, [ [ @carol, "Yes", 1 ] ]
+    # Alice, Bob and Carol have 1 point each (Alice and Carol in 1 s, Bob in 2 s).
+
+    assert_equal %w[ Alice Carol Bob ], names(board.draw_pool(2))
+    assert_empty board.draw_pool(3)
+    assert_equal %w[ Alice Bob Carol ], names(board.draw(3)).sort
+  end
+
+  test "without players" do
+    @game.players.delete_all
+    step("start")
+    step("end")
+
+    assert board.empty?
+    assert_empty board.top(3)
+    assert_empty board.draw(3)
+  end
+end
diff --git a/test/models/game/stage_test.rb b/test/models/game/stage_test.rb
new file mode 100644
index 0000000..7c8ab6b
--- /dev/null
+++ b/test/models/game/stage_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Game::StageTest < ActiveSupport::TestCase
+  setup do
+    quiz = Quiz.create!(title: "Quiz")
+    @question = create_question(quiz, "Which?", { "Right" => true, "Also right" => true, "Wrong" => false })
+    @game = quiz.games.create!
+    @alice = @game.players.create!(name: "Alice", browser_token: "alice")
+    @bob = @game.players.create!(name: "Bob", browser_token: "bob")
+    @right, @also_right, @wrong = @question.options
+  end
+
+  def step(name)
+    @game.take_step(name, seen_version: @game.version)
+  end
+
+  test "an open question tells nothing about the correct options" do
+    step("start")
+    @game.current_round.record_answer(@alice, @right.id)
+    stage = Game::Stage.new(@game).for_player(@alice)
+
+    assert_equal [ :open, @right.id, 1 ], [ stage.phase, stage.answer_option_id, stage.revision ]
+    assert_not stage.revealed?
+    assert_nil stage.result
+    assert @question.options.none? { |option| stage.correct?(option) }
+    assert_equal [ "" ], Game::Stage.new(@game).variants.keys
+  end
+
+  test "a closed question tells each player how they did" do
+    step("start")
+    @game.current_round.record_answer(@alice, @also_right.id)
+    @game.current_round.record_answer(@bob, @wrong.id)
+    step("finish")
+    stage = Game::Stage.new(@game)
+
+    assert_equal :right, stage.for_player(@alice).result
+    assert_equal :wrong, stage.for_player(@bob).result
+    assert_equal :none, stage.for_player(@game.players.create!(name: "Carol", browser_token: "carol")).result
+    assert_equal [ @right, @also_right ], @question.options.select { |option| stage.correct?(option) }
+    assert_equal [ "", *@question.options.map { |option| option.id.to_s } ], stage.variants.keys
+    assert_equal :wrong, stage.variants[@wrong.id.to_s].result
+  end
+
+  test "the end shows the player's place, points and prize" do
+    step("start")
+    @game.current_round.record_answer(@bob, @right.id)
+    step("finish")
+    step("end")
+    stage = Game::Stage.new(@game)
+
+    assert_equal :standing, stage.personal_kind
+    assert_equal Game::Stage::Standing.new(place: 1, players_count: 2, points: 1, winner: false), stage.for_player(@bob).standing
+    assert_equal Game::Stage::Standing.new(place: 2, players_count: 2, points: 0, winner: false), stage.for_player(@alice).standing
+    assert_equal({ "players" => 2, "places" => { @bob.id.to_s => [ 1, 1, 0 ], @alice.id.to_s => [ 2, 0, 0 ] } }, stage.standings)
+
+    @game.pick_winners("top")
+    standings = Game::Stage.new(@game).standings
+    assert_equal [ 1, 1, 1 ], standings["places"][@bob.id.to_s]
+    assert_equal Game::Stage::Standing.new(place: 1, players_count: 2, points: 1, winner: true), Game::Stage::Standing.from_standings(standings, @bob.id)
+    assert_nil Game::Stage::Standing.from_standings(standings, 0)
+  end
+
+  test "points are not shown before the end" do
+    step("start")
+    @game.current_round.record_answer(@alice, @right.id)
+    step("finish")
+
+    html = PlayChannel.render_stage(Game::Stage.new(@game).for_player(@alice))
+    assert_match "Correct!", html
+    assert_no_match(/point|place/i, html)
+    assert_nil Game::Stage.new(@game).for_player(@alice).standing
+  end
+end
diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..ea05b74
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,237 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+    @first = create_question(@quiz, "First?", { "A" => true, "B" => false })
+    @inactive = create_question(@quiz, "Skipped?", { "Yes" => true, "No" => false }, false)
+    @second = create_question(@quiz, "Second?", { "C" => false, "D" => true })
+    @game = @quiz.games.create!
+  end
+
+  def step(name)
+    @game.take_step(name, seen_version: @game.version)
+  end
+
+  test "gets a short code from an unambiguous alphabet, found in any case" do
+    assert_match(/\A[A-HJKMNP-Z2-9]{5}\z/, @game.code)
+    assert_equal @game, Game.find_by_code(" #{@game.code.downcase} ")
+    assert_nil Game.find_by_code("nope")
+    assert_not_equal @game.code, @quiz.games.create!.code
+  end
+
+  test "plays the active questions in quiz order and ends" do
+    assert_equal :lobby, @game.phase
+    assert_equal 2, @game.questions_total
+
+    assert step("start")
+    assert_equal [ :open, @first, 1, 1 ], [ @game.phase, @game.current_round.question, @game.current_round.position, @game.version ]
+    assert_not @game.last_question?
+
+    assert step("finish")
+    assert_equal :closed, @game.phase
+
+    assert step("next")
+    assert_equal [ :open, @second, 2 ], [ @game.phase, @game.current_round.question, @game.current_round.position ]
+    assert @game.last_question?
+    assert_equal 2, @game.questions_total
+
+    assert step("finish")
+    assert step("end")
+    assert_equal :ended, @game.phase
+    assert @game.ended_at
+    assert_equal 5, @game.version
+  end
+
+  test "ignores steps from an outdated screen and steps that do not fit the phase" do
+    assert step("start")
+    assert_not @game.take_step("start", seen_version: 0), "a second click on Start"
+    assert_not @game.take_step("finish", seen_version: 0), "an outdated screen"
+    assert_not step("next"), "the question is still open"
+    assert_not step("bogus")
+    assert_equal [ :open, 1, 1 ], [ @game.phase, @game.version, @game.rounds.count ]
+  end
+
+  test "Next ends the game when no active question is left" do
+    @second.update!(active: false)
+    step("start")
+    step("finish")
+    assert @game.last_question?
+
+    assert step("next")
+    assert_equal :ended, @game.phase
+  end
+
+  test "takes questions switched on or off during the game into account" do
+    step("start")
+    @inactive.update!(active: true)
+    assert_equal 3, @game.questions_total
+
+    step("finish")
+    step("next")
+    assert_equal @inactive, @game.current_round.question
+  end
+
+  test "cannot start without active questions" do
+    @quiz.questions.update_all(active: false)
+    assert_not step("start")
+    assert_equal :lobby, @game.phase
+  end
+
+  test "after the end the moderator picks the winners, and can draw again" do
+    @quiz.update!(winners_count: 1)
+    alice, bob, carol = %w[ Alice Bob Carol ].map { |name| @game.players.create!(name: name, browser_token: name) }
+    step("start")
+    @game.current_round.record_answer(bob, @first.options.first.id)
+    @game.current_round.record_answer(alice, @first.options.first.id)
+    step("finish")
+    assert_not @game.pick_winners("top"), "only once the game is over"
+
+    step("next")
+    step("finish")
+    step("end")
+    version = @game.version
+
+    assert @game.pick_winners("top")
+    assert_equal [ "Bob" ], @game.players.where(winner: true).pluck(:name), "Bob was faster"
+    assert_equal version + 1, @game.version
+    assert_not @game.pick_winners("top"), "nothing changed"
+    assert_equal version + 1, @game.version
+
+    drawn = 40.times.map { @game.pick_winners("draw"); @game.players.where(winner: true).pluck(:name) }
+    assert drawn.all? { |names| names.size == 1 }
+    assert_equal %w[ Alice Bob ], drawn.flatten.uniq.sort, "a draw among the tied, never Carol (0 points)"
+
+    assert @game.pick_winners("reset")
+    assert_not @game.players.exists?(winner: true)
+    assert_not @game.pick_winners("bogus")
+    assert_not carol.reload.winner?
+  end
+
+  test "without a timer, a question stays open until Finish" do
+    step("start")
+    assert_nil @game.current_round.closes_at
+
+    travel 1.day do
+      assert_not @game.keep_time
+      assert_not @game.finish_when_time_is_up
+    end
+    assert_equal [ :open, 1 ], [ @game.reload.phase, @game.version ]
+  end
+
+  test "with a timer, the time is up a set time after the question opens" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    freeze_time do
+      step("start")
+      round = @game.current_round
+      assert_equal Time.current, round.opened_at
+      assert_equal round.opened_at + 90.seconds, round.closes_at
+      assert_equal 90.0, round.time_left
+      assert_not round.time_up?
+    end
+  end
+
+  test "at 0:00 the question finishes by itself, as if the moderator clicked Finish" do
+    @quiz.update!(timer_seconds: 10)
+    step("start")
+    round = @game.current_round
+
+    travel_to round.closes_at - 0.001, with_usec: true do
+      assert_not @game.keep_time, "not yet"
+      assert_not @game.finish_when_time_is_up, "not yet"
+    end
+    assert_equal [ :open, 1 ], [ @game.reload.phase, @game.version ]
+
+    travel_to round.closes_at, with_usec: true do
+      assert @game.keep_time
+      assert_equal [ :closed, 2 ], [ @game.phase, @game.version ]
+      assert round.reload.closed_at
+      assert_not @game.keep_time, "only once"
+      assert_not @game.finish_when_time_is_up, "only once"
+    end
+
+    assert_not @game.take_step("finish", seen_version: 1), "a Finish click shown before the timer finished it"
+    assert step("next")
+    next_round = @game.current_round
+    assert_equal [ :open, @second ], [ @game.phase, next_round.question ]
+    assert_equal next_round.opened_at + 10.seconds, next_round.closes_at, "each question gets its own time"
+  end
+
+  test "the moderator can still click Finish before the time is up" do
+    @quiz.update!(timer_seconds: 30)
+    step("start")
+    assert step("finish")
+    assert_equal [ :closed, 2 ], [ @game.phase, @game.version ]
+
+    travel_to @game.current_round.closes_at, with_usec: true do
+      assert_not @game.keep_time
+      assert_equal 2, @game.reload.version, "nothing more happens at 0:00"
+    end
+  end
+
+  test "changing the timer during a question counts from the next question" do
+    @quiz.update!(timer_seconds: 20)
+    step("start")
+    closes_at = @game.current_round.closes_at
+
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    assert_equal closes_at, @game.current_round.reload.closes_at
+    step("finish")
+    step("next")
+    assert_nil @game.current_round.closes_at
+  end
+
+  test "a question removed while its time runs leaves the game alone" do
+    @quiz.update!(timer_seconds: 5)
+    step("start")
+    closes_at = @game.current_round.closes_at
+    @first.destroy!
+
+    travel_to closes_at + 1.second, with_usec: true do
+      assert_not @game.reload.keep_time
+    end
+    assert_equal [ :closed, 1 ], [ @game.phase, @game.version ]
+  end
+
+  test "Game::Timer finishes the question on time, in this process" do
+    Game::Timer.enabled = true
+    @quiz.update!(timer_seconds: 1)
+    step("start")
+    round = @game.current_round
+    assert Game::Timer.scheduled?(round)
+
+    give_up_at = Time.current + 5.seconds
+    sleep 0.02 until round.reload.closed_at || Time.current > give_up_at
+    assert round.closed_at, "the question finished by itself"
+    assert_operator round.closed_at, :>=, round.closes_at
+    assert_in_delta round.closes_at, round.closed_at, 0.5
+    assert_equal [ :closed, 2 ], [ @game.reload.phase, @game.version ]
+    assert_not Game::Timer.scheduled?(round)
+  ensure
+    Game::Timer.enabled = false
+    Game::Timer.clear
+  end
+
+  test "after a restart, the next request about the game schedules its timer again" do
+    @quiz.update!(timer_seconds: 30)
+    step("start") # the timer is off in tests: nothing is scheduled
+    round = @game.current_round
+    Game::Timer.enabled = true
+    assert_not Game::Timer.scheduled?(round)
+
+    assert_not @game.keep_time
+    assert Game::Timer.scheduled?(round)
+    @game.keep_time
+    assert Game::Timer.scheduled?(round), "still once"
+  ensure
+    Game::Timer.enabled = false
+    Game::Timer.clear
+  end
+
+  test "games are deleted with their quiz" do
+    @game.players.create!(name: "Alice", browser_token: "token")
+    @quiz.destroy!
+    assert_not Game.exists?(@game.id)
+    assert_equal 0, Player.count
+  end
+end
