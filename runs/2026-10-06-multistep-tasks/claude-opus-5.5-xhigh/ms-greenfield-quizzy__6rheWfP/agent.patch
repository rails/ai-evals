+<% content_for :title, "Import quiz" %>
+<%# The only text on this page containing "Import" is the button, so it is unambiguous. %>
+
+<div class="breadcrumbs"><%= back_link("All quizzes", moderate_root_path) %></div>
+<div class="page-head"><h1>New quiz from JSON</h1></div>
