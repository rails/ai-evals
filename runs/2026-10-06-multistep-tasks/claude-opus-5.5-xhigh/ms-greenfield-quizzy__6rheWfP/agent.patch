diff --git a/config/cable.yml b/config/cable.yml
new file mode 100644
index 0000000..04a3e2f
--- /dev/null
+++ b/config/cable.yml
@@ -0,0 +1,18 @@
+# Action Cable carries the live game to the phones (PlayChannel) and the big
+# screens (ScreenChannel).
+#
+# Production uses the in-process "async" adapter: Quizzy runs a single Puma
+# process with Action Cable inside it (Presence relies on that too), so a
+# broadcast goes straight to the subscribed connections. Solid Cable would add
+# its database polling interval to every step, and speed now decides ties:
+# every phone must get a question the moment the moderator opens it. Switch
+# back to solid_cable (the database is still configured) if Quizzy ever runs
+# several processes, or broadcasts from outside the web process.
+development:
+  adapter: async
+
+test:
+  adapter: test
+
+production:
+  adapter: async
