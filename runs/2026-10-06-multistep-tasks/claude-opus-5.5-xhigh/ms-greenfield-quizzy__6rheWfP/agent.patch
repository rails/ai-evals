+
+.stage-options--results .stage-option:not(.is-correct) { opacity: 0.55; }
+.stage-option.is-correct { background: var(--c-white); box-shadow: 0 0 0 4px var(--c-success); }
+.stage-option.is-correct .stage-option__letter { background: var(--c-success); }
+.stage-option.is-correct .stage-option__bar { background: rgb(0 179 107 / 0.22); }
+
+.answers-counter { font-family: var(--f-display); font-weight: 800; font-size: clamp(18px, 1.6vw, 28px); }
+
+/* Leaderboard */
+
+.leaderboard { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; counter-reset: place; }
+
+.leader {
+  display: grid;
+  grid-template-columns: 2.4em 1fr auto;
