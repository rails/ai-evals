+<!DOCTYPE html>
+<html lang="en">
+  <head>
+    <title><%= [ content_for(:title), "Quizzy" ].compact_blank.join(" · ") %></title>
+    <meta name="viewport" content="width=device-width,initial-scale=1">
+    <meta name="apple-mobile-web-app-capable" content="yes">
+    <meta name="application-name" content="Quizzy">
+    <meta name="mobile-web-app-capable" content="yes">
+    <meta name="theme-color" content="#2a12c9">
+    <%= csrf_meta_tags %>
+    <%= csp_meta_tag %>
+
+    <%# Always show fresh data: no hover prefetching, no cached page previews. %>
+    <meta name="turbo-prefetch" content="false">
+    <%= turbo_exempts_page_from_cache %>
+
+    <%= yield :head %>
+
+    <link rel="icon" href="/icon.png" type="image/png">
+    <link rel="icon" href="/icon.svg" type="image/svg+xml">
+    <link rel="apple-touch-icon" href="/icon.png">
+
+    <%= preload_link_tag "Inter-latin.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
+    <%= stylesheet_link_tag "quizzy", "application", "data-turbo-track": "reload" %>
+    <%= javascript_importmap_tags %>
+  </head>
+
+  <body>
+    <%= content_for?(:body) ? yield(:body) : yield %>
+    <div id="flash"><%= render "layouts/flash" %></div>
