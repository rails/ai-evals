+++ b/test/models/presence_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class PresenceTest < ActiveSupport::TestCase
+  setup { Presence.reset }
+  teardown { Presence.reset }
+
+  test "counts distinct players until they leave or stop showing up" do
+    Presence.touch(1, 10, "cable:a", ttl: 30.seconds)
+    Presence.touch(1, 10, "cable:b", ttl: 30.seconds) # a second tab
+    Presence.touch(1, 11, Presence.poll_key(11), ttl: 12.seconds)
+    Presence.touch(2, 12, "cable:c", ttl: 30.seconds)
+    assert_equal 2, Presence.count(1)
+
+    Presence.leave(1, "cable:a")
+    assert_equal 2, Presence.count(1)
+
+    travel 13.seconds do
+      assert_equal 1, Presence.count(1)
+    end
+
+    Presence.leave(1, "cable:b")
+    Presence.leave(1, Presence.poll_key(11))
+    assert_equal 0, Presence.count(1)
+    assert_equal 1, Presence.count(2)
+    assert_equal 0, Presence.count(3)
+  end
+end
diff --git a/test/models/question_test.rb b/test/models/question_test.rb
new file mode 100644
index 0000000..bc569b7
--- /dev/null
+++ b/test/models/question_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class QuestionTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+  end
+
+  test "a new question starts with four empty rows and is active" do
+    question = @quiz.questions.new
+    assert_equal 4, question.option_rows.size
+    assert question.option_rows.none?(&:filled?)
+    assert question.active?
+  end
+
+  test "saves filled rows as options in order and skips empty rows" do
+    question = @quiz.questions.new(text: "Which planet is the largest?")
+    question.option_rows = {
+      "0" => { text: "Jupiter", correct: "1" },
+      "1" => { text: "", correct: "0" },
+      "2" => { text: "  Saturn ", correct: "0" },
+      "10" => { text: "Earth", correct: "0" },
+      "3" => { text: "   ", correct: "1" }
+    }
+    assert question.save
+
+    assert_equal [ "Jupiter", "Saturn", "Earth" ], question.options.map(&:text)
+    assert_equal [ true, false, false ], question.options.map(&:correct)
+    assert_equal [ 1, 2, 3 ], question.options.map(&:position)
+  end
+
+  test "needs at least two options" do
+    question = @quiz.questions.new(text: "Lonely?")
+    question.option_rows = [ { text: "Yes", correct: "1" }, { text: "", correct: "0" } ]
+
+    assert_not question.save
+    assert_equal [ "Add at least two options" ], question.errors.full_messages
+    assert_equal 0, Option.count
+  end
+
+  test "needs a correct option" do
+    question = @quiz.questions.new(text: "Which?")
+    question.option_rows = [ { text: "A", correct: "0" }, { text: "B", correct: "0" }, { text: "", correct: "1" } ]
+
+    assert_not question.save
+    assert_equal [ "Mark at least one option as correct" ], question.errors.full_messages
+  end
+
+  test "several correct options are fine" do
+    question = @quiz.questions.new(text: "Which are primes?")
+    question.option_rows = [ { text: "2", correct: "1" }, { text: "3", correct: "1" }, { text: "4", correct: "0" } ]
+    assert question.save
+    assert_equal 2, question.options.count(&:correct)
+  end
+
+  test "needs a question text" do
+    question = @quiz.questions.new(text: "  ")
+    question.option_rows = [ { text: "A", correct: "1" }, { text: "B", correct: "0" } ]
+    assert_not question.save
+    assert_equal [ "Question can't be blank" ], question.errors.full_messages
+  end
+
+  test "a failed save keeps the rows as typed, empty ones included" do
+    question = @quiz.questions.new(text: "Which?")
+    question.option_rows = [ { text: "A ", correct: "0" }, { text: "", correct: "1" }, { text: "B", correct: "0" } ]
+    assert_not question.save
+
+    assert_equal [ "A ", "", "B" ], question.option_rows.map(&:text)
+    assert_equal [ false, true, false ], question.option_rows.map(&:correct?)
+  end
+
+  test "updating keeps the ids of remaining options and deletes removed ones" do
+    question = create_question(@quiz, "Which?", { "A" => true, "B" => false, "C" => false })
+    a, b, c = question.options.to_a
+
+    question.option_rows = [ { id: c.id, text: "C!", correct: "1" }, { id: a.id, text: "A", correct: "0" }, { text: "D", correct: "0" } ]
+    assert question.save
+
+    question.reload
+    assert_equal [ "C!", "A", "D" ], question.options.map(&:text)
+    assert_equal [ c.id, a.id ], question.options.first(2).map(&:id)
+    assert_equal [ true, false, false ], question.options.map(&:correct)
+    assert_not Option.exists?(b.id)
+  end
+
+  test "ignores option ids from other questions" do
+    other = create_question(@quiz, "Other?", { "X" => true, "Y" => false })
+    question = create_question(@quiz, "Which?", { "A" => true, "B" => false })
+
+    question.option_rows = [ { id: other.options.first.id, text: "Stolen", correct: "1" }, { text: "B", correct: "0" } ]
+    assert question.save
+    assert_equal [ "X", "Y" ], other.reload.options.map(&:text)
+    assert_equal [ "Stolen", "B" ], question.reload.options.map(&:text)
+  end
+
+  test "questions are appended in order and can be moved" do
+    first = create_question(@quiz, "First", { "A" => true, "B" => false })
+    second = create_question(@quiz, "Second", { "A" => true, "B" => false })
+    third = create_question(@quiz, "Third", { "A" => true, "B" => false })
+    assert_equal %w[ First Second Third ], @quiz.reload.questions.map(&:text)
+
+    assert third.move_up
+    assert_equal %w[ First Third Second ], @quiz.reload.questions.map(&:text)
+
+    assert first.reload.move_down
+    assert_equal %w[ Third First Second ], @quiz.reload.questions.map(&:text)
+
+    assert_not @quiz.questions.first.move_up
+    assert_not @quiz.questions.last.move_down
+    assert_equal %w[ Third First Second ], @quiz.reload.questions.map(&:text)
+  end
+
+  test "toggling active does not touch the options" do
+    question = create_question(@quiz, "Which?", { "A" => true, "B" => false })
+    assert question.update(active: false)
+    assert_not question.reload.active?
+    assert_equal 2, question.options.count
+  end
+end
diff --git a/test/models/quiz/export_test.rb b/test/models/quiz/export_test.rb
new file mode 100644
index 0000000..28ad1ea
--- /dev/null
+++ b/test/models/quiz/export_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Quiz::ExportTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+  end
+
+  test "writes exactly the title and the questions, in order, with active and correct" do
+    create_question(@quiz, "Which protocol keeps a two-way connection?", { "WebSocket" => true, "SMTP" => false })
+    create_question(@quiz, "What does CSS stand for?", { "Cascading Style Sheets" => true, "Computer Style System" => false }, false)
+    moved = create_question(@quiz, "Which HTTP status code means \"Too Many Requests\"?", { "418" => false, "429" => true })
+    2.times { moved.reload.move_up } # now first: the export follows the quiz order, not creation order
+
+    assert_equal({
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        { "text" => "Which HTTP status code means \"Too Many Requests\"?", "active" => true,
+          "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ] },
+        { "text" => "Which protocol keeps a two-way connection?", "active" => true,
+          "options" => [ { "text" => "WebSocket", "correct" => true }, { "text" => "SMTP", "correct" => false } ] },
+        { "text" => "What does CSS stand for?", "active" => false,
+          "options" => [ { "text" => "Cascading Style Sheets", "correct" => true }, { "text" => "Computer Style System", "correct" => false } ] }
+      ]
+    }, JSON.parse(Quiz::Export.new(@quiz.reload).to_json))
+  end
+
+  test "a quiz without questions" do
+    assert_equal({ "title" => "Frontend Fest 2026", "questions" => [] }, JSON.parse(Quiz::Export.new(@quiz).to_json))
+  end
+
+  test "settings of this Quizzy (the timer, the number of winners) are not exported" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30, winners_count: 5)
+    assert_equal({ "title" => "Frontend Fest 2026", "questions" => [] }, JSON.parse(Quiz::Export.new(@quiz).to_json))
+  end
+
+  test "the JSON is pretty-printed and keeps text as is" do
+    create_question(@quiz, "<b>Bold</b> & “quotes” 🎉\nsecond line", { "<i>" => true, "&amp;" => false })
+    json = Quiz::Export.new(@quiz.reload).to_json
+
+    assert_includes json, "\n  \"questions\": ["
+    assert_equal "<b>Bold</b> & “quotes” 🎉\nsecond line", JSON.parse(json).dig("questions", 0, "text")
+    assert_equal [ "<i>", "&amp;" ], JSON.parse(json).dig("questions", 0, "options").pluck("text")
+  end
+
+  test "file name" do
+    assert_equal "frontend-fest-2026.json", Quiz::Export.new(@quiz).filename
+    assert_equal "quiz.json", Quiz::Export.new(Quiz.new(title: "❓❓")).filename
+  end
+end
diff --git a/test/models/quiz/import_test.rb b/test/models/quiz/import_test.rb
new file mode 100644
index 0000000..536d913
--- /dev/null
+++ b/test/models/quiz/import_test.rb
@@ -0,0 +1,194 @@
+require "test_helper"
+
+class Quiz::ImportTest < ActiveSupport::TestCase
+  SAMPLE = {
+    "title" => "Frontend Fest 2026",
+    "questions" => [
+      { "text" => "Which HTTP status code means \"Too Many Requests\"?", "active" => true,
+        "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ] },
+      { "text" => "What does CSS stand for?", "active" => false,
+        "options" => [ { "text" => "Computer Style System", "correct" => false }, { "text" => "Cascading Style Sheets", "correct" => true } ] }
+    ]
+  }.freeze
+
+  def import(data)
+    Quiz::Import.new(json: data.is_a?(String) ? data : JSON.generate(data))
+  end
+
+  def assert_rejected(data, *messages)
+    import = import(data)
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      assert_not import.save
+    end
+    messages.each { |message| assert_includes import.errors.full_messages, message }
+    import
+  end
+
+  def question(text, options = [ { "text" => "A", "correct" => true }, { "text" => "B" } ], **rest)
+    { "text" => text, "options" => options }.merge(rest.transform_keys(&:to_s))
+  end
+
+  test "creates a new quiz with its questions and options in order" do
+    import = import(SAMPLE)
+    assert import.save, import.errors.full_messages.to_sentence
+
+    quiz = import.quiz.reload
+    assert_equal "Frontend Fest 2026", quiz.title
+    assert_equal [ "Which HTTP status code means \"Too Many Requests\"?", "What does CSS stand for?" ], quiz.questions.map(&:text)
+    assert_equal [ true, false ], quiz.questions.map(&:active)
+    assert_equal [ 1, 2 ], quiz.questions.map(&:position)
+    assert_equal [ [ "418", false ], [ "429", true ] ], quiz.questions.first.options.map { [ it.text, it.correct ] }
+    assert_equal [ [ "Computer Style System", false ], [ "Cascading Style Sheets", true ] ], quiz.questions.last.options.map { [ it.text, it.correct ] }
+  end
+
+  test "exporting the imported quiz gives the same JSON back" do
+    import = import(SAMPLE)
+    assert import.save
+    assert_equal SAMPLE, Quiz::Export.new(import.quiz.reload).as_json
+  end
+
+  test "active defaults to true and correct to false" do
+    import = import("title" => "Defaults", "questions" => [ { "text" => "Which?", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] } ])
+    assert import.save
+
+    question = import.quiz.questions.sole
+    assert question.active?
+    assert_equal [ true, false ], question.options.map(&:correct)
+  end
+
+  test "always creates a new quiz, even with a title that exists" do
+    existing = Quiz.create!(title: "Frontend Fest 2026")
+    create_question(existing, "Old question", { "Yes" => true, "No" => false })
+
+    assert_difference -> { Quiz.count } => 1 do
+      assert import(SAMPLE).save
+    end
+    assert_equal [ "Old question" ], existing.reload.questions.map(&:text)
+    assert_equal 2, Quiz.where(title: "Frontend Fest 2026").count
+  end
+
+  test "imported quizzes have no timer, even if the JSON has one" do
+    import = import(SAMPLE.merge("timer_minutes" => 1, "timer_seconds" => 30, "timer" => 90))
+    assert import.save
+    assert_equal [ 0, 0, false ], [ import.quiz.timer_minutes, import.quiz.timer_seconds, import.quiz.timer? ]
+  end
+
+  test "a quiz without questions" do
+    import = import("title" => "Empty", "questions" => [])
+    assert import.save
+    assert_empty import.quiz.questions
+  end
+
+  test "texts are normalized like in the forms, unknown keys are ignored" do
+    import = import("title" => "  Spaced  ", "id" => 7, "questions" => [
+      question("  Which?\r\nReally?  ", [ { "text" => " A ", "correct" => true, "id" => 3 }, { "text" => "B", "position" => 9 } ], position: 5)
+    ])
+    assert import.save
+    quiz = import.quiz.reload
+    assert_equal "Spaced", quiz.title
+    assert_equal "Which?\nReally?", quiz.questions.sole.text
+    assert_equal [ "A", "B" ], quiz.questions.sole.options.map(&:text)
+  end
+
+  test "accepts a byte order mark and surrounding whitespace" do
+    assert import("\uFEFF\n  #{JSON.pretty_generate(SAMPLE)}\n\n").save
+  end
+
+  test "empty options are skipped as in the question form" do
+    import = import("title" => "Skips", "questions" => [
+      question("Which?", [ { "text" => "", "correct" => true }, { "text" => "A", "correct" => true }, { "text" => "  " }, { "text" => "B" } ])
+    ])
+    assert import.save
+    assert_equal [ "A", "B" ], import.quiz.questions.sole.options.map(&:text)
+  end
+
+  test "invalid JSON" do
+    import = assert_rejected("{ \"title\": \"Broken\", ")
+    assert_match(/\AInvalid JSON: /, import.errors.full_messages.sole)
+
+    assert_rejected("", "Paste the JSON of a quiz")
+    assert_rejected("   \n ", "Paste the JSON of a quiz")
+    assert_rejected("not json")
+    assert_rejected('{"title": "A", "title": "B", "questions": []}')
+  end
+
+  test "the JSON must be an object" do
+    [ "[]", "\"Frontend Fest 2026\"", "42", "null" ].each do |json|
+      assert_rejected(json, 'The JSON must be an object with "title" and "questions"')
+    end
+  end
+
+  test "the quiz needs a title" do
+    assert_rejected({ "questions" => [] }, "Title can't be blank")
+    assert_rejected({ "title" => "  ", "questions" => [] }, "Title can't be blank")
+    assert_rejected({ "title" => 2026, "questions" => [] }, '"title" must be a string')
+  end
+
+  test "the quiz needs a list of questions" do
+    assert_rejected({ "title" => "Quiz" }, '"questions" must be a list of questions (it may be empty)')
+    assert_rejected({ "title" => "Quiz", "questions" => { "text" => "Which?" } }, '"questions" must be a list of questions (it may be empty)')
+  end
+
+  test "questions follow the rules of the question form" do
+    import = assert_rejected({ "title" => "Rules", "questions" => [
+      question("Fine"),
+      question("  "),
+      question("Lonely?", [ { "text" => "Yes", "correct" => true }, { "text" => "" } ]),
+      question("Which?", [ { "text" => "A" }, { "text" => "B", "correct" => false }, { "text" => "", "correct" => true } ]),
+      question("Nothing?", [])
+    ] })
+
+    assert_equal [
+      "Question 2: Question can't be blank",
+      "Question 3 “Lonely?”: Add at least two options",
+      "Question 4 “Which?”: Mark at least one option as correct",
+      "Question 5 “Nothing?”: Add at least two options",
+      "Question 5 “Nothing?”: Mark at least one option as correct"
+    ], import.errors.full_messages
+  end
+
+  test "nothing is stored when only the last question breaks a rule" do
+    questions = Array.new(5) { |index| question("Question number #{index + 1}") }
+    questions << question("Broken", [ { "text" => "Only", "correct" => true } ])
+    assert_rejected({ "title" => "All or nothing", "questions" => questions }, "Question 6 “Broken”: Add at least two options")
+    assert_not Quiz.exists?(title: "All or nothing")
+  end
+
+  test "a database failure halfway stores nothing" do
+    Quiz.connection.execute(<<~SQL)
+      CREATE TRIGGER fail_on_boom BEFORE INSERT ON options WHEN NEW.text = 'boom'
+      BEGIN SELECT RAISE(ABORT, 'boom'); END
+    SQL
+    questions = [ question("First"), question("Second", [ { "text" => "A", "correct" => true }, { "text" => "boom" } ]) ]
+
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      assert_raises(ActiveRecord::StatementInvalid) { import("title" => "Halfway", "questions" => questions).save }
+    end
+  end
+
+  test "types are checked" do
+    import = assert_rejected({ "title" => "Types", "questions" => [
+      "Which?",
+      { "text" => 42, "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      question("Active?", active: "yes"),
+      question("Options?").merge("options" => "A, B"),
+      question("Option types?", [ "A", { "text" => 429 }, { "correct" => true }, { "text" => "B", "correct" => 1 } ])
+    ] })
+
+    assert_equal [
+      'Question 1 must be an object with "text" and "options"',
+      'Question 2: "text" must be a string',
+      'Question 3 “Active?”: "active" must be true or false',
+      'Question 4 “Options?”: "options" must be a list of options',
+      'Question 5 “Option types?”, option 1 must be an object with "text"',
+      'Question 5 “Option types?”, option 2: "text" must be a string',
+      'Question 5 “Option types?”, option 3: "text" must be a string',
+      'Question 5 “Option types?”, option 4: "correct" must be true or false'
+    ], import.errors.full_messages
+  end
+
+  test "null is not a boolean" do
+    assert_rejected({ "title" => "Nulls", "questions" => [ question("Which?", active: nil) ] },
+      'Question 1 “Which?”: "active" must be true or false')
+  end
+end
diff --git a/test/models/quiz_test.rb b/test/models/quiz_test.rb
new file mode 100644
index 0000000..0e88b4d
--- /dev/null
+++ b/test/models/quiz_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class QuizTest < ActiveSupport::TestCase
+  test "needs a title" do
+    quiz = Quiz.new(title: "   ")
+    assert_not quiz.valid?
+    assert_equal [ "Title can't be blank" ], quiz.errors.full_messages
+  end
+
+  test "has 3 winners by default, at least 1" do
+    quiz = Quiz.new(title: "Quiz")
+    assert_equal 3, quiz.winners_count
+
+    [ 0, -2, nil, "", "two", "1.5", 10_001 ].each do |value|
+      quiz.winners_count = value
+      assert_not quiz.valid?, value.inspect
+      assert_equal [ "Winners must be a whole number from 1 to 10,000" ], quiz.errors.full_messages
+    end
+
+    quiz.winners_count = "1"
+    assert quiz.valid?
+  end
+
+  test "no timer by default; minutes and seconds make the time per question" do
+    quiz = Quiz.new(title: "Quiz")
+    assert_equal [ 0, 0 ], [ quiz.timer_minutes, quiz.timer_seconds ]
+    assert_nil quiz.timer_duration
+    assert_not quiz.timer?
+
+    quiz.assign_attributes(timer_minutes: "1", timer_seconds: "30")
+    assert quiz.valid?
+    assert_equal 90.seconds, quiz.timer_duration
+    assert quiz.timer?
+
+    quiz.assign_attributes(timer_minutes: "0", timer_seconds: "5")
+    assert_equal 5.seconds, quiz.timer_duration
+    quiz.assign_attributes(timer_minutes: "2", timer_seconds: "0")
+    assert_equal 2.minutes, quiz.timer_duration
+  end
+
+  test "timer minutes and seconds are whole numbers, seconds below a minute" do
+    quiz = Quiz.new(title: "Quiz")
+
+    [ -1, nil, "", "one", "1.5", 100 ].each do |value|
+      quiz.assign_attributes(timer_minutes: value, timer_seconds: 0)
+      assert_not quiz.valid?, value.inspect
+      assert_equal [ "Minutes must be a whole number from 0 to 99" ], quiz.errors.full_messages
+    end
+
+    [ -1, nil, "", "ten", "0.5", 60, 90 ].each do |value|
+      quiz.assign_attributes(timer_minutes: 0, timer_seconds: value)
+      assert_not quiz.valid?, value.inspect
+      assert_equal [ "Seconds must be a whole number from 0 to 59" ], quiz.errors.full_messages
+    end
+
+    quiz.assign_attributes(timer_minutes: "99", timer_seconds: "59")
+    assert quiz.valid?
+  end
+
+  test "deleting a quiz deletes its questions and options" do
+    quiz = Quiz.create!(title: "Gone soon")
+    create_question(quiz, "Which?", { "A" => true, "B" => false })
+
+    quiz.destroy!
+    assert_equal 0, Question.count
+    assert_equal 0, Option.count
+  end
+end
diff --git a/test/models/round_test.rb b/test/models/round_test.rb
new file mode 100644
index 0000000..c4ae668
--- /dev/null
+++ b/test/models/round_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class RoundTest < ActiveSupport::TestCase
+  setup do
+    quiz = Quiz.create!(title: "Quiz")
+    @question = create_question(quiz, "First?", { "A" => true, "B" => false })
+    @other = create_question(quiz, "Second?", { "C" => true, "D" => false })
+    @game = quiz.games.create!
+    @game.take_step("start", seen_version: 0)
+    @round = @game.current_round
+    @alice = @game.players.create!(name: "Alice", browser_token: "alice")
+    @a, @b = @question.options
+  end
+
+  test "records the pick and lets the player change it while open" do
+    answer = @round.record_answer(@alice, @a.id)
+    assert_equal [ @a, 1 ], [ answer.option, answer.revision ]
+
+    answer = @round.record_answer(@alice, @b.id)
+    assert_equal [ @b, 2 ], [ answer.option, answer.revision ]
+    assert_equal 1, @round.answers.count
+
+    assert_equal 2, @round.record_answer(@alice, @b.id).revision, "the same pick again changes nothing"
+    assert_equal({ @b.id => 1 }, @round.answer_counts)
+  end
+
+  test "refuses closed rounds, options of other questions and players of other games" do
+    assert_nil @round.record_answer(@alice, @other.options.first.id)
+    assert_nil @round.record_answer(@alice, 0)
+
+    stranger = Quiz.first.games.create!.players.create!(name: "Eve", browser_token: "eve")
+    assert_nil @round.record_answer(stranger, @a.id)
+
+    @round.record_answer(@alice, @a.id)
+    @game.take_step("finish", seen_version: @game.version)
+    assert_nil @round.reload.record_answer(@alice, @b.id)
+    assert_equal @a, @round.answers.sole.option
+  end
+
+  test "refuses picks once the time is up, even before the round is closed" do
+    @round.update!(opened_at: Time.zone.local(2026, 10, 8, 10, 0, 0), closes_at: Time.zone.local(2026, 10, 8, 10, 0, 10))
+
+    travel_to Time.zone.local(2026, 10, 8, 10, 0, 9) do
+      assert_equal 1.0, @round.time_left
+      assert @round.record_answer(@alice, @a.id)
+    end
+    travel_to Time.zone.local(2026, 10, 8, 10, 0, 10) do
+      assert @round.open?
+      assert @round.time_up?
+      assert_equal 0.0, @round.time_left
+      assert_nil @round.record_answer(@alice, @b.id)
+    end
+    assert_equal @a, @round.answers.sole.option
+  end
+
+  test "remembers when the question opened and how long each pick took" do
+    assert_in_delta Time.current, @round.opened_at, 5.seconds
+
+    @round.update!(opened_at: Time.zone.local(2026, 10, 8, 10, 0, 0))
+    travel_to Time.zone.local(2026, 10, 8, 10, 0, 2) do
+      assert_equal 2_000_000, @round.record_answer(@alice, @a.id).elapsed_us
+    end
+    travel_to Time.zone.local(2026, 10, 8, 10, 0, 5) do
+      assert_equal 2_000_000, @round.record_answer(@alice, @a.id).elapsed_us, "the same pick again"
+      assert_equal 5_000_000, @round.record_answer(@alice, @b.id).elapsed_us, "a new pick"
+    end
+  end
+end
diff --git a/test/system/games_test.rb b/test/system/games_test.rb
new file mode 100644
index 0000000..58461cf
--- /dev/null
+++ b/test/system/games_test.rb
@@ -0,0 +1,339 @@
+require "application_system_test_case"
+
+# A whole live game: the moderator's big screen and several phones, each in
+# its own browser session.
+class GamesTest < ApplicationSystemTestCase
+  setup do
+    Presence.reset
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+    create_question(@quiz, "Which status code means Too Many Requests?", { "418" => false, "429" => true, "503" => false })
+    create_question(@quiz, "Skipped while inactive", { "Yes" => true, "No" => false }, false)
+    create_question(@quiz, "Which protocol keeps a two-way connection?", { "WebSocket" => true, "SMTP" => false })
+  end
+
+  test "playing a game from the big screen and phones" do
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_button "Start a game"
+
+    assert_current_path %r{\A/moderate/games/\d+\z}
+    assert_text "Frontend Fest 2026"
+    assert_text "Players: 0"
+    join_link = find(".lobby__url").text
+    assert_match %r{\A[\d.]+:\d+/play/[A-Z0-9]{5}\z}, join_link
+    assert_selector ".qr svg[role=img]"
+
+    join_as :alice, "Alice", join_link
+    join_as :bob, "Bob", join_link
+    assert_text "Players: 2"
+
+    click_button "Start"
+    assert_text "Question 1 of 2"
+    assert_text "Which status code means Too Many Requests?"
+    assert_text "Answers: 0 / 2"
+    assert_no_text "Correct"
+
+    using_session(:alice) do
+      assert_text "Question 1 of 2"
+      assert_no_match(/correct/i, page.html)
+      click_button "418"
+      assert_selector "button.is-picked", text: "418"
+      assert_selector "button", text: "Your answer", count: 1
+      click_button "429" # changing the pick: the last one counts
+      assert_selector "button.is-picked", text: "429"
+      assert_selector "button", text: "Your answer", count: 1
+    end
+    assert_text "Answers: 1 / 2"
+
+    click_button "Finish"
+    assert_selector "li", text: /429\s*Correct\s*1/
+    assert_selector "li", text: /418\s*0/
+    assert_selector "li", text: "Correct", count: 1
+
+    using_session(:alice) { assert_text "Correct!" }
+    using_session(:bob) { assert_text "No answer" }
+
+    click_button "Next"
+    assert_text "Question 2 of 2"
+    assert_text "Which protocol keeps a two-way connection?"
+    assert_no_text "Skipped while inactive"
+
+    using_session(:bob) do
+      assert_text "Which protocol keeps a two-way connection?"
+      click_button "SMTP"
+      assert_selector "button.is-picked", text: "SMTP"
+    end
+    assert_text "Answers: 1 / 2"
+
+    click_button "Finish"
+    assert_no_button "Next"
+    using_session(:bob) { assert_text "Wrong!" }
+    using_session(:alice) { assert_text "No answer" }
+
+    click_button "End quiz"
+    assert_text "The quiz is over"
+    using_session(:alice) { assert_text "The quiz is over" }
+    using_session(:bob) { assert_text "The quiz is over" }
+
+    using_session(:carol) do
+      visit "http://#{join_link}"
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+  end
+
+  test "the leaderboard ranks by points, then speed, and the winners show up live" do
+    @quiz.update!(winners_count: 2)
+    game = @quiz.games.create!
+    visit "/moderate/games/#{game.id}"
+    %w[ Alice Bob Carol Dave ].each { |name| join_as name.downcase.to_sym, name, "/play/#{game.code}" }
+    assert_text "Players: 4"
+
+    click_button "Start"
+    pick :bob, "429"   # right, first
+    pick :alice, "429" # right, second
+    pick :carol, "418" # wrong
+    assert_text "Answers: 3 / 4"
+    click_button "Finish"
+    using_session(:alice) do
+      assert_text "Correct!"
+      assert_no_text(/points?\b/)
+    end
+
+    click_button "Next"
+    pick :alice, "WebSocket" # right
+    pick :carol, "WebSocket" # right
+    assert_text "Answers: 2 / 4"
+    click_button "Finish"
+    click_button "End quiz"
+
+    assert_text "The quiz is over"
+    items = all("ol li", count: 4)
+    assert_match(/\A1\s*Alice\s*2 points\z/, items[0].text)
+    assert_match(/\A2\s*Bob\s*1 point\z/, items[1].text, "Bob and Carol have 1 point; Bob was faster")
+    assert_match(/\A3\s*Carol\s*1 point\z/, items[2].text)
+    assert_match(/\A4\s*Dave\s*0 points\z/, items[3].text)
+    assert_no_text "Winner"
+
+    using_session(:alice) { assert_text "Place 1 of 4"; assert_text "2 points"; assert_no_text "You won!" }
+    using_session(:bob) { assert_text "Place 2 of 4"; assert_text "1 point" }
+    using_session(:dave) { assert_text "Place 4 of 4"; assert_text "0 points" }
+
+    click_button "Top 2"
+    assert_selector "li", text: /Alice.*Winner/m
+    assert_selector "li", text: /Bob.*Winner/m
+    assert_selector "li", text: "Winner", count: 2
+    using_session(:alice) { assert_text "You won!" }
+    using_session(:bob) { assert_text "You won!" }
+    using_session(:carol) { assert_text "Place 3 of 4"; assert_no_text "You won!" }
+
+    click_button "Reset winners"
+    assert_no_selector "li", text: "Winner"
+    using_session(:alice) { assert_no_text "You won!" }
+    using_session(:bob) { assert_no_text "You won!" }
+  end
+
+  test "Draw picks among the players tied on the last prize's points" do
+    @quiz.update!(winners_count: 1)
+    game = @quiz.games.create!
+    visit "/moderate/games/#{game.id}"
+    join_as :alice, "Alice", "/play/#{game.code}"
+    join_as :bob, "Bob", "/play/#{game.code}"
+    join_as :carol, "Carol", "/play/#{game.code}"
+
+    click_button "Start"
+    pick :alice, "429"
+    pick :bob, "429"
+    assert_text "Answers: 2 / 3"
+    click_button "Finish"
+    click_button "Next"
+    click_button "Finish"
+    click_button "End quiz"
+
+    click_button "Top 1"
+    assert_selector "li", text: /Alice.*Winner/m
+    using_session(:alice) { assert_text "You won!" }
+
+    winners = []
+    20.times do
+      click_button "Draw"
+      assert_selector "li", text: "Winner", count: 1
+      winner = find("li", text: "Winner").text[/Alice|Bob/]
+      winners << winner
+      break if winners.uniq.size == 2
+    end
+    assert_equal %w[ Alice Bob ], winners.uniq.sort, "each click draws again, speed does not matter"
+    assert_no_selector "li", text: /Carol.*Winner/m
+
+    loser = (%w[ Alice Bob ] - [ winners.last ]).first
+    using_session(winners.last.downcase.to_sym) { assert_text "You won!" }
+    using_session(loser.downcase.to_sym) { assert_text "Place"; assert_no_text "You won!" }
+    using_session(:carol) { assert_text "Place 3 of 3"; assert_text "0 points"; assert_no_text "You won!" }
+  end
+
+  test "without WebSockets, phones and screens still follow the end and the winners" do
+    @quiz.update!(winners_count: 1)
+    game = @quiz.games.create!
+    visit "/moderate/games/#{game.id}"
+    using_session(:alice) { break_websockets }
+    join_as :alice, "Alice", "/play/#{game.code}"
+    using_session(:second_screen) do
+      break_websockets
+      page.driver.basic_authorize(MODERATOR_USERNAME, MODERATOR_PASSWORD)
+      visit "/moderate/games/#{game.id}"
+    end
+
+    using_session(:alice) { assert_equal 3, evaluate_script("new WebSocket('ws://localhost/cable').readyState") }
+
+    click_button "Start"
+    using_session(:alice) do
+      assert_text "Question 1 of 2", wait: 8 # polling, every 3 s
+      click_button "429"
+      assert_selector "button.is-picked", text: "429"
+    end
+    click_button "Finish"
+    click_button "Next"
+    click_button "Finish"
+    click_button "End quiz"
+
+    using_session(:alice) { assert_text "Place 1 of 1", wait: 8; assert_text "1 point" }
+    click_button "Top 1"
+    using_session(:alice) { assert_text "You won!", wait: 8 }
+    using_session(:second_screen) { assert_selector "li", text: /Alice.*Winner/m, wait: 5 }
+  end
+
+  test "the browser remembers the player, who can join at any time" do
+    game = @quiz.games.create!
+    visit "/moderate/games/#{game.id}"
+    click_button "Start"
+    assert_text "Question 1 of 2"
+
+    join_as :alice, "Alice", "/play/#{game.code}"
+    using_session(:alice) do
+      assert_text "Which status code means Too Many Requests?"
+      click_button "503"
+      assert_selector "button.is-picked", text: "503"
+
+      visit "/play/#{game.code.downcase}"
+      assert_text "Hi, Alice!"
+      assert_no_field "Your name"
+      assert_selector "button.is-picked", text: "503"
+    end
+    assert_text "Answers: 1 / 1"
+  end
+
+  test "players who leave are no longer counted" do
+    game = @quiz.games.create!
+    visit "/moderate/games/#{game.id}"
+
+    join_as :alice, "Alice", "/play/#{game.code}"
+    join_as :bob, "Bob", "/play/#{game.code}"
+    assert_text "Players: 2"
+
+    using_session(:bob) { visit "/" }
+    assert_text "Players: 1"
+  end
+
+  test "with a timer, the big screen counts down and the question finishes by itself at 0:00" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 6)
+    game = @quiz.games.create!
+    visit "/moderate/games/#{game.id}"
+    join_as :alice, "Alice", "/play/#{game.code}"
+    join_as :bob, "Bob", "/play/#{game.code}"
+    assert_text "Players: 2"
+    assert_no_selector "[role=timer]"
+
+    click_button "Start"
+    assert_text "Question 1 of 2"
+    started = Time.current
+    assert_selector "[role=timer]", text: /\A0:0[1-6]\z/
+
+    using_session(:alice) do
+      assert_text "Which status code means Too Many Requests?"
+      assert_no_selector "[role=timer]"
+      assert_no_text(/\d:\d\d/, wait: 0) # players never see the timer
+      click_button "429"
+      assert_selector "button.is-picked", text: "429"
+    end
+
+    # A reload carries on with the time left; it does not start over at 0:06.
+    sleep 0.05 until Time.current - started >= 2.5
+    visit current_url
+    assert_selector "[role=timer]", text: /\A0:0[1-4]\z/
+    assert_button "Finish"
+
+    assert_selector "li", text: /429\s*Correct\s*1/, wait: 10
+    finished_after = Time.current - started
+    assert_operator finished_after, :<, 8.5, "it finished at 0:00 (after #{finished_after.round(1)} s)"
+    assert_no_selector "[role=timer]"
+    assert_no_button "Finish"
+    assert_button "Next"
+    using_session(:alice) { assert_text "Correct!" }
+    using_session(:bob) do
+      assert_text "No answer"
+      assert_selector "button.play-option[disabled]", count: 3
+    end
+
+    click_button "Next"
+    assert_text "Question 2 of 2"
+    assert_selector "[role=timer]", text: /\A0:0[1-6]\z/, wait: 2
+  end
+
+  test "with a timer, the moderator can still finish earlier" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    game = @quiz.games.create!
+    visit "/moderate/games/#{game.id}"
+    click_button "Start"
+    assert_text "Question 1 of 2"
+    assert_selector "[role=timer]", text: /\A1:(30|29)\z/
+
+    click_button "Finish"
+    assert_selector "li", text: /429\s*Correct\s*0/
+    assert_no_selector "[role=timer]"
+    assert_button "Next"
+  end
+
+  test "a second big screen follows the game" do
+    game = @quiz.games.create!
+    visit "/moderate/games/#{game.id}"
+
+    using_session(:second_screen) do
+      page.driver.basic_authorize(MODERATOR_USERNAME, MODERATOR_PASSWORD)
+      visit "/moderate/games/#{game.id}"
+      assert_button "Start"
+    end
+
+    click_button "Start"
+    assert_text "Question 1 of 2"
+    using_session(:second_screen) { assert_text "Question 1 of 2" }
+  end
+
+  private
+    # The page's WebSockets close at once, as on Wi-Fi that blocks them.
+    def break_websockets
+      page.driver.browser.page.command("Page.addScriptToEvaluateOnNewDocument", source: <<~JS)
+        window.WebSocket = class extends EventTarget {
+          constructor() { super(); this.readyState = 3; setTimeout(() => { this.onclose?.(new CloseEvent("close")); this.dispatchEvent(new CloseEvent("close")) }) }
+          send() {}
+          close() {}
+        }
+      JS
+    end
+
+    def pick(session, option)
+      using_session(session) do
+        click_button option
+        assert_selector "button.is-picked", text: option
+        assert_no_text "Sending…"
+      end
+    end
+
+    def join_as(session, name, link)
+      using_session(session) do
+        visit link.start_with?("/") ? link : "http://#{link}"
+        fill_in "Your name", with: name
+        click_button "Join"
+        assert_text "Hi, #{name}!"
+      end
+    end
+end
