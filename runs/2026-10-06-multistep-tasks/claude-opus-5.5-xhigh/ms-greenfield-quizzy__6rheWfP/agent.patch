@@ -0,0 +1,45 @@
+import { Controller } from "@hotwired/stimulus"
+
+// The option rows of the question form: "Add option" appends a row with the
+// next number, the ✕ button removes a row. Rows are always numbered 1, 2, 3...
+// in the order they are shown; the index in the field names only has to be
+// unique, so it keeps counting up.
+export default class extends Controller {
+  static targets = ["list", "row", "template", "text", "correct", "correctLabel", "remove"]
+  static values = { nextIndex: Number }
+
+  add() {
+    const number = this.rowTargets.length + 1
+    const html = this.templateTarget.innerHTML
+      .replaceAll("__INDEX__", this.nextIndexValue)
+      .replaceAll("__NUMBER__", number)
+    this.nextIndexValue++
+
+    this.listTarget.insertAdjacentHTML("beforeend", html)
+    this.rowTargets[this.rowTargets.length - 1].querySelector("input[type=text]")?.focus()
+  }
+
+  remove(event) {
+    const row = event.target.closest("[data-option-rows-target~=row]")
+    const next = row.nextElementSibling ?? row.previousElementSibling
+    row.remove()
+    this.renumber()
+    ;(next?.querySelector("input[type=text]") ?? this.element.querySelector("[data-action~='option-rows#add']"))?.focus()
+  }
+
+  renumber() {
+    this.rowTargets.forEach((row, i) => {
+      const number = i + 1
+      const text = row.querySelector("[data-option-rows-target~=text]")
+      text.placeholder = `Option ${number}`
+      text.setAttribute("aria-label", `Option ${number}`)
+
+      row.querySelector("[data-option-rows-target~=correct]").setAttribute("aria-label", `Option ${number} is correct`)
+      row.querySelector("[data-option-rows-target~=correctLabel]").textContent = `Option ${number} is correct`
+
+      const remove = row.querySelector("[data-option-rows-target~=remove]")
+      remove.title = `Remove option ${number}`
+      remove.setAttribute("aria-label", `Remove option ${number}`)
+    })
+  }
+}
diff --git a/app/javascript/controllers/play_controller.js b/app/javascript/controllers/play_controller.js
new file mode 100644
index 0000000..fd2d948
--- /dev/null
+++ b/app/javascript/controllers/play_controller.js
@@ -0,0 +1,286 @@
+import { Controller } from "@hotwired/stimulus"
+import { cable } from "@hotwired/turbo-rails"
+
+// A player's phone (play/games/show). The server renders the stage (lobby,
+// question, results, end) and this controller keeps it live, on crowded
+// conference Wi-Fi too:
+//
+// - PlayChannel pushes every step of the game. Right after (re)connecting and
+//   then every SYNC_INTERVAL, the phone sends "sync" with the version it shows;
+//   the server answers only if it has something newer. Syncing is also the
+//   heartbeat that keeps the player counted on the big screen.
+// - Without a live connection (WebSockets blocked, Wi-Fi trouble), the phone
+//   polls the stage over HTTP instead, and stops as soon as the cable is back.
+// - Tapping an option marks it right away and posts it. Picks are sent one at
+//   a time, only the latest one is kept, and failed posts are retried while
+//   the question is still open. The server's reply (the stage with the saved
+//   pick) is what stays on screen.
+//
+// Every stage carries data-version (bumped by each step of the game) and
+// data-revision (bumped by each change of the player's pick); older stages
+// arriving late are ignored.
+const SYNC_INTERVAL = 10_000
+const POLL_INTERVAL = 3_000
+const CABLE_GRACE = 3_000
+const SLOW_SEND = 1_500
+
+export default class extends Controller {
+  static targets = [ "stage", "connection" ]
+  static values = { code: String, stageUrl: String, answerUrl: String }
+
+  connect() {
+    this.disconnected = false
+    this.away = false
+    this.pending = null
+    this.sending = false
+    this.cableConnected = false
+    this.schedulePoll(CABLE_GRACE)
+    this.subscribe()
+
+    this.onVisibilityChange = () => { if (document.visibilityState === "visible") this.refresh() }
+    this.onOnline = () => this.refresh()
+    this.onPageHide = () => this.leave()
+    this.onPageShow = (event) => { if (event.persisted) this.comeBack() }
+    document.addEventListener("visibilitychange", this.onVisibilityChange)
+    window.addEventListener("online", this.onOnline)
+    window.addEventListener("pagehide", this.onPageHide)
+    window.addEventListener("pageshow", this.onPageShow)
+  }
+
+  disconnect() {
+    this.disconnected = true
+    clearTimeout(this.pollTimer)
+    clearInterval(this.syncTimer)
+    clearTimeout(this.slowTimer)
+    this.subscription?.unsubscribe()
+    this.subscription = null
+    document.removeEventListener("visibilitychange", this.onVisibilityChange)
+    window.removeEventListener("online", this.onOnline)
+    window.removeEventListener("pagehide", this.onPageHide)
+    window.removeEventListener("pageshow", this.onPageShow)
+  }
+
+  // Leaving the page (closing it, going elsewhere) leaves the game at once: the
+  // browser may keep the page, and its WebSocket, alive in its back/forward
+  // cache. Coming back from that cache joins in again.
+  leave() {
+    this.away = true
+    clearTimeout(this.pollTimer)
+    clearInterval(this.syncTimer)
+    this.cableConnected = false
+    this.subscription?.unsubscribe()
+    this.subscription = null
+    this.consumer?.disconnect()
+  }
+
+  comeBack() {
+    this.away = false
+    this.consumer?.connect()
+    this.schedulePoll(CABLE_GRACE)
+    this.subscribe()
+    this.refresh()
+  }
+
+  // The stage shown now.
+
+  get stage() {
+    return this.stageTarget.firstElementChild
+  }
+
+  get version() {
+    return Number(this.stage?.dataset.version ?? -1)
+  }
+
+  get revision() {
+    return Number(this.stage?.dataset.revision ?? 0)
+  }
+
+  // Shows a stage from the server unless the one on screen is newer.
+  apply(payload) {
+    if (!payload || this.disconnected) return
+    if (payload.gone) return this.reload()
+
+    const { version, revision, html } = payload
+    if (version < this.version) return
+    if (version === this.version && revision <= this.revision && !this.pending) return
+    if (version === this.version && revision < this.revision) return
+
+    this.stageTarget.innerHTML = html
+
+    if (this.pending) {
+      if (this.pending.version === version) {
+        this.markPicked(this.pending.optionId) // not confirmed yet: keep showing the tap
+      } else {
+        this.pending = null // the question has moved on
+      }
+    }
+  }
+
+  // Live connection.
+
+  async subscribe() {
+    this.consumer = await cable.getConsumer()
+    const subscription = this.consumer.subscriptions.create({ channel: "PlayChannel", code: this.codeValue }, {
+      connected: () => this.cableConnectedChanged(true),
+      disconnected: () => this.cableConnectedChanged(false),
+      rejected: () => this.cableConnectedChanged(false), // polling finds out why (a 404 reloads the page)
+      received: (payload) => this.apply(payload)
+    })
+
+    if (this.disconnected || this.away) {
+      subscription.unsubscribe()
+    } else {
+      this.subscription = subscription
+    }
+  }
+
+  cableConnectedChanged(connected) {
+    this.cableConnected = connected
+    clearInterval(this.syncTimer)
+
+    if (connected) {
+      clearTimeout(this.pollTimer)
+      this.showProblem(null)
+      this.sync()
+      this.syncTimer = setInterval(() => this.sync(), SYNC_INTERVAL)
+    } else {
+      this.schedulePoll(1_000)
+    }
+  }
+
+  sync() {
+    this.subscription?.perform("sync", { version: this.version, revision: this.revision })
+  }
+
+  // Polling (only while the cable is down) and catching up after a phone wakes up.
+
+  schedulePoll(delay) {
+    clearTimeout(this.pollTimer)
+    this.pollTimer = setTimeout(() => this.poll({ fallback: true }), delay)
+  }
+
+  refresh() {
+    if (this.cableConnected) this.sync()
+    this.poll({ fallback: !this.cableConnected })
+  }
+
+  async poll({ fallback }) {
+    if (this.disconnected || this.away) return
+    if (fallback && this.cableConnected) return
+
+    const url = new URL(this.stageUrlValue, window.location.href)
+    url.searchParams.set("version", this.version)
+    url.searchParams.set("revision", this.revision)
+    if (fallback) url.searchParams.set("fallback", "1")
+
+    try {
+      const response = await fetch(url, { headers: { Accept: "application/json" }, credentials: "same-origin", cache: "no-store" })
+      if (response.status === 404) return this.reload()
+      if (response.ok && response.status !== 204) this.apply(await response.json())
+      if (response.ok) this.showProblem(null)
+    } catch (error) {
+      if (!this.cableConnected) this.showProblem("No connection. Trying again…")
+    }
+
+    if (fallback && !this.cableConnected) this.schedulePoll(POLL_INTERVAL)
+  }
+
+  // Picks.
+
+  pick(event) {
+    const form = event.target
+    if (!(form instanceof HTMLFormElement) || !this.stageTarget.contains(form)) return
+
+    event.preventDefault()
+    const button = form.querySelector("button")
+    const optionId = form.elements.option_id?.value
+    if (!optionId || button?.disabled) return
+
+    this.pending = { optionId, version: this.version }
+    this.markPicked(optionId)
+    this.send()
+  }
+
+  async send() {
+    if (this.sending) return
+    this.sending = true
+    let failures = 0
+
+    while (this.pending && !this.disconnected) {
+      const pick = this.pending
+      clearTimeout(this.slowTimer)
+      this.slowTimer = setTimeout(() => this.showProblem("Sending…"), SLOW_SEND)
+
+      try {
+        const response = await fetch(this.answerUrlValue, {
+          method: "POST",
+          credentials: "same-origin",
+          headers: { Accept: "application/json", "X-CSRF-Token": csrfToken() },
+          body: new URLSearchParams({ option_id: pick.optionId })
+        })
+
+        if (response.status === 404 || response.status === 422) return this.reload() // gone, or an outdated page
+        if (!response.ok && response.status !== 409) throw new Error(`HTTP ${response.status}`)
+
+        const payload = await response.json()
+        if (this.pending === pick) this.pending = null
+        this.apply(payload)
+        failures = 0
+        clearTimeout(this.slowTimer)
+        this.showProblem(null)
+      } catch (error) {
+        clearTimeout(this.slowTimer)
+        this.showProblem("Not sent yet. Trying again…")
+        await sleep(Math.min(1_000 * ++failures, 5_000))
+        if (this.pending && this.pending.version !== this.version) this.pending = null
+      }
+    }
+
+    this.sending = false
+    if (!this.pending) this.showProblem(null)
+  }
+
+  // Marks the tapped option the way the server renders a saved pick.
+  markPicked(optionId) {
+    this.stageTarget.querySelectorAll("form").forEach((form) => {
+      const button = form.querySelector("button.play-option")
+      if (!button) return
+
+      const picked = form.elements.option_id?.value === String(optionId)
+      button.classList.toggle("is-picked", picked)
+      button.setAttribute("aria-pressed", String(picked))
+
+      const mark = button.querySelector("[data-pick-mark]")
+      if (picked && !mark) {
+        const element = document.createElement("span")
+        element.className = "play-option__mark"
+        element.setAttribute("aria-hidden", "true")
+        element.dataset.pickMark = ""
+        element.textContent = "Your answer"
+        button.querySelector(".play-option__title")?.after(element)
+      } else if (!picked && mark) {
+        mark.remove()
+      }
+    })
+  }
+
+  showProblem(message) {
+    if (!this.hasConnectionTarget) return
+    this.connectionTarget.textContent = message ?? ""
+    this.connectionTarget.hidden = !message
+  }
+
+  reload() {
+    if (this.reloading) return
+    this.reloading = true
+    window.location.reload()
+  }
+}
+
+function csrfToken() {
+  return document.querySelector("meta[name=csrf-token]")?.content ?? ""
+}
+
+function sleep(milliseconds) {
+  return new Promise((resolve) => setTimeout(resolve, milliseconds))
+}
diff --git a/app/javascript/controllers/preview_controller.js b/app/javascript/controllers/preview_controller.js
new file mode 100644
index 0000000..5f2c7e3
--- /dev/null
+++ b/app/javascript/controllers/preview_controller.js
@@ -0,0 +1,118 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Plays the active questions of a quiz in the browser, one at a time, the way
+// a player would. Nothing is sent to the server: answers are not stored.
+//
+// Only the current step is in the DOM (no hidden copies of the other
+// questions), so texts like "Correct!" or "Next question" appear once.
+export default class extends Controller {
+  static targets = ["stage"]
+  static values = { questions: Array }
+
+  connect() {
+    if (this.hasStageTarget) this.startOver()
+  }
+
+  startOver() {
+    this.index = 0
+    this.score = 0
+    this.renderQuestion()
+  }
+
+  next() {
+    this.index++
+    if (this.index < this.questionsValue.length) {
+      this.renderQuestion()
+    } else {
+      this.renderScore()
+    }
+  }
+
+  get question() {
+    return this.questionsValue[this.index]
+  }
+
+  get isLastQuestion() {
+    return this.index === this.questionsValue.length - 1
+  }
+
+  renderQuestion() {
+    const total = this.questionsValue.length
+    this.answered = false
+
+    this.optionsElement = element("div", { class: "play-options" })
+    this.question.options.forEach((option, index) => {
+      const button = element("button", { type: "button", class: "play-option" }, [
+        element("span", { class: "play-option__letter", "aria-hidden": "true" }, letter(index)),
+        element("span", { class: "play-option__title" }, option.text)
+      ])
+      button.addEventListener("click", () => this.pick(index))
+      this.optionsElement.append(button)
+    })
+
+    this.feedbackElement = element("div", { class: "play-feedback" })
+
+    const nextButton = element("button", { type: "button", class: "btn btn--lg play-next" },
+      this.isLastQuestion ? "See score" : "Next question")
+    nextButton.addEventListener("click", () => this.next())
+
+    this.stageTarget.replaceChildren(
+      element("div", { class: "play-question__num" }, `Question ${this.index + 1} of ${total}`),
+      element("div", { class: "play-question__body" }, this.question.text),
+      this.optionsElement,
+      this.feedbackElement,
+      element("div", { class: "play-actions" }, [ nextButton ])
+    )
+  }
+
+  pick(pickedIndex) {
+    if (this.answered) return
+    this.answered = true
+
+    const options = this.question.options
+    const correct = options[pickedIndex].correct
+    if (correct) this.score++
+
+    this.optionsElement.classList.add("is-locked", "is-revealed")
+    Array.from(this.optionsElement.children).forEach((button, index) => {
+      button.disabled = true
+      const picked = index === pickedIndex
+      button.classList.toggle("is-picked", picked)
+      button.classList.toggle("is-correct", options[index].correct)
+      if (picked) button.setAttribute("aria-pressed", "true")
+
+      if (options[index].correct) {
+        button.append(element("span", { class: "play-option__mark", "aria-hidden": "true" }, "✓"))
+      } else if (picked) {
+        button.append(element("span", { class: "play-option__mark", "aria-hidden": "true" }, "✗"))
+      }
+    })
+
+    this.feedbackElement.replaceChildren(
+      element("div", { class: `play-status play-status--${correct ? "right" : "wrong"}`, role: "status" },
+        correct ? "Correct!" : "Wrong!")
+    )
+  }
+
+  renderScore() {
+    const total = this.questionsValue.length
+    this.stageTarget.replaceChildren(
+      element("div", { class: "result-card" }, [
+        element("div", { class: "result-card__label" }, "Preview finished"),
+        element("div", { class: "result-card__place", "aria-hidden": "true" }, `${this.score}/${total}`),
+        element("div", { class: "result-card__score" }, `Score: ${this.score}/${total}`)
+      ])
+    )
+  }
+}
+
+function letter(index) {
+  return index < 26 ? String.fromCharCode(65 + index) : String(index + 1)
+}
+
+function element(tag, attributes = {}, children = []) {
+  const node = document.createElement(tag)
+  for (const [name, value] of Object.entries(attributes)) node.setAttribute(name, value)
+  node.append(...[].concat(children))
+  return node
+}
diff --git a/app/javascript/controllers/screen_controller.js b/app/javascript/controllers/screen_controller.js
new file mode 100644
index 0000000..42b9f0d
--- /dev/null
+++ b/app/javascript/controllers/screen_controller.js
@@ -0,0 +1,120 @@
+import { Controller } from "@hotwired/stimulus"
+import { cable } from "@hotwired/turbo-rails"
+
+// The big screen of a game (moderate/games/show). When the game changes
+// elsewhere (the moderator clicks on another screen or laptop), the page
+// refreshes in place (Turbo morphing) at once: ScreenChannel pushes the new
+// version over Action Cable. The moderator's own buttons re-render the page
+// directly.
+//
+// It also polls the live numbers once a second ("Players: 2", "Answers: 1 / 2").
+// With a question timer, the countdown (countdown_controller.js) asks for a
+// poll at 0:00, when the question finishes by itself.
+// The poll carries the version too, so a screen without a live connection
+// still follows within a second, and catches up by itself after a hiccup.
+const POLL_INTERVAL = 1_000
+const REFRESH_RETRY = 5_000
+
+export default class extends Controller {
+  static targets = [ "players", "answers" ]
+  static values = { countersUrl: String, version: Number, token: String }
+
+  connect() {
+    this.running = true
+    this.latestVersion = this.versionValue
+    this.submitting = false
+    this.onSubmitStart = () => { this.submitting = true }
+    this.onSubmitEnd = () => { this.submitting = false }
+    document.addEventListener("turbo:submit-start", this.onSubmitStart)
+    document.addEventListener("turbo:submit-end", this.onSubmitEnd)
+
+    this.schedule(POLL_INTERVAL)
+    this.subscribe()
+  }
+
+  disconnect() {
+    this.running = false
+    clearTimeout(this.timer)
+    clearTimeout(this.followTimer)
+    document.removeEventListener("turbo:submit-start", this.onSubmitStart)
+    document.removeEventListener("turbo:submit-end", this.onSubmitEnd)
+    this.subscription?.unsubscribe()
+    this.subscription = null
+  }
+
+  async subscribe() {
+    if (!this.hasTokenValue || !this.tokenValue) return
+
+    try {
+      const consumer = await cable.getConsumer()
+      const subscription = consumer.subscriptions.create({ channel: "ScreenChannel", token: this.tokenValue }, {
+        received: ({ version }) => this.follow(version)
+      })
+      if (this.running) {
+        this.subscription = subscription
+      } else {
+        subscription.unsubscribe()
+      }
+    } catch (error) {
+      // No live connection: polling keeps the screen in step.
+    }
+  }
+
+  // The countdown reached 0:00 (countdown_controller.js). The server finishes
+  // the question by itself and pushes the change; poll at once too, in case
+  // the push is late (or the cable is down).
+  timeUp() {
+    if (this.running) this.schedule(0)
+  }
+
+  schedule(delay) {
+    clearTimeout(this.timer)
+    this.timer = setTimeout(() => this.poll(), delay)
+  }
+
+  async poll() {
+    try {
+      const response = await fetch(this.countersUrlValue, {
+        headers: { Accept: "application/json" }, credentials: "same-origin", cache: "no-store"
+      })
+      if (response.ok) this.update(await response.json())
+    } catch (error) {
+      // Offline for a moment: try again on the next tick.
+    }
+
+    if (this.running) this.schedule(POLL_INTERVAL)
+  }
+
+  update({ version, players, answers }) {
+    this.playersTargets.forEach((element) => { element.textContent = players })
+    this.answersTargets.forEach((element) => { element.textContent = answers })
+    this.follow(version)
+  }
+
+  // Shows the game at +version+ (or newer) if the page is older.
+  follow(version) {
+    if (!Number.isInteger(version)) return
+    if (version > this.latestVersion) this.latestVersion = version
+    if (this.latestVersion <= this.versionValue) return
+
+    // The moderator's own click is on its way: its answer is the newer page.
+    // Interrupting it would cancel the request. Check again once it is done.
+    if (this.submitting) {
+      clearTimeout(this.followTimer)
+      this.followTimer = setTimeout(() => this.follow(this.latestVersion), 100)
+      return
+    }
+
+    // One refresh at a time; try again if it has not landed after a while.
+    const now = Date.now()
+    if (this.refreshing && this.refreshing.version === this.latestVersion && now - this.refreshing.at < REFRESH_RETRY) return
+
+    this.refreshing = { version: this.latestVersion, at: now }
+    window.Turbo.visit(window.location.href, { action: "replace" })
+  }
+
+  versionValueChanged() {
+    this.refreshing = null
+    if (this.latestVersion > this.versionValue) this.follow(this.latestVersion)
+  }
+}
