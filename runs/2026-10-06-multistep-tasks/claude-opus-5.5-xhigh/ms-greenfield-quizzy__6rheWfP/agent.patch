@@ -0,0 +1,297 @@
+require "test_helper"
+
+class ModerateGamesTest < ActionDispatch::IntegrationTest
+  setup do
+    Presence.reset
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+    @question = create_question(@quiz, "Which status code means Too Many Requests?", { "418" => false, "429" => true })
+    create_question(@quiz, "Which protocol?", { "WebSocket" => true, "SMTP" => false })
+  end
+
+  test "everything about games requires the moderator" do
+    game = @quiz.games.create!
+    post "/moderate/quizzes/#{@quiz.id}/games"
+    assert_response :unauthorized
+    [ "/moderate/games/#{game.id}", "/moderate/games/#{game.id}/counters" ].each do |path|
+      get path
+      assert_response :unauthorized
+    end
+    post "/moderate/games/#{game.id}/step", params: { step: "start", version: 0 }
+    assert_response :unauthorized
+    assert_equal :lobby, game.reload.phase
+    post "/moderate/games/#{game.id}/winners", params: { pick: "top" }
+    assert_response :unauthorized
+    delete "/moderate/games/#{game.id}/winners"
+    assert_response :unauthorized
+  end
+
+  test "Start a game opens the big screen with the join link and a QR code" do
+    get "/moderate/quizzes/#{@quiz.id}", headers: moderator_headers
+    assert_select "button", text: "Start a game"
+
+    post "/moderate/quizzes/#{@quiz.id}/games", headers: moderator_headers
+    game = @quiz.games.sole
+    assert_redirected_to "/moderate/games/#{game.id}"
+
+    get "/moderate/games/#{game.id}", headers: moderator_headers
+    assert_select "h1", text: "Frontend Fest 2026"
+    assert_select ".lobby__url", text: "www.example.com/play/#{game.code}"
+    assert_select ".qr svg[role=img][aria-label] path"
+    assert_select ".counter-pill", text: "Players: 0"
+    assert_select "button", text: "Start"
+
+    get "/moderate/quizzes/#{@quiz.id}", headers: moderator_headers
+    assert_select "#quiz_games tr##{dom_id(game)} a[href='/moderate/games/#{game.id}']", text: "Big screen"
+  end
+
+  test "the steps of a game on the big screen" do
+    game = @quiz.games.create!
+    alice = game.players.create!(name: "Alice", browser_token: "alice")
+    Presence.touch(game.id, alice.id, "cable:alice", ttl: 30.seconds)
+    screen = "/moderate/games/#{game.id}"
+
+    post "#{screen}/step", params: { step: "start", version: 0 }, headers: moderator_headers
+    assert_redirected_to screen
+    get screen, headers: moderator_headers
+    assert_select ".stage-question__num", text: "Question 1 of 2"
+    assert_select ".answers-counter", text: "Answers: 0 / 1"
+    assert_select "li.stage-option", 2
+    assert_no_match(/Correct/, response.body)
+    assert_select "button", text: "Finish"
+
+    post "#{screen}/step", params: { step: "start", version: 0 }, headers: moderator_headers # a second click
+    assert_equal 1, game.reload.version
+
+    game.current_round.record_answer(alice, @question.options.last.id)
+    get "#{screen}/counters", headers: moderator_headers
+    assert_equal({ "version" => 1, "players" => 1, "answers" => 1 }, response.parsed_body)
+
+    post "#{screen}/step", params: { step: "finish", version: 1 }, headers: moderator_headers
+    get screen, headers: moderator_headers
+    assert_select "li.stage-option.is-correct", count: 1 do
+      assert_select ".stage-option__title", text: "429"
+      assert_select ".stage-option__mark", text: "Correct"
+      assert_select ".stage-option__count", text: "1"
+    end
+    assert_select "li.stage-option:not(.is-correct) .stage-option__count", text: "0"
+    assert_select "button", text: "Next"
+    assert_select "button", text: "End quiz", count: 0
+
+    post "#{screen}/step", params: { step: "next", version: 2 }, headers: moderator_headers
+    post "#{screen}/step", params: { step: "finish", version: 3 }, headers: moderator_headers
+    get screen, headers: moderator_headers
+    assert_select ".stage-question__num", text: "Question 2 of 2"
+    assert_select "button", text: "End quiz"
+    assert_select "button", text: "Next", count: 0
+
+    post "#{screen}/step", params: { step: "end", version: 4 }, headers: moderator_headers
+    get screen, headers: moderator_headers
+    assert_select "h1", text: "The quiz is over"
+    assert_select ".screen-controls button", count: 2
+    assert_select ".screen-controls button", text: "Top 3"
+    assert_select ".screen-controls button", text: "Draw"
+    assert_select ".screen-controls button", text: "Reset winners", count: 0, message: "nothing to reset yet"
+    assert_no_match(/winner/i, css_select("body").text)
+    assert_select "ol.leaderboard > li", count: 1 do
+      assert_select ".leader__place", text: "1"
+      assert_select ".leader__name", text: "Alice"
+      assert_select ".leader__score", text: "1 point"
+    end
+  end
+
+  test "the leaderboard and the winners after the end" do
+    @quiz.update!(winners_count: 2)
+    game = @quiz.games.create!
+    alice, bob, carol, dave = %w[ Alice Bob Carol Dave ].map { |name| game.players.create!(name: name, browser_token: name) }
+    screen = "/moderate/games/#{game.id}"
+    first_right = @question.options.find_by!(correct: true)
+
+    game.take_step("start", seen_version: 0)
+    [ bob, alice, carol ].each { |player| game.current_round.record_answer(player, first_right.id) }
+    game.take_step("finish", seen_version: 1)
+    get screen, headers: moderator_headers
+    assert_select ".leaderboard", count: 0, message: "no points during the game"
+    assert_no_match(/\d+ points?\b/, response.body)
+
+    game.take_step("next", seen_version: 2)
+    game.current_round.record_answer(alice, @quiz.questions.last.options.find_by!(correct: true).id)
+    game.take_step("finish", seen_version: 3)
+    game.take_step("end", seen_version: 4)
+
+    get screen, headers: moderator_headers
+    assert_equal [ "1 Alice 2 points", "2 Bob 1 point", "3 Carol 1 point", "4 Dave 0 points" ],
+      css_select("ol.leaderboard > li").map { |item| item.text.squish }
+    assert_select "li.leader.is-tied", 2, "Bob and Carol share the 2nd place's points"
+    assert_select ".leader__badge", count: 0
+    assert_select "button", text: "Top 2"
+
+    post "#{screen}/winners", params: { pick: "top" }, headers: moderator_headers
+    assert_redirected_to screen
+    get screen, headers: moderator_headers
+    assert_equal [ "1 Alice 2 points Winner", "2 Bob 1 point Winner", "3 Carol 1 point", "4 Dave 0 points" ],
+      css_select("ol.leaderboard > li").map { |item| item.text.squish }
+    assert_select "li.leader.is-winner", 2
+    texts = css_select("body *").select { |node| node.children.all?(&:text?) }.map { |node| node.text.squish }
+    assert_equal [ "Winner", "Winner", "Reset winners" ], texts.grep(/winner/i), "no other text says winner"
+
+    winners = 30.times.map do
+      post "#{screen}/winners", params: { pick: "draw" }, headers: moderator_headers
+      game.players.where(winner: true).order(:id).pluck(:name)
+    end
+    assert winners.all? { |names| names.size == 2 && names.include?("Alice") && !names.include?("Dave") }
+    assert_equal %w[ Alice Bob Carol ], winners.flatten.uniq.sort
+
+    delete "#{screen}/winners", headers: moderator_headers
+    assert_redirected_to screen
+    assert_not game.players.exists?(winner: true)
+    get screen, headers: moderator_headers
+    assert_select "button", text: "Reset winners", count: 0
+    assert_no_match(/winner/i, css_select("body").text)
+
+    post "#{screen}/winners", params: { pick: "everyone" }, headers: moderator_headers
+    assert_redirected_to screen
+    assert_not game.players.exists?(winner: true)
+  end
+
+  test "the big screen counts down a question with a timer, from the time it opened" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    game = @quiz.games.create!
+    screen = "/moderate/games/#{game.id}"
+    get screen, headers: moderator_headers
+    assert_select ".countdown", count: 0, message: "not in the lobby"
+
+    post "#{screen}/step", params: { step: "start", version: 0 }, headers: moderator_headers
+    round = game.current_round
+    get screen, headers: moderator_headers
+    assert_select ".countdown[role=timer]", count: 1 do
+      assert_select ".countdown__time", text: "1:30"
+    end
+    assert_in_delta 90_000, css_select(".countdown").first["data-countdown-left-value"].to_i, 1_000
+    assert_equal "90000", css_select(".countdown").first["data-countdown-duration-value"]
+
+    travel_to round.closes_at - 4.2, with_usec: true do
+      get screen, headers: moderator_headers # a reload carries on, it does not start over
+      assert_select ".countdown__time", text: "0:05"
+      assert_select ".countdown.is-urgent"
+      assert_equal "4200", css_select(".countdown").first["data-countdown-left-value"]
+    end
+    travel_to round.closes_at - 61, with_usec: true do
+      get screen, headers: moderator_headers
+      assert_select ".countdown__time", text: "1:01"
+      assert_select ".countdown.is-urgent", count: 0
+    end
+
+    post "#{screen}/step", params: { step: "finish", version: 1 }, headers: moderator_headers
+    get screen, headers: moderator_headers
+    assert_select "button", text: "Next"
+    assert_select ".countdown", count: 0, message: "only while the question is open"
+  end
+
+  test "no countdown without a timer" do
+    game = @quiz.games.create!
+    game.take_step("start", seen_version: 0)
+    get "/moderate/games/#{game.id}", headers: moderator_headers
+    assert_select ".stage-question__num", text: "Question 1 of 2"
+    assert_select ".countdown", count: 0
+    assert_no_match(/\b\d+:\d\d\b/, css_select(".screen").text)
+  end
+
+  test "at 0:00 the question finishes by itself, whoever asks first" do
+    @quiz.update!(timer_seconds: 20)
+    game = @quiz.games.create!
+    alice = game.players.create!(name: "Alice", browser_token: "alice")
+    screen = "/moderate/games/#{game.id}"
+    game.take_step("start", seen_version: 0)
+    round = game.current_round
+    round.record_answer(alice, @question.options.last.id)
+
+    travel_to round.closes_at, with_usec: true do
+      # The big screen's poll (no background timer in tests: think of a restart).
+      get "#{screen}/counters", headers: moderator_headers
+      assert_equal 2, response.parsed_body["version"]
+    end
+    assert_equal :closed, game.reload.phase
+
+    get screen, headers: moderator_headers
+    assert_select ".countdown", count: 0
+    assert_select "li.stage-option.is-correct .stage-option__count", text: "1"
+    assert_select "button", text: "Next"
+
+    post "#{screen}/step", params: { step: "finish", version: 1 }, headers: moderator_headers # Finish, clicked too late
+    assert_redirected_to screen
+    assert_equal [ 2, :closed ], [ game.reload.version, game.phase ]
+  end
+
+  test "the timer is a quiz setting: Timer minutes and Timer seconds, 0 by default" do
+    get "/moderate/quizzes/new", headers: moderator_headers
+    assert_select "label[for=quiz_timer_minutes]", text: "Timer minutes"
+    assert_select "label[for=quiz_timer_seconds]", text: "Timer seconds"
+    assert_select "input[type=number][name='quiz[timer_minutes]'][value='0']"
+    assert_select "input[type=number][name='quiz[timer_seconds]'][value='0']"
+
+    post "/moderate/quizzes", params: { quiz: { title: "Timed", winners_count: 3, timer_minutes: "0", timer_seconds: "45" } },
+      headers: moderator_headers
+    quiz = Quiz.find_by!(title: "Timed")
+    assert_equal [ 0, 45, 45.seconds ], [ quiz.timer_minutes, quiz.timer_seconds, quiz.timer_duration ]
+
+    patch "/moderate/quizzes/#{quiz.id}", params: { quiz: { title: "Timed", timer_minutes: "1", timer_seconds: "75" } },
+      headers: moderator_headers
+    assert_response :unprocessable_content
+    assert_select ".errors", text: "Seconds must be a whole number from 0 to 59"
+    assert_select "input[name='quiz[timer_seconds]'][value='75']", 1, "keeps what was typed"
+    texts = css_select("body *").select { |node| node.children.all?(&:text?) }.map { |node| node.text.squish }
+    assert_equal [ "Timer minutes" ], texts.grep(/timer minutes/i), "no other text contains the label"
+    assert_equal [ "Timer seconds" ], texts.grep(/timer seconds/i), "no other text contains the label"
+
+    patch "/moderate/quizzes/#{quiz.id}", params: { quiz: { title: "Timed", timer_minutes: "0", timer_seconds: "0" } },
+      headers: moderator_headers
+    assert_redirected_to "/moderate/quizzes/#{quiz.id}"
+    assert_not quiz.reload.timer?
+  end
+
+  test "deleting the question on screen does not break the game" do
+    game = @quiz.games.create!
+    alice = game.players.create!(name: "Alice", browser_token: "alice")
+    game.take_step("start", seen_version: 0)
+    @question.destroy!
+
+    get "/moderate/games/#{game.id}", headers: moderator_headers
+    assert_response :success
+    assert_select "button", text: "Next"
+    assert_equal "", Game::Stage.new(game.reload).for_player(alice).then { |stage| PlayChannel.render_stage(stage) }[/Which status code/].to_s
+
+    post "/moderate/games/#{game.id}/step", params: { step: "next", version: 1 }, headers: moderator_headers
+    get "/moderate/games/#{game.id}", headers: moderator_headers
+    assert_select ".stage-question__num", text: "Question 1 of 1"
+    assert_select ".stage-question__body", text: "Which protocol?"
+  end
+
+  test "Start without active questions explains why nothing happens" do
+    @quiz.questions.update_all(active: false)
+    game = @quiz.games.create!
+    get "/moderate/games/#{game.id}", headers: moderator_headers
+    assert_select ".lobby__note", text: "This quiz has no active questions yet."
+
+    post "/moderate/games/#{game.id}/step", params: { step: "start", version: 0 }, headers: moderator_headers
+    follow_redirect!(headers: moderator_headers)
+    assert_select ".flash--alert", text: "This quiz has no active questions yet"
+    assert_equal :lobby, game.reload.phase
+  end
+
+  test "QUIZZY_PUBLIC_URL sets the address in the join link" do
+    game = @quiz.games.create!
+    with_env("QUIZZY_PUBLIC_URL" => "http://192.168.1.20:3000/") do
+      get "/moderate/games/#{game.id}", headers: moderator_headers
+    end
+    assert_select ".lobby__url", text: "192.168.1.20:3000/play/#{game.code}"
+  end
+
+  private
+    def with_env(values)
+      saved = values.keys.index_with { |key| ENV[key] }
+      values.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      saved.each { |key, value| ENV[key] = value }
+    end
+end
diff --git a/test/integration/moderate_questions_test.rb b/test/integration/moderate_questions_test.rb
new file mode 100644
index 0000000..075c37d
--- /dev/null
+++ b/test/integration/moderate_questions_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class ModerateQuestionsTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+  end
+
+  test "the new question form has four empty option rows and Active on" do
+    get new_moderate_quiz_question_path(@quiz), headers: moderator_headers
+    assert_response :success
+
+    assert_select "label", "Question"
+    assert_select ".option-rows input[type=text]", 4
+    (1..4).each do |number|
+      assert_select "input[type=text][aria-label='Option #{number}'][placeholder='Option #{number}']", 1
+      assert_select "input[type=checkbox][aria-label='Option #{number} is correct']", 1
+    end
+    assert_select "input[type=checkbox][name='question[active]'][checked]"
+    assert_select "button", "Save question"
+  end
+
+  test "a failing rule keeps what the moderator typed" do
+    post moderate_quiz_questions_path(@quiz), headers: moderator_headers, params: { question: {
+      text: "Which planet is the largest?", active: "0",
+      options: { "0" => { text: "Jupiter", correct: "0" }, "1" => { text: "", correct: "1" }, "2" => { text: "Saturn", correct: "0" } }
+    } }
+
+    assert_response :unprocessable_content
+    assert_select ".errors", text: "Mark at least one option as correct"
+    assert_select "textarea[name='question[text]']", text: "Which planet is the largest?"
+    assert_select ".option-rows input[type=text]", 3
+    assert_select "input[aria-label='Option 1'][value='Jupiter']"
+    assert_select "input[aria-label='Option 2'][value='']"
+    assert_select "input[aria-label='Option 2 is correct'][checked]"
+    assert_select "input[aria-label='Option 3'][value='Saturn']"
+    assert_select "input[type=checkbox][name='question[active]']:not([checked])"
+    assert_equal 0, Question.count
+  end
+
+  test "too few options" do
+    post moderate_quiz_questions_path(@quiz), headers: moderator_headers, params: { question: {
+      text: "Alone?", active: "1", options: { "0" => { text: "Yes", correct: "1" } }
+    } }
+    assert_response :unprocessable_content
+    assert_select ".errors", text: "Add at least two options"
+  end
+
+  test "no options at all shows both rules" do
+    post moderate_quiz_questions_path(@quiz), headers: moderator_headers, params: { question: { text: "Nothing?", active: "1" } }
+    assert_response :unprocessable_content
+    assert_select ".errors li", 2
+    assert_select ".errors", text: /Add at least two options/
+    assert_select ".errors", text: /Mark at least one option as correct/
+  end
+
+  test "creating and editing a question" do
+    post moderate_quiz_questions_path(@quiz), headers: moderator_headers, params: { question: {
+      text: "Which planet is the largest?", active: "1",
+      options: { "0" => { text: "Jupiter", correct: "1" }, "1" => { text: "Saturn", correct: "0" }, "2" => { text: "", correct: "0" } }
+    } }
+    assert_redirected_to moderate_quiz_path(@quiz)
+    question = @quiz.questions.sole
+    assert_equal [ "Jupiter", "Saturn" ], question.options.map(&:text)
+
+    get edit_moderate_quiz_question_path(@quiz, question), headers: moderator_headers
+    assert_select ".option-rows input[type=text]", 2
+    assert_select "input[aria-label='Option 1'][value='Jupiter']"
+    assert_select "input[aria-label='Option 1 is correct'][checked]"
+    assert_select "template input[aria-label='Option __NUMBER__']"
+  end
+
+  test "the activation switch saves the active flag" do
+    question = create_question(@quiz, "Which?", { "A" => true, "B" => false })
+    patch moderate_quiz_question_activation_path(@quiz, question), headers: moderator_headers, params: { question: { active: "0" } }
+    assert_redirected_to moderate_quiz_path(@quiz)
+    assert_not question.reload.active?
+
+    patch moderate_quiz_question_activation_path(@quiz, question), headers: moderator_headers, params: { question: { active: "1" } }
+    assert question.reload.active?
+  end
+
+  test "the preview gets the active questions only" do
+    create_question(@quiz, "Shown", { "A" => true, "B" => false })
+    create_question(@quiz, "Hidden", { "A" => true, "B" => false }, false)
+
+    get moderate_quiz_preview_path(@quiz), headers: moderator_headers
+    assert_response :success
+    questions = JSON.parse(css_select("[data-controller=preview]").first["data-preview-questions-value"])
+    assert_equal [ "Shown" ], questions.map { |question| question["text"] }
+  end
+
+  test "questions of another quiz are not reachable" do
+    other = Quiz.create!(title: "Other")
+    question = create_question(other, "Which?", { "A" => true, "B" => false })
+    get edit_moderate_quiz_question_path(@quiz, question), headers: moderator_headers
+    assert_response :not_found
+  end
+end
diff --git a/test/integration/moderate_quiz_transfers_test.rb b/test/integration/moderate_quiz_transfers_test.rb
new file mode 100644
index 0000000..a622640
--- /dev/null
+++ b/test/integration/moderate_quiz_transfers_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class ModerateQuizTransfersTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+    create_question(@quiz, "Which HTTP status code means \"Too Many Requests\"?", { "418" => false, "429" => true })
+    create_question(@quiz, "What does <CSS> stand for?", { "Cascading Style Sheets" => true, "Computer Style System" => false }, false)
+  end
+
+  test "the quiz page links to the export, the quiz list to the import" do
+    get moderate_quiz_path(@quiz), headers: moderator_headers
+    assert_select "a[href=?]", moderate_quiz_export_path(@quiz), text: "Export"
+
+    get moderate_root_path, headers: moderator_headers
+    assert_select "form[method=get][action=?] button", new_moderate_import_path, text: "Import quiz"
+  end
+
+  test "the export page shows the JSON in its only <pre>" do
+    get moderate_quiz_export_path(@quiz), headers: moderator_headers
+    assert_response :success
+
+    assert_select "pre", 1
+    assert_equal Quiz::Export.new(@quiz).as_json, JSON.parse(css_select("pre").first.text)
+    assert_select "pre", text: /What does <CSS> stand for\?/
+  end
+
+  test "the export can be downloaded as a file" do
+    get moderate_quiz_export_path(@quiz, format: :json), headers: moderator_headers
+    assert_response :success
+    assert_equal "application/json", response.media_type
+    assert_match(/attachment; filename="frontend-fest-2026.json"/, response.headers["Content-Disposition"])
+    assert_equal Quiz::Export.new(@quiz).as_json, JSON.parse(response.body)
+  end
+
+  test "the import page" do
+    get new_moderate_import_path, headers: moderator_headers
+    assert_response :success
+    assert_select "label[for=import_json]", "Quiz JSON"
+    assert_select "textarea#import_json[name='import[json]']"
+    assert_select "button", "Import"
+    # "Import" is the only text containing that word, so looking it up is unambiguous.
+    assert_equal 1, css_select("body *").count { |node| node.children.any? { it.text? && it.text.match?(/import/i) } }
+  end
+
+  test "importing creates a new quiz and opens it" do
+    json = Quiz::Export.new(@quiz).to_json
+
+    assert_difference -> { Quiz.count } => 1, -> { Question.count } => 2, -> { Option.count } => 4 do
+      post moderate_imports_path, headers: moderator_headers, params: { import: { json: json } }
+    end
+
+    imported = Quiz.newest_first.first
+    assert_not_equal @quiz, imported
+    assert_redirected_to moderate_quiz_path(imported)
+    assert_equal JSON.parse(json), Quiz::Export.new(imported).as_json
+
+    follow_redirect!(headers: moderator_headers)
+    assert_select "h1", "Frontend Fest 2026"
+    assert_select ".question-list > li", 2
+  end
+
+  test "a failed import shows the problems, keeps the JSON and creates nothing" do
+    json = JSON.pretty_generate("title" => "Broken", "questions" => [
+      { "text" => "Fine", "options" => [ { "text" => "A", "correct" => true }, { "text" => "B" } ] },
+      { "text" => "Lonely?", "options" => [ { "text" => "Yes", "correct" => true } ] }
+    ])
+
+    assert_no_difference [ "Quiz.count", "Question.count", "Option.count" ] do
+      post moderate_imports_path, headers: moderator_headers, params: { import: { json: json } }
+    end
+    assert_response :unprocessable_content
+    assert_select ".errors[role=alert]", text: /Question 2 “Lonely\?”: Add at least two options/
+    assert_select "textarea#import_json", text: json
+  end
+
+  test "invalid JSON and an empty field" do
+    post moderate_imports_path, headers: moderator_headers, params: { import: { json: "{ nope" } }
+    assert_response :unprocessable_content
+    assert_select ".errors", text: /Invalid JSON/
+
+    post moderate_imports_path, headers: moderator_headers, params: { import: { json: "" } }
+    assert_response :unprocessable_content
+    assert_select ".errors", text: /Paste the JSON of a quiz/
+    assert_equal 1, Quiz.count
+  end
+
+  test "export and import need the moderator" do
+    get moderate_quiz_export_path(@quiz)
+    assert_response :unauthorized
+    get new_moderate_import_path
+    assert_response :unauthorized
+
+    assert_no_difference "Quiz.count" do
+      post moderate_imports_path, params: { import: { json: Quiz::Export.new(@quiz).to_json } }
+    end
+    assert_response :unauthorized
+  end
+end
diff --git a/test/integration/moderator_authentication_test.rb b/test/integration/moderator_authentication_test.rb
new file mode 100644
index 0000000..2a3707d
--- /dev/null
+++ b/test/integration/moderator_authentication_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class ModeratorAuthenticationTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+    @question = create_question(@quiz, "Which?", { "A" => true, "B" => false })
+  end
+
+  def moderator_requests
+    [
+      [ :get, "/moderate" ],
+      [ :get, "/moderate/quizzes" ],
+      [ :get, "/moderate/quizzes/new" ],
+      [ :post, "/moderate/quizzes" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}/edit" ],
+      [ :patch, "/moderate/quizzes/#{@quiz.id}" ],
+      [ :delete, "/moderate/quizzes/#{@quiz.id}" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}/preview" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}/questions/new" ],
+      [ :post, "/moderate/quizzes/#{@quiz.id}/questions" ],
+      [ :get, "/moderate/quizzes/#{@quiz.id}/questions/#{@question.id}/edit" ],
+      [ :patch, "/moderate/quizzes/#{@quiz.id}/questions/#{@question.id}" ],
+      [ :delete, "/moderate/quizzes/#{@quiz.id}/questions/#{@question.id}" ],
+      [ :patch, "/moderate/quizzes/#{@quiz.id}/questions/#{@question.id}/activation" ],
+      [ :patch, "/moderate/quizzes/#{@quiz.id}/questions/#{@question.id}/position" ],
+      [ :get, "/moderate/quizzes/999999" ],
+      [ :get, "/moderate/anything/else" ]
+    ]
+  end
+
+  test "every moderator page requires credentials" do
+    moderator_requests.each do |verb, path|
+      send(verb, path)
+      assert_response :unauthorized, "#{verb.upcase} #{path} without credentials"
+      assert_match(/Basic realm="Quizzy moderator"/, response.headers["WWW-Authenticate"])
+    end
+  end
+
+  test "wrong credentials get 401" do
+    wrong = { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials(MODERATOR_USERNAME, "nope") }
+    moderator_requests.each do |verb, path|
+      send(verb, path, headers: wrong)
+      assert_response :unauthorized, "#{verb.upcase} #{path} with a wrong password"
+    end
+  end
+
+  test "nothing changes without credentials" do
+    delete "/moderate/quizzes/#{@quiz.id}"
+    patch "/moderate/quizzes/#{@quiz.id}/questions/#{@question.id}/activation", params: { question: { active: "0" } }
+    assert Quiz.exists?(@quiz.id)
+    assert @question.reload.active?
+  end
+
+  test "the moderator gets in" do
+    get "/moderate", headers: moderator_headers
+    assert_response :success
+    assert_select "h1", "Quizzes"
+  end
+
+  test "unknown moderator paths are 404 for the moderator" do
+    get "/moderate/anything/else", headers: moderator_headers
+    assert_response :not_found
+  end
+
+  test "public pages and the health check are open" do
+    get "/up"
+    assert_response :success
+    get "/"
+    assert_response :success
+  end
+end
diff --git a/test/integration/play_test.rb b/test/integration/play_test.rb
new file mode 100644
index 0000000..58638e2
--- /dev/null
+++ b/test/integration/play_test.rb
@@ -0,0 +1,204 @@
+require "test_helper"
+
+class PlayTest < ActionDispatch::IntegrationTest
+  setup do
+    Presence.reset
+    @quiz = Quiz.create!(title: "Frontend Fest 2026")
+    @question = create_question(@quiz, "Which status code means Too Many Requests?", { "418" => false, "429" => true })
+    @game = @quiz.games.create!
+    @wrong, @right = @question.options
+  end
+
+  def join(name = "Alice")
+    post "/play/#{@game.code}/player", params: { player: { name: name } }
+  end
+
+  def step(name)
+    @game.reload.take_step(name, seen_version: @game.version)
+  end
+
+  test "joining with a name, then being recognized by the browser" do
+    get "/play/#{@game.code.downcase}"
+    assert_response :success
+    assert_select "label", text: "Your name"
+    assert_select "input[placeholder='Your name']"
+    assert_select "button", text: "Join"
+
+    join "  Alice  "
+    assert_redirected_to "/play/#{@game.code}"
+    follow_redirect!
+    assert_select ".play__greeting", text: "Hi, Alice!"
+    assert_select "input[name='player[name]']", count: 0
+    assert_equal 1, Presence.count(@game.id), "counted before the live connection is up"
+
+    join "Alice again"
+    assert_equal [ "Alice" ], @game.players.pluck(:name)
+  end
+
+  test "a name is required" do
+    join "   "
+    assert_response :unprocessable_content
+    assert_select ".errors", text: "Please type a name first"
+    assert_equal 0, @game.players.count
+  end
+
+  test "after the end, nobody can join" do
+    step("start")
+    step("finish")
+    step("end")
+
+    get "/play/#{@game.code}"
+    assert_select "h1", text: "The quiz is over"
+    assert_select "form", count: 0
+
+    join
+    assert_response :gone
+    assert_equal 0, @game.players.count
+  end
+
+  test "an unknown code" do
+    get "/play/NOPE1"
+    assert_response :not_found
+    assert_select "h1", text: "No game here"
+  end
+
+  test "answering, changing the answer and seeing the result" do
+    join
+    step("start")
+
+    get "/play/#{@game.code}"
+    assert_select ".play-question__body", text: @question.text
+    assert_select "button.play-option", 2
+    assert_no_match(/correct/i, response.body, "the page source must not tell the correct option")
+
+    post "/play/#{@game.code}/answer", params: { option_id: @wrong.id }, as: :json
+    post "/play/#{@game.code}/answer", params: { option_id: @right.id }, as: :json
+    assert_response :success
+    payload = response.parsed_body
+    assert_equal [ 1, 2 ], [ payload["version"], payload["revision"] ]
+    assert_no_match(/correct/i, payload["html"])
+    picked = Nokogiri::HTML5.fragment(payload["html"]).at("button.is-picked")
+    assert_equal "429", picked.at(".play-option__title").text
+    assert_equal "Your answer", picked.at("[data-pick-mark]").text
+
+    step("finish")
+    get "/play/#{@game.code}"
+    assert_select ".play-status", text: "Correct!"
+    assert_select "button.play-option[disabled]", 2
+
+    post "/play/#{@game.code}/answer", params: { option_id: @wrong.id }, as: :json
+    assert_response :conflict
+    assert_match "Correct!", response.parsed_body["html"]
+    assert_equal @right, Answer.sole.option
+  end
+
+  test "a player who did not answer, and a wrong answer" do
+    join "Alice"
+    alice_cookies = cookies.to_hash
+    reset!
+    join "Bob"
+    step("start")
+    post "/play/#{@game.code}/answer", params: { option_id: @wrong.id }, as: :json
+    step("finish")
+
+    get "/play/#{@game.code}"
+    assert_select ".play-status", text: "Wrong!"
+
+    reset!
+    alice_cookies.each { |name, value| cookies[name] = value }
+    get "/play/#{@game.code}"
+    assert_select ".play__greeting", text: "Hi, Alice!"
+    assert_select ".play-status", text: "No answer"
+  end
+
+  test "the end shows the player's place and points, and the prize" do
+    join "Alice"
+    step("start")
+    post "/play/#{@game.code}/answer", params: { option_id: @right.id }, as: :json
+    step("finish")
+    step("end")
+
+    get "/play/#{@game.code}"
+    assert_select "h1", text: "The quiz is over"
+    assert_select ".result-card__label", text: "Place 1 of 1"
+    assert_select ".result-card__score", text: "1 point"
+    assert_select ".winner-banner", count: 0
+
+    @game.pick_winners("top")
+    get "/play/#{@game.code}"
+    assert_select ".winner-banner", text: "You won!"
+
+    get "/play/#{@game.code}/stage", params: { version: @game.reload.version, revision: 0, fallback: 1 }, as: :json
+    assert_response :no_content
+    get "/play/#{@game.code}/stage", params: { version: @game.version - 1, revision: 0, fallback: 1 }, as: :json
+    assert_response :success
+    assert_match "You won!", response.parsed_body["html"]
+    assert_match "Place 1 of 1", response.parsed_body["html"]
+  end
+
+  test "answers without JavaScript go back to the page" do
+    join
+    step("start")
+    post "/play/#{@game.code}/answer", params: { option_id: @right.id }
+    assert_redirected_to "/play/#{@game.code}"
+    assert_equal @right, Answer.sole.option
+  end
+
+  test "the stage for phones without a live connection" do
+    join
+    get "/play/#{@game.code}/stage", params: { version: 0, revision: 0 }, as: :json
+    assert_response :no_content
+
+    step("start")
+    get "/play/#{@game.code}/stage", params: { version: 0, revision: 0, fallback: 1 }, as: :json
+    assert_response :success
+    assert_equal 1, response.parsed_body["version"]
+    assert_match @question.text, response.parsed_body["html"]
+  end
+
+  test "players never see the timer; once the time is up, picks are refused and the results show" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 15)
+    join
+    step("start")
+    round = @game.current_round
+
+    get "/play/#{@game.code}"
+    assert_select ".play-question__body", text: @question.text
+    assert_select ".countdown, [role=timer]", count: 0
+    assert_no_match(/\b\d+:\d\d\b/, css_select(".play__stage").text, "no countdown on the phone")
+    assert_no_match(/closes_at|countdown|timer/i, css_select("body").to_s)
+
+    post "/play/#{@game.code}/answer", params: { option_id: @right.id }, as: :json
+    assert_response :success
+    assert_no_match(/\b\d+:\d\d\b/, response.parsed_body["html"])
+
+    travel_to round.closes_at, with_usec: true do
+      post "/play/#{@game.code}/answer", params: { option_id: @wrong.id }, as: :json
+      assert_response :conflict
+      assert_match "Correct!", response.parsed_body["html"], "the question finished: the result of the pick made in time"
+    end
+    assert_equal [ @right, :closed, 2 ], [ Answer.sole.option, @game.reload.phase, @game.version ]
+  end
+
+  test "a phone polling after 0:00 gets the results" do
+    @quiz.update!(timer_seconds: 5)
+    join
+    step("start")
+
+    travel_to @game.current_round.closes_at + 0.5, with_usec: true do
+      get "/play/#{@game.code}/stage", params: { version: 1, revision: 0, fallback: 1 }, as: :json
+      assert_response :success
+      assert_equal 2, response.parsed_body["version"]
+      assert_match "No answer", response.parsed_body["html"]
+    end
+  end
+
+  test "strangers cannot answer or poll" do
+    step("start")
+    post "/play/#{@game.code}/answer", params: { option_id: @right.id }, as: :json
+    assert_response :not_found
+    get "/play/#{@game.code}/stage", as: :json
+    assert_response :not_found
+    assert_equal 0, Answer.count
+  end
+end
