+  transition: opacity 0.3s, transform 0.3s;
+}
+
+.stage-option__letter {
+  flex-shrink: 0;
+  display: grid;
+  place-items: center;
+  width: 1.8em;
+  height: 1.8em;
+  border-radius: 50%;
+  background: var(--c-blue);
+  color: var(--c-lavender);
+  font-family: var(--f-display);
+  font-weight: 900;
+  font-size: 0.85em;
+}
+
+.stage-option__title { flex: 1; overflow-wrap: anywhere; }
+.stage-option__count { font-family: var(--f-display); font-weight: 900; }
+
+.stage-option__bar {
+  position: absolute;
+  inset: 0 auto 0 0;
+  z-index: -1;
+  background: rgb(0 0 153 / 0.14);
