@@ -0,0 +1,100 @@
+require "application_system_test_case"
+
+class QuizzesTest < ApplicationSystemTestCase
+  test "creating a quiz opens its page" do
+    visit "/moderate"
+    click_button "New quiz"
+    fill_in "Title", with: "Frontend Fest 2026"
+    click_button "Save quiz"
+
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_button "Add question"
+    assert_link "Settings"
+    assert_link "Preview"
+
+    click_link "All quizzes"
+    within("li", text: "Frontend Fest 2026") { assert_link "Frontend Fest 2026" }
+  end
+
+  test "the title is required" do
+    visit "/moderate"
+    click_button "New quiz"
+    click_button "Save quiz"
+    assert_text "Title can't be blank"
+    assert_equal 0, Quiz.count
+  end
+
+  test "the number of winners: 3 by default, at least 1" do
+    visit "/moderate"
+    click_button "New quiz"
+    fill_in "Title", with: "Frontend Fest 2026"
+    assert_field "Number of winners", with: "3"
+    click_button "Save quiz"
+    assert_selector "h1", text: "Frontend Fest 2026"
+    quiz = Quiz.sole
+    assert_equal 3, quiz.winners_count
+
+    click_link "Settings"
+    fill_in "Number of winners", with: "0"
+    click_button "Save quiz"
+    assert_text "Winners must be a whole number from 1 to 10,000"
+    assert_equal 3, quiz.reload.winners_count
+
+    fill_in "Number of winners", with: "5"
+    click_button "Save quiz"
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_equal 5, quiz.reload.winners_count
+
+    click_link "Settings"
+    assert_field "Number of winners", with: "5"
+  end
+
+  test "the timer: Timer minutes and Timer seconds, 0 by default" do
+    visit "/moderate"
+    click_button "New quiz"
+    fill_in "Title", with: "Frontend Fest 2026"
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+    click_button "Save quiz"
+    assert_selector "h1", text: "Frontend Fest 2026"
+    quiz = Quiz.sole
+    assert_not quiz.timer?
+
+    click_link "Settings"
+    fill_in "Timer minutes", with: "1"
+    fill_in "Timer seconds", with: "60"
+    click_button "Save quiz"
+    assert_text "Seconds must be a whole number from 0 to 59"
+    assert_not quiz.reload.timer?
+
+    fill_in "Timer seconds", with: "30"
+    click_button "Save quiz"
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_equal 90.seconds, quiz.reload.timer_duration
+
+    click_link "Settings"
+    assert_field "Timer minutes", with: "1"
+    assert_field "Timer seconds", with: "30"
+  end
+
+  test "settings rename and delete the quiz" do
+    quiz = Quiz.create!(title: "Draft")
+    visit "/moderate/quizzes/#{quiz.id}"
+
+    click_link "Settings"
+    assert_field "Title", with: "Draft"
+    fill_in "Title", with: "Frontend Fest 2026"
+    click_button "Save quiz"
+    assert_selector "h1", text: "Frontend Fest 2026"
+
+    click_link "Settings"
+    dismiss_confirm { click_button "Delete quiz" }
+    assert_button "Delete quiz"
+    assert Quiz.exists?(quiz.id)
+
+    accept_confirm { click_button "Delete quiz" }
+    assert_selector "h1", text: "Quizzes"
+    assert_no_text "Frontend Fest 2026"
+    assert_not Quiz.exists?(quiz.id)
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
new file mode 100644
index 0000000..e355e32
--- /dev/null
+++ b/test/test_helper.rb
@@ -0,0 +1,38 @@
+ENV["RAILS_ENV"] ||= "test"
+ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+ENV["QUIZZY_MODERATOR_PASSWORD"] = "s3cret"
+
+require_relative "../config/environment"
+require "rails/test_help"
+
+# Question timers finish questions from a background thread (Game::Timer).
+# Tests finish them through Game#keep_time instead (with travel_to); system
+# tests, which play in real time, turn the timer on.
+Game::Timer.enabled = false
+
+module ActiveSupport
+  class TestCase
+    # Run tests in parallel with specified workers
+    parallelize(workers: :number_of_processors)
+
+    # Setup all fixtures in test/fixtures/*.yml for all tests in alphabetical order.
+    fixtures :all
+
+    MODERATOR_USERNAME = ENV["QUIZZY_MODERATOR_USERNAME"]
+    MODERATOR_PASSWORD = ENV["QUIZZY_MODERATOR_PASSWORD"]
+
+    # Builds a saved question; `options` maps option text to whether it is correct.
+    def create_question(quiz, text, options = {}, active = true)
+      question = quiz.questions.new(text: text, active: active)
+      question.option_rows = options.map { |option_text, correct| { text: option_text, correct: correct } }
+      question.save!
+      question
+    end
+  end
+end
+
+class ActionDispatch::IntegrationTest
+  def moderator_headers
+    { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials(MODERATOR_USERNAME, MODERATOR_PASSWORD) }
+  end
+end
