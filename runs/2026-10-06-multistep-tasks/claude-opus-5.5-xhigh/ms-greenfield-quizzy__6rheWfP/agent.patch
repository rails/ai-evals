diff --git a/app/views/moderate/games/_question.html.erb b/app/views/moderate/games/_question.html.erb
new file mode 100644
index 0000000..c27f201
--- /dev/null
+++ b/app/views/moderate/games/_question.html.erb
@@ -0,0 +1,43 @@
+<%# A question on the big screen. The correct options and the answers per option
+    only appear once the question is closed ("Finish"). With the quiz's timer,
+    the open question counts down (only here: phones never show it). %>
+<% if screen.question? %>
+  <div class="stage-head">
+    <div class="stage-question__num">Question <%= screen.position %> of <%= screen.total %></div>
+    <div class="stage-head__side">
+      <% if screen.countdown? %>
+        <%# The time left as rendered, in ms: a reload carries on from the server's
+            deadline, whatever the clock of this computer says. %>
+        <div class="countdown<%= " is-urgent" if screen.time_left <= 5 %>" id="<%= dom_id(screen.round, :countdown) %>" role="timer" aria-label="Time left"
+          data-controller="countdown" data-action="countdown:expired->screen#timeUp"
+          data-countdown-left-value="<%= (screen.time_left * 1000).floor %>"
+          data-countdown-duration-value="<%= (screen.timer_duration * 1000).round %>"
+          style="--left: <%= (screen.time_left / screen.timer_duration).round(4) %>">
+          <svg class="countdown__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8" /><path d="M12 9v4l2.5 2.5M9.5 2.5h5" /></svg>
+          <span class="countdown__time" data-countdown-target="time"><%= countdown_text(screen.time_left) %></span>
+          <span class="countdown__bar" aria-hidden="true"></span>
+        </div>
+      <% end %>
+      <div class="answers-counter" aria-live="polite">Answers: <strong data-screen-target="answers"><%= screen.answers_count %></strong> / <strong data-screen-target="players"><%= screen.players_count %></strong></div>
+    </div>
+  </div>
+  <div class="stage-question__body"><%= screen.question.text %></div>
+
+  <ol class="stage-options<%= " stage-options--results" if screen.revealed? %>">
+    <% screen.options.each_with_index do |option, index| %>
+      <% correct = screen.revealed? && option.correct? %>
+      <li class="stage-option<%= " is-correct" if correct %>"<% if screen.revealed? %> style="--share: <%= screen.share_for(option) %>%"<% end %>>
+        <% if screen.revealed? %><span class="stage-option__bar" aria-hidden="true"></span><% end %>
+        <span class="stage-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+        <span class="stage-option__title"><%= option.text %></span>
+        <% if correct %><span class="stage-option__mark">Correct</span><% end %>
+        <% if screen.revealed? %>
+          <span class="stage-option__count" title="<%= pluralize(screen.answer_count_for(option), "answer") %>"><%= screen.answer_count_for(option) %></span>
+        <% end %>
+      </li>
+    <% end %>
+  </ol>
+<% else %>
+  <%# The question was deleted from the quiz while it was on screen. %>
+  <div class="stage-question__body">This question was removed from the quiz.</div>
+<% end %>
diff --git a/app/views/moderate/games/show.html.erb b/app/views/moderate/games/show.html.erb
new file mode 100644
index 0000000..e8dc66d
--- /dev/null
+++ b/app/views/moderate/games/show.html.erb
@@ -0,0 +1,66 @@
+<%# The big screen of a game. The moderator's buttons re-render it (morphing);
+    screen_controller.js follows changes made elsewhere (pushed by ScreenChannel,
+    with polling as a fallback) and polls the live numbers. %>
+<% content_for :title, "#{@game.quiz.title} · Game #{@game.code}" %>
+<% content_for :head do %>
+  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
+<% end %>
+<% join_text = @join_url.sub(%r{\Ahttps?://}, "") %>
+
+<section class="cover cover--blue cover--calm game-screen game-screen--<%= @screen.phase %>" id="<%= dom_id(@game, :screen) %>"
+  data-controller="screen"
+  data-screen-counters-url-value="<%= moderate_game_counters_path(@game) %>"
+  data-screen-version-value="<%= @game.version %>"
+  data-screen-token-value="<%= ScreenChannel.token_for(@game) %>">
+  <div class="screen">
+    <div class="screen__top">
+      <span class="logo screen__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+      <% unless @screen.phase == :lobby %>
+        <span class="screen__title"><%= @game.quiz.title %></span>
+      <% end %>
+    </div>
+
+    <div class="screen__body">
+      <% case @screen.phase %>
+      <% when :lobby %>
+        <%= render "moderate/games/lobby", screen: @screen, join_url: @join_url, join_text: join_text %>
+      <% when :open, :closed %>
+        <%= render "moderate/games/question", screen: @screen %>
+      <% when :ended %>
+        <%= render "moderate/games/ended", screen: @screen %>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= back_link("Back to quiz", moderate_quiz_path(@game.quiz)) %>
+      <% if @screen.phase.in?(%i[ open closed ]) %>
+        <span class="screen-controls__join">Join at <strong><%= join_text %></strong></span>
+      <% end %>
+    </div>
+
+    <div class="buttons">
+      <% case @screen.phase %>
+      <% when :lobby %>
+        <%= game_step_button(@game, "Start", "start") %>
+      <% when :open %>
+        <%= game_step_button(@game, "Finish", "finish") %>
+      <% when :closed %>
+        <% if @screen.last_question? %>
+          <%= game_step_button(@game, "End quiz", "end") %>
+        <% else %>
+          <%= game_step_button(@game, "Next", "next") %>
+        <% end %>
+      <% when :ended %>
+        <%= game_winners_button(@game, "Top #{@screen.winners_count}", "top") %>
+        <%= game_winners_button(@game, "Draw", "draw", style: "btn--light") %>
+        <%# Only while there are winners: nothing to reset otherwise, and no text
+            on the screen says "winner" until someone wins. %>
+        <% if @screen.winners? %>
+          <%= reset_winners_button(@game) %>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+</section>
diff --git a/app/views/moderate/imports/new.html.erb b/app/views/moderate/imports/new.html.erb
