+# Someone who joined a game from a phone. There are no accounts: the browser
+# is recognized by a random token in a permanent cookie (BROWSER_COOKIE), so
+# opening the join link again in the same browser continues as the same player.
+#
+# Points and places are computed by Game::Leaderboard. +winner+ is set by the
+# moderator's "Top N" / "Draw" after the end (Game#pick_winners).
+class Player < ApplicationRecord
+  BROWSER_COOKIE = :quizzy_browser
+  NAME_MAXIMUM = 40
+
+  belongs_to :game, inverse_of: :players
+  has_many :answers, dependent: :delete_all, inverse_of: :player
+
+  normalizes :name, with: ->(name) { name.squish }
+
+  validates :name, presence: { message: "Please type a name first" },
+    length: { maximum: NAME_MAXIMUM, message: "Please use at most #{NAME_MAXIMUM} characters" }
+  validates :browser_token, presence: true
+
+  def self.new_browser_token
+    SecureRandom.base58(24)
+  end
+end
diff --git a/app/models/presence.rb b/app/models/presence.rb
new file mode 100644
index 0000000..ba58933
--- /dev/null
+++ b/app/models/presence.rb
@@ -0,0 +1,63 @@
+# Who is in a game right now: the players who have the play page open.
+#
+# A phone is present while its Action Cable subscription is open and keeps
+# syncing (PlayChannel, every few seconds), or while it keeps polling over
+# HTTP when it cannot keep a WebSocket open. Entries expire on their own, so a
+# phone that silently drops off the Wi-Fi stops counting after CABLE_TTL; one
+# that closes the page stops counting right away.
+#
+# The big screen shows these numbers ("Players: 2", "Answers: 1 / 2"). They
+# change all the time and only mean something while the server runs, so they
+# live in this process's memory, not in the database. (Quizzy runs one Puma
+# process; Action Cable runs inside it.) After a restart, phones reconnect and
+# are counted again within seconds.
+class Presence
+  CABLE_TTL = 30.seconds # phones sync over the cable every 10 seconds
+  POLL_TTL = 12.seconds  # phones without a cable poll every 3 seconds
+
+  @lock = Mutex.new
+  @games = Hash.new { |games, game_id| games[game_id] = {} }
+
+  class << self
+    # The key of a phone seen over HTTP (the play page, polling).
+    def poll_key(player_id)
+      "poll:#{player_id}"
+    end
+
+    # Marks the player as present through +key+ (one key per connection).
+    def touch(game_id, player_id, key, ttl:)
+      @lock.synchronize { @games[game_id][key] = [ player_id, now + ttl ] }
+    end
+
+    def leave(game_id, key)
+      @lock.synchronize do
+        next unless @games.key?(game_id)
+
+        @games[game_id].delete(key)
+        @games.delete(game_id) if @games[game_id].empty?
+      end
+    end
+
+    # Number of distinct players present in the game.
+    def count(game_id)
+      @lock.synchronize do
+        next 0 unless @games.key?(game_id)
+
+        entries = @games[game_id]
+        current = now
+        entries.delete_if { |_key, (_player_id, expires_at)| expires_at <= current }
+        @games.delete(game_id) if entries.empty?
+        entries.values.map(&:first).uniq.size
+      end
+    end
+
+    def reset
+      @lock.synchronize { @games.clear }
+    end
+
+    private
+      def now
+        Time.current
+      end
+  end
+end
diff --git a/app/models/question.rb b/app/models/question.rb
new file mode 100644
index 0000000..e4a9ec7
--- /dev/null
+++ b/app/models/question.rb
@@ -0,0 +1,107 @@
+# A single-choice question with text options, shown in the quiz in +position+
+# order. Inactive questions stay in the quiz but are skipped when it is played.
+#
+# Options are edited as a list of rows (see Question::OptionRow) and synced to
+# the +options+ table after the question is saved. Empty rows are skipped.
+class Question < ApplicationRecord
+  MINIMUM_OPTIONS = 2
+  NEW_QUESTION_ROWS = 4
+
+  belongs_to :quiz, inverse_of: :questions
+  has_many :options, -> { order(:position, :id) }, dependent: :delete_all, inverse_of: :question
+
+  normalizes :text, with: ->(text) { text.gsub("\r\n", "\n").strip }
+
+  validates :text, presence: true
+  validate :options_follow_the_rules, if: -> { new_record? || option_rows_assigned? }
+
+  before_create :append_to_quiz
+  after_save :sync_options, if: :option_rows_assigned?
+
+  scope :active, -> { where(active: true) }
+
+  # The rows the question form shows: what was typed, or the saved options.
+  def option_rows
+    @option_rows ||=
+      if new_record? && options.empty?
+        Array.new(NEW_QUESTION_ROWS) { OptionRow.new }
+      else
+        options.map { |option| OptionRow.from_option(option) }
+      end
+  end
+
+  # Accepts rows as an array or as a hash keyed by row index ("0", "1", ...),
+  # the way the form submits them.
+  def option_rows=(rows)
+    rows = rows.to_h if rows.respond_to?(:permitted?)
+    rows = rows.sort_by { |index, _| index.to_i }.map(&:last) if rows.is_a?(Hash)
+
+    @option_rows = Array(rows).map do |row|
+      row = row.to_h.symbolize_keys
+      OptionRow.new(id: row[:id].presence, text: row[:text].to_s, correct: row[:correct])
+    end
+    @option_rows_assigned = true
+  end
+
+  def filled_option_rows
+    option_rows.select(&:filled?)
+  end
+
+  def previous_question
+    quiz.questions.where(position: ...position).reorder(position: :desc, id: :desc).first
+  end
+
+  def next_question
+    quiz.questions.where("position > ?", position).reorder(:position, :id).first
+  end
+
+  def move_up
+    swap_positions_with(previous_question)
+  end
+
+  def move_down
+    swap_positions_with(next_question)
+  end
+
+  private
+    def option_rows_assigned?
+      @option_rows_assigned == true
+    end
+
+    def options_follow_the_rules
+      filled = filled_option_rows
+      errors.add(:base, :too_few_options, message: "Add at least two options") if filled.size < MINIMUM_OPTIONS
+      errors.add(:base, :no_correct_option, message: "Mark at least one option as correct") if filled.none?(&:correct?)
+    end
+
+    def append_to_quiz
+      self.position ||= quiz.questions.maximum(:position).to_i + 1
+    end
+
+    # Updates the saved options to match the filled rows, keeping the ids of
+    # options that are still there.
+    def sync_options
+      remaining = options.index_by(&:id)
+
+      filled_option_rows.each.with_index(1) do |row, position|
+        option = remaining.delete(row.id) || options.build
+        option.update!(text: row.text, correct: row.correct?, position: position)
+      end
+
+      options.where(id: remaining.keys).delete_all if remaining.any?
+      options.reset
+      @option_rows = nil
+      @option_rows_assigned = false
+    end
+
+    def swap_positions_with(other)
+      return false unless other
+
+      transaction do
+        mine, theirs = position, other.position
+        update_columns(position: theirs, updated_at: Time.current)
+        other.update_columns(position: mine, updated_at: Time.current)
+      end
+      true
+    end
+end
diff --git a/app/models/question/option_row.rb b/app/models/question/option_row.rb
new file mode 100644
index 0000000..7497346
--- /dev/null
+++ b/app/models/question/option_row.rb
@@ -0,0 +1,24 @@
+# One row of the question form: what the moderator typed for an option.
+#
+# Rows are kept exactly as typed (including empty ones), so a form that fails
+# validation can be shown again unchanged. Only filled rows become options.
+class Question::OptionRow
+  include ActiveModel::Model
+  include ActiveModel::Attributes
+
+  attribute :id, :integer
+  attribute :text, :string, default: ""
+  attribute :correct, :boolean, default: false
+
+  def self.from_option(option)
+    new(id: option.id, text: option.text, correct: option.correct)
+  end
+
+  def filled?
+    text.to_s.strip.present?
+  end
+
+  def correct?
+    correct == true
+  end
+end
diff --git a/app/models/quiz.rb b/app/models/quiz.rb
new file mode 100644
index 0000000..20e8f2f
--- /dev/null
+++ b/app/models/quiz.rb
@@ -0,0 +1,38 @@
+class Quiz < ApplicationRecord
+  DEFAULT_WINNERS = 3 # also the column default
+  MAXIMUM_WINNERS = 10_000
+  MAXIMUM_TIMER_MINUTES = 99 # the countdown reads at most "99:59"
+
+  has_many :questions, -> { order(:position, :id) }, dependent: :destroy, inverse_of: :quiz
+  has_many :games, dependent: :delete_all, inverse_of: :quiz
+
+  normalizes :title, with: ->(title) { title.strip }
+
+  validates :title, presence: true
+  # "Number of winners": how many players get a prize at the end of a game
+  # ("Top N" and "Draw" on the big screen).
+  validates :winners_count, numericality: { only_integer: true, in: 1..MAXIMUM_WINNERS,
+    message: "must be a whole number from 1 to #{MAXIMUM_WINNERS.to_fs(:delimited)}" }
+  # "Timer minutes" and "Timer seconds": the time per question (0 and 0: no
+  # timer). The big screen counts down from "M:SS", exactly as typed, so the
+  # seconds stay below a minute.
+  validates :timer_minutes, numericality: { only_integer: true, in: 0..MAXIMUM_TIMER_MINUTES,
+    message: "must be a whole number from 0 to #{MAXIMUM_TIMER_MINUTES}" }
+  validates :timer_seconds, numericality: { only_integer: true, in: 0..59, message: "must be a whole number from 0 to 59" }
+
+  scope :newest_first, -> { order(created_at: :desc, id: :desc) }
+
+  def active_questions
+    questions.select(&:active?)
+  end
+
+  # The time per question, or nil without a timer.
+  def timer_duration
+    seconds = timer_minutes.to_i * 60 + timer_seconds.to_i
+    seconds.seconds if seconds.positive?
+  end
+
+  def timer?
+    timer_duration.present?
+  end
+end
diff --git a/app/models/quiz/export.rb b/app/models/quiz/export.rb
new file mode 100644
index 0000000..f554b32
--- /dev/null
+++ b/app/models/quiz/export.rb
@@ -0,0 +1,41 @@
+# The portable form of a quiz, shown on its "Export" page and read back by
+# Quiz::Import (on this Quizzy or another one):
+#
+#   {
+#     "title": "Frontend Fest 2026",
+#     "questions": [
+#       { "text": "...", "active": true,
+#         "options": [ { "text": "418", "correct": false }, { "text": "429", "correct": true } ] }
+#     ]
+#   }
+#
+# Only the quiz contents, in order: no ids, positions, timestamps or anything
+# else. "active" and "correct" are always written.
+class Quiz::Export
+  attr_reader :quiz
+
+  def initialize(quiz)
+    @quiz = quiz
+  end
+
+  def as_json(*)
+    {
+      "title" => quiz.title,
+      "questions" => quiz.questions.includes(:options).map do |question|
+        {
+          "text" => question.text,
+          "active" => question.active?,
+          "options" => question.options.map { |option| { "text" => option.text, "correct" => option.correct? } }
+        }
+      end
+    }
+  end
+
+  def to_json(*)
+    JSON.pretty_generate(as_json)
+  end
+
+  def filename
+    "#{quiz.title.parameterize.presence || "quiz"}.json"
+  end
+end
diff --git a/app/models/quiz/import.rb b/app/models/quiz/import.rb
new file mode 100644
index 0000000..661ab4c
--- /dev/null
+++ b/app/models/quiz/import.rb
@@ -0,0 +1,147 @@
+# Creates a new quiz from the JSON that Quiz::Export writes ("Import quiz").
+#
+# - The import always creates a new quiz, even if one with the same title exists.
+# - "questions" and "options" keep their order.
+# - "active" is optional (true by default), "correct" is optional (false by default).
+#   When given, they must be true or false. Other keys are ignored.
+# - The quiz and its questions go through the same models, and so the same rules,
+#   as the quiz and question forms: a title, a question text, at least two
+#   options, at least one of them correct. As in the question form, options
+#   with an empty text are skipped and do not count.
+#
+# All or nothing: when the JSON is invalid or breaks a rule, #save returns
+# false, nothing is stored, and +errors+ lists every problem found.
+class Quiz::Import
+  include ActiveModel::Model
+  include ActiveModel::Attributes
+
+  BYTE_ORDER_MARK = "\uFEFF"
+
+  attribute :json, :string, default: ""
+
+  # The quiz built from the JSON (not saved until #save succeeds).
+  attr_reader :quiz
+
+  validate :json_describes_a_quiz
+
+  def save
+    return false unless valid?
+
+    Quiz.transaction { quiz.save! }
+    true
+  rescue ActiveRecord::RecordInvalid => error
+    problem error.record.errors.full_messages.to_sentence
+    false
+  end
+
+  private
+    def json_describes_a_quiz
+      @quiz = nil
+      data = parse
+      return if errors.any? # not JSON ("null" parses fine, to nil)
+
+      unless data.is_a?(Hash)
+        problem 'The JSON must be an object with "title" and "questions"'
+        return
+      end
+
+      @quiz = build_quiz(data)
+      build_questions(data["questions"])
+    end
+
+    def parse
+      text = json.to_s.delete_prefix(BYTE_ORDER_MARK)
+
+      if text.blank?
+        problem "Paste the JSON of a quiz"
+        return nil
+      end
+
+      JSON.parse(text)
+    rescue JSON::ParserError => error
+      problem "Invalid JSON: #{error.message.truncate(200)}"
+      nil
+    end
+
+    def build_quiz(data)
+      title = data["title"]
+
+      Quiz.new.tap do |quiz|
+        if title.nil? || title.is_a?(String)
+          quiz.title = title
+          quiz.validate
+          quiz.errors.full_messages.each { |message| problem message }
+        else
+          problem '"title" must be a string'
+        end
+      end
+    end
+
+    def build_questions(entries)
+      unless entries.is_a?(Array)
+        problem '"questions" must be a list of questions (it may be empty)'
+        return
+      end
+
+      entries.each.with_index(1) { |entry, number| build_question(entry, number) }
+    end
+
+    def build_question(entry, number)
+      unless entry.is_a?(Hash)
+        problem "Question #{number} must be an object with \"text\" and \"options\""
+        return
+      end
+
+      text, active, options = entry["text"], entry.fetch("active", true), entry["options"]
+      where = question_label(number, text)
+      fine = true
+
+      fine = problem('"text" must be a string', where) unless text.is_a?(String)
+      fine = problem('"active" must be true or false', where) unless boolean?(active)
+
+      if options.is_a?(Array)
+        rows = options.map.with_index(1) { |option, option_number| option_row(option, "#{where}, option #{option_number}") }
+        fine &&= rows.all?
+      else
+        fine = problem('"options" must be a list of options', where)
+      end
+
+      return unless fine
+
+      question = quiz.questions.build(text: text, active: active, position: number)
+      question.option_rows = rows
+      question.validate
+      question.errors.full_messages.each { |message| problem message, where }
+    end
+
+    # The option as a question form row, or nil when it is malformed.
+    def option_row(option, where)
+      unless option.is_a?(Hash)
+        problem "#{where} must be an object with \"text\""
+        return
+      end
+
+      text, correct = option["text"], option.fetch("correct", false)
+      fine = true
+      fine = problem('"text" must be a string', where) unless text.is_a?(String)
+      fine = problem('"correct" must be true or false', where) unless boolean?(correct)
+
+      { text: text, correct: correct } if fine
+    end
+
+    # "Question 2" plus the start of its text, so the moderator finds it in the JSON.
+    def question_label(number, text)
+      excerpt = text.squish.truncate(60) if text.is_a?(String)
+      excerpt.present? ? "Question #{number} “#{excerpt}”" : "Question #{number}"
+    end
+
+    def boolean?(value)
+      value == true || value == false
+    end
+
+    # Records a problem; returns false so callers can write `fine = problem(...)`.
+    def problem(message, where = nil)
+      errors.add(:base, [ where, message ].compact.join(": "))
+      false
+    end
+end
diff --git a/app/models/round.rb b/app/models/round.rb
new file mode 100644
index 0000000..836c956
--- /dev/null
+++ b/app/models/round.rb
@@ -0,0 +1,80 @@
+# A question shown in a game. Players can answer while it is open; "Finish"
+# closes it and reveals the results.
+#
+# +opened_at+ is the moment the question opened (screens and phones get it
+# right then, see Game#broadcast_change). An answer's time runs from there to
+# the player's last pick (Answer#elapsed_us); speed breaks ties on the
+# leaderboard (Game::Leaderboard).
+#
+# With the quiz's timer, +closes_at+ is when the time is up, fixed when the
+# question opens. The round then finishes by itself (Game#finish_when_time_is_up,
+# Game::Timer), and picks made from that moment on are refused.
+class Round < ApplicationRecord
+  belongs_to :game, inverse_of: :rounds
+  belongs_to :question
+  has_many :answers, dependent: :delete_all, inverse_of: :round
+
+  before_validation -> { self.opened_at ||= Time.current }, on: :create
+
+  def open?
+    closed_at.nil?
+  end
+
+  def close
+    update!(closed_at: Time.current) if open?
+  end
+
+  def timed?
+    closes_at.present?
+  end
+
+  # Whether the round's time is up (it may not be closed yet).
+  def time_up?(at = Time.current)
+    timed? && at >= closes_at
+  end
+
+  # Seconds left on the timer (a Float, never negative), or nil without one.
+  def time_left(at = Time.current)
+    [ closes_at - at, 0.0 ].max if timed?
+  end
+
+  # 1 for the first question shown in the game, 2 for the next one, ...
+  # (counted, so a deleted question leaves no gap).
+  def position
+    game.rounds.where(number: ..number).count
+  end
+
+  # Number of answers per option id.
+  def answer_counts
+    answers.group(:option_id).count
+  end
+
+  # Records the player's pick, or changes it. Returns the answer, or nil when
+  # the round is closed, its time is up, or the option belongs to another
+  # question. Picking the option the player already has changes nothing (not
+  # even the time).
+  def record_answer(player, option_id)
+    picked_at = Time.current
+
+    transaction do
+      reload
+      option = question.options.find_by(id: option_id)
+      next unless open? && !time_up?(picked_at) && option && player.game_id == game_id
+
+      answer = answers.find_or_initialize_by(player: player)
+      if answer.new_record?
+        answer.update!(option: option, elapsed_us: elapsed_us(picked_at))
+      elsif answer.option_id != option.id
+        answer.update!(option: option, revision: answer.revision + 1, elapsed_us: elapsed_us(picked_at))
+      end
+      answer
+    end
+  end
+
+  private
+    # Microseconds from the opening of the round to +time+. (The column may be
+    # empty only for rounds older than it; they opened when they were created.)
+    def elapsed_us(time)
+      [ ((time - (opened_at || created_at)) * 1_000_000).round, 0 ].max
+    end
+end
