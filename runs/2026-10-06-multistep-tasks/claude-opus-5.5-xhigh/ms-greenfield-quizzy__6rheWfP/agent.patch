diff --git a/app/views/moderate/questions/_form.html.erb b/app/views/moderate/questions/_form.html.erb
new file mode 100644
index 0000000..8bf638d
--- /dev/null
+++ b/app/views/moderate/questions/_form.html.erb
@@ -0,0 +1,44 @@
+<% rows = question.option_rows %>
+<%= form_with model: question, url: question.new_record? ? moderate_quiz_questions_path(quiz) : moderate_quiz_question_path(quiz, question),
+      class: "card", data: { controller: "option-rows", option_rows_next_index_value: rows.size } do |form| %>
