+.counter-pill strong { font-family: var(--f-display); font-weight: 900; font-size: 1.3em; }
+
+@media (max-width: 800px) {
+  .lobby { grid-template-columns: 1fr; }
+  .qr { width: min(80vw, 420px); }
+}
+
+/* Question on the big screen */
+
+.stage-question__num { font-family: var(--f-display); font-weight: 800; font-size: clamp(20px, 2vw, 36px); opacity: 0.8; margin-bottom: 0.6em; }
+
+.stage-question__body {
+  font-family: var(--f-display);
+  font-weight: 800;
+  font-size: clamp(32px, 4.4vw, 88px);
+  line-height: 1.02;
+  letter-spacing: -0.02em;
+  margin-bottom: clamp(24px, 3vw, 56px);
+  white-space: pre-line;
+  overflow-wrap: anywhere;
+}
+
+.stage-options {
+  list-style: none;
+  padding: 0;
+  margin: 0;
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
+  gap: clamp(12px, 1.4vw, 24px);
+}
+
+.stage-option {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: 0.8em;
+  overflow: hidden;
+  background: var(--c-lavender);
+  color: var(--c-blue);
+  border-radius: clamp(14px, 1.4vw, 24px);
+  padding: 0.8em 1em;
+  font-size: clamp(20px, 2.2vw, 40px);
