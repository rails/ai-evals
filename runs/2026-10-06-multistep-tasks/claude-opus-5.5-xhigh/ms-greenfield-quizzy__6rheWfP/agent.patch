diff --git a/app/views/moderate/questions/_option_row.html.erb b/app/views/moderate/questions/_option_row.html.erb
new file mode 100644
index 0000000..46e78ef
--- /dev/null
+++ b/app/views/moderate/questions/_option_row.html.erb
@@ -0,0 +1,26 @@
+<%#
+  One option row of the question form.
+  `index` keeps the submitted rows apart (question[options][<index>]); `number` is what the moderator sees.
+  The template for "Add option" renders this with the __INDEX__ / __NUMBER__ placeholders.
+%>
+<% field = "question[options][#{index}]" %>
+<div class="option-row" data-option-rows-target="row">
+  <% if row.id.present? %>
+    <%= hidden_field_tag "#{field}[id]", row.id, id: nil %>
+  <% end %>
+
+  <%= text_field_tag "#{field}[text]", row.text, id: "question_option_#{index}_text", class: "input option-row__text",
+        placeholder: "Option #{number}", autocomplete: "off",
+        aria: { label: "Option #{number}" }, data: { option_rows_target: "text" } %>
+
+  <label class="checkbox option-row__correct">
+    <%= hidden_field_tag "#{field}[correct]", "0", id: nil %>
+    <%= check_box_tag "#{field}[correct]", "1", row.correct?, id: "question_option_#{index}_correct",
+          aria: { label: "Option #{number} is correct" }, data: { option_rows_target: "correct" } %>
+    <span class="visually-hidden" data-option-rows-target="correctLabel">Option <%= number %> is correct</span>
+    <span aria-hidden="true">Correct</span>
+  </label>
+
+  <button type="button" class="btn btn--danger btn--icon" title="Remove option <%= number %>"
+          aria-label="Remove option <%= number %>" data-option-rows-target="remove" data-action="option-rows#remove">✕</button>
+</div>
diff --git a/app/views/moderate/questions/_question.html.erb b/app/views/moderate/questions/_question.html.erb
new file mode 100644
index 0000000..1b3e7af
--- /dev/null
+++ b/app/views/moderate/questions/_question.html.erb
@@ -0,0 +1,46 @@
+<%# One question on the quiz page. `number` is its place among the active questions (nil when inactive). %>
+<% inline_form = { turbo: false, action: "submit->inline-save#submit" } %>
+<li class="card question-item<%= " question-item--inactive" unless question.active? %>" id="<%= dom_id(question) %>">
+  <div class="question-item__num" title="<%= question.active? ? "Question #{number}" : "Inactive: skipped when the quiz is played" %>"><%= number || "—" %></div>
+
+  <div class="question-item__content">
+    <div class="question-item__body"><%= question.text %></div>
+    <div class="question-item__options">
+      <% question.options.each_with_index do |option, index| %>
+        <span class="question-item__option<%= " is-correct" if option.correct? %>">
+          <% if option.correct? %><span class="question-item__check" aria-hidden="true">✓</span><% end %>
+          <span class="question-item__letter"><%= option_letter(index) %>.</span>
+          <span class="question-item__option-text"><%= option.text %></span>
+          <% if option.correct? %><span class="visually-hidden">(correct)</span><% end %>
+        </span>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="question-item__actions">
+    <div class="buttons">
+      <%= button_to moderate_quiz_question_position_path(quiz, question), method: :patch, params: { direction: "up" },
+            form: { data: inline_form }, class: "btn btn--ghost btn--icon", disabled: first,
+            title: "Move up", aria: { label: "Move up" } do %>↑<% end %>
+      <%= button_to moderate_quiz_question_position_path(quiz, question), method: :patch, params: { direction: "down" },
+            form: { data: inline_form }, class: "btn btn--ghost btn--icon", disabled: last,
+            title: "Move down", aria: { label: "Move down" } do %>↓<% end %>
+    </div>
+
+    <%= form_with model: question, url: moderate_quiz_question_activation_path(quiz, question), method: :patch,
+          class: "question-item__activation", data: inline_form.merge(controller: "auto-submit") do |form| %>
+      <label class="checkbox">
+        <%= form.check_box :active, id: dom_id(question, :active), data: { action: "auto-submit#submit" } %>
+        Active
+      </label>
+      <noscript><%= form.button "Save", class: "btn btn--sm" %></noscript>
+    <% end %>
+
+    <div class="buttons">
