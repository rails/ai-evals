+# "Start a game" on the quiz page creates a game and opens its big screen.
+class Moderate::GamesController < Moderate::BaseController
+  before_action :set_quiz, only: :create
+
+  layout "screen"
+
+  def create
+    game = @quiz.games.create!
+    redirect_to moderate_game_path(game), status: :see_other
+  end
+
+  def show
+    @game = Game.find(params[:id])
+    @game.keep_time # a question whose time is up finishes first
+    @screen = Game::Screen.new(@game)
+    @join_url = join_url_for(@game)
+  end
+
+  private
+    # The link players open. QUIZZY_PUBLIC_URL (say, "http://192.168.1.20:3000")
+    # replaces the address the moderator used, for when the big screen runs on
+    # localhost but the phones need another address.
+    def join_url_for(game)
+      base = ENV["QUIZZY_PUBLIC_URL"].presence&.chomp("/") || request.base_url
+      "#{base}#{play_path(game.code)}"
+    end
+end
