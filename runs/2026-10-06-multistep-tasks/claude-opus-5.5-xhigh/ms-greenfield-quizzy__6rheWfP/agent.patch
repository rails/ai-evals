diff --git a/app/views/moderate/quizzes/_form.html.erb b/app/views/moderate/quizzes/_form.html.erb
new file mode 100644
index 0000000..a3666f1
--- /dev/null
+++ b/app/views/moderate/quizzes/_form.html.erb
@@ -0,0 +1,40 @@
+<%# novalidate: the browser's own checks (min) would block the form with a
+    tooltip; the server checks the same and shows its message on the page. %>
+<%= form_with model: [ :moderate, quiz ], class: "card", html: { novalidate: true } do |form| %>
+  <%= render "errors", record: quiz %>
+
+  <div class="field">
+    <%= form.label :title, "Title" %>
+    <%= form.text_field :title, class: "input", autofocus: quiz.new_record?, autocomplete: "off", aria: { required: true } %>
+  </div>
+
+  <div class="field">
+    <%= form.label :winners_count, "Number of winners" %>
+    <%= form.number_field :winners_count, class: "input input--number", min: 1, max: Quiz::MAXIMUM_WINNERS, step: 1,
+          inputmode: "numeric", aria: { required: true, describedby: "quiz_winners_count_hint" } %>
+    <span class="field-hint" id="quiz_winners_count_hint">How many players get a prize when a game is over.</span>
+  </div>
+
+  <%# The time per question. The hint must not repeat the labels' texts. %>
+  <fieldset class="field-group">
+    <legend class="field-group__legend">Time per question</legend>
+    <div class="field-group__row">
+      <div class="field">
+        <%= form.label :timer_minutes, "Timer minutes" %>
+        <%= form.number_field :timer_minutes, class: "input input--number", min: 0, max: Quiz::MAXIMUM_TIMER_MINUTES, step: 1,
+              inputmode: "numeric", aria: { required: true, describedby: "quiz_timer_hint" } %>
+      </div>
+      <div class="field">
+        <%= form.label :timer_seconds, "Timer seconds" %>
+        <%= form.number_field :timer_seconds, class: "input input--number", min: 0, max: 59, step: 1,
+              inputmode: "numeric", aria: { required: true, describedby: "quiz_timer_hint" } %>
+      </div>
+    </div>
+    <span class="field-hint" id="quiz_timer_hint">The big screen counts down while a question is open; at 0:00 the question closes by itself. 0 and 0: no timer.</span>
+  </fieldset>
+
+  <div class="buttons">
+    <%= form.button "Save quiz", class: "btn btn--pink" %>
+    <%= link_to "Cancel", quiz.persisted? ? moderate_quiz_path(quiz) : moderate_root_path, class: "btn btn--ghost" %>
+  </div>
+<% end %>
