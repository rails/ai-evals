diff --git a/spec/support/before_all.rb b/spec/support/before_all.rb
new file mode 100644
index 0000000..16cda35
--- /dev/null
+++ b/spec/support/before_all.rb
@@ -0,0 +1,20 @@
+# frozen_string_literal: true
+
+# `before_all` / `let_it_be` (from TestProf) create data once per example group, inside a
+# transaction that is rolled back after the group. Use them for heavy shared setup which
+# examples only read (see docs/TEST_SUITE_PERFORMANCE.md).
+#
+# This setup runs before any `before(:each)` hooks, so we have to configure the
+# global test state it depends on here as well.
+TestProf::BeforeAll.configure do |config|
+  config.before(:begin) do |group|
+    # Use the Sidekiq testing mode of the example group (see `sidekiq` metadata in rails_helper.rb),
+    # instead of whatever mode was left over by the previously run example
+    Sidekiq.testing!(group.metadata[:sidekiq]) if group.respond_to?(:metadata)
+  end
+
+  config.after(:rollback) do
+    # Jobs pushed (in `:fake` mode) while creating shared data must not leak into other groups
+    Sidekiq::Job.clear_all
+  end
+end
diff --git a/spec/support/logging.rb b/spec/support/logging.rb
new file mode 100644
index 0000000..05e71d9
--- /dev/null
+++ b/spec/support/logging.rb
@@ -0,0 +1,28 @@
+# frozen_string_literal: true
+
+# Logging is expensive in the test suite: every SQL query (and with
+# `ActiveRecord.verbose_query_logs`, a cleaned backtrace of every query!) is
+# formatted and written to `log/test.log`, which nobody reads during regular
+# runs. Profiling showed logging taking ~40% of the `spec/models` wall time.
+#
+# We only log warnings and errors by default. To get full logs back when
+# debugging, run e.g.:
+#
+#   TEST_LOG_LEVEL=debug bin/rspec spec/models/status_spec.rb
+#   TEST_LOG_LEVEL=debug VERBOSE_QUERY_LOGS=true bin/rspec spec/models/status_spec.rb
+#
+# See docs/TEST_SUITE_PERFORMANCE.md for details.
+module TestLogging
+  def self.apply!
+    Rails.logger.level = ENV.fetch('TEST_LOG_LEVEL', 'warn').downcase.to_sym
+    ActiveRecord.verbose_query_logs = ENV['VERBOSE_QUERY_LOGS'] == 'true'
+  end
+end
+
+TestLogging.apply!
+
+RSpec.configure do |config|
+  # Re-apply once spec files are loaded, so that settings changed at load time
+  # by an individual spec file do not leak into the whole run.
+  config.before(:suite) { TestLogging.apply! }
+end
diff --git a/spec/support/password_digest_cache.rb b/spec/support/password_digest_cache.rb
new file mode 100644
index 0000000..1d76de5
--- /dev/null
+++ b/spec/support/password_digest_cache.rb
@@ -0,0 +1,29 @@
+# frozen_string_literal: true
+
+# Every fabricated user gets the same default password (see `spec/fabricators/user_fabricator.rb`),
+# and every local account fabricates a user, so the test suite hashes that password with bcrypt
+# thousands of times per run. Even with `Devise.stretches = 1`, bcrypt enforces its minimum cost (4):
+# ~0.9ms per user, ~2-3% of the `spec/models` and `spec/requests` run times.
+#
+# The digest of the default password is computed once per process and then reused. It is a regular
+# bcrypt digest of that password (`valid_password?`, sign in, etc. behave as usual); the only
+# difference is that users with the default password share the same salt. Any other password is
+# hashed as usual. See docs/TEST_SUITE_PERFORMANCE.md ("Phase 3: factories").
+module PasswordDigestCache
+  DEFAULT_PASSWORD = '123456789'
+
+  @digests = {}
+
+  class << self
+    attr_reader :digests
+  end
+
+  def digest(klass, password)
+    return super unless password == DEFAULT_PASSWORD
+
+    key = [klass.name, klass.stretches, klass.pepper]
+    (PasswordDigestCache.digests[key] ||= super.freeze).dup
+  end
+end
+
+Devise::Encryptor.singleton_class.prepend(PasswordDigestCache)
diff --git a/spec/support/test_routes_helpers.rb b/spec/support/test_routes_helpers.rb
new file mode 100644
index 0000000..c374048
--- /dev/null
+++ b/spec/support/test_routes_helpers.rb
@@ -0,0 +1,38 @@
+# frozen_string_literal: true
+
+# Dispatch requests to a set of test-only routes for the current example.
+#
+# Drawing such routes with `Rails.application.routes.draw` wipes the application
+# routes, which then have to be reloaded after the example with
+# `Rails.application.reload_routes!`: ~170ms each time, and redefining all the URL
+# helpers also slows down the code running afterwards (see docs/TEST_SUITE_PERFORMANCE.md).
+#
+# Instead, this draws the routes on a temporary route set, and only redirects the
+# dispatching of requests to it. Unlike Rails' `with_routing`, `Rails.application.routes`
+# itself (and its URL helpers, included by classes that may get autoloaded during
+# the example) is left untouched. The original dispatching is restored after each example.
+module TestRoutesHelpers
+  def draw_test_routes(&block)
+    test_routes = ActionDispatch::Routing::RouteSet.new
+    test_routes.draw(&block)
+
+    app_routes = Rails.application.routes
+    @original_app_routes_call ||= app_routes.method(:call)
+    app_routes.singleton_class.redefine_method(:call) { |env| test_routes.call(env) }
+  end
+
+  def restore_app_routes
+    return if @original_app_routes_call.nil?
+
+    app_routes_singleton = Rails.application.routes.singleton_class
+    app_routes_singleton.remove_method(:call)
+    # Put back a singleton method that existed before, if any
+    app_routes_singleton.define_method(:call, @original_app_routes_call) if @original_app_routes_call.owner == app_routes_singleton
+    @original_app_routes_call = nil
+  end
+end
+
+RSpec.configure do |config|
+  config.include TestRoutesHelpers, type: :request
+  config.after(type: :request) { restore_app_routes }
+end
