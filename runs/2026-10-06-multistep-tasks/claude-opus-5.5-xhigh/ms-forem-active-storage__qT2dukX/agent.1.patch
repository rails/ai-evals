+          .with_profile_image.to_a
+
+        expect(records).to all(satisfy { |r| r.association(:avatar_attachment).loaded? })
+        expect(records.map(&:profile_image_url)).to all(include("/rails/active_storage/"))
+      end
+    end
+  end
+
+  context "with a user" do
+    let(:factory) { :user }
+    let(:described_class_for_factory) { User }
+
+    it_behaves_like "a record with a profile image"
+
+    it "busts the profile image caches when a new image is uploaded" do
+      user = create(:user)
