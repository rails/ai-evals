+require "rails_helper"
+
+RSpec.describe ProfileImageStorage do
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:new_upload) { Rack::Test::UploadedFile.new(png_path, "image/png") }
+
+  let(:stored_uploaders) { [] }
+
+  after { stored_uploaders.each(&:remove!) }
+
+  # A profile image stored by CarrierWave before this deploy (its URL doesn't need the file).
+  def make_legacy(record, identifier: "legacy.jpg")
+    record.avatar.purge
+    record.update_column(:profile_image, identifier)
+    record.reload
+  end
+
+  # Same, with the file actually stored by CarrierWave.
+  def make_legacy_with_file(record)
+    record.avatar.purge
+    uploader = ProfileImageUploader.new(record, :profile_image)
+    uploader.store!(Rack::Test::UploadedFile.new(png_path, "image/png"))
+    stored_uploaders << uploader
+    record.update_column(:profile_image, uploader.identifier)
+    record.reload
+  end
+
+  def legacy_url(record, identifier: "legacy.jpg")
+    "/uploads/#{record.class.name.underscore}/profile_image/#{record.id}/#{identifier}"
+  end
+
+  shared_examples "a record with a profile image" do
+    describe "new profile images" do
+      it "stores uploads in Active Storage, without touching the CarrierWave column" do
+        record = create(factory)
+
+        expect(record.avatar).to be_attached
+        expect(record.read_attribute(:profile_image)).to be_nil
+        expect(record.profile_image_url).to eq(record.avatar_url)
+        expect(record.profile_image_url).to start_with(URL.url("/rails/active_storage/blobs/proxy/"))
+      end
+
+      it "stores the uploaded file as is (processing is disabled in tests)" do
+        record = create(factory)
+        record.update!(profile_image: new_upload)
+
+        expect(record.reload.avatar.download).to eq(File.binread(png_path))
+        expect(record.avatar.filename.to_s).to match(/\A\h{8}-\h{4}-\h{4}-\h{4}-\h{12}\.png\z/)
+        expect(record.avatar.content_type).to eq("image/png")
+        # Like CarrierWave's, so that image optimizers can tell e.g. GIFs from the URLs.
+        expect(record.avatar.key).to end_with(".png")
+      end
+
+      it "downloads remote images into Active Storage" do
+        stub_request(:get, "https://images.example.com/avatar.png")
+          .to_return(body: File.binread(png_path), headers: { "Content-Type" => "image/png" })
+        record = create(factory)
+
+        record.remote_profile_image_url = "https://images.example.com/avatar.png"
+        record.save!
+
+        expect(record.remote_profile_image_url).to eq("https://images.example.com/avatar.png")
+        expect(record.reload.avatar.download).to eq(File.binread(png_path))
+        expect(record.read_attribute(:profile_image)).to be_nil
+      end
+
+      it "stores generated images handed over as remote URL (see Images::SafeRemoteProfileImageUrl)" do
+        record = create(factory)
+        record.remote_profile_image_url = Images::SafeRemoteProfileImageUrl.call("not a url")
+
+        expect(record).to be_valid
+        record.save!
+        expect(record.reload.avatar).to be_attached
+      end
+
+      it "rejects files ProfileImageUploader rejects, with its errors" do
+        record = create(factory)
+        previous_url = record.profile_image_url
+
+        record.profile_image = Rack::Test::UploadedFile.new(Rails.root.join("spec/fixtures/files/800x600.pdf"),
+                                                            "application/pdf")
+
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image]).to be_present
+        expect(record.reload.profile_image_url).to eq(previous_url)
+      end
+
+      it "reports download errors like CarrierWave did" do
+        record = create(factory)
+        record.remote_profile_image_url = "https://"
+
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image]).to be_present
+      end
+
+      it "ignores empty files, like CarrierWave did" do
+        stub_request(:get, "https://images.example.com/empty.png").to_return(body: "")
+        record = create(factory)
+
+        expect { record.update!(remote_profile_image_url: "https://images.example.com/empty.png") }
+          .not_to(change { record.reload.profile_image_url })
+      end
+
+      it "does not leave processed copies behind" do
+        record = create(factory)
+
+        expect { record.update!(profile_image: new_upload) }
+          .not_to(change { Rails.public_path.glob("uploads/tmp/*") })
+        expect(Rails.root.glob("tmp/uploads/profile_image/*")).to be_empty
+      end
+    end
+
+    describe "existing (CarrierWave) profile images" do
+      it "keeps serving them from where they are" do
+        record = make_legacy(create(factory))
+
+        expect(record.avatar).not_to be_attached
+        expect(record.profile_image_url).to eq(legacy_url(record))
+        expect(record.profile_image_url).to eq(record.profile_image.url)
+      end
+
+      it "prefers a new Active Storage image, and keeps the CarrierWave one for rollbacks" do
+        record = make_legacy(create(factory))
+
+        record.update!(profile_image: new_upload)
+        record.reload
+
+        expect(record.profile_image_url).to eq(record.avatar_url)
+        # The previous release (rolling deploy or rollback) still finds a valid CarrierWave image.
+        expect(record.read_attribute(:profile_image)).to eq("legacy.jpg")
+        expect(record.profile_image.url).to eq(legacy_url(record))
+      end
+
+      it "does not delete the CarrierWave file when a new image is uploaded" do
+        record = make_legacy_with_file(create(factory))
+        expect(File).to exist(record.profile_image.path)
+
+        record.update!(profile_image: new_upload)
+
+        expect(File).to exist(record.reload.profile_image.path)
+        expect(record.profile_image_url).to eq(record.avatar_url)
+      end
+    end
+
+    describe "removing the profile image (CarrierWave semantics)" do
+      it "removes the Active Storage image when assigning nil or a blank string" do
+        [nil, ""].each do |blank|
+          record = create(factory)
+          record.profile_image = blank
+          record.save(validate: false)
+
+          expect(record.reload.avatar).not_to be_attached
+          expect(record.read_attribute(:profile_image)).to be_nil
+        end
+      end
+
+      it "keeps the image when assigning the identifier of the CarrierWave image" do
+        record = make_legacy_with_file(create(factory))
+        url = record.profile_image_url
+
+        record.update!(profile_image: record.read_attribute(:profile_image))
+
+        expect(record.reload.profile_image_url).to eq(url)
+        expect(File).to exist(record.profile_image.path)
+      end
+
+      it "removes the CarrierWave image too" do
+        record = make_legacy_with_file(create(factory))
+
+        record.profile_image = nil
+        record.save(validate: false)
+
+        expect(record.reload.read_attribute(:profile_image)).to be_nil
+        expect(record.profile_image_url).to be_nil
+      end
+    end
+
+    describe "#profile_image?" do
+      it "is true for an image in either store, or a pending upload" do
+        expect(create(factory)).to be_profile_image
+        expect(build(factory, profile_image: nil).tap { |r| r.profile_image = new_upload }).to be_profile_image
+        expect(build(factory, profile_image: nil)).not_to be_profile_image
+      end
+    end
+
+    describe "#saved_change_to_avatar?" do
+      it "tells whether the last save changed the Active Storage image" do
+        record = create(factory)
+        expect(record.saved_change_to_avatar?).to be(true)
+
+        record.update!(name: "Another name")
+        expect(record.saved_change_to_avatar?).to be(false)
+
+        record.update!(profile_image: new_upload)
+        expect(record.saved_change_to_avatar?).to be(true)
+        expect(record.reload.saved_change_to_avatar?).to be(false)
+      end
+    end
+
+    describe "serialization" do
+      it "keeps CarrierWave's { url: } shape, for the image that is displayed" do
+        record = create(factory)
+        expect(record.as_json["profile_image"]).to eq({ "url" => record.avatar_url })
+
+        legacy = make_legacy(create(factory))
+        expect(legacy.as_json["profile_image"]).to eq(legacy.profile_image.as_json)
+      end
+    end
+
+    describe ".with_profile_image" do
+      it "preloads the Active Storage image" do
+        create_list(factory, 2)
