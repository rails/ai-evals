+require "rails_helper"
+
+RSpec.describe "profile_images:copy", type: :task do
+  let(:task) { Rake::Task["profile_images:copy"] }
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:uploader) { ProfileImageUploader.new(user, :profile_image) }
+  let(:user) { create(:user) }
+
+  before do
+    task.reenable
+    user.avatar.purge
+    uploader.store!(Rack::Test::UploadedFile.new(png_path, "image/png"))
+    user.update_column(:profile_image, uploader.identifier)
+  end
+
+  after { uploader.remove! }
+
+  it "copies the CarrierWave profile images into Active Storage, and reports it" do
+    expect { task.invoke }.to output(/Users done: 1 copied, 0 skipped, 0 missing, 0 failed/).to_stdout
+    expect(user.reload.avatar.download).to eq(File.binread(png_path))
+    expect(user.profile_image_url).to eq(user.avatar_url)
+  end
+
+  it "can run again" do
+    expect { task.invoke }.to output.to_stdout
+    task.reenable
+
+    expect { task.invoke }.to output(/Users done: 0 copied/).to_stdout
+    expect(ActiveStorage::Attachment.where(record: user, name: "avatar").count).to eq(1)
+  end
+
+  it "fails when profile images could not be copied, to be run again" do
+    allow(ActiveStorage::Blob.service).to receive(:upload).and_raise(Excon::Error::Socket)
+
+    expect { task.invoke }
+      .to raise_error(SystemExit) { |error| expect(error.status).not_to eq(0) }
+      .and output(%r{1 profile images could not be copied.*Run `bin/rails profile_images:copy` again}m).to_stderr
+      .and output(/Could not copy the profile image of User #{user.id}/).to_stdout
+    expect(user.reload.avatar).not_to be_attached
+  end
+end
