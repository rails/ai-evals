@@ -0,0 +1,48 @@
+require "rails_helper"
+
+RSpec.describe ProfileImages::LegacyFile do
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:user) { create(:user) }
+  let(:uploader) { ProfileImageUploader.new(user, :profile_image) }
+
+  before { uploader.store!(Rack::Test::UploadedFile.new(png_path, "image/png")) }
+
+  after { uploader.remove! }
+
+  describe ".find" do
+    it "finds the file CarrierWave stored for the record" do
+      file = described_class.find(user, uploader.identifier)
+
+      expect(file.path).to eq(uploader.path)
+      expect(file.path).to include("/uploads/user/profile_image/#{user.id}/")
+      expect(file.read.b).to eq(File.binread(png_path))
+    end
+
+    it "doesn't look for anything that can't be a CarrierWave identifier" do
+      [nil, "", Moderator::BanishUser::DEFAULT_PROFILE_IMAGE, "../../../../config/database.yml", ".", ".."]
+        .each { |identifier| expect(described_class.find(user, identifier)).to be_nil }
+    end
+  end
+
+  describe ".delete" do
+    it "deletes the file" do
+      described_class.delete(user, uploader.identifier)
+
+      expect(File).not_to exist(uploader.path)
+    end
+
+    it "doesn't delete anything outside of the record's CarrierWave files" do
+      expect { described_class.delete(user, "../../../../Gemfile") }.not_to raise_error
+      expect(Rails.root.join("Gemfile")).to exist
+      expect(File).to exist(uploader.path)
+    end
+
+    it "logs errors instead of raising them" do
+      allow(ProfileImageUploader).to receive(:new).and_raise(Excon::Error::Socket)
+      allow(Rails.logger).to receive(:error)
+
+      expect { described_class.delete(user, uploader.identifier) }.not_to raise_error
+      expect(Rails.logger).to have_received(:error).with(/Could not delete the CarrierWave profile image of User/)
+    end
+  end
+end
