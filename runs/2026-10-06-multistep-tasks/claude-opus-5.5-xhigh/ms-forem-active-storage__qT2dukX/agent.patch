diff --git a/lib/active_storage/service/fog_service.rb b/lib/active_storage/service/fog_service.rb
new file mode 100644
index 0000000..efc8cd9
--- /dev/null
+++ b/lib/active_storage/service/fog_service.rb
@@ -0,0 +1,149 @@
+require "fog/aws"
+
+module ActiveStorage
+  class Service
+    # Active Storage service backed by Fog, so that Active Storage can use the same S3 buckets and
+    # credentials as CarrierWave (which already depends on fog-aws) without pulling in aws-sdk-s3.
+    #
+    # Configuration (config/storage.yml):
+    #
+    #   amazon:
+    #     service: Fog
+    #     provider: AWS              # any other key is passed to Fog::Storage.new
+    #     aws_access_key_id: ...
+    #     aws_secret_access_key: ...
+    #     region: us-east-1
+    #     directory: my-bucket       # bucket name
+    #     prefix: active_storage     # optional, objects are stored under "<prefix>/<key>"
+    #     public: true               # upload with a public-read ACL and hand out permanent URLs
+    #     upload:                    # optional, extra Fog::AWS::Storage::File attributes
+    #       cache_control: "public, max-age=31536000"
+    #
+    # Direct uploads and #compose are not supported.
+    class FogService < Service
+      attr_reader :directory_name, :prefix, :upload_options
+
+      def initialize(directory:, public: false, prefix: nil, upload: {}, **fog_credentials)
+        super()
+        @directory_name = directory
+        @public = public
+        @prefix = prefix.presence&.delete_suffix("/")
+        @upload_options = upload.to_h.symbolize_keys
+        @fog_credentials = fog_credentials
+      end
+
+      def upload(key, io, checksum: nil, filename: nil, content_type: nil, disposition: nil, custom_metadata: {}, **)
+        instrument :upload, key: key, checksum: checksum do
+          attributes = {
+            key: path_for(key),
+            body: io,
+            public: public?,
+            content_type: content_type,
+            content_md5: checksum,
+            metadata: custom_metadata_headers(custom_metadata)
+          }
+          if disposition && filename
+            attributes[:content_disposition] = content_disposition_with(type: disposition, filename: filename)
+          end
+
+          directory.files.create(attributes.compact.merge(upload_options))
+        rescue Excon::Error::BadRequest => e
+          raise ActiveStorage::IntegrityError if e.response&.body.to_s.include?("BadDigest")
+
+          raise
+        end
+      end
+
+      def download(key, &block)
+        if block
+          instrument :streaming_download, key: key do
+            with_file_not_found_error do
+              client.get_object(directory_name, path_for(key)) { |chunk, _remaining, _total| yield chunk }
+            end
+          end
+        else
+          instrument :download, key: key do
+            with_file_not_found_error do
+              client.get_object(directory_name, path_for(key)).body.force_encoding(Encoding::BINARY)
+            end
+          end
+        end
+      end
+
+      def download_chunk(key, range)
+        instrument :download_chunk, key: key, range: range do
+          range_end = range.exclude_end? ? range.end - 1 : range.end
+          with_file_not_found_error do
+            client.get_object(directory_name, path_for(key), "Range" => "bytes=#{range.begin}-#{range_end}")
+              .body.force_encoding(Encoding::BINARY)
+          end
+        end
+      end
+
+      def delete(key)
+        instrument :delete, key: key do
+          client.delete_object(directory_name, path_for(key))
+        rescue Excon::Error::NotFound
+          # Already gone, nothing to do.
+        end
+      end
+
+      def delete_prefixed(prefix)
+        instrument :delete_prefixed, prefix: prefix do
+          # Fog::AWS::Storage::Files#each pages through all the results, Array#map would only see the first page.
+          keys = directory.files.all(prefix: path_for(prefix)).to_enum(:each).map(&:key)
+          keys.each_slice(1000) { |batch| client.delete_multiple_objects(directory_name, batch, quiet: true) }
+        end
+      end
+
+      def exist?(key)
+        instrument :exist, key: key do |payload|
+          answer = directory.files.head(path_for(key)).present?
+          payload[:exist] = answer
+          answer
+        end
+      end
+
+      private
+
+      def private_url(key, expires_in:, filename:, disposition:, content_type:, **)
+        client.get_object_https_url(
+          directory_name,
+          path_for(key),
+          Time.current + expires_in,
+          query: {
+            "response-content-disposition" => content_disposition_with(type: disposition, filename: filename),
+            "response-content-type" => content_type
+          }.compact,
+        )
+      end
+
+      def public_url(key, **)
+        client.request_url(bucket_name: directory_name, object_name: path_for(key))
+      end
+
+      def custom_metadata_headers(metadata)
+        metadata.to_h.transform_keys { |key| "x-amz-meta-#{key}" }
+      end
+
+      def path_for(key)
+        prefix ? "#{prefix}/#{key}" : key
+      end
+
+      def with_file_not_found_error
+        yield
+      rescue Excon::Error::NotFound
+        raise ActiveStorage::FileNotFoundError
+      end
+
+      # Built lazily: the service is instantiated when the app boots, and that must not need the network.
+      def client
+        @client ||= Fog::Storage.new(@fog_credentials)
+      end
+
+      def directory
+        @directory ||= client.directories.new(key: directory_name)
+      end
+    end
+  end
+end
diff --git a/lib/tasks/profile_images.rake b/lib/tasks/profile_images.rake
new file mode 100644
index 0000000..985dc5d
--- /dev/null
+++ b/lib/tasks/profile_images.rake
@@ -0,0 +1,15 @@
+namespace :profile_images do
+  desc "Copy the profile images of users and organizations from CarrierWave into Active Storage " \
+       "(also run by this release's migration; run it again until nothing fails)"
+  task copy: :environment do
+    logger = ActiveSupport::Logger.new($stdout)
+    result = ProfileImages::Copy.call(logger: logger)
+
+    if result.failed?
+      abort("#{result.count(:failed)} profile images could not be copied into Active Storage, where they are " \
+            "served from. Run `bin/rails profile_images:copy` again.")
+    end
+  rescue ProfileImages::Copy::TooManyFailures => e
+    abort("#{e.message}. Nothing was lost: check the storage, then run `bin/rails profile_images:copy` again.")
+  end
+end
diff --git a/spec/db/migrate/copy_remaining_profile_images_into_active_storage_spec.rb b/spec/db/migrate/copy_remaining_profile_images_into_active_storage_spec.rb
new file mode 100644
index 0000000..eb31c91
--- /dev/null
+++ b/spec/db/migrate/copy_remaining_profile_images_into_active_storage_spec.rb
@@ -0,0 +1,84 @@
+require "rails_helper"
+require Rails.root.join("db/migrate/20261009120000_copy_remaining_profile_images_into_active_storage.rb")
+
+# This release stops serving profile images from CarrierWave: its migration, which runs before it serves
+# anything, copies those that are left, or stops the deploy.
+RSpec.describe CopyRemainingProfileImagesIntoActiveStorage do
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:stored_uploaders) { [] }
+
+  after { stored_uploaders.each(&:remove!) }
+
+  # A profile image served from CarrierWave by the previous release, not copied by profile_images:copy.
+  def served_from_carrierwave(record)
+    record.avatar.purge
+    uploader = ProfileImageUploader.new(record, :profile_image)
+    uploader.store!(Rack::Test::UploadedFile.new(png_path, "image/png"))
+    stored_uploaders << uploader
+    record.update_column(:profile_image, uploader.identifier)
+    record.reload
+  end
+
+  def migrate
+    expect { described_class.new.migrate(:up) }.to output.to_stdout
+  end
+
+  it "copies the profile images still served from CarrierWave, so that this release serves them" do
+    user = served_from_carrierwave(create(:user))
+    organization = served_from_carrierwave(create(:organization))
+    expect(user.profile_image_url).to be_nil # not yet
+
+    migrate
+
+    [user, organization].each do |record|
+      record.reload
+      expect(record.avatar.download).to eq(File.binread(png_path))
+      expect(record.profile_image_url).to include("/rails/active_storage/")
+    end
+    expect(organization).to be_valid
+  end
+
+  it "has nothing to do when everything was copied already" do
+    create(:user)
+    served_from_carrierwave(create(:user))
+    ProfileImages::Copy.call(logger: Logger.new(nil))
+
+    expect { migrate }.not_to(change { [ActiveStorage::Blob.count, ActiveStorage::Attachment.count] })
+  end
+
+  it "stops the deploy when a profile image could not be copied" do
+    user = served_from_carrierwave(create(:user))
+    allow(ActiveStorage::Blob.service).to receive(:upload).and_raise(Excon::Error::Socket)
+
+    expect { described_class.new.migrate(:up) }
+      .to raise_error(RuntimeError, /1 profile images could not be copied/)
+      .and output(/Could not copy the profile image of User #{user.id}/).to_stdout
+    # The previous release keeps serving it from CarrierWave.
+    expect(user.reload.read_attribute(:profile_image)).to eq(stored_uploaders.last.identifier)
+    expect(File).to exist(stored_uploaders.last.path)
+  end
+
+  it "stops the deploy when the storage is unavailable" do
+    stub_const("ProfileImages::Copy::MAX_CONSECUTIVE_FAILURES", 2)
+    Array.new(2) { served_from_carrierwave(create(:user)) }
+    allow(ActiveStorage::Blob.service).to receive(:upload).and_raise(Excon::Error::Socket)
+
+    expect { described_class.new.migrate(:up) }
+      .to raise_error(ProfileImages::Copy::TooManyFailures)
+      .and output.to_stdout
+  end
+
+  it "doesn't stop the deploy for CarrierWave images whose file is gone (they showed a broken image)" do
+    user = create(:user)
+    user.avatar.purge
+    user.update_column(:profile_image, "gone.png")
+
+    migrate
+
+    expect(user.reload.avatar).not_to be_attached
+  end
+
+  it "doesn't hold a transaction (and row locks) for the whole copy" do
+    expect(described_class.disable_ddl_transaction).to be(true)
+  end
+end
