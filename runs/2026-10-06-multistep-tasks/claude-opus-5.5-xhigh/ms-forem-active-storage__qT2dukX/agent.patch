--- /dev/null
+++ b/db/migrate/20261009120000_copy_remaining_profile_images_into_active_storage.rb
@@ -0,0 +1,25 @@
+# From this release on, the profile images of users and organizations are only served from Active Storage
+# (see ProfileImageStorage). The previous release still served from CarrierWave the ones that
+# `bin/rails profile_images:copy` didn't copy (not run yet, interrupted, failures...).
+#
+# Migrations run before this release serves anything, while the previous one keeps serving: this copies
+# whatever is left, and stops the deploy if anything couldn't be copied, so that no profile image that can
+# be seen today disappears. When profile_images:copy already went through everything, there's (almost)
+# nothing left to do. Nothing is changed or deleted in CarrierWave (see ProfileImages::Copy).
+class CopyRemainingProfileImagesIntoActiveStorage < ActiveRecord::Migration[8.0]
+  # Records are copied one by one, each in its own short transaction: a single transaction around the
+  # whole copy would keep every copied row locked (users can't be updated) until the end.
+  disable_ddl_transaction!
+
+  def up
+    result = ProfileImages::Copy.call(logger: ActiveSupport::Logger.new($stdout))
+    return unless result.failed?
+
+    raise "#{result.count(:failed)} profile images could not be copied into Active Storage (see the errors " \
+          "above). The previous release keeps serving them from CarrierWave: fix the cause, then deploy again."
+  end
+
+  def down
+    # Nothing to undo: the copies don't change anything for the previous release, which prefers them.
+  end
+end
