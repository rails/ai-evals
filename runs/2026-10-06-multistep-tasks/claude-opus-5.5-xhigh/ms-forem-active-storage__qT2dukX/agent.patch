diff --git a/spec/requests/profile_image_storage_spec.rb b/spec/requests/profile_image_storage_spec.rb
new file mode 100644
index 0000000..ddce89d
--- /dev/null
+++ b/spec/requests/profile_image_storage_spec.rb
@@ -0,0 +1,88 @@
+require "rails_helper"
+
+# Profile images of users and organizations are stored in Active Storage (see ProfileImageStorage).
+RSpec.describe "Profile images stored in Active Storage" do
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:user) { create(:user) }
+
+  it "serves profile images through the app" do
+    get URI.parse(user.profile_image_url).path
+
+    expect(response).to have_http_status(:ok)
+    expect(response.media_type).to eq("image/jpeg")
+    expect(response.body.b).to eq(user.avatar.download)
+    expect(response.headers["Cache-Control"]).to include("public")
+  end
+
+  it "serves the profile images of organizations too" do
+    organization = create(:organization)
+
+    get URI.parse(organization.profile_image_url).path
+
+    expect(response).to have_http_status(:ok)
+    expect(response.body.b).to eq(Rails.root.join("app/assets/images/android-icon-36x36.png").binread)
+  end
+
+  it "does not let anyone create blobs through direct uploads" do
+    expect do
+      post "/rails/active_storage/direct_uploads", params: {
+        blob: { filename: "a.png", byte_size: 4, checksum: "abcd", content_type: "image/png" }
+      }
+    end.not_to change(ActiveStorage::Blob, :count)
+
+    expect(response).to have_http_status(:not_found)
+  end
+
+  context "when a user updates their profile image" do
+    it "stores it in Active Storage and returns its URL, where the onboarding expects it" do
+      sign_in user
+      put "/users/#{user.id}", params: { user: { profile_image: fixture_file_upload("800x600.png", "image/png") } },
+                               headers: { "Accept" => "application/json" }
+
+      expect(response).to have_http_status(:ok)
+      user.reload
+      expect(user.avatar.download).to eq(File.binread(png_path))
+      expect(response.parsed_body.dig("user", "profile_image", "url")).to eq(user.profile_image_url)
+    end
+
+    it "keeps the CarrierWave image of users who had one, like the previous release" do
+      user.avatar.purge
+      user.update_column(:profile_image, "legacy.jpg")
+      sign_in user.reload
+
+      put "/users/#{user.id}", params: { user: { profile_image: fixture_file_upload("800x600.png", "image/png") } },
+                               headers: { "Accept" => "application/json" }
+
+      expect(response).to have_http_status(:ok)
+      expect(user.reload.read_attribute(:profile_image)).to eq("legacy.jpg")
+      expect(user.profile_image_url).to eq(user.avatar_url)
+    end
+  end
+
+  it "doesn't serve profile images from CarrierWave anymore" do
+    user.avatar.purge
+    user.update_column(:profile_image, "legacy.jpg")
+
+    get "/api/profile_images/#{user.username}"
+
+    expect(response.parsed_body["profile_image"]).not_to include("/uploads/")
+    expect(response.parsed_body["profile_image"]).to include(Images::Profile::BACKUP_LINK)
+  end
+
+  it "serves profile images copied from CarrierWave from Active Storage" do
+    user.avatar.purge
+    uploader = ProfileImageUploader.new(user, :profile_image)
+    uploader.store!(Rack::Test::UploadedFile.new(png_path, "image/png"))
+    user.update_column(:profile_image, uploader.identifier)
+    ProfileImages::Copy.call(models: [User], logger: Logger.new(nil))
+
+    get "/api/profile_images/#{user.username}"
+    expect(response.parsed_body["profile_image"]).to include("/rails/active_storage/")
+
+    get URI.parse(user.reload.profile_image_url).path
+    expect(response).to have_http_status(:ok)
+    expect(response.body.b).to eq(File.binread(png_path))
+  ensure
+    uploader&.remove!
+  end
+end
