new file mode 100644
index 0000000..bbde992
--- /dev/null
+++ b/Gemfile.next
@@ -0,0 +1,14 @@
+# frozen_string_literal: true
+
+# Rails 7.0 dual-boot Gemfile for the next release.
+#
+#   BUNDLE_GEMFILE=Gemfile.next bundle install
+#   BUNDLE_GEMFILE=Gemfile.next bin/rails test
+#
+# Everything is shared with ./Gemfile; only the dependencies switched on
+# `next?` there differ. Locked in Gemfile.next.lock. See docs/UPGRADE.md.
+def next?
+  true
+end
+
+eval_gemfile File.expand_path('Gemfile', __dir__)
