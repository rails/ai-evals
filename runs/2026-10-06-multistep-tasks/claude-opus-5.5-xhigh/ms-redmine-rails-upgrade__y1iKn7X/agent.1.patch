+  # Returns the query data stored in the session under session_key.
+  #
+  # Session cookies are serialized as JSON from this release on (see
+  # docs/UPGRADE.md) and JSON turns symbol keys into strings: restore the
+  # symbol keys the data was stored with, in the session too, so that it
+  # can be updated in place. Data from Marshal serialized sessions is
+  # returned unchanged.
+  def query_session_data(session_key)
+    data = session[session_key]
+    return data unless data.is_a?(Hash) && data.keys.any?(String)
+
+    data = data.symbolize_keys
+    if data[:filters].is_a?(Hash)
+      # filter names are strings, their options use symbol keys
+      data[:filters] =
+        data[:filters].transform_values do |options|
+          options.is_a?(Hash) ? options.symbolize_keys : options
+        end
+    end
+    session[session_key] = data
+  end
+
