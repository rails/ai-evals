+
+      # Permanent application choice, not related to the upgrade: Redmine
+      # validates its associations itself (Rails 5.0 default turned off).
+      config.active_record.belongs_to_required_by_default = false
+    else
+      # Rails 6.1 (production): legacy framework defaults (no load_defaults),
+      # plus the following temporary override so that this release is a
+      # safe rollback target for Rails 7.0 on its defaults and can itself be
+      # rolled back to the previous release:
+      #
+      # Read both Marshal (previous releases) and JSON (Rails 7.0 defaults)
+      # cookies, write JSON, which the previous release reads too (its
+      # :marshal serializer falls back to JSON). Remove once the Rails 7.0
+      # release ships (its default is :json).
+      config.action_dispatch.cookies_serializer = :hybrid
+
+      # Zeitwerk is the only autoloader of Rails 7.0
+      config.autoloader = :zeitwerk
+    end
 
     # Only load the plugins named here, in the order given (default is alphabetical).
     # :all can be used as a placeholder for all plugins not explicitly named.
