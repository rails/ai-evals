index 0000000..b037f49
--- /dev/null
+++ b/test/models/keyset_page_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+
+class KeysetPageTest < ActiveSupport::TestCase
+  setup do
+    registration = AccountRegistration.new(name: "Acme", subdomain: "acme",
+      admin: { name: "Jo", email: "jo@acme.test", password: "password-123" })
+    assert registration.save
+    @account = registration.account
+    @customer = @account.users.create!(name: "Avery", email: "avery@example.test", password: "password-123", role: :customer)
+  end
+
+  def create_tickets(times)
+    times.map { |time| @account.tickets.create!(requester: @customer, subject: "Ticket", updated_at: time, created_at: time) }
+  end
+
+  # Pages through +scope+ with cursors, forward from the start, and returns
+  # the IDs page by page; then checks that going back gives the same pages.
+  def walk(scope, size:)
+    pages = []
+    page = KeysetPage.new(scope, size: size)
+    loop do
+      pages << page.records.map(&:id)
+      break unless page.has_more?
+
+      assert page.next_page?
+      page = KeysetPage.new(scope, size: size, after: page.after_cursor)
+    end
+    assert_not page.next_page?
+
+    (pages.size - 2).downto(0) do |index|
+      assert page.previous_page?
+      page = KeysetPage.new(scope, size: size, before: page.before_cursor)
+      assert_equal pages[index], page.records.map(&:id)
+      assert_equal index.positive?, page.has_more?
+      assert page.next_page?
+    end
+    assert_not page.previous_page?
+    pages
+  end
+
+  test "pages in the scope's order, forward and back, ending with has_more false" do
+    base = Time.utc(2025, 1, 1, 12)
+    # Times a microsecond apart (the same millisecond), and several identical
+    # ones, which only the ID tells apart.
+    times = [ base, base + 0.000001r, base + 0.000002r, base, base, base + 1, base - 1, base + 0.000001r ]
+    create_tickets(times)
+    expected = @account.tickets.sort_by { |t| [ t.updated_at, t.id ] }.reverse.map(&:id)
+
+    [ 1, 2, 3, 8, 9 ].each do |size|
+      assert_equal expected.each_slice(size).to_a, walk(@account.tickets.recently_active, size: size), "size #{size}"
+    end
+  end
+
+  test "pages in mixed directions" do
+    base = Time.utc(2025, 1, 1, 12)
+    create_tickets([ base, base, base + 1, base + 1, base + 0.000001r, base - 1 ])
+    scope = @account.tickets.order(updated_at: :desc, id: :asc)
+    expected = @account.tickets.sort_by { |t| [ -t.updated_at.to_r, t.id ] }.map(&:id)
+
+    [ 1, 2, 4 ].each do |size|
+      assert_equal expected.each_slice(size).to_a, walk(scope, size: size), "size #{size}"
+    end
+  end
+
+  test "an empty list has one empty page without cursors" do
+    page = KeysetPage.new(@account.tickets.recently_active, size: 25)
+    assert_equal [], page.records
+    assert_not page.has_more?
+    assert_nil page.after_cursor
+    assert_nil page.before_cursor
+    assert_not page.next_page?
+    assert_not page.previous_page?
+  end
+
+  test "pages carry on from a cursor whose record moved or was deleted meanwhile" do
+    base = Time.utc(2025, 1, 1, 12)
+    a, b, c, d = create_tickets([ base + 4, base + 3, base + 2, base + 1 ])
+    scope = @account.tickets.recently_active
+    first = KeysetPage.new(scope, size: 2)
+    assert_equal [ a.id, b.id ], first.records.map(&:id)
+
+    b.update!(updated_at: base + 10)
+    assert_equal [ c.id, d.id ], KeysetPage.new(scope, size: 2, after: first.after_cursor).records.map(&:id)
+
+    b.delete
+    assert_equal [ c.id, d.id ], KeysetPage.new(scope, size: 2, after: first.after_cursor).records.map(&:id)
+  end
+
+  test "cursors only work for lists in the same order" do
+    create_tickets([ Time.utc(2025, 1, 1) ])
+    cursor = KeysetPage.new(@account.tickets.recently_active, size: 1).after_cursor
+    assert KeysetPage.new(@account.tickets.where(status: "open").recently_active, size: 1, after: cursor)
+
+    [ @account.tickets.recently_active_in_public, @account.tickets.order(:id), @account.tickets.order(updated_at: :asc, id: :asc) ].each do |scope|
+      assert_raises(KeysetPage::InvalidCursor) { KeysetPage.new(scope, size: 1, after: cursor) }
+    end
+  end
+
+  test "forged cursors are invalid" do
+    create_tickets([ Time.current ])
+    scope = @account.tickets.recently_active
+    signature = JSON.parse(Base64.urlsafe_decode64(KeysetPage.new(scope, size: 1).after_cursor)).first
+    encode = ->(data) { Base64.urlsafe_encode64(data.is_a?(String) ? data : JSON.generate(data), padding: false) }
+
+    assert KeysetPage.new(scope, size: 1, after: encode.([ signature, "2025-01-01T00:00:00.000000Z", 1 ]))
+    [
+      "", "not a cursor!", "a", "A" * 501, 123, [ "x" ], encode.("not json"), encode.("\xFF\xFE"), encode.("{}"), encode.("[]"),
+      encode.([ signature ]), encode.([ "0123456789", "2025-01-01T00:00:00.000000Z", 1 ]),
+      encode.([ signature, "2025-01-01T00:00:00.000000Z", 1, 2 ]),
+      encode.([ signature, "2025-01-01T00:00:00Z", 1 ]), encode.([ signature, "2025-01-01T00:00:00.000Z", 1 ]),
+      encode.([ signature, "2025-13-01T00:00:00.000000Z", 1 ]), encode.([ signature, "0000-01-01T00:00:00.000000Z", 1 ]),
+      encode.([ signature, 1_735_689_600, 1 ]), encode.([ signature, "2025-01-01T00:00:00.000000Z", "1" ]),
+      encode.([ signature, "2025-01-01T00:00:00.000000Z", 1.5 ]), encode.([ signature, "2025-01-01T00:00:00.000000Z", 2**63 ]),
+      encode.([ signature, "2025-01-01T00:00:00.000000Z", nil ])
+    ].each do |cursor|
+      assert_raises(KeysetPage::InvalidCursor, cursor.inspect) { KeysetPage.new(scope, size: 1, before: cursor) }
+    end
+  end
+
+  test "lists need an order of the model's own NOT NULL datetime and integer columns, ending with the primary key" do
+    [
+      @account.tickets, @account.tickets.order(:updated_at), @account.tickets.order(:id, :updated_at),
+      @account.tickets.order(:subject, :id), @account.tickets.order(:assignee_id, :id),
+      @account.tickets.order(Arel.sql("updated_at DESC"), :id), @account.tickets.order(:id).limit(5),
+      @account.tickets.joins(:requester).order("users.id"), @account.tickets.order(Ticket.arel_table[:id].asc.nulls_last)
+    ].each do |scope|
+      assert_raises(ArgumentError, scope.to_sql) { KeysetPage.new(scope, size: 1) }
+    end
+    assert_raises(ArgumentError) { KeysetPage.new(@account.tickets.order(:id), size: 1, after: "x", before: "y") }
+    assert_raises(ArgumentError) { KeysetPage.new(@account.tickets.order(:id), size: 0) }
+  end
+end
