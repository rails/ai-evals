+++ b/test/integration/cursor_pagination_test.rb
@@ -0,0 +1,275 @@
+require "test_helper"
+
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_up_verified
+    @owner_token = sign_in
+    @customer_token = sign_in_new_customer
+  end
+
+  def follow(url, token: @owner_token)
+    assert url, "expected a link"
+    assert url.start_with?("http://www.example.com/api/v1/"), url
+    get url, headers: api_headers(token: token)
+    assert_response :ok
+    json
+  end
+
+  def query_of(url)
+    Rack::Utils.parse_nested_query(URI.parse(url).query)
+  end
+
+  # Follows the next links from the first page of +path+ to the end, then the
+  # prev links back to the start, checking that both ways give the same
+  # pages. Returns the IDs page by page.
+  def walk(path, key, size:, token: @owner_token)
+    separator = path.include?("?") ? "&" : "?"
+    api :get, "#{path}#{separator}page[size]=#{size}", token: token
+    assert_response :ok
+    assert_nil json.dig("links", "prev")
+    pages = [ json[key].pluck("id") ]
+    while json.dig("meta", "has_more")
+      follow json.dig("links", "next"), token: token
+      pages << json[key].pluck("id")
+    end
+    assert_nil json.dig("links", "next")
+
+    (pages.size - 2).downto(0) do |index|
+      follow json.dig("links", "prev"), token: token
+      assert_equal pages[index], json[key].pluck("id")
+      assert_equal index.positive?, json.dig("meta", "has_more")
+      assert json.dig("links", "next")
+    end
+    assert_nil json.dig("links", "prev")
+    pages
+  end
+
+  # All of +path+ in order, by page numbers.
+  def all_ids(path, key, token: @owner_token)
+    separator = path.include?("?") ? "&" : "?"
+    api :get, "#{path}#{separator}per_page=100", token: token
+    assert_response :ok
+    json[key].pluck("id")
+  end
+
+  def open_tickets(count)
+    count.times.map { |i| open_request(@customer_token, subject: "Request #{i}") }.reverse
+  end
+
+  test "a first page with nothing to show" do
+    api :get, "/tickets?page[size]=25&status=open", token: @owner_token
+    assert_response :ok
+    assert_equal({ "tickets" => [], "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+                   "links" => { "next" => nil, "prev" => nil } }, json)
+  end
+
+  test "pages have cursors for their first and last records and links to either side, keeping the filters" do
+    newest_first = open_tickets(5).pluck("id")
+    open_request(@customer_token, subject: "Something else")
+    Ticket.find_by!(subject: "Something else").update_columns(status: "pending", updated_at: 1.hour.from_now)
+
+    api :get, "/tickets?page[size]=2&status=open", token: @owner_token
+    assert_response :ok
+    assert_equal newest_first.first(2), json["tickets"].pluck("id")
+    assert_equal %w[links meta tickets], json.keys.sort
+    assert_equal true, json.dig("meta", "has_more")
+    assert_nil json.dig("links", "prev")
+    first_page = json
+
+    next_query = query_of(first_page.dig("links", "next"))
+    assert_equal({ "status" => "open", "page" => { "size" => "2", "after" => first_page.dig("meta", "after_cursor") } }, next_query)
+
+    # The same page, from the cursor of its last record.
+    api :get, "/tickets?status=open&page[size]=2&page[after]=#{first_page.dig("meta", "after_cursor")}", token: @owner_token
+    second_page = json
+    assert_equal newest_first[2, 2], second_page["tickets"].pluck("id")
+    assert_equal second_page, follow(first_page.dig("links", "next"))
+    assert_equal({ "status" => "open", "page" => { "size" => "2", "before" => second_page.dig("meta", "before_cursor") } },
+      query_of(second_page.dig("links", "prev")))
+
+    # Before the first record of the second page comes the first page, with
+    # nothing more before it.
+    api :get, "/tickets?status=open&page[size]=2&page[before]=#{second_page.dig("meta", "before_cursor")}", token: @owner_token
+    assert_equal newest_first.first(2), json["tickets"].pluck("id")
+    assert_equal false, json.dig("meta", "has_more")
+    assert_nil json.dig("links", "prev")
+    assert_equal first_page.dig("meta"), json["meta"].merge("has_more" => true)
+
+    follow second_page.dig("links", "next")
+    assert_equal [ newest_first.last ], json["tickets"].pluck("id")
+    assert_equal({ "has_more" => false, "after_cursor" => json.dig("meta", "before_cursor"),
+                   "before_cursor" => json.dig("meta", "after_cursor") }, json["meta"])
+    assert_nil json.dig("links", "next")
+    assert json.dig("links", "prev")
+
+    # Past the end there's nothing.
+    api :get, "/tickets?status=open&page[size]=2&page[after]=#{json.dig("meta", "after_cursor")}", token: @owner_token
+    assert_equal({ "tickets" => [], "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+                   "links" => { "next" => nil, "prev" => nil } }, json)
+
+    assert_equal newest_first.each_slice(2).to_a, walk("/tickets?status=open", "tickets", size: 2)
+  end
+
+  test "navigation stays put while other people work" do
+    a, b, c, d, e = open_tickets(5).pluck("id")
+
+    api :get, "/tickets?page[size]=2", token: @owner_token
+    assert_equal [ a, b ], json["tickets"].pluck("id")
+    next_link = json.dig("links", "next")
+    api :get, "/tickets?per_page=2", token: @owner_token
+    assert_equal [ a, b ], json["tickets"].pluck("id")
+
+    # Meanwhile a new ticket comes in, and the last ticket of the page is
+    # updated, which makes it the most recently active.
+    new = open_request(@customer_token, subject: "New")["id"]
+    api :patch, "/tickets/#{b}", { ticket: { comment: { body: "On it.", public: false } } }, token: @owner_token
+    assert_response :ok
+
+    # Page numbers shift: page 2 now repeats a ticket from page 1.
+    api :get, "/tickets?per_page=2&page=2", token: @owner_token
+    assert_equal [ a, c ], json["tickets"].pluck("id")
+
+    # Cursors carry on where the first page ended.
+    follow next_link
+    assert_equal [ c, d ], json["tickets"].pluck("id")
+    assert_equal true, json.dig("meta", "has_more")
+    third = follow(json.dig("links", "next"))
+    assert_equal [ e ], third["tickets"].pluck("id")
+
+    # Someone updates the record behind the page's cursor (moving it to the
+    # top) and others before it; going back still leads to the tickets
+    # right before, and then to the ones that came in or moved up.
+    api :patch, "/tickets/#{e}", { ticket: { priority: "high" } }, token: @owner_token
+    follow third.dig("links", "prev")
+    assert_equal [ c, d ], json["tickets"].pluck("id")
+    follow json.dig("links", "prev")
+    assert_equal [ new, a ], json["tickets"].pluck("id")
+    assert_equal true, json.dig("meta", "has_more")
+    follow json.dig("links", "prev")
+    assert_equal [ e, b ], json["tickets"].pluck("id")
+    assert_equal false, json.dig("meta", "has_more")
+    assert_nil json.dig("links", "prev")
+  end
+
+  test "records with the same activity time are neither skipped nor repeated" do
+    ids = open_tickets(5).pluck("id")
+    Ticket.where(id: ids).update_all(updated_at: Time.utc(2025, 1, 1, 12, 0, 0, 123456r))
+    Ticket.where(id: ids.values_at(1, 3)).update_all(updated_at: Time.utc(2025, 1, 1, 12, 0, 0, 123457r))
+    expected = all_ids("/tickets", "tickets")
+    # Then by ID, newest first.
+    assert_equal ids.values_at(1, 3, 0, 2, 4), expected
+
+    [ 1, 2, 3 ].each do |size|
+      assert_equal expected.each_slice(size).to_a, walk("/tickets", "tickets", size: size)
+    end
+  end
+
+  test "every list takes cursors" do
+    ticket = open_request(@customer_token)
+    3.times { |i| api :patch, "/requests/#{ticket["id"]}", { request: { comment: { body: "More #{i}" } } }, token: @customer_token }
+    api :patch, "/tickets/#{ticket["id"]}", { ticket: { comment: { body: "Note", public: false } } }, token: @owner_token
+    open_tickets(2)
+    agent_token = sign_in_invited(@owner_token)
+    agent = User.find_by!(email: "sam@example.test")
+    owner = User.find_by!(email: "jo@acme.test")
+    2.times { |i| invite(@owner_token, email: "invitee#{i}@example.test") }
+    groups = 3.times.map do |i|
+      api :post, "/groups", { group: { name: "Group #{i}" } }, token: @owner_token
+      json.dig("group", "id")
+    end
+    groups.each do |group|
+      [ owner, agent ].each do |user|
+        api :post, "/group_memberships", { group_membership: { group_id: group, user_id: user.id } }, token: @owner_token
+        assert_response :created
+      end
+    end
+
+    {
+      [ "/tickets", "tickets", @owner_token ] => 3,
+      [ "/tickets/#{ticket["id"]}/comments", "comments", agent_token ] => 5,
+      [ "/requests", "requests", @customer_token ] => 3,
+      [ "/requests/#{ticket["id"]}/comments", "comments", @customer_token ] => 4,
+      [ "/staff", "staff", agent_token ] => 2,
+      [ "/groups", "groups", agent_token ] => 3,
+      [ "/group_memberships", "group_memberships", agent_token ] => 6,
+      [ "/group_memberships?user_id=#{agent.id}", "group_memberships", agent_token ] => 3,
+      [ "/users", "users", @owner_token ] => 3,
+      [ "/users?role=staff", "users", @owner_token ] => 2,
+      [ "/invitations", "invitations", @owner_token ] => 3
+    }.each do |(path, key, token), count|
+      expected = all_ids(path, key, token: token)
+      assert_equal count, expected.size, path
+      [ 1, 2 ].each do |size|
+        assert_equal expected.each_slice(size).to_a, walk(path, key, size: size, token: token), "#{path} by #{size}"
+      end
+    end
+  end
+
+  test "a page carries on after its last record was deleted" do
+    groups = 4.times.map do |i|
+      api :post, "/groups", { group: { name: "Group #{i}" } }, token: @owner_token
+      json.dig("group", "id")
+    end
+    api :get, "/groups?page[size]=2", token: @owner_token
+    next_link = json.dig("links", "next")
+
+    api :delete, "/groups/#{groups[1]}", token: @owner_token
+    assert_response :no_content
+    follow next_link
+    assert_equal groups.last(2), json["groups"].pluck("id")
+    assert_equal false, json.dig("meta", "has_more")
+    follow json.dig("links", "prev")
+    assert_equal [ groups[0] ], json["groups"].pluck("id")
+  end
+
+  test "sizes default to 25 and are capped at 100; empty cursors are the start of the list" do
+    ids = open_tickets(4).pluck("id")
+    api :get, "/tickets?page[size]=1", token: @owner_token
+    first_cursor = json.dig("meta", "after_cursor")
+    { "" => 25, "nope" => 25, "0" => 25, "-1" => 25, "1.5" => 25, "2" => 2, "1000" => 100 }.each do |size, used|
+      api :get, "/tickets?page[size]=#{size}&page[after]=", token: @owner_token
+      assert_response :ok
+      assert_equal ids.first(used), json["tickets"].pluck("id")
+
+      # Links carry the size that was used.
+      api :get, "/tickets?page[after]=#{first_cursor}&page[size]=#{size}", token: @owner_token
+      assert_equal ids.drop(1).first(used), json["tickets"].pluck("id")
+      assert_equal({ "size" => used.to_s, "before" => json.dig("meta", "before_cursor") }, query_of(json.dig("links", "prev"))["page"])
+    end
+
+    # Cursors without a size use the default; per_page is for page numbers.
+    api :get, "/tickets?page[after]=&per_page=1", token: @owner_token
+    assert_equal ids, json["tickets"].pluck("id")
+  end
+
+  test "cursors this list didn't make, or both directions at once, are rejected" do
+    open_tickets(2)
+    api :get, "/tickets?page[size]=1", token: @owner_token
+    ticket_cursor = json.dig("meta", "after_cursor")
+    api :get, "/users?page[size]=1", token: @owner_token
+    user_cursor = json.dig("meta", "after_cursor")
+
+    [ "/tickets?page[after]=nope", "/tickets?page[after][]=x", "/tickets?page[after]=#{user_cursor}",
+      "/users?page[after]=#{ticket_cursor}", "/requests?page[after]=#{ticket_cursor}" ].each do |path|
+      api :get, path, token: path.start_with?("/requests") ? @customer_token : @owner_token
+      assert_response :unprocessable_content
+      assert_equal "validation_failed", json.dig("error", "code")
+      assert_equal({ "page[after]" => [ "is not a valid cursor" ] }, json.dig("error", "details"), path)
+    end
+
+    api :get, "/tickets?page[before]=%00", token: @owner_token
+    assert_response :unprocessable_content
+    assert_equal({ "page[before]" => [ "is not a valid cursor" ] }, json.dig("error", "details"))
+
+    api :get, "/tickets?page[after]=#{ticket_cursor}&page[before]=#{ticket_cursor}", token: @owner_token
+    assert_response :unprocessable_content
+    assert_equal({ "page" => [ "can't have both after and before" ] }, json.dig("error", "details"))
+  end
+
+  test "lists without cursor parameters keep their page numbers" do
+    ids = open_tickets(3).pluck("id")
+    api :get, "/tickets?per_page=2&page=2", token: @owner_token
+    assert_equal({ "tickets" => [ ids.last ], "count" => 3, "page" => 2, "per_page" => 2, "next_page" => nil, "previous_page" => 1 },
+      json.merge("tickets" => json["tickets"].pluck("id")))
+  end
+end
diff --git a/test/models/keyset_page_test.rb b/test/models/keyset_page_test.rb
