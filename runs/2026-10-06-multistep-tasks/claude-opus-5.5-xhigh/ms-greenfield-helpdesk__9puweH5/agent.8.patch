@@ -0,0 +1,13 @@
+class AddAccountAndIdIndexToUsers < ActiveRecord::Migration[8.1]
+  # Built without locking the table, which can be large (every customer of
+  # every business).
+  disable_ddl_transaction!
+
+  # GET /users lists a business's users by ID. With cursor pagination, this
+  # lets every page start right at its cursor, so pages deep into a business
+  # with many customers cost the same as the first. (Role filters use
+  # index_users_on_account_id_and_role_and_id.)
+  def change
+    add_index :users, [ :account_id, :id ], algorithm: :concurrently, if_not_exists: true
+  end
+end
