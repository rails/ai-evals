diff --git a/config/database.yml b/config/database.yml
new file mode 100644
index 0000000..81b8364
--- /dev/null
+++ b/config/database.yml
@@ -0,0 +1,43 @@
+# PostgreSQL. The connection is configured through DATABASE_URL.
+#
+# development / production: DATABASE_URL is used as-is (Rails merges it into the
+# settings below).
+#
+# test: the test suite wipes its database, so it never runs against
+# DATABASE_URL directly. It uses TEST_DATABASE_URL when set, otherwise the same
+# server as DATABASE_URL with the database name suffixed with "_test"
+# (e.g. helpdesk_development -> helpdesk_test).
+<%
+  test_database_url = ENV["TEST_DATABASE_URL"].to_s.strip
+  if test_database_url.empty? && !ENV["DATABASE_URL"].to_s.strip.empty?
+    require "uri"
+    uri = URI.parse(ENV["DATABASE_URL"].strip)
+    name = uri.path.to_s.delete_prefix("/")
+    name = "helpdesk" if name.empty?
+    name = "#{name.delete_suffix("_development")}_test" unless name.end_with?("_test")
+    uri.path = "/#{name}"
+    test_database_url = uri.to_s
+  end
+%>
+default: &default
+  adapter: postgresql
+  encoding: unicode
+  # For details on connection pooling, see Rails configuration guide
+  # https://guides.rubyonrails.org/configuring.html#database-pooling
+  max_connections: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>
+
+development:
+  <<: *default
+  database: helpdesk_development
+
+test:
+  <<: *default
+<% if test_database_url.empty? %>
+  database: helpdesk_test
+<% else %>
+  url: <%= test_database_url.inspect %>
+<% end %>
+
+production:
+  <<: *default
+  database: helpdesk_production
