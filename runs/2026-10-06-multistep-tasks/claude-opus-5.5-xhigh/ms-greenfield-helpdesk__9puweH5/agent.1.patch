+    @url = Helpdesk::Settings.frontend_link("/reset-password", account: @account.subdomain, token: params[:token])
+    @expires_in = UserToken::LIFETIMES.fetch("password_reset")
+    mail to: email_address_with_name(@user.email, @user.name),
+      subject: "Reset your #{@account.name} password"
