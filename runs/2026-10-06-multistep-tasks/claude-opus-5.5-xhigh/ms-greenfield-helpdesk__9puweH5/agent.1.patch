+++ b/app/models/secret_token.rb
@@ -0,0 +1,13 @@
+# Random bearer/email tokens. Only digests are ever persisted, so a database
+# leak does not expose usable tokens.
+module SecretToken
+  module_function
+
+  def generate
+    SecureRandom.urlsafe_base64(32)
+  end
+
+  def digest(token)
+    OpenSSL::Digest::SHA256.hexdigest(token.to_s)
+  end
+end
diff --git a/app/models/session.rb b/app/models/session.rb
new file mode 100644
index 0000000..0e654fc
--- /dev/null
+++ b/app/models/session.rb
@@ -0,0 +1,30 @@
+# A signed-in API session, identified by an opaque bearer token.
+class Session < ApplicationRecord
+  LIFETIME = 30.days
+
+  belongs_to :user
+
+  scope :unexpired, ->(now = Time.current) { where(expires_at: now..) }
+
+  # The plain-text token. Only available on the instance returned by start!.
+  attr_reader :token
+
+  def self.start!(user:, ip_address: nil, user_agent: nil)
+    token = SecretToken.generate
+    session = create!(
+      user: user,
+      token_digest: SecretToken.digest(token),
+      expires_at: LIFETIME.from_now,
+      ip_address: ip_address,
+      user_agent: user_agent.to_s.first(500).presence
+    )
+    session.instance_variable_set(:@token, token)
+    session
+  end
+
+  def self.authenticate(token)
+    return nil if token.blank?
+
+    unexpired.includes(user: :account).find_by(token_digest: SecretToken.digest(token))
+  end
+end
