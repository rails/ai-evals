diff --git a/test/integration/account_lifecycle_test.rb b/test/integration/account_lifecycle_test.rb
new file mode 100644
index 0000000..6e610d1
--- /dev/null
+++ b/test/integration/account_lifecycle_test.rb
@@ -0,0 +1,127 @@
+require "test_helper"
+
+class AccountLifecycleTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_up_verified
+    @owner_token = sign_in
+  end
+
+  test "the portal is public" do
+    api :get, "/portal"
+
+    assert_response :ok
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json)
+  end
+
+  test "signed-in users see the full account" do
+    api :get, "/account"
+    assert_response :unauthorized
+
+    api :get, "/account", token: @owner_token
+    assert_response :ok
+    assert_equal %w[cancelled_at created_at id name owner_id reactivatable_until status subdomain updated_at],
+      json["account"].keys.sort
+  end
+
+  test "cancelling revokes sessions and stops ordinary access" do
+    create_user(email: "agent@acme.test")
+    agent_token = sign_in(email: "agent@acme.test")
+
+    api :post, "/account/cancel", token: @owner_token
+
+    assert_response :ok
+    assert_equal "cancelled", json.dig("account", "status")
+    assert json.dig("account", "cancelled_at").present?
+    assert_equal (Time.zone.parse(json.dig("account", "cancelled_at")) + 90.days).iso8601,
+      Time.zone.parse(json.dig("account", "reactivatable_until")).iso8601
+
+    [ @owner_token, agent_token ].each do |token|
+      api :get, "/me", token: token
+      assert_response :unauthorized
+    end
+
+    api :get, "/portal"
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    api :post, "/sessions", { session: { email: "agent@acme.test", password: PASSWORD } }
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    api :post, "/password_resets", { password_reset: { email: "agent@acme.test" } }
+    assert_response :accepted
+    assert_no_match(/agent@acme/, ActionMailer::Base.deliveries.flat_map(&:to).join(","))
+  end
+
+  test "the owner can sign in to a cancelled account and reactivate it" do
+    api :post, "/account/cancel", token: @owner_token
+
+    token = sign_in
+    api :get, "/account", token: token
+    assert_response :ok
+    assert_equal "cancelled", json.dig("account", "status")
+
+    api :post, "/account/reactivate", token: token
+    assert_response :ok
+    assert_equal "active", json.dig("account", "status")
+    assert_nil json.dig("account", "cancelled_at")
+
+    api :get, "/portal"
+    assert_response :ok
+    assert sign_in.present?
+  end
+
+  test "an owner who forgot their password can still reset it after cancelling" do
+    api :post, "/account/cancel", token: @owner_token
+
+    api :post, "/password_resets", { password_reset: { email: "jo@acme.test" } }
+    api :post, "/password_resets/confirm",
+      { password_reset: { token: emailed_token("reset-password"), password: "my-new-password" } }
+
+    assert_response :ok
+    assert sign_in(password: "my-new-password").present?
+  end
+
+  test "reactivation is only possible within 90 days" do
+    api :post, "/account/cancel", token: @owner_token
+
+    travel 90.days + 1.minute do
+      api :post, "/account/reactivate", token: sign_in
+      assert_response :unprocessable_content
+      assert_equal "reactivation_period_expired", json.dig("error", "code")
+    end
+  end
+
+  test "cancelling twice or reactivating an active account is rejected" do
+    api :post, "/account/reactivate", token: @owner_token
+    assert_response :unprocessable_content
+    assert_equal "account_not_cancelled", json.dig("error", "code")
+
+    api :post, "/account/cancel", token: @owner_token
+    api :post, "/account/cancel", token: sign_in
+    assert_response :unprocessable_content
+    assert_equal "account_already_cancelled", json.dig("error", "code")
+  end
+
+  test "only the owner can cancel" do
+    create_user(email: "other-admin@acme.test", role: :admin)
+
+    api :post, "/account/cancel", token: sign_in(email: "other-admin@acme.test")
+
+    assert_response :forbidden
+    assert_equal "forbidden", json.dig("error", "code")
+    assert Account.find_by!(subdomain: "acme").active?
+  end
+
+  test "cancelling one business doesn't affect another" do
+    sign_up_verified(subdomain: "globex", name: "Globex")
+    globex_token = sign_in(account: "globex")
+
+    api :post, "/account/cancel", token: @owner_token
+
+    api :get, "/me", account: "globex", token: globex_token
+    assert_response :ok
+    api :get, "/portal", account: "globex"
+    assert_response :ok
+  end
+end
diff --git a/test/integration/cors_test.rb b/test/integration/cors_test.rb
new file mode 100644
index 0000000..eb3260d
--- /dev/null
+++ b/test/integration/cors_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class CorsTest < ActionDispatch::IntegrationTest
+  def preflight(origin)
+    process :options, "/api/v1/sessions", headers: {
+      "Origin" => origin,
+      "Access-Control-Request-Method" => "POST",
+      "Access-Control-Request-Headers" => "content-type, authorization, x-helpdesk-account"
+    }
+  end
+
+  test "answers preflight requests from the frontend" do
+    preflight("http://localhost:3001")
+
+    assert_response :no_content
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    assert_includes response.headers["Access-Control-Allow-Methods"], "PATCH"
+    allowed_headers = response.headers["Access-Control-Allow-Headers"].downcase
+    %w[authorization content-type x-helpdesk-account].each { |header| assert_includes allowed_headers, header }
+  end
+
+  test "allows the frontend origin on regular requests" do
+    sign_up
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme", "Origin" => "http://localhost:3001" }
+
+    assert_response :ok
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    assert_includes response.headers["Vary"], "Origin"
+  end
+
+  test "does not allow other origins" do
+    preflight("https://evil.example")
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+
+    get "/up", headers: { "Origin" => "https://evil.example" }
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+  end
+
+  test "follows HELPDESK_FRONTEND_URL" do
+    with_env("HELPDESK_FRONTEND_URL" => "https://app.helpdesk.example/") do
+      preflight("https://app.helpdesk.example")
+      assert_equal "https://app.helpdesk.example", response.headers["Access-Control-Allow-Origin"]
+
+      preflight("http://localhost:3001")
+      assert_nil response.headers["Access-Control-Allow-Origin"]
+    end
+  end
+end
