+++ b/app/controllers/api/v1/requests_controller.rb
@@ -0,0 +1,61 @@
+module Api
+  module V1
+    # The customer's side of the portal: the requests they've opened.
+    # Staff work with the same records through /tickets.
+    class RequestsController < BaseController
+      before_action :require_customer!
+      before_action :set_ticket, only: [ :show, :update, :comments ]
+
+      # GET /api/v1/requests
+      def index
+        render_page own_requests.recently_active, :requests, RequestSerializer
+      end
+
+      # GET /api/v1/requests/:id
+      def show
+        render json: { request: RequestSerializer.call(@ticket) }
+      end
+
+      # POST /api/v1/requests
+      def create
+        attributes = params.expect(request: [ :subject, { comment: [ :body ] } ])
+        submission = RequestSubmission.new(requester: Current.user,
+          subject: attributes[:subject], comment: attributes[:comment])
+
+        if submission.save
+          render json: { request: RequestSerializer.call(submission.ticket) }, status: :created
+        else
+          render_validation_errors(submission.errors)
+        end
+      end
+
+      # PATCH /api/v1/requests/:id - reply and/or mark the request solved.
+      def update
+        attributes = params.expect(request: [ :status, { comment: [ :body ] } ])
+        raise ActionController::ParameterMissing, :request if attributes[:status].nil? && attributes[:comment].nil?
+
+        update = TicketUpdate.new(@ticket, author: Current.user, status: attributes[:status], comment: attributes[:comment])
+        if update.save
+          render json: { request: RequestSerializer.call(update.ticket) }
+        else
+          render_validation_errors(update.errors)
+        end
+      end
+
+      # GET /api/v1/requests/:id/comments - the public conversation, oldest first.
+      def comments
+        render_page @ticket.comments.publicly_visible.oldest_first.includes(:author), :comments, CommentSerializer
+      end
+
+      private
+        def own_requests
+          Current.account.tickets.where(requester: Current.user)
+        end
+
+        # Other people's requests are reported as not found.
+        def set_ticket
+          @ticket = own_requests.find_by(id: params[:id]) or render_not_found(:request)
+        end
+    end
+  end
+end
