diff --git a/test/models/concurrency_test.rb b/test/models/concurrency_test.rb
index f88d60c..59ce357 100644
--- a/test/models/concurrency_test.rb
+++ b/test/models/concurrency_test.rb
@@ -310,4 +310,157 @@ class ConcurrencyTest < ActiveSupport::TestCase
     assert_kind_of ActiveRecord::RecordNotFound, result
     assert_equal [ sales.id ], GroupMembership.where(user: @agent, default: true).ids
   end
+
+  # Merging: tickets of one customer.
+  def open_tickets(*subjects, channel: "portal")
+    @customer ||= @account.users.find_by(email: "avery@example.test") || add_user("avery@example.test", role: :customer)
+    subjects.map do |subject|
+      submission = RequestSubmission.new(requester: @customer, subject: subject, comment: { body: "Please." }, channel: channel)
+      assert submission.save
+      submission.ticket
+    end
+  end
+
+  def merge(source, target)
+    -> { TicketMerge.new(Ticket.find(source.id), author: @owner, target_id: target.id) }
+  end
+
+  def merge!(source, target)
+    -> { merge(source, target).call.tap(&:save) }
+  end
+
+  def merged_into(ticket)
+    ticket.reload.values_at(:status, :merged_into_id)
+  end
+
+  test "merging a ticket into two others at the same time merges it once" do
+    duplicate, first_target, second_target = open_tickets("Duplicate", "First", "Second")
+
+    first, second = race(merge!(duplicate, first_target), merge!(duplicate, second_target))
+
+    assert first.errors.empty?
+    assert_kind_of Ticket::Closed, second
+    assert_equal [ "closed", first_target.id ], merged_into(duplicate)
+    assert_equal [ 2, 2, 1 ], [ duplicate, first_target, second_target ].map { |ticket| ticket.comments.count }
+  end
+
+  test "merging two tickets into each other at the same time merges one of them" do
+    a, b = open_tickets("A", "B")
+
+    # Whichever ticket goes first, the other merge finds its target closed.
+    [ [ a, b ], [ b, a ] ].each do |source, target|
+      first, second = race(merge!(source, target), merge!(target, source))
+
+      assert first.errors.empty?
+      assert_equal({ "target_id" => [ "is closed" ] }, second.errors)
+      assert_equal [ "closed", target.id ], merged_into(source)
+      assert_equal [ "open", nil ], merged_into(target)
+
+      Ticket.where(id: source.id).update_all(status: "open", merged_into_id: nil)
+    end
+  end
+
+  test "merging into a ticket while it's being merged elsewhere" do
+    a, b, c = open_tickets("A", "B", "C")
+
+    first, second = race(merge!(b, c), merge!(a, b))
+
+    assert first.errors.empty?
+    assert_equal({ "target_id" => [ "is closed" ] }, second.errors)
+    assert_equal [ [ "open", nil ], [ "closed", c.id ], [ "open", nil ] ], [ a, b, c ].map { |ticket| merged_into(ticket) }
+  end
+
+  test "updating a ticket while it's being merged" do
+    duplicate, target = open_tickets("Duplicate", "Target")
+    reply = -> { TicketUpdate.new(Ticket.find(duplicate.id), author: @owner, comment: { body: "Hi" }, status: "pending").save }
+
+    _, updated = race(merge!(duplicate, target), reply)
+    assert_kind_of Ticket::Closed, updated
+    assert_equal [ "closed", target.id ], merged_into(duplicate)
+    assert_equal 2, duplicate.comments.count
+
+    # The other way round, the update gets in first and the merge closes the ticket after it.
+    other = open_tickets("Other").first
+    reply_to_other = -> { TicketUpdate.new(Ticket.find(other.id), author: @owner, comment: { body: "Hi" }, status: "pending").save }
+    updated, merging = race(reply_to_other, merge!(other, target))
+    assert updated
+    assert merging.errors.empty?
+    assert_equal [ "closed", target.id ], merged_into(other)
+    assert_equal 3, other.comments.count
+  end
+
+  test "an emailed reply to a ticket while it's being merged is ignored" do
+    duplicate, target = open_tickets("Duplicate", "Target", channel: "email")
+    source = Mail.new(from: "avery@example.test", to: duplicate.reply_address, subject: "Re: Duplicate",
+      body: "Hello?", message_id: "<late@mail.example.test>").to_s
+    inbound = received_email(source)
+
+    race(merge!(duplicate, target), -> { inbound.route })
+
+    assert_equal "bounced", inbound.reload.status
+    assert_equal [ "Please.", "Please." ], [ duplicate, target ].map { |ticket| ticket.comments.oldest_first.first.body }
+    assert_equal [ 2, 2 ], [ duplicate.comments.count, target.comments.count ]
+    assert_not TicketComment.exists?(email_message_id: "late@mail.example.test")
+  end
+
+  test "deleting a group while two of its tickets are being merged" do
+    setup_groups
+    duplicate, target = open_tickets("Duplicate", "Target")
+    duplicate.update!(group: @billing)
+    target.update!(group: @billing, assignee: @agent)
+
+    merging, deleted = race(merge!(duplicate, target), -> { Group.find(@billing.id).destroy! })
+    assert merging.errors.empty?
+    assert_kind_of Group, deleted
+    assert_equal [ [ nil, nil ], [ nil, nil ] ], [ duplicate, target ].map { |ticket| ticket.reload.values_at(:group_id, :assignee_id) }
+    assert_equal [ "closed", target.id ], merged_into(duplicate)
+
+    other, = open_tickets("Other")
+    other.update!(group: @support)
+    target.update!(group: @support, assignee: @agent)
+    deleted, merging = race(-> { Group.find(@support.id).destroy! }, merge!(other, target))
+    assert_kind_of Group, deleted
+    assert merging.errors.empty?
+    assert_equal [ [ nil, nil ], [ nil, nil ] ], [ other, target ].map { |ticket| ticket.reload.values_at(:group_id, :assignee_id) }
+    assert_equal [ "closed", target.id ], merged_into(other)
+  end
+
+  test "a group deletion part of the way through its tickets while two of them are being merged" do
+    setup_groups
+    duplicate, target = open_tickets("Duplicate", "Target")
+    [ duplicate, target ].each { |ticket| ticket.update!(group: @billing) }
+    # The deletion has locked the group and released the target; it then
+    # releases the duplicate. The merge locks tickets in ID order, duplicate
+    # first: it has to wait for the group rather than take the duplicate and
+    # wait for the target, or neither could finish.
+    release = ->(ticket) { Ticket.where(id: ticket.id).update_all(group_id: nil, assignee_id: nil, updated_at: Time.current) }
+    start_deleting = -> { Group.where(id: @billing.id).lock("FOR NO KEY UPDATE").ids && release.(target) }
+    finish_deleting = -> { release.(duplicate) && Group.where(id: @billing.id).delete_all }
+
+    deleted, merging = race(start_deleting, merge!(duplicate, target), and_then: finish_deleting)
+
+    assert_equal 1, deleted
+    assert merging.errors.empty?
+    assert_equal [ "closed", target.id ], merged_into(duplicate)
+    assert_equal [ nil, nil ], [ duplicate, target ].map { |ticket| ticket.reload.group_id }
+  end
+
+  test "suspending the assignee of tickets while they're being merged" do
+    agent = add_user("sam@acme.test", role: :agent)
+    duplicate, target = open_tickets("Duplicate", "Target")
+    [ duplicate, target ].each { |ticket| ticket.update!(assignee: agent) }
+
+    merging, = race(merge!(duplicate, target), -> { User.find(agent.id).suspend! })
+    assert merging.errors.empty?
+    assert_equal [ nil, nil ], [ duplicate, target ].map { |ticket| ticket.reload.assignee_id }
+    assert_equal [ "closed", target.id ], merged_into(duplicate)
+
+    agent.reinstate!
+    other, = open_tickets("Other")
+    [ other, target ].each { |ticket| ticket.update!(assignee: agent) }
+    _, merging = race(-> { User.find(agent.id).suspend! }, merge!(other, target))
+    assert merging.errors.empty?
+    assert_equal [ nil, nil ], [ other, target ].map { |ticket| ticket.reload.assignee_id }
+    assert_equal [ "closed", target.id ], merged_into(other)
+  end
 end
