index 0000000..087e85f
--- /dev/null
+++ b/app/controllers/concerns/account_scoped.rb
@@ -0,0 +1,45 @@
+# Chooses the business (account) a request is about from the
+# X-Helpdesk-Account header, which carries the account's subdomain.
+module AccountScoped
+  extend ActiveSupport::Concern
+
+  ACCOUNT_HEADER = "X-Helpdesk-Account".freeze
+
+  included do
+    before_action :set_current_account
+  end
+
+  private
+    def requested_subdomain
+      request.headers[ACCOUNT_HEADER].to_s.strip.downcase.presence
+    end
+
+    # The header is optional here; when present it must name an account.
+    def set_current_account
+      subdomain = requested_subdomain or return
+
+      if (account = Account.find_by_subdomain(subdomain))
+        Current.account = account
+      else
+        render_error :not_found, "account_not_found", "There is no account with the subdomain #{subdomain.inspect}."
+      end
+    end
+
+    # For endpoints that can't work without knowing the business.
+    def require_account!
+      return if Current.account
+
+      render_error :bad_request, "account_required",
+        "Choose an account by sending its subdomain in the #{ACCOUNT_HEADER} header."
+    end
+
+    # Ordinary business access stops once an account is cancelled.
+    def require_active_account!
+      render_account_cancelled if Current.account&.cancelled?
+    end
+
+    def render_account_cancelled(_error = nil)
+      render_error :forbidden, "account_cancelled",
+        "This account has been cancelled. Only its owner can sign in to reactivate it."
+    end
+end
diff --git a/app/controllers/concerns/authentication.rb b/app/controllers/concerns/authentication.rb
new file mode 100644
index 0000000..9fc4343
--- /dev/null
+++ b/app/controllers/concerns/authentication.rb
@@ -0,0 +1,39 @@
+# Bearer-token authentication: "Authorization: Bearer TOKEN".
+module Authentication
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :authenticate!
+  end
+
+  class_methods do
+    def allow_unauthenticated_access(**options)
+      skip_before_action :authenticate!, **options
+    end
+  end
+
+  private
+    def authenticate!
+      session = Session.authenticate(bearer_token)
+      return render_unauthorized unless session
+
+      user = session.user
+      return render_unauthorized if user.suspended?
+      # A token only works for the business it was issued by. The account
+      # header is optional for signed-in requests, but must match if sent.
+      return render_unauthorized if Current.account && Current.account.id != user.account_id
+
+      Current.session = session
+      Current.account = user.account
+      render_account_cancelled unless user.account_accessible?
+    end
+
+    def bearer_token
+      request.authorization.to_s[/\ABearer\s+(\S+)\s*\z/i, 1]
+    end
+
+    def render_unauthorized
+      response.headers["WWW-Authenticate"] = %(Bearer realm="Helpdesk")
+      render_error :unauthorized, "unauthorized", "Sign in to continue: the session token is missing, invalid or expired."
+    end
+end
diff --git a/app/controllers/concerns/pagination.rb b/app/controllers/concerns/pagination.rb
new file mode 100644
index 0000000..26e1989
--- /dev/null
+++ b/app/controllers/concerns/pagination.rb
@@ -0,0 +1,113 @@
+# Pagination for lists, by page number or by cursor. Every list rendered with
+# render_page takes both.
+#
+# Page numbers: ?page=2&per_page=50
+#
+#   {"tickets": [...], "count": 60, "page": 2, "per_page": 25, "next_page": 3, "previous_page": 1}
+#
+# Cursors: ?page[size]=25, then ?page[size]=25&page[after]=CURSOR (or
+# page[before]), usually by following links.next / links.prev:
+#
+#   {"tickets": [...], "meta": {"has_more": true, "after_cursor": "...", "before_cursor": "..."},
+#    "links": {"next": "https://.../tickets?page%5Bafter%5D=...&page%5Bsize%5D=25", "prev": null}}
+#
+# The links keep the request's filters.
+#
+# Cursor pages cost the same however deep into the list they are, and stay
+# put while the list changes (see KeysetPage); they don't count the records.
+#
+# Missing or invalid sizes and page numbers fall back to the defaults, and
+# sizes are capped. Cursors that the list didn't make are a 422.
+module Pagination
+  DEFAULT_PER_PAGE = 25
+  MAX_PER_PAGE = 100
+  CURSOR_DIRECTIONS = %i[after before].freeze
+
+  private
+    # Renders one page of +scope+ under +key+, mapping each record through
+    # +serializer+. The scope's order is the list's order; for cursors it has
+    # to end with the primary key (see KeysetPage).
+    def render_page(scope, key, serializer)
+      if cursor_page_requested?
+        render_cursor_page(scope, key, serializer)
+      else
+        render_numbered_page(scope, key, serializer)
+      end
+    end
+
+    # page[size], page[after] or page[before] ask for cursor pagination;
+    # ?page=2 (or no page at all) for page numbers.
+    def cursor_page_requested?
+      params[:page].is_a?(ActionController::Parameters)
+    end
+
+    def render_numbered_page(scope, key, serializer)
+      page = positive_integer(params[:page]) || 1
+      per_page = page_size(params[:per_page])
+      count = scope.count
+      offset = (page - 1) * per_page
+      # Past the end there's nothing to fetch (and a huge offset could overflow).
+      records = offset < count ? scope.limit(per_page).offset(offset).to_a : []
+
+      render json: {
+        key => records.map { |record| serializer.call(record) },
+        count: count,
+        page: page,
+        per_page: per_page,
+        next_page: (page + 1 if offset + per_page < count),
+        previous_page: (page - 1 if page > 1)
+      }
+    end
+
+    # +has_more+ is about the direction of browsing: whether there are more
+    # records after the page (first page, page[after]) or before it
+    # (page[before]). The links lead to the pages on either side, if there
+    # are any; an empty page has neither cursors nor links.
+    def render_cursor_page(scope, key, serializer)
+      size = page_size(params[:page][:size])
+      cursors = CURSOR_DIRECTIONS.index_with { |direction| params[:page][direction] }
+        .reject { |_direction, cursor| cursor.nil? || cursor == "" }
+      if cursors.size > 1
+        return render_error :unprocessable_content, "validation_failed", "Send page[after] or page[before], not both.",
+          details: { "page" => [ "can't have both after and before" ] }
+      end
+
+      page = begin
+        KeysetPage.new(scope, size: size, **cursors)
+      rescue KeysetPage::InvalidCursor
+        direction = cursors.keys.first
+        return render_error :unprocessable_content, "validation_failed",
+          "page[#{direction}] is not a valid cursor for this list. Start again from the first page.",
+          details: { "page[#{direction}]" => [ "is not a valid cursor" ] }
+      end
+
+      after_cursor = page.after_cursor
+      before_cursor = page.before_cursor
+      render json: {
+        key => page.records.map { |record| serializer.call(record) },
+        meta: { has_more: page.has_more?, after_cursor: after_cursor, before_cursor: before_cursor },
+        links: {
+          next: (cursor_page_url(size, after: after_cursor) if page.next_page?),
+          prev: (cursor_page_url(size, before: before_cursor) if page.previous_page?)
+        }
+      }
+    end
+
+    # The URL of this list with the same filters, at +cursor+ (after: or before:).
+    def cursor_page_url(size, **cursor)
+      query = request.query_parameters.except("page", "per_page")
+        .merge("page" => { "size" => size }.merge(cursor.stringify_keys))
+      "#{request.base_url}#{request.path}?#{query.to_query}"
+    end
+
+    def page_size(value)
+      [ positive_integer(value) || DEFAULT_PER_PAGE, MAX_PER_PAGE ].min
+    end
+
+    def positive_integer(value)
+      return nil unless value.is_a?(String) && value.strip.match?(/\A\d+\z/)
+
+      number = value.to_i
+      number if number.positive?
+    end
+end
