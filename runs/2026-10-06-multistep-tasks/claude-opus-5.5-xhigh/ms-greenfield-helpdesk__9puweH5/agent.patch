+namespace :helpdesk do
+  desc "Permanently delete accounts (and all their data) that have been cancelled for more than 90 days"
+  task purge_cancelled_accounts: :environment do
+    count = Account.purge_cancelled!
+    puts "Purged #{count} cancelled #{count == 1 ? "account" : "accounts"}."
+  end
+
+  desc "Process received emails whose processing was interrupted (for example by a restart)"
+  task process_inbound_emails: :environment do
+    count = InboundEmailMaintenance.process_stuck!
+    puts "Processed #{count} #{count == 1 ? "email" : "emails"}."
+  end
+
+  desc "Permanently delete received emails 30 days after they were processed"
+  task incinerate_inbound_emails: :environment do
+    count = InboundEmailMaintenance.incinerate!
+    puts "Deleted #{count} #{count == 1 ? "email" : "emails"}."
+  end
+end
