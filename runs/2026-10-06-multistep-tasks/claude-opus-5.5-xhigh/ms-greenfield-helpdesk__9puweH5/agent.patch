diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
new file mode 100644
index 0000000..eee02e4
--- /dev/null
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,95 @@
+module Api
+  module V1
+    # The staff side: every ticket of the business.
+    class TicketsController < BaseController
+      before_action :require_staff!
+      before_action :set_ticket, only: [ :show, :update, :comments, :merge ]
+
+      # GET /api/v1/tickets?status=open&group_id=20&assignee_id=unassigned&priority=high&q=receipt
+      # Filters combine; each one is optional. status=closed finds merged tickets.
+      def index
+        render_page filtered_tickets.recently_active.includes(:requester, :assignee, :group), :tickets, TicketSerializer
+      end
+
+      # GET /api/v1/tickets/:id
+      def show
+        render json: { ticket: TicketSerializer.call(@ticket) }
+      end
+
+      # PATCH /api/v1/tickets/:id - reply (publicly or as an internal note),
+      # change the status or priority, route the ticket to a group
+      # ("group_id": null clears it) and/or assign it ("assignee_id": null
+      # unassigns it); see TicketUpdate for how group and assignee go
+      # together. Public replies to tickets that came in by email are emailed
+      # to the requester. Closed tickets can't be updated.
+      def update
+        attributes = params.expect(ticket: [ :status, :priority, :assignee_id, :group_id, { comment: [ :body, :public ] } ])
+        if attributes[:status].nil? && attributes[:priority].nil? && attributes[:comment].nil? &&
+            !attributes.key?(:assignee_id) && !attributes.key?(:group_id)
+          raise ActionController::ParameterMissing, :ticket
+        end
+
+        update = TicketUpdate.new(@ticket, author: Current.user, status: attributes[:status], comment: attributes[:comment],
+          assignee_id: attributes.fetch(:assignee_id, TicketUpdate::UNCHANGED),
+          group_id: attributes.fetch(:group_id, TicketUpdate::UNCHANGED), priority: attributes[:priority])
+        if update.save
+          deliver_email TicketMailer.with(comment: update.comment).reply if update.email_requester?
+          render json: { ticket: TicketSerializer.call(update.ticket) }
+        else
+          render_validation_errors(update.errors)
+        end
+      end
+
+      # POST /api/v1/tickets/:id/merge - merges the ticket (a duplicate) into
+      # another ticket of the same requester, which closes it; see
+      # TicketMerge. Each side gets a note (internal unless "public": true)
+      # with a standard text unless staff send their own; neither is emailed.
+      #
+      #   {"merge": {"target_id": 57, "source_comment": {"body", "public"}, "target_comment": {...}}}
+      def merge
+        attributes = params.expect(merge: [ :target_id, { source_comment: [ :body, :public ], target_comment: [ :body, :public ] } ])
+        merging = TicketMerge.new(@ticket, author: Current.user, target_id: attributes[:target_id],
+          source_comment: attributes[:source_comment], target_comment: attributes[:target_comment])
+        if merging.save
+          render json: { source: TicketSerializer.call(merging.source), target: TicketSerializer.call(merging.target) }
+        else
+          render_validation_errors(merging.errors)
+        end
+      end
+
+      # GET /api/v1/tickets/:id/comments - the whole conversation, including
+      # internal notes, oldest first.
+      def comments
+        render_page @ticket.comments.oldest_first.includes(:author), :comments, CommentSerializer
+      end
+
+      private
+        def filtered_tickets
+          tickets = Current.account.tickets
+          if (status = list_filter(:status, Ticket.statuses.keys))
+            tickets = tickets.where(status: status)
+          end
+          if (priority = list_filter(:priority, Ticket.priorities.keys))
+            tickets = tickets.where(priority: priority)
+          end
+          if (group = id_filter(:group_id, words: [ "unassigned" ]))
+            tickets = tickets.where(group_id: group == "unassigned" ? nil : group)
+          end
+          if (assignee = id_filter(:assignee_id, words: [ "unassigned" ]))
+            tickets = tickets.where(assignee_id: assignee == "unassigned" ? nil : assignee)
+          end
+          if (requester = id_filter(:requester_id))
+            tickets = tickets.where(requester_id: requester)
+          end
+          if (text = text_filter(:q))
+            tickets = tickets.matching(text)
+          end
+          tickets
+        end
+
+        def set_ticket
+          @ticket = Current.account.tickets.includes(:requester, :assignee, :group).find_by(id: params[:id]) or render_not_found(:ticket)
+        end
+    end
+  end
+end
