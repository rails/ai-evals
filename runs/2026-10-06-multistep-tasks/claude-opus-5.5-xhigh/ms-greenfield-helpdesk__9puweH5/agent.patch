+    @invitation = params.fetch(:invitation)
+    @account = @invitation.account
+    @inviter = @invitation.invited_by
+    @role = @invitation.admin? ? "an admin" : "an agent"
+    @url = Helpdesk::Settings.frontend_link("/accept-invitation", account: @account.subdomain, token: params.fetch(:token))
+    @expires_in = Invitation::LIFETIME
