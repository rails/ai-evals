diff --git a/app/controllers/api/v1/password_resets_controller.rb b/app/controllers/api/v1/password_resets_controller.rb
new file mode 100644
index 0000000..fd56494
--- /dev/null
+++ b/app/controllers/api/v1/password_resets_controller.rb
@@ -0,0 +1,47 @@
+module Api
+  module V1
+    class PasswordResetsController < BaseController
+      allow_unauthenticated_access
+      skip_before_action :require_active_account!
+      before_action :require_account!, only: :create
+
+      rate_limit to: 10, within: 10.minutes, only: :create, name: "password-reset",
+        by: -> { "#{Current.account&.id}:#{requested_email(:password_reset)}" },
+        with: -> { render_too_many_requests(retry_after: 10.minutes) }
+
+      # POST /api/v1/password_resets - email a password reset link.
+      # The response is the same whether or not the address is known.
+      def create
+        email = params.expect(password_reset: [ :email ])[:email].to_s
+        user = Current.account.users.find_by(email: email)
+
+        if user&.active? && user.account_accessible?
+          token = UserToken.issue!(user, :password_reset)
+          deliver_email UserMailer.with(user: user, token: token).password_reset
+        end
+
+        render json: {
+          message: "If that address belongs to a user, a password reset link is on its way."
+        }, status: :accepted
+      end
+
+      # POST /api/v1/password_resets/confirm - set a new password.
+      # Signs the user out everywhere. Since the link arrived by email, this
+      # also confirms the user's email address.
+      def confirm
+        attributes = params.expect(password_reset: [ :token, :password, :password_confirmation ])
+        user = UserToken.redeem!(attributes[:token].to_s, :password_reset, account: Current.account) do |user|
+          raise Account::Cancelled unless user.account_accessible?
+          raise User::Suspended if user.suspended?
+
+          user.email_verified_at ||= Time.current
+          unless user.change_password(attributes[:password].to_s, confirmation: attributes[:password_confirmation])
+            raise ActiveRecord::RecordInvalid, user
+          end
+        end
+
+        render json: { user: UserSerializer.call(user) }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/passwords_controller.rb b/app/controllers/api/v1/passwords_controller.rb
new file mode 100644
index 0000000..a96b26e
--- /dev/null
+++ b/app/controllers/api/v1/passwords_controller.rb
@@ -0,0 +1,30 @@
+module Api
+  module V1
+    # PUT /api/v1/me/password - change the signed-in user's password.
+    #
+    # Every existing session (including the current one) is signed out; the
+    # response carries a fresh session token for the client to continue with.
+    class PasswordsController < BaseController
+      skip_before_action :require_active_account!
+
+      def update
+        attributes = params.expect(password_change: [ :current_password, :password, :password_confirmation ])
+        user = Current.user
+        throttle = LoginThrottle.new(account: Current.account, email: user.email, ip: request.remote_ip)
+        return render_too_many_requests(retry_after: LoginThrottle::PERIOD) if throttle.blocked?
+
+        unless user.authenticate(attributes[:current_password].to_s)
+          throttle.record_failure!
+          return render_error :unprocessable_content, "invalid_current_password", "Current password is incorrect.",
+            details: { current_password: [ "is incorrect" ] }
+        end
+
+        if user.change_password(attributes[:password].to_s, confirmation: attributes[:password_confirmation])
+          render json: { user: UserSerializer.call(user), session: SessionSerializer.call(start_session(user)) }
+        else
+          render_validation_errors(user.errors)
+        end
+      end
+    end
+  end
+end
