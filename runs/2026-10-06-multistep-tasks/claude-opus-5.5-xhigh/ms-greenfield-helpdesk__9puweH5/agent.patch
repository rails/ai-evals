new file mode 100644
index 0000000..e7cac2c
--- /dev/null
+++ b/app/models/concerns/form_errors.rb
@@ -0,0 +1,13 @@
+# Error reporting for form objects that save several records: collects each
+# record's errors into one hash, e.g. {"subject" => [...], "comment.body" => [...]},
+# which is what ApplicationController#render_validation_errors expects.
+module FormErrors
+  private
+    def collect_errors(errors, prefix: "", except: [])
+      errors.group_by_attribute.each_with_object({}) do |(attribute, list), collected|
+        next if except.include?(attribute.to_sym)
+
+        collected["#{prefix}#{attribute}"] = list.map(&:message).uniq
+      end
+    end
+end
