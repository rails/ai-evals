+++ b/test/models/account_test.rb
@@ -0,0 +1,182 @@
+require "test_helper"
+
+class AccountTest < ActiveSupport::TestCase
+  def create_account(subdomain, cancelled_at: nil)
+    registration = AccountRegistration.new(name: subdomain.capitalize, subdomain: subdomain,
+      admin: { name: "Owner", email: "owner@#{subdomain}.test", password: "password-123" })
+    assert registration.save, registration.errors.inspect
+    user = registration.user
+    user.update!(email_verified_at: Time.current)
+    Session.start!(user: user)
+    UserToken.issue!(user, :password_reset)
+    registration.account.tap { |account| account.update!(cancelled_at: cancelled_at) }
+  end
+
+  test "purges accounts cancelled more than 90 days ago, with all their data" do
+    expired = create_account("expired", cancelled_at: 91.days.ago)
+    recent = create_account("recent", cancelled_at: 89.days.ago)
+    active = create_account("active")
+
+    assert_equal 1, Account.purge_cancelled!
+
+    assert_not Account.exists?(expired.id)
+    assert_empty User.where(account_id: expired.id)
+    assert_equal 0, Session.joins(:user).where(users: { account_id: expired.id }).count
+    assert_equal 0, UserToken.joins(:user).where(users: { account_id: expired.id }).count
+    assert Account.exists?(recent.id)
+    assert Account.exists?(active.id)
+    assert_equal 2, User.count
+    assert_equal 2, Session.count
+  end
+
+  def add_ticket(account)
+    customer = account.users.create!(name: "Customer", email: "customer@#{account.subdomain}.test",
+      password: "password-123", role: :customer, email_verified_at: Time.current)
+    submission = RequestSubmission.new(requester: customer, subject: "Help", comment: { body: "Please help." })
+    assert submission.save, submission.errors.inspect
+    TicketUpdate.new(submission.ticket, author: account.owner, comment: { body: "Note", public: false }).save
+    submission.ticket
+  end
+
+  test "purging also deletes tickets and their comments" do
+    expired = create_account("expired", cancelled_at: 91.days.ago)
+    active = create_account("active")
+    expired_ticket = add_ticket(expired)
+    active_ticket = add_ticket(active)
+
+    assert_equal 1, Account.purge_cancelled!
+
+    assert_not Ticket.exists?(expired_ticket.id)
+    assert_empty TicketComment.where(ticket_id: expired_ticket.id)
+    assert_empty User.where(account_id: expired.id)
+    assert_equal 2, active_ticket.comments.count
+  end
+
+  test "purging deletes merged tickets too" do
+    expired = create_account("expired", cancelled_at: 91.days.ago)
+    first = add_ticket(expired)
+    customer = first.requester
+    others = 3.times.map do |i|
+      submission = RequestSubmission.new(requester: customer, subject: "Again #{i}", comment: { body: "Please." })
+      assert submission.save
+      submission.ticket
+    end
+    # Merged both ways round (into an older ticket and into a newer one), and
+    # in a chain.
+    [ [ others[0], first ], [ first, others[1] ], [ others[1], others[2] ] ].each do |source, target|
+      assert TicketMerge.new(source.reload, author: expired.owner, target_id: target.id).save
+    end
+
+    assert_equal 1, Account.purge_cancelled!
+
+    assert_empty Ticket.where(id: [ first, *others ].map(&:id))
+    assert_empty TicketComment.where(ticket_id: [ first, *others ].map(&:id))
+  end
+
+  test "destroying an account deletes its tickets" do
+    account = create_account("acme")
+    ticket = add_ticket(account)
+
+    account.destroy!
+
+    assert_not Ticket.exists?(ticket.id)
+    assert_empty TicketComment.where(ticket_id: ticket.id)
+  end
+
+  test "the purge rake task" do
+    create_account("expired", cancelled_at: 100.days.ago)
+    Rails.application.load_tasks if Rake::Task.tasks.empty?
+
+    assert_output(/Purged 1 cancelled account/) do
+      Rake::Task["helpdesk:purge_cancelled_accounts"].execute
+    end
+    assert_not Account.exists?(subdomain: "expired")
+  end
+
+  test "frees the subdomain once purged" do
+    create_account("acme", cancelled_at: 100.days.ago)
+    assert_not Account.new(name: "Acme", subdomain: "acme").valid?
+
+    Account.purge_cancelled!
+
+    assert Account.new(name: "Acme", subdomain: "acme").valid?
+  end
+end
+
+# Tickets' references to users are checked when the transaction commits, so
+# this has to commit for real (transactional tests never do).
+class AccountPurgeCommitTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  teardown { Account.delete_all }
+
+  test "accounts with conversations can be deleted" do
+    accounts = %w[expired other].map do |subdomain|
+      registration = AccountRegistration.new(name: subdomain.capitalize, subdomain: subdomain,
+        admin: { name: "Owner", email: "owner@#{subdomain}.test", password: "password-123" })
+      assert registration.save
+      customer = registration.account.users.create!(name: "Customer", email: "customer@#{subdomain}.test",
+        password: "password-123", role: :customer)
+      submission = RequestSubmission.new(requester: customer, subject: "Help", comment: { body: "Please help." })
+      assert submission.save
+      assert TicketUpdate.new(submission.ticket, author: registration.user, comment: { body: "On it." }).save
+      registration.account
+    end
+    accounts.first.update!(cancelled_at: 91.days.ago)
+
+    assert_equal 1, Account.purge_cancelled!
+    assert_equal 1, Ticket.count
+
+    # Several accounts in one statement, as well.
+    Account.delete_all
+    assert_equal [ 0, 0, 0 ], [ User.count, Ticket.count, TicketComment.count ]
+  end
+
+  test "accounts with staff, invitations and assigned tickets can be deleted" do
+    registration = AccountRegistration.new(name: "Expired", subdomain: "expired",
+      admin: { name: "Owner", email: "owner@expired.test", password: "password-123" })
+    assert registration.save
+    account = registration.account
+    invitation = Invitation.invite(account: account, invited_by: registration.user, email: "sam@expired.test", role: "agent")
+    assert InvitationAcceptance.new(token: invitation.token, name: "Sam", password: "password-123").save
+    Invitation.invite(account: account, invited_by: registration.user, email: "kim@expired.test", role: "admin")
+    agent = account.users.find_by!(email: "sam@expired.test")
+    customer = account.users.create!(name: "Customer", email: "customer@expired.test", password: "password-123", role: :customer)
+    submission = RequestSubmission.new(requester: customer, subject: "Help", comment: { body: "Please help." })
+    assert submission.save
+    assert TicketUpdate.new(submission.ticket, author: agent, assignee_id: agent.id, comment: { body: "Mine.", public: false }).save
+    account.update!(cancelled_at: 91.days.ago)
+
+    assert_equal 1, Account.purge_cancelled!
+    assert_equal [ 0, 0, 0, 0 ], [ User.count, Ticket.count, TicketComment.count, Invitation.count ]
+  end
+
+  # Postgres runs an account's cascades one at a time, in an order that
+  # depends on how the database was built, so these can't be checked
+  # immediately: the account's users may be deleted before its tickets.
+  test "tickets' foreign keys to users are deferred" do
+    constraints = ActiveRecord::Base.connection.select_rows(<<~SQL)
+      SELECT conrelid::regclass::text, a.attname, condeferrable, condeferred FROM pg_constraint
+      JOIN pg_attribute a ON a.attrelid = conrelid AND a.attnum = conkey[1]
+      WHERE contype = 'f' AND confrelid = 'users'::regclass
+        AND conrelid IN ('tickets'::regclass, 'ticket_comments'::regclass)
+    SQL
+
+    assert_equal [ [ "ticket_comments", "author_id", true, true ], [ "tickets", "assignee_id", true, true ],
+                   [ "tickets", "requester_id", true, true ] ], constraints.sort
+  end
+
+  test "new businesses can't take the role addresses at the support domain" do
+    %w[postmaster abuse hostmaster webmaster mailer-daemon noreply].each do |subdomain|
+      account = Account.new(name: "Mail", subdomain: subdomain)
+      assert_not account.valid?
+      assert_includes account.errors[:subdomain], "is reserved"
+    end
+
+    # One that already exists keeps working.
+    existing = Account.new(name: "Old", subdomain: "postmaster")
+    existing.save!(validate: false)
+    assert existing.update(name: "Older")
+  end
+end
+
