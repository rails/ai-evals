@@ -0,0 +1,28 @@
+class AddMergingToTickets < ActiveRecord::Migration[8.1]
+  def up
+    # Merging a duplicate into another ticket closes it for good: "closed"
+    # is reached only by merging (staff can't choose it), and nothing
+    # reopens it.
+    remove_check_constraint :tickets, name: "tickets_status_check"
+    add_check_constraint :tickets, "status IN ('open', 'pending', 'solved', 'closed')", name: "tickets_status_check"
+
+    # The ticket a closed duplicate was merged into, where its conversation
+    # carries on. It's set once and never rewritten, so it keeps pointing to
+    # the same ticket even when that one is merged in turn. Tickets are only
+    # deleted together with their account; nullify keeps that working
+    # whatever order the account's tickets are deleted in.
+    add_reference :tickets, :merged_into, index: { where: "merged_into_id IS NOT NULL" },
+      foreign_key: { to_table: :tickets, on_delete: :nullify }
+    add_check_constraint :tickets, "merged_into_id IS NULL OR (status = 'closed' AND merged_into_id <> id)",
+      name: "tickets_merged_into_check"
+  end
+
+  def down
+    remove_check_constraint :tickets, name: "tickets_merged_into_check"
+    remove_reference :tickets, :merged_into, index: true, foreign_key: { to_table: :tickets }
+    # The old statuses have no closed: the nearest is solved.
+    execute "UPDATE tickets SET status = 'solved' WHERE status = 'closed'"
+    remove_check_constraint :tickets, name: "tickets_status_check"
+    add_check_constraint :tickets, "status IN ('open', 'pending', 'solved')", name: "tickets_status_check"
+  end
+end
