diff --git a/test/integration/account_lifecycle_test.rb b/test/integration/account_lifecycle_test.rb
new file mode 100644
index 0000000..6e610d1
--- /dev/null
+++ b/test/integration/account_lifecycle_test.rb
@@ -0,0 +1,127 @@
+require "test_helper"
+
+class AccountLifecycleTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_up_verified
+    @owner_token = sign_in
+  end
+
+  test "the portal is public" do
+    api :get, "/portal"
+
+    assert_response :ok
+    assert_equal({ "portal" => { "name" => "Acme", "subdomain" => "acme" } }, json)
+  end
+
+  test "signed-in users see the full account" do
+    api :get, "/account"
+    assert_response :unauthorized
+
+    api :get, "/account", token: @owner_token
+    assert_response :ok
+    assert_equal %w[cancelled_at created_at id name owner_id reactivatable_until status subdomain updated_at],
+      json["account"].keys.sort
+  end
+
+  test "cancelling revokes sessions and stops ordinary access" do
+    create_user(email: "agent@acme.test")
+    agent_token = sign_in(email: "agent@acme.test")
+
+    api :post, "/account/cancel", token: @owner_token
+
+    assert_response :ok
+    assert_equal "cancelled", json.dig("account", "status")
+    assert json.dig("account", "cancelled_at").present?
+    assert_equal (Time.zone.parse(json.dig("account", "cancelled_at")) + 90.days).iso8601,
+      Time.zone.parse(json.dig("account", "reactivatable_until")).iso8601
+
+    [ @owner_token, agent_token ].each do |token|
+      api :get, "/me", token: token
+      assert_response :unauthorized
+    end
+
+    api :get, "/portal"
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    api :post, "/sessions", { session: { email: "agent@acme.test", password: PASSWORD } }
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+
+    api :post, "/password_resets", { password_reset: { email: "agent@acme.test" } }
+    assert_response :accepted
+    assert_no_match(/agent@acme/, ActionMailer::Base.deliveries.flat_map(&:to).join(","))
+  end
+
+  test "the owner can sign in to a cancelled account and reactivate it" do
+    api :post, "/account/cancel", token: @owner_token
+
+    token = sign_in
+    api :get, "/account", token: token
+    assert_response :ok
+    assert_equal "cancelled", json.dig("account", "status")
+
+    api :post, "/account/reactivate", token: token
+    assert_response :ok
+    assert_equal "active", json.dig("account", "status")
+    assert_nil json.dig("account", "cancelled_at")
+
+    api :get, "/portal"
+    assert_response :ok
+    assert sign_in.present?
+  end
+
+  test "an owner who forgot their password can still reset it after cancelling" do
+    api :post, "/account/cancel", token: @owner_token
+
+    api :post, "/password_resets", { password_reset: { email: "jo@acme.test" } }
+    api :post, "/password_resets/confirm",
+      { password_reset: { token: emailed_token("reset-password"), password: "my-new-password" } }
+
+    assert_response :ok
+    assert sign_in(password: "my-new-password").present?
+  end
+
+  test "reactivation is only possible within 90 days" do
+    api :post, "/account/cancel", token: @owner_token
+
+    travel 90.days + 1.minute do
+      api :post, "/account/reactivate", token: sign_in
+      assert_response :unprocessable_content
+      assert_equal "reactivation_period_expired", json.dig("error", "code")
+    end
+  end
+
+  test "cancelling twice or reactivating an active account is rejected" do
+    api :post, "/account/reactivate", token: @owner_token
+    assert_response :unprocessable_content
+    assert_equal "account_not_cancelled", json.dig("error", "code")
+
+    api :post, "/account/cancel", token: @owner_token
+    api :post, "/account/cancel", token: sign_in
+    assert_response :unprocessable_content
+    assert_equal "account_already_cancelled", json.dig("error", "code")
+  end
+
+  test "only the owner can cancel" do
+    create_user(email: "other-admin@acme.test", role: :admin)
+
+    api :post, "/account/cancel", token: sign_in(email: "other-admin@acme.test")
+
+    assert_response :forbidden
+    assert_equal "forbidden", json.dig("error", "code")
+    assert Account.find_by!(subdomain: "acme").active?
+  end
+
+  test "cancelling one business doesn't affect another" do
+    sign_up_verified(subdomain: "globex", name: "Globex")
+    globex_token = sign_in(account: "globex")
+
+    api :post, "/account/cancel", token: @owner_token
+
+    api :get, "/me", account: "globex", token: globex_token
+    assert_response :ok
+    api :get, "/portal", account: "globex"
+    assert_response :ok
+  end
+end
diff --git a/test/integration/cors_test.rb b/test/integration/cors_test.rb
new file mode 100644
index 0000000..eb3260d
--- /dev/null
+++ b/test/integration/cors_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class CorsTest < ActionDispatch::IntegrationTest
+  def preflight(origin)
+    process :options, "/api/v1/sessions", headers: {
+      "Origin" => origin,
+      "Access-Control-Request-Method" => "POST",
+      "Access-Control-Request-Headers" => "content-type, authorization, x-helpdesk-account"
+    }
+  end
+
+  test "answers preflight requests from the frontend" do
+    preflight("http://localhost:3001")
+
+    assert_response :no_content
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    assert_includes response.headers["Access-Control-Allow-Methods"], "PATCH"
+    allowed_headers = response.headers["Access-Control-Allow-Headers"].downcase
+    %w[authorization content-type x-helpdesk-account].each { |header| assert_includes allowed_headers, header }
+  end
+
+  test "allows the frontend origin on regular requests" do
+    sign_up
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "acme", "Origin" => "http://localhost:3001" }
+
+    assert_response :ok
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    assert_includes response.headers["Vary"], "Origin"
+  end
+
+  test "does not allow other origins" do
+    preflight("https://evil.example")
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+
+    get "/up", headers: { "Origin" => "https://evil.example" }
+    assert_nil response.headers["Access-Control-Allow-Origin"]
+  end
+
+  test "follows HELPDESK_FRONTEND_URL" do
+    with_env("HELPDESK_FRONTEND_URL" => "https://app.helpdesk.example/") do
+      preflight("https://app.helpdesk.example")
+      assert_equal "https://app.helpdesk.example", response.headers["Access-Control-Allow-Origin"]
+
+      preflight("http://localhost:3001")
+      assert_nil response.headers["Access-Control-Allow-Origin"]
+    end
+  end
+end
diff --git a/test/integration/cursor_pagination_test.rb b/test/integration/cursor_pagination_test.rb
new file mode 100644
index 0000000..ae5748b
--- /dev/null
+++ b/test/integration/cursor_pagination_test.rb
@@ -0,0 +1,275 @@
+require "test_helper"
+
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_up_verified
+    @owner_token = sign_in
+    @customer_token = sign_in_new_customer
+  end
+
+  def follow(url, token: @owner_token)
+    assert url, "expected a link"
+    assert url.start_with?("http://www.example.com/api/v1/"), url
+    get url, headers: api_headers(token: token)
+    assert_response :ok
+    json
+  end
+
+  def query_of(url)
+    Rack::Utils.parse_nested_query(URI.parse(url).query)
+  end
+
+  # Follows the next links from the first page of +path+ to the end, then the
+  # prev links back to the start, checking that both ways give the same
+  # pages. Returns the IDs page by page.
+  def walk(path, key, size:, token: @owner_token)
+    separator = path.include?("?") ? "&" : "?"
+    api :get, "#{path}#{separator}page[size]=#{size}", token: token
+    assert_response :ok
+    assert_nil json.dig("links", "prev")
+    pages = [ json[key].pluck("id") ]
+    while json.dig("meta", "has_more")
+      follow json.dig("links", "next"), token: token
+      pages << json[key].pluck("id")
+    end
+    assert_nil json.dig("links", "next")
+
+    (pages.size - 2).downto(0) do |index|
+      follow json.dig("links", "prev"), token: token
+      assert_equal pages[index], json[key].pluck("id")
+      assert_equal index.positive?, json.dig("meta", "has_more")
+      assert json.dig("links", "next")
+    end
+    assert_nil json.dig("links", "prev")
+    pages
+  end
+
+  # All of +path+ in order, by page numbers.
+  def all_ids(path, key, token: @owner_token)
+    separator = path.include?("?") ? "&" : "?"
+    api :get, "#{path}#{separator}per_page=100", token: token
+    assert_response :ok
+    json[key].pluck("id")
+  end
+
+  def open_tickets(count)
+    count.times.map { |i| open_request(@customer_token, subject: "Request #{i}") }.reverse
+  end
+
+  test "a first page with nothing to show" do
+    api :get, "/tickets?page[size]=25&status=open", token: @owner_token
+    assert_response :ok
+    assert_equal({ "tickets" => [], "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+                   "links" => { "next" => nil, "prev" => nil } }, json)
+  end
+
+  test "pages have cursors for their first and last records and links to either side, keeping the filters" do
+    newest_first = open_tickets(5).pluck("id")
+    open_request(@customer_token, subject: "Something else")
+    Ticket.find_by!(subject: "Something else").update_columns(status: "pending", updated_at: 1.hour.from_now)
+
+    api :get, "/tickets?page[size]=2&status=open", token: @owner_token
+    assert_response :ok
+    assert_equal newest_first.first(2), json["tickets"].pluck("id")
+    assert_equal %w[links meta tickets], json.keys.sort
+    assert_equal true, json.dig("meta", "has_more")
+    assert_nil json.dig("links", "prev")
+    first_page = json
+
+    next_query = query_of(first_page.dig("links", "next"))
+    assert_equal({ "status" => "open", "page" => { "size" => "2", "after" => first_page.dig("meta", "after_cursor") } }, next_query)
+
+    # The same page, from the cursor of its last record.
+    api :get, "/tickets?status=open&page[size]=2&page[after]=#{first_page.dig("meta", "after_cursor")}", token: @owner_token
+    second_page = json
+    assert_equal newest_first[2, 2], second_page["tickets"].pluck("id")
+    assert_equal second_page, follow(first_page.dig("links", "next"))
+    assert_equal({ "status" => "open", "page" => { "size" => "2", "before" => second_page.dig("meta", "before_cursor") } },
+      query_of(second_page.dig("links", "prev")))
+
+    # Before the first record of the second page comes the first page, with
+    # nothing more before it.
+    api :get, "/tickets?status=open&page[size]=2&page[before]=#{second_page.dig("meta", "before_cursor")}", token: @owner_token
+    assert_equal newest_first.first(2), json["tickets"].pluck("id")
+    assert_equal false, json.dig("meta", "has_more")
+    assert_nil json.dig("links", "prev")
+    assert_equal first_page.dig("meta"), json["meta"].merge("has_more" => true)
+
+    follow second_page.dig("links", "next")
+    assert_equal [ newest_first.last ], json["tickets"].pluck("id")
+    assert_equal({ "has_more" => false, "after_cursor" => json.dig("meta", "before_cursor"),
+                   "before_cursor" => json.dig("meta", "after_cursor") }, json["meta"])
+    assert_nil json.dig("links", "next")
+    assert json.dig("links", "prev")
+
+    # Past the end there's nothing.
+    api :get, "/tickets?status=open&page[size]=2&page[after]=#{json.dig("meta", "after_cursor")}", token: @owner_token
+    assert_equal({ "tickets" => [], "meta" => { "has_more" => false, "after_cursor" => nil, "before_cursor" => nil },
+                   "links" => { "next" => nil, "prev" => nil } }, json)
+
+    assert_equal newest_first.each_slice(2).to_a, walk("/tickets?status=open", "tickets", size: 2)
+  end
+
+  test "navigation stays put while other people work" do
+    a, b, c, d, e = open_tickets(5).pluck("id")
+
+    api :get, "/tickets?page[size]=2", token: @owner_token
+    assert_equal [ a, b ], json["tickets"].pluck("id")
+    next_link = json.dig("links", "next")
+    api :get, "/tickets?per_page=2", token: @owner_token
+    assert_equal [ a, b ], json["tickets"].pluck("id")
+
+    # Meanwhile a new ticket comes in, and the last ticket of the page is
+    # updated, which makes it the most recently active.
+    new = open_request(@customer_token, subject: "New")["id"]
+    api :patch, "/tickets/#{b}", { ticket: { comment: { body: "On it.", public: false } } }, token: @owner_token
+    assert_response :ok
+
+    # Page numbers shift: page 2 now repeats a ticket from page 1.
+    api :get, "/tickets?per_page=2&page=2", token: @owner_token
+    assert_equal [ a, c ], json["tickets"].pluck("id")
+
+    # Cursors carry on where the first page ended.
+    follow next_link
+    assert_equal [ c, d ], json["tickets"].pluck("id")
+    assert_equal true, json.dig("meta", "has_more")
+    third = follow(json.dig("links", "next"))
+    assert_equal [ e ], third["tickets"].pluck("id")
+
+    # Someone updates the record behind the page's cursor (moving it to the
+    # top) and others before it; going back still leads to the tickets
+    # right before, and then to the ones that came in or moved up.
+    api :patch, "/tickets/#{e}", { ticket: { priority: "high" } }, token: @owner_token
+    follow third.dig("links", "prev")
+    assert_equal [ c, d ], json["tickets"].pluck("id")
+    follow json.dig("links", "prev")
+    assert_equal [ new, a ], json["tickets"].pluck("id")
+    assert_equal true, json.dig("meta", "has_more")
+    follow json.dig("links", "prev")
+    assert_equal [ e, b ], json["tickets"].pluck("id")
+    assert_equal false, json.dig("meta", "has_more")
+    assert_nil json.dig("links", "prev")
+  end
+
+  test "records with the same activity time are neither skipped nor repeated" do
+    ids = open_tickets(5).pluck("id")
+    Ticket.where(id: ids).update_all(updated_at: Time.utc(2025, 1, 1, 12, 0, 0, 123456r))
+    Ticket.where(id: ids.values_at(1, 3)).update_all(updated_at: Time.utc(2025, 1, 1, 12, 0, 0, 123457r))
+    expected = all_ids("/tickets", "tickets")
+    # Then by ID, newest first.
+    assert_equal ids.values_at(1, 3, 0, 2, 4), expected
+
+    [ 1, 2, 3 ].each do |size|
+      assert_equal expected.each_slice(size).to_a, walk("/tickets", "tickets", size: size)
+    end
+  end
+
+  test "every list takes cursors" do
+    ticket = open_request(@customer_token)
+    3.times { |i| api :patch, "/requests/#{ticket["id"]}", { request: { comment: { body: "More #{i}" } } }, token: @customer_token }
+    api :patch, "/tickets/#{ticket["id"]}", { ticket: { comment: { body: "Note", public: false } } }, token: @owner_token
+    open_tickets(2)
+    agent_token = sign_in_invited(@owner_token)
+    agent = User.find_by!(email: "sam@example.test")
+    owner = User.find_by!(email: "jo@acme.test")
+    2.times { |i| invite(@owner_token, email: "invitee#{i}@example.test") }
+    groups = 3.times.map do |i|
+      api :post, "/groups", { group: { name: "Group #{i}" } }, token: @owner_token
+      json.dig("group", "id")
+    end
+    groups.each do |group|
+      [ owner, agent ].each do |user|
+        api :post, "/group_memberships", { group_membership: { group_id: group, user_id: user.id } }, token: @owner_token
+        assert_response :created
+      end
+    end
+
+    {
+      [ "/tickets", "tickets", @owner_token ] => 3,
+      [ "/tickets/#{ticket["id"]}/comments", "comments", agent_token ] => 5,
+      [ "/requests", "requests", @customer_token ] => 3,
+      [ "/requests/#{ticket["id"]}/comments", "comments", @customer_token ] => 4,
+      [ "/staff", "staff", agent_token ] => 2,
+      [ "/groups", "groups", agent_token ] => 3,
+      [ "/group_memberships", "group_memberships", agent_token ] => 6,
+      [ "/group_memberships?user_id=#{agent.id}", "group_memberships", agent_token ] => 3,
+      [ "/users", "users", @owner_token ] => 3,
+      [ "/users?role=staff", "users", @owner_token ] => 2,
+      [ "/invitations", "invitations", @owner_token ] => 3
+    }.each do |(path, key, token), count|
+      expected = all_ids(path, key, token: token)
+      assert_equal count, expected.size, path
+      [ 1, 2 ].each do |size|
+        assert_equal expected.each_slice(size).to_a, walk(path, key, size: size, token: token), "#{path} by #{size}"
+      end
+    end
+  end
+
+  test "a page carries on after its last record was deleted" do
+    groups = 4.times.map do |i|
+      api :post, "/groups", { group: { name: "Group #{i}" } }, token: @owner_token
+      json.dig("group", "id")
+    end
+    api :get, "/groups?page[size]=2", token: @owner_token
+    next_link = json.dig("links", "next")
+
+    api :delete, "/groups/#{groups[1]}", token: @owner_token
+    assert_response :no_content
+    follow next_link
+    assert_equal groups.last(2), json["groups"].pluck("id")
+    assert_equal false, json.dig("meta", "has_more")
+    follow json.dig("links", "prev")
+    assert_equal [ groups[0] ], json["groups"].pluck("id")
+  end
+
+  test "sizes default to 25 and are capped at 100; empty cursors are the start of the list" do
+    ids = open_tickets(4).pluck("id")
+    api :get, "/tickets?page[size]=1", token: @owner_token
+    first_cursor = json.dig("meta", "after_cursor")
+    { "" => 25, "nope" => 25, "0" => 25, "-1" => 25, "1.5" => 25, "2" => 2, "1000" => 100 }.each do |size, used|
+      api :get, "/tickets?page[size]=#{size}&page[after]=", token: @owner_token
+      assert_response :ok
+      assert_equal ids.first(used), json["tickets"].pluck("id")
+
+      # Links carry the size that was used.
+      api :get, "/tickets?page[after]=#{first_cursor}&page[size]=#{size}", token: @owner_token
+      assert_equal ids.drop(1).first(used), json["tickets"].pluck("id")
+      assert_equal({ "size" => used.to_s, "before" => json.dig("meta", "before_cursor") }, query_of(json.dig("links", "prev"))["page"])
+    end
+
+    # Cursors without a size use the default; per_page is for page numbers.
+    api :get, "/tickets?page[after]=&per_page=1", token: @owner_token
+    assert_equal ids, json["tickets"].pluck("id")
+  end
+
+  test "cursors this list didn't make, or both directions at once, are rejected" do
+    open_tickets(2)
+    api :get, "/tickets?page[size]=1", token: @owner_token
+    ticket_cursor = json.dig("meta", "after_cursor")
+    api :get, "/users?page[size]=1", token: @owner_token
+    user_cursor = json.dig("meta", "after_cursor")
+
+    [ "/tickets?page[after]=nope", "/tickets?page[after][]=x", "/tickets?page[after]=#{user_cursor}",
+      "/users?page[after]=#{ticket_cursor}", "/requests?page[after]=#{ticket_cursor}" ].each do |path|
+      api :get, path, token: path.start_with?("/requests") ? @customer_token : @owner_token
+      assert_response :unprocessable_content
+      assert_equal "validation_failed", json.dig("error", "code")
+      assert_equal({ "page[after]" => [ "is not a valid cursor" ] }, json.dig("error", "details"), path)
+    end
+
+    api :get, "/tickets?page[before]=%00", token: @owner_token
+    assert_response :unprocessable_content
+    assert_equal({ "page[before]" => [ "is not a valid cursor" ] }, json.dig("error", "details"))
+
+    api :get, "/tickets?page[after]=#{ticket_cursor}&page[before]=#{ticket_cursor}", token: @owner_token
+    assert_response :unprocessable_content
+    assert_equal({ "page" => [ "can't have both after and before" ] }, json.dig("error", "details"))
+  end
+
+  test "lists without cursor parameters keep their page numbers" do
+    ids = open_tickets(3).pluck("id")
+    api :get, "/tickets?per_page=2&page=2", token: @owner_token
+    assert_equal({ "tickets" => [ ids.last ], "count" => 3, "page" => 2, "per_page" => 2, "next_page" => nil, "previous_page" => 1 },
+      json.merge("tickets" => json["tickets"].pluck("id")))
+  end
+end
diff --git a/test/integration/customer_registration_test.rb b/test/integration/customer_registration_test.rb
new file mode 100644
index 0000000..56eb766
--- /dev/null
+++ b/test/integration/customer_registration_test.rb
@@ -0,0 +1,129 @@
+require "test_helper"
+
+class CustomerRegistrationTest < ActionDispatch::IntegrationTest
+  setup { sign_up_verified }
+
+  test "registers an unverified customer of the business and emails a verification link" do
+    body = nil
+    assert_emails 1 do
+      body = register_customer
+    end
+
+    user = body.fetch("user")
+    assert_equal Account.find_by!(subdomain: "acme").id, user["account_id"]
+    assert_equal({ "name" => "Avery", "email" => "avery@example.test", "role" => "customer",
+                   "owner" => false, "verified" => false },
+      user.slice("name", "email", "role", "owner", "verified"))
+    assert_not user.key?("password_digest")
+
+    assert_equal [ "avery@example.test" ], last_email.to
+    assert_includes last_email.text_part.body.decoded,
+      "http://localhost:3001/verify-email?account=acme&token=#{emailed_token("verify-email")}"
+  end
+
+  test "customers verify their email before signing in, then use the usual profile flows" do
+    register_customer
+
+    api :post, "/sessions", { session: { email: "avery@example.test", password: CUSTOMER_PASSWORD } }
+    assert_response :forbidden
+    assert_equal "email_not_verified", json.dig("error", "code")
+
+    api :post, "/email_verifications/confirm", { email_verification: { token: emailed_token("verify-email") } }
+    assert_response :ok
+    token = sign_in(email: "avery@example.test", password: CUSTOMER_PASSWORD)
+
+    api :get, "/me", token: token
+    assert_response :ok
+    assert_equal "customer", json.dig("user", "role")
+
+    api :patch, "/me", { user: { name: "Avery Smith" } }, token: token
+    assert_response :ok
+    assert_equal "Avery Smith", json.dig("user", "name")
+
+    api :put, "/me/password", { password_change: { current_password: CUSTOMER_PASSWORD, password: "a-new-password" } },
+      token: token
+    assert_response :ok
+    assert sign_in(email: "avery@example.test", password: "a-new-password").present?
+  end
+
+  test "customers can recover their password" do
+    register_customer
+
+    api :post, "/password_resets", { password_reset: { email: "avery@example.test" } }
+    assert_response :accepted
+    api :post, "/password_resets/confirm",
+      { password_reset: { token: emailed_token("reset-password"), password: "a-new-password" } }
+    assert_response :ok
+
+    # The emailed reset link also verified the address.
+    assert sign_in(email: "avery@example.test", password: "a-new-password").present?
+  end
+
+  test "the role can't be chosen" do
+    api :post, "/registrations",
+      { user: { name: "Eve", email: "eve@example.test", password: CUSTOMER_PASSWORD, role: "admin" } }
+
+    assert_response :created
+    assert_equal "customer", json.dig("user", "role")
+  end
+
+  test "an email address can register once per business" do
+    register_customer
+
+    [ "AVERY@example.test", "jo@acme.test" ].each do |email|
+      assert_no_difference -> { User.count } do
+        api :post, "/registrations", { user: { name: "Someone", email: email, password: CUSTOMER_PASSWORD } }
+      end
+      assert_response :unprocessable_content
+      assert_equal [ "has already been taken" ], json.dig("error", "details", "email")
+    end
+
+    sign_up(name: "Globex", subdomain: "globex", email: "boss@globex.test")
+    register_customer(account: "globex")
+  end
+
+  test "reports invalid fields without creating anything" do
+    assert_no_difference -> { User.count } do
+      assert_no_emails do
+        api :post, "/registrations", { user: { name: "", email: "nope", password: "short" } }
+      end
+    end
+
+    assert_response :unprocessable_content
+    assert_equal "validation_failed", json.dig("error", "code")
+    assert_equal %w[email name password], json.dig("error", "details").keys.sort
+
+    api :post, "/registrations", {}
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+  end
+
+  test "needs a known, active business" do
+    api :post, "/registrations", { user: { name: "Avery", email: "avery@example.test", password: CUSTOMER_PASSWORD } },
+      account: nil
+    assert_response :bad_request
+    assert_equal "account_required", json.dig("error", "code")
+
+    api :post, "/registrations", { user: { name: "Avery", email: "avery@example.test", password: CUSTOMER_PASSWORD } },
+      account: "nope"
+    assert_response :not_found
+
+    Account.find_by!(subdomain: "acme").cancel!
+    assert_no_difference -> { User.count } do
+      api :post, "/registrations", { user: { name: "Avery", email: "avery@example.test", password: CUSTOMER_PASSWORD } }
+    end
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+  end
+
+  test "customers of a cancelled business can't sign in" do
+    customer_token = sign_in_new_customer
+    Account.find_by!(subdomain: "acme").cancel!
+
+    api :get, "/requests", token: customer_token
+    assert_response :unauthorized
+    api :post, "/sessions", { session: { email: "avery@example.test", password: CUSTOMER_PASSWORD } }
+    assert_response :forbidden
+    assert_equal "account_cancelled", json.dig("error", "code")
+  end
+end
diff --git a/test/integration/email_verification_test.rb b/test/integration/email_verification_test.rb
new file mode 100644
index 0000000..ae88b5f
--- /dev/null
+++ b/test/integration/email_verification_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class EmailVerificationTest < ActionDispatch::IntegrationTest
+  setup { sign_up }
+
+  test "an unverified user cannot sign in" do
+    api :post, "/sessions", { session: { email: "jo@acme.test", password: PASSWORD } }
+
+    assert_response :forbidden
+    assert_equal "email_not_verified", json.dig("error", "code")
+  end
+
+  test "confirming the emailed token verifies the user, who can then sign in" do
+    api :post, "/email_verifications/confirm", { email_verification: { token: emailed_token("verify-email") } }
+
+    assert_response :ok
+    assert_equal true, json.dig("user", "verified")
+    assert json.dig("user", "email_verified_at").present?
+    assert_equal "acme", json.dig("account", "subdomain")
+    assert sign_in.present?
+  end
+
+  test "a token works only once" do
+    token = emailed_token("verify-email")
+    api :post, "/email_verifications/confirm", { email_verification: { token: token } }
+    assert_response :ok
+
+    api :post, "/email_verifications/confirm", { email_verification: { token: token } }
+    assert_response :unprocessable_content
+    assert_equal "invalid_token", json.dig("error", "code")
+  end
+
+  test "the account header is optional, but must match the token's account" do
+    token = emailed_token("verify-email")
+    sign_up(name: "Globex", subdomain: "globex", email: "boss@globex.test")
+
+    api :post, "/email_verifications/confirm", { email_verification: { token: token } }, account: "globex"
+    assert_response :unprocessable_content
+
+    api :post, "/email_verifications/confirm", { email_verification: { token: token } }, account: nil
+    assert_response :ok
+  end
+
+  test "requesting a new link replaces the old one" do
+    old_token = emailed_token("verify-email")
+
+    assert_emails 1 do
+      api :post, "/email_verifications", { email_verification: { email: "jo@acme.test" } }
+    end
+    assert_response :accepted
+    new_token = emailed_token("verify-email")
+    assert_not_equal old_token, new_token
+
+    api :post, "/email_verifications/confirm", { email_verification: { token: old_token } }
+    assert_response :unprocessable_content
+
+    api :post, "/email_verifications/confirm", { email_verification: { token: new_token } }
+    assert_response :ok
+  end
+
+  test "requests for unknown or already verified addresses look the same but send nothing" do
+    api :post, "/email_verifications/confirm", { email_verification: { token: emailed_token("verify-email") } }
+    ActionMailer::Base.deliveries.clear
+
+    api :post, "/email_verifications", { email_verification: { email: "nobody@acme.test" } }
+    assert_response :accepted
+    unknown = json
+
+    api :post, "/email_verifications", { email_verification: { email: "jo@acme.test" } }
+    assert_response :accepted
+    assert_equal unknown, json
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "requesting a link needs the account header" do
+    api :post, "/email_verifications", { email_verification: { email: "jo@acme.test" } }, account: nil
+
+    assert_response :bad_request
+    assert_equal "account_required", json.dig("error", "code")
+  end
+
+  test "links expire" do
+    token = emailed_token("verify-email")
+
+    travel UserToken::LIFETIMES["email_verification"] + 1.minute do
+      api :post, "/email_verifications/confirm", { email_verification: { token: token } }
+      assert_response :unprocessable_content
+    end
+  end
+
+  test "garbage tokens are rejected" do
+    api :post, "/email_verifications/confirm", { email_verification: { token: "garbage" } }
+    assert_response :unprocessable_content
+
+    api :post, "/email_verifications/confirm", { email_verification: { token: "" } }
+    assert_response :unprocessable_content
+
+    api :post, "/email_verifications/confirm", {}
+    assert_response :bad_request
+  end
+end
diff --git a/test/integration/group_memberships_test.rb b/test/integration/group_memberships_test.rb
new file mode 100644
index 0000000..5c9d8fb
--- /dev/null
+++ b/test/integration/group_memberships_test.rb
@@ -0,0 +1,249 @@
+require "test_helper"
+
+class GroupMembershipsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_up_verified
+    @owner_token = sign_in
+    @owner = User.find_by!(email: "jo@acme.test")
+    @agent_token = sign_in_invited(@owner_token)
+    @agent = User.find_by!(email: "sam@example.test")
+    @billing = create_group("Billing")
+    @support = create_group("Technical Support")
+    @sales = create_group("Sales")
+  end
+
+  def create_group(name)
+    api :post, "/groups", { group: { name: name } }, token: @owner_token
+    assert_response :created
+    json.fetch("group")
+  end
+
+  def add_member(group, user, token: @owner_token, **options)
+    api :post, "/group_memberships", { group_membership: { group_id: group["id"], user_id: user.id, **options } },
+      token: token
+  end
+
+  def add_member!(group, user, **options)
+    add_member(group, user, **options)
+    assert_response :created
+    json.fetch("group_membership")
+  end
+
+  def defaults(user)
+    GroupMembership.where(user: user, default: true).pluck(:group_id)
+  end
+
+  def memberships(token: @agent_token, **query)
+    api :get, "/group_memberships?#{query.to_query}", token: token
+    assert_response :ok
+    json["group_memberships"]
+  end
+
+  test "admins add staff to several groups; the first one is their default" do
+    membership = add_member!(@billing, @agent)
+    assert_equal({ "group_id" => @billing["id"], "group" => { "id" => @billing["id"], "name" => "Billing" },
+                   "user_id" => @agent.id, "user" => { "id" => @agent.id, "name" => "Sam" }, "default" => true },
+      membership.except("id", "created_at", "updated_at"))
+
+    assert_equal false, add_member!(@support, @agent)["default"]
+    assert_equal false, add_member!(@sales, @agent, default: false)["default"]
+    assert_equal [ @billing["id"] ], defaults(@agent)
+
+    # Even when asked not to be, the first membership is the default.
+    assert_equal true, add_member!(@support, @owner, default: false)["default"]
+  end
+
+  test "a new membership can take over as the default" do
+    add_member!(@billing, @agent)
+    assert_equal true, add_member!(@support, @agent, default: true)["default"]
+    assert_equal [ @support["id"] ], defaults(@agent)
+    assert_equal true, add_member!(@sales, @agent, default: "true")["default"]
+    assert_equal [ @sales["id"] ], defaults(@agent)
+
+    add_member(@billing, @owner, default: "yes")
+    assert_response :unprocessable_content
+    assert_equal({ "default" => [ "must be true or false" ] }, json.dig("error", "details"))
+    assert_not GroupMembership.exists?(user: @owner)
+  end
+
+  test "staff list memberships by ID, filtered by group and user" do
+    a = add_member!(@billing, @agent)["id"]
+    b = add_member!(@support, @agent)["id"]
+    c = add_member!(@support, @owner)["id"]
+
+    [ @owner_token, @agent_token ].each do |token|
+      assert_equal [ a, b, c ], memberships(token: token).pluck("id")
+    end
+    assert_equal({ "count" => 3, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil },
+      json.except("group_memberships"))
+    assert_equal [ b, c ], memberships(group_id: @support["id"]).pluck("id")
+    assert_equal [ a, b ], memberships(user_id: @agent.id).pluck("id")
+    assert_equal [ c ], memberships(user_id: @owner.id, group_id: @support["id"].to_s).pluck("id")
+    assert_equal [], memberships(group_id: @sales["id"])
+    assert_equal [], memberships(user_id: 999_999_999)
+    assert_equal [], memberships(group_id: "99999999999999999999999")
+    assert_equal [ b ], memberships(per_page: 1, page: 2).pluck("id")
+
+    api :get, "/group_memberships/#{b}", token: @agent_token
+    assert_response :ok
+    assert_equal [ b, @support["id"], @agent.id, false ], json["group_membership"].values_at("id", "group_id", "user_id", "default")
+
+    { group_id: "billing", user_id: "-1" }.each do |name, value|
+      api :get, "/group_memberships?#{name}=#{value}", token: @agent_token
+      assert_response :unprocessable_content
+      assert_equal({ name.to_s => [ "must be an ID" ] }, json.dig("error", "details"))
+    end
+  end
+
+  test "only staff of the business join its groups, once each" do
+    register_customer
+    customer = User.find_by!(email: "avery@example.test")
+    sign_up_verified(subdomain: "globex", name: "Globex", email: "boss@globex.test")
+    outsider = User.find_by!(email: "boss@globex.test")
+
+    [ customer, outsider ].each do |user|
+      add_member(@billing, user)
+      assert_response :unprocessable_content
+      assert_equal({ "user_id" => [ "must be a staff member of this account" ] }, json.dig("error", "details"))
+    end
+
+    [ nil, 0, "abc", 1.5, 99999999999999999999999, Group.create!(account: outsider.account, name: "Theirs").id ].each do |id|
+      api :post, "/group_memberships", { group_membership: { group_id: id, user_id: @agent.id } }, token: @owner_token
+      assert_response :unprocessable_content, id.inspect
+      assert_equal({ "group_id" => [ "must be a group of this account" ] }, json.dig("error", "details"))
+    end
+
+    add_member!(@billing, @agent)
+    add_member(@billing, @agent, default: true)
+    assert_response :unprocessable_content
+    assert_equal({ "user_id" => [ "is already a member of this group" ] }, json.dig("error", "details"))
+    assert_equal 1, GroupMembership.count
+
+    api :post, "/group_memberships", { group_id: @billing["id"], user_id: @owner.id }, token: @owner_token
+    assert_response :bad_request
+  end
+
+  test "admins choose a staff member's default group" do
+    first = add_member!(@billing, @agent)
+    second = add_member!(@support, @agent)
+    owners = add_member!(@support, @owner)
+
+    api :put, "/group_memberships/#{second["id"]}/make_default", token: @owner_token
+    assert_response :ok
+    assert_equal [ second["id"], true ], json["group_membership"].values_at("id", "default")
+    assert_equal [ @support["id"] ], defaults(@agent)
+    assert_equal [ false, true, true ], memberships.pluck("default")
+
+    # Again changes nothing.
+    api :put, "/group_memberships/#{second["id"]}/make_default", token: @owner_token
+    assert_response :ok
+    assert_equal [ @support["id"] ], defaults(@agent)
+
+    api :put, "/group_memberships/#{first["id"]}/make_default", token: @agent_token
+    assert_response :forbidden
+    assert_equal [ @support["id"] ], defaults(@agent)
+    assert_equal [ @support["id"] ], defaults(@owner)
+    assert owners["default"]
+  end
+
+  test "removing the default membership makes the oldest remaining one the default" do
+    first = add_member!(@billing, @agent)
+    second = add_member!(@support, @agent)
+    third = add_member!(@sales, @agent)
+
+    api :delete, "/group_memberships/#{first["id"]}", token: @owner_token
+    assert_response :no_content
+    assert_equal [ [ second["id"], true ], [ third["id"], false ] ], memberships.map { |m| m.values_at("id", "default") }
+
+    # Removing one that isn't the default leaves the default alone.
+    api :delete, "/group_memberships/#{third["id"]}", token: @owner_token
+    assert_response :no_content
+    assert_equal [ @support["id"] ], defaults(@agent)
+
+    api :delete, "/group_memberships/#{second["id"]}", token: @owner_token
+    assert_response :no_content
+    assert_empty memberships
+
+    api :delete, "/group_memberships/#{second["id"]}", token: @owner_token
+    assert_response :not_found
+    api :get, "/group_memberships/#{second["id"]}", token: @owner_token
+    assert_response :not_found
+  end
+
+  test "removing a membership unassigns the staff member from the group's tickets only" do
+    add_member!(@billing, @agent)
+    add_member!(@support, @agent)
+    add_member!(@billing, @owner)
+    membership = GroupMembership.find_by!(group_id: @billing["id"], user: @agent)
+    customer_token = sign_in_new_customer
+    billing_ticket = open_request(customer_token, subject: "Refund")["id"]
+    owners_ticket = open_request(customer_token, subject: "Invoice")["id"]
+    support_ticket = open_request(customer_token, subject: "Login")["id"]
+    { billing_ticket => [ @billing, @agent ], owners_ticket => [ @billing, @owner ],
+      support_ticket => [ @support, @agent ] }.each do |id, (group, user)|
+      api :patch, "/tickets/#{id}", { ticket: { group_id: group["id"], assignee_id: user.id } }, token: @owner_token
+      assert_response :ok
+    end
+
+    api :delete, "/group_memberships/#{membership.id}", token: @owner_token
+    assert_response :no_content
+
+    assert_equal [ @billing["id"], nil ], Ticket.find(billing_ticket).values_at(:group_id, :assignee_id)
+    assert_equal [ @billing["id"], @owner.id ], Ticket.find(owners_ticket).values_at(:group_id, :assignee_id)
+    assert_equal [ @support["id"], @agent.id ], Ticket.find(support_ticket).values_at(:group_id, :assignee_id)
+  end
+
+  test "suspension keeps memberships for when the staff member is reinstated" do
+    add_member!(@billing, @agent)
+    add_member!(@support, @agent, default: true)
+    ticket = open_request(sign_in_new_customer)["id"]
+    api :patch, "/tickets/#{ticket}", { ticket: { assignee_id: @agent.id } }, token: @owner_token
+    assert_equal @support["id"], json.dig("ticket", "group_id")
+
+    api :patch, "/users/#{@agent.id}", { user: { suspended: true } }, token: @owner_token
+    assert_response :ok
+    # Unassigned, but the ticket stays in the group.
+    assert_equal [ @support["id"], nil ], Ticket.find(ticket).values_at(:group_id, :assignee_id)
+    assert_equal [ [ @billing["id"], false ], [ @support["id"], true ] ],
+      memberships(token: @owner_token, user_id: @agent.id).map { |m| m.values_at("group_id", "default") }
+
+    # Suspended staff can still be organised, but not assigned.
+    add_member!(@sales, @agent)
+    api :patch, "/tickets/#{ticket}", { ticket: { assignee_id: @agent.id } }, token: @owner_token
+    assert_response :unprocessable_content
+
+    api :patch, "/users/#{@agent.id}", { user: { suspended: false } }, token: @owner_token
+    assert_response :ok
+    assert_equal 3, memberships(token: @owner_token, user_id: @agent.id).size
+    api :patch, "/tickets/#{ticket}", { ticket: { assignee_id: @agent.id } }, token: @owner_token
+    assert_response :ok
+  end
+
+  test "only admins manage memberships; customers can't see them; other businesses' aren't found" do
+    membership = add_member!(@billing, @agent)
+
+    add_member(@support, @agent, token: @agent_token)
+    assert_response :forbidden
+    api :delete, "/group_memberships/#{membership["id"]}", token: @agent_token
+    assert_response :forbidden
+    assert_equal 1, GroupMembership.count
+
+    customer_token = sign_in_new_customer
+    [ "/group_memberships", "/group_memberships/#{membership["id"]}" ].each do |path|
+      api :get, path, token: customer_token
+      assert_response :forbidden
+    end
+
+    sign_up_verified(subdomain: "globex", name: "Globex", email: "boss@globex.test")
+    globex_token = sign_in(email: "boss@globex.test", account: "globex")
+    api :get, "/group_memberships", account: "globex", token: globex_token
+    assert_equal [], json["group_memberships"]
+    api :get, "/group_memberships/#{membership["id"]}", account: "globex", token: globex_token
+    assert_response :not_found
+    api :put, "/group_memberships/#{membership["id"]}/make_default", account: "globex", token: globex_token
+    assert_response :not_found
+    api :delete, "/group_memberships/#{membership["id"]}", account: "globex", token: globex_token
+    assert_response :not_found
+    assert_equal 1, GroupMembership.count
+  end
+end
diff --git a/test/integration/groups_test.rb b/test/integration/groups_test.rb
new file mode 100644
index 0000000..10ae5e8
--- /dev/null
+++ b/test/integration/groups_test.rb
@@ -0,0 +1,191 @@
+require "test_helper"
+
+class GroupsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_up_verified
+    @owner_token = sign_in
+    @owner = User.find_by!(email: "jo@acme.test")
+    @agent_token = sign_in_invited(@owner_token)
+    @agent = User.find_by!(email: "sam@example.test")
+  end
+
+  def create_group(name, token: @owner_token)
+    api :post, "/groups", { group: { name: name } }, token: token
+    assert_response :created
+    json.fetch("group")
+  end
+
+  def add_member(group, user, default: nil)
+    body = { group_id: group["id"], user_id: user.id }
+    body[:default] = default unless default.nil?
+    api :post, "/group_memberships", { group_membership: body }, token: @owner_token
+    assert_response :created
+    json.fetch("group_membership")
+  end
+
+  test "admins create, rename and delete groups; staff list them by ID" do
+    billing = create_group("  Billing ")
+    assert_equal({ "account_id" => @owner.account_id, "name" => "Billing" }, billing.slice("account_id", "name"))
+    assert billing["id"].present? && billing["created_at"].present? && billing["updated_at"].present?
+    support = create_group("Technical Support")
+
+    [ @owner_token, @agent_token ].each do |token|
+      api :get, "/groups", token: token
+      assert_response :ok
+      assert_equal [ billing["id"], support["id"] ], json["groups"].pluck("id")
+      assert_equal({ "count" => 2, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil },
+        json.except("groups"))
+
+      api :get, "/groups/#{billing["id"]}", token: token
+      assert_response :ok
+      assert_equal billing, json["group"]
+    end
+
+    api :patch, "/groups/#{billing["id"]}", { group: { name: "Billing & Refunds" } }, token: @owner_token
+    assert_response :ok
+    assert_equal [ billing["id"], "Billing & Refunds" ], json["group"].values_at("id", "name")
+    assert_equal "Billing & Refunds", Group.find(billing["id"]).name
+
+    api :delete, "/groups/#{billing["id"]}", token: @owner_token
+    assert_response :no_content
+    assert_not Group.exists?(billing["id"])
+    api :get, "/groups/#{billing["id"]}", token: @owner_token
+    assert_response :not_found
+    api :get, "/groups", token: @agent_token
+    assert_equal [ support["id"] ], json["groups"].pluck("id")
+  end
+
+  test "groups are paginated" do
+    ids = 3.times.map { |i| create_group("Group #{i}")["id"] }
+
+    api :get, "/groups?per_page=2&page=2", token: @agent_token
+    assert_response :ok
+    assert_equal [ ids.last ], json["groups"].pluck("id")
+    assert_equal({ "count" => 3, "page" => 2, "per_page" => 2, "next_page" => nil, "previous_page" => 1 },
+      json.except("groups"))
+  end
+
+  test "names are required and unique within the business, ignoring case" do
+    billing = create_group("Billing")
+
+    { "" => "can't be blank", "   " => "can't be blank", "x" * 101 => "is too long (maximum is 100 characters)",
+      "billing" => "has already been taken", " BILLING " => "has already been taken" }.each do |name, message|
+      api :post, "/groups", { group: { name: name } }, token: @owner_token
+      assert_response :unprocessable_content, name
+      assert_equal "validation_failed", json.dig("error", "code")
+      assert_equal({ "name" => [ message ] }, json.dig("error", "details"), name)
+    end
+    assert_equal 1, Group.count
+
+    support = create_group("Support")
+    api :patch, "/groups/#{support["id"]}", { group: { name: "BILLING" } }, token: @owner_token
+    assert_response :unprocessable_content
+    assert_equal({ "name" => [ "has already been taken" ] }, json.dig("error", "details"))
+    assert_equal "Support", Group.find(support["id"]).name
+
+    # Changing the case of its own name is fine.
+    api :patch, "/groups/#{billing["id"]}", { group: { name: "BILLING" } }, token: @owner_token
+    assert_response :ok
+    assert_equal "BILLING", json.dig("group", "name")
+
+    # Other businesses have their own names.
+    sign_up_verified(subdomain: "globex", name: "Globex", email: "boss@globex.test")
+    api :post, "/groups", { group: { name: "Billing" } }, account: "globex", token: sign_in(email: "boss@globex.test", account: "globex")
+    assert_response :created
+  end
+
+  test "a name taken by a concurrent request is a validation error" do
+    create_group("Billing")
+    group = @owner.account.groups.new(name: "billing")
+    # As if the other request committed after this one's validation.
+    group.define_singleton_method(:valid?) { |*| true }
+
+    assert_not group.save_reporting_conflicts
+    assert_equal [ "has already been taken" ], group.errors[:name]
+  end
+
+  test "the request needs a group envelope" do
+    api :post, "/groups", { name: "Billing" }, token: @owner_token
+    assert_response :bad_request
+    assert_equal "parameter_missing", json.dig("error", "code")
+
+    billing = create_group("Billing")
+    api :patch, "/groups/#{billing["id"]}", { group: {} }, token: @owner_token
+    assert_response :bad_request
+  end
+
+  test "only admins manage groups; agents browse them; customers can't see them" do
+    billing = create_group("Billing")
+
+    api :post, "/groups", { group: { name: "Support" } }, token: @agent_token
+    assert_response :forbidden
+    assert_equal "forbidden", json.dig("error", "code")
+    api :patch, "/groups/#{billing["id"]}", { group: { name: "Support" } }, token: @agent_token
+    assert_response :forbidden
+    api :delete, "/groups/#{billing["id"]}", token: @agent_token
+    assert_response :forbidden
+    assert_equal [ "Billing" ], Group.pluck(:name)
+
+    customer_token = sign_in_new_customer
+    [ "/groups", "/groups/#{billing["id"]}" ].each do |path|
+      api :get, path, token: customer_token
+      assert_response :forbidden
+    end
+
+    api :get, "/groups", token: nil
+    assert_response :unauthorized
+  end
+
+  test "other businesses' groups aren't found" do
+    billing = create_group("Billing")
+    sign_up_verified(subdomain: "globex", name: "Globex", email: "boss@globex.test")
+    globex_token = sign_in(email: "boss@globex.test", account: "globex")
+
+    api :get, "/groups", account: "globex", token: globex_token
+    assert_equal [], json["groups"]
+    api :get, "/groups/#{billing["id"]}", account: "globex", token: globex_token
+    assert_response :not_found
+    api :patch, "/groups/#{billing["id"]}", { group: { name: "Mine" } }, account: "globex", token: globex_token
+    assert_response :not_found
+    api :delete, "/groups/#{billing["id"]}", account: "globex", token: globex_token
+    assert_response :not_found
+    assert_equal "Billing", Group.find(billing["id"]).name
+  end
+
+  test "deleting a group returns its tickets to the queue and removes its memberships" do
+    billing = create_group("Billing")
+    support = create_group("Support")
+    add_member(billing, @agent)            # Sam's default
+    add_member(support, @agent)
+    add_member(support, @owner)
+    add_member(billing, @owner, default: true)
+
+    customer_token = sign_in_new_customer
+    in_billing = open_request(customer_token, subject: "Refund")["id"]
+    in_support = open_request(customer_token, subject: "Login")["id"]
+    elsewhere = open_request(customer_token, subject: "Other")["id"]
+    api :patch, "/tickets/#{in_billing}", { ticket: { group_id: billing["id"], assignee_id: @agent.id } }, token: @owner_token
+    assert_response :ok
+    api :patch, "/tickets/#{in_support}", { ticket: { group_id: support["id"], assignee_id: @agent.id } }, token: @owner_token
+    assert_response :ok
+    api :patch, "/tickets/#{elsewhere}", { ticket: { assignee_id: @agent.id, group_id: nil } }, token: @owner_token
+    assert_response :ok
+    before = Ticket.find(in_billing).updated_at
+
+    travel 1.minute do
+      api :delete, "/groups/#{billing["id"]}", token: @owner_token
+      assert_response :no_content
+    end
+
+    ticket = Ticket.find(in_billing)
+    assert_equal [ nil, nil ], [ ticket.group_id, ticket.assignee_id ]
+    assert ticket.updated_at > before
+    assert_equal [ support["id"], @agent.id ], Ticket.find(in_support).values_at(:group_id, :assignee_id)
+    assert_equal [ nil, @agent.id ], Ticket.find(elsewhere).values_at(:group_id, :assignee_id)
+
+    # Both lost their default, and Support (their only group left) took over.
+    api :get, "/group_memberships", token: @agent_token
+    assert_equal [ [ support["id"], @agent.id, true ], [ support["id"], @owner.id, true ] ],
+      json["group_memberships"].map { |m| m.values_at("group_id", "user_id", "default") }
+  end
+end
diff --git a/test/integration/inbound_email_test.rb b/test/integration/inbound_email_test.rb
