+  # Replace the default in-process memory cache store with a durable alternative.
+  # config.cache_store = :mem_cache_store
+
+  # Replace the default in-process and non-durable queuing backend for Active Job.
+  # Incoming email is routed by a job, so until a persistent backend is added,
+  # run `bin/rails helpdesk:process_inbound_emails` regularly to pick up any
+  # email whose job was lost in a restart (see README).
+  # config.active_job.queue_adapter = :resque
+
+  # Raw incoming emails are kept on local disk (HELPDESK_STORAGE_PATH, by
+  # default storage/) until they're incinerated. Use a persistent volume.
+  config.active_storage.service = :local
+
+  # Raise delivery errors so they get reported (see ApplicationMailer.deliver_safely);
