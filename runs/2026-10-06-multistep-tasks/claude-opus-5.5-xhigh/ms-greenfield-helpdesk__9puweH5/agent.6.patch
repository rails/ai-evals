index 0000000..3ca1b5f
--- /dev/null
+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,72 @@
+module Api
+  module V1
+    # Which staff belong to which groups. All staff can browse memberships;
+    # only admins add and remove them or choose a staff member's default
+    # group.
+    class GroupMembershipsController < BaseController
+      before_action :require_staff!
+      before_action :require_admin!, only: [ :create, :destroy, :make_default ]
+      before_action :set_membership, only: [ :show, :destroy, :make_default ]
+
+      # GET /api/v1/group_memberships?group_id=20&user_id=12
+      def index
+        memberships = Current.account.group_memberships.includes(:group, :user).order(:id)
+        if (group_id = id_filter(:group_id))
+          memberships = memberships.where(group_id: group_id)
+        end
+        if (user_id = id_filter(:user_id))
+          memberships = memberships.where(user_id: user_id)
+        end
+        render_page memberships, :group_memberships, GroupMembershipSerializer
+      end
+
+      # GET /api/v1/group_memberships/:id
+      def show
+        render json: { group_membership: GroupMembershipSerializer.call(@membership) }
+      end
+
+      # POST /api/v1/group_memberships - adds a staff member to a group. The
+      # first group they join becomes their default; "default": true makes
+      # a later one their default instead.
+      def create
+        attributes = params.expect(group_membership: [ :group_id, :user_id, :default ])
+        default = attributes[:default].nil? ? false : BOOLEANS.fetch(attributes[:default], nil)
+        return render_validation_errors("default" => [ "must be true or false" ]) if default.nil?
+
+        membership = GroupMembership.add(account: Current.account, group_id: attributes[:group_id],
+          user_id: attributes[:user_id], default: default)
+        if membership.persisted?
+          render json: { group_membership: GroupMembershipSerializer.call(membership) }, status: :created
+        else
+          render_validation_errors(membership.errors)
+        end
+      end
+
+      # PUT /api/v1/group_memberships/:id/make_default - makes this group the
+      # staff member's default (their previous default stops being one).
+      def make_default
+        @membership.make_default!
+        render json: { group_membership: GroupMembershipSerializer.call(@membership) }
+      rescue ActiveRecord::RecordNotFound
+        render_not_found(:group_membership)
+      end
+
+      # DELETE /api/v1/group_memberships/:id - unassigns the staff member
+      # from the group's tickets. If it was their default group, their
+      # oldest remaining membership becomes the default.
+      def destroy
+        @membership.remove!
+        head :no_content
+      rescue ActiveRecord::RecordNotFound
+        # Removed by someone else meanwhile.
+        render_not_found(:group_membership)
+      end
+
+      private
+        def set_membership
+          @membership = Current.account.group_memberships.includes(:group, :user).find_by(id: params[:id]) or
+            render_not_found(:group_membership)
+        end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/groups_controller.rb b/app/controllers/api/v1/groups_controller.rb
