+++ b/app/controllers/api/v1/groups_controller.rb
@@ -0,0 +1,56 @@
+module Api
+  module V1
+    # The business's groups (departments). All staff can browse them; only
+    # admins create, rename and delete them.
+    class GroupsController < BaseController
+      before_action :require_staff!
+      before_action :require_admin!, only: [ :create, :update, :destroy ]
+      before_action :set_group, only: [ :show, :update, :destroy ]
+
+      # GET /api/v1/groups
+      def index
+        render_page Current.account.groups.order(:id), :groups, GroupSerializer
+      end
+
+      # GET /api/v1/groups/:id
+      def show
+        render json: { group: GroupSerializer.call(@group) }
+      end
+
+      # POST /api/v1/groups
+      def create
+        group = Current.account.groups.new(name: params.expect(group: [ :name ])[:name])
+        if group.save_reporting_conflicts
+          render json: { group: GroupSerializer.call(group) }, status: :created
+        else
+          render_validation_errors(group.errors)
+        end
+      end
+
+      # PATCH /api/v1/groups/:id - renames the group.
+      def update
+        @group.name = params.expect(group: [ :name ])[:name]
+        if @group.save_reporting_conflicts
+          render json: { group: GroupSerializer.call(@group) }
+        else
+          render_validation_errors(@group.errors)
+        end
+      end
+
+      # DELETE /api/v1/groups/:id - its tickets lose their group and
+      # assignee, and its memberships go too (see Group).
+      def destroy
+        @group.destroy!
+        head :no_content
+      rescue ActiveRecord::RecordNotFound
+        # Deleted by someone else meanwhile.
+        render_not_found(:group)
+      end
+
+      private
+        def set_group
+          @group = Current.account.groups.find_by(id: params[:id]) or render_not_found(:group)
+        end
+    end
+  end
+end
