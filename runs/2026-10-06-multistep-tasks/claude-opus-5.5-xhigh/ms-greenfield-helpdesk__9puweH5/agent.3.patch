+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,24 @@
+module Api
+  module V1
+    # POST /api/v1/invitation_acceptances - the invitee chooses their name and
+    # password and joins the business. The emailed link verified their
+    # address, so they can sign in straight away.
+    class InvitationAcceptancesController < BaseController
+      allow_unauthenticated_access
+
+      def create
+        attributes = params.expect(invitation_acceptance: [ :token, :name, :password, :password_confirmation ])
+        acceptance = InvitationAcceptance.new(token: attributes[:token], name: attributes[:name],
+          password: attributes[:password], password_confirmation: attributes[:password_confirmation],
+          account: Current.account)
+
+        if acceptance.save
+          user = acceptance.user
+          render json: { user: UserSerializer.call(user), account: AccountSerializer.call(user.account) }, status: :created
+        else
+          render_validation_errors(acceptance.errors)
+        end
+      end
+    end
+  end
+end
