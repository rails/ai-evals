new file mode 100644
index 0000000..ff1d49b
--- /dev/null
+++ b/app/models/invitation_acceptance.rb
@@ -0,0 +1,44 @@
+# Accepting an invitation through its emailed link: creates the invited
+# staff member with the name and password they chose. Their email address is
+# verified, since the link was emailed to it.
+class InvitationAcceptance
+  include FormErrors
+
+  attr_reader :invitation, :user, :errors
+
+  # +account+ is the business named by the request, if any; the token must
+  # belong to it.
+  def initialize(token:, name:, password:, password_confirmation: nil, account: nil)
+    @token = token.to_s
+    @name = name
+    @password = password
+    @password_confirmation = password_confirmation
+    @account = account
+    @errors = {}
+  end
+
+  # Raises Invitation::InvalidToken or Account::Cancelled if the invitation
+  # can't be accepted; returns false (with +errors+) for invalid details.
+  def save(now: Time.current)
+    @invitation = Invitation.find_acceptable!(@token, account: @account, now: now)
+
+    Invitation.transaction do
+      # Same lock order as resending (address, then invitation), and check
+      # again: it may have been accepted, revoked or resent meanwhile.
+      User.lock_email!(invitation.account_id, invitation.email)
+      invitation.lock!
+      invitation.ensure_acceptable!(@token, now: now)
+
+      @user = invitation.account.users.new(role: invitation.role, email: invitation.email,
+        name: @name, password: @password, email_verified_at: now)
+      user.password_confirmation = @password_confirmation unless @password_confirmation.nil?
+      unless user.save
+        @errors = collect_errors(user.errors, except: [ :account ])
+        raise ActiveRecord::Rollback
+      end
+
+      invitation.update!(accepted_at: now, user: user)
+    end
+    errors.empty?
+  end
+end
