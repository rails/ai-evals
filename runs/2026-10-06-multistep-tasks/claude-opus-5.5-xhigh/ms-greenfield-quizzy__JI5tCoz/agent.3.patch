@@ -0,0 +1,40 @@
+require "test_helper"
+
+class ScreenChannelTest < ActionCable::Channel::TestCase
+  setup do
+    @game = quizzes(:frontend).games.create!
+  end
+
+  test "a big screen subscribes with the signed game id and gets the live numbers" do
+    stub_connection browser_key_digest: nil
+    subscribe game: @game.signed_id(purpose: :screen)
+
+    assert subscription.confirmed?
+    assert_equal [ { "version" => 0, "players" => 0, "answers" => 0, "type" => "status" } ], transmissions
+  end
+
+  test "pushes only changes" do
+    stub_connection browser_key_digest: nil
+    subscribe game: @game.signed_id(purpose: :screen)
+
+    subscription.send(:push_status)
+    assert_equal 1, transmissions.size
+
+    @game.players.create!(name: "Ada", browser_key: "a" * 32).connections.create!(seen_at: Time.current)
+    subscription.send(:push_status)
+    assert_equal 1, transmissions.last["players"]
+
+    @game.advance("start", version: 0)
+    subscription.send(:push_status)
+    assert_equal 1, transmissions.last["version"]
+    assert_equal 3, transmissions.size
+  end
+
+  test "plain or wrongly signed ids are rejected" do
+    stub_connection browser_key_digest: nil
+    [ @game.id, @game.signed_id, @game.signed_id(purpose: :other), "" ].each do |id|
+      subscribe game: id
+      assert subscription.rejected?, id.inspect
+    end
+  end
+end
