+<%# The big screen. Rendered on the server for the current step; the
+    moderator's buttons post and come back here. screen_controller.js keeps
+    the numbers live and, in any other window showing this game, follows the
+    steps (it fetches this page again when the version changes). %>
+<%= tag.main class: [ "cover", "cover--blue", "cover--calm", "stage", "stage--#{@game.status}" ],
+      data: { controller: "screen", screen_game_value: @game.signed_id(purpose: :screen),
+              screen_version_value: @game.version, screen_status_url_value: moderate_game_status_path(@game),
+              action: "submit->screen#leave keydown@document->screen#shortcut" } do %>
+  <div class="screen">
+    <div class="screen__top">
+      <%= logo "screen__logo" %>
+      <% if @game.answering? || @game.results? %>
+        <span class="screen__join"><span class="screen__join-label">Join at</span> <%= join_link_text(@game) %></span>
+      <% end %>
+    </div>
+
+    <div class="screen__body">
+      <%= render "moderate/games/#{@game.status}", game: @game, round: @game.current_round, status: status %>
+    </div>
+  </div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to moderate_quiz_path(@quiz) do %><span aria-hidden="true">←</span> Quiz page<% end %>
+      <% if @game.answering? || @game.results? %>
+        <span class="answers-counter" role="status">Answers: <strong data-screen-target="answers"><%= status[:answers] %></strong> / <span data-screen-target="players"><%= status[:players] %></span></span>
+      <% end %>
+    </div>
+    <div class="buttons">
+      <% case @game.status %>
+      <% when "lobby" %>
+        <%= render "moderate/games/step", game: @game, event: "start", label: "Start" %>
+      <% when "answering" %>
+        <%= render "moderate/games/step", game: @game, event: "finish", label: "Finish" %>
+      <% when "results" %>
+        <% if @game.last_question? %>
+          <%= render "moderate/games/step", game: @game, event: "end", label: "End quiz" %>
+        <% else %>
+          <%= render "moderate/games/step", game: @game, event: "next", label: "Next" %>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+<% end %>
