+# A tap on an option. Answers go over plain HTTP, not the socket: the
+# response says what the server saved, so the phone only marks "Your answer"
+# once it's stored, and retries on flaky Wi-Fi are safe (the same pick
+# again changes nothing).
+class Play::AnswersController < Play::BaseController
+  before_action :require_player, :no_store
+
+  def create
+    result = @game.record_answer(current_player, round_id: params[:round], option_id: params[:option])
+    answer = Answer.find_by(round_id: params[:round], player_id: current_player.id)
+
+    render status: { saved: :ok, closed: :conflict, invalid: :unprocessable_content }.fetch(result), json: {
+      result: result,
+      answer: answer && { round: answer.round_id, option: answer.option_id },
+      state: @game.public_state
+    }
+  end
+end
diff --git a/app/controllers/play/base_controller.rb b/app/controllers/play/base_controller.rb
