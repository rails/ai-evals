+require "test_helper"
+
+class Play::GamesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @game = quizzes(:frontend).games.create!
+  end
+
+  test "the join link asks for a name, without any account" do
+    get play_path(@game.code)
+    assert_response :success
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_select "h1", "Frontend Fest 2026"
+    assert_select "form[action=?]", play_player_path(@game.code) do
+      assert_select "label[for=player_name]", "Your name"
+      assert_select "input#player_name[maxlength='30']"
+      assert_select "button[type=submit]", "Join"
+    end
+  end
+
+  test "codes work in lower case too" do
+    get play_path(@game.code.downcase)
+    assert_select "button", "Join"
+  end
+
+  test "joining greets the player, and the browser stays that player" do
+    assert_difference -> { @game.players.count } do
+      post play_player_path(@game.code), params: { player: { name: "  Alice " } }
+    end
+    assert_redirected_to play_path(@game.code)
+    key = cookies[PlayerIdentity::COOKIE]
+    assert_match(/\A[A-Za-z0-9]{32}\z/, key)
+    assert_equal @game.players.find_by_browser_key(key), @game.players.last
+
+    follow_redirect!
+    assert_select "[data-controller=play]"
+    sync = JSON.parse(css_select("[data-controller=play]").first["data-play-sync-value"])
+    assert_equal({ "type" => "sync", "state" => { "version" => 0, "status" => "lobby" }, "player" => { "name" => "Alice" }, "answer" => nil }, sync)
+    assert_select "form", count: 0
+
+    # The same browser opens the link again, or posts the form again.
+    get play_path(@game.code)
+    assert_select "[data-controller=play]"
+    assert_no_difference -> { Player.count } do
+      post play_player_path(@game.code), params: { player: { name: "Mallory" } }
+    end
+    assert_equal [ "Alice" ], @game.players.pluck(:name)
+  end
+
+  test "the same browser in another game is a new player there" do
+    post play_player_path(@game.code), params: { player: { name: "Alice" } }
+    other = quizzes(:frontend).games.create!
+
+    get play_path(other.code)
+    assert_select "button", "Join"
+    post play_player_path(other.code), params: { player: { name: "Alice" } }
+    assert_equal 1, other.players.count
+    assert_equal @game.players.first.browser_key_digest, other.players.first.browser_key_digest
+  end
+
+  test "a name is required" do
+    assert_no_difference -> { Player.count } do
+      post play_player_path(@game.code), params: { player: { name: "   " } }
+    end
+    assert_response :unprocessable_content
+    assert_select ".errors", "Type a name first."
+    assert_select "label", "Your name"
+    assert_no_match(/your name/i, css_select(".errors").text)
+  end
+
+  test "players can join during the game" do
+    @game.advance("start", version: 0)
+    post play_player_path(@game.code), params: { player: { name: "Late" } }
+    follow_redirect!
+    sync = JSON.parse(css_select("[data-controller=play]").first["data-play-sync-value"])
+    assert_equal "answering", sync.dig("state", "status")
+    assert_equal questions(:http).body, sync.dig("state", "question", "text")
+  end
+
+  test "while a question is open, the page has no trace of the correct answer" do
+    post play_player_path(@game.code), params: { player: { name: "Alice" } }
+    @game.advance("start", version: 0)
+
+    get play_path(@game.code)
+    assert_includes response.body, "429"
+    assert_no_match(/correct/i, response.body)
+
+    @game.advance("finish", version: 1)
+    get play_path(@game.code)
+    assert_match(/&quot;correct&quot;:\[#{option_fixture(:http_429).id}\]/, response.body)
+  end
+
+  test "after the end nobody can join" do
+    @game.update!(status: "over")
+
+    get play_path(@game.code)
+    assert_select "h1", "The quiz is over"
+    assert_select "form", count: 0
+    assert_select "input", count: 0
+
+    assert_no_difference -> { Player.count } do
+      post play_player_path(@game.code), params: { player: { name: "Too late" } }
+    end
+    assert_redirected_to play_path(@game.code)
+  end
+
+  test "players of a game that ended see it ended" do
+    post play_player_path(@game.code), params: { player: { name: "Alice" } }
+    @game.update!(status: "over")
+    get play_path(@game.code)
+    sync = JSON.parse(css_select("[data-controller=play]").first["data-play-sync-value"])
+    assert_equal "over", sync.dig("state", "status")
+  end
+
+  test "an unknown code is 404" do
+    get play_path("NOPE1")
+    assert_response :not_found
+    assert_select "h1", "Game not found"
+
+    post play_player_path("NOPE1"), params: { player: { name: "Alice" } }
+    assert_response :not_found
+  end
+
+  test "a tampered cookie is just ignored" do
+    cookies[PlayerIdentity::COOKIE] = "<script>"
+    get play_path(@game.code)
+    assert_select "button", "Join"
+    post play_player_path(@game.code), params: { player: { name: "Alice" } }
+    assert_match(/\A[A-Za-z0-9]{32}\z/, cookies[PlayerIdentity::COOKIE])
+  end
+end
diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..a6b9c36
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,201 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+
+  setup do
+    @quiz = quizzes(:frontend)
+    @game = @quiz.games.create!
+  end
+
+  test "a new game waits in the lobby with a fresh 5-character code" do
+    assert @game.lobby?
+    assert_equal 0, @game.version
+    assert_match(/\A[A-HJ-NP-Z2-9]{5}\z/, @game.code)
+    assert_not_equal @game.code, @quiz.games.create!.code
+  end
+
+  test "codes are found in any case and with stray spaces" do
+    assert_equal @game, Game.find_by_code(" #{@game.code.downcase} ")
+    assert_nil Game.find_by_code("")
+    assert_nil Game.find_by_code(nil)
+  end
+
+  test "plays the active questions in order, skipping inactive ones" do
+    assert_equal 2, @game.question_total
+
+    assert @game.advance("start", version: 0)
+    assert @game.answering?
+    assert_equal questions(:http), @game.current_round.question
+    assert_equal({ round: @game.current_round.id, number: 1, total: 2 }, @game.public_state[:question].slice(:round, :number, :total))
+    assert_not @game.last_question?
+
+    assert @game.advance("finish", version: 1)
+    assert @game.results?
+    assert @game.current_round.closed_at
+
+    assert @game.advance("next", version: 2)
+    assert_equal questions(:websocket), @game.current_round.question
+    assert_equal 2, @game.public_state[:question][:number]
+    assert @game.last_question?
+
+    assert @game.advance("finish", version: 3)
+    assert @game.advance("end", version: 4)
+    assert @game.over?
+    assert @game.ended_at
+    assert_equal [ questions(:http), questions(:websocket) ], @game.rounds.map(&:question)
+    assert_nil @game.public_state[:question]
+  end
+
+  test "steps only apply to the version they were made for, in the right status" do
+    assert_not @game.advance("finish", version: 0), "can't finish in the lobby"
+    assert_not @game.advance("next", version: 0)
+    assert_not @game.advance("end", version: 0)
+    assert_not @game.advance("jump", version: 0)
+    assert @game.advance("start", version: 0)
+
+    assert_not @game.advance("start", version: 0), "a repeated click"
+    assert_not @game.advance("finish", version: 0), "a stale page"
+    assert_equal 1, @game.reload.version
+    assert_equal 1, @game.rounds.count
+
+    assert @game.advance("finish", version: 1)
+    assert_not @game.advance("finish", version: 2), "already finished"
+    assert @game.advance("next", version: 2)
+    assert_not @game.advance("next", version: 2), "a double click on Next must not skip a question"
+    assert_equal 2, @game.reload.rounds.count
+  end
+
+  test "can't start without active questions" do
+    game = quizzes(:empty).games.create!
+    assert_nil game.upcoming_question
+    assert_not game.advance("start", version: 0)
+    assert game.reload.lobby?
+  end
+
+  test "questions switched off, added or deleted during a game are followed" do
+    @game.advance("start", version: 0)
+    @game.advance("finish", version: 1)
+
+    questions(:css).update!(active: true)
+    assert_equal 3, @game.question_total
+    questions(:websocket).update!(active: false)
+    assert_equal 2, @game.question_total
+
+    @game.advance("next", version: 2)
+    assert_equal questions(:css), @game.current_round.question
+    assert_equal 2, @game.public_state[:question][:number]
+
+    questions(:css).destroy
+    assert_nil @game.reload.current_round.question
+    assert_equal({ number: 2, total: 2, text: "", options: [] }, @game.public_state[:question].except(:round))
+    assert @game.advance("finish", version: 3)
+    assert_equal [], @game.answer_counts
+  end
+
+  test "Next on the last question ends the game" do
+    @game.advance("start", version: 0)
+    @game.advance("finish", version: 1)
+    questions(:websocket).update!(active: false)
+
+    assert @game.advance("next", version: 2)
+    assert @game.over?
+  end
+
+  test "every step is broadcast to the game's stream" do
+    messages = capture_broadcasts(@game.stream_name) { @game.advance("start", version: 0) }
+
+    assert_equal [ { "type" => "state", "state" => {
+      "version" => 1, "status" => "answering",
+      "question" => { "round" => @game.current_round.id, "number" => 1, "total" => 2, "text" => questions(:http).body,
+        "options" => [ { "id" => option_fixture(:http_418).id, "title" => "418" }, { "id" => option_fixture(:http_429).id, "title" => "429" },
+          { "id" => option_fixture(:http_503).id, "title" => "503" } ] } } } ], messages
+    assert_no_broadcasts(@game.stream_name) { @game.advance("start", version: 0) }
+    assert_broadcasts(@game.stream_name, 1) { @game.advance("finish", version: 1) }
+  end
+
+  test "the public state reveals the correct options only after the question is closed" do
+    @game.advance("start", version: 0)
+    open = @game.public_state.to_json
+    assert_not_includes open, "correct"
+    assert_not_includes open, "true"
+
+    @game.advance("finish", version: 1)
+    assert_equal [ option_fixture(:http_429).id ], @game.public_state[:correct]
+  end
+
+  test "answers: the last pick counts until the question is closed" do
+    alice = join("Alice")
+    @game.advance("start", version: 0)
+    round = @game.current_round
+
+    assert_equal :saved, @game.record_answer(alice, round_id: round.id, option_id: option_fixture(:http_418).id)
+    assert_equal :saved, @game.record_answer(alice, round_id: round.id, option_id: option_fixture(:http_429).id)
+    assert_equal [ option_fixture(:http_429) ], round.answers.map(&:option)
+
+    assert_equal :invalid, @game.record_answer(alice, round_id: round.id, option_id: option_fixture(:websocket_ws).id)
+    assert_equal :closed, @game.record_answer(alice, round_id: round.id + 1, option_id: option_fixture(:http_418).id)
+
+    @game.advance("finish", version: 1)
+    assert_equal :closed, @game.record_answer(alice, round_id: round.id, option_id: option_fixture(:http_418).id)
+    assert_equal [ option_fixture(:http_429) ], round.answers.reload.map(&:option)
+  end
+
+  test "no answers in the lobby or after the end" do
+    alice = join("Alice")
+    assert_equal :closed, @game.record_answer(alice, round_id: 1, option_id: option_fixture(:http_418).id)
+  end
+
+  test "answer counts per option, in option order" do
+    @game.advance("start", version: 0)
+    round = @game.current_round
+    { "Alice" => :http_429, "Bob" => :http_429, "Carol" => :http_503 }.each do |name, option|
+      @game.record_answer(join(name), round_id: round.id, option_id: option_fixture(option).id)
+    end
+    @game.advance("finish", version: 1)
+
+    assert_equal [ [ "418", 0 ], [ "429", 2 ], [ "503", 1 ] ], @game.answer_counts.map { |option, count| [ option.title, count ] }
+  end
+
+  test "the screen counts the players currently in the game and the answers to the open question" do
+    alice, bob, carol = join("Alice"), join("Bob"), join("Carol")
+    alice.connections.create!(seen_at: Time.current)
+    bob.connections.create!(seen_at: 2.minutes.ago) # silent socket: gone
+    carol.update!(polled_at: 5.seconds.ago)          # no socket, polls over HTTP
+
+    assert_equal({ version: 0, players: 2, answers: 0 }, @game.screen_status)
+
+    @game.advance("start", version: 0)
+    @game.record_answer(bob, round_id: @game.current_round.id, option_id: option_fixture(:http_418).id)
+    assert_equal({ version: 1, players: 2, answers: 1 }, @game.screen_status)
+
+    carol.update!(polled_at: 1.minute.ago)
+    alice.connections.delete_all
+    assert_equal 0, @game.screen_status[:players]
+  end
+
+  test "a player with two open tabs counts once" do
+    alice = join("Alice")
+    2.times { alice.connections.create!(seen_at: Time.current) }
+    assert_equal 1, @game.screen_status[:players]
+  end
+
+  test "deleting the quiz deletes its games" do
+    alice = join("Alice")
+    @game.advance("start", version: 0)
+    @game.record_answer(alice, round_id: @game.current_round.id, option_id: option_fixture(:http_418).id)
+
+    assert_difference -> { Game.count } => -1, -> { Player.count } => -1, -> { Round.count } => -1, -> { Answer.count } => -1 do
+      @quiz.destroy!
+    end
+  end
+
+  private
+    def join(name)
+      @game.players.create!(name: name, browser_key: SecureRandom.alphanumeric(32))
+    end
+
+    def option_fixture(name)
+      options(name)
+    end
+end
diff --git a/test/models/player_test.rb b/test/models/player_test.rb
new file mode 100644
index 0000000..6647936
--- /dev/null
+++ b/test/models/player_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class PlayerTest < ActiveSupport::TestCase
+  setup do
+    @game = quizzes(:frontend).games.create!
+  end
+
+  test "names are squished, required and short" do
+    assert_equal "Ada Lovelace", @game.players.create!(name: "  Ada \n  Lovelace ", browser_key: "k" * 32).name
+    assert_not @game.players.build(name: "   ", browser_key: "x" * 32).valid?
+    assert_not @game.players.build(name: "x" * 31, browser_key: "x" * 32).valid?
+    assert @game.players.build(name: "x" * 30, browser_key: "x" * 32).valid?
+  end
+
+  test "keeps only the digest of the browser key, and is found by the key" do
+    key = SecureRandom.alphanumeric(32)
+    player = @game.players.create!(name: "Ada", browser_key: key)
+
+    assert_equal OpenSSL::Digest::SHA256.hexdigest(key), player.browser_key_digest
+    assert_not_includes player.attributes.values.map(&:to_s), key
+    assert_equal player, @game.players.find_by_browser_key(key)
+    assert_nil @game.players.find_by_browser_key("other")
+    assert_nil @game.players.find_by_browser_key(nil)
+    assert_nil quizzes(:frontend).games.create!.players.find_by_browser_key(key), "players belong to one game"
+  end
+
+  test "one player per browser and game" do
+    @game.players.create!(name: "Ada", browser_key: "k" * 32)
+    assert_raises(ActiveRecord::RecordNotUnique) { @game.players.create!(name: "Bob", browser_key: "k" * 32) }
+  end
+
+  test "the sync payload has the state, the name and the answer to the current question" do
+    player = @game.players.create!(name: "Ada", browser_key: "k" * 32)
+    assert_equal({ type: "sync", state: { version: 0, status: "lobby" }, player: { name: "Ada" }, answer: nil }, player.sync_payload)
+
+    @game.advance("start", version: 0)
+    round = @game.current_round
+    @game.record_answer(player, round_id: round.id, option_id: options(:http_503).id)
+    assert_equal({ round: round.id, option: options(:http_503).id }, player.reload.sync_payload[:answer])
+
+    @game.advance("finish", version: 1)
+    @game.advance("next", version: 2)
+    assert_nil player.reload.sync_payload[:answer]
+  end
+end
diff --git a/test/system/games_test.rb b/test/system/games_test.rb
new file mode 100644
index 0000000..5ba35ac
--- /dev/null
+++ b/test/system/games_test.rb
@@ -0,0 +1,172 @@
+require "application_system_test_case"
+
+# A live game: the big screen in the default session (moderator), players in
+# sessions of their own (separate browsers). Nothing is reloaded by hand:
+# every change below reaches the other browsers live.
+class GamesTest < ApplicationSystemTestCase
+  setup do
+    @previous_wait = Capybara.default_max_wait_time
+    Capybara.default_max_wait_time = 6
+  end
+
+  teardown do
+    Capybara.default_max_wait_time = @previous_wait
+  end
+
+  test "a whole game: lobby, questions, results and the end" do
+    visit moderate_quiz_path(quizzes(:frontend))
+    click_on "Start a game"
+
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_selector ".qr svg"
+    assert_text "Players: 0"
+    link = join_link
+    assert_match %r{\A127\.0\.0\.1:\d+/play/[A-Z0-9]{5}\z}, link
+
+    join_as :alice, "Alice", link
+    assert_text "Players: 1"
+    join_as :bob, "Bob", link
+    assert_text "Players: 2"
+
+    click_on "Start"
+    assert_text "Question 1 of 2"
+    assert_text questions(:http).body
+    assert_text "Answers: 0 / 2"
+
+    using_session(:alice) do
+      assert_text "Question 1 of 2"
+      assert_text questions(:http).body
+      click_on "418"
+      assert_selector "button", text: /418.*Your answer/m
+      click_on "429"
+      assert_selector "button", text: /429.*Your answer/m
+      assert_selector "button", text: "Your answer", count: 1
+    end
+    assert_text "Answers: 1 / 2"
+
+    click_on "Finish"
+    assert_selector "li.stage-option.is-correct", text: /429.*Correct.*1 answer/m
+    assert_selector "li.stage-option", text: /418.*0 answers/m
+    assert_text "Correct", count: 1
+    using_session(:alice) { assert_text "Correct!" }
+    using_session(:bob) { assert_text "No answer" }
+
+    click_on "Next"
+    assert_text "Question 2 of 2"
+    using_session(:bob) do
+      assert_text "Question 2 of 2"
+      click_on "SMTP"
+      assert_selector "button", text: /SMTP.*Your answer/m
+    end
+    assert_text "Answers: 1 / 2"
+
+    click_on "Finish"
+    assert_no_button "Next"
+    using_session(:bob) { assert_text "Wrong!" }
+    using_session(:alice) { assert_text "No answer" }
+
+    click_on "End quiz"
+    assert_text "The quiz is over"
+    using_session(:alice) { assert_text "The quiz is over" }
+    using_session(:bob) { assert_text "The quiz is over" }
+
+    using_session(:carol) do
+      visit "http://#{link}"
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+  end
+
+  test "the counters follow players coming and going, and a browser stays the same player" do
+    game = quizzes(:frontend).games.create!
+    visit moderate_game_path(game)
+    link = join_link
+
+    join_as :alice, "Alice", link
+    join_as :bob, "Bob", link
+    assert_text "Players: 2"
+
+    using_session(:bob) { visit "about:blank" } # Bob closes the page
+    assert_text "Players: 1"
+
+    click_on "Start"
+    assert_text "Answers: 0 / 1"
+
+    using_session(:bob) do # Bob opens the join link again: still Bob, no new player
+      visit "http://#{link}"
+      assert_no_field "Your name"
+      click_on "503"
+      assert_selector "button", text: /503.*Your answer/m
+    end
+    assert_text "Answers: 1 / 2"
+    assert_equal 2, game.players.count
+
+    using_session(:bob) do
+      visit "http://#{link}" # a reload keeps the answer
+      assert_selector "button", text: /503.*Your answer/m
+    end
+
+    join_as :carol, "Carol", link, expect: questions(:http).body # joins mid-question
+    assert_text "Answers: 1 / 3"
+  end
+
+  test "the join form turns into the end when the game ends" do
+    game = quizzes(:frontend).games.create!
+    visit moderate_game_path(game)
+    link = join_link
+
+    using_session(:dana) do
+      visit "http://#{link}"
+      assert_field "Your name"
+    end
+
+    click_on "Start"
+    click_on "Finish"
+    click_on "Next"
+    click_on "Finish"
+    click_on "End quiz"
+    assert_text "The quiz is over"
+
+    using_session(:dana) do
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+    end
+  end
+
+  test "a second big screen window follows the game without reloading" do
+    game = quizzes(:frontend).games.create!
+    visit moderate_game_path(game)
+
+    using_session(:second_screen) do
+      page.driver.basic_authorize(ENV["QUIZZY_MODERATOR_USERNAME"], ENV["QUIZZY_MODERATOR_PASSWORD"])
+      visit moderate_game_path(game)
+      assert_button "Start"
+      execute_script "window.notReloaded = true"
+    end
+
+    click_on "Start"
+    using_session(:second_screen) do
+      assert_text "Question 1 of 2"
+      assert_button "Finish"
+      assert evaluate_script("window.notReloaded")
+      click_on "Finish"
+    end
+    assert_text "Correct"
+    assert_button "Next"
+  end
+
+  private
+    def join_link
+      find(".lobby__url").text
+    end
+
+    def join_as(session, name, link, expect: "Hi, #{name}!")
+      using_session(session) do
+        visit "http://#{link}"
+        fill_in "Your name", with: name
+        click_on "Join"
+        assert_text expect
+      end
+    end
+end
