@@ -0,0 +1,11 @@
+# The public game state for pages without a player: the join form switches
+# to "The quiz is over" when the game ends. No presence tracking.
+class GameChannel < ApplicationCable::Channel
+  def subscribed
+    game = Game.find_by_code(params[:code])
+    return reject unless game
+
+    stream_from game.stream_name
+    transmit({ type: "state", state: game.public_state })
+  end
+end
diff --git a/app/channels/player_channel.rb b/app/channels/player_channel.rb
new file mode 100644
index 0000000..f4d5bf1
--- /dev/null
+++ b/app/channels/player_channel.rb
@@ -0,0 +1,39 @@
+# A player's phone. Streams the public game state, and tracks the player's
+# presence: one PlayerConnection per subscription, refreshed by the phone's
+# "heartbeat" every PlayerConnection::HEARTBEAT_INTERVAL.
+#
+# On every (re)subscription the phone gets a full "sync" first, so a phone
+# that lost its connection catches up with whatever it missed.
+class PlayerChannel < ApplicationCable::Channel
+  def subscribed
+    game = Game.find_by_code(params[:code])
+    @player = game && connection.browser_key_digest &&
+      game.players.find_by(browser_key_digest: connection.browser_key_digest)
+    return reject unless @player
+
+    stream_from game.stream_name
+    @presence = @player.connections.create!(seen_at: Time.current)
+    transmit @player.sync_payload
+  end
+
+  def unsubscribed
+    PlayerConnection.where(id: @presence.id).delete_all if @presence
+  end
+
+  def heartbeat
+    touch_presence
+  end
+
+  # The phone asks for a fresh sync (it came back to the foreground).
+  def sync
+    touch_presence
+    player = Player.includes(:game).find_by(id: @player.id) # fresh game state, not the one from subscribing
+    transmit player.sync_payload if player
+  end
+
+  private
+    def touch_presence
+      updated = PlayerConnection.where(id: @presence.id).update_all(seen_at: Time.current)
+      @presence = @player.connections.create!(seen_at: Time.current) if updated.zero?
+    end
+end
diff --git a/app/channels/screen_channel.rb b/app/channels/screen_channel.rb
new file mode 100644
index 0000000..e2cd4f7
--- /dev/null
+++ b/app/channels/screen_channel.rb
@@ -0,0 +1,27 @@
+# A big screen. Authorized by the signed game id its page was rendered with
+# (the moderator area is behind HTTP Basic auth, sockets aren't).
+#
+# Pushes the live numbers (players currently in the game, answers to the
+# open question) and the game version. They are recomputed every second
+# and sent when they change, which also catches players whose sockets went
+# silent and so dropped out of Player.online without any event.
+class ScreenChannel < ApplicationCable::Channel
+  periodically :push_status, every: 1.second
+
+  def subscribed
+    @game = Game.find_signed(params[:game].to_s, purpose: :screen)
+    return reject unless @game
+
+    push_status
+  end
+
+  private
+    def push_status
+      game = Game.find_by(id: @game.id)
+      status = game ? game.screen_status : { gone: true }
+      return if status == @last_status
+
+      @last_status = status
+      transmit status.merge(type: "status")
+    end
+end
diff --git a/app/controllers/concerns/player_identity.rb b/app/controllers/concerns/player_identity.rb
new file mode 100644
index 0000000..e036ace
--- /dev/null
+++ b/app/controllers/concerns/player_identity.rb
@@ -0,0 +1,29 @@
+# Remembers players by browser. On the first join the browser gets a random
+# key in a permanent cookie; players store only its SHA-256 (Player.digest).
+# ApplicationCable::Connection reads the same cookie.
+#
+# The cookie is HttpOnly and SameSite=Lax, so other sites can't use it (not
+# in forms, not in WebSocket handshakes). It isn't signed on purpose: a
+# random 32-character key can't be guessed, and an unsigned cookie survives
+# a change of SECRET_KEY_BASE.
+module PlayerIdentity
+  extend ActiveSupport::Concern
+
+  COOKIE = "quizzy_player"
+
+  def self.valid_key?(key)
+    key.is_a?(String) && key.match?(/\A[A-Za-z0-9]{32}\z/)
+  end
+
+  private
+    def browser_key
+      key = cookies[COOKIE]
+      key if PlayerIdentity.valid_key?(key)
+    end
+
+    def browser_key!
+      browser_key || SecureRandom.alphanumeric(32).tap do |key|
+        cookies.permanent[COOKIE] = { value: key, httponly: true, same_site: :lax }
+      end
+    end
+end
