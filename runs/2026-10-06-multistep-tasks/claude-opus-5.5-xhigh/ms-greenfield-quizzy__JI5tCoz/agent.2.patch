index 20cd84f..c87cbd1 100644
--- a/app/models/quiz.rb
+++ b/app/models/quiz.rb
@@ -11,4 +11,31 @@ class Quiz < ApplicationRecord
   def active_questions
     questions.select(&:active?)
   end
+
+  # The quiz's contents in quiz JSON (docs/quiz-json.md), which QuizImport
+  # reads back: exactly the title and the questions with their options, in
+  # order, always with "active" and "correct". Nothing else (no ids, no
+  # timestamps): the export only moves contents.
+  def export_data
+    {
+      "title" => title,
+      "questions" => questions.includes(:options).map do |question|
+        {
+          "text" => question.body,
+          "active" => question.active?,
+          "options" => question.options.map { |option| { "text" => option.title, "correct" => option.correct? } }
+        }
+      end
+    }
+  end
+
+  # #export_data as indented JSON, one option per line, like the example in
+  # docs/quiz-json.md.
+  def export_json
+    data = export_data
+    data["questions"].each do |question|
+      question["options"].map! { |option| JSON::Fragment.new(JSON.generate(option, space: " ", object_nl: " ")) }
+    end
+    JSON.pretty_generate(data)
+  end
 end
diff --git a/app/models/quiz_import.rb b/app/models/quiz_import.rb
new file mode 100644
index 0000000..eac7b00
--- /dev/null
+++ b/app/models/quiz_import.rb
@@ -0,0 +1,161 @@
+# Creates a new quiz from quiz JSON, the format Quiz#export_data writes
+# (docs/quiz-json.md):
+#
+#   { "title": "…",
+#     "questions": [ { "text": "…", "active": true,
+#                      "options": [ { "text": "…", "correct": false } ] } ] }
+#
+# "active" (default true) and "correct" (default false) are optional; the
+# other keys are required. Unknown keys are ignored. Questions follow the
+# question form's rules, applied by the same code (Question#option_rows= and
+# its validations): blank options are skipped, at least two options, at least
+# one correct.
+#
+# All or nothing: #save checks everything first, collects every problem in
+# #errors (messages say which question and option they are about), and only
+# then creates the quiz and all its questions in one transaction. It always
+# creates a new quiz, also when one with the same title exists.
+class QuizImport
+  include ActiveModel::Model
+  include ActiveModel::Attributes
+
+  BYTE_ORDER_MARK = "\uFEFF"
+
+  attribute :json, :string
+
+  # The created quiz, once #save succeeded.
+  attr_reader :quiz
+
+  def save
+    errors.clear
+    @quiz = nil
+
+    quiz = build_quiz
+    return false if errors.any?
+
+    quiz.save!
+    @quiz = quiz
+    true
+  end
+
+  private
+    # The unsaved quiz with its questions; nil when the JSON can't be used at
+    # all. Every problem found is added to #errors.
+    def build_quiz
+      data = parse
+      return if errors.any? # unreadable; `null` is readable, but not a quiz
+      return add_error(:root_not_an_object) unless data.is_a?(Hash)
+
+      quiz = Quiz.new
+      if (title = string_field(data, "title"))
+        quiz.title = title
+        # Before any question is built: Quiz#valid? would validate those too.
+        copy_errors(quiz, { title: "title" })
+      end
+
+      if (items = array_field(data, "questions"))
+        items.each.with_index(1) { |item, number| build_question(quiz, item, number) }
+      end
+
+      quiz
+    end
+
+    # The parsed JSON. Parser messages quote the input, so errors only tell
+    # where the problem is.
+    def parse
+      text = json.to_s.delete_prefix(BYTE_ORDER_MARK)
+      return add_error(:empty) if text.blank?
+
+      JSON.parse(text)
+    rescue JSON::ParserError => error
+      if error.line.nil? # e.g. nested too deep
+        add_error(:syntax)
+      elsif (key = error.message[/\Aduplicate key (".*") at line/, 1])
+        add_error(:duplicate_key, key: key.truncate(40), line: error.line, column: error.column)
+      else
+        add_error(:syntax_at, line: error.line, column: error.column)
+      end
+    end
+
+    def build_question(quiz, item, number)
+      at = { question: number }
+      return add_error(:question_not_an_object, at:) unless item.is_a?(Hash)
+
+      text = string_field(item, "text", at:)
+      active = boolean_field(item, "active", default: true, at:)
+      option_rows = option_rows(item, at:)
+      return if [ text, active, option_rows ].any?(&:nil?)
+
+      question = quiz.questions.build(body: text, active: active, position: number, option_rows: option_rows)
+      copy_errors(question, { body: "text" }, at:)
+    end
+
+    # The question's options as rows for Question#option_rows=; nil when any
+    # of them is malformed.
+    def option_rows(item, at:)
+      options = array_field(item, "options", at:)
+      return if options.nil?
+
+      rows = options.map.with_index(1) do |option, number|
+        option_at = at.merge(option: number)
+        next add_error(:option_not_an_object, at: option_at) unless option.is_a?(Hash)
+
+        text = string_field(option, "text", at: option_at)
+        correct = boolean_field(option, "correct", default: false, at: option_at)
+        { title: text, correct: correct } unless text.nil? || correct.nil?
+      end
+
+      rows unless rows.include?(nil)
+    end
+
+    # Field readers: the value, or nil (after adding an error) when the key
+    # is missing or holds the wrong type.
+    def string_field(hash, key, at: {})
+      field(hash, key, :not_a_string, at:) { |value| value.is_a?(String) }
+    end
+
+    def array_field(hash, key, at: {})
+      field(hash, key, :not_an_array, at:) { |value| value.is_a?(Array) }
+    end
+
+    def boolean_field(hash, key, default:, at: {})
+      return default unless hash.key?(key)
+
+      field(hash, key, :not_a_boolean, at:) { |value| value == true || value == false }
+    end
+
+    def field(hash, key, wrong_type, at:)
+      if !hash.key?(key)
+        add_error(:missing, key: key, at:)
+      elsif yield(hash[key])
+        hash[key]
+      else
+        add_error(wrong_type, key: key, at:)
+      end
+    end
+
+    # Copies a record's validation errors. `keys` maps attributes to the
+    # JSON keys they come from, so messages name what the moderator typed.
+    def copy_errors(record, keys, at: {})
+      return if record.valid?
+
+      record.errors.each do |error|
+        key = keys[error.attribute]
+        message = key ? "\"#{key}\" #{error.message}" : error.full_message
+        errors.add(:base, located(message, **at))
+      end
+    end
+
+    # Adds the message `kind` (config/locales/en.yml) and returns nil.
+    def add_error(kind, at: {}, **details)
+      errors.add(:base, located(I18n.t(kind, scope: "quiz_import.errors", **details), **at))
+      nil
+    end
+
+    # "Question 2: …", "Question 2, option 3: …", or the message as is.
+    def located(message, question: nil, option: nil)
+      return message unless question
+
+      I18n.t(option ? :option : :question, scope: "quiz_import.location", question:, option:, message:)
+    end
+end
