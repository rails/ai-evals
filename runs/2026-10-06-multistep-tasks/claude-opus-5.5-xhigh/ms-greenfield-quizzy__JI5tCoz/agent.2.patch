+    assert_equal "{\n  \"title\": \"Empty quiz\",\n  \"questions\": []\n}", quizzes(:empty).export_json
+  end
+
+  test "the JSON keeps special characters intact" do
+    quiz = Quiz.create!(title: "Ünïcode <b>&</b> \"quoted\" \\ 🎉")
+    quiz.questions.create!(body: "Line one\nline two", option_rows: [ { title: "\t<script>", correct: "1" }, { title: "Ω" } ])
+
+    assert_equal quiz.export_data, JSON.parse(quiz.export_json)
+  end
+end
