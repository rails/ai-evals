+require "test_helper"
+
+class Moderate::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "the quiz page links to the export" do
+    get moderate_quiz_path(quizzes(:frontend)), headers: moderator_auth
+
+    assert_select "a[href=?]", moderate_quiz_export_path(quizzes(:frontend)), text: "Export"
+  end
+
+  test "shows the quiz JSON in the page's only <pre>" do
+    get moderate_quiz_export_path(quizzes(:frontend)), headers: moderator_auth
+
+    assert_response :success
+    assert_select "pre", 1
+    assert_select "pre" do |(pre)|
+      assert_equal quizzes(:frontend).export_json, pre.text
+      assert_equal quizzes(:frontend).export_data, JSON.parse(pre.text)
+    end
+    assert_select "a[href=?]", moderate_quiz_path(quizzes(:frontend))
+  end
+
+  test "escapes the quiz's contents in the page" do
+    quiz = Quiz.create!(title: "</pre><script>alert(1)</script>")
+
+    get moderate_quiz_export_path(quiz), headers: moderator_auth
+
+    assert_select "script", text: /alert/, count: 0
+    assert_select "pre", 1
+    assert_equal "</pre><script>alert(1)</script>", JSON.parse(css_select("pre").first.text)["title"]
+  end
+
+  test "is also served as a JSON file" do
+    get moderate_quiz_export_path(quizzes(:frontend), format: :json), headers: moderator_auth
+
+    assert_response :success
+    assert_equal "application/json", response.media_type
+    assert_equal quizzes(:frontend).export_data, response.parsed_body
+  end
+
+  test "an unknown quiz is not found" do
+    get moderate_quiz_export_path(quiz_id: 0), headers: moderator_auth
+
+    assert_response :not_found
+  end
+end
