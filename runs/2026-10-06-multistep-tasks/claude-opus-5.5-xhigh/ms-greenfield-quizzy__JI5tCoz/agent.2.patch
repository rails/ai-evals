+    selectContents(source)
+
+    var copied = function () { showCopied(button) }
+    if (navigator.clipboard && window.isSecureContext) {
+      navigator.clipboard.writeText(source.textContent).then(copied, function () {
+        if (copySelection()) copied()
+      })
+    } else if (copySelection()) {
+      copied()
+    }
+  })
