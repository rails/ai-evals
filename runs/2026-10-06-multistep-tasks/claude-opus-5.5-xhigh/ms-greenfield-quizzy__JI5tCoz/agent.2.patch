+# Shows a quiz as quiz JSON (Quiz#export_json), ready to copy into the
+# import page of this or another Quizzy. Also served as a .json file.
+class Moderate::ExportsController < Moderate::BaseController
+  before_action :set_quiz
+
+  def show
+    @json = @quiz.export_json
+
+    respond_to do |format|
+      format.html
+      format.json { render json: @json }
+    end
+  end
+end
