+  <div class="field">
+    <%= form.label :json, "Quiz JSON" %>
+    <%= form.text_area :json, class: "input input--code", rows: 16, autofocus: true,
+          spellcheck: false, autocomplete: "off", autocapitalize: "off",
+          aria: { required: true, describedby: "import_json_hint" } %>
