@@ -0,0 +1,55 @@
+require "application_system_test_case"
+
+class ExportImportTest < ApplicationSystemTestCase
+  test "exporting a quiz and importing it as a new one" do
+    visit moderate_quiz_path(quizzes(:frontend))
+    click_on "Export"
+
+    assert_selector "pre", count: 1
+    json = find("pre").text
+    assert_equal quizzes(:frontend).export_data, JSON.parse(json)
+
+    visit moderate_root_path
+    click_on "Import quiz"
+    fill_in "Quiz JSON", with: json
+    click_on "Import"
+
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_equal [ "Which HTTP status code means \"Too Many Requests\"?",
+      "Which protocol keeps a two-way connection between a browser and a server?", "What does CSS stand for?" ], question_order
+    assert_no_current_path moderate_quiz_path(quizzes(:frontend))
+    within(question_item("What does CSS stand for?")) { assert_no_checked_field "Active" }
+
+    click_on "All quizzes"
+    assert_selector "li", text: "Frontend Fest 2026", count: 2
+  end
+
+  test "an invalid import shows the error and creates nothing" do
+    visit moderate_root_path
+    click_on "Import quiz"
+    fill_in "Quiz JSON", with: { title: "Broken", questions: [
+      { text: "Fine", options: [ { text: "A", correct: true }, { text: "B" } ] },
+      { text: "No correct option", options: [ { text: "A" }, { text: "B" } ] }
+    ] }.to_json
+    click_on "Import"
+
+    assert_text "Question 2: Mark at least one option as correct"
+    assert_field "Quiz JSON", with: /No correct option/
+
+    fill_in "Quiz JSON", with: "{ not json"
+    click_on "Import"
+    assert_text "This isn't valid JSON (line 1, column 3)"
+
+    click_on "All quizzes"
+    assert_no_text "Broken"
+  end
+
+  test "copying the export" do
+    visit moderate_quiz_export_path(quizzes(:frontend))
+    click_on "Copy JSON"
+
+    assert_button "Copied ✓"
+    assert_equal find("pre").text, page.evaluate_script("window.getSelection().toString()")
+    assert_button "Copy JSON", wait: 5
+  end
+end
