+              inputmode: "numeric", autocomplete: "off", aria: { describedby: "timer-hint" } %>
+      </div>
+    </div>
+    <span class="field-hint" id="timer-hint">Time per question. The big screen counts down and the question finishes by itself at 0:00. Leave both at 0 for no timer.</span>
+  </div>
+
+  <%= render "moderate/shared/errors", record: quiz %>
+
+  <div class="buttons">
+    <%= form.button "Save quiz", class: "btn btn--pink" %>
+    <%= link_to "Cancel", quiz.persisted? ? moderate_quiz_path(quiz) : moderate_root_path, class: "btn btn--ghost" %>
