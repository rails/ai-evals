+++ b/test/channels/connection_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class ApplicationCable::ConnectionTest < ActionCable::Connection::TestCase
+  test "identifies players by the digest of their cookie" do
+    key = SecureRandom.alphanumeric(32)
+    cookies[PlayerIdentity::COOKIE] = key
+    connect
+    assert_equal Player.digest(key), connection.browser_key_digest
+  end
+
+  test "big screens and join pages connect without a player cookie" do
+    connect
+    assert_nil connection.browser_key_digest
+  end
+
+  test "malformed cookies are ignored" do
+    cookies[PlayerIdentity::COOKIE] = "not a key"
+    connect
+    assert_nil connection.browser_key_digest
+  end
+end
