@@ -0,0 +1,26 @@
+require "test_helper"
+require "capybara/cuprite"
+
+class ApplicationSystemTestCase < ActionDispatch::SystemTestCase
+  driven_by :cuprite, screen_size: [ 1280, 900 ], options: {
+    headless: true,
+    js_errors: true,
+    process_timeout: 30,
+    timeout: 15,
+    browser_options: { "no-sandbox": nil }
+  }
+
+  setup do
+    page.driver.basic_authorize(ENV["QUIZZY_MODERATOR_USERNAME"], ENV["QUIZZY_MODERATOR_PASSWORD"])
+  end
+
+  private
+    # The <li> of the question with this text on the quiz page.
+    def question_item(text)
+      find("li.question-item", text: text)
+    end
+
+    def question_order
+      all("li.question-item .question-item__body").map(&:text)
+    end
+end
