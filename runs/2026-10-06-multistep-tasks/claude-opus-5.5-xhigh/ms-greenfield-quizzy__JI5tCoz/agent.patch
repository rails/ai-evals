diff --git a/test/system/prizes_test.rb b/test/system/prizes_test.rb
new file mode 100644
index 0000000..876b43a
--- /dev/null
+++ b/test/system/prizes_test.rb
@@ -0,0 +1,131 @@
+require "application_system_test_case"
+
+# Scores and prizes, end to end: the big screen in the default session,
+# players in sessions of their own. Nothing is reloaded by hand.
+class PrizesTest < ApplicationSystemTestCase
+  setup do
+    @previous_wait = Capybara.default_max_wait_time
+    Capybara.default_max_wait_time = 6
+  end
+
+  teardown do
+    Capybara.default_max_wait_time = @previous_wait
+  end
+
+  test "the number of winners is a quiz setting" do
+    visit edit_moderate_quiz_path(quizzes(:frontend))
+    assert_field "Number of winners", with: "3"
+    fill_in "Number of winners", with: "0"
+    click_on "Save quiz"
+    assert_text "Number of winners must be greater than or equal to 1"
+
+    fill_in "Number of winners", with: "2"
+    click_on "Save quiz"
+    assert_selector "h1", text: "Frontend Fest 2026"
+    click_on "Settings"
+    assert_field "Number of winners", with: "2"
+  end
+
+  test "leaderboard, places on the phones, and winners that update live" do
+    quizzes(:frontend).update!(winners_count: 2)
+    visit moderate_quiz_path(quizzes(:frontend))
+    click_on "Start a game"
+    link = find(".lobby__url").text
+    %w[ Alice Bob Carol Dave ].each { |name| join_as name, link }
+    assert_text "Players: 4"
+
+    click_on "Start"
+    pick :alice, "429"
+    pick :bob, "429"
+    pick :carol, "418"
+    using_session(:alice) { assert_no_text "point" } # no points during the game
+    click_on "Finish"
+    using_session(:bob) { assert_text "Correct!" }
+    click_on "Next"
+    pick :alice, "WebSocket"
+    pick :bob, "SMTP"
+    sleep 1.5 # Carol is slow: Bob's one point came faster
+    pick :carol, "WebSocket"
+    click_on "Finish"
+    using_session(:carol) do
+      assert_text "Correct!"
+      assert_no_text "point"
+    end
+
+    click_on "End quiz"
+    assert_text "The quiz is over"
+    assert_equal [ "1 Alice 2 points", "2 Bob 1 point", "3 Carol 1 point", "4 Dave 0 points" ], leaderboard
+    assert_no_text "Winner"
+
+    { alice: [ 1, "2 points" ], bob: [ 2, "1 point" ], carol: [ 3, "1 point" ], dave: [ 4, "0 points" ] }.each do |player, (place, points)|
+      using_session(player) do
+        assert_text "The quiz is over"
+        assert_text "Place #{place} of 4"
+        assert_text points
+        assert_no_text "You won!"
+      end
+    end
+
+    big_screen = current_url
+    using_session(:second_screen) do
+      page.driver.basic_authorize(ENV["QUIZZY_MODERATOR_USERNAME"], ENV["QUIZZY_MODERATOR_PASSWORD"])
+      visit big_screen
+      assert_selector "li", count: 4
+      execute_script "window.notReloaded = true"
+    end
+
+    click_on "Top 2"
+    assert_selector "li", text: /Alice.*Winner/m
+    assert_selector "li", text: /Bob.*Winner/m
+    assert_selector "li", text: "Winner", count: 2
+    using_session(:alice) { assert_text "You won!" }
+    using_session(:bob) { assert_text "You won!" }
+    using_session(:carol) { assert_no_text "You won!" }
+    using_session(:second_screen) do
+      assert_selector "li", text: "Winner", count: 2
+      assert evaluate_script("window.notReloaded")
+    end
+
+    drawn = 12.times.map do
+      click_on "Draw"
+      assert_selector "li", text: /Alice.*Winner/m
+      assert_selector "li", text: "Winner", count: 2
+      assert_no_selector "li", text: /Dave.*Winner/m
+      find("li", text: /(Bob|Carol).*Winner/m).text[/Bob|Carol/]
+    end
+    assert_equal %w[ Bob Carol ], drawn.uniq.sort, "the tied 1-point players are drawn at random"
+
+    click_on "Reset winners"
+    assert_no_text "Winner"
+    using_session(:alice) do
+      assert_no_text "You won!"
+      assert_text "Place 1 of 4"
+    end
+    using_session(:second_screen) do # followed every change, without a reload
+      assert_no_selector "li", text: "Winner"
+      assert evaluate_script("window.notReloaded")
+    end
+  end
+
+  private
+    def join_as(name, link)
+      using_session(name.downcase.to_sym) do
+        visit "http://#{link}"
+        fill_in "Your name", with: name
+        click_on "Join"
+        assert_text "Hi, #{name}!"
+      end
+    end
+
+    def pick(player, option)
+      using_session(player) do
+        assert_selector "button", text: option
+        click_on option
+        assert_selector "button", text: /#{option}.*Your answer/m
+      end
+    end
+
+    def leaderboard
+      all("ol.leaderboard > li").map { |item| item.text.squish }
+    end
+end
diff --git a/test/system/questions_test.rb b/test/system/questions_test.rb
new file mode 100644
index 0000000..5876eb6
--- /dev/null
+++ b/test/system/questions_test.rb
@@ -0,0 +1,107 @@
+require "application_system_test_case"
+
+class QuestionsTest < ApplicationSystemTestCase
+  test "adding a question: rules, rows and the Active switch" do
+    visit moderate_quiz_path(quizzes(:empty))
+    click_on "Add question"
+
+    (1..4).each do |number|
+      assert_field "Option #{number}", with: ""
+      assert_unchecked_field "Option #{number} is correct"
+    end
+    assert_no_field "Option 5"
+    assert_checked_field "Active"
+
+    fill_in "Question", with: "Which planet is the largest?"
+    fill_in "Option 2", with: "Jupiter"
+    check "Option 2 is correct"
+    click_on "Add option"
+    assert_field "Option 5", with: ""
+    assert_unchecked_field "Option 5 is correct"
+    uncheck "Active"
+    click_on "Save question"
+
+    assert_text "Add at least two options"
+    assert_field "Question", with: "Which planet is the largest?"
+    assert_field "Option 1", with: ""
+    assert_field "Option 2", with: "Jupiter"
+    assert_checked_field "Option 2 is correct"
+    assert_field "Option 5", with: ""
+    assert_unchecked_field "Active"
+
+    fill_in "Option 5", with: "Saturn"
+    uncheck "Option 2 is correct"
+    click_on "Save question"
+    assert_text "Mark at least one option as correct"
+    assert_no_text "Add at least two options"
+    assert_field "Option 5", with: "Saturn"
+
+    check "Option 2 is correct"
+    check "Active"
+    click_on "Save question"
+
+    assert_selector "h1", text: "Empty quiz"
+    within question_item("Which planet is the largest?") do
+      assert_selector ".is-correct", text: "Jupiter"
+      assert_text "Saturn"
+      assert_checked_field "Active"
+    end
+  end
+
+  test "removing a row renumbers the others" do
+    visit new_moderate_quiz_question_path(quizzes(:empty))
+    fill_in "Option 3", with: "Third"
+    click_on "Remove option 2"
+
+    assert_field "Option 2", with: "Third"
+    assert_no_field "Option 4"
+    click_on "Add option"
+    assert_field "Option 4", with: ""
+  end
+
+  test "editing a question" do
+    visit moderate_quiz_path(quizzes(:frontend))
+    within(question_item("Which protocol")) { click_on "Edit" }
+
+    assert_field "Option 1", with: "WebSocket"
+    assert_checked_field "Option 1 is correct"
+    fill_in "Question", with: "Which protocol is two-way?"
+    fill_in "Option 2", with: ""
+    fill_in "Option 3", with: "Long polling"
+    fill_in "Option 4", with: "Server-sent events"
+    click_on "Save question"
+
+    within question_item("Which protocol is two-way?") do
+      assert_text "WebSocket"
+      assert_text "Long polling"
+      assert_no_text "SMTP"
+    end
+  end
+
+  test "ordering, switching and deleting questions on the quiz page" do
+    visit moderate_quiz_path(quizzes(:frontend))
+    http, websocket, css = questions(:http, :websocket, :css).map(&:body)
+    assert_equal [ http, websocket, css ], question_order
+
+    within(question_item(websocket)) { click_on "Move up" }
+    assert_equal [ websocket, http, css ], question_order
+    within(question_item(websocket)) { click_on "Move down" }
+    assert_equal [ http, websocket, css ], question_order
+    within(question_item(css)) { click_on "Move up" }
+    assert_equal [ http, css, websocket ], question_order
+
+    within(question_item(css)) { check "Active" }
+    within(question_item(css)) { assert_checked_field "Active" }
+    assert questions(:css).reload.active?
+    within(question_item(http)) { uncheck "Active" }
+    within(question_item(http)) { assert_unchecked_field "Active" }
+    assert_not questions(:http).reload.active?
+    assert_selector "li.question-item--inactive", text: http
+
+    dismiss_confirm("Delete this question?") { within(question_item(websocket)) { click_on "Delete" } }
+    assert_selector "li.question-item", text: websocket
+    accept_confirm { within(question_item(websocket)) { click_on "Delete" } }
+    assert_no_selector "li.question-item", text: websocket
+    assert_equal [ http, css ], question_order
+  end
+end
