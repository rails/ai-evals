+class Moderate::QuestionsController < Moderate::BaseController
+  # New questions start with this many (empty) option rows.
+  BLANK_ROWS = 4
+
+  before_action :set_quiz, only: %i[ new create ]
+  before_action :set_question, only: %i[ edit update destroy ]
+
+  def new
+    @question = @quiz.questions.new
+    @option_rows = Array.new(BLANK_ROWS) { Option.new }
+  end
+
+  def create
+    @question = @quiz.questions.new(question_params)
+
+    if @question.save
+      redirect_to moderate_quiz_path(@quiz), notice: "Question added."
+    else
+      @option_rows = @question.option_rows
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+    @option_rows = @question.options.to_a
+    @option_rows += Array.new([ BLANK_ROWS - @option_rows.size, 0 ].max) { Option.new }
+  end
+
+  def update
+    if @question.update(question_params)
+      redirect_to moderate_quiz_path(@quiz), notice: "Question saved."
+    else
+      @option_rows = @question.option_rows
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @question.destroy!
+    redirect_to moderate_quiz_path(@quiz), notice: "Question deleted.", status: :see_other
+  end
+
+  private
+    def set_question
+      @question = Question.find(params[:id])
+      @quiz = @question.quiz
+    end
+
+    # The form always posts its complete list of option rows; no rows at all
+    # (every row removed) means no options.
+    def question_params
+      params.expect(question: [ :body, :active, option_rows: [ [ :id, :title, :correct ] ] ]).to_h.tap do |permitted|
+        permitted[:option_rows] ||= {}
+      end
+    end
+end
