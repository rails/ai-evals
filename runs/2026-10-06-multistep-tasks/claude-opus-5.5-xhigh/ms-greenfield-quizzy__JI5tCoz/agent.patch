index 0000000..c25ffce
--- /dev/null
+++ b/test/controllers/moderate/game_timer_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+# The timer on the big screen and what the phones get. The browser side
+# (ticking, finishing at 0:00 without clicks) is in test/system/timer_test.rb.
+class Moderate::GameTimerTest < ActionDispatch::IntegrationTest
+  setup do
+    freeze_time # whole seconds: `travel` drops the fractions
+    @quiz = quizzes(:frontend)
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    @game = @quiz.games.create!
+  end
+
+  test "while a question is open the big screen counts down in M:SS from the full time" do
+    step "start"
+    assert_select ".stage-question__num", "Question 1 of 2"
+    assert_select "[role=timer]", count: 1
+    assert_select ".stage-timer[role=timer][aria-label='Time left'][data-screen-target=timer][data-remaining-ms='90000']", "1:30"
+    assert_select "button", text: "Finish"
+
+    travel 30.seconds
+    get moderate_game_path(@game), headers: moderator_auth
+    assert_select ".stage-timer[data-remaining-ms='60000']", "1:00"
+  end
+
+  test "reloading the page doesn't restart the countdown" do
+    step "start"
+    travel 10.5.seconds, with_usec: true
+    get moderate_game_path(@game), headers: moderator_auth
+    assert_select ".stage-timer[data-remaining-ms='79500']", "1:20" # rounded up: the 80th second is still running
+
+    travel 75.seconds
+    get moderate_game_path(@game), headers: moderator_auth
+    assert_select ".stage-timer.is-ending", "0:05"
+  end
+
+  test "without a timer there is no countdown" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    step "start"
+    assert_select "[role=timer]", count: 0
+    assert_select ".stage-timer", count: 0
+
+    travel 1.hour
+    get moderate_game_path(@game), headers: moderator_auth
+    assert_select "button", text: "Finish"
+  end
+
+  test "no countdown in the lobby" do
+    get moderate_game_path(@game), headers: moderator_auth
+    assert_select "[role=timer]", count: 0
+  end
+
+  test "at 0:00 the question is finished: the page shows the results and the countdown stopped at 0:00" do
+    step "start"
+    travel 90.seconds
+    get moderate_game_path(@game), headers: moderator_auth
+
+    assert @game.reload.results?
+    assert_equal 2, @game.version
+    assert_select "[data-screen-version-value='2']"
+    assert_select ".stage-option.is-correct .stage-option__mark", "Correct"
+    assert_select "button", text: "Next"
+    assert_select "button", text: "Finish", count: 0
+    assert_select ".stage-timer.stage-timer--stopped[role=timer]", "0:00"
+    assert_select "[data-screen-target=timer]", count: 0 # not ticking any more
+
+    step "next" # the next question gets the full time again
+    assert_select ".stage-timer", "1:30"
+  end
+
+  test "after an early Finish the countdown is gone" do
+    step "start"
+    travel 20.seconds
+    step "finish"
+    assert_select "button", text: "Next"
+    assert_select "[role=timer]", count: 0
+  end
+
+  test "the status fallback also finishes a question whose time is up" do
+    step "start"
+    travel 91.seconds
+    get moderate_game_status_path(@game), headers: moderator_auth
+    assert_equal 2, response.parsed_body["version"]
+    assert @game.reload.results?
+  end
+
+  test "the countdown is the only time on the screen, also when the join link has a port" do
+    host! "127.0.0.1:3000"
+    step "start"
+    text = Nokogiri::HTML(response.body).at("body").text
+    assert_equal [ "1:30" ], text.scan(/\d:\d\d/)
+    assert_select ".screen__join", text: "Join at 127.0.0.1:\u20603000/play/#{@game.code}"
+  end
+
+  test "the lobby's join link is plain text" do
+    host! "127.0.0.1:3000"
+    get moderate_game_path(@game), headers: moderator_auth
+    assert_select ".lobby__url", "127.0.0.1:3000/play/#{@game.code}"
+  end
+
+  test "phones never see the timer, and learn about 0:00 like about Finish" do
+    post play_player_path(@game.code), params: { player: { name: "Alice" } }
+    step "start"
+
+    get play_path(@game.code)
+    assert_response :success
+    assert_no_match(/1:30|1:29|timer|closes|remaining|deadline/i, response.body)
+
+    get play_state_path(@game.code), as: :json
+    assert_equal "answering", response.parsed_body.dig("state", "status")
+    assert_no_match(/timer|closes|remaining|deadline/i, response.body)
+
+    travel 90.seconds
+    get play_state_path(@game.code), as: :json
+    assert_equal "results", response.parsed_body.dig("state", "status")
+    assert response.parsed_body.dig("state", "correct").present?
+  end
+
+  test "an answer that arrives after 0:00 is too late" do
+    post play_player_path(@game.code), params: { player: { name: "Alice" } }
+    step "start"
+    round = @game.reload.current_round
+
+    travel 89.seconds
+    post play_answer_path(@game.code), params: { round: round.id, option: option_fixture(:http_418).id }, as: :json
+    assert_response :success
+
+    travel 1.second
+    post play_answer_path(@game.code), params: { round: round.id, option: option_fixture(:http_429).id }, as: :json
+    assert_response :conflict
+    assert_equal "closed", response.parsed_body["result"]
+    assert_equal({ "round" => round.id, "option" => option_fixture(:http_418).id }, response.parsed_body["answer"])
+    assert_equal "results", response.parsed_body.dig("state", "status")
+  end
+
+  private
+    def step(event)
+      patch moderate_game_progress_path(@game), params: { event: event, version: @game.reload.version }, headers: moderator_auth
+      assert_redirected_to moderate_game_path(@game)
+      follow_redirect! headers: moderator_auth
+      assert_response :success
+    end
+end
diff --git a/test/controllers/moderate/games_controller_test.rb b/test/controllers/moderate/games_controller_test.rb
new file mode 100644
index 0000000..e088156
--- /dev/null
+++ b/test/controllers/moderate/games_controller_test.rb
@@ -0,0 +1,251 @@
+require "test_helper"
+
+class Moderate::GamesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = quizzes(:frontend)
+  end
+
+  test "the quiz page has the Start a game button" do
+    get moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_select "form[action=?][method=post] button", moderate_quiz_games_path(@quiz), text: "Start a game"
+    assert_select "#games-heading", count: 0
+  end
+
+  test "Start a game creates a game and opens its big screen" do
+    assert_difference -> { @quiz.games.count } do
+      post moderate_quiz_games_path(@quiz), headers: moderator_auth
+    end
+    game = @quiz.games.last
+    assert_redirected_to moderate_game_path(game)
+    assert game.lobby?
+  end
+
+  test "each start is a new game, listed on the quiz page" do
+    2.times { post moderate_quiz_games_path(@quiz), headers: moderator_auth }
+    first, second = @quiz.games.order(:id).to_a
+    first.players.create!(name: "Ada", browser_key: "k" * 32)
+
+    get moderate_quiz_path(@quiz), headers: moderator_auth
+    assert_select "table.runs-table tbody tr", 2
+    assert_select "tr##{dom_id(first)}", text: /#{first.code}.*1.*Waiting/m do
+      assert_select "a[href=?]", moderate_game_path(first), text: "Open big screen"
+    end
+    assert_select "tr##{dom_id(second)} a[href=?]", moderate_game_path(second)
+  end
+
+  test "the lobby shows the title, the join link as text, its QR code and the players count" do
+    game = @quiz.games.create!
+    game.players.create!(name: "Ada", browser_key: "a" * 32).connections.create!(seen_at: Time.current)
+    game.players.create!(name: "Bob", browser_key: "b" * 32) # joined, but not connected any more
+
+    get moderate_game_path(game), headers: moderator_auth
+    assert_response :success
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_select "h1", @quiz.title
+    assert_select ".lobby__url", "www.example.com/play/#{game.code}"
+    assert_select ".qr svg[role=img][aria-label]"
+    assert_no_match(/<\?xml/, response.body)
+    assert_select ".counter-pill", "Players: 1"
+    assert_select "button", text: "Start", count: 1
+    assert_select "button", count: 1
+    assert_select "[data-controller=screen][data-screen-version-value='0'][data-screen-game-value]"
+  end
+
+  test "the QR code holds the full join URL" do
+    game = @quiz.games.create!
+    get moderate_game_path(game), headers: moderator_auth
+
+    expected = RQRCode::QRCode.new("http://www.example.com/play/#{game.code}", level: :m).as_svg(
+      module_size: 8, offset: 32, color: "000", fill: "fff", shape_rendering: "crispEdges", use_path: true, viewbox: true)
+    path = expected[/<path[^>]*d="([^"]+)"/, 1]
+    assert_includes response.body, path
+  end
+
+  test "the big screen walks through the game" do
+    game = @quiz.games.create!
+    ada = game.players.create!(name: "Ada", browser_key: "a" * 32)
+    ada.connections.create!(seen_at: Time.current)
+    game.players.create!(name: "Bob", browser_key: "b" * 32).connections.create!(seen_at: Time.current)
+
+    step game, "start"
+    assert_select ".stage-question__num", "Question 1 of 2"
+    assert_select ".stage-question__body", questions(:http).body
+    assert_select ".stage-option", 3
+    assert_select ".answers-counter", "Answers: 0 / 2"
+    assert_select ".stage-option.is-correct, .stage-option__mark", count: 0
+    assert_no_match(/Correct/, response.body)
+    assert_select "button", text: "Finish"
+
+    game.reload.record_answer(ada, round_id: game.current_round.id, option_id: option_fixture(:http_429).id)
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select ".answers-counter", "Answers: 1 / 2"
+
+    step game, "finish"
+    assert_select ".stage-option", 3
+    assert_select ".stage-option.is-correct", 1 do
+      assert_select ".stage-option__title", "429"
+      assert_select ".stage-option__mark", "Correct"
+      assert_select ".stage-option__count", "1 answer"
+    end
+    assert_select ".stage-option:not(.is-correct) .stage-option__count", text: "0 answers", count: 2
+    assert_select "button", text: "Next"
+    assert_select "button", text: "End quiz", count: 0
+
+    step game, "next"
+    assert_select ".stage-question__num", "Question 2 of 2"
+    step game, "finish"
+    assert_select "button", text: "End quiz"
+    assert_select "button", text: "Next", count: 0
+
+    step game, "end"
+    assert_select "h1", "The quiz is over"
+    assert_select "button", count: 3 # the prize buttons; no step any more
+    assert_select "button", text: "End quiz", count: 0
+    assert game.reload.over?
+  end
+
+  test "a stale step changes nothing" do
+    game = @quiz.games.create!
+    step game, "start"
+    patch moderate_game_progress_path(game), params: { event: "start", version: 0 }, headers: moderator_auth
+    assert_redirected_to moderate_game_path(game)
+    assert_equal 1, game.reload.version
+
+    patch moderate_game_progress_path(game), params: { event: "finish", version: 0 }, headers: moderator_auth
+    assert game.reload.answering?
+  end
+
+  test "starting a quiz without active questions explains why nothing happens" do
+    game = quizzes(:empty).games.create!
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select ".lobby__note", /no active questions/
+
+    patch moderate_game_progress_path(game), params: { event: "start", version: 0 }, headers: moderator_auth
+    follow_redirect! headers: moderator_auth
+    assert_select ".flash", /Switch on at least one question/
+    assert game.reload.lobby?
+  end
+
+  test "the status JSON for the big screen's fallback" do
+    game = @quiz.games.create!
+    get moderate_game_status_path(game), headers: moderator_auth
+    assert_equal({ "version" => 0, "players" => 0, "answers" => 0, "type" => "status" }, response.parsed_body)
+  end
+
+  test "after the end: the leaderboard, one list item per player in order, and the prize buttons" do
+    game = ended_game(ada: 2, bob: 0, cy: 1)
+
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select "h1", "The quiz is over"
+    assert_select "li", 3
+    assert_select "ol.leaderboard > li.leader" do |items|
+      assert_equal [ "1 Ada 2 points", "2 Cy 1 point", "3 Bob 0 points" ], items.map { |item| item.text.squish }
+    end
+    assert_select "button", 3
+    assert_select "form[action=?] button", moderate_game_winners_path(game), text: "Top 3"
+    assert_select "form[action=?] input[name=pick][value=top]", moderate_game_winners_path(game)
+    assert_select "button", text: "Draw"
+    assert_select "button", text: "Reset winners"
+    assert_select "form[data-confirm]", 0
+    assert_no_match(/Winner\b/, response.body.gsub(/Reset winners/, ""))
+  end
+
+  test "the Top N button follows the quiz setting" do
+    game = ended_game(ada: 1)
+    @quiz.update!(winners_count: 5)
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select "button", text: "Top 5"
+  end
+
+  test "Top N marks the winners, Reset winners removes them" do
+    game = ended_game(ada: 2, bob: 0, cy: 1, dan: 1)
+    @quiz.update!(winners_count: 2)
+
+    post moderate_game_winners_path(game), params: { pick: "top" }, headers: moderator_auth
+    assert_redirected_to moderate_game_path(game)
+    follow_redirect! headers: moderator_auth
+    assert_select "li.leader.is-winner", 2
+    assert_select "li.leader", text: /Ada.*Winner.*2 points/m
+    assert_select "li.leader", text: /Cy.*Winner.*1 point/m
+    assert_select "li.leader:not(.is-winner)", text: /Dan/ do
+      assert_select ".leader__badge", 0
+    end
+
+    delete moderate_game_winners_path(game), headers: moderator_auth
+    assert_redirected_to moderate_game_path(game)
+    follow_redirect! headers: moderator_auth
+    assert_select ".leader__badge", 0
+    assert_equal 0, game.players.where(winner: true).count
+  end
+
+  test "Draw picks the tied place at random" do
+    game = ended_game(ada: 2, bob: 1, cy: 1, dan: 0)
+    @quiz.update!(winners_count: 2)
+
+    drawn = 20.times.map do
+      post moderate_game_winners_path(game), params: { pick: "draw" }, headers: moderator_auth
+      assert_redirected_to moderate_game_path(game)
+      game.players.where(winner: true).pluck(:name).sort
+    end
+    assert_equal [ [ "Ada", "Bob" ], [ "Ada", "Cy" ] ], drawn.uniq.sort
+  end
+
+  test "the buttons pick the number they show, even if the setting changed meanwhile" do
+    game = ended_game(ada: 3, bob: 2, cy: 1)
+    get moderate_game_path(game), headers: moderator_auth
+    assert_select "form:has(button:contains('Top 3')) input[name=count][value='3']"
+    assert_select "form:has(button:contains('Draw')) input[name=count][value='3']"
+
+    @quiz.update!(winners_count: 1) # in another tab; the big screen still says "Top 3"
+    post moderate_game_winners_path(game), params: { pick: "top", count: "3" }, headers: moderator_auth
+    assert_equal 3, game.players.where(winner: true).count
+
+    post moderate_game_winners_path(game), params: { pick: "top", count: "0" }, headers: moderator_auth
+    assert_equal [ "Ada" ], game.players.where(winner: true).pluck(:name), "out of range: the setting"
+    post moderate_game_winners_path(game), params: { pick: "top" }, headers: moderator_auth
+    assert_equal [ "Ada" ], game.players.where(winner: true).pluck(:name)
+  end
+
+  test "no winners before the end" do
+    game = @quiz.games.create!
+    post moderate_game_winners_path(game), params: { pick: "top" }, headers: moderator_auth
+    assert_redirected_to moderate_game_path(game)
+    follow_redirect! headers: moderator_auth
+    assert_select ".flash", /once the quiz is over/
+    assert_equal 0, game.reload.version
+  end
+
+  test "the prize buttons need the moderator" do
+    game = ended_game(ada: 1)
+    post moderate_game_winners_path(game), params: { pick: "top" }
+    assert_response :unauthorized
+    delete moderate_game_winners_path(game)
+    assert_response :unauthorized
+    assert_not game.players.sole.winner?
+  end
+
+  test "unknown games are 404" do
+    get moderate_game_path(id: 0), headers: moderator_auth
+    assert_response :not_found
+  end
+  private
+    # A game that ended, whose players (joined in this order) got these points.
+    def ended_game(points)
+      game = @quiz.games.create!
+      players = points.keys.map { |name| game.players.create!(name: name.to_s.capitalize, browser_key: SecureRandom.alphanumeric(32)) }
+      game.advance("start", version: 0)
+      game.advance("finish", version: 1)
+      game.advance("next", version: 2)
+      game.advance("finish", version: 3)
+      game.advance("end", version: 4)
+      players.zip(points.values).each_with_index { |(player, score), index| player.update_columns(points: score, correct_time: index.to_f) }
+      game
+    end
+
+    def step(game, event)
+      patch moderate_game_progress_path(game), params: { event: event, version: game.reload.version }, headers: moderator_auth
+      assert_redirected_to moderate_game_path(game)
+      follow_redirect! headers: moderator_auth
+      assert_response :success
+    end
+end
diff --git a/test/controllers/moderate/imports_controller_test.rb b/test/controllers/moderate/imports_controller_test.rb
new file mode 100644
index 0000000..f2b8fdf
--- /dev/null
+++ b/test/controllers/moderate/imports_controller_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Moderate::ImportsControllerTest < ActionDispatch::IntegrationTest
+  QUIZ = {
+    title: "Frontend Fest 2026",
+    questions: [
+      { text: "Which HTTP status code means \"Too Many Requests\"?", active: true,
+        options: [ { text: "418", correct: false }, { text: "429", correct: true } ] }
+    ]
+  }.freeze
+
+  test "the quiz list has the import button" do
+    get moderate_root_path, headers: moderator_auth
+
+    assert_select "form[action=?][method=get] button", new_moderate_import_path, text: "Import quiz"
+  end
+
+  test "the import page has the JSON text area and the button" do
+    get new_moderate_import_path, headers: moderator_auth
+
+    assert_response :success
+    assert_select "label[for=import_json]", "Quiz JSON"
+    assert_select "textarea#import_json[name='import[json]']"
+    assert_select "button[type=submit]", "Import"
+    # Locators match substrings, ignoring case: each label appears once.
+    text = css_select("main").first.text
+    assert_equal [ "Import" ], text.scan(/import/i)
+    assert_equal [ "Quiz JSON" ], text.scan(/quiz json/i)
+  end
+
+  test "importing creates a new quiz and opens its page" do
+    assert_difference -> { Quiz.count } => 1, -> { Quiz.where(title: "Frontend Fest 2026").count } => 1 do
+      post moderate_import_path, params: { import: { json: QUIZ.to_json } }, headers: moderator_auth
+    end
+
+    quiz = Quiz.last
+    assert_redirected_to moderate_quiz_path(quiz)
+    follow_redirect! headers: moderator_auth
+    assert_select "h1", "Frontend Fest 2026"
+    assert_select "ol.question-list > li", 1
+    assert_select "li .is-correct", /429/
+  end
+
+  test "an export imports back as a copy" do
+    get moderate_quiz_export_path(quizzes(:frontend)), headers: moderator_auth
+    json = css_select("pre").first.text
+
+    assert_difference -> { Quiz.count } => 1, -> { Question.count } => 3, -> { Option.count } => 7 do
+      post moderate_import_path, params: { import: { json: json } }, headers: moderator_auth
+    end
+    assert_equal json, Quiz.last.export_json
+  end
+
+  test "invalid JSON imports nothing and shows the error with the JSON as typed" do
+    assert_no_difference %w[ Quiz.count Question.count Option.count ] do
+      post moderate_import_path, params: { import: { json: "{ \"title\": " } }, headers: moderator_auth
+    end
+
+    assert_response :unprocessable_content
+    assert_select ".errors[role=alert]", /This isn't valid JSON \(line 1, column 12\)/
+    assert_select "textarea#import_json", text: "{ \"title\": "
+    assert_select "button", "Import"
+  end
+
+  test "a broken rule imports nothing, not even the valid questions" do
+    data = QUIZ.deep_dup
+    data[:questions] += [
+      { text: "Valid too", options: [ { text: "A", correct: true }, { text: "B" } ] },
+      { text: "Only one option", options: [ { text: "A", correct: true } ] },
+      { text: "", options: [ { text: "A" }, { text: "B" } ] }
+    ]
+
+    assert_no_difference %w[ Quiz.count Question.count Option.count ] do
+      post moderate_import_path, params: { import: { json: data.to_json } }, headers: moderator_auth
+    end
+
+    assert_response :unprocessable_content
+    assert_select ".errors li", 3
+    assert_select ".errors li", "Question 3: Add at least two options"
+    assert_select ".errors li", "Question 4: \"text\" can't be blank"
+    assert_select ".errors li", "Question 4: Mark at least one option as correct"
+  end
+
+  test "an empty submission shows an error" do
+    post moderate_import_path, params: { import: { json: "" } }, headers: moderator_auth
+
+    assert_response :unprocessable_content
+    assert_select ".errors", "The JSON is empty"
+  end
+end
diff --git a/test/controllers/moderate/questions_controller_test.rb b/test/controllers/moderate/questions_controller_test.rb
new file mode 100644
index 0000000..a7141a2
--- /dev/null
+++ b/test/controllers/moderate/questions_controller_test.rb
@@ -0,0 +1,127 @@
+require "test_helper"
+
+class Moderate::QuestionsControllerTest < ActionDispatch::IntegrationTest
+  setup { @quiz = quizzes(:empty) }
+
+  test "a new question starts with four empty rows and Active on" do
+    get new_moderate_quiz_question_path(@quiz), headers: moderator_auth
+
+    assert_select "label", "Question"
+    (1..4).each do |number|
+      assert_select "label", "Option #{number}"
+      assert_select "input[type=text][placeholder='Option #{number}'][value='']"
+      assert_select "input[type=checkbox][aria-label='Option #{number} is correct']:not([checked])"
+    end
+    assert_select "input[placeholder='Option 5']", 0
+    assert_select "template input[placeholder='Option __NUMBER__']"
+    assert_select "button", "Add option"
+    assert_select "input[type=checkbox][name='question[active]'][checked]"
+    assert_select "button", "Save question"
+  end
+
+  test "creating a question" do
+    assert_difference -> { @quiz.questions.count } do
+      post moderate_quiz_questions_path(@quiz), headers: moderator_auth, params: { question: {
+        body: "Which planet is the largest?", active: "1",
+        option_rows: { "0" => { title: "Jupiter", correct: "1" }, "1" => { title: "Saturn" }, "2" => { title: "" }, "3" => { title: "" } }
+      } }
+    end
+
+    assert_redirected_to moderate_quiz_path(@quiz)
+    assert_equal [ "Jupiter", "Saturn" ], @quiz.questions.last.options.map(&:title)
+  end
+
+  test "a failed rule saves nothing and keeps what was typed" do
+    assert_no_difference -> { Question.count } do
+      post moderate_quiz_questions_path(@quiz), headers: moderator_auth, params: { question: {
+        body: "Which planet is the largest?", active: "0",
+        option_rows: { "0" => { title: "" }, "1" => { title: "Jupiter", correct: "1" }, "2" => { title: "" }, "3" => { title: "" }, "4" => { title: "" } }
+      } }
+    end
+
+    assert_response :unprocessable_content
+    assert_select ".errors", "Add at least two options"
+    assert_select "textarea[name='question[body]']", "Which planet is the largest?"
+    assert_select "input[placeholder='Option 1'][value='']"
+    assert_select "input[placeholder='Option 2'][value='Jupiter']"
+    assert_select "input[aria-label='Option 2 is correct'][checked]"
+    assert_select "input[placeholder='Option 5']"
+    assert_select "input[type=checkbox][name='question[active]']:not([checked])"
+  end
+
+  test "without a correct option" do
+    post moderate_quiz_questions_path(@quiz), headers: moderator_auth, params: { question: {
+      body: "Q", option_rows: { "0" => { title: "A" }, "1" => { title: "B" } }
+    } }
+
+    assert_response :unprocessable_content
+    assert_select ".errors", "Mark at least one option as correct"
+  end
+
+  test "editing shows the options and pads to four rows" do
+    get edit_moderate_question_path(questions(:websocket)), headers: moderator_auth
+
+    assert_select "input[placeholder='Option 1'][value='WebSocket']"
+    assert_select "input[aria-label='Option 1 is correct'][checked]"
+    assert_select "input[placeholder='Option 2'][value='SMTP']"
+    assert_select "input[placeholder='Option 4'][value='']"
+    assert_select "input[type=hidden][name='question[option_rows][0][id]'][value=?]", option_fixture(:websocket_ws).id.to_s
+  end
+
+  test "updating a question" do
+    question = questions(:websocket)
+    patch moderate_question_path(question), headers: moderator_auth, params: { question: {
+      body: "Which protocol is two-way?", active: "1",
+      option_rows: { "0" => { id: option_fixture(:websocket_ws).id, title: "WebSocket", correct: "1" }, "1" => { id: option_fixture(:websocket_smtp).id, title: "" },
+                     "2" => { title: "HTTP/1.0" } }
+    } }
+
+    assert_redirected_to moderate_quiz_path(question.quiz)
+    assert_equal "Which protocol is two-way?", question.reload.body
+    assert_equal [ "WebSocket", "HTTP/1.0" ], question.options.map(&:title)
+  end
+
+  test "removing every row means no options" do
+    patch moderate_question_path(questions(:websocket)), headers: moderator_auth, params: { question: { body: "Q", active: "1" } }
+
+    assert_response :unprocessable_content
+    assert_equal 2, questions(:websocket).options.count
+  end
+
+  test "deleting a question" do
+    assert_difference -> { Question.count } => -1 do
+      delete moderate_question_path(questions(:http)), headers: moderator_auth
+    end
+    assert_redirected_to moderate_quiz_path(quizzes(:frontend))
+  end
+
+  test "switching a question off and on" do
+    patch moderate_question_activation_path(questions(:http)), params: { question: { active: "0" } }, headers: moderator_auth
+    assert_redirected_to moderate_quiz_path(quizzes(:frontend))
+    assert_not questions(:http).reload.active?
+
+    patch moderate_question_activation_path(questions(:http)), params: { question: { active: "1" } }, headers: moderator_auth
+    assert questions(:http).reload.active?
+  end
+
+  test "moving a question" do
+    patch moderate_question_position_path(questions(:css)), params: { direction: "up" }, headers: moderator_auth
+    assert_redirected_to moderate_quiz_path(quizzes(:frontend))
+    assert_equal questions(:http, :css, :websocket), quizzes(:frontend).questions.reload.to_a
+
+    patch moderate_question_position_path(questions(:http)), params: { direction: "down" }, headers: moderator_auth
+    assert_equal questions(:css, :http, :websocket), quizzes(:frontend).questions.reload.to_a
+
+    patch moderate_question_position_path(questions(:http)), params: { direction: "sideways" }, headers: moderator_auth
+    assert_response :unprocessable_content
+  end
+
+  test "the preview gets only the active questions, in order" do
+    get moderate_quiz_preview_path(quizzes(:frontend)), headers: moderator_auth
+
+    assert_response :success
+    data = JSON.parse(css_select("[data-controller=preview]").first["data-preview-questions-value"])
+    assert_equal questions(:http, :websocket).map(&:body), data.map { |question| question["text"] }
+    assert_equal [ { "title" => "418", "correct" => false }, { "title" => "429", "correct" => true }, { "title" => "503", "correct" => false } ], data.first["options"]
+  end
+end
diff --git a/test/controllers/moderate/quizzes_controller_test.rb b/test/controllers/moderate/quizzes_controller_test.rb
