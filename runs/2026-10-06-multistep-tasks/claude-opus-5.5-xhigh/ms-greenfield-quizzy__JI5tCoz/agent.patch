+require "test_helper"
+
+class Moderate::QuizzesControllerTest < ActionDispatch::IntegrationTest
+  test "lists the quizzes, each in its own list item with its link" do
+    get moderate_root_path, headers: moderator_auth
+
+    assert_response :success
+    assert_select "button", text: "New quiz"
+    assert_select "li", text: /Frontend Fest 2026/ do
+      assert_select "a[href=?]", moderate_quiz_path(quizzes(:frontend)), text: "Frontend Fest 2026"
+    end
+  end
+
+  test "creating a quiz opens its page" do
+    assert_difference -> { Quiz.count } do
+      post moderate_quizzes_path, params: { quiz: { title: "DevOps Days" } }, headers: moderator_auth
+    end
+
+    assert_redirected_to moderate_quiz_path(Quiz.last)
+    follow_redirect! headers: moderator_auth
+    assert_select "h1", "DevOps Days"
+  end
+
+  test "a quiz needs a title" do
+    assert_no_difference -> { Quiz.count } do
+      post moderate_quizzes_path, params: { quiz: { title: "" } }, headers: moderator_auth
+    end
+
+    assert_response :unprocessable_content
+    assert_select ".errors", /Title can't be blank/
+    assert_select "label", "Title"
+  end
+
+  test "the quiz page shows the questions in order with their actions" do
+    get moderate_quiz_path(quizzes(:frontend)), headers: moderator_auth
+
+    assert_select "h1", "Frontend Fest 2026"
+    assert_select "a", "Settings"
+    assert_select "a", "Preview"
+    assert_select "button", "Add question"
+    assert_select "ol.question-list > li", 3
+    assert_select "ol.question-list > li .question-item__body" do |bodies|
+      assert_equal questions(:http, :websocket, :css).map(&:body), bodies.map(&:text)
+    end
+    assert_select "li#question_#{questions(:http).id}" do
+      assert_select "button[aria-label='Move up'][disabled]"
+      assert_select "button[aria-label='Move down']:not([disabled])"
+      assert_select "label", /Active/ do
+        assert_select "input[type=checkbox][checked]"
+      end
+      assert_select "a", "Edit"
+      assert_select "form[data-confirm] button", "Delete"
+      assert_select ".is-correct", /429/
+    end
+    assert_select "li#question_#{questions(:css).id}.question-item--inactive input[type=checkbox]:not([checked])"
+  end
+
+  test "settings show the quiz form and the delete button" do
+    get edit_moderate_quiz_path(quizzes(:frontend)), headers: moderator_auth
+
+    assert_select "input[name='quiz[title]'][value=?]", "Frontend Fest 2026"
+    assert_select "button", "Save quiz"
+    assert_select "form[data-confirm] button", "Delete quiz"
+  end
+
+  test "the quiz form has the number of winners, 3 by default" do
+    get new_moderate_quiz_path, headers: moderator_auth
+    assert_select "form[novalidate]" do
+      assert_select "label[for=quiz_winners_count]", "Number of winners"
+      assert_select "input#quiz_winners_count[type=number][min='1'][value='3']"
+    end
+
+    post moderate_quizzes_path, params: { quiz: { title: "DevOps Days", winners_count: "5" } }, headers: moderator_auth
+    assert_equal 5, Quiz.last.winners_count
+  end
+
+  test "settings change the number of winners, which must be at least 1" do
+    quiz = quizzes(:frontend)
+    get edit_moderate_quiz_path(quiz), headers: moderator_auth
+    assert_select "input[name='quiz[winners_count]'][value='3']"
+
+    patch moderate_quiz_path(quiz), params: { quiz: { title: "Frontend Fest 2026", winners_count: "0" } }, headers: moderator_auth
+    assert_response :unprocessable_content
+    assert_select ".errors", /must be greater than or equal to 1/
+    assert_select "input[name='quiz[winners_count]'][value='0']"
+    assert_equal 3, quiz.reload.winners_count
+
+    patch moderate_quiz_path(quiz), params: { quiz: { winners_count: "1" } }, headers: moderator_auth
+    assert_redirected_to moderate_quiz_path(quiz)
+    assert_equal 1, quiz.reload.winners_count
+  end
+
+  test "settings have the timer: minutes and seconds, 0 by default" do
+    quiz = quizzes(:frontend)
+    get edit_moderate_quiz_path(quiz), headers: moderator_auth
+
+    assert_select "form[novalidate]" do
+      assert_select "label[for=quiz_timer_minutes]", "Timer minutes"
+      assert_select "input#quiz_timer_minutes[type=number][name='quiz[timer_minutes]'][min='0'][value='0']"
+      assert_select "label[for=quiz_timer_seconds]", "Timer seconds"
+      assert_select "input#quiz_timer_seconds[type=number][name='quiz[timer_seconds]'][min='0'][max='59'][value='0']"
+    end
+    # Each label once on the page (substring locators).
+    assert_equal 1, response.body.scan("Timer minutes").size
+    assert_equal 1, response.body.scan("Timer seconds").size
+
+    patch moderate_quiz_path(quiz), params: { quiz: { timer_minutes: "1", timer_seconds: "30" } }, headers: moderator_auth
+    assert_redirected_to moderate_quiz_path(quiz)
+    assert_equal [ 1, 30 ], [ quiz.reload.timer_minutes, quiz.timer_seconds ]
+
+    get edit_moderate_quiz_path(quiz), headers: moderator_auth
+    assert_select "input#quiz_timer_minutes[value='1']"
+    assert_select "input#quiz_timer_seconds[value='30']"
+
+    patch moderate_quiz_path(quiz), params: { quiz: { timer_minutes: "0", timer_seconds: "0" } }, headers: moderator_auth
+    assert_not quiz.reload.timer?
+  end
+
+  test "the new-quiz form has the timer too" do
+    get new_moderate_quiz_path, headers: moderator_auth
+    assert_select "input#quiz_timer_minutes[value='0']"
+    assert_select "input#quiz_timer_seconds[value='0']"
+
+    post moderate_quizzes_path, params: { quiz: { title: "DevOps Days", timer_minutes: "0", timer_seconds: "45" } }, headers: moderator_auth
+    assert_equal [ 0, 45 ], [ Quiz.last.timer_minutes, Quiz.last.timer_seconds ]
+  end
+
+  test "invalid timer values are listed and shown as typed" do
+    quiz = quizzes(:frontend)
+    patch moderate_quiz_path(quiz), params: { quiz: { timer_minutes: "-1", timer_seconds: "75" } }, headers: moderator_auth
+
+    assert_response :unprocessable_content
+    assert_select ".errors li", "Timer minutes must be greater than or equal to 0"
+    assert_select ".errors li", "Timer seconds must be less than or equal to 59"
+    assert_select "input#quiz_timer_minutes[value='-1']"
+    assert_select "input#quiz_timer_seconds[value='75']"
+    assert_not quiz.reload.timer?
+  end
+
+  test "updating a quiz" do
+    patch moderate_quiz_path(quizzes(:frontend)), params: { quiz: { title: "Frontend Fest 2027" } }, headers: moderator_auth
+
+    assert_redirected_to moderate_quiz_path(quizzes(:frontend))
+    assert_equal "Frontend Fest 2027", quizzes(:frontend).reload.title
+  end
+
+  test "deleting a quiz" do
+    assert_difference -> { Quiz.count } => -1, -> { Question.count } => -3 do
+      delete moderate_quiz_path(quizzes(:frontend)), headers: moderator_auth
+    end
+
+    assert_redirected_to moderate_root_path
+  end
+end
diff --git a/test/controllers/play/answers_controller_test.rb b/test/controllers/play/answers_controller_test.rb
new file mode 100644
index 0000000..188c2b3
--- /dev/null
+++ b/test/controllers/play/answers_controller_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Play::AnswersControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @game = quizzes(:frontend).games.create!
+    post play_player_path(@game.code), params: { player: { name: "Alice" } }
+    @player = @game.players.last
+    @game.advance("start", version: 0)
+    @round = @game.current_round
+  end
+
+  test "an answer is saved, and the last pick counts" do
+    post play_answer_path(@game.code), params: { round: @round.id, option: option_fixture(:http_418).id }, as: :json
+    assert_response :success
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_equal({ "round" => @round.id, "option" => option_fixture(:http_418).id }, response.parsed_body["answer"])
+    assert_equal "saved", response.parsed_body["result"]
+    assert_nil response.parsed_body.dig("state", "correct")
+
+    post play_answer_path(@game.code), params: { round: @round.id, option: option_fixture(:http_429).id }, as: :json
+    assert_equal [ option_fixture(:http_429).id ], @round.answers.pluck(:option_id)
+  end
+
+  test "after Finish the answer can't change; the reply has the saved one and the results" do
+    post play_answer_path(@game.code), params: { round: @round.id, option: option_fixture(:http_418).id }, as: :json
+    @game.advance("finish", version: 1)
+
+    post play_answer_path(@game.code), params: { round: @round.id, option: option_fixture(:http_429).id }, as: :json
+    assert_response :conflict
+    assert_equal "closed", response.parsed_body["result"]
+    assert_equal option_fixture(:http_418).id, response.parsed_body.dig("answer", "option")
+    assert_equal [ option_fixture(:http_429).id ], response.parsed_body.dig("state", "correct")
+  end
+
+  test "options of other questions are refused" do
+    post play_answer_path(@game.code), params: { round: @round.id, option: option_fixture(:websocket_ws).id }, as: :json
+    assert_response :unprocessable_content
+    assert_nil response.parsed_body["answer"]
+    assert_equal 0, Answer.count
+  end
+
+  test "only players of the game may answer" do
+    cookies.delete(PlayerIdentity::COOKIE)
+    post play_answer_path(@game.code), params: { round: @round.id, option: option_fixture(:http_418).id }, as: :json
+    assert_response :not_found
+    assert_equal 0, Answer.count
+  end
+
+  test "the state for phones without a socket, which also counts as presence" do
+    assert_equal 0, @game.screen_status[:players]
+
+    get play_state_path(@game.code)
+    assert_response :success
+    assert_equal "sync", response.parsed_body["type"]
+    assert_equal "Alice", response.parsed_body.dig("player", "name")
+    assert_equal @round.id, response.parsed_body.dig("state", "question", "round")
+    assert_equal 1, @game.screen_status[:players]
+
+    travel Player::POLL_WINDOW + 1.second
+    assert_equal 0, @game.screen_status[:players]
+  end
+
+  test "a whole game over HTTP: no points while it runs, place and points after the end" do
+    post play_answer_path(@game.code), params: { round: @round.id, option: option_fixture(:http_429).id }, as: :json
+    assert_not_includes response.body, "points"
+    @game.advance("finish", version: 1)
+    get play_state_path(@game.code)
+    assert_not_includes response.body, "points"
+    assert_nil response.parsed_body.dig("state", "results")
+
+    @game.advance("next", version: 2)
+    @game.advance("finish", version: 3)
+    @game.advance("end", version: 4)
+    get play_state_path(@game.code)
+    assert_equal @player.id, response.parsed_body.dig("player", "id")
+    assert_equal({ "players" => 1, "standings" => [ { "player" => @player.id, "place" => 1, "points" => 1, "winner" => false } ] },
+      response.parsed_body.dig("state", "results"))
+
+    @game.pick_winners("top")
+    get play_state_path(@game.code)
+    assert response.parsed_body.dig("state", "results", "standings", 0, "winner")
+    assert_equal 6, response.parsed_body.dig("state", "version")
+  end
+
+  test "the state is only for players" do
+    cookies.delete(PlayerIdentity::COOKIE)
+    get play_state_path(@game.code)
+    assert_response :not_found
+  end
+end
diff --git a/test/controllers/play/games_controller_test.rb b/test/controllers/play/games_controller_test.rb
new file mode 100644
index 0000000..86b14fe
--- /dev/null
+++ b/test/controllers/play/games_controller_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Play::GamesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @game = quizzes(:frontend).games.create!
+  end
+
+  test "the join link asks for a name, without any account" do
+    get play_path(@game.code)
+    assert_response :success
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_select "h1", "Frontend Fest 2026"
+    assert_select "form[action=?]", play_player_path(@game.code) do
+      assert_select "label[for=player_name]", "Your name"
+      assert_select "input#player_name[maxlength='30']"
+      assert_select "button[type=submit]", "Join"
+    end
+  end
+
+  test "codes work in lower case too" do
+    get play_path(@game.code.downcase)
+    assert_select "button", "Join"
+  end
+
+  test "joining greets the player, and the browser stays that player" do
+    assert_difference -> { @game.players.count } do
+      post play_player_path(@game.code), params: { player: { name: "  Alice " } }
+    end
+    assert_redirected_to play_path(@game.code)
+    key = cookies[PlayerIdentity::COOKIE]
+    assert_match(/\A[A-Za-z0-9]{32}\z/, key)
+    assert_equal @game.players.find_by_browser_key(key), @game.players.last
+
+    follow_redirect!
+    assert_select "[data-controller=play]"
+    sync = JSON.parse(css_select("[data-controller=play]").first["data-play-sync-value"])
+    assert_equal({ "type" => "sync", "state" => { "version" => 0, "status" => "lobby" }, "player" => { "id" => @game.players.last.id, "name" => "Alice" }, "answer" => nil }, sync)
+    assert_select "form", count: 0
+
+    # The same browser opens the link again, or posts the form again.
+    get play_path(@game.code)
+    assert_select "[data-controller=play]"
+    assert_no_difference -> { Player.count } do
+      post play_player_path(@game.code), params: { player: { name: "Mallory" } }
+    end
+    assert_equal [ "Alice" ], @game.players.pluck(:name)
+  end
+
+  test "the same browser in another game is a new player there" do
+    post play_player_path(@game.code), params: { player: { name: "Alice" } }
+    other = quizzes(:frontend).games.create!
+
+    get play_path(other.code)
+    assert_select "button", "Join"
+    post play_player_path(other.code), params: { player: { name: "Alice" } }
+    assert_equal 1, other.players.count
+    assert_equal @game.players.first.browser_key_digest, other.players.first.browser_key_digest
+  end
+
+  test "a name is required" do
+    assert_no_difference -> { Player.count } do
+      post play_player_path(@game.code), params: { player: { name: "   " } }
+    end
+    assert_response :unprocessable_content
+    assert_select ".errors", "Type a name first."
+    assert_select "label", "Your name"
+    assert_no_match(/your name/i, css_select(".errors").text)
+  end
+
+  test "players can join during the game" do
+    @game.advance("start", version: 0)
+    post play_player_path(@game.code), params: { player: { name: "Late" } }
+    follow_redirect!
+    sync = JSON.parse(css_select("[data-controller=play]").first["data-play-sync-value"])
+    assert_equal "answering", sync.dig("state", "status")
+    assert_equal questions(:http).body, sync.dig("state", "question", "text")
+  end
+
+  test "while a question is open, the page has no trace of the correct answer" do
+    post play_player_path(@game.code), params: { player: { name: "Alice" } }
+    @game.advance("start", version: 0)
+
+    get play_path(@game.code)
+    assert_includes response.body, "429"
+    assert_no_match(/correct/i, response.body)
+
+    @game.advance("finish", version: 1)
+    get play_path(@game.code)
+    assert_match(/&quot;correct&quot;:\[#{option_fixture(:http_429).id}\]/, response.body)
+  end
+
+  test "after the end nobody can join" do
+    @game.update!(status: "over")
+
+    get play_path(@game.code)
+    assert_select "h1", "The quiz is over"
+    assert_select "form", count: 0
+    assert_select "input", count: 0
+
+    assert_no_difference -> { Player.count } do
+      post play_player_path(@game.code), params: { player: { name: "Too late" } }
+    end
+    assert_redirected_to play_path(@game.code)
+  end
+
+  test "players of a game that ended see it ended" do
+    post play_player_path(@game.code), params: { player: { name: "Alice" } }
+    @game.update!(status: "over")
+    get play_path(@game.code)
+    sync = JSON.parse(css_select("[data-controller=play]").first["data-play-sync-value"])
+    assert_equal "over", sync.dig("state", "status")
+  end
+
+  test "an unknown code is 404" do
+    get play_path("NOPE1")
+    assert_response :not_found
+    assert_select "h1", "Game not found"
+
+    post play_player_path("NOPE1"), params: { player: { name: "Alice" } }
+    assert_response :not_found
+  end
+
+  test "a tampered cookie is just ignored" do
+    cookies[PlayerIdentity::COOKIE] = "<script>"
+    get play_path(@game.code)
+    assert_select "button", "Join"
+    post play_player_path(@game.code), params: { player: { name: "Alice" } }
+    assert_match(/\A[A-Za-z0-9]{32}\z/, cookies[PlayerIdentity::COOKIE])
+  end
+end
