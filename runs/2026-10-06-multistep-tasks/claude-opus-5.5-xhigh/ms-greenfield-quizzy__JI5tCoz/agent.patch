@@ -0,0 +1,31 @@
+import { Controller } from "@hotwired/stimulus"
+import { follow } from "live"
+import { element } from "dom"
+
+// The join form (play/games/join). Follows the public game state and, when
+// the game ends, replaces the form with "The quiz is over" (the same
+// markup as play/games/_over_message).
+export default class extends Controller {
+  static targets = [ "body" ]
+  static values = { code: String }
+
+  connect() {
+    this.live = follow({ channel: "GameChannel", code: this.codeValue }, {
+      received: (message) => {
+        if (message && message.state && message.state.status === "over") this.over()
+      }
+    })
+  }
+
+  disconnect() {
+    this.live?.stop()
+  }
+
+  over() {
+    this.live.stop()
+    this.bodyTarget.replaceChildren(
+      element("div", { class: "waiting" },
+        element("div", { class: "waiting__gem waiting__gem--still", "aria-hidden": "true" }, "✓"),
+        element("h1", { class: "play-title" }, "The quiz is over")))
+  }
+}
diff --git a/app/javascript/controllers/play_controller.js b/app/javascript/controllers/play_controller.js
new file mode 100644
index 0000000..f6fd292
--- /dev/null
+++ b/app/javascript/controllers/play_controller.js
@@ -0,0 +1,300 @@
+import { Controller } from "@hotwired/stimulus"
+import { follow, absolute, timeoutSignal } from "live"
+import { element, letter } from "dom"
+
+// The live game on a player's phone (play/games/show).
+//
+// It draws every step from the game state: the sync value at load, then
+// whatever PlayerChannel pushes (or the state URL returns while the socket
+// is down). States carry a version; older ones are ignored.
+//
+// Answers: a tap marks the option "Sending…" and posts it. The option
+// becomes "Your answer" only once the server says it's saved, so that mark
+// always means the answer counts. Taps while a post is out are queued (the
+// last one wins); failed posts are retried until the question closes. A
+// post that comes too late gets back the answer that was saved before.
+//
+// After the end the phone shows the player's place and points, and "You
+// won!" once the moderator picks them (every change is a new state).
+// Points never show before the end.
+//
+// Messages:
+//   { type: "sync", state, player: { id, name }, answer: { round, option } | null }
+//   { type: "state", state }
+// state: { version, status: lobby|answering|results|over,
+//          question: { round, number, total, text, options: [{ id, title }] },
+//          correct: [option ids] (only once the question is closed),
+//          results: { players, standings: [{ player, place, points, winner }] } (only when over) }
+export default class extends Controller {
+  static targets = [ "stage" ]
+  static values = { code: String, sync: Object, stateUrl: String, answerUrl: String, heartbeat: Number }
+
+  connect() {
+    this.game = null
+    this.name = ""
+    this.playerId = null
+    this.saved = null      // the server's answer to the current question: { round, option }
+    this.choice = null     // a tap the server hasn't confirmed yet: { round, option }
+    this.sending = false
+    this.trouble = false   // the last post failed (network)
+    this.retryDelay = 0
+
+    this.receive(this.syncValue)
+
+    this.live = follow({ channel: "PlayerChannel", code: this.codeValue }, {
+      received: (message) => this.receive(message),
+      lost: () => window.location.reload()   // not a player of this game (any more)
+    }, { pollURL: this.stateUrlValue, pollInterval: 3000 })
+
+    this.heartbeatTimer = setInterval(() => this.live.perform("heartbeat"), this.heartbeatValue || 10000)
+
+    this.onVisibilityChange = () => { if (document.visibilityState === "visible") this.resync() }
+    document.addEventListener("visibilitychange", this.onVisibilityChange)
+
+    this.onClick = (event) => {
+      const button = event.target.closest("button[data-option]")
+      if (button && !button.disabled) this.pick(Number(button.dataset.option))
+    }
+    this.stageTarget.addEventListener("click", this.onClick)
+  }
+
+  disconnect() {
+    clearInterval(this.heartbeatTimer)
+    clearTimeout(this.retryTimer)
+    document.removeEventListener("visibilitychange", this.onVisibilityChange)
+    this.stageTarget.removeEventListener("click", this.onClick)
+    this.live?.stop()
+  }
+
+  // Back from the background (phone screen was off): catch up at once.
+  resync() {
+    if (this.live.connected) {
+      this.live.perform("sync")
+    } else {
+      this.live.poll()
+    }
+  }
+
+  // Incoming state ------------------------------------------------------------
+
+  receive(message) {
+    if (!message || !message.state) return
+
+    if (message.type === "sync") {
+      this.name = message.player.name
+      this.playerId = message.player.id
+      if (!this.accept(message.state, { same: true })) return
+      if (!this.choice && !this.sending) this.saved = message.answer || null
+      this.render()
+    } else if (message.type === "state") {
+      if (this.accept(message.state)) this.render()
+    }
+  }
+
+  // Takes a state unless it's older than the one shown (with `same`, also
+  // one of the same version). A new question forgets the previous answer.
+  accept(state, { same = false } = {}) {
+    if (this.game && (state.version < this.game.version || (state.version === this.game.version && !same))) return false
+
+    const round = state.question ? state.question.round : null
+    if (round !== this.round) {
+      this.saved = null
+      this.choice = null
+      this.newQuestion = true
+    }
+    this.game = state
+    return true
+  }
+
+  get round() {
+    return this.game && this.game.question ? this.game.question.round : null
+  }
+
+  // Answering ----------------------------------------------------------------
+
+  pick(option) {
+    if (this.game.status !== "answering") return
+    if (!this.choice && this.saved && this.saved.option === option) return
+
+    this.choice = { round: this.round, option }
+    this.render()
+    this.send()
+  }
+
+  async send() {
+    if (this.sending || !this.choice) return
+    clearTimeout(this.retryTimer)
+
+    const choice = this.choice
+    this.sending = true
+    let failed = false
+
+    try {
+      const response = await fetch(absolute(this.answerUrlValue), {
+        method: "POST",
+        credentials: "same-origin",
+        cache: "no-store",
+        headers: { "Content-Type": "application/json", Accept: "application/json", "X-CSRF-Token": csrfToken() },
+        body: JSON.stringify({ round: choice.round, option: choice.option }),
+        signal: timeoutSignal(8000)
+      })
+
+      if (response.status === 404) return window.location.reload()
+      const data = (response.headers.get("Content-Type") || "").includes("json") ? await response.json() : null
+      if (!data) {
+        // Not our JSON: an expired form token (reload for a fresh one), or
+        // a proxy or server error (retry).
+        if (response.status === 422) return window.location.reload()
+        throw new Error(`HTTP ${response.status}`)
+      }
+
+      this.trouble = false
+      this.retryDelay = 0
+      if (data.state) this.accept(data.state, { same: true })
+      if (choice.round === this.round) {
+        this.saved = data.answer
+        // Done, unless the player tapped again meanwhile. A closed question
+        // takes no more taps at all.
+        if (this.choice === choice || data.result === "closed") this.choice = null
+      }
+    } catch (error) {
+      failed = true
+    } finally {
+      this.sending = false
+    }
+
+    if (failed && this.choice) {
+      this.trouble = true
+      this.retryDelay = Math.min(this.retryDelay ? this.retryDelay * 2 : 1000, 5000)
+      this.retryTimer = setTimeout(() => this.send(), this.retryDelay)
+    } else if (this.choice) {
+      this.send()
+    }
+    this.render()
+  }
+
+  // Drawing -------------------------------------------------------------------
+
+  render() {
+    if (!this.game || !this.hasStageTarget) return
+
+    const focused = document.activeElement && document.activeElement.closest &&
+      document.activeElement.closest("button[data-option]")
+    const focusedOption = focused && this.stageTarget.contains(focused) ? focused.dataset.option : null
+
+    const status = this.game.status
+    const onQuestion = (status === "answering" || status === "results") && this.game.question
+    this.stageTarget.classList.toggle("play__body--top", Boolean(onQuestion))
+    this.stageTarget.replaceChildren(...(onQuestion ? this.questionView() : status === "over" ? this.overView() : this.lobbyView()))
+
+    if (focusedOption) this.stageTarget.querySelector(`button[data-option="${focusedOption}"]`)?.focus({ preventScroll: true })
+    if (this.newQuestion) {
+      this.newQuestion = false
+      window.scrollTo(0, 0)
+    }
+  }
+
+  lobbyView() {
+    return [
+      element("div", { class: "waiting" },
+        element("div", { class: "waiting__gem", "aria-hidden": "true" }, "?"),
+        element("h1", { class: "play-title" }, `Hi, ${this.name}!`),
+        element("p", { class: "play-lead" }, "Waiting for the quiz to begin…"))
+    ]
+  }
+
+  overView() {
+    const results = this.game.results
+    const mine = results && results.standings ? results.standings.find((standing) => standing.player === this.playerId) : null
+
+    return [
+      // Spaces between the blocks, so the text reads "… Place 2 of 5 3 points …".
+      element("div", { class: "waiting play-over" },
+        element("div", { class: "waiting__gem waiting__gem--still", "aria-hidden": "true" }, mine && mine.winner ? "★" : "✓"), " ",
+        element("h1", { class: "play-title" }, "The quiz is over"), " ",
+        mine ? this.resultView(mine, results.players) : null, mine ? " " : null,
+        mine && mine.winner ? element("div", { class: "winner-banner", role: "status" },
+          element("span", { class: "winner-banner__title" }, "You won!"), " ",
+          element("small", {}, "Collect your prize from the speaker.")) : null, mine && mine.winner ? " " : null,
+        element("p", { class: "play-lead" }, `Thanks for playing, ${this.name}!`))
+    ]
+  }
+
+  // "Place 2 of 5" (one line of text, the number big) and "3 points".
+  resultView(standing, players) {
+    return element("div", { class: "result-card" },
+      element("p", { class: "result-card__place" },
+        element("span", { class: "result-card__small" }, "Place"), ` ${standing.place} `,
+        element("span", { class: "result-card__small" }, `of ${players}`)), " ",
+      element("p", { class: "result-card__score" }, `${standing.points} ${standing.points === 1 ? "point" : "points"}`))
+  }
+
+  questionView() {
+    const question = this.game.question
+    const closed = this.game.status === "results"
+    const correct = new Set(closed ? this.game.correct || [] : [])
+    const saved = this.saved && this.saved.round === question.round ? this.saved.option : null
+    const pending = this.choice && this.choice.round === question.round ? this.choice.option : null
+    const picked = pending ?? saved
+
+    const options = element("div", { class: `play-options${closed ? " is-locked is-revealed" : ""}` },
+      ...question.options.map((option, index) => {
+        const classes = [ "play-option" ]
+        if (option.id === picked) classes.push("is-picked")
+        if (option.id === pending) classes.push("is-pending")
+        if (correct.has(option.id)) classes.push("is-correct")
+
+        // Spaces between the parts, so the text reads "B 429 Your answer".
+        return element("button", { type: "button", class: classes.join(" "), "data-option": option.id, disabled: closed },
+          element("span", { class: "play-option__letter", "aria-hidden": "true" }, letter(index)), " ",
+          element("span", { class: "play-option__title" }, option.title),
+          option.id === pending ? " " : null,
+          option.id === pending ? element("span", { class: "play-option__chip play-option__chip--pending" }, "Sending…") : null,
+          option.id === saved && option.id !== pending ? " " : null,
+          option.id === saved && option.id !== pending ? element("span", { class: "play-option__chip" }, "Your answer") : null,
+          correct.has(option.id) ? " " : null,
+          correct.has(option.id) ? element("span", { class: "play-option__mark", "aria-hidden": "true" }, "✓") : null,
+          correct.has(option.id) ? element("span", { class: "visually-hidden" }, "(correct option)") : null)
+      }))
+
+    return [
+      element("div", { class: "play-question__num" }, `Question ${question.number} of ${question.total}`),
+      element("div", { class: "play-question__body" }, question.text),
+      options,
+      this.statusView(closed, saved, pending, correct)
+    ].filter(Boolean)
+  }
+
+  statusView(closed, saved, pending, correct) {
+    let kind = "neutral"
+    let text
+
+    if (closed) {
+      if (pending !== null) {
+        text = "Checking…"
+      } else if (saved === null) {
+        text = "No answer"
+      } else if (correct.has(saved)) {
+        kind = "right"
+        text = "Correct!"
+      } else {
+        kind = "wrong"
+        text = "Wrong!"
+      }
+    } else if (pending !== null) {
+      if (!this.trouble) return null // the option says "Sending…"
+      text = "Connection trouble. Trying again…"
+    } else if (saved !== null) {
+      text = "Saved. You can still change it until the question closes."
+    } else {
+      text = "Tap an option to answer."
+    }
+
+    return element("div", { class: `play-status play-status--${kind}`, role: "status" }, text)
+  }
+}
+
+function csrfToken() {
+  const meta = document.querySelector('meta[name="csrf-token"]')
+  return meta ? meta.content : ""
+}
diff --git a/app/javascript/controllers/preview_controller.js b/app/javascript/controllers/preview_controller.js
new file mode 100644
index 0000000..1cf9656
--- /dev/null
+++ b/app/javascript/controllers/preview_controller.js
@@ -0,0 +1,116 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Plays a quiz in the browser the way a player would: one question at a
+// time, the options as buttons, feedback after each pick and the score at the
+// end. Answers only live in this controller; nothing is sent to the server.
+//
+// questions value: [{ text: "…", options: [{ title: "…", correct: true }] }]
+export default class extends Controller {
+  static targets = [ "stage" ]
+  static values = { questions: Array }
+
+  connect() {
+    if (this.questionsValue.length > 0) this.startOver()
+  }
+
+  startOver() {
+    this.index = 0
+    this.score = 0
+    this.renderQuestion()
+  }
+
+  // Rendering ----------------------------------------------------------------
+
+  renderQuestion() {
+    const question = this.questionsValue[this.index]
+    this.answered = false
+
+    this.options = element("div", { class: "play-options" },
+      ...question.options.map((option, index) => this.optionButton(option, index)))
+
+    this.stageTarget.replaceChildren(
+      element("div", { class: "play-question__num" }, `Question ${this.index + 1} of ${this.total}`),
+      element("div", { class: "play-question__body" }, question.text),
+      this.options
+    )
+    window.scrollTo(0, 0)
+  }
+
+  optionButton(option, index) {
+    const button = element("button", { type: "button", class: "play-option" },
+      element("span", { class: "play-option__letter", "aria-hidden": "true" }, letter(index)),
+      element("span", { class: "play-option__title" }, option.title))
+    button.addEventListener("click", () => this.pick(index))
+    return button
+  }
+
+  pick(index) {
+    if (this.answered) return
+    this.answered = true
+
+    const question = this.questionsValue[this.index]
+    const right = question.options[index].correct
+    if (right) this.score++
+
+    this.options.classList.add("is-locked", "is-revealed")
+    this.options.querySelectorAll(".play-option").forEach((button, position) => {
+      button.disabled = true
+      if (position === index) {
+        button.classList.add("is-picked")
+        button.append(element("span", { class: "visually-hidden" }, " (your answer)"))
+      }
+      if (question.options[position].correct) {
+        button.classList.add("is-correct")
+        button.append(
+          element("span", { class: "play-option__mark", "aria-hidden": "true" }, "✓"),
+          element("span", { class: "visually-hidden" }, " (correct answer)"))
+      }
+    })
+
+    const last = this.index === this.total - 1
+    const next = element("button", { type: "button", class: "btn btn--lg" }, last ? "See score" : "Next question")
+    next.addEventListener("click", () => last ? this.showScore() : this.nextQuestion())
+
+    this.stageTarget.append(
+      element("div", { class: `play-status play-status--${right ? "right" : "wrong"}`, role: "status" }, right ? "Correct!" : "Wrong!"),
+      element("div", { class: "play-next" }, next)
+    )
+    next.focus({ preventScroll: true })
+  }
+
+  nextQuestion() {
+    this.index++
+    this.renderQuestion()
+  }
+
+  showScore() {
+    this.stageTarget.replaceChildren(
+      element("div", { class: "result-card preview-result" },
+        element("div", { class: "result-card__label" }, "Preview finished"),
+        element("div", { class: "preview-result__score" }, `Score: ${this.score}/${this.total}`),
+        element("p", { class: "play-lead" }, verdict(this.score, this.total)))
+    )
+    window.scrollTo(0, 0)
+  }
+
+  get total() {
+    return this.questionsValue.length
+  }
+}
+
+function element(name, attributes = {}, ...children) {
+  const node = document.createElement(name)
+  for (const [ attribute, value ] of Object.entries(attributes)) node.setAttribute(attribute, value)
+  node.append(...children)
+  return node
+}
+
+function letter(index) {
+  return index < 26 ? String.fromCharCode(65 + index) : String(index + 1)
+}
+
+function verdict(score, total) {
+  if (score === total) return "All answers right."
+  if (score === 0) return "No right answers this time."
+  return `${total - score} wrong ${total - score === 1 ? "answer" : "answers"}.`
+}
diff --git a/app/javascript/controllers/screen_controller.js b/app/javascript/controllers/screen_controller.js
new file mode 100644
index 0000000..ffc384e
--- /dev/null
+++ b/app/javascript/controllers/screen_controller.js
@@ -0,0 +1,161 @@
+import { Controller } from "@hotwired/stimulus"
+import { follow, absolute, timeoutSignal } from "live"
+
+// The big screen (moderate/games/show). The page itself is rendered by the
+// server; this keeps it live:
+// - ScreenChannel pushes { version, players, answers } whenever they change,
+//   and at once when the game moves on (the status URL answers the same
+//   while the socket is down);
+// - the numbers go into the players/answers targets;
+// - a new version means the game moved on in another window (or another
+//   device): the page is fetched again and its content swapped in, without
+//   a reload. The window whose button was clicked is navigating already and
+//   skips it.
+//
+// The swap keeps this element, and so this controller and its socket
+// subscription. Replacing the element would unsubscribe and resubscribe
+// with the same identifier on the same socket; Action Cable runs those two
+// commands concurrently, and when the subscribe comes first it is dropped
+// while the client still believes it's subscribed: the screen would stop
+// following for good.
+// Arrow right, Page down and Space press the step button (clickers).
+//
+// The countdown of a timed question (timer target, see GamesHelper) runs
+// from the time left the server rendered, on this browser's monotonic
+// clock. The server owns the deadline and finishes the question at 0:00
+// (RoundTimer), which reaches every screen like any step. At 0:00 this
+// page also fetches itself (the server answers with the results), in case
+// that message is late.
+export default class extends Controller {
+  static targets = [ "players", "answers", "step", "timer" ]
+  static values = { game: String, version: Number, statusUrl: String }
+
+  connect() {
+    this.seenVersion = this.versionValue
+    this.live = follow({ channel: "ScreenChannel", game: this.gameValue }, {
+      received: (status) => this.update(status)
+    }, { pollURL: this.statusUrlValue, pollInterval: 3000 })
+  }
+
+  disconnect() {
+    this.live?.stop()
+    this.stopCountdown()
+    clearTimeout(this.timeUpTimer)
+  }
+
+  timerTargetConnected(element) {
+    const left = Number(element.dataset.remainingMs)
+    if (!Number.isFinite(left)) return
+
+    this.countdown = element
+    this.deadline = performance.now() + left
+    this.tick()
+  }
+
+  // A swap may connect the new countdown before it disconnects the old one.
+  timerTargetDisconnected(element) {
+    if (element === this.countdown) this.stopCountdown()
+  }
+
+  // Shows the time left and waits for the next change of the display (or
+  // runs now, e.g. when the tab comes back after timers were throttled).
+  tick() {
+    clearTimeout(this.tickTimer)
+    const timer = this.countdown
+    if (!timer || !timer.isConnected || this.deadline == null) return
+
+    const left = this.deadline - performance.now()
+    const seconds = Math.max(0, Math.ceil(left / 1000))
+    const text = clock(seconds)
+    if (timer.textContent !== text) timer.textContent = text
+    timer.classList.toggle("is-ending", seconds <= Number(timer.dataset.ending || 10))
+
+    if (left <= 0) return this.timeUp()
+    this.tickTimer = setTimeout(() => this.tick(), left - (seconds - 1) * 1000 + 5)
+  }
+
+  // 0:00. At most once a second, until the results are on screen.
+  timeUp() {
+    if (this.timeUpTimer) return
+
+    this.refresh()
+    this.timeUpTimer = setTimeout(() => {
+      this.timeUpTimer = null
+      this.tick()
+    }, 1000)
+  }
+
+  stopCountdown() {
+    clearTimeout(this.tickTimer)
+    this.countdown = null
+    this.deadline = null
+  }
+
+  update(status) {
+    if (!status || status.type !== "status") return
+    if (status.gone) return this.reload()
+    this.seenVersion = Math.max(this.seenVersion, status.version)
+    if (status.version > this.versionValue) return this.refresh()
+    if (status.version < this.versionValue) return // pushed before this page was rendered
+
+    this.playersTargets.forEach((target) => { target.textContent = status.players })
+    this.answersTargets.forEach((target) => { target.textContent = status.answers })
+  }
+
+  leave() {
+    this.leaving = true
+  }
+
+  shortcut(event) {
+    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return
+    if (![ "ArrowRight", "PageDown", " " ].includes(event.key)) return
+    if (event.target.closest && event.target.closest("a, button, input, textarea, select, [contenteditable]")) return
+    if (!this.hasStepTarget || this.leaving) return
+
+    event.preventDefault()
+    const button = this.stepTarget
+    if (button.form.requestSubmit) {
+      button.form.requestSubmit(button)
+    } else {
+      button.click()
+    }
+  }
+
+  async refresh() {
+    if (this.leaving || this.refreshing) return
+    this.refreshing = true
+
+    try {
+      const response = await fetch(absolute(window.location.pathname), {
+        headers: { Accept: "text/html" }, credentials: "same-origin", cache: "no-store", signal: timeoutSignal(10000)
+      })
+      if (!response.ok) throw new Error(`HTTP ${response.status}`)
+
+      const page = new DOMParser().parseFromString(await response.text(), "text/html")
+      const screen = page.querySelector('[data-controller~="screen"]')
+      if (!screen) throw new Error("No big screen in the response")
+      if (this.leaving) return
+
+      document.title = page.title
+      this.element.className = screen.className
+      this.element.replaceChildren(...[ ...screen.childNodes ]) // a snapshot: moving nodes empties the live list
+      this.versionValue = Number(screen.getAttribute("data-screen-version-value"))
+    } catch (error) {
+      return this.reload()
+    } finally {
+      this.refreshing = false
+    }
+
+    // The game moved on again while the page was on its way.
+    if (this.seenVersion > this.versionValue) this.refresh()
+  }
+
+  reload() {
+    if (!this.leaving) window.location.reload()
+  }
+}
+
+// 90 → "1:30", 5 → "0:05"
+function clock(seconds) {
+  return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`
+}
diff --git a/app/javascript/dom.js b/app/javascript/dom.js
new file mode 100644
index 0000000..3772633
--- /dev/null
+++ b/app/javascript/dom.js
@@ -0,0 +1,18 @@
+// Small DOM helpers for widgets drawn by JavaScript.
+
+// element("span", { class: "x" }, "text", otherNode): null/false children
+// are skipped, so conditional parts can be written inline.
+export function element(name, attributes = {}, ...children) {
+  const node = document.createElement(name)
+  for (const [ attribute, value ] of Object.entries(attributes)) {
+    if (value !== null && value !== undefined && value !== false) node.setAttribute(attribute, value === true ? "" : value)
+  }
+  node.append(...children.filter((child) => child !== null && child !== undefined && child !== false))
+  return node
+}
+
+// The letter in front of an option: A, B, C… (numbers past Z), as on the
+// server (ApplicationHelper#option_letter).
+export function letter(index) {
+  return index < 26 ? String.fromCharCode(65 + index) : String(index + 1)
+}
diff --git a/app/javascript/live.js b/app/javascript/live.js
new file mode 100644
index 0000000..7ef4df2
--- /dev/null
+++ b/app/javascript/live.js
@@ -0,0 +1,148 @@
+// Live updates for the game pages: an Action Cable subscription, with plain
+// HTTP polling while the socket is down. Conference Wi-Fi drops sockets (and
+// some networks block them), so a page must never depend on the socket
+// alone: Action Cable reconnects by itself, and until it has, `follow`
+// polls a JSON URL and hands the answers to the same `received` callback.
+//
+//   const live = follow({ channel: "PlayerChannel", code: "K7RZX" },
+//     { received(data) {…}, lost(status) {…} },
+//     { pollURL: "/play/K7RZX/state", pollInterval: 4000 })
+//   live.perform("heartbeat")   // only sent while connected
+//   live.connected, live.poll(), live.stop()
+//
+// Channels send a full state when a subscription starts, so whatever was
+// missed while disconnected is caught up on reconnect.
+import { createConsumer } from "@rails/actioncable"
+
+let consumer = null
+
+// URLs are built from location.origin: a page opened with credentials in
+// its URL (http://user:pass@host/…, as QA browsers may do) must not pass
+// them on. fetch() refuses such URLs; the browser still sends the cached
+// HTTP auth for same-origin requests.
+export function absolute(path) {
+  return new URL(path, window.location.origin).href
+}
+
+function cableURL() {
+  const url = new URL("/cable", window.location.origin)
+  url.protocol = url.protocol === "https:" ? "wss:" : "ws:"
+  return url.href
+}
+
+export function getConsumer() {
+  if (!consumer) consumer = createConsumer(cableURL())
+  return consumer
+}
+
+export function follow(params, handlers, options = {}) {
+  return new Follower(params, handlers, options)
+}
+
+class Follower {
+  constructor(params, handlers, { pollURL = null, pollInterval = 4000, pollAfter = 3000 } = {}) {
+    this.handlers = handlers
+    this.pollURL = pollURL
+    this.pollInterval = pollInterval
+    this.pollAfter = pollAfter
+    this.connected = false
+    this.stopped = false
+    this.pollTimer = null
+
+    this.subscription = this.subscribe(params, handlers)
+
+    // In case the socket never comes up at all.
+    this.schedulePoll(this.pollAfter)
+  }
+
+  subscribe(params, handlers) {
+    try {
+      return this.createSubscription(params, handlers)
+    } catch (error) {
+      // No usable WebSocket in this browser: polling only.
+      return null
+    }
+  }
+
+  createSubscription(params, handlers) {
+    return getConsumer().subscriptions.create(params, {
+      connected: () => {
+        this.connected = true
+        this.stopPolling()
+        handlers.connected?.()
+      },
+      disconnected: () => {
+        this.connected = false
+        this.schedulePoll(this.pollAfter)
+      },
+      // The socket may lack the cookies the page has (privacy settings):
+      // HTTP can still tell whether this page is valid.
+      rejected: () => {
+        this.connected = false
+        this.schedulePoll(0)
+      },
+      received: (data) => {
+        if (!this.stopped) handlers.received(data)
+      }
+    })
+  }
+
+  perform(action, data = {}) {
+    if (this.connected && !this.stopped && this.subscription) this.subscription.perform(action, data)
+  }
+
+  // Polls right away (unless the socket is up).
+  poll() {
+    this.stopPolling()
+    return this.fetchState()
+  }
+
+  stop() {
+    this.stopped = true
+    this.stopPolling()
+    if (this.subscription) this.subscription.unsubscribe()
+  }
+
+  // private
+
+  schedulePoll(delay) {
+    if (!this.pollURL || this.stopped || this.connected || this.pollTimer) return
+    this.pollTimer = setTimeout(() => {
+      this.pollTimer = null
+      this.fetchState()
+    }, delay)
+  }
+
+  stopPolling() {
+    clearTimeout(this.pollTimer)
+    this.pollTimer = null
+  }
+
+  async fetchState() {
+    if (!this.pollURL || this.stopped || this.connected) return
+
+    try {
+      const response = await fetch(absolute(this.pollURL), {
+        headers: { Accept: "application/json" }, credentials: "same-origin", cache: "no-store",
+        signal: timeoutSignal(8000)
+      })
+      if (response.status === 401 || response.status === 403 || response.status === 404) {
+        this.stopped = true
+        this.handlers.lost?.(response.status)
+        return
+      }
+      if (response.ok && !this.stopped) this.handlers.received(await response.json())
+    } catch (error) {
+      // Offline or timed out: try again below.
+    }
+    this.schedulePoll(this.pollInterval)
+  }
+}
+
+// An AbortSignal that fires after `ms` (requests on bad Wi-Fi can hang).
+export function timeoutSignal(ms) {
+  if (window.AbortSignal && AbortSignal.timeout) return AbortSignal.timeout(ms)
+  const controller = new AbortController()
+  setTimeout(() => controller.abort(), ms)
+  return controller.signal
+}
