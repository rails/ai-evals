diff --git a/test/channels/player_channel_test.rb b/test/channels/player_channel_test.rb
new file mode 100644
index 0000000..94412f9
--- /dev/null
+++ b/test/channels/player_channel_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class PlayerChannelTest < ActionCable::Channel::TestCase
+  setup do
+    @game = quizzes(:frontend).games.create!
+    @key = SecureRandom.alphanumeric(32)
+    @player = @game.players.create!(name: "Alice", browser_key: @key)
+  end
+
+  test "a player subscribes with the browser's cookie, streams the game and counts as present" do
+    stub_connection browser_key_digest: Player.digest(@key)
+    subscribe code: @game.code.downcase
+
+    assert subscription.confirmed?
+    assert_has_stream @game.stream_name
+    assert_equal [ @player.sync_payload.as_json ], transmissions
+    assert_equal 1, @player.connections.count
+    assert_equal 1, @game.screen_status[:players]
+
+    unsubscribe
+    assert_equal 0, @player.connections.count
+    assert_equal 0, @game.screen_status[:players]
+  end
+
+  test "strangers and unknown games are rejected" do
+    stub_connection browser_key_digest: nil
+    subscribe code: @game.code
+    assert subscription.rejected?
+
+    stub_connection browser_key_digest: Player.digest("someone else")
+    subscribe code: @game.code
+    assert subscription.rejected?
+
+    stub_connection browser_key_digest: Player.digest(@key)
+    subscribe code: "NOPE1"
+    assert subscription.rejected?
+    assert_equal 0, PlayerConnection.count
+  end
+
+  test "heartbeats keep a socket counted; a silent one drops out" do
+    stub_connection browser_key_digest: Player.digest(@key)
+    subscribe code: @game.code
+
+    travel PlayerConnection::LIVE_WINDOW - 5.seconds
+    perform :heartbeat
+    travel 10.seconds
+    assert_equal 1, @game.screen_status[:players]
+
+    travel PlayerConnection::LIVE_WINDOW
+    assert_equal 0, @game.screen_status[:players]
+  end
+
+  test "a heartbeat brings back a connection row that was cleaned up" do
+    stub_connection browser_key_digest: Player.digest(@key)
+    subscribe code: @game.code
+    PlayerConnection.delete_all
+
+    perform :heartbeat
+    assert_equal 1, @player.connections.count
+  end
+
+  test "sync sends the current state, not the one from subscribing" do
+    stub_connection browser_key_digest: Player.digest(@key)
+    subscribe code: @game.code
+    @game.advance("start", version: 0)
+
+    perform :sync
+    assert_equal "answering", transmissions.last.dig("state", "status")
+    assert_equal 1, transmissions.last.dig("state", "version")
+  end
+end
diff --git a/test/channels/screen_channel_test.rb b/test/channels/screen_channel_test.rb
new file mode 100644
index 0000000..551c4b1
--- /dev/null
+++ b/test/channels/screen_channel_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class ScreenChannelTest < ActionCable::Channel::TestCase
+  setup do
+    @game = quizzes(:frontend).games.create!
+  end
+
+  test "a big screen subscribes with the signed game id and gets the live numbers" do
+    stub_connection browser_key_digest: nil
+    subscribe game: @game.signed_id(purpose: :screen)
+
+    assert subscription.confirmed?
+    assert_equal [ { "version" => 0, "players" => 0, "answers" => 0, "type" => "status" } ], transmissions
+  end
+
+  test "pushes only changes" do
+    stub_connection browser_key_digest: nil
+    subscribe game: @game.signed_id(purpose: :screen)
+
+    subscription.send(:push_status)
+    assert_equal 1, transmissions.size
+
+    @game.players.create!(name: "Ada", browser_key: "a" * 32).connections.create!(seen_at: Time.current)
+    subscription.send(:push_status)
+    assert_equal 1, transmissions.last["players"]
+
+    @game.advance("start", version: 0)
+    subscription.send(:push_status)
+    assert_equal 1, transmissions.last["version"]
+    assert_equal 3, transmissions.size
+  end
+
+  test "a step reaches the big screen at once, without waiting for the next recompute" do
+    stub_connection browser_key_digest: nil
+    subscribe game: @game.signed_id(purpose: :screen)
+    assert_has_stream @game.screen_stream_name
+
+    @game.advance("start", version: 0)
+    broadcasts(@game.screen_stream_name).each { |message| subscription.send(:relay, message) }
+    assert_equal({ "version" => 1, "players" => 0, "answers" => 0, "type" => "status" }, transmissions.last)
+    assert_equal 2, transmissions.size
+
+    subscription.send(:push_status) # nothing new since the push
+    assert_equal 2, transmissions.size
+  end
+
+  test "plain or wrongly signed ids are rejected" do
+    stub_connection browser_key_digest: nil
+    [ @game.id, @game.signed_id, @game.signed_id(purpose: :other), "" ].each do |id|
+      subscribe game: id
+      assert subscription.rejected?, id.inspect
+    end
+  end
+end
