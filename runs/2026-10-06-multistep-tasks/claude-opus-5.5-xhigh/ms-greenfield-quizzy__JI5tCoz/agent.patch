+<%= button_to "Top #{count}", moderate_game_winners_path(game), params: { pick: "top", count: count },
+      class: "btn btn--pink btn--lg", form: { data: { submit_once: true, keep_scroll: true } } %>
+<%= button_to "Draw", moderate_game_winners_path(game), params: { pick: "draw", count: count },
+      class: "btn btn--light btn--lg", form: { data: { submit_once: true, keep_scroll: true } } %>
