@@ -0,0 +1,193 @@
+require "test_helper"
+
+# The timer: a deadline per question, fixed when it opens; at the deadline
+# the question finishes by itself, exactly like "Finish".
+class GameTimerTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+
+  setup do
+    # Whole seconds: `travel` drops the fractions, and deadlines are exact.
+    freeze_time
+    @quiz = quizzes(:frontend)
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    @game = @quiz.games.create!
+  end
+
+  test "opening a question fixes its deadline from the setting" do
+    @game.advance("start", version: 0)
+    round = @game.current_round
+
+    assert round.timed?
+    assert_equal 90.seconds.from_now, round.closes_at
+    assert_equal 90, round.time_left
+    assert_not round.time_up?
+    assert_equal 1, @game.version
+  end
+
+  test "without a timer a question has no deadline and never finishes by itself" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    @game.advance("start", version: 0)
+    round = @game.current_round
+
+    assert_nil round.closes_at
+    assert_nil round.time_left
+    travel 1.day
+    assert_not @game.finish_if_time_is_up
+    assert @game.reload.answering?
+  end
+
+  test "at 0:00 the question finishes like Finish: results, a new version, one broadcast for phones and screens" do
+    @game.advance("start", version: 0)
+    travel 89.seconds
+    assert_not @game.finish_if_time_is_up
+    assert @game.reload.answering?
+
+    travel 1.second
+    assert_broadcasts(@game.stream_name, 1) do
+      assert_broadcasts(@game.screen_stream_name, 1) do
+        assert @game.finish_if_time_is_up
+      end
+    end
+    assert @game.reload.results?
+    assert_equal 2, @game.version
+    round = @game.current_round
+    assert round.closed_at
+    assert round.timed_out?
+    assert_equal 0, round.time_left
+    assert_equal :results, @game.public_state[:status].to_sym
+    assert @game.public_state.key?(:correct)
+
+    # Only once.
+    assert_no_broadcasts(@game.stream_name) { assert_not @game.finish_if_time_is_up }
+    assert_equal 2, @game.reload.version
+  end
+
+  test "the moderator can still finish earlier; the timer then does nothing" do
+    @game.advance("start", version: 0)
+    travel 30.seconds
+    assert @game.advance("finish", version: 1)
+    round = @game.current_round
+    assert_not round.timed_out?
+
+    travel 2.minutes
+    assert_not @game.finish_if_time_is_up
+    assert_equal 2, @game.reload.version
+    assert @game.advance("next", version: 2), "Next works as always"
+    assert @game.answering?
+  end
+
+  test "a Finish click sent before the time ran out changes nothing once the timer finished" do
+    @game.advance("start", version: 0)
+    travel 91.seconds
+    assert @game.finish_if_time_is_up
+    assert_not @game.advance("finish", version: 1)
+    assert @game.reload.results?
+    assert_equal 2, @game.version
+  end
+
+  test "every question gets the full time, from the setting when it opens" do
+    @game.advance("start", version: 0)
+    travel 91.seconds
+    @game.finish_if_time_is_up
+    @quiz.update!(timer_minutes: 0, timer_seconds: 20)
+
+    @game.advance("next", version: 2)
+    assert_equal 20.seconds.from_now, @game.current_round.closes_at
+  end
+
+  test "changing the setting doesn't change the open question's deadline" do
+    @game.advance("start", version: 0)
+    @quiz.update!(timer_minutes: 0, timer_seconds: 5)
+
+    travel 10.seconds
+    assert_not @game.reload.finish_if_time_is_up
+    assert_equal 80, @game.current_round.time_left
+  end
+
+  test "picks that arrive in time count; later ones are too late and finish the question" do
+    player = @game.players.create!(name: "Ada", browser_key: "a" * 32)
+    late = @game.players.create!(name: "Bob", browser_key: "b" * 32)
+    @game.advance("start", version: 0)
+    round = @game.current_round
+    option = round.question.options.first
+
+    travel 90.seconds
+    # Arrived a moment before the deadline, saved a moment after it.
+    assert_equal :saved, @game.record_answer(player, round_id: round.id, option_id: option.id, at: 0.01.seconds.ago)
+
+    assert_broadcasts(@game.stream_name, 1) do
+      assert_equal :closed, @game.record_answer(late, round_id: round.id, option_id: option.id)
+    end
+    assert @game.reload.results?
+    assert_equal [ player ], round.answers.map(&:player)
+  end
+
+  test "the phones learn nothing about the timer" do
+    @game.advance("start", version: 0)
+    state = @game.public_state.to_json
+    assert_no_match(/closes|deadline|timer|time_left/i, state)
+
+    player = @game.players.create!(name: "Ada", browser_key: "a" * 32)
+    assert_no_match(/closes|deadline|timer|time_left/i, player.sync_payload.to_json)
+  end
+
+  test "RoundTimer.tick finishes the questions whose time is up, in every game, and returns the next deadline" do
+    other = @quiz.games.create!
+    @game.advance("start", version: 0)
+    travel 30.seconds
+    other.advance("start", version: 0)
+    untimed = quizzes(:empty).games.create!
+
+    assert_equal @game.current_round.closes_at, RoundTimer.tick
+    travel 61.seconds
+    assert_equal other.current_round.closes_at, RoundTimer.tick
+    assert @game.reload.results?
+    assert other.reload.answering?
+
+    travel 30.seconds
+    assert_nil RoundTimer.tick
+    assert other.reload.results?
+    assert untimed.reload.lobby?
+  end
+end
+
+# The thread itself, on the real clock (no time travel).
+class RoundTimerThreadTest < ActiveSupport::TestCase
+  setup do
+    @quiz = quizzes(:frontend)
+    @quiz.update!(timer_seconds: 1)
+    @game = @quiz.games.create!
+    RoundTimer.enabled = true
+  end
+
+  teardown do
+    RoundTimer.stop
+    RoundTimer.enabled = false
+  end
+
+  test "opening a timed question starts the timer, which finishes it at the deadline" do
+    assert_not RoundTimer.running?
+    @game.advance("start", version: 0)
+    assert RoundTimer.running?
+
+    round = @game.current_round
+    sleep 0.1 until @game.reload.results? || Time.current > round.closes_at + 3
+    assert @game.results?, "finished by itself"
+    round.reload
+    assert_operator round.closed_at, :>=, round.closes_at
+    assert_operator round.closed_at - round.closes_at, :<, 0.5, "on time"
+  end
+
+  test "stop and start" do
+    RoundTimer.start
+    assert RoundTimer.running?
+    RoundTimer.stop
+    assert_not RoundTimer.running?
+  end
+
+  test "it stays off while disabled" do
+    RoundTimer.enabled = false
+    @game.advance("start", version: 0)
+    assert_not RoundTimer.running?
+  end
+end
diff --git a/test/models/player_test.rb b/test/models/player_test.rb
new file mode 100644
index 0000000..eaea4e5
--- /dev/null
+++ b/test/models/player_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class PlayerTest < ActiveSupport::TestCase
+  setup do
+    @game = quizzes(:frontend).games.create!
+  end
+
+  test "names are squished, required and short" do
+    assert_equal "Ada Lovelace", @game.players.create!(name: "  Ada \n  Lovelace ", browser_key: "k" * 32).name
+    assert_not @game.players.build(name: "   ", browser_key: "x" * 32).valid?
+    assert_not @game.players.build(name: "x" * 31, browser_key: "x" * 32).valid?
+    assert @game.players.build(name: "x" * 30, browser_key: "x" * 32).valid?
+  end
+
+  test "keeps only the digest of the browser key, and is found by the key" do
+    key = SecureRandom.alphanumeric(32)
+    player = @game.players.create!(name: "Ada", browser_key: key)
+
+    assert_equal OpenSSL::Digest::SHA256.hexdigest(key), player.browser_key_digest
+    assert_not_includes player.attributes.values.map(&:to_s), key
+    assert_equal player, @game.players.find_by_browser_key(key)
+    assert_nil @game.players.find_by_browser_key("other")
+    assert_nil @game.players.find_by_browser_key(nil)
+    assert_nil quizzes(:frontend).games.create!.players.find_by_browser_key(key), "players belong to one game"
+  end
+
+  test "one player per browser and game" do
+    @game.players.create!(name: "Ada", browser_key: "k" * 32)
+    assert_raises(ActiveRecord::RecordNotUnique) { @game.players.create!(name: "Bob", browser_key: "k" * 32) }
+  end
+
+  test "the sync payload has the state, the player and the answer to the current question" do
+    player = @game.players.create!(name: "Ada", browser_key: "k" * 32)
+    assert_equal({ type: "sync", state: { version: 0, status: "lobby" }, player: { id: player.id, name: "Ada" }, answer: nil }, player.sync_payload)
+
+    @game.advance("start", version: 0)
+    round = @game.current_round
+    @game.record_answer(player, round_id: round.id, option_id: options(:http_503).id)
+    assert_equal({ round: round.id, option: options(:http_503).id }, player.reload.sync_payload[:answer])
+
+    @game.advance("finish", version: 1)
+    @game.advance("next", version: 2)
+    assert_nil player.reload.sync_payload[:answer]
+  end
+end
diff --git a/test/models/question_test.rb b/test/models/question_test.rb
new file mode 100644
index 0000000..ba14623
--- /dev/null
+++ b/test/models/question_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class QuestionTest < ActiveSupport::TestCase
+  setup { @quiz = quizzes(:empty) }
+
+  test "saves filled option rows in row order and skips empty ones" do
+    question = @quiz.questions.create!(body: "Which planet is the largest?", option_rows: {
+      "0" => { title: "Jupiter", correct: "1" },
+      "1" => { title: "  " },
+      "2" => { title: "Saturn" },
+      "10" => { title: "Earth", correct: "0" }
+    })
+
+    assert_equal [ [ "Jupiter", true, 1 ], [ "Saturn", false, 2 ], [ "Earth", false, 3 ] ],
+      question.options.reload.map { |option| [ option.title, option.correct, option.position ] }
+  end
+
+  test "needs at least two options" do
+    question = @quiz.questions.new(body: "Q", option_rows: [ { title: "Only", correct: "1" }, { title: "" } ])
+
+    assert_not question.valid?
+    assert_equal [ "Add at least two options" ], question.errors.full_messages
+  end
+
+  test "needs a correct option, and an empty correct row doesn't count" do
+    question = @quiz.questions.new(body: "Q", option_rows: [ { title: "A" }, { title: "B" }, { title: "", correct: "1" } ])
+
+    assert_not question.valid?
+    assert_equal [ "Mark at least one option as correct" ], question.errors.full_messages
+  end
+
+  test "several correct options are fine" do
+    assert @quiz.questions.new(body: "Q", option_rows: [ { title: "A", correct: "1" }, { title: "B", correct: "1" } ]).valid?
+  end
+
+  test "needs its text" do
+    question = @quiz.questions.new(body: " ", option_rows: [ { title: "A", correct: "1" }, { title: "B" } ])
+
+    assert_not question.valid?
+    assert_includes question.errors.full_messages, "Question can't be blank"
+  end
+
+  test "keeps the submitted rows, blank ones included, when invalid" do
+    question = @quiz.questions.new(body: "Q", option_rows: [ { title: "A" }, { title: "" }, { title: "C" } ])
+
+    assert_not question.valid?
+    assert_equal [ "A", "", "C" ], question.option_rows.map(&:title)
+  end
+
+  test "editing updates, removes blanked and missing options, and adds new ones" do
+    question = questions(:http)
+    o418, o429, o503 = question.options.to_a
+
+    question.update!(option_rows: [
+      { id: o429.id, title: "429", correct: "1" },
+      { id: o418.id, title: "" },
+      { title: "409" }
+    ])
+
+    assert_equal [ [ o429.id, "429", true ], [ nil, "409", false ] ],
+      question.options.reload.map { |option| [ (option.id if option.id == o429.id), option.title, option.correct ] }
+    assert_not Option.exists?(o418.id)
+    assert_not Option.exists?(o503.id)
+  end
+
+  test "a failed edit changes nothing" do
+    question = questions(:http)
+
+    assert_not question.update(option_rows: [ { id: options(:http_429).id, title: "429", correct: "1" } ])
+    assert_equal [ "418", "429", "503" ], question.reload.options.map(&:title)
+  end
+
+  test "new questions go last" do
+    question = quizzes(:frontend).questions.create!(body: "Q", option_rows: [ { title: "A", correct: "1" }, { title: "B" } ])
+
+    assert_equal question, quizzes(:frontend).questions.last
+  end
+
+  test "moves up and down within its quiz" do
+    quiz = quizzes(:frontend)
+
+    assert questions(:websocket).move(:up)
+    assert_equal [ questions(:websocket), questions(:http), questions(:css) ], quiz.questions.reload.to_a
+
+    assert_not questions(:websocket).reload.move(:up)
+    assert questions(:http).reload.move(:down)
+    assert_equal [ questions(:websocket), questions(:css), questions(:http) ], quiz.questions.reload.to_a
+    assert_not questions(:http).reload.move(:down)
+  end
+end
diff --git a/test/models/quiz_import_test.rb b/test/models/quiz_import_test.rb
new file mode 100644
index 0000000..dbcc25d
--- /dev/null
+++ b/test/models/quiz_import_test.rb
@@ -0,0 +1,188 @@
+require "test_helper"
+
+class QuizImportTest < ActiveSupport::TestCase
+  EXAMPLE = {
+    "title" => "Frontend Fest 2026",
+    "questions" => [
+      { "text" => "Which HTTP status code means \"Too Many Requests\"?", "active" => true,
+        "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ] },
+      { "text" => "What does CSS stand for?", "active" => false,
+        "options" => [ { "text" => "Cascading Style Sheets", "correct" => true }, { "text" => "Computer Style System", "correct" => false } ] }
+    ]
+  }.freeze
+
+  test "creates a new quiz with its questions and options, in order" do
+    import = QuizImport.new(json: EXAMPLE.to_json)
+
+    assert_difference -> { Quiz.count } => 1, -> { Question.count } => 2, -> { Option.count } => 4 do
+      assert import.save
+    end
+
+    quiz = import.quiz
+    assert quiz.persisted?
+    assert_equal "Frontend Fest 2026", quiz.title
+    assert_equal [ [ "Which HTTP status code means \"Too Many Requests\"?", true, 1 ], [ "What does CSS stand for?", false, 2 ] ],
+      quiz.questions.map { |question| [ question.body, question.active, question.position ] }
+    assert_equal [ [ "418", false, 1 ], [ "429", true, 2 ] ],
+      quiz.questions.first.options.map { |option| [ option.title, option.correct, option.position ] }
+  end
+
+  test "always creates a new quiz, also when the title exists" do
+    existing = quizzes(:frontend)
+
+    assert_difference -> { Quiz.where(title: existing.title).count } => 1 do
+      assert QuizImport.new(json: existing.export_json).save
+    end
+    assert_equal 3, existing.questions.reload.size
+  end
+
+  test "an export imports back to the same contents" do
+    import = QuizImport.new(json: quizzes(:frontend).export_json)
+
+    assert import.save
+    assert_not_equal quizzes(:frontend), import.quiz
+    assert_equal quizzes(:frontend).export_json, import.quiz.export_json
+  end
+
+  test "active defaults to true and correct to false" do
+    import = QuizImport.new(json: { title: "Defaults", questions: [
+      { text: "Q", options: [ { text: "A", correct: true }, { text: "B" } ] } ] }.to_json)
+
+    assert import.save
+    question = import.quiz.questions.sole
+    assert question.active?
+    assert_equal [ true, false ], question.options.map(&:correct)
+  end
+
+  test "settings aren't imported: the new quiz has the default timer and number of winners" do
+    source = quizzes(:frontend)
+    source.update!(timer_minutes: 1, timer_seconds: 30, winners_count: 5)
+    json = JSON.parse(source.export_json).merge("timer_minutes" => 2, "timer_seconds" => 15, "timer" => 90).to_json
+
+    import = QuizImport.new(json: json)
+    assert import.save
+    assert_equal [ 0, 0, 3 ], [ import.quiz.timer_minutes, import.quiz.timer_seconds, import.quiz.winners_count ]
+    assert_not import.quiz.timer?
+  end
+
+  test "a quiz without questions is fine" do
+    assert QuizImport.new(json: { title: "Nothing yet", questions: [] }.to_json).save
+  end
+
+  test "strips texts and skips blank options like the question form" do
+    import = QuizImport.new(json: { title: "  Spaces  ", questions: [
+      { text: "  Q  ", options: [ { text: " ", correct: true }, { text: " A ", correct: true }, { text: "" }, { text: "B" } ] } ] }.to_json)
+
+    assert import.save
+    assert_equal "Spaces", import.quiz.title
+    question = import.quiz.questions.sole
+    assert_equal "Q", question.body
+    assert_equal [ [ "A", true, 1 ], [ "B", false, 2 ] ], question.options.map { |option| [ option.title, option.correct, option.position ] }
+  end
+
+  test "ignores unknown keys and a byte order mark" do
+    json = "\uFEFF" + { title: "Extra", id: 7, questions: [
+      { id: 1, text: "Q", position: 9, options: [ { id: 2, text: "A", correct: true }, { text: "B" } ] } ] }.to_json
+
+    assert QuizImport.new(json: json).save
+  end
+
+  test "questions follow the rules of the question form" do
+    assert_import_errors({ title: "Rules", questions: [
+      { text: " ", options: [ { text: "A", correct: true }, { text: "B" } ] },
+      { text: "One option", options: [ { text: "A", correct: true }, { text: "" } ] },
+      { text: "Nothing correct", options: [ { text: "A" }, { text: "B", correct: false } ] },
+      { text: "A blank correct row doesn't count", options: [ { text: "A" }, { text: "B" }, { text: "  ", correct: true } ] },
+      { text: "No options", options: [] }
+    ] }, [
+      "Question 1: \"text\" can't be blank",
+      "Question 2: Add at least two options",
+      "Question 3: Mark at least one option as correct",
+      "Question 4: Mark at least one option as correct",
+      "Question 5: Add at least two options",
+      "Question 5: Mark at least one option as correct"
+    ])
+  end
+
+  test "reports a missing or blank title" do
+    assert_import_errors({ questions: [] }, [ "\"title\" is missing" ])
+    assert_import_errors({ title: " ", questions: [] }, [ "\"title\" can't be blank" ])
+  end
+
+  test "reports keys that are missing or of the wrong type" do
+    assert_import_errors({}, [ "\"title\" is missing", "\"questions\" is missing" ])
+    assert_import_errors({ title: 2026, questions: { text: "Q" } }, [ "\"title\" must be a string", "\"questions\" must be an array" ])
+    assert_import_errors({ title: "Types", questions: [
+      "Q",
+      { options: [ { text: "A", correct: true }, { text: "B" } ] },
+      { text: [ "Q" ], active: "false", options: "A, B" },
+      { text: "Q", active: nil, options: [ { text: "A", correct: 1 }, "B", {}, { text: 429 }, { text: "C", correct: true } ] }
+    ] }, [
+      "Question 1: must be an object with \"text\" and \"options\"",
+      "Question 2: \"text\" is missing",
+      "Question 3: \"text\" must be a string",
+      "Question 3: \"active\" must be true or false",
+      "Question 3: \"options\" must be an array",
+      "Question 4: \"active\" must be true or false",
+      "Question 4, option 1: \"correct\" must be true or false",
+      "Question 4, option 2: must be an object with \"text\"",
+      "Question 4, option 3: \"text\" is missing",
+      "Question 4, option 4: \"text\" must be a string"
+    ])
+  end
+
+  test "reports JSON that isn't a quiz object" do
+    [ [], "Frontend Fest", 42, nil ].each do |data|
+      assert_import_errors(data, [ "The JSON must be an object with \"title\" and \"questions\"" ])
+    end
+  end
+
+  test "reports empty and invalid JSON with its location, without echoing it" do
+    assert_import_json_errors("", [ "The JSON is empty" ])
+    assert_import_json_errors(" \n ", [ "The JSON is empty" ])
+    assert_import_json_errors("not json", [ "This isn't valid JSON (line 1, column 1)" ])
+    assert_import_json_errors(%({\n  "title": "Trailing",\n  "questions": [],\n}), [ "This isn't valid JSON (line 4, column 1)" ])
+    assert_import_json_errors(%({"title": "A", "title": "B", "questions": []}), [ "The key \"title\" appears twice in one object (line 1, column 1)" ])
+    assert_import_json_errors(("[" * 1000) + ("]" * 1000), [ "This isn't valid JSON" ])
+  end
+
+  test "nothing is created when a single question breaks a rule" do
+    data = EXAMPLE.deep_dup
+    data["questions"] << { "text" => "Broken", "options" => [ { "text" => "Only one", "correct" => true } ] }
+
+    assert_no_difference %w[ Quiz.count Question.count Option.count ] do
+      assert_not QuizImport.new(json: data.to_json).save
+    end
+  end
+
+  test "nothing is created when saving fails halfway" do
+    # The database refuses the second question's first option, after the
+    # quiz and the first question are written.
+    connection = ActiveRecord::Base.connection
+    connection.execute(<<~SQL)
+      CREATE TEMP TRIGGER refuse_option BEFORE INSERT ON options WHEN NEW.title = 'Cascading Style Sheets'
+      BEGIN SELECT RAISE(ABORT, 'disk full'); END
+    SQL
+
+    assert_no_difference %w[ Quiz.count Question.count Option.count ] do
+      assert_raises(ActiveRecord::StatementInvalid) { QuizImport.new(json: EXAMPLE.to_json).save }
+    end
+  ensure
+    connection&.execute("DROP TRIGGER IF EXISTS refuse_option")
+  end
+
+  private
+    def assert_import_errors(data, messages)
+      assert_import_json_errors(data.to_json, messages)
+    end
+
+    def assert_import_json_errors(json, messages)
+      import = QuizImport.new(json: json)
+
+      assert_no_difference %w[ Quiz.count Question.count Option.count ] do
+        assert_not import.save, "imported #{json}"
+      end
+      assert_equal messages, import.errors.full_messages
+      assert_nil import.quiz
+    end
+end
diff --git a/test/models/quiz_test.rb b/test/models/quiz_test.rb
new file mode 100644
index 0000000..fb4723f
--- /dev/null
+++ b/test/models/quiz_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class QuizTest < ActiveSupport::TestCase
+  test "needs a title" do
+    quiz = Quiz.new(title: "  ")
+
+    assert_not quiz.valid?
+    assert_equal [ "Title can't be blank" ], quiz.errors.full_messages
+  end
+
+  test "has 3 winners by default; the number of winners is a whole number, at least 1" do
+    assert_equal 3, Quiz.new.winners_count
+    assert_equal 3, Quiz.create!(title: "DevOps Days").winners_count
+
+    quiz = quizzes(:frontend)
+    { "0" => "must be greater than or equal to 1", "-2" => "must be greater than or equal to 1",
+      "1.5" => "must be an integer", "two" => "is not a number", "" => "is not a number",
+      "10001" => "must be less than or equal to 10000" }.each do |value, message|
+      quiz.winners_count = value
+      assert_not quiz.valid?, value.inspect
+      assert_equal [ "Number of winners #{message}" ], quiz.errors.full_messages, value.inspect
+    end
+
+    quiz.winners_count = "1"
+    assert quiz.valid?
+  end
+
+  test "has no timer by default" do
+    quiz = Quiz.create!(title: "DevOps Days")
+    assert_equal [ 0, 0 ], [ quiz.timer_minutes, quiz.timer_seconds ]
+    assert_equal 0, quiz.timer_duration
+    assert_not quiz.timer?
+  end
+
+  test "the timer is minutes and seconds per question" do
+    quiz = quizzes(:frontend)
+    quiz.update!(timer_minutes: "1", timer_seconds: "30")
+    assert_equal 90, quiz.timer_duration
+    assert quiz.timer?
+
+    quiz.update!(timer_minutes: "0", timer_seconds: "5")
+    assert_equal 5, quiz.timer_duration
+
+    quiz.update!(timer_minutes: "2", timer_seconds: "0")
+    assert_equal 120, quiz.timer_duration
+  end
+
+  test "timer fields are whole numbers, seconds below a minute; empty means 0" do
+    quiz = quizzes(:frontend)
+    { [ "-1", "0" ] => [ "Timer minutes must be greater than or equal to 0" ],
+      [ "0", "-1" ] => [ "Timer seconds must be greater than or equal to 0" ],
+      [ "0", "60" ] => [ "Timer seconds must be less than or equal to 59" ],
+      [ "1000", "0" ] => [ "Timer minutes must be less than or equal to 999" ],
+      [ "1.5", "two" ] => [ "Timer minutes must be an integer", "Timer seconds is not a number" ] }.each do |(minutes, seconds), messages|
+      quiz.assign_attributes(timer_minutes: minutes, timer_seconds: seconds)
+      assert_not quiz.valid?, [ minutes, seconds ].inspect
+      assert_equal messages, quiz.errors.full_messages, [ minutes, seconds ].inspect
+    end
+
+    quiz.assign_attributes(timer_minutes: "", timer_seconds: " 45 ")
+    assert quiz.valid?
+    assert_equal [ 0, 45 ], [ quiz.timer_minutes, quiz.timer_seconds ]
+
+    quiz.assign_attributes(timer_minutes: "999", timer_seconds: "59")
+    assert quiz.valid?
+  end
+
+  test "strips the title" do
+    assert_equal "Frontend Fest", Quiz.new(title: "  Frontend Fest ").title
+  end
+
+  test "active questions keep their order" do
+    assert_equal [ questions(:http), questions(:websocket) ], quizzes(:frontend).active_questions
+  end
+
+  test "deleting removes its questions and options" do
+    assert_difference -> { Question.count } => -3, -> { Option.count } => -7 do
+      quizzes(:frontend).destroy
+    end
+  end
+end
+
+class QuizExportTest < ActiveSupport::TestCase
+  test "exports exactly the title and the questions with their options, in order" do
+    assert_equal({
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        { "text" => "Which HTTP status code means \"Too Many Requests\"?", "active" => true, "options" => [
+          { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true }, { "text" => "503", "correct" => false } ] },
+        { "text" => "Which protocol keeps a two-way connection between a browser and a server?", "active" => true, "options" => [
+          { "text" => "WebSocket", "correct" => true }, { "text" => "SMTP", "correct" => false } ] },
+        { "text" => "What does CSS stand for?", "active" => false, "options" => [
+          { "text" => "Cascading Style Sheets", "correct" => true }, { "text" => "Computer Style System", "correct" => false } ] }
+      ]
+    }, quizzes(:frontend).export_data)
+  end
+
+  test "the JSON keeps the keys in format order and follows question order" do
+    questions(:css).move(:up)
+    data = JSON.parse(quizzes(:frontend).export_json)
+
+    assert_equal %w[ title questions ], data.keys
+    assert_equal [ %w[ text active options ] ], data["questions"].map(&:keys).uniq
+    assert_equal [ %w[ text correct ] ], data["questions"].flat_map { |question| question["options"] }.map(&:keys).uniq
+    assert_equal [ "Which HTTP status code means \"Too Many Requests\"?", "What does CSS stand for?",
+      "Which protocol keeps a two-way connection between a browser and a server?" ], data["questions"].map { |question| question["text"] }
+  end
+
+  test "the JSON is indented with one option per line" do
+    assert_includes quizzes(:frontend).export_json, %(\n        { "text": "429", "correct": true },\n)
+    assert_equal "{\n  \"title\": \"Empty quiz\",\n  \"questions\": []\n}", quizzes(:empty).export_json
+  end
+
+  test "the timer is a setting, not part of the export" do
+    quiz = quizzes(:frontend)
+    quiz.update!(timer_minutes: 1, timer_seconds: 30)
+
+    assert_equal %w[ title questions ], quiz.export_data.keys
+    assert_no_match(/timer|minutes|seconds/i, quiz.export_json)
+  end
+
+  test "the JSON keeps special characters intact" do
+    quiz = Quiz.create!(title: "Ünïcode <b>&</b> \"quoted\" \\ 🎉")
+    quiz.questions.create!(body: "Line one\nline two", option_rows: [ { title: "\t<script>", correct: "1" }, { title: "Ω" } ])
+
+    assert_equal quiz.export_data, JSON.parse(quiz.export_json)
+  end
+end
