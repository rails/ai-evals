+require "application_system_test_case"
+
+class QuizzesTest < ApplicationSystemTestCase
+  test "creating, renaming and deleting a quiz" do
+    visit moderate_root_path
+    click_on "New quiz"
+    click_on "Save quiz"
+    assert_text "Title can't be blank"
+
+    fill_in "Title", with: "DevOps Days"
+    click_on "Save quiz"
+    assert_selector "h1", text: "DevOps Days"
+    assert_button "Add question"
+    assert_link "Preview"
+
+    click_on "Settings"
+    assert_field "Title", with: "DevOps Days"
+    fill_in "Title", with: "DevOps Days 2026"
+    click_on "Save quiz"
+    assert_selector "h1", text: "DevOps Days 2026"
+
+    click_on "All quizzes"
+    within("li", text: "DevOps Days 2026") { click_on "DevOps Days 2026" }
+    click_on "Settings"
+    dismiss_confirm("Delete this quiz and all its questions?") { click_on "Delete quiz" }
+    assert_button "Delete quiz"
+    accept_confirm { click_on "Delete quiz" }
+
