+<%# After the end: the leaderboard, one <li> per player in final order with
+    the place, the name and the points; winners get the "Winner" mark.
+    The control bar has the prize buttons (moderate/games/show). %>
+<% leaderboard = game.leaderboard.to_a %>
+<%= tag.div class: [ "leaderboard-layout", { "leaderboard-layout--empty": leaderboard.empty? } ] do %>
+  <div class="stage-over__head">
+    <div class="screen__kicker"><%= game.quiz.title %></div>
+    <h1 class="lobby__title leaderboard-layout__title">The quiz is over</h1>
+    <p class="stage-over__lead">Thanks for playing!</p>
+  </div>
+
+  <% if leaderboard.any? %>
+    <ol class="leaderboard" aria-label="Leaderboard">
+      <% leaderboard.each.with_index(1) do |player, place| %>
+        <%= tag.li class: [ "leader", { "is-winner": player.winner? } ], id: dom_id(player) do %>
+          <span class="leader__place"><%= place %></span>
+          <span class="leader__who">
+            <span class="leader__name"><%= player.name %></span>
+            <% if player.winner? %><span class="leader__badge">Winner</span><% end %>
+          </span>
+          <span class="leader__score"><%= points_text(player.points) %></span>
+        <% end %>
+      <% end %>
+    </ol>
+  <% else %>
+    <p class="stage-over__empty">Nobody joined this game.</p>
+  <% end %>
+<% end %>
diff --git a/app/views/moderate/games/_question.html.erb b/app/views/moderate/games/_question.html.erb
new file mode 100644
index 0000000..0a07fc4
--- /dev/null
+++ b/app/views/moderate/games/_question.html.erb
@@ -0,0 +1,29 @@
+<%# The current question on the big screen. With `counts` (after Finish)
+    each option shows its number of answers, and the correct ones say so.
+    With a timer, the countdown sits opposite the question number. %>
+<% counts = local_assigns[:counts] %>
+<div class="stage-question__head">
+  <div class="stage-question__num"><%= game_progress(game) %></div>
+  <%= round_countdown(round) %>
+</div>
+<% if round.question %>
+  <div class="stage-question__body"><%= round.question.body %></div>
+  <% total = counts ? counts.sum(&:last) : 0 %>
+  <%= tag.ol class: [ "stage-options", { "stage-options--results": counts } ] do %>
+    <% (counts || round.question.options.map { |option| [ option, nil ] }).each_with_index do |(option, count), index| %>
+      <% correct = counts && option.correct? %>
+      <%= tag.li class: [ "stage-option", { "is-correct": correct } ],
+            style: ("--share: #{total.zero? ? 0 : (100.0 * count / total).round(1)}%" if counts) do %>
+        <% if counts %><span class="stage-option__bar" aria-hidden="true"></span><% end %>
+        <span class="stage-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+        <span class="stage-option__title"><%= option.title %></span>
+        <% if correct %><span class="stage-option__mark">Correct</span><% end %>
+        <% if counts %>
+          <span class="stage-option__count"><%= count %><span class="stage-option__unit"> <%= count == 1 ? "answer" : "answers" %></span></span>
+        <% end %>
+      <% end %>
+    <% end %>
+  <% end %>
+<% else %>
+  <div class="stage-question__body">This question was deleted.</div>
+<% end %>
