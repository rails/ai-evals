+  end
+
+  add_foreign_key "answers", "options", on_delete: :cascade
+  add_foreign_key "answers", "players", on_delete: :cascade
+  add_foreign_key "answers", "rounds", on_delete: :cascade
+  add_foreign_key "games", "quizzes", on_delete: :cascade
+  add_foreign_key "options", "questions", on_delete: :cascade
+  add_foreign_key "player_connections", "players", on_delete: :cascade
+  add_foreign_key "players", "games", on_delete: :cascade
+  add_foreign_key "questions", "quizzes", on_delete: :cascade
+  add_foreign_key "rounds", "games", on_delete: :cascade
+  add_foreign_key "rounds", "questions", on_delete: :nullify
+end
