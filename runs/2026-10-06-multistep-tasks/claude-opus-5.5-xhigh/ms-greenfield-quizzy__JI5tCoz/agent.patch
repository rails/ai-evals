diff --git a/app/models/player.rb b/app/models/player.rb
new file mode 100644
index 0000000..ea13007
--- /dev/null
+++ b/app/models/player.rb
@@ -0,0 +1,58 @@
+# Someone playing a game from their phone. No account: the browser keeps a
+# random key in a cookie (PlayerIdentity) and the player stores its SHA-256,
+# so the same browser always continues as the same player.
+class Player < ApplicationRecord
+  NAME_MAX_LENGTH = 30
+
+  # A player counts as "currently in the game" while one of their sockets is
+  # alive (see PlayerConnection), or, when WebSockets fail and the phone
+  # polls over HTTP instead, for a while after each poll.
+  POLL_WINDOW = 12.seconds
+
+  belongs_to :game, inverse_of: :players
+  has_many :connections, class_name: "PlayerConnection", dependent: :delete_all
+  has_many :answers, dependent: :delete_all
+
+  normalizes :name, with: ->(name) { name.squish }
+
+  validates :name, presence: true, length: { maximum: NAME_MAX_LENGTH }
+  validates :browser_key_digest, presence: true
+
+  scope :online, -> {
+    where(id: PlayerConnection.live.select(:player_id)).or(where(polled_at: POLL_WINDOW.ago..))
+  }
+
+  # Leaderboard order (Game#leaderboard): more points first, then less time
+  # for the correct answers, then who joined first. Points are settled when
+  # the game ends; until then everyone counts as 0.
+  scope :ranked, -> {
+    order(Arel.sql("COALESCE(players.points, 0) DESC, COALESCE(players.correct_time, 0) ASC, players.id ASC"))
+  }
+
+  def self.digest(browser_key)
+    OpenSSL::Digest::SHA256.hexdigest(browser_key.to_s)
+  end
+
+  def self.find_by_browser_key(browser_key)
+    find_by(browser_key_digest: digest(browser_key)) if browser_key.present?
+  end
+
+  def browser_key=(browser_key)
+    self.browser_key_digest = self.class.digest(browser_key)
+  end
+
+  # Everything the phone needs to draw itself: the public game state, the
+  # player's id (to find their own place in the results) and name, and the
+  # player's saved answer to the current question. Sent on every
+  # (re)subscription and by the HTTP fallback.
+  def sync_payload
+    round = game.current_round
+    answer = round && round.answers.find_by(player_id: id)
+    {
+      type: "sync",
+      state: game.public_state,
+      player: { id: id, name: name },
+      answer: answer && { round: round.id, option: answer.option_id }
+    }
+  end
+end
diff --git a/app/models/player_connection.rb b/app/models/player_connection.rb
new file mode 100644
index 0000000..4d16f2a
--- /dev/null
+++ b/app/models/player_connection.rb
@@ -0,0 +1,13 @@
+# An open WebSocket subscription of a player (PlayerChannel). Created on
+# subscribe, deleted on unsubscribe, and `seen_at` is refreshed by the
+# phone's heartbeat. A socket that died without closing (phone left the
+# Wi-Fi) stops being counted once its heartbeats stop: LIVE_WINDOW.
+class PlayerConnection < ApplicationRecord
+  HEARTBEAT_INTERVAL = 10.seconds # the phone's side, see play_controller.js
+  LIVE_WINDOW = 3 * HEARTBEAT_INTERVAL
+
+  belongs_to :player
+
+  scope :live, -> { where(seen_at: LIVE_WINDOW.ago..) }
+  scope :stale, -> { where(seen_at: ...LIVE_WINDOW.ago) }
+end
diff --git a/app/models/question.rb b/app/models/question.rb
new file mode 100644
index 0000000..55d34d6
--- /dev/null
+++ b/app/models/question.rb
@@ -0,0 +1,93 @@
+# A single-choice question with text options.
+#
+# The question form submits the complete list of option rows through
+# #option_rows= (see the comment there). Option rules:
+# * empty rows are skipped,
+# * at least MINIMUM_OPTIONS options,
+# * at least one correct option (several are fine).
+class Question < ApplicationRecord
+  MINIMUM_OPTIONS = 2
+
+  belongs_to :quiz, inverse_of: :questions
+  has_many :options, -> { ordered }, dependent: :delete_all, inverse_of: :question, autosave: true
+  # Rounds keep their place in a game when the question goes (the foreign
+  # key nullifies them); answers go with the options.
+  has_many :rounds
+
+  normalizes :body, with: ->(body) { body.strip }
+
+  validates :body, presence: true
+  validate :options_follow_the_rules
+
+  before_create :append_to_quiz
+
+  scope :ordered, -> { order(:position, :id) }
+  scope :active, -> { where(active: true) }
+
+  # The rows the question form shows, in order. After a failed save these
+  # are exactly the rows the moderator submitted, blank ones included.
+  def option_rows
+    @option_rows || options.to_a
+  end
+
+  # Takes the complete list of option rows from the question form, in form
+  # order: an Array of hashes, or a Hash keyed by row index (as Rails parses
+  # `question[option_rows][3][title]`). Each row has `title`, `correct`, and
+  # `id` for an existing option.
+  #
+  # Existing options missing from the rows, and rows left blank, are removed
+  # on save; filled rows are saved in row order.
+  def option_rows=(rows)
+    existing = options.index_by(&:id)
+
+    @option_rows = normalize_rows(rows).map do |row|
+      option = existing.delete(row[:id].to_i) if row[:id].present?
+      option ||= options.build
+      option.title = row[:title].to_s.strip
+      option.correct = ActiveModel::Type::Boolean.new.cast(row[:correct]) || false
+      option
+    end
+
+    existing.each_value(&:mark_for_destruction)
+    @option_rows.select { |option| option.title.blank? }.each(&:mark_for_destruction)
+    @option_rows.reject(&:marked_for_destruction?).each.with_index(1) { |option, position| option.position = position }
+  end
+
+  # The options that are (or will be, once saved) part of the question.
+  def kept_options
+    options.reject(&:marked_for_destruction?)
+  end
+
+  # Moves the question one place :up or :down in its quiz. Returns false
+  # when it is already first or last.
+  def move(direction)
+    siblings = Question.where(quiz_id: quiz_id).ordered.to_a
+    from = siblings.index { |question| question.id == id }
+    to = direction.to_sym == :up ? from - 1 : from + 1
+    return false unless from && to.between?(0, siblings.size - 1)
+
+    siblings.insert(to, siblings.delete_at(from))
+    transaction do
+      siblings.each.with_index(1) do |question, position|
+        question.update_columns(position: position, updated_at: Time.current) unless question.position == position
+      end
+    end
+    true
+  end
+
+  private
+    def normalize_rows(rows)
+      rows = rows.to_h.sort_by { |index, _| index.to_i }.map(&:last) unless rows.is_a?(Array)
+      rows.map { |row| row.to_h.with_indifferent_access }
+    end
+
+    def options_follow_the_rules
+      kept = kept_options
+      errors.add(:base, :too_few_options, count: MINIMUM_OPTIONS) if kept.size < MINIMUM_OPTIONS
+      errors.add(:base, :no_correct_option) if kept.none?(&:correct?)
+    end
+
+    def append_to_quiz
+      self.position ||= (quiz.questions.maximum(:position) || 0) + 1
+    end
+end
diff --git a/app/models/quiz.rb b/app/models/quiz.rb
new file mode 100644
index 0000000..d9b35d3
--- /dev/null
+++ b/app/models/quiz.rb
@@ -0,0 +1,79 @@
+class Quiz < ApplicationRecord
+  # "Number of winners": how many players get a prize when a game of this
+  # quiz ends (Game#pick_winners). The upper bound only catches typos.
+  MAX_WINNERS = 10_000
+
+  # The timer: "Timer minutes" and "Timer seconds" per question, 0 and 0 for
+  # none. Seconds stay below a minute, as on a clock (the big screen counts
+  # down in M:SS); the minutes' upper bound only catches typos.
+  MAX_TIMER_MINUTES = 999
+
+  has_many :games, dependent: :delete_all
+  has_many :questions, -> { ordered }, dependent: :destroy, inverse_of: :quiz
+
+  normalizes :title, with: ->(title) { title.strip }
+
+  validates :title, presence: true
+  validates :winners_count, numericality: { only_integer: true, greater_than_or_equal_to: 1, less_than_or_equal_to: MAX_WINNERS }
+  validates :timer_minutes, numericality: { only_integer: true, greater_than_or_equal_to: 0, less_than_or_equal_to: MAX_TIMER_MINUTES }
+  validates :timer_seconds, numericality: { only_integer: true, greater_than_or_equal_to: 0, less_than_or_equal_to: 59 }
+
+  scope :newest_first, -> { order(created_at: :desc, id: :desc) }
+
+  # An emptied timer field means 0, like the default.
+  def timer_minutes=(value)
+    super(blank_as_zero(value))
+  end
+
+  def timer_seconds=(value)
+    super(blank_as_zero(value))
+  end
+
+  # The time per question in seconds; 0 means no timer. A setting, not
+  # content: quiz JSON doesn't carry it (docs/quiz-json.md).
+  def timer_duration
+    timer_minutes.to_i * 60 + timer_seconds.to_i
+  end
+
+  def timer?
+    timer_duration.positive?
+  end
+
+  # Questions that are played (and previewed), in order.
+  def active_questions
+    questions.select(&:active?)
+  end
+
+  # The quiz's contents in quiz JSON (docs/quiz-json.md), which QuizImport
+  # reads back: exactly the title and the questions with their options, in
+  # order, always with "active" and "correct". Nothing else (no ids, no
+  # timestamps, no settings): the export only moves contents.
+  def export_data
+    {
+      "title" => title,
+      "questions" => questions.includes(:options).map do |question|
+        {
+          "text" => question.body,
+          "active" => question.active?,
+          "options" => question.options.map { |option| { "text" => option.title, "correct" => option.correct? } }
+        }
+      end
+    }
+  end
+
+  # #export_data as indented JSON, one option per line, like the example in
+  # docs/quiz-json.md.
+  def export_json
+    data = export_data
+    data["questions"].each do |question|
+      question["options"].map! { |option| JSON::Fragment.new(JSON.generate(option, space: " ", object_nl: " ")) }
+    end
+    JSON.pretty_generate(data)
+  end
+
+  private
+    def blank_as_zero(value)
+      value = value.strip if value.is_a?(String)
+      value.blank? ? 0 : value
+    end
+end
diff --git a/app/models/quiz_import.rb b/app/models/quiz_import.rb
new file mode 100644
index 0000000..eac7b00
--- /dev/null
+++ b/app/models/quiz_import.rb
@@ -0,0 +1,161 @@
+# Creates a new quiz from quiz JSON, the format Quiz#export_data writes
+# (docs/quiz-json.md):
+#
+#   { "title": "…",
+#     "questions": [ { "text": "…", "active": true,
+#                      "options": [ { "text": "…", "correct": false } ] } ] }
+#
+# "active" (default true) and "correct" (default false) are optional; the
+# other keys are required. Unknown keys are ignored. Questions follow the
+# question form's rules, applied by the same code (Question#option_rows= and
+# its validations): blank options are skipped, at least two options, at least
+# one correct.
+#
+# All or nothing: #save checks everything first, collects every problem in
+# #errors (messages say which question and option they are about), and only
+# then creates the quiz and all its questions in one transaction. It always
+# creates a new quiz, also when one with the same title exists.
+class QuizImport
+  include ActiveModel::Model
+  include ActiveModel::Attributes
+
+  BYTE_ORDER_MARK = "\uFEFF"
+
+  attribute :json, :string
+
+  # The created quiz, once #save succeeded.
+  attr_reader :quiz
+
+  def save
+    errors.clear
+    @quiz = nil
+
+    quiz = build_quiz
+    return false if errors.any?
+
+    quiz.save!
+    @quiz = quiz
+    true
+  end
+
+  private
+    # The unsaved quiz with its questions; nil when the JSON can't be used at
+    # all. Every problem found is added to #errors.
+    def build_quiz
+      data = parse
+      return if errors.any? # unreadable; `null` is readable, but not a quiz
+      return add_error(:root_not_an_object) unless data.is_a?(Hash)
+
+      quiz = Quiz.new
+      if (title = string_field(data, "title"))
+        quiz.title = title
+        # Before any question is built: Quiz#valid? would validate those too.
+        copy_errors(quiz, { title: "title" })
+      end
+
+      if (items = array_field(data, "questions"))
+        items.each.with_index(1) { |item, number| build_question(quiz, item, number) }
+      end
+
+      quiz
+    end
+
+    # The parsed JSON. Parser messages quote the input, so errors only tell
+    # where the problem is.
+    def parse
+      text = json.to_s.delete_prefix(BYTE_ORDER_MARK)
+      return add_error(:empty) if text.blank?
+
+      JSON.parse(text)
+    rescue JSON::ParserError => error
+      if error.line.nil? # e.g. nested too deep
+        add_error(:syntax)
+      elsif (key = error.message[/\Aduplicate key (".*") at line/, 1])
+        add_error(:duplicate_key, key: key.truncate(40), line: error.line, column: error.column)
+      else
+        add_error(:syntax_at, line: error.line, column: error.column)
+      end
+    end
+
+    def build_question(quiz, item, number)
+      at = { question: number }
+      return add_error(:question_not_an_object, at:) unless item.is_a?(Hash)
+
+      text = string_field(item, "text", at:)
+      active = boolean_field(item, "active", default: true, at:)
+      option_rows = option_rows(item, at:)
+      return if [ text, active, option_rows ].any?(&:nil?)
+
+      question = quiz.questions.build(body: text, active: active, position: number, option_rows: option_rows)
+      copy_errors(question, { body: "text" }, at:)
+    end
+
+    # The question's options as rows for Question#option_rows=; nil when any
+    # of them is malformed.
+    def option_rows(item, at:)
+      options = array_field(item, "options", at:)
+      return if options.nil?
+
+      rows = options.map.with_index(1) do |option, number|
+        option_at = at.merge(option: number)
+        next add_error(:option_not_an_object, at: option_at) unless option.is_a?(Hash)
+
+        text = string_field(option, "text", at: option_at)
+        correct = boolean_field(option, "correct", default: false, at: option_at)
+        { title: text, correct: correct } unless text.nil? || correct.nil?
+      end
+
+      rows unless rows.include?(nil)
+    end
+
+    # Field readers: the value, or nil (after adding an error) when the key
+    # is missing or holds the wrong type.
+    def string_field(hash, key, at: {})
+      field(hash, key, :not_a_string, at:) { |value| value.is_a?(String) }
+    end
+
+    def array_field(hash, key, at: {})
+      field(hash, key, :not_an_array, at:) { |value| value.is_a?(Array) }
+    end
+
+    def boolean_field(hash, key, default:, at: {})
+      return default unless hash.key?(key)
+
+      field(hash, key, :not_a_boolean, at:) { |value| value == true || value == false }
+    end
+
+    def field(hash, key, wrong_type, at:)
+      if !hash.key?(key)
+        add_error(:missing, key: key, at:)
+      elsif yield(hash[key])
+        hash[key]
+      else
+        add_error(wrong_type, key: key, at:)
+      end
+    end
+
+    # Copies a record's validation errors. `keys` maps attributes to the
+    # JSON keys they come from, so messages name what the moderator typed.
+    def copy_errors(record, keys, at: {})
+      return if record.valid?
+
+      record.errors.each do |error|
+        key = keys[error.attribute]
+        message = key ? "\"#{key}\" #{error.message}" : error.full_message
+        errors.add(:base, located(message, **at))
+      end
+    end
+
+    # Adds the message `kind` (config/locales/en.yml) and returns nil.
+    def add_error(kind, at: {}, **details)
+      errors.add(:base, located(I18n.t(kind, scope: "quiz_import.errors", **details), **at))
+      nil
+    end
+
+    # "Question 2: …", "Question 2, option 3: …", or the message as is.
+    def located(message, question: nil, option: nil)
+      return message unless question
+
+      I18n.t(option ? :option : :question, scope: "quiz_import.location", question:, option:, message:)
+    end
+end
diff --git a/app/models/round.rb b/app/models/round.rb
new file mode 100644
index 0000000..054f63d
--- /dev/null
+++ b/app/models/round.rb
@@ -0,0 +1,39 @@
+# One question shown in a game: open while players answer (closed_at nil),
+# closed once the moderator finishes it, or by itself at `closes_at` when the
+# quiz has a timer. `position` is its number in the game. The question may
+# be deleted later (question_id becomes NULL).
+class Round < ApplicationRecord
+  belongs_to :game, inverse_of: :rounds
+  belongs_to :question, optional: true
+  has_many :answers, dependent: :delete_all
+
+  # Open rounds of running games whose question finishes by itself
+  # (RoundTimer waits for the earliest).
+  scope :ticking, -> { joins(:game).merge(Game.answering).where(closed_at: nil).where.not(closes_at: nil) }
+  scope :overdue, ->(at = Time.current) { ticking.where(closes_at: ..at) }
+
+  def open?
+    closed_at.nil?
+  end
+
+  # Has a deadline: the quiz had a timer when the question opened.
+  def timed?
+    closes_at.present?
+  end
+
+  # The deadline has come (answers from `at` on are too late).
+  def time_up?(at = Time.current)
+    timed? && closes_at <= at
+  end
+
+  # Closed by the timer (or at least not before the time was up), rather
+  # than by an early "Finish".
+  def timed_out?
+    timed? && !open? && closed_at >= closes_at
+  end
+
+  # Seconds left until the deadline (never negative); nil without a timer.
+  def time_left(at = Time.current)
+    [ closes_at - at, 0 ].max if timed?
+  end
+end
