+++ b/test/controllers/moderate/authentication_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Moderate::AuthenticationTest < ActionDispatch::IntegrationTest
+  PAGES = -> {
+    quiz = quizzes(:frontend)
+    question = questions(:http)
+    game = quiz.games.create!
+    [
+      [ :get, "/moderate" ], [ :get, "/moderate/quizzes/new" ], [ :get, "/moderate/quizzes/#{quiz.id}" ],
+      [ :get, "/moderate/quizzes/#{quiz.id}/edit" ], [ :get, "/moderate/quizzes/#{quiz.id}/preview" ],
+      [ :get, "/moderate/quizzes/#{quiz.id}/questions/new" ], [ :get, "/moderate/questions/#{question.id}/edit" ],
+      [ :post, "/moderate/quizzes" ], [ :delete, "/moderate/quizzes/#{quiz.id}" ],
+      [ :patch, "/moderate/questions/#{question.id}/activation" ], [ :get, "/moderate/quizzes/#{quiz.id}/export" ],
+      [ :get, "/moderate/quizzes/#{quiz.id}/export.json" ], [ :get, "/moderate/import/new" ], [ :post, "/moderate/import" ],
+      [ :post, "/moderate/quizzes/#{quiz.id}/games" ], [ :get, "/moderate/games/#{game.id}" ],
+      [ :patch, "/moderate/games/#{game.id}/progress" ], [ :get, "/moderate/games/#{game.id}/status" ],
+      [ :get, "/moderate/no/such/page" ]
+    ]
+  }
+
+  test "every moderator page answers 401 without credentials" do
+    instance_exec(&PAGES).each do |verb, path|
+      send(verb, path)
+      assert_response :unauthorized, "#{verb} #{path}"
+      assert_match(/Basic realm=/, response.headers["WWW-Authenticate"])
+    end
+  end
+
+  test "wrong credentials get 401" do
+    [ %w[ moderator wrong ], [ "someone", ENV["QUIZZY_MODERATOR_PASSWORD"] ], [ "", "" ] ].each do |username, password|
+      get "/moderate", headers: { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials(username, password) }
+      assert_response :unauthorized
+    end
+  end
+
+  test "the right credentials open the moderator area" do
+    get "/moderate", headers: moderator_auth
+    assert_response :success
+  end
+
+  test "nobody gets in when the credentials aren't configured" do
+    username = ENV.delete("QUIZZY_MODERATOR_USERNAME")
+    get "/moderate", headers: { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials("", ENV["QUIZZY_MODERATOR_PASSWORD"]) }
+    assert_response :unauthorized
+  ensure
+    ENV["QUIZZY_MODERATOR_USERNAME"] = username
+  end
+
+  test "public pages need no credentials" do
+    get "/up"
+    assert_response :success
+    get "/"
+    assert_response :success
+  end
+end
diff --git a/test/controllers/moderate/exports_controller_test.rb b/test/controllers/moderate/exports_controller_test.rb
