+# The timer that finishes questions at 0:00 (lib/round_timer.rb). It runs in
+# the server; tests control the clock and start it themselves when needed.
+RoundTimer.enabled = !Rails.env.test?
+
+Rails.application.config.after_initialize do
+  # `bin/rails server` (bin/serve, bin/dev): start at boot, so a question
+  # whose time ran out while the server was down finishes at once. Other
+  # processes that serve the app start it when a timed question opens.
+  RoundTimer.start if RoundTimer.enabled && defined?(Rails::Server)
+end
