diff --git a/app/javascript/controllers/preview_controller.js b/app/javascript/controllers/preview_controller.js
new file mode 100644
index 0000000..1cf9656
--- /dev/null
+++ b/app/javascript/controllers/preview_controller.js
@@ -0,0 +1,116 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Plays a quiz in the browser the way a player would: one question at a
+// time, the options as buttons, feedback after each pick and the score at the
+// end. Answers only live in this controller; nothing is sent to the server.
+//
+// questions value: [{ text: "…", options: [{ title: "…", correct: true }] }]
+export default class extends Controller {
+  static targets = [ "stage" ]
+  static values = { questions: Array }
+
+  connect() {
+    if (this.questionsValue.length > 0) this.startOver()
+  }
+
+  startOver() {
+    this.index = 0
+    this.score = 0
+    this.renderQuestion()
+  }
+
+  // Rendering ----------------------------------------------------------------
+
+  renderQuestion() {
+    const question = this.questionsValue[this.index]
+    this.answered = false
+
+    this.options = element("div", { class: "play-options" },
+      ...question.options.map((option, index) => this.optionButton(option, index)))
+
+    this.stageTarget.replaceChildren(
+      element("div", { class: "play-question__num" }, `Question ${this.index + 1} of ${this.total}`),
+      element("div", { class: "play-question__body" }, question.text),
+      this.options
+    )
+    window.scrollTo(0, 0)
+  }
+
+  optionButton(option, index) {
+    const button = element("button", { type: "button", class: "play-option" },
+      element("span", { class: "play-option__letter", "aria-hidden": "true" }, letter(index)),
+      element("span", { class: "play-option__title" }, option.title))
+    button.addEventListener("click", () => this.pick(index))
+    return button
+  }
+
+  pick(index) {
+    if (this.answered) return
+    this.answered = true
+
+    const question = this.questionsValue[this.index]
+    const right = question.options[index].correct
+    if (right) this.score++
+
+    this.options.classList.add("is-locked", "is-revealed")
+    this.options.querySelectorAll(".play-option").forEach((button, position) => {
+      button.disabled = true
+      if (position === index) {
+        button.classList.add("is-picked")
+        button.append(element("span", { class: "visually-hidden" }, " (your answer)"))
+      }
+      if (question.options[position].correct) {
+        button.classList.add("is-correct")
+        button.append(
+          element("span", { class: "play-option__mark", "aria-hidden": "true" }, "✓"),
+          element("span", { class: "visually-hidden" }, " (correct answer)"))
+      }
+    })
+
+    const last = this.index === this.total - 1
+    const next = element("button", { type: "button", class: "btn btn--lg" }, last ? "See score" : "Next question")
+    next.addEventListener("click", () => last ? this.showScore() : this.nextQuestion())
+
+    this.stageTarget.append(
+      element("div", { class: `play-status play-status--${right ? "right" : "wrong"}`, role: "status" }, right ? "Correct!" : "Wrong!"),
+      element("div", { class: "play-next" }, next)
+    )
+    next.focus({ preventScroll: true })
+  }
+
+  nextQuestion() {
+    this.index++
+    this.renderQuestion()
+  }
+
+  showScore() {
+    this.stageTarget.replaceChildren(
+      element("div", { class: "result-card preview-result" },
+        element("div", { class: "result-card__label" }, "Preview finished"),
+        element("div", { class: "preview-result__score" }, `Score: ${this.score}/${this.total}`),
+        element("p", { class: "play-lead" }, verdict(this.score, this.total)))
+    )
+    window.scrollTo(0, 0)
+  }
+
+  get total() {
+    return this.questionsValue.length
+  }
+}
+
+function element(name, attributes = {}, ...children) {
+  const node = document.createElement(name)
+  for (const [ attribute, value ] of Object.entries(attributes)) node.setAttribute(attribute, value)
+  node.append(...children)
+  return node
+}
+
+function letter(index) {
+  return index < 26 ? String.fromCharCode(65 + index) : String(index + 1)
+}
+
+function verdict(score, total) {
+  if (score === total) return "All answers right."
+  if (score === 0) return "No right answers this time."
+  return `${total - score} wrong ${total - score === 1 ? "answer" : "answers"}.`
+}
diff --git a/app/javascript/quizzy.js b/app/javascript/quizzy.js
new file mode 100644
index 0000000..87e1ef4
--- /dev/null
+++ b/app/javascript/quizzy.js
@@ -0,0 +1,145 @@
+// Quizzy page behaviors for server-rendered pages.
+//
+// This is a classic script loaded (blocking) in <head>, not an ES module:
+// the listeners below sit on `document` before any element renders, so a
+// click that comes right after a page load is never lost. Elements opt in
+// with data attributes:
+//
+//   <form data-confirm="Delete this?">  asks with the native confirm() first
+//   <input data-auto-submit>            submits its form as soon as it changes
+//   <form data-keep-scroll>             the next page load of the same path
+//                                       restores the scroll position
+//   <form data-submit-once>             ignores repeated submits (double clicks)
+//   [data-option-rows], [data-add-option], [data-remove-option],
+//   template[data-option-row-template]  the option rows of the question form
+//   [data-renumber="attr:Format %n|…"]  relabels a row element by row number
+(function () {
+  "use strict"
+
+  var SCROLL_KEY = "quizzy:scroll"
+
+  // Submissions --------------------------------------------------------------
+
+  document.addEventListener("submit", function (event) {
+    var form = event.target
+    if (!(form instanceof HTMLFormElement) || event.defaultPrevented) return
+
+    var message = form.getAttribute("data-confirm")
+    if (message && !window.confirm(message)) {
+      event.preventDefault()
+      return
+    }
+
+    if (form.hasAttribute("data-submit-once")) {
+      if (form.hasAttribute("data-submitting")) {
+        event.preventDefault()
+        return
+      }
+      form.setAttribute("data-submitting", "")
+    }
+
+    if (form.hasAttribute("data-keep-scroll")) rememberScroll()
+  })
+
+  // Pages restored from the back/forward cache must be submittable again.
+  window.addEventListener("pageshow", function (event) {
+    if (!event.persisted) return
+    document.querySelectorAll("form[data-submitting]").forEach(function (form) {
+      form.removeAttribute("data-submitting")
+    })
+  })
+
+  document.addEventListener("change", function (event) {
+    var field = event.target
+    if (!field.matches || !field.matches("[data-auto-submit]") || !field.form) return
+
+    if (field.form.requestSubmit) {
+      field.form.requestSubmit()
+    } else {
+      field.form.submit()
+    }
+  })
+
+  // Scroll position across a submit-and-redirect ---------------------------
+
+  function rememberScroll() {
+    try {
+      sessionStorage.setItem(SCROLL_KEY, JSON.stringify({ path: location.pathname, y: window.scrollY }))
+    } catch (error) { /* storage unavailable: just don't restore */ }
+  }
+
+  function restoreScroll() {
+    var saved = null
+    try {
+      saved = JSON.parse(sessionStorage.getItem(SCROLL_KEY))
+      sessionStorage.removeItem(SCROLL_KEY)
+    } catch (error) { /* ignore */ }
+    if (saved && saved.path === location.pathname) window.scrollTo(0, saved.y)
+  }
+
+  document.addEventListener("DOMContentLoaded", restoreScroll)
+
+  // Option rows of the question form -----------------------------------------
+
+  document.addEventListener("click", function (event) {
+    if (!event.target.closest) return
+
+    var add = event.target.closest("[data-add-option]")
+    if (add) {
+      event.preventDefault()
+      addOptionRow(add.closest("form"))
+      return
+    }
+
+    var remove = event.target.closest("[data-remove-option]")
+    if (remove) {
+      event.preventDefault()
+      removeOptionRow(remove.closest("[data-option-row]"))
+    }
+  })
+
+  function addOptionRow(form) {
+    var rows = form && form.querySelector("[data-option-rows]")
+    var template = form && form.querySelector("template[data-option-row-template]")
+    if (!rows || !template) return
+
+    var index = parseInt(rows.getAttribute("data-next-index"), 10) || rows.children.length
+    rows.setAttribute("data-next-index", index + 1)
+    var number = rows.querySelectorAll("[data-option-row]").length + 1
+
+    var html = template.innerHTML.split("__INDEX__").join(index).split("__NUMBER__").join(number)
+    rows.insertAdjacentHTML("beforeend", html)
+
+    var input = rows.lastElementChild && rows.lastElementChild.querySelector("input[type=text]")
+    if (input) input.focus()
+  }
+
+  function removeOptionRow(row) {
+    if (!row) return
+    var rows = row.parentElement
+    var next = row.nextElementSibling || row.previousElementSibling
+    row.remove()
+    renumberOptionRows(rows)
+
+    var input = next && next.querySelector("input[type=text]")
+    if (input) input.focus()
+  }
+
+  function renumberOptionRows(rows) {
+    rows.querySelectorAll("[data-option-row]").forEach(function (row, position) {
+      var number = String(position + 1)
+      row.querySelectorAll("[data-renumber]").forEach(function (element) {
+        element.getAttribute("data-renumber").split("|").forEach(function (rule) {
+          var separator = rule.indexOf(":")
+          var attribute = rule.slice(0, separator)
+          var value = rule.slice(separator + 1).split("%n").join(number)
+          if (attribute === "text") {
+            element.textContent = value
+          } else {
+            element.setAttribute(attribute, value)
+          }
+        })
+      })
+    })
+  }
+})()
