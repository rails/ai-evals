diff --git a/test/test_helper.rb b/test/test_helper.rb
new file mode 100644
index 0000000..c4676cb
--- /dev/null
+++ b/test/test_helper.rb
@@ -0,0 +1,33 @@
+ENV["RAILS_ENV"] ||= "test"
+ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+ENV["QUIZZY_MODERATOR_PASSWORD"] = "correct horse"
+
+require_relative "../config/environment"
+require "rails/test_help"
+
+module ActiveSupport
+  class TestCase
+    # Run tests in parallel with specified workers
+    parallelize(workers: :number_of_processors)
+
+    # Setup all fixtures in test/fixtures/*.yml for all tests in alphabetical order.
+    fixtures :all
+  end
+end
+
+module ModeratorTestHelper
+  # Integration tests define `options` as the HTTP OPTIONS request helper,
+  # which hides the `options(:name)` fixture accessor.
+  def option_fixture(name)
+    Option.find(ActiveRecord::FixtureSet.identify(name))
+  end
+
+  def moderator_auth
+    { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials(
+      ENV["QUIZZY_MODERATOR_USERNAME"], ENV["QUIZZY_MODERATOR_PASSWORD"]) }
+  end
+end
+
+class ActionDispatch::IntegrationTest
+  include ModeratorTestHelper
+end
