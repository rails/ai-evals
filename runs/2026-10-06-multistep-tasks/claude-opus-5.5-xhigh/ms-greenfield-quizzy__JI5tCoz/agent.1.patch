+module QuestionsHelper
+  # Labels of an option row in the question form; "%n" is the row number.
+  # The QA suite relies on "Option 1" and "Option 1 is correct".
+  OPTION_ROW_LABELS = {
+    title: "Option %n",
+    correct: "Option %n is correct",
+    remove: "Remove option %n"
+  }.freeze
+
+  def option_row_label(kind, number)
+    OPTION_ROW_LABELS.fetch(kind).gsub("%n", number.to_s)
+  end
+
+  # Tells quizzy.js how to relabel an element when rows get renumbered:
+  # "attribute:format" pairs separated by "|" ("text" is the text content).
+  def option_row_renumbering(kind, *attributes)
+    attributes.map { |attribute| "#{attribute}:#{OPTION_ROW_LABELS.fetch(kind)}" }.join("|")
+  end
+
+  # The data the preview plays through (see preview_controller.js).
+  def preview_questions_data(questions)
+    questions.map do |question|
+      {
+        text: question.body,
+        options: question.options.map { |option| { title: option.title, correct: option.correct? } }
+      }
+    end
+  end
+end
