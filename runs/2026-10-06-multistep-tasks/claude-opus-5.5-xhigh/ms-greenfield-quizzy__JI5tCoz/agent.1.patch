@@ -0,0 +1,18 @@
+namespace :demo do
+  desc "Load a demo quiz (the one in docs/mockups). Not run by db:prepare/db:seed."
+  task load: :environment do
+    quiz = Quiz.find_or_create_by!(title: "Frontend Fest 2026")
+    next puts("Demo quiz already has questions") if quiz.questions.any?
+
+    [
+      [ "Which HTTP status code means \"Too Many Requests\"?", [ "418", "*429", "503", "409" ], true ],
+      [ "Which protocol keeps a two-way connection between a browser and a server?", [ "*WebSocket", "SMTP", "FTP" ], true ],
+      [ "What does CSS stand for?", [ "*Cascading Style Sheets", "Computer Style System" ], false ]
+    ].each do |body, options, active|
+      quiz.questions.create!(body: body, active: active, option_rows: options.map { |title|
+        { title: title.delete_prefix("*"), correct: title.start_with?("*") }
+      })
+    end
+    puts "Loaded #{quiz.title} (#{quiz.questions.count} questions)"
+  end
+end
