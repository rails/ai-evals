+require "test_helper"
+
+class QuestionTest < ActiveSupport::TestCase
+  setup { @quiz = quizzes(:empty) }
+
+  test "saves filled option rows in row order and skips empty ones" do
+    question = @quiz.questions.create!(body: "Which planet is the largest?", option_rows: {
+      "0" => { title: "Jupiter", correct: "1" },
+      "1" => { title: "  " },
+      "2" => { title: "Saturn" },
+      "10" => { title: "Earth", correct: "0" }
+    })
+
+    assert_equal [ [ "Jupiter", true, 1 ], [ "Saturn", false, 2 ], [ "Earth", false, 3 ] ],
+      question.options.reload.map { |option| [ option.title, option.correct, option.position ] }
+  end
+
+  test "needs at least two options" do
+    question = @quiz.questions.new(body: "Q", option_rows: [ { title: "Only", correct: "1" }, { title: "" } ])
+
+    assert_not question.valid?
+    assert_equal [ "Add at least two options" ], question.errors.full_messages
+  end
+
+  test "needs a correct option, and an empty correct row doesn't count" do
+    question = @quiz.questions.new(body: "Q", option_rows: [ { title: "A" }, { title: "B" }, { title: "", correct: "1" } ])
+
+    assert_not question.valid?
+    assert_equal [ "Mark at least one option as correct" ], question.errors.full_messages
+  end
+
+  test "several correct options are fine" do
+    assert @quiz.questions.new(body: "Q", option_rows: [ { title: "A", correct: "1" }, { title: "B", correct: "1" } ]).valid?
+  end
+
+  test "needs its text" do
+    question = @quiz.questions.new(body: " ", option_rows: [ { title: "A", correct: "1" }, { title: "B" } ])
+
+    assert_not question.valid?
+    assert_includes question.errors.full_messages, "Question can't be blank"
+  end
+
+  test "keeps the submitted rows, blank ones included, when invalid" do
+    question = @quiz.questions.new(body: "Q", option_rows: [ { title: "A" }, { title: "" }, { title: "C" } ])
+
+    assert_not question.valid?
+    assert_equal [ "A", "", "C" ], question.option_rows.map(&:title)
+  end
+
+  test "editing updates, removes blanked and missing options, and adds new ones" do
+    question = questions(:http)
+    o418, o429, o503 = question.options.to_a
+
+    question.update!(option_rows: [
+      { id: o429.id, title: "429", correct: "1" },
+      { id: o418.id, title: "" },
+      { title: "409" }
+    ])
+
+    assert_equal [ [ o429.id, "429", true ], [ nil, "409", false ] ],
+      question.options.reload.map { |option| [ (option.id if option.id == o429.id), option.title, option.correct ] }
+    assert_not Option.exists?(o418.id)
+    assert_not Option.exists?(o503.id)
+  end
+
+  test "a failed edit changes nothing" do
+    question = questions(:http)
+
+    assert_not question.update(option_rows: [ { id: options(:http_429).id, title: "429", correct: "1" } ])
+    assert_equal [ "418", "429", "503" ], question.reload.options.map(&:title)
+  end
+
+  test "new questions go last" do
+    question = quizzes(:frontend).questions.create!(body: "Q", option_rows: [ { title: "A", correct: "1" }, { title: "B" } ])
+
+    assert_equal question, quizzes(:frontend).questions.last
+  end
+
+  test "moves up and down within its quiz" do
+    quiz = quizzes(:frontend)
+
+    assert questions(:websocket).move(:up)
+    assert_equal [ questions(:websocket), questions(:http), questions(:css) ], quiz.questions.reload.to_a
+
+    assert_not questions(:websocket).reload.move(:up)
+    assert questions(:http).reload.move(:down)
+    assert_equal [ questions(:websocket), questions(:css), questions(:http) ], quiz.questions.reload.to_a
+    assert_not questions(:http).reload.move(:down)
+  end
+end
