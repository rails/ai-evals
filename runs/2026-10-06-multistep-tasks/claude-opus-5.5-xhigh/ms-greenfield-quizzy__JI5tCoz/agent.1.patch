+<%= form_with model: question, url: question.persisted? ? moderate_question_path(question) : moderate_quiz_questions_path(quiz),
+      class: "card question-form", data: { submit_once: true } do |form| %>
+  <div class="field">
+    <%= form.label :body, "Question" %>
+    <%= form.text_area :body, class: "input", rows: 3, autofocus: question.new_record?, aria: { required: true } %>
+  </div>
+
+  <div class="field">
+    <span class="field-label">Options</span>
+    <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
+  </div>
+
+  <div class="option-rows" data-option-rows data-next-index="<%= option_rows.size %>">
+    <% option_rows.each_with_index do |option, index| %>
+      <%= render "moderate/questions/option_row", index: index, number: index + 1, option: option %>
+    <% end %>
+  </div>
+  <template data-option-row-template>
+    <%= render "moderate/questions/option_row", index: "__INDEX__", number: "__NUMBER__", option: Option.new %>
+  </template>
+  <div class="buttons option-rows__add">
+    <button type="button" class="btn btn--ghost btn--sm" data-add-option>Add option</button>
+  </div>
+
+  <div class="field">
+    <label class="checkbox">
+      <%= form.check_box :active %>
+      Active
+    </label>
+    <span class="field-hint">Only active questions are played.</span>
+  </div>
+
+  <%= render "moderate/shared/errors", record: question %>
+
+  <div class="buttons">
+    <%= form.button "Save question", class: "btn btn--pink" %>
+    <%= link_to "Cancel", moderate_quiz_path(quiz), class: "btn btn--ghost" %>
+  </div>
+<% end %>
diff --git a/app/views/moderate/questions/_option_row.html.erb b/app/views/moderate/questions/_option_row.html.erb
new file mode 100644
index 0000000..dbd366c
--- /dev/null
+++ b/app/views/moderate/questions/_option_row.html.erb
@@ -0,0 +1,27 @@
+<%# One option row of the question form. `index` is the row's key in the
+    params (stable, may have gaps), `number` the 1-based row number shown in
+    the labels. The <template> copy uses "__INDEX__"/"__NUMBER__". %>
+<% field = "question[option_rows][#{index}]" %>
+<% id = "question_option_rows_#{index}" %>
+<div class="option-row" data-option-row>
+  <% if option.persisted? %>
+    <input type="hidden" name="<%= field %>[id]" value="<%= option.id %>">
+  <% end %>
+
+  <label class="visually-hidden" for="<%= id %>_title" data-renumber="<%= option_row_renumbering(:title, :text) %>"><%= option_row_label(:title, number) %></label>
+  <input class="input" type="text" id="<%= id %>_title" name="<%= field %>[title]" value="<%= option.title %>"
+         placeholder="<%= option_row_label(:title, number) %>" autocomplete="off"
+         data-renumber="<%= option_row_renumbering(:title, :placeholder) %>">
+
+  <label class="checkbox option-row__correct">
+    <input type="checkbox" id="<%= id %>_correct" name="<%= field %>[correct]" value="1" <%= "checked" if option.correct? %>
+           aria-label="<%= option_row_label(:correct, number) %>"
+           data-renumber="<%= option_row_renumbering(:correct, "aria-label") %>">
+    Correct
+  </label>
+  <label class="visually-hidden" for="<%= id %>_correct" data-renumber="<%= option_row_renumbering(:correct, :text) %>"><%= option_row_label(:correct, number) %></label>
+
+  <button type="button" class="btn btn--danger btn--icon" data-remove-option
+          title="<%= option_row_label(:remove, number) %>" aria-label="<%= option_row_label(:remove, number) %>"
+          data-renumber="<%= option_row_renumbering(:remove, :title, "aria-label") %>">✕</button>
+</div>
diff --git a/app/views/moderate/questions/_question.html.erb b/app/views/moderate/questions/_question.html.erb
new file mode 100644
index 0000000..09b0c79
--- /dev/null
+++ b/app/views/moderate/questions/_question.html.erb
@@ -0,0 +1,43 @@
+<%# One question on the quiz page. `number` is its place among the active
+    questions (nil when inactive); `first`/`last` disable the move buttons. %>
+<%= tag.li id: dom_id(question), class: [ "card", "question-item", { "question-item--inactive": !question.active? } ] do %>
+  <div class="question-item__num"><%= number || "—" %></div>
+
+  <div class="question-item__main">
+    <div class="question-item__body"><%= question.body %></div>
+    <div class="question-item__options">
+      <% question.options.each_with_index do |option, index| %>
+        <%= tag.span class: [ "question-item__option", { "is-correct": option.correct? } ] do %>
+          <% if option.correct? %><span class="question-item__check" aria-hidden="true">✓</span><% end %>
+          <%= option_letter(index) %>. <%= option.title %>
+          <% if option.correct? %><span class="visually-hidden">(correct)</span><% end %>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="question-item__actions">
+    <div class="buttons">
+      <%= button_to moderate_question_position_path(question), method: :patch, params: { direction: "up" },
+            class: "btn btn--ghost btn--icon", disabled: first, title: "Move up", aria: { label: "Move up" },
+            form: { data: { keep_scroll: true } } do %>↑<% end %>
+      <%= button_to moderate_question_position_path(question), method: :patch, params: { direction: "down" },
+            class: "btn btn--ghost btn--icon", disabled: last, title: "Move down", aria: { label: "Move down" },
+            form: { data: { keep_scroll: true } } do %>↓<% end %>
+    </div>
+
+    <%= form_with model: question, url: moderate_question_activation_path(question), method: :patch,
+          class: "question-item__switch", data: { keep_scroll: true } do |form| %>
+      <label class="checkbox">
+        <%= form.check_box :active, id: dom_id(question, :active), data: { auto_submit: true } %>
+        Active
+      </label>
+    <% end %>
+
+    <div class="buttons">
+      <%= link_to "Edit", edit_moderate_question_path(question), class: "btn btn--sm" %>
+      <%= button_to "Delete", moderate_question_path(question), method: :delete, class: "btn btn--sm btn--danger",
+            form: { data: { confirm: "Delete this question?", keep_scroll: true } } %>
+    </div>
+  </div>
+<% end %>
