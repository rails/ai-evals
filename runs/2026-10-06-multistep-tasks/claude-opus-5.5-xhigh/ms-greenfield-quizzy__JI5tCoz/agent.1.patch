+    </span>
+  </div>
+
+  <main class="play">
+    <div class="play__top">
+      <%= logo "play__logo" %>
+      <span class="play__name"><%= @quiz.title %></span>
+    </div>
+
+    <div class="play__body play__body--top" data-preview-target="stage">
+      <% if @questions.empty? %>
+        <h1 class="play-title">Nothing to play yet</h1>
+        <p class="play-lead">This quiz has no active questions. Add a question or switch one on, then try again.</p>
+      <% else %>
+        <noscript><p class="play-lead">The preview needs JavaScript.</p></noscript>
+      <% end %>
