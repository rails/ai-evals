diff --git a/app/views/play/games/_state.html.erb b/app/views/play/games/_state.html.erb
new file mode 100644
index 0000000..8875bf1
--- /dev/null
+++ b/app/views/play/games/_state.html.erb
@@ -0,0 +1,118 @@
+<%# The live part of a phone's page: replaced in place when the game changes (play_controller.js).
+    While a question is open, nothing here may tell which options are correct. %>
+<% game = view.game %>
+<div class="live-state" data-live-version="<%= view.version %>">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+    <span class="play__quiz"><%= view.quiz.title %></span>
+  </div>
+
+  <% case view.stage %>
+  <% when :over %>
+    <div class="play__body">
+      <div class="waiting">
+        <div class="waiting__gem waiting__gem--still" aria-hidden="true">★</div>
+        <h1 class="play-title">The quiz is over</h1>
+        <% if view.player %>
+          <p class="play-lead">You got <%= view.score %> of <%= pluralize(game.question_number, "question") %> right. Thanks for playing!</p>
+        <% else %>
+          <p class="play-lead">Thanks to everyone who played.</p>
+        <% end %>
+      </div>
+    </div>
+
+  <% when :join %>
+    <div class="play__body">
+      <h1 class="play-title">Let’s play!</h1>
+      <p class="play-lead">Pick a name and you’re in.</p>
+      <%= form_with model: view.join_form, scope: :player, url: play_join_path(game.code), class: "join-form",
+            data: { action: "turbo:fetch-request-error->play#joinFailed turbo:submit-start->play#joinRetried" } do |form| %>
+        <%= form.label :name, "Your name", class: "field-label" %>
+        <%= form.text_field :name, class: "input", placeholder: "Your name", maxlength: Player::NAME_MAX,
+              autocomplete: "nickname", autocapitalize: "words", spellcheck: false, enterkeyhint: "go",
+              aria: { required: true, invalid: view.join_form.errors.any? || nil } %>
+        <% if view.join_form.errors.any? %>
+          <div class="errors" role="alert">
+            <% view.join_form.errors.each do |error| %>
+              <div><%= error.message %></div>
+            <% end %>
+          </div>
+        <% end %>
+        <%= form.button "Join", type: "submit", class: "btn btn--pink" %>
+      <% end %>
+    </div>
+
+  <% when :lobby %>
+    <div class="play__body">
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1 class="play-title">Hi, <%= view.player.name %>!</h1>
+        <p class="play-lead">You’re in. The quiz begins in a moment: keep this page open.</p>
+      </div>
+    </div>
+
+  <% when :between %>
+    <div class="play__body">
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1 class="play-title">Hang on…</h1>
+        <p class="play-lead">The next question is coming up.</p>
+      </div>
+    </div>
+
+  <% when :question_open %>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= game.question_number %> of <%= game.questions_count %></div>
+      <div class="play-question__body"><%= view.question.body %></div>
+
+      <%= form_with url: play_answer_path(game.code), class: "play-options",
+            data: { turbo: false, play_target: "options", question: view.question.id } do %>
+        <%= hidden_field_tag :question_id, view.question.id, id: nil %>
+        <% view.options.each_with_index do |option, index| %>
+          <% picked = view.picked?(option) %>
+          <button type="submit" name="option_id" value="<%= option.id %>" data-action="play#answer"
+                  class="play-option<%= " is-picked" if picked %>" aria-pressed="<%= picked %>">
+            <span class="play-option__letter" aria-hidden="true"><%= Option.letter_for(index) %></span>
+            <span class="play-option__title"><%= option.title %></span>
+            <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+          </button>
+        <% end %>
+      <% end %>
+
+      <div class="play-status play-status--neutral" role="status" data-play-target="status">
+        <%= view.answer ? "Saved! You can still change it until the question closes." : "Tap to pick. You can change it until the question closes." %>
+      </div>
+      <div class="play-score"><span>Playing as <%= view.player.name %></span></div>
+    </div>
+
+  <% when :question_closed %>
+    <% result = view.result %>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= game.question_number %> of <%= game.questions_count %></div>
+      <div class="play-question__body"><%= view.question.body %></div>
+
+      <div class="play-options is-locked is-revealed">
+        <% view.options.each_with_index do |option, index| %>
+          <% picked = view.picked?(option) %>
+          <div class="play-option<%= " is-picked" if picked %><%= " is-correct" if option.correct? %>">
+            <span class="play-option__letter" aria-hidden="true"><%= Option.letter_for(index) %></span>
+            <span class="play-option__title"><%= option.title %></span>
+            <% if picked %>
+              <span class="play-option__mark"><span aria-hidden="true"><%= option.correct? ? "✓" : "✗" %></span> Your answer</span>
+            <% elsif option.correct? %>
+              <span class="play-option__mark"><span aria-hidden="true">✓</span> Right answer</span>
+            <% end %>
+          </div>
+        <% end %>
+      </div>
+
+      <div class="play-status play-status--<%= { correct: "right", wrong: "wrong", none: "neutral" }.fetch(result) %>" role="status">
+        <%= { correct: "Correct!", wrong: "Wrong!", none: "No answer" }.fetch(result) %>
+      </div>
+      <div class="play-score">
+        <span>Playing as <%= view.player.name %></span>
+        <span>Eyes on the big screen</span>
+      </div>
+    </div>
+  <% end %>
+</div>
