+# The join link, /play/:code: the join form, then the game as the player sees it.
+class Play::GamesController < Play::BaseController
+  def show
+    current_player&.seen!
+    @view = PlayerView.new(@game, current_player)
+  end
+
+  # Just the live part of the page (play/games/_state), fetched by
+  # play_controller.js when the game changes and polled as a fallback. Counts
+  # as a sign of life. Conditional GET: unchanged states answer 304.
+  def live
+    current_player&.seen!
+    view = PlayerView.new(@game, current_player)
+    render partial: "play/games/state", locals: { view: view } if stale?(etag: view.version, template: false)
+  end
+end
diff --git a/app/controllers/play/players_controller.rb b/app/controllers/play/players_controller.rb
new file mode 100644
index 0000000..c1fc2fd
--- /dev/null
+++ b/app/controllers/play/players_controller.rb
@@ -0,0 +1,21 @@
+# "Join": a name is all it takes. Joining again from the same browser keeps the
+# player (and their answers) and only updates the name.
+class Play::PlayersController < Play::BaseController
+  def create
+    return redirect_to(play_path(@game.code), status: :see_other) if @game.over?
+
+    @player = @game.players.find_or_initialize_by(token: browser_token)
+    @player.name = params.expect(player: [ :name ])[:name]
+    @player.last_seen_at = Time.current
+
+    if @player.save
+      @game.signal_screen
+      redirect_to play_path(@game.code), status: :see_other
+    else
+      @view = PlayerView.new(@game, nil, join_form: @player)
+      render "play/games/show", status: :unprocessable_content
+    end
+  rescue ActiveRecord::RecordNotUnique
+    retry # the same browser joined twice at once: update that player
+  end
+end
diff --git a/app/helpers/games_helper.rb b/app/helpers/games_helper.rb
new file mode 100644
index 0000000..dca797d
--- /dev/null
+++ b/app/helpers/games_helper.rb
@@ -0,0 +1,59 @@
+module GamesHelper
+  QR_QUIET_ZONE = 4 # modules of white around the code, as the QR spec asks
+
+  # The link players open on their phones: http://<host>/play/K7RZX, with the
+  # host the moderator's browser uses, or QUIZZY_PUBLIC_URL when set (the big
+  # screen may run on localhost while phones need the venue address).
+  def join_url(game)
+    base = Rails.configuration.x.public_url
+    base.present? ? "#{base.chomp("/")}#{play_path(game.code)}" : play_url(game.code)
+  end
+
+  # The join link as shown on the big screen, without the scheme:
+  # localhost:3000/play/K7RZX
+  def join_link_text(game)
+    join_url(game).sub(%r{\Ahttps?://}i, "")
+  end
+
+  # An inline SVG QR code for `text` (one path, dark modules in currentColor).
+  def qr_code_svg(text, label:)
+    modules = RQRCode::QRCode.new(text, level: :m).modules
+    size = modules.size
+    path = +""
+    modules.each_with_index do |row, y|
+      x = 0
+      while x < size
+        next x += 1 unless row[x]
+
+        run = 1
+        run += 1 while x + run < size && row[x + run]
+        path << "M#{x} #{y}h#{run}v1h-#{run}z"
+        x += run
+      end
+    end
+
+    box = size + 2 * QR_QUIET_ZONE
+    tag.svg(xmlns: "http://www.w3.org/2000/svg", "viewBox" => "-#{QR_QUIET_ZONE} -#{QR_QUIET_ZONE} #{box} #{box}",
+      "shape-rendering" => "crispEdges", style: "--qr-modules: #{box}", role: "img", aria: { label: label }, data: { url: text }) do
+      tag.path(d: path, fill: "currentColor")
+    end
+  end
+
+  # Subscription params for live_controller.js / play_controller.js.
+  def player_channel_params(game, player)
+    { channel: "PlayerChannel", code: game.code, player: player&.signed_id(purpose: :live) }.compact
+  end
+
+  def screen_channel_params(game)
+    { channel: "ScreenChannel", game: game.signed_id(purpose: :screen) }
+  end
+
+  # Status of a game in the quiz page's list of games.
+  def game_status(game)
+    case game.status
+    when "lobby" then "Waiting to start"
+    when "over" then "Over"
+    else "Question #{game.question_number}"
+    end
+  end
+end
diff --git a/app/javascript/controllers/live_controller.js b/app/javascript/controllers/live_controller.js
new file mode 100644
index 0000000..0ebb221
--- /dev/null
+++ b/app/javascript/controllers/live_controller.js
@@ -0,0 +1,233 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo, cable } from "@hotwired/turbo-rails"
+
+// Keeps a live region (a game's big screen, a player's phone) in sync with the
+// server, built for crowded conference Wi-Fi where connections drop, stall and
+// lose messages:
+//
+// - Action Cable messages are only signals ("the game changed"). The region is
+//   then fetched fresh over HTTP (`url`), so a lost message is never fatal and
+//   nothing has to be replayed.
+// - Every (re)connection fetches the region too: whatever changed while the
+//   connection was down shows up at once.
+// - A slow poll runs while the cable is up (safety net), a fast one while it is
+//   down (WebSockets blocked or flapping): the page follows the game either way.
+// - Fetches time out, never overlap (one in flight, one queued) and back off on
+//   errors. They never navigate: a failed Turbo visit would reload the page and
+//   could leave a phone on the browser's offline error page.
+// - The region is one root element with data-live-version; an unchanged
+//   version leaves the DOM alone, a new one is morphed in.
+// - Leaving the page (closing it, navigating away) unsubscribes right away:
+//   browsers may keep the page and its WebSocket alive in the back/forward
+//   cache, and the player would only time out. Coming back resubscribes.
+//
+// Values: url, channel (subscription params), poll / offlinePoll (ms),
+// heartbeat (ms, 0 = none: performs "heartbeat" on the channel), jitter (ms:
+// spreads the fetches of a crowd of phones after a signal).
+export default class extends Controller {
+  static values = {
+    url: String,
+    channel: Object,
+    poll: { type: Number, default: 30000 },
+    offlinePoll: { type: Number, default: 3000 },
+    heartbeat: { type: Number, default: 0 },
+    jitter: { type: Number, default: 0 }
+  }
+
+  static FETCH_TIMEOUT = 10000
+  static MAX_BACKOFF = 15000
+
+  connect() {
+    this.active = true
+    this.paused = false
+    this.cableUp = false
+    this.failures = 0
+    this.wake = () => { if (document.visibilityState !== "hidden") this.refresh() }
+    this.leave = () => this.pause()
+    this.comeBack = () => this.resume()
+    document.addEventListener("visibilitychange", this.wake)
+    document.addEventListener("resume", this.wake) // unfrozen (Page Lifecycle)
+    window.addEventListener("online", this.wake)
+    window.addEventListener("pagehide", this.leave)
+    window.addEventListener("pageshow", this.comeBack)
+    this.subscribe()
+    this.schedulePoll()
+  }
+
+  disconnect() {
+    this.active = false
+    this.stop()
+    document.removeEventListener("visibilitychange", this.wake)
+    document.removeEventListener("resume", this.wake)
+    window.removeEventListener("online", this.wake)
+    window.removeEventListener("pagehide", this.leave)
+    window.removeEventListener("pageshow", this.comeBack)
+  }
+
+  get running() {
+    return this.active && !this.paused
+  }
+
+  // The page is going away (closed, navigated from, put in the back/forward cache).
+  pause() {
+    if (!this.running) return
+
+    this.paused = true
+    this.stop()
+  }
+
+  // Back from the back/forward cache: follow the game again, catching up first.
+  resume() {
+    if (!this.active || !this.paused) return
+
+    this.paused = false
+    this.subscribe()
+    this.refresh()
+  }
+
+  stop() {
+    this.generation = (this.generation || 0) + 1 // cancels a subscription still being set up
+    clearTimeout(this.pollTimer)
+    clearTimeout(this.signalTimer)
+    this.stopHeartbeat()
+    this.cableUp = false
+    this.subscription?.unsubscribe()
+    this.subscription = null
+  }
+
+  // ---------- Live connection ----------
+
+  async subscribe() {
+    if (!this.hasChannelValue || !window.WebSocket) return
+
+    const generation = this.generation = (this.generation || 0) + 1
+    try {
+      const subscription = await cable.subscribeTo(this.channelValue, {
+        connected: () => this.cableConnected(),
+        disconnected: () => this.cableDisconnected(),
+        rejected: () => this.cableDisconnected(),
+        received: () => this.signal()
+      })
+      if (generation === this.generation && this.running) {
+        this.subscription = subscription
+      } else {
+        subscription.unsubscribe() // stopped while connecting
+      }
+    } catch (error) {
+      // No live connection: polling keeps the page up to date.
+    }
+  }
+
+  cableConnected() {
+    this.cableUp = true
+    this.startHeartbeat()
+    this.refresh() // catch up on anything missed while disconnected
+  }
+
+  cableDisconnected() {
+    this.cableUp = false
+    this.stopHeartbeat()
+    this.schedulePoll()
+  }
+
+  startHeartbeat() {
+    this.stopHeartbeat()
+    if (this.heartbeatValue > 0) {
+      this.heartbeatTimer = setInterval(() => this.subscription?.perform("heartbeat"), this.heartbeatValue)
+    }
+  }
+
+  stopHeartbeat() {
+    clearInterval(this.heartbeatTimer)
+  }
+
+  signal() {
+    clearTimeout(this.signalTimer)
+    this.signalTimer = setTimeout(() => this.refresh(), Math.random() * this.jitterValue)
+  }
+
+  // ---------- Fetching the region ----------
+
+  async refresh() {
+    if (!this.running) return
+    if (this.fetching) {
+      this.refreshQueued = true
+      return
+    }
+
+    this.fetching = true
+    clearTimeout(this.pollTimer)
+    try {
+      const html = await this.fetchRegion()
+      this.failures = 0
+      if (html !== null && this.running) this.render(html)
+    } catch (error) {
+      this.failures++
+    } finally {
+      this.fetching = false
+      if (this.refreshQueued && this.running) {
+        this.refreshQueued = false
+        this.refresh()
+      } else {
+        this.schedulePoll()
+      }
+    }
+  }
+
+  async fetchRegion() {
+    const abort = new AbortController()
+    const timeout = setTimeout(() => abort.abort(), this.constructor.FETCH_TIMEOUT)
+    try {
+      const response = await fetch(this.urlValue, {
+        headers: { "Accept": "text/html" },
+        credentials: "same-origin",
+        cache: "no-cache", // revalidate with the ETag: unchanged states cost a 304
+        signal: abort.signal
+      })
+      if (response.ok) return await response.text()
+      if (response.status === 404) {
+        window.location.reload() // the game is gone: show the page's own message
+        return null
+      }
+      throw new Error(`Live update failed: HTTP ${response.status}`)
+    } finally {
+      clearTimeout(timeout)
+    }
+  }
+
+  schedulePoll() {
+    clearTimeout(this.pollTimer)
+    if (!this.running) return
+
+    const base = this.cableUp ? this.pollValue : this.offlinePollValue
+    const delay = Math.min(base * 2 ** this.failures, Math.max(base, this.constructor.MAX_BACKOFF))
+    this.pollTimer = setTimeout(() => this.refresh(), delay * (0.8 + Math.random() * 0.4))
+  }
+
+  // ---------- Rendering ----------
+
+  render(html) {
+    const template = document.createElement("template")
+    template.innerHTML = html.trim()
+    const fresh = template.content.firstElementChild
+    if (!fresh || !fresh.hasAttribute("data-live-version")) return
+
+    if (fresh.dataset.liveVersion === this.version) return
+
+    if (typeof Turbo.morphChildren === "function") {
+      Turbo.morphChildren(this.element, template.content, { ignoreActiveValue: true }) // keep what is being typed
+    } else {
+      this.element.replaceChildren(template.content)
+    }
+    this.rendered()
+  }
+
+  get version() {
+    return this.element.querySelector(":scope > [data-live-version]")?.dataset.liveVersion
+  }
+
+  // Called after a new state was put in place.
+  rendered() {
+    this.dispatch("rendered")
+  }
+}
diff --git a/app/javascript/controllers/play_controller.js b/app/javascript/controllers/play_controller.js
new file mode 100644
index 0000000..76d0cee
--- /dev/null
+++ b/app/javascript/controllers/play_controller.js
@@ -0,0 +1,171 @@
+import LiveController from "controllers/live_controller"
+
+// A player's phone: the live game (see live_controller.js) plus answering.
+//
+// Tapping an option marks it "Your answer" at once and sends it in the
+// background. Built for flaky Wi-Fi: one request at a time and the latest pick
+// wins (so picks can't arrive out of order), each request times out, and a
+// failed one is retried with backoff until it gets through or the question is
+// gone. The server answers 204 (saved) or 409 (too late: the question closed).
+export default class extends LiveController {
+  static targets = ["options", "status"]
+
+  static SEND_TIMEOUT = 8000
+
+  disconnect() {
+    super.disconnect()
+    this.pick = null
+  }
+
+  resume() {
+    super.resume()
+    if (this.pick) this.deliver() // a pick still on its way when the page was left
+  }
+
+  answer(event) {
+    const button = event.currentTarget
+    const form = button.form
+    if (!form || !button.value) return
+
+    event.preventDefault()
+    this.pick = { url: form.action, question: form.dataset.question, option: button.value }
+    this.showPick()
+    this.deliver()
+  }
+
+  // ---------- Sending ----------
+
+  async deliver() {
+    if (this.delivering) return
+
+    this.delivering = true
+    let failures = 0
+    try {
+      while (this.pick && this.running) {
+        const pick = this.pick
+        this.setStatus(failures ? "No connection. Trying again…" : "Sending…")
+
+        let outcome
+        try {
+          outcome = await this.send(pick)
+        } catch (error) {
+          outcome = "retry" // offline, timed out, connection reset
+        }
+
+        if (outcome === "retry") {
+          failures++
+          this.setStatus("No connection. Trying again…")
+          await new Promise(resolve => setTimeout(resolve, Math.min(1000 * 2 ** (failures - 1), 8000)))
+          continue // the latest pick, which may have changed meanwhile
+        }
+
+        failures = 0
+        if (this.pick === pick) this.pick = null
+        if (outcome === "refused") {
+          this.pick = null
+          this.refresh() // the question closed: show the result
+        } else if (!this.pick) {
+          this.setStatus("Saved! You can still change it until the question closes.")
+        }
+      }
+    } finally {
+      this.delivering = false
+    }
+  }
+
+  async send(pick) {
+    const body = new FormData()
+    body.append("question_id", pick.question)
+    body.append("option_id", pick.option)
+
+    const abort = new AbortController()
+    const timeout = setTimeout(() => abort.abort(), this.constructor.SEND_TIMEOUT)
+    try {
+      const response = await fetch(pick.url, {
+        method: "POST",
+        body,
+        credentials: "same-origin",
+        headers: {
+          "Accept": "application/json",
+          "X-CSRF-Token": document.querySelector("meta[name=csrf-token]")?.content ?? ""
+        },
+        signal: abort.signal
+      })
+      if (response.ok) return "saved"
+      if (response.status === 409) return "refused"
+      if (response.status === 422) {
+        window.location.reload() // stale session or security token: start from a fresh page
+        return "refused"
+      }
+      return "retry" // server busy or restarting
+    } finally {
+      clearTimeout(timeout)
+    }
+  }
+
+  // ---------- Joining ----------
+
+  // The "Join" request never reached the server (Turbo shows nothing then).
+  joinFailed(event) {
+    const form = event.target.closest("form")
+    if (!form) return
+
+    let note = form.querySelector("[data-offline-note]")
+    if (!note) {
+      note = document.createElement("div")
+      note.className = "errors"
+      note.setAttribute("role", "alert")
+      note.dataset.offlineNote = ""
+      form.querySelector("button[type=submit]")?.before(note)
+    }
+    note.textContent = "No connection. Please try again."
+  }
+
+  joinRetried(event) {
+    event.target.closest("form")?.querySelector("[data-offline-note]")?.remove()
+  }
+
+  // ---------- Showing the pick ----------
+
+  // A new state was rendered: keep showing a pick that is still on its way,
+  // or forget it if its question is gone.
+  rendered() {
+    if (this.pick) {
+      if (this.currentQuestion === this.pick.question) {
+        this.showPick()
+        this.setStatus("Sending…")
+      } else {
+        this.pick = null
+      }
+    }
+    super.rendered()
+  }
+
+  get currentQuestion() {
+    return this.hasOptionsTarget ? this.optionsTarget.dataset.question : null
+  }
+
+  showPick() {
+    if (!this.hasOptionsTarget || this.currentQuestion !== this.pick?.question) return
+
+    for (const button of this.optionsTarget.querySelectorAll("button[name=option_id]")) {
+      const picked = button.value === this.pick.option
+      button.classList.toggle("is-picked", picked)
+      button.setAttribute("aria-pressed", picked)
+
+      let mark = button.querySelector(".play-option__mark")
+      if (picked && !mark) {
+        mark = document.createElement("span")
+        mark.className = "play-option__mark"
+        mark.textContent = "Your answer"
+        button.append(mark)
+      } else if (!picked && mark) {
+        mark.remove()
+      }
+    }
+  }
+
+  setStatus(text) {
+    if (this.hasStatusTarget && this.statusTarget.textContent.trim() !== text) this.statusTarget.textContent = text
+  }
+}
