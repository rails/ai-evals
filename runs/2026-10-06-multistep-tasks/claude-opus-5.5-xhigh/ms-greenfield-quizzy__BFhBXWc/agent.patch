+class CreateGames < ActiveRecord::Migration[8.1]
+  def change
+    create_table :games do |t|
+      t.references :quiz, null: false, foreign_key: { on_delete: :cascade }
+      # Join code in the player link (/play/K7RZX).
+      t.string :code, null: false
+      # lobby → question_open → question_closed → question_open → … → over
+      t.string :status, null: false, default: "lobby"
+      # Questions shown so far, in order; the last one is the current question.
+      # What comes next is the quiz's active questions not played yet.
+      t.json :played_question_ids, null: false, default: []
+      # Optimistic locking: every state change bumps it. Moderator buttons send
+      # the version they were rendered for, so a double click or a retried
+      # request can never skip a question.
+      t.integer :lock_version, null: false, default: 0
+      t.datetime :started_at
+      t.datetime :ended_at
+
+      t.timestamps
+    end
+
+    add_index :games, :code, unique: true
+  end
+end
