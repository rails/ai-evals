diff --git a/script/latency_probe.rb b/script/latency_probe.rb
new file mode 100644
index 0000000..c161a63
--- /dev/null
+++ b/script/latency_probe.rb
@@ -0,0 +1,83 @@
+# Measures how fast phones and a second big screen follow the moderator's clicks,
+# against a running server (Ferrum, the headless Chromium driver behind Cuprite).
+#
+#   RAILS_ENV=production PORT=3100 SECRET_KEY_BASE=… QUIZZY_MODERATOR_USERNAME=moderator \
+#     QUIZZY_MODERATOR_PASSWORD=secret bin/serve &
+#   QUIZ_ID=<a quiz with 3 active questions whose options are titled "a" (correct) and "b">
+#   BASE=http://127.0.0.1:3100 QUIZ_ID=1 PHONES=6 bundle exec ruby script/latency_probe.rb
+#
+# Prints, per moderator click, the delay until each watched page shows the new
+# state (min / max) and the spread between pages.
+require "ferrum"
+require "base64"
+
+BASE = ENV.fetch("BASE", "http://127.0.0.1:3100")
+PHONES = Integer(ENV.fetch("PHONES", "6"))
+AUTH = "Basic " + Base64.strict_encode64("moderator:secret")
+
+browser = Ferrum::Browser.new(browser_path: "/usr/bin/chromium", browser_options: { "no-sandbox" => nil }, timeout: 20, process_timeout: 30)
+
+def wait_for(page, js, timeout: 10)
+  deadline = Time.now + timeout
+  until page.evaluate(js)
+    raise "timeout waiting for #{js}" if Time.now > deadline
+    sleep 0.02
+  end
+end
+
+def text(page) = page.evaluate("document.body.innerText")
+
+screen = browser.create_page(new_context: true)
+screen.headers.set("Authorization" => AUTH)
+screen.go_to("#{BASE}/moderate/quizzes/#{ENV.fetch("QUIZ_ID")}")
+screen.at_xpath("//button[normalize-space()='Start a game']").click
+wait_for(screen, "!!document.querySelector('.lobby__url')")
+join = "http://" + screen.at_css(".lobby__url").text.strip
+
+phones = Array.new(PHONES) do |i|
+  page = browser.create_page(new_context: true)
+  page.go_to(join)
+  page.at_css("input[name='player[name]']").focus.type("P#{i}")
+  page.at_xpath("//button[normalize-space()='Join']").click
+  wait_for(page, "document.body.innerText.includes('Hi, P#{i}!')")
+  page
+end
+second = browser.create_page(new_context: true) # a second big screen (projector) following the moderator
+second.headers.set("Authorization" => AUTH)
+second.go_to(screen.current_url)
+sleep 1.5 # let cables connect
+
+WATCH = <<~JS
+  (needle) => {
+    window.__seen = null
+    const check = () => { if (window.__seen === null && document.body.innerText.includes(needle)) window.__seen = Date.now() }
+    new MutationObserver(check).observe(document.body, { subtree: true, childList: true, characterData: true })
+    check()
+  }
+JS
+
+# watched: { page => needle }
+def step(screen, button, watched, label)
+  watched.each { |page, needle| page.evaluate_func(WATCH, needle) }
+  t0 = screen.evaluate("Date.now()")
+  screen.at_xpath("//button[normalize-space()='#{button}']").click
+  watched.each_key { |page| wait_for(page, "window.__seen !== null") }
+  delays = watched.keys.map { |page| page.evaluate("window.__seen") - t0 }
+  puts format("%-10s %-24s min %4d ms  max %4d ms  spread %4d ms", button, label, delays.min, delays.max, delays.max - delays.min)
+  delays
+end
+
+opening = []
+3.times do |round|
+  n = round + 1
+  opening.concat step(screen, n == 1 ? "Start" : "Next", phones.to_h { [ it, "Question #{n} of" ] }, "phones: question #{n}")
+  phones.each_with_index { |p, i| p.at_xpath("//button[@name='option_id'][.//span[normalize-space()='#{i.even? ? "a" : "b"}']]").click }
+  wait_for(screen, "document.body.innerText.includes('Answers: #{PHONES} / #{PHONES}')")
+  step(screen, "Finish", phones.to_h { [ it, "Eyes on the big screen" ] }.merge(second => "Correct"), "phones + 2nd screen")
+end
+step(screen, "End quiz", phones.to_h { [ it, "Place " ] }.merge(second => "The quiz is over"), "phones + 2nd screen")
+winners = phones.select.with_index { |_, i| i.even? } # answered "a" (right) every time
+step(screen, screen.evaluate("[...document.querySelectorAll('button')].map(b => b.innerText.trim()).find(t => /^Top \\d+$/.test(t))"),
+  winners.to_h { [ it, "You won!" ] }.merge(second => "Winner"), "winners + 2nd screen")
+puts "question opening, all rounds: max #{opening.max} ms, mean #{(opening.sum / opening.size.to_f).round} ms"
+browser.quit
