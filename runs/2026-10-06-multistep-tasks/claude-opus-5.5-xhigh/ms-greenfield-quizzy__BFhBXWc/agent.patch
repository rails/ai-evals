diff --git a/app/assets/stylesheets/application.css b/app/assets/stylesheets/application.css
new file mode 100644
index 0000000..e9b648f
--- /dev/null
+++ b/app/assets/stylesheets/application.css
@@ -0,0 +1,233 @@
+/*
+ * Quizzy app styles, loaded after the design's quizzy.css.
+ * Keep the design's look: lavender pages, blue ink, pink accents, pill buttons.
+ */
+
+/* ---------- Accessibility ---------- */
+
+.btn:focus-visible,
+a:focus-visible,
+.play-option:focus-visible,
+input[type="checkbox"]:focus-visible {
+  outline: 3px solid var(--c-pink);
+  outline-offset: 3px;
+}
+
+/* ---------- Text ---------- */
+
+h1, h2, h3 { overflow-wrap: anywhere; }
+
+/* ---------- Buttons ---------- */
+
+/* Rails' button_to wraps each button in its own form. */
+form.button_to { display: inline-flex; margin: 0; }
+.buttons form.button_to,
+.section-head form.button_to,
+.page-head form.button_to { display: contents; }
+
+.btn--block { width: 100%; }
+.btn--add { gap: 0.2em; } /* "+ Add option" spaced like plain text */
+
+/* ---------- Moderator layout ---------- */
+
+.admin-header .logo { text-decoration: none; }
+
+.errors > div + div { margin-top: 4px; }
+
+.danger-zone { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; }
+.danger-zone p { margin: 0; }
+
+/* ---------- Quiz export / import ---------- */
+
+/* The hidden attribute must win over classes that set display (e.g. .btn). */
+[hidden] { display: none !important; }
+
+/* The export JSON (.code-block from the design wraps long lines): focusable, so keyboards can reach and select it. */
+.code-block { tab-size: 2; }
+.code-block:focus-visible { outline: 3px solid var(--c-pink); outline-offset: 3px; border-radius: 4px; }
+
+/* The design gives textarea.input the text font (a more specific rule than .input--code). */
+textarea.input--code { font: 500 15px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace; min-height: 320px; tab-size: 2; }
+
+/* Quiz tiles: each tile is a list item; the title link covers the whole card. */
+.quiz-list { list-style: none; padding: 0; margin: 0; }
+.quiz-tile { position: relative; margin: 0; }
+.quiz-tile h3 { overflow-wrap: anywhere; }
+.quiz-tile__link { text-decoration: none; }
+.quiz-tile__link::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
+.quiz-tile:hover .quiz-tile__link { color: var(--c-pink); }
+.quiz-tile:focus-within { outline: 3px solid var(--c-pink); outline-offset: 3px; }
+.quiz-tile__link:focus-visible { outline: none; }
+
+/* Question cards */
+.question-list { display: flex; flex-direction: column; gap: 16px; }
+.question-list > .question-item { margin: 0; }
+.question-item__body { overflow-wrap: anywhere; }
+.question-item__option { overflow-wrap: anywhere; }
+.question-item__actions form { display: contents; }
+
+@media (max-width: 700px) {
+  .question-item { grid-template-columns: auto minmax(0, 1fr); }
+  .question-item__actions {
+    grid-column: 1 / -1;
+    flex-direction: row;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+  }
+}
+
+/* Question form: option rows */
+.option-row__correct { white-space: nowrap; }
+/* The label reads "Option 1 is correct" for assistive tech; sighted users see "Correct". */
+
+@media (max-width: 520px) {
+  .option-row { gap: 8px; }
+}
+
+/* ---------- Preview (player view on a phone) ---------- */
+
+.preview-page { display: flex; flex-direction: column; }
+.preview-page .play { flex: 1; width: 100%; min-height: 0; }
+
+.preview-banner .btn { font-size: 14px; padding: 0.5em 1em; }
+.preview-banner__actions { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
+
+.play-options form { display: contents; }
+button.play-option[disabled] { cursor: default; }
+button.play-option[disabled]:hover { box-shadow: inset 0 0 0 2px transparent; }
+.play-options.is-locked .play-option[disabled] { opacity: 0.55; }
+.play-options.is-locked .play-option.is-picked,
+.play-options.is-revealed .play-option.is-correct { opacity: 1; }
+
+.play-actions { margin-top: 20px; display: flex; flex-direction: column; gap: 12px; }
+.play-actions form { display: contents; }
+.play-actions .btn { width: 100%; font-size: 22px; padding: 0.9em; }
+
+.result-card { padding: 40px 24px; }
+.result-card__score { font-size: clamp(44px, 14vw, 72px); font-weight: 900; letter-spacing: -0.03em; line-height: 1; margin-bottom: 16px; }
+
+/* ---------- Home ---------- */
+
+.home__links { display: flex; flex-wrap: wrap; gap: 12px; }
+
+/* ---------- Live games ---------- */
+
+/* The live region's root (data-live-version) must not change the layout. */
+.live-state { display: contents; }
+
+/* Big screen */
+.screen-page { background: var(--c-blue); }
+.screen-page .flash { bottom: 110px; }
+.screen__top { min-width: 0; }
+.screen__title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.lobby > div { min-width: 0; }
+.lobby__url { margin-top: 0.1em; }
+.qr { color: var(--c-night); display: grid; place-items: center; }
+/* Whole-pixel modules (the SVG's width a multiple of its module count, --qr-modules):
+   crisp, evenly sized squares that any scanner reads, even from a photo or screenshot. */
+.qr svg { width: 100%; height: auto; aspect-ratio: 1; }
+@supports (width: round(down, 100%, 1px)) {
+  .qr svg { width: round(down, 100%, calc(var(--qr-modules) * 1px)); }
+}
+.screen-controls .btn { white-space: nowrap; }
+.screen-controls__join { font-weight: 600; overflow-wrap: anywhere; }
+.screen-controls__join::before { content: "Join: " attr(data-join-link); }
+.answers-counter { margin-top: clamp(16px, 2vw, 32px); align-self: flex-start; }
+.stage-option__count { min-width: 1.4em; text-align: right; }
+.stage-option__bar { animation: share-grow 0.8s ease-out; }
+@keyframes share-grow { from { width: 0; } }
+
+@media (prefers-reduced-motion: reduce) {
+  .stage-option__bar { animation: none; }
+}
+
+/* Phone */
+.play__quiz { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.join-form .field-label { text-align: center; }
+.join-form .errors { margin: 0; text-align: center; }
+.waiting__gem--still { animation: none; }
+.play-options[aria-busy="true"] { cursor: progress; }
+
+/* ---------- Leaderboard and prizes ---------- */
+
+/* Big screen: a long name is cut short, never the "Winner" badge or the points. */
+.leaderboard-layout { width: 100%; }
+.leader__name { display: flex; align-items: center; gap: 0.4em; min-width: 0; }
+.leader__player { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.leader__badge { flex-shrink: 0; margin-left: 0; }
+.leader__score { white-space: nowrap; }
+.screen-controls .buttons { justify-content: flex-end; }
+
+@media (prefers-reduced-motion: reduce) {
+  .leader.is-winner, .winner-banner { animation: none; }
+}
+
+/* Phone, after the end: place, points, and the prize. */
+.result-card--final { padding: 0; }
+.result-card--final .result-card__label {
+  margin: 0 0 6px;
+  font-family: var(--f-display);
+  font-weight: 900;
+  font-size: clamp(36px, 11vw, 56px);
+  line-height: 1;
+  letter-spacing: -0.02em;
+}
+.result-card--final .result-card__score { margin: 0; font-size: 26px; font-weight: 800; letter-spacing: 0; line-height: 1.2; }
+.winner-banner { width: 100%; text-align: center; }
+.winner-banner__title { display: block; }
+
+/* Narrow big screens (a moderator checking on a phone): three buttons in the bar stay clear of the content. */
+@media (max-width: 600px) {
+  .screen-controls { flex-wrap: wrap; }
+  .screen-controls .btn--lg { font-size: 16px; padding: 0.6em 1em; }
+  .screen { padding-bottom: 170px; }
+}
+
+/* ---------- Question timer ---------- */
+
+/* Quiz settings: "Timer minutes" and "Timer seconds" side by side under one legend. */
+.field-group { border: 0; padding: 0; margin: 0 0 20px; min-width: 0; }
+.field-group > legend { padding: 0; margin-bottom: 6px; }
+.field-group__row { display: flex; flex-wrap: wrap; gap: 16px; }
+.field-group__item { margin-bottom: 0; }
+.field .field-sublabel { font-weight: 500; font-size: 14px; color: var(--c-muted); }
+.field-group .field-hint { display: block; margin-top: 6px; }
+
+/* Big screen: the countdown of an open question, opposite "Question 1 of 3". */
+.stage-question__head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  margin-bottom: 0.6em;
+  font-size: clamp(20px, 2vw, 36px); /* the 0.6em gap matches .stage-question__num on its own */
+}
+.stage-question__head .stage-question__num { margin-bottom: 0; }
+.countdown {
+  --countdown-size: clamp(28px, 3.4vw, 64px);
+  flex-shrink: 0;
+  min-width: 3.6ch;
+  padding: 0.2em 0.55em;
+  border-radius: 1000px;
+  background: var(--c-sun);
+  color: var(--c-night);
+  font-family: var(--f-display);
+  font-weight: 900;
+  font-size: var(--countdown-size);
+  font-variant-numeric: tabular-nums; /* digits keep their width: the pill does not wobble every second */
+  letter-spacing: 0;
+  line-height: 1;
+  text-align: center;
+  box-shadow: 0 12px 40px rgb(0 0 51 / 0.3);
+  transition: background-color 0.3s, color 0.3s;
+}
+/* A timed question keeps the countdown's height once closed: nothing jumps at 0:00 or "Finish". */
+.stage-question__head--timed { min-height: calc(1.4 * clamp(28px, 3.4vw, 64px)); }
+/* The last seconds (countdown_controller.js keeps the class up to date). */
+.countdown.is-ending { background: var(--c-pink); color: var(--c-white); animation: countdown-pulse 1s ease-in-out infinite; }
+@keyframes countdown-pulse { 50% { transform: scale(1.06); } }
+
+@media (prefers-reduced-motion: reduce) {
+  .countdown.is-ending { animation: none; }
+}
diff --git a/app/assets/stylesheets/quizzy.css b/app/assets/stylesheets/quizzy.css
new file mode 100644
index 0000000..2023b61
--- /dev/null
+++ b/app/assets/stylesheets/quizzy.css
@@ -0,0 +1,779 @@
+/*
+ * Quizzy: a live quiz for conference screens.
+ * Bright colors for LED walls and projectors, big type, pill buttons.
+ *
+ * From the design file (docs/mockups/quizzy.css). Adapted: option chips on
+ * question cards use .question-item__option instead of <li> elements.
+ */
+
+@font-face {
+  font-family: "Inter";
+  font-display: swap;
+  font-style: normal;
+  font-weight: 100 900;
+  src: url("Inter-latin.woff2") format("woff2");
+}
+
+:root {
+  --c-lavender: #e9e6ff;
+  --c-blue: #2a12c9;
+  --c-pink: #ff2e88;
+  --c-night: #0d0640;
+  --c-sun: #ffd23f;
+  --c-white: #fff;
+  --c-success: #00b36b;
+  --c-muted: #6f66b8;
+
+  --f-display: "Inter", system-ui, sans-serif;
+  --f-text: "Inter", system-ui, -apple-system, sans-serif;
+
+  --radius: 16px;
+  --gutter: clamp(16px, 4vw, 60px);
+}
+
+*, *::before, *::after { box-sizing: border-box; }
+
+html { -webkit-text-size-adjust: 100%; }
+
+body {
+  margin: 0;
+  min-height: 100vh;
+  min-height: 100dvh;
+  background: var(--c-lavender);
+  color: var(--c-blue);
+  font-family: var(--f-text);
+  font-size: 18px;
+  line-height: 1.35;
+  letter-spacing: -0.01em;
+  -webkit-font-smoothing: antialiased;
+}
+
+h1, h2, h3 {
+  font-family: var(--f-display);
+  font-weight: 900;
+  letter-spacing: -0.035em;
+  line-height: 1;
+  margin: 0 0 0.5em;
+}
+
+h1 { font-size: clamp(36px, 6vw, 72px); }
+h2 { font-size: clamp(26px, 3.5vw, 44px); }
+h3 { font-size: clamp(20px, 2.2vw, 28px); }
+
+p { margin: 0 0 1em; }
+
+a { color: inherit; text-underline-offset: 0.15em; }
+a:hover { color: var(--c-pink); }
+
+img, svg { max-width: 100%; }
+
+.logo {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.18em;
+  font: 900 32px/1 var(--f-display);
+  letter-spacing: -0.05em;
+  color: inherit;
+  white-space: nowrap;
+}
+.logo__mark {
+  display: inline-grid;
+  place-items: center;
+  width: 1.05em;
+  height: 1.05em;
+  border-radius: 50% 50% 50% 12%;
+  background: var(--c-sun);
+  color: var(--c-night);
+  font-size: 0.8em;
+  letter-spacing: 0;
+}
+
+/* ---------- Buttons ---------- */
+
+.btn {
+  appearance: none;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.4em;
+  border: 0;
+  border-radius: 1000px;
+  background: var(--c-blue);
+  color: var(--c-lavender);
+  font: 600 18px/1 var(--f-text);
+  letter-spacing: -0.01em;
+  padding: 0.85em 1.4em;
+  text-decoration: none;
+  white-space: nowrap;
+  cursor: pointer;
