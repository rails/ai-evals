@@ -0,0 +1,36 @@
+require "test_helper"
+
+class QuizExportTest < ActiveSupport::TestCase
+  test "writes the title and the questions with their options, in order, and nothing else" do
+    quiz = create_sample_quiz
+    quiz.questions.first.move_down!
+
+    assert_equal({
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        { "text" => "Which protocol keeps a two-way connection?", "active" => true, "options" => [
+          { "text" => "WebSocket", "correct" => true }, { "text" => "SMTP", "correct" => false }, { "text" => "FTP", "correct" => false } ] },
+        { "text" => "Which HTTP status code means \"Too Many Requests\"?", "active" => true, "options" => [
+          { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true },
+          { "text" => "503", "correct" => false }, { "text" => "409", "correct" => false } ] },
+        { "text" => "What does CSS stand for?", "active" => false, "options" => [
+          { "text" => "Cascading Style Sheets", "correct" => true }, { "text" => "Computer Style System", "correct" => false } ] }
+      ]
+    }, JSON.parse(QuizExport.new(quiz.reload).to_json))
+  end
+
+  test "an empty quiz" do
+    assert_equal({ "title" => "Empty", "questions" => [] }, JSON.parse(QuizExport.new(Quiz.create!(title: "Empty")).to_json))
+  end
+
+  test "is indented and keeps text readable" do
+    quiz = Quiz.create!(title: "<b>Fest</b> & “friends”")
+
+    assert_equal %({\n  "title": "<b>Fest</b> & “friends”",\n  "questions": []\n}), QuizExport.new(quiz).to_json
+  end
+
+  test "the timer is a setting of this Quizzy, not part of the export" do
+    quiz = Quiz.create!(title: "Timed", timer_minutes: 1, timer_seconds: 30)
+    assert_equal({ "title" => "Timed", "questions" => [] }, JSON.parse(QuizExport.new(quiz).to_json))
+  end
+end
diff --git a/test/models/quiz_import_test.rb b/test/models/quiz_import_test.rb
new file mode 100644
index 0000000..752e9ff
--- /dev/null
+++ b/test/models/quiz_import_test.rb
@@ -0,0 +1,196 @@
+require "test_helper"
+
+class QuizImportTest < ActiveSupport::TestCase
+  SAMPLE = {
+    "title" => "Frontend Fest 2026",
+    "questions" => [
+      { "text" => "Which HTTP status code means \"Too Many Requests\"?", "active" => true,
+        "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ] },
+      { "text" => "What does CSS stand for?", "active" => false,
+        "options" => [ { "text" => "Cascading Style Sheets", "correct" => true }, { "text" => "Computer Style System", "correct" => false } ] }
+    ]
+  }.freeze
+
+  def import(data)
+    QuizImport.new(json: data.is_a?(String) ? data : JSON.generate(data))
+  end
+
+  def sample_with(&change)
+    JSON.parse(JSON.generate(SAMPLE)).tap(&change)
+  end
+
+  def assert_not_imported(data, *messages)
+    import = import(data)
+
+    assert_no_difference [ -> { Quiz.count }, -> { Question.count }, -> { Option.count } ] do
+      assert_not import.save
+    end
+    assert_nil import.quiz
+    messages.each { |message| assert_includes import.errors.full_messages, message }
+    assert import.errors.any?
+    import
+  end
+
+  test "creates the quiz with its questions and options, in order" do
+    import = import(SAMPLE)
+
+    assert_difference -> { Quiz.count } => 1, -> { Question.count } => 2, -> { Option.count } => 4 do
+      assert import.save
+    end
+
+    quiz = import.quiz.reload
+    assert_equal "Frontend Fest 2026", quiz.title
+    assert_equal [ [ SAMPLE["questions"][0]["text"], true, 1 ], [ "What does CSS stand for?", false, 2 ] ],
+      quiz.questions.map { |question| [ question.body, question.active, question.position ] }
+    assert_equal [ [ "418", false ], [ "429", true ] ], quiz.questions.first.options.map { |option| [ option.title, option.correct ] }
+    assert_equal [ 1, 2 ], quiz.questions.first.options.map(&:position)
+  end
+
+  test "an export imports back to the same contents" do
+    quiz = create_sample_quiz
+    export = QuizExport.new(quiz).to_json
+
+    import = QuizImport.new(json: export)
+    assert import.save
+
+    assert_not_equal quiz.id, import.quiz.id
+    assert_equal export, QuizExport.new(import.quiz.reload).to_json
+  end
+
+  test "imported quizzes get this Quizzy's default settings: no timer" do
+    quiz = create_sample_quiz
+    quiz.update!(timer_minutes: 1, timer_seconds: 30, winners_count: 5)
+    import = QuizImport.new(json: QuizExport.new(quiz).to_json)
+    assert import.save
+    assert_equal [ 0, 0, 3 ], import.quiz.reload.values_at(:timer_minutes, :timer_seconds, :winners_count)
+
+    import = import(sample_with { it["timer_minutes"] = 2; it["timer_seconds"] = 10 }) # not part of the format: ignored
+    assert import.save
+    assert_not import.quiz.reload.timer?
+  end
+
+  test "always creates a new quiz, even with a title that exists" do
+    existing = Quiz.create!(title: "Frontend Fest 2026")
+
+    assert_difference -> { Quiz.where(title: "Frontend Fest 2026").count }, 2 do
+      2.times { assert import(SAMPLE).save }
+    end
+    assert_empty existing.reload.questions
+  end
+
+  test "active defaults to true and correct to false; null counts as not given" do
+    import = import({ "title" => "Defaults", "questions" => [
+      { "text" => "One", "options" => [ { "text" => "a", "correct" => true }, { "text" => "b" } ] },
+      { "text" => "Two", "active" => nil, "options" => [ { "text" => "a", "correct" => nil }, { "text" => "b", "correct" => true } ] }
+    ] })
+
+    assert import.save
+    assert_equal [ true, true ], import.quiz.questions.map(&:active)
+    assert_equal [ [ true, false ], [ false, true ] ], import.quiz.questions.map { |question| question.options.map(&:correct) }
+  end
+
+  test "a quiz without questions" do
+    assert import({ "title" => "Empty", "questions" => [] }).save
+  end
+
+  test "ignores unknown keys and a byte order mark" do
+    data = sample_with { |sample| sample["id"] = 7; sample["questions"][0]["position"] = 9; sample["questions"][0]["options"][0]["id"] = 1 }
+
+    import = QuizImport.new(json: "\uFEFF#{JSON.generate(data)}")
+    assert import.save
+    assert_equal 2, import.quiz.questions.size
+  end
+
+  test "the title is normalized like in the quiz form" do
+    import = import({ "title" => "  Frontend   Fest  ", "questions" => [] })
+
+    assert import.save
+    assert_equal "Frontend Fest", import.quiz.title
+  end
+
+  test "empty JSON" do
+    assert_not_imported "  \n", "Paste the JSON of a quiz first"
+  end
+
+  test "invalid JSON" do
+    import = assert_not_imported(%({"title": "Fest", "questions": [}))
+    assert_match(/\AThis isn't valid JSON: .*line 1/, import.errors.full_messages.sole)
+
+    assert_not_imported %({"title": "Fest", "questions": []} trailing)
+    assert_not_imported %({"title": "Fest", "questions": [],})
+  end
+
+  test "the JSON must be an object" do
+    [ "null", "[]", "42", %("Fest") ].each do |json|
+      assert_not_imported json, %(The JSON must be an object with "title" and "questions")
+    end
+  end
+
+  test "the title and the questions are required, with the right types" do
+    assert_not_imported({}, %("title" is missing), %("questions" is missing))
+    assert_not_imported({ "title" => 1, "questions" => {} }, %("title" must be a string), %("questions" must be a list))
+  end
+
+  test "the quiz form's title rules" do
+    assert_not_imported({ "title" => " ", "questions" => [] }, "Title can't be blank")
+    assert_not_imported({ "title" => "x" * 201, "questions" => [] }, "Title is too long (maximum is 200 characters)")
+  end
+
+  test "the shape of questions and options" do
+    assert_not_imported(sample_with { |sample| sample["questions"] << "Which planet?" }, "Question 3 must be an object")
+    assert_not_imported(sample_with { |sample| sample["questions"][1].delete("text") }, %(Question 2: "text" is missing))
+    assert_not_imported(sample_with { |sample| sample["questions"][1]["text"] = 1 }, %(Question 2: "text" must be a string))
+    assert_not_imported(sample_with { |sample| sample["questions"][1]["active"] = "no" }, %(Question 2: "active" must be true or false))
+    assert_not_imported(sample_with { |sample| sample["questions"][1].delete("options") }, %(Question 2: "options" is missing))
+    assert_not_imported(sample_with { |sample| sample["questions"][1]["options"] = "a, b" }, %(Question 2: "options" must be a list))
+    assert_not_imported(sample_with { |sample| sample["questions"][0]["options"] << "c" }, "Question 1, option 3 must be an object")
+    assert_not_imported(sample_with { |sample| sample["questions"][0]["options"][1].delete("text") }, %(Question 1, option 2: "text" is missing))
+    assert_not_imported(sample_with { |sample| sample["questions"][0]["options"][1]["text"] = 429 }, %(Question 1, option 2: "text" must be a string))
+    assert_not_imported(sample_with { |sample| sample["questions"][0]["options"][1]["correct"] = "true" },
+      %(Question 1, option 2: "correct" must be true or false))
+  end
+
+  test "a shape problem isn't reported again as a broken rule" do
+    import = assert_not_imported(sample_with { |sample| sample["questions"][1]["text"] = 1 })
+    assert_equal [ %(Question 2: "text" must be a string) ], import.errors.full_messages
+  end
+
+  test "questions follow the question form's rules" do
+    assert_not_imported(sample_with { |sample| sample["questions"][1]["text"] = " " }, "Question 2: Question can't be blank")
+    assert_not_imported(sample_with { |sample| sample["questions"][1]["text"] = "x" * 2001 },
+      "Question 2: Question is too long (maximum is 2000 characters)")
+    assert_not_imported(sample_with { |sample| sample["questions"][1]["options"].pop }, "Question 2: Add at least two options")
+    assert_not_imported(sample_with { |sample| sample["questions"][1]["options"] = [] },
+      "Question 2: Add at least two options", "Question 2: Mark at least one option as correct")
+    assert_not_imported(sample_with { |sample| sample["questions"][0]["options"][1]["correct"] = false },
+      "Question 1: Mark at least one option as correct")
+  end
+
+  test "empty options are skipped, like empty rows of the question form" do
+    data = sample_with { |sample| sample["questions"][0]["options"].insert(1, { "text" => " ", "correct" => true }) }
+
+    import = import(data)
+    assert import.save
+    assert_equal [ [ "418", false ], [ "429", true ] ], import.quiz.questions.first.options.map { |option| [ option.title, option.correct ] }
+
+    assert_not_imported(sample_with { |sample| sample["questions"][0]["options"][1]["text"] = "" }, "Question 1: Add at least two options")
+  end
+
+  test "option errors say which option, counting options as they appear in the JSON" do
+    data = sample_with { |sample| sample["questions"][0]["options"].unshift({ "text" => "" }).push({ "text" => "x" * 501 }) }
+
+    assert_not_imported data, "Question 1, option 4: Option is too long (maximum is 500 characters)"
+  end
+
+  test "reports every problem, and nothing is saved when only some questions are wrong" do
+    data = sample_with do |sample|
+      sample["title"] = ""
+      sample["questions"][1]["options"].each { |option| option["correct"] = false }
+      sample["questions"] << { "text" => "", "options" => [ { "text" => "only", "correct" => true } ] }
+    end
+
+    import = assert_not_imported(data)
+    assert_equal [ "Title can't be blank", "Question 2: Mark at least one option as correct",
+      "Question 3: Question can't be blank", "Question 3: Add at least two options" ], import.errors.full_messages
+  end
+end
diff --git a/test/models/quiz_preview_test.rb b/test/models/quiz_preview_test.rb
new file mode 100644
index 0000000..4dfa526
--- /dev/null
+++ b/test/models/quiz_preview_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class QuizPreviewTest < ActiveSupport::TestCase
+  setup do
+    @quiz = create_sample_quiz
+    @questions = @quiz.questions.active.includes(:options).to_a
+  end
+
+  def preview(**params) = QuizPreview.new(@questions, **params)
+  def option(question_index, title) = @questions[question_index].options.find_by!(title: title)
+
+  test "starts at the first active question" do
+    step = preview
+
+    assert_equal 1, step.number
+    assert_equal 2, step.total
+    assert_equal @questions.first, step.question
+    assert_not step.answered?
+  end
+
+  test "a correct pick adds to the score" do
+    step = preview(question: "1", score: "0", answer: option(0, "429").id.to_s)
+
+    assert step.answered?
+    assert step.correct?
+    assert_equal 1, step.score_after
+    assert_equal({ question: 2, score: 1 }, step.next_params)
+  end
+
+  test "a wrong pick does not" do
+    step = preview(question: "1", score: "0", answer: option(0, "418").id.to_s)
+
+    assert step.answered?
+    assert_not step.correct?
+    assert_equal({ question: 2, score: 0 }, step.next_params)
+  end
+
+  test "after the last question comes the score" do
+    step = preview(question: "2", score: "1", answer: option(1, "WebSocket").id.to_s)
+
+    assert step.last?
+    assert_equal({ finished: 1, score: 2 }, step.next_params)
+
+    result = preview(finished: "1", score: "2")
+    assert result.finished?
+    assert_equal [ 2, 2 ], [ result.score, result.total ]
+  end
+
+  test "ignores options from other questions" do
+    step = preview(question: "1", score: "0", answer: option(1, "WebSocket").id.to_s)
+
+    assert_not step.answered?
+  end
+
+  test "clamps values from the URL" do
+    assert_equal [ 2, 1 ], preview(question: "99", score: "99").then { [ it.number, it.score ] }
+    assert_equal [ 1, 0 ], preview(question: "-3", score: "-1").then { [ it.number, it.score ] }
+    assert_equal [ 1, 0 ], preview(question: "abc", score: "1.5").then { [ it.number, it.score ] }
+    assert_equal 2, preview(finished: "1", score: "7").score
+  end
+
+  test "a quiz without active questions has nothing to preview" do
+    step = QuizPreview.new([], finished: "1")
+
+    assert step.empty?
+    assert_not step.finished?
+    assert_nil step.question
+  end
+end
diff --git a/test/models/quiz_test.rb b/test/models/quiz_test.rb
new file mode 100644
index 0000000..0f04d16
--- /dev/null
+++ b/test/models/quiz_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class QuizTest < ActiveSupport::TestCase
+  test "title is required" do
+    quiz = Quiz.new(title: "  ")
+
+    assert_not quiz.valid?
+    assert_equal [ "Title can't be blank" ], quiz.errors.full_messages
+  end
+
+  test "title is squished" do
+    assert_equal "Frontend Fest 2026", Quiz.create!(title: "  Frontend   Fest 2026 ").title
+  end
+
+  test "questions come in order" do
+    quiz = create_sample_quiz
+    quiz.questions.last.move_up!
+
+    assert_equal [ "Which HTTP status code means \"Too Many Requests\"?", "What does CSS stand for?", "Which protocol keeps a two-way connection?" ],
+      quiz.reload.questions.map(&:body)
+  end
+
+  test "number of winners: 3 by default, a whole number of at least 1" do
+    assert_equal 3, Quiz.new.winners_count
+    assert_equal 3, Quiz.create!(title: "Defaults").reload.winners_count
+
+    { "0" => "Number of winners must be at least 1", "-2" => "Number of winners must be at least 1",
+      "" => "Number of winners can't be blank", "2.5" => "Number of winners must be an integer",
+      "lots" => "Number of winners is not a number", "1001" => "Number of winners must be at most 1000" }.each do |value, message|
+      quiz = Quiz.new(title: "Prizes", winners_count: value)
+      assert_not quiz.valid?, value
+      assert_equal [ message ], quiz.errors.full_messages
+    end
+    assert Quiz.new(title: "Prizes", winners_count: "1").valid?
+    assert_equal 10, Quiz.create!(title: "Prizes", winners_count: "10").winners_count
+  end
+
+  test "timer: 0 minutes and 0 seconds (no timer) by default" do
+    quiz = Quiz.create!(title: "Defaults").reload
+    assert_equal [ 0, 0 ], [ quiz.timer_minutes, quiz.timer_seconds ]
+    assert_equal 0, quiz.timer_duration
+    assert_not quiz.timer?
+  end
+
+  test "timer: whole minutes and seconds make the time per question" do
+    quiz = Quiz.create!(title: "Timed", timer_minutes: "1", timer_seconds: "30")
+    assert_equal 90, quiz.timer_duration
+    assert quiz.timer?
+    assert_equal 5, Quiz.new(timer_seconds: "5").timer_duration
+    assert_equal 120, Quiz.new(timer_minutes: "2").timer_duration
+  end
+
+  test "timer: an emptied field counts as 0" do
+    quiz = Quiz.new(title: "Timed", timer_minutes: "", timer_seconds: " ")
+    assert quiz.valid?
+    assert_equal [ 0, 0 ], [ quiz.timer_minutes, quiz.timer_seconds ]
+  end
+
+  test "timer: minutes 0 to 99, seconds 0 to 59" do
+    { { timer_minutes: "-1" } => "Timer minutes must be at least 0", { timer_minutes: "100" } => "Timer minutes must be at most 99",
+      { timer_minutes: "1.5" } => "Timer minutes must be an integer", { timer_minutes: "a" } => "Timer minutes is not a number",
+      { timer_seconds: "-5" } => "Timer seconds must be at least 0", { timer_seconds: "60" } => "Timer seconds must be at most 59",
+      { timer_seconds: "0.5" } => "Timer seconds must be an integer", { timer_seconds: "soon" } => "Timer seconds is not a number" }.each do |attributes, message|
+      quiz = Quiz.new(title: "Timed", **attributes)
+      assert_not quiz.valid?, attributes.inspect
+      assert_equal [ message ], quiz.errors.full_messages
+    end
+    assert Quiz.new(title: "Timed", timer_minutes: "99", timer_seconds: "59").valid?
+  end
+end
diff --git a/test/models/screen_view_test.rb b/test/models/screen_view_test.rb
new file mode 100644
index 0000000..46404c8
--- /dev/null
+++ b/test/models/screen_view_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class ScreenViewTest < ActiveSupport::TestCase
+  setup do
+    @quiz = create_sample_quiz
+    @first, @second = @quiz.questions.to_a
+    @game = Game.start_for!(@quiz)
+  end
+
+  def screen = ScreenView.new(@game.reload)
+
+  test "the lobby counts players waiting right now" do
+    before = screen.version
+    alice = join_game(@game, "Alice")
+    assert_equal 1, screen.players_count
+    assert_not_equal before, screen.version
+
+    alice.update_columns(last_seen_at: 1.minute.ago)
+    assert_equal 0, screen.players_count
+    assert_equal before, screen.version
+  end
+
+  test "the open question counts answers and players in the game" do
+    alice = join_game(@game, "Alice")
+    join_game(@game, "Bob")
+    @game.start!
+    before = screen.version
+    assert_equal [ 0, 2 ], [ screen.answered_count, screen.in_game_count ]
+
+    @game.answer!(alice, question_id: @first.id, option_id: option_of(@first, "429").id)
+    assert_equal [ 1, 2 ], [ screen.answered_count, screen.in_game_count ]
+    assert_not_equal before, screen.version
+  end
+
+  test "the closed question has counts and shares per option" do
+    players = Array.new(4) { join_game(@game, "P#{it}") }
+    @game.start!
+    %w[ 429 429 429 418 ].zip(players) { |title, player| @game.answer!(player, question_id: @first.id, option_id: option_of(@first, title).id) }
+    @game.finish_question!
+
+    assert_equal [ 1, 3, 0, 0 ], @first.options.map { screen.count_for(it) }
+    assert_equal [ 25, 75, 0, 0 ], @first.options.map { screen.share_for(it) }
+    assert_not screen.last_question?
+  end
+
+  test "switching questions on or off changes Next / End quiz" do
+    @game.start!
+    @game.finish_question!
+    before = screen.version
+    @second.update!(active: false)
+
+    assert screen.last_question?
+    assert_not_equal before, screen.version
+  end
+
+  test "after the end: the leaderboard, the number of winners, ties for the draw" do
+    @quiz.update!(winners_count: 1)
+    alice, bob = join_game(@game, "Alice"), join_game(@game, "Bob")
+    join_game(@game, "Carol")
+    @game.start!
+    [ alice, bob ].each { |player| @game.answer!(player, question_id: @first.id, option_id: option_of(@first, "429").id) }
+    @game.finish_question!
+    @game.end!
+
+    assert_equal 3, screen.total_players
+    assert_equal 1, screen.winners_count
+    assert_equal [ true, true, false ], screen.leaderboard.map { screen.tied?(it) }, "Alice and Bob for one prize"
+
+    before = screen.version
+    @game.pick_top_winners!
+    assert_not_equal before, (after_top = screen.version)
+    @quiz.update!(winners_count: 2)
+    assert_not_equal after_top, screen.version, "\"Top 2\" now"
+    assert_equal [ false, false, false ], screen.leaderboard.map { screen.tied?(it) }
+  end
+
+  test "a timed open question shows the time left as M:SS, rounded up" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    freeze_time
+    @game.start!
+    before = screen.version
+    assert screen.timer?
+    assert_equal [ 90_000, "1:30" ], [ screen.time_left_ms, screen.time_left_text ]
+
+    travel 0.4.seconds, with_usec: true
+    assert_equal [ 89_600, "1:30" ], [ screen.time_left_ms, screen.time_left_text ]
+    travel 85.seconds
+    assert_equal "0:05", screen.time_left_text
+    travel 5.seconds
+    assert_equal [ 0, "0:00" ], [ screen.time_left_ms, screen.time_left_text ]
+    assert_equal before, screen.version, "the time left isn't part of the version"
+  end
+
+  test "no countdown without a timer, in the lobby or once closed" do
+    assert_not screen.timer?
+    @game.start!
+    assert_not screen.timer?
+    assert_nil screen.time_left_text
+
+    @quiz.update!(timer_seconds: 30)
+    @game.finish_question!
+    @game.next_question!
+    assert screen.timer?
+    @game.finish_question!
+    assert_not screen.timer?
+  end
+
+  test "countdown text" do
+    assert_equal %w[ 0:00 0:05 0:59 1:00 1:30 10:00 99:59 ], [ 0, 5, 59, 60, 90, 600, 5999 ].map { ScreenView.countdown_text(it) }
+  end
+end
diff --git a/test/system/games_test.rb b/test/system/games_test.rb
new file mode 100644
index 0000000..5213cff
--- /dev/null
+++ b/test/system/games_test.rb
@@ -0,0 +1,269 @@
+require "application_system_test_case"
+
+# A live game with the big screen (the default session, signed in as the
+# moderator) and phones (one Capybara session each, so one browser each).
+class GamesTest < ApplicationSystemTestCase
+  setup do
+    @quiz = create_sample_quiz
+    @default_wait, Capybara.default_max_wait_time = Capybara.default_max_wait_time, 5
+  end
+
+  teardown do
+    Capybara.default_max_wait_time = @default_wait
+  end
+
+  def open_big_screen
+    visit moderate_quiz_path(@quiz)
+    click_button "Start a game"
+    assert_text "Players: 0"
+    @join_link = find(".lobby__url").text
+    assert_match %r{\A127\.0\.0\.1:\d+/play/[A-Z0-9]{5}\z}, @join_link
+  end
+
+  def phone(name, &block) = using_session(name, &block)
+
+  def join_as(name)
+    phone(name) do
+      visit "http://#{@join_link}"
+      fill_in "Your name", with: name
+      click_button "Join"
+      assert_text "Hi, #{name}!"
+    end
+  end
+
+  test "a whole game, live on the big screen and the phones" do
+    open_big_screen
+    assert_selector ".qr svg[aria-label='QR code']"
+    join_as "Alice"
+    join_as "Bob"
+    assert_text "Players: 2"
+
+    click_button "Start"
+    assert_text "Question 1 of 2"
+    assert_text "Answers: 0 / 2"
+    %w[ Alice Bob ].each do |name|
+      phone(name) do
+        assert_text "Question 1 of 2"
+        assert_selector "button", text: "418"
+        assert_no_selector ".is-correct"
+      end
+    end
+
+    phone("Alice") do
+      click_button "429"
+      assert_selector "button.is-picked", text: "429"
+      within("button", text: "429") { assert_text "Your answer" }
+    end
+    assert_text "Answers: 1 / 2"
+
+    phone("Bob") do
+      click_button "418"
+      within("button", text: "418") { assert_text "Your answer" }
+      click_button "503"
+      within("button", text: "503") { assert_text "Your answer" }
+      assert_no_selector "button", text: /418.*Your answer/
+      assert_text "Saved!"
+    end
+    assert_text "Answers: 2 / 2"
+
+    click_button "Finish"
+    within(".stage-option", text: "429") { assert_text "Correct"; assert_selector ".stage-option__count", text: /\A1/ }
+    within(".stage-option", text: "503") { assert_no_text "Correct"; assert_selector ".stage-option__count", text: /\A1/ }
+    within(".stage-option", text: "418") { assert_selector ".stage-option__count", text: /\A0/ }
+    phone("Alice") { assert_text "Correct!" }
+    phone("Bob") { assert_text "Wrong!" }
+
+    click_button "Next"
+    assert_text "Question 2 of 2"
+    phone("Alice") { assert_text "Which protocol keeps a two-way connection?" }
+    click_button "Finish"
+    phone("Bob") { assert_text "No answer" }
+    assert_no_button "Next"
+
+    click_button "End quiz"
+    assert_text "The quiz is over"
+    phone("Alice") { assert_text "The quiz is over" }
+    phone("Bob") { assert_text "The quiz is over" }
+
+    phone("Carol") do # the join link after the end
+      visit "http://#{@join_link}"
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+    end
+  end
+
+  test "players come and go; the same browser is the same player" do
+    open_big_screen
+    join_as "Alice"
+    join_as "Bob"
+    assert_text "Players: 2"
+
+    phone("Bob") { visit "about:blank" }
+    assert_text "Players: 1"
+
+    phone("Bob") do
+      visit "http://#{@join_link}"
+      assert_text "Hi, Bob!"
+      assert_no_field "Your name"
+    end
+    assert_text "Players: 2"
+
+    click_button "Start"
+    assert_text "Answers: 0 / 2"
+    phone("Alice") { visit "about:blank" }
+    assert_text "Answers: 0 / 1"
+  end
+
+  test "joining mid-game, and changing the answer until Finish" do
+    open_big_screen
+    click_button "Start"
+    assert_text "Answers: 0 / 0"
+
+    phone("Alice") do
+      visit "http://#{@join_link}"
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Question 1 of 2" # straight into the open question
+      click_button "418"
+      within("button", text: "418") { assert_text "Your answer" }
+    end
+    assert_text "Answers: 1 / 1"
+    phone("Alice") do
+      click_button "429"
+      within("button", text: "429") { assert_text "Your answer" }
+      assert_text "Saved!"
+    end
+
+    click_button "Finish"
+    phone("Alice") { assert_text "Correct!" }
+    within(".stage-option", text: "429") { assert_selector ".stage-option__count", text: /\A1/ }
+  end
+
+  test "a name being typed survives the game moving on" do
+    open_big_screen
+    join_as "Alice"
+    phone("Dana") do
+      visit "http://#{@join_link}"
+      fill_in "Your name", with: "Dana"
+    end
+
+    click_button "Start"
+    phone("Alice") { assert_text "Question 1 of 2" } # the phones have heard about it
+    phone("Dana") do
+      sleep 1 # a live refresh would have arrived by now
+      assert_field "Your name", with: "Dana"
+      click_button "Join"
+      assert_text "Question 1 of 2"
+    end
+    assert_text "Answers: 0 / 2"
+  end
+
+  test "flaky Wi-Fi: a join and an answer tapped offline go through once back online" do
+    open_big_screen
+    click_button "Start"
+    phone("Eve") do
+      visit "http://#{@join_link}"
+      fill_in "Your name", with: "Eve"
+      offline!(true)
+      click_button "Join"
+      assert_text "No connection. Please try again."
+      offline!(false)
+      click_button "Join"
+      assert_text "Question 1 of 2"
+
+      offline!(true)
+      click_button "429"
+      within("button", text: "429") { assert_text "Your answer" }
+      assert_text "No connection. Trying again…"
+    end
+    assert_text "Answers: 0 / 1"
+
+    phone("Eve") { offline!(false) }
+    assert_text "Answers: 1 / 1"
+    phone("Eve") { assert_text "Saved!" }
+  end
+
+  test "scores, the leaderboard and the winners, live on the big screen and the phones" do
+    @quiz.update!(winners_count: 1)
+    open_big_screen
+    %w[ Alice Bob Carol ].each { join_as it }
+    assert_text "Players: 3"
+
+    click_button "Start"
+    phone("Alice") do
+      assert_text "Question 1 of 2"
+      assert_text "Playing as Alice" # the question came with the cable message, the name is filled in
+      click_button "429"
+      assert_text "Saved!"
+    end
+    phone("Bob") { click_button "429"; assert_text "Saved!" } # right, but slower than Alice
+    phone("Carol") { click_button "418"; assert_text "Saved!" }
+    click_button "Finish"
+    phone("Alice") { assert_text "Correct!"; assert_no_text "point" } # no points during the game
+
+    click_button "Next"
+    phone("Bob") { click_button "WebSocket"; assert_text "Saved!" }
+    phone("Alice") { click_button "WebSocket"; assert_text "Saved!" }
+    phone("Carol") { click_button "SMTP"; assert_text "Saved!" }
+    click_button "Finish"
+    click_button "End quiz"
+
+    assert_text "The quiz is over"
+    rows = all("ol.leaderboard > li", count: 3).map { it.text.squish }
+    assert_equal 2, rows.count { it.match?(/\A[12] (Alice|Bob) 2 points\z/) }
+    assert_equal "3 Carol 0 points", rows.last
+    first, second = rows.first(2).map { it[/Alice|Bob/] }
+
+    phone(first) { assert_text "Place 1 of 3"; assert_text "2 points"; assert_no_text "You won!" }
+    phone(second) { assert_text "Place 2 of 3"; assert_text "2 points" }
+    phone("Carol") { assert_text "Place 3 of 3"; assert_text "0 points" }
+
+    click_button "Top 1"
+    within("ol.leaderboard > li", text: first) { assert_text "Winner" }
+    within("ol.leaderboard > li", text: second) { assert_no_text "Winner" }
+    phone(first) { assert_text "You won!" }
+    phone(second) { assert_no_text "You won!" }
+
+    click_button "Reset winners"
+    assert_no_selector "ol.leaderboard > li", text: "Winner"
+    phone(first) { assert_no_text "You won!" }
+
+    winners = Array.new(8) do
+      click_button "Draw"
+      assert_selector "ol.leaderboard > li", text: "Winner", count: 1
+      find("ol.leaderboard > li", text: "Winner").text[/Alice|Bob/]
+    end
+    assert_empty winners - %w[ Alice Bob ], "Carol has no points"
+    phone(winners.last) { assert_text "You won!" }
+    phone("Carol") { assert_no_text "You won!" }
+  end
+
+  test "a tapped (focused) option never carries over to the next question" do
+    open_big_screen
+    join_as "Alice"
+    click_button "Start"
+    phone("Alice") do
+      click_button "429" # keeps the focus
+      assert_text "Saved!"
+    end
+
+    game = Game.last
+    game.finish_question!
+    game.next_question! # the phone may skip the closed question: straight to the next one
+    phone("Alice") do
+      assert_text "Question 2 of 2"
+      assert_equal %w[ WebSocket SMTP FTP ], all("button[name=option_id]").map { it.find(".play-option__title").text }
+      assert_no_text "Your answer"
+      assert_no_text "429"
+      click_button "WebSocket"
+      within("button", text: "WebSocket") { assert_text "Your answer" }
+      assert_text "Saved!"
+    end
+    assert_equal "WebSocket", game.players.sole.answers.find_by!(question: game.current_question).option.title
+  end
+
+  private
+    def offline!(offline)
+      page.driver.browser.network.emulate_network_conditions(offline: offline)
+    end
+end
