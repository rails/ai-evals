diff --git a/app/views/moderate/games/_screen.html.erb b/app/views/moderate/games/_screen.html.erb
new file mode 100644
index 0000000..0e2a8ae
--- /dev/null
+++ b/app/views/moderate/games/_screen.html.erb
@@ -0,0 +1,128 @@
+<%# The live part of the big screen: replaced in place when the game or its counters change (live_controller.js). %>
+<% game = screen.game %>
+<% quiz = screen.quiz %>
+<div class="live-state" data-live-version="<%= screen.version %>" data-game-version="<%= game.lock_version %>">
+  <section class="cover cover--blue<%= " cover--calm" if game.playing? %>">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+        <% if game.playing? %><span class="screen__title"><%= quiz.title %></span><% end %>
+      </div>
+
+      <div class="screen__body">
+        <% case screen.stage %>
+        <% when :lobby %>
+          <div class="lobby">
+            <div>
+              <h1 class="lobby__title"><%= quiz.title %></h1>
+              <div class="lobby__join">Join on your phone</div>
+              <div class="lobby__url"><%= join_link_text(game) %></div>
+              <div class="counter-pill" role="status">Players: <%= screen.players_count %></div>
+            </div>
+            <div class="qr"><%= qr_code_svg(join_url(game), label: "QR code") %></div>
+          </div>
+
+        <% when :question_open, :question_closed %>
+          <% closed = screen.stage == :question_closed %>
+          <%# A timed question keeps the head's height once closed (no jump when the countdown goes). %>
+          <div class="stage-question__head<%= " stage-question__head--timed" if game.question_ends_at? %>">
+            <div class="stage-question__num">Question <%= screen.question_number %> of <%= screen.questions_count %></div>
+            <% if screen.timer? %>
+              <%# The text is the time left and nothing else ("1:30"); countdown_controller.js ticks it down. %>
+              <%= tag.div screen.time_left_text, id: dom_id(game, :countdown),
+                    class: [ "countdown", ("is-ending" if screen.time_left_ms <= ScreenView::ENDING_MS) ],
+                    role: "timer", aria: { label: "Time left" },
+                    data: { controller: "countdown", countdown_remaining_value: screen.time_left_ms,
+                            countdown_ending_value: ScreenView::ENDING_MS } %>
+            <% end %>
+          </div>
+          <h1 class="stage-question__body"><%= screen.question.body %></h1>
+
+          <ol class="stage-options<%= " stage-options--results" if closed %>">
+            <% screen.options.each_with_index do |option, index| %>
+              <% if closed %>
+                <% count = screen.count_for(option) %>
+                <li class="stage-option<%= " is-correct" if option.correct? %>" style="--share: <%= screen.share_for(option) %>%">
+                  <span class="stage-option__bar" aria-hidden="true"></span>
+                  <span class="stage-option__letter" aria-hidden="true"><%= Option.letter_for(index) %></span>
+                  <span class="stage-option__title"><%= option.title %></span>
+                  <% if option.correct? %>
+                    <span class="stage-option__mark">Correct</span>
+                  <% end %>
+                  <span class="stage-option__count"><%= count %><span class="visually-hidden"> <%= count == 1 ? "answer" : "answers" %></span></span>
+                </li>
+              <% else %>
+                <li class="stage-option">
+                  <span class="stage-option__letter" aria-hidden="true"><%= Option.letter_for(index) %></span>
+                  <span class="stage-option__title"><%= option.title %></span>
+                </li>
+              <% end %>
+            <% end %>
+          </ol>
+
+          <% unless closed %>
+            <div class="counter-pill answers-counter" role="status">Answers: <%= screen.answered_count %> / <%= screen.in_game_count %></div>
+          <% end %>
+
+        <% when :between %>
+          <div class="stage-question__num">Question <%= screen.question_number %> of <%= screen.questions_count %></div>
+          <h1 class="stage-question__body">This question was deleted from the quiz.</h1>
+
+        <% when :over %>
+          <div class="leaderboard-layout">
+            <div>
+              <h1 class="leaderboard-layout__title">The quiz is over</h1>
+              <p class="screen__kicker">Thanks for playing! <%= pluralize(screen.total_players, "player") %> · <%= pluralize(screen.question_number, "question") %></p>
+            </div>
+
+            <%# One list item per player, in order: place, name, points; winners get the "Winner" mark. %>
+            <% if screen.leaderboard.any? %>
+              <ol class="leaderboard" aria-label="Leaderboard">
+                <% screen.leaderboard.each do |standing| %>
+                  <li class="leader<%= " is-winner" if standing.winner? %><%= " is-tied" if screen.tied?(standing) %>" id="<%= dom_id(standing.player, :standing) %>">
+                    <span class="leader__place"><%= standing.place %></span>
+                    <span class="leader__name">
+                      <span class="leader__player"><%= standing.player.name %></span>
+                      <% if standing.winner? %><span class="leader__badge">Winner</span><% end %>
+                    </span>
+                    <span class="leader__score"><%= pluralize(standing.points, "point") %></span>
+                  </li>
+                <% end %>
+              </ol>
+            <% else %>
+              <p class="screen__kicker">No players in this game.</p>
+            <% end %>
+          </div>
+        <% end %>
+      </div>
+    </div>
+  </section>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "Back to quiz", moderate_quiz_path(quiz) %>
+      <% if game.playing? %>
+        <%# For latecomers. Drawn by CSS from data-join-link (screen readers still get it), so the page text holds
+            nothing time-like: with a numeric host, "127.0.0.1:3000" contains "1:30", a countdown value. %>
+        <%= tag.span class: "screen-controls__join", data: { join_link: join_link_text(game) } %>
+      <% end %>
+    </div>
+
+    <div class="buttons">
+      <% version = { version: game.lock_version } %>
+      <% if game.lobby? %>
+        <%= button_to "Start", start_moderate_game_path(game), params: version, class: "btn btn--pink btn--lg" %>
+      <% elsif game.question_open? %>
+        <%= button_to "Finish", finish_moderate_game_path(game), params: version, class: "btn btn--pink btn--lg" %>
+      <% elsif game.question_closed? && screen.last_question? %>
+        <%= button_to "End quiz", end_game_moderate_game_path(game), params: version, class: "btn btn--pink btn--lg" %>
+      <% elsif game.question_closed? %>
+        <%= button_to "Next", next_question_moderate_game_path(game), params: version, class: "btn btn--pink btn--lg" %>
+      <% elsif game.over? %>
+        <%= button_to "Top #{screen.winners_count}", top_winners_moderate_game_path(game), class: "btn btn--pink btn--lg" %>
+        <%= button_to "Draw", draw_winners_moderate_game_path(game), class: "btn btn--light btn--lg" %>
+        <%= button_to "Reset winners", reset_winners_moderate_game_path(game), class: "btn btn--light btn--lg" %>
+      <% end %>
+    </div>
+  </div>
+</div>
