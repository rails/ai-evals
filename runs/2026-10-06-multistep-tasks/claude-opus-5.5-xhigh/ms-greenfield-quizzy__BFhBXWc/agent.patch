+++ b/app/models/quiz.rb
@@ -0,0 +1,40 @@
+class Quiz < ApplicationRecord
+  # "Number of winners": how many prizes a game of this quiz gives away.
+  WINNERS_DEFAULT = 3
+  WINNERS_MAX = 1000
+
+  # "Timer minutes" / "Timer seconds": how long each question stays open in a
+  # game. 0 and 0 = no timer (the moderator clicks "Finish").
+  TIMER_MINUTES_MAX = 99
+  TIMER_SECONDS_MAX = 59
+
+  has_many :questions, -> { order(:position, :id) }, dependent: :destroy, inverse_of: :quiz
+  has_many :games, dependent: :delete_all # players and answers go with them (foreign keys cascade)
+
+  attribute :winners_count, :integer, default: WINNERS_DEFAULT
+  attribute :timer_minutes, :integer, default: 0
+  attribute :timer_seconds, :integer, default: 0
+
+  normalizes :title, with: ->(title) { title.squish }
+
+  validates :title, presence: true, length: { maximum: 200 }
+  validates :winners_count, presence: true,
+    numericality: { only_integer: true, greater_than_or_equal_to: 1, less_than_or_equal_to: WINNERS_MAX, allow_nil: true }
+  validates :timer_minutes, numericality: { only_integer: true, greater_than_or_equal_to: 0, less_than_or_equal_to: TIMER_MINUTES_MAX }
+  validates :timer_seconds, numericality: { only_integer: true, greater_than_or_equal_to: 0, less_than_or_equal_to: TIMER_SECONDS_MAX }
+
+  scope :ordered, -> { order(created_at: :desc, id: :desc) }
+
+  # An emptied timer field means 0 (no time on that unit), not an error.
+  def timer_minutes=(value)
+    super(value.presence || 0)
+  end
+
+  def timer_seconds=(value)
+    super(value.presence || 0)
+  end
+
+  # The time per question, in seconds (0 = no timer).
+  def timer_duration = timer_minutes.to_i * 60 + timer_seconds.to_i
+  def timer? = timer_duration.positive?
+end
diff --git a/app/models/quiz_export.rb b/app/models/quiz_export.rb
new file mode 100644
index 0000000..a99c60f
--- /dev/null
+++ b/app/models/quiz_export.rb
@@ -0,0 +1,33 @@
+# A quiz's contents as portable JSON, for moving a quiz to another conference or
+# another Quizzy (QuizImport reads it back):
+#
+#   { "title": "…", "questions": [ { "text": "…", "active": true,
+#       "options": [ { "text": "…", "correct": false }, … ] }, … ] }
+#
+# Questions and options keep their order. Only contents are written: no ids,
+# positions or timestamps, so an export never ties the copy to this database.
+class QuizExport
+  attr_reader :quiz
+
+  def initialize(quiz)
+    @quiz = quiz
+  end
+
+  def as_json(*)
+    {
+      "title" => quiz.title,
+      "questions" => quiz.questions.includes(:options).map do |question|
+        {
+          "text" => question.body,
+          "active" => question.active?,
+          "options" => question.options.map { |option| { "text" => option.title, "correct" => option.correct? } }
+        }
+      end
+    }
+  end
+
+  # Indented and unescaped (beyond what JSON requires), for people to read and copy.
+  def to_json(*)
+    JSON.pretty_generate(as_json)
+  end
+end
diff --git a/app/models/quiz_import.rb b/app/models/quiz_import.rb
new file mode 100644
index 0000000..47669e3
--- /dev/null
+++ b/app/models/quiz_import.rb
@@ -0,0 +1,140 @@
+# Creates a new quiz from the JSON written by QuizExport (format documented
+# there and in docs/architecture.md).
+#
+# The JSON's shape is checked first (types, required keys), then the quiz and
+# its questions are built in memory and checked with the same model rules as
+# the quiz and question forms: questions get their options through
+# Question#option_rows=, exactly like the form, so empty options are skipped
+# and a question needs two options and a correct one. Every problem is
+# reported, with where it is ("Question 2, option 3: ..."). Only when nothing
+# is wrong is the quiz saved, in one transaction: a failed import never leaves
+# a quiz or some of its questions behind.
+#
+# Optional keys: a question's "active" (true by default) and an option's
+# "correct" (false by default); null counts as not given. Unknown keys are
+# ignored. Importing always creates a new quiz, whatever its title.
+class QuizImport
+  include ActiveModel::Model
+  include ActiveModel::Attributes
+
+  attribute :json, :string
+
+  # The created quiz, after a successful #save.
+  attr_reader :quiz
+
+  def save
+    @quiz = nil
+    errors.clear
+
+    data = parse
+    return false if errors.any?
+
+    quiz = build_quiz(data)
+    return false if errors.any?
+
+    Quiz.transaction { quiz.save! }
+    @quiz = quiz
+    true
+  rescue ActiveRecord::RecordInvalid => invalid
+    errors.add(:base, invalid.record.errors.full_messages.to_sentence)
+    false
+  end
+
+  private
+    def parse
+      text = json.to_s.delete_prefix("\uFEFF")
+      return problem("Paste the JSON of a quiz first") if text.strip.empty?
+
+      JSON.parse(text)
+    rescue JSON::ParserError => error
+      problem("This isn't valid JSON: #{error.message.truncate(200)}")
+    end
+
+    def build_quiz(data)
+      return problem(%(The JSON must be an object with "title" and "questions")) unless data.is_a?(Hash)
+
+      title = string(data, "title")
+      quiz = Quiz.new(title: title)
+      quiz.errors.full_messages.each { |message| problem(message) } if title && quiz.invalid?
+
+      list(data, "questions").each.with_index(1) { |item, number| build_question(quiz, item, number) }
+      quiz
+    end
+
+    def build_question(quiz, data, number)
+      where = "Question #{number}"
+      return problem("#{where} must be an object") unless data.is_a?(Hash)
+
+      problems_before = errors.size
+      question = quiz.questions.build(position: number,
+        body: string(data, "text", where), active: boolean(data, "active", where, default: true))
+
+      rows = {} # option number in the JSON => form row
+      list(data, "options", where).each.with_index(1) do |option, option_number|
+        row = option_row(option, "#{where}, option #{option_number}")
+        rows[option_number] = row if row
+      end
+      question.option_rows = rows.values
+
+      # The model rules only make sense once the shape is right (a text that
+      # isn't a string shouldn't also be reported as blank).
+      if errors.size == problems_before
+        check_question(question, where, option_numbers: rows.reject { |_, row| row.blank? }.keys)
+      end
+    end
+
+    def option_row(data, where)
+      return problem("#{where} must be an object") unless data.is_a?(Hash)
+
+      Question::OptionRow.new(id: nil, title: string(data, "text", where).to_s,
+        correct: boolean(data, "correct", where, default: false))
+    end
+
+    # The question form's rules. Option errors are reported per option, with its
+    # number in the JSON (`option_numbers` lists those of the kept options, in
+    # order), instead of the question's generic "Options title is too long".
+    def check_question(question, where, option_numbers:)
+      question.validate
+      question.errors.each do |error|
+        problem("#{where}: #{error.full_message}") unless error.attribute.to_s.start_with?("options")
+      end
+
+      question.kept_options.zip(option_numbers).each do |option, option_number|
+        next if option.valid?
+
+        option.errors.full_messages.each { |message| problem("#{where}, option #{option_number}: #{message}") }
+      end
+    end
+
+    def string(data, key, where = nil)
+      case value = data[key]
+      when String then value
+      when nil then problem(located(where, %("#{key}" is missing)))
+      else problem(located(where, %("#{key}" must be a string)))
+      end
+    end
+
+    def boolean(data, key, where, default:)
+      case value = data[key]
+      when true, false then value
+      when nil then default
+      else problem(located(where, %("#{key}" must be true or false))) || default
+      end
+    end
+
+    def list(data, key, where = nil)
+      case value = data[key]
+      when Array then value
+      when nil then problem(located(where, %("#{key}" is missing))) || []
+      else problem(located(where, %("#{key}" must be a list))) || []
+      end
+    end
+
+    def located(where, message) = [ where, message ].compact.join(": ")
+
+    # Records a problem; returns nil so callers can `return problem(...)`.
+    def problem(message)
+      errors.add(:base, message)
+      nil
+    end
+end
diff --git a/app/models/quiz_preview.rb b/app/models/quiz_preview.rb
new file mode 100644
index 0000000..e7f2597
--- /dev/null
+++ b/app/models/quiz_preview.rb
@@ -0,0 +1,60 @@
+# One step of a quiz preview: which active question is shown, the score so far,
+# and the option the moderator picked (if any).
+#
+# The state lives in the URL (question number, score before this question,
+# picked option id), so nothing about the preview is ever stored. Values from
+# the URL are clamped to what makes sense for the quiz.
+class QuizPreview
+  attr_reader :questions, :number, :score
+
+  def initialize(questions, question: nil, score: nil, answer: nil, finished: nil)
+    @questions = questions
+    @finished = finished.present? && total.positive?
+    @number = to_int(question, default: 1).clamp(1, [ total, 1 ].max)
+    @score = to_int(score, default: 0).clamp(0, finished? ? total : number - 1)
+    @answer_id = to_int(answer, default: nil) unless finished?
+  end
+
+  def total = questions.size
+  def empty? = questions.empty?
+  def finished? = @finished
+
+  def question
+    questions[number - 1] unless finished?
+  end
+
+  def options
+    question&.options.to_a
+  end
+
+  def picked
+    return @picked if defined?(@picked)
+
+    @picked = options.find { |option| option.id == @answer_id }
+  end
+
+  def answered? = picked.present?
+  def correct? = answered? && picked.correct?
+  def last? = number == total
+
+  def score_after
+    score + (correct? ? 1 : 0)
+  end
+
+  # Params for the step after the current, answered question.
+  def next_params
+    last? ? { finished: 1, score: score_after } : { question: number + 1, score: score_after }
+  end
+
+  # Params for answering the current question (the picked option is added by the button).
+  def answer_params
+    { question: number, score: score }
+  end
+
+  private
+    def to_int(value, default:)
+      Integer(value.to_s, 10)
+    rescue ArgumentError
+      default
+    end
+end
diff --git a/app/models/screen_view.rb b/app/models/screen_view.rb
new file mode 100644
index 0000000..7c459c4
--- /dev/null
+++ b/app/models/screen_view.rb
@@ -0,0 +1,98 @@
+# What a game's big screen shows right now (app/views/moderate/games/_screen.html.erb):
+# the lobby with the join link and "Players: 2", the open question with
+# "Answers: 1 / 2", the closed question with answers per option, the end.
+#
+# `version` changes whenever the rendered view would (state, counters), so live
+# updates and polls (ETag) leave unchanged screens alone.
+class ScreenView
+  # The countdown's last seconds stand out (pink).
+  ENDING_MS = 10_000
+
+  attr_reader :game
+
+  delegate :quiz, :question_number, :questions_count, to: :game
+
+  def initialize(game)
+    @game = game
+  end
+
+  # :lobby, :question_open, :question_closed, :between (the current question
+  # was deleted mid-game) or :over.
+  def stage
+    @stage ||=
+      if game.lobby? then :lobby
+      elsif game.over? then :over
+      elsif question.nil? then :between
+      elsif game.question_open? then :question_open
+      else :question_closed
+      end
+  end
+
+  def question = game.current_question
+  def options = question&.options.to_a
+
+  # Lobby: players currently waiting for the start.
+  def players_count = @players_count ||= game.players.online.count
+
+  # Open question with a timer: the countdown. The deadline is the game's, so
+  # a reload shows the time that is really left (countdown_controller.js ticks
+  # it down from here). Not part of `version`: the time left changes every
+  # moment, the deadline only with the game (lock_version).
+  def timer? = stage == :question_open && game.timed?
+
+  # Milliseconds left when this view is rendered (rounded up, never negative).
+  def time_left_ms
+    @time_left_ms ||= (game.time_left * 1000).ceil if timer?
+  end
+
+  # "1:30", "0:05" (whole seconds, rounded up: "0:00" only once time is up).
+  def time_left_text
+    self.class.countdown_text((time_left_ms / 1000.0).ceil) if timer?
+  end
+
+  def self.countdown_text(seconds) = format("%d:%02d", seconds / 60, seconds % 60)
+
+  # Open question: "Answers: answered / in game".
+  def answered_count = @answered_count ||= game.answered_count
+  def in_game_count = @in_game_count ||= game.players_in_game_count
+
+  # Closed question: answers per option, and their share of all answers (for the bars).
+  def count_for(option) = answer_counts.fetch(option.id, 0)
+
+  def share_for(option)
+    total = answer_counts.values.sum
+    total.zero? ? 0 : (100.0 * count_for(option) / total).round
+  end
+
+  # "End quiz" instead of "Next".
+  def last_question? = @last_question.nil? ? (@last_question = game.last_question?) : @last_question
+
+  # The end: everyone who joined, questions played.
+  def total_players = leaderboard.size
+
+  # The end: every player in order, with place, points and the winners.
+  def leaderboard = game.leaderboard
+
+  # "Top 3": the quiz's number of winners.
+  def winners_count = game.winners_count
+
+  # Players a "Draw" picks among (equal points across the last prize's place).
+  def tied?(standing) = tied_ids.include?(standing.player.id)
+
+  def version
+    parts = [ game.id, game.lock_version, quiz.updated_at.to_f, stage ]
+    case stage
+    when :lobby then parts << players_count
+    when :question_open then parts.push(answered_count, in_game_count, last_question?)
+    when :question_closed, :between then parts << last_question?
+    when :over
+      parts << winners_count
+      leaderboard.each { |standing| parts.push(standing.player.id, standing.player.name, standing.points, standing.winner?) }
+    end
+    Digest::SHA256.hexdigest(parts.join("\u001f"))[0, 20]
+  end
+
+  private
+    def answer_counts = @answer_counts ||= game.answer_counts
+    def tied_ids = @tied_ids ||= leaderboard.tied_ids(winners_count).to_set
+end
