diff --git a/app/views/moderate/previews/show.html.erb b/app/views/moderate/previews/show.html.erb
new file mode 100644
index 0000000..772725e
--- /dev/null
+++ b/app/views/moderate/previews/show.html.erb
@@ -0,0 +1,71 @@
+<% content_for :title, "Preview · #{@quiz.title}" %>
+<% preview = @preview %>
+
+<div class="play__body play__body--top">
+  <% if preview.empty? %>
+    <div class="waiting">
+      <div class="waiting__gem" aria-hidden="true">?</div>
+      <h1 class="play-title">Nothing to play yet</h1>
+      <p class="play-lead">This quiz has no active questions. Add a question or switch one on, then preview again.</p>
+    </div>
+
+  <% elsif preview.finished? %>
+    <div class="card result-card">
+      <div class="result-card__label">That’s the whole quiz!</div>
+      <div class="result-card__score">Score: <%= preview.score %>/<%= preview.total %></div>
+      <p class="play-lead"><%= preview.score %> of <%= pluralize(preview.total, "answer") %> correct.</p>
+    </div>
+    <div class="play-actions">
+      <%= button_to "Start over", moderate_quiz_preview_path(@quiz), method: :get, class: "btn btn--pink" %>
+    </div>
+
+  <% else %>
+    <div class="play-question__num">Question <%= preview.number %> of <%= preview.total %></div>
+    <div class="play-question__body"><%= preview.question.body %></div>
+
+    <% if preview.answered? %>
+      <div class="play-options is-locked is-revealed">
+        <% preview.options.each_with_index do |option, index| %>
+          <% picked = option == preview.picked %>
+          <button type="button" disabled
+                  class="play-option<%= " is-picked" if picked %><%= " is-correct" if option.correct? %>">
+            <span class="play-option__letter" aria-hidden="true"><%= Option.letter_for(index) %></span>
+            <span class="play-option__title"><%= option.title %></span>
+            <% if option.correct? %>
+              <span class="play-option__mark"><%= picked ? "✓ Your answer" : "✓ Correct answer" %></span>
+            <% elsif picked %>
+              <span class="play-option__mark">✗ Your answer</span>
+            <% end %>
+          </button>
+        <% end %>
+      </div>
+
+      <div class="play-status <%= preview.correct? ? "play-status--right" : "play-status--wrong" %>" role="status">
+        <%= preview.correct? ? "Correct!" : "Wrong!" %>
+      </div>
+
+      <div class="play-actions">
+        <%= button_to preview.last? ? "See score" : "Next question", moderate_quiz_preview_path(@quiz),
+              method: :get, params: preview.next_params, class: "btn btn--pink" %>
+      </div>
+    <% else %>
+      <%= form_with url: moderate_quiz_preview_path(@quiz), method: :get, class: "play-options" do %>
+        <% preview.answer_params.each do |name, value| %>
+          <input type="hidden" name="<%= name %>" value="<%= value %>">
+        <% end %>
+        <% preview.options.each_with_index do |option, index| %>
+          <button type="submit" name="answer" value="<%= option.id %>" class="play-option">
+            <span class="play-option__letter" aria-hidden="true"><%= Option.letter_for(index) %></span>
+            <span class="play-option__title"><%= option.title %></span>
+          </button>
+        <% end %>
+      <% end %>
+      <div class="play-status play-status--neutral">Pick an answer</div>
+    <% end %>
+
+    <div class="play-score">
+      <span>Score so far: <%= preview.answered? ? preview.score_after : preview.score %></span>
+      <span><%= pluralize(preview.total - preview.number + (preview.answered? ? 0 : 1), "question") %> left</span>
+    </div>
+  <% end %>
+</div>
