new file mode 100644
index 0000000..489c064
--- /dev/null
+++ b/app/javascript/controllers/autosave_controller.js
@@ -0,0 +1,37 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+
+// Saves a small form as soon as one of its inputs changes (the "Active"
+// switch on question cards), then applies the Turbo Stream response.
+//
+// Uses fetch with keepalive instead of a Turbo form submission, so the save
+// still completes when the moderator navigates away right after the change.
+export default class extends Controller {
+  async save() {
+    const form = this.element
+    form.setAttribute("aria-busy", "true")
+
+    try {
+      const response = await fetch(form.action, {
+        method: "POST", // Rails reads the real method from the form's _method field
+        body: new FormData(form),
+        credentials: "same-origin",
+        keepalive: true,
+        headers: {
+          "Accept": "text/vnd.turbo-stream.html, text/html",
+          "X-CSRF-Token": document.querySelector("meta[name=csrf-token]")?.content ?? ""
+        }
+      })
+
+      if (response.ok && response.headers.get("Content-Type")?.startsWith("text/vnd.turbo-stream.html")) {
+        Turbo.renderStreamMessage(await response.text())
+      } else {
+        Turbo.visit(window.location.href, { action: "replace" })
+      }
+    } catch (error) {
+      if (form.isConnected) Turbo.visit(window.location.href, { action: "replace" })
+    } finally {
+      form.removeAttribute("aria-busy")
+    }
+  }
+}
diff --git a/app/javascript/controllers/clipboard_controller.js b/app/javascript/controllers/clipboard_controller.js
new file mode 100644
index 0000000..f582928
--- /dev/null
+++ b/app/javascript/controllers/clipboard_controller.js
@@ -0,0 +1,66 @@
+import { Controller } from "@hotwired/stimulus"
+
+// The "Copy" button of the export page: copies the text of the source element.
+//
+// navigator.clipboard only exists in secure contexts (HTTPS or localhost) and
+// Quizzy is often served over plain HTTP, so this falls back to selecting the
+// text and execCommand("copy"). If that fails too, the text stays selected for
+// Ctrl+C. The button is hidden until this controller connects (no JS, no button).
+export default class extends Controller {
+  static targets = [ "source", "button", "status" ]
+
+  connect() {
+    this.buttonTarget.hidden = false
+  }
+
+  disconnect() {
+    clearTimeout(this.statusTimer)
+  }
+
+  async copy() {
+    const text = this.sourceTarget.textContent
+
+    if (await this.writeToClipboard(text) || this.copySelection()) {
+      this.showStatus("Copied")
+    } else {
+      this.selectSource()
+      this.showStatus("Selected: press Ctrl+C (⌘C on a Mac) to copy")
+    }
+  }
+
+  async writeToClipboard(text) {
+    if (!window.isSecureContext || !navigator.clipboard) return false
+
+    try {
+      await navigator.clipboard.writeText(text)
+      return true
+    } catch {
+      return false
+    }
+  }
+
+  copySelection() {
+    this.selectSource()
+    try {
+      return document.execCommand("copy")
+    } catch {
+      return false
+    } finally {
+      window.getSelection().removeAllRanges()
+    }
+  }
+
+  selectSource() {
+    const range = document.createRange()
+    range.selectNodeContents(this.sourceTarget)
+    const selection = window.getSelection()
+    selection.removeAllRanges()
+    selection.addRange(range)
+  }
+
+  showStatus(message) {
+    this.statusTarget.textContent = message
+    clearTimeout(this.statusTimer)
+    this.statusTimer = setTimeout(() => { this.statusTarget.textContent = "" }, 4000)
+  }
+}
diff --git a/app/javascript/controllers/countdown_controller.js b/app/javascript/controllers/countdown_controller.js
new file mode 100644
index 0000000..6158050
--- /dev/null
+++ b/app/javascript/controllers/countdown_controller.js
@@ -0,0 +1,80 @@
+import { Controller } from "@hotwired/stimulus"
+
+// The countdown of a timed question on the big screen: "1:30" … "0:05" … "0:00".
+//
+// - The server renders the time left (`remaining`, in ms) into the page or the
+//   live fragment, computed from the game's stored deadline: a reload shows the
+//   time that is really left, it never restarts the countdown.
+// - From there it runs on the browser's monotonic clock (performance.now), so a
+//   big screen whose clock is off still counts correctly. The local deadline is
+//   only set when `remaining` changes (a fresh render resyncs it), never on
+//   (re)connect: an element moved around by a morph keeps counting down.
+// - Whole seconds are rounded up, so "0:00" shows exactly when time is up. The
+//   question then finishes on the server (as if "Finish" was clicked); this
+//   dispatches "countdown:expired" so the screen fetches its new state at once
+//   (live_controller.js), and asks again (backing off) until the screen has
+//   moved on: the countdown goes with the open question.
+// - The element's text is the time and nothing else (role="timer" is not a live
+//   region: screen readers aren't interrupted every second).
+//
+// Values: remaining (ms left when rendered), ending (ms: the last seconds get
+// the `is-ending` class).
+export default class extends Controller {
+  static values = {
+    remaining: Number,
+    ending: { type: Number, default: 10000 }
+  }
+
+  static RETRY = 1000
+  static MAX_RETRY = 8000
+
+  connect() {
+    this.running = true
+    if (this.endsAt === undefined) this.resync()
+    this.tick()
+  }
+
+  disconnect() {
+    this.running = false
+    clearTimeout(this.timer)
+  }
+
+  // Also called once before connect, with the rendered value.
+  remainingValueChanged() {
+    this.resync()
+    if (this.running) this.tick()
+  }
+
+  resync() {
+    this.endsAt = performance.now() + Math.max(0, this.remainingValue)
+    this.retry = this.constructor.RETRY
+  }
+
+  tick() {
+    clearTimeout(this.timer)
+    const left = Math.max(0, this.endsAt - performance.now())
+    this.show(left)
+
+    if (left > 0) {
+      // Wake up just after the shown second runs out.
+      this.timer = setTimeout(() => this.tick(), (left % 1000 || 1000) + 5)
+    } else {
+      this.expired()
+    }
+  }
+
+  show(left) {
+    const seconds = Math.ceil(left / 1000)
+    const text = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`
+    if (this.element.textContent !== text) this.element.textContent = text
+    this.element.classList.toggle("is-ending", left <= this.endingValue)
+  }
+
+  expired() {
+    if (!this.running) return
+
+    this.dispatch("expired")
+    this.timer = setTimeout(() => this.expired(), this.retry)
+    this.retry = Math.min(this.retry * 2, this.constructor.MAX_RETRY)
+  }
+}
