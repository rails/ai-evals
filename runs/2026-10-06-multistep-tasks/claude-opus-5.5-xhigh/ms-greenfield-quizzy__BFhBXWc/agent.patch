--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,411 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+
+  setup do
+    @quiz = create_sample_quiz # 2 active questions, then an inactive one
+    @first, @second, @inactive = @quiz.questions.to_a
+    @game = Game.start_for!(@quiz)
+    @alice = join_game(@game, "Alice")
+    @bob = join_game(@game, "Bob")
+  end
+
+  test "a new game waits in the lobby with a unique, unambiguous join code" do
+    assert @game.lobby?
+    assert_match(/\A[A-HJKMNP-Z2-9]{5}\z/, @game.code)
+    assert_equal @game, Game.find_by(code: @game.code.downcase)
+
+    codes = Array.new(20) { Game.start_for!(@quiz).code }
+    assert_equal codes.uniq, codes
+  end
+
+  test "a taken code is never reused" do
+    game = Game.create!(quiz: @quiz, code: @game.code)
+    assert_not_equal @game.code, game.code
+    assert_match(/\A[A-HJKMNP-Z2-9]{5}\z/, game.code)
+  end
+
+  test "playing through the active questions" do
+    assert_equal 2, @game.questions_count
+
+    assert @game.start!
+    assert @game.question_open?
+    assert_equal @first, @game.current_question
+    assert_equal [ 1, 2 ], [ @game.question_number, @game.questions_count ]
+    assert_not @game.last_question?
+
+    assert @game.finish_question!
+    assert @game.question_closed?
+
+    assert @game.next_question!
+    assert_equal @second, @game.current_question
+    assert_equal [ 2, 2 ], [ @game.question_number, @game.questions_count ]
+    assert @game.last_question?
+
+    @game.finish_question!
+    assert @game.end!
+    assert @game.over?
+    assert_nil @game.current_question
+    assert_not_nil @game.ended_at
+  end
+
+  test "state changes only happen from the right state" do
+    assert_not @game.finish_question!
+    assert_not @game.next_question!
+
+    @game.start!
+    assert_not @game.start!
+    assert_not @game.next_question!, "Next only after Finish"
+
+    @game.finish_question!
+    assert_not @game.finish_question!
+    @game.end!
+    assert_not @game.end!
+    assert_not @game.start!
+  end
+
+  test "a quiz without active questions can't start" do
+    @quiz.questions.update_all(active: false)
+    assert_not @game.start!
+    assert @game.reload.lobby?
+  end
+
+  test "Next after the last question ends the game" do
+    @game.start!
+    @game.finish_question!
+    @game.next_question!
+    @game.finish_question!
+    assert @game.next_question!
+    assert @game.over?
+  end
+
+  test "questions switched off or deleted mid-game are skipped, switched on ones are added" do
+    third = create_question(@quiz, "Third?", %w[ yes no ])
+    @game.start!
+    assert_equal 3, @game.questions_count
+
+    @second.update!(active: false)
+    assert_equal 2, @game.questions_count
+    @game.finish_question!
+    @game.next_question!
+    assert_equal third, @game.current_question
+
+    @inactive.update!(active: true)
+    @game.finish_question!
+    assert_not @game.last_question?
+    @game.next_question!
+    assert_equal @inactive, @game.current_question
+    assert_equal [ 3, 3 ], [ @game.question_number, @game.questions_count ]
+  end
+
+  test "moving a played question down never shows it twice" do
+    @game.start!
+    @first.move_down!
+    @game.finish_question!
+    @game.next_question!
+    assert_equal @second, @game.current_question
+    assert @game.last_question?
+  end
+
+  test "reload forgets the current question" do
+    @game.start!
+    assert_equal @first, @game.current_question
+
+    other = Game.find(@game.id)
+    other.finish_question!
+    other.next_question!
+    assert_equal @second, @game.reload.current_question
+  end
+
+  test "the current question deleted mid-game" do
+    @game.start!
+    @first.destroy!
+    @game.reload
+
+    assert_nil @game.current_question
+    assert_equal 1, @game.question_number
+    @game.finish_question!
+    @game.next_question!
+    assert_equal @second, @game.current_question
+  end
+
+  test "a stale version doesn't change the game (double click, retried request)" do
+    rendered_version = @game.lock_version # the lobby screen, with its "Start" button
+    @game.start!
+
+    # A second "Start"/"Finish" sent from that screen: the game is loaded fresh, the version is old.
+    game = Game.find(@game.id)
+    game.lock_version = rendered_version
+    assert_raises(ActiveRecord::StaleObjectError) { game.finish_question! }
+    assert @game.reload.question_open?
+  end
+
+  test "the last pick counts" do
+    @game.start!
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "418").id)
+    answer = @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "429").id)
+
+    assert_equal option_of(@first, "429"), answer.option
+    assert_equal 1, @alice.answers.count
+    assert_equal({ option_of(@first, "429").id => 1 }, @game.answer_counts)
+  end
+
+  test "answers are refused unless the question is open" do
+    option = option_of(@first, "429")
+    assert_nil @game.answer!(@alice, question_id: @first.id, option_id: option.id), "lobby"
+
+    @game.start!
+    @game.finish_question!
+    assert_nil @game.answer!(@alice, question_id: @first.id, option_id: option.id), "closed"
+
+    @game.next_question!
+    assert_nil @game.answer!(@alice, question_id: @first.id, option_id: option.id), "an earlier question"
+    assert_nil @game.answer!(@alice, question_id: @second.id, option_id: option.id), "an option of another question"
+    assert_nil @game.answer!(@alice, question_id: @second.id, option_id: 0), "no such option"
+    assert_equal 0, Answer.count
+  end
+
+  test "an answer checks the state saved in the database, not a stale copy" do
+    stale = Game.find(@game.id)
+    @game.start!
+    Game.find(@game.id).finish_question!
+
+    stale.reload.status = "question_open" # as loaded before Finish
+    assert_nil stale.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "429").id)
+  end
+
+  test "answers of one game don't count in another" do
+    other = Game.start_for!(@quiz)
+    carol = join_game(other, "Carol")
+    [ @game, other ].each(&:start!)
+    other.answer!(carol, question_id: @first.id, option_id: option_of(@first, "429").id)
+
+    assert_equal 0, @game.answered_count
+    assert_equal 1, other.answered_count
+  end
+
+  test "counters: answered / players in the game now" do
+    @game.start!
+    assert_equal [ 0, 2 ], [ @game.answered_count, @game.players_in_game_count ]
+
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "429").id)
+    assert_equal [ 1, 2 ], [ @game.answered_count, @game.players_in_game_count ]
+
+    @bob.update!(last_seen_at: 1.minute.ago) # Bob's phone dropped off
+    assert_equal [ 1, 1 ], [ @game.answered_count, @game.players_in_game_count ]
+
+    @alice.update!(last_seen_at: nil) # Alice closed the page after answering: her answer still counts
+    assert_equal [ 1, 1 ], [ @game.answered_count, @game.players_in_game_count ]
+  end
+
+  test "state changes signal phones and screens after commit" do
+    assert_broadcasts(PlayerChannel.broadcasting_for(@game), 1) do
+      assert_broadcasts(ScreenChannel.broadcasting_for(@game), 1) { @game.start! }
+    end
+
+    stream = PlayerChannel.broadcasting_for(@game)
+    Game.transaction do
+      @game.finish_question!
+      assert_equal 1, broadcasts(stream).size, "nothing before the commit: phones would fetch the old state"
+    end
+    assert_equal 2, broadcasts(stream).size
+  end
+
+  test "an answer's time runs from the question opening to the last pick; the same pick again keeps it" do
+    freeze_time
+    @game.start!
+    assert_equal Time.current, @game.question_opened_at
+    opened_at = @game.question_opened_at
+
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "418").id, at: opened_at + 1.5)
+    assert_equal 1_500, @alice.answers.sole.time_ms
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "418").id, at: opened_at + 4) # retried request
+    assert_equal 1_500, @alice.answers.sole.time_ms
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "429").id, at: opened_at + 6.25)
+    assert_equal 6_250, @alice.answers.sole.time_ms
+
+    @game.answer!(@bob, question_id: @first.id, option_id: option_of(@first, "429").id, at: opened_at - 1) # clocks: never negative
+    assert_equal 0, @bob.answers.sole.time_ms
+
+    @game.finish_question!
+    travel 1.minute
+    @game.next_question!
+    assert_equal Time.current, @game.question_opened_at, "each question has its own start"
+    @game.answer!(@bob, question_id: @second.id, option_id: option_of(@second, "WebSocket").id) # now
+    assert_equal 0, @bob.answers.find_by(question: @second).time_ms
+  end
+
+  # ---------- Timer ----------
+
+  test "without a timer a question has no deadline and stays open" do
+    @game.start!
+    assert_nil @game.question_ends_at
+    assert_not @game.timed?
+    assert_nil @game.time_left
+    travel 1.hour
+    assert_not @game.time_up?
+    assert_not @game.finish_if_time_is_up!
+    assert @game.reload.question_open?
+  end
+
+  test "a timed question gets its deadline when it opens; reloads don't restart it" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    freeze_time
+    @game.start!
+    assert @game.timed?
+    assert_equal @game.question_opened_at + 90.seconds, @game.question_ends_at
+    assert_equal 90, @game.time_left
+
+    travel 30.seconds
+    assert_equal 60, Game.find(@game.id).time_left, "the deadline is stored"
+    assert_not @game.time_up?
+    assert_not @game.finish_if_time_is_up!
+    assert @game.reload.question_open?
+  end
+
+  test "at 0:00 the question finishes by itself, like Finish" do
+    @quiz.update!(timer_seconds: 5)
+    freeze_time
+    @game.start!
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "429").id)
+
+    travel 4.9.seconds, with_usec: true
+    assert_not @game.finish_if_time_is_up!
+    travel 0.1.seconds, with_usec: true
+    assert @game.time_up?
+    assert_equal 0, @game.time_left
+    assert_broadcasts(PlayerChannel.broadcasting_for(@game), 1) do
+      assert @game.finish_if_time_is_up!
+    end
+    assert @game.reload.question_closed?
+    assert_equal({ option_of(@first, "429").id => 1 }, @game.answer_counts, "answers given in time count")
+    assert_not @game.timed?
+    assert_not @game.finish_if_time_is_up!, "only once"
+
+    @game.next_question!
+    assert_equal @second, @game.current_question
+    assert_equal 5, @game.time_left.round, "the next question gets its own time"
+  end
+
+  test "answers arriving after 0:00 are refused, even before the question is marked finished" do
+    @quiz.update!(timer_seconds: 10)
+    @game.start!
+    opened_at = @game.question_opened_at
+
+    assert @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "429").id, at: opened_at + 9.9.seconds)
+    assert_nil @game.answer!(@bob, question_id: @first.id, option_id: option_of(@first, "429").id, at: opened_at + 10.seconds)
+    assert_nil @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "418").id, at: opened_at + 11.seconds)
+    assert_equal "429", @alice.answers.sole.option.title, "a change of mind after 0:00 doesn't count"
+    assert @game.reload.question_open?
+  end
+
+  test "the timer is read when a question opens: changing it mid-question doesn't move the deadline" do
+    @quiz.update!(timer_seconds: 20)
+    @game.start!
+    ends_at = @game.question_ends_at
+
+    @quiz.update!(timer_seconds: 0)
+    assert_equal ends_at, Game.find(@game.id).question_ends_at
+
+    game = Game.find(@game.id)
+    game.finish_question!
+    game.next_question!
+    assert_not game.timed?, "the next question has no timer anymore"
+  end
+
+  test "Finish before 0:00, and the timer racing the moderator's Finish" do
+    @quiz.update!(timer_seconds: 5)
+    freeze_time
+    @game.start!
+    assert @game.finish_question!
+    travel 6.seconds
+    assert_not @game.finish_if_time_is_up!, "already finished"
+
+    @game.next_question!
+    screen = Game.find(@game.id) # rendered before the timer went off
+    travel 6.seconds
+    assert Game.find(@game.id).finish_if_time_is_up!
+    assert_not screen.finish_if_time_is_up!, "the other one finished it: no error, no second change"
+    assert screen.question_closed?
+    assert_equal 2, screen.question_number
+  end
+
+  test "winners are picked after the end: Top N, Draw, Reset winners" do
+    @quiz.update!(winners_count: 1)
+    carol = join_game(@game, "Carol")
+    @game.start!
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "429").id, at: @game.question_opened_at + 3)
+    @game.answer!(@bob, question_id: @first.id, option_id: option_of(@first, "429").id, at: @game.question_opened_at + 1)
+    @game.answer!(carol, question_id: @first.id, option_id: option_of(@first, "418").id)
+
+    assert_not @game.pick_top_winners!, "not before the end"
+    assert_not @game.draw_winners!
+    assert_not @game.reset_winners!
+
+    @game.finish_question!
+    @game.end!
+    assert_equal [], @game.winner_ids
+
+    assert @game.pick_top_winners!
+    assert_equal [ @bob.id ], @game.reload.winner_ids, "Bob was faster"
+    assert @game.leaderboard.for(@bob).winner?
+    assert_not @game.leaderboard.for(@alice).winner?
+
+    drawn = Array.new(30) { |seed| @game.draw_winners!(random: Random.new(seed)); @game.reload.winner_ids }
+    assert_equal [ [ @alice.id ], [ @bob.id ] ], drawn.uniq.sort, "a draw between Alice and Bob, speed doesn't matter"
+
+    @quiz.update!(winners_count: 5)
+    @game.reload.pick_top_winners!
+    assert_equal [ @alice.id, @bob.id ].sort, @game.reload.winner_ids, "Carol has no points"
+
+    assert @game.reset_winners!
+    assert_equal [], @game.reload.winner_ids
+    assert_not @game.leaderboard.any?(&:winner?)
+  end
+
+  test "picking winners tells phones and screens" do
+    @game.start!
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "429").id)
+    @game.finish_question!
+    @game.end!
+
+    assert_broadcasts(PlayerChannel.broadcasting_for(@game), 1) do
+      assert_broadcasts(ScreenChannel.broadcasting_for(@game), 1) { @game.pick_top_winners! }
+    end
+    assert_no_broadcasts(PlayerChannel.broadcasting_for(@game)) { @game.pick_top_winners! } # nothing changed
+  end
+
+  test "a question that opens goes to the phones in the message itself, without what's correct" do
+    stream = PlayerChannel.broadcasting_for(@game)
+    @game.start!
+    message = JSON.parse(broadcasts(stream).last)
+    assert_equal @game.lock_version, message["version"]
+    html = Nokogiri::HTML5.fragment(message["html"])
+
+    root = html.at_css(".live-state")
+    assert_equal PlayerView.new(@game.reload, @alice).version, root["data-live-version"], "the same as a player's own view"
+    assert_equal @game.lock_version.to_s, root["data-game-version"]
+    assert_equal "Question 1 of 2", html.at_css(".play-question__num").text
+    assert_equal @first.options.map { it.id.to_s }, html.css("button[name=option_id]").map { it["value"] }
+    assert_empty html.css("[data-player-name]").text, "every phone fills in its player's name"
+    assert_empty html.css("input[name=authenticity_token]"), "no session behind it"
+    assert_no_match(/correct|Right answer/i, message["html"].gsub(@first.body, ""))
+
+    @game.finish_question!
+    assert_equal [ "version" ], JSON.parse(broadcasts(stream).last).keys, "results differ per player: they fetch them"
+    @game.next_question!
+    assert_match "Question 2 of 2", JSON.parse(broadcasts(stream).last)["html"]
+    @game.finish_question!
+    @game.end!
+    assert_equal [ "version" ], JSON.parse(broadcasts(stream).last).keys
+  end
+
+  test "deleting the quiz deletes its games, players and answers" do
+    @game.start!
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "429").id)
+
+    @quiz.destroy!
+    assert_equal [ 0, 0, 0 ], [ Game.count, Player.count, Answer.count ]
+  end
+end
diff --git a/test/models/leaderboard_test.rb b/test/models/leaderboard_test.rb
new file mode 100644
index 0000000..4c829ea
--- /dev/null
+++ b/test/models/leaderboard_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class LeaderboardTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Prizes", winners_count: 3)
+    @questions = Array.new(3) { |i| create_question(@quiz, "Q#{i + 1}?", %w[ right wrong ], correct: 0) }
+    @game = Game.start_for!(@quiz)
+  end
+
+  # Plays the whole quiz. `picks`: { player => [ [title, seconds after the question opened] or nil, … ] }.
+  def play(picks)
+    @game.start!
+    @questions.each_with_index do |question, index|
+      @game.next_question! if index.positive?
+      opened_at = @game.reload.question_opened_at
+      picks.each do |player, answers|
+        title, seconds = answers[index]
+        next unless title
+
+        @game.answer!(player, question_id: question.id, option_id: option_of(question, title).id, at: opened_at + seconds)
+      end
+      @game.finish_question!
+    end
+    @game.end!
+    @game.reload
+  end
+
+  def players(*names) = names.map { |name| join_game(@game, name) }
+  def names(standings) = standings.map { |standing| standing.player.name }
+  def names_of(ids) = Player.where(id: ids).order(:id).pluck(:name)
+
+  test "points first, then the lower total time of the correct answers, then join order" do
+    alice, bob, carol, dan, eve = players("Alice", "Bob", "Carol", "Dan", "Eve")
+    play(
+      alice => [ [ "right", 5 ], [ "right", 5 ], [ "wrong", 1 ] ],  # 2 points, 10 s
+      bob   => [ [ "right", 1 ], [ "right", 1 ], [ "right", 9 ] ],  # 3 points
+      carol => [ [ "right", 3 ], [ "wrong", 0.1 ], [ "right", 3 ] ], # 2 points, 6 s (the wrong answer's time doesn't count)
+      dan   => [ nil, nil, nil ],                                   # 0 points
+      eve   => [ [ "wrong", 1 ], nil, nil ]                         # 0 points
+    )
+
+    board = @game.leaderboard
+    assert_equal %w[ Bob Carol Alice Dan Eve ], names(board)
+    assert_equal [ 1, 2, 3, 4, 5 ], board.map(&:place)
+    assert_equal [ 3, 2, 2, 0, 0 ], board.map(&:points)
+    assert_equal [ 11_000, 6_000, 10_000, 0, 0 ], board.map(&:time_ms)
+    assert_equal 2, board.for(carol).place
+    assert_nil board.for(join_game(Game.start_for!(@quiz), "Other"))
+  end
+
+  test "an answer's time runs to the last pick" do
+    alice, bob = players("Alice", "Bob")
+    @game.start!
+    question = @questions.first
+    opened_at = @game.reload.question_opened_at
+
+    # Alice is quick but changes her mind; Bob picks once, later than Alice's first pick.
+    @game.answer!(alice, question_id: question.id, option_id: option_of(question, "right").id, at: opened_at + 1)
+    @game.answer!(bob, question_id: question.id, option_id: option_of(question, "right").id, at: opened_at + 2)
+    @game.answer!(alice, question_id: question.id, option_id: option_of(question, "wrong").id, at: opened_at + 3)
+    @game.answer!(alice, question_id: question.id, option_id: option_of(question, "right").id, at: opened_at + 4)
+    @game.finish_question!
+    @game.end!
+
+    assert_equal %w[ Bob Alice ], names(@game.reload.leaderboard)
+    assert_equal [ 2_000, 4_000 ], @game.leaderboard.map(&:time_ms)
+  end
+
+  test "Top N: the first N players of the leaderboard" do
+    a, b, c, d = players("A", "B", "C", "D")
+    play(a => [ [ "right", 1 ] ] * 3, b => [ [ "right", 2 ] ] * 3, c => [ [ "right", 3 ] ] * 3, d => [ [ "right", 1 ], nil, nil ])
+
+    assert_equal %w[ A B C ], names_of(@game.leaderboard.top_ids(3))
+    assert_equal %w[ A ], names_of(@game.leaderboard.top_ids(1))
+  end
+
+  test "players without points never win; with fewer scorers than prizes, all of them win" do
+    a, b, c, d = players("A", "B", "C", "D")
+    play(a => [ [ "right", 1 ], nil, nil ], b => [ [ "wrong", 1 ] ] * 3, c => [ nil ] * 3, d => [ nil, [ "right", 1 ], nil ])
+
+    board = @game.leaderboard
+    assert_equal %w[ A D ], names_of(board.top_ids(3))
+    assert_equal %w[ A D ], names_of(board.drawn_ids(3))
+    assert_equal %w[ A D ], names_of(board.drawn_ids(2)), "exactly N scorers: all of them"
+    assert_equal [], board.tied_ids(3)
+  end
+
+  test "Draw: above the N-th place's points win, the rest is drawn among exactly its points, whatever their speed" do
+    top, fast, mid, slow, low = players("Top", "Fast", "Mid", "Slow", "Low")
+    play(
+      top  => [ [ "right", 9 ] ] * 3,                 # 3 points, the slowest of all
+      fast => [ [ "right", 1 ], [ "right", 1 ], nil ], # 2 points…
+      mid  => [ [ "right", 2 ], [ "right", 2 ], nil ],
+      slow => [ [ "right", 3 ], [ "right", 3 ], nil ],
+      low  => [ [ "right", 1 ], nil, nil ]             # 1 point
+    )
+    board = @game.leaderboard
+    assert_equal %w[ Top Fast Mid Slow Low ], names(board)
+    assert_equal [ fast, mid, slow ].map(&:id).sort, board.tied_ids(2).sort, "2 prizes: Top, plus one of the three with 2 points"
+
+    draws = Array.new(60) { |seed| board.drawn_ids(2, random: Random.new(seed)) }
+    draws.each do |ids|
+      assert_equal 2, ids.size
+      assert_includes ids, top.id
+      assert_not_includes ids, low.id
+    end
+    assert_equal [ fast, mid, slow ].map(&:id).sort, draws.map { |ids| (ids - [ top.id ]).sole }.uniq.sort, "any of the tied can win"
+
+    assert_equal [ top, fast, mid, slow ].map(&:id).sort, board.drawn_ids(4).sort, "4 prizes: no tie at the cut-off"
+    assert_equal [], board.tied_ids(4)
+    assert_equal 4, board.drawn_ids(4, random: Random.new(1)).size
+  end
+
+  test "a tie entirely inside the prizes is no tie for the draw" do
+    a, b, c = players("A", "B", "C")
+    play(a => [ [ "right", 1 ] ] * 3, b => [ [ "right", 2 ] ] * 3, c => [ [ "right", 1 ], nil, nil ])
+
+    assert_equal [], @game.leaderboard.tied_ids(2)
+    assert_equal %w[ A B ], names_of(@game.leaderboard.drawn_ids(2))
+  end
+end
diff --git a/test/models/player_test.rb b/test/models/player_test.rb
new file mode 100644
index 0000000..32215ff
--- /dev/null
+++ b/test/models/player_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class PlayerTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+
+  setup do
+    @game = Game.start_for!(create_sample_quiz)
+    @player = join_game(@game, "Alice")
+  end
+
+  test "names are squished and required" do
+    player = @game.players.new(name: "  Ada \n Lovelace\t", token: "t")
+    assert player.valid?
+    assert_equal "Ada Lovelace", player.name
+
+    player.name = "   "
+    assert_not player.valid?
+    assert_equal [ "Please type a name" ], player.errors.map(&:message)
+
+    player.name = "x" * 41
+    assert_not player.valid?
+  end
+
+  test "a player is online while there are recent signs of life" do
+    assert @player.online?
+    assert_equal [ @player ], @game.players.online
+
+    travel Player::ONLINE_FOR + 1.second do
+      assert_not @player.reload.online?
+      assert_empty @game.players.online
+
+      @player.seen!
+      assert @player.reload.online?
+    end
+  end
+
+  test "coming back online refreshes the big screen; staying online writes at most every few seconds" do
+    @player.update_columns(last_seen_at: 1.minute.ago)
+    assert_broadcasts(ScreenChannel.broadcasting_for(@game), 1) { @player.seen! }
+
+    seen = @player.reload.last_seen_at
+    travel 1.second do
+      assert_no_broadcasts(ScreenChannel.broadcasting_for(@game)) { @player.seen! }
+      assert_equal seen, @player.reload.last_seen_at
+    end
+    travel Player::SEEN_EVERY + 1.second do
+      @player.seen!
+      assert_operator @player.reload.last_seen_at, :>, seen
+    end
+  end
+
+  test "closing the last live connection goes offline at once" do
+    @player.connected!
+    @player.connected! # a second tab, or a reconnection before the old connection's goodbye
+
+    @player.disconnected!
+    assert @player.reload.online?
+    assert_equal 1, @player.connections
+
+    assert_broadcasts(ScreenChannel.broadcasting_for(@game), 1) { @player.disconnected! }
+    assert_not @player.reload.online?
+    assert_equal 0, @player.connections
+
+    @player.disconnected!
+    assert_equal 0, @player.reload.connections
+  end
+
+  test "score counts correct answers" do
+    quiz = @game.quiz
+    first, second = quiz.questions.to_a
+    @game.start!
+    @game.answer!(@player, question_id: first.id, option_id: option_of(first, "429").id)
+    @game.finish_question!
+    @game.next_question!
+    @game.answer!(@player, question_id: second.id, option_id: option_of(second, "SMTP").id)
+
+    assert_equal 1, @player.score
+  end
+
+  test "the same browser token joins each game once" do
+    assert_raises(ActiveRecord::RecordNotUnique) { @game.players.create!(name: "Again", token: @player.token) }
+    assert join_game(Game.start_for!(@game.quiz), "Alice", token: @player.token)
+  end
+end
diff --git a/test/models/player_view_test.rb b/test/models/player_view_test.rb
new file mode 100644
index 0000000..c0a4eee
--- /dev/null
+++ b/test/models/player_view_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class PlayerViewTest < ActiveSupport::TestCase
+  setup do
+    @quiz = create_sample_quiz
+    @first, @second = @quiz.questions.to_a
+    @game = Game.start_for!(@quiz)
+    @alice = join_game(@game, "Alice")
+  end
+
+  def view(player = @alice) = PlayerView.new(@game.reload, player&.reload)
+
+  test "stages" do
+    assert_equal :join, view(nil).stage
+    assert_equal :lobby, view.stage
+    @game.start!
+    assert_equal :question_open, view.stage
+    @game.finish_question!
+    assert_equal :question_closed, view.stage
+    @game.end!
+    assert_equal :over, view.stage
+    assert_equal :over, view(nil).stage
+  end
+
+  test "the result is only known once the question is closed" do
+    @game.start!
+    assert_raises(RuntimeError) { view.result }
+
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "418").id)
+    @game.finish_question!
+    assert_equal :wrong, view.result
+  end
+
+  test "the join form's version ignores the game moving on (a half-typed name survives)" do
+    before = view(nil).version
+    @game.start!
+    @game.finish_question!
+    assert_equal before, view(nil).version
+
+    @game.end!
+    assert_not_equal before, view(nil).version
+  end
+
+  test "a player's version follows the game and their own pick" do
+    versions = [ view.version ]
+    @game.start!
+    versions << view.version
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "418").id)
+    versions << view.version
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "429").id)
+    versions << view.version
+    @game.finish_question!
+    versions << view.version
+    assert_equal versions.uniq, versions
+
+    bob = join_game(@game, "Bob")
+    assert_equal view.version, PlayerView.new(@game, @alice).version, "other players don't matter"
+    assert_not_equal view.version, view(bob).version
+  end
+
+  test "a question that just opened is the same for everyone: the shared view" do
+    assert_nil PlayerView.shared(@game), "the lobby"
+    @game.start!
+    shared = PlayerView.shared(@game.reload)
+    assert_equal :question_open, shared.stage
+    assert shared.shared?
+    assert_nil shared.answer
+    bob = join_game(@game, "Bob")
+    assert_equal [ shared.version ], [ view.version, view(bob).version ].uniq
+
+    @game.answer!(@alice, question_id: @first.id, option_id: option_of(@first, "418").id)
+    assert_not_equal shared.version, view.version, "Alice's pick is hers"
+    assert_equal shared.version, view(bob).version
+
+    @game.finish_question!
+    assert_nil PlayerView.shared(@game.reload), "results differ per player"
+    @game.end!
+    assert_nil PlayerView.shared(@game.reload)
+  end
+
+  test "after the end: place, points and the prize; the version follows the winners" do
+    bob = join_game(@game, "Bob")
+    @game.start!
+    @game.answer!(bob, question_id: @first.id, option_id: option_of(@first, "429").id)
+    @game.finish_question!
+    @game.end!
+
+    assert_equal [ 2, 0, false ], [ view.standing.place, view.standing.points, view.standing.winner? ]
+    assert_equal [ 1, 1 ], [ view(bob).standing.place, view(bob).standing.points ]
+    assert_equal 2, view.players_count
+    assert_nil view(nil).standing
+
+    before = view(bob).version
+    @game.pick_top_winners!
+    assert view(bob).standing.winner?
+    assert_not_equal before, view(bob).version
+    @game.reset_winners!
+    assert_equal before, view(bob).version
+  end
+end
diff --git a/test/models/question_test.rb b/test/models/question_test.rb
new file mode 100644
index 0000000..ecaaa19
--- /dev/null
+++ b/test/models/question_test.rb
@@ -0,0 +1,146 @@
+require "test_helper"
+
+class QuestionTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Quiz")
+  end
+
+  def build(rows, body: "Largest planet?")
+    @quiz.questions.build(body: body).tap { |question| question.option_rows = rows }
+  end
+
+  test "new questions are active and start with four empty option rows" do
+    question = @quiz.questions.build
+
+    assert question.active?
+    assert_equal 4, question.option_rows.size
+    assert question.option_rows.all?(&:blank?)
+  end
+
+  test "empty rows are skipped and the rest keep their order" do
+    question = build([ { title: "" }, { title: " Jupiter ", correct: "1" }, { title: "   " }, { title: "Saturn" } ])
+
+    assert question.save
+    assert_equal [ [ "Jupiter", true, 1 ], [ "Saturn", false, 2 ] ],
+      question.reload.options.map { |option| [ option.title, option.correct, option.position ] }
+  end
+
+  test "accepts rows keyed by index, as Rails parses form params" do
+    question = build({ "0" => { "title" => "Jupiter", "correct" => "1" }, "1" => { "title" => "Saturn" } })
+
+    assert question.save
+    assert_equal %w[ Jupiter Saturn ], question.options.map(&:title)
+  end
+
+  test "needs at least two options" do
+    question = build([ { title: "Jupiter", correct: "1" }, { title: "" } ])
+
+    assert_not question.save
+    assert_equal [ "Add at least two options" ], question.errors.full_messages
+  end
+
+  test "needs at least one correct option" do
+    question = build([ { title: "Jupiter" }, { title: "Saturn" } ])
+
+    assert_not question.save
+    assert_equal [ "Mark at least one option as correct" ], question.errors.full_messages
+  end
+
+  test "several correct options are fine" do
+    assert build([ { title: "Jupiter", correct: "1" }, { title: "Saturn", correct: "1" } ]).save
+  end
+
+  test "reports every failed rule, plus a blank question text" do
+    question = build([ { title: "" } ], body: "")
+
+    assert_not question.save
+    assert_equal [ "Question can't be blank", "Add at least two options", "Mark at least one option as correct" ],
+      question.errors.full_messages
+  end
+
+  test "a failed save keeps the rows as typed and saves nothing" do
+    question = build([ { title: "Jupiter" }, { title: "" }, { title: "Saturn" }, { title: "" } ])
+
+    assert_no_difference -> { Question.count + Option.count } do
+      assert_not question.save
+    end
+    assert_equal [ "Jupiter", "", "Saturn", "" ], question.option_rows.map(&:title)
+  end
+
+  test "editing updates options in place, adds new ones and removes emptied ones" do
+    question = create_question(@quiz, "Largest planet?", %w[ Jupiter Saturn Earth ], correct: 0)
+    jupiter, saturn, earth = question.options.to_a
+
+    question.option_rows = [
+      { id: jupiter.id, title: "Jupiter" },
+      { id: saturn.id, title: "", correct: "1" },
+      { id: earth.id, title: "Earth", correct: "1" },
+      { title: "Neptune" }
+    ]
+    assert question.save
+
+    options = question.reload.options
+    assert_equal %w[ Jupiter Earth Neptune ], options.map(&:title)
+    assert_equal [ jupiter.id, earth.id ], options.first(2).map(&:id)
+    assert_equal [ false, true, false ], options.map(&:correct)
+    assert_not Option.exists?(saturn.id)
+  end
+
+  test "a failed edit leaves the saved options untouched" do
+    question = create_question(@quiz, "Largest planet?", %w[ Jupiter Saturn ], correct: 0)
+
+    question.option_rows = [ { id: question.options.first.id, title: "Jupiter" } ]
+    assert_not question.save
+
+    assert_equal %w[ Jupiter Saturn ], question.reload.options.map(&:title)
+  end
+
+  test "the edit form shows saved options padded to four rows" do
+    question = create_question(@quiz, "Largest planet?", %w[ Jupiter Saturn ], correct: 1)
+
+    rows = Question.find(question.id).option_rows
+    assert_equal [ "Jupiter", "Saturn", "", "" ], rows.map(&:title)
+    assert_equal [ false, true, false, false ], rows.map(&:correct)
+  end
+
+  test "new questions go to the end of the quiz" do
+    first = create_question(@quiz, "One", %w[ a b ])
+    second = create_question(@quiz, "Two", %w[ a b ])
+
+    assert_equal [ 1, 2 ], [ first.position, second.position ]
+    assert_equal [ first, second ], @quiz.reload.questions
+  end
+
+  test "moving up and down reorders the quiz" do
+    one, two, three = %w[ One Two Three ].map { |body| create_question(@quiz, body, %w[ a b ]) }
+
+    assert three.move_up!
+    assert_equal %w[ One Three Two ], @quiz.reload.questions.map(&:body)
+
+    assert one.move_down!
+    assert_equal %w[ Three One Two ], @quiz.reload.questions.map(&:body)
+
+    assert_not Question.find(two.id).move_down!, "the last question can't move down"
+    assert_not Question.find(three.id).move_up!, "the first question can't move up"
+    assert_equal %w[ Three One Two ], @quiz.reload.questions.map(&:body)
+  end
+
+  test "moving copes with gaps and duplicate positions" do
+    one, two, three = %w[ One Two Three ].map { |body| create_question(@quiz, body, %w[ a b ]) }
+    one.update_columns(position: 5)
+    two.update_columns(position: 5)
+    three.update_columns(position: 9)
+
+    assert Question.find(three.id).move_up!
+    assert_equal %w[ One Three Two ], @quiz.reload.questions.map(&:body)
+    assert_equal [ 1, 2, 3 ], @quiz.questions.map(&:position)
+  end
+
+  test "deleting a quiz deletes its questions and options" do
+    create_question(@quiz, "One", %w[ a b ])
+
+    assert_difference -> { Question.count } => -1, -> { Option.count } => -2 do
+      @quiz.destroy
+    end
+  end
+end
diff --git a/test/models/question_timer_test.rb b/test/models/question_timer_test.rb
new file mode 100644
index 0000000..64c00f6
--- /dev/null
+++ b/test/models/question_timer_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class QuestionTimerTest < ActiveSupport::TestCase
+  setup do
+    @quiz = create_sample_quiz
+    @first, @second = @quiz.questions.to_a
+    @game = Game.start_for!(@quiz)
+    QuestionTimer.enabled = true
+  end
+
+  teardown do
+    QuestionTimer.enabled = false
+  end
+
+  def now = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+
+  def wait_for(timeout: 3)
+    deadline = now + timeout
+    sleep 0.02 until yield || now > deadline
+    yield
+  end
+
+  test "a timed question finishes by itself at its deadline, on the server" do
+    @quiz.update!(timer_seconds: 1)
+    started = now
+    @game.start!
+
+    assert wait_for { Game.find(@game.id).question_closed? }, "finished without any request"
+    assert_in_delta 1.0, now - started, 0.5
+  end
+
+  test "a question finished early is left alone, and so is the one after it" do
+    @quiz.update!(timer_seconds: 1)
+    @game.start!
+    @game.finish_question!
+    @quiz.update!(timer_seconds: 0)
+    @game.next_question! # no timer for this one
+
+    sleep 1.3
+    assert @game.reload.question_open?
+    assert_equal @second, @game.current_question
+  end
+
+  test "scheduling is once per question, however often requests ask for it" do
+    @quiz.update!(timer_seconds: 30)
+    @game.start! # scheduled when it opened
+    assert_not QuestionTimer.schedule(@game)
+    assert_not Game.find(@game.id).check_timer!
+  end
+
+  test "after a restart, the first request for the game brings its timer back" do
+    QuestionTimer.enabled = false # the process that opened the question is gone, with its timers
+    @quiz.update!(timer_seconds: 1)
+    @game.start!
+    QuestionTimer.enabled = true
+
+    started = now
+    assert Game.find(@game.id).check_timer!, "a screen or phone asked for the game"
+    assert wait_for { Game.find(@game.id).question_closed? }
+    assert_in_delta 1.0, now - started, 0.5
+  end
+
+  test "nothing is scheduled while switched off or without a timer" do
+    QuestionTimer.enabled = false
+    @quiz.update!(timer_seconds: 1)
+    @game.start!
+    assert_not QuestionTimer.schedule(@game)
+
+    QuestionTimer.enabled = true
+    @game.finish_question!
+    assert_not QuestionTimer.schedule(@game), "the question isn't open"
+    @quiz.update!(timer_seconds: 0)
+    @game.next_question!
+    assert_not QuestionTimer.schedule(@game), "no timer"
+  end
+end
diff --git a/test/models/quiz_export_test.rb b/test/models/quiz_export_test.rb
