+++ b/test/system/questions_test.rb
@@ -0,0 +1,142 @@
+require "application_system_test_case"
+
+class QuestionsTest < ApplicationSystemTestCase
+  setup do
+    @quiz = create_sample_quiz
+  end
+
+  def question_item(text) = find("li", text: text)
+
+  # Option chips of a question card; correct ones carry a screen-reader-only "(correct)".
+  def option_chips(text)
+    question_item(text).all(".question-item__option").map { |chip| chip.text.squish }
+  end
+
+  test "adding a question with an extra option" do
+    visit moderate_quiz_path(@quiz)
+    click_button "Add question"
+
+    assert_selector "h1", text: "New question"
+    assert_checked_field "Active"
+    (1..4).each { |number| assert_field "Option #{number}", with: "" }
+    assert_no_field "Option 5"
+
+    fill_in "Question", with: "Which planet is the largest?"
+    fill_in "Option 1", with: "Jupiter"
+    fill_in "Option 2", with: "Saturn"
+    fill_in "Option 4", with: "Earth"
+    click_button "Add option"
+    fill_in "Option 5", with: "Neptune"
+    check "Option 5 is correct"
+    check "Option 1 is correct"
+    click_button "Save question"
+
+    assert_selector "h1", text: "Frontend Fest 2026"
+    assert_equal [ "A. Jupiter (correct)", "B. Saturn", "C. Earth", "D. Neptune (correct)" ], option_chips("Which planet is the largest?")
+    within(question_item("Which planet is the largest?")) { assert_selector ".is-correct", count: 2 }
+  end
+
+  test "the rules keep the form as typed" do
+    visit new_moderate_quiz_question_path(@quiz)
+    fill_in "Question", with: "Which planet is the largest?"
+    fill_in "Option 3", with: "Jupiter"
+    uncheck "Active"
+    click_button "Save question"
+
+    assert_text "Add at least two options"
+    assert_text "Mark at least one option as correct"
+    assert_field "Question", with: "Which planet is the largest?"
+    assert_field "Option 3", with: "Jupiter"
+    assert_unchecked_field "Active"
+
+    fill_in "Option 1", with: "Saturn"
+    click_button "Save question"
+    assert_no_text "Add at least two options"
+    assert_text "Mark at least one option as correct"
+
+    check "Option 3 is correct"
+    click_button "Save question"
+    assert_equal [ "A. Saturn", "B. Jupiter (correct)" ], option_chips("Which planet is the largest?")
+    assert_selector "li.question-item--inactive", text: "Which planet is the largest?"
+  end
+
+  test "removing a row renumbers the others" do
+    visit new_moderate_quiz_question_path(@quiz)
+    fill_in "Option 1", with: "Jupiter"
+    fill_in "Option 2", with: "Pluto"
+    fill_in "Option 3", with: "Saturn"
+
+    all(".option-rows .option-row")[1].click_button("Remove row")
+
+    assert_field "Option 2", with: "Saturn"
+    assert_field "Option 3", with: ""
+    assert_no_field "Option 4"
+    check "Option 2 is correct"
+    click_button "Add option"
+    assert_field "Option 4", with: ""
+
+    fill_in "Question", with: "Ringed planet?"
+    click_button "Save question"
+    within(question_item("Ringed planet?")) { assert_selector ".is-correct", text: "B. Saturn" }
+  end
+
+  test "editing a question" do
+    visit moderate_quiz_path(@quiz)
+    within(question_item("two-way connection")) { click_link "Edit" }
+
+    assert_field "Question", with: "Which protocol keeps a two-way connection?"
+    assert_field "Option 1", with: "WebSocket"
+    assert_checked_field "Option 1 is correct"
+    assert_field "Option 4", with: ""
+
+    fill_in "Option 2", with: ""
+    fill_in "Option 4", with: "Server-Sent Events"
+    click_button "Save question"
+
+    assert_equal [ "A. WebSocket (correct)", "B. FTP", "C. Server-Sent Events" ], option_chips("two-way connection")
+  end
+
+  test "reordering questions" do
+    visit moderate_quiz_path(@quiz)
+
+    within(question_item("What does CSS stand for?")) { click_button "Move up" }
+    assert_selector "li.question-item:nth-child(2)", text: "What does CSS stand for?"
+
+    within(question_item("Too Many Requests")) { click_button "Move down" }
+    assert_selector "li.question-item:nth-child(1)", text: "What does CSS stand for?"
+    assert_selector "li.question-item:nth-child(2)", text: "Too Many Requests"
+
+    visit moderate_quiz_path(@quiz)
+    assert_equal [ "What does CSS stand for?", "Which HTTP status code means \"Too Many Requests\"?", "Which protocol keeps a two-way connection?" ],
+      all(".question-item__body").map(&:text)
+  end
+
+  test "the Active switch saves at once" do
+    visit moderate_quiz_path(@quiz)
+    assert_text "2 of 3 questions active"
+
+    within(question_item("Too Many Requests")) { uncheck "Active" }
+    assert_text "1 of 3 questions active"
+    assert_selector "li.question-item--inactive", text: "Too Many Requests"
+    assert_not @quiz.questions.first.reload.active?
+
+    within(question_item("What does CSS stand for?")) { check "Active" }
+    assert_text "2 of 3 questions active"
+
+    visit moderate_quiz_path(@quiz)
+    within(question_item("Too Many Requests")) { assert_unchecked_field "Active" }
+    within(question_item("What does CSS stand for?")) { assert_checked_field "Active" }
+  end
+
+  test "deleting a question asks first" do
+    visit moderate_quiz_path(@quiz)
+
+    within(question_item("two-way connection")) { dismiss_confirm { click_button "Delete" } }
+    assert_selector "li.question-item", count: 3
+
+    within(question_item("two-way connection")) { accept_confirm { click_button "Delete" } }
+    assert_no_text "two-way connection"
+    assert_selector "li.question-item", count: 2
+    assert_text "1 of 2 questions active"
+  end
+end
