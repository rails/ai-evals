+require "test_helper"
+
+class Moderate::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "the quiz page links to the export" do
+    quiz = create_sample_quiz
+
+    get_as_moderator moderate_quiz_path(quiz)
+
+    assert_select "a[href=?]", moderate_quiz_export_path(quiz), text: "Export", count: 1
+  end
+
+  test "shows the quiz as JSON in the page's only pre element" do
+    quiz = create_sample_quiz
+
+    get_as_moderator moderate_quiz_export_path(quiz)
+
+    assert_response :success
+    assert_select "pre", 1 do |(pre)|
+      assert_equal QuizExport.new(quiz).to_json, pre.text
+      assert_equal %w[ questions title ], JSON.parse(pre.text).keys.sort
+    end
+    assert_select "a[href=?]", moderate_quiz_path(quiz), text: /Frontend Fest 2026/
+  end
