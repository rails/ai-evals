+.question-item { display: grid; grid-template-columns: auto 1fr auto; gap: 20px; align-items: start; scroll-margin-top: 20px; }
+.question-item--inactive { opacity: 0.5; }
+.question-item__num { font-family: var(--f-display); font-weight: 800; font-size: 32px; min-width: 1.6em; }
+.question-item__body { font-weight: 600; font-size: 19px; margin-bottom: 10px; white-space: pre-line; }
+.question-item__options { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
+.question-item__option { background: var(--c-lavender); border-radius: 1000px; padding: 4px 12px; font-size: 15px; }
+.question-item__option.is-correct { background: var(--c-success); color: var(--c-white); }
+.question-item__option.is-correct::before { content: "✓ "; }
+.question-item__actions { display: flex; flex-direction: column; gap: 8px; align-items: flex-end; }
+.question-item__actions .buttons { justify-content: flex-end; }
+
+.option-rows { display: flex; flex-direction: column; gap: 10px; margin-bottom: 14px; }
