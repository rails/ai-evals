+
+.admin-main { padding: 40px var(--gutter) 80px; max-width: 1100px; margin: 0 auto; }
+
+.page-head { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-end; justify-content: space-between; margin-bottom: 32px; }
+.page-head h1 { margin: 0; }
+.breadcrumbs { font-size: 15px; margin-bottom: 8px; }
+
+.card {
+  background: var(--c-white);
+  border-radius: var(--radius);
+  padding: 24px;
+  margin-bottom: 16px;
+}
+
+.section { margin-top: 48px; }
+.section-head { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: center; margin-bottom: 16px; }
+.section-head h2 { margin: 0; }
+
+.empty { color: var(--c-muted); padding: 32px; text-align: center; border: 2px dashed var(--c-muted); border-radius: var(--radius); }
+
+.quiz-list { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
+.quiz-tile { display: block; text-decoration: none; transition: transform 0.15s; }
+.quiz-tile:hover { transform: translateY(-3px); color: var(--c-blue); }
+.quiz-tile h3 { margin-bottom: 12px; }
