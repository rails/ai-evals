new file mode 100644
index 0000000..d21f9d7
--- /dev/null
+++ b/config/cable.yml
@@ -0,0 +1,21 @@
+# Async adapter only works within the same process, so for manually triggering cable updates from a console,
+# and seeing results in the browser, you must do so from the web console (running inside the dev process),
+# not a terminal started via bin/rails console! Add "console" to any action or any ERB template view
+# to make the web console appear.
+development:
+  adapter: async
+
+test:
+  adapter: test
+
+production:
+  adapter: solid_cable
+  connects_to:
+    database:
+      writing: cable
+  # Every subscriber gets a message in the same poll: phones see a question at the same
+  # moment, at most this long after the moderator clicked (answer times decide ties).
+  polling_interval: 0.05.seconds
+  message_retention: 1.day
+  writer_batch_size: 4
+  writer_batch_delay: 0.001.seconds
