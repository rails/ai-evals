+
+  # Raise error when a before_action's only/except options reference missing actions.
+  config.action_controller.raise_on_missing_callback_actions = true
+
+  # Always resolve assets from app/assets, even after `bin/serve` has
+  # precompiled them into public/assets (Propshaft would otherwise switch to
+  # the stale precompiled manifest).
+  config.assets.manifest_path = Rails.root.join("tmp/assets-manifest-unused.json")
+end
