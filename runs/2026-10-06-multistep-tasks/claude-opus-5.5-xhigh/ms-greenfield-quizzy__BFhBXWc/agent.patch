diff --git a/app/models/player.rb b/app/models/player.rb
new file mode 100644
index 0000000..f6f4a76
--- /dev/null
+++ b/app/models/player.rb
@@ -0,0 +1,60 @@
+# Someone in the audience playing a game, on their phone. No account: the
+# browser keeps a random token in a permanent cookie, and the same browser is
+# the same player (per game).
+#
+# Presence ("players currently in the game"): a player is online while there is
+# a recent sign of life (`last_seen_at` within ONLINE_FOR): page views, live
+# polls, answers, and a heartbeat over the live connection every few seconds.
+# Closing the page ends its live connection; when the last one ends the player
+# goes offline at once. Phones that silently drop off the Wi-Fi time out.
+class Player < ApplicationRecord
+  ONLINE_FOR = 30.seconds
+  # Throttles last_seen_at writes; well below the clients' heartbeat interval.
+  SEEN_EVERY = 5.seconds
+  NAME_MAX = 40
+
+  belongs_to :game, inverse_of: :players
+  has_many :answers, dependent: :delete_all
+
+  normalizes :name, with: ->(name) { name.to_s.gsub(/[[:cntrl:]]/, " ").squish }
+
+  validates :name, presence: { message: "Please type a name" }, length: { maximum: NAME_MAX }
+  validates :token, presence: true
+
+  scope :online, -> { where(last_seen_at: ONLINE_FOR.ago..) }
+
+  def online? = last_seen_at.present? && last_seen_at >= ONLINE_FOR.ago
+
+  # A sign of life. Coming back online refreshes the big screen's counters.
+  def seen!(now = Time.current)
+    rows = Player.where(id: id)
+    if rows.where("last_seen_at IS NULL OR last_seen_at < ?", now - ONLINE_FOR).update_all(last_seen_at: now).positive?
+      game.signal_screen
+    else
+      rows.where(last_seen_at: ...(now - SEEN_EVERY)).update_all(last_seen_at: now)
+    end
+    self.last_seen_at = now
+  end
+
+  # A live connection (a page with the game open) subscribed.
+  def connected!(now = Time.current)
+    Player.where(id: id).update_all([ "connections = connections + 1, last_seen_at = ?", now ])
+    game.signal_screen
+  end
+
+  # A live connection ended. With no other one left (another tab, or a
+  # reconnection that overtook the old connection's goodbye) the player is gone.
+  # One statement, so a connection arriving meanwhile can't be undone by it.
+  def disconnected!
+    Player.where(id: id).update_all(<<~SQL.squish)
+      last_seen_at = CASE WHEN connections <= 1 THEN NULL ELSE last_seen_at END,
+      connections = MAX(connections - 1, 0)
+    SQL
+    game.signal_screen
+  end
+
+  # Correct answers in this game.
+  def score
+    answers.joins(:option).where(options: { correct: true }).count
+  end
+end
diff --git a/app/models/player_view.rb b/app/models/player_view.rb
new file mode 100644
index 0000000..755f05e
--- /dev/null
+++ b/app/models/player_view.rb
@@ -0,0 +1,94 @@
+# What a player's phone shows right now (app/views/play/games/_state.html.erb).
+#
+# While a question is open nothing here knows which options are correct: the
+# result (`result`, correct options) is only read once the question is closed.
+#
+# `version` changes whenever the rendered view would, so live updates and
+# polls (ETag) leave unchanged states alone.
+#
+# A question that just opened looks the same on every phone (nobody picked
+# yet; the player's name is filled in by play_controller.js). That shared view
+# (`PlayerView.shared`) is rendered once and sent to all phones in the cable
+# message, so they all show the question at the same moment: answer times
+# decide ties. Its version equals each player's own version until they pick.
+class PlayerView
+  attr_reader :game, :player, :join_form
+
+  delegate :quiz, :question_number, :questions_count, to: :game
+
+  # The phones' view of the question that just opened, or nil if the game is
+  # anywhere else (those views depend on the player and are fetched).
+  def self.shared(game)
+    view = new(game, nil, shared: true)
+    view if view.stage == :question_open
+  end
+
+  def initialize(game, player, join_form: nil, shared: false)
+    @game = game
+    @player = player
+    @join_form = join_form || Player.new
+    @shared = shared
+  end
+
+  def shared? = @shared
+
+  # :join, :lobby, :question_open, :question_closed, :between (the current
+  # question was deleted mid-game) or :over.
+  def stage
+    @stage ||=
+      if game.over? then :over
+      elsif player.nil? && !shared? then :join
+      elsif game.lobby? then :lobby
+      elsif question.nil? then :between
+      elsif game.question_open? then :question_open
+      else :question_closed
+      end
+  end
+
+  def question = game.current_question
+  def options = question&.options.to_a
+
+  # The player's pick for the current question.
+  def answer
+    return @answer if defined?(@answer)
+
+    @answer = (player.answers.find_by(question: question) if player && question)
+  end
+
+  def picked?(option) = answer&.option_id == option.id
+
+  # After "Finish": :correct, :wrong or :none.
+  def result
+    raise "The result is only known once the question is closed" unless stage == :question_closed
+    return :none unless answer
+
+    answer.option.correct? ? :correct : :wrong
+  end
+
+  # After the end: the player's place, points and prize (nil without a player).
+  def standing
+    return @standing if defined?(@standing)
+
+    @standing = (game.leaderboard.for(player) if stage == :over && player)
+  end
+
+  def players_count = game.leaderboard.size
+
+  # Only what the stage shows: the join form, say, must not be re-rendered
+  # (and a half-typed name lost) because the game moved on.
+  def version
+    parts = [ game.id, stage, quiz.title ]
+    case stage
+    when :lobby then parts.push(player.id, player.name)
+    when :question_open
+      # The same for everyone until they pick (see PlayerView.shared).
+      parts.push(game.lock_version, quiz.updated_at.to_f, answer&.option_id)
+    when :question_closed, :between
+      parts.push(game.lock_version, quiz.updated_at.to_f, player.id, player.name, answer&.option_id)
+    when :over
+      parts.push(player&.id)
+      parts.push(player.name, standing&.place, players_count, standing&.points, standing&.winner?) if player
+    end
+    Digest::SHA256.hexdigest(parts.join("\u001f"))[0, 20]
+  end
+end
diff --git a/app/models/question.rb b/app/models/question.rb
new file mode 100644
index 0000000..c51f7e9
--- /dev/null
+++ b/app/models/question.rb
@@ -0,0 +1,95 @@
+# A single-choice question with text options.
+#
+# Options are edited as an ordered list of rows (see #option_rows=): empty rows
+# are skipped, the rest become the question's options in row order. Existing
+# options are updated in place (so future game answers can keep pointing at
+# them), and options whose rows were emptied or removed are destroyed.
+class Question < ApplicationRecord
+  NEW_FORM_ROWS = 4
+
+  # One row of the question form, as the moderator typed it.
+  OptionRow = Data.define(:id, :title, :correct) do
+    def self.empty = new(id: nil, title: "", correct: false)
+    def blank? = title.to_s.strip.empty?
+  end
+
+  belongs_to :quiz, inverse_of: :questions, touch: true
+  has_many :options, -> { order(:position, :id) }, dependent: :destroy, inverse_of: :question, autosave: true
+  has_many :answers, dependent: :delete_all
+
+  attribute :active, :boolean, default: true
+
+  validates :body, presence: true, length: { maximum: 2000 }
+  validate :options_rules
+
+  before_create :assign_position, unless: :position?
+
+  scope :active, -> { where(active: true) }
+
+  # The rows the form shows. Rows typed by the moderator win (so a failed save
+  # keeps what was typed); otherwise the saved options, padded with empty rows
+  # up to four, like a new question.
+  def option_rows
+    @option_rows || begin
+      rows = kept_options.map { |option| OptionRow.new(id: option.id, title: option.title, correct: option.correct?) }
+      rows + Array.new([ NEW_FORM_ROWS - rows.size, 0 ].max) { OptionRow.empty }
+    end
+  end
+
+  # Takes the form's rows, in display order: an array of { id:, title:, correct: }
+  # hashes, or a hash of them keyed by row index (as Rails parses form params).
+  def option_rows=(rows)
+    rows = rows.to_h.values if rows.respond_to?(:each_pair)
+    @option_rows = Array(rows).map do |row|
+      row = row.to_h.symbolize_keys
+      OptionRow.new(id: row[:id].presence&.to_i, title: row[:title].to_s,
+        correct: ActiveModel::Type::Boolean.new.cast(row[:correct]) || false)
+    end
+
+    options.reset # start from the saved options, even if rows were assigned before
+    existing = options.index_by(&:id)
+    @option_rows.reject(&:blank?).each.with_index(1) do |row, position|
+      option = existing.delete(row.id) || options.build
+      option.assign_attributes(title: row.title, correct: row.correct, position: position)
+    end
+    existing.each_value(&:mark_for_destruction)
+  end
+
+  # Options that stay after saving (not removed in the form), in order.
+  def kept_options
+    options.reject(&:marked_for_destruction?).sort_by { |option| option.position.to_i }
+  end
+
+  def move_up!   = move_by!(-1)
+  def move_down! = move_by!(+1)
+
+  private
+    def options_rules
+      kept = kept_options
+      errors.add(:base, :too_few_options) if kept.size < 2
+      errors.add(:base, :no_correct_option) if kept.none?(&:correct?)
+    end
+
+    def assign_position
+      self.position = (Question.where(quiz_id: quiz_id).maximum(:position) || 0) + 1
+    end
+
+    # Moves the question within its quiz and renumbers positions 1..n, so gaps
+    # (left by deletions) never get in the way.
+    def move_by!(offset)
+      transaction do
+        siblings = Question.where(quiz_id: quiz_id).order(:position, :id).lock.to_a
+        from = siblings.index(self)
+        to = from + offset
+        next false if to.negative? || to >= siblings.size
+
+        siblings.insert(to, siblings.delete_at(from))
+        siblings.each.with_index(1) do |question, position|
+          question.update_columns(position: position) unless question.position == position
+        end
+        self.position = siblings.index(self) + 1
+        quiz.touch
+        true
+      end
+    end
+end
diff --git a/app/models/question_timer.rb b/app/models/question_timer.rb
new file mode 100644
index 0000000..9c9541f
--- /dev/null
+++ b/app/models/question_timer.rb
@@ -0,0 +1,49 @@
+# Finishes a timed question at its deadline, on the server: the phones get
+# their result at 0:00 even if no big screen is open (or it's on a flaky
+# network). One scheduled task per opened question, in the Puma process
+# (Concurrent::ScheduledTask: no job queue runs in Puma, see
+# docs/architecture.md).
+#
+# - The task finishes the game's *current* question only if its time is really
+#   up (Game#finish_if_time_is_up!), so a question the moderator finished
+#   early, or one opened since, is left alone. A task that wakes up a little
+#   early (clock adjustments) waits again.
+# - Scheduling is idempotent per game and deadline (PENDING), so it is safe to
+#   ask for it on every request: timers live in memory, and after a restart
+#   the first screen or phone that asks for the game (they reconnect and
+#   refetch within seconds) schedules its timer again (Game#check_timer!). A
+#   question already overdue by then is finished by that request.
+#
+# Tests switch scheduling off (`QuestionTimer.enabled = false`, test_helper.rb)
+# unless they exercise it, so no background thread touches a test's data.
+class QuestionTimer
+  mattr_accessor :enabled, default: true
+
+  # [game id, deadline in ms] of the timers scheduled in this process.
+  PENDING = Concurrent::Map.new
+
+  # Schedules the game's open timed question to finish at its deadline (once).
+  # True if this call scheduled it.
+  def self.schedule(game)
+    return false unless enabled && game.timed?
+
+    key = [ game.id, (game.question_ends_at.to_r * 1000).floor ]
+    return false if PENDING.put_if_absent(key, true) # already scheduled
+
+    delay = [ game.question_ends_at - Time.current, 0 ].max
+    Concurrent::ScheduledTask.execute(delay) { time_up(key) }
+    true
+  end
+
+  def self.time_up(key)
+    PENDING.delete(key)
+    Rails.application.reloader.wrap do
+      game = Game.find_by(id: key.first)
+      next if game.nil? || game.finish_if_time_is_up!
+
+      schedule(game) # still open: woke up early (a new question has its own timer already)
+    end
+  rescue StandardError => error
+    Rails.error.report(error, handled: true) # requests for the game still finish it (see above)
+  end
+end
diff --git a/app/models/quiz.rb b/app/models/quiz.rb
new file mode 100644
index 0000000..b785200
