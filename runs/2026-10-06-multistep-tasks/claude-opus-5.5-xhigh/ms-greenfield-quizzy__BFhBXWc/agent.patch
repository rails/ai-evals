+# Moderator credentials for HTTP Basic authentication of the /moderate area.
+#
+# Production reads them from QUIZZY_MODERATOR_USERNAME and
+# QUIZZY_MODERATOR_PASSWORD; without both, nobody gets in. Development and
+# test fall back to moderator / secret.
+Rails.application.configure do
+  fallback = Rails.env.production? ? nil : { username: "moderator", password: "secret" }
+
+  config.x.moderator.username = ENV["QUIZZY_MODERATOR_USERNAME"].presence || fallback&.fetch(:username)
+  config.x.moderator.password = ENV["QUIZZY_MODERATOR_PASSWORD"].presence || fallback&.fetch(:password)
+end
+
+# Base URL of the join link players open (and the QR code), e.g.
+# http://192.168.1.20:3000 when the big screen runs on localhost. Without it,
+# the join link uses the host the moderator's browser uses.
+Rails.application.configure do
+  config.x.public_url = ENV["QUIZZY_PUBLIC_URL"].presence
+end
