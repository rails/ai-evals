+
+    winners = Array.new(20) { press(:draw_winners, game).winner_ids }
+    assert_equal [ [ players["Bob"].id ], [ players["Alice"].id ] ].sort, winners.uniq.sort
+
+    @quiz.update!(winners_count: 10)
+    press :draw_winners, game
+    assert_equal players.values_at("Alice", "Bob", "Carol").map(&:id).sort, game.winner_ids, "players without points never win"
+  end
+
+  test "winners can only be picked once the quiz is over" do
+    game = start_game
