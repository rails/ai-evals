+          <% unless Current.user.administrator? %>Ask an administrator to reactivate it.<% end %>
+        </span>
+      </div>
+
+      <% if Current.user.administrator? %>
+        <%= button_to "Reactivate", bot_suspension_path(bot), method: :delete, class: "btn txt-small flex-item-no-shrink",
+              data: { turbo_confirm: "Are you sure you want to reactivate #{bot.name}? It will be able to post messages and receive webhooks again." } %>
+      <% end %>
+    </div>
+  <% end %>
+
+  <div class="flex align-center gap">
+    <label for="<%= dom_id(bot, :bot_key) %>" class="txt-small flex-item-no-shrink">Bot code</label>
+
+    <span class="flex align-center gap input input--actor fill-white flex-item-grow min-width">
