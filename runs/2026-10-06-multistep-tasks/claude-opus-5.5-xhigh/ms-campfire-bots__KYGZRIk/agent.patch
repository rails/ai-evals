new file mode 100644
index 0000000..956e4b6
--- /dev/null
+++ b/app/views/bots/index.html.erb
@@ -0,0 +1,61 @@
+<% @page_title = "Chat bots" %>
+<%# Bot codes are credentials, so keep them out of Turbo’s snapshot cache %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to edit_account_path %>
+  </div>
+<% end %>
+
+<section class="panel txt-align-center flex flex-column gap" style="view-transition-name: bots">
+  <div class="pad-inline-double margin-inline">
+    <h1 class="margin-none">Chat bots</h1>
+    <p class="margin-none-block-start">
+      Bots post messages to the rooms they’re in. Unlike people, they only join the rooms they’re added to in the rooms’ settings, unless you set them to join every open room.
+    </p>
+  </div>
+
+  <% if Current.user.can_add_bots? %>
+    <%= link_to new_bot_path, class: "btn btn--reversed center" do %>
+      <%= image_tag "add.svg", size: 20, aria: { hidden: "true" } %>
+      <span class="for-screen-reader">Add a chat bot</span>
+    <% end %>
+  <% else %>
+    <p class="margin-none pad-inline-double txt-subtle">
+      You’ve reached the limit of <%= pluralize Current.account.bots_per_member, "bot" %> per member. Ask an administrator if you need more.
+    </p>
+  <% end %>
+
+  <% if @bots.any? %>
+    <div class="margin-block pad-inline fill-shade border-radius">
+      <menu class="flex flex-column gap margin-none pad">
+        <%= render partial: "bots/bot", collection: @bots %>
+      </menu>
+    </div>
+  <% end %>
+
+  <div class="flex flex-column gap txt-align-start txt-small" style="--row-gap: 0.5em">
+    <strong>Post a message as a bot</strong>
+    <span>Send the message as the body of a request, using the bot’s code and the ID of the room (it’s in the room’s address):</span>
+    <code class="input input--code fill-white overflow-x txt-nowrap"><%= "curl -d \"Deploy finished ✅\" #{rooms_url}/<room-id>/<bot-code>/messages" %></code>
+    <span>To post a file instead, send it as an <code>attachment</code> form field: <code>curl -F attachment=@report.pdf …</code></span>
+  </div>
+
+  <div class="flex flex-column gap txt-align-start txt-small" style="--row-gap: 0.5em">
+    <strong>Reply when mentioned</strong>
+    <span>Give a bot a webhook URL, and whenever someone @mentions it, we’ll <code>POST</code> the message to that URL as JSON. It includes the message text without the mention, and <code>room.reply_to</code>: the address to post the bot’s answer to later.</span>
+    <span>Or answer right away: respond with a <code>200</code> and a <code>text/plain</code> or <code>text/html</code> body to post it to the room as the bot, or with a <code>204</code> to post nothing.</span>
+  </div>
+
+  <div class="flex flex-column gap txt-align-start txt-small" style="--row-gap: 0.5em">
+    <strong>Say hello in new rooms</strong>
+    <span>Whenever a bot is added to a room, we’ll also <code>POST</code> a <code>joined</code> event with the <code>room</code> to its webhook URL. Answer it the same way to post a message in that room. Direct messages don’t count.</span>
+  </div>
+
+  <div class="flex flex-column gap txt-align-start txt-small" style="--row-gap: 0.5em">
+    <strong>Limits</strong>
+    <span>A bot can post up to <%= pluralize User::FloodControl::FLOOD_LIMIT, "message" %> in any <%= User::FloodControl::FLOOD_WINDOW.inspect %>, replies included. Past that, it’s held back for <%= User::FloodControl::COOLDOWN.inspect %>: posting gets a <code>429</code> with the seconds left in <code>Retry-After</code>, and replies aren’t posted.</span>
+    <span>A bot that keeps posting while it’s held back is suspended, and so is one whose webhook fails <%= Webhook::MAX_CONSECUTIVE_FAILURES %> times in a row. It keeps its rooms and messages, but gets a <code>403</code> when posting and no more webhooks until an administrator reactivates it.</span>
+  </div>
+</section>
