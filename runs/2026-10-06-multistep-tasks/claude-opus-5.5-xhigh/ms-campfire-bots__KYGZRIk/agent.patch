+
+  <div class="flex flex-column gap" style="--row-gap: 0.5em">
+    <label class="flex align-center gap input input--actor">
+      <%= form.url_field :webhook_url, class: "input", placeholder: "Webhook URL", autocomplete: "off", spellcheck: false,
+            aria: { describedby: "webhook_url_hint" }, data: { "1p-ignore": true } %>
+      <%= image_tag "link.svg", aria: { hidden: "true" }, size: 24, class: "colorize--black" %>
+      <span class="for-screen-reader">Webhook URL</span>
+    </label>
+
+    <span id="webhook_url_hint" class="txt-small txt-subtle">Optional. When someone @mentions the bot, or it’s added to a room, we’ll let it know at this address so it can reply.</span>
+  </div>
+
+  <div class="flex flex-column gap" style="--row-gap: 0.5em">
+    <label class="flex align-center gap pad-inline txt-align-start">
+      <%= image_tag "everyone.svg", aria: { hidden: "true" }, size: 24, class: "colorize--black flex-item-no-shrink" %>
+      <span class="flex-item-grow">Add to all open rooms</span>
+      <span class="switch flex-item-no-shrink">
+        <%= form.check_box :joins_all_open_rooms, class: "switch__input", aria: { describedby: "joins_all_open_rooms_hint" } %>
+        <span class="switch__btn round"></span>
+      </span>
+    </label>
+
+    <span id="joins_all_open_rooms_hint" class="txt-small txt-subtle">Including open rooms created later. Otherwise, add the bot to the rooms you choose from their settings.</span>
