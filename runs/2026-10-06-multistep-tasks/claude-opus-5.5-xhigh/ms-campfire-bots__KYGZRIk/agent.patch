+            data: { upload_preview_target: "image" } %>
+      <span class="for-screen-reader">Bot avatar</span>
+    </div>
+  </label>
+
+  <label class="flex align-center gap input input--actor txt-large">
+    <%= form.text_field :name, class: "input", placeholder: "Name the bot", required: true, autofocus: true,
+          autocomplete: "off", data: { "1p-ignore": true } %>
+    <%= image_tag "robot.svg", aria: { hidden: "true" }, size: 24, class: "colorize--black" %>
+    <span class="for-screen-reader">Name the bot</span>
