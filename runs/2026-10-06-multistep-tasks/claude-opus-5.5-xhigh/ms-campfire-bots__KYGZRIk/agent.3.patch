@@ -0,0 +1,17 @@
+require "test_helper"
+
+class Bot::JoinedWebhookJobTest < ActiveJob::TestCase
+  test "delivers the joined webhook" do
+    Webhook.any_instance.expects(:deliver_joined).with(rooms(:hq))
+
+    Bot::JoinedWebhookJob.perform_now(users(:deploy_bot), rooms(:hq))
+  end
+
+  test "is discarded when the room was deleted in the meantime" do
+    Bot::JoinedWebhookJob.perform_later(users(:deploy_bot), rooms(:hq))
+    rooms(:hq).destroy
+    Webhook.any_instance.expects(:deliver_joined).never
+
+    assert_nothing_raised { perform_enqueued_jobs only: Bot::JoinedWebhookJob }
+  end
+end
