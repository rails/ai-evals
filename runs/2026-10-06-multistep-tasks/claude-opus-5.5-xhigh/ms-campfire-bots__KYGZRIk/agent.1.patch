new file mode 100644
index 0000000..6848076
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,49 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    no_store # Bot codes are credentials, so keep them out of HTTP caches
+    @bots = bots.with_attached_avatar.includes(:creator).ordered
+  end
+
+  def new
+    @bot = User.bot.new
+  end
+
+  def create
+    User.create_bot! bot_params.merge(creator: Current.user)
+    redirect_to bots_url
+  rescue ActiveRecord::RecordInvalid => invalid
+    @bot = invalid.record
+    render :new, status: :unprocessable_content
+  end
+
+  def edit
+  end
+
+  def update
+    @bot.update! bot_params
+    redirect_to bots_url
+  rescue ActiveRecord::RecordInvalid
+    render :edit, status: :unprocessable_content
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url
+  end
+
+  private
+    # People manage the bots they've created. Administrators manage them all.
+    def bots
+      Current.user.administrator? ? User.active_bots : Current.user.bots.active
+    end
+
+    def set_bot
+      @bot = bots.find(params[:bot_id] || params[:id])
+    end
+
+    def bot_params
+      params.require(:user).permit(:name, :avatar)
+    end
+end
