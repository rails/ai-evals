+require "test_helper"
+
+class Bot::WebhookJobTest < ActiveJob::TestCase
+  test "delivers the webhook" do
+    Webhook.any_instance.expects(:deliver).with(messages(:first))
+
+    Bot::WebhookJob.perform_now(users(:deploy_bot), messages(:first))
+  end
+
+  test "is discarded when the message was deleted in the meantime" do
+    Bot::WebhookJob.perform_later(users(:deploy_bot), messages(:first))
+    messages(:first).destroy
+    Webhook.any_instance.expects(:deliver).never
+
+    assert_nothing_raised { perform_enqueued_jobs only: Bot::WebhookJob }
+  end
+end
