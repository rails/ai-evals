+require Rails.root.join("lib/removed_proposals_migration").to_s
+
+# Deletes, after copying them to db/removed_proposals/ (see docs/REMOVAL.md),
+# the communities of citizen proposals; the previous migration deleted their
+# topics. Their ids stay in the copy of the proposals table.
+class DeleteCommunitiesOfCitizenProposals < ActiveRecord::Migration[8.0]
+  include RemovedProposalsMigration
+
+  def up
+    execute <<~SQL.squish
+      CREATE TEMPORARY TABLE communities_to_delete ON COMMIT DROP AS
+      SELECT DISTINCT community_id AS id FROM proposals
+      WHERE community_id IS NOT NULL
+        AND community_id NOT IN (
+          SELECT community_id FROM budget_investments WHERE community_id IS NOT NULL
+        )
+        AND community_id NOT IN (
+          SELECT community_id FROM legislation_proposals WHERE community_id IS NOT NULL
+        )
+        AND community_id NOT IN (SELECT community_id FROM topics WHERE community_id IS NOT NULL)
+    SQL
+
+    with_lock_retries { remove_foreign_key :proposals, :communities, if_exists: true }
+    dump_and_delete "communities", "id IN (SELECT id FROM communities_to_delete)"
+  end
+
+  def down
+    raise ActiveRecord::IrreversibleMigration
+  end
+end
