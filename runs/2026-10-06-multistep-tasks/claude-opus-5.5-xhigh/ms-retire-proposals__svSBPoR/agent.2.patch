diff --git a/db/migrate/20261006150700_drop_citizen_proposals_tables.rb b/db/migrate/20261006150700_drop_citizen_proposals_tables.rb
new file mode 100644
index 0000000..8cbdb12
--- /dev/null
+++ b/db/migrate/20261006150700_drop_citizen_proposals_tables.rb
@@ -0,0 +1,37 @@
+require Rails.root.join("lib/removed_proposals_migration").to_s
+
+# Drops the tables of citizen proposals, proposal notifications and the
+# proposals dashboard, after copying them (rows in CSV files, definitions in SQL
+# files) to db/removed_proposals/ (see docs/REMOVAL.md).
+class DropCitizenProposalsTables < ActiveRecord::Migration[8.0]
+  include RemovedProposalsMigration
+
+  # In an order respecting foreign keys. Dropping dashboard_administrator_tasks
+  # also locks `users` (because of its foreign key), so it goes last to keep
+  # that lock until the end of the migration as short as possible.
+  TABLES = %w[
+    links
+    proposal_translations
+    proposal_notifications
+    dashboard_executed_actions
+    dashboard_actions
+    proposals
+    dashboard_administrator_tasks
+  ].freeze
+
+  def up
+    # The application doesn't use these tables anymore; this makes sure
+    # nothing writes to them between copying and dropping them
+    with_lock_retries { execute "LOCK TABLE #{TABLES.join(", ")} IN SHARE MODE" }
+
