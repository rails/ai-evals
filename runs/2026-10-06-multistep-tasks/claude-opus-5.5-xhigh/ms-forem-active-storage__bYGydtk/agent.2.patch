+      previous_service = ActiveStorage::Blob.service
+      Fog.mock!
+      example.run
+    ensure
+      Fog::Mock.reset
+      Fog.unmock!
+      previous.each { |setting, value| CarrierWave::Uploader::Base.public_send(:"#{setting}=", value) }
+      CarrierWave::Storage::Fog.connection_cache.clear
+      ActiveStorage::Blob.service = previous_service
+    end
+
+    before do
