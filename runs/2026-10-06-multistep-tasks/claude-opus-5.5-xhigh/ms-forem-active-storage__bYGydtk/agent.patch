+  context "when it's interrupted" do
+    let!(:users) { Array.new(3) { create_with_legacy_profile_image(:user) } }
+
+    it "leaves nothing behind for the image being copied, and copies what's left when run again",
+       :aggregate_failures do
+      attempts = 0
+      allow(ActiveStorage::Attachment).to receive(:create!).and_wrap_original do |original, *args, **options|
+        attempts += 1
+        raise Interrupt if attempts == 2 # eg. Ctrl-C, or the process being stopped
