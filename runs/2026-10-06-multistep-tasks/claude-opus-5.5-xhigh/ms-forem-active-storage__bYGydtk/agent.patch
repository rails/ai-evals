+++ b/spec/tasks/profile_images_spec.rb
@@ -0,0 +1,49 @@
+require "rails_helper"
+
+RSpec.describe "profile_images tasks", type: :task do
+  let(:task) { Rake::Task["profile_images:copy"] }
+
+  before { task.reenable }
+
+  describe "profile_images:copy" do
+    it "copies the CarrierWave profile images of users and organizations to Active Storage" do
+      user = create_with_legacy_profile_image(:user)
+      organization = create_with_legacy_profile_image(:organization)
+      identifiers = [user[:profile_image], organization[:profile_image]]
+
+      expect { task.invoke }.to output(/User: 1 copied.*\n.*Organization: 1 copied/).to_stdout
+
+      [user, organization].each(&:reload)
+      expect([user, organization].map { |record| record.profile_image_file.attached? }).to eq([true, true])
+      expect([user, organization].pluck(:profile_image)).to eq(identifiers)
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+    end
+
+    it "can run again, eg. after an interruption, and only copies what's left" do
+      user = create_with_legacy_profile_image(:user)
+      expect { task.invoke }.to output(/User: 1 copied/).to_stdout
+
+      task.reenable
+      create_with_legacy_profile_image(:user)
+      expect { task.invoke }.to output(/User: 1 copied, 1 up to date/).to_stdout
+      expect(ActiveStorage::Attachment.where(record: user).count).to eq(1)
+    end
+
+    it "accepts a batch size" do
+      allow(ProfileImages::CopyToActiveStorage).to receive(:call)
+      allow(ENV).to receive(:fetch).and_call_original
+      allow(ENV).to receive(:fetch).with("BATCH_SIZE", anything).and_return("50")
+
+      task.invoke
+
+      expect(ProfileImages::CopyToActiveStorage).to have_received(:call).with(hash_including(batch_size: 50))
+    end
+
+    it "fails if some images couldn't be copied, so that it's run again" do
+      create_with_legacy_profile_image(:user)
+      allow(ActiveStorage::Blob.service).to receive(:upload).and_raise(Errno::ECONNRESET)
+
+      expect { task.invoke }.to raise_error(Errno::ECONNRESET).and output(/User: 0 copied.*1 failed/).to_stdout
+    end
+  end
+end
