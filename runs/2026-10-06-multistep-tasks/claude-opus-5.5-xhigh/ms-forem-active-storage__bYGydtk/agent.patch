+      allow(ActiveStorage::Attachment).to receive(:create!).and_call_original
+      expect(copy.counts["User"]).to include(copied: 2, up_to_date: 1)
+      expect(users.map { |user| user.reload.profile_image_file.attached? }).to all(be(true))
+      expect(users.map { |user| attachments_of(user).count }).to eq([1, 1, 1])
+      expect(ActiveStorage::Blob.count).to eq(3)
+    end
+  end
+
+  it "leaves nothing behind when attaching fails" do
+    user = create_with_legacy_profile_image(:user)
+    allow(ActiveStorage::Attachment).to receive(:create!).and_wrap_original do |original, *args, **options|
+      original.call(*args, **options)
+      raise ActiveRecord::StatementInvalid, "boom" # rolls the transaction back
+    end
+
+    keys = uploaded_keys { expect { copy }.to raise_error(ActiveRecord::StatementInvalid) }
+
+    expect(user.reload.profile_image_file).not_to be_attached
+    expect(ActiveStorage::Blob.count).to eq(0)
+    expect(service.exist?(keys.first)).to be(false)
+  end
+
+  it "keeps the copy if something fails once it's attached" do
+    user = create_with_legacy_profile_image(:user)
+    allow_any_instance_of(ActiveStorage::Attachment).to receive(:analyze_blob_later).and_raise("boom") # rubocop:disable RSpec/AnyInstance
+
+    expect { copy }.to raise_error("boom")
+
+    user.reload
+    expect(user.profile_image_file).to be_attached
+    expect(user.profile_image_file.download).to eq(File.binread(legacy_profile_image_path(user)))
+  end
+
+  context "when some images fail to be copied" do
+    let!(:users) { Array.new(3) { create_with_legacy_profile_image(:user) } }
+
+    it "copies the others, fails with the first error, and copies what's left when run again" do
+      attempts = 0
+      allow(service).to receive(:upload).and_wrap_original do |original, *args, **options|
+        attempts += 1
+        raise Errno::ECONNRESET if attempts == 1
+
+        original.call(*args, **options)
+      end
+
+      expect { copy }.to raise_error(Errno::ECONNRESET)
