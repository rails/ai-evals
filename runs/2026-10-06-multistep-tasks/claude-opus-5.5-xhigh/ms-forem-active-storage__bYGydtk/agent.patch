+      expect(copy.counts["User"]).to include(copied: 1, up_to_date: 2, failed: 0)
+      expect(users.map { |user| user.reload.profile_image_file.attached? }).to all(be(true))
+    end
+
+    it "stops when too many fail in a row (eg. the storage is down)" do
+      stub_const("#{described_class}::MAX_CONSECUTIVE_FAILURES", 2)
+      allow(service).to receive(:upload).and_raise(Errno::ECONNREFUSED)
+
+      expect { copy }.to raise_error(Errno::ECONNREFUSED)
+      expect(service).to have_received(:upload).twice
+      expect(ActiveStorage::Blob.count).to eq(0)
+    end
+  end
+
+  context "with S3 (CarrierWave's Fog storage), like in production" do
+    let(:bucket) { "forem-test-bucket" }
+    let(:fog_settings) { %i[storage fog_credentials fog_directory fog_public fog_attributes asset_host] }
+    let(:connection) { CarrierWave::Storage::Fog.new(CarrierWave::Uploader::Base.new).connection }
+    let(:service) { ActiveStorage::Blob.services.fetch(:carrierwave_fog) }
+
+    around do |example|
+      previous = fog_settings.index_with { |setting| CarrierWave::Uploader::Base.public_send(setting) }
+      previous_service = ActiveStorage::Blob.service
+      Fog.mock!
+      example.run
+    ensure
+      Fog::Mock.reset
+      Fog.unmock!
+      previous.each { |setting, value| CarrierWave::Uploader::Base.public_send(:"#{setting}=", value) }
+      CarrierWave::Storage::Fog.connection_cache.clear
+      ActiveStorage::Blob.service = previous_service
+    end
+
+    before do
+      # Same as CarrierWaveInitializer.standard_production_config and config/environments/production.rb
+      CarrierWave::Uploader::Base.storage = :fog
+      CarrierWave::Uploader::Base.fog_credentials = {
+        provider: "AWS", aws_access_key_id: "id", aws_secret_access_key: "secret", region: "us-east-1"
+      }
+      CarrierWave::Uploader::Base.fog_directory = bucket
+      CarrierWave::Uploader::Base.fog_public = true
+      CarrierWave::Uploader::Base.fog_attributes = { cache_control: "public, max-age=#{365.days.to_i}" }
+      CarrierWave::Uploader::Base.asset_host = nil
+      ActiveStorage::Blob.service = service
+      connection.directories.create(key: bucket)
+    end
+
+    def object(path)
+      connection.directories.get(bucket).files.get(path)
+    end
+
+    it "copies the image next to CarrierWave's, in the same bucket" do
+      user = create_with_legacy_profile_image(:user)
+      legacy_path = "uploads/user/profile_image/#{user.id}/#{user[:profile_image]}"
+      expect(user.profile_image_url).to eq("https://#{bucket}.s3.amazonaws.com/#{legacy_path}")
+
+      copy
+      user.reload
+      blob = user.profile_image_file.blob
+
+      expect(blob.service_name).to eq("carrierwave_fog")
+      expect(user.profile_image_url).to eq("https://#{bucket}.s3.amazonaws.com/uploads/active_storage/#{blob.key}")
+      copied = object("uploads/active_storage/#{blob.key}")
+      expect(copied.body).to eq(File.binread(jpg.path))
+      expect(copied.content_type).to eq("image/jpeg")
+      expect(object(legacy_path).body).to eq(File.binread(jpg.path))
+    end
+
+    it "leaves records whose CarrierWave file is missing to CarrierWave" do
+      user = create_with_legacy_profile_image(:user)
+      object("uploads/user/profile_image/#{user.id}/#{user[:profile_image]}").destroy
+      url = user.profile_image_url
+
+      expect(copy.counts["User"]).to include(missing: 1)
+      expect(user.reload.profile_image_url).to eq(url)
+    end
+  end
+
+  it "refuses to run before the Active Storage tables exist" do
+    allow(HasProfileImage).to receive(:active_storage_available?).and_return(false)
+
+    expect { copy }.to raise_error(/run the migrations first/)
+  end
+end
diff --git a/spec/support/legacy_profile_image_helpers.rb b/spec/support/legacy_profile_image_helpers.rb
new file mode 100644
index 0000000..9740f21
--- /dev/null
+++ b/spec/support/legacy_profile_image_helpers.rb
@@ -0,0 +1,31 @@
+# Profile images of users and organizations used to be stored by CarrierWave, which isn't mounted on these
+# models anymore (see HasProfileImage). These helpers store images the way it did, ie. like the releases
+# before Active Storage did (and still could, after a rollback): the file in CarrierWave's storage, and its
+# name in the +profile_image+ column.
+module LegacyProfileImageHelpers
+  # Stores the file as the record's CarrierWave image, like the release before Active Storage did, without
+  # touching its Active Storage image (if any). Returns the reloaded record.
+  def store_legacy_profile_image(record, file = fixture_file_upload("800x600.jpg", "image/jpeg"))
+    # On another instance: ProfileImageUploader memoizes its file names (random UUIDs) on the model
+    uploader = ProfileImageUploader.new(record.class.find(record.id), :profile_image)
+    uploader.store!(file)
+    record.update_columns(HasProfileImage::LEGACY_COLUMN => uploader.identifier)
+    record.reload
+  end
+
+  # A record and its image created before Active Storage: a CarrierWave image, and no Active Storage one.
+  def create_with_legacy_profile_image(factory, file = fixture_file_upload("800x600.jpg", "image/jpeg"), **attributes)
+    record = build(factory, profile_image: nil, **attributes)
+    record.save!(validate: false) # Organizations require an image
+    store_legacy_profile_image(record, file)
+  end
+
+  # Where CarrierWave stored the record's image (see HasProfileImage::LegacyImage), on the local file system
+  def legacy_profile_image_path(record, identifier = record[HasProfileImage::LEGACY_COLUMN])
+    Rails.public_path.join("uploads", record.class.name.underscore, "profile_image", record.id.to_s, identifier).to_s
+  end
+end
+
+RSpec.configure do |config|
+  config.include LegacyProfileImageHelpers
+end
