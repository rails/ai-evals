@@ -0,0 +1,421 @@
+require "rails_helper"
+
+RSpec.describe ProfileImages::CopyToActiveStorage do
+  let(:jpg) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+  let(:png) { fixture_file_upload("800x600.png", "image/png") }
+  let(:service) { ActiveStorage::Blob.service }
+
+  # Records with a CarrierWave image (stored before Active Storage, or by the release before it after a
+  # rollback) are created with LegacyProfileImageHelpers: CarrierWave isn't mounted on these models anymore.
+
+  def copy(**options)
+    described_class.call(logger: Logger.new(nil), **options)
+  end
+
+  def attachments_of(record)
+    ActiveStorage::Attachment.where(record: record, name: "profile_image_file")
+  end
+
+  # Keys of the files uploaded to Active Storage during the block
+  def uploaded_keys
+    keys = []
+    allow(service).to receive(:upload).and_wrap_original do |original, key, *args, **options|
+      keys << key
+      original.call(key, *args, **options)
+    end
+    yield
+    keys
+  end
+
+  %i[user organization].each do |factory|
+    context "with the CarrierWave profile image of a #{factory}" do
+      let!(:record) { create_with_legacy_profile_image(factory) }
+      let!(:legacy_identifier) { record[:profile_image] }
+      let!(:legacy_url) { record.profile_image_url }
+      let!(:legacy_path) { legacy_profile_image_path(record) }
+
+      it "is served by CarrierWave until it's copied" do
+        expect(legacy_url).to eq("/uploads/#{factory}/profile_image/#{record.id}/#{legacy_identifier}")
+        expect(record.profile_image_file).not_to be_attached
+      end
+
+      it "copies it to Active Storage, which then serves it" do
+        copy
+        record = self.record.class.find(self.record.id)
+
+        expect(record.profile_image_file).to be_attached
+        expect(record.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+        expect(record.profile_image_url).to end_with("/#{legacy_identifier}")
+        expect(record.profile_image_url_for(length: 90)).to eq(record.profile_image_url)
+        expect(record.as_json["profile_image"]).to eq("url" => record.profile_image_url)
+      end
+
+      it "copies the very same image, with CarrierWave's file name" do
+        copy
+        blob = record.reload.profile_image_file.blob
+
+        expect(blob.download).to eq(File.binread(legacy_path))
+        expect(blob.filename.to_s).to eq(legacy_identifier)
+        expect(blob.key).to end_with(".jpg")
+        expect(blob.content_type).to eq("image/jpeg")
+        expect(blob.metadata).to include("analyzed" => true, "width" => 800, "height" => 600,
+                                         "carrierwave_identifier" => legacy_identifier)
+      end
+
+      it "leaves the CarrierWave image alone (column, file, URL)" do
+        copy
+        record.reload
+
+        expect(record[:profile_image]).to eq(legacy_identifier)
+        expect(record.legacy_profile_image.url).to eq(legacy_url)
+        expect(record.profile_image_url).not_to eq(legacy_url) # displayed from Active Storage
+        expect(File.binread(legacy_path)).to eq(File.binread(jpg.path))
+      end
+
+      it "doesn't save nor touch the record: no callbacks, jobs, or cache invalidations" do
+        record.class.where(id: record.id).update_all(updated_at: 1.day.ago)
+        updated_at = record.reload.updated_at
+
+        sidekiq_assert_no_enqueued_jobs do
+          expect { copy }.not_to have_enqueued_job
+        end
+        expect(record.reload.updated_at).to eq(updated_at)
+      end
+
+      it "copies it once, however many times it runs" do
+        copy
+        url = record.reload.profile_image_url
+
+        expect { copy }.not_to change(ActiveStorage::Blob, :count)
+        expect(attachments_of(record).count).to eq(1)
+        expect(record.reload.profile_image_url).to eq(url)
+      end
+    end
+  end
+
+  it "reports what it did" do
+    create_with_legacy_profile_image(:user)
+    create_with_legacy_profile_image(:user).update!(profile_image: png) # replaced with Active Storage since
+    create(:user, profile_image: png) # Active Storage only: nothing to copy
+    create_with_legacy_profile_image(:organization)
+    create_with_legacy_profile_image(:organization).update!(profile_image: png)
+
+    result = copy
+
+    expect(result.counts["User"]).to include(copied: 1, up_to_date: 1, failed: 0)
+    expect(result.counts["Organization"]).to include(copied: 1, up_to_date: 1, failed: 0)
+    expect(result.total(:copied)).to eq(2)
+    expect(result).not_to be_failed
+    expect(result.summary).to include("User: 1 copied, 1 up to date, 0 missing, 0 unsupported, 0 changed, 0 failed")
+  end
+
+  it "copies records in batches" do
+    users = Array.new(3) { create_with_legacy_profile_image(:user) }
+
+    copy(batch_size: 2)
+
+    expect(users.map { |user| user.reload.profile_image_file.attached? }).to all(be(true))
+  end
+
+  it "ignores records without a profile image" do
+    user = create(:user, profile_image: nil)
+
+    expect { copy }.not_to change(ActiveStorage::Blob, :count)
+    expect(user.reload.profile_image_url).to be_nil
+  end
+
+  it "keeps Active Storage images uploaded since (the copy never overrides them)" do
+    user = create_with_legacy_profile_image(:user)
+    user.update!(profile_image: png)
+    url = user.reload.profile_image_url
+
+    expect { copy }.not_to change(ActiveStorage::Blob, :count)
+    expect(user.reload.profile_image_url).to eq(url)
+    expect(user.profile_image_file.blob.content_type).to eq("image/png")
+  end
+
+  it "keeps Active Storage images uploaded before their CarrierWave column was recorded" do
+    user = create_with_legacy_profile_image(:user)
+    user.update!(profile_image: png)
+    blob = user.reload.profile_image_file.blob
+    blob.update_columns(metadata: blob.metadata.except("carrierwave_identifier").to_json)
+
+    expect { copy }.not_to change(ActiveStorage::Blob, :count)
+    expect(user.reload.profile_image_file.blob).to eq(blob)
+  end
+
+  it "keeps other uploads on CarrierWave" do
+    tag = create(:tag, profile_image: png)
+
+    expect { copy }.not_to change(ActiveStorage::Blob, :count)
+    expect(tag.reload[:profile_image]).to be_present
+  end
+
+  context "when the CarrierWave file doesn't exist" do
+    it "leaves the record to CarrierWave, like before" do
+      user = create_with_legacy_profile_image(:user)
+      File.delete(legacy_profile_image_path(user))
+      url = user.profile_image_url
+
+      result = copy
+
+      expect(result.counts["User"]).to include(missing: 1, failed: 0)
+      expect(user.reload.profile_image_file).not_to be_attached
+      expect(user.profile_image_url).to eq(url)
+    end
+
+    it "skips columns that aren't CarrierWave files (eg. the URL of banished users)" do
+      user = create(:user, profile_image: nil)
+      user.update_columns(profile_image: Moderator::BanishUser::DEFAULT_PROFILE_IMAGE)
+
+      expect { copy }.not_to change(ActiveStorage::Blob, :count)
+      expect(user.reload.profile_image_url).to include("thepracticaldev.s3.amazonaws.com")
+    end
+  end
+
+  it "leaves images Active Storage wouldn't serve as images (eg. SVG) to CarrierWave" do
+    user = create(:user, profile_image: nil)
+    user.update_columns(profile_image: "logo.svg")
+    user.reload
+    FileUtils.mkdir_p(File.dirname(legacy_profile_image_path(user)))
+    File.write(legacy_profile_image_path(user), '<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10"></svg>')
+
+    result = nil
+    keys = uploaded_keys { result = copy }
+
+    expect(keys).to be_empty
+    expect(result.counts["User"]).to include(unsupported: 1)
+    expect(user.reload.profile_image_url).to eq("/uploads/user/profile_image/#{user.id}/logo.svg")
+  ensure
+    FileUtils.rm_f(legacy_profile_image_path(user)) if user
+  end
+
+  context "when the record changes during its copy" do
+    let!(:user) { create_with_legacy_profile_image(:user) }
+
+    # Runs the block right after the copy was uploaded, before it's attached. Returns the copy's key.
+    def after_upload
+      copy_key = nil
+      allow(service).to receive(:upload).and_wrap_original do |original, key, *args, **options|
+        copy_key = key
+        original.call(key, *args, **options).tap do
+          allow(service).to receive(:upload).and_call_original
+          yield
+        end
+      end
+      -> { copy_key }
+    end
+
+    it "keeps an image uploaded meanwhile, and deletes the copy" do
+      copy_key = after_upload { User.find(user.id).update!(profile_image: png) }
+
+      expect(copy.counts["User"]).to include(changed: 1)
+
+      expect(attachments_of(user).count).to eq(1)
+      expect(user.reload.profile_image_file.blob.content_type).to eq("image/png")
+      expect(copy_key.call).to be_present
+      expect(service.exist?(copy_key.call)).to be(false)
+    end
+
+    it "keeps a CarrierWave image changed meanwhile (eg. by the previous release), and copies it next time" do
+      after_upload { store_legacy_profile_image(User.find(user.id), png) }
+
+      expect(copy.counts["User"]).to include(changed: 1)
+      expect(user.reload.profile_image_file).not_to be_attached
+      expect(user.profile_image_url).to end_with(".png")
+
+      copy
+      expect(user.reload.profile_image_file.blob.content_type).to eq("image/png")
+      expect(user.profile_image_file.blob.download).to eq(File.binread(legacy_profile_image_path(user)))
+    end
+
+    it "doesn't copy an image removed meanwhile" do
+      after_upload { User.find(user.id).update!(profile_image: nil) }
+
+      expect(copy.counts["User"]).to include(changed: 1)
+      expect(user.reload.profile_image_file).not_to be_attached
+      expect(ActiveStorage::Blob.count).to eq(0)
+    end
+  end
+
+  context "when the CarrierWave image changed after it was copied (eg. by the previous release, after a rollback)" do
+    let!(:user) { create_with_legacy_profile_image(:user) }
+
+    before do
+      copy
+      store_legacy_profile_image(User.find(user.id), png)
+    end
+
+    it "serves the newer CarrierWave image until it's copied" do
+      user.reload
+      expect(user.profile_image_url).to eq("/uploads/user/profile_image/#{user.id}/#{user[:profile_image]}")
+      expect(user.profile_image_url).to end_with(".png")
+    end
+
+    it "replaces the outdated copy with a copy of the newer image" do
+      outdated_blob = user.reload.profile_image_file.blob
+
+      copy
+      user.reload
+
+      expect(attachments_of(user).count).to eq(1)
+      expect(user.profile_image_file.blob.content_type).to eq("image/png")
