@@ -0,0 +1,561 @@
+require "rails_helper"
+
+RSpec.describe HasProfileImage do
+  let(:png) { fixture_file_upload("800x600.png", "image/png") }
+  let(:jpg) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+
+  # Records with a CarrierWave image (stored before Active Storage) are created with
+  # LegacyProfileImageHelpers: CarrierWave isn't mounted on these models anymore.
+
+  # The error CarrierWave reports for this file
+  def uploader_error(file)
+    ProfileImageUploader.new(build(:user), :profile_image).cache!(file)
+    nil
+  rescue CarrierWave::UploadError => e
+    e.message
+  end
+
+  shared_examples "a model whose profile images move to Active Storage" do |factory|
+    let(:model) { described_class }
+    let(:record) { create(factory) }
+
+    it "doesn't mount a CarrierWave uploader anymore" do
+      expect(model.uploaders).not_to have_key(:profile_image)
+      expect(record.profile_image).not_to be_a(CarrierWave::Uploader::Base)
+      expect(record).not_to respond_to(:profile_image_identifier)
+      expect(model.new).not_to respond_to(:remove_profile_image!)
+    end
+
+    context "with a new record" do
+      it "stores its profile image with Active Storage only" do
+        record = nil
+        expect { record = create(factory, profile_image: png) }.to change(ActiveStorage::Blob, :count).by(1)
+
+        record.reload
+        expect(record.profile_image_file).to be_attached
+        expect(record[:profile_image]).to be_nil
+        expect(record.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+        expect(record.profile_image_url_for(length: 90)).to eq(record.profile_image_url)
+        expect(record.profile_image_90).to eq(record.profile_image_url)
+      end
+
+      it "keeps CarrierWave's file names (random UUIDs) and extensions" do
+        record = create(factory, profile_image: png)
+        blob = record.profile_image_file.blob
+
+        expect(blob.filename.to_s).to match(/\A\h{8}-\h{4}-\h{4}-\h{4}-\h{12}\.png\z/)
+        expect(blob.key).to end_with(".png")
+        expect(blob.content_type).to eq("image/png")
+        expect(blob.metadata).to include("analyzed" => true, "width" => 800, "height" => 600)
+      end
+
+      it "previews the image before it's saved, like CarrierWave did" do
+        record = build(factory, profile_image: png)
+
+        expect(record.profile_image_url).to match(%r{\A/uploads/tmp/.+/800x600\.png\z})
+        expect(record).to be_profile_image
+      end
+    end
+
+    context "with an existing CarrierWave image" do
+      let(:record) { create_with_legacy_profile_image(factory, jpg) }
+      let!(:legacy_url) { record.profile_image_url }
+      let!(:legacy_identifier) { record[:profile_image] }
+      let!(:legacy_path) { legacy_profile_image_path(record) }
+
+      it "keeps displaying it, with the URL CarrierWave gave it" do
+        expect(legacy_url).to eq("/uploads/#{factory}/profile_image/#{record.id}/#{legacy_identifier}")
+        expect(File.exist?(legacy_path)).to be(true)
+        expect(model.find(record.id).profile_image_url).to eq(legacy_url)
+        expect(record.profile_image_url_for(length: 90)).to eq(legacy_url)
+        expect(record.profile_image_90).to eq(legacy_url)
+        expect(record.profile_image.url).to eq(legacy_url)
+        expect(record.legacy_profile_image.url).to eq(legacy_url)
+        expect(record.profile_image_file).not_to be_attached
+      end
+
+      it "keeps displaying it for records loaded with only some columns" do
+        expect(model.select(:id, :profile_image).find(record.id).profile_image_url).to eq(legacy_url)
+      end
+
+      it "doesn't touch it when other attributes are updated" do
+        record.update!(name: "A new name")
+
+        expect(record.reload[:profile_image]).to eq(legacy_identifier)
+        expect(record.profile_image_url).to eq(legacy_url)
+      end
+
+      it "stores a new image with Active Storage and leaves the CarrierWave one (column and file) alone" do
+        expect(File.exist?(legacy_path)).to be(true)
+
+        record.update!(profile_image: png)
+        record.reload
+
+        expect(record.profile_image_file).to be_attached
+        expect(record.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+        expect(record[:profile_image]).to eq(legacy_identifier)
+        expect(record.legacy_profile_image.url).to eq(legacy_url)
+        expect(File.exist?(legacy_path)).to be(true)
+      end
+
+      it "counts as a profile image (eg. for presence validations)" do
+        expect(record).to be_profile_image
+      end
+
+      it "doesn't count as a profile image once its file is gone, like with CarrierWave" do
+        File.delete(legacy_path)
+
+        expect(model.find(record.id)).not_to be_profile_image
+        expect(model.find(record.id).profile_image_url).to eq(legacy_url)
+      end
+
+      it "is serialized like before" do
+        expect(record.as_json["profile_image"]).to eq("url" => legacy_url)
+        expect(JSON.parse(record.to_json)["profile_image"]).to eq("url" => legacy_url)
+      end
+
+      it "removes it (column and file) when the image is removed, like CarrierWave did" do
+        record.profile_image = nil
+        record.save!(validate: false) # organizations require an image
+
+        expect(record.reload[:profile_image]).to be_nil
+        expect(record.profile_image_url).to be_nil
+        expect(record).not_to be_profile_image
+        expect(File.exist?(legacy_path)).to be(false)
+      end
+
+      it "keeps its file until the removal is committed" do
+        model.transaction do
+          record.profile_image = ""
+          record.save!(validate: false)
+          expect(File.exist?(legacy_path)).to be(true)
+          raise ActiveRecord::Rollback
+        end
+
+        expect(model.find(record.id)[:profile_image]).to eq(legacy_identifier)
+        expect(File.exist?(legacy_path)).to be(true)
+      end
+
+      it "deletes its file when the record is destroyed, like CarrierWave did" do
+        record.destroy!
+
+        expect(File.exist?(legacy_path)).to be(false)
+      end
+
+      it "ignores strings, which used to be CarrierWave cache names" do
+        record.update!(profile_image: "https://images.example.com/avatar.png")
+
+        expect(record.reload[:profile_image]).to eq(legacy_identifier)
+        expect(record.profile_image_url).to eq(legacy_url)
+        expect(File.exist?(legacy_path)).to be(true)
+      end
+    end
+
+    context "with an Active Storage image" do
+      let(:record) { create(factory, profile_image: png) }
+
+      it "replaces it and purges the previous one" do
+        previous_blob = record.profile_image_file.blob
+        previous_url = record.profile_image_url
+
+        record.update!(profile_image: jpg)
+        record.reload
+
+        expect(record.profile_image_url).not_to eq(previous_url)
+        expect(record.profile_image_file.blob.content_type).to eq("image/jpeg")
+        expect(ActiveStorage::PurgeJob).to have_been_enqueued.with(previous_blob)
+      end
+
+      it "reports the change as a profile_image change" do
+        record.update!(profile_image: jpg)
+        expect(record.saved_change_to_profile_image?).to be(true)
+        expect(record.saved_change_to_attribute?(:profile_image)).to be(true)
+
+        record.update!(name: "A new name")
+        expect(record.saved_change_to_profile_image?).to be(false)
+      end
+
+      it "remembers the CarrierWave image it supersedes" do
+        expect(record.profile_image_file.blob.metadata["carrierwave_identifier"]).to eq(record[:profile_image].to_s)
+
+        legacy = create_with_legacy_profile_image(factory, jpg)
+        legacy.update!(profile_image: png)
+        expect(legacy.reload.profile_image_file.blob.metadata["carrierwave_identifier"]).to eq(legacy[:profile_image])
+      end
+
+      it "leaves the CarrierWave column as it is, so that the previous release displays it too" do
+        legacy = create_with_legacy_profile_image(factory, jpg)
+        identifier = legacy[:profile_image]
+        legacy.update!(profile_image: png)
+        legacy.reload
+
+        # The previous release displays the Active Storage image unless the column changed since it was stored
+        expect(legacy[:profile_image]).to eq(identifier)
+        expect(legacy.profile_image_file.blob.metadata["carrierwave_identifier"]).to eq(identifier)
+        expect(File.exist?(legacy_profile_image_path(legacy, identifier))).to be(true)
+      end
+
+      it "removes both images when the image is removed" do
+        legacy = create_with_legacy_profile_image(factory, jpg)
+        legacy_path = legacy_profile_image_path(legacy)
+        legacy.update!(profile_image: png)
+        blob = legacy.reload.profile_image_file.blob
+
+        legacy.profile_image = nil
+        legacy.save!(validate: false)
+        legacy.reload
+
+        expect(legacy.profile_image_file).not_to be_attached
+        expect(ActiveStorage::PurgeJob).to have_been_enqueued.with(blob)
+        expect(legacy[:profile_image]).to be_nil
+        expect(File.exist?(legacy_path)).to be(false)
+        expect(legacy.profile_image_url).to be_nil
+      end
+
+      it "gives way to a newer CarrierWave image, ie. one stored by code that doesn't know about Active Storage" do
+        legacy = create_with_legacy_profile_image(factory, jpg)
+        legacy.update!(profile_image: png)
+        expect(legacy.reload.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+
+        # eg. the release before Active Storage, after a rollback
+        store_legacy_profile_image(legacy, jpg)
+
+        expect(legacy.profile_image_url).to eq(legacy.legacy_profile_image.url)
+        expect(legacy.profile_image_url).to start_with("/uploads/#{factory}/profile_image/#{legacy.id}/")
+        expect(legacy.profile_image_90).to eq(legacy.profile_image_url)
+        expect(legacy.as_json["profile_image"]).to eq("url" => legacy.profile_image_url)
+      end
+
+      it "serializes the current image's URL, in the CarrierWave uploader's format" do
+        expect(record.as_json["profile_image"]).to eq("url" => record.profile_image_url)
+        expect(JSON.parse(record.to_json)["profile_image"]).to eq("url" => record.profile_image_url)
+        expect(record.profile_image.as_json).to eq("url" => record.profile_image_url)
+      end
+
+      it "uses it for records loaded with only some columns" do
+        expect(model.select(:id, :profile_image).find(record.id).profile_image_url).to eq(record.profile_image_url)
+      end
+
+      it "falls back to the CarrierWave image for records loaded without their id" do
+        partial = model.where(id: record.id).select(:profile_image).first
+
+        expect(partial.profile_image_url).to be_nil
+      end
+    end
+
+    context "with an invalid image" do
+      let(:record) { create(factory, profile_image: png) }
+
+      it "rejects files that aren't allowed images, with CarrierWave's errors" do
+        pdf = fixture_file_upload("800x600.pdf", "application/pdf")
+        expected_error = uploader_error(pdf)
+
+        expect(expected_error).to be_present
+        expect(record.update(profile_image: pdf)).to be(false)
