+require "rails_helper"
+
+RSpec.describe HasProfileImage::LegacyImage do
+  let(:user) { create_with_legacy_profile_image(:user) }
+
+  it "is the image CarrierWave stored, with the URL it gave it" do
+    image = user.legacy_profile_image
+
+    expect(image.identifier).to eq(user[:profile_image])
+    expect(image.url).to eq("/uploads/user/profile_image/#{user.id}/#{user[:profile_image]}")
+    expect(image).to exist
+    expect(image.read).to eq(File.binread(legacy_profile_image_path(user)))
+  end
+
+  it "has no file for columns that aren't CarrierWave files (eg. the URL banished users get)" do
+    user.update_columns(profile_image: Moderator::BanishUser::DEFAULT_PROFILE_IMAGE)
+    image = user.reload.legacy_profile_image
+
+    expect(image).not_to exist
+    expect(image.read).to be_nil
+  end
+
+  it "deletes its file" do
+    path = legacy_profile_image_path(user)
+
+    user.legacy_profile_image.delete
+
+    expect(File.exist?(path)).to be(false)
+  end
+
+  it "never deletes anything out of its record's directory" do
+    other = create_with_legacy_profile_image(:user)
+    other_path = legacy_profile_image_path(other)
+    user.update_columns(profile_image: "../#{other.id}/#{other[:profile_image]}")
+
+    user.reload.legacy_profile_image.delete
+    user.reload.destroy!
+
+    expect(File.exist?(other_path)).to be(true)
+  end
+
+  it "is nil without a CarrierWave image, or for records loaded without their id" do
+    expect(create(:user, profile_image: nil).legacy_profile_image).to be_nil
+    expect(User.where(id: user.id).select(:profile_image).first.legacy_profile_image).to be_nil
+  end
+end
