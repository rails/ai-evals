+
+      it "rejects files that are too large, with CarrierWave's errors" do
+        record
+        stub_const("ProfileImageUploader::MAX_FILE_SIZE", 2.kilobytes)
+
+        expect(record.update(profile_image: png)).to be(false)
+        expect(record.errors[:profile_image]).to include("File size should be less than 2 KB")
+        expect(record.errors.full_messages).to include("Profile image File size should be less than 2 KB")
+      end
+
+      it "keeps the current image" do
+        url = record.profile_image_url
+
+        expect do
+          record.update(profile_image: fixture_file_upload("800x600.pdf", "application/pdf"))
+        end.not_to change(ActiveStorage::Blob, :count)
+        expect(record.reload.profile_image_url).to eq(url)
+      end
+    end
+
+    context "when the upload fails" do
+      let(:record) { create(factory, profile_image: png) }
+
+      it "fails the save and keeps the current image" do
+        url = record.profile_image_url
+        allow(ActiveStorage::Blob.service).to receive(:upload).and_raise(Errno::ECONNRESET)
+
+        expect { record.update(profile_image: jpg) }.to raise_error(Errno::ECONNRESET)
+        expect(ActiveStorage::Blob.count).to eq(1)
+        expect(record.reload.profile_image_url).to eq(url)
+      end
+    end
+
+    context "with a remote image" do
+      let(:url) { "https://images.example.com/avatar.png" }
+
+      before do
+        stub_request(:get, url).to_return(
+          body: Rails.root.join("spec/fixtures/files/800x600.png").binread, headers: { "Content-Type" => "image/png" },
+        )
+      end
+
+      it "downloads it to Active Storage" do
+        record.remote_profile_image_url = url
+        expect(record.remote_profile_image_url).to eq(url)
+
+        record.save!
+        expect(record.reload.profile_image_file.blob.content_type).to eq("image/png")
+        expect(record.profile_image_url).to start_with("/rails/active_storage/blobs/proxy/")
+      end
+
+      it "reports download errors like CarrierWave" do
+        stub_request(:get, url).to_return(status: 404)
+        record.remote_profile_image_url = url
+
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image].join).to include("could not download file")
+      end
+
+      it "accepts a file (eg. Images::SafeRemoteProfileImageUrl's generated image)" do
+        record.remote_profile_image_url = Images::ProfileImageGenerator.call
+        record.save!
+
+        expect(record.reload.profile_image_file).to be_attached
+      end
+    end
+
+    context "when the Active Storage tables don't exist yet (eg. before the migration ran)" do
+      before { allow(HasProfileImage).to receive(:active_storage_available?).and_return(false) }
+
+      it "keeps displaying CarrierWave images, without querying Active Storage's tables", :aggregate_failures do
+        record = create_with_legacy_profile_image(factory, jpg)
+        queries = []
+        subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+          queries << payload[:sql]
+        end
+
+        record = model.find(record.id)
+        url = record.profile_image_url
+        record.profile_image_url_for(length: 90)
+        json = record.as_json
+        present = record.profile_image?
+
+        ActiveSupport::Notifications.unsubscribe(subscriber)
+        expect(queries.grep(/active_storage/)).to be_empty
+        expect(url).to eq("/uploads/#{factory}/profile_image/#{record.id}/#{record[:profile_image]}")
+        expect(json["profile_image"]).to eq("url" => url)
+        expect(present).to be(true)
+      end
+    end
+
+    context "when the copy attaches an image after the current one was loaded" do
