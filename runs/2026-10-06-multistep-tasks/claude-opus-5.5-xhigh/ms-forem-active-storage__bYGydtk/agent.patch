+    get user.profile_image_url
+
+    expect(user.profile_image_url).to start_with("/uploads/user/profile_image/#{user.id}/")
+    expect(response).to have_http_status(:ok)
+    expect(response.body).to eq(File.binread(legacy_profile_image_path(user)))
+  end
+
+  it "gives the uploaded image's URL back to the onboarding, like CarrierWave did" do
+    user = create(:user)
+    sign_in user
+
+    put "/users/#{user.id}", params: { user: { profile_image: fixture_file_upload("800x600.png", "image/png") } },
+                             headers: { "Accept" => "application/json" }
+
+    expect(response).to have_http_status(:ok)
+    url = response.parsed_body.dig("user", "profile_image", "url")
+    expect(url).to eq(user.reload.profile_image_url)
