diff --git a/app/jobs/room/bot_mention_job.rb b/app/jobs/room/bot_mention_job.rb
new file mode 100644
index 0000000..a894f8f
--- /dev/null
+++ b/app/jobs/room/bot_mention_job.rb
@@ -0,0 +1,21 @@
+class Room::BotMentionJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(room, message)
+    # Find bots mentioned in this message that have a webhook configured.
+    # mentionees is already scoped to room members; exclude the author itself
+    # to avoid a bot triggering its own webhook on self-mentions.
+    bots = message.mentionees.bots.active.with_webhook.where.not(id: message.creator_id)
+
+    bots.find_each do |bot|
+      begin
+        Room::BotWebhookNotifier.new(room: room, message: message, bot: bot).notify
+      rescue StandardError => e
+        Rails.logger.warn "BotMentionJob failed for bot #{bot.id}: #{e.class} #{e.message}"
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    # Room or message deleted before job ran — nothing to do.
+    nil
+  end
+end
