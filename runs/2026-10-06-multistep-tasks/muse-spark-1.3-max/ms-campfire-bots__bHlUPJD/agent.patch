+++ b/app/jobs/room/bot_joined_job.rb
@@ -0,0 +1,19 @@
+class Room::BotJoinedJob < ApplicationJob
+  self.enqueue_after_transaction_commit = true
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(room, bot)
+    return if room.direct?
+    return unless bot.bot? && bot.active? && bot.webhook_url.present?
+    return if bot.suspended?
+
+    Room::BotWebhookNotifier.new(room: room, bot: bot).notify_joined
+  rescue ActiveRecord::RecordNotFound
+    # Room or bot deleted before job ran — nothing to do.
+    nil
+  rescue StandardError => e
+    Rails.logger.warn "BotJoinedJob failed for bot #{bot.id} in room #{room.id}: #{e.class} #{e.message}"
+    nil
+  end
+end
diff --git a/app/jobs/room/bot_mention_job.rb b/app/jobs/room/bot_mention_job.rb
new file mode 100644
index 0000000..ab0abf7
--- /dev/null
+++ b/app/jobs/room/bot_mention_job.rb
@@ -0,0 +1,22 @@
+class Room::BotMentionJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(room, message)
+    # Find bots mentioned in this message that have a webhook configured.
+    # mentionees is already scoped to room members; exclude the author itself
+    # to avoid a bot triggering its own webhook on self-mentions.
+    # Suspended bots receive no webhooks.
+    bots = message.mentionees.bots.active.not_suspended.with_webhook.where.not(id: message.creator_id)
+
+    bots.find_each do |bot|
+      begin
+        Room::BotWebhookNotifier.new(room: room, message: message, bot: bot).notify
+      rescue StandardError => e
+        Rails.logger.warn "BotMentionJob failed for bot #{bot.id}: #{e.class} #{e.message}"
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    # Room or message deleted before job ran — nothing to do.
+    nil
+  end
+end
