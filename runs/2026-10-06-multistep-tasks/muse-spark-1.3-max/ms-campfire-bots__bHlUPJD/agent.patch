+<% @page_title = "Chat bots" %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to_last_room_visited %>
+  </div>
+<% end %>
+
+<section class="panel txt-align-center flex flex-column gap" style="view-transition-name: bots">
+  <h1 class="txt-x-large margin-none">Chat bots</h1>
+
+  <% if @reached_bot_limit %>
+    <p class="txt-subtle">You have reached the limit of <%= @bot_limit %> bots per member. Delete a bot to add a new one.</p>
+  <% else %>
+    <div>
+      <%= link_to "Add a chat bot", new_bot_path, class: "btn btn--reversed center" %>
+    </div>
+  <% end %>
+
+  <div class="margin-block pad-inline pad-block fill-shade border-radius">
+    <% if @bots.any? %>
+      <menu class="flex flex-column gap margin-none pad">
+        <% @bots.each do |bot| %>
+          <li class="flex align-center gap margin-none">
+            <figure class="avatar flex-item-no-shrink" style="--avatar-size: 3.75ch;">
+              <%= image_tag fresh_user_avatar_path(bot), aria: { hidden: "true" }, size: 48, loading: :lazy %>
+            </figure>
+
+            <div class="min-width txt-align-start">
+              <div class="overflow-ellipsis"><strong><%= bot.name %></strong></div>
+              <% if bot.suspended? %>
+                <div class="txt-small txt-negative"><span>Suspended</span> — <%= bot.suspension_reason_text %></div>
+              <% end %>
+              <label class="flex flex-column gap txt-small" style="--row-gap: 0.25rem;">
+                <span>Bot code</span>
+                <input type="text" readonly value="<%= bot.bot_token %>" aria-label="Bot code" class="input input--transparent" onclick="this.select()" style="font-family: monospace;">
+              </label>
+            </div>
+
+            <hr class="separator" aria-hidden="true">
+
+            <% if bot.suspended? && Current.user.administrator? %>
+              <%= button_to "Reactivate", reactivate_bot_path(bot), method: :post, class: "btn txt-small flex-item-no-shrink",
+                    data: { turbo_confirm: "Are you sure you want to reactivate this bot?" } %>
+            <% end %>
+            <%= link_to "Edit #{bot.name}", edit_bot_path(bot), class: "btn txt-small flex-item-no-shrink" %>
+          </li>
+        <% end %>
+      </menu>
+    <% else %>
+      <p class="txt-subtle">No chat bots yet.</p>
+    <% end %>
+  </div>
+</section>
