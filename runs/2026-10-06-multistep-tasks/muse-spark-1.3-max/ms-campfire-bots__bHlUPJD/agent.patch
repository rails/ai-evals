+  def reactivate_bot!
+    update!(
+      bot_suspended_at: nil,
+      bot_suspension_reason: nil,
+      bot_cooldown_until: nil,
+      bot_cooldown_attempts: 0,
+      bot_consecutive_failures: 0,
+      bot_rate_limit_reset_at: Time.current
+    )
+  end
+
+  def recent_bot_message_count
+    window_start = BOT_RATE_LIMIT_WINDOW.ago
+    if bot_rate_limit_reset_at.present? && bot_rate_limit_reset_at > window_start
+      window_start = bot_rate_limit_reset_at
+    end
+    messages.where("messages.created_at > ?", window_start).count
+  end
+
+  def check_bot_post_allowed!
+    with_lock do
+      return :suspended if suspended?
+
+      if in_bot_cooldown?
+        new_attempts = bot_cooldown_attempts.to_i + 1
+        update!(bot_cooldown_attempts: new_attempts)
+        if new_attempts >= (1 + BOT_COOLDOWN_SUSPEND_AFTER_ATTEMPTS)
+          suspend_bot!(BOT_SUSPENSION_REASON_RATE_LIMIT) unless suspended?
+        end
+        return :in_cooldown
+      end
+
+      if bot_cooldown_until.present?
+        update!(bot_cooldown_until: nil, bot_cooldown_attempts: 0)
+      end
+
+      if recent_bot_message_count >= BOT_RATE_LIMIT_COUNT
+        update!(bot_cooldown_until: BOT_COOLDOWN_DURATION.from_now, bot_cooldown_attempts: 1)
+        return :rate_limited
+      end
+
+      :allowed
+    end
+  end
+
+  def record_bot_delivery_success!
+    with_lock do
+      return if suspended?
+      update!(bot_consecutive_failures: 0) if bot_consecutive_failures.to_i != 0
+    end
+  rescue ActiveRecord::RecordNotFound
+    nil
+  end
+
+  def record_bot_delivery_failure!
+    with_lock do
+      return if suspended?
+      new_count = bot_consecutive_failures.to_i + 1
+      if new_count >= BOT_MAX_CONSECUTIVE_FAILURES
+        update!(bot_consecutive_failures: new_count)
+        suspend_bot!(BOT_SUSPENSION_REASON_WEBHOOK_FAILURES)
+      else
+        update!(bot_consecutive_failures: new_count)
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    nil
+  end
+
   private
+    def creator_within_bot_limit
+      return if created_by.nil? || created_by.administrator?
+
+      limit = self.class.bots_per_member_limit
+      count = self.class.bots.where(created_by_id: created_by_id).count
+      if count >= limit
+        errors.add(:base, "You have reached the limit of #{limit} bots per member")
+      end
+    end
+
+    def webhook_url_must_be_valid_http_url
+      uri = URI.parse(webhook_url)
+      unless uri.is_a?(URI::HTTP) && uri.host.present?
+        errors.add(:webhook_url, "must be a valid HTTP(S) URL")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:webhook_url, "must be a valid HTTP(S) URL")
+    end
+
+    def generate_bot_token
+      self.bot_token ||= loop do
+        token = SecureRandom.hex(24)
+        break token unless self.class.exists?(bot_token: token)
+      end
+    end
+
     def grant_membership_to_open_rooms
-      Membership.insert_all(Rooms::Open.pluck(:id).collect { |room_id| { room_id: room_id, user_id: id } })
+      if human?
+        Membership.insert_all(Rooms::Open.pluck(:id).collect { |room_id| { room_id: room_id, user_id: id } })
+      elsif add_to_all_open_rooms?
+        join_all_open_rooms
+      end
+    end
+
+    def grant_missing_open_rooms_if_add_to_all_enabled
+      return unless bot?
+      return unless saved_change_to_add_to_all_open_rooms? && add_to_all_open_rooms?
+
+      join_all_open_rooms
+    end
+
+    def join_all_open_rooms
+      Rooms::Open.find_each do |room|
+        room.memberships.grant_to(self)
+      end
     end
 
