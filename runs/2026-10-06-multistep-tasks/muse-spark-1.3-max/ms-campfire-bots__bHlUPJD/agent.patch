diff --git a/app/models/room/bot_webhook_notifier.rb b/app/models/room/bot_webhook_notifier.rb
new file mode 100644
index 0000000..8003deb
--- /dev/null
+++ b/app/models/room/bot_webhook_notifier.rb
@@ -0,0 +1,197 @@
+require "net/http"
+require "uri"
+require "json"
+
+class Room::BotWebhookNotifier
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  attr_reader :room, :message, :bot
+
+  def initialize(room:, bot:, message: nil)
+    @room, @bot, @message = room, bot, message
+  end
+
+  def notify
+    return unless message.present?
+    begin
+      bot.reload
+    rescue ActiveRecord::RecordNotFound
+      return
+    end
+    return unless bot.webhook_url.present? && bot.bot_token.present?
+    return if bot.suspended?
+
+    payload = build_payload
+    begin
+      response = post_payload(payload)
+    rescue StandardError => e
+      Rails.logger.warn "Bot webhook failed for bot #{bot.id} (#{bot.webhook_url}): #{e.class} #{e.message}"
+      record_delivery_failure
+      return nil
+    end
+    handle_response(response)
+  rescue StandardError => e
+    Rails.logger.warn "Bot webhook failed for bot #{bot.id} (#{bot.webhook_url}): #{e.class} #{e.message}"
+    nil
+  end
+
+  def notify_joined
+    return if room.direct?
+    begin
+      bot.reload
+    rescue ActiveRecord::RecordNotFound
+      return
+    end
+    return unless bot.webhook_url.present? && bot.bot_token.present?
+    return if bot.suspended?
+
+    payload = build_joined_payload
+    begin
+      response = post_payload(payload)
+    rescue StandardError => e
+      Rails.logger.warn "Bot webhook failed for bot #{bot.id} (#{bot.webhook_url}): #{e.class} #{e.message}"
+      record_delivery_failure
+      return nil
+    end
+    handle_response(response)
+  rescue StandardError => e
+    Rails.logger.warn "Bot webhook failed for bot #{bot.id} (#{bot.webhook_url}): #{e.class} #{e.message}"
+    nil
+  end
+
+  private
+    def bot_suspended?
+      bot.suspended?
+    rescue ActiveRecord::RecordNotFound
+      true
+    end
+
+    def record_delivery_success
+      bot.record_bot_delivery_success!
+    rescue StandardError => e
+      Rails.logger.warn "Failed to record delivery success for bot #{bot.id}: #{e.class} #{e.message}"
+      nil
+    end
+
+    def record_delivery_failure
+      bot.record_bot_delivery_failure!
+    rescue StandardError => e
+      Rails.logger.warn "Failed to record delivery failure for bot #{bot.id}: #{e.class} #{e.message}"
+      nil
+    end
+
+    def build_payload
+      {
+        event: "mention",
+        author: { id: message.creator.id, name: message.creator.name },
+        room: { id: room.id, name: room.name, reply_to: reply_to_path },
+        message: {
+          id: message.id,
+          body: {
+            text: stripped_text,
+            html: html_body
+          },
+          link: link_path
+        }
+      }
+    end
+
+    def build_joined_payload
+      {
+        event: "joined",
+        room: { id: room.id, name: room.name, reply_to: reply_to_path }
+      }
+    end
+
+    def stripped_text
+      text = message.plain_text_body.to_s
+      # Strip the bot's own @-mention so text reads as command addressed to bot.
+      # Mention representation is "@#{name}" (see User::Mentionable).
+      text.gsub("@#{bot.name}", "").strip.gsub(/[ \t]{2,}/, " ").strip
+    end
+
+    def html_body
+      message.body.to_s
+    end
+
+    def reply_to_path
+      Rails.application.routes.url_helpers.room_bot_messages_path(room.id, bot.bot_token)
+    end
+
+    def link_path
+      Rails.application.routes.url_helpers.room_at_message_path(room, message)
+    end
+
+    def post_payload(payload)
+      uri = URI.parse(bot.webhook_url)
+      raise URI::InvalidURIError, "webhook URL must be HTTP(S)" unless uri.is_a?(URI::HTTP) && uri.host.present?
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = (uri.scheme == "https")
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request["Content-Type"] = "application/json"
+      request.body = JSON.generate(payload)
+
+      http.request(request)
+    end
+
+    def handle_response(response)
+      return if response.nil?
+
+      status = response.code.to_i
+      if status >= 200 && status < 300
+        record_delivery_success
+        case status
+        when 200
+          handle_ok_response(response)
+        when 204
+          # No message to post.
+          nil
+        else
+          # Other 2xx: successful delivery, no sync reply.
+          nil
+        end
+      else
+        record_delivery_failure
+        Rails.logger.info "Bot webhook for bot #{bot.id} returned #{response.code}, ignoring"
+        nil
+      end
+    end
+
+    def handle_ok_response(response)
+      content_type = response["Content-Type"].to_s.downcase
+
+      # Spec: 200 with text/plain or text/html → post body as bot's message.
+      # Be lenient about missing content-type (treat as plain text).
+      return unless content_type.blank? || content_type.include?("text/plain") || content_type.include?("text/html")
+
+      body = response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+      return if body.strip.blank?
+
+      # Suspended bots post nothing (receives no webhooks, but double-check for race).
+      begin
+        bot.reload
+      rescue ActiveRecord::RecordNotFound
+        return
+      end
+      return if bot.suspended?
+
+      # Don't post if bot is no longer a member (mirrors BotMessagesController).
+      return unless room.memberships.exists?(user_id: bot.id)
+
+      # Flood control: webhook replies count toward rate limit and respect cooldown.
+      # During cooldown, replies are suppressed (and count toward suspension).
+      allowed = bot.check_bot_post_allowed!
+      return unless allowed == :allowed
+
+      new_message = room.messages.create!(creator: bot, body: body)
+      new_message.broadcast_create
+    rescue StandardError => e
+      Rails.logger.warn "Failed to post bot sync reply for bot #{bot.id}: #{e.class} #{e.message}"
+      nil
+    end
+end
