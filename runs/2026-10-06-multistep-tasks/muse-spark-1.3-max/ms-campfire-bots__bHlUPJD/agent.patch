new file mode 100644
index 0000000..9eceaea
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,86 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy reactivate ]
+  before_action :ensure_within_bot_limit, only: %i[ new create ]
+
+  def index
+    @bots = bots_scope.ordered
+    @reached_bot_limit = bot_limit_reached?
+    @bot_limit = bot_limit
+  end
+
+  def new
+    @bot = User.new(bot: true)
+  end
+
+  def create
+    @bot = User.new(bot_params.merge(bot: true, created_by: Current.user, password: SecureRandom.hex(32)))
+
+    if @bot.save
+      redirect_to bots_url, notice: "✓"
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url, notice: "✓"
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.destroy!
+    redirect_to bots_url, notice: "✓"
+  end
+
+  def reactivate
+    unless Current.user.administrator?
+      head :forbidden and return
+    end
+
+    unless @bot.suspended?
+      redirect_to bots_url and return
+    end
+
+    @bot.reactivate_bot!
+    redirect_to bots_url, notice: "✓"
+  end
+
+  private
+    def set_bot
+      @bot = bots_scope.find_by(id: params[:id])
+      head :not_found if @bot.nil?
+    end
+
+    def bots_scope
+      if Current.user.administrator?
+        User.bots.active
+      else
+        User.bots.active.where(created_by: Current.user)
+      end
+    end
+
+    def bot_params
+      key = params.key?(:bot) ? :bot : :user
+      params.require(key).permit(:name, :avatar, :webhook_url, :add_to_all_open_rooms)
+    end
+
+    def ensure_within_bot_limit
+      if bot_limit_reached?
+        redirect_to bots_url, alert: "You have reached the limit of #{bot_limit} bots per member."
+      end
+    end
+
+    def bot_limit_reached?
+      !Current.user.administrator? && User.bots.where(created_by: Current.user).count >= bot_limit
+    end
+
+    def bot_limit
+      Current.account.settings.bots_per_member || 5
+    end
+end
