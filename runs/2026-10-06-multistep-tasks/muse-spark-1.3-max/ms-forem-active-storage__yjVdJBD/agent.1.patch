+  def profile_image_presence
+    # Accept either the legacy CarrierWave image or the new Active Storage attachment.
+    attachment = profile_image
+    if attachment.respond_to?(:attached?) && attachment.attached?
+      return
+    end
+    # Handle specs that stub profile_image with a File (not Attached::One).
+    if attachment.is_a?(File) || (attachment.respond_to?(:present?) && !attachment.respond_to?(:attached?) && attachment.present?)
+      return
+    end
+    # carrierwave_profile_image reads the legacy string column via mount_on.
+    if carrierwave_profile_image.present? && carrierwave_profile_image_url.present?
+      return
+    end
+    # Fall back to raw column for records selected without attachment preloading.
+    if self[:profile_image].present?
+      return
+    end
+    errors.add(:profile_image, :blank)
+  end
