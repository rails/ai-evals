diff --git a/app/models/concerns/profile_image_migratable.rb b/app/models/concerns/profile_image_migratable.rb
new file mode 100644
index 0000000..10a1cef
--- /dev/null
+++ b/app/models/concerns/profile_image_migratable.rb
@@ -0,0 +1,399 @@
+# Handles the incremental migration of profile images from CarrierWave to Active Storage.
+#
+# - Existing CarrierWave images stay where they are (read via +carrierwave_profile_image+).
+# - New uploads go to Active Storage via +profile_image+ (has_one_attached).
+# - +profile_image_url+ prefers Active Storage when attached, falling back to CarrierWave.
+#
+# Other uploaders (cover images, badges, etc.) stay on CarrierWave.
+module ProfileImageMigratable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one_attached :profile_image
+
+    # Keep CarrierWave mounted for reading existing images. It serializes to the
+    # same +profile_image+ string column via +mount_on+, leaving the +profile_image+
+    # method namespace free for Active Storage.
+    # NOTE: store_dir is overridden to preserve the original CarrierWave path
+    # (uploads/<model>/profile_image/<id>) since mounted_as is now different.
+    mount_uploader :carrierwave_profile_image, ProfileImageUploader, mount_on: :profile_image do
+      def store_dir
+        "uploads/#{model.class.to_s.underscore}/profile_image/#{model.id}"
+      end
+    end
+
+    validate :validate_profile_image_attachment
+
+    attr_accessor :profile_image_changed_by_active_storage
+    attr_accessor :remote_profile_image_url_value
+  end
+
+  # Returns true when the Active Storage attachment was changed in memory
+  # (via +profile_image=+ or +remote_profile_image_url=+). Used to detect
+  # changes that don't touch the +profile_image+ string column.
+  def profile_image_changed_by_active_storage?
+    !!profile_image_changed_by_active_storage
+  end
+
+  # Prefer Active Storage when attached, otherwise fall back to the existing
+  # CarrierWave image. Never breaks images that are visible today.
+  def profile_image_url(*args)
+    attachment = profile_image
+    if attachment.respond_to?(:attached?) && attachment.attached?
+      begin
+        Rails.application.routes.url_helpers.rails_blob_path(profile_image, only_path: true)
+      rescue StandardError => e
+        Rails.logger.error("Failed to generate ActiveStorage profile image URL: #{e.message}")
+        carrierwave_profile_image_url(*args)
+      end
+    else
+      carrierwave_profile_image_url(*args)
+    end
+  end
+
+  # New uploads go to Active Storage.
+  # Nil/blank/String assignments clear (matching CarrierWave clearing behavior)
+  # without raising on invalid ActiveStorage signed_ids (e.g. mascot URL strings).
+  def profile_image=(attachable)
+    if attachable.nil? || (attachable.is_a?(String) && attachable.blank?)
+      self.profile_image_changed_by_active_storage = true
+      super("")
+      self.carrierwave_profile_image = nil
+      return
+    end
+
+    if attachable.is_a?(String)
+      self.profile_image_changed_by_active_storage = true
+      begin
+        super("")
+      rescue StandardError
+        nil
+      end
+      self.carrierwave_profile_image = nil
+      return
+    end
+
+    self.profile_image_changed_by_active_storage = true
+    processed = self.class.strip_exif_for_active_storage(attachable)
+    super(processed || attachable)
+  end
+
+  def save(*args, **kwargs, &block)
+    super
+  ensure
+    self.profile_image_changed_by_active_storage = false
+  end
+
+  def save!(*args, **kwargs, &block)
+    super
+  ensure
+    self.profile_image_changed_by_active_storage = false
+  end
+
+  def reload(*args, **kwargs, &block)
+    super
+  ensure
+    self.profile_image_changed_by_active_storage = false
+  end
+
+  # Compatibility getter for code/specs that read the assigned remote URL.
+  def remote_profile_image_url
+    remote_profile_image_url_value
+  end
+
+  # Download a remote URL and attach it to Active Storage (new uploads).
+  # Mirrors CarrierWave's +ignore_download_errors+ behavior: failures are logged,
+  # not raised, so authentication flows never break on avatar download issues.
+  def remote_profile_image_url=(url)
+    self.remote_profile_image_url_value = url
+    return if url.nil? || (url.is_a?(String) && url.blank?)
+
+    # SafeRemoteProfileImageUrl returns a File when the input isn't an http URL.
+    if !url.is_a?(String)
+      if url.respond_to?(:read) || url.respond_to?(:path) || url.respond_to?(:original_filename)
+        self.profile_image_changed_by_active_storage = true
+        begin
+          processed = self.class.strip_exif_for_active_storage(url)
+          profile_image.attach(processed || url)
+        rescue StandardError => e
+          Rails.logger.error("Failed to attach profile image from remote value: #{e.message}")
+          self.profile_image_changed_by_active_storage = false
+        end
+      end
+      return
+    end
+
+    unless url.start_with?("http")
+      return
+    end
+
+    begin
+      require "open-uri"
+      downloaded = URI.open(url)
+      begin
+        downloaded.rewind if downloaded.respond_to?(:rewind)
+        dl_size = downloaded.respond_to?(:size) ? downloaded.size : downloaded.read&.bytesize.to_i
+        downloaded.rewind if downloaded.respond_to?(:rewind)
+        if dl_size.nil? || dl_size.zero?
+          Rails.logger.info("Remote profile image download returned empty body for #{url}, skipping attach")
+          return
+        end
+      rescue StandardError
+        nil
+      end
+
+      self.profile_image_changed_by_active_storage = true
+      filename = begin
+        URI.parse(url).path.split("/").last.presence || "profile_image"
+      rescue URI::InvalidURIError
+        "profile_image"
+      end
+      filename = "profile_image" if filename.blank?
+      filename += ".jpg" unless filename.include?(".")
+
+      content_type = downloaded.respond_to?(:content_type) ? downloaded.content_type : nil
+      begin
+        processed_io = self.class.strip_exif_io(downloaded, filename)
+        if processed_io
+          profile_image.attach(io: processed_io, filename: filename, content_type: content_type || "image/jpeg")
+        else
+          downloaded.rewind if downloaded.respond_to?(:rewind)
+          profile_image.attach(io: downloaded, filename: filename, content_type: content_type || "image/jpeg")
+        end
+      rescue StandardError => attach_error
+        Rails.logger.error("Failed to attach downloaded profile image: #{attach_error.message}")
+        self.profile_image_changed_by_active_storage = false
+      end
+    rescue StandardError => e
+      Rails.logger.error("Failed to download remote profile image from #{url}: #{e.message}")
+      self.profile_image_changed_by_active_storage = false
+    end
+  end
+
+  def profile_image_identifier
+    carrierwave_profile_image_identifier
+  end
+
+  def profile_image_cache
+    carrierwave_profile_image_cache
+  end
+
+  def profile_image_cache=(value)
+    self.carrierwave_profile_image_cache = value
+  end
+
+  def profile_image_integrity_error
+    carrierwave_profile_image_integrity_error
+  end
+
+  def profile_image_processing_error
+    carrierwave_profile_image_processing_error
+  end
+
+  def profile_image_download_error
+    carrierwave_profile_image_download_error
+  end
+
+  def profile_image_integrity_errors
+    carrierwave_profile_image_integrity_errors
+  end
+
+  def profile_image_processing_errors
+    carrierwave_profile_image_processing_errors
+  end
+
+  def profile_image_download_errors
+    carrierwave_profile_image_download_errors
+  end
+
+  # Avoid serializing Attached::One directly (causes SystemStackError via
+  # record -> attachment -> record recursion). Return the URL string instead,
+  # matching API docs (profile_image as string URL).
+  def serializable_hash(options = nil)
+    hash = super
+    if hash.key?("profile_image") || hash.key?(:profile_image)
+      begin
+        url = profile_image_url
+      rescue StandardError
+        url = nil
+      end
+      hash["profile_image"] = url if hash.key?("profile_image")
+      hash[:profile_image] = url if hash.key?(:profile_image)
+    end
+    hash
+  end
+
+  private
+
+  def validate_profile_image_attachment
+    attachment = profile_image
+    # Handle specs that stub profile_image with a File (not Attached::One).
+    return unless attachment.respond_to?(:attached?) && attachment.attached?
+    return unless attachment.respond_to?(:blob)
+    blob = attachment.blob
+    return unless blob
+
+    max_size = ProfileImageUploader::MAX_FILE_SIZE
+    min_size = 1
+    if blob.byte_size > max_size
+      max_human = ActiveSupport::NumberHelper.number_to_human_size(max_size)
+      errors.add(:profile_image, I18n.t("errors.messages.max_size_error", max_size: max_human))
+    elsif blob.byte_size < min_size
+      min_human = ActiveSupport::NumberHelper.number_to_human_size(min_size)
+      errors.add(:profile_image, I18n.t("errors.messages.min_size_error", min_size: min_human))
+    end
+
+    allowlist = BaseUploader::EXTENSION_ALLOWLIST
+    filename_str = blob.filename.to_s
+    ext = File.extname(filename_str).delete_prefix(".").downcase
+    unless allowlist.any? { |item| ext.match?(/\A#{item}\z/i) }
+      errors.add(
+        :profile_image,
+        I18n.t(
+          "errors.messages.extension_allowlist_error",
+          extension: ext.inspect,
+          allowed_types: Array(allowlist).join(", "),
+        ),
+      )
+    end
+
+    begin
+      self.class.validate_frame_count_for_blob(blob)
+    rescue CarrierWave::IntegrityError => e
+      errors.add(:profile_image, e.message)
+    rescue StandardError
+      nil
+    end
+  end
+
+  class_methods do
+    def strip_exif_for_active_storage(uploadable)
+      begin
+        return nil unless ProfileImageUploader.enable_processing
+      rescue StandardError
+        nil
+      end
+
+      path = nil
+      original_filename = nil
+      content_type = nil
+
+      if uploadable.respond_to?(:path) && uploadable.path && File.exist?(uploadable.path.to_s)
+        path = uploadable.path.to_s
+        original_filename = uploadable.respond_to?(:original_filename) ? uploadable.original_filename : File.basename(path)
+        content_type = uploadable.respond_to?(:content_type) ? uploadable.content_type : nil
+      elsif uploadable.is_a?(Hash) && uploadable[:io]
+        return nil
+      else
+        return nil
+      end
+
+      if content_type&.include?("svg") || original_filename.to_s.downcase.end_with?(".svg")
+        return nil
+      end
+
+      begin
+        require "mini_magick"
+        # Copy to tempfile FIRST to avoid modifying the original file in place
+        # (e.g. factory fixtures under app/assets/images must not be mutated).
+        ext = File.extname(original_filename.to_s).presence || ".jpg"
+        tempfile = Tempfile.new(["profile_image_processed", ext])
+        tempfile.binmode
+        FileUtils.cp(path, tempfile.path)
+        tempfile.rewind
+
+        image = MiniMagick::Image.new(tempfile.path)
+        image.auto_orient
+        begin
+          image.strip unless image.frames.count > BaseUploader::FRAME_STRIP_MAX
+        rescue StandardError
+          image.strip
+        end
+        tempfile.rewind
+
+        content_type ||= begin
+          Marcel::MimeType.for(Pathname.new(tempfile.path))
+        rescue StandardError
+          "image/jpeg"
+        end
+
+        if defined?(ActionDispatch::Http::UploadedFile) && uploadable.is_a?(ActionDispatch::Http::UploadedFile)
+          ActionDispatch::Http::UploadedFile.new(
+            tempfile: tempfile,
+            filename: original_filename,
+            type: content_type,
+          )
+        else
+          Rack::Test::UploadedFile.new(tempfile.path, content_type, true, original_filename: original_filename)
+        end
+      rescue StandardError => e
+        Rails.logger.error("Error stripping EXIF for ActiveStorage profile image: #{e}")
+        nil
+      end
+    end
+
+    def strip_exif_io(downloaded_io, filename)
+      return nil if filename.to_s.downcase.end_with?(".svg")
+      begin
+        return nil unless ProfileImageUploader.enable_processing
+      rescue StandardError
+        nil
+      end
+
+      begin
+        require "mini_magick"
+        require "tempfile"
+        downloaded_io.rewind if downloaded_io.respond_to?(:rewind)
+        data = downloaded_io.read
+        return nil if data.nil? || data.empty?
+
+        tempfile = Tempfile.new(["remote_profile_image", File.extname(filename.to_s)])
+        tempfile.binmode
+        tempfile.write(data)
+        tempfile.rewind
+
+        image = MiniMagick::Image.new(tempfile.path)
+        image.auto_orient
+        begin
+          image.strip unless image.frames.count > BaseUploader::FRAME_STRIP_MAX
+        rescue StandardError
+          image.strip
+        end
+
+        processed_data = File.binread(image.path)
+        tempfile.close
+        tempfile.unlink
+        StringIO.new(processed_data)
+      rescue StandardError => e
+        Rails.logger.error("Error stripping EXIF for remote profile image: #{e}")
+        nil
+      end
+    end
+
+    def validate_frame_count_for_blob(blob)
+      begin
+        return unless ProfileImageUploader.enable_processing
+      rescue StandardError
+        nil
+      end
+      return unless blob.byte_size.positive?
+
+      begin
+        require "mini_magick"
+        blob.open do |file|
+          frames = MiniMagick::Image.new(file.path).frames.count
+          if frames > BaseUploader::FRAME_MAX
+            raise CarrierWave::IntegrityError,
+                  I18n.t("uploaders.base_uploader.too_many_frames", frame_max: BaseUploader::FRAME_MAX)
+          end
+        end
+      rescue CarrierWave::IntegrityError
+        raise
+      rescue Timeout::Error
+        raise CarrierWave::IntegrityError, I18n.t("uploaders.base_uploader.timeout")
+      rescue StandardError
+        nil
+      end
+    end
+  end
+end
