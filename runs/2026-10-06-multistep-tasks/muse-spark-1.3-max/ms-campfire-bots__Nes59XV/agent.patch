diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..9f0aaf2
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,164 @@
+class Bot < User
+  default_scope { where.not(bot_token: nil) }
+
+  # Flooding protection (fixed in code, no settings).
+  RATE_LIMIT_MAX_MESSAGES = 10
+  RATE_LIMIT_WINDOW = 10.seconds
+  RATE_LIMIT_COOLDOWN = 30.seconds
+  RATE_LIMIT_MAX_COOLDOWN_ATTEMPTS = 5
+
+  # Failing webhooks protection (fixed in code, no settings).
+  WEBHOOK_MAX_CONSECUTIVE_FAILURES = 10
+
+  SUSPENSION_REASON_FLOODING = "flooding"
+  SUSPENSION_REASON_FAILING_WEBHOOKS = "failing_webhooks"
+
+  before_validation :ensure_bot_token, on: :create
+  before_validation :ensure_random_password, on: :create
+  before_validation :normalize_webhook_url
+
+  validates :name, presence: true
+  validates :bot_token, presence: true, uniqueness: true
+  validates :bot_creator, presence: true
+  validate :webhook_url_must_be_http_url, if: -> { webhook_url.present? }
+  validate :creator_within_bot_limit, on: :create
+
+  scope :with_webhook, -> { where.not(webhook_url: nil).where.not(webhook_url: "") }
+
+  after_update_commit :grant_membership_to_all_open_rooms, if: -> { saved_change_to_join_all_open_rooms?(to: true) }
+
+  # Lets User::Role#can_administer? treat the bot's creator as its creator,
+  # so members can manage their own bots and admins can manage all.
+  def creator
+    bot_creator
+  end
+
+  def creator=(value)
+    self.bot_creator = value
+  end
+
+  def suspended_reason_text
+    case suspended_reason
+    when SUSPENSION_REASON_FLOODING then "Flooding"
+    when SUSPENSION_REASON_FAILING_WEBHOOKS, "webhook_failures" then "Failing webhooks"
+    when nil, "" then ""
+    else suspended_reason.to_s.humanize
+    end
+  end
+
+  def suspend!(reason)
+    update!(suspended_at: Time.current, suspended_reason: reason)
+  end
+
+  def reactivate!
+    update!(
+      suspended_at: nil,
+      suspended_reason: nil,
+      rate_limited_until: nil,
+      rate_limit_attempts: 0,
+      webhook_consecutive_failures: 0
+    )
+  end
+
+  def rate_limited?
+    rate_limited_until.present? && rate_limited_until > Time.current
+  end
+
+  def retry_after_seconds
+    return 0 unless rate_limited?
+    (rate_limited_until - Time.current).ceil.clamp(1, RATE_LIMIT_COOLDOWN.to_i)
+  end
+
+  def recent_bot_message_count
+    Message.where(creator_id: id).where("created_at > ?", RATE_LIMIT_WINDOW.ago).count
+  end
+
+  def flood_limit_exceeded?
+    recent_bot_message_count >= RATE_LIMIT_MAX_MESSAGES
+  end
+
+  def start_rate_limit_cooldown!
+    update!(rate_limited_until: RATE_LIMIT_COOLDOWN.from_now, rate_limit_attempts: 0)
+  end
+
+  def clear_rate_limit_if_expired!
+    if rate_limited_until.present? && rate_limited_until <= Time.current
+      update!(rate_limited_until: nil, rate_limit_attempts: 0)
+    end
+  end
+
+  # Records one attempt to post during an active cooldown.
+  # Returns true if this attempt suspends the bot.
+  def register_rate_limit_attempt!
+    return true if suspended?
+
+    increment!(:rate_limit_attempts)
+    if rate_limit_attempts >= RATE_LIMIT_MAX_COOLDOWN_ATTEMPTS
+      update!(suspended_at: Time.current, suspended_reason: SUSPENSION_REASON_FLOODING)
+      true
+    else
+      false
+    end
+  end
+
+  def record_webhook_success!
+    return if suspended?
+    return if webhook_consecutive_failures.to_i.zero?
+
+    update!(webhook_consecutive_failures: 0)
+  end
+
+  def record_webhook_failure!
+    return if suspended?
+
+    increment!(:webhook_consecutive_failures)
+    if webhook_consecutive_failures >= WEBHOOK_MAX_CONSECUTIVE_FAILURES
+      update!(suspended_at: Time.current, suspended_reason: SUSPENSION_REASON_FAILING_WEBHOOKS)
+    end
+  end
+
+  private
+    def grant_membership_to_all_open_rooms
+      return unless active?
+
+      Rooms::Open.find_each do |room|
+        room.memberships.grant_to(self)
+      end
+    end
+
+    def ensure_bot_token
+      self.bot_token ||= loop do
+        token = SecureRandom.hex(20)
+        break token unless User.unscoped.exists?(bot_token: token)
+      end
+    end
+
+    def ensure_random_password
+      self.password = SecureRandom.hex(32) if password_digest.blank?
+    end
+
+    def normalize_webhook_url
+      self.webhook_url = webhook_url.to_s.strip.presence
+    end
+
+    def webhook_url_must_be_http_url
+      uri = URI.parse(webhook_url)
+      unless uri.is_a?(URI::HTTP) && uri.host.present?
+        errors.add(:webhook_url, "must be a valid HTTP(S) URL")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:webhook_url, "must be a valid HTTP(S) URL")
+    end
+
+    def creator_within_bot_limit
+      return if bot_creator&.administrator?
+      return unless bot_creator
+
+      limit = bot_creator.bots_per_member_limit
+      existing = Bot.active.where(bot_creator_id: bot_creator_id).count
+
+      if existing >= limit
+        errors.add(:base, "You have reached the limit of #{limit} bots per member")
+      end
+    end
+end
diff --git a/app/models/bot/joined_webhook.rb b/app/models/bot/joined_webhook.rb
new file mode 100644
index 0000000..735b8e2
--- /dev/null
+++ b/app/models/bot/joined_webhook.rb
@@ -0,0 +1,133 @@
+require "net/http"
+require "uri"
+require "json"
+
+class Bot::JoinedWebhook
+  attr_reader :bot, :room
+
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  def initialize(bot:, room:)
+    @bot = bot
+    @room = room
+  end
+
+  def deliver
+    return if bot.webhook_url.blank?
+    return unless bot.active?
+    return if bot.suspended?
+    return if room.direct?
+
+    uri = URI.parse(bot.webhook_url)
+    return unless uri.is_a?(URI::HTTP) && uri.host.present?
+
+    response = post_json(uri, payload)
+
+    refresh_bot!
+    return unless @bot
+    return if @bot.suspended?
+
+    if response.nil?
+      @bot.record_webhook_failure!
+      return
+    end
+
+    code = response.code.to_i
+    if code >= 200 && code < 300
+      @bot.record_webhook_success!
+      handle_response(response)
+    else
+      @bot.record_webhook_failure!
+      nil
+    end
+  rescue URI::InvalidURIError => e
+    Rails.logger.warn "Bot joined webhook invalid URL for bot #{bot.id}: #{bot.webhook_url} (#{e})"
+    nil
+  rescue => e
+    Rails.logger.warn "Bot joined webhook failed for bot #{bot.id} to #{bot.webhook_url}: #{e.class} #{e.message}"
+    nil
+  end
+
+  def payload
+    {
+      event: "joined",
+      room: { id: room.id, name: room.name, reply_to: reply_to_path }
+    }
+  end
+
+  private
+    def refresh_bot!
+      fresh = Bot.find_by(id: bot.id)
+      @bot = fresh
+    end
+
+    def reply_to_path
+      Rails.application.routes.url_helpers.bot_room_messages_path(room, bot.bot_token)
+    end
+
+    def post_json(uri, payload)
+      Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT) do |http|
+        request = Net::HTTP::Post.new(uri.request_uri, "Content-Type" => "application/json")
+        request.body = payload.to_json
+        http.request(request)
+      end
+    rescue Net::OpenTimeout, Net::ReadTimeout, SocketError, SystemCallError, IOError, Timeout::Error, OpenSSL::SSL::SSLError => e
+      Rails.logger.warn "Bot joined webhook request failed for bot #{bot.id} to #{bot.webhook_url}: #{e.class} #{e.message}"
+      nil
+    end
+
+    def handle_response(response)
+      case response.code.to_i
+      when 204
+        nil
+      when 200
+        mime = response.content_type.to_s.split(";").first.to_s.strip.downcase
+        case mime
+        when "text/plain", "text/html"
+          body = response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+          return if body.blank?
+          post_reply(body, mime)
+        else
+          nil
+        end
+      else
+        nil
+      end
+    rescue => e
+      Rails.logger.warn "Bot joined webhook response handling failed for bot #{bot.id}: #{e.class} #{e.message}"
+      nil
+    end
+
+    def post_reply(body, mime)
+      # Bots must be members to post, mirroring Bots::MessagesController.
+      return unless bot.rooms.exists?(room.id)
+      return unless bot.active?
+      return if bot.suspended?
+
+      refresh_bot!
+      return unless @bot
+      return if @bot.suspended?
+      return unless @bot.active?
+      return unless @bot.rooms.exists?(room.id)
+
+      if @bot.rate_limited?
+        @bot.register_rate_limit_attempt!
+        return
+      else
+        @bot.clear_rate_limit_if_expired!
+        if @bot.flood_limit_exceeded?
+          @bot.start_rate_limit_cooldown!
+          return
+        end
+      end
+
+      html = mime == "text/plain" ? "<div>#{ERB::Util.html_escape(body)}</div>" : body
+
+      reply = room.messages.create!(creator: @bot, body: html)
+      reply.broadcast_create
+    rescue ActiveRecord::RecordInvalid => e
+      Rails.logger.warn "Bot joined webhook reply failed for bot #{bot.id}: #{e.message}"
+      nil
+    end
+end
diff --git a/app/models/bot/webhook.rb b/app/models/bot/webhook.rb
new file mode 100644
index 0000000..15d2016
--- /dev/null
+++ b/app/models/bot/webhook.rb
@@ -0,0 +1,159 @@
+require "net/http"
+require "uri"
+require "json"
+
+class Bot::Webhook
+  attr_reader :bot, :message
+
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  def initialize(bot:, message:)
+    @bot = bot
+    @message = message
+  end
+
+  def deliver
+    return if bot.webhook_url.blank?
+    return unless bot.active?
+    return if bot.suspended?
+
+    uri = URI.parse(bot.webhook_url)
+    return unless uri.is_a?(URI::HTTP) && uri.host.present?
+
+    response = post_json(uri, payload)
+
+    # Refresh bot state after the HTTP round-trip; the bot may have been
+    # suspended or rate-limited by concurrent API posts while we waited.
+    refresh_bot!
+    return unless @bot
+    return if @bot.suspended?
+
+    if response.nil?
+      # Timeout or connection error (post_json already logged).
+      @bot.record_webhook_failure!
+      return
+    end
+
+    code = response.code.to_i
+    if code >= 200 && code < 300
+      @bot.record_webhook_success!
+      handle_response(response)
+    else
+      @bot.record_webhook_failure!
+      nil
+    end
+  rescue URI::InvalidURIError => e
+    Rails.logger.warn "Bot webhook invalid URL for bot #{bot.id}: #{bot.webhook_url} (#{e})"
+    nil
+  rescue => e
+    Rails.logger.warn "Bot webhook failed for bot #{bot.id} to #{bot.webhook_url}: #{e.class} #{e.message}"
+    nil
+  end
+
+  def payload
+    room = message.room
+    {
+      event: "mention",
+      author: { id: message.creator.id, name: message.creator.name },
+      room: { id: room.id, name: room.name, reply_to: reply_to_path(room) },
+      message: {
+        id: message.id,
+        body: {
+          text: stripped_text,
+          html: html_body
+        },
+        link: message_link_path(room)
+      }
+    }
+  end
+
+  private
+    def refresh_bot!
+      fresh = Bot.find_by(id: bot.id)
+      @bot = fresh
+    end
+
+    def reply_to_path(room)
+      Rails.application.routes.url_helpers.bot_room_messages_path(room, bot.bot_token)
+    end
+
+    def message_link_path(room)
+      Rails.application.routes.url_helpers.room_at_message_path(room, message)
+    end
+
+    def stripped_text
+      plain = message.plain_text_body.to_s
+      plain.gsub("@#{bot.name}", "").squish
+    end
+
+    def html_body
+      message.body&.body&.to_html.to_s
+    end
+
+    def post_json(uri, payload)
+      Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT) do |http|
+        request = Net::HTTP::Post.new(uri.request_uri, "Content-Type" => "application/json")
+        request.body = payload.to_json
+        http.request(request)
+      end
+    rescue Net::OpenTimeout, Net::ReadTimeout, SocketError, SystemCallError, IOError, Timeout::Error, OpenSSL::SSL::SSLError => e
+      Rails.logger.warn "Bot webhook request failed for bot #{bot.id} to #{bot.webhook_url}: #{e.class} #{e.message}"
+      nil
+    end
+
+    def handle_response(response)
+      case response.code.to_i
+      when 204
+        nil
+      when 200
+        mime = response.content_type.to_s.split(";").first.to_s.strip.downcase
+        case mime
+        when "text/plain", "text/html"
+          body = response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+          return if body.blank?
+          post_reply(body, mime)
+        else
+          nil
+        end
+      else
+        nil
+      end
+    rescue => e
+      Rails.logger.warn "Bot webhook response handling failed for bot #{bot.id}: #{e.class} #{e.message}"
+      nil
+    end
+
+    def post_reply(body, mime)
+      room = message.room
+      # Bots must be members to post, mirroring Bots::MessagesController.
+      return unless bot.rooms.exists?(room.id)
+      return unless bot.active?
+      return if bot.suspended?
+
+      refresh_bot!
+      return unless @bot
+      return if @bot.suspended?
+      return unless @bot.active?
+      return unless @bot.rooms.exists?(room.id)
+
+      if @bot.rate_limited?
+        @bot.register_rate_limit_attempt!
+        return
+      else
+        @bot.clear_rate_limit_if_expired!
+        if @bot.flood_limit_exceeded?
+          @bot.start_rate_limit_cooldown!
+          return
+        end
+      end
+
+      html = mime == "text/plain" ? "<div>#{ERB::Util.html_escape(body)}</div>" : body
+
+      reply = room.messages.create!(creator: @bot, body: html)
+      reply.broadcast_create
+    rescue ActiveRecord::RecordInvalid => e
+      Rails.logger.warn "Bot webhook reply failed for bot #{bot.id}: #{e.message}"
+      nil
+    end
+end
