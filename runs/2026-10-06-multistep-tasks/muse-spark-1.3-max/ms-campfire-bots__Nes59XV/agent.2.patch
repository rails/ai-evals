diff --git a/app/jobs/room/bot_webhook_job.rb b/app/jobs/room/bot_webhook_job.rb
new file mode 100644
index 0000000..daafd01
--- /dev/null
+++ b/app/jobs/room/bot_webhook_job.rb
@@ -0,0 +1,13 @@
+class Room::BotWebhookJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bot, message)
+    # Re-find as Bot to ensure bot scoping (default_scope) and fresh webhook_url.
+    bot = Bot.find_by(id: bot.id)
+    return unless bot
+    return unless bot.active?
+    return if bot.webhook_url.blank?
+
+    Bot::Webhook.new(bot:, message:).deliver
+  end
+end
