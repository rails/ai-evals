--- /dev/null
+++ b/spec/support/model_optimizations.rb
@@ -0,0 +1,51 @@
+# frozen_string_literal: true
+
+# Model spec optimizations (see docs/test_optimization.md).
+#
+# 1. Fabrication: skip validations on `Fabricate` (save) for model specs,
+#    while still running `before_validation` callbacks (essential setup like
+#    set_uri, set_conversation, normalizations, etc.).
+#    - Validations are overhead for most model specs (17% of time in status_spec).
+#    - Validation tests themselves use `Fabricate.build` + `valid?`, not `Fabricate`,
+#      so they are unaffected (we only skip on `save`, not on `valid?`).
+#    - Specs that assert `Fabricate` raises for invalid records must opt-out
+#      via `:validations` tag (e.g., media_attachment size limit tests).
+#
+# This only affects `type: :model` specs without `:validations` tag.
+# Other spec types are untouched.
+
+module FabricationSkipValidationsForModels
+  def persist
+    if Thread.current[:skip_validations_for_model_specs]
+      # Run before_validation callbacks manually (they contain essential setup),
+      # then save without validations to skip expensive checks.
+      # No after_validation callbacks exist in app/models, so this is safe.
+      # Preserve validation_context so `on: :create` callbacks (e.g., Doorkeeper uid/secret) still run.
+      record = _instance
+      # validation_context accessor is private, use send
+      original_context = record.send(:validation_context) if record.respond_to?(:validation_context, true)
+      record.send(:validation_context=, :create) if record.respond_to?(:validation_context=, true) && record.new_record?
+      begin
+        record.run_callbacks(:validation) do
+          record.save!(validate: false)
+        end
+      ensure
+        record.send(:validation_context=, original_context) if record.respond_to?(:validation_context=, true)
+      end
+    else
+      super
+    end
+  end
+end
+
+Fabrication::Generator::Base.prepend(FabricationSkipValidationsForModels)
+
+RSpec.configure do |config|
+  config.before(:each, type: :model) do |example|
+    Thread.current[:skip_validations_for_model_specs] = !example.metadata[:validations]
+  end
+
+  config.after(:each, type: :model) do
+    Thread.current[:skip_validations_for_model_specs] = false
+  end
+end
