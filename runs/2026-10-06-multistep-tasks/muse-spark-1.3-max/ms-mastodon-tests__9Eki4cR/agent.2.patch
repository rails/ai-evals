diff --git a/spec/rails_helper.rb b/spec/rails_helper.rb
index a3040a4..e2d0d5d 100644
--- a/spec/rails_helper.rb
+++ b/spec/rails_helper.rb
@@ -120,6 +120,14 @@ RSpec.configure do |config|
     Sidekiq::Worker.clear_all
   end
 
+  config.before(:each, type: :request) do |example|
+    Sidekiq.testing!(:fake) unless example.metadata[:sidekiq_inline]
+  end
+
+  config.after(:each, type: :request) do
+    Sidekiq::Worker.clear_all
+  end
+
   # Optimize model specs: stub expensive operations not under test in models.
   # - ActivityTracker (redis) is only tested in spec/lib/admin/metrics, not in models (except one stubbed test in user_spec).
   # - DisallowedHashtagsValidator and StatusLengthValidator are only tested in spec/validators, not in models.
@@ -150,6 +158,29 @@ RSpec.configure do |config|
     end
   end
 
+  config.before(:each, type: :request) do |example|
+    unless example.metadata[:activity_tracker]
+      allow(ActivityTracker).to receive(:increment)
+      allow(ActivityTracker).to receive(:record)
+    end
+
+    unless example.metadata[:status_validators]
+      allow_any_instance_of(DisallowedHashtagsValidator).to receive(:validate)
+      allow_any_instance_of(StatusLengthValidator).to receive(:validate)
+    end
+
+    unless example.metadata[:approval_blocks]
+      allow(UsernameBlock).to receive(:matches?).and_wrap_original do |original, *args, **kwargs, &blk|
+        if kwargs[:allow_with_approval]
+          false
+        else
+          original.call(*args, **kwargs, &blk)
+        end
+      end
+      allow(EmailDomainBlock).to receive(:requires_approval?).and_return(false)
+    end
+  end
+
   config.before :each, type: :cli do
     stub_reset_connection_pools
   end
