diff --git a/app/models/game.rb b/app/models/game.rb
index 9960b61..66cd6c4 100644
--- a/app/models/game.rb
+++ b/app/models/game.rb
@@ -259,4 +259,107 @@ class Game < ApplicationRecord
     save!
     []
   end
+
+  # ---- Timer ----
+  # Effective total timer seconds for current question.
+  # Snapshot on game if present (set at each question open), else live quiz value.
+  # 0 = no timer.
+  def effective_timer_seconds
+    v = self[:timer_seconds]
+    unless v.nil?
+      n = v.to_i
+      return n < 0 ? 0 : n
+    end
+    begin
+      q = quiz
+      if q
+        if q.has_attribute?(:timer_minutes) && q.has_attribute?(:timer_seconds)
+          return q.timer_total_seconds.to_i
+        end
+      end
+    rescue StandardError
+    end
+    0
+  end
+
+  def timer_enabled?
+    effective_timer_seconds > 0
+  end
+
+  # Seconds remaining for the currently open question (ceil).
+  # Returns nil when no timer or not open.
+  # Uses Time.current - opened_at, so reloading never restarts it.
+  def timer_remaining_seconds(now = Time.current)
+    return nil unless status == "open"
+    total = effective_timer_seconds
+    return nil if total <= 0
+    opened = self[:opened_at]
+    return total if opened.nil?
+    begin
+      opened_time = opened.is_a?(String) ? Time.zone.parse(opened) : opened
+      opened_time ||= now
+      elapsed = now - opened_time
+      remaining = total - elapsed
+      return total if remaining > total
+      remaining.ceil
+    rescue StandardError
+      total
+    end
+  end
+
+  def timer_remaining_ms(now = Time.current)
+    return nil unless status == "open"
+    total = effective_timer_seconds
+    return nil if total <= 0
+    opened = self[:opened_at]
+    return total * 1000 if opened.nil?
+    begin
+      opened_time = opened.is_a?(String) ? Time.zone.parse(opened) : opened
+      opened_time ||= now
+      elapsed = now - opened_time
+      ((total - elapsed) * 1000).to_i
+    rescue StandardError
+      total * 1000
+    end
+  end
+
+  def timer_expired?(now = Time.current)
+    return false unless status == "open"
+    return false unless timer_enabled?
+    r = timer_remaining_seconds(now)
+    !r.nil? && r <= 0
+  end
+
+  # If open and timer expired, close the question (as if moderator clicked Finish).
+  # Returns true if it transitioned.
+  def expire_timer_if_needed!(now = Time.current)
+    return false unless status == "open"
+    return false unless timer_expired?(now)
+    now_ts = Time.current
+    affected = self.class.where(id: id, status: "open").update_all(status: "closed", updated_at: now_ts)
+    if affected > 0
+      self.status = "closed"
+      self.updated_at = now_ts
+      true
+    else
+      reload
+      false
+    end
+  rescue StandardError
+    false
+  end
+
+  def self.format_timer(total_seconds)
+    n = total_seconds.to_i
+    n = 0 if n < 0
+    m = n / 60
+    s = n % 60
+    format("%d:%02d", m, s)
+  end
+
+  def format_timer_remaining(now = Time.current)
+    r = timer_remaining_seconds(now)
+    return nil if r.nil?
+    self.class.format_timer(r)
+  end
 end
