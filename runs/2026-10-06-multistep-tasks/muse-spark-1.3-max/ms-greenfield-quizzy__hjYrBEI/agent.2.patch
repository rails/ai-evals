+<header class="admin-header">
+  <span class="logo"><span class="logo__mark">?</span>Quizzy</span>
+  <span class="admin-header__tag">Moderator</span>
+</header>
+<main class="admin-main">
+  <div class="breadcrumbs"><a href="<%= moderate_root_path %>">← All quizzes</a></div>
+  <div class="page-head"><h1>Import quiz</h1></div>
+  <% if @errors.present? && @errors.any? %>
+    <div class="errors">
+      <ul>
+        <% @errors.each do |msg| %>
+          <li><%= h msg %></li>
+        <% end %>
+      </ul>
+    </div>
+  <% end %>
+  <div class="card">
+    <form action="<%= moderate_import_path %>" method="post" data-turbo="false">
+      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
+      <div class="field">
+        <label for="quiz_json">Quiz JSON</label>
+        <textarea class="input" id="quiz_json" name="quiz_json" rows="15" placeholder="Paste quiz JSON here"><%= h @quiz_json.to_s %></textarea>
+      </div>
+      <div class="buttons">
+        <button type="submit" class="btn btn--pink">Import</button>
+        <a class="btn btn--ghost" href="<%= moderate_root_path %>">Cancel</a>
+      </div>
+    </form>
+  </div>
+</main>
