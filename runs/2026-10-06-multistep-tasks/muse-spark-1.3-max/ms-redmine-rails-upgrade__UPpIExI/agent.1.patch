--- /dev/null
+++ b/Gemfile.next
@@ -0,0 +1,14 @@
+# Gemfile.next -- dual-boot file for testing the next release (Rails 7.0).
+#
+# Usage:
+#   BUNDLE_GEMFILE=Gemfile.next bundle install
+#   BUNDLE_GEMFILE=Gemfile.next bundle exec rails test
+#
+# The main Gemfile switches the rails version based on BUNDLE_GEMFILE
+# (see top of Gemfile). This file simply evaluates the main Gemfile
+# so that both share the same gem list except for rails (and the
+# Rails-coupled sqlserver adapter).
+#
+# See docs/UPGRADE.md for compatibility decisions and work left for
+# the Rails 7.0 release.
+eval_gemfile File.expand_path("Gemfile", __dir__)
