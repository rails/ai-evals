+<% content_for(:title, "Quizzy · Import quiz") %>
+<header class="admin-header">
+  <span class="logo"><span class="logo__mark">?</span>Quizzy</span>
+  <span class="admin-header__tag">Moderator</span>
+</header>
+
+<main class="admin-main">
+  <div class="breadcrumbs"><%= link_to "← All quizzes", moderate_path %></div>
+  <div class="page-head"><h1>Import quiz</h1></div>
+
+  <div class="card">
+    <% if @errors.present? %>
+      <div class="errors" role="alert">
+        <ul>
+          <% @errors.each do |msg| %>
+            <li><%= msg %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <%= form_with url: import_moderate_quizzes_path, method: :post, data: { turbo: false } do %>
+      <div class="field">
+        <label for="quiz_json">Quiz JSON</label>
+        <textarea id="quiz_json" name="quiz_json" class="input" rows="15" placeholder="Quiz JSON" aria-label="Quiz JSON" style="font-family: monospace; min-height: 240px;"><%= @quiz_json %></textarea>
+      </div>
+
+      <div class="buttons">
+        <button type="submit" class="btn btn--pink">Import</button>
+        <%= link_to "Cancel", moderate_path, class: "btn btn--ghost" %>
+      </div>
+    <% end %>
+  </div>
+</main>
