+      if (overMessage) overMessage.textContent = 'The quiz is over';
+      // Clear hidden lobby/question so hidden text does not linger after end
+      if (playersCounter) playersCounter.textContent = '';
+      if (joinUrlEl) joinUrlEl.textContent = '';
+      if (progressEl) progressEl.textContent = '';
+      if (bodyEl) bodyEl.textContent = '';
+      clearOptions();
+      if (answersCounter) answersCounter.textContent = '';
+      setHidden(btnStart, true);
+      setHidden(btnFinish, true);
+      setHidden(btnNext, true);
+      setHidden(btnEnd, true);
+    }
+  }
+
+  var lastJson = '';
+  function poll() {
+    fetch(stateUrl, { cache: 'no-store', credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
