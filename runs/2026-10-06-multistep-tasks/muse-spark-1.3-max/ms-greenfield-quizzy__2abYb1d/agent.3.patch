diff --git a/app/views/moderate/games/show.html.erb b/app/views/moderate/games/show.html.erb
new file mode 100644
index 0000000..106ebb2
--- /dev/null
+++ b/app/views/moderate/games/show.html.erb
@@ -0,0 +1,104 @@
+<% content_for(:title, "Quizzy · #{@quiz.title} · Game #{@game.code}") %>
+<section class="cover cover--blue cover--calm">
+<div class="screen" id="screen-root" data-state-url="<%= state_moderate_quiz_game_path(@quiz, @game) %>">
+  <div class="screen__top">
+    <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span id="top-quiz-title"><%= @quiz.title %></span>
+  </div>
+
+  <div class="screen__body">
+    <!-- Lobby: before start (only populated when waiting, else empty placeholders for JS) -->
+    <div id="view-lobby" <%= 'hidden' unless @game.waiting? %>>
+      <div class="lobby">
+        <div>
+          <h1 class="lobby__title" id="quiz-title"><% if @game.waiting? %><%= @quiz.title %><% end %></h1>
+          <% if @game.waiting? %>
+          <div class="lobby__join">Join at</div>
+          <div class="lobby__url" id="join-url"><%= @join_url_display %></div>
+          <div class="counter-pill" id="players-counter">Players: <%= @players_count %></div>
+          <% else %>
+          <div class="lobby__url" id="join-url"></div>
+          <div class="counter-pill" id="players-counter"></div>
+          <% end %>
+        </div>
+        <% if @game.waiting? %>
+        <div class="qr" id="qr-code" role="img" aria-label="QR code for <%= @join_url_display %>" data-join-url="<%= @join_url_display %>"><%== @qr_svg %></div>
+        <% else %>
+        <div class="qr" id="qr-code" role="img" aria-label="QR code"></div>
+        <% end %>
+      </div>
+    </div>
+
+    <!-- Question: open or closed (only populated when playing) -->
+    <div id="view-question" <%= 'hidden' unless @game.playing? %>>
+      <div class="stage-question__num" id="question-progress"><% if @current_question %>Question <%= (@game.current_index || 0) + 1 %> of <%= @total %><% end %></div>
+      <div class="stage-question__body" id="question-body"><% if @game.playing? %><%= @current_question&.body %><% end %></div>
+      <ul class="stage-options <%= 'stage-options--results' if @game.closed? %>" id="options-list">
+        <% if @game.playing? && @current_question %>
+          <% total_answers = @answers_count > 0 ? @answers_count : 1 %>
+          <% @current_question.options.order(:position, :id).each_with_index do |opt, i| %>
+            <% letter = ("A".ord + i).chr %>
+            <% count = @counts[opt.id] || 0 %>
+            <% share = @game.closed? ? (count.to_f * 100.0 / total_answers) : 0 %>
+            <li class="stage-option <%= 'is-correct' if @game.closed? && opt.correct? %>" data-option-id="<%= opt.id %>">
+              <span class="stage-option__bar" style="--share: <%= share.round(1) %>%"></span>
+              <span class="stage-option__letter"><%= letter %></span>
+              <span class="stage-option__title"><%= opt.text %></span>
+              <% if @game.closed? %>
+                <span class="stage-option__count"><%= count %></span>
+                <% if opt.correct? %>
+                  <span class="stage-option__mark">Correct</span>
+                <% end %>
+              <% end %>
+            </li>
+          <% end %>
+        <% end %>
+      </ul>
+      <div style="margin-top: 24px">
+        <span class="answers-counter" id="answers-counter"><% if @game.playing? %>Answers: <%= @answers_count %> / <%= @players_count %><% end %></span>
+      </div>
+    </div>
+
+    <!-- Over: after end (only populated when finished) -->
+    <div id="view-over" <%= 'hidden' unless @game.finished? %>>
+      <% if @game.finished? %>
+      <div class="screen__kicker"><%= @quiz.title %></div>
+      <div class="stage-question__body" id="over-message">The quiz is over</div>
+      <% else %>
+      <div class="stage-question__body" id="over-message"></div>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
+      <span id="game-code">Game <%= @game.code %></span>
+    </div>
+    <div class="buttons">
+      <span id="btn-start" <%= 'hidden' unless @game.waiting? %>>
+        <%= form_with url: start_moderate_quiz_game_path(@quiz, @game), method: :post, data: { turbo: false } do %>
+          <button type="submit" class="btn btn--pink btn--lg">Start</button>
+        <% end %>
+      </span>
+      <span id="btn-finish" <%= 'hidden' unless @game.open? %>>
+        <%= form_with url: finish_moderate_quiz_game_path(@quiz, @game), method: :post, data: { turbo: false } do %>
+          <button type="submit" class="btn btn--pink btn--lg">Finish</button>
+        <% end %>
+      </span>
+      <span id="btn-next" <%= 'hidden' unless @game.closed? && !@game.last_question? %>>
+        <%= form_with url: next_question_moderate_quiz_game_path(@quiz, @game), method: :post, data: { turbo: false } do %>
+          <button type="submit" class="btn btn--pink btn--lg">Next</button>
+        <% end %>
+      </span>
+      <span id="btn-end" <%= 'hidden' unless @game.closed? && @game.last_question? %>>
+        <%= form_with url: end_quiz_moderate_quiz_game_path(@quiz, @game), method: :post, data: { turbo: false } do %>
+          <button type="submit" class="btn btn--pink btn--lg">End quiz</button>
+        <% end %>
+      </span>
+    </div>
+  </div>
+</div>
+</section>
+
+<script src="/moderator-game.js" defer></script>
