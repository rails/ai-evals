+      } else {
+        clearOptions();
+      }
+      if (answersCounter) answersCounter.textContent = 'Answers: ' + answers + ' / ' + players;
+      var isLast = !!state.is_last;
+      if (status === 'open') {
+        setHidden(btnStart, true);
+        setHidden(btnFinish, false);
+        setHidden(btnNext, true);
+        setHidden(btnEnd, true);
+      } else {
+        setHidden(btnStart, true);
+        setHidden(btnFinish, true);
+        if (isLast) {
+          setHidden(btnNext, true);
+          setHidden(btnEnd, false);
+        } else {
+          setHidden(btnNext, false);
+          setHidden(btnEnd, true);
+        }
+      }
+    } else if (status === 'finished') {
+      setHidden(viewLobby, true);
+      setHidden(viewQuestion, true);
+      setHidden(viewOver, false);
