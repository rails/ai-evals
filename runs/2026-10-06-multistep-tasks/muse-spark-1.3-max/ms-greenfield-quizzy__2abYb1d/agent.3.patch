diff --git a/app/views/play/show.html.erb b/app/views/play/show.html.erb
new file mode 100644
index 0000000..a0b1c9d
--- /dev/null
+++ b/app/views/play/show.html.erb
@@ -0,0 +1,124 @@
+<% content_for(:title, "Quizzy · Play #{@game.code}") %>
+<div class="play" id="play-root"
+  data-code="<%= @game.code %>"
+  data-state-url="<%= play_state_path(code: @game.code) %>"
+  data-answer-url="<%= play_answer_path(code: @game.code) %>"
+  data-restore-url="<%= play_restore_path(code: @game.code) %>"
+  data-join-url="<%= play_join_path(code: @game.code) %>"
+  data-player-token="<%= @current_player&.token %>"
+  data-joined="<%= @current_player ? '1' : '0' %>">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span id="top-quiz-title"><%= @quiz.title %></span>
+  </div>
+
+  <div class="play__body" id="play-body">
+    <!-- Over: after end (only populated when finished, else empty for JS) -->
+    <div id="view-over" <%= 'hidden' unless @game.finished? %>>
+      <% if @game.finished? %>
+      <div class="play-title" id="over-message">The quiz is over</div>
+      <% else %>
+      <div class="play-title" id="over-message"></div>
+      <% end %>
+    </div>
+
+    <!-- Join: only populated when not finished and not joined -->
+    <div id="view-join" <%= 'hidden' if @game.finished? || @current_player %>>
+      <% show_join = !@game.finished? && !@current_player %>
+      <% if show_join %>
+      <h1 class="play-title"><%= @quiz.title %></h1>
+      <p class="play-lead">Join the quiz</p>
+      <% if @join_error.present? %>
+        <div class="errors" role="alert"><%= @join_error %></div>
+      <% end %>
+      <%= form_with url: play_join_path(code: @game.code), method: :post, data: { turbo: false }, html: { id: "join-form", class: "join-form" } do %>
+        <label for="player_name">Your name</label>
+        <input class="input" type="text" id="player_name" name="player[name]" placeholder="Your name" aria-label="Your name" autocomplete="off" required>
+        <button type="submit" class="btn btn--pink">Join</button>
+      <% end %>
+      <div class="errors" role="alert" id="join-error" hidden></div>
+      <% else %>
+      <div class="errors" role="alert" id="join-error" hidden></div>
+      <% end %>
+    </div>
+
+    <!-- Waiting: only populated when joined and waiting and not finished -->
+    <div id="view-waiting" <%= 'hidden' unless !@game.finished? && @current_player && @game.waiting? %>>
+      <% show_waiting = !@game.finished? && @current_player && @game.waiting? %>
+      <% if show_waiting %>
+      <div class="waiting">
+        <div class="waiting__gem">?</div>
+        <div class="play-title" id="greeting">Hi, <%= @current_player.name %>!</div>
+        <p class="play-lead" id="waiting-text">Waiting for the quiz to start…</p>
+      </div>
+      <% else %>
+      <div class="waiting">
+        <div class="waiting__gem">?</div>
+        <div class="play-title" id="greeting"></div>
+        <p class="play-lead" id="waiting-text"></p>
+      </div>
+      <% end %>
+    </div>
+
+    <!-- Question: only populated when joined and playing and not finished -->
+    <div id="view-question" <%= 'hidden' unless !@game.finished? && @current_player && @game.playing? %>>
+      <% show_q = !@game.finished? && @current_player && @game.playing? %>
+      <% if show_q %>
+      <div class="play-question__num" id="question-progress">Question <%= (@game.current_index || 0) + 1 %> of <%= @total %></div>
+      <div id="greeting-question" class="muted" style="margin-bottom: 12px">Hi, <%= @current_player.name %>!</div>
+      <div class="play-question__body" id="question-body"><%= @current_question&.body %></div>
+      <ul class="play-options <%= 'is-locked is-revealed' if @game.closed? %>" id="options-list" style="list-style: none; padding: 0; margin: 0;">
+        <% if @current_question %>
+          <% @current_question.options.order(:position, :id).each_with_index do |opt, i| %>
+            <% letter = ("A".ord + i).chr %>
+            <% is_picked = (@my_option_id == opt.id) %>
+            <li data-option-id="<%= opt.id %>">
+              <% if @game.open? %>
+                <%= form_with url: play_answer_path(code: @game.code), method: :post, data: { turbo: false }, html: { class: "answer-form" } do %>
+                  <input type="hidden" name="option_id" value="<%= opt.id %>" autocomplete="off">
+                  <button type="submit" class="play-option <%= 'is-picked' if is_picked %>">
+                    <span class="play-option__letter"><%= letter %></span>
+                    <span class="play-option__title"><%= opt.text %></span>
+                    <% if is_picked %>
+                      <span class="play-option__mark">Your answer</span>
+                    <% end %>
+                  </button>
+                <% end %>
+              <% else %>
+                <div class="play-option <%= 'is-picked' if is_picked %> <%= 'is-correct' if opt.correct? %>">
+                  <span class="play-option__letter"><%= letter %></span>
+                  <span class="play-option__title"><%= opt.text %></span>
+                  <% if opt.correct? %>
+                    <span class="play-option__mark">Correct</span>
+                  <% end %>
+                  <% if is_picked %>
+                    <span class="play-option__mark">Your answer</span>
+                  <% end %>
+                </div>
+              <% end %>
+            </li>
+          <% end %>
+        <% end %>
+      </ul>
+      <div id="feedback-wrap" <%= 'hidden' unless @game.closed? %>>
+        <% if @game.closed? && @feedback.present? %>
+          <% cls = @feedback == "Correct!" ? "play-status--right" : (@feedback == "Wrong!" ? "play-status--wrong" : "play-status--neutral") %>
+          <div class="play-status <%= cls %>" id="feedback"><%= @feedback %></div>
+        <% else %>
+          <div class="play-status" id="feedback" hidden></div>
+        <% end %>
+      </div>
+      <% else %>
+      <div class="play-question__num" id="question-progress"></div>
+      <div id="greeting-question" class="muted" style="margin-bottom: 12px"></div>
+      <div class="play-question__body" id="question-body"></div>
+      <ul class="play-options" id="options-list" style="list-style: none; padding: 0; margin: 0;"></ul>
+      <div id="feedback-wrap" hidden>
+        <div class="play-status" id="feedback" hidden></div>
+      </div>
+      <% end %>
+    </div>
+  </div>
+</div>
+
+<script src="/play.js" defer></script>
