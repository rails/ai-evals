diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..838b74f
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,37 @@
+class Account < ApplicationRecord
+  has_many :users, dependent: :destroy
+  has_many :sessions, through: :users
+
+  before_validation :normalize_subdomain
+
+  validates :name, presence: true
+  validates :subdomain, presence: true, uniqueness: { case_sensitive: false }
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def active?
+    !cancelled?
+  end
+
+  def cancel!
+    update!(cancelled_at: Time.current)
+    # revoke all sessions for this account
+    Session.joins(:user).where(users: { account_id: id }).delete_all
+  end
+
+  def reactivate!
+    update!(cancelled_at: nil)
+  end
+
+  def purgeable?
+    cancelled? && cancelled_at < 90.days.ago
+  end
+
+  private
+
+  def normalize_subdomain
+    self.subdomain = subdomain.to_s.strip.downcase.presence
+  end
+end
