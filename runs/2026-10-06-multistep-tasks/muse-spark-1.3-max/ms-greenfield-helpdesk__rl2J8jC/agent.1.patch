+namespace :helpdesk do
+  desc "Permanently delete accounts still cancelled after 90 days, including all their data"
+  task purge_cancelled_accounts: :environment do
+    cutoff = 90.days.ago
+    accounts = Account.where("cancelled_at IS NOT NULL AND cancelled_at < ?", cutoff)
+    count = accounts.count
+    puts "Purging #{count} cancelled account(s) older than 90 days..."
+    accounts.find_each do |account|
+      puts "Deleting account #{account.id} (#{account.subdomain}) cancelled at #{account.cancelled_at}"
+      account.destroy!
+    end
+    puts "Done. Purged #{count} account(s)."
+  end
+end
