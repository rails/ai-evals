+class Session < ApplicationRecord
+  belongs_to :user
+
+  before_validation :ensure_token, on: :create
+
+  validates :token, presence: true, uniqueness: true
+
+  delegate :account, to: :user
+
+  private
+
+  def ensure_token
+    return if token.present?
+    loop do
+      self.token = SecureRandom.hex(32)
+      break unless Session.exists?(token: token)
+    end
+  end
+end
diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..34d5f66
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,66 @@
+class User < ApplicationRecord
+  belongs_to :account
+  has_many :sessions, dependent: :destroy
+
+  has_secure_password
+
+  before_validation :normalize_email
+  before_validation :set_defaults
+
+  validates :name, presence: true
+  validates :email, presence: true,
+    format: { with: URI::MailTo::EMAIL_REGEXP },
+    uniqueness: { scope: :account_id, case_sensitive: false }
+  validates :role, presence: true
+
+  def admin?
+    role.to_s == "admin"
+  end
+
+  def verified?
+    verified
+  end
+
+  def generate_email_verification_token!
+    token = nil
+    loop do
+      token = SecureRandom.urlsafe_base64(32)
+      break unless User.exists?(email_verification_token: token)
+    end
+    update!(email_verification_token: token, email_verification_sent_at: Time.current)
+    token
+  end
+
+  def verify_email!
+    update!(verified: true, verified_at: Time.current, email_verification_token: nil, email_verification_sent_at: nil)
+  end
+
+  def generate_password_reset_token!
+    token = nil
+    loop do
+      token = SecureRandom.urlsafe_base64(32)
+      break unless User.exists?(password_reset_token: token)
+    end
+    update!(password_reset_token: token, password_reset_sent_at: Time.current)
+    token
+  end
+
+  def clear_password_reset_token!
+    update!(password_reset_token: nil, password_reset_sent_at: nil)
+  end
+
+  def revoke_all_sessions!
+    sessions.delete_all
+  end
+
+  private
+
+  def normalize_email
+    self.email = email.to_s.strip.downcase.presence
+  end
+
+  def set_defaults
+    self.role = "admin" if role.blank?
+    self.verified = false if verified.nil?
+  end
+end
