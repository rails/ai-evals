diff --git a/config/initializers/mailer_file_logger.rb b/config/initializers/mailer_file_logger.rb
new file mode 100644
index 0000000..7ea8553
--- /dev/null
+++ b/config/initializers/mailer_file_logger.rb
@@ -0,0 +1,34 @@
+require "fileutils"
+
+class MailerFileLogger
+  def self.delivered_email(mail)
+    begin
+      dir = Rails.root.join("tmp/mails")
+      FileUtils.mkdir_p(dir)
+      timestamp = Time.current.strftime("%Y%m%d%H%M%S%6N")
+      sanitized_to = Array(mail.to).join(",").gsub(/[^a-zA-Z0-9@._-]/, "_")
+      filename = "#{timestamp}_#{sanitized_to}.eml"
+      raw = mail.to_s
+      File.write(dir.join(filename), raw)
+      # Extract body parts for logging
+      body_content = ""
+      begin
+        if mail.multipart?
+          body_content = mail.text_part ? mail.text_part.body.decoded : ""
+          body_content += "\n" + (mail.html_part ? mail.html_part.body.decoded : "")
+        else
+          body_content = mail.body.decoded rescue mail.body.to_s
+        end
+      rescue
+        body_content = raw[0..5000]
+      end
+      File.open(dir.join("deliveries.log"), "a") do |f|
+        f.puts({ to: mail.to, from: mail.from, subject: mail.subject, body: body_content[0..10000], raw: raw[0..10000], raw_file: filename, date: Time.current.iso8601 }.to_json)
+      end
+    rescue => e
+      Rails.logger.error("MailerFileLogger failed: #{e.message}")
+    end
+  end
+end
+
+ActionMailer::Base.register_observer(MailerFileLogger)
