+++ b/app/controllers/api/v1/password_resets_controller.rb
@@ -0,0 +1,90 @@
+module Api
+  module V1
+    class PasswordResetsController < ApplicationController
+      # POST /api/v1/password_resets
+      def create
+        account = require_account!
+        return if account.nil?
+
+        if account.cancelled?
+          return render json: { error: "Account cancelled", errors: ["Account cancelled"] }, status: :forbidden
+        end
+
+        pr_params = params.require(:password_reset).permit(:email) rescue nil
+        if pr_params.nil? || pr_params[:email].blank?
+          return render json: { error: "Email can't be blank", errors: ["Email can't be blank"] }, status: :unprocessable_entity
+        end
+
+        email = pr_params[:email].to_s.strip.downcase
+        user = account.users.where("LOWER(email) = ?", email).first
+
+        if user.nil?
+          return render json: { message: "If your email is registered, you will receive a password reset email" }, status: :created
+        end
+
+        token = user.generate_password_reset_token!
+        begin
+          UserMailer.password_reset_email(user, token).deliver_now
+        rescue => e
+          Rails.logger.error("Failed to send password reset email: #{e.message}")
+        end
+
+        render json: { message: "Password reset email sent" }, status: :created
+      end
+
+      # POST /api/v1/password_resets/confirm
+      def confirm
+        pr_params = params.require(:password_reset).permit(:token, :password, :account) rescue nil
+        if pr_params.nil? || pr_params[:token].blank?
+          return render json: { error: "Token can't be blank", errors: ["Token can't be blank"] }, status: :unprocessable_entity
+        end
+
+        if pr_params[:password].blank?
+          return render json: { error: "Password can't be blank", errors: ["Password can't be blank"] }, status: :unprocessable_entity
+        end
+
+        token = pr_params[:token].to_s.strip
+
+        account = find_account_by_subdomain
+        if account.nil? && pr_params[:account].present?
+          account = find_account_by_subdomain(pr_params[:account].to_s)
+        end
+        if account.nil?
+          inferred_user = User.find_by(password_reset_token: token)
+          account = inferred_user&.account
+        end
+
+        if account.nil?
+          return render json: { error: "Account not found", errors: ["Account not found"] }, status: :not_found
+        end
+
+        if account.cancelled?
+          return render json: { error: "Account cancelled", errors: ["Account cancelled"] }, status: :forbidden
+        end
+
+        user = account.users.find_by(password_reset_token: token)
+        if user.nil?
+          global_user = User.find_by(password_reset_token: token)
+          if global_user && global_user.account_id == account.id
+            user = global_user
+          end
+        end
+
+        if user.nil?
+          return render json: { error: "Invalid token", errors: ["Invalid token"] }, status: :unprocessable_entity
+        end
+
+        user.password = pr_params[:password].to_s
+        user.password_reset_token = nil
+        user.password_reset_sent_at = nil
+        if user.save
+          user.revoke_all_sessions!
+          user.reload
+          render json: { user: user_json(user), message: "Password has been reset" }, status: :ok
+        else
+          render_validation_errors(user)
+        end
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/passwords_controller.rb b/app/controllers/api/v1/passwords_controller.rb
new file mode 100644
index 0000000..f1f2535
--- /dev/null
+++ b/app/controllers/api/v1/passwords_controller.rb
@@ -0,0 +1,38 @@
+module Api
+  module V1
+    class PasswordsController < ApplicationController
+      # PUT /api/v1/me/password
+      def update
+        return unless authenticate_user!
+        return unless ensure_account_active!
+
+        pw_params = params.require(:password_change).permit(:current_password, :password) rescue nil
+        if pw_params.nil?
+          return render json: { error: "Missing password parameters", errors: ["Missing password parameters"] }, status: :bad_request
+        end
+
+        current_password = pw_params[:current_password].to_s
+        new_password = pw_params[:password].to_s
+
+        if new_password.blank?
+          return render json: { error: "Password can't be blank", errors: ["Password can't be blank"] }, status: :unprocessable_entity
+        end
+
+        unless current_user.authenticate(current_password)
+          return render json: { error: "Current password is invalid", errors: ["Current password is invalid"] }, status: :unprocessable_entity
+        end
+
+        current_user.password = new_password
+        if current_user.save
+          # Sign out existing sessions (all, including current)
+          current_user.revoke_all_sessions!
+          # Reload user to get updated timestamps
+          current_user.reload
+          render json: { user: user_json(current_user) }, status: :ok
+        else
+          render_validation_errors(current_user)
+        end
+      end
+    end
+  end
+end
