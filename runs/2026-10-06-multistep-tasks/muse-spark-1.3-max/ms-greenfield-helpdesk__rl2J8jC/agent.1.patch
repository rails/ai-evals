diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..7d7e01d
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,105 @@
+module Api
+  module V1
+    class AccountsController < ApplicationController
+      # POST /api/v1/account/create
+      def create
+        account_params = params.require(:account).permit(:name, :subdomain, admin: [:name, :email, :password])
+        # Also support flat? But spec uses nested admin
+        name = account_params[:name]
+        subdomain = account_params[:subdomain]
+        admin_attrs = account_params[:admin] || {}
+        # Handle case where admin is ActionController::Parameters
+        if admin_attrs.is_a?(ActionController::Parameters)
+          admin_attrs = admin_attrs.permit(:name, :email, :password)
+        end
+
+        account = Account.new(name: name, subdomain: subdomain)
+
+        if account.invalid?
+          return render_validation_errors(account)
+        end
+
+        user = nil
+        begin
+          ActiveRecord::Base.transaction do
+            account.save!
+            user = account.users.build(
+              name: admin_attrs[:name] || admin_attrs["name"],
+              email: admin_attrs[:email] || admin_attrs["email"],
+              password: admin_attrs[:password] || admin_attrs["password"],
+              role: "admin",
+              verified: false
+            )
+            user.save!
+            token = user.generate_email_verification_token!
+            # Send verification email
+            begin
+              UserMailer.verification_email(user, token).deliver_now
+            rescue => e
+              Rails.logger.error("Failed to send verification email: #{e.message}")
+            end
+          end
+        rescue ActiveRecord::RecordInvalid => e
+          record = e.record
+          return render_validation_errors(record)
+        end
+
+        # Reload to get timestamps
+        account.reload
+        user.reload
+
+        render json: { account: account_json(account), user: user_json(user) }, status: :created
+      end
+
+      # GET /api/v1/account
+      def show
+        return unless authenticate_user!
+        return unless ensure_account_active!
+
+        account = current_user.account
+        render json: { account: account_json(account) }, status: :ok
+      end
+
+      # POST /api/v1/account/cancel
+      def cancel
+        return unless authenticate_user!
+        account = current_user.account
+
+        unless current_user.admin?
+          return render json: { error: "Forbidden", errors: ["Forbidden"] }, status: :forbidden
+        end
+
+        if account.cancelled?
+          # idempotent: return current
+          return render json: { account: account_json(account) }, status: :ok
+        end
+
+        account.cancel!
+        account.reload
+        render json: { account: account_json(account) }, status: :ok
+      end
+
+      # POST /api/v1/account/reactivate
+      def reactivate
+        return unless authenticate_user!
+        account = current_user.account
+
+        unless current_user.admin?
+          return render json: { error: "Forbidden", errors: ["Forbidden"] }, status: :forbidden
+        end
+
+        if !account.cancelled?
+          return render json: { error: "Account is not cancelled", errors: ["Account is not cancelled"] }, status: :unprocessable_entity
+        end
+
+        if account.cancelled_at < 90.days.ago
+          return render json: { error: "Reactivation period expired", errors: ["Reactivation period expired"] }, status: :unprocessable_entity
+        end
+
+        account.reactivate!
+        account.reload
+        render json: { account: account_json(account) }, status: :ok
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..014f78c
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,86 @@
+module Api
+  module V1
+    class EmailVerificationsController < ApplicationController
+      # POST /api/v1/email_verifications - request another link
+      def create
+        account = require_account!
+        return if account.nil?
+
+        if account.cancelled?
+          return render json: { error: "Account cancelled", errors: ["Account cancelled"] }, status: :forbidden
+        end
+
+        ev_params = params.require(:email_verification).permit(:email) rescue nil
+        if ev_params.nil? || ev_params[:email].blank?
+          return render json: { error: "Email can't be blank", errors: ["Email can't be blank"] }, status: :unprocessable_entity
+        end
+
+        email = ev_params[:email].to_s.strip.downcase
+        user = account.users.where("LOWER(email) = ?", email).first
+
+        if user.nil?
+          return render json: { message: "If your email is registered, you will receive a verification email" }, status: :created
+        end
+
+        if user.verified?
+          return render json: { message: "Email already verified", user: user_json(user) }, status: :ok
+        end
+
+        token = user.generate_email_verification_token!
+        begin
+          UserMailer.verification_email(user, token).deliver_now
+        rescue => e
+          Rails.logger.error("Failed to send verification email: #{e.message}")
+        end
+
+        render json: { message: "Verification email sent" }, status: :created
+      end
+
+      # POST /api/v1/email_verifications/confirm
+      def confirm
+        ev_params = params.require(:email_verification).permit(:token, :account) rescue nil
+        if ev_params.nil? || ev_params[:token].blank?
+          return render json: { error: "Token can't be blank", errors: ["Token can't be blank"] }, status: :unprocessable_entity
+        end
+        token = ev_params[:token].to_s.strip
+
+        # Try to find account: header/params first, fallback to token lookup
+        account = find_account_by_subdomain
+        if account.nil? && ev_params[:account].present?
+          account = find_account_by_subdomain(ev_params[:account].to_s)
+        end
+        if account.nil?
+          # Fallback: global token lookup to infer account
+          inferred_user = User.find_by(email_verification_token: token)
+          account = inferred_user&.account
+        end
+
+        if account.nil?
+          return render json: { error: "Account not found", errors: ["Account not found"] }, status: :not_found
+        end
+
+        if account.cancelled?
+          return render json: { error: "Account cancelled", errors: ["Account cancelled"] }, status: :forbidden
+        end
+
+        user = account.users.find_by(email_verification_token: token)
+        if user.nil?
+          # Try global then verify
+          global_user = User.find_by(email_verification_token: token)
+          if global_user && global_user.account_id == account.id
+            user = global_user
+          end
+        end
+
+        if user.nil?
+          return render json: { error: "Invalid token", errors: ["Invalid token"] }, status: :unprocessable_entity
+        end
+
+        user.verify_email!
+        user.reload
+
+        render json: { user: user_json(user), message: "Email verified" }, status: :ok
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/me_controller.rb b/app/controllers/api/v1/me_controller.rb
new file mode 100644
index 0000000..99f4fa1
--- /dev/null
+++ b/app/controllers/api/v1/me_controller.rb
@@ -0,0 +1,34 @@
+module Api
+  module V1
+    class MeController < ApplicationController
+      # GET /api/v1/me
+      def show
+        return unless authenticate_user!
+        return unless ensure_account_active!
+        render json: { user: user_json(current_user) }, status: :ok
+      end
+
+      # PATCH /api/v1/me
+      def update
+        return unless authenticate_user!
+        return unless ensure_account_active!
+
+        user_params = params.require(:user).permit(:name) rescue nil
+        if user_params.nil?
+          return render json: { error: "Missing user parameters", errors: ["Missing user parameters"] }, status: :bad_request
+        end
+
+        if user_params[:name].present?
+          current_user.name = user_params[:name].to_s.strip
+        end
+
+        # Only allow name update; ignore other fields
+        if current_user.save
+          render json: { user: user_json(current_user) }, status: :ok
+        else
+          render_validation_errors(current_user)
+        end
+      end
+    end
+  end
+end
