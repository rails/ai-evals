diff --git a/app/models/concerns/profile_image_migration.rb b/app/models/concerns/profile_image_migration.rb
new file mode 100644
index 0000000..e07ddca
--- /dev/null
+++ b/app/models/concerns/profile_image_migration.rb
@@ -0,0 +1,344 @@
+# Dual-read/write logic for migrating User and Organization profile pictures
+# from CarrierWave to Active Storage, one deploy at a time.
+#
+# First deploy (this file):
+# - NEW uploads go to Active Storage (via #profile_image= and #remote_profile_image_url=).
+# - EXISTING CarrierWave files stay in place (column + files untouched) and
+#   remain readable via fallback in #profile_image and #profile_image_url.
+# - Other uploaders (cover images, badges, etc.) stay on CarrierWave.
+#
+# Readers prefer Active Storage when attached, else CarrierWave:
+#   - #profile_image returns ActiveStorage::Attached::One when attached,
+#     else the CarrierWave uploader (preserves #blank?/#present? for validations).
+#   - #profile_image_url returns the Active Storage path when attached,
+#     else the CarrierWave URL. #profile_image_url_for (via Images::Profile)
+#     and #profile_image_90 build on top of it, so they work for both.
+#
+# Writers always go to Active Storage:
+#   - #profile_image= validates/processes via a temporary CarrierWave uploader
+#     (extension, size, dimensions, frames, EXIF stripping) then attaches the
+#     processed file to Active Storage. The CarrierWave column is left untouched
+#     for new uploads (existing values preserved for old images).
+#   - #remote_profile_image_url= downloads remote URLs (or attaches File-like
+#     fallbacks from Images::SafeRemoteProfileImageUrl) to Active Storage.
+#     The getter still returns the assigned value for spec compatibility even
+#     when download fails (matching CarrierWave's @remote_urls behavior).
+#
+# Change tracking for callbacks:
+#   - CarrierWave column changes are still detected via saved_change_to_profile_image?
+#   - Active Storage changes set #profile_image_attachment_changed, checked by
+#     User#profile_image_changed_for_cache?, User/Organization#generate_social_images,
+#     and Organization#conditionally_update_articles (see those methods).
+#   - The flag is set in #profile_image_attachment= (covers direct attach via
+#     #profile_image_attachment.attach as well as via #profile_image=) and reset
+#     in an after_commit/after_rollback defined LAST (include this concern after
+#     all other callbacks but before `private` in the model).
+#
+# Future deploys (not this one):
+# - Backfill existing CarrierWave files to Active Storage.
+# - Switch production Active Storage service from :local to :amazon (S3).
+# - Remove CarrierWave mount and this concern's fallback logic.
+module ProfileImageMigration
+  extend ActiveSupport::Concern
+
+  included do
+    has_one_attached :profile_image_attachment
+
+    # NOTE: Do NOT use alias_method for CarrierWave or ActiveStorage setters here.
+    # - CarrierWave defines `def profile_image; super; end` directly in the model
+    #   class, so aliasing would copy the `super` delegator and cause infinite
+    #   recursion (super would resolve back to this concern's override).
+    #   Instead, `carrierwave_*` methods below call `_mounter` directly.
+    # - ActiveStorage's `profile_image_attachment=` lives in
+    #   `generated_association_methods`; aliasing in `included` (which runs AFTER
+    #   this module is already in ancestors) would capture this concern's own
+    #   override and recurse. Instead, our override below calls `super` to reach
+    #   the original ActiveStorage setter.
+
+    attr_accessor :profile_image_attachment_changed
+    attr_accessor :remote_profile_image_url_value
+    attr_accessor :profile_image_processing_error
+
+    # Surface CarrierWave processing errors (size, extension, dimensions, etc.)
+    # for new ActiveStorage uploads as validation errors (matching old behavior
+    # where invalid assignment stores integrity errors and fails valid?).
+    validate :profile_image_processing_error_validation
+
+    # Reset flag after transaction completes. Include this concern AFTER all
+    # other callbacks in the model so reset runs LAST (after bust/conditional
+    # callbacks that check the flag). See User/Organization models.
+    after_commit :reset_profile_image_attachment_changed, on: %i[create update]
+    after_rollback :reset_profile_image_attachment_changed
+  end
+
+  def profile_image_attachment_changed?
+    !!profile_image_attachment_changed
+  end
+
+  def reset_profile_image_attachment_changed
+    self.profile_image_attachment_changed = false
+  end
+
+  def profile_image_processing_error_validation
+    return if profile_image_processing_error.blank?
+
+    errors.add(:profile_image, profile_image_processing_error)
+  end
+
+  # Direct CarrierWave access via _mounter (same logic as CarrierWave's mod).
+  # Used as fallback for existing images. Do not use alias_method (see above).
+  def carrierwave_profile_image
+    _mounter(:profile_image).uploaders[0] ||= _mounter(:profile_image).blank_uploader
+  end
+
+  def carrierwave_profile_image_url(*args)
+    carrierwave_profile_image.url(*args)
+  end
+
+  def carrierwave_remote_profile_image_url
+    [_mounter(:profile_image).remote_urls].flatten[0]
+  end
+
+  def carrierwave_remote_profile_image_url=(url)
+    _mounter(:profile_image).remote_urls = url
+  end
+
+  # Track ActiveStorage changes for parent callbacks. Covers direct attach via
+  # `record.profile_image_attachment.attach(...)` as well as via #profile_image=.
+  def profile_image_attachment=(attachable)
+    super(attachable)
+    # Mark changed when attaching something, or when clearing an existing attachment.
+    # attachable is nil/"" for DeleteOne (purge), else CreateOne.
+    # NOTE: setter return value is the argument, not this flag (Ruby semantics).
+    self.profile_image_attachment_changed = true if attachable.present? || profile_image_attachment.attached?
+  end
+
+  # Unified getter: Active Storage when attached, else CarrierWave.
+  # Preserves #blank?/#present? for validations (Organization validates presence).
+  def profile_image
+    if profile_image_attachment.attached?
+      profile_image_attachment
+    else
+      carrierwave_profile_image
+    end
+  end
+
+  # Unified setter: new uploads go to Active Storage only.
+  # Existing CarrierWave column/files are left untouched.
+  def profile_image=(attachable)
+    # Clear any previous processing error (new assignment replaces it).
+    self.profile_image_processing_error = nil
+    # Match CarrierWave behavior where nil/"" clears (used by presence
+    # validations and shoulda-matchers). Clears both ActiveStorage (pending
+    # DeleteOne until save) and CarrierWave (via _mounter, pending until save).
+    # Normal updates without a file don't call this setter at all (key missing
+    # from params), so old images are preserved in that case.
+    if attachable.nil? || attachable == ""
+      self.profile_image_attachment = nil
+      _mounter(:profile_image).cache([""])
+      return
+    end
+
+    # String URLs (e.g., mascot URL) are treated as remote downloads.
+    if attachable.is_a?(String)
+      if attachable.start_with?("http")
+        self.remote_profile_image_url = attachable
+      else
+        # Non-URL String: likely a CarrierWave identifier being reassigned.
+        # If it matches the current column, it's a no-op (keep old).
+        # Otherwise ignore to avoid clearing existing images (CarrierWave would
+        # treat unknown cache identifiers as blank; we preserve old instead).
+        current_identifier = self[:profile_image]
+        unless attachable == current_identifier
+          Rails.logger.warn(
+            "[ProfileImageMigration] Ignoring String assignment to profile_image " \
+            "that is not a URL: #{attachable.inspect} for #{self.class.name}##{id}",
+          )
+        end
+      end
+      return
+    end
+
+    # ActiveStorage direct attachables (Hash with io/filename, Blob, signed_id)
+    # are attached without CarrierWave processing (assumed pre-validated).
+    if attachable.is_a?(Hash) || attachable.is_a?(ActiveStorage::Blob)
+      self.profile_image_attachment = attachable
+      return
+    end
+
+    # File-like uploads (File, Tempfile, UploadedFile, Rack::Test::UploadedFile,
+    # ActionDispatch::Http::UploadedFile, Pathname, etc.): validate/process via
+    # a temporary CarrierWave uploader (extension, size, dimensions, frames,
+    # EXIF stripping, bombshelter) then attach processed file to Active Storage.
+    attach_processed_file_to_active_storage(attachable)
+  end
+
+  # Unified URL: Active Storage path when attached, else CarrierWave URL.
+  # Returns relative Disk path (/rails/active_storage/...) in test/dev (like
+  # CarrierWave's relative /uploads/...), which Images::Optimizer returns as-is.
+  def profile_image_url(*args)
+    if profile_image_attachment.attached?
+      begin
+        # Use path (relative) for consistency with CarrierWave dev behavior.
+        # Falls back to CarrierWave on any error (e.g., blob missing, unsaved).
+        return Rails.application.routes.url_helpers.rails_blob_path(
+          profile_image_attachment, only_path: true
+        )
+      rescue StandardError => e
+        Rails.logger.error(
+          "[ProfileImageMigration] ActiveStorage profile_image_url failed, " \
+          "falling back to CarrierWave: #{e.class}: #{e.message} " \
+          "for #{self.class.name}##{id}",
+        )
+      end
+    end
+
+    # Fallback to CarrierWave for existing images (or when ActiveStorage fails).
+    # Handle legacy column values that are full URLs (e.g., BanishUser's
+    # DEFAULT_PROFILE_IMAGE set via update_columns): CarrierWave would mangle
+    # them as /uploads/.../https%3A/...; return the URL directly instead.
+    raw_value = self[:profile_image]
+    if raw_value.is_a?(String) && raw_value.start_with?("http")
+      return raw_value
+    end
+
+    carrierwave_profile_image_url(*args)
+  end
+
+  # Remote setter: downloads to Active Storage (not CarrierWave).
+  # Handles both String URLs and File-like fallbacks from SafeRemoteProfileImageUrl.
+  def remote_profile_image_url=(url)
+    # Store for getter compatibility (CarrierWave returns @remote_urls even on failure).
+    self.remote_profile_image_url_value = url
+    self.profile_image_processing_error = nil
+    return if url.nil? || (url.is_a?(String) && url.blank?)
+
+    # File-like fallback (SafeRemote returns File for invalid URLs): attach directly.
+    unless url.is_a?(String)
+      self.profile_image = url
+      return
+    end
+
+    # String URL: download via temporary CarrierWave uploader (preserves SSRF
+    # protection, retries, processing) then attach processed file to Active Storage.
+    begin
+      temp_uploader = ProfileImageUploader.new(self, :profile_image)
+      temp_uploader.download!(url)
+      attach_temp_uploader_file_to_active_storage(temp_uploader)
+    rescue CarrierWave::IntegrityError, CarrierWave::ProcessingError => e
+      # Invalid image (size, extension, dimensions): fail validation like direct
+      # uploads (Users::Update expects service failure, not raise).
+      self.profile_image_processing_error = e.message
+      nil
+    rescue StandardError => e
+      # Download/network failures (including stubbed empty in tests): log and
+      # leave unchanged (do not fail validation), matching old behavior where
+      # empty downloads result in blank but successful save. Safer for signup.
+      Rails.logger.error(
+        "[ProfileImageMigration] Failed to download remote profile image #{url.inspect}: " \
+        "#{e.class}: #{e.message} for #{self.class.name}##{id || 'new'}",
+      )
+      nil
+    end
+  end
+
+  def remote_profile_image_url
+    # Prefer assigned value (even on download failure, for spec compat),
+    # else CarrierWave's transient @remote_urls (for pre-migration assignments).
+    remote_profile_image_url_value || carrierwave_remote_profile_image_url
+  end
+
+  # Fix JSON serialization for ActiveStorage profile images.
+  # CarrierWave uploaders define #as_json as {"url"=>url}; ActiveStorage
+  # Attached::One does not (its default Object#as_json would recurse via
+  # record). Return the same {"url"=>...} shape for both storages so
+  # `render json:` and `as_json` (e.g., API orgs index, Trackable) work.
+  def read_attribute_for_serialization(name)
+    if name.to_s == "profile_image"
+      if profile_image_attachment.attached?
+        { "url" => profile_image_url }
+      else
+        carrierwave_profile_image
+      end
+    else
+      super
+    end
+  end
+
+  # Also handle removal: purge ActiveStorage when CarrierWave removal requested.
+  # No current code uses remove_profile_image, but handle for completeness.
+  def remove_profile_image=(value)
+    # Call CarrierWave's original (marks for removal on save).
+    # It was defined via mount_uploader; call via _mounter directly to avoid
+    # needing an alias (we didn't alias remove_...).
+    _mounter(:profile_image).remove = value
+    # Purge ActiveStorage immediately when removal requested.
+    return unless value.to_s !~ /\A0|false\z/ && value.present?
+
+    begin
+      profile_image_attachment.purge if profile_image_attachment.attached?
+    rescue StandardError => e
+      Rails.logger.error("[ProfileImageMigration] Failed to purge ActiveStorage on remove: #{e.message}")
+    end
+    self.profile_image_attachment_changed = true
+  end
+
+  private
+
+  def attach_processed_file_to_active_storage(attachable)
+    temp_uploader = ProfileImageUploader.new(self, :profile_image)
+    begin
+      temp_uploader.cache!(attachable)
+    rescue CarrierWave::IntegrityError, CarrierWave::ProcessingError => e
+      # Match CarrierWave behavior where invalid assignment stores integrity
+      # errors and fails validation (Mounter uses ignore_*=true, so it does NOT
+      # raise on assignment; see config/initializers/carrierwave defaults).
+      # Store for profile_image_processing_error_validation (e.g., Users::Update
+      # expects service failure with "Profile image File size..." not raise).
+      self.profile_image_processing_error = e.message
+      return
+    end
+    attach_temp_uploader_file_to_active_storage(temp_uploader)
+  end
+
+  def attach_temp_uploader_file_to_active_storage(temp_uploader)
+    cached_file = temp_uploader.file
+    # Empty download (e.g., stubbed "" in tests) results in nil file: leave blank.
+    if cached_file.nil? || cached_file.path.nil? || !File.exist?(cached_file.path.to_s)
+      Rails.logger.info(
+        "[ProfileImageMigration] No file cached for ActiveStorage attach " \
+        "(empty download?), leaving blank for #{self.class.name}##{id || 'new'}",
+      )
+      return
+    end
+
+    processed_path = cached_file.path.to_s
+    original_filename = cached_file.original_filename.presence || File.basename(processed_path)
+    content_type = cached_file.content_type.presence
+
+    # Read processed content into memory so we can clean up CarrierWave cache
+    # immediately (ActiveStorage upload happens later on after_commit).
+    content = File.binread(processed_path)
+    io = StringIO.new(content)
+    # StringIO needs to quack like File for ActiveStorage unfurling? It handles
+    # StringIO via upload_without_unfurling (IO.copy_stream works with StringIO).
+    # Ensure binary mode.
+    io.set_encoding(Encoding::BINARY) if io.respond_to?(:set_encoding)
+
+    self.profile_image_attachment = { io: io, filename: original_filename, content_type: content_type }
+  ensure
+    # Clean up CarrierWave temp cache for this processing (don't leave tmp files).
+    # Cache path is like public/uploads/tmp/<guid>/filename; remove the guid dir.
+    begin
+      if temp_uploader&.file&.path
+        cache_dir = File.dirname(temp_uploader.file.path.to_s)
+        # Only delete if inside uploads/tmp to be safe.
+        if cache_dir.include?("uploads/tmp")
+          FileUtils.rm_rf(cache_dir)
+        end
+      end
+    rescue StandardError => e
+      Rails.logger.error("[ProfileImageMigration] Failed to clean temp cache: #{e.message}")
+    end
+  end
+end
