diff --git a/lib/tasks/helpdesk.rake b/lib/tasks/helpdesk.rake
new file mode 100644
index 0000000..c3c0773
--- /dev/null
+++ b/lib/tasks/helpdesk.rake
@@ -0,0 +1,14 @@
+namespace :helpdesk do
+  desc "Permanently delete accounts still cancelled after 90 days, including all their data"
+  task purge_cancelled_accounts: :environment do
+    cutoff = 90.days.ago
+    scope = Account.where("cancelled_at IS NOT NULL AND cancelled_at < ?", cutoff)
+    count = scope.count
+    puts "Purging #{count} cancelled account(s) older than 90 days (cutoff: #{cutoff})..."
+    scope.find_each do |account|
+      puts "Deleting account #{account.subdomain} (id=#{account.id}, cancelled_at=#{account.cancelled_at})"
+      account.destroy!
+    end
+    puts "Done. Purged #{count} account(s)."
+  end
+end
