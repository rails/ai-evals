@@ -0,0 +1,52 @@
+module Api
+  module V1
+    class SessionsController < BaseController
+      def create
+        return unless require_account!
+        acct = @header_account
+
+        sess_params = params[:session] || params
+        email = sess_params[:email].to_s.strip.downcase
+        password = sess_params[:password].to_s
+
+        if email.blank? || password.blank?
+          render_error("Invalid email or password", :unauthorized)
+          return
+        end
+
+        user = acct.users.find_by("LOWER(email) = ?", email.downcase)
+
+        if user.nil? || !user.authenticate(password)
+          render_error("Invalid email or password", :unauthorized)
+          return
+        end
+
+        unless user.verified?
+          render_error("Email not verified", :forbidden, ["Email not verified"])
+          return
+        end
+
+        if acct.cancelled? && !user.admin?
+          render_error("Account cancelled", :forbidden, ["Account cancelled"])
+          return
+        end
+
+        # If account cancelled and user is admin, allow login to reactivate
+        session = user.sessions.create!
+
+        render json: {
+          session: session_json(session),
+          user: user_json(user),
+          account: account_json(acct)
+        }, status: :ok
+      end
+
+      def destroy
+        return unless authenticate_user!
+        sess = current_session
+        sess.destroy if sess
+        render json: { message: "Signed out" }, status: :ok
+      end
+    end
+  end
+end
