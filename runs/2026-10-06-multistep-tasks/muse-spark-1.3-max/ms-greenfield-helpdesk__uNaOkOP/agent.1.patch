@@ -0,0 +1,18 @@
+# Be sure to restart your server when you modify this file.
+
+Rails.application.config.middleware.insert_before 0, Rack::Cors do
+  allow do
+    origins do |source, _env|
+      frontend = ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001").chomp("/")
+      # source is the Origin header value, e.g. "http://localhost:3001"
+      # Normalize by removing trailing slash
+      normalized = source.to_s.chomp("/")
+      normalized == frontend
+    end
+    resource "*",
+      headers: :any,
+      methods: [:get, :post, :put, :patch, :delete, :options, :head],
+      expose: ["Authorization", "X-Helpdesk-Account"],
+      credentials: false
+  end
+end
