+  validates :origin, inclusion: { in: %w[portal email], message: "is invalid" }, allow_nil: true
 
   validate :requester_belongs_to_account
   validate :assignee_valid
 
+  def self.support_domain
+    (ENV["HELPDESK_SUPPORT_DOMAIN"].presence || "support.example.test").to_s.strip.downcase
+  end
+
+  def support_domain
+    self.class.support_domain
+  end
+
+  def plain_support_address
+    return nil unless account
+    "#{account.subdomain}@#{support_domain}"
+  end
+
+  def reply_address
+    return nil unless account && reply_token.present?
+    "#{account.subdomain}+#{reply_token}@#{support_domain}"
+  end
+
+  # Aliases for robustness
+  def reply_to_address
+    reply_address
+  end
+
+  def private_reply_address
+    reply_address
+  end
+
+  def email_origin?
+    origin.to_s == "email"
+  end
+
+  def email_channel?
+    email_origin?
+  end
+
+  def via_email?
+    email_origin?
+  end
+
   private
 
   def set_defaults
     self.status = "open" if status.blank?
     self.priority = "normal" if priority.blank?
+    self.origin = "portal" if origin.blank?
+  end
+
+  def ensure_reply_token
+    if reply_token.blank?
+      self.reply_token = generate_unique_reply_token
+    end
+  end
+
+  def generate_unique_reply_token
+    loop do
+      token = SecureRandom.hex(16)
+      unless self.class.where(reply_token: token).exists?
+        return token
+      end
+    end
   end
 
