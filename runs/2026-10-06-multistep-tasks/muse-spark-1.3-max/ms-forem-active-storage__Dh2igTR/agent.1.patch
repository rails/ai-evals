diff --git a/app/models/concerns/profile_image_attachable.rb b/app/models/concerns/profile_image_attachable.rb
new file mode 100644
index 0000000..d6911df
--- /dev/null
+++ b/app/models/concerns/profile_image_attachable.rb
@@ -0,0 +1,418 @@
+# frozen_string_literal: true
+
+# Handles the incremental migration of User/Organization profile images from
+# CarrierWave to Active Storage.
+#
+# Design (this deploy):
+# - CarrierWave stays mounted for *reads* of legacy images, but under a
+#   different attribute name (`legacy_profile_image`) sharing the same DB
+#   column (`profile_image`) via `mount_on: :profile_image`. Existing files
+#   stay where they are (S3 via fog or local file) and remain visible.
+# - Active Storage owns the `profile_image` attribute (`has_one_attached`).
+#   All *new* writes (`profile_image=` and `remote_profile_image_url=`) go to
+#   Active Storage only. The CarrierWave column is left untouched for new
+#   uploads (blank for brand-new records, stale legacy value for updates).
+# - `profile_image_url` prefers Active Storage when attached, falling back to
+#   the legacy CarrierWave URL otherwise. `profile_image_url_for` /
+#   `profile_image_90` (via `Images::Profile`) work for both storages.
+# - Other uploaders (cover images, logos, tags, podcasts, etc.) stay on
+#   CarrierWave untouched.
+#
+# Future deploys (not this one): backfill legacy CarrierWave files to Active
+# Storage, then remove the legacy mount/column.
+module ProfileImageAttachable
+  extend ActiveSupport::Concern
+
+  included do
+    # `dependent: :purge` (synchronous) avoids requiring ActiveJob queue setup
+    # (Forem uses Sidekiq directly, not ActiveJob). File deletion on destroy
+    # happens inline.
+    has_one_attached :profile_image, dependent: :purge
+    validate :validate_profile_image_attachment
+    before_save :store_profile_image_blob_id_for_change_tracking
+  end
+
+  # New writes go to Active Storage. Handles the same inputs CarrierWave did:
+  # - File / UploadedFile / Pathname (direct uploads, factories, ProfileImageGenerator)
+  # - Hash with :io (direct attach API)
+  # - ActiveStorage::Blob (direct upload)
+  # - String remote URL (e.g. Apple provider assigns mascot_image_url string in test)
+  # - nil / "" (purge scheduling, mirrors ActiveStorage behavior)
+  # - String signed blob id (direct upload)
+  def profile_image=(attachable)
+    # Fast path for purge.
+    if attachable.nil? || attachable == ""
+      super(attachable)
+      return
+    end
+
+    # String assigned directly: remote URL goes through the remote handler,
+    # everything else (signed ids) passes through to ActiveStorage.
+    if attachable.is_a?(String)
+      if attachable.start_with?("http")
+        self.remote_profile_image_url = attachable
+        return
+      end
+      super(attachable)
+      return
+    end
+
+    # File-like uploads: strip EXIF in a safe tempfile copy when appropriate,
+    # then attach the processed file.
+    processed = process_profile_image_attachable(attachable)
+    super(processed)
+  end
+
+  # CarrierWave's `remote_*_url=` downloaded a remote file on save. For Active
+  # Storage we download immediately and attach, so new remote images also go
+  # to Active Storage. Accepts both String URLs and File objects because
+  # `Images::SafeRemoteProfileImageUrl` returns a File fallback for non-http
+  # inputs and callers assign that File to `remote_profile_image_url`.
+  def remote_profile_image_url=(url_or_file)
+    # File fallback from SafeRemoteProfileImageUrl (or any file-like): attach directly.
+    if url_or_file.respond_to?(:read) || url_or_file.respond_to?(:path) || url_or_file.is_a?(Pathname)
+      # Rack::Test::UploadedFile / File / Tempfile / Pathname
+      self.profile_image = url_or_file
+      @remote_profile_image_url = nil
+      return
+    end
+
+    # Blank: nothing to do (mirrors CarrierWave rejecting blank remote urls).
+    if url_or_file.blank?
+      @remote_profile_image_url = nil
+      return
+    end
+
+    url = url_or_file.to_s
+
+    unless url.start_with?("http")
+      # Non-http string (shouldn't normally happen since SafeRemote already
+      # handled it): fall back to a generated image, mirroring SafeRemote.
+      self.profile_image = Images::ProfileImageGenerator.call
+      @remote_profile_image_url = url
+      return
+    end
+
+    @remote_profile_image_url = url
+    downloaded = download_remote_profile_image(url)
+    # `download_remote_profile_image` adds errors and returns nil on failure;
+    # leave the record's images untouched in that case (legacy still visible).
+    self.profile_image = downloaded if downloaded
+  end
+
+  def remote_profile_image_url
+    @remote_profile_image_url
+  end
+
+  # Prefer Active Storage, fall back to legacy CarrierWave. Never raises for
+  # missing images: returns nil when neither storage has an image (callers
+  # like `Images::Profile` handle nil via BACKUP_LINK).
+  def profile_image_url(*args)
+    if profile_image.attached?
+      begin
+        # Active Storage blob path, wrapped as absolute URL so production
+        # Optimizers (imgproxy / Cloudinary fetch / Cloudflare) can fetch it.
+        # In test/development this is still a valid absolute URL containing
+        # `rails/active_storage`; no request host is required (uses URL.url).
+        # NOTE: for unpersisted blobs (before save) this raises; fall back to
+        # legacy in that window (new records have no legacy, so nil).
+        path = Rails.application.routes.url_helpers.rails_blob_path(profile_image, only_path: true)
+        return URL.url(path)
+      rescue StandardError => e
+        Rails.logger.debug { "ActiveStorage profile_image_url fallback: #{e.class}: #{e.message}" }
+        # Fall through to legacy below.
+      end
+    end
+
+    # Legacy CarrierWave (same `profile_image` column via `mount_on`).
+    if respond_to?(:legacy_profile_image_url)
+      begin
+        return legacy_profile_image_url(*args)
+      rescue StandardError => e
+        Rails.logger.debug { "Legacy profile_image_url fallback failed: #{e.class}: #{e.message}" }
+        return nil
+      end
+    end
+
+    # Last resort: raw column may itself be a full URL (e.g. banished users
+    # written via update_columns, or very old data).
+    raw = has_attribute?(:profile_image) ? read_attribute(:profile_image) : nil
+    raw.presence
+  end
+
+  # Absolute URL variant for contexts that require it (e.g. Optimizer fetch
+  # in production, mailers). Falls back to relative when host unavailable.
+  def profile_image_absolute_url(*args)
+    relative_or_absolute = profile_image_url(*args)
+    return nil if relative_or_absolute.blank?
+    return relative_or_absolute if relative_or_absolute.start_with?("http")
+
+    URL.url(relative_or_absolute)
+  rescue StandardError
+    relative_or_absolute
+  end
+
+  # Whether the Active Storage attachment changed in this save (for cache
+  # busting / social image regeneration / article resaves). Complements the
+  # legacy `saved_change_to_profile_image?` (CarrierWave column) checks.
+  def profile_image_blob_id_changed?
+    return false if @profile_image_blob_id_was.nil? && profile_image_attachment&.blob_id.nil?
+
+    @profile_image_blob_id_was != profile_image_attachment&.blob_id
+  end
+
+  # Legacy CarrierWave presence (column / uploader). Used by Organization
+  # presence validation alongside Active Storage.
+  def legacy_profile_image_present?
+    return false unless has_attribute?(:profile_image)
+
+    read_attribute(:profile_image).present? ||
+      (respond_to?(:legacy_profile_image) && legacy_profile_image.present?)
+  rescue StandardError
+    read_attribute(:profile_image).present?
+  end
+
+  # Unified presence for validations / views: attached OR legacy.
+  def profile_image_present?
+    profile_image.attached? || legacy_profile_image_present?
+  end
+
+  private
+
+  def store_profile_image_blob_id_for_change_tracking
+    # Persisted attachment id *before* ActiveStorage saves pending changes in
+    # `after_save`. `profile_image_attachment` (the has_one join) still points
+    # at the old row here, while `profile_image.attachment` would return the
+    # pending (new) one. Comparing was vs current in after_save/after_commit
+    # detects Active Storage changes without extra flags.
+    @profile_image_blob_id_was = begin
+      profile_image_attachment&.blob_id
+    rescue StandardError
+      nil
+    end
+  end
+
+  # Mirrors CarrierWave's size + extension validations with identical error
+  # messages so existing specs (which stub ProfileImageUploader::MAX_FILE_SIZE)
+  # keep passing. Only validates when an Active Storage blob is present;
+  # legacy CarrierWave images are validated by CarrierWave itself.
+  def validate_profile_image_attachment
+    return unless profile_image.attached?
+
+    blob = begin
+      profile_image.blob
+    rescue StandardError
+      nil
+    end
+    return unless blob
+
+    # Size: 1..MAX_FILE_SIZE, same messages as CarrierWave::Uploader::FileSize.
+    max_size = ProfileImageUploader::MAX_FILE_SIZE
+    if blob.byte_size.to_i > max_size
+      errors.add(
+        :profile_image,
+        I18n.translate(
+          :"errors.messages.max_size_error",
+          max_size: ActiveSupport::NumberHelper.number_to_human_size(max_size),
+        ),
+      )
+    elsif blob.byte_size.to_i < 1
+      errors.add(
+        :profile_image,
+        I18n.translate(
+          :"errors.messages.min_size_error",
+          min_size: ActiveSupport::NumberHelper.number_to_human_size(1),
+        ),
+      )
+    end
+
+    # Extension allowlist, same message as CarrierWave.
+    allowlist = BaseUploader::EXTENSION_ALLOWLIST
+    filename = blob.filename.to_s
+    extension = File.extname(filename).delete_prefix(".").downcase
+    # Fall back to content-type derived extension when filename has none
+    # (e.g. remote downloads with generic names).
+    if extension.blank? && blob.content_type.present?
+      extension = Mime::Type.lookup(blob.content_type)&.symbol.to_s
+    end
+    unless allowlist.any? { |item| extension =~ /\A#{item}\z/i }
+      errors.add(
+        :profile_image,
+        I18n.translate(
+          :"errors.messages.extension_allowlist_error",
+          extension: File.extname(filename).delete_prefix(".").inspect,
+          allowed_types: Array(allowlist).join(", "),
+        ),
+      )
+    end
+
+    # Frame count (image bombs): same limit as BaseUploader::FRAME_MAX.
+    # Only check pending uploads (attachment_changes present) to avoid
+    # re-analyzing every save; failures surface as validation errors like
+    # CarrierWave's IntegrityError.
+    validate_profile_image_frame_count(blob)
+  rescue StandardError => e
+    Rails.logger.debug { "profile_image_attachment validation fallback: #{e.class}: #{e.message}" }
+  end
+
+  def validate_profile_image_frame_count(blob)
+    return unless ProfileImageUploader.enable_processing
+    change = respond_to?(:attachment_changes) ? attachment_changes["profile_image"] : nil
+    return unless change.respond_to?(:attachable)
+
+    attachable = change.attachable
+    path = profile_image_attachable_path(attachable)
+    return unless path && File.exist?(path)
+
+    begin
+      frames = MiniMagick::Image.new(path).frames.count
+    rescue Timeout::Error
+      errors.add(:profile_image, I18n.t("uploaders.base_uploader.timeout"))
+      return
+    rescue StandardError
+      # If we can't analyze (non-image, truncated), let other validations
+      # / ActiveStorage handle it; don't add a duplicate error here.
+      return
+    end
+
+    if frames > BaseUploader::FRAME_MAX
+      errors.add(
+        :profile_image,
+        I18n.t("uploaders.base_uploader.too_many_frames", frame_max: BaseUploader::FRAME_MAX),
+      )
+    end
+  end
+
+  # EXIF stripping + auto-orient for new uploads, mirroring
+  # BaseUploader#strip_exif. Operates on a tempfile copy when the source is a
+  # shared asset (ProfileImageGenerator) to avoid mutating repo files; for
+  # user tempfiles it processes in place. Returns an attachable suitable for
+  # `super` (original object when no processing needed).
+  def process_profile_image_attachable(attachable)
+    # Mirror CarrierWave test behavior: no processing when disabled (test env).
+    return attachable unless ProfileImageUploader.enable_processing
+    # Hash ({io:, filename:, content_type:}) and Blob pass through; EXIF for
+    # those paths is handled at download/creation time.
+    return attachable if attachable.is_a?(Hash) || attachable.is_a?(ActiveStorage::Blob)
+
+    path = profile_image_attachable_path(attachable)
+    return attachable unless path && File.exist?(path)
+
+    # Skip shared app assets (ProfileImageGenerator opens files under
+    # app/assets): they're already clean and must not be mutated.
+    assets_root = Rails.root.join("app/assets").to_s
+    return attachable if path.start_with?(assets_root)
+
+    # Skip SVG (no EXIF) and non-image extensions early.
+    ext = File.extname(profile_image_attachable_filename(attachable)).downcase.delete_prefix(".")
+    return attachable if ext == "svg"
+
+    begin
+      image = MiniMagick::Image.new(path)
+      # Mirror BaseUploader: skip stripping very large frame counts.
+      if image.frames.count > BaseUploader::FRAME_STRIP_MAX
+        image.auto_orient
+        image.write(path)
+      else
+        image.auto_orient
+        image.strip
+        image.write(path)
+      end
+    rescue StandardError => e
+      Rails.logger.debug { "profile_image EXIF strip skipped: #{e.class}: #{e.message}" }
+    end
+
+    attachable
+  end
+
+  def profile_image_attachable_path(attachable)
+    if attachable.respond_to?(:path) && attachable.path.is_a?(String)
+      attachable.path
+    elsif attachable.is_a?(Pathname)
+      attachable.to_s
+    elsif attachable.respond_to?(:tempfile) && attachable.tempfile.respond_to?(:path)
+      attachable.tempfile.path
+    elsif attachable.is_a?(Hash) && attachable[:io].respond_to?(:path)
+      attachable[:io].path
+    end
+  rescue StandardError
+    nil
+  end
+
+  def profile_image_attachable_filename(attachable)
+    if attachable.respond_to?(:original_filename) && attachable.original_filename.present?
+      attachable.original_filename.to_s
+    elsif attachable.respond_to?(:path) && attachable.path.is_a?(String)
+      File.basename(attachable.path)
+    elsif attachable.is_a?(Pathname)
+      attachable.basename.to_s
+    elsif attachable.is_a?(Hash) && attachable[:filename].present?
+      attachable[:filename].to_s
+    else
+      ""
+    end
+  end
+
+  # Download a remote profile image to a tempfile for Active Storage.
+  # Uses CarrierWave's downloader semantics (SSRF protection in production,
+  # stubbed in specs via ProfileImageUploader#download!) by delegating to a
+  # throwaway ProfileImageUploader instance, then wraps the result as an
+  # UploadedFile-like attachable.
+  def download_remote_profile_image(url)
+    uploader = ProfileImageUploader.new(self, :profile_image)
+    begin
+      uploader.download!(url)
+    rescue StandardError => e
+      errors.add(:profile_image, e.message)
+      return nil
+    end
+
+    file = uploader.file
+    # Mirror CarrierWave cache! `return if empty?`: stubbed empty downloads
+    # (dummyimage.com stubbed to "" in specs) yield no file and no error.
+    if file.nil? || file.path.blank? || !File.exist?(file.path.to_s) || File.size(file.path.to_s).zero?
+      return nil
+    end
+
+    # Preserve the remote filename when available; fall back to a generic name.
+    filename = begin
+      File.basename(URI.parse(url).path.presence || "profile_image")
+    rescue StandardError
+      "profile_image"
+    end
+    filename = "profile_image" if filename.blank? || filename == "/"
+    # Ensure an image extension so content-type identification works.
+    unless filename.match?(/\.(jpg|jpeg|jpe|gif|png|ico|bmp|dng|webp)\z/i)
+      content_type = file.content_type.to_s
+      ext = Mime::Type.lookup(content_type)&.symbol.to_s
+      ext = "jpg" if ext.blank?
+      filename = "#{filename}.#{ext}"
+    end
+
+    content_type = file.content_type.presence || "image/jpeg"
+
+    # Strip EXIF from the downloaded tempfile in place (mirrors BaseUploader).
+    # Skipped when processing disabled (test env), like CarrierWave.
+    if ProfileImageUploader.enable_processing
+      begin
+        image = MiniMagick::Image.new(file.path)
+        if image.frames.count > BaseUploader::FRAME_STRIP_MAX
+          image.auto_orient
+          image.write(file.path)
+        else
+          image.auto_orient
+          image.strip
+          image.write(file.path)
+        end
+      rescue StandardError => e
+        Rails.logger.debug { "remote profile image EXIF strip skipped: #{e.class}: #{e.message}" }
+      end
+    end
+
+    { io: File.open(file.path, "rb"), filename: filename, content_type: content_type }
+  rescue StandardError => e
+    Rails.logger.debug { "remote profile image download failed: #{e.class}: #{e.message}" }
+    errors.add(:profile_image, I18n.t("errors.messages.carrierwave_download_error"))
+    nil
+  end
+end
