diff --git a/spec/rails_helper.rb b/spec/rails_helper.rb
index a91461b..07810a3 100644
--- a/spec/rails_helper.rb
+++ b/spec/rails_helper.rb
@@ -109,6 +109,35 @@ RSpec.configure do |config|
     Sidekiq.testing!(:inline)
   end
 
+  # Optimize `spec/models`: stub expensive Sidekiq workers that are triggered
+  # on every fabrication (e.g. `TriggerWebhookWorker` on every local account/user/status)
+  # but never asserted via `enqueue_sidekiq_job` in model specs.
+  # Keeps `inline` mode (required for `capture_emails` mailer specs) while skipping
+  # costly webhook serialization/queries and feed merges.
+  # Opt-out per-example with `sidekiq_inline: true` if real inline execution is needed.
+  # See `docs/rspec-optimization.md` for profiling details.
+  config.before(:each, type: :model) do |example|
+    unless example.metadata[:sidekiq_inline]
+      allow(TriggerWebhookWorker).to receive(:perform_async)
+    end
+
+    # Opt-in stub for expensive Paperclip processing (`MediaAttachment#post_process`,
+    # ~0.05-0.46s per assignment via ImageMagick/ffmpeg/blurhash). Use tag
+    # `media_processing: :stub` on examples that assign a file but never assert
+    # file content/meta/type from processing (e.g. `needs_redownload?`, `#to_param`).
+    # Only skips for `MediaAttachment` instances; other attachments (Account avatar)
+    # still use real processing.
+    if example.metadata[:media_processing] == :stub
+      allow_any_instance_of(Paperclip::Attachment).to receive(:post_process).and_wrap_original do |m, *args|
+        if m.receiver.instance.is_a?(MediaAttachment)
+          true
+        else
+          m.call(*args)
+        end
+      end
+    end
+  end
+
   config.before :each, type: :cli do
     stub_reset_connection_pools
   end
