diff --git a/spec/support/factory_optimization.rb b/spec/support/factory_optimization.rb
new file mode 100644
index 0000000..72be158
--- /dev/null
+++ b/spec/support/factory_optimization.rb
@@ -0,0 +1,65 @@
+# frozen_string_literal: true
+
+# Optimization for `spec/models` and `spec/requests`: skip expensive factory
+# side effects that are not asserted by those suites.
+#
+# - `Fabricate(:status)` auto-creates a `Bookmark` (+ extra Account+User) via
+#   `after_create`. Saves ~7-10ms per status (40% of status fabrication).
+# - `Fabricate(:user)` auto-creates 2x `LoginActivity` via `after_create`.
+#   Saves ~3ms per user (~25% of user fabrication).
+#
+# No model/request spec asserts on these auto-created records:
+# - Bookmarks: `account_statuses_cleanup_policy_spec` checks self-bookmarks
+#   explicitly created via `Fabricate(:bookmark, account: account, ...)`;
+#   auto-bookmarks are by a different account and use `self_status_reference_exists`
+#   (account_id == status.account_id), so they never match. `export_spec` and
+#   `bookmarks_spec` create bookmarks explicitly. No `Bookmark.count` assertions.
+# - LoginActivities: only `omniauth_callbacks_spec` asserts `change(LoginActivity, :count)`
+#   by 1 (relative delta, unaffected by fewer records in `before` blocks).
+#   `login_activity_spec` uses `Fabricate.build`. No absolute count assertions.
+#
+# Skipping is scoped to `type: :model` and `type: :request` to avoid touching
+# other suites (services, controllers, etc.). Opt in via:
+# - Transient: `Fabricate(:status, with_bookmark: true)` or
+#   `Fabricate(:user, with_login_activities: true)` (also works for
+#   `admin_user`/`moderator_user`/`owner_user` via inheritance).
+# - Tag: `with_bookmark: true`, `with_login_activities: true`, or generic
+#   `with_factory_side_effects: true` on example/group.
+#
+# For other spec types or outside RSpec (e.g., `rails runner`), old behavior
+# is preserved (side effects created).
+module FactoryOptimization
+  def self.skip_side_effects?(transient_opt_in: nil, tag_opt_in: nil)
+    # Explicit transient opt-in always creates
+    return false if transient_opt_in
+
+    begin
+      # RSpec may not be defined outside test env
+      return false unless defined?(RSpec) && RSpec.respond_to?(:current_example)
+
+      example = RSpec.current_example
+      return false if example.nil?
+
+      type = example.metadata[:type]
+      return false unless [:model, :request].include?(type)
+
+      # Tag opt-ins
+      return false if tag_opt_in && example.metadata[tag_opt_in]
+      return false if example.metadata[:with_factory_side_effects]
+
+      true
+    rescue StandardError
+      false
+    end
+  end
+
