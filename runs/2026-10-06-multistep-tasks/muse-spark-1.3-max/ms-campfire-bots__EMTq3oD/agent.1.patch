diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..6fc0886
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,46 @@
+class Bots::MessagesController < ApplicationController
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  before_action :set_bot
+  before_action :set_room
+
+  def create
+    body = raw_message_body
+
+    if body.blank?
+      head :unprocessable_entity
+    else
+      @message = @room.messages.create!(body: body, creator: @bot)
+      @message.broadcast_create
+
+      response.set_header("Location", message_path(@message))
+      head :created
+    end
+  end
+
+  private
+    def set_bot
+      @bot = Bot.active.find_by(bot_code: params[:bot_code])
+      head :unauthorized unless @bot
+    end
+
+    def set_room
+      return if performed?
+
+      @room = Room.find_by(id: params[:room_id])
+
+      if @room.nil? || !@room.memberships.exists?(user_id: @bot.id)
+        head :not_found
+      end
+    end
+
+    def raw_message_body
+      request.body.rewind
+      body = request.body.read.to_s.dup.force_encoding(Encoding::UTF_8)
+      body = body.scrub.strip
+      body
+    rescue StandardError
+      ""
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..aa74c7e
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,59 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+  before_action :ensure_can_administer_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = bots_scope.ordered
+  end
+
+  def new
+    @bot = Bot.new
+  end
+
+  def create
+    @bot = Current.user.created_bots.new(bot_params)
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url
+  end
+
+  private
+    def set_bot
+      @bot = Bot.active.find(params[:id])
+    end
+
+    def ensure_can_administer_bot
+      head :forbidden unless Current.user.can_administer?(@bot)
+    end
+
+    def bots_scope
+      if Current.user.administrator?
+        Bot.active
+      else
+        Current.user.created_bots.active
+      end
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
