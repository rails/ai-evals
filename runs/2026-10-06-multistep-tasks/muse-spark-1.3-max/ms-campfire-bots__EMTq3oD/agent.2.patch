diff --git a/test/integration/bot_webhook_integration_test.rb b/test/integration/bot_webhook_integration_test.rb
new file mode 100644
index 0000000..6b753bf
--- /dev/null
+++ b/test/integration/bot_webhook_integration_test.rb
@@ -0,0 +1,120 @@
+require "test_helper"
+
+class BotWebhookIntegrationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "bot new form has Webhook URL field" do
+    get new_bot_url
+    assert_response :success
+    assert_select "label", text: /Webhook URL/
+    assert_select "input[name='bot[webhook_url]']"
+  end
+
+  test "bot edit form has Webhook URL field" do
+    bot = Bot.create!(name: "FormBot", creator: users(:david))
+    get edit_bot_url(bot)
+    assert_response :success
+    assert_select "label", text: /Webhook URL/
+    assert_select "input[name='bot[webhook_url]']"
+    bot.destroy
+  end
+
+  test "creating bot with webhook_url saves it" do
+    post bots_url, params: { bot: { name: "HookBot", webhook_url: "https://example.com/hook" } }
+    assert_redirected_to bots_url
+    bot = Bot.find_by(name: "HookBot")
+    assert_equal "https://example.com/hook", bot.webhook_url
+    bot.destroy
+  end
+
+  test "updating bot with empty webhook_url removes it" do
+    bot = Bot.create!(name: "RemoveBot", webhook_url: "https://example.com/hook", creator: users(:david))
+    patch bot_url(bot), params: { bot: { name: "RemoveBot", webhook_url: "" } }
+    assert_redirected_to bots_url
+    assert_nil bot.reload.webhook_url
+    bot.destroy
+  end
+
+  test "bots appear in autocomplete" do
+    bot = Bot.create!(name: "AutoCompleteBot", creator: users(:david))
+    # Open room auto-joins
+    room = rooms(:pets)
+    assert_includes room.users, bot
+    get autocompletable_users_url(room_id: room.id, format: :json), params: { query: "AutoComplete" }
+    assert_response :success
+    assert_equal "AutoCompleteBot", response.parsed_body.first["name"]
+    bot.destroy
+  end
+
+  test "mentioning bot enqueues webhook job" do
+    bot = Bot.create!(name: "MentionBot", webhook_url: "https://example.com/hook", creator: users(:david))
+    room = rooms(:pets)
+    assert_enqueued_jobs 1, only: Bot::MentionJob do
+      room.messages.create!(body: "<div>Hey #{mention_attachment_for_bot(bot)} hello</div>", creator: users(:david), client_message_id: "test-mention-#{rand(100000)}")
+    end
+    # Cleanup
+    room.messages.where(creator: users(:david)).order(:created_at).last.destroy
+    bot.destroy
+  end
+
+  test "mentioning bot without webhook does not enqueue" do
+    bot = Bot.create!(name: "NoHookBot", creator: users(:david))
+    room = rooms(:pets)
+    assert_no_enqueued_jobs only: Bot::MentionJob do
+      msg = room.messages.create!(body: "<div>Hey #{mention_attachment_for_bot(bot)} hello</div>", creator: users(:david), client_message_id: "test-nohook-#{rand(100000)}")
+      msg.destroy
+    end
+    bot.destroy
+  end
+
+  test "bot async posting via reply_to works" do
+    bot = Bot.create!(name: "AsyncBot", creator: users(:david))
+    room = rooms(:pets)
+    # Bot auto-joins open room
+    assert room.memberships.exists?(user_id: bot.id)
+    post bot_room_messages_url(room_id: room.id, bot_code: bot.bot_code), params: "async hello", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :created
+    assert_equal "async hello", room.messages.order(:created_at).last.plain_text_body
+    assert_equal bot, room.messages.order(:created_at).last.creator
+    room.messages.order(:created_at).last.destroy
+    bot.destroy
+  end
+
+  test "webhook 200 posts reply, 204 does not" do
+    bot = Bot.create!(name: "WebhookBot", webhook_url: "https://example.com/hook", creator: users(:david))
+    room = rooms(:pets)
+    html = "<div><action-text-attachment sgid=\"#{bot.attachable_sgid}\" content-type=\"application/vnd.campfire.mention\"></action-text-attachment> do work</div>"
+    msg = room.messages.create!(body: html, creator: users(:david), client_message_id: "webhook-test-#{rand(100000)}")
+
+    # Stub 200
+    stub_request(:post, "https://example.com/hook").to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "sync reply")
+    assert_difference -> { room.messages.count }, 1 do
+      perform_enqueued_jobs only: Bot::MentionJob
+    end
+    assert_equal "sync reply", room.messages.order(:created_at).last.plain_text_body
+    room.messages.order(:created_at).last.destroy
+
+    # Second message with 204
+    msg2 = room.messages.create!(body: html, creator: users(:david), client_message_id: "webhook-test2-#{rand(100000)}")
+    stub_request(:post, "https://example.com/hook").to_return(status: 204)
+    assert_no_difference -> { room.messages.count } do
+      # Need to account for msg2 already created, so count includes it. We want no new bot message.
+      # perform job should not create new message.
+      before = room.messages.count
+      perform_enqueued_jobs only: Bot::MentionJob
+      after = room.messages.count
+      assert_equal before, after
+    end
+    msg.destroy
+    msg2.destroy
+    bot.destroy
+  end
+
+  private
+    def mention_attachment_for_bot(bot)
+      attachment_body = ApplicationController.render partial: "users/mention", locals: { user: bot }
+      "<action-text-attachment sgid=\"#{bot.attachable_sgid}\" content-type=\"application/vnd.campfire.mention\" content=\"#{attachment_body.gsub('"', '&quot;')}\"></action-text-attachment>"
+    end
+end
