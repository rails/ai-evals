diff --git a/app/jobs/bot/mention_job.rb b/app/jobs/bot/mention_job.rb
new file mode 100644
index 0000000..2d72b56
--- /dev/null
+++ b/app/jobs/bot/mention_job.rb
@@ -0,0 +1,144 @@
+require "net/http"
+require "uri"
+require "json"
+
+class Bot::MentionJob < ApplicationJob
+  queue_as :default
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bot, message)
+    return unless bot.is_a?(Bot)
+    return unless bot.active? && bot.webhook_url.present?
+
+    room = message.room
+    return unless room
+
+    ensure_bot_membership(room, bot)
+
+    payload = build_payload(bot, message)
+
+    deliver(bot, room, payload)
+  rescue StandardError => e
+    Rails.logger.error "Bot::MentionJob failed for bot #{bot.try(:id)} message #{message.try(:id)}: #{e.class} #{e.message}"
+    Rails.logger.error e.backtrace&.first(10)&.join("\n")
+    nil
+  end
+
+  private
+    def ensure_bot_membership(room, bot)
+      room.memberships.find_or_create_by(user: bot)
+    rescue ActiveRecord::RecordNotUnique
+    end
+
+    def build_payload(bot, message)
+      room = message.room
+      author = message.creator
+      routes = Rails.application.routes.url_helpers
+
+      {
+        event: "mention",
+        author: { id: author.id, name: author.name },
+        room: {
+          id: room.id,
+          name: room.name,
+          reply_to: routes.bot_room_messages_path(room_id: room.id, bot_code: bot.bot_code)
+        },
+        message: {
+          id: message.id,
+          body: {
+            text: stripped_text(bot, message),
+            html: rich_text_html(message)
+          },
+          link: routes.room_at_message_path(room, message)
+        }
+      }
+    end
+
+    def stripped_text(bot, message)
+      text = message.plain_text_body.to_s
+      raw_mention = "@#{bot.name}"
+      text = text.gsub(raw_mention, "")
+
+      begin
+        token = plain_mention_token(bot)
+        if token.present? && token != raw_mention
+          text = text.gsub(token, "")
+        end
+      rescue StandardError
+      end
+
+      text.strip.gsub(/[ \t]{2,}/, " ").strip
+    end
+
+    def plain_mention_token(bot)
+      html = %(<div><action-text-attachment sgid="#{bot.attachable_sgid}" content-type="application/vnd.campfire.mention"></action-text-attachment></div>)
+      ActionText::Content.new(html).to_plain_text.to_s.strip
+    end
+
+    def rich_text_html(message)
+      message.body.body&.to_html.to_s
+    rescue StandardError
+      ""
+    end
+
+    def deliver(bot, room, payload)
+      uri = URI.parse(bot.webhook_url.to_s.strip)
+      return unless uri.is_a?(URI::HTTP) && uri.host.present?
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = 5
+      http.read_timeout = 10
+      http.write_timeout = 10 if http.respond_to?(:write_timeout=)
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request["Content-Type"] = "application/json"
+      request["Accept"] = "text/plain, text/html"
+      request.basic_auth(URI.decode_www_form_component(uri.user.to_s), URI.decode_www_form_component(uri.password.to_s)) if uri.user.present?
+      request.body = payload.to_json
+
+      response = http.request(request)
+      handle_response(bot, room, response)
+    rescue URI::InvalidURIError => e
+      Rails.logger.error "Bot::MentionJob invalid webhook URL for bot #{bot.id}: #{e.message}"
+      nil
+    rescue Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNREFUSED, Errno::EHOSTUNREACH, Errno::ECONNRESET, SocketError, OpenSSL::SSL::SSLError, IOError, EOFError => e
+      Rails.logger.error "Bot::MentionJob network error for bot #{bot.id} (#{bot.webhook_url}): #{e.class} #{e.message}"
+      nil
+    end
+
+    def handle_response(bot, room, response)
+      case response.code.to_i
+      when 200
+        content_type = response_content_type(response)
+        if %w[text/plain text/html].include?(content_type)
+          body = response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub.strip
+          if body.present?
+            post_bot_message(room, bot, body)
+          end
+        end
+      when 204
+      else
+        Rails.logger.info "Bot::MentionJob bot #{bot.id} webhook returned #{response.code}, ignoring"
+      end
+    rescue StandardError => e
+      Rails.logger.error "Bot::MentionJob handle_response failed for bot #{bot.id}: #{e.class} #{e.message}"
+      nil
+    end
+
+    def response_content_type(response)
+      type = response.content_type.to_s.split(";").first.to_s.strip.downcase
+      type.presence
+    rescue StandardError
+      nil
+    end
+
+    def post_bot_message(room, bot, body)
+      message = room.messages.create!(body: body, creator: bot)
+      message.broadcast_create
+    rescue StandardError => e
+      Rails.logger.error "Bot::MentionJob failed to post bot #{bot.id} reply: #{e.class} #{e.message}"
+      nil
+    end
+end
