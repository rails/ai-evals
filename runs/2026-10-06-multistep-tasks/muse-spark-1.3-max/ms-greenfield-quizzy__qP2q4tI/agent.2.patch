+<% content_for(:title, "Quizzy · Import quiz") %>
+<header class="admin-header">
+  <span class="logo"><span class="logo__mark">?</span>Quizzy</span>
+  <span class="admin-header__tag">Moderator</span>
+</header>
+
+<main class="admin-main">
+  <div class="breadcrumbs"><a href="<%= moderate_root_path %>">← All quizzes</a></div>
+  <div class="page-head"><h1>Import quiz</h1></div>
+
+  <div class="card">
+    <form action="<%= moderate_import_path %>" method="post">
+      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
+
+      <% if @errors.present? && @errors.any? %>
+        <div class="errors">
+          <ul>
+            <% @errors.each do |msg| %>
+              <li><%= h msg %></li>
+            <% end %>
+          </ul>
+        </div>
+      <% end %>
+
+      <div class="field">
+        <label for="quiz_json">Quiz JSON</label>
+        <textarea id="quiz_json" name="quiz_json" class="input" rows="20" placeholder="Quiz JSON" aria-label="Quiz JSON"><%= h @quiz_json %></textarea>
+      </div>
+
+      <div class="buttons">
+        <button type="submit" class="btn btn--pink">Import</button>
+        <a class="btn btn--ghost" href="<%= moderate_root_path %>">Cancel</a>
+      </div>
+    </form>
+  </div>
+</main>
