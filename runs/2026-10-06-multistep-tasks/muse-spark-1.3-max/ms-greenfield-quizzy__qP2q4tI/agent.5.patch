+    "#{status}|#{current_index}|#{winners_key}|#{winners_count_value}|#{timer_total_seconds}"
   end
 
+  # --- Timer (per-question countdown) ---
+  # Timer duration is a live quiz setting (minutes + seconds). 0/0 means no timer.
+  # Countdown starts at opened_at (set when question opens) and survives reloads
+  # because opened_at persists in DB. At 0:00 the question auto-finishes.
+
+  def timer_total_seconds
+    q = quiz
+    return 0 unless q
+    begin
+      if q.respond_to?(:timer_total_seconds)
+        v = q.timer_total_seconds
+        v = v.to_i
+        return v < 0 ? 0 : v
+      elsif q.respond_to?(:timer_minutes) && q.respond_to?(:timer_seconds)
+        mins = q.timer_minutes.to_i
+        secs = q.timer_seconds.to_i
+        total = mins * 60 + secs
+        return total < 0 ? 0 : total
+      else
+        return 0
+      end
+    rescue StandardError
+      0
+    end
+  end
+
+  def timer_enabled?
+    timer_total_seconds > 0
+  end
+
+  def expires_at
+    return nil unless open?
+    return nil unless timer_enabled?
+    return nil unless opened_at
+    opened_at + timer_total_seconds.seconds
+  end
+
+  def seconds_remaining(now = nil)
+    return nil unless open? && timer_enabled? && opened_at
+    now ||= Time.current
+    exp = expires_at
+    return nil unless exp
+    diff = exp.to_f - now.to_f
+    rem = diff.ceil
+    rem = 0 if rem < 0
+    rem
+  end
+
+  def self.format_timer(total_seconds)
+    total_seconds = total_seconds.to_i
+    total_seconds = 0 if total_seconds < 0
+    "#{total_seconds / 60}:#{(total_seconds % 60).to_s.rjust(2, "0")}"
+  end
+
+  def timer_text(now = nil)
+    rem = seconds_remaining(now)
+    return nil if rem.nil?
+    self.class.format_timer(rem)
+  end
+
+  def timer_expired?(now = nil)
+    return false unless open? && timer_enabled? && opened_at
+    now ||= Time.current
+    exp = expires_at
+    return false unless exp
+    now.to_f >= exp.to_f
+  end
+
+  def expire_open_question_if_needed!(now = nil)
+    now ||= Time.current
+    return false unless open?
+    if timer_expired?(now)
+      finish_question!
+    else
+      false
+    end
+  end
