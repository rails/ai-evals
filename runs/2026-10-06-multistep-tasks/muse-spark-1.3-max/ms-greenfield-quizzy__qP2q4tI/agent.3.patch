+    </div>
+    <% status_cls = @feedback == "Correct!" ? "play-status--right" : (@feedback == "Wrong!" ? "play-status--wrong" : "play-status--neutral") %>
+    <div class="play-status <%= status_cls %>"><%= h @feedback %></div>
+  </div>
+<% end %>
diff --git a/app/views/play/show.html.erb b/app/views/play/show.html.erb
new file mode 100644
index 0000000..581870d
--- /dev/null
+++ b/app/views/play/show.html.erb
@@ -0,0 +1,170 @@
+<% content_for(:title, "Quizzy · Play") %>
+<div class="play" id="play-root"
+     data-version="<%= h @version %>"
+     data-state-url="<%= play_state_path(code: @game.code) %>"
+     data-content-url="<%= play_content_path(code: @game.code) %>">
+  <%= render "content" %>
+</div>
+
+<script>
+(function() {
+  var root = document.getElementById('play-root');
+  if (!root) return;
+  var stateUrl = root.getAttribute('data-state-url');
+  var contentUrl = root.getAttribute('data-content-url');
+  var fetchingContent = false;
+
+  function cleanUrl(path) {
+    try {
+      if (path && path.charAt(0) === '/') {
+        return window.location.protocol + '//' + window.location.host + path;
+      }
+    } catch(e) {}
+    return path;
+  }
+
+  function csrfToken() {
+    var m = document.querySelector('meta[name="csrf-token"]');
+    return m ? m.getAttribute('content') : '';
+  }
+
+  function refreshContent(newVersion) {
+    if (fetchingContent) return;
+    fetchingContent = true;
+    fetch(cleanUrl(contentUrl), { headers: { 'Accept': 'text/html' }, credentials: 'same-origin', cache: 'no-store' })
+      .then(function(resp) {
+        if (!resp.ok) { fetchingContent = false; return null; }
+        return resp.text();
+      })
+      .then(function(html) {
+        fetchingContent = false;
+        if (html !== null) {
+          // Preserve join-form input if both old and new are join forms (should not happen for anon-join constant,
+          // but be safe: save input value and restore after replace)
+          var oldInput = root.querySelector('#player_name');
+          var oldVal = oldInput ? oldInput.value : null;
+          var oldFocused = oldInput ? (document.activeElement === oldInput) : false;
+          root.innerHTML = html;
+          if (newVersion) {
+            root.setAttribute('data-version', newVersion);
+          }
+          if (oldVal !== null) {
+            var newInput = root.querySelector('#player_name');
+            if (newInput && html.indexOf('player_name') !== -1) {
+              // Both old and new have join form: restore typed value (avoid clearing on spurious refresh)
+              // Only restore if new input is empty (server renders empty)
+              if (!newInput.value) {
+                newInput.value = oldVal;
+              }
+              if (oldFocused) {
+                try { newInput.focus(); } catch(e) {}
+              }
+            }
+          }
+        }
+      })
+      .catch(function() { fetchingContent = false; });
+  }
+
+  function pollState() {
+    fetch(cleanUrl(stateUrl), { headers: { 'Accept': 'application/json' }, credentials: 'same-origin', cache: 'no-store' })
+      .then(function(resp) {
+        if (!resp.ok) return null;
+        return resp.json();
+      })
+      .then(function(data) {
+        if (!data || !data.version) return;
+        var cur = root.getAttribute('data-version');
+        if (data.version !== cur) {
+          refreshContent(data.version);
+        }
+      })
+      .catch(function() { /* crowded WiFi: ignore and retry */ });
+  }
+
+  // Answer submission via fetch (no reload), with fallback to normal form if JS fails
+  // Use event delegation so it survives content replacement
+  root.addEventListener('submit', function(ev) {
+    var form = ev.target;
+    if (!form || !form.hasAttribute || !form.hasAttribute('data-option-form')) return;
+    // Only intercept option forms, not join form
+    ev.preventDefault();
+    var action = form.getAttribute('action');
+    var optInput = form.querySelector('input[name="option_id"]');
+    var optId = optInput ? optInput.value : '';
+    if (!optId) return;
+    var token = csrfToken();
+    // Optimistic UI: mark tapped option immediately (snappy on conference WiFi)
+    try {
+      var allBtns = root.querySelectorAll('button.play-option');
+      for (var i = 0; i < allBtns.length; i++) {
+        var b = allBtns[i];
+        var isTarget = (b.getAttribute('data-option-id') === String(optId));
+        if (isTarget) {
+          b.classList.add('is-picked');
+          if (!b.querySelector('.play-option__mark')) {
+            var s = document.createElement('span');
+            s.className = 'play-option__mark';
+            s.textContent = 'Your answer';
+            b.appendChild(s);
+          }
+        } else {
+          b.classList.remove('is-picked');
+          var m = b.querySelector('.play-option__mark');
+          if (m) m.remove();
+        }
+      }
+    } catch(e) {}
+
+    fetch(cleanUrl(action), {
+      method: 'POST',
+      headers: {
+        'Accept': 'application/json',
+        'Content-Type': 'application/x-www-form-urlencoded',
+        'X-CSRF-Token': token,
+        'X-Requested-With': 'XMLHttpRequest'
+      },
+      credentials: 'same-origin',
+      cache: 'no-store',
+      body: 'option_id=' + encodeURIComponent(optId)
+    })
+    .then(function(resp) {
+      if (resp.ok) {
+        return resp.json().then(function(data) {
+          if (data && data.version) {
+            root.setAttribute('data-version', data.version);
+          }
+          // Server confirms; polling will keep in sync. No need to refresh content
+          // since optimistic UI already shows Your answer.
+        });
+      } else if (resp.status === 422) {
+        // Likely question closed (stale tap after Finish): force refresh to closed view
+        return resp.json().then(function(data) {
+          var v = (data && data.version) ? data.version : null;
+          // Fetch fresh state to get current version, then content
+          return fetch(cleanUrl(stateUrl), { headers: { 'Accept': 'application/json' }, credentials: 'same-origin', cache: 'no-store' })
+            .then(function(r) { return r.ok ? r.json() : null; })
+            .then(function(sd) {
+              if (sd && sd.version) {
+                refreshContent(sd.version);
+              } else if (v) {
+                refreshContent(v);
+              } else {
+                pollState();
+              }
+            });
+        }).catch(function() { pollState(); });
+      } else {
+        // Other error (e.g., network): revert optimistic? Poll to resync
+        pollState();
+      }
+    })
+    .catch(function() {
+      // Network blip on crowded WiFi: keep optimistic UI, polling will resync
+      // Do not show error; retry via polling
+    });
+  });
+
+  setInterval(pollState, 500);
+})();
+</script>
