+      <% end %>
+      <div class="field">
+        <label for="player_name">Your name</label>
+        <input id="player_name" name="name" type="text" class="input" placeholder="Your name" aria-label="Your name" required autocomplete="nickname" maxlength="50">
+      </div>
+      <button type="submit" class="btn btn--pink">Join</button>
+    </form>
+  </div>
+<% elsif @game.lobby? %>
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span>Hi, <%= h @player.name %>!</span>
+  </div>
+  <div class="play__body">
+    <div class="waiting">
+      <div class="waiting__gem" aria-hidden="true">?</div>
+      <div class="play-lead">Hi, <%= h @player.name %>!</div>
+      <div class="muted">Waiting for the quiz to start…</div>
+    </div>
+  </div>
+<% elsif @game.open? %>
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span>Hi, <%= h @player.name %>!</span>
+  </div>
+  <div class="play__body play__body--top">
+    <div class="play-question__num"><%= h @progress %></div>
+    <div class="play-question__body"><%= h @question.body %></div>
+    <div class="play-options" id="play-options">
+      <% @options.each_with_index do |opt, i| %>
+        <% letter = ("A".ord + i).chr %>
+        <% is_picked = (opt.id == @picked_id) %>
+        <form action="<%= play_answer_path(code: @game.code) %>" method="post" data-option-form>
+          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
+          <input type="hidden" name="option_id" value="<%= opt.id %>">
+          <button type="submit" class="play-option <%= "is-picked" if is_picked %>" data-option-id="<%= opt.id %>">
+            <span class="play-option__letter"><%= letter %></span>
+            <span class="play-option__title"><%= h opt.text %></span>
+            <% if is_picked %>
+              <span class="play-option__mark">Your answer</span>
+            <% end %>
+          </button>
+        </form>
+      <% end %>
+    </div>
+  </div>
+<% elsif @game.closed? %>
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span>Hi, <%= h @player.name %>!</span>
+  </div>
+  <div class="play__body play__body--top">
+    <div class="play-question__num"><%= h @progress %></div>
+    <div class="play-question__body"><%= h @question.body %></div>
+    <div class="play-options is-revealed is-locked">
+      <% @options.each_with_index do |opt, i| %>
+        <% letter = ("A".ord + i).chr %>
+        <% is_picked = (opt.id == @picked_id) %>
+        <div class="play-option <%= "is-picked" if is_picked %>">
+          <span class="play-option__letter"><%= letter %></span>
+          <span class="play-option__title"><%= h opt.text %></span>
