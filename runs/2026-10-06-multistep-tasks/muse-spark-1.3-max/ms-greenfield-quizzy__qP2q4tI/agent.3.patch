diff --git a/app/views/moderate/games/show.html.erb b/app/views/moderate/games/show.html.erb
new file mode 100644
index 0000000..65ded58
--- /dev/null
+++ b/app/views/moderate/games/show.html.erb
@@ -0,0 +1,80 @@
+<% content_for(:title, "Quizzy · #{@quiz.title} · Game") %>
+<section class="cover cover--blue cover--calm">
+  <div class="screen" id="screen-root"
+       data-status="<%= h @game.status %>"
+       data-state-url="<%= h @state_url %>"
+       data-content-url="<%= h @content_url %>"
+       data-index="<%= h(@game.current_index.to_s) %>">
+    <%= render "screen" %>
+  </div>
+</section>
+
+<script>
+(function() {
+  var root = document.getElementById('screen-root');
+  if (!root) return;
+  var stateUrl = root.getAttribute('data-state-url');
+  var contentUrl = root.getAttribute('data-content-url');
+  var fetchingContent = false;
+
+  // fetch() rejects URLs containing userinfo (http://user:pass@host). When the
+  // big-screen is opened via http://MOD:PASS@host (Capybara basic_auth), relative
+  // fetch URLs resolve against a base containing credentials and throw.
+  // Strip userinfo by rebuilding absolute URL from protocol+host (no credentials).
+  function cleanUrl(path) {
+    try {
+      if (path && path.charAt(0) === '/') {
+        return window.location.protocol + '//' + window.location.host + path;
+      }
+    } catch(e) {}
+    return path;
+  }
+
+  function fetchState() {
+    fetch(cleanUrl(stateUrl), { headers: { 'Accept': 'application/json' }, credentials: 'same-origin', cache: 'no-store' })
+      .then(function(resp) {
+        if (!resp.ok) return null;
+        return resp.json();
+      })
+      .then(function(data) {
+        if (!data) return;
+        var curStatus = root.getAttribute('data-status');
+        var curIndex = root.getAttribute('data-index');
+        var newStatus = data.status || curStatus;
+        var newIndex = (data.current_index !== undefined && data.current_index !== null) ? String(data.current_index) : curIndex;
+        if (newStatus !== curStatus || newIndex !== curIndex) {
+          if (!fetchingContent) {
+            fetchingContent = true;
+            fetch(cleanUrl(contentUrl), { headers: { 'Accept': 'text/html' }, credentials: 'same-origin', cache: 'no-store' })
+              .then(function(r) { return r.ok ? r.text() : null; })
+              .then(function(html) {
+                fetchingContent = false;
+                if (html !== null) {
+                  root.innerHTML = html;
+                  root.setAttribute('data-status', newStatus);
+                  root.setAttribute('data-index', newIndex);
+                }
+              })
+              .catch(function() { fetchingContent = false; });
+          }
+          return;
+        }
+        if (data.players_text) {
+          var pc = document.getElementById('players-count');
+          if (pc && pc.textContent !== data.players_text) {
+            pc.textContent = data.players_text;
+          }
+        }
+        if (data.answers_text) {
+          var ac = document.getElementById('answers-count');
+          if (ac && ac.textContent !== data.answers_text) {
+            ac.textContent = data.answers_text;
+          }
+        }
+      })
+      .catch(function() { /* crowded WiFi: ignore and retry next tick */ });
+  }
+
+  setInterval(fetchState, 700);
+})();
+</script>
