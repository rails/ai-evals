diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..63137c2
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,160 @@
+module Moderate
+  class GamesController < BaseController
+    before_action :set_quiz
+    before_action :set_game, only: [:show, :start, :finish, :next_question, :end_quiz, :state, :content]
+
+    # Polling endpoints allow either HTTP Basic (moderator) OR signed poll token in URL.
+    # Token is embedded in big-screen page (which requires Basic to load), so fetch() polling
+    # works even if browser does not send Authorization header for fetch (crowded WiFi/headless quirks),
+    # while direct visits without token still require Basic (401).
+    skip_before_action :authenticate_moderator!, only: [:state, :content]
+    before_action :authenticate_moderator_or_token!, only: [:state, :content]
+
+    def create
+      @game = @quiz.games.create!
+      redirect_to moderate_quiz_game_path(@quiz, @game)
+    end
+
+    def show
+      prepare_screen_vars
+    end
+
+    def start
+      @game.start!
+      redirect_to moderate_quiz_game_path(@quiz, @game)
+    end
+
+    def finish
+      @game.finish_question!
+      redirect_to moderate_quiz_game_path(@quiz, @game)
+    end
+
+    def next_question
+      @game.next_question!
+      redirect_to moderate_quiz_game_path(@quiz, @game)
+    end
+
+    def end_quiz
+      @game.end_quiz!
+      redirect_to moderate_quiz_game_path(@quiz, @game)
+    end
+
+    def state
+      @game.reload
+      players_count = @game.players.count
+      data = {
+        status: @game.status,
+        code: @game.code,
+        players_count: players_count,
+        players_text: "Players: #{players_count}"
+      }
+      if @game.open? || @game.closed?
+        q = @game.current_question
+        total = @game.question_ids_array.size
+        idx = @game.current_index || 0
+        answers_count = q ? @game.answers_count_for(q) : 0
+        data[:total] = total
+        data[:current_index] = idx
+        data[:progress] = "Question #{idx + 1} of #{total}"
+        data[:answers_count] = answers_count
+        data[:answers_total] = players_count
+        data[:answers_text] = "Answers: #{answers_count} / #{players_count}"
+        data[:is_last] = @game.last_index?
+        if @game.closed? && q
+          counts = @game.counts_per_option(q)
+          data[:counts] = counts.transform_keys(&:to_s)
+        end
+      end
+      render json: data
+    end
+
+    def content
+      prepare_screen_vars
+      render partial: "screen", layout: false
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = @quiz.games.find(params[:id])
+    end
+
+    def poll_verifier
+      Rails.application.message_verifier("quizzy_game_poll")
+    end
+
+    def valid_poll_token?
+      tok = params[:token].to_s
+      return false if tok.blank?
+      begin
+        data = poll_verifier.verify(tok, purpose: "game_poll")
+        qid = data[:quiz_id] || data["quiz_id"]
+        gid = data[:game_id] || data["game_id"]
+        qid.to_i == @quiz.id && gid.to_i == @game.id
+      rescue ActiveSupport::MessageVerifier::InvalidSignature
+        false
+      end
+    end
+
+    def authenticate_moderator_or_token!
+      return true if valid_poll_token?
+      # Fall back to HTTP Basic (will render 401 with WWW-Authenticate if missing/invalid)
+      authenticate_moderator!
+    end
+
+    def prepare_screen_vars
+      @game.reload if @game.persisted?
+      @join_display = "#{request.host_with_port}/play/#{@game.code}"
+      begin
+        base = request.base_url
+      rescue StandardError
+        base = "http://#{request.host_with_port}"
+      end
+      @join_full = "#{base}/play/#{@game.code}"
+      @players_count = @game.players.count
+      @players_text = "Players: #{@players_count}"
+
+      # Signed poll token for fetch() polling without requiring Authorization header on every poll.
+      # Only obtainable via authenticated big-screen page; unguessable; scoped to this game.
+      @poll_token = poll_verifier.generate({ quiz_id: @quiz.id, game_id: @game.id }, purpose: "game_poll")
+      @state_url = state_moderate_quiz_game_path(@quiz, @game, token: @poll_token)
+      @content_url = content_moderate_quiz_game_path(@quiz, @game, token: @poll_token)
+
+      @qr_svg = begin
+        qr = RQRCode::QRCode.new(@join_full)
+        svg = qr.as_svg(
+          color: "000",
+          shape_rendering: "crispEdges",
+          module_size: 11,
+          standalone: true,
+          use_path: true,
+          viewbox: true
+        )
+        svg.sub(/\A<\?xml.*?\?>/, "")
+      rescue StandardError => e
+        Rails.logger.warn("QR generation failed: #{e.class} #{e.message}")
+        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" fill="white"/><text x="50" y="50" text-anchor="middle" font-size="10">QR</text></svg>'
+      end
+
+      if @game.open? || @game.closed?
+        @question = @game.current_question
+        @options = @game.current_options
+        @total = @game.question_ids_array.size
+        @index = @game.current_index || 0
+        @progress = "Question #{@index + 1} of #{@total}"
+        @answers_count = @question ? @game.answers_count_for(@question) : 0
+        @answers_total = @players_count
+        @answers_text = "Answers: #{@answers_count} / #{@answers_total}"
+        @is_last = @game.last_index?
+        if @game.closed? && @question
+          @counts = @game.counts_per_option(@question)
+          @max_count = @counts.values.max || 0
+        end
+      end
+    end
+  end
+end
diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..b0283ed
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,226 @@
+class PlayController < ApplicationController
+  before_action :set_game
+
+  # Allow framing? No, default.
+  # CSRF is required for join/answer POSTs; GETs are safe.
+
+  def show
+    @player = current_player
+    prepare_player_vars
+    # If anon and finished, show over (no join). If anon and not finished, show join.
+    # If player, show waiting/question/closed/over based on game status.
+  end
+
+  def join
+    if @game.finished?
+      redirect_to play_path(code: @game.code) and return
+    end
+
+    existing = current_player
+    if existing
+      redirect_to play_path(code: @game.code) and return
+    end
+
+    raw_name = params[:name].presence || params.dig(:player, :name).presence || ""
+    name = raw_name.to_s.strip
+
+    if name.blank?
+      @player = nil
+      @join_error = "Please enter your name"
+      prepare_player_vars
+      render :show, status: :unprocessable_entity and return
+    end
+
+    # Cap length to avoid abuse, but allow reasonable names
+    name = name.truncate(50)
+
+    @player = @game.players.create!(name: name)
+    set_player_cookie(@player)
+
+    redirect_to play_path(code: @game.code)
+  rescue ActiveRecord::RecordInvalid => e
+    @player = nil
+    @join_error = e.record.errors.full_messages.first.presence || "Please enter your name"
+    prepare_player_vars
+    render :show, status: :unprocessable_entity
+  end
+
+  def answer
+    @player = current_player
+    unless @player
+      respond_to do |format|
+        format.html { redirect_to play_path(code: @game.code) }
+        format.json { render json: { error: "not_joined" }, status: :unauthorized }
+      end
+      return
+    end
+
+    unless @game.open?
+      prepare_player_vars
+      respond_to do |format|
+        format.html { redirect_to play_path(code: @game.code) }
+        format.json { render json: { error: "closed", version: @version, status: @game.status }, status: :unprocessable_entity }
+      end
+      return
+    end
+
+    question = @game.current_question
+    unless question
+      prepare_player_vars
+      respond_to do |format|
+        format.html { redirect_to play_path(code: @game.code) }
+        format.json { render json: { error: "no_question", version: @version }, status: :unprocessable_entity }
+      end
+      return
+    end
+
+    option_id = params[:option_id].to_s
+    option = question.options.find_by(id: option_id)
+    unless option
+      prepare_player_vars
+      respond_to do |format|
+        format.html { redirect_to play_path(code: @game.code) }
+        format.json { render json: { error: "invalid_option", version: @version }, status: :unprocessable_entity }
+      end
+      return
+    end
+
+    Answer.submit!(game: @game, player: @player, question: question, option: option)
+    prepare_player_vars
+
+    respond_to do |format|
+      format.html { redirect_to play_path(code: @game.code) }
+      format.json { render json: { ok: true, picked: option.id, version: @version, status: @game.status } }
+    end
+  end
+
+  # Light polling endpoint: ONLY version + status, no question/options/correct (no leak)
+  def state
+    @player = current_player
+    prepare_player_vars
+    render json: { version: @version, status: @game.status }
+  end
+
+  # HTML fragment for #play-root inner when version changes (reuses same templates, no leak when open)
+  def content
+    @player = current_player
+    prepare_player_vars
+    render partial: "play/content", layout: false
+  end
+
+  private
+
+  def set_game
+    code = params[:code].to_s.strip
+    @game = Game.where("upper(code) = ?", code.upcase).first
+    unless @game
+      render file: Rails.public_path.join("404.html"), status: :not_found, layout: false and return
+    end
+  end
+
+  def cookie_key
+    "quizzy_player_#{@game.id}"
+  end
+
+  def current_player
+    return nil unless @game
+    return @current_player if defined?(@current_player)
+    pid = nil
+    begin
+      pid = cookies.signed[cookie_key]
+    rescue StandardError
+      pid = nil
+    end
+    pid = pid.to_s.strip
+    if pid.blank?
+      @current_player = nil
+    else
+      @current_player = @game.players.find_by(id: pid.to_i)
+    end
+  end
+
+  def set_player_cookie(player)
+    cookies.signed[cookie_key] = {
+      value: player.id.to_s,
+      expires: 10.years.from_now,
+      httponly: true,
+      same_site: :lax,
+      path: "/"
+    }
+  end
+
+  def prepare_player_vars
+    @game.reload if @game.persisted?
+    # Compute version + vars for show/content/state
+    if @game.finished?
+      if @player
+        @version = "finished"
+      else
+        @version = "anon-finished"
+      end
+      # No question vars needed for finished
+      @question = nil
+      @options = []
+      @picked_id = nil
+      @feedback = nil
+      @progress = nil
+      return
+    end
+
+    if @player.nil?
+      @version = "anon-join"
+      @question = nil
+      @options = []
+      @picked_id = nil
+      @feedback = nil
+      @progress = nil
+      return
+    end
+
+    # Player exists, game not finished
+    case @game.status
+    when "lobby"
+      @version = "lobby"
+      @question = nil
+      @options = []
+      @picked_id = nil
+      @feedback = nil
+      @progress = nil
+    when "open"
+      @question = @game.current_question
+      @options = @game.current_options
+      total = @game.question_ids_array.size
+      idx = @game.current_index || 0
+      @progress = "Question #{idx + 1} of #{total}"
+      ans = @question ? @game.answer_for(@player, @question) : nil
+      @picked_id = ans&.option_id
+      picked_part = @picked_id ? @picked_id.to_s : "none"
+      @version = "open-#{idx}-picked-#{picked_part}"
+      @feedback = nil
+    when "closed"
+      @question = @game.current_question
+      @options = @game.current_options
+      total = @game.question_ids_array.size
+      idx = @game.current_index || 0
+      @progress = "Question #{idx + 1} of #{total}"
+      ans = @question ? @game.answer_for(@player, @question) : nil
+      @picked_id = ans&.option_id
+      picked_part = @picked_id ? @picked_id.to_s : "none"
+      @version = "closed-#{idx}-picked-#{picked_part}"
+      if ans.nil?
+        @feedback = "No answer"
+      else
+        opt = @options.find { |o| o.id == ans.option_id }
+        # opt.correct is only used server-side to compute feedback AFTER closed (allowed)
+        @feedback = (opt && opt.correct) ? "Correct!" : "Wrong!"
+      end
+    else
+      @version = "finished"
+      @question = nil
+      @options = []
+      @picked_id = nil
+      @feedback = nil
+      @progress = nil
+    end
+  end
+end
diff --git a/app/models/answer.rb b/app/models/answer.rb
new file mode 100644
index 0000000..ad6cbaa
--- /dev/null
+++ b/app/models/answer.rb
@@ -0,0 +1,50 @@
+class Answer < ApplicationRecord
+  belongs_to :game
+  belongs_to :player
+  belongs_to :question
+  belongs_to :option
+
+  validates :player_id, uniqueness: { scope: :question_id }
+  validate :option_belongs_to_question
+  validate :player_belongs_to_game
+  validate :question_belongs_to_quiz
+
+  def option_belongs_to_question
+    return if option.nil? || question.nil?
+    if option.question_id != question.id
+      errors.add(:option, "must belong to question")
+    end
+  end
+
+  def player_belongs_to_game
+    return if player.nil? || game.nil?
+    if player.game_id != game.id
+      errors.add(:player, "must belong to game")
+    end
+  end
+
+  def question_belongs_to_quiz
+    return if question.nil? || game.nil?
+    if question.quiz_id != game.quiz_id
+      errors.add(:question, "must belong to quiz")
+    end
+  end
+
+  # Upsert: last pick wins. Returns answer or nil if invalid.
+  def self.submit!(game:, player:, question:, option:)
+    # Validate option belongs to question
+    return nil unless option && question && option.question_id == question.id
+    # Find existing or build new
+    ans = find_or_initialize_by(player_id: player.id, question_id: question.id)
+    ans.game = game
+    ans.option = option
+    begin
+      ans.save!
+    rescue ActiveRecord::RecordNotUnique
+      # Race: reload and retry update
+      ans = find_by!(player_id: player.id, question_id: question.id)
+      ans.update!(game: game, option: option)
+    end
+    ans
+  end
+end
diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..fa14f0a
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,152 @@
+class Game < ApplicationRecord
+  belongs_to :quiz
+  has_many :players, dependent: :destroy
+  has_many :answers, dependent: :destroy
+
+  validates :code, presence: true, uniqueness: { case_sensitive: false }
+  validates :status, presence: true, inclusion: { in: %w[lobby open closed finished] }
+
+  before_validation :assign_code, on: :create
+
+  CODE_ALPHABET = ("A".."Z").to_a - %w[I O] + ("2".."9").to_a
+  CODE_LENGTH = 5
+
+  def self.generate_code
+    loop do
+      code = Array.new(CODE_LENGTH) { CODE_ALPHABET.sample }.join
+      # case-insensitive uniqueness check
+      unless where("upper(code) = ?", code.upcase).exists?
+        return code
+      end
+    end
+  end
+
+  def assign_code
+    self.code ||= self.class.generate_code
+    self.code = code.to_s.upcase.strip
+    # Ensure unique with retry if collision (validation will catch, but try to avoid)
+    if self.class.where("upper(code) = ?", code.upcase).where.not(id: id).exists?
+      self.code = self.class.generate_code
+    end
+  end
+
+  def question_ids_array
+    return [] if question_ids.blank?
+    @question_ids_array ||=
+      begin
+        parsed = JSON.parse(question_ids.to_s)
+        parsed.is_a?(Array) ? parsed.map { |v| v.to_i } : []
+      rescue JSON::ParserError
+        []
+      end
+  end
+
+  def question_ids_array=(arr)
+    @question_ids_array = Array(arr).map(&:to_i)
+    self.question_ids = JSON.generate(@question_ids_array)
+  end
+
+  def total_questions
+    # If snapshot exists, use it; else live active count (for lobby preview, not displayed)
+    if question_ids.present?
+      question_ids_array.size
+    else
+      quiz.active_questions.count
+    end
+  end
+
+  def current_question
+    return nil unless %w[open closed].include?(status)
+    return nil if current_index.nil?
+    ids = question_ids_array
+    qid = ids[current_index]
+    return nil unless qid
+    # Use quiz scope to ensure belongs to quiz; fallback to direct find
+    quiz.questions.find_by(id: qid) || Question.find_by(id: qid)
+  end
+
+  def current_options
+    q = current_question
+    return [] unless q
+    q.options.order(:position, :id).to_a
+  end
+
+  def lobby? = status == "lobby"
+  def open? = status == "open"
+  def closed? = status == "closed"
+  def finished? = status == "finished"
+
+  def last_index?
+    return false if current_index.nil?
+    current_index == (question_ids_array.size - 1)
+  end
+
+  def players_count
+    players.count
+  end
+
+  def answers_count_for(question)
+    return 0 unless question
+    answers.where(question_id: question.id).count
+  end
+
+  def counts_per_option(question)
+    return {} unless question
+    answers.where(question_id: question.id).group(:option_id).count
+  end
+
+  def answer_for(player, question)
+    return nil unless player && question
+    answers.find_by(player_id: player.id, question_id: question.id)
+  end
+
+  # Transitions
+  def start!
+    return false unless lobby?
+    # Snapshot active questions at start time
+    ids = quiz.active_questions.order(:position, :id).pluck(:id)
+    Game.transaction do
+      reload
+      return false unless status == "lobby"
+      if ids.empty?
+        update!(question_ids: JSON.generate([]), current_index: nil, status: "finished")
+      else
+        update!(question_ids: JSON.generate(ids), current_index: 0, status: "open")
+      end
+    end
+    true
+  end
+
+  def finish_question!
+    return false unless open?
+    Game.transaction do
+      reload
+      return false unless status == "open"
+      update!(status: "closed")
+    end
+    true
+  end
+
+  def next_question!
+    return false unless closed?
+    return false if last_index?
+    Game.transaction do
+      reload
+      return false unless status == "closed"
+      return false if last_index?
+      update!(current_index: current_index + 1, status: "open")
+    end
+    true
+  end
+
+  def end_quiz!
+    return false unless closed?
+    return false unless last_index?
+    Game.transaction do
+      reload
+      return false unless status == "closed" && last_index?
+      update!(status: "finished")
+    end
+    true
+  end
+end
