diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..f7bec82
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,88 @@
+module Api
+  module V1
+    class AccountsController < BaseController
+      before_action :authenticate!, only: %i[show cancel reactivate]
+      before_action :require_active_account!, only: %i[show cancel]
+      before_action :require_admin!, only: %i[cancel reactivate]
+
+      # POST /api/v1/account/create
+      # Registers a new business together with its owner (admin user) and sends
+      # the owner a verification email. The owner must verify their email
+      # before they can sign in.
+      def create
+        account = Account.new(account_params)
+        account_valid = account.valid?
+
+        user = account.users.build(admin_params.merge(role: "admin"))
+        user_valid = user.valid?
+
+        unless account_valid && user_valid
+          errors = {}
+          errors[:account] = account.errors.to_hash if account.errors.any?
+          errors[:user] = user.errors.to_hash if user.errors.any?
+          return render json: { error: "validation_failed", errors: errors }, status: :unprocessable_entity
+        end
+
+        ActiveRecord::Base.transaction do
+          account.save!
+          user.save!
+        end
+
+        verification = EmailVerification.replace_for!(user)
+        UserMailer.verify_email(verification).deliver_now
+
+        render json: { account: account_json(account), user: user_json(user) }, status: :created
+      rescue ActiveRecord::RecordNotUnique
+        render json: {
+          error: "validation_failed",
+          errors: { account: { subdomain: ["has already been taken"] } }
+        }, status: :unprocessable_entity
+      end
+
+      # GET /api/v1/account
+      def show
+        render json: { account: account_json(current_account) }
+      end
+
+      # POST /api/v1/account/cancel
+      # Cancels the account and revokes every session belonging to it.
+      def cancel
+        current_account.cancel! unless current_account.cancelled?
+        render json: { account: account_json(current_account) }
+      end
+
+      # POST /api/v1/account/reactivate
+      # The owner can reactivate a cancelled account within 90 days.
+      def reactivate
+        account = current_account
+
+        unless account.cancelled?
+          return render json: {
+            error: "account_not_cancelled",
+            message: "This account is not cancelled."
+          }, status: :unprocessable_entity
+        end
+
+        if account.reactivation_expired?
+          return render json: {
+            error: "reactivation_period_expired",
+            message: "The 90 day reactivation period has expired."
+          }, status: :unprocessable_entity
+        end
+
+        account.reactivate!
+        render json: { account: account_json(account) }
+      end
+
+      private
+
+      def account_params
+        require_parameters(:account).permit(:name, :subdomain)
+      end
+
+      def admin_params
+        require_parameters(:admin, within: :account).permit(:name, :email, :password)
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..942989d
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,313 @@
+module Api
+  module V1
+    class BaseController < ActionController::API
+      include CursorPagination
+
+      rescue_from CursorPagination::InvalidCursor, with: :render_invalid_cursor
+
+      private
+
+      # --- Authentication ---------------------------------------------
+
+      def bearer_token
+        request.headers["Authorization"].to_s[/\Abearer\s+(.+)\z/i, 1]
+      end
+
+      def current_session
+        return @current_session if defined?(@current_session)
+
+        token = bearer_token
+        @current_session = token.present? ? Session.includes(user: :account).find_by(token: token) : nil
+      end
+
+      def current_user
+        current_session&.user
+      end
+
+      def current_account
+        current_user&.account
+      end
+
+      def authenticate!
+        render_unauthorized unless current_user
+      end
+
+      def require_active_account!
+        return unless current_account&.cancelled?
+
+        render json: {
+          error: "account_cancelled",
+          message: "This account has been cancelled."
+        }, status: :forbidden
+      end
+
+      def require_admin!
+        return if current_user&.admin?
+
+        render json: {
+          error: "forbidden",
+          message: "Only admins can perform this action."
+        }, status: :forbidden
+      end
+
+      def require_staff!
+        return if current_user&.staff?
+
+        render json: {
+          error: "forbidden",
+          message: "Only staff members can perform this action."
+        }, status: :forbidden
+      end
+
+      def require_customer!
+        return if current_user&.customer?
+
+        render json: {
+          error: "forbidden",
+          message: "Only customers can perform this action."
+        }, status: :forbidden
+      end
+
+      # --- Tenant selection -------------------------------------------
+
+      # Finds the account chosen by the X-Helpdesk-Account header, rendering a
+      # 404 when the header is missing or unknown.
+      def load_account_from_header!
+        subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase
+        account = Account.find_by(subdomain: subdomain) if subdomain.present?
+        return account if account
+
+        render json: {
+          error: "account_not_found",
+          message: "No account was found for the given X-Helpdesk-Account header."
+        }, status: :not_found
+
+        nil
+      end
+
+      # --- Parameter helpers ------------------------------------------
+
+      # Safely reads a nested value from a JSON envelope, returning nil when
+      # the envelope is missing or not an object.
+      def envelope_param(envelope, key)
+        value = params[envelope]
+        value[key] if value.is_a?(ActionController::Parameters)
+      end
+
+      # Reads a nested parameter object, responding 400 when it is missing or
+      # not a JSON object.
+      def require_parameters(key, within: nil)
+        container = within ? require_parameters(within) : params
+        value = container[key]
+        unless value.is_a?(ActionController::Parameters)
+          raise ActionController::BadRequest, "Expected #{key} to be an object"
+        end
+        value
+      end
+
+      # Pagination lives in the CursorPagination concern: `page`/`per_page`
+      # keep the original page-number behavior, while `page[size]` /
+      # `page[after]` / `page[before]` switch to cursor (keyset) pagination.
+
+      # --- Rendering helpers ------------------------------------------
+
+      def render_invalid_cursor
+        render json: {
+          error: "invalid_cursor",
+          message: "The page cursor is not valid."
+        }, status: :bad_request
+      end
+
+      def render_unauthorized
+        render json: {
+          error: "unauthorized",
+          message: "A valid session token is required."
+        }, status: :unauthorized
+      end
+
+      def render_not_found(resource)
+        render json: {
+          error: "not_found",
+          message: "The requested #{resource} was not found."
+        }, status: :not_found
+      end
+
+      def render_validation_errors(record)
+        render json: {
+          error: "validation_failed",
+          errors: record.errors.to_hash,
+          messages: record.errors.full_messages
+        }, status: :unprocessable_entity
+      end
+
+      def account_json(account)
+        {
+          id: account.id,
+          name: account.name,
+          subdomain: account.subdomain,
+          cancelled: account.cancelled?,
+          cancelled_at: account.cancelled_at,
+          created_at: account.created_at,
+          updated_at: account.updated_at
+        }
+      end
+
+      def user_json(user)
+        {
+          id: user.id,
+          account_id: user.account_id,
+          name: user.name,
+          email: user.email,
+          role: user.role,
+          verified: user.verified?,
+          verified_at: user.verified_at,
+          suspended: user.suspended?,
+          suspended_at: user.suspended_at,
+          created_at: user.created_at,
+          updated_at: user.updated_at
+        }
+      end
+
+      # Compact view used for assignment dropdowns.
+      def staff_json(user)
+        {
+          id: user.id,
+          name: user.name,
+          email: user.email,
+          role: user.role
+        }
+      end
+
+      def invitation_json(invitation)
+        {
+          id: invitation.id,
+          account_id: invitation.account_id,
+          email: invitation.email,
+          role: invitation.role,
+          status: invitation.status,
+          token: invitation.token,
+          expires_at: invitation.expires_at,
+          accepted_at: invitation.accepted_at,
+          revoked_at: invitation.revoked_at,
+          created_at: invitation.created_at,
+          updated_at: invitation.updated_at
+        }
+      end
+
+      # What the acceptance screen needs before the invitee commits.
+      def invitation_preview_json(invitation)
+        account = invitation.account
+        {
+          email: invitation.email,
+          role: invitation.role,
+          status: invitation.status,
+          expires_at: invitation.expires_at,
+          account_name: account.name,
+          account_subdomain: account.subdomain,
+          business_name: account.name,
+          business_subdomain: account.subdomain,
+          account: {
+            id: account.id,
+            name: account.name,
+            subdomain: account.subdomain
+          }
+        }
+      end
+
+      def session_json(session)
+        {
+          id: session.id,
+          token: session.token,
+          created_at: session.created_at,
+          updated_at: session.updated_at
+        }
+      end
+
+      # Customer-facing view of a ticket. merged_into_id points at the
+      # surviving ticket when this one was merged into another (closed), and
+      # is null on unmerged records, so the customer can follow the
+      # conversation.
+      def request_json(ticket)
+        {
+          id: ticket.id,
+          subject: ticket.subject,
+          status: ticket.status,
+          requester_id: ticket.requester_id,
+          merged_into_id: ticket.merged_into_id,
+          created_at: ticket.created_at,
+          updated_at: ticket.updated_at
+        }
+      end
+
+      # Staff-facing view of a ticket, embedding the requester, assignee, and
+      # group and exposing the internal priority (never shown to customers).
+      def ticket_json(ticket)
+        request_json(ticket).merge(
+          priority: ticket.priority,
+          requester: requester_json(ticket.requester),
+          assignee_id: ticket.assignee_id,
+          assignee: ticket.assignee ? assignee_json(ticket.assignee) : nil,
+          group_id: ticket.group_id,
+          group: ticket.group ? group_summary_json(ticket.group) : nil
+        )
+      end
+
+      def group_json(group)
+        {
+          id: group.id,
+          account_id: group.account_id,
+          name: group.name,
+          created_at: group.created_at,
+          updated_at: group.updated_at
+        }
+      end
+
+      # Compact view embedded in tickets.
+      def group_summary_json(group)
+        {
+          id: group.id,
+          name: group.name
+        }
+      end
+
+      def group_membership_json(membership)
+        {
+          id: membership.id,
+          group_id: membership.group_id,
+          user_id: membership.user_id,
+          default: membership.default,
+          created_at: membership.created_at,
+          updated_at: membership.updated_at
+        }
+      end
+
+      def requester_json(user)
+        {
+          id: user.id,
+          name: user.name,
+          email: user.email
+        }
+      end
+
+      def assignee_json(user)
+        {
+          id: user.id,
+          name: user.name
+        }
+      end
+
+      def comment_json(comment)
+        {
+          id: comment.id,
+          body: comment.body,
+          public: comment.public,
+          author: {
+            id: comment.author.id,
+            name: comment.author.name
+          },
+          created_at: comment.created_at
+        }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..1685197
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,44 @@
+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      # POST /api/v1/email_verifications
+      # Sends a fresh verification link, replacing any previous one.
+      def create
+        account = load_account_from_header!
+        return unless account
+
+        email = envelope_param(:email_verification, :email).to_s.strip.downcase
+        user = account.users.find_by(email: email) if email.present?
+
+        if user && !user.verified?
+          verification = EmailVerification.replace_for!(user)
+          UserMailer.verify_email(verification).deliver_now
+        end
+
+        render json: {
+          message: "If that email belongs to an unverified user, a verification link has been sent."
+        }
+      end
+
+      # POST /api/v1/email_verifications/confirm
+      # Verifies the user's email address using the emailed token.
+      def confirm
+        token = envelope_param(:email_verification, :token).to_s
+        verification = EmailVerification.includes(user: :account).find_by(token: token) if token.present?
+
+        unless verification
+          return render json: {
+            error: "invalid_token",
+            message: "The verification link is invalid or has been replaced."
+          }, status: :unprocessable_entity
+        end
+
+        user = verification.user
+        user.verify!
+        verification.destroy!
+
+        render json: { user: user_json(user) }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/group_memberships_controller.rb b/app/controllers/api/v1/group_memberships_controller.rb
new file mode 100644
index 0000000..a0dabdc
--- /dev/null
+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,89 @@
+module Api
+  module V1
+    # Memberships link staff members to groups; staff may belong to several
+    # groups and always keep exactly one default membership. Staff can browse
+    # memberships; only admins manage them.
+    class GroupMembershipsController < BaseController
+      before_action :authenticate!
+      before_action :require_active_account!
+      before_action :require_staff!, only: %i[index show]
+      before_action :require_admin!, only: %i[create destroy make_default]
+
+      # GET /api/v1/group_memberships
+      # Lists the business' memberships by ID ascending, optionally filtered
+      # by group_id and/or user_id.
+      def index
+        scope = current_account.group_memberships.by_id
+        scope = scope.where(group_id: params[:group_id]) if params[:group_id].present?
+        scope = scope.where(user_id: params[:user_id]) if params[:user_id].present?
+
+        memberships, meta = paginate(scope)
+
+        render json: {
+          group_memberships: memberships.map { |membership| group_membership_json(membership) },
+          **meta
+        }
+      end
+
+      # GET /api/v1/group_memberships/:id
+      def show
+        membership = find_membership
+        return unless membership
+
+        render json: { group_membership: group_membership_json(membership) }
+      end
+
+      # POST /api/v1/group_memberships
+      # Adds a staff member to a group, e.g.
+      # {"group_membership":{"group_id":20,"user_id":12,"default":true}}
+      # (admin only). The member's first membership becomes their default.
+      def create
+        envelope = require_parameters(:group_membership)
+
+        membership = GroupMembership.new(
+          group: current_account.groups.find_by(id: envelope[:group_id]),
+          user: current_account.users.find_by(id: envelope[:user_id])
+        )
+        if envelope.key?(:default)
+          membership.default = ActiveModel::Type::Boolean.new.cast(envelope[:default])
+        end
+
+        if membership.save
+          render json: { group_membership: group_membership_json(membership) }, status: :created
+        else
+          render_validation_errors(membership)
+        end
+      end
+
+      # DELETE /api/v1/group_memberships/:id
+      # Removes a staff member from a group (admin only). Deleting their
+      # default membership promotes another remaining one, and assignments
+      # that were only valid through this membership are cleared.
+      def destroy
+        membership = find_membership
+        return unless membership
+
+        membership.destroy!
+        head :no_content
+      end
+
+      # PUT /api/v1/group_memberships/:id/make_default
+      # Makes this membership the staff member's default (admin only).
+      def make_default
+        membership = find_membership
+        return unless membership
+
+        membership.make_default!
+        render json: { group_membership: group_membership_json(membership) }
+      end
+
+      private
+
+      def find_membership
+        membership = current_account.group_memberships.find_by(id: params[:id])
+        render_not_found("group membership") unless membership
+        membership
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/groups_controller.rb b/app/controllers/api/v1/groups_controller.rb
new file mode 100644
index 0000000..c645f14
--- /dev/null
+++ b/app/controllers/api/v1/groups_controller.rb
@@ -0,0 +1,81 @@
+module Api
+  module V1
+    # The business' staff groups (e.g. "Billing", "Technical Support"). Staff
+    # can browse them; only admins create, rename, and delete them. Groups
+    # organize work: they never hide tickets from other staff.
+    class GroupsController < BaseController
+      before_action :authenticate!
+      before_action :require_active_account!
+      before_action :require_staff!, only: %i[index show]
+      before_action :require_admin!, only: %i[create update destroy]
+
+      # GET /api/v1/groups
+      # Lists the business' groups by ID ascending.
+      def index
+        groups, meta = paginate(current_account.groups.by_id)
+
+        render json: {
+          groups: groups.map { |group| group_json(group) },
+          **meta
+        }
+      end
+
+      # GET /api/v1/groups/:id
+      def show
+        group = find_group
+        return unless group
+
+        render json: { group: group_json(group) }
+      end
+
+      # POST /api/v1/groups
+      # Creates a group, e.g. {"group":{"name":"Billing"}} (admin only).
+      def create
+        envelope = require_parameters(:group)
+        group = current_account.groups.build(name: envelope[:name])
+
+        if group.save
+          render json: { group: group_json(group) }, status: :created
+        else
+          render_validation_errors(group)
+        end
+      end
+
+      # PATCH /api/v1/groups/:id
+      # Renames a group, e.g. {"group":{"name":"Technical Support"}} (admin
+      # only).
+      def update
+        group = find_group
+        return unless group
+
+        envelope = require_parameters(:group)
+        group.name = envelope[:name] if envelope.key?(:name)
+
+        if group.save
+          render json: { group: group_json(group) }
+        else
+          render_validation_errors(group)
+        end
+      end
+
+      # DELETE /api/v1/groups/:id
+      # Deletes a group (admin only). Its tickets become ungrouped and
+      # assignments that were only valid through this group are cleared.
+      def destroy
+        group = find_group
+        return unless group
+
+        group.destroy!
+        head :no_content
+      end
+
+      private
+
+      def find_group
+        group = current_account.groups.find_by(id: params[:id])
+        render_not_found("group") unless group
+        group
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..4ad2918
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,66 @@
+module Api
+  module V1
+    # Public endpoint that turns a pending invitation into a verified staff
+    # user; no further email verification is needed.
+    class InvitationAcceptancesController < BaseController
+      # POST /api/v1/invitation_acceptances
+      def create
+        invitation = find_invitation_by_token
+        return unless invitation
+
+        unless invitation.pending?
+          return render json: {
+            error: "invitation_#{invitation.status}",
+            message: "This invitation has been #{invitation.status}."
+          }, status: :unprocessable_entity
+        end
+
+        if invitation.account.cancelled?
+          return render json: {
+            error: "account_cancelled",
+            message: "This account has been cancelled."
+          }, status: :forbidden
+        end
+
+        user = invitation.account.users.build(acceptance_params.merge(
+          email: invitation.email,
+          role: invitation.role,
+          verified_at: Time.current
+        ))
+
+        unless user.valid?
+          return render_validation_errors(user)
+        end
+
+        ActiveRecord::Base.transaction do
+          user.save!
+          invitation.update!(accepted_at: Time.current, accepted_user: user)
+        end
+
+        render json: {
+          user: user_json(user),
+          account: account_json(invitation.account)
+        }, status: :created
+      end
+
+      private
+
+      def find_invitation_by_token
+        token = envelope_param(:invitation_acceptance, :token).to_s
+        invitation = Invitation.includes(:account).find_by(token: token) if token.present?
+        return invitation if invitation
+
+        render json: {
+          error: "invalid_token",
+          message: "The invitation link is invalid."
+        }, status: :unprocessable_entity
+
+        nil
+      end
+
+      def acceptance_params
+        require_parameters(:invitation_acceptance).permit(:name, :password, :password_confirmation)
+      end
+    end
+  end
+end
