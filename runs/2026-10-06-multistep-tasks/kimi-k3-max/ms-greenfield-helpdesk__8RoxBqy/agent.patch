new file mode 100644
index 0000000..84e4959
--- /dev/null
+++ b/lib/tasks/helpdesk.rake
@@ -0,0 +1,15 @@
+namespace :helpdesk do
+  desc "Permanently delete accounts (and all their data) that have been cancelled for more than 90 days"
+  task purge_cancelled_accounts: :environment do
+    cutoff = Account::CANCELLATION_GRACE_PERIOD.ago
+    accounts = Account.pending_purge
+
+    total = accounts.count
+    accounts.find_each do |account|
+      puts "Purging account ##{account.id} (#{account.subdomain}), cancelled at #{account.cancelled_at}"
+      account.destroy!
+    end
+
+    puts "Done. Purged #{total} account(s) cancelled before #{cutoff}."
+  end
+end
