diff --git a/.gitignore b/.gitignore
index f305d48..7cbce5b 100644
--- a/.gitignore
+++ b/.gitignore
@@ -1,2 +1,27 @@
+# See https://help.github.com/articles/ignoring-files for more about ignoring files.
+
+# Ignore bundler config and vendored gems.
 /.bundle/
 /vendor/bundle/
+
+# Ignore the default SQLite database and storage (not used, kept for safety).
+/db/*.sqlite3
+/db/*.sqlite3-*
+/storage/*
+
+# Ignore log files, temp files and pid files.
+/log/*
+/tmp/*
+!/log/.keep
+!/tmp/.keep
+
+# Ignore uploaded files in development.
+/public/storage
+
+# Ignore master key for decrypting credentials and more.
+/config/master.key
+/config/credentials/*.key
+
+# Ignore environment files with secrets.
+/.env
+/.env.*
