+
+  test "customer registration uses the existing verification and sign-in flows" do
+    post "/api/v1/registrations", params: {
+      user: { name: "Blair", email: "blair@example.test", password: "another-password" }
+    }, headers: @headers, as: :json
+    assert_response :created
+    body = response.parsed_body["user"]
+    assert_equal "Blair", body["name"]
+    assert_equal "customer", body["role"]
+    assert_equal false, body["verified"]
+
+    # verification email is sent
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal ["blair@example.test"], mail.to
+    assert_includes mail.body.to_s, "/verify-email?account=#{@subdomain}&token="
