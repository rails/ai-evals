+class InvitationMailer < ApplicationMailer
+  # Sends the team invitation with the acceptance link to the frontend.
+  def invite(invitation)
+    @invitation = invitation
+    @account = invitation.account
+    @url = frontend_url("/accept-invitation", @account, invitation.token)
+
+    mail(to: invitation.email, subject: "You've been invited to join #{@account.name}")
+  end
+
+  private
+
+  def frontend_url(path, account, token)
+    base = ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001").sub(%r{/+\z}, "")
+    query = "account=#{CGI.escape(account.subdomain)}&token=#{CGI.escape(token)}"
+    "#{base}#{path}?#{query}"
+  end
+end
diff --git a/app/mailers/ticket_mailer.rb b/app/mailers/ticket_mailer.rb
new file mode 100644
index 0000000..33b49a6
--- /dev/null
+++ b/app/mailers/ticket_mailer.rb
@@ -0,0 +1,17 @@
+class TicketMailer < ApplicationMailer
+  # Emails a public staff reply on an email-origin ticket to the requester.
+  # The message is sent from (and replies go to) the ticket's private reply
+  # address, so the requester's next email returns to the same conversation.
+  def new_reply(comment)
+    @comment = comment
+    @ticket = comment.ticket
+    @account = @ticket.account
+
+    mail(
+      to: @ticket.requester.email,
+      from: @ticket.reply_address,
+      reply_to: @ticket.reply_address,
+      subject: "Re: #{@ticket.subject}"
+    )
+  end
+end
diff --git a/app/mailers/user_mailer.rb b/app/mailers/user_mailer.rb
