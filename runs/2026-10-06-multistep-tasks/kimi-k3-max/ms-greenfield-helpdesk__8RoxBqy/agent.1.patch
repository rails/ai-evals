+# PostgreSQL configuration.
+#
+# Connections are based on the DATABASE_URL environment variable when it is
+# set. The test environment derives its own database from DATABASE_URL by
+# suffixing the database name with "_test", so running the test suite can
+# never touch development/production data.
+
+default: &default
+  adapter: postgresql
+  encoding: unicode
+  # For details on connection pooling, see the Rails configuration guide
+  # https://guides.rubyonrails.org/configuring.html#database-pooling
+  max_connections: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>
+
+development:
+  <<: *default
+<% if ENV["DATABASE_URL"] %>
+  url: <%= ENV["DATABASE_URL"] %>
+<% else %>
+  database: helpdesk_development
+<% end %>
+
+# Warning: The database defined as "test" will be erased and
+# re-generated from your development database when you run "rake".
+# Do not set this db to the same as development or production.
+test:
+  <<: *default
+<% if ENV["DATABASE_URL"] %>
+<%   base, _sep, query = ENV["DATABASE_URL"].partition("?") %>
+<%   base = base.sub(%r{/([^/]+)\z}, '/\1_test') %>
+  url: <%= query.empty? ? base : "#{base}?#{query}" %>
+<% else %>
+  database: helpdesk_test
+<% end %>
+
+production:
+  <<: *default
+  url: <%= ENV.fetch("DATABASE_URL") %>
