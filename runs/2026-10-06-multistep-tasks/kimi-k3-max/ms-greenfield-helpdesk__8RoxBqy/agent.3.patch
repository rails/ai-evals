diff --git a/app/mailers/invitation_mailer.rb b/app/mailers/invitation_mailer.rb
new file mode 100644
index 0000000..f32cc30
--- /dev/null
+++ b/app/mailers/invitation_mailer.rb
@@ -0,0 +1,18 @@
+class InvitationMailer < ApplicationMailer
+  # Sends the team invitation with the acceptance link to the frontend.
+  def invite(invitation)
+    @invitation = invitation
+    @account = invitation.account
+    @url = frontend_url("/accept-invitation", @account, invitation.token)
+
+    mail(to: invitation.email, subject: "You've been invited to join #{@account.name}")
+  end
+
+  private
+
+  def frontend_url(path, account, token)
+    base = ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001").sub(%r{/+\z}, "")
+    query = "account=#{CGI.escape(account.subdomain)}&token=#{CGI.escape(token)}"
+    "#{base}#{path}?#{query}"
+  end
+end
