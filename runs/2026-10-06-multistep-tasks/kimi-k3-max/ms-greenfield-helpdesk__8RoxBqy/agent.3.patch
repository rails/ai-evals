+class CreateInvitations < ActiveRecord::Migration[8.1]
+  def change
+    create_table :invitations do |t|
+      t.references :account, null: false, foreign_key: true
+      t.string :email, null: false
+      t.string :role, null: false, default: "agent"
+      t.string :token, null: false
+      # Nullable and nullified on delete so that removing people from the
+      # account never destroys the invitation audit trail.
+      t.references :inviter, null: true, foreign_key: { to_table: :users, on_delete: :nullify }
+      t.references :accepted_user, null: true, foreign_key: { to_table: :users, on_delete: :nullify }
+      t.datetime :accepted_at
+      t.datetime :revoked_at
+      t.datetime :expires_at, null: false
+
+      t.timestamps
+
+      t.index %i[account_id email]
+    end
+
+    add_index :invitations, :token, unique: true
+  end
+end
