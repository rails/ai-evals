+  # Keeps the group and the assignee consistent:
+  # * assigning someone to an ungrouped ticket files it under the assignee's
+  #   default group, when they have one;
+  # * explicitly clearing the group also clears the assignee;
+  # * moving the ticket to another group clears an assignee who doesn't
+  #   belong there (an assignee set in the same update is validated instead).
+  def sync_group_with_assignee
+    if assignee_id.present? && group_id.nil? && will_save_change_to_assignee_id?
+      self.group = assignee&.default_group
+    end
+
+    return unless will_save_change_to_group_id?
+
+    if group_id.nil?
+      self.assignee = nil
+    elsif assignee_id.present? && !will_save_change_to_assignee_id? && !group&.member?(assignee)
+      self.assignee = nil
+    end
+  end
+
+  def group_belongs_to_account
+    if group.nil? || group.account_id != account_id
+      errors.add(:group_id, "does not reference a group of this account")
+    end
+  end
+
+  # An assigned person must belong to the ticket's group.
+  def assignee_belongs_to_group
+    return if assignee.nil? || group.nil?
+
+    errors.add(:assignee_id, "must belong to the ticket's group") unless group.member?(assignee)
+  end
+
   def assign_reply_token
     self.reply_token ||= self.class.generate_unique_reply_token
   end
