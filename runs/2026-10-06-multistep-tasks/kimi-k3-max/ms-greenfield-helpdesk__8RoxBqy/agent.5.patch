@@ -0,0 +1,17 @@
+class TicketMailer < ApplicationMailer
+  # Emails a public staff reply on an email-origin ticket to the requester.
+  # The message is sent from (and replies go to) the ticket's private reply
+  # address, so the requester's next email returns to the same conversation.
+  def new_reply(comment)
+    @comment = comment
+    @ticket = comment.ticket
+    @account = @ticket.account
+
+    mail(
+      to: @ticket.requester.email,
+      from: @ticket.reply_address,
+      reply_to: @ticket.reply_address,
+      subject: "Re: #{@ticket.subject}"
+    )
+  end
+end
