diff --git a/docs/profiling/event_prof.rb b/docs/profiling/event_prof.rb
new file mode 100644
index 0000000..f2bd1a0
--- /dev/null
+++ b/docs/profiling/event_prof.rb
@@ -0,0 +1,120 @@
+# frozen_string_literal: true
+
+# EventProf-style instrumentation for diagnosing suite-wide time sinks.
+# Load with: bundle exec rspec --require ./docs/profiling/event_prof.rb spec/requests
+
+require "active_support"
+require "active_support/notifications"
+module EventProf
+  class << self
+    def totals = (@totals ||= Hash.new(0.0))
+    def counts = (@counts ||= Hash.new(0))
+    attr_accessor :example_time, :example_count
+
+    def add(key, dt, n = 1)
+      totals[key] += dt
+      counts[key] += n
+    end
+
+    def instrument(key, n = 1)
+      start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+      yield
+    ensure
+      add(key, Process.clock_gettime(Process::CLOCK_MONOTONIC) - start, n)
+    end
+
+    def report(io = $stderr)
+      io.puts "\n=== EventProf report ==="
+      io.puts format('%26s %9s %10s', 'event', 'time(s)', 'count')
+      totals.sort_by { |_, v| -v }.each do |k, v|
+        io.puts format('%26s %9.2f %10d', k, v, counts[k])
+      end
+      io.puts format('total example+hook time: %.2fs over %d examples', EventProf.example_time.to_f, EventProf.example_count.to_i)
+    end
+
+    def install!
+      # Fabrication timing
+      Fabricate.singleton_class.prepend(Module.new do
+        def create(...) = EventProf.instrument(:fabricate) { super }
+        def build(...) = EventProf.instrument(:fabricate_build) { super }
+      end)
+
+      # Redis command timing
+      RedisClient.prepend(Module.new do
+        def call_v(*args, &)
+          cmd = (args[0].is_a?(Array) ? args[0][0] : args[0]).to_s.downcase
+          start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+          super
+        ensure
+          dt = Process.clock_gettime(Process::CLOCK_MONOTONIC) - start
+          EventProf.add(:redis_total, dt)
+          EventProf.add("redis:#{cmd}".to_sym, dt)
+        end
+
+        def blocking_call_v(*args, &)
+          start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+          super
+        ensure
+          EventProf.add(:redis_total, Process.clock_gettime(Process::CLOCK_MONOTONIC) - start)
+        end
+      end)
+
+      # Sidekiq inline job execution (sidekiq >= 8 test_api path)
+      Sidekiq::Client.prepend(Module.new do
+        def atomic_push(conn, payloads)
+          if Sidekiq::Testing.inline?
+            EventProf.instrument(:sidekiq_inline, payloads.size) { super }
+          else
+            super
+          end
+        end
+      end)
+
+      # ActiveJob execution through any adapter (incl. inline via sidekiq AJ adapter)
+      ActiveJob::Base.prepend(Module.new do
+        def perform_now = EventProf.instrument(:active_job_perform) { super }
+      end)
+
+      # Request handling through the integration session (rack-test full stack)
+      ActionDispatch::Integration::Session.prepend(Module.new do
+        def process(...) = EventProf.instrument(:request_process) { super }
+      end)
+
+      # Rails.cache.clear (called from the global after hook)
+      ActiveSupport::Cache::Store.prepend(Module.new do
+        def clear(*) = EventProf.instrument(:rails_cache_clear) { super }
+      end)
+
+      RSpec.configuration.after(:suite) { EventProf.report }
+    end
+  end
+end
+
+# SQL timing via notifications
+ActiveSupport::Notifications.subscribe('sql.active_record') do |_name, start, finish, _id, payload|
+  unless %w[SCHEMA TRANSACTION].include?(payload[:name])
+    EventProf.totals[:sql] += finish - start
+    EventProf.counts[:sql] += 1
+  end
+  if %w[TRANSACTION].include?(payload[:name])
+    EventProf.totals[:sql_transaction] += finish - start
+    EventProf.counts[:sql_transaction] += 1
+  end
+end
+
+RSpec.configure do |config|
+  config.before(:suite) do
+    EventProf.example_time = 0.0
+    EventProf.example_count = 0
+    EventProf.install!
+  end
+
+  config.prepend_before(:each) do
+    @__event_prof_start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+  end
+
+  config.append_after(:each) do
+    EventProf.example_time += Process.clock_gettime(Process::CLOCK_MONOTONIC) - @__event_prof_start
+    EventProf.example_count += 1
+  end
+end
diff --git a/docs/profiling/fab_prof.rb b/docs/profiling/fab_prof.rb
new file mode 100644
index 0000000..5f81506
--- /dev/null
+++ b/docs/profiling/fab_prof.rb
@@ -0,0 +1,64 @@
+# frozen_string_literal: true
+
+# Per-fabricator create/build counts and timings.
+# Load with: bundle exec rspec --require ./tmp/profiling/fab_prof.rb spec/models
+
+module FabProf
+  class << self
+    def times = (@times ||= Hash.new(0.0))
+    def counts = (@counts ||= Hash.new(0))
+    def creates_by_model = (@creates_by_model ||= Hash.new(0))
+
+    def add(scope, name, dt)
+      key = "#{scope}:#{name}"
+      times[key] += dt
+      counts[key] += 1
+    end
+
+    def report(io = $stderr)
+      io.puts "\n=== FabProf report (per fabricator) ==="
+      io.puts format('%40s %10s %9s', 'fabricator', 'count', 'time(s)')
+      counts.sort_by { |k, _| -times[k] }.each do |k, n|
+        io.puts format('%40s %10d %9.2f', k, n, times[k])
+      end
+      total_c = counts.select { |k, _| k.start_with?('create:') }.values.sum
+      total_t = times.select { |k, _| k.start_with?('create:') }.values.sum
+      io.puts format('TOTAL creates: %d (%.2fs, nested double-counted)', total_c, total_t)
+    end
+
+    def install!
+      Fabricate.singleton_class.prepend(Module.new do
+        def create(name, ...)
+          start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+          super
+        ensure
+          FabProf.add('create', name, Process.clock_gettime(Process::CLOCK_MONOTONIC) - start)
+        end
+
+        def build(name, ...)
+          start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+          super
+        ensure
+          FabProf.add('build', name, Process.clock_gettime(Process::CLOCK_MONOTONIC) - start)
+        end
+      end)
+
+      # Count actual AR record inserts per class
+      ActiveSupport::Notifications.subscribe('sql.active_record') do |_n, _s, _f, _id, payload|
+        if payload[:name] =~ /\A(\w+) Create\z/
+          FabProf.creates_by_model[Regexp.last_match(1)] += 1
+        end
+      end
+
+      RSpec.configuration.after(:suite) do
+        FabProf.report
+        $stderr.puts "\n=== AR Create counts per model (top 30) ==="
+        FabProf.creates_by_model.sort_by { |_, v| -v }.first(30).each do |k, v|
+          $stderr.puts format('%40s %10d', k, v)
+        end
+      end
+    end
+  end
+end
+
+RSpec.configure { |c| c.before(:suite) { FabProf.install! } }
diff --git a/docs/test-suite-performance.md b/docs/test-suite-performance.md
new file mode 100644
index 0000000..578d0e1
--- /dev/null
+++ b/docs/test-suite-performance.md
@@ -0,0 +1,285 @@
+# Test suite performance optimization log
+
+This document tracks the profiling and optimization of the RSpec suite
+(spec/models first, spec/requests later). Keep it up to date: future
+optimization runs should record baselines and findings here.
+
+## Environment
+
+- Ruby 4.0.6 (+YJIT build, `--enable-yjit`), Rails 8.1, PostgreSQL 17, Redis (localhost)
+- No parallelization locally; CI splits by directory.
+- System specs and streaming specs are excluded from default runs — ignore them.
+
+## Baseline (before any changes), `bundle exec rspec spec/models`
+
+- **2 min 44.7 s** — 1795 examples, 0 failures (files took ~2.6 s to load)
+- Top-20 slowest examples only account for ~17% of total time ⇒ the cost is
+  spread across the whole suite, i.e. *shared setup/per-example overhead*,
+  not a handful of bad specs.
+
+## Profiling findings (spec/models)
+
+Instrumented with `tmp/profiling/event_prof.rb`
+(run: `bundle exec rspec spec/models --require ./tmp/profiling/event_prof.rb`):
+
+| Event            | Time   | Count  | Notes |
+|------------------|--------|--------|-------|
+| Fabrication      | ~140 s (dominant) | 4721 creates + 5554 builds | nested calls double-counted; ~all CPU, little SQL |
+| SQL (non-schema) | 22.9 s | 98,992 | only ~14% of wall time |
+| Redis total      | 0.5 s  | 5,643  | negligible; `KEYS`+`DEL` cleanup ≈ 0.2 s |
+| GC               | ~7-8%  |        | not worth tuning |
+
+Stackprof (`spec/models/account_statuses_cleanup_policy_spec.rb`) shows the
+CPU goes into ActiveSupport::Callbacks chains, Arel, model instantiation —
+i.e. **the suite is CPU-bound in Ruby, not DB-bound**.
+
+### Key discovery: inline Sidekiq during fabrication
+
+`config.active_job.queue_adapter = :sidekiq` (all environments) and
+`Sidekiq.testing!(:inline)` was forced before *every* example. Model callbacks
+enqueue jobs on nearly every fabricated record:
+
+- `Status` → `TriggerWebhookWorker` (`status.created`) — and
+  `WebhookService#call` **serializes the whole event to JSON
+  (`REST::Admin::WebhookEventSerializer`) before checking whether any webhook
+  exists**. With an empty webhooks table this is pure waste per status.
+- `Account`/`User` → `TriggerWebhookWorker` (`account.created`/`updated`),
+  `BootstrapTimelineWorker`, `ActivityTracker` redis writes,
+  `UserMailer.welcome.deliver_later` (runs inline through the sidekiq
+  ActiveJob adapter when it does fire).
+
+Switching model specs to `Sidekiq::Testing.fake!` cut a heavy subset
+(238 examples, 7 files) from 43.7 s to 29.2 s (-33%).
+
+Specs that assert enqueued jobs use rspec-sidekiq matchers
+(`have_enqueued_sidekiq_job`/`enqueue_sidekiq_job`), which *require* fake
+mode — those specs already switch modes explicitly, or now get fake by
+default. Specs that rely on job *side effects* must be tagged
+`sidekiq: :inline`.
+
+## Optimizations applied
+
+### Phase 1 — spec/models (config-level only; no factory or app changes)
+
+1. **`spec/rails_helper.rb`** — per-example Sidekiq mode selection:
+   model specs default to `:fake`; `sidekiq: :inline` metadata opts back in;
+   other spec types keep the historical `:inline` default.
+2. **`config/environments/test.rb`** — `config.log_level = :info` (SQL debug
+   logging to `log/test.log` was ~80 MB/run, ~7% of wall time in LogSubscriber
+   + IO). Override with `RAILS_LOG_LEVEL=debug` when debugging.
+3. **`spec/spec_helper.rb`** — enable YJIT for the test process
+   (`RubyVM::YJIT.enable` when available, disable with `RUBY_YJIT_ENABLE=0`).
+   CPU-bound suite ⇒ ~15% faster examples.
+
+### Results
+
+Measured on 7 heavy model spec files (238 examples, seed 1234):
+43.7 s baseline → fake: 29.2 s → +log_level: 27.1 s → +YJIT: 24.7 s (-43%)
+
+**Full `spec/models` (1795 examples):**
+
+| Run | Total time | vs baseline |
+|-----|-----------|-------------|
+| Baseline (2 runs) | 2 min 44.5-44.7 s | — |
+| After phase 1 (seed 65226) | 49.5 s | **-70%** |
+| After phase 1 (seed 42) | 51.9 s | **-68%** |
+
+Three model specs genuinely rely on inline job execution (they assert
+emails captured via `capture_emails`, which requires the delivery job to
+actually run). They are tagged `sidekiq: :inline`:
+- `spec/models/user_spec.rb` ("confirms user and delivers welcome email")
+- `spec/models/email_subscription_spec.rb` ("delivers confirmation email")
+- `spec/models/admin/account_action_spec.rb` ("sends email to target account user")
+
+Note: `capture_emails` comes from `ActionMailer::TestHelper`; any spec using
+it needs the job to really run (inline mode / `deliver_now`). When flipping
+other spec types to `:fake`, tag those specs too.
+
+The profiling helper used here lives in `docs/profiling/event_prof.rb`
+(load with `--require`); a copy also sits in `tmp/profiling/` (gitignored).
+
+## Ideas for future phases (not done yet)
+
+- Factories (next phase): `:status` fabricator creates a `:bookmark` per status;
+  `:user` fabricator creates 2 `:login_activity` records per user — likely
+  intentional vs upstream; trimming these is a factories-phase item.
+- `Rails.cache.clear` + `redis.del(redis.keys)` after every example (~1-2 s
+  total): could be made conditional on redis/cache actually being touched.
+- Consider `test-prof` (`before_all`) for heavy shared setups
+  (e.g. `spec/models/trends/*`) if it can be added to the bundle.
+
+---
+
+## Phase 2 — spec/requests (2025 run)
+
+### Baseline (before any optimization work), `bundle exec rspec spec/requests`
+
+Measured with phase-1 optimizations disabled (`RUBY_YJIT_ENABLE=0
+RAILS_LOG_LEVEL=debug`, Sidekiq `:inline` — the historical defaults for
+request specs):
+
+- **3 min 9 s** — 1877 examples, 0 failures (files took ~2.9 s to load)
+- With only phase-1 optimizations active (YJIT + `log_level :info`, Sidekiq
+  still `:inline`): **2 min 17.1 s** — i.e. phase 1 alone gave requests ~27%.
+
+### Profiling findings (spec/requests)
+
+Instrumented with the updated `docs/profiling/event_prof.rb` (see note below)
+at the phase-1 state (inline Sidekiq), total example+hook time 131.6 s:
+
+| Event             | Time    | Count   | Notes |
+|-------------------|---------|---------|-------|
+| Fabrication       | 98.9 s  | 11,030 creates + 7,548 builds | includes inline jobs fired by model callbacks (nested) |
+| **Sidekiq inline**| **43.2 s** | **7,753 jobs** | ~1/3 of example time! Distribution/notification/mail/webhook workers |
+| SQL (non-schema)  | 28.0 s  | 204,873 | |
+| request_process   | 26.6 s  | 1,956   | full rack stack per HTTP request; inherent |
+| ActiveJob inline  | 6.3 s   | 150     | mailers via the sidekiq AJ adapter |
+| Redis total       | 0.8 s   | 12,306  | negligible |
+
+NOTE (tooling): Sidekiq 8 moved the inline path from
+`Sidekiq::Client#raw_push_inline` to `TestingClient#atomic_push`, so the
+phase-1 event_prof no longer recorded inline time. The profiler now wraps
+`atomic_push` (counting only when `Sidekiq::Testing.inline?`),
+`ActiveJob::Base#perform_now` and
+`ActionDispatch::Integration::Session#process`. Use `def x(...)`/`super`
+forwarding — `def x(*)` silently breaks kwargs (e.g. rack-test `process`).
+
+### Optimization applied (config-level + tags only)
+
+**`spec/rails_helper.rb`** — request specs now default to
+`Sidekiq::Testing.fake!`, same as model specs; `sidekiq: :inline` metadata
+opts back in. Other spec types keep the historical `:inline` default.
+
+Safety notes:
+- rspec-sidekiq clears fake queues before every example
+  (`clear_all_enqueued_jobs` defaults to true) — no cross-example leakage.
+- Specs asserting enqueues via `have_enqueued_sidekiq_job` /
+  `enqueue_sidekiq_job` already call `Sidekiq.testing!(:fake)` inside the
+  example — unaffected by the default change.
+- Flipping the default surfaced 41 failing examples; all were genuinely
+  relying on inline execution and are now tagged `sidekiq: :inline`:
+  - `spec/requests/api/v1/notifications_spec.rb` (top-level describe) and
+    `spec/requests/api/v2/notifications_spec.rb` (top-level describe) —
+    notifications are created by `LocalNotificationWorker` after
+    Favourite/Reblog/Follow/PostStatus service calls in `before` hooks.
+  - `spec/requests/api/v2/notifications/accounts_spec.rb` — same reason.
+  - `spec/requests/api/v1/conversations_spec.rb` (`GET /api/v1/conversations`)
+    — conversation rows materialize via workers.
+  - `spec/requests/api/v1/timelines/home_spec.rb` (`context 'when the
+    timeline is available'`) — home feed entries are pushed by
+    `FeedInsertWorker`.
+  - `spec/requests/api/v1/statuses/favourites_spec.rb` (2 unfavourite
+    examples) — `Api::V1::Statuses::FavouritesController#destroy` delegates
+    the destroy to `UnfavouriteWorker`.
+  - `spec/requests/api/v1/admin/account_actions_spec.rb` (5 contexts) and
+    `spec/requests/api/v1/reports_spec.rb` (`'creates a report'`) —
+    `capture_emails` requires the mailer job to really run (same rule as
+    phase 1).
+- Gotcha: metadata on a `shared_examples` definition is **not** inherited
+  through `it_behaves_like` (rspec-core 3.13) — tag the enclosing
+  example group instead.
+- `spec/requests/admin/confirmations_spec.rb` uses `capture_emails` but only
+  asserts the list is empty — passes under `:fake`, no tag needed.
+
+### Results, full `spec/requests` (1877 examples)
+
+| Run | Total time | vs baseline |
+|-----|-----------|-------------|
+| Baseline (pre-optimization) | 3 min 9 s | — |
+| Phase-1 only (YJIT + log level) | 2 min 17.1 s | -27% |
+| + fake Sidekiq default (seeded) | 1 min 48.8 s / 1 min 47.8 s | **-42%** |
+
+Post-change profile: sidekiq_inline 43.2 s → 16.9 s (7,753 → 1,181 jobs,
+remainder lives in the tagged specs), fabricate 98.9 s → 73.2 s, SQL
+204,873 → 136,102 queries. Example+hook time 131.6 s → 105.3 s.
+
+Slowest remaining groups are flat (~0.2-0.3 s/example; signature
+verification RSA signing, ActivityPub replies, tagged notification specs) —
+no new shared bottleneck. Fabrication dominates; that is the factories
+phase.
+
+### Combined models + requests
+
+| | Baseline | Now | Speed-up |
+|---|---------|-----|----------|
+| spec/models | 2 min 44.7 s | ~50 s (re-verified 50.1 s, 0 failures) | 3.3x |
+| spec/requests | 3 min 9 s | ~1 min 48 s | 1.75x |
+| **Total** | **5 min 53.7 s** | **~2 min 38 s** | **2.24x** |
+
+---
+
+## Phase 3 — factory usage (spec/models + spec/requests)
+
+### Baseline (at phase-2 state, before factory changes)
+
+Measured with the per-fabricator/AR-create profiler `docs/profiling/fab_prof.rb`
+(run: `bundle exec rspec --require ./docs/profiling/fab_prof.rb spec/models`):
+
+- **spec/models: 52.1 s** — 1795 examples, 0 failures
+- **spec/requests: 1 min 47.4 s** — 1877 examples, 0 failures
+
+### Profiling findings: planted per-create side effects in fabricators
+
+AR `INSERT` counts per model revealed two fabricator `after_create` hooks
+(not present upstream) creating whole record cascades per fabricated record:
+
+| Fabricator hook | Cascade per create | Cost in spec/models | Cost in spec/requests |
+|---|---|---|---|
+| `:status` → `Fabricate(:bookmark, status:)` | +1 Bookmark **+1 Account +1 User +1 Keypair** (bookmark fabricator builds its own account) | 1,020 Bookmarks for 1,039 Statuses; Accounts 3,088, Users 2,847 | 1,463 Bookmarks for 1,726 Statuses; Accounts 5,124, Users 4,864 |
+| `:user` → `2× Fabricate(:login_activity)` | +2 LoginActivity rows | 271 LoginActivity | 2,982 LoginActivity |
+
+So every `Fabricate(:status)` persisted **6 records instead of 3**, and every
+`Fabricate(:user)` 2 extra rows — pure waste: no spec asserts on these records.
+
+Safety analysis (whole spec suite grepped):
+- Auto-bookmarks belong to a *random new account*, never the status author's
+  account, so `keep_self_bookmark` cleanup logic, `bookmarked` JSON flags,
+  exports (`account.bookmarks`) and API pagination are all unaffected by them.
+- All `Bookmark`/`LoginActivity` assertions are either explicit fabrications
+  or *relative* `change(...).by(1)` matchers — insensitive to pre-existing rows.
+- `spec/lib/mastodon/cli/media_spec.rb` actively *worked around* the hook
+  (`non_interacted_status.bookmarks.destroy_all`) — a no-op once the hook is
+  gone; the spec stays green.
+
+### Change applied (fabricators only; no example or app changes)
+
+- `spec/fabricators/status_fabricator.rb` — removed the `after_create` bookmark hook.
+- `spec/fabricators/user_fabricator.rb` — removed the `after_create` login_activity hook.
+
+### Results (0 failures everywhere; also verified with seed 777)
+
+| Group | Before phase 3 | After phase 3 | Δ |
+|---|---|---|---|
+| spec/models | 52.1 s | **43.0 s** | **-17.5%** |
+| spec/requests | 1 min 47.4 s | **1 min 38.5 s** | **-8.3%** |
+| Combined | 159.5 s | **141.4 s** | **-11.3%** |
+
+AR creates after the change (spec/models): Accounts 3,088 → 2,086 (-32%),
+Users 2,847 → 1,845 (-35%), Keypairs 3,089 → 2,087, Bookmarks ~1,020 → 0,
+LoginActivity 271 → 0.
+
+Out-of-scope spot checks (all green): spec/presenters,
+spec/services/backup_service_spec.rb,
+spec/controllers/auth/sessions_controller_spec.rb,
+spec/lib/mastodon/cli/media_spec.rb.
+
+### Cumulative (models + requests) vs original baseline
+
+| | Original baseline | After phase 3 | Speed-up |
+|---|---|---|---|
+| spec/models | 2 min 44.7 s | ~43 s | 3.8x |
+| spec/requests | 3 min 9 s | ~1 min 38 s | 1.9x |
+| **Total** | **5 min 53.7 s** | **~2 min 21 s** | **2.5x** |
+
+### Ideas for future phases
+
+- Remaining top AR creates are Account/User/Keypair per local account
+  (~2,086/1,845/2,087 in models) — upstream-intentional; trimming (e.g.
+  user-less accounts where specs don't touch `account.user`) is high-risk.
+- `Rails.cache.clear` + `redis.del(redis.keys)` after every example is still
+  unconditional (~1-2 s per group) — could be made conditional.
+- `test-prof` `before_all` for heavy shared setups (e.g. spec/models/trends/*)
+  still unexplored.
+- Reusable profilers live in `docs/profiling/`: `event_prof.rb`
+  (time per event type) and `fab_prof.rb` (per-fabricator counts + AR creates
+  per model). Both are loaded via `bundle exec rspec --require ./docs/profiling/<file>.rb <dir>`.
