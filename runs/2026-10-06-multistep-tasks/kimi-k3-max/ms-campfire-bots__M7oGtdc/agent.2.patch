new file mode 100644
index 0000000..2f3058b
--- /dev/null
+++ b/app/jobs/user/bot/webhook_job.rb
@@ -0,0 +1,8 @@
+# Delivers one bot's webhook for one message (see User::Bot::Webhook). Runs in
+# the background so talking to the endpoint never slows down the person who
+# posted the message.
+class User::Bot::WebhookJob < ApplicationJob
+  def perform(message, bot)
+    User::Bot::Webhook.new(message: message, bot: bot).deliver
+  end
+end
