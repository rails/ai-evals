diff --git a/test/jobs/user/bot/webhook_job_test.rb b/test/jobs/user/bot/webhook_job_test.rb
new file mode 100644
index 0000000..c3df7a9
--- /dev/null
+++ b/test/jobs/user/bot/webhook_job_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class User::Bot::WebhookJobTest < ActiveJob::TestCase
+  setup do
+    @bot = users(:deploy_bot)
+    @bot.update! webhook_url: "https://bots.example.com/webhook"
+    @room = rooms(:pets)
+  end
+
+  test "mentioning a bot with a webhook enqueues a delivery job" do
+    assert_enqueued_with job: User::Bot::WebhookJob do
+      mention_bot
+    end
+  end
+
+  test "mentioning a bot without a webhook enqueues nothing" do
+    @bot.update! webhook_url: nil
+
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      mention_bot
+    end
+  end
+
+  test "a bot mentioning itself enqueues nothing" do
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      @room.messages.create! creator: @bot, client_message_id: SecureRandom.uuid,
+        body: "<div>#{mention_attachment_for(:deploy_bot)} note to self</div>"
+    end
+  end
+
+  test "messages without bot mentions enqueue nothing" do
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      @room.messages.create! creator: users(:david), client_message_id: SecureRandom.uuid, body: "<div>Plain hello</div>"
+    end
+  end
+
+  test "performing the job delivers the webhook" do
+    message = mention_bot
+    stub = stub_request(:post, "https://bots.example.com/webhook").to_return(status: 204)
+
+    User::Bot::WebhookJob.perform_now(message, @bot)
+
+    assert_requested stub
+  end
+
+  private
+    def mention_bot
+      @room.messages.create! creator: users(:david), client_message_id: SecureRandom.uuid,
+        body: "<div>#{mention_attachment_for(:deploy_bot)} restart the build please</div>"
+    end
+end
