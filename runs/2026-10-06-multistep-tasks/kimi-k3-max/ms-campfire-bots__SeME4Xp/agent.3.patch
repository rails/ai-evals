+    rooms(:designers).memberships.grant_to(shy_bot)
+
+    room = rooms(:designers).becomes!(Rooms::Open)
+    room.save!
+
+    assert room.users.reload.include?(shy_bot), "manually added bots stay members when their room turns open"
+  end
 end
