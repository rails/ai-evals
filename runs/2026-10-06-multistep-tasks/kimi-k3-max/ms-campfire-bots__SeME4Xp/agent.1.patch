diff --git a/app/models/user/bots.rb b/app/models/user/bots.rb
new file mode 100644
index 0000000..3087bdf
--- /dev/null
+++ b/app/models/user/bots.rb
@@ -0,0 +1,21 @@
+module User::Bots
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :bots, class_name: "User", foreign_key: :creator_id, dependent: :destroy
+
+    scope :bots, -> { where(bot: true) }
+
+    before_create :generate_bot_credentials, if: :bot?
+  end
+
+  private
+    def generate_bot_credentials
+      self.bot_key ||= SecureRandom.hex(24)
+
+      # Bots never sign in, but password_digest can't be null. Give them a
+      # password nobody knows.
+      self.password ||= SecureRandom.hex(24)
+    end
+end
