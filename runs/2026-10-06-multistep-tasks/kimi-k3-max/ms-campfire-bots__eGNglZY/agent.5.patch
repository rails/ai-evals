+
+    assert_no_difference -> { @room.messages.count } do
+      Bots::Webhook.deliver_mention(bot: @bot, message: message)
+    end
+
+    assert @bot.reload.cooling_down?
+  end
+
+  test "webhook replies count towards the rate limit" do
+    message = mention_the_bot
+    9.times { |i| @room.messages.create!(creator: @bot, body: "Flood #{i}", client_message_id: "flood-#{i}") }
+
+    WebMock.stub_request(:post, "https://bot.example.com/hook").to_return(status: 200, body: "Build restarted", headers: { content_type: "text/plain" })
+
+    assert_difference -> { @room.messages.count }, 1 do
+      Bots::Webhook.deliver_mention(bot: @bot, message: message)
+    end
+
+    assert_not @bot.reload.cooling_down?
+  end
+
   private
