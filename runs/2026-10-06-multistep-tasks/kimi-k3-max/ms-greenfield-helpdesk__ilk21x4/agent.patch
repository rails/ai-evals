+# must resume at the exact position, never truncating the fractional part.
+t0 = Time.utc(2026, 4, 4, 10, 0, 0)
+frac_times = [0.100001, 0.200002, 0.300003, 0.400004, 0.500005].map { |f| t0 + f }
+frac_times.each_with_index do |stamp, i|
