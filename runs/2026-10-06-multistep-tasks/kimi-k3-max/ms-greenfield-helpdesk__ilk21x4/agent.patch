diff --git a/app/mailers/ticket_mailer.rb b/app/mailers/ticket_mailer.rb
new file mode 100644
index 0000000..493d7ac
--- /dev/null
+++ b/app/mailers/ticket_mailer.rb
@@ -0,0 +1,19 @@
+class TicketMailer < ApplicationMailer
+  # Emails a staff member's public reply to the requester of an email-origin
+  # ticket. The message comes from the ticket's private reply address, so
+  # the customer can answer straight from their mail client and land back in
+  # the same conversation. Auto-Submitted keeps auto-responders quiet.
+  def staff_reply(ticket, comment)
+    @ticket = ticket
+    @account = ticket.account
+    @comment = comment
+
+    mail(
+      to: ticket.requester.email,
+      from: "#{@account.name} Support <#{ticket.reply_email_address}>",
+      reply_to: ticket.reply_email_address,
+      subject: "Re: #{ticket.subject}",
+      "Auto-Submitted" => "auto-generated"
+    )
+  end
+end
diff --git a/app/mailers/user_mailer.rb b/app/mailers/user_mailer.rb
new file mode 100644
index 0000000..70b5147
--- /dev/null
+++ b/app/mailers/user_mailer.rb
@@ -0,0 +1,36 @@
+class UserMailer < ApplicationMailer
+  # Sends the email-verification link for a freshly signed-up (or re-requested)
+  # user. The link points at the frontend app.
+  def email_verification(user)
+    @user = user
+    @account = user.account
+    @url = "#{frontend_url}/verify-email?account=#{@account.subdomain}&token=#{user.verification_token}"
+
+    mail(to: user.email, subject: "Verify your email address")
+  end
+
+  # Sends the password-reset link; the link points at the frontend app.
+  def password_reset(user)
+    @user = user
+    @account = user.account
+    @url = "#{frontend_url}/reset-password?account=#{@account.subdomain}&token=#{user.reset_password_token}"
+
+    mail(to: user.email, subject: "Reset your password")
+  end
+
+  # Sends a staff invitation; the link points at the frontend's acceptance
+  # screen.
+  def invitation(invitation)
+    @invitation = invitation
+    @account = invitation.account
+    @url = "#{frontend_url}/accept-invitation?account=#{@account.subdomain}&token=#{invitation.token}"
+
+    mail(to: invitation.email, subject: "You're invited to join #{@account.name}")
+  end
+
+  private
+
+  def frontend_url
+    Rails.application.config.x.helpdesk.frontend_url
+  end
+end
diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..ca5bd92
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,52 @@
+class Account < ApplicationRecord
+  # Cancelled accounts can be reactivated within this window. After it, they
+  # are permanently purged (see `bin/rails helpdesk:purge_cancelled_accounts`).
+  REACTIVATION_PERIOD = 90.days
+
+  has_many :users, dependent: :destroy
+  has_many :sessions, through: :users
+  has_many :tickets, dependent: :destroy
+  has_many :invitations, dependent: :destroy
+  has_many :groups, dependent: :destroy
+  has_many :group_memberships, through: :groups
+
+  normalizes :subdomain, with: ->(value) { value.strip.downcase }
+
+  validates :name, presence: true
+  validates :subdomain,
+    presence: true,
+    uniqueness: { case_sensitive: false },
+    format: {
+      with: /\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z/,
+      message: "may only contain lowercase letters, numbers, and hyphens"
+    }
+
+  scope :cancelled, -> { where.not(cancelled_at: nil) }
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  # The business's support address at the shared support domain, e.g.
+  # acme@support.example.test.
+  def support_email_address
+    "#{subdomain}@#{Rails.application.config.x.helpdesk.support_domain}"
+  end
+
+  # Cancels the account and revokes every session of every user, stopping
+  # ordinary business access. The owner can still sign back in to reactivate.
+  def cancel!
+    transaction do
+      update!(cancelled_at: Time.current)
+      Session.where(user_id: users.select(:id)).destroy_all
+    end
+  end
+
+  def reactivate!
+    update!(cancelled_at: nil)
+  end
+
+  def reactivation_expired?
+    cancelled? && cancelled_at <= REACTIVATION_PERIOD.ago
+  end
+end
