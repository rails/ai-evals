+  Ticket.where(id: tk.id).update_all(created_at: stamp, updated_at: stamp)
+end
+frac_ids = account.tickets.where("subject LIKE 'Frac %'").recently_active.pluck(:id)
+walk = []
+url = "/api/v1/tickets?page[size]=2&status=open"
+loop do
+  res = api_get(url, STAFF)
+  walk += res["tickets"].map { |t| t["id"] }
+  break unless res["links"]["next"]
+  url = res["links"]["next"]
+end
