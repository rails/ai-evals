+# Edge cases and performance characteristics of cursor pagination. Run with:
+#   RAILS_ENV=test RAILS_INBOUND_EMAIL_PASSWORD=secret bin/rails runner script/verify_cursor_pagination_edge.rb
+
+$failures = []
+def check(desc)
+  result = yield
+  if result
+    puts "  ok: #{desc}"
+  else
+    $failures << desc
+    puts "  FAIL: #{desc}"
+  end
+rescue => e
+  $failures << "#{desc} (#{e.class}: #{e.message})"
+  puts "  FAIL: #{desc} raised #{e.class}: #{e.message}"
+end
