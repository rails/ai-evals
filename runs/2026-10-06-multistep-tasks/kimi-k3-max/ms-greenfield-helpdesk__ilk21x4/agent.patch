new file mode 100644
index 0000000..d0bcfa0
--- /dev/null
+++ b/lib/helpdesk_cors.rb
@@ -0,0 +1,56 @@
+# frozen_string_literal: true
+
+# Minimal CORS middleware that allows cross-origin requests from the
+# configured frontend origin (HELPDESK_FRONTEND_URL).
+#
+# Adds CORS response headers to requests that carry a matching Origin header
+# and answers preflight (OPTIONS) requests directly.
+class HelpdeskCors
+  ALLOW_METHODS = "GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD".freeze
+  ALLOW_HEADERS = "Authorization, Content-Type, X-Helpdesk-Account, X-Requested-With".freeze
+  MAX_AGE = "7200".freeze
+
+  def initialize(app)
+    @app = app
+  end
+
+  def call(env)
+    origin = env["HTTP_ORIGIN"]
+
+    if preflight?(env)
+      return [200, cors_headers(origin), []]
+    end
+
+    status, headers, body = @app.call(env)
+    cors_headers(origin).each { |key, value| headers[key] = value } if origin.present?
+    [status, headers, body]
+  end
+
+  private
+
+  def preflight?(env)
+    env["REQUEST_METHOD"] == "OPTIONS" &&
+      env["HTTP_ORIGIN"].present? &&
+      env["HTTP_ACCESS_CONTROL_REQUEST_METHOD"].present?
+  end
+
+  def allowed_origin
+    @allowed_origin ||=
+      ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001").sub(%r{/+\z}, "")
+  end
+
+  def cors_headers(origin)
+    headers = {
+      "Access-Control-Allow-Methods" => ALLOW_METHODS,
+      "Access-Control-Allow-Headers" => ALLOW_HEADERS,
+      "Access-Control-Max-Age" => MAX_AGE
+    }
+
+    if origin.present? && origin.sub(%r{/+\z}, "") == allowed_origin
+      headers["Access-Control-Allow-Origin"] = allowed_origin
+      headers["Vary"] = "Origin"
+    end
+
+    headers
+  end
+end
