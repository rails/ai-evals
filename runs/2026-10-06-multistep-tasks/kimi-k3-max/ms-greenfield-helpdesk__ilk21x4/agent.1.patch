+class UserMailer < ApplicationMailer
+  # Sends the email-verification link for a freshly signed-up (or re-requested)
+  # user. The link points at the frontend app.
+  def email_verification(user)
+    @user = user
+    @account = user.account
+    @url = "#{frontend_url}/verify-email?account=#{@account.subdomain}&token=#{user.verification_token}"
+
+    mail(to: user.email, subject: "Verify your email address")
+  end
+
+  # Sends the password-reset link; the link points at the frontend app.
+  def password_reset(user)
+    @user = user
+    @account = user.account
+    @url = "#{frontend_url}/reset-password?account=#{@account.subdomain}&token=#{user.reset_password_token}"
+
+    mail(to: user.email, subject: "Reset your password")
+  end
+
+  private
+
+  def frontend_url
+    Rails.application.config.x.helpdesk.frontend_url
+  end
+end
