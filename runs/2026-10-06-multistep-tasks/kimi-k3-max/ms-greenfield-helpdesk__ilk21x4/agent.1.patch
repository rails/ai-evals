@@ -0,0 +1,48 @@
+module Api
+  module V1
+    class SessionsController < BaseController
+      before_action :authenticate!, only: :destroy
+
+      # POST /api/v1/sessions
+      def create
+        user = current_account.users.find_by(email: normalized_email)
+
+        unless user&.authenticate(session_params[:password].to_s)
+          return render json: { error: "invalid_credentials" }, status: :unauthorized
+        end
+
+        if current_account.cancelled? && !user.admin?
+          return render json: { error: "account_cancelled" }, status: :forbidden
+        end
+
+        unless user.verified?
+          return render json: { error: "email_not_verified" }, status: :forbidden
+        end
+
+        session = user.sessions.create!
+
+        render json: {
+          session: session_json(session),
+          user: user_json(user),
+          account: account_json(current_account)
+        }, status: :created
+      end
+
+      # DELETE /api/v1/session
+      def destroy
+        current_session.destroy!
+        head :no_content
+      end
+
+      private
+
+      def session_params
+        params.require(:session).permit(:email, :password)
+      end
+
+      def normalized_email
+        session_params[:email].to_s.strip.downcase
+      end
+    end
+  end
+end
