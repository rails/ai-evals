+namespace :helpdesk do
+  desc "Permanently delete accounts (and all their data) that were cancelled more than 90 days ago"
+  task purge_cancelled_accounts: :environment do
+    cutoff = Account::REACTIVATION_PERIOD.ago
+    accounts = Account.where("cancelled_at < ?", cutoff)
+
+    count = accounts.count
+    accounts.find_each(&:destroy!)
+
+    puts "Purged #{count} cancelled account#{"s" unless count == 1} (cancelled before #{cutoff.iso8601})."
+  end
+end
