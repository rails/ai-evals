@@ -0,0 +1,12 @@
+# frozen_string_literal: true
+
+# Dual-boot Gemfile for the next release (Rails 7.0). See docs/UPGRADE.md.
+#
+# Everything is shared with the main Gemfile; the `next?` helper there
+# switches the Rails version (and any Rails-version-locked gems) when
+# Bundler runs against this file:
+#
+#   BUNDLE_GEMFILE=Gemfile.next bundle install
+#   BUNDLE_GEMFILE=Gemfile.next bundle exec rails test
+#
+eval_gemfile File.expand_path('Gemfile', __dir__)
