diff --git a/config/application.rb b/config/application.rb
index 5e93df1..746c09c 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -26,6 +26,64 @@ module RedmineApp
     # Custom directories with classes and modules you want to be autoloadable.
     config.autoloader = :zeitwerk
 
+    # ------------------------------------------------------------------
+    # Rails 6.1 -> 7.0 upgrade (see docs/UPGRADE.md)
+    #
+    # The current production release runs Rails 6.1 and, like the previous
+    # release, does not load framework defaults. The next release runs
+    # Rails 7.0 (built with Gemfile.next) on the Rails 7.0 framework
+    # defaults:
+    config.load_defaults 7.0 if Rails.gem_version >= Gem::Version.new('7.0')
+    #
+    # The settings below are *temporary* overrides of the Rails 7.0
+    # framework defaults. They keep session cookies, signed cookies,
+    # mail-link tokens (Mailer.mail_link_token) and cache entries readable
+    # in both directions, so neither the upgrade nor a rollback signs
+    # anyone out or breaks links in mails that were already sent. On
+    # Rails 6.1 they are no-ops because they match the built-in defaults
+    # (unknown keys are ignored by the 6.1 railtie). Do not remove them
+    # until rollback to Rails 6.1 is no longer supported; the migration
+    # steps are documented in docs/UPGRADE.md.
+
+    # Rails 6.1 can only derive keys with SHA1 (PBKDF2-HMAC-SHA1), so keep
+    # SHA1 key derivation on Rails 7.0 as well. Otherwise Rails 6.1 could
+    # not verify session cookies or mail-link tokens generated by the
+    # Rails 7.0 release.
+    config.active_support.key_generator_hash_digest_class = OpenSSL::Digest::SHA1
+
+    # Rails 6.1 cannot read cache entries written in the Rails 7.0 cache
+    # format (Rails 7.0 can read the 6.1 format).
+    config.active_support.cache_format_version = 6.1
+
+    # Cookies must not embed purpose metadata: releases without metadata
+    # support cannot read cookies written with it and vice versa.
+    config.action_dispatch.use_cookies_with_metadata = false
+
+    # Rails 7.0's default :json cookie serializer cannot read the Marshal
+    # session cookies written by Rails 6.1. :marshal reads both Marshal
+    # and JSON on either version.
+    config.action_dispatch.cookies_serializer = :marshal
+
+    # Deferred Rails 7.0 framework defaults (not rollback-critical, but the
+    # application is not ready for them yet; see docs/UPGRADE.md):
+    #
+    # Redmine's models declare belongs_to associations without :optional,
+    # relying on the pre-5.0 behavior. Requiring them by default breaks
+    # validations all over the app (e.g. User#auth_source). Audit the
+    # associations before enabling this.
+    config.active_record.belongs_to_required_by_default = false
+
+    # ApplicationController#redirect_to_referer_or redirects to the raw
+    # Referer header. With raise_on_open_redirects, a referer that Rails
+    # cannot parse (or that points to another host) raises
+    # UnsafeRedirectError instead of redirecting. Keep the 6.1 behavior
+    # until redirect_to_referer_or handles this properly.
+    # (The option does not exist on Rails 6.1, and its railtie rejects
+    # unknown option keys, so only set it on Rails 7.0.)
+    if Rails.gem_version >= Gem::Version.new('7.0')
+      config.action_controller.raise_on_open_redirects = false
+    end
+
     # Only load the plugins named here, in the order given (default is alphabetical).
     # :all can be used as a placeholder for all plugins not explicitly named.
