new file mode 100644
index 0000000..182e780
--- /dev/null
+++ b/spec/requests/active_storage_blobs_spec.rb
@@ -0,0 +1,41 @@
+require "rails_helper"
+
+RSpec.describe "Active Storage profile image serving" do
+  let(:image_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+
+  it "serves a user's Active Storage profile image over HTTP" do
+    user = create(:user, profile_image: File.open(image_path))
+
+    # The URL the app hands out for the profile image...
+    uri = URI.parse(user.profile_image_url)
+    get uri.path
+
+    # ...redirects to the storage service...
+    expect(response).to have_http_status(:redirect)
+    follow_redirect!
+
+    # ...which serves the uploaded bytes.
+    expect(response).to have_http_status(:ok)
+    expect(response.body.bytesize).to eq(File.binread(image_path).bytesize)
+  end
+
+  it "serves an organization's Active Storage profile image over HTTP" do
+    organization = create(:organization)
+
+    get URI.parse(organization.profile_image_url).path
+    expect(response).to have_http_status(:redirect)
+    follow_redirect!
+    expect(response).to have_http_status(:ok)
+  end
+
+  it "returns 404 for a bogus signed id" do
+    get "/rails/active_storage/blobs/redirect/bogus--signature/image.png"
+    expect(response).to have_http_status(:not_found)
+  end
+
+  it "does not route /rails/active_storage/* to the catch-all pages controller" do
+    expect(
+      Rails.application.routes.recognize_path("/rails/active_storage/blobs/redirect/xyz/image.png"),
+    ).to include(controller: "active_storage/blobs/redirect", action: "show")
+  end
+end
