@@ -0,0 +1,8 @@
+namespace :profile_images do
+  desc "Copy existing user and organization profile images from CarrierWave into Active Storage. " \
+       "Runs automatically after every deploy (see release-tasks.sh) and is idempotent: " \
+       "safe to re-run — e.g. after an interruption — until it reports nothing left to copy."
+  task copy: :environment do
+    ProfileImages::CopyToActiveStorage.call
+  end
+end
