+  <input class="input" type="text" name="options[<%= index %>][body]" value="<%= row[:body] %>"
+         placeholder="Option text" aria-label="Option <%= number %>" data-option-row-body>
+  <label class="checkbox">
+    <input type="checkbox" name="options[<%= index %>][correct]" value="1"
+           <%= "checked" if row[:correct] %> aria-label="Option <%= number %> is correct" data-option-row-correct>
+    Correct
+  </label>
+  <button type="button" class="btn btn--danger btn--icon" aria-label="Remove option <%= number %>" data-option-row-remove>✕</button>
+</div>
