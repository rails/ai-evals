+<div class="card">
+  <%= form_with url: question.persisted? ? moderate_quiz_question_path(quiz, question) : moderate_quiz_questions_path(quiz),
+        method: question.persisted? ? :patch : :post do %>
+    <div class="field">
+      <label class="field-label" for="question_body">Question</label>
+      <textarea class="input" rows="3" name="question[body]" id="question_body" required><%= question.body %></textarea>
+    </div>
+
+    <div class="field">
+      <span class="field-label">Options</span>
+      <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
+    </div>
+
+    <div class="option-rows" data-option-rows>
+      <% option_rows.each_with_index do |row, index| %>
+        <%= render "option_row", index: index, number: index + 1, row: row %>
+      <% end %>
+    </div>
+    <div class="buttons" style="margin-bottom: 28px">
+      <button type="button" class="btn btn--ghost btn--sm" data-option-row-add>Add option</button>
+    </div>
+
+    <div class="field">
+      <label class="checkbox" for="question_active">
+        <input type="hidden" name="question[active]" value="0">
+        <input type="checkbox" name="question[active]" id="question_active" value="1" <%= "checked" if question.active? %>>
+        Active
+      </label>
+      <span class="field-hint">Only active questions are played.</span>
+    </div>
+
+    <% if question.errors.any? %>
+      <div class="errors">
+        <ul>
+          <% question.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <div class="buttons">
+      <button type="submit" class="btn btn--pink">Save question</button>
+      <%= link_to "Cancel", moderate_quiz_path(quiz), class: "btn btn--ghost" %>
+    </div>
+  <% end %>
+</div>
+
+<template data-option-row-template>
+  <%= render "option_row", index: 0, number: 1, row: { body: "", correct: false } %>
+</template>
