+module Moderate
+  class QuizzesController < BaseController
+    before_action :set_quiz, only: %i[show edit update destroy]
+
+    def index
+      @quizzes = Quiz.includes(:questions).order(:id)
+    end
+
+    def new
+      @quiz = Quiz.new
+    end
+
+    def create
+      @quiz = Quiz.new(quiz_params)
+
+      if @quiz.save
+        redirect_to moderate_quiz_path(@quiz), notice: "Quiz saved."
+      else
+        render :new, status: :unprocessable_entity
+      end
+    end
+
+    def show
+      @questions = @quiz.questions.includes(:options)
+    end
+
+    def edit
+    end
+
+    def update
+      if @quiz.update(quiz_params)
+        redirect_to moderate_quiz_path(@quiz), notice: "Quiz saved."
+      else
+        render :edit, status: :unprocessable_entity
+      end
+    end
+
+    def destroy
+      @quiz.destroy!
+      redirect_to moderate_quizzes_path, notice: "Quiz deleted."
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:id])
+    end
+
+    def quiz_params
+      params.require(:quiz).permit(:title)
+    end
+  end
+end
