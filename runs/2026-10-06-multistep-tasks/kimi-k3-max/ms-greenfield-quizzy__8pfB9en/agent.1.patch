+Rails.application.routes.draw do
+  # Reveal health status on /up that returns 200 if the app boots with no exceptions, otherwise 500.
+  get "up" => "rails/health#show", as: :rails_health_check
+
+  root to: redirect("/moderate")
+
+  namespace :moderate do
+    root "quizzes#index"
+
+    resources :quizzes do
+      resources :questions, except: %i[index show] do
+        member do
+          patch :move_up
+          patch :move_down
+        end
+      end
+
+      get "preview" => "previews#show", as: :preview
+      post "preview/answer" => "previews#answer", as: :preview_answer
+      get "preview/score" => "previews#score", as: :preview_score
+    end
+  end
+end
