+
+  <% if @questions.empty? %>
+    <div class="empty">No questions yet. Use the &ldquo;Add question&rdquo; button to write the first one.</div>
+  <% else %>
+    <ul class="question-list">
+      <% active_number = 0 %>
+      <% @questions.each_with_index do |question, index| %>
+        <% active_number += 1 if question.active? %>
+        <li class="card question-item <%= "question-item--inactive" unless question.active? %>" id="question_<%= question.id %>">
+          <div class="question-item__num"><%= question.active? ? active_number : "—" %></div>
+
+          <div>
+            <div class="question-item__body"><%= question.body %></div>
+            <ul class="question-item__options">
+              <% question.options.each_with_index do |option, option_index| %>
+                <li class="<%= "is-correct" if option.correct? %>"><%= option_letter(option_index) %>. <%= option.body %></li>
+              <% end %>
+            </ul>
+          </div>
+
+          <div class="question-item__actions">
+            <div class="buttons">
+              <%= button_to "Move up", move_up_moderate_quiz_question_path(@quiz, question),
+                    method: :patch, class: "btn btn--ghost btn--sm", disabled: index.zero? %>
+              <%= button_to "Move down", move_down_moderate_quiz_question_path(@quiz, question),
+                    method: :patch, class: "btn btn--ghost btn--sm", disabled: index == @questions.size - 1 %>
