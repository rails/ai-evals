diff --git a/app/assets/javascripts/quizzy.js b/app/assets/javascripts/quizzy.js
new file mode 100644
index 0000000..5e280ad
--- /dev/null
+++ b/app/assets/javascripts/quizzy.js
@@ -0,0 +1,104 @@
+/*
+ * Quizzy moderation UI behaviour (no framework, progressive enhancement):
+ *
+ *  - [data-confirm]: ask with the browser's native confirm() dialog before
+ *    following the link or submitting the form.
+ *  - [data-autosubmit]: submit the surrounding form as soon as the control
+ *    changes (the "Active" switches on the quiz page).
+ *  - Option rows in the question form: "Add option" appends a row, the ✕
+ *    button removes one, and rows are renumbered after every change.
+ */
+(function () {
+  "use strict";
+
+  // Native confirm() dialog for destructive actions.
+  document.addEventListener("click", function (event) {
+    var element = event.target.closest("[data-confirm]");
+    if (element && !window.confirm(element.getAttribute("data-confirm"))) {
+      event.preventDefault();
+      event.stopPropagation();
+      event.stopImmediatePropagation();
+    }
+  });
+
+  // Checkboxes that save immediately on change.
+  document.addEventListener("change", function (event) {
+    var element = event.target.closest("[data-autosubmit]");
+    if (!element) return;
+
+    var form = element.closest("form");
+    if (!form) return;
+
+    if (form.requestSubmit) {
+      form.requestSubmit();
+    } else {
+      form.submit();
+    }
+  });
+
+  // ---- Option rows in the question form ----
+
+  function optionRowsContainer() {
+    return document.querySelector("[data-option-rows]");
+  }
+
+  function optionRowTemplate() {
+    return document.querySelector("template[data-option-row-template]");
+  }
+
+  // Renumbers rows so labels read "Option 1", "Option 2", ... and the
+  // parameter names stay a clean 0-based sequence.
+  function renumberOptionRows() {
+    var container = optionRowsContainer();
+    if (!container) return;
+
+    container.querySelectorAll("[data-option-row]").forEach(function (row, index) {
+      var number = index + 1;
+
+      row.querySelectorAll("[name]").forEach(function (field) {
+        field.name = field.name.replace(/options\[\d+\]/, "options[" + index + "]");
+      });
+
+      var bodyField = row.querySelector("[data-option-row-body]");
+      if (bodyField) {
+        bodyField.setAttribute("aria-label", "Option " + number);
+      }
+
+      var correctField = row.querySelector("[data-option-row-correct]");
+      if (correctField) {
+        correctField.setAttribute("aria-label", "Option " + number + " is correct");
+      }
+
+      var removeButton = row.querySelector("[data-option-row-remove]");
+      if (removeButton) {
+        removeButton.setAttribute("aria-label", "Remove option " + number);
+      }
+    });
+  }
+
+  document.addEventListener("click", function (event) {
+    if (event.target.closest("[data-option-row-add]")) {
+      var container = optionRowsContainer();
+      var template = optionRowTemplate();
+      if (!container || !template) return;
+
+      container.appendChild(template.content.cloneNode(true));
+      renumberOptionRows();
+
+      var rows = container.querySelectorAll("[data-option-row]");
+      var newBodyField = rows[rows.length - 1].querySelector("[data-option-row-body]");
+      if (newBodyField) newBodyField.focus();
+
+      event.preventDefault();
+      return;
+    }
+
+    var removeButton = event.target.closest("[data-option-row-remove]");
+    if (removeButton) {
+      var row = removeButton.closest("[data-option-row]");
+      if (row) row.remove();
+      renumberOptionRows();
+      event.preventDefault();
+    }
+  });
+})();
