+
+            <%= form_with url: moderate_quiz_question_path(@quiz, question), method: :patch, class: "inline-form" do %>
+              <input type="hidden" name="question[active]" value="0">
+              <label class="checkbox" for="question_<%= question.id %>_active">
+                <input type="checkbox" name="question[active]" id="question_<%= question.id %>_active"
+                       value="1" <%= "checked" if question.active? %> data-autosubmit>
+                Active
+              </label>
+            <% end %>
+
+            <div class="buttons">
+              <%= link_to "Edit", edit_moderate_quiz_question_path(@quiz, question), class: "btn btn--sm" %>
+              <%= button_to "Delete", moderate_quiz_question_path(@quiz, question),
+                    method: :delete, class: "btn btn--sm btn--danger",
+                    data: { confirm: "Delete this question?" } %>
+            </div>
+          </div>
+        </li>
+      <% end %>
+    </ul>
+  <% end %>
+</section>
