diff --git a/bin/serve b/bin/serve
new file mode 100755
index 0000000..112c7be
--- /dev/null
+++ b/bin/serve
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+# Starts Quizzy in production mode in the foreground.
+#
+# Required environment: RAILS_ENV=production, PORT, SECRET_KEY_BASE,
+# QUIZZY_MODERATOR_USERNAME, QUIZZY_MODERATOR_PASSWORD.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+
+rm -f tmp/pids/server.pid
+
+# All gems are installed while building; this is an offline-safe no-op then.
+bundle check >/dev/null 2>&1 || bundle install --local
+
+# Create storage/production.sqlite3 and load the schema (also runs pending
+# migrations when the database already exists).
+bin/rails db:prepare
+
+# Compile the assets (propshaft digests them into public/assets).
+bin/rails assets:precompile
+
+# Run the app in the foreground, listening on all interfaces.
+exec bin/rails server -b 0.0.0.0 -p "${PORT:-3000}"
