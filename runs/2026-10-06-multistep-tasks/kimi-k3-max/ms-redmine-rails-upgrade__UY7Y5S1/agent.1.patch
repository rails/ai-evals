diff --git a/Gemfile.next b/Gemfile.next
new file mode 100644
index 0000000..3091b79
--- /dev/null
+++ b/Gemfile.next
@@ -0,0 +1,17 @@
+# frozen_string_literal: true
+
+# Dual-boot Gemfile for the next release: Rails 7.0 on Ruby 3.2.
+#
+# It reuses the shared Gemfile and only swaps the Rails version (and the few
+# gems that must track the Rails version). Bundler resolves it to
+# Gemfile.next.lock, so the production lockfile (Gemfile.lock, Rails 6.1)
+# stays untouched and can be rolled back to at any time.
+#
+# Usage:
+#   BUNDLE_GEMFILE=Gemfile.next bundle install
+#   BUNDLE_GEMFILE=Gemfile.next bundle exec rails test
+#
+# See docs/UPGRADE.md for the full upgrade and rollback plan.
+
+ENV['REDMINE_RAILS_NEXT'] = '1'
+eval_gemfile File.expand_path('Gemfile', __dir__)
