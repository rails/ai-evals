diff --git a/spec/rails_helper.rb b/spec/rails_helper.rb
index a91461b..48bfee7 100644
--- a/spec/rails_helper.rb
+++ b/spec/rails_helper.rb
@@ -109,6 +109,21 @@ RSpec.configure do |config|
     Sidekiq.testing!(:inline)
   end
 
+  # Model specs barely depend on jobs actually running, while many model callbacks
+  # enqueue jobs on creation/update (e.g. `TriggerWebhookWorker` serializes the record
+  # even when no webhooks are configured). Running those jobs inline for every example
+  # adds a large per-example overhead, so use `fake!` (enqueue-only) mode instead and
+  # clear the in-memory queues between examples to avoid cross-example leakage.
+  #
+  # Examples/groups that genuinely need jobs to run can be tagged with `:sidekiq_inline`.
+  config.before :each, type: :model do |example|
+    Sidekiq.testing!(example.metadata[:sidekiq_inline] ? :inline : :fake)
+  end
+
+  config.after :each, type: :model do
+    Sidekiq::Queues.clear_all
+  end
+
   config.before :each, type: :cli do
     stub_reset_connection_pools
   end
