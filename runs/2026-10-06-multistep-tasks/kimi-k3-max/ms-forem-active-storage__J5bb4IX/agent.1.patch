diff --git a/app/models/concerns/profile_image_migration.rb b/app/models/concerns/profile_image_migration.rb
new file mode 100644
index 0000000..d082aad
--- /dev/null
+++ b/app/models/concerns/profile_image_migration.rb
@@ -0,0 +1,203 @@
+require "open-uri"
+
+# Support for the deploy-by-deploy migration of profile images (users and
+# organizations) from CarrierWave to Active Storage.
+#
+# As of the first deploy:
+#
+# * New profile images are stored in Active Storage via
+#   `has_one_attached :profile_image`. Assigning `profile_image=` (a file
+#   upload) or `remote_profile_image_url=` (a URL, e.g. from an OAuth
+#   provider) attaches an Active Storage blob.
+# * Profile images uploaded before the migration stay right where they are.
+#   They remain readable through the still-mounted CarrierWave uploader
+#   (`mount_uploader :profile_image, ProfileImageUploader`, which serializes
+#   to the `profile_image` column) and `profile_image_url` keeps returning
+#   their CarrierWave URL.
+#
+# Including models must mount the CarrierWave uploader and declare the
+# Active Storage attachment (in that order):
+#
+#   mount_uploader :profile_image, ProfileImageUploader
+#   has_one_attached :profile_image
+#
+# Once every legacy image has been migrated (a future deploy), the
+# CarrierWave mount and this concern can be removed.
+module ProfileImageMigration
+  extend ActiveSupport::Concern
+
+  included do
+    prepend CarrierWaveCompatibility
+
+    # Active Storage attachment changes don't mark the `profile_image`
+    # column as changed, so remember them to let models bust caches and
+    # re-generate dependent images exactly like a CarrierWave change does.
+    after_save :note_profile_image_attachment_change
+
+    # CarrierWave's uploader used to reject oversized files and disallowed
+    # extensions; keep the same guardrails for Active Storage uploads.
+    validate :active_storage_profile_image_must_be_valid
+  end
+
+  # CarrierWave's `mount_uploader` defines `profile_image`, `profile_image=`
+  # and `profile_image_url` directly on the model class and in a module that
+  # sits above the one `has_one_attached` generates. These methods must take
+  # precedence over both, hence the prepend.
+  module CarrierWaveCompatibility
+    # The Active Storage attachment holding the profile image, mirroring the
+    # reader `has_one_attached :profile_image` generates.
+    def profile_image
+      @active_storage_attached_profile_image ||=
+        ActiveStorage::Attached::One.new("profile_image", self)
+    end
+
+    # Mirrors the writer `has_one_attached :profile_image` generates, so new
+    # uploads go to Active Storage instead of CarrierWave. CarrierWave
+    # treated assigning nil/"" as a no-op; preserve that so a form submitted
+    # without a file never clears the existing image.
+    def profile_image=(attachable)
+      return if attachable.blank?
+
+      change = build_active_storage_profile_image_change(attachable)
+      attachment_changes["profile_image"] = change if change
+    end
+
+    # The URL of the profile image, no matter where it's stored: Active
+    # Storage for images uploaded after the migration, CarrierWave for the
+    # ones uploaded before it.
+    def profile_image_url(*args)
+      return active_storage_profile_image_url if profile_image.attached?
+
+      legacy_profile_image.url(*args)
+    end
+
+    # Mirrors CarrierWave's reader, returning the last remote URL assigned
+    # in this session, if any.
+    def remote_profile_image_url
+      @remote_profile_image_url
+    end
+
+    # CarrierWave used to expose `remote_profile_image_url=` to assign an
+    # image straight from a URL (used by OAuth signups and the API). Keep the
+    # interface, but store the downloaded image in Active Storage. As before,
+    # a failed download doesn't raise; the image is simply not changed.
+    def remote_profile_image_url=(value)
+      return if value.blank?
+
+      if value.is_a?(String)
+        @remote_profile_image_url = value
+        attach_remote_profile_image(value)
+      else
+        # Images::SafeRemoteProfileImageUrl falls back to a local File when
+        # given an unusable URL.
+        self.profile_image = value
+      end
+    end
+  end
+
+  # The CarrierWave uploader holding the profile image uploaded before the
+  # migration, if any. New uploads never populate it.
+  def legacy_profile_image
+    _mounter(:profile_image).uploaders[0] ||= _mounter(:profile_image).blank_uploader
+  end
+
+  # `render json:` and friends serialize the record's attributes through
+  # `read_attribute_for_serialization`, which dispatches to the attribute's
+  # reader method. Return a value that serializes like CarrierWave's uploader
+  # used to (`{"url" => "..."}`), never the attachment proxy (which is not
+  # JSON-serializable).
+  def read_attribute_for_serialization(name)
+    return super unless name.to_s == "profile_image"
+
+    if profile_image.attached?
+      { url: active_storage_profile_image_url }
+    else
+      legacy_profile_image
+    end
+  end
+
+  # Whether this record still has a CarrierWave-stored profile image,
+  # based on the identifier serialized in the `profile_image` column.
+  def legacy_profile_image?
+    legacy_profile_image.identifier.present?
+  end
+
+  # Whether the Active Storage profile image was assigned during the last
+  # save. Use this alongside `saved_change_to_profile_image?` (which only
+  # tracks CarrierWave changes) to detect any profile image change.
+  def profile_image_attachment_changed?
+    @profile_image_attachment_changed.present?
+  end
+
+  private
+
+  def active_storage_profile_image_must_be_valid
+    change = attachment_changes["profile_image"]
+    return unless change.is_a?(ActiveStorage::Attached::Changes::CreateOne)
+
+    blob = change.blob
+
+    if blob.byte_size.to_i < 1
+      min_size = ActiveSupport::NumberHelper.number_to_human_size(1)
+      errors.add(:profile_image, I18n.t(:"errors.messages.min_size_error", min_size: min_size))
+    end
+
+    if blob.byte_size.to_i > ProfileImageUploader::MAX_FILE_SIZE
+      max_size = ActiveSupport::NumberHelper.number_to_human_size(ProfileImageUploader::MAX_FILE_SIZE)
+      errors.add(:profile_image, I18n.t(:"errors.messages.max_size_error", max_size: max_size))
+    end
+
+    extension = blob.filename.extension_without_delimiter.to_s.downcase
+    return if BaseUploader::EXTENSION_ALLOWLIST.any? { |allowed| extension.match?(/\A#{allowed}\z/i) }
+
+    errors.add(
+      :profile_image,
+      I18n.t(
+        :"errors.messages.extension_allowlist_error",
+        extension: extension.inspect,
+        allowed_types: BaseUploader::EXTENSION_ALLOWLIST.join(", "),
+      ),
+    )
+  end
+
+  def build_active_storage_profile_image_change(attachable)
+    ActiveStorage::Attached::Changes::CreateOne.new("profile_image", self, attachable)
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+    # CarrierWave silently ignored values it could not use (e.g. plain
+    # strings); stay lenient so legacy callers keep working.
+    nil
+  end
+
+  def note_profile_image_attachment_change
+    @profile_image_attachment_changed = attachment_changes.key?("profile_image")
+  end
+
+  def active_storage_profile_image_url
+    blob = profile_image.blob
+    # A blob that hasn't been persisted yet (e.g. on an unsaved record) has
+    # no signed id to build a URL from.
+    return if blob.blank? || !blob.persisted?
+
+    # A relative URL, exactly like the local CarrierWave file storage used to
+    # produce ("/uploads/..."). Callers that need an absolute URL (e.g.
+    # emails) already prepend the host themselves.
+    Rails.application.routes.url_helpers.rails_blob_path(blob)
+  end
+
+  def attach_remote_profile_image(url)
+    uri = URI.parse(url)
+    io = uri.open(open_timeout: 5, read_timeout: 10)
+    # An empty response is no image at all; like CarrierWave's failed
+    # downloads, leave the current image untouched.
+    return if io.size.zero?
+
+    self.profile_image = { io: io, filename: remote_profile_image_filename(uri) }
+  rescue StandardError => e
+    Rails.logger.error("#{self.class}##{id} could not download remote profile image #{url.inspect}: #{e.message}")
+  end
+
+  def remote_profile_image_filename(uri)
+    basename = File.basename(uri.path.to_s)
+    basename.presence_in(%w[/ .]) ? "profile_image" : basename
+  end
+end
