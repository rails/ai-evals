diff --git a/tmp_verify/profile_image_migration_spec.rb b/tmp_verify/profile_image_migration_spec.rb
new file mode 100644
index 0000000..e6582ca
--- /dev/null
+++ b/tmp_verify/profile_image_migration_spec.rb
@@ -0,0 +1,178 @@
+require "rails_helper"
+
+RSpec.describe "Profile image CarrierWave -> Active Storage migration", type: :model do
+  let(:image_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+  let(:upload) { Rack::Test::UploadedFile.new(image_path, "image/jpeg") }
+
+  def make_legacy_user
+    user = create(:user)
+    user.profile_image.purge # remove factory-attached Active Storage image
+    user.update_column(:profile_image, "legacy-#{user.id}.png") # rubocop:disable Rails/SkipsModelValidations
+    user.reload
+  end
+
+  def make_legacy_org
+    org = create(:organization)
+    org.profile_image.purge
+    org.update_column(:profile_image, "legacy-#{org.id}.png") # rubocop:disable Rails/SkipsModelValidations
+    org.reload
+  end
+
+  describe "Active Storage setup" do
+    it "is enabled and configured" do
+      expect(Rails.application.config.respond_to?(:active_storage)).to be(true)
+      expect(ActiveStorage::Blob.table_exists?).to be(true)
+      expect(ActiveStorage::Blob.service).to be_present
+    end
+  end
+
+  describe "factory-created records (new uploads)" do
+    it "stores the user's profile image in Active Storage" do
+      user = create(:user)
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image.blob).to be_present
+      expect(user.profile_image.blob.service).to eq(ActiveStorage::Blob.service)
+      expect(user.read_attribute(:profile_image)).to be_nil # not written to the CarrierWave column
+    end
+
+    it "stores the organization's profile image in Active Storage" do
+      org = create(:organization)
+      expect(org.profile_image).to be_attached
+      expect(org.read_attribute(:profile_image)).to be_nil
+    end
+
+    it "returns an Active Storage URL" do
+      user = create(:user)
+      expect(user.profile_image_url).to include("/rails/active_storage/")
+    end
+
+    it "keeps profile_image_90 working" do
+      user = create(:user)
+      expect(user.profile_image_90).to include("/rails/active_storage/")
+    end
+  end
+
+  describe "legacy CarrierWave images" do
+    it "keeps serving the CarrierWave URL for users" do
+      user = make_legacy_user
+      expect(user.profile_image).not_to be_attached
+      expect(user.profile_image_url).to eq("/uploads/user/profile_image/#{user.id}/legacy-#{user.id}.png")
+      expect(user.profile_image_90).to include("/uploads/user/profile_image/")
+    end
+
+    it "keeps serving the CarrierWave URL for organizations" do
+      org = make_legacy_org
+      expect(org.profile_image_url).to eq("/uploads/organization/profile_image/#{org.id}/legacy-#{org.id}.png")
+    end
+
+    it "exposes the legacy uploader" do
+      user = make_legacy_user
+      expect(user.legacy_profile_image?).to be(true)
+      expect(user.legacy_profile_image.url).to include("legacy-#{user.id}.png")
+    end
+
+    it "prefers Active Storage when both exist" do
+      user = make_legacy_user
+      user.profile_image.attach(io: File.open(image_path), filename: "new.png")
+      expect(user.reload.profile_image_url).to include("/rails/active_storage/")
+      expect(user.legacy_profile_image?).to be(true) # untouched
+    end
+
+    it "remains valid when re-saved" do
+      org = make_legacy_org
+      org.name = "A new name"
+      expect(org).to be_valid
+      expect { org.save! }.not_to raise_error
+    end
+  end
+
+  describe "assigning new images" do
+    it "attaches via profile_image= with an uploaded file" do
+      user = make_legacy_user
+      user.update!(profile_image: upload)
+      expect(user.reload.profile_image).to be_attached
+      expect(user.profile_image_url).to include("/rails/active_storage/")
+    end
+
+    it "attaches via profile_image= with a File" do
+      user = make_legacy_user
+      user.update!(profile_image: File.open(image_path))
+      expect(user.reload.profile_image).to be_attached
+    end
+
+    it "treats blank assignment as a no-op" do
+      user = create(:user)
+      expect { user.update!(profile_image: "") }.not_to raise_error
+      expect(user.reload.profile_image).to be_attached
+    end
+
+    it "attaches via remote_profile_image_url= (downloads to Active Storage)" do
+      user = make_legacy_user
+      stub_request(:get, "https://example.com/avatar.png")
+        .to_return(status: 200, body: File.binread(image_path), headers: { "Content-Type" => "image/jpeg" })
+
+      expect do
+        user.remote_profile_image_url = "https://example.com/avatar.png"
+        user.save!
+      end.to change(ActiveStorage::Blob, :count).by(1)
+
+      expect(user.reload.profile_image).to be_attached
+      expect(user.profile_image.blob.filename.to_s).to eq("avatar.png")
+      expect(user.profile_image_url).to include("/rails/active_storage/")
+    end
+
+    it "does not raise when the remote download fails" do
+      user = make_legacy_user
+      stub_request(:get, "https://example.com/missing.png").to_return(status: 404)
+
+      expect do
+        user.remote_profile_image_url = "https://example.com/missing.png"
+        user.save!
+      end.not_to raise_error
+
+      expect(user.reload.profile_image).not_to be_attached
+      expect(user.profile_image_url).to include("legacy-#{user.id}.png") # fallback intact
+    end
+
+    it "accepts a File via remote_profile_image_url= (SafeRemoteProfileImageUrl fallback)" do
+      user = make_legacy_user
+      user.remote_profile_image_url = Images::ProfileImageGenerator.call
+      expect { user.save! }.not_to raise_error
+      expect(user.reload.profile_image).to be_attached
+    end
+  end
+
+  describe "Organization validation" do
+    it "requires a profile image in either store" do
+      org = build(:organization, profile_image: nil)
+      expect(org).not_to be_valid
+      expect(org.errors[:profile_image]).to include("can't be blank")
+    end
+
+    it "is valid with an Active Storage image" do
+      org = build(:organization)
+      expect(org).to be_valid
+    end
+
+    it "is valid with only a legacy image" do
+      org = make_legacy_org
+      expect(org).to be_valid
+    end
+  end
+
+  describe "cache busting" do
+    it "enqueues a profile image cache bust when the Active Storage image changes" do
+      user = create(:user)
+      sidekiq_assert_enqueued_with(job: Users::BustProfileImageCacheWorker, args: [user.id]) do
+        user.update!(profile_image: Rack::Test::UploadedFile.new(image_path, "image/jpeg"))
+      end
+    end
+  end
+
+  describe "registrations controller behavior" do
+    it "treats a user without any image as blank" do
+      user = User.new(name: "x", email: "x@example.com", username: "xyz12345", password: "password123")
+      expect(user.profile_image).to be_blank
+    end
+  end
+end
