diff --git a/app/models/session.rb b/app/models/session.rb
new file mode 100644
index 0000000..be4038a
--- /dev/null
+++ b/app/models/session.rb
@@ -0,0 +1,37 @@
+# A signed in device: identified by a bearer token sent by the client as
+# "Authorization: Bearer TOKEN". Only the digest of the token is stored.
+class Session < ApplicationRecord
+  belongs_to :user
+  belongs_to :account
+
+  attr_reader :raw_token
+
+  before_create :generate_token
+
+  # Creates a new session for +user+; the returned record knows its raw token.
+  def self.issue_for!(user)
+    create!(user: user, account: user.account)
+  end
+
+  def self.authenticate(raw_token)
+    return nil if raw_token.blank?
+
+    find_by(token_digest: digest(raw_token))
+  end
+
+  def self.digest(raw_token)
+    OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, raw_token.to_s)
+  end
+
+  def revoke!
+    destroy!
+  end
+
+  private
+
+  def generate_token
+    raw = SecureRandom.urlsafe_base64(32)
+    @raw_token = raw
+    self.token_digest = self.class.digest(raw)
+  end
+end
