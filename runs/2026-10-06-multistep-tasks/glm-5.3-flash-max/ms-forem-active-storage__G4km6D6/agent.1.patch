diff --git a/app/uploaders/image_uploader.rb b/app/uploaders/image_uploader.rb
new file mode 100644
index 0000000..57fb980
--- /dev/null
+++ b/app/uploaders/image_uploader.rb
@@ -0,0 +1,63 @@
+# frozen_string_literal: true
+
+# Active Storage counterpart of the CarrierWave uploaders.
+#
+# Profile pictures are the first uploads to move from CarrierWave to Active
+# Storage (see `ActiveStorageProfileImage`). The limits declared here are the
+# ones CarrierWave enforces today, taken from the very uploaders that enforce
+# them, so that a picture which is accepted today is still accepted once it is
+# written to Active Storage instead.
+class ImageUploader
+  # `ProfileImageUploader` rejects anything outside of this range.
+  MAX_FILE_SIZE = ProfileImageUploader::MAX_FILE_SIZE
+  # `BaseUploader` only accepts these file extensions.
+  EXTENSION_ALLOWLIST = BaseUploader::EXTENSION_ALLOWLIST
+  # `CarrierWave::BombShelter` refuses bigger pictures, because decoding them
+  # is expensive (and a favourite way to take a Forem down).
+  MAX_PIXEL_DIMENSIONS = [4_096, 4_096].freeze
+
+  class << self
+    # Name of the Active Storage service profile pictures are written to.
+    #
+    # Where a Forem instance keeps its profile pictures is the instance's
+    # decision, not ours: it declares the service it wants in
+    # `config/storage.yml` and we use it. Forem Cloud instances write to the
+    # `amazon` service, every other instance to the `store_name` service.
+    #
+    # When the instance has not declared the service we would pick, we return
+    # nil so that Active Storage falls back to the service configured for the
+    # environment (`config.active_storage.service`), which is what local
+    # development, CI and self-hosted single node installs do.
+    #
+    # @return [Symbol, nil] the service name, or nil to use the default service
+    def store_name
+      service = if ForemInstance.forem_owner_secret? && !dev_to_instance?
+                  :amazon
+                else
+                  :store_name
+                end
+
+      return service if active_storage_service_declared?(service)
+
+      nil
+    end
+
+    private
+
+    # `ApplicationConfig` rather than `Settings::General` on purpose: deciding
+    # where a picture is stored must not depend on a database round trip.
+    def dev_to_instance?
+      ApplicationConfig["APP_DOMAIN"].to_s.include?("dev.to")
+    end
+
+    # @return [Boolean] whether `config/storage.yml` declares the service
+    def active_storage_service_declared?(name)
+      # Active Storage reads `config/storage.yml` the first time one of its
+      # models is loaded, so nudge it before looking at the configurations.
+      ActiveStorage::Blob.services
+
+      configurations = Rails.application.config.active_storage.service_configurations || {}
+      configurations.deep_symbolize_keys.key?(name)
+    end
+  end
+end
