diff --git a/app/services/images/profile_image_downloader.rb b/app/services/images/profile_image_downloader.rb
new file mode 100644
index 0000000..9040727
--- /dev/null
+++ b/app/services/images/profile_image_downloader.rb
@@ -0,0 +1,25 @@
+# frozen_string_literal: true
+
+module Images
+  # Downloads a profile picture that is still a remote URL.
+  #
+  # CarrierWave used to download remote pictures into its own cache and store
+  # them there. Profile pictures go to Active Storage now, so we download them
+  # with the very same downloader, which filters the requests that could be used
+  # to reach the internal network, and hand the file to Active Storage instead.
+  module ProfileImageDownloader
+    class << self
+      # @param url [String] where the picture lives
+      #
+      # @return [File] the downloaded picture
+      #
+      # @raise [CarrierWave::DownloadError] when the picture cannot be fetched,
+      #   which is what CarrierWave raised for the same upload before
+      def call(url)
+        uploader = ProfileImageUploader.new
+        uploader.download!(url)
+        File.open(uploader.file.path)
+      end
+    end
+  end
+end
diff --git a/app/services/images/profile_image_validator.rb b/app/services/images/profile_image_validator.rb
new file mode 100644
index 0000000..d4c261b
--- /dev/null
+++ b/app/services/images/profile_image_validator.rb
@@ -0,0 +1,98 @@
+# frozen_string_literal: true
+
+module Images
+  # Checks a profile picture right before it is written to Active Storage.
+  #
+  # CarrierWave used to run these checks while caching an upload and would
+  # raise `CarrierWave::IntegrityError` (a 500 for whoever was uploading). Now
+  # that the write path goes to Active Storage we run them here instead, so the
+  # same limits apply no matter which backend stores the file and whoever
+  # uploads a picture too big, too wide or of the wrong type gets a validation
+  # error on the form they came from.
+  module ProfileImageValidator
+    class << self
+      # @param uploadable [Object] the value handed to `profile_image=`
+      #
+      # @return [Array<String>] the errors of the upload, empty when it is valid
+      def call(uploadable)
+        return [] if uploadable.blank?
+
+        errors = []
+        errors << too_big_message if too_big?(uploadable)
+        errors << unsupported_type_message unless allowed_extension?(filename(uploadable))
+        errors.concat(pixel_dimension_errors(uploadable))
+        errors
+      end
+
+      private
+
+      def too_big?(uploadable)
+        size(uploadable) > ImageUploader::MAX_FILE_SIZE
+      end
+
+      def too_big_message
+        I18n.t("concerns.active_storage_profile_image.too_big",
+               max: ActiveSupport::NumberHelper.number_to_human_size(ImageUploader::MAX_FILE_SIZE))
+      end
+
+      def allowed_extension?(name)
+        extension = File.extname(name.to_s).delete(".").downcase
+        ImageUploader::EXTENSION_ALLOWLIST.include?(extension)
+      end
+
+      def unsupported_type_message
+        I18n.t("concerns.active_storage_profile_image.unsupported_type",
+               extensions: ImageUploader::EXTENSION_ALLOWLIST.join(", "))
+      end
+
+      # `CarrierWave::BombShelter` used `FastImage` to refuse the pictures that
+      # would be too expensive to decode, so we keep doing exactly that.
+      def pixel_dimension_errors(uploadable)
+        image = FastImage.new(io(uploadable), raise_on_failure: false)
+        return [] if image.nil? # not an image at all, the extension check reports it
+
+        dimensions = image.size
+        max_width, max_height = ImageUploader::MAX_PIXEL_DIMENSIONS
+        return [] if dimensions && dimensions.first <= max_width && dimensions.last <= max_height
+
+        [I18n.t("concerns.active_storage_profile_image.pixel_dimensions",
+                max_width: max_width, max_height: max_height)]
+      end
+
+      def size(uploadable)
+        if uploadable.respond_to?(:size)
+          uploadable.size
+        elsif uploadable.respond_to?(:byte_size)
+          uploadable.byte_size
+        else
+          io(uploadable).size
+        end
+      end
+
+      def filename(uploadable)
+        if uploadable.respond_to?(:original_filename)
+          uploadable.original_filename
+        else
+          File.basename(uploadable.path.to_s)
+        end
+      end
+
+      # `FastImage` needs something it can read from the start, and an uploaded
+      # file that was already read has to be rewound first.
+      def io(uploadable)
+        if uploadable.respond_to?(:tempfile)
+          rewind(uploadable.tempfile)
+        elsif uploadable.respond_to?(:open)
+          rewind(uploadable.open)
+        else
+          rewind(uploadable)
+        end
+      end
+
+      def rewind(io)
+        io&.rewind
+        io
+      end
+    end
+  end
+end
