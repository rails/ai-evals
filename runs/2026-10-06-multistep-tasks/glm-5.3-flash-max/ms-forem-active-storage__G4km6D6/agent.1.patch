diff --git a/spec/models/concerns/active_storage_profile_image_spec.rb b/spec/models/concerns/active_storage_profile_image_spec.rb
new file mode 100644
index 0000000..1570be4
--- /dev/null
+++ b/spec/models/concerns/active_storage_profile_image_spec.rb
@@ -0,0 +1,124 @@
+require "rails_helper"
+
+RSpec.describe ActiveStorageProfileImage do
+  let(:upload) { Rack::Test::UploadedFile.new(image_path, "image/jpeg") }
+  let(:image_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+
+  # Makes the record look like a profile picture that was uploaded before the
+  # migration to Active Storage: it lives in CarrierWave, and Active Storage
+  # knows nothing about it.
+  def make_legacy(record)
+    ActiveStorage::Attachment.where(record: record).delete_all
+    record.update_columns(profile_image: "legacy-#{record.id}.jpeg")
+    record.reload
+  end
+
+  describe User do
+    it "stores a freshly uploaded picture in Active Storage" do
+      user = create(:user, profile_image: upload)
+
+      expect(user.reload.profile_image_in_active_storage?).to be(true)
+      expect(user.profile_image_attachment.blob.byte_size).to be_positive
+    end
+
+    it "does not store the freshly uploaded picture with CarrierWave" do
+      user = create(:user, profile_image: upload)
+
+      expect(user.reload.read_attribute(:profile_image)).to be_nil
+      expect(user.profile_image).not_to be_present
+    end
+
+    it "hands the assignments that are not file uploads to CarrierWave" do
+      user = create(:user, profile_image: nil)
+
+      expect { user.profile_image = nil }.not_to change { user.attachment_changes.size }
+      expect(user.profile_image_in_active_storage?).to be(false)
+    end
+
+    it "serves the picture it stored in Active Storage" do
+      user = create(:user, profile_image: upload)
+
+      expect(user.reload.profile_image_url).to eq(user.active_storage_profile_image_url)
+      expect(user.profile_image_url).to include("/rails/active_storage/blobs/")
+    end
+
+    it "keeps serving the pictures the older deploys wrote with CarrierWave" do
+      user = make_legacy(create(:user, profile_image: nil))
+
+      expect(user.profile_image_in_active_storage?).to be(false)
+      expect(user.profile_image_url).to eq(user.profile_image.url)
+      expect(user.profile_image_90).to eq(user.profile_image.url)
+    end
+
+    it "busts the profile image cache when a picture is stored in Active Storage" do
+      user = create(:user, profile_image: nil)
+
+      sidekiq_assert_enqueued_with(job: Users::BustProfileImageCacheWorker, args: [user.id]) do
+        user.update!(profile_image: upload)
+      end
+    end
+
+    it "stores the picture a remote url was handed over as" do
+      user = create(:user, profile_image: nil)
+      allow(Images::ProfileImageDownloader).to receive(:call).and_return(File.open(image_path))
+
+      expect do
+        user.remote_profile_image_url = "https://example.com/avatar.png"
+      end.to change { user.profile_image_in_active_storage? }.from(false).to(true)
+    end
+
+    it "removes the picture with #purge_active_storage_profile_image" do
+      user = create(:user, profile_image: upload)
+
+      expect { user.purge_active_storage_profile_image }
+        .to change(ActiveStorage::Attachment.where(record: user), :count).by(-1)
+    end
+  end
+
+  describe Organization do
+    it "requires a profile picture, in Active Storage or on the CarrierWave column" do
+      organization = build(:organization, profile_image: nil)
+
+      aggregate_failures do
+        expect(organization).not_to be_valid
+        expect(organization.errors.of_kind?(:profile_image, :blank)).to be(true)
+
+        organization.profile_image = upload
+        expect(organization).to be_valid
+      end
+    end
+
+    it "stores a freshly uploaded picture in Active Storage" do
+      organization = create(:organization, profile_image: upload)
+
+      expect(organization.reload.profile_image_in_active_storage?).to be(true)
+      expect(organization.reload.read_attribute(:profile_image)).to be_nil
+    end
+
+    it "serves the picture it stored in Active Storage" do
+      organization = create(:organization, profile_image: upload)
+
+      expect(organization.reload.profile_image_url).to eq(organization.active_storage_profile_image_url)
+      expect(organization.profile_image_url).to include("/rails/active_storage/blobs/")
+    end
+
+    it "keeps serving the pictures the older deploys wrote with CarrierWave" do
+      organization = make_legacy(create(:organization))
+
+      expect(organization.profile_image_in_active_storage?).to be(false)
+      expect(organization.profile_image_url).to eq(organization.profile_image.url)
+      expect(organization.profile_image_90).to eq(organization.profile_image.url)
+    end
+
+    it "regenerates the social images when a picture is stored in Active Storage" do
+      organization = create(:organization, profile_image: upload)
+      create(:article, organization: organization)
+
+      sidekiq_assert_enqueued_with(job: Images::SocialImageWorker, args: [organization.id, "Organization"]) do
+        organization.update!(profile_image: Rack::Test::UploadedFile.new(
+          Rails.root.join("spec/support/fixtures/images/image2.jpeg"), "image/jpeg"
+        ))
+      end
+    end
+  end
+end
