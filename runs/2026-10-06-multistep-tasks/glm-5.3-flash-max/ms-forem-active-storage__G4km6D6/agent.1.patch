diff --git a/config/environments/production.rb b/config/environments/production.rb
index 1b60a74..64a7157 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -74,6 +74,16 @@
   default_expiration = 24.hours.to_i
   config.cache_store = :redis_cache_store, { url: redis_url, expires_in: default_expiration }
 
+  # Profile pictures written by `Images::ProfileImage` are stored in Active Storage.
+  #
+  # `ImageUploader.store_name` resolves the service a Forem instance declared for
