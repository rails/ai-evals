+  # Rails 6.1, 7.0 and 7.1, 7.0 from Rails 7.2 on, which removed the 6.1 format
+  # and refuses to boot with it. Rails 6.1 reads nothing but the 6.1 format and
+  # Rails 7.0/7.2 read every one of them, so this is what keeps the shared
+  # cache readable in both directions.
+  def redmine_cache_format_version
+    rails_72_or_later? ? 7.0 : 6.1
+  end
