+module ActiveRecord
+  # Rails 7.2 replaced the second positional argument of .serialize with the
+  # keyword arguments :coder (a coder answering to .load and .dump) and :type
+  # (the class the column is expected to hold). The models are written the
+  # same way for every Rails version, so the Rails 6.1/7.0 form is translated
+  # where the new signature is in place.
+  redmine_serialize_takes_coder =
+    ActiveRecord::Base.method(:serialize).parameters.any? do |type, name|
+      name == :coder && [:key, :keyreq].include?(type)
+    end
+
+  if redmine_serialize_takes_coder
+    class Base
+      class << self
+        def serialize_with_positional_coder(attr_name, class_name_or_coder = nil, **options)
+          if class_name_or_coder.nil?
+            serialize_without_positional_coder(attr_name, **options)
+          elsif class_name_or_coder.respond_to?(:load) && class_name_or_coder.respond_to?(:dump)
+            serialize_without_positional_coder(attr_name, :coder => class_name_or_coder, **options)
+          else
+            serialize_without_positional_coder(attr_name, :type => class_name_or_coder, **options)
+          end
+        end
+        alias_method :serialize_without_positional_coder, :serialize
+        alias_method :serialize, :serialize_with_positional_coder
+      end
+    end
+  end
+end
