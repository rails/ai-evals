   end
 
+  test 'the framework defaults that invalidate persisted state stay pinned' do
+    config = Rails.application.config
+    PINNED_DEFAULTS.each do |setting, expected|
+      key = setting.split('.').last.to_sym
+      namespace = config.public_send(setting.split('.').first)
+      assert_equal expected, namespace[key],
+        "#{setting} is not pinned anymore, a release that adopts the framework defaults " \
+        'would invalidate sessions, mail links or cache entries, see docs/UPGRADE.md'
+    end
