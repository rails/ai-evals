-          details[:formats] = details[:formats].dup + [:api]
+    def find_all_with_api_templates(name, prefix=nil, partial=false, details={}, key=nil, locals=[])
+      if details[:formats] && (details[:formats] & API_FALLBACK_FORMATS).any?
+        details = details.merge(:formats => details[:formats] + [:api])
+
