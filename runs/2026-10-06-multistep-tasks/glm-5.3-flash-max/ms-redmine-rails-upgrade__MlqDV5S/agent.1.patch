diff --git a/Gemfile.next b/Gemfile.next
new file mode 100644
index 0000000..5ffc786
--- /dev/null
+++ b/Gemfile.next
@@ -0,0 +1,22 @@
+source 'https://rubygems.org'
+
+ruby '>= 3.1.0', '< 3.4.0'
+
+# The Rails version the next release will run on.
+#
+# Use this Gemfile to run Redmine on the next Rails release without touching
+# production:
+#
+#   BUNDLE_GEMFILE=Gemfile.next bundle install
+#   BUNDLE_GEMFILE=Gemfile.next bin/rails s
+#   BUNDLE_GEMFILE=Gemfile.next bin/rails test
+#
+# It resolves to its own lockfile (Gemfile.next.lock). When this file becomes
+# the production Gemfile, the framework defaults documented in docs/UPGRADE.md
+# must be reviewed: the release after the switch is the rollback target and
+# must be able to read everything written by this one.
+REDMINE_RAILS_VERSION = '7.0.8'
+
+gem 'rails', REDMINE_RAILS_VERSION
+
+eval_gemfile File.expand_path('Gemfile.deps', File.dirname(File.expand_path(__FILE__)))
