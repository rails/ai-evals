+# frozen_string_literal: true
+
+require 'redmine/rollback_keys'
+
+# Rotations of the cookie keys.
+#
+# The release that follows this one runs Rails 7.0 (see Gemfile.next) on its
+# framework defaults, which derive the cookie keys with SHA256 where this
+# release - and every release before it - uses SHA1. A cookie that was written
+# with the other derivation cannot be read, and that would sign everybody out
+# on an upgrade and again on a rollback.
+#
+# This release keeps writing SHA1 keyed cookies and additionally accepts the
+# ones that were written with SHA256 keys. Delete this file together with the
+# Rails 6.1 values pinned in config/application.rb, once the rollback window is
+# closed and the cookie migration of docs/UPGRADE.md has been carried out.
+
+sha256 = OpenSSL::Digest::SHA256
+
+# Cookies written through `cookies.signed`.
+Rails.application.config.action_dispatch.cookies_rotations.rotate(
+  :signed,
+  Redmine::RollbackKeys.key('signed cookie', sha256)
+)
+
+# The `_redmine_session` cookie. Encrypted with AES-256-CBC and signed, which is
+# what config.action_dispatch.use_authenticated_cookie_encryption = false gives
+# us (see config/application.rb).
+Rails.application.config.action_dispatch.cookies_rotations.rotate(
+  :encrypted,
+  Redmine::RollbackKeys.key('encrypted cookie', sha256, ActiveSupport::MessageEncryptor.key_len('aes-256-cbc')),
+  Redmine::RollbackKeys.key('signed encrypted cookie', sha256),
+  :cipher => 'aes-256-cbc',
+  :digest => 'SHA1'
+)
+
+# Same cookie, but as the Rails 7.0 defaults write it (authenticated encryption
+# with AES-256-GCM and a key derived from the authenticated cookie salt), in
+# case the next release loads the defaults without the overrides of
+# config/application.rb.
+Rails.application.config.action_dispatch.cookies_rotations.rotate(
+  :encrypted,
+  Redmine::RollbackKeys.key('authenticated encrypted cookie', sha256, ActiveSupport::MessageEncryptor.key_len('aes-256-gcm')),
+  :cipher => 'aes-256-gcm'
+)
