+  def test_unwatch_with_a_token_generated_by_the_rails_verifier_is_accepted
+    # Tokens have to keep verifying when they were generated with the plain
+    # Rails verifier (the way every release before the key rotation did).
+    token = Rails.application.message_verifier(:mail_links).
+              generate({'user_id' => 3, 'issue_id' => 2}, :purpose => :unwatch, :expires_in => 30.days)
+
+    get :unwatch, :params => {:token => token}
+
+    assert_response :success
+    assert_not Issue.find(2).watched_by?(User.find(3))
+  end
+
+  def test_unwatch_with_a_token_signed_with_a_sha256_derived_key_is_accepted
+    # The Rails 7.0 framework defaults derive the keys of the message verifiers
+    # with SHA256 instead of SHA1. Tokens issued while such defaults were in
+    # effect have to keep verifying here, otherwise the links of the mails that
+    # this release has already sent would break after a rollback.
+    token = ActiveSupport::MessageVerifier.new(Mailer.mail_link_key(OpenSSL::Digest::SHA256)).
+              generate({'user_id' => 3, 'issue_id' => 2}, :purpose => :unwatch, :expires_in => 30.days)
+
+    get :unwatch, :params => {:token => token}
+
+    assert_response :success
+    assert_not Issue.find(2).watched_by?(User.find(3))
+  end
+
+  def test_mail_link_token_is_verifiable_with_the_plain_rails_verifier
+    # Conversely, a token of this release must be verifiable by the verifier
+    # that the rollback target (and any release that keeps the Rails 6.1 key
+    # derivation) builds.
+    token = Mailer.mail_link_token(:unwatch, 'user_id' => 3, 'issue_id' => 2)
+
+    assert_equal(
+      {'user_id' => 3, 'issue_id' => 2},
+      Rails.application.message_verifier(:mail_links).verified(token, :purpose => :unwatch)
+    )
