diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..dbcda91
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,77 @@
+# The bot API. A bot's code in the path is the credentials and the raw request body is
+# the message body: no envelope, no field names, no browser.
+#
+#   curl -d "Deploy of v1.2.3 finished" \
+#     https://chat.example.com/rooms/<room-id>/<bot-code>/messages
+#
+class Bots::MessagesController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  allow_unauthenticated_access only: :create
+  skip_before_action :verify_authenticity_token, only: :create
+  skip_before_action :reject_unsupported_browser
+
+  rescue_from ActiveRecord::RecordNotFound, with: :render_room_not_found
+
+  before_action :authenticate_bot
+  before_action :set_room
+
+  def create
+    return head :unprocessable_content if message_body.blank? && message_attachment.blank?
+
+    @message = @room.messages.create_with_attachment!(creator: @bot, body: message_body, attachment: message_attachment)
+    @message.broadcast_create
+
+    response.set_header "Location", message_path(@message)
+    head :created
+  end
+
+  private
+    def authenticate_bot
+      @bot = Bot.find_by(bot_code: bot_code)
+
+      if @bot.nil?
+        head :unauthorized
+      else
+        Current.user = @bot
+      end
+    end
+
+    # Room id and bot code are read straight from the path parameters, so that a request
+    # body that happens to look like a form or JSON payload is never parsed.
+    def set_room
+      @room = Room.find(room_id)
+    end
+
+    def render_room_not_found
+      head :not_found
+    end
+
+    def bot_code
+      request.path_parameters[:bot_code]
+    end
+
+    def room_id
+      request.path_parameters[:room_id]
+    end
+
+    def message_body
+      @message_body ||= if multipart?
+        params[:body].presence
+      else
+        request.raw_post
+      end
+    end
+
+    # An uploaded file is accepted under any field name, since bots aren't told what to
+    # call it. Everything else in the request is ignored.
+    def message_attachment
+      @message_attachment ||= if multipart?
+        params.values.find { |value| value.is_a?(ActionDispatch::Http::UploadedFile) }
+      end
+    end
+
+    def multipart?
+      request.content_type.to_s.start_with?("multipart/")
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..d554343
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,56 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+  before_action :ensure_can_manage_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = find_bots
+  end
+
+  def new
+    @bot = Bot.new(creator: Current.user)
+  end
+
+  def create
+    @bot = Bot.new(bot_params.merge(creator: Current.user))
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.destroy
+    redirect_to bots_url
+  end
+
+  private
+    # Administrators manage everybody's bots, everyone else just their own.
+    def find_bots
+      Current.user.can_administer? ? Bot.ordered : Bot.created_by(Current.user).ordered
+    end
+
+    def set_bot
+      @bot = Bot.find(params[:id])
+    end
+
+    def ensure_can_manage_bot
+      head :forbidden unless Current.user.can_administer?(@bot)
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
