diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
new file mode 100644
index 0000000..2359e5b
--- /dev/null
+++ b/test/models/bot_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class BotTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:deploy_bot)
+  end
+
+  test "is a user, so that it can be a room member and a message creator" do
+    assert_kind_of User, @bot
+    assert @bot.bot?
+    refute users(:jz).bot?
+  end
+
+  test "a new bot joins all open rooms" do
+    bot = create_bot
+
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+
+  test "a bot can be added to rooms like anyone else" do
+    room = rooms(:designers)
+
+    assert_difference -> { room.users.count }, 1 do
+      room.memberships.grant_to @bot
+    end
+  end
+
+  test "a bot is given a bot code to authenticate its requests with" do
+    assert create_bot.bot_code.present?
+  end
+
+  test "bot codes are unique" do
+    assert_raises ActiveRecord::RecordInvalid do
+      create_bot bot_code: @bot.bot_code
+    end
+  end
+
+  test "a bot needs a name" do
+    assert_raises ActiveRecord::RecordInvalid do
+      create_bot name: "  "
+    end
+  end
+
+  test "a bot can't be created without a creator" do
+    bot = Bot.new(name: "Orphan Bot")
+
+    assert bot.valid?
+  end
+
+  test "destroying a bot removes it from its rooms and deletes its messages" do
+    room = rooms(:pets)
+    room.memberships.grant_to @bot
+    message = room.messages.create!(creator: @bot, body: "Deployed")
+
+    @bot.destroy
+
+    refute Bot.exists? @bot.id
+    refute room.reload.users.include? @bot
+    refute Message.exists? message.id
+  end
+
+  private
+    def create_bot(**attributes)
+      Bot.create!({ name: "Fresh Bot", creator: users(:jz) }.merge(attributes))
+    end
+end
