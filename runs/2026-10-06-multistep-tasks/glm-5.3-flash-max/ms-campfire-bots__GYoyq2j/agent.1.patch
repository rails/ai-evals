diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..e972379
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,30 @@
+# Bots are members of rooms that post messages through the bot API rather than the
+# browser. They inherit from User so that they can be mentioned, avatared, added to
+# rooms and made the creator of messages exactly like a person can.
+class Bot < User
+  BOT_CODE_BYTES = 16
+
+  belongs_to :creator, class_name: "User", optional: true
+
+  validates :name, presence: true
+  validates :bot_code, presence: true, uniqueness: true
+
+  before_validation :assign_bot_code
+  before_validation :assign_unusable_password
+
+  scope :created_by, ->(user) { where(creator: user) }
+
+  def bot?
+    true
+  end
+
+  private
+    def assign_bot_code
+      self.bot_code ||= SecureRandom.hex(BOT_CODE_BYTES)
+    end
+
+    # Bots never sign in, but the users table requires a digest.
+    def assign_unusable_password
+      self.password_digest ||= BCrypt::Password.create(SecureRandom.hex(32))
+    end
+end
