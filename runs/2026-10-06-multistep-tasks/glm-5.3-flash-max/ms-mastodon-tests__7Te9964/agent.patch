--- /dev/null
+++ b/spec/support/test_prof.rb
@@ -0,0 +1,9 @@
+# frozen_string_literal: true
+
+# `before_all` runs a block of setup code once per example group instead of
+# once per example, inside a transaction that is rolled back when the group is
+# finished, so examples still see a clean database.
+#
+# Use it for shared, read-only setup (`before do ... Fabricate ... end`) in
+# example groups that have many examples (see docs/performance/README.md).
+require 'test_prof/recipes/rspec/before_all'
