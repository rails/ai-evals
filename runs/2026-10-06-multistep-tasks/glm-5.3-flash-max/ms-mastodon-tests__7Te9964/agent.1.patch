+  # Queue (instead of execute) Sidekiq jobs for the spec types that were
+  # audited to not depend on their side effects. Extend as more spec types are
+  # audited/optimized.
+  config.define_derived_metadata(file_path: %r{/spec/(models|requests)/}) do |metadata|
+    metadata[:sidekiq_fake] = true
   end
 
+  # Some specs switch the (global) Sidekiq test mode themselves, so the default
+  # is re-asserted before every example.
   config.before do
     Sidekiq.testing!(:inline)
   end
 
+  # `Sidekiq::Testing` modes can be scoped to a block, which keeps them from
+  # leaking into other examples running on the same thread.
+  config.around do |example|
+    if example.metadata[:sidekiq_inline]
+      Sidekiq::Testing.inline! { example.run }
+    elsif example.metadata[:sidekiq_fake]
+      Sidekiq::Testing.fake! { example.run }
+    else
+      example.run
+    end
+  end
+
+  config.around(:each, use_transactional_tests: false) do |example|
