+<p><%= @invited_by ? "#{@invited_by.name} invited you" : "You were invited" %> to join
+<strong><%= @account.name %></strong> as <%= @role %>.</p>
+<p><%= link_to "Accept the invitation", @link %></p>
+<p class="mono"><%= @link %></p>
+<p>If the link does not open in your mail client, use this one instead:<br>
+<%= link_to @short_link, @short_link %></p>
+<p>This link is valid for <%= Invitation::TTL.inspect %> and can only be used once. If you were not
+invited to <%= @account.name %>, you can ignore this email.</p>
