diff --git a/db/migrate/20240101000003_create_invitations.rb b/db/migrate/20240101000003_create_invitations.rb
new file mode 100644
index 0000000..96dc0df
--- /dev/null
+++ b/db/migrate/20240101000003_create_invitations.rb
@@ -0,0 +1,26 @@
+# frozen_string_literal: true
+
+# Staff invitations: a business invites a person by email. The invitation
+# carries the single use token that is handed to the frontend inside a link and
+# turns the address into a staff member of the business once it is accepted.
+class CreateInvitations < ActiveRecord::Migration[8.1]
+  def change
+    create_table :invitations do |t|
+      t.references :account, null: false, foreign_key: true
+      t.references :invited_by, foreign_key: { to_table: :users }
+      t.string :email, null: false
+      t.string :role, null: false, default: "agent"
+      t.string :token, null: false
+      t.datetime :accepted_at
+      t.datetime :revoked_at
+      t.datetime :expires_at
+      t.timestamps
+    end
+    # The token is the only thing the invited person needs to answer.
+    add_index :invitations, :token, unique: true
+    # An address may only be invited once at a time.
+    add_index :invitations, [:account_id, :email]
+    # Invitations expire, so they are looked up by business and age.
+    add_index :invitations, [:account_id, :created_at]
+  end
+end
