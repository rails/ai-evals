diff --git a/config/initializers/helpdesk.rb b/config/initializers/helpdesk.rb
new file mode 100644
index 0000000..1cc6c26
--- /dev/null
+++ b/config/initializers/helpdesk.rb
@@ -0,0 +1,44 @@
+# Be sure to restart your server when you modify this file.
+#
+# Outgoing mail configuration. Everything is environment driven so the backend
+# can be dropped next to an existing mail infrastructure.
+# The environment may have configured its own delivery method (the test
+# environment collects mail instead of sending it).
+delivery_method = Rails.application.config.action_mailer.delivery_method ||
+                  Helpdesk::Config.mail_delivery_method
+env = ->(*names) { names.map { |name| ENV[name] }.find(&:present?) }
+
+Rails.application.configure do
+  config.action_mailer.delivery_method = delivery_method
+
+  # A missing SMTP server should never break a request that only wanted to send
+  # a verification link.
+  config.action_mailer.raise_delivery_errors =
+    ENV.fetch("HELPDESK_MAIL_RAISE_DELIVERY_ERRORS", "false") == "true"
+
+  # Verification links are handed to the frontend, so the mailer never needs to
+  # generate URLs on this host.
+  frontend = URI.parse(Helpdesk::Config.frontend_url)
+  config.action_mailer.default_url_options = { host: frontend.host || "localhost" }
+end
+
+case delivery_method
+when :smtp
+  username = env.call("HELPDESK_SMTP_USERNAME", "SMTP_USERNAME", "SMTP_USER", "SMTP_LOGIN")
+  ActionMailer::Base.smtp_settings = {
+    address: env.call("HELPDESK_SMTP_ADDRESS", "SMTP_ADDRESS", "SMTP_HOST", "SMTP_SERVER") || "localhost",
+    port: (env.call("HELPDESK_SMTP_PORT", "SMTP_PORT") || "25").to_i,
+    domain: env.call("HELPDESK_SMTP_DOMAIN", "SMTP_DOMAIN"),
+    user_name: username,
+    password: env.call("HELPDESK_SMTP_PASSWORD", "SMTP_PASSWORD"),
+    authentication: env.call("HELPDESK_SMTP_AUTHENTICATION", "SMTP_AUTHENTICATION", "SMTP_AUTH") ||
+                    (username ? :plain : nil),
+    enable_starttls_auto: env.call("HELPDESK_SMTP_STARTTLS_AUTO") != "false",
+    open_timeout: 5,
+    read_timeout: 10
+  }.compact
+when :file
+  ActionMailer::Base.file_settings = { location: Rails.root.join("tmp/mails").to_s }
+when :sendmail
+  ActionMailer::Base.sendmail_settings = { location: "/usr/sbin/sendmail", arguments: "-i" }
+end
