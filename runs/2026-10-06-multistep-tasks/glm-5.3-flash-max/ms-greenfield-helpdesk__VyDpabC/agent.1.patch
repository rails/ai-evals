--- /dev/null
+++ b/test/support/mailer_helpers.rb
@@ -0,0 +1,20 @@
+# frozen_string_literal: true
+
+module MailerHelpers
+  # The token that was sent to the frontend inside a verification link.
+  def verification_token_for(account_subdomain)
+    links_for(account_subdomain, "verify-email").last
+  end
+
+  def reset_token_for(account_subdomain)
+    links_for(account_subdomain, "reset-password").last
+  end
+
+  def links_for(account_subdomain, path)
+    ActionMailer::Base.deliveries.filter_map do |mail|
+      mail.parts.filter_map do |part|
+        part.body.to_s.gsub("&amp;", "&").scan(%r{#{Regexp.escape(path)}\?account=#{account_subdomain}&token=([\w\-]+)})
+      end.flatten
+    end.flatten
+  end
+end
