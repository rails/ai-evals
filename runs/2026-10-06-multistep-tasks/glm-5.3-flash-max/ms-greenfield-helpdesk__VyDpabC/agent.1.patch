@@ -0,0 +1,25 @@
+require "uri"
+
+ENV["RAILS_ENV"] ||= "test"
+
+# Keep the test suite on its own database, even when DATABASE_URL points at a
+# development or staging database: only the database name is replaced.
+if ENV["DATABASE_URL"]
+  test_database = URI.parse(ENV["DATABASE_URL"])
+  test_database.path = "/helpdesk_test"
+  ENV["DATABASE_URL"] = test_database.to_s
+end
+
+require_relative "../config/environment"
+require "rails/test_help"
+
+module ActiveSupport
+  class TestCase
+    # Run tests sequentially: the test database stays predictable and easy to
+    # reason about.
+    parallelize(workers: 1)
+
+    # No fixtures: every test creates the records it needs.
+    self.use_transactional_tests = true
+  end
+end
