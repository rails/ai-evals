@@ -0,0 +1,156 @@
+require "rails_helper"
+
+RSpec.describe ProfileImageStorage do
+  %i[user organization].each do |factory_name|
+    describe factory_name.to_s do
+      let(:record) { create(factory_name) }
+      let(:new_picture) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+
+      # The records whose picture was uploaded before the migration keep it in
+      # CarrierWave, so the migration has to keep serving them from there.
+      let(:legacy_record) do
+        record.tap do |record|
+          record.profile_image_attachment.purge
+          record.update_column(:profile_image, "legacy.png") # rubocop:disable Rails/SkipsModelValidations
+        end.reload
+      end
+
+      # The records without any picture.
+      let(:record_without_picture) do
+        record.tap do |record|
+          record.profile_image_attachment.purge
+          record.update_column(:profile_image, nil) # rubocop:disable Rails/SkipsModelValidations
+        end.reload
+      end
+
+      describe "#profile_image=" do
+        it "stores a new picture in Active Storage" do
+          record.profile_image = new_picture
+          record.save!
+
+          expect(record.reload.profile_image_attachment).to be_attached
+          expect(record.profile_image_attachment.blob.filename.to_s).to eq("800x600.jpg")
+        end
+
+        it "does not store the picture with CarrierWave" do
+          expect { record.profile_image = new_picture }.not_to change { record.reload.profile_image }
+        end
+
+        it "replaces the picture that was uploaded before the migration" do
+          expect(legacy_record.profile_image_in_active_storage?).to be(false)
+
+          legacy_record.profile_image = new_picture
+          legacy_record.save!
+
+          expect(legacy_record.reload.profile_image_in_active_storage?).to be(true)
+        end
+
+        it "ignores a blank picture" do
+          record_without_picture.profile_image = nil
+          record_without_picture.save!(validate: false)
+
+          expect(record_without_picture.reload.profile_image_attachment).not_to be_attached
+        end
+
+        it "ignores a string, like CarrierWave does for cached uploads" do
+          record_without_picture.profile_image = "800x600.jpg"
+          record_without_picture.save!(validate: false)
+
+          expect(record_without_picture.reload.profile_image_attachment).not_to be_attached
+        end
+
+        it "rejects a file of an unsupported type" do
+          record_without_picture.profile_image = fixture_file_upload("800x600.pdf", "application/pdf")
+
+          expect(record_without_picture).not_to be_valid
+          expect(record_without_picture.errors[:profile_image]).to be_present
+          expect(record_without_picture.profile_image_attachment).not_to be_attached
+        end
+      end
+
+      describe "#profile_image_url" do
+        it "serves a new picture from Active Storage" do
+          record.profile_image = new_picture
+          record.save!
+
+          expect(record.reload.profile_image_url).to include("active_storage")
+          expect(record.profile_image_url).to include(record.profile_image_attachment.blob.filename.to_s)
+        end
+
+        it "serves a picture that was uploaded before the migration from CarrierWave" do
+          expect(legacy_record.profile_image_url).to eq(legacy_record.profile_image.url)
+          expect(legacy_record.profile_image_url).not_to include("active_storage")
+        end
+
+        it "keeps working through the optimized picture helpers" do
+          record.profile_image = new_picture
+          record.save!
+
+          expect(record.reload.profile_image_90).to eq(record.profile_image_url)
+          expect(record.profile_image_url_for(length: 320)).to eq(record.profile_image_url)
+        end
+      end
+
+      describe "#profile_image" do
+        it "is the attachment of a picture stored in Active Storage" do
+          record.profile_image = new_picture
+          record.save!
+
+          expect(record.reload.profile_image).to be_attached
+        end
+
+        it "is the CarrierWave uploader of a picture uploaded before the migration" do
+          expect(legacy_record.profile_image).to be_a(CarrierWave::Uploader::Base)
+        end
+      end
+
+      describe "#profile_image_changed?" do
+        it "is true when a picture is stored in Active Storage" do
+          record.profile_image = new_picture
+          record.save!
+
+          expect(record.profile_image_changed?).to be(true)
+        end
+
+        it "is true when a picture replaces the one stored in CarrierWave" do
+          expect(legacy_record.profile_image_changed?).to be(false)
+
+          legacy_record.profile_image = new_picture
+          legacy_record.save!
+
+          expect(legacy_record.profile_image_changed?).to be(true)
+        end
+
+        it "is false when the picture did not change" do
+          record.update!(name: "New name") if record.is_a?(User)
+          record.update!(summary: "New summary") if record.is_a?(Organization)
+
+          expect(record.profile_image_changed?).to be(false)
+        end
+      end
+
+      describe "#remote_profile_image_url=" do
+        let(:remote_url) { "https://dummyimage.com/400x400.jpg" }
+
+        it "remembers the URL the picture was downloaded from" do
+          record_without_picture.remote_profile_image_url = remote_url
+
+          expect(record_without_picture.remote_profile_image_url).to eq(remote_url)
+        end
+
+        it "stores a picture that could not be read as a validation error" do
+          # rubocop:disable RSpec/AnyInstance
+          allow_any_instance_of(ProfileImageUploader).to receive(:download!)
+            .and_raise(CarrierWave::DownloadError, "could not download file")
+          # rubocop:enable RSpec/AnyInstance
+
+          record_without_picture.remote_profile_image_url = remote_url
+
+          expect(record_without_picture).not_to be_valid
+          expect(record_without_picture.errors[:profile_image]).to be_present
+          expect(record_without_picture.profile_image_attachment).not_to be_attached
+        end
+      end
+    end
+  end
+end
