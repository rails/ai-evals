diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..93fd5ed
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,23 @@
+# A bot is a member of the account that posts messages through the HTTP API instead of
+# a browser. It's a user, so it can be a member of rooms, author messages, and have an
+# avatar, but it can't sign in: it authenticates with its bot code.
+class Bot < User
+  BOT_CODE_LENGTH = 24
+
+  belongs_to :creator, class_name: "User", optional: true
+
+  before_validation do
+    # Bots have no credentials to speak of, they just can't be signed into.
+    self.password_digest ||= SecureRandom.base58(32)
+    self.bot_code ||= SecureRandom.base58(BOT_CODE_LENGTH)
+  end
+
+  validates :name, presence: true
+  validates :bot_code, presence: true, uniqueness: true
+
+  scope :created_by, ->(user) { where(creator: user) }
+
+  def human?
+    false
+  end
+end
