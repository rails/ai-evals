@@ -24,10 +24,21 @@ class User < ApplicationRecord
   scope :ordered, -> { order("LOWER(name)") }
   scope :filtered_by, ->(query) { where("name like ?", "%#{query}%") }
 
+  # Bots are users too, but they are managed on their own page and don't belong in lists of people.
+  scope :humans, -> { where(type: nil) }
+
   def initials
     name.scan(/\b\w/).join
   end
 
+  def bot?
+    is_a?(Bot)
+  end
+
+  def human?
+    !bot?
+  end
+
   def title
     [ name, bio ].compact_blank.join(" – ")
   end
