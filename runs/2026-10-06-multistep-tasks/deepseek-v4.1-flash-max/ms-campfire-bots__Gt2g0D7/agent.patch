@@ -0,0 +1,10 @@
+# Delivers a bot webhook callback for either a mention or a joined-room event.
+class Bot::WebhookJob < ApplicationJob
+  def perform(*args, **attributes)
+    if attributes.any?
+      Bot::Webhook.new(**attributes.symbolize_keys).deliver
+    else
+      Bot::Webhook.new(*args).deliver
+    end
+  end
+end
