+class Bot::MentionJob < ApplicationJob
+  # Accepts (bot, message); also tolerates (message, bot) so callers can pass
+  # the records in whichever natural order they have them.
+  def perform(bot, message)
+    bot, message = message, bot if bot.is_a?(Message)
+
+    Bot::Mention.new(bot:, message:).deliver
+  end
+end
