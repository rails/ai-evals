diff --git a/config/application.rb b/config/application.rb
index 5e93df1..3296f96 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -23,6 +23,35 @@ module RedmineApp
     # Application configuration should go into files in config/initializers
     # -- all .rb files in that directory are automatically loaded.
 
+    # This release is explicitly pinned to the Rails 6.1 framework defaults.
+    # The next release will switch to config.load_defaults 7.0; keeping the
+    # current defaults explicit makes the behavior of this release stable when
+    # it is used as the rollback target. See docs/UPGRADE.md.
+    config.load_defaults 6.1
+
+    # Redmine's models do not mark all belongs_to associations as optional and
+    # rely on the historical default of optional associations. Keep that
+    # behavior on both Rails 6.1 and 7.0. TODO: make associations explicit and
+    # remove this override when moving to the Rails 7.0 defaults.
+    config.active_record.belongs_to_required_by_default = false
+
+    # Temporary rollback-compatibility overrides.
+    #
+    # Ops can roll any release back to the previous one. Rails 7.0 framework
+    # defaults change the key generator digest (which would invalidate sessions
+    # and mail-link tokens) and switch the cookie serializer from Marshal to
+    # JSON. Redmine stores nested symbol-keyed hashes in the session, which are
+    # not preserved by the JSON serializer yet, so keep using Marshal for now.
+    # This keeps sessions and mail-link tokens readable in both directions
+    # while releases can be rolled back and forth.
+    #
+    # TODO: remove these overrides and use :json once the Rails 7.0 release can
+    # no longer be rolled back and Redmine's session data is JSON-safe.
+    config.active_support.key_generator_hash_digest_class = OpenSSL::Digest::SHA1
+    config.active_support.hash_digest_class = OpenSSL::Digest::SHA1
+    config.action_dispatch.cookies_serializer = :marshal
+    config.active_support.cache_format_version = 6.1
+
     # Custom directories with classes and modules you want to be autoloadable.
     config.autoloader = :zeitwerk
 
