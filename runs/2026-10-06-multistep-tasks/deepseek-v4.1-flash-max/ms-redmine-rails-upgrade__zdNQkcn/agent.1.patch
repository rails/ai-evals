+# frozen_string_literal: true
+#
+# Gemfile for the next release, which will run Rails 7.0.
+#
+# Install/run it with:
+#
+#   BUNDLE_GEMFILE=Gemfile.next bundle install
+#   BUNDLE_GEMFILE=Gemfile.next bin/rails test
+#
+# Production keeps using Gemfile and Gemfile.lock on Rails 6.1 until the
+# next release is deployed. Gemfile.next.lock is used for the next release.
+ENV['RAILS_GEM_VERSION'] = '~> 7.0.0'
+
+eval_gemfile File.expand_path('Gemfile', __dir__)
