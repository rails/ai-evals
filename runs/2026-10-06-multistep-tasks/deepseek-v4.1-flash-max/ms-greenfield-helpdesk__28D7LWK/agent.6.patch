@@ -123,6 +136,56 @@ class Request < ApplicationRecord
 
   private
 
+  def assigning_attribute?(attribute)
+    new_record? || will_save_change_to_attribute?(attribute)
+  end
+
+  # Assigning an ungrouped ticket pulls in the staff member's default group
+  # when they have one.
+  def use_default_group_for_assignee
+    return if group_id.present?
+    return unless assigning_attribute?(:assignee_id)
+    return if assignee_id.blank?
+
+    default_group = assignee&.default_group
+    self.group = default_group if default_group
+  end
+
+  # Explicitly clearing the group clears its assignee as well.
+  def clear_assignee_when_group_is_cleared
+    return unless assigning_attribute?(:group_id)
+    return if group_id.present?
+    return if assignee_id.blank?
+    return if assigning_attribute?(:assignee_id)
+
+    self.assignee = nil
+  end
+
+  # Moving a ticket to another group drops an assignee who does not belong to
+  # the destination group.
+  def clear_assignee_when_moved_to_nonmember_group
+    return unless assigning_attribute?(:group_id)
+    return if group_id.blank? || assignee_id.blank?
+    return if assigning_attribute?(:assignee_id)
+    return if GroupMembership.exists?(group_id: group_id, user_id: assignee_id)
+
+    self.assignee = nil
+  end
+
+  def assignee_belongs_to_group
+    return if assignee_id.blank? || group_id.blank?
+    return if GroupMembership.exists?(group_id: group_id, user_id: assignee_id)
+
+    errors.add(:assignee, "must belong to the ticket's group")
+  end
+
+  def group_belongs_to_account
+    return if group.nil? || account.nil?
+    return if group.account_id == account_id
+
+    errors.add(:group, "must belong to the ticket's account")
+  end
+
   def ensure_reply_token
     self.reply_token ||= generate_reply_token!
   end
