index 0000000..8ac900a
--- /dev/null
+++ b/app/models/group.rb
@@ -0,0 +1,50 @@
+class Group < ApplicationRecord
+  belongs_to :account
+  has_many :group_memberships, dependent: :destroy, inverse_of: :group
+  has_many :users, through: :group_memberships
+  has_many :requests, dependent: :nullify, inverse_of: :group
+
+  before_validation :normalize_name
+  before_destroy :clear_request_assignments, prepend: true
+
+  validates :name, presence: true, length: { maximum: 255 },
+                   uniqueness: { scope: :account_id, case_sensitive: false }
+
+  scope :oldest_first, -> { order(id: :asc) }
+
+  # Staff-facing aliases for the group's tickets and memberships.
+  def tickets
+    requests
+  end
+
+  alias_method :memberships, :group_memberships
+
+  def as_api_json
+    {
+      id: id,
+      account_id: account_id,
+      name: name,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  # Compact representation embedded in ticket responses.
+  def as_ticket_json
+    { id: id, name: name }
+  end
+
+  private
+
+  def normalize_name
+    self.name = name.to_s.strip
+  end
+
+  # A group is the staff-facing organizing unit for tickets. Deleting it makes
+  # its tickets ungrouped, and any assignee tied to that group is no longer
+  # valid.
+  def clear_request_assignments
+    Request.where(account_id: account_id, group_id: id)
+           .update_all(group_id: nil, assignee_id: nil)
+  end
+end
diff --git a/app/models/group_membership.rb b/app/models/group_membership.rb
