index 9763b74..b46a9e7 100644
--- a/app/controllers/api/v1/base_controller.rb
+++ b/app/controllers/api/v1/base_controller.rb
@@ -52,6 +52,38 @@ module Api
         render_error("Forbidden", :forbidden)
       end
 
+      def ensure_staff!
+        return true if current_user&.staff?
+
+        render_error("Forbidden", :forbidden)
+      end
+
+      def ensure_customer!
+        return true if current_user&.customer?
+
+        render_error("Forbidden", :forbidden)
+      end
+
+      def paginate(scope)
+        page = [ params[:page].to_s.to_i, 1 ].max
+        per_page = params[:per_page].to_s.to_i
+        per_page = 25 unless per_page.positive?
+
+        total = scope.count
+        records = scope.offset((page - 1) * per_page).limit(per_page).to_a
+        total_pages = (total.to_f / per_page).ceil
+
+        meta = {
+          count: total,
+          page: page,
+          per_page: per_page,
+          next_page: (page < total_pages ? page + 1 : nil),
+          previous_page: (page > 1 ? page - 1 : nil)
+        }
+
+        [ records, meta ]
+      end
+
       def header_subdomain
         request.headers["X-Helpdesk-Account"].to_s.strip
       end
diff --git a/app/controllers/api/v1/registrations_controller.rb b/app/controllers/api/v1/registrations_controller.rb
new file mode 100644
index 0000000..936949e
--- /dev/null
+++ b/app/controllers/api/v1/registrations_controller.rb
@@ -0,0 +1,35 @@
+module Api
+  module V1
+    class RegistrationsController < BaseController
+      before_action :require_account_header!
+
+      def create
+        if header_account.cancelled?
+          return render_error("Account has been cancelled", :forbidden)
+        end
+
+        user_params = params.require(:user)
+
+        user = header_account.users.build(
+          name: user_params[:name],
+          email: user_params[:email],
+          password: user_params[:password],
+          role: "customer"
+        )
+
+        if user_params.key?(:password_confirmation)
+          user.password_confirmation = user_params[:password_confirmation]
+        end
+
+        if user.save
+          token = user.generate_verification_token!
+          UserMailer.verification(user, token).deliver_now
+
+          render json: { user: user.as_api_json }, status: :created
+        else
+          render_validation_error(user)
+        end
+      end
+    end
+  end
+end
