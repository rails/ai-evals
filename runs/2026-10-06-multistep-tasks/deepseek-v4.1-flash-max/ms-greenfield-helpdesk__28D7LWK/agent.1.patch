new file mode 100644
index 0000000..9bcda0a
--- /dev/null
+++ b/config/application.rb
@@ -0,0 +1,33 @@
+require_relative "boot"
+require_relative "../lib/helpdesk_cors"
+
+require "rails/all"
+
+# Require the gems listed in Gemfile, including any gems
+# you've limited to :test, :development, or :production.
+Bundler.require(*Rails.groups)
+
+module App
+  class Application < Rails::Application
+    # The workspace may share a single DATABASE_URL between Rails
+    # environments, so let database preparation tasks use it directly.
+    ENV["DISABLE_DATABASE_ENVIRONMENT_CHECK"] ||= "1"
+
+    config.load_defaults 8.1
+
+    # lib/ contains our autoloaded code (the CORS middleware is required
+    # explicitly above because it is referenced during middleware setup).
+    config.autoload_lib(ignore: %w[assets tasks])
+
+    # The frontend is a separate app, so Host header authorization is not
+    # relevant for this API and would otherwise reject custom domains.
+    config.hosts = []
+
+    # Allow CORS requests from the configured frontend origin(s).
+    config.middleware.insert_before 0, HelpdeskCors
+
+    config.active_storage.variant_processor = :disabled
+
+    config.api_only = true
+  end
+end
