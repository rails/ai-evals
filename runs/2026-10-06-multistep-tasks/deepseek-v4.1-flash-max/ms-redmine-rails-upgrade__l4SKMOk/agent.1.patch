--- a/config/application.rb
+++ b/config/application.rb
@@ -17,12 +17,54 @@ require 'rails/test_unit/railtie'
 
 Bundler.require(*Rails.groups)
 
+# Redmine's API templates are named *.api.rsb and the :api format is handled
+# by Redmine::Views::ApiTemplateHandler. Rails 7.0's template resolver only
+# matches templates whose format is a registered mime type, so register :api
+# as an alias of XML before ActionView builds its resolvers. See #37689.
+require 'action_dispatch/http/mime_type'
+Mime::Type.register_alias 'application/xml', :api
+
 module RedmineApp
   class Application < Rails::Application
     # Settings in config/environments/* take precedence over those specified here.
     # Application configuration should go into files in config/initializers
     # -- all .rb files in that directory are automatically loaded.
 
+    # NOTE: the next release must call `config.load_defaults 7.0` here,
+    # before the temporary compatibility overrides below. It is not called
+    # yet because this release still runs Rails 6.1.
+
+    # Temporary overrides below keep the application compatible with the
+    # Rails 6.1 release so that sessions and links in already sent mails
+    # survive both the upgrade to Rails 7.0 and a rollback to Rails 6.1.
+    #
+    # Rails 7.0 derives message verifier and cookie encryption keys with
+    # PBKDF2-HMAC-SHA256 by default. Rails 6.1 can only derive SHA1 keys,
+    # so keep using SHA1 until all sessions and mail link tokens created
+    # by the Rails 6.1 release have expired (mail links expire after 30
+    # days, sessions are browser-session cookies).
+    if config.active_support.respond_to?(:key_generator_hash_digest_class=)
+      config.active_support.key_generator_hash_digest_class = OpenSSL::Digest::SHA1
+    end
+
+    # Rails 7.0 defaults make belongs_to associations required. Redmine has
+    # optional belongs_to associations (for example User#authentication_mode),
+    # so keep the Rails 6.1 behavior until they are reviewed.
+    config.active_record.belongs_to_required_by_default = false
+
+    # Rails 7.0 starts signing cookies with a "cookie.<name>" purpose.
+    # Rails 6.1 verifies cookies without a purpose, so keep writing and
+    # verifying purpose-less cookies until all sessions have rotated.
+    config.action_dispatch.use_cookies_with_metadata = false
+
+    # Rails 7.0 defaults to the JSON cookie serializer and cannot read
+    # Marshal-serialized cookies written by Rails 6.1. Keep the Marshal
+    # serializer (which also falls back to reading JSON) so sessions survive
+    # both the upgrade and a rollback. Once all sessions created by the
+    # Rails 6.1 release have rotated, switch to :hybrid and finally to the
+    # Rails 7.0 :json default.
+    config.action_dispatch.cookies_serializer = :marshal if Rails::VERSION::MAJOR >= 7
+
     # Custom directories with classes and modules you want to be autoloadable.
     config.autoloader = :zeitwerk
 
