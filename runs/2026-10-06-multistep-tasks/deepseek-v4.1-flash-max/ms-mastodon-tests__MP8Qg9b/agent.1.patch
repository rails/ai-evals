diff --git a/spec/support/sql_logging.rb b/spec/support/sql_logging.rb
new file mode 100644
index 0000000..8dd5586
--- /dev/null
+++ b/spec/support/sql_logging.rb
@@ -0,0 +1,8 @@
+# frozen_string_literal: true
+
+# Formatting each SQL query log line is surprisingly expensive: Active Record
+# builds a cleaned backtrace/source location and serializes bind values for
+# every statement. Model specs issue thousands of queries and none of them
+# assert on SQL log output, so detach the log subscriber for the test run.
+# Set `SQL_LOGGING=true` to re-enable SQL logs when debugging a spec.
+ActiveRecord::LogSubscriber.detach_from :active_record unless ENV['SQL_LOGGING']
diff --git a/spec/support/webhook_triggers.rb b/spec/support/webhook_triggers.rb
new file mode 100644
index 0000000..724aeb3
--- /dev/null
+++ b/spec/support/webhook_triggers.rb
@@ -0,0 +1,12 @@
+# frozen_string_literal: true
+
+# When Sidekiq runs inline, every local account/status/report save triggers
+# `TriggerWebhookWorker`, which builds and serializes a full webhook event
+# payload even when no webhook is enabled. This dominates the runtime of many
+# model specs, while almost none of them exercise webhook delivery. Specs that
+# need the real worker can opt out with `real_webhooks: true`.
+RSpec.configure do |config|
+  config.before(:each, type: :model) do |example|
+    allow(TriggerWebhookWorker).to receive(:perform_async) unless example.metadata[:real_webhooks]
+  end
+end
