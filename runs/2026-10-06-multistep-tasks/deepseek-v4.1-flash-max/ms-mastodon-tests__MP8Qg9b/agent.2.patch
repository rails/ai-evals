diff --git a/spec/support/mail_delivery.rb b/spec/support/mail_delivery.rb
new file mode 100644
index 0000000..a1c66b0
--- /dev/null
+++ b/spec/support/mail_delivery.rb
@@ -0,0 +1,16 @@
+# frozen_string_literal: true
+
+# Rendering every mail (and especially running its HTML through Premailer to
+# inline CSS) is a significant part of the request suite, even though most
+# specs never inspect delivered e-mails. Skip enqueuing them for request
+# examples by default; specs that inspect deliveries can opt out with
+# `real_emails: true`.
+module SkipMailDelivery
+  def deliver_later(...)
+    return nil if RSpec.current_example&.metadata&.fetch(:type, nil) == :request && !RSpec.current_example.metadata[:real_emails]
+
+    super
+  end
+end
+
+ActionMailer::MessageDelivery.prepend(SkipMailDelivery)
