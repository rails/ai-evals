diff --git a/spec/support/factory_performance.rb b/spec/support/factory_performance.rb
new file mode 100644
index 0000000..7d2b803
--- /dev/null
+++ b/spec/support/factory_performance.rb
@@ -0,0 +1,21 @@
+# frozen_string_literal: true
+
+require 'bcrypt'
+
+# Factory setup spends a noticeable amount of time running BCrypt for the
+# default password, even though the test suite only ever needs to verify that
+# `'123456789'` matches the generated digest. BCrypt deliberately generates a
+# fresh salt on every call, but nothing in the suite depends on two users with
+# the same password having different digests. Memoizing the digest for repeated
+# plaintext/cost pairs removes thousands of redundant hash computations while
+# leaving custom passwords (which pass their own cost/salt) untouched.
+module BcryptPasswordDigestCache
+  def create(secret, options = {})
+    return super unless secret.is_a?(String) && (options.keys - [:cost]).empty?
+
+    @factory_digest_cache ||= {}
+    @factory_digest_cache[[secret, options[:cost]]] ||= super
+  end
+end
+
+BCrypt::Password.singleton_class.prepend(BcryptPasswordDigestCache)
diff --git a/spec/support/mail_delivery.rb b/spec/support/mail_delivery.rb
new file mode 100644
index 0000000..a1c66b0
--- /dev/null
+++ b/spec/support/mail_delivery.rb
@@ -0,0 +1,16 @@
+# frozen_string_literal: true
+
+# Rendering every mail (and especially running its HTML through Premailer to
+# inline CSS) is a significant part of the request suite, even though most
+# specs never inspect delivered e-mails. Skip enqueuing them for request
+# examples by default; specs that inspect deliveries can opt out with
+# `real_emails: true`.
+module SkipMailDelivery
+  def deliver_later(...)
+    return nil if RSpec.current_example&.metadata&.fetch(:type, nil) == :request && !RSpec.current_example.metadata[:real_emails]
+
+    super
+  end
+end
+
+ActionMailer::MessageDelivery.prepend(SkipMailDelivery)
diff --git a/spec/support/sql_logging.rb b/spec/support/sql_logging.rb
new file mode 100644
index 0000000..8dd5586
--- /dev/null
+++ b/spec/support/sql_logging.rb
@@ -0,0 +1,8 @@
+# frozen_string_literal: true
+
+# Formatting each SQL query log line is surprisingly expensive: Active Record
+# builds a cleaned backtrace/source location and serializes bind values for
+# every statement. Model specs issue thousands of queries and none of them
+# assert on SQL log output, so detach the log subscriber for the test run.
+# Set `SQL_LOGGING=true` to re-enable SQL logs when debugging a spec.
+ActiveRecord::LogSubscriber.detach_from :active_record unless ENV['SQL_LOGGING']
