@@ -0,0 +1,55 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ show edit update destroy ]
+
+  def index
+    @bots = accessible_bots.ordered
+  end
+
+  def new
+    @bot = Current.user.bots.new
+  end
+
+  def create
+    @bot = Current.user.bots.new(bot_params)
+
+    if @bot.save
+      redirect_to bots_url, notice: "✓"
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def show
+    redirect_to edit_bot_url(@bot)
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url, notice: "✓"
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.destroy!
+    redirect_to bots_url, notice: "✓"
+  end
+
+  private
+    def set_bot
+      @bot = accessible_bots.find_by(id: params[:id])
+      head :not_found unless @bot
+    end
+
+    def accessible_bots
+      Current.user.administrator? ? Bot.all : Current.user.bots
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar, :webhook_url, :add_to_all_open_rooms)
+    end
+end
