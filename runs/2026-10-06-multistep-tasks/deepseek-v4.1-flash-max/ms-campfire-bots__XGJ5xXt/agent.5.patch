+
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "an unknown bot cannot be reactivated" do
+    sign_in :david
+
+    post reactivate_bot_url(id: 123456)
+
+    assert_response :not_found
+  end
+end
