--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,55 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ show edit update destroy ]
+
+  def index
+    @bots = accessible_bots.ordered
+  end
+
+  def new
+    @bot = Current.user.bots.new
+  end
+
+  def create
+    @bot = Current.user.bots.new(bot_params)
+
+    if @bot.save
+      redirect_to bots_url, notice: "✓"
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def show
+    redirect_to edit_bot_url(@bot)
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url, notice: "✓"
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.destroy!
+    redirect_to bots_url, notice: "✓"
+  end
+
+  private
+    def set_bot
+      @bot = accessible_bots.find_by(id: params[:id])
+      head :not_found unless @bot
+    end
+
+    def accessible_bots
+      Current.user.administrator? ? Bot.all : Current.user.bots
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..697e2fb
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,46 @@
+class Bot < User
+  # Bots authenticate with their code, but it's also stored under bot_code so that
+  # either name is available to callers (and fixtures) that expect it.
+  has_secure_token :code
+
+  belongs_to :creator, class_name: "User", optional: true, default: -> { Current.user }
+
+  class << self
+    # Finds the bot matching a code, whichever column holds it.
+    def authenticate(code)
+      return if code.blank?
+
+      find_by(code: code) || find_by(bot_code: code)
+    end
+
+    alias_method :find_by_code, :authenticate
+  end
+
+  validates :name, presence: true
+
+  before_save :sync_code_columns
+
+  def code
+    super.presence || self[:bot_code]
+  end
+
+  def bot_code
+    super.presence || self[:code]
+  end
+
+  def code=(value)
+    super
+    self[:bot_code] = value if value.present?
+  end
+
+  def bot_code=(value)
+    self[:bot_code] = value
+    self[:code] = value if self[:code].blank?
+  end
+
+  private
+    def sync_code_columns
+      self[:code] ||= self[:bot_code]
+      self[:bot_code] ||= self[:code]
+    end
+end
