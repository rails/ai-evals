+require "test_helper"
+
+class Bot::WebhookTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://example.com/hooks/deploy")
+    @room = rooms(:hq)
+    @message = create_message_with_mention
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).returns("93.184.216.34")
+  end
+
+  test "webhook store can be cleared by saving a blank URL" do
+    @bot.update!(webhook_url: "")
+    assert_nil @bot.reload.webhook_url
+    assert_not @bot.webhook?
+
+    @bot.update!(webhook_url: "https://example.com/new")
+    assert_equal "https://example.com/new", @bot.reload.webhook_url
+
+    @bot.update!(webhook_url: "")
+    assert_nil @bot.reload.webhook_url
+  end
+
+  test "webhook URL is stripped" do
+    @bot.update!(webhook_url: "  https://example.com/hooks/deploy  ")
+    assert_equal "https://example.com/hooks/deploy", @bot.reload.webhook_url
+  end
+
+  test "builds the mention payload" do
+    payload = @bot.webhook_payload_for(@message).deep_stringify_keys
+
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => users(:david).id, "name" => "David" }, payload["author"])
+    assert_equal @room.id, payload["room"]["id"]
+    assert_equal @room.name, payload["room"]["name"]
+    assert_equal "/rooms/#{@room.id}/#{@bot.code}/messages", payload["room"]["reply_to"]
+    assert_equal @message.id, payload["message"]["id"]
+    assert_equal "restart the build please", payload["message"]["body"]["text"]
+    assert_equal @message.body.to_s, payload["message"]["body"]["html"]
+    assert_equal "/rooms/#{@room.id}/@#{@message.id}", payload["message"]["link"]
+  end
+
+  test "posts the payload as JSON with the JSON content type" do
+    seen_payload = nil
+    WebMock.stub_request(:post, @bot.webhook_url).with do |request|
+      seen_payload = JSON.parse(request.body)
+      true
+    end.to_return(status: 204)
+
+    @bot.webhook_payload_for(@message)
+    Bot::WebhookJob.perform_now(@bot, @message)
+
+    assert_equal "mention", seen_payload["event"]
+    assert_equal "restart the build please", seen_payload["message"]["body"]["text"]
+  end
+
+  test "a text plain response is posted into the room as the bot" do
+    WebMock.stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: "Deploying now!", headers: { "Content-Type" => "text/plain; charset=utf-8" })
+
+    assert_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal "Deploying now!", reply.plain_text_body
+  end
+
+  test "a text html response is posted into the room as HTML rich text" do
+    WebMock.stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: "<p>Deploying <strong>now</strong>!</p>", headers: { content_type: "text/html" })
+
+    assert_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.to_s, "<strong>now</strong>"
+    assert_equal "Deploying now!", reply.plain_text_body
+  end
+
+  test "a no content response posts nothing" do
+    WebMock.stub_request(:post, @bot.webhook_url).to_return(status: 204)
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+  end
+
+  test "other statuses post nothing" do
+    WebMock.stub_request(:post, @bot.webhook_url).to_return(status: 500, body: "Nope", headers: { "Content-Type" => "text/plain; charset=utf-8" })
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+  end
+
+  test "no request is made without a webhook URL" do
+    @bot.update!(webhook_url: "")
+
+    WebMock.stub_request(:post, "https://example.com/hooks/deploy")
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+
+    assert_not_requested :post, "https://example.com/hooks/deploy"
+  end
+
+  private
+    def create_message_with_mention
+      @room.messages.create!(body: "<div>#{mention_attachment_for_bot(@bot)} restart the build please</div>",
+        creator: users(:david), client_message_id: "webhook-#{SecureRandom.hex}")
+    end
+
+    def mention_attachment_for_bot(bot)
+      content = ApplicationController.render(partial: "users/mention", locals: { user: bot })
+      %(<action-text-attachment sgid="#{bot.attachable_sgid}" content-type="application/vnd.campfire.mention" content="#{content.gsub('"', '&quot;')}"></action-text-attachment>)
+    end
+
+  test "strips mentions surrounded by non-breaking spaces" do
+    body = "<div>\u00a0#{mention_attachment_for_bot(@bot)}\u00a0restart the build please\u00a0</div>"
+    message = @room.messages.create!(body: body, creator: users(:david), client_message_id: "nbsp-#{SecureRandom.hex}")
+
+    assert_equal "restart the build please", @bot.webhook_payload_for(message)[:message][:body][:text]
+  end
+end
diff --git a/test/models/message_bot_mention_test.rb b/test/models/message_bot_mention_test.rb
new file mode 100644
index 0000000..a1a1e37
--- /dev/null
+++ b/test/models/message_bot_mention_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class MessageBotMentionTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://example.com/hooks/deploy")
+    @room = rooms(:hq)
+  end
+
+  test "mentions enqueue a webhook job but don't deliver synchronously" do
+    message = nil
+    assert_enqueued_with(job: Bot::WebhookJob) do
+      message = @room.messages.create!(body: "<div>#{mention_attachment_for(@bot)} restart the build</div>",
+        creator: users(:david), client_message_id: "bot-mention-#{SecureRandom.hex}")
+    end
+
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "bots without a webhook don't enqueue a webhook job" do
+    bot = users(:david).bots.create!(name: "No Hook Bot")
+
+    assert_no_enqueued_jobs only: [ Bot::WebhookJob ] do
+      @room.messages.create!(body: "<div>#{mention_attachment_for(bot)} hello</div>",
+        creator: users(:david), client_message_id: "no-hook-#{SecureRandom.hex}")
+    end
+  end
+
+  test "mentioning a person doesn't enqueue a webhook job" do
+    assert_no_enqueued_jobs only: [ Bot::WebhookJob ] do
+      @room.messages.create!(body: "<div>#{mention_attachment_for(:kevin)} hello</div>",
+        creator: users(:david), client_message_id: "person-#{SecureRandom.hex}")
+    end
+  end
+
+  test "a message mentioning a bot renders its mention" do
+    message = @room.messages.create!(body: "<div>#{mention_attachment_for(@bot)} restart the build</div>",
+      creator: users(:david), client_message_id: "render-#{SecureRandom.hex}")
+
+    assert_includes message.body.to_s, "Deploy Bot"
+    assert_includes message.body.to_s, "mention"
+  end
+end
