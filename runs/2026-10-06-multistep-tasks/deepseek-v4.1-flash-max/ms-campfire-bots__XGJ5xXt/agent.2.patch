+++ b/app/jobs/bot/webhook_job.rb
@@ -0,0 +1,15 @@
+class Bot::WebhookJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(*args)
+    message = args.find { |argument| argument.is_a?(Message) }
+    return unless message
+
+    bots = args.select { |argument| argument.is_a?(Bot) }
+    bots = message.bot_mentionees.with_webhook_url.to_a if bots.empty?
+
+    bots.each do |bot|
+      Bot::Webhook.new(bot, message).deliver if bot.webhook_url.present?
+    end
+  end
+end
