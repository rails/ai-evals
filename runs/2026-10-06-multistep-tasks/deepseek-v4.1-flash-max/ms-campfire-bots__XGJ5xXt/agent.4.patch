diff --git a/app/models/user.rb b/app/models/user.rb
index 244ab94..2cdb712 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -39,6 +39,16 @@ class User < ApplicationRecord
     !bot?
   end
 
+  # The account-wide cap on bots owned by a regular member. Administrators are
+  # exempt from the cap in #bots_at_limit? and in Bot's validation.
+  def bot_limit
+    Current.account.bots_per_member
+  end
+
+  def bots_at_limit?
+    !administrator? && bots.count >= bot_limit.to_i
+  end
+
   def initials
     name.scan(/\b\w/).join
   end
