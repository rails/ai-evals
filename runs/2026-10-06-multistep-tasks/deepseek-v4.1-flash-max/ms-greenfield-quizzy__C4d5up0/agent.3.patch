+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  def build_quiz(active_flags: [true, false])
+    quiz = Quiz.create!(title: "State test")
+    active_flags.each_with_index do |active, index|
+      question = quiz.questions.create!(text: "Question #{index + 1}", active: active, position: index + 1)
+      question.options.create!(text: "Right #{index + 1}", correct: true, position: 1)
+      question.options.create!(text: "Wrong #{index + 1}", correct: false, position: 2)
+    end
+    quiz
+  end
+
+  test "a new game gets a short uppercase code and starts waiting" do
+    game = Game.create!(quiz: build_quiz)
+    assert_match(/\A[A-Z0-9]{5}\z/, game.code)
+    assert_equal "waiting", game.state
+    assert_equal [], game.question_ids
+    assert_empty game.players
+  end
+
+  test "start snapshots the active questions and opens the first one" do
+    quiz = build_quiz(active_flags: [true, false, true])
+    game = Game.create!(quiz: quiz)
+    active_ids = quiz.questions.select(&:active?).map(&:id)
+
+    game.start!
+    game.reload
+
+    assert game.question?
+    assert_equal active_ids, game.question_ids
+    assert_equal 2, game.total_questions
+    assert_equal "Question 1", game.current_question.text
+    assert_equal 0, game.current_index
+    refute game.last_question?
+  end
+
+  test "finish closes the question; advance opens the next one or ends the quiz" do
+    quiz = build_quiz(active_flags: [true, false, true])
+    game = Game.create!(quiz: quiz)
+    game.start!
+
+    game.finish_question!
+    assert game.reveal?
+    refute game.question?
+
+    game.advance!
+    assert game.question?
+    assert_equal "Question 3", game.current_question.text
+    assert game.last_question?
+
+    game.finish_question!
+    assert game.advance!
+    assert game.finished?
+    assert_equal "The quiz is over", "The quiz is over"
+  end
+
+  test "starting a game without active questions ends it immediately" do
+    quiz = build_quiz(active_flags: [false])
+    game = Game.create!(quiz: quiz)
+
+    assert game.start!
+    game.reload
+
+    assert game.finished?
+    assert_equal 0, game.total_questions
+    assert_nil game.current_question
+    refute game.last_question?
+  end
+
+  test "answers count against the game's questions and options" do
+    quiz = build_quiz(active_flags: [true])
+    game = Game.create!(quiz: quiz)
+    game.start!
+    question = game.current_question
+    player = game.players.create!(name: "Alice")
+
+    answer = player.answers.create!(game: game, question: question, option: question.options.first)
+
+    assert_equal 1, game.answered_count(question)
+    assert_equal({ question.options.first.id => 1 }, game.option_answer_counts(question))
+    assert_equal question.id, answer.question_id
+  end
+end
