diff --git a/app/views/play/show.html.erb b/app/views/play/show.html.erb
new file mode 100644
index 0000000..66f50c0
--- /dev/null
+++ b/app/views/play/show.html.erb
@@ -0,0 +1,71 @@
+<%= content_for :title, "#{@game.quiz.title} · Quizzy" %>
+
+<div class="play">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @game.quiz.title %></span>
+  </div>
+
+  <div class="play__body">
+    <% if @game.waiting? %>
+      <div class="waiting">
+        <div class="waiting__gem">?</div>
+        <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+        <p class="play-lead">You're in. Waiting for the first question…</p>
+      </div>
+    <% elsif @game.question? && @question %>
+      <div class="play-question__num">Question <%= @game.current_index + 1 %> of <%= @game.total_questions %></div>
+      <div class="play-question__body"><%= @question.text %></div>
+
+      <ul class="play-options">
+        <% @question.options.each_with_index do |option, index| %>
+          <li>
+            <%= button_to play_answer_path(@game.code),
+                params: { option_id: option.id },
+                class: "play-option #{'is-picked' if option.id == @picked_option&.id}",
+                form: { class: "play-option-form" } do %>
+              <span class="play-option__letter"><%= option_letter(index) %></span>
+              <span class="play-option__title"><%= option.text %></span>
+            <% end %>
+            <% if option.id == @picked_option&.id %>
+              <div class="play-choice-mark">Your answer</div>
+            <% end %>
+          </li>
+        <% end %>
+      </ul>
+    <% elsif @game.reveal? && @question %>
+      <div class="play-question__num">Question <%= @game.current_index + 1 %> of <%= @game.total_questions %></div>
+      <div class="play-question__body"><%= @question.text %></div>
+
+      <ul class="play-options is-locked is-revealed">
+        <% @question.options.each_with_index do |option, index| %>
+          <% picked = option.id == @picked_option&.id %>
+          <li>
+            <button type="button" class="play-option <%= "is-picked" if picked %> <%= "is-correct" if option.correct? %>" disabled>
+              <span class="play-option__letter"><%= option_letter(index) %></span>
+              <span class="play-option__title"><%= option.text %></span>
+              <% if option.correct? %><span class="play-option__mark">✓</span><% end %>
+              <% if picked && !option.correct? %><span class="play-option__mark">✗</span><% end %>
+            </button>
+            <% if picked %>
+              <div class="play-choice-mark">Your answer</div>
+            <% end %>
+          </li>
+        <% end %>
+      </ul>
+
+      <% if @picked_option.nil? %>
+        <div class="play-status play-status--neutral">No answer</div>
+      <% elsif @picked_option.correct? %>
+        <div class="play-status play-status--right">Correct!</div>
+      <% else %>
+        <div class="play-status play-status--wrong">Wrong!</div>
+      <% end %>
+    <% else %>
+      <div class="waiting">
+        <h1 class="play-title">The quiz is over</h1>
+        <p class="play-lead">Thanks for playing, <%= @player.name %>!</p>
+      </div>
+    <% end %>
+  </div>
+</div>
