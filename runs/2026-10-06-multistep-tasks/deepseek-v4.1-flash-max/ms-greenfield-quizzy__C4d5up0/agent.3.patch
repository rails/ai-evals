+module Moderate
+  class GamesController < BaseController
+    before_action :set_game, only: %i[show start finish advance]
+
+    # POST /moderate/quizzes/:quiz_id/games
+    def create
+      quiz = Quiz.find(params[:quiz_id])
+      game = Game.create!(quiz: quiz)
+      redirect_to moderate_game_path(game)
+    end
+
+    # GET /moderate/games/:id — the moderator's big screen.
+    def show
+      @questions = @game.questions
+      @current_question = @game.current_question
+      @index = @game.current_index
+      @total = @questions.size
+      @last_question = @game.last_question?
+      @players_count = @game.players_count
+      @answered_count = @game.answered_count(@current_question) if @current_question
+      @option_counts = @game.option_answer_counts(@current_question) if @current_question && @game.reveal?
+    end
+
+    # POST /moderate/games/:id/start
+    def start
+      @game.start!
+      redirect_to moderate_game_path(@game)
+    end
+
+    # POST /moderate/games/:id/finish — close the current question.
+    def finish
+      @game.finish_question!
+      redirect_to moderate_game_path(@game)
+    end
+
+    # POST /moderate/games/:id/advance — next question, or end the quiz.
+    def advance
+      @game.advance!
+      redirect_to moderate_game_path(@game)
+    end
+
+    private
+
+    def set_game
+      @game = Game.find(params[:id])
+    end
+  end
+end
