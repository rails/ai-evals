+        </div>
+
+        <div class="qr" id="qr-code" role="img" aria-label="Join link QR code" data-url="<%= join_link_url %>">
+          <%= qr_code_svg(join_link_url) %>
+        </div>
+      </div>
+    <% elsif @game.question? && @current_question %>
+      <div class="screen__kicker">Question <%= @index + 1 %> of <%= @total %></div>
+      <div class="stage-question__body"><%= @current_question.text %></div>
+
+      <ul class="stage-options">
+        <% @current_question.options.each_with_index do |option, index| %>
+          <li class="stage-option">
+            <span class="stage-option__letter"><%= option_letter(index) %></span>
+            <span class="stage-option__title"><%= option.text %></span>
+          </li>
+        <% end %>
+      </ul>
+
+      <div class="answers-counter mt-2">Answers: <strong><%= @answered_count %></strong> / <strong><%= @players_count %></strong></div>
+    <% elsif @game.reveal? && @current_question %>
+      <div class="screen__kicker">Question <%= @index + 1 %> of <%= @total %></div>
+      <div class="stage-question__body"><%= @current_question.text %></div>
+
+      <ul class="stage-options stage-options--results">
+        <% @current_question.options.each_with_index do |option, index| %>
+          <li class="stage-option <%= "is-correct" if option.correct? %>">
+            <span class="stage-option__letter"><%= option_letter(index) %></span>
+            <span class="stage-option__title"><%= option.text %></span>
+            <span class="stage-option__count"><%= @option_counts[option.id] || 0 %></span>
+            <% if option.correct? %><span class="stage-option__mark">Correct</span><% end %>
+          </li>
+        <% end %>
+      </ul>
+    <% else %>
+      <div class="screen__kicker">Thanks for playing!</div>
+      <div class="stage-question__body">The quiz is over</div>
+    <% end %>
+  </div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <% if @game.question? || @game.reveal? %>
+        <span class="screen-controls__join">Join at <span class="screen-controls__url"><%= join_link_text %></span></span>
+      <% end %>
+    </div>
+
+    <div class="buttons">
+      <% if @game.waiting? %>
+        <%= button_to "Start", start_moderate_game_path(@game),
+            method: :post,
+            class: "btn btn--pink btn--lg",
+            form: { class: "inline-form game-control-form" } %>
+      <% elsif @game.question? && @current_question %>
+        <%= button_to "Finish", finish_moderate_game_path(@game),
+            method: :post,
+            class: "btn btn--pink btn--lg",
+            form: { class: "inline-form game-control-form" } %>
+      <% elsif @game.reveal? && @current_question %>
+        <% if @last_question %>
+          <%= button_to "End quiz", advance_moderate_game_path(@game),
+              method: :post,
+              class: "btn btn--pink btn--lg",
+              form: { class: "inline-form game-control-form" } %>
+        <% else %>
+          <%= button_to "Next", advance_moderate_game_path(@game),
+              method: :post,
+              class: "btn btn--pink btn--lg",
+              form: { class: "inline-form game-control-form" } %>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+</div>
