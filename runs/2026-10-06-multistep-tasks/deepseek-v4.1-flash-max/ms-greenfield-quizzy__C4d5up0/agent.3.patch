diff --git a/app/channels/game_channel.rb b/app/channels/game_channel.rb
new file mode 100644
index 0000000..d604cd7
--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,11 @@
+# Every screen that follows one game (moderator big screen and each phone)
+# subscribes here. The only message pushed out is a lightweight "refresh"
+# ping; the client then re-fetches its own page, so all rendering stays
+# server-side.
+class GameChannel < ApplicationCable::Channel
+  def subscribed
+    @game = Game.find_by(id: params[:game_id] || params["game_id"])
+    reject if @game.nil?
+    stream_for @game if @game
+  end
+end
