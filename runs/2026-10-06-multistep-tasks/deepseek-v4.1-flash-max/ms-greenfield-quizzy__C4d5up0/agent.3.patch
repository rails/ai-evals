+    alice.post play_answer_path(code), params: { option_id: func_id }
+    alice.follow_redirect!
+    alice.post play_answer_path(code), params: { option_id: func_id }
+    assert_equal 1, game.reload.answers.where(player: game.players.find_by(name: "Alice")).count
+
+    bob.post play_answer_path(code), params: { option_id: def_id }
+    bob.follow_redirect!
+
+    get moderate_game_path(game), headers: @headers
+    assert_select ".answers-counter", text: /Answers: 2 \/ 2/
+
+    post finish_moderate_game_path(game), headers: @headers
+
+    get moderate_game_path(game), headers: @headers
+    assert_select ".stage-options--results"
+    assert_select ".stage-option.is-correct", text: /def/
+    assert_select ".stage-option.is-correct .stage-option__count", text: "1"
+    assert_select ".stage-option:not(.is-correct) .stage-option__count", text: "1"
+    assert_select ".stage-option__mark", text: "Correct", count: 1
+
+    alice.get play_path(code)
+    alice.assert_select ".play-status", text: "Wrong!"
+    bob.get play_path(code)
+    bob.assert_select ".play-status", text: "Correct!"
+
+    post advance_moderate_game_path(game), headers: @headers
+    get moderate_game_path(game), headers: @headers
+    assert_select ".screen__kicker", text: "Question 2 of 3"
+    assert_select "button", text: "Finish"
