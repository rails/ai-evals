@@ -28,5 +30,138 @@
     });
   }
 
-  document.addEventListener("DOMContentLoaded", initAddOption);
+  // ---------- Live screens: follow the game without page reloads ----------
+  //
+  // Every game screen subscribes to the game's Action Cable stream. The server
+  // only sends a tiny "refresh" ping; the client re-fetches its own page so all
+  // rendering stays in Rails. If a WebSocket cannot be established (restricted
+  // venue Wi-Fi), a slow poll keeps the screen live as a fallback.
+
+  var refreshing = false;
+  var fallbackTimer = null;
+
+  function applyHtml(html) {
+    var doc = new DOMParser().parseFromString(html, "text/html");
+    var newMain = doc.querySelector("main");
+    var main = document.querySelector("main");
+    if (newMain && main) {
+      main.replaceWith(newMain);
+      if (doc.title) document.title = doc.title;
+    }
+  }
+
+  function refreshPage() {
+    if (refreshing) return Promise.resolve();
+    refreshing = true;
+    return fetch(window.location.href, {
+      credentials: "same-origin",
+      headers: { "Accept": "text/html" }
+    })
+      .then(function (response) {
+        if (!response.ok) throw new Error("Could not refresh");
+        return response.text();
+      })
+      .then(applyHtml)
+      .catch(function () {})
+      .then(function () { refreshing = false; });
+  }
+
+  function startFallback() {
+    if (fallbackTimer) return;
+    fallbackTimer = setInterval(refreshPage, 2500);
+  }
+
+  function stopFallback() {
+    if (!fallbackTimer) return;
+    clearInterval(fallbackTimer);
+    fallbackTimer = null;
+  }
+
+  function initLiveGame() {
+    var gameId = document.body && document.body.getAttribute("data-game-id");
+    if (!gameId) return;
+
+    var identifier = JSON.stringify({ channel: "GameChannel", game_id: gameId });
+    var socket = null;
+    var reconnectTimer = null;
+
+    function connect() {
+      var scheme = window.location.protocol === "https:" ? "wss://" : "ws://";
+      try {
+        socket = new WebSocket(scheme + window.location.host + "/cable");
+      } catch (error) {
+        startFallback();
+        reconnectTimer = setTimeout(connect, 3000);
+        return;
+      }
+
+      startFallback();
+
+      socket.onopen = function () {
+        stopFallback();
+        socket.send(JSON.stringify({ command: "subscribe", identifier: identifier }));
+      };
+
+      socket.onmessage = function (event) {
+        var data;
+        try { data = JSON.parse(event.data); } catch (error) { return; }
+        if (data && data.message && data.message.event === "refresh") refreshPage();
+      };
+
+      socket.onclose = function () {
+        startFallback();
+        if (reconnectTimer) clearTimeout(reconnectTimer);
+        reconnectTimer = setTimeout(connect, 1500);
+      };
+
+      socket.onerror = function () {
+        try { socket.close(); } catch (error) {}
+      };
+    }
+
+    connect();
+
+    document.addEventListener("visibilitychange", function () {
+      if (!document.hidden) refreshPage();
+    });
+  }
+
+  // Answering and the moderator's Start/Finish/Next/End controls are ordinary
+  // form POSTs (so they still work without JS), but when JS is on we submit
+  // them in the background and swap in the returned page. That keeps screens
+  // from reloading, while other devices are told to refresh over Action Cable.
+  function initBackgroundForms() {
+    document.addEventListener("submit", function (event) {
+      var form = event.target;
+      if (!form || !form.classList) return;
+
+      var background = form.classList.contains("play-option-form") ||
+        form.classList.contains("game-control-form");
+      if (!background) return;
+
+      event.preventDefault();
+      var request = fetch(form.action, {
+        method: "POST",
+        body: new FormData(form),
+        credentials: "same-origin",
+        headers: { "Accept": "text/html", "X-Requested-With": "XMLHttpRequest" }
+      });
+
+      request
+        .then(function (response) {
+          if (!response.ok) throw new Error("Could not save the answer");
+          return response.text();
+        })
+        .then(applyHtml)
+        .catch(function () {
+          form.submit();
+        });
+    });
+  }
+
+  document.addEventListener("DOMContentLoaded", function () {
+    initAddOption();
+    initLiveGame();
+    initBackgroundForms();
+  });
 })();
