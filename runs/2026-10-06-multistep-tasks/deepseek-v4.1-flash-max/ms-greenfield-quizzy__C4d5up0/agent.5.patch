--- /dev/null
+++ b/app/jobs/game_timer_job.rb
@@ -0,0 +1,15 @@
+# Closes a question when its timer runs out. Scheduled by Game#open_question!
+# with the question index the timer belongs to, so a late job can never close
+# a question the moderator has already moved on from.
+class GameTimerJob < ApplicationJob
+  queue_as :default
+
+  def perform(game_id, question_index)
+    game = Game.find_by(id: game_id)
+    return if game.nil?
+    return unless game.question?
+    return unless game.current_index == question_index
+
+    game.finish_question!
+  end
+end
