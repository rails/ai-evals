@@ -159,9 +159,71 @@
     });
   }
 
+  // ---------- Moderator big screen: question countdown ----------
+  //
+  // The server renders the seconds left when the question opened, so reloads
+  // always continue (never restart) the countdown. The page ticks locally and,
+  // at zero, submits the normal "Finish" form: the question then closes exactly
+  // like a moderator click and all screens are refreshed over Action Cable.
+
+  var countdownElement = null;
+  var countdownEndsAt = 0;
+  var countdownShown = -1;
+  var countdownFinishing = false;
+
+  function formatCountdown(seconds) {
+    var minutes = Math.floor(seconds / 60);
+    var rest = seconds % 60;
+    return minutes + ":" + (rest < 10 ? "0" : "") + rest;
+  }
+
+  function requestAutomaticFinish() {
+    if (countdownFinishing) return;
+    var form = document.getElementById("finish-question-form");
+    if (!form) return;
+
+    countdownFinishing = true;
+    if (typeof form.requestSubmit === "function") {
+      form.requestSubmit();
+    } else {
+      form.submit();
+    }
+  }
+
+  function syncCountdown() {
+    var element = document.querySelector("[data-question-timer]");
+    if (!element) {
+      countdownElement = null;
+      countdownShown = -1;
+      return;
+    }
+
+    if (element !== countdownElement) {
+      var initial = parseInt(element.getAttribute("data-remaining-seconds"), 10);
+      countdownElement = element;
+      countdownEndsAt = Date.now() + (isNaN(initial) ? 0 : initial) * 1000;
+      countdownShown = -1;
+      countdownFinishing = false;
+    }
+
+    var seconds = Math.max(0, Math.ceil((countdownEndsAt - Date.now()) / 1000));
+    if (seconds !== countdownShown) {
+      element.textContent = formatCountdown(seconds);
+      countdownShown = seconds;
+    }
+
+    if (seconds <= 0) requestAutomaticFinish();
+  }
+
+  function initCountdown() {
+    syncCountdown();
+    setInterval(syncCountdown, 250);
+  }
+
   document.addEventListener("DOMContentLoaded", function () {
     initAddOption();
     initLiveGame();
     initBackgroundForms();
+    initCountdown();
   });
 })();
