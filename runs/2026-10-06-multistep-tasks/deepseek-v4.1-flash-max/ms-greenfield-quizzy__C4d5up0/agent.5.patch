diff --git a/docs/design-notes.md b/docs/design-notes.md
index 7d0fcb0..e987e86 100644
--- a/docs/design-notes.md
+++ b/docs/design-notes.md
@@ -95,7 +95,8 @@ protected with HTTP Basic authentication using `QUIZZY_MODERATOR_USERNAME` and
   scheme left out), an inline-SVG QR code for the full URL (generated locally
   by `rqrcode`) and `Players: n`.
 * Open question: `Question X of Y`, the text/options, `Answers: answered / in
-  game`, and **Finish**.
+  game`, and **Finish**. With a timer, the big screen also shows the remaining
+  time as `M:SS`.
 * Reveal: the answer count for every option and a "Correct" mark on every
   correct option; **Next**, or **End quiz** on the last question (ends the
   game). Finished: "The quiz is over".
@@ -156,3 +157,25 @@ protected with HTTP Basic authentication using `QUIZZY_MODERATOR_USERNAME` and
   (`mount ActionCable.server => "/cable"`). `bin/serve` still uses the
   in-process `async` adapter in production; the client also polls once per
   second if the WebSocket cannot be established.
+
+## Question timer
+
+* Quiz settings gained `timer_minutes` and `timer_seconds` (integers, default
+  0), labelled "Timer minutes" and "Timer seconds". Their total is how long
+  every question stays open; `0:00` means no timer. Like
+  `number_of_winners`, the timer is a Quizzy setting and deliberately not part
+  of the export payload, so imported quizzes start from the default.
+* `Game#open_question!` stamps the shared `question_opened_at` and enqueues a
+  `GameTimerJob` for the duration. `Game#remaining_timer_seconds` is derived
+  from that timestamp, so a reload continues the countdown instead of
+  restarting it. Controllers also call `expire_question_if_timed_out!` before
+  rendering, so a question whose time is up closes even if no browser ran the
+  countdown.
+* The moderator big screen renders `.game-timer` (`data-question-timer`,
+  `data-remaining-seconds`) only while the question is open. Plain JS ticks it
+  locally in `M:SS` and at `0:00` submits the normal **Finish** form, so the
+  question closes exactly like a moderator click and every screen is
+  refreshed. Player screens never render the timer.
+* `GameTimerJob` is keyed to the question index it was scheduled for and
+  checks it again when it runs, so finishing early and advancing cannot be cut
+  short by the previous question's stale timer.
diff --git a/test/integration/question_timer_test.rb b/test/integration/question_timer_test.rb
new file mode 100644
index 0000000..38c7497
--- /dev/null
+++ b/test/integration/question_timer_test.rb
@@ -0,0 +1,214 @@
+require "test_helper"
+
+class QuestionTimerTest < ActionDispatch::IntegrationTest
+  setup do
+    credentials = ActionController::HttpAuthentication::Basic.encode_credentials(
+      ENV.fetch("QUIZZY_MODERATOR_USERNAME"),
+      ENV.fetch("QUIZZY_MODERATOR_PASSWORD")
+    )
+    @headers = { "Authorization" => credentials }
+  end
+
+  # One question with [correct, wrong] options.
+  def build_quiz(timer_minutes: 0, timer_seconds: 0, questions: 1)
+    quiz = Quiz.create!(title: "Timed Quiz", timer_minutes: timer_minutes, timer_seconds: timer_seconds)
+
+    questions.times do |index|
+      question = quiz.questions.create!(text: "Question #{index + 1}", active: true, position: index + 1)
+      question.options.create!(text: "Right #{index + 1}", correct: true, position: 1)
+      question.options.create!(text: "Wrong #{index + 1}", correct: false, position: 2)
+    end
+
+    quiz
+  end
+
+  def start_game(quiz)
+    post moderate_quiz_games_path(quiz), headers: @headers
+    Game.order(:id).last
+  end
+
+  def join_player(code, name)
+    session = open_session
+    session.post play_join_path(code), params: { name: name }
+    session.follow_redirect!
+    session
+  end
+
+  test "quiz settings expose Timer minutes and Timer seconds, zero by default" do
+    get new_moderate_quiz_path, headers: @headers
+    assert_response :success
+    assert_select "label[for=quiz_timer_minutes]", text: "Timer minutes"
+    assert_select "label[for=quiz_timer_seconds]", text: "Timer seconds"
+    assert_select "input#quiz_timer_minutes[type=number][min='0'][value='0']"
+    assert_select "input#quiz_timer_seconds[type=number][min='0'][value='0']"
+
+    post moderate_quizzes_path,
+         params: { quiz: { title: "Ninety seconds", timer_minutes: 1, timer_seconds: 30 } },
+         headers: @headers
+    assert_response :redirect
+
+    quiz = Quiz.order(:id).last
+    assert_equal 1, quiz.timer_minutes
+    assert_equal 30, quiz.timer_seconds
+    assert_equal 90, quiz.timer_duration_seconds
+    assert quiz.timer?
+
+    get edit_moderate_quiz_path(quiz), headers: @headers
+    assert_select "input#quiz_timer_minutes[value='1']"
+    assert_select "input#quiz_timer_seconds[value='30']"
+
+    # Missing fields fall back to zero instead of failing validation.
+    quiz.update!(timer_minutes: nil, timer_seconds: "")
+    assert_equal 0, quiz.timer_duration_seconds
+    refute quiz.timer?
+  end
+
+  test "the timer is not part of the export format and import starts at the default" do
+    quiz = build_quiz(timer_minutes: 0, timer_seconds: 5)
+    payload = quiz.export_payload
+
+    refute_includes payload.keys, "timer_minutes"
+    refute_includes payload.keys, "timer_seconds"
+
+    get export_moderate_quiz_path(quiz), headers: @headers
+    assert_response :success
+    exported_json = Nokogiri::HTML(response.body).at_css("pre").text
+    refute_match(/timer/i, exported_json)
+    assert_equal %w[questions title], JSON.parse(exported_json).keys.sort
+
+    post moderate_quiz_import_create_path,
+         params: { quiz_json: exported_json },
+         headers: @headers
+    assert_response :redirect
+
+    imported = Quiz.order(:id).last
+    assert_equal 0, imported.timer_duration_seconds
+    refute imported.timer?
+  end
+
+  test "the big screen shows the M:SS countdown and a reload continues it" do
+    quiz = build_quiz(timer_minutes: 1, timer_seconds: 30)
+    game = start_game(quiz)
+
+    post start_moderate_game_path(game), headers: @headers
+    assert_redirected_to moderate_game_path(game)
+
+    get moderate_game_path(game), headers: @headers
+    assert_select ".game-timer" do |elements|
+      remaining = elements.first["data-remaining-seconds"].to_i
+      assert_includes 88..90, remaining
+      assert_match(/\A(1:30|1:29)\z/, elements.first.text)
+    end
+    assert_select "form#finish-question-form button", text: "Finish"
+
+    # Time passed for everyone: 30 seconds of the shared countdown are gone,
+    # so a reload must show the remaining 60, not restart at 90.
+    game.update!(question_opened_at: 30.seconds.ago)
+    get moderate_game_path(game), headers: @headers
+    assert_select ".game-timer" do |elements|
+      remaining = elements.first["data-remaining-seconds"].to_i
+      assert_includes 58..60, remaining
+      assert_match(/\A(1:00|0:59)\z/, elements.first.text)
+    end
+
+    # Players never see a countdown.
+    player = join_player(game.code, "Alice")
+    player.assert_select ".play-question__body", text: /Question 1/
+    assert_no_match(/game-timer/, player.response.body)
+    assert_no_match(/\b\d+:\d{2}\b/, player.response.body)
+  end
+
+  test "0 minutes and 0 seconds means no timer and no countdown" do
+    quiz = build_quiz # timer defaults to 0:00
+    game = start_game(quiz)
+    join_player(game.code, "Alice")
+
+    post start_moderate_game_path(game), headers: @headers
+    game.update!(question_opened_at: 1.hour.ago)
+
+    get moderate_game_path(game), headers: @headers
+    assert_equal "question", game.reload.state
+    assert_select ".game-timer", count: 0
+    assert_select "button", text: "Finish"
+  end
+
+  test "a timed-out question finishes by itself as if Finish was clicked" do
+    quiz = build_quiz(timer_seconds: 5)
+    game = start_game(quiz)
+    player = join_player(game.code, "Alice")
+
+    post start_moderate_game_path(game), headers: @headers
+    game.reload
+    assert_equal "question", game.state
+
+    game.update!(question_opened_at: 6.seconds.ago)
+
+    # The moderator screen closes the question on load, without a POST.
+    get moderate_game_path(game), headers: @headers
+    assert_response :success
+    assert_equal "reveal", game.reload.state
+    assert_select ".stage-options--results"
+    assert_select ".game-timer", count: 0
+    assert_select "button", text: "End quiz"
+
+    # The player sees the closed question and their result.
+    player.get play_path(game.code)
+    player.assert_select ".play-status", text: "No answer"
+  end
+
+  test "the timer restarts for the next question and can be finished early" do
+    quiz = build_quiz(timer_minutes: 2, timer_seconds: 0, questions: 2)
+    game = start_game(quiz)
+
+    post start_moderate_game_path(game), headers: @headers
+    get moderate_game_path(game), headers: @headers
+    assert_select ".game-timer" do |elements|
+      assert_includes 118..120, elements.first["data-remaining-seconds"].to_i
+    end
+
+    game.update!(question_opened_at: 90.seconds.ago)
+    get moderate_game_path(game), headers: @headers
+    assert_select ".game-timer" do |elements|
+      remaining = elements.first["data-remaining-seconds"].to_i
+      assert_includes 28..30, remaining
+      assert_match(/\A0:(30|29)\z/, elements.first.text)
+    end
+
+    # Finish early: the countdown disappears and the next question starts with
+    # the full duration again.
+    post finish_moderate_game_path(game), headers: @headers
+    game.reload
+    assert_equal "reveal", game.state
+
+    post advance_moderate_game_path(game), headers: @headers
+    get moderate_game_path(game), headers: @headers
+    assert_select ".screen__kicker", text: "Question 2 of 2"
+    assert_select ".game-timer" do |elements|
+      assert_includes 118..120, elements.first["data-remaining-seconds"].to_i
+    end
+  end
+
+  test "GameTimerJob only closes the question it was scheduled for" do
+    quiz = build_quiz(timer_seconds: 5, questions: 2)
+    game = start_game(quiz)
+
+    post start_moderate_game_path(game), headers: @headers
+    game.reload
+    index = game.current_index
+
+    GameTimerJob.perform_now(game.id, index + 1)
+    assert_equal "question", game.reload.state
+
+    GameTimerJob.perform_now(game.id, index)
+    assert_equal "reveal", game.reload.state
+
+    # A manager who finished early and advanced is not affected by the old job.
+    post advance_moderate_game_path(game), headers: @headers
+    game.reload
+    current = game.current_index
+    post finish_moderate_game_path(game), headers: @headers
+    post advance_moderate_game_path(game), headers: @headers
+    GameTimerJob.perform_now(game.id, current)
+    assert_equal "finished", game.reload.state
+  end
+end
