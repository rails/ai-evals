+<%= content_for :title, "Import quiz · Quizzy" %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+
+<div class="page-head">
+  <h1>Import quiz</h1>
+</div>
+
+<div class="card">
+  <% if @errors.any? %>
+    <div class="errors" role="alert">
+      <p>Error: could not import the quiz. Nothing was imported.</p>
+      <ul>
+        <% @errors.each do |message| %>
+          <% context, detail = message.split(": ", 2) %>
+          <li>
+            <% if detail && context.match?(/\AQuestion \d+\z/) %>
+              <span class="error-context"><%= context %>:</span>
+              <span class="error-message"><%= detail %></span>
+            <% else %>
+              <span class="error-message"><%= message %></span>
+            <% end %>
+          </li>
+        <% end %>
+      </ul>
+    </div>
+  <% end %>
+
+  <%= form_with url: moderate_quiz_import_create_path, method: :post do |f| %>
+    <div class="field">
+      <%= f.label :quiz_json, "Quiz JSON", class: "field-label" %>
+      <%= f.text_area :quiz_json, value: @quiz_json, class: "input", rows: 16, autofocus: true %>
+    </div>
+
+    <div class="buttons">
+      <button type="submit" class="btn btn--pink">Import</button>
+      <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+    </div>
+  <% end %>
+</div>
