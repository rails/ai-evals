+require "application_system_test_case"
+
+Capybara.register_driver :quizzy_prize_player_browser do |app|
+  Capybara::Cuprite::Driver.new(
+    app,
+    browser_options: {
+      "no-sandbox" => nil,
+      "disable-dev-shm-usage" => nil,
+      "disable-gpu" => nil
+    },
+    window_size: [ 390, 844 ],
+    process_timeout: 30,
+    timeout: 30
+  )
+end
+
+class PrizesFlowTest < ApplicationSystemTestCase
+  setup do
+    sign_in
+
+    @quiz = Quiz.create!(title: "Prize Browser Quiz", number_of_winners: 3)
+
+    @first = @quiz.questions.create!(text: "Prize first?", active: true, position: 0)
+    @first.options.create!(text: "First right", correct: true, position: 0)
+    @first.options.create!(text: "First wrong", correct: false, position: 1)
+
+    @second = @quiz.questions.create!(text: "Prize second?", active: true, position: 1)
+    @second.options.create!(text: "Second right", correct: true, position: 0)
+    @second.options.create!(text: "Second wrong", correct: false, position: 1)
+  end
+
+  teardown do
+    if defined?(@player) && @player
+      begin
+        @player.driver.quit
+      rescue StandardError
+        nil
+      end
+    end
+  end
+
+  test "winners are drawn and reset live on the big screen and the phones" do
+    visit moderate_quiz_path(@quiz)
+    click_button "Start a game"
+
+    @game = Game.order(:id).last
+    @player = Capybara::Session.new(:quizzy_prize_player_browser, Capybara.app)
+    @player.visit play_path(@game.code)
+    @player.fill_in "Your name", with: "Alice"
+    @player.click_button "Join"
+    @player.assert_text "Hi, Alice!"
+
+    click_button "Start"
+    @player.assert_text "Prize first?"
+    @player.click_button "First right"
+    @player.assert_text "Your answer"
+
+    click_button "Finish"
+    click_button "Next"
+    @player.assert_text "Prize second?"
+    @player.click_button "Second right"
+
+    click_button "Finish"
+    click_button "End quiz"
+
+    assert_text "Leaderboard"
+    assert_text "2 points"
+    @player.assert_text "Place 1 of 1"
+    @player.assert_text "2 points"
+
+    assert_button "Top 3"
+    click_button "Top 3"
+    assert_selector ".leader.is-winner", text: /Alice/
+    assert_text "Winner"
+    @player.assert_text "You won!"
+
+    assert_button "Draw"
+    click_button "Draw"
+    assert_selector ".leader.is-winner", text: /Alice/
+
+    click_button "Reset winners"
+    assert_no_selector ".leader.is-winner"
+    assert_no_text "Winner"
+    @player.assert_no_text "You won!"
+  end
+end
