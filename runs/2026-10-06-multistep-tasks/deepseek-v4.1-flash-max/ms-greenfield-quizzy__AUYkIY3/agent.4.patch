@@ -0,0 +1,121 @@
+require "test_helper"
+
+class GamePrizesIntegrationTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "Prizes Live", number_of_winners: 3)
+    @first = @quiz.questions.create!(text: "First?", active: true, position: 0)
+    @first_right = @first.options.create!(text: "First right", correct: true, position: 0)
+    @first_wrong = @first.options.create!(text: "First wrong", correct: false, position: 1)
+
+    @second = @quiz.questions.create!(text: "Second?", active: true, position: 1)
+    @second_right = @second.options.create!(text: "Second right", correct: true, position: 0)
+    @second_wrong = @second.options.create!(text: "Second wrong", correct: false, position: 1)
+  end
+
+  test "quiz settings show the Number of winners field with a default of 3" do
+    get new_moderate_quiz_path, headers: auth_headers
+
+    assert_response :success
+    assert_select "label[for=quiz_number_of_winners]", text: "Number of winners"
+    assert_select "input#quiz_number_of_winners[type=number][value=?]", "3"
+    assert_select "input#quiz_number_of_winners[min=?]", "1"
+
+    assert_no_difference -> { Quiz.count } do
+      post moderate_quizzes_path, params: { quiz: { title: "Bad", number_of_winners: 0 } }, headers: auth_headers
+    end
+
+    assert_response :unprocessable_entity
+    assert_select ".errors", text: /greater than or equal to 1/
+  end
+
+  test "the finished big screen shows the leaderboard and the winner buttons" do
+    game = @quiz.games.create!
+    alice = game.players.create!(name: "Alice")
+    bob = game.players.create!(name: "Bob")
+    carol = game.players.create!(name: "Carol")
+    game.start_question!(0)
+
+    answer_for(game, alice, @first, @first_right, 100)
+    answer_for(game, bob, @first, @first_right, 200)
+    game.close_question!
+    game.start_question!(1)
+
+    answer_for(game, alice, @second, @second_right, 300)
+    answer_for(game, bob, @second, @second_wrong, 250)
+
+    game.finish!
+
+    get moderate_game_path(game), headers: auth_headers
+
+    assert_response :success
+    assert_select "ol.leaderboard li.leader", count: 3
+    assert_select "li.leader:first-child", text: /Alice/
+    assert_select "li.leader:first-child", text: /2 points/
+    assert_select "li.leader:first-child .leader__place", text: "1"
+    assert_select "li.leader:nth-child(2)", text: /Bob/
+    assert_select "li.leader:nth-child(2)", text: /1 point/
+    assert_select "li.leader:last-child", text: /Carol/
+    assert_select "li.leader:last-child", text: /0 points/
+    assert_select "button", text: "Top 3"
+    assert_select "button", text: "Draw"
+    assert_select "button", text: "Reset winners"
+  end
+
+  test "top N marks the winners on the big screen and on their phones" do
+    game = @quiz.games.create!
+
+    post join_play_path(game.code), params: { name: "Alice" }
+    assert_redirected_to play_path(game.code)
+    alice = game.players.find_by!(name: "Alice")
+    bob = game.players.create!(name: "Bob")
+
+    game.start_question!(0)
+    answer_for(game, alice, @first, @first_right, 100)
+    answer_for(game, bob, @first, @first_right, 200)
+    game.close_question!
+    game.start_question!(1)
+
+    answer_for(game, alice, @second, @second_right, 300)
+    answer_for(game, bob, @second, @second_right, 250)
+
+    game.finish!
+
+    post top_winners_moderate_game_path(game), headers: auth_headers
+    follow_redirect!(headers: auth_headers)
+
+    assert_select "li.leader.is-winner", count: 2
+    assert_select ".leader__badge", text: "Winner", count: 2
+    assert_select "li.leader.is-winner:first-child", text: /Alice/
+
+    get play_path(game.code)
+    assert_response :success
+    assert_select ".result-card__label", text: "Place 1 of 2"
+    assert_select ".result-card__score", text: "2 points"
+    assert_select ".winner-banner", text: /You won!/
+
+    post reset_winners_moderate_game_path(game), headers: auth_headers
+    follow_redirect!(headers: auth_headers)
+
+    assert_select "li.leader.is-winner", count: 0
+    assert_select ".leader__badge", text: "Winner", count: 0
+
+    get play_path(game.code)
+    assert_select ".winner-banner", text: /You won!/, count: 0
+    assert_select ".result-card__label", text: "Place 1 of 2"
+  end
+
+  private
+
+  def answer_for(game, player, question, option, ms)
+    answer = game.answers.find_or_initialize_by(player: player, question: question)
+    answer.game = game
+    answer.option = option
+    answer.save!
+    answer.update_column(:response_time_ms, ms)
+  end
+
+  def auth_headers
+    credentials = ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "quizzy-secret")
+    { "HTTP_AUTHORIZATION" => credentials }
+  end
+end
diff --git a/test/models/game_prizes_test.rb b/test/models/game_prizes_test.rb
new file mode 100644
index 0000000..ec3b722
--- /dev/null
+++ b/test/models/game_prizes_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class GamePrizesTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    @quiz = Quiz.create!(title: "Prize Quiz")
+    @questions = 3.times.map do |index|
+      question = @quiz.questions.create!(text: "Question #{index + 1}?", active: true, position: index)
+      question.options.create!(text: "Right #{index + 1}", correct: true, position: 0)
+      question.options.create!(text: "Wrong #{index + 1}", correct: false, position: 1)
+      question
+    end
+  end
+
+  test "a quiz defaults to 3 winners and requires at least 1" do
+    quiz = Quiz.create!(title: "Default winners")
+
+    assert_equal 3, quiz.number_of_winners
+
+    quiz.number_of_winners = 0
+    assert_not quiz.valid?
+    assert_includes quiz.errors[:number_of_winners], "must be greater than or equal to 1"
+
+    quiz.number_of_winners = 5
+    assert quiz.valid?
+  end
+
+  test "each correct answer is one point and players are ranked by speed" do
+    game, players = started_game_with_players(4)
+    answer(game, players[0], 0, correct: true, ms: 4_000)
+    answer(game, players[0], 1, correct: true, ms: 2_000)
+    answer(game, players[1], 0, correct: true, ms: 1_000)
+    answer(game, players[1], 1, correct: true, ms: 2_000)
+    answer(game, players[2], 0, correct: true, ms: 500)
+    answer(game, players[3], 0, correct: false, ms: 100)
+
+    leaderboard = game.leaderboard
+
+    assert_equal [ players[1], players[0], players[2], players[3] ], leaderboard.map(&:player)
+    assert_equal [ 2, 2, 1, 0 ], leaderboard.map(&:points)
+    assert_equal [ 3_000, 6_000, 500, 0 ], leaderboard.map(&:total_time_ms)
+    assert_equal [ 1, 2, 3, 4 ], leaderboard.map(&:place)
+  end
+
+  test "answer time runs from the moment the question opens to the last pick" do
+    game, players = started_game_with_players(1)
+    player = players.first
+
+    opened_at = game.reload.question_opened_at
+
+    travel_to(opened_at + 2.5.seconds, with_usec: true) do
+      answer = answer(game, player, 0, correct: true)
+      assert_in_delta 2_500, answer.response_time_ms, 100
+    end
+
+    travel_to(opened_at + 5.seconds, with_usec: true) do
+      answer = game.answers.find_by!(player: player, question: @questions.first)
+      answer.option = @questions.first.options.create!(text: "Another right", correct: true, position: 2)
+      answer.save!
+      assert_in_delta 5_000, answer.reload.response_time_ms, 100
+    end
+  end
+
+  test "top N picks the first players and never lets a 0-point player win" do
+    game, players = started_game_with_players(4, number_of_winners: 3)
+    answer(game, players[0], 0, correct: true, ms: 100)
+    answer(game, players[1], 0, correct: true, ms: 200)
+    answer(game, players[2], 0, correct: false, ms: 300)
+
+    game.assign_top_winners!
+
+    assert_equal [ players[0].id, players[1].id ], game.game_winners.order(:player_id).pluck(:player_id)
+  end
+
+  test "if fewer than N players have points all of them win and 0-point players never do" do
+    game, players = started_game_with_players(4, number_of_winners: 3)
+    answer(game, players[0], 0, correct: true, ms: 100)
+    answer(game, players[1], 0, correct: false, ms: 50)
+
+    game.assign_top_winners!
+
+    assert_equal [ players[0].id ], game.game_winners.pluck(:player_id)
+
+    answer(game, players[1], 1, correct: true, ms: 100)
+    game.draw_winners!
+
+    assert_equal players[0..1].map(&:id).sort, game.game_winners.pluck(:player_id).sort
+    refute_includes game.game_winners.pluck(:player_id), players[2].id
+  end
+
+  test "draw picks everybody above the Nth place and fills the rest randomly among the tie" do
+    game, players = started_game_with_players(3, number_of_winners: 2)
+    game.update!(question_opened_at: Time.current) # keep deterministic; exact times are irrelevant here
+
+    # Everybody has one point; the Nth place (2nd) is inside a three-way tie,
+    # so the first of the two prizes is drawn among all three players.
+    players.each { |player| answer(game, player, 0, correct: true, ms: 1_000) }
+
+    game.draw_winners!
+    winner_ids = game.game_winners.pluck(:player_id)
+
+    assert_equal 2, winner_ids.uniq.length
+    assert_empty winner_ids - players.map(&:id)
+    assert game.leaderboard.all? { |entry| entry.points == 1 }
+  end
+
+  test "draw always gives a prize to a player above the Nth-place tie" do
+    game, players = started_game_with_players(4, number_of_winners: 3)
+    answer(game, players[0], 0, correct: true, ms: 100)
+    answer(game, players[0], 1, correct: true, ms: 100)
+    answer(game, players[0], 2, correct: true, ms: 100)
+    answer(game, players[1], 0, correct: true, ms: 200)
+    answer(game, players[2], 0, correct: true, ms: 300)
+    answer(game, players[3], 0, correct: true, ms: 400)
+
+    game.draw_winners!
+
+    winner_ids = game.game_winners.pluck(:player_id)
+    assert_includes winner_ids, players[0].id
+    assert_equal 3, winner_ids.length
+    # Only two of the three players tied on the Nth place can get a prize.
+    assert_equal 2, (winner_ids & players[1..3].map(&:id)).length
+  end
+
+  test "reset winners removes all winner marks" do
+    game, players = started_game_with_players(2, number_of_winners: 1)
+    answer(game, players[0], 0, correct: true, ms: 100)
+    game.assign_top_winners!
+
+    assert_equal 1, game.game_winners.count
+
+    game.reset_winners!
+
+    assert_equal 0, game.game_winners.count
+  end
+
+  private
+
+  def started_game_with_players(count, number_of_winners: 3)
+    @quiz.update!(number_of_winners: number_of_winners)
+    game = @quiz.games.create!
+    game.start_question!(0)
+    players = count.times.map { |index| game.players.create!(name: "Player #{index + 1}") }
+    [ game, players ]
+  end
+
+  def answer(game, player, question_index, correct:, ms: nil)
+    question = @questions[question_index]
+    option = question.options.find_by(correct: correct)
+    answer = game.answers.create!(player: player, question: question, option: option)
+    answer.update_column(:response_time_ms, ms) if ms
+    answer
+  end
+end
