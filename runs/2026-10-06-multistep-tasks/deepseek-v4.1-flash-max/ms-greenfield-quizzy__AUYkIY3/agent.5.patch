diff --git a/docs/NOTES.md b/docs/NOTES.md
index 93bf7e8..5b3762c 100644
--- a/docs/NOTES.md
+++ b/docs/NOTES.md
@@ -269,3 +269,35 @@ The finished big screen shows `The quiz is over`, a `Leaderboard` heading, one
 badge and the `is-winner` class. A player's phone shows `Place X of Y` and
 `N points`; winners additionally see `You won!`. These views update from the
 same Turbo Stage/player stream refreshes as the rest of the live game.
+
+## Question timer
+
+Each quiz has `timer_minutes` / `timer_seconds` (non-negative integers, DB
+defaults 0). The quiz form labels them exactly **Timer minutes** and
+**Timer seconds**; 0:00 means no timer. The total is
+`Quiz#timer_total_seconds` (minutes * 60 + seconds). The timer is a Quizzy
+setting, so `Quiz#export_data` deliberately omits it and imports default to
+0:00.
+
+`Game#start_question!` already persisted `question_opened_at`; the deadline is
+`question_opened_at + quiz.timer_total_seconds`, exposed as
+`question_timer_ends_at`. The big screen renders the current remaining seconds
+as M:SS (`timer_label`) plus `data-timer-ends-at` (epoch milliseconds), but
+only while a question is open. Because the deadline is recomputed from
+persisted data on every render, a reload continues the countdown instead of
+restarting it. Phones never render these attributes.
+
+The included JavaScript (`app/javascript/quizzy.js`) ticks the countdown every
+200 ms and, at 0:00, submits the big screen's `Finish` button (marked
+`data-timer-finish`) through Turbo — exactly the moderator action. As a
+belt-and-braces fallback, every page load / polling endpoint calls
+`Game#close_question_if_timer_expired!`. It performs the deadline comparison as
+part of a conditional SQL update (`status = question_open AND
+question_opened_at <= now - total`), so parallel pollers cannot double-close
+and a stale poller cannot close a question the moderator has already replaced
+with the next one. Auto-close runs the same `close_question!` path (bump both
+versions, broadcast) as the manual button.
+
+Tests: `test/models/game_timer_test.rb`,
+`test/integration/game_timer_test.rb`,
+`test/system/game_timer_flow_test.rb`.
diff --git a/test/integration/game_timer_test.rb b/test/integration/game_timer_test.rb
new file mode 100644
index 0000000..f2f2752
--- /dev/null
+++ b/test/integration/game_timer_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class GameTimerIntegrationTest < ActionDispatch::IntegrationTest
+  setup do
+    @quiz = Quiz.create!(title: "Timed Live Quiz")
+    @first = @quiz.questions.create!(text: "First timed?", active: true, position: 0)
+    @first.options.create!(text: "First right", correct: true, position: 0)
+    @first.options.create!(text: "First wrong", correct: false, position: 1)
+    @second = @quiz.questions.create!(text: "Second timed?", active: true, position: 1)
+    @second.options.create!(text: "Second right", correct: true, position: 0)
+    @second.options.create!(text: "Second wrong", correct: false, position: 1)
+  end
+
+  test "the quiz form exposes the timer fields with their exact labels" do
+    get new_moderate_quiz_path, headers: auth_headers
+
+    assert_select "label", text: "Timer minutes"
+    assert_select "label", text: "Timer seconds"
+    assert_select "input[type=number][name='quiz[timer_minutes]'][value='0']"
+    assert_select "input[type=number][name='quiz[timer_seconds]'][value='0']"
+  end
+
+  test "timer settings are saved with the quiz but kept out of the export" do
+    patch moderate_quiz_path(@quiz),
+      params: { quiz: { title: @quiz.title, number_of_winners: 3, timer_minutes: 1, timer_seconds: 5 } },
+      headers: auth_headers
+
+    @quiz.reload
+    assert_equal 1, @quiz.timer_minutes
+    assert_equal 5, @quiz.timer_seconds
+    assert_equal 65, @quiz.timer_total_seconds
+
+    get export_moderate_quiz_path(@quiz), headers: auth_headers
+    assert_select "pre", text: /"title"/
+    assert_not_includes response.body, "timer"
+  end
+
+  test "the big screen shows an M:SS countdown and the phones never do" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 30)
+    game = @quiz.games.create!
+    post start_moderate_game_path(game), headers: auth_headers
+    follow_redirect!(headers: auth_headers)
+
+    assert_select "[data-question-timer]", text: /\A0:(2[5-9]|30)\z/
+    assert_select "[data-question-timer][data-timer-ends-at]"
+    assert_select "button[data-timer-finish]", text: "Finish"
+
+    post join_play_path(game.code), params: { name: "Alice" }
+    get play_path(game.code)
+    assert_select "[data-question-timer]", count: 0
+    assert_select "[data-timer-ends-at]", count: 0
+    assert_not_includes response.body, "data-question-timer"
+  end
+
+  test "no countdown is rendered when the timer is zero" do
+    game = @quiz.games.create!
+    post start_moderate_game_path(game), headers: auth_headers
+    follow_redirect!(headers: auth_headers)
+
+    assert_select "[data-question-timer]", count: 0
+    assert_select "button", text: "Finish"
+  end
+
+  test "the stage state endpoint finishes an expired question without the browser script" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 20)
+    game = @quiz.games.create!
+    post start_moderate_game_path(game), headers: auth_headers
+    game.update!(question_opened_at: 1.minute.ago)
+
+    get state_play_path(game.code), as: :json
+    payload = JSON.parse(response.body)
+    assert_equal "question_closed", payload["status"]
+    assert_equal "question_closed", game.reload.status
+  end
+
+  test "the moderator state endpoint also finishes an expired question" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 20)
+    game = @quiz.games.create!
+    post start_moderate_game_path(game), headers: auth_headers
+    game.update!(question_opened_at: 1.minute.ago)
+
+    get state_moderate_game_path(game), headers: auth_headers, as: :json
+    payload = JSON.parse(response.body)
+    assert_equal "question_closed", payload["status"]
+  end
+
+  private
+
+  def auth_headers
+    credentials = ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "quizzy-secret")
+    { "HTTP_AUTHORIZATION" => credentials }
+  end
+end
diff --git a/test/models/game_timer_test.rb b/test/models/game_timer_test.rb
new file mode 100644
index 0000000..f296eaa
--- /dev/null
+++ b/test/models/game_timer_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class GameTimerTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Timer Quiz", timer_minutes: 1, timer_seconds: 30)
+    @question = @quiz.questions.create!(text: "Timer question?", active: true, position: 0)
+    @question.options.create!(text: "Right", correct: true, position: 0)
+    @question.options.create!(text: "Wrong", correct: false, position: 1)
+    @game = @quiz.games.create!
+  end
+
+  test "a quiz timer combines minutes and seconds" do
+    assert @quiz.timer?
+    assert_equal 90, @quiz.timer_total_seconds
+
+    @quiz.timer_minutes = 0
+    @quiz.timer_seconds = 0
+    refute @quiz.timer?
+  end
+
+  test "timer settings must be non-negative integers" do
+    quiz = Quiz.new(title: "Bad Timer", timer_minutes: -1, timer_seconds: -1)
+
+    refute quiz.valid?
+    assert quiz.errors[:timer_minutes].any?
+    assert quiz.errors[:timer_seconds].any?
+  end
+
+  test "the countdown is anchored to when the question opened" do
+    travel_to Time.zone.local(2026, 10, 8, 12, 0, 0) do
+      @game.start_question!(0)
+      ends_at = Time.zone.local(2026, 10, 8, 12, 1, 30)
+
+      assert_equal ends_at, @game.reload.question_timer_ends_at
+      assert_equal 90, @game.question_timer_remaining_seconds
+      refute @game.question_timer_expired?
+
+      travel 30.seconds
+      reloaded = @game.reload
+      assert_equal ends_at, reloaded.question_timer_ends_at
+      assert_equal 60, reloaded.question_timer_remaining_seconds
+    end
+  end
+
+  test "an expired question closes itself exactly once" do
+    travel_to Time.zone.local(2026, 10, 8, 12, 0, 0) do
+      @game.start_question!(0)
+
+      travel 89.seconds
+      refute @game.reload.question_timer_expired?
+      assert_not @game.close_question_if_timer_expired!
+      assert_equal Game::STATUS_QUESTION_OPEN, @game.reload.status
+
+      travel 1.second
+      assert @game.reload.question_timer_expired?
+      version = @game.state_version
+
+      assert @game.close_question_if_timer_expired!
+      assert_equal Game::STATUS_QUESTION_CLOSED, @game.reload.status
+      assert_operator @game.state_version, :>, version
+      assert_not @game.close_question_if_timer_expired!
+    end
+  end
+
+  test "a zero timer never closes a question by itself" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    @game.start_question!(0)
+
+    travel 2.hours do
+      reloaded = @game.reload
+      refute reloaded.question_timer_expired?
+      assert_not reloaded.close_question_if_timer_expired!
+      assert_equal Game::STATUS_QUESTION_OPEN, reloaded.reload.status
+    end
+  end
+
+  test "a stale expired poller cannot close the next question" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 10)
+    second = @quiz.questions.create!(text: "Second?", active: true, position: 1)
+    second.options.create!(text: "Second right", correct: true, position: 0)
+    second.options.create!(text: "Second wrong", correct: false, position: 1)
+
+    @game.start_question!(0)
+    stale = Game.find(@game.id)
+
+    @game.close_question!
+    @game.start_question!(1)
+    stale.question_opened_at = 30.seconds.ago
+
+    assert stale.question_timer_expired?
+    assert_not stale.close_question_if_timer_expired!
+    assert_equal Game::STATUS_QUESTION_OPEN, @game.reload.status
+    assert_equal 1, @game.current_question_index
+  end
+end
