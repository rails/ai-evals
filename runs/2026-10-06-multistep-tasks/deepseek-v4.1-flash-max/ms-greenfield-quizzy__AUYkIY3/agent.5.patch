--- a/app/models/game.rb
+++ b/app/models/game.rb
@@ -93,6 +93,60 @@ class Game < ApplicationRecord
     question_open? || question_closed?
   end
 
+  # ----- Question timer -------------------------------------------------------
+
+  def timer?
+    quiz.timer?
+  end
+
+  def timer_total_seconds
+    quiz.timer_total_seconds
+  end
+
+  # The absolute moment the open question runs out, persisted only through
+  # question_opened_at. Re-rendering a page recomputes the same deadline, so a
+  # reload never restarts the countdown.
+  def question_timer_ends_at
+    return nil unless question_open? && timer? && question_opened_at
+
+    question_opened_at + timer_total_seconds
+  end
+
+  def question_timer_remaining_seconds
+    ends_at = question_timer_ends_at
+    return nil unless ends_at
+
+    [ (ends_at - Time.current).ceil, 0 ].max
+  end
+
+  def question_timer_expired?
+    ends_at = question_timer_ends_at
+    ends_at.present? && Time.current >= ends_at
+  end
+
+  # Called from requests that can notice an elapsed deadline (page loads and
+  # the polling endpoints), so the question finishes by itself even if the big
+  # screen JavaScript is interrupted. The conditional update keeps parallel
+  # pollers and the moderator from racing each other.
+  def close_question_if_timer_expired!
+    return false unless question_open? && timer? && question_opened_at
+
+    # Make the deadline check part of the write so a stale poller can never
+    # close a question that was replaced in the meantime (for example when the
+    # moderator already moved on to the next question).
+    deadline = Time.current - timer_total_seconds
+    affected = self.class.where(id: id, status: STATUS_QUESTION_OPEN)
+      .where("question_opened_at <= ?", deadline)
+      .update_all(status: STATUS_QUESTION_CLOSED, updated_at: Time.current)
+    return false unless affected == 1
+
+    reload
+    bump_state!
+    bump_players_state!
+    broadcast_state_change!
+    true
+  end
+
   def players_count
     players.count
   end
