diff --git a/app/javascript/quizzy.js b/app/javascript/quizzy.js
index 17e3050..e48549a 100644
--- a/app/javascript/quizzy.js
+++ b/app/javascript/quizzy.js
@@ -378,3 +378,81 @@
     initializeLive();
   }
 })();
+
+// ---------------------------------------------------------------------------
+// Question timer
+//
+// The deadline is rendered as an absolute epoch timestamp derived from the
+// persisted question_opened_at, so a page reload continues the countdown
+// instead of restarting it. At zero the big screen submits the same Finish
+// form the moderator would click; the server also closes an expired question
+// whenever it is polled, so a question still ends if this script is
+// interrupted.
+// ---------------------------------------------------------------------------
+
+(function () {
+  "use strict";
+
+  var INTERVAL_KEY = "__quizzyQuestionTimer";
+  var FINISHING_KEY = "__quizzyQuestionFinishing";
+
+  function timerNode() {
+    return document.querySelector("[data-question-timer]");
+  }
+
+  function formatCountdown(totalSeconds) {
+    var seconds = Math.max(0, totalSeconds);
+    var minutes = Math.floor(seconds / 60);
+    var rest = seconds % 60;
+    return minutes + ":" + (rest < 10 ? "0" + rest : String(rest));
+  }
+
+  function finishQuestion(node) {
+    if (window[FINISHING_KEY]) return;
+
+    var button = document.querySelector("[data-timer-finish]");
+    if (!button || !button.form) return;
+
+    window[FINISHING_KEY] = true;
+    node.dataset.timerFinished = "true";
+
+    if (typeof button.form.requestSubmit === "function") {
+      button.form.requestSubmit(button);
+    } else {
+      button.click();
+    }
+  }
+
+  function tick() {
+    var node = timerNode();
+    if (!node) return;
+
+    var endsAt = parseInt(node.dataset.timerEndsAt || "", 10);
+    if (isNaN(endsAt)) return;
+
+    var remaining = Math.max(0, Math.ceil((endsAt - Date.now()) / 1000));
+    node.textContent = formatCountdown(remaining);
+
+    if (remaining === 0) finishQuestion(node);
+  }
+
+  function initializeTimer() {
+    if (window[INTERVAL_KEY]) {
+      window.clearInterval(window[INTERVAL_KEY]);
+      window[INTERVAL_KEY] = null;
+    }
+    window[FINISHING_KEY] = false;
+
+    if (!timerNode()) return;
+
+    tick();
+    window[INTERVAL_KEY] = window.setInterval(tick, 200);
+  }
+
+  document.addEventListener("turbo:load", initializeTimer);
+  if (document.readyState === "loading") {
+    document.addEventListener("DOMContentLoaded", initializeTimer, { once: true });
+  } else {
+    initializeTimer();
+  }
+})();
