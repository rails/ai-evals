+require "application_system_test_case"
+
+class GameTimerFlowTest < ApplicationSystemTestCase
+  setup do
+    sign_in
+
+    @quiz = Quiz.create!(title: "Timer Browser Quiz", timer_minutes: 0, timer_seconds: 6)
+    @first = @quiz.questions.create!(text: "Timed first?", active: true, position: 0)
+    @first.options.create!(text: "First right", correct: true, position: 0)
+    @first.options.create!(text: "First wrong", correct: false, position: 1)
+    @second = @quiz.questions.create!(text: "Timed second?", active: true, position: 1)
+    @second.options.create!(text: "Second right", correct: true, position: 0)
+    @second.options.create!(text: "Second wrong", correct: false, position: 1)
+  end
+
+  test "the countdown ticks on the big screen and finishes the question at zero" do
+    visit moderate_quiz_path(@quiz)
+    click_button "Start a game"
+    click_button "Start"
+
+    assert_text "Timed first?"
+    assert_selector "[data-question-timer]", text: /\A0:0[1-6]\z/
+    assert_button "Finish"
+
+    assert_button "Next", wait: 12
+    assert_no_button "Finish"
+    assert_selector ".stage-options--results .stage-option.is-correct", text: /First right/
+  end
+
+  test "reloading the big screen continues the countdown instead of restarting it" do
+    @quiz.update!(timer_seconds: 30)
+
+    visit moderate_quiz_path(@quiz)
+    click_button "Start a game"
+    click_button "Start"
+
+    assert_selector "[data-question-timer]", text: /\A0:(2[7-9]|30)\z/
+    sleep 2
+    refresh
+
+    assert_selector "[data-question-timer]", text: /\A0:2[0-8]\z/
+    assert_no_text "0:30"
+
+    click_button "Finish"
+    assert_button "Next"
+  end
+end
