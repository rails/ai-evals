+<div class="play__body play__body--top">
+  <% if @game.waiting? %>
+    <div class="waiting">
+      <div class="waiting__gem">?</div>
+      <h1 class="play-title">You're in!</h1>
+      <p class="play-lead">Waiting for the quiz to start...</p>
+    </div>
+  <% elsif @current_question && @game.question_open? %>
+    <div class="play-question__num">Question <%= @game.current_question_number %> of <%= @game.total_questions %></div>
+    <div class="play-question__body"><%= @current_question.text %></div>
+
+    <% answered_option_id = @player_answer&.option_id %>
+    <ul class="play-options">
+      <% @current_question.options.each_with_index do |option, index| %>
+        <li>
+          <%= button_to answer_play_path(@game.code),
+                { params: { option_id: option.id },
+                  class: "play-option #{'is-picked' if answered_option_id == option.id}",
+                  aria: { label: option.text } } do %>
+            <span class="play-option__letter"><%= option_letter(index) %></span>
+            <span class="play-option__title"><%= option.text %></span>
+            <% if answered_option_id == option.id %><span class="play-option__mark">Your answer</span><% end %>
+          <% end %>
+        </li>
+      <% end %>
+    </ul>
+  <% elsif @current_question && @game.question_closed? %>
+    <div class="play-question__num">Question <%= @game.current_question_number %> of <%= @game.total_questions %></div>
+    <div class="play-question__body"><%= @current_question.text %></div>
+
+    <% answered_option_id = @player_answer&.option_id %>
+    <% result = player_result(@player_answer) %>
+    <ul class="play-options is-locked is-revealed">
+      <% @current_question.options.each_with_index do |option, index| %>
+        <li>
+          <button type="button"
+                  class="play-option <%= 'is-picked' if answered_option_id == option.id %> <%= 'is-correct' if option.correct? %>"
+                  aria-label="<%= option.text %>"
+                  disabled>
+            <span class="play-option__letter"><%= option_letter(index) %></span>
+            <span class="play-option__title"><%= option.text %></span>
+            <% if option.correct? %><span class="play-option__mark">Correct</span><% end %>
+            <% if answered_option_id == option.id %><span class="play-option__mark">Your answer</span><% end %>
+          </button>
+        </li>
+      <% end %>
