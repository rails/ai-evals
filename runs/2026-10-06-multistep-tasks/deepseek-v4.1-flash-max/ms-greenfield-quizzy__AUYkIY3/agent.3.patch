diff --git a/app/javascript/quizzy.js b/app/javascript/quizzy.js
index 1d9a2f0..315beac 100644
--- a/app/javascript/quizzy.js
+++ b/app/javascript/quizzy.js
@@ -250,3 +250,119 @@
     initializePreview();
   }
 })();
+
+// ---------------------------------------------------------------------------
+// Live game updates
+//
+// Turbo stream sources push refreshes over websockets. To close the gap
+// between loading a page and the websocket subscription being confirmed (and
+// to survive a broken websocket), every live page also watches a tiny state
+// endpoint: right after a subscription connects and, while no subscription is
+// connected, on a slow interval. When the game version moves on, Turbo visits
+// the page again, so the client stays up to date without a full reload.
+// ---------------------------------------------------------------------------
+
+(function () {
+  "use strict";
+
+  var REFRESHING_KEY = "__quizzyRefreshing";
+  var TIMER_KEY = "__quizzyLiveTimer";
+  var OBSERVER_KEY = "__quizzyLiveObserver";
+  var CHECKED_CONNECTIONS_KEY = "__quizzyCheckedConnections";
+
+  function liveNode() {
+    return document.querySelector("[data-live]");
+  }
+
+  function cableSources() {
+    return Array.prototype.slice.call(document.querySelectorAll("turbo-cable-stream-source"));
+  }
+
+  function cableConnected() {
+    return cableSources().some(function (source) {
+      return source.hasAttribute("connected");
+    });
+  }
+
+  function refreshPage() {
+    if (window[REFRESHING_KEY]) return;
+
+    window[REFRESHING_KEY] = true;
+    if (window.Turbo) {
+      window.Turbo.visit(window.location.href, { action: "replace" });
+    } else {
+      window.location.reload();
+    }
+
+    window.setTimeout(function () {
+      window[REFRESHING_KEY] = false;
+    }, 5000);
+  }
+
+  function checkVersion() {
+    var node = liveNode();
+    if (!node || !node.dataset.stateUrl || !window.fetch || window[REFRESHING_KEY]) return;
+
+    var stateUrl = node.dataset.stateUrl;
+    var version = String(node.dataset.version || "");
+
+    fetch(stateUrl, {
+      credentials: "same-origin",
+      headers: { "Accept": "application/json" },
+      cache: "no-store"
+    }).then(function (response) {
+      return response.ok ? response.json() : null;
+    }).then(function (data) {
+      if (data && String(data.version) !== version) refreshPage();
+    }).catch(function () {
+      // Network hiccup: the next check tries again.
+    });
+  }
+
+  function watchConnections() {
+    if (window[OBSERVER_KEY]) window[OBSERVER_KEY].disconnect();
+
+    if (!window.MutationObserver) return;
+
+    window[OBSERVER_KEY] = new MutationObserver(function (mutations) {
+      mutations.forEach(function (mutation) {
+        var source = mutation.target;
+        if (!source.hasAttribute("connected")) return;
+
+        // A broadcast may have been missed while the subscription was down.
+        checkVersion();
+      });
+    });
+
+    cableSources().forEach(function (source) {
+      window[OBSERVER_KEY].observe(source, { attributes: true, attributeFilter: [ "connected" ] });
+    });
+  }
+
+  function initializeLive() {
+    if (window[TIMER_KEY]) {
+      window.clearInterval(window[TIMER_KEY]);
+      window[TIMER_KEY] = null;
+    }
+    window[REFRESHING_KEY] = false;
+
+    var node = liveNode();
+    if (!node || !node.dataset.stateUrl) return;
+
+    watchConnections();
+
+    // Cable confirmed before this page started checking? Check once.
+    if (cableConnected()) checkVersion();
+
+    window[TIMER_KEY] = window.setInterval(function () {
+      if (!cableConnected()) checkVersion();
+    }, 1500);
+  }
+
+  document.addEventListener("turbo:load", initializeLive);
+  if (document.readyState === "loading") {
+    document.addEventListener("DOMContentLoaded", initializeLive, { once: true });
+  } else {
+    initializeLive();
+  }
+})();
