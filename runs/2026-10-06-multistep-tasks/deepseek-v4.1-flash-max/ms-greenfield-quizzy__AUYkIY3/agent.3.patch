diff --git a/app/views/moderate/games/show.html.erb b/app/views/moderate/games/show.html.erb
new file mode 100644
index 0000000..7425145
--- /dev/null
+++ b/app/views/moderate/games/show.html.erb
@@ -0,0 +1,88 @@
+<% content_for :title, "#{@quiz.title} · Quizzy" %>
+<section class="cover cover--blue cover--calm">
+  <div class="screen"
+       data-live
+       data-state-url="<%= state_play_path(@game.code) %>"
+       data-version="<%= @game.state_version %>">
+    <%= turbo_stream_from @game, :stage %>
+
+    <div class="screen__top">
+      <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span><%= @quiz.title %></span>
+    </div>
+
+    <div class="screen__body">
+      <% if @game.finished? %>
+        <div class="waiting">
+          <div class="waiting__gem">?</div>
+          <h1 class="lobby__title">The quiz is over</h1>
+        </div>
+      <% elsif @game.waiting? %>
+        <div class="lobby">
+          <div>
+            <h1 class="lobby__title"><%= @quiz.title %></h1>
+            <div class="lobby__join">Join the quiz at</div>
+            <%= link_to join_url_for(@game), join_href_for(@game), class: "lobby__url" %>
+            <div class="counter-pill" data-players-counter>Players: <%= @game.players_count %></div>
+          </div>
+          <div class="qr" aria-label="QR code for <%= join_url_for(@game) %>" data-join-url="<%= join_href_for(@game) %>">
+            <%= qr_code_svg(join_url_for(@game)) %>
+          </div>
+        </div>
+      <% elsif @current_question && @game.question_closed? %>
+        <div class="stage-question__num">Question <%= @game.current_question_number %> of <%= @game.total_questions %></div>
+        <div class="stage-question__body"><%= @current_question.text %></div>
+        <ol class="stage-options stage-options--results">
+          <% @current_question.options.each_with_index do |option, index| %>
+            <li class="stage-option <%= "is-correct" if option.correct? %>">
+              <span class="stage-option__letter"><%= option_letter(index) %></span>
+              <span class="stage-option__title"><%= option.text %></span>
+              <span class="stage-option__count"><%= pluralize(@option_counts[option.id] || 0, "answer") %></span>
+              <% if option.correct? %><span class="stage-option__mark">Correct</span><% end %>
+            </li>
+          <% end %>
+        </ol>
+      <% elsif @current_question %>
+        <div class="stage-question__num">Question <%= @game.current_question_number %> of <%= @game.total_questions %></div>
+        <div class="stage-question__body"><%= @current_question.text %></div>
+        <ol class="stage-options">
+          <% @current_question.options.each_with_index do |option, index| %>
+            <li class="stage-option">
+              <span class="stage-option__letter"><%= option_letter(index) %></span>
+              <span class="stage-option__title"><%= option.text %></span>
+            </li>
+          <% end %>
+        </ol>
+      <% else %>
+        <div class="stage-question__num">Ready</div>
+        <div class="stage-question__body">No active questions</div>
+      <% end %>
+    </div>
+
+    <div class="screen-controls">
+      <div class="screen-controls__info">
+        <% if @game.in_progress? %>
+          <span class="answers-counter">Players: <%= @game.players_count %></span>
+          <span class="join-hint">Join: <%= link_to join_url_for(@game), join_href_for(@game) %></span>
+        <% end %>
+        <% if @game.question_open? && @current_question %>
+          <span class="answers-counter" data-answers-counter>Answers: <%= @game.answered_players_count(@current_question) %> / <%= @game.players_count %></span>
+        <% end %>
+      </div>
+      <div class="buttons">
+        <% if @game.waiting? && @game.total_questions.positive? %>
+          <%= button_to "Start", start_moderate_game_path(@game), method: :post, class: "btn btn--pink btn--lg" %>
+        <% elsif @game.question_open? %>
