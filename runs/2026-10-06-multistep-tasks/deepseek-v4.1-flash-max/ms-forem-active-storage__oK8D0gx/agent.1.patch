diff --git a/app/models/concerns/profile_image_attachable.rb b/app/models/concerns/profile_image_attachable.rb
new file mode 100644
index 0000000..a4513a0
--- /dev/null
+++ b/app/models/concerns/profile_image_attachable.rb
@@ -0,0 +1,215 @@
+require "net/http"
+
+# Adds Active Storage backed profile images to a model while keeping the
+# CarrierWave backed images that were uploaded before the migration visible.
+#
+# New uploads are assigned to the Active Storage +profile_image+ attachment.
+# The pre-existing CarrierWave identifier stays in the model's +profile_image+
+# column and is exposed through the +carrierwave_profile_image+ uploader. This
+# way a profile image uploaded before the deployment remains readable until it
+# is replaced.
+module ProfileImageAttachable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one_attached :profile_image
+
+    # The legacy CarrierWave uploader keeps writing to the original
+    # +profile_image+ column. It is intentionally mounted under a different
+    # name so the Active Storage attachment can own +profile_image+.
+    mount_uploader :carrierwave_profile_image, LegacyProfileImageUploader, mount_on: :profile_image
+
+    after_save :track_active_storage_profile_image_change, prepend: true
+    after_commit :clear_active_storage_profile_image_change, on: :create
+
+    validate :profile_image_size, if: :active_storage_profile_image_attached?
+    validate :profile_image_extension, if: :active_storage_profile_image_attached?
+  end
+
+  def profile_image=(attachable)
+    @pending_active_storage_profile_image_url = nil
+    if attachable.is_a?(String) && attachable.present?
+      if ActiveStorage.verifier.valid_message?(attachable)
+        assign_active_storage_profile_image(attachable)
+      elsif attachable.match?(%r{\Ahttps?://}i)
+        self.remote_profile_image_url = attachable
+      else
+        # Preserve historical behavior for cache names and other legacy
+        # values that are neither files nor signed Active Storage blobs.
+        self.carrierwave_profile_image = attachable
+      end
+    else
+      assign_active_storage_profile_image(attachable)
+    end
+  end
+
+  # Use the profile image URL when JSON serialization asks for the raw
+  # +profile_image+ attribute. Otherwise Active Storage's attachment proxy
+  # would be serialized (and recursively serialize the record).
+  def read_attribute_for_serialization(attribute)
+    return profile_image_url if attribute.to_s == "profile_image"
+
+    super
+  end
+
+  # A URL for whichever image a profile currently uses. Active Storage wins
+  # whenever it has an attachment; otherwise we fall back to the CarrierWave
+  # file that was stored before the migration.
+  def profile_image_url
+    if profile_image.attached?
+      active_storage_profile_image_url
+    else
+      carrierwave_profile_image_url
+    end
+  end
+
+  def legacy_profile_image_url
+    carrierwave_profile_image.presence&.url
+  end
+
+  def remote_profile_image_url
+    @remote_profile_image_url
+  end
+
+  def remote_profile_image_url=(url)
+    @pending_active_storage_profile_image_url = nil
+    @remote_profile_image_url = url
+    return if url.blank?
+
+    # Non-URL values (for example a generated fallback file) are attached
+    # directly.
+    unless url.is_a?(String)
+      assign_active_storage_profile_image(url)
+      return
+    end
+
+    if local_asset_url?(url)
+      assign_active_storage_profile_image(nil)
+      self.carrierwave_profile_image = nil
+      return
+    end
+
+    # Let CarrierWave handle the download (and its SSRF protections), then move
+    # the downloaded file into Active Storage and clear the temporary
+    # CarrierWave identifier so no legacy copy is persisted.
+    self.remote_carrierwave_profile_image_url = url
+    downloaded_file = carrierwave_profile_image.file
+
+    self.profile_image = if downloaded_file.present?
+                           {
+                             io: downloaded_file.to_file,
+                             filename: downloaded_file.filename,
+                             content_type: downloaded_file.content_type
+                           }
+                         else
+                           remote_profile_image_attributes(url)
+                         end
+    self.carrierwave_profile_image = nil
+  end
+
+  private
+
+  def active_storage_profile_image_url
+    blob = profile_image.blob
+    if blob&.persisted?
+      routes.rails_blob_url(blob, **Rails.application.routes.default_url_options)
+    else
+      # Pending attachments cannot be addressed by signed blob id yet. Use the
+      # storage service directly so URLs can still be generated for unsaved
+      # records (for example, stubbed models).
+      @pending_active_storage_profile_image_url ||=
+        with_active_storage_url_options { profile_image.url }
+    end
+  end
+
+  def routes
+    Rails.application.routes.url_helpers
+  end
+
+  def with_active_storage_url_options
+    previous_options = ActiveStorage::Current.url_options
+    ActiveStorage::Current.url_options = Rails.application.routes.default_url_options
+    yield
+  ensure
+    ActiveStorage::Current.url_options = previous_options
+  end
+
+  def local_asset_url?(url)
+    uri = URI.parse(url)
+    return true if uri.host.blank?
+
+    local_hosts = [
+      Rails.application.config.app_domain,
+      Rails.application.routes.default_url_options[:host],
+    ].compact.map { |host| host.to_s.split(":").first }
+    local_hosts.include?(uri.host) || %w[localhost 127.0.0.1].include?(uri.host)
+  rescue URI::InvalidURIError
+    false
+  end
+
+  def remote_profile_image_attributes(url)
+    uri = URI.parse(url)
+    response = Net::HTTP.get_response(uri)
+    raise CarrierWave::DownloadError, "Could not download profile image" unless response.is_a?(Net::HTTPSuccess)
+
+    filename = File.basename(uri.path.presence || "profile_image")
+    tempfile = Tempfile.new([File.basename(filename, ".*"), File.extname(filename)])
+    tempfile.binmode
+    tempfile.write(response.body.to_s)
+    tempfile.rewind
+    { io: tempfile, filename: filename, content_type: response["Content-Type"] }
+  end
+
+  def active_storage_profile_image_attached?
+    attachment = profile_image
+    attachment.respond_to?(:attached?) && attachment.attached?
+  end
+
+  def profile_image_extension
+    blob = profile_image.attachment&.blob
+    return if blob.blank?
+
+    extension = File.extname(blob.filename.to_s).delete_prefix(".").downcase
+    allowlist = BaseUploader::EXTENSION_ALLOWLIST
+    return if allowlist.any? { |allowed| extension.match?(/\A#{allowed}\z/i) }
+
+    errors.add(:profile_image,
+               I18n.t("errors.messages.extension_allowlist_error",
+                      extension: extension.inspect, allowed_types: allowlist.join(", ")))
+  end
+
+  def profile_image_size
+    blob = profile_image.attachment&.blob
+    return if blob.blank?
+
+    max_size = ProfileImageUploader::MAX_FILE_SIZE
+    return if blob.byte_size <= max_size
+
+    human_max_size = ActiveSupport::NumberHelper.number_to_human_size(max_size)
+    errors.add(:profile_image, I18n.t("errors.messages.max_size_error", max_size: human_max_size))
+  end
+
+  def assign_active_storage_profile_image(attachable)
+    attachment_changes["profile_image"] =
+      if attachable.nil? || attachable == ""
+        ActiveStorage::Attached::Changes::DeleteOne.new("profile_image", self)
+      else
+        ActiveStorage::Attached::Changes::CreateOne.new("profile_image", self, attachable)
+      end
+  end
+
+  # Active Storage does not touch the model's +profile_image+ column, so we
+  # need to remember whether an attachment changed for callbacks that need to
+  # detect a new/different profile image (cache busting, social images, …).
+  def track_active_storage_profile_image_change
+    @active_storage_profile_image_changed = attachment_changes["profile_image"].present?
+  end
+
+  def active_storage_profile_image_changed?
+    @active_storage_profile_image_changed.present?
+  end
+
+  def clear_active_storage_profile_image_change
+    @active_storage_profile_image_changed = false
+  end
+end
