diff --git a/app/uploaders/legacy_profile_image_uploader.rb b/app/uploaders/legacy_profile_image_uploader.rb
new file mode 100644
index 0000000..eb192f3
--- /dev/null
+++ b/app/uploaders/legacy_profile_image_uploader.rb
@@ -0,0 +1,12 @@
+# Uploader used while reading the CarrierWave profile images that were stored
+# before profile images moved to Active Storage.
+#
+# The accessor is mounted as +carrierwave_profile_image+ (writing to the
+# original +profile_image+ column), so the inherited +store_dir+ would point
+# at a new path. Existing files must stay where they are until they are
+# replaced, so this uploader keeps using the historical directory layout.
+class LegacyProfileImageUploader < ProfileImageUploader
+  def store_dir
+    "uploads/#{model.class.to_s.underscore}/profile_image/#{model.id}"
+  end
+end
