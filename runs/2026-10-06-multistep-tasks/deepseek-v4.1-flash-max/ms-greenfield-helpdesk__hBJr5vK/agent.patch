+    verify_signup_email(subdomain: "globex", email: "jo@globex.test")
+
+    # Reusing the same email in another business is allowed.
+    post "/api/v1/account/create",
+         params: { account: { name: "Initech", subdomain: "initech",
+                              admin: { name: "Jo", email: "jo@acme.test",
+                                       password: "initech-password" } } },
+         headers: json_headers, as: :json
