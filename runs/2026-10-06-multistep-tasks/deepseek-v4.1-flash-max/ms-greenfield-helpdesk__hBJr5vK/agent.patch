diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..6497b5b
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,166 @@
+require "digest"
+
+class Invitation < ApplicationRecord
+  ROLES = %w[admin agent].freeze
+  STATUSES = %w[pending accepted revoked expired].freeze
+  TOKEN_TTL = 7.days
+
+  belongs_to :account
+  belongs_to :invited_by, class_name: "User", optional: true
+
+  before_validation :normalize_email
+  before_validation :ensure_token, on: :create
+  before_validation :ensure_expiry, on: :create
+
+  validates :email,
+            presence: true,
+            format: { with: URI::MailTo::EMAIL_REGEXP },
+            uniqueness: {
+              scope: :account_id,
+              case_sensitive: false,
+              conditions: -> { where(status: "pending") },
+              message: "already has a pending invitation"
+            }
+  validates :role, inclusion: { in: ROLES }
+  validates :status, inclusion: { in: STATUSES }
+  validates :token_digest, presence: true, uniqueness: true
+  validates :expires_at, presence: true
+
+  scope :ordered, -> { order(id: :asc) }
+  scope :pending, -> { where(status: "pending").where("expires_at > ?", Time.current) }
+  scope :expired, lambda {
+    where(status: "expired").or(where(status: "pending").where("expires_at <= ?", Time.current))
+  }
+  scope :accepted, -> { where(status: "accepted") }
+  scope :revoked, -> { where(status: "revoked") }
+  scope :stale, -> { where(status: "pending").where("expires_at <= ?", Time.current) }
+  scope :for_email, ->(email) { where("LOWER(email) = ?", email.to_s.strip.downcase) }
+
+  # Status is derived for records that are still "pending" in the database
+  # but whose expiry has passed, so callers always see expired invitations.
+  def status
+    return "expired" if self[:status] == "pending" && expires_at.present? && expires_at <= Time.current
+
+    self[:status]
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def accepted?
+    self[:status] == "accepted"
+  end
+
+  def revoked?
+    self[:status] == "revoked"
+  end
+
+  def expired?
+    status == "expired"
+  end
+
+  def resendable?
+    pending? || expired?
+  end
+
+  def self.digest(raw_token)
+    Digest::SHA256.hexdigest(raw_token.to_s)
+  end
+
+  def self.with_status(value)
+    case value.to_s
+    when "pending" then pending
+    when "expired" then expired
+    when "accepted" then accepted
+    when "revoked" then revoked
+    else all
+    end
+  end
+
+  # Creates an invitation and returns it. The raw token is available through
+  # #raw_token so the caller can email the acceptance link.
+  def self.issue!(account:, email:, role:, invited_by: nil)
+    raw_token = SecureRandom.urlsafe_base64(32)
+    invitation = account.invitations.create!(
+      email: email,
+      role: role,
+      invited_by: invited_by,
+      token_digest: digest(raw_token),
+      status: "pending",
+      expires_at: TOKEN_TTL.from_now
+    )
+    invitation.instance_variable_set(:@raw_token, raw_token)
+    invitation
+  end
+
+  # Finds a usable (still pending and not expired) invitation by raw token.
+  def self.authenticate(raw_token)
+    return nil if raw_token.blank?
+
+    invitation = find_by(token_digest: digest(raw_token))
+    return nil if invitation.nil? || !invitation.pending?
+
+    invitation
+  end
+
+  attr_reader :raw_token
+
+  # Refreshes an expired or pending invitation: new token, new expiry and a
+  # fresh email. Returns false for accepted or revoked invitations.
+  def resend!
+    return false unless resendable?
+
+    raw_token = SecureRandom.urlsafe_base64(32)
+    update!(
+      token_digest: self.class.digest(raw_token),
+      status: "pending",
+      expires_at: TOKEN_TTL.from_now
+    )
+    @raw_token = raw_token
+    true
+  end
+
+  def accept!(name:, password:)
+    return nil unless pending?
+
+    user = nil
+    transaction do
+      user = account.users.create!(
+        name: name,
+        email: email,
+        password: password,
+        role: role,
+        verified: true,
+        verified_at: Time.current,
+        verification_token_digest: nil,
+        verification_sent_at: nil
+      )
+      update!(status: "accepted", accepted_at: Time.current)
+    end
+    user
+  end
+
+  # Marks every lapsed pending invitation as expired so status filters and
+  # unique pending invitations stay accurate.
+  def self.expire_stale!
+    stale.update_all(status: "expired", updated_at: Time.current)
+  end
+
+  private
+
+  def normalize_email
+    self.email = email.to_s.strip.downcase if email.present?
+  end
+
+  def ensure_token
+    return if token_digest.present?
+
+    @raw_token = SecureRandom.urlsafe_base64(32)
+    self.token_digest = self.class.digest(@raw_token)
+  end
+
+  def ensure_expiry
+    self.expires_at ||= TOKEN_TTL.from_now
+  end
+end
diff --git a/app/models/password_reset.rb b/app/models/password_reset.rb
new file mode 100644
index 0000000..7145b2a
--- /dev/null
+++ b/app/models/password_reset.rb
@@ -0,0 +1,46 @@
+require "digest"
+
+class PasswordReset < ApplicationRecord
+  TOKEN_TTL = 2.hours
+
+  belongs_to :account
+  belongs_to :user
+
+  validates :token_digest, presence: true, uniqueness: true
+  validates :expires_at, presence: true
+
+  def self.digest(raw_token)
+    Digest::SHA256.hexdigest(raw_token.to_s)
+  end
+
+  # Issues a new reset token, invalidating any outstanding one for the user.
+  def self.issue!(user)
+    raw_token = SecureRandom.urlsafe_base64(32)
+    transaction do
+      user.password_resets.where(used_at: nil).delete_all
+      user.password_resets.create!(
+        account: user.account,
+        token_digest: digest(raw_token),
+        expires_at: TOKEN_TTL.from_now
+      )
+    end
+    raw_token
+  end
+
+  def self.authenticate(raw_token)
+    return nil if raw_token.blank?
+
+    reset = find_by(token_digest: digest(raw_token))
+    return nil if reset.nil? || !reset.usable?
+
+    reset
+  end
+
+  def usable?
+    used_at.nil? && expires_at > Time.current
+  end
+
+  def consume!
+    update!(used_at: Time.current)
+  end
+end
diff --git a/app/models/request.rb b/app/models/request.rb
new file mode 100644
index 0000000..87ef887
--- /dev/null
+++ b/app/models/request.rb
@@ -0,0 +1,225 @@
+class Request < ApplicationRecord
+  STATUSES = %w[open pending solved].freeze
+  CLOSED_STATUS = "closed"
+  # Closed tickets can no longer be updated, but lists can still filter for
+  # them so staff and customers can revisit merged conversations.
+  FILTERABLE_STATUSES = (STATUSES + [ CLOSED_STATUS ]).freeze
+  PRIORITIES = %w[normal high].freeze
+
+  belongs_to :account
+  belongs_to :requester, class_name: "User"
+  belongs_to :assignee, class_name: "User", optional: true, inverse_of: :assigned_tickets
+  belongs_to :group, optional: true
+  belongs_to :merged_into, class_name: "Request", optional: true, inverse_of: :merged_sources
+  has_many :comments, dependent: :destroy
+  has_many :inbound_deliveries, dependent: :destroy
+  has_many :merged_sources, class_name: "Request", foreign_key: :merged_into_id,
+                            dependent: :nullify, inverse_of: :merged_into
+
+  validates :subject, presence: true
+  validates :status, inclusion: { in: FILTERABLE_STATUSES }
+  validates :priority, inclusion: { in: PRIORITIES }
+  validates :reply_token, presence: true, uniqueness: true
+  validates :email_origin, inclusion: { in: [ true, false ] }
+
+  validate :group_belongs_to_account
+  validate :assignee_belongs_to_group
+  validate :merged_into_belongs_to_same_customer
+
+  before_validation :inherit_account_from_requester
+  before_validation :inherit_group_from_assignee, if: :assignee_without_group?
+  before_validation :normalize_group_assignee, if: :group_id_changed?
+  before_validation :ensure_reply_token, on: :create
+
+  # Requests a customer has just replied to should appear first.
+  scope :recently_active, -> { order(updated_at: :desc, id: :desc) }
+
+  # Case-insensitive free-text search across subjects and public comments.
+  # The query is escaped so LIKE wildcards typed by the user (% and _) are
+  # treated as literal characters rather than as patterns. Private notes are
+  # deliberately excluded.
+  scope :matching_text, ->(query) {
+    pattern = "%#{sanitize_sql_like(query.to_s.strip)}%"
+    where(
+      "requests.subject ILIKE :pattern OR EXISTS (" \
+      "SELECT 1 FROM comments " \
+      "WHERE comments.request_id = requests.id " \
+      "AND comments.public = TRUE " \
+      "AND comments.body ILIKE :pattern)",
+      pattern: pattern
+    )
+  }
+
+  # The private address a customer replies to so their message is attached to
+  # this conversation instead of opening a new ticket.
+  def group_name
+    group&.name
+  end
+
+  def closed?
+    status == CLOSED_STATUS
+  end
+
+  def merged?
+    merged_into_id.present?
+  end
+
+  def reply_address
+    return if reply_token.blank?
+
+    SupportAddress.reply_address(reply_token)
+  end
+  alias email_reply_address reply_address
+  alias inbound_email_address reply_address
+  alias private_reply_address reply_address
+
+  def email_ticket?
+    email_origin?
+  end
+
+  def source
+    email_origin? ? "email" : "portal"
+  end
+  alias origin source
+
+  def source=(value)
+    self.email_origin = value.to_s.downcase == "email" || value == true
+  end
+
+  def origin=(value)
+    self.source = value
+  end
+
+  def email?
+    email_origin?
+  end
+
+  def from_email?
+    email_origin?
+  end
+
+  def inbound?
+    email_origin?
+  end
+
+  def message_id
+    email_message_id
+  end
+
+  def inbound_message_id
+    email_message_id
+  end
+
+  def inbound_message_id=(value)
+    self.email_message_id = value
+  end
+
+  def email_token
+    reply_token
+  end
+
+  def inbound_token
+    reply_token
+  end
+
+  def email_token=(value)
+    self.reply_token = value
+  end
+
+  def inbound_token=(value)
+    self.reply_token = value
+  end
+
+  def message_id=(value)
+    self.email_message_id = value
+  end
+
+  def reply_email
+    reply_address
+  end
+  alias email_address reply_address
+  alias reply_to_address reply_address
+  alias reply_to reply_address
+  alias email_reply_to reply_address
+  alias inbound_address reply_address
+  alias inbound_email reply_address
+
+  def support_address
+    account&.support_email_address
+  end
+  alias business_address support_address
+  alias support_email_address support_address
+  alias account_support_address support_address
+
+  private
+
+  def inherit_account_from_requester
+    self.account ||= requester&.account
+  end
+
+  def assignee_without_group?
+    return false unless group_id.nil? && assignee_id_changed? && assignee.present?
+
+    # An explicit move to "no group" clears the assignee; only a plain
+    # assignee change on an already-ungrouped ticket inherits their default.
+    !(group_id_changed? && group_id_was.present?)
+  end
+
+  # Assigning someone to an ungrouped ticket puts the ticket in the staff
+  # member's default department when they have one.
+  def inherit_group_from_assignee
+    self.group = assignee.default_group
+  end
+
+  # Clearing the group clears the assignee, and moving a ticket to another
+  # group clears an existing assignee who does not belong there. An
+  # explicitly supplied assignee is left for the validator to reject.
+  def normalize_group_assignee
+    if group.nil?
+      self.assignee = nil if group_id_was.present?
+    elsif assignee_id.present? && !GroupMembership.exists?(group_id: group_id, user_id: assignee_id)
+      self.assignee = nil unless assignee_id_changed?
+    end
+  end
+
+  def group_belongs_to_account
+    return if group.nil? || account_id.nil?
+    return if group.account_id == account_id
+
+    errors.add(:group, "must belong to the same account")
+  end
+
+  # A ticket can only be merged into another ticket for the same customer.
+  # Account scoping is enforced by the controllers as well, but keeping the
+  # rule on the model protects direct callers too.
+  def merged_into_belongs_to_same_customer
+    return if merged_into.nil?
+
+    if id.present? && merged_into_id == id
+      errors.add(:merged_into, "cannot be itself")
+      return
+    end
+
+    errors.add(:merged_into, "must belong to the same account") if merged_into.account_id != account_id
+    errors.add(:merged_into, "must belong to the same customer") if merged_into.requester_id != requester_id
+  end
+
+  # A ticket's assignee must belong to the ticket's department. Tickets
+  # without a department may be assigned to any active staff member; the
+  # controller uses the assignee's default department in that case.
+  def assignee_belongs_to_group
+    return if assignee.nil? || group.nil?
+    return if GroupMembership.exists?(group_id: group_id, user_id: assignee_id)
+
+    errors.add(:assignee, "must belong to the ticket's group")
+  end
+
+  def ensure_reply_token
+    return if reply_token.present?
+
+    self.reply_token = loop do
+      candidate = SecureRandom.urlsafe_base64(24)
+      break candidate unless Request.exists?(reply_token: candidate)
+    end
+  end
+end
diff --git a/app/models/session.rb b/app/models/session.rb
new file mode 100644
index 0000000..daf7ff6
--- /dev/null
+++ b/app/models/session.rb
@@ -0,0 +1,40 @@
+require "digest"
+
+class Session < ApplicationRecord
+  TOKEN_TTL = 30.days
+
+  belongs_to :account
+  belongs_to :user
+
+  validates :token_digest, presence: true, uniqueness: true
+  validates :expires_at, presence: true
+
+  def self.digest(raw_token)
+    Digest::SHA256.hexdigest(raw_token.to_s)
+  end
+
+  # Creates a session for the user and returns [session, raw_token].
+  def self.issue!(user)
+    raw_token = SecureRandom.urlsafe_base64(32)
+    session = user.sessions.create!(
+      account: user.account,
+      token_digest: digest(raw_token),
+      expires_at: TOKEN_TTL.from_now
+    )
+    [ session, raw_token ]
+  end
+
+  # Returns the matching live session for a raw bearer token, or nil.
+  def self.authenticate(raw_token)
+    return nil if raw_token.blank?
+
+    session = find_by(token_digest: digest(raw_token))
+    return nil if session.nil? || session.expired?
+
+    session
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+end
diff --git a/app/models/support_address.rb b/app/models/support_address.rb
new file mode 100644
index 0000000..0932e14
--- /dev/null
+++ b/app/models/support_address.rb
@@ -0,0 +1,61 @@
+# Helpers for the per-business support addresses and the opaque per-ticket
+# reply addresses.
+#
+# A business receives mail at <subdomain>@HELPDESK_SUPPORT_DOMAIN, while a
+# ticket replies to reply+<reply_token>@HELPDESK_SUPPORT_DOMAIN.
+module SupportAddress
+  DEFAULT_DOMAIN = "support.example.test"
+  REPLY_PREFIX = "reply+"
+
+  class << self
+    def domain
+      value = ENV.fetch("HELPDESK_SUPPORT_DOMAIN", DEFAULT_DOMAIN).to_s.strip.downcase
+      value.presence || DEFAULT_DOMAIN
+    end
+
+    def business_address(subdomain)
+      "#{subdomain.to_s.strip.downcase}@#{domain}"
+    end
+    alias address_for business_address
+    alias support_address business_address
+
+    def reply_address(token)
+      "#{REPLY_PREFIX}#{token}@#{domain}"
+    end
+
+    # Returns a hash describing the address, or nil when it is not one of our
+    # support addresses.
+    #
+    #   parse("acme@support.example.test")
+    #   # => { type: :business, subdomain: "acme" }
+    #   parse("reply+abc@support.example.test")
+    #   # => { type: :reply, token: "abc" }
+    #   parse("acme+abc@support.example.test")
+    #   # => { type: :business_plus, subdomain: "acme", token: "abc" }
+    def parse(address)
+      local, address_domain = address.to_s.strip.split("@", 2)
+      return nil if local.blank? || address_domain.to_s.downcase != domain
+
+      local_downcased = local.downcase
+
+      if local_downcased.start_with?(REPLY_PREFIX)
+        # Tokens are opaque and case-sensitive, so keep their original case.
+        token = local[REPLY_PREFIX.length..]
+        return nil if token.blank?
+
+        { type: :reply, token: token }
+      elsif local_downcased.include?("+")
+        subdomain, token = local.split("+", 2)
+        return nil if subdomain.blank? || token.blank?
+
+        { type: :business_plus, subdomain: subdomain.downcase, token: token }
+      elsif (match = local.match(/\A(?:reply|ticket)[-_](.+)\z/i))
+        { type: :reply, token: match[1] }
+      else
+        # Keep the original local part so a bare token address can also be
+        # recognized by the mailbox.
+        { type: :business, subdomain: local_downcased, local: local }
+      end
+    end
+  end
+end
