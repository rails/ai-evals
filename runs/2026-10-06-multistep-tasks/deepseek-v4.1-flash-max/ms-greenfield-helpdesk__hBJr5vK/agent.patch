diff --git a/config/puma.rb b/config/puma.rb
new file mode 100644
index 0000000..1c317b4
--- /dev/null
+++ b/config/puma.rb
@@ -0,0 +1,39 @@
+# This configuration file will be evaluated by Puma. The top-level methods that
+# are invoked here are part of Puma's configuration DSL. For more information
+# about methods provided by the DSL, see https://puma.io/puma/Puma/DSL.html.
+#
+# Puma starts a configurable number of processes (workers) and each process
+# serves each request in a thread from an internal thread pool.
+#
+# You can control the number of workers using ENV["WEB_CONCURRENCY"]. You
+# should only set this value when you want to run 2 or more workers. The
+# default is already 1. You can set it to `auto` to automatically start a worker
+# for each available processor.
+#
+# The ideal number of threads per worker depends both on how much time the
+# application spends waiting for IO operations and on how much you wish to
+# prioritize throughput over latency.
+#
+# As a rule of thumb, increasing the number of threads will increase how much
+# traffic a given process can handle (throughput), but due to CRuby's
+# Global VM Lock (GVL) it has diminishing returns and will degrade the
+# response time (latency) of the application.
+#
+# The default is set to 3 threads as it's deemed a decent compromise between
+# throughput and latency for the average Rails application.
+#
+# Any libraries that use a connection pool or another resource pool should
+# be configured to provide at least as many connections as the number of
+# threads. This includes Active Record's `pool` parameter in `database.yml`.
+threads_count = ENV.fetch("RAILS_MAX_THREADS", 3)
+threads threads_count, threads_count
+
+# Specifies the `port` that Puma will listen on to receive requests; default is 3000.
+port ENV.fetch("PORT", 3000)
+
+# Allow puma to be restarted by `bin/rails restart` command.
+plugin :tmp_restart
+
+# Specify the PID file. Defaults to tmp/pids/server.pid in development.
+# In other environments, only set the PID file if requested.
+pidfile ENV["PIDFILE"] if ENV["PIDFILE"]
diff --git a/config/routes.rb b/config/routes.rb
new file mode 100644
index 0000000..2f7102f
--- /dev/null
+++ b/config/routes.rb
@@ -0,0 +1,96 @@
+Rails.application.routes.draw do
+  namespace :api do
+    namespace :v1 do
+      # Business signup / account management
+      post "account/create", to: "accounts#create"
+      get  "account", to: "accounts#show"
+      post "account/cancel", to: "accounts#cancel"
+      post "account/reactivate", to: "accounts#reactivate"
+
+      # Public portal for a business
+      get "portal", to: "portals#show"
+
+      # Authentication
+      post   "sessions", to: "sessions#create"
+      delete "session", to: "sessions#destroy"
+
+      # Current user
+      get   "me", to: "me#show"
+      patch "me", to: "me#update"
+      put   "me/password", to: "me#update_password"
+
+      # Customer portal registration
+      resources :registrations, only: [ :create ]
+
+      # Customer requests (portal side of a ticket)
+      resources :requests, only: [ :index, :show, :create, :update ] do
+        member { get :comments }
+      end
+
+      # Staff tickets (business side of a request)
+      resources :tickets, only: [ :index, :show, :update ] do
+        member do
+          get :comments
+          post :merge
+        end
+      end
+
+      # Email verification
+      resources :email_verifications, only: [ :create ] do
+        collection { post :confirm }
+      end
+
+      # Password recovery
+      resources :password_resets, only: [ :create ] do
+        collection { post :confirm }
+      end
+
+      # Staff invitations (admins only)
+      resources :invitations, only: [ :index, :show, :create, :destroy ] do
+        member { post :resend }
+      end
+
+      # Invitation acceptance (public)
+      post "invitation_previews", to: "invitation_previews#create"
+      post "invitation_acceptances", to: "invitation_acceptances#create"
+
+      # People management (admins only) and active staff choices
+      resources :users, only: [ :index, :show, :update ]
+      get "staff", to: "staff#index"
+
+      # Departments (groups) and their staff memberships
+      resources :groups, only: [ :index, :show, :create, :update, :destroy ]
+      resources :group_memberships, only: [ :index, :show, :create, :destroy ] do
+        member do
+          put :make_default
+          patch :make_default
+        end
+      end
+    end
+  end
+
+  # The acceptance screen can call these without the /api/v1 prefix, matching
+  # the links sent in invitation emails.
+  post "invitation_previews", to: "api/v1/invitation_previews#create"
+  post "invitation_acceptances", to: "api/v1/invitation_acceptances#create"
+
+  # Convenience aliases for the endpoints described without the /api/v1 prefix.
+  resources :invitations, only: [ :index, :show, :create, :destroy ],
+            controller: "api/v1/invitations" do
+    member { post :resend }
+  end
+  resources :users, only: [ :index, :show, :update ], controller: "api/v1/users"
+  get "staff", to: "api/v1/staff#index"
+  resources :groups, only: [ :index, :show, :create, :update, :destroy ],
+            controller: "api/v1/groups"
+  resources :group_memberships, only: [ :index, :show, :create, :destroy ],
+            controller: "api/v1/group_memberships" do
+    member do
+      put :make_default
+      patch :make_default
+    end
+  end
+
+  # Reveal health status on /up
+  get "up" => "rails/health#show", as: :rails_health_check
+end
