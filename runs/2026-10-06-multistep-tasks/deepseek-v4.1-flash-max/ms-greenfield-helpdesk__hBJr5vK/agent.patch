+class AddCursorPaginationIndexes < ActiveRecord::Migration[8.1]
+  def change
+    # Requests are browsed by most-recent activity with id as the tie-breaker.
+    add_index :requests, [ :account_id, :updated_at, :id ],
+              name: "index_requests_on_account_updated_at_id"
+    add_index :requests, [ :account_id, :status, :updated_at, :id ],
+              name: "index_requests_on_account_status_updated_at_id"
