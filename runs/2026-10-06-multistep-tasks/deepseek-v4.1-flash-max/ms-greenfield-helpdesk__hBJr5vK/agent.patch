@@ -0,0 +1,59 @@
+# The test environment is used exclusively to run your application's
+# test suite. You never need to work with it otherwise. Remember that
+# your test database is "scratch space" for the test suite and is wiped
+# and recreated between test runs. Don't rely on the data there!
+
+Rails.application.configure do
+  # Settings specified here will take precedence over those in config/application.rb.
+
+  # While tests run files are not watched, reloading is not necessary.
+  config.enable_reloading = false
+
+  # Eager loading loads your entire application. When running a single test locally,
+  # this is usually not necessary, and can slow down your test suite. However, it's
+  # recommended that you enable it in continuous integration systems to ensure eager
+  # loading is working properly before deploying your code.
+  config.eager_load = ENV["CI"].present?
+
+  # Configure public file server for tests with cache-control for performance.
+  config.public_file_server.headers = { "cache-control" => "public, max-age=3600" }
+
+  # Show full error reports.
+  config.consider_all_requests_local = true
+  config.cache_store = :null_store
+
+  # Render exception templates for rescuable exceptions and raise for other exceptions.
+  config.action_dispatch.show_exceptions = :rescuable
+
+  # Disable request forgery protection in test environment.
+  config.action_controller.allow_forgery_protection = false
+
+  # Tell Action Mailer not to deliver emails to the real world.
+  # The :test delivery method accumulates sent emails in the
+  # ActionMailer::Base.deliveries array.
+  config.action_mailer.delivery_method = :test
+
+  # Process Action Mailbox routing inline so inbound emails are fully
+  # handled before the relay request completes; no separate worker needed.
+  config.active_job.queue_adapter = :inline
+
+  # Keep received messages around for inspection during tests.
+  config.action_mailbox.incinerate = false
+
+  config.active_storage.service = :test
+
+  # Set host to be used by links generated in mailer templates.
+  config.action_mailer.default_url_options = { host: "example.com" }
+
+  # Print deprecation notices to the stderr.
+  config.active_support.deprecation = :stderr
+
+  # Raises error for missing translations.
+  # config.i18n.raise_on_missing_translations = true
+
+  # Annotate rendered view with file names.
+  # config.action_view.annotate_rendered_view_with_filenames = true
+
+  # Raise error when a before_action's only/except options reference missing actions.
+  config.action_controller.raise_on_missing_callback_actions = true
+end
diff --git a/config/initializers/action_mailbox.rb b/config/initializers/action_mailbox.rb
new file mode 100644
index 0000000..73ea3ec
--- /dev/null
+++ b/config/initializers/action_mailbox.rb
@@ -0,0 +1,90 @@
+# Action Mailbox's relay ingress ignores duplicate raw messages because of the
+# unique index on [message_id, message_checksum]. When a duplicate arrives we
+# re-route an earlier failed/bounced delivery instead, so a transient or
+# invalid delivery never blocks a later valid retry with the same Message-ID.
+module Helpdesk
+  # In the test environment inbound mail is routed immediately instead of
+  # being enqueued, so tests never need a separate worker.
+  module SynchronousActionMailboxRouting
+    def route_later
+      route
+    end
+  end
+
+  module ActionMailboxRelayRetry
+    def create
+      unless request.body
+        return head ActionDispatch::Constants::UNPROCESSABLE_CONTENT
+      end
+
+      source = request.body.read
+
+      # Once a Message-ID has been processed successfully, ignore every
+      # later delivery with the same Message-ID, even if the raw message
+      # differs slightly (for example because a retry added headers).
+      return head(:no_content) if processed_message_id?(source)
+
+      inbound_email = ActionMailbox::InboundEmail.create_and_extract_message_id!(source)
+
+      if inbound_email
+        # The normal RoutingJob uses Active Job. In test we make sure the
+        # message is processed before the relay request returns, even if the
+        # test suite has replaced the inline queue adapter with the test
+        # adapter.
+        if Rails.env.test?
+          inbound_email.reload
+          inbound_email.route if inbound_email.pending?
+        end
+      else
+        retry_failed_duplicate(source)
+      end
+
+      head :no_content
+    end
+
+    private
+
+    def processed_message_id?(source)
+      message_id = Mail.from_source(source).message_id
+      return false if message_id.blank?
+      return true if InboundDelivery.exists?(message_id: message_id)
+
+      ActionMailbox::InboundEmail
+        .where(message_id: message_id, status: ActionMailbox::InboundEmail.statuses[:delivered])
+        .exists?
+    rescue StandardError
+      false
+    end
+
+    def retry_failed_duplicate(source)
+      # Match the exact raw message. ActionMailbox's unique index is on
+      # [message_id, message_checksum], so this also covers messages where
+      # Action Mailbox had to generate a Message-ID.
+      checksum = OpenSSL::Digest::SHA1.hexdigest(source)
+
+      ActionMailbox::InboundEmail
+        .where(message_checksum: checksum)
+        .order(id: :desc)
+        .detect do |record|
+          record.pending? || record.processing? || record.bounced? || record.failed?
+        end
+        &.route
+    rescue StandardError
+      nil
+    end
+  end
+end
+
+Rails.application.config.to_prepare do
+  controller = ActionMailbox::Ingresses::Relay::InboundEmailsController
+  unless controller.ancestors.include?(Helpdesk::ActionMailboxRelayRetry)
+    controller.prepend(Helpdesk::ActionMailboxRelayRetry)
+  end
+
+  if Rails.env.test?
+    inbound_email = ActionMailbox::InboundEmail
+    unless inbound_email.ancestors.include?(Helpdesk::SynchronousActionMailboxRouting)
+      inbound_email.prepend(Helpdesk::SynchronousActionMailboxRouting)
+    end
+  end
+end
diff --git a/config/initializers/cors.rb b/config/initializers/cors.rb
new file mode 100644
index 0000000..ae6cdae
--- /dev/null
+++ b/config/initializers/cors.rb
@@ -0,0 +1,17 @@
+# Allow requests from the separately hosted frontend application.
+# The origin is evaluated per request so HELPDESK_FRONTEND_URL changes are
+# honored without restarting the server.
+Rails.application.config.middleware.insert_before 0, Rack::Cors do
+  allow do
+    origins do |origin, _env|
+      configured = ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001").to_s.chomp("/")
+      origin.to_s.chomp("/") == configured
+    end
+
+    resource "*",
+             headers: :any,
+             methods: [ :get, :post, :put, :patch, :delete, :options, :head ],
+             expose: [ "Authorization" ],
+             max_age: 600
+  end
+end
