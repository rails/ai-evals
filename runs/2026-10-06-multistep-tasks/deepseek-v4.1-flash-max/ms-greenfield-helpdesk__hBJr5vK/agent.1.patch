+namespace :helpdesk do
+  desc "Permanently delete accounts cancelled more than 90 days ago, including all of their data"
+  task purge_cancelled_accounts: :environment do
+    purged = 0
+
+    Account.purgeable.find_each do |account|
+      account.purge!
+      purged += 1
+    end
+
+    puts "Purged #{purged} cancelled account(s)."
+  end
+end
