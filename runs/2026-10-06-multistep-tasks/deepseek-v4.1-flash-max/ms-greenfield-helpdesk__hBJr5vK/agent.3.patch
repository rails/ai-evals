+
+    sleep 0.01
+    patch "/api/v1/tickets/#{ticket_id}",
+          params: { ticket: { comment: { body: "Checking this with billing.", public: false } } },
+          headers: auth_headers(owner), as: :json
+    assert_response :success, response.body
+
+    request_after = Request.find(ticket_id)
+    assert_equal status_before, request_after.status
+    assert_equal updated_before.to_i, request_after.updated_at.to_i
+
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: auth_headers(owner)
+    assert_response :success
+    staff_comments = JSON.parse(response.body)["comments"]
+    assert_equal false, staff_comments.last["public"]
+    assert_equal "Checking this with billing.", staff_comments.last["body"]
+
+    get "/api/v1/requests/#{ticket_id}/comments", headers: auth_headers(avery)
+    assert_response :success
+    customer_comments = JSON.parse(response.body)["comments"]
+    assert_equal [ "Please check my invoice" ], customer_comments.map { |c| c["body"] }
+
+    get "/api/v1/requests/#{ticket_id}", headers: auth_headers(avery)
+    assert_response :success
+    assert_equal status_before, JSON.parse(response.body).dig("request", "status")
+  end
