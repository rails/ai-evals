+      # POST /api/v1/tickets/:id/merge
+      #
+      # Closes this ticket, links it to the surviving target ticket and leaves
+      # a note on each side. Existing comments stay where they are; the target
+      # keeps its status, assignment and email identity.
+      def merge
+        if @ticket.closed? || @ticket.merged?
+          return render_validation_errors([ "Closed tickets cannot be merged" ])
+        end
+
+        attrs = params.require(:merge).permit(
+          :target_id,
+          source_comment: [ :body, :public ],
+          target_comment: [ :body, :public ]
+        )
+
+        target_id = attrs[:target_id].to_s.strip
+        if target_id.blank?
+          return render_validation_errors([ "Target ticket is required" ])
+        end
+
+        target = current_account.requests.find_by(id: target_id)
+        if target.nil?
+          return render json: { error: "Target ticket not found" }, status: :not_found
+        end
+
+        errors = merge_validation_errors(@ticket, target)
+        return render_validation_errors(errors) if errors.any?
+
+        Request.transaction do
+          create_merge_note!(
