+      # Merge is only allowed between tickets for the same customer, and the
+      # target must still be an active, unmerged conversation.
+      def merge_validation_errors(source, target)
+        errors = []
+        errors << "A ticket cannot be merged into itself" if source.id == target.id
+        errors << "Target ticket is closed" if target.closed? || target.merged?
+        errors << "Tickets must belong to the same customer" if source.requester_id != target.requester_id
+        errors
+      end
+
+      # Merge notes default to private and use a short default body when the
+      # staff member does not supply their own text.
+      def create_merge_note!(ticket, note_attrs, default_body:)
+        body = note_attrs && note_attrs[:body].to_s.strip
+        body = default_body if body.blank?
+
+        public_note = note_attrs.nil? ? false : ActiveModel::Type::Boolean.new.cast(note_attrs[:public])
+        public_note = false if public_note.nil?
+
+        ticket.comments.create!(
+          account: current_account,
+          author: current_user,
+          body: body,
+          public: public_note
+        )
+      end
