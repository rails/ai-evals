+class Group < ApplicationRecord
+  belongs_to :account
+  has_many :group_memberships, dependent: :destroy
+  has_many :users, through: :group_memberships
+  # The database foreign key nullifies group_id as a safety net; the
+  # before_destroy callback below also clears now-invalid assignees.
+  has_many :requests
+
+  before_validation :normalize_name
+  before_destroy :detach_requests
+
+  validates :name,
+            presence: true,
+            uniqueness: { scope: :account_id, case_sensitive: false }
+
+  private
+
+  def normalize_name
+    self.name = name.to_s.strip if name.present?
+  end
+
+  # Tickets stay around when a department is removed, but the department
+  # disappears and any assignment that was only valid through it is cleared.
+  def detach_requests
+    Request.where(group_id: id).update_all(group_id: nil, assignee_id: nil)
+  end
+end
diff --git a/app/models/group_membership.rb b/app/models/group_membership.rb
