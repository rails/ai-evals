new file mode 100644
index 0000000..efec849
--- /dev/null
+++ b/app/services/images/profile_image_copier.rb
@@ -0,0 +1,120 @@
+require "stringio"
+
+module Images
+  # Copies legacy CarrierWave profile images into Active Storage.
+  #
+  # The task is designed to be run after each deploy until every legacy image
+  # has an Active Storage counterpart. It only looks at records that still have
+  # a value in their legacy +profile_image+ column and skips any record that is
+  # already attached through Active Storage, which makes it safe to run
+  # repeatedly and after an interrupted copy.
+  class ProfileImageCopier
+    DEFAULT_MODELS = %w[User Organization].freeze
+    DEFAULT_BATCH_SIZE = 100
+
+    Result = Struct.new(:copied, :skipped, :failed, :errors, keyword_init: true) do
+      def initialize(**attributes)
+        super
+        self.errors ||= []
+      end
+
+      def total
+        copied + skipped + failed
+      end
+    end
+
+    def self.call(...)
+      new(...).call
+    end
+
+    def initialize(models: DEFAULT_MODELS, batch_size: DEFAULT_BATCH_SIZE, logger: Rails.logger)
+      @models = Array.wrap(models)
+      @batch_size = batch_size
+      @logger = logger
+      @result = Result.new(copied: 0, skipped: 0, failed: 0)
+    end
+
+    def call
+      model_classes.each { |model| copy_model(model) }
+      @result
+    end
+
+    private
+
+    attr_reader :batch_size, :logger, :models
+
+    def model_classes
+      models.map do |model|
+        model.is_a?(String) || model.is_a?(Symbol) ? model.to_s.camelize.constantize : model
+      end
+    end
+
+    def copy_model(model)
+      model.where.not(profile_image: [nil, ""]).find_each(batch_size: batch_size) do |record|
+        copy_record(record)
+      end
+    end
+
+    def copy_record(record)
+      if record.profile_image.attached?
+        @result.skipped += 1
+        return
+      end
+
+      legacy_image = record.profile_image_carrierwave
+      image_data = legacy_image&.read
+
+      if image_data.blank?
+        fail_record(record, "legacy profile image has no content")
+        return
+      end
+
+      record.profile_image.attach(
+        io: StringIO.new(image_data),
+        filename: legacy_filename(record, legacy_image),
+        content_type: legacy_content_type(legacy_image),
+      )
+
+      if record.reload.profile_image.attached?
+        @result.copied += 1
+        resave_articles(record)
+      else
+        fail_record(record, record.errors.full_messages.to_sentence.presence ||
+                              "Active Storage attachment was not saved")
+      end
+    rescue StandardError => e
+      fail_record(record, "#{e.class}: #{e.message}")
+    end
+
+    # Users cache their profile image attributes on articles. A normal
+    # profile image update resaves those articles, so the copy does the same to
+    # avoid serving the legacy CarrierWave URL from article caches.
+    def resave_articles(record)
+      return unless record.is_a?(User)
+
+      Users::ResaveArticlesWorker.perform_async(record.id)
+    rescue StandardError => e
+      logger.warn("Unable to enqueue article resave for User##{record.id}: #{e.class}: #{e.message}")
+    end
+
+    def legacy_filename(record, legacy_image)
+      legacy_image.file&.filename.presence || File.basename(record[:profile_image].to_s).presence
+    rescue StandardError
+      File.basename(record[:profile_image].to_s).presence
+    end
+
+    def legacy_content_type(legacy_image)
+      legacy_image.content_type.presence
+    rescue StandardError
+      nil
+    end
+
+    def fail_record(record, message)
+      @result.failed += 1
+      @result.errors << [record.class.name, record.id, message]
+      logger.warn("Unable to copy profile image for #{record.class.name}##{record.id}: #{message}")
+    rescue StandardError
+      # Logging must never stop a backfill.
+    end
+  end
+end
