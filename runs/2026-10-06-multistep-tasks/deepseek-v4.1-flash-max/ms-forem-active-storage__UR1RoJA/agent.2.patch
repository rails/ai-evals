+# The service selection mirrors the CarrierWave initializer so that a Forem
+# running on local disk, a standard AWS bucket, or Forem Cloud with an IAM
+# profile keeps storing new profile images in the same place.
+module ActiveStorageInitializer
+  def self.test_storage_config
+    Rails.application.config.active_storage.service = :test
+  end
+
+  def self.local_storage_config
+    Rails.application.config.active_storage.service = :local
+  end
+
+  def self.standard_production_config
+    Rails.application.config.active_storage.service = :amazon
+  end
+
+  def self.forem_cloud_config
+    Rails.application.config.active_storage.service = :amazon_iam
+  end
+
+  def self.initialize!
+    if Rails.env.test?
+      test_storage_config
+    elsif Rails.env.production? && ENV["FILE_STORAGE_LOCATION"] != "file"
+      if ENV["FOREM_CONTEXT"] == "forem_cloud"
+        forem_cloud_config
+      elsif ApplicationConfig["AWS_ID"].present? || ApplicationConfig["AWS_BUCKET_NAME"].present?
+        standard_production_config
+      else
+        local_storage_config
+      end
     else
-      :local
+      local_storage_config
     end
-  else
-    :local
   end
+end
+
+ActiveStorageInitializer.initialize!
diff --git a/lib/tasks/profile_images.rake b/lib/tasks/profile_images.rake
new file mode 100644
index 0000000..988d7f8
--- /dev/null
+++ b/lib/tasks/profile_images.rake
@@ -0,0 +1,12 @@
+namespace :profile_images do
+  desc "Copy legacy CarrierWave profile images to Active Storage"
+  task copy: :environment do
+    result = Images::ProfileImageCopier.call
+
+    puts [
+      "Copied #{result.copied} profile images.",
+      "#{result.skipped} already copied,",
+      "#{result.failed} failed.",
+    ].join(" ")
+  end
+end
