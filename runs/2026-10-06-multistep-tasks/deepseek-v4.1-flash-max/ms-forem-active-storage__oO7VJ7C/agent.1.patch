diff --git a/app/models/concerns/has_profile_image.rb b/app/models/concerns/has_profile_image.rb
new file mode 100644
index 0000000..7a08b5e
--- /dev/null
+++ b/app/models/concerns/has_profile_image.rb
@@ -0,0 +1,206 @@
+require "open-uri"
+
+# Shared profile picture behavior for records that are moving from CarrierWave to
+# Active Storage, one deploy at a time.
+#
+# New uploads are always attached to Active Storage. Records that still have a
+# CarrierWave identifier in their +profile_image+ column (because they were uploaded
+# in an earlier deploy) keep rendering through CarrierWave until that backfill runs.
+module HasProfileImage
+  extend ActiveSupport::Concern
+
+  PROFILE_IMAGE_URL_PATTERN = %r{\Ahttps?://}i
+  # The BaseUploader allowlist is the source of truth for images that CarrierWave
+  # accepted before this migration.
+  PROFILE_IMAGE_EXTENSIONS = ProfileImageUploader::EXTENSION_ALLOWLIST
+  CONTENT_TYPE_EXTENSIONS = {
+    "image/jpeg" => "jpg",
+    "image/pjpeg" => "jpg",
+    "image/png" => "png",
+    "image/gif" => "gif",
+    "image/webp" => "webp",
+    "image/bmp" => "bmp",
+    "image/x-icon" => "ico",
+    "image/vnd.microsoft.icon" => "ico"
+  }.freeze
+
+  included do
+    has_one_attached :profile_image
+
+    # The legacy CarrierWave mount intentionally writes to the historical
+    # +profile_image+ column. Active Storage's attachment records live in their
+    # own tables, so both storages can coexist during the roll out.
+    mount_uploader :legacy_profile_image, ProfileImageUploader, mount_on: :profile_image
+
+    before_save :reset_profile_image_attachment_saved_change
+    after_save :track_profile_image_attachment_saved_change, if: :profile_image_attaching?
+    validate :validate_profile_image_attachment, if: :profile_image_attaching?
+
+    # Active Storage strings are signed blob ids. The previous CarrierWave
+    # behavior also accepted plain public URLs in a few call sites (for example
+    # Apple sign in), so keep those working by storing them as a legacy URL.
+    alias_method :profile_image_without_legacy_url=, :profile_image=
+
+    def profile_image=(attachable)
+      if attachable.is_a?(String)
+        if attachable.match?(HasProfileImage::PROFILE_IMAGE_URL_PATTERN)
+          write_attribute(:profile_image, attachable)
+          self.profile_image_without_legacy_url = nil
+        elsif attachable.blank?
+          self.profile_image_without_legacy_url = nil
+        end
+        # Other strings were ignored by CarrierWave's cache handling. Keep that
+        # behavior instead of treating them as Active Storage signed blob ids.
+      else
+        self.profile_image_without_legacy_url = attachable
+      end
+    end
+  end
+
+  # @return [String, nil] the URL for the image new deployments should display
+  def profile_image_url
+    return ensure_active_storage_url_options { profile_image.url } if profile_image.attached?
+
+    legacy_value = self[:profile_image]
+    if legacy_value.present?
+      return legacy_value if legacy_value.match?(PROFILE_IMAGE_URL_PATTERN)
+      return legacy_value if legacy_value.start_with?("/")
+      return "/#{legacy_value}" if legacy_value.start_with?("uploads/")
+    end
+
+    legacy_profile_image_url
+  end
+
+  # CarrierWave's remote downloader used to be responsible for pulling provider
+  # images into storage. Route that behavior through Active Storage now.
+  def remote_profile_image_url
+    @remote_profile_image_url
+  end
+
+  def remote_profile_image_url=(url)
+    @remote_profile_image_url = url
+    return if url.blank?
+
+    attach_remote_profile_image(url)
+  rescue StandardError => e
+    Rails.logger.warn("Could not attach remote profile image for #{self.class.name}##{id}: #{e.message}")
+    # Keep the URL visible as a legacy fallback rather than losing the provider's
+    # picture when a download is temporarily unavailable.
+    self[:profile_image] = url if url.is_a?(String) && url.match?(PROFILE_IMAGE_URL_PATTERN)
+  end
+
+  # Active Storage validations run in addition to CarrierWave's legacy validations
+  # for new uploads. Use the historical CarrierWave messages so existing UI and
+  # specs continue to see the same errors.
+  def validate_profile_image_attachment
+    change = attachment_changes["profile_image"]
+    blob = change.respond_to?(:blob) ? change.blob : profile_image.try(:blob)
+    return unless blob.respond_to?(:byte_size)
+
+    max_size = ProfileImageUploader::MAX_FILE_SIZE
+    if blob.byte_size > max_size
+      errors.add(:profile_image, I18n.t(
+                                   "errors.messages.max_size_error",
+                                   max_size: ActiveSupport::NumberHelper.number_to_human_size(max_size),
+                                   default: "File size should be less than %<max_size>s",
+                                 ))
+    end
+
+    extension = File.extname(blob.filename.to_s).delete_prefix(".").downcase
+    return if PROFILE_IMAGE_EXTENSIONS.include?(extension)
+
+    errors.add(:profile_image, I18n.t("errors.messages.carrierwave_integrity_error",
+                                      default: "is not of an allowed file type"))
+  end
+
+  # @return [Boolean] true when an Active Storage attachment was added during the
+  #   current save. Validations rely on this before the attachment is persisted.
+  def profile_image_attaching?
+    attachment_changes["profile_image"].is_a?(ActiveStorage::Attached::Changes::CreateOne)
+  end
+
+  def profile_image_attachment_saved_change?
+    @profile_image_attachment_saved == true
+  end
+
+  # @return [Boolean] true for both an Active Storage save and a direct write to
+  #   the legacy CarrierWave column (for example, a backfill).
+  def profile_image_changed_in_this_save?
+    profile_image_attachment_saved_change? || attachment_changes.key?("profile_image")
+  end
+
+  # Ensure Active Record's default JSON serialization (used by the API) emits a
+  # URL instead of an ActiveStorage::Attached::One proxy.
+  def read_attribute_for_serialization(attribute)
+    if attribute.to_s == "profile_image"
+      profile_image_url
+    else
+      super
+    end
+  end
+
+  # Presence validators (notably Organization#profile_image) must consider the
+  # CarrierWave column for records that have not been backfilled yet. New
+  # attachments are validated through the Active Storage proxy as usual.
+  def read_attribute_for_validation(attribute)
+    if attribute.to_s == "profile_image"
+      value = profile_image
+      if value.respond_to?(:attached?)
+        return self[:profile_image] if !value.attached? && self[:profile_image].present?
+
+        return super
+      end
+      return value if value.present? && !value.is_a?(String)
+    end
+    super
+  end
+
+  private
+
+  def ensure_active_storage_url_options
+    if ActiveStorage::Current.url_options.blank?
+      domain = (ApplicationConfig["APP_DOMAIN"].presence || Rails.application.config.try(:app_domain)).to_s
+      if domain.present?
+        protocol = Rails.env.production? ? "https" : "http"
+        uri = URI.parse(domain.include?("://") ? domain : "#{protocol}://#{domain}")
+        ActiveStorage::Current.url_options = {
+          protocol: "#{uri.scheme}://",
+          host: uri.host,
+          port: uri.port
+        }
+      end
+    end
+    yield
+  end
+
+  def reset_profile_image_attachment_saved_change
+    @profile_image_attachment_saved = false
+  end
+
+  def track_profile_image_attachment_saved_change
+    @profile_image_attachment_saved = true
+  end
+
+  def remote_image_filename(path, content_type)
+    filename = File.basename(path.presence || "profile_image")
+    return filename if File.extname(filename).present?
+
+    extension = CONTENT_TYPE_EXTENSIONS[content_type]
+    extension ? "#{filename}.#{extension}" : filename
+  end
+
+  def attach_remote_profile_image(url)
+    if url.is_a?(String)
+      uri = URI.parse(url)
+      io = uri.open(read_timeout: 10, open_timeout: 5)
+      content_type = io.respond_to?(:content_type) ? io.content_type : nil
+      filename = remote_image_filename(uri.path, content_type)
+      profile_image.attach(io: io, filename: filename, content_type: content_type)
+    elsif url.respond_to?(:read)
+      path = url.respond_to?(:path) ? url.path : nil
+      profile_image.attach(io: url, filename: File.basename(path.presence || "profile_image"))
+    else
+      profile_image.attach(url)
+    end
+  end
+end
