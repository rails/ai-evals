diff --git a/spec/models/concerns/has_profile_image_spec.rb b/spec/models/concerns/has_profile_image_spec.rb
new file mode 100644
index 0000000..fdddac6
--- /dev/null
+++ b/spec/models/concerns/has_profile_image_spec.rb
@@ -0,0 +1,61 @@
+require "rails_helper"
+
+RSpec.describe HasProfileImage do
+  let(:image_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+  let(:image_file) { Rack::Test::UploadedFile.new(image_path, "image/jpeg") }
+
+  it "attaches new user profile images to Active Storage" do
+    user = create(:user, profile_image: image_file)
+
+    expect(user.profile_image).to be_attached
+    expect(user[:profile_image]).to be_nil
+    expect(user.profile_image_url).to include("/rails/active_storage/")
+  end
+
+  it "attaches new organization profile images to Active Storage" do
+    organization = create(:organization, profile_image: image_file)
+
+    expect(organization.profile_image).to be_attached
+    expect(organization[:profile_image]).to be_nil
+    expect(organization.profile_image_url).to include("/rails/active_storage/")
+  end
+
+  it "continues to render legacy CarrierWave files" do
+    user = create(:user, profile_image: nil)
+    user.legacy_profile_image = File.open(image_path)
+    user.save!
+
+    expect(user.profile_image).not_to be_attached
+    expect(user.profile_image_url).to eq("/uploads/user/profile_image/#{user.id}/#{user[:profile_image]}")
+  end
+
+  it "prefers an Active Storage attachment over a legacy CarrierWave file" do
+    user = create(:user, profile_image: nil)
+    user.legacy_profile_image = File.open(image_path)
+    user.save!
+    legacy_url = user.profile_image_url
+
+    user.profile_image = image_file
+    user.save!
+
+    expect(user.profile_image_url).not_to eq(legacy_url)
+    expect(user.profile_image_url).to include("/rails/active_storage/")
+  end
+
+  it "attaches remote profile images to Active Storage" do
+    stub_request(:get, "https://example.com/avatar.jpg")
+      .to_return(status: 200, body: File.binread(image_path), headers: { "Content-Type" => "image/jpeg" })
+
+    organization = build(:organization)
+    organization.remote_profile_image_url = "https://example.com/avatar.jpg"
+    organization.save!
+
+    expect(organization.profile_image).to be_attached
+    expect(organization.profile_image.blob.filename.to_s).to eq("avatar.jpg")
+  end
+
+  it "keeps other profile_image uploads mounted on CarrierWave" do
+    expect(Tag.reflect_on_attachment(:profile_image)).to be_nil
+    expect(Tag.uploaders[:profile_image]).to eq(ProfileImageUploader)
+  end
+end
