diff --git a/spec/support/sidekiq_inline_allowlist.rb b/spec/support/sidekiq_inline_allowlist.rb
new file mode 100644
index 0000000..698e6b9
--- /dev/null
+++ b/spec/support/sidekiq_inline_allowlist.rb
@@ -0,0 +1,23 @@
+# frozen_string_literal: true
+
+# Allows examples tagged with `sidekiq_inline: [WorkerName, ...]` to run only
+# those Sidekiq workers synchronously. Request specs run with Sidekiq in `:fake`
+# mode by default because most response assertions do not need worker side
+# effects; the few that do opt into the specific workers they depend on.
+module SidekiqInlineAllowlist
+  class << self
+    attr_accessor :allowed
+  end
+
+  class Middleware
+    def call(worker, _job, _queue)
+      return true if SidekiqInlineAllowlist.allowed && !SidekiqInlineAllowlist.allowed.include?(worker.class.name)
+
+      yield
+    end
+  end
+end
+
