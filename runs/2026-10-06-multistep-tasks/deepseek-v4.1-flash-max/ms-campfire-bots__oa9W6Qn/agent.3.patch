+class BotJoinWebhookTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "adding a bot to a room enqueues a joined webhook once per room" do
+    bot = users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://example.com/hooks/deploy")
+    room = rooms(:watercooler)
+
+    assert_enqueued_jobs 1, only: [ Bot::WebhookJob ] do
+      room.memberships.grant_to(bot)
+    end
+
+    assert_no_enqueued_jobs only: [ Bot::WebhookJob ] do
+      room.memberships.grant_to(bot)
+    end
+  end
+
+  test "adding a bot without a webhook enqueues nothing" do
+    bot = users(:david).bots.create!(name: "Deploy Bot")
+
+    assert_no_enqueued_jobs only: [ Bot::WebhookJob ] do
+      rooms(:watercooler).memberships.grant_to(bot)
+    end
+  end
+
+  test "creating a bot with add to all open rooms and a webhook enqueues a joined webhook per room" do
+    assert_enqueued_jobs Rooms::Open.count, only: [ Bot::WebhookJob ] do
+      users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://example.com/hooks/deploy", add_to_all_open_rooms: true)
+    end
+  end
+
+  test "turning on add to all open rooms with a webhook enqueues a joined webhook per room" do
+    bot = users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://example.com/hooks/deploy")
+
+    assert_enqueued_jobs Rooms::Open.count, only: [ Bot::WebhookJob ] do
+      bot.update!(add_to_all_open_rooms: true)
+    end
+  end
+
+  test "creating an open room with an opted-in bot enqueues one joined webhook" do
+    bot = users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://example.com/hooks/deploy", add_to_all_open_rooms: true)
+    clear_enqueued_jobs
+
+    assert_difference -> { bot.memberships.count }, +1 do
+      assert_enqueued_jobs 1, only: [ Bot::WebhookJob ] do
+        Rooms::Open.create_for({ name: "A new open room", creator: users(:david) }, users: [ bot ])
+      end
+    end
+  end
+
+  test "an open room created later enqueues a joined webhook for opted-in bots" do
+    users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://example.com/hooks/deploy", add_to_all_open_rooms: true)
+    clear_enqueued_jobs
+
+    assert_enqueued_jobs 1, only: [ Bot::WebhookJob ] do
+      Rooms::Open.create!(name: "A new open room", creator: users(:david))
+    end
+  end
+
+  test "direct conversations never enqueue a joined webhook" do
+    bot = users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://example.com/hooks/deploy")
+
+    assert_no_enqueued_jobs only: [ Bot::WebhookJob ] do
+      Rooms::Direct.create_for({ creator: users(:david) }, users: [ users(:david), bot ])
+    end
+  end
+end
