--- /dev/null
+++ b/spec/support/profile_image_helpers.rb
@@ -0,0 +1,16 @@
+module ProfileImageHelpers
+  # Simulate the last CarrierWave deploy without mounting it on these models.
+  def legacy_profile_image(factory, image_path = Rails.root.join("spec/support/fixtures/images/image1.jpeg"))
+    record = build(factory, profile_image: nil)
+    record[:profile_image] = "#{SecureRandom.uuid}#{File.extname(image_path)}"
+    record.save!
+    path = Images::LegacyProfileImage.new(record).path
+    FileUtils.mkdir_p(File.dirname(path))
+    FileUtils.copy_file(image_path, path)
+    record.reload
+  end
+end
+
+RSpec.configure do |config|
+  config.include ProfileImageHelpers
+end
