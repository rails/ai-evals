+require "rails_helper"
+
+RSpec.describe Images::LegacyProfileImage do
+  let(:user) { create(:user, profile_image: nil) }
+  let(:image) { described_class.new(user) }
+
+  before { user[:profile_image] = "avatar.jpg" }
+
+  it "retains the local URL, file path, string and JSON interfaces" do
+    key = "uploads/user/profile_image/#{user.id}/avatar.jpg"
+    expect(image.url).to eq("/#{key}")
+    expect(image.path).to eq(Rails.public_path.join(key).to_s)
+    expect(image.to_s).to eq(image.url)
+    expect(image.as_json).to eq("url" => image.url)
+    expect(image).not_to be_blank
+  end
+
+  it "does not create an attachment or lose its URL on an unrelated save" do
+    expect { user.save! }.not_to change(ActiveStorage::Blob, :count)
+    expect(user.reload.profile_image_url).to eq(image.url)
+    expect(user.profile_image_file).not_to be_attached
+  end
+
+  it "returns the empty image interface and supports default-avatar helpers" do
+    user[:profile_image] = nil
+    expect(image).to be_blank
+    expect(image.url).to be_nil
+    expect(image.to_s).to eq("")
+    expect(image.as_json).to eq("url" => nil)
+    expect(user).not_to be_profile_image
+    expect(user.profile_image_90).to eq(Images::Profile.call(nil, length: 90))
+  end
+
+  it "matches public regional S3 URL addressing" do
+    allow(described_class).to receive(:storage_config).and_return(
+      bucket: "legacy-images", credentials: { region: "eu-west-1" },
+    )
+    expect(image.url).to eq("https://legacy-images.s3.eu-west-1.amazonaws.com/uploads/user/profile_image/#{user.id}/avatar.jpg")
+  end
+
+  it "matches default-region and dotted-bucket S3 addressing" do
+    allow(described_class).to receive(:storage_config).and_return(
+      bucket: "legacy.images", credentials: { region: "us-east-1" },
+    )
+    expect(image.url).to eq("https://s3.amazonaws.com/legacy.images/uploads/user/profile_image/#{user.id}/avatar.jpg")
+  end
+
+  it "keeps Forem Cloud URLs on the existing remoteimages endpoint" do
+    allow(described_class).to receive(:storage_config).and_return(
+      bucket: "legacy-images", asset_host: "https://forem.example/remoteimages",
+      credentials: { provider: "AWS", use_iam_profile: true, region: "us-east-2" }
+    )
+    expect(image.url).to eq("https://forem.example/remoteimages/uploads/user/profile_image/#{user.id}/avatar.jpg")
+  end
+
+  it "encodes filenames without changing the underlying key" do
+    user[:profile_image] = "a b+c.jpg"
+    expect(image.url).to end_with("/a%20b%2Bc.jpg")
+    expect(image.path).to end_with("/a b+c.jpg")
+  end
+end
