diff --git a/spec/services/profile_images/upload_spec.rb b/spec/services/profile_images/upload_spec.rb
new file mode 100644
index 0000000..22a0313
--- /dev/null
+++ b/spec/services/profile_images/upload_spec.rb
@@ -0,0 +1,108 @@
+require "rails_helper"
+require "exifr/jpeg"
+
+RSpec.describe ProfileImages::Upload do
+  subject(:uploader) { described_class.new }
+
+  before do
+    allow(Resolv).to receive(:getaddresses).with("example.com").and_return(["93.184.216.34"])
+  end
+
+  it "accepts image files without using CarrierWave" do
+    allow(ProfileImageUploader).to receive(:new).and_raise("Retired uploader invoked")
+    %w[jpg png webp].each do |extension|
+      file = fixture_file_upload("800x600.#{extension}", "image/#{extension}")
+      upload = uploader.call(file)
+      expect(upload[:filename]).to end_with(".#{extension}")
+      expect(upload[:io].read).to eq(File.binread(file.path))
+      expect(upload[:content_type]).to start_with("image/")
+    end
+  end
+
+  it "strips EXIF and GPS data without modifying the source file" do
+    allow(described_class).to receive(:enable_processing).and_return(true)
+    file = fixture_file_upload("image_gps_data.jpg", "image/jpeg")
+    original = File.binread(file.path)
+    upload = uploader.call(file)
+    Tempfile.create(["stripped", ".jpg"]) do |processed|
+      processed.binmode
+      processed.write(upload[:io].read)
+      processed.flush
+      expect(EXIFR::JPEG.new(processed.path).exif?).to be(false)
+      expect(EXIFR::JPEG.new(processed.path).gps).to be_nil
+    end
+    expect(File.binread(file.path)).to eq(original)
+  end
+
+  it "rejects unsupported, empty, and oversized files" do
+    pdf = fixture_file_upload("800x600.pdf", "application/pdf")
+    expect { uploader.call(pdf) }.to raise_error(described_class::Error)
+    Tempfile.create(["empty", ".jpg"]) do |file|
+      expect { uploader.call(file) }.to raise_error(described_class::Error)
+      file.write("x" * (described_class::MAX_FILE_SIZE + 1))
+      expect { uploader.call(file) }.to raise_error(described_class::Error, /8 MB/)
+    end
+  end
+
+  it "rejects images with excessive dimensions" do
+    image = instance_double(FastImage, type: :jpeg, size: [4097, 10])
+    allow(FastImage).to receive(:new).and_return(image)
+    file = fixture_file_upload("800x600.jpg", "image/jpeg")
+    expect { uploader.call(file) }.to raise_error(described_class::Error, /4096x4096/)
+  end
+
+  it "rejects excessive frame counts" do
+    allow(described_class).to receive(:enable_processing).and_return(true)
+    allow(MiniMagick::Image).to receive(:new).and_return(
+      instance_double(MiniMagick::Image, frames: Array.new(described_class::FRAME_MAX + 1)),
+    )
+    file = fixture_file_upload("800x600.jpg", "image/jpeg")
+    expect { uploader.call(file) }.to raise_error(described_class::Error, /Max frame count/)
+  end
+
+  it "downloads extensionless OAuth image URLs using the image format" do
+    data = Rails.root.join("spec/support/fixtures/images/image1.jpeg").binread
+    stub_request(:get, "https://example.com/avatar/123").to_return(
+      body: data, headers: { "Content-Type" => "image/jpeg" },
+    )
+    upload = uploader.download("https://example.com/avatar/123")
+    expect(upload[:filename]).to end_with(".jpg")
+    expect(upload[:io].read).to eq(data)
+  end
+
+  it "follows public redirects and uses the final filename" do
+    stub_request(:get, "https://example.com/avatar").to_return(
+      status: 302, headers: { "Location" => "/avatar.jpg" },
+    )
+    data = Rails.root.join("spec/support/fixtures/images/image1.jpeg").binread
+    stub_request(:get, "https://example.com/avatar.jpg").to_return(body: data)
+    expect(uploader.download("https://example.com/avatar")[:io].read).to eq(data)
+  end
+
+  it "rejects local URLs and redirects to private addresses" do
+    allow(Resolv).to receive(:getaddresses).with("127.0.0.1").and_return(["127.0.0.1"])
+    expect { uploader.download("http://127.0.0.1/avatar.jpg") }.to raise_error(described_class::Error)
+    stub_request(:get, "https://example.com/avatar.jpg").to_return(
+      status: 302, headers: { "Location" => "http://127.0.0.1/avatar.jpg" },
+    )
+    expect { uploader.download("https://example.com/avatar.jpg") }.to raise_error(described_class::Error)
+    expect(WebMock).not_to have_requested(:get, "http://127.0.0.1/avatar.jpg")
+  end
+
+  it "accepts empty HTTP chunks before image bytes while rejecting a wholly empty response" do
+    response = Net::HTTPOK.new("1.1", "200", "OK")
+    data = Rails.root.join("spec/support/fixtures/images/image1.jpeg").binread
+    allow(response).to receive(:read_body).and_yield("").and_yield(data)
+    allow(SsrfFilter).to receive(:get).and_yield(response).and_return(response)
+    expect(uploader.download("https://example.com/avatar.jpg")[:io].read).to eq(data)
+    allow(response).to receive(:read_body).and_yield("")
+    expect { uploader.download("https://example.com/avatar.jpg") }.to raise_error(described_class::Error)
+  end
+
+  it "limits remote downloads before publication" do
+    stub_request(:get, "https://example.com/avatar.jpg").to_return(
+      body: "x" * (described_class::MAX_FILE_SIZE + 1),
+    )
+    expect { uploader.download("https://example.com/avatar.jpg") }.to raise_error(described_class::Error, /8 MB/)
+  end
+end
