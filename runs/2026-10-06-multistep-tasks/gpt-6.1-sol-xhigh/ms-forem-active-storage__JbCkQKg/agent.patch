diff --git a/spec/requests/images/profile_storage_spec.rb b/spec/requests/images/profile_storage_spec.rb
new file mode 100644
index 0000000..0e41d46
--- /dev/null
+++ b/spec/requests/images/profile_storage_spec.rb
@@ -0,0 +1,74 @@
+require "rails_helper"
+
+RSpec.describe "Active Storage profile images" do
+  it "serves public image bytes through a stable URL without signing in" do
+    user = create(:user)
+    url = user.profile_image_url
+    expect(user.reload.profile_image_url).to eq(url)
+    get URI.parse(url).request_uri
+    expect(response).to have_http_status(:redirect)
+    follow_redirect!
+    expect(response).to have_http_status(:ok)
+    expect(response.body.b).to eq(user.profile_image_file.download)
+  end
+
+  %i[user organization].each do |factory|
+    it "serves a copied #{factory} picture publicly and retains its original file" do
+      path = Rails.root.join("spec/support/fixtures/images/image1.jpeg")
+      record = legacy_profile_image(factory, path)
+      legacy_path = record.profile_image.path
+      ProfileImages::Copy.new.call(record)
+      get URI.parse(record.reload.profile_image_url).request_uri
+      expect(response).to have_http_status(:redirect)
+      follow_redirect!
+      expect(response).to have_http_status(:ok)
+      expect(response.body.b).to eq(File.binread(path))
+      expect(File.binread(legacy_path)).to eq(File.binread(path))
+    end
+  end
+
+  it "analyzes uploaded images with the installed MiniMagick processor" do
+    user = create(:user)
+    ActiveStorage::AnalyzeJob.perform_now(user.profile_image_file.blob)
+    metadata = user.profile_image_file.blob.reload.metadata
+    expect(metadata["analyzed"]).to be(true)
+    expect(metadata["width"]).to be_positive
+    expect(metadata["height"]).to be_positive
+  end
+
+  %i[user organization].each do |factory|
+    it "keeps published #{factory} image URLs readable after replacing their attachment" do
+      record = create(factory)
+      old_url = record.profile_image_url
+      old_bytes = record.profile_image_file.download
+      expect(record.profile_image_file.blob.metadata["profile_image"]).to be(true)
+      expect do
+        Rails.root.join("spec/support/fixtures/images/image1.jpeg").open do |image|
+          record.update!(profile_image: image)
+        end
+      end.not_to have_enqueued_job(ActiveStorage::PurgeJob)
+      expect(record.reload.profile_image_url).not_to eq(old_url)
+      get URI.parse(old_url).request_uri
+      follow_redirect!
+      expect(response).to have_http_status(:ok)
+      expect(response.body.b).to eq(old_bytes)
+    end
+
+    it "keeps a published #{factory} image URL readable after profile deletion" do
+      record = create(factory)
+      url = record.profile_image_url
+      bytes = record.profile_image_file.download
+      expect { record.destroy! }.not_to have_enqueued_job(ActiveStorage::PurgeJob)
+      get URI.parse(url).request_uri
+      follow_redirect!
+      expect(response).to have_http_status(:ok)
+      expect(response.body.b).to eq(bytes)
+    end
+  end
+
+  it "uses the attachment for resized images and article cache snapshots" do
+    user = create(:user)
+    expect(user.profile_image_90).to eq(Images::Profile.call(user.profile_image_url, length: 90))
+    expect(Articles::CachedEntity.from_object(user).profile_image_url).to eq(user.profile_image_url)
+  end
+end
