+require "rails_helper"
+
+RSpec.describe "profile_images:copy", type: :task do
+  before { Rake::Task["profile_images:copy"].reenable }
+
+  it "copies users and organizations and can run again without duplicating blobs" do
+    user = legacy_profile_image(:user)
+    organization = legacy_profile_image(:organization)
+    tag = Rails.root.join("spec/support/fixtures/images/image1.jpeg").open do |image|
+      create(:tag, profile_image: image)
+    end
+    tag_url = tag.profile_image_url
+
+    Rake::Task["profile_images:copy"].invoke
+    expect(user.reload.profile_image_file).to be_attached
+    expect(organization.reload.profile_image_file).to be_attached
+    expect(tag.reload.profile_image_url).to eq(tag_url)
+    expect(tag.profile_image).to be_a(ProfileImageUploader)
+    Rake::Task["profile_images:copy"].reenable
+    expect { Rake::Task["profile_images:copy"].invoke }.not_to change(ActiveStorage::Blob, :count)
+  end
+
+  it "reports failures, continues copying other profiles, and retries failed profiles on rerun" do
+    missing = legacy_profile_image(:user)
+    path = missing.profile_image.path
+    data = File.binread(path)
+    File.delete(path)
+    organization = legacy_profile_image(:organization)
+
+    expect { Rake::Task["profile_images:copy"].invoke }.to raise_error(SystemExit)
+    expect(missing.reload.profile_image_file).not_to be_attached
+    expect(organization.reload.profile_image_file).to be_attached
+    File.binwrite(path, data)
+    Rake::Task["profile_images:copy"].reenable
+    Rake::Task["profile_images:copy"].invoke
+    expect(missing.reload.profile_image_file.download).to eq(data)
+  end
+end
