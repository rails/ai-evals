+require "rails_helper"
+
+RSpec.describe ProfileImages::Copy do
+  let(:image_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+
+  def legacy_record(factory)
+    record = build(factory, profile_image: nil)
+    writer = ProfileImageStorage.instance_method(:profile_image=).bind(record).super_method
+    image_path.open { |file| writer.call(file) }
+    record.save!
+    record.reload
+  end
+
+  %i[user organization].each do |factory|
+    context "with a legacy #{factory} image" do
+      it "copies the original bytes and preserves the old filename, file and URL" do
+        record = legacy_record(factory)
+        path = record.profile_image.path
+        filename = record[:profile_image]
+        old_url = record.profile_image_url
+
+        expect(described_class.new.call(record)).to eq(:copied)
+        expect(record.reload.profile_image_file.download).to eq(File.binread(image_path))
+        expect(record[:profile_image]).to eq(filename)
+        expect(File.binread(path)).to eq(File.binread(image_path))
+        expect(record.profile_image_url).not_to eq(old_url)
+        expect(record.profile_image_url).to include("/rails/active_storage/blobs/redirect/")
+        expect(record.profile_image.as_json).to eq("url" => record.profile_image_url)
+      end
+
+      it "is idempotent and does not replace an already attached image" do
+        record = legacy_record(factory)
+        copier = described_class.new
+        copier.call(record)
+        blob = record.reload.profile_image_file.blob
+        expect { copier.call(record.reload) }.not_to change(ActiveStorage::Blob, :count)
+        expect(record.reload.profile_image_file.blob).to eq(blob)
+      end
+
+      it "resumes if interrupted after publishing the attachment but before refreshing snapshots" do
+        record = legacy_record(factory)
+        article = factory == :user ? create(:article, user: record) : create(:article, organization: record)
+        column = factory == :user ? :cached_user : :cached_organization
+        copier = described_class.new
+        allow(copier).to receive(:refresh_article_images).and_raise(Interrupt)
+        expect { copier.call(record) }.to raise_error(Interrupt)
+        blob = record.reload.profile_image_file.blob
+        expect(blob.download).to eq(File.binread(image_path))
+        expect { described_class.new.call(record) }.not_to change(ActiveStorage::Blob, :count)
+        expect(record.reload.profile_image_file.blob).to eq(blob)
+        expect(article.reload.public_send(column).profile_image_url).to eq(record.profile_image_url)
+      end
+
+      it "does not validate or reprocess historical images" do
+        record = legacy_record(factory)
+        record.update_column(:name, nil)
+        expect { described_class.new.call(record.reload) }.not_to raise_error
+        expect(record.reload.profile_image_file.download).to eq(File.binread(image_path))
+        expect(record.name).to be_nil
+      end
+
+      it "keeps serving the original picture when upload fails, and retries successfully" do
+        record = legacy_record(factory)
+        url = record.profile_image_url
+        service = ActiveStorage::Blob.service
+        allow(service).to receive(:upload).and_raise(IOError, "storage unavailable")
+
+        expect { described_class.new.call(record) }.to raise_error(IOError)
+        expect(record.reload.profile_image_url).to eq(url)
+        expect(record.profile_image_file).not_to be_attached
+        allow(service).to receive(:upload).and_call_original
+        expect(described_class.new.call(record)).to eq(:copied)
+        expect(record.reload.profile_image_file.download).to eq(File.binread(image_path))
+      end
+
+      it "does not overwrite a profile picture uploaded during the copy" do
+        record = legacy_record(factory)
+        service = ActiveStorage::Blob.service
+        replacement = nil
+        allow(service).to receive(:upload).and_wrap_original do |upload, *args, **kwargs|
+          allow(service).to receive(:upload).and_call_original
+          image_path.open { |file| record.class.find(record.id).update!(profile_image: file) }
+          replacement = record.class.find(record.id).profile_image_file.blob
+          upload.call(*args, **kwargs)
+        end
+        expect(described_class.new.call(record)).to eq(:skipped)
+        expect(record.reload.profile_image_file.blob).to eq(replacement)
+        expect(ActiveStorage::Blob.where(id: replacement.id).count).to eq(1)
+      end
+
+      it "does not attach a stale source if an old application changed the filename during copying" do
+        record = legacy_record(factory)
+        service = ActiveStorage::Blob.service
+        allow(service).to receive(:upload).and_wrap_original do |upload, *args, **kwargs|
+          record.class.where(id: record.id).update_all(profile_image: "new-legacy-image.jpg")
+          upload.call(*args, **kwargs)
+        end
+        expect { described_class.new.call(record) }.to raise_error(described_class::SourceChanged)
