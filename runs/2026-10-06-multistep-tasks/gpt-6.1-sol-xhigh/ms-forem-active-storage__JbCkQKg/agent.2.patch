+        expect { described_class.new.call(record) }.to raise_error(ProfileImages::Copy::MissingSource)
+        expect(record.reload.profile_image_file).not_to be_attached
+      end
+    end
+  end
+
+  it "does not duplicate attachments when another copier publishes during the upload" do
+    record = legacy_record(:user)
+    service = ActiveStorage::Blob.service
+    allow(service).to receive(:upload).and_wrap_original do |upload, *args, **kwargs|
+      allow(service).to receive(:upload).and_call_original
+      described_class.new.call(User.find(record.id))
+      upload.call(*args, **kwargs)
+    end
+    expect { described_class.new.call(record) }.to change(ActiveStorage::Blob, :count).by(1)
+    expect(ActiveStorage::Attachment.where(record: record, name: "profile_image_file").count).to eq(1)
+  end
+
+  context "with private CarrierWave Fog storage" do
+    let(:credentials) do
+      { provider: "AWS", aws_access_key_id: "test", aws_secret_access_key: "test", region: "us-east-2" }
+    end
+    let(:connection) { Fog::Storage.new(**credentials) }
+
+    before do
+      Fog.mock!
+      connection.put_bucket("legacy-profile-images")
+      allow(ProfileImageUploader).to receive_messages(
+        storage: CarrierWave::Storage::Fog,
+        fog_credentials: credentials,
+        fog_directory: "legacy-profile-images",
+        fog_public: false,
+        asset_host: "https://example.com/remoteimages",
+      )
+    end
+
+    after { Fog.unmock! }
+
+    it "copies private objects through storage without fetching their public URLs" do
+      user = create(:user, profile_image: nil)
+      filename = "legacy-avatar.jpeg"
+      key = "uploads/user/profile_image/#{user.id}/#{filename}"
+      data = File.binread(image_path)
+      connection.put_object("legacy-profile-images", key, data, "Content-Type" => "image/jpeg")
+      user.update_column(:profile_image, filename)
+      user.reload
+      old_url = user.profile_image_url
+      expect(old_url).to include("/remoteimages/")
+      expect(described_class.new.call(user)).to eq(:copied)
+      expect(user.reload.profile_image_file.download).to eq(data)
+      expect(connection.get_object("legacy-profile-images", key).body).to eq(data)
+      expect(WebMock).not_to have_requested(:get, old_url)
