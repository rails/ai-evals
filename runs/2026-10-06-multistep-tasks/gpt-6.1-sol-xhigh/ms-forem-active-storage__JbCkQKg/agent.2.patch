+    article.update_columns(cached_user: old_user_snapshot)
+    expect { copier.call(user.reload) }.not_to change(ActiveStorage::Blob, :count)
+    expect(article.reload.cached_user.profile_image_url).to eq(user.profile_image_url)
+  end
+end
