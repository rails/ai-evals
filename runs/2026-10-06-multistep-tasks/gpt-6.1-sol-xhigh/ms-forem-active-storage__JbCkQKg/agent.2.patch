+    expect(user.reload.profile_image_file).not_to be_attached
+  end
+
+  it "does not modify an article that changed authors before its snapshot was locked" do
+    user = legacy_record(:user)
+    new_author = create(:user)
+    article = create(:article, user: user)
+    allow(user.articles).to receive(:find_each).and_yield(article)
+    article.update!(user: new_author)
+    described_class.new.call(user)
+    expect(article.reload.cached_user.profile_image_url).to eq(new_author.profile_image_url)
+  end
+
+  it "refreshes both article snapshots, including when a previous copy was interrupted after attaching" do
+    user = legacy_record(:user)
