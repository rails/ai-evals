+      when "draw"
+        if count.positive?
+          cutoff = eligible[count - 1][:points]
+          guaranteed = eligible.select { |row| row[:points] > cutoff }
+          tied = eligible.select { |row| row[:points] == cutoff }
+          guaranteed + tied.sample(count - guaranteed.size, random: random)
+        else
+          []
+        end
+      else
+        []
+      end
+      players.where(winner: true).update_all(winner: false)
+      players.where(id: winners.map { |row| row[:player_id] }).update_all(winner: true)
