diff --git a/db/migrate/20260103000000_add_scoring_and_prizes.rb b/db/migrate/20260103000000_add_scoring_and_prizes.rb
new file mode 100644
index 0000000..a22e77f
--- /dev/null
+++ b/db/migrate/20260103000000_add_scoring_and_prizes.rb
@@ -0,0 +1,29 @@
+class AddScoringAndPrizes < ActiveRecord::Migration[8.1]
+  def change
+    add_column :quizzes, :number_of_winners, :integer, default: 3, null: false
+    add_check_constraint :quizzes, "number_of_winners >= 1", name: "quiz_winner_count_positive"
+    add_column :games, :number_of_winners, :integer, default: 3, null: false
+    add_check_constraint :games, "number_of_winners >= 1", name: "game_winner_count_positive"
+    add_column :game_questions, :opened_at, :datetime, precision: 6
+    add_column :answers, :picked_at, :datetime, precision: 6
+    add_column :answers, :elapsed_microseconds, :bigint, default: 0, null: false
+    add_check_constraint :answers, "elapsed_microseconds >= 0", name: "answer_time_nonnegative"
+    add_column :players, :winner, :boolean, default: false, null: false
+
+    # Existing open questions can continue accepting answers after an upgrade.
+    # Older completed questions did not record opening times; their speed stays 0.
+    reversible do |dir|
+      dir.up do
+        execute <<~SQL
+          UPDATE game_questions SET opened_at = (
+            SELECT games.updated_at FROM games WHERE games.id = game_questions.game_id
+          ) WHERE EXISTS (
+            SELECT 1 FROM games WHERE games.id = game_questions.game_id
+              AND games.current_index = game_questions.position AND games.status = 'open'
+          )
+        SQL
+        execute "UPDATE answers SET picked_at = updated_at"
+      end
+    end
+  end
+end
