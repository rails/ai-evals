+      .group(:player_id)
+      .pluck(:player_id, Arel.sql("COUNT(*)"), Arel.sql("SUM(answers.elapsed_microseconds)"))
+      .to_h { |player_id, points, elapsed| [ player_id, [ points, elapsed ] ] }
