+<% if data[:status] == "waiting" %>
+  <section class="lobby">
+    <div>
+      <p class="screen__kicker">Get ready to play</p>
+      <h1 class="screen__title"><%= data[:title] %></h1>
+      <p class="lobby__hint">Join on your phone</p>
+      <p class="lobby__url join-url"><%= @join_url %></p>
+      <p class="lobby__players" aria-live="polite">Players: <%= data[:players] %></p>
+    </div>
+    <div class="qr" role="img" aria-label="QR code: <%= @join_url %>"><%= join_qr(@join_url) %></div>
+  </section>
+  <div class="game-controls">
+    <%= button_to "Start", start_moderate_game_path(@game), class: "btn btn--sun btn--lg", form: { data: { live_action: true } } %>
+  </div>
+<% elsif data[:status] == "ended" %>
+  <section class="game-over"><h1 class="screen__title">The quiz is over</h1><p>Thanks for playing!</p></section>
+<% else %>
+  <section class="stage-question">
+    <p class="stage-question__num">Question <%= data[:number] %> of <%= data[:total] %></p>
+    <h1 class="stage-question__body"><%= data[:text] %></h1>
+    <ol class="stage-options <%= 'stage-options--results' if data[:status] == 'closed' %>">
+      <% data[:options].each_with_index do |option, index| %>
+        <li class="stage-option <%= 'is-correct' if option[:correct] %>">
+          <span class="stage-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+          <span class="stage-option__title"><%= option[:text] %></span>
+          <% if data[:status] == 'closed' %>
+            <span class="stage-option__count" aria-label="<%= option[:count] %> answers"><%= option[:count] %></span>
+            <% if option[:correct] %><span class="stage-option__mark">Correct</span><% end %>
+          <% end %>
+        </li>
+      <% end %>
+    </ol>
+  </section>
+  <div class="game-controls">
+    <% if data[:status] == 'open' %>
+      <p class="answers-counter" aria-live="polite">Answers: <%= data[:answers] %> / <%= data[:players] %></p>
+      <%= button_to "Finish", finish_moderate_game_path(@game), params: { question_id: data[:question_id] }, class: "btn btn--sun btn--lg", form: { data: { live_action: true } } %>
+    <% elsif data[:number] == data[:total] %>
+      <%= button_to "End quiz", end_moderate_game_path(@game), params: { question_id: data[:question_id] }, class: "btn btn--sun btn--lg", form: { data: { live_action: true } } %>
+    <% else %>
+      <%= button_to "Next", next_moderate_game_path(@game), params: { question_id: data[:question_id] }, class: "btn btn--sun btn--lg", form: { data: { live_action: true } } %>
+    <% end %>
+  </div>
+<% end %>
