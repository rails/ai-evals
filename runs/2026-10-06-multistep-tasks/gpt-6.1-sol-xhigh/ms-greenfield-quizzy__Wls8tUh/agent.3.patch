new file mode 100644
index 0000000..39bbe01
--- /dev/null
+++ b/app/views/play/_state.html.erb
@@ -0,0 +1,47 @@
+<% if data[:status] == "ended" %>
+  <section class="waiting game-over"><h1 class="play-title">The quiz is over</h1><p class="play-lead">Thanks for playing!</p></section>
+<% elsif !data[:joined] %>
+  <section class="join-screen">
+    <h1 class="play-title"><%= data[:title] %></h1>
+    <p class="play-lead">Join the live quiz</p>
+    <% if @join_error %><p class="join-error" role="alert"><%= @join_error %></p><% end %>
+    <%= form_with url: join_play_path(code: @game.code), class: "join-form" do |form| %>
+      <%= form.label :name, "Your name" %>
+      <%= form.text_field :name, value: @submitted_name, placeholder: "Your name", class: "input", required: true, maxlength: 80, autocomplete: "nickname" %>
+      <%= form.button "Join", class: "btn" %>
+    <% end %>
+  </section>
+<% elsif data[:status] == "waiting" %>
+  <section class="waiting">
+    <div class="waiting__gem" aria-hidden="true">?</div>
+    <h1 class="play-title player-name">Hi, <%= data[:name] %>!</h1>
+    <p class="play-lead">Waiting for the quiz to start…</p>
+    <p>You’re in. Keep this page open.</p>
+  </section>
+<% else %>
+  <p class="player-name">Hi, <%= data[:name] %>!</p>
+  <p class="play-question__num">Question <%= data[:number] %> of <%= data[:total] %></p>
+  <h1 class="play-question__body"><%= data[:text] %></h1>
+  <ol class="play-options live-options">
+    <% data[:options].each_with_index do |option, index| %>
+      <% selected = data[:selected] == option[:id] %>
+      <li>
+        <%= form_with url: answer_play_path(code: @game.code), data: { live_action: true } do |form| %>
+          <%= form.hidden_field :question_id, value: data[:question_id] %>
+          <%= form.hidden_field :option_id, value: option[:id] %>
+          <button type="submit" class="play-option <%= 'is-selected' if selected %> <%= 'is-correct' if option[:correct] %>" aria-label="<%= option[:text] %>" aria-pressed="<%= selected %>" <%= 'disabled' if data[:status] == 'closed' %>>
+            <span class="play-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+            <span class="play-option__title"><%= option[:text] %></span>
+            <% if selected %><span class="play-option__mark">Your answer</span><% end %>
+          </button>
+        <% end %>
+      </li>
+    <% end %>
+  </ol>
+  <% if data[:status] == "closed" %>
+    <p class="play-status <%= data[:feedback] == 'Correct!' ? 'play-status--correct' : 'play-status--wrong' %>" role="status"><%= data[:feedback] %></p>
+    <p class="play-lead">Waiting for the moderator…</p>
+  <% else %>
+    <p class="answer-hint">Tap an option. You can change your answer until the moderator closes the question.</p>
+  <% end %>
+<% end %>
