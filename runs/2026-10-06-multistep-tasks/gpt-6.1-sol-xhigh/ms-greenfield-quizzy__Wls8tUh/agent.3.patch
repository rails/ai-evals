diff --git a/app/channels/game_channel.rb b/app/channels/game_channel.rb
new file mode 100644
index 0000000..3f0cfe6
--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,26 @@
+class GameChannel < ApplicationCable::Channel
+  def subscribed
+    @game = Game.find_by(code: params[:code])
+    return reject unless @game
+    stream_from "game:#{@game.id}"
+    stream_from "game-counts:#{@game.id}" if params[:moderator] == true
+    @player = @game.players.find_by(browser_token: connection.browser_token) if connection.browser_token
+    stream_from "player:#{@player.id}" if @player
+    if @player && !@game.ended?
+      @presence = @player.connect!
+    end
+  end
+
+  def heartbeat
+    return unless @presence && !@game.reload.ended?
+    @player.heartbeat!(@presence.id)
+  rescue ActiveRecord::RecordNotFound
+    # A moderator can delete a quiz while a phone is connected.
+  end
+
+  def unsubscribed
+    return unless @presence
+    @player.disconnect!(@presence.id)
+  rescue ActiveRecord::RecordNotFound
+  end
+end
