diff --git a/app/assets/javascripts/live.js b/app/assets/javascripts/live.js
new file mode 100644
index 0000000..f39c612
--- /dev/null
+++ b/app/assets/javascripts/live.js
@@ -0,0 +1,156 @@
+(() => {
+  "use strict";
+  const root = document.querySelector("[data-live]");
+  if (!root) return;
+  const status = document.querySelector("[data-connection-status]");
+  let key = root.dataset.key;
+  let connected = false;
+  let stopped = root.dataset.status === "ended";
+  let fetching = false;
+  let refreshAgain = false;
+  let posting = false;
+  let pendingPick = null;
+  let pollTimer;
+  let heartbeatTimer;
+  let failures = 0;
+  let mutationEpoch = 0;
+
+  function message(text) {
+    status.textContent = text;
+    status.hidden = !text;
+  }
+
+  function apply(data) {
+    if (data.key === key) return;
+    // An anonymous visitor can be typing their name while questions change.
+    if (root.dataset.player !== undefined && root.dataset.joined === "false" && data.status !== "ended") return;
+    key = data.key;
+    root.dataset.status = data.status;
+    const focus = document.activeElement;
+    const focusedChoice = root.contains(focus) ? focus.getAttribute("aria-label") : null;
+    root.innerHTML = data.html;
+    if (focusedChoice) {
+      const replacement = [...root.querySelectorAll("button[aria-label]")].find(button => button.getAttribute("aria-label") === focusedChoice);
+      replacement?.focus({ preventScroll: true });
+    }
+    if (data.status === "ended") {
+      stopped = true;
+      clearTimeout(pollTimer);
+      clearInterval(heartbeatTimer);
+      consumer.disconnect();
+      message("");
+    }
+  }
+
+  async function fetchState() {
+    if (stopped) return;
+    if (fetching || posting) { refreshAgain = true; return; }
+    fetching = true;
+    const epoch = mutationEpoch;
+    try {
+      const url = new URL(root.dataset.stateUrl, location.href);
+      url.searchParams.set("key", key);
+      const response = await fetch(url, { credentials: "same-origin", cache: "no-store", headers: { Accept: "application/json" }, signal: AbortSignal.timeout(12000) });
+      if (response.status === 404) { stopped = true; clearInterval(heartbeatTimer); clearTimeout(pollTimer); consumer.disconnect(); message("This game is no longer available."); return; }
+      if (!response.ok) throw new Error("Connection interrupted");
+      if (response.status !== 204) {
+        const data = await response.json();
+        if (epoch === mutationEpoch) apply(data);
+        else refreshAgain = true;
+      }
+      failures = 0;
+      if (!stopped) message(connected ? "" : "Reconnecting live updates…");
+    } catch (_) {
+      failures++;
+      message("Connection interrupted. Reconnecting…");
+    } finally {
+      fetching = false;
+      if (refreshAgain && !posting) { refreshAgain = false; scheduleRefresh(); }
+    }
+  }
+
+  // Jitter spreads resync traffic, with short fallback polls only when Cable
+  // cannot connect. One in-flight request per screen; missed events coalesce.
+  let refreshTimer = null;
+  function scheduleRefresh() {
+    if (refreshTimer !== null || stopped) return;
+    refreshTimer = setTimeout(() => {
+      refreshTimer = null;
+      fetchState();
+    }, 100 + Math.random() * 100);
+  }
+  function poll() {
+    if (stopped) return;
+    fetchState();
+    const delay = connected ? 25000 : Math.min(15000, 2500 * (2 ** Math.min(failures, 3)));
+    pollTimer = setTimeout(poll, delay + Math.random() * 2500);
+  }
+
+  const consumer = ActionCable.createConsumer(`${location.protocol === "https:" ? "wss:" : "ws:"}//${location.host}/cable`);
+  const subscription = consumer.subscriptions.create({ channel: "GameChannel", code: root.dataset.code, moderator: root.dataset.player === undefined }, {
+    connected() { connected = true; message(""); scheduleRefresh(); },
+    disconnected() {
+      connected = false;
+      if (!stopped) {
+        message("Reconnecting live updates…");
+        scheduleRefresh();
+        clearTimeout(pollTimer);
+        pollTimer = setTimeout(poll, 1000 + Math.random() * 1000);
+      }
+    },
+    rejected() { connected = false; message("Live connection unavailable. Checking for updates…"); },
+    received() { scheduleRefresh(); }
+  });
+
+  async function postAction(action) {
+    posting = true;
+    mutationEpoch++;
+    try {
+      const response = await fetch(action.url, {
+        method: "POST", body: action.body, credentials: "same-origin", cache: "no-store",
+        headers: { Accept: "application/json", "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content },
+        signal: AbortSignal.timeout(12000)
+      });
+      if (!response.ok && response.status !== 409) throw new Error("Answer not saved");
+      apply(await response.json());
+      message("");
+    } catch (_) {
+      // Never silently claim an answer was saved and never retry a stale pick.
+      message("Could not save. Check your connection and try again.");
+    } finally {
+      posting = false;
+      if (pendingPick) {
+        const next = pendingPick;
+        pendingPick = null;
+        postAction(next);
+      } else {
+        root.querySelectorAll(".game-controls button").forEach(button => { button.disabled = false; });
+        if (refreshAgain) { refreshAgain = false; scheduleRefresh(); }
+      }
+    }
+  }
+
+  root.addEventListener("submit", event => {
+    const form = event.target;
+    if (!form.matches("[data-live-action]")) return;
+    event.preventDefault();
+    const action = { url: form.action, body: new FormData(form) };
+    if (posting) {
+      if (action.body.has("option_id")) pendingPick = action; // last tap wins, in order
+      return;
+    }
+    root.querySelectorAll(".game-controls button").forEach(button => { button.disabled = true; });
+    postAction(action);
+  });
+
+  window.addEventListener("online", scheduleRefresh);
+  document.addEventListener("visibilitychange", () => {
+    if (!document.hidden && !stopped) { subscription.perform("heartbeat"); scheduleRefresh(); }
+  });
+  if (!stopped) {
+    heartbeatTimer = setInterval(() => { if (connected) subscription.perform("heartbeat"); }, 15000 + Math.random() * 2500);
+    pollTimer = setTimeout(poll, 2000 + Math.random() * 1000);
+  } else {
+    consumer.disconnect();
+  }
+})();
