@@ -0,0 +1,232 @@
+# Run against bin/serve. Independent Chromium sessions represent conference phones.
+require "capybara/dsl"
+require "capybara/cuprite"
+require "minitest/autorun"
+require "capybara/minitest"
+require "securerandom"
+require "json"
+
+Capybara.register_driver(:cuprite) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: "/usr/bin/chromium", window_size: [ 1440, 1000 ],
+    browser_options: { "no-sandbox" => nil }, js_errors: true)
+end
+Capybara.configure do |config|
+  config.default_driver = :cuprite
+  config.app_host = ENV.fetch("QUIZZY_TEST_URL", "http://localhost:3000")
+  config.run_server = false
+  config.enable_aria_label = true
+  config.default_max_wait_time = 8
+  config.save_path = File.expand_path("../storage/screenshots", __dir__)
+end
+
+class LiveBrowserSmokeTest < Minitest::Test
+  include Capybara::DSL
+  include Capybara::Minitest::Assertions
+
+  def as(name, &block)
+    Capybara.using_session(name, &block)
+  end
+
+  def join(name)
+    as(name.downcase.to_sym) do
+      page.current_window.resize_to(390, 844)
+      visit @join_url
+      fill_in "Your name", with: name
+      click_button "Join"
+      assert_text "Hi, #{name}!"
+      page.execute_script("window.noReloadMarker = 'phone'")
+    end
+  end
+
+  def moderator(&block)
+    as(:moderator, &block)
+  end
+
+  def assert_not_reloaded(marker)
+    assert_equal marker, page.evaluate_script("window.noReloadMarker")
+  end
+
+  def test_live_game_on_independent_phones
+    moderator do
+      page.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD"))
+      visit "/moderate/quizzes/import"
+      title = "Live browser #{SecureRandom.hex(4)}"
+      questions = [
+        { text: "Pick a primary color", options: [ { text: "Red", correct: true }, { text: "Blue", correct: true }, { text: "Green" } ] },
+        { text: "This inactive question must not appear", active: false, options: [ { text: "Hidden", correct: true }, { text: "Also hidden" } ] },
+        { text: "What is two plus two?", options: [ { text: "Four", correct: true }, { text: "Five" } ] },
+        { text: "Final question", options: [ { text: "Yes", correct: true }, { text: "No" } ] }
+      ]
+      fill_in "Quiz JSON", with: JSON.generate(title: title, questions: questions)
+      click_button "Import"
+      @quiz_path = URI(page.current_url).path
+      click_button "Start a game"
+      assert_text title
+      @join_url = find(".join-url").text
+      @game_path = URI(page.current_url).path
+      assert_text "Players: 0"
+      assert_selector ".qr svg"
+      page.execute_script("window.noReloadMarker = 'moderator'")
+    end
+    join("Alice")
+    join("Bob")
+    moderator do
+      assert_text "Players: 2"
+      page.save_screenshot("live-lobby.png")
+      click_button "Start"
+      assert_text "Question 1 of 3"
+      assert_text "Answers: 0 / 2"
+      assert_not_reloaded("moderator")
+    end
+    as(:alice) do
+      assert_text "Pick a primary color"
+      refute_match(/is-correct|Correct!|\"correct\"/, page.html)
+      click_button "Green"
+      assert_selector "button[aria-label=Green]", text: "Your answer"
+      # Queue rapid taps without waiting for the first HTTP reply.
+      page.execute_script('document.querySelector("button[aria-label=Red]").click(); document.querySelector("button[aria-label=Blue]").click();')
+
+      assert_selector "button[aria-label=Blue]", text: "Your answer"
+      refute_selector "button[aria-label=Green]", text: "Your answer"
+      assert_not_reloaded("phone")
+      # Same browser opens the link again: resume the very same player and pick.
+      visit @join_url
+      assert_text "Hi, Alice!"
+      assert_selector "button[aria-label=Blue]", text: "Your answer"
+      page.execute_script("window.noReloadMarker = 'phone'")
+    end
+    moderator { assert_text "Answers: 1 / 2" }
+    as(:bob) do
+      assert_text "Pick a primary color"
+      click_button "Green"
+      assert_text "Your answer"
+      # Another tab is still just one player.
+      second = open_new_window
+      within_window(second) { visit @join_url; assert_text "Hi, Bob!" }
+      second.close
+    end
+    moderator { assert_text "Answers: 2 / 2" }
+    as(:bob) { visit "about:blank" }
+    moderator { assert_text "Answers: 1 / 1" }
+    as(:bob) { visit @join_url; assert_selector "button[aria-label=Green]", text: "Your answer"; page.execute_script("window.noReloadMarker = 'phone'") }
+    moderator do
+      assert_text "Answers: 2 / 2"
+      click_button "Finish"
+      assert_selector ".stage-option.is-correct", count: 2
+      within(find(".stage-option", text: "Blue")) { assert_text "1"; assert_text "Correct" }
+      within(find(".stage-option", text: "Green")) { assert_text "1" }
+      page.save_screenshot("live-results.png")
+      assert_not_reloaded("moderator")
+    end
+    as(:alice) { assert_text "Correct!"; assert_not_reloaded("phone") }
+    as(:bob) { assert_text "Wrong!"; assert_not_reloaded("phone") }
+    join("Charlie") # Join even while results are showing.
+    as(:charlie) { assert_text "No answer" }
+    moderator { click_button "Next"; assert_text "Question 2 of 3"; assert_text "Answers: 0 / 3" }
+    as(:alice) do
+      assert_text "What is two plus two?"
+      click_button "Four"
+      assert_text "Your answer"
+      page.save_screenshot("live-phone.png")
+    end
+    moderator { assert_text "Answers: 1 / 3"; click_button "Finish" }
+    as(:alice) { assert_text "Correct!" }
+    as(:bob) { assert_text "No answer" }
+    moderator do
+      click_button "Next"
+      assert_text "Question 3 of 3"
+      refute_text "inactive question"
+      click_button "Finish"
+      assert_button "End quiz"
+      refute_button "Next"
+      click_button "End quiz"
+      assert_text "The quiz is over"
+      assert_not_reloaded("moderator")
+    end
+    [ :alice, :bob, :charlie ].each do |name|
+      as(name) { assert_text "The quiz is over"; refute_button "Join"; assert_not_reloaded("phone") }
+    end
+    as(:late) { visit @join_url; assert_text "The quiz is over"; refute_field "Your name"; refute_button "Join" }
+    moderator do
+      visit @quiz_path
+      click_button "Start a game"
+      assert_text "Players: 0"
+      refute_equal @game_path, URI(page.current_url).path
+      refute_equal @join_url, find(".join-url").text
+      visit @quiz_path
+      click_link "Settings"
+      accept_confirm { click_button "Delete quiz" }
+      assert_text "Quiz deleted"
+    end
+  end
+
+  def test_socket_failure_fallback_and_reconnect_without_reload
+    moderator do
+      page.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD"))
+      visit "/moderate/quizzes/import"
+      fill_in "Quiz JSON", with: JSON.generate(title: "Reconnect #{SecureRandom.hex(4)}", questions: [
+        { text: "Reconnect first", options: [ { text: "Right", correct: true }, { text: "Wrong" } ] },
+        { text: "Reconnect second", options: [ { text: "Yes", correct: true }, { text: "No" } ] }
+      ])
+      click_button "Import"
+      @quiz_path = URI(page.current_url).path
+      click_button "Start a game"
+      @join_url = find(".join-url").text
+    end
+    as(:reconnect) do
+      page.driver.browser.evaluate_on_new_document <<~JS
+      window.testSockets = [];
+      window.forceSocketFailure = false;
+      const OriginalWebSocket = window.WebSocket;
+      window.WebSocket = class extends OriginalWebSocket {
+        constructor(...args) {
+          super(...args);
+          window.testSockets.push(this);
+          this.addEventListener("open", () => { if (window.forceSocketFailure) this.close(); });
+        }
+      };
+    JS
+      visit @join_url
+      fill_in "Your name", with: "Reconnecting player"
+      click_button "Join"
+      assert_text "Hi, Reconnecting player!"
+      page.execute_script("window.noReloadMarker = 'phone'")
+    end
+    moderator { assert_text "Players: 1" }
+    as(:reconnect) do
+      page.execute_script("window.forceSocketFailure = true; window.testSockets.forEach(socket => socket.close());")
+      assert_text "Reconnecting"
+    end
+    moderator { click_button "Start" }
+    as(:reconnect) do
+      assert_text "Reconnect first"
+      click_button "Right"
+      assert_text "Your answer"
+      assert_not_reloaded("phone")
+    end
+    moderator { assert_text "Answers: 1 / 1"; click_button "Finish" }
+    as(:reconnect) do
+      assert_text "Correct!" # arrives through HTTP while the socket is blocked
+      page.execute_script("window.forceSocketFailure = false")
+      assert_no_selector "[data-connection-status]", visible: true, wait: 25
+      assert_not_reloaded("phone")
+    end
+    moderator { click_button "Next" }
+    as(:reconnect) { assert_text "Reconnect second", wait: 2; assert_not_reloaded("phone") }
+    moderator { click_button "Finish"; click_button "End quiz" }
+    as(:reconnect) { assert_text "The quiz is over"; assert_not_reloaded("phone") }
+    moderator do
+      visit @quiz_path
+      click_link "Settings"
+      accept_confirm { click_button "Delete quiz" }
+      assert_text "Quiz deleted"
+    end
+  end
+
+  def teardown
+    if failures.any?
+      moderator { page.save_screenshot("live-failure.png"); File.write(File.join(Capybara.save_path, "live-failure.html"), page.html) }
+    end
+    Capybara.reset_sessions!
+    end
+end
