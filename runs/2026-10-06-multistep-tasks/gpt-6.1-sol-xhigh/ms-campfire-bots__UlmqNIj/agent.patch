+++ b/test/lib/rails_ext/bot_credential_filtering_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class BotCredentialFilteringTest < ActiveSupport::TestCase
+  test "bot codes are redacted from request paths, parameters, and environment" do
+    env = Rack::MockRequest.env_for("https://chat.example.com/rooms/123/sensitive-code/messages?foo=bar")
+    env["action_dispatch.parameter_filter"] = Rails.application.config.filter_parameters
+    request = ActionDispatch::Request.new(env)
+    request.path_parameters = { bot_token: "sensitive-code" }
+
+    assert_equal "/rooms/123/[FILTERED]/messages?foo=bar", request.filtered_path
+    assert_equal "[FILTERED]", request.filtered_parameters[:bot_token]
+    assert_not_includes request.filtered_env.values.join, "sensitive-code"
+  end
+
+test "bot codes are redacted from telemetry URLs and referrers" do
+  env = Rack::MockRequest.env_for("https://chat.example.com/rooms/123/sensitive-code/messages")
+  env["HTTP_REFERER"] = "https://chat.example.com/rooms/123/sensitive-code/messages"
+  event = Sentry::Event.new(configuration: Sentry::Configuration.new)
+  event.rack_env = env
+
+  assert_same event, BotCredentialFiltering.filter_event(event, {})
+  assert_equal "https://chat.example.com/rooms/123/[FILTERED]/messages", event.request.url
+  assert_not_includes event.request.to_hash.to_s, "sensitive-code"
+end
+
+  test "ordinary message paths are unchanged" do
+    request = ActionDispatch::Request.new(Rack::MockRequest.env_for("/rooms/123/messages/456"))
+    assert_equal "/rooms/123/messages/456", request.filtered_path
+  end
+end
