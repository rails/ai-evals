--- /dev/null
+++ b/test/system/bot_safeguards_test.rb
@@ -0,0 +1,48 @@
+require "application_system_test_case"
+
+class BotSafeguardsTest < ApplicationSystemTestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Failing Bot")
+    rooms(:hq).memberships.grant_to @bot
+    10.times { @bot.record_bot_webhook_delivery(success: false) }
+  end
+
+  test "administrators reactivate suspended bots with a native confirmation" do
+    sign_in "david@37signals.com"
+    visit bots_url
+    assert_text "Failing Bot"
+    assert_text "Suspended"
+    assert_text "Webhooks: ten consecutive failed deliveries."
+
+    dismiss_confirm do
+      click_on "Reactivate"
+    end
+    assert_text "Suspended"
+    assert @bot.reload.suspended?
+
+    accept_confirm do
+      click_on "Reactivate"
+    end
+    assert_current_path bots_path
+    assert_no_text "Suspended"
+    assert_no_button "Reactivate"
+    assert_text "Failing Bot"
+    assert @bot.reload.active?
+  end
+
+  test "members see the reason but cannot reactivate their bots" do
+    sign_in "jz@37signals.com"
+    visit bots_url
+    assert_text "Failing Bot"
+    assert_text "Suspended"
+    assert_text "Webhooks: ten consecutive failed deliveries."
+    assert_no_button "Reactivate"
+    click_on "Edit Failing Bot"
+    fill_in "Name the bot", with: "Renamed Bot"
+    click_on "Save changes"
+    assert_current_path bots_path
+    assert_text "Renamed Bot"
+    assert_text "Suspended"
+    assert @bot.reload.suspended?
+  end
+end
diff --git a/test/system/managing_bots_test.rb b/test/system/managing_bots_test.rb
new file mode 100644
index 0000000..4301804
--- /dev/null
+++ b/test/system/managing_bots_test.rb
@@ -0,0 +1,118 @@
+require "application_system_test_case"
+
+class ManagingBotsTest < ApplicationSystemTestCase
+  setup do
+    sign_in "jz@37signals.com"
+  end
+
+  test "members create, rename, and delete bots with native confirmation" do
+    visit edit_account_url
+    click_on "Set up chat bots"
+    assert_current_path bots_path
+
+    click_on "Add a chat bot"
+    assert_unchecked_field "Add to all open rooms", visible: :all
+    fill_in "Name the bot", with: "Deploy Bot"
+    fill_in "Webhook URL", with: "https://bot.example.com/mentions"
+    click_on "Save changes"
+    assert_current_path bots_path
+
+    bot = User.bot.find_by!(name: "Deploy Bot")
+    assert_field "Bot code", with: bot.bot_token, readonly: true
+    click_on "Edit Deploy Bot"
+    assert_field "Webhook URL", with: "https://bot.example.com/mentions"
+    fill_in "Webhook URL", with: ""
+    fill_in "Name the bot", with: "Release Bot"
+    click_on "Save changes"
+    assert_current_path bots_path
+    assert_text "Release Bot"
+    assert_nil bot.reload.webhook_url
+
+    click_on "Edit Release Bot"
+    dismiss_confirm do
+      click_on "Delete this chat bot"
+    end
+    assert_current_path edit_bot_path(bot)
+    assert User.exists?(bot.id)
+
+    accept_confirm do
+      click_on "Delete this chat bot"
+    end
+    assert_current_path bots_path
+    assert_no_text "Release Bot"
+    assert_not User.exists?(bot.id)
+  end
+
+  test "bots appear in mention suggestions and mentioning one queues a webhook" do
+    bot = users(:jz).bots.create!(name: "Deploy Bot", webhook_url: "https://bot.example.com/mentions")
+    rooms(:hq).memberships.grant_to bot
+    join_room rooms(:hq)
+
+    editor = find("trix-editor")
+    editor.click
+    editor.send_keys "@Dep"
+    find("suggestion-option", text: "Deploy Bot").click
+    assert_selector "trix-editor .mention", text: "Deploy Bot"
+    editor.send_keys "restart the build please"
+
+    assert_enqueued_jobs 1, only: User::Bot::WebhookJob do
+      click_on "send"
+      assert_selector ".message[data-message-id]", text: "restart the build please"
+    end
+    message = rooms(:hq).messages.last
+    assert_includes message.mentionees, bot
+  end
+
+  test "bots can be added to closed rooms like people" do
+    bot = users(:jz).bots.create!(name: "Deploy Bot")
+    room = rooms(:designers)
+    room.update!(creator: users(:jz))
+    visit edit_rooms_closed_url(room)
+    check "Give Deploy Bot access to this room", allow_label_click: true
+    click_on "Save"
+    assert_current_path room_path(room)
+    assert room.users.exists?(bot.id)
+  end
+  test "authors opt into all open rooms and turning the switch off keeps current memberships" do
+    visit new_bot_url
+    assert_unchecked_field "Add to all open rooms", visible: :all
+    fill_in "Name the bot", with: "Everyone Bot"
+    check "Add to all open rooms", allow_label_click: true
+    click_on "Save changes"
+    assert_current_path bots_path
+    bot = User.bot.find_by!(name: "Everyone Bot")
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+
+    room = Rooms::Open.create!(name: "Future room", creator: users(:david))
+    assert room.users.exists?(bot.id)
+    click_on "Edit Everyone Bot"
+    assert_checked_field "Add to all open rooms", visible: :all
+    uncheck "Add to all open rooms", allow_label_click: true
+    click_on "Save changes"
+    assert_current_path bots_path
+    assert_not bot.reload.auto_join_open_rooms?
+    assert room.users.exists?(bot.id)
+    later_room = Rooms::Open.create!(name: "Later room", creator: users(:david))
+    assert_not later_room.users.exists?(bot.id)
+  end
+
+  test "authors can choose individual open rooms for a bot" do
+    bot = users(:jz).bots.create!(name: "Selective Bot")
+    room = rooms(:hq)
+    room.update!(creator: users(:jz))
+    visit edit_rooms_open_url(room)
+    assert_unchecked_field "Give Selective Bot access to this room", visible: :all
+    check "Give Selective Bot access to this room", allow_label_click: true
+    click_on "Save"
+    assert_current_path room_path(room)
+    assert room.users.exists?(bot.id)
+    assert_not rooms(:pets).users.exists?(bot.id)
+
+    visit edit_rooms_open_url(room)
+    assert_checked_field "Give Selective Bot access to this room", visible: :all
+    uncheck "Give Selective Bot access to this room", allow_label_click: true
+    click_on "Save"
+    assert_current_path room_path(room)
+    assert_not room.users.exists?(bot.id)
+  end
+end
