+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+
+    get edit_bot_url(bot)
+    assert_select "input[type='checkbox'][name='bot[auto_join_open_rooms]']:not([checked])"
+  end
+
+  test "enabling automatic joining on an existing bot grants access" do
+    bot = users(:jz).bots.create!(name: "Selective Bot")
+    assert_empty bot.rooms
+    patch bot_url(bot), params: { bot: { auto_join_open_rooms: "1" } }
+    assert_redirected_to bots_url
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+  end
+
+  test "the last allowed bot removes the add link and direct creation requests are refused" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    get bots_url
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+
+    post bots_url, params: { bot: { name: "Last allowed bot" } }
