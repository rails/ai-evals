+    patch bot_url(bot), params: { bot: { webhook_url: "https://bot.example.com/new" } }
+    assert_redirected_to bots_url
+    assert_equal "https://bot.example.com/new", bot.reload.webhook_url
+
+    patch bot_url(bot), params: { bot: { webhook_url: "" } }
+    assert_redirected_to bots_url
+    assert_nil bot.reload.webhook_url
+  end
+
+  test "blank bot names show validation errors without creating a bot" do
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: " " } }
+    end
+    assert_response :unprocessable_entity
+    assert_select "input[name='bot[name]']"
+    assert_select "button", text: "Save changes"
+  end
+
+  test "members only see and manage their own bots" do
+    own = users(:jz).bots.create!(name: "My Bot")
+    other = users(:kevin).bots.create!(name: "Other Bot")
+
+    get bots_url
+    assert_select "input[readonly][value=?]", own.bot_token
+    assert_select "input[value=?]", other.bot_token, count: 0
+    assert_raises(ActiveRecord::RecordNotFound) { get edit_bot_url(other) }
+    assert_raises(ActiveRecord::RecordNotFound) { patch bot_url(other), params: { bot: { name: "Hijacked" } } }
+    assert_raises(ActiveRecord::RecordNotFound) { delete bot_url(other) }
+    assert_raises(ActiveRecord::RecordNotFound) { get edit_bot_url(users(:kevin)) }
+  end
+
+  test "administrators can manage all bots" do
+    bot = users(:kevin).bots.create!(name: "Other Bot")
+    sign_in :david
+
+    get bots_url
+    assert_select "input[readonly][value=?]", bot.bot_token
