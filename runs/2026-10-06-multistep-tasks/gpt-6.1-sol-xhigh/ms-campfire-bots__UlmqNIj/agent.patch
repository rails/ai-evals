@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Bots::WebhooksTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+    sign_in :jz
+    @bot = users(:jz).bots.create!(name: "Deploy Bot", webhook_url: "https://bot.example.com/mentions")
+    @room = rooms(:hq)
+    @room.memberships.grant_to @bot
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example.com").returns("93.184.216.34")
+  end
+
+  test "a webhook can reply later using the supplied path and open the supplied deep link" do
+    payload = nil
+    stub_request(:post, @bot.webhook_url).to_return do |request|
+      payload = JSON.parse(request.body)
+      { status: 204 }
+    end
+
+    assert_enqueued_jobs 1, only: User::Bot::WebhookJob do
+      post room_messages_url(@room), params: { message: { body: "<div>#{mention_attachment_for(@bot)} build please</div>" } },
+        as: :turbo_stream
+    end
+    assert_response :success
+    message = @room.messages.last
+    assert_equal users(:jz), message.creator
+    assert_nil payload
+
+    perform_enqueued_jobs only: User::Bot::WebhookJob
+    assert_equal "build please", payload.dig("message", "body", "text")
+
+    get payload.dig("message", "link")
+    assert_response :success
+    assert_select "#" + dom_id(message)
+
+    assert_difference -> { @room.messages.count }, 1 do
+      post payload.dig("room", "reply_to"), params: "Build finished ✅".dup,
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :created
+    assert_equal @bot, @room.messages.last.creator
+    assert_equal "Build finished ✅", @room.messages.last.plain_text_body
+  end
+  test "a manually added bot receives joined and can post later using the supplied path" do
+    sign_in :david
+    room = rooms(:designers)
+    payload = nil
+    request = stub_request(:post, @bot.webhook_url).to_return do |request|
+      payload = JSON.parse(request.body)
+      { status: 204 }
+    end
+
+    assert_enqueued_jobs 1, only: User::Bot::JoinedWebhookJob do
+      put rooms_closed_url(room), params: { room: { name: room.name }, user_ids: [ users(:david).id, @bot.id ] }
+    end
+    assert_redirected_to room_url(room)
+    assert_nil payload
+    User::Bot::JoinedWebhookJob.perform_now(@bot.bot_room_joins.find_by!(room: room))
+    assert_equal "joined", payload["event"]
+    assert_equal room.id, payload.dig("room", "id")
+    assert_equal room.name, payload.dig("room", "name")
+    assert_equal %w[ event room ], payload.keys.sort
+    assert_requested request, times: 1
+
+    assert_difference -> { room.messages.count }, 1 do
+      post payload.dig("room", "reply_to"), params: "Hello everyone!".dup,
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :created
+    assert_equal @bot, room.messages.last.creator
+    assert_equal "Hello everyone!", room.messages.last.plain_text_body
+  end
+end
