diff --git a/test/models/user/bot/joined_webhook_test.rb b/test/models/user/bot/joined_webhook_test.rb
new file mode 100644
index 0000000..ae38ab3
--- /dev/null
+++ b/test/models/user/bot/joined_webhook_test.rb
@@ -0,0 +1,219 @@
+require "test_helper"
+
+class User::Bot::JoinedWebhookTest < ActiveSupport::TestCase
+  include Turbo::Broadcastable::TestHelper
+
+  setup do
+    @bot = users(:jz).bots.create!(name: "Hello Bot", webhook_url: "https://bot.example.com/joined")
+    @room = rooms(:hq)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example.com").returns("93.184.216.34")
+  end
+
+  test "manual grants enqueue one joined callback after commit without making an HTTP request" do
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 204)
+    assert_enqueued_jobs 1, only: User::Bot::JoinedWebhookJob do
+      @room.memberships.grant_to [ @bot, @bot ]
+      @room.memberships.revise(granted: @bot)
+      @room.update!(name: "Renamed room")
+    end
+    assert_not_requested request
+    assert_equal 1, @bot.bot_room_joins.count
+  end
+
+  test "automatic joins notify once for existing and future open rooms" do
+    assert_enqueued_jobs Rooms::Open.count, only: User::Bot::JoinedWebhookJob do
+      @bot.update!(auto_join_open_rooms: true)
+      @bot.update!(name: "Renamed Bot")
+      @bot.update!(auto_join_open_rooms: false)
+      @bot.update!(auto_join_open_rooms: true)
+    end
+
+    assert_enqueued_jobs 1, only: User::Bot::JoinedWebhookJob do
+      Rooms::Open.create_for({ name: "New room", creator: users(:david) }, users: [ @bot, users(:david) ])
+    end
+    assert_enqueued_jobs 1, only: User::Bot::JoinedWebhookJob do
+      rooms(:designers).becomes!(Rooms::Open).save!
+    end
+  end
+
+  test "joined payload includes only the event and room and is delivered once even if the job is replayed" do
+    join_room
+    expected = { "event" => "joined", "room" => { "id" => @room.id, "name" => @room.name,
+      "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_token}/messages" } }
+    request = stub_request(:post, @bot.webhook_url).with do |request|
+      request.headers["Content-Type"] == "application/json" && JSON.parse(request.body) == expected
+    end.to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      2.times { deliver_join }
+    end
+    assert_requested request, times: 1
+    assert @join.reload.delivery_started_at?
+  end
+
+  test "removal and re-addition do not send a second joined event" do
+    join_room
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 204)
+    deliver_join
+    assert_no_enqueued_jobs only: User::Bot::JoinedWebhookJob do
+      @room.memberships.revoke_from @bot
+      @room.memberships.grant_to @bot
+    end
+    assert_equal [ @join.id ], @bot.bot_room_joins.ids
+    deliver_join
+    assert_requested request, times: 1
+  end
+
+  test "plain text replies create bot messages with normal broadcasting and push" do
+    join_room
+    text = "Hello <everyone> & welcome!\nI can help ✅"
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 200, body: text,
+      headers: { "Content-Type" => "text/plain; charset=utf-8" })
+    assert_enqueued_jobs 1, only: Room::PushMessageJob do
+      assert_difference -> { @room.messages.count }, 1 do
+        assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+          deliver_join
+        end
+      end
+    end
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal text, reply.plain_text_body
+    assert_includes reply.body.to_s, "&lt;everyone&gt;"
+    assert_requested request
+  end
+
+  test "HTML replies preserve formatting with normal sanitization" do
+    join_room
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      body: "<p>Hello <strong>everyone</strong><script>alert(1)</script></p>", headers: { "Content-Type" => "text/html" })
+    assert_difference -> { @room.messages.count }, 1 do
+      deliver_join
+    end
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.to_s, "<strong>everyone</strong>"
+    assert_not_includes reply.body.to_s, "<script>"
+  end
+
+  test "direct rooms and human memberships never enqueue joined callbacks" do
+    assert_no_enqueued_jobs only: User::Bot::JoinedWebhookJob do
+      Rooms::Direct.create_for({ creator: users(:jz) }, users: [ users(:jz), @bot ])
+      rooms(:watercooler).memberships.grant_to users(:kevin)
+    end
+    assert_empty @bot.bot_room_joins
+  end
+
+  test "bots without a webhook do not get a retrospective callback when one is configured" do
+    @bot.update!(webhook_url: nil)
+    assert_no_enqueued_jobs only: User::Bot::JoinedWebhookJob do
+      join_room
+      @bot.update!(webhook_url: "https://bot.example.com/joined")
+      @room.memberships.grant_to @bot
+    end
+  end
+
+  test "rolled back memberships do not produce join records or jobs" do
+    assert_no_enqueued_jobs only: User::Bot::JoinedWebhookJob do
+      assert_no_difference -> { @bot.bot_room_joins.count } do
+        Membership.transaction(requires_new: true) do
+          @room.memberships.grant_to @bot
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+    assert_not @room.users.exists?(@bot.id)
+  end
+
+  test "queued joins respect webhook removal and bot status" do
+    request = stub_request(:post, @bot.webhook_url)
+    [ { webhook_url: nil }, { status: :deactivated }, { status: :banned } ].each do |attributes|
+      room = Rooms::Closed.create!(name: "Private room", creator: users(:jz))
+      room.memberships.grant_to @bot
+      @join = @bot.bot_room_joins.find_by!(room: room)
+      @bot.update!(attributes)
+      assert_no_difference -> { Message.count } do
+        deliver_join
+      end
+      @bot.update!(webhook_url: "https://bot.example.com/joined", status: :active)
+    end
+    assert_not_requested request
+  end
+
+  test "queued joins respect revoked access and replies recheck access after HTTP" do
+    join_room
+    request = stub_request(:post, @bot.webhook_url)
+    @room.memberships.revoke_from @bot
+    deliver_join
+    assert_not_requested request
+
+    @room = rooms(:designers)
+    join_room
+    stub_request(:post, @bot.webhook_url).to_return do
+      @room.memberships.revoke_from @bot
+      { status: 200, body: "Hello!", headers: { "Content-Type" => "text/plain" } }
+    end
+    assert_no_difference -> { Message.count } do
+      deliver_join
+    end
+  end
+
+  test "failed requests are not retried or posted as messages" do
+    join_room
+    request = stub_request(:post, @bot.webhook_url).to_raise(Net::ReadTimeout)
+    assert_no_difference -> { Message.count } do
+      2.times { deliver_join }
+    end
+    assert_requested request, times: 1
+  end
+
+  test "private network destinations are not contacted" do
+    join_room
+    request = stub_request(:post, @bot.webhook_url)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).raises(RestrictedHTTP::Violation)
+    assert_no_difference -> { Message.count } do
+      deliver_join
+    end
+    assert_not_requested request
+  end
+
+  test "jobs for deleted bots and rooms are discarded and their join records are deleted" do
+    join_room
+    job = User::Bot::JoinedWebhookJob.new(@join).serialize
+    @room.destroy!
+    assert_not User::Bot::RoomJoin.exists?(@join.id)
+    assert_nothing_raised { ActiveJob::Base.execute(job) }
+
+    @room = rooms(:designers)
+    join_room
+    job = User::Bot::JoinedWebhookJob.new(@join).serialize
+    @bot.destroy!
+    assert_not User::Bot::RoomJoin.exists?(@join.id)
+    assert_nothing_raised { ActiveJob::Base.execute(job) }
+  end
+
+  test "direct conversations still deliver mentions without any joined event" do
+    room = Rooms::Direct.create_for({ creator: users(:jz) }, users: [ users(:jz), @bot ])
+    assert_no_enqueued_jobs only: User::Bot::JoinedWebhookJob
+    assert_enqueued_jobs 1, only: User::Bot::WebhookJob do
+      message = room.messages.create!(creator: users(:jz), body: "<div>#{mention_attachment_for(@bot)} hello</div>")
+      request = stub_request(:post, @bot.webhook_url).with do |request|
+        payload = JSON.parse(request.body)
+        payload["event"] == "mention" && payload.dig("room", "id") == room.id
+      end.to_return(status: 204)
+      User::Bot::WebhookJob.perform_now(@bot, message)
+      assert_requested request
+    end
+  end
+
+  private
+
+    def join_room
+      @room.memberships.grant_to @bot
+      @join = @bot.bot_room_joins.find_by!(room: @room)
+    end
+
+    def deliver_join
+      User::Bot::JoinedWebhookJob.perform_now(@join)
+    end
+end
diff --git a/test/models/user/bot/room_membership_test.rb b/test/models/user/bot/room_membership_test.rb
new file mode 100644
index 0000000..83e022c
--- /dev/null
+++ b/test/models/user/bot/room_membership_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class User::Bot::RoomMembershipTest < ActiveSupport::TestCase
+  test "bots do not join existing or future open rooms by default" do
+    bot = users(:jz).bots.create!(name: "Selective Bot")
+    assert_not bot.auto_join_open_rooms?
+    assert_empty bot.rooms
+
+    room = Rooms::Open.create!(name: "New open room", creator: users(:david))
+    assert_not room.users.exists?(bot.id)
+    assert room.users.exists?(users(:jz).id)
+  end
+
+  test "opting in joins existing and future open rooms but not closed or direct rooms" do
+    bot = users(:jz).bots.create!(name: "Everywhere Bot", auto_join_open_rooms: true)
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+
+    room = Rooms::Open.create!(name: "New open room", creator: users(:david))
+    assert room.users.exists?(bot.id)
+    assert_not bot.rooms.without_directs.closeds.exists?
+    assert_not bot.rooms.directs.exists?
+  end
+
+  test "turning off automatic joining retains memberships and stops future grants" do
+    bot = users(:jz).bots.create!(name: "Toggle Bot")
+    rooms(:designers).memberships.grant_to bot
+    bot.update!(auto_join_open_rooms: true)
+    assert_equal (Rooms::Open.ids + [ rooms(:designers).id ]).sort, bot.rooms.ids.sort
+
+    memberships = bot.memberships.ids.sort
+    bot.update!(auto_join_open_rooms: false)
+    assert_equal memberships, bot.memberships.ids.sort
+    room = Rooms::Open.create!(name: "Later room", creator: users(:david))
+    assert_not room.users.exists?(bot.id)
+
+    bot.update!(auto_join_open_rooms: true)
+    assert room.users.exists?(bot.id)
+    assert_equal memberships, bot.memberships.where.not(room: room).ids.sort
+  end
+
+  test "opening a closed room grants access to people and opted-in bots only" do
+    selective = users(:jz).bots.create!(name: "Selective Bot")
+    automatic = users(:jz).bots.create!(name: "Automatic Bot", auto_join_open_rooms: true)
+    inactive = users(:jz).bots.create!(name: "Inactive Bot", auto_join_open_rooms: true, status: :deactivated)
+    room = rooms(:designers).becomes!(Rooms::Open)
+    room.save!
+
+    assert room.users.exists?(automatic.id)
+    assert room.users.exists?(users(:jz).id)
+    assert_not room.users.exists?(selective.id)
+    assert_not room.users.exists?(inactive.id)
+  end
+
+  test "repeated bot grants preserve involvement and create only one membership and join record" do
+    bot = users(:jz).bots.create!(name: "Selective Bot")
+    room = rooms(:hq)
+    assert_difference -> { bot.memberships.count }, 1 do
+      assert_difference -> { bot.bot_room_joins.count }, 1 do
+        room.memberships.grant_to [ bot, bot ]
+      end
+    end
+    membership = room.memberships.find_by!(user: bot)
+    membership.update!(involvement: :nothing)
+    room.memberships.grant_to bot
+    assert_equal "nothing", membership.reload.involvement
+  end
+end
