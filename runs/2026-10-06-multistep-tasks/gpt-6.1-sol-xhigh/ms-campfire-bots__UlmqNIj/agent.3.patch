diff --git a/app/models/user/bot/room_join.rb b/app/models/user/bot/room_join.rb
new file mode 100644
index 0000000..483e7e9
--- /dev/null
+++ b/app/models/user/bot/room_join.rb
@@ -0,0 +1,29 @@
+# Retained when a membership is revoked so a bot is notified only once per room.
+class User::Bot::RoomJoin < ApplicationRecord
+  self.table_name = "bot_room_joins"
+
+  belongs_to :bot, class_name: "User"
+  belongs_to :room
+
+  after_create_commit :notify_bot
+
+  def deliver
+    User::Bot::Webhook.new(bot: bot, room: room).deliver if claim_delivery
+  end
+
+  private
+    def notify_bot
+      User::Bot::JoinedWebhookJob.perform_later(self) if bot.active? && bot.webhook_url.present?
+    end
+
+    # Claim before HTTP, without holding the lock during the request. Like mention
+    # webhooks, joined webhooks are not retried, even after a network failure.
+    def claim_delivery
+      with_lock do
+        unless delivery_started_at?
+          update!(delivery_started_at: Time.current)
+          true
+        end
+      end
+    end
+end
