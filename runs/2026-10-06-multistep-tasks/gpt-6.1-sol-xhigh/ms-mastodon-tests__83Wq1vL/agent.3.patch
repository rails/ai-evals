diff --git a/spec/models/fabrication_spec.rb b/spec/models/fabrication_spec.rb
new file mode 100644
index 0000000..73f75a2
--- /dev/null
+++ b/spec/models/fabrication_spec.rb
@@ -0,0 +1,76 @@
+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe Fabrication do
+  describe 'status' do
+    it 'persists a valid status and its author without an unrelated bookmark account' do
+      expect { Fabricate(:status) }
+        .to change(Status, :count).by(1)
+        .and change(Account, :count).by(1)
+        .and not_change(Bookmark, :count)
+        .and not_change(LoginActivity, :count)
+
+      expect(Status.last).to be_valid
+      expect(Status.last.account).to be_persisted
+    end
+
+    it 'still allows explicitly bookmarked statuses without a second bookmark' do
+      author = Fabricate(:account)
+      reader = Fabricate(:account)
+      status = Fabricate(:status, account: author)
+
+      expect { Fabricate(:bookmark, status: status, account: reader) }
+        .to change(Bookmark, :count).by(1)
+        .and not_change(Account, :count)
+        .and not_change(Status, :count)
+
+      expect(reader.bookmarks.last.status).to eq status
+    end
+
+    it 'builds a valid remote status without persisting its associations' do
+      status = nil
+
+      expect { status = Fabricate.build(:status, account: Fabricate.build(:remote_account)) }
+        .to not_change(Status, :count)
+        .and not_change(Account, :count)
+        .and not_change(Bookmark, :count)
+
+      expect(status).to be_valid
+      expect(status.uri).to be_present
+      expect(status.account).to be_remote
+    end
+  end
+
+  describe 'user' do
+    %i(user admin_user moderator_user owner_user private_user).each do |fabricator|
+      it "persists a valid #{fabricator} without inventing login history" do
+        user = nil
+
+        expect { user = Fabricate(fabricator) }
+          .to change(User, :count).by(1)
+          .and change(Account, :count).by(1)
+          .and not_change(LoginActivity, :count)
+
+        expect(user).to be_valid
+        expect(user.account).to be_persisted
+      end
+    end
+
+    it 'still allows explicit login history for a persisted user' do
+      user = Fabricate(:user)
+
+      expect { Fabricate.times(2, :login_activity, user: user) }
+        .to change(user.login_activities, :count).by(2)
+        .and not_change(User, :count)
+        .and not_change(Account, :count)
+    end
+
+    it 'creates only the requested login activity when its user is built by the factory' do
+      expect { Fabricate(:login_activity) }
+        .to change(LoginActivity, :count).by(1)
+        .and change(User, :count).by(1)
+        .and change(Account, :count).by(1)
+    end
+  end
+end
