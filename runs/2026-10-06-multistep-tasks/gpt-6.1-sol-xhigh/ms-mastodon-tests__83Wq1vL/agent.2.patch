diff --git a/spec/requests/rspec_spec.rb b/spec/requests/rspec_spec.rb
new file mode 100644
index 0000000..de47363
--- /dev/null
+++ b/spec/requests/rspec_spec.rb
@@ -0,0 +1,96 @@
+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe RSpec do
+  describe 'background jobs' do
+    it 'enqueues callback jobs without executing workers' do
+      allow(WebhookService).to receive(:new).and_call_original
+
+      expect(TriggerWebhookWorker.jobs).to be_empty
+      expect { Fabricate(:status) }
+        .to enqueue_sidekiq_job(TriggerWebhookWorker).with('status.created', 'Status', anything)
+      expect(WebhookService).to_not have_received(:new)
+    end
+
+    context 'with inline execution', :sidekiq_inline do
+      it 'executes callback workers' do
+        allow(WebhookService).to receive(:new).and_call_original
+
+        Fabricate(:status)
+
+        expect(WebhookService).to have_received(:new).at_least(:once)
+      end
+
+      it 'restores inline mode after a scoped override raises' do
+        expect do
+          Sidekiq.testing!(:fake) { raise ArgumentError, 'setup failed' }
+        end.to raise_error(ArgumentError, 'setup failed')
+
+        expect(Sidekiq::Testing).to be_inline
+      end
+    end
+  end
+
+  describe 'logging' do
+    let(:logger) { ActiveRecord::Base.logger }
+
+    it 'keeps warnings and errors without debug or info noise' do
+      expect(logger).to be_warn.and be_error
+      expect(logger).to_not be_debug
+      expect(logger).to_not be_info
+    end
+
+    it 'preserves notification-based SQL assertions' do
+      expect { Account.count }.to execute_queries(1)
+    end
+
+    # Context hooks intentionally configure the logger before the example-scoped
+    # wrapper runs. No records are shared; the original level is restored.
+    # rubocop:disable RSpec/BeforeAfterAll, RSpec/InstanceVariable
+    context 'with a stricter configured log level' do
+      before(:context) do
+        @original_log_level = ActiveRecord::Base.logger.level
+        ActiveRecord::Base.logger.level = Logger::ERROR
+      end
+
+      after(:context) do
+        ActiveRecord::Base.logger.level = @original_log_level
+      end
+
+      it 'does not lower the level to WARN' do
+        expect(logger.level).to eq Logger::ERROR
+        expect(logger).to_not be_warn
+      end
+    end
+
+    # rubocop:enable RSpec/BeforeAfterAll, RSpec/InstanceVariable
+
+    context 'with debug logging', :debug_logs do
+      let(:configured_log_level) { Logger::Severity.const_get(Rails.application.config.log_level.to_s.upcase) }
+
+      it 'keeps the original logger level' do
+        expect(logger.level).to eq configured_log_level
+      end
+
+      it 'restores the logger level after a scoped override raises' do
+        original_log_level = logger.level
+
+        expect do
+          logger.silence(Logger::WARN) { raise ArgumentError, 'setup failed' }
+        end.to raise_error(ArgumentError, 'setup failed')
+
+        expect(logger.level).to eq original_log_level
+      end
+    end
+  end
+
+  describe 'performance hook scope', type: :performance do
+    it 'leaves the shared job mode and log level unchanged for other spec types' do
+      configured_log_level = Logger::Severity.const_get(Rails.application.config.log_level.to_s.upcase)
+
+      expect(Sidekiq::Testing).to be_inline
+      expect(ActiveRecord::Base.logger.level).to eq configured_log_level
+    end
+  end
+end
diff --git a/spec/support/request_performance.rb b/spec/support/request_performance.rb
new file mode 100644
index 0000000..11416b2
--- /dev/null
+++ b/spec/support/request_performance.rb
@@ -0,0 +1,24 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  config.around(:each, type: :request) do |example|
+    if example.metadata[:sidekiq_inline]
+      example.run
+    else
+      # Request setup still enqueues real jobs, but most endpoint assertions do
+      # not need the callbacks' workers to execute (notably webhook serializers).
+      Sidekiq.testing!(:fake) { example.run }
+    end
+  end
+
+  config.around(:each, type: :request) do |example|
+    if example.metadata[:debug_logs]
+      example.run
+    else
+      # Avoid formatting every setup query while keeping warnings/errors and
+      # SQL notifications. Rails restores the local level even on exceptions.
+      logger = ActiveRecord::Base.logger
+      logger.silence([logger.level, Logger::WARN].max) { example.run }
+    end
+  end
+end
