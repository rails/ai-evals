diff --git a/app/services/question_timer.rb b/app/services/question_timer.rb
new file mode 100644
index 0000000..9a0152a
--- /dev/null
+++ b/app/services/question_timer.rb
@@ -0,0 +1,37 @@
+# A single-process Puma service: durable deadlines, not one sleeping thread per
+# question. It requires no queue, external service, or connected browser.
+class QuestionTimer
+  INTERVAL = 0.2
+
+  class << self
+    def expire_due!
+      Game.joins(:game_questions).where(status: "open")
+        .where("game_questions.position = games.current_position")
+        .where("game_questions.closes_at <= ?", Time.current)
+        .find_each(&:finish_if_expired!)
+    end
+
+    def start
+      return if @thread&.alive?
+      @running = true
+      @thread = Thread.new do
+        Thread.current.name = "quizzy-question-timer"
+        while @running
+          begin
+            # Releases database connections after each pass and participates in
+            # Rails' executor, including development reload interlocks.
+            Rails.application.executor.wrap { expire_due! }
+          rescue StandardError => error
+            Rails.logger.error("Question timer: #{error.class}: #{error.message}")
+          end
+          sleep INTERVAL
+        end
+      end
+    end
+
+    def stop
+      @running = false
+      @thread&.join(2)
+    end
+  end
+end
