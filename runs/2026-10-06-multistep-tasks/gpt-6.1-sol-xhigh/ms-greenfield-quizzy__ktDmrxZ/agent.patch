+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,69 @@
+module Moderate
+  class GamesController < BaseController
+    include LiveState
+    before_action :set_game, except: :create
+
+    def create
+      quiz = Quiz.find(params[:quiz_id])
+      game = Game.create_from!(quiz)
+      redirect_to moderate_game_path(game), status: :see_other
+    end
+
+    def show
+      prepare_state
+    end
+
+    def state
+      state_response("moderate/games/state")
+    end
+
+    def start
+      transition("start")
+    end
+
+    def finish
+      transition("finish")
+    end
+
+    def next
+      transition("next")
+    end
+
+    def top
+      select_winners("top")
+    end
+
+    def draw
+      select_winners("draw")
+    end
+
+    def reset_winners
+      select_winners("reset")
+    end
+
+    private
+
+    def set_game
+      @game = Game.find(params[:id])
+      @join_url = play_url(code: @game.code)
+    end
+
+    def select_winners(mode)
+      changed = @game.select_winners!(mode)
+      if request.headers["X-Quizzy-Live"] == "1"
+        state_response("moderate/games/state", status: changed ? :ok : :conflict)
+      else
+        redirect_to moderate_game_path(@game), status: :see_other
+      end
+    end
+
+    def transition(action)
+      @game.transition!(action, expected_status: params[:expected_status], expected_position: params[:expected_position])
+      if request.headers["X-Quizzy-Live"] == "1"
+        state_response("moderate/games/state")
+      else
+        redirect_to moderate_game_path(@game), status: :see_other
+      end
+    end
+  end
+end
diff --git a/app/controllers/moderate/questions_controller.rb b/app/controllers/moderate/questions_controller.rb
new file mode 100644
index 0000000..ce5a864
--- /dev/null
+++ b/app/controllers/moderate/questions_controller.rb
@@ -0,0 +1,81 @@
+module Moderate
+  class QuestionsController < BaseController
+    before_action :set_quiz
+    before_action :set_question, only: [ :edit, :update, :destroy, :move, :toggle ]
+
+    def new
+      @question = @quiz.questions.build
+    end
+
+    def create
+      @question = @quiz.questions.build(question_params)
+      saved = @quiz.with_lock do
+        @question.position = (@quiz.questions.maximum(:position) || 0) + 1
+        @question.save
+      end
+      if saved
+        redirect_to moderate_quiz_path(@quiz), notice: "Question saved", status: :see_other
+      else
+        render :new, status: :unprocessable_entity
+      end
+    end
+
+    def edit
+    end
+
+    def update
+      if @question.update(question_params)
+        redirect_to moderate_quiz_path(@quiz), notice: "Question saved", status: :see_other
+      else
+        render :edit, status: :unprocessable_entity
+      end
+    end
+
+    def destroy
+      @quiz.with_lock do
+        @question.destroy!
+        @quiz.questions.reload.each_with_index { |question, index| question.update_column(:position, index + 1) }
+      end
+      redirect_to moderate_quiz_path(@quiz), notice: "Question deleted", status: :see_other
+    end
+
+    def move
+      @quiz.with_lock do
+        questions = @quiz.questions.reload.to_a
+        index = questions.index(@question)
+        target = case params[:direction]
+        when "up" then index - 1
+        when "down" then index + 1
+        else index
+        end
+        if target >= 0 && target < questions.length && target != index
+          neighbor = questions[target]
+          @question = questions[index]
+          old_position = @question.position
+          @question.update_column(:position, neighbor.position)
+          neighbor.update_column(:position, old_position)
+        end
+      end
+      redirect_to moderate_quiz_path(@quiz, anchor: "question-#{@question.id}"), status: :see_other
+    end
+
+    def toggle
+      @question.update!(params.require(:question).permit(:active))
+      redirect_to moderate_quiz_path(@quiz, anchor: "question-#{@question.id}"), status: :see_other
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_question
+      @question = @quiz.questions.find(params[:id])
+    end
+
+    def question_params
+      params.require(:question).permit(:text, :active, option_rows: [ :text, :correct ])
+    end
+  end
+end
