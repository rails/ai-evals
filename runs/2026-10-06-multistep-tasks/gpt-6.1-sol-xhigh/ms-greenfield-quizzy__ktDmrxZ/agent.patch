diff --git a/app/views/moderate/games/_state.html.erb b/app/views/moderate/games/_state.html.erb
new file mode 100644
index 0000000..e4ce70d
--- /dev/null
+++ b/app/views/moderate/games/_state.html.erb
@@ -0,0 +1,85 @@
+<% if @game.status == "waiting" %>
+  <div class="lobby">
+    <div>
+      <h1 class="lobby__title"><%= @game.title %></h1>
+      <p class="lobby__join">Join the quiz</p>
+      <p class="lobby__url" id="join-link"><%= @join_url %></p>
+      <p class="counter-pill">Players: <%= @player_count %></p>
+      <% if @total.zero? %><p>No active questions. Start will end this game.</p><% end %>
+    </div>
+    <div class="qr" role="img" aria-label="QR code: <%= @join_url %>"><%= RQRCode::QRCode.new(@join_url).as_svg(viewbox: true, use_path: true, module_size: 6).html_safe %></div>
+  </div>
+<% elsif @game.status == "ended" %>
+  <div class="live-over">
+    <h1 class="lobby__title">The quiz is over</h1>
+    <p class="lobby__join"><%= @game.title %></p>
+    <p>Thanks for playing!</p>
+  </div>
+  <section class="live-leaderboard" aria-labelledby="leaderboard-heading">
+    <h2 id="leaderboard-heading">Leaderboard</h2>
+    <% if @leaderboard.empty? %>
+      <p class="live-over">No players joined this game.</p>
+    <% else %>
+      <ol class="leaderboard unstyled-list">
+        <% @leaderboard.each do |row| %>
+          <li class="leader <%= 'is-winner' if row.player.winner? %>" data-player-id="<%= row.player.id %>">
+            <span class="leader__place" aria-label="Place <%= row.place %>"><%= row.place %></span>
+            <span class="leader__name"><%= row.player.name %></span>
+            <span class="leader__points"><%= pluralize(row.points, "point") %></span>
+            <% if row.player.winner? %><span class="leader__badge">Winner</span><% end %>
+          </li>
+        <% end %>
+      </ol>
+    <% end %>
+  </section>
+<% else %>
+  <section aria-labelledby="stage-question">
+    <div class="stage-question__header">
+      <div class="stage-question__num">Question <%= @game.current_position %> of <%= @total %></div>
+      <% if @game.status == "open" && @question.closes_at %>
+        <% remaining = [(@question.closes_at - @timer_now).ceil, 0].max %>
+        <div class="question-timer" role="timer" aria-label="Time remaining" aria-live="off"
+          data-question-countdown data-deadline="<%= @question.closes_at.iso8601(6) %>" data-server-now="<%= @timer_now.iso8601(6) %>">
+          <span class="question-timer__label">Time remaining</span>
+          <span class="question-timer__value" data-countdown-value><%= remaining / 60 %>:<%= format("%02d", remaining % 60) %></span>
+        </div>
+      <% end %>
+    </div>
+    <h1 id="stage-question" class="stage-question__body"><%= @question.text %></h1>
+    <ol class="stage-options <%= 'stage-options--results' if @game.status == 'closed' %>">
+      <% @question.options.each_with_index do |option, index| %>
+        <% revealed = @game.status == "closed" %>
+        <li class="stage-option <%= 'is-correct' if revealed && option['correct'] %>">
+          <span class="stage-option__letter" aria-hidden="true"><%= index < 26 ? (65 + index).chr : index + 1 %></span>
+          <span class="stage-option__title"><%= option["text"] %></span>
+          <% if revealed %>
+            <span class="stage-option__count" aria-label="<%= @counts.fetch(index, 0) %> answers"><%= @counts.fetch(index, 0) %></span>
+            <% if option["correct"] %><span class="stage-option__mark">Correct</span><% end %>
+          <% end %>
+        </li>
+      <% end %>
+    </ol>
+  </section>
+<% end %>
+<footer class="screen-controls">
+  <div class="screen-controls__info">
+    <%= link_to "← Back to quiz", moderate_quiz_path(@game.quiz_id) %>
+    <% if @game.status == "open" %><span class="answers-counter">Answers: <%= @answer_count %> / <%= @player_count %></span><% end %>
+    <% if @game.status == "closed" %><span>Question closed</span><% end %>
+  </div>
+  <% if @game.status == "ended" %>
+    <div class="buttons prize-controls" aria-label="Pick winners">
+      <%= button_to "Top #{@game.number_of_winners}", top_moderate_game_path(@game), class: "btn btn--pink", form: { data: { live_form: true } } %>
+      <%= button_to "Draw", draw_moderate_game_path(@game), class: "btn", form: { data: { live_form: true } } %>
+      <%= button_to "Reset winners", reset_winners_moderate_game_path(@game), class: "btn btn--ghost", form: { data: { live_form: true } } %>
+    </div>
+  <% else %>
+    <% action = { "waiting" => "start", "open" => "finish", "closed" => "next" }.fetch(@game.status) %>
+    <% label = { "waiting" => "Start", "open" => "Finish", "closed" => (@game.current_position == @total ? "End quiz" : "Next") }.fetch(@game.status) %>
+    <%= form_with url: "/moderate/games/#{@game.id}/#{action}", method: :post, data: { live_form: true } do %>
+      <%= hidden_field_tag :expected_status, @game.status %>
+      <%= hidden_field_tag :expected_position, @game.current_position %>
+      <%= button_tag label, class: "btn btn--pink" %>
+    <% end %>
+  <% end %>
+</footer>
