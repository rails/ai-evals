+# Run against bin/serve to verify production assets, CSRF and browser copy/paste.
+require "json"
+require "capybara/cuprite"
+require "capybara/dsl"
+require "capybara/minitest"
+require "minitest/autorun"
+
+Capybara.register_driver(:quizzy_transfer_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app,
+    browser_path: "/usr/bin/chromium",
+    browser_options: { "no-sandbox" => nil, "disable-dev-shm-usage" => nil },
+    window_size: [ 1280, 900 ], timeout: 15, process_timeout: 15)
+end
+Capybara.default_driver = :quizzy_transfer_chromium
+Capybara.app_host = ENV.fetch("QUIZZY_TEST_URL", "http://127.0.0.1:3000")
+Capybara.run_server = false
+Capybara.default_max_wait_time = 5
+Capybara.enable_aria_label = true
+
+class BrowserTransferSmokeTest < Minitest::Test
+  include Capybara::DSL
+  include Capybara::Minitest::Assertions
+
+  def setup
+    @quiz_paths = []
+    page.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "test-password"))
+    @contents = {
+      "title" => "Transfer browser QA #{Time.now.to_i} #{rand(10000)}",
+      "questions" => [
+        { "text" => 'Which HTTP status means "Too Many Requests"?', "active" => true,
+          "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ] },
+        { "text" => '</pre><script>window.quizzyInjected=true</script> & "Unicode: café 🌍"', "active" => false,
+          "options" => [ { "text" => "First", "correct" => true }, { "text" => "Second", "correct" => true } ] }
+      ]
+    }
+  end
+
+  def test_copy_paste_roundtrip_and_duplicate_title
+    visit "/moderate"
+    click_button "Import quiz"
+    fill_in "Quiz JSON", with: JSON.pretty_generate(@contents)
+    click_button "Import", exact: true
+    assert_text @contents["title"]
+    assert_text "1 of 2 questions active"
+    @quiz_paths << URI(page.current_url).path
+    assert_equal @contents["questions"].map { |question| question["text"] }, all(".question-item__body").map(&:text)
+    within all("ol.question-list > li").last do
+      assert_unchecked_field "Active"
+      assert_selector "li.is-correct", count: 2
+    end
+    click_link "Export", exact: true
+    assert_selector "pre", count: 1
+    copied = find("pre").text
+    assert_equal @contents, JSON.parse(copied)
+    assert_nil page.evaluate_script("window.quizzyInjected || null")
+    page.driver.resize(390, 844)
+    assert page.evaluate_script("document.documentElement.scrollWidth <= window.innerWidth"), "Export should not overflow horizontally"
+    page.save_screenshot("/tmp/quizzy-export-mobile.png")
+    visit "/moderate"
+    click_button "Import quiz"
+    fill_in "Quiz JSON", with: copied
+    click_button "Import", exact: true
+    assert_text "1 of 2 questions active"
+    @quiz_paths << URI(page.current_url).path
+    refute_equal @quiz_paths.first, @quiz_paths.last
+    click_link "Export", exact: true
+    assert_equal @contents, JSON.parse(find("pre").text)
+    visit "/moderate"
+    assert_selector "ul.quiz-list > li", text: @contents["title"], count: 2
+  end
+
+  def test_errors_preserve_input_and_create_nothing_until_corrected
+    visit "/moderate"
+    initial_count = all("ul.quiz-list > li").count
+    click_button "Import quiz"
+    malformed = '{"title": "Not closed"'
+    fill_in "Quiz JSON", with: malformed
+    click_button "Import", exact: true
+    assert_text "Invalid JSON"
+    assert_field "Quiz JSON", with: malformed
+    invalid = JSON.parse(JSON.generate(@contents))
+    invalid["questions"][1]["options"] = [ { "text" => "Only", "correct" => false } ]
+    input = JSON.pretty_generate(invalid)
+    fill_in "Quiz JSON", with: input
+    click_button "Import", exact: true
+    assert_text "Question 2: Add at least two options"
+    assert_text "Question 2: Mark at least one option as correct"
+    assert_field "Quiz JSON", with: input
+    page.driver.resize(390, 844)
+    assert page.evaluate_script("document.documentElement.scrollWidth <= window.innerWidth"), "Import should not overflow horizontally"
+    page.save_screenshot("/tmp/quizzy-import-error-mobile.png")
+    click_link "Cancel"
+    assert_selector "ul.quiz-list > li", count: initial_count
+    assert_no_selector "ul.quiz-list > li", text: @contents["title"]
+    click_button "Import quiz"
+    @contents["questions"][0].delete("active")
+    @contents["questions"][0]["options"][0].delete("correct")
+    fill_in "Quiz JSON", with: JSON.generate(@contents)
+    click_button "Import", exact: true
+    assert_text "1 of 2 questions active"
+    @quiz_paths << URI(page.current_url).path
+    click_link "Export", exact: true
+    exported = JSON.parse(find("pre").text)
+    assert_equal true, exported["questions"][0]["active"]
+    assert_equal false, exported["questions"][0]["options"][0]["correct"]
+  end
+
+  def teardown
+    @quiz_paths.each do |path|
+      visit "#{path}/edit"
+      accept_confirm { click_button "Delete quiz" }
+    end
+    Capybara.reset_sessions!
+  end
+end
diff --git a/script/timer_service_smoke.rb b/script/timer_service_smoke.rb
new file mode 100644
index 0000000..c07679a
--- /dev/null
+++ b/script/timer_service_smoke.rb
@@ -0,0 +1,25 @@
+# Run while production bin/serve is running, with no connected browser needed.
+# The script itself deliberately starts no scheduler and makes no HTTP requests.
+ENV["RAILS_ENV"] ||= "production"
+require_relative "../config/environment"
+
+quiz = Quiz.create!(title: "Timer service probe", timer_seconds: 2)
+begin
+  quiz.questions.create!(text: "No browser needed", position: 1,
+    options: [ { text: "Yes", correct: true }, { text: "No", correct: false } ])
+  game = Game.create_from!(quiz)
+  game.transition!("start", expected_status: "waiting", expected_position: 0)
+  question = game.current_question
+  deadline = question.closes_at
+  timeout = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 6
+  loop do
+    break if game.reload.status == "closed"
+    raise "Server timer did not finish the question without a browser" if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= timeout
+    sleep 0.1
+  end
+  raise "Timer reset the opening time" unless question.reload.closes_at == deadline
+  raise "Timer skipped the question" unless game.current_position == 1
+  puts "PASS: persisted question finished without any browser or state request"
+ensure
+  quiz.destroy!
+end
