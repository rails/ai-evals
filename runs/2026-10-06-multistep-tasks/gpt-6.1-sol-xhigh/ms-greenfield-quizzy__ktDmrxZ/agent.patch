@@ -0,0 +1,166 @@
+# End-to-end live game verification against bin/serve; no browser account or
+# shared cookie jar is used for the phones. Run with bundle exec ruby ...
+require "capybara/cuprite"
+require "capybara/dsl"
+require "capybara/minitest"
+require "minitest/autorun"
+require "json"
+
+Capybara.register_driver(:quizzy_live_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: "/usr/bin/chromium",
+    browser_options: { "no-sandbox" => nil, "disable-dev-shm-usage" => nil },
+    window_size: [ 1280, 900 ], timeout: 20, process_timeout: 20)
+end
+Capybara.default_driver = :quizzy_live_chromium
+Capybara.app_host = ENV.fetch("QUIZZY_TEST_URL", "http://127.0.0.1:3000")
+Capybara.run_server = false
+Capybara.default_max_wait_time = 8
+Capybara.enable_aria_label = true
+
+class BrowserLiveSmokeTest < Minitest::Test
+  include Capybara::DSL
+  include Capybara::Minitest::Assertions
+
+  def test_live_game
+    page.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "test-password"))
+    visit "/moderate/quizzes/import"
+    title = "Browser live #{Time.now.to_i}"
+    fill_in "Quiz JSON", with: JSON.generate({ title: title, questions: [
+      { text: "Which planet?", options: [ { text: "Earth", correct: true }, { text: "Mars", correct: false }, { text: "Venus", correct: true } ] },
+      { text: "This is inactive", active: false, options: [ { text: "Hidden yes", correct: true }, { text: "Hidden no", correct: false } ] },
+      { text: "The final question", options: [ { text: "Yes", correct: true }, { text: "No", correct: false } ] }
+    ] })
+    click_button "Import"
+    assert_text title
+    quiz_path = URI(page.current_url).path
+    click_button "Start a game"
+    assert_text "Players: 0"
+    join_url = find("#join-link").text
+    assert_match %r{http://.+/play/[A-Z0-9]+}, join_url
+    assert_selector ".qr svg"
+    game_path = URI(page.current_url).path
+    page.execute_script("window.quizzyReloadMarker = 'moderator'")
+
+    phone(:alice) do
+      page.driver.resize(390, 844)
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+      page.execute_script("window.quizzyReloadMarker = 'alice'")
+    end
+    phone(:bob) do
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "Hi, Bob!"
+      page.execute_script("window.quizzyReloadMarker = 'bob'")
+    end
+    assert_text "Players: 2"
+    click_button "Start"
+    assert_text "Question 1 of 2"
+    assert_text "Answers: 0 / 2"
+    phone(:alice) do
+      assert_text "Which planet?"
+      assert_no_text "Correct"
+      assert_equal "alice", page.evaluate_script("window.quizzyReloadMarker")
+      click_button "Mars"
+      within find("button", text: "Mars") do
+        assert_text "Your answer"
+      end
+    end
+    assert_text "Answers: 1 / 2"
+    phone(:alice) do
+      click_button "Venus"
+      within find("button", text: "Venus") do
+        assert_text "Your answer"
+      end
+      assert_no_selector "button.is-picked", text: "Mars"
+    end
+    # Leaving immediately lowers the denominator; returning keeps the identity
+    # and previous pick, and resumes updates without using another Join form.
+    phone(:bob) { visit "about:blank" }
+    assert_text "Answers: 1 / 1"
+    phone(:bob) do
+      visit join_url
+      assert_text "Hi, Bob!"
+      assert_no_button "Join"
+      click_button "Earth"
+      assert_text "Your answer"
+      page.execute_script("window.quizzyReloadMarker = 'bob'")
+    end
+    assert_text "Answers: 2 / 2"
+    click_button "Finish"
+    assert_selector ".stage-option.is-correct", count: 2
+    assert_selector ".stage-option__count", text: "1", count: 2
+    phone(:alice) do
+      assert_text "Correct!"
+      assert_button "Venus", disabled: true
+      assert_equal "alice", page.evaluate_script("window.quizzyReloadMarker")
+    end
+    phone(:bob) { assert_text "Correct!" }
+    phone(:late) do
+      # Force a Wi-Fi environment where WebSockets never establish. This phone
+      # must still follow the game using conditional HTTP reconciliation.
+      page.driver.browser.evaluate_on_new_document <<~JS
+        window.WebSocket = class extends WebSocket {
+          constructor(...args) { super(...args); setTimeout(() => this.close(), 0); }
+        };
+      JS
+      visit join_url
+      fill_in "Your name", with: "Late player"
+      click_button "Join"
+      assert_text "No answer"
+    end
+    phone(:bob) { page.driver.browser.network.offline_mode }
+    click_button "Next"
+    assert_text "Question 2 of 2"
+    assert_no_text "This is inactive"
+    phone(:alice) do
+      assert_text "The final question"
+      click_button "No"
+      assert_text "Your answer"
+    end
+    phone(:bob) do
+      page.driver.browser.network.emulate_network_conditions
+      page.execute_script("window.dispatchEvent(new Event('online'))")
+      assert_text "The final question"
+      assert_equal "bob", page.evaluate_script("window.quizzyReloadMarker")
+    end
+    phone(:late) { assert_text "The final question" }
+    assert_text "Answers: 1 / 3"
+    click_button "Finish"
+    phone(:alice) { assert_text "Wrong!" }
+    phone(:bob) { assert_text "No answer" }
+    assert_button "End quiz"
+    click_button "End quiz"
+    assert_text "The quiz is over"
+    assert_equal "moderator", page.evaluate_script("window.quizzyReloadMarker")
+    [ :alice, :bob, :late ].each do |name|
+      phone(name) { assert_text "The quiz is over" }
+    end
+    phone(:stranger) do
+      visit join_url
+      assert_text "The quiz is over"
+      assert_no_field "Your name"
+      assert_no_button "Join"
+    end
+    visit quiz_path
+    click_button "Start a game"
+    assert_text "Players: 0"
+    refute_equal game_path, URI(page.current_url).path
+    refute_equal join_url, find("#join-link").text
+    visit quiz_path
+    click_link "Settings"
+    accept_confirm { click_button "Delete quiz" }
+    assert_no_text title
+  ensure
+    Capybara.reset_sessions!
+  end
+
+  private
+
+  def phone(name, &block)
+    Capybara.using_session(name, &block)
+  end
+end
diff --git a/script/browser_prizes_smoke.rb b/script/browser_prizes_smoke.rb
new file mode 100644
index 0000000..ac3e7f1
--- /dev/null
+++ b/script/browser_prizes_smoke.rb
@@ -0,0 +1,167 @@
+# Run against bin/serve: bundle exec ruby script/browser_prizes_smoke.rb
+require "capybara/cuprite"
+require "capybara/dsl"
+require "capybara/minitest"
+require "minitest/autorun"
+require "json"
+
+Capybara.register_driver(:quizzy_prizes_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: "/usr/bin/chromium",
+    browser_options: { "no-sandbox" => nil, "disable-dev-shm-usage" => nil },
+    window_size: [ 1280, 900 ], timeout: 20, process_timeout: 20)
+end
+Capybara.default_driver = :quizzy_prizes_chromium
+Capybara.app_host = ENV.fetch("QUIZZY_TEST_URL", "http://127.0.0.1:3000")
+Capybara.run_server = false
+Capybara.default_max_wait_time = 5
+Capybara.enable_aria_label = true
+
+class BrowserPrizesSmokeTest < Minitest::Test
+  include Capybara::DSL
+  include Capybara::Minitest::Assertions
+
+  def test_prizes
+    page.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "test-password"))
+    visit "/moderate/quizzes/import"
+    fill_in "Quiz JSON", with: JSON.generate({ title: "Prizes browser #{Time.now.to_i}", questions: [
+      { text: "First prize question", options: [ { text: "Yes", correct: true }, { text: "No", correct: false } ] },
+      { text: "Second prize question", options: [ { text: "Yes", correct: true }, { text: "No", correct: false } ] }
+    ] })
+    click_button "Import"
+    click_link "Settings"
+    assert_equal "3", find_field("Number of winners").value
+    fill_in "Number of winners", with: "3"
+    click_button "Save quiz"
+    click_button "Start a game"
+    join_url = find("#join-link").text
+    %w[Alice Bob Charlie Diana Zero].each do |name|
+      phone(name) do
+        if name == "Zero"
+          # Even without WebSockets, a phone follows in well under a second.
+          page.driver.browser.evaluate_on_new_document <<~JS
+            window.WebSocket = class extends WebSocket {
+              constructor(...args) { super(...args); setTimeout(() => this.close(), 0); }
+            };
+          JS
+        end
+        page.driver.resize(390, 844)
+        visit join_url
+        fill_in "Your name", with: name
+        click_button "Join"
+        assert_text "Hi, #{name}!"
+        page.execute_script <<~JS
+          window.quizzyReloadMarker = #{name.to_json};
+          window.quizzyStates = [];
+          new MutationObserver(() => {
+            window.quizzyStates.push({ time: Date.now(), text: document.getElementById('live-state').textContent });
+          }).observe(document.getElementById('live-state'), { childList: true });
+        JS
+      end
+    end
+    assert_text "Players: 5"
+    page.execute_script("window.quizzyReloadMarker = 'moderator'")
+    before = (Time.now.to_f * 1000).to_i
+    click_button "Start"
+    assert_text "First prize question"
+    assert_fast_transition("First prize question", before)
+    %w[Charlie Diana Bob Alice].each do |name|
+      phone(name) do
+        assert_no_text "point"
+        click_button "Yes"
+        assert_text "Your answer"
+      end
+    end
+    phone("Charlie") { click_button "No"; assert_text "Your answer" }
+    phone("Charlie") { click_button "Yes"; assert_text "Your answer" }
+    # Diana is now faster than Charlie, despite Charlie's first pick being first.
+    click_button "Finish"
+    %w[Alice Bob Charlie Diana].each { |name| phone(name) { assert_text "Correct!"; assert_no_text "point" } }
+    before = (Time.now.to_f * 1000).to_i
+    click_button "Next"
+    assert_fast_transition("Second prize question", before)
+    phone("Bob") { click_button "Yes"; assert_text "Your answer" }
+    phone("Alice") { click_button "No"; assert_text "Your answer" }
+    phone("Alice") { click_button "Yes"; assert_text "Your answer" }
+    click_button "Finish"
+    click_button "End quiz"
+    assert_text "Leaderboard"
+    assert_selector ".leaderboard > li", count: 5
+    assert_equal %w[Bob Alice Diana Charlie Zero], leader_names
+    assert_equal [ "2 points", "2 points", "1 point", "1 point", "0 points" ], leader_texts(".leader__points")
+    %w[Bob Alice Diana Charlie Zero].each_with_index do |name, index|
+      phone(name) do
+        assert_text "Place #{index + 1} of 5"
+        assert_no_text "You won!"
+        assert_equal name, page.evaluate_script("window.quizzyReloadMarker")
+      end
+    end
+    click_button "Top 3"
+    assert_selector ".leader.is-winner", count: 3
+    assert_equal %w[Bob Alice Diana], leader_names(winners: true)
+    %w[Bob Alice Diana].each { |name| phone(name) { assert_text "You won!" } }
+    %w[Charlie Zero].each { |name| phone(name) { assert_no_text "You won!" } }
+    4.times do
+      click_button "Draw"
+      assert_button "Draw", disabled: false
+      assert_selector ".leader.is-winner", count: 3
+      winners = leader_names(winners: true)
+      assert_includes winners, "Bob"
+      assert_includes winners, "Alice"
+      refute_includes winners, "Zero"
+      %w[Alice Bob Charlie Diana Zero].each do |name|
+        phone(name) { winners.include?(name) ? assert_text("You won!") : assert_no_text("You won!") }
+      end
+    end
+    click_button "Reset winners"
+    assert_no_selector ".leader.is-winner"
+    %w[Alice Bob Charlie Diana Zero].each do |name|
+      phone(name) do
+        assert_no_text "You won!"
+        assert_text "Place"
+        assert_equal name, page.evaluate_script("window.quizzyReloadMarker")
+        if name == "Alice"
+          page.save_screenshot("/app/storage/prizes-phone.png")
+          page.refresh
+          assert_text "Place 2 of 5"
+          assert_text "2 points"
+        end
+      end
+    end
+    assert_equal "moderator", page.evaluate_script("window.quizzyReloadMarker")
+    page.save_screenshot("/app/storage/prizes-leaderboard.png")
+    page.refresh
+    assert_equal %w[Bob Alice Diana Charlie Zero], leader_names
+  ensure
+    Capybara.send(:session_pool).each_value { |session| session.driver.quit }
+  end
+
+  private
+
+  # Read changing lists atomically, rather than retaining obsolete DOM nodes
+  # across a legitimate live refresh or the initial reconnect reconciliation.
+  def leader_texts(selector)
+    page.evaluate_script("Array.from(document.querySelectorAll(#{selector.to_json}), node => node.textContent.trim())")
+  end
+
+  def leader_names(winners: false)
+    assert_selector ".leaderboard"
+    leader_texts(winners ? ".leader.is-winner .leader__name" : ".leader__name")
+  end
+
+  def phone(name, &block)
+    Capybara.using_session("prizes-#{name}", &block)
+  end
+
+  def assert_fast_transition(text, started)
+    %w[Alice Bob Charlie Diana Zero].each do |name|
+      phone(name) do
+        assert_text text
+        time = page.evaluate_script("window.quizzyStates.find(state => state.text.includes(#{text.to_json}))?.time")
+        assert time, "#{name} did not receive a live state"
+        latency = time - started
+        assert_operator latency, :<, 1200, "#{name} update took #{latency}ms"
+        puts "#{name}: #{text} in #{latency}ms"
+      end
+    end
+  end
+end
