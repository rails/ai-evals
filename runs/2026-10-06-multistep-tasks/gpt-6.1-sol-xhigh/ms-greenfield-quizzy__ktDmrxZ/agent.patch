diff --git a/app/controllers/concerns/live_state.rb b/app/controllers/concerns/live_state.rb
new file mode 100644
index 0000000..5945c2b
--- /dev/null
+++ b/app/controllers/concerns/live_state.rb
@@ -0,0 +1,35 @@
+module LiveState
+  extend ActiveSupport::Concern
+
+  private
+
+  def prepare_state
+    @game.finish_if_expired!
+    @timer_now = Time.current
+    @leaderboard = @game.status == "ended" ? @game.leaderboard : nil
+    @result = @leaderboard&.find { |row| row.player.id == @player&.id }
+    @total = @game.game_questions.count
+    @question = @game.current_question
+    @player_count = @game.players.present.count
+    @answer = @player && @question && @question.answers.find_by(player: @player)
+    @answer_count = @question ? @question.answers.where(player_id: @game.players.present.select(:id)).count : 0
+    @counts = @game.status == "closed" && @question ? @question.answers.group(:option_index).count : {}
+  end
+
+  def state_response(partial, status: :ok)
+    prepare_state
+    # Fingerprint semantic state, not randomized CSRF form tokens. Private,
+    # conditional snapshots keep reconciliation cheap on crowded Wi-Fi.
+    fingerprint = [ @game.id, @game.status, @game.current_position, @total, @player_count,
+      @answer_count, @counts.sort, @question&.closes_at, @player&.id, @answer&.option_index, @game.number_of_winners,
+      @leaderboard&.map { |row| [ row.player.id, row.player.name, row.place, row.points, row.player.winner? ] } ]
+    etag = %Q("#{Digest::SHA256.hexdigest(fingerprint.to_json)}")
+    response.headers["Cache-Control"] = "no-store"
+    response.headers["ETag"] = etag
+    if status == :ok && request.headers["If-None-Match"] == etag
+      head :not_modified
+    else
+      render partial: partial, status: status
+    end
+  end
+end
diff --git a/app/controllers/moderate/base_controller.rb b/app/controllers/moderate/base_controller.rb
new file mode 100644
index 0000000..7875541
--- /dev/null
+++ b/app/controllers/moderate/base_controller.rb
@@ -0,0 +1,24 @@
+module Moderate
+  class BaseController < ApplicationController
+    before_action :authenticate_moderator, prepend: true
+    before_action :disable_cache
+
+    private
+
+    def authenticate_moderator
+      authenticate_or_request_with_http_basic("Quizzy Moderator") do |username, password|
+        expected_username = ENV["QUIZZY_MODERATOR_USERNAME"].to_s
+        expected_password = ENV["QUIZZY_MODERATOR_PASSWORD"].to_s
+        next false if expected_username.blank? || expected_password.blank?
+
+        valid_username = ActiveSupport::SecurityUtils.secure_compare(username, expected_username)
+        valid_password = ActiveSupport::SecurityUtils.secure_compare(password, expected_password)
+        valid_username && valid_password
+      end
+    end
+
+    def disable_cache
+      response.headers["Cache-Control"] = "no-store"
+    end
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
