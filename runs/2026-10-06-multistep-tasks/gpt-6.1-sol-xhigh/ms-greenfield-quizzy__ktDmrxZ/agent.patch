--- /dev/null
+++ b/app/assets/javascripts/application.js
@@ -0,0 +1,338 @@
+// All assets are local. Preview stays read-only and separate from live play.
+document.addEventListener("submit", (event) => {
+  const message = event.target.dataset.confirm;
+  if (message && !window.confirm(message)) event.preventDefault();
+});
+
+document.addEventListener("change", (event) => {
+  if (event.target.matches('input[type="checkbox"][data-autosubmit]')) {
+    event.target.form.requestSubmit();
+  }
+});
+
+const addOption = document.getElementById("add-option");
+if (addOption) {
+  addOption.addEventListener("click", () => {
+    const rows = document.getElementById("option-rows");
+    const index = rows.querySelectorAll("[data-option-row]").length;
+    const row = document.createElement("div");
+    row.className = "option-row";
+    row.dataset.optionRow = "";
+    // Only generated numbers are interpolated; moderator text is never HTML.
+    row.innerHTML = `<div class="option-row__field">
+      <label for="option_${index}_text">Option ${index + 1}</label>
+      <input class="input" type="text" id="option_${index}_text" name="question[option_rows][${index}][text]" placeholder="Option ${index + 1}">
+      </div><label class="checkbox" for="option_${index}_correct">
+      <input type="hidden" name="question[option_rows][${index}][correct]" value="0">
+      <input type="checkbox" id="option_${index}_correct" name="question[option_rows][${index}][correct]" value="1" aria-label="Option ${index + 1} is correct"> Correct</label>`;
+    rows.append(row);
+    row.querySelector('input[type="text"]').focus();
+  });
+}
+
+const previewData = document.getElementById("preview-data");
+if (previewData) {
+  const questions = JSON.parse(previewData.textContent);
+  const body = document.getElementById("preview-body");
+  let current = 0;
+  let score = 0;
+  let answered = false;
+
+  function element(tag, className, text) {
+    const node = document.createElement(tag);
+    node.className = className;
+    if (text !== undefined) node.textContent = text;
+    return node;
+  }
+
+  function showScore() {
+    body.replaceChildren();
+    const result = element("div", "preview-score");
+    result.append(element("div", "play-question__num", "Quiz complete"));
+    result.append(element("h1", "", `Score: ${score}/${questions.length}`));
+    result.append(element("p", "play-lead", "That’s a wrap! Ready for another round?"));
+    body.append(result);
+    document.getElementById("start-over").focus();
+  }
+
+  function showQuestion() {
+    answered = false;
+    body.replaceChildren();
+    if (!questions.length) {
+      body.append(element("h1", "play-question__body", "No active questions"));
+      body.append(element("p", "play-lead", "Add or activate a question to try this quiz."));
+      return;
+    }
+    const question = questions[current];
+    const progress = element("div", "play-question__num", `Question ${current + 1} of ${questions.length}`);
+    const heading = element("h1", "play-question__body", question.text);
+    const choices = element("div", "play-options");
+    const feedback = element("div", "play-status preview-feedback");
+    feedback.setAttribute("role", "status");
+    feedback.setAttribute("aria-live", "polite");
+    feedback.hidden = true;
+    const next = element("button", "btn btn--pink preview-next", current === questions.length - 1 ? "See score" : "Next question");
+    next.type = "button";
+    next.hidden = true;
+    next.addEventListener("click", () => {
+      if (current === questions.length - 1) showScore();
+      else {
+        current += 1;
+        showQuestion();
+      }
+    });
+
+    question.options.forEach((option, index) => {
+      const button = element("button", "play-option");
+      button.type = "button";
+      button.setAttribute("aria-label", option.text);
+      const letter = element("span", "play-option__letter", index < 26 ? String.fromCharCode(65 + index) : String(index + 1));
+      letter.setAttribute("aria-hidden", "true");
+      button.append(letter, element("span", "play-option__title", option.text));
+      button.addEventListener("click", () => {
+        if (answered) return;
+        answered = true;
+        if (option.correct) score += 1;
+        button.classList.add("is-picked");
+        choices.classList.add("is-locked", "is-revealed");
+        [...choices.children].forEach((choice, choiceIndex) => {
+          choice.disabled = true;
+          if (question.options[choiceIndex].correct) {
+            choice.classList.add("is-correct");
+            choice.append(element("span", "play-option__mark", "✓ Correct"));
+          }
+        });
+        feedback.textContent = option.correct ? "Correct!" : "Wrong!";
+        feedback.classList.add(option.correct ? "play-status--right" : "play-status--wrong");
+        feedback.hidden = false;
+        next.hidden = false;
+      });
+      choices.append(button);
+    });
+    body.append(progress, heading, choices, feedback, next);
+  }
+
+  document.getElementById("start-over").addEventListener("click", () => {
+    current = 0;
+    score = 0;
+    showQuestion();
+  });
+  showQuestion();
+}
+
+// Action Cable's public stream carries only invalidations. All game content is
+// rendered by the server for the requesting role; no answer key lives here.
+const liveGame = document.querySelector("[data-live-game]");
+if (liveGame) {
+  const state = document.getElementById("live-state");
+  const connectionStatus = document.getElementById("live-connection");
+  const csrf = document.querySelector('meta[name="csrf-token"]').content;
+  const identifier = JSON.stringify({ channel: "GameChannel", code: liveGame.dataset.code });
+  let socket;
+  let subscribed = false;
+  let stopped = false;
+  let reconnectTimer;
+  let retryDelay = 500;
+  let lastMessage = Date.now();
+  let etag;
+  let reading = false;
+  let dirty = false;
+  let posting = false;
+  let generation = 0;
+  let queuedSubmission;
+  let refreshTimer;
+  let countdown;
+  let countdownEndsAt;
+  let lastExpiryRefresh = -Infinity;
+
+  // Anchor to SERVER time once per snapshot, then use a monotonic clock.
+  // A reload/reconciliation derives the remaining time from the same saved
+  // deadline, never from the configured duration or a phone's wall clock.
+  function syncCountdown() {
+    countdown = state.querySelector("[data-question-countdown]");
+    if (!countdown) return;
+    const remaining = Date.parse(countdown.dataset.deadline) - Date.parse(countdown.dataset.serverNow);
+    countdownEndsAt = performance.now() + Math.max(0, remaining);
+    updateCountdown();
+  }
+
+  function updateCountdown() {
+    if (stopped || !countdown) return;
+    const seconds = Math.max(0, Math.ceil((countdownEndsAt - performance.now()) / 1000));
+    const text = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
+    const value = countdown.querySelector("[data-countdown-value]");
+    if (value.textContent !== text) value.textContent = text;
+    countdown.classList.toggle("is-urgent", seconds <= 10);
+    // The server owns finishing. At zero reconcile promptly even if Cable is
+    // blocked, rather than sending a stale Finish against the next question.
+    if (seconds === 0 && performance.now() - lastExpiryRefresh >= 500) {
+      lastExpiryRefresh = performance.now();
+      scheduleRefresh();
+    }
+  }
+
+  function notice(message) {
+    connectionStatus.textContent = message || "";
+    connectionStatus.hidden = !message;
+  }
+
+  function apply(html) {
+    const template = document.createElement("template");
+    template.innerHTML = html;
+    // Don't replace a half-typed name when an unjoined phone reconciles.
+    if (state.querySelector(".join-form") && template.content.querySelector(".join-form")) return;
+    const focused = document.activeElement;
+    const label = state.contains(focused) && focused.getAttribute("aria-label");
+    const previousQuestion = state.querySelector('[name="question_id"]')?.value;
+    state.replaceChildren(template.content);
+    syncCountdown();
+    const nextQuestion = state.querySelector('[name="question_id"]')?.value;
+    if (label && previousQuestion === nextQuestion) {
+      [...state.querySelectorAll("button[aria-label]")].find(button => button.getAttribute("aria-label") === label)?.focus({ preventScroll: true });
+    }
+  }
+
+  async function refresh() {
+    if (stopped) return;
+    if (reading || posting) { dirty = true; return; }
+    reading = true;
+    dirty = false;
+    const version = generation;
+    try {
+      const headers = etag ? { "If-None-Match": etag } : {};
+      const response = await fetch(liveGame.dataset.stateUrl, { headers, credentials: "same-origin", cache: "no-store", signal: AbortSignal.timeout(12000) });
+      if (version !== generation || posting) { dirty = true; return; }
+      if (response.status === 304) return;
+      if (response.status === 404) {
+        state.textContent = "This game is no longer available.";
+        stopped = true;
+        socket?.close();
+        return;
+      }
+      if (!response.ok) throw new Error("State unavailable");
+      const html = await response.text();
+      if (version !== generation || posting) { dirty = true; return; }
+      etag = response.headers.get("ETag");
+      apply(html);
+      notice();
+    } catch (_) {
+      notice("Connection interrupted. Reconnecting…");
+    } finally {
+      reading = false;
+      if (dirty && !posting) scheduleRefresh();
+    }
+  }
+
+  function scheduleRefresh(immediate = true) {
+    // Game transitions and prizes have no artificial debounce/jitter.
+    // Only high-volume answer/presence counters are coalesced.
+    if (refreshTimer) {
+      if (!immediate) return;
+      clearTimeout(refreshTimer);
+    }
+    refreshTimer = setTimeout(() => {
+      refreshTimer = undefined;
+      refresh();
+    }, immediate ? 0 : 120);
+  }
+
+  // Serialize writes. A rapid second pick is queued behind the first; the
+  // latest pick wins. Each carries the question ID to reject stale UI taps.
+  liveGame.addEventListener("submit", event => {
+    const form = event.target;
+    if (!form.matches("[data-live-form]")) return;
+    event.preventDefault();
+    queuedSubmission = { url: form.action, data: new FormData(form) };
+    sendSubmission();
+  });
+
+  async function sendSubmission() {
+    if (posting || !queuedSubmission || stopped) return;
+    posting = true;
+    generation += 1;
+    const submission = queuedSubmission;
+    queuedSubmission = undefined;
+    // Phone options remain usable while saving, allowing changes of mind.
+    if (!liveGame.dataset.heartbeatUrl) state.querySelectorAll("button").forEach(button => { button.disabled = true; });
+    try {
+      const response = await fetch(submission.url, {
+        method: "POST", body: submission.data, credentials: "same-origin", cache: "no-store",
+        headers: { "X-CSRF-Token": csrf, "X-Quizzy-Live": "1" }, signal: AbortSignal.timeout(12000)
+      });
+      if (!response.ok && response.status !== 409) throw new Error("Answer unavailable");
+      const html = await response.text();
+      etag = response.headers.get("ETag");
+      apply(html);
+      notice();
+    } catch (_) {
+      notice("Could not save. Check your connection and try again.");
+      state.querySelectorAll("button").forEach(button => { button.disabled = false; });
+      etag = undefined;
+    } finally {
+      posting = false;
+      if (queuedSubmission) sendSubmission();
+      else scheduleRefresh();
+    }
+  }
+
+  function sendCable(command, data) {
+    if (socket?.readyState === WebSocket.OPEN) {
+      socket.send(JSON.stringify({ command, identifier, ...(data ? { data: JSON.stringify(data) } : {}) }));
+    }
+  }
+
+  function connect() {
+    if (stopped) return;
+    clearTimeout(reconnectTimer);
+    socket?.close();
+    subscribed = false;
+    const protocol = location.protocol === "https:" ? "wss:" : "ws:";
+    const current = new WebSocket(`${protocol}//${location.host}/cable`, ["actioncable-v1-json"]);
+    socket = current;
+    current.onmessage = event => {
+      if (socket !== current) return;
+      lastMessage = Date.now();
+      const message = JSON.parse(event.data);
+      if (message.type === "welcome") sendCable("subscribe");
+      if (message.type === "confirm_subscription") {
+        subscribed = true;
+        retryDelay = 500;
+        notice();
+        scheduleRefresh();
+      }
+      if (message.message?.refresh && (!message.message.counters || !liveGame.dataset.heartbeatUrl)) scheduleRefresh(!message.message.counters);
+    };
+    current.onclose = () => {
+      if (socket !== current || stopped) return;
+      subscribed = false;
+      reconnectTimer = setTimeout(connect, retryDelay + Math.random() * retryDelay);
+      retryDelay = Math.min(retryDelay * 2, 15000);
+      scheduleRefresh();
+    };
+    current.onerror = () => current.close();
+  }
+
+  // The server's ping also detects silently broken conference Wi-Fi sockets.
+  setInterval(() => {
+    if (subscribed && Date.now() - lastMessage > 20000) socket?.close();
+    if (!subscribed) refresh();
+  }, 500);
+  setInterval(() => {
+    if (stopped) return;
+    if (subscribed) sendCable("message", { action: "heartbeat" });
+    else if (liveGame.dataset.heartbeatUrl && !state.querySelector(".join-form")) {
+      fetch(liveGame.dataset.heartbeatUrl, {
+        method: "POST", credentials: "same-origin", headers: { "X-CSRF-Token": csrf }, signal: AbortSignal.timeout(12000)
+      }).catch(() => {});
+    }
+  }, 15000);
+  // Conditional reconciliation catches missed signals and expires stale presence.
+  setInterval(refresh, 20000);
+  window.addEventListener("online", () => { if (!subscribed) connect(); scheduleRefresh(); });
+  document.addEventListener("visibilitychange", () => { if (!document.hidden) scheduleRefresh(); });
+  window.addEventListener("pagehide", () => { stopped = true; clearTimeout(reconnectTimer); socket?.close(); });
+  window.addEventListener("pageshow", event => { if (event.persisted) { stopped = false; connect(); scheduleRefresh(); } });
+  syncCountdown();
+  setInterval(updateCountdown, 100);
+  connect();
+}
