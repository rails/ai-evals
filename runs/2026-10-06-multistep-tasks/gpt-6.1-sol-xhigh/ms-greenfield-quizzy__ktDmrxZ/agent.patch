+Rails.application.routes.draw do
+  get "up" => "rails/health#show", as: :rails_health_check
+  root to: redirect("/moderate")
+
+  get "play/:code", to: "play#show", as: :play
+  get "play/:code/state", to: "play#state", as: :play_state
+  post "play/:code/join", to: "play#join", as: :join_play
+  post "play/:code/answer", to: "play#answer", as: :answer_play
+  post "play/:code/heartbeat", to: "play#heartbeat", as: :heartbeat_play
+
+  namespace :moderate do
+    root to: "quizzes#index"
+    resources :games, only: :show do
+      member do
+        get :state
+        post :start
+        post :finish
+        post :next
+        post :top
+        post :draw
+        post :reset_winners
+      end
+    end
+    resources :quizzes do
+      collection do
+        get :import, action: :new_import
+        post :import, action: :create_import
+      end
+      member do
+        get :preview
+        get :export
+      end
+      resources :games, only: :create
+      resources :questions, except: [ :index, :show ] do
+        member do
+          patch :move
+          patch :toggle
+        end
+      end
+    end
+  end
+end
