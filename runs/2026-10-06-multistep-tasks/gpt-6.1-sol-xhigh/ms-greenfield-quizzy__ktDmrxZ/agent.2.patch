@@ -0,0 +1,62 @@
+require "test_helper"
+
+class QuizImportTest < ActiveSupport::TestCase
+  setup do
+    @contents = {
+      "title" => "Transactional conference",
+      "questions" => 2.times.map do |index|
+        { "text" => "Question #{index + 1}", "options" => [ { "text" => "Yes", "correct" => true }, { "text" => "No" } ] }
+      end
+    }
+  end
+
+  test "a failure during the second question write rolls back all earlier writes" do
+    # Simulate a database-save validation failure after the parent and first
+    # question were inserted, not just a failure in the preflight validation.
+    callback = proc do |question|
+      if question.text == "Question 2"
+        question.errors.add(:base, "Rejected during save")
+        throw :abort
+      end
+    end
+    Question.set_callback(:create, :before, callback)
+    importer = QuizImport.new(quiz_json: JSON.generate(@contents))
+    assert_no_difference [ "Quiz.count", "Question.count" ] do
+      assert_not importer.save
+    end
+    assert importer.errors.any?
+  ensure
+    Question.skip_callback(:create, :before, callback)
+  end
+
+  test "unknown metadata cannot overwrite or attach to an existing quiz" do
+    existing = Quiz.create!(title: @contents["title"])
+    question = existing.questions.create!(text: "Original", position: 1,
+      options: [ { "text" => "Right", "correct" => true }, { "text" => "Wrong", "correct" => false } ])
+    @contents.merge!("id" => existing.id, "created_at" => "2000-01-01", "players" => [ { "name" => "Ignore" } ])
+    @contents["questions"][0].merge!("id" => question.id, "quiz_id" => existing.id, "position" => 999)
+    importer = QuizImport.new(quiz_json: JSON.generate(@contents))
+    assert_difference({ "Quiz.count" => 1, "Question.count" => 2 }) { assert importer.save }
+    assert_not_equal existing.id, importer.quiz.id
+    assert_equal "Original", question.reload.text
+    assert_equal [ 1, 2 ], importer.quiz.questions.pluck(:position)
+    assert_equal [ "title", "questions" ], importer.quiz.export_contents.keys
+    assert_equal [ "text", "active", "options" ], importer.quiz.export_contents["questions"][0].keys
+    assert_equal [ "text", "correct" ], importer.quiz.export_contents["questions"][0]["options"][0].keys
+  end
+
+  test "export follows the current question order rather than insertion order" do
+    importer = QuizImport.new(quiz_json: JSON.generate(@contents))
+    assert importer.save
+    first, second = importer.quiz.questions.to_a
+    first.update!(position: 2)
+    second.update!(position: 1)
+    assert_equal [ "Question 2", "Question 1" ], importer.quiz.reload.export_contents["questions"].map { |question| question["text"] }
+  end
+
+  test "deeply nested JSON produces an ordinary validation error" do
+    importer = QuizImport.new(quiz_json: "[" * 101 + "0" + "]" * 101)
+    assert_no_difference([ "Quiz.count", "Question.count" ]) { assert_not importer.save }
+    assert_includes importer.errors.full_messages.join, "Invalid JSON"
+  end
+end
