--- /dev/null
+++ b/test/channels/game_channel_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class GameChannelTest < ActionCable::Channel::TestCase
+  setup do
+    quiz = Quiz.create!(title: "Presence")
+    @game = Game.create_from!(quiz)
+    @player = @game.players.create!(name: "Alice", token_digest: "browser", last_seen_at: Time.current)
+  end
+
+  test "public notification stream has no identity or answers" do
+    stub_connection browser_digest: nil
+    subscribe code: @game.code
+    assert subscription.confirmed?
+    assert_has_stream "game:#{@game.code}"
+    assert_equal 0, PlayerConnection.count
+    @game.refresh!
+    assert_equal({ "refresh" => true }, JSON.parse(broadcasts("game:#{@game.code}").last))
+  end
+
+  test "a browser identity is only attached within the requested game" do
+    other = Game.create_from!(@game.quiz)
+    stub_connection browser_digest: @player.token_digest
+    subscribe code: other.code
+    assert subscription.confirmed?
+    assert_equal 0, PlayerConnection.count
+  end
+
+  test "unknown game subscription is rejected" do
+    stub_connection browser_digest: nil
+    subscribe code: "UNKNOWN"
+    assert subscription.rejected?
+  end
+
+  test "one tab leaving does not disconnect the other tab" do
+    stub_connection browser_digest: @player.token_digest
+    subscribe code: @game.code
+    assert_equal 1, PlayerConnection.count
+    assert_has_stream "player:#{@player.id}"
+    other_tab = @player.player_connections.create!(token: "other-tab", last_seen_at: Time.current)
+    unsubscribe
+    assert_equal 1, @game.players.present.count
+    assert_equal [ other_tab.id ], @player.player_connections.pluck(:id)
+  end
+
+  test "last tab leaving removes player from the active counter" do
+    stub_connection browser_digest: @player.token_digest
+    subscribe code: @game.code
+    perform :heartbeat
+    unsubscribe
+    assert_equal 0, PlayerConnection.count
+    assert_equal 0, @game.players.present.count
+    assert Player.exists?(@player.id)
+  end
+end
