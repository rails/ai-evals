@@ -0,0 +1,15 @@
+class Player < ApplicationRecord
+  PRESENCE_TTL = 45.seconds
+
+  belongs_to :game
+  has_many :answers, dependent: :destroy
+  has_many :player_connections, dependent: :destroy
+  validates :name, presence: true, length: { maximum: 80 }
+  scope :present, -> { where("last_seen_at > ?", PRESENCE_TTL.ago) }
+
+  def touch_presence!
+    was_away = last_seen_at <= PRESENCE_TTL.ago
+    update_columns(last_seen_at: Time.current)
+    game.refresh!(counters: true) if was_away
+  end
+end
