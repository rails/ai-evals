+<% if @game.status == "ended" %>
+  <h1 class="play-title">The quiz is over</h1>
+  <p class="play-lead">Thanks for playing!</p>
+<% elsif !@player&.persisted? %>
+  <h1 class="play-title"><%= @game.title %></h1>
+  <p class="play-lead">Ready to play? Join the live quiz.</p>
+  <%= render "shared/errors", record: @player if @player %>
+  <%= form_with url: join_play_path(code: @game.code), class: "join-form" do %>
+    <%= label_tag :name, "Your name", class: "field-label" %>
+    <%= text_field_tag :name, @player&.name, placeholder: "Your name", class: "input", required: true, maxlength: 80, autocomplete: "nickname" %>
+    <%= button_tag "Join", class: "btn btn--pink" %>
+  <% end %>
+<% elsif @game.status == "waiting" %>
+  <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+  <p class="play-lead">You’re in. Waiting for the quiz to start…</p>
+  <p class="meta mt-4">Keep this page open. Questions will appear here automatically.</p>
+<% else %>
+  <p class="meta live-greeting">Hi, <%= @player.name %>!</p>
+  <div class="play-question__num">Question <%= @game.current_position %> of <%= @total %></div>
+  <h1 class="play-question__body"><%= @question.text %></h1>
+  <% revealed = @game.status == "closed" %>
+  <ol class="play-options unstyled-list <%= 'is-locked is-revealed' if revealed %>">
+    <% @question.options.each_with_index do |option, index| %>
+      <% picked = @answer&.option_index == index %>
+      <li>
+        <%= form_with url: answer_play_path(code: @game.code), method: :post, data: { live_form: true } do %>
+          <%= hidden_field_tag :question_id, @question.id %>
+          <%= hidden_field_tag :option_index, index %>
+          <button type="submit" class="play-option <%= 'is-picked' if picked %> <%= 'is-correct' if revealed && option['correct'] %>" aria-label="<%= option['text'] %>" <%= 'disabled' if revealed %> aria-pressed="<%= picked %>">
+            <span class="play-option__letter" aria-hidden="true"><%= index < 26 ? (65 + index).chr : index + 1 %></span>
+            <span class="play-option__title"><%= option["text"] %></span>
+            <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+            <% if revealed && option["correct"] %><span class="play-option__mark">Correct</span><% end %>
+          </button>
+        <% end %>
+      </li>
+    <% end %>
+  </ol>
+  <% if revealed %>
+    <% outcome = @answer ? (@question.options[@answer.option_index]['correct'] ? 'right' : 'wrong') : 'neutral' %>
+    <div class="play-status play-status--<%= outcome %> mt-4" role="status"><%= { 'right' => 'Correct!', 'wrong' => 'Wrong!', 'neutral' => 'No answer' }.fetch(outcome) %></div>
+    <p class="meta mt-3">Waiting for the moderator…</p>
+  <% else %>
+    <p class="meta mt-4"><%= @answer ? "Answer saved. You can change your choice until the question closes." : "Tap an option to answer." %></p>
+  <% end %>
+<% end %>
