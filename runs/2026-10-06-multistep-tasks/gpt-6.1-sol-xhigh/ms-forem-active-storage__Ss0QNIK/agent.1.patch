diff --git a/app/services/images/stored_profile_image.rb b/app/services/images/stored_profile_image.rb
new file mode 100644
index 0000000..816c63a
--- /dev/null
+++ b/app/services/images/stored_profile_image.rb
@@ -0,0 +1,21 @@
+require "delegate"
+
+module Images
+  # Keep CarrierWave's public read/serialization interface during the rollout.
+  class StoredProfileImage < SimpleDelegator
+    def initialize(record)
+      @record = record
+      super(record.profile_image_file)
+    end
+
+    def url(*args)
+      @record.profile_image_url(*args)
+    end
+
+    delegate :blank?, to: :__getobj__
+
+    def as_json(*)
+      { "url" => url }
+    end
+  end
+end
