@@ -0,0 +1,13 @@
+module SupportEmailAddress
+  def self.domain
+    Rails.application.config.x.helpdesk.support_domain
+  end
+
+  def self.for_account(account)
+    "#{account.subdomain}@#{domain}"
+  end
+
+  def self.for_ticket(ticket)
+    "#{ticket.account.subdomain}+reply-#{ticket.email_reply_token}@#{domain}"
+  end
+end
