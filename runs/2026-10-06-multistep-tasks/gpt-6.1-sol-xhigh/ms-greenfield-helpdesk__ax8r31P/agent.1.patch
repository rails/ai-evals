+    t.index ["account_id", "email"], name: "index_users_on_account_id_and_email", unique: true
+    t.index ["account_id"], name: "index_users_on_account_id"
+    t.index ["email_verification_token_digest"], name: "index_users_on_email_verification_token_digest", unique: true
+    t.index ["password_reset_token_digest"], name: "index_users_on_password_reset_token_digest", unique: true
+    t.check_constraint "email::text = lower(email::text)", name: "users_lowercase_email"
+    t.check_constraint "role::text = ANY (ARRAY['admin'::character varying, 'agent'::character varying, 'customer'::character varying]::text[])", name: "users_valid_role"
+  end
+
+  add_foreign_key "accounts", "users", column: "owner_id", on_delete: :nullify
+  add_foreign_key "sessions", "users", on_delete: :cascade
+  add_foreign_key "users", "accounts", on_delete: :cascade
+end
