new file mode 100644
index 0000000..8d6332f
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,41 @@
+class Account < ApplicationRecord
+  RECOVERY_PERIOD = 90.days
+
+  belongs_to :owner, class_name: "User", optional: true
+  has_many :users, dependent: :destroy
+
+  normalizes :subdomain, with: ->(value) { value.strip.downcase }
+  normalizes :name, with: ->(value) { value.strip }
+
+  validates :name, presence: true, length: { maximum: 255 }
+  validates :subdomain, presence: true, uniqueness: true,
+    length: { maximum: 63 }, format: { with: /\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z/ }
+  validate :owner_belongs_to_account
+
+  scope :cancelled, -> { where.not(cancelled_at: nil) }
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def recoverable?
+    !cancelled? || Time.current < cancelled_at + RECOVERY_PERIOD
+  end
+
+  def cancel!
+    with_lock do
+      update!(cancelled_at: Time.current) unless cancelled?
+      Session.where(user_id: users.select(:id)).delete_all
+    end
+  end
+
+  def api_attributes
+    attributes.slice("id", "name", "subdomain", "owner_id", "cancelled_at", "created_at", "updated_at")
+  end
+
+  private
+
+  def owner_belongs_to_account
+    errors.add(:owner, "must belong to this account") if owner && owner.account_id != id
+  end
+end
