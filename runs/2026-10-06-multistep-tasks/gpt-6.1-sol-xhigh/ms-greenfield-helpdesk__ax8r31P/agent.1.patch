+      raise "HELPDESK_FRONTEND_URL must be an HTTP(S) URL without credentials"
+    end
+    config.x.helpdesk.frontend_url = frontend.to_s
+    frontend.path, frontend.query, frontend.fragment = "", nil, nil
+    config.x.helpdesk.frontend_origin = frontend.to_s
+  end
+end
