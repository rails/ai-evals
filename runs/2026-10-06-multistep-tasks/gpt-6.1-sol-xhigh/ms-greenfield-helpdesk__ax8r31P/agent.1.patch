+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      def create
+        data = params.expect(email_verification: [:email])
+        ensure_strings!(data, :email)
+        user = token = nil
+        @account.with_lock do
+          require_recoverable_account!
+          user = @account.users.find_by(email: data[:email].to_s.strip.downcase)
+          token = user.issue_email_verification! if recovery_user_allowed?(user) && !user.verified?
+        end
+        UserMailer.email_verification(user, token).deliver_now if token
+        render json: { message: "If verification is needed, a link has been sent." }, status: :accepted
+      end
+
+      def confirm
+        data = params.expect(email_verification: [:token])
+        ensure_strings!(data, :token)
+        @account.with_lock do
+          require_recoverable_account!
+          @user = @account.users.find_by(email_verification_token_digest: AuthenticationToken.digest(data[:token])) if data[:token].present?
+          invalid_token! unless recovery_user_allowed?(@user) && @user.confirm_email!(data[:token])
+        end
+        render json: { user: @user.api_attributes }
+      end
+    end
+  end
+end
