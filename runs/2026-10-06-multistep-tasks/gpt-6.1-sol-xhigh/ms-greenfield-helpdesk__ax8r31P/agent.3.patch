diff --git a/app/mailers/invitation_mailer.rb b/app/mailers/invitation_mailer.rb
new file mode 100644
index 0000000..00fbe18
--- /dev/null
+++ b/app/mailers/invitation_mailer.rb
@@ -0,0 +1,9 @@
+class InvitationMailer < ApplicationMailer
+  def invitation(invitation, token)
+    @invitation = invitation
+    url = URI.join(Rails.application.config.x.helpdesk.frontend_url, "/accept-invitation")
+    url.query = URI.encode_www_form(account: invitation.account.subdomain, token: token)
+    @link = url.to_s
+    mail(to: invitation.email, subject: "Join #{invitation.account.name} as an #{invitation.role}")
+  end
+end
