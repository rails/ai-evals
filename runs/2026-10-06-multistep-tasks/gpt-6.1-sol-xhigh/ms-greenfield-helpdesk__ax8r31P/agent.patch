+
+  test "customers cannot set priority during creation or update and never receive it" do
+    post "/api/v1/requests", params: { request: { subject: "New request", priority: "high",
+      comment: { body: "Help" } } }, headers: @customer_headers, as: :json
+    assert_response :created
