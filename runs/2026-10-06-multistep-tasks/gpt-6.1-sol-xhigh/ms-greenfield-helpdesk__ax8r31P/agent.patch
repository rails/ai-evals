+  test "customers can view each valid status and invalid status filters are rejected" do
+    pending = create_ticket(@account, @customer, status: "pending")
+    solved = create_ticket(@account, @customer, status: "solved")
+    create_ticket(@account, @other_customer, status: "pending")
