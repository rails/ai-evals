diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..ac05b5d
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,46 @@
+module Api
+  module V1
+    class AccountsController < BaseController
+      skip_before_action :select_account!, only: :create
+      before_action :authenticate_user!, except: :create
+      before_action :require_active_account!, only: :show
+      before_action :require_owner!, only: [:cancel, :reactivate]
+
+      def create
+        data = params.expect(account: [:name, :subdomain, admin: [:name, :email, :password]])
+        admin = data.expect(admin: [:name, :email, :password])
+        ensure_strings!(data, :name, :subdomain)
+        ensure_strings!(admin, :name, :email, :password)
+        token = nil
+        Account.transaction do
+          @account = Account.create!(data.slice(:name, :subdomain))
+          @user = @account.users.create!(admin.merge(role: "admin", verified: false))
+          @account.update!(owner: @user)
+          token = @user.issue_email_verification!
+        end
+        UserMailer.email_verification(@user, token).deliver_now
+        render json: { account: @account.api_attributes, user: @user.api_attributes }, status: :created
+      end
+
+      def show
+        render json: { account: @account.api_attributes }
+      end
+
+      def cancel
+        @account.with_lock do
+          require_recoverable_account!
+          @account.cancel!
+        end
+        render json: { account: @account.api_attributes }
+      end
+
+      def reactivate
+        @account.with_lock do
+          require_recoverable_account!
+          @account.update!(cancelled_at: nil)
+        end
+        render json: { account: @account.api_attributes }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..18095f5
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,100 @@
+module Api
+  module V1
+    class BaseController < ApplicationController
+      before_action :prevent_caching
+      before_action :select_account!
+
+      private
+
+      def prevent_caching
+        response.headers["Cache-Control"] = "no-store"
+      end
+
+      def select_account!
+        subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase
+        raise ApiError.new("account_required", "X-Helpdesk-Account is required.", :bad_request) if subdomain.blank?
+        @account = Account.find_by!(subdomain: subdomain)
+      end
+
+      def authenticate_user!
+        token = request.headers["Authorization"].to_s[/\ABearer\s+(\S+)\z/i, 1]
+        @session = Session.active.joins(:user).where(users: { account_id: @account.id })
+          .find_by(token_digest: AuthenticationToken.digest(token)) if token.present?
+        raise ApiError.new("unauthorized", "A valid bearer session is required.", :unauthorized) unless @session
+        @user = @session.user
+        require_unsuspended_user!
+        raise ApiError.new("email_not_verified", "Verify your email before signing in.", :forbidden) unless @user.verified?
+      end
+
+      def require_active_account!
+        raise ApiError.new("account_cancelled", "This account is cancelled.", :forbidden) if @account.cancelled?
+        # Mutations recheck this under the account lock. Authentication may have
+        # run before another admin committed a suspension.
+        if @user
+          @user.reload
+          require_unsuspended_user!
+        end
+      end
+
+      def require_recoverable_account!
+        raise ApiError.new("account_expired", "The account's reactivation period has ended.", :gone) unless @account.recoverable?
+      end
+
+      def require_owner!
+        raise ApiError.new("owner_required", "Only the account owner can do this.", :forbidden) unless @account.owner_id == @user.id
+      end
+
+      def require_customer!
+        raise ApiError.new("customer_required", "Only customers can use requests.", :forbidden) unless @user.customer?
+      end
+
+      def require_unsuspended_user!
+        raise ApiError.new("user_suspended", "This user is suspended.", :forbidden) if @user.suspended?
+      end
+
+      def require_admin!
+        raise ApiError.new("admin_required", "Only admins can manage people.", :forbidden) unless @user.admin?
+      end
+
+      def require_staff!
+        unless @user.admin? || @user.agent?
+          raise ApiError.new("staff_required", "Only staff can use tickets.", :forbidden)
+        end
+      end
+
+      def recovery_user_allowed?(user)
+        user && !user.suspended? && (!@account.cancelled? || @account.owner_id == user.id)
+      end
+
+      def ensure_strings!(data, *fields)
+        if fields.any? { |field| !data[field].nil? && !data[field].is_a?(String) }
+          raise ApiError.new("invalid_request", "Text fields must be JSON strings.", :bad_request)
+        end
+      end
+
+      def ensure_integer_ids!(data, *fields)
+        fields.each do |field|
+          next unless data.key?(field)
+          unless data[field].nil? || data[field].is_a?(Integer)
+            raise ApiError.new("invalid_request", "#{field} must be a JSON integer or null.", :bad_request)
+          end
+        end
+      end
+
+      def positive_filter_id(name, value, allow_unassigned: false)
+        return nil if allow_unassigned && value == "unassigned"
+
+        integer = value.is_a?(Integer) || (value.is_a?(String) && value.match?(/\A[0-9]+\z/))
+        unless integer && value.to_i.positive?
+          choices = allow_unassigned ? " or unassigned" : ""
+          raise ApiError.new("invalid_request", "#{name} must be a positive integer#{choices}.", :bad_request)
+        end
+        value.to_i
+      end
+
+      def invalid_token!
+        raise ApiError.new("invalid_token", "The token is invalid or has expired.", :unprocessable_entity)
+      end
+    end
+  end
+end
