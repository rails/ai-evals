+Rails.application.routes.draw do
+  get "up" => "rails/health#show", as: :rails_health_check
+
+  namespace :api do
+    namespace :v1 do
+      post "account/create", to: "accounts#create"
+      get "portal", to: "portals#show"
+      get "account", to: "accounts#show"
+      post "account/cancel", to: "accounts#cancel"
+      post "account/reactivate", to: "accounts#reactivate"
+      post "registrations", to: "registrations#create"
+      resources :requests, only: [:create, :index, :show] do
+        get :comments, on: :member
+      end
+      resources :tickets, only: [:index, :show] do
+        get :comments, on: :member
+        post :merge, on: :member
+      end
+      patch "requests/:id", to: "requests#update", as: :update_request
+      patch "tickets/:id", to: "tickets#update", as: :update_ticket
+      resources :invitations, only: [:create, :index, :show, :destroy] do
+        post :resend, on: :member
+      end
+      resources :invitation_previews, only: :create
+      resources :invitation_acceptances, only: :create
+      resources :users, only: [:index, :show, :update]
+      resources :staff, only: :index
+      resources :groups, only: [:create, :index, :show, :destroy]
+      patch "groups/:id", to: "groups#update", as: :update_group
+      resources :group_memberships, only: [:create, :index, :show, :destroy] do
+        put :make_default, on: :member
+      end
+      post "sessions", to: "sessions#create"
+      delete "session", to: "sessions#destroy"
+      get "me", to: "users#me"
+      patch "me", to: "users#update_me"
+      put "me/password", to: "users#password"
+      post "email_verifications", to: "email_verifications#create"
+      post "email_verifications/confirm", to: "email_verifications#confirm"
+      post "password_resets", to: "password_resets#create"
+      post "password_resets/confirm", to: "password_resets#confirm"
+    end
+  end
+end
