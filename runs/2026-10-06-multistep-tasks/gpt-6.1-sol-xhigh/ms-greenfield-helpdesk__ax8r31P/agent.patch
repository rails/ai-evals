@@ -0,0 +1,272 @@
+require "test_helper"
+
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    @account, @owner = create_business
+    @customer = create_customer(@account)
+    @staff_headers = api_headers(@account, sign_in(@account))
+    @customer_headers = api_headers(@account, sign_in(@account, email: @customer.email))
+  end
+
+  def cursor_get(path, headers: @staff_headers, **params)
+    get path, params: params, headers: headers
+    assert_response :ok
+    response.parsed_body
+  end
+
+  def ids(body, key)
+    body.fetch(key).map { |record| record.fetch("id") }
+  end
+
+  def tied_tickets(count = 5)
+    count.times.map { |i| create_ticket(@account, @customer, subject: "Help #{i}") }.tap do
+      @account.tickets.update_all(updated_at: 1.hour.ago, customer_updated_at: 1.hour.ago)
+    end
+  end
+
+  test "cursor pages traverse tied timestamps in both directions with bounded SQL" do
+    tickets = tied_tickets
+    sql = []
+    subscriber = ->(_name, _start, _finish, _id, payload) { sql << payload[:sql] }
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      first = cursor_get("/api/v1/tickets", page: { size: 2 }, status: "open")
+      assert_equal tickets.last(2).reverse.map(&:id), ids(first, "tickets")
+      assert first.dig("meta", "has_more")
+      assert first.dig("meta", "before_cursor").present?
+      assert first.dig("meta", "after_cursor").present?
+      assert_nil first.dig("links", "prev")
+      assert_equal "open", Rack::Utils.parse_nested_query(URI.parse(first.dig("links", "next")).query)["status"]
+      second = cursor_get(first.dig("links", "next"))
+      assert_equal tickets[1, 2].reverse.map(&:id), ids(second, "tickets")
+      last = cursor_get(second.dig("links", "next"))
+      assert_equal [tickets.first.id], ids(last, "tickets")
+      assert_not last.dig("meta", "has_more")
+      assert_nil last.dig("links", "next")
+      back = cursor_get(last.dig("links", "prev"))
+      assert_equal ids(second, "tickets"), ids(back, "tickets")
+      assert back.dig("meta", "has_more")
+      start = cursor_get(back.dig("links", "prev"))
+      assert_equal ids(first, "tickets"), ids(start, "tickets")
+      assert_not start.dig("meta", "has_more")
+      assert_nil start.dig("links", "prev")
+    end
+    assert sql.none? { |query| query.match?(/\b(?:COUNT\s*\(|OFFSET\s)/i) }, sql.join("\n")
+  end
+
+  test "empty pages expose null cursors and links" do
+    body = cursor_get("/api/v1/requests", headers: @customer_headers, page: { size: 25 })
+    assert_equal({ "requests" => [], "meta" => { "has_more" => false, "after_cursor" => nil,
+      "before_cursor" => nil }, "links" => { "next" => nil, "prev" => nil } }, body)
+  end
+
+  test "snapshot excludes new activity and deleted anchors remain usable" do
+    tickets = tied_tickets
+    first = cursor_get("/api/v1/tickets", page: { size: 2 })
+    travel 1.minute do
+      create_ticket(@account, @customer, subject: "New ticket")
+      tickets[2].touch
+      tickets[3].destroy!
+      second = cursor_get("/api/v1/tickets", page: { size: 2, after: first.dig("meta", "after_cursor") })
+      assert_equal tickets.first(2).reverse.map(&:id), ids(second, "tickets")
+      assert_not second.dig("meta", "has_more")
+      assert_nil second.dig("links", "next")
+    end
+  end
+
+  test "every collection supports complete bidirectional traversal" do
+    tickets = tied_tickets
+    ticket = tickets.first
+    4.times { |i| ticket.comments.create!(author: @customer, body: "Reply #{i}") }
+    note = ticket.comments.create!(author: @owner, body: "Private", public: false)
+    ticket.comments.update_all(created_at: 1.hour.ago)
+    agents = 3.times.map do |i|
+      @account.users.create!(name: "Agent #{i}", email: "agent#{i}@example.test", role: "agent",
+        password: PASSWORD, verified: true)
+    end
+    groups = 5.times.map { |i| @account.groups.create!(name: "Group #{i}") }
+    memberships = groups.map { |group| @account.group_memberships.create!(group: group, user: @owner) }
+    invitations = 5.times.map do |i|
+      Invitation.issue!(@account, email: "invite#{i}@example.test", role: "agent").first
+    end
+    another_customer = create_customer(@account, email: "other@example.test")
+    create_ticket(@account, another_customer)
+    cases = [
+      ["/api/v1/requests", "requests", @customer_headers, tickets.sort_by { |t| [t.reload.customer_updated_at, t.id] }.reverse.map(&:id)],
+      ["/api/v1/tickets/#{ticket.id}/comments", "comments", @staff_headers, ticket.comments.order(:id).ids],
+      ["/api/v1/requests/#{ticket.id}/comments", "comments", @customer_headers, ticket.comments.where.not(id: note.id).order(:id).ids],
+      ["/api/v1/users", "users", @staff_headers, @account.users.order(:id).ids],
+      ["/api/v1/staff", "staff", @staff_headers, [@owner.id, *agents.map(&:id)]],
+      ["/api/v1/invitations", "invitations", @staff_headers, invitations.map(&:id)],
+      ["/api/v1/groups", "groups", @staff_headers, groups.map(&:id)],
+      ["/api/v1/group_memberships", "group_memberships", @staff_headers, memberships.map(&:id)]
+    ]
+    cases.each do |path, key, headers, expected|
+      pages = [cursor_get(path, headers: headers, page: { size: 2 })]
+      while (link = pages.last.dig("links", "next"))
+        assert pages.size < 20, "navigation must terminate"
+        pages << cursor_get(link, headers: headers)
+      end
+      assert_equal expected, pages.flat_map { |body| ids(body, key) }, path
+      body = pages.last
+      pages[0...-1].reverse_each do |previous|
+        body = cursor_get(body.dig("links", "prev"), headers: headers)
+        assert_equal ids(previous, key), ids(body, key), path
+      end
+      assert_nil body.dig("links", "prev")
+    end
+  end
+
+  test "malformed and conflicting pagination fails with an API error" do
+    bad_pages = [
+      { size: 0 }, { size: -1 }, { size: "1.5" }, { size: "two" }, { size: "" },
+      { size: 101 }, { size: 10**30 }, { size: [2] }, { size: { value: 2 } },
+      { size: 2, after: "" }, { after: "garbage" }, { before: "garbage" },
+      { after: ["garbage"] }, { before: { token: "garbage" } },
+      { after: "x" * 8193 }, { after: "a", before: "b" }, { unknown: "x" }
+    ]
+    bad_pages.each do |page|
+      get "/api/v1/tickets", params: { page: page }, headers: @staff_headers
+      assert_response :bad_request, page.inspect
+      assert_equal "invalid_request", response.parsed_body.dig("error", "code")
+    end
+    get "/api/v1/tickets", params: { page: { size: 2 }, per_page: 2 }, headers: @staff_headers
+    assert_response :bad_request
+  end
+
+  test "cursors are signed and bound to account user endpoint and filters" do
+    tickets = tied_tickets
+    body = cursor_get("/api/v1/tickets", page: { size: 2 }, status: "open")
+    token = body.dig("meta", "after_cursor")
+    altered = token.dup
+    altered[0] = altered[0] == "a" ? "b" : "a"
+    get "/api/v1/tickets", params: { status: "open", page: { after: altered } }, headers: @staff_headers
+    assert_response :bad_request
+    [{}, { status: "pending" }].each do |filters|
+      get "/api/v1/tickets", params: filters.merge(page: { after: token }), headers: @staff_headers
+      assert_response :bad_request
+    end
+    get "/api/v1/requests", params: { status: "open", page: { after: token } }, headers: @customer_headers
+    assert_response :bad_request
+    get "/api/v1/tickets/#{tickets.first.id}/comments", params: { page: { after: token } }, headers: @staff_headers
+    assert_response :bad_request
+
+    customer_body = cursor_get("/api/v1/requests", headers: @customer_headers, page: { size: 2 })
+    other_customer = create_customer(@account, email: "other@example.test")
+    other_headers = api_headers(@account, sign_in(@account, email: other_customer.email))
+    get "/api/v1/requests", params: { page: { after: customer_body.dig("meta", "after_cursor") } }, headers: other_headers
+    assert_response :bad_request
+
+    other_account, = create_business(subdomain: "other", email: "owner@other.test")
+    other_headers = api_headers(other_account, sign_in(other_account, email: "owner@other.test"))
+    get "/api/v1/tickets", params: { status: "open", page: { after: token } }, headers: other_headers
+    assert_response :bad_request
+  end
+
+  test "filters survive links and page size can change" do
+    tickets = tied_tickets
+    filters = { status: "open", priority: "normal", requester_id: @customer.id,
+      assignee_id: "unassigned", group_id: "unassigned", q: "Help" }
+    body = cursor_get("/api/v1/tickets", **filters, page: { size: 1 })
+    query = Rack::Utils.parse_nested_query(URI.parse(body.dig("links", "next")).query)
+    assert_equal filters.transform_keys(&:to_s).transform_values(&:to_s), query.except("page")
+    second = cursor_get("/api/v1/tickets", **filters, page: { size: 3, after: body.dig("meta", "after_cursor") })
+    assert_equal tickets[1, 3].reverse.map(&:id), ids(second, "tickets")
+    assert second.dig("meta", "has_more")
+    get "/api/v1/tickets", params: filters.merge(q: "Different", page: { after: body.dig("meta", "after_cursor") }), headers: @staff_headers
+    assert_response :bad_request
+  end
+
+  test "customer snapshot uses public activity and comment snapshot excludes later replies" do
+    tickets = tied_tickets
+    first = cursor_get("/api/v1/requests", headers: @customer_headers, page: { size: 2 })
+    ticket = tickets.first
+    3.times { |i| ticket.comments.create!(author: @customer, body: "Reply #{i}") }
+    comments = ticket.comments.order(:created_at, :id).ids
+    comment_page = cursor_get("/api/v1/requests/#{ticket.id}/comments", headers: @customer_headers, page: { size: 2 })
+    travel 1.minute do
+      tickets[2].comments.create!(author: @owner, body: "Private note", public: false)
+      public_activity = tickets[1]
+      public_activity.comments.create!(author: @owner, body: "Public reply")
+      ticket.comments.create!(author: @customer, body: "New reply")
+      second = cursor_get("/api/v1/requests", headers: @customer_headers,
+        page: { size: 2, after: first.dig("meta", "after_cursor") })
+      assert_equal [tickets[2].id], ids(second, "requests")
+      next_comments = cursor_get(comment_page.dig("links", "next"), headers: @customer_headers)
+      assert_equal comments.last(2), ids(next_comments, "comments")
+      assert_nil next_comments.dig("links", "next")
+    end
+  end
+
+  test "new records with equal or backdated timestamps cannot enter the snapshot" do
+    travel_to(Time.current.change(usec: 123456), with_usec: true) do
+      groups = 3.times.map { |i| @account.groups.create!(name: "Original #{i}") }
+      first = cursor_get("/api/v1/groups", page: { size: 2 })
+      added = @account.groups.create!(name: "Inserted concurrently")
+      added.update_columns(created_at: 1.hour.ago, updated_at: 1.hour.ago)
+      second = cursor_get(first.dig("links", "next"))
+      assert_equal [groups.last.id], ids(second, "groups")
+      assert_not second.dig("meta", "has_more")
+
+      ticket = create_ticket(@account, @customer)
+      2.times { |i| ticket.comments.create!(author: @customer, body: "Original #{i}") }
+      original = ticket.comments.order(:id).ids
+      first = cursor_get("/api/v1/requests/#{ticket.id}/comments", headers: @customer_headers, page: { size: 2 })
+      ticket.comments.create!(author: @customer, body: "Same timestamp, newer ID")
+      second = cursor_get(first.dig("links", "next"), headers: @customer_headers)
+      assert_equal original.last(1), ids(second, "comments")
+      assert_not second.dig("meta", "has_more")
+    end
+  end
+
+  test "terminal and out of range cursor pages have correct navigation" do
+    group = @account.groups.create!(name: "Only group")
+    first = cursor_get("/api/v1/groups", page: { size: 1 })
+    assert_equal [group.id], ids(first, "groups")
+    assert_equal first.dig("meta", "before_cursor"), first.dig("meta", "after_cursor")
+    assert first.dig("meta", "after_cursor").present?
+    assert_equal({ "next" => nil, "prev" => nil }, first.fetch("links"))
+    assert_not first.dig("meta", "has_more")
+    %w[after before].each do |direction|
+      empty = cursor_get("/api/v1/groups", page: { direction => first.dig("meta", "#{direction}_cursor") })
+      assert_empty empty.fetch("groups")
+      assert_equal({ "has_more" => false, "after_cursor" => nil, "before_cursor" => nil }, empty.fetch("meta"))
+      assert_equal({ "next" => nil, "prev" => nil }, empty.fetch("links"))
+    end
+  end
+
+  test "non ticket filtered collections retain scope across cursor navigation" do
+    agents = 3.times.map do |i|
+      @account.users.create!(name: "Agent #{i}", email: "agent#{i}@example.test", role: "agent",
+        password: PASSWORD, verified: true)
+    end
+    group = @account.groups.create!(name: "Support")
+    memberships = agents.map { |agent| @account.group_memberships.create!(group: group, user: agent) }
+    invitations = 3.times.map { |i| Invitation.issue!(@account, email: "invite#{i}@example.test", role: "agent").first }
+    revoked = Invitation.issue!(@account, email: "revoked@example.test", role: "agent").first
+    revoked.revoke!
+    cases = [
+      ["users", { role: "agent", suspended: "false" }, agents.map(&:id)],
+      ["invitations", { status: "pending" }, invitations.map(&:id)],
+      ["group_memberships", { group_id: group.id }, memberships.map(&:id)]
+    ]
+    cases.each do |key, filters, expected|
+      first = cursor_get("/api/v1/#{key}", **filters, page: { size: 2 })
+      second = cursor_get(first.dig("links", "next"))
+      assert_equal expected, ids(first, key) + ids(second, key)
+      assert_nil second.dig("links", "next")
+      assert_equal ids(first, key), ids(cursor_get(second.dig("links", "prev")), key)
+      get "/api/v1/#{key}", params: { page: { after: first.dig("meta", "after_cursor") } }, headers: @staff_headers
+      assert_response :bad_request
+    end
+  end
+
+  test "comment cursors cannot be moved to another conversation" do
+    tickets = tied_tickets(2)
+    ticket = tickets.first
+    ticket.comments.create!(author: @customer, body: "Another reply")
+    first = cursor_get("/api/v1/tickets/#{ticket.id}/comments", page: { size: 1 })
+    get "/api/v1/tickets/#{tickets.last.id}/comments",
+      params: { page: { after: first.dig("meta", "after_cursor") } }, headers: @staff_headers
+    assert_response :bad_request
+  end
+end
diff --git a/test/integration/customer_registration_test.rb b/test/integration/customer_registration_test.rb
new file mode 100644
index 0000000..f1e75d4
--- /dev/null
+++ b/test/integration/customer_registration_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class CustomerRegistrationTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @account, @owner = create_business
+  end
+
+  def register(data = {})
+    post "/api/v1/registrations", params: { user: {
+      name: "Avery", email: "avery@example.test", password: PASSWORD
+    }.merge(data) }, headers: api_headers(@account), as: :json
+  end
+
+  test "registration normalizes identity and cannot choose privileges or membership" do
+    other, = create_business(subdomain: "other")
+    assert_difference ["User.count", "ActionMailer::Base.deliveries.size"], 1 do
+      register(name: " Avery ", email: " AVERY@EXAMPLE.TEST ", role: "admin", verified: true,
+        account_id: other.id, password_digest: "not-a-digest")
+    end
+    assert_response :created
+    user = User.find(response.parsed_body.dig("user", "id"))
+    assert_equal @account.id, user.account_id
+    assert user.customer?
+    assert_not user.verified?
+    assert_equal "Avery", user.name
+    assert_equal "avery@example.test", user.email
+    assert user.authenticate(PASSWORD)
+    assert_equal @owner.id, @account.reload.owner_id
+    assert_equal [user.email], ActionMailer::Base.deliveries.last.to
+    assert_not_includes response.body, "digest"
+    assert_not_includes response.body, "token"
+    assert_equal "acme", URI.decode_www_form(latest_link.query).to_h.fetch("account")
+  end
+
+  test "duplicate email is account scoped and validation sends no mail or leaves users" do
+    create_customer(@account)
+    assert_no_difference ["User.count", "ActionMailer::Base.deliveries.size"] do
+      register(email: " AVERY@EXAMPLE.TEST ")
+    end
+    assert_response :unprocessable_entity
+    other, = create_business(subdomain: "other")
+    @account = other
+    register
+    assert_response :created
+
+    [{ name: " " }, { email: "bad" }, { password: "short" }, { password: "" }].each do |invalid|
+      assert_no_difference ["User.count", "ActionMailer::Base.deliveries.size"] do
+        register({ email: "new@example.test" }.merge(invalid))
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "registration requires an active known portal and a valid envelope" do
+    post "/api/v1/registrations", params: { user: { name: "Avery" } }, as: :json
+    assert_response :bad_request
+    post "/api/v1/registrations", headers: { "X-Helpdesk-Account" => "unknown" }, as: :json
+    assert_response :not_found
+    [{}, { user: [] }, { user: "wrong" }, { user: { name: 123 } }].each do |data|
+      post "/api/v1/registrations", params: data, headers: api_headers(@account), as: :json
+      assert_response :bad_request
+    end
+    @account.cancel!
+    assert_no_difference ["User.count", "ActionMailer::Base.deliveries.size"] do
+      register
+    end
+    assert_response :forbidden
+  end
+
+  test "customers use the existing verification profile and password recovery flows" do
+    register
+    assert_response :created
+    original_token = latest_token
+    request_link(@account, :verification, email: "avery@example.test")
+    verification_token = latest_token
+    confirm_verification(@account, original_token)
+    assert_response :unprocessable_entity
+    confirm_verification(@account, verification_token)
+    assert_response :ok
+    token = sign_in(@account, email: "avery@example.test")
+    headers = api_headers(@account, token)
+    get "/api/v1/me", headers: headers
+    assert_response :ok
+    patch "/api/v1/me", params: { user: { name: "Avery Smith", role: "admin" } }, headers: headers, as: :json
+    assert_response :ok
+    assert_equal "Avery Smith", response.parsed_body.dig("user", "name")
+    assert_equal "customer", response.parsed_body.dig("user", "role")
+    request_link(@account, :reset, email: "avery@example.test")
+    confirm_reset(@account, latest_token)
+    assert_response :ok
+    get "/api/v1/me", headers: headers
+    assert_response :unauthorized
+    new_token = sign_in(@account, email: "avery@example.test", password: NEW_PASSWORD)
+    put "/api/v1/me/password", params: { password_change: {
+      current_password: NEW_PASSWORD, password: PASSWORD
+    } }, headers: api_headers(@account, new_token), as: :json
+    assert_response :ok
+    get "/api/v1/me", headers: api_headers(@account, new_token)
+    assert_response :unauthorized
+  end
+end
diff --git a/test/integration/email_recovery_test.rb b/test/integration/email_recovery_test.rb
new file mode 100644
index 0000000..b11c70a
--- /dev/null
+++ b/test/integration/email_recovery_test.rb
@@ -0,0 +1,166 @@
+require "test_helper"
+
+class EmailRecoveryTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @account, @owner = create_business(verified: false)
+    @other_account, @other_owner = create_business(subdomain: "other", verified: false)
+  end
+
+  test "verification links are replaced single-use account-scoped and expiring" do
+    request_link(@account, :verification)
+    old_token = latest_token
+    assert_equal "/verify-email", latest_link.path
+    assert_equal URI.join(Rails.application.config.x.helpdesk.frontend_url, "/verify-email").host, latest_link.host
+    assert_equal "acme", URI.decode_www_form(latest_link.query).to_h["account"]
+    assert_equal [ENV.fetch("HELPDESK_MAIL_FROM", "support@example.test")], ActionMailer::Base.deliveries.last.from
+    assert_equal [@owner.email], ActionMailer::Base.deliveries.last.to
+    assert_equal AuthenticationToken.digest(old_token), @owner.reload.email_verification_token_digest
+
+    request_link(@account, :verification)
+    new_token = latest_token
+    assert_not_equal old_token, new_token
+    confirm_verification(@account, old_token)
+    assert_response :unprocessable_entity
+    confirm_verification(@other_account, new_token)
+    assert_response :unprocessable_entity
+    assert_not @other_owner.reload.verified?
+    confirm_verification(@account, new_token)
+    assert_response :ok
+    assert @owner.reload.verified?
+    assert_nil @owner.email_verification_token_digest
+    confirm_verification(@account, new_token)
+    assert_response :unprocessable_entity
+  end
+
+  test "verification and reset tokens cannot be exchanged" do
+    request_link(@account, :verification)
+    verification_token = latest_token
+    request_link(@account, :reset)
+    reset_token = latest_token
+    confirm_reset(@account, verification_token)
+    assert_response :unprocessable_entity
+    confirm_verification(@account, reset_token)
+    assert_response :unprocessable_entity
+    confirm_verification(@account, verification_token)
+    assert_response :ok
+  end
+
+  test "expired verification fails without verifying user" do
+    request_link(@account, :verification)
+    token = latest_token
+    travel_to @owner.reload.email_verification_expires_at, with_usec: true do
+      confirm_verification(@account, token)
+      assert_response :unprocessable_entity
+      assert_not @owner.reload.verified?
+    end
+  end
+
+  test "reset links replace old links and revoke all sessions" do
+    @owner.update!(verified: true)
+    session1 = sign_in(@account)
+    session2 = sign_in(@account)
+    request_link(@account, :reset)
+    old_token = latest_token
+    assert_equal "/reset-password", latest_link.path
+    assert_equal "acme", URI.decode_www_form(latest_link.query).to_h["account"]
+    assert_equal AuthenticationToken.digest(old_token), @owner.reload.password_reset_token_digest
+    request_link(@account, :reset)
+    new_token = latest_token
+    confirm_reset(@account, old_token)
+    assert_response :unprocessable_entity
+    confirm_reset(@other_account, new_token)
+    assert_response :unprocessable_entity
+    confirm_reset(@account, new_token)
+    assert_response :ok
+    assert_nil @owner.reload.password_reset_token_digest
+    assert @owner.authenticate(NEW_PASSWORD)
+    assert_not @owner.authenticate(PASSWORD)
+    assert_empty @owner.sessions
+    [session1, session2].each do |token|
+      get "/api/v1/me", headers: api_headers(@account, token)
+      assert_response :unauthorized
+    end
+    confirm_reset(@account, new_token)
+    assert_response :unprocessable_entity
+    sign_in(@account, password: NEW_PASSWORD)
+  end
+
+  test "expired reset token cannot change password" do
+    request_link(@account, :reset)
+    token = latest_token
+    travel_to @owner.reload.password_reset_expires_at, with_usec: true do
+      confirm_reset(@account, token)
+      assert_response :unprocessable_entity
+      assert @owner.reload.authenticate(PASSWORD)
+    end
+  end
+
+  test "invalid new password does not consume reset token or revoke sessions" do
+    @owner.update!(verified: true)
+    session_token = sign_in(@account)
+    request_link(@account, :reset)
+    token = latest_token
+    ["", "short", "a" * 73, nil].each do |password|
+      confirm_reset(@account, token, password: password)
+      assert_response :unprocessable_entity
+      assert_equal AuthenticationToken.digest(token), @owner.reload.password_reset_token_digest
+      assert @owner.authenticate(PASSWORD)
+      assert_equal 1, @owner.sessions.count
+    end
+    get "/api/v1/me", headers: api_headers(@account, session_token)
+    assert_response :ok
+    confirm_reset(@account, token)
+    assert_response :ok
+  end
+
+  test "password reset does not implicitly verify email" do
+    request_link(@account, :reset)
+    confirm_reset(@account, latest_token)
+    assert_response :ok
+    assert_not @owner.reload.verified?
+    post "/api/v1/sessions", params: { session: { email: @owner.email, password: NEW_PASSWORD } },
+      headers: api_headers(@account), as: :json
+    assert_response :forbidden
+  end
+
+  test "unknown emails get generic responses without sending mail" do
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      request_link(@account, :verification, email: "unknown@acme.test")
+      assert_not_includes response.body, "unknown"
+      request_link(@account, :reset, email: "unknown@acme.test")
+      assert_not_includes response.body, "unknown"
+    end
+    @owner.update!(verified: true)
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      request_link(@account, :verification)
+    end
+  end
+
+  test "password change requires current password and revokes sessions and pending reset links" do
+    @owner.update!(verified: true)
+    session1 = sign_in(@account)
+    session2 = sign_in(@account)
+    request_link(@account, :reset)
+    reset_token = latest_token
+    put "/api/v1/me/password", params: { password_change: {
+      current_password: "wrong-password", password: NEW_PASSWORD
+    } }, headers: api_headers(@account, session1), as: :json
+    assert_response :unprocessable_entity
+    assert_equal 2, @owner.sessions.count
+    put "/api/v1/me/password", params: { password_change: {
+      current_password: PASSWORD, password: "short"
+    } }, headers: api_headers(@account, session1), as: :json
+    assert_response :unprocessable_entity
+    assert_equal 2, @owner.sessions.count
+    put "/api/v1/me/password", params: { password_change: {
+      current_password: PASSWORD, password: NEW_PASSWORD
+    } }, headers: api_headers(@account, session1), as: :json
+    assert_response :ok
+    assert_empty @owner.sessions
+    confirm_reset(@account, reset_token)
+    assert_response :unprocessable_entity
+    get "/api/v1/me", headers: api_headers(@account, session2)
+    assert_response :unauthorized
+  end
+end
diff --git a/test/integration/groups_test.rb b/test/integration/groups_test.rb
new file mode 100644
index 0000000..6a3d51b
--- /dev/null
+++ b/test/integration/groups_test.rb
@@ -0,0 +1,200 @@
+require "test_helper"
+
+class GroupsTest < ActionDispatch::IntegrationTest
+  setup do
+    @account, @admin = create_business
+    @agent = @account.users.create!(name: "Sam", email: "sam@example.test", password: PASSWORD,
+      role: "agent", verified: true)
+    @customer = create_customer(@account)
+    @admin_headers = api_headers(@account, Session.issue!(@admin))
+    @staff_headers = api_headers(@account, Session.issue!(@agent))
+    @customer_headers = api_headers(@account, Session.issue!(@customer))
+  end
+
+  test "admins create groups and memberships with an automatic first default" do
+    post "/api/v1/groups", params: { group: { name: " Billing " } }, headers: @admin_headers, as: :json
+    assert_response :created
+    group = response.parsed_body.fetch("group")
+    assert_equal "Billing", group.fetch("name")
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: group.fetch("id"),
+      user_id: @agent.id, default: false } }, headers: @admin_headers, as: :json
+    assert_response :created
+    membership = response.parsed_body.fetch("group_membership")
+    assert_equal group.fetch("id"), membership.fetch("group_id")
+    assert_equal @agent.id, membership.fetch("user_id")
+    assert_equal true, membership.fetch("default")
+  end
+  test "staff browse all groups and memberships in ascending ID order with pagination and combined filters" do
+    first = @account.groups.create!(name: "Technical Support")
+    second = @account.groups.create!(name: "Billing")
+    m1 = @account.group_memberships.create!(group: second, user: @agent)
+    m2 = @account.group_memberships.create!(group: first, user: @admin)
+    m3 = @account.group_memberships.create!(group: first, user: @agent)
+    other, other_admin = create_business(subdomain: "other")
+    other_group = other.groups.create!(name: "Other")
+    other.group_memberships.create!(group: other_group, user: other_admin)
+
+    get "/api/v1/groups", params: { per_page: 1 }, headers: @staff_headers
+    assert_response :ok
+    assert_equal [first.id], response.parsed_body.fetch("groups").map { |g| g.fetch("id") }
+    assert_equal 2, response.parsed_body.fetch("count")
+    assert_equal 2, response.parsed_body.fetch("next_page")
+    get "/api/v1/groups", params: { page: 2, per_page: 1 }, headers: @staff_headers
+    assert_equal [second.id], response.parsed_body.fetch("groups").map { |g| g.fetch("id") }
+    assert_nil response.parsed_body.fetch("next_page")
+    get "/api/v1/groups/#{second.id}", headers: @staff_headers
+    assert_response :ok
+    assert_equal "Billing", response.parsed_body.dig("group", "name")
+
+    get "/api/v1/group_memberships", headers: @staff_headers
+    assert_response :ok
+    assert_equal [m1.id, m2.id, m3.id], response.parsed_body.fetch("group_memberships").map { |m| m.fetch("id") }
+    get "/api/v1/group_memberships", params: { group_id: first.id, user_id: @agent.id }, headers: @staff_headers
+    assert_equal [m3.id], response.parsed_body.fetch("group_memberships").map { |m| m.fetch("id") }
+    assert_equal 1, response.parsed_body.fetch("count")
+    get "/api/v1/group_memberships", params: { user_id: @agent.id, per_page: 1, page: 2 }, headers: @staff_headers
+    assert_equal [m3.id], response.parsed_body.fetch("group_memberships").map { |m| m.fetch("id") }
+    assert_equal 2, response.parsed_body.fetch("count")
+    get "/api/v1/group_memberships", params: { group_id: second.id }, headers: @staff_headers
+    assert_equal [m1.id], response.parsed_body.fetch("group_memberships").map { |m| m.fetch("id") }
+    get "/api/v1/group_memberships/#{m2.id}", headers: @staff_headers
+    assert_response :ok
+    assert_equal @admin.id, response.parsed_body.dig("group_membership", "user_id")
+  end
+
+  test "admins rename and delete groups and switch or remove defaults" do
+    groups = ["Billing", "Technical", "Sales"].map { |name| @account.groups.create!(name: name) }
+    memberships = groups.map { |group| @account.group_memberships.create!(group: group, user: @agent) }
+    assert_equal [true, false, false], memberships.map { |m| m.reload.default }
+    patch "/api/v1/groups/#{groups[0].id}", params: { group: { name: " Accounts " } }, headers: @admin_headers, as: :json
+    assert_response :ok
+    assert_equal "Accounts", groups[0].reload.name
+    put "/api/v1/group_memberships/#{memberships[2].id}/make_default", headers: @admin_headers, as: :json
+    assert_response :ok
+    assert_equal true, response.parsed_body.dig("group_membership", "default")
+    assert_equal [false, false, true], memberships.map { |m| m.reload.default }
+    put "/api/v1/group_memberships/#{memberships[2].id}/make_default", headers: @admin_headers, as: :json
+    assert_response :ok
+    assert_equal 1, @agent.group_memberships.where(default: true).count
+    delete "/api/v1/group_memberships/#{memberships[2].id}", headers: @admin_headers
+    assert_response :no_content
+    assert memberships[0].reload.default?
+    assert_not memberships[1].reload.default?
+    delete "/api/v1/groups/#{groups[0].id}", headers: @admin_headers
+    assert_response :no_content
+    assert_not GroupMembership.exists?(memberships[0].id)
+    assert memberships[1].reload.default?
+    delete "/api/v1/group_memberships/#{memberships[1].id}", headers: @admin_headers
+    assert_response :no_content
+    assert_empty @agent.group_memberships
+  end
+
+  test "creating a membership with default true replaces only that user's default" do
+    first = @account.groups.create!(name: "Billing")
+    second = @account.groups.create!(name: "Technical")
+    previous = @account.group_memberships.create!(group: first, user: @agent)
+    admin_membership = @account.group_memberships.create!(group: first, user: @admin)
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: second.id,
+      user_id: @agent.id, default: true } }, headers: @admin_headers, as: :json
+    assert_response :created
+    assert_equal true, response.parsed_body.dig("group_membership", "default")
+    assert_not previous.reload.default?
+    assert admin_membership.reload.default?
+  end
+
+  test "agents can only read groups and memberships and customers cannot access either resource" do
+    group = @account.groups.create!(name: "Billing")
+    membership = @account.group_memberships.create!(group: group, user: @agent)
+    mutations = [
+      [:post, "/api/v1/groups", { group: { name: "Other" } }],
+      [:patch, "/api/v1/groups/#{group.id}", { group: { name: "Other" } }],
+      [:delete, "/api/v1/groups/#{group.id}", nil],
+      [:post, "/api/v1/group_memberships", { group_membership: { group_id: group.id, user_id: @admin.id } }],
+      [:delete, "/api/v1/group_memberships/#{membership.id}", nil],
+      [:put, "/api/v1/group_memberships/#{membership.id}/make_default", nil]
+    ]
+    mutations.each do |method, path, data|
+      public_send(method, path, params: data, headers: @staff_headers, as: :json)
+      assert_response :forbidden, path
+      assert_equal "admin_required", response.parsed_body.dig("error", "code")
+    end
+    reads = ["/api/v1/groups", "/api/v1/groups/#{group.id}", "/api/v1/group_memberships",
+      "/api/v1/group_memberships/#{membership.id}"]
+    (reads.map { |path| [:get, path, nil] } + mutations).each do |method, path, data|
+      public_send(method, path, params: data, headers: @customer_headers, as: :json)
+      assert_response :forbidden, path
+    end
+    get "/api/v1/groups", headers: api_headers(@account)
+    assert_response :unauthorized
+    assert_equal "Billing", group.reload.name
+    assert membership.reload.default?
+  end
+
+  test "cross-account records cannot be read or mutated and only same-account staff can join" do
+    group = @account.groups.create!(name: "Billing")
+    other, other_admin = create_business(subdomain: "other")
+    other_group = other.groups.create!(name: "Other")
+    other_membership = other.group_memberships.create!(group: other_group, user: other_admin)
+    [[:get, "groups/#{other_group.id}"], [:patch, "groups/#{other_group.id}"],
+      [:delete, "groups/#{other_group.id}"], [:get, "group_memberships/#{other_membership.id}"],
+      [:delete, "group_memberships/#{other_membership.id}"],
+      [:put, "group_memberships/#{other_membership.id}/make_default"]].each do |method, path|
+      public_send(method, "/api/v1/#{path}", params: { group: { name: "Hijacked" } }, headers: @admin_headers, as: :json)
+      assert_response :not_found, path
+    end
+    [[other_group.id, @agent.id], [group.id, other_admin.id], [group.id, @customer.id],
+      [group.id, 0], [0, @agent.id]].each do |group_id, user_id|
+      post "/api/v1/group_memberships", params: { group_membership: { group_id: group_id, user_id: user_id } },
+        headers: @admin_headers, as: :json
+      assert_response :unprocessable_entity
+      assert_equal "validation_failed", response.parsed_body.dig("error", "code")
+    end
+    get "/api/v1/group_memberships", params: { group_id: other_group.id }, headers: @staff_headers
+    assert_equal 0, response.parsed_body.fetch("count")
+    assert other_membership.reload.default?
+  end
+
+  test "invalid names, duplicate memberships, booleans and ID shapes fail without side effects" do
+    group = @account.groups.create!(name: "Billing")
+    membership = @account.group_memberships.create!(group: group, user: @agent)
+    [nil, "", " ", "x" * 256].each do |name|
+      patch "/api/v1/groups/#{group.id}", params: { group: { name: name } }, headers: @admin_headers, as: :json
+      assert_response :unprocessable_entity
+      assert_equal "Billing", group.reload.name
+    end
+    [4, true, ["Billing"], { value: "Billing" }].each do |name|
+      post "/api/v1/groups", params: { group: { name: name } }, headers: @admin_headers, as: :json
+      assert_response :bad_request
+    end
+    post "/api/v1/group_memberships", params: { group_membership: { group_id: group.id,
+      user_id: @agent.id, default: true } }, headers: @admin_headers, as: :json
+    assert_response :unprocessable_entity
+    assert membership.reload.default?
+    ["true", nil, 1, [], {}].each do |value|
+      post "/api/v1/group_memberships", params: { group_membership: { group_id: group.id,
+        user_id: @admin.id, default: value } }, headers: @admin_headers, as: :json
+      assert_response :bad_request
+    end
+    [:group_id, :user_id].each do |field|
+      ["1", false, 1.5, [1], { id: 1 }].each do |value|
+        data = { group_id: group.id, user_id: @admin.id }.merge(field => value)
+        post "/api/v1/group_memberships", params: { group_membership: data }, headers: @admin_headers, as: :json
+        assert_response :bad_request
+      end
+      ["", "0", "-1", "1.5", "1x", "unassigned", [1], { id: 1 }].each do |value|
+        get "/api/v1/group_memberships", params: { field => value }, headers: @staff_headers
+        assert_response :bad_request
+        assert_equal "invalid_request", response.parsed_body.dig("error", "code")
+      end
+    end
+    assert_equal 1, @account.group_memberships.count
+  end
+
+  test "cancelled accounts cannot use groups and memberships" do
+    @account.cancel!
+    ["groups", "group_memberships"].each do |resource|
+      get "/api/v1/#{resource}", headers: @admin_headers
+      assert_response :unauthorized
+    end
+  end
+end
diff --git a/test/integration/inbound_support_email_test.rb b/test/integration/inbound_support_email_test.rb
new file mode 100644
index 0000000..bf1e6f1
--- /dev/null
+++ b/test/integration/inbound_support_email_test.rb
@@ -0,0 +1,473 @@
+require "test_helper"
+
+class InboundSupportEmailTest < ActionDispatch::IntegrationTest
+  setup do
+    @old_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = "relay-test-secret"
+    ActionMailer::Base.deliveries.clear
+    @account, @owner = create_business
+  end
+
+  teardown do
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @old_password
+  end
+
+  test "relay authenticates and opens an email ticket before returning" do
+    source = email_source
+    post relay_path, params: source, headers: { "CONTENT_TYPE" => "message/rfc822" }
+    assert_response :unauthorized
+    assert_no_difference "Ticket.count" do
+      deliver(source, password: "wrong")
+      assert_response :unauthorized
+    end
+
+    assert_difference ["Ticket.count", "Comment.count", "User.count"], 1 do
+      deliver(source)
+      assert_response :no_content
+    end
+    ticket = @account.tickets.last
+    assert_equal "Printer is broken", ticket.subject
+    assert_equal "email", ticket.origin
+    assert_equal "open", ticket.status
+    assert_equal "Please help with the printer.", ticket.comments.first.body.strip
+    assert ticket.comments.first.public?
+    customer = ticket.requester
+    assert_equal "avery@example.test", customer.email
+    assert customer.customer?
+    assert_not customer.verified?
+    assert customer.email_verification_token_digest.present?
+    assert_equal [customer.email], ActionMailer::Base.deliveries.last.to
+    assert_match "Verify your email", ActionMailer::Base.deliveries.last.subject
+    confirm_verification(@account, latest_token)
+    assert_response :ok
+    assert customer.reload.verified?
+  end
+
+  test "accepted Message IDs are deduplicated even when the source changes" do
+    customer = create_customer(@account)
+    deliver(email_source)
+    assert_response :no_content
+    assert_equal customer, @account.tickets.last.requester
+    assert_empty ActionMailer::Base.deliveries
+    assert_no_difference ["Ticket.count", "Comment.count", "User.count"] do
+      deliver(email_source)
+      deliver(email_source(body: "A changed redelivery"))
+    end
+  end
+
+  test "an invalid delivery does not consume the Message ID" do
+    other, = create_business(subdomain: "other", email: "owner@other.test")
+    source = email_source(cc: "#{other.subdomain}@#{support_domain}")
+    assert_no_difference ["Ticket.count", "Comment.count", "User.count"] do
+      deliver(source)
+      assert_response :no_content
+    end
+    assert_difference "Ticket.count", 1 do
+      deliver(email_source)
+      assert_response :no_content
+    end
+  end
+
+  test "a support address in Cc is used and recipient casing is ignored" do
+    customer = create_customer(@account, verified: false)
+    deliver(email_source(to: "friend@example.test", cc: "Acme Support <ACME@#{support_domain.upcase}>"))
+    assert_response :no_content
+    assert_equal customer, @account.tickets.last.requester
+    assert_not customer.reload.verified?
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "staff public replies email only the requester with a private reply address" do
+    customer = create_customer(@account)
+    deliver(email_source)
+    ticket = @account.tickets.last
+    owner_headers = api_headers(@account, sign_in(@account))
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      patch "/api/v1/tickets/#{ticket.id}", params: { ticket: {
+        status: "pending", comment: { body: "Please restart the printer." }
+      } }, headers: owner_headers, as: :json
+      assert_response :ok
+    end
+    reply = ActionMailer::Base.deliveries.last
+    assert_equal [customer.email], reply.to
+    assert_equal ["acme@#{support_domain}"], reply.from
+    assert_equal [ticket.reply_address], reply.reply_to
+    assert_match /\Aacme\+reply-[a-f0-9]{64}@#{Regexp.escape(support_domain)}\z/, reply.reply_to.first
+    assert_equal "Re: Printer is broken", reply.subject
+    assert_equal "Please restart the printer.", reply.body.decoded.strip
+    assert_equal "auto-generated", reply["Auto-Submitted"].value
+    assert_nil response.parsed_body.dig("ticket", "email_reply_token")
+
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      patch "/api/v1/tickets/#{ticket.id}", params: { ticket: {
+        comment: { body: "Internal investigation", public: false }
+      } }, headers: owner_headers, as: :json
+      assert_response :ok
+      patch "/api/v1/tickets/#{ticket.id}", params: { ticket: { status: "solved" } },
+        headers: owner_headers, as: :json
+      assert_response :ok
+      patch "/api/v1/tickets/#{ticket.id}", params: { ticket: {
+        status: "invalid", comment: { body: "Must not send" }
+      } }, headers: owner_headers, as: :json
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "requester email replies reopen pending and solved conversations and keep the original subject" do
+    customer = create_customer(@account, verified: false)
+    deliver(email_source)
+    ticket = @account.tickets.last
+    %w[pending solved].each_with_index do |status, i|
+      ticket.update!(status: status)
+      assert_no_difference ["Ticket.count", "User.count", "ActionMailer::Base.deliveries.size"] do
+        assert_difference "Comment.count", 1 do
+          deliver(email_source(to: ticket.reply_address, from: "AVERY@example.test",
+            subject: "Re: Changed subject", body: "Still broken #{i}", id: "reply-#{i}@example.test"))
+          assert_response :no_content
+        end
+      end
+      assert_equal "open", ticket.reload.status
+      assert_equal "Printer is broken", ticket.subject
+      assert_equal customer, ticket.comments.last.author
+      assert_equal "Still broken #{i}", ticket.comments.last.body.strip
+      assert_not customer.reload.verified?
+    end
+  end
+
+  test "only the requester From address may use the private reply address" do
+    customer = create_customer(@account)
+    deliver(email_source)
+    ticket = @account.tickets.last
+    ticket.update!(status: "solved")
+    assert_no_difference ["Ticket.count", "Comment.count", "User.count", "EmailDelivery.count", "ActionMailer::Base.deliveries.size"] do
+      deliver(email_source(to: ticket.reply_address, from: "intruder@example.test",
+        id: "private-reply@example.test", headers: { "Reply-To" => customer.email }))
+      assert_response :no_content
+    end
+    assert_equal "solved", ticket.reload.status
+    assert_difference "Comment.count", 1 do
+      deliver(email_source(to: ticket.reply_address, id: "private-reply@example.test"))
+    end
+    assert_equal "open", ticket.reload.status
+  end
+
+  test "a new message to the plain support address never threads by subject or references" do
+    customer = create_customer(@account)
+    deliver(email_source)
+    first = @account.tickets.last
+    first.update!(status: "solved")
+    assert_difference "Ticket.count", 1 do
+      deliver(email_source(subject: "Re: Printer is broken", id: "new-request@example.test",
+        headers: { "In-Reply-To" => "<request-1@example.test>", "References" => "<request-1@example.test>" }))
+    end
+    second = @account.tickets.last
+    assert_equal customer, second.requester
+    assert_not_equal first.reply_address, second.reply_address
+    assert_equal "solved", first.reload.status
+  end
+
+  test "reply recipients are tenant scoped and invalid tokens never fall back to opening tickets" do
+    create_customer(@account)
+    deliver(email_source)
+    ticket = @account.tickets.last
+    other, = create_business(subdomain: "other", email: "owner@other.test")
+    bad_addresses = [
+      ticket.reply_address.sub("acme+", "other+"),
+      "acme+reply-#{'0' * 64}@#{support_domain}",
+      "acme+reply-#{ticket.id}@#{support_domain}",
+      "acme+garbage@#{support_domain}",
+      "acme+@#{support_domain}"
+    ]
+    bad_addresses.each_with_index do |address, i|
+      assert_no_difference ["Ticket.count", "Comment.count", "User.count", "EmailDelivery.count"] do
+        deliver(email_source(to: address, cc: "acme@#{support_domain}", id: "bad-token-#{i}@example.test"))
+        assert_response :no_content
+      end
+    end
+    assert_empty other.tickets
+  end
+
+  test "multiple reply tokens or businesses in recipients are ignored" do
+    create_customer(@account)
+    deliver(email_source)
+    first = @account.tickets.last
+    deliver(email_source(id: "second@example.test"))
+    second = @account.tickets.last
+    other, = create_business(subdomain: "other", email: "owner@other.test")
+    [
+      [first.reply_address, second.reply_address],
+      [first.reply_address, "#{other.subdomain}@#{support_domain}"],
+      ["acme@#{support_domain}", "#{other.subdomain}@#{support_domain}"]
+    ].each_with_index do |recipients, i|
+      assert_no_difference ["Ticket.count", "Comment.count", "User.count", "EmailDelivery.count"] do
+        deliver(email_source(to: recipients.first, cc: recipients.last, id: "ambiguous-#{i}@example.test"))
+      end
+    end
+    assert_difference "Comment.count", 1 do
+      deliver(email_source(to: first.reply_address, cc: "acme@#{support_domain}", id: "same-account@example.test"))
+    end
+  end
+
+  test "automated and list mail are ignored without consuming a Message ID" do
+    headers_to_ignore = [
+      { "Auto-Submitted" => "auto-generated" }, { "Auto-Submitted" => "auto-replied" },
+      { "Precedence" => "bulk" }, { "Precedence" => "list" }, { "Precedence" => "junk" },
+      { "List-Id" => "<list.example.test>" }, { "List-Unsubscribe" => "<mailto:unsubscribe@example.test>" },
+      { "X-Autoreply" => "yes" }, { "X-Autorespond" => "yes" }, { "Return-Path" => "<>" }
+    ]
+    headers_to_ignore.each do |headers|
+      assert_no_difference ["Ticket.count", "Comment.count", "User.count", "EmailDelivery.count", "ActionMailer::Base.deliveries.size"] do
+        deliver(email_source(headers: headers))
+        assert_response :no_content
+      end
+    end
+    assert_difference "Ticket.count", 1 do
+      deliver(email_source(headers: { "Auto-Submitted" => "no" }))
+    end
+  end
+
+  test "an identical delivery can retry after the business is restored" do
+    @account.cancel!
+    source = email_source
+    assert_no_difference ["Ticket.count", "User.count", "EmailDelivery.count"] do
+      deliver(source)
+    end
+    @account.update!(cancelled_at: nil)
+    assert_difference "Ticket.count", 1 do
+      deliver(source)
+    end
+  end
+
+  test "unknown businesses and missing senders are ignored" do
+    [email_source(to: "missing@#{support_domain}"), email_source(to: "acme@somewhere.test"),
+      email_source(from: nil), email_source(from: ["avery@example.test", "intruder@example.test"])].each do |source|
+      assert_no_difference ["Ticket.count", "Comment.count", "User.count", "EmailDelivery.count"] do
+        deliver(source)
+        assert_response :no_content
+      end
+    end
+    assert_difference "Ticket.count", 1 do
+      deliver(email_source)
+    end
+  end
+
+  test "invalid subjects and empty text do not block a corrected retry" do
+    [email_source(subject: ""), email_source(subject: "x" * 256), email_source(body: "  ")].each do |source|
+      assert_no_difference ["Ticket.count", "Comment.count", "User.count", "EmailDelivery.count"] do
+        deliver(source)
+        assert_response :no_content
+      end
+    end
+    assert_difference "Ticket.count", 1 do
+      deliver(email_source)
+    end
+  end
+
+  test "customer validation failure rolls back the accepted delivery marker" do
+    # An invitation reserves this address against customer registration.
+    invitation, = Invitation.issue!(@account, email: "avery@example.test", role: "agent")
+    source = email_source
+    assert_no_difference ["Ticket.count", "Comment.count", "User.count", "EmailDelivery.count"] do
+      deliver(source)
+    end
+    invitation.destroy!
+    assert_difference "Ticket.count", 1 do
+      deliver(source)
+    end
+  end
+
+  test "suspended customers and staff senders cannot create customer tickets" do
+    customer = create_customer(@account)
+    customer.update!(suspended: true)
+    [customer.email, @owner.email].each do |sender|
+      assert_no_difference ["Ticket.count", "Comment.count", "User.count", "EmailDelivery.count"] do
+        deliver(email_source(from: sender))
+      end
+    end
+    customer.update!(suspended: false)
+    assert_difference "Ticket.count", 1 do
+      deliver(email_source)
+    end
+  end
+
+  test "MIME decoding uses the plain text part and never HTML or attachments" do
+    source = Mail.new do |mail|
+      mail.from = "avery@example.test"
+      mail.to = "acme@#{support_domain}"
+      mail.subject = "MIME issue"
+      mail.message_id = "mime@example.test"
+      mail.text_part = Mail::Part.new do
+        content_type "text/plain; charset=UTF-8"
+        content_transfer_encoding "quoted-printable"
+        body "Caf=C3=A9 support"
+      end
+      mail.html_part = Mail::Part.new do
+        content_type "text/html; charset=UTF-8"
+        body "<p>Different HTML content</p>"
+      end
+      mail.attachments["secret.txt"] = "Attachment content"
+    end.to_s
+    deliver(source)
+    assert_response :no_content
+    assert_equal "Café support", @account.tickets.last.comments.first.body.strip
+  end
+
+  test "HTML only mail is ignored and a plain text retry can be accepted" do
+    source = Mail.new(email_source)
+    source.content_type = "text/html"
+    source.body = "<p>Not plain text</p>"
+    assert_no_difference ["Ticket.count", "User.count", "EmailDelivery.count"] do
+      deliver(source.to_s)
+    end
+    assert_difference "Ticket.count", 1 do
+      deliver(email_source)
+    end
+  end
+
+  test "relay requires the actionmailbox username and RFC822 content type" do
+    post relay_path, params: email_source, headers: {
+      "CONTENT_TYPE" => "message/rfc822",
+      "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials("wrong", "relay-test-secret")
+    }
+    assert_response :unauthorized
+    assert_no_difference ["Ticket.count", "User.count"] do
+      deliver(email_source, content_type: "text/plain")
+      assert_response :unsupported_media_type
+    end
+  end
+
+  test "deduplication survives Action Mailbox raw email cleanup" do
+    create_customer(@account)
+    source = email_source
+    deliver(source)
+    ActionMailbox::InboundEmail.where(message_id: "request-1@example.test").destroy_all
+    assert_no_difference ["Ticket.count", "Comment.count", "EmailDelivery.count"] do
+      deliver(source)
+    end
+  end
+
+  test "duplicate automation and recipient headers cannot bypass filtering" do
+    source = email_source(headers: { "Auto-Submitted" => "no" })
+    source = "Auto-Submitted: auto-replied\r\n" + source
+    assert_no_difference ["Ticket.count", "User.count", "EmailDelivery.count"] do
+      deliver(source)
+      assert_response :no_content
+    end
+    other, = create_business(subdomain: "other", email: "owner@other.test")
+    source = "Cc: #{other.subdomain}@#{support_domain}\r\n" + email_source(cc: "friend@example.test")
+    assert_no_difference ["Ticket.count", "User.count", "EmailDelivery.count"] do
+      deliver(source)
+      assert_response :no_content
+    end
+    source = "Cc: acme@#{support_domain}\r\n" + email_source(to: "friend@example.test", cc: "another@example.test")
+    assert_no_difference ["Ticket.count", "User.count", "EmailDelivery.count"] do
+      deliver(source)
+      assert_response :no_content
+    end
+    assert_difference "Ticket.count", 1 do
+      deliver(email_source)
+    end
+  end
+
+  test "mail cannot attach to a portal-origin ticket" do
+    customer = create_customer(@account)
+    ticket = create_ticket(@account, customer)
+    assert_no_difference ["Ticket.count", "Comment.count", "EmailDelivery.count"] do
+      deliver(email_source(to: ticket.reply_address))
+    end
+  end
+
+  test "unknown charset deliveries do not reserve the Message ID" do
+    source = Mail.new(email_source)
+    source.content_type = "text/plain; charset=unknown-helpdesk-charset"
+    assert_no_difference ["Ticket.count", "User.count", "EmailDelivery.count"] do
+      deliver(source.to_s)
+      assert_response :no_content
+    end
+    assert_difference "Ticket.count", 1 do
+      deliver(email_source)
+    end
+  end
+
+  test "accepted Message IDs are globally deduplicated across businesses" do
+    deliver(email_source)
+    other, = create_business(subdomain: "other", email: "owner@other.test")
+    assert_no_difference ["Ticket.count", "Comment.count", "User.count", "EmailDelivery.count"] do
+      deliver(email_source(to: "#{other.subdomain}@#{support_domain}"))
+      assert_response :no_content
+    end
+    assert_empty other.tickets
+  end
+
+  test "email to a merged source is rejected without redirecting or consuming its Message ID" do
+    create_customer(@account)
+    deliver(email_source)
+    source = @account.tickets.last
+    deliver(email_source(id: "original@example.test", subject: "Original issue"))
+    target = @account.tickets.last
+    target.update!(status: "solved")
+    old_comments = source.comments.pluck(:id)
+    original_reply_address = source.reply_address
+    target_reply_address = target.reply_address
+    headers = api_headers(@account, sign_in(@account))
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      post "/api/v1/tickets/#{source.id}/merge", params: { merge: {
+        target_id: target.id, source_comment: { public: true }, target_comment: { public: true }
+      } }, headers: headers, as: :json
+      assert_response :ok
+    end
+    assert_equal original_reply_address, source.reload.reply_address
+    assert_equal target_reply_address, target.reload.reply_address
+    assert_equal old_comments.first, EmailDelivery.find_by!(message_id: "request-1@example.test").comment_id
+    source_snapshot = source.attributes
+    target_snapshot = target.attributes
+    assert_no_difference ["Ticket.count", "Comment.count", "User.count", "EmailDelivery.count", "ActionMailer::Base.deliveries.size"] do
+      deliver(email_source(to: original_reply_address, id: "closed-reply@example.test", body: "Reply to duplicate"))
+      assert_response :no_content
+    end
+    assert_equal "bounced", ActionMailbox::InboundEmail.find_by!(message_id: "closed-reply@example.test").status
+    assert_equal source_snapshot, source.reload.attributes
+    assert_equal target_snapshot, target.reload.attributes
+    assert_equal "closed", source.status
+    assert_equal "solved", target.status
+    assert_nil EmailDelivery.find_by(message_id: "closed-reply@example.test")
+    assert_difference ["Comment.count", "EmailDelivery.count"], 1 do
+      deliver(email_source(to: target_reply_address, id: "closed-reply@example.test", body: "Reply to original"))
+      assert_response :no_content
+    end
+    assert_equal "open", target.reload.status
+    assert_equal "Reply to original", target.comments.last.body.strip
+    assert_equal "closed", source.reload.status
+    assert_equal target.id, source.merged_into_id
+  end
+
+  private
+
+  def support_domain
+    Rails.application.config.x.helpdesk.support_domain || "support.example.test"
+  end
+
+  def relay_path
+    "/rails/action_mailbox/relay/inbound_emails"
+  end
+
+  def email_source(to: "acme@#{support_domain}", cc: nil, from: "Avery <avery@example.test>",
+    subject: "Printer is broken", body: "Please help with the printer.", id: "request-1@example.test", headers: {})
+    Mail.new do |mail|
+      mail.from = from
+      mail.to = to
+      mail.cc = cc if cc
+      mail.subject = subject
+      mail.message_id = id
+      headers.each { |name, value| mail[name] = value }
+      mail.body = body
+    end.to_s
+  end
+
+  def deliver(source, password: "relay-test-secret", content_type: "message/rfc822")
+    post relay_path, params: source, headers: {
+      "CONTENT_TYPE" => content_type,
+      "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials("actionmailbox", password)
+    }
+  end
+end
diff --git a/test/integration/portal_conversation_test.rb b/test/integration/portal_conversation_test.rb
new file mode 100644
index 0000000..b306954
--- /dev/null
+++ b/test/integration/portal_conversation_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class PortalConversationTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @account, @owner = create_business
+  end
+
+  test "a registered customer verifies signs in and converses with staff without reply emails" do
+    post "/api/v1/registrations", params: { user: {
+      name: "Avery", email: "avery@example.test", password: "my-customer-password"
+    } }, headers: api_headers(@account), as: :json
+    assert_response :created
+    customer = response.parsed_body.fetch("user")
+    assert_equal "customer", customer.fetch("role")
+    assert_equal false, customer.fetch("verified")
+    assert_equal 1, ActionMailer::Base.deliveries.size
+
+    post "/api/v1/sessions", params: { session: {
+      email: customer.fetch("email"), password: "my-customer-password"
+    } }, headers: api_headers(@account), as: :json
+    assert_response :forbidden
+    confirm_verification(@account, latest_token)
+    assert_response :ok
+    token = sign_in(@account, email: customer.fetch("email"), password: "my-customer-password")
+    customer_headers = api_headers(@account, token)
+
+    post "/api/v1/requests", params: { request: {
+      subject: "Cannot download my receipt", comment: { body: "The download button does nothing." }
+    } }, headers: customer_headers, as: :json
+    assert_response :created
+    request_record = response.parsed_body.fetch("request")
+    assert_equal "Cannot download my receipt", request_record.fetch("subject")
+    assert_equal "open", request_record.fetch("status")
+    assert_equal customer.fetch("id"), request_record.fetch("requester_id")
+    assert request_record.fetch("created_at")
+    assert request_record.fetch("updated_at")
+    id = request_record.fetch("id")
+
+    get "/api/v1/requests", headers: customer_headers
+    assert_response :ok
+    assert_equal [id], response.parsed_body.fetch("requests").map { |record| record.fetch("id") }
+    assert_equal({ "count" => 1, "page" => 1, "per_page" => 25,
+      "next_page" => nil, "previous_page" => nil }, response.parsed_body.except("requests"))
+    get "/api/v1/requests/#{id}", headers: customer_headers
+    assert_response :ok
+    assert_equal id, response.parsed_body.dig("request", "id")
+
+    owner_headers = api_headers(@account, sign_in(@account))
+    get "/api/v1/tickets/#{id}", headers: owner_headers
+    assert_response :ok
+    assert_equal({ "id" => customer.fetch("id"), "name" => "Avery", "email" => "avery@example.test" },
+      response.parsed_body.dig("ticket", "requester"))
+
+    patch "/api/v1/tickets/#{id}", params: { ticket: {
+      comment: { body: "Please try again now." }, status: "pending"
+    } }, headers: owner_headers, as: :json
+    assert_response :ok
+    assert_equal "pending", response.parsed_body.dig("ticket", "status")
+    patch "/api/v1/requests/#{id}", params: { request: {
+      comment: { body: "It works, thank you." }, status: "solved"
+    } }, headers: customer_headers, as: :json
+    assert_response :ok
+    assert_equal "solved", response.parsed_body.dig("request", "status")
+
+    get "/api/v1/requests/#{id}/comments", headers: customer_headers
+    assert_response :ok
+    comments = response.parsed_body.fetch("comments")
+    assert_equal ["The download button does nothing.", "Please try again now.", "It works, thank you."],
+      comments.map { |comment| comment.fetch("body") }
+    assert_equal({ "id" => customer.fetch("id"), "name" => "Avery" }, comments.first.fetch("author"))
+    assert_equal({ "id" => @owner.id, "name" => @owner.name }, comments.second.fetch("author"))
+    assert comments.all? { |comment| comment.fetch("public") && comment.fetch("created_at") }
+    assert_equal 3, response.parsed_body.fetch("count")
+    assert_equal 1, ActionMailer::Base.deliveries.size
+  end
+end
diff --git a/test/integration/signup_validation_test.rb b/test/integration/signup_validation_test.rb
new file mode 100644
index 0000000..fe315f4
--- /dev/null
+++ b/test/integration/signup_validation_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class SignupValidationTest < ActionDispatch::IntegrationTest
+  def signup_payload
+    { account: { name: "Acme", subdomain: "acme", admin: {
+      name: "Jo", email: "jo@acme.test", password: PASSWORD
+    } } }
+  end
+
+  test "signup normalizes identity and ignores privileged or internal fields" do
+    ActionMailer::Base.deliveries.clear
+    data = signup_payload
+    data[:account][:subdomain] = " ACME "
+    data[:account][:owner_id] = 42
+    data[:account][:cancelled_at] = Time.current
+    data[:account][:admin].merge!(email: " JO@ACME.TEST ", role: "customer", verified: true)
+    assert_difference ["Account.count", "User.count", "ActionMailer::Base.deliveries.size"], 1 do
+      post "/api/v1/account/create", params: data, as: :json
+    end
+    assert_response :created
+    account = Account.last
+    assert_equal "acme", account.subdomain
+    assert_equal account.id, account.owner.account_id
+    assert account.owner.admin?
+    assert_not account.owner.verified?
+    assert_nil account.cancelled_at
+    assert_equal "jo@acme.test", account.owner.email
+    assert_not_includes response.body, "digest"
+    assert_not_includes response.body, "token"
+  end
+
+  test "invalid admin rolls back the business and sends no email" do
+    %i[name email password].each do |field|
+      data = signup_payload
+      data[:account][:admin][field] = ""
+      assert_no_difference ["Account.count", "User.count", "ActionMailer::Base.deliveries.size"] do
+        post "/api/v1/account/create", params: data, as: :json
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "subdomains are unique case-insensitively" do
+    create_business
+    data = signup_payload
+    data[:account][:subdomain] = "ACME"
+    assert_no_difference ["Account.count", "User.count"] do
+      post "/api/v1/account/create", params: data, as: :json
+    end
+    assert_response :unprocessable_entity
+  end
+
+  test "invalid account fields do not leave an owner behind" do
+    ["", "not a domain", "-invalid", "invalid-", "a" * 64].each do |subdomain|
+      data = signup_payload
+      data[:account][:subdomain] = subdomain
+      assert_no_difference ["Account.count", "User.count"] do
+        post "/api/v1/account/create", params: data, as: :json
+      end
+      assert_response :unprocessable_entity
+    end
+    data = signup_payload
+    data[:account][:name] = ""
+    post "/api/v1/account/create", params: data, as: :json
+    assert_response :unprocessable_entity
+  end
+
+  test "missing or malformed envelopes return JSON bad requests" do
+    [{}, { account: [] }, { account: "wrong" }, { account: { name: "Acme", subdomain: "acme" } }].each do |data|
+      post "/api/v1/account/create", params: data, as: :json
+      assert_response :bad_request
+      assert_equal "invalid_request", response.parsed_body.dig("error", "code")
+    end
+    post "/api/v1/account/create", params: '{"account":', headers: { "Content-Type" => "application/json" }
+    assert_response :bad_request
+    assert_equal "invalid_request", response.parsed_body.dig("error", "code")
+  end
+
+  test "non-string credentials produce JSON errors instead of exceptions" do
+    data = signup_payload
+    data[:account][:admin][:password] = 123456789
+    post "/api/v1/account/create", params: data, as: :json
+    assert_response :bad_request
+
+    account, owner = create_business
+    reset = owner.issue_password_reset!
+    confirm_reset(account, reset, password: 123456789)
+    assert_response :bad_request
+    assert owner.reload.authenticate(PASSWORD)
+
+    token = sign_in(account)
+    put "/api/v1/me/password", params: { password_change: {
+      current_password: PASSWORD, password: true
+    } }, headers: api_headers(account, token), as: :json
+    assert_response :bad_request
+  end
+end
diff --git a/test/integration/team_invitations_test.rb b/test/integration/team_invitations_test.rb
new file mode 100644
index 0000000..f97ab9a
--- /dev/null
+++ b/test/integration/team_invitations_test.rb
@@ -0,0 +1,265 @@
+require "test_helper"
+
+class TeamInvitationsTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @account, @owner = create_business
+    @headers = api_headers(@account, sign_in(@account))
+  end
+
+  def invite(email: "sam@example.test", role: "agent")
+    post "/api/v1/invitations", params: { invitation: { email: email, role: role } }, headers: @headers, as: :json
+  end
+
+  def preview(token, account: @account)
+    post "/api/v1/invitation_previews", params: { invitation_preview: { token: token } },
+      headers: api_headers(account), as: :json
+  end
+
+  def accept(token, account: @account, password: PASSWORD)
+    post "/api/v1/invitation_acceptances", params: { invitation_acceptance: {
+      token: token, name: "Sam", password: password, role: "customer", verified: false
+    } }, headers: api_headers(account), as: :json
+  end
+
+  test "invitation link previews and accepts verified staff without a verification email" do
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      invite(email: " SAM@Example.Test ")
+    end
+    assert_response :created
+    invitation = response.parsed_body.fetch("invitation")
+    assert_equal "sam@example.test", invitation.fetch("email")
+    assert_equal "agent", invitation.fetch("role")
+    assert_equal "pending", invitation.fetch("status")
+    assert_not invitation.key?("token_digest")
+    assert_not invitation.key?("token")
+    assert_equal "/accept-invitation", latest_link.path
+    assert_equal @account.subdomain, URI.decode_www_form(latest_link.query).to_h.fetch("account")
+    token = latest_token
+    stored = Invitation.find(invitation.fetch("id"))
+    assert_equal AuthenticationToken.digest(token), stored.token_digest
+    assert_not_equal token, stored.token_digest
+    preview(token)
+    assert_response :ok
+    data = response.parsed_body.fetch("invitation_preview")
+    assert_equal "sam@example.test", data.fetch("email")
+    assert_equal "agent", data.fetch("role")
+    assert_equal @account.name, data.fetch("account_name")
+    assert_equal @account.subdomain, data.fetch("subdomain")
+    assert_equal invitation.fetch("expires_at"), data.fetch("expires_at")
+    assert_difference "User.count", 1 do
+      assert_no_difference "ActionMailer::Base.deliveries.size" do
+        accept(token)
+      end
+    end
+    assert_response :created
+    assert_equal true, response.parsed_body.dig("user", "verified")
+    assert_equal "agent", response.parsed_body.dig("user", "role")
+    assert_equal @account.id, response.parsed_body.dig("account", "id")
+    assert_equal "accepted", Invitation.find(invitation.fetch("id")).status
+    sign_in(@account, email: "sam@example.test")
+    accept(token)
+    assert_response :unprocessable_entity
+    preview(token)
+    assert_response :unprocessable_entity
+  end
+
+  test "pending invites reserve emails and cannot compete with users or other invites" do
+    invite
+    assert_response :created
+    token = latest_token
+    assert_no_difference ["Invitation.count", "ActionMailer::Base.deliveries.size"] do
+      invite(email: " SAM@example.test ", role: "admin")
+    end
+    assert_response :unprocessable_entity
+    assert_no_difference ["User.count", "ActionMailer::Base.deliveries.size"] do
+      post "/api/v1/registrations", params: { user: { name: "Sam", email: " SAM@example.test ", password: PASSWORD } },
+        headers: api_headers(@account), as: :json
+    end
+    assert_response :unprocessable_entity
+    invite(email: @owner.email)
+    assert_response :unprocessable_entity
+    other, = create_business(subdomain: "other")
+    preview(token, account: other)
+    assert_response :unprocessable_entity
+    accept(token, account: other)
+    assert_response :unprocessable_entity
+    accept(token, password: "short")
+    assert_response :unprocessable_entity
+    preview(token)
+    assert_response :ok
+    accept(token)
+    assert_response :created
+  end
+
+  test "resend rotates tokens expired invitations can be resent and revocation frees email" do
+    invite
+    assert_response :created
+    id = response.parsed_body.dig("invitation", "id")
+    old_token = latest_token
+    post "/api/v1/invitations/#{id}/resend", headers: @headers
+    assert_response :ok
+    new_token = latest_token
+    assert_not_equal old_token, new_token
+    preview(old_token)
+    assert_response :unprocessable_entity
+    Invitation.find(id).update!(expires_at: 1.second.ago)
+    get "/api/v1/invitations?status=expired", headers: @headers
+    assert_response :ok
+    assert_equal [id], response.parsed_body.fetch("invitations").map { |item| item.fetch("id") }
+    assert_equal "expired", response.parsed_body.fetch("invitations").first.fetch("status")
+    preview(new_token)
+    assert_response :unprocessable_entity
+    post "/api/v1/invitations/#{id}/resend", headers: @headers
+    assert_response :ok
+    token = latest_token
+    delete "/api/v1/invitations/#{id}", headers: @headers
+    assert_response :no_content
+    assert_equal "revoked", Invitation.find(id).status
+    preview(token)
+    assert_response :unprocessable_entity
+    accept(token)
+    assert_response :unprocessable_entity
+    post "/api/v1/invitations/#{id}/resend", headers: @headers
+    assert_response :unprocessable_entity
+    invite
+    assert_response :created
+    post "/api/v1/invitations/#{id}/resend", headers: @headers
+    assert_response :unprocessable_entity
+  end
+
+  test "admin invitations and tenant scoped ordered management" do
+    invite(role: "admin")
+    assert_response :created
+    first_id = response.parsed_body.dig("invitation", "id")
+    accept(latest_token)
+    assert_response :created
+    assert_equal "admin", response.parsed_body.dig("user", "role")
+    invite(email: "second@example.test")
+    assert_response :created
+    second_id = response.parsed_body.dig("invitation", "id")
+    get "/api/v1/invitations", headers: @headers
+    assert_response :ok
+    assert_equal [first_id, second_id], response.parsed_body.fetch("invitations").map { |item| item.fetch("id") }
+    get "/api/v1/invitations?status=pending", headers: @headers
+    assert_equal [second_id], response.parsed_body.fetch("invitations").map { |item| item.fetch("id") }
+    get "/api/v1/invitations/#{first_id}", headers: @headers
+    assert_response :ok
+    assert_equal "accepted", response.parsed_body.dig("invitation", "status")
+    post "/api/v1/invitations/#{first_id}/resend", headers: @headers
+    assert_response :unprocessable_entity
+    delete "/api/v1/invitations/#{first_id}", headers: @headers
+    assert_response :unprocessable_entity
+    other, owner = create_business(subdomain: "other")
+    other_headers = api_headers(other, sign_in(other, email: owner.email))
+    ["get", "delete", "resend"].each do |action|
+      action == "resend" ? post("/api/v1/invitations/#{second_id}/resend", headers: other_headers) :
+        public_send(action, "/api/v1/invitations/#{second_id}", headers: other_headers)
+      assert_response :not_found
+    end
+  end
+
+  test "only admins manage invitations and cancelled accounts cannot use invitations" do
+    customer = create_customer(@account)
+    agent = @account.users.create!(name: "Agent", email: "agent@example.test", password: PASSWORD, role: "agent", verified: true)
+    [customer, agent].each do |user|
+      headers = api_headers(@account, sign_in(@account, email: user.email))
+      get "/api/v1/invitations", headers: headers
+      assert_response :forbidden
+      post "/api/v1/invitations", params: { invitation: { email: "new@example.test", role: "agent" } }, headers: headers, as: :json
+      assert_response :forbidden
+    end
+    invite
+    assert_response :created
+    token = latest_token
+    @account.cancel!
+    preview(token)
+    assert_response :forbidden
+    accept(token)
+    assert_response :forbidden
+  end
+
+  test "expired reservations release email and cannot compete with replacement invitations" do
+    invite
+    assert_response :created
+    old_id = response.parsed_body.dig("invitation", "id")
+    old_token = latest_token
+    Invitation.find(old_id).update!(expires_at: Time.current)
+    invite
+    assert_response :created
+    replacement_id = response.parsed_body.dig("invitation", "id")
+    replacement_token = latest_token
+    assert_not_equal old_id, replacement_id
+    assert_equal "expired", Invitation.find(old_id).status
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      post "/api/v1/invitations/#{old_id}/resend", headers: @headers
+    end
+    assert_response :unprocessable_entity
+    preview(old_token)
+    assert_response :unprocessable_entity
+    preview(replacement_token)
+    assert_response :ok
+    delete "/api/v1/invitations/#{replacement_id}", headers: @headers
+    assert_response :no_content
+    post "/api/v1/registrations", params: { user: { name: "Sam", email: "sam@example.test", password: PASSWORD } },
+      headers: api_headers(@account), as: :json
+    assert_response :created
+    post "/api/v1/invitations/#{old_id}/resend", headers: @headers
+    assert_response :unprocessable_entity
+  end
+
+  test "expired invitation alone does not block registration" do
+    invite
+    assert_response :created
+    id = response.parsed_body.dig("invitation", "id")
+    token = latest_token
+    Invitation.find(id).update!(expires_at: 1.second.ago)
+    post "/api/v1/registrations", params: { user: { name: "Sam", email: "sam@example.test", password: PASSWORD } },
+      headers: api_headers(@account), as: :json
+    assert_response :created
+    accept(token)
+    assert_response :unprocessable_entity
+    assert_equal "customer", @account.users.find_by!(email: "sam@example.test").role
+  end
+
+  test "invitation lists paginate in ID order after status filtering" do
+    ids = 3.times.map do |i|
+      invite(email: "staff#{i}@example.test")
+      assert_response :created
+      response.parsed_body.dig("invitation", "id")
+    end
+    delete "/api/v1/invitations/#{ids.first}", headers: @headers
+    assert_response :no_content
+    get "/api/v1/invitations?status=pending&per_page=1&page=2", headers: @headers
+    assert_response :ok
+    assert_equal 2, response.parsed_body.fetch("count")
+    assert_equal [ids.last], response.parsed_body.fetch("invitations").map { |item| item.fetch("id") }
+    assert_equal 1, response.parsed_body.fetch("previous_page")
+    assert_nil response.parsed_body.fetch("next_page")
+    get "/api/v1/invitations?status=pending&per_page=1&page=3", headers: @headers
+    assert_equal [], response.parsed_body.fetch("invitations")
+    get "/api/v1/invitations?per_page=0", headers: @headers
+    assert_response :bad_request
+  end
+
+  test "invitation validation and malformed types are handled without sending email" do
+    ["customer", "owner", nil].each do |role|
+      assert_no_difference "ActionMailer::Base.deliveries.size" do
+        invite(role: role)
+      end
+      assert_response :unprocessable_entity
+    end
+    invite(email: "not-an-email")
+    assert_response :unprocessable_entity
+    [12, [], {}, true].each do |value|
+      invite(email: value)
+      assert_response :bad_request
+      invite(role: value)
+      assert_response :bad_request
+      preview(value)
+      assert_response :bad_request
+    end
+    get "/api/v1/invitations?status=nonsense", headers: @headers
+    assert_response :bad_request
+  end
+end
diff --git a/test/integration/team_management_test.rb b/test/integration/team_management_test.rb
new file mode 100644
index 0000000..8bd3dce
--- /dev/null
+++ b/test/integration/team_management_test.rb
@@ -0,0 +1,218 @@
+require "test_helper"
+
+class TeamManagementTest < ActionDispatch::IntegrationTest
+  setup do
+    @account, @owner = create_business
+    @agent = @account.users.create!(name: "Sam", email: "sam@example.test", password: PASSWORD, role: "agent", verified: true)
+    @customer = create_customer(@account)
+    @ticket = create_ticket(@account, @customer)
+    @headers = api_headers(@account, sign_in(@account))
+    @agent_headers = api_headers(@account, sign_in(@account, email: @agent.email))
+    @customer_headers = api_headers(@account, sign_in(@account, email: @customer.email))
+  end
+
+  def manage(user, data)
+    patch "/api/v1/users/#{user.id}", params: { user: data }, headers: @headers, as: :json
+  end
+
+  def update_ticket(data = nil, headers: @headers, **attributes)
+    patch "/api/v1/tickets/#{@ticket.id}", params: { ticket: data || attributes }, headers: headers, as: :json
+  end
+
+  test "admins list inspect edit users and filter by role and suspension" do
+    get "/api/v1/users", headers: @headers
+    assert_response :ok
+    assert_equal [@owner.id, @agent.id, @customer.id], response.parsed_body.fetch("users").map { |user| user.fetch("id") }
+    assert response.parsed_body.fetch("users").all? { |user| user.fetch("suspended") == false }
+    get "/api/v1/users/#{@agent.id}", headers: @headers
+    assert_response :ok
+    assert_equal @agent.id, response.parsed_body.dig("user", "id")
+    manage(@agent, name: "Sam Smith", suspended: true, role: "admin", account_id: -1)
+    assert_response :ok
+    assert_equal "Sam Smith", @agent.reload.name
+    assert_equal "agent", @agent.role
+    get "/api/v1/users?role=agent&suspended=true", headers: @headers
+    assert_response :ok
+    assert_equal [@agent.id], response.parsed_body.fetch("users").map { |user| user.fetch("id") }
+    get "/api/v1/users?suspended=false", headers: @headers
+    assert_equal [@owner.id, @customer.id], response.parsed_body.fetch("users").map { |user| user.fetch("id") }
+    get "/api/v1/me", headers: @headers
+    assert_response :ok
+    assert_equal false, response.parsed_body.dig("user", "suspended")
+  end
+
+  test "staff can assign and clear tickets only to active staff in their account" do
+    [@headers, @agent_headers].each do |headers|
+      get "/api/v1/staff", headers: headers
+      assert_response :ok
+      assert_equal [@owner.id, @agent.id], response.parsed_body.fetch("staff").map { |user| user.fetch("id") }
+      update_ticket({ assignee_id: @agent.id }, headers: headers)
+      assert_response :ok
+      assert_equal @agent.id, response.parsed_body.dig("ticket", "assignee_id")
+      assert_equal({ "id" => @agent.id, "name" => @agent.name }, response.parsed_body.dig("ticket", "assignee"))
+      update_ticket({ assignee_id: nil }, headers: headers)
+      assert_response :ok
+      assert_nil response.parsed_body.dig("ticket", "assignee")
+      assert_nil @ticket.reload.assignee_id
+    end
+    other, owner = create_business(subdomain: "other")
+    [@customer.id, owner.id, -1, 0, 2**100].each do |id|
+      update_ticket(assignee_id: id, status: "solved", comment: { body: "Do not save" })
+      assert_response :unprocessable_entity
+      assert_equal "open", @ticket.reload.status
+      assert_equal 1, @ticket.comments.count
+    end
+    manage(@agent, suspended: true)
+    update_ticket(assignee_id: @agent.id)
+    assert_response :unprocessable_entity
+    get "/api/v1/staff", headers: @headers
+    assert_equal [@owner.id], response.parsed_body.fetch("staff").map { |user| user.fetch("id") }
+  end
+
+  test "invalid notes roll back assignments status and both activity timestamps" do
+    original = @ticket.attributes.slice("assignee_id", "status", "updated_at", "customer_updated_at")
+    assert_no_difference "Comment.count" do
+      travel 1.minute do
+        update_ticket(assignee_id: @agent.id, status: "solved", comment: { body: " ", public: false })
+      end
+    end
+    assert_response :unprocessable_entity
+    assert_equal original, @ticket.reload.attributes.slice(*original.keys)
+  end
+
+  test "suspension revokes all sessions clears assignments and unsuspension does not restore sessions" do
+    second_token = sign_in(@account, email: @agent.email)
+    update_ticket(assignee_id: @agent.id)
+    assert_response :ok
+    manage(@agent, suspended: true)
+    assert_response :ok
+    assert_equal 0, @agent.sessions.count
+    assert_nil @ticket.reload.assignee_id
+    [@agent_headers, api_headers(@account, second_token)].each do |headers|
+      get "/api/v1/tickets", headers: headers
+      assert_response :unauthorized
+    end
+    post "/api/v1/sessions", params: { session: { email: @agent.email, password: PASSWORD } }, headers: api_headers(@account), as: :json
+    assert_response :forbidden
+    manage(@agent, suspended: false)
+    assert_response :ok
+    get "/api/v1/tickets", headers: @agent_headers
+    assert_response :unauthorized
+    sign_in(@account, email: @agent.email)
+  end
+
+  test "last active admin cannot be suspended and name change rolls back with it" do
+    manage(@owner, name: "Changed", suspended: true)
+    assert_response :unprocessable_entity
+    assert_equal "Jo", @owner.reload.name
+    assert_not @owner.suspended?
+    admin = @account.users.create!(name: "Other admin", email: "admin@example.test", password: PASSWORD, role: "admin", verified: true)
+    manage(admin, suspended: true)
+    assert_response :ok
+    manage(@owner, suspended: true)
+    assert_response :unprocessable_entity
+    manage(admin, suspended: false)
+    assert_response :ok
+    manage(@owner, suspended: true)
+    assert_response :ok
+    assert @owner.reload.suspended?
+  end
+
+  test "people management is admin only and tenant scoped while me stays self scoped" do
+    [@agent_headers, @customer_headers].each do |headers|
+      get "/api/v1/users", headers: headers
+      assert_response :forbidden
+      get "/api/v1/users/#{@owner.id}", headers: headers
+      assert_response :forbidden
+      patch "/api/v1/users/#{@owner.id}", params: { user: { suspended: true } }, headers: headers, as: :json
+      assert_response :forbidden
+      patch "/api/v1/me", params: { user: { name: "Self", suspended: true, role: "admin" } }, headers: headers, as: :json
+      assert_response :ok
+      assert_equal false, response.parsed_body.dig("user", "suspended")
+    end
+    get "/api/v1/staff", headers: @customer_headers
+    assert_response :forbidden
+    other, owner = create_business(subdomain: "other")
+    get "/api/v1/users/#{owner.id}", headers: @headers
+    assert_response :not_found
+    manage(owner, suspended: true)
+    assert_response :not_found
+  end
+
+  test "private notes assignments and suspension do not alter customer facing requests or ordering" do
+    get "/api/v1/requests/#{@ticket.id}", headers: @customer_headers
+    original = response.parsed_body
+    newer = nil
+    travel 1.minute do
+      newer = create_ticket(@account, @customer, subject: "Newer")
+    end
+    travel 2.minutes do
+      update_ticket(assignee_id: @agent.id, comment: { body: "Private billing note", public: false })
+      assert_response :ok
+      assert @ticket.reload.updated_at > newer.updated_at
+      get "/api/v1/requests/#{@ticket.id}", headers: @customer_headers
+      assert_equal original, response.parsed_body
+      get "/api/v1/requests", headers: @customer_headers
+      assert_equal [newer.id, @ticket.id], response.parsed_body.fetch("requests").map { |ticket| ticket.fetch("id") }
+      manage(@agent, suspended: true)
+      get "/api/v1/requests/#{@ticket.id}", headers: @customer_headers
+      assert_equal original, response.parsed_body
+      update_ticket(comment: { body: "Public reply", public: true })
+      assert_response :ok
+      get "/api/v1/requests", headers: @customer_headers
+      assert_equal [@ticket.id, newer.id], response.parsed_body.fetch("requests").map { |ticket| ticket.fetch("id") }
+    end
+  end
+
+  test "users and staff paginate in ID order and never include foreign business users" do
+    create_business(subdomain: "other")
+    get "/api/v1/users?per_page=1&page=2", headers: @headers
+    assert_response :ok
+    assert_equal 3, response.parsed_body.fetch("count")
+    assert_equal [@agent.id], response.parsed_body.fetch("users").map { |user| user.fetch("id") }
+    get "/api/v1/staff?per_page=1&page=2", headers: @agent_headers
+    assert_response :ok
+    assert_equal 2, response.parsed_body.fetch("count")
+    assert_equal [@agent.id], response.parsed_body.fetch("staff").map { |user| user.fetch("id") }
+    get "/api/v1/staff?page=0", headers: @headers
+    assert_response :bad_request
+  end
+
+  test "suspended users cannot use even a leftover session and cannot recover access via password reset" do
+    manage(@agent, suspended: true)
+    assert_response :ok
+    leftover = Session.issue!(@agent)
+    get "/api/v1/tickets", headers: api_headers(@account, leftover)
+    assert_response :forbidden
+    assert_equal "user_suspended", response.parsed_body.dig("error", "code")
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      request_link(@account, :password_reset, email: @agent.email)
+      request_link(@account, :verification, email: @agent.email)
+    end
+  end
+
+  test "customer suspension revokes access and active staff can still service their tickets" do
+    manage(@customer, suspended: true)
+    assert_response :ok
+    get "/api/v1/requests", headers: @customer_headers
+    assert_response :unauthorized
+    update_ticket({ status: "pending", comment: { body: "Working on it" } }, headers: @agent_headers)
+    assert_response :ok
+    assert_equal "pending", response.parsed_body.dig("ticket", "status")
+  end
+
+  test "strict boolean id and filter validation" do
+    [nil, "true", 1, [], {}].each do |value|
+      manage(@agent, suspended: value)
+      assert_response :bad_request
+    end
+    ["12", true, [], {}].each do |value|
+      update_ticket(assignee_id: value)
+      assert_response :bad_request
+    end
+    ["role=owner", "suspended=maybe", "role[]=admin", "suspended[]=true"].each do |filter|
+      get "/api/v1/users?#{filter}", headers: @headers
+      assert_response :bad_request
+    end
+  end
+end
diff --git a/test/integration/tenant_security_test.rb b/test/integration/tenant_security_test.rb
new file mode 100644
index 0000000..000637a
--- /dev/null
+++ b/test/integration/tenant_security_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class TenantSecurityTest < ActionDispatch::IntegrationTest
+  setup do
+    @account, @owner = create_business
+    @other_account, @other_owner = create_business(subdomain: "other")
+  end
+
+  test "same normalized email can be registered in different accounts" do
+    assert_equal @owner.email, @other_owner.email
+    duplicate = @account.users.build(name: "Duplicate", email: " JO@ACME.TEST ", password: PASSWORD)
+    assert_not duplicate.valid?
+    assert_includes duplicate.errors[:email], "has already been taken"
+    token = sign_in(@other_account, email: " JO@ACME.TEST ")
+    get "/api/v1/me", headers: api_headers(@other_account, token)
+    assert_response :ok
+    assert_equal @other_owner.id, response.parsed_body.dig("user", "id")
+  end
+
+  test "a session cannot be used with another business header" do
+    token = sign_in(@account)
+    get "/api/v1/me", headers: api_headers(@other_account, token)
+    assert_response :unauthorized
+    get "/api/v1/account", headers: api_headers(@other_account, token)
+    assert_response :unauthorized
+    delete "/api/v1/session", headers: api_headers(@other_account, token)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: api_headers(@account, token)
+    assert_response :ok
+  end
+
+  test "business selection is required and invalid businesses do not fall back" do
+    get "/api/v1/portal"
+    assert_response :bad_request
+    assert_equal "account_required", response.parsed_body.dig("error", "code")
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => "missing" }
+    assert_response :not_found
+    get "/api/v1/portal", headers: { "X-Helpdesk-Account" => " ACME " }
+    assert_response :ok
+  end
+
+  test "account and profile require bearer authentication" do
+    %w[account me].each do |endpoint|
+      get "/api/v1/#{endpoint}", headers: api_headers(@account)
+      assert_response :unauthorized
+      get "/api/v1/#{endpoint}", headers: api_headers(@account, "invalid")
+      assert_response :unauthorized
+    end
+    token = sign_in(@account)
+    get "/api/v1/me", headers: api_headers(@account).merge("Authorization" => "Basic #{token}")
+    assert_response :unauthorized
+  end
+
+  test "password and internal token digests are never serialized" do
+    token = sign_in(@account)
+    json = response.parsed_body
+    assert_equal @account.id, json.dig("account", "id")
+    assert_equal @owner.id, json.dig("user", "id")
+    assert_equal "admin", json.dig("user", "role")
+    assert_equal true, json.dig("user", "verified")
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_not_includes response.body, "digest"
+    assert_not_includes response.body, PASSWORD
+    assert_equal AuthenticationToken.digest(token), @owner.sessions.last.token_digest
+    assert_not_equal token, @owner.sessions.last.token_digest
+    get "/api/v1/me", headers: api_headers(@account, token)
+    assert_not_includes response.body, "digest"
+    get "/api/v1/account", headers: api_headers(@account, token)
+    assert_not_includes response.body, "digest"
+  end
+
+  test "profile update cannot change role verification email or account" do
+    token = sign_in(@account)
+    patch "/api/v1/me", params: { user: { name: "Jo Smith", role: "customer",
+      verified: false, email: "changed@example.test", account_id: @other_account.id } },
+      headers: api_headers(@account, token), as: :json
+    assert_response :ok
+    @owner.reload
+    assert_equal "Jo Smith", @owner.name
+    assert @owner.admin?
+    assert @owner.verified?
+    assert_equal "jo@acme.test", @owner.email
+    assert_equal @account.id, @owner.account_id
+  end
+
+  test "signout revokes only the presented session" do
+    token = sign_in(@account)
+    other_token = sign_in(@account)
+    delete "/api/v1/session", headers: api_headers(@account, token)
+    assert_response :no_content
+    get "/api/v1/me", headers: api_headers(@account, token)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: api_headers(@account, other_token)
+    assert_response :ok
+  end
+
+  test "expired sessions cannot authenticate" do
+    token = sign_in(@account)
+    @owner.sessions.update_all(expires_at: 1.second.ago)
+    get "/api/v1/me", headers: api_headers(@account, token)
+    assert_response :unauthorized
+  end
+
+  test "bad credentials do not create sessions" do
+    ["wrong-password", ""].each do |password|
+      assert_no_difference "Session.count" do
+        post "/api/v1/sessions", params: { session: { email: @owner.email, password: password } },
+          headers: api_headers(@account), as: :json
+      end
+      assert_response :unauthorized
+    end
+    post "/api/v1/sessions", params: { session: { email: "nobody@acme.test", password: PASSWORD } },
+      headers: api_headers(@account), as: :json
+    assert_response :unauthorized
+  end
+end
diff --git a/test/integration/ticket_groups_test.rb b/test/integration/ticket_groups_test.rb
new file mode 100644
index 0000000..91f3eb0
--- /dev/null
+++ b/test/integration/ticket_groups_test.rb
@@ -0,0 +1,226 @@
+require "test_helper"
+
+class TicketGroupsTest < ActionDispatch::IntegrationTest
+  setup do
+    @account, @admin = create_business
+    @agent = @account.users.create!(name: "Sam", email: "sam@example.test", password: PASSWORD,
+      role: "agent", verified: true)
+    @other_agent = @account.users.create!(name: "Pat", email: "pat@example.test", password: PASSWORD,
+      role: "agent", verified: true)
+    @customer = create_customer(@account)
+    @billing = @account.groups.create!(name: "Billing")
+    @technical = @account.groups.create!(name: "Technical Support")
+    @billing_membership = @account.group_memberships.create!(group: @billing, user: @agent)
+    @technical_membership = @account.group_memberships.create!(group: @technical, user: @agent)
+    @account.group_memberships.create!(group: @technical, user: @other_agent)
+    @ticket = create_ticket(@account, @customer)
+    @headers = api_headers(@account, Session.issue!(@agent))
+    @admin_headers = api_headers(@account, Session.issue!(@admin))
+    @customer_headers = api_headers(@account, Session.issue!(@customer))
+  end
+
+  def update_routing(data)
+    patch "/api/v1/tickets/#{@ticket.id}", params: { ticket: data }, headers: @headers, as: :json
+  end
+
+  test "tickets serialize groups and use the assignee default when ungrouped" do
+    get "/api/v1/tickets/#{@ticket.id}", headers: @headers
+    assert_nil response.parsed_body.dig("ticket", "group_id")
+    assert_nil response.parsed_body.dig("ticket", "group")
+    update_routing(assignee_id: @agent.id)
+    assert_response :ok
+    assert_equal @billing.id, @ticket.reload.group_id
+    assert_equal @agent.id, @ticket.assignee_id
+    assert_equal({ "id" => @billing.id, "name" => "Billing" }, response.parsed_body.dig("ticket", "group"))
+    @technical_membership.make_default!
+    update_routing(group_id: nil)
+    update_routing(assignee_id: @agent.id)
+    assert_response :ok
+    assert_equal @technical.id, @ticket.reload.group_id
+    update_routing(group_id: nil)
+    update_routing(assignee_id: @admin.id)
+    assert_response :ok
+    assert_nil @ticket.reload.group_id
+    assert_equal @admin.id, @ticket.assignee_id
+  end
+
+  test "moving groups clears only incompatible retained assignees" do
+    update_routing(assignee_id: @agent.id)
+    update_routing(group_id: @technical.id)
+    assert_response :ok
+    assert_equal @agent.id, @ticket.reload.assignee_id
+    update_routing(assignee_id: @other_agent.id)
+    assert_response :ok
+    update_routing(group_id: @billing.id)
+    assert_response :ok
+    assert_nil @ticket.reload.assignee_id
+    assert_equal @billing.id, @ticket.group_id
+    update_routing(group_id: @technical.id, assignee_id: @other_agent.id)
+    assert_response :ok
+    assert_equal @other_agent.id, @ticket.reload.assignee_id
+    assert_equal @technical.id, @ticket.group_id
+    update_routing(group_id: @billing.id, assignee_id: @other_agent.id)
+    assert_response :unprocessable_entity
+    assert_equal @technical.id, @ticket.reload.group_id
+    assert_equal @other_agent.id, @ticket.assignee_id
+  end
+
+  test "an assignee must belong to the group and failed updates roll back comments and other fields" do
+    update_routing(group_id: @billing.id)
+    initial_comments = @ticket.comments.count
+    update_routing(assignee_id: @other_agent.id, priority: "high", status: "solved", comment: { body: "Must roll back" })
+    assert_response :unprocessable_entity
+    assert_equal "validation_failed", response.parsed_body.dig("error", "code")
+    assert_nil @ticket.reload.assignee_id
+    assert_equal "normal", @ticket.priority
+    assert_equal "open", @ticket.status
+    assert_equal initial_comments, @ticket.comments.count
+    update_routing(assignee_id: @admin.id)
+    assert_response :unprocessable_entity
+    update_routing(assignee_id: @customer.id)
+    assert_response :unprocessable_entity
+  end
+
+  test "clearing assignee retains the group and an explicit null group always clears assignee" do
+    update_routing(assignee_id: @agent.id)
+    update_routing(assignee_id: nil)
+    assert_response :ok
+    assert_equal @billing.id, @ticket.reload.group_id
+    assert_nil @ticket.assignee_id
+    update_routing(assignee_id: @agent.id)
+    update_routing(group_id: nil, assignee_id: @agent.id)
+    assert_response :ok
+    assert_nil @ticket.reload.group_id
+    assert_nil @ticket.assignee_id
+    update_routing(group_id: nil, assignee_id: @agent.id)
+    assert_response :ok
+    assert_nil @ticket.reload.group_id
+    assert_nil @ticket.assignee_id
+    update_routing(group_id: @technical.id, assignee_id: nil)
+    assert_response :ok
+    assert_equal @technical.id, @ticket.reload.group_id
+    assert_nil @ticket.assignee_id
+  end
+
+  test "staff filter the full inbox by group including groups they do not belong to" do
+    grouped = create_ticket(@account, @customer, subject: "Billing work")
+    grouped.update!(group: @billing, assignee: @agent)
+    technical = create_ticket(@account, @customer, subject: "Technical work")
+    technical.update!(group: @technical)
+    other, = create_business(subdomain: "other")
+    other_customer = create_customer(other)
+    other_group = other.groups.create!(name: "Foreign")
+    create_ticket(other, other_customer).update!(group: other_group)
+    headers = api_headers(@account, Session.issue!(@admin)) # No memberships at all.
+    { @billing.id => [grouped.id], @technical.id => [technical.id], "unassigned" => [@ticket.id], other_group.id => [] }.each do |group_id, ids|
+      get "/api/v1/tickets", params: { group_id: group_id }, headers: headers
+      assert_response :ok
+      assert_equal ids, response.parsed_body.fetch("tickets").map { |ticket| ticket.fetch("id") }
+      assert_equal ids.size, response.parsed_body.fetch("count")
+    end
+    get "/api/v1/tickets/#{grouped.id}", headers: headers
+    assert_response :ok
+    get "/api/v1/tickets", params: { group_id: @technical.id, assignee_id: "unassigned", priority: "normal",
+      status: "open", requester_id: @customer.id, q: "technical", per_page: 1 }, headers: headers
+    assert_equal [technical.id], response.parsed_body.fetch("tickets").map { |ticket| ticket.fetch("id") }
+    assert_equal 1, response.parsed_body.fetch("count")
+    get "/api/v1/tickets", headers: headers
+    assert_equal 3, response.parsed_body.fetch("count")
+    patch "/api/v1/groups/#{@billing.id}", params: { group: { name: "Accounts" } }, headers: @admin_headers, as: :json
+    get "/api/v1/tickets/#{grouped.id}", headers: headers
+    assert_equal "Accounts", response.parsed_body.dig("ticket", "group", "name")
+  end
+
+  test "invalid group filter and mutation shapes return bad requests and cross-account groups fail validation" do
+    ["", "0", "-1", "1.5", "1x", "all", " 1 ", [1], { id: 1 }].each do |value|
+      get "/api/v1/tickets", params: { group_id: value }, headers: @headers
+      assert_response :bad_request
+      assert_equal "invalid_request", response.parsed_body.dig("error", "code")
+    end
+    ["1", false, 1.5, [1], { id: 1 }].each do |value|
+      update_routing(group_id: value, status: "open")
+      assert_response :bad_request
+    end
+    other, = create_business(subdomain: "other")
+    foreign = other.groups.create!(name: "Foreign")
+    [foreign.id, 0, -1].each do |value|
+      update_routing(group_id: value)
+      assert_response :unprocessable_entity
+      assert_nil @ticket.reload.group_id
+    end
+  end
+
+  test "membership removal clears only affected assignments and chooses a new default" do
+    update_routing(assignee_id: @agent.id)
+    technical = create_ticket(@account, @customer)
+    technical.update!(group: @technical, assignee: @agent)
+    untouched = create_ticket(@account, @customer)
+    untouched.update!(group: @technical, assignee: @other_agent)
+    customer_activity = @ticket.customer_updated_at
+    original_activity = @ticket.updated_at
+    travel 1.minute do
+      delete "/api/v1/group_memberships/#{@billing_membership.id}", headers: @admin_headers
+      assert_response :no_content
+      assert_nil @ticket.reload.assignee_id
+      assert_equal @billing.id, @ticket.group_id
+      assert_equal customer_activity, @ticket.customer_updated_at
+      assert @ticket.updated_at > original_activity
+      assert_equal @agent.id, technical.reload.assignee_id
+      assert_equal @other_agent.id, untouched.reload.assignee_id
+      assert @technical_membership.reload.default?
+    end
+  end
+
+  test "group removal clears its tickets and memberships without disturbing other groups" do
+    update_routing(assignee_id: @agent.id)
+    technical = create_ticket(@account, @customer)
+    technical.update!(group: @technical, assignee: @agent)
+    customer_activity = @ticket.customer_updated_at
+    delete "/api/v1/groups/#{@billing.id}", headers: @admin_headers
+    assert_response :no_content
+    assert_nil @ticket.reload.group_id
+    assert_nil @ticket.assignee_id
+    assert_equal customer_activity, @ticket.customer_updated_at
+    assert_not GroupMembership.exists?(@billing_membership.id)
+    assert @technical_membership.reload.default?
+    assert_equal @agent.id, technical.reload.assignee_id
+    assert_equal @technical.id, technical.group_id
+  end
+
+  test "suspension retains memberships and group while clearing assignee and resumption reuses the default" do
+    update_routing(assignee_id: @agent.id)
+    patch "/api/v1/users/#{@agent.id}", params: { user: { suspended: true } }, headers: @admin_headers, as: :json
+    assert_response :ok
+    assert_equal 2, @agent.group_memberships.count
+    assert @billing_membership.reload.default?
+    assert_nil @ticket.reload.assignee_id
+    assert_equal @billing.id, @ticket.group_id
+    patch "/api/v1/tickets/#{@ticket.id}", params: { ticket: { assignee_id: @agent.id } }, headers: @admin_headers, as: :json
+    assert_response :unprocessable_entity
+    patch "/api/v1/users/#{@agent.id}", params: { user: { suspended: false } }, headers: @admin_headers, as: :json
+    assert_response :ok
+    patch "/api/v1/tickets/#{@ticket.id}", params: { ticket: { assignee_id: @agent.id } }, headers: @admin_headers, as: :json
+    assert_response :ok
+    assert_equal @billing.id, @ticket.reload.group_id
+    assert_equal @agent.id, @ticket.assignee_id
+  end
+
+  test "customers cannot set or see routing fields and routing changes do not advance customer activity" do
+    before_activity = @ticket.customer_updated_at
+    travel 1.minute do
+      update_routing(group_id: @billing.id, assignee_id: @agent.id)
+      assert_response :ok
+      assert_equal before_activity, @ticket.reload.customer_updated_at
+      patch "/api/v1/requests/#{@ticket.id}", params: { request: { group_id: @technical.id, assignee_id: @other_agent.id,
+        status: "open" } }, headers: @customer_headers, as: :json
+      assert_response :ok
+      assert_equal @billing.id, @ticket.reload.group_id
+      assert_equal @agent.id, @ticket.assignee_id
+      get "/api/v1/requests", params: { group_id: "unassigned" }, headers: @customer_headers
+      assert_response :ok
+      record = response.parsed_body.fetch("requests").first
+      assert_equal @ticket.id, record.fetch("id")
+      %w[group_id group assignee_id assignee].each { |key| assert_not record.key?(key) }
+    end
+  end
+end
diff --git a/test/integration/ticket_merges_test.rb b/test/integration/ticket_merges_test.rb
new file mode 100644
index 0000000..d0f878d
--- /dev/null
+++ b/test/integration/ticket_merges_test.rb
@@ -0,0 +1,329 @@
+require "test_helper"
+
+class TicketMergesTest < ActionDispatch::IntegrationTest
+  setup do
+    @account, @owner = create_business
+    @customer = create_customer(@account)
+    @source = create_ticket(@account, @customer, subject: "Duplicate", status: "pending")
+    @target = create_ticket(@account, @customer, subject: "Original", status: "solved")
+    @staff_headers = api_headers(@account, sign_in(@account))
+    @customer_headers = api_headers(@account, sign_in(@account, email: @customer.email))
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "merge closes the source and preserves both conversations" do
+    source_comments = @source.comments.pluck(:id)
+    target_comments = @target.comments.pluck(:id)
+    assert_difference "Comment.count", 2 do
+      merge_tickets
+    end
+    assert_response :ok
+    source = response.parsed_body.fetch("source")
+    target = response.parsed_body.fetch("target")
+    assert_equal @source.id, source.fetch("id")
+    assert_equal "closed", source.fetch("status")
+    assert_equal @target.id, source.fetch("merged_into_id")
+    assert_equal @target.id, target.fetch("id")
+    assert_equal "solved", target.fetch("status")
+    assert_nil target.fetch("merged_into_id")
+    assert_equal source_comments, @source.comments.where.not(id: @source.comments.last.id).pluck(:id)
+    assert_equal target_comments, @target.comments.where.not(id: @target.comments.last.id).pluck(:id)
+    [@source, @target].each do |ticket|
+      note = ticket.comments.last
+      assert_not note.public?
+      assert_equal @owner.id, note.author_id
+    end
+    assert_includes @source.comments.last.body, @target.id.to_s
+    assert_includes @target.comments.last.body, @source.id.to_s
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "custom notes have independent visibility and never email even on email tickets" do
+    @source.update!(origin: "email", priority: "high", assignee: @owner)
+    @target.update!(origin: "email", assignee: @owner)
+    identities = [@source, @target].map do |ticket|
+      ticket.attributes.slice("subject", "requester_id", "assignee_id", "group_id", "priority", "origin", "email_reply_token")
+    end
+    target_customer_activity = @target.customer_updated_at
+    travel 1.minute do
+      assert_no_difference "ActionMailer::Base.deliveries.size" do
+        merge_tickets(source_comment: { body: "Continuing in the original.", public: true, author_id: @customer.id },
+          target_comment: { body: "Duplicate checked.", public: false, merge_note: false })
+        assert_response :ok
+      end
+    end
+    [@source, @target].each_with_index do |ticket, index|
+      assert_equal identities[index], ticket.reload.attributes.slice(*identities[index].keys)
+      assert ticket.comments.last.merge_note?
+      assert_equal @owner.id, ticket.comments.last.author_id
+    end
+    assert_equal "solved", @target.status
+    assert_equal target_customer_activity, @target.customer_updated_at
+    assert_equal "Continuing in the original.", @source.comments.last.body
+    assert @source.comments.last.public?
+    assert_equal "Duplicate checked.", @target.comments.last.body
+    assert_not @target.comments.last.public?
+    get "/api/v1/requests/#{@source.id}/comments", headers: @customer_headers
+    assert_response :ok
+    assert_equal 2, response.parsed_body.fetch("count")
+    assert_equal "Continuing in the original.", response.parsed_body.fetch("comments").last.fetch("body")
+    get "/api/v1/requests/#{@target.id}/comments", headers: @customer_headers
+    assert_response :ok
+    assert_equal 1, response.parsed_body.fetch("count")
+
+    # Suppression is specific to the merge notes, not the whole conversation.
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      patch "/api/v1/tickets/#{@target.id}", params: { ticket: { comment: { body: "Normal reply" } } },
+        headers: @staff_headers, as: :json
+      assert_response :ok
+    end
+  end
+
+  test "either note can use default text or be public independently" do
+    merge_tickets(source_comment: {}, target_comment: { public: true })
+    assert_response :ok
+    assert_not @source.comments.last.public?
+    assert @target.comments.last.public?
+    assert_includes @target.comments.last.body, @source.id.to_s
+    get "/api/v1/requests/#{@source.id}/comments", headers: @customer_headers
+    assert_response :ok
+    assert_equal 1, response.parsed_body.fetch("count")
+    get "/api/v1/requests/#{@target.id}/comments", headers: @customer_headers
+    assert_response :ok
+    assert_equal 2, response.parsed_body.fetch("count")
+  end
+
+  test "both views expose null pointers before a merge and closed records remain readable and filterable" do
+    [["tickets", "ticket", @staff_headers], ["requests", "request", @customer_headers]].each do |plural, singular, headers|
+      get "/api/v1/#{plural}/#{@source.id}", headers: headers
+      assert_response :ok
+      assert_nil response.parsed_body.fetch(singular).fetch("merged_into_id")
+    end
+    merge_tickets
+    assert_response :ok
+    [["tickets", "ticket", @staff_headers], ["requests", "request", @customer_headers]].each do |plural, singular, headers|
+      get "/api/v1/#{plural}/#{@source.id}", headers: headers
+      assert_response :ok
+      record = response.parsed_body.fetch(singular)
+      assert_equal "closed", record.fetch("status")
+      assert_equal @target.id, record.fetch("merged_into_id")
+      get "/api/v1/#{plural}", params: { status: "closed" }, headers: headers
+      assert_response :ok
+      assert_equal 1, response.parsed_body.fetch("count")
+      assert_equal [@source.id], response.parsed_body.fetch(plural).map { |ticket| ticket.fetch("id") }
+      get "/api/v1/#{plural}/#{@source.id}/comments", headers: headers
+      assert_response :ok
+      assert_equal plural == "tickets" ? 2 : 1, response.parsed_body.fetch("count")
+    end
+    other_customer = create_customer(@account, email: "other@example.test")
+    other_headers = api_headers(@account, sign_in(@account, email: other_customer.email))
+    get "/api/v1/requests", params: { status: "closed" }, headers: other_headers
+    assert_response :ok
+    assert_equal 0, response.parsed_body.fetch("count")
+    get "/api/v1/requests/#{@source.id}", headers: other_headers
+    assert_response :not_found
+  end
+
+  test "closed sources reject all staff and customer updates including routing and reopening" do
+    merge_tickets
+    assert_response :ok
+    snapshot = @source.reload.attributes
+    [{ status: "open" }, { status: "solved" }, { comment: { body: "Reply" } },
+      { comment: { body: "Private edit", public: false } }, { assignee_id: @owner.id },
+      { assignee_id: nil }, { group_id: nil }, { priority: "high" }].each do |data|
+      assert_no_difference ["Comment.count", "ActionMailer::Base.deliveries.size"] do
+        patch "/api/v1/tickets/#{@source.id}", params: { ticket: data }, headers: @staff_headers, as: :json
+      end
+      assert_response :unprocessable_entity
+      assert_equal "ticket_closed", response.parsed_body.dig("error", "code")
+      assert_equal snapshot, @source.reload.attributes
+    end
+    [{ status: "open" }, { status: "solved" }, { comment: { body: "Reply" } }].each do |data|
+      assert_no_difference "Comment.count" do
+        patch "/api/v1/requests/#{@source.id}", params: { request: data }, headers: @customer_headers, as: :json
+      end
+      assert_response :unprocessable_entity
+      assert_equal snapshot, @source.reload.attributes
+    end
+  end
+
+  test "only staff in the active account can merge and agents can merge" do
+    assert_unchanged_merge do
+      merge_tickets({}, headers: @customer_headers)
+      assert_response :forbidden
+      merge_tickets({}, headers: api_headers(@account))
+      assert_response :unauthorized
+    end
+    agent = @account.users.create!(name: "Agent", email: "agent@example.test", password: PASSWORD,
+      role: "agent", verified: true)
+    agent_headers = api_headers(@account, sign_in(@account, email: agent.email))
+    @account.update!(cancelled_at: Time.current)
+    assert_unchanged_merge do
+      merge_tickets
+      assert_response :forbidden
+      assert_equal "account_cancelled", response.parsed_body.dig("error", "code")
+    end
+    @account.update!(cancelled_at: nil)
+    # A suspended staff member's existing session cannot be reused.
+    agent.update!(suspended: true)
+    assert_unchanged_merge do
+      merge_tickets({}, headers: agent_headers)
+      assert_response :unauthorized
+    end
+    agent.update!(suspended: false)
+    agent_headers = api_headers(@account, sign_in(@account, email: agent.email))
+    merge_tickets({}, headers: agent_headers)
+    assert_response :ok
+    assert_equal agent.id, @source.comments.last.author_id
+  end
+
+  test "self merges other customers missing records and other tenants are rejected atomically" do
+    other_customer = create_customer(@account, email: "other@example.test")
+    other_ticket = create_ticket(@account, other_customer)
+    other_account, = create_business(subdomain: "other")
+    foreign_ticket = create_ticket(other_account, create_customer(other_account))
+    [[@source.id, :unprocessable_entity], [other_ticket.id, :unprocessable_entity],
+      [foreign_ticket.id, :not_found], [Ticket.maximum(:id) + 100, :not_found]].each do |target_id, status|
+      assert_unchanged_merge do
+        merge_tickets(target_id: target_id)
+        assert_response status
+      end
+    end
+    assert_unchanged_merge do
+      merge_tickets({}, source: foreign_ticket)
+      assert_response :not_found
+    end
+  end
+
+  test "closed sources and targets cannot be merged and merge chains keep the original links" do
+    merge_tickets
+    assert_response :ok
+    source_notes = @source.comments.pluck(:id)
+    third = create_ticket(@account, @customer, status: "pending")
+    merge_tickets({ target_id: third.id }, source: @target)
+    assert_response :ok
+    assert_equal @target.id, @source.reload.merged_into_id
+    assert_equal third.id, @target.reload.merged_into_id
+    assert_equal "closed", @target.status
+    assert_equal "pending", third.reload.status
+    assert_nil third.merged_into_id
+    assert_equal source_notes, @source.comments.pluck(:id)
+    assert_unchanged_merge do
+      merge_tickets(target_id: third.id)
+      assert_response :unprocessable_entity
+      merge_tickets({ target_id: @source.id }, source: third)
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "malformed merge envelopes IDs and comment types return JSON errors without changing records" do
+    invalid_envelopes = [{}, { merge: nil }, { merge: [] }, { merge: "bad" }, { merge: {} }]
+    [nil, true, false, "57", 1.5, [], {}, 0, -1].each do |target_id|
+      invalid_envelopes << { merge: { target_id: target_id } }
+    end
+    invalid_envelopes.each do |payload|
+      assert_unchanged_merge do
+        post "/api/v1/tickets/#{@source.id}/merge", params: payload, headers: @staff_headers, as: :json
+        assert_response :bad_request
+        assert_equal "invalid_request", response.parsed_body.dig("error", "code")
+      end
+    end
+    [:source_comment, :target_comment].each do |name|
+      [nil, [], "text", 1, true, { body: [] }, { body: {} }, { body: 1 }, { body: false },
+        { body: "Note", public: nil }, { public: "true" }, { public: 0 }, { public: [] }, { public: {} }].each do |note|
+        assert_unchanged_merge do
+          merge_tickets(name => note)
+          assert_response :bad_request
+          assert_equal "invalid_request", response.parsed_body.dig("error", "code")
+        end
+      end
+    end
+  end
+
+  test "blank notes roll back comments statuses pointers activity and email on both sides" do
+    @source.update!(origin: "email")
+    @target.update!(origin: "email")
+    [:source_comment, :target_comment].each do |name|
+      [nil, "", " \n\t"].each do |body|
+        assert_unchanged_merge do
+          travel 1.minute do
+            merge_tickets({ source_comment: { body: "Visible note", public: true },
+              target_comment: { body: "Visible note", public: true } }.merge(name => { body: body, public: true }))
+          end
+          assert_response :unprocessable_entity
+          assert_equal "validation_failed", response.parsed_body.dig("error", "code")
+        end
+      end
+    end
+  end
+
+  test "closed tickets still receive suspension membership removal and group deletion cleanup" do
+    agent = @account.users.create!(name: "Agent", email: "agent@example.test", password: PASSWORD,
+      role: "agent", verified: true)
+    group = @account.groups.create!(name: "Support")
+    membership = @account.group_memberships.create!(group: group, user: agent)
+    @source.update!(group: group, assignee: agent)
+    merge_tickets
+    assert_response :ok
+    assert_equal agent.id, @source.reload.assignee_id
+    customer_activity = @source.customer_updated_at
+    travel 1.minute do
+      membership.destroy!
+    end
+    assert_nil @source.reload.assignee_id
+    assert_equal group.id, @source.group_id
+    assert_equal customer_activity, @source.customer_updated_at
+    assert_equal @target.id, @source.merged_into_id
+
+    # Use separate closed records to exercise the other cleanup paths.
+    @account.group_memberships.create!(group: group, user: agent)
+    suspended_source = create_ticket(@account, @customer)
+    suspended_source.update!(group: group, assignee: agent)
+    merge_tickets({}, source: suspended_source)
+    assert_response :ok
+    agent.update!(suspended: true)
+    assert_nil suspended_source.reload.assignee_id
+    assert_equal "closed", suspended_source.status
+    assert_equal @target.id, suspended_source.merged_into_id
+
+    agent.update!(suspended: false)
+    grouped_source = create_ticket(@account, @customer)
+    grouped_source.update!(group: group, assignee: agent)
+    merge_tickets({}, source: grouped_source)
+    assert_response :ok
+    group.destroy!
+    assert_nil grouped_source.reload.assignee_id
+    assert_nil grouped_source.group_id
+    assert_equal "closed", grouped_source.status
+    assert_equal @target.id, grouped_source.merged_into_id
+  end
+
+  test "staff cannot manually close a ticket or set a merge pointer with ordinary updates" do
+    assert_unchanged_merge do
+      patch "/api/v1/tickets/#{@source.id}", params: { ticket: { status: "closed", merged_into_id: @target.id } },
+        headers: @staff_headers, as: :json
+      assert_response :unprocessable_entity
+    end
+    patch "/api/v1/tickets/#{@source.id}", params: { ticket: { status: "pending", merged_into_id: @target.id } },
+      headers: @staff_headers, as: :json
+    assert_response :ok
+    assert_nil @source.reload.merged_into_id
+  end
+
+  private
+
+  def assert_unchanged_merge
+    snapshots = [@source, @target].map { |ticket| ticket.reload.attributes }
+    assert_no_difference ["Ticket.count", "Comment.count", "EmailDelivery.count", "ActionMailer::Base.deliveries.size"] do
+      yield
+    end
+    [@source, @target].each_with_index do |ticket, index|
+      assert_equal snapshots[index], ticket.reload.attributes
+    end
+  end
+
+  def merge_tickets(data = {}, headers: @staff_headers, source: @source, **fields)
+    post "/api/v1/tickets/#{source.id}/merge", params: { merge: { target_id: @target.id }.merge(data).merge(fields) },
+      headers: headers, as: :json
+  end
+end
