+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,72 @@
+module Api
+  module V1
+    class UsersController < BaseController
+      include Pagination
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_admin!, only: [:index, :show, :update]
+
+      def index
+        scope = @account.users.order(:id)
+        if params.key?(:role)
+          unless User.roles.key?(params[:role])
+            raise ApiError.new("invalid_request", "role must be admin, agent or customer.", :bad_request)
+          end
+          scope = scope.where(role: params[:role])
+        end
+        if params.key?(:suspended)
+          unless ["true", "false"].include?(params[:suspended])
+            raise ApiError.new("invalid_request", "suspended must be true or false.", :bad_request)
+          end
+          scope = scope.where(suspended: params[:suspended] == "true")
+        end
+        render_collection(scope, key: :users) { |user| user.api_attributes }
+      end
+
+      def show
+        render json: { user: @account.users.find(params[:id]).api_attributes }
+      end
+
+      def update
+        data = params.expect(user: [:name, :suspended])
+        ensure_strings!(params[:user], :name)
+        if params[:user].key?(:suspended) && ![true, false].include?(params[:user][:suspended])
+          raise ApiError.new("invalid_request", "suspended must be a JSON boolean.", :bad_request)
+        end
+        user = nil
+        @account.with_lock do
+          require_active_account!
+          user = @account.users.find(params[:id])
+          user.update!(data)
+        end
+        render json: { user: user.api_attributes }
+      end
+
+      def me
+        render json: { user: @user.api_attributes }
+      end
+
+      def update_me
+        data = params.expect(user: [:name])
+        ensure_strings!(params[:user], :name)
+        @account.with_lock do
+          require_active_account!
+          @user.update!(data)
+        end
+        render json: { user: @user.api_attributes }
+      end
+
+      def password
+        data = params.expect(password_change: [:current_password, :password])
+        ensure_strings!(data, :current_password, :password)
+        @account.with_lock do
+          require_active_account!
+          unless @user.change_password!(data[:current_password], data[:password])
+            raise ApiError.new("invalid_password", "Current password is incorrect.", :unprocessable_entity)
+          end
+        end
+        render json: { user: @user.api_attributes }
+      end
+    end
+  end
+end
