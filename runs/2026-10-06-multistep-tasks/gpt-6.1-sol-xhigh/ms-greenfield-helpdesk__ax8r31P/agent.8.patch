+    invitations = 3.times.map { |i| Invitation.issue!(@account, email: "invite#{i}@example.test", role: "agent").first }
+    revoked = Invitation.issue!(@account, email: "revoked@example.test", role: "agent").first
+    revoked.revoke!
+    cases = [
+      ["users", { role: "agent", suspended: "false" }, agents.map(&:id)],
+      ["invitations", { status: "pending" }, invitations.map(&:id)],
+      ["group_memberships", { group_id: group.id }, memberships.map(&:id)]
+    ]
+    cases.each do |key, filters, expected|
+      first = cursor_get("/api/v1/#{key}", **filters, page: { size: 2 })
+      second = cursor_get(first.dig("links", "next"))
+      assert_equal expected, ids(first, key) + ids(second, key)
+      assert_nil second.dig("links", "next")
+      assert_equal ids(first, key), ids(cursor_get(second.dig("links", "prev")), key)
+      get "/api/v1/#{key}", params: { page: { after: first.dig("meta", "after_cursor") } }, headers: @staff_headers
+      assert_response :bad_request
+    end
