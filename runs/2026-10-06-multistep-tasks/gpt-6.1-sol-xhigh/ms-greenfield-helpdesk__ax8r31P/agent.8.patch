+class AddCursorSnapshotIndexes < ActiveRecord::Migration[8.1]
+  disable_ddl_transaction!
+
+  def change
+    # Efficient initial ID-watermark lookups, including customer-scoped requests
+    # and individual comment conversations. Subsequent pages reuse the watermark.
+    add_index :tickets, [:account_id, :id], algorithm: :concurrently
+    add_index :tickets, [:account_id, :requester_id, :id],
+      name: "index_tickets_on_requester_cursor_snapshot", algorithm: :concurrently
+    add_index :comments, [:ticket_id, :id], algorithm: :concurrently
+  end
+end
