+  # Build without blocking writes on businesses with long histories.
+  disable_ddl_transaction!
+
+  def change
+    %i[users invitations groups group_memberships].each do |table|
+      add_index table, [:account_id, :id], algorithm: :concurrently
+    end
+    add_index :comments, [:ticket_id, :created_at, :id],
+      name: "index_public_comments_on_ticket_chronology", where: "public = true", algorithm: :concurrently
+  end
+end
