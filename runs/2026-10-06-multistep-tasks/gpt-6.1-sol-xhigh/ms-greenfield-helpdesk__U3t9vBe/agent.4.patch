diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
index aeaaac2..f352a73 100644
--- a/app/controllers/api/v1/tickets_controller.rb
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -5,6 +5,37 @@ module Api
 
       private
 
+      def filtered_scope
+        scope = super
+        if params.key?(:priority)
+          unless Ticket.priorities.key?(params[:priority])
+            raise ApiError.new("invalid_request", "priority is invalid.", :bad_request)
+          end
+          scope = scope.where(priority: params[:priority])
+        end
+        if params.key?(:assignee_id)
+          assignee_id = params[:assignee_id] == "unassigned" ? nil : person_filter_id!(:assignee_id)
+          scope = scope.where(assignee_id: assignee_id)
+        end
+        scope = scope.where(requester_id: person_filter_id!(:requester_id)) if params.key?(:requester_id)
+        if params.key?(:q)
+          unless params[:q].is_a?(String)
+            raise ApiError.new("invalid_request", "q must be a string.", :bad_request)
+          end
+          scope = scope.matching_public_text(params[:q]) unless params[:q].empty?
+        end
+        scope
+      end
+
+      def person_filter_id!(key)
+        value = params[key]
+        unless (value.is_a?(String) || value.is_a?(Integer)) && value.to_s.match?(/\A[1-9][0-9]*\z/) &&
+            value.to_s.length <= 19 && value.to_i <= 9_223_372_036_854_775_807
+          raise ApiError.new("invalid_request", "#{key} must be a positive integer.", :bad_request)
+        end
+        value.to_i
+      end
+
       def resource_name
         :ticket
       end
