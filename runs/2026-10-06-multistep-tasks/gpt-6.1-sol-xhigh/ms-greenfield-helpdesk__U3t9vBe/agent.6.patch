@@ -0,0 +1,57 @@
+module Api
+  module V1
+    class GroupsController < BaseController
+      include Pagination
+      before_action :require_staff!
+      before_action :require_admin!, only: [ :create, :update, :destroy ]
+
+      def index
+        render json: paginated_response(current_account.groups.order(id: :asc), :groups, &:public_attributes)
+      end
+
+      def show
+        render json: { group: current_account.groups.find(params[:id]).public_attributes }
+      end
+
+      def create
+        attributes = group_attributes!
+        group = nil
+        current_account.with_lock do
+          require_active_account!
+          require_admin!
+          group = current_account.groups.create!(attributes)
+        end
+        render json: { group: group.public_attributes }, status: :created
+      end
+
+      def update
+        attributes = group_attributes!
+        group = nil
+        current_account.with_lock do
+          require_active_account!
+          require_admin!
+          group = current_account.groups.lock.find(params[:id])
+          group.update!(attributes)
+        end
+        render json: { group: group.public_attributes }
+      end
+
+      def destroy
+        current_account.with_lock do
+          require_active_account!
+          require_admin!
+          current_account.groups.lock.find(params[:id]).destroy!
+        end
+        head :no_content
+      end
+
+      private
+
+      def group_attributes!
+        attributes = params.expect(group: [ :name ])
+        string_attributes!(params[:group], :name)
+        attributes
+      end
+    end
+  end
+end
