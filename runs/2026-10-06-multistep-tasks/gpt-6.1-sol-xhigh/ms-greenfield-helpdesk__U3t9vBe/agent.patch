+    @other_customer = @account.users.create!(name: "Other requester", email: "second@example.test", password: PASSWORD,
+      role: :customer, verified_at: Time.current)
+    @agent = @account.users.create!(name: "Agent", email: "agent@example.test", password: PASSWORD,
+      role: :agent, verified_at: Time.current)
