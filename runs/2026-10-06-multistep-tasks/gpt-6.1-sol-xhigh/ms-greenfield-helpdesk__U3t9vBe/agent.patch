+    assert_response :unprocessable_content
+    post "/api/v1/groups", params: { group: { name: "x" * 256 } }, headers: @headers, as: :json
+    assert_response :unprocessable_content
+    post "/api/v1/groups", params: { group: { name: [] } }, headers: @headers, as: :json
+    assert_response :bad_request
+    post "/api/v1/groups", params: { group: { name: "billing" } }, headers: @headers, as: :json
+    assert_response :unprocessable_content
+    assert_equal 1, @account.groups.count
+  end
+end
diff --git a/test/integration/inbound_email_concurrency_test.rb b/test/integration/inbound_email_concurrency_test.rb
