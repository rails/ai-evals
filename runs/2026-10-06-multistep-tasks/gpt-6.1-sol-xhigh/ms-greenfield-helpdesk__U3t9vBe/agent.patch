+
+  test "membership removal and group deletion still clear closed ticket routing" do
+    group = @account.groups.create!(name: "Support")
+    membership = group.group_memberships.create!(user: @owner)
+    @source.update!(group: group)
+    @target.update!(group: group)
+    merge_tickets
+    assert_response :ok
