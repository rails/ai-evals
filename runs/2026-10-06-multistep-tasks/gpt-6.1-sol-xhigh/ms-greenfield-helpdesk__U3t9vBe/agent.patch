+
+  def self.domain
+    Rails.application.config.x.support_domain
+  end
+
+  def self.for_account(account)
+    "#{account.subdomain}@#{domain}"
+  end
+
+  def self.for_ticket(ticket)
+    "#{REPLY_PREFIX}#{ticket.reply_token}@#{domain}"
+  end
+end
