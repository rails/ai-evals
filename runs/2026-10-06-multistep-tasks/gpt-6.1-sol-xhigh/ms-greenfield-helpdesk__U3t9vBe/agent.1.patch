+class Session < ApplicationRecord
+  LIFETIME = 30.days
+
+  belongs_to :user
+  validates :token_digest, :expires_at, presence: true
+  scope :active, -> { where("expires_at > ?", Time.current) }
+
+  def self.issue_for!(user)
+    token = SecretToken.generate
+    session = user.sessions.create!(token_digest: SecretToken.digest(token), expires_at: LIFETIME.from_now)
+    [ session, token ]
+  end
+end
diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..1641a95
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,50 @@
+class User < ApplicationRecord
+  VERIFICATION_LIFETIME = 24.hours
+  PASSWORD_RESET_LIFETIME = 1.hour
+
+  belongs_to :account
+  has_many :sessions, dependent: :destroy
+  has_secure_password reset_token: false
+  enum :role, { member: 0, admin: 1 }, default: :member, validate: true
+
+  normalizes :name, with: ->(name) { name.strip }
+  normalizes :email, with: ->(email) { email.strip.downcase }
+  validates :name, presence: true, length: { maximum: 255 }
+  validates :email, presence: true, length: { maximum: 254 },
+    format: { with: URI::MailTo::EMAIL_REGEXP }, uniqueness: { scope: :account_id }
+  validates :password, length: { minimum: 8 }, allow_nil: true
+
+  def verified?
+    verified_at.present?
+  end
+
+  # Call these while holding the account and user locks when modifying existing users.
+  def issue_verification_token!
+    token = SecretToken.generate
+    update!(verification_token_digest: SecretToken.digest(token),
+      verification_token_expires_at: VERIFICATION_LIFETIME.from_now)
+    token
+  end
+
+  def issue_password_reset_token!
+    token = SecretToken.generate
+    update!(password_reset_token_digest: SecretToken.digest(token),
+      password_reset_token_expires_at: PASSWORD_RESET_LIFETIME.from_now)
+    token
+  end
+
+  def verify_email!
+    update!(verified_at: Time.current, verification_token_digest: nil,
+      verification_token_expires_at: nil)
+  end
+
+  def change_password!(new_password)
+    update!(password: new_password, password_reset_token_digest: nil,
+      password_reset_token_expires_at: nil)
+    sessions.delete_all
+  end
+
+  def public_attributes
+    as_json(only: %i[id account_id name email role created_at updated_at]).merge("verified" => verified?)
+  end
+end
diff --git a/app/services/secret_token.rb b/app/services/secret_token.rb
new file mode 100644
index 0000000..b0573a4
--- /dev/null
+++ b/app/services/secret_token.rb
@@ -0,0 +1,13 @@
+require "digest"
+require "securerandom"
+
+# Only digests are persisted. Raw tokens appear solely in responses or email.
+class SecretToken
+  def self.generate
+    SecureRandom.urlsafe_base64(32)
+  end
+
+  def self.digest(token)
+    Digest::SHA256.hexdigest(token)
+  end
+end
