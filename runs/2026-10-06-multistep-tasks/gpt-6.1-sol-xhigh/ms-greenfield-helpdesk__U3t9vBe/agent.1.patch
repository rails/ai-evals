+    # Skip views, helpers and assets when generating a new resource.
+    config.api_only = true
+
+    frontend = URI.parse(ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001"))
+    unless frontend.is_a?(URI::HTTP) && frontend.host && !frontend.userinfo && !frontend.query && !frontend.fragment
+      raise "HELPDESK_FRONTEND_URL must be an HTTP(S) URL without credentials, query, or fragment"
