+module Api
+  module V1
+    class UsersController < BaseController
+      def show
+        render json: { user: current_user.public_attributes }
+      end
+
+      def update
+        attributes = params.expect(user: [ :name ])
+        string_attributes!(attributes, :name)
+        current_account.with_lock do
+          require_active_account!
+          current_user.with_lock { current_user.update!(attributes) }
+        end
+        render json: { user: current_user.public_attributes }
+      end
+
+      def password
+        attributes = params.expect(password_change: [ :current_password, :password ])
+        string_attributes!(attributes, :current_password, :password)
+        current_account.with_lock do
+          require_active_account!
+          current_user.with_lock do
+            unless attributes[:current_password].present? && current_user.authenticate(attributes[:current_password])
+              raise ApiError.new("incorrect_password", "The current password is incorrect.")
+            end
+            if attributes[:password].blank?
+              raise ApiError.new("validation_failed", "A new password is required.")
+            end
+            current_user.change_password!(attributes[:password])
+          end
+        end
+        head :no_content
+      end
+    end
+  end
+end
