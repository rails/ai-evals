--- /dev/null
+++ b/test/integration/cancellation_api_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class CancellationApiTest < ActionDispatch::IntegrationTest
+  test "only the owner may cancel or reactivate even if another user is an admin" do
+    account, = signed_up_owner
+    other = create_other_user(account, role: :admin)
+    token = login(account, email: other.email)
+    %w[cancel reactivate].each do |action|
+      post "/api/v1/account/#{action}", headers: account_headers(account, token), as: :json
+      assert_response :forbidden
+      assert_equal "owner_required", error_code
+    end
+    refute account.reload.cancelled?
+  end
+
+  test "cancellation revokes every business session and blocks ordinary access but allows owner reactivation" do
+    account, user, token = signed_up_owner
+    other = create_other_user(account)
+    login(account, email: other.email)
+    login(account)
+    post "/api/v1/account/cancel", headers: account_headers(account, token), as: :json
+    assert_response :ok
+    assert response.parsed_body.dig("account", "cancelled_at")
+    assert account.reload.cancelled?
+    assert_equal 0, account.sessions.count
+    assert_equal 2, account.users.count
+    get "/api/v1/me", headers: account_headers(account, token)
+    assert_response :unauthorized
+    get "/api/v1/portal", headers: account_headers(account)
+    assert_response :forbidden
+    owner_token = login(account)
+    %w[me account].each do |endpoint|
+      get "/api/v1/#{endpoint}", headers: account_headers(account, owner_token)
+      assert_response :forbidden
+    end
+    post "/api/v1/sessions", params: { session: { email: other.email, password: PASSWORD } },
+      headers: account_headers(account), as: :json
+    assert_response :forbidden
+    assert_equal "account_cancelled", error_code
+    post "/api/v1/account/reactivate", headers: account_headers(account, owner_token), as: :json
+    assert_response :ok
+    assert_nil response.parsed_body.dig("account", "cancelled_at")
+    refute account.reload.cancelled?
+    get "/api/v1/me", headers: account_headers(account, owner_token)
+    assert_response :ok
+    assert_equal user.id, response.parsed_body.dig("user", "id")
+    login(account, email: other.email)
+  end
+
+  test "recancellation does not extend the original 90-day window and logout remains available" do
+    account, _, token = signed_up_owner
+    post "/api/v1/account/cancel", headers: account_headers(account, token), as: :json
+    assert_response :ok
+    cancelled_at = account.reload.cancelled_at
+    travel 1.day do
+      owner_token = login(account)
+      post "/api/v1/account/cancel", headers: account_headers(account, owner_token), as: :json
+      assert_response :ok
+      assert_equal cancelled_at, account.reload.cancelled_at
+      owner_token = login(account)
+      delete "/api/v1/session", headers: account_headers(account, owner_token)
+      assert_response :no_content
+    end
+  end
+
+  test "reactivation is allowed just before 90 days but not at or after the deadline" do
+    account, user, = signed_up_owner
+    account.update!(cancelled_at: 90.days.ago + 1.second)
+    assert account.reactivatable?
+    token = login(account)
+    travel 2.seconds do
+      post "/api/v1/account/reactivate", headers: account_headers(account, token), as: :json
+      assert_response :forbidden
+      post "/api/v1/sessions", params: { session: { email: user.email, password: PASSWORD } },
+        headers: account_headers(account), as: :json
+      assert_response :forbidden
+      assert account.reload.cancelled?
+    end
+  end
+
+  test "owner can reactivate in the last second of the grace period" do
+    freeze_time do
+      account, _, token = signed_up_owner
+      account.update!(cancelled_at: 90.days.ago + 1.second)
+      post "/api/v1/account/reactivate", headers: account_headers(account, token), as: :json
+      assert_response :ok
+      refute account.reload.cancelled?
+    end
+  end
+
+  test "logout still revokes a valid owner session after the reactivation window ends" do
+    freeze_time do
+      account, _, token = signed_up_owner
+      account.update!(cancelled_at: 90.days.ago)
+      post "/api/v1/account/reactivate", headers: account_headers(account, token), as: :json
+      assert_response :forbidden
+      delete "/api/v1/session", headers: account_headers(account, token)
+      assert_response :no_content
+      assert_equal 0, account.sessions.count
+    end
+  end
+
+  test "cancelled owners can recover passwords but other users and expired accounts cannot" do
+    account, user, = signed_up_owner
+    other = create_other_user(account)
+    account.cancel!
+    reset_request(account)
+    post "/api/v1/password_resets/confirm", params: { password_reset: { token: mail_token, password: NEW_PASSWORD } },
+      headers: account_headers(account), as: :json
+    assert_response :no_content
+    assert user.reload.authenticate(NEW_PASSWORD)
+    login(account, password: NEW_PASSWORD)
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      reset_request(account, email: other.email)
+    end
+    account.update!(cancelled_at: 91.days.ago)
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      reset_request(account)
+    end
+  end
+end
diff --git a/test/integration/passwords_api_test.rb b/test/integration/passwords_api_test.rb
new file mode 100644
index 0000000..a6ecaa0
--- /dev/null
+++ b/test/integration/passwords_api_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class PasswordsApiTest < ActionDispatch::IntegrationTest
+  test "password change requires current password and invalid new passwords do not revoke sessions" do
+    account, user, token = signed_up_owner
+    [ { current_password: "wrong", password: NEW_PASSWORD },
+      { current_password: PASSWORD, password: "short" },
+      { current_password: PASSWORD, password: "" },
+      { current_password: PASSWORD, password: "a" * 73 } ].each do |attributes|
+      put "/api/v1/me/password", params: { password_change: attributes },
+        headers: account_headers(account, token), as: :json
+      assert_response :unprocessable_content
+      assert user.reload.authenticate(PASSWORD)
+      assert_equal 1, user.sessions.count
+    end
+  end
+
+  test "password change revokes every session and any pending reset but not another user's session" do
+    account, user, token = signed_up_owner
+    login(account)
+    other = create_other_user(account)
+    other_token = login(account, email: other.email)
+    reset_request(account)
+    reset_token = mail_token
+    put "/api/v1/me/password", params: { password_change: { current_password: PASSWORD, password: NEW_PASSWORD } },
+      headers: account_headers(account, token), as: :json
+    assert_response :no_content
+    assert_empty user.sessions
+    assert_nil user.reload.password_reset_token_digest
+    assert user.authenticate(NEW_PASSWORD)
+    refute user.authenticate(PASSWORD)
+    get "/api/v1/me", headers: account_headers(account, token)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: account_headers(account, other_token)
+    assert_response :ok
+    post "/api/v1/password_resets/confirm", params: { password_reset: { token: reset_token, password: "third-password" } },
+      headers: account_headers(account), as: :json
+    assert_response :unprocessable_content
+    login(account, password: NEW_PASSWORD)
+  end
+
+  test "reset links point to frontend and newer links invalidate earlier ones" do
+    account, user, = signed_up_owner
+    reset_request(account)
+    first_token = mail_token
+    frontend = URI.parse(Rails.application.config.x.frontend_url)
+    assert_equal "#{frontend.path}/reset-password", mail_link.path
+    assert_equal "acme", URI.decode_www_form(mail_link.query).to_h["account"]
+    assert_in_delta 1.hour.from_now.to_f, user.reload.password_reset_token_expires_at.to_f, 2
+    reset_request(account, email: " JO@ACME.TEST ")
+    second_token = mail_token
+    assert_not_equal first_token, second_token
+    assert_equal SecretToken.digest(second_token), user.reload.password_reset_token_digest
+    post "/api/v1/password_resets/confirm", params: { password_reset: { token: first_token, password: NEW_PASSWORD } },
+      headers: account_headers(account), as: :json
+    assert_response :unprocessable_content
+    assert user.reload.authenticate(PASSWORD)
+    post "/api/v1/password_resets/confirm", params: { password_reset: { token: second_token, password: NEW_PASSWORD } },
+      headers: account_headers(account), as: :json
+    assert_response :no_content
+    assert_empty user.sessions
+    assert user.reload.authenticate(NEW_PASSWORD)
+    assert_nil user.password_reset_token_digest
+    assert_nil user.password_reset_token_expires_at
+    post "/api/v1/password_resets/confirm", params: { password_reset: { token: second_token, password: "third-password" } },
+      headers: account_headers(account), as: :json
+    assert_response :unprocessable_content
+    login(account, password: NEW_PASSWORD)
+  end
+
+  test "reset tokens expire and cannot be used in another business" do
+    account, user, = signed_up_owner
+    reset_request(account)
+    token = mail_token
+    second, = signup(subdomain: "second")
+    post "/api/v1/password_resets/confirm", params: { password_reset: { token: token, password: NEW_PASSWORD } },
+      headers: account_headers(second), as: :json
+    assert_response :unprocessable_content
+    travel_to(user.reload.password_reset_token_expires_at, with_usec: true) do
+      post "/api/v1/password_resets/confirm", params: { password_reset: { token: token, password: NEW_PASSWORD } },
+        headers: account_headers(account), as: :json
+      assert_response :unprocessable_content
+    end
+    assert user.reload.authenticate(PASSWORD)
+    assert_equal 1, user.sessions.count
+  end
+
+  test "invalid reset password does not consume token or revoke sessions" do
+    account, user, = signed_up_owner
+    reset_request(account)
+    token = mail_token
+    post "/api/v1/password_resets/confirm", params: { password_reset: { token: token, password: "short" } },
+      headers: account_headers(account), as: :json
+    assert_response :unprocessable_content
+    assert_equal SecretToken.digest(token), user.reload.password_reset_token_digest
+    assert_equal 1, user.sessions.count
+    post "/api/v1/password_resets/confirm", params: { password_reset: { token: token, password: NEW_PASSWORD } },
+      headers: account_headers(account), as: :json
+    assert_response :no_content
+  end
+
+  test "unknown reset requests have identical responses and do not send email" do
+    account, = signup
+    reset_request(account)
+    known_response = response.parsed_body
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      reset_request(account, email: "missing@example.test")
+    end
+    assert_equal known_response, response.parsed_body
+  end
+
+  test "password recovery does not implicitly verify an unverified email" do
+    account, user = signup
+    reset_request(account)
+    post "/api/v1/password_resets/confirm", params: { password_reset: { token: mail_token, password: NEW_PASSWORD } },
+      headers: account_headers(account), as: :json
+    assert_response :no_content
+    refute user.reload.verified?
+    post "/api/v1/sessions", params: { session: { email: user.email, password: NEW_PASSWORD } },
+      headers: account_headers(account), as: :json
+    assert_response :forbidden
+    assert_equal "email_not_verified", error_code
+  end
+end
