@@ -0,0 +1,34 @@
+require "test_helper"
+
+class UserMailerTest < ActionMailer::TestCase
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @user = @account.users.create!(name: "Jo", email: "jo@acme.test", password: "long-password")
+  end
+
+  test "configured frontend URL is used for both links with safely encoded query parameters" do
+    original = Rails.application.config.x.frontend_url
+    Rails.application.config.x.frontend_url = "https://frontend.example.test/helpdesk"
+    token = "example+token/with=special&characters"
+    { email_verification: "verify-email", password_reset: "reset-password" }.each do |method, path|
+      message = UserMailer.public_send(method, @user, token).message
+      link = URI.parse(message.body.decoded[/https?:\/\/\S+/])
+      assert_equal "https", link.scheme
+      assert_equal "frontend.example.test", link.host
+      assert_equal "/helpdesk/#{path}", link.path
+      assert_equal({ "account" => "acme", "token" => token }, URI.decode_www_form(link.query).to_h)
+      assert_equal [ @user.email ], message.to
+    end
+  ensure
+    Rails.application.config.x.frontend_url = original
+  end
+
+  test "configured sender is used" do
+    original = ENV["HELPDESK_MAIL_FROM"]
+    ENV["HELPDESK_MAIL_FROM"] = "help@custom.example.test"
+    assert_equal [ "help@custom.example.test" ], UserMailer.email_verification(@user, "token").message.from
+    assert_equal [ "help@custom.example.test" ], UserMailer.password_reset(@user, "token").message.from
+  ensure
+    original.nil? ? ENV.delete("HELPDESK_MAIL_FROM") : ENV["HELPDESK_MAIL_FROM"] = original
+  end
+end
