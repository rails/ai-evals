--- /dev/null
+++ b/app/mailers/invitation_mailer.rb
@@ -0,0 +1,8 @@
+class InvitationMailer < ApplicationMailer
+  def invitation(invitation, token)
+    @invitation = invitation
+    query = URI.encode_www_form(account: invitation.account.subdomain, token: token)
+    @link = "#{Rails.application.config.x.frontend_url}/accept-invitation?#{query}"
+    mail(to: invitation.email, subject: "You're invited to #{invitation.account.name}")
+  end
+end
