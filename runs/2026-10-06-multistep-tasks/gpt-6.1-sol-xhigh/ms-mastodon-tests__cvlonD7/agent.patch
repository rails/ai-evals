+
+RSpec.shared_context 'with isolated routes' do
+  # Use a temporary RouteSet instead of redrawing and reloading the application's
+  # full routes for every example. Rails restores routes/session in ensure.
+  around do |example|
+    with_routing { example.run }
+  end
+end
diff --git a/spec/support/model_performance.rb b/spec/support/model_performance.rb
new file mode 100644
index 0000000..4414b6c
--- /dev/null
+++ b/spec/support/model_performance.rb
@@ -0,0 +1,11 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # Model callbacks still enqueue jobs, but unrelated workers need not run while
+  # building a model's test data. Opt in where the assertion needs their effects.
+  # The block API restores the thread-local mode even when an example fails.
+  config.around(:each, type: :model) do |example|
+    mode = example.metadata[:sidekiq_inline] ? :inline : :fake
+    Sidekiq.testing!(mode) { example.run }
+  end
+end
diff --git a/spec/support/request_performance.rb b/spec/support/request_performance.rb
new file mode 100644
index 0000000..5e2b450
--- /dev/null
+++ b/spec/support/request_performance.rb
@@ -0,0 +1,22 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # Most requests assert controller responses, not completed background work.
+  # Keep enqueuing intact; opt in where assertions depend on worker effects.
+  config.around(:each, type: :request) do |example|
+    mode = example.metadata[:sidekiq_inline] ? :inline : :fake
+    Sidekiq.testing!(mode) { example.run }
+  end
+
+  # Formatting DEBUG SQL output is expensive across thousands of requests. Keep
+  # INFO/warnings/errors and restore the thread-local level even on failure.
+  # Opt in to normal diagnostic output when a spec needs it.
+  config.around(:each, type: :request) do |example|
+    if example.metadata[:debug_logging]
+      example.run
+    else
+      logger = ActiveRecord::Base.logger
+      logger.silence([logger.level, Logger::INFO].max) { example.run }
+    end
+  end
+end
