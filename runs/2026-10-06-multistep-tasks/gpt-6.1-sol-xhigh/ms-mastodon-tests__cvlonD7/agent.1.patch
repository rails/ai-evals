new file mode 100644
index 0000000..4414b6c
--- /dev/null
+++ b/spec/support/model_performance.rb
@@ -0,0 +1,11 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # Model callbacks still enqueue jobs, but unrelated workers need not run while
+  # building a model's test data. Opt in where the assertion needs their effects.
+  # The block API restores the thread-local mode even when an example fails.
+  config.around(:each, type: :model) do |example|
+    mode = example.metadata[:sidekiq_inline] ? :inline : :fake
+    Sidekiq.testing!(mode) { example.run }
+  end
+end
