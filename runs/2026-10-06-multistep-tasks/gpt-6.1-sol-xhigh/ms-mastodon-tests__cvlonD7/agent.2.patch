+# frozen_string_literal: true
+
+RSpec.shared_context 'with isolated routes' do
+  # Use a temporary RouteSet instead of redrawing and reloading the application's
+  # full routes for every example. Rails restores routes/session in ensure.
+  around do |example|
+    with_routing { example.run }
+  end
+end
