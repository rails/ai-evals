--- /dev/null
+++ b/spec/support/request_performance.rb
@@ -0,0 +1,22 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # Most requests assert controller responses, not completed background work.
+  # Keep enqueuing intact; opt in where assertions depend on worker effects.
+  config.around(:each, type: :request) do |example|
+    mode = example.metadata[:sidekiq_inline] ? :inline : :fake
+    Sidekiq.testing!(mode) { example.run }
+  end
+
+  # Formatting DEBUG SQL output is expensive across thousands of requests. Keep
+  # INFO/warnings/errors and restore the thread-local level even on failure.
+  # Opt in to normal diagnostic output when a spec needs it.
+  config.around(:each, type: :request) do |example|
+    if example.metadata[:debug_logging]
+      example.run
+    else
+      logger = ActiveRecord::Base.logger
+      logger.silence([logger.level, Logger::INFO].max) { example.run }
+    end
+  end
+end
