+require "rails_helper"
+
+RSpec.describe ActiveStorageProfileImage do
+  %i[user organization].each do |factory|
+    context "with a #{factory}" do
+      let(:image_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+      let(:upload) { Rack::Test::UploadedFile.new(image_path, "image/jpeg") }
+
+      # Build an actual legacy upload without sending it through the new writer.
+      def legacy_record(factory)
+        record = build(factory, profile_image: nil)
+        uploader = record.__send__(:_mounter, :profile_image)
+        uploader.cache([Rack::Test::UploadedFile.new(image_path, "image/jpeg")])
+        record.save!
+        record.reload
+      end
+
+      it "stores new profile pictures only in Active Storage" do
+        record = create(factory, profile_image: upload)
+
+        expect(record.reload.profile_image_file).to be_attached
+        expect(record[:profile_image]).to be_nil
+        expect(record.profile_image_file.download).to eq(File.binread(image_path))
+        expect(record.profile_image_url).to include("/rails/active_storage/blobs/")
+        expect(record.profile_image.to_s).to eq(record.profile_image_url)
+        expect(record.profile_image.as_json).to eq("url" => record.profile_image_url)
+        expect(record.profile_image_90).to eq(record.profile_image_url_for(length: 90))
+      end
+
+      it "preserves legacy URLs and files across unrelated updates" do
+        record = legacy_record(factory)
+        url = record.profile_image_url
+        identifier = record[:profile_image]
+        path = record.profile_image.path
+
+        expect(url).to include("uploads/#{factory}/profile_image/#{record.id}")
+        record.update!(name: "Updated name")
+
+        expect(record.reload.profile_image_file).not_to be_attached
+        expect(record.profile_image_url).to eq(url)
+        expect(record[:profile_image]).to eq(identifier)
+        expect(File).to exist(path)
+      end
+
+      it "prefers Active Storage after replacement without deleting the legacy file or key" do
+        record = legacy_record(factory)
+        identifier = record[:profile_image]
+        path = record.profile_image.path
+
+        record.update!(profile_image: upload)
+
+        expect(record.reload.profile_image_file).to be_attached
+        expect(record.profile_image_url).to include("/rails/active_storage/blobs/")
+        expect(record[:profile_image]).to eq(identifier)
+        expect(File).to exist(path)
+      end
+
+      it "does not change the visible picture on a failed model update" do
+        record = legacy_record(factory)
+        url = record.profile_image_url
+
+        expect(record.update(name: "", profile_image: upload)).to be(false)
+        expect(record.reload.profile_image_file).not_to be_attached
+        expect(record.profile_image_url).to eq(url)
+      end
+
+      it "ignores blank uploads" do
+        record = legacy_record(factory)
+        url = record.profile_image_url
+
+        record.update!(profile_image: nil, remote_profile_image_url: "")
+
+        expect(record.reload.profile_image_url).to eq(url)
+        expect(record.profile_image_file).not_to be_attached
+      end
+
+      it "keeps the visible picture when an invalid file is submitted" do
+        record = legacy_record(factory)
+        url = record.profile_image_url
+        invalid = Rack::Test::UploadedFile.new(
+          Rails.root.join("spec/support/fixtures/sample_article.txt"), "text/plain"
+        )
+
+        expect(record.update(profile_image: invalid)).to be(false)
+        expect(record.errors[:profile_image]).to be_present
+        expect(record.reload.profile_image_url).to eq(url)
+      end
+
+      it "rejects oversized uploads without replacing the visible picture" do
+        record = legacy_record(factory)
+        url = record.profile_image_url
+        oversized = { tempfile: StringIO.new("x" * (ProfileImageUploader::MAX_FILE_SIZE + 1)), filename: "large.jpg" }
+
+        expect(record.update(profile_image: oversized)).to be(false)
+        expect(record.errors[:profile_image]).to be_present
+        expect(record.reload.profile_image_url).to eq(url)
+      end
+
+      it "reads avatars on partially selected records used by public APIs" do
+        record = create(factory, profile_image: upload)
+        selected = record.class.select(:id, :profile_image).find(record.id)
+
+        expect(selected.profile_image_url).to eq(record.profile_image_url)
+      end
+
+      it "preserves an existing Active Storage picture after a failed replacement" do
+        record = create(factory, profile_image: upload)
+        original_blob = record.profile_image_file.blob
+        url = record.profile_image_url
+
+        expect(record.update(name: "", profile_image: upload)).to be(false)
+        expect(record.profile_image_url).to eq(url)
+        expect(record.reload.profile_image_file.blob).to eq(original_blob)
+        expect(record.profile_image_url).to eq(url)
+      end
+
+      it "imports a remote picture into Active Storage" do
+        record = legacy_record(factory)
+        url = "https://example.com/avatar.jpg"
+        stub_request(:get, url).to_return(body: File.binread(image_path),
+                                          headers: { "Content-Type" => "image/jpeg" })
+
+        record.update!(remote_profile_image_url: url)
+
+        expect(record.remote_profile_image_url).to eq(url)
+        expect(record.reload.profile_image_file).to be_attached
+        expect(record.profile_image_file.download).to eq(File.binread(image_path))
+      end
+
+      it "keeps the visible picture when a remote download fails" do
+        record = legacy_record(factory)
+        url = record.profile_image_url
+        stub_request(:get, "https://example.com/missing.jpg").to_return(status: 404)
+
+        expect(record.update(remote_profile_image_url: "https://example.com/missing.jpg")).to be(false)
+        expect(record.errors[:profile_image]).to be_present
+        expect(record.reload.profile_image_url).to eq(url)
+      end
+    end
+  end
+
+  it "still requires an organization profile picture" do
+    organization = build(:organization, profile_image: nil)
+
+    expect(organization).not_to be_valid
+    expect(organization.errors[:profile_image]).to be_present
+  end
+
+  it "leaves tag and tweet uploads on CarrierWave" do
+    expect(Tag.uploaders[:profile_image]).to eq(ProfileImageUploader)
+    expect(Tweet.uploaders[:profile_image]).to eq(ProfileImageUploader)
+    expect(Tag.reflect_on_attachment(:profile_image_file)).to be_nil
+    expect(Tweet.reflect_on_attachment(:profile_image_file)).to be_nil
+  end
+
+  it "analyzes new pictures using the existing ImageMagick installation" do
+    user = create(:user)
+    blob = user.profile_image_file.blob
+
+    blob.analyze
+
+    expect(blob.reload).to be_analyzed
+    expect(blob.metadata["width"]).to be_positive
+    expect(blob.metadata["height"]).to be_positive
+  end
+
+  it "invalidates user avatar caches when the attachment changes, but not on unrelated saves" do
+    user = create(:user)
+    upload = Rack::Test::UploadedFile.new(Rails.root.join("spec/support/fixtures/images/image1.jpeg"), "image/jpeg")
+    allow(Users::BustProfileImageCacheWorker).to receive(:perform_async)
+
+    user.update!(profile_image: upload)
+    expect(Users::BustProfileImageCacheWorker).to have_received(:perform_async).with(user.id).once
+
+    user.update!(name: "Another name")
+    expect(Users::BustProfileImageCacheWorker).to have_received(:perform_async).once
+  end
+
+  it "refreshes an organization's cached article avatars when its attachment changes" do
+    organization = create(:organization)
+    article = create(:article, organization: organization)
+    upload = Rack::Test::UploadedFile.new(Rails.root.join("spec/support/fixtures/images/image1.jpeg"), "image/jpeg")
+    allow(Organizations::SaveArticleWorker).to receive(:perform_bulk)
+    allow(Images::SocialImageWorker).to receive(:perform_async)
+
+    organization.update!(profile_image: upload)
+
+    expect(Organizations::SaveArticleWorker).to have_received(:perform_bulk).with([[article.id]])
+    expect(Images::SocialImageWorker).to have_received(:perform_async).with(organization.id, "Organization")
+  end
+end
