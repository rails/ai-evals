diff --git a/app/models/concerns/active_storage_profile_image.rb b/app/models/concerns/active_storage_profile_image.rb
new file mode 100644
index 0000000..8de759c
--- /dev/null
+++ b/app/models/concerns/active_storage_profile_image.rb
@@ -0,0 +1,93 @@
+# A dual-read, single-write bridge. Keep the CarrierWave mount and column until
+# legacy pictures have been migrated in a later deploy. Never rewrite their keys.
+module ActiveStorageProfileImage
+  extend ActiveSupport::Concern
+
+  included do
+    has_one_attached :profile_image_file
+
+    validate :validate_profile_image_upload
+    before_save :track_profile_image_attachment_change
+  end
+
+  def profile_image
+    return super unless profile_image_file.attached?
+
+    Images::AttachedProfileImage.new(self)
+  end
+
+  def profile_image_url(*args)
+    blob = profile_image_file.blob
+    # A failed model validation may leave a new, unsaved blob staged in memory.
+    # Keep showing the saved attachment on the redisplayed form.
+    blob = profile_image_file_attachment&.blob unless blob&.persisted?
+    return super unless blob&.persisted?
+
+    # Use a permanent app URL, not a short-lived S3 URL, in API responses,
+    # notifications, article caches, and image optimizer sources.
+    URL.url(Rails.application.routes.url_helpers.rails_blob_path(blob, only_path: true))
+  end
+
+  def profile_image=(file)
+    return if file.blank?
+
+    stage_profile_image { |uploader| uploader.cache!(file) }
+  end
+
+  def remote_profile_image_url=(url)
+    return if url.blank?
+
+    unless url.is_a?(String)
+      self.profile_image = url
+      return
+    end
+
+    @remote_profile_image_url = url
+    stage_profile_image { |uploader| uploader.download!(url) }
+  end
+
+  def remote_profile_image_url
+    @remote_profile_image_url
+  end
+
+  def profile_image_attachment_changed?
+    @profile_image_attachment_changed == true
+  end
+
+  def reload(*)
+    super.tap do
+      @profile_image_attachment_changed = false
+      @profile_image_upload_error = nil
+    end
+  end
+
+  private
+
+  def stage_profile_image
+    @profile_image_upload_error = nil
+    uploader = ProfileImageUploader.new(self, :profile_image)
+    yield uploader
+    return if uploader.file.blank?
+
+    # A detached uploader preserves extension/size checks, BombShelter, frame
+    # limits, EXIF stripping, and CarrierWave's SSRF-safe downloader. It must
+    # never call store! or update the legacy mount/column.
+    self.profile_image_file = {
+      io: StringIO.new(uploader.file.read),
+      filename: uploader.filename,
+      content_type: uploader.file.content_type
+    }
+  rescue CarrierWave::IntegrityError, CarrierWave::ProcessingError, CarrierWave::DownloadError => e
+    @profile_image_upload_error = e.message
+  ensure
+    uploader&.remove!
+  end
+
+  def validate_profile_image_upload
+    errors.add(:profile_image, @profile_image_upload_error) if @profile_image_upload_error
+  end
+
+  def track_profile_image_attachment_change
+    @profile_image_attachment_changed = attachment_changes.key?("profile_image_file")
+  end
+end
