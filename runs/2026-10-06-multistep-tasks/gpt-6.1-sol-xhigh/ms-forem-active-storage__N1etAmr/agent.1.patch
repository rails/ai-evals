--- /dev/null
+++ b/app/services/images/attached_profile_image.rb
@@ -0,0 +1,19 @@
+module Images
+  # Preserve the small CarrierWave presentation interface used by forms,
+  # mailers, serializers, and URL.local_image during the staged migration.
+  class AttachedProfileImage
+    def initialize(record)
+      @record = record
+    end
+
+    def url
+      @record.profile_image_url
+    end
+
+    delegate :to_s, to: :url
+
+    def as_json(*)
+      { "url" => url }
+    end
+  end
+end
