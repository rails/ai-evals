+    params = { room: { name: room.name }, user_ids: room.user_ids + [ @bot.id ] }
+    assert_enqueued_jobs 1, only: User::Bot::JoinedWebhookJob do
+      put rooms_closed_url(room), params: params
+    end
+    assert_redirected_to room_url(room)
+    assert_no_enqueued_jobs only: User::Bot::JoinedWebhookJob do
+      put rooms_closed_url(room), params: params
+    end
+    assert_redirected_to room_url(room)
+  end
+  test "open room member picker can grant and revoke opted-out bots without affecting automatic members" do
+    sign_in :david
+    @bot.update!(webhook_url: "https://bots.example.com/events")
+    automatic = users(:kevin).bots.create!(name: "Everyone Bot", add_to_all_open_rooms: true)
