+require "test_helper"
+
+class User::Bot::WebhookJobTest < ActiveSupport::TestCase
+  include Rails.application.routes.url_helpers
+  include ActionCable::TestHelper
+
+  setup do
+    @room = rooms(:hq)
+    @bot = users(:kevin).bots.create!(name: "Deploy Bot", webhook_url: "https://bots.example.com/mention")
+    rooms(:hq).memberships.grant_to(@bot)
+    @message = @room.messages.create!(creator: users(:david), body: "<div>#{ActionText::Attachment.from_attachable(@bot).to_html} restart <strong>the build</strong> please</div>")
+    Resolv.stubs(:getaddresses).with("bots.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "sends a JSON mention payload with the bot's own reply URL and message deep link" do
+    payload = nil
+    stub_request(:post, @bot.webhook_url).with(headers: { "Content-Type" => "application/json" }) do |request|
+      payload = JSON.parse(request.body)
+    end.to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => users(:david).id, "name" => "David" }, payload["author"])
+    assert_equal({ "id" => @room.id, "name" => @room.name,
+      "reply_to" => room_bot_messages_path(@room, bot_token: @bot.bot_token) }, payload["room"])
+    assert_equal @message.id, payload["message"]["id"]
+    assert_equal "restart the build please", payload["message"]["body"]["text"]
+    assert_equal @message.body.to_s, payload["message"]["body"]["html"]
+    assert_includes payload["message"]["body"]["html"], "Deploy Bot"
+    assert_includes payload["message"]["body"]["html"], "<strong>the build</strong>"
+    assert_equal room_at_message_path(@room, message_id: @message.id), payload["message"]["link"]
+  end
+
+  test "plain text response is posted escaped as the bot and broadcast through the normal pipeline" do
+    text = "Done <script>alert('no')</script> & ready\nsecond line ✅"
+    stub_response(body: text, content_type: "text/plain; charset=utf-8")
+
+    assert_difference -> { @room.messages.count }, 1 do
+      assert_enqueued_jobs 1, only: Room::PushMessageJob do
+        assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+          deliver
+        end
+      end
+    end
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal text, reply.plain_text_body
+    assert_not_includes reply.body.to_s, "<script>"
+  end
+
+  test "HTML response keeps rich text while removing unsafe markup when rendered" do
+    stub_response(body: "<div><strong>Done</strong><br><a href='https://example.com'>Details</a><script>alert('no')</script></div>", content_type: "text/html; charset=UTF-8")
+    assert_difference -> { @room.messages.count }, 1 do
+      deliver
+    end
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.to_s, "<strong>Done</strong>"
+    assert_includes reply.body.to_s, 'href="https://example.com"'
+    assert_not_includes reply.body.to_s, "<script>"
+  end
+
+  test "204, unsuccessful status, unsupported content type, and empty bodies produce no reply" do
+    [ [ 204, "text/plain", "ignored" ], [ 500, "text/plain", "failed" ],
+      [ 201, "text/html", "created" ], [ 200, "application/json", '{"reply":"no"}' ],
+      [ 200, nil, "missing content type" ], [ 200, "text/plain", " \n" ],
+      [ 200, "text/html", "" ] ].each do |status, content_type, body|
+      stub_response(status:, content_type:, body:)
+      assert_no_difference -> { Message.count } do
+        deliver
+      end
+    end
+  end
+
+  test "redirects are not followed with the bot credential" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 302, headers: { "Location" => "https://other.example.com/mention" })
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert_not_requested :any, "https://other.example.com/mention"
+  end
+
+  test "timeouts and network failures do not create messages" do
+    [ Net::ReadTimeout, SocketError, Errno::ECONNREFUSED ].each do |error|
+      stub_request(:post, @bot.webhook_url).to_raise(error)
+      assert_no_difference -> { Message.count } do
+        deliver
+      end
+    end
+  end
+
+  test "private networks are not contacted" do
+    Resolv.stubs(:getaddresses).with("bots.example.com").returns([ "127.0.0.1" ])
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "oversized responses and invalid UTF-8 are ignored" do
+    [ "x" * (User::Bot::Webhook::MAX_RESPONSE_SIZE + 1), "\xFF".b ].each do |body|
+      stub_response(body:, content_type: "text/plain")
+      assert_no_difference -> { Message.count } do
+        deliver
+      end
+    end
+
+    stub_request(:post, @bot.webhook_url).to_return(status: 200, body: "tiny", headers: {
+      "Content-Type" => "text/plain", "Content-Length" => 1.gigabyte.to_s })
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+  end
+
+  test "removed webhooks, deactivated bots, and revoked membership cancel pending delivery" do
+    @bot.update!(webhook_url: nil)
+    deliver
+    @bot.update!(webhook_url: "https://bots.example.com/mention", status: :deactivated)
+    deliver
+    @bot.update!(status: :active)
+    @room.memberships.revoke_from(@bot)
+    deliver
+
+    assert_not_requested :post, "https://bots.example.com/mention"
+  end
+
+  test "revoking membership during a request prevents a reply" do
+    stub_request(:post, @bot.webhook_url).to_return do
+      @room.memberships.revoke_from(@bot)
+      { status: 200, body: "Done", headers: { "Content-Type" => "text/plain" } }
+    end
+
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+  end
+
+  test "deleted messages safely discard queued jobs" do
+    @message.destroy!
+    assert_nothing_raised do
+      perform_enqueued_jobs only: User::Bot::WebhookJob
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  private
+    def deliver
+      User::Bot::WebhookJob.perform_now(@bot.reload, @message)
+    end
+
+    def stub_response(status: 200, content_type:, body:)
+      stub_request(:post, @bot.webhook_url).to_return(status:, body:, headers: { "Content-Type" => content_type }.compact)
+    end
+end
