+require "application_system_test_case"
+
+class ManagingBotsTest < ApplicationSystemTestCase
+  setup do
+    sign_in "jz@37signals.com"
+  end
+
+  test "a member can create edit and delete a chat bot" do
+    visit edit_account_url
+    click_on "Set up chat bots"
+    click_on "Add a chat bot"
+    assert_unchecked_field "Add to all open rooms"
+    fill_in "Name the bot", with: "Deploy Bot"
+    fill_in "Webhook URL", with: "https://bots.example.com/mention"
+    attach_file "Bot avatar", file_fixture("earth.png"), make_visible: true
+    click_on "Save changes"
+
+    assert_current_path bots_path
+    bot = User.bot.find_by!(name: "Deploy Bot")
+    assert_not bot.add_to_all_open_rooms?
+    assert_empty bot.rooms
+    within "li##{dom_id(bot)}" do
+      assert_field "Bot code", with: bot.bot_token, readonly: true
+      click_on "Edit Deploy Bot"
+    end
+
+    assert_field "Webhook URL", with: "https://bots.example.com/mention"
+    fill_in "Webhook URL", with: ""
+    fill_in "Name the bot", with: "Release Bot"
+    click_on "Save changes"
+    assert_current_path bots_path
+    assert_nil bot.reload.webhook_url
+    click_on "Edit Release Bot"
+    assert_field "Webhook URL", with: ""
+
+    dismiss_confirm do
+      click_on "Delete this chat bot"
+    end
+    assert_current_path edit_bot_path(bot)
+    assert bot.reload.active?
+
+    accept_confirm do
+      click_on "Delete this chat bot"
+    end
+    assert_current_path bots_path
+    assert_no_text "Release Bot"
+    assert bot.reload.deactivated?
+  end
+  test "a bot author can opt in to all open rooms and opt out without losing memberships" do
+    visit new_bot_url
+    fill_in "Name the bot", with: "Everyone Bot"
+    assert_unchecked_field "Add to all open rooms"
+    check "Add to all open rooms", allow_label_click: true
+    click_on "Save changes"
+    assert_current_path bots_path
+
+    bot = User.bot.find_by!(name: "Everyone Bot")
+    assert bot.add_to_all_open_rooms?
+    assert_equal Rooms::Open.ids.sort, bot.room_ids.sort
+    room = Rooms::Open.create!(name: "Bot arrivals", creator: users(:jz))
+    assert_includes room.users, bot
+    memberships = bot.membership_ids.sort
+
+    click_on "Edit Everyone Bot"
+    assert_checked_field "Add to all open rooms"
+    uncheck "Add to all open rooms", allow_label_click: true
+    click_on "Save changes"
+    assert_current_path bots_path
+    assert_not bot.reload.add_to_all_open_rooms?
+    assert_equal memberships, bot.membership_ids.sort
+
+    later_room = Rooms::Open.create!(name: "Later arrivals", creator: users(:jz))
+    assert_not_includes later_room.users, bot
+    click_on "Edit Everyone Bot"
+    assert_unchecked_field "Add to all open rooms"
+    check "Add to all open rooms", allow_label_click: true
+    click_on "Save changes"
+    assert_current_path bots_path
+    assert_includes later_room.users.reload, bot
+  end
+  test "a room creator can choose an opted-out bot for an open room" do
+    bot = users(:jz).bots.create!(name: "Selective Bot")
+    room = Rooms::Open.create!(name: "Selected bot room", creator: users(:jz))
+    human_ids = room.users.human.ids.sort
+    visit edit_rooms_open_url(room)
+    assert_unchecked_field "Give Selective Bot access to this room"
+    check "Give Selective Bot access to this room", allow_label_click: true
+    click_on "Save"
+    assert_current_path room_path(room)
+    assert_includes room.users.reload, bot
+
+    visit edit_rooms_open_url(room)
+    assert_checked_field "Give Selective Bot access to this room"
+    uncheck "Give Selective Bot access to this room", allow_label_click: true
+    click_on "Save"
+    assert_current_path room_path(room)
+    assert_not_includes room.users.reload, bot
+    assert_equal human_ids, room.users.human.ids.sort
+  end
+end
