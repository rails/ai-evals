diff --git a/test/jobs/user/bot/joined_webhook_job_test.rb b/test/jobs/user/bot/joined_webhook_job_test.rb
new file mode 100644
index 0000000..16db935
--- /dev/null
+++ b/test/jobs/user/bot/joined_webhook_job_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class User::Bot::JoinedWebhookJobTest < ActiveSupport::TestCase
+  include Rails.application.routes.url_helpers
+  include ActionCable::TestHelper
+
+  setup do
+    @room = rooms(:hq)
+    @bot = users(:kevin).bots.create!(name: "Deploy Bot", webhook_url: "https://bots.example.com/events")
+    @room.memberships.grant_to(@bot)
+    @membership = @room.memberships.find_by!(user: @bot)
+    Resolv.stubs(:getaddresses).with("bots.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "sends only the joined event and room including the bot's own reply URL" do
+    payload = nil
+    stub_request(:post, @bot.webhook_url).with(headers: { "Content-Type" => "application/json" }) do |request|
+      payload = JSON.parse(request.body)
+    end.to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      @room.memberships.grant_to(@bot)
+      perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+    end
+    assert_requested :post, @bot.webhook_url, times: 1
+    assert_equal({
+      "event" => "joined",
+      "room" => { "id" => @room.id, "name" => @room.name,
+        "reply_to" => room_bot_messages_path(@room, bot_token: @bot.bot_token) }
+    }, payload)
+  end
+
+  test "plain text greeting is escaped and posted as the bot through the normal pipeline" do
+    text = "Hello <script>alert('no')</script> & welcome\nReady ✅"
+    stub_request(:post, @bot.webhook_url).to_return(status: 200, body: text,
+      headers: { "Content-Type" => "text/plain; charset=utf-8" })
+
+    assert_difference -> { @room.messages.count }, 1 do
+      assert_enqueued_jobs 1, only: Room::PushMessageJob do
+        assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+          deliver
+        end
+      end
+    end
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal text, reply.plain_text_body
+    assert_not_includes reply.body.to_s, "<script>"
+    assert memberships(:david_hq).reload.unread?
+  end
+
+  test "HTML greetings preserve rich text and do not cause mention loops" do
+    mention = ActionText::Attachment.from_attachable(@bot).to_html
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      body: "<div><strong>Hello!</strong> #{mention}<script>alert('no')</script></div>",
+      headers: { "Content-Type" => "text/html; charset=utf-8" })
+
+    assert_difference -> { @room.messages.count }, 1 do
+      assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+        deliver
+      end
+    end
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.to_s, "<strong>Hello!</strong>"
+    assert_not_includes reply.body.to_s, "<script>"
+  end
+
+  test "blank unsupported and unsuccessful responses produce no greeting" do
+    [ [ 200, "text/plain", " " ], [ 200, "application/json", '{"hello":true}' ],
+      [ 204, "text/plain", "Hello" ], [ 500, "text/plain", "Hello" ] ].each do |status, content_type, body|
+      stub_request(:post, @bot.webhook_url).to_return(status:, body:, headers: { "Content-Type" => content_type })
+      assert_no_difference -> { Message.count } do
+        deliver
+      end
+    end
+  end
+
+  test "removed webhooks and inactive bots cancel pending joined delivery" do
+    @bot.update!(webhook_url: nil)
+    deliver
+    @bot.update!(webhook_url: "https://bots.example.com/events", status: :deactivated)
+    deliver
+    @bot.update!(status: :banned)
+    deliver
+    assert_not_requested :post, "https://bots.example.com/events"
+  end
+
+  test "removed memberships discard the queued joined event even if the bot is added again" do
+    @membership.destroy!
+    @room.memberships.grant_to(@bot)
+    @room.memberships.revoke_from(@bot)
+    assert_nothing_raised do
+      perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "deleted rooms and bots safely discard queued joins" do
+    @room.destroy!
+    @bot.destroy!
+    assert_nothing_raised do
+      perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+    end
+    assert_not_requested :post, "https://bots.example.com/events"
+  end
+
+  test "direct rooms never deliver joined webhooks even if called explicitly" do
+    room = Rooms::Direct.create_for({ creator: users(:kevin) }, users: [ users(:kevin), @bot ])
+    User::Bot::JoinedWebhookJob.perform_now(room.memberships.find_by!(user: @bot))
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "revoking membership during delivery prevents a greeting" do
+    stub_request(:post, @bot.webhook_url).to_return do
+      @room.memberships.revoke_from(@bot)
+      { status: 200, body: "Hello", headers: { "Content-Type" => "text/plain" } }
+    end
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+  end
+
+  test "joined deliveries use the same private-network protection as mentions" do
+    Resolv.stubs(:getaddresses).with("bots.example.com").returns([ "127.0.0.1" ])
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  private
+    def deliver
+      User::Bot::JoinedWebhookJob.perform_now(@membership.reload)
+    end
+end
