index 0000000..ff4a484
--- /dev/null
+++ b/test/controllers/bots/webhooks_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Bots::WebhooksTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    @bot = users(:kevin).bots.create!(name: "Deploy Bot")
+  end
+
+  test "new and edit forms have an optional Webhook URL" do
+    [ new_bot_url, edit_bot_url(@bot) ].each do |url|
+      get url
+      assert_response :success
+      assert_select "label[for='bot_webhook_url']", text: "Webhook URL"
+      assert_select "input#bot_webhook_url[type=url]:not([required])"
+    end
+  end
+
+  test "create saves the webhook and editing can remove it" do
+    post bots_url, params: { bot: { name: "Webhook Bot", webhook_url: "https://bots.example.com/mention" } }
+    assert_redirected_to bots_url
+    bot = User.bot.find_by!(name: "Webhook Bot")
+    assert_equal "https://bots.example.com/mention", bot.webhook_url
+
+    get edit_bot_url(bot)
+    assert_select "input#bot_webhook_url[value='https://bots.example.com/mention']"
+
+    patch bot_url(bot), params: { bot: { webhook_url: "https://bots.example.com/replacement" } }
+    assert_redirected_to bots_url
+    assert_equal "https://bots.example.com/replacement", bot.reload.webhook_url
+
+    patch bot_url(bot), params: { bot: { webhook_url: "" } }
+    assert_redirected_to bots_url
+    assert_nil bot.reload.webhook_url
+  end
+
+  test "invalid webhook URLs are rejected without losing the form" do
+    post bots_url, params: { bot: { name: "Webhook Bot", webhook_url: "ftp://bots.example.com/mention" } }
+    assert_response :unprocessable_entity
+    assert_select "[role=alert]", text: /Webhook url must be an HTTP or HTTPS URL/
+  end
+
+  test "human posting queues a callback and the supplied reply URL supports later bot messages" do
+    @bot.update!(webhook_url: "https://bots.example.com/mention")
+    room = rooms(:hq)
+    payload = nil
+    Resolv.stubs(:getaddresses).with("bots.example.com").returns([ "93.184.216.34" ])
+    stub_request(:post, @bot.webhook_url).with do |request|
+      payload = JSON.parse(request.body)
+    end.to_return(status: 204)
+
+    assert_enqueued_jobs 1, only: User::Bot::WebhookJob do
+      post room_messages_url(room, format: :turbo_stream), params: {
+        message: { body: "<div>#{ActionText::Attachment.from_attachable(@bot).to_html} restart the build please</div>" }
+      }
+      assert_response :success
+    end
+    assert_not_requested :post, @bot.webhook_url
+    original = room.messages.last
+
+    perform_enqueued_jobs only: User::Bot::WebhookJob
+    assert_equal "restart the build please", payload["message"]["body"]["text"]
+
+    get payload["message"]["link"]
+    assert_response :success
+    assert_select "##{dom_id(original)}"
+
+    delete session_url
+    assert_difference -> { room.messages.count }, 1 do
+      post payload["room"]["reply_to"], params: "Build restarted ✅", headers: { "CONTENT_TYPE" => "text/plain" }
+      assert_response :created
+    end
+    assert_equal @bot, room.messages.last.creator
+    assert_equal "Build restarted ✅", room.messages.last.plain_text_body
+  end
+end
diff --git a/test/jobs/user/bot/webhook_job_test.rb b/test/jobs/user/bot/webhook_job_test.rb
new file mode 100644
index 0000000..18b69e6
--- /dev/null
+++ b/test/jobs/user/bot/webhook_job_test.rb
@@ -0,0 +1,158 @@
+require "test_helper"
+
+class User::Bot::WebhookJobTest < ActiveSupport::TestCase
+  include Rails.application.routes.url_helpers
+  include ActionCable::TestHelper
+
+  setup do
+    @room = rooms(:hq)
+    @bot = users(:kevin).bots.create!(name: "Deploy Bot", webhook_url: "https://bots.example.com/mention")
+    @message = @room.messages.create!(creator: users(:david), body: "<div>#{ActionText::Attachment.from_attachable(@bot).to_html} restart <strong>the build</strong> please</div>")
+    Resolv.stubs(:getaddresses).with("bots.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "sends a JSON mention payload with the bot's own reply URL and message deep link" do
+    payload = nil
+    stub_request(:post, @bot.webhook_url).with(headers: { "Content-Type" => "application/json" }) do |request|
+      payload = JSON.parse(request.body)
+    end.to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => users(:david).id, "name" => "David" }, payload["author"])
+    assert_equal({ "id" => @room.id, "name" => @room.name,
+      "reply_to" => room_bot_messages_path(@room, bot_token: @bot.bot_token) }, payload["room"])
+    assert_equal @message.id, payload["message"]["id"]
+    assert_equal "restart the build please", payload["message"]["body"]["text"]
+    assert_equal @message.body.to_s, payload["message"]["body"]["html"]
+    assert_includes payload["message"]["body"]["html"], "Deploy Bot"
+    assert_includes payload["message"]["body"]["html"], "<strong>the build</strong>"
+    assert_equal room_at_message_path(@room, message_id: @message.id), payload["message"]["link"]
+  end
+
+  test "plain text response is posted escaped as the bot and broadcast through the normal pipeline" do
+    text = "Done <script>alert('no')</script> & ready\nsecond line ✅"
+    stub_response(body: text, content_type: "text/plain; charset=utf-8")
+
+    assert_difference -> { @room.messages.count }, 1 do
+      assert_enqueued_jobs 1, only: Room::PushMessageJob do
+        assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+          deliver
+        end
+      end
+    end
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal text, reply.plain_text_body
+    assert_not_includes reply.body.to_s, "<script>"
+  end
+
+  test "HTML response keeps rich text while removing unsafe markup when rendered" do
+    stub_response(body: "<div><strong>Done</strong><br><a href='https://example.com'>Details</a><script>alert('no')</script></div>", content_type: "text/html; charset=UTF-8")
+    assert_difference -> { @room.messages.count }, 1 do
+      deliver
+    end
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.to_s, "<strong>Done</strong>"
+    assert_includes reply.body.to_s, 'href="https://example.com"'
+    assert_not_includes reply.body.to_s, "<script>"
+  end
+
+  test "204, unsuccessful status, unsupported content type, and empty bodies produce no reply" do
+    [ [ 204, "text/plain", "ignored" ], [ 500, "text/plain", "failed" ],
+      [ 201, "text/html", "created" ], [ 200, "application/json", '{"reply":"no"}' ],
+      [ 200, nil, "missing content type" ], [ 200, "text/plain", " \n" ],
+      [ 200, "text/html", "" ] ].each do |status, content_type, body|
+      stub_response(status:, content_type:, body:)
+      assert_no_difference -> { Message.count } do
+        deliver
+      end
+    end
+  end
+
+  test "redirects are not followed with the bot credential" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 302, headers: { "Location" => "https://other.example.com/mention" })
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert_not_requested :any, "https://other.example.com/mention"
+  end
+
+  test "timeouts and network failures do not create messages" do
+    [ Net::ReadTimeout, SocketError, Errno::ECONNREFUSED ].each do |error|
+      stub_request(:post, @bot.webhook_url).to_raise(error)
+      assert_no_difference -> { Message.count } do
+        deliver
+      end
+    end
+  end
+
+  test "private networks are not contacted" do
+    Resolv.stubs(:getaddresses).with("bots.example.com").returns([ "127.0.0.1" ])
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "oversized responses and invalid UTF-8 are ignored" do
+    [ "x" * (User::Bot::Webhook::MAX_RESPONSE_SIZE + 1), "\xFF".b ].each do |body|
+      stub_response(body:, content_type: "text/plain")
+      assert_no_difference -> { Message.count } do
+        deliver
+      end
+    end
+
+    stub_request(:post, @bot.webhook_url).to_return(status: 200, body: "tiny", headers: {
+      "Content-Type" => "text/plain", "Content-Length" => 1.gigabyte.to_s })
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+  end
+
+  test "removed webhooks, deactivated bots, and revoked membership cancel pending delivery" do
+    @bot.update!(webhook_url: nil)
+    deliver
+    @bot.update!(webhook_url: "https://bots.example.com/mention", status: :deactivated)
+    deliver
+    @bot.update!(status: :active)
+    @room.memberships.revoke_from(@bot)
+    deliver
+
+    assert_not_requested :post, "https://bots.example.com/mention"
+  end
+
+  test "revoking membership during a request prevents a reply" do
+    stub_request(:post, @bot.webhook_url).to_return do
+      @room.memberships.revoke_from(@bot)
+      { status: 200, body: "Done", headers: { "Content-Type" => "text/plain" } }
+    end
+
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+  end
+
+  test "deleted messages safely discard queued jobs" do
+    @message.destroy!
+    assert_nothing_raised do
+      perform_enqueued_jobs only: User::Bot::WebhookJob
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  private
+    def deliver
+      User::Bot::WebhookJob.perform_now(@bot.reload, @message)
+    end
+
+    def stub_response(status: 200, content_type:, body:)
+      stub_request(:post, @bot.webhook_url).to_return(status:, body:, headers: { "Content-Type" => content_type }.compact)
+    end
+end
diff --git a/test/models/message/bot_mention_test.rb b/test/models/message/bot_mention_test.rb
new file mode 100644
index 0000000..323a9ff
--- /dev/null
+++ b/test/models/message/bot_mention_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Message::BotMentionTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:hq)
+    @bot = users(:kevin).bots.create!(name: "Deploy Bot", webhook_url: "https://bots.example.com/mention")
+  end
+
+  test "creating a mention queues a callback without contacting the webhook" do
+    assert_enqueued_with job: User::Bot::WebhookJob, args: ->(args) { args.first == @bot && args.last.is_a?(Message) } do
+      @message = create_message("#{mention(@bot)} restart the build please")
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "duplicate mentions queue one callback per bot" do
+    other_bot = users(:kevin).bots.create!(name: "Build Bot", webhook_url: "https://bots.example.com/build")
+
+    assert_enqueued_jobs 2, only: User::Bot::WebhookJob do
+      create_message("#{mention(@bot)} #{mention(other_bot)} #{mention(@bot)} restart")
+    end
+  end
+
+  test "no callback for ordinary text mentions or bots without webhooks" do
+    other_bot = users(:kevin).bots.create!(name: "Build Bot")
+
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      create_message("@Deploy Bot restart")
+      create_message("#{mention(other_bot)} restart")
+      create_message(mention_attachment_for(:david))
+      create_message("")
+    end
+  end
+
+  test "no callback for inactive bots or bots outside the room" do
+    @bot.update!(status: :banned)
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      create_message("#{mention(@bot)} restart")
+    end
+
+    @bot.update!(status: :active)
+    @room.memberships.revoke_from(@bot)
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      create_message("#{mention(@bot)} restart")
+    end
+  end
+
+  test "bot-authored mentions do not cause webhook loops" do
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      create_message("#{mention(@bot)} restart", creator: @bot)
+    end
+  end
+
+  test "editing a message does not repeat the webhook" do
+    message = create_message("#{mention(@bot)} restart")
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      message.update!(body: "#{mention(@bot)} restart again")
+    end
+  end
+
+  test "only the addressed bot's attachments are stripped from plain text" do
+    other_bot = users(:kevin).bots.create!(name: "Build Bot")
+    message = create_message("#{mention(@bot)} restart <strong>the build</strong> please<br>#{mention_attachment_for(:david)} #{mention(other_bot)} @Deploy Bot")
+
+    assert_equal "restart the build please\n@David @Build Bot @Deploy Bot", message.plain_text_body_without_mention(@bot)
+    assert_includes message.plain_text_body, "@Deploy Bot"
+    assert_includes message.body.to_s, "Deploy Bot"
+  end
+
+  test "each bot gets command text with only its own mentions stripped" do
+    other_bot = users(:kevin).bots.create!(name: "Build Bot", webhook_url: "https://bots.example.com/build")
+    message = create_message("#{mention(@bot)} restart #{mention(other_bot)}")
+
+    assert_equal "restart @Build Bot", message.plain_text_body_without_mention(@bot)
+    assert_equal "@Deploy Bot restart", message.plain_text_body_without_mention(other_bot)
+  end
+
+  test "rolled back messages do not queue callbacks" do
+    assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+      Message.transaction(requires_new: true) do
+        create_message("#{mention(@bot)} restart")
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+
+  private
+    def mention(bot)
+      ActionText::Attachment.from_attachable(bot).to_html
+    end
+
+    def create_message(body, creator: users(:david))
+      @room.messages.create!(creator:, body: "<div>#{body}</div>")
+    end
+end
