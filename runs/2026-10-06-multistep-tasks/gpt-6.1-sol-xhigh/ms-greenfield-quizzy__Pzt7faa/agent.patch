@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+export RAILS_ENV=production
+export PORT="${PORT:-3000}"
+export BOOTSNAP_CACHE_DIR="${BOOTSNAP_CACHE_DIR:-$PWD/storage/cache/bootsnap}"
+export PIDFILE="$PWD/storage/tmp/pids/server.pid"
+mkdir -p storage/assets storage/log storage/tmp/pids storage/cache
+# Keep generated assets in storage while letting Rails' static server serve /assets.
+if [ ! -e public/assets ] && [ ! -L public/assets ]; then
+  ln -s ../storage/assets public/assets
+fi
+bundle exec rails db:prepare
+bundle exec rails assets:precompile
+exec bundle exec puma -C config/puma.rb
