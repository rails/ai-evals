diff --git a/app/assets/javascripts/application.js b/app/assets/javascripts/application.js
new file mode 100644
index 0000000..e9727e4
--- /dev/null
+++ b/app/assets/javascripts/application.js
@@ -0,0 +1,169 @@
+"use strict";
+
+// Ordinary Rails forms keep their normal navigation and CSRF protection.
+document.addEventListener("submit", (event) => {
+  const message = event.target.dataset.confirm;
+  if (message && !window.confirm(message)) event.preventDefault();
+});
+document.addEventListener("change", (event) => {
+  if (event.target.matches("input[type=checkbox][data-autosubmit]")) {
+    event.target.form.requestSubmit();
+  }
+});
+
+function element(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+
+const questionForm = document.querySelector("[data-question-form]");
+if (questionForm) {
+  const rows = questionForm.querySelector("[data-option-rows]");
+
+  function renumberRows() {
+    rows.querySelectorAll("[data-option-row]").forEach((row, index) => {
+      const number = index + 1;
+      const text = row.querySelector("[data-option-text]");
+      const label = row.querySelector("[data-option-label]");
+      text.id = `option_${number}_text`;
+      text.name = `question[option_rows][${index}][text]`;
+      text.placeholder = `Option ${number}`;
+      label.htmlFor = text.id;
+      label.textContent = `Option ${number}`;
+      const correct = row.querySelector("[data-option-correct]");
+      correct.id = `option_${number}_correct`;
+      correct.name = `question[option_rows][${index}][correct]`;
+      correct.setAttribute("aria-label", `Option ${number} is correct`);
+      row.querySelector("[data-correct-label]").htmlFor = correct.id;
+      row.querySelector("[data-option-unchecked]").name = correct.name;
+      const remove = row.querySelector("[data-remove-option]");
+      remove.setAttribute("aria-label", `Remove option ${number}`);
+      remove.title = `Remove option ${number}`;
+    });
+  }
+
+  questionForm.querySelector("[data-add-option]").addEventListener("click", () => {
+    const row = element("div", "option-row");
+    row.dataset.optionRow = "";
+    const textContainer = element("div", "option-row__text");
+    const label = element("label", "visually-hidden");
+    label.dataset.optionLabel = "";
+    const input = element("input", "input");
+    input.type = "text";
+    input.dataset.optionText = "";
+    textContainer.append(label, input);
+    const correctLabel = element("label", "checkbox");
+    correctLabel.dataset.correctLabel = "";
+    const unchecked = element("input");
+    unchecked.type = "hidden";
+    unchecked.value = "0";
+    unchecked.dataset.optionUnchecked = "";
+    const correct = element("input");
+    correct.type = "checkbox";
+    correct.value = "1";
+    correct.dataset.optionCorrect = "";
+    correctLabel.append(unchecked, correct, document.createTextNode(" Correct"));
+    const remove = element("button", "btn btn--danger btn--icon", "✕");
+    remove.type = "button";
+    remove.dataset.removeOption = "";
+    row.append(textContainer, correctLabel, remove);
+    rows.append(row);
+    renumberRows();
+    input.focus();
+  });
+
+  rows.addEventListener("click", (event) => {
+    const remove = event.target.closest("[data-remove-option]");
+    if (!remove) return;
+    remove.closest("[data-option-row]").remove();
+    renumberRows();
+  });
+}
+
+// A preview is a snapshot of the active questions. All answer/score state lives
+// only in these variables: no requests, cookies, or browser storage are used.
+const preview = document.querySelector("[data-preview]");
+if (preview) {
+  const questions = JSON.parse(document.getElementById("preview-data").textContent);
+  const stage = document.getElementById("preview-stage");
+  let index = 0;
+  let score = 0;
+  let answered = false;
+
+  function letter(index) {
+    let result = "";
+    let number = index + 1;
+    while (number > 0) {
+      number -= 1;
+      result = String.fromCharCode(65 + number % 26) + result;
+      number = Math.floor(number / 26);
+    }
+    return result;
+  }
+
+  function renderQuestion() {
+    stage.replaceChildren();
+    answered = false;
+    if (questions.length === 0) {
+      stage.append(element("h1", "play-title", "No active questions"));
+      stage.append(element("p", "play-lead", "Add a question or turn on Active to try this quiz."));
+      return;
+    }
+    const question = questions[index];
+    stage.append(element("div", "play-question__num", `Question ${index + 1} of ${questions.length}`));
+    const heading = element("h1", "play-question__body", question.body);
+    stage.append(heading);
+    const choices = element("div", "play-options");
+    const buttons = question.options.map((option, optionIndex) => {
+      const button = element("button", "play-option");
+      button.type = "button";
+      button.setAttribute("aria-label", option.text);
+      button.append(element("span", "play-option__letter", letter(optionIndex)));
+      button.append(element("span", "play-option__title", option.text));
+      button.addEventListener("click", () => {
+        if (answered) return;
+        answered = true;
+        if (option.correct) score += 1;
+        choices.classList.add("is-locked", "is-revealed");
+        button.classList.add("is-picked");
+        buttons.forEach((choice, i) => {
+          choice.disabled = true;
+          if (question.options[i].correct) {
+            choice.classList.add("is-correct");
+            choice.append(element("span", "play-option__mark", "✓ Correct"));
+          }
+        });
+        const status = element("div", `play-status ${option.correct ? "play-status--correct" : "play-status--wrong"}`, option.correct ? "Correct!" : "Wrong!");
+        status.setAttribute("role", "status");
+        stage.append(status);
+        const last = index === questions.length - 1;
+        const next = element("button", "btn btn--pink preview-next", last ? "See score" : "Next question");
+        next.type = "button";
+        next.addEventListener("click", () => {
+          if (last) {
+            stage.replaceChildren();
+            stage.append(element("div", "play-question__num", "Preview complete"));
+            stage.append(element("h1", "play-title", `Score: ${score}/${questions.length}`));
+            stage.append(element("p", "play-lead", "Give it another go, or head back to your quiz."));
+          } else {
+            index += 1;
+            renderQuestion();
+          }
+        }, { once: true });
+        stage.append(next);
+      });
+      choices.append(button);
+      return button;
+    });
+    stage.append(choices);
+  }
+
+  preview.querySelector("[data-start-over]").addEventListener("click", () => {
+    index = 0;
+    score = 0;
+    renderQuestion();
+  });
+  renderQuestion();
+}
diff --git a/app/assets/javascripts/live_game.js b/app/assets/javascripts/live_game.js
new file mode 100644
index 0000000..6472a72
--- /dev/null
+++ b/app/assets/javascripts/live_game.js
@@ -0,0 +1,271 @@
+"use strict";
+(() => {
+  const root = document.querySelector("[data-live-game]");
+  if (!root) return;
+  const role = root.dataset.role;
+  const stage = root.querySelector("[data-stage]");
+  const status = root.querySelector("[data-connection]");
+  const error = root.querySelector("[data-live-error]");
+  const control = root.querySelector("[data-game-control]");
+  const lobby = root.querySelector("[data-lobby]");
+  const joinPanel = root.querySelector("[data-join-panel]");
+  const winnerControls = root.querySelector("[data-winners-controls]");
+  const timerPanel = role === "moderator" ? root.querySelector("[data-timer-panel]") : null;
+  const countdown = timerPanel?.querySelector("[data-countdown]");
+  let timerEnd;
+  let playerId;
+  let state, selection, lastSignature, connected = false, busy = false;
+  let answerQueue = Promise.resolve();
+  let pendingPicks = 0;
+
+  function node(tag, className, text) {
+    const el = document.createElement(tag);
+    if (className) el.className = className;
+    if (text !== undefined) el.textContent = text;
+    return el;
+  }
+
+  function optionLetter(index) {
+    let number = index + 1, result = "";
+    while (number > 0) {
+      number--;
+      result = String.fromCharCode(65 + number % 26) + result;
+      number = Math.floor(number / 26);
+    }
+    return result;
+  }
+
+  function renderCountdown() {
+    if (!timerPanel) return;
+    timerPanel.hidden = state?.phase !== "open" || !state?.timer;
+    if (timerPanel.hidden) return;
+    // Use server time and a monotonic local clock, not the phone/laptop wall clock.
+    const seconds = Math.max(0, Math.ceil((timerEnd - performance.now()) / 1000));
+    countdown.textContent = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
+  }
+
+  function render() {
+    if (!state) return;
+    renderCountdown();
+    if (lobby) lobby.hidden = state.phase !== "waiting";
+    if (joinPanel) joinPanel.hidden = state.phase === "ended";
+    if (control) {
+      control.hidden = state.phase === "ended";
+      control.elements.phase.value = state.phase;
+      control.elements.revision.value = state.revision;
+      control.elements.question_id.value = state.question?.id || "";
+      const button = control.querySelector("button");
+      button.textContent = state.phase === "waiting" ? "Start" : state.phase === "open" ? "Finish" : state.question?.last ? "End quiz" : "Next";
+      button.disabled = busy;
+    }
+    if (winnerControls) {
+      winnerControls.hidden = state.phase !== "ended";
+      winnerControls.querySelectorAll("button").forEach(button => { button.disabled = busy; });
+    }
+    // Counter-only events don't replace buttons or steal keyboard focus.
+    const signature = JSON.stringify([state.phase, state.question, selection?.question_id, selection?.option_id, state.leaderboard, playerId]);
+    if (signature !== lastSignature) {
+      lastSignature = signature;
+      const focusedOption = document.activeElement?.dataset.pick;
+      stage.replaceChildren();
+      if (state.phase === "ended") {
+        const section = node("section", "card live-ended");
+        section.append(node("span", "eyebrow", "Thanks for playing"), node("h2", "", "The quiz is over"));
+        const board = state.leaderboard || [];
+        if (role === "player") {
+          const result = board.find(row => row.id === playerId);
+          if (result) {
+            section.append(node("p", "live-place", `Place ${result.place} of ${board.length}`));
+            section.append(node("p", "live-points", `${result.points} ${result.points === 1 ? "point" : "points"}`));
+            if (result.winner) {
+              const won = node("p", "live-won", "You won!");
+              won.setAttribute("role", "status");
+              section.append(won);
+            }
+          }
+        }
+        stage.append(section);
+        if (role === "moderator") {
+          stage.append(node("h2", "live-leaderboard-heading", "Leaderboard"));
+          if (!board.length) stage.append(node("p", "empty", "No players joined this game."));
+          const list = node("ol", "live-leaderboard");
+          list.setAttribute("aria-label", "Leaderboard");
+          list.setAttribute("aria-live", "polite");
+          board.forEach(row => {
+            const item = node("li", `card live-leaderboard-row${row.winner ? " is-winner" : ""}`);
+            item.dataset.playerId = row.id;
+            const rank = node("span", "live-rank", row.place);
+            rank.setAttribute("aria-label", `Place ${row.place}`);
+            item.append(rank, node("span", "live-player-name", row.name), node("span", "live-points", `${row.points} ${row.points === 1 ? "point" : "points"}`));
+            if (row.winner) item.append(node("span", "live-winner-mark", "Winner"));
+            list.append(item);
+          });
+          stage.append(list);
+        }
+      } else if (role === "guest") {
+        // Guests only see signup until they have a server-issued identity.
+      } else if (state.phase === "waiting") {
+        if (role === "moderator") {
+          const counter = node("p", "live-counter");
+          counter.dataset.players = "";
+          stage.append(counter);
+        } else {
+          const waiting = node("section", "card live-waiting");
+          waiting.append(node("span", "waiting-dot"), node("h2", "", "You're in!"), node("p", "", "Waiting for the quiz to start…"));
+          stage.append(waiting);
+        }
+      } else {
+        const q = state.question;
+        const closed = state.phase === "closed";
+        const head = node("div", "live-question-head");
+        head.append(node("span", "eyebrow", `Question ${q.number} of ${q.total}`));
+        if (role === "moderator") {
+          const counter = node("span", "live-counter");
+          counter.dataset.answers = "";
+          head.append(counter);
+        }
+        stage.append(head, node("h2", "live-question-text", q.body));
+        const options = node("ul", "live-options");
+        q.options.forEach((option, index) => {
+          const chosen = selection?.question_id === q.id && selection?.option_id === option.id;
+          const li = node("li");
+          const choice = node(role === "player" ? "button" : "div", `live-option${chosen ? " is-selected" : ""}${closed && option.correct ? " is-correct" : ""}${closed && chosen && !option.correct ? " is-wrong" : ""}`);
+          if (role === "player") {
+            choice.type = "button";
+            choice.disabled = closed;
+            choice.dataset.pick = option.id;
+            choice.dataset.question = q.id;
+            choice.setAttribute("aria-pressed", String(chosen));
+            choice.setAttribute("aria-label", option.text);
+          }
+          const letter = node("span", "live-option-letter", optionLetter(index));
+          letter.setAttribute("aria-hidden", "true");
+          const marks = node("span", "live-option-marks");
+          if (chosen) marks.append(node("span", "live-mark", "Your answer"));
+          if (closed && option.correct) marks.append(node("span", "live-mark", "Correct"));
+          if (closed && role === "moderator") marks.append(node("span", "live-tally", `${option.answers} ${option.answers === 1 ? "answer" : "answers"}`));
+          choice.append(letter, node("span", "live-option-text", option.text), marks);
+          li.append(choice);
+          options.append(li);
+        });
+        stage.append(options);
+        if (role === "player" && closed) {
+          const picked = q.options.find(option => selection?.question_id === q.id && option.id === selection?.option_id);
+          const feedback = node("p", `live-feedback${picked ? picked.correct ? " is-correct" : " is-wrong" : ""}`, picked ? picked.correct ? "Correct!" : "Wrong!" : "No answer");
+          feedback.setAttribute("role", "status");
+          stage.append(feedback);
+        } else if (role === "player") {
+          stage.append(node("p", "meta live-help", "Tap an option. You can change your answer until the question closes."));
+        }
+      }
+      if (focusedOption) stage.querySelector(`[data-pick="${focusedOption}"]:not(:disabled)`)?.focus();
+    }
+    const players = stage.querySelector("[data-players]");
+    if (players) players.textContent = `Players: ${state.players}`;
+    const answers = stage.querySelector("[data-answers]");
+    if (answers) answers.textContent = `Answers: ${state.answered} / ${state.players}`;
+  }
+
+  function receive(message) {
+    if (message.type === "unavailable") {
+      error.textContent = "This game is no longer available.";
+      return;
+    }
+    if (message.counters && state && message.counters.revision >= state.revision) {
+      if (message.counters.phase === state.phase && message.counters.question_id === (state.question?.id || null)) {
+        Object.assign(state, message.counters);
+      } else {
+        // Concurrent commits can deliver counters ahead of a phase frame.
+        subscription.perform("refresh");
+      }
+    }
+    if (Object.prototype.hasOwnProperty.call(message, "player_id")) playerId = message.player_id;
+    if (message.state && (!state || message.state.revision >= state.revision)) {
+      state = message.state;
+      if (state.timer) timerEnd = performance.now() + state.timer.deadline_ms - state.timer.server_now_ms;
+    }
+    if (message.selection && (!selection || message.selection.revision >= selection.revision)) selection = message.selection;
+    render();
+  }
+
+  async function post(url, data) {
+    const response = await fetch(url, {
+      method: "POST", credentials: "same-origin", cache: "no-store",
+      headers: { "Content-Type": "application/json", Accept: "application/json", "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content },
+      body: JSON.stringify(data)
+    });
+    const payload = await response.json();
+    receive(payload);
+    if (!response.ok) throw new Error(payload.error || "Could not save. Please try again.");
+    return payload;
+  }
+
+  root.addEventListener("click", event => {
+    const button = event.target.closest("[data-pick]");
+    if (!button || button.disabled) return;
+    const pick = { question_id: Number(button.dataset.question), option_id: Number(button.dataset.pick) };
+    // Serialize rapid picks so the last tap is always the last server write.
+    pendingPicks++;
+    status.textContent = "Saving answer…";
+    answerQueue = answerQueue.then(async () => {
+      error.textContent = "";
+      try { await post(root.dataset.answerUrl, pick); }
+      catch (e) { error.textContent = e.message === "Failed to fetch" ? "Answer not saved. Check your connection and tap again." : e.message; }
+      finally {
+        pendingPicks--;
+        if (!pendingPicks) status.textContent = connected ? "Live" : "Reconnecting…";
+      }
+    });
+  });
+
+  control?.addEventListener("submit", async event => {
+    event.preventDefault();
+    if (busy) return;
+    busy = true;
+    error.textContent = "";
+    const data = { phase: state.phase, revision: state.revision, question_id: state.question?.id };
+    render();
+    try { await post(root.dataset.controlUrl, data); }
+    catch (e) { error.textContent = e.message === "Failed to fetch" ? "Connection lost. Please try again." : e.message; }
+    finally { busy = false; render(); }
+  });
+
+  winnerControls?.addEventListener("submit", async event => {
+    const form = event.target.closest("[data-winners-control]");
+    if (!form) return;
+    event.preventDefault();
+    if (busy) return;
+    busy = true;
+    error.textContent = "";
+    render();
+    try { await post(root.dataset.winnersUrl, { strategy: form.elements.strategy.value }); }
+    catch (e) { error.textContent = e.message === "Failed to fetch" ? "Connection lost. Please try again." : e.message; }
+    finally { busy = false; render(); }
+  });
