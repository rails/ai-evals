diff --git a/app/channels/game_channel.rb b/app/channels/game_channel.rb
new file mode 100644
index 0000000..d10258b
--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,41 @@
+class GameChannel < ApplicationCable::Channel
+  def subscribed
+    claims = GameTicket.read(params[:ticket])
+    return reject unless claims
+    @game = Game.find_by(id: claims["game_id"])
+    return reject unless @game
+    @player = @game.players.find_by(id: claims["player_id"]) if claims["player_id"]
+    return reject if claims["player_id"] && !@player
+
+    @moderator = claims["moderator"] == true
+    stream_from "game:#{@game.id}#{':moderator' if @moderator}"
+    stream_from "player:#{@player.id}" if @player
+    @presence_id = SecureRandom.uuid
+    if @player && GamePresence.add(@game.id, @player.id, @presence_id)
+      @game.presence_changed!
+    end
+    transmit @game.client_snapshot(@player, moderator: @moderator)
+  end
+
+  def heartbeat
+    if @player && GamePresence.add(@game.id, @player.id, @presence_id)
+      @game.presence_changed!
+      transmit @game.client_snapshot(@player, moderator: @moderator)
+    end
+  rescue ActiveRecord::RecordNotFound
+    transmit({ type: "unavailable" })
+  end
+
+  def refresh
+    heartbeat
+    transmit @game.client_snapshot(@player, moderator: @moderator) if @game
+  rescue ActiveRecord::RecordNotFound
+    transmit({ type: "unavailable" })
+  end
+
+  def unsubscribed
+    if @player && GamePresence.remove(@game.id, @player.id, @presence_id)
+      @game.presence_changed!
+    end
+  end
+end
