+  receive(JSON.parse(root.querySelector("[data-game-snapshot]").textContent));
+  const consumer = ActionCable.createConsumer("/cable");
+  const subscription = consumer.subscriptions.create({ channel: "GameChannel", ticket: root.dataset.ticket }, {
+    connected() {
+      connected = true;
+      if (!pendingPicks) status.textContent = "Live";
+      // A reconnect is a fresh consistent snapshot, not a replay of missed events.
+      this.perform("refresh");
+    },
+    disconnected() { connected = false; status.textContent = "Reconnecting…"; },
