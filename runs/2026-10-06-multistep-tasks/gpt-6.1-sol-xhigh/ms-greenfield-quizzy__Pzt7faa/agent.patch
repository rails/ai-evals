@@ -0,0 +1,13 @@
+class GameTicket
+  def self.issue(game, player = nil, moderator: false)
+    verifier.generate({ "game_id" => game.id, "player_id" => player&.id, "moderator" => moderator }, purpose: "live-game", expires_in: 2.days)
+  end
+
+  def self.read(ticket)
+    verifier.verified(ticket, purpose: "live-game")
+  end
+
+  def self.verifier
+    Rails.application.message_verifier("game-subscription")
+  end
+end
diff --git a/app/services/game_timer.rb b/app/services/game_timer.rb
new file mode 100644
index 0000000..bf9103a
--- /dev/null
+++ b/app/services/game_timer.rb
@@ -0,0 +1,11 @@
+# A durable deadline, not a browser or an in-memory delayed job, is the source
+# of truth. Sweep even when no sockets are open and recover after server restarts.
+class GameTimer
+  def self.start
+    @timer ||= ActionCable.server.event_loop.timer(0.25) do
+      Rails.application.executor.wrap { Game.expire_due! }
+    rescue StandardError => error
+      Rails.logger.error("Game timer sweep failed: #{error.class}: #{error.message}")
+    end
+  end
+end
diff --git a/app/services/quiz_transfer.rb b/app/services/quiz_transfer.rb
new file mode 100644
index 0000000..bef7cfd
--- /dev/null
+++ b/app/services/quiz_transfer.rb
@@ -0,0 +1,87 @@
+# This format intentionally carries content only, never IDs or runtime state.
+class QuizTransfer
+  class Invalid < StandardError; end
+
+  class << self
+    def export(quiz)
+      JSON.pretty_generate({
+        title: quiz.title,
+        number_of_winners: quiz.number_of_winners,
+        questions: quiz.questions.includes(:options).map do |question|
+          {
+            text: question.body,
+            active: question.active?,
+            options: question.options.map do |option|
+              { text: option.text, correct: option.correct? }
+            end
+          }
+        end
+      })
+    end
+
+    def import(source)
+      require_type!(source, String, "Quiz JSON", "text")
+      data = JSON.parse(source)
+      require_type!(data, Hash, "Quiz", "an object")
+      require_type!(data["title"], String, "Quiz title", "text")
+      require_type!(data["questions"], Array, "Quiz questions", "an array")
+
+      winners = data.fetch("number_of_winners", 3)
+      require_type!(winners, Integer, "Number of winners", "a whole number")
+      quiz = Quiz.new(title: data["title"], number_of_winners: winners)
+      validate!(quiz, "Quiz")
+      data["questions"].each_with_index do |question_data, index|
+        context = "Question #{index + 1}"
+        require_type!(question_data, Hash, context, "an object")
+        require_type!(question_data["text"], String, "#{context} text", "text")
+        require_type!(question_data["options"], Array, "#{context} options", "an array")
+        question = quiz.questions.build(
+          body: question_data["text"],
+          active: boolean!(question_data, "active", true, context),
+          position: index + 1
+        )
+        rows = question_data["options"].each_with_index.map do |option_data, option_index|
+          option_context = "#{context}, option #{option_index + 1}"
+          require_type!(option_data, Hash, option_context, "an object")
+          require_type!(option_data["text"], String, "#{option_context} text", "text")
+          { "text" => option_data["text"], "correct" => boolean!(option_data, "correct", false, option_context) }
+        end
+        # Reuse the form's blank-row handling and model validation, not a second
+        # implementation of the question rules.
+        question.replace_options(rows)
+        validate!(question, context)
+      end
+
+      # Saving a new quiz autosaves its new questions and their options. Keep the
+      # entire graph in one transaction, including any failure during persistence.
+      Quiz.transaction { quiz.save! }
+      quiz
+    rescue JSON::ParserError
+      raise Invalid, "Invalid JSON. Paste a complete quiz JSON object and try again."
+    rescue ActiveRecord::RecordInvalid => error
+      raise Invalid, "Quiz could not be imported: #{error.record.errors.full_messages.join('; ')}"
+    end
+
+    private
+
+    def require_type!(value, type, context, description)
+      raise Invalid, "#{context} must be #{description}." unless value.is_a?(type)
+    end
+
+    def boolean!(data, key, default, context)
+      return default unless data.key?(key)
+
+      value = data[key]
+      unless value == true || value == false
+        raise Invalid, "#{context} #{key} must be true or false."
+      end
+      value
+    end
+
+    def validate!(record, context)
+      unless record.valid?
+        raise Invalid, "#{context}: #{record.errors.full_messages.join('; ')}"
+      end
+    end
+  end
+end
diff --git a/app/views/games/_stage.html.erb b/app/views/games/_stage.html.erb
new file mode 100644
index 0000000..3a84543
--- /dev/null
+++ b/app/views/games/_stage.html.erb
@@ -0,0 +1,57 @@
+<% state = @snapshot[:state]; question = state[:question]; selection = @snapshot[:selection]; closed = state[:phase] == "closed" %>
+<% if state[:phase] == "ended" %>
+  <section class="card live-ended">
+    <span class="eyebrow">Thanks for playing</span><h2>The quiz is over</h2>
+    <% if role == "player" %>
+      <% result = state[:leaderboard].find { |row| row[:id] == @snapshot[:player_id] } %>
+      <% if result %>
+        <p class="live-place">Place <%= result[:place] %> of <%= state[:leaderboard].size %></p>
+        <p class="live-points"><%= pluralize(result[:points], "point") %></p>
+        <% if result[:winner] %><p class="live-won" role="status">You won!</p><% end %>
+      <% end %>
+    <% end %>
+  </section>
+  <% if role == "moderator" %>
+    <h2 class="live-leaderboard-heading">Leaderboard</h2>
+    <% if state[:leaderboard].empty? %><p class="empty">No players joined this game.</p><% end %>
+    <ol class="live-leaderboard" aria-label="Leaderboard" aria-live="polite">
+      <% state[:leaderboard].each do |row| %>
+        <li class="card live-leaderboard-row <%= 'is-winner' if row[:winner] %>" data-player-id="<%= row[:id] %>">
+          <span class="live-rank" aria-label="Place <%= row[:place] %>"><%= row[:place] %></span>
+          <span class="live-player-name"><%= row[:name] %></span>
+          <span class="live-points"><%= pluralize(row[:points], "point") %></span>
+          <% if row[:winner] %><span class="live-winner-mark">Winner</span><% end %>
+        </li>
+      <% end %>
+    </ol>
+  <% end %>
+<% elsif role == "guest" %>
+<% elsif state[:phase] == "waiting" %>
+  <% if role == "moderator" %><p class="live-counter" data-players>Players: <%= state[:players] %></p>
+  <% else %><section class="card live-waiting"><span class="waiting-dot" aria-hidden="true"></span><h2>You're in!</h2><p>Waiting for the quiz to start…</p></section><% end %>
+<% else %>
+  <div class="live-question-head"><span class="eyebrow">Question <%= question[:number] %> of <%= question[:total] %></span>
+    <% if role == "moderator" %><span class="live-counter" data-answers>Answers: <%= state[:answered] %> / <%= state[:players] %></span><% end %>
+  </div>
+  <h2 class="live-question-text"><%= question[:body] %></h2>
+  <ul class="live-options">
+    <% question[:options].each_with_index do |option, index| %>
+      <% chosen = selection[:option_id] == option["id"] && selection[:question_id] == question[:id] %>
+      <li>
+        <% tag_name = role == "player" ? :button : :div %>
+        <%= content_tag tag_name, class: "live-option #{'is-selected' if chosen} #{'is-correct' if closed && option['correct']} #{'is-wrong' if chosen && closed && !option['correct']}", **(role == "player" ? { type: "button", disabled: closed, data: { pick: option['id'], question: question[:id] }, aria: { pressed: chosen, label: option["text"] } } : {}) do %>
+          <span class="live-option-letter" aria-hidden="true"><%= option_letter(index) %></span><span class="live-option-text"><%= option['text'] %></span>
+          <span class="live-option-marks">
+            <% if chosen %><span class="live-mark">Your answer</span><% end %>
+            <% if closed && option['correct'] %><span class="live-mark">Correct</span><% end %>
+            <% if closed && role == 'moderator' %><span class="live-tally"><%= option['answers'] %> <%= option['answers'] == 1 ? 'answer' : 'answers' %></span><% end %>
+          </span>
+        <% end %>
+      </li>
+    <% end %>
+  </ul>
+  <% if role == 'player' && closed %>
+    <% picked = question[:options].find { |option| chosen_id = selection[:question_id] == question[:id] && selection[:option_id]; option['id'] == chosen_id } %>
+    <p class="live-feedback <%= picked ? picked['correct'] ? 'is-correct' : 'is-wrong' : '' %>" role="status"><%= picked ? picked['correct'] ? 'Correct!' : 'Wrong!' : 'No answer' %></p>
+  <% elsif role == 'player' %><p class="meta live-help">Tap an option. You can change your answer until the question closes.</p><% end %>
+<% end %>
