+<% content_for :title, @game.title %>
+<%= javascript_include_tag "actioncable", "live_game", defer: true %>
+<div class="breadcrumbs"><%= link_to "← Back to quiz", moderate_quiz_path(@game.quiz) %></div>
+<div class="live-screen" data-live-game data-role="moderator" data-ticket="<%= @ticket %>" data-winners-url="<%= winners_moderate_game_path(@game) %>" data-control-url="<%= advance_moderate_game_path(@game) %>" data-state-url="<%= state_moderate_game_path(@game) %>">
+  <div class="live-topline"><span class="badge">Live game · <%= @game.code %></span><span class="live-connection" data-connection role="status">Connecting…</span></div>
+  <h1 class="live-title"><%= @game.title %></h1>
+  <section class="live-lobby card" data-lobby <%= 'hidden' unless @game.phase == 'waiting' %>>
+    <div><span class="eyebrow">Join on your phone</span><p class="live-join-url" data-join-url><%= @join_url %></p><p class="meta">Scan the code or open the link. No account needed.</p></div>
+    <div class="live-qr" role="img" aria-label="QR code to join the game"><%= raw @qr %></div>
+  </section>
+  <p class="live-timer" data-timer-panel <%= 'hidden' unless @snapshot[:state][:timer] %>>
+    <span class="eyebrow">Time remaining</span>
+    <span data-countdown role="timer" aria-label="Time remaining"><%= countdown_text(@game.question_closes_at) if @snapshot[:state][:timer] %></span>
+  </p>
+  <div data-stage><%= render "games/stage", role: "moderator" %></div>
+  <p class="live-error" data-live-error role="alert"></p>
+  <%= form_with url: advance_moderate_game_path(@game), local: true, data: { game_control: true }, html: { hidden: @game.phase == "ended" } do %>
+    <%= hidden_field_tag :phase, @game.phase %>
+    <%= hidden_field_tag :revision, @game.revision %>
+    <%= hidden_field_tag :question_id, @game.current_question&.fetch("id") %>
+    <button type="submit" class="btn btn--pink live-control"><%= @game.phase == "waiting" ? "Start" : @game.phase == "open" ? "Finish" : @game.question_index.to_i + 1 == @game.question_snapshot.size ? "End quiz" : "Next" %></button>
+  <% end %>
+  <div class="buttons live-prize-controls" data-winners-controls <%= 'hidden' unless @game.phase == 'ended' %>>
+    <% [ ["top", "Top #{@game.number_of_winners}"], ["draw", "Draw"], ["reset", "Reset winners"] ].each do |strategy, label| %>
+      <%= form_with url: winners_moderate_game_path(@game), local: true, data: { winners_control: true } do %>
+        <%= hidden_field_tag :strategy, strategy %>
+        <%= button_tag label, type: "submit", class: strategy == "top" ? "btn btn--pink" : "btn btn--ghost" %>
+      <% end %>
+    <% end %>
+  </div>
+  <script type="application/json" data-game-snapshot><%= raw json_escape(@snapshot.to_json) %></script>
+</div>
