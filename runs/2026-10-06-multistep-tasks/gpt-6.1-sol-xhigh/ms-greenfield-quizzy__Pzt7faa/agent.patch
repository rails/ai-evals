diff --git a/test/models/game_prizes_test.rb b/test/models/game_prizes_test.rb
new file mode 100644
index 0000000..8d6e932
--- /dev/null
+++ b/test/models/game_prizes_test.rb
@@ -0,0 +1,195 @@
+require "test_helper"
+
+class GamePrizesTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Prizes", number_of_winners: 2)
+    2.times do |index|
+      @quiz.questions.create!(body: "Question #{index + 1}", position: index + 1,
+        options: [ Option.new(text: "Yes", correct: true, position: 1), Option.new(text: "No", position: 2) ])
+    end
+    @game = Game.create_for!(@quiz)
+    @alice, @bob, @cara, @zero = %w[Alice Bob Cara Zero].map { |name| @game.join!(name) }
+  end
+
+  test "winner count defaults to three and requires a positive integer" do
+    assert_equal 3, Quiz.new.number_of_winners
+    [ nil, 0, -1, 1.5, "nope" ].each do |value|
+      quiz = Quiz.new(title: "Invalid", number_of_winners: value)
+      assert_not quiz.valid?, "Accepted #{value.inspect}"
+      assert quiz.errors[:number_of_winners].any?
+    end
+    assert Quiz.new(title: "Valid", number_of_winners: 1).valid?
+  end
+
+  test "correct answers score once and ties use cumulative last-pick times" do
+    travel_to Time.utc(2026, 10, 9, 12) do
+      advance
+      opened_at = @game.reload.question_opened_at
+      travel 1.second
+      pick(@alice)
+      travel 1.second
+      pick(@bob)
+      travel 3.seconds
+      pick(@alice, correct: false)
+      travel 3.seconds
+      pick(@alice)
+      travel 1.second
+      pick(@alice) # Repeating the same choice is still the last pick.
+      pick(@cara, correct: false)
+      assert_equal 9_000_000, @alice.answers.first.elapsed_microseconds
+      assert_equal opened_at, @game.reload.question_opened_at
+      advance
+      assert_not @game.public_state.key?(:leaderboard)
+      travel 10.seconds
+      advance
+      travel 1.second
+      pick(@alice)
+      pick(@cara)
+      travel 1.second
+      pick(@bob)
+      advance
+      advance
+    end
+    board = @game.reload.leaderboard
+    assert_equal %w[Bob Alice Cara Zero], board.map { |row| row[:name] }
+    assert_equal [ 2, 2, 1, 0 ], board.map { |row| row[:points] }
+    assert_equal [ 1, 2, 3, 4 ], board.map { |row| row[:place] }
+    assert_equal board, @game.public_state[:leaderboard]
+    assert_equal @alice.id, @game.client_snapshot(@alice)[:player_id]
+  end
+
+  test "top winners follow speed but draws ignore speed at the points cutoff" do
+    advance
+    [ @alice, @bob, @cara ].each { |player| pick(player) }
+    advance
+    advance
+    pick(@alice)
+    advance
+    advance
+    @game.choose_winners!("top")
+    assert_equal [ @alice.id, @bob.id ], winner_ids
+    10.times do
+      @game.choose_winners!("draw")
+      assert_equal 2, winner_ids.size
+      assert_includes winner_ids, @alice.id
+      assert_equal 1, (winner_ids & [ @bob.id, @cara.id ]).size
+      assert_not_includes winner_ids, @zero.id
+    end
+    @game.choose_winners!("reset")
+    assert_empty winner_ids
+    assert @game.public_state[:leaderboard].none? { |row| row[:winner] }
+  end
+
+  test "zero points never win even when there are more prizes than scoring players" do
+    @game.update!(number_of_winners: 10)
+    advance
+    pick(@cara)
+    end_game
+    %w[top draw].each do |strategy|
+      @game.choose_winners!(strategy)
+      assert_equal [ @cara.id ], winner_ids
+    end
+  end
+
+  test "an all-zero or empty game has no winners" do
+    end_game
+    %w[top draw reset].each do |strategy|
+      @game.choose_winners!(strategy)
+      assert_empty winner_ids
+    end
+    empty = Game.create_for!(Quiz.create!(title: "Empty"))
+    empty.advance!(expected_phase: "waiting", expected_question: nil)
+    empty.choose_winners!("draw")
+    assert_empty empty.leaderboard
+  end
+
+  test "prize settings are snapshotted and different runs have independent winners" do
+    @quiz.update!(number_of_winners: 1)
+    assert_equal 2, @game.reload.number_of_winners
+    next_game = Game.create_for!(@quiz)
+    assert_equal 1, next_game.number_of_winners
+    advance
+    pick(@alice)
+    end_game
+    @game.choose_winners!("top")
+    assert @alice.reload.winner?
+    assert_empty next_game.players
+  end
+
+  test "winner selection is only allowed after ending and unknown actions are rejected" do
+    assert_raises(Game::InvalidMove) { @game.choose_winners!("top") }
+    end_game
+    assert_raises(Game::InvalidMove) { @game.choose_winners!("anything") }
+    assert_empty winner_ids
+  end
+
+  test "draw fills multiple tied prizes without including lower scores" do
+    @game.update!(number_of_winners: 3)
+    dan, emma = %w[Dan Emma].map { |name| @game.join!(name) }
+    advance
+    [ @alice, @bob, @cara, dan, emma ].each { |player| pick(player) }
+    advance
+    advance
+    pick(@alice)
+    advance
+    advance
+    5.times do
+      @game.choose_winners!("draw")
+      assert_equal 3, winner_ids.size
+      assert_includes winner_ids, @alice.id
+      assert_equal 2, (winner_ids & [ @bob.id, @cara.id, dan.id, emma.id ]).size
+      assert_not_includes winner_ids, @zero.id
+    end
+  end
+
+  test "only correct-answer durations affect speed and late joins start at question opening" do
+    travel_to Time.utc(2026, 10, 9, 12) do
+      advance
+      travel 10.seconds
+      late = @game.join!("Late")
+      pick(late)
+      pick(@alice)
+      assert_equal 10_000_000, late.answers.first.elapsed_microseconds
+      travel 200.seconds
+      pick(@bob, correct: false)
+      advance
+      advance
+      travel 1.second
+      pick(@bob)
+      travel 1.second
+      pick(@cara)
+      advance
+      before = @bob.answers.last.elapsed_microseconds
+      travel 20.seconds
+      question = @game.current_question
+      assert_raises(Game::InvalidMove) do
+        @game.pick!(@bob, question.fetch("id"), question.fetch("options").first.fetch("id"))
+      end
+      assert_equal before, @bob.answers.last.elapsed_microseconds
+      advance
+    end
+    # An exact points/time tie has a stable join-order fallback.
+    assert_equal %w[Bob Cara Alice Late Zero], @game.reload.leaderboard.map { |row| row[:name] }
+  end
+
+  private
+
+  def advance
+    @game.reload
+    @game.advance!(expected_phase: @game.phase, expected_question: @game.current_question&.fetch("id"))
+  end
+
+  def end_game
+    advance until @game.reload.phase == "ended"
+  end
+
+  def pick(player, correct: true)
+    question = @game.reload.current_question
+    option = question.fetch("options").find { |row| row.fetch("correct") == correct }
+    @game.pick!(player, question.fetch("id"), option.fetch("id"))
+  end
+
+  def winner_ids
+    @game.players.where(winner: true).order(:id).pluck(:id)
+  end
+end
diff --git a/test/models/game_timer_test.rb b/test/models/game_timer_test.rb
new file mode 100644
index 0000000..fb433a3
--- /dev/null
+++ b/test/models/game_timer_test.rb
@@ -0,0 +1,149 @@
+require "test_helper"
+
+class GameTimerTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+  setup do
+    @quiz = Quiz.create!(title: "Timed quiz", timer_minutes: 1, timer_seconds: 30)
+    2.times do |index|
+      @quiz.questions.create!(body: "Question #{index + 1}", position: index + 1, options: [
+        Option.new(text: "Yes", correct: true, position: 1), Option.new(text: "No", position: 2)
+      ])
+    end
+    @game = Game.create_for!(@quiz)
+  end
+
+  test "timer duration is snapshotted and the clock starts only when a question opens" do
+    assert_equal 90, @game.time_limit_seconds
+    assert_nil @game.question_opened_at
+    assert_nil @game.question_closes_at
+    @quiz.update!(timer_minutes: 0, timer_seconds: 5)
+    travel_to Time.current.change(usec: 0), with_usec: true do
+      advance
+      assert_equal Time.current, @game.question_opened_at
+      assert_equal 90.seconds.from_now, @game.question_closes_at
+      deadline = @game.question_closes_at
+      travel 30.seconds
+      snapshot = Game.find(@game.id).client_snapshot(moderator: true)
+      assert_equal deadline, @game.reload.question_closes_at
+      timer = snapshot[:state][:timer]
+      assert_equal 60_000, timer[:deadline_ms] - timer[:server_now_ms]
+      assert_equal "open", snapshot[:state][:phase]
+    end
+  end
+
+  test "deadline closes exactly once broadcasts results and does not advance the next question" do
+    advance
+    deadline = @game.question_closes_at
+    revision = @game.revision
+    travel_to deadline - 1.second, with_usec: true do
+      Game.expire_due!
+      assert_equal "open", @game.reload.phase
+    end
+    travel_to deadline, with_usec: true do
+      assert_broadcasts("game:#{@game.id}", 1) { Game.expire_due! }
+      assert_equal "closed", @game.reload.phase
+      assert_equal 0, @game.question_index
+      assert_equal revision + 1, @game.revision
+      assert_nil @game.moderator_state[:timer]
+      assert @game.public_state[:question][:options].first.key?("correct")
+      assert_broadcasts("game:#{@game.id}", 0) { 3.times { Game.expire_due! } }
+      assert_equal revision + 1, @game.reload.revision
+    end
+  end
+
+  test "answers at or after the deadline are rejected and the close is committed" do
+    player = @game.join!("Alice")
+    advance
+    question = @game.current_question
+    ids = question.fetch("options").map { |option| option.fetch("id") }
+    travel_to @game.question_closes_at - 1.second, with_usec: true do
+      @game.pick!(player, question.fetch("id"), ids.first)
+    end
+    travel_to @game.question_closes_at, with_usec: true do
+      assert_raises(Game::InvalidMove) { @game.pick!(player, question.fetch("id"), ids.last) }
+      assert_equal "closed", @game.reload.phase
+      assert_equal ids.first, player.answers.sole.option_key
+      assert_raises(Game::InvalidMove) { @game.pick!(player, question.fetch("id"), ids.last) }
+    end
+  end
+
+  test "Finish remains available early and Next opens a fresh full duration" do
+    advance
+    first_deadline = @game.question_closes_at
+    travel_to first_deadline - 45.seconds, with_usec: true do
+      advance
+      assert_equal "closed", @game.phase
+      advance
+      assert_equal "open", @game.phase
+      assert_equal 1, @game.question_index
+      assert_equal 90.seconds.from_now, @game.question_closes_at
+    end
+    travel_to first_deadline, with_usec: true do
+      Game.expire_due!
+      assert_equal "open", @game.reload.phase
+    end
+    travel_to @game.question_closes_at, with_usec: true do
+      Game.expire_due!
+      assert_equal "closed", @game.reload.phase
+      advance
+      assert_equal "ended", @game.phase
+    end
+  end
+
+  test "a stale Finish at expiry cannot accidentally advance to the next question" do
+    advance
+    travel_to @game.question_closes_at, with_usec: true do
+      assert_raises(Game::InvalidMove) { advance }
+      assert_equal "closed", @game.reload.phase
+      assert_equal 0, @game.question_index
+    end
+  end
+
+  test "snapshot reads recover overdue questions even before the worker sweeps" do
+    advance
+    travel_to @game.question_closes_at + 2.minutes, with_usec: true do
+      state = Game.find(@game.id).client_snapshot(moderator: true)[:state]
+      assert_equal "closed", state[:phase]
+      assert_nil state[:timer]
+      assert_equal "closed", @game.reload.phase
+    end
+  end
+
+  test "zero minutes and seconds disable all automatic closing" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    @game = Game.create_for!(@quiz)
+    advance
+    assert_nil @game.question_closes_at
+    assert_nil @game.client_snapshot(moderator: true)[:state][:timer]
+    travel 2.days do
+      Game.expire_due!
+      assert_equal "open", @game.reload.phase
+      advance
+      assert_equal "closed", @game.phase
+    end
+  end
+
+  test "empty and inactive-only quizzes do not start a timer" do
+    @quiz.questions.update_all(active: false)
+    @game = Game.create_for!(@quiz)
+    advance
+    assert_equal "ended", @game.phase
+    assert_nil @game.question_closes_at
+    assert_nil @game.question_opened_at
+  end
+
+  test "timer settings never enter the transfer format and imports use zero" do
+    data = JSON.parse(QuizTransfer.export(@quiz))
+    assert_equal %w[number_of_winners questions title], data.keys.sort
+    restored = QuizTransfer.import(JSON.generate(data.merge(timer_minutes: 2, timer_seconds: 5)))
+    assert_equal 0, restored.timer_minutes
+    assert_equal 0, restored.timer_seconds
+    assert_equal 0, restored.time_limit_seconds
+  end
+
+  private
+
+    def advance
+      @game.advance!(expected_phase: @game.phase, expected_question: @game.current_question&.fetch("id"))
+    end
+end
