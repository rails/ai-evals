+module ApplicationHelper
+  def countdown_text(deadline)
+    remaining = [ (deadline - Time.current).ceil, 0 ].max
+    "#{remaining / 60}:#{format('%02d', remaining % 60)}"
+  end
+
+  def option_letter(index)
+    # Spreadsheet-style labels remain meaningful even beyond 26 options.
+    number = index + 1
+    result = String.new
+    while number.positive?
+      number, remainder = (number - 1).divmod(26)
+      result.prepend((65 + remainder).chr)
+    end
+    result
+  end
+end
