+  class QuestionsController < BaseController
+    before_action :set_quiz
+    before_action :set_question, only: [ :edit, :update, :destroy, :move_up, :move_down, :toggle_active ]
+
+    def new
+      @question = @quiz.questions.build
+      @option_rows = Array.new(4) { { "text" => "", "correct" => false } }
+    end
+
+    def create
+      @question = @quiz.questions.build(question_params.except(:option_rows))
+      @option_rows = submitted_rows
+      @question.replace_options(@option_rows)
+      saved = @quiz.with_lock do
+        @question.position = (@quiz.questions.maximum(:position) || 0) + 1
+        @question.save
+      end
+      if saved
+        return_to_quiz("Question added")
+      else
+        render :new, status: :unprocessable_content
+      end
+    end
+
+    def edit
+      @option_rows = @question.options.map { |option| { "text" => option.text, "correct" => option.correct? } }
+      @option_rows << { "text" => "", "correct" => false } while @option_rows.size < 4
+    end
+
+    def update
+      @question.assign_attributes(question_params.except(:option_rows))
+      @option_rows = submitted_rows
+      @question.replace_options(@option_rows)
+      if @question.save
+        return_to_quiz("Question saved")
+      else
+        render :edit, status: :unprocessable_content
+      end
+    end
+
+    def destroy
+      @question.destroy!
+      redirect_to moderate_quiz_path(@quiz), notice: "Question deleted", status: :see_other
+    end
+
+    def move_up
+      @question.move!(-1)
+      return_to_quiz
+    end
+
+    def move_down
+      @question.move!(1)
+      return_to_quiz
+    end
+
+    def toggle_active
+      @question.update!(active: params.require(:question).permit(:active).fetch(:active))
+      return_to_quiz
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_question
+      @question = @quiz.questions.find(params[:id])
+    end
+
+    def question_params
+      params.require(:question).permit(:body, :active, option_rows: [ :text, :correct ])
+    end
+
+    def submitted_rows
+      (question_params[:option_rows] || {}).values.map(&:to_h)
+    end
+
+    def return_to_quiz(notice = nil)
+      redirect_to moderate_quiz_path(@quiz, anchor: "question_#{@question.id}"), notice: notice, status: :see_other
+    end
+  end
+end
