diff --git a/app/controllers/moderate/base_controller.rb b/app/controllers/moderate/base_controller.rb
new file mode 100644
index 0000000..5118de2
--- /dev/null
+++ b/app/controllers/moderate/base_controller.rb
@@ -0,0 +1,26 @@
+module Moderate
+  class BaseController < ApplicationController
+    before_action :disable_page_caching
+    before_action :require_moderator
+
+    private
+
+    def require_moderator
+      authenticate_or_request_with_http_basic("Quizzy Moderator") do |username, password|
+        expected_username = ENV["QUIZZY_MODERATOR_USERNAME"]
+        expected_password = ENV["QUIZZY_MODERATOR_PASSWORD"]
+        if expected_username.present? && expected_password.present?
+          user_matches = ActiveSupport::SecurityUtils.secure_compare(username.to_s, expected_username)
+          password_matches = ActiveSupport::SecurityUtils.secure_compare(password.to_s, expected_password)
+          user_matches & password_matches
+        else
+          false
+        end
+      end
+    end
+
+    def disable_page_caching
+      response.headers["Cache-Control"] = "no-store"
+    end
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..700eb13
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,53 @@
+module Moderate
+  class GamesController < BaseController
+    before_action :set_game, except: :create
+
+    def create
+      game = Game.create_for!(Quiz.find(params[:quiz_id]))
+      redirect_to moderate_game_path(game), status: :see_other
+    end
+
+    def show
+      @snapshot = @game.client_snapshot(moderator: true)
+      @ticket = GameTicket.issue(@game, moderator: true)
+      @join_url = play_url(@game.code)
+      @qr = RQRCode::QRCode.new(@join_url).as_svg(module_size: 5, standalone: true, use_path: true)
+    end
+
+    def state
+      render json: @game.client_snapshot(moderator: true)
+    end
+
+    def advance
+      @game.advance!(expected_phase: params[:phase], expected_question: params[:question_id])
+      respond_to do |format|
+        format.json { render json: @game.client_snapshot(moderator: true) }
+        format.html { redirect_to moderate_game_path(@game), status: :see_other }
+      end
+    rescue Game::InvalidMove => error
+      respond_to do |format|
+        format.json { render json: @game.client_snapshot(moderator: true).merge(error: error.message), status: :conflict }
+        format.html { redirect_to moderate_game_path(@game), alert: error.message, status: :see_other }
+      end
+    end
+
+    def winners
+      @game.choose_winners!(params[:strategy])
+      respond_to do |format|
+        format.json { render json: @game.client_snapshot(moderator: true) }
+        format.html { redirect_to moderate_game_path(@game), status: :see_other }
+      end
+    rescue Game::InvalidMove => error
+      respond_to do |format|
+        format.json { render json: @game.client_snapshot(moderator: true).merge(error: error.message), status: :conflict }
+        format.html { redirect_to moderate_game_path(@game), alert: error.message, status: :see_other }
+      end
+    end
+
+    private
+
+    def set_game
+      @game = Game.find(params[:id])
+    end
+  end
+end
