+class GameTicket
+  def self.issue(game, player = nil)
+    verifier.generate({ "game_id" => game.id, "player_id" => player&.id }, purpose: "live-game", expires_in: 2.days)
+  end
+
+  def self.read(ticket)
+    verifier.verified(ticket, purpose: "live-game")
+  end
+
+  def self.verifier
+    Rails.application.message_verifier("game-subscription")
+  end
+end
