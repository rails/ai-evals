diff --git a/app/services/game_presence.rb b/app/services/game_presence.rb
new file mode 100644
index 0000000..00fe460
--- /dev/null
+++ b/app/services/game_presence.rb
@@ -0,0 +1,67 @@
+# A socket is not durable game data. One foreground Puma process owns its
+# presence registry; reconnecting restores identity from the encrypted cookie.
+class GamePresence
+  LEASE_SECONDS = 75
+  @mutex = Mutex.new
+  @connections = {}
+  @timer = nil
+
+  class << self
+    def add(game_id, player_id, connection_id)
+      @mutex.synchronize do
+        sockets = (@connections[[ game_id, player_id ]] ||= {})
+        was_active = sockets.values.any? { |deadline| deadline > now }
+        sockets[connection_id] = now + LEASE_SECONDS
+        start_timer unless Rails.env.test?
+        !was_active
+      end
+    end
+
+    def remove(game_id, player_id, connection_id)
+      @mutex.synchronize do
+        key = [ game_id, player_id ]
+        sockets = @connections[key]
+        return false unless sockets
+        was_active = sockets.values.any? { |deadline| deadline > now }
+        sockets.delete(connection_id)
+        active = sockets.values.any? { |deadline| deadline > now }
+        @connections.delete(key) if sockets.empty?
+        was_active && !active
+      end
+    end
+
+    def player_ids(game_id)
+      @mutex.synchronize do
+        @connections.filter_map do |(game, player), sockets|
+          player if game == game_id && sockets.values.any? { |deadline| deadline > now }
+        end
+      end
+    end
+
+    def expire!(deadline = now)
+      @mutex.synchronize do
+        changed_games = []
+        @connections.delete_if do |(game, _player), sockets|
+          sockets.delete_if { |_socket, expires_at| expires_at <= deadline }
+          changed_games << game if sockets.empty?
+          sockets.empty?
+        end
+        changed_games.uniq
+      end
+    end
+
+    def now
+      Process.clock_gettime(Process::CLOCK_MONOTONIC)
+    end
+
+    private
+
+    def start_timer
+      @timer ||= ActionCable.server.event_loop.timer(15) do
+        Rails.application.executor.wrap do
+          Game.where(id: expire!).find_each(&:presence_changed!)
+        end
+      end
+    end
+  end
+end
