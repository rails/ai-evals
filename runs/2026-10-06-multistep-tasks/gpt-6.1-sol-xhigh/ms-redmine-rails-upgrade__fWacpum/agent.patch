diff --git a/test/unit/wiki_content_version_test.rb b/test/unit/wiki_content_version_test.rb
index a08dd38..98cb96c 100644
--- a/test/unit/wiki_content_version_test.rb
+++ b/test/unit/wiki_content_version_test.rb
@@ -24,6 +24,18 @@ class WikiContentVersionTest < ActiveSupport::TestCase
     User.current = nil
   end
 
+  def test_text_does_not_mutate_frozen_uncompressed_data
+    version = WikiContentVersion.new
+    bytes = "caf\xC3\xA9".b.freeze
+    version.stubs(:data).returns(bytes)
+    version.stubs(:compression).returns('')
+
+    assert_equal 'café', version.text
+    assert_equal Encoding::UTF_8, version.text.encoding
+    assert_equal Encoding::BINARY, bytes.encoding
+    assert bytes.frozen?
+  end
+
   def test_should_respond_to_attachments
     v = WikiContentVersion.find(2)
     assert v.respond_to?(:attachments)
