+      data = @conf.send(:load_from_yaml, file.path, 'test')
+      assert_equal :smtp, data['email_delivery']['delivery_method']
+      assert_equal :login, data['email_delivery']['smtp_settings']['authentication']
+    end
+  end
+
+  def test_yaml_arbitrary_objects_are_not_deserialized
+    require 'tempfile'
+    Tempfile.create(['redmine-config', '.yml']) do |file|
+      file.write("default:\n  object: !ruby/object:Object {}\n")
+      file.flush
+      assert_raise(Psych::DisallowedClass) {@conf.send(:load_from_yaml, file.path, 'test')}
+    end
+  end
