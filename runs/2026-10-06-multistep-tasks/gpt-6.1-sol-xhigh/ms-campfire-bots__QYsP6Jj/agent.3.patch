+# Kept independently of memberships so removing and re-adding a bot cannot send
+# another greeting to the same room.
+class Bot::RoomJoin < ApplicationRecord
+  self.table_name = "bot_room_joins"
+
+  belongs_to :bot
+  belongs_to :room
+
+  after_create_commit :notify_bot
+
+  def claim_delivery
+    self.class.where(id: id, delivery_attempted_at: nil).update_all(delivery_attempted_at: Time.current) == 1
+  end
+
+  private
+    def notify_bot
+      Bot::JoinedWebhookJob.perform_later(self) if bot.active? && bot.webhook_url.present?
+    end
+end
