@@ -0,0 +1,11 @@
+class Bot::JoinedWebhookJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(join)
+    bot, room = join.bot, join.room
+
+    if bot.active? && bot.webhook_url.present? && !room.direct? && room.users.exists?(bot.id) && join.claim_delivery
+      Bot::Webhook.new(bot: bot, room: room).deliver
+    end
+  end
+end
