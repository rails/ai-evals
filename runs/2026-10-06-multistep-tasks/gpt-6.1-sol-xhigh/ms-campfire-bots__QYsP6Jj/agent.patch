--- /dev/null
+++ b/app/models/bot/room_join.rb
@@ -0,0 +1,19 @@
+# Kept independently of memberships so removing and re-adding a bot cannot send
+# another greeting to the same room.
+class Bot::RoomJoin < ApplicationRecord
+  self.table_name = "bot_room_joins"
+
+  belongs_to :bot
+  belongs_to :room
+
+  after_create_commit :notify_bot
+
+  def claim_delivery
+    self.class.where(id: id, delivery_attempted_at: nil).update_all(delivery_attempted_at: Time.current) == 1
+  end
+
+  private
+    def notify_bot
+      Bot::JoinedWebhookJob.perform_later(self) if bot.active? && bot.webhook_url.present?
+    end
+end
diff --git a/app/models/bot/safeguards.rb b/app/models/bot/safeguards.rb
new file mode 100644
index 0000000..b346ea3
--- /dev/null
+++ b/app/models/bot/safeguards.rb
@@ -0,0 +1,82 @@
+module Bot::Safeguards
+  extend ActiveSupport::Concern
+
+  POSTING_LIMIT = 10
+  POSTING_WINDOW = 10.seconds
+  POSTING_COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  class SuspendedError < StandardError; end
+
+  class CooldownError < StandardError
+    attr_reader :retry_after
+
+    def initialize(retry_after)
+      @retry_after = retry_after
+      super("Bot posting cooldown")
+    end
+  end
+
+  def record_webhook_result(success:)
+    with_lock do
+      if active?
+        failures = success ? 0 : consecutive_webhook_failures + 1
+        update! consecutive_webhook_failures: failures
+        suspend_for("Ten consecutive failed webhook deliveries.") if failures >= WEBHOOK_FAILURE_LIMIT
+      end
+    end
+  end
+
+  def reactivate
+    with_lock do
+      if suspended?
+        update! status: :active, suspension_reason: nil, posting_cooldown_until: nil,
+          cooldown_posting_attempts: 0, consecutive_webhook_failures: 0
+      end
+    end
+  end
+
+  private
+    # Called under the same lock/transaction as message creation. Return errors
+    # rather than raising here so cooldown attempts and suspensions are committed.
+    def posting_rejection
+      now = Time.current
+
+      if !active?
+        SuspendedError.new
+      elsif posting_cooldown_until && posting_cooldown_until > now
+        update! cooldown_posting_attempts: cooldown_posting_attempts + 1
+
+        if cooldown_posting_attempts >= COOLDOWN_ATTEMPT_LIMIT
+          suspend_for("Flooding: five posting attempts during a cooldown.")
+          SuspendedError.new
+        else
+          CooldownError.new((posting_cooldown_until - now).ceil)
+        end
+      else
+        if posting_cooldown_until
+          update! posting_cooldown_until: nil, cooldown_posting_attempts: 0
+        end
+
+        if recent_postings(at: now).size >= POSTING_LIMIT
+          update! posting_cooldown_until: now + POSTING_COOLDOWN, cooldown_posting_attempts: 0
+          CooldownError.new(POSTING_COOLDOWN.to_i)
+        end
+      end
+    end
+
+    # Keep at most ten timestamps, independently of messages being removed.
+    # The caller holds the bot lock and the message's creation transaction.
+    def record_posting(message)
+      update! recent_posting_timestamps: recent_postings(at: message.created_at) + [ message.created_at.to_f ]
+    end
+
+    def recent_postings(at:)
+      recent_posting_timestamps.select { |timestamp| timestamp > (at - POSTING_WINDOW).to_f }
+    end
+
+    def suspend_for(reason)
+      update! status: :suspended, suspension_reason: reason
+    end
+end
diff --git a/app/models/bot/webhook.rb b/app/models/bot/webhook.rb
new file mode 100644
index 0000000..63e9fb7
--- /dev/null
+++ b/app/models/bot/webhook.rb
@@ -0,0 +1,96 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class Bot::Webhook
+  include Rails.application.routes.url_helpers
+
+  MAX_BODY_SIZE = 1.megabyte
+  REPLY_CONTENT_TYPES = %w[ text/plain text/html ]
+
+  attr_reader :bot, :message, :room
+
+  def initialize(bot:, message: nil, room: message&.room)
+    @bot, @message, @room = bot, message, room
+  end
+
+  def deliver
+    return unless bot.reload.active? && bot.webhook_url.present?
+
+    success, body, content_type = deliver_request
+    bot.record_webhook_result(success: success)
+    post_reply(body, content_type: content_type)
+  rescue => error
+    log_failure(error)
+  end
+
+  def payload
+    if message
+      {
+        event: "mention",
+        author: { id: message.creator.id, name: message.creator.name },
+        room: room_payload,
+        message: {
+          id: message.id,
+          body: { text: message.plain_text_body_without_mention(bot), html: message.body.to_s },
+          link: room_at_message_path(room, message.id)
+        }
+      }
+    else
+      { event: "joined", room: room_payload }
+    end
+  end
+
+  private
+    def deliver_request
+      url = URI.parse(bot.webhook_url)
+      ip = RestrictedHTTP::PrivateNetworkGuard.resolve(url.hostname)
+      result = [ false, nil, nil ]
+
+      Net::HTTP.start(url.hostname, url.port, ipaddr: ip, use_ssl: url.scheme == "https",
+        open_timeout: 5, read_timeout: 10, write_timeout: 10) do |http|
+        request = Net::HTTP::Post.new(url.request_uri, "Content-Type" => "application/json")
+        request.body = payload.to_json
+
+        # Never follow redirects: the payload contains the bot's secret posting URL.
+        http.request(request) do |response|
+          body = read_body(response) if response.is_a?(Net::HTTPOK) && response.content_type.in?(REPLY_CONTENT_TYPES)
+          result = [ response.is_a?(Net::HTTPSuccess), body, response.content_type ]
+        end
+      end
+
+      result
+    rescue => error
+      log_failure(error)
+      [ false, nil, nil ]
+    end
+
+    def log_failure(error)
+      # URLs and exception messages may contain credentials; only log identifiers.
+      context = message ? "message #{message.id}" : "room #{room.id}"
+      Rails.logger.warn "Bot webhook failed for bot #{bot.id}, #{context} (#{error.class})"
+    end
+
+    def room_payload
+      { id: room.id, name: room.name, reply_to: bot_room_messages_path(room_id: room.id, bot_code: bot.bot_code) }
+    end
+
+    def read_body(response)
+      return if response.content_length.to_i > MAX_BODY_SIZE
+
+      String.new.tap do |body|
+        response.read_body do |chunk|
+          return if body.bytesize + chunk.bytesize > MAX_BODY_SIZE
+          body << chunk
+        end
+      end
+    end
+
+    def post_reply(body, content_type:)
+      body = body&.force_encoding(Encoding::UTF_8)
+      if body&.valid_encoding? && body.present? && Bot.active.exists?(bot.id) && room.users.exists?(bot.id)
+        bot.post_message_in(room, body: body, content_type: content_type)
+      end
+    rescue Bot::CooldownError, Bot::SuspendedError
+      # A delivered webhook is still successful when its reply is throttled.
+    end
+end
