+require "test_helper"
+
+class Bots::ReactivationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(name: "Suspended Bot", creator: users(:jz))
+    @bot.update! status: :suspended, suspension_reason: "Ten consecutive failed webhook deliveries.",
+      posting_cooldown_until: 30.seconds.from_now, cooldown_posting_attempts: 5, consecutive_webhook_failures: 10
+  end
+
+  test "owners see the suspended bot and reason but cannot reactivate" do
+    sign_in :jz
+    get bots_url
+    assert_select "#bot_#{@bot.id}" do
+      assert_select "strong", text: "Suspended"
+      assert_select "p", text: /Ten consecutive failed webhook deliveries/
+      assert_select "button", text: "Reactivate", count: 0
+    end
+    post bot_reactivation_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+    patch bot_url(@bot), params: { bot: { name: "Renamed", status: "active", suspension_reason: "", consecutive_webhook_failures: 0 } }
+    assert_redirected_to bots_url
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.consecutive_webhook_failures
+  end
+
+  test "other members cannot reactivate" do
+    sign_in :kevin
+    post bot_reactivation_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "administrators see a confirmation button and can reactivate others bots" do
+    sign_in :david
+    get bots_url
+    assert_select "form[action=?]", bot_reactivation_path(@bot) do
+      assert_select "button[data-turbo-confirm]", text: "Reactivate"
+    end
+    post bot_reactivation_url(@bot)
+    assert_redirected_to bots_url
+    assert @bot.reload.active?
+    assert_nil @bot.suspension_reason
+    assert_nil @bot.posting_cooldown_until
+    assert_equal 0, @bot.cooldown_posting_attempts
+    assert_equal 0, @bot.consecutive_webhook_failures
+    follow_redirect!
+    assert_select "#bot_#{@bot.id} button", text: "Reactivate", count: 0
+    assert_select "#bot_#{@bot.id} strong", text: "Suspended", count: 0
+  end
+
+  test "reactivation cannot target a person" do
+    sign_in :david
+    assert_raises(ActiveRecord::RecordNotFound) { post bot_reactivation_url(users(:jz)) }
+  end
+
+  test "unauthenticated requests cannot reactivate" do
+    post bot_reactivation_url(@bot)
+    assert_redirected_to new_session_url
+    assert @bot.reload.suspended?
+  end
+end
diff --git a/test/controllers/bots/safeguards_test.rb b/test/controllers/bots/safeguards_test.rb
new file mode 100644
index 0000000..cbb580e
--- /dev/null
+++ b/test/controllers/bots/safeguards_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class Bots::SafeguardsTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(name: "Flood Bot", creator: users(:jz), webhook_url: "https://example.com/events")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("example.com").returns("93.184.216.34")
+  end
+
+  test "API posts and webhook replies share a per-bot limit across rooms" do
+    other_room = rooms(:designers)
+    other_room.memberships.grant_to(@bot)
+    stub_request(:post, @bot.webhook_url).to_return(status: 200, body: "greeting", headers: { content_type: "text/plain" })
+
+    freeze_time do
+      5.times do
+        post endpoint, params: "API post"
+        assert_response :created
+      end
+      assert_difference -> { Message.count }, 5 do
+        5.times { Bot::Webhook.new(bot: @bot, room: other_room).deliver }
+      end
+      assert_no_difference -> { Message.count } do
+        post endpoint(other_room), params: "eleventh"
+        assert_response :too_many_requests
+        assert_equal "30", response.headers["Retry-After"]
+        Bot::Webhook.new(bot: @bot, room: other_room).deliver
+      end
+      assert_equal 1, @bot.reload.cooldown_posting_attempts
+      assert_equal 0, @bot.consecutive_webhook_failures
+    end
+  end
+
+  test "webhook replies can trigger cooldown and five more replies suspend" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200, body: "reply", headers: { content_type: "text/plain" })
+    freeze_time do
+      assert_difference -> { Message.count }, 10 do
+        11.times { Bot::Webhook.new(bot: @bot, room: @room).deliver }
+      end
+      assert @bot.reload.active?
+      assert_equal 30.seconds.from_now, @bot.posting_cooldown_until
+      assert_no_difference -> { Message.count } do
+        5.times { Bot::Webhook.new(bot: @bot, room: @room).deliver }
+      end
+      assert @bot.reload.suspended?
+      assert_equal 0, @bot.consecutive_webhook_failures
+      post endpoint, params: "no more posts"
+      assert_response :forbidden
+    end
+  end
+
+  test "Retry-After decreases rounds up and the fifth further API attempt returns forbidden" do
+    start = Time.current.change(usec: 0)
+    travel_to start
+    11.times { post endpoint, params: "hello" }
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+    travel_to start + 10.5.seconds, with_usec: true
+    4.times do
+      post endpoint, params: "retry"
+      assert_response :too_many_requests
+      assert_equal "20", response.headers["Retry-After"]
+    end
+    assert_no_difference -> { Message.count } do
+      post endpoint, params: "fifth retry"
+      assert_response :forbidden
+      assert_nil response.headers["Retry-After"]
+      post endpoint, params: "still forbidden"
+      assert_response :forbidden
+    end
+    assert @bot.reload.suspended?
+  end
+
+  test "empty bodies during cooldown are throttled and count as attempts" do
+    @bot.update! posting_cooldown_until: 30.seconds.from_now
+    post endpoint, params: ""
+    assert_response :too_many_requests
+    assert_equal 1, @bot.reload.cooldown_posting_attempts
+  end
+
+  test "API posting resumes at the cooldown boundary" do
+    freeze_time do
+      11.times { post endpoint, params: "hello" }
+      assert_response :too_many_requests
+      travel 30.seconds
+      post endpoint, params: "allowed again"
+      assert_response :created
+      assert_nil @bot.reload.posting_cooldown_until
+    end
+  end
+
+  test "other bots have independent limits" do
+    other = Bot.create!(name: "Well behaved", creator: users(:jz))
+    @room.memberships.grant_to(other)
+    freeze_time do
+      11.times { post endpoint, params: "hello" }
+      post bot_room_messages_path(room_id: @room.id, bot_code: other.bot_code), params: "not throttled"
+      assert_response :created
+    end
+  end
+
+  test "suspended bots get forbidden even with invalid rooms or empty bodies" do
+    @bot.update! status: :suspended, suspension_reason: "Failed webhooks"
+    post endpoint, params: ""
+    assert_response :forbidden
+    post bot_room_messages_path(room_id: "unknown", bot_code: @bot.bot_code), params: "hello"
+    assert_response :forbidden
+  end
+
+  private
+    def endpoint(room = @room)
+      bot_room_messages_path(room_id: room.id, bot_code: @bot.bot_code)
+    end
+end
diff --git a/test/controllers/bots/webhook_replies_test.rb b/test/controllers/bots/webhook_replies_test.rb
new file mode 100644
index 0000000..cd1e7d6
--- /dev/null
+++ b/test/controllers/bots/webhook_replies_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Bots::WebhookRepliesTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", webhook_url: "https://example.com/mentions", creator: users(:jz))
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("example.com").returns("93.184.216.34")
+    sign_in :jz
+  end
+
+  test "posting a mention returns before delivery and a 204 bot can reply later using the payload path" do
+    payload = nil
+    request = stub_request(:post, @bot.webhook_url).to_return do |request|
+      payload = JSON.parse(request.body)
+      { status: 204 }
+    end
+
+    assert_difference -> { Message.count }, 1 do
+      assert_enqueued_with job: Bot::WebhookJob do
+        post room_messages_url(@room, format: :turbo_stream), params: { message: { body: "<div>#{mention_attachment_for(@bot)} restart the build please</div>" } }
+      end
+    end
+    assert_response :success
+    original = Message.last
+    assert_not_requested request
+
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+    assert_requested request, times: 1
+    assert_equal "restart the build please", payload.dig("message", "body", "text")
+
+    session = ActionDispatch::Integration::Session.new(Rails.application)
+    assert_difference -> { Message.count }, 1 do
+      session.post payload.dig("room", "reply_to"), params: "Build restarted ✅", headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_equal 201, session.response.status
+    assert_equal @bot, Message.last.creator
+    assert_equal @room, Message.last.room
+    assert_equal "Build restarted ✅", Message.last.plain_text_body
+
+    get payload.dig("message", "link")
+    assert_response :success
+    assert_select "[data-message-id=?]", original.id.to_s
+  end
+
+  test "a synchronous response creates a second bot message only when the queued job runs" do
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 200, body: "<strong>Restarted</strong>", headers: { content_type: "text/html" })
+    post room_messages_url(@room, format: :turbo_stream), params: { message: { body: mention_attachment_for(@bot) } }
+    assert_response :success
+    assert_not_requested request
+
+    assert_difference -> { Message.count }, 1 do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+    assert_requested request, times: 1
+    assert_equal @bot, Message.last.creator
+    assert_includes Message.last.body.to_s, "<strong>Restarted</strong>"
+  end
+end
