diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..20509c6
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,62 @@
+class Bot < User
+  include Safeguards
+
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  has_many :room_joins, class_name: "Bot::RoomJoin", dependent: :delete_all
+
+  has_secure_token :bot_code, length: 32
+
+  normalizes :webhook_url, with: ->(url) { url.strip.presence }
+
+  validates :name, presence: true
+  validate :creator_has_room_for_bot, on: :create
+  validate :webhook_url_is_http_url, if: -> { webhook_url.present? }
+
+  attr_readonly :bot_code, :creator_id
+
+  before_validation :assign_random_password, on: :create
+  after_save_commit :join_all_open_rooms, if: -> { active? && add_to_all_open_rooms? && saved_change_to_add_to_all_open_rooms? }
+
+  def post_message_in(room, body:, content_type: "text/plain")
+    rejection = nil
+
+    message = with_lock do
+      rejection = posting_rejection
+
+      if !rejection && body.valid_encoding? && body.present?
+        if content_type == "text/plain"
+          body = ERB::Util.html_escape(body).gsub(/\r\n|\r|\n/, "<br>")
+        end
+
+        room.messages.create!(body: body, creator: self).tap { |message| record_posting(message) }
+      end
+    end
+
+    raise rejection if rejection
+    message&.tap(&:broadcast_create)
+  end
+
+  private
+    def creator_has_room_for_bot
+      if creator.present? && !creator.can_create_bot?
+        errors.add :base, "You have reached the limit of bots per member."
+      end
+    end
+
+    def join_all_open_rooms
+      Rooms::Open.find_each { |room| room.memberships.grant_to(self) }
+    end
+
+    def webhook_url_is_http_url
+      url = URI.parse(webhook_url)
+      errors.add :webhook_url, "must be an HTTP or HTTPS URL" unless url.is_a?(URI::HTTP) && url.host.present? && url.userinfo.nil? && url.fragment.nil?
+    rescue URI::InvalidURIError
+      errors.add :webhook_url, "must be an HTTP or HTTPS URL"
+    end
+
+    # Users require a password digest, but bots authenticate only with their code.
+    def assign_random_password
+      self.password = SecureRandom.base58(48) if password_digest.blank?
+    end
+end
diff --git a/app/models/bot/room_join.rb b/app/models/bot/room_join.rb
