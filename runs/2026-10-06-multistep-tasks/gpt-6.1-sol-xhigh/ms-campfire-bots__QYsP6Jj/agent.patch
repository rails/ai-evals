diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..bb6f792
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,39 @@
+class Bots::MessagesController < ApplicationController
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  before_action :authenticate_bot
+  before_action :set_room
+
+  def create
+    body = request.raw_post.force_encoding(Encoding::UTF_8)
+
+    if message = Current.user.post_message_in(@room, body: body)
+      head :created, location: message_path(message.id)
+    else
+      head :unprocessable_entity
+    end
+  rescue Bot::CooldownError => error
+    response.headers["Retry-After"] = error.retry_after.to_s
+    head :too_many_requests
+  rescue Bot::SuspendedError
+    head :forbidden
+  end
+
+  private
+    def authenticate_bot
+      Current.user = Bot.find_by(bot_code: request.path_parameters[:bot_code])
+
+      if Current.user&.suspended?
+        head :forbidden
+      elsif !Current.user&.active?
+        head :unauthorized
+      end
+    end
+
+    def set_room
+      room_id = request.path_parameters[:room_id]
+      @room = Current.user.rooms.find_by(id: room_id) if room_id.match?(/\A\d+\z/)
+      head :not_found unless @room
+    end
+end
