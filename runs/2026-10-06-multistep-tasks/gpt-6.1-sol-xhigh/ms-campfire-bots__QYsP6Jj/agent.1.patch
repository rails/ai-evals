+require "test_helper"
+
+class BotsAuthenticationTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:jz), email_address: "bot@example.com", password: "secret123456")
+  end
+
+  test "bots cannot sign in with a password" do
+    post session_url, params: { email_address: @bot.email_address, password: "secret123456" }
+    assert_response :unauthorized
+    assert_not cookies[:session_token].present?
+  end
+
+  test "bots cannot sign in with a human session transfer" do
+    put session_transfer_url(@bot.transfer_id)
+    assert_response :bad_request
+    assert_not cookies[:session_token].present?
+  end
+
+  test "bot profiles do not show sign-in transfers or bot credentials" do
+    sign_in :david
+    get user_url(@bot)
+    assert_response :success
+    assert_not_includes response.body, @bot.bot_code
+    assert_select "input#session_transfer_url", count: 0
+  end
+end
