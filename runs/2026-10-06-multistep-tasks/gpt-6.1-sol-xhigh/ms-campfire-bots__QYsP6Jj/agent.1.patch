new file mode 100644
index 0000000..fbe34b2
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,17 @@
+class Bot < User
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  has_secure_token :bot_code, length: 32
+
+  validates :name, presence: true
+
+  attr_readonly :bot_code, :creator_id
+
+  before_validation :assign_random_password, on: :create
+
+  private
+    # Users require a password digest, but bots authenticate only with their code.
+    def assign_random_password
+      self.password = SecureRandom.base58(48) if password_digest.blank?
+    end
+end
