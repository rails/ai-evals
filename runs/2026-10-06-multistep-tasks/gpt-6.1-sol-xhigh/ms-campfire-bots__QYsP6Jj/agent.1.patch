@@ -0,0 +1,41 @@
+require "test_helper"
+
+class BotRequestsTest < ActiveSupport::TestCase
+  test "redacts bot codes from logged paths and parameters" do
+    code = SecureRandom.base58(32)
+    request = ActionDispatch::Request.new(Rack::MockRequest.env_for("/rooms/123/#{code}/messages?bot_code=#{code}"))
+    request.set_header("action_dispatch.parameter_filter", Rails.application.config.filter_parameters)
+    request.path_parameters = { controller: "bots/messages", action: "create", room_id: "123", bot_code: code }
+
+    assert_equal "/rooms/123/[FILTERED]/messages?bot_code=[FILTERED]", request.filtered_path
+    assert_equal "[FILTERED]", request.filtered_parameters["bot_code"]
+  end
+
+  test "normalizes bot content types without parsing the raw body" do
+    body = "{not JSON & not=form}"
+    app = ->(env) {
+      request = ActionDispatch::Request.new(env)
+      assert_equal "text/plain", request.content_type
+      assert_equal body, request.raw_post
+      assert_empty request.request_parameters
+      [ 200, {}, [] ]
+    }
+    env = Rack::MockRequest.env_for("/rooms/123/code/messages", method: "POST", input: body.dup, "CONTENT_TYPE" => "application/json")
+    BotRequests.new(app).call(env)
+  end
+
+  test "does not change human message requests" do
+    app = ->(env) {
+      assert_equal "application/json", env["CONTENT_TYPE"]
+      [ 200, {}, [] ]
+    }
+    env = Rack::MockRequest.env_for("/rooms/123/messages", method: "POST", "CONTENT_TYPE" => "application/json")
+    BotRequests.new(app).call(env)
+  end
+  test "redacts credentials from telemetry URLs" do
+    code = SecureRandom.base58(32)
+    assert_equal "https://chat.example.com/rooms/123/[FILTERED]/messages", BotRequests.redact_url("https://chat.example.com/rooms/123/#{code}/messages")
+    assert_equal "/rooms/123/messages", BotRequests.redact_url("/rooms/123/messages")
+    assert_nil BotRequests.redact_url(nil)
+  end
+end
