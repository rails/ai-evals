@@ -0,0 +1,45 @@
+require "application_system_test_case"
+
+class BotSafeguardsTest < ApplicationSystemTestCase
+  setup do
+    @bot = Bot.create!(name: "Misbehaving Bot", creator: users(:jz))
+    @bot.update! status: :suspended, suspension_reason: "Ten consecutive failed webhook deliveries.", consecutive_webhook_failures: 10
+  end
+
+  test "administrators reactivate from the bots page with native confirmation" do
+    sign_in "david@37signals.com"
+    visit bots_url
+    within "#bot_#{@bot.id}" do
+      assert_text "Suspended"
+      assert_text "Ten consecutive failed webhook deliveries."
+      dismiss_confirm "Are you sure you want to reactivate this bot?" do
+        click_on "Reactivate"
+      end
+      assert_text "Suspended"
+      assert @bot.reload.suspended?
+      accept_confirm "Are you sure you want to reactivate this bot?" do
+        click_on "Reactivate"
+      end
+    end
+    assert_current_path bots_path
+    within "#bot_#{@bot.id}" do
+      assert_no_text "Suspended"
+      assert_no_button "Reactivate"
+      assert_text "Misbehaving Bot"
+    end
+    assert @bot.reload.active?
+    assert_equal 0, @bot.consecutive_webhook_failures
+  end
+
+  test "owners still see the bot and reason without reactivation controls" do
+    sign_in "jz@37signals.com"
+    visit bots_url
+    within "#bot_#{@bot.id}" do
+      assert_text "Misbehaving Bot"
+      assert_text "Suspended"
+      assert_text "Ten consecutive failed webhook deliveries."
+      assert_no_button "Reactivate"
+      assert_link "Edit Misbehaving Bot"
+    end
+  end
+end
