+require "test_helper"
+
+class Bots::ReactivationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(name: "Suspended Bot", creator: users(:jz))
+    @bot.update! status: :suspended, suspension_reason: "Ten consecutive failed webhook deliveries.",
+      posting_cooldown_until: 30.seconds.from_now, cooldown_posting_attempts: 5, consecutive_webhook_failures: 10
+  end
+
+  test "owners see the suspended bot and reason but cannot reactivate" do
+    sign_in :jz
+    get bots_url
+    assert_select "#bot_#{@bot.id}" do
+      assert_select "strong", text: "Suspended"
+      assert_select "p", text: /Ten consecutive failed webhook deliveries/
+      assert_select "button", text: "Reactivate", count: 0
+    end
+    post bot_reactivation_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+    patch bot_url(@bot), params: { bot: { name: "Renamed", status: "active", suspension_reason: "", consecutive_webhook_failures: 0 } }
+    assert_redirected_to bots_url
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.consecutive_webhook_failures
+  end
+
+  test "other members cannot reactivate" do
+    sign_in :kevin
+    post bot_reactivation_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "administrators see a confirmation button and can reactivate others bots" do
+    sign_in :david
+    get bots_url
+    assert_select "form[action=?]", bot_reactivation_path(@bot) do
+      assert_select "button[data-turbo-confirm]", text: "Reactivate"
+    end
+    post bot_reactivation_url(@bot)
+    assert_redirected_to bots_url
+    assert @bot.reload.active?
+    assert_nil @bot.suspension_reason
+    assert_nil @bot.posting_cooldown_until
+    assert_equal 0, @bot.cooldown_posting_attempts
+    assert_equal 0, @bot.consecutive_webhook_failures
+    follow_redirect!
+    assert_select "#bot_#{@bot.id} button", text: "Reactivate", count: 0
+    assert_select "#bot_#{@bot.id} strong", text: "Suspended", count: 0
+  end
+
+  test "reactivation cannot target a person" do
+    sign_in :david
+    assert_raises(ActiveRecord::RecordNotFound) { post bot_reactivation_url(users(:jz)) }
+  end
+
+  test "unauthenticated requests cannot reactivate" do
+    post bot_reactivation_url(@bot)
+    assert_redirected_to new_session_url
+    assert @bot.reload.suspended?
+  end
+end
