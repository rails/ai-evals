new file mode 100644
index 0000000..b346ea3
--- /dev/null
+++ b/app/models/bot/safeguards.rb
@@ -0,0 +1,82 @@
+module Bot::Safeguards
+  extend ActiveSupport::Concern
+
+  POSTING_LIMIT = 10
+  POSTING_WINDOW = 10.seconds
+  POSTING_COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  class SuspendedError < StandardError; end
+
+  class CooldownError < StandardError
+    attr_reader :retry_after
+
+    def initialize(retry_after)
+      @retry_after = retry_after
+      super("Bot posting cooldown")
+    end
+  end
+
+  def record_webhook_result(success:)
+    with_lock do
+      if active?
+        failures = success ? 0 : consecutive_webhook_failures + 1
+        update! consecutive_webhook_failures: failures
+        suspend_for("Ten consecutive failed webhook deliveries.") if failures >= WEBHOOK_FAILURE_LIMIT
+      end
+    end
+  end
+
+  def reactivate
+    with_lock do
+      if suspended?
+        update! status: :active, suspension_reason: nil, posting_cooldown_until: nil,
+          cooldown_posting_attempts: 0, consecutive_webhook_failures: 0
+      end
+    end
+  end
+
+  private
+    # Called under the same lock/transaction as message creation. Return errors
+    # rather than raising here so cooldown attempts and suspensions are committed.
+    def posting_rejection
+      now = Time.current
+
+      if !active?
+        SuspendedError.new
+      elsif posting_cooldown_until && posting_cooldown_until > now
+        update! cooldown_posting_attempts: cooldown_posting_attempts + 1
+
+        if cooldown_posting_attempts >= COOLDOWN_ATTEMPT_LIMIT
+          suspend_for("Flooding: five posting attempts during a cooldown.")
+          SuspendedError.new
+        else
+          CooldownError.new((posting_cooldown_until - now).ceil)
+        end
+      else
+        if posting_cooldown_until
+          update! posting_cooldown_until: nil, cooldown_posting_attempts: 0
+        end
+
+        if recent_postings(at: now).size >= POSTING_LIMIT
+          update! posting_cooldown_until: now + POSTING_COOLDOWN, cooldown_posting_attempts: 0
+          CooldownError.new(POSTING_COOLDOWN.to_i)
+        end
+      end
+    end
+
+    # Keep at most ten timestamps, independently of messages being removed.
+    # The caller holds the bot lock and the message's creation transaction.
+    def record_posting(message)
+      update! recent_posting_timestamps: recent_postings(at: message.created_at) + [ message.created_at.to_f ]
+    end
+
+    def recent_postings(at:)
+      recent_posting_timestamps.select { |timestamp| timestamp > (at - POSTING_WINDOW).to_f }
+    end
+
+    def suspend_for(reason)
+      update! status: :suspended, suspension_reason: reason
+    end
+end
