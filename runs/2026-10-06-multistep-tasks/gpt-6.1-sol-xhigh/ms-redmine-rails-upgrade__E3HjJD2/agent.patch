diff --git a/test/unit/wire_compatibility_test.rb b/test/unit/wire_compatibility_test.rb
new file mode 100644
index 0000000..949732c
--- /dev/null
+++ b/test/unit/wire_compatibility_test.rb
@@ -0,0 +1,106 @@
+# frozen_string_literal: true
+
+require_relative '../test_helper'
+require_relative '../upgrade/wire_compatibility'
+
+class WireCompatibilityTest < ActiveSupport::TestCase
+  WIRE_VERSIONS = [:rails61, :rails70, :rails72, :rails81].freeze
+
+  def test_reads_all_releases_and_reissued_sessions
+    WIRE_VERSIONS.each do |version|
+      _, cookies = UpgradeWireCompatibility.request(
+        :create => true, :env_overrides => UpgradeWireCompatibility.wire_env(version)
+      )
+      payload, reissued = UpgradeWireCompatibility.request(cookies)
+      assert_equal UpgradeWireCompatibility::SESSION, payload['session'], version.to_s
+      assert_equal 'signed-cookie-value', payload['signed'], version.to_s
+      payload, = UpgradeWireCompatibility.request(reissued)
+      assert_equal UpgradeWireCompatibility::SESSION, payload['session']
+      assert_equal 'signed-cookie-value', payload['signed']
+    end
+  end
+
+  def test_writer_uses_default_cookie_crypto_and_json
+    _, cookies = UpgradeWireCompatibility.request(:create => true)
+    # No rotations in this reader: proves the primary digest/cipher/serializer.
+    payload, = UpgradeWireCompatibility.request(cookies, :env_overrides => UpgradeWireCompatibility.wire_env(:rails70))
+    assert_equal UpgradeWireCompatibility::SESSION, payload['session']
+    assert_equal 'signed-cookie-value', payload['signed']
+  end
+
+  def test_rejects_tampered_cookies_and_cookies_from_another_secret
+    WIRE_VERSIONS.each do |version|
+      _, cookies = UpgradeWireCompatibility.request(
+        :create => true, :env_overrides => UpgradeWireCompatibility.wire_env(version, :secret => 'different-test-secret')
+      )
+      payload, = UpgradeWireCompatibility.request(cookies)
+      assert_nil payload['session']['user_id']
+      assert_nil payload['signed']
+
+      _, cookies = UpgradeWireCompatibility.request(
+        :create => true, :env_overrides => UpgradeWireCompatibility.wire_env(version)
+      )
+      tampered = Rack::Utils.parse_cookies_header(cookies).transform_values {|value| value + 'tampered'}
+      payload, = UpgradeWireCompatibility.request(UpgradeWireCompatibility.cookie_header(tampered))
+      assert_nil payload['session']['user_id']
+      assert_nil payload['signed']
+    end
+  end
+
+  def test_mail_verifier_reads_all_formats_without_weakening_validation
+    WIRE_VERSIONS.each do |version|
+      verifier = UpgradeWireCompatibility.mail_verifier(version)
+      data = UpgradeWireCompatibility::MAIL_DATA
+      token = verifier.generate(data, :purpose => :unwatch, :expires_in => 30.days)
+      assert_equal data, Mailer.verify_mail_link(token, :unwatch), version.to_s
+      assert_raises(ActiveSupport::MessageVerifier::InvalidSignature) {Mailer.verify_mail_link(token, :other)}
+      assert_raises(ActiveSupport::MessageVerifier::InvalidSignature) {Mailer.verify_mail_link(token + 'tampered', :unwatch)}
+      expired = verifier.generate(data, :purpose => :unwatch, :expires_at => 1.day.ago)
+      assert_raises(ActiveSupport::MessageVerifier::InvalidSignature) {Mailer.verify_mail_link(expired, :unwatch)}
+      no_purpose = verifier.generate(data)
+      assert_raises(ActiveSupport::MessageVerifier::InvalidSignature) {Mailer.verify_mail_link(no_purpose, :unwatch)}
+      wrong_key = UpgradeWireCompatibility.mail_verifier(version, :secret => 'different-test-secret')
+      assert_raises(ActiveSupport::MessageVerifier::InvalidSignature) do
+        Mailer.verify_mail_link(wrong_key.generate(data, :purpose => :unwatch), :unwatch)
+      end
+    end
+  end
+
+  def test_mail_writer_uses_json_and_the_expected_metadata_envelope
+    token = Mailer.mail_link_token(:unwatch, UpgradeWireCompatibility::MAIL_DATA)
+    # Independent reader without rotations verifies the serializer and key.
+    verifier = UpgradeWireCompatibility.mail_verifier(:rails72)
+    assert_equal UpgradeWireCompatibility::MAIL_DATA, verifier.verify(token, :purpose => :unwatch)
+    envelope = JSON.parse(Base64.strict_decode64(token.split('--').first)).fetch('_rails')
+    assert_equal UpgradeWireCompatibility::MAIL_DATA, envelope.fetch('data')
+    assert_not envelope.key?('message')
+    assert_equal 'unwatch', envelope.fetch('pur')
+    assert_in_delta 30.days.from_now.to_f, Time.iso8601(envelope.fetch('exp')).to_f, 5
+    assert_same Rails.application.message_verifier(:mail_links), Rails.application.message_verifier(:mail_links)
+  end
+
+  def test_framework_defaults_and_historical_cookie_reader
+    config = Rails.application.config
+    assert_equal 8.1, config.loaded_config_version
+    assert_equal OpenSSL::Digest::SHA256, config.active_support.key_generator_hash_digest_class
+    assert_equal OpenSSL::Digest::SHA256, config.active_support.hash_digest_class
+    assert_equal :hybrid, config.action_dispatch.cookies_serializer
+    assert_equal 7.1, ActiveSupport::Cache.format_version
+    assert_equal :json_allow_marshal, config.active_support.message_serializer
+    assert_equal true, config.active_support.use_message_serializer_for_metadata
+    assert_equal 7.1, config.active_record.marshalling_format_version
+  end
+
+  def test_cache_writers_remain_readable_by_their_rollback_target
+    ['shared-value', 'shared-value' * 1000].each do |value|
+      entry = ActiveSupport::Cache::Entry.new(value, :version => 'v1', :expires_in => 300)
+      payload = UpgradeWireCompatibility.cache_store.send(:serialize_entry, entry, :compress => true, :compress_threshold => 1024)
+      # Rails 7.2's native reader accepts the default 7.1 cache format.
+      assert_equal "\x00\x11".b, payload.byteslice(0, 2)
+      decoded = ActiveSupport::Cache::Coder.new(ActiveSupport::Cache::SerializerWithFallback[:marshal_7_1], Zlib).load(payload)
+      assert_equal value, decoded.value
+      assert_equal 'v1', decoded.version
+      assert_in_delta entry.expires_at, decoded.expires_at, 0.01
+    end
+  end
+end
diff --git a/test/upgrade/rollback.sh b/test/upgrade/rollback.sh
new file mode 100755
index 0000000..c85e52d
--- /dev/null
+++ b/test/upgrade/rollback.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+# Exercise actual immutable releases, not two Gemfiles in the same source tree.
+set -euo pipefail
+current=$(cd "$(dirname "$0")/../.." && pwd)
+rollback=$(cd "${1:?Usage: test/upgrade/rollback.sh /path/to/deployed-rails72}" && pwd)
+artifacts="$current/tmp/upgrade"
+probe="$current/test/upgrade/wire_compatibility.rb"
+mkdir -p "$artifacts"
+
+current_release() {
+  BUNDLE_GEMFILE="$current/Gemfile" REDMINE_UPGRADE_APP="$current" ruby "$probe" "$@"
+}
+rollback_release() {
+  BUNDLE_GEMFILE="$rollback/Gemfile" REDMINE_UPGRADE_APP="$rollback" ruby "$probe" "$@"
+}
+
+rollback_release write "$artifacts/rails72.json"
+ruby -rjson -e 'abort "Rollback target must be the deployed Rails 7.2 release" unless JSON.parse(File.read(ARGV.fetch(0))).fetch("rails").start_with?("7.2.")' "$artifacts/rails72.json"
+current_release check "$artifacts/rails72.json" "$artifacts/reissued81.json"
+current_release write "$artifacts/rails81.json"
+rollback_release check "$artifacts/rails81.json" "$artifacts/reissued72.json"
+rollback_release check "$artifacts/reissued81.json"
+current_release check "$artifacts/reissued72.json"
diff --git a/test/upgrade/wire_compatibility.rb b/test/upgrade/wire_compatibility.rb
new file mode 100644
index 0000000..ad22ad6
--- /dev/null
+++ b/test/upgrade/wire_compatibility.rb
@@ -0,0 +1,174 @@
+# frozen_string_literal: true
+
+# Run with each release's bundle. Artifacts contain test-only credentials.
+# ruby test/upgrade/wire_compatibility.rb write tmp/upgrade/rails81.json
+# test/upgrade/rollback.sh /path/to/immutable/deployed-rails72
+ENV['RAILS_ENV'] = 'test'
+root = ENV.fetch('REDMINE_UPGRADE_APP', File.expand_path('../..', __dir__))
+require File.join(root, 'config/environment')
+require 'json'
+require 'fileutils'
+require 'base64'
+
+module UpgradeWireCompatibility
+  SESSION = {'user_id' => 3, 'tk' => 'existing-session-token'}.freeze
+  MAIL_DATA = {'user_id' => 3, 'issue_id' => 2}.freeze
+
+  def self.assert(condition, message)
+    raise message unless condition
+  end
+
+  # Exercise the configured CookieStore, including cookie rotation/reissue.
+  def self.request(cookie = nil, create: false, env_overrides: {})
+    endpoint = lambda do |env|
+      request = ActionDispatch::Request.new(env)
+      if create
+        SESSION.each {|key, value| request.session[key] = value}
+        request.cookie_jar.signed[:upgrade_signed] = 'signed-cookie-value'
+      end
+      session = SESSION.keys.index_with {|key| request.session[key]}
+      signed = request.cookie_jar.signed[:upgrade_signed]
+      request.session[:upgrade_probe] = request.session[:upgrade_probe].to_i + 1
+      [200, {'Content-Type' => 'application/json'}, [JSON.generate('session' => session, 'signed' => signed)]]
+    end
+    app = ActionDispatch::Cookies.new(
+      Rails.application.config.session_store.new(endpoint, Rails.application.config.session_options)
+    )
+    env = Rack::MockRequest.env_for('https://example.org/', 'HTTP_COOKIE' => cookie.to_s)
+    _, headers, body = app.call(env.merge(Rails.application.env_config).merge(env_overrides))
+    set_cookies = Array(headers['set-cookie'] || headers['Set-Cookie']).flat_map {|header| header.split("\n")}.map {|line| line.split(';').first}.join('; ')
+    # A browser retains cookies that were not reissued by this response.
+    cookies = Rack::Utils.parse_cookies_header(cookie.to_s).merge(Rack::Utils.parse_cookies_header(set_cookies))
+    [JSON.parse(body.join), cookie_header(cookies)]
+  end
+
+  def self.cookie_header(cookies)
+    cookies.map {|name, value| "#{name}=#{Rack::Utils.escape(value)}"}.join('; ')
+  end
+
+  # Independent, explicit writers: no app rotations and no reliance on whichever
+  # digest the running Rails version happens to default to.
+  KeyGenerator = Struct.new(:secret, :digest) do
+    def generate_key(salt, length = 64)
+      OpenSSL::PKCS5.pbkdf2_hmac(secret, salt, 1000, length, digest.new)
+    end
+  end
+
+  def self.wire_env(version, secret: Rails.application.secret_key_base)
+    modern = version != :rails61
+    {
+      'action_dispatch.key_generator' => KeyGenerator.new(secret, modern ? OpenSSL::Digest::SHA256 : OpenSSL::Digest::SHA1),
+      'action_dispatch.cookies_serializer' => modern ? :json : :marshal,
+      'action_dispatch.use_authenticated_cookie_encryption' => modern,
+      'action_dispatch.use_cookies_with_metadata' => modern,
+      'action_dispatch.cookies_rotations' => ActiveSupport::Messages::RotationConfiguration.new
+    }
+  end
+
+  # Force the modern envelope independently of the app's temporary writer flag.
+  class ModernMailVerifier < ActiveSupport::MessageVerifier
+    private
+
+    def use_message_serializer_for_metadata?
+      true
+    end
+  end
+
+  def self.mail_verifier(version, secret: Rails.application.secret_key_base)
+    digest = version == :rails61 ? OpenSSL::Digest::SHA1 : OpenSSL::Digest::SHA256
+    serializer = [:rails72, :rails81].include?(version) ? JSON : Marshal
+    options = {:digest => 'SHA1', :serializer => serializer}
+    options[:force_legacy_metadata_serializer] = true
+    verifier_class = version == :rails81 ? ModernMailVerifier : ActiveSupport::MessageVerifier
+    verifier_class.new(KeyGenerator.new(secret, digest).generate_key('mail_links'), **options)
+  end
+
+  def self.write(path)
+    payload, cookies = request(create: true)
+    assert(payload['session'] == SESSION, 'session could not be created')
+    assert(payload['signed'] == 'signed-cookie-value', 'signed cookie could not be created')
+    assert(Rack::Utils.parse_cookies_header(cookies).key?('_redmine_session'), 'session cookie not emitted')
+    assert(Rack::Utils.parse_cookies_header(cookies).key?('upgrade_signed'), 'signed cookie not emitted')
+    verifier = Rails.application.message_verifier(:mail_links)
+    artifacts = {
+      'rails' => Rails.version,
+      'ruby' => RUBY_VERSION,
+      'cookies' => cookies,
+      'cache' => Base64.strict_encode64(cache_store.send(:serialize_entry, ActiveSupport::Cache::Entry.new('shared-cache-value' * 1000))),
+      'model_cache' => Base64.strict_encode64(cache_store.send(:serialize_entry, ActiveSupport::Cache::Entry.new(User.new(:login => 'upgrade-probe', :lastname => 'Upgrade')))),
+      'mail' => Mailer.mail_link_token(:unwatch, MAIL_DATA),
+      'wrong_purpose' => verifier.generate(MAIL_DATA, :purpose => :other),
+      'no_purpose' => verifier.generate(MAIL_DATA),
+      'expired' => verifier.generate(MAIL_DATA, :purpose => :unwatch, :expires_at => 1.day.ago)
+    }
+    # Exercise compression and cache metadata in each real release process.
+    artifacts['cache_entries'] = [false, true].map do |compress|
+      entry = ActiveSupport::Cache::Entry.new('shared-cache-value' * 1000, :version => 'v1', :expires_in => 300)
+      {
+        'payload' => Base64.strict_encode64(cache_store.send(:serialize_entry, entry, :compress => compress, :compress_threshold => 1)),
+        'expires_at' => entry.expires_at
+      }
+    end
+    FileUtils.mkdir_p(File.dirname(path))
+    File.write(path, JSON.pretty_generate(artifacts))
+    puts "Wrote Rails #{Rails.version}/Ruby #{RUBY_VERSION} artifacts to #{path}"
+  end
+
+  def self.check(path, reissued_path = nil)
+    artifacts = JSON.parse(File.read(path))
+    payload, cookies = request(artifacts.fetch('cookies'))
+    assert(payload['session'] == SESSION, "session lost from #{path}: #{payload.inspect}")
+    assert(payload['signed'] == 'signed-cookie-value', "signed cookie lost from #{path}")
+    assert(Mailer.verify_mail_link(artifacts.fetch('mail'), :unwatch) == MAIL_DATA, 'mail link lost')
+    %w[wrong_purpose no_purpose expired].each do |key|
+      next unless artifacts.key?(key) # Older archived probes omitted no_purpose.
+
+      Mailer.verify_mail_link(artifacts.fetch(key), :unwatch)
+      raise "accepted #{key} mail link"
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      # Required rejection, even through a rotation.
+    end
+    begin
+      Mailer.verify_mail_link(artifacts.fetch('mail') + 'tampered', :unwatch)
+      raise 'accepted tampered mail link'
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      # Tampered signatures must be rejected by primary and rotated readers.
+    end
+    if artifacts['cache']
+      entry = cache_store.send(:deserialize_entry, Base64.strict_decode64(artifacts['cache']))
+      assert(entry.value == 'shared-cache-value' * 1000, 'shared cache entry lost')
+    end
+    if artifacts['model_cache']
+      entry = cache_store.send(:deserialize_entry, Base64.strict_decode64(artifacts['model_cache']))
+      assert(entry&.value.is_a?(User), 'cached model unreadable')
+      assert(entry.value.login == 'upgrade-probe' && entry.value.new_record?, 'cached model changed')
+    end
+    Array(artifacts['cache_entries']).each do |cached|
+      entry = cache_store.send(:deserialize_entry, Base64.strict_decode64(cached.fetch('payload')))
+      assert(entry&.value == 'shared-cache-value' * 1000, 'compressed/uncompressed cache entry lost')
+      assert(entry.version == 'v1', 'cache version changed')
+      assert((entry.expires_at - cached.fetch('expires_at')).abs < 0.01, 'cache expiry changed')
+    end
+    # Re-read a session reissued through a rotation in this release.
+    payload, = request(cookies)
+    assert(payload['session'] == SESSION, 'reissued session lost locally')
+    if reissued_path
+      artifacts['cookies'] = cookies
+      File.write(reissued_path, JSON.pretty_generate(artifacts))
+    end
+    puts "Rails #{Rails.version}/Ruby #{RUBY_VERSION} reads #{artifacts['rails']}/#{artifacts['ruby']} cookies and mail; negative checks pass"
+  end
+
+  def self.cache_store
+    ActiveSupport::Cache::FileStore.new(File.join(Rails.root, 'tmp/upgrade/cache'))
+  end
+end
+
+if $0 == __FILE__
+  command, path, reissued_path = ARGV
+  case command
+  when 'write' then UpgradeWireCompatibility.write(path)
+  when 'check' then UpgradeWireCompatibility.check(path, reissued_path)
+  else abort 'Usage: ruby test/upgrade/wire_compatibility.rb {write|check} ARTIFACT.json [REISSUED.json]'
+  end
+end
