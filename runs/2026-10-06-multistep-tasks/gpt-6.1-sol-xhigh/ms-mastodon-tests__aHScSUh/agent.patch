diff --git a/spec/support/model_spec_execution.rb b/spec/support/model_spec_execution.rb
new file mode 100644
index 0000000..665065e
--- /dev/null
+++ b/spec/support/model_spec_execution.rb
@@ -0,0 +1,12 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # Model setup should enqueue background work, not execute unrelated workers.
+  # Opt in to execution only where worker side effects are part of the assertion.
+  # The block removes the thread-local override even if an example fails.
+  config.around(:each, type: :model) do |example|
+    Sidekiq.testing!(example.metadata[:inline_jobs] ? :inline : :fake) do
+      example.run
+    end
+  end
+end
diff --git a/spec/support/request_spec_execution.rb b/spec/support/request_spec_execution.rb
new file mode 100644
index 0000000..88e1bb1
--- /dev/null
+++ b/spec/support/request_spec_execution.rb
@@ -0,0 +1,12 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # Requests normally assert the HTTP boundary, not unrelated background work.
+  # Keep real worker execution for setup/expectations that rely on its effects.
+  # Sidekiq's block API restores the thread-local mode even when setup fails.
+  config.around(:each, type: :request) do |example|
+    Sidekiq.testing!(example.metadata[:inline_jobs] ? :inline : :fake) do
+      example.run
+    end
+  end
+end
