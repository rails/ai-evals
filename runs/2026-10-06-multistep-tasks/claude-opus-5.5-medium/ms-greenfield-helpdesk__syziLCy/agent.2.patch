+
+      # --- Pagination ------------------------------------------------------
+
+      DEFAULT_PER_PAGE = 25
+      MAX_PER_PAGE = 100
+
+      # Returns [records, meta] for +scope+ using the page/per_page params.
+      def paginate(scope)
+        page = positive_int(params[:page], 1)
+        per_page = positive_int(params[:per_page], DEFAULT_PER_PAGE).clamp(1, MAX_PER_PAGE)
+        count = scope.count
+        records = scope.offset((page - 1) * per_page).limit(per_page).to_a
+        meta = {
+          count: count,
+          page: page,
+          per_page: per_page,
+          next_page: page * per_page < count ? page + 1 : nil,
+          previous_page: page > 1 ? page - 1 : nil
+        }
+        [ records, meta ]
+      end
+
+      def positive_int(value, default)
+        int = Integer(value.to_s, 10, exception: false)
+        int && int >= 1 ? int : default
+      end
+
