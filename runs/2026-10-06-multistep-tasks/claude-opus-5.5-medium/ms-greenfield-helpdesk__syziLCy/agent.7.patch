+class AddMergedIntoToTickets < ActiveRecord::Migration[8.1]
+  def change
+    # A merged duplicate is closed and points at the ticket the conversation
+    # continues in. Links are never rewritten if that ticket is merged later.
+    add_reference :tickets, :merged_into, foreign_key: { to_table: :tickets, on_delete: :nullify }, index: true
+    add_column :tickets, :merged_at, :datetime
+  end
+end
