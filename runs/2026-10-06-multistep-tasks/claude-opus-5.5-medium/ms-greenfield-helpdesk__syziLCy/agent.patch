diff --git a/app/controllers/api/v1/tickets_controller.rb b/app/controllers/api/v1/tickets_controller.rb
new file mode 100644
index 0000000..e4f968b
--- /dev/null
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,89 @@
+module Api
+  module V1
+    # Staff view of every ticket in the account.
+    class TicketsController < BaseController
+      include TicketUpdates
+      include TicketFilters
+
+      wrap_parameters false
+
+      before_action :require_account!
+      before_action :require_authentication!
+      before_action :require_active_account!
+      before_action :require_staff!
+      before_action :load_ticket, only: %i[show update comments merge]
+
+      # GET /api/v1/tickets
+      def index
+        scope, errors = filter_tickets(current_account.tickets)
+        return render_filter_errors(errors) if errors.any?
+
+        records, meta = paginate(scope.recently_active.includes(:requester, :assignee, :group))
+        render json: { tickets: records.map { |t| ticket_json(t) } }.merge(meta)
+      end
+
+      # GET /api/v1/tickets/:id
+      def show
+        render json: { ticket: ticket_json(@ticket) }
+      end
+
+      # PATCH /api/v1/tickets/:id
+      def update
+        comment, status = update_attributes_from(:ticket)
+        @ticket.apply_update!(actor: current_user, comment: comment, status: status,
+                              assignee_id: assignee_from(:ticket), priority: priority_from(:ticket),
+                              group_id: group_from(:ticket))
+        email_reply_to_requester(@ticket.last_comment)
+        render json: { ticket: ticket_json(@ticket) }
+      end
+
+      # POST /api/v1/tickets/:id/merge
+      # {merge: {target_id, source_comment: {body, public}, target_comment: {body, public}}}
+      #
+      # Closes this ticket and links it to the target (same customer). Merge notes
+      # are private by default and never emailed.
+      def merge
+        attrs = params.require(:merge)
+        raise ActionController::ParameterMissing, :merge unless attrs.is_a?(ActionController::Parameters)
+
+        notes = Ticket::MERGE_NOTE_FIELDS.index_with do |field|
+          raw = attrs[field]
+          case raw
+          when nil then nil
+          when ActionController::Parameters then raw.permit(:body, :public).to_h.symbolize_keys
+          else :invalid
+          end
+        end
+        target_id = attrs[:target_id]
+        target_id = :invalid if target_id.is_a?(ActionController::Parameters) || target_id.is_a?(Array)
+
+        @ticket.merge_into!(target_id: target_id, actor: current_user,
+                            source_comment: notes[:source_comment], target_comment: notes[:target_comment])
+        target = current_account.tickets.includes(:requester, :assignee, :group).find(@ticket.merged_into_id)
+        render json: { source: ticket_json(@ticket), target: ticket_json(target) }
+      end
+
+      # GET /api/v1/tickets/:id/comments
+      def comments
+        records, meta = paginate(@ticket.comments.chronological.includes(:author))
+        render json: { comments: records.map { |c| comment_json(c) } }.merge(meta)
+      end
+
+      private
+
+      # Public staff replies on email-origin tickets are emailed to the requester.
+      def email_reply_to_requester(comment)
+        return unless comment&.public && @ticket.channel_email?
+        return if @ticket.requester.suspended?
+
+        TicketMailer.deliver_reply(comment)
+      rescue StandardError => e
+        Rails.logger.error("Reply email for ticket #{@ticket.id} failed: #{e.class}: #{e.message}")
+      end
+
+      def load_ticket
+        @ticket = current_account.tickets.includes(:requester, :assignee, :group).find(params[:id])
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..473b5af
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,80 @@
+module Api
+  module V1
+    # Admin management of everyone in the account.
+    class UsersController < BaseController
+      wrap_parameters false
+
+      before_action :require_account!
+      before_action :require_authentication!
+      before_action :require_active_account!
+      before_action :require_admin!
+      before_action :load_user, only: %i[show update]
+
+      ROLE_FILTERS = (User::ROLES + %w[staff]).freeze
+
+      # GET /api/v1/users?role=admin|agent|customer|staff&suspended=true|false
+      def index
+        scope = current_account.users
+        details = {}
+
+        if params[:role].present?
+          role = params[:role].to_s
+          if !ROLE_FILTERS.include?(role)
+            details[:role] = [ "must be one of: #{ROLE_FILTERS.join(', ')}" ]
+          else
+            scope = role == "staff" ? scope.staff : scope.where(role: role)
+          end
+        end
+
+        if params[:suspended].present?
+          case parse_bool(params[:suspended])
+          when true then scope = scope.suspended
+          when false then scope = scope.active
+          else details[:suspended] = [ "must be true or false" ]
+          end
+        end
+
+        return render_error(:unprocessable_content, "invalid_filter", "Invalid filter", details: details) if details.any?
+
+        records, meta = paginate(scope.by_id.includes(:account))
+        render json: { users: records.map { |u| user_json(u) } }.merge(meta)
+      end
+
+      # GET /api/v1/users/:id
+      def show
+        render json: { user: user_json(@user) }
+      end
+
+      # PATCH /api/v1/users/:id  {"user": {"suspended": true, "role": "agent"}}
+      def update
+        attrs = params.require(:user)
+        raise ActionController::ParameterMissing, :user unless attrs.is_a?(ActionController::Parameters)
+
+        changes = {}
+        changes[:suspended] = parse_bool(attrs[:suspended]) if attrs.key?(:suspended)
+        changes[:role] = attrs[:role].to_s if attrs.key?(:role)
+        if changes.empty?
+          return render_error(:unprocessable_content, "validation_failed", "Validation failed",
+                              details: { base: [ "Provide suspended or role" ] })
+        end
+        changes[:suspended] = :invalid if changes.key?(:suspended) && changes[:suspended].nil?
+
+        @user.manage!(changes)
+        render json: { user: user_json(@user) }
+      end
+
+      private
+
+      def load_user
+        @user = current_account.users.find(params[:id])
+      end
+
+      def parse_bool(value)
+        case value
+        when true, "true", "1", 1 then true
+        when false, "false", "0", 0 then false
+        end
+      end
+    end
+  end
+end
