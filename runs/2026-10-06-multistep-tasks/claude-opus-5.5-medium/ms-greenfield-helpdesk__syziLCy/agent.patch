new file mode 100644
index 0000000..c49531d
--- /dev/null
+++ b/app/models/group.rb
@@ -0,0 +1,39 @@
+# A department (e.g. Billing) that organizes staff and tickets. Groups don't
+# restrict visibility: every staff member still sees every ticket.
+class Group < ApplicationRecord
+  belongs_to :account
+  has_many :memberships, class_name: "GroupMembership", inverse_of: :group
+  has_many :users, through: :memberships
+  has_many :tickets
+
+  normalizes :name, with: ->(v) { v.to_s.strip }
+
+  validates :name, presence: true, length: { maximum: 100 },
+                   uniqueness: { scope: :account_id, case_sensitive: false }
+
+  scope :by_id, -> { order(id: :asc) }
+
+  # Saves, turning a lost race on the unique name index into a validation error.
+  def save_name!(name)
+    self.name = name
+    save!
+  rescue ActiveRecord::RecordNotUnique
+    errors.add(:name, :taken, value: self.name)
+    raise ActiveRecord::RecordInvalid, self
+  end
+
+  # Deletes the group and its memberships. Its tickets become ungrouped, which
+  # also clears their assignees; members who lose their default get another one.
+  def destroy_with_cleanup!
+    transaction do
+      self.class.where(id: id).lock("FOR UPDATE").pluck(:id).presence or raise ActiveRecord::RecordNotFound
+      user_ids = memberships.order(:user_id).pluck(:user_id)
+      user_ids.each { |uid| GroupMembership.lock_defaults_for(uid) }
+      GroupMembership.where(group_id: id).delete_all
+      Ticket.where(group_id: id).update_all(group_id: nil, assignee_id: nil)
+      self.class.where(id: id).delete_all
+      user_ids.each { |uid| GroupMembership.ensure_default_for(uid) }
+    end
+    freeze
+  end
+end
diff --git a/app/models/group_membership.rb b/app/models/group_membership.rb
new file mode 100644
index 0000000..abf0149
--- /dev/null
+++ b/app/models/group_membership.rb
@@ -0,0 +1,102 @@
+# A staff member's membership in a group. Every staff member with memberships
+# has exactly one default membership (used when they're assigned an ungrouped
+# ticket). Memberships survive suspension.
+class GroupMembership < ApplicationRecord
+  DEFAULT_LOCK_NAMESPACE = 48_151
+
+  belongs_to :account
+  belongs_to :group, inverse_of: :memberships
+  belongs_to :user
+
+  scope :by_id, -> { order(id: :asc) }
+  scope :defaults, -> { where(default: true) }
+
+  validate :group_and_user_belong_to_account
+  validates :user_id, uniqueness: { scope: :group_id, message: "is already a member of this group" },
+                      if: -> { group_id && user_id }
+
+  # Serializes changes to one user's default membership.
+  def self.lock_defaults_for(user_id)
+    connection.execute(sanitize_sql_array([ "SELECT pg_advisory_xact_lock(?, ?)", DEFAULT_LOCK_NAMESPACE, user_id.to_i % 2_147_483_647 ]))
+  end
+
+  # Makes the user's oldest remaining membership the default if none is.
+  def self.ensure_default_for(user_id)
+    scope = where(user_id: user_id)
+    return if scope.defaults.exists?
+    first = scope.by_id.first
+    first&.update_columns(default: true, updated_at: Time.current)
+  end
+
+  # Adds +user+ to +group+. default: true/false/nil. A user's first membership is
+  # always their default.
+  def self.add!(account:, group_id:, user_id:, default: nil)
+    membership = new(account: account)
+    gid = Ticket.parse_id(group_id)
+    uid = Ticket.parse_id(user_id)
+    membership.errors.add(:group_id, gid == false ? "must be a group id" : "can't be blank") unless gid
+    membership.errors.add(:user_id, uid == false ? "must be a user id" : "can't be blank") unless uid
+    membership.errors.add(:default, "must be true or false") if default == :invalid
+    if gid && !account.groups.exists?(id: gid)
+      membership.errors.add(:group_id, "must be a group of this account")
+    end
+    if uid && !account.users.staff.exists?(id: uid)
+      membership.errors.add(:user_id, "must be a staff member of this account")
+    end
+    raise ActiveRecord::RecordInvalid, membership if membership.errors.any?
+
+    membership.group_id = gid
+    membership.user_id = uid
+    transaction do
+      unless account.groups.where(id: gid).lock("FOR KEY SHARE").exists?
+        membership.errors.add(:group_id, "must be a group of this account")
+        raise ActiveRecord::RecordInvalid, membership
+      end
+      lock_defaults_for(uid)
+      membership.validate!
+      existing = where(user_id: uid)
+      make_default = default == true || !existing.defaults.exists?
+      existing.defaults.update_all(default: false, updated_at: Time.current) if make_default
+      membership.default = make_default
+      membership.save!
+    end
+    membership
+  rescue ActiveRecord::RecordNotUnique
+    membership.errors.add(:user_id, "is already a member of this group")
+    raise ActiveRecord::RecordInvalid, membership
+  end
+
+  def make_default!
+    transaction do
+      self.class.lock_defaults_for(user_id)
+      reload
+      unless default
+        self.class.where(user_id: user_id).defaults.update_all(default: false, updated_at: Time.current)
+        update!(default: true)
+      end
+    end
+    self
+  end
+
+  # Removes the membership, unassigning the user from the group's tickets and
+  # picking another default if this was it.
+  def destroy_with_cleanup!
+    transaction do
+      self.class.lock_defaults_for(user_id)
+      deleted = self.class.where(id: id).delete_all
+      raise ActiveRecord::RecordNotFound if deleted.zero?
+      Ticket.where(group_id: group_id, assignee_id: user_id).update_all(assignee_id: nil)
+      self.class.ensure_default_for(user_id)
+    end
+    freeze
+  end
+
+  private
+
+  def group_and_user_belong_to_account
+    errors.add(:group_id, "must be a group of this account") if group && group.account_id != account_id
+    if user && (user.account_id != account_id || !user.staff?)
+      errors.add(:user_id, "must be a staff member of this account")
+    end
+  end
+end
diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..43276e4
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,147 @@
+# An invitation for someone to join an account's staff as an admin or agent.
+#
+# The stored status is pending, accepted, revoked or expired. A pending invitation
+# whose expires_at has passed is reported (and filtered) as expired; it is
+# persisted as expired lazily, when it would otherwise block a new invitation.
+class Invitation < ApplicationRecord
+  TTL = 7.days
+  ROLES = User::STAFF_ROLES
+  STATUSES = %w[pending accepted revoked expired].freeze
+
+  belongs_to :account
+  belongs_to :invited_by, class_name: "User", optional: true
+  belongs_to :user, optional: true
+
+  attr_reader :token
+
+  normalizes :email, with: ->(v) { v.to_s.strip.downcase }
+
+  validates :email, presence: true, length: { maximum: 254 },
+                    format: { with: User::EMAIL_FORMAT, allow_blank: true }
+  validates :role, inclusion: { in: ROLES, message: "must be one of: #{ROLES.join(', ')}" }
+  validates :status, inclusion: { in: STATUSES }
+
+  scope :by_id, -> { order(id: :asc) }
+  scope :pending, ->(now = Time.current) { where(status: "pending").where(arel_table[:expires_at].gt(now)) }
+  scope :expired, ->(now = Time.current) { where(status: "expired").or(where(status: "pending", expires_at: ..now)) }
+  scope :accepted, -> { where(status: "accepted") }
+  scope :revoked, -> { where(status: "revoked") }
+
+  def self.with_status(status)
+    case status
+    when "pending" then pending
+    when "expired" then expired
+    when "accepted" then accepted
+    when "revoked" then revoked
+    end
+  end
+
+  def self.find_by_token(token)
+    return nil if token.blank? || !token.is_a?(String)
+    find_by(token_digest: User.digest(token))
+  end
+
+  # Creates a pending invitation and returns it (with #token set).
+  # Raises ActiveRecord::RecordInvalid when the email is already a member or
+  # already has a pending invitation.
+  def self.invite!(account:, inviter:, email:, role:)
+    invitation = account.invitations.build(email: email, role: role, invited_by: inviter, status: "pending")
+    invitation.send(:assign_new_token)
+    invitation.validate
+    raise ActiveRecord::RecordInvalid, invitation if invitation.errors.any?
+
+    transaction do
+      account.lock!
+      invitation.send(:check_email_available!)
+      account.invitations.where(status: "pending", email: invitation.email, expires_at: ..Time.current)
+             .update_all(status: "expired", updated_at: Time.current)
+      invitation.save!
+    end
+    invitation
+  rescue ActiveRecord::RecordNotUnique
+    invitation.errors.add(:email, "already has a pending invitation")
+    raise ActiveRecord::RecordInvalid, invitation
+  end
+
+  def current_status(now = Time.current)
+    status == "pending" && expires_at <= now ? "expired" : status
+  end
+
+  def pending?(now = Time.current) = current_status(now) == "pending"
+  def expired?(now = Time.current) = current_status(now) == "expired"
+  def accepted? = status == "accepted"
+  def revoked? = status == "revoked"
+
+  # Issues a fresh link (invalidating the previous one) and renews the expiry.
+  # Expired invitations are revived as long as nobody else claimed the email.
+  def resend!
+    transaction do
+      account.lock!
+      lock!
+      raise_conflict!("Only pending or expired invitations can be resent") unless pending? || expired?
+      self.status = "pending"
+      check_email_available!(except_self: true)
+      assign_new_token
+      self.sent_count += 1
+      save!
+    end
+    self
+  rescue ActiveRecord::RecordNotUnique
+    errors.add(:email, "already has a pending invitation")
+    raise ActiveRecord::RecordInvalid, self
+  end
+
+  def revoke!
+    transaction do
+      lock!
+      raise_conflict!("Only pending or expired invitations can be revoked") unless pending? || expired?
+      update!(status: "revoked", revoked_at: Time.current)
+    end
+    self
+  end
+
+  # Creates the staff user for this invitation. The invited address is considered
+  # verified because the token was delivered to it.
+  def accept!(name:, password:)
+    new_user = account.users.build(name: name, email: email, role: role, verified_at: Time.current)
+    new_user.password = password.to_s
+    raise ActiveRecord::RecordInvalid, new_user unless new_user.valid?
+
+    transaction do
+      account.lock!
+      lock!
+      raise_conflict!("This invitation is no longer valid") unless pending?
+      new_user.save!
+      update!(status: "accepted", accepted_at: Time.current, user: new_user)
+    end
+    new_user
+  rescue ActiveRecord::RecordNotUnique
+    new_user.errors.add(:email, :taken)
+    raise ActiveRecord::RecordInvalid, new_user
+  end
+
+  class Conflict < StandardError; end
+
+  private
+
+  def raise_conflict!(message) = raise(Conflict, message)
+
+  def assign_new_token
+    @token = User.new_token
+    now = Time.current
+    self.token_digest = User.digest(@token)
+    self.expires_at = now + TTL
+    self.last_sent_at = now
+  end
+
+  def check_email_available!(except_self: false)
+    if account.users.exists?(email: email)
+      errors.add(:email, "already belongs to a member of this account")
+    else
+      competing = account.invitations.pending.where(email: email)
+      competing = competing.where.not(id: id) if except_self
+      errors.add(:email, "already has a pending invitation") if competing.exists?
+    end
+    raise ActiveRecord::RecordInvalid, self if errors.any?
+  end
+end
diff --git a/app/models/session.rb b/app/models/session.rb
new file mode 100644
index 0000000..74cf1ed
--- /dev/null
+++ b/app/models/session.rb
@@ -0,0 +1,34 @@
+class Session < ApplicationRecord
+  TTL = 30.days
+
+  belongs_to :user
+
+  attr_reader :token
+
+  before_validation :assign_token, on: :create
+
+  def self.authenticate(token)
+    return nil if token.blank?
+    session = includes(user: :account).find_by(token_digest: User.digest(token))
+    return nil unless session
+    if session.expires_at <= Time.current
+      session.delete
+      return nil
+    end
+    session.touch_usage
+    session
+  end
+
+  def touch_usage
+    now = Time.current
+    update_columns(last_used_at: now, expires_at: now + TTL) if last_used_at.nil? || last_used_at < 1.minute.ago
+  end
+
+  private
+
+  def assign_token
+    @token = User.new_token
+    self.token_digest = User.digest(@token)
+    self.expires_at ||= TTL.from_now
+  end
+end
diff --git a/app/models/support_address.rb b/app/models/support_address.rb
new file mode 100644
index 0000000..d17b932
--- /dev/null
+++ b/app/models/support_address.rb
@@ -0,0 +1,43 @@
+# Support email addresses at Helpdesk::Config.support_domain:
+#
+#   acme@support.example.test              a business's support address (opens tickets)
+#   acme+<reply_token>@support.example.test  a ticket's private reply address
+class SupportAddress
+  attr_reader :subdomain, :token
+
+  # Parses an address (String or Mail::Address); nil unless it is at the support domain.
+  def self.parse(address)
+    address = Mail::Address.new(address.to_s) unless address.is_a?(Mail::Address)
+    domain = address.domain.to_s.strip.downcase
+    local = address.local.to_s.strip.downcase
+    return nil if local.empty? || domain != Helpdesk::Config.support_domain
+
+    subdomain, token = local.split("+", 2)
+    return nil if subdomain.blank?
+    new(subdomain, token.presence)
+  rescue Mail::Field::ParseError, ArgumentError
+    nil
+  end
+
+  def self.for_account(account)
+    "#{account.subdomain}@#{Helpdesk::Config.support_domain}"
+  end
+
+  def self.for_ticket(ticket)
+    "#{ticket.account.subdomain}+#{ticket.reply_token}@#{Helpdesk::Config.support_domain}"
+  end
+
+  def self.support_domain?(address)
+    address = Mail::Address.new(address.to_s) unless address.is_a?(Mail::Address)
+    address.domain.to_s.strip.downcase == Helpdesk::Config.support_domain
+  rescue Mail::Field::ParseError, ArgumentError
+    false
+  end
+
+  def initialize(subdomain, token)
+    @subdomain = subdomain
+    @token = token
+  end
+
+  def reply? = token.present?
+end
