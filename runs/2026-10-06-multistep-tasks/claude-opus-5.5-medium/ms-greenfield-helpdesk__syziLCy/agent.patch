diff --git a/config/initializers/action_mailbox.rb b/config/initializers/action_mailbox.rb
new file mode 100644
index 0000000..6c69fa8
--- /dev/null
+++ b/config/initializers/action_mailbox.rb
@@ -0,0 +1,19 @@
+# In environments that set config.x.inbound_email.process_inline (test), incoming
+# mail is routed and processed synchronously right after the ingress stores it,
+# so the relay request only completes once the email has been handled and no
+# job worker is needed. Elsewhere Action Mailbox enqueues a RoutingJob as usual.
+ActiveSupport.on_load(:action_mailbox_inbound_email) do
+  if Rails.application.config.x.inbound_email.process_inline
+    prepend(Module.new do
+      def route_later
+        route
+      end
+
+      # Already routed inline on create (e.g. by Action Mailbox's test helpers,
+      # which route again explicitly): don't process the same email twice.
+      def route
+        super unless delivered? || bounced? || failed?
+      end
+    end)
+  end
+end
