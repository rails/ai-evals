+module Api
+  module V1
+    # Departments such as Billing. Staff can browse; admins manage.
+    class GroupsController < BaseController
+      wrap_parameters false
+
+      before_action :require_account!
+      before_action :require_authentication!
+      before_action :require_active_account!
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create update destroy]
+      before_action :load_group, only: %i[show update destroy]
+
+      # GET /api/v1/groups
+      def index
+        records, meta = paginate(current_account.groups.by_id)
+        render json: { groups: records.map { |g| group_json(g) } }.merge(meta)
+      end
+
+      # GET /api/v1/groups/:id
+      def show
+        render json: { group: group_json(@group) }
+      end
+
+      # POST /api/v1/groups  {"group": {"name": "Billing"}}
+      def create
+        group = current_account.groups.new
+        group.save_name!(name_param)
+        render json: { group: group_json(group) }, status: :created
+      end
+
+      # PATCH /api/v1/groups/:id  {"group": {"name": "Payments"}}
+      def update
