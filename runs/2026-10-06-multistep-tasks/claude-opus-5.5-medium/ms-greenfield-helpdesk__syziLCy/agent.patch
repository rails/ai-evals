+# Shared token lookup for the public invitation endpoints.
+module InvitationTokens
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :require_account!
+    before_action :require_active_account!
+
+    rate_limit to: 20, within: 1.minute, only: :create,
+               by: -> { "#{request.remote_ip}:#{request.headers[self.class::ACCOUNT_HEADER]}" },
+               with: -> { render_error :too_many_requests, "rate_limited", "Too many requests, try again later" }
+  end
+
+  private
+
+  # Returns the pending invitation for +token+ in the current account, or renders
+  # an error and returns nil.
+  def usable_invitation(token)
+    invitation = current_account.invitations.find_by_token(token)
+    if invitation&.pending?
+      invitation
+    else
+      render_invalid_invitation
+      nil
+    end
+  end
+
+  def render_invalid_invitation
+    render_error :unprocessable_content, "invalid_token", "Invitation link is invalid or has expired"
+  end
+end
diff --git a/app/controllers/concerns/json_rendering.rb b/app/controllers/concerns/json_rendering.rb
new file mode 100644
index 0000000..27b1f8f
--- /dev/null
+++ b/app/controllers/concerns/json_rendering.rb
@@ -0,0 +1,172 @@
+module JsonRendering
+  extend ActiveSupport::Concern
+
+  private
+
+  def render_error(status, code, message, details: nil)
+    body = { error: { code: code, message: message } }
+    body[:error][:details] = details if details
+    render json: body, status: status
+  end
+
+  def render_validation_errors(*records)
+    details = {}
+    records.compact.each do |record|
+      record.errors.to_hash(true).each { |attr, msgs| (details[attr] ||= []).concat(msgs) }
+    end
+    render_error :unprocessable_content, "validation_failed", "Validation failed", details: details
+  end
+
+  def time(value) = value&.utc&.iso8601(3)
+
+  def account_json(account)
+    {
+      id: account.id,
+      name: account.name,
+      subdomain: account.subdomain,
+      status: account.status,
+      owner_id: account.owner_id,
+      cancelled_at: time(account.cancelled_at),
+      reactivatable_until: time(account.reactivatable_until),
+      created_at: time(account.created_at),
+      updated_at: time(account.updated_at)
+    }
+  end
+
+  def portal_json(account)
+    { name: account.name, subdomain: account.subdomain }
+  end
+
+  def user_json(user)
+    {
+      id: user.id,
+      account_id: user.account_id,
+      name: user.name,
+      email: user.email,
+      role: user.role,
+      owner: user.owner?,
+      verified: user.verified?,
+      verified_at: time(user.verified_at),
+      suspended: user.suspended?,
+      suspended_at: time(user.suspended_at),
+      created_at: time(user.created_at),
+      updated_at: time(user.updated_at)
+    }
+  end
+
+  # What the requester sees: internal activity (private notes, assignment) is not
+  # reflected, so updated_at is the last requester-visible activity.
+  def request_json(ticket)
+    {
+      id: ticket.id,
+      subject: ticket.subject,
+      status: ticket.status,
+      channel: ticket.channel,
+      requester_id: ticket.requester_id,
+      merged_into_id: ticket.merged_into_id,
+      created_at: time(ticket.created_at),
+      updated_at: time(ticket.public_activity_at)
+    }
+  end
+
+  def ticket_json(ticket)
+    requester = ticket.requester
+    assignee = ticket.assignee
+    {
+      id: ticket.id,
+      subject: ticket.subject,
+      status: ticket.status,
+      priority: ticket.priority,
+      channel: ticket.channel,
+      requester_id: ticket.requester_id,
+      requester: { id: requester.id, name: requester.name, email: requester.email },
+      assignee_id: ticket.assignee_id,
+      assignee: assignee && { id: assignee.id, name: assignee.name },
+      group_id: ticket.group_id,
+      group: ticket.group && { id: ticket.group.id, name: ticket.group.name },
+      merged_into_id: ticket.merged_into_id,
+      merged_at: time(ticket.merged_at),
+      created_at: time(ticket.created_at),
+      updated_at: time(ticket.updated_at)
+    }
+  end
+
+  def group_json(group)
+    {
+      id: group.id,
+      name: group.name,
+      created_at: time(group.created_at),
+      updated_at: time(group.updated_at)
+    }
+  end
+
+  def group_membership_json(membership)
+    group = membership.group
+    user = membership.user
+    {
+      id: membership.id,
+      group_id: membership.group_id,
+      user_id: membership.user_id,
+      default: membership.default,
+      group: { id: group.id, name: group.name },
+      user: { id: user.id, name: user.name, email: user.email, role: user.role, suspended: user.suspended? },
+      created_at: time(membership.created_at),
+      updated_at: time(membership.updated_at)
+    }
+  end
+
+  def staff_member_json(user)
+    { id: user.id, name: user.name, email: user.email, role: user.role }
+  end
+
+  def invitation_json(invitation)
+    inviter = invitation.invited_by
+    {
+      id: invitation.id,
+      account_id: invitation.account_id,
+      email: invitation.email,
+      role: invitation.role,
+      status: invitation.current_status,
+      expires_at: time(invitation.expires_at),
+      invited_by_id: invitation.invited_by_id,
+      invited_by: inviter && { id: inviter.id, name: inviter.name },
+      user_id: invitation.user_id,
+      sent_count: invitation.sent_count,
+      last_sent_at: time(invitation.last_sent_at),
+      accepted_at: time(invitation.accepted_at),
+      revoked_at: time(invitation.revoked_at),
+      created_at: time(invitation.created_at),
+      updated_at: time(invitation.updated_at)
+    }
+  end
+
+  def invitation_preview_json(invitation)
+    account = invitation.account
+    {
+      email: invitation.email,
+      role: invitation.role,
+      account_name: account.name,
+      subdomain: account.subdomain,
+      account: portal_json(account),
+      expires_at: time(invitation.expires_at)
+    }
+  end
+
+  def comment_json(comment)
+    {
+      id: comment.id,
+      body: comment.body,
+      author: { id: comment.author.id, name: comment.author.name },
+      public: comment.public,
+      created_at: time(comment.created_at)
+    }
+  end
+
+  def session_json(session)
+    {
+      token: session.token,
+      expires_at: time(session.expires_at),
+      created_at: time(session.created_at)
+    }
+  end
+end
diff --git a/app/controllers/concerns/pagination.rb b/app/controllers/concerns/pagination.rb
new file mode 100644
index 0000000..ccfec17
--- /dev/null
+++ b/app/controllers/concerns/pagination.rb
@@ -0,0 +1,232 @@
+# List pagination.
+#
+# Two modes share one entry point, +paginate(scope)+:
+#
+# * Page numbers (legacy): ?page=2&per_page=25 → count/page/per_page/next_page/previous_page.
+#   ?page[number]=2&page[size]=25 is accepted as an equivalent spelling.
+# * Cursors (keyset): ?page[size]=25, then ?page[after]=<cursor> or ?page[before]=<cursor>
+#   → meta {has_more, after_cursor, before_cursor} and links {next, prev}.
+#
+# Cursor pagination seeks with a row comparison on the scope's ORDER BY columns
+# (always ending with the primary key), so deep pages cost the same as the first
+# one. A cursor carries the sort values of its boundary record rather than a
+# reference to it, so navigation stays stable when that record is updated (and
+# re-sorted), deleted, or when new records are inserted while someone browses.
+module Pagination
+  extend ActiveSupport::Concern
+
+  DEFAULT_PER_PAGE = 25
+  MAX_PER_PAGE = 100
+  CURSOR_VERSION = 1
+  MAX_CURSOR_LENGTH = 1024
+  BIGINT_RANGE = (-(2**63))..(2**63 - 1)
+
+  class InvalidPage < StandardError; end
+
+  included do
+    rescue_from Pagination::InvalidPage do |e|
+      render_error :bad_request, "invalid_page", e.message
+    end
+  end
+
+  private
+
+  # Returns [records, extra] where +extra+ is merged into the response body.
+  def paginate(scope)
+    page = params[:page]
+    if page.is_a?(ActionController::Parameters)
+      return paginate_by_number(scope, page[:number], page[:size]) if page.key?(:number)
+      paginate_by_cursor(scope, page)
+    else
+      paginate_by_number(scope, page, params[:per_page])
+    end
+  end
+
+  # --- Page numbers -------------------------------------------------------
+
+  def paginate_by_number(scope, page_value, size_value)
+    page = positive_int(page_value, 1)
+    per_page = positive_int(size_value, DEFAULT_PER_PAGE).clamp(1, MAX_PER_PAGE)
+    count = scope.count
+    records = scope.offset((page - 1) * per_page).limit(per_page).to_a
+    meta = {
+      count: count,
+      page: page,
+      per_page: per_page,
+      next_page: page * per_page < count ? page + 1 : nil,
+      previous_page: page > 1 ? page - 1 : nil
+    }
+    [ records, meta ]
+  end
+
+  def positive_int(value, default)
+    return default if value.is_a?(ActionController::Parameters) || value.is_a?(Array)
+    int = Integer(value.to_s, 10, exception: false)
+    int && int >= 1 ? int : default
+  end
+
+  # --- Cursors ------------------------------------------------------------
+
+  def paginate_by_cursor(scope, page)
+    size = positive_int(page[:size], DEFAULT_PER_PAGE).clamp(1, MAX_PER_PAGE)
+    after = cursor_param(page, :after)
+    before = cursor_param(page, :before)
+    raise InvalidPage, "Use either page[after] or page[before], not both" if after && before
+
+    keys = sort_keys(scope)
+    signature = cursor_signature(scope, keys)
+    direction = before ? :backward : :forward
+    position = decode_cursor(after || before, keys, signature) if after || before
+
+    base = scope.unscope(:order)
+    query = base.order(order_for(keys, reverse: direction == :backward))
+    query = query.where(*seek_condition(scope, keys, position, direction == :forward ? :after : :before)) if position
+    rows = query.limit(size + 1).to_a
+    has_more = rows.size > size
+    rows = rows.first(size)
+    rows.reverse! if direction == :backward
+
+    first_values = rows.first && keys.map { |k| rows.first.public_send(k[:name]) }
+    last_values = rows.last && keys.map { |k| rows.last.public_send(k[:name]) }
+    after_cursor = last_values && encode_cursor(last_values, keys, signature)
+    before_cursor = first_values && encode_cursor(first_values, keys, signature)
+
+    next_link = prev_link = nil
+    if direction == :forward
+      next_link = page_link(size, after: after_cursor) if has_more
+      # Anything before this page? None on a first page; otherwise check.
+      if position
+        boundary = first_values || position
+        if records_beyond?(base, scope, keys, boundary, :before)
+          prev_link = page_link(size, before: before_cursor || encode_cursor(boundary, keys, signature))
+        end
+      end
+    else
+      prev_link = page_link(size, before: before_cursor) if has_more
+      boundary = last_values || position
+      if records_beyond?(base, scope, keys, boundary, :after)
+        next_link = page_link(size, after: after_cursor || encode_cursor(boundary, keys, signature))
+      end
+    end
+
+    extra = {
+      meta: { has_more: has_more, after_cursor: after_cursor, before_cursor: before_cursor },
+      links: { next: next_link, prev: prev_link }
+    }
+    [ rows, extra ]
+  end
+
+  def cursor_param(page, name)
+    value = page[name]
+    return nil if value.nil?
+    raise InvalidPage, "page[#{name}] must be a single value" unless value.is_a?(String)
+    value.strip.presence
+  end
+
+  # [{name:, column:, type:, desc:}] from the scope's ORDER BY, with the primary
+  # key appended as a tie-breaker when it isn't already the last key.
+  def sort_keys(scope)
+    model = scope.model
+    keys = scope.order_values.map do |node|
+      desc = node.is_a?(Arel::Nodes::Descending)
+      attr = node.respond_to?(:expr) ? node.expr : node
+      unless attr.is_a?(Arel::Attributes::Attribute) && attr.relation.name == model.table_name
+        raise ArgumentError, "cursor pagination needs plain column ordering on #{model.table_name}"
+      end
+      name = attr.name.to_s
+      column = model.columns_hash.fetch(name)
+      raise ArgumentError, "cursor pagination can't sort on nullable #{name}" if column.null
+      { name: name, type: column.type, desc: desc }
+    end
+    pk = model.primary_key
+    keys << { name: pk, type: model.columns_hash.fetch(pk).type, desc: keys.last ? keys.last[:desc] : false } unless keys.last&.dig(:name) == pk
+    keys
+  end
+
+  def order_for(keys, reverse:)
+    keys.map { |k| [ k[:name], (k[:desc] ^ reverse) ? :desc : :asc ] }.to_h
+  end
+
+  # SQL condition selecting rows strictly after/before +values+ in the list's order.
+  def seek_condition(scope, keys, values, side)
+    conn = scope.connection
+    table = conn.quote_table_name(scope.model.table_name)
+    cols = keys.map { |k| "#{table}.#{conn.quote_column_name(k[:name])}" }
+    op_for = ->(key) { (key[:desc] ^ (side == :before)) ? "<" : ">" }
+
+    if keys.map { |k| k[:desc] }.uniq.size == 1
+      [ "(#{cols.join(', ')}) #{op_for.(keys.first)} (#{Array.new(keys.size, '?').join(', ')})", *values ]
+    else
+      clauses = []
+      binds = []
+      keys.each_index do |i|
+        parts = (0...i).map { |j| "#{cols[j]} = ?" } + [ "#{cols[i]} #{op_for.(keys[i])} ?" ]
+        clauses << "(#{parts.join(' AND ')})"
+        binds.concat(values[0...i]) << values[i]
+      end
+      [ clauses.join(" OR "), *binds ]
+    end
+  end
+
+  def records_beyond?(base, scope, keys, values, side)
+    base.where(*seek_condition(scope, keys, values, side)).exists?
+  end
+
+  # Ties a cursor to one list ordering so it can't be replayed on another list.
+  def cursor_signature(scope, keys)
+    "#{scope.model.table_name}:" + keys.map { |k| "#{k[:name]}.#{k[:desc] ? 'd' : 'a'}" }.join(",")
+  end
+
+  def encode_cursor(values, keys, signature)
+    serialized = values.zip(keys).map do |value, key|
+      case key[:type]
+      when :datetime then value.utc.iso8601(6)
+      else value
+      end
+    end
+    payload = { v: CURSOR_VERSION, k: signature, p: serialized }
+    Base64.urlsafe_encode64(payload.to_json, padding: false)
+  end
+
+  def decode_cursor(cursor, keys, signature)
+    invalid = -> { raise InvalidPage, "Invalid or expired cursor" }
+    invalid.() if cursor.length > MAX_CURSOR_LENGTH
+
+    payload = begin
+      JSON.parse(Base64.urlsafe_decode64(cursor))
+    rescue ArgumentError, JSON::ParserError
+      invalid.()
+    end
+    invalid.() unless payload.is_a?(Hash) && payload["v"] == CURSOR_VERSION && payload["k"] == signature
+    values = payload["p"]
+    invalid.() unless values.is_a?(Array) && values.size == keys.size
+
+    values.zip(keys).map do |value, key|
+      case key[:type]
+      when :integer
+        invalid.() unless value.is_a?(Integer) && BIGINT_RANGE.cover?(value)
+        value
+      when :datetime
+        invalid.() unless value.is_a?(String)
+        begin
+          Time.iso8601(value)
+        rescue ArgumentError
+          invalid.()
+        end
+      when :string, :text
+        invalid.() unless value.is_a?(String)
+        value
+      else
+        invalid.()
+      end
+    end
+  end
+
+  def page_link(size, after: nil, before: nil)
+    query = request.query_parameters.except("page", "per_page")
+    page = { "size" => size }
+    page["after"] = after if after
+    page["before"] = before if before
+    "#{request.base_url}#{request.path}?#{query.merge("page" => page).to_query}"
+  end
+end
diff --git a/app/controllers/concerns/ticket_filters.rb b/app/controllers/concerns/ticket_filters.rb
new file mode 100644
index 0000000..b31dfd0
--- /dev/null
+++ b/app/controllers/concerns/ticket_filters.rb
@@ -0,0 +1,84 @@
+# Query-string filters for GET /tickets (staff) and GET /requests (customers).
+#
+# Blank values are ignored. Invalid values are rejected with 422 rather than
+# silently returning an unfiltered (or empty) list.
+module TicketFilters
+  extend ActiveSupport::Concern
+
+  UNASSIGNED = "unassigned".freeze
+
+  private
+
+  # Staff: status, priority, assignee_id (id or "unassigned"), group_id (id or
+  # "unassigned"), requester_id, q.
+  def filter_tickets(scope)
+    errors = {}
+
+    if (status = filter_param(:status, errors))
+      Ticket::STATUSES.include?(status) ? scope = scope.where(status: status) : errors[:status] = [ "is not included in the list" ]
+    end
+
+    if (priority = filter_param(:priority, errors))
+      Ticket::PRIORITIES.include?(priority) ? scope = scope.where(priority: priority) : errors[:priority] = [ "is not included in the list" ]
+    end
+
+    if (assignee = filter_param(:assignee_id, errors))
+      if assignee.downcase == UNASSIGNED
+        scope = scope.where(assignee_id: nil)
+      elsif (id = Ticket.parse_id(assignee))
+        scope = scope.where(assignee_id: id)
+      else
+        errors[:assignee_id] = [ "must be a user id or \"unassigned\"" ]
+      end
+    end
+
+    if (group = filter_param(:group_id, errors))
+      if group.downcase == UNASSIGNED
+        scope = scope.where(group_id: nil)
+      elsif (id = Ticket.parse_id(group))
+        scope = scope.where(group_id: id)
+      else
+        errors[:group_id] = [ "must be a group id or \"unassigned\"" ]
+      end
+    end
+
+    if (requester = filter_param(:requester_id, errors))
+      if (id = Ticket.parse_id(requester))
+        scope = scope.where(requester_id: id)
+      else
+        errors[:requester_id] = [ "must be a user id" ]
+      end
+    end
+
+    if (q = filter_param(:q, errors))
+      scope = scope.search(q)
+    end
+
+    [ scope, errors ]
+  end
+
+  # Customers: status only.
+  def filter_requests(scope)
+    errors = {}
+    if (status = filter_param(:status, errors))
+      Ticket::STATUSES.include?(status) ? scope = scope.where(status: status) : errors[:status] = [ "is not included in the list" ]
+    end
+    [ scope, errors ]
+  end
+
+  # Stripped string value, or nil when absent/blank. Records an error for
+  # non-scalar values (e.g. status[]=a or status[x]=b).
+  def filter_param(name, errors)
+    value = params[name]
+    return nil if value.nil?
+    unless value.is_a?(String)
+      errors[name] = [ "must be a single value" ]
+      return nil
+    end
+    value.strip.presence
+  end
+
+  def render_filter_errors(errors)
+    render_error :unprocessable_content, "invalid_filter", "Invalid filter", details: errors
+  end
+end
diff --git a/app/controllers/concerns/ticket_updates.rb b/app/controllers/concerns/ticket_updates.rb
new file mode 100644
index 0000000..fbfdf80
--- /dev/null
+++ b/app/controllers/concerns/ticket_updates.rb
@@ -0,0 +1,59 @@
+# Shared parsing for PATCH /tickets/:id and PATCH /requests/:id.
+module TicketUpdates
+  extend ActiveSupport::Concern
+
+  private
+
+  # Returns [comment_hash_or_nil, status_or_nil] from the given envelope.
+  def update_attributes_from(envelope)
+    attrs = params.require(envelope)
+    raise ActionController::ParameterMissing, envelope unless attrs.is_a?(ActionController::Parameters)
+
+    comment = nil
+    if attrs.key?(:comment)
+      raw = attrs[:comment]
+      comment = if raw.is_a?(ActionController::Parameters)
+        raw.permit(:body, :public).to_h.symbolize_keys
+      else
+        { body: nil }
+      end
+    end
+
+    status = attrs[:status]
+    status = status.to_s if status && !status.is_a?(ActionController::Parameters) && !status.is_a?(Array)
+    status = "__invalid__" if status.is_a?(ActionController::Parameters) || status.is_a?(Array)
+    [ comment, status ]
+  end
+
+  # The requested assignee for staff updates: Ticket::UNCHANGED when absent,
+  # nil to unassign, otherwise the raw value (validated by the model).
+  def assignee_from(envelope)
+    attrs = params.require(envelope)
+    return Ticket::UNCHANGED unless attrs.key?(:assignee_id)
+    value = attrs[:assignee_id]
+    value.is_a?(ActionController::Parameters) || value.is_a?(Array) ? "__invalid__" : value
+  end
+
+  # The requested group for staff updates: Ticket::UNCHANGED when absent, nil to
+  # ungroup, otherwise the raw value (validated by the model).
+  def group_from(envelope)
+    attrs = params.require(envelope)
+    return Ticket::UNCHANGED unless attrs.key?(:group_id)
+    value = attrs[:group_id]
+    value.is_a?(ActionController::Parameters) || value.is_a?(Array) ? "__invalid__" : value
+  end
+
+  # The requested priority for staff updates: nil when absent, otherwise a string
+  # (validated by the model).
+  def priority_from(envelope)
+    attrs = params.require(envelope)
+    return nil unless attrs.key?(:priority)
+    value = attrs[:priority]
+    value.nil? || value.is_a?(ActionController::Parameters) || value.is_a?(Array) ? "__invalid__" : value.to_s
+  end
+
+  def comment_body_from(envelope)
+    raw = params.require(envelope)[:comment]
+    raw.is_a?(ActionController::Parameters) ? raw[:body] : nil
+  end
+end
