+# A Message-ID seen on a ticket's email conversation: incoming mail that was
+# processed (used to deduplicate redelivered messages) or a notification we sent.
+# Message-IDs are unique per account.
+class EmailMessage < ApplicationRecord
+  DIRECTIONS = %w[inbound outbound].freeze
+
+  belongs_to :account
+  belongs_to :ticket
+  belongs_to :comment, optional: true
+
+  validates :message_id, presence: true, length: { maximum: 998 }
+  validates :direction, inclusion: { in: DIRECTIONS }
+
+  scope :chronological, -> { order(created_at: :asc, id: :asc) }
+
+  # Normalised form of a Message-ID (no angle brackets or surrounding whitespace).
+  def self.normalize_id(message_id)
+    message_id.to_s.strip.delete_prefix("<").delete_suffix(">").strip.presence
+  end
+
+  def self.processed?(account, message_id)
+    where(account: account, message_id: normalize_id(message_id)).exists?
+  end
+end
