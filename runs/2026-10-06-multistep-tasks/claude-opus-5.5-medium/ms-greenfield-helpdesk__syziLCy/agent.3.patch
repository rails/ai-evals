+module Api
+  module V1
+    # Public: accepting an invitation creates the (already verified) staff user.
+    class InvitationAcceptancesController < BaseController
+      include InvitationTokens
+
+      # POST /api/v1/invitation_acceptances
+      def create
+        attrs = params.require(:invitation_acceptance).permit(:token, :name, :password)
+        invitation = usable_invitation(attrs[:token])
+        return unless invitation
+
+        user = invitation.accept!(name: attrs[:name].to_s, password: attrs[:password].to_s)
+        render json: { user: user_json(user), account: account_json(current_account) }, status: :created
+      rescue Invitation::Conflict
+        render_invalid_invitation
+      end
+    end
+  end
+end
