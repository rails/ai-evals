diff --git a/test/integration/groups_test.rb b/test/integration/groups_test.rb
new file mode 100644
index 0000000..65f3fa6
--- /dev/null
+++ b/test/integration/groups_test.rb
@@ -0,0 +1,233 @@
+require "test_helper"
+
+class GroupsTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    signup_verified
+    @admin = login
+    @jo_id = json.dig("user", "id")
+    @sam_id, @sam = add_member(email: "sam@example.test", role: "agent", name: "Sam")
+    @kim_id, @kim = add_member(email: "kim@example.test", role: "agent", name: "Kim")
+  end
+
+  def add_member(email:, role:, name:)
+    ActionMailer::Base.deliveries.clear
+    api :post, "/invitations", token: @admin, body: { invitation: { email: email, role: role } }
+    token = link_token(ActionMailer::Base.deliveries.last, "/accept-invitation")
+    api :post, "/invitation_acceptances", body: { invitation_acceptance: { token: token, name: name, password: "my-team-password" } }
+    id = json.dig("user", "id")
+    [ id, login(email: email, password: "my-team-password") ]
+  end
+
+  def customer
+    api :post, "/registrations", body: { user: { name: "Avery", email: "avery@example.test", password: "my-customer-password" } }
+    User.find_by(email: "avery@example.test").update!(verified_at: Time.current)
+    login(email: "avery@example.test", password: "my-customer-password")
+  end
+
+  def group(name)
+    api :post, "/groups", token: @admin, body: { group: { name: name } }
+    assert_response :created
+    json.dig("group", "id")
+  end
+
+  def member(group_id, user_id, default: nil)
+    body = { group_id: group_id, user_id: user_id }
+    body[:default] = default unless default.nil?
+    api :post, "/group_memberships", token: @admin, body: { group_membership: body }
+    assert_response :created, response.body
+    json["group_membership"]
+  end
+
+  def ticket(token)
+    api :post, "/requests", token: token, body: { request: { subject: "Help", comment: { body: "Please" } } }
+    json.dig("request", "id")
+  end
+
+  def patch_ticket(id, attrs, token: @admin)
+    api :patch, "/tickets/#{id}", token: token, body: { ticket: attrs }
+    json["ticket"]
+  end
+
+  test "group CRUD and permissions" do
+    billing = group("Billing")
+    tech = group("Technical Support")
+    api :post, "/groups", token: @admin, body: { group: { name: " billing " } }
+    assert_response :unprocessable_content
+    assert json.dig("error", "details", "name")
+    api :post, "/groups", token: @admin, body: { group: { name: "" } }
+    assert_response :unprocessable_content
+    api :post, "/groups", token: @sam, body: { group: { name: "X" } }
+    assert_response :forbidden
+
+    api :get, "/groups", token: @sam
+    assert_response :success
+    assert_equal [ billing, tech ], json["groups"].map { _1["id"] }
+    assert_equal 2, json["count"]
+    api :get, "/groups/#{billing}", token: @sam
+    assert_equal "Billing", json.dig("group", "name")
+
+    api :patch, "/groups/#{billing}", token: @sam, body: { group: { name: "Payments" } }
+    assert_response :forbidden
+    api :patch, "/groups/#{billing}", token: @admin, body: { group: { name: "Payments" } }
+    assert_response :success
+    assert_equal "Payments", json.dig("group", "name")
+    api :patch, "/groups/#{billing}", token: @admin, body: { group: { name: "technical support" } }
+    assert_response :unprocessable_content
+
+    api :delete, "/groups/#{tech}", token: @sam
+    assert_response :forbidden
+    api :delete, "/groups/#{tech}", token: @admin
+    assert_response :no_content
+    api :get, "/groups/#{tech}", token: @admin
+    assert_response :not_found
+
+    avery = customer
+    api :get, "/groups", token: avery
+    assert_response :forbidden
+    api :get, "/group_memberships", token: avery
+    assert_response :forbidden
+  end
+
+  test "memberships and defaults" do
+    billing = group("Billing")
+    tech = group("Technical Support")
+    m1 = member(billing, @sam_id, default: false)
+    assert_equal true, m1["default"], "first membership is always default"
+    m2 = member(tech, @sam_id)
+    assert_equal false, m2["default"]
+    m3 = member(tech, @kim_id, default: true)
+    assert m3["default"]
+
+    api :post, "/group_memberships", token: @admin, body: { group_membership: { group_id: tech, user_id: @sam_id } }
+    assert_response :unprocessable_content
+    avery = customer
+    avery_id = User.find_by(email: "avery@example.test").id
+    api :post, "/group_memberships", token: @admin, body: { group_membership: { group_id: tech, user_id: avery_id } }
+    assert_response :unprocessable_content
+    api :post, "/group_memberships", token: @admin, body: { group_membership: { group_id: 999999, user_id: @jo_id } }
+    assert_response :unprocessable_content
+    api :post, "/group_memberships", token: @sam, body: { group_membership: { group_id: tech, user_id: @jo_id } }
+    assert_response :forbidden
+
+    api :get, "/group_memberships", token: @sam
+    assert_equal [ m1["id"], m2["id"], m3["id"] ], json["group_memberships"].map { _1["id"] }
+    api :get, "/group_memberships?group_id=#{tech}", token: @sam
+    assert_equal [ m2["id"], m3["id"] ], json["group_memberships"].map { _1["id"] }
+    api :get, "/group_memberships?user_id=#{@sam_id}&group_id=#{tech}", token: @sam
+    assert_equal [ m2["id"] ], json["group_memberships"].map { _1["id"] }
+    api :get, "/group_memberships?user_id=abc", token: @sam
+    assert_response :unprocessable_content
+
+    api :put, "/group_memberships/#{m2['id']}/make_default", token: @sam
+    assert_response :forbidden
+    api :put, "/group_memberships/#{m2['id']}/make_default", token: @admin
+    assert_response :success
+    assert json.dig("group_membership", "default")
+    api :get, "/group_memberships/#{m1['id']}", token: @sam
+    assert_equal false, json.dig("group_membership", "default")
+
+    # Default with default: true on create moves it.
+    ops = group("Ops")
+    m4 = member(ops, @sam_id, default: true)
+    assert m4["default"]
+    assert_equal [ m4["id"] ], GroupMembership.where(user_id: @sam_id, default: true).pluck(:id)
+
+    # Removing the default picks another.
+    api :delete, "/group_memberships/#{m4['id']}", token: @admin
+    assert_response :no_content
+    assert_equal [ m1["id"] ], GroupMembership.where(user_id: @sam_id, default: true).pluck(:id)
+
+    # Deleting a group reassigns defaults.
+    api :delete, "/groups/#{billing}", token: @admin
+    assert_equal [ m2["id"] ], GroupMembership.where(user_id: @sam_id, default: true).pluck(:id)
+
+    # Suspension keeps memberships.
+    api :patch, "/users/#{@sam_id}", token: @admin, body: { user: { suspended: true } }
+    assert_response :success
+    api :get, "/group_memberships?user_id=#{@sam_id}", token: @admin
+    assert_equal [ m2["id"] ], json["group_memberships"].map { _1["id"] }
+  end
+
+  test "ticket groups and assignment rules" do
+    billing = group("Billing")
+    tech = group("Technical Support")
+    member(billing, @sam_id)
+    member(tech, @sam_id)
+    member(tech, @kim_id)
+    avery = customer
+    t1 = ticket(avery)
+    t2 = ticket(avery)
+
+    patch_ticket(t1, { status: nil })
+    assert_response :unprocessable_content
+
+    # Assigning on an ungrouped ticket uses the default group.
+    t = patch_ticket(t1, { assignee_id: @sam_id })
+    assert_response :success
+    assert_equal billing, t["group_id"]
+    assert_equal({ "id" => billing, "name" => "Billing" }, t["group"])
+
+    # Someone outside the group can't be assigned.
+    patch_ticket(t1, { assignee_id: @kim_id })
+    assert_response :unprocessable_content
+    patch_ticket(t1, { assignee_id: @jo_id })
+    assert_response :unprocessable_content
+
+    # Moving the group with a member keeps them; with a non-member clears.
+    t = patch_ticket(t1, { group_id: tech })
+    assert_equal [ tech, @sam_id ], t.values_at("group_id", "assignee_id")
+    t = patch_ticket(t1, { assignee_id: @kim_id })
+    assert_equal [ tech, @kim_id ], t.values_at("group_id", "assignee_id")
+    t = patch_ticket(t1, { group_id: billing })
+    assert_equal [ billing, nil ], t.values_at("group_id", "assignee_id")
+    # Group + assignee together
+    t = patch_ticket(t1, { group_id: tech, assignee_id: @kim_id })
+    assert_equal [ tech, @kim_id ], t.values_at("group_id", "assignee_id")
+    patch_ticket(t1, { group_id: billing, assignee_id: @kim_id })
+    assert_response :unprocessable_content
+
+    # Clearing the assignee keeps the group.
+    t = patch_ticket(t1, { assignee_id: nil })
+    assert_equal [ tech, nil ], t.values_at("group_id", "assignee_id")
+    # Clearing the group clears the assignee.
+    patch_ticket(t1, { assignee_id: @kim_id })
+    t = patch_ticket(t1, { group_id: nil })
+    assert_equal [ nil, nil, nil ], t.values_at("group_id", "group", "assignee_id")
+
+    # No memberships: ungrouped assignment is fine.
+    t = patch_ticket(t2, { assignee_id: @jo_id })
+    assert_equal [ nil, @jo_id ], t.values_at("group_id", "assignee_id")
+    patch_ticket(t2, { group_id: 999999 })
+    assert_response :unprocessable_content
+    patch_ticket(t2, { group_id: "abc" })
+    assert_response :unprocessable_content
+
+    # Filters
+    patch_ticket(t1, { group_id: tech, assignee_id: @kim_id })
+    api :get, "/tickets?group_id=#{tech}", token: @sam
+    assert_equal [ t1 ], json["tickets"].map { _1["id"] }
+    api :get, "/tickets?group_id=unassigned", token: @sam
+    assert_equal [ t2 ], json["tickets"].map { _1["id"] }
