diff --git a/app/mailboxes/support_mailbox.rb b/app/mailboxes/support_mailbox.rb
new file mode 100644
index 0000000..ae70fbd
--- /dev/null
+++ b/app/mailboxes/support_mailbox.rb
@@ -0,0 +1,10 @@
+# Turns customer email into tickets and ticket replies. See InboundSupportEmail
+# for the rules. Rejected messages are marked bounced; no bounce message is
+# sent (it would mostly be backscatter to forged senders).
+class SupportMailbox < ApplicationMailbox
+  def process
+    result = InboundSupportEmail.new(inbound_email).process
+    Rails.logger.info("[inbound] #{inbound_email.message_id}: #{result.outcome}#{" (#{result.reason})" if result.reason}")
+    bounced! if result.outcome == :rejected
+  end
+end
diff --git a/app/mailers/ticket_mailer.rb b/app/mailers/ticket_mailer.rb
