--- /dev/null
+++ b/config/initializers/action_mailbox.rb
@@ -0,0 +1,17 @@
+# Action Mailbox normally routes each inbound email from a background job.
+# With config.x.inbound_email_inline_routing (enabled in test) the email is
+# routed and processed before the ingress request completes, so no separate
+# worker is needed.
+module InlineInboundEmailRouting
+  def route_later
+    if Rails.configuration.x.inbound_email_inline_routing
+      route
+    else
+      super
+    end
+  end
+end
+
+ActiveSupport.on_load(:action_mailbox_inbound_email) do
+  prepend InlineInboundEmailRouting unless self < InlineInboundEmailRouting
+end
