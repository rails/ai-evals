+  # Merges this (duplicate) ticket into +target+, another ticket of the same
+  # requester, on behalf of staff +actor+:
+  #
+  # * this ticket is closed and points at the target with merged_into_id;
+  #   it stays readable, but can no longer be edited or replied to (by web
+  #   or email). Its comments stay where they are.
+  # * a note is added to each side. Notes are private unless +public+ is
+  #   true; +body+ nil uses a default text.
+  # * the target's status, assignment, group, priority and email identity
+  #   are left alone; it only gets the note (and its activity time).
+  #
+  # Merging a ticket that was itself a merge target later doesn't rewrite
+  # earlier links. Returns [source_comment, target_comment].
+  def merge_into!(target_id:, actor:, source_comment: {}, target_comment: {})
+    raise Closed.new(self) if closed?
+    errors = {}
+    target = account.tickets.find_by(id: target_id) if target_id
+    if (problem = merge_target_errors(target))
+      errors["target_id"] = problem
+    end
+    source_note = Comment.new(ticket: self, author: actor, public: source_comment[:public] == true,
+      body: source_comment[:body].nil? ? default_merge_source_note(target_id, target) : source_comment[:body])
+    target_note = Comment.new(ticket: target || self, author: actor, public: target_comment[:public] == true,
+      body: target_comment[:body].nil? ? "Ticket ##{id} (#{subject}) was merged into this ticket." : target_comment[:body])
+    errors.merge!(merge_comment_errors(source_note, "source_comment"))
+    errors.merge!(merge_comment_errors(target_note, "target_comment"))
+    raise Invalid, errors if errors.any?
+
+    transaction do
+      # Lock both rows in a stable order so crossing merges can't deadlock.
+      locked = Ticket.where(id: [ id, target.id ]).order(:id).lock.index_by(&:id)
+      reload
+      target.reload
+      raise Closed.new(self) if closed?
+      if (problem = merge_target_errors(target))
+        raise Invalid, { "target_id" => problem }
+      end
+      raise ActiveRecord::RecordNotFound unless locked.size == 2
+
+      now = Time.current
+      [ source_note, target_note ].each do |note|
+        note.created_at = note.updated_at = now
+        note.save!
+      end
+      # The status change is visible to the requester.
+      update!(status: "closed", merged_into_id: target.id, merged_at: now,
+        last_activity_at: now, last_public_activity_at: now)
+      target_changes = { last_activity_at: now }
+      target_changes[:last_public_activity_at] = now if target_note.public
+      target.update!(target_changes)
+    end
+    [ source_note, target_note ]
+  end
