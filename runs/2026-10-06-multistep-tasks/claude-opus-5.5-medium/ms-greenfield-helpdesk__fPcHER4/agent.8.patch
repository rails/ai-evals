+# Indexes matching list orderings so cursor (keyset) pages are index range
+# scans regardless of depth.
+class AddCursorPaginationIndexes < ActiveRecord::Migration[8.1]
+  def change
+    add_index :users, [ :account_id, :id ]
+    add_index :tickets, [ :account_id, :status, :last_activity_at, :id ],
+      order: { last_activity_at: :desc, id: :desc }, name: "index_tickets_on_account_status_activity"
+  end
+end
