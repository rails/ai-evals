index 0000000..46cedc7
--- /dev/null
+++ b/app/models/inbound_message_receipt.rb
@@ -0,0 +1,13 @@
+# Records an inbound email Message-ID that was successfully turned into a
+# ticket or reply, so redeliveries of the same message are ignored. Only
+# handled messages are recorded: a rejected delivery never blocks a later,
+# valid one with the same Message-ID.
+class InboundMessageReceipt < ApplicationRecord
+  belongs_to :account
+  belongs_to :ticket
+  belongs_to :comment, optional: true
+
+  def self.received?(account, message_id)
+    exists?(account_id: account.id, message_id: message_id)
+  end
+end
diff --git a/app/models/inbound_support_email.rb b/app/models/inbound_support_email.rb
new file mode 100644
index 0000000..6ab9b11
--- /dev/null
+++ b/app/models/inbound_support_email.rb
@@ -0,0 +1,284 @@
+# Processes one inbound email for the help desk.
+#
+# * The business is found from the recipients (To, Cc, Bcc and the envelope
+#   recipient headers) at Helpdesk::Config.support_domain:
+#   <subdomain>@domain is the business's support address and
+#   <subdomain>+<reply_token>@domain a ticket's private reply address.
+#   Mail addressed to more than one business is ignored.
+# * Mail to a ticket's reply address from that ticket's requester is added
+#   to the conversation as a public reply (reopening a pending/solved ticket).
+#   Anyone else's mail to it is ignored, as is mail to a closed (merged)
+#   ticket.
+# * Otherwise mail to the support address opens a new ticket for the sender,
+#   reusing their customer record or creating an unverified one (and
+#   emailing them a verification link for the portal).
+# * Automated mail (auto-replies, bounces, mailing lists, bulk mail) is ignored.
+# * A Message-ID is handled at most once per business. Only successfully
+#   handled messages count, so a rejected delivery doesn't block a later
+#   valid retry.
+class InboundSupportEmail
+  Result = Struct.new(:outcome, :reason, :ticket, :comment, keyword_init: true)
+  Target = Struct.new(:account, :reply_token, keyword_init: true)
+
+  REPLY_MARKER = "##- Please type your reply above this line -##".freeze
+  NAME_MAX = 100
+  AUTOMATED_LOCAL_PARTS = %w[
+    mailer-daemon postmaster no-reply noreply do-not-reply donotreply bounce bounces
+  ].freeze
+  AUTOMATED_PRECEDENCE = %w[bulk list junk auto_reply].freeze
+  LIST_HEADERS = %w[List-Id List-Unsubscribe List-Post X-Mailing-List Mailing-List].freeze
+  AUTO_REPLY_HEADERS = %w[X-Autoreply X-Autorespond X-Autoresponder X-Loop].freeze
+
+  attr_reader :inbound_email, :mail
+
+  def initialize(inbound_email)
+    @inbound_email = inbound_email
+    @mail = inbound_email.mail
+  end
+
+  def process
+    return reject(:automated) if automated?
+    sender = sender_address
+    return reject(:no_sender) unless sender
+    return reject(:own_address) if own_address?(sender)
+
+    targets = support_targets
+    accounts = targets.map(&:account).uniq
+    return reject(:no_business) if accounts.empty?
+    return reject(:multiple_businesses) if accounts.size > 1
+    account = accounts.first
+    return reject(:account_inactive) unless account.active?
+    return duplicate if InboundMessageReceipt.received?(account, message_id)
+
+    tokens = targets.filter_map(&:reply_token).uniq
+    tickets = tokens.any? ? account.tickets.where(reply_token: tokens).to_a : []
+    return reject(:ambiguous_ticket) if tickets.size > 1
+    return reply_to(tickets.first, sender) if tickets.one?
+    return reject(:unknown_reply_address) unless targets.any? { |t| t.reply_token.nil? }
+
+    open_ticket(account, sender)
+  rescue Ticket::Invalid => e
+    reject(:invalid, e.message)
+  rescue Ticket::Closed
+    reject(:ticket_closed) # merged while the message was processed
+  end
+
+  private
+
+  # --- Outcomes ----------------------------------------------------------
+
+  def reject(reason, detail = nil)
+    Result.new(outcome: :rejected, reason: [ reason, detail ].compact.join(": "))
+  end
+
+  def duplicate
+    Result.new(outcome: :duplicate)
+  end
+
+  def reply_to(ticket, sender)
+    requester = ticket.requester
+    return reject(:not_requester) unless requester.email.casecmp?(sender[:email])
+    return reject(:requester_suspended) if requester.suspended?
+    return reject(:ticket_closed) if ticket.closed?
+
+    comment = nil
+    ActiveRecord::Base.transaction do
+      comment = ticket.reply!(actor: requester, body: message_body(reply: true))
+      record_receipt!(ticket, comment)
+    end
+    Result.new(outcome: :replied, ticket: ticket, comment: comment)
+  rescue ActiveRecord::RecordNotUnique
+    duplicate
+  end
+
+  def open_ticket(account, sender, attempt: 1)
+    new_customer = false
+    ticket = comment = nil
+    ActiveRecord::Base.transaction do
+      Invitation.lock_email!(account, sender[:email])
+      customer = account.users.find_by(email: sender[:email])
+      if customer
+        return reject(:staff_sender) if customer.staff?
+        return reject(:customer_suspended) if customer.suspended?
+      else
+        # An address with a pending team invitation is reserved for it.
+        return reject(:pending_invitation) if Invitation.pending_for(account, sender[:email])
+        customer = build_customer(account, sender)
+        return reject(:invalid_sender, customer.errors.full_messages.to_sentence) unless customer.valid?
+        customer.save!
+        new_customer = true
+      end
+      ticket, comment = Ticket.open_request!(requester: customer, subject: subject,
+        body: message_body(reply: false), origin: "email", email_message_id: message_id)
+      record_receipt!(ticket, comment)
+    end
+    send_verification(ticket.requester) if new_customer
+    Result.new(outcome: :opened, ticket: ticket, comment: comment)
+  rescue ActiveRecord::RecordNotUnique
+    # Either this Message-ID was just handled concurrently, or the customer
+    # was created concurrently; the retry tells the two apart.
+    return duplicate if InboundMessageReceipt.received?(account, message_id) || attempt > 1
+    open_ticket(account, sender, attempt: attempt + 1)
+  end
+
+  def build_customer(account, sender)
+    name = sender[:name].presence || sender[:email].split("@").first
+    account.users.new(name: name.to_s.squish.first(NAME_MAX), email: sender[:email], role: "customer",
+      password: SecureRandom.base58(40))
+  end
+
+  def send_verification(user)
+    token = UserToken.issue!(user, "email_verification")
+    UserMailer.email_verification(user, token).deliver_now
+  rescue StandardError => e
+    Rails.logger.error("[mail] delivery failed: #{e.class}: #{e.message}")
+    Rails.error.report(e, handled: true)
+  end
+
+  def record_receipt!(ticket, comment)
+    InboundMessageReceipt.create!(account_id: ticket.account_id, ticket: ticket, comment: comment,
+      message_id: message_id, inbound_email_id: inbound_email.id)
+  end
+
+  # --- Message parsing -----------------------------------------------------
+
+  def message_id
+    inbound_email.message_id
+  end
+
+  def subject
+    clean_text(mail.subject.to_s).squish.first(Ticket::SUBJECT_MAX)
+  end
+
+  # {email:, name:} for the first From address, or nil.
+  def sender_address
+    field = mail[:from]
+    address = field.respond_to?(:addrs) ? field.addrs.first : nil
+    email = address&.address.to_s.strip.downcase
+    return nil if email.blank? || !email.match?(URI::MailTo::EMAIL_REGEXP)
+    { email: email, name: clean_text(address.display_name.to_s).squish.presence }
+  rescue StandardError
+    nil
+  end
+
+  # Recipients at the support domain that name an existing business.
+  # reply_token is nil for the plain support address; a malformed token
+  # still identifies the business but matches no ticket.
+  def support_targets
+    domain = Helpdesk::Config.support_domain
+    parsed = recipient_addresses.filter_map do |email|
+      local, _, host = email.rpartition("@")
+      next unless host.casecmp?(domain)
+      subdomain, plus, token = local.downcase.partition("+")
+      next if subdomain.blank?
+      token = plus.empty? ? nil : (token.match?(Ticket::REPLY_TOKEN_FORMAT) ? token : "invalid")
+      [ subdomain, token ]
+    end
+    accounts = Account.where(subdomain: parsed.map(&:first).uniq).index_by(&:subdomain)
+    parsed.filter_map do |subdomain, token|
+      account = accounts[subdomain]
+      Target.new(account: account, reply_token: token) if account
+    end
+  end
+
+  def recipient_addresses
+    fields = %i[to cc bcc].map { |name| mail[name] }
+    fields += %w[X-Original-To X-Forwarded-To Delivered-To].flat_map { |name| Array(mail.header[name]) }
+    fields.compact.flat_map do |field|
+      if field.respond_to?(:addresses) && field.addresses
+        field.addresses
+      else
+        field.to_s.split(",").filter_map { |raw| Mail::Address.new(raw.strip).address rescue nil }
+      end
+    end.compact.map { |a| a.to_s.strip.downcase }.uniq
+  rescue StandardError
+    []
+  end
+
+  def own_address?(sender)
+    host = sender[:email].split("@").last
+    host == Helpdesk::Config.support_domain || sender[:email] == Mail::Address.new(Helpdesk::Config.mail_from).address.to_s.downcase
+  rescue StandardError
+    false
+  end
+
+  def automated?
+    auto_submitted = header_value("Auto-Submitted")
+    return true if auto_submitted.present? && !auto_submitted.casecmp?("no")
+    return true if AUTOMATED_PRECEDENCE.include?(header_value("Precedence").to_s.downcase)
+    return true if (LIST_HEADERS + AUTO_REPLY_HEADERS).any? { |name| header_value(name).present? }
+    return true if header_value("X-Auto-Response-Suppress").to_s.match?(/\b(all|oof|autoreply)\b/i)
+    return true if null_return_path?
+    return true if mail.mime_type.to_s.casecmp?("multipart/report")
+    from = mail[:from].respond_to?(:addrs) ? mail[:from].addrs.first&.local.to_s.downcase : ""
+    AUTOMATED_LOCAL_PARTS.include?(from)
+  rescue StandardError
+    false
+  end
+
+  # "Return-Path: <>" marks bounces and other auto-generated mail.
+  def null_return_path?
+    field = mail.header["Return-Path"]
+    field = field.first if field.is_a?(Array)
+    field.present? && field.value.to_s.delete("<> \t").empty?
+  end
+
+  def header_value(name)
+    field = mail.header[name]
+    field = field.first if field.is_a?(Array)
+    field&.value.to_s.strip.presence
+  end
+
+  # The plain-text message. Falls back to the HTML part converted to text.
+  # For replies, text below our reply marker (the quoted conversation) is
+  # dropped.
+  def message_body(reply:)
+    text = plain_text
+    text = strip_quoted_reply(text) if reply
+    text.strip.first(Comment::BODY_MAX)
+  end
+
+  def plain_text
+    part = mail.multipart? ? mail.text_part : (text_mime?(mail, "text/plain") ? mail : nil)
+    return clean_text(part.decoded) if part
+    html = mail.multipart? ? mail.html_part : (text_mime?(mail, "text/html") ? mail : nil)
+    html ? html_to_text(clean_text(html.decoded)) : ""
+  end
+
+  def text_mime?(part, type)
+    mime = part.mime_type
+    mime.nil? ? type == "text/plain" : mime.casecmp?(type)
+  end
+
+  def html_to_text(html)
+    html = html.gsub(%r{<(script|style|head)\b.*?</\1\s*>}mi, "")
+      .gsub(%r{<br\s*/?>}i, "\n").gsub(%r{</(p|div|li|tr|h[1-6]|blockquote)\s*>}i, "\n")
+    text = Rails::HTML5::FullSanitizer.new.sanitize(html).to_s
+    CGI.unescapeHTML(text).gsub(/[ \t]+\n/, "\n").gsub(/\n{3,}/, "\n\n")
+  end
+
+  def clean_text(text)
+    text = text.to_s.dup
+    text.force_encoding(Encoding::UTF_8) unless text.encoding == Encoding::UTF_8
+    text = text.scrub("\uFFFD") unless text.valid_encoding?
+    text.delete("\u0000").gsub(/\r\n?/, "\n")
+  end
+
+  QUOTE_ONLY = /\A(>\s*)*\z/
+
+  def strip_quoted_reply(text)
+    index = text.index(REPLY_MARKER)
+    return text unless index
+    lines = text[0...index].lines
+    # Drop the quote prefix and the mail client's attribution line, e.g.
+    # "On Mon, Jan 1, 2026 at 9:00, Acme <acme+...@...> wrote:" (which some
+    # clients wrap over two lines).
+    lines.pop while lines.any? && lines.last.strip.match?(QUOTE_ONLY)
+    if lines.any? && lines.last.strip.match?(/wrote:\z/i)
+      attribution = lines.pop
+      lines.pop if lines.any? && !attribution.strip.match?(/\AOn\s/i) && lines.last.strip.match?(/\AOn\s/i)
+    end
+    lines.pop while lines.any? && lines.last.strip.match?(QUOTE_ONLY)
+    lines.join
+  end
+end
diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..ea93fa6
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,81 @@
+# An invitation for someone to join an account's help desk team as an admin
+# or agent. Only a digest of the emailed token is stored. Resending rotates the
+# token (invalidating the previous link) and restarts the expiry window.
+class Invitation < ApplicationRecord
+  ROLES = %w[admin agent].freeze
+  STATUSES = %w[pending accepted revoked expired].freeze
+  VALIDITY = 7.days
+
+  belongs_to :account
+  belongs_to :invited_by, class_name: "User", optional: true
+  belongs_to :accepted_user, class_name: "User", optional: true
+  belongs_to :revoked_by, class_name: "User", optional: true
+
+  attr_reader :token
+
+  normalizes :email, with: ->(v) { v.to_s.strip.downcase }
+
+  validates :email, presence: true, length: { maximum: 254 }, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, inclusion: { in: ROLES, message: "must be one of: #{ROLES.join(', ')}" }
+  validates :state, inclusion: { in: STATUSES }
+
+  before_validation :generate_token, on: :create
+
+  scope :by_id, -> { order(id: :asc) }
+  scope :outstanding, -> { where(state: "pending") }
+  scope :with_status, ->(status, now = Time.current) {
+    case status
+    when "pending" then where(state: "pending").where(arel_table[:expires_at].gt(now))
+    when "expired" then where(state: "expired").or(where(state: "pending", expires_at: ..now))
+    else where(state: status)
+    end
+  }
+
+  def self.digest(token) = OpenSSL::Digest::SHA256.hexdigest(token.to_s)
+
+  # A usable (pending, unexpired) invitation for the token in +account+.
+  def self.find_usable(account, raw, now = Time.current)
+    return nil if raw.blank? || account.nil? || !raw.is_a?(String)
+    account.invitations.with_status("pending", now).find_by(token_digest: digest(raw))
+  end
+
+  # The live invitation blocking +email+ in +account+, if any.
+  def self.pending_for(account, email, now = Time.current)
+    account.invitations.with_status("pending", now).find_by(email: email.to_s.strip.downcase)
+  end
+
+  # Serialises work on one email address within an account (invitations,
+  # registrations and acceptances) for the rest of the current transaction.
+  def self.lock_email!(account, email)
+    key = "#{account.id}:#{email.to_s.strip.downcase}"
+    connection.execute("SELECT pg_advisory_xact_lock(hashtext(#{connection.quote(key)}))")
+  end
+
+  def status(now = Time.current)
+    state == "pending" && expires_at <= now ? "expired" : state
+  end
+
+  def pending?(now = Time.current) = status(now) == "pending"
+  def expired?(now = Time.current) = status(now) == "expired"
+
+  # Issues a fresh token and expiry. Returns the raw token.
+  def rotate_token!(now = Time.current)
+    generate_token
+    self.expires_at = now + VALIDITY
+    self.last_sent_at = now
+    self.state = "pending"
+    self.sent_count = (sent_count || 0) + 1 unless new_record?
+    save!
+    token
+  end
+
+  private
+
+  def generate_token
+    @token = SecureRandom.urlsafe_base64(32)
+    self.token_digest = self.class.digest(@token)
+    now = Time.current
+    self.expires_at ||= now + VALIDITY
+    self.last_sent_at ||= now
+  end
+end
diff --git a/app/models/session.rb b/app/models/session.rb
new file mode 100644
index 0000000..0e78bb2
--- /dev/null
+++ b/app/models/session.rb
@@ -0,0 +1,31 @@
+class Session < ApplicationRecord
+  IDLE_TIMEOUT = 30.days
+  TOUCH_INTERVAL = 1.minute
+
+  belongs_to :user
+
+  attr_reader :token
+
+  before_validation :generate_token, on: :create
+
+  scope :fresh, -> { where(last_used_at: IDLE_TIMEOUT.ago..) }
+
+  def self.digest(token) = OpenSSL::Digest::SHA256.hexdigest(token.to_s)
+
+  def self.find_by_token(token)
+    return nil if token.blank?
+    fresh.includes(user: :account).find_by(token_digest: digest(token))
+  end
+
+  def touch_last_used!
+    update_column(:last_used_at, Time.current) if last_used_at.nil? || last_used_at < TOUCH_INTERVAL.ago
+  end
+
+  private
+
+  def generate_token
+    @token = SecureRandom.urlsafe_base64(32)
+    self.token_digest = self.class.digest(@token)
+    self.last_used_at ||= Time.current
+  end
+end
diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..a71c92e
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,331 @@
+class Ticket < ApplicationRecord
+  # "closed" is terminal: only merging sets it, and closed tickets can't be
+  # edited or replied to. The others are the working statuses.
+  STATUSES = %w[open pending solved closed].freeze
+  WORKING_STATUSES = %w[open pending solved].freeze
+  PRIORITIES = %w[normal high].freeze
+  SEARCH_MAX = 255
+  SUBJECT_MAX = 255
+  ORIGINS = %w[web email].freeze
+  REPLY_TOKEN_FORMAT = /\A[a-z0-9]{24}\z/
+  UNCHANGED = Object.new.freeze # "attribute not supplied" marker for reply!
+
+  belongs_to :account
+  belongs_to :requester, class_name: "User"
+  belongs_to :assignee, class_name: "User", optional: true
+  belongs_to :group, optional: true
+  belongs_to :merged_into, class_name: "Ticket", optional: true
+  has_many :comments, dependent: :delete_all
+  has_many :inbound_message_receipts, dependent: :delete_all
+
+  normalizes :subject, with: ->(v) { v.to_s.squish }
+
+  validates :subject, presence: true, length: { maximum: SUBJECT_MAX }
+  validates :status, inclusion: { in: STATUSES }
+  validates :priority, inclusion: { in: PRIORITIES }
+  validates :origin, inclusion: { in: ORIGINS }
+  validate :requester_belongs_to_account
+  validate :assignee_is_active_staff, if: :assignee_id_changed?
+
+  before_validation :initialize_activity, on: :create
+  before_validation :generate_reply_token, on: :create
+
+  scope :recent_first, -> { order(last_activity_at: :desc, id: :desc) }
+  scope :recent_public_first, -> { order(last_public_activity_at: :desc, id: :desc) }
+  scope :unassigned, -> { where(assignee_id: nil) }
+  scope :ungrouped, -> { where(group_id: nil) }
+
+  # Case-insensitive literal substring match against the subject or any
+  # public comment. LIKE wildcards in +text+ are escaped.
+  scope :search, ->(text) {
+    pattern = "%#{sanitize_sql_like(text)}%"
+    public_match = Comment.where(public: true).where("comments.ticket_id = tickets.id")
+      .where("comments.body ILIKE ?", pattern)
+    where("tickets.subject ILIKE ?", pattern).or(where(public_match.arel.exists))
+  }
+
+  def open? = status == "open"
+  def pending? = status == "pending"
+  def solved? = status == "solved"
+  def closed? = status == "closed"
+  def email_origin? = origin == "email"
+
+  # The ticket's private reply address; mail sent there by the requester is
+  # added to this conversation.
+  def reply_address = Helpdesk::Config.reply_address(self)
+
+  def self.generate_reply_token
+    SecureRandom.alphanumeric(24).downcase
+  end
+
+  # Opens a new request with its first (public) comment.
+  # Returns [ticket, comment]; raises Ticket::Invalid with field errors.
+  def self.open_request!(requester:, subject:, body:, origin: "web", email_message_id: nil)
+    ticket = new(account: requester.account, requester: requester, subject: subject,
+      origin: origin, email_message_id: email_message_id)
+    comment = ticket.comments.new(author: requester, body: body, public: true)
+    errors = {}
+    errors.merge!(ticket.errors.to_hash(false).except(:comments).transform_keys(&:to_s)) unless ticket.valid?
+    errors.merge!(comment_errors(comment)) unless comment.valid?
+    raise Invalid, errors if errors.any?
+
+    transaction do
+      ticket.save!
+      comment.update_columns(created_at: ticket.created_at, updated_at: ticket.created_at)
+    end
+    [ ticket, comment ]
+  end
+
+  # Adds a reply and/or changes status on behalf of +actor+.
+  #
+  # * The requester may only set the status to "solved". A requester reply
+  #   reopens a pending/solved ticket unless it solves it in the same update.
+  # * Staff may set open/pending/solved; a staff reply alone keeps the status.
+  # * Staff may set the priority (normal/high). Priority is internal: it
+  #   never changes what the requester sees.
+  # * Staff may (un)assign the ticket to active staff in the account with
+  #   +assignee_id+ (nil clears it). Assignment and internal notes are
+  #   internal activity: they never change what the requester sees.
+  #
+  # * Staff may move the ticket to a group with +group_id+ (nil clears it).
+  #   An assignee must belong to the ticket's group: assigning someone to an
+  #   ungrouped ticket moves it to their default group (if they have one),
+  #   moving the ticket to a group its assignee isn't in unassigns it, and
+  #   clearing the group also clears the assignee. Clearing the assignee
+  #   keeps the group. Group changes are internal activity too.
+  #
+  # +status+ and +priority+ are nil when not supplied; +assignee_id+ and
+  # +group_id+ are UNCHANGED when not supplied. Returns the new comment (or nil).
+  def reply!(actor:, body: nil, public: true, status: nil, assignee_id: UNCHANGED, priority: nil, group_id: UNCHANGED)
+    raise Closed.new(self) if closed?
+    requester_update = actor.id == requester_id && !actor.staff?
+    assigning = !assignee_id.equal?(UNCHANGED)
+    grouping = !group_id.equal?(UNCHANGED)
+    errors = {}
+    if body.nil? && status.nil? && !assigning && priority.nil? && !grouping
+      errors["comment"] = [ actor.staff? ? "status, priority, group_id or assignee_id must be provided" : "or status must be provided" ]
+    end
+    if grouping
+      if !actor.staff?
+        errors["group_id"] = [ "cannot be changed" ]
+      elsif !group_id.nil? && !account.groups.exists?(id: group_id)
+        errors["group_id"] = [ "must be a group in this account" ]
+      elsif group_id.nil? && assigning && !assignee_id.nil?
+        errors["assignee_id"] = [ "cannot be set while clearing the group" ]
+      end
+    end
+    unless priority.nil?
+      if !actor.staff?
+        errors["priority"] = [ "cannot be changed" ]
+      elsif !PRIORITIES.include?(priority)
+        errors["priority"] = [ "must be one of: #{PRIORITIES.join(', ')}" ]
+      end
+    end
+    if assigning
+      if !actor.staff?
+        errors["assignee_id"] = [ "cannot be changed" ]
+      elsif !assignee_id.nil? && !self.class.assignable_staff(account).exists?(id: assignee_id)
+        errors["assignee_id"] = [ "must be an active staff member of this account" ]
+      end
+    end
+    unless status.nil?
+      allowed = requester_update ? %w[solved] : WORKING_STATUSES
+      errors["status"] = [ "must be one of: #{allowed.join(', ')}" ] unless allowed.include?(status)
+    end
+    comment = nil
+    unless body.nil?
+      comment = comments.new(author: actor, body: body, public: requester_update ? true : public)
+      errors.merge!(self.class.comment_errors(comment)) unless comment.valid?
+    end
+    raise Invalid, errors if errors.any?
+
+    transaction do
+      # Group/membership changes can't interleave with assignment checks.
+      Group.lock_account!(account_id, shared: true) if assigning || grouping
+      lock!
+      raise Closed.new(self) if closed? # merged meanwhile
+      new_status =
+        if status then status
+        elsif requester_update && comment && !open? then "open"
+        else self.status
+        end
+      now = Time.current
+      changes = {}
+      changes[:status] = new_status if new_status != self.status
+      changes[:priority] = priority if priority && priority != self.priority
+      # Re-checked under the row lock; suspension clears assignments too.
+      if assigning && assignee_id != self.assignee_id
+        if assignee_id && !self.class.assignable_staff(account).lock("FOR SHARE").exists?(id: assignee_id)
+          raise Invalid, { "assignee_id" => [ "must be an active staff member of this account" ] }
+        end
+        changes[:assignee_id] = assignee_id
+      end
+      changes.merge!(group_assignment_changes(assigning: assigning, assignee_id: assignee_id,
+        grouping: grouping, group_id: group_id)) if assigning || grouping
+      if comment
+        comment.created_at = comment.updated_at = now
+        comment.save!
+      end
+      if comment || changes.key?(:status)
+        changes[:last_activity_at] = now
+        changes[:last_public_activity_at] = now if changes.key?(:status) || comment&.public
+      end
+      update!(changes) if changes.any?
+    end
+    comment
+  end
+
+  # Merges this (duplicate) ticket into +target+, another ticket of the same
+  # requester, on behalf of staff +actor+:
+  #
+  # * this ticket is closed and points at the target with merged_into_id;
+  #   it stays readable, but can no longer be edited or replied to (by web
+  #   or email). Its comments stay where they are.
+  # * a note is added to each side. Notes are private unless +public+ is
+  #   true; +body+ nil uses a default text.
+  # * the target's status, assignment, group, priority and email identity
+  #   are left alone; it only gets the note (and its activity time).
+  #
+  # Merging a ticket that was itself a merge target later doesn't rewrite
+  # earlier links. Returns [source_comment, target_comment].
+  def merge_into!(target_id:, actor:, source_comment: {}, target_comment: {})
+    raise Closed.new(self) if closed?
+    errors = {}
+    target = account.tickets.find_by(id: target_id) if target_id
+    if (problem = merge_target_errors(target))
+      errors["target_id"] = problem
+    end
+    source_note = Comment.new(ticket: self, author: actor, public: source_comment[:public] == true,
+      body: source_comment[:body].nil? ? default_merge_source_note(target_id, target) : source_comment[:body])
+    target_note = Comment.new(ticket: target || self, author: actor, public: target_comment[:public] == true,
+      body: target_comment[:body].nil? ? "Ticket ##{id} (#{subject}) was merged into this ticket." : target_comment[:body])
+    errors.merge!(merge_comment_errors(source_note, "source_comment"))
+    errors.merge!(merge_comment_errors(target_note, "target_comment"))
+    raise Invalid, errors if errors.any?
+
+    transaction do
+      # Lock both rows in a stable order so crossing merges can't deadlock.
+      locked = Ticket.where(id: [ id, target.id ]).order(:id).lock.index_by(&:id)
+      reload
+      target.reload
+      raise Closed.new(self) if closed?
+      if (problem = merge_target_errors(target))
+        raise Invalid, { "target_id" => problem }
+      end
+      raise ActiveRecord::RecordNotFound unless locked.size == 2
+
+      now = Time.current
+      [ source_note, target_note ].each do |note|
+        note.created_at = note.updated_at = now
+        note.save!
+      end
+      # The status change is visible to the requester.
+      update!(status: "closed", merged_into_id: target.id, merged_at: now,
+        last_activity_at: now, last_public_activity_at: now)
+      target_changes = { last_activity_at: now }
+      target_changes[:last_public_activity_at] = now if target_note.public
+      target.update!(target_changes)
+    end
+    [ source_note, target_note ]
+  end
+
+  # Works out the final group/assignee pair (see #reply!). Called under the
+  # ticket row lock and the shared account group lock.
+  def group_assignment_changes(assigning:, assignee_id:, grouping:, group_id:)
+    if grouping && group_id && !account.groups.exists?(id: group_id)
+      raise Invalid, { "group_id" => [ "must be a group in this account" ] }
+    end
+    new_group_id = grouping ? group_id : self.group_id
+    new_assignee_id = assigning ? assignee_id : self.assignee_id
+    explicit_assignee = assigning && !assignee_id.nil?
+
+    if grouping && group_id.nil?
+      raise Invalid, { "assignee_id" => [ "cannot be set while clearing the group" ] } if explicit_assignee
+      new_assignee_id = nil
+    elsif new_assignee_id
+      if new_group_id.nil?
+        # Assigning someone to an ungrouped ticket uses their default group.
+        if explicit_assignee
+          new_group_id = GroupMembership.where(account_id: account_id, user_id: new_assignee_id).defaults.pick(:group_id)
+        end
+      elsif !GroupMembership.exists?(group_id: new_group_id, user_id: new_assignee_id)
+        raise Invalid, { "assignee_id" => [ "must be a member of the ticket's group" ] } if explicit_assignee
+        new_assignee_id = nil # moved to a group the assignee isn't in
+      end
+    end
+
+    changes = {}
+    changes[:group_id] = new_group_id if new_group_id != self.group_id
+    changes[:assignee_id] = new_assignee_id if new_assignee_id != self.assignee_id
+    changes
+  end
+
+  def self.assignable_staff(account)
+    account.users.staff.active
+  end
+
+  def self.comment_errors(comment)
+    comment.errors.to_hash(false).slice(:body, :public).transform_keys { |k| "comment.#{k}" }
+  end
+
+  # Raised when changing a closed (merged) ticket.
+  class Closed < StandardError
+    attr_reader :ticket
+
+    def initialize(ticket)
+      @ticket = ticket
+      message = "This ticket is closed"
+      message += " (merged into ticket ##{ticket.merged_into_id})" if ticket.merged_into_id
+      super(message)
+    end
+  end
+
+  class Invalid < StandardError
+    attr_reader :errors
+
+    def initialize(errors)
+      @errors = errors
+      super(errors.flat_map { |field, msgs| msgs.map { |m| "#{field.to_s.tr(".", " ").humanize} #{m}" } }.to_sentence)
+    end
+  end
+
+  private
+
+  def default_merge_source_note(target_id, target)
+    "This ticket was merged into ticket ##{target_id}#{" (#{target.subject})" if target}. The conversation continues there."
+  end
+
+  def merge_target_errors(target)
+    if target.nil? then [ "must be a ticket in this account" ]
+    elsif target.id == id then [ "must be a different ticket" ]
+    elsif target.requester_id != requester_id then [ "must belong to the same customer" ]
+    elsif target.closed? then [ "cannot be a closed ticket" ]
+    end
+  end
+
+  def merge_comment_errors(comment, prefix)
+    return {} if comment.valid?
+    comment.errors.to_hash(false).slice(:body, :public).transform_keys { |k| "#{prefix}.#{k}" }
+  end
+
+  def initialize_activity
+    now = Time.current
+    self.last_activity_at ||= now
+    self.last_public_activity_at ||= now
+  end
+
+  def generate_reply_token
+    self.reply_token ||= self.class.generate_reply_token
+  end
+
+  def assignee_is_active_staff
+    return if assignee_id.nil?
+    unless assignee && assignee.account_id == account_id && assignee.active_staff?
+      errors.add(:assignee_id, "must be an active staff member of this account")
+    end
+  end
+
+  def requester_belongs_to_account
+    errors.add(:requester, "must belong to the same account") if requester && requester.account_id != account_id
+  end
+end
diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..03c04ad
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,72 @@
+class User < ApplicationRecord
+  ROLES = %w[admin agent customer].freeze
+  STAFF_ROLES = %w[admin agent].freeze
+  PASSWORD_LENGTH = (8..72)
+
+  belongs_to :account
+  has_many :sessions, dependent: :delete_all
+  has_many :tokens, class_name: "UserToken", dependent: :delete_all
+  has_many :requested_tickets, class_name: "Ticket", foreign_key: :requester_id, inverse_of: :requester
+  has_many :assigned_tickets, class_name: "Ticket", foreign_key: :assignee_id, inverse_of: :assignee
+  has_many :group_memberships, dependent: :delete_all
+  has_many :groups, through: :group_memberships
+
+  has_secure_password
+
+  normalizes :email, with: ->(v) { v.to_s.strip.downcase }
+  normalizes :name, with: ->(v) { v.to_s.squish }
+
+  validates :name, presence: true, length: { maximum: 100 }
+  validates :email, presence: true, length: { maximum: 254 },
+    format: { with: URI::MailTo::EMAIL_REGEXP },
+    uniqueness: { scope: :account_id, case_sensitive: false }
+  validates :role, inclusion: { in: ROLES }
+  validates :password, length: { in: PASSWORD_LENGTH }, allow_nil: true
+
+  scope :by_id, -> { order(id: :asc) }
+  scope :staff, -> { where(role: STAFF_ROLES) }
+  scope :active, -> { where(suspended_at: nil) }
+  scope :suspended, -> { where.not(suspended_at: nil) }
+
+  def verified? = email_verified_at.present?
+  def admin? = role == "admin"
+  def agent? = role == "agent"
+  def customer? = role == "customer"
+  def staff? = admin? || agent?
+  def suspended? = suspended_at.present?
+  def active_staff? = staff? && !suspended?
+  def owner? = account.owned_by?(self)
+
+  def verify_email!
+    update!(email_verified_at: Time.current) unless verified?
+  end
+
+  # Signs out everywhere; optionally keeps one session alive.
+  def revoke_sessions!(except: nil)
+    scope = sessions
+    scope = scope.where.not(id: except.id) if except
+    scope.delete_all
+  end
+
+  # Ordinary access is blocked while the account is cancelled; only the owner
+  # may still sign in (to reactivate it).
+  def can_access_account?
+    account.active? || owner?
+  end
+
+  # Suspends or restores the user. Suspension signs them out everywhere and
+  # unassigns their tickets. Callers enforce the last-active-admin rule.
+  def set_suspended!(suspended, now = Time.current)
+    transaction do
+      if suspended
+        return if suspended?
+        update!(suspended_at: now)
+        revoke_sessions!
+        tokens.delete_all
+        Ticket.where(assignee_id: id).update_all(assignee_id: nil, updated_at: now)
+      else
+        update!(suspended_at: nil) if suspended?
+      end
+    end
+  end
+end
diff --git a/app/models/user_token.rb b/app/models/user_token.rb
new file mode 100644
index 0000000..198b127
--- /dev/null
+++ b/app/models/user_token.rb
@@ -0,0 +1,39 @@
+# Single-use, expiring tokens for email links. Only a digest is stored; each
+# user has at most one outstanding token per purpose, so issuing a new link
+# invalidates the previous one.
+class UserToken < ApplicationRecord
+  PURPOSES = {
+    "email_verification" => 2.days,
+    "password_reset" => 2.hours
+  }.freeze
+
+  belongs_to :user
+
+  validates :purpose, inclusion: { in: PURPOSES.keys }
+
+  def self.digest(token) = OpenSSL::Digest::SHA256.hexdigest(token.to_s)
+
+  # Returns the raw token (never stored).
+  def self.issue!(user, purpose)
+    raise ArgumentError, "unknown purpose #{purpose}" unless PURPOSES.key?(purpose)
+    raw = SecureRandom.urlsafe_base64(32)
+    transaction do
+      where(user: user, purpose: purpose).delete_all
+      create!(user: user, purpose: purpose, token_digest: digest(raw), expires_at: PURPOSES[purpose].from_now)
+    end
+    raw
+  end
+
+  # Finds and consumes a valid token for the given account, returning its user.
+  def self.consume(account, purpose, raw)
+    return nil if raw.blank? || account.nil?
+    transaction do
+      token = joins(:user).where(users: { account_id: account.id })
+        .lock.find_by(purpose: purpose, token_digest: digest(raw))
+      return nil unless token
+      token.delete
+      return nil if token.expires_at <= Time.current
+      token.user
+    end
+  end
+end
diff --git a/app/serializers/serializers.rb b/app/serializers/serializers.rb
new file mode 100644
index 0000000..332c866
--- /dev/null
+++ b/app/serializers/serializers.rb
@@ -0,0 +1,160 @@
+module Serializers
+  module_function
+
+  def time(value) = value&.utc&.iso8601(3)
+
+  def account(account)
+    {
+      id: account.id,
+      name: account.name,
+      subdomain: account.subdomain,
+      status: account.status,
+      owner_id: account.owner_id,
+      cancelled_at: time(account.cancelled_at),
+      reactivatable_until: time(account.reactivatable_until),
+      created_at: time(account.created_at),
+      updated_at: time(account.updated_at)
+    }
+  end
+
+  def portal(account)
+    { name: account.name, subdomain: account.subdomain }
+  end
+
+  def user(user)
+    {
+      id: user.id,
+      account_id: user.account_id,
+      name: user.name,
+      email: user.email,
+      role: user.role,
+      owner: user.owner?,
+      verified: user.verified?,
+      email_verified_at: time(user.email_verified_at),
+      suspended: user.suspended?,
+      suspended_at: time(user.suspended_at),
+      created_at: time(user.created_at),
+      updated_at: time(user.updated_at)
+    }
+  end
+
+  def session(session)
+    {
+      id: session.id,
+      token: session.token,
+      created_at: time(session.created_at)
+    }.compact
+  end
+
+  # Customer-facing view of a ticket. Timestamps only reflect activity the
+  # requester can see (internal notes are not exposed).
+  def request(ticket)
+    {
+      id: ticket.id,
+      subject: ticket.subject,
+      status: ticket.status,
+      requester_id: ticket.requester_id,
+      merged_into_id: ticket.merged_into_id,
+      merged_at: time(ticket.merged_at),
+      created_at: time(ticket.created_at),
+      updated_at: time(ticket.last_public_activity_at)
+    }
+  end
+
+  # Staff view of a ticket.
+  def ticket(ticket)
+    {
+      id: ticket.id,
+      subject: ticket.subject,
+      status: ticket.status,
+      priority: ticket.priority,
+      origin: ticket.origin,
+      requester_id: ticket.requester_id,
+      requester: { id: ticket.requester.id, name: ticket.requester.name, email: ticket.requester.email },
+      assignee_id: ticket.assignee_id,
+      assignee: ticket.assignee && { id: ticket.assignee.id, name: ticket.assignee.name },
+      group_id: ticket.group_id,
+      group: ticket.group && { id: ticket.group.id, name: ticket.group.name },
+      merged_into_id: ticket.merged_into_id,
+      merged_at: time(ticket.merged_at),
+      created_at: time(ticket.created_at),
+      updated_at: time(ticket.updated_at),
+      last_activity_at: time(ticket.last_activity_at)
+    }
+  end
+
+  def group(group)
+    {
+      id: group.id,
+      account_id: group.account_id,
+      name: group.name,
+      created_at: time(group.created_at),
+      updated_at: time(group.updated_at)
+    }
+  end
+
+  def group_membership(membership)
+    user = membership.user
+    {
+      id: membership.id,
+      group_id: membership.group_id,
+      user_id: membership.user_id,
+      default: membership.default,
+      group: { id: membership.group.id, name: membership.group.name },
+      user: { id: user.id, name: user.name, email: user.email, role: user.role, suspended: user.suspended? },
+      created_at: time(membership.created_at),
+      updated_at: time(membership.updated_at)
+    }
+  end
+
+  # An active staff member offered as an assignment choice.
+  def staff_member(user)
+    { id: user.id, name: user.name, email: user.email, role: user.role }
+  end
+
+  def invitation(invitation)
+    now = Time.current
+    {
+      id: invitation.id,
+      account_id: invitation.account_id,
+      email: invitation.email,
+      role: invitation.role,
+      status: invitation.status(now),
+      expires_at: time(invitation.expires_at),
+      last_sent_at: time(invitation.last_sent_at),
+      sent_count: invitation.sent_count,
+      invited_by_id: invitation.invited_by_id,
+      invited_by: invitation.invited_by && { id: invitation.invited_by.id, name: invitation.invited_by.name },
+      accepted_at: time(invitation.accepted_at),
+      accepted_user_id: invitation.accepted_user_id,
+      revoked_at: time(invitation.revoked_at),
+      revoked_by_id: invitation.revoked_by_id,
+      created_at: time(invitation.created_at),
+      updated_at: time(invitation.updated_at)
+    }
+  end
+
+  # What the (unauthenticated) invitee sees before accepting.
+  def invitation_preview(invitation)
+    account = invitation.account
+    {
+      email: invitation.email,
+      role: invitation.role,
+      account_name: account.name,
+      business_name: account.name,
+      subdomain: account.subdomain,
+      account: { name: account.name, subdomain: account.subdomain },
+      expires_at: time(invitation.expires_at)
+    }
+  end
+
+  def comment(comment)
+    {
+      id: comment.id,
+      body: comment.body,
+      author: { id: comment.author.id, name: comment.author.name },
+      public: comment.public,
+      created_at: time(comment.created_at)
+    }
+  end
+end
