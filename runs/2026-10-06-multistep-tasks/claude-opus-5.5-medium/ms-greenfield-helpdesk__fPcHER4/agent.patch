@@ -0,0 +1,62 @@
+module Api
+  module V1
+    # Groups (departments) organize staff work. Any staff member can browse
+    # them; only admins create, rename or delete them.
+    class GroupsController < ApplicationController
+      before_action :authenticate_active!
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create update destroy]
+      before_action :set_group, only: %i[show update destroy]
+
+      # GET /api/v1/groups
+      def index
+        render_page(:groups, current_account.groups.by_id) { |g| Serializers.group(g) }
+      end
+
+      # GET /api/v1/groups/:id
+      def show
+        render json: { group: Serializers.group(@group) }
+      end
+
+      # POST /api/v1/groups  {"group":{"name":"Billing"}}
+      def create
+        group = current_account.groups.new(name: name_param)
+        save_group!(group)
+        render json: { group: Serializers.group(group) }, status: :created
+      end
+
+      # PATCH/PUT /api/v1/groups/:id  {"group":{"name":"Billing"}}
+      def update
+        @group.name = name_param
+        save_group!(@group)
+        render json: { group: Serializers.group(@group) }
+      end
+
+      # DELETE /api/v1/groups/:id
+      def destroy
+        @group.destroy_with_cleanup!
+        head :no_content
+      end
+
+      private
+
+      def set_group
+        @group = current_account.groups.find(params[:id])
+      end
+
+      def name_param
+        attrs = envelope(:group)
+        raise_validation_error({ "name" => [ "can't be blank" ] }) unless attrs.key?(:name)
+        name = attrs[:name]
+        raise_validation_error({ "name" => [ "must be a string" ] }) unless name.is_a?(String)
+        name
+      end
+
+      def save_group!(group)
+        group.save!
+      rescue ActiveRecord::RecordNotUnique
+        raise_validation_error({ "name" => [ "has already been taken" ] })
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..23ab6c2
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,54 @@
+module Api
+  module V1
+    # Public: the invitee chooses a name and password and joins the team.
+    class InvitationAcceptancesController < ApplicationController
+      before_action :require_active_account!
+
+      # POST /api/v1/invitation_acceptances
+      # {"invitation_acceptance":{"token":"...","name":"...","password":"..."}}
+      def create
+        attrs = envelope(:invitation_acceptance)
+        token = attrs[:token]
+        name = attrs[:name]
+        password = attrs[:password]
+
+        invitation = Invitation.find_usable(current_account, token)
+        raise_invalid_token! unless invitation
+
+        user = current_account.users.new(
+          name: name.is_a?(String) ? name : nil,
+          password: password.is_a?(String) ? password : nil,
+          email: invitation.email,
+          role: invitation.role
+        )
+        # Validate before consuming the invitation so a typo doesn't burn it.
+        return render_validation_errors(user) unless user.valid?
+
+        User.transaction do
+          Invitation.lock_email!(current_account, invitation.email)
+          invitation = Invitation.find_usable(current_account, token)&.lock!
+          raise_invalid_token! unless invitation&.pending?
+          if current_account.users.exists?(email: invitation.email)
+            raise_validation_error({ "email" => [ "already belongs to a user of this account" ] })
+          end
+
+          now = Time.current
+          # Following the emailed link proves ownership of the address.
+          user.email_verified_at = now
+          user.save!
+          invitation.update!(state: "accepted", accepted_at: now, accepted_user: user)
+        end
+
+        render json: { user: Serializers.user(user), account: Serializers.account(current_account) }, status: :created
+      rescue ActiveRecord::RecordNotUnique
+        raise_validation_error({ "email" => [ "already belongs to a user of this account" ] })
+      end
+
+      private
+
+      def raise_invalid_token!
+        raise ApiError.new(:unprocessable_content, "invalid_token", "This invitation is invalid or has expired")
+      end
+    end
+  end
+end
