diff --git a/app/controllers/api/v1/password_resets_controller.rb b/app/controllers/api/v1/password_resets_controller.rb
new file mode 100644
index 0000000..8778b68
--- /dev/null
+++ b/app/controllers/api/v1/password_resets_controller.rb
@@ -0,0 +1,47 @@
+module Api
+  module V1
+    class PasswordResetsController < ApplicationController
+      # POST /api/v1/password_resets  — send a reset link.
+      # Always 202 so the endpoint doesn't reveal which emails exist.
+      def create
+        email = envelope(:password_reset)[:email].to_s.strip.downcase
+        user = current_account.users.find_by(email: email) if email.present?
+        if user && !user.suspended? && user.can_access_account?
+          token = UserToken.issue!(user, "password_reset")
+          deliver_email(UserMailer.password_reset(user, token))
+        end
+        render json: { message: "If that address has an account, a reset link has been sent." }, status: :accepted
+      end
+
+      # POST /api/v1/password_resets/confirm
+      def confirm
+        attrs = envelope(:password_reset)
+        password = attrs[:password].to_s
+
+        # Validate the new password before consuming the token, so a typo
+        # doesn't burn the link.
+        probe = User.new(password: password)
+        probe.validate
+        if probe.errors[:password].any?
+          return raise_validation_error({ "password" => probe.errors[:password] })
+        end
+
+        user = nil
+        User.transaction do
+          user = UserToken.consume(current_account, "password_reset", attrs[:token].to_s)
+          unless user && !user.suspended? && user.can_access_account?
+            raise ApiError.new(:unprocessable_content, "invalid_token", "This password reset link is invalid or has expired")
+          end
+          user.password = password
+          # Following the emailed link proves ownership of the address.
+          user.email_verified_at ||= Time.current
+          user.save!
+          user.revoke_sessions!
+          user.tokens.delete_all
+        end
+
+        render json: { user: Serializers.user(user) }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/passwords_controller.rb b/app/controllers/api/v1/passwords_controller.rb
new file mode 100644
index 0000000..9af3f2a
--- /dev/null
+++ b/app/controllers/api/v1/passwords_controller.rb
@@ -0,0 +1,31 @@
+module Api
+  module V1
+    class PasswordsController < ApplicationController
+      before_action :authenticate_active!
+
+      # PUT/PATCH /api/v1/me/password
+      # Signs out every existing session (including the one used for this
+      # request) and returns a fresh session token for the caller.
+      def update
+        attrs = envelope(:password_change)
+        user = current_user
+
+        unless user.authenticate(attrs[:current_password].to_s)
+          return raise_validation_error({ "current_password" => [ "is incorrect" ] })
+        end
+
+        user.password = attrs[:password].to_s
+        return render_validation_errors(user) unless user.valid?
+
+        new_session = User.transaction do
+          user.save!
+          user.revoke_sessions!
+          user.tokens.where(purpose: "password_reset").delete_all
+          user.sessions.create!(ip_address: request.remote_ip, user_agent: request.user_agent.to_s.first(255))
+        end
+
+        render json: { user: Serializers.user(user), session: Serializers.session(new_session) }
+      end
+    end
+  end
+end
