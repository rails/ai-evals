+# database name suffixed by "_test" so the test suite never wipes dev data.
+<%
+  base_url = ENV["DATABASE_URL"]
+  test_url = ENV["TEST_DATABASE_URL"] || (base_url && base_url.sub(%r{/([^/?]+)(\?|\z)}) { name, sep = $1, $2; "/#{name.delete_suffix('_development')}_test#{sep}" })
+%>
+default: &default
+  adapter: postgresql
+  encoding: unicode
+  max_connections: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>
+
+development:
+  <<: *default
+  url: <%= base_url %>
+
+test:
+  <<: *default
+  url: <%= test_url %>
+
+production:
+  <<: *default
+  url: <%= base_url %>
