diff --git a/app/mailers/ticket_mailer.rb b/app/mailers/ticket_mailer.rb
new file mode 100644
index 0000000..141c0d8
--- /dev/null
+++ b/app/mailers/ticket_mailer.rb
@@ -0,0 +1,24 @@
+class TicketMailer < ApplicationMailer
+  # Emails a staff member's public reply on an email-origin ticket to the
+  # requester. Replies go to the ticket's private reply address, so the
+  # customer's answer returns to the same conversation.
+  def public_reply(comment)
+    @comment = comment
+    @ticket = comment.ticket
+    @account = @ticket.account
+    @author = comment.author
+    @marker = InboundSupportEmail::REPLY_MARKER
+    domain = Helpdesk::Config.support_domain
+
+    headers["Message-ID"] = "<ticket-#{@ticket.id}-comment-#{comment.id}@#{domain}>"
+    if (original = @ticket.email_message_id.presence)
+      headers["In-Reply-To"] = "<#{original}>"
+      headers["References"] = "<#{original}>"
+    end
+
+    mail to: email_address_with_name(@ticket.requester.email, @ticket.requester.name),
+      from: email_address_with_name(Mail::Address.new(Helpdesk::Config.mail_from).address, @account.name),
+      reply_to: email_address_with_name(@ticket.reply_address, @account.name),
+      subject: "Re: #{@ticket.subject}"
+  end
+end
diff --git a/app/mailers/user_mailer.rb b/app/mailers/user_mailer.rb
new file mode 100644
index 0000000..39ba387
--- /dev/null
+++ b/app/mailers/user_mailer.rb
@@ -0,0 +1,24 @@
+class UserMailer < ApplicationMailer
+  def email_verification(user, token)
+    @user = user
+    @account = user.account
+    @url = Helpdesk::Config.frontend_link("/verify-email", account: @account.subdomain, token: token)
+    mail to: @user.email, subject: "Verify your email for #{@account.name}"
+  end
+
+  def password_reset(user, token)
+    @user = user
+    @account = user.account
+    @url = Helpdesk::Config.frontend_link("/reset-password", account: @account.subdomain, token: token)
+    mail to: @user.email, subject: "Reset your #{@account.name} password"
+  end
+
+  def invitation(invitation, token)
+    @invitation = invitation
+    @account = invitation.account
+    @inviter = invitation.invited_by
+    @role = invitation.role == "admin" ? "an admin" : "an agent"
+    @url = Helpdesk::Config.frontend_link("/accept-invitation", account: @account.subdomain, token: token)
+    mail to: invitation.email, subject: "You're invited to join #{@account.name} on the help desk"
+  end
+end
diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..9d3deef
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,95 @@
+class Account < ApplicationRecord
+  STATUSES = %w[active cancelled].freeze
+  RESERVED_SUBDOMAINS = %w[
+    www api app admin administrator mail email smtp imap pop ftp help helpdesk support status
+    blog docs static assets cdn dev staging test portal billing login signup auth account accounts
+  ].freeze
+  SUBDOMAIN_FORMAT = /\A[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\z/
+
+  has_many :users, dependent: :delete_all
+  has_many :sessions, through: :users
+  has_many :tickets, dependent: :delete_all
+  has_many :invitations, dependent: :delete_all
+  has_many :groups, dependent: :delete_all
+  has_many :group_memberships, dependent: :delete_all
+  belongs_to :owner, class_name: "User", optional: true
+
+  normalizes :name, with: ->(v) { v.to_s.squish }
+  normalizes :subdomain, with: ->(v) { v.to_s.strip.downcase }
+
+  validates :name, presence: true, length: { maximum: 100 }
+  validates :subdomain, presence: true,
+    format: { with: SUBDOMAIN_FORMAT, message: "may only contain lowercase letters, numbers and hyphens, and cannot start or end with a hyphen" },
+    exclusion: { in: RESERVED_SUBDOMAINS, message: "is reserved" },
+    uniqueness: { case_sensitive: false }
+  validates :status, inclusion: { in: STATUSES }
+
+  scope :purgeable, ->(now = Time.current) {
+    where(status: "cancelled").where(cancelled_at: ..(now - Helpdesk::Config::CANCELLATION_GRACE_PERIOD))
+  }
+
+  def self.find_by_subdomain(subdomain)
+    return nil if subdomain.blank?
+    find_by(subdomain: subdomain.to_s.strip.downcase)
+  end
+
+  # Permanently deletes cancelled accounts past their grace period, including
+  # all of their data. Returns the number of accounts deleted.
+  def self.purge_cancelled!(now: Time.current)
+    count = 0
+    purgeable(now).find_each do |account|
+      account.purge!
+      count += 1
+    end
+    count
+  end
+
+  def active? = status == "active"
+  def cancelled? = status == "cancelled"
+
+  def owned_by?(user)
+    user.present? && owner_id == user.id
+  end
+
+  def reactivatable_until
+    cancelled_at && cancelled_at + Helpdesk::Config::CANCELLATION_GRACE_PERIOD
+  end
+
+  def reactivatable?(now = Time.current)
+    cancelled? && reactivatable_until > now
+  end
+
+  def cancel!(now = Time.current)
+    transaction do
+      lock!
+      raise InvalidTransition, "Account is already cancelled" if cancelled?
+      update!(status: "cancelled", cancelled_at: now)
+      Session.where(user_id: users.select(:id)).delete_all
+    end
+  end
+
+  def reactivate!(now = Time.current)
+    transaction do
+      lock!
+      raise InvalidTransition, "Account is not cancelled" unless cancelled?
+      raise InvalidTransition, "The reactivation period for this account has ended" unless reactivatable?(now)
+      update!(status: "active", cancelled_at: nil)
+    end
+  end
+
+  def purge!
+    transaction do
+      update_columns(owner_id: nil)
+      # tickets/comments, and users -> sessions/user_tokens, cascade at the
+      # database level.
+      tickets.delete_all
+      invitations.delete_all
+      group_memberships.delete_all
+      groups.delete_all
+      users.delete_all
+      delete
+    end
+  end
+
+  class InvalidTransition < StandardError; end
+end
