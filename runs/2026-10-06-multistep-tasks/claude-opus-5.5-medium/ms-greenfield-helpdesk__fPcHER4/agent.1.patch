new file mode 100644
index 0000000..0e78bb2
--- /dev/null
+++ b/app/models/session.rb
@@ -0,0 +1,31 @@
+class Session < ApplicationRecord
+  IDLE_TIMEOUT = 30.days
+  TOUCH_INTERVAL = 1.minute
+
+  belongs_to :user
+
+  attr_reader :token
+
+  before_validation :generate_token, on: :create
+
+  scope :fresh, -> { where(last_used_at: IDLE_TIMEOUT.ago..) }
+
+  def self.digest(token) = OpenSSL::Digest::SHA256.hexdigest(token.to_s)
+
+  def self.find_by_token(token)
+    return nil if token.blank?
+    fresh.includes(user: :account).find_by(token_digest: digest(token))
+  end
+
+  def touch_last_used!
+    update_column(:last_used_at, Time.current) if last_used_at.nil? || last_used_at < TOUCH_INTERVAL.ago
+  end
+
+  private
+
+  def generate_token
+    @token = SecureRandom.urlsafe_base64(32)
+    self.token_digest = self.class.digest(@token)
+    self.last_used_at ||= Time.current
+  end
+end
