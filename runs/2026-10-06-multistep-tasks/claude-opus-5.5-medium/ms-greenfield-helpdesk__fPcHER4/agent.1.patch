+require_relative "boot"
+
+require "rails"
+require "active_model/railtie"
+require "active_job/railtie"
+require "active_record/railtie"
+require "action_controller/railtie"
+require "action_mailer/railtie"
+require "action_view/railtie"
+require "rails/test_unit/railtie"
+
+Bundler.require(*Rails.groups)
+
+require_relative "../lib/helpdesk/cors"
+
+module Helpdesk
+  class Application < Rails::Application
+    config.load_defaults 8.1
+
+    config.autoload_lib(ignore: %w[assets tasks helpdesk/cors.rb])
+
+    config.api_only = true
+    config.time_zone = "UTC"
+
+    config.middleware.insert_before 0, Helpdesk::Cors
+
+    # The frontend lives on another host; the API is reached through whatever
+    # hostname the deployment uses.
+    config.hosts.clear
+
+    # Outgoing mail goes through Action Mailer. SMTP is used whenever
+    # SMTP_ADDRESS is set; otherwise messages are written to tmp/mails
+    # (the test environment overrides this with the :test delivery method).
+    if ENV["SMTP_ADDRESS"].present?
+      config.action_mailer.delivery_method = :smtp
+      config.action_mailer.smtp_settings = {
+        address: ENV["SMTP_ADDRESS"],
+        port: ENV.fetch("SMTP_PORT", 587).to_i,
+        domain: ENV["SMTP_DOMAIN"].presence,
+        user_name: ENV["SMTP_USERNAME"].presence,
+        password: ENV["SMTP_PASSWORD"].presence,
+        authentication: ENV["SMTP_USERNAME"].present? ? :plain : nil,
+        enable_starttls_auto: true
+      }.compact
+    else
+      config.action_mailer.delivery_method = :file
+      config.action_mailer.file_settings = { location: Rails.root.join("tmp/mails").to_s }
+    end
+  end
+end
