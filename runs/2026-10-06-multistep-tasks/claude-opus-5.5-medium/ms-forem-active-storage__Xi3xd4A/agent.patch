+require "rails_helper"
+require "active_storage/service/fog_service"
+
+RSpec.describe ActiveStorage::Service::FogService do
+  let(:credentials) do
+    { provider: "AWS", aws_access_key_id: "id", aws_secret_access_key: "secret", region: "us-east-1" }
+  end
+  let(:options) { {} }
+  let(:service) do
+    described_class.new(directory: "forem-bucket", credentials: credentials, prefix: "uploads/active_storage",
+                        public: true, **options)
+  end
+  let(:data) { Rails.root.join("spec/fixtures/files/800x600.png").binread }
+  let(:checksum) { OpenSSL::Digest::MD5.base64digest(data) }
+  let(:key) { SecureRandom.base58(24) }
+  let(:storage) { Fog::Storage.new(credentials) }
+
+  before do
+    Fog.mock!
+    storage.directories.create(key: "forem-bucket")
+  end
+
+  after do
+    Fog::Mock.reset
+    Fog.unmock!
+  end
+
+  it "uploads, downloads, checks and deletes files under its prefix" do
+    service.upload(key, StringIO.new(data), checksum: checksum, content_type: "image/png")
+
+    stored = storage.directories.get("forem-bucket").files.get("uploads/active_storage/#{key}")
+    expect(stored.body).to eq(data)
+    expect(stored.content_type).to eq("image/png")
+    expect(service.exist?(key)).to be(true)
+    expect(service.download(key)).to eq(data)
+    expect(service.download_chunk(key, 0..9)).to eq(data[0..9])
+
+    streamed = +""
+    service.download(key) { |chunk| streamed << chunk }
+    expect(streamed.b).to eq(data)
+
+    service.delete(key)
+    expect(service.exist?(key)).to be(false)
+  end
+
+  it "deletes files by prefix" do
+    service.upload("variants/a", StringIO.new("a"))
+    service.upload("variants/b", StringIO.new("b"))
+    service.upload("other", StringIO.new("c"))
+
+    service.delete_prefixed("variants/")
+
+    expect(service.exist?("variants/a")).to be(false)
+    expect(service.exist?("variants/b")).to be(false)
+    expect(service.exist?("other")).to be(true)
+  end
+
+  it "raises FileNotFoundError for missing files" do
+    expect { service.download("missing") }.to raise_error(ActiveStorage::FileNotFoundError)
+  end
+
+  it "uploads public-read objects with a long cache control when configured to" do
+    options[:cache_control] = "public, max-age=31536000"
+    service.upload(key, StringIO.new(data))
+
+    stored = storage.directories.get("forem-bucket").files.get("uploads/active_storage/#{key}")
+    expect(stored.cache_control).to eq("public, max-age=31536000")
+    expect(storage.get_object_acl("forem-bucket", "uploads/active_storage/#{key}").body["AccessControlList"])
+      .to include(hash_including("Grantee" => hash_including("URI" => "http://acs.amazonaws.com/groups/global/AllUsers")))
+  end
+
+  describe "#permanent_url" do
+    it "is the bucket's public URL, without querying S3" do
+      # "abc" doesn't exist: Fog::AWS::Storage::File#public_url (ACL lookup) would raise here
+      expect(service.permanent_url("abc")).to eq("https://forem-bucket.s3.amazonaws.com/uploads/active_storage/abc")
+    end
+
+    context "with a public host (private bucket behind a proxy)" do
+      let(:options) { { public_host: "https://forem.example.com/remoteimages", acl_public: false } }
+
+      it "points to the proxy" do
+        expect(service.permanent_url("abc")).to eq("https://forem.example.com/remoteimages/uploads/active_storage/abc")
+      end
+    end
+
+    context "when the service isn't public" do
+      let(:service) { described_class.new(directory: "forem-bucket", credentials: credentials) }
+
+      it "is nil" do
+        expect(service.permanent_url("abc")).to be_nil
+      end
+    end
+  end
+
+  it "is used for profile image URLs" do
+    service.upload(key, StringIO.new(data))
+    blob = ActiveStorage::Blob.new(key: key, filename: "a.png", byte_size: data.bytesize, checksum: checksum,
+                                   service_name: "test")
+    allow(blob).to receive_messages(persisted?: true, service: service)
+
+    expect(ProfileImageAttachable.url_for(blob))
+      .to eq("https://forem-bucket.s3.amazonaws.com/uploads/active_storage/#{key}")
+  end
+
+  it "is configured from config/storage.yml" do
+    configs = ActiveSupport::ConfigurationFile.parse(Rails.root.join("config/storage.yml"))
+
+    expect(ActiveStorage::Service::Configurator.build(:amazon, configs)).to be_a(described_class)
+    expect(ActiveStorage::Service::Configurator.build(:forem_cloud, configs)).to be_a(described_class)
+  end
+end
