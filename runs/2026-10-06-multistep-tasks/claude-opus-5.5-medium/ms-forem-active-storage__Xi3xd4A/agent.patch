+require "rails_helper"
+
+RSpec.describe "profile_images tasks", type: :task do
+  let(:png_path) { Rails.root.join("spec/fixtures/files/800x600.png") }
+
+  before { Rake.application["profile_images:copy"].reenable }
+
+  def legacy_user
+    user = create(:user, profile_image: nil)
+    uploader = ProfileImageUploader.new(user, :profile_image)
+    uploader.store!(Rack::Test::UploadedFile.new(png_path, "image/png"))
+    user.update_column(:profile_image, uploader.identifier)
+    User.find(user.id)
+  end
+
+  describe "profile_images:copy" do
+    it "copies the CarrierWave profile images to Active Storage" do
+      user = legacy_user
+
+      expect { Rake::Task["profile_images:copy"].invoke }.to output(/copied: 1/).to_stdout
+
+      expect(User.find(user.id).avatar).to be_attached
+      expect(User.find(user.id).profile_image_url).to include("/rails/active_storage/blobs/proxy/")
+    end
+
+    it "fails when some images could not be copied, so that it gets run again" do
+      legacy_user
+      allow(ActiveStorage::Blob).to receive(:build_after_unfurling).and_raise(Errno::ECONNRESET)
+
+      expect do
+        expect { Rake::Task["profile_images:copy"].invoke }.to raise_error(SystemExit)
+      end.to output(/failed: 1/).to_stdout.and output(/could not be copied/).to_stderr
+    end
+  end
+end
