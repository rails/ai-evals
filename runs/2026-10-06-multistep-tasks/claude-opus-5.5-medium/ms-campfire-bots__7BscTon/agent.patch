--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "create bot" do
+    bot = User.create_bot!(name: "CI Bot", creator: users(:jz))
+
+    assert bot.bot?
+    assert_match /\A#{bot.id}-[[:alnum:]]{24}\z/, bot.bot_key
+    assert_empty bot.rooms
+    assert_includes users(:jz).bots, bot
+  end
+
+  test "authenticate bot" do
+    bot = users(:deploy_bot)
+
+    assert_equal bot, User.authenticate_bot(bot.bot_key)
+    assert_nil User.authenticate_bot("#{bot.id}-nope")
+    assert_nil User.authenticate_bot("#{bot.id}")
+    assert_nil User.authenticate_bot(nil)
+    assert_nil User.authenticate_bot("#{users(:david).id}-anything")
+  end
+
+  test "deactivated bots can't authenticate" do
+    bot = users(:deploy_bot)
+    bot_key = bot.bot_key
+
+    bot.deactivate
+
+    assert_nil bot.reload.bot_token
+    assert_nil User.authenticate_bot(bot_key)
+  end
+
+  test "people don't have bot keys" do
+    assert_nil users(:david).bot_key
+  end
+
+  test "creating bots beyond the limit is refused" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    assert_raises(ActiveRecord::RecordInvalid) { User.create_bot!(name: "Second", creator: users(:kevin)) }
+    assert users(:kevin).reached_bot_limit?
+    assert_not users(:david).reached_bot_limit?
+    assert User.create_bot!(name: "Admin's", creator: users(:david)).persisted?
+  end
+end
diff --git a/test/models/webhook_test.rb b/test/models/webhook_test.rb
new file mode 100644
index 0000000..456feb4
--- /dev/null
+++ b/test/models/webhook_test.rb
@@ -0,0 +1,164 @@
+require "test_helper"
+
+class WebhookTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:deploy_bot)
+    @webhook = webhooks(:deploy_bot)
+    @room = rooms(:watercooler)
+    @message = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(:deploy_bot)} restart the build please</div>")
+  end
+
+  test "posts a JSON mention payload" do
+    payload = nil
+    stub_request(:post, @webhook.url).with(headers: { "Content-Type" => "application/json" }).to_return do |request|
+      payload = JSON.parse(request.body)
+      { status: 204 }
+    end
+
+    @webhook.deliver(@message)
+
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => users(:david).id, "name" => "David" }, payload["author"])
+    assert_equal({ "id" => @room.id, "name" => "All Talk", "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_key}/messages" }, payload["room"])
+    assert_equal @message.id, payload["message"]["id"]
+    assert_equal "restart the build please", payload["message"]["body"]["text"]
+    assert_includes payload["message"]["body"]["html"], "restart the build please"
+    assert_equal "/rooms/#{@room.id}/@#{@message.id}", payload["message"]["link"]
+  end
+
+  test "keeps mentions of other people in the text" do
+    message = @room.messages.create!(creator: users(:david), body: "<div>Hey #{mention_attachment_for(:deploy_bot)} ping #{mention_attachment_for(:kevin)}</div>")
+    stub_request(:post, @webhook.url).to_return(status: 204)
+
+    @webhook.deliver(message)
+
+    assert_requested(:post, @webhook.url) { |req| JSON.parse(req.body).dig("message", "body", "text") == "Hey ping @Kevin" }
+  end
+
+  test "plain text reply is posted escaped as the bot" do
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "Restarting <now>\nhang on", headers: { "Content-Type" => "text/plain; charset=utf-8" })
+
+    assert_difference -> { @room.messages.count }, +1 do
+      @webhook.deliver(@message)
+    end
+
+    reply = @room.messages.ordered.last
+    assert_equal @bot, reply.creator
+    assert_equal "Restarting <now>\nhang on", reply.body.to_plain_text
+    assert_includes reply.body.body.to_html, "&lt;now&gt;"
+  end
+
+  test "html reply is posted as rich text" do
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "<strong>Done</strong>", headers: { "Content-Type" => "text/html" })
+
+    @webhook.deliver(@message)
+
+    reply = @room.messages.ordered.last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.body.to_html, "<strong>Done</strong>"
+  end
+
+  test "no content posts nothing" do
+    stub_request(:post, @webhook.url).to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      @webhook.deliver(@message)
+    end
+  end
+
+  test "other content types, errors and timeouts post nothing" do
+    stub_request(:post, @webhook.url).to_return(
+      { status: 200, body: "{}", headers: { "Content-Type" => "application/json" } },
+      { status: 500, body: "oops", headers: { "Content-Type" => "text/plain" } }
+    ).then.to_timeout
+
+    assert_no_difference -> { Message.count } do
+      3.times { @webhook.deliver(@message) }
+    end
+  end
+
+  test "url must be http" do
+    assert Webhook.new(user: @bot, url: "https://bots.example.com/hook").valid?
+    assert_not Webhook.new(user: @bot, url: "ftp://bots.example.com/hook").valid?
+    assert_not Webhook.new(user: @bot, url: "not a url").valid?
+  end
+
+  test "posts a JSON joined payload" do
+    room = rooms(:watercooler)
+    stub_request(:post, @webhook.url).to_return(status: 204)
+
+    @webhook.deliver_joined(room)
+
+    assert_requested(:post, @webhook.url) do |request|
+      JSON.parse(request.body) == { "event" => "joined", "room" => { "id" => room.id, "name" => "All Talk", "reply_to" => "/rooms/#{room.id}/#{@bot.bot_key}/messages" } }
+    end
+  end
+
+  test "joined reply is posted into the room as the bot" do
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "Hello, all!", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { @room.messages.count }, +1 do
+      @webhook.deliver_joined(@room)
+    end
+
+    assert_equal @bot, @room.messages.last.creator
+    assert_equal "Hello, all!", @room.messages.last.plain_text_body
+  end
+
+  test "no joined event once the bot has left the room" do
+    memberships(:deploy_bot_watercooler).destroy
+
+    @webhook.deliver_joined(@room)
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "ten failed deliveries in a row suspend the bot" do
+    stub_request(:post, @webhook.url).to_return(status: 500).then.to_timeout.then.to_raise(Errno::ECONNREFUSED).then.to_return(status: 302)
+
+    9.times { @webhook.deliver(@message) }
+    assert_equal 9, @webhook.reload.consecutive_failures
+    assert_not @bot.reload.suspended?
+
+    @webhook.deliver(@message)
+    assert @bot.reload.suspended?
+    assert_equal "failing_webhook", @bot.suspension_reason
+  end
+
+  test "a successful delivery resets the failure count" do
+    stub_request(:post, @webhook.url).to_return(status: 500).times(9).then.to_return(status: 204).then.to_return(status: 500)
+
+    10.times { @webhook.deliver(@message) }
+    assert_equal 0, @webhook.reload.consecutive_failures
+
+    @webhook.deliver(@message)
+    assert_equal 1, @webhook.reload.consecutive_failures
+    assert_not @bot.reload.suspended?
+  end
+
+  test "suspended bots receive no webhooks" do
+    @bot.suspend "flooding"
+    stub_request(:post, @webhook.url)
+
+    @webhook.deliver(@message)
+    @webhook.deliver_joined(@room)
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "replies count towards the bot's message limit and aren't posted during a cooldown" do
+    freeze_time
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "On it", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { @room.messages.where(creator: @bot).count }, +10 do
+      11.times { @webhook.deliver(@message) }
+    end
+    assert @bot.reload.posting_cooldown?
+
+    assert_no_difference -> { Message.count } do
+      @webhook.deliver(@message)
+    end
+    assert_equal 1, @bot.reload.posting_cooldown_attempts
+    assert_equal 0, @webhook.reload.consecutive_failures
+  end
+end
