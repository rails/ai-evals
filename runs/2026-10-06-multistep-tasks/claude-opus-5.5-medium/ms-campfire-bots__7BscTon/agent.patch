@@ -0,0 +1,75 @@
+require "application_system_test_case"
+
+class ManagingBotsTest < ApplicationSystemTestCase
+  setup do
+    sign_in "jz@37signals.com"
+  end
+
+  test "creating, editing, and deleting a bot" do
+    visit edit_account_url
+    click_on "Set up chat bots"
+    assert_current_path bots_path
+
+    click_on "Add a chat bot"
+    assert_current_path new_bot_path
+
+    fill_in "Name the bot", with: "CI Bot"
+    attach_file "Bot avatar", file_fixture("moon.jpg").to_s, make_visible: true
+    click_on "Save changes"
+
+    assert_current_path bots_path
+    bot = User.bot.find_by!(name: "CI Bot")
+
+    within "li", text: "CI Bot" do
+      assert_field "Bot code", with: bot.bot_key, readonly: true
+      click_on "Edit CI Bot"
+    end
+
+    fill_in "Name the bot", with: "Release Bot"
+    fill_in "Webhook URL", with: "https://ci.example.com/campfire"
+    click_on "Save changes"
+    assert_text "Release Bot"
+    assert_equal "https://ci.example.com/campfire", bot.reload.webhook.url
+
+    click_on "Edit Release Bot"
+    assert_field "Webhook URL", with: "https://ci.example.com/campfire"
+    fill_in "Webhook URL", with: ""
+    click_on "Save changes"
+    assert_current_path bots_path
+    assert_nil bot.reload.webhook
+
+    click_on "Edit Release Bot"
+    assert_unchecked_field "Add to all open rooms", visible: :all
+    check "Add to all open rooms", allow_label_click: true
+    click_on "Save changes"
+    assert_current_path bots_path
+    assert_equal Rooms::Open.ids.sort, bot.reload.rooms.ids.sort
+
+    click_on "Edit Release Bot"
+    accept_confirm { click_on "Delete this chat bot" }
+
+    assert_current_path bots_path
+    assert_no_text "Release Bot"
+    assert bot.reload.deactivated?
+  end
+
+  test "reactivating a suspended bot" do
+    bot = users(:deploy_bot)
+    bot.suspend "flooding"
+
+    using_session :administrator do
+      sign_in "david@37signals.com"
+      visit bots_url
+
+      within "li", text: "Deploy Bot" do
+        assert_text "Suspended"
+        assert_text "Posted too many messages too quickly"
+        accept_confirm { click_on "Reactivate" }
+      end
+
+      assert_current_path bots_path
+      assert_no_text "Suspended"
+      assert_not bot.reload.suspended?
+    end
+  end
+end
