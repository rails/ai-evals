+      <span class="for-screen-reader">Edit <%= bot.name %></span>
+    <% end %>
+  </div>
+
+  <% if bot.suspended? && Current.user.can_administer? %>
+    <%= button_to bot_suspension_path(bot), method: :delete, class: "btn txt-small center",
+          data: { turbo_confirm: "Reactivate #{bot.name}? It will be able to post messages and receive webhooks again." } do %>
+      <%= image_tag "refresh.svg", aria: { hidden: "true" }, size: 20 %>
+      <span>Reactivate</span>
+    <% end %>
+  <% end %>
+
+  <div class="flex align-center gap">
+    <label class="for-screen-reader" for="<%= dom_id(bot, :bot_code) %>">Bot code</label>
+    <span class="flex align-center gap input input--actor fill-white flex-item-grow">
+      <%= image_tag "key.svg", aria: { hidden: "true" }, size: 20, class: "colorize--black" %>
+      <input type="text" class="input" id="<%= dom_id(bot, :bot_code) %>" value="<%= bot.bot_key %>"
+        readonly autocomplete="off" spellcheck="false" data-1p-ignore="true">
+    </span>
+
+    <%= button_to_copy_to_clipboard(bot.bot_key) do %>
+      <span class="for-screen-reader">Copy bot code for <%= bot.name %></span>
+      <%= image_tag "copy-paste.svg", aria: { hidden: "true" }, size: 20, class: "colorize--black" %>
+    <% end %>
+  </div>
+</li>
