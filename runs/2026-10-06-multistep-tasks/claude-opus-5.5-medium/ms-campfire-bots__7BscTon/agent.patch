+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    @bot = users(:deploy_bot)
+  end
+
+  test "account settings link to bots" do
+    get edit_account_url
+    assert_select "a[href='#{bots_path}']", text: "Set up chat bots"
+  end
+
+  test "index lists my bots with their codes" do
+    get bots_url
+
+    assert_response :success
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "label", text: "Bot code"
+      assert_select "input[readonly][value=?]", @bot.bot_key
+      assert_select "a[href=?]", edit_bot_path(@bot), text: "Edit Deploy Bot"
+    end
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+  end
+
+  test "index hides other people's bots from members" do
+    sign_in :jz
+
+    get bots_url
+    assert_select "li", text: /Deploy Bot/, count: 0
+    assert_no_match @bot.bot_token, response.body
+  end
+
+  test "administrators see all bots" do
+    sign_in :david
+
+    get bots_url
+    assert_select "input[value=?]", @bot.bot_key
+  end
+
+  test "new" do
+    get new_bot_url
+
+    assert_response :success
+    assert_select "input[name='user[name]'][placeholder='Name the bot'][required]"
+    assert_select "input[type=file][name='user[avatar]']"
+  end
+
+  test "create" do
+    assert_difference -> { User.bot.count }, +1 do
+      post bots_url, params: { user: { name: "CI Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+    end
+
+    assert_redirected_to bots_url
+
+    bot = User.bot.last
+    assert_equal "CI Bot", bot.name
+    assert_equal users(:kevin), bot.creator
+    assert bot.avatar.attached?
+    assert bot.bot_token.present?
+    assert_empty bot.rooms
+  end
+
+  test "form has an add to all open rooms switch, off by default" do
+    get new_bot_url
+
+    assert_select "label[for=user_joins_all_open_rooms]", text: "Add to all open rooms"
+    assert_select "input[type=checkbox][name='user[joins_all_open_rooms]'].switch__input:not([checked])"
+  end
+
+  test "create added to all open rooms" do
+    post bots_url, params: { user: { name: "CI Bot", joins_all_open_rooms: "1" } }
+
+    bot = User.bot.last
+    assert bot.joins_all_open_rooms?
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+  end
+
+  test "turning add to all open rooms off keeps memberships" do
+    bot = users(:deploy_bot)
+    put bot_url(bot), params: { user: { joins_all_open_rooms: "1" } }
+    assert_equal (Rooms::Open.ids + [ rooms(:watercooler).id ]).sort, bot.rooms.ids.sort
+
+    put bot_url(bot), params: { user: { joins_all_open_rooms: "0" } }
+    assert_not bot.reload.joins_all_open_rooms?
+    assert_equal (Rooms::Open.ids + [ rooms(:watercooler).id ]).sort, bot.rooms.ids.sort
+  end
+
+  test "create requires a name" do
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { user: { name: "" } }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "edit has a delete button" do
+    get edit_bot_url(@bot)
+
+    assert_response :success
+    assert_select "form[action=?] button[data-turbo-confirm]", bot_path(@bot), text: /Delete this chat bot/
+  end
+
+  test "update" do
+    patch bot_url(@bot), params: { user: { name: "Release Bot" } }
+
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", @bot.reload.name
+  end
+
+  test "destroy" do
+    bot_key = @bot.bot_key
+
+    delete bot_url(@bot)
+
+    assert_redirected_to bots_url
+    assert @bot.reload.deactivated?
+    assert_nil User.authenticate_bot(bot_key)
+  end
+
+  test "members can't manage other people's bots" do
+    sign_in :jz
+
+    assert_raises(ActiveRecord::RecordNotFound) { get edit_bot_url(@bot) }
+    assert_raises(ActiveRecord::RecordNotFound) { patch bot_url(@bot), params: { user: { name: "Hijacked" } } }
+    assert_raises(ActiveRecord::RecordNotFound) { delete bot_url(@bot) }
+
+    assert_equal "Deploy Bot", @bot.reload.name
+    assert @bot.active?
+  end
+
+  test "administrators can manage any bot" do
+    sign_in :david
+
+    patch bot_url(@bot), params: { user: { name: "Release Bot" } }
+    assert_equal "Release Bot", @bot.reload.name
+  end
+
+  test "people can't be managed as bots" do
+    assert_raises(ActiveRecord::RecordNotFound) { get edit_bot_url(users(:kevin)) }
+  end
+
+  test "form has an optional webhook URL field" do
+    get new_bot_url
+    assert_select "input[name='user[webhook_url]'][placeholder='Webhook URL']:not([required])"
+
+    get edit_bot_url(@bot)
+    assert_select "input[name='user[webhook_url]'][value=?]", @bot.webhook.url
+  end
+
+  test "create with a webhook URL" do
+    post bots_url, params: { user: { name: "CI Bot", webhook_url: "https://ci.example.com/campfire" } }
+
+    assert_redirected_to bots_url
+    assert_equal "https://ci.example.com/campfire", User.bot.last.webhook.url
+  end
+
+  test "create without a webhook URL" do
+    post bots_url, params: { user: { name: "CI Bot", webhook_url: "" } }
+
+    assert_redirected_to bots_url
+    assert_nil User.bot.last.webhook
+  end
+
+  test "update changes the webhook URL" do
+    patch bot_url(@bot), params: { user: { name: "Deploy Bot", webhook_url: "https://hooks.example.com/new" } }
+
+    assert_redirected_to bots_url
+    assert_equal "https://hooks.example.com/new", @bot.reload.webhook.url
+  end
+
+  test "update with an empty webhook URL removes the webhook" do
+    assert_difference -> { Webhook.count }, -1 do
+      patch bot_url(@bot), params: { user: { name: "Deploy Bot", webhook_url: "" } }
+    end
+
+    assert_redirected_to bots_url
+    assert_nil @bot.reload.webhook
+  end
+
+  test "invalid webhook URL" do
+    patch bot_url(@bot), params: { user: { name: "Deploy Bot", webhook_url: "ftp://hooks.example.com" } }
+
+    assert_response :unprocessable_content
+    assert_equal "https://example.com/deploy-bot", @bot.reload.webhook.url
+  end
+
+  test "members at the bot limit aren't offered to add a bot" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    get bots_url
+    assert_select "a[href=?]", new_bot_path, count: 0
+    assert_select "p", text: /reached the limit/
+
+    get new_bot_url
+    assert_redirected_to bots_url
+  end
+
+  test "create is refused at the bot limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { user: { name: "CI Bot" } }
+    end
+    assert_response :unprocessable_content
+    assert_match "reached the limit", response.body
+  end
+
+  test "deleted bots don't count towards the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    @bot.deactivate
+
+    assert_difference -> { User.bot.active.count }, +1 do
+      post bots_url, params: { user: { name: "CI Bot" } }
+    end
+    assert_redirected_to bots_url
+  end
+
+  test "lowering the limit keeps existing bots" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+    get bots_url
+    assert_select "li", text: /Deploy Bot/
+    assert_select "a[href=?]", new_bot_path, count: 0
+  end
+
+  test "administrators aren't limited" do
+    sign_in :david
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+    get bots_url
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+
+    assert_difference -> { User.bot.count }, +1 do
+      post bots_url, params: { user: { name: "CI Bot" } }
+    end
+  end
+
+  test "suspended bots stay listed with the reason" do
+    @bot.suspend "flooding"
+
+    get bots_url
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "*", text: /Suspended/
+      assert_select "*", text: /Posted too many messages too quickly/
+      assert_select "button", text: /Reactivate/, count: 0
+    end
+  end
+
+  test "suspended bots still count towards the bot limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    @bot.suspend "flooding"
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { user: { name: "CI Bot" } }
+    end
+    assert_response :unprocessable_content
+  end
+
+  test "administrators reactivate suspended bots" do
+    sign_in :david
+    @bot.suspend "failing_webhook"
+    @bot.webhook.update!(consecutive_failures: 10)
+
+    get bots_url
+    assert_select "form[action=?] button[data-turbo-confirm]", bot_suspension_path(@bot), text: /Reactivate/
+
+    delete bot_suspension_url(@bot)
+    assert_redirected_to bots_url
+    assert_not @bot.reload.suspended?
+    assert_equal 0, @bot.webhook.consecutive_failures
+  end
+
+  test "members can't reactivate their bots" do
+    @bot.suspend "flooding"
+
+    delete bot_suspension_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+end
