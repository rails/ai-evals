new file mode 100644
index 0000000..407d398
--- /dev/null
+++ b/app/models/user/suspendable.rb
@@ -0,0 +1,96 @@
+# Misbehaving bots are stopped automatically (see docs/bots.md, "Suspension"):
+#
+# * Flooding: more than MESSAGE_LIMIT messages in MESSAGE_WINDOW starts a COOLDOWN; posting
+#   during it is refused, and ATTEMPTS_TO_SUSPEND more attempts suspend the bot.
+# * Failing webhooks: Webhook suspends the bot after Webhook::FAILURES_TO_SUSPEND failed deliveries in a row.
+#
+# Suspended bots keep their rooms, messages and place in their creator's bot limit, but can't
+# post and receive no webhooks until an administrator reactivates them. The limits are fixed.
+module User::Suspendable
+  extend ActiveSupport::Concern
+
+  MESSAGE_LIMIT = 10
+  MESSAGE_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  ATTEMPTS_TO_SUSPEND = 5
+
+  SUSPENSION_REASONS = {
+    "flooding"        => "Posted too many messages too quickly",
+    "failing_webhook" => "Its webhook failed #{Webhook::FAILURES_TO_SUSPEND} times in a row"
+  }
+
+  class Suspended < StandardError; end
+
+  class Throttled < StandardError
+    attr_reader :retry_after
+
+    def initialize(retry_after)
+      @retry_after = retry_after
+      super "Posting too fast, retry in #{retry_after}s"
+    end
+  end
+
+  included do
+    scope :suspended, -> { where.not(suspended_at: nil) }
+    scope :not_suspended, -> { where(suspended_at: nil) }
+
+    validates :suspension_reason, inclusion: { in: SUSPENSION_REASONS.keys }, allow_nil: true
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def suspension_reason_description
+    SUSPENSION_REASONS[suspension_reason]
+  end
+
+  def suspend(reason)
+    update! suspended_at: Time.current, suspension_reason: reason unless suspended?
+  end
+
+  def reactivate
+    transaction do
+      update! suspended_at: nil, suspension_reason: nil, posting_cooldown_ends_at: nil, posting_cooldown_attempts: 0
+      webhook&.update!(consecutive_failures: 0)
+    end
+  end
+
+  def posting_cooldown?
+    posting_cooldown_ends_at&.future?
+  end
+
+  # Wraps every message a bot posts (API and webhook replies). The row lock serializes
+  # concurrent posts by the same bot, so the count can't be raced past the limit.
+  # Raises Suspended or Throttled instead of yielding when the bot may not post.
+  def post_within_rate_limit
+    reached = false
+    result = nil
+
+    with_lock do
+      if suspended?
+        raise Suspended
+      elsif posting_cooldown?
+        record_attempt_during_cooldown
+        reached = true
+      elsif messages.where(created_at: MESSAGE_WINDOW.ago..).count >= MESSAGE_LIMIT
+        update! posting_cooldown_ends_at: COOLDOWN.from_now, posting_cooldown_attempts: 0
+        reached = true
+      else
+        result = yield
+      end
+    end
+
+    reached ? raise(Throttled.new(posting_cooldown_seconds_left)) : result
+  end
+
+  def posting_cooldown_seconds_left
+    posting_cooldown? ? (posting_cooldown_ends_at - Time.current).ceil.clamp(1..) : 0
+  end
+
+  private
+    def record_attempt_during_cooldown
+      increment! :posting_cooldown_attempts
+      suspend "flooding" if posting_cooldown_attempts >= ATTEMPTS_TO_SUSPEND
+    end
+end
diff --git a/app/models/webhook.rb b/app/models/webhook.rb
new file mode 100644
index 0000000..e793651
--- /dev/null
+++ b/app/models/webhook.rb
@@ -0,0 +1,129 @@
+require "net/http"
+
+# A bot's HTTP callback. When a person mentions the bot, the message is POSTed to the
+# webhook as JSON; when the bot is added to a room (direct ones aside), a `joined` event is.
+# See docs/bots.md for the payloads. The bot can answer either event in the HTTP response
+# (200 + text/plain or text/html) or later through its posting URL (`reply_to`).
+#
+# Ten failed deliveries in a row (non-2xx, timeout, connection error) suspend the bot;
+# a successful one resets the count. Suspended bots receive no webhooks.
+class Webhook < ApplicationRecord
+  ENDPOINT_TIMEOUT = 7.seconds
+  FAILURES_TO_SUSPEND = 10
+  MAX_RESPONSE_SIZE = 1.megabyte
+  REPLY_CONTENT_TYPES = %w[ text/plain text/html ]
+
+  belongs_to :user
+
+  normalizes :url, with: ->(url) { url.strip }
+
+  validate :url_is_http
+
+  def deliver(message)
+    deliver_to message.room, payload: mention_payload_for(message)
+  end
+
+  # Skipped when the bot left the room before the job ran: it'd greet a room it's no longer in.
+  def deliver_joined(room)
+    if room.memberships.exists?(user: user)
+      deliver_to room, payload: joined_payload_for(room)
+    end
+  end
+
+  private
+    # Jobs enqueued before the bot was suspended are dropped here.
+    def deliver_to(room, payload:)
+      unless user.suspended?
+        post(payload).tap do |response|
+          record_delivery response
+          reply_to room, with: response
+        end
+      end
+    rescue Net::OpenTimeout, Net::ReadTimeout, SocketError, SystemCallError, OpenSSL::SSL::SSLError, IOError => error
+      Rails.logger.warn "Webhook for bot #{user_id} failed: #{error.class} (#{error.message})"
+      record_failure
+      nil
+    end
+
+    def record_delivery(response)
+      if response.is_a?(Net::HTTPSuccess)
+        update_columns consecutive_failures: 0 if consecutive_failures.nonzero?
+      else
+        Rails.logger.warn "Webhook for bot #{user_id} failed: HTTP #{response.code}"
+        record_failure
+      end
+    end
+
+    # Counted in SQL so concurrent deliveries for the same bot don't lose failures.
+    def record_failure
+      Webhook.where(id: id).update_all("consecutive_failures = consecutive_failures + 1")
+      user.suspend "failing_webhook" if reload.consecutive_failures >= FAILURES_TO_SUSPEND
+    end
+
+    def url_is_http
+      errors.add :url, "must be an http:// or https:// address" unless uri.is_a?(URI::HTTP) && uri.host.present?
+    end
+
+    def uri
+      URI.parse(url.to_s)
+    rescue URI::InvalidURIError
+      nil
+    end
+
+    def post(payload)
+      target = uri
+
+      Net::HTTP.start(target.host, target.port, use_ssl: target.scheme == "https",
+          open_timeout: ENDPOINT_TIMEOUT, read_timeout: ENDPOINT_TIMEOUT, write_timeout: ENDPOINT_TIMEOUT) do |http|
+        http.request Net::HTTP::Post.new(target, "Content-Type" => "application/json").tap { |request| request.body = payload }
+      end
+    end
+
+    def mention_payload_for(message)
+      {
+        event:   "mention",
+        author:  { id: message.creator.id, name: message.creator.name },
+        room:    room_payload_for(message.room),
+        message: {
+          id:   message.id,
+          body: { text: text_addressed_to_bot(message), html: message.body.body.to_html },
+          link: url_helpers.room_at_message_path(message.room, message)
+        }
+      }.to_json
+    end
+
+    def joined_payload_for(room)
+      { event: "joined", room: room_payload_for(room) }.to_json
+    end
+
+    def room_payload_for(room)
+      { id: room.id, name: room.name, reply_to: url_helpers.room_bot_messages_path(room, user.bot_key) }
+    end
+
+    # Strips the bot's own @-mention so the text reads as the command addressed to it.
+    def text_addressed_to_bot(message)
+      message.plain_text_body
+        .gsub(/#{Regexp.escape(user.attachable_plain_text_representation(nil))}[[:blank:]]*/, "")
+        .gsub(/\A[[:space:]]+|[[:space:]]+\z/, "")
+    end
+
+    def reply_to(room, with:)
+      if (text = reply_body_from(with)).present?
+        body = with.content_type == "text/html" ? text : ERB::Util.html_escape(text).gsub(/\r?\n/, "<br>")
+        user.post_within_rate_limit { room.messages.create!(body: body, creator: user) }.broadcast_create
+      end
+    rescue User::Suspendable::Throttled, User::Suspendable::Suspended => error
+      Rails.logger.warn "Webhook reply from bot #{user_id} not posted: #{error.class}"
+    end
+
+    def reply_body_from(response)
+      if response.is_a?(Net::HTTPOK) && REPLY_CONTENT_TYPES.include?(response.content_type)
+        body = response.body.to_s
+        body.dup.force_encoding(Encoding::UTF_8).scrub.strip if body.bytesize <= MAX_RESPONSE_SIZE
+      end
+    end
+
+    def url_helpers
+      Rails.application.routes.url_helpers
+    end
+end
