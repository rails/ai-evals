diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..9c01485
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "create bot" do
+    bot = User.create_bot!(name: "CI Bot", creator: users(:jz))
+
+    assert bot.bot?
+    assert_match /\A#{bot.id}-[[:alnum:]]{24}\z/, bot.bot_key
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+    assert_includes users(:jz).bots, bot
+  end
+
+  test "authenticate bot" do
+    bot = users(:deploy_bot)
+
+    assert_equal bot, User.authenticate_bot(bot.bot_key)
+    assert_nil User.authenticate_bot("#{bot.id}-nope")
+    assert_nil User.authenticate_bot("#{bot.id}")
+    assert_nil User.authenticate_bot(nil)
+    assert_nil User.authenticate_bot("#{users(:david).id}-anything")
+  end
+
+  test "deactivated bots can't authenticate" do
+    bot = users(:deploy_bot)
+    bot_key = bot.bot_key
+
+    bot.deactivate
+
+    assert_nil bot.reload.bot_token
+    assert_nil User.authenticate_bot(bot_key)
+  end
+
+  test "people don't have bot keys" do
+    assert_nil users(:david).bot_key
+  end
+end
