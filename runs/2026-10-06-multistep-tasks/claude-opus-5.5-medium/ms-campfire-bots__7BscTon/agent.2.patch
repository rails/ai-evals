+++ b/test/models/webhook_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class WebhookTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:deploy_bot)
+    @webhook = webhooks(:deploy_bot)
+    @room = rooms(:watercooler)
+    @message = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(:deploy_bot)} restart the build please</div>")
+  end
+
+  test "posts a JSON mention payload" do
+    payload = nil
+    stub_request(:post, @webhook.url).with(headers: { "Content-Type" => "application/json" }).to_return do |request|
+      payload = JSON.parse(request.body)
+      { status: 204 }
+    end
+
+    @webhook.deliver(@message)
+
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => users(:david).id, "name" => "David" }, payload["author"])
+    assert_equal({ "id" => @room.id, "name" => "All Talk", "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_key}/messages" }, payload["room"])
+    assert_equal @message.id, payload["message"]["id"]
+    assert_equal "restart the build please", payload["message"]["body"]["text"]
+    assert_includes payload["message"]["body"]["html"], "restart the build please"
+    assert_equal "/rooms/#{@room.id}/@#{@message.id}", payload["message"]["link"]
+  end
+
+  test "keeps mentions of other people in the text" do
+    message = @room.messages.create!(creator: users(:david), body: "<div>Hey #{mention_attachment_for(:deploy_bot)} ping #{mention_attachment_for(:kevin)}</div>")
+    stub_request(:post, @webhook.url).to_return(status: 204)
+
+    @webhook.deliver(message)
+
+    assert_requested(:post, @webhook.url) { |req| JSON.parse(req.body).dig("message", "body", "text") == "Hey ping @Kevin" }
+  end
+
+  test "plain text reply is posted escaped as the bot" do
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "Restarting <now>\nhang on", headers: { "Content-Type" => "text/plain; charset=utf-8" })
+
+    assert_difference -> { @room.messages.count }, +1 do
+      @webhook.deliver(@message)
+    end
+
+    reply = @room.messages.ordered.last
+    assert_equal @bot, reply.creator
+    assert_equal "Restarting <now>\nhang on", reply.body.to_plain_text
+    assert_includes reply.body.body.to_html, "&lt;now&gt;"
+  end
+
+  test "html reply is posted as rich text" do
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "<strong>Done</strong>", headers: { "Content-Type" => "text/html" })
+
+    @webhook.deliver(@message)
+
+    reply = @room.messages.ordered.last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.body.to_html, "<strong>Done</strong>"
+  end
+
+  test "no content posts nothing" do
+    stub_request(:post, @webhook.url).to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      @webhook.deliver(@message)
+    end
+  end
+
+  test "other content types, errors and timeouts post nothing" do
+    stub_request(:post, @webhook.url).to_return(
+      { status: 200, body: "{}", headers: { "Content-Type" => "application/json" } },
+      { status: 500, body: "oops", headers: { "Content-Type" => "text/plain" } }
+    ).then.to_timeout
+
+    assert_no_difference -> { Message.count } do
+      3.times { @webhook.deliver(@message) }
+    end
+  end
+
+  test "url must be http" do
+    assert Webhook.new(user: @bot, url: "https://bots.example.com/hook").valid?
+    assert_not Webhook.new(user: @bot, url: "ftp://bots.example.com/hook").valid?
+    assert_not Webhook.new(user: @bot, url: "not a url").valid?
+  end
+end
