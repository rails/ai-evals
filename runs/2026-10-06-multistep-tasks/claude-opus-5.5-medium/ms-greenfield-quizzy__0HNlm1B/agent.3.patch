diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..6717a74
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,97 @@
+# The player's side of a game, opened from the join link /play/:code.
+#
+# The browser is remembered by a random token in a permanent signed cookie, so
+# opening the join link again continues as the same player. The page loads its
+# live part from #state (polled, and fetched right away on Action Cable pings).
+class PlayController < ApplicationController
+  BROWSER_COOKIE = :quizzy_browser
+
+  layout "play"
+
+  skip_forgery_protection only: :leave
+  before_action :set_game
+  before_action :set_player, except: :join
+  after_action :no_store
+
+  def show
+    @player&.seen!
+  end
+
+  def join
+    @player = current_player
+    if @player || @game.finished?
+      return redirect_to play_path(@game.code), status: :see_other
+    end
+
+    @player = @game.players.build(name: params.dig(:player, :name), browser_token: browser_token)
+    if @player.save
+      @game.broadcast_stats
+      redirect_to play_path(@game.code), status: :see_other
+    else
+      @join_player = @player
+      @player = nil
+      render :show, status: :unprocessable_content
+    end
+  rescue ActiveRecord::RecordNotUnique
+    redirect_to play_path(@game.code), status: :see_other
+  end
+
+  # The live part of the page. Answers 204 when the client already shows the
+  # current version (cheap polling); every request is also a presence check-in.
+  def state
+    return head :not_found unless @player
+    @player.seen!
+    if params[:v].present? && params[:v] == helpers.player_state_version(@game, @player)
+      head :no_content
+    else
+      render partial: "play/state", locals: { game: @game, player: @player }
+    end
+  end
+
+  def answer
+    return redirect_to play_path(@game.code), status: :see_other unless @player
+    @player.seen!
+    accepted = @player.answer!(params[:question_id], params[:option_id])
+    if live_request?
+      render partial: "play/state", locals: { game: @game, player: @player },
+             status: accepted ? :ok : :conflict
+    else
+      redirect_to play_path(@game.code), status: :see_other
+    end
+  end
+
+  # Sent with navigator.sendBeacon when the page is closed.
+  def leave
+    @player&.gone!
+    head :no_content
+  end
+
+  private
+    def set_game
+      @game = Game.includes(:quiz).find_by(code: Game.normalize_code(params[:code]))
+      render :not_found, status: :not_found unless @game
+    end
+
+    def set_player
+      @player = current_player
+    end
+
+    def current_player
+      token = cookies.signed[BROWSER_COOKIE]
+      token && @game.players.find_by(browser_token: token)
+    end
+
+    def browser_token
+      token = cookies.signed[BROWSER_COOKIE].presence || SecureRandom.base58(32)
+      cookies.permanent.signed[BROWSER_COOKIE] = { value: token, httponly: true, same_site: :lax }
+      token
+    end
+
+    def live_request?
+      request.headers["X-Quizzy-Live"].present?
+    end
+
+    def no_store
+      response.headers["Cache-Control"] = "no-store"
+    end
+end
diff --git a/app/helpers/games_helper.rb b/app/helpers/games_helper.rb
new file mode 100644
index 0000000..7a636e2
--- /dev/null
+++ b/app/helpers/games_helper.rb
@@ -0,0 +1,41 @@
+require "rqrcode"
+
+module GamesHelper
+  # Full join URL, e.g. http://localhost:3000/play/K7RZX
+  def join_url_for(game)
+    play_url(game.code, host: request.host_with_port, protocol: request.protocol)
+  end
+
+  # The join URL without the scheme, for reading off the big screen.
+  def join_link_text(game)
+    join_url_for(game).sub(%r{\Ahttps?://}, "")
+  end
+
+  def qr_svg(text)
+    RQRCode::QRCode.new(text, level: :m).as_svg(
+      module_size: 8, standalone: true, use_path: true, viewbox: true,
+      color: "0d0640", fill: "ffffff", offset: 0
+    ).html_safe # rubocop:disable Rails/OutputSafety -- generated by rqrcode from our own URL
+  end
+
+  # Identifies what the player's live part shows; the page sends it back when
+  # polling and gets 204 if nothing changed.
+  def player_state_version(game, player)
+    answer = player.answer_for(game.current_question_id)
+    "#{game.state_version}.#{answer&.option_id || 0}"
+  end
+
+  # A big-screen control: posts the state version it was rendered for.
+  def screen_control(label, path, game)
+    button_to label, path, params: { version: game.state_version }, class: "btn btn--pink btn--lg",
+              form: { class: "screen-control" }
+  end
+
+  def option_letter(index)
+    index < 26 ? ("A".ord + index).chr : (index + 1).to_s
+  end
+
+  def share_percent(count, total)
+    total.positive? ? (100.0 * count / total).round : 0
+  end
+end
diff --git a/app/javascript/controllers/player_controller.js b/app/javascript/controllers/player_controller.js
new file mode 100644
index 0000000..a03c02a
--- /dev/null
+++ b/app/javascript/controllers/player_controller.js
@@ -0,0 +1,167 @@
+import { Controller } from "@hotwired/stimulus"
+import { subscribe, fetchWithTimeout, morphInto, sleep } from "lib/live"
+
+// The player's phone. Follows the game (Action Cable pings + polling, which is
+// also the presence check-in) and sends answers in the background: the tapped
+// option is marked at once, and sending is retried until it gets through.
+const POLL_CABLE_MS = 5000   // WebSocket is up: polling is only a safety net
+const POLL_NO_CABLE_MS = 2000
+
+export default class extends Controller {
+  static targets = ["content", "offline"]
+  static values = { code: String, stateUrl: String, leaveUrl: String }
+
+  connect() {
+    this.cableUp = false
+    this.failures = 0
+    this.queued = null
+    this.sending = false
+    this.cable = subscribe({ code: this.codeValue, role: "player" }, {
+      received: (data) => this.ping(data),
+      status: (up) => {
+        this.cableUp = up
+        if (up) this.refresh() // catch up on anything missed while disconnected
+        else this.schedule()
+      }
+    })
+
+    this.onVisible = () => { if (document.visibilityState === "visible") this.refresh() }
+    this.onOnline = () => this.refresh()
+    this.onPageHide = (event) => { if (!event.persisted) this.leave() }
+    this.onPageShow = (event) => { if (event.persisted) this.refresh() }
+    document.addEventListener("visibilitychange", this.onVisible)
+    window.addEventListener("online", this.onOnline)
+    window.addEventListener("pagehide", this.onPageHide)
+    window.addEventListener("pageshow", this.onPageShow)
+    this.schedule()
+  }
+
+  disconnect() {
+    this.disconnected = true
+    clearTimeout(this.timer)
+    this.cable?.unsubscribe()
+    document.removeEventListener("visibilitychange", this.onVisible)
+    window.removeEventListener("online", this.onOnline)
+    window.removeEventListener("pagehide", this.onPageHide)
+    window.removeEventListener("pageshow", this.onPageShow)
+  }
+
+  get version() {
+    return this.contentTarget.querySelector("[data-version]")?.dataset.version || ""
+  }
+
+  ping(data) {
+    if (data.state === undefined) return
+    if (String(data.state) === this.version.split(".")[0]) return
+    // Spread the fetches of a crowded room a little.
+    setTimeout(() => this.refresh(), Math.random() * 400)
+  }
+
+  schedule() {
+    clearTimeout(this.timer)
+    if (this.disconnected) return
+    this.timer = setTimeout(() => this.refresh(), this.cableUp ? POLL_CABLE_MS : POLL_NO_CABLE_MS)
+  }
+
+  async refresh() {
+    if (this.disconnected) return
+    if (this.inflight) { this.again = true; return }
+    this.inflight = true
+    try {
+      const url = `${this.stateUrlValue}?v=${encodeURIComponent(this.version)}`
+      const response = await fetchWithTimeout(url)
+      if (response.status === 200) {
+        const html = await response.text()
+        if (!this.sending && !this.disconnected) morphInto(this.contentTarget, html)
+      } else if (response.status === 404) {
+        window.location.reload() // the player is gone (e.g. cookies cleared)
+        return
+      }
+      this.setOnline(response.ok)
+    } catch {
+      this.setOnline(false)
+    } finally {
+      this.inflight = false
+      if (this.again) {
+        this.again = false
+        setTimeout(() => this.refresh(), 0)
+      } else {
+        this.schedule()
+      }
+    }
+  }
+
+  setOnline(ok) {
+    this.failures = ok ? 0 : this.failures + 1
+    this.offlineTarget.hidden = this.failures < 2
+  }
+
+  // A tap on an option: mark it right away and send it in the background.
+  pick(event) {
+    event.preventDefault()
+    const form = event.currentTarget
+    const button = form.querySelector("button")
+    this.contentTarget.querySelectorAll(".play-option").forEach((option) => {
+      option.classList.remove("is-picked")
+      option.setAttribute("aria-pressed", "false")
+      option.querySelector(".play-option__mark")?.remove()
+    })
+    button.classList.add("is-picked")
+    button.setAttribute("aria-pressed", "true")
+    const mark = document.createElement("span")
+    mark.className = "play-option__mark"
+    mark.textContent = "Your answer"
+    button.appendChild(mark)
+    this.setStatus("Sending…")
+
+    this.queued = { url: form.action, body: new FormData(form) }
+    this.sendAnswers()
+  }
+
+  async sendAnswers() {
+    if (this.sending) return
+    this.sending = true
+    let delay = 500
+    try {
+      while (this.queued && !this.disconnected) {
+        const item = this.queued
+        try {
+          const response = await fetchWithTimeout(item.url, { method: "POST", body: item.body })
+          if (response.ok || response.status === 409) {
+            const html = await response.text()
+            this.setOnline(true)
+            if (this.queued === item) {
+              this.queued = null
+              morphInto(this.contentTarget, html)
+            }
+            delay = 500
+            continue
+          }
+          if (response.status === 422 || response.status === 404) {
+            // Session or player lost: reload to get a fresh page.
+            this.queued = null
+            window.location.reload()
+            return
+          }
+          throw new Error(`HTTP ${response.status}`)
+        } catch {
+          this.setOnline(false)
+          if (this.queued === item) this.setStatus("Not sent yet, retrying…")
+          await sleep(delay)
+          delay = Math.min(delay * 2, 4000)
+        }
+      }
+    } finally {
+      this.sending = false
+    }
+  }
+
+  setStatus(text) {
+    const status = this.contentTarget.querySelector("[data-role=status]")
+    if (status) status.textContent = text
+  }
+
+  leave() {
+    if (navigator.sendBeacon) navigator.sendBeacon(this.leaveUrlValue)
+  }
+}
diff --git a/app/javascript/controllers/screen_controller.js b/app/javascript/controllers/screen_controller.js
new file mode 100644
index 0000000..24467f4
--- /dev/null
+++ b/app/javascript/controllers/screen_controller.js
@@ -0,0 +1,70 @@
+import { Controller } from "@hotwired/stimulus"
+import { subscribe, fetchWithTimeout, morphInto } from "lib/live"
+
+// The moderator's big screen: refreshes its live part on Action Cable pings
+// and every couple of seconds (presence counters age out without any ping).
+const POLL_MS = 2000
+
+export default class extends Controller {
+  static targets = ["content", "offline"]
+  static values = { code: String, liveUrl: String }
+
+  connect() {
+    this.failures = 0
+    this.cable = subscribe({ code: this.codeValue, role: "screen" }, {
+      received: () => this.refreshSoon(),
+      status: (up) => { if (up) this.refreshSoon() }
+    })
+    this.schedule()
+  }
+
+  disconnect() {
+    clearTimeout(this.timer)
+    clearTimeout(this.soonTimer)
+    this.cable?.unsubscribe()
+    this.disconnected = true
+  }
+
+  schedule(delay = POLL_MS) {
+    clearTimeout(this.timer)
+    if (!this.disconnected) this.timer = setTimeout(() => this.refresh(), delay)
+  }
+
+  // Coalesces bursts of pings (many answers at once) into one fetch.
+  refreshSoon() {
+    if (this.soonTimer) return
+    this.soonTimer = setTimeout(() => {
+      this.soonTimer = null
+      this.refresh()
+    }, 150)
+  }
+
+  async refresh() {
+    if (this.inflight) { this.again = true; return }
+    this.inflight = true
+    try {
+      const response = await fetchWithTimeout(this.liveUrlValue)
+      if (response.ok) {
+        const html = await response.text()
+        if (!this.disconnected && !this.submitting()) morphInto(this.contentTarget, html)
+        this.failures = 0
+      } else {
+        this.failures += 1
+      }
+    } catch {
+      this.failures += 1
+    } finally {
+      this.inflight = false
+      this.offlineTarget.hidden = this.failures < 2
+      if (this.again) {
+        this.again = false
+        this.refreshSoon()
+      }
+      this.schedule()
+    }
+  }
+
+  submitting() {
+    return !!this.contentTarget.querySelector("form[aria-busy=true]")
+  }
+}
diff --git a/app/javascript/lib/live.js b/app/javascript/lib/live.js
new file mode 100644
index 0000000..5c18ed1
--- /dev/null
+++ b/app/javascript/lib/live.js
@@ -0,0 +1,59 @@
+// Shared bits of the live pages (big screen and player).
+//
+// Transport: Action Cable only carries small "something changed" pings; the
+// pages fetch their HTML over plain HTTP and also poll, so they keep working
+// (a bit slower) when WebSockets are blocked or flaky on conference Wi-Fi.
+import { Turbo, cable } from "@hotwired/turbo-rails"
+
+export function subscribe(params, { received, status }) {
+  let subscription = null
+  let cancelled = false
+  cable.subscribeTo({ channel: "GameChannel", ...params }, {
+    connected() { status(true) },
+    disconnected() { status(false) },
+    rejected() { status(false) },
+    received(data) { received(data || {}) }
+  }).then((s) => {
+    subscription = s
+    if (cancelled) s.unsubscribe()
+  }).catch(() => status(false))
+
+  return {
+    unsubscribe() {
+      cancelled = true
+      subscription?.unsubscribe()
+    },
+    perform(action, data = {}) {
+      subscription?.perform(action, data)
+    }
+  }
+}
+
+export async function fetchWithTimeout(url, options = {}, timeout = 10000) {
+  const controller = new AbortController()
+  const timer = setTimeout(() => controller.abort(), timeout)
+  try {
+    return await fetch(url, {
+      credentials: "same-origin",
+      cache: "no-store",
+      ...options,
+      headers: { Accept: "text/html", "X-Quizzy-Live": "1", ...(options.headers || {}) },
+      signal: controller.signal
+    })
+  } finally {
+    clearTimeout(timer)
+  }
+}
+
+// Morphs `html` into `container`, keeping unchanged elements in place.
+export function morphInto(container, html) {
+  const next = document.createElement("div")
+  next.innerHTML = html
+  if (Turbo.morphChildren) {
+    Turbo.morphChildren(container, next)
+  } else {
+    container.replaceChildren(...next.childNodes)
+  }
+}
+
+export const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms))
