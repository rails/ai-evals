diff --git a/app/views/play/_state.html.erb b/app/views/play/_state.html.erb
new file mode 100644
index 0000000..40342b9
--- /dev/null
+++ b/app/views/play/_state.html.erb
@@ -0,0 +1,63 @@
+<%# The live part of the player's page. Correct options are only rendered once the question is closed. %>
+<% question = game.current_question %>
+<% answer = player.answer_for(game.current_question_id) %>
+<div class="play-state" data-version="<%= player_state_version(game, player) %>" data-state="<%= game.state %>">
+  <% if game.lobby? %>
+    <div class="waiting">
+      <div class="waiting__gem" aria-hidden="true">?</div>
+      <h1 class="play-title">You’re in!</h1>
+      <p class="play-lead"><%= game.quiz.title %></p>
+      <p class="play-lead">Wait for the quiz to start.</p>
+    </div>
+  <% elsif game.finished? %>
+    <div class="waiting">
+      <div class="waiting__gem" aria-hidden="true">?</div>
+      <h1 class="play-title">The quiz is over</h1>
+      <p class="play-lead">Thanks for playing!</p>
+    </div>
+  <% elsif question.nil? %>
+    <div class="waiting">
+      <div class="waiting__gem" aria-hidden="true">?</div>
+      <p class="play-lead">Wait for the next question.</p>
+    </div>
+  <% else %>
+    <% closed = game.closed? %>
+    <section class="play-question">
+      <div class="play-question__num">Question <%= game.question_number %> of <%= game.question_total %></div>
+      <div class="play-question__body"><%= question.body %></div>
+      <div class="play-options <%= "is-locked is-revealed" if closed %>">
+        <% question.options.each_with_index do |option, index| %>
+          <% picked = answer&.option_id == option.id %>
+          <% classes = [ "play-option", ("is-picked" if picked), ("is-correct" if closed && option.correct?) ].compact.join(" ") %>
+          <% content = capture do %>
+            <span class="play-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+            <span class="play-option__title"><%= option.title %></span>
+            <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+          <% end %>
+          <% if closed %>
+            <button type="button" class="<%= classes %>" disabled aria-pressed="<%= picked %>"><%= content %></button>
+          <% else %>
+            <%= form_with url: play_answer_path(game.code), method: :post, data: { turbo: false, action: "submit->player#pick" } do %>
+              <%= hidden_field_tag :question_id, question.id, id: nil %>
+              <%= hidden_field_tag :option_id, option.id, id: nil %>
+              <button type="submit" class="<%= classes %>" aria-pressed="<%= picked %>"><%= content %></button>
+            <% end %>
+          <% end %>
+        <% end %>
+      </div>
+      <% if closed %>
+        <% if answer.nil? %>
+          <div class="play-status play-status--neutral" role="status">No answer</div>
+        <% elsif answer.correct? %>
+          <div class="play-status play-status--right" role="status">Correct!</div>
+        <% else %>
+          <div class="play-status play-status--wrong" role="status">Wrong!</div>
+        <% end %>
+      <% else %>
+        <div class="play-status play-status--neutral" role="status" data-role="status">
+          <%= answer ? "Answer sent. You can change it until the question is closed." : "Tap an answer." %>
+        </div>
+      <% end %>
+    </section>
+  <% end %>
+</div>
