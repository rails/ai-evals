--- /dev/null
+++ b/app/channels/application_cable/connection.rb
@@ -0,0 +1,12 @@
+module ApplicationCable
+  # Anyone may connect: the cable only carries "something changed" pings, the
+  # content itself is fetched over HTTP. The browser token (set by
+  # PlayController) tells which player a connection belongs to, for presence.
+  class Connection < ActionCable::Connection::Base
+    identified_by :browser_token
+
+    def connect
+      self.browser_token = cookies.signed[PlayController::BROWSER_COOKIE].presence || "anonymous-#{SecureRandom.hex(8)}"
+    end
+  end
+end
diff --git a/app/channels/game_channel.rb b/app/channels/game_channel.rb
new file mode 100644
index 0000000..9a1fe5a
--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,33 @@
+# Pings about a game. Params: `code` (the game code) and `role`:
+# - "player": state changes only; also tracks the player's presence
+#   (subscribing = the page is open, unsubscribing = it was closed);
+# - "screen": state changes and counter changes, for the big screen.
+class GameChannel < ApplicationCable::Channel
+  def subscribed
+    game = Game.find_by(code: Game.normalize_code(params[:code]))
+    return reject unless game
+
+    @game_id = game.id
+    if params[:role] == "screen"
+      stream_from game.screen_stream
+    else
+      stream_from game.players_stream
+      player&.seen!
+    end
+  end
+
+  def unsubscribed
+    player&.gone!
+  end
+
+  # Sent by the page every few seconds while it is open.
+  def heartbeat
+    player&.seen!
+  end
+
+  private
+    def player
+      return nil unless @game_id && params[:role] != "screen"
+      Player.find_by(game_id: @game_id, browser_token: browser_token)
+    end
+end
