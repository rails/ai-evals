@@ -0,0 +1,46 @@
+<% content_for :title, @game.quiz.title %>
+<div class="play">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span class="play__quiz-title"><%= @player ? "Hi, #{@player.name}!" : @game.quiz.title %></span>
+  </div>
+
+  <% if @player %>
+    <div class="play__body play__body--top" data-controller="player"
+         data-player-code-value="<%= @game.code %>"
+         data-player-state-url-value="<%= play_state_path(@game.code) %>"
+         data-player-leave-url-value="<%= play_leave_path(@game.code) %>">
+      <div class="live-offline" data-player-target="offline" role="status" hidden>Reconnecting…</div>
+      <div data-player-target="content">
+        <%= render "play/state", game: @game, player: @player %>
+      </div>
+    </div>
+  <% elsif @game.finished? %>
+    <div class="play__body">
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1 class="play-title">The quiz is over</h1>
+        <p class="play-lead">Thanks for your interest in “<%= @game.quiz.title %>”.</p>
+      </div>
+    </div>
+  <% else %>
+    <div class="play__body">
+      <h1 class="play-title"><%= @game.quiz.title %></h1>
+      <p class="play-lead">Join the quiz: no account needed.</p>
+      <%= form_with model: (@join_player || Player.new), scope: :player, url: play_join_path(@game.code), method: :post,
+            class: "join-form", data: { turbo: false } do |f| %>
+        <% if @join_player&.errors&.any? %>
+          <div class="errors" role="alert">
+            <% @join_player.errors.messages_for(:name).each do |message| %>
+              <div><%= message.sub(/\Ais too long.*/, "Use at most 40 characters") %></div>
+            <% end %>
+          </div>
+        <% end %>
+        <%= f.label :name, "Your name", class: "visually-hidden" %>
+        <%= f.text_field :name, class: "input", placeholder: "Your name", required: true, maxlength: 40,
+              autocomplete: "nickname", autofocus: true, enterkeyhint: "go" %>
+        <%= f.submit "Join", class: "btn btn--pink" %>
+      <% end %>
+    </div>
+  <% end %>
+</div>
