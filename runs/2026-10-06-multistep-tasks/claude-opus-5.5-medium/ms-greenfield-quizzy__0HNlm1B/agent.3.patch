new file mode 100644
index 0000000..5781f6c
--- /dev/null
+++ b/app/views/moderate/games/_screen.html.erb
@@ -0,0 +1,76 @@
+<%# The live part of the big screen. It is morphed into the page (Turbo.morphChildren), so unchanged parts stay put. %>
+<% question = game.current_question %>
+<% online = game.online_players.count %>
+<div class="screen" data-version="<%= game.state_version %>" data-state="<%= game.state %>">
+  <div class="screen__top">
+    <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span class="screen__quiz-title"><%= game.quiz.title %></span>
+  </div>
+
+  <div class="screen__body">
+    <% if game.lobby? %>
+      <div class="lobby">
+        <div>
+          <h1 class="lobby__title"><%= game.quiz.title %></h1>
+          <div class="lobby__join">Join on your phone:</div>
+          <div class="lobby__url" data-role="join-link"><%= join_link_text(game) %></div>
+          <div class="counter-pill" data-role="players">Players: <strong><%= online %></strong></div>
+          <% if game.question_total.zero? %>
+            <p class="screen-hint">This quiz has no active questions yet.</p>
+          <% end %>
+        </div>
+        <div class="qr" role="img" aria-label="QR code: <%= join_url_for(game) %>"><%= qr_svg(join_url_for(game)) %></div>
+      </div>
+    <% elsif game.finished? %>
+      <div class="screen-over">
+        <h1 class="lobby__title">The quiz is over</h1>
+        <p class="lobby__join">Thanks for playing “<%= game.quiz.title %>”!</p>
+      </div>
+    <% elsif question.nil? %>
+      <div class="screen-over">
+        <p class="lobby__join">This question was deleted. Go on with “Next”.</p>
+      </div>
+    <% else %>
+      <% closed = game.closed? %>
+      <% counts = closed ? game.option_counts : {} %>
+      <% total_answers = game.current_answers.count %>
+      <div class="stage-question__num">Question <%= game.question_number %> of <%= game.question_total %></div>
+      <div class="stage-question__body"><%= question.body %></div>
+      <ol class="stage-options <%= "stage-options--results" if closed %>">
+        <% question.options.each_with_index do |option, index| %>
+          <% count = counts.fetch(option.id, 0) %>
+          <li class="stage-option <%= "is-correct" if closed && option.correct? %>"
+              <% if closed %>style="--share: <%= share_percent(count, total_answers) %>%"<% end %>>
+            <% if closed %><span class="stage-option__bar" aria-hidden="true"></span><% end %>
+            <span class="stage-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+            <span class="stage-option__title"><%= option.title %></span>
+            <% if closed && option.correct? %><span class="stage-option__mark">Correct</span><% end %>
+            <% if closed %><span class="stage-option__count" aria-label="<%= pluralize(count, "answer") %>"><%= count %></span><% end %>
+          </li>
+        <% end %>
+      </ol>
+      <div class="answers-counter screen-answers" data-role="answers">Answers: <%= total_answers %> / <%= online %></div>
+    <% end %>
+  </div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "← Quiz", moderate_quiz_path(game.quiz), data: { turbo: false } %>
+      <span>Game <%= game.code %></span>
+      <% unless game.lobby? || game.finished? %>
+        <span>Join: <strong><%= join_link_text(game) %></strong></span>
+      <% end %>
+    </div>
+    <div class="buttons">
+      <% if game.lobby? %>
+        <%= screen_control "Start", start_moderate_game_path(game), game %>
+      <% elsif game.open? %>
+        <%= screen_control "Finish", finish_moderate_game_path(game), game %>
+      <% elsif game.closed? && game.last_question? %>
+        <%= screen_control "End quiz", end_moderate_game_path(game), game %>
+      <% elsif game.closed? %>
+        <%= screen_control "Next", next_moderate_game_path(game), game %>
+      <% end %>
+    </div>
+  </div>
+</div>
