diff --git a/docs/architecture.md b/docs/architecture.md
index 897cf82..32d5071 100644
--- a/docs/architecture.md
+++ b/docs/architecture.md
@@ -130,3 +130,20 @@
 - solid_cable `polling_interval` is 50 ms. Measured in production: phones show a new
   question ~100–150 ms after the moderator's click.
 - Tests run with forgery protection off; the CSRF path was verified against `bin/serve`.
+
+## Timer (time per question)
+- `quizzes.timer_minutes` / `timer_seconds` ("Timer minutes" / "Timer seconds" in the quiz
+  settings, integers, default 0; 0 and 0 = no timer). Blank = 0; seconds ≥ 60 are carried
+  into minutes (90 s → 1:30). `Quiz#timer_duration` (seconds). Not exported; imports get 0.
+- `games.question_deadline_at` is set when a question opens (from the quiz's timer at that
+  moment) and cleared when it closes / the game ends. Being stored server-side, reloading
+  the screen doesn't restart the countdown.
+- Expiry is lazy: `Game#expire_question!` (a guarded `transition` from `open`, re-checked under
+  the lock, bumps `state_version` + broadcasts like "Finish") runs before the big screen
+  `show`/`live` and every `/play/:code/*` request (except `leave`). `accepts_answer_for?` also
+  rejects answers after the deadline, even before anyone expired it.
+- Big screen only: `.screen-timer` (`role="timer"`, M:SS, rounded up) next to "Question N of M",
+  driven by `countdown_controller.js` from the server-rendered `remaining-ms` value (no clock
+  skew). At 0:00 it dispatches `countdown:expired` → `screen#refresh` (retried every 500 ms
+  until the fragment comes back closed). Polls re-sync it only if it drifted > 1 s.
+  Players never get the timer in their fragment.
diff --git a/test/models/game_timer_test.rb b/test/models/game_timer_test.rb
new file mode 100644
index 0000000..89453fd
--- /dev/null
+++ b/test/models/game_timer_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class GameTimerTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Timer")
+    %w[One? Two?].each do |body|
+      q = @quiz.questions.build(body: body)
+      q.option_rows = { "0" => { "title" => "Yes", "correct" => "1" }, "1" => { "title" => "No" } }
+      q.save!
+    end
+    @game = Game.create_for!(@quiz)
+  end
+
+  test "defaults, normalization and validation" do
+    assert_equal [ 0, 0 ], [ @quiz.timer_minutes, @quiz.timer_seconds ]
+    assert_not @quiz.timer?
+    @quiz.update!(timer_minutes: "", timer_seconds: "90")
+    assert_equal [ 1, 30 ], [ @quiz.timer_minutes, @quiz.timer_seconds ]
+    assert_equal 90, @quiz.timer_duration
+    assert_not @quiz.update(timer_seconds: -1)
+    assert_not @quiz.update(timer_seconds: 5, timer_minutes: 1.5)
+  end
+
+  test "no timer by default" do
+    @game.start!(nil)
+    assert_nil @game.question_deadline_at
+    assert_not @game.timer?
+    travel 1.hour do
+      assert_not @game.expire_question!
+      assert @game.reload.open?
+    end
+  end
+
+  test "the question finishes by itself when the time is up" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 30)
+    @game.start!(nil)
+    assert_in_delta 30_000, @game.timer_remaining_ms, 1000
+    player = @game.players.create!(name: "Ann", browser_token: "t")
+    travel 29.seconds do
+      assert_not @game.expire_question!
+      assert player.answer!(@game.current_question_id, @game.current_question.options.first.id)
+    end
+    travel 31.seconds do
+      assert_not player.reload.answer!(@game.current_question_id, @game.current_question.options.last.id)
+      version = @game.reload.state_version
+      assert @game.expire_question!
+      assert @game.reload.closed?
+      assert_equal version + 1, @game.state_version
+      assert_nil @game.question_deadline_at
+      assert_not @game.expire_question!
+      assert_equal version + 1, @game.reload.state_version
+      # Next question gets a fresh timer.
+      @game.next_question!(@game.state_version)
+      assert_in_delta 30_000, @game.timer_remaining_ms, 1000
+    end
+  end
+
+  test "finish earlier" do
+    @quiz.update!(timer_seconds: 30)
+    @game.start!(nil)
+    assert @game.finish_question!(@game.state_version)
+    travel 31.seconds do
+      assert_not @game.expire_question!
+    end
+  end
+
+  test "timer is not exported" do
+    @quiz.update!(timer_minutes: 2)
+    assert_not_includes @quiz.export_data.to_json, "timer"
+  end
+end
diff --git a/test/system/timer_test.rb b/test/system/timer_test.rb
new file mode 100644
index 0000000..ea8a26d
--- /dev/null
+++ b/test/system/timer_test.rb
@@ -0,0 +1,63 @@
+require "application_system_test_case"
+
+class TimerTest < ApplicationSystemTestCase
+  setup do
+    @quiz = Quiz.create!(title: "Timer quiz")
+    %w[First? Second?].each do |body|
+      q = @quiz.questions.build(body: body)
+      q.option_rows = { "0" => { "title" => "Yes", "correct" => "1" }, "1" => { "title" => "No" } }
+      q.save!
+    end
+  end
+
+  test "timer settings" do
+    visit edit_moderate_quiz_path(@quiz)
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+    fill_in "Timer minutes", with: "1"
+    fill_in "Timer seconds", with: "30"
+    click_button "Save quiz"
+    assert_text "Quiz saved"
+    assert_equal [ 1, 30 ], [ @quiz.reload.timer_minutes, @quiz.timer_seconds ]
+  end
+
+  test "countdown finishes the question by itself, not shown to players" do
+    @quiz.update!(timer_seconds: 3)
+    visit moderate_quiz_path(@quiz)
+    click_button "Start a game"
+    game = Game.last
+    using_session(:ann) do
+      visit play_path(game.code)
+      fill_in "Your name", with: "Ann"
+      click_button "Join"
+      assert_text "Hi, Ann!"
+    end
+    click_button "Start"
+    assert_text "First?"
+    assert_selector ".screen-timer", text: /\A0:0[23]\z/
+    using_session(:ann) { assert_text "First?"; assert_no_selector ".screen-timer"; assert_no_text "0:0" }
+    assert_selector ".screen-timer", text: "0:01", wait: 3
+    refresh
+    assert_no_selector ".screen-timer", text: "0:03"
+    assert_button "Next", wait: 4
+    assert_no_button "Finish"
+    assert game.reload.closed?
+    using_session(:ann) { assert_text "No answer", wait: 7 }
+
+    # "Finish" still works earlier.
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    click_button "Next"
+    assert_selector ".screen-timer", text: /\A1:(30|29)\z/
+    click_button "Finish"
+    assert_button "End quiz"
+    assert_no_selector ".screen-timer"
