diff --git a/app/javascript/controllers/countdown_controller.js b/app/javascript/controllers/countdown_controller.js
new file mode 100644
index 0000000..5dfbe56
--- /dev/null
+++ b/app/javascript/controllers/countdown_controller.js
@@ -0,0 +1,64 @@
+import { Controller } from "@hotwired/stimulus"
+
+// The question timer on the big screen (M:SS). The server renders the time
+// left, so the countdown doesn't depend on the computer's clock and a reload
+// doesn't restart it. At 0:00 it asks the screen to refresh: the server then
+// finishes the question (Game#expire_question!); it keeps asking until it has.
+const TICK_MS = 200
+const RETRY_MS = 500
+const RESYNC_MS = 1000
+
+export default class extends Controller {
+  static values = { remainingMs: Number }
+
+  connect() {
+    this.sync()
+    this.tick()
+  }
+
+  disconnect() {
+    clearTimeout(this.timer)
+    this.deadline = null
+  }
+
+  // Polls morph in a fresh value; only jumps if we drifted noticeably.
+  remainingMsValueChanged() {
+    if (this.deadline == null) return
+    const left = this.deadline - performance.now()
+    if (Math.abs(left - this.remainingMsValue) > RESYNC_MS) {
+      this.sync()
+      this.tick()
+    } else {
+      this.render(left)
+    }
+  }
+
+  sync() {
+    this.deadline = performance.now() + this.remainingMsValue
+    this.expiredAt = null
+  }
+
+  tick() {
+    clearTimeout(this.timer)
+    if (this.deadline == null) return
+    const left = this.deadline - performance.now()
+    this.render(left)
+    if (left <= 0) {
+      const now = performance.now()
+      if (this.expiredAt == null || now - this.expiredAt >= RETRY_MS) {
+        this.expiredAt = now
+        this.dispatch("expired")
+      }
+      this.timer = setTimeout(() => this.tick(), RETRY_MS)
+    } else {
+      this.timer = setTimeout(() => this.tick(), Math.min(TICK_MS, left))
+    }
+  }
+
+  render(left) {
+    const seconds = Math.max(0, Math.ceil(left / 1000))
+    const text = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`
+    if (this.element.textContent !== text) this.element.textContent = text
+    this.element.classList.toggle("is-ending", seconds <= 5)
+  }
+}
