+<% content_for :title, "Import quiz" %>
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head"><h1>Import quiz</h1></div>
+<%= form_with url: moderate_quiz_import_path, scope: :import, class: "card" do |f| %>
+  <% if @import.errors.any? %>
+    <div class="errors" role="alert">
+      <% if @import.errors.count == 1 %>
+        <%= @import.errors.full_messages.first %>
+      <% else %>
+        <ul><% @import.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
+      <% end %>
+    </div>
+  <% end %>
+  <div class="field">
+    <%= f.label :json, "Quiz JSON" %>
+    <span class="field-hint">Paste the JSON from a quiz’s “Export” page. A new quiz is created.</span>
+    <%= f.text_area :json, value: @import.json, class: "input input--code", rows: 16, "aria-required": "true", autofocus: true, spellcheck: false %>
+  </div>
+  <div class="buttons">
+    <%= f.submit "Import", class: "btn btn--pink" %>
+    <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+  </div>
+<% end %>
