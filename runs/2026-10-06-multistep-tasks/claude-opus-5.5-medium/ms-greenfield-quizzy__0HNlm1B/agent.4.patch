new file mode 100644
index 0000000..a4faf26
--- /dev/null
+++ b/test/models/game_prizes_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class GamePrizesTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Prizes", winners_count: 2)
+    @questions = Array.new(3) do |i|
+      q = @quiz.questions.build(body: "Q#{i}", position: i)
+      q.option_rows = { "0" => { "title" => "Right", "correct" => "1" }, "1" => { "title" => "Wrong" } }
+      q.save!
+      q
+    end
+    @game = Game.create_for!(@quiz)
+    @players = %w[Ann Ben Cid Dan Eve].map { |n| @game.players.create!(name: n, browser_token: SecureRandom.hex) }
+  end
+
+  # answers: { player_name => [[question_index, correct?, elapsed_ms], ...] }
+  def play(answers)
+    answers.each do |name, picks|
+      player = @players.find { |p| p.name == name }
+      picks.each do |index, correct, ms|
+        q = @questions[index]
+        option = q.options.find_by(correct: correct)
+        Answer.create!(game: @game, player: player, question: q, option: option, elapsed_ms: ms)
+      end
+    end
+    @game.update!(state: "finished")
+  end
+
+  def winners = @game.players.where(winner: true).pluck(:name).sort
+
+  test "default and validation of the number of winners" do
+    assert_equal 3, Quiz.create!(title: "x").winners_count
+    quiz = Quiz.new(title: "x", winners_count: 0)
+    assert_not quiz.valid?
+    assert_includes quiz.errors.full_messages.join, "Number of winners"
+  end
+
+  test "leaderboard: points, then lower total time of correct answers" do
+    play("Ann" => [ [ 0, true, 900 ], [ 1, true, 900 ] ], "Ben" => [ [ 0, true, 500 ], [ 1, true, 500 ], [ 2, false, 1 ] ],
+         "Cid" => [ [ 0, true, 100 ], [ 1, false, 1 ] ], "Dan" => [ [ 0, false, 1 ] ])
+    board = @game.leaderboard
+    assert_equal %w[Ben Ann Cid Eve Dan].first(3), board.map { |s| s.player.name }.first(3)
+    assert_equal [ 2, 2, 1, 0, 0 ], board.map(&:points)
+    assert_equal [ 1, 2, 3, 4, 5 ], board.map(&:place)
+    assert_equal 1000, board.first.time_ms
+  end
+
+  test "top N, players without points never win, reset" do
+    play("Ann" => [ [ 0, true, 900 ] ], "Ben" => [ [ 0, true, 100 ] ], "Cid" => [ [ 0, true, 50 ], [ 1, true, 50 ] ])
+    assert @game.pick_top_winners!
+    assert_equal %w[Ben Cid], winners
+    @quiz.update!(winners_count: 5)
+    @game.reload.pick_top_winners!
+    assert_equal %w[Ann Ben Cid], winners
+    @game.reset_winners!
+    assert_equal [], winners
+  end
+
+  test "draw: above the cut-off always wins, the rest is drawn among the tied" do
+    @quiz.update!(winners_count: 3)
+    play("Ann" => [ [ 0, true, 1 ], [ 1, true, 1 ] ], "Ben" => [ [ 0, true, 1 ] ], "Cid" => [ [ 0, true, 5 ] ],
+         "Dan" => [ [ 0, true, 9 ] ])
+    seen = Set.new
+    30.times do |i|
+      @game.reload.draw_winners!(random: Random.new(i))
+      assert_equal 3, winners.size
+      assert_includes winners, "Ann"
+      assert_not_includes winners, "Eve"
+      seen << winners
+    end
+    assert_operator seen.size, :>, 1, "draws should vary"
+  end
+
+  test "draw with fewer players with points than prizes" do
+    @quiz.update!(winners_count: 3)
+    play("Ann" => [ [ 0, true, 1 ] ], "Ben" => [ [ 0, false, 1 ] ])
+    @game.draw_winners!
+    assert_equal %w[Ann], winners
+  end
+
+  test "winners can only be picked when the game is finished" do
+    assert_not @game.pick_top_winners!
+  end
+
+  test "answer time runs from the question opening to the last pick" do
+    @game.start!(nil)
+    @game.update_column(:question_opened_at, 3.seconds.ago)
+    player = @players.first
+    q = @game.reload.current_question
+    player.answer!(q.id, q.options.last.id)
+    first = player.answers.last.elapsed_ms
+    assert_in_delta 3000, first, 500
+    @game.update_column(:question_opened_at, 5.seconds.ago)
+    player.answer!(q.id, q.options.last.id) # same pick again: unchanged
+    assert_equal first, player.answers.last.elapsed_ms
+    player.answer!(q.id, q.options.first.id)
+    assert_in_delta 5000, player.answers.last.elapsed_ms, 500
+  end
+end
