+require "application_system_test_case"
+
+class PrizesTest < ApplicationSystemTestCase
+  setup do
+    @quiz = Quiz.create!(title: "Prize quiz")
+    [ "First?", "Second?" ].each do |body|
+      q = @quiz.questions.build(body: body)
+      q.option_rows = { "0" => { "title" => "Yes", "correct" => "1" }, "1" => { "title" => "No" } }
+      q.save!
+    end
+  end
+
+  def join(session, name, game)
+    using_session(session) do
+      visit play_path(game.code)
+      fill_in "Your name", with: name
+      click_button "Join"
+      assert_text "Hi, #{name}!"
+    end
+  end
+
+  test "number of winners setting" do
+    visit edit_moderate_quiz_path(@quiz)
+    assert_field "Number of winners", with: "3"
+    fill_in "Number of winners", with: "2"
+    click_button "Save quiz"
+    assert_text "Quiz saved"
+    assert_equal 2, @quiz.reload.winners_count
+  end
+
+  test "leaderboard, places and winners" do
+    @quiz.update!(winners_count: 2)
+    visit moderate_quiz_path(@quiz)
+    click_button "Start a game"
+    game = Game.last
+    join(:ann, "Ann", game)
+    join(:ben, "Ben", game)
+    join(:cid, "Cid", game)
+    assert_text "Players: 3"
+
+    click_button "Start"
+    using_session(:ann) { click_button "Yes"; assert_text "Answer sent" }
+    using_session(:ben) { click_button "Yes"; assert_text "Answer sent" }
+    using_session(:cid) { click_button "No"; assert_text "Answer sent" }
+    assert_text "Answers: 3 / 3"
+    click_button "Finish"
+    using_session(:ann) { assert_text "Correct!"; assert_no_text "point" }
+    click_button "Next"
+    using_session(:ben) { assert_text "Second?"; click_button "Yes"; assert_text "Answer sent" }
+    using_session(:ann) { assert_text "Second?"; click_button "No"; assert_text "Answer sent" }
+    assert_text "Answers: 2 / 3"
+    click_button "Finish"
+    click_button "End quiz"
+
+    assert_selector "li", count: 3
+    items = all("ol.leaderboard li").map(&:text)
+    assert_match(/1\s*Ben\s*2 points/, items[0])
+    assert_match(/2\s*Ann\s*1 point\b/, items[1])
+    assert_match(/3\s*Cid\s*0 points/, items[2])
+    using_session(:ben) { assert_text "Place 1 of 3"; assert_text "2 points"; assert_no_text "You won!" }
+    using_session(:cid) { assert_text "Place 3 of 3"; assert_text "0 points" }
+
+    click_button "Top 2"
+    assert_selector "li", text: /Ben.*Winner/
+    assert_selector "li", text: /Ann.*Winner/
+    assert_no_selector "li", text: /Cid.*Winner/
+    using_session(:ben) { assert_text "You won!" }
+    using_session(:ann) { assert_text "You won!" }
+    using_session(:cid) { assert_no_text "You won!" }
+
+    click_button "Reset winners"
+    assert_no_text "Winner"
+    using_session(:ben) { assert_no_text "You won!" }
+
+    click_button "Draw"
+    assert_selector "li", text: /Winner/, count: 2
+    using_session(:ann) { assert_text "You won!" }
+  end
+end
