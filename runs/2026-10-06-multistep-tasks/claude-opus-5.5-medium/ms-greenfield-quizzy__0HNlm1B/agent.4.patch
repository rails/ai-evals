+      stats = answers.joins(:option).where(options: { correct: true }).group(:player_id)
+                     .pluck(:player_id, Arel.sql("COUNT(*)"), Arel.sql("SUM(answers.elapsed_ms)"))
+                     .to_h { |id, points, time| [ id, [ points, time.to_i ] ] }
+      ranked = players.order(:id).map.with_index do |player, index|
+        points, time = stats.fetch(player.id, [ 0, 0 ])
