+  validates :timer_minutes, :timer_seconds,
+            numericality: { only_integer: true, greater_than_or_equal_to: 0, message: "must be a whole number, at least 0" }
+  validate :timer_not_too_long
 
   scope :ordered, -> { order(created_at: :desc, id: :desc) }
 
+  # Seconds per question; 0 = no timer.
+  def timer_duration
+    timer_minutes.to_i * 60 + timer_seconds.to_i
+  end
+
