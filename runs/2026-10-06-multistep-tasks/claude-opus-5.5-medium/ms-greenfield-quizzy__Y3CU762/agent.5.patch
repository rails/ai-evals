--- a/docs/NOTES.md
+++ b/docs/NOTES.md
@@ -138,3 +138,19 @@ Labels (QA): \"Number of winners\", \"Top N\", \"Draw\", \"Reset winners\", \"Wi
 \"Place X of Y\", \"You won!\".
 
 Gotcha: a stale `public/assets` (from a production precompile) shadows new JS in dev/test; delete it.
+
+## Question timer
+
+- `Quiz#timer_minutes`, `#timer_seconds` ("Timer minutes"/"Timer seconds" in the settings form, integers ≥ 0,
+  default 0, blank = 0; seconds may exceed 59; total ≤ 24 h). `Quiz#timer_duration` (s), 0 = no timer.
+  Not part of the export/import format (import → 0/0).
+- When a question opens (`start!`/`advance!`, `Game#open_question_now`), `games.question_deadline_at` =
+  opened + duration (nil without timer). The duration is pinned per question: editing settings mid-game
+  affects the next question only. Reloads render the time left from the stored deadline (no restart).
+- Big screen only: `.stage-timer[role=timer]` in `moderate/games/_question` (M:SS, seconds rounded up,
+  `GamesHelper#timer_text`). The `countdown` Stimulus controller counts from the server-rendered
+  `remaining` ms (browser clock irrelevant) and at 0:00 `requestSubmit`s `#finish_question_form`
+  (the "Finish" button's form), retrying every 3 s while still on the page.
+- Server side, lazily: `Game#finish_if_time_up!` runs before screen `show`/`ping` and phone `show`/`ping`,
+  so an expired question finishes on the next request even if the screen is closed. `Player#answer!`
+  refuses answers after the deadline (and finishes the question).
diff --git a/test/integration/timer_test.rb b/test/integration/timer_test.rb
new file mode 100644
index 0000000..c2d2a6c
--- /dev/null
+++ b/test/integration/timer_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class TimerTest < ActionDispatch::IntegrationTest
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    @quiz = Quiz.create!(title: "Timed", timer_minutes: 1, timer_seconds: 30)
+    @q1 = make_question("First?", [ [ "Right", true ], [ "Bad", false ] ])
+    @q2 = make_question("Second?", [ [ "Yes", true ], [ "No", false ] ])
+  end
+
+  def make_question(body, options)
+    q = @quiz.questions.new(body: body)
+    q.option_rows = options.map { |t, c| { title: t, correct: c } }
+    q.save!
+    q
+  end
+
+  def join(game, name)
+    post play_join_path(game.code), params: { name: name }
+    game.players.find_by!(name: name)
+  end
+
+  test "settings: defaults, saving, validation" do
+    quiz = Quiz.create!(title: "Plain")
+    assert_equal [ 0, 0 ], [ quiz.timer_minutes, quiz.timer_seconds ]
+    assert_not quiz.timer?
+
+    get edit_moderate_quiz_path(quiz), headers: moderator_headers
+    assert_select "label", "Timer minutes"
+    assert_select "label", "Timer seconds"
+    assert_select "input[type=number][name='quiz[timer_minutes]'][value='0']"
+    assert_select "input[type=number][name='quiz[timer_seconds]'][value='0']"
+
+    patch moderate_quiz_path(quiz), params: { quiz: { timer_minutes: "0", timer_seconds: "45" } }, headers: moderator_headers
+    assert_redirected_to moderate_quiz_path(quiz)
+    assert_equal 45, quiz.reload.timer_duration
+
+    patch moderate_quiz_path(quiz), params: { quiz: { timer_minutes: "", timer_seconds: "" } }, headers: moderator_headers
+    assert_equal 0, quiz.reload.timer_duration
+
+    patch moderate_quiz_path(quiz), params: { quiz: { timer_minutes: "-1", timer_seconds: "1.5" } }, headers: moderator_headers
+    assert_response :unprocessable_entity
+    assert_equal 0, quiz.reload.timer_duration
+  end
+
+  test "the countdown shows on the big screen only, survives reloads, and finishes at 0:00" do
+    game = @quiz.games.create!
+    player = join(game, "Ann")
+    travel_to Time.zone.local(2026, 10, 8, 12, 0, 0) do
+      assert game.start!
+      assert_equal Time.current + 90, game.question_deadline_at
+      get moderate_game_path(game), headers: moderator_headers
+      assert_select ".stage-timer[role=timer]", "1:30"
+      assert_select "form#finish_question_form button", "Finish"
+
+      get play_path(game.code)
+      assert_no_match(/stage-timer|1:30/, response.body)
+    end
+
+    travel_to Time.zone.local(2026, 10, 8, 12, 1, 25) do
+      get moderate_game_path(game), headers: moderator_headers
+      assert_select ".stage-timer", "0:05"
+      assert game.reload.question_open?
+    end
+
+    travel_to Time.zone.local(2026, 10, 8, 12, 1, 30, 1) do
+      # A late answer is refused, and the question finishes.
+      post play_answer_path(game.code), params: { question_id: @q1.id, option_id: @q1.options.first.id }
+      assert_equal 0, player.answers.count
+      assert game.reload.question_closed?
+    end
+  end
+
+  test "a phone ping finishes an expired question; Next restarts the timer" do
+    game = @quiz.games.create!
+    join(game, "Bob")
+    game.start!
+    travel 91.seconds do
+      v = game.reload.version
+      post play_ping_path(game.code)
+      assert game.reload.question_closed?
+      assert_equal v + 1, game.version
+      # Idempotent.
+      get ping_moderate_game_path(game), headers: moderator_headers
+      assert_equal v + 1, game.reload.version
+
+      assert game.advance!(@q1.id)
+      assert_in_delta Time.current + 90, game.question_deadline_at, 1
+    end
+  end
+
+  test "Finish before the end; no timer means no countdown" do
+    game = @quiz.games.create!
+    game.start!
+    post finish_moderate_game_path(game), params: { question_id: @q1.id }, headers: moderator_headers
+    assert game.reload.question_closed?
+    get moderate_game_path(game), headers: moderator_headers
+    assert_select ".stage-timer", 0
+
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    game = @quiz.games.create!
+    game.start!
+    assert_nil game.question_deadline_at
+    get moderate_game_path(game), headers: moderator_headers
+    assert_select ".stage-timer", 0
+    assert game.reload.question_open?
+  end
+
+  test "the timer is not exported" do
+    get moderate_quiz_export_path(@quiz), headers: moderator_headers
+    assert_no_match(/timer/i, response.body)
+  end
+end
