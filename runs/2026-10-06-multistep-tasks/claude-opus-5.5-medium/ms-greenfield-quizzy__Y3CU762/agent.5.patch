diff --git a/app/javascript/controllers/countdown_controller.js b/app/javascript/controllers/countdown_controller.js
new file mode 100644
index 0000000..f24ab1f
--- /dev/null
+++ b/app/javascript/controllers/countdown_controller.js
@@ -0,0 +1,66 @@
+import { Controller } from "@hotwired/stimulus"
+
+// The big screen's question timer (M:SS). The server renders the time left
+// (`remaining`, ms), computed from the game's stored deadline, so reloading
+// doesn't restart it and the browser's clock doesn't matter. At 0:00 it
+// submits the "Finish" form (`form` = its id), as if the moderator clicked it.
+// The server also finishes expired questions by itself on the next request
+// (see Game#finish_if_time_up!), so a lost submit is harmless.
+export default class extends Controller {
+  static values = { remaining: Number, form: String, key: String }
+
+  connect() {
+    this.start()
+  }
+
+  disconnect() {
+    this.stop()
+  }
+
+  // A morph refresh renders a fresh time left: resync.
+  remainingValueChanged() {
+    if (this.started) this.start()
+  }
+
+  start() {
+    this.stop()
+    this.started = true
+    this.endsAt = performance.now() + Math.max(this.remainingValue, 0)
+    this.tick()
+  }
+
+  stop() {
+    clearTimeout(this.timer)
+    clearTimeout(this.retry)
+  }
+
+  tick() {
+    const left = this.endsAt - performance.now()
+    this.render(left)
+    if (left <= 0) {
+      this.finish()
+    } else {
+      // Wake up right when the displayed second changes.
+      const untilNext = left % 1000 || 1000
+      this.timer = setTimeout(() => this.tick(), Math.min(untilNext + 5, 1000))
+    }
+  }
+
+  render(ms) {
+    const total = Math.max(Math.ceil(ms / 1000), 0)
+    const text = `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`
+    if (this.element.textContent !== text) this.element.textContent = text
+  }
+
+  finish() {
+    const form = this.formValue && document.getElementById(this.formValue)
+    if (form) {
+      if (form.requestSubmit) form.requestSubmit()
+      else form.submit()
+    } else if (window.Turbo?.session?.refresh) {
+      window.Turbo.session.refresh(document.baseURI)
+    }
+    // Still here after a while (offline, lost request)? Try again.
+    this.retry = setTimeout(() => { if (this.element.isConnected) this.finish() }, 3000)
+  }
+}
