+require "application_system_test_case"
+
+class TimerSystemTest < ApplicationSystemTestCase
+  setup do
+    @quiz = Quiz.create!(title: "Timed talk")
+    q = @quiz.questions.new(body: "Pick one?")
+    q.option_rows = [ { title: "Alpha", correct: true }, { title: "Beta", correct: false } ]
+    q.save!
+  end
+
+  test "the question finishes by itself at 0:00" do
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_on "Settings"
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+    fill_in "Timer seconds", with: "4"
+    click_on "Save quiz"
+    assert_text "Quiz saved"
+
+    click_on "Start a game"
+    url = find(".lobby__url").text.strip
+    using_session(:ann) do
+      visit url
+      fill_in "Your name", with: "Ann"
+      click_on "Join"
+      assert_text "Hi, Ann!"
+    end
+
+    click_on "Start"
+    assert_text "Pick one?"
+    assert_selector ".stage-timer", text: /\A0:0[34]\z/
+    using_session(:ann) do
+      assert_text "Pick one?"
+      assert_no_selector ".stage-timer"
+      assert_no_text(/\d:\d\d/)
+    end
+
+    sleep 1.2
+    visit current_url # reload: doesn't restart
+    assert_selector ".stage-timer", text: /\A0:0[123]\z/
+    assert_no_selector ".stage-timer", text: "0:04"
+
+    # At 0:00 the question finishes as if "Finish" was clicked.
+    assert_button "End quiz", wait: 8
+    assert_no_button "Finish"
+    assert_selector ".stage-option.is-correct", text: "Correct"
+    using_session(:ann) { assert_text "No answer" }
+  end
+end
