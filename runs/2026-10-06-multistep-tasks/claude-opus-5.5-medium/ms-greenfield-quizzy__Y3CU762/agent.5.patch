+  # Longest allowed time per question.
+  TIMER_MAX = 24.hours.to_i
+
   has_many :questions, -> { order(:position, :id) }, dependent: :destroy, inverse_of: :quiz
   has_many :games, dependent: :destroy
 
   normalizes :title, with: ->(title) { title.strip }
 
+  # Blank timer fields mean 0.
+  before_validation do
+    self.timer_minutes = 0 if timer_minutes_before_type_cast.to_s.strip.empty?
+    self.timer_seconds = 0 if timer_seconds_before_type_cast.to_s.strip.empty?
+  end
