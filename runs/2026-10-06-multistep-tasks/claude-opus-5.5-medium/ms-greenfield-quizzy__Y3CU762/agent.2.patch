@@ -0,0 +1,27 @@
+<% content_for :title, "Import quiz" %>
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head"><h1>Import quiz</h1></div>
+<div class="card">
+  <%= form_with scope: :quiz_import, url: moderate_quiz_import_path do |f| %>
+    <% if @errors.any? %>
+      <div class="errors" role="alert">
+        <% if @errors.size == 1 %>
+          <%= @errors.first %>
+        <% else %>
+          <ul>
+            <% @errors.each do |message| %><li><%= message %></li><% end %>
+          </ul>
+        <% end %>
+      </div>
+    <% end %>
+    <div class="field">
+      <%= f.label :json, "Quiz JSON" %>
+      <%= f.text_area :json, value: @json, class: "input input--code", rows: 16, autofocus: true, spellcheck: false %>
+      <span class="field-hint">Paste the JSON from “Export”. Importing always creates a new quiz.</span>
+    </div>
+    <div class="buttons">
+      <%= f.submit "Import", class: "btn btn--pink" %>
+      <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+    </div>
+  <% end %>
+</div>
