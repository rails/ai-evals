+
+  # "Draw": everyone above the N-th place's points wins; the remaining prizes
+  # are drawn among the players with exactly that many points (speed ignored).
+  def draw_winners!(random: SecureRandom)
+    change_winners do |eligible, n|
+      next eligible if eligible.size <= n
+      cutoff = eligible[n - 1].points
+      above = eligible.select { |s| s.points > cutoff }
+      tied = eligible.select { |s| s.points == cutoff }
+      above + tied.sample(n - above.size, random: random)
+    end
+  end
