diff --git a/test/models/game_prizes_test.rb b/test/models/game_prizes_test.rb
new file mode 100644
index 0000000..02b292a
--- /dev/null
+++ b/test/models/game_prizes_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class GamePrizesTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Prizes", winners_count: 2)
+    @questions = 3.times.map do |i|
+      q = @quiz.questions.new(body: "Q#{i}?")
+      q.option_rows = [ { title: "right", correct: true }, { title: "wrong", correct: false } ]
+      q.save!
+      q
+    end
+    @game = @quiz.games.create!
+  end
+
+  def player(name) = @game.players.create!(name: name, last_seen_at: Time.current)
+
+  def right(q) = q.options.find_by!(title: "right")
+  def wrong(q) = q.options.find_by!(title: "wrong")
+
+  # Plays the whole game: picks = { player => [[question_index, :right/:wrong, seconds], ...] }
+  def play(picks)
+    @game.start!
+    @questions.each_with_index do |q, index|
+      opened = @game.reload.question_opened_at
+      picks.each do |p, list|
+        list.select { |i, _, _| i == index }.each do |_, kind, seconds|
+          assert p.answer!(question_id: q.id, option_id: send(kind, q).id, at: opened + seconds)
+        end
+      end
+      @game.finish_question!(q.id)
+      @game.advance!(q.id)
+    end
+    assert @game.reload.finished?
+  end
+
+  def names(standings) = standings.map { |s| s.player.name }
+  def winner_names = @game.reload.leaderboard.select(&:winner?).map { |s| s.player.name }
+
+  test "winners count setting" do
+    assert_equal 3, Quiz.new.winners_count
+    assert_not Quiz.new(title: "x", winners_count: 0).valid?
+    assert_not Quiz.new(title: "x", winners_count: 1.5).valid?
+    assert Quiz.new(title: "x", winners_count: 1).valid?
+  end
+
+  test "points, then the time of the correct answers, decide the order" do
+    a, b, c, d = %w[Ann Bob Cid Dan].map { player(_1) }
+    play(
+      a => [ [ 0, :right, 5 ], [ 1, :right, 5 ] ],            # 2 points, 10 s
+      b => [ [ 0, :right, 1 ], [ 1, :right, 2 ], [ 2, :wrong, 0.1 ] ], # 2 points, 3 s (wrong one doesn't count)
+      c => [ [ 0, :right, 0.5 ] ],                          # 1 point
+      d => [ [ 2, :wrong, 1 ] ]                             # 0 points
+    )
+    board = @game.leaderboard
+    assert_equal %w[Bob Ann Cid Dan], names(board)
+    assert_equal [ 1, 2, 3, 4 ], board.map(&:place)
+    assert_equal [ 2, 2, 1, 0 ], board.map(&:points)
+    assert_in_delta 3.0, board.first.time_seconds, 0.001
+  end
+
+  test "the last pick counts for the time" do
+    a, b = player("Ann"), player("Bob")
+    @game.start!
+    q = @questions.first
+    t = @game.reload.question_opened_at
+    a.answer!(question_id: q.id, option_id: right(q).id, at: t + 1)
+    b.answer!(question_id: q.id, option_id: wrong(q).id, at: t + 1)
+    b.answer!(question_id: q.id, option_id: right(q).id, at: t + 2)
+    a.answer!(question_id: q.id, option_id: right(q).id, at: t + 3) # re-pick: later
+    assert_equal 3_000_000, a.answers.sole.elapsed_us
+    assert_equal 2_000_000, b.answers.sole.elapsed_us
+  end
+
+  test "top N, never 0 points, reset" do
+    a, b, c, d = %w[Ann Bob Cid Dan].map { player(_1) }
+    play(a => [ [ 0, :right, 1 ], [ 1, :right, 1 ] ], b => [ [ 0, :right, 1 ] ], c => [ [ 0, :right, 2 ] ], d => [])
+    assert @game.pick_top_winners!
+    assert_equal %w[Ann Bob], winner_names
+    assert @game.winner?(a)
+    assert_not @game.winner?(c)
+
+    @quiz.update!(winners_count: 10)
+    @game.reload.pick_top_winners!
+    assert_equal %w[Ann Bob Cid], winner_names, "0 points never win"
+
+    assert @game.reset_winners!
+    assert_empty winner_names
+  end
+
+  test "draw: above the N-th place's points win, the rest are drawn among exact ties" do
+    @quiz.update!(winners_count: 3)
+    a, b, c, d, e = %w[Ann Bob Cid Dan Eve].map { player(_1) }
+    play(
+      a => [ [ 0, :right, 1 ], [ 1, :right, 1 ] ],  # 2 points: always wins
+      b => [ [ 0, :right, 1 ] ],                  # 1 point, fastest
+      c => [ [ 0, :right, 2 ] ],                  # 1 point
+      d => [ [ 0, :right, 3 ] ],                  # 1 point
+      e => []                                      # 0 points
+    )
+    seen = Set.new
+    40.times do
+      assert @game.reload.draw_winners!
+      winners = winner_names
+      assert_equal 3, winners.size
+      assert_includes winners, "Ann"
+      assert_not_includes winners, "Eve"
+      seen << winners.sort
+    end
+    assert seen.size > 1, "draws differ (#{seen.to_a})"
+    assert seen.all? { |w| (w - %w[Ann Bob Cid Dan]).empty? }
+  end
+
+  test "draw with fewer players with points than N gives them all" do
+    a, b, c = %w[Ann Bob Cid].map { player(_1) }
+    @quiz.update!(winners_count: 3)
+    play(a => [ [ 0, :right, 1 ] ], b => [ [ 1, :right, 1 ] ], c => [])
+    @game.draw_winners!
+    assert_equal %w[Ann Bob].sort, winner_names.sort
+  end
+
+  test "winners only after the end" do
+    player("Ann")
+    @game.start!
+    assert_not @game.pick_top_winners!
+    assert_not @game.draw_winners!
+    assert_not @game.reset_winners!
+  end
+end
diff --git a/test/system/prizes_test.rb b/test/system/prizes_test.rb
new file mode 100644
index 0000000..b3741a8
--- /dev/null
+++ b/test/system/prizes_test.rb
@@ -0,0 +1,95 @@
+require "application_system_test_case"
+
+class PrizesTest < ApplicationSystemTestCase
+  setup do
+    @quiz = Quiz.create!(title: "Prize Quiz")
+    [ [ "One?", "A1", "B1" ], [ "Two?", "A2", "B2" ] ].each do |body, right, wrong|
+      q = @quiz.questions.new(body: body)
+      q.option_rows = [ { title: right, correct: true }, { title: wrong, correct: false } ]
+      q.save!
+    end
+  end
+
+  def join_as(name, url)
+    visit url
+    fill_in "Your name", with: name
+    click_on "Join"
+    assert_text "Hi, #{name}!"
+  end
+
+  test "number of winners setting" do
+    visit "/moderate/quizzes/#{@quiz.id}/edit"
+    assert_field "Number of winners", with: "3"
+    fill_in "Number of winners", with: "2"
+    click_on "Save quiz"
+    assert_text "Quiz saved"
+    assert_equal 2, @quiz.reload.winners_count
+
+    visit "/moderate/quizzes/new"
+    assert_field "Number of winners", with: "3"
+  end
+
+  test "leaderboard, places and winners, live" do
+    @quiz.update!(winners_count: 2)
+    visit "/moderate/quizzes/#{@quiz.id}"
+    click_on "Start a game"
+    url = find(".lobby__url").text.strip
+    %w[Ann Bob Cid Dan].each { |n| using_session(n) { join_as(n, url) } }
+    assert_text "Players: 4"
+
+    click_on "Start"
+    # Ann: 2 points; Bob and Cid: 1 point (Bob faster); Dan: 0 points
+    using_session("Ann") { click_on "A1" ; assert_text "Your answer" }
+    using_session("Bob") { click_on "A1" ; assert_text "Your answer" }
+    sleep 0.3
+    using_session("Cid") { click_on "A1" ; assert_text "Your answer" }
+    using_session("Dan") { click_on "B1" ; assert_text "Your answer" }
+    assert_text "Answers: 4 / 4"
+    using_session("Ann") { assert_no_text "point" }
+    click_on "Finish"
+    click_on "Next"
+    using_session("Ann") { assert_text "Two?"; click_on "A2"; assert_text "Your answer" }
+    using_session("Bob") { assert_text "Two?"; click_on "B2"; assert_text "Your answer" }
+    assert_text "Answers: 2 / 4"
+    click_on "Finish"
+    using_session("Ann") { assert_text "Correct!"; assert_no_text "point" }
+    click_on "End quiz"
+
+    within("ol.leaderboard") do
+      items = all("li", count: 4)
+      assert_equal [ "1 Ann 2 points", "2 Bob 1 point", "3 Cid 1 point", "4 Dan 0 points" ], items.map { |li| li.text.squish }
+    end
+    using_session("Ann") { assert_text "Place 1 of 4"; assert_text "2 points"; assert_no_text "You won!" }
+    using_session("Cid") { assert_text "Place 3 of 4"; assert_text "1 point" }
+    using_session("Dan") { assert_text "Place 4 of 4"; assert_text "0 points" }
+
+    click_on "Top 2"
+    assert_selector "li", text: "Ann", count: 1
+    within(find("li", text: "Ann")) { assert_text "Winner" }
+    within(find("li", text: "Bob")) { assert_text "Winner" }
+    within(find("li", text: "Cid")) { assert_no_text "Winner" }
+    using_session("Ann") { assert_text "You won!" }
+    using_session("Bob") { assert_text "You won!" }
+    using_session("Cid") { assert_no_text "You won!" }
+
+    click_on "Reset winners"
+    assert_no_text "Winner"
+    using_session("Ann") { assert_no_text "You won!" }
+
+    # Draw: Ann always wins; Bob or Cid is drawn; Dan never.
+    drawn = Set.new
+    8.times do
+      click_on "Draw"
+      assert_selector "li", text: "Winner", count: 2
+      within(find("li", text: "Ann")) { assert_text "Winner" }
+      within(find("li", text: "Dan")) { assert_no_text "Winner" }
+      drawn << (find("li", text: "Bob").has_text?("Winner") ? "Bob" : "Cid")
+    end
+    assert_equal %w[Bob Cid].to_set, drawn
+    winner = find("li", text: "Bob").has_text?("Winner") ? "Bob" : "Cid"
+    loser = winner == "Bob" ? "Cid" : "Bob"
+    using_session(winner) { assert_text "You won!" }
+    using_session(loser) { assert_no_text "You won!" }
+    using_session("Dan") { assert_no_text "You won!" }
+  end
+end
