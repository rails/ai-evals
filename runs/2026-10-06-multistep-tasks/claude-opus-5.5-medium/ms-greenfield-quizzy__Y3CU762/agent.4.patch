+    <h1 class="leaderboard-layout__title">The quiz is over</h1>
+    <p class="lobby__join mt-2">
+      <% if game.winner_ids.any? %>
+        Congratulations to our <%= game.winner_ids.size == 1 ? "winner" : "winners" %>!
+      <% else %>
+        Thanks for playing!
+      <% end %>
+    </p>
+  </div>
+  <% if standings.any? %>
+    <ol class="leaderboard" aria-label="Leaderboard">
+      <% standings.each do |standing| %>
+        <li class="leader<%= " is-winner" if standing.winner? %>" id="<%= dom_id(standing.player, :standing) %>"
+            title="<%= "Correct answers in #{format("%.1f", standing.time_seconds)} s" if standing.points.positive? %>">
+          <span class="leader__place"><%= standing.place %></span>
+          <span class="leader__name"><%= standing.player.name %><% if standing.winner? %> <span class="leader__badge">Winner</span><% end %></span>
+          <span class="leader__score"><%= pluralize(standing.points, "point") %></span>
+        </li>
+      <% end %>
+    </ol>
+  <% else %>
+    <p class="lobby__join">Nobody played this time.</p>
+  <% end %>
+</div>
