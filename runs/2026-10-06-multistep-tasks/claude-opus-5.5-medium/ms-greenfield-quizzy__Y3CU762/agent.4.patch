+++ b/app/views/plays/_stage.html.erb
@@ -0,0 +1,37 @@
+<%# The player's view of the game state. Replaced as a whole by the stream when a
+    question opens (rendered once for everyone then: player is nil). The token tells
+    the live controller which state this markup shows. %>
+<% question = game.current_question %>
+<% state = game.finished? ? "finished" : (game.lobby? || question.nil?) ? "lobby" : "question" %>
+<div id="play_stage" class="play__stage play__stage--<%= state %>" data-live-token="<%= game.player_token %>">
+  <% if state == "finished" %>
+    <% standing = player && game.standing_for(player) %>
+    <div class="play__body">
+      <div class="result-card">
+        <h1 class="play-title">The quiz is over</h1>
+        <% if standing %>
+          <div class="result-card__place" aria-hidden="true"><%= standing.place %></div>
+          <p class="result-card__label">Place <%= standing.place %> of <%= game.leaderboard.size %></p>
+          <p class="result-card__score"><%= pluralize(standing.points, "point") %></p>
+          <% if standing.winner? %>
+            <div class="winner-banner" role="status">You won!<small>Come and collect your prize.</small></div>
+          <% else %>
+            <p class="play-lead mt-2">Thanks for playing!</p>
+          <% end %>
+        <% else %>
+          <p class="play-lead">Thanks for coming!</p>
+        <% end %>
+      </div>
+    </div>
+  <% elsif state == "lobby" %>
+    <div class="play__body">
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1 class="play-title">Hi, <%= player&.name %>!</h1>
+        <p class="play-lead">You're in. The quiz starts soon: keep an eye on the big screen.</p>
+      </div>
+    </div>
+  <% else %>
+    <%= render "plays/question", game: game, question: question, player: player %>
+  <% end %>
+</div>
