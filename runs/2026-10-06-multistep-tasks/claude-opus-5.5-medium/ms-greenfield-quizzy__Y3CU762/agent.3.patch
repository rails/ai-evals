@@ -0,0 +1,51 @@
+<% content_for :title, "Game #{@game.code} · #{@game.quiz.title}" %>
+<% question = @game.current_question %>
+<%= turbo_stream_from(*@game.screen_stream) %>
+<div data-controller="live"
+     data-live-url-value="<%= ping_moderate_game_path(@game) %>"
+     data-live-method-value="GET"
+     data-live-token-value="<%= @game.screen_token %>"
+     data-live-interval-value="2000">
+  <section class="cover <%= @game.question_phase? ? "cover--night" : "cover--blue" %> <%= "cover--calm" if @game.question_phase? %>">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <span><%= @game.quiz.title unless @game.lobby? %></span>
+      </div>
+
+      <div class="screen__body">
+        <% if @game.lobby? %>
+          <%= render "lobby", game: @game %>
+        <% elsif @game.finished? %>
+          <div class="screen__kicker"><%= @game.quiz.title %></div>
+          <h1 class="lobby__title">The quiz is over</h1>
+          <p class="lobby__join">Thanks for playing!</p>
+        <% elsif question %>
+          <%= render "question", game: @game, question: question %>
+        <% end %>
+      </div>
+    </div>
+  </section>
+
+  <nav class="screen-controls" aria-label="Game controls">
+    <div class="screen-controls__info">
+      <%= link_to "← #{@game.quiz.title}", moderate_quiz_path(@game.quiz) %>
+      <span>Game <strong><%= @game.code %></strong></span>
+    </div>
+    <div class="buttons">
+      <% if @game.lobby? %>
+        <% if @game.questions.any? %>
+          <%= button_to "Start", start_moderate_game_path(@game), class: "btn btn--pink btn--lg" %>
+        <% else %>
+          <span>Activate at least one question to start.</span>
+          <button type="button" class="btn btn--pink btn--lg" disabled>Start</button>
+        <% end %>
+      <% elsif @game.question_open? && question %>
+        <%= button_to "Finish", finish_moderate_game_path(@game), params: { question_id: question.id }, class: "btn btn--pink btn--lg" %>
+      <% elsif @game.question_closed? && question %>
+        <%= button_to (@game.last_question? ? "End quiz" : "Next"), next_moderate_game_path(@game),
+              params: { question_id: question.id }, class: "btn btn--pink btn--lg" %>
+      <% end %>
+    </div>
+  </nav>
+</div>
