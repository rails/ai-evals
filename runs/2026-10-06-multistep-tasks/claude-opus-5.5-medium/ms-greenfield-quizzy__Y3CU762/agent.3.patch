new file mode 100644
index 0000000..b79adb8
--- /dev/null
+++ b/app/views/plays/show.html.erb
@@ -0,0 +1,42 @@
+<% content_for :title, @game.quiz.title %>
+<% question = @game.current_question %>
+<%= turbo_stream_from(*@game.players_stream) unless @game.finished? %>
+<div class="play__live"
+     <% unless @game.finished? %>
+       data-controller="live"
+       data-live-url-value="<%= play_ping_path(@game.code) %>"
+       data-live-token-value="<%= view_token %>"
+       data-live-interval-value="3000"
+       <% if @player %>data-live-leave-url-value="<%= play_leave_path(@game.code) %>"<% end %>
+     <% end %>>
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <% if @player && !(@game.lobby? || question.nil?) && !@game.finished? %><span class="play__hi">Hi, <%= @player.name %>!</span><% end %>
+  </div>
+
+  <% if @game.finished? %>
+    <div class="play__body">
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">★</div>
+        <h1 class="play-title">The quiz is over</h1>
+        <% if @player %>
+          <p class="play-lead">You got <%= @player.score %> of <%= pluralize(@game.questions.size, "question") %> right. Thanks for playing!</p>
+        <% else %>
+          <p class="play-lead">Thanks for coming!</p>
+        <% end %>
+      </div>
+    </div>
+  <% elsif @player.nil? %>
+    <%= render "join", game: @game, player: @join_player %>
+  <% elsif @game.lobby? || question.nil? %>
+    <div class="play__body">
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+        <p class="play-lead">You're in. The quiz starts soon: keep an eye on the big screen.</p>
+      </div>
+    </div>
+  <% else %>
+    <%= render "question", game: @game, question: question, player: @player %>
+  <% end %>
+</div>
