diff --git a/app/views/plays/_question.html.erb b/app/views/plays/_question.html.erb
new file mode 100644
index 0000000..4693646
--- /dev/null
+++ b/app/views/plays/_question.html.erb
@@ -0,0 +1,52 @@
+<% answer = player.answer_for(question) %>
+<div class="play__body play__body--top">
+  <div class="play-question__num">Question <%= game.current_number %> of <%= game.questions.size %></div>
+  <div class="play-question__body"><%= question.body %></div>
+
+  <% if game.question_open? %>
+    <%# Nothing about correctness is rendered while the question is open. %>
+    <div class="play-options" data-controller="answer">
+      <% question.options.each do |option| %>
+        <% picked = answer&.option_id == option.id %>
+        <%= form_with url: play_answer_path(game.code), data: { action: "turbo:submit-start->answer#sent turbo:submit-end->answer#done" } do %>
+          <%= hidden_field_tag :question_id, question.id, id: nil %>
+          <%= hidden_field_tag :seq, 0, id: nil, data: { answer_target: "seq" } %>
+          <button type="submit" name="option_id" value="<%= option.id %>"
+                  class="play-option<%= " is-picked" if picked %>" aria-pressed="<%= picked %>"
+                  data-answer-target="option" data-action="click->answer#pick">
+            <span class="play-option__letter" aria-hidden="true"><%= option.letter %></span>
+            <span class="play-option__title"><%= option.title %></span>
+            <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+          </button>
+        <% end %>
+      <% end %>
+    </div>
+    <div class="play-status play-status--neutral" role="status" data-answer-target="status">
+      <%= answer ? "You can change your answer until the question closes" : "Pick an answer" %>
+    </div>
+  <% else %>
+    <% correct = answer && question.correct_option?(answer.option_id) %>
+    <div class="play-options is-locked is-revealed">
+      <% question.options.each do |option| %>
+        <% picked = answer&.option_id == option.id %>
+        <div class="play-option<%= " is-correct" if option.correct? %><%= " is-picked" if picked %>">
+          <span class="play-option__letter" aria-hidden="true"><%= option.letter %></span>
+          <span class="play-option__title"><%= option.title %></span>
+          <% if picked %>
+            <span class="play-option__mark">Your answer</span>
+          <% elsif option.correct? %>
+            <span class="play-option__mark">✓ Right answer</span>
+          <% end %>
+        </div>
+      <% end %>
+    </div>
+    <% if answer.nil? %>
+      <div class="play-status play-status--neutral" role="status">No answer</div>
+    <% elsif correct %>
+      <div class="play-status play-status--right" role="status">Correct!</div>
+    <% else %>
+      <div class="play-status play-status--wrong" role="status">Wrong!</div>
+    <% end %>
+    <p class="play-lead mt-2"><%= game.last_question? ? "That was the last question." : "Wait for the next question." %></p>
+  <% end %>
+</div>
