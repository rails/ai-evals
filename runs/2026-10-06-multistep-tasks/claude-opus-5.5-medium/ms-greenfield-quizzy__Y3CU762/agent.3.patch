diff --git a/app/views/moderate/games/_question.html.erb b/app/views/moderate/games/_question.html.erb
new file mode 100644
index 0000000..437bd88
--- /dev/null
+++ b/app/views/moderate/games/_question.html.erb
@@ -0,0 +1,30 @@
+<div class="stage-question__num">Question <%= game.current_number %> of <%= game.questions.size %></div>
+<div class="stage-question__body"><%= question.body %></div>
+
+<% if game.question_closed? %>
+  <% counts = game.option_counts_for(question) %>
+  <% total = counts.values.sum %>
+  <ol class="stage-options stage-options--results">
+    <% question.options.each do |option| %>
+      <% count = counts[option.id].to_i %>
+      <li class="stage-option<%= " is-correct" if option.correct? %>">
+        <span class="stage-option__bar" style="--share: <%= total.zero? ? 0 : (100.0 * count / total).round(1) %>%"></span>
+        <span class="stage-option__letter" aria-hidden="true"><%= option.letter %></span>
+        <span class="stage-option__title"><%= option.title %></span>
+        <% if option.correct? %><span class="stage-option__mark">Correct</span><% end %>
+        <span class="stage-option__count"><%= count %></span>
+      </li>
+    <% end %>
+  </ol>
+<% else %>
+  <ol class="stage-options">
+    <% question.options.each do |option| %>
+      <li class="stage-option">
+        <span class="stage-option__letter" aria-hidden="true"><%= option.letter %></span>
+        <span class="stage-option__title"><%= option.title %></span>
+      </li>
+    <% end %>
+  </ol>
+<% end %>
+
+<div class="answers-counter mt-2" id="game_counter" aria-live="polite"><%= render "moderate/games/counter", game: game %></div>
diff --git a/app/views/moderate/games/show.html.erb b/app/views/moderate/games/show.html.erb
