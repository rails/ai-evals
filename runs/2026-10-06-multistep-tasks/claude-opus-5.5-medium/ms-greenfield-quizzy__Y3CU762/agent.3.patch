diff --git a/app/javascript/controllers/answer_controller.js b/app/javascript/controllers/answer_controller.js
new file mode 100644
index 0000000..4e85cef
--- /dev/null
+++ b/app/javascript/controllers/answer_controller.js
@@ -0,0 +1,61 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Player's option buttons: a tap submits at once (plain Turbo form), and we
+// mark the option as "Your answer" right away so slow Wi-Fi doesn't feel
+// broken. Each submission carries `seq` (client time) so the server ignores
+// an older tap that arrives after a newer one. If the request fails, the
+// mark goes back to what the server knows and the player is asked to retry.
+export default class extends Controller {
+  static targets = ["option", "seq", "status"]
+
+  connect() {
+    this.confirmed = this.optionTargets.find((o) => o.classList.contains("is-picked")) || null
+    this.latestSeq = 0
+  }
+
+  pick(event) {
+    const button = event.currentTarget
+    const seq = Math.max(Date.now(), this.latestSeq + 1)
+    this.latestSeq = seq
+    const input = button.form.querySelector("[data-answer-target='seq']")
+    if (input) input.value = seq
+    this.mark(button)
+    this.setStatus("Sending your answer…")
+  }
+
+  sent() {}
+
+  done(event) {
+    const form = event.target
+    const seq = Number(form.querySelector("[data-answer-target='seq']")?.value || 0)
+    if (seq !== this.latestSeq) return // superseded by a newer tap
+    if (event.detail?.success) {
+      this.confirmed = form.querySelector("[data-answer-target='option']")
+      this.setStatus("You can change your answer until the question closes")
+    } else {
+      this.mark(this.confirmed)
+      this.setStatus("Couldn't send your answer. Tap again.")
+    }
+  }
+
+  mark(button) {
+    this.optionTargets.forEach((option) => {
+      const picked = option === button
+      option.classList.toggle("is-picked", picked)
+      option.setAttribute("aria-pressed", picked)
+      let mark = option.querySelector(".play-option__mark")
+      if (picked && !mark) {
+        mark = document.createElement("span")
+        mark.className = "play-option__mark"
+        mark.textContent = "Your answer"
+        option.appendChild(mark)
+      } else if (!picked && mark) {
+        mark.remove()
+      }
+    })
+  }
+
+  setStatus(text) {
+    if (this.hasStatusTarget) this.statusTarget.textContent = text
+  }
+}
diff --git a/app/javascript/controllers/live_controller.js b/app/javascript/controllers/live_controller.js
new file mode 100644
index 0000000..81c5cf3
--- /dev/null
+++ b/app/javascript/controllers/live_controller.js
@@ -0,0 +1,100 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Keeps a page in sync with the game.
+//
+// The main channel is the Turbo Stream (Action Cable) on the page, which
+// pushes refreshes and counter updates. Conference Wi-Fi drops WebSockets
+// all the time, so this controller also polls `url` every `interval` ms:
+// the server answers with a token describing the state the page depends on,
+// and if it differs from `token` (rendered with the page) we morph-refresh.
+// The poll doubles as the player's heartbeat ("present" players), and
+// `leaveUrl` gets a beacon when the page goes away.
+export default class extends Controller {
+  static values = {
+    url: String,
+    token: String,
+    method: { type: String, default: "POST" },
+    interval: { type: Number, default: 3000 },
+    leaveUrl: String
+  }
+
+  connect() {
+    this.wake = this.wake.bind(this)
+    this.leave = this.leave.bind(this)
+    document.addEventListener("visibilitychange", this.wake)
+    window.addEventListener("online", this.wake)
+    window.addEventListener("pageshow", this.wake)
+    window.addEventListener("pagehide", this.leave)
+
+    // When the stream (re)connects we may have missed broadcasts: check now.
+    this.observer = new MutationObserver((mutations) => {
+      if (mutations.some((m) => m.target.hasAttribute?.("connected"))) this.poll()
+    })
+    this.observer.observe(document.body, { attributes: true, attributeFilter: ["connected"], subtree: true })
+
+    this.schedule()
+  }
+
+  disconnect() {
+    clearTimeout(this.timer)
+    this.observer?.disconnect()
+    document.removeEventListener("visibilitychange", this.wake)
+    window.removeEventListener("online", this.wake)
+    window.removeEventListener("pageshow", this.wake)
+    window.removeEventListener("pagehide", this.leave)
+  }
+
+  tokenValueChanged() {
+    this.refreshing = false
+  }
+
+  wake() {
+    if (document.visibilityState !== "hidden") this.poll()
+  }
+
+  leave() {
+    if (this.hasLeaveUrlValue && this.leaveUrlValue && navigator.sendBeacon) {
+      navigator.sendBeacon(this.leaveUrlValue)
+    }
+  }
+
+  schedule() {
+    clearTimeout(this.timer)
+    this.timer = setTimeout(() => this.poll(), this.intervalValue)
+  }
+
+  async poll() {
+    if (this.polling) return
+    this.polling = true
+    clearTimeout(this.timer)
+    try {
+      const response = await fetch(this.urlValue, {
+        method: this.methodValue,
+        headers: { Accept: "application/json" },
+        credentials: "same-origin",
+        cache: "no-store",
+        signal: AbortSignal.timeout ? AbortSignal.timeout(10000) : undefined
+      })
+      if (response.ok) {
+        const { token } = await response.json()
+        if (token !== this.tokenValue) this.refresh()
+      } else if (response.status === 404) {
+        window.location.reload()
+      }
+    } catch (_error) {
+      // Offline or timed out: try again on the next tick.
+    } finally {
+      this.polling = false
+      if (this.element.isConnected) this.schedule()
+    }
+  }
+
+  refresh() {
+    const turbo = window.Turbo
+    if (turbo?.session?.refresh) {
+      turbo.session.refresh(document.baseURI)
+    } else {
+      window.location.reload()
+    }
+  }
+}
