new file mode 100644
index 0000000..149ab47
--- /dev/null
+++ b/Gemfile.next
@@ -0,0 +1,11 @@
+# frozen_string_literal: true
+
+# Rails 7.0 dual-boot bundle. It shares every dependency with ./Gemfile and
+# only swaps the Rails version (and Rails-version-bound adapters):
+#
+#   BUNDLE_GEMFILE=Gemfile.next bundle install
+#   BUNDLE_GEMFILE=Gemfile.next bin/rails test
+#
+# See docs/UPGRADE.md.
+@rails_next = true
+eval_gemfile File.expand_path('Gemfile', __dir__)
