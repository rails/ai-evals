+    data, iv, auth_tag = cookie.split("--").map {|v| Base64.strict_decode64(v)}
+    cipher = OpenSSL::Cipher.new("aes-256-gcm").decrypt
+    cipher.key = derive("authenticated encrypted cookie", 32, OpenSSL::Digest::SHA256)
+    cipher.iv = iv
