@@ -40,4 +40,74 @@ class MailLinksControllerTest < Redmine::ControllerTest
     assert_response :not_found
     assert Issue.find(2).watched_by?(User.find(3))
   end
+
+  # Links mailed by the previous releases were signed by
+  # Rails.application.message_verifier(:mail_links) on Rails 6.1, ie. with a
+  # key derived with PBKDF2-SHA1. They must keep working whatever the
+  # framework defaults (Rails 7.0 derives keys with SHA256).
+  # Builds the token exactly as Rails 6.1/7.0 MessageVerifier did (Marshal
+  # payload, legacy JSON metadata envelope, HMAC-SHA1), independently of the
+  # framework version and defaults the tests run with.
+  def legacy_mail_link_token(secret, data, purpose, expires_at = 30.days.from_now)
+    key = OpenSSL::PKCS5.pbkdf2_hmac_sha1(secret, "mail_links", 1000, 64)
+    envelope = {"_rails" => {"message" => Base64.strict_encode64(Marshal.dump(data)),
+                             "exp" => expires_at.utc.iso8601(3), "pur" => purpose.to_s}}
+    payload = Base64.strict_encode64(ActiveSupport::JSON.encode(envelope))
+    "#{payload}--#{OpenSSL::HMAC.hexdigest('SHA1', key, payload)}"
+  end
+
+  def test_unwatch_with_a_token_signed_by_the_rails_6_1_message_verifier
+    token = legacy_mail_link_token(Rails.application.secret_key_base, {"user_id" => 3, "issue_id" => 2}, :unwatch)
+
+    get :unwatch, :params => {:token => token}
+
+    assert_response :success
+    assert_not Issue.find(2).watched_by?(User.find(3))
+  end
+
+  def test_unwatch_with_a_token_signed_with_a_sha256_derived_key
+    key = OpenSSL::PKCS5.pbkdf2_hmac(Rails.application.secret_key_base, "mail_links", 1000, 64, OpenSSL::Digest.new('SHA256'))
+    token = ActiveSupport::MessageVerifier.new(key, :digest => "SHA1", :serializer => Marshal).
+      generate({"user_id" => 3, "issue_id" => 2}, :purpose => :unwatch, :expires_in => 30.days)
+
+    get :unwatch, :params => {:token => token}
+
+    assert_response :success
+    assert_not Issue.find(2).watched_by?(User.find(3))
+  end
+
+  def test_unwatch_with_a_token_signed_with_another_secret_is_not_found
+    token = legacy_mail_link_token("another secret", {"user_id" => 3, "issue_id" => 2}, :unwatch)
+
+    get :unwatch, :params => {:token => token}
+
+    assert_response :not_found
+    assert Issue.find(2).watched_by?(User.find(3))
+  end
+
+  def test_unwatch_with_an_expired_legacy_token_is_not_found
+    token = legacy_mail_link_token(Rails.application.secret_key_base, {"user_id" => 3, "issue_id" => 2},
+                                   :unwatch, 1.minute.ago)
+
+    get :unwatch, :params => {:token => token}
+
+    assert_response :not_found
+    assert Issue.find(2).watched_by?(User.find(3))
+  end
+
+  # Every release (Rails 6.1, 7.0 and 7.2 on its 7.1+ defaults, where
+  # use_message_serializer_for_metadata is on) must write tokens that the
+  # previous releases verify: SHA1-derived key, HMAC-SHA1, Marshal payload in
+  # the legacy JSON metadata envelope.
+  def test_mail_link_token_is_readable_by_previous_releases
+    token = Mailer.mail_link_token(:unwatch, {"user_id" => 3, "issue_id" => 2})
+    payload, digest = token.split("--")
+    key = OpenSSL::PKCS5.pbkdf2_hmac_sha1(Rails.application.secret_key_base, "mail_links", 1000, 64)
+    assert_equal OpenSSL::HMAC.hexdigest('SHA1', key, payload), digest
+
+    envelope = JSON.parse(Base64.strict_decode64(payload))
+    assert_equal "unwatch", envelope["_rails"]["pur"]
+    assert_equal({"user_id" => 3, "issue_id" => 2}, Marshal.load(Base64.strict_decode64(envelope["_rails"]["message"]))) # rubocop:disable Security/MarshalLoad
+    assert_in_delta 30.days.from_now, Time.iso8601(envelope["_rails"]["exp"]), 1.minute
+  end
 end
