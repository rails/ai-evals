new file mode 100644
index 0000000..0f5ab8e
--- /dev/null
+++ b/test/unit/lib/redmine/secret_key_base_test.rb
@@ -0,0 +1,154 @@
+# frozen_string_literal: true
+
+# Redmine - project management software
+# Copyright (C) 2006-  Jean-Philippe Lang
+#
