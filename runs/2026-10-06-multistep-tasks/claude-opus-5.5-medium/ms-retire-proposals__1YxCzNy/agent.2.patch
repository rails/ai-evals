+
+# Deletes the map locations of citizen proposals and the `proposal_id`
+# column, dumping them first. See docs/REMOVAL.md.
+class RemoveProposalIdFromMapLocations < ActiveRecord::Migration[8.0]
+  include RemovedData::Migration
+
+  def up
+    set_lock_timeout
+    execute "LOCK TABLE map_locations IN ACCESS EXCLUSIVE MODE"
+
+    delete_rows "map_locations", "proposal_id IS NOT NULL AND investment_id IS NULL"
+    # Rows of investments which also had a proposal (there shouldn't be any)
+    dump_rows "map_locations_proposal_id",
