+  end
+
+  def down
+    add_column :map_locations, :proposal_id, :integer
+    add_index :map_locations, :proposal_id, name: "index_map_locations_on_proposal_id"
+
+    restore_columns "map_locations", name: "map_locations_proposal_id"
+    restore_rows "map_locations"
+  end
+end
