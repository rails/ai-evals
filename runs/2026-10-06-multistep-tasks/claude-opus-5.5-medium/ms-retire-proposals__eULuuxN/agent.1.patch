-def sentences_embeddings(sents):
-    sent_embs = []
-    
-    for sent in sents:           
-        words = set(word_tokenize(sent))
-        words = words-all_stop_words
-        if len(words) != 0:
-            emb = sum([word_embeddings.get(word, np.zeros(300)) for word in words])/(
-                len(words)+0.001)
-        else:
-            emb = np.zeros(300)
-        sent_embs.append(emb)
-
-    return sent_embs
