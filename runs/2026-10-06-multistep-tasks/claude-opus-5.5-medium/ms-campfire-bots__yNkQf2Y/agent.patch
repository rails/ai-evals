@@ -0,0 +1,114 @@
+require "test_helper"
+
+class User::Bot::SuspendableTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:deploy_bot)
+    @room = rooms(:watercooler)
+  end
+
+  test "posts are allowed up to the flood limit" do
+    10.times { assert_equal :allowed, post_message }
+    assert_not @bot.reload.cooling_down?
+  end
+
+  test "the post that goes over the limit is rejected and starts a cooldown" do
+    10.times { post_message }
+
+    assert_no_difference -> { @bot.messages.count } do
+      assert_equal :cooling_down, post_message
+    end
+
+    assert @bot.reload.cooling_down?
+    assert_equal 30, @bot.cooldown_seconds_left
+  end
+
+  test "the limit is a sliding window" do
+    5.times { post_message }
+    travel 6.seconds
+    5.times { post_message }
+    assert_equal :cooling_down, post_message
+
+    @bot.reactivate
+    travel 5.seconds
+    assert_equal :allowed, post_message
+  end
+
+  test "posting is allowed again once the cooldown is over" do
+    11.times { post_message }
+
+    travel 31.seconds
+    assert_equal :allowed, post_message
+    assert_not @bot.reload.suspended?
+  end
+
+  test "five attempts during the same cooldown suspend the bot" do
+    11.times { post_message }
+
+    4.times { assert_equal :cooling_down, post_message }
+    assert_not @bot.reload.suspended?
+
+    assert_equal :cooling_down, post_message
+    assert @bot.reload.suspended?
+    assert @bot.suspended_for_flooding?
+
+    assert_equal :suspended, post_message
+  end
+
+  test "attempts in an earlier cooldown don't count towards the next one" do
+    11.times { post_message }
+    4.times { post_message }
+
+    travel 31.seconds
+    11.times { post_message }
+    4.times { post_message }
+
+    assert_not @bot.reload.suspended?
+  end
+
+  test "ten failed webhook deliveries in a row suspend the bot" do
+    9.times { @bot.record_webhook_delivery(false) }
+    assert_not @bot.reload.suspended?
+
+    @bot.record_webhook_delivery(false)
+    assert @bot.reload.suspended?
+    assert @bot.suspended_for_failing_webhook?
+  end
+
+  test "a successful delivery resets the failure count" do
+    9.times { @bot.record_webhook_delivery(false) }
+    @bot.record_webhook_delivery(true)
+    9.times { @bot.record_webhook_delivery(false) }
+
+    assert_not @bot.reload.suspended?
+    assert_equal 9, @bot.webhook_failures
+  end
+
+  test "suspended bots keep their rooms and messages and still count towards the limit" do
+    post_message
+    @bot.suspend(:flooding)
+
+    assert @bot.reload.active?
+    assert_includes @bot.rooms, @room
+    assert @bot.messages.any?
+    assert_includes users(:kevin).bots.active, @bot
+    assert_not @bot.webhook?
+  end
+
+  test "reactivate" do
+    11.times { post_message }
+    5.times { post_message }
+    @bot.update!(webhook_failures: 3)
+
+    @bot.reactivate
+
+    assert_not @bot.reload.suspended?
+    assert_nil @bot.suspension_reason
+    assert_not @bot.cooling_down?
+    assert_equal 0, @bot.webhook_failures
+  end
+
+  private
+    def post_message
+      @bot.post_within_limits { @room.messages.create!(creator: @bot, body: "Hello") }
+    end
+end
diff --git a/test/models/user/bot/webhook_test.rb b/test/models/user/bot/webhook_test.rb
new file mode 100644
index 0000000..eadae2c
--- /dev/null
+++ b/test/models/user/bot/webhook_test.rb
@@ -0,0 +1,172 @@
+require "test_helper"
+
+class User::Bot::WebhookTest < ActiveSupport::TestCase
+  WEBHOOK_URL = "https://bots.example.com/campfire"
+
+  setup do
+    @bot = users(:deploy_bot)
+    @bot.update!(webhook_url: WEBHOOK_URL)
+    @room = rooms(:watercooler)
+    @message = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(:deploy_bot)} restart the build please</div>")
+
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bots.example.com").returns("93.184.216.34")
+  end
+
+  test "posts the mention payload as JSON" do
+    request = WebMock.stub_request(:post, WEBHOOK_URL).with { |request|
+      payload = JSON.parse(request.body)
+
+      request.headers["Content-Type"] == "application/json" &&
+        payload["event"] == "mention" &&
+        payload["author"] == { "id" => users(:david).id, "name" => "David" } &&
+        payload["room"] == { "id" => @room.id, "name" => "All Talk", "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages" } &&
+        payload["message"]["id"] == @message.id &&
+        payload["message"]["body"]["text"] == "restart the build please" &&
+        payload["message"]["body"]["html"].include?("restart the build please") &&
+        payload["message"]["link"] == "/rooms/#{@room.id}/@#{@message.id}"
+    }.to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      @bot.deliver_webhook(@message)
+    end
+
+    assert_requested request
+  end
+
+  test "keeps mentions of other people in the text" do
+    message = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(:deploy_bot)} ping #{mention_attachment_for(:jason)}</div>")
+
+    assert_equal "ping @Jason", @bot.webhook.payload_for(message)[:message][:body][:text]
+  end
+
+  test "a text/plain reply is posted as the bot" do
+    WebMock.stub_request(:post, WEBHOOK_URL).to_return(status: 200, body: "On it <b>now</b>\nok", headers: { "Content-Type" => "text/plain; charset=utf-8" })
+
+    assert_difference -> { @room.messages.count }, +1 do
+      @bot.deliver_webhook(@message)
+    end
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal "On it <b>now</b>\nok", reply.body.to_plain_text
+  end
+
+  test "a text/html reply is posted as the bot" do
+    WebMock.stub_request(:post, WEBHOOK_URL).to_return(status: 200, body: "<p>Build <strong>restarted</strong></p>", headers: { "Content-Type" => "text/html" })
+
+    @bot.deliver_webhook(@message)
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.body.to_html, "<strong>restarted</strong>"
+  end
+
+  test "204, other content types, errors and blank bodies post nothing" do
+    WebMock.stub_request(:post, WEBHOOK_URL).to_return(
+      { status: 204 },
+      { status: 200, body: '{"a":1}', headers: { "Content-Type" => "application/json" } },
+      { status: 200, body: "  ", headers: { "Content-Type" => "text/plain" } },
+      { status: 500, body: "boom", headers: { "Content-Type" => "text/plain" } }
+    ).then.to_timeout
+
+    assert_no_difference -> { Message.count } do
+      5.times { @bot.deliver_webhook(@message) }
+    end
+  end
+
+  test "private addresses are refused" do
+    RestrictedHTTP::PrivateNetworkGuard.unstub(:resolve)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).raises(RestrictedHTTP::Violation)
+
+    assert_no_difference -> { Message.count } do
+      assert_nil @bot.deliver_webhook(@message)
+    end
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "posts the joined payload as JSON, and posts a reply into that room" do
+    request = WebMock.stub_request(:post, WEBHOOK_URL).with { |request|
+      JSON.parse(request.body) == {
+        "event" => "joined",
+        "room" => { "id" => @room.id, "name" => "All Talk", "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages" }
+      }
+    }.to_return(status: 200, body: "Hello, everyone!", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { @room.messages.count }, +1 do
+      @bot.deliver_joined_webhook(@room)
+    end
+
+    assert_requested request
+    assert_equal @bot, @room.messages.last.creator
+    assert_equal "Hello, everyone!", @room.messages.last.body.to_plain_text
+  end
+
+  test "joined isn't delivered for rooms the bot has left or direct rooms" do
+    direct = Rooms::Direct.create_for({ creator: users(:kevin) }, users: [ users(:kevin), @bot ])
+    @room.memberships.revoke_from(@bot)
+
+    @bot.deliver_joined_webhook(@room)
+    @bot.deliver_joined_webhook(direct)
+
+    assert_not_requested :post, WEBHOOK_URL
+  end
+
+  test "joined job delivers once the bot is added in a transaction" do
+    WebMock.stub_request(:post, WEBHOOK_URL).to_return(status: 204)
+
+    perform_enqueued_jobs only: Bot::JoinedWebhookJob do
+      Rooms::Closed.create_for({ name: "Ops", creator: users(:kevin) }, users: [ users(:kevin), @bot ])
+    end
+
+    assert_requested :post, WEBHOOK_URL, times: 1
+  end
+
+  test "ten failed deliveries in a row suspend the bot" do
+    WebMock.stub_request(:post, WEBHOOK_URL).to_return(status: 500).times(4).then
+      .to_return(status: 404).times(2).then.to_timeout.times(2).then.to_raise(Errno::ECONNREFUSED)
+
+    9.times { @bot.deliver_webhook(@message) }
+    assert_not @bot.reload.suspended?
+
+    @bot.deliver_webhook(@message)
+    assert @bot.reload.suspended?
+    assert @bot.suspended_for_failing_webhook?
+  end
+
+  test "a successful delivery resets the failure count" do
+    WebMock.stub_request(:post, WEBHOOK_URL).to_return(status: 500).times(9).then.to_return(status: 204)
+
+    10.times { @bot.deliver_webhook(@message) }
+
+    assert_not @bot.reload.suspended?
+    assert_equal 0, @bot.webhook_failures
+  end
+
+  test "suspended bots receive no webhooks" do
+    request = WebMock.stub_request(:post, WEBHOOK_URL).to_return(status: 204)
+    @bot.suspend(:flooding)
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(:deploy_bot)} hello</div>")
+    end
+
+    @bot.deliver_webhook(@message)
+    @bot.deliver_joined_webhook(@room)
+    assert_not_requested request
+  end
+
+  test "replies count towards the flood limit and are dropped during the cooldown" do
+    WebMock.stub_request(:post, WEBHOOK_URL).to_return(status: 200, body: "On it", headers: { "Content-Type" => "text/plain" })
+    10.times { @room.messages.create!(creator: @bot, body: "Hello") }
+
+    assert_no_difference -> { Message.count } do
+      @bot.deliver_webhook(@message)
+    end
+    assert @bot.reload.cooling_down?
+
+    travel 31.seconds
+    assert_difference -> { Message.count }, +1 do
+      @bot.deliver_webhook(@message)
+    end
+  end
+end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..5871b4f
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,168 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "create bot" do
+    bot = User.create_bot!(name: "CI", creator: users(:kevin))
+
+    assert bot.bot?
+    assert_equal users(:kevin), bot.creator
+    assert_match /\A#{bot.id}-\w{24}\z/, bot.bot_code
+    assert_includes users(:kevin).bots, bot
+  end
+
+  test "bots require a name" do
+    assert_raises(ActiveRecord::RecordInvalid) { User.create_bot!(name: "") }
+  end
+
+  test "new bots don't join open rooms by default" do
+    bot = User.create_bot!(name: "CI")
+    assert_empty bot.rooms
+  end
+
+  test "bots set to join all open rooms join existing and later open rooms" do
+    bot = User.create_bot!(name: "CI", joins_all_open_rooms: true)
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+
+    room = Rooms::Open.create!(name: "Later", creator: users(:david))
+    assert_includes room.users, bot
+
+    closed = rooms(:designers).becomes!(Rooms::Open)
+    closed.save!
+    assert_includes closed.users, bot
+  end
+
+  test "turning on joining all open rooms adds the bot to every open room, turning it off keeps them" do
+    bot = users(:deploy_bot)
+
+    bot.update!(joins_all_open_rooms: true)
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.opens.pluck(:id).sort
+
+    assert_no_difference -> { bot.memberships.count } do
+      bot.update!(joins_all_open_rooms: false)
+    end
+    assert_not_includes Rooms::Open.create!(name: "Later", creator: users(:david)).users, bot
+  end
+
+  test "joined event is enqueued once per room the bot lands in" do
+    bot = users(:deploy_bot)
+    bot.update!(webhook_url: "https://bots.example.com/hook")
+    newly_joined = Rooms::Open.where.not(id: bot.rooms).count
+
+    assert_enqueued_jobs newly_joined, only: Bot::JoinedWebhookJob do
+      bot.update!(joins_all_open_rooms: true)
+    end
+
+    assert_no_enqueued_jobs only: Bot::JoinedWebhookJob do
+      bot.update!(joins_all_open_rooms: false)
+      bot.update!(joins_all_open_rooms: true)
+      rooms(:watercooler).memberships.grant_to(bot)
+    end
+
+    assert_enqueued_with job: Bot::JoinedWebhookJob, args: [ bot, rooms(:designers) ] do
+      rooms(:designers).memberships.grant_to(bot)
+    end
+  end
+
+  test "joining a direct room or having no webhook doesn't announce" do
+    bot = users(:deploy_bot)
+
+    assert_no_enqueued_jobs only: Bot::JoinedWebhookJob do
+      rooms(:designers).memberships.grant_to(bot)
+
+      bot.update!(webhook_url: "https://bots.example.com/hook")
+      Rooms::Direct.create_for({ creator: users(:kevin) }, users: [ users(:kevin), bot ])
+    end
+  end
+
+  test "people still join all open rooms" do
+    person = User.create!(name: "New", email_address: "new@example.com", password: "secret123456")
+    assert_equal Rooms::Open.pluck(:id).sort, person.rooms.pluck(:id).sort
+  end
+
+  test "authenticate bot" do
+    bot = users(:deploy_bot)
+
+    assert_equal bot, User.authenticate_bot(bot.bot_code)
+    assert_nil User.authenticate_bot("#{bot.id}-wrong")
+    assert_nil User.authenticate_bot("#{bot.id}")
+    assert_nil User.authenticate_bot("")
+    assert_nil User.authenticate_bot(nil)
+  end
+
+  test "people can't authenticate as bots" do
+    users(:kevin).update_columns bot_token: "sometoken"
+    assert_nil User.authenticate_bot("#{users(:kevin).id}-sometoken")
+  end
+
+  test "reset bot code" do
+    bot = users(:deploy_bot)
+    old_code = bot.bot_code
+
+    bot.reset_bot_code
+
+    assert_not_equal old_code, bot.bot_code
+    assert_nil User.authenticate_bot(old_code)
+    assert_equal bot, User.authenticate_bot(bot.bot_code)
+  end
+
+  test "deactivated bots can't authenticate" do
+    bot = users(:deploy_bot)
+    code = bot.bot_code
+
+    bot.deactivate_bot
+
+    assert bot.reload.deactivated?
+    assert_nil bot.bot_token
+    assert_nil User.authenticate_bot(code)
+    assert_empty bot.memberships.without_direct_rooms
+  end
+
+  test "without bots" do
+    assert_not_includes User.without_bots, users(:deploy_bot)
+    assert_includes User.without_bots, users(:kevin)
+  end
+
+  test "webhook url is optional, normalized and must be http" do
+    bot = users(:deploy_bot)
+
+    bot.update!(webhook_url: "  https://bots.example.com/hook ")
+    assert_equal "https://bots.example.com/hook", bot.webhook_url
+
+    bot.update!(webhook_url: "")
+    assert_nil bot.webhook_url
+    assert_nil bot.webhook
+
+    assert_not bot.update(webhook_url: "ftp://example.com")
+    assert_not bot.update(webhook_url: "not a url")
+  end
+
+  test "deleting a bot removes its webhook" do
+    bot = users(:deploy_bot)
+    bot.update!(webhook_url: "https://bots.example.com/hook")
+
+    bot.deactivate_bot
+    assert_nil bot.reload.webhook_url
+  end
+
+  test "members can't create more bots than the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+
+    User.create_bot!(name: "Second", creator: users(:kevin))
+    assert users(:kevin).bot_limit_reached?
+
+    error = assert_raises(ActiveRecord::RecordInvalid) { User.create_bot!(name: "Third", creator: users(:kevin)) }
+    assert_match "reached the limit", error.message
+  end
+
+  test "bot limit defaults to 5" do
+    assert_equal 5, Account.new.bots_per_member
+    assert_equal 5, accounts(:signal).bots_per_member
+  end
+
+  test "administrators have no bot limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+    assert_not users(:david).bot_limit_reached?
+    assert_nothing_raised { User.create_bot!(name: "Admin Bot", creator: users(:david)) }
+  end
+end
