diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..e1f9531
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,122 @@
+# Bots are users that post messages through the HTTP API instead of a browser session.
+# They authenticate with a bot code ("<id>-<token>") embedded in the request path, have
+# no email address or password, and are owned by the person who created them.
+#
+# A bot can also have a webhook URL. When someone @-mentions the bot, Campfire POSTs the
+# message to that URL in the background (see User::Bot::Webhook and Bot::WebhookJob). It's
+# also told when it joins a room, so it can say hello (Membership::Announceable).
+#
+# Unlike people, bots only join open rooms when they're set to (joins_all_open_rooms).
+# Turning that on adds the bot to every open room, now and later. Turning it off keeps the
+# memberships the bot already has.
+#
+# Bots that flood rooms or whose webhook keeps failing are suspended automatically, until
+# an administrator reactivates them (User::Bot::Suspendable).
+module User::Bot
+  extend ActiveSupport::Concern
+  include Suspendable
+
+  BOT_TOKEN_LENGTH = 24
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :bots, -> { bot }, class_name: "User", foreign_key: :creator_id, inverse_of: :creator, dependent: :nullify
+
+    scope :without_bots, -> { not_bot }
+    scope :with_webhook, -> { where.not(webhook_url: nil) }
+
+    normalizes :webhook_url, with: ->(url) { url.strip.presence }
+
+    validates :name, presence: true, if: :bot?
+
+    after_save_commit :join_all_open_rooms, if: -> { bot? && saved_change_to_joins_all_open_rooms?(to: true) }
+    validate :webhook_url_must_be_http, if: -> { bot? && webhook_url.present? }
+    validate :creator_must_be_within_bot_limit, on: :create, if: -> { bot? && creator.present? }
+  end
+
+  class_methods do
+    def create_bot!(attributes)
+      create!(**attributes, role: :bot, bot_token: generate_bot_token)
+    end
+
+    def authenticate_bot(bot_code)
+      bot_id, bot_token = bot_code.to_s.split("-", 2)
+
+      if bot_token.present? && (bot = active.bot.find_by(id: bot_id)) && bot.bot_token.present?
+        bot if ActiveSupport::SecurityUtils.secure_compare(bot.bot_token, bot_token)
+      end
+    end
+
+    def generate_bot_token
+      SecureRandom.alphanumeric(BOT_TOKEN_LENGTH)
+    end
+  end
+
+  # Members can have at most Account#bots_per_member active bots; administrators aren't limited.
+  # Lowering the limit keeps existing bots, it only blocks new ones.
+  def bot_limit_reached?
+    !administrator? && bots.active.count >= bot_limit
+  end
+
+  def bot_limit
+    Current.account&.bots_per_member || Account::DEFAULT_BOTS_PER_MEMBER
+  end
+
+  def bot_code
+    "#{id}-#{bot_token}" if bot? && bot_token.present?
+  end
+
+  def reset_bot_code
+    update! bot_token: self.class.generate_bot_token
+  end
+
+  def deactivate_bot
+    transaction do
+      update! bot_token: nil, webhook_url: nil
+      deactivate
+    end
+  end
+
+  def webhook
+    User::Bot::Webhook.new(self) if webhook?
+  end
+
+  def webhook?
+    bot? && active? && !suspended? && bot_token.present? && webhook_url.present?
+  end
+
+  def deliver_webhook_later(message)
+    Bot::WebhookJob.perform_later(self, message) if webhook?
+  end
+
+  def deliver_webhook(message)
+    webhook&.deliver(message)
+  end
+
+  def deliver_joined_webhook_later(room)
+    Bot::JoinedWebhookJob.perform_later(self, room) if webhook? && !room.direct?
+  end
+
+  def deliver_joined_webhook(room)
+    webhook&.deliver_joined(room)
+  end
+
+  private
+    def join_all_open_rooms
+      grant_membership_to_open_rooms if active?
+    end
+
+    def creator_must_be_within_bot_limit
+      if creator.bot_limit_reached?
+        errors.add :base, "You’ve reached the limit of #{creator.bot_limit} bots per member"
+      end
+    end
+
+    def webhook_url_must_be_http
+      uri = URI.parse(webhook_url) rescue nil
+
+      unless uri.is_a?(URI::HTTP) && uri.host.present?
+        errors.add :webhook_url, "must be an http:// or https:// URL"
+      end
+    end
+end
diff --git a/app/models/user/bot/suspendable.rb b/app/models/user/bot/suspendable.rb
new file mode 100644
index 0000000..bb039fd
--- /dev/null
+++ b/app/models/user/bot/suspendable.rb
@@ -0,0 +1,98 @@
+# Misbehaving bots are stopped automatically, and only an administrator can bring them back.
+#
+# Flooding: a bot may post at most FLOOD_LIMIT messages in any FLOOD_WINDOW (API posts and
+# webhook replies alike, counted from the bot's messages). The message that goes over the
+# limit is rejected and starts a COOLDOWN. Every attempt to post during the cooldown is
+# rejected too (still a 429 for the API), and the COOLDOWN_ATTEMPTS_LIMIT-th one suspends the bot.
+#
+# Failing webhooks: WEBHOOK_FAILURES_LIMIT failed deliveries in a row suspend the bot. A
+# successful delivery resets the count.
+#
+# A suspended bot is still active: it keeps its rooms and messages, stays on the bots page
+# and counts towards its creator's bot limit. It just can't post or receive webhooks.
+# The limits are fixed on purpose; they aren't settings.
+module User::Bot::Suspendable
+  extend ActiveSupport::Concern
+
+  FLOOD_LIMIT = 10
+  FLOOD_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPTS_LIMIT = 5
+  WEBHOOK_FAILURES_LIMIT = 10
+
+  included do
+    enum :suspension_reason, { flooding: "flooding", failing_webhook: "failing_webhook" }, prefix: :suspended_for
+
+    scope :suspended, -> { where.not(suspended_at: nil) }
+    scope :not_suspended, -> { where(suspended_at: nil) }
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def suspend(reason)
+    update! suspended_at: Time.current, suspension_reason: reason
+  end
+
+  def reactivate
+    update! suspended_at: nil, suspension_reason: nil, cooldown_ends_at: nil, cooldown_attempts: 0, webhook_failures: 0
+  end
+
+  def cooling_down?
+    cooldown_ends_at&.future?
+  end
+
+  def cooldown_seconds_left
+    cooling_down? ? (cooldown_ends_at - Time.current).ceil.clamp(1..) : 0
+  end
+
+  # Yields only when the bot may post right now, and returns the verdict: :allowed,
+  # :cooling_down or :suspended. The verdict is reached under a row lock, but the post itself
+  # happens after it: messages with attachments can only be created outside a transaction
+  # (the file is uploaded on commit). So a burst of concurrent posts can overshoot by a few.
+  def post_within_limits
+    with_lock { posting_verdict }.tap do |verdict|
+      yield if verdict == :allowed
+    end
+  end
+
+  def record_webhook_delivery(succeeded)
+    with_lock do
+      if succeeded
+        update! webhook_failures: 0 if webhook_failures > 0
+      elsif !suspended?
+        increment :webhook_failures
+        webhook_failures >= WEBHOOK_FAILURES_LIMIT ? suspend(:failing_webhook) : save!
+      end
+    end
+  end
+
+  private
+    def posting_verdict
+      if suspended?
+        :suspended
+      elsif cooling_down?
+        record_attempt_during_cooldown
+      elsif flooding?
+        start_cooldown
+      else
+        :allowed
+      end
+    end
+
+    def flooding?
+      messages.where(created_at: FLOOD_WINDOW.ago..).count >= FLOOD_LIMIT
+    end
+
+    def start_cooldown
+      update! cooldown_ends_at: COOLDOWN.from_now, cooldown_attempts: 0
+      :cooling_down
+    end
+
+    def record_attempt_during_cooldown
+      increment :cooldown_attempts
+      cooldown_attempts >= COOLDOWN_ATTEMPTS_LIMIT ? suspend(:flooding) : save!
+      :cooling_down
+    end
+end
diff --git a/app/models/user/bot/webhook.rb b/app/models/user/bot/webhook.rb
new file mode 100644
index 0000000..f4af38c
--- /dev/null
+++ b/app/models/user/bot/webhook.rb
@@ -0,0 +1,141 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+# Delivers events to the bot's webhook URL, and posts the bot's synchronous reply (a 200
+# text/plain or text/html response) back into the room:
+#
+# * mention: a message that @-mentions the bot (from Bot::WebhookJob).
+# * joined: the bot was added to a room (from Bot::JoinedWebhookJob).
+#
+# Runs from those jobs, never inline, so a slow or broken bot can't hold up the person
+# posting or adding it. The webhook host is resolved through RestrictedHTTP so bots can't be
+# pointed at private network addresses, and redirects aren't followed.
+class User::Bot::Webhook
+  TIMEOUT = 7.seconds
+  MAX_REPLY_SIZE = 1.megabyte
+  REPLY_CONTENT_TYPES = %w[ text/plain text/html ]
+
+  attr_reader :bot
+
+  def initialize(bot)
+    @bot = bot
+  end
+
+  def deliver(message)
+    deliver_to message.room, payload_for(message)
+  end
+
+  # Only rooms the bot is still in, since it may have been removed before the job ran.
+  def deliver_joined(room)
+    if room = bot.rooms.without_directs.find_by(id: room.id)
+      deliver_to room, joined_payload_for(room)
+    end
+  end
+
+  def payload_for(message)
+    {
+      event: "mention",
+      author: { id: message.creator.id, name: message.creator.name },
+      room: room_payload_for(message.room),
+      message: {
+        id: message.id,
+        body: { text: text_addressed_to_bot(message), html: message.body.to_s },
+        link: routes.room_at_message_path(message.room, message)
+      }
+    }
+  end
+
+  def joined_payload_for(room)
+    { event: "joined", room: room_payload_for(room) }
+  end
+
+  private
+    # Every delivery counts towards User::Bot::Suspendable: a 2xx is a success, anything else
+    # (other statuses, timeouts, connection errors) a failure.
+    def deliver_to(room, payload)
+      succeeded, reply = post(payload)
+      bot.record_webhook_delivery(succeeded)
+
+      post_reply_to room, reply if reply
+    rescue RestrictedHTTP::Violation, Surfguard::Unresolvable, SocketError, SystemCallError, IOError,
+           Timeout::Error, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::ProtocolError => error
+      Rails.logger.warn "Failed to deliver webhook for bot #{bot.id} to #{url} (#{error.class}: #{error.message})"
+      bot.record_webhook_delivery(false)
+      nil
+    end
+
+    def room_payload_for(room)
+      { id: room.id, name: room.name, reply_to: routes.room_bot_messages_path(room, bot.bot_code) }
+    end
+
+    def url
+      @url ||= URI.parse(bot.webhook_url)
+    end
+
+    def routes
+      Rails.application.routes.url_helpers
+    end
+
+    def post(payload)
+      Net::HTTP.start(url.host, url.port, ipaddr: resolved_ip, use_ssl: url.scheme == "https",
+          open_timeout: TIMEOUT, read_timeout: TIMEOUT, write_timeout: TIMEOUT) do |http|
+        request = Net::HTTP::Post.new(url, "Content-Type" => "application/json", "Accept" => "text/plain, text/html")
+        request.body = payload.to_json
+
+        http.request(request) do |response|
+          return [ response.is_a?(Net::HTTPSuccess), reply_from(response) ]
+        end
+      end
+    end
+
+    def resolved_ip
+      RestrictedHTTP::PrivateNetworkGuard.resolve(url.host)
+    end
+
+    # The message's plain text, minus the bot's own @-mention, so it reads as the command
+    # addressed to the bot. Mentions of anyone else are kept.
+    def text_addressed_to_bot(message)
+      return "" unless message.body.body
+
+      message.body.body.render_attachments(with_full_attributes: false) do |attachment|
+        attachment.attachable == bot ? "" : attachment.to_plain_text
+      end.fragment.to_plain_text.gsub(/[[:blank:]]{2,}/, " ").strip
+    end
+
+    # 200 with a text/plain or text/html body is a reply to post. Anything else (204 included)
+    # means the bot has nothing to say right now.
+    def reply_from(response)
+      if response.is_a?(Net::HTTPOK) && response.content_type.in?(REPLY_CONTENT_TYPES)
+        if body = size_restricted_body(response)
+          text = body.force_encoding(Encoding::UTF_8).scrub.strip
+          text = plain_text_to_html(text) if response.content_type == "text/plain"
+          text.presence
+        end
+      end
+    end
+
+    def size_restricted_body(response)
+      return if response.content_length.to_i > MAX_REPLY_SIZE
+
+      String.new.tap do |body|
+        response.read_body do |chunk|
+          return if body.bytesize + chunk.bytesize > MAX_REPLY_SIZE
+          body << chunk
+        end
+      end
+    end
+
+    def plain_text_to_html(text)
+      ERB::Util.html_escape(text).to_str.gsub(/\r?\n/, "<br>")
+    end
+
+    # Replies are subject to the same flood limit as API posts. While the bot is cooling down
+    # or suspended, the reply is dropped.
+    def post_reply_to(room, body)
+      if room = bot.rooms.find_by(id: room.id)
+        message = nil
+        bot.post_within_limits { message = room.messages.create!(body: body, creator: bot) }
+        message&.broadcast_create
+      end
+    end
+end
