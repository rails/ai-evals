diff --git a/app/controllers/messages/by_bots_controller.rb b/app/controllers/messages/by_bots_controller.rb
new file mode 100644
index 0000000..2b272ee
--- /dev/null
+++ b/app/controllers/messages/by_bots_controller.rb
@@ -0,0 +1,51 @@
+# Lets bots post messages with a plain HTTP request, e.g. from shell scripts and CI jobs:
+#
+#   curl -d "Deploy finished" https://chat.example.com/rooms/:room_id/:bot_key/messages
+#   curl -F "attachment=@report.pdf" https://chat.example.com/rooms/:room_id/:bot_key/messages
+#
+# The raw request body becomes the message body. Messages are broadcast and pushed
+# exactly like the ones people post from the composer.
+#
+# Bots that post too fast get 429 with a Retry-After header while they cool down, and 403
+# once they're suspended (see User::Bot::Suspendable).
+class Messages::ByBotsController < ApplicationController
+  include ActiveStorage::SetCurrent, RoomScoped
+
+  allow_bot_access only: :create
+
+  rescue_from(ActiveRecord::RecordNotFound) { head :not_found }
+
+  def create
+    if message_params.any?
+      case Current.user.post_within_limits { @message = @room.messages.create_with_attachment!(message_params) }
+      when :allowed
+        @message.broadcast_create
+        head :created, location: message_path(@message)
+      when :cooling_down
+        response.headers["Retry-After"] = Current.user.cooldown_seconds_left.to_s
+        head :too_many_requests
+      else
+        head :forbidden
+      end
+    else
+      head :unprocessable_content
+    end
+  end
+
+  private
+    def message_params
+      @message_params ||= if request.content_mime_type == Mime[:multipart_form]
+        { body: params[:body], attachment: attachment }.compact_blank
+      else
+        { body: request_body }.compact_blank
+      end
+    end
+
+    def attachment
+      params[:attachment] if params[:attachment].is_a?(ActionDispatch::Http::UploadedFile)
+    end
+
+    def request_body
+      request.raw_post.to_s.dup.force_encoding(Encoding::UTF_8).scrub.strip
+    end
+end
