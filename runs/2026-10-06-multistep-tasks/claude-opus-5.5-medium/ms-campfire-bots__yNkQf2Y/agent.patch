diff --git a/app/views/bots/index.html.erb b/app/views/bots/index.html.erb
new file mode 100644
index 0000000..622ae80
--- /dev/null
+++ b/app/views/bots/index.html.erb
@@ -0,0 +1,48 @@
+<% @page_title = "Chat bots" %>
+
+<% content_for :head do %>
+  <meta name="turbo-cache-control" content="no-cache">
+<% end %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to edit_account_path %>
+  </div>
+<% end %>
+
+<section class="panel panel--wide flex flex-column gap" style="view-transition-name: bots">
+  <div class="txt-align-center">
+    <h1 class="txt-large margin-none">Chat bots</h1>
+    <p class="margin-none-block-end">Bots post messages to rooms with a simple HTTP request. Keep each bot code secret.</p>
+  </div>
+
+  <% if Current.user.bot_limit_reached? %>
+    <p class="txt-align-center txt-subtle margin-none" id="bot_limit">
+      You’ve reached the limit of <%= pluralize Current.user.bot_limit, "bot" %> per member. Delete a bot to add another.
+    </p>
+  <% else %>
+    <%= link_to new_bot_path, class: "btn btn--reversed center" do %>
+      <%= image_tag "add.svg", aria: { hidden: "true" }, size: 20 %>
+      <span>Add a chat bot</span>
+    <% end %>
+  <% end %>
+
+  <% if @bots.any? %>
+    <div class="pad-inline fill-shade border-radius">
+      <menu class="pad flex flex-column gap margin-none" id="bots">
+        <%= render partial: "bots/bot", collection: @bots %>
+      </menu>
+    </div>
+
+    <details class="txt-small">
+      <summary>How to post a message as a bot</summary>
+      <pre class="txt-align-start" style="overflow-x: auto; white-space: pre-wrap; word-break: break-all"><code>curl -d "Hello from a bot" <%= root_url %>rooms/&lt;room-id&gt;/&lt;bot-code&gt;/messages</code></pre>
+      <p class="txt-align-start">A bot can post up to 10 messages every 10 seconds. Going over that pauses it for 30 seconds (<code>429</code>, with a <code>Retry-After</code> header). A bot that keeps trying while paused, or whose webhook fails 10 times in a row, is suspended until an administrator reactivates it.</p>
+    </details>
+
+    <details class="txt-small">
+      <summary>How to make a bot answer when it’s mentioned</summary>
+      <p class="txt-align-start">Give the bot a webhook URL. When someone @-mentions the bot, Campfire POSTs the message to that URL as JSON, including a <code>reply_to</code> path to post to later. Respond with <code>200</code> and a <code>text/plain</code> or <code>text/html</code> body to reply right away, or with <code>204</code> to stay quiet.</p>
+    </details>
+  <% end %>
+</section>
