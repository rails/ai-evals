diff --git a/app/models/user/bot/suspendable.rb b/app/models/user/bot/suspendable.rb
new file mode 100644
index 0000000..bb039fd
--- /dev/null
+++ b/app/models/user/bot/suspendable.rb
@@ -0,0 +1,98 @@
+# Misbehaving bots are stopped automatically, and only an administrator can bring them back.
+#
+# Flooding: a bot may post at most FLOOD_LIMIT messages in any FLOOD_WINDOW (API posts and
+# webhook replies alike, counted from the bot's messages). The message that goes over the
+# limit is rejected and starts a COOLDOWN. Every attempt to post during the cooldown is
+# rejected too (still a 429 for the API), and the COOLDOWN_ATTEMPTS_LIMIT-th one suspends the bot.
+#
+# Failing webhooks: WEBHOOK_FAILURES_LIMIT failed deliveries in a row suspend the bot. A
+# successful delivery resets the count.
+#
+# A suspended bot is still active: it keeps its rooms and messages, stays on the bots page
+# and counts towards its creator's bot limit. It just can't post or receive webhooks.
+# The limits are fixed on purpose; they aren't settings.
+module User::Bot::Suspendable
+  extend ActiveSupport::Concern
+
+  FLOOD_LIMIT = 10
+  FLOOD_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPTS_LIMIT = 5
+  WEBHOOK_FAILURES_LIMIT = 10
+
+  included do
+    enum :suspension_reason, { flooding: "flooding", failing_webhook: "failing_webhook" }, prefix: :suspended_for
+
+    scope :suspended, -> { where.not(suspended_at: nil) }
+    scope :not_suspended, -> { where(suspended_at: nil) }
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def suspend(reason)
+    update! suspended_at: Time.current, suspension_reason: reason
+  end
+
+  def reactivate
+    update! suspended_at: nil, suspension_reason: nil, cooldown_ends_at: nil, cooldown_attempts: 0, webhook_failures: 0
+  end
+
+  def cooling_down?
+    cooldown_ends_at&.future?
+  end
+
+  def cooldown_seconds_left
+    cooling_down? ? (cooldown_ends_at - Time.current).ceil.clamp(1..) : 0
+  end
+
+  # Yields only when the bot may post right now, and returns the verdict: :allowed,
+  # :cooling_down or :suspended. The verdict is reached under a row lock, but the post itself
+  # happens after it: messages with attachments can only be created outside a transaction
+  # (the file is uploaded on commit). So a burst of concurrent posts can overshoot by a few.
+  def post_within_limits
+    with_lock { posting_verdict }.tap do |verdict|
+      yield if verdict == :allowed
+    end
+  end
+
+  def record_webhook_delivery(succeeded)
+    with_lock do
+      if succeeded
+        update! webhook_failures: 0 if webhook_failures > 0
+      elsif !suspended?
+        increment :webhook_failures
+        webhook_failures >= WEBHOOK_FAILURES_LIMIT ? suspend(:failing_webhook) : save!
+      end
+    end
+  end
+
+  private
+    def posting_verdict
+      if suspended?
+        :suspended
+      elsif cooling_down?
+        record_attempt_during_cooldown
+      elsif flooding?
+        start_cooldown
+      else
+        :allowed
+      end
+    end
+
+    def flooding?
+      messages.where(created_at: FLOOD_WINDOW.ago..).count >= FLOOD_LIMIT
+    end
+
+    def start_cooldown
+      update! cooldown_ends_at: COOLDOWN.from_now, cooldown_attempts: 0
+      :cooling_down
+    end
+
+    def record_attempt_during_cooldown
+      increment :cooldown_attempts
+      cooldown_attempts >= COOLDOWN_ATTEMPTS_LIMIT ? suspend(:flooding) : save!
+      :cooling_down
+    end
+end
