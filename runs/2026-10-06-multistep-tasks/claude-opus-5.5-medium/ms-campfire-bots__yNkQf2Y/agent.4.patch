diff --git a/docs/bots.md b/docs/bots.md
index fa0d477..9b2b3fa 100644
--- a/docs/bots.md
+++ b/docs/bots.md
@@ -113,3 +113,22 @@ broadcasts and push notifications with no special casing.
 - `User::Bot::Webhook#deliver_joined(room)` checks the bot is still in the room (and that it isn't
   direct), then POSTs `{ event: "joined", room: { id, name, reply_to } }`. The reply rules are
   the same as for `mention` (shared `deliver_to`). The reply is posted into that room.
+
+### Bot limit per member
+
+- Account setting `bots_per_member` (in `accounts.settings` JSON via `has_json`, default
+  `Account::DEFAULT_BOTS_PER_MEMBER` = 5; `Account#bots_per_member`). Accounts saved before
+  the setting existed get the default automatically (`has_json` merges defaults on read).
+  It must be an integer ≥ 0 (`0` means members can't create bots at all). Invalid values
+  are refused and `AccountsController#update` redirects back with a flash alert.
+- Edited on `/account/edit` by administrators only: "Bots per member" (number field, submits
+  on change, like the other settings forms there).
+- `User#bot_limit_reached?` – false for administrators; otherwise
+  `bots.active.count >= bot_limit`. Deleted (deactivated) bots don't count.
+- Enforced in three places:
+  - `/bots` hides "Add a chat bot" and shows "You’ve reached the limit…" instead.
+  - `BotsController` `new`/`create` return `403` (`ensure_within_bot_limit`).
+  - Model backstop: `User::Bot` validates `creator_must_be_within_bot_limit` on create
+    (only when the bot has a creator), so `User.create_bot!` raises `RecordInvalid` too.
+- Lowering the limit never touches existing bots: it's only checked on create, so editing,
+  resetting codes and deleting bots over the limit still work.
diff --git a/test/controllers/accounts_controller_test.rb b/test/controllers/accounts_controller_test.rb
index 8292c6f..aca999f 100644
--- a/test/controllers/accounts_controller_test.rb
+++ b/test/controllers/accounts_controller_test.rb
@@ -58,4 +58,44 @@ class AccountsControllerTest < ActionDispatch::IntegrationTest
     put account_url, params: { account: { name: "Different" } }
     assert_response :forbidden
   end
+
+  test "edit shows the bots per member setting to administrators" do
+    get edit_account_url
+
+    assert_select "label", text: "Bots per member"
+    assert_select "input[type=number][name='account[settings][bots_per_member]'][value='5']"
+  end
+
+  test "edit hides the bots per member setting from members" do
+    sign_in :kevin
+
+    get edit_account_url
+
+    assert_select "input[name='account[settings][bots_per_member]']", count: 0
+  end
+
+  test "update bots per member" do
+    put account_url, params: { account: { settings: { bots_per_member: "2" } } }
+
+    assert_redirected_to edit_account_url
+    assert_equal 2, accounts(:signal).reload.bots_per_member
+    assert_not accounts(:signal).settings.restrict_room_creation_to_administrators?
+  end
+
+  test "update refuses an invalid bots per member" do
+    put account_url, params: { account: { settings: { bots_per_member: "-1" } } }
+
+    assert_redirected_to edit_account_url
+    assert flash[:alert].present?
+    assert_equal 5, accounts(:signal).reload.bots_per_member
+  end
+
+  test "non-admins cannot update bots per member" do
+    sign_in :kevin
+
+    put account_url, params: { account: { settings: { bots_per_member: "50" } } }
+
+    assert_response :forbidden
+    assert_equal 5, accounts(:signal).reload.bots_per_member
+  end
 end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
index e05bbbc..464f098 100644
--- a/test/controllers/bots_controller_test.rb
+++ b/test/controllers/bots_controller_test.rb
@@ -209,4 +209,69 @@ end
     assert_select "a[href=?]", bots_path, text: "Set up chat bots"
     assert_select "#account_users", text: /Deploy Bot/, count: 0
   end
+
+  test "members at the bot limit aren't offered to add a bot" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    get bots_url
+
+    assert_response :success
+    assert_select "a[href=?]", new_bot_path, count: 0
+    assert_select "a", text: "Add a chat bot", count: 0
+    assert_match "reached the limit", response.body
+  end
+
+  test "members below the bot limit are offered to add a bot" do
+    get bots_url
+
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+    assert_no_match "reached the limit", response.body
+  end
+
+  test "members at the bot limit can't create bots" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    get new_bot_url
+    assert_response :forbidden
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { user: { name: "One too many" } }
+    end
+    assert_response :forbidden
+  end
+
+  test "deleted bots don't count toward the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    users(:deploy_bot).deactivate_bot
+
+    assert_difference -> { User.bot.count }, +1 do
+      post bots_url, params: { user: { name: "Replacement" } }
+    end
+  end
+
+  test "administrators aren't limited" do
+    sign_in :david
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+    get bots_url
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+
+    assert_difference -> { User.bot.count }, +1 do
+      post bots_url, params: { user: { name: "Admin Bot" } }
+    end
+  end
+
+  test "lowering the limit keeps existing bots" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+    get bots_url
+    assert_select "##{dom_id(users(:deploy_bot))}"
+
+    get edit_bot_url(users(:deploy_bot))
+    assert_response :success
+
+    patch bot_url(users(:deploy_bot)), params: { user: { name: "Renamed" } }
+    assert_redirected_to bots_url
+    assert_equal "Renamed", users(:deploy_bot).reload.name
+  end
 end
