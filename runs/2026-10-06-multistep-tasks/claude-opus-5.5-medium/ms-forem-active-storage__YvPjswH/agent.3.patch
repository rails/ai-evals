@@ -0,0 +1,85 @@
+require "rails_helper"
+require "exifr/jpeg"
+
+RSpec.describe Images::ProfileImageProcessor, type: :service do
+  def fixture(name, type)
+    Rack::Test::UploadedFile.new(Rails.root.join("spec/fixtures/files", name), type)
+  end
+
+  it "accepts the image types ProfileImageUploader accepted", :aggregate_failures do
+    {
+      "800x600.jpg" => ["jpg", "image/jpeg"],
+      "800x600.png" => ["png", "image/png"],
+      "800x600.webp" => ["webp", "image/webp"]
+    }.each do |name, (extension, content_type)|
+      image = described_class.call(fixture(name, content_type))
+      expect(image).to have_attributes(extension: extension, content_type: content_type)
+      expect(image.read).to eq(Rails.root.join("spec/fixtures/files", name).binread)
+    end
+  end
+
+  it "rejects unsupported formats like pdf" do
+    expect { described_class.call(fixture("800x600.pdf", "application/pdf")) }
+      .to raise_error(described_class::IntegrityError, "Image has an unsupported type")
+  end
+
+  it "rejects images that are too big (image bombs)" do
+    stub_const("#{described_class}::MAX_PIXEL_DIMENSIONS", [100, 100])
+    expect { described_class.call(fixture("800x600.jpg", "image/jpeg")) }
+      .to raise_error(described_class::IntegrityError, "Image size should be less than or equal to 100x100")
+  end
+
+  it "ignores empty contents without a file, like CarrierWave did" do
+    expect(described_class.call(StringIO.new(""))).to be_nil
+  end
+
+  it "rejects empty files" do
+    expect { described_class.call(Tempfile.new(["empty", ".png"])) }
+      .to raise_error(described_class::IntegrityError, "Image has an unsupported type")
+  end
+
+  it "ignores empty downloads, like CarrierWave did" do
+    stub_request(:get, "https://example.com/empty.png").to_return(status: 200, body: "")
+    expect(described_class.download("https://example.com/empty.png")).to be_nil
+  end
+
+  context "with processing enabled (as in production)" do
+    before { allow(described_class).to receive(:enable_processing).and_return(true) }
+
+    it "removes EXIF and GPS data", :aggregate_failures do
+      upload = fixture("image_gps_data.jpg", "image/jpeg")
+      expect(EXIFR::JPEG.new(upload.path).gps.present?).to be(true)
+
+      image = described_class.call(upload)
+      expect(EXIFR::JPEG.new(image.tempfile.path).exif?).to be(false)
+      expect(EXIFR::JPEG.new(image.tempfile.path).gps.present?).to be(false)
+    end
+
+    it "rejects GIFs with too many frames" do
+      stub_const("#{described_class}::FRAME_MAX", 1)
+      expect { described_class.call(fixture("high_frame_count.gif", "image/gif")) }
+        .to raise_error(described_class::IntegrityError, /too many frames/)
+    end
+  end
+
+  describe ".download" do
+    it "downloads the image" do
+      stub_request(:get, "https://example.com/me.png")
+        .to_return(status: 200, body: Rails.root.join("spec/fixtures/files/800x600.png").binread,
+                   headers: { "Content-Type" => "image/png" })
+
+      expect(described_class.download("https://example.com/me.png"))
+        .to have_attributes(extension: "png", content_type: "image/png")
+    end
+
+    it "rejects invalid URLs" do
+      expect { described_class.download("not a url") }.to raise_error(described_class::DownloadError)
+    end
+
+    it "protects against SSRF" do
+      allow(described_class).to receive(:skip_ssrf_protection?).and_call_original
+      expect { described_class.download("http://127.0.0.1/avatar.png") }
+        .to raise_error(described_class::DownloadError, /could not download file/)
+    end
+  end
+end
