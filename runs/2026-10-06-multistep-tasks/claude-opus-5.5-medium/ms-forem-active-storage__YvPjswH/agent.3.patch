diff --git a/db/migrate/20261008120000_copy_remaining_profile_images_to_active_storage.rb b/db/migrate/20261008120000_copy_remaining_profile_images_to_active_storage.rb
new file mode 100644
index 0000000..fa889bb
--- /dev/null
+++ b/db/migrate/20261008120000_copy_remaining_profile_images_to_active_storage.rb
@@ -0,0 +1,28 @@
+# Profile images of users and organizations are served from Active Storage only, starting with the
+# release that ships this migration (see ProfileImageStorage). Migrations run in the release phase,
+# before the release serves anything: copy whatever the previous runs of
+# `bin/rails profile_images:copy` haven't, so that no profile image that can be seen today is lost.
+#
+# If any image can't be copied (e.g. a storage error), the migration fails, and so does the
+# release: the previous release keeps serving every image, and the next attempt retries (copied
+# images are skipped). Records whose legacy file doesn't exist have no image to show, and don't
+# fail it.
+#
+# Nothing is removed (neither the legacy column nor the files), so rolling back needs nothing.
+class CopyRemainingProfileImagesToActiveStorage < ActiveRecord::Migration[8.0]
+  disable_ddl_transaction! # each image is attached in its own transaction, see Images::ProfileImageCopier
+
+  def up
+    results = Images::ProfileImageCopier.call(logger: ActiveSupport::Logger.new($stdout))
+
+    failed = results.values.sum(&:failed)
+    return unless failed.positive?
+
+    raise "#{failed} profile images could not be copied to Active Storage (see the log above); " \
+          "fix the cause and deploy again (or run `bin/rails profile_images:copy` then deploy again)."
+  end
+
+  def down
+    # Nothing to undo: the legacy profile images were left untouched.
+  end
+end
