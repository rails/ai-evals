+      expect(copy[legacy.class].copied).to eq(1)
+    end
+
+    it "is idempotent", :aggregate_failures do
+      copy
+      blob = legacy.reload.avatar.blob
+
+      expect { copy }.not_to change(ActiveStorage::Blob, :count)
+      expect(copy[legacy.class]).to have_attributes(copied: 0, skipped: 1)
