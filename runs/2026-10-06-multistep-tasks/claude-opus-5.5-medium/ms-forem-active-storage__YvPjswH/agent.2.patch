+require "rails_helper"
+
+RSpec.describe "Profile images copied to Active Storage" do
+  let(:jpeg_path) { Rails.root.join("spec/support/fixtures/images/image2.jpeg") }
+
+  it "are served from their Active Storage URL" do
+    user = build(:user, profile_image: nil).tap { |record| record.save!(validate: false) }
+    uploader = ProfileImageUploader.new(user, :profile_image)
+    uploader.store!(Rack::Test::UploadedFile.new(jpeg_path, "image/jpeg"))
+    user.update_column(:profile_image, uploader.identifier)
+
+    Images::ProfileImageCopier.call(models: [User], logger: Logger.new(File::NULL))
+    url = User.find(user.id).profile_image_url
+
+    get URI(url).path
+    expect(response).to have_http_status(:redirect)
+
+    get URI(response.location).request_uri
+    expect(response).to have_http_status(:ok)
+    expect(response.body.b).to eq(File.binread(jpeg_path))
+  end
+end
