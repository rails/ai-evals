--- /dev/null
+++ b/spec/services/images/profile_image_copier_spec.rb
@@ -0,0 +1,230 @@
+require "rails_helper"
+
+RSpec.describe Images::ProfileImageCopier, type: :service do
+  let(:jpeg_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+  let(:other_jpeg_path) { Rails.root.join("spec/support/fixtures/images/image2.jpeg") }
+  let(:logger) { Logger.new(File::NULL) }
+
+  # A record with a profile image stored by CarrierWave, i.e. one uploaded before profile images
+  # moved to Active Storage.
+  def with_carrierwave_profile_image(record, path: other_jpeg_path, content_type: "image/jpeg")
+    uploader = ProfileImageUploader.new(record, :profile_image)
+    uploader.store!(Rack::Test::UploadedFile.new(path, content_type))
+    record.update_column(:profile_image, uploader.identifier)
+    record.class.find(record.id)
+  end
+
+  # What CarrierWave reads for the record's legacy column (what the previous release shows).
+  def legacy_uploader(record)
+    uploader = ProfileImageUploader.new(record, :profile_image)
+    uploader.retrieve_from_store!(record[:profile_image])
+    uploader
+  end
+
+  def create_legacy(factory, **options)
+    record = build(factory, profile_image: nil).tap { |r| r.save!(validate: false) }
+    with_carrierwave_profile_image(record, **options)
+  end
+
+  # Not `described_class`: that is User or Organization in the nested groups.
+  def new_copier
+    Images::ProfileImageCopier.new(logger: logger)
+  end
+
+  def copy(models = [User, Organization])
+    Images::ProfileImageCopier.call(models: models, logger: logger)
+  end
+
+  shared_examples "copying profile images" do |factory|
+    let(:model) { described_class }
+    let!(:legacy) { create_legacy(factory) }
+    let!(:identifier) { legacy[:profile_image] }
+    let!(:carrierwave_path) { legacy_uploader(legacy).path }
+    let!(:carrierwave_url) { legacy_uploader(legacy).url }
+
+    it "copies the CarrierWave image to Active Storage, and serves it from there", :aggregate_failures do
+      # Legacy images aren't read anymore: they're only shown once copied.
+      expect(legacy.profile_image_url).to be_nil
+
+      expect(copy[legacy.class].copied).to eq(1)
+
+      legacy.reload
+      expect(legacy.avatar).to be_attached
+      expect(legacy.avatar.download).to eq(File.binread(other_jpeg_path))
+      expect(legacy.avatar.blob.filename.to_s).to eq("profile_image.jpeg")
+      expect(legacy.avatar.blob.key).to start_with("profile_images/").and end_with(".jpeg")
+      expect(legacy.avatar.blob.content_type).to eq("image/jpeg")
+      expect(legacy.profile_image_url).to include("/rails/active_storage/blobs/redirect/")
+      expect(legacy.profile_image_present?).to be(true)
+    end
+
+    it "leaves the CarrierWave image alone, for the previous release", :aggregate_failures do
+      copy
+      legacy.reload
+
+      expect(legacy[:profile_image]).to eq(identifier)
+      expect(File.exist?(carrierwave_path)).to be(true)
+      expect(legacy_uploader(legacy).url).to eq(carrierwave_url)
+    end
+
+    it "doesn't save the record, nor change its updated_at" do
+      legacy.update_column(:updated_at, 1.day.ago)
+      expect { copy }.not_to(change { legacy.reload.updated_at })
+      expect(Images::SocialImageWorker.jobs).to be_empty
+    end
+
+    it "doesn't need the record to be valid" do
+      legacy.update_column(:name, "x" * 500)
+      expect(copy[legacy.class].copied).to eq(1)
+    end
+
+    it "is idempotent", :aggregate_failures do
+      copy
+      blob = legacy.reload.avatar.blob
+
+      expect { copy }.not_to change(ActiveStorage::Blob, :count)
+      expect(copy[legacy.class]).to have_attributes(copied: 0, skipped: 1)
+      expect(legacy.reload.avatar.blob).to eq(blob)
+    end
+
+    it "picks up where an interrupted run stopped" do
+      others = create_list(factory, 2).map { |record| create_legacy_from(record) }
+      records = [legacy, *others]
+      calls = 0
+      copier = new_copier
+      allow(copier).to receive(:copy).and_wrap_original do |method, record|
+        calls += 1
+        raise Interrupt if calls == 2
+
+        method.call(record)
+      end
+      expect { copier.call([legacy.class]) }.to raise_error(Interrupt)
+      expect(records.count { |record| record.reload.avatar.attached? }).to eq(1)
+
+      expect(copy[legacy.class]).to have_attributes(copied: 2, skipped: 1)
+      expect(records.map { |record| record.reload.avatar.attached? }).to all(be(true))
+    end
+
+    it "doesn't replace a profile image uploaded with Active Storage" do
+      legacy.update!(profile_image: Rack::Test::UploadedFile.new(jpeg_path, "image/jpeg"))
+      blob = legacy.reload.avatar.blob
+
+      expect(copy[legacy.class]).to have_attributes(copied: 0, skipped: 1)
+      expect(legacy.reload.avatar.blob).to eq(blob)
+      expect(legacy.avatar.download).to eq(File.binread(jpeg_path))
+    end
+
+    it "doesn't replace a profile image uploaded while it's copying" do
+      copier = new_copier
+      allow(copier).to receive(:upload_blob).and_wrap_original do |method, *args|
+        blob = method.call(*args)
+        model.find(legacy.id).update!(profile_image: Rack::Test::UploadedFile.new(jpeg_path, "image/jpeg"))
+        blob
+      end
+
+      expect(copier.call([model])[model]).to have_attributes(copied: 0, skipped: 1)
+      expect(legacy.reload.avatar.download).to eq(File.binread(jpeg_path))
+      expect(ActiveStorage::Blob.count).to eq(2) # the copy is purged later
+      expect(ActiveStorage::PurgeJob).to have_been_enqueued
+    end
+
+    it "re-copies images changed through CarrierWave after being copied (e.g. by the previous release)",
+       :aggregate_failures do
+      copy
+      old_blob = legacy.reload.avatar.blob
+
+      # What the previous release does when a new image is uploaded.
+      changed = with_carrierwave_profile_image(legacy, path: jpeg_path)
+      # The copy is outdated, and not shown.
+      expect(changed.profile_image_url).to be_nil
+
+      expect(copy[model].copied).to eq(1)
+      changed.reload
+      expect(changed.avatar.blob).not_to eq(old_blob)
+      expect(changed.avatar.download).to eq(File.binread(jpeg_path))
+      expect(changed.profile_image_url).to include("/rails/active_storage/blobs/redirect/")
+      expect(ActiveStorage::Attachment.where(record: changed).count).to eq(1)
+      expect(ActiveStorage::PurgeJob).to have_been_enqueued.with(old_blob)
+    end
+
+    it "leaves records alone when their CarrierWave file is missing", :aggregate_failures do
+      File.delete(carrierwave_path)
+
+      expect(copy[model]).to have_attributes(missing: 1, copied: 0)
+      expect(legacy.reload.avatar).not_to be_attached
+      expect(legacy.profile_image_url).to be_nil
+    end
+
+    it "reports failures, keeps going, and leaves nothing behind", :aggregate_failures do
+      other = create_legacy_from(create(factory))
+      uploads = 0
+      allow(ActiveStorage::Blob.service).to receive(:upload).and_wrap_original do |method, *args, **options|
+        uploads += 1
+        raise Errno::ECONNRESET if uploads == 1
+
+        method.call(*args, **options)
+      end
+
+      expect(copy[model]).to have_attributes(failed: 1, copied: 1)
+      expect([legacy, other].count { |record| record.reload.avatar.attached? }).to eq(1)
+      expect(ActiveStorage::Blob.count).to eq(1)
+
+      expect(copy[model]).to have_attributes(copied: 1, skipped: 1, failed: 0)
+    end
+
+    it "ignores records without a profile image" do
+      legacy.update_column(:profile_image, nil)
+      expect(copy[model].total).to eq(0)
+    end
+
+    it "keeps the extension of animated images" do
+      gif = create_legacy_from(create(factory), path: Rails.root.join("spec/support/fixtures/images/image.gif"),
+                                                content_type: "image/gif")
+      copy
+      expect(gif.reload.avatar.blob.key).to end_with(".gif")
+      expect(gif.profile_image_url).to end_with("/profile_image.gif")
+    end
+  end
+
+  # Turns a record into one with only a CarrierWave profile image.
+  def create_legacy_from(record, **options)
+    record.avatar.purge if record.avatar.attached?
+    with_carrierwave_profile_image(record.class.find(record.id), **options)
+  end
+
+  it "copies the profile images of both users and organizations" do
+    create_legacy(:user)
+    create_legacy(:organization)
+
+    expect(copy.transform_values(&:copied)).to eq(User => 1, Organization => 1)
+  end
+
+  describe User do
+    include_examples "copying profile images", :user
+  end
+
+  describe Organization do
+    include_examples "copying profile images", :organization
+  end
+
+  describe "bin/rails profile_images:copy", type: :task do
+    before do
+      Rake.application.rake_require("tasks/profile_images") unless Rake::Task.task_defined?("profile_images:copy")
+      Rake::Task["profile_images:copy"].reenable
+    end
+
+    it "copies the profile images" do
+      user = create_legacy(:user)
+      expect { Rake::Task["profile_images:copy"].invoke }.to output(/User: 1 copied/).to_stdout_from_any_process
+      expect(user.reload.avatar).to be_attached
+    end
+
+    it "fails when some images couldn't be copied, so that it's run again" do
+      create_legacy(:user)
+      allow(ActiveStorage::Blob.service).to receive(:upload).and_raise(Errno::ECONNRESET)
+
+      expect { Rake::Task["profile_images:copy"].invoke }
+        .to raise_error(SystemExit).and output(/1 failed/).to_stdout_from_any_process
+    end
+  end
+end
