@@ -0,0 +1,99 @@
+require "rails_helper"
+require "active_storage/service/fog_service"
+
+RSpec.describe ActiveStorage::Service::FogService do
+  subject(:service) do
+    described_class.new(bucket: bucket, credentials: credentials, public: public_service,
+                        upload: { cache_control: "public, max-age=60" })
+  end
+
+  let(:bucket) { "forem-test-bucket" }
+  let(:public_service) { false }
+  let(:credentials) do
+    { provider: "AWS", aws_access_key_id: "id", aws_secret_access_key: "secret", region: "us-east-1" }
+  end
+  let(:key) { "profile_images/#{SecureRandom.base36(28)}.png" }
+  let(:data) { "some image bytes" }
+  let(:fog) { Fog::Storage.new(credentials) }
+
+  around do |example|
+    Fog.mock!
+    example.run
+  ensure
+    Fog::Mock.reset
+    Fog.unmock!
+  end
+
+  before do
+    fog.directories.create(key: bucket)
+    service.name = :amazon
+  end
+
+  it "is built from config/storage.yml's `service: Fog`" do
+    configurator = ActiveStorage::Service::Configurator.new(
+      amazon: { service: "Fog", bucket: bucket, public: true, credentials: credentials },
+    )
+    built = configurator.build(:amazon)
+
+    expect(built).to be_a(described_class)
+    expect(built).to be_public
+  end
+
+  it "uploads, checks, downloads and deletes files", :aggregate_failures do
+    checksum = OpenSSL::Digest::MD5.base64digest(data)
+    service.upload(key, StringIO.new(data), checksum: checksum, content_type: "image/png")
+
+    expect(service.exist?(key)).to be(true)
+    expect(service.download(key)).to eq(data)
+    expect(fog.head_object(bucket, key).headers["Content-Type"]).to eq("image/png")
+
+    chunks = []
+    service.download(key) { |chunk| chunks << chunk }
+    expect(chunks.join).to eq(data)
+
+    service.delete(key)
+    expect(service.exist?(key)).to be(false)
+  end
+
+  it "raises FileNotFoundError for missing files" do
+    expect { service.download("missing") }.to raise_error(ActiveStorage::FileNotFoundError)
+  end
+
+  it "deletes files by prefix" do
+    service.upload("prefix/a.png", StringIO.new(data))
+    service.upload("prefix/b.png", StringIO.new(data))
+    service.upload("other/c.png", StringIO.new(data))
+
+    service.delete_prefixed("prefix/")
+
+    expect([service.exist?("prefix/a.png"), service.exist?("prefix/b.png"), service.exist?("other/c.png")])
+      .to eq([false, false, true])
+  end
+
+  context "when private" do
+    it "generates signed, expiring URLs" do
+      url = service.url(key, expires_in: 5.minutes, filename: ActiveStorage::Filename.new("profile_image.png"),
+                             disposition: :inline, content_type: "image/png")
+
+      expect(url).to start_with("https://").and include(bucket).and include(key)
+      expect(url).to include("X-Amz-Expires").or include("Expires")
+    end
+  end
+
+  context "when public" do
+    let(:public_service) { true }
+
+    it "uploads publicly readable files" do
+      service.upload(key, StringIO.new(data))
+      expect(fog.get_object_acl(bucket, key).body["AccessControlList"].to_s).to include("READ")
+    end
+
+    it "generates permanent URLs" do
+      url = service.url(key, filename: ActiveStorage::Filename.new("profile_image.png"), disposition: :inline,
+                             content_type: "image/png")
+
+      expect(url).to start_with("https://").and include(bucket).and end_with(key)
+      expect(url).not_to include("Expires")
+    end
+  end
+end
