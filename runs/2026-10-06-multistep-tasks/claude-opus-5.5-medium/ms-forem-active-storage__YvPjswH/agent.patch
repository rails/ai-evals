@@ -0,0 +1,50 @@
+require "rails_helper"
+
+RSpec.describe "Profile images copied to Active Storage" do
+  let(:jpeg_path) { Rails.root.join("spec/support/fixtures/images/image2.jpeg") }
+
+  it "are served from their Active Storage URL" do
+    user = build(:user, profile_image: nil).tap { |record| record.save!(validate: false) }
+    uploader = ProfileImageUploader.new(user, :profile_image)
+    uploader.store!(Rack::Test::UploadedFile.new(jpeg_path, "image/jpeg"))
+    user.update_column(:profile_image, uploader.identifier)
+
+    Images::ProfileImageCopier.call(models: [User], logger: Logger.new(File::NULL))
+    url = User.find(user.id).profile_image_url
+
+    get URI(url).path
+    expect(response).to have_http_status(:redirect)
+
+    get URI(response.location).request_uri
+    expect(response).to have_http_status(:ok)
+    expect(response.body.b).to eq(File.binread(jpeg_path))
+  end
+end
+
+RSpec.describe "Uploading a profile image" do
+  let(:user) { create(:user) }
+  let(:jpeg_path) { Rails.root.join("spec/support/fixtures/images/image2.jpeg") }
+
+  before { sign_in user }
+
+  # The onboarding reads `user.profile_image.url` from the response, like it did with CarrierWave.
+  it "returns the new image's URL in the JSON shape of the former CarrierWave uploader", :aggregate_failures do
+    put user_path(user), params: { user: { profile_image: Rack::Test::UploadedFile.new(jpeg_path, "image/jpeg") } },
+                         headers: { "Accept" => "application/json" }
+
+    expect(response).to have_http_status(:ok)
+    url = response.parsed_body.dig("user", "profile_image", "url")
+    expect(url).to eq(user.reload.profile_image_url)
+    expect(url).to include("/rails/active_storage/blobs/redirect/")
+    expect(user.avatar.download).to eq(File.binread(jpeg_path))
+  end
+
+  it "reports invalid images" do
+    text_file = Tempfile.new(["not_an_image", ".txt"]).tap { |f| f.write("hello") && f.rewind }
+    put user_path(user), params: { user: { profile_image: Rack::Test::UploadedFile.new(text_file.path, "text/plain") } },
+                         headers: { "Accept" => "application/json" }
+
+    expect(response).to have_http_status(:bad_request)
+    expect(response.parsed_body["error"]).to include("Image has an unsupported type")
+  end
+end
