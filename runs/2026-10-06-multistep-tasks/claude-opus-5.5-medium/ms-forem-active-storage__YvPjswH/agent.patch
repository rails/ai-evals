+++ b/lib/tasks/profile_images.rake
@@ -0,0 +1,15 @@
+namespace :profile_images do
+  desc "Copy the legacy (CarrierWave) profile images of users and organizations to Active Storage, " \
+       "where they are served from (also done by a migration; safe to run while serving, and to run again)"
+  task copy: :environment do
+    logger = ActiveSupport::Logger.new($stdout)
+
+    results = Images::ProfileImageCopier.call(logger: logger)
+
+    failed = results.values.sum(&:failed)
+    if failed.positive?
+      abort("#{failed} profile images could not be copied (see the log above); run `bin/rails profile_images:copy` " \
+            "again to retry them.")
+    end
+  end
+end
diff --git a/spec/db/migrate/copy_remaining_profile_images_to_active_storage_spec.rb b/spec/db/migrate/copy_remaining_profile_images_to_active_storage_spec.rb
new file mode 100644
index 0000000..083a799
--- /dev/null
+++ b/spec/db/migrate/copy_remaining_profile_images_to_active_storage_spec.rb
@@ -0,0 +1,56 @@
+require "rails_helper"
+require Rails.root.join("db/migrate/20261008120000_copy_remaining_profile_images_to_active_storage.rb")
+
+RSpec.describe CopyRemainingProfileImagesToActiveStorage do
+  let(:jpeg_path) { Rails.root.join("spec/support/fixtures/images/image2.jpeg") }
+
+  # A record whose profile image is still only in CarrierWave (not copied yet).
+  def create_legacy(factory)
+    record = build(factory, profile_image: nil).tap { |r| r.save!(validate: false) }
+    uploader = ProfileImageUploader.new(record, :profile_image)
+    uploader.store!(Rack::Test::UploadedFile.new(jpeg_path, "image/jpeg"))
+    record.update_column(:profile_image, uploader.identifier)
+    record.class.find(record.id)
+  end
+
+  def migrate
+    ActiveRecord::Migration.suppress_messages { described_class.new.migrate(:up) }
+  end
+
+  it "copies the profile images left in CarrierWave, so they keep being shown", :aggregate_failures do
+    user = create_legacy(:user)
+    organization = create_legacy(:organization)
+    expect(user.profile_image_url).to be_nil
+
+    expect { migrate }.to output(/User: 1 copied.*Organization: 1 copied/m).to_stdout_from_any_process
+
+    [user, organization].each do |record|
+      record.reload
+      expect(record.avatar.download).to eq(File.binread(jpeg_path))
+      expect(record.profile_image_url).to include("/rails/active_storage/blobs/redirect/")
+    end
+  end
+
+  it "skips images already copied" do
+    user = create_legacy(:user)
+    Images::ProfileImageCopier.call(models: [User], logger: Logger.new(File::NULL))
+    blob = user.reload.avatar.blob
+
+    expect { migrate }.to output(/User: 0 copied, 1 already in Active Storage/).to_stdout_from_any_process
+    expect(user.reload.avatar.blob).to eq(blob)
+  end
+
+  it "fails (and so does the release) when some images can't be copied" do
+    create_legacy(:user)
+    allow(ActiveStorage::Blob.service).to receive(:upload).and_raise(Errno::ECONNRESET)
+
+    expect { migrate }.to raise_error(/1 profile images could not be copied/).and output.to_stdout_from_any_process
+  end
+
+  it "doesn't fail for records whose legacy file doesn't exist (they have nothing to show)" do
+    user = create(:user)
+    user.update_column(:profile_image, Moderator::BanishUser::DEFAULT_PROFILE_IMAGE)
+
+    expect { migrate }.to output(/1 without a CarrierWave file, 0 failed/).to_stdout_from_any_process
+  end
+end
