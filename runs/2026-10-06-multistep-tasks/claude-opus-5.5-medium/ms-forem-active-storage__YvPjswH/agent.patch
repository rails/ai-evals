+require "rails_helper"
+
+RSpec.describe ProfileImageStorage do
+  let(:jpeg_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+  let(:other_jpeg_path) { Rails.root.join("spec/support/fixtures/images/image2.jpeg") }
+  let(:upload) { Rack::Test::UploadedFile.new(jpeg_path, "image/jpeg") }
+
+  # A record with a legacy profile image, stored by CarrierWave before profile images moved to
+  # Active Storage, and not copied yet.
+  def with_legacy_profile_image(record, path: other_jpeg_path)
+    uploader = ProfileImageUploader.new(record, :profile_image)
+    uploader.store!(Rack::Test::UploadedFile.new(path, "image/jpeg"))
+    record.update_column(:profile_image, uploader.identifier)
+    record.class.find(record.id)
+  end
+
+  def create_without_profile_image(factory)
+    build(factory, profile_image: nil).tap { |record| record.save!(validate: false) }
+  end
+
+  shared_examples "a record with a profile image" do |factory|
+    let(:record) { create(factory, profile_image: upload) }
+
+    it "doesn't use CarrierWave" do
+      expect(record.class.uploaders).not_to have_key(:profile_image)
+    end
+
+    describe "new profile images" do
+      it "are stored with Active Storage", :aggregate_failures do
+        expect(record.avatar).to be_attached
+        expect(record.avatar.download).to eq(File.binread(jpeg_path))
+        expect(record.read_attribute(:profile_image)).to be_nil
+        expect(record.profile_image_present?).to be(true)
+      end
+
+      it "don't expose the name of the uploaded file, and keep its extension", :aggregate_failures do
+        blob = record.avatar.blob
+        expect(blob.filename.to_s).to eq("profile_image.jpeg")
+        expect(blob.key).to start_with("profile_images/").and end_with(".jpeg")
+        expect(blob.content_type).to eq("image/jpeg")
+        expect(blob.service.exist?(blob.key)).to be(true)
+      end
+
+      it "are served from a permanent, absolute URL", :aggregate_failures do
+        url = record.profile_image_url
+        expect(url).to start_with(URL.url)
+        expect(url).to include("/rails/active_storage/blobs/redirect/")
+        expect(url).to end_with("/profile_image.jpeg")
+        expect(Rails.application.routes.recognize_path(URI(url).path))
+          .to include(controller: "active_storage/blobs/redirect", action: "show")
+        expect(record.profile_image_url_for(length: 90)).to include(CGI.escape(url)).or include(url)
+      end
+
+      it "are served by the web server when stored under public/ (local storage in production)" do
+        service = ActiveStorage::Service::DiskService.new(root: Rails.public_path.join("uploads/active_storage"))
+        allow(record.avatar.blob).to receive(:service).and_return(service)
+
+        expect(record.profile_image_url)
+          .to eq(URL.url("/uploads/active_storage/#{service.__send__(:folder_for, record.avatar.blob.key)}/" \
+                         "#{record.avatar.blob.key}"))
+      end
+
+      it "use the public URL of public services" do
+        allow(record.avatar.blob.service).to receive(:public?).and_return(true)
+        expect(record.profile_image_url).to start_with(URL.url).and include("/rails/active_storage/disk/")
+      end
+
+      it "accept files and IOs", :aggregate_failures do
+        [
+          File.open(other_jpeg_path),
+          Pathname.new(other_jpeg_path),
+          ActionDispatch::Http::UploadedFile.new(tempfile: File.open(other_jpeg_path), filename: "me.jpeg",
+                                                 type: "image/jpeg"),
+          Images::ProfileImageGenerator.call,
+        ].each do |file|
+          record.update!(profile_image: file)
+          expect(record.reload.avatar.blob.filename.to_s).to match(/\Aprofile_image\.(jpeg|png)\z/)
+        end
+      end
+
+      it "are validated", :aggregate_failures do
+        text_file = Tempfile.new(["not_an_image", ".txt"]).tap { |f| f.write("hello") && f.rewind }
+        invalid = build(factory, profile_image: Rack::Test::UploadedFile.new(text_file.path, "text/plain"))
+
+        expect(invalid).not_to be_valid
+        expect(invalid.errors[:profile_image]).to include("Image has an unsupported type")
+        expect(invalid.avatar).not_to be_attached
+      end
+
+      it "are rejected with a disallowed extension" do
+        renamed = Tempfile.new(["image", ".exe"]).tap { |f| f.binmode && f.write(File.binread(jpeg_path)) && f.rewind }
+        record.profile_image = Rack::Test::UploadedFile.new(renamed.path, "image/jpeg")
+
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image].first).to start_with("You are not allowed to upload \"exe\" files")
+      end
+
+      it "are rejected when too large" do
+        record
+        stub_const("Images::ProfileImageProcessor::MAX_FILE_SIZE", 10)
+        record.profile_image = Rack::Test::UploadedFile.new(other_jpeg_path, "image/jpeg")
+
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image].first).to start_with("File size should be less than")
+      end
+
+      it "keep the current image when the new one is invalid" do
+        blob = record.avatar.blob
+        record.profile_image = Rack::Test::UploadedFile.new(Rails.root.join("spec/fixtures/files/800x600.pdf"))
+
+        expect(record.save).to be(false)
+        expect(record.reload.avatar.blob).to eq(blob)
+      end
+
+      it "can be downloaded from a remote URL", :aggregate_failures do
+        stub_request(:get, "https://example.com/avatar")
+          .to_return(status: 200, body: File.binread(other_jpeg_path), headers: { "Content-Type" => "image/jpeg" })
+
+        record.remote_profile_image_url = "https://example.com/avatar"
+        record.save!
+        record.reload
+
+        expect(record.avatar.download).to eq(File.binread(other_jpeg_path))
+        expect(record.avatar.blob.filename.to_s).to eq("profile_image.jpg") # extension from the content type
+        expect(record.read_attribute(:profile_image)).to be_nil
+      end
+
+      it "report download errors as validation errors" do
+        stub_request(:get, "https://example.com/missing.jpeg").to_return(status: 404)
+
+        record.remote_profile_image_url = "https://example.com/missing.jpeg"
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image].first).to start_with("could not download file")
+      end
+
+      it "ignore blank remote URLs" do
+        record.remote_profile_image_url = ""
+        expect(record).to be_valid
+        expect(record.reload.avatar).to be_attached
+      end
+
+      it "replace the previous image" do
+        old_blob = record.avatar.blob
+        record.update!(profile_image: Rack::Test::UploadedFile.new(other_jpeg_path, "image/jpeg"))
+
+        expect(record.reload.avatar.blob).not_to eq(old_blob)
+        expect(record.avatar.download).to eq(File.binread(other_jpeg_path))
+        expect(ActiveStorage::Attachment.where(record: record).count).to eq(1)
+      end
+
+      it "count as a change of the profile image and of the record", :aggregate_failures do
+        record.update_column(:updated_at, 1.day.ago)
+        record.reload
+
+        expect do
+          record.update!(profile_image: Rack::Test::UploadedFile.new(other_jpeg_path, "image/jpeg"))
+        end.to change(record, :updated_at)
+        expect(record.saved_change_to_profile_image?).to be(true)
+
+        record.update!(name: "Something else")
+        expect(record.saved_change_to_profile_image?).to be(false)
+      end
+    end
+
+    describe "#profile_image" do
+      it "has the interface of the former CarrierWave uploader", :aggregate_failures do
+        image = record.profile_image
+        expect(image.url).to eq(record.profile_image_url)
+        expect(image.to_s).to eq(record.profile_image_url)
+        expect(image).to be_present
+        expect(image.as_json).to eq("url" => record.profile_image_url)
+        expect(JSON.parse(record.to_json)["profile_image"]).to eq("url" => record.profile_image_url)
+      end
+
+      it "is blank without an image", :aggregate_failures do
+        image = create_without_profile_image(factory).profile_image
+        expect(image).to be_blank
+        expect(image.url).to be_nil
+        expect(image.as_json).to eq("url" => nil)
+      end
+
+      it "ignores strings, which aren't files" do
