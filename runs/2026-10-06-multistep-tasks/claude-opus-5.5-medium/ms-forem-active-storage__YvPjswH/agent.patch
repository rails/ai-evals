+      Images::ProfileImageCopier.new(logger: Logger.new(File::NULL)).copy(legacy.class.find(legacy.id))
+
+      legacy.update!(profile_image: upload)
+
+      expect(ActiveStorage::Attachment.where(record: legacy).count).to eq(1)
+      expect(legacy.reload.avatar.download).to eq(File.binread(jpeg_path))
+    end
+
+    describe "removing the profile image" do
+      it "removes the image", :aggregate_failures do
