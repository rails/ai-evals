+        identifier = legacy[:profile_image]
+        path = ProfileImageUploader.new(legacy, :profile_image).tap { |u| u.retrieve_from_store!(identifier) }.path
+
+        legacy.update!(profile_image: upload)
+        legacy.reload
+
+        expect(legacy[:profile_image]).to eq(identifier)
+        expect(File.exist?(path)).to be(true)
+        expect(legacy.profile_image_url).to include("/rails/active_storage/blobs/redirect/")
+      end
+    end
+
+    describe "compatibility with the previous release" do
+      let!(:legacy) { with_legacy_profile_image(create_without_profile_image(factory)) }
+
+      before { legacy.update!(profile_image: upload) }
+
+      it "records which legacy image the Active Storage one supersedes" do
+        expect(legacy.reload.avatar.blob.metadata[ProfileImageStorage::SUPERSEDED_IDENTIFIER_KEY])
