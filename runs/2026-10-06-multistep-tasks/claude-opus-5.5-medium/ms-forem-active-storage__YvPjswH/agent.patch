+        legacy.profile_image = ""
+        legacy.save(validate: false)
+
+        expect(legacy.reload[:profile_image]).to be_nil
+        expect(legacy.avatar).not_to be_attached
+      end
+
+      it "works without saving the record" do
+        record.purge_profile_image!
+        expect(record.class.find(record.id).profile_image_url).to be_nil
+      end
+    end
+
+    it "purges the Active Storage image when destroyed" do
+      record
+      expect { record.destroy }.to have_enqueued_job(ActiveStorage::PurgeJob)
+    end
+
+    it "works with partial selects that include the id", :aggregate_failures do
+      record
+      expect(record.class.select(:id, :profile_image).find(record.id).profile_image_url).to eq(record.profile_image_url)
+      expect(record.class.select(:id).find(record.id).profile_image_url).to eq(record.profile_image_url)
