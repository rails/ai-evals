index 0000000..6c8af1c
--- /dev/null
+++ b/spec/models/concerns/profile_image_storage_spec.rb
@@ -0,0 +1,219 @@
+require "rails_helper"
+
+RSpec.describe ProfileImageStorage do
+  let(:jpeg_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+  let(:other_jpeg_path) { Rails.root.join("spec/support/fixtures/images/image2.jpeg") }
+  let(:upload) { Rack::Test::UploadedFile.new(jpeg_path, "image/jpeg") }
+
+  # A record with a profile image stored by CarrierWave, i.e. one uploaded before profile images
+  # moved to Active Storage.
+  def with_carrierwave_profile_image(record, path: other_jpeg_path)
+    uploader = ProfileImageUploader.new(record, :profile_image)
+    uploader.store!(Rack::Test::UploadedFile.new(path, "image/jpeg"))
+    record.update_column(:profile_image, uploader.identifier)
+    record.class.find(record.id)
+  end
+
+  def create_without_profile_image(factory)
+    build(factory, profile_image: nil).tap { |record| record.save!(validate: false) }
+  end
+
+  shared_examples "a record with a profile image" do |factory|
+    let(:record) { create(factory, profile_image: upload) }
+
+    describe "new profile images" do
+      it "are stored with Active Storage, not with CarrierWave", :aggregate_failures do
+        expect(record.avatar).to be_attached
+        expect(record.avatar.download).to eq(File.binread(jpeg_path))
+        expect(record.read_attribute(:profile_image)).to be_nil
+        expect(record.profile_image).to be_blank
+        expect(record.profile_image_present?).to be(true)
+      end
+
+      it "don't expose the name of the uploaded file, and keep its extension", :aggregate_failures do
+        blob = record.avatar.blob
+        expect(blob.filename.to_s).to eq("profile_image.jpeg")
+        expect(blob.key).to start_with("profile_images/").and end_with(".jpeg")
+        expect(blob.service.exist?(blob.key)).to be(true)
+      end
+
+      it "are served from a permanent, absolute URL", :aggregate_failures do
+        url = record.profile_image_url
+        expect(url).to start_with(URL.url)
+        expect(url).to include("/rails/active_storage/blobs/redirect/")
+        expect(url).to end_with("/profile_image.jpeg")
+        expect(Rails.application.routes.recognize_path(URI(url).path))
+          .to include(controller: "active_storage/blobs/redirect", action: "show")
+        expect(record.profile_image_url_for(length: 90)).to include(CGI.escape(url)).or include(url)
+      end
+
+      it "are served by the web server when stored under public/ (local storage in production)" do
+        service = ActiveStorage::Service::DiskService.new(root: Rails.public_path.join("uploads/active_storage"))
+        allow(record.avatar.blob).to receive(:service).and_return(service)
+
+        expect(record.profile_image_url)
+          .to eq(URL.url("/uploads/active_storage/#{service.__send__(:folder_for, record.avatar.blob.key)}/" \
+                         "#{record.avatar.blob.key}"))
+      end
+
+      it "use the public URL of public services" do
+        allow(record.avatar.blob.service).to receive(:public?).and_return(true)
+        expect(record.profile_image_url).to start_with(URL.url).and include("/rails/active_storage/disk/")
+      end
+
+      it "go through ProfileImageUploader's validations" do
+        text_file = Tempfile.new(["not_an_image", ".txt"]).tap { |f| f.write("hello") && f.rewind }
+        record = build(factory, profile_image: Rack::Test::UploadedFile.new(text_file.path, "text/plain"))
+
+        expect(record).not_to be_valid
+        expect(record.errors[:profile_image]).to be_present
+        expect(record.avatar).not_to be_attached
+      end
+
+      it "can be downloaded from a remote URL", :aggregate_failures do
+        stub_request(:get, "https://example.com/avatar.jpeg")
+          .to_return(status: 200, body: File.binread(other_jpeg_path), headers: { "Content-Type" => "image/jpeg" })
+
+        record.remote_profile_image_url = "https://example.com/avatar.jpeg"
+        record.save!
+        record.reload
+
+        expect(record.avatar.download).to eq(File.binread(other_jpeg_path))
+        expect(record.read_attribute(:profile_image)).to be_nil
+      end
+
+      it "replace the previous Active Storage image" do
+        old_blob = record.avatar.blob
+        record.update!(profile_image: Rack::Test::UploadedFile.new(other_jpeg_path, "image/jpeg"))
+
+        expect(record.reload.avatar.blob).not_to eq(old_blob)
+        expect(record.avatar.download).to eq(File.binread(other_jpeg_path))
+      end
+
+      it "count as a change of the profile image and of the record", :aggregate_failures do
+        record.update_column(:updated_at, 1.day.ago)
+        record.reload
+
+        expect do
+          record.update!(profile_image: Rack::Test::UploadedFile.new(other_jpeg_path, "image/jpeg"))
+        end.to change(record, :updated_at)
+        expect(record.saved_change_to_profile_image?).to be(true)
+
+        record.update!(name: "Something else")
+        expect(record.saved_change_to_profile_image?).to be(false)
+      end
+    end
+
+    describe "existing (CarrierWave) profile images" do
+      let!(:legacy) { with_carrierwave_profile_image(create_without_profile_image(factory)) }
+
+      it "keep being served from CarrierWave", :aggregate_failures do
+        expect(legacy.avatar).not_to be_attached
+        expect(legacy.profile_image_url).to eq(legacy.profile_image.url)
+        expect(legacy.profile_image_url).to include("/uploads/#{factory}/profile_image/#{legacy.id}/")
+        expect(legacy.profile_image_present?).to be(true)
+      end
+
+      it "stay untouched by unrelated updates" do
+        expect { legacy.update!(name: "New name") }.not_to(change { legacy.reload.read_attribute(:profile_image) })
+        expect(legacy.avatar).not_to be_attached
+      end
+
+      context "when a new profile image is uploaded" do
+        let!(:old_identifier) { legacy.read_attribute(:profile_image) }
+        let!(:old_path) { legacy.profile_image.path }
+        let!(:old_url) { legacy.profile_image.url }
+
+        before { legacy.update!(profile_image: upload) }
+
+        it "stores it with Active Storage and shows it", :aggregate_failures do
+          legacy.reload
+          expect(legacy.avatar.download).to eq(File.binread(jpeg_path))
+          expect(legacy.profile_image_url).to include("/rails/active_storage/blobs/redirect/")
+        end
+
+        it "keeps the CarrierWave image, which the previous release still shows", :aggregate_failures do
+          legacy.reload
+          expect(legacy.read_attribute(:profile_image)).to eq(old_identifier)
+          expect(File.exist?(old_path)).to be(true)
+          # What the previous release reads
+          expect(legacy.profile_image.url).to eq(old_url)
+        end
+      end
+    end
+
+    describe "removing the profile image" do
+      it "removes the Active Storage image like the CarrierWave one", :aggregate_failures do
+        record.profile_image = nil
+        expect(record.profile_image_present?).to be(false)
+
+        record.save(validate: false)
+        expect(record.reload.avatar).not_to be_attached
+      end
+
+      it "keeps the profile image when assigning an identical CarrierWave identifier" do
+        legacy = with_carrierwave_profile_image(create_without_profile_image(factory))
+        legacy.profile_image = legacy.read_attribute(:profile_image)
+        legacy.save!
+
+        expect(legacy.reload.profile_image_present?).to be(true)
+      end
+    end
+
+    it "purges the Active Storage image when destroyed" do
+      record
+      expect { record.destroy }.to have_enqueued_job(ActiveStorage::PurgeJob)
+    end
+
+    it "works with partial selects that include the id" do
+      record
+      partial = record.class.select(:id, :profile_image).find(record.id)
+      expect(partial.profile_image_url).to eq(record.profile_image_url)
+    end
+  end
+
+  describe User do
+    include_examples "a record with a profile image", :user
+
+    it "busts the profile image cache when a new image is uploaded" do
+      user = create(:user)
