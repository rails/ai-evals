+require "application_system_test_case"
+
+class PrizesSystemTest < ApplicationSystemTestCase
+  setup { Capybara.default_max_wait_time = 8 }
+  teardown { Capybara.default_max_wait_time = 2 }
+
+  def player(name, &block) = Capybara.using_session(name, &block)
+
+  test "settings, leaderboard, phone results and picking winners" do
+    quiz = quizzes(:fest)
+    visit_moderate "/moderate/quizzes/#{quiz.id}/edit"
+    assert_field "Number of winners", with: "3"
+    fill_in "Number of winners", with: "1"
+    click_on "Save quiz"
+    assert_text "Quiz saved"
+    assert_equal 1, quiz.reload.winners_count
+
+    click_on "Start a game"
+    path = URI(find("[data-testid=join-link]").text).path
+    %w[Ann Ben Cy].each do |name|
+      player(name) { visit path; fill_in "Your name", with: name; click_on "Join"; assert_text "Hi, #{name}!" }
+    end
+    assert_text "Players: 3"
+
+    click_on "Start"
+    player("Ben") { click_on "429"; assert_text "Your answer" }
+    player("Ann") { click_on "429"; assert_text "Your answer" }
+    player("Cy") { click_on "418"; assert_text "Your answer" }
+    assert_text "Answers: 3 / 3"
+    click_on "Finish"
+    player("Ann") { assert_text "Correct!"; assert_no_text "point" }
+    click_on "Next"
+    player("Ann") { click_on "WebSocket"; assert_text "Your answer" }
+    player("Ben") { click_on "SMTP"; assert_text "Your answer" }
+    assert_text "Answers: 2 / 3"
+    click_on "Finish"
+    click_on "End quiz"
+
+    within("ol.leaderboard") do
+      items = all("li", count: 3)
+      assert_match(/1.*Ann.*2 points/m, items[0].text)
+      assert_match(/2.*Ben.*1 point\b/m, items[1].text)
+      assert_match(/3.*Cy.*0 points/m, items[2].text)
+    end
+    player("Ann") { assert_text "Place 1 of 3"; assert_text "2 points"; assert_no_text "You won!" }
+    player("Cy") { assert_text "Place 3 of 3"; assert_text "0 points" }
+
+    click_on "Top 1"
+    within("li", text: "Ann") { assert_text "Winner" }
+    within("li", text: "Ben") { assert_no_text "Winner" }
+    player("Ann") { assert_text "You won!" }
+    player("Ben") { assert_no_text "You won!" }
+
+    click_on "Reset winners"
+    assert_no_text "Winner"
+    player("Ann") { assert_no_text "You won!" }
+
+    click_on "Draw" # Ann has more points than anyone else
+    within("li", text: "Ann") { assert_text "Winner" }
+    player("Ann") { assert_text "You won!" }
+  end
+end
