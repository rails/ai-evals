+require "test_helper"
+
+class PrizesTest < ActiveSupport::TestCase
+  setup do
+    @quiz = quizzes(:fest)
+    @game = @quiz.games.create!
+    @t0 = Time.current.change(usec: 0)
+  end
+
+  # Runs at a fixed clock (travel_to drops sub-second precision).
+  def at(seconds, &) = travel_to(@t0 + seconds, &)
+
+  def join(name) = @game.players.create!(name: name, browser_token: name, last_seen_at: Time.current)
+
+  # answers: { player => [option for q1 or nil, option for q2 or nil] }, times: seconds after opening
+  def play(picks)
+    at(0) { @game.start!(@game.version) }
+    [ questions(:http), questions(:socket) ].each_with_index do |question, index|
+      base = index * 100
+      picks.each do |player, list|
+        option, seconds = list[index]
+        next unless option
+
+        at(base + seconds) { assert @game.record_answer!(player, question_id: question.id, option_id: option.id) }
+      end
+      at(base + 50) { @game.finish_question!(@game.version) }
+      at(base + 100) { @game.advance!(@game.version) }
+    end
+    assert @game.finished?
+  end
+
+  def names(rows) = rows.map { |row| row.player.name }
+  def winners = @game.players.reload.select(&:winner?).map(&:name).sort
+
+  test "winners_count defaults to 3 and must be at least 1" do
+    assert_equal 3, Quiz.new.winners_count
+    assert_not Quiz.new(title: "x", winners_count: 0).valid?
+    assert_not Quiz.new(title: "x", winners_count: 1.5).valid?
+    assert Quiz.new(title: "x", winners_count: 1).valid?
+  end
+
+  test "points first, then the total time of the correct answers; the time counts to the last pick" do
+    a, b, c, d = %w[Ann Bob Cat Dan].map { join(_1) }
+    right1, wrong1, right2, wrong2 = options(:http_b), options(:http_a), options(:socket_a), options(:socket_b)
+    base = 0
+    at(0) { @game.start!(@game.version) }
+    at(base + 1) { @game.record_answer!(a, question_id: questions(:http).id, option_id: right1.id) }
+    at(base + 2) { @game.record_answer!(b, question_id: questions(:http).id, option_id: right1.id) }
+    at(base + 0.5) { @game.record_answer!(c, question_id: questions(:http).id, option_id: right1.id) }
+    # Cat changes her mind and comes back: her time is her last pick.
+    at(base + 3) { @game.record_answer!(c, question_id: questions(:http).id, option_id: wrong1.id) }
+    at(base + 4) { @game.record_answer!(c, question_id: questions(:http).id, option_id: right1.id) }
+    at(50) { @game.finish_question!(@game.version) }
+    at(100) { @game.advance!(@game.version) }
+    base = 100
+    at(base + 5) { @game.record_answer!(a, question_id: questions(:socket).id, option_id: wrong2.id) }
+    at(base + 1) { @game.record_answer!(b, question_id: questions(:socket).id, option_id: right2.id) }
+    @game.finish_question!(@game.version)
+    @game.advance!(@game.version)
+
+    rows = @game.leaderboard
+    assert_equal %w[Bob Ann Cat Dan], names(rows)
+    assert_equal [ 2, 1, 1, 0 ], rows.map(&:points)
+    assert_equal [ 3000, 1000, 4000, 0 ], rows.map(&:time_ms) # wrong answers don't add time
+    assert_equal [ 1, 2, 3, 4 ], rows.map(&:place)
+  end
+
+  test "Top N, Draw and Reset" do
+    @quiz.update!(winners_count: 2)
+    a, b, c, d, e = %w[Ann Bob Cat Dan Eve].map { join(_1) }
+    r1, r2, w2 = options(:http_b), options(:socket_a), options(:socket_b)
+    play(a => [ [ r1, 1 ], [ r2, 1 ] ], b => [ [ r1, 3 ], [ w2, 1 ] ], c => [ [ r1, 1 ] ], d => [ [ r1, 2 ] ], e => [])
+
+    assert_equal %w[Ann Cat Dan Bob Eve], names(@game.leaderboard)
+    @game.pick_top_winners!
+    assert_equal %w[Ann Cat], winners
+
+    seen = Set.new
+    20.times do |i|
+      @game.draw_winners!(random: Random.new(i))
+      w = winners
+      assert_includes w, "Ann"
+      assert_equal 2, w.size
+      seen << w
+    end
+    assert_equal [ %w[Ann Bob], %w[Ann Cat], %w[Ann Dan] ].to_set, seen, "draws among all 1-point players"
+
+    version = @game.version
+    @game.reset_winners!
+    assert_empty winners
+    assert_operator @game.version, :>, version
+  end
+
+  test "0-point players never win; fewer scorers than prizes: all of them win" do
+    a, b, c = %w[Ann Bob Cat].map { join(_1) }
+    play(a => [ [ options(:http_b), 1 ] ], b => [ [ options(:http_a), 1 ] ], c => [])
+    @game.pick_top_winners!
+    assert_equal %w[Ann], winners
+    @game.draw_winners!
+    assert_equal %w[Ann], winners
+  end
+
+  test "winners can only be picked after the end" do
+    join("Ann")
+    @game.start!(@game.version)
+    assert_not @game.pick_top_winners!
+  end
+end
