diff --git a/docs/notes.md b/docs/notes.md
index a5a9a45..c2bb765 100644
--- a/docs/notes.md
+++ b/docs/notes.md
@@ -107,3 +107,19 @@
 - Measured with `bin/serve` (production, Solid Cable polling 0.1 s) and 4 phones: phones show the new
   question 0.1–0.35 s after the moderator's click.
 - In the test env the cable adapter is `test` (no delivery to browsers), so system tests only cover the polling fallback.
+
+## Question timer
+- `Quiz#timer_minutes` / `#timer_seconds` ("Timer minutes" / "Timer seconds" in Settings; integers ≥ 0, default 0;
+  seconds aren't capped at 59, 0:90 = 1:30). `Quiz#timer_duration` (seconds); 0 = no timer. Not in the export/import format.
+- `Game#question_deadline_at` is set by `start!`/`advance!` from the quiz settings at the moment the question opens
+  (snapshot: changing Settings mid-question only affects later questions). nil = no timer.
+- Expiry is lazy (no background worker): `Game#expire_timer!` = `finish_question!(version)` once past the deadline
+  (CAS, so it happens once and a later stale "Finish" click is a no-op). Called in `set_game` of both
+  `Moderate::GamesController` (screen, its `status` poll, buttons) and `PlayController` (phones, pings, answers).
+  `record_answer!` also refuses answers at/after the deadline.
+- Big screen: `[data-testid=countdown]` (`role=timer`), rendered only while open, text M:SS rounded up
+  (`countdown_label`). `countdown_controller.js` gets the *remaining ms* from the server (so reloads don't restart it
+  and client clock skew doesn't matter), ticks every 200 ms, and at 0:00 dispatches `countdown:expired` →
+  `live#check` (repeats each second) → the status request closes the question → version changes → morph refresh.
+  Players never see the timer.
+- Tests: `test/models/timer_test.rb`, `test/system/timer_test.rb`.
diff --git a/test/models/timer_test.rb b/test/models/timer_test.rb
new file mode 100644
index 0000000..fbe1782
--- /dev/null
+++ b/test/models/timer_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class TimerTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    @quiz = quizzes(:fest)
+    @game = @quiz.games.create!
+    @alice = @game.players.create!(name: "Alice", browser_token: "a", last_seen_at: Time.current)
+  end
+
+  test "defaults to no timer and validates the fields" do
+    assert_equal [ 0, 0 ], [ @quiz.timer_minutes, @quiz.timer_seconds ]
+    assert_not @quiz.timer?
+    @quiz.timer_seconds = -1
+    assert_not @quiz.valid?
+    @quiz.timer_seconds = 1.5
+    assert_not @quiz.valid?
+    @quiz.assign_attributes(timer_minutes: 1, timer_seconds: 30)
+    assert @quiz.valid?
+    assert_equal 90, @quiz.timer_duration
+  end
+
+  test "without a timer the question stays open" do
+    @game.start!(@game.version)
+    assert_nil @game.question_deadline_at
+    assert_nil @game.timer_remaining_ms
+    travel 1.hour do
+      assert_not @game.expire_timer!
+      assert @game.open?
+    end
+  end
+
+  test "the question finishes by itself at 0:00 and refuses late answers" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 5)
+    freeze_time do
+      @game.start!(@game.version)
+      assert_equal 5000, @game.timer_remaining_ms
+      travel 4.seconds
+      assert_not @game.expire_timer!
+      assert @game.record_answer!(@alice, question_id: questions(:http).id, option_id: options(:http_a).id)
+      travel 1.second
+      assert_not @game.record_answer!(@alice, question_id: questions(:http).id, option_id: options(:http_b).id)
+      version = @game.version
+      assert @game.expire_timer!
+      assert @game.closed?
+      assert_equal version + 1, @game.version
+      assert_not @game.expire_timer!, "only once"
+      assert_not @game.finish_question!(version), "a stale Finish click is a no-op"
+
+      # Settings changed mid-game apply from the next question on.
+      @quiz.update!(timer_minutes: 2, timer_seconds: 0)
+      @game.advance!(@game.version)
+      assert_equal 120_000, @game.timer_remaining_ms
+      assert @game.finish_question!(@game.version), "Finish still works early"
+      assert_nil @game.timer_remaining_ms
+    end
+  end
+
+  test "the timer is not exported" do
+    @quiz.update!(timer_minutes: 1)
+    assert_no_match(/timer/, QuizTransfer.export_json(@quiz))
+  end
+end
diff --git a/test/system/timer_test.rb b/test/system/timer_test.rb
new file mode 100644
index 0000000..6ebd066
--- /dev/null
+++ b/test/system/timer_test.rb
@@ -0,0 +1,52 @@
+require "application_system_test_case"
+
+class TimerSystemTest < ApplicationSystemTestCase
+  setup { Capybara.default_max_wait_time = 8 }
+  teardown { Capybara.default_max_wait_time = 2 }
+
+  test "the countdown finishes the question by itself and survives a reload" do
+    quiz = quizzes(:fest)
+    visit_moderate "/moderate/quizzes/#{quiz.id}/edit"
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+    fill_in "Timer minutes", with: "1"
+    fill_in "Timer seconds", with: "30"
+    click_on "Save quiz"
+    assert_text "Quiz saved"
+    assert_equal 90, quiz.reload.timer_duration
+
+    click_on "Start a game"
+    path = URI(find("[data-testid=join-link]").text).path
+    Capybara.using_session("Ann") { visit path; fill_in "Your name", with: "Ann"; click_on "Join"; assert_text "Hi, Ann!" }
+    click_on "Start"
+    assert_selector "[data-testid=countdown]", text: /\A1:(30|29|28)\z/
+    Capybara.using_session("Ann") { assert_selector ".play-option"; assert_no_text(/\d:\d\d/) }
+
+    # Shorten the remaining time; a reload keeps the server's deadline.
+    game = quiz.games.last
+    game.update_columns(question_deadline_at: Time.current + 4.seconds)
+    visit current_path
+    assert_selector "[data-testid=countdown]", text: /\A0:0[2-4]\z/
+    sleep 1.5
+    visit current_path
+    assert_selector "[data-testid=countdown]", text: /\A0:0[0-3]\z/
+    assert_text "Correct", wait: 10 # results shown: finished by itself
+    assert_no_selector "[data-testid=countdown]"
+    assert_button "Next"
+    assert game.reload.closed?
+
+    click_on "Next"
+    assert_selector "[data-testid=countdown]", text: /\A1:(30|29|28)\z/
+    click_on "Finish"
+    assert_no_selector "[data-testid=countdown]"
+    assert_button "End quiz"
+  end
+
+  test "no timer by default" do
+    visit_moderate "/moderate/quizzes/#{quizzes(:fest).id}"
+    click_on "Start a game"
+    click_on "Start"
+    assert_button "Finish"
+    assert_no_selector "[data-testid=countdown]"
+  end
+end
