+  # --- Question timer ---
+
+  # True while the open question has a countdown.
+  def timer_running? = open? && question_deadline_at.present?
+
+  def timer_expired?(now = Time.current) = timer_running? && now >= question_deadline_at
+
+  # Milliseconds left on the open question's countdown (nil = no timer).
+  def timer_remaining_ms(now = Time.current)
+    return nil unless timer_running?
+
+    [ ((question_deadline_at - now) * 1000).ceil, 0 ].max
+  end
+
+  # At 0:00 the question finishes by itself, exactly like "Finish". Called
+  # lazily by every request that looks at the game (big screen, its status
+  # poll, phones, their pings), so it doesn't need a background worker.
+  # Returns true if this call closed the question.
+  def expire_timer!
+    return false unless timer_expired?
+
+    finish_question!(version)
+  end
+
