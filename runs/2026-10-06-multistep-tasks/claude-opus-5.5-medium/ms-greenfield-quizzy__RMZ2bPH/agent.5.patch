diff --git a/app/javascript/controllers/countdown_controller.js b/app/javascript/controllers/countdown_controller.js
new file mode 100644
index 0000000..93d0f60
--- /dev/null
+++ b/app/javascript/controllers/countdown_controller.js
@@ -0,0 +1,42 @@
+import { Controller } from "@hotwired/stimulus"
+
+// The big screen's question timer (M:SS). The server renders the time left
+// (it owns the deadline, so a reload doesn't restart the countdown and the
+// browser's clock doesn't matter). At 0:00 it dispatches "countdown:expired";
+// live_controller then checks the game, whose status request finishes the
+// question on the server. Repeats every second until the page changes.
+export default class extends Controller {
+  static values = { remaining: Number }
+
+  connect() {
+    this.timer = setInterval(() => this.tick(), 200)
+    this.tick()
+  }
+
+  disconnect() {
+    clearInterval(this.timer)
+  }
+
+  // Also called when a morph refresh brings a fresh value from the server.
+  remainingValueChanged() {
+    this.deadline = performance.now() + this.remainingValue
+    this.lastExpiredAt = null
+    this.tick()
+  }
+
+  tick() {
+    if (this.deadline === undefined) return
+    const left = Math.max(0, this.deadline - performance.now())
+    const seconds = Math.ceil(left / 1000)
+    const text = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`
+    if (this.element.textContent !== text) this.element.textContent = text
+    this.element.classList.toggle("is-ending", seconds <= 5)
+    if (left <= 0) {
+      const now = performance.now()
+      if (!this.lastExpiredAt || now - this.lastExpiredAt >= 1000) {
+        this.lastExpiredAt = now
+        this.dispatch("expired")
+      }
+    }
+  }
+}
