@@ -88,11 +88,36 @@ class Game < ApplicationRecord
     if last_question?
       transition!(expected_version, from: "closed", status: "finished", finished_at: Time.current)
     else
+      now = Time.current
       transition!(expected_version, from: "closed", status: "open", current_index: current_index + 1,
-                                    question_opened_at: Time.current)
+                                    question_opened_at: now, question_deadline_at: deadline_from(now))
