+++ b/app/views/moderate/games/show.html.erb
@@ -0,0 +1,88 @@
+<% content_for :title, "Game #{@game.code} · #{@quiz.title}" %>
+<% turbo_refreshes_with method: :morph, scroll: :preserve %>
+<% question = @game.current_question %>
+<%= turbo_stream_from @game, :screen %>
+<div <%= tag.attributes(data: live_data(url: status_moderate_game_path(@game), version: @game.screen_version, interval: 2000)) %>>
+  <section class="cover cover--blue cover--calm">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <span><%= @quiz.title %></span>
+      </div>
+
+      <div class="screen__body">
+        <% if @game.lobby? %>
+          <div class="lobby">
+            <div>
+              <h1 class="lobby__title"><%= @quiz.title %></h1>
+              <div class="lobby__join">Join on your phone:</div>
+              <div class="lobby__url" data-testid="join-link"><%= join_url(@game) %></div>
+              <div class="counter-pill"><span>Players: <strong><%= @game.online_count %></strong></span></div>
+            </div>
+            <div class="qr" role="img" aria-label="QR code: <%= join_url(@game) %>" data-url="<%= join_url(@game) %>">
+              <%= qr_code_svg(join_url(@game)) %>
+            </div>
+          </div>
+        <% elsif @game.playing? %>
+          <div class="stage-question__num">Question <%= @game.question_number %> of <%= @game.total_questions %></div>
+          <% if question %>
+            <div class="stage-question__body"><%= question.body %></div>
+            <% counts = @game.closed? ? @game.option_counts : {} %>
+            <% total = counts.values.sum %>
+            <ol class="stage-options<%= " stage-options--results" if @game.closed? %>">
+              <% question.options.each_with_index do |option, index| %>
+                <% if @game.closed? %>
+                  <% count = counts.fetch(option.id, 0) %>
+                  <li class="stage-option<%= " is-correct" if option.correct? %>" style="--share: <%= total.zero? ? 0 : (count * 100.0 / total).round %>%">
+                    <span class="stage-option__bar"></span>
+                    <span class="stage-option__letter"><%= option_letter(index) %></span>
+                    <span class="stage-option__title"><%= option.text %></span>
+                    <% if option.correct? %><span class="stage-option__mark">Correct</span><% end %>
+                    <span class="stage-option__count"><%= count %><small class="stage-option__unit"> <%= count == 1 ? "answer" : "answers" %></small></span>
+                  </li>
+                <% else %>
+                  <li class="stage-option">
+                    <span class="stage-option__letter"><%= option_letter(index) %></span>
+                    <span class="stage-option__title"><%= option.text %></span>
+                  </li>
+                <% end %>
+              <% end %>
+            </ol>
+          <% else %>
+            <div class="stage-question__body">This question was deleted.</div>
+          <% end %>
+        <% else %>
+          <div class="screen__kicker"><%= @quiz.title %></div>
+          <h1 class="lobby__title">The quiz is over</h1>
+          <div class="counter-pill"><span>Thanks for playing!</span></div>
+        <% end %>
+      </div>
+    </div>
+
+    <div class="screen-controls">
+      <div class="screen-controls__info">
+        <%= link_to "← Quiz", moderate_quiz_path(@quiz) %>
+        <span>Game <%= @game.code %></span>
+        <% if @game.playing? %>
+          <span class="answers-counter" role="status">Answers: <%= @game.answered_count %> / <%= @game.online_count %></span>
+        <% elsif @game.finished? %>
+          <span><%= pluralize(@game.players.size, "player") %> took part</span>
+        <% end %>
+        <span class="screen-controls__offline" data-live-target="offline" hidden>Reconnecting…</span>
+      </div>
+      <div class="buttons">
+        <% if @game.lobby? %>
+          <% if @quiz.questions.where(active: true).exists? %>
+            <%= button_to "Start", start_moderate_game_path(@game), params: { version: @game.version }, class: "btn btn--pink btn--lg" %>
+          <% else %>
+            <span>No active questions to play.</span>
+          <% end %>
+        <% elsif @game.open? %>
+          <%= button_to "Finish", finish_moderate_game_path(@game), params: { version: @game.version }, class: "btn btn--pink btn--lg" %>
+        <% elsif @game.closed? %>
+          <%= button_to (@game.last_question? ? "End quiz" : "Next"), next_moderate_game_path(@game), params: { version: @game.version }, class: "btn btn--pink btn--lg" %>
+        <% end %>
+      </div>
+    </div>
+  </section>
+</div>
