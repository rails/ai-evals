+class CreateGames < ActiveRecord::Migration[8.1]
+  def change
+    create_table :games do |t|
+      t.references :quiz, null: false, foreign_key: true
+      t.string :code, null: false
+      # lobby → open (question is open) → closed (results shown) → … → finished
+      t.string :status, null: false, default: "lobby"
+      # Snapshot of the active question ids, taken on "Start".
+      t.json :question_ids, null: false, default: []
+      t.integer :current_index
+      # Bumped on every state transition; clients compare it to detect missed updates.
+      t.integer :version, null: false, default: 0
+      t.datetime :started_at
+      t.datetime :finished_at
+      t.timestamps
+    end
+    add_index :games, :code, unique: true
+
+    create_table :players do |t|
+      t.references :game, null: false, foreign_key: true
+      t.string :name, null: false
+      t.string :browser_token, null: false
+      # Presence: the page that pinged last (random id per page load) and when.
+      t.string :presence_token
+      t.datetime :last_seen_at
+      t.timestamps
+    end
+    add_index :players, [ :game_id, :browser_token ], unique: true
+    add_index :players, [ :game_id, :last_seen_at ]
+
+    # question_id/option_id have no foreign keys on purpose: editing a question
+    # replaces its options, and that must not break (or be blocked by) past games.
+    create_table :answers do |t|
+      t.references :game, null: false, foreign_key: true
+      t.references :player, null: false, foreign_key: true
+      t.integer :question_id, null: false
+      t.integer :option_id, null: false
+      t.timestamps
+    end
+    add_index :answers, [ :player_id, :question_id ], unique: true
+    add_index :answers, [ :game_id, :question_id, :option_id ]
+  end
+end
