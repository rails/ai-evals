+    play_url(game.code)
+  end
+
+  def qr_code_svg(text)
+    svg = RQRCode::QRCode.new(text, level: :m).as_svg(
+      module_size: 8, standalone: true, use_path: true, viewbox: true,
+      color: "0d0640", shape_rendering: "crispEdges"
+    )
+    svg.html_safe # generated by rqrcode from the URL; no user markup
+  end
+
+  def answers_label(count)
+    pluralize(count, "answer")
+  end
+
+  # Data attributes for live_controller.js.
+  def live_data(url:, version:, interval:, method: "get", leave_url: nil)
+    {
+      controller: "live",
+      live_url_value: url,
+      live_version_value: version.to_s,
+      live_interval_value: interval,
+      live_method_value: method,
+      live_leave_url_value: leave_url
+    }.compact
+  end
+end
diff --git a/app/javascript/controllers/live_controller.js b/app/javascript/controllers/live_controller.js
new file mode 100644
index 0000000..3b042a8
--- /dev/null
+++ b/app/javascript/controllers/live_controller.js
@@ -0,0 +1,132 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+
+// Keeps a live page (big screen or phone) in sync with the game.
+//
+// Live updates arrive as Turbo Stream "refresh" signals over Action Cable
+// (<turbo-cable-stream-source>), which morph the page in place. Cable messages
+// can be lost on flaky Wi-Fi, so this controller also polls a tiny endpoint
+// that returns the current version and refreshes the page when the rendered
+// version is stale. On phones the poll doubles as the presence heartbeat, and
+// a beacon on page hide tells the server the player left.
+//
+// One random id per page load lets the server ignore a late "leave" from a
+// page that was already replaced by a newer one (e.g. a reload).
+const PAGE_ID = Math.random().toString(36).slice(2) + Date.now().toString(36)
+
+export default class extends Controller {
+  static targets = ["offline", "status"]
+  static values = { url: String, version: String, interval: Number, method: String, leaveUrl: String }
+
+  connect() {
+    this.failures = 0
+    this.onWake = () => { if (document.visibilityState !== "hidden") this.check() }
+    this.onPageShow = (event) => { if (event.persisted) this.check() }
+    this.onPageHide = () => this.leave()
+    this.onSubmitStart = (event) => this.submitStarted(event)
+    this.onSubmitEnd = (event) => this.submitEnded(event)
+
+    document.addEventListener("visibilitychange", this.onWake)
+    window.addEventListener("online", this.onWake)
+    window.addEventListener("focus", this.onWake)
+    window.addEventListener("pageshow", this.onPageShow)
+    window.addEventListener("pagehide", this.onPageHide)
+    this.element.addEventListener("turbo:submit-start", this.onSubmitStart)
+    this.element.addEventListener("turbo:submit-end", this.onSubmitEnd)
+
+    this.check()
+  }
+
+  // The page just turned into a player page (joined): report presence right away.
+  leaveUrlValueChanged(value, previous) {
+    if (value && previous !== undefined && value !== previous && this.timer) this.check()
+  }
+
+  disconnect() {
+    clearTimeout(this.timer)
+    document.removeEventListener("visibilitychange", this.onWake)
+    window.removeEventListener("online", this.onWake)
+    window.removeEventListener("focus", this.onWake)
+    window.removeEventListener("pageshow", this.onPageShow)
+    window.removeEventListener("pagehide", this.onPageHide)
+    this.element.removeEventListener("turbo:submit-start", this.onSubmitStart)
+    this.element.removeEventListener("turbo:submit-end", this.onSubmitEnd)
+  }
+
+  async check() {
+    if (this.inFlight) return
+    this.inFlight = true
+    clearTimeout(this.timer)
+    try {
+      const response = await fetch(this.urlValue, this.requestOptions())
+      if (!response.ok) throw new Error(`HTTP ${response.status}`)
+      const data = await response.json()
+      this.setOnline(true)
+      if (String(data.version) !== this.versionValue) this.refresh()
+    } catch (_error) {
+      this.setOnline(false)
+    } finally {
+      this.inFlight = false
+      this.schedule()
+    }
+  }
+
+  schedule() {
+    clearTimeout(this.timer)
+    // Back off a little while offline, but keep trying.
+    const delay = this.failures > 0 ? Math.min(this.intervalValue, 2000 * this.failures) : this.intervalValue
+    this.timer = setTimeout(() => this.check(), delay || 5000)
+  }
+
+  requestOptions() {
+    const options = {
+      method: (this.methodValue || "get").toUpperCase(),
+      headers: { Accept: "application/json" },
+      credentials: "same-origin",
+      cache: "no-store"
+    }
+    if (window.AbortSignal && AbortSignal.timeout) options.signal = AbortSignal.timeout(8000)
+    if (options.method !== "GET") {
+      const body = new FormData()
+      body.append("page", PAGE_ID)
+      options.body = body
+    }
+    return options
+  }
+
+  refresh() {
+    Turbo.visit(window.location.href, { action: "replace" })
+  }
+
+  leave() {
+    if (!this.leaveUrlValue || !navigator.sendBeacon) return
+    const body = new FormData()
+    body.append("page", PAGE_ID)
+    navigator.sendBeacon(this.leaveUrlValue, body)
+  }
+
+  setOnline(online) {
+    this.failures = online ? 0 : this.failures + 1
+    // Only show the banner after two failures in a row: one blip is normal on conference Wi-Fi.
+    if (this.hasOfflineTarget) this.offlineTarget.hidden = online || this.failures < 2
+  }
+
+  // Answer buttons: show the tap at once, and say so if it did not get through.
+  submitStarted(event) {
+    const submitter = event.detail.formSubmission?.submitter
+    if (submitter?.classList.contains("play-option")) {
+      this.element.querySelectorAll(".play-option.is-sending").forEach((b) => b.classList.remove("is-sending"))
+      submitter.classList.add("is-sending")
+    }
+  }
+
+  submitEnded(event) {
+    const submitter = event.detail.formSubmission?.submitter
+    submitter?.classList.remove("is-sending")
+    if (!event.detail.success && submitter?.classList.contains("play-option") && this.hasStatusTarget) {
+      this.statusTarget.textContent = "Your answer was not sent. Check your connection and tap again."
+      this.statusTarget.className = "play-status play-status--wrong"
+      this.check()
+    }
+  }
+}
