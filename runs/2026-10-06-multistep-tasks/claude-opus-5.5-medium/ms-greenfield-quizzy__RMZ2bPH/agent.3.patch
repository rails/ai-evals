new file mode 100644
index 0000000..10e7793
--- /dev/null
+++ b/app/views/play/show.html.erb
@@ -0,0 +1,91 @@
+<% content_for :title, @game.quiz.title %>
+<% turbo_refreshes_with method: :morph, scroll: :preserve %>
+<%= turbo_stream_from @game, :players %>
+<div class="play" <%= tag.attributes(data: live_data(url: play_ping_path(@game.code), method: "post", version: @game.version,
+      interval: 3000, leave_url: (play_leave_path(@game.code) if @player))) %>>
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @player ? @player.name : @game.quiz.title %></span>
+  </div>
+  <div class="play-offline" data-live-target="offline" role="status" hidden>Reconnecting…</div>
+
+  <% if @game.finished? %>
+    <div class="play__body waiting">
+      <div class="waiting__gem">?</div>
+      <h1 class="play-title">The quiz is over</h1>
+      <% if @player %>
+        <p class="play-lead">You got <%= @player.score %> of <%= @game.total_questions %> right. Thanks for playing, <%= @player.name %>!</p>
+      <% end %>
+    </div>
+
+  <% elsif @player.nil? %>
+    <div class="play__body">
+      <h1 class="play-title"><%= @game.quiz.title %></h1>
+      <p class="play-lead">Enter your name to join the quiz.</p>
+      <%= form_with model: @new_player, url: play_join_path(@game.code), method: :post, class: "join-form" do |f| %>
+        <% if @new_player.errors.any? %>
+          <div class="errors" role="alert"><%= @new_player.errors.full_messages.to_sentence %></div>
+        <% end %>
+        <%= f.label :name, "Your name", class: "visually-hidden" %>
+        <%= f.text_field :name, class: "input", placeholder: "Your name", required: true, maxlength: Player::NAME_MAX,
+              autocomplete: "nickname", autocapitalize: "words", data: { turbo_permanent: true } %>
+        <%= f.submit "Join", class: "btn btn--pink" %>
+      <% end %>
+    </div>
+
+  <% elsif @game.lobby? %>
+    <div class="play__body waiting">
+      <div class="waiting__gem">?</div>
+      <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+      <p class="play-lead">You're in. The quiz starts soon: keep this page open.</p>
+    </div>
+
+  <% else %>
+    <% question = @game.current_question %>
+    <% answer = question && @player.answer_for(question.id) %>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= @game.question_number %> of <%= @game.total_questions %></div>
+      <% if question.nil? %>
+        <div class="play-question__body">This question was removed. Wait for the next one.</div>
+      <% elsif @game.open? %>
+        <%# No correctness data here: the correct options are only rendered once the question is closed. %>
+        <div class="play-question__body"><%= question.body %></div>
+        <div class="play-options">
+          <% question.options.each_with_index do |option, index| %>
+            <% picked = answer&.option_id == option.id %>
+            <%= button_to play_answer_path(@game.code), params: { question_id: question.id, option_id: option.id },
+                  class: "play-option#{" is-picked" if picked}", aria: { pressed: picked } do %>
+              <span class="play-option__letter"><%= option_letter(index) %></span>
+              <span class="play-option__title"><%= option.text %></span>
+              <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+            <% end %>
+          <% end %>
+        </div>
+        <div class="play-status play-status--neutral" role="status" data-live-target="status">
+          <%= answer ? "You can change your answer until the question closes." : "Tap an option to answer." %>
+        </div>
+      <% else %>
+        <div class="play-question__body"><%= question.body %></div>
+        <div class="play-options is-locked is-revealed">
+          <% question.options.each_with_index do |option, index| %>
+            <% picked = answer&.option_id == option.id %>
+            <div class="play-option<%= " is-picked" if picked %><%= " is-correct" if option.correct? %>">
+              <span class="play-option__letter"><%= option_letter(index) %></span>
+              <span class="play-option__title"><%= option.text %></span>
+              <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+              <% if option.correct? %><span class="play-option__mark" aria-label="correct option">✓</span><% end %>
+            </div>
+          <% end %>
+        </div>
+        <% if answer.nil? %>
+          <div class="play-status play-status--neutral" role="status">No answer</div>
+        <% elsif answer.correct? %>
+          <div class="play-status play-status--right" role="status">Correct!</div>
+        <% else %>
+          <div class="play-status play-status--wrong" role="status">Wrong!</div>
+        <% end %>
+        <p class="play-wait">Wait for the next question…</p>
+      <% end %>
+    </div>
+  <% end %>
+</div>
