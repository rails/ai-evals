+  def test_cache_entry_in_rails71_format_is_read_or_a_miss
+    Dir.mktmpdir do |dir|
+      store = ActiveSupport::Cache.lookup_store(:file_store, dir)
+      key = store.send(:normalize_key, 'upgrade', {})
+      FileUtils.mkdir_p(File.dirname(key))
+      File.binwrite(key, RAILS71_CACHE_ENTRY)
+
+      value = store.read('upgrade')
+      if Rails.gem_version >= Gem::Version.new('7.1')
+        assert_equal %w(cached text), value
+      else
+        assert_nil value, 'Rails 7.0 should treat a Rails 7.1 cache entry as a miss'
+        rewritten = 'rewritten'
