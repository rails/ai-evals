new file mode 100644
index 0000000..785121b
--- /dev/null
+++ b/config/initializers/05-secret_key_base.rb
@@ -0,0 +1,19 @@
+# frozen_string_literal: true
+
+# Redmine::SecretKeyBase (installed in config/application.rb) resolves
+# secret_key_base like the Rails 7.0 release. Warn if the host sets it in
+# several places with different values: it must settle on one before that
+# compatibility code can be removed. See docs/UPGRADE.md.
+Rails.application.config.after_initialize do |app|
+  next if Redmine::SecretKeyBase.legacy_resolution_disabled?
+
+  conflicts = Redmine::SecretKeyBase.conflicting_sources(app)
+  if conflicts.any?
+    Rails.logger.warn(
+      "secret_key_base is set in several places with different values. Using " \
+      "#{Redmine::SecretKeyBase.sources(app).detect {|_, v| v.present?}.first} " \
+      "(Rails 7.0 order), ignoring #{conflicts.join(', ')}. Keep a single " \
+      "source, see docs/UPGRADE.md."
+    )
+  end
+end
