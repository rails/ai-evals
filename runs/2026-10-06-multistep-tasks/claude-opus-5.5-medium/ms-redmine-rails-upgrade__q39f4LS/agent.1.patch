new file mode 100644
index 0000000..19b0cfa
--- /dev/null
+++ b/Gemfile.next
@@ -0,0 +1,12 @@
+# frozen_string_literal: true
+
+# Gemfile for the *next* Rails version (dual boot).
+#
+#   BUNDLE_GEMFILE=Gemfile.next bundle install
+#   BUNDLE_GEMFILE=Gemfile.next bin/rails test
+#
+# It shares every dependency with Gemfile; only the gems that have to move
+# with Rails are switched on @rails_next. Its lock file is Gemfile.next.lock.
+# See docs/UPGRADE.md.
+@rails_next = true
+eval_gemfile File.expand_path('Gemfile', __dir__)
