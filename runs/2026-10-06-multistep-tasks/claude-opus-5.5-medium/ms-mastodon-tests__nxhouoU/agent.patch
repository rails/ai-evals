diff --git a/spec/support/logging.rb b/spec/support/logging.rb
new file mode 100644
index 0000000..2f02d54
--- /dev/null
+++ b/spec/support/logging.rb
@@ -0,0 +1,24 @@
+# frozen_string_literal: true
+
+# Logging is one of the most expensive "hidden" costs of the test suite:
+# with the default `:debug` level every SQL query is formatted (and, with
+# `verbose_query_logs`, its caller location is resolved through the backtrace
+# cleaner) and written to `log/test.log`. That used to take ~40% of the total
+# `spec/models` run time.
+#
+# By default we only log warnings and errors. Set `LOG=1` (or `LOG=debug`) to
+# get full debug logs back (e.g. when investigating a failing spec), and
+# `VERBOSE_QUERY_LOGS=1` to also annotate queries with their call sites.
+#
+# NOTE: we change the level instead of replacing the logger with a null one,
+# so specs stubbing/inspecting `Rails.logger` keep working.
+log_level = ENV.fetch('LOG', nil)
+
+if log_level.blank? || log_level == '0'
+  Rails.logger.level = :warn
+  ActiveRecord::Base.logger&.level = :warn
+else
+  Rails.logger.level = log_level == '1' ? :debug : log_level.to_sym
+end
+
+ActiveRecord.verbose_query_logs = ENV['VERBOSE_QUERY_LOGS'].present?
diff --git a/spec/support/password_digest_cache.rb b/spec/support/password_digest_cache.rb
new file mode 100644
index 0000000..df4985a
--- /dev/null
+++ b/spec/support/password_digest_cache.rb
@@ -0,0 +1,30 @@
+# frozen_string_literal: true
+
+# Every `Fabricate(:user)` (and every local `Fabricate(:account)`, which builds
+# a user) sets the same default password, and Devise bcrypt-hashes it each
+# time (~1ms even at the minimum cost, ~10% of creating a local account).
+#
+# Reuse a single digest for the fabricator's default password. It is still a
+# real bcrypt hash of that password (`valid_password?` etc. work exactly the
+# same); only the salt is shared between users. Any other password is hashed
+# as usual. See docs/TEST_SUITE_PERFORMANCE.md (phase 3).
+module PasswordDigestCache
+  # Keep in sync with spec/fabricators/user_fabricator.rb
+  FABRICATOR_PASSWORD = '123456789'
+
+  @digests = {}
+
+  class << self
+    attr_reader :digests
+  end
+
+  private
+
+  def password_digest(password)
+    return super unless password == FABRICATOR_PASSWORD
+
+    PasswordDigestCache.digests[[self.class.name, self.class.stretches, self.class.pepper]] ||= super
+  end
+end
+
+User.prepend(PasswordDigestCache)
diff --git a/spec/support/sidekiq_webhooks.rb b/spec/support/sidekiq_webhooks.rb
new file mode 100644
index 0000000..ff70872
--- /dev/null
+++ b/spec/support/sidekiq_webhooks.rb
@@ -0,0 +1,36 @@
+# frozen_string_literal: true
+
+# `TriggerWebhookWorker` is enqueued for nearly every created/updated local
+# account, status, user and report. When jobs run inline, it serializes the
+# object with `REST::Admin::WebhookEventSerializer` only to find out that there
+# are no webhooks to deliver it to (its sole observable effect is enqueueing a
+# `Webhooks::DeliveryWorker` job per matching enabled webhook). That was ~20%
+# of the `spec/requests` run time.
+#
+# So, when executing jobs inline, skip it unless an enabled webhook subscribes
+# to the event (the same check as in `WebhookService#webhooks_for_event`).
+# Specs for webhooks create `Webhook` records first, so they are not affected.
+#
+# Set `SIDEKIQ_RUN_WEBHOOK_TRIGGERS=1` to always run it.
+# See docs/TEST_SUITE_PERFORMANCE.md.
+class SkipUnneededWebhookTriggersMiddleware
+  def call(_worker, job, _queue)
+    return if job['class'] == 'TriggerWebhookWorker' && !webhook_subscribed?(job['args'].first)
+
+    yield
+  end
+
+  private
+
+  def webhook_subscribed?(event)
+    Webhook.enabled.exists?(['? = ANY(events)', event])
+  end
+end
+
+unless ENV['SIDEKIQ_RUN_WEBHOOK_TRIGGERS'] == '1'
+  require 'sidekiq/testing'
+
+  Sidekiq::Testing.server_middleware do |chain|
+    chain.add SkipUnneededWebhookTriggersMiddleware
+  end
+end
