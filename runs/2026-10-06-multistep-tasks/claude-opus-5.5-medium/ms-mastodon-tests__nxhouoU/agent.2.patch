+SIDEKIQ_FAKE_BY_DEFAULT_TYPES = %i(model request).freeze
+
+def sidekiq_testing_mode_for(metadata)
+  metadata.fetch(:sidekiq) do
+    SIDEKIQ_FAKE_BY_DEFAULT_TYPES.include?(metadata[:type]) ? :fake : :inline
+  end
+end
+
+# `before_all` blocks run before the per-example hooks, so set the Sidekiq
+# testing mode for them too (otherwise they would use whatever mode the
+# previously run example left behind)
+TestProf::BeforeAll.configure do |config|
+  config.before(:begin) do |group|
+    Sidekiq.testing!(sidekiq_testing_mode_for(group.metadata))
+  end
+end
 
