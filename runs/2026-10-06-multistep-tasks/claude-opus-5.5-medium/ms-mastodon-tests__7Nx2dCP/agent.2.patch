diff --git a/spec/support/test_routes.rb b/spec/support/test_routes.rb
new file mode 100644
index 0000000..65866fe
--- /dev/null
+++ b/spec/support/test_routes.rb
@@ -0,0 +1,31 @@
+# frozen_string_literal: true
+
+# Replace the application routes with a minimal set for a whole example group.
+#
+# Redrawing the routes is cheap, but restoring the real ones (`reload_routes!`) takes
+# ~0.2s; doing that after every example was a noticeable cost in request specs
+# (see docs/TEST_PERFORMANCE.md). Routes refer to controllers by name, so stubbed
+# controllers (`stub_const`) can still be defined per example.
+#
+#   RSpec.describe 'Something' do
+#     draw_test_routes do
+#       get '/api/v1/tests', to: 'api/v1/tests#index'
+#     end
+#
+#     before { stub_const('Api::V1::TestsController', Class.new(Api::BaseController) { ... }) }
+#   end
+module TestRoutesHelpers
+  def draw_test_routes(&routes)
+    before(:context) do
+      # Make sure the lazily loaded routes do not get loaded (and replace ours) later
+      Rails.application.reload_routes_unless_loaded
+      Rails.application.routes.draw(&routes)
+    end
+
+    after(:context) { Rails.application.reload_routes! }
+  end
+end
+
+RSpec.configure do |config|
+  config.extend TestRoutesHelpers
+end
