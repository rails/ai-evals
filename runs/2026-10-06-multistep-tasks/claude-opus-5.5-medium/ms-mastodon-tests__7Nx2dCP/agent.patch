new file mode 100644
index 0000000..233b1e8
--- /dev/null
+++ b/spec/support/test_prof.rb
@@ -0,0 +1,15 @@
+# frozen_string_literal: true
+
+# TestProf (https://test-prof.evilmartians.io) profiling and optimization tooling.
+# Profilers are only activated via env vars (EVENT_PROF, RD_PROF, FPROF, TEST_STACK_PROF, ...)
+# and `-r test_prof`. See docs/TEST_PERFORMANCE.md for usage notes.
+require 'test_prof/recipes/rspec/before_all'
+require 'test_prof/recipes/rspec/let_it_be'
+
+TestProf::BeforeAll.configure do |config|
+  # `before_all`/`let_it_be` run in `before(:context)`, i.e. before per-example hooks
+  # from rails_helper.rb: apply the same environment settings (Sidekiq mode, ...) there.
+  config.before(:begin) do |context|
+    TestPerformance.apply(context.metadata)
+  end
