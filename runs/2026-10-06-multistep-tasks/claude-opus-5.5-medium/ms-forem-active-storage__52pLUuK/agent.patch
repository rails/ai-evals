+    it "copies the CarrierWave profile pictures into Active Storage, and can be run again" do
+      user = create(:user, :with_carrierwave_profile_image)
+      organization = create(:organization, :with_carrierwave_profile_image)
+
+      expect { Rake::Task["profile_images:copy"].invoke }.to output(/copied: 2/).to_stdout
+      expect(user.reload.avatar).to be_attached
+      expect(organization.reload.avatar).to be_attached
+
+      Rake::Task["profile_images:copy"].reenable
+      expect { Rake::Task["profile_images:copy"].invoke }.to output(/nothing to copy/).to_stdout
+      expect(ActiveStorage::Attachment.count).to eq(2)
+    end
+  end
+end
