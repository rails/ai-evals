+require "rails_helper"
+
+RSpec.describe ProfileImages::CopyWorker, type: :worker do
+  include_examples "#enqueues_on_correct_queue", "low_priority", ["User", 1]
+
+  it "copies the profile picture" do
+    user = create(:user, :with_carrierwave_profile_image)
+
