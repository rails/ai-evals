@@ -0,0 +1,19 @@
+# Validates and processes a new profile picture exactly like {ProfileImageUploader} does
+# (allowed extensions, file size, dimensions, frame count, EXIF stripping, SSRF-safe remote
+# downloads...), but always caches it on the local disk so the result can be handed over to
+# Active Storage. It never stores anything itself.
+#
+# @see ProfileImageAttachable
+class ProfileImageStagingUploader < ProfileImageUploader
+  storage :file
+  cache_storage :file
+
+  # Process exactly when ProfileImageUploader does (this can be toggled at runtime, e.g. in tests).
+  def enable_processing
+    ProfileImageUploader.enable_processing
+  end
+
+  def cache_dir
+    Rails.root.join("tmp/uploads/profile_image_staging").to_s
+  end
+end
