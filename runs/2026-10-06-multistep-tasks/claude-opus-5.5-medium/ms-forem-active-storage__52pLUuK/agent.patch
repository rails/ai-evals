new file mode 100644
index 0000000..0b4fe2d
--- /dev/null
+++ b/spec/lib/active_storage/service/fog_service_spec.rb
@@ -0,0 +1,71 @@
+require "rails_helper"
+require "active_storage/service/fog_service"
+
+RSpec.describe ActiveStorage::Service::FogService do
+  let(:credentials) do
+    { provider: "AWS", aws_access_key_id: "id", aws_secret_access_key: "secret", region: "us-east-1" }
+  end
+  let(:public_service) do
+    described_class.new(directory: "forem-test", credentials: credentials, public: true,
+                        cache_control: "public, max-age=31536000")
+  end
+  let(:private_service) { described_class.new(directory: "forem-test", credentials: credentials, public: false) }
+  let(:key) { SecureRandom.base36(28) }
+  let(:data) { "some image data".b }
+  let(:checksum) { OpenSSL::Digest::MD5.base64digest(data) }
+
+  around do |example|
+    Fog.mock!
+    Fog::Storage.new(credentials).directories.create(key: "forem-test")
+    example.run
+  ensure
+    Fog::Mock.reset
+    Fog.unmock!
+  end
+
+  it "is used for the S3 configurations" do
+    configs = ActiveStorage::Blob.services.send(:configurations)
+    expect(configs.dig(:amazon, :service)).to eq("Fog")
+    expect(configs.dig(:forem_cloud, :service)).to eq("Fog")
+  end
+
+  it "uploads, downloads and deletes files" do
+    public_service.upload(key, StringIO.new(data), checksum: checksum, content_type: "image/png")
+
+    expect(public_service.exist?(key)).to be(true)
+    expect(public_service.download(key)).to eq(data)
+    expect(public_service.download_chunk(key, 0..3)).to eq("some")
+
+    chunks = []
+    public_service.download(key) { |chunk| chunks << chunk }
+    expect(chunks.join).to eq(data)
+
+    public_service.delete(key)
+    expect(public_service.exist?(key)).to be(false)
+  end
+
+  it "deletes files by prefix" do
+    public_service.upload("prefix/a", StringIO.new(data))
+    public_service.upload("prefix/b", StringIO.new(data))
+    public_service.delete_prefixed("prefix/")
+
+    expect(public_service.exist?("prefix/a")).to be(false)
+    expect(public_service.exist?("prefix/b")).to be(false)
+  end
+
+  it "raises a FileNotFoundError for missing files" do
+    expect { public_service.download("missing") }.to raise_error(ActiveStorage::FileNotFoundError)
+  end
+
+  it "returns permanent URLs for public files" do
+    expect(public_service.url(key, filename: ActiveStorage::Filename.new("a.png"), disposition: :inline,
+                                   content_type: "image/png", expires_in: 5.minutes))
+      .to eq("https://forem-test.s3.amazonaws.com/#{key}")
+  end
+
+  it "returns signed URLs for private files" do
+    url = private_service.url(key, filename: ActiveStorage::Filename.new("a.png"), disposition: :inline,
+                                   content_type: "image/png", expires_in: 5.minutes)
+    expect(url).to include(key, "X-Amz-Signature", "response-content-type=image%2Fpng")
+  end
+end
