+++ b/spec/services/profile_images/copy_spec.rb
@@ -0,0 +1,166 @@
+require "rails_helper"
+
+RSpec.describe ProfileImages::Copy, type: :service do
+  let(:png_path) { Rails.root.join("app/assets/images/android-icon-36x36.png") }
+  let(:new_image) { Rack::Test::UploadedFile.new(png_path, "image/png") }
+  let(:active_storage_url_pattern) { %r{\A#{Regexp.escape(URL.url)}/rails/active_storage/blobs/redirect/} }
+
+  let!(:user) { create(:user, :with_carrierwave_profile_image) }
+
+  def avatar_attachments(record)
+    ActiveStorage::Attachment.where(record: record, name: "avatar")
+  end
+
+  describe ".call" do
+    it "copies the CarrierWave picture into Active Storage, which then serves it" do
+      legacy_url = user.profile_image_url
+      legacy_identifier = user.read_attribute(:profile_image)
+
+      expect(described_class.call(user)).to eq(:copied)
+
+      user.reload
+      expect(user.avatar).to be_attached
+      expect(user.avatar.download).to eq(File.binread(user.profile_image.path))
+      expect(user.avatar.filename.to_s).to eq(legacy_identifier)
+      expect(user.avatar.content_type).to eq("image/jpeg")
+      expect(user.profile_image_url).to match(active_storage_url_pattern)
+      expect(user.profile_image_url).not_to eq(legacy_url)
+    end
+
+    it "leaves the CarrierWave picture in place, so that URLs to it keep working" do
+      legacy_identifier = user.read_attribute(:profile_image)
+      legacy_path = user.profile_image.path
+
+      described_class.call(user)
+
+      expect(user.reload.read_attribute(:profile_image)).to eq(legacy_identifier)
+      expect(File).to exist(legacy_path)
+      expect(user.profile_image.url).to end_with(legacy_identifier)
+    end
+
+    it "does not save nor touch the record" do
+      allow(Users::BustProfileImageCacheWorker).to receive(:perform_async)
+
+      expect { described_class.call(user) }.not_to change { user.reload.updated_at }
+      expect(Users::BustProfileImageCacheWorker).not_to have_received(:perform_async)
+    end
+
+    it "is idempotent" do
+      described_class.call(user)
+
+      expect(described_class.call(User.find(user.id))).to eq(:already_copied)
+      expect(avatar_attachments(user).count).to eq(1)
+      expect(ActiveStorage::Blob.count).to eq(1)
+    end
+
+    it "does not replace a picture uploaded with Active Storage" do
+      user.update!(profile_image: new_image)
+      blob = user.avatar.blob
+
+      expect(described_class.call(user)).to eq(:already_copied)
+      expect(user.reload.avatar.blob).to eq(blob)
+    end
+
+    it "does not replace a picture uploaded while copying" do
+      stale = User.select(:id, :profile_image).find(user.id)
+      allow(stale.profile_image.file).to receive(:read).and_wrap_original do |original|
+        User.find(user.id).update!(profile_image: new_image) # concurrent upload
+        original.call
+      end
+
+      expect(described_class.call(stale)).to eq(:already_copied)
+      expect(avatar_attachments(user).count).to eq(1)
+      expect(user.reload.avatar.filename.extension).to eq("png")
+      # the copied file is not left behind
+      expect(ActiveStorage::Blob.count).to eq(1)
+    end
+
+    it "lets a picture uploaded concurrently replace the copied one" do
+      uploading = User.find(user.id)
+      expect(uploading.avatar).not_to be_attached # loaded before the copy
+
+      described_class.call(User.find(user.id))
+      uploading.update!(profile_image: new_image)
+
+      expect(avatar_attachments(user).count).to eq(1)
+      expect(user.reload.avatar.filename.extension).to eq("png")
+    end
+
+    it "skips records whose CarrierWave file doesn't exist, which keep their current URL" do
+      user.update_column(:profile_image, "missing.png")
+      user.reload
+      url = user.profile_image_url
+
+      expect(described_class.call(user)).to eq(:missing)
+      expect(user.reload.avatar).not_to be_attached
+      expect(user.profile_image_url).to eq(url)
+      expect(ActiveStorage::Blob.count).to eq(0)
+    end
+
+    it "skips records without a picture" do
+      user.update_column(:profile_image, nil)
+
+      expect(described_class.call(user.reload)).to eq(:no_picture)
+    end
+
+    it "copies organization pictures" do
+      organization = create(:organization, :with_carrierwave_profile_image)
+
+      expect(described_class.call(organization)).to eq(:copied)
+      expect(organization.reload.avatar.download).to eq(File.binread(organization.profile_image.path))
+      expect(organization.profile_image_url).to match(active_storage_url_pattern)
+    end
+
+    it "doesn't leave the uploaded file behind on errors" do
+      allow(ActiveStorage::Attachment).to receive(:create!).and_raise(ActiveRecord::StatementInvalid, "boom")
+
+      expect { described_class.call(user) }.to raise_error(ActiveRecord::StatementInvalid)
+      expect(ActiveStorage::Blob.count).to eq(0)
+      expect(user.reload.avatar).not_to be_attached
+    end
+  end
+
+  describe ".all" do
+    let!(:organization) { create(:organization, :with_carrierwave_profile_image) }
+    let!(:uploaded) { create(:user) } # uploaded with Active Storage
+    let!(:without_picture) do
+      create(:user, :with_carrierwave_profile_image).tap { |u| u.update_column(:profile_image, nil) }
+    end
+
+    it "copies every picture still on CarrierWave" do
+      counts = described_class.all
+
+      expect(counts).to eq(copied: 2)
+      expect([user, organization, uploaded].map { |record| record.reload.profile_image_url })
+        .to all(match(active_storage_url_pattern))
+      expect(without_picture.reload.avatar).not_to be_attached
+    end
+
+    it "resumes after an interruption" do
+      other = create(:user, :with_carrierwave_profile_image)
+      calls = 0
+      allow(described_class).to receive(:call).and_wrap_original do |original, record|
+        calls += 1
+        raise Interrupt if calls == 2
+
+        original.call(record)
+      end
+
+      expect { described_class.all }.to raise_error(Interrupt)
+      expect(described_class.pending(User).count + described_class.pending(Organization).count).to eq(2)
+
+      expect(described_class.all).to eq(copied: 2)
+      expect([user, other, organization].map { |record| avatar_attachments(record).count }).to eq([1, 1, 1])
+      expect(described_class.all).to eq({})
+    end
+
+    it "carries on after a failure and reports it" do
+      allow(described_class).to receive(:call).and_call_original
+      allow(described_class).to receive(:call).with(having_attributes(id: user.id, class: User))
+        .and_raise(Excon::Error::Socket)
+
+      expect(described_class.all).to eq(copied: 1, failed: 1)
+      expect(organization.reload.avatar).to be_attached
+    end
+  end
+end
