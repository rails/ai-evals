diff --git a/spec/support/legacy_profile_image_helpers.rb b/spec/support/legacy_profile_image_helpers.rb
new file mode 100644
index 0000000..11e767a
--- /dev/null
+++ b/spec/support/legacy_profile_image_helpers.rb
@@ -0,0 +1,14 @@
+# Profile pictures of users and organizations used to be stored with CarrierWave (see
+# ProfileImageAttachable). CarrierWave is not mounted on them anymore, these helpers give access
+# to such a retired picture the way CarrierWave stored and served it, as a reference in specs.
+module LegacyProfileImageHelpers
+  def carrierwave_profile_image(record)
+    ProfileImageUploader.new(record, :profile_image).tap do |uploader|
+      uploader.retrieve_from_store!(record.read_attribute(:profile_image))
+    end
+  end
+end
+
+RSpec.configure do |config|
+  config.include LegacyProfileImageHelpers
+end
