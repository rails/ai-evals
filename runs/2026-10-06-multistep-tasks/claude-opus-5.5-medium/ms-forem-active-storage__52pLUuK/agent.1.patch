+++ b/config/initializers/active_storage.rb
@@ -0,0 +1,7 @@
+# Active Storage is used for the profile pictures of users and organizations (see
+# ProfileImageAttachable). Its background jobs (e.g. purging replaced or deleted pictures) run on
+# Sidekiq, like the rest of our background work, rather than on Active Job's default in-process
+# adapter which loses jobs on restarts. Other Active Job users (e.g. mailers) are not affected.
+Rails.application.config.to_prepare do
+  ActiveStorage::BaseJob.queue_adapter = :sidekiq unless Rails.env.test?
+end
