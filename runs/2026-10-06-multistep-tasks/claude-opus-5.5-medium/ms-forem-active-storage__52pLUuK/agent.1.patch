@@ -108,6 +108,20 @@ class Application < Rails::Application
 
     config.middleware.use Rack::Deflater unless Rails.env.development?
 
+    # Active Storage is (for now) only used for the profile pictures of users and
+    # organizations, which are being migrated from CarrierWave one deploy at a time.
+    # See ProfileImageAttachable. The service is selected per environment.
