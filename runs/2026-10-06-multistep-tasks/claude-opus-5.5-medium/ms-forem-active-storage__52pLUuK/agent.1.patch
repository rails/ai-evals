@@ -0,0 +1,71 @@
+require "rails_helper"
+require "active_storage/service/fog_service"
+
+RSpec.describe ActiveStorage::Service::FogService do
+  let(:credentials) do
+    { provider: "AWS", aws_access_key_id: "id", aws_secret_access_key: "secret", region: "us-east-1" }
+  end
+  let(:public_service) do
+    described_class.new(directory: "forem-test", credentials: credentials, public: true,
+                        cache_control: "public, max-age=31536000")
+  end
+  let(:private_service) { described_class.new(directory: "forem-test", credentials: credentials, public: false) }
+  let(:key) { SecureRandom.base36(28) }
+  let(:data) { "some image data".b }
+  let(:checksum) { OpenSSL::Digest::MD5.base64digest(data) }
+
+  around do |example|
+    Fog.mock!
+    Fog::Storage.new(credentials).directories.create(key: "forem-test")
+    example.run
+  ensure
+    Fog::Mock.reset
+    Fog.unmock!
+  end
+
+  it "is used for the S3 configurations" do
+    configs = ActiveStorage::Blob.services.send(:configurations)
+    expect(configs.dig(:amazon, :service)).to eq("Fog")
+    expect(configs.dig(:forem_cloud, :service)).to eq("Fog")
+  end
+
+  it "uploads, downloads and deletes files" do
+    public_service.upload(key, StringIO.new(data), checksum: checksum, content_type: "image/png")
+
+    expect(public_service.exist?(key)).to be(true)
+    expect(public_service.download(key)).to eq(data)
+    expect(public_service.download_chunk(key, 0..3)).to eq("some")
+
+    chunks = []
+    public_service.download(key) { |chunk| chunks << chunk }
+    expect(chunks.join).to eq(data)
+
+    public_service.delete(key)
+    expect(public_service.exist?(key)).to be(false)
+  end
+
+  it "deletes files by prefix" do
+    public_service.upload("prefix/a", StringIO.new(data))
+    public_service.upload("prefix/b", StringIO.new(data))
+    public_service.delete_prefixed("prefix/")
+
+    expect(public_service.exist?("prefix/a")).to be(false)
+    expect(public_service.exist?("prefix/b")).to be(false)
+  end
+
+  it "raises a FileNotFoundError for missing files" do
+    expect { public_service.download("missing") }.to raise_error(ActiveStorage::FileNotFoundError)
+  end
+
+  it "returns permanent URLs for public files" do
+    expect(public_service.url(key, filename: ActiveStorage::Filename.new("a.png"), disposition: :inline,
+                                   content_type: "image/png", expires_in: 5.minutes))
+      .to eq("https://forem-test.s3.amazonaws.com/#{key}")
+  end
+
+  it "returns signed URLs for private files" do
+    url = private_service.url(key, filename: ActiveStorage::Filename.new("a.png"), disposition: :inline,
+                                   content_type: "image/png", expires_in: 5.minutes)
+    expect(url).to include(key, "X-Amz-Signature", "response-content-type=image%2Fpng")
+  end
+end
diff --git a/spec/models/concerns/profile_image_attachable_spec.rb b/spec/models/concerns/profile_image_attachable_spec.rb
new file mode 100644
index 0000000..68f23bf
--- /dev/null
+++ b/spec/models/concerns/profile_image_attachable_spec.rb
@@ -0,0 +1,243 @@
+require "rails_helper"
+
+RSpec.describe ProfileImageAttachable do
+  let(:jpeg_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+  let(:png_path) { Rails.root.join("app/assets/images/android-icon-36x36.png") }
+  let(:new_image) { Rack::Test::UploadedFile.new(png_path, "image/png") }
+  let(:carrierwave_url_pattern) { %r{/uploads/user/profile_image/\d+/[\w-]+\.jpeg\z} }
+  let(:active_storage_url_pattern) { %r{\A#{Regexp.escape(URL.url)}/rails/active_storage/blobs/redirect/[^/]+/[\w-]+\.png\z} }
+
+  describe "existing (CarrierWave) profile pictures" do
+    let(:user) { create(:user, :with_carrierwave_profile_image) }
+
+    it "keeps serving them from CarrierWave" do
+      expect(user.avatar).not_to be_attached
+      expect(user.profile_image_url).to match(carrierwave_url_pattern)
+      expect(user.profile_image_url).to eq(user.profile_image.url)
+      expect(user.profile_image_90).to eq(Images::Profile.call(user.profile_image.url, length: 90))
+    end
+
+    it "does not touch them when saving other attributes" do
+      expect { user.update!(name: "Another name") }.not_to change { user.reload.read_attribute(:profile_image) }
+      expect(user.profile_image_url).to match(carrierwave_url_pattern)
+      expect(File).to exist(user.profile_image.path)
+    end
+
+    it "keeps them in place when a new picture is uploaded" do
+      legacy_identifier = user.read_attribute(:profile_image)
+      legacy_path = user.profile_image.path
+
+      user.update!(profile_image: new_image)
+      user.reload
+
+      # cached URLs and servers still running the previous release keep working
+      expect(user.read_attribute(:profile_image)).to eq(legacy_identifier)
+      expect(File).to exist(legacy_path)
+      # but the new picture wins
+      expect(user.avatar).to be_attached
+      expect(user.profile_image_url).to match(active_storage_url_pattern)
+    end
+
+    it "are found by the presence check" do
+      expect(user.profile_image_present?).to be(true)
+    end
+  end
+
+  describe "new profile pictures" do
+    it "are stored with Active Storage when uploaded" do
+      user = create(:user, profile_image: new_image)
+      user = User.find(user.id)
+
+      expect(user.avatar).to be_attached
+      expect(user.avatar.download).to eq(File.binread(png_path))
+      expect(user.avatar.content_type).to eq("image/png")
+      expect(user.read_attribute(:profile_image)).to be_nil
+      expect(user.profile_image_url).to match(active_storage_url_pattern)
+    end
+
