--- /dev/null
+++ b/spec/requests/active_storage_profile_images_spec.rb
@@ -0,0 +1,31 @@
+require "rails_helper"
+
+RSpec.describe "Active Storage profile pictures" do
+  let(:png_path) { Rails.root.join("app/assets/images/android-icon-36x36.png") }
+  let(:user) { create(:user, profile_image: Rack::Test::UploadedFile.new(png_path, "image/png")) }
+
+  it "serves the profile picture through its URL" do
+    get URI.parse(user.profile_image_url).path
+    expect(response).to have_http_status(:found)
+
+    get URI.parse(response.location).request_uri
+    expect(response).to have_http_status(:ok)
+    expect(response.body.b).to eq(File.binread(png_path))
+    expect(response.media_type).to eq("image/png")
+  end
+
+  it "keeps serving the profile picture after it has been cached elsewhere" do
+    url = user.profile_image_url
+
+    Timecop.travel(1.month.from_now) do
+      get URI.parse(url).path
+      expect(response).to have_http_status(:found)
+    end
+  end
+
+  it "does not expose direct uploads" do
+    expect(Rails.application.routes.url_helpers).not_to respond_to(:rails_direct_uploads_path)
+    expect { Rails.application.routes.recognize_path("/rails/active_storage/direct_uploads", method: :post) }
+      .to raise_error(ActionController::RoutingError)
+  end
+end
