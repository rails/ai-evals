diff --git a/docs/bots.md b/docs/bots.md
index 1e96ace..e6762c4 100644
--- a/docs/bots.md
+++ b/docs/bots.md
@@ -146,3 +146,23 @@ Response handling:
 - Replies are posted only if the bot is still a member of the room, and are
   broadcast like any message. Redirects aren't followed. Jobs aren't retried (a
   retry could make the bot act twice).
+
+## Bots per member
+
+Administrators set **"Bots per member"** on `/account/edit`
+(`Account#settings.bots_per_member`, a `has_json` integer, default `5`; the model
+validates it's a whole number `>= 0`, and `AccountsController#update` redirects back
+with the error as a flash alert instead of raising).
+
+- `User#bot_limit` is that setting, or `nil` for administrators (not limited).
+- `User#reached_bot_limit?` counts `bots.undeleted_bots`: everything but
+  `deactivated` (deleted) bots. Banned bots still count.
+- Enforced twice: `BotsController` answers `403` to `new`/`create` at the limit, and
+  a `on: :create` validation on bots (`creator_must_be_under_bot_limit`) refuses any
+  other path (console, future endpoints). It runs inside `create!`'s transaction,
+  which is `BEGIN IMMEDIATE` on SQLite (`default_transaction_mode: immediate`), so
+  two concurrent creates can't both slip under the limit.
+- At the limit, `/bots` hides "Add a chat bot" and shows a `#bot_limit` note that
+  the member has "reached the limit".
+- Lowering the limit never touches existing bots — the validation is create-only,
+  so they can still be edited, and deleting one frees a slot.
diff --git a/test/controllers/accounts_controller_test.rb b/test/controllers/accounts_controller_test.rb
index 3b896a6..1efd3a2 100644
--- a/test/controllers/accounts_controller_test.rb
+++ b/test/controllers/accounts_controller_test.rb
@@ -65,4 +65,33 @@ class AccountsControllerTest < ActionDispatch::IntegrationTest
     put account_url, params: { account: { name: "Different" } }
     assert_response :forbidden
   end
+
+  test "edit has the bots per member setting" do
+    get edit_account_url
+
+    assert_select "label", text: /Bots per member/
+    assert_select "input[type=number][name='account[settings][bots_per_member]'][value='5']"
+  end
+
+  test "update bots per member" do
+    put account_url, params: { account: { settings: { bots_per_member: "3" } } }
+
+    assert_redirected_to edit_account_url
+    assert_equal 3, accounts(:signal).reload.settings.bots_per_member
+  end
+
+  test "update rejects an invalid bots per member" do
+    put account_url, params: { account: { settings: { bots_per_member: "-2" } } }
+
+    assert_redirected_to edit_account_url
+    assert_equal "Bots per member must be a whole number, 0 or more", flash[:alert]
+    assert_equal 5, accounts(:signal).reload.settings.bots_per_member
+  end
+
+  test "members don't see the bots per member setting" do
+    sign_in :kevin
+    get edit_account_url
+
+    assert_select "input[name='account[settings][bots_per_member]']", count: 0
+  end
 end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
index a81e313..5c7f18f 100644
--- a/test/controllers/bots_controller_test.rb
+++ b/test/controllers/bots_controller_test.rb
@@ -197,4 +197,54 @@ class BotsControllerTest < ActionDispatch::IntegrationTest
     assert_response :unprocessable_content
     assert_nil users(:deploy_bot).reload.webhook_url
   end
+
+  test "members at the bot limit aren't offered a new bot" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    get bots_url
+
+    assert_select "a[href=?]", new_bot_path, count: 0
+    assert_select "#bot_limit", text: /reached the limit/
+  end
+
+  test "members under the bot limit are offered a new bot" do
+    get bots_url
+
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+    assert_select "#bot_limit", count: 0
+  end
+
+  test "members at the bot limit can't create bots" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    get new_bot_url
+    assert_response :forbidden
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { bot: { name: "Bender Bot" } }
+    end
+    assert_response :forbidden
+  end
+
+  test "deleted bots don't count towards the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    users(:deploy_bot).deactivate_bot
+
+    assert_difference -> { User.bot.count }, +1 do
+      post bots_url, params: { bot: { name: "Bender Bot" } }
+    end
+    assert_redirected_to bots_url
+  end
+
+  test "administrators aren't limited" do
+    sign_in :david
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+    get bots_url
+    assert_select "a[href=?]", new_bot_path
+
+    assert_difference -> { User.bot.count }, +1 do
+      post bots_url, params: { bot: { name: "Bender Bot" } }
+    end
+  end
 end
