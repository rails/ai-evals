diff --git a/test/controllers/messages/by_bots_controller_test.rb b/test/controllers/messages/by_bots_controller_test.rb
new file mode 100644
index 0000000..1e54e54
--- /dev/null
+++ b/test/controllers/messages/by_bots_controller_test.rb
@@ -0,0 +1,146 @@
+require "test_helper"
+
+class Messages::ByBotsControllerTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper, Turbo::Streams::StreamName
+
+  setup do
+    @room = rooms(:watercooler)
+    @bot = users(:deploy_bot)
+  end
+
+  test "create from the raw request body" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Deploy of v1.2.3 finished ✅"
+    end
+
+    message = Message.last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.location
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+    assert_equal @bot, message.creator
+  end
+
+  test "create with text that isn't valid form encoding" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: "100% done & a=b", headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    assert_equal "100% done & a=b", Message.last.plain_text_body
+  end
+
+  test "create with a JSON content type keeps the raw body" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: "{not json", headers: { "Content-Type" => "application/json" }
+
+    assert_response :created
+    assert_equal "{not json", Message.last.plain_text_body
+  end
+
+  test "create treats the body as plain text" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: "<b>Deploy</b> <v1.2.3>\nDone"
+
+    assert_response :created
+    assert_equal "<b>Deploy</b> <v1.2.3>\nDone", Message.last.plain_text_body
+    assert_no_match "<b>", Message.last.body.to_s
+  end
+
+  test "create with an attachment" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+
+    assert_response :created
+    assert Message.last.attachment.attached?
+  end
+
+  test "create broadcasts the message" do
+    assert_broadcasts stream_name_from([ @room, :messages ]), 1 do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Hello from a bot"
+    end
+  end
+
+  test "create pushes notifications" do
+    assert_enqueued_with job: Room::PushMessageJob do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Hello from a bot"
+    end
+  end
+
+  test "create with an empty body" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: ""
+      assert_response :unprocessable_content
+
+      post room_bot_messages_url(@room, @bot.bot_key), params: " \n "
+      assert_response :unprocessable_content
+    end
+  end
+
+  test "create in a room that doesn't exist" do
+    post room_bot_messages_url(room_id: "nope", bot_key: @bot.bot_key), params: "Hello"
+
+    assert_response :not_found
+  end
+
+  test "create in a room the bot isn't in" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(rooms(:designers), @bot.bot_key), params: "Hello"
+    end
+
+    assert_response :not_found
+  end
+
+  test "create with an invalid bot code" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, "#{@bot.id}-wrong"), params: "Hello"
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "create after the bot was deleted" do
+    key = @bot.bot_key
+    @bot.deactivate_bot
+
+    post room_bot_messages_url(@room, key), params: "Hello"
+
+    assert_response :unauthorized
+  end
+
+  test "create doesn't need or start a session" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Hello"
+
+    assert_response :created
+    assert cookies[:session_token].blank?
+  end
+  test "create over the flood limit is rejected with retry after" do
+    freeze_time
+    10.times { post room_bot_messages_url(@room, @bot.bot_key), params: "Hello" }
+    assert_response :created
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "One too many"
+    end
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+
+    travel 10.seconds
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Still cooling down"
+    assert_response :too_many_requests
+    assert_equal "20", response.headers["Retry-After"]
+  end
+
+  test "posting during the cooldown suspends the bot" do
+    11.times { post room_bot_messages_url(@room, @bot.bot_key), params: "Hello" }
+    4.times { post room_bot_messages_url(@room, @bot.bot_key), params: "Hello" }
+    assert_response :too_many_requests
+
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Hello"
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "create by a suspended bot is forbidden" do
+    @bot.update! suspended_at: Time.current, suspension_reason: "failing_webhook"
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Hello"
+    end
+    assert_response :forbidden
+  end
+end
