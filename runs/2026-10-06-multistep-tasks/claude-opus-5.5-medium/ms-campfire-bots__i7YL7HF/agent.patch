diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..274df8b
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,107 @@
+module User::Bot
+  extend ActiveSupport::Concern
+  include Suspendable
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :bots, -> { bot }, class_name: "User", foreign_key: :creator_id, inverse_of: :creator
+
+    validates :name, presence: true, if: :bot?
+
+    normalizes :webhook_url, with: ->(url) { url.strip.presence }
+    validate :webhook_url_must_be_http, if: :webhook_url?
+    validate :creator_must_be_under_bot_limit, on: :create, if: -> { bot? && creator }
+
+    scope :without_bots, -> { where.not(role: :bot) }
+    scope :active_bots, -> { active.bot }
+    scope :with_webhook, -> { where.not(webhook_url: nil) }
+
+    # Deleted bots are deactivated; every other bot counts towards its creator's limit.
+    scope :undeleted_bots, -> { bot.where.not(status: :deactivated) }
+
+    # People are in every open room; bots only when "Add to all open rooms" is on.
+    scope :joining_open_rooms, -> { without_bots.or(where(joins_open_rooms: true)) }
+  end
+
+  class_methods do
+    def create_bot!(attributes)
+      create!(attributes.merge(role: :bot, bot_token: generate_bot_token))
+    end
+
+    # A bot key is "<id>-<token>". The token is compared in constant time so the
+    # lookup by id can't be used to guess it a character at a time.
+    def authenticate_bot(bot_key)
+      bot_id, bot_token = bot_key.to_s.strip.split("-", 2)
+
+      if bot_token.present? && (bot = active_bots.find_by(id: bot_id)) && bot.bot_token.present?
+        bot if ActiveSupport::SecurityUtils.secure_compare(bot.bot_token, bot_token)
+      end
+    end
+
+    def generate_bot_token
+      SecureRandom.alphanumeric(32)
+    end
+  end
+
+  # Members manage the bots they created; administrators manage every bot.
+  def manageable_bots
+    administrator? ? User.active_bots : bots.active
+  end
+
+  # "Bots per member" in the account settings. Administrators aren't limited, and
+  # lowering the limit keeps existing bots: it only blocks new ones.
+  def bot_limit
+    Current.account.settings.bots_per_member unless administrator?
+  end
+
+  def reached_bot_limit?
+    bot_limit.present? && bots.undeleted_bots.count >= bot_limit
+  end
+
+  def bot_key
+    "#{id}-#{bot_token}" if bot? && bot_token.present?
+  end
+
+  def reset_bot_key
+    update! bot_token: self.class.generate_bot_token
+  end
+
+  def deactivate_bot
+    transaction do
+      deactivate
+      update! bot_token: nil
+    end
+  end
+
+  def webhook
+    User::Bot::Webhook.new(self) if bot? && active? && !suspended? && webhook_url?
+  end
+
+  def deliver_webhook_later(message)
+    User::DeliverWebhookJob.perform_later(self, message) if webhook
+  end
+
+  def deliver_webhook(message)
+    webhook&.deliver(message)
+  end
+
+  def deliver_joined_webhook_later(room)
+    User::DeliverJoinedWebhookJob.perform_later(self, room) if webhook && !room.direct?
+  end
+
+  def deliver_joined_webhook(room)
+    webhook&.deliver_joined(room) unless room.direct?
+  end
+
+  private
+    def creator_must_be_under_bot_limit
+      errors.add :base, "You’ve reached the limit of #{creator.bot_limit} #{"chat bot".pluralize(creator.bot_limit)}" if creator.reached_bot_limit?
+    end
+
+    def webhook_url_must_be_http
+      uri = URI.parse(webhook_url)
+      errors.add :webhook_url, "must be an http:// or https:// URL" unless uri.is_a?(URI::HTTP) && uri.host.present?
+    rescue URI::InvalidURIError
+      errors.add :webhook_url, "must be an http:// or https:// URL"
+    end
+end
diff --git a/app/models/user/bot/suspendable.rb b/app/models/user/bot/suspendable.rb
new file mode 100644
index 0000000..d0bad80
--- /dev/null
+++ b/app/models/user/bot/suspendable.rb
@@ -0,0 +1,127 @@
+# Stops misbehaving bots: ones that flood rooms, and ones whose webhook keeps failing.
+# The limits are fixed here on purpose; there are no settings for them. Only
+# administrators can bring a suspended bot back (Bots::ReactivationsController).
+# See "Misbehaving bots" in docs/bots.md.
+module User::Bot::Suspendable
+  extend ActiveSupport::Concern
+
+  FLOOD_LIMIT = 10
+  FLOOD_PERIOD = 10.seconds
+  FLOOD_COOLDOWN = 30.seconds
+  FLOOD_COOLDOWN_ATTEMPTS = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  SUSPENSION_REASONS = {
+    "flooding" => "Posted more than #{FLOOD_LIMIT} messages in #{FLOOD_PERIOD.inspect} and kept posting during the cooldown",
+    "failing_webhook" => "Its webhook failed #{WEBHOOK_FAILURE_LIMIT} times in a row"
+  }
+
+  class Suspended < StandardError; end
+
+  class CoolingDown < StandardError
+    attr_reader :retry_after
+
+    def initialize(retry_after)
+      @retry_after = retry_after
+      super "Posting too fast, retry in #{retry_after} seconds"
+    end
+  end
+
+  included do
+    scope :suspended, -> { where.not(suspended_at: nil) }
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def suspension_reason_description
+    SUSPENSION_REASONS[suspension_reason] if suspended?
+  end
+
+  def cooling_down?
+    flood_cooldown_until.present? && flood_cooldown_until.future?
+  end
+
+  # Every post by a bot (through the API or as a webhook reply) goes through here.
+  # Yields when the bot is allowed to post; otherwise raises Suspended or CoolingDown.
+  # The bookkeeping is committed before raising, so rejected attempts still count.
+  def post_within_limits
+    case outcome = track_post_attempt
+    when :allowed   then yield
+    when :suspended then raise Suspended
+    else raise CoolingDown.new(outcome)
+    end
+  end
+
+  def record_webhook_delivery(succeeded:)
+    if succeeded
+      update_columns webhook_failures_count: 0 unless webhook_failures_count.zero?
+    else
+      transaction do
+        lock!
+        update_columns webhook_failures_count: webhook_failures_count + 1
+        suspend "failing_webhook" if webhook_failures_count >= WEBHOOK_FAILURE_LIMIT
+      end
+    end
+  end
+
+  def reactivate
+    update! suspended_at: nil, suspension_reason: nil, recent_post_times: nil,
+      flood_cooldown_until: nil, flood_cooldown_attempts: 0, webhook_failures_count: 0
+  end
+
+  private
+    # Returns :allowed, :suspended, or the seconds left in the cooldown. Runs in an
+    # (immediate, on SQLite) transaction so concurrent posts can't slip past the limit.
+    def track_post_attempt
+      transaction do
+        lock!
+        now = Time.current
+
+        if suspended?
+          :suspended
+        elsif cooling_down?
+          attempt_during_cooldown(now)
+        elsif recent_posts(now).size >= FLOOD_LIMIT
+          start_cooldown(now)
+        else
+          record_post(now)
+        end
+      end
+    end
+
+    def attempt_during_cooldown(now)
+      update_columns flood_cooldown_attempts: flood_cooldown_attempts + 1
+
+      if flood_cooldown_attempts >= FLOOD_COOLDOWN_ATTEMPTS
+        suspend "flooding"
+        :suspended
+      else
+        seconds_left_in_cooldown(now)
+      end
+    end
+
+    def start_cooldown(now)
+      update_columns flood_cooldown_until: now + FLOOD_COOLDOWN, flood_cooldown_attempts: 0, recent_post_times: []
+      seconds_left_in_cooldown(now)
+    end
+
+    def record_post(now)
+      update_columns recent_post_times: (recent_posts(now) + [ now.to_f ]).last(FLOOD_LIMIT)
+      :allowed
+    end
+
+    # Timestamps (epoch seconds) of the bot's accepted posts within the last FLOOD_PERIOD.
+    def recent_posts(now)
+      Array(recent_post_times).map(&:to_f).select { |time| time > (now - FLOOD_PERIOD).to_f }
+    end
+
+    def seconds_left_in_cooldown(now)
+      [ (flood_cooldown_until - now).ceil, 1 ].max
+    end
+
+    def suspend(reason)
+      update_columns suspended_at: Time.current, suspension_reason: reason
+    end
+end
diff --git a/app/models/user/bot/webhook.rb b/app/models/user/bot/webhook.rb
new file mode 100644
index 0000000..bf7d607
--- /dev/null
+++ b/app/models/user/bot/webhook.rb
@@ -0,0 +1,130 @@
+require "net/http"
+
+# Calls a bot's webhook when someone talks to it ("mention") or when it's added to a
+# room ("joined"), and posts the bot's synchronous reply (a 200 text/plain or
+# text/html response) into the room. See docs/bots.md.
+class User::Bot::Webhook
+  TIMEOUT = 7.seconds
+  MAX_REPLY_SIZE = 1.megabyte
+  REPLY_CONTENT_TYPES = %w[ text/plain text/html ]
+
+  attr_reader :bot
+
+  def initialize(bot)
+    @bot = bot
+  end
+
+  def deliver(message, event: "mention")
+    deliver_to message.room, payload(message, event: event)
+  end
+
+  def deliver_joined(room)
+    deliver_to room, joined_payload(room)
+  end
+
+  def payload(message, event: "mention")
+    {
+      event: event,
+      author: { id: message.creator.id, name: message.creator.name },
+      room: room_payload(message.room),
+      message: {
+        id: message.id,
+        body: { text: text_addressed_to_bot(message), html: message.body.body.to_html },
+        link: url_helpers.room_at_message_path(message.room, message)
+      }
+    }
+  end
+
+  def joined_payload(room)
+    { event: "joined", room: room_payload(room) }
+  end
+
+  private
+    # Anything but a 2xx, a timeout or a connection error is a failed delivery; too
+    # many in a row suspend the bot (User::Bot::Suspendable).
+    def deliver_to(room, payload)
+      response = post(payload)
+      bot.record_webhook_delivery succeeded: response.is_a?(Net::HTTPSuccess)
+
+      if reply = reply_from(response)
+        post_reply_to room, reply
+      end
+    rescue Net::OpenTimeout, Net::ReadTimeout
+      bot.record_webhook_delivery succeeded: false
+      post_timeout_notice_to room
+    rescue SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::ProtocolError => error
+      Rails.logger.warn "Webhook delivery for bot #{bot.id} failed: #{error.class}: #{error.message}"
+      bot.record_webhook_delivery succeeded: false
+      nil
+    end
+
+    def room_payload(room)
+      { id: room.id, name: room.name, reply_to: url_helpers.room_bot_messages_path(room, bot.bot_key) }
+    end
+
+    def uri
+      @uri ||= URI.parse(bot.webhook_url)
+    end
+
+    def post(payload)
+      Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: TIMEOUT, read_timeout: TIMEOUT, write_timeout: TIMEOUT) do |http|
+        request = Net::HTTP::Post.new(uri, "Content-Type" => "application/json", "Accept" => "text/plain, text/html")
+        request.body = payload.to_json
+        http.request(request)
+      end
+    end
+
+    # 200 text/plain or text/html posts the body as the bot's message. Anything
+    # else (204, errors, other content types, empty bodies) posts nothing.
+    def reply_from(response)
+      if response.code == "200" && response.content_type.in?(REPLY_CONTENT_TYPES)
+        body = response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub.strip
+
+        if body.present? && body.bytesize <= MAX_REPLY_SIZE
+          response.content_type == "text/html" ? body : text_to_html(body)
+        end
+      end
+    end
+
+    # Replies count towards the bot's flood limit, like posts through the API.
+    def post_reply_to(room, html)
+      if room.users.include?(bot)
+        bot.post_within_limits { create_message_in room, html }
+      end
+    rescue User::Bot::Suspendable::Suspended, User::Bot::Suspendable::CoolingDown
+      nil
+    end
+
+    # Tells people why the bot didn't answer. It isn't a reply from the bot, so it
+    # doesn't count towards the flood limit, but it's held back while the bot is
+    # cooling down or suspended.
+    def post_timeout_notice_to(room)
+      if room.users.include?(bot) && !bot.suspended? && !bot.cooling_down?
+        create_message_in room, text_to_html("Failed to respond within #{TIMEOUT.inspect}")
+      end
+    end
+
+    def create_message_in(room, html)
+      room.messages.create!(body: html, creator: bot).broadcast_create
+    end
+
+    # The bot is told what was said to it, so its own @-mention is left out.
+    def text_addressed_to_bot(message)
+      mention = Regexp.escape(bot.attachable_plain_text_representation(nil))
+
+      message.plain_text_body
+        .gsub(/#{mention}[,:]?\p{Blank}*/, "")
+        .gsub(/\p{Blank}{2,}/, " ")
+        .gsub(/\p{Blank}+$/, "")
+        .gsub(/\A\p{Space}+|\p{Space}+\z/, "")
+    end
+
+    # Plain-text replies are shown as written, like plain-text bot posts.
+    def text_to_html(text)
+      ERB::Util.html_escape(text).gsub(/\r?\n/, "<br>")
+    end
+
+    def url_helpers
+      Rails.application.routes.url_helpers
+    end
+end
