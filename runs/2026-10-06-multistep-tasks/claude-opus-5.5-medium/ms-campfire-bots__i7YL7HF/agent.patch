+      <span class="for-screen-reader">Bot code</span>
+      <input type="text" class="input" value="<%= bot.bot_key %>" readonly autocomplete="off" spellcheck="false" data-1p-ignore>
+    </label>
+
+    <%= button_to_copy_to_clipboard(bot.bot_key) do %>
+      <span class="for-screen-reader">Copy bot code for <%= bot.name %></span>
+      <%= image_tag "copy-paste.svg", aria: { hidden: "true" }, size: 20, class: "colorize--black" %>
+    <% end %>
+
+    <%= button_to bot_key_path(bot), method: :patch, class: "btn btn--regenerate",
+          data: { turbo_confirm: "Reset the bot code for #{bot.name}? Anything using the current code will stop working." } do %>
+      <%= image_tag "refresh.svg", aria: { hidden: "true" }, size: 20, class: "colorize--black" %>
+      <span class="for-screen-reader">Reset bot code for <%= bot.name %></span>
+    <% end %>
+  </div>
+</li>
