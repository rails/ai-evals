+++ b/test/system/managing_bots_test.rb
@@ -0,0 +1,69 @@
+require "application_system_test_case"
+
+class ManagingBotsTest < ApplicationSystemTestCase
+  setup do
+    sign_in "kevin@37signals.com"
+  end
+
+  test "adding, editing, and deleting a bot" do
+    visit edit_account_url
+    click_on "Set up chat bots"
+
+    click_on "Add a chat bot"
+    fill_in "Name the bot", with: "Release Bot"
+    click_on "Save changes"
+
+    bot = User.bot.find_by!(name: "Release Bot")
+    within "##{dom_id(bot)}" do
+      assert_text "Release Bot"
+      assert_field "Bot code", with: bot.bot_key, readonly: true
+      click_on "Edit Release Bot"
+    end
+
+    fill_in "Name the bot", with: "Ship Bot"
+    click_on "Save changes"
+    assert_text "Ship Bot"
+
+    click_on "Edit Ship Bot"
+    accept_confirm { click_on "Delete this chat bot" }
+
+    assert_no_text "Ship Bot"
+    assert bot.reload.deactivated?
+  end
+
+  test "adding a bot to all open rooms" do
+    visit new_bot_url
+    fill_in "Name the bot", with: "Greeter Bot"
+    assert_no_checked_field "Add to all open rooms", visible: :all
+    check "Add to all open rooms", allow_label_click: true
+    click_on "Save changes"
+    assert_text "Greeter Bot"
+
+    bot = User.bot.find_by!(name: "Greeter Bot")
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+
+    click_on "Edit Greeter Bot"
+    assert_checked_field "Add to all open rooms", visible: :all
+    uncheck "Add to all open rooms", allow_label_click: true
+    click_on "Save changes"
+    assert_text "Greeter Bot"
+
+    assert_not bot.reload.joins_open_rooms?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+  test "reactivating a suspended bot" do
+    sign_in "david@37signals.com"
+    bot = users(:deploy_bot)
+    bot.update! suspended_at: Time.current, suspension_reason: "failing_webhook"
+
+    visit bots_url
+    within "##{dom_id(bot)}" do
+      assert_text "Suspended"
+      assert_text "webhook failed 10 times in a row"
+      accept_confirm { click_on "Reactivate" }
+    end
+
+    assert_no_text "Suspended"
+    assert_not bot.reload.suspended?
+  end
+end
