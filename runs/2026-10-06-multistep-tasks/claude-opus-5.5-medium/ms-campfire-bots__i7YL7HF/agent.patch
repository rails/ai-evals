diff --git a/app/models/membership/grantable.rb b/app/models/membership/grantable.rb
new file mode 100644
index 0000000..26a6493
--- /dev/null
+++ b/app/models/membership/grantable.rb
@@ -0,0 +1,22 @@
+# Every membership is granted through here, so bots hear about each room they join
+# exactly once: memberships that already exist are skipped by the unique index and
+# aren't returned, so re-granting (or racing grants) never sends a second "joined".
+module Membership::Grantable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def grant(attributes)
+      if attributes.present?
+        ids = insert_all(attributes, returning: :id).pluck("id")
+        where(id: ids).welcome_bots_later
+      end
+    end
+
+    # Direct conversations aren't rooms a bot "lands in", so they don't count.
+    def welcome_bots_later
+      without_direct_rooms.joins(:user).merge(User.active_bots.with_webhook).includes(:user, :room).each do |membership|
+        membership.user.deliver_joined_webhook_later(membership.room)
+      end
+    end
+  end
+end
