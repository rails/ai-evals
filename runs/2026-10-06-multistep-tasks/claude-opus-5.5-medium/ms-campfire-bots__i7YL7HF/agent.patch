diff --git a/app/views/bots/index.html.erb b/app/views/bots/index.html.erb
new file mode 100644
index 0000000..8278146
--- /dev/null
+++ b/app/views/bots/index.html.erb
@@ -0,0 +1,50 @@
+<% @page_title = "Chat bots" %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to edit_account_path %>
+  </div>
+<% end %>
+
+<section class="panel flex flex-column gap txt-align-center" style="view-transition-name: bots">
+  <h1 class="txt-large margin-none">Chat bots</h1>
+
+  <p class="txt-subtle margin-none">
+    Bots post messages to their rooms over HTTP. The raw request body becomes the message:
+  </p>
+  <pre class="txt-small txt-align-start pad fill-shade border-radius margin-none" style="overflow-x: auto"><code>curl -d "Deploy finished ✅" \
+  <%= root_url.chomp("/") %>/rooms/&lt;room-id&gt;/&lt;bot-code&gt;/messages</code></pre>
+
+  <p class="txt-subtle margin-none">
+    Give a bot a webhook URL and it gets a JSON <code>POST</code> whenever someone @-mentions it,
+    and a <code>joined</code> event when it’s added to a room.
+    Answer with <code>200</code> and a <code>text/plain</code> or <code>text/html</code> body to reply in the room,
+    or <code>204</code> to stay quiet and post later.
+  </p>
+
+  <p class="txt-subtle margin-none">
+    A bot can post up to 10 messages every 10 seconds; more get a <code>429</code> and a 30-second cooldown.
+    Bots that keep posting during a cooldown, or whose webhook fails 10 times in a row, are suspended
+    until an administrator reactivates them.
+  </p>
+
+  <% if Current.user.reached_bot_limit? %>
+    <p class="txt-subtle margin-none" id="bot_limit">
+      You’ve reached the limit of <%= pluralize Current.user.bot_limit, "chat bot" %> per member.
+      Delete one to add another, or ask an administrator to raise the limit.
+    </p>
+  <% else %>
+    <%= link_to new_bot_path, class: "btn btn--reversed center" do %>
+      <%= image_tag "add.svg", aria: { hidden: "true" }, size: 20 %>
+      <span>Add a chat bot</span>
+    <% end %>
+  <% end %>
+
+  <% if @bots.any? %>
+    <div class="pad-inline fill-shade border-radius">
+      <menu class="flex flex-column gap margin-none pad" id="bots">
+        <%= render partial: "bots/bot", collection: @bots, spacer_template: "bots/spacer" %>
+      </menu>
+    </div>
+  <% end %>
+</section>
