+class User::DeliverJoinedWebhookJob < ApplicationJob
+  # Memberships are often granted inside a transaction (e.g. creating a room), so wait
+  # for it to commit: otherwise the room might not exist yet when the job runs.
+  self.enqueue_after_transaction_commit = true
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bot, room)
+    bot.deliver_joined_webhook(room)
+  end
+end
