diff --git a/docs/bots.md b/docs/bots.md
new file mode 100644
index 0000000..ab10fdf
--- /dev/null
+++ b/docs/bots.md
@@ -0,0 +1,51 @@
+# Chat bots
+
+Bots are members of rooms and post messages over HTTP. They are not a parallel
+identity system: each bot is a `User` (so memberships, avatars, and message
+authorship keep working) plus a `Bot` row that holds the credential and the
+human who created it.
+
+## Managing bots
+
+Any signed-in member can open Account settings (`/account/edit`) and follow
+"Set up chat bots" to `/bots`.
+
+- Members see the bots they created. Administrators see every bot.
+- The list is not paginated. Bot codes are credentials, so the page is the
+  management surface, not a public directory.
+- Creating a bot creates an active user with a random password and a
+  non-routable email (`*@bots.campfire.invalid`). That user joins every open
+  room, the same way a person does. Closed rooms and pings include bots in the
+  existing people pickers.
+- Deleting a bot destroys the credential, removes memberships, and deactivates
+  the user. Messages already posted stay, with the bot's name as the author.
+  A deleted bot cannot post (`401`).
+
+Bots are excluded from the account people list, direct-room placeholders, and
+session-transfer links so they cannot be promoted, banned, or signed in as a
+person. Room membership is unchanged: add a bot the same way you add a person.
+
+## Posting
+
+```
+curl -d "Deploy of v1.2.3 finished ✅" \
+  https://chat.example.com/rooms/<room-id>/<bot-code>/messages
+```
+
+The raw request body is the message body. There is no JSON envelope and no
+field name. The endpoint does not use a session or a CSRF token; the bot code
+in the path is the credential. Treat that URL like a password (HTTPS only).
+
+| Status | When |
+| --- | --- |
+| `201 Created` | Message stored. `Location: /messages/:message_id` |
+| `422 Unprocessable Content` | Empty body and no attachment |
+| `404 Not Found` | Unknown room id, or the bot is not a member of that room |
+| `401 Unauthorized` | Unknown bot code, or the bot has been deleted or deactivated |
+
+A non-text content type (for example `image/png`) is stored as an attachment
+instead of a message body, so a bot can post a file without a form field name.
+Multipart uploads with a file part are accepted the same way.
+
+The message is created as the bot user, then broadcast and pushed through the
+same `Message` callbacks a human post uses.
diff --git a/test/controllers/bot_messages_controller_test.rb b/test/controllers/bot_messages_controller_test.rb
new file mode 100644
index 0000000..9448cc9
--- /dev/null
+++ b/test/controllers/bot_messages_controller_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class BotMessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+    @room = rooms(:hq)
+    assert_includes @room.users, @bot.user
+  end
+
+  test "posts the raw body as the bot and broadcasts it" do
+    expected = "Deploy of v1.2.3 finished ✅"
+
+    assert_difference -> { @room.messages.count }, +1 do
+      assert_enqueued_jobs 1, only: Room::PushMessageJob do
+        post room_bot_messages_url(@room, @bot.code), params: expected.b, headers: { "CONTENT_TYPE" => "text/plain" }
+
+        assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+          assert_select ".message__author", text: /Deploy Bot/
+          assert_select ".message__body", text: /finished/
+        end
+      end
+    end
+
+    message = @room.messages.last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot.user, message.creator
+    assert_equal expected, message.plain_text_body
+  end
+
+  test "accepts a curl-style urlencoded body" do
+    expected = "Deploy of v1.2.3 finished ✅"
+
+    post room_bot_messages_url(@room, @bot.code), params: expected.b, headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    assert_equal expected, @room.messages.last.plain_text_body
+  end
+
+  test "rejects an empty body" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.code), params: "", headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "rejects a blank body" do
+    post room_bot_messages_url(@room, @bot.code), params: "   \n", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :unprocessable_entity
+  end
+
+  test "unknown room is not found" do
+    post room_bot_messages_url("missing-room", @bot.code), params: "hello", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :not_found
+  end
+
+  test "invalid bot code is unauthorized" do
+    post room_bot_messages_url(@room, "not-a-real-code"), params: "hello", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :unauthorized
+  end
+
+  test "a deleted bot can no longer post" do
+    code = @bot.code
+    @bot.destroy!
+
+    post room_bot_messages_url(@room, code), params: "hello", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :unauthorized
+  end
+
+  test "a bot cannot post in a room it has not joined" do
+    closed = rooms(:designers)
+    assert_not_includes closed.users, @bot.user
+
+    post room_bot_messages_url(closed, @bot.code), params: "hello", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :not_found
+  end
+
+  test "a bot can post after it is added to a closed room" do
+    closed = rooms(:watercooler)
+    closed.memberships.grant_to(@bot.user)
+
+    post room_bot_messages_url(closed, @bot.code), params: "shipped", headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :created
+    assert_equal "shipped", closed.messages.last.plain_text_body
+    assert_equal @bot.user, closed.messages.last.creator
+  end
+
+  test "does not require a browser session" do
+    post room_bot_messages_url(@room, @bot.code),
+      params: "from ci",
+      headers: { "CONTENT_TYPE" => "text/plain", "HTTP_USER_AGENT" => "curl/8.7.1" }
+
+    assert_response :created
+    assert_nil cookies[:session_token]
+  end
+
+  test "stores a non-text body as an attachment" do
+    png = file_fixture("pixel.bmp").binread
+
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.code), params: png, headers: { "CONTENT_TYPE" => "image/bmp" }
+    end
+
+    assert_response :created
+    message = @room.messages.last
+    assert message.attachment.attached?
+    assert_equal @bot.user, message.creator
+  end
+
+test "preserves whitespace and literal markup in the raw body" do
+  body = "  indented line
+<script>alert(1)</script>"
+
+  post room_bot_messages_url(@room, @bot.code), params: body.b, headers: { "CONTENT_TYPE" => "text/plain" }
+
+  assert_response :created
+  assert_equal body, @room.messages.last.plain_text_body
+end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..3cff3da
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "account settings links to chat bots" do
+    get edit_account_url
+
+    assert_response :success
+    assert_select "a[aria-label='Set up chat bots'][href='#{bots_path}']"
+  end
+
+  test "index lists only bots created by the member" do
+    own = Bot.create!(name: "Deploy Bot", creator: users(:kevin))
+    other = Bot.create!(name: "Other Bot", creator: users(:david))
+
+    get bots_url
+
+    assert_response :success
+    assert_select "a", text: "Add a chat bot"
+    assert_select "a", text: "Edit Deploy Bot"
+    assert_select "input[readonly][aria-label='Bot code'][value='#{own.code}']"
+    assert_select "label", text: /Bot code/
+    assert_no_match "Edit Other Bot", response.body
+    assert_no_match other.code, response.body
+  end
+
+  test "administrators see every bot" do
+    sign_in :david
+    Bot.create!(name: "Deploy Bot", creator: users(:kevin))
+
+    get bots_url
+
+    assert_response :success
+    assert_select "a", text: "Edit Deploy Bot"
+  end
+
+  test "new bot form" do
+    get new_bot_url
+
+    assert_response :success
+    assert_select "label", text: "Name the bot"
+    assert_select "input[name='bot[name]'][required]"
+    assert_select "input[type=file][name='bot[avatar]']"
+    assert_select "button", text: "Save changes"
+  end
+
+  test "create redirects to the bots list and shows the code" do
+    assert_difference -> { Bot.count }, +1 do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+
+    assert_redirected_to bots_url
+    follow_redirect!
+    bot = Bot.last
+    assert_equal users(:kevin), bot.creator
+    assert_select "input[readonly][value='#{bot.code}']"
+    assert_select "a", text: "Edit Deploy Bot"
+  end
+
+  test "create can attach an avatar" do
+    post bots_url, params: { bot: { name: "Deploy Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+
+    assert_redirected_to bots_url
+    assert Bot.last.user.avatar.attached?
+  end
+
+  test "update changes the name" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:kevin))
+
+    patch bot_url(bot), params: { bot: { name: "Release Bot" } }
+
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+  end
+
+  test "edit page can delete the bot after confirmation" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:kevin))
+
+    get edit_bot_url(bot)
+
+    assert_response :success
+    assert_select "label", text: "Name the bot"
+    assert_select "button", text: "Save changes"
+    assert_select "button", text: /Delete this chat bot/
+    assert_select "[data-turbo-confirm]"
+
+    assert_difference -> { Bot.count }, -1 do
+      delete bot_url(bot)
+    end
+
+    assert_redirected_to bots_url
+  end
+
+  test "a member cannot edit another person's bot" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    assert_raises ActiveRecord::RecordNotFound do
+      get edit_bot_url(bot)
+    end
+
+    assert_raises ActiveRecord::RecordNotFound do
+      patch bot_url(bot), params: { bot: { name: "Hijacked" } }
+    end
+    assert_equal "Deploy Bot", bot.reload.name
+  end
+
+  test "index is not paginated" do
+    3.times { |i| Bot.create!(name: "Bot #{i}", creator: users(:kevin)) }
+
+    get bots_url
+
+    assert_response :success
+    assert_select "a", text: /Edit Bot /, count: 3
+    assert_no_match(/next_page/, response.body)
+  end
+end
