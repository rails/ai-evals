diff --git a/test/models/bot/conduct_test.rb b/test/models/bot/conduct_test.rb
new file mode 100644
index 0000000..8ba09ec
--- /dev/null
+++ b/test/models/bot/conduct_test.rb
@@ -0,0 +1,153 @@
+require "test_helper"
+
+class Bot::ConductTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:hq)
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://example.com/hooks/campfire")
+    @room.memberships.grant_to(@bot.user)
+    @url = "https://example.com/hooks/campfire"
+  end
+
+  test "ten messages in ten seconds are allowed and the eleventh starts a cooldown" do
+    10.times { |i| assert_equal :allowed, Bot::Conduct.reserve(@bot).status, "post #{i} should be allowed" }
+
+    result = Bot::Conduct.reserve(@bot)
+
+    assert result.limited?
+    assert_equal 30, result.retry_after
+    assert_not @bot.reload.suspended?
+    assert @bot.cooldown_until > Time.current
+    assert_equal 0, @bot.cooldown_attempts
+  end
+
+  test "a message older than ten seconds leaves the window" do
+    Bot::Conduct.reserve(@bot)
+    travel 11.seconds do
+      10.times { assert Bot::Conduct.reserve(@bot).allowed? }
+    end
+    assert_nil @bot.reload.cooldown_until
+  end
+
+  test "five attempts during the same cooldown suspend for flooding" do
+    flood_into_cooldown
+
+    4.times do |i|
+      result = Bot::Conduct.screen(@bot)
+      assert result.limited?, "attempt #{i + 1} should still be rate limited"
+      assert_not @bot.reload.suspended?
+    end
+
+    result = Bot::Conduct.screen(@bot)
+    assert result.limited?
+    assert @bot.reload.suspended?
+    assert_equal "Flooding", @bot.suspension_reason
+
+    assert Bot::Conduct.screen(@bot).suspended?
+  end
+
+  test "cooldown attempts do not carry into the next window" do
+    flood_into_cooldown
+    4.times { Bot::Conduct.screen(@bot) }
+    assert_not @bot.reload.suspended?
+
+    travel 31.seconds do
+      assert Bot::Conduct.reserve(@bot).allowed?
+    end
+    assert_equal 0, @bot.reload.cooldown_attempts
+    assert_nil @bot.cooldown_until
+  end
+
+  test "ten failed deliveries in a row suspend for failing webhooks and a success resets" do
+    message = @room.messages.create!(creator: users(:david), body: "hello", client_message_id: "m")
+
+    9.times do
+      WebMock.stub_request(:post, @url).to_return(status: 500)
+      Bot::WebhookDelivery.new(@bot, message).deliver
+    end
+    assert_equal 9, @bot.reload.consecutive_webhook_failures
+    assert_not @bot.suspended?
+
+    WebMock.stub_request(:post, @url).to_return(status: 204)
+    Bot::WebhookDelivery.new(@bot, message).deliver
+    assert_equal 0, @bot.reload.consecutive_webhook_failures
+
+    9.times do
+      WebMock.stub_request(:post, @url).to_return(status: 500)
+      Bot::WebhookDelivery.new(@bot, message).deliver
+    end
+    assert_not @bot.reload.suspended?
+
+    WebMock.stub_request(:post, @url).to_timeout
+    Bot::WebhookDelivery.new(@bot, message).deliver
+    assert @bot.reload.suspended?
+    assert_equal "Failing webhooks", @bot.suspension_reason
+  end
+
+  test "a connection error counts as a failed delivery and a 2xx resets it" do
+    message = @room.messages.create!(creator: users(:david), body: "hello", client_message_id: "m")
+    WebMock.stub_request(:post, @url).to_raise(Errno::ECONNREFUSED)
+
+    Bot::WebhookDelivery.new(@bot, message).deliver
+    assert_equal 1, @bot.reload.consecutive_webhook_failures
+
+    WebMock.stub_request(:post, @url).to_return(status: 201)
+    Bot::WebhookDelivery.new(@bot, message).deliver
+    assert_equal 0, @bot.reload.consecutive_webhook_failures
+  end
+
+  test "a suspended bot receives no webhooks and keeps its room" do
+    @bot.update!(suspended_at: Time.current, suspension_reason: "Flooding")
+    message = @room.messages.create!(creator: users(:david), body: "hello", client_message_id: "m")
+    WebMock.stub_request(:post, @url).to_return(status: 200, body: "nope", headers: { "Content-Type" => "text/plain" })
+
+    assert_no_difference -> { Message.count } do
+      Bot::WebhookDelivery.new(@bot, message).deliver
+    end
+    assert_not_requested :post, @url
+    assert_includes @room.users, @bot.user
+    assert_equal "hello", message.reload.plain_text_body
+  end
+
+  test "webhook replies count toward the rate limit and are not posted during cooldown" do
+    9.times { assert Bot::Conduct.reserve(@bot).allowed? }
+    message = @room.messages.create!(creator: users(:david), body: "hello", client_message_id: "m")
+    WebMock.stub_request(:post, @url).to_return(status: 200, body: "ack", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { @room.messages.count }, +1 do
+      Bot::WebhookDelivery.new(@bot, message).deliver
+    end
+    assert_equal "ack", @room.messages.order(:id).last.plain_text_body
+
+    assert_no_difference -> { Message.count } do
+      Bot::WebhookDelivery.new(@bot, message).deliver
+    end
+    assert @bot.reload.cooldown_until.present?
+    assert_equal "ack", @room.messages.order(:id).last.plain_text_body
+  end
+
+  test "reactivation clears suspension so the bot can post and be called again" do
+    @bot.update!(
+      suspended_at: Time.current,
+      suspension_reason: "Failing webhooks",
+      consecutive_webhook_failures: 10,
+      cooldown_until: 20.seconds.from_now,
+      cooldown_attempts: 3
+    )
+
+    @bot.reactivate!
+
+    assert_not @bot.suspended?
+    assert_nil @bot.suspension_reason
+    assert_equal 0, @bot.consecutive_webhook_failures
+    assert_nil @bot.cooldown_until
+    assert Bot::Conduct.reserve(@bot).allowed?
+  end
+
+  private
+    def flood_into_cooldown
+      10.times { Bot::Conduct.reserve(@bot) }
+      result = Bot::Conduct.reserve(@bot)
+      assert result.limited?
+      @bot.reload
+    end
+end
diff --git a/test/models/bot/joined_webhook_test.rb b/test/models/bot/joined_webhook_test.rb
new file mode 100644
index 0000000..9addb99
--- /dev/null
+++ b/test/models/bot/joined_webhook_test.rb
@@ -0,0 +1,186 @@
+require "test_helper"
+
+class Bot::JoinedWebhookTest < ActiveSupport::TestCase
+  include Rails.application.routes.url_helpers
+
+  setup do
+    @url = "https://example.com/hooks/campfire"
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: @url)
+    clear_enqueued_jobs
+  end
+
+  test "adding a bot to a room sends joined exactly once" do
+    room = rooms(:watercooler)
+    payloads = []
+    WebMock.stub_request(:post, @url).with { |request|
+      payloads << JSON.parse(request.body)
+      true
+    }.to_return(status: 204)
+
+    assert_enqueued_jobs 1, only: Bot::DeliverJoinedWebhookJob do
+      room.memberships.grant_to(@bot.user)
+    end
+    assert_no_enqueued_jobs only: Bot::DeliverJoinedWebhookJob do
+      room.memberships.grant_to(@bot.user)
+    end
+
+    perform_enqueued_jobs only: Bot::DeliverJoinedWebhookJob
+
+    assert_equal 1, payloads.size
+    assert_equal "joined", payloads.first["event"]
+    assert_equal room.id, payloads.first["room"]["id"]
+    assert_equal "All Talk", payloads.first["room"]["name"]
+    assert_equal "/rooms/#{room.id}/#{@bot.code}/messages", payloads.first["room"]["reply_to"]
+    assert_nil payloads.first["message"]
+    assert_nil payloads.first["author"]
+    assert_requested :post, @url, times: 1
+  end
+
+  test "a direct conversation does not send joined" do
+    room = nil
+    assert_no_enqueued_jobs only: Bot::DeliverJoinedWebhookJob do
+      room = Rooms::Direct.create_for({ creator: users(:david) }, users: [ users(:david), @bot.user ])
+    end
+
+    assert room.direct?
+    assert_includes room.users, @bot.user
+  end
+
+  test "creating a bot with the switch and a webhook sends joined once per open room" do
+    assert_enqueued_jobs Rooms::Open.count, only: Bot::DeliverJoinedWebhookJob do
+      Bot.create!(name: "Hello Bot", creator: users(:david), webhook_url: @url, add_to_all_open_rooms: true)
+    end
+  end
+
+  test "opting into open rooms sends joined once per open room" do
+    open_rooms = Rooms::Open.order(:id).to_a
+
+    assert_enqueued_jobs open_rooms.size, only: Bot::DeliverJoinedWebhookJob do
+      @bot.update!(add_to_all_open_rooms: true)
+    end
+
+    payloads = []
+    WebMock.stub_request(:post, @url).with { |request| payloads << JSON.parse(request.body); true }.to_return(status: 204)
+    perform_enqueued_jobs only: Bot::DeliverJoinedWebhookJob
+
+    assert_equal open_rooms.map(&:id).sort, payloads.map { |payload| payload["room"]["id"] }.sort
+    assert payloads.all? { |payload| payload["event"] == "joined" }
+  end
+
+  test "a new open room sends joined to opted-in bots only" do
+    @bot.update!(add_to_all_open_rooms: true)
+    quiet = Bot.create!(name: "Quiet Bot", creator: users(:david), webhook_url: "https://example.com/hooks/quiet")
+    clear_enqueued_jobs
+
+    room = nil
+    assert_enqueued_jobs 1, only: Bot::DeliverJoinedWebhookJob do
+      room = Rooms::Open.create!(name: "Ops", creator: users(:david))
+    end
+
+    assert_includes room.users, @bot.user
+    assert_includes room.users, users(:david)
+    assert_not_includes room.users, quiet.user
+
+    payload = nil
+    WebMock.stub_request(:post, @url).with { |request| payload = JSON.parse(request.body); true }.to_return(status: 204)
+    perform_enqueued_jobs only: Bot::DeliverJoinedWebhookJob
+
+    assert_equal "joined", payload["event"]
+    assert_equal room.id, payload["room"]["id"]
+    assert_equal "Ops", payload["room"]["name"]
+    assert_equal "/rooms/#{room.id}/#{@bot.code}/messages", payload["room"]["reply_to"]
+    assert_not_requested :post, "https://example.com/hooks/quiet"
+  end
+
+  test "opening a closed room sends joined only to opted-in bots who were not already members" do
+    @bot.update!(add_to_all_open_rooms: true)
+    clear_enqueued_jobs
+    room = rooms(:designers)
+    assert_not_includes room.users, @bot.user
+
+    assert_enqueued_jobs 1, only: Bot::DeliverJoinedWebhookJob do
+      room.becomes!(Rooms::Open).update!(name: room.name)
+    end
+
+    assert_includes Room.find(room.id).users, @bot.user
+    assert_equal "Rooms::Open", Room.find(room.id).type
+  end
+
+  test "a person adding a bot to a closed room sends joined" do
+    room = rooms(:designers)
+
+    assert_enqueued_jobs 1, only: Bot::DeliverJoinedWebhookJob do
+      room.memberships.revise(granted: [ @bot.user ])
+    end
+    assert_includes room.users, @bot.user
+  end
+
+  test "a 200 text reply to joined is posted as the bot" do
+    room = rooms(:watercooler)
+    room.memberships.grant_to(@bot.user)
+    WebMock.stub_request(:post, @url).to_return(status: 200, body: "hello from the bot", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { room.messages.count }, +1 do
+      perform_enqueued_jobs only: Bot::DeliverJoinedWebhookJob
+    end
+
+    reply = room.messages.order(:id).last
+    assert_equal @bot.user, reply.creator
+    assert_equal "hello from the bot", reply.plain_text_body
+  end
+
+  test "a 200 html reply to joined is posted as rich text" do
+    room = rooms(:watercooler)
+    room.memberships.grant_to(@bot.user)
+    WebMock.stub_request(:post, @url).to_return(
+      status: 200,
+      body: "<div><strong>hello</strong></div>",
+      headers: { "Content-Type" => "text/html" }
+    )
+
+    perform_enqueued_jobs only: Bot::DeliverJoinedWebhookJob
+
+    reply = room.messages.order(:id).last
+    assert_equal @bot.user, reply.creator
+    assert_equal "hello", reply.plain_text_body
+    assert_includes reply.body.to_s, "hello"
+  end
+
+  test "a bot without a webhook is still added but not called" do
+    quiet = Bot.create!(name: "Quiet Bot", creator: users(:david))
+
+    assert_no_enqueued_jobs only: Bot::DeliverJoinedWebhookJob do
+      rooms(:watercooler).memberships.grant_to(quiet.user)
+    end
+
+    assert_includes rooms(:watercooler).users, quiet.user
+  end
+
+  test "removing and adding a bot again sends joined again" do
+    room = rooms(:watercooler)
+    room.memberships.grant_to(@bot.user)
+    clear_enqueued_jobs
+    room.memberships.revoke_from(@bot.user)
+
+    assert_enqueued_jobs 1, only: Bot::DeliverJoinedWebhookJob do
+      room.memberships.grant_to(@bot.user)
+    end
+  end
+
+  test "people still join a new open room" do
+    user = User.create!(name: "New Person", email_address: "new-person@example.com", password: "secret123456")
+    room = Rooms::Open.create!(name: "Later", creator: users(:david))
+
+    assert_includes room.users, user
+    assert_includes user.rooms, rooms(:hq)
+  end
+
+test "a suspended bot is not told it joined a room" do
+  @bot.update!(suspended_at: Time.current, suspension_reason: "Failing webhooks")
+
+  assert_no_enqueued_jobs only: Bot::DeliverJoinedWebhookJob do
+    rooms(:watercooler).memberships.grant_to(@bot.user)
+  end
+  assert_includes rooms(:watercooler).users, @bot.user
+end
+end
diff --git a/test/models/bot/webhook_delivery_test.rb b/test/models/bot/webhook_delivery_test.rb
