+    <p class="margin-none">You've <span>reached the limit</span>.</p>
+  <% else %>
+    <%= link_to new_bot_path, class: "btn btn--reversed center" do %>
+      <%= image_tag "add.svg", size: 20, aria: { hidden: "true" } %>
+      Add a chat bot
+    <% end %>
+  <% end %>
+
+  <% if @bots.any? %>
+    <menu class="flex flex-column gap margin-none pad unpad-inline">
+      <% @bots.each do |bot| %>
+        <li class="flex flex-column gap margin-none pad fill-shade border-radius">
+          <div class="flex align-center gap">
+            <figure class="avatar flex-item-no-shrink" style="--avatar-size: 3.75ch;">
+              <%= avatar_tag bot.user %>
+            </figure>
+
+            <div class="min-width flex-item-grow txt-align-start">
+              <div class="overflow-ellipsis"><strong><%= bot.name %></strong></div>
+              <% if bot.suspended? %>
+                <div class="txt-small txt-negative">Suspended</div>
+                <div class="txt-small"><%= bot.suspension_reason %></div>
+              <% end %>
+            </div>
+
+            <%= link_to "Edit #{bot.name}", edit_bot_path(bot), class: "btn txt-small flex-item-no-shrink" %>
+          </div>
+
+          <% if bot.suspended? && Current.user.administrator? %>
+            <%= button_to bot_reactivation_path(bot), method: :post, class: "btn txt-small align-self-start",
+                  aria: { label: "Reactivate" },
+                  data: { turbo_confirm: "Are you sure you want to reactivate this bot?" } do %>Reactivate<% end %>
+          <% end %>
+
+          <label class="flex flex-column gap txt-align-start" for="<%= dom_id(bot, :code) %>" style="--row-gap: 0.4em">
+            Bot code
+            <input type="text" id="<%= dom_id(bot, :code) %>" class="input" value="<%= bot.code %>" readonly autocomplete="off" spellcheck="false" aria-label="Bot code">
+          </label>
+        </li>
+      <% end %>
+    </menu>
+  <% end %>
+</section>
