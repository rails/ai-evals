+module Api
+  module V1
+    class InvitationsController < ApplicationController
+      before_action :authenticate_user!
+      before_action :ensure_admin!
+      before_action :ensure_account_active!, only: [ :create, :resend, :revoke ]
+      before_action :set_invitation, only: [ :show, :resend, :revoke ]
+
+      def index
+        scope = @current_account.invitations.ordered
+        scope = scope.with_status(params[:status]) if params[:status].present?
+        render_list(scope, :invitations) { |invitation| invitation.as_json }
+      end
+
+      def show
+        return if performed?
+        render json: { invitation: @invitation }
+      end
+
+      def create
+        invitation = Invitation.issue!(
+          account: @current_account,
+          inviter: @current_user,
+          email: invitation_params[:email],
+          role: invitation_params[:role]
+        )
+        render json: { invitation: invitation }, status: :created
+      end
+
+      def resend
+        return if performed?
+        @invitation.resend!
+        render json: { invitation: @invitation }
+      end
+
+      def revoke
+        return if performed?
+        @invitation.revoke!
+        render json: { invitation: @invitation }
+      end
+
+      private
+        def set_invitation
+          return if performed?
+          @invitation = @current_account.invitations.find_by(id: params[:id])
+          render_error("Invitation not found", :not_found) unless @invitation
+        end
+
+        def invitation_params
+          params.require(:invitation).permit(:email, :role)
+        end
+    end
+  end
+end
