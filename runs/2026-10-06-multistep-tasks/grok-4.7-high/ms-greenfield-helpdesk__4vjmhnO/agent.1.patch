+        end
+
+        if new_password.blank?
+          render_error("Password can't be blank", :unprocessable_entity)
+          return
+        end
+
+        user.change_password!(new_password)
+        render json: { user: user, account: @current_account }
+      rescue ActiveRecord::RecordInvalid => exception
+        render_validation_errors(exception.record)
+      end
+
+      private
+        def reset_params
+          params.require(:password_reset).permit(:email, :token, :password)
+        end
