+    assert_equal "jo@acme.test", body["user"]["email"]
+    assert_equal "admin", body["user"]["role"]
+    assert_equal false, body["user"]["verified"]
+    assert body["user"]["created_at"].present?
+    assert body["user"]["updated_at"].present?
+    assert_nil body.dig("user", "password_digest")
+    assert_nil body.dig("user", "email_verification_token")
+
+    mail = ActionMailer::Base.deliveries.last
