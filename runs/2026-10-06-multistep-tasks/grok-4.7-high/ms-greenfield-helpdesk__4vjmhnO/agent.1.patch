+module Api
+  module V1
+    class PasswordResetsController < ApplicationController
+      def create
+        email = reset_params[:email].to_s.strip.downcase
+        if email.blank?
+          render_error("Email can't be blank", :unprocessable_entity)
+          return
+        end
+
+        user = @current_account.users.find_by(email: email)
+        if user
+          user.regenerate_password_reset_token!
+          UserMailer.password_reset(user).deliver_now
+        end
+
+        render json: { password_reset: { email: email } }
+      end
+
+      def confirm
+        token = reset_params[:token].to_s
+        new_password = reset_params[:password].to_s
