@@ -0,0 +1,52 @@
+module Api
+  module V1
+    class AccountsController < ApplicationController
+      skip_before_action :set_current_account, only: :create
+      before_action :authenticate_user!, except: :create
+      before_action :require_owner!, only: [ :cancel, :reactivate ]
+
+      def create
+        admin = account_params[:admin]
+        if admin.blank?
+          render_error("Admin details are required", :unprocessable_entity)
+          return
+        end
+
+        account, user = Account.register!(
+          name: account_params[:name],
+          subdomain: account_params[:subdomain],
+          admin: {
+            name: admin[:name],
+            email: admin[:email],
+            password: admin[:password]
+          }
+        )
+        render json: { account: account, user: user }, status: :created
+      end
+
+      def show
+        render json: { account: @current_account }
+      end
+
+      def cancel
+        if @current_account.cancelled?
+          render_error("Account is already cancelled", :unprocessable_entity)
+          return
+        end
+
+        @current_account.cancel!
+        render json: { account: @current_account.reload }
+      end
+
+      def reactivate
+        @current_account.reactivate!
+        render json: { account: @current_account.reload }
+      end
+
+      private
+        def account_params
+          params.require(:account).permit(:name, :subdomain, admin: [ :name, :email, :password ])
+        end
+    end
+  end
+end
