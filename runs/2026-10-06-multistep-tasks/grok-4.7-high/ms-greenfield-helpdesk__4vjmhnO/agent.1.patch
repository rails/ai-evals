+    assert_match %r{http://localhost:3001/reset-password\?account=acme&token=#{first_reset}}, ActionMailer::Base.deliveries.last.body.to_s
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_header("acme"),
+      as: :json
+    second_reset = reset_token_from_mail
+    refute_equal first_reset, second_reset
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: first_reset, password: "should-not-work" } },
+      headers: account_header("acme"),
