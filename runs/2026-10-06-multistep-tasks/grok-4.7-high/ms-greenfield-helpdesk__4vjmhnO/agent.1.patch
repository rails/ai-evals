+    assert_equal [ "support@example.test" ], mail.from
+    assert_match %r{\Ahttp://localhost:3001/verify-email\?account=acme&token=[0-9a-f]+\s*\z}, mail.body.to_s.lines.grep(/verify-email/).first.to_s.strip
+    token = verification_token_from_mail(mail)
