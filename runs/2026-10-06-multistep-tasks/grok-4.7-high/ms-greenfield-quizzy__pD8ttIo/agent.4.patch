+<section class="cover cover--blue cover--calm<%= " cover--board" if @game.finished? %>">
+  <div class="screen">
+    <div class="screen__top">
+      <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span><%= @quiz.title %></span>
+    </div>
+    <div class="screen__body<%= " screen__body--board" if @game.finished? %>">
+      <% if @game.lobby? %>
+        <div class="lobby">
+          <div>
+            <h1 class="lobby__title"><%= @quiz.title %></h1>
+            <p class="lobby__join">Join at</p>
+            <p class="lobby__url"><%= @join_url %></p>
+            <div class="counter-pill"
+                 data-controller="live"
+                 data-live-mode-value="text"
+                 data-live-url-value="<%= counter_moderate_quiz_game_path(@quiz, @game) %>"
+                 data-live-signature-value="<%= @counter_text %>"
+                 data-live-code-value="<%= @game.code %>"
+                 data-live-interval-value="100"
+                 aria-live="polite"><%= @counter_text %></div>
+          </div>
+          <div class="qr" role="img" aria-label="QR code"><%= @qr_svg %></div>
+        </div>
+      <% elsif (@game.question? || @game.results?) && @question %>
+        <div class="stage-question__num">Question <%= @game.question_number %> of <%= @game.question_total %></div>
+        <div class="answers-counter"
+             data-controller="live"
+             data-live-mode-value="text"
+             data-live-url-value="<%= counter_moderate_quiz_game_path(@quiz, @game) %>"
+             data-live-signature-value="<%= @counter_text %>"
+             data-live-code-value="<%= @game.code %>"
+             data-live-interval-value="100"
+             aria-live="polite"><%= @counter_text %></div>
+        <div class="stage-question__body"><%= @question.body %></div>
+        <ol class="stage-options<%= " stage-options--results" if @game.results? %>">
+          <% @question.ordered_options.each_with_index do |option, index| %>
+            <% count = @option_counts[option.id].to_i %>
+            <% share = @answer_total.to_i.zero? ? 0 : (count * 100.0 / @answer_total).round %>
+            <li class="stage-option<%= " is-correct" if @game.results? && option.correct? %>"<% if @game.results? %> style="--share: <%= share %>%"<% end %>>
+              <% if @game.results? %>
+                <span class="stage-option__bar" aria-hidden="true"></span>
+              <% end %>
+              <span class="stage-option__letter"><%= option_letter(index) %></span>
+              <span class="stage-option__title"><%= option.body %></span>
+              <% if @game.results? %>
+                <span class="stage-option__count"><%= count %></span>
+                <% if option.correct? %>
+                  <span class="stage-option__mark">Correct</span>
+                <% end %>
+              <% end %>
+            </li>
+          <% end %>
+        </ol>
+      <% elsif @game.finished? %>
+        <div class="leaderboard-layout">
+          <div>
+            <p class="screen__kicker"><%= @quiz.title %></p>
+            <h1 class="leaderboard-layout__title">The quiz is over</h1>
+          </div>
+          <ol class="leaderboard">
+            <% @standings.each do |row| %>
+              <li class="leader<%= " is-winner" if row.winner? %><%= " is-tied" if row.tied? %>">
+                <span class="leader__place"><%= row.place %></span>
+                <span class="leader__name">
+                  <span class="leader__who"><%= row.player.name %></span>
+                  <% if row.winner? %><span class="leader__badge">Winner</span><% end %>
+                </span>
+                <span class="leader__score"><%= points_label(row.points) %></span>
+              </li>
+            <% end %>
+          </ol>
+        </div>
+      <% else %>
+        <div>
+          <p class="screen__kicker"><%= @quiz.title %></p>
+          <h1 class="lobby__title">The quiz is over</h1>
+        </div>
+      <% end %>
+    </div>
+  </div>
+</section>
+<div class="screen-controls">
+  <div class="screen-controls__info">
+    <% if @game.question? || @game.results? %>
+      <span class="answers-counter"
+            data-controller="live"
+            data-live-mode-value="text"
+            data-live-url-value="<%= counter_moderate_quiz_game_path(@quiz, @game) %>"
+            data-live-signature-value="<%= @counter_text %>"
+            data-live-code-value="<%= @game.code %>"
+            data-live-interval-value="100"
+            aria-live="polite"><%= @counter_text %></span>
+    <% end %>
+    <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
+  </div>
+  <div class="buttons">
+    <% live_form = { data: { turbo: false, live_submit: "1" } } %>
+    <% if @game.lobby? %>
+      <%= button_to "Start", start_moderate_quiz_game_path(@quiz, @game), class: "btn btn--pink btn--lg", form: live_form %>
+    <% elsif @game.question? %>
+      <%= button_to "Finish", finish_moderate_quiz_game_path(@quiz, @game), class: "btn btn--pink btn--lg", form: live_form %>
+    <% elsif @game.results? %>
+      <%= button_to (@game.last_question? ? "End quiz" : "Next"), advance_moderate_quiz_game_path(@quiz, @game), class: "btn btn--pink btn--lg", form: live_form %>
+    <% elsif @game.finished? %>
+      <%= button_to "Top #{@game.winner_limit}", top_moderate_quiz_game_path(@quiz, @game), class: "btn btn--pink btn--lg", form: live_form %>
+      <%= button_to "Draw", draw_moderate_quiz_game_path(@quiz, @game), class: "btn btn--lg", form: live_form %>
+      <%= button_to "Reset winners", reset_winners_moderate_quiz_game_path(@quiz, @game), class: "btn btn--ghost btn--lg", form: live_form %>
+    <% end %>
+  </div>
+</div>
