+        <div class="answers-counter"
+             data-controller="live"
+             data-live-mode-value="text"
+             data-live-url-value="<%= counter_moderate_quiz_game_path(@quiz, @game) %>"
+             data-live-signature-value="<%= @counter_text %>"
+             data-live-code-value="<%= @game.code %>"
+             data-live-phase-value="<%= @game.phase %>"
+             data-live-interval-value="500"
+             aria-live="polite"><%= @counter_text %></div>
+        <div class="stage-question__body"><%= @question.body %></div>
+        <ol class="stage-options<%= " stage-options--results" if @game.results? %>">
