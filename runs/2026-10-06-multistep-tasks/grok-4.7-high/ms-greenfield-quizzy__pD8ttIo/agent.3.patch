+<% if @game.finished? %>
+  <h1 class="play-title">The quiz is over</h1>
+<% elsif @player.nil? %>
+  <h1 class="play-title"><%= @quiz.title %></h1>
+  <p class="play-lead">Enter your name to play along.</p>
+  <% if @error.present? %>
+    <div class="errors" role="alert"><%= @error %></div>
+  <% end %>
+  <%= form_with url: join_play_path(@game.code), class: "join-form", data: { turbo: false } do %>
+    <label for="player_name">Your name</label>
+    <%= text_field_tag :name, @name, id: "player_name", class: "input", maxlength: 120, autocomplete: "nickname", required: true %>
+    <button type="submit" class="btn btn--pink">Join</button>
+  <% end %>
+<% elsif @game.lobby? %>
+  <div class="waiting">
+    <div class="waiting__gem" aria-hidden="true">?</div>
+    <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+    <p class="play-lead">Waiting for the quiz to start.</p>
+  </div>
+<% elsif @game.question? && @question %>
+  <div class="play-question__num">Question <%= @question_number %> of <%= @question_total %></div>
+  <div class="play-question__body"><%= @question.body %></div>
+  <div class="play-options">
+    <% @question.ordered_options.each_with_index do |option, index| %>
+      <% picked = @picked&.option_id == option.id %>
+      <%= form_with url: answer_play_path(@game.code), data: { turbo: false, live_submit: "1" } do %>
+        <%= hidden_field_tag :question_id, @question.id %>
+        <%= hidden_field_tag :option_id, option.id %>
+        <button type="submit" class="play-option<%= " is-picked" if picked %>">
+          <span class="play-option__letter"><%= option_letter(index) %></span>
+          <span class="play-option__title"><%= option.body %></span>
+          <% if picked %>
+            <span class="play-option__mark">Your answer</span>
+          <% end %>
+        </button>
+      <% end %>
+    <% end %>
+  </div>
+<% elsif @game.results? && @question %>
+  <div class="play-question__num">Question <%= @question_number %> of <%= @question_total %></div>
+  <div class="play-question__body"><%= @question.body %></div>
+  <div class="play-options is-locked">
+    <% @question.ordered_options.each_with_index do |option, index| %>
+      <% picked = @picked&.option_id == option.id %>
+      <div class="play-option<%= " is-picked" if picked %>">
+        <span class="play-option__letter"><%= option_letter(index) %></span>
+        <span class="play-option__title"><%= option.body %></span>
+        <% if picked %>
+          <span class="play-option__mark">Your answer</span>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+  <% if @result == :right %>
+    <div class="play-status play-status--right">Correct!</div>
+  <% elsif @result == :wrong %>
+    <div class="play-status play-status--wrong">Wrong!</div>
+  <% else %>
+    <div class="play-status play-status--neutral">No answer</div>
+  <% end %>
+<% else %>
+  <h1 class="play-title">The quiz is over</h1>
+<% end %>
