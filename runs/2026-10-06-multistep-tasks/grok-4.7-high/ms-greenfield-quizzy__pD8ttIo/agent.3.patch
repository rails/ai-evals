+# Local QR rendering. Nothing is fetched from the network.
+class JoinQr
+  def self.svg(text)
+    qr = RQRCode::QRCode.new(text.to_s, level: :m)
+    svg = qr.as_svg(
+      offset: 2,
+      color: "000",
+      fill: "fff",
+      shape_rendering: "crispEdges",
+      module_size: 8,
+      standalone: true,
+      use_path: true,
