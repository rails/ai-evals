diff --git a/app/views/moderate/quizzes/preview.html.erb b/app/views/moderate/quizzes/preview.html.erb
new file mode 100644
index 0000000..7be74f4
--- /dev/null
+++ b/app/views/moderate/quizzes/preview.html.erb
@@ -0,0 +1,84 @@
+<% content_for :title, "Preview · #{@quiz.title} · Quizzy" %>
+<div class="preview-banner">
+  <span>Preview · <%= @quiz.title %></span>
+  <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
+</div>
+<div class="play">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @quiz.title %></span>
+  </div>
+
+  <% if @total.zero? %>
+    <div class="play__body">
+      <div class="play-question__body">No active questions</div>
+      <p class="play-lead">Turn a question on to preview it.</p>
+      <%= render "start_over" %>
+    </div>
+  <% elsif @done %>
+    <div class="play__body">
+      <div class="result-card">
+        <div class="result-card__label">Preview complete</div>
+        <div class="result-card__score">Score: <%= @score %>/<%= @total %></div>
+      </div>
+      <div class="buttons" style="justify-content: center; margin-top: 28px">
+        <%= render "start_over" %>
+        <%= link_to "Back to quiz", moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+      </div>
+    </div>
+  <% else %>
+    <% options = @question.ordered_options %>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= @index + 1 %> of <%= @total %></div>
+      <div class="play-question__body"><%= @question.body %></div>
+      <div class="play-options<%= " is-revealed is-locked" if @revealed %>">
+        <% options.each_with_index do |option, option_index| %>
+          <% if @revealed %>
+            <div class="play-option<%= " is-correct" if option.correct? %><%= " is-picked" if option.id == @picked_id %>">
+              <span class="play-option__letter"><%= option_letter(option_index) %></span>
+              <span class="play-option__title"><%= option.body %></span>
+              <% if option.correct? %>
+                <span class="play-option__mark">✓</span>
+              <% end %>
+            </div>
+          <% else %>
+            <form action="<%= preview_moderate_quiz_path(@quiz) %>" method="get">
+              <input type="hidden" name="i" value="<%= @index %>">
+              <input type="hidden" name="picks" value="<%= (@picks[0...@index] + [option.id]).join(",") %>">
+              <button type="submit" class="play-option">
+                <span class="play-option__letter"><%= option_letter(option_index) %></span>
+                <span class="play-option__title"><%= option.body %></span>
+              </button>
+            </form>
+          <% end %>
+        <% end %>
+      </div>
+
+      <% if @revealed %>
+        <div class="play-status <%= @correct_pick ? "play-status--right" : "play-status--wrong" %>">
+          <%= @correct_pick ? "Correct!" : "Wrong!" %>
+        </div>
+        <div class="buttons" style="margin-top: 20px">
+          <% if @index < @total - 1 %>
+            <form action="<%= preview_moderate_quiz_path(@quiz) %>" method="get">
+              <input type="hidden" name="i" value="<%= @index + 1 %>">
+              <input type="hidden" name="picks" value="<%= @picks[0..@index].join(",") %>">
+              <button type="submit" class="btn btn--pink">Next question</button>
+            </form>
+          <% else %>
+            <form action="<%= preview_moderate_quiz_path(@quiz) %>" method="get">
+              <input type="hidden" name="done" value="1">
+              <input type="hidden" name="picks" value="<%= @picks[0..@index].join(",") %>">
+              <button type="submit" class="btn btn--pink">See score</button>
+            </form>
+          <% end %>
+          <%= render "start_over" %>
+        </div>
+      <% else %>
+        <div class="buttons" style="margin-top: 20px">
+          <%= render "start_over" %>
+        </div>
+      <% end %>
+    </div>
+  <% end %>
+</div>
diff --git a/app/views/moderate/quizzes/show.html.erb b/app/views/moderate/quizzes/show.html.erb
new file mode 100644
index 0000000..b800704
--- /dev/null
+++ b/app/views/moderate/quizzes/show.html.erb
@@ -0,0 +1,72 @@
+<% content_for :title, "#{@quiz.title} · Quizzy" %>
+<% active_count = @questions.count(&:active?) %>
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head">
+  <div>
+    <h1><%= @quiz.title %></h1>
+    <div class="meta mt-2">
+      <%= active_count %> of <%= @questions.size %> questions active ·
+      <%= link_to "Settings", edit_moderate_quiz_path(@quiz) %>
+    </div>
+  </div>
+  <div class="buttons">
+    <%= button_to "Start a game", moderate_quiz_games_path(@quiz), class: "btn btn--pink", form: { data: { turbo: false } } %>
+    <%= link_to "Export", export_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+    <%= link_to "Preview", preview_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+  </div>
+</div>
+
+<section class="section mt-0">
+  <div class="section-head">
+    <h2>Questions</h2>
+    <form action="<%= new_moderate_quiz_question_path(@quiz) %>" method="get">
+      <button type="submit" class="btn">Add question</button>
+    </form>
+  </div>
+
+  <% if @questions.any? %>
+    <ul class="question-list">
+      <% active_number = 0 %>
+      <% @questions.each_with_index do |question, index| %>
+        <% active_number += 1 if question.active? %>
+        <li class="card question-item<%= " question-item--inactive" unless question.active? %>" id="question_<%= question.id %>">
+          <div class="question-item__num"><%= question.active? ? active_number : "—" %></div>
+          <div>
+            <div class="question-item__body"><%= question.body %></div>
+            <ul class="question-item__options">
+              <% question.ordered_options.each_with_index do |option, option_index| %>
+                <li class="<%= "is-correct" if option.correct? %>"><%= option_letter(option_index) %>. <%= option.body %></li>
+              <% end %>
+            </ul>
+          </div>
+          <div class="question-item__actions">
+            <div class="buttons">
+              <%= form_with url: move_moderate_quiz_question_path(@quiz, question), method: :patch do %>
+                <%= hidden_field_tag :direction, "up", id: nil %>
+                <button type="submit" class="btn btn--ghost btn--sm" <%= "disabled" if index.zero? %>>Move up</button>
+              <% end %>
+              <%= form_with url: move_moderate_quiz_question_path(@quiz, question), method: :patch do %>
+                <%= hidden_field_tag :direction, "down", id: nil %>
+                <button type="submit" class="btn btn--ghost btn--sm" <%= "disabled" if index == @questions.size - 1 %>>Move down</button>
+              <% end %>
+            </div>
+            <%= form_with url: toggle_active_moderate_quiz_question_path(@quiz, question), method: :patch do %>
+              <label class="checkbox" for="question_<%= question.id %>_active">
+                <%= check_box_tag :active, "1", question.active?, id: "question_#{question.id}_active", aria: { label: "Active" }, onchange: "this.form.requestSubmit()" %>
+                Active
+              </label>
+            <% end %>
+            <div class="buttons">
+              <%= link_to "Edit", edit_moderate_quiz_question_path(@quiz, question), class: "btn btn--sm" %>
+              <%= form_with url: moderate_quiz_question_path(@quiz, question), method: :delete do %>
+                <button type="submit" class="btn btn--sm btn--danger" onclick="return confirm('Delete this question?')">Delete</button>
+              <% end %>
+            </div>
+          </div>
+        </li>
+      <% end %>
+    </ul>
+  <% else %>
+    <div class="empty">No questions yet.</div>
+  <% end %>
+</section>
diff --git a/app/views/play/_body.html.erb b/app/views/play/_body.html.erb
new file mode 100644
index 0000000..68cd617
--- /dev/null
+++ b/app/views/play/_body.html.erb
@@ -0,0 +1,73 @@
+<% if @game.finished? && @player && @standing %>
+  <h1 class="play-title">The quiz is over</h1>
+  <div class="result-card">
+    <div class="result-card__place"><span class="result-card__prefix">Place</span><%= @standing.place %></div>
+    <p class="result-card__label">Place <%= @standing.place %> of <%= @player_total %></p>
+    <p class="result-card__score"><%= points_label(@standing.points) %></p>
+  </div>
+  <% if @standing.winner? %>
+    <div class="winner-banner">You won!</div>
+  <% end %>
+<% elsif @game.finished? %>
+  <h1 class="play-title">The quiz is over</h1>
+<% elsif @player.nil? %>
+  <h1 class="play-title"><%= @quiz.title %></h1>
+  <p class="play-lead">Enter your name to play along.</p>
+  <% if @error.present? %>
+    <div class="errors" role="alert"><%= @error %></div>
+  <% end %>
+  <%= form_with url: join_play_path(@game.code), class: "join-form", data: { turbo: false } do %>
+    <label for="player_name">Your name</label>
+    <%= text_field_tag :name, @name, id: "player_name", class: "input", maxlength: 120, autocomplete: "nickname", required: true %>
+    <button type="submit" class="btn btn--pink">Join</button>
+  <% end %>
+<% elsif @game.lobby? %>
+  <div class="waiting">
+    <div class="waiting__gem" aria-hidden="true">?</div>
+    <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+    <p class="play-lead">Waiting for the quiz to start.</p>
+  </div>
+<% elsif @game.question? && @question %>
+  <div class="play-question__num">Question <%= @question_number %> of <%= @question_total %></div>
+  <div class="play-question__body"><%= @question.body %></div>
+  <div class="play-options">
+    <% @question.ordered_options.each_with_index do |option, index| %>
+      <% picked = @picked&.option_id == option.id %>
+      <%= form_with url: answer_play_path(@game.code), data: { turbo: false, live_submit: "1" } do %>
+        <%= hidden_field_tag :question_id, @question.id %>
+        <%= hidden_field_tag :option_id, option.id %>
+        <button type="submit" class="play-option<%= " is-picked" if picked %>">
+          <span class="play-option__letter"><%= option_letter(index) %></span>
+          <span class="play-option__title"><%= option.body %></span>
+          <% if picked %>
+            <span class="play-option__mark">Your answer</span>
+          <% end %>
+        </button>
+      <% end %>
+    <% end %>
+  </div>
+<% elsif @game.results? && @question %>
+  <div class="play-question__num">Question <%= @question_number %> of <%= @question_total %></div>
+  <div class="play-question__body"><%= @question.body %></div>
+  <div class="play-options is-locked">
+    <% @question.ordered_options.each_with_index do |option, index| %>
+      <% picked = @picked&.option_id == option.id %>
+      <div class="play-option<%= " is-picked" if picked %>">
+        <span class="play-option__letter"><%= option_letter(index) %></span>
+        <span class="play-option__title"><%= option.body %></span>
+        <% if picked %>
+          <span class="play-option__mark">Your answer</span>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+  <% if @result == :right %>
+    <div class="play-status play-status--right">Correct!</div>
+  <% elsif @result == :wrong %>
+    <div class="play-status play-status--wrong">Wrong!</div>
+  <% else %>
+    <div class="play-status play-status--neutral">No answer</div>
+  <% end %>
+<% else %>
+  <h1 class="play-title">The quiz is over</h1>
+<% end %>
