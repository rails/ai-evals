+# Local QR rendering. Nothing is fetched from the network.
+class JoinQr
+  def self.svg(text)
+    qr = RQRCode::QRCode.new(text.to_s, level: :m)
+    svg = qr.as_svg(
+      offset: 2,
+      color: "000",
+      fill: "fff",
+      shape_rendering: "crispEdges",
+      module_size: 8,
+      standalone: true,
+      use_path: true,
+      viewbox: true,
+      svg_attributes: { width: "100%", height: "100%", "aria-hidden": "true" }
+    )
+    svg = svg.sub(/<\?xml[^>]*>\s*/m, "")
+    svg.html_safe
+  rescue StandardError
+    "".html_safe
+  end
+end
