+<% content_for :title, "Quizzes · Quizzy" %>
+<div class="page-head">
+  <h1>Quizzes</h1>
+  <div class="buttons">
+    <form action="<%= import_moderate_quizzes_path %>" method="get">
+      <button type="submit" class="btn btn--ghost">Import quiz</button>
+    </form>
+    <form action="<%= new_moderate_quiz_path %>" method="get">
+      <button type="submit" class="btn btn--pink">New quiz</button>
+    </form>
+  </div>
+</div>
+
+<% if @quizzes.any? %>
+  <ul class="quiz-list">
+    <% @quizzes.each do |quiz| %>
+      <li class="card">
+        <h3><%= link_to quiz.title, moderate_quiz_path(quiz) %></h3>
+        <p class="meta">
+          <%= pluralize(quiz.questions.size, "question") %>
+          · <%= quiz.questions.to_a.count(&:active?) %> active
+        </p>
+      </li>
+    <% end %>
+  </ul>
+<% else %>
+  <div class="empty">No quizzes yet. Create one to get started.</div>
+<% end %>
