+<%= form_with model: [:moderate, @quiz, @question], class: "qform" do |f| %>
+  <div class="buttons qform__save">
+    <button type="submit" class="btn btn--pink">Save question</button>
+    <%= link_to "Cancel", moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+  </div>
+
+  <% if @errors.present? %>
+    <div class="errors qform__errors" role="alert">
+      <ul>
+        <% @errors.each do |error| %>
+          <li><%= error %></li>
+        <% end %>
+      </ul>
+    </div>
+  <% end %>
+
+  <div class="field">
+    <%= f.label :body, "Question", class: "field-label" %>
+    <%= f.text_area :body, class: "input", rows: 3, required: true, aria: { label: "Question" } %>
+  </div>
+
+  <div class="field">
+    <span class="field-label">Options</span>
+    <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
+  </div>
+
+  <div class="option-rows">
+    <% @option_rows.each_with_index do |row, index| %>
+      <%= render "option_row", row: row, index: index %>
+    <% end %>
+  </div>
+
+  <div class="buttons" style="margin-bottom: 28px">
+    <button type="submit" name="add_option" value="1" class="btn btn--ghost btn--sm" formnovalidate>Add option</button>
+  </div>
+
+  <div class="field">
+    <label class="checkbox" for="question_active">
+      <%= f.check_box :active, id: "question_active", aria: { label: "Active" } %>
+      Active
+    </label>
+    <span class="field-hint">Only active questions are played.</span>
+  </div>
+<% end %>
