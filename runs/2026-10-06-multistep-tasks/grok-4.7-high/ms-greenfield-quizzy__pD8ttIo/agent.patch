diff --git a/app/controllers/moderate/base_controller.rb b/app/controllers/moderate/base_controller.rb
new file mode 100644
index 0000000..315f064
--- /dev/null
+++ b/app/controllers/moderate/base_controller.rb
@@ -0,0 +1,34 @@
+module Moderate
+  class BaseController < ApplicationController
+    before_action :authenticate_moderator!
+
+    private
+
+    def authenticate_moderator!
+      return if session[:moderator_ok] == true
+
+      username = ENV["QUIZZY_MODERATOR_USERNAME"].to_s
+      password = ENV["QUIZZY_MODERATOR_PASSWORD"].to_s
+
+      authenticated = authenticate_with_http_basic do |given_user, given_password|
+        next false if username.empty? || password.empty?
+
+        secure_compare(given_user, username) & secure_compare(given_password, password)
+      end
+
+      if authenticated
+        session[:moderator_ok] = true
+        return
+      end
+
+      request_http_basic_authentication("Quizzy")
+    end
+
+    def secure_compare(left, right)
+      ActiveSupport::SecurityUtils.secure_compare(
+        Digest::SHA256.hexdigest(left.to_s),
+        Digest::SHA256.hexdigest(right.to_s)
+      )
+    end
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..d333f2e
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,131 @@
+module Moderate
+  class GamesController < BaseController
+    before_action :set_quiz
+    before_action :set_game, except: :create
+    before_action :expire_open_question, except: :create
+    before_action :no_store
+    around_action :silence_live_logs, only: [:counter, :live]
+
+    def create
+      game = nil
+      retries = 0
+      begin
+        game = @quiz.games.create!
+      rescue ActiveRecord::RecordNotUnique
+        retries += 1
+        retry if retries < 5
+        raise
+      end
+      redirect_to moderate_quiz_game_path(@quiz, game)
+    end
+
+    def show
+      @stage_mode = true
+      load_screen
+    end
+
+    def start
+      @game.start!
+      respond_with_stage
+    end
+
+    def finish
+      @game.finish_question!
+      respond_with_stage
+    end
+
+    def advance
+      @game.advance!
+      respond_with_stage
+    end
+
+    def top
+      @game.pick_top_winners!
+      respond_with_stage
+    end
+
+    def draw
+      @game.draw_winners!
+      respond_with_stage
+    end
+
+    def reset_winners
+      @game.reset_winners!
+      respond_with_stage
+    end
+
+    def live
+      signature = @game.screen_signature
+      response.headers["X-Live-Signature"] = signature
+      response.headers["X-Game-Phase"] = @game.phase
+      response.headers["X-Live-Partial"] = "1"
+      if params[:signature] == signature
+        head :no_content
+      else
+        load_screen
+        render partial: "stage", layout: false
+      end
+    end
+
+    def counter
+      text = @game.counter_text
+      response.headers["X-Live-Signature"] = text
+      response.headers["X-Game-Phase"] = @game.phase
+      response.headers["X-Live-Partial"] = "1"
+      if params[:signature] == text
+        head :no_content
+      else
+        render plain: text
+      end
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = @quiz.games.find(params[:id])
+    end
+
+    def expire_open_question
+      @game.expire_timer!
+    end
+
+    def load_screen
+      @question = if @game.current_question_id && !@game.finished?
+        Question.includes(:options).find_by(id: @game.current_question_id)
+      end
+      @counter_text = @game.counter_text
+      @join_url = "#{request.base_url}#{play_path(@game.code)}"
+      @qr_svg = @game.lobby? ? JoinQr.svg(@join_url) : nil
+      @option_counts = @game.option_counts
+      @answer_total = @option_counts.values.sum
+      @standings = @game.finished? ? @game.leaderboard : []
+      @screen_signature = @game.screen_signature
+    end
+
+    def respond_with_stage
+      if request.headers["X-Live"].present?
+        load_screen
+        response.headers["X-Live-Signature"] = @screen_signature
+        response.headers["X-Live-Partial"] = "1"
+        response.headers["X-Game-Phase"] = @game.phase
+        render partial: "stage", layout: false
+      else
+        redirect_to moderate_quiz_game_path(@quiz, @game)
+      end
+    end
+
+    def no_store
+      response.headers["Cache-Control"] = "private, no-store, max-age=0, must-revalidate"
+      response.headers["Pragma"] = "no-cache"
+      response.headers["Expires"] = "0"
+    end
+
+    def silence_live_logs
+      Rails.logger.silence { yield }
+    end
+  end
+end
diff --git a/app/controllers/moderate/questions_controller.rb b/app/controllers/moderate/questions_controller.rb
