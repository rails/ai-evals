+}
+
+:root {
+  --c-lavender: #e9e6ff;
+  --c-blue: #2a12c9;
+  --c-pink: #ff2e88;
+  --c-night: #0d0640;
+  --c-sun: #ffd23f;
+  --c-white: #fff;
+  --c-success: #00b36b;
+  --c-muted: #6f66b8;
+
+  --f-display: "Inter", system-ui, sans-serif;
