+}
+
+/* ---------- Big screen (moderator presentation) ---------- */
+
+.screen {
+  min-height: 100vh;
+  min-height: 100dvh;
+  display: flex;
+  flex-direction: column;
+  padding: clamp(20px, 3vw, 56px);
