+/*
+ * Quizzy: a live quiz for conference screens.
+ * Bright colors for LED walls and projectors, big type, pill buttons.
+ */
+
+@font-face {
+  font-family: "Inter";
+  font-display: swap;
+  font-style: normal;
+  font-weight: 100 900;
+  src: url("/assets/Inter-latin-496a588b.woff2") format("woff2");
+}
+
+:root {
+  --c-lavender: #e9e6ff;
+  --c-blue: #2a12c9;
+  --c-pink: #ff2e88;
+  --c-night: #0d0640;
+  --c-sun: #ffd23f;
+  --c-white: #fff;
+  --c-success: #00b36b;
+  --c-muted: #6f66b8;
+
+  --f-display: "Inter", system-ui, sans-serif;
