diff --git a/app/models/quiz_document.rb b/app/models/quiz_document.rb
new file mode 100644
index 0000000..59c0fd0
--- /dev/null
+++ b/app/models/quiz_document.rb
@@ -0,0 +1,218 @@
+# Moves quiz contents between Quizzy instances. Export writes only the title
+# and questions (with active/correct always present). Import creates a new quiz
+# and refuses the whole payload when JSON is invalid or a question rule fails.
+class QuizDocument
+  class Error < StandardError
+    attr_reader :messages
+
+    def initialize(messages)
+      @messages = Array(messages).flatten.compact
+      @messages = [ "Couldn't import this quiz" ] if @messages.empty?
+      super(@messages.join(" "))
+    end
+  end
+
+  QUESTION_BLANK = "Question can't be blank"
+  TOO_FEW_OPTIONS = "Add at least two options"
+  NO_CORRECT_OPTION = "Mark at least one option as correct"
+  TITLE_BLANK = "Title can't be blank"
+
+  def self.export_json(quiz)
+    JSON.pretty_generate(export_hash(quiz))
+  end
+
+  def self.export_hash(quiz)
+    {
+      "title" => quiz.title,
+      "questions" => quiz.questions.includes(:options).order(:position, :id).map { |question| export_question(question) }
+    }
+  end
+
+  def self.import!(raw)
+    persist!(parse_payload(raw))
+  end
+
+  def self.export_question(question)
+    {
+      "text" => question.body,
+      "active" => question.active?,
+      "options" => question.ordered_options.map { |option| export_option(option) }
+    }
+  end
+
+  def self.export_option(option)
+    {
+      "text" => option.text,
+      "correct" => option.correct?
+    }
+  end
+
+  def self.parse_payload(raw)
+    data = parse_json(raw)
+    errors = []
+    title = read_title(data, errors)
+    questions = read_questions(data, errors)
+    raise Error, errors if errors.any?
+
+    { title: title, questions: questions }
+  end
+
+  def self.parse_json(raw)
+    text = raw.to_s.sub(/\A\uFEFF/, "").strip
+    raise Error, "Quiz JSON can't be blank" if text.empty?
+
+    data = JSON.parse(text, max_nesting: 32)
+    raise Error, "Quiz JSON must be an object" unless data.is_a?(Hash)
+
+    data
+  rescue JSON::JSONError, EncodingError, ArgumentError
+    raise Error, "Quiz JSON is not valid JSON"
+  end
+  private_class_method :parse_json
+
+  def self.read_title(data, errors)
+    value = data["title"]
+    unless value.is_a?(String)
+      errors << TITLE_BLANK
+      return ""
+    end
+
+    title = value.strip
+    errors << TITLE_BLANK if title.empty?
+    title
+  end
+  private_class_method :read_title
+
+  def self.read_questions(data, errors)
+    return [] unless data.key?("questions")
+
+    raw_questions = data["questions"]
+    unless raw_questions.is_a?(Array)
+      errors << "Questions must be a list"
+      return []
+    end
+
+    raw_questions.filter_map.with_index do |question, index|
+      read_question(question, index, errors)
+    end
+  end
+  private_class_method :read_questions
+
+  def self.read_question(question, index, errors)
+    label = "Question #{index + 1}"
+    unless question.is_a?(Hash)
+      errors << "#{label}: #{QUESTION_BLANK}"
+      return nil
+    end
+
+    text = read_text(question["text"])
+    errors << "#{label}: #{QUESTION_BLANK}" if text.nil?
+
+    active = read_flag(
+      question,
+      "active",
+      default: true,
+      errors: errors,
+      message: "#{label}: Active must be true or false"
+    )
+    options = read_options(question, index, errors)
+    if options
+      errors << "#{label}: #{TOO_FEW_OPTIONS}" if options.size < 2
+      errors << "#{label}: #{NO_CORRECT_OPTION}" unless options.any? { |option| option[:correct] }
+    end
+
+    return nil if text.nil? || options.nil?
+
+    { text: text, active: active, options: options }
+  end
+  private_class_method :read_question
+
+  def self.read_options(question, question_index, errors)
+    label = "Question #{question_index + 1}"
+    raw = question.key?("options") ? question["options"] : []
+    unless raw.is_a?(Array)
+      errors << "#{label}: #{TOO_FEW_OPTIONS}"
+      return nil
+    end
+
+    raw.filter_map.with_index do |option, option_index|
+      read_option(option, question_index, option_index, errors)
+    end
+  end
+  private_class_method :read_options
+
+  def self.read_option(option, question_index, option_index, errors)
+    label = "Question #{question_index + 1}, option #{option_index + 1}"
+    unless option.is_a?(Hash)
+      errors << "#{label} is invalid"
+      return nil
+    end
+
+    return nil unless option.key?("text")
+
+    text_value = option["text"]
+    return nil if text_value.nil?
+
+    unless text_value.is_a?(String)
+      errors << "#{label} must have text"
+      return nil
+    end
+
+    text = text_value.strip
+    return nil if text.empty?
+
+    correct = read_flag(
+      option,
+      "correct",
+      default: false,
+      errors: errors,
+      message: "#{label}: Correct must be true or false"
+    )
+    { text: text, correct: correct }
+  end
+  private_class_method :read_option
+
+  def self.read_text(value)
+    return nil unless value.is_a?(String)
+
+    stripped = value.strip
+    stripped.empty? ? nil : stripped
+  end
+  private_class_method :read_text
+
+  def self.read_flag(hash, key, default:, errors:, message:)
+    return default unless hash.key?(key)
+
+    value = hash[key]
+    return default if value.nil?
+    return value if value == true || value == false
+
+    errors << message
+    default
+  end
+  private_class_method :read_flag
+
+  def self.persist!(payload)
+    Quiz.transaction do
+      quiz = Quiz.create!(title: payload[:title])
+      payload[:questions].each_with_index do |question, index|
+        record = quiz.questions.create!(
+          body: question[:text],
+          active: question[:active],
+          position: index + 1
+        )
+        question[:options].each_with_index do |option, option_index|
+          record.options.create!(
+            text: option[:text],
+            correct: option[:correct],
+            position: option_index + 1
+          )
+        end
+      end
+      quiz
+    end
+  rescue ActiveRecord::RecordInvalid => e
+    raise Error, e.record.errors.full_messages
+  end
+  private_class_method :persist!
+end
