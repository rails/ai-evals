@@ -0,0 +1,200 @@
+require "test_helper"
+
+class TimerTest < ActionDispatch::IntegrationTest
+  include ActiveSupport::Testing::TimeHelpers
+
+  USERNAME = "moderator"
+  PASSWORD = "s3cret"
+
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = USERNAME
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = PASSWORD
+  end
+
+  test "settings default the timer to zero and save minutes and seconds" do
+    quiz = Quiz.create!(title: "Timer Fest")
+    assert_equal 0, quiz.timer_minutes
+    assert_equal 0, quiz.timer_seconds
+    assert_equal 0, quiz.timer_duration_seconds
+
+    get "/moderate/quizzes/#{quiz.id}/edit", headers: auth
+    assert_response :success
+    assert_select "label", "Timer minutes"
+    assert_select "label", "Timer seconds"
+    assert_select "input[type=number][name='quiz[timer_minutes]'][value='0']"
+    assert_select "input[type=number][name='quiz[timer_seconds]'][value='0']"
+
+    patch "/moderate/quizzes/#{quiz.id}",
+      params: { quiz: { title: quiz.title, winner_count: "3", timer_minutes: "-1", timer_seconds: "5" } },
+      headers: auth
+    assert_response :unprocessable_entity
+    assert_select "label", "Timer minutes"
+    assert_equal 0, quiz.reload.timer_minutes
+
+    patch "/moderate/quizzes/#{quiz.id}",
+      params: { quiz: { title: quiz.title, winner_count: "3", timer_minutes: "1", timer_seconds: "30" } },
+      headers: auth
+    assert_redirected_to "/moderate/quizzes/#{quiz.id}"
+    quiz.reload
+    assert_equal 1, quiz.timer_minutes
+    assert_equal 30, quiz.timer_seconds
+    assert_equal 90, quiz.timer_duration_seconds
+  end
+
+  test "export ignores the timer" do
+    quiz = Quiz.create!(title: "Export Timer", timer_minutes: 1, timer_seconds: 30)
+    question = quiz.questions.create!(body: "Color?", position: 1, active: true)
+    question.options.create!(text: "Red", correct: true, position: 1)
+    question.options.create!(text: "Blue", correct: false, position: 2)
+
+    get "/moderate/quizzes/#{quiz.id}/export", headers: auth
+    parsed = JSON.parse(css_select("pre").text)
+    assert_equal %w[title questions], parsed.keys
+    assert_nil parsed["timer_minutes"]
+    assert_nil parsed["timer_seconds"]
+    json = css_select("pre").text
+
+    post "/moderate/import", params: { quiz_json: json }, headers: auth
+    imported = Quiz.order(:id).last
+    assert_equal 0, imported.timer_minutes
+    assert_equal 0, imported.timer_seconds
+  end
+
+  test "no timer leaves the question open and hides the countdown" do
+    game = start_game(minutes: 0, seconds: 0)
+    get "/moderate/games/#{game.id}", headers: auth
+    assert_response :success
+    assert_select ".stage-timer", count: 0
+    assert_select "button", "Finish"
+
+    travel 1.hour, with_usec: true do
+      get "/moderate/games/#{game.id}", headers: auth
+      assert_equal "open", game.reload.phase
+      assert_select "button", "Finish"
+      assert_select ".stage-timer", count: 0
+    end
+  end
+
+  test "big screen counts down from the open moment and a reload does not restart it" do
+    game = start_game(minutes: 1, seconds: 30)
+    get "/moderate/games/#{game.id}", headers: auth
+    assert_select ".stage-timer", text: "1:30"
+    assert_select "button", "Finish"
+    opened = game.reload.question_opened_ms
+
+    get "/play/#{game.code}"
+    assert_select ".stage-timer", count: 0
+    assert_no_match(/1:30/, response.body)
+
+    travel 2.seconds, with_usec: true do
+      get "/moderate/games/#{game.id}", headers: auth
+      game.reload
+      assert_equal opened, game.question_opened_ms
+      assert_equal "open", game.phase
+      assert_select ".stage-timer", text: game.countdown_label
+      remaining = game.timer_remaining_ms
+      assert remaining < 90_000
+      assert remaining > 80_000, "countdown restarted or jumped (#{remaining}ms, label #{game.countdown_label})"
+    end
+  end
+
+  test "a short timer renders M:SS and the open lead does not add a second" do
+    game = start_game(minutes: 0, seconds: 5)
+    get "/moderate/games/#{game.id}", headers: auth
+    assert_select ".stage-timer", text: "0:05"
+
+    game.update!(question_opened_ms: game.question_opened_ms + 120)
+    assert_equal "0:05", game.reload.countdown_label
+  end
+
+  test "the question finishes itself at zero and the moderator can still finish early" do
+    game = start_game(minutes: 0, seconds: 5, questions: 2)
+    join_player(game, "Alice")
+    right = game.current_question.options.find_by!(correct: true)
+
+    travel 1.second, with_usec: true do
+      post "/play/#{game.code}/answer", params: { option_id: right.id }
+    end
+    assert game.reload.open?
+    assert_equal 1, game.answers.count
+
+    travel 2.seconds, with_usec: true do
+      get "/moderate/games/#{game.id}", headers: auth
+      assert_equal "open", game.reload.phase
+      assert_select "button", "Finish"
+    end
+
+    travel 6.seconds, with_usec: true do
+      get "/moderate/games/#{game.id}", headers: auth
+      assert_equal "closed", game.reload.phase
+      assert_select "button", "Next"
+      assert_select "button", text: "Finish", count: 0
+      assert_select ".stage-timer", count: 0
+      assert_match ">Correct<", response.body
+
+      get "/play/#{game.code}"
+      assert_match "Correct!", response.body
+      assert_select ".stage-timer", count: 0
+    end
+
+    post "/moderate/games/#{game.id}/advance", headers: auth
+    follow_redirect!(headers: auth)
+    game.reload
+    assert game.open?
+    assert_select ".stage-timer", text: "0:05"
+
+    post "/moderate/games/#{game.id}/finish", headers: auth
+    follow_redirect!(headers: auth)
+    assert_equal "closed", game.reload.phase
+    assert_select "button", "End quiz"
+    assert_select ".stage-timer", count: 0
+  end
+
+  test "an answer after the deadline is rejected and closes the question" do
+    game = start_game(minutes: 0, seconds: 3)
+    join_player(game, "Bob")
+    option = game.current_question.options.first
+
+    travel 4.seconds, with_usec: true do
+      post "/play/#{game.code}/answer", params: { option_id: option.id }
+      assert_equal "closed", game.reload.phase
+      assert_equal 0, game.answers.count
+    end
+
+    get "/play/#{game.code}"
+    assert_match "No answer", response.body
+  end
+
+  test "seconds beyond 59 still count toward the duration" do
+    quiz = Quiz.create!(title: "Long Seconds", timer_minutes: 0, timer_seconds: 90)
+    assert_equal 90, quiz.timer_duration_seconds
+    assert_equal "1:30", Game.format_countdown(90_000)
+    assert_equal "0:05", Game.format_countdown(5_000)
+    assert_equal "0:00", Game.format_countdown(0)
+    assert_equal "0:01", Game.format_countdown(1)
+  end
+
+  private
+
+  def auth
+    { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials(USERNAME, PASSWORD) }
+  end
+
+  def start_game(minutes:, seconds:, questions: 1)
+    quiz = Quiz.create!(title: "Timed #{SecureRandom.hex(2)}", timer_minutes: minutes, timer_seconds: seconds)
+    questions.times do |index|
+      question = quiz.questions.create!(body: "Question #{index + 1}?", position: index + 1, active: true)
+      question.options.create!(text: "Yes", correct: true, position: 1)
+      question.options.create!(text: "No", correct: false, position: 2)
+    end
+    post "/moderate/quizzes/#{quiz.id}/games", headers: auth
+    game = quiz.games.order(:id).last
+    post "/moderate/games/#{game.id}/start", headers: auth
+    game.reload
+  end
+
+  def join_player(game, name)
+    post "/play/#{game.code}/join", params: { name: name }
+    game.players.find_by!(name: name)
+  end
+end
