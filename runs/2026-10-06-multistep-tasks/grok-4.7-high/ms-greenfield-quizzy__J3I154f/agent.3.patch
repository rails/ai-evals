 module ApplicationHelper
+  def qr_svg(url)
+    svg = RQRCode::QRCode.new(url.to_s).as_svg(
+      standalone: true,
+      use_path: true,
+      viewbox: true,
+      fill: "fff",
+      color: "0d0640",
+      module_size: 6
+    )
+    svg.sub(/\A<\?xml[^>]*>\s*/, "").html_safe
+  end
+
+  def answer_share(count, total)
+    total = total.to_i
+    return 0 if total.zero?
+
+    ((count.to_i * 100.0) / total).round
+  end
+
   def option_letter(index)
     if index < 26
       ("A".ord + index).chr
