+  data-phase="<%= @play_phase %>"
+  data-question="<%= @game.finished? ? "" : @game.current_question_id %>"
+  data-pick="<%= @pick&.option_id %>"
+  data-player="<%= @player&.id %>">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @player ? "Hi, #{@player.name}!" : @quiz.title %></span>
+  </div>
+  <div class="play__body play__body--top">
+    <% if @game.finished? %>
+      <div class="play-question__body" role="status">The quiz is over</div>
+    <% elsif @player.nil? %>
+      <h1 class="play-title"><%= @quiz.title %></h1>
+      <p class="play-lead">Join on your phone. No account needed.</p>
+      <%= form_with url: join_play_path(@game.code), class: "join-form" do %>
+        <label class="field-label" for="player_name">Your name</label>
+        <input class="input" id="player_name" name="name" type="text" value="<%= @join_name %>" placeholder="Your name" aria-label="Your name" autocomplete="name" maxlength="80" required>
+        <button class="btn btn--pink" type="submit">Join</button>
+      <% end %>
+      <% if @join_error %>
+        <p class="errors">Enter your name</p>
+      <% end %>
+    <% elsif @game.lobby? %>
+      <div class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+        <p class="play-lead">Waiting for the quiz to start</p>
+      </div>
+    <% elsif @game.open? && @question %>
+      <%# Open questions must not reveal which option is correct, including in the markup. %>
+      <div class="play-question__num">Question <%= @question_number %> of <%= @question_total %></div>
+      <div class="play-question__body"><%= @question.body %></div>
+      <div class="play-options">
+        <% @options.each_with_index do |option, index| %>
+          <% picked = @pick && @pick.option_id == option.id %>
+          <%= button_to answer_play_path(@game.code), method: :post, class: "play-option#{ " is-picked" if picked }", params: { option_id: option.id } do %>
+            <span class="play-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+            <span class="play-option__title"><%= option.text %></span>
+            <% if picked %>
+              <span class="play-option__mark">Your answer</span>
+            <% end %>
+          <% end %>
+        <% end %>
+      </div>
+    <% elsif @game.closed? && @question %>
+      <div class="play-question__num">Question <%= @question_number %> of <%= @question_total %></div>
+      <div class="play-question__body"><%= @question.body %></div>
+      <div class="play-options is-locked is-revealed">
+        <% @options.each_with_index do |option, index| %>
+          <% picked = @pick && @pick.option_id == option.id %>
+          <div class="play-option<%= " is-picked" if picked %><%= " is-correct" if option.correct? %>">
+            <span class="play-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+            <span class="play-option__title"><%= option.text %></span>
+            <% if picked %>
+              <span class="play-option__mark">Your answer</span>
+            <% end %>
+          </div>
+        <% end %>
+      </div>
+      <div class="play-status <%= @result_class %>" role="status"><%= @result_label %></div>
+    <% else %>
+      <div class="play-question__body" role="status">The quiz is over</div>
+    <% end %>
+  </div>
+</div>
