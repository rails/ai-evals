diff --git a/app/views/shared/_live_poller.html.erb b/app/views/shared/_live_poller.html.erb
new file mode 100644
index 0000000..bdbb958
--- /dev/null
+++ b/app/views/shared/_live_poller.html.erb
@@ -0,0 +1,119 @@
+<script>
+  (function () {
+    var POLL_MS = 800;
+    var epoch = 0;
+    var submitting = false;
+
+    function liveRoot() {
+      return document.querySelector("[data-live-root]");
+    }
+
+    function parseRoot(html) {
+      var doc = new DOMParser().parseFromString(html, "text/html");
+      return doc.querySelector("[data-live-root]");
+    }
+
+    function sameStructure(current, next) {
+      return current.getAttribute("data-phase") === next.getAttribute("data-phase")
+        && current.getAttribute("data-question") === next.getAttribute("data-question")
+        && current.getAttribute("data-pick") === next.getAttribute("data-pick")
+        && current.getAttribute("data-player") === next.getAttribute("data-player");
+    }
+
+    function updateTexts(current, next) {
+      var incoming = next.querySelectorAll("[data-live-text]");
+      var grouped = {};
+      for (var i = 0; i < incoming.length; i++) {
+        var key = incoming[i].getAttribute("data-live-text");
+        if (!grouped[key]) grouped[key] = [];
+        grouped[key].push(incoming[i].textContent);
+      }
+      Object.keys(grouped).forEach(function (key) {
+        var dests = current.querySelectorAll('[data-live-text="' + key + '"]');
+        var values = grouped[key];
+        for (var j = 0; j < dests.length && j < values.length; j++) {
+          if (dests[j].textContent !== values[j]) dests[j].textContent = values[j];
+        }
+      });
+      current.setAttribute("data-version", next.getAttribute("data-version"));
+    }
+
+    function applyHtml(html) {
+      var current = liveRoot();
+      if (!current || !html) return;
+      var next = parseRoot(html);
+      if (!next) return;
+      if (sameStructure(current, next)) {
+        if (current.getAttribute("data-version") !== next.getAttribute("data-version")) updateTexts(current, next);
+        return;
+      }
+      current.replaceWith(document.importNode(next, true));
+    }
+
+    function tick() {
+      var node = liveRoot();
+      if (!node || submitting) {
+        setTimeout(tick, POLL_MS);
+        return;
+      }
+      var url = node.getAttribute("data-poll-url");
+      if (!url) {
+        setTimeout(tick, POLL_MS);
+        return;
+      }
+      var epochAtStart = epoch;
+      var sep = url.indexOf("?") >= 0 ? "&" : "?";
+      fetch(url + sep + "_=" + Date.now(), {
+        credentials: "same-origin",
+        cache: "no-store",
+        headers: { "Accept": "text/html", "X-Quizzy-Live": "1" }
+      }).then(function (response) {
+        if (!response.ok) return "";
+        return response.text();
+      }).then(function (html) {
+        if (epochAtStart === epoch && !submitting) applyHtml(html);
+      }).catch(function () {
+        // Crowded conference Wi-Fi drops requests. The next tick tries again.
+      }).then(function () {
+        setTimeout(tick, POLL_MS);
+      });
+    }
+
+    document.addEventListener("submit", function (event) {
+      var form = event.target;
+      if (!form || !form.closest || !form.closest("[data-live-root]")) return;
+      if (form.getAttribute("data-live-bypass") === "1") return;
+      event.preventDefault();
+      submitting = true;
+      epoch += 1;
+      var epochAtStart = epoch;
+      var data = new FormData(form);
+      var submitter = event.submitter;
+      if (submitter && submitter.name && !data.has(submitter.name)) {
+        data.append(submitter.name, submitter.value);
+      }
+      fetch(form.action, {
+        method: (form.getAttribute("method") || "post").toUpperCase(),
+        body: data,
+        credentials: "same-origin",
+        headers: { "Accept": "text/html", "X-Quizzy-Live": "1" }
+      }).then(function (response) {
+        if (response.status === 401 || response.status === 403) {
+          form.setAttribute("data-live-bypass", "1");
+          form.submit();
+          return "";
+        }
+        return response.text();
+      }).then(function (html) {
+        if (epochAtStart === epoch) applyHtml(html);
+      }).catch(function () {
+        form.setAttribute("data-live-bypass", "1");
+        form.submit();
+      }).then(function () {
+        submitting = false;
+      });
+    });
+
+    if (liveRoot()) setTimeout(tick, 400);
+  })();
+</script>
