diff --git a/app/views/moderate/games/_live.html.erb b/app/views/moderate/games/_live.html.erb
new file mode 100644
index 0000000..764fed7
--- /dev/null
+++ b/app/views/moderate/games/_live.html.erb
@@ -0,0 +1,79 @@
+<div
+  data-live-root
+  data-poll-url="<%= state_moderate_game_path(@game) %>"
+  data-version="<%= @version %>"
+  data-phase="<%= @game.phase %>"
+  data-question="<%= @game.current_question_id %>"
+  data-pick=""
+  data-player="">
+  <section class="cover cover--blue">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <span><%= @quiz.title %></span>
+      </div>
+      <div class="screen__body">
+        <% if @game.lobby? %>
+          <div class="lobby">
+            <div>
+              <h1 class="lobby__title"><%= @quiz.title %></h1>
+              <p class="lobby__join">Join at</p>
+              <p class="lobby__url"><%= @join_url %></p>
+              <div class="counter-pill" data-live-text="players">Players: <%= @player_count %></div>
+            </div>
+            <div class="qr" role="img" aria-label="<%= @join_url %>">
+              <%= qr_svg(@join_url) %>
+            </div>
+          </div>
+        <% elsif @game.finished? %>
+          <div class="stage-question__body" role="status">The quiz is over</div>
+        <% elsif @question %>
+          <div class="stage-question__num">Question <%= @question_number %> of <%= @question_total %></div>
+          <div class="stage-question__body"><%= @question.body %></div>
+          <ol class="stage-options<%= " stage-options--results" if @game.closed? %>">
+            <% @options.each_with_index do |option, index| %>
+              <li class="stage-option<%= " is-correct" if @game.closed? && option.correct? %>">
+                <span class="stage-option__letter"><%= option_letter(index) %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+                <% if @game.closed? %>
+                  <span class="stage-option__count"><%= @option_counts[option.id].to_i %></span>
+                  <% if option.correct? %>
+                    <span class="stage-option__mark">Correct</span>
+                  <% end %>
+                  <span class="stage-option__bar" style="--share: <%= answer_share(@option_counts[option.id], @answer_total) %>%"></span>
+                <% end %>
+              </li>
+            <% end %>
+          </ol>
+          <% if @game.open? %>
+            <div class="answers-counter answers-counter--body" data-live-text="answers">Answers: <%= @answered_count %> / <%= @player_count %></div>
+          <% end %>
+        <% else %>
+          <div class="stage-question__body" role="status">The quiz is over</div>
+        <% end %>
+      </div>
+    </div>
+  </section>
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
+      <% if @game.open? %>
