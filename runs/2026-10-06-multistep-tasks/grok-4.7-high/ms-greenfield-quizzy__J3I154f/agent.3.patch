diff --git a/app/models/player.rb b/app/models/player.rb
new file mode 100644
index 0000000..b21a4d6
--- /dev/null
+++ b/app/models/player.rb
@@ -0,0 +1,34 @@
+class Player < ApplicationRecord
+  # A phone on conference Wi-Fi can miss several polls. Stay "in the game"
+  # until heartbeats have been quiet for this long, then drop off the counters
+  # so the moderator is not waiting on someone who left.
+  PRESENCE_WINDOW = 2.minutes
+  HEARTBEAT_EVERY = 10.seconds
+
+  belongs_to :game
+  has_many :answers, dependent: :destroy
+
+  validates :name, presence: true, length: { maximum: 80 }
+  validates :token, presence: true, uniqueness: true
+
+  before_validation :normalize_name
+  before_validation :assign_token, on: :create
+
+  scope :present, -> { where(last_seen_at: PRESENCE_WINDOW.ago..) }
+
+  def touch_presence!
+    return if last_seen_at && last_seen_at > HEARTBEAT_EVERY.ago
+
+    update_column(:last_seen_at, Time.current)
+  end
+
+  private
+
+  def normalize_name
+    self.name = name.to_s.strip.gsub(/\s+/, " ")[0, 80]
+  end
+
+  def assign_token
+    self.token = SecureRandom.urlsafe_base64(32) if token.blank?
+  end
+end
