@@ -0,0 +1,78 @@
+require "test_helper"
+
+class BotSuspensionPageTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(creator: users(:kevin), name: "Deploy Bot")
+    @bot.suspend!(reason: "flooding")
+  end
+
+  test "owners see suspended and the reason but cannot reactivate" do
+    sign_in :kevin
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "p", text: "Suspended"
+      assert_select "p", text: "Flooding"
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "input[readonly][aria-label='Bot code'][value='#{@bot.code}']"
+      assert_select "a", text: "Edit Deploy Bot"
+    end
+    assert_select "button", text: "Reactivate", count: 0
+
+    assert_no_changes -> { @bot.reload.suspended_at } do
+      post reactivate_bot_url(@bot)
+    end
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "administrators reactivate from the bots page after confirmation" do
+    sign_in :david
+
+    get bots_url
+
+    assert_select "p", text: "Suspended"
+    assert_select "p", text: "Flooding"
+    assert_select "button[data-turbo-confirm][aria-label='Reactivate']", text: "Reactivate"
+    assert_select "[data-turbo-confirm=?]", "Are you sure you want to reactivate this bot?"
+
+    post reactivate_bot_url(@bot)
+
+    assert_redirected_to bots_url
+    follow_redirect!
+    assert_select "p", text: "Suspended", count: 0
+    assert_select "button", text: "Reactivate", count: 0
+    assert_not @bot.reload.suspended?
+    assert_nil @bot.suspension_reason
+
+    room = rooms(:pets)
+    room.memberships.grant_to(@bot.user)
+    host! "once.campfire.test"
+    post room_bot_messages_url(room, @bot.code), params: "back", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :created
+  end
+
+  test "failing webhooks are shown as the reason" do
+    @bot.update!(suspension_reason: "webhook_failures")
+    sign_in :david
+
+    get bots_url
+
+    assert_select "li##{dom_id(@bot)}" do
+      assert_select "p", text: "Suspended"
+      assert_select "p", text: "Failing webhooks"
+      assert_select "button", text: "Reactivate"
+    end
+  end
+
+  test "a member cannot reactivate someone else's suspended bot" do
+    sign_in :jz
+    other = Bot.create!(creator: users(:david), name: "Admin Bot")
+    other.suspend!(reason: "flooding")
+
+    assert_raises(ActiveRecord::RecordNotFound) { post reactivate_bot_url(other) }
+    assert other.reload.suspended?
+  end
+end
