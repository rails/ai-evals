+++ b/test/models/bot/moderation_test.rb
@@ -0,0 +1,163 @@
+require "test_helper"
+require "restricted_http/private_network_guard"
+
+class BotModerationTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:pets)
+    @author = users(:david)
+    @bot = Bot.create!(creator: users(:kevin), name: "Deploy Bot", webhook_url: "https://example.com/hooks/campfire")
+    @room.memberships.grant_to(@bot.user)
+  end
+
+  test "ten failed deliveries in a row suspend the bot and a success resets the count" do
+    stub_webhook(status: 500)
+    9.times { deliver_mention }
+    assert_equal 9, @bot.reload.consecutive_webhook_failures
+    assert_not @bot.suspended?
+
+    WebMock.reset!
+    stub_webhook(status: 204)
+    deliver_mention
+    assert_equal 0, @bot.reload.consecutive_webhook_failures
+
+    WebMock.reset!
+    stub_webhook(status: 500)
+    9.times { deliver_mention }
+    assert_not @bot.reload.suspended?
+    assert_equal 9, @bot.consecutive_webhook_failures
+
+    deliver_mention
+    assert @bot.reload.suspended?
+    assert_equal "webhook_failures", @bot.suspension_reason
+    assert_equal "Failing webhooks", @bot.suspension_reason_label
+    assert_equal 10, @bot.consecutive_webhook_failures
+
+    WebMock.reset!
+    stub = stub_webhook(status: 204)
+    assert_no_enqueued_jobs only: Bot::DeliverWebhookJob do
+      create_mention("again")
+    end
+    perform_enqueued_jobs only: Bot::DeliverWebhookJob
+    assert_not_requested stub
+    assert_equal 10, @bot.reload.consecutive_webhook_failures
+  end
+
+  test "timeouts connection errors redirects and non 2xx are failures and any 2xx is success" do
+    stub_webhook(status: 404)
+    deliver_mention
+    assert_equal 1, @bot.reload.consecutive_webhook_failures
+
+    WebMock.reset!
+    stub_webhook(status: 302)
+    deliver_mention
+    assert_equal 2, @bot.reload.consecutive_webhook_failures
+
+    WebMock.reset!
+    WebMock.stub_request(:post, @bot.webhook_url).to_timeout
+    deliver_mention
+    assert_equal 3, @bot.reload.consecutive_webhook_failures
+
+    WebMock.reset!
+    WebMock.stub_request(:post, @bot.webhook_url).to_raise(Errno::ECONNREFUSED)
+    deliver_mention
+    assert_equal 4, @bot.reload.consecutive_webhook_failures
+
+    WebMock.reset!
+    stub_webhook(status: 201, body: "created", content_type: "text/plain")
+    deliver_mention
+    assert_equal 0, @bot.reload.consecutive_webhook_failures
+    assert_not @bot.suspended?
+    assert_equal 5, @room.messages.where(creator: @author).count
+    assert_equal 0, @bot.user.messages.count
+  end
+
+  test "joined webhook failures share the failure streak" do
+    WebMock.stub_request(:post, @bot.webhook_url).to_timeout
+
+    10.times { Bot::WebhookDelivery.deliver_joined(@bot, @room) }
+
+    assert @bot.reload.suspended?
+    assert_equal "webhook_failures", @bot.suspension_reason
+    assert_equal "Failing webhooks", @bot.suspension_reason_label
+  end
+
+  test "a suspended bot is not enqueued for mention or joined webhooks" do
+    @bot.suspend!(reason: "webhook_failures")
+    stub = stub_webhook(status: 500)
+
+    assert_no_enqueued_jobs only: Bot::DeliverWebhookJob do
+      create_mention("hello")
+    end
+
+    assert_no_enqueued_jobs only: Bot::DeliverJoinedWebhookJob do
+      rooms(:designers).memberships.grant_to(@bot.user)
+    end
+
+    assert_not_requested stub
+    assert_includes rooms(:designers).reload.user_ids, @bot.user_id
+    assert_equal 0, @bot.reload.consecutive_webhook_failures
+  end
+
+  test "a webhook already queued is not delivered after suspension and is not a failure" do
+    stub = stub_webhook(status: 500)
+    create_mention("hold")
+    @bot.suspend!(reason: "flooding")
+
+    perform_enqueued_jobs only: Bot::DeliverWebhookJob
+
+    assert_not_requested stub
+    assert_equal "flooding", @bot.reload.suspension_reason
+    assert_equal 0, @bot.consecutive_webhook_failures
+  end
+
+  test "reactivation clears the strike so posting and webhooks resume" do
+    @bot.update!(consecutive_webhook_failures: 4, cooldown_until: 1.minute.from_now, cooldown_attempts: 3)
+    @bot.suspend!(reason: "flooding")
+
+    @bot.reactivate!
+
+    assert_not @bot.suspended?
+    assert_nil @bot.suspension_reason
+    assert_nil @bot.cooldown_until
+    assert_equal 0, @bot.cooldown_attempts
+    assert_equal 0, @bot.consecutive_webhook_failures
+
+    stub = stub_webhook(status: 204)
+    deliver_mention
+    assert_requested stub
+  end
+
+  test "a refused private webhook in production counts as a failed delivery" do
+    Rails.env.stubs(:local?).returns(false)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).raises(RestrictedHTTP::Violation.new("private"))
+    @bot.update!(webhook_url: "http://127.0.0.1/hook")
+    WebMock.stub_request(:post, "http://127.0.0.1/hook")
+
+    create_mention("restart")
+    perform_enqueued_jobs only: Bot::DeliverWebhookJob
+
+    assert_not_requested :post, "http://127.0.0.1/hook"
+    assert_equal 1, @bot.reload.consecutive_webhook_failures
+    assert_not @bot.suspended?
+  end
+
+  private
+    def deliver_mention
+      create_mention("restart")
+      perform_enqueued_jobs only: Bot::DeliverWebhookJob
+    end
+
+    def create_mention(command)
+      @room.messages.create!(creator: @author, client_message_id: SecureRandom.uuid,
+        body: "<div>#{mention_for(@bot.user)} #{command}</div>")
+    end
+
+    def mention_for(user)
+      attachment_body = ApplicationController.render(partial: "users/mention", locals: { user: user })
+      %(<action-text-attachment sgid="#{user.attachable_sgid}" content-type="application/vnd.campfire.mention" content="#{attachment_body.gsub('"', "&quot;")}"></action-text-attachment>)
+    end
+
+    def stub_webhook(status:, body: "", content_type: "text/plain")
+      WebMock.stub_request(:post, @bot.webhook_url).to_return(status: status, body: body, headers: { "Content-Type" => content_type })
+    end
+end
