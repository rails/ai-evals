new file mode 100644
index 0000000..db343bf
--- /dev/null
+++ b/app/models/bot/moderation.rb
@@ -0,0 +1,132 @@
+module Bot::Moderation
+  extend ActiveSupport::Concern
+
+  # Fixed in code on purpose. These are not account settings.
+  FLOOD_LIMIT = 10
+  FLOOD_WINDOW = 10.seconds
+  COOLDOWN_PERIOD = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  SUSPENSION_REASONS = {
+    "flooding" => "Flooding",
+    "webhook_failures" => "Failing webhooks"
+  }.freeze
+
+  included do
+    validates :suspension_reason, inclusion: { in: SUSPENSION_REASONS.keys }, allow_nil: true
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def suspension_reason_label
+    SUSPENSION_REASONS.fetch(suspension_reason) { suspension_reason.to_s.presence }
+  end
+
+  # :ok, :suspended, :rate_limited, or :unprocessable.
+  # The block runs only when a message may be saved, inside the row lock, so
+  # an API post and a webhook reply cannot both sneak past the flood window.
+  def attempt_post(substantive: true)
+    with_lock do
+      if suspended?
+        :suspended
+      elsif cooling_down?
+        note_cooldown_attempt!
+        suspended? ? :suspended : :rate_limited
+      elsif !substantive
+        :unprocessable
+      elsif flooding?
+        start_cooldown!
+        :rate_limited
+      else
+        clear_expired_cooldown!
+        yield
+        :ok
+      end
+    end
+  end
+
+  # Seconds left in the cooldown, for the Retry-After header. Never above the
+  # fixed period, so a sub-second overshoot cannot advertise 31.
+  def retry_after
+    return 0 unless cooling_down?
+
+    (cooldown_until - Time.current).ceil.clamp(1, COOLDOWN_PERIOD.to_i)
+  end
+
+  def record_webhook_success!
+    with_lock do
+      return if suspended?
+
+      update!(consecutive_webhook_failures: 0) if consecutive_webhook_failures.to_i.nonzero?
+    end
+  end
+
+  def record_webhook_failure!
+    with_lock do
+      return if suspended?
+
+      next_count = consecutive_webhook_failures.to_i + 1
+      update!(consecutive_webhook_failures: next_count)
+      suspend!(reason: "webhook_failures") if next_count >= WEBHOOK_FAILURE_LIMIT
+    end
+  end
+
+  def suspend!(reason:)
+    return if suspended?
+
+    update!(
+      suspended_at: Time.current,
+      suspension_reason: reason,
+      cooldown_until: nil,
+      cooldown_attempts: 0,
+    )
+    Rails.logger.warn("Bot #{id} suspended (#{reason})")
+  end
+
+  # An administrator bringing the bot back. Clears the strike so it can post
+  # and receive webhooks immediately, instead of inheriting the old cooldown.
+  def reactivate!
+    update!(
+      suspended_at: nil,
+      suspension_reason: nil,
+      cooldown_until: nil,
+      cooldown_attempts: 0,
+      consecutive_webhook_failures: 0,
+    )
+  end
+
+  private
+    def cooling_down?
+      cooldown_until.present? && cooldown_until.future?
+    end
+
+    def flooding?
+      return false unless user
+
+      user.messages.where("created_at > ?", FLOOD_WINDOW.ago).count >= FLOOD_LIMIT
+    end
+
+    def clear_expired_cooldown!
+      return if cooldown_until.blank? && cooldown_attempts.to_i.zero?
+
+      update!(cooldown_until: nil, cooldown_attempts: 0)
+    end
+
+    def start_cooldown!
+      update!(cooldown_until: COOLDOWN_PERIOD.from_now, cooldown_attempts: 0)
+    end
+
+    # The post that crossed the limit opened this cooldown and is not one of
+    # these attempts. The fifth attempt during the same cooldown suspends.
+    def note_cooldown_attempt!
+      next_count = cooldown_attempts.to_i + 1
+      if next_count >= COOLDOWN_ATTEMPT_LIMIT
+        suspend!(reason: "flooding")
+      else
+        update!(cooldown_attempts: next_count)
+      end
+    end
+end
