+++ b/test/controllers/bots/posting_limits_test.rb
@@ -0,0 +1,279 @@
+require "test_helper"
+
+class Bots::PostingLimitsTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(creator: users(:kevin), name: "Deploy Bot", webhook_url: "https://example.com/hooks/campfire")
+    @room = rooms(:pets)
+    @room.memberships.grant_to(@bot.user)
+    host! "once.campfire.test"
+  end
+
+  test "the eleventh message in ten seconds is refused with retry after" do
+    10.times do |i|
+      post_as_bot("message #{i}")
+      assert_response :created
+    end
+
+    assert_no_difference -> { @bot.user.messages.count } do
+      post_as_bot("over the limit")
+    end
+
+    assert_response :too_many_requests
+    assert_equal "30", retry_after_header
+    assert_not @bot.reload.suspended?
+    assert @bot.cooldown_until.future?
+    assert_equal 0, @bot.cooldown_attempts
+  end
+
+  test "retry after counts down and posting works again after the cooldown" do
+    start = Time.zone.parse("2026-06-01 12:00:00")
+
+    travel_to start do
+      10.times { |i| post_as_bot("message #{i}") && assert_response(:created) }
+      post_as_bot("over")
+      assert_response :too_many_requests
+      assert_equal "30", retry_after_header
+    end
+
+    travel_to start + 20.seconds do
+      post_as_bot("still cooling")
+      assert_response :too_many_requests
+      assert_equal "10", retry_after_header
+      assert_not @bot.reload.suspended?
+    end
+
+    travel_to start + 31.seconds do
+      post_as_bot("back")
+      assert_response :created
+      assert_nil @bot.reload.cooldown_until
+    end
+  end
+
+  test "five more attempts during the same cooldown suspend the bot" do
+    flood_into_cooldown
+
+    4.times do |i|
+      post_as_bot("attempt #{i}")
+      assert_response :too_many_requests
+      assert_not @bot.reload.suspended?, "attempt #{i + 1} should not suspend yet"
+    end
+
+    post_as_bot("fifth attempt")
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+    assert_equal "flooding", @bot.suspension_reason
+    assert_equal "Flooding", @bot.suspension_reason_label
+    assert_equal 10, @bot.user.messages.count
+
+    post_as_bot("after suspension")
+    assert_response :forbidden
+    assert_equal 10, @bot.user.messages.count
+  end
+
+  test "a suspended bot keeps rooms and messages and still counts toward the bot limit" do
+    flood_into_cooldown
+    5.times { post_as_bot("nope") }
+    @bot.reload
+
+    assert @bot.suspended?
+    assert @bot.user.active?
+    assert_includes @bot.user.room_ids, @room.id
+    assert_equal 10, @bot.user.messages.count
+
+    accounts(:signal).update!(settings: { "bots_per_member" => "1" })
+    extra = Bot.new(creator: users(:kevin), name: "Another")
+    assert_not extra.save
+    assert_includes extra.errors[:base], "reached the limit"
+    assert_equal 1, users(:kevin).created_bots.count
+  end
+
+  test "an empty body during cooldown is refused and counts as an attempt" do
+    flood_into_cooldown
+
+    4.times do
+      post_blank
+      assert_response :too_many_requests
+    end
+
+    post_blank
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+    assert_equal "flooding", @bot.suspension_reason
+  end
+
+  test "an empty body outside cooldown does not start a cooldown" do
+    post_blank
+    assert_response :unprocessable_content
+    assert_nil @bot.reload.cooldown_until
+    assert_equal 0, @bot.cooldown_attempts
+  end
+
+  test "a room the bot is not in stays not found and does not count as an attempt" do
+    flood_into_cooldown
+
+    post room_bot_messages_url(rooms(:designers), @bot.code), params: "hi", headers: text_headers
+
+    assert_response :not_found
+    assert_equal 0, @bot.reload.cooldown_attempts
+    assert_not @bot.suspended?
+  end
+
+  test "a suspended bot is forbidden even for an unknown room" do
+    @bot.suspend!(reason: "webhook_failures")
+
+    post room_bot_messages_url("999999", @bot.code), params: "hi", headers: text_headers
+
+    assert_response :forbidden
+  end
+
+  test "a deleted bot code is still unauthorized" do
+    code = @bot.code
+    @bot.deactivate_and_destroy
+
+    post room_bot_messages_url(@room, code), params: "hi", headers: text_headers
+
+    assert_response :unauthorized
+  end
+
+  test "messages older than ten seconds do not count and do not open a cooldown" do
+    start = Time.zone.parse("2026-06-01 12:00:00")
+    travel_to start do
+      10.times { |i| post_as_bot("old #{i}") && assert_response(:created) }
+    end
+
+    travel_to start + 11.seconds do
+      post_as_bot("fresh")
+      assert_response :created
+      assert_nil @bot.reload.cooldown_until
+    end
+  end
+
+  test "posts in different rooms share one flood window" do
+    other = rooms(:designers)
+    other.memberships.grant_to(@bot.user)
+
+    6.times { |i| post_as_bot("a #{i}") && assert_response(:created) }
+    4.times do |i|
+      post room_bot_messages_url(other, @bot.code), params: "b #{i}", headers: text_headers
+      assert_response :created
+    end
+
+    post_as_bot("over")
+    assert_response :too_many_requests
+  end
+
+  test "webhook replies count toward the flood window" do
+    9.times { |i| post_as_bot("api #{i}") && assert_response(:created) }
+    stub_reply("from the hook")
+
+    assert_difference -> { @bot.user.messages.count }, +1 do
+      mention_and_deliver("status")
+    end
+
+    assert_no_difference -> { @bot.user.messages.count } do
+      post_as_bot("over")
+    end
+    assert_response :too_many_requests
+    assert_equal "30", retry_after_header
+  end
+
+  test "a webhook reply that crosses the limit is not posted and starts the cooldown" do
+    10.times { |i| post_as_bot("api #{i}") && assert_response(:created) }
+    stub_reply("should not land")
+
+    assert_no_difference -> { @bot.user.messages.count } do
+      mention_and_deliver("status")
+    end
+
+    assert @bot.reload.cooldown_until.future?
+    assert_equal 0, @bot.cooldown_attempts
+    post_as_bot("during")
+    assert_response :too_many_requests
+  end
+
+  test "webhook replies during cooldown are not posted and count as attempts" do
+    flood_into_cooldown
+    stub_reply("nope")
+
+    4.times do
+      assert_no_difference -> { @bot.user.messages.count } do
+        mention_and_deliver("again")
+      end
+      assert_not @bot.reload.suspended?
+    end
+
+    assert_no_difference -> { @bot.user.messages.count } do
+      mention_and_deliver("last")
+    end
+    assert @bot.reload.suspended?
+    assert_equal "flooding", @bot.suspension_reason
+  end
+
+  test "a webhook with no reply body does not count as a cooldown attempt" do
+    flood_into_cooldown
+    stub_webhook(status: 204)
+
+    5.times { mention_and_deliver("ping") }
+
+    assert_not @bot.reload.suspended?
+    assert_equal 0, @bot.cooldown_attempts
+    assert @bot.cooldown_until.future?
+  end
+
+  test "failed deliveries during cooldown suspend for failing webhooks" do
+    flood_into_cooldown
+    stub_webhook(status: 500)
+
+    10.times { mention_and_deliver("ping") }
+
+    assert @bot.reload.suspended?
+    assert_equal "webhook_failures", @bot.suspension_reason
+    post_as_bot("nope")
+    assert_response :forbidden
+  end
+
+  private
+    def text_headers
+      { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    def post_as_bot(body)
+      post room_bot_messages_url(@room, @bot.code), params: body, headers: text_headers
+    end
+
+    def post_blank
+      post room_bot_messages_url(@room, @bot.code), params: "   \n", headers: text_headers
+    end
+
+    def flood_into_cooldown
+      10.times { |i| post_as_bot("message #{i}") && assert_response(:created) }
+      post_as_bot("over")
+      assert_response :too_many_requests
+    end
+
+    def retry_after_header
+      response.headers["Retry-After"] || response.headers["retry-after"]
+    end
+
+    def stub_webhook(status:, body: "", content_type: "text/plain")
+      WebMock.stub_request(:post, @bot.webhook_url).to_return(status: status, body: body, headers: { "Content-Type" => content_type })
+    end
+
+    def stub_reply(body)
+      stub_webhook(status: 200, body: body, content_type: "text/plain")
+    end
+
+    def mention_and_deliver(command)
+      create_mention(command)
+      perform_enqueued_jobs only: Bot::DeliverWebhookJob
+    end
+
+    def create_mention(command)
+      @room.messages.create!(creator: users(:david), client_message_id: SecureRandom.uuid, body: "<div>#{mention_for(@bot.user)} #{command}</div>")
+    end
+
+    def mention_for(user)
+      attachment_body = ApplicationController.render(partial: "users/mention", locals: { user: user })
+      %(<action-text-attachment sgid="#{user.attachable_sgid}" content-type="application/vnd.campfire.mention" content="#{attachment_body.gsub('"', "&quot;")}"></action-text-attachment>)
+    end
+end
