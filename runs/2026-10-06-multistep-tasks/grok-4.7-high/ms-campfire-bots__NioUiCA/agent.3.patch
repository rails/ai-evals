--- /dev/null
+++ b/test/models/bot/open_rooms_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class BotOpenRoomsTest < ActiveSupport::TestCase
+  setup do
+    @webhook = "https://example.com/hooks/campfire"
+  end
+
+  test "turning the switch on joins existing open rooms and not closed or direct rooms" do
+    bot = Bot.create!(creator: users(:kevin), name: "Deploy Bot")
+    assert_empty bot.user.rooms
+
+    bot.update!(add_to_all_open_rooms: true)
+
+    assert_equal Rooms::Open.pluck(:id).sort, bot.user.reload.room_ids.sort
+    assert_not_includes bot.user.room_ids, rooms(:designers).id
+    assert_not_includes bot.user.room_ids, rooms(:david_and_kevin).id
+  end
+
+  test "a later open room includes only bots that join every open room" do
+    opted_in = Bot.create!(creator: users(:kevin), name: "Everyone Bot", add_to_all_open_rooms: true)
+    opted_out = Bot.create!(creator: users(:kevin), name: "Quiet Bot")
+
+    room = Rooms::Open.create!(name: "Ops", creator: users(:david))
+
+    assert_includes room.user_ids, opted_in.user_id
+    assert_not_includes room.user_ids, opted_out.user_id
+    assert_includes room.user_ids, users(:david).id
+  end
+
+  test "a closed room that becomes open picks up opted-in bots" do
+    opted_in = Bot.create!(creator: users(:kevin), name: "Everyone Bot", add_to_all_open_rooms: true)
+    opted_out = Bot.create!(creator: users(:kevin), name: "Quiet Bot")
+    room = rooms(:watercooler)
+
+    assert_not_includes room.user_ids, opted_in.user_id
+
+    room = room.becomes!(Rooms::Open)
+    room.save!
+
+    assert_includes room.reload.user_ids, opted_in.user_id
+    assert_not_includes room.user_ids, opted_out.user_id
+  end
+
+  test "a deactivated bot is not added to new open rooms even if the switch is on" do
+    bot = Bot.create!(creator: users(:kevin), name: "Deploy Bot", add_to_all_open_rooms: true)
+    bot.user.deactivate
+
+    room = Rooms::Open.create!(name: "After", creator: users(:david))
+
+    assert_not_includes room.user_ids, bot.user_id
+  end
+
+  test "turning the switch on twice does not duplicate memberships" do
+    bot = Bot.create!(creator: users(:kevin), name: "Deploy Bot", add_to_all_open_rooms: true)
+    count = bot.user.memberships.count
+
+    bot.update!(add_to_all_open_rooms: true)
+
+    assert_equal count, bot.user.reload.memberships.count
+  end
+end
