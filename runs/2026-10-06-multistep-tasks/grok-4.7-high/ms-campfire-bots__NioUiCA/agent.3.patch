+    assert_equal Rooms::Open.pluck(:id).sort, bot.user.reload.rooms.opens.pluck(:id).sort
+  end
+
+  test "creating a bot without the switch joins no open rooms" do
+    post bots_url, params: { bot: { name: "Deploy Bot", add_to_all_open_rooms: "0" } }
+
+    bot = Bot.last
+    assert_not bot.add_to_all_open_rooms?
+    assert_empty bot.user.rooms
+  end
+
+  test "turning the switch off keeps the rooms the bot already joined" do
+    bot = Bot.create!(creator: users(:kevin), name: "Deploy Bot", add_to_all_open_rooms: true)
+    room_ids = bot.user.reload.room_ids.sort
+    assert_equal Rooms::Open.pluck(:id).sort, room_ids
+
+    patch bot_url(bot), params: { bot: { name: bot.name, add_to_all_open_rooms: "0" } }
+
+    assert_redirected_to bots_url
+    assert_not bot.reload.add_to_all_open_rooms?
+    assert_equal room_ids, bot.user.reload.room_ids.sort
+
+    later = Rooms::Open.create!(name: "Later", creator: users(:david))
+    assert_not_includes later.user_ids, bot.user_id
+  end
+
+  test "a person adding the bot to a closed room asks the webhook to join once" do
+    sign_in :david
+    bot = Bot.create!(creator: users(:kevin), name: "Deploy Bot", webhook_url: "https://example.com/hooks/campfire")
+    room = rooms(:designers)
+
+    assert_enqueued_jobs 1, only: Bot::DeliverJoinedWebhookJob do
+      put rooms_closed_url(room), params: {
+        room: { name: room.name },
+        user_ids: room.user_ids + [ bot.user_id ]
+      }
+    end
+
+    assert_includes room.reload.user_ids, bot.user_id
+  end
+end
diff --git a/test/models/bot/joined_webhook_test.rb b/test/models/bot/joined_webhook_test.rb
new file mode 100644
index 0000000..f6e9b46
--- /dev/null
+++ b/test/models/bot/joined_webhook_test.rb
@@ -0,0 +1,156 @@
+require "test_helper"
+
+class BotJoinedWebhookTest < ActiveSupport::TestCase
+  setup do
+    @bot = Bot.create!(creator: users(:kevin), name: "Deploy Bot", webhook_url: "https://example.com/hooks/campfire")
+    @room = rooms(:designers)
+  end
+
+  test "adding a bot to a room enqueues one joined webhook" do
+    assert_enqueued_jobs 1, only: Bot::DeliverJoinedWebhookJob do
+      @room.memberships.grant_to(@bot.user)
+    end
+
+    assert_no_enqueued_jobs only: Bot::DeliverJoinedWebhookJob do
+      @room.memberships.grant_to(@bot.user)
+    end
+  end
+
+  test "delivery posts the joined payload exactly once" do
+    stub = stub_webhook(status: 204)
+    @room.memberships.grant_to(@bot.user)
+    @room.memberships.grant_to(@bot.user)
+
+    perform_enqueued_jobs only: Bot::DeliverJoinedWebhookJob
+
+    assert_requested stub, times: 1
+    payload = JSON.parse(request_body)
+
+    assert_equal [ "event", "room" ], payload.keys
+    assert_equal "joined", payload["event"]
+    assert_equal [ "id", "name", "reply_to" ], payload["room"].keys
+    assert_equal @room.id, payload["room"]["id"]
+    assert_equal @room.name, payload["room"]["name"]
+    assert_equal "/rooms/#{@room.id}/#{@bot.code}/messages", payload["room"]["reply_to"]
+    assert_equal "application/json", request_for.headers["Content-Type"]
+  end
+
+  test "a 200 text reply is posted as the bot" do
+    stub_webhook(status: 200, body: "Hello Ops\nline two", content_type: "text/plain; charset=utf-8")
+
+    assert_difference -> { @room.messages.count }, +1 do
+      @room.memberships.grant_to(@bot.user)
+      perform_enqueued_jobs only: Bot::DeliverJoinedWebhookJob
+    end
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot.user, reply.creator
+    assert_equal "Hello Ops\nline two", reply.plain_text_body
+  end
+
+  test "a 200 html reply is posted as the bots rich text" do
+    stub_webhook(status: 200, body: "<div>Hello <strong>Ops</strong></div>", content_type: "text/html")
+
+    @room.memberships.grant_to(@bot.user)
+    perform_enqueued_jobs only: Bot::DeliverJoinedWebhookJob
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot.user, reply.creator
+    assert_includes reply.body.body.to_html, "<strong>Ops</strong>"
+  end
+
+  test "a 204 reply posts nothing" do
+    stub_webhook(status: 204)
+
+    assert_no_difference -> { @room.messages.count } do
+      @room.memberships.grant_to(@bot.user)
+      perform_enqueued_jobs only: Bot::DeliverJoinedWebhookJob
+    end
+  end
+
+  test "direct conversations never trigger joined" do
+    stub_webhook(status: 204)
+
+    room = nil
+    assert_no_enqueued_jobs only: Bot::DeliverJoinedWebhookJob do
+      room = Rooms::Direct.create_for({ creator: users(:david) }, users: [ users(:david), @bot.user ])
+    end
+
+    assert room.direct?
+    assert_includes room.user_ids, @bot.user_id
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "a bot without a webhook is not called when it joins" do
+    @bot.update!(webhook_url: nil)
+
+    assert_no_enqueued_jobs only: Bot::DeliverJoinedWebhookJob do
+      @room.memberships.grant_to(@bot.user)
+    end
+  end
+
+  test "turning the switch on notifies each open room once" do
+    stub_webhook(status: 204)
+
+    assert_enqueued_jobs Rooms::Open.count, only: Bot::DeliverJoinedWebhookJob do
+      @bot.update!(add_to_all_open_rooms: true)
+    end
+
+    perform_enqueued_jobs only: Bot::DeliverJoinedWebhookJob
+
+    assert_requested :post, @bot.webhook_url, times: Rooms::Open.count
+    bodies = webhook_bodies
+    assert_equal Rooms::Open.pluck(:id).sort, bodies.map { |body| JSON.parse(body).dig("room", "id") }.sort
+    assert bodies.all? { |body| JSON.parse(body)["event"] == "joined" }
+  end
+
+  test "turning the switch on does not re-notify a room the bot already joined" do
+    rooms(:pets).memberships.grant_to(@bot.user)
+    clear_enqueued_jobs
+
+    assert_enqueued_jobs Rooms::Open.count - 1, only: Bot::DeliverJoinedWebhookJob do
+      @bot.update!(add_to_all_open_rooms: true)
+    end
+  end
+
+  test "creating a bot with the switch and a webhook notifies each open room once" do
+    stub_webhook(status: 204)
+
+    assert_enqueued_jobs Rooms::Open.count, only: Bot::DeliverJoinedWebhookJob do
+      Bot.create!(creator: users(:kevin), name: "Hello Bot", webhook_url: @bot.webhook_url, add_to_all_open_rooms: true)
+    end
+  end
+
+  test "a new open room notifies opted-in bots once" do
+    @bot.update!(add_to_all_open_rooms: true)
+    clear_enqueued_jobs
+    stub_webhook(status: 204)
+
+    assert_enqueued_jobs 1, only: Bot::DeliverJoinedWebhookJob do
+      Rooms::Open.create!(name: "Ops", creator: users(:david))
+    end
+  end
+
+  private
+    def stub_webhook(status:, body: "", content_type: "text/plain")
+      WebMock.stub_request(:post, @bot.webhook_url).to_return(status: status, body: body, headers: { "Content-Type" => content_type })
+    end
+
+    def request_for
+      target = URI(@bot.webhook_url)
+      WebMock::RequestRegistry.instance.requested_signatures.hash.keys.find { |signature|
+        signature.uri.host == target.host && signature.uri.path == target.path
+      } or raise "no request to #{@bot.webhook_url}"
+    end
+
+    def request_body
+      request_for.body
+    end
+
+    def webhook_bodies
+      target = URI(@bot.webhook_url)
+      WebMock::RequestRegistry.instance.requested_signatures.hash.keys.filter_map { |signature|
+        signature.body if signature.uri.host == target.host && signature.uri.path == target.path
+      }
+    end
+end
