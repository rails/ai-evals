     attachable.variant :small, resize_to_limit: [ 192, 192 ], format: :png
   end
 
-  has_json :settings, restrict_room_creation_to_administrators: false
+  has_json :settings, restrict_room_creation_to_administrators: false, bots_per_member: 5
+
+  before_save :normalize_bots_per_member_setting
 
   def logo_variant(size)
     logo.variant(size).processed if logo.variable?
   end
+
+  # Cap on bots a non-administrator may own. Nil (never saved) stays at the
+  # schema default. A negative value is treated as zero so it cannot invert
+  # the comparison and allow unlimited bots.
+  def bots_per_member
+    value = settings.bots_per_member
+    value = 5 if value.nil?
+    value = value.to_i
+    value.negative? ? 0 : value
+  end
+
+  # Administrators are not limited. Deleted bots do not count: destroying a
+  # bot removes the row this count reads.
+  def bot_limit_reached_by?(user)
+    return false if user.nil? || user.administrator?
+
+    user.created_bots.count >= bots_per_member
+  end
+
+  private
+    def normalize_bots_per_member_setting
+      value = settings.bots_per_member
+      return if value.nil? || !value.to_i.negative?
+
+      settings.bots_per_member = 0
+    end
 end
diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..69d10e6
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,122 @@
+class Bot < ApplicationRecord
+  include Moderation
+
+  belongs_to :user, autosave: true, inverse_of: :bot
+  belongs_to :creator, class_name: "User", inverse_of: :created_bots
+
+  has_secure_token :code
+
+  scope :ordered, -> { joins(:user).order("LOWER(users.name) ASC, bots.id ASC") }
+  scope :joining_all_open_rooms, -> { where(add_to_all_open_rooms: true).joins(:user).merge(User.active) }
+
+  validates :name, presence: true
+  validates :webhook_url, length: { maximum: 2_048 }, allow_blank: true
+  validate :webhook_url_is_http, if: -> { webhook_url.present? }
+  validate :within_bots_per_member_limit, on: :create
+
+  # Turning the switch on joins every open room that exists right now.
+  # Turning it off leaves those memberships alone; future open rooms check
+  # the flag themselves.
+  after_save_commit :join_all_open_rooms, if: -> { add_to_all_open_rooms? && saved_change_to_add_to_all_open_rooms? }
+
+  def name
+    user&.name
+  end
+
+  def name=(value)
+    ensure_user.name = value.to_s.strip
+  end
+
+  # An empty field means "no webhook", not a blank string we keep retrying.
+  def webhook_url=(value)
+    super(value.is_a?(String) ? value.strip.presence : value)
+  end
+
+  # File fields don't need a current value, and returning the attachment would
+  # confuse the form builder. Preview is rendered separately from the user.
+  def avatar
+    nil
+  end
+
+  def avatar=(file)
+    return if file.blank?
+
+    ensure_user.avatar.attach(file)
+  end
+
+  def active?
+    user&.active?
+  end
+
+  # Suspended bots still authenticate. Posting answers 403; treating them as
+  # missing would hide the suspension behind a 401. Deactivation is different:
+  # that user is not active, so the code no longer authenticates.
+  def self.authenticate(code)
+    return if code.blank?
+
+    bot = find_by(code: code)
+    bot if bot&.active?
+  end
+
+  def deactivate_and_destroy
+    transaction do
+      user.deactivate if user&.active?
+      destroy!
+    end
+  end
+
+  # One joined event per new membership. Direct rooms never qualify: a
+  # private conversation is not a room the bot "landed" in.
+  def self.deliver_joined_webhooks_later(room, user_ids)
+    return if user_ids.blank?
+    return if room.blank? || room.direct? || room.type == "Rooms::Direct"
+
+    ids = Array(user_ids)
+    ActiveRecord.after_all_transactions_commit do
+      deliver_joined_webhooks(room, ids)
+    end
+  rescue => e
+    Rails.logger.error("Failed to schedule joined webhooks for room #{room&.id}: #{e.class}: #{e.message}")
+  end
+
+  def self.deliver_joined_webhooks(room, user_ids)
+    return if room.direct? || room.type == "Rooms::Direct"
+
+    where(user_id: user_ids).where(suspended_at: nil).where.not(webhook_url: [ nil, "" ]).joins(:user).merge(User.active).find_each do |bot|
+      Bot::DeliverJoinedWebhookJob.perform_later(bot, room)
+    end
+  rescue => e
+    Rails.logger.error("Failed to enqueue joined webhooks for room #{room.id}: #{e.class}: #{e.message}")
+  end
+
+  private
+    def within_bots_per_member_limit
+      return if creator.blank? || creator.administrator?
+      return unless Current.account&.bot_limit_reached_by?(creator)
+
+      errors.add(:base, "reached the limit")
+    end
+
+    def join_all_open_rooms
+      return unless user&.active?
+
+      Rooms::Open.find_each { |room| room.memberships.grant_to(user) }
+    end
+
+    def webhook_url_is_http
+      uri = URI.parse(webhook_url)
+      unless uri.is_a?(URI::HTTP) && uri.host.present?
+        errors.add(:webhook_url, "must be an http or https URL")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:webhook_url, "must be an http or https URL")
+    end
+
+    def ensure_user
+      self.user ||= build_user(role: :bot, password: SecureRandom.base58(32))
+      user.role = :bot
+      user.bio = "Chat bot" if user.bio.blank?
+      user.password = SecureRandom.base58(32) if user.password_digest.blank?
+      user
+    end
+end
diff --git a/app/models/bot/message_body.rb b/app/models/bot/message_body.rb
new file mode 100644
index 0000000..51d1529
--- /dev/null
+++ b/app/models/bot/message_body.rb
@@ -0,0 +1,23 @@
+class Bot::MessageBody
+  # Trix stores one block per line. Escaping first keeps the raw text intact
+  # (including <, &, and emoji) while still rendering line breaks.
+  def self.from_plain_text(text)
+    text.to_s.gsub(/\r\n?/, "\n").split("\n", -1).map { |line|
+      escaped = ERB::Util.html_escape(line)
+      escaped.present? ? "<div>#{escaped}</div>" : "<div><br></div>"
+    }.join
+  end
+
+  # A full HTML document would lose its contents when presentation strips
+  # <html>/<body>. Keep the fragment a bot actually meant to post.
+  def self.from_html(html)
+    html = html.to_s
+    return if html.blank?
+
+    if html.match?(/<\s*(?:html|body)\b/i)
+      Nokogiri::HTML.parse(html).at("body")&.inner_html.to_s.presence
+    else
+      html
+    end
+  end
+end
diff --git a/app/models/bot/moderation.rb b/app/models/bot/moderation.rb
new file mode 100644
index 0000000..db343bf
--- /dev/null
+++ b/app/models/bot/moderation.rb
@@ -0,0 +1,132 @@
+module Bot::Moderation
+  extend ActiveSupport::Concern
+
+  # Fixed in code on purpose. These are not account settings.
+  FLOOD_LIMIT = 10
+  FLOOD_WINDOW = 10.seconds
+  COOLDOWN_PERIOD = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  SUSPENSION_REASONS = {
+    "flooding" => "Flooding",
+    "webhook_failures" => "Failing webhooks"
+  }.freeze
+
+  included do
+    validates :suspension_reason, inclusion: { in: SUSPENSION_REASONS.keys }, allow_nil: true
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def suspension_reason_label
+    SUSPENSION_REASONS.fetch(suspension_reason) { suspension_reason.to_s.presence }
+  end
+
+  # :ok, :suspended, :rate_limited, or :unprocessable.
+  # The block runs only when a message may be saved, inside the row lock, so
+  # an API post and a webhook reply cannot both sneak past the flood window.
+  def attempt_post(substantive: true)
+    with_lock do
+      if suspended?
+        :suspended
+      elsif cooling_down?
+        note_cooldown_attempt!
+        suspended? ? :suspended : :rate_limited
+      elsif !substantive
+        :unprocessable
+      elsif flooding?
+        start_cooldown!
+        :rate_limited
+      else
+        clear_expired_cooldown!
+        yield
+        :ok
+      end
+    end
+  end
+
+  # Seconds left in the cooldown, for the Retry-After header. Never above the
+  # fixed period, so a sub-second overshoot cannot advertise 31.
+  def retry_after
+    return 0 unless cooling_down?
+
+    (cooldown_until - Time.current).ceil.clamp(1, COOLDOWN_PERIOD.to_i)
+  end
+
+  def record_webhook_success!
+    with_lock do
+      return if suspended?
+
+      update!(consecutive_webhook_failures: 0) if consecutive_webhook_failures.to_i.nonzero?
+    end
+  end
+
+  def record_webhook_failure!
+    with_lock do
+      return if suspended?
+
+      next_count = consecutive_webhook_failures.to_i + 1
+      update!(consecutive_webhook_failures: next_count)
+      suspend!(reason: "webhook_failures") if next_count >= WEBHOOK_FAILURE_LIMIT
+    end
+  end
+
+  def suspend!(reason:)
+    return if suspended?
+
+    update!(
+      suspended_at: Time.current,
+      suspension_reason: reason,
+      cooldown_until: nil,
+      cooldown_attempts: 0,
+    )
+    Rails.logger.warn("Bot #{id} suspended (#{reason})")
+  end
+
+  # An administrator bringing the bot back. Clears the strike so it can post
+  # and receive webhooks immediately, instead of inheriting the old cooldown.
+  def reactivate!
+    update!(
+      suspended_at: nil,
+      suspension_reason: nil,
+      cooldown_until: nil,
+      cooldown_attempts: 0,
+      consecutive_webhook_failures: 0,
+    )
+  end
+
+  private
+    def cooling_down?
+      cooldown_until.present? && cooldown_until.future?
+    end
+
+    def flooding?
+      return false unless user
+
+      user.messages.where("created_at > ?", FLOOD_WINDOW.ago).count >= FLOOD_LIMIT
+    end
+
+    def clear_expired_cooldown!
+      return if cooldown_until.blank? && cooldown_attempts.to_i.zero?
+
+      update!(cooldown_until: nil, cooldown_attempts: 0)
+    end
+
+    def start_cooldown!
+      update!(cooldown_until: COOLDOWN_PERIOD.from_now, cooldown_attempts: 0)
+    end
+
+    # The post that crossed the limit opened this cooldown and is not one of
+    # these attempts. The fifth attempt during the same cooldown suspends.
+    def note_cooldown_attempt!
+      next_count = cooldown_attempts.to_i + 1
+      if next_count >= COOLDOWN_ATTEMPT_LIMIT
+        suspend!(reason: "flooding")
+      else
+        update!(cooldown_attempts: next_count)
+      end
+    end
+end
diff --git a/app/models/bot/webhook_delivery.rb b/app/models/bot/webhook_delivery.rb
new file mode 100644
index 0000000..0fe5635
--- /dev/null
+++ b/app/models/bot/webhook_delivery.rb
@@ -0,0 +1,214 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class Bot::WebhookDelivery
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+  MAX_RESPONSE_BYTES = 256.kilobytes
+
+  def self.deliver_later(message)
+    bots_for(message).each do |bot|
+      Bot::DeliverWebhookJob.perform_later(bot, message)
+    end
+  end
+
+  def self.bots_for(message)
+    user_ids = message.mentionees.map(&:id)
+    return Bot.none if user_ids.empty?
+
+    Bot.joins(:user).merge(User.active)
+      .where(suspended_at: nil)
+      .where(user_id: user_ids)
+      .where.not(user_id: message.creator_id)
+      .where.not(webhook_url: [ nil, "" ])
+  end
+
+  def self.deliver_joined(bot, room)
+    new(bot, room: room, event: "joined").deliver
+  end
+
+  def initialize(bot, message = nil, room: nil, event: nil)
+    @bot = bot
+    @message = message
+    @room = room || message&.room
+    @event = event || "mention"
+  end
+
+  def deliver
+    bot.reload
+    return if bot.webhook_url.blank?
+    return if bot.suspended?
+    return unless bot.active?
+    return if room.nil?
+    return if joined? && (room.direct? || room.type == "Rooms::Direct")
+    return unless uri
+
+    post_webhook
+  end
+
+  private
+    attr_reader :bot, :message, :room, :event
+
+    def post_webhook
+      record_delivery(request_webhook(ip: pinned_ip))
+    rescue => e
+      record_delivery(false)
+      Rails.logger.warn("Bot #{bot.id} webhook failed for #{failure_target}: #{e.class}: #{e.message}")
+    end
+
+    def record_delivery(succeeded)
+      if succeeded
+        bot.record_webhook_success!
+      else
+        bot.record_webhook_failure!
+      end
+    rescue => e
+      # A moderation write must not fail the job. A retry would deliver again
+      # and double-count the failure.
+      Rails.logger.error("Bot #{bot.id} webhook moderation update failed: #{e.class}: #{e.message}")
+    end
+
+    def failure_target
+      message ? "message #{message.id}" : "#{event} in room #{room&.id}"
+    end
+
+    def joined?
+      event == "joined"
+    end
+
+    # Pin the connection to a public address. Production stops there: an internal
+    # or unresolvable host is refused. Local environments still try unpinned, so
+    # a developer (and the test suite) can point a bot at localhost or a stub
+    # that never resolves.
+    def pinned_ip
+      RestrictedHTTP::PrivateNetworkGuard.resolve(uri.host)
+    rescue RestrictedHTTP::Violation, Surfguard::Unresolvable => e
+      raise unless Rails.env.local?
+
+      Rails.logger.info("Bot #{bot.id} webhook host was not public (#{e.class}); trying it anyway in #{Rails.env}")
+      nil
+    end
+
+    def request_webhook(ip: nil)
+      options = { use_ssl: uri.scheme == "https", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT }
+      options[:ipaddr] = ip if ip
+
+      succeeded = false
+
+      Net::HTTP.start(uri.host, uri.port, **options) do |http|
+        http.request(build_request) do |response|
+          if response.is_a?(Net::HTTPSuccess)
+            # Only 200 text/plain or text/html is a reply. Any other 2xx is
+            # still a successful delivery and resets the failure streak.
+            handle_response(response) if response.is_a?(Net::HTTPOK)
+            succeeded = true
+          end
+        end
+      end
+
+      succeeded
+    end
+
+    def build_request
+      Net::HTTP::Post.new(uri).tap do |request|
+        request["Content-Type"] = "application/json"
+        request["Accept"] = "text/plain, text/html"
+        request["User-Agent"] = "Campfire"
+        request.body = payload.to_json
+      end
+    end
+
+    def handle_response(response)
+      return unless response.is_a?(Net::HTTPOK)
+
+      body = response_body(response)
+      return if body.blank?
+
+      case response.content_type.to_s.downcase
+      when "text/plain"
+        post_reply Bot::MessageBody.from_plain_text(body)
+      when "text/html"
+        post_reply Bot::MessageBody.from_html(body)
+      end
+    end
+
+    def response_body(response)
+      body = +""
+      response.read_body do |chunk|
+        body << chunk
+        return "" if body.bytesize > MAX_RESPONSE_BYTES
+      end
+
+      body.force_encoding(Encoding::UTF_8)
+      body.scrub!
+      body
+    end
+
+    def post_reply(html)
+      return if html.blank?
+      return if room.nil?
+      return unless bot.user.rooms.exists?(id: room.id)
+
+      outcome = bot.attempt_post do
+        room.messages.create_with_attachment!(creator: bot.user, body: html).tap(&:broadcast_create)
+      end
+      return if outcome == :ok
+
+      Rails.logger.info("Bot #{bot.id} reply was not posted (#{outcome})")
+    rescue ActiveRecord::RecordInvalid => e
+      Rails.logger.warn("Bot #{bot.id} reply was rejected: #{e.message}")
+    end
+
+    def payload
+      if joined?
+        { event: "joined", room: room_payload }
+      else
+        {
+          event: "mention",
+          author: { id: message.creator_id, name: message.creator.name },
+          room: room_payload,
+          message: {
+            id: message.id,
+            body: {
+              text: command_text,
+              html: rich_text_html
+            },
+            link: routes.room_at_message_path(room, message)
+          }
+        }
+      end
+    end
+
+    def room_payload
+      {
+        id: room.id,
+        name: room.name,
+        reply_to: routes.room_bot_messages_path(room, bot.code)
+      }
+    end
+
+    # The bot's own @-mention is the address, not part of the command.
+    def command_text
+      message.plain_text_body
+        .gsub("@#{bot.name}", "")
+        .gsub(/[ \t]{2,}/, " ")
+        .strip
+    end
+
+    def rich_text_html
+      message.body&.body&.to_html.to_s
+    end
+
+    def uri
+      return @uri if defined?(@uri)
+
+      parsed = URI.parse(bot.webhook_url.to_s)
+      @uri = parsed if parsed.is_a?(URI::HTTP) && parsed.host.present?
+    rescue URI::InvalidURIError
+      @uri = nil
+    end
+
+    def routes
+      Rails.application.routes.url_helpers
+    end
+end
