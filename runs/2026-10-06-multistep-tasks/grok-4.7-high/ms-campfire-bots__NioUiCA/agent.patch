+module Message::BotWebhooks
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :deliver_mentioned_bot_webhooks
+  end
+
+  private
+    # Enqueue only. The HTTP call happens in a job so mentioning a bot never
+    # waits on the bot's server, and a delivery failure cannot fail the post.
+    def deliver_mentioned_bot_webhooks
+      Bot::WebhookDelivery.deliver_later(self)
+    rescue => e
+      Rails.logger.error("Failed to enqueue bot webhooks for message #{id}: #{e.class}: #{e.message}")
+    end
+end
