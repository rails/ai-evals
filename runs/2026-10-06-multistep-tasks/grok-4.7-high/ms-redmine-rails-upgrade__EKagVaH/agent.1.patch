--- /dev/null
+++ b/bin/next
@@ -0,0 +1,9 @@
+#!/usr/bin/env ruby
+# frozen_string_literal: true
+
+# Run a command against Gemfile.next (Rails 7.0). Example: bin/next rails test
+APP_ROOT = File.expand_path('..', __dir__)
+Dir.chdir(APP_ROOT) do
+  ENV['BUNDLE_GEMFILE'] = File.expand_path('Gemfile.next', APP_ROOT)
+  exec('bundle', 'exec', *ARGV)
+end
