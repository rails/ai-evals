diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
new file mode 100644
index 0000000..7ce95f3
--- /dev/null
+++ b/config/initializers/active_storage.rb
@@ -0,0 +1,22 @@
+# Teach Active Storage's configurator about the Fog-backed service used for
+# profile pictures. Other uploads continue to use CarrierWave.
+#
+# This must run at boot, before models with attachments are eager-loaded and
+# ActiveStorage::Blob fetches the configured service.
+module Images
+  module ActiveStorageFogServiceResolver
+    private
+
+    def resolve(class_name)
+      return Images::ActiveStorageFogService if class_name.to_s == "Fog"
+
+      super
+    end
+  end
+end
+
+require "active_storage/service/configurator"
+
+unless ActiveStorage::Service::Configurator <= Images::ActiveStorageFogServiceResolver
+  ActiveStorage::Service::Configurator.prepend(Images::ActiveStorageFogServiceResolver)
+end
