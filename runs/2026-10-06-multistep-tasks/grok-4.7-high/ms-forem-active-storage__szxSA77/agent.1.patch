diff --git a/spec/services/images/active_storage_profile_image_spec.rb b/spec/services/images/active_storage_profile_image_spec.rb
new file mode 100644
index 0000000..3f9f8f0
--- /dev/null
+++ b/spec/services/images/active_storage_profile_image_spec.rb
@@ -0,0 +1,108 @@
+require "rails_helper"
+
+RSpec.describe Images::ActiveStorageProfileImage do
+  let(:image_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+
+  def legacy_user
+    user = build(:user, profile_image: nil)
+    user.save!
+    user.update_columns(profile_image: "legacy-avatar.png", active_storage_profile_image_signed_id: nil)
+    user.reload
+  end
+
+  describe "existing CarrierWave profile pictures" do
+    it "keeps serving the CarrierWave URL and does not attach Active Storage" do
+      user = legacy_user
+
+      expect(user.profile_image_url).to include("/uploads/user/profile_image/#{user.id}/legacy-avatar.png")
+      expect(user.profile_picture).not_to be_attached
+      expect(user.active_storage_profile_image_signed_id).to be_nil
+      expect(user.profile_image_url_for(length: 90)).to include("legacy-avatar.png")
+    end
+
+    it "does not move an existing picture when unrelated attributes change" do
+      user = legacy_user
+      original_url = user.profile_image_url
+
+      user.update!(name: "Still Visible")
+
+      expect(user.reload.profile_image_url).to eq(original_url)
+      expect(user.profile_picture).not_to be_attached
+      expect(user[:profile_image]).to eq("legacy-avatar.png")
+    end
+  end
+
+  describe "new profile pictures" do
+    it "stores a user upload in Active Storage and leaves the CarrierWave column empty" do
+      user = create(:user)
+
+      expect(user.profile_picture).to be_attached
+      expect(user.active_storage_profile_image_signed_id).to be_present
+      expect(user[:profile_image]).to be_nil
+      expect(user.profile_image_url).to include("/rails/active_storage/blobs/proxy/")
+      expect(user.profile_image_url).to include("profile-image")
+      expect(File.binread(user.profile_image.path)).to eq(File.binread(image_path))
+    end
+
+    it "stores an organization upload in Active Storage without touching cover images" do
+      organization = create(:organization)
+
+      expect(organization.profile_picture).to be_attached
+      expect(organization.profile_image_url).to include("/rails/active_storage/blobs/proxy/")
+      expect(organization[:profile_image]).to be_nil
+      expect(organization.class.uploaders[:cover_image]).to eq(CoverImageUploader)
+      expect(organization.cover_image).to be_a(CoverImageUploader)
+    end
+
+    it "replaces a visible CarrierWave picture with the new Active Storage picture" do
+      user = legacy_user
+      previous_url = user.profile_image_url
+
+      user.profile_image = File.open(image_path)
+      user.save!
+
+      expect(user.reload.profile_image_url).not_to eq(previous_url)
+      expect(user.profile_image_url).to include("/rails/active_storage/blobs/proxy/")
+      expect(user.profile_picture).to be_attached
+      # The old CarrierWave object is left in place for a later migration deploy.
+      expect(user[:profile_image]).to eq("legacy-avatar.png")
+    end
+
+    it "downloads remote profile pictures into Active Storage" do
+      body = Rails.root.join("app/assets/images/1.png").binread
+      stub_request(:get, "https://dummyimage.com/avatar.png").to_return(
+        status: 200,
+        body: body,
+        headers: { "Content-Type" => "image/png" },
+      )
+
+      user = build(:user, profile_image: nil)
+      user.remote_profile_image_url = "https://dummyimage.com/avatar.png"
+      user.save!
+
+      expect(user.remote_profile_image_url).to eq("https://dummyimage.com/avatar.png")
+      expect(user.reload.profile_picture).to be_attached
+      expect(user.profile_image_url).to include("/rails/active_storage/blobs/proxy/")
+      expect(user.profile_image_url).to include("profile-image.png")
+    end
+
+    it "rejects an unsupported upload without hiding an existing picture" do
+      user = legacy_user
+      pdf = fixture_file_upload("800x600.pdf", "application/pdf")
+
+      expect(user.update(profile_image: pdf)).to be(false)
+      expect(user.errors[:profile_image]).to be_present
+      expect(user.reload.profile_image_url).to include("legacy-avatar.png")
+      expect(user.profile_picture).not_to be_attached
+    end
+  end
+
+  describe "other uploads" do
+    it "keeps non-profile uploaders on CarrierWave" do
+      expect(User.uploaders[:profile_image]).to eq(ProfileImageUploader)
+      expect(Organization.uploaders[:profile_image]).to eq(ProfileImageUploader)
+      expect(Organization.uploaders[:cover_image]).to eq(CoverImageUploader)
+      expect(Badge.uploaders[:badge_image]).to eq(BadgeUploader)
+    end
+  end
+end
