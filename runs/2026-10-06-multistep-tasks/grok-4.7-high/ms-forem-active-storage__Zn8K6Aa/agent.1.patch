+# Profile pictures are the only Active Storage uploads in this deploy.
+# Skip analyzers so attaching an image does not enqueue a job (and does not
+# depend on Redis) before Sidekiq is confirmed to be running the new jobs.
+Rails.application.config.active_storage.analyzers = []
+
+# ActiveStorage::Service::Configurator resolves "Forem" by requiring
+# active_storage/service/forem_service. lib/ is autoloaded but not on $LOAD_PATH.
+lib_path = Rails.root.join("lib").to_s
+$LOAD_PATH.unshift(lib_path) unless $LOAD_PATH.include?(lib_path)
