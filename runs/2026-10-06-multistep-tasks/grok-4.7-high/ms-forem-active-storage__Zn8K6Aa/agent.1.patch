index 0000000..c89fb19
--- /dev/null
+++ b/spec/models/concerns/profile_images/active_storage_transition_spec.rb
@@ -0,0 +1,146 @@
+require "rails_helper"
+
+RSpec.describe ProfileImages::ActiveStorageTransition do
+  let(:image_path) { Rails.root.join("spec/fixtures/files/800x600.jpg") }
+  let(:replacement_path) { Rails.root.join("app/assets/images/2.png") }
+
+  describe "scope" do
+    it "moves only user and organization profile pictures" do
+      expect(User.ancestors).to include(described_class)
+      expect(Organization.ancestors).to include(described_class)
+      expect(Tag.ancestors).not_to include(described_class)
+      expect(Tweet.ancestors).not_to include(described_class)
+    end
+  end
+
+  describe "new profile pictures" do
+    it "stores a new user profile picture in Active Storage without dropping the public URL" do
+      user = create(:user, profile_image: Rack::Test::UploadedFile.new(image_path, "image/jpeg"))
+
+      expect(user).to be_profile_image_in_active_storage
+      expect(user.profile_picture.blob.key).to eq(expected_key(user))
+      expect(user.profile_image_url).to eq("/#{expected_key(user)}")
+      expect(Rails.public_path.join(expected_key(user)).exist?).to be(true)
+      expect(Rails.public_path.join(expected_key(user)).binread).to eq(image_path.binread)
+    end
+
+    it "stores a new organization profile picture in Active Storage" do
+      organization = create(:organization, profile_image: File.open(replacement_path))
+
+      expect(organization).to be_profile_image_in_active_storage
