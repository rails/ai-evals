diff --git a/test/integration/prizes_test.rb b/test/integration/prizes_test.rb
new file mode 100644
index 0000000..85c8c92
--- /dev/null
+++ b/test/integration/prizes_test.rb
@@ -0,0 +1,318 @@
+require "test_helper"
+
+class PrizesTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "s3cret"
+    @auth = {
+      "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "s3cret")
+    }
+    @quiz = Quiz.create!(title: "Prize Night")
+    @q1 = add_question(@quiz, "One?", [ [ "Yes", true ], [ "No", false ] ])
+    @q2 = add_question(@quiz, "Two?", [ [ "Right", true ], [ "Wrong", false ] ])
+  end
+
+  test "settings include number of winners, default 3, at least 1" do
+    assert_equal 3, @quiz.winner_count
+
+    get edit_moderate_quiz_path(@quiz), headers: @auth
+    assert_select "label", text: "Number of winners"
+    assert_select "input[name='quiz[winner_count]'][value='3']"
+
+    patch moderate_quiz_path(@quiz), params: { quiz: { title: @quiz.title, winner_count: 0 } }, headers: @auth
+    assert_response :unprocessable_entity
+    assert_equal 3, @quiz.reload.winner_count
+    assert_select "label", text: "Number of winners"
+
+    patch moderate_quiz_path(@quiz), params: { quiz: { title: @quiz.title, winner_count: "" } }, headers: @auth
+    assert_response :unprocessable_entity
+
+    patch moderate_quiz_path(@quiz), params: { quiz: { title: @quiz.title, winner_count: 2 } }, headers: @auth
+    assert_redirected_to moderate_quiz_path(@quiz)
+    assert_equal 2, @quiz.reload.winner_count
+  end
+
+  test "new quizzes default the winner count when the field is omitted" do
+    post moderate_quizzes_path, params: { quiz: { title: "Defaults" } }, headers: @auth
+    quiz = Quiz.order(:id).last
+    assert_equal 3, quiz.winner_count
+  end
+
+  test "leaderboard ranks by points then shows place and points only after the end" do
+    game = start_game
+    alice = join(game, "Alice")
+    bob = join(game, "Bob")
+    cara = join(game, "Cara")
+    post start_moderate_quiz_game_path(@quiz, game), headers: @auth
+    game.reload
+
+    game.update!(question_opened_ms: Game.clock_ms - 5_000)
+    answer(alice, game, @q1.options.find_by!(body: "Yes").id)
+    game.update!(question_opened_ms: Game.clock_ms - 1_000)
+    answer(bob, game, @q1.options.find_by!(body: "Yes").id)
+    answer(cara, game, @q1.options.find_by!(body: "No").id)
+
+    post finish_moderate_quiz_game_path(@quiz, game), headers: @auth
+    post advance_moderate_quiz_game_path(@quiz, game), headers: @auth
+    game.reload
+    assert game.question?
+
+    alice.get play_path(game.code)
+    alice.assert_no_match(/points/, alice.response.body)
+    alice.assert_no_match(/Place \d/, alice.response.body)
+
+    game.update!(question_opened_ms: Game.clock_ms - 800)
+    answer(alice, game, @q2.options.find_by!(body: "Right").id)
+    answer(bob, game, @q2.options.find_by!(body: "Wrong").id)
+
+    post finish_moderate_quiz_game_path(@quiz, game), headers: @auth
+    post advance_moderate_quiz_game_path(@quiz, game), headers: @auth
+    follow_moderator!
+
+    assert_match "The quiz is over", response.body
+    assert_select "ul.leaderboard > li", count: 3
+    names = css_select("ul.leaderboard > li .leader__name").map { |node| node.text.gsub("Winner", "").strip }
+    assert_equal [ "Alice", "Bob", "Cara" ], names
+    scores = css_select("ul.leaderboard > li .leader__score").map(&:text)
+    assert_equal [ "2 points", "1 point", "0 points" ], scores
+    places = css_select("ul.leaderboard > li .leader__place").map(&:text)
+    assert_equal [ "1", "2", "3" ], places
+    assert_select "button", text: "Top 3"
+    assert_select "button", text: "Draw"
+    assert_select "button", text: "Reset winners"
+
+    alice.get play_path(game.code)
+    alice.assert_match "The quiz is over", alice.response.body
+    alice.assert_match "Place 1 of 3", alice.response.body
+    alice.assert_match "2 points", alice.response.body
+    alice.assert_no_match(/You won!/, alice.response.body)
+
+    bob.get play_path(game.code)
+    bob.assert_match "Place 2 of 3", bob.response.body
+    bob.assert_match "1 point", bob.response.body
+
+    cara.get play_path(game.code)
+    cara.assert_match "Place 3 of 3", cara.response.body
+    cara.assert_match "0 points", cara.response.body
+  end
+
+  test "equal points are ranked by the lower total time of correct answers" do
+    game = start_game
+    slow = game.enroll!("Slow")
+    fast = game.enroll!("Fast")
+    game.start!
+    yes = @q1.options.find_by!(body: "Yes")
+    game.accept_answer!(slow, yes)
+    game.answers.find_by!(player: slow).update!(elapsed_ms: 4_000)
+    game.accept_answer!(fast, yes)
+    game.answers.find_by!(player: fast).update!(elapsed_ms: 200)
+    game.finish_question!
+    game.advance!
+    right = @q2.options.find_by!(body: "Right")
+    wrong = @q2.options.find_by!(body: "Wrong")
+    game.accept_answer!(slow, wrong)
+    game.answers.find_by!(player: slow, question: @q2).update!(elapsed_ms: 10)
+    game.accept_answer!(fast, right)
+    game.answers.find_by!(player: fast, question: @q2).update!(elapsed_ms: 900)
+    game.finish_question!
+    game.advance!
+    game.reload
+
+    names = Leaderboard.new(game).entries.map { |entry| [ entry.player.name, entry.points, entry.time_ms ] }
+    assert_equal [ [ "Fast", 2, 1_100 ], [ "Slow", 1, 4_000 ] ], names
+  end
+
+  test "answer elapsed time runs from the shared open instant to the last pick" do
+    game = start_game
+    player = game.enroll!("Ada")
+    before = Game.clock_ms
+    game.start!
+    game.reload
+    assert_operator game.question_opened_ms, :>=, before
+
+    game.update!(question_opened_ms: Game.clock_ms - 1_500)
+    assert game.accept_answer!(player, @q1.options.find_by!(body: "Yes"))
+    first = game.answers.find_by!(player: player).elapsed_ms
+    assert_in_delta 1_500, first, 400
+
+    game.update!(question_opened_ms: Game.clock_ms - 3_000)
+    assert game.accept_answer!(player, @q1.options.find_by!(body: "No"))
+    second = game.answers.find_by!(player: player).reload.elapsed_ms
+    assert_in_delta 3_000, second, 400
+    assert_operator second, :>, first
+  end
+
+  test "top, draw, and reset winners and phones learn the result from state" do
+    @quiz.update!(winner_count: 1)
+    game = start_game
+    sessions = {}
+    %w[Ann Bea Cal].each { |name| sessions[name] = join(game, name) }
+    game.start!
+    %w[Ann Bea Cal].each do |name|
+      game.accept_answer!(game.players.find_by!(name: name), @q1.options.find_by!(body: "Yes"))
+    end
+    game.players.find_by!(name: "Ann").answers.first.update!(elapsed_ms: 100)
+    game.players.find_by!(name: "Bea").answers.first.update!(elapsed_ms: 200)
+    game.players.find_by!(name: "Cal").answers.first.update!(elapsed_ms: 300)
+    close_game!(game)
+
+    get moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_select "button", text: "Top 1"
+    assert_select "ul.leaderboard > li", count: 3
+
+    post top_moderate_quiz_game_path(@quiz, game), headers: @auth.merge("Accept" => "application/json")
+    assert_response :success
+    payload = JSON.parse(response.body)
+    assert_includes payload["body_html"], "Winner"
+    assert_includes payload["controls_html"], "Top 1"
+    assert_equal [ "Ann" ], game.players.where(winner: true).pluck(:name)
+
+    ann = sessions["Ann"]
+    ann.get state_play_path(game.code), params: { phase_key: "finished" }, headers: { "Accept" => "application/json" }
+    phone = JSON.parse(ann.response.body)
+    assert_includes phone["body_html"], "You won!"
+    assert_includes phone["body_html"], "Place 1 of 3"
+    assert_includes phone["body_html"], "1 point"
+
+    sessions["Bea"].get play_path(game.code)
+    sessions["Bea"].assert_no_match(/You won!/, sessions["Bea"].response.body)
+
+    post reset_winners_moderate_quiz_game_path(@quiz, game), headers: @auth
+    follow_moderator!
+    assert_equal 0, game.players.reload.where(winner: true).count
+    assert_no_match(/Winner/, response.body)
+
+    ann.get state_play_path(game.code), params: { phase_key: "finished-won" }, headers: { "Accept" => "application/json" }
+    cleared = JSON.parse(ann.response.body)
+    assert_not_includes cleared["body_html"], "You won!"
+
+    board = Leaderboard.new(game.reload)
+    drawn = 20.times.map { |i| board.draw_winner_ids(Random.new(i)) }
+    assert drawn.all? { |ids| ids.size == 1 }
+    assert_operator drawn.uniq.size, :>, 1
+
+    post draw_moderate_quiz_game_path(@quiz, game), headers: @auth
+    follow_moderator!
+    assert_equal 1, game.players.where(winner: true).count
+    assert_select "li.is-winner .leader__badge", text: "Winner"
+  end
+
+  test "zero point players never win and a short field of scorers all win" do
+    @quiz.update!(winner_count: 3)
+    game = start_game
+    scored = game.enroll!("Scored")
+    zero = game.enroll!("Zero")
+    game.start!
+    game.accept_answer!(scored, @q1.options.find_by!(body: "Yes"))
+    close_game!(game)
+
+    game.pick_top_winners!
+    assert_equal [ "Scored" ], game.players.where(winner: true).order(:name).pluck(:name)
+    assert_not zero.reload.winner?
+
+    game.reset_winners!
+    game.draw_winners!(random: Random.new(1))
+    assert_equal [ "Scored" ], game.players.where(winner: true).pluck(:name)
+    assert_not zero.reload.winner?
+  end
+
+  test "draw ignores speed and each click can pick a different tie" do
+    @quiz.update!(winner_count: 2)
+    game = start_game
+    names = %w[Ada Bo Cy Dee]
+    players = names.map { |name| game.enroll!(name) }
+    game.start!
+    yes = @q1.options.find_by!(body: "Yes")
+    players.each_with_index do |player, index|
+      game.accept_answer!(player, yes)
+      game.answers.find_by!(player: player).update!(elapsed_ms: (index + 1) * 100)
+    end
+    close_game!(game)
+
+    board = Leaderboard.new(game.reload)
+    assert_equal names, board.entries.map { |entry| entry.player.name }
+    sets = 40.times.map { board.draw_winner_ids(Random.new).sort }
+    assert_operator sets.uniq.size, :>, 1
+    sets.each { |ids| assert_equal 2, ids.size }
+    assert sets.any? { |ids| ids.include?(players.last.id) && !ids.include?(players.first.id) }
+
+    game.pick_top_winners!
+    assert_equal players.first(2).map(&:id).sort, game.players.where(winner: true).pluck(:id).sort
+  end
+
+  test "players above the cutoff win and remaining prizes are drawn from the tie" do
+    @quiz.update!(winner_count: 3)
+    game = start_game
+    top = game.enroll!("Top")
+    tied = 3.times.map { |i| game.enroll!("Tie#{i}") }
+    low = game.enroll!("Low")
+    game.start!
+    yes = @q1.options.find_by!(body: "Yes")
+    game.accept_answer!(top, yes)
+    tied.each { |player| game.accept_answer!(player, yes) }
+    game.finish_question!
+    game.advance!
+    game.accept_answer!(top, @q2.options.find_by!(body: "Right"))
+    close_game!(game)
+
+    board = Leaderboard.new(game.reload)
+    assert_equal [ 2, 1, 1, 1, 0 ], board.entries.map(&:points)
+    15.times do |seed|
+      ids = board.draw_winner_ids(Random.new(seed))
+      assert_includes ids, top.id
+      assert_not_includes ids, low.id
+      assert_equal 2, (ids & tied.map(&:id)).size
+      assert_equal 3, ids.size
+    end
+  end
+
+  test "state with a stale version returns immediately" do
+    game = start_game
+    post start_moderate_quiz_game_path(@quiz, game), headers: @auth
+    game.reload
+    assert game.question_opened_ms.present?
+
+    get state_moderate_quiz_game_path(@quiz, game),
+      headers: @auth.merge("Accept" => "application/json"),
+      params: { wait: "1", version: 0 }
+    assert_response :success
+    assert_equal "question", JSON.parse(response.body)["phase"]
+  end
+
+  private
+    def add_question(quiz, body, options)
+      question = quiz.questions.create!(body: body, position: quiz.questions.count + 1, active: true)
+      options.each_with_index do |(text, correct), index|
+        question.options.create!(body: text, position: index + 1, correct: correct)
+      end
+      question
+    end
+
+    def start_game
+      post moderate_quiz_games_path(@quiz), headers: @auth
+      Game.order(:id).last
+    end
+
+    def join(game, name)
+      session = open_session
+      session.post join_play_path(game.code), params: { name: name }
+      session.follow_redirect!
+      session
+    end
+
+    def answer(session, game, option_id)
+      session.post answer_play_path(game.code), params: { option_id: option_id }
+    end
+
+    def close_game!(game)
+      game.finish_question! if game.question?
+      game.advance! if game.results?
+      game.finish_question! if game.question?
+      game.advance! if game.results?
+      game.reload
+    end
+
+    def follow_moderator!
+      follow_redirect!(headers: @auth)
+    end
+end
