@@ -0,0 +1,17 @@
+module Moderate
+  class ImportsController < BaseController
+    def new
+      @quiz_json = ""
+      @errors = []
+    end
+
+    def create
+      @quiz_json = params[:quiz_json].to_s
+      quiz = QuizImport.call(@quiz_json)
+      redirect_to moderate_quiz_path(quiz)
+    rescue QuizImport::Error => error
+      @errors = error.messages
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
