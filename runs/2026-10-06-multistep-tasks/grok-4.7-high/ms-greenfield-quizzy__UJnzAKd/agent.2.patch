@@ -0,0 +1,32 @@
+<% content_for :title, "Quizzy · Import quiz" %>
+<%= render "shared/admin_header" %>
+<main class="admin-main">
+  <div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+  <div class="page-head"><h1>Import quiz</h1></div>
+
+  <div class="card">
+    <%= form_with url: moderate_import_path, method: :post, html: { autocomplete: "off" } do %>
+      <% if @errors.present? %>
+        <div class="errors" role="alert">
+          <p>Error: could not import this quiz. Nothing was imported.</p>
+          <ul>
+            <% @errors.each do |message| %>
+              <li><%= message %></li>
+            <% end %>
+          </ul>
+        </div>
+      <% end %>
+
+      <div class="field">
+        <label class="field-label" for="quiz_json">Quiz JSON</label>
+        <span class="field-hint">Paste a quiz exported from Quizzy. Import always creates a new quiz.</span>
+        <textarea class="input input--code" id="quiz_json" name="quiz_json" rows="18" aria-label="Quiz JSON"><%= @quiz_json %></textarea>
+      </div>
+
+      <div class="buttons">
+        <button type="submit" class="btn btn--pink">Import</button>
+        <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+      </div>
+    <% end %>
+  </div>
+</main>
