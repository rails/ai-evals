diff --git a/app/views/moderate/previews/show.html.erb b/app/views/moderate/previews/show.html.erb
new file mode 100644
index 0000000..a196fad
--- /dev/null
+++ b/app/views/moderate/previews/show.html.erb
@@ -0,0 +1,75 @@
+<% content_for :title, "Quizzy · Preview" %>
+<div class="preview-banner">
+  <span>Preview · <%= @quiz.title %></span>
+  <div class="buttons">
+    <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
+    <%= form_with url: reset_moderate_quiz_preview_path(@quiz), method: :post do %>
+      <button type="submit" class="btn btn--sm btn--light">Start over</button>
+    <% end %>
+  </div>
+</div>
+
+<div class="play">
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @quiz.title %></span>
+  </div>
+
+  <% if @phase == "empty" %>
+    <div class="play__body">
+      <h1 class="play-title">No active questions</h1>
+      <p class="play-lead">Activate at least one question to preview this quiz.</p>
+      <%= link_to "Back to quiz", moderate_quiz_path(@quiz), class: "btn" %>
+    </div>
+  <% elsif @phase == "score" %>
+    <div class="play__body">
+      <div class="score-card result-card">
+        <div class="result-card__label">Preview complete</div>
+        <div class="result-card__score">Score: <%= @correct %>/<%= @total %></div>
+      </div>
+    </div>
+  <% else %>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= @index + 1 %> of <%= @total %></div>
+      <div class="play-question__body"><%= @question.body %></div>
+
+      <% if @answered %>
+        <div class="play-options is-locked is-revealed">
+          <% @question.options.each_with_index do |option, index| %>
+            <% picked = option.id.to_s == @picked_id.to_s %>
+            <button type="button" class="play-option<%= " is-correct" if option.correct %><%= " is-picked" if picked %>" disabled>
+              <span class="play-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+              <span class="play-option__title"><%= option.body %></span>
+              <% if option.correct %>
+                <span class="play-option__mark" aria-hidden="true">✓</span>
+              <% end %>
+            </button>
+          <% end %>
+        </div>
+        <div class="play-status <%= @correct_pick ? "play-status--right" : "play-status--wrong" %>">
+          <%= @correct_pick ? "Correct!" : "Wrong!" %>
+        </div>
+        <div class="buttons preview-actions">
+          <% if @last %>
+            <%= form_with url: score_moderate_quiz_preview_path(@quiz), method: :post do %>
+              <button type="submit" class="btn btn--pink">See score</button>
+            <% end %>
+          <% else %>
+            <%= form_with url: advance_moderate_quiz_preview_path(@quiz), method: :post do %>
+              <button type="submit" class="btn btn--pink">Next question</button>
+            <% end %>
+          <% end %>
+        </div>
+      <% else %>
+        <%= form_with url: answer_moderate_quiz_preview_path(@quiz), method: :post, html: { class: "play-options" } do %>
+          <% @question.options.each_with_index do |option, index| %>
+            <button type="submit" class="play-option" name="option_id" value="<%= option.id %>">
+              <span class="play-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+              <span class="play-option__title"><%= option.body %></span>
+            </button>
+          <% end %>
+        <% end %>
+      <% end %>
+    </div>
+  <% end %>
+</div>
diff --git a/app/views/moderate/questions/_form.html.erb b/app/views/moderate/questions/_form.html.erb
new file mode 100644
index 0000000..8429ff5
--- /dev/null
+++ b/app/views/moderate/questions/_form.html.erb
@@ -0,0 +1,67 @@
+<% if form_object.persisted? %>
+  <% url = moderate_quiz_question_path(quiz, form_object.question) %>
+  <% http_method = :patch %>
+<% else %>
+  <% url = moderate_quiz_questions_path(quiz) %>
+  <% http_method = :post %>
+<% end %>
+
+<div class="card">
+  <%= form_with url: url, method: http_method, html: { autocomplete: "off" } do %>
+    <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true"></button>
+    <% if form_object.errors.any? %>
+      <div class="errors" role="alert">
+        <ul>
+          <% form_object.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <div class="field">
+      <label class="field-label" for="question_body">Question</label>
+      <textarea class="input" id="question_body" name="question[body]" rows="3"><%= form_object.body %></textarea>
+    </div>
+
+    <div class="field">
+      <span class="field-label">Options</span>
+      <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
+    </div>
+
+    <div class="option-rows">
+      <% Array(form_object.options).each_with_index do |option, index| %>
+        <div class="option-row">
+          <div class="option-row__field">
+            <label class="field-label" for="option_body_<%= index %>">Option <%= index + 1 %></label>
+            <input class="input" type="text" id="option_body_<%= index %>" name="question[options][<%= index %>][body]" value="<%= option[:body] %>" placeholder="Option <%= index + 1 %>">
+          </div>
+          <label class="checkbox" for="option_correct_<%= index %>">
+            <input type="hidden" name="question[options][<%= index %>][correct]" value="0" autocomplete="off">
+            <input type="checkbox" id="option_correct_<%= index %>" name="question[options][<%= index %>][correct]" value="1" <%= "checked" if option[:correct] %> aria-label="Option <%= index + 1 %> is correct">
+            Option <%= index + 1 %> is correct
+          </label>
+          <button type="submit" name="remove_option" value="<%= index %>" formnovalidate class="btn btn--danger btn--icon" aria-label="Remove option">✕</button>
+        </div>
+      <% end %>
+    </div>
+
+    <div class="buttons" style="margin-bottom: 28px">
+      <button type="submit" name="add_option" value="1" formnovalidate class="btn btn--ghost btn--sm">Add option</button>
+    </div>
+
+    <div class="field">
+      <label class="checkbox" for="question_active">
+        <input type="hidden" name="question[active]" value="0" autocomplete="off">
+        <input type="checkbox" id="question_active" name="question[active]" value="1" <%= "checked" if form_object.active %> aria-label="Active">
+        Active
+      </label>
+      <span class="field-hint">Players only see questions with this checked.</span>
+    </div>
+
+    <div class="buttons">
+      <button type="submit" class="btn btn--pink">Save question</button>
+      <%= link_to "Cancel", moderate_quiz_path(quiz), class: "btn btn--ghost" %>
+    </div>
+  <% end %>
+</div>
