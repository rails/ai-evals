@@ -0,0 +1,48 @@
+<% content_for :title, "Quizzy · #{@quiz.title}" %>
+<%= render "shared/admin_header" %>
+<main class="admin-main">
+  <div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+  <div class="page-head">
+    <div>
+      <h1><%= @quiz.title %></h1>
+      <div class="meta mt-2">
+        <%= @questions.count(&:active) %> of <%= @questions.size %> questions active ·
+        <%= link_to "Settings", edit_moderate_quiz_path(@quiz) %>
+      </div>
+    </div>
+    <div class="buttons">
+      <%= button_to "Start a game", moderate_quiz_games_path(@quiz), method: :post, class: "btn btn--pink" %>
+      <%= link_to "Preview", moderate_quiz_preview_path(@quiz), class: "btn btn--ghost" %>
+      <%= link_to "Export", export_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+    </div>
+  </div>
+
+  <section class="section mt-0">
+    <div class="section-head">
+      <h2>Questions</h2>
+      <%= button_to "Add question", new_moderate_quiz_question_path(@quiz), method: :get, class: "btn" %>
+    </div>
+
+    <% if @questions.any? %>
+      <ul class="question-list">
+        <% active_number = 0 %>
+        <% @questions.each_with_index do |question, index| %>
+          <% if question.active %>
+            <% active_number += 1 %>
+            <% number = active_number %>
+          <% else %>
+            <% number = "—" %>
+          <% end %>
+          <%= render "question",
+                quiz: @quiz,
+                question: question,
+                number: number,
+                first: index.zero?,
+                last: index == @questions.size - 1 %>
+        <% end %>
+      </ul>
+    <% else %>
+      <div class="empty">No questions yet.</div>
+    <% end %>
+  </section>
+</main>
diff --git a/app/views/plays/_body.html.erb b/app/views/plays/_body.html.erb
new file mode 100644
index 0000000..f9d7d6d
--- /dev/null
+++ b/app/views/plays/_body.html.erb
@@ -0,0 +1,62 @@
+<% if @screen.show_join_form? %>
+  <h1 class="play-title"><%= @quiz.title %></h1>
+  <p class="play-lead">No account needed.</p>
+  <% if @join_error.present? %>
+    <div class="errors"><%= @join_error %></div>
+  <% end %>
+  <%= form_with url: join_play_path(@game.code), method: :post, html: { class: "join-form", data: { turbo: false, live_off: true } } do %>
+    <label for="player_name">Your name</label>
+    <input id="player_name" class="input" type="text" name="name" maxlength="80" autocomplete="nickname" autofocus required value="<%= params[:name] %>">
+    <button type="submit" class="btn btn--pink">Join</button>
+  <% end %>
+<% elsif @screen.over? %>
+  <h1 class="play-title">The quiz is over</h1>
+  <% if @screen.standing %>
+    <div class="result-card">
+      <p class="result-card__label"><%= @screen.place_label %></p>
+      <p class="result-card__score"><%= @screen.points_label %></p>
+    </div>
+    <% if @screen.won? %>
+      <p class="winner-banner">You won!</p>
+    <% end %>
+  <% end %>
+<% elsif @screen.waiting? %>
+  <div class="waiting">
+    <div class="waiting__gem" aria-hidden="true">?</div>
+    <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+    <p class="play-lead">Waiting for the quiz to start.</p>
+  </div>
+<% elsif @screen.question_open? %>
+  <div class="play-question__num">Question <%= @screen.number %> of <%= @screen.total %></div>
+  <div class="play-question__body"><%= @screen.question.body %></div>
+  <%= form_with url: answer_play_path(@game.code), method: :post, html: { class: "play-options", data: { turbo: false } } do %>
+    <% @screen.options.each do |option| %>
+      <% picked = option[:id] == @screen.picked_option_id %>
+      <button type="submit" name="option_id" value="<%= option[:id] %>" class="play-option<%= " is-picked" if picked %>"<% if picked %> aria-pressed="true"<% end %>>
+        <span class="play-option__letter" aria-hidden="true"><%= option[:letter] %></span>
+        <span class="play-option__title"><%= option[:body] %></span>
+        <% if picked %>
+          <span class="play-option__mark">Your answer</span>
+        <% end %>
+      </button>
+    <% end %>
+  <% end %>
+<% elsif @screen.showing_results? %>
+  <div class="play-question__num">Question <%= @screen.number %> of <%= @screen.total %></div>
+  <div class="play-question__body"><%= @screen.question.body %></div>
+  <div class="play-options is-locked">
+    <% @screen.options.each do |option| %>
+      <% picked = option[:id] == @screen.picked_option_id %>
+      <button type="button" class="play-option<%= " is-picked" if picked %>" disabled>
+        <span class="play-option__letter" aria-hidden="true"><%= option[:letter] %></span>
+        <span class="play-option__title"><%= option[:body] %></span>
+        <% if picked %>
+          <span class="play-option__mark">Your answer</span>
+        <% end %>
+      </button>
+    <% end %>
+  </div>
+  <div class="<%= @screen.status_class %>"><%= @screen.verdict %></div>
+<% else %>
+  <h1 class="play-title">The quiz is over</h1>
+<% end %>
