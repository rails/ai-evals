@@ -0,0 +1,25 @@
+module Moderate
+  class BaseController < ApplicationController
+    before_action :authenticate_moderator!
+
+    private
+      def authenticate_moderator!
+        authenticate_or_request_with_http_basic("Quizzy") do |username, password|
+          credentials_match?(username, ENV["QUIZZY_MODERATOR_USERNAME"]) &&
+            credentials_match?(password, ENV["QUIZZY_MODERATOR_PASSWORD"])
+        end
+      end
+
+      # Hash both sides so length differences cannot raise, and empty env credentials deny access.
+      def credentials_match?(provided, expected)
+        provided = provided.to_s
+        expected = expected.to_s
+        return false if expected.empty?
+
+        ActiveSupport::SecurityUtils.secure_compare(
+          Digest::SHA256.hexdigest(provided),
+          Digest::SHA256.hexdigest(expected)
+        )
+      end
+  end
+end
