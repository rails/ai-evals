+  font-weight: 600;
+}
+
+.leader__place {
+  display: grid;
+  place-items: center;
+  width: 1.9em;
+  height: 1.9em;
+  border-radius: 50%;
+  background: var(--c-lavender);
+  color: var(--c-blue);
