+  validates :winner_count, presence: true, numericality: { only_integer: true, greater_than_or_equal_to: 1 }
+  validates :timer_minutes, :timer_seconds,
+    presence: true,
+    numericality: { only_integer: true, greater_than_or_equal_to: 0 }
+
+  # Total time allowed for each question. 0 means the question stays open
+  # until the moderator clicks Finish.
