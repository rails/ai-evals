--- /dev/null
+++ b/app/views/moderate/games/_controls.html.erb
@@ -0,0 +1,29 @@
+<div class="screen-controls__info">
+  <span><%= @quiz.title %></span>
+  <% if @game.lobby? %>
+    <span data-counter="players">Players: <%= @screen.player_count %></span>
+  <% elsif @game.question? %>
+    <span data-counter="answers">Answers: <%= @screen.answered_count %> / <%= @screen.player_count %></span>
+    <% if @screen.timer_active? %>
+      <span class="screen-timer" data-counter="timer" data-timer-deadline="<%= @screen.timer_deadline_ms %>" data-timer-server-now="<%= @screen.server_now_ms %>"><%= @screen.timer_label %></span>
+    <% end %>
+  <% end %>
+</div>
+<div class="buttons">
+  <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
+  <% if @game.lobby? %>
+    <%= button_to "Start", start_moderate_quiz_game_path(@quiz, @game), method: :post, class: "btn btn--pink btn--lg", form: { data: { turbo: false } } %>
+  <% elsif @game.question? %>
+    <%= button_to "Finish", finish_moderate_quiz_game_path(@quiz, @game), method: :post, class: "btn btn--pink btn--lg", form: { data: { turbo: false, timer_finish: true } } %>
+  <% elsif @game.results? %>
+    <% if @game.last_question? %>
+      <%= button_to "End quiz", advance_moderate_quiz_game_path(@quiz, @game), method: :post, class: "btn btn--pink btn--lg", form: { data: { turbo: false } } %>
+    <% else %>
+      <%= button_to "Next", advance_moderate_quiz_game_path(@quiz, @game), method: :post, class: "btn btn--pink btn--lg", form: { data: { turbo: false } } %>
+    <% end %>
+  <% elsif @game.finished? %>
+    <%= button_to "Top #{@screen.winner_count}", top_moderate_quiz_game_path(@quiz, @game), method: :post, class: "btn btn--pink btn--lg", form: { data: { turbo: false } } %>
+    <%= button_to "Draw", draw_moderate_quiz_game_path(@quiz, @game), method: :post, class: "btn btn--lg", form: { data: { turbo: false } } %>
+    <%= button_to "Reset winners", reset_winners_moderate_quiz_game_path(@quiz, @game), method: :post, class: "btn btn--ghost btn--lg", form: { data: { turbo: false } } %>
+  <% end %>
+</div>
