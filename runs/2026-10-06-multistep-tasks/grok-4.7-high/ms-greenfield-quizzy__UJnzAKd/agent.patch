+class Quiz < ApplicationRecord
+  has_many :games, dependent: :destroy
+  has_many :questions, -> { order(:position, :id) }, dependent: :destroy
+
+  attribute :winner_count, :integer, default: 3
+  attribute :timer_minutes, :integer, default: 0
+  attribute :timer_seconds, :integer, default: 0
+
