diff --git a/config/routes.rb b/config/routes.rb
new file mode 100644
index 0000000..2260169
--- /dev/null
+++ b/config/routes.rb
@@ -0,0 +1,52 @@
+Rails.application.routes.draw do
+  get "up" => "rails/health#show", as: :rails_health_check
+
+  namespace :moderate do
+    root "quizzes#index"
+
+    get "import", to: "imports#new", as: :import
+    post "import", to: "imports#create"
+
+    resources :quizzes do
+      member do
+        get :export
+      end
+
+      resources :questions, except: [ :index, :show ] do
+        member do
+          patch :move_up
+          patch :move_down
+          patch :toggle_active
+        end
+      end
+
+      resource :preview, only: [ :show ], controller: "previews" do
+        post :answer
+        post :advance
+        post :score
+        post :reset
+      end
+
+      resources :games, only: [ :create, :show ] do
+        member do
+          post :start
+          post :finish
+          post :advance
+          post :top
+          post :draw
+          post :reset_winners
+          get :state
+        end
+      end
+    end
+  end
+
+  scope constraints: { code: /[A-Za-z0-9]+/ } do
+    get "play/:code", to: "plays#show", as: :play
+    post "play/:code/join", to: "plays#join", as: :join_play
+    post "play/:code/answer", to: "plays#answer", as: :answer_play
+    get "play/:code/state", to: "plays#state", as: :state_play
+  end
+
+  root to: redirect("/moderate")
+end
