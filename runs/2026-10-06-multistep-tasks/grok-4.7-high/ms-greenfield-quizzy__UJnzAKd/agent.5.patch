diff --git a/test/integration/timer_test.rb b/test/integration/timer_test.rb
new file mode 100644
index 0000000..1d08494
--- /dev/null
+++ b/test/integration/timer_test.rb
@@ -0,0 +1,214 @@
+require "test_helper"
+
+class TimerTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "s3cret"
+    @auth = {
+      "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "s3cret")
+    }
+    @quiz = Quiz.create!(title: "Timed Talk")
+    @q1 = add_question(@quiz, "One?", [ [ "Yes", true ], [ "No", false ] ])
+    @q2 = add_question(@quiz, "Two?", [ [ "Right", true ], [ "Wrong", false ] ])
+  end
+
+  test "settings include timer fields defaulting to zero" do
+    assert_equal 0, @quiz.timer_minutes
+    assert_equal 0, @quiz.timer_seconds
+
+    get edit_moderate_quiz_path(@quiz), headers: @auth
+    assert_response :success
+    assert_select "label", text: "Timer minutes"
+    assert_select "label", text: "Timer seconds"
+    assert_select "input[type=number][name='quiz[timer_minutes]'][value='0']"
+    assert_select "input[type=number][name='quiz[timer_seconds]'][value='0']"
+
+    patch moderate_quiz_path(@quiz), params: { quiz: { title: @quiz.title, winner_count: 3, timer_minutes: -1, timer_seconds: 0 } }, headers: @auth
+    assert_response :unprocessable_entity
+    assert_equal 0, @quiz.reload.timer_minutes
+    assert_select "label", text: "Timer minutes"
+
+    patch moderate_quiz_path(@quiz), params: { quiz: { title: @quiz.title, winner_count: 3, timer_minutes: "", timer_seconds: 5 } }, headers: @auth
+    assert_response :unprocessable_entity
+
+    patch moderate_quiz_path(@quiz), params: { quiz: { title: @quiz.title, winner_count: 3, timer_minutes: 1, timer_seconds: 30 } }, headers: @auth
+    assert_redirected_to moderate_quiz_path(@quiz)
+    @quiz.reload
+    assert_equal 1, @quiz.timer_minutes
+    assert_equal 30, @quiz.timer_seconds
+
+    get edit_moderate_quiz_path(@quiz), headers: @auth
+    assert_select "input[name='quiz[timer_minutes]'][value='1']"
+    assert_select "input[name='quiz[timer_seconds]'][value='30']"
+  end
+
+  test "new quizzes default the timer when the fields are omitted" do
+    get new_moderate_quiz_path, headers: @auth
+    assert_select "label", text: "Timer minutes"
+    assert_select "label", text: "Timer seconds"
+    assert_select "input[name='quiz[timer_minutes]'][value='0']"
+    assert_select "input[name='quiz[timer_seconds]'][value='0']"
+
+    post moderate_quizzes_path, params: { quiz: { title: "Defaults" } }, headers: @auth
+    quiz = Quiz.order(:id).last
+    assert_equal 0, quiz.timer_minutes
+    assert_equal 0, quiz.timer_seconds
+  end
+
+  test "timer is not part of the export format" do
+    @quiz.update!(timer_minutes: 2, timer_seconds: 5)
+    get export_moderate_quiz_path(@quiz), headers: @auth
+    data = JSON.parse(css_select("pre").first.text)
+    assert_equal [ "title", "questions" ], data.keys
+    assert_not_includes css_select("pre").first.text, "timer"
+
+    post moderate_import_path, params: { quiz_json: css_select("pre").first.text }, headers: @auth
+    imported = Quiz.order(:id).last
+    assert_equal 0, imported.timer_minutes
+    assert_equal 0, imported.timer_seconds
+  end
+
+  test "big screen shows a countdown that does not restart on reload" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    game = start_question!
+    assert_equal 90_000, game.question_timer_ms
+
+    get moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_response :success
+    assert_select ".stage-timer", text: "1:30"
+    assert_select "button", text: "Finish"
+    assert_select "form[data-timer-finish]"
+
+    game.update!(question_opened_ms: Game.clock_ms - 5_000)
+    get moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_select ".stage-timer", text: "1:25"
+    assert_select "button", text: "Finish"
+
+    player = open_session
+    player.post join_play_path(game.code), params: { name: "Ada" }
+    player.follow_redirect!
+    player.assert_select ".stage-timer", count: 0
+    player.assert_no_match(/\d+:\d{2}/, player.response.body)
+  end
+
+  test "a zero timer is not shown and does not finish the question" do
+    game = start_question!
+    assert_equal 0, game.question_timer_ms
+
+    game.update!(question_opened_ms: Game.clock_ms - 60_000)
+    get moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_select ".stage-timer", count: 0
+    assert_select "button", text: "Finish"
+    assert game.reload.question?
+  end
+
+  test "the question finishes itself at 0:00 and the moderator can finish earlier" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 5)
+    game = start_question!
+    assert_equal "0:05", Game.format_countdown(game.timer_remaining_ms)
+
+    post finish_moderate_quiz_game_path(@quiz, game), headers: @auth
+    follow_moderator!
+    assert_match "Correct", response.body
+    assert_select "button", text: "Finish", count: 0
+    assert_select "button", text: "Next"
+    assert game.reload.results?
+
+    post advance_moderate_quiz_game_path(@quiz, game), headers: @auth
+    game.reload
+    assert game.question?
+    assert_equal 5_000, game.question_timer_ms
+
+    game.update!(question_opened_ms: Game.clock_ms - 5_000)
+    get moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_response :success
+    assert_match "Correct", response.body
+    assert_select ".stage-timer", count: 0
+    assert_select "button", text: "Finish", count: 0
+    assert_select "button", text: "End quiz"
+    assert game.reload.results?
+
+    player = open_session
+    player.post join_play_path(game.code), params: { name: "Ada" }
+    player.follow_redirect!
+    player.assert_match "No answer", player.response.body
+    player.assert_no_match(/\d+:\d{2}/, player.response.body)
+  end
+
+  test "state poll finishes an expired question and phones do not get the timer" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 90)
+    game = start_question!
+    player = open_session
+    player.post join_play_path(game.code), params: { name: "Ada" }
+
+    get state_moderate_quiz_game_path(@quiz, game), headers: @auth.merge("Accept" => "application/json")
+    payload = JSON.parse(response.body)
+    assert_equal "question", payload["phase"]
+    assert_equal "1:30", payload.dig("timer", "label")
+    assert_includes payload["body_html"], "1:30"
+    assert_not_includes payload["body_html"], "Correct"
+
+    player.get state_play_path(game.code), headers: { "Accept" => "application/json" }
+    phone = JSON.parse(player.response.body)
+    assert_nil phone["timer"]
+    assert_no_match(/1:30|stage-timer/, phone["body_html"].to_s)
+
+    game.update!(question_opened_ms: Game.clock_ms - 90_000)
+    get state_moderate_quiz_game_path(@quiz, game), headers: @auth.merge("Accept" => "application/json")
+    finished = JSON.parse(response.body)
+    assert_equal "results", finished["phase"]
+    assert_nil finished["timer"]
+    assert_includes finished["body_html"], "Correct"
+    assert_includes finished["controls_html"], "Next"
+  end
+
+test "a waiting poll finishes the question when the countdown elapses" do
+  @quiz.update!(timer_minutes: 0, timer_seconds: 1)
+  game = start_question!
+  game.update!(question_opened_ms: Game.clock_ms - 650)
+
+  original = GamePulse.method(:default_timeout)
+  GamePulse.define_singleton_method(:default_timeout) { 5 }
+  begin
+    get state_moderate_quiz_game_path(@quiz, game),
+      headers: @auth.merge("Accept" => "application/json"),
+      params: { wait: "1", version: game.version, phase_key: "stale" }
+  ensure
+    GamePulse.define_singleton_method(:default_timeout, original)
+  end
+
+  assert_response :success
+  payload = JSON.parse(response.body)
+  assert_equal "results", payload["phase"]
+  assert_includes payload["body_html"], "Correct"
+  assert_includes payload["controls_html"], "Next"
+  assert game.reload.results?
+end
+
+test "seconds over 59 are added to the minutes" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 65)
+    game = start_question!
+    get moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_select ".stage-timer", text: "1:05"
+  end
+
+  private
+    def add_question(quiz, body, options)
+      question = quiz.questions.create!(body: body, position: quiz.questions.count + 1, active: true)
+      options.each_with_index do |(text, correct), index|
+        question.options.create!(body: text, position: index + 1, correct: correct)
+      end
+      question
+    end
+
+    def start_question!
+      post moderate_quiz_games_path(@quiz), headers: @auth
+      game = Game.order(:id).last
+      post start_moderate_quiz_game_path(@quiz, game), headers: @auth
+      game.reload
+    end
+
+    def follow_moderator!
+      follow_redirect!(headers: @auth)
+    end
+end
