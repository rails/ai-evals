--- /dev/null
+++ b/Gemfile.next
@@ -0,0 +1,11 @@
+# frozen_string_literal: true
+
+# Dual-boot Gemfile for the next release, which runs Rails 7.0 on its
+# framework defaults. Production for this release keeps using Gemfile
+# (Rails 6.1 on Ruby 3.2).
+#
+#   BUNDLE_GEMFILE=Gemfile.next bundle install
+#   BUNDLE_GEMFILE=Gemfile.next bundle exec rails test
+#
+# See docs/UPGRADE.md.
+eval_gemfile File.expand_path('Gemfile', __dir__)
