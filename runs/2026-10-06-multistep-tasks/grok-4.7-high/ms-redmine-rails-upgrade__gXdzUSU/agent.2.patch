+  def legacy_mail_verifier(digest)
+    options = {:serializer => Marshal}
+    if Rails.gem_version >= Gem::Version.new('7.1')
+      options[:force_legacy_metadata_serializer] = true
+    end
+    ActiveSupport::MessageVerifier.new(derive_key('mail_links', digest, 64), **options)
+  end
+
+  def rails72_mail_link?(token)
+    encoded = token.to_s.split('--', 2).first
+    payload = JSON.parse(Base64.strict_decode64(encoded))
+    rails = payload['_rails']
+    rails.is_a?(Hash) && rails.key?('data') && !rails.key?('message')
+  rescue ArgumentError, JSON::ParserError
+    false
+  end
