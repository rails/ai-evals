diff --git a/spec/support/fast_fabrication.rb b/spec/support/fast_fabrication.rb
new file mode 100644
index 0000000..d802d9b
--- /dev/null
+++ b/spec/support/fast_fabrication.rb
@@ -0,0 +1,22 @@
+# frozen_string_literal: true
+
+# Fabricators assign Paperclip files during initialization, and kt-paperclip
+# post-processes in `Attachment#assign` (Vips thumbnails, blurhash, transcodes).
+# Model and request examples skip it unless they opt in with `process: true`
+# or the `:process_media` tag. Other spec types still process.
+module FastFabrication
+  module_function
+
+  def prepare_attachments!(record, *names, transients)
+    return if process_attachments?(transients)
+
+    names.each do |name|
+      attachment = record.public_send(name)
+      attachment.post_processing = false if attachment
+    end
+  end
+
+  def process_attachments?(transients)
+    transients[:process] == true || Thread.current[:fabricate_process_attachments] == true
+  end
+end
diff --git a/spec/support/request_spec_job_filter.rb b/spec/support/request_spec_job_filter.rb
new file mode 100644
index 0000000..e75d3b0
--- /dev/null
+++ b/spec/support/request_spec_job_filter.rb
@@ -0,0 +1,34 @@
+# frozen_string_literal: true
+
+# Request examples that opt into Sidekiq inline still do not assert remote
+# delivery, link-card fetches, or webhook serialization. Those workers load and
+# serialize the full object graph on every local status. Skip them only while a
+# request example is running in inline mode; fake-mode enqueue assertions are
+# unchanged, and other spec types are unchanged.
+module RequestSpecInlineJobFilter
+  HEAVY_WORKERS = %w(
+    TriggerWebhookWorker
+    LinkCrawlWorker
+    ActivityPub::DistributionWorker
+    ActivityPub::DeliveryWorker
+    ActivityPub::RawDistributionWorker
+    ActivityPub::StatusUpdateDistributionWorker
+    ActivityPub::UpdateDistributionWorker
+    ActivityPub::QuoteRequestWorker
+    EmailDistributionWorker
+    PollExpirationNotifyWorker
+  ).freeze
+
+  private
+
+  def atomic_push(conn, payloads)
+    if Sidekiq::Testing.inline? && Thread.current[:request_spec_skip_heavy_jobs]
+      payloads = payloads.reject { |job| HEAVY_WORKERS.include?(job['class']) }
+      return true if payloads.empty?
+    end
+
+    super
+  end
+end
+
+Sidekiq::Client.prepend(RequestSpecInlineJobFilter)
