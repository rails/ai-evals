+    matching = []
+    3.times do |index|
+      travel_to Time.utc(2026, 8, 1, 12, 0, index) do
+        matching << open_request!(customer, "Invoice #{index}", "please refund")
+      end
+    end
+    travel_to Time.utc(2026, 8, 1, 13, 0, 0) do
+      open_request!(customer, "Unrelated", "hello")
