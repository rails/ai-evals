+    get "/api/v1/tickets", params: { page: { after: json.dig("meta", "after_cursor") } }, headers: owner[:headers]
+    # after_cursor is nil on the empty search page; request a real cursor without size.
+    get "/api/v1/tickets", params: { page: { size: 1 } }, headers: owner[:headers]
+    cursor = json.dig("meta", "after_cursor")
+    get "/api/v1/tickets", params: { page: { after: cursor } }, headers: owner[:headers]
