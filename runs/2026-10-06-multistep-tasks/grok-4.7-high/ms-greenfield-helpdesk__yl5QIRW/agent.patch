+module Api
+  module V1
+    class BaseController < ApplicationController
+      include CursorPagination
+
+      rescue_from CursorPagination::InvalidCursor do |exception|
+        render json: { error: exception.message }, status: :bad_request
+      end
+
+      before_action :require_account!
+
+      private
+        def require_account!
+          subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase
+          if subdomain.blank?
+            render json: { error: "X-Helpdesk-Account header is required" }, status: :bad_request
+            return
+          end
+
+          @current_account = Account.find_by(subdomain: subdomain)
+          return if @current_account
+
+          render json: { error: "Account not found" }, status: :not_found
+        end
+
+        def current_account
+          @current_account
+        end
+
+        def bearer_token
+          header = request.headers["Authorization"].to_s
+          return if header.blank?
+
+          scheme, token = header.split(" ", 2)
+          return token.presence if scheme&.casecmp("Bearer")&.zero?
+
+          nil
+        end
+
+        def current_session
+          return @current_session if defined?(@current_session)
+
+          token = bearer_token
+          @current_session = if token.present? && current_account
+            Session.joins(:user).find_by(token: token, users: { account_id: current_account.id })
+          end
+        end
+
+        def current_user
+          current_session&.user
+        end
+
+        def require_authentication!
+          unless current_user
+            render json: { error: "Authentication required" }, status: :unauthorized
+            return
+          end
+
+          if current_user.suspended?
+            render json: { error: "User is suspended" }, status: :forbidden
+            return
+          end
+
+          if current_account.cancelled? && !cancelled_account_action_allowed?
+            render json: { error: "Account is cancelled" }, status: :forbidden
+          end
+        end
+
+        def require_owner!
+          return if current_user&.owner?
+
+          render json: { error: "Only the account owner can perform this action" }, status: :forbidden
+        end
+
+        def require_admin!
+          require_authentication!
+          return if performed?
+          return if current_user.admin?
+
+          render json: { error: "Only admins can perform this action" }, status: :forbidden
+        end
+
+        def cancelled_account_action_allowed?
+          case "#{controller_path}##{action_name}"
+          when "api/v1/accounts#show", "api/v1/accounts#reactivate", "api/v1/accounts#cancel",
+               "api/v1/me#show", "api/v1/sessions#destroy"
+            true
+          else
+            false
+          end
+        end
+
+        def user_json(user)
+          {
+            id: user.id,
+            name: user.name,
+            email: user.email,
+            role: user.role,
+            verified: user.verified,
+            suspended: user.suspended?,
+            created_at: user.created_at,
+            updated_at: user.updated_at
+          }
+        end
+
+        def account_json(account)
+          {
+            id: account.id,
+            name: account.name,
+            subdomain: account.subdomain,
+            cancelled_at: account.cancelled_at,
+            created_at: account.created_at,
+            updated_at: account.updated_at
+          }
+        end
+
+        def portal_json(account)
+          {
+            name: account.name,
+            subdomain: account.subdomain
+          }
+        end
+
+        def render_validation_errors(record, status: :unprocessable_content)
+          render json: { errors: record.errors.to_hash }, status: status
+        end
+
+        def require_customer!
+          require_authentication!
+          return if performed?
+          return if current_user.customer?
+
+          render json: { error: "Only customers can perform this action" }, status: :forbidden
+        end
+
+        def require_staff!
+          require_authentication!
+          return if performed?
+          return if current_user.staff?
+
+          render json: { error: "Only staff can perform this action" }, status: :forbidden
+        end
+
+        def request_json(ticket)
+          {
+            id: ticket.id,
+            subject: ticket.subject,
+            status: ticket.status,
+            requester_id: ticket.requester_id,
+            merged_into_id: ticket.merged_into_id,
+            created_at: ticket.created_at,
+            updated_at: ticket.updated_at
+          }
+        end
+
+        def ticket_json(ticket)
+          request_json(ticket).merge(
+            priority: ticket.priority,
+            assignee_id: ticket.assignee_id,
+            assignee: assignee_json(ticket.assignee),
+            group_id: ticket.group_id,
+            group: group_summary_json(ticket.group),
+            origin: ticket.origin,
+            reply_address: ticket.reply_address,
+            requester: {
+              id: ticket.requester.id,
+              name: ticket.requester.name,
+              email: ticket.requester.email
+            }
+          )
+        end
+
+        def assignee_json(user)
+          return nil unless user
+
+          { id: user.id, name: user.name }
+        end
+
+        def group_summary_json(group)
+          return nil unless group
+
+          { id: group.id, name: group.name }
+        end
+
+        def group_json(group)
+          {
+            id: group.id,
+            name: group.name,
+            created_at: group.created_at,
+            updated_at: group.updated_at
+          }
+        end
+
+        def group_membership_json(membership)
+          {
+            id: membership.id,
+            group_id: membership.group_id,
+            user_id: membership.user_id,
+            default: membership.is_default,
+            created_at: membership.created_at,
+            updated_at: membership.updated_at
+          }
+        end
+
+        def invitation_json(invitation)
+          {
+            id: invitation.id,
+            email: invitation.email,
+            role: invitation.role,
+            status: invitation.effective_status,
+            expires_at: invitation.expires_at,
+            accepted_at: invitation.accepted_at,
+            revoked_at: invitation.revoked_at,
+            inviter_id: invitation.inviter_id,
+            created_at: invitation.created_at,
+            updated_at: invitation.updated_at
+          }
+        end
+
+        def invitation_preview_json(invitation)
+          {
+            email: invitation.email,
+            role: invitation.role,
+            business_name: invitation.account.name,
+            subdomain: invitation.account.subdomain,
+            expires_at: invitation.expires_at
+          }
+        end
+
+        def comment_json(comment)
+          {
+            id: comment.id,
+            body: comment.body,
+            author: {
+              id: comment.author_id,
+              name: comment.author.name
+            },
+            public: comment.publicly_visible?,
+            created_at: comment.created_at
+          }
+        end
+
+        # True when the client included a comment object, even if its body is blank.
+        def comment_provided?(attrs)
+          return false unless attrs.respond_to?(:key?) && attrs.key?(:comment)
+
+          value = attrs[:comment]
+          value.respond_to?(:key?) || value.present?
+        end
+
+        def public_flag(comment_param, customer:)
+          return true if customer
+          return true unless comment_param.respond_to?(:key?) && comment_param.key?(:public)
+
+          cast = ActiveModel::Type::Boolean.new.cast(comment_param[:public])
+          cast.nil? ? true : cast
+        end
+    end
+  end
+end
