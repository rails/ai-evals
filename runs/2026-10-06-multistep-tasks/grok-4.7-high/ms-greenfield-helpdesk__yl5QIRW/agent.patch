+require "test_helper"
+
+class InboundEmailTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @password = "my-customer-password"
+    @admin_password = "my-first-password"
+    @inbound_password = "inbound-secret"
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @inbound_password
+  end
+
+  test "relay ingress requires the inbound password and rfc822 content" do
+    raw = build_mail(from: "avery@example.test", to: "acme@support.example.test", subject: "Hi", body: "Hello", message_id: "auth@example.test")
+
+    post "/rails/action_mailbox/relay/inbound_emails",
+      params: raw,
+      headers: { "CONTENT_TYPE" => "message/rfc822" }
+    assert_response :unauthorized
+
+    post "/rails/action_mailbox/relay/inbound_emails",
+      params: raw,
+      headers: auth_headers.merge("CONTENT_TYPE" => "text/plain")
+    assert_response :unsupported_media_type
+  end
+
+  test "email to the business support address opens a ticket and creates an unverified customer" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+
+    assert_difference -> { Ticket.count }, 1 do
+      assert_difference -> { User.where(role: "customer").count }, 1 do
+        post_email(
+          from: "Avery Chen <Avery@Example.test>",
+          to: "Acme Support <ACME@support.example.test>",
+          subject: " Cannot download my receipt ",
+          body: " The download button does nothing. ",
+          message_id: "new-ticket@example.test"
+        )
+      end
+    end
+    assert_response :no_content
+
+    ticket = Ticket.order(:id).last
+    assert_equal "Cannot download my receipt", ticket.subject
+    assert_equal "open", ticket.status
+    assert_equal "email", ticket.origin
+    assert_equal "normal", ticket.priority
+    assert_equal "The download button does nothing.", ticket.comments.sole.body
+    assert_equal true, ticket.comments.sole.publicly_visible?
+    assert_equal "new-ticket@example.test", ticket.comments.sole.message_id
+
+    customer = ticket.requester
+    assert_equal "customer", customer.role
+    assert_equal "avery@example.test", customer.email
+    assert_equal "Avery Chen", customer.name
+    assert_equal false, customer.verified
+    assert_equal ticket.account_id, customer.account_id
+
+    verification = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], verification.to
+    assert_includes mail_body(verification), "/verify-email?account=acme&token="
+    assert_not_equal true, customer.reload.verified
+  end
+
+  test "cc addresses the business and existing customers are reused without verifying them" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+    register_customer!("acme", "Avery", "avery@example.test")
+    customer = User.find_by!(email: "avery@example.test")
+    assert_equal false, customer.verified
+
+    deliveries = ActionMailer::Base.deliveries.size
+    assert_no_difference -> { User.count } do
+      post_email(
+        from: "avery@example.test",
+        to: "friend@example.test",
+        cc: "acme@support.example.test",
+        subject: "Billing",
+        body: "Please check invoice 12.",
+        message_id: "cc-ticket@example.test"
+      )
+    end
+    assert_response :no_content
+    assert_equal deliveries, ActionMailer::Base.deliveries.size
+
+    ticket = Ticket.order(:id).last
+    assert_equal customer.id, ticket.requester_id
+    assert_equal "Billing", ticket.subject
+    assert_equal false, customer.reload.verified
+  end
+
+  test "mail addressed to multiple businesses is ignored" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+    create_account!("Beta", "beta", "sam@beta.test")
+    verify_latest!
+
+    assert_no_difference -> { Ticket.count } do
+      post_email(
+        from: "avery@example.test",
+        to: "acme@support.example.test",
+        cc: "beta@support.example.test",
+        subject: "Both",
+        body: "Which desk?",
+        message_id: "multi@example.test"
+      )
+    end
+    assert_response :no_content
+    assert_equal 0, User.where(email: "avery@example.test").count
+  end
+
+  test "staff public replies on email tickets are emailed and only the requester can continue the thread" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+    owner = sign_in!("acme", "jo@acme.test", @admin_password)
+
+    post_email(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Printer jam",
+      body: "The printer is jammed.",
+      message_id: "printer@example.test"
+    )
+    ticket = Ticket.order(:id).last
+    assert_equal "email", ticket.origin
+    reply_address = ticket.reply_address
+    assert_equal "acme+#{ticket.reply_token}@support.example.test", reply_address
+    assert_includes reply_address, "@#{HelpdeskSettings.support_domain}"
+
+    ActionMailer::Base.deliveries.clear
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { comment: { body: "Please restart it.", public: false }, status: "pending" } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :success
+    assert_equal "pending", ticket.reload.status
+    assert_empty ActionMailer::Base.deliveries
+
+    patch "/api/v1/tickets/#{ticket.id}",
+      params: { ticket: { comment: { body: "Try the side door." }, status: "solved" } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :success
+    assert_equal "solved", ticket.reload.status
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "avery@example.test" ], mail.to
+    assert_equal [ reply_address ], mail.reply_to
+    assert_includes mail.from.first, reply_address
+    assert_includes mail.subject, "Printer jam"
+    assert_includes mail_body(mail), "Try the side door."
+    assert_includes mail_body(mail), reply_address
+    assert_equal "auto-generated", mail["Auto-Submitted"].value
+
+    assert_no_difference -> { ticket.comments.count } do
+      post_email(
+        from: "blair@example.test",
+        to: reply_address,
+        subject: "Re: Printer jam",
+        body: "I am not the requester.",
+        message_id: "stranger@example.test"
+      )
+    end
+    assert_equal "solved", ticket.reload.status
+
+    post_email(
+      from: "Avery <avery@example.test>",
+      to: "Someone <#{reply_address}>",
+      cc: "acme@support.example.test",
+      subject: "Re: Printer jam",
+      body: "That worked.",
+      message_id: "requester-reply@example.test"
+    )
+    assert_response :no_content
+    ticket.reload
+    assert_equal "open", ticket.status
+    assert_equal [ "The printer is jammed.", "Please restart it.", "Try the side door.", "That worked." ],
+      ticket.comments.order(:id).pluck(:body)
+    assert_equal "requester-reply@example.test", ticket.comments.order(:id).last.message_id
+  end
+
+  test "a new message to the plain support address opens a new ticket" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+    post_email(
+      from: "avery@example.test",
+      to: "acme@support.example.test",
+      subject: "First",
+      body: "One",
+      message_id: "first@example.test"
+    )
+    first = Ticket.order(:id).last
+
+    post_email(
+      from: "avery@example.test",
+      to: "acme@support.example.test",
+      subject: "Re: First",
+      body: "Two",
+      message_id: "second@example.test",
+      in_reply_to: "<first@example.test>"
+    )
+    second = Ticket.order(:id).last
+    assert_not_equal first.id, second.id
+    assert_equal "Two", second.comments.sole.body
+    assert_equal 1, first.comments.count
+  end
+
+  test "duplicate message ids are ignored and invalid deliveries can be retried" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+    create_account!("Beta", "beta", "sam@beta.test")
+    verify_latest!
+
+    raw = build_mail(
+      from: "avery@example.test",
+      to: "acme@support.example.test",
+      cc: "beta@support.example.test",
+      subject: "Ambiguous",
+      body: "Ignore me first.",
+      message_id: "retry@example.test"
+    )
+    assert_no_difference -> { Ticket.count } do
+      post_raw(raw)
+      post_raw(raw)
+    end
+    assert_equal 0, Comment.where(message_id: "retry@example.test").count
+
+    valid = build_mail(
+      from: "avery@example.test",
+      to: "acme@support.example.test",
+      subject: "Ambiguous",
+      body: "Only Acme now.",
+      message_id: "retry@example.test"
+    )
+    assert_difference -> { Ticket.count }, 1 do
+      post_raw(valid)
+    end
+    ticket = Ticket.order(:id).last
+    assert_equal "Only Acme now.", ticket.comments.sole.body
+
+    assert_no_difference -> { Ticket.count } do
+      post_raw(valid)
+      post_email(
+        from: "avery@example.test",
+        to: "acme@support.example.test",
+        subject: "Ambiguous",
+        body: "Only Acme now. Extra header.",
+        message_id: "retry@example.test"
+      )
+    end
+    assert_equal 1, ticket.comments.count
+  end
+
+  test "automated and list mail is ignored" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+
+    assert_no_difference -> { Ticket.count } do
+      post_email(
+        from: "bot@example.test",
+        to: "acme@support.example.test",
+        subject: "Out of office",
