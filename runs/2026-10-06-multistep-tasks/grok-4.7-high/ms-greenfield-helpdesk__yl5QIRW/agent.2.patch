@@ -0,0 +1,24 @@
+module Api
+  module V1
+    class CommentsController < BaseController
+      def index
+        if params[:ticket_id].present?
+          require_staff!
+          return if performed?
+
+          ticket = current_account.tickets.find(params[:ticket_id])
+          scope = ticket.comments
+        else
+          require_customer!
+          return if performed?
+
+          ticket = current_account.tickets.find_by!(id: params[:request_id], requester_id: current_user.id)
+          scope = ticket.comments.publicly_visible
+        end
+
+        scope = scope.includes(:author).oldest_first
+        render json: paginated_collection(scope, "comments", method(:comment_json))
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/registrations_controller.rb b/app/controllers/api/v1/registrations_controller.rb
