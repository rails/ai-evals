+      assert expected.size >= 2, path
+      assert_equal expected, walk_forward(path, { page: { size: 1 } }, key, headers), path
+
+      get path, params: { page: { size: 1 } }, headers: headers
+      assert_equal expected.first, json[key].first["id"]
+      assert_equal true, json.dig("meta", "has_more")
