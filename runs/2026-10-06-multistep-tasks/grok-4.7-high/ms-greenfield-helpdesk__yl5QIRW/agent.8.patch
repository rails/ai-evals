+    assert_equal membership_ids, filtered
+
+    get "/api/v1/invitations", params: { page: { size: 10 }, status: "pending" }, headers: owner[:headers]
+    assert_equal invite_only.sort, json["invitations"].map { |item| item["id"] }.sort
