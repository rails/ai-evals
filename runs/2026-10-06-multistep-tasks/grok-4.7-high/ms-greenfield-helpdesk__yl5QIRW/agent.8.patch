+      [ "/api/v1/staff", "staff", owner[:headers] ],
+      [ "/api/v1/invitations", "invitations", owner[:headers] ],
+      [ "/api/v1/groups", "groups", agent[:headers] ],
+      [ "/api/v1/group_memberships", "group_memberships", agent[:headers] ]
+    ]
+    collections.each do |path, key, headers|
+      get path, params: { page: 1, per_page: 100 }, headers: headers
+      assert_response :success, path
