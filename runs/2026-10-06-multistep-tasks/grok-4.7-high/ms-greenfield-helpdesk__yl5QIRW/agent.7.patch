+require "test_helper"
+
+class TicketMergeTest < ActionDispatch::IntegrationTest
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @password = "my-customer-password"
+    @admin_password = "my-first-password"
+    @team_password = "my-team-password"
+    @inbound_password = "inbound-secret"
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @inbound_password
+  end
+
+  test "staff merge a duplicate into the same customer's ticket" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+    owner = sign_in!("acme", "jo@acme.test", @admin_password)
+    agent = invite_and_accept!(owner, "sam@example.test", "agent", "Sam")
+    customer = register_and_sign_in!("acme", "Avery", "avery@example.test")
+    other = register_and_sign_in!("acme", "Blair", "blair@example.test")
+
+    source_id = open_request!(customer, "Cannot download my receipt", "The download button does nothing.")
+    target_id = open_request!(customer, "Receipt missing from email", "Please resend the receipt.")
+    other_id = open_request!(other, "Widget exploded", "The widget exploded.")
+    untouched_id = open_request!(customer, "Unrelated", "Leave this one alone.")
+
+    patch "/api/v1/tickets/#{source_id}",
+      params: { ticket: { priority: "high", comment: { body: "Internal context", public: false } } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :success
+    patch "/api/v1/tickets/#{target_id}",
+      params: { ticket: { status: "pending", priority: "high", assignee_id: agent[:id] } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :success
+
+    source = Ticket.find(source_id)
+    target = Ticket.find(target_id)
+    source_reply = source.reply_token
+    target_reply = target.reply_token
+    target_updated_at = target.updated_at
+    source_comment_ids = source.comments.order(:id).pluck(:id)
+    target_comment_ids = target.comments.order(:id).pluck(:id)
+
+    get "/api/v1/tickets/#{source_id}", headers: owner[:headers]
+    assert_response :success
+    assert json["ticket"].key?("merged_into_id")
+    assert_nil json.dig("ticket", "merged_into_id")
+    get "/api/v1/requests/#{target_id}", headers: customer[:headers]
+    assert json["request"].key?("merged_into_id")
+    assert_nil json.dig("request", "merged_into_id")
+    assert_not json["request"].key?("priority")
+    assert_not json["request"].key?("assignee_id")
+    assert_not json["request"].key?("origin")
+
+    post "/api/v1/tickets/#{source_id}/merge", headers: customer[:headers], as: :json
+    assert_response :forbidden
+
+    post "/api/v1/tickets/#{source_id}/merge",
+      params: { merge: { target_id: other_id } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal [ "must belong to the same customer" ], json.dig("errors", "target_id")
+    assert_equal "open", Ticket.find(source_id).status
+    assert_nil Ticket.find(source_id).merged_into_id
+
+    post "/api/v1/tickets/#{source_id}/merge",
+      params: { merge: { target_id: source_id } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal [ "must be a different ticket" ], json.dig("errors", "target_id")
+
+    post "/api/v1/tickets/#{source_id}/merge",
+      params: { merge: {} },
+      headers: owner[:headers],
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal [ "can't be blank" ], json.dig("errors", "target_id")
+
+    post "/api/v1/tickets/#{source_id}/merge",
+      params: { merge: { target_id: "not-a-ticket" } },
+      headers: agent[:headers],
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal [ "must be a ticket" ], json.dig("errors", "target_id")
+
+    post "/api/v1/tickets/#{source_id}/merge", headers: owner[:headers], as: :json
+    assert_response :bad_request
+
+    deliveries = ActionMailer::Base.deliveries.size
+    travel_to target_updated_at + 2.hours do
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        post "/api/v1/tickets/#{source_id}/merge",
+          params: { merge: { target_id: " #{target_id} " } },
+          headers: agent[:headers],
+          as: :json
+      end
+      assert_response :success
+    end
+    assert_equal deliveries, ActionMailer::Base.deliveries.size
+
+    assert_equal "closed", json.dig("source", "status")
+    assert_equal target_id, json.dig("source", "merged_into_id")
+    assert_equal source_id, json.dig("source", "id")
+    assert_equal "high", json.dig("source", "priority")
+    assert_nil json.dig("source", "assignee_id")
+    assert_equal "pending", json.dig("target", "status")
+    assert_equal agent[:id], json.dig("target", "assignee_id")
+    assert_equal "high", json.dig("target", "priority")
+    assert_nil json.dig("target", "merged_into_id")
+    assert json["target"].key?("merged_into_id")
+    assert_equal target_reply, Ticket.find(target_id).reply_token
+    assert_equal source_reply, Ticket.find(source_id).reply_token
+    assert_equal "portal", Ticket.find(target_id).origin
+    assert_equal "portal", Ticket.find(source_id).origin
+
+    source.reload
+    target.reload
+    assert_equal target_comment_ids, target.comments.order(:id).pluck(:id).first(target_comment_ids.size)
+    assert_equal source_comment_ids, source.comments.order(:id).pluck(:id).first(source_comment_ids.size)
+    assert_equal target_comment_ids.size + 1, target.comments.count
+    assert_equal source_comment_ids.size + 1, source.comments.count
+    assert_equal "This ticket was closed and merged into ticket #{target_id}.", source.comments.order(:id).last.body
+    assert_equal false, source.comments.order(:id).last.publicly_visible?
+    assert_equal agent[:id], source.comments.order(:id).last.author_id
+    assert_equal "Ticket #{source_id} was closed and merged into this ticket.", target.comments.order(:id).last.body
+    assert_equal false, target.comments.order(:id).last.publicly_visible?
+    assert_equal target_updated_at.to_i, target.updated_at.to_i
+    assert_operator source.updated_at, :>, target_updated_at
+
+    get "/api/v1/tickets/#{source_id}", headers: owner[:headers]
+    assert_response :success
+    assert_equal "closed", json.dig("ticket", "status")
+    assert_equal target_id, json.dig("ticket", "merged_into_id")
+    get "/api/v1/requests/#{source_id}", headers: customer[:headers]
+    assert_response :success
+    assert_equal "closed", json.dig("request", "status")
+    assert_equal target_id, json.dig("request", "merged_into_id")
+    assert_not json["request"].key?("priority")
+
+    get "/api/v1/tickets/#{source_id}/comments", headers: owner[:headers]
+    assert_equal [ "The download button does nothing.", "Internal context", "This ticket was closed and merged into ticket #{target_id}." ],
+      json["comments"].map { |item| item["body"] }
+    assert_equal false, json["comments"].last["public"]
+    get "/api/v1/requests/#{source_id}/comments", headers: customer[:headers]
+    assert_equal [ "The download button does nothing." ], json["comments"].map { |item| item["body"] }
+
+    get "/api/v1/tickets", params: { status: "closed" }, headers: owner[:headers]
+    assert_equal [ source_id ], json["tickets"].map { |item| item["id"] }
+    assert_equal target_id, json.dig("tickets", 0, "merged_into_id")
+    get "/api/v1/tickets", params: { status: " CLOSED " }, headers: agent[:headers]
+    assert_equal [ source_id ], json["tickets"].map { |item| item["id"] }
+    get "/api/v1/requests", params: { status: "closed" }, headers: customer[:headers]
+    assert_equal [ source_id ], json["requests"].map { |item| item["id"] }
+    assert_equal target_id, json.dig("requests", 0, "merged_into_id")
+    get "/api/v1/requests", params: { status: "closed" }, headers: other[:headers]
+    assert_equal [], json["requests"]
+    get "/api/v1/tickets", params: { status: "pending", requester_id: customer[:id] }, headers: owner[:headers]
+    assert_equal [ target_id ], json["tickets"].map { |item| item["id"] }
+    get "/api/v1/requests", params: { status: "open" }, headers: customer[:headers]
+    assert_equal [ untouched_id ], json["requests"].map { |item| item["id"] }
+
+    patch "/api/v1/tickets/#{source_id}",
+      params: { ticket: { status: "open", priority: "normal", comment: { body: "Still here", public: true }, assignee_id: agent[:id] } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal [ "is closed" ], json.dig("errors", "base")
+    source.reload
+    assert_equal "closed", source.status
+    assert_equal "high", source.priority
+    assert_nil source.assignee_id
+    assert_not_includes source.comments.pluck(:body), "Still here"
+
+    patch "/api/v1/requests/#{source_id}",
+      params: { request: { comment: { body: "Any update?" }, status: "solved" } },
+      headers: customer[:headers],
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal "closed", source.reload.status
+    assert_not_includes source.comments.pluck(:body), "Any update?"
+
+    post "/api/v1/tickets/#{source_id}/merge",
+      params: { merge: { target_id: untouched_id } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal [ "is closed" ], json.dig("errors", "base")
+    assert_equal target_id, source.reload.merged_into_id
+
+    post "/api/v1/tickets/#{untouched_id}/merge",
+      params: { merge: { target_id: source_id } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :unprocessable_content
+    assert_equal [ "is closed" ], json.dig("errors", "target_id")
+    assert_nil Ticket.find(untouched_id).merged_into_id
+    assert_equal "open", Ticket.find(untouched_id).status
+  end
+
+  test "custom merge notes can be public and do not email or rewrite a later merge" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+    owner = sign_in!("acme", "jo@acme.test", @admin_password)
+    customer = register_and_sign_in!("acme", "Avery", "avery@example.test")
+
+    post_email(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "Printer jam",
+      body: "The printer is jammed.",
+      message_id: "printer-source@example.test"
+    )
+    source = Ticket.order(:id).last
+    source_reply = source.reply_address
+    source_token = source.reply_token
+
+    post_email(
+      from: "avery@example.test",
+      to: "acme@support.example.test",
+      subject: "Printer still jammed",
+      body: "It is still jammed.",
+      message_id: "printer-target@example.test"
+    )
+    target = Ticket.order(:id).last
+    target_reply = target.reply_address
+    target_token = target.reply_token
+    target_status = target.status
+    assert_equal "email", source.origin
+    assert_equal "email", target.origin
+
+    final_id = open_request!(customer, "Follow up", "Continuing separately.")
+    final = Ticket.find(final_id)
+    final_token = final.reply_token
+    final_assignee = final.assignee_id
+
+    ActionMailer::Base.deliveries.clear
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      post "/api/v1/tickets/#{source.id}/merge",
+        params: {
+          merge: {
+            target_id: target.id,
+            source_comment: { body: " Continuing in ticket #{target.id}. ", public: true },
+            target_comment: { body: "Duplicate checked.", public: false }
+          }
+        },
+        headers: owner[:headers],
+        as: :json
+    end
+    assert_response :success
+    assert_equal "closed", json.dig("source", "status")
+    assert_equal target.id, json.dig("source", "merged_into_id")
+    assert_equal target_status, json.dig("target", "status")
+    assert_equal target_reply, json.dig("target", "reply_address")
+    assert_equal "email", json.dig("target", "origin")
+    assert_equal source_reply, json.dig("source", "reply_address")
+
+    source.reload
+    target.reload
+    assert_equal source_token, source.reply_token
+    assert_equal target_token, target.reply_token
+    assert_equal "Continuing in ticket #{target.id}.", source.comments.order(:id).last.body
+    assert_equal true, source.comments.order(:id).last.publicly_visible?
+    assert_equal "Duplicate checked.", target.comments.order(:id).last.body
+    assert_equal false, target.comments.order(:id).last.publicly_visible?
+    assert_equal [ "The printer is jammed.", "Continuing in ticket #{target.id}." ], source.comments.order(:id).pluck(:body)
+    assert_equal [ "It is still jammed.", "Duplicate checked." ], target.comments.order(:id).pluck(:body)
+
+    get "/api/v1/requests/#{source.id}/comments", headers: customer[:headers]
+    assert_equal [ "The printer is jammed.", "Continuing in ticket #{target.id}." ], json["comments"].map { |item| item["body"] }
+    get "/api/v1/requests/#{target.id}/comments", headers: customer[:headers]
+    assert_equal [ "It is still jammed." ], json["comments"].map { |item| item["body"] }
+
+    assert_no_difference -> { source.comments.count } do
+      assert_no_difference -> { Ticket.count } do
+        post_email(
+          from: "Avery <avery@example.test>",
+          to: source_reply,
+          cc: "acme@support.example.test",
+          subject: "Re: Printer jam",
+          body: "Any news on the closed ticket?",
+          message_id: "closed-reply@example.test"
+        )
+      end
+    end
+    assert_equal "closed", source.reload.status
+    assert_equal target.id, source.merged_into_id
+    assert_nil Comment.find_by(message_id: "closed-reply@example.test")
+
+    post_email(
+      from: "avery@example.test",
+      to: target_reply,
+      subject: "Re: Printer still jammed",
+      body: "The survivor still accepts mail.",
+      message_id: "survivor-reply@example.test"
+    )
+    target.reload
+    assert_equal "open", target.status
+    assert_includes target.comments.pluck(:body), "The survivor still accepts mail."
+    assert_equal target_token, target.reply_token
+
+    # Later merge keeps the original link instead of rewriting history.
+    post "/api/v1/tickets/#{target.id}/merge",
+      params: {
+        merge: {
+          target_id: final_id,
+          source_comment: { body: "Now continuing in #{final_id}.", public: "true" },
+          target_comment: { public: false }
+        }
+      },
+      headers: owner[:headers],
+      as: :json
+    assert_response :success
+    assert_equal "closed", json.dig("source", "status")
+    assert_equal final_id, json.dig("source", "merged_into_id")
+    assert_nil json.dig("target", "merged_into_id")
+    assert_equal final_token, Ticket.find(final_id).reply_token
+    assert_nil Ticket.find(final_id).assignee_id
+    assert_nil final_assignee
+    assert_equal "open", Ticket.find(final_id).status
+
+    source.reload
+    target.reload
+    assert_equal target.id, source.merged_into_id
+    assert_equal final_id, target.merged_into_id
+    assert_equal "closed", source.status
+    assert_equal "Now continuing in #{final_id}.", target.comments.order(:id).last.body
+    assert_equal true, target.comments.order(:id).last.publicly_visible?
+    assert_equal "Ticket #{target.id} was closed and merged into this ticket.", Ticket.find(final_id).comments.order(:id).last.body
+    assert_equal false, Ticket.find(final_id).comments.order(:id).last.publicly_visible?
+    assert_equal "Continuing in ticket #{target.id}.", source.comments.order(:id).last.body
+
+    get "/api/v1/tickets", params: { status: "closed", q: "Continuing in ticket" }, headers: owner[:headers]
+    assert_equal [ source.id ], json["tickets"].map { |item| item["id"] }
+    get "/api/v1/tickets", params: { q: "Duplicate checked" }, headers: owner[:headers]
+    assert_equal [], json["tickets"]
+  end
+
+  test "assignment cleanup still applies to closed tickets and accounts can be removed" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+    owner = sign_in!("acme", "jo@acme.test", @admin_password)
+    agent = invite_and_accept!(owner, "sam@example.test", "agent", "Sam")
+    customer = register_and_sign_in!("acme", "Avery", "avery@example.test")
+
+    billing = create_group!(owner, "Billing")
+    technical = create_group!(owner, "Technical")
+    add_member!(owner, billing, agent[:id], default: true)
+    add_member!(owner, technical, agent[:id], default: false)
+
+    closed_id = open_request!(customer, "Duplicate billing", "First")
+    survivor_id = open_request!(customer, "Billing original", "Second")
+    grouped_id = open_request!(customer, "Outage duplicate", "Third")
+    grouped_survivor_id = open_request!(customer, "Outage original", "Fourth")
+
+    patch "/api/v1/tickets/#{closed_id}",
+      params: { ticket: { group_id: billing, assignee_id: agent[:id] } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :success
+    patch "/api/v1/tickets/#{grouped_id}",
+      params: { ticket: { group_id: technical, assignee_id: agent[:id] } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :success
+
+    post "/api/v1/tickets/#{closed_id}/merge",
+      params: { merge: { target_id: survivor_id } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :success
+    assert_equal agent[:id], json.dig("source", "assignee_id")
+    assert_equal billing, json.dig("source", "group_id")
+    assert_nil json.dig("target", "assignee_id")
+
+    post "/api/v1/tickets/#{grouped_id}/merge",
+      params: { merge: { target_id: grouped_survivor_id } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :success
+
+    billing_membership = GroupMembership.find_by!(group_id: billing, user_id: agent[:id])
+    delete "/api/v1/group_memberships/#{billing_membership.id}", headers: owner[:headers]
+    assert_response :no_content
+    get "/api/v1/tickets/#{closed_id}", headers: owner[:headers]
+    assert_nil json.dig("ticket", "assignee_id")
+    assert_equal billing, json.dig("ticket", "group_id")
+    assert_equal "closed", json.dig("ticket", "status")
+    assert_equal survivor_id, json.dig("ticket", "merged_into_id")
+
+    delete "/api/v1/groups/#{technical}", headers: owner[:headers]
+    assert_response :no_content
+    grouped = Ticket.find(grouped_id)
+    assert_nil grouped.group_id
+    assert_nil grouped.assignee_id
+    assert_equal "closed", grouped.status
+    assert_equal grouped_survivor_id, grouped.merged_into_id
+
+    add_member!(owner, billing, agent[:id], default: true)
+    patch "/api/v1/tickets/#{closed_id}",
+      params: { ticket: { assignee_id: agent[:id] } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :unprocessable_content
+    Ticket.find(closed_id).update_columns(assignee_id: agent[:id])
+
+    patch "/api/v1/users/#{agent[:id]}",
+      params: { user: { suspended: true } },
+      headers: owner[:headers],
+      as: :json
+    assert_response :success
+    assert_nil Ticket.find(closed_id).assignee_id
+    assert_equal billing, Ticket.find(closed_id).group_id
+    assert_equal "closed", Ticket.find(closed_id).status
+
+    create_account!("Beta", "beta", "sam@beta.test")
+    verify_latest!
+    beta = sign_in!("beta", "sam@beta.test", @admin_password)
+    post "/api/v1/tickets/#{closed_id}/merge",
+      params: { merge: { target_id: survivor_id } },
+      headers: beta[:headers],
+      as: :json
+    assert_response :not_found
+
+    account = Account.find_by!(subdomain: "acme")
+    ticket_ids = account.tickets.pluck(:id)
+    account.destroy!
+    assert_equal 0, Ticket.where(id: ticket_ids).count
+  end
+
+  private
+    def json
+      JSON.parse(response.body)
+    end
+
+    def account_headers(subdomain, token = nil)
+      headers = { "X-Helpdesk-Account" => subdomain }
+      headers["Authorization"] = "Bearer #{token}" if token
+      headers
+    end
+
+    def mail_body(mail)
+      if mail.multipart?
+        [ mail.text_part&.body&.decoded, mail.html_part&.body&.decoded, mail.body.encoded ].compact.join("\n")
+      else
+        mail.body.decoded
+      end
+    end
+
+    def token_from(mail)
+      mail_body(mail)[/token=([^&\s"']+)/, 1]
+    end
+
+    def create_account!(name, subdomain, email)
+      post "/api/v1/account/create",
+        params: {
+          account: {
+            name: name,
+            subdomain: subdomain,
+            admin: { name: "Jo", email: email, password: @admin_password }
+          }
+        },
+        as: :json
+      assert_response :created
+    end
+
+    def verify_latest!
+      token = token_from(ActionMailer::Base.deliveries.last)
+      account = Account.order(:id).last
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: token } },
+        headers: account_headers(account.subdomain),
+        as: :json
+      assert_response :success
+    end
+
+    def sign_in!(subdomain, email, password)
+      post "/api/v1/sessions",
+        params: { session: { email: email, password: password } },
+        headers: account_headers(subdomain),
+        as: :json
+      assert_response :created
+      token = json.dig("session", "token")
+      { id: json.dig("user", "id"), token: token, headers: account_headers(subdomain, token) }
+    end
+
+    def register_and_sign_in!(subdomain, name, email)
+      post "/api/v1/registrations",
+        params: { user: { name: name, email: email, password: @password } },
+        headers: account_headers(subdomain),
+        as: :json
+      assert_response :created
+      token = token_from(ActionMailer::Base.deliveries.last)
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: token } },
+        headers: account_headers(subdomain),
+        as: :json
+      assert_response :success
+      sign_in!(subdomain, email, @password)
+    end
+
+    def invite_and_accept!(admin, email, role, name)
+      post "/api/v1/invitations",
+        params: { invitation: { email: email, role: role } },
+        headers: admin[:headers],
+        as: :json
+      assert_response :created
+      token = token_from(ActionMailer::Base.deliveries.last)
+      post "/api/v1/invitation_acceptances",
+        params: { invitation_acceptance: { token: token, name: name, password: @team_password } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :created
+      sign_in!("acme", email, @team_password)
+    end
+
+    def open_request!(customer, subject, body)
+      post "/api/v1/requests",
+        params: { request: { subject: subject, comment: { body: body } } },
+        headers: customer[:headers],
+        as: :json
+      assert_response :created
+      json.dig("request", "id")
+    end
+
+    def create_group!(admin, name)
+      post "/api/v1/groups",
+        params: { group: { name: name } },
+        headers: admin[:headers],
+        as: :json
+      assert_response :created
+      json.dig("group", "id")
+    end
+
+    def add_member!(admin, group_id, user_id, default:)
+      post "/api/v1/group_memberships",
+        params: { group_membership: { group_id: group_id, user_id: user_id, default: default } },
+        headers: admin[:headers],
+        as: :json
+      assert_response :created
+      json.dig("group_membership", "id")
+    end
+
+    def auth_headers
+      {
+        "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("actionmailbox", @inbound_password)
+      }
+    end
+
+    def post_email(from:, to:, subject:, body:, message_id:, cc: nil, in_reply_to: nil, headers: {})
+      post_raw(build_mail(from: from, to: to, cc: cc, subject: subject, body: body, message_id: message_id, in_reply_to: in_reply_to, headers: headers))
+    end
+
+    def post_raw(raw)
+      post "/rails/action_mailbox/relay/inbound_emails",
+        params: raw,
+        headers: auth_headers.merge("CONTENT_TYPE" => "message/rfc822")
+    end
+
+    def build_mail(from:, to:, subject:, body:, message_id:, cc: nil, in_reply_to: nil, headers: {})
+      mail = Mail.new
+      mail.from = from
+      mail.to = to
+      mail.cc = cc if cc
+      mail.subject = subject
+      mail.body = body
+      mail.message_id = message_id
+      mail.in_reply_to = in_reply_to if in_reply_to
+      headers.each { |key, value| mail[key] = value }
+      mail.to_s
+    end
+end
