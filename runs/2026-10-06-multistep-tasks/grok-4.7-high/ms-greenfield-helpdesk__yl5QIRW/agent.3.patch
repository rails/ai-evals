+class InvitationMailer < ApplicationMailer
+  def invite(invitation, token)
+    @invitation = invitation
+    @url = HelpdeskSettings.frontend_link(
+      "/accept-invitation",
+      account: invitation.account.subdomain,
+      token: token
+    )
+    mail(
+      to: invitation.email,
+      subject: "You're invited to join #{invitation.account.name}",
+      from: HelpdeskSettings.mail_from
+    ) do |format|
+      format.text
+    end
+  end
+end
