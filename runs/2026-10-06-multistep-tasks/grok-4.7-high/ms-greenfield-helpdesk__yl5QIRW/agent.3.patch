diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..16884d3
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,33 @@
+module Api
+  module V1
+    class InvitationAcceptancesController < BaseController
+      def create
+        if current_account.cancelled?
+          render json: { error: "Account is cancelled" }, status: :forbidden
+          return
+        end
+
+        token = acceptance_params[:token].to_s
+        invitation = Invitation.find_by_raw_token(current_account, token)
+        if invitation.nil?
+          render json: { error: "Invalid or expired token" }, status: :unprocessable_content
+          return
+        end
+
+        result = invitation.accept!(name: acceptance_params[:name], password: acceptance_params[:password])
+        if result == :invalid
+          render json: { error: "Invalid or expired token" }, status: :unprocessable_content
+        elsif result.errors.any?
+          render_validation_errors(result)
+        else
+          render json: { user: user_json(result), account: account_json(current_account) }, status: :created
+        end
+      end
+
+      private
+        def acceptance_params
+          params.require(:invitation_acceptance).permit(:token, :name, :password)
+        end
+    end
+  end
+end
