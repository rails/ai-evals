diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..434f815
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,60 @@
+module Api
+  module V1
+    class AccountsController < BaseController
+      skip_before_action :require_account!, only: :create
+      before_action :require_authentication!, only: [ :show, :cancel, :reactivate ]
+      before_action :require_owner!, only: [ :cancel, :reactivate ]
+
+      def create
+        admin = account_create_params[:admin]
+        admin = admin.to_h.symbolize_keys if admin.respond_to?(:to_h)
+        result = Account.register(
+          name: account_create_params[:name],
+          subdomain: account_create_params[:subdomain],
+          admin: admin || {}
+        )
+
+        if result.success?
+          render json: {
+            account: account_json(result.account),
+            user: user_json(result.user)
+          }, status: :created
+        else
+          errors = result.account.errors.to_hash
+          admin_errors = result.user.errors.to_hash
+          errors[:admin] = admin_errors if admin_errors.present?
+          render json: { errors: errors }, status: :unprocessable_content
+        end
+      end
+
+      def show
+        render json: { account: account_json(current_account) }
+      end
+
+      def cancel
+        current_account.cancel!
+        render json: { account: account_json(current_account.reload) }
+      end
+
+      def reactivate
+        unless current_account.cancelled?
+          render json: { error: "Account is not cancelled" }, status: :unprocessable_content
+          return
+        end
+
+        if current_account.cancellation_expired?
+          render json: { error: "Account can no longer be reactivated" }, status: :unprocessable_content
+          return
+        end
+
+        current_account.reactivate!
+        render json: { account: account_json(current_account) }
+      end
+
+      private
+        def account_create_params
+          params.require(:account).permit(:name, :subdomain, admin: [ :name, :email, :password ])
+        end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..410aa21
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,109 @@
+module Api
+  module V1
+    class BaseController < ApplicationController
+      before_action :require_account!
+
+      private
+        def require_account!
+          subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase
+          if subdomain.blank?
+            render json: { error: "X-Helpdesk-Account header is required" }, status: :bad_request
+            return
+          end
+
+          @current_account = Account.find_by(subdomain: subdomain)
+          return if @current_account
+
+          render json: { error: "Account not found" }, status: :not_found
+        end
+
+        def current_account
+          @current_account
+        end
+
+        def bearer_token
+          header = request.headers["Authorization"].to_s
+          return if header.blank?
+
+          scheme, token = header.split(" ", 2)
+          return token.presence if scheme&.casecmp("Bearer")&.zero?
+
+          nil
+        end
+
+        def current_session
+          return @current_session if defined?(@current_session)
+
+          token = bearer_token
+          @current_session = if token.present? && current_account
+            Session.joins(:user).find_by(token: token, users: { account_id: current_account.id })
+          end
+        end
+
+        def current_user
+          current_session&.user
+        end
+
+        def require_authentication!
+          unless current_user
+            render json: { error: "Authentication required" }, status: :unauthorized
+            return
+          end
+
+          if current_account.cancelled? && !cancelled_account_action_allowed?
+            render json: { error: "Account is cancelled" }, status: :forbidden
+          end
+        end
+
+        def require_owner!
+          return if current_user&.owner?
+
+          render json: { error: "Only the account owner can perform this action" }, status: :forbidden
+        end
+
+        def cancelled_account_action_allowed?
+          case "#{controller_path}##{action_name}"
+          when "api/v1/accounts#show", "api/v1/accounts#reactivate", "api/v1/accounts#cancel",
+               "api/v1/me#show", "api/v1/sessions#destroy"
+            true
+          else
+            false
+          end
+        end
+
+        def user_json(user)
+          {
+            id: user.id,
+            name: user.name,
+            email: user.email,
+            role: user.role,
+            verified: user.verified,
+            created_at: user.created_at,
+            updated_at: user.updated_at
+          }
+        end
+
+        def account_json(account)
+          {
+            id: account.id,
+            name: account.name,
+            subdomain: account.subdomain,
+            cancelled_at: account.cancelled_at,
+            created_at: account.created_at,
+            updated_at: account.updated_at
+          }
+        end
+
+        def portal_json(account)
+          {
+            name: account.name,
+            subdomain: account.subdomain
+          }
+        end
+
+        def render_validation_errors(record, status: :unprocessable_content)
+          render json: { errors: record.errors.to_hash }, status: status
+        end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..aa476d0
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,34 @@
+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      def create
+        user = current_account.users.find_by(email: email_param)
+        unless user
+          render json: { error: "User not found" }, status: :not_found
+          return
+        end
+
+        user.issue_email_verification!
+        render json: { message: "Verification email sent" }
+      end
+
+      def confirm
+        user = User.confirm_email!(current_account, token_param)
+        if user
+          render json: { user: user_json(user) }
+        else
+          render json: { error: "Invalid or expired token" }, status: :unprocessable_content
+        end
+      end
+
+      private
+        def email_param
+          params.require(:email_verification).permit(:email)[:email].to_s.strip.downcase
+        end
+
+        def token_param
+          params.require(:email_verification).permit(:token)[:token].to_s
+        end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/me_controller.rb b/app/controllers/api/v1/me_controller.rb
