+++ b/app/controllers/api/v1/passwords_controller.rb
@@ -0,0 +1,23 @@
+module Api
+  module V1
+    class PasswordsController < BaseController
+      before_action :require_authentication!
+
+      def update
+        if current_user.change_password!(
+          current_password: password_change_params[:current_password],
+          new_password: password_change_params[:password]
+        )
+          render json: { user: user_json(current_user) }
+        else
+          render_validation_errors(current_user)
+        end
+      end
+
+      private
+        def password_change_params
+          params.require(:password_change).permit(:current_password, :password)
+        end
+    end
