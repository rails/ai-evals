+++ b/app/controllers/api/v1/me_controller.rb
@@ -0,0 +1,24 @@
+module Api
+  module V1
+    class MeController < BaseController
+      before_action :require_authentication!
+
+      def show
+        render json: { user: user_json(current_user) }
+      end
+
+      def update
+        if current_user.update(user_params)
+          render json: { user: user_json(current_user) }
+        else
+          render_validation_errors(current_user)
+        end
+      end
+
+      private
+        def user_params
+          params.require(:user).permit(:name)
+        end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/password_resets_controller.rb b/app/controllers/api/v1/password_resets_controller.rb
new file mode 100644
index 0000000..f5631c3
--- /dev/null
+++ b/app/controllers/api/v1/password_resets_controller.rb
@@ -0,0 +1,40 @@
+module Api
+  module V1
+    class PasswordResetsController < BaseController
+      def create
+        user = current_account.users.find_by(email: email_param)
+        unless user
+          render json: { error: "User not found" }, status: :not_found
+          return
+        end
+
+        user.issue_password_reset!
+        render json: { message: "Password reset email sent" }
+      end
+
+      def confirm
+        result = User.reset_password!(current_account, token_param, password_param)
+        if result == :invalid_token
+          render json: { error: "Invalid or expired token" }, status: :unprocessable_content
+        elsif result.errors.any?
+          render_validation_errors(result)
+        else
+          render json: { user: user_json(result) }
+        end
+      end
+
+      private
+        def email_param
+          params.require(:password_reset).permit(:email)[:email].to_s.strip.downcase
+        end
+
+        def token_param
+          params.require(:password_reset).permit(:token, :password)[:token].to_s
+        end
+
+        def password_param
+          params.require(:password_reset).permit(:token, :password)[:password].to_s
+        end
+    end
+  end
+end
