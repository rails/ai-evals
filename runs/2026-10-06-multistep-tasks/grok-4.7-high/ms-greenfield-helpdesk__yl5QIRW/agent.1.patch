+++ b/test/integration/account_lifecycle_test.rb
@@ -0,0 +1,464 @@
+require "test_helper"
+
+class AccountLifecycleTest < ActionDispatch::IntegrationTest
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @password = "my-first-password"
+  end
+
+  test "owner can sign up, verify, sign in, update profile, change password, reset password, cancel, and reactivate" do
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Acme",
+          subdomain: "acme",
+          admin: { name: "Jo", email: "jo@acme.test", password: @password }
+        }
+      },
+      as: :json
+
+    assert_response :created
+    body = json
+    assert body.dig("account", "id").present?
+    assert_equal "Acme", body.dig("account", "name")
+    assert_equal "acme", body.dig("account", "subdomain")
+    assert body.dig("account", "created_at").present?
+    assert body.dig("account", "updated_at").present?
+    assert_nil body.dig("account", "cancelled_at")
+    assert body.dig("user", "id").present?
+    assert_equal "Jo", body.dig("user", "name")
+    assert_equal "jo@acme.test", body.dig("user", "email")
+    assert_equal "admin", body.dig("user", "role")
+    assert_equal false, body.dig("user", "verified")
+    assert body.dig("user", "created_at").present?
+    assert body.dig("user", "updated_at").present?
+    assert_not body["user"].key?("password_digest")
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "jo@acme.test" ], mail.to
+    assert_equal [ "support@example.test" ], mail.from
+    token = token_from(mail)
+    assert_includes mail.body.to_s, "http://localhost:3001/verify-email?account=acme&token=#{token}"
+    assert_includes mail_body(mail), "http://localhost:3001/verify-email?account=acme&token=#{token}"
+
+    # Cannot sign in before verification.
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: @password } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    # Public portal does not require auth.
+    get "/api/v1/portal", headers: account_headers("acme")
+    assert_response :success
+    assert_equal({ "name" => "Acme", "subdomain" => "acme" }, json["portal"])
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+
+    # Signed-in account endpoint requires auth.
+    get "/api/v1/account", headers: account_headers("acme")
+    assert_response :unauthorized
+
+    # Old verification link is replaced.
+    post "/api/v1/email_verifications",
+      params: { email_verification: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :success
+    new_token = token_from(ActionMailer::Base.deliveries.last)
+    assert_not_equal token, new_token
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: new_token } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :success
+    assert_equal true, json.dig("user", "verified")
+
+    post "/api/v1/sessions",
+      params: { session: { email: "Jo@Acme.test", password: @password } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    session_token = json.dig("session", "token")
+    assert session_token.present?
+    assert_equal "Jo", json.dig("user", "name")
+    assert_equal "acme", json.dig("account", "subdomain")
+    assert_equal true, json.dig("user", "verified")
+
+    auth = account_headers("acme", session_token)
+
+    get "/api/v1/me", headers: auth
+    assert_response :success
+    assert_equal "Jo", json.dig("user", "name")
+
+    get "/api/v1/account", headers: auth
+    assert_response :success
+    assert_equal "Acme", json.dig("account", "name")
+    assert json.dig("account", "id").present?
+
+    patch "/api/v1/me",
+      params: { user: { name: "Jo Smith", role: "owner", verified: false } },
+      headers: auth,
+      as: :json
+    assert_response :success
+    assert_equal "Jo Smith", json.dig("user", "name")
+    assert_equal "admin", json.dig("user", "role")
+    assert_equal true, json.dig("user", "verified")
+
+    # Second session survives until a password change.
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: @password } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    other_token = json.dig("session", "token")
+
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: "wrong-password", password: "my-new-password" } },
+      headers: auth,
+      as: :json
+    assert_response :unprocessable_content
+
+    put "/api/v1/me/password",
+      params: { password_change: { current_password: @password, password: "my-new-password" } },
+      headers: auth,
+      as: :json
+    assert_response :success
+
+    get "/api/v1/me", headers: auth
+    assert_response :unauthorized
+    get "/api/v1/me", headers: account_headers("acme", other_token)
+    assert_response :unauthorized
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: @password } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unauthorized
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "my-new-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    session_token = json.dig("session", "token")
+    auth = account_headers("acme", session_token)
+
+    # Password reset replaces older links and signs out sessions.
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :success
+    reset_mail = ActionMailer::Base.deliveries.last
+    old_reset = token_from(reset_mail)
+    assert_includes mail_body(reset_mail), "http://localhost:3001/reset-password?account=acme&token=#{old_reset}"
+    assert_equal [ "support@example.test" ], reset_mail.from
+
+    post "/api/v1/password_resets",
+      params: { password_reset: { email: "jo@acme.test" } },
+      headers: account_headers("acme"),
+      as: :json
+    reset_token = token_from(ActionMailer::Base.deliveries.last)
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: old_reset, password: "another-password" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/password_resets/confirm",
+      params: { password_reset: { token: reset_token, password: "reset-password-1" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :success
+
+    get "/api/v1/me", headers: auth
+    assert_response :unauthorized
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "reset-password-1" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    session_token = json.dig("session", "token")
+    auth = account_headers("acme", session_token)
+
+    delete "/api/v1/session", headers: auth
+    assert_response :no_content
+    get "/api/v1/me", headers: auth
+    assert_response :unauthorized
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "reset-password-1" } },
+      headers: account_headers("acme"),
+      as: :json
+    session_token = json.dig("session", "token")
+    auth = account_headers("acme", session_token)
+
+    post "/api/v1/account/cancel", headers: auth, as: :json
+    assert_response :success
+    assert json.dig("account", "cancelled_at").present?
+
+    get "/api/v1/me", headers: auth
+    assert_response :unauthorized
+
+    get "/api/v1/account", headers: account_headers("acme")
+    assert_response :unauthorized
+
+    # Ordinary sign-in is blocked, but the owner can sign in to reactivate.
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: "reset-password-1" } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    assert json.dig("account", "cancelled_at").present?
+    owner_token = json.dig("session", "token")
+    owner_auth = account_headers("acme", owner_token)
+
+    patch "/api/v1/me",
+      params: { user: { name: "Should Fail" } },
+      headers: owner_auth,
+      as: :json
+    assert_response :forbidden
+
+    get "/api/v1/account", headers: owner_auth
+    assert_response :success
+    assert json.dig("account", "cancelled_at").present?
+
+    post "/api/v1/account/reactivate", headers: owner_auth, as: :json
+    assert_response :success
+    assert_nil json.dig("account", "cancelled_at")
+
+    patch "/api/v1/me",
+      params: { user: { name: "Jo Again" } },
+      headers: owner_auth,
+      as: :json
+    assert_response :success
+    assert_equal "Jo Again", json.dig("user", "name")
+  end
+
+  test "the same email can belong to different businesses" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    create_account!("Beta", "beta", "jo@acme.test")
+
+    assert_equal 2, User.where(email: "jo@acme.test").count
+    get "/api/v1/portal", headers: account_headers("beta")
+    assert_equal "Beta", json.dig("portal", "name")
+  end
+
+  test "duplicate subdomain is rejected and account header is required" do
+    create_account!("Acme", "acme", "jo@acme.test")
+
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Other",
+          subdomain: "ACME",
+          admin: { name: "Sam", email: "sam@acme.test", password: @password }
+        }
+      },
+      as: :json
+    assert_response :unprocessable_content
+
+    get "/api/v1/portal"
+    assert_response :bad_request
+
+    get "/api/v1/portal", headers: account_headers("missing")
+    assert_response :not_found
+  end
+
+  test "custom frontend url and mail from are used" do
+    ENV["HELPDESK_FRONTEND_URL"] = "https://help.example.com"
+    ENV["HELPDESK_MAIL_FROM"] = "desk@example.com"
+    create_account!("Acme", "acme", "jo@acme.test")
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "desk@example.com" ], mail.from
+    assert_includes mail_body(mail), "https://help.example.com/verify-email?account=acme&token="
+
+    get "/api/v1/portal", headers: account_headers("acme").merge("Origin" => "https://help.example.com")
+    assert_equal "https://help.example.com", response.headers["Access-Control-Allow-Origin"]
+  ensure
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  test "preflight requests are allowed from the frontend origin" do
+    options "/api/v1/sessions", headers: {
+      "Origin" => "http://localhost:3001",
+      "Access-Control-Request-Method" => "POST",
+      "Access-Control-Request-Headers" => "authorization,content-type,x-helpdesk-account"
+    }
+    assert_response :no_content
+    assert_equal "http://localhost:3001", response.headers["Access-Control-Allow-Origin"]
+    assert_includes response.headers["Access-Control-Allow-Headers"].downcase, "x-helpdesk-account"
+    assert_includes response.headers["Access-Control-Allow-Methods"], "POST"
+  end
+
+  test "cancelled accounts are purged after 90 days including their data" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+    account = Account.find_by!(subdomain: "acme")
+    user = account.users.first
+    user.sessions.create!
+    account.cancel!
+
+    recent = nil
+    travel_to 89.days.ago do
+      # not used; set cancelled_at explicitly below
+    end
+    account.update!(cancelled_at: 89.days.ago)
+    assert_equal 0, Account.purge_cancelled!
+    assert Account.exists?(account.id)
+
+    account.update!(cancelled_at: 90.days.ago - 1.minute)
+    user.sessions.create!(token: "purge-me")
+    assert_difference -> { Account.count }, -1 do
+      assert_difference -> { User.count }, -1 do
+        assert_difference -> { Session.count }, -1 do
+          require "rake"
+          Rails.application.load_tasks unless Rake::Task.task_defined?("helpdesk:purge_cancelled_accounts")
+          Rake::Task["helpdesk:purge_cancelled_accounts"].reenable
+          Rake::Task["helpdesk:purge_cancelled_accounts"].invoke
+        end
+      end
+    end
+    assert_not Account.exists?(account.id)
+    assert_not User.exists?(user.id)
+  end
+
+  test "owner cannot reactivate after 90 days" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+    account = Account.find_by!(subdomain: "acme")
+    account.update!(cancelled_at: 1.day.ago)
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: @password } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+    token = json.dig("session", "token")
+
+    travel 90.days do
+      post "/api/v1/account/reactivate", headers: account_headers("acme", token), as: :json
+      assert_response :unprocessable_content
+      assert account.reload.cancelled?
+
+      post "/api/v1/sessions",
+        params: { session: { email: "jo@acme.test", password: @password } },
+        headers: account_headers("acme"),
+        as: :json
+      assert_response :forbidden
+    end
+  end
+
+  test "a non-owner cannot sign in to a cancelled account" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+    account = Account.find_by!(subdomain: "acme")
+    agent = account.users.create!(
+      name: "Agent",
+      email: "agent@acme.test",
+      password: @password,
+      role: "admin",
+      verified: true
+    )
+    account.cancel!
+
+    post "/api/v1/sessions",
+      params: { session: { email: agent.email, password: @password } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :forbidden
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: @password } },
+      headers: account_headers("acme"),
+      as: :json
+    assert_response :created
+  end
+
+  test "duplicate email in the same business is rejected and sessions are account scoped" do
+    create_account!("Acme", "acme", "jo@acme.test")
+    verify_latest!
+
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: "Acme",
+          subdomain: "acme",
+          admin: { name: "Other", email: "jo@acme.test", password: @password }
+        }
+      },
+      as: :json
+    assert_response :unprocessable_content
+
+    post "/api/v1/sessions",
+      params: { session: { email: "jo@acme.test", password: @password } },
+      headers: account_headers("acme"),
+      as: :json
+    token = json.dig("session", "token")
+
+    create_account!("Beta", "beta", "sam@beta.test")
+    get "/api/v1/me", headers: account_headers("beta", token)
+    assert_response :unauthorized
+    get "/api/v1/me", headers: account_headers("acme", token)
+    assert_response :success
+  end
+
+  private
+    def json
+      JSON.parse(response.body)
+    end
+
+    def account_headers(subdomain, token = nil)
+      headers = { "X-Helpdesk-Account" => subdomain }
+      headers["Authorization"] = "Bearer #{token}" if token
+      headers
+    end
+
+    def mail_body(mail)
+      if mail.multipart?
+        [ mail.text_part&.body&.decoded, mail.html_part&.body&.decoded, mail.body.encoded ].compact.join("\n")
+      else
+        mail.body.decoded
+      end
+    end
+
+    def token_from(mail)
+      mail_body(mail)[/token=([^&\s"']+)/, 1]
+    end
+
+    def create_account!(name, subdomain, email)
+      post "/api/v1/account/create",
+        params: {
+          account: {
+            name: name,
+            subdomain: subdomain,
+            admin: { name: "Jo", email: email, password: @password }
+          }
+        },
+        as: :json
+      assert_response :created
+    end
+
+    def verify_latest!
+      token = token_from(ActionMailer::Base.deliveries.last)
+      account = Account.order(:id).last
+      post "/api/v1/email_verifications/confirm",
+        params: { email_verification: { token: token } },
+        headers: account_headers(account.subdomain),
+        as: :json
+      assert_response :success
+    end
+end
