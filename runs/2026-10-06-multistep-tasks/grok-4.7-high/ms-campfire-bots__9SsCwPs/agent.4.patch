diff --git a/docs/bots.md b/docs/bots.md
index 748b852..e270dc4 100644
--- a/docs/bots.md
+++ b/docs/bots.md
@@ -12,6 +12,15 @@ Any signed-in member can create and manage bots from Account settings (`/account
 - Bots show up wherever active users are offered for room membership (closed rooms, direct rooms, mentions). They are kept off the account people list, the sign-in path, and the sidebar's ping shortcuts.
 - Deleting a bot destroys the credential and deactivates the user. Past messages remain, still attributed to the bot. The code can no longer post.
 
+## Bots per member
+
+Administrators cap how many bots each member can have from Account settings (`/account/edit`). The setting is labelled "Bots per member". It is a number, stored in `account.settings` as `bots_per_member`, and defaults to 5 even before it has been saved.
+
+- A member can have at most that many bots. Retired bots are destroyed, so they do not count.
+- Administrators are not limited, including when they already have more bots than the cap.
+- At the limit, `/bots` does not offer "Add a chat bot" and tells the member they've reached the limit. `GET /bots/new` and `POST /bots` redirect back to that page. `Bot` creation also fails validation, so any other create path is refused too.
+- Lowering the limit never removes existing bots. It only blocks new ones. Editing or deleting a bot that is already over the cap still works.
+
 ## Open rooms
 
 Bots do not join open rooms by default. The new and edit forms have a switch labelled "Add to all open rooms", off by default. It is a real checkbox (`bot[add_to_all_open_rooms]`) styled as a switch.
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
index 9b052ce..7dbab79 100644
--- a/test/controllers/bots_controller_test.rb
+++ b/test/controllers/bots_controller_test.rb
@@ -222,6 +222,105 @@ test "bot form has an optional webhook URL field" do
     assert_select "label", text: /Webhook URL/
   end
 
+  test "account settings offers bots per member to administrators, 5 by default" do
+    sign_in :david
+
+    get edit_account_url
+
+    assert_response :success
+    assert_select "label", text: /Bots per member/
+    assert_select "input[type=number][aria-label='Bots per member'][value='5']"
+    assert_equal 5, accounts(:signal).settings.bots_per_member
+  end
+
+  test "members do not see the bots per member setting" do
+    get edit_account_url
+
+    assert_select "input[aria-label='Bots per member']", count: 0
+  end
+
+  test "administrators can change bots per member" do
+    sign_in :david
+
+    put account_url, params: { account: { settings: { bots_per_member: "2" } } }
+
+    assert_redirected_to edit_account_url
+    assert_equal 2, accounts(:signal).reload.settings.bots_per_member
+  end
+
+  test "a member at the limit is not offered add a chat bot and is told they reached the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    create_bot(owner: users(:kevin), name: "Deploy Bot")
+
+    get bots_url
+
+    assert_response :success
+    assert_select "button", text: /Add a chat bot/, count: 0
+    assert_match(/reached the limit/, response.body)
+  end
+
+  test "a member under the limit can still add a chat bot" do
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+    create_bot(owner: users(:kevin), name: "Deploy Bot")
+
+    get bots_url
+
+    assert_select "button", text: /Add a chat bot/
+    assert_no_match(/reached the limit/, response.body)
+  end
+
+  test "creating a bot at the limit is refused" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    create_bot(owner: users(:kevin), name: "Deploy Bot")
+
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { user_attributes: { name: "Another Bot" } } }
+    end
+
+    assert_redirected_to bots_url
+
+    get new_bot_url
+    assert_redirected_to bots_url
+  end
+
+  test "administrators are not limited" do
+    sign_in :david
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    create_bot(owner: users(:david), name: "Admin Bot")
+
+    get bots_url
+    assert_select "button", text: /Add a chat bot/
+    assert_no_match(/reached the limit/, response.body)
+
+    assert_difference -> { Bot.count }, +1 do
+      post bots_url, params: { bot: { user_attributes: { name: "Another Admin Bot" } } }
+    end
+  end
+
+  test "deleted bots do not count toward the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    bot = create_bot(owner: users(:kevin), name: "Deploy Bot")
+    bot.retire
+
+    get bots_url
+    assert_select "button", text: /Add a chat bot/
+
+    assert_difference -> { Bot.count }, +1 do
+      post bots_url, params: { bot: { user_attributes: { name: "Replacement Bot" } } }
+    end
+  end
+
+  test "lowering the limit does not remove existing bots" do
+    2.times { |i| create_bot(owner: users(:kevin), name: "Bot #{i}") }
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    assert_equal 2, users(:kevin).owned_bots.count
+
+    get bots_url
+    assert_select "input[aria-label='Bot code']", count: 2
+    assert_select "button", text: /Add a chat bot/, count: 0
+    assert_match(/reached the limit/, response.body)
+  end
   private
     def create_bot(owner:, name:)
       bot = owner.owned_bots.build
diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
index 4f30f73..7677595 100644
--- a/test/models/bot_test.rb
+++ b/test/models/bot_test.rb
@@ -83,6 +83,41 @@ end
     assert_equal "https://hooks.example/campfire", bot.reload.webhook_url
   end
 
+  test "members cannot create bots beyond the account allowance" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    owner = users(:kevin)
+
+    first = owner.owned_bots.build
+    first.build_user(name: "One")
+    assert first.save
+
+    second = owner.owned_bots.build
+    second.build_user(name: "Two")
+    assert_not second.save
+    assert_match(/reached the limit/, second.errors.full_messages.join)
+
+    assert users(:david).administrator?
+    admin_bot = users(:david).owned_bots.build
+    admin_bot.build_user(name: "Admin Extra")
+    assert admin_bot.save
+  end
+
+  test "lowering the allowance does not block edits or delete existing bots" do
+    owner = users(:kevin)
+    bots = 2.times.map do |i|
+      bot = owner.owned_bots.build
+      bot.build_user(name: "Bot #{i}")
+      bot.save!
+      bot
+    end
+
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    assert_equal 2, owner.owned_bots.count
+    assert bots.first.update(webhook_url: "https://hooks.example/still-editable")
+    bots.last.retire
+    assert_equal 1, owner.reload.owned_bots.count
+  end
+
   private
     def create_bot(name:)
       bot = users(:david).owned_bots.build
