--- /dev/null
+++ b/app/models/bot/joined_delivery.rb
@@ -0,0 +1,37 @@
+# Tells a bot it was added to a room, and posts an inline hello the same way a
+# mention reply is posted.
+class Bot::JoinedDelivery
+  def initialize(bot, room)
+    @bot = bot
+    @room = room
+  end
+
+  def deliver
+    return unless deliverable?
+
+    Bot::Webhook.new(bot, room).deliver { payload }
+  end
+
+  # The JSON body sent to the webhook. Exposed so tests can assert the contract
+  # without standing up HTTP.
+  def payload
+    {
+      event: "joined",
+      room: { id: room.id, name: room.name, reply_to: reply_to_path }
+    }
+  end
+
+  private
+    attr_reader :bot, :room
+
+    def deliverable?
+      bot.webhook_url.present? &&
+        bot.user&.active? &&
+        !room.direct? &&
+        Membership.exists?(room_id: room.id, user_id: bot.user_id)
+    end
+
+    def reply_to_path
+      Rails.application.routes.url_helpers.room_bot_message_path(room.id, bot.code)
+    end
+end
