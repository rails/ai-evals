+class Bot::DeliverMentionJob < ApplicationJob
+  # The message or bot may have been removed before a worker picks this up.
+  discard_on ActiveJob::DeserializationError
+
+  def perform(message, bot)
+    Bot::MentionDelivery.new(message, bot).deliver
+  end
+end
