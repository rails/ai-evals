index 0000000..1ff43c5
--- /dev/null
+++ b/config/initializers/filter_bot_code_logs.rb
@@ -0,0 +1,11 @@
+# The bot code is a credential that lives in the request path. Parameter filtering
+# covers the params hash, but the "Started POST" line logs the path itself.
+module FilterBotCodeFromRequestLogs
+  BOT_MESSAGE_PATH = %r{(/rooms/[^/]+/)[^/\s"]+(/messages)}
+
+  def started_request_message(request)
+    super.gsub(BOT_MESSAGE_PATH, "\\1[FILTERED]\\2")
+  end
+end
+
+Rails::Rack::Logger.prepend(FilterBotCodeFromRequestLogs)
