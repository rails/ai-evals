+++ b/app/models/game_question.rb
@@ -0,0 +1,8 @@
+class GameQuestion < ApplicationRecord
+  belongs_to :game, inverse_of: :game_questions
+  has_many :answers, dependent: :destroy, inverse_of: :game_question
