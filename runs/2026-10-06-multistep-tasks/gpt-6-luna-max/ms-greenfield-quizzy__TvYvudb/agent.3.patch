+<div class="screen cover cover--night">
+  <header class="screen__top">
+    <%= link_to moderate_quiz_path(quiz), class: "logo screen__logo", aria: { label: "Back to quiz" } do %>
+      <span class="logo__mark">?</span>Quizzy
+    <% end %>
+    <span class="screen__kicker"><%= quiz.title %></span>
+  </header>
+
+  <main class="screen__body">
+    <% if game.waiting? %>
+      <section class="lobby" aria-label="Game lobby">
+        <div>
+          <h1 class="lobby__title"><%= quiz.title %></h1>
+          <p class="lobby__join">Join at</p>
+          <p class="lobby__url"><%= join_url %></p>
+          <p class="counter-pill">
+            Players: <strong data-live-player-count><%= players_count %></strong>
+          </p>
+        </div>
+        <div class="qr"><%= raw qr_svg %></div>
+      </section>
+    <% elsif game.finished? %>
+      <section class="waiting">
+        <h1>The quiz is over</h1>
+      </section>
+    <% elsif current_question %>
+      <section class="stage-question" data-live-question-id="<%= current_question.id %>">
+        <p class="stage-question__num">Question <%= current_question.position + 1 %> of <%= game.question_count %></p>
+        <h1 class="stage-question__body"><%= current_question.text %></h1>
+
+        <% if game.question_open? %>
+          <ul class="stage-options">
+            <% current_question.game_options.each_with_index do |option, index| %>
+              <li class="stage-option">
+                <span class="stage-option__letter"><%= option_label(index) %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+              </li>
+            <% end %>
+          </ul>
+        <% else %>
+          <ul class="stage-options stage-options--results">
+            <% counts = answer_counts || {} %>
+            <% current_question.game_options.each_with_index do |option, index| %>
+              <li class="stage-option <%= "is-correct" if option.correct? %>">
+                <span class="stage-option__letter"><%= option_label(index) %></span>
+                <span class="stage-option__title"><%= option.text %></span>
+                <span class="stage-option__count"><%= counts.fetch(option.id, 0) %></span>
+                <% if option.correct? %><span class="stage-option__mark">Correct</span><% end %>
+              </li>
+            <% end %>
+          </ul>
+        <% end %>
+      </section>
+    <% end %>
+  </main>
+
+  <footer class="screen-controls">
+    <div class="screen-controls__info">
+      <% if game.question_open? && current_question %>
+        <span class="answers-counter" data-live-answers>
+          Answers: <span data-live-answers-count><%= game.answered_count(current_question) %></span> /
+          <span data-live-player-count><%= players_count %></span>
+        </span>
+      <% elsif game.question_closed? && current_question %>
+        <span class="answers-counter">Question <%= current_question.position + 1 %> results</span>
+      <% elsif game.waiting? %>
+        <span>Waiting for players to join</span>
+      <% end %>
+    </div>
+
+    <div class="buttons">
+      <% if game.waiting? %>
+        <%= button_to "Start", start_moderate_quiz_game_path(quiz, game), method: :patch,
+          class: "btn btn--pink btn--lg", form: { data: { live_remote: true } } %>
+      <% elsif game.question_open? %>
+        <%= button_to "Finish", finish_moderate_quiz_game_path(quiz, game), method: :patch,
+          class: "btn btn--pink btn--lg", form: { data: { live_remote: true } } %>
+      <% elsif game.question_closed? && game.last_question? %>
+        <%= button_to "End quiz", end_quiz_moderate_quiz_game_path(quiz, game), method: :patch,
+          class: "btn btn--pink btn--lg", form: { data: { live_remote: true } } %>
+      <% elsif game.question_closed? %>
+        <%= button_to "Next", advance_moderate_quiz_game_path(quiz, game), method: :patch,
+          class: "btn btn--pink btn--lg", form: { data: { live_remote: true } } %>
+      <% else %>
+        <%= link_to "Back to quiz", moderate_quiz_path(quiz), class: "btn btn--light" %>
+      <% end %>
+    </div>
+  </footer>
+</div>
