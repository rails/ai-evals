+  private
+
+  def get_json(path, headers:)
+    get path, headers: headers
+    assert_response :success
+    JSON.parse(response.body)
+  end
+
+  def join_as(name, game)
+    post join_play_path(game.join_code), params: { name: name }
+    assert_response :redirect
+    game.game_players.find_by!(name: name)
+  end
+
+  def build_question(quiz, text, options, active: true)
+    quiz.questions.create!(
+      text: text,
+      active: active,
+      position: quiz.questions.maximum(:position).to_i + 1,
+      question_options_attributes: options.each_with_index.to_h do |(option_text, correct), index|
+        [ index.to_s, { text: option_text, correct: correct } ]
+      end
+    )
+  end
+
+  def assert_select_in_html(html, *args)
+    assert_select Nokogiri::HTML.fragment(html), *args
+  end
+
+  def assert_response_for(session, status)
+    assert_equal status, session.response.status == 200 ? :success : session.response.status
+  end
