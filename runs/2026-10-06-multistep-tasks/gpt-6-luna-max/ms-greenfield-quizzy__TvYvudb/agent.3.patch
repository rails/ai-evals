diff --git a/app/views/play/_panel.html.erb b/app/views/play/_panel.html.erb
new file mode 100644
index 0000000..ff6c335
--- /dev/null
+++ b/app/views/play/_panel.html.erb
@@ -0,0 +1,79 @@
+<main class="play">
+  <header class="play__top">
+    <%= link_to root_path, class: "logo play__logo", aria: { label: "Quizzy home" } do %>
+      <span class="logo__mark">?</span>Quizzy
+    <% end %>
+    <span><%= game.quiz.title %></span>
+  </header>
+
+  <div class="play__body <%= "play__body--top" if game.question_open? || game.question_closed? %>">
+    <% if game.finished? %>
+      <section class="waiting">
+        <h1>The quiz is over</h1>
+      </section>
+    <% elsif player.nil? %>
+      <section>
+        <h1 class="play-title"><%= game.quiz.title %></h1>
+        <p class="play-lead">Join the live quiz</p>
+        <% if join_error.present? %><p class="errors" role="alert"><%= join_error %></p><% end %>
+        <%= form_with url: join_play_path(game.join_code), method: :post, class: "join-form" do %>
+          <div class="field">
+            <%= label_tag :name, "Your name", class: "visually-hidden" %>
+            <%= text_field_tag :name, nil, class: "input", placeholder: "Your name", required: true,
+              maxlength: 40, autocomplete: "name", autofocus: true, aria: { label: "Your name" } %>
+          </div>
+          <%= submit_tag "Join", class: "btn btn--pink" %>
+        <% end %>
+      </section>
+    <% elsif game.waiting? %>
+      <section class="waiting">
+        <div class="waiting__gem" aria-hidden="true">?</div>
+        <h1>Hi, <%= player.name %>!</h1>
+        <p class="play-lead">Waiting for the quiz to start</p>
+      </section>
+    <% elsif question && game.question_open? %>
+      <section class="play-question" data-live-question-id="<%= question.id %>">
+        <p class="play-question__num">Question <%= question.position + 1 %> of <%= game.question_count %></p>
+        <h1 class="play-question__body"><%= question.text %></h1>
+        <ul class="play-options">
+          <% question.game_options.each_with_index do |option, index| %>
+            <% picked = answer&.game_option_id == option.id %>
+            <li>
+              <%= form_with url: answer_play_path(game.join_code), method: :post,
+                data: { live_remote: true } do %>
+                <%= hidden_field_tag :option_id, option.id %>
+                <button type="submit" class="play-option <%= "is-picked" if picked %>"
+                  aria-pressed="<%= picked %>">
+                  <span class="play-option__letter"><%= option_label(index) %></span>
+                  <span class="play-option__title"><%= option.text %></span>
+                  <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+                </button>
+              <% end %>
+            </li>
+          <% end %>
+        </ul>
+      </section>
+    <% elsif question && game.question_closed? %>
+      <% result = if answer.nil? then "No answer" elsif answer.game_option.correct? then "Correct!" else "Wrong!" end %>
+      <% result_class = result == "Correct!" ? "play-status--right" : (result == "Wrong!" ? "play-status--wrong" : "play-status--neutral") %>
+      <section class="play-question" data-live-question-id="<%= question.id %>">
+        <p class="play-question__num">Question <%= question.position + 1 %> of <%= game.question_count %></p>
+        <h1 class="play-question__body"><%= question.text %></h1>
+        <ul class="play-options is-revealed is-locked">
+          <% question.game_options.each_with_index do |option, index| %>
+            <% picked = answer&.game_option_id == option.id %>
+            <li>
+              <div class="play-option <%= "is-picked" if picked %> <%= "is-correct" if option.correct? %>">
+                <span class="play-option__letter"><%= option_label(index) %></span>
+                <span class="play-option__title"><%= option.text %></span>
+                <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+                <% if option.correct? %><span class="play-option__mark">Correct</span><% end %>
+              </div>
+            </li>
+          <% end %>
+        </ul>
+        <p class="play-status <%= result_class %>" role="status"><%= result %></p>
+      </section>
+    <% end %>
+  </div>
+</main>
