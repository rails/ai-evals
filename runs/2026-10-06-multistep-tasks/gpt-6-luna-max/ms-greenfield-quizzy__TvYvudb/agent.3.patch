diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..65f2f58
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,119 @@
+class PlayController < ApplicationController
+  before_action :set_game
+
+  def show
+    prepare_player_view
+  end
+
+  def state
+    prepare_player_view
+    response.headers["Cache-Control"] = "no-store"
+    render json: {
+      html: render_to_string(
+        partial: "play/panel",
+        formats: [ :html ],
+        locals: {
+          game: @game,
+          player: @player,
+          question: @question,
+          answer: @answer,
+          join_error: nil
+        }
+      ),
+      state_key: @state_key
+    }
+  end
+
+  def join
+    if current_player
+      redirect_to play_path(@game.join_code)
+      return
+    end
+
+    game_over = false
+    @game.with_lock do
+      if @game.finished?
+        game_over = true
+      else
+        @player = @game.game_players.build(name: params[:name].to_s.strip)
+        @player.save
+      end
+    end
+
+    if game_over
+      redirect_to play_path(@game.join_code)
+    elsif @player&.persisted?
+      cookies.signed[player_cookie_name] = {
+        value: @player.player_token,
+        expires: 1.year.from_now,
+        httponly: true,
+        same_site: :lax,
+        path: "/play/#{@game.join_code}"
+      }
+      redirect_to play_path(@game.join_code)
+    else
+      @join_error = @player.errors.full_messages.to_sentence
+      @player = nil
+      prepare_player_view
+      render :show, status: :unprocessable_entity
+    end
+  end
+
+  def answer
+    @player = current_player
+    return head :unauthorized unless @player
+
+    @game.with_lock do
+      question = @game.current_game_question
+      raise Game::InvalidTransition, "This question is not open." unless @game.question_open? && question
+
+      option = question.game_options.find(params[:option_id])
+      answer = @player.answers.find_or_initialize_by(game_question: question)
+      answer.game_option = option
+      answer.save!
+    end
+
+    if request.format.json?
+      # Correctness is deliberately never returned while a question is open.
+      render json: { ok: true }
+    else
+      redirect_to play_path(@game.join_code), status: :see_other
+    end
+  rescue ActiveRecord::RecordNotFound
+    head :not_found
+  rescue Game::InvalidTransition, ActiveRecord::RecordInvalid => error
+    if request.format.json?
+      render json: { error: error.message }, status: :unprocessable_entity
+    else
+      redirect_to play_path(@game.join_code), alert: error.message, status: :see_other
+    end
+  end
+
+  private
+
+  def set_game
+    @game = Game.find_by!(join_code: params[:code].to_s.upcase)
+  end
+
+  def current_player
+    token = cookies.signed[player_cookie_name]
+    return if token.blank?
+
+    @game.game_players.find_by(player_token: token)
+  end
+
+  def prepare_player_view
+    @player = current_player unless instance_variable_defined?(:@player)
+    @question = @game.current_game_question
+    @answer = @player && @question ? @player.answers.find_by(game_question_id: @question.id) : nil
+    @state_key = Digest::SHA256.hexdigest([
+      @game.id, @game.status, @game.current_question_position,
+      @game.updated_at&.utc&.to_f, @player&.id, @question&.id,
+      @answer&.id, @answer&.updated_at&.utc&.to_f
+    ].join(":"))
+  end
+
+  def player_cookie_name
+    "quizzy_player_#{@game.join_code.downcase}"
+  end
+end
diff --git a/app/javascript/controllers/live_controller.js b/app/javascript/controllers/live_controller.js
new file mode 100644
index 0000000..86f8b78
--- /dev/null
+++ b/app/javascript/controllers/live_controller.js
@@ -0,0 +1,140 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["content"]
+  static values = { url: String, channel: String, moderatorToken: String, stateKey: String }
+
+  connect() {
+    this.connectedToCable = false
+    this.refreshInProgress = false
+    this.refreshAgain = false
+    this.handleSubmit = this.handleSubmit.bind(this)
+    this.visibilityChanged = this.visibilityChanged.bind(this)
+    this.element.addEventListener("submit", this.handleSubmit)
+    document.addEventListener("visibilitychange", this.visibilityChanged)
+
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      { channel: "GameChannel", code: this.channelValue },
+      {
+        connected: () => {
+          this.connectedToCable = true
+          // Catch a phase or count change that happened after the initial page load
+          // but before this subscription was established. Unchanged HTML is not replaced.
+          this.refresh()
+        },
+        disconnected: () => { this.connectedToCable = false },
+        rejected: () => { this.connectedToCable = false },
+        received: (message) => this.received(message)
+      }
+    )
+
+    if (this.hasModeratorTokenValue) {
+      this.moderatorSubscription = this.consumer.subscriptions.create(
+        { channel: "ModeratorGameChannel", code: this.channelValue, token: this.moderatorTokenValue },
+        { received: (message) => this.received(message) }
+      )
+    }
+
+    // WebSockets carry normal updates. Poll slowly only as a fallback for networks
+    // that block or repeatedly drop them, and never poll a background tab.
+    this.fallbackTimer = window.setInterval(() => {
+      if (!this.connectedToCable && document.visibilityState === "visible") this.refresh()
+    }, 5000)
+  }
+
+  disconnect() {
+    window.clearInterval(this.fallbackTimer)
+    document.removeEventListener("visibilitychange", this.visibilityChanged)
+    this.element.removeEventListener("submit", this.handleSubmit)
+    this.subscription?.unsubscribe()
+    this.moderatorSubscription?.unsubscribe()
+    this.consumer?.disconnect()
+  }
+
+  received(message) {
+    if (message.event === "answers") {
+      const question = this.contentTarget.querySelector("[data-live-question-id]")
+      if (!question || Number(question.dataset.liveQuestionId) !== Number(message.question_id)) return
+
+      const answered = this.contentTarget.querySelector("[data-live-answers-count]")
+      const players = this.contentTarget.querySelector("[data-live-player-count]")
+      if (answered) answered.textContent = message.answered
+      if (players) players.textContent = message.players
+      return
+    }
+
+    if (message.event === "players") {
+      this.contentTarget.querySelectorAll("[data-live-player-count]").forEach((counter) => {
+        counter.textContent = message.players
+      })
+      return
+    }
+
+    if (message.event === "refresh") this.refresh()
+  }
+
+  async handleSubmit(event) {
+    const form = event.target.closest("form[data-live-remote]")
+    if (!form || !this.element.contains(form)) return
+
+    event.preventDefault()
+    const button = event.submitter || form.querySelector("button[type=submit]")
+    if (button) button.disabled = true
+
+    try {
+      const csrf = document.querySelector('meta[name="csrf-token"]')?.content
+      const response = await fetch(form.action, {
+        method: form.method.toUpperCase(),
+        body: new FormData(form),
+        credentials: "same-origin",
+        headers: {
+          Accept: "application/json",
+          ...(csrf ? { "X-CSRF-Token": csrf } : {})
+        }
+      })
+      if (!response.ok) await response.text()
+      await this.refresh()
+    } catch (_error) {
+      // Leave the rendered screen intact; the fallback refresh will catch up.
+    } finally {
+      if (button?.isConnected) button.disabled = false
+    }
+  }
+
+  async refresh() {
+    if (this.refreshInProgress) {
+      this.refreshAgain = true
+      return
+    }
+
+    this.refreshInProgress = true
+    try {
+      const response = await fetch(this.urlValue, {
+        credentials: "same-origin",
+        cache: "no-store",
+        headers: { Accept: "application/json" }
+      })
+      if (response.ok) {
+        const data = await response.json()
+        if (typeof data.html === "string" && data.state_key !== this.stateKeyValue) {
+          this.contentTarget.innerHTML = data.html
+          if (data.state_key) this.stateKeyValue = data.state_key
+        }
+      }
+    } catch (_error) {
+      // A temporary connection failure is recovered by Cable or fallback polling.
+    } finally {
+      this.refreshInProgress = false
+      if (this.refreshAgain) {
+        this.refreshAgain = false
+        this.refresh()
+      }
+    }
+  }
+
+  visibilityChanged() {
+    if (document.visibilityState === "visible" && !this.connectedToCable) this.refresh()
+  }
+}
diff --git a/app/models/answer.rb b/app/models/answer.rb
