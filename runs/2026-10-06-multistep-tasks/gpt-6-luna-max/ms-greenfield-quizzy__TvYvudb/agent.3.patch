diff --git a/docs/implementation-notes.md b/docs/implementation-notes.md
index ec0c2d3..d6e3378 100644
--- a/docs/implementation-notes.md
+++ b/docs/implementation-notes.md
@@ -6,3 +6,11 @@
 - The visual system is the supplied `docs/mockups/quizzy.css` and Inter font copied into the local asset pipeline. Propshaft fingerprints both CSS and font assets for production.
 
 - Quiz portability uses `/moderate/quizzes/:id/export` for an HTML page with a single `<pre>` containing only quiz title, ordered questions/options, and boolean `active`/`correct` flags. `/moderate/quizzes/import` validates the JSON shape and the existing question model rules; all writes are inside one transaction so any invalid question rolls back the entire import. Missing `active` and `correct` values default to `true` and `false`, and blank option rows are skipped like they are in the moderator form.
+
+## Live games
+
+- `Game.create_for_quiz!` takes a snapshot of the currently active questions and their options. A quiz can therefore be rehearsed repeatedly without carrying players or answers across games, and later edits to the authoring quiz cannot mutate a round already in progress.
+- Game state transitions (`waiting` → `question_open` → `question_closed` → next question or `finished`) are performed under a row lock. A `GamePlayer` has a signed, HttpOnly browser cookie scoped to that game's join URL; an `Answer` is unique per player and game-question, so updating the selected option replaces the prior answer.
+- Correctness exists in the game-option snapshot but is rendered to participants only after the game closes the question. The public Action Cable channel carries phase-change notifications only. The moderator's counters use a second channel protected by an expiring Rails message-verifier token; it sends counts, never correct-option data. A slow, visibility-aware state poll is only a fallback when a WebSocket is unavailable. The server returns a state fingerprint so initial/reconnect syncs do not replace unchanged form markup.
+- Join QR codes are generated as inline SVG with the small byte-mode QR encoder in `lib/quizzy/qr_code.rb`; it has no runtime network, CDN, or extra gem dependency. `bin/serve` continues to prepare the primary/cache/queue/cable SQLite databases and precompile all local assets.
+- `test/integration/live_game_test.rb` covers the moderator and player state machine, cookie persistence, inactive-question skipping, answer changes, replay isolation, late joins, end behavior, and pre-finish answer privacy. Chromium was also used against the production launcher to verify Cable phase updates, moderator counters, and AJAX controls.
diff --git a/lib/quizzy/qr_code.rb b/lib/quizzy/qr_code.rb
new file mode 100644
index 0000000..1a3cc84
--- /dev/null
+++ b/lib/quizzy/qr_code.rb
@@ -0,0 +1,333 @@
+# A small, dependency-free QR encoder for the short join URLs used by Quizzy.
+# It implements byte mode, error-correction level L, and versions 1 through 10.
+module Quizzy
+  class QrCode
+    BLOCK_GROUPS = {
+      1 => [ [ 1, 26, 19 ] ],
+      2 => [ [ 1, 44, 34 ] ],
+      3 => [ [ 1, 70, 55 ] ],
+      4 => [ [ 1, 100, 80 ] ],
+      5 => [ [ 1, 134, 108 ] ],
+      6 => [ [ 2, 86, 68 ] ],
+      7 => [ [ 2, 98, 78 ] ],
+      8 => [ [ 2, 121, 97 ] ],
+      9 => [ [ 2, 146, 116 ] ],
+      10 => [ [ 2, 86, 68 ], [ 2, 87, 69 ] ]
+    }.freeze
+
+    ALIGNMENT_POSITIONS = {
+      1 => [], 2 => [ 6, 18 ], 3 => [ 6, 22 ], 4 => [ 6, 26 ],
+      5 => [ 6, 30 ], 6 => [ 6, 34 ], 7 => [ 6, 22, 38 ],
+      8 => [ 6, 24, 42 ], 9 => [ 6, 26, 46 ], 10 => [ 6, 28, 50 ]
+    }.freeze
+
+    def initialize(text)
+      @bytes = String(text).encode(Encoding::UTF_8).bytes
+      @version = BLOCK_GROUPS.keys.find { |version| @bytes.length <= byte_capacity(version) }
+      raise ArgumentError, "QR payload is too long (maximum #{byte_capacity(10)} bytes)" unless @version
+
+      @size = @version * 4 + 17
+      @best_matrix = build_best_matrix
+    end
+
+    def to_svg(quiet_zone: 4)
+      dimension = @size + quiet_zone * 2
+      path = []
+
+      @best_matrix.each_with_index do |row, y|
+        x = 0
+        while x < @size
+          unless row[x]
+            x += 1
+            next
+          end
+
+          start = x
+          x += 1 while x < @size && row[x]
+          path << "M#{start + quiet_zone},#{y + quiet_zone}h#{x - start}v1h-#{x - start}z"
+        end
+      end
+
+      %(<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 #{dimension} #{dimension}" role="img" aria-label="QR code" shape-rendering="crispEdges"><rect width="100%" height="100%" fill="#fff"/><path d="#{path.join}" fill="#000"/></svg>)
+    end
+
+    private
+
+    def byte_capacity(version)
+      BLOCK_GROUPS.fetch(version).sum { |count, _total, data| count * data } - (version < 10 ? 2 : 3)
+    end
+
+    def build_best_matrix
+      codewords = make_codewords
+      best_score = Float::INFINITY
+      best = nil
+
+      8.times do |mask|
+        draw_function_patterns
+        draw_codewords(codewords, mask)
+        draw_format_bits(mask)
+        score = penalty_score
+        if score < best_score
+          best_score = score
+          best = @modules.map(&:dup)
+        end
+      end
+
+      best
+    end
+
+    def make_codewords
+      data_capacity = BLOCK_GROUPS.fetch(@version).sum { |count, _total, data| count * data }
+      bits = []
+      append_bits(bits, 0b0100, 4) # Byte mode
+      append_bits(bits, @bytes.length, @version < 10 ? 8 : 16)
+      @bytes.each { |byte| append_bits(bits, byte, 8) }
+
+      capacity_bits = data_capacity * 8
+      raise ArgumentError, "QR payload is too long" if bits.length > capacity_bits
+
+      [ 4, capacity_bits - bits.length ].min.times { bits << 0 }
+      bits << 0 while bits.length % 8 != 0
+
+      data = bits.each_slice(8).map { |slice| slice.reduce(0) { |value, bit| (value << 1) | bit } }
+      pad = 0
+      while data.length < data_capacity
+        data << (pad.even? ? 0xEC : 0x11)
+        pad += 1
+      end
+
+      blocks = []
+      cursor = 0
+      BLOCK_GROUPS.fetch(@version).each do |count, total_length, data_length|
+        count.times do
+          block_data = data.slice(cursor, data_length)
+          cursor += data_length
+          blocks << [ block_data, reed_solomon_remainder(block_data, total_length - data_length) ]
+        end
+      end
+
+      interleaved = []
+      max_data_length = blocks.map { |data_part, _| data_part.length }.max
+      max_data_length.times do |index|
+        blocks.each { |data_part, _| interleaved << data_part[index] if index < data_part.length }
+      end
+      max_ecc_length = blocks.map { |_, ecc_part| ecc_part.length }.max
+      max_ecc_length.times do |index|
+        blocks.each { |_, ecc_part| interleaved << ecc_part[index] if index < ecc_part.length }
+      end
+      interleaved
+    end
+
+    def append_bits(bits, value, length)
+      (length - 1).downto(0) { |index| bits << ((value >> index) & 1) }
+    end
+
+    def reed_solomon_remainder(data, degree)
+      divisor = Array.new(degree, 0)
+      divisor[-1] = 1
+      root = 1
+      degree.times do
+        (0...degree).each do |index|
+          divisor[index] = gf_multiply(divisor[index], root)
+          divisor[index] ^= divisor[index + 1] if index + 1 < degree
+        end
+        root = gf_multiply(root, 2)
+      end
+
+      remainder = data + Array.new(degree, 0)
+      data.length.times do |index|
+        factor = remainder[index]
+        next if factor.zero?
+
+        degree.times do |offset|
+          remainder[index + offset] ^= gf_multiply(divisor[offset], factor)
+        end
+      end
+      remainder.last(degree)
+    end
+
+    def gf_multiply(left, right)
+      product = 0
+      8.times do
+        product ^= left if (right & 1) != 0
+        right >>= 1
+        left <<= 1
+        left ^= 0x11D if (left & 0x100) != 0
+      end
+      product
+    end
+
+    def draw_function_patterns
+      @modules = Array.new(@size) { Array.new(@size, false) }
+      @function_modules = Array.new(@size) { Array.new(@size, false) }
+
+      draw_finder_pattern(3, 3)
+      draw_finder_pattern(3, @size - 4)
+      draw_finder_pattern(@size - 4, 3)
+
+      # Draw alignment patterns before the timing tracks. Some higher-version
+      # alignment patterns cross a timing track and take precedence over it.
+      positions = ALIGNMENT_POSITIONS.fetch(@version)
+      positions.each do |row|
+        positions.each do |column|
+          next if @function_modules[row][column] # Finder patterns and separators.
+
+          draw_alignment_pattern(row, column)
+        end
+      end
+
+      (8...(@size - 8)).each do |index|
+        value = index.even?
+        set_function_module(6, index, value) unless @function_modules[6][index]
+        set_function_module(index, 6, value) unless @function_modules[index][6]
+      end
+
+      draw_version_bits if @version >= 7
+      draw_format_bits(0) # Reserve both copies of the format-information cells.
+      set_function_module(@size - 8, 8, true)
+    end
+
+    def draw_finder_pattern(center_row, center_column)
+      (-4..4).each do |dy|
+        (-4..4).each do |dx|
+          row = center_row + dy
+          column = center_column + dx
+          next unless row.between?(0, @size - 1) && column.between?(0, @size - 1)
+
+          distance = [ dx.abs, dy.abs ].max
+          dark = distance <= 3 && (distance == 3 || distance <= 1)
+          set_function_module(row, column, dark)
+        end
+      end
+    end
+
+    def draw_alignment_pattern(center_row, center_column)
+      (-2..2).each do |dy|
+        (-2..2).each do |dx|
+          dark = [ dx.abs, dy.abs ].max != 1
+          set_function_module(center_row + dy, center_column + dx, dark)
+        end
+      end
+    end
+
+    def draw_version_bits
+      remainder = @version
+      12.times { remainder = (remainder << 1) ^ ((remainder >> 11) * 0x1F25) }
+      bits = (@version << 12) | remainder
+
+      18.times do |index|
+        bit = ((bits >> index) & 1) != 0
+        row = index / 3
+        column = @size - 11 + (index % 3)
+        set_function_module(row, column, bit)
+        set_function_module(column, row, bit)
+      end
+    end
+
+    def draw_format_bits(mask)
+      # Error correction level L uses format bits 01.
+      data = (0b01 << 3) | mask
+      remainder = data
+      10.times { remainder = (remainder << 1) ^ ((remainder >> 9) * 0x537) }
+      bits = ((data << 10) | remainder) ^ 0x5412
+
+      6.times { |index| set_function_module(index, 8, bit_set?(bits, index)) }
+      set_function_module(7, 8, bit_set?(bits, 6))
+      set_function_module(8, 8, bit_set?(bits, 7))
+      set_function_module(8, 7, bit_set?(bits, 8))
+      6.times { |index| set_function_module(8, 5 - index, bit_set?(bits, index + 9)) }
+
+      8.times { |index| set_function_module(8, @size - 1 - index, bit_set?(bits, index)) }
+      7.times { |index| set_function_module(@size - 7 + index, 8, bit_set?(bits, index + 8)) }
+      set_function_module(@size - 8, 8, true)
+    end
+
+    def bit_set?(number, index)
+      ((number >> index) & 1) != 0
+    end
+
+    def set_function_module(row, column, dark)
+      @modules[row][column] = dark
+      @function_modules[row][column] = true
+    end
+
+    def draw_codewords(codewords, mask)
+      bits = codewords.flat_map { |byte| (7).downto(0).map { |index| (byte >> index) & 1 } }
+      bit_index = 0
+      right = @size - 1
+
+      while right >= 1
+        right -= 1 if right == 6
+        @size.times do |vertical_index|
+          upward = ((right + 1) & 2).zero?
+          row = upward ? @size - 1 - vertical_index : vertical_index
+          2.times do |offset|
+            column = right - offset
+            next if @function_modules[row][column]
+
+            value = bit_index < bits.length && bits[bit_index] == 1
+            value = !value if mask_applies?(mask, row, column)
+            @modules[row][column] = value
+            bit_index += 1
+          end
+        end
+        right -= 2
+      end
+
+      raise "QR code matrix did not have enough data modules" if bit_index < bits.length
+    end
+
+    def mask_applies?(mask, row, column)
+      case mask
+      when 0 then (row + column).even?
+      when 1 then row.even?
+      when 2 then (column % 3).zero?
+      when 3 then ((row + column) % 3).zero?
+      when 4 then ((row / 2) + (column / 3)).even?
+      when 5 then ((row * column) % 2) + ((row * column) % 3) == 0
+      when 6 then (((row * column) % 2) + ((row * column) % 3)).even?
+      when 7 then (((row + column) % 2) + ((row * column) % 3)).even?
+      end
+    end
+
+    def penalty_score
+      score = 0
+      @size.times do |index|
+        score += line_penalty(@modules[index])
+        score += line_penalty(@modules.map { |row| row[index] })
+      end
+
+      (@size - 1).times do |row|
+        (@size - 1).times do |column|
+          value = @modules[row][column]
+          if value == @modules[row][column + 1] && value == @modules[row + 1][column] && value == @modules[row + 1][column + 1]
+            score += 3
+          end
+        end
+      end
+
+      dark_count = @modules.sum { |row| row.count(true) }
+      deviation = ((dark_count * 100.0 / (@size * @size)) - 50).abs
+      score + (deviation / 5).floor * 10
+    end
+
+    def line_penalty(line)
+      score = 0
+      run_color = line[0]
+      run_length = 1
+      1.upto(line.length - 1) do |index|
+        if line[index] == run_color
+          run_length += 1
+          score += 3 if run_length == 5
+          score += 1 if run_length > 5
+        else
+          run_color = line[index]
+          run_length = 1
+        end
+      end
+
+      bits = line.map { |dark| dark ? "1" : "0" }.join
+      score + bits.scan(/(?=00001011101|10111010000)/).length * 40
+    end
+  end
+end
diff --git a/test/integration/live_game_test.rb b/test/integration/live_game_test.rb
new file mode 100644
index 0000000..09d9d33
--- /dev/null
+++ b/test/integration/live_game_test.rb
@@ -0,0 +1,232 @@
+require "test_helper"
+require "base64"
+
+class LiveGameTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "test-password"
+    @auth = { "HTTP_AUTHORIZATION" => "Basic #{Base64.strict_encode64("moderator:test-password")}" }
+    @quiz = Quiz.create!(title: "Conference Quiz")
+    @first = build_question(@quiz, "Which planet is known as the red planet?", [ [ "Mars", true ], [ "Venus", false ] ])
+    build_question(@quiz, "This one is skipped", [ [ "Yes", true ], [ "No", false ] ], active: false)
+    @last = build_question(@quiz, "How many sides has a hexagon?", [ [ "Six", true ], [ "Eight", false ] ])
+  end
+
+  test "moderator creates a live game, players join and answer, and the game progresses to the end" do
+    get moderate_quiz_path(@quiz), headers: @auth
+    assert_response :success
+    assert_select "button", text: "Start a game"
+
+    assert_difference -> { Game.count }, 1 do
+      post moderate_quiz_games_path(@quiz), headers: @auth
+    end
+    game = Game.order(:id).last
+    assert_redirected_to moderate_quiz_game_path(@quiz, game)
+    assert_equal "waiting", game.status
+    assert_equal [ "Which planet is known as the red planet?", "How many sides has a hexagon?" ], game.game_questions.map(&:text)
+
+    get moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_response :success
+    assert_includes response.body, "http://www.example.com/play/#{game.join_code}"
+    assert_select ".counter-pill", text: "Players: 0"
+    assert_includes response.body, "<svg"
+    assert_select "button", text: "Start"
+
+    get play_path(game.join_code)
+    assert_response :success
+    assert_select "label", text: "Your name"
+    assert_select "input[placeholder='Your name']"
+    assert_select "input[type=submit][value='Join']"
+
+    post join_play_path(game.join_code), params: { name: "Alice" }
+    assert_redirected_to play_path(game.join_code)
+    follow_redirect!
+    assert_response :success
+    assert_includes response.body, "Hi, Alice!"
+    assert_includes response.body, "Waiting for the quiz to start"
+
+    # The signed per-game browser cookie restores the same participant.
+    get play_path(game.join_code)
+    assert_includes response.body, "Hi, Alice!"
+    assert_equal 1, game.game_players.count
+
+    patch start_moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_redirected_to moderate_quiz_game_path(@quiz, game)
+    game.reload
+    assert_equal "question_open", game.status
+    assert_equal "Which planet is known as the red planet?", game.current_game_question.text
+
+    get play_path(game.join_code)
+    assert_response :success
+    assert_includes response.body, "Question 1 of 2"
+    assert_includes response.body, "Which planet is known as the red planet?"
+    assert_includes response.body, "Mars"
+    assert_includes response.body, "Venus"
+    refute_includes response.body, "Correct</span>"
+    refute_includes response.body, "data-correct"
+
+    post answer_play_path(game.join_code), params: { option_id: game.current_game_question.game_options.first.id },
+      headers: { "HTTP_ACCEPT" => "application/json" }
+    assert_response :success
+    refute_includes response.body.downcase, "correct"
+    assert_equal 1, Answer.count
+
+    state = get_json(state_play_path(game.join_code), headers: { "HTTP_ACCEPT" => "application/json" })
+    assert_includes state.fetch("html"), "Your answer"
+    refute_includes state.fetch("html"), "Correct</span>"
+
+    screen_state = get_json(state_moderate_quiz_game_path(@quiz, game), headers: @auth.merge("HTTP_ACCEPT" => "application/json"))
+    assert_includes screen_state.fetch("html"), "Answers: <span data-live-answers-count>1</span>"
+    assert_select_in_html screen_state.fetch("html"), ".answers-counter", text: "Answers: 1 / 1"
+
+    patch finish_moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_equal "question_closed", game.reload.status
+    state = get_json(state_play_path(game.join_code), headers: { "HTTP_ACCEPT" => "application/json" })
+    assert_includes state.fetch("html"), "Correct!"
+    screen_state = get_json(state_moderate_quiz_game_path(@quiz, game), headers: @auth.merge("HTTP_ACCEPT" => "application/json"))
+    assert_includes screen_state.fetch("html"), "Correct"
+    assert_select_in_html(screen_state.fetch("html"), "button", "Next")
+
+    patch advance_moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_equal "question_open", game.reload.status
+    assert_equal "How many sides has a hexagon?", game.current_game_question.text
+    get play_path(game.join_code)
+    assert_includes response.body, "Question 2 of 2"
+
+    patch finish_moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_select_in_html(
+      get_json(state_moderate_quiz_game_path(@quiz, game), headers: @auth.merge("HTTP_ACCEPT" => "application/json")).fetch("html"),
+      "button", "End quiz"
+    )
+    patch end_quiz_moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_equal "finished", game.reload.status
+    get play_path(game.join_code)
+    assert_includes response.body, "The quiz is over"
+    get moderate_quiz_game_path(@quiz, game), headers: @auth
+    assert_includes response.body, "The quiz is over"
+  end
+
+  test "the last answer wins, results stay private until Finish, and a second game has isolated answers" do
+    first_game = Game.create_for_quiz!(@quiz)
+    player = join_as("Morgan", first_game)
+    first_question = first_game.game_questions.first
+    first_game.start!
+
+    # A question can be changed during an open round; only the last choice is scored.
+    post answer_play_path(first_game.join_code), params: { option_id: first_question.game_options.last.id },
+      headers: { "HTTP_ACCEPT" => "application/json" }
+    post answer_play_path(first_game.join_code), params: { option_id: first_question.game_options.first.id },
+      headers: { "HTTP_ACCEPT" => "application/json" }
+    assert_equal 1, Answer.where(game_player: player, game_question: first_question).count
+    assert_equal first_question.game_options.first.id,
+      Answer.find_by!(game_player: player, game_question: first_question).game_option_id
+
+    open_state = get_json(state_play_path(first_game.join_code), headers: { "HTTP_ACCEPT" => "application/json" })
+    refute_includes open_state.fetch("html"), "Correct</span>"
+    first_game.finish_question!
+    closed_state = get_json(state_play_path(first_game.join_code), headers: { "HTTP_ACCEPT" => "application/json" })
+    assert_includes closed_state.fetch("html"), "Correct!"
+
+    second_game = Game.create_for_quiz!(@quiz)
+    assert_not_equal first_game.join_code, second_game.join_code
+    assert_equal 0, second_game.game_players.count
+    assert_equal 0, second_game.game_questions.first.answers.count
+    assert_equal "waiting", second_game.status
+  end
+
+  test "active questions are snapshotted and all-inactive quizzes cannot start" do
+    game = Game.create_for_quiz!(@quiz)
+    original_text = game.game_questions.first.text
+    @first.update!(text: "Edited after the game was created", active: false)
+    game.start!
+    assert_equal original_text, game.current_game_question.text
+
+    inactive_quiz = Quiz.create!(title: "No active questions")
+    build_question(inactive_quiz, "Inactive", [ [ "A", true ], [ "B", false ] ], active: false)
+    get moderate_quiz_path(inactive_quiz), headers: @auth
+    assert_select "button[disabled]", text: "Start a game"
+    assert_raises(Game::NoActiveQuestions) { Game.create_for_quiz!(inactive_quiz) }
+  end
+
+  test "a new browser cannot join after the game is over" do
+    game = Game.create_for_quiz!(@quiz)
+    game.start!
+    game.finish_question!
+    game.advance!
+    game.finish_question!
+    game.end_quiz!
+
+    stranger = open_session
+    stranger.get play_path(game.join_code)
+    assert_response_for(stranger, :success)
+    assert_includes stranger.response.body, "The quiz is over"
+    stranger.post join_play_path(game.join_code), params: { name: "Too late" }
+    assert_equal 0, game.game_players.count
+    stranger.get play_path(game.join_code)
+    assert_includes stranger.response.body, "The quiz is over"
+    refute_includes stranger.response.body, "Your name"
+  end
+
+  test "bad moderator tokens cannot subscribe and deleting a quiz cleans up its game data" do
+    game = Game.create_for_quiz!(@quiz)
+    signed_token = Game.moderator_channel_token(game.id)
+    assert_equal game, Game.moderator_game_from_token(signed_token, game.join_code)
+    assert_nil Game.moderator_game_from_token(signed_token, "WRONG")
+    assert_nil Game.moderator_game_from_token("not-a-signed-token", game.join_code)
+    assert_nil Game.moderator_game_from_token(nil, game.join_code)
+
+    player = game.game_players.create!(name: "Delete me")
+    game.start!
+    question = game.current_game_question
+    Answer.create!(game_player: player, game_question: question, game_option: question.game_options.first)
+
+    @quiz.destroy!
+    assert_not Game.exists?(game.id)
+    assert_not GamePlayer.exists?(player.id)
+    assert_not Answer.exists?
+  end
+
+  test "a blank player name is rejected without creating a participant" do
+    game = Game.create_for_quiz!(@quiz)
+
+    post join_play_path(game.join_code), params: { name: "   " }
+
+    assert_response :unprocessable_entity
+    assert_select "[role=alert]"
+    assert_select "label", text: "Your name"
+    assert_equal 0, game.game_players.count
+  end
