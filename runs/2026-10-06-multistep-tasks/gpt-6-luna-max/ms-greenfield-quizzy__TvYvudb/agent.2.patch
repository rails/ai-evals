+<% content_for :title, "Import quiz · Quizzy" %>
+<%= render "moderate/header" %>
+
+<main class="admin-main">
+  <div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+  <div class="page-head"><h1>Import quiz</h1></div>
+
+  <div class="card">
+    <%= form_with url: moderate_quiz_import_path, method: :post do |form| %>
+      <% if @errors.present? %>
+        <div class="errors" role="alert">
+          <p>The quiz could not be imported:</p>
+          <ul>
+            <% @errors.each do |message| %>
+              <li><%= message %></li>
+            <% end %>
+          </ul>
+        </div>
+      <% end %>
+
+      <div class="field">
+        <%= form.label :quiz_json, "Quiz JSON", class: "field-label" %>
+        <%= form.text_area :quiz_json, value: @quiz_json, class: "input", rows: 18, spellcheck: false %>
+      </div>
+
+      <div class="buttons">
+        <%= button_tag "Import", type: "submit", class: "btn btn--pink" %>
+        <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+      </div>
+    <% end %>
+  </div>
+</main>
