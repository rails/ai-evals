+require "test_helper"
+
+class Autocompletable::BotsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "bots in the room appear in mention autocomplete results" do
+    bot = Bot.create!(owner: users(:david), name: "Build Bot")
+
+    get autocompletable_users_url(room_id: rooms(:hq).id, format: :json), params: { query: "Build" }
+
+    assert_response :success
+    assert_includes response.parsed_body.map { |result| result["value"] }, bot.id
+    result = response.parsed_body.find { |entry| entry["value"] == bot.id }
+    assert_equal bot.attachable_sgid, result["sgid"]
+  end
+end
diff --git a/test/controllers/bot_webhook_settings_controller_test.rb b/test/controllers/bot_webhook_settings_controller_test.rb
