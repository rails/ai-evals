@@ -0,0 +1,46 @@
+require "test_helper"
+
+class BotWebhookSettingsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+    sign_in :david
+  end
+
+  test "new and edit forms label the optional webhook URL" do
+    get new_bot_url
+
+    assert_response :success
+    assert_select "label", text: "Webhook URL"
+    assert_select "input[type='url'][name='bot[webhook_url]']"
+
+    bot = Bot.create!(owner: users(:david), name: "Deploy Bot", webhook_url: "https://hooks.example.test/deploy")
+    get edit_bot_url(bot)
+
+    assert_response :success
+    assert_select "label", text: "Webhook URL"
+    assert_select "input[type='url'][name='bot[webhook_url]'][value='https://hooks.example.test/deploy']"
+  end
+
+  test "a webhook URL can be saved and cleared" do
+    post bots_url, params: { bot: { name: "Deploy Bot", webhook_url: "https://hooks.example.test/deploy" } }
+
+    assert_redirected_to bots_url
+    bot = Bot.find_by!(name: "Deploy Bot")
+    assert_equal "https://hooks.example.test/deploy", bot.webhook_url
+
+    patch bot_url(bot), params: { bot: { webhook_url: "" } }
+
+    assert_redirected_to bots_url
+    assert_nil bot.reload.webhook_url
+  end
+
+  test "webhook URLs must use HTTP or HTTPS" do
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { name: "Deploy Bot", webhook_url: "ftp://hooks.example.test/deploy" } }
+    end
+
+    assert_response :unprocessable_entity
+    assert_select "label", text: "Webhook URL"
+    assert_includes response.body, "Webhook url is invalid"
+  end
+end
diff --git a/test/jobs/bot/webhook_job_test.rb b/test/jobs/bot/webhook_job_test.rb
new file mode 100644
index 0000000..de4bf72
--- /dev/null
+++ b/test/jobs/bot/webhook_job_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+require "restricted_http/private_network_guard"
+
+class Bot::WebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:hq)
+    @bot = Bot.create!(owner: users(:david), name: "Deploy Bot", webhook_url: webhook_url)
+    @room.memberships.find_or_create_by!(user: @bot)
+    @message = @room.messages.create!(
+      creator: users(:jason),
+      body: "<div>#{mention_attachment_for_bot(@bot)} restart the build please</div>"
+    )
+
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("hooks.example.test").returns("93.184.216.34")
+  end
+
+  test "mentions enqueue a webhook job without making a request while posting" do
+    clear_enqueued_jobs
+    message = @room.messages.create!(
+      creator: users(:jason),
+      body: "<div>#{mention_attachment_for_bot(@bot)} another command</div>"
+    )
+
+    assert_enqueued_with(job: Bot::WebhookJob, args: [ @bot.id, message.id ])
+    assert_not_requested :post, webhook_url
+  end
+
+  test "sends the mention payload and posts a 200 plain-text response as the bot" do
+    webhook_payload = nil
+    stub_request(:post, webhook_url).with do |request|
+      webhook_payload = JSON.parse(request.body)
+      request.headers["Content-Type"] == "application/json"
+    end.to_return(status: 200, body: "Build restarted", headers: { "Content-Type" => "text/plain; charset=utf-8" })
+
+    assert_difference -> { @room.messages.count }, 1 do
+      Bot::WebhookJob.perform_now(@bot.id, @message.id)
+    end
+
+    routes = Rails.application.routes.url_helpers
+    assert_equal "mention", webhook_payload["event"]
+    assert_equal({ "id" => users(:jason).id, "name" => "Jason" }, webhook_payload["author"])
+    assert_equal @room.id, webhook_payload.dig("room", "id")
+    assert_equal @room.name, webhook_payload.dig("room", "name")
+    assert_equal routes.bot_room_messages_path(@room.id, @bot.bot_code), webhook_payload.dig("room", "reply_to")
+    assert_equal @message.id, webhook_payload.dig("message", "id")
+    assert_equal "restart the build please", webhook_payload.dig("message", "body", "text")
+    assert_includes webhook_payload.dig("message", "body", "html"), "restart the build please"
+    assert_includes webhook_payload.dig("message", "body", "html"), @bot.name
+    assert_equal routes.room_at_message_path(@room, @message), webhook_payload.dig("message", "link")
+
+    reply = @room.messages.where(creator: @bot).order(:id).last
+    assert_equal "Build restarted", reply.plain_text_body
+    assert_equal @bot, reply.creator
+  end
+
+  test "posts a 200 HTML response but ignores 204 and non-text responses" do
+    stub_request(:post, webhook_url).to_return(
+      { status: 200, body: "<div>Build <strong>restarted</strong></div>", headers: { "Content-Type" => "text/html; charset=utf-8" } },
+      { status: 204 },
+      { status: 200, body: "{\"ok\":true}", headers: { "Content-Type" => "application/json" } }
+    )
+
+    assert_difference -> { @room.messages.count }, 1 do
+      Bot::WebhookJob.perform_now(@bot.id, @message.id)
+    end
+    reply = @room.messages.where(creator: @bot).order(:id).last
+    assert_equal "Build restarted", reply.plain_text_body
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot.id, @message.id)
+      Bot::WebhookJob.perform_now(@bot.id, @message.id)
+    end
+  end
+
+  test "text/plain responses are posted as literal text" do
+    stub_request(:post, webhook_url).to_return(
+      status: 200,
+      body: "<strong>literal text</strong>",
+      headers: { "Content-Type" => "text/plain; charset=utf-8" }
+    )
+
+    Bot::WebhookJob.perform_now(@bot.id, @message.id)
+
+    reply = @room.messages.where(creator: @bot).order(:id).last
+    assert_equal "<strong>literal text</strong>", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "&lt;strong&gt;literal text&lt;/strong&gt;"
+  end
+
+  test "an already-mentioned bot still receives its webhook after leaving the room" do
+    @room.memberships.find_by!(user: @bot).destroy!
+    stub_request(:post, webhook_url).to_return(status: 204)
+
+    Bot::WebhookJob.perform_now(@bot.id, @message.id)
+
+    assert_requested :post, webhook_url
+  end
+
+test "webhook delivery does not connect to private network addresses" do
+  RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve)
+    .with("hooks.example.test")
+    .raises(RestrictedHTTP::Violation)
+
+  Bot::WebhookJob.perform_now(@bot.id, @message.id)
+
+  assert_not_requested :post, webhook_url
+end
+
+  test "a bot without a configured webhook does not enqueue a job" do
+    @bot.update!(webhook_url: nil)
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      @room.messages.create!(
+        creator: users(:jason),
+        body: "<div>#{mention_attachment_for_bot(@bot)} no callback</div>"
+      )
+    end
+  end
+
+  private
+    def webhook_url
+      "https://hooks.example.test/deploy?secret=token"
+    end
+
+    def mention_attachment_for_bot(bot)
+      content = ApplicationController.render(partial: "users/mention", locals: { user: bot })
+      %(<action-text-attachment sgid="#{bot.attachable_sgid}" content-type="application/vnd.campfire.mention" content="#{content.gsub('"', '&quot;')}"></action-text-attachment>)
+    end
+end
