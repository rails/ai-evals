diff --git a/app/jobs/bot/webhook_job.rb b/app/jobs/bot/webhook_job.rb
new file mode 100644
index 0000000..dc0e581
--- /dev/null
+++ b/app/jobs/bot/webhook_job.rb
@@ -0,0 +1,98 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class Bot::WebhookJob < ApplicationJob
+  OPEN_TIMEOUT = 2
+  READ_TIMEOUT = 5
+  WRITE_TIMEOUT = 5
+
+  def perform(bot_id, message_id)
+    bot = Bot.find_by(id: bot_id)
+    message = Message.find_by(id: message_id)
+    return unless bot&.webhook_url.present? && message
+
+    response = send_webhook(bot, message)
+    return unless response&.code == "200"
+    return unless response.content_type.to_s.downcase.in?(%w[ text/plain text/html ])
+
+    reply_body = message_body_for(response)
+    return unless reply_body
+    return unless message.room.memberships.exists?(user: bot)
+
+    reply = message.room.messages.create!(creator: bot, body: reply_body)
+    reply.broadcast_create
+  end
+
+  private
+    def send_webhook(bot, message)
+      uri = URI.parse(bot.webhook_url)
+      return unless uri.is_a?(URI::HTTP) && uri.host.present?
+
+      ip = RestrictedHTTP::PrivateNetworkGuard.resolve(uri.host)
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request["Content-Type"] = "application/json"
+      request.body = JSON.generate(payload_for(bot, message))
+
+      Net::HTTP.start(
+        uri.host, uri.port,
+        ipaddr: ip,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT,
+        write_timeout: WRITE_TIMEOUT
+      ) do |http|
+        http.request(request)
+      end
+    rescue StandardError => error
+      Rails.logger.warn "Bot webhook delivery failed for bot #{bot.id}: #{error.class} #{error.message}"
+      nil
+    end
+
+    def message_body_for(response)
+      charset = response.type_params["charset"].presence || "UTF-8"
+      body = response.body.to_s.dup.force_encoding(Encoding.find(charset)).encode(Encoding::UTF_8)
+      return if body.blank?
+
+      if response.content_type.to_s.casecmp?("text/plain")
+        ERB::Util.html_escape(body).to_s.gsub(/\r\n?|\n/, "<br>")
+      else
+        body
+      end
+    rescue ArgumentError, EncodingError
+      nil
+    end
+
+    def payload_for(bot, message)
+      routes = Rails.application.routes.url_helpers
+
+      {
+        event: "mention",
+        author: {
+          id: message.creator_id,
+          name: message.creator.name
+        },
+        room: {
+          id: message.room_id,
+          name: message.room.name,
+          reply_to: routes.bot_room_messages_path(message.room_id, bot.bot_code)
+        },
+        message: {
+          id: message.id,
+          body: {
+            text: text_without_bot_mention(message, bot),
+            html: message.body.body.to_html
+          },
+          link: routes.room_at_message_path(message.room, message)
+        }
+      }
+    end
+
+    def text_without_bot_mention(message, bot)
+      content = ActionText::Content.new(message.body.body.to_html)
+      content.fragment.find_all(ActionText::Attachment.tag_name).each do |attachment|
+        attachment.remove if attachment["sgid"] == bot.attachable_sgid
+      end
+
+      ActionText::Content.new(content.fragment.to_html).to_plain_text.strip
+    end
+end
diff --git a/app/models/bot.rb b/app/models/bot.rb
