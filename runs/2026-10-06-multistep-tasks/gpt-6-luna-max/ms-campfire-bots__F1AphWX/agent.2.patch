@@ -3,13 +3,28 @@ class Bot < User
 
   before_validation :generate_bot_code, on: :create
   before_validation :generate_password, on: :create
+  before_validation :clear_blank_webhook_url
 
   validates :name, presence: true
   validates :bot_code, presence: true, uniqueness: true
+  validate :webhook_url_must_be_http
 
   scope :ordered, -> { order("LOWER(name)") }
 
   private
+    def clear_blank_webhook_url
+      self.webhook_url = nil if webhook_url.blank?
+    end
+
+    def webhook_url_must_be_http
+      return if webhook_url.blank?
+
+      uri = URI.parse(webhook_url)
+      errors.add(:webhook_url, :invalid) unless uri.is_a?(URI::HTTP) && uri.host.present?
+    rescue URI::InvalidURIError
+      errors.add(:webhook_url, :invalid)
+    end
+
     def generate_bot_code
       self.bot_code = SecureRandom.hex(32) if bot_code.blank?
     end
