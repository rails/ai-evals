diff --git a/app/models/concerns/profile_image_storage.rb b/app/models/concerns/profile_image_storage.rb
new file mode 100644
index 0000000..232e5b4
--- /dev/null
+++ b/app/models/concerns/profile_image_storage.rb
@@ -0,0 +1,138 @@
+# Shares a staged Active Storage rollout between users and organizations. The
+# CarrierWave `profile_image` column remains the source for existing images;
+# assignments of new files are stored under a separate attachment name.
+module ProfileImageStorage
+  extend ActiveSupport::Concern
+
+  included do
+    has_one_attached :active_storage_profile_image, dependent: :purge_later
+
+    before_save :track_active_storage_profile_image_change
+    validate :validate_profile_image_upload
+    after_commit :cleanup_profile_image_upload, on: %i[create update]
+    after_rollback :cleanup_profile_image_upload
+  end
+
+  def serializable_hash(options = nil)
+    serialized = super(options)
+    serialized["profile_image"] = profile_image_url if serialized.key?("profile_image")
+    serialized.except("profile_image_in_active_storage")
+  end
+
+  def profile_image=(image)
+    if profile_image_file_upload?(image)
+      @profile_image_remote_url = nil
+      @profile_image_upload_error = nil
+      uploader = ProfileImageUploader.new(self, :profile_image)
+      uploader.cache!(image)
+      attach_processed_profile_image(uploader)
+    else
+      super
+    end
+  rescue CarrierWave::IntegrityError, CarrierWave::ProcessingError => e
+    @profile_image_upload_error = e
+  end
+
+  # Keep the CarrierWave remote URL API used by OAuth providers, but transfer
+  # its safely downloaded/processed file to Active Storage rather than saving
+  # its temporary identifier over a user's existing CarrierWave column value.
+  def remote_profile_image_url=(url)
+    legacy_profile_image = self[:profile_image]
+    @profile_image_remote_url = url
+    @profile_image_upload_error = nil
+
+    super
+
+    uploader = profile_image
+    if uploader.cached? && uploader.file.present?
+      attach_processed_profile_image(uploader)
+    else
+      @profile_image_upload_error = profile_image_integrity_error ||
+        profile_image_processing_error || profile_image_download_error
+    end
+  rescue CarrierWave::IntegrityError, CarrierWave::ProcessingError => e
+    @profile_image_upload_error = e
+  ensure
+    self[:profile_image] = legacy_profile_image if defined?(legacy_profile_image)
+    @_mounters&.delete(:profile_image)
+  end
+
+  def remote_profile_image_url
+    @profile_image_remote_url || super
+  end
+
+  def profile_image_url(*args)
+    if active_storage_profile_image_attached?
+      Rails.application.routes.url_helpers.rails_blob_path(
+        active_storage_profile_image.blob,
+        only_path: true,
+      )
+    else
+      super
+    end
+  end
+
+  def active_storage_profile_image_attached?
+    if attachment_changes.key?("active_storage_profile_image") && active_storage_profile_image.attached?
+      return true
+    end
+    return false if has_attribute?(:profile_image_in_active_storage) && !self[:profile_image_in_active_storage]
+
+    active_storage_profile_image.attached?
+  end
+
+  def profile_image_present?
+    profile_image.present? || active_storage_profile_image_attached?
+  end
+
+  def profile_image_storage_changed?
+    !!@profile_image_storage_changed
+  end
+
+  private
+
+  def profile_image_file_upload?(image)
+    image.present? && !image.is_a?(String) &&
+      (image.respond_to?(:read) || image.respond_to?(:tempfile) || image.is_a?(Pathname))
+  end
+
+  def attach_processed_profile_image(uploader)
+    cleanup_profile_image_upload
+
+    processed_file = uploader.file
+    io = processed_file.to_file
+    return unless io
+
+    self.active_storage_profile_image = {
+      io: io,
+      filename: uploader.filename || processed_file.original_filename,
+      content_type: processed_file.content_type
+    }
+    @profile_image_upload_uploader = uploader
+    @profile_image_upload_io = io
+  end
+
+  def validate_profile_image_upload
+    return unless @profile_image_upload_error
+
+    errors.add(:profile_image, message: @profile_image_upload_error.message)
+  end
+
+  def track_active_storage_profile_image_change
+    @profile_image_storage_changed = attachment_changes.key?("active_storage_profile_image")
+    return unless @profile_image_storage_changed
+
+    if has_attribute?(:profile_image_in_active_storage)
+      self.profile_image_in_active_storage = active_storage_profile_image.attached?
+    end
+    self.profile_updated_at = Time.current if has_attribute?(:profile_updated_at)
+  end
+
+  def cleanup_profile_image_upload
+    @profile_image_upload_io&.close unless @profile_image_upload_io&.closed?
+    @profile_image_upload_uploader&.remove!
+  ensure
+    @profile_image_upload_io = nil
+    @profile_image_upload_uploader = nil
+  end
+end
