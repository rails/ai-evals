+# Active Storage shares the production upload bucket and credential sources
+# used by CarrierWave, but stores profile pictures in its own key namespace.
+amazon:
+  service: S3
+<% if ENV["AWS_ID"].present? %>
+  access_key_id: <%= ENV["AWS_ID"] %>
+  secret_access_key: <%= ENV["AWS_SECRET"] %>
+<% end %>
+  region: <%= ENV["FOREM_CONTEXT"] == "forem_cloud" ? "us-east-2" : (ENV["AWS_UPLOAD_REGION"].presence || ENV["AWS_DEFAULT_REGION"].presence || "us-east-1") %>
+  bucket: <%= ENV["AWS_BUCKET_NAME"] %>
