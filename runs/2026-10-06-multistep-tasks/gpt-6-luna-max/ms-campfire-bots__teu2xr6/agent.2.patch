diff --git a/app/jobs/bot/mention_webhook_job.rb b/app/jobs/bot/mention_webhook_job.rb
new file mode 100644
index 0000000..d3bbc8f
--- /dev/null
+++ b/app/jobs/bot/mention_webhook_job.rb
@@ -0,0 +1,85 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class Bot::MentionWebhookJob < ApplicationJob
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 5
+  WRITE_TIMEOUT = 5
+
+  def perform(bot_id, message_id)
+    bot = Bot.find_by(id: bot_id)
+    message = Message.find_by(id: message_id)
+    return unless bot && message && bot.webhook_url.present?
+
+    uri = URI.parse(bot.webhook_url)
+    return unless uri.is_a?(URI::HTTP) && uri.host.present?
+
+    ip = RestrictedHTTP::PrivateNetworkGuard.resolve(uri.host)
+    response = post_webhook(uri, ip, payload_for(bot, message))
+    post_reply(bot, message.room, response)
+  rescue StandardError => error
+    Rails.logger.warn "Bot webhook delivery failed for bot #{bot_id}: #{error.class}"
+  end
+
+  private
+    def post_webhook(uri, ip, payload)
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request["Content-Type"] = "application/json"
+      request.body = payload.to_json
+
+      Net::HTTP.start(
+        uri.host,
+        uri.port,
+        ipaddr: ip,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT,
+        write_timeout: WRITE_TIMEOUT
+      ) do |http|
+        http.request(request)
+      end
+    end
+
+    def payload_for(bot, message)
+      room = message.room
+      routes = Rails.application.routes.url_helpers
+
+      {
+        event: "mention",
+        author: { id: message.creator.id, name: message.creator.name },
+        room: {
+          id: room.id,
+          name: room.name,
+          reply_to: routes.bot_messages_path(room, bot.bot_code)
+        },
+        message: {
+          id: message.id,
+          body: {
+            text: message.plain_text_body_without(bot),
+            html: message.body.body.to_html
+          },
+          link: routes.room_at_message_path(room, message)
+        }
+      }
+    end
+
+    def post_reply(bot, room, response)
+      return unless response.code == "200"
+
+      content_type = response["Content-Type"].to_s.split(";", 2).first.to_s.strip.downcase
+      return unless %w[text/plain text/html].include?(content_type)
+
+      body = response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+      return if body.blank? || !room.memberships.exists?(user: bot)
+
+      message_body = content_type == "text/plain" ? plain_text_as_html(body) : body
+      reply = room.messages.create!(creator: bot, body: message_body)
+      reply.broadcast_create
+    end
+
+    def plain_text_as_html(text)
+      text.split(/\r\n|\r|\n/, -1).map do |line|
+        "<div>#{ERB::Util.html_escape(line)}</div>"
+      end.join
+    end
+end
