diff --git a/test/jobs/bot/mention_webhook_job_test.rb b/test/jobs/bot/mention_webhook_job_test.rb
new file mode 100644
index 0000000..5009e16
--- /dev/null
+++ b/test/jobs/bot/mention_webhook_job_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class Bot::MentionWebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:hq)
+    @author = users(:david)
+    @bot = Bot.create!(
+      name: "Deploy Bot",
+      owner: @author,
+      password: "random password",
+      webhook_url: "https://webhook.example.test/callback"
+    )
+    Resolv.stubs(:getaddresses).with("webhook.example.test").returns([ "93.184.216.34" ])
+  end
+
+  test "posts a mention payload and does not post a message for a 204 response" do
+    message = mention_message
+    payload = nil
+
+    WebMock.stub_request(:post, @bot.webhook_url).with do |request|
+      payload = JSON.parse(request.body)
+      request.headers["Content-Type"] == "application/json"
+    end.to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      Bot::MentionWebhookJob.perform_now(@bot.id, message.id)
+    end
+
+    assert_equal "mention", payload.fetch("event")
+    assert_equal({ "id" => @author.id, "name" => @author.name }, payload.fetch("author"))
+    assert_equal({
+      "id" => @room.id,
+      "name" => @room.name,
+      "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages"
+    }, payload.fetch("room"))
+    assert_equal message.id, payload.dig("message", "id")
+    assert_equal "Please take care of the @Deploy Bot integration", payload.dig("message", "body", "text")
+    assert_match %r{<action-text-attachment}, payload.dig("message", "body", "html")
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", payload.dig("message", "link")
+    assert_requested :post, @bot.webhook_url, times: 1
+  end
+
+  test "posts a text/plain 200 response as a message by the bot" do
+    mention = mention_message
+    WebMock.stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: "Build restarted", headers: { "Content-Type" => "text/plain; charset=utf-8" })
+
+    assert_difference -> { Message.count }, 1 do
+      Bot::MentionWebhookJob.perform_now(@bot.id, mention.id)
+    end
+
+    reply = Message.order(:created_at).last
+    assert_equal @bot, reply.creator
+    assert_equal @room, reply.room
+    assert_equal "Build restarted", reply.plain_text_body
+  end
+
+  test "preserves HTML-looking text in a text/plain response" do
+    mention = mention_message
+    response_body = "Build <b>restarted</b>\nNext"
+    WebMock.stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: response_body, headers: { "Content-Type" => "text/plain" })
+
+    Bot::MentionWebhookJob.perform_now(@bot.id, mention.id)
+
+    assert_equal response_body, Message.order(:created_at).last.plain_text_body
+  end
+
+  test "posts a text/html 200 response as a rich text bot message" do
+    mention = mention_message
+    WebMock.stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: "<div><strong>Build restarted</strong></div>", headers: { "Content-Type" => "text/html" })
+
+    assert_difference -> { Message.count }, 1 do
+      Bot::MentionWebhookJob.perform_now(@bot.id, mention.id)
+    end
+
+    reply = Message.order(:created_at).last
+    assert_equal @bot, reply.creator
+    assert_equal "Build restarted", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "<strong>Build restarted</strong>"
+  end
+
+  test "ignores 200 responses with unsupported content types" do
+    mention = mention_message
+    WebMock.stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: "Nope", headers: { "Content-Type" => "application/json" })
+
+    assert_no_difference -> { Message.count } do
+      Bot::MentionWebhookJob.perform_now(@bot.id, mention.id)
+    end
+  end
+
+  test "ignores 200 responses with an empty body" do
+    mention = mention_message
+    WebMock.stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: "", headers: { "Content-Type" => "text/plain" })
+
+    assert_no_difference -> { Message.count } do
+      Bot::MentionWebhookJob.perform_now(@bot.id, mention.id)
+    end
+  end
+
+  test "does not post a reply after the bot has left the room" do
+    mention = mention_message
+    WebMock.stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: "Build restarted", headers: { "Content-Type" => "text/plain" })
+    @bot.memberships.destroy_by(room: @room)
+
+    assert_no_difference -> { Message.count } do
+      Bot::MentionWebhookJob.perform_now(@bot.id, mention.id)
+    end
+  end
+
+  private
+    def mention_message
+      @room.messages.create!(
+        creator: @author,
+        body: "<div>#{bot_mention_attachment} Please take care of the @Deploy Bot integration</div>",
+        client_message_id: "webhook-mention-#{SecureRandom.hex(4)}"
+      )
+    end
+
+    def bot_mention_attachment
+      attachment_body = ApplicationController.render partial: "users/mention", locals: { user: @bot }
+      %(<action-text-attachment sgid="#{@bot.attachable_sgid}" content-type="application/vnd.campfire.mention" content="#{attachment_body.gsub('"', '&quot;')}"></action-text-attachment>)
+    end
+end
