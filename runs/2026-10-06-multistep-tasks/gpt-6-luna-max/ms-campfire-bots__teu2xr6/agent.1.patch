diff --git a/app/controllers/bot_messages_controller.rb b/app/controllers/bot_messages_controller.rb
new file mode 100644
index 0000000..77da529
--- /dev/null
+++ b/app/controllers/bot_messages_controller.rb
@@ -0,0 +1,21 @@
+class BotMessagesController < ApplicationController
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    room = Room.find_by(id: params[:room_id])
+    return head :not_found unless room
+
+    bot = Bot.active.find_by(bot_code: params[:bot_code])
+    return head :unauthorized unless bot
+    return head :not_found unless room.memberships.exists?(user: bot)
+
+    body = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+    return head :unprocessable_content if body.blank?
+
+    message = room.messages.create!(creator: bot, body: body)
+    message.broadcast_create
+
+    head :created, location: message_path(message)
+  end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..6f20708
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,51 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = bot_scope.ordered
+  end
+
+  def new
+    @bot = Bot.new
+  end
+
+  def create
+    @bot = Current.user.bots.new(bot_params)
+
+    if @bot.save
+      redirect_to bots_url, notice: "Chat bot created."
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url, notice: "Chat bot updated."
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.destroy
+    redirect_to bots_url, notice: "Chat bot deleted."
+  end
+
+  private
+    def set_bot
+      @bot = bot_scope.find_by(id: params[:id])
+      head :not_found unless @bot
+    end
+
+    def bot_scope
+      Current.user.administrator? ? Bot.all : Current.user.bots
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
