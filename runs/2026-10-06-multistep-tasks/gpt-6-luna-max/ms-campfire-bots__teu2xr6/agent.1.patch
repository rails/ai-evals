diff --git a/test/controllers/bot_messages_controller_test.rb b/test/controllers/bot_messages_controller_test.rb
new file mode 100644
index 0000000..8f661d5
--- /dev/null
+++ b/test/controllers/bot_messages_controller_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class BotMessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", owner: users(:david), password: "random password")
+    @room = rooms(:hq)
+  end
+
+  test "posting a raw request body creates and broadcasts a message with the bot as author" do
+    body = "Deploy of v1.2.3 finished ✅"
+
+    assert_enqueued_jobs 1, only: Room::PushMessageJob do
+      assert_difference -> { Message.count }, 1 do
+        post bot_messages_url(@room, @bot.bot_code), params: body, headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+      end
+    end
+
+    message = Message.order(:created_at).last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal body.dup.force_encoding(Encoding::UTF_8), message.plain_text_body
+    assert_equal @bot, message.creator
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author", text: "Deploy Bot"
+    end
+  end
+
+  test "invalid room id returns an empty 404 response" do
+    post bot_messages_url("missing", @bot.bot_code), params: "Hello", headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :not_found
+    assert_empty response.body
+  end
+
+  test "invalid bot code returns an empty 401 response" do
+    post bot_messages_url(@room, "invalid-code"), params: "Hello", headers: { "CONTENT_TYPE" => "text/plain" }
+
+    assert_response :unauthorized
+    assert_empty response.body
+  end
+
+  test "empty body returns an empty 422 response without creating a message" do
+    assert_no_difference -> { Message.count } do
+      post bot_messages_url(@room, @bot.bot_code), params: "", headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :unprocessable_content
+    assert_empty response.body
+  end
+
+  test "a bot cannot post to a room it has not joined" do
+    private_room = rooms(:designers)
+    @bot.memberships.destroy_by(room: private_room)
+
+    assert_no_difference -> { Message.count } do
+      post bot_messages_url(private_room, @bot.bot_code), params: "Hello", headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :not_found
+  end
+
+  test "deleted bot codes cannot post messages" do
+    bot_code = @bot.bot_code
+    @bot.destroy!
+
+    assert_no_difference -> { Message.count } do
+      post bot_messages_url(@room, bot_code), params: "Hello", headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :unauthorized
+  end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..df70c94
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "account settings links to bot setup" do
+    get edit_account_url
+
+    assert_response :success
+    assert_select "a[aria-label='Set up chat bots'][href='#{bots_path}']"
+  end
+
+  test "creating a bot assigns its owner and joins every open room" do
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+
+    bot = Bot.order(:created_at).last
+    assert_equal users(:david), bot.owner
+    assert bot.bot_code.present?
+    assert bot.password_digest.present?
+    assert_equal Rooms::Open.ids.sort, bot.rooms.opens.ids.sort
+    assert_redirected_to bots_url
+  end
+
+  test "a non-admin member can create and edit their own bot" do
+    sign_in :kevin
+
+    post bots_url, params: { bot: { name: "Build Bot" } }
+
+    bot = Bot.order(:created_at).last
+    assert_equal users(:kevin), bot.owner
+    assert_redirected_to bots_url
+
+    patch bot_url(bot), params: { bot: { name: "Deploy Bot" } }
+    assert_equal "Deploy Bot", bot.reload.name
+    assert_redirected_to bots_url
+  end
+
+  test "a bot can have an optional avatar" do
+    post bots_url, params: { bot: { name: "Avatar Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+
+    assert_response :redirect
+    assert Bot.order(:created_at).last.avatar.attached?
+  end
+
+  test "new and edit forms have the required labels and delete confirmation" do
+    bot = Bot.create!(name: "Deploy Bot", owner: users(:david), password: "random password")
+
+    get new_bot_url
+    assert_response :success
+    assert_select "input[placeholder='Name the bot'][required]"
+    assert_select "button", text: /Save changes/
+
+    get edit_bot_url(bot)
+    assert_response :success
+    assert_select "button", text: "Delete this chat bot" do |buttons|
+      assert_equal "Are you sure you want to delete this chat bot?", buttons.first["data-turbo-confirm"]
+    end
+  end
+
+  test "bot list shows an owner's bots and read-only bot codes" do
+    bot = Bot.create!(name: "Deploy Bot", owner: users(:david), password: "random password")
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li" do |items|
+      item = items.find { |element| element.text.include?("Deploy Bot") }
+      assert item, "Expected the bot and its code in one list item"
+      assert_select item, "input[readonly][value='#{bot.bot_code}']"
+      assert_select item, "a[href='#{edit_bot_path(bot)}']", text: "Edit Deploy Bot"
+    end
+  end
+
+  test "members only see their own bots while administrators see all bots" do
+    sign_in :kevin
+    bot = Bot.create!(name: "JZ's Bot", owner: users(:jz), password: "random password")
+
+    get bots_url
+    assert_select "li", text: /JZ's Bot/, count: 0
+
+    sign_in :david
+    get bots_url
+    assert_select "li", text: /JZ's Bot/
+  end
+
+  test "only a bot owner or administrator can edit or delete a bot" do
+    bot = Bot.create!(name: "JZ's Bot", owner: users(:jz), password: "random password")
+    sign_in :kevin
+
+    get edit_bot_url(bot)
+    assert_response :not_found
+
