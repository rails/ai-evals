diff --git a/test/jobs/bot/webhook_job_test.rb b/test/jobs/bot/webhook_job_test.rb
new file mode 100644
index 0000000..640162a
--- /dev/null
+++ b/test/jobs/bot/webhook_job_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+require "restricted_http/private_network_guard"
+
+class Bot::WebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @webhook_url = "https://hooks.example.com/campfire"
+    @bot = Bot.create!(owner: users(:david), name: "Deploy Bot", webhook_url: @webhook_url)
+    @room = rooms(:hq)
+    @message = @room.messages.create!(
+      creator: users(:jason),
+      body: "<div>#{mention_attachment_for_user(@bot)} restart the build; then notify @Deploy Bot</div>"
+    )
+
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("hooks.example.com").returns("93.184.216.34")
+  end
+
+  test "posts mention payload and sends a plain-text webhook response as the bot" do
+    request_payload = nil
+    stub_request(:post, @webhook_url)
+      .with(headers: { "Content-Type" => "application/json" }) do |request|
+        request_payload = JSON.parse(request.body)
+        true
+      end
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "Build <strong>restarted</strong> & done")
+
+    assert_difference -> { @room.messages.count }, 1 do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+
+    assert_equal "mention", request_payload.fetch("event")
+    assert_equal({ "id" => users(:jason).id, "name" => "Jason" }, request_payload.fetch("author"))
+    assert_equal({
+      "id" => @room.id,
+      "name" => @room.name,
+      "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages"
+    }, request_payload.fetch("room"))
+    assert_equal @message.id, request_payload.dig("message", "id")
+    assert_equal "restart the build; then notify @Deploy Bot", request_payload.dig("message", "body", "text")
+    assert_equal @message.body.body.to_html, request_payload.dig("message", "body", "html")
+    assert_equal "/rooms/#{@room.id}/@#{@message.id}", request_payload.dig("message", "link")
+    assert_requested :post, @webhook_url, times: 1
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Build <strong>restarted</strong> & done", reply.plain_text_body
+    assert_not_includes reply.body.body.to_html, "<strong>restarted</strong>"
+  end
+
+  test "creating a mention enqueues delivery without making the HTTP request inline" do
+    stub_request(:post, @webhook_url).to_return(status: 204)
+    message = nil
+
+    assert_enqueued_jobs 1, only: [ Bot::WebhookJob ] do
+      message = @room.messages.create!(
+        creator: users(:jason),
+        body: "<div>#{mention_attachment_for_user(@bot)} rerun the build</div>"
+      )
+    end
+
+    assert_not_requested :post, @webhook_url
+    assert_equal @room, message.room
+  end
+
+  test "posts a text/html response as rich text" do
+    stub_request(:post, @webhook_url)
+      .to_return(status: 200, headers: { "Content-Type" => "text/html; charset=utf-8" }, body: "<div><strong>Build restarted</strong></div>")
+
+    assert_difference -> { @room.messages.count }, 1 do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.body.to_html, "<strong>Build restarted</strong>"
+  end
+
+  test "a 204 webhook response does not post a message" do
+    stub_request(:post, @webhook_url).to_return(status: 204)
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+  end
+
+  test "does not post a response after the bot loses room access" do
+    @bot.memberships.find_by!(room: @room).destroy!
+    stub_request(:post, @webhook_url)
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "No longer allowed")
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+  end
+
+  test "a response with an unsupported content type does not post a message" do
+    stub_request(:post, @webhook_url)
+      .to_return(status: 200, headers: { "Content-Type" => "application/json" }, body: "{\"message\":\"ignored\"}")
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookJob.perform_now(@bot, @message)
+    end
+  end
+end
