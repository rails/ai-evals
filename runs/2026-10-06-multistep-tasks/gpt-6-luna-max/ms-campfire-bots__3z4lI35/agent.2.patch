diff --git a/app/models/bot/webhook.rb b/app/models/bot/webhook.rb
new file mode 100644
index 0000000..114e6d7
--- /dev/null
+++ b/app/models/bot/webhook.rb
@@ -0,0 +1,104 @@
+require "json"
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class Bot::Webhook
+  RESPONSE_CONTENT_TYPES = %w[ text/plain text/html ].freeze
+  OPEN_TIMEOUT = 2
+  READ_TIMEOUT = 5
+  WRITE_TIMEOUT = 5
+
+  def initialize(bot:, message:)
+    @bot, @message = bot, message
+  end
+
+  def deliver
+    return if bot.webhook_url.blank?
+
+    uri = URI.parse(bot.webhook_url)
+    return unless valid_webhook_uri?(uri)
+
+    response = Net::HTTP.start(
+      uri.host, uri.port,
+      ipaddr: RestrictedHTTP::PrivateNetworkGuard.resolve(uri.host),
+      use_ssl: uri.is_a?(URI::HTTPS),
+      open_timeout: OPEN_TIMEOUT,
+      read_timeout: READ_TIMEOUT,
+      write_timeout: WRITE_TIMEOUT
+    ) do |http|
+      http.request(request_for(uri))
+    end
+
+    post_response(response)
+  rescue URI::InvalidURIError, RestrictedHTTP::Violation, Surfguard::Unresolvable,
+         Net::HTTPError, Net::OpenTimeout, Net::ReadTimeout, SocketError, SystemCallError,
+         IOError, Timeout::Error, OpenSSL::SSL::SSLError => error
+    Rails.logger.warn "Bot webhook delivery failed for bot #{bot.id}: #{error.class}: #{error.message}"
+  end
+
+  private
+    attr_reader :bot, :message
+
+    def valid_webhook_uri?(uri)
+      uri.is_a?(URI::HTTP) && uri.host.present? && uri.port.between?(1, 65_535)
+    end
+
+    def request_for(uri)
+      Net::HTTP::Post.new(uri).tap do |request|
+        request["Content-Type"] = "application/json"
+        request["Accept"] = "text/plain, text/html"
+        request.body = JSON.generate(payload)
+      end
+    end
+
+    def payload
+      {
+        event: "mention",
+        author: {
+          id: message.creator.id,
+          name: message.creator.name
+        },
+        room: {
+          id: message.room.id,
+          name: message.room.name,
+          reply_to: Rails.application.routes.url_helpers.bot_messages_path(
+            room_id: message.room.id,
+            bot_code: bot.bot_code
+          )
+        },
+        message: {
+          id: message.id,
+          body: {
+            text: text_without_bot_mention,
+            html: message.body.body.to_html
+          },
+          link: Rails.application.routes.url_helpers.room_at_message_path(message.room, message.id)
+        }
+      }
+    end
+
+    def text_without_bot_mention
+      fragment = message.body.body.fragment.update do |source|
+        source.css("#{ActionText::Attachment.tag_name}[sgid]").each do |node|
+          node.remove if node["sgid"] == bot.attachable_sgid
+        end
+      end
+
+      ActionText::Content.new(fragment, canonicalize: false).to_plain_text.strip
+    end
+
+    def post_response(response)
+      return unless response.code == "200"
+      return unless bot.active? && message.room.memberships.exists?(user_id: bot.id)
+
+      content_type = response["Content-Type"].to_s.split(";", 2).first.to_s.strip.downcase
+      return unless RESPONSE_CONTENT_TYPES.include?(content_type)
+
+      body = response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+      return if body.blank?
+
+      body = ERB::Util.html_escape(body) if content_type == "text/plain"
+      reply = message.room.messages.create!(creator: bot, body: body)
+      reply.broadcast_create
+    end
+end
