+module Message::BotWebhooks
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :enqueue_mentioned_bot_webhooks
+  end
+
+  private
+    def enqueue_mentioned_bot_webhooks
+      return if creator.is_a?(Bot)
+
+      mentionees.each do |mentionee|
+        next unless mentionee.is_a?(Bot) && mentionee.webhook_url.present?
+
+        Bot::WebhookJob.perform_later(mentionee, self)
+      end
+    end
+end
