new file mode 100644
index 0000000..a72eb4d
--- /dev/null
+++ b/app/controllers/bot_messages_controller.rb
@@ -0,0 +1,32 @@
+class BotMessagesController < ApplicationController
+  skip_before_action :require_authentication
+  skip_forgery_protection
+
+  before_action :set_bot
+  before_action :set_room
+
+  def create
+    body = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+
+    if body.blank?
+      head :unprocessable_entity
+    else
+      @message = @room.messages.create!(creator: @bot, body: body)
+      @message.broadcast_create
+
+      head :created, location: message_path(@message.id)
+    end
+  end
+
+  private
+    def set_bot
+      @bot = Bot.active.find_by(bot_code: params[:bot_code])
+      head :unauthorized unless @bot
+    end
+
+    def set_room
+      @room = Room.find_by(id: params[:room_id])
+      return head :not_found unless @room
+      head :not_found unless @bot.memberships.exists?(room_id: @room.id)
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..4555e99
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,51 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = bots_scope.ordered.includes(:avatar_attachment)
+  end
+
+  def new
+    @bot = Bot.new
+  end
+
+  def create
+    @bot = Current.user.bots.build(bot_params)
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @bot.destroy
+    redirect_to bots_url
+  end
+
+  private
+    def set_bot
+      @bot = bots_scope.find_by(id: params[:id])
+      head :not_found unless @bot
+    end
+
+    def bots_scope
+      Current.user.administrator? ? Bot.all : Current.user.bots
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..0e3b87e
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,18 @@
+class Bot < User
+  belongs_to :owner, class_name: "User", inverse_of: :bots
+
+  before_validation :generate_bot_code, on: :create
+  before_validation :generate_password, on: :create
+
+  validates :name, presence: true
+  validates :bot_code, presence: true, uniqueness: true
+
+  private
+    def generate_bot_code
+      self.bot_code ||= SecureRandom.urlsafe_base64(32)
+    end
+
+    def generate_password
+      self.password ||= SecureRandom.hex(32)
+    end
+end
