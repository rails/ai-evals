index 0000000..9a5ed25
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "index lists only bots owned by the member and includes their bot codes" do
+    own_bot = Bot.create!(owner: users(:kevin), name: "Deploy Bot")
+    other_bot = Bot.create!(owner: users(:david), name: "Private Bot")
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li", text: /Deploy Bot/
+    assert_select "input[readonly][aria-label='Bot code'][value='#{own_bot.bot_code}']"
+    assert_select "li", text: /Private Bot/, count: 0
+    assert_no_match other_bot.bot_code, response.body
+  end
+
+  test "administrators can see all bots" do
+    bot = Bot.create!(owner: users(:david), name: "Private Bot")
+    sign_in :david
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li", text: /Private Bot/
+    assert_includes response.body, bot.bot_code
+  end
+
+  test "a member can create a bot that joins every open room" do
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+
+    bot = Bot.order(:id).last
+    assert_redirected_to bots_url
+    assert_equal users(:kevin), bot.owner
+    assert bot.bot_code.present?
+    assert bot.password_digest.present?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.ids.sort
+  end
+
+  test "new and edit use the labeled bot form and native delete confirmation" do
+    get new_bot_url
+
+    assert_response :success
+    assert_select "label", text: "Name the bot"
+    assert_select "input[placeholder='Name the bot'][required]"
+    assert_select "input[type='submit'][value='Save changes']"
+
+    bot = Bot.create!(owner: users(:kevin), name: "Deploy Bot")
+    get edit_bot_url(bot)
+
+    assert_response :success
+    assert_select "a", text: "Delete this chat bot", count: 0
+    assert_select "button[data-turbo-confirm]", text: "Delete this chat bot"
+  end
+
+  test "creating a bot requires a name" do
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { name: "" } }
+    end
+
+    assert_response :unprocessable_entity
+    assert_select "label", text: "Name the bot"
+  end
+
+  test "a member can update and delete their bot" do
+    bot = Bot.create!(owner: users(:kevin), name: "Deploy Bot")
+
+    patch bot_url(bot), params: { bot: { name: "Release Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+
+    assert_difference -> { Bot.count }, -1 do
+      delete bot_url(bot)
+    end
+    assert_redirected_to bots_url
+  end
+
+  test "members cannot edit another member's bot" do
+    bot = Bot.create!(owner: users(:david), name: "Private Bot")
+
+    get edit_bot_url(bot)
+
+    assert_response :not_found
+  end
+end
