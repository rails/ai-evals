diff --git a/test/controllers/bot_messages_controller_test.rb b/test/controllers/bot_messages_controller_test.rb
new file mode 100644
index 0000000..e26f7ca
--- /dev/null
+++ b/test/controllers/bot_messages_controller_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class BotMessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+    @bot = Bot.create!(owner: users(:david), name: "Deploy Bot")
+    @room = rooms(:hq)
+  end
+
+  test "creates and broadcasts a message using the raw request body" do
+    body = "Deploy of v1.2.3 finished ✅&release=ready"
+
+    assert_difference -> { Message.count }, 1 do
+      assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+        post bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: body,
+             headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+      end
+    end
+
+    assert_response :created
+    message = Message.order(:id).last
+    assert_equal body.dup.force_encoding(Encoding::UTF_8), message.plain_text_body
+    assert_equal @bot, message.creator
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+  end
+
+  test "rejects an invalid bot code" do
+    post bot_messages_url(room_id: @room.id, bot_code: "not-a-real-code"), params: "Hello"
+
+    assert_response :unauthorized
+    assert_no_difference -> { Message.count } do
+      post bot_messages_url(room_id: @room.id, bot_code: "still-not-a-real-code"), params: "Hello"
+    end
+  end
+
+  test "returns not found for an invalid room id" do
+    post bot_messages_url(room_id: "missing", bot_code: @bot.bot_code), params: "Hello"
+
+    assert_response :not_found
+  end
+
+  test "returns unprocessable entity for an empty body" do
+    assert_no_difference -> { Message.count } do
+      post bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "",
+           headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :unprocessable_entity
+    assert_empty response.body
+  end
+
+  test "creating a message enqueues the normal room push notification job" do
+    assert_enqueued_jobs 1, only: [ Room::PushMessageJob ] do
+      post bot_messages_url(room_id: @room.id, bot_code: @bot.bot_code), params: "Hello"
+    end
+
+    assert_response :created
+  end
+
+  test "a deleted bot can no longer post" do
+    bot_code = @bot.bot_code
+    @bot.destroy
+
+    post bot_messages_url(room_id: @room.id, bot_code: bot_code), params: "Hello"
+
+    assert_response :unauthorized
+  end
+
+  test "a bot cannot post to a room it has not joined" do
+    post bot_messages_url(room_id: rooms(:watercooler).id, bot_code: @bot.bot_code), params: "Hello"
+
+    assert_response :not_found
+  end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
