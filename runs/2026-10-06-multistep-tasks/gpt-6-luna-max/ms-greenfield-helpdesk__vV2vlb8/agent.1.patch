+require "uri"
+
+class FrontendLinkBuilder
+  DEFAULT_FRONTEND_URL = "http://localhost:3001"
+
+  def self.build(path, account:, token:)
+    base_url = ENV.fetch("HELPDESK_FRONTEND_URL", DEFAULT_FRONTEND_URL).sub(%r{/+\z}, "")
