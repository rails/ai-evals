+class Ticket < ApplicationRecord
+  STATUSES = %w[open pending solved].freeze
+
+  belongs_to :account
+  belongs_to :requester, class_name: "User", inverse_of: :requested_tickets
+  has_many :comments, class_name: "TicketComment", inverse_of: :ticket, dependent: :destroy
+
+  validates :subject, presence: true
+  validates :status, inclusion: { in: STATUSES }
+  validate :requester_belongs_to_account
+
+  private
+
+  def requester_belongs_to_account
+    if requester && account && requester.account_id != account_id
+      errors.add(:requester, "must belong to the ticket account")
+    end
+  end
+end
