new file mode 100644
index 0000000..7e1068b
--- /dev/null
+++ b/app/serializers/ticket_serializer.rb
@@ -0,0 +1,23 @@
+class TicketSerializer
+  def self.call(ticket, include_requester: false)
+    result = {
+      id: ticket.id,
+      subject: ticket.subject,
+      status: ticket.status,
+      requester_id: ticket.requester_id,
+      created_at: ticket.created_at&.iso8601(6),
+      updated_at: ticket.updated_at&.iso8601(6)
+    }
+
+    if include_requester
+      requester = ticket.requester
+      result[:requester] = {
+        id: requester.id,
+        name: requester.name,
+        email: requester.email
+      }
+    end
+
+    result
+  end
+end
