@@ -0,0 +1,13 @@
+class TicketReplyMailer < ApplicationMailer
+  def reply
+    @comment = params.fetch(:comment)
+    @ticket = @comment.ticket
+
+    mail(
+      to: @ticket.requester.email,
+      from: @ticket.account.support_email_address,
+      reply_to: @ticket.email_reply_address,
+      subject: "Re: #{@ticket.subject}"
+    )
+  end
+end
