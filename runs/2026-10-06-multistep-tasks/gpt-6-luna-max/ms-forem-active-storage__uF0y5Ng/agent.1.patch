diff --git a/spec/models/active_storage_profile_image_spec.rb b/spec/models/active_storage_profile_image_spec.rb
new file mode 100644
index 0000000..afcaf6a
--- /dev/null
+++ b/spec/models/active_storage_profile_image_spec.rb
@@ -0,0 +1,55 @@
+require "rails_helper"
+
+RSpec.describe ActiveStorageProfileImage do
+  let(:legacy_identifier) { "legacy-profile-image.jpg" }
+  let(:new_upload) do
+    Rack::Test::UploadedFile.new(
+      Rails.root.join("spec/support/fixtures/images/image1.jpeg"),
+      "image/jpeg",
+    )
+  end
+
+  shared_examples "a CarrierWave-compatible Active Storage profile image" do
+    it "stores new uploads in Active Storage and keeps the legacy identifier intact" do
+      record.update_columns(profile_image: legacy_identifier, profile_image_is_active_storage: false)
+      record.reload
+
+      record.profile_image = new_upload
+      record.save!
+      record.reload
+
+      expect(record.active_storage_profile_image).to be_attached
+      expect(record.active_storage_profile_image.blob.download).to be_present
+      expect(record.profile_image_is_active_storage).to be(true)
+      expect(record.read_attribute(:profile_image)).to eq(legacy_identifier)
+      expect(record.profile_image_url).to include("/rails/active_storage/blobs/redirect/")
+    end
+
+    it "continues serving the CarrierWave URL when there is no Active Storage attachment" do
+      record.active_storage_profile_image.purge if record.active_storage_profile_image.attached?
+      record.update_columns(profile_image: legacy_identifier, profile_image_is_active_storage: false)
+      record.reload
+
+      expect(record.profile_image_url).to eq(record.profile_image.url)
+      expect(record.profile_image_url).to be_present
+    end
+
+    it "writes an Active Storage attachment for new profiles without writing the CarrierWave column" do
+      expect(record.active_storage_profile_image).to be_attached
+      expect(record.profile_image_is_active_storage).to be(true)
+      expect(record.read_attribute(:profile_image)).to be_blank
+    end
+  end
+
+  context "with a user" do
+    let(:record) { create(:user) }
+
+    include_examples "a CarrierWave-compatible Active Storage profile image"
+  end
+
+  context "with an organization" do
+    let(:record) { create(:organization) }
+
+    include_examples "a CarrierWave-compatible Active Storage profile image"
+  end
+end
