diff --git a/app/models/concerns/active_storage_profile_image.rb b/app/models/concerns/active_storage_profile_image.rb
new file mode 100644
index 0000000..8633b8d
--- /dev/null
+++ b/app/models/concerns/active_storage_profile_image.rb
@@ -0,0 +1,123 @@
+# Bridges the legacy CarrierWave `profile_image` column and a new Active Storage attachment.
+# The CarrierWave uploader remains mounted to serve existing images; writes through the
+# existing `profile_image=` interface are cached/validated by that uploader and then stored
+# as Active Storage blobs instead.
+module ActiveStorageProfileImage
+  extend ActiveSupport::Concern
+
+  included do
+    has_one_attached :active_storage_profile_image
+
+    before_save :remember_active_storage_profile_image_change
+    validate :add_active_storage_profile_image_errors
+    after_commit :cleanup_active_storage_profile_image_cache, on: %i[create update]
+  end
+
+  def profile_image=(upload)
+    if profile_image_upload?(upload)
+      uploader = ProfileImageUploader.new(self, :profile_image)
+      cache_active_storage_profile_image(uploader, upload)
+    elsif remote_profile_image_url?(upload)
+      self.remote_profile_image_url = upload
+    else
+      super
+    end
+  end
+
+  # Keep the existing CarrierWave remote-image API for OAuth and other import paths, but
+  # download and store the result in Active Storage from this deploy onward.
+  def remote_profile_image_url=(url)
+    return if url.blank?
+
+    uploader = ProfileImageUploader.new(self, :profile_image)
+    cache_remote_active_storage_profile_image(uploader, url)
+  end
+
+  def profile_image_url(*args)
+    if active_storage_profile_image_attached? && active_storage_profile_image.blob.persisted?
+      path = Rails.application.routes.url_helpers.rails_blob_path(active_storage_profile_image, only_path: true)
+      return URL.url(path)
+    end
+
+    super
+  end
+
+  def profile_image_present?
+    active_storage_profile_image_attached? || profile_image.present?
+  end
+
+  def active_storage_profile_image_attached?
+    return false if has_attribute?(:profile_image_is_active_storage) && !self[:profile_image_is_active_storage]
+
+    active_storage_profile_image.attached?
+  end
+
+  def active_storage_profile_image_changed?
+    @active_storage_profile_image_changed == true
+  end
+
+  private
+
+  def profile_image_upload?(upload)
+    !upload.nil? && !upload.is_a?(String) &&
+      (upload.respond_to?(:original_filename) || upload.respond_to?(:read) || upload.is_a?(Pathname))
+  end
+
+  def remote_profile_image_url?(value)
+    value.is_a?(String) && value.match?(%r{\Ahttps?://}i)
+  end
+
+  def cache_active_storage_profile_image(uploader, upload)
+    @active_storage_profile_image_errors = []
+    uploader.cache!(upload)
+    attach_cached_profile_image(uploader) if uploader.file.present?
+  rescue CarrierWave::IntegrityError, CarrierWave::ProcessingError, CarrierWave::DownloadError => e
+    (@active_storage_profile_image_errors ||= []) << e
+  end
+
+  def cache_remote_active_storage_profile_image(uploader, url)
+    @active_storage_profile_image_errors = []
+    uploader.download!(url)
+    attach_cached_profile_image(uploader) if uploader.file.present?
+  rescue CarrierWave::IntegrityError, CarrierWave::ProcessingError, CarrierWave::DownloadError => e
+    (@active_storage_profile_image_errors ||= []) << e
+  end
+
+  def add_active_storage_profile_image_errors
+    Array(@active_storage_profile_image_errors).each do |error|
+      error_type = if error.is_a?(CarrierWave::IntegrityError)
+                     :carrierwave_integrity_error
+                   elsif error.is_a?(CarrierWave::ProcessingError)
+                     :carrierwave_processing_error
+                   else
+                     :carrierwave_download_error
+                   end
+      message = error.message unless error.message == error.class.to_s
+      errors.add(:profile_image, error_type, message: message)
+    end
+  end
+
+  def attach_cached_profile_image(uploader)
+    file = uploader.file
+    path = Pathname.new(file.path)
+
+    self.active_storage_profile_image = path
+    self.profile_image_is_active_storage = true
+    self.updated_at = Time.current if persisted?
+
+    (@active_storage_profile_image_cache_directories ||= []) << File.dirname(path.to_s)
+  end
+
+  def remember_active_storage_profile_image_change
+    @active_storage_profile_image_changed = attachment_changes.key?("active_storage_profile_image")
+  end
+
+  def cleanup_active_storage_profile_image_cache
+    Array(@active_storage_profile_image_cache_directories).each { |directory| FileUtils.rm_rf(directory) }
+    @active_storage_profile_image_cache_directories = []
+  end
+
+  def reset_active_storage_profile_image_change
+    @active_storage_profile_image_changed = false
+  end
+end
