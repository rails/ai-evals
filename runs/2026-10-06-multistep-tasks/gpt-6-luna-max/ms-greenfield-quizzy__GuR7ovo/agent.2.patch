diff --git a/app/services/question_rules.rb b/app/services/question_rules.rb
new file mode 100644
index 0000000..82cb214
--- /dev/null
+++ b/app/services/question_rules.rb
@@ -0,0 +1,33 @@
+# Shared option rules for the moderator's question form and JSON imports.
+class QuestionRules
+  MIN_OPTIONS = 2
+
+  class << self
+    def normalize_options(rows)
+      Array(rows).filter_map do |row|
+        text = value_for(row, :text).to_s.strip
+        next unless text.present?
+
+        {
+          text: text,
+          correct: ActiveModel::Type::Boolean.new.cast(value_for(row, :correct)) || false
+        }
+      end
+    end
+
+    def add_option_errors(question, options)
+      question.errors.add(:base, "Add at least two options") if options.length < MIN_OPTIONS
+      if options.none? { |option| option[:correct] }
+        question.errors.add(:base, "Mark at least one option as correct")
+      end
+    end
+
+    private
+
+    def value_for(row, key)
+      return unless row.respond_to?(:[])
+
+      row.key?(key) ? row[key] : row[key.to_s]
+    end
+  end
+end
