+++ b/app/services/game_broadcaster.rb
@@ -0,0 +1,8 @@
+# Broadcast a compact, correctness-safe public snapshot plus an optional
+# participant-only snapshot to that participant's other open browser tabs.
+class GameBroadcaster
+  def self.broadcast(game, player: nil)
+    GameChannel.broadcast_to(game, game.live_state)
+    GameChannel.broadcast_to(player, game.live_state(player: player)) if player
+  end
+end
