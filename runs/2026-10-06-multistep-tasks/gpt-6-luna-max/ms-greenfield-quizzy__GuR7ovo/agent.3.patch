@@ -0,0 +1,80 @@
+<% content_for :title, "Live game · #{@quiz.title} · Quizzy" %>
+<main
+  class="screen cover cover--night"
+  data-live-game
+  data-live-role="moderator"
+  data-game-code="<%= @game.join_code %>"
+  data-live-state="<%= @live_state.to_json %>"
+  data-start-url="<%= start_moderate_game_path(@game) %>"
+  data-finish-url="<%= finish_moderate_game_path(@game) %>"
+  data-next-url="<%= next_moderate_game_path(@game) %>"
+  data-end-url="<%= end_game_moderate_game_path(@game) %>"
+  data-quiz-url="<%= moderate_quiz_path(@quiz) %>">
+  <header class="screen__top">
+    <%= link_to moderate_quiz_path(@quiz), class: "logo screen__logo", aria: { label: "Back to quiz" } do %>
+      <span class="logo__mark">?</span>Quizzy
+    <% end %>
+    <span><%= @quiz.title %></span>
+  </header>
+
+  <section class="screen__body" data-live-panel aria-live="polite">
+    <% if @game.waiting? %>
+      <div class="lobby">
+        <div>
+          <p class="screen__kicker">Join the game</p>
+          <h1 class="lobby__title"><%= @quiz.title %></h1>
+          <p class="lobby__join">Join at</p>
+          <p class="lobby__url"><%= @join_url %></p>
+          <div class="counter-pill" aria-live="polite">
+            <span>Players: <strong data-live-player-count><%= @live_state[:player_count] %></strong></span>
+          </div>
+        </div>
+        <div class="qr" role="img" aria-label="QR code for the join link"><%= @qr_svg.html_safe %></div>
+      </div>
+    <% elsif @game.finished? %>
+      <h1 class="play-title">The quiz is over</h1>
+    <% else %>
+      <% question = @game.current_question %>
+      <section class="stage-question">
+        <div class="stage-question__num">Question <%= question.position %> of <%= @live_state[:question_count] %></div>
+        <h1 class="stage-question__body"><%= question.body %></h1>
+        <ol class="stage-options <%= 'stage-options--results' if @game.question_closed? %>">
+          <% answer_counts = @game.question_closed? ? question.game_answers.group(:game_option_id).count : {} %>
+          <% question.game_options.each_with_index do |option, index| %>
+            <% count = answer_counts.fetch(option.id, 0) %>
+            <% share = @live_state[:player_count].positive? ? count.to_f / @live_state[:player_count] * 100 : 0 %>
+            <li class="stage-option <%= 'is-correct' if @game.question_closed? && option.correct? %>">
+              <span class="stage-option__letter"><%= option_letter(index) %></span>
+              <span class="stage-option__title"><%= option.text %></span>
+              <% if @game.question_closed? %>
+                <span class="stage-option__count"><%= count %></span>
+                <span class="stage-option__bar" aria-hidden="true" style="--share: <%= share %>%"></span>
+                <% if option.correct? %><span class="stage-option__mark">Correct</span><% end %>
+              <% end %>
+            </li>
+          <% end %>
+        </ol>
+        <% if @game.question_open? %>
+          <div class="counter-pill answers-counter" aria-live="polite">
+            <span>Answers: <strong data-live-answer-count><%= @live_state[:question][:answered_count] %></strong> / <span data-live-player-total><%= @live_state[:player_count] %></span></span>
+          </div>
+        <% end %>
+      </section>
+    <% end %>
+  </section>
+
+  <footer class="screen-controls" data-live-controls>
+    <div class="screen-controls__info"><span>Quizzy · Live game</span></div>
+    <% if @game.waiting? %>
+      <%= button_to "Start", start_moderate_game_path(@game), method: :post, class: "btn btn--pink btn--lg", form: { data: { live_action: "start", turbo: false } } %>
+    <% elsif @game.question_open? %>
+      <%= button_to "Finish", finish_moderate_game_path(@game), method: :post, class: "btn btn--pink btn--lg", form: { data: { live_action: "finish", turbo: false } } %>
+    <% elsif @game.question_closed? && @game.current_question_position < @live_state[:question_count] %>
+      <%= button_to "Next", next_moderate_game_path(@game), method: :post, class: "btn btn--pink btn--lg", form: { data: { live_action: "next", turbo: false } } %>
+    <% elsif @game.question_closed? %>
+      <%= button_to "End quiz", end_game_moderate_game_path(@game), method: :post, class: "btn btn--pink btn--lg", form: { data: { live_action: "end_game", turbo: false } } %>
+    <% else %>
+      <%= link_to "Back to quiz", moderate_quiz_path(@quiz), class: "btn btn--light" %>
+    <% end %>
+  </footer>
+</main>
