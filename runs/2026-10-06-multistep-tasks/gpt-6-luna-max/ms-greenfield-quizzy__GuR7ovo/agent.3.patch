+++ b/app/channels/application_cable/connection.rb
@@ -0,0 +1,9 @@
+module ApplicationCable
+  class Connection < ActionCable::Connection::Base
+    # Player tokens are signed in an HTTP-only cookie by PlayController. Use the
+    # same identity when the browser opens its live Action Cable connection.
+    def player_token_for(join_code)
+      cookies.signed["quizzy_player_#{join_code.to_s.downcase}"]
+    end
+  end
+end
diff --git a/app/channels/game_channel.rb b/app/channels/game_channel.rb
new file mode 100644
index 0000000..2f92680
--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,14 @@
+class GameChannel < ::ActionCable::Channel::Base
+  def subscribed
+    @game = Game.find_by(join_code: params[:code].to_s.upcase)
+    return reject unless @game
+
+    stream_for @game
+    @game.reload
+
+    token = connection.player_token_for(@game.join_code)
+    player = @game.players.find_by(token: token) if token.present?
+    stream_for player if player
+    transmit @game.live_state(player: player)
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
