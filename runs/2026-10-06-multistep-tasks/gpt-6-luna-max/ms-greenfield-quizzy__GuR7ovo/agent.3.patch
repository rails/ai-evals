diff --git a/app/views/play/show.html.erb b/app/views/play/show.html.erb
new file mode 100644
index 0000000..b8be883
--- /dev/null
+++ b/app/views/play/show.html.erb
@@ -0,0 +1,73 @@
+<% content_for :title, "Play · #{@game.quiz.title} · Quizzy" %>
+<main
+  class="play"
+  data-live-game
+  data-live-role="<%= @role %>"
+  data-game-code="<%= @game.join_code %>"
+  data-live-state="<%= @live_state.to_json %>"
+  data-player-name="<%= @player&.name %>"
+  data-join-url="<%= join_play_game_path(@game.join_code) %>"
+  data-answer-url="<%= answer_play_game_path(@game.join_code) %>">
+  <header class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span class="meta"><%= @game.quiz.title %></span>
+  </header>
+
+  <section class="play__body" data-live-panel aria-live="polite">
+    <% if @game.finished? %>
+      <h1 class="play-title">The quiz is over</h1>
+    <% elsif @player.nil? %>
+      <h1 class="play-title"><%= @game.quiz.title %></h1>
+      <p class="play-lead">Join the live quiz.</p>
+      <% if @join_errors.present? %>
+        <div class="errors" role="alert"><ul><% @join_errors.each do |message| %><li><%= message %></li><% end %></ul></div>
+      <% end %>
+      <%= form_with url: join_play_game_path(@game.join_code), scope: :player, class: "join-form", data: { turbo: false } do |form| %>
+        <%= form.label :name, "Your name", class: "visually-hidden" %>
+        <%= form.text_field :name, value: @player_name, placeholder: "Your name", class: "input", autocomplete: "name", maxlength: 50, required: true, autofocus: true %>
+        <%= form.button "Join", type: "submit", class: "btn btn--pink" %>
+      <% end %>
+    <% else %>
+      <p class="meta" data-player-greeting>Hi, <%= @player.name %>!</p>
+      <% if @game.waiting? %>
+        <div class="waiting" data-player-waiting>
+          <div class="waiting__gem" aria-hidden="true">?</div>
+          <h1 class="play-title">You're in!</h1>
+          <p class="play-lead">Waiting for the quiz to start…</p>
+        </div>
+      <% else %>
+        <% question = @question %>
+        <div class="play-question__num">Question <%= question.position %> of <%= @live_state[:question_count] %></div>
+        <h1 class="play-question__body"><%= question.body %></h1>
+        <div class="play-options <%= 'is-locked' if @game.question_closed? %>" data-player-options>
+          <% selected_option_id = @live_state[:your_answer_option_id] %>
+          <% question.game_options.each_with_index do |option, index| %>
+            <% picked = selected_option_id == option.id %>
+            <% if @game.question_open? %>
+              <%= form_with url: answer_play_game_path(@game.join_code), method: :post, data: { live_answer: true, turbo: false } do %>
+                <%= hidden_field_tag :option_id, option.id, id: "option_#{option.id}" %>
+                <button type="submit" class="play-option <%= 'is-picked' if picked %>" aria-pressed="<%= picked %>">
+                  <span class="play-option__letter"><%= option_letter(index) %></span>
+                  <span class="play-option__title"><%= option.text %></span>
+                  <span class="play-option__mark" data-your-answer <%= 'hidden' unless picked %>>Your answer</span>
+                </button>
+              <% end %>
+            <% else %>
+              <button type="button" class="play-option <%= 'is-picked' if picked %>" disabled aria-pressed="<%= picked %>">
+                <span class="play-option__letter"><%= option_letter(index) %></span>
+                <span class="play-option__title"><%= option.text %></span>
+                <span class="play-option__mark" data-your-answer <%= 'hidden' unless picked %>>Your answer</span>
+              </button>
+            <% end %>
+          <% end %>
+        </div>
+        <% if @game.question_closed? %>
+          <% result = @live_state[:result] %>
+          <% result_label = { "correct" => "Correct!", "wrong" => "Wrong!", "no_answer" => "No answer" }.fetch(result, "No answer") %>
+          <% result_class = result == "correct" ? "play-status--right" : (result == "wrong" ? "play-status--wrong" : "play-status--neutral") %>
+          <p class="play-status <%= result_class %>" data-player-result role="status"><%= result_label %></p>
+        <% end %>
+      <% end %>
+    <% end %>
+  </section>
+</main>
