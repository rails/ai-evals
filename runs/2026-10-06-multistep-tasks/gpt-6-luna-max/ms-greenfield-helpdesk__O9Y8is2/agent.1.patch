+module Api
+  module V1
+    class PasswordChangesController < BaseController
+      class IncorrectCurrentPassword < StandardError; end
+
+      def update
+        attributes = params.require(:password_change).permit(:current_password, :password)
+        current_user.with_lock do
+          raise IncorrectCurrentPassword unless current_user.authenticate(attributes[:current_password])
+
+          current_user.password = attributes[:password]
+          current_user.save!
+          current_user.sessions.delete_all
+        end
+
+        render json: { user: serialize_user(current_user) }
+      rescue IncorrectCurrentPassword
+        render_error("Current password is incorrect", status: :unprocessable_entity)
+      rescue ActiveRecord::RecordInvalid => error
+        render_record_errors(error.record)
+      end
+    end
+  end
+end
