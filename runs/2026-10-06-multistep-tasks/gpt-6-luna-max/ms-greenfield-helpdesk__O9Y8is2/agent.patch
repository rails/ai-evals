diff --git a/app/mailers/auth_mailer.rb b/app/mailers/auth_mailer.rb
new file mode 100644
index 0000000..b9b2f63
--- /dev/null
+++ b/app/mailers/auth_mailer.rb
@@ -0,0 +1,35 @@
+require "uri"
+
+class AuthMailer < ApplicationMailer
+  def verify_email(user, token)
+    @user = user
+    @account = user.account
+    @url = frontend_link("verify-email", @account.subdomain, token)
+
+    mail(to: @user.email, subject: "Verify your email address")
+  end
+
+  def password_reset(user, token)
+    @user = user
+    @account = user.account
+    @url = frontend_link("reset-password", @account.subdomain, token)
+
+    mail(to: @user.email, subject: "Reset your password")
+  end
+
+  def invitation(invitation, token)
+    @invitation = invitation
+    @account = invitation.account
+    @url = frontend_link("accept-invitation", @account.subdomain, token)
+
+    mail(to: invitation.email, subject: "You have been invited to join #{@account.name}")
+  end
+
+  private
+
+  def frontend_link(path, subdomain, token)
+    frontend_url = ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001").sub(%r{/+\z}, "")
+    query = URI.encode_www_form(account: subdomain, token: token)
+    "#{frontend_url}/#{path}?#{query}"
+  end
+end
