diff --git a/app/models/support_email.rb b/app/models/support_email.rb
new file mode 100644
index 0000000..69f8d8e
--- /dev/null
+++ b/app/models/support_email.rb
@@ -0,0 +1,58 @@
+module SupportEmail
+  Destination = Struct.new(:account, :ticket, keyword_init: true)
+  private_constant :Destination
+
+  REPLY_LOCAL_PART = /\Areply\+([a-f0-9]{32,64})\z/i
+
+  def self.domain
+    ENV["HELPDESK_SUPPORT_DOMAIN"].to_s.strip.downcase.sub(/\A@/, "").sub(/\.\z/, "").presence ||
+      "support.example.test"
+  end
+
+  def self.account_address(account)
+    "#{account.subdomain}@#{domain}"
+  end
+
+  def self.reply_address(ticket)
+    return if ticket.email_reply_token.blank?
+
+    "reply+#{ticket.email_reply_token}@#{domain}"
+  end
+
+  # Resolve every configured support recipient together. A message that targets
+  # more than one business or more than one private ticket is deliberately
+  # ignored rather than being assigned to an arbitrary conversation.
+  def self.destination_for(recipients)
+    accounts = {}
+    tickets = {}
+    invalid_private_address = false
+
+    Array(recipients).each do |recipient|
+      address = recipient.respond_to?(:address) ? recipient.address : recipient.to_s
+      local_part, separator, recipient_domain = address.to_s.strip.downcase.rpartition("@")
+      next if separator.empty? || recipient_domain.chomp(".") != domain
+
+      if local_part.start_with?("reply+")
+        token = REPLY_LOCAL_PART.match(local_part)&.captures&.first
+        ticket = token && Ticket.find_by(email_reply_token: token.downcase)
+        if ticket
+          tickets[ticket.id] = ticket
+          accounts[ticket.account_id] ||= ticket.account
+        else
+          invalid_private_address = true
+        end
+      else
+        account = Account.find_by(subdomain: local_part)
+        accounts[account.id] = account if account
+      end
+    end
+
+    return if invalid_private_address || accounts.size != 1 || tickets.size > 1
+
+    account = accounts.values.first
+    ticket = tickets.values.first
+    return if ticket && ticket.account_id != account.id
+
+    Destination.new(account: account, ticket: ticket)
+  end
+end
diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..f57ad01
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,118 @@
+require "securerandom"
+
+class Ticket < ApplicationRecord
+  STATUSES = %w[open pending solved closed].freeze
+  PRIORITIES = %w[normal high].freeze
+
+  belongs_to :account
+  belongs_to :requester, class_name: "User"
+  belongs_to :assignee, class_name: "User", optional: true, inverse_of: :assigned_tickets
+  belongs_to :group, optional: true
+  belongs_to :merged_into, class_name: "Ticket", optional: true, inverse_of: :merged_tickets
+  has_many :merged_tickets, class_name: "Ticket", foreign_key: :merged_into_id,
+                            inverse_of: :merged_into
+  has_many :comments, dependent: :destroy
+
+  before_validation :generate_email_reply_token, on: :create
+  before_validation :assign_default_group_to_assignee, if: :will_save_change_to_assignee_id?
+  before_validation :clear_assignee_if_not_in_group, if: :will_save_change_to_group_id?
+
+  validates :email_reply_token, presence: true, uniqueness: true
+  validates :subject, presence: true
+  validates :status, inclusion: { in: STATUSES }
+  validates :priority, inclusion: { in: PRIORITIES }
+  validate :requester_belongs_to_account
+  validate :group_belongs_to_account
+  validate :assignee_is_active_staff_in_account
+  validate :merged_into_is_valid
+
+  def email_reply_address
+    SupportEmail.reply_address(self)
+  end
+
+  def closed?
+    status == "closed"
+  end
+
+  def merged?
+    merged_into_id.present?
+  end
+
+  def closed_or_merged?
+    closed? || merged?
+  end
+
+  def self.search_text(query)
+    pattern = "%#{sanitize_sql_like(query)}%"
+    where(
+      "tickets.subject ILIKE :pattern OR EXISTS (" \
+      "SELECT 1 FROM comments " \
+      "WHERE comments.ticket_id = tickets.id " \
+      "AND comments.public = TRUE " \
+      "AND comments.body ILIKE :pattern)",
+      pattern: pattern
+    )
+  end
+
+  private
+
+  def generate_email_reply_token
+    self.email_reply_token ||= SecureRandom.hex(20)
+  end
+
+  def assign_default_group_to_assignee
+    return if assignee_id.blank? || group_id.present?
+
+    assigned_user = assignee || User.find_by(id: assignee_id)
+    return if assigned_user.blank? || assigned_user.account_id != account_id
+
+    membership = assigned_user.default_group_membership
+    self.group_id = membership.group_id if membership
+  end
+
+  def clear_assignee_if_not_in_group
+    return if assignee_id.blank?
+    return if will_save_change_to_assignee_id? && assignee_id.present?
+
+    unless group_id.present? && GroupMembership.exists?(group_id: group_id, user_id: assignee_id)
+      self.assignee_id = nil
+    end
+  end
+
+  def group_belongs_to_account
+    return if group_id.blank?
+    return if group.present? && group.account_id == account_id
+
+    errors.add(:group, "must belong to the ticket's account")
+  end
+
+  def assignee_is_active_staff_in_account
+    return if assignee.blank?
+
+    if account.blank? || assignee.account_id != account_id
+      errors.add(:assignee, "must belong to the ticket's account")
+    elsif !assignee.staff? || assignee.suspended?
+      errors.add(:assignee, "must be active staff")
+    elsif group_id.present? && !GroupMembership.exists?(group_id: group_id, user_id: assignee_id)
+      errors.add(:assignee, "must belong to the ticket's group")
+    end
+  end
+
+  def merged_into_is_valid
+    return if merged_into.blank?
+
+    if merged_into_id == id
+      errors.add(:merged_into, "cannot be the ticket itself")
+    elsif merged_into.account_id != account_id
+      errors.add(:merged_into, "must belong to the ticket's account")
+    elsif merged_into.requester_id != requester_id
+      errors.add(:merged_into, "must belong to the same customer")
+    end
+  end
+
+  def requester_belongs_to_account
+    return if requester.blank? || account.blank? || requester.account_id == account_id
+
+    errors.add(:requester, "must belong to the ticket's account")
+  end
+end
diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..a819b0f
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,122 @@
+require "digest"
+require "securerandom"
+
+class User < ApplicationRecord
+  EMAIL_FORMAT = /\A[^\s@]+@[^\s@]+\.[^\s@]+\z/
+  EMAIL_VERIFICATION_TTL = 24.hours
+  PASSWORD_RESET_TTL = 2.hours
+  ROLES = %w[admin agent customer].freeze
+
+  belongs_to :account
+  has_many :sessions, dependent: :destroy
+  has_many :requested_tickets, class_name: "Ticket", foreign_key: :requester_id, dependent: :destroy
+  has_many :authored_comments, class_name: "Comment", foreign_key: :author_id, dependent: :destroy
+  has_many :assigned_tickets, class_name: "Ticket", foreign_key: :assignee_id, inverse_of: :assignee, dependent: :nullify
+  has_many :group_memberships, dependent: :destroy
+  has_many :groups, through: :group_memberships
+
+  has_secure_password
+
+  before_validation :normalize_email_and_name
+
+  validates :name, presence: true, length: { maximum: 120 }
+  validates :email, presence: true, format: { with: EMAIL_FORMAT },
+                    uniqueness: { scope: :account_id, case_sensitive: false }
+  validates :role, inclusion: { in: ROLES }
+  validates :password, length: { minimum: 8 }, if: -> { password.present? }
+
+  def verified?
+    verified_at.present?
+  end
+
+  def admin?
+    role == "admin"
+  end
+
+  def staff?
+    %w[admin agent].include?(role)
+  end
+
+  def customer?
+    role == "customer"
+  end
+
+  def default_group_membership
+    group_memberships.find_by(is_default: true)
+  end
+
+  def default_group
+    default_group_membership&.group
+  end
+
+  def issue_email_verification_token!
+    token = SecureRandom.urlsafe_base64(32)
+    update!(
+      email_verification_token_digest: self.class.digest_token(token),
+      email_verification_sent_at: Time.current
+    )
+    token
+  end
+
+  def issue_password_reset_token!
+    token = SecureRandom.urlsafe_base64(32)
+    update!(
+      password_reset_token_digest: self.class.digest_token(token),
+      password_reset_sent_at: Time.current
+    )
+    token
+  end
+
+  def consume_email_verification_token!(token)
+    with_lock do
+      next false unless valid_email_verification_token?(token)
+
+      update!(
+        verified_at: Time.current,
+        email_verification_token_digest: nil,
+        email_verification_sent_at: nil
+      )
+      true
+    end
+  end
+
+  def reset_password_with_token!(token, new_password)
+    with_lock do
+      next false unless valid_password_reset_token?(token)
+
+      self.password = new_password
+      self.password_reset_token_digest = nil
+      self.password_reset_sent_at = nil
+      save!
+      sessions.delete_all
+      true
+    end
+  end
+
+  def valid_email_verification_token?(token)
+    token_matches?(email_verification_token_digest, token) &&
+      email_verification_sent_at.present? && email_verification_sent_at >= EMAIL_VERIFICATION_TTL.ago
+  end
+
+  def valid_password_reset_token?(token)
+    token_matches?(password_reset_token_digest, token) &&
+      password_reset_sent_at.present? && password_reset_sent_at >= PASSWORD_RESET_TTL.ago
+  end
+
+  def self.digest_token(token)
+    Digest::SHA256.hexdigest(token.to_s)
+  end
+
+  private
+
+  def normalize_email_and_name
+    self.name = name.to_s.strip
+    self.email = email.to_s.strip.downcase
+  end
+
+  def token_matches?(stored_digest, token)
+    return false if stored_digest.blank? || token.blank?
+
+    ActiveSupport::SecurityUtils.secure_compare(stored_digest, self.class.digest_token(token))
+  end
+end
