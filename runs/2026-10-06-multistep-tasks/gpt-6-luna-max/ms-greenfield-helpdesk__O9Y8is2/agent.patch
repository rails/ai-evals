+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,56 @@
+module Api
+  module V1
+    class InvitationAcceptancesController < ApplicationController
+      def create
+        attributes = params.require(:invitation_acceptance).permit(:token, :name, :password)
+        token = attributes[:token].to_s
+        invitation = Invitation.find_by(token_digest: User.digest_token(token)) if token.present?
+
+        unless invitation
+          return render_error("Invitation token is invalid or expired", status: :unprocessable_entity)
+        end
+
+        account = invitation.account
+        failure = nil
+        user_errors = nil
+        user = nil
+
+        account.with_lock do
+          invitation.lock!
+          invitation.reload
+
+          if !invitation.token_matches?(token)
+            failure = "Invitation token is invalid or expired"
+          elsif invitation.expire_if_needed!
+            failure = "Invitation token is invalid or expired"
+          elsif !invitation.pending?
+            failure = "Invitation token is invalid or expired"
+          else
+            user = account.users.build(
+              name: attributes[:name],
+              email: invitation.email,
+              password: attributes[:password],
+              role: invitation.role,
+              verified_at: Time.current
+            )
+
+            if user.save
+              invitation.update!(status: "accepted", accepted_at: Time.current, token_digest: nil)
+            else
+              user_errors = user.errors.to_hash
+            end
+          end
+        end
+
+        return render_error(failure, status: :unprocessable_entity) if failure
+        return render_error("Validation failed", errors: user_errors) if user_errors
+
+        render json: { user: serialize_user(user), account: serialize_account(account) }, status: :created
+      rescue ActiveRecord::RecordInvalid => error
+        render_record_errors(error.record)
+      rescue ActiveRecord::RecordNotUnique
+        render_error("The email is already in use", status: :conflict)
+      end
+    end
+  end
+end
