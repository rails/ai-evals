+    return render_error("page[size] must be a positive integer", status: :bad_request) unless page_size
+
+    requested_after = page_parameters["after"]
+    requested_before = page_parameters["before"]
+    has_after_cursor = cursor_parameter_present?(requested_after)
+    has_before_cursor = cursor_parameter_present?(requested_before)
+    if has_after_cursor && has_before_cursor
+      return render_error("page[after] and page[before] cannot be used together", status: :bad_request)
+    end
+
+    order = normalized_cursor_order(relation, cursor_order)
+    direction = has_before_cursor ? :before : :after
