diff --git a/test/integration/ticket_merges_test.rb b/test/integration/ticket_merges_test.rb
new file mode 100644
index 0000000..e5f71b4
--- /dev/null
+++ b/test/integration/ticket_merges_test.rb
@@ -0,0 +1,263 @@
+require "test_helper"
+
+class TicketMergesTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails"
+
+  setup do
+    @account = Account.create!(name: "Acme Support", subdomain: "acme")
+    @admin = create_user("Alex Admin", "alex@example.test", "admin")
+    @agent = create_user("Morgan Agent", "morgan@example.test", "agent")
+    @customer = create_user("Casey Customer", "casey@example.test", "customer")
+    @other_customer = create_user("Taylor Customer", "taylor@example.test", "customer")
+    @admin_token = create_api_session(@admin, "admin-token")
+    @customer_token = create_api_session(@customer, "customer-token")
+  end
+
+  test "merging closes the source, adds private notes, and preserves both conversations" do
+    source = create_ticket("Duplicate issue", status: "open", email_origin: true)
+    target = create_ticket("Main issue", status: "pending", email_origin: true, assignee: @agent)
+    source_reply_token = source.email_reply_token
+    target_reply_token = target.email_reply_token
+    source.comments.create!(author: @customer, body: "Original public reply", public: true)
+    source.comments.create!(author: @agent, body: "Original private note", public: false)
+    target.comments.create!(author: @customer, body: "Target conversation", public: true)
+
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: target.id } }, headers: account_headers(@admin_token), as: :json
+
+    assert_response :success
+    response_source = response.parsed_body.fetch("source")
+    response_target = response.parsed_body.fetch("target")
+    assert_equal source.id, response_source.fetch("id")
+    assert_equal "closed", response_source.fetch("status")
+    assert_equal target.id, response_source.fetch("merged_into_id")
+    assert_equal "pending", response_target.fetch("status")
+    assert_nil response_target.fetch("merged_into_id")
+    assert_equal @agent.id, response_target.fetch("assignee_id")
+
+    source.reload
+    target.reload
+    assert_equal "closed", source.status
+    assert_equal target.id, source.merged_into_id
+    assert_equal source_reply_token, source.email_reply_token
+    assert_equal target_reply_token, target.email_reply_token
+    assert_equal "pending", target.status
+    assert_equal @agent.id, target.assignee_id
+    assert_equal ["Original public reply", "Original private note"],
+                 source.comments.order(:id).limit(2).pluck(:body)
+    assert_equal 3, source.comments.count, "old comments stay on the closed source"
+    assert_equal 2, target.comments.count, "the target keeps its own comments and gets one merge note"
+    source_note = source.comments.order(:id).last
+    target_note = target.comments.order(:id).last
+    assert_equal false, source_note.public?
+    assert_equal false, target_note.public?
+    assert_includes source_note.body, "##{target.id}"
+    assert_includes target_note.body, "##{source.id}"
+    assert_empty ActionMailer::Base.deliveries, "merge notes must not send email"
+
+    get "/api/v1/tickets/#{source.id}", headers: account_headers(@admin_token)
+    assert_response :success
+    assert_equal target.id, response.parsed_body.dig("ticket", "merged_into_id")
+    get "/api/v1/tickets/#{source.id}/comments", headers: account_headers(@admin_token)
+    assert_response :success
+    assert_equal ["Original public reply", "Original private note", source_note.body],
+                 response.parsed_body.fetch("comments").map { |comment| comment.fetch("body") }
+
+    get "/api/v1/requests/#{source.id}", headers: account_headers(@customer_token)
+    assert_response :success
+    assert_equal "closed", response.parsed_body.dig("request", "status")
+    assert_equal target.id, response.parsed_body.dig("request", "merged_into_id")
+    get "/api/v1/requests/#{source.id}/comments", headers: account_headers(@customer_token)
+    assert_response :success
+    assert_equal ["Original public reply"],
+                 response.parsed_body.fetch("comments").map { |comment| comment.fetch("body") }
+
+    get "/api/v1/tickets?status=closed", headers: account_headers(@admin_token)
+    assert_response :success
+    assert_equal [source.id], response.parsed_body.fetch("tickets").map { |record| record.fetch("id") }
+    get "/api/v1/requests?status=closed", headers: account_headers(@customer_token)
+    assert_response :success
+    assert_equal [source.id], response.parsed_body.fetch("requests").map { |record| record.fetch("id") }
+  end
+
+  test "staff can choose text and public visibility independently without sending email" do
+    source = create_ticket("Email duplicate", email_origin: true)
+    target = create_ticket("Email survivor", email_origin: true)
+
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: {
+           merge: {
+             target_id: target.id,
+             source_comment: { body: "Continuing in ticket #{target.id}.", public: true },
+             target_comment: { body: "Duplicate checked.", public: false }
+           }
+         }, headers: account_headers(@admin_token), as: :json
+
+    assert_response :success
+    source_note = source.comments.order(:id).last
+    target_note = target.comments.order(:id).last
+    assert_equal "Continuing in ticket #{target.id}.", source_note.body
+    assert_equal true, source_note.public?
+    assert_equal "Duplicate checked.", target_note.body
+    assert_equal false, target_note.public?
+    assert_empty ActionMailer::Base.deliveries
+
+    get "/api/v1/requests/#{source.id}/comments", headers: account_headers(@customer_token)
+    assert_response :success
+    assert_includes response.parsed_body.fetch("comments").map { |comment| comment.fetch("body") }, source_note.body
+    get "/api/v1/requests/#{target.id}/comments", headers: account_headers(@customer_token)
+    assert_response :success
+    refute_includes response.parsed_body.fetch("comments").map { |comment| comment.fetch("body") }, target_note.body
+  end
+
+  test "merge rejects self, other-customer, closed-target, and invalid-note merges atomically" do
+    source = create_ticket("Source")
+    target = create_ticket("Target")
+    other_customer_ticket = create_ticket("Not the same requester", requester: @other_customer)
+    closed_target = create_ticket("Already closed", status: "closed")
+
+    post_merge(source, source)
+    assert_response :unprocessable_entity
+    assert_equal "open", source.reload.status
+    assert_nil source.merged_into_id
+
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: 9_999_999 } }, headers: account_headers(@admin_token), as: :json
+    assert_response :not_found
+    assert_equal "open", source.reload.status
+
+    post_merge(source, other_customer_ticket)
+    assert_response :unprocessable_entity
+    assert_equal "open", source.reload.status
+    assert_empty source.comments
+
+    post_merge(source, closed_target)
+    assert_response :unprocessable_entity
+    assert_equal "open", source.reload.status
+
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: target.id, source_comment: { body: "   " } } },
+         headers: account_headers(@admin_token), as: :json
+    assert_response :unprocessable_entity
+    assert_equal "open", source.reload.status
+    assert_nil source.merged_into_id
+    assert_empty source.comments
+    assert_empty target.comments
+  end
+
+  test "closed merged tickets reject staff edits, customer replies, and incoming email replies" do
+    source = create_ticket("Closed email issue", email_origin: true)
+    target = create_ticket("Survivor")
+    post_merge(source, target)
+    assert_response :success
+    old_comments = source.comments.count
+
+    patch "/api/v1/tickets/#{source.id}",
+          params: { ticket: { status: "open", comment: { body: "A late staff reply" } } },
+          headers: account_headers(@admin_token), as: :json
+    assert_response :unprocessable_entity
+    assert_equal "closed", source.reload.status
+    assert_equal old_comments, source.comments.count
+
+    patch "/api/v1/requests/#{source.id}",
+          params: { request: { comment: { body: "A late customer reply" } } },
+          headers: account_headers(@customer_token), as: :json
+    assert_response :unprocessable_entity
+    assert_equal old_comments, source.comments.count
+
+    deliver(inbound_message(
+      from: @customer.email,
+      to: source.email_reply_address,
+      subject: "Re: Closed email issue",
+      body: "An email reply after merging.",
+      message_id: "closed-ticket-reply@example.test"
+    ))
+    assert_response :no_content
+    assert_equal "closed", source.reload.status
+    assert_equal old_comments, source.comments.count
+    assert_empty InboundEmailReceipt.where(message_id: "closed-ticket-reply@example.test")
+  end
+
+  test "a later merge preserves original merge links and assignment cleanup includes closed tickets" do
+    group = @account.groups.create!(name: "Support")
+    GroupMembership.create!(group: group, user: @agent)
+    first_source = create_ticket("First duplicate")
+    middle_ticket = create_ticket("Second duplicate", group: group, assignee: @agent)
+    final_target = create_ticket("Final survivor", status: "solved")
+
+    post_merge(first_source, middle_ticket)
+    assert_response :success
+    original_link = first_source.reload.merged_into_id
+    assert_equal middle_ticket.id, original_link
+
+    post_merge(middle_ticket, final_target)
+    assert_response :success
+    assert_equal "closed", middle_ticket.reload.status
+    assert_equal final_target.id, middle_ticket.merged_into_id
+    assert_equal original_link, first_source.reload.merged_into_id,
+                 "an earlier source continues to link to the ticket it was merged into"
+    assert_equal "solved", final_target.reload.status
+
+    assigned_source = create_ticket("Assigned duplicate", group: group, assignee: @agent)
+    assigned_target = create_ticket("Assigned survivor")
+    post_merge(assigned_source, assigned_target)
+    assert_response :success
+    assert_equal @agent.id, assigned_source.reload.assignee_id
+
+    patch "/api/v1/users/#{@agent.id}", params: { user: { suspended: true } },
+          headers: account_headers(@admin_token), as: :json
+    assert_response :success
+    assert_nil assigned_source.reload.assignee_id, "assignment cleanup must include closed tickets"
+    assert_equal assigned_target.id, assigned_source.merged_into_id
+  end
+
+  private
+
+  def create_user(name, email, role)
+    @account.users.create!(name: name, email: email, password: "valid-test-password", role: role,
+                           verified_at: Time.current)
+  end
+
+  def create_api_session(user, token)
+    user.sessions.create!(account: @account, token_digest: Session.digest_token(token))
+    token
+  end
+
+  def account_headers(token = nil)
+    headers = { "X-Helpdesk-Account" => @account.subdomain }
+    headers["Authorization"] = "Bearer #{token}" if token
+    headers
+  end
+
+  def create_ticket(subject, requester: @customer, status: "open", email_origin: false, group: nil, assignee: nil)
+    @account.tickets.create!(requester: requester, subject: subject, status: status, email_origin: email_origin,
+                             group: group, assignee: assignee)
+  end
+
+  def post_merge(source, target)
+    post "/api/v1/tickets/#{source.id}/merge",
+         params: { merge: { target_id: target.id } }, headers: account_headers(@admin_token), as: :json
+  end
+
+  def deliver(message)
+    post RELAY_PATH,
+         params: message.encoded,
+         headers: {
+           "Content-Type" => "message/rfc822",
+           "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials(
+             "actionmailbox", ENV.fetch("RAILS_INBOUND_EMAIL_PASSWORD")
+           )
+         }
+  end
+
+  def inbound_message(from:, to:, subject:, body:, message_id:)
+    message = Mail.new
+    message.from = from
+    message.to = to
+    message.subject = subject
+    message.message_id = message_id
+    message.content_type = "text/plain; charset=UTF-8"
+    message.body = body
+    message
+  end
+end
