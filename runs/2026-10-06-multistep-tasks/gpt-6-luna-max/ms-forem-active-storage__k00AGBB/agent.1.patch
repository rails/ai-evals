diff --git a/app/models/concerns/profile_image_storage.rb b/app/models/concerns/profile_image_storage.rb
new file mode 100644
index 0000000..c30227b
--- /dev/null
+++ b/app/models/concerns/profile_image_storage.rb
@@ -0,0 +1,124 @@
+# Supports the staged migration of user and organization profile images from
+# CarrierWave to Active Storage. The CarrierWave `profile_image` column and
+# uploader remain the source for existing files; new uploads are written to
+# `active_storage_profile_image` instead.
+module ProfileImageStorage
+  extend ActiveSupport::Concern
+
+  prepended do
+    validate :validate_profile_image_upload
+    after_create_commit :clear_profile_image_attachment_change_marker
+  end
+
+  def profile_image=(image)
+    if image.nil? || image == ""
+      if active_storage_profile_image.attached?
+        self.active_storage_profile_image = nil
+        mark_profile_image_attachment_changed
+      end
+      super
+    elsif remote_profile_image_url?(image)
+      self.remote_profile_image_url = image
+    elsif image.is_a?(ActiveStorage::Blob)
+      attach_active_storage_profile_image(image)
+    elsif uploadable_profile_image?(image)
+      cache_and_attach_profile_image(image)
+    else
+      super
+    end
+  end
+
+  def remote_profile_image_url=(url)
+    if uploadable_profile_image?(url)
+      cache_and_attach_profile_image(url)
+      return
+    end
+    return if url.blank?
+
+    safe_url = Images::SafeRemoteProfileImageUrl.call(url)
+    if safe_url.is_a?(String)
+      @active_storage_remote_profile_image_url = safe_url
+      uploader = ProfileImageUploader.new(self, :profile_image)
+      uploader.download!(safe_url)
+      cache_and_attach_profile_image(uploader) if uploader.file.present?
+    else
+      self.profile_image = safe_url
+    end
+  rescue CarrierWave::UploadError => e
+    # A remote provider failing to serve its avatar must not block signup or
+    # authentication. The normal profile-image fallback remains visible.
+    Rails.logger.warn("Unable to download remote profile image: #{e.message}")
+  end
+
+  def remote_profile_image_url
+    @active_storage_remote_profile_image_url || super
+  end
+
+  # CarrierWave remains the fallback for files already stored in the legacy
+  # column. Active Storage takes precedence only after a new image is attached.
+  def profile_image_url
+    return super unless active_storage_profile_image.attached?
+
+    blob = active_storage_profile_image.blob
+    return super unless blob.persisted?
+
+    blob_path = Rails.application.routes.url_helpers.rails_blob_path(blob, only_path: true, disposition: :inline)
+    URL.url(blob_path)
+  end
+
+  # Keep the historical `profile_image` attribute useful to existing API and
+  # serializer callers while presenting the Active Storage URL for new images.
+  def profile_image
+    return super unless active_storage_profile_image.attached?
+
+    blob = active_storage_profile_image.blob
+    blob.persisted? ? profile_image_url : active_storage_profile_image
+  end
+
+  def active_storage_profile_image_changed?
+    @active_storage_profile_image_changed == true
+  end
+
+  private
+
+  def remote_profile_image_url?(image)
+    image.is_a?(String) && image.match?(%r{\Ahttps?://}i)
+  end
+
+  def uploadable_profile_image?(image)
+    image.respond_to?(:original_filename) || image.is_a?(File) || image.is_a?(Pathname)
+  end
+
+  def attach_active_storage_profile_image(attachable)
+    self.active_storage_profile_image = attachable
+    mark_profile_image_attachment_changed
+  end
+
+  def cache_and_attach_profile_image(file)
+    @profile_image_upload_error = nil
+    @active_storage_remote_profile_image_url = nil unless file.is_a?(ProfileImageUploader)
+    uploader = if file.is_a?(ProfileImageUploader)
+                 file
+               else
+                 ProfileImageUploader.new(self, :profile_image).tap { |profile_uploader| profile_uploader.cache!(file) }
+               end
+    return unless uploader.file
+
+    attach_active_storage_profile_image(Pathname.new(uploader.file.path))
+  rescue CarrierWave::UploadError => e
+    @profile_image_upload_error = e.message
+  end
+
+  def mark_profile_image_attachment_changed
+    @active_storage_profile_image_changed = true
+    self.profile_updated_at = Time.current if persisted? && has_attribute?(:profile_updated_at)
+  end
+
+  def validate_profile_image_upload
+    errors.add(:profile_image, @profile_image_upload_error) if @profile_image_upload_error.present?
+  end
+
+  def clear_profile_image_attachment_change_marker
+    @active_storage_profile_image_changed = false
+  end
+end
