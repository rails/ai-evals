diff --git a/spec/models/profile_image_storage_spec.rb b/spec/models/profile_image_storage_spec.rb
new file mode 100644
index 0000000..edc633d
--- /dev/null
+++ b/spec/models/profile_image_storage_spec.rb
@@ -0,0 +1,84 @@
+require "rails_helper"
+
+RSpec.describe ProfileImageStorage do
+  let(:image_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+
+  def legacy_image_url(record, filename)
+    record.update_column(:profile_image, filename)
+    record.reload.profile_image_url
+  end
+
+  def upload_new_profile_image(record, legacy_filename)
+    upload = fixture_file_upload(image_path, "image/jpeg")
+    record.profile_image = upload
+    record.save!
+    record.reload
+
+    expect(record.active_storage_profile_image.attached?).to be(true)
+    expect(record.read_attribute(:profile_image)).to eq(legacy_filename)
+    expect(record.profile_image_url).to include("/rails/active_storage/blobs/redirect/")
+    expect(record.profile_image).to eq(record.profile_image_url)
+
+    record.active_storage_profile_image.purge
+    record.reload
+    expected_legacy_path = "/uploads/#{record.class.name.underscore}/profile_image/#{record.id}/#{legacy_filename}"
+    expect(record.profile_image_url).to end_with(expected_legacy_path)
+  end
+
+  describe User do
+    let(:user) { create(:user, profile_image: nil) }
+
+    it "continues serving an existing CarrierWave image" do
+      legacy_url = legacy_image_url(user, "legacy-user-image.jpg")
+
+      expect(user.active_storage_profile_image.attached?).to be(false)
+      expect(legacy_url).to end_with("/uploads/user/profile_image/#{user.id}/legacy-user-image.jpg")
+    end
+
+    it "stores a replacement in Active Storage without changing the legacy image" do
