diff --git a/app/services/game_presenter.rb b/app/services/game_presenter.rb
new file mode 100644
index 0000000..d3623ec
--- /dev/null
+++ b/app/services/game_presenter.rb
@@ -0,0 +1,82 @@
+class GamePresenter
+  def initialize(game, player: nil)
+    @game = game
+    @player = player
+  end
+
+  def moderator_state
+    question = @game.current_question
+    player_count = @game.game_players.count
+    question_count = @game.game_questions.count
+    state = {
+      status: @game.status,
+      code: @game.code,
+      title: @game.title,
+      question_count: question_count,
+      players_count: player_count
+    }
+
+    if question && !@game.finished?
+      counts = question.game_answers.group(:game_option_id).count
+      answered_count = counts.values.sum
+      details = {
+        position: question.position,
+        total: question_count,
+        text: question.text,
+        answers_count: answered_count,
+        players_count: player_count,
+        options: question.game_options.map do |option|
+          option_state = { id: option.id, text: option.text }
+          if @game.question_closed?
+            option_state[:answers_count] = counts.fetch(option.id, 0)
+            option_state[:correct] = option.correct?
+          end
+          option_state
+        end
+      }
+      state[:question] = details
+    else
+      state[:question] = nil
+    end
+
+    state
+  end
+
+  # This payload is intentionally player-safe. In particular, it never serializes
+  # GameOption#correct, even after the moderator closes a question.
+  def player_state
+    state = {
+      status: @game.status,
+      title: @game.title,
+      player_name: @player&.name
+    }
+
+    question = @game.current_question
+    if question && !@game.finished?
+      answer = @player&.game_answers&.find_by(game_question_id: question.id)
+      question_state = {
+        position: question.position,
+        total: @game.game_questions.count,
+        text: question.text,
+        options: question.game_options.map { |option| { id: option.id, text: option.text } }
+      }
+
+      if @game.question_open?
+        question_state[:selected_option_id] = answer&.game_option_id
+      elsif @game.question_closed?
+        question_state[:feedback] = if answer.nil?
+          "No answer"
+        elsif answer.game_option.correct?
+          "Correct!"
+        else
+          "Wrong!"
+        end
+      end
+      state[:question] = question_state
+    else
+      state[:question] = nil
+    end
+
+    state
+  end
+end
diff --git a/app/views/moderate/games/show.html.erb b/app/views/moderate/games/show.html.erb
new file mode 100644
index 0000000..b66eeaa
--- /dev/null
+++ b/app/views/moderate/games/show.html.erb
@@ -0,0 +1,98 @@
+<% content_for :title, "Live game · #{@game.title} · Quizzy" %>
+
+<main class="screen cover cover--night live-game"
+      data-controller="live-game"
+      data-action="click->live-game#act"
+      data-live-game-state-url-value="<%= state_moderate_game_path(@game) %>"
+      data-live-game-channel-code-value="<%= @game.code %>"
+      data-live-game-start-url-value="<%= start_moderate_game_path(@game) %>"
+      data-live-game-finish-url-value="<%= finish_question_moderate_game_path(@game) %>"
+      data-live-game-advance-url-value="<%= advance_moderate_game_path(@game) %>">
+  <header class="screen__top">
+    <%= link_to moderate_root_path, class: "logo screen__logo", aria: { label: "Quizzy moderator home" } do %>
+      <span class="logo__mark">?</span>Quizzy
+    <% end %>
+    <span class="live-game__title"><%= @game.title %></span>
+  </header>
+
+  <section class="screen__body lobby" data-live-game-target="lobby" <%= "hidden" unless @game.waiting? %>>
+    <div class="lobby__copy">
+      <p class="screen__kicker">Join the quiz</p>
+      <h1 class="lobby__title" data-live-game-target="quizTitle"><%= @game.title %></h1>
+      <p class="lobby__join">Join at</p>
+      <p class="lobby__url" data-live-game-target="joinUrl"><%= @join_url %></p>
+      <span class="counter-pill" data-live-game-target="lobbyCounter">Players: <strong><%= @state[:players_count] %></strong></span>
+      <% if @state[:question_count].zero? %>
+        <p class="live-game__error">This quiz has no active questions.</p>
+      <% end %>
+    </div>
+    <div class="qr" role="img" aria-label="QR code for <%= @join_url %>"><%= game_qr_svg(@join_url).html_safe %></div>
+  </section>
+
+  <section class="screen__body stage-question" data-live-game-target="questionPanel" <%= "hidden" unless @game.question_open? %>>
+    <% if question = @state[:question] %>
+      <div class="stage-question__num" data-live-game-target="progress">Question <%= question[:position] %> of <%= question[:total] %></div>
+      <h1 class="stage-question__body" data-live-game-target="questionText"><%= question[:text] %></h1>
+      <ol class="stage-options" data-live-game-target="options">
+        <% question[:options].each_with_index do |option, index| %>
+          <li class="stage-option">
+            <span class="stage-option__letter"><%= option_letter(index) %></span>
+            <span class="stage-option__title"><%= option[:text] %></span>
+          </li>
+        <% end %>
+      </ol>
+    <% else %>
+      <div class="stage-question__num" data-live-game-target="progress"></div>
+      <h1 class="stage-question__body" data-live-game-target="questionText"></h1>
+      <ol class="stage-options" data-live-game-target="options"></ol>
+    <% end %>
+  </section>
+
+  <section class="screen__body stage-results" data-live-game-target="resultsPanel" <%= "hidden" unless @game.question_closed? %>>
+    <% if question = @state[:question] %>
+      <div class="stage-question__num" data-live-game-target="resultsProgress">Question <%= question[:position] %> of <%= question[:total] %></div>
+      <h1 class="stage-question__body" data-live-game-target="resultsQuestionText"><%= question[:text] %></h1>
+      <ol class="stage-options stage-options--results" data-live-game-target="resultsOptions">
+        <% question[:options].each_with_index do |option, index| %>
+          <li class="stage-option <%= 'is-correct' if option[:correct] %>">
+            <span class="stage-option__letter"><%= option_letter(index) %></span>
+            <span class="stage-option__title"><%= option[:text] %></span>
+            <span class="stage-option__count"><%= pluralize(option[:answers_count], "answer") %></span>
+            <% if option[:correct] %><span class="stage-option__mark">Correct</span><% end %>
+          </li>
+        <% end %>
+      </ol>
+    <% else %>
+      <div class="stage-question__num" data-live-game-target="resultsProgress"></div>
+      <h1 class="stage-question__body" data-live-game-target="resultsQuestionText"></h1>
+      <ol class="stage-options stage-options--results" data-live-game-target="resultsOptions"></ol>
+    <% end %>
+  </section>
+
+  <section class="screen__body result-card live-game__over" data-live-game-target="overPanel" <%= "hidden" unless @game.finished? %>>
+    <div class="result-card__label">Thanks for playing</div>
+    <h1 class="play-title">The quiz is over</h1>
+    <%= link_to "Back to quiz", moderate_quiz_path(@game.quiz), class: "btn btn--light" %>
+  </section>
+
+  <footer class="screen-controls">
+    <div class="screen-controls__info">
+      <span class="answers-counter" data-live-game-target="counter">
+        <% if @game.question_open? && @state[:question] %>
+          Answers: <%= @state[:question][:answers_count] %> / <%= @state[:question][:players_count] %>
+        <% elsif @game.question_closed? && @state[:question] %>
+          Answers: <%= @state[:question][:answers_count] %> / <%= @state[:question][:players_count] %>
+        <% else %>
+          Players: <%= @state[:players_count] %>
+        <% end %>
+      </span>
+      <span class="live-game__error" data-live-game-target="error" role="status" aria-live="polite"></span>
+    </div>
+    <div class="buttons" data-live-game-target="controls">
+      <%= link_to "Back to quiz", moderate_quiz_path(@game.quiz), class: "btn btn--light btn--sm" %>
+      <button type="button" class="btn btn--pink btn--lg" data-live-game-target="startButton" data-game-action="start" <%= "hidden" unless @game.waiting? %> <%= "disabled" if @state[:question_count].zero? %>>Start</button>
+      <button type="button" class="btn btn--pink btn--lg" data-live-game-target="finishButton" data-game-action="finish" <%= "hidden" unless @game.question_open? %>>Finish</button>
+      <button type="button" class="btn btn--pink btn--lg" data-live-game-target="advanceButton" data-game-action="advance" <%= "hidden" unless @game.question_closed? %>><%= @state[:question] && @state[:question][:position] == @state[:question][:total] ? "End quiz" : "Next" %></button>
+    </div>
+  </footer>
+</main>
