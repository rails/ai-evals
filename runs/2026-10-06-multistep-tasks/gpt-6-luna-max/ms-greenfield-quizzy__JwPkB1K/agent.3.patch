+class GameChannel < ApplicationCable::Channel
+  def subscribed
+    code = params[:code].to_s.upcase
+    return reject unless code.match?(/\A[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{5}\z/)
+    return reject unless Game.exists?(code: code)
+
+    stream_from "game:#{code}"
+  end
+end
