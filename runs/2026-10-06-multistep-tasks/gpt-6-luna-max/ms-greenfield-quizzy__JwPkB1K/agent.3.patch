+class GameAnswer < ApplicationRecord
+  belongs_to :game_player
+  belongs_to :game_question
+  belongs_to :game_option
+
+  validates :game_question_id, uniqueness: { scope: :game_player_id }
+  validate :option_belongs_to_question
+  validate :player_and_question_belong_to_same_game
+
+  private
+
+  def option_belongs_to_question
+    return if game_option.blank? || game_question.blank? || game_option.game_question_id == game_question_id
+
+    errors.add(:game_option, "must belong to the answered question")
+  end
+
+  def player_and_question_belong_to_same_game
+    return if game_player.blank? || game_question.blank? || game_player.game_id == game_question.game_id
+
+    errors.add(:game_player, "must belong to the question's game")
+  end
+end
