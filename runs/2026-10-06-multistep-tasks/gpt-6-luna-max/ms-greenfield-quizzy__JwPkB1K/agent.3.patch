diff --git a/app/javascript/controllers/live_game_controller.js b/app/javascript/controllers/live_game_controller.js
new file mode 100644
index 0000000..12427f6
--- /dev/null
+++ b/app/javascript/controllers/live_game_controller.js
@@ -0,0 +1,203 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = [
+    "lobby", "quizTitle", "joinUrl", "lobbyCounter", "questionPanel", "progress",
+    "questionText", "options", "resultsPanel", "resultsProgress", "resultsQuestionText",
+    "resultsOptions", "overPanel", "counter", "error", "startButton", "finishButton",
+    "advanceButton"
+  ]
+  static values = {
+    stateUrl: String,
+    channelCode: String,
+    startUrl: String,
+    finishUrl: String,
+    advanceUrl: String
+  }
+
+  connect() {
+    this.stopped = false
+    this.socketConnected = false
+    this.refreshing = false
+    this.pendingRefresh = false
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      { channel: "GameChannel", code: this.channelCodeValue },
+      {
+        connected: () => {
+          this.socketConnected = true
+          this.schedulePoll(12000)
+          this.refresh()
+        },
+        disconnected: () => {
+          this.socketConnected = false
+          this.schedulePoll(1800)
+        },
+        rejected: () => {
+          this.socketConnected = false
+          this.schedulePoll(1800)
+        },
+        received: () => this.refresh()
+      }
+    )
+    this.moderatorSubscription = this.consumer.subscriptions.create(
+      { channel: "GameModerationChannel", code: this.channelCodeValue },
+      { received: () => this.refresh() }
+    )
+    this.schedulePoll(1800)
+    this.refresh()
+  }
+
+  disconnect() {
+    this.stopped = true
+    clearTimeout(this.pollTimer)
+    this.subscription?.unsubscribe()
+    this.moderatorSubscription?.unsubscribe()
+    this.consumer?.disconnect()
+  }
+
+  schedulePoll(delay) {
+    clearTimeout(this.pollTimer)
+    const jitteredDelay = delay + Math.random() * Math.min(1000, delay * 0.25)
+    this.pollTimer = setTimeout(async () => {
+      if (this.stopped) return
+      await this.refresh()
+      this.schedulePoll(this.socketConnected ? 15000 : 1800)
+    }, jitteredDelay)
+  }
+
+  async refresh() {
+    if (this.refreshing) {
+      this.pendingRefresh = true
+      return
+    }
+
+    this.refreshing = true
+    try {
+      const response = await fetch(this.stateUrlValue, {
+        headers: { Accept: "application/json" },
+        credentials: "same-origin",
+        cache: "no-store"
+      })
+      if (!response.ok) throw new Error("Unable to update the game screen.")
+      this.renderState(await response.json())
+    } catch (_error) {
+      // Keep the last good screen visible; the websocket/poll loop will retry.
+    } finally {
+      this.refreshing = false
+      if (this.pendingRefresh && !this.stopped) {
+        this.pendingRefresh = false
+        this.refresh()
+      }
+    }
+  }
+
+  async act(event) {
+    const button = event.target.closest("button[data-game-action]")
+    if (!button || button.disabled) return
+
+    const action = button.dataset.gameAction
+    const url = {
+      start: this.startUrlValue,
+      finish: this.finishUrlValue,
+      advance: this.advanceUrlValue
+    }[action]
+    if (!url) return
+
+    button.disabled = true
+    this.errorTarget.textContent = ""
+    try {
+      const response = await fetch(url, {
+        method: "POST",
+        headers: {
+          Accept: "application/json",
+          "X-CSRF-Token": document.querySelector("meta[name='csrf-token']")?.content || ""
+        },
+        credentials: "same-origin"
+      })
+      const state = await response.json()
+      if (!response.ok) throw new Error(state.error || "The game could not be updated.")
+      this.renderState(state)
+    } catch (error) {
+      this.errorTarget.textContent = error.message
+      await this.refresh()
+    } finally {
+      button.disabled = false
+    }
+  }
+
+  renderState(state) {
+    this.currentState = state
+    this.quizTitleTarget.textContent = state.title
+
+    const status = state.status
+    this.lobbyTarget.hidden = status !== "waiting"
+    this.questionPanelTarget.hidden = status !== "question_open"
+    this.resultsPanelTarget.hidden = status !== "question_closed"
+    this.overPanelTarget.hidden = status !== "finished"
+
+    if (status === "waiting") {
+      this.lobbyCounterTarget.textContent = `Players: ${state.players_count}`
+      this.counterTarget.textContent = `Players: ${state.players_count}`
+      this.startButtonTarget.hidden = false
+      this.startButtonTarget.disabled = state.question_count === 0
+      this.finishButtonTarget.hidden = true
+      this.advanceButtonTarget.hidden = true
+    } else if (status === "question_open" || status === "question_closed") {
+      const question = state.question
+      if (!question) return
+      const progress = `Question ${question.position} of ${question.total}`
+      this.counterTarget.textContent = `Answers: ${question.answers_count} / ${question.players_count}`
+      this.startButtonTarget.hidden = true
+      this.finishButtonTarget.hidden = status !== "question_open"
+      this.advanceButtonTarget.hidden = status !== "question_closed"
+      this.advanceButtonTarget.textContent = question.position === question.total ? "End quiz" : "Next"
+
+      if (status === "question_open") {
+        this.progressTarget.textContent = progress
+        this.questionTextTarget.textContent = question.text
+        this.optionsTarget.replaceChildren(...question.options.map((option, index) => this.stageOption(option, index, false)))
+      } else {
+        this.resultsProgressTarget.textContent = progress
+        this.resultsQuestionTextTarget.textContent = question.text
+        this.resultsOptionsTarget.replaceChildren(...question.options.map((option, index) => this.stageOption(option, index, true)))
+      }
+    } else {
+      this.counterTarget.textContent = ""
+      this.startButtonTarget.hidden = true
+      this.finishButtonTarget.hidden = true
+      this.advanceButtonTarget.hidden = true
+    }
+  }
+
+  stageOption(option, index, results) {
+    const item = document.createElement("li")
+    item.className = "stage-option"
+    if (results && option.correct) item.classList.add("is-correct")
+
+    const letter = document.createElement("span")
+    letter.className = "stage-option__letter"
+    letter.textContent = String.fromCharCode(65 + (index % 26))
+
+    const title = document.createElement("span")
+    title.className = "stage-option__title"
+    title.textContent = option.text
+    item.append(letter, title)
+
+    if (results) {
+      const count = document.createElement("span")
+      count.className = "stage-option__count"
+      count.textContent = `${option.answers_count} ${option.answers_count === 1 ? "answer" : "answers"}`
+      item.append(count)
+      if (option.correct) {
+        const mark = document.createElement("span")
+        mark.className = "stage-option__mark"
+        mark.textContent = "Correct"
+        item.append(mark)
+      }
+    }
+
+    return item
+  }
+}
diff --git a/app/javascript/controllers/live_player_controller.js b/app/javascript/controllers/live_player_controller.js
new file mode 100644
index 0000000..c210507
--- /dev/null
+++ b/app/javascript/controllers/live_player_controller.js
@@ -0,0 +1,220 @@
+import { Controller } from "@hotwired/stimulus"
+import { createConsumer } from "@rails/actioncable"
+
+export default class extends Controller {
+  static targets = ["content", "title"]
+  static values = { stateUrl: String, answerUrl: String, channelCode: String }
+
+  connect() {
+    this.stopped = false
+    this.socketConnected = false
+    this.refreshing = false
+    this.pendingRefresh = false
+    this.selectionSequence = 0
+    this.pendingOptionId = null
+    this.answerQueue = Promise.resolve()
+    this.consumer = createConsumer()
+    this.subscription = this.consumer.subscriptions.create(
+      { channel: "GameChannel", code: this.channelCodeValue },
+      {
+        connected: () => {
+          this.socketConnected = true
+          this.schedulePoll(12000)
+          this.refresh()
+        },
+        disconnected: () => {
+          this.socketConnected = false
+          this.schedulePoll(1800)
+        },
+        rejected: () => {
+          this.socketConnected = false
+          this.schedulePoll(1800)
+        },
+        received: () => this.refresh()
+      }
+    )
+    this.schedulePoll(1800)
+    this.refresh()
+  }
+
+  disconnect() {
+    this.stopped = true
+    clearTimeout(this.pollTimer)
+    this.subscription?.unsubscribe()
+    this.consumer?.disconnect()
+  }
+
+  schedulePoll(delay) {
+    clearTimeout(this.pollTimer)
+    const jitteredDelay = delay + Math.random() * Math.min(1000, delay * 0.25)
+    this.pollTimer = setTimeout(async () => {
+      if (this.stopped) return
+      await this.refresh()
+      this.schedulePoll(this.socketConnected ? 15000 : 1800)
+    }, jitteredDelay)
+  }
+
+  async refresh() {
+    if (this.refreshing) {
+      this.pendingRefresh = true
+      return
+    }
+
+    this.refreshing = true
+    try {
+      const response = await fetch(this.stateUrlValue, {
+        headers: { Accept: "application/json" },
+        credentials: "same-origin",
+        cache: "no-store"
+      })
+      if (!response.ok) throw new Error("Unable to update the game.")
+      this.renderState(await response.json())
+    } catch (_error) {
+      // Keep the last good view; reconnecting sockets and the fallback poll retry.
+    } finally {
+      this.refreshing = false
+      if (this.pendingRefresh && !this.stopped) {
+        this.pendingRefresh = false
+        this.refresh()
+      }
+    }
+  }
+
+  answer(event) {
+    const button = event.target.closest("button[data-option-id]")
+    if (!button || button.disabled || !this.currentState || this.currentState.status !== "question_open") return
+
+    const optionId = button.dataset.optionId
+    const selection = ++this.selectionSequence
+    this.pendingOptionId = optionId
+    this.renderState(this.currentState)
+
+    this.answerQueue = this.answerQueue.catch(() => {}).then(async () => {
+      const response = await fetch(this.answerUrlValue, {
+        method: "POST",
+        headers: {
+          Accept: "application/json",
+          "Content-Type": "application/json",
+          "X-CSRF-Token": document.querySelector("meta[name='csrf-token']")?.content || ""
+        },
+        credentials: "same-origin",
+        body: JSON.stringify({ answer: { option_id: optionId } })
+      })
+      const payload = await response.json()
+      if (!response.ok) throw new Error(payload.error || "Your answer could not be saved.")
+      if (selection === this.selectionSequence) this.pendingOptionId = null
+      this.renderState(payload)
+    }).catch(async () => {
+      if (selection === this.selectionSequence) this.pendingOptionId = null
+      await this.refresh()
+    })
+  }
+
+  renderState(state) {
+    this.currentState = state
+    this.titleTarget.textContent = state.title
+
+    if (state.status === "finished") {
+      this.contentTarget.replaceChildren(this.overPanel())
+      this.pendingOptionId = null
+      return
+    }
+
+    // Unjoined browsers keep their name form until they join; they still receive
+    // the over state above if the moderator ends the session while it is open.
+    if (!state.player_name) return
+
+    const greeting = document.createElement("p")
+    greeting.className = "player-greeting"
+    greeting.textContent = `Hi, ${state.player_name}!`
+    const content = [greeting]
+
+    if (state.status === "waiting") {
+      const waiting = document.createElement("section")
+      waiting.className = "waiting"
+      const gem = document.createElement("div")
+      gem.className = "waiting__gem"
+      gem.setAttribute("aria-hidden", "true")
+      gem.textContent = "?"
+      const message = document.createElement("p")
+      message.className = "play-lead"
+      message.textContent = "Waiting for the quiz to start"
+      waiting.append(gem, message)
+      content.push(waiting)
+    } else if (state.question) {
+      content.push(this.questionPanel(state))
+    }
+
+    this.contentTarget.replaceChildren(...content)
+  }
+
+  questionPanel(state) {
+    const question = state.question
+    const panel = document.createElement("section")
+    panel.className = "player-question"
+
+    const progress = document.createElement("div")
+    progress.className = "play-question__num"
+    progress.textContent = `Question ${question.position} of ${question.total}`
+
+    const text = document.createElement("h1")
+    text.className = "play-question__body"
+    text.textContent = question.text
+
+    const options = document.createElement("div")
+    options.className = "play-options"
+    const selectedId = this.pendingOptionId ?? question.selected_option_id
+    question.options.forEach((option, index) => {
+      const button = document.createElement("button")
+      button.type = "button"
+      button.className = "play-option"
+      button.dataset.optionId = option.id
+      button.disabled = state.status !== "question_open"
+      if (String(selectedId) === String(option.id)) button.classList.add("is-picked")
+
+      const letter = document.createElement("span")
+      letter.className = "play-option__letter"
+      letter.textContent = String.fromCharCode(65 + (index % 26))
+      const title = document.createElement("span")
+      title.className = "play-option__title"
+      title.textContent = option.text
+      button.append(letter, title)
+
+      if (state.status === "question_open" && String(selectedId) === String(option.id)) {
+        const marker = document.createElement("span")
+        marker.className = "play-option__mark"
+        marker.textContent = "Your answer"
+        button.append(marker)
+      }
+      options.append(button)
+    })
+
+    panel.append(progress, text, options)
+    if (question.feedback) {
+      const feedback = document.createElement("div")
+      feedback.className = "play-status"
+      if (question.feedback === "Correct!") feedback.classList.add("play-status--right")
+      if (question.feedback === "Wrong!") feedback.classList.add("play-status--wrong")
+      if (question.feedback === "No answer") feedback.classList.add("play-status--neutral")
+      feedback.setAttribute("role", "status")
+      feedback.setAttribute("aria-live", "polite")
+      feedback.textContent = question.feedback
+      panel.append(feedback)
+    }
+
+    return panel
+  }
+
+  overPanel() {
+    const section = document.createElement("section")
+    section.className = "result-card"
+    const label = document.createElement("div")
+    label.className = "result-card__label"
+    label.textContent = "Thanks for playing"
+    const title = document.createElement("h1")
+    title.className = "play-title"
+    title.textContent = "The quiz is over"
+    section.append(label, title)
+    return section
+  }
+}
diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..f39084b
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,109 @@
+class Game < ApplicationRecord
+  CODE_ALPHABET = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ".freeze
+  CODE_LENGTH = 5
+
+  class InvalidTransition < StandardError; end
+  class NoActiveQuestions < StandardError; end
+  class InvalidAnswer < StandardError; end
+
+  belongs_to :quiz
+  has_many :game_questions, -> { order(:position, :id) }, dependent: :destroy
+  has_many :game_players, dependent: :destroy
+
+  enum :status, {
+    waiting: "waiting",
+    question_open: "question_open",
+    question_closed: "question_closed",
+    finished: "finished"
+  }
+
+  validates :title, :code, presence: true
+  validates :code, uniqueness: true
+
+  def self.create_for_quiz!(quiz)
+    transaction do
+      game = create!(quiz: quiz, title: quiz.title, code: unique_code)
+      questions = quiz.questions.where(active: true).includes(:quiz_options).order(:position, :id)
+
+      questions.each_with_index do |question, question_index|
+        game_question = game.game_questions.create!(text: question.text, position: question_index + 1)
+        question.quiz_options.each_with_index do |option, option_index|
+          game_question.game_options.create!(text: option.text, correct: option.correct?, position: option_index + 1)
+        end
+      end
+
+      game
+    end
+  end
+
+  def self.unique_code
+    loop do
+      code = Array.new(CODE_LENGTH) { CODE_ALPHABET[SecureRandom.random_number(CODE_ALPHABET.length)] }.join
+      return code unless exists?(code: code)
+    end
+  end
+
+  def current_question
+    return unless current_position.positive?
+
+    game_questions.find_by(position: current_position)
+  end
+
+  def start!
+    changed = false
+    with_lock do
+      if waiting?
+        first_question = game_questions.first
+        raise NoActiveQuestions if first_question.nil?
+
+        update!(status: :question_open, current_position: first_question.position)
+        changed = true
+      end
+    end
+    GameBroadcaster.broadcast(self) if changed
+    changed
+  end
+
+  def finish_question!
+    changed = false
+    with_lock do
+      if question_open?
+        update!(status: :question_closed)
+        changed = true
+      end
+    end
+    GameBroadcaster.broadcast(self) if changed
+    changed
+  end
+
+  def advance!
+    changed = false
+    with_lock do
+      if question_closed?
+        next_question = game_questions.where("position > ?", current_position).first
+        if next_question
+          update!(status: :question_open, current_position: next_question.position)
+        else
+          update!(status: :finished)
+        end
+        changed = true
+      end
+    end
+    GameBroadcaster.broadcast(self) if changed
+    changed
+  end
+
+  def record_answer!(player, option_id)
+    with_lock do
+      raise InvalidAnswer, "This question is not accepting answers." unless question_open?
+      question = current_question
+      option = question&.game_options&.find_by(id: option_id)
+      raise InvalidAnswer, "Choose an option for the current question." unless option
+      raise InvalidAnswer, "This player is not part of the game." unless player.game_id == id
+
+      answer = GameAnswer.find_or_initialize_by(game_player: player, game_question: question)
+      answer.update!(game_option: option)
+    end
+    GameBroadcaster.broadcast_moderators(self)
+  end
+end
