diff --git a/app/services/images/profile_image.rb b/app/services/images/profile_image.rb
new file mode 100644
index 0000000..ab24dbd
--- /dev/null
+++ b/app/services/images/profile_image.rb
@@ -0,0 +1,23 @@
+module Images
+  # Preserve the public CarrierWave reader/JSON interface while the two stores
+  # coexist. Active Storage's attachment proxy has a different JSON contract.
+  class ProfileImage
+    def initialize(record)
+      @record = record
+    end
+
+    def url
+      @record.profile_image_url
+    end
+
+    def blank?
+      !@record.profile_image_asset.attached? && @record[:profile_image].blank?
+    end
+
+    delegate :to_s, to: :url
+
+    def as_json(*)
+      { "url" => url }
+    end
+  end
+end
