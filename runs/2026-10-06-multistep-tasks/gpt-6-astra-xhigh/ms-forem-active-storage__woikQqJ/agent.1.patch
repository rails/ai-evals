+require "rails_helper"
+
+RSpec.describe "Active Storage profile images" do
+  it "serves an uploaded avatar to anonymous visitors through the permanent proxy URL" do
+    user = create(:user)
+    url = user.profile_image_url
+
+    get URI(url).request_uri
+
+    expect(response).to have_http_status(:ok)
+    expect(response.body.b).to eq(user.profile_image_attachment.download)
+    expect(response.headers["Content-Type"]).to start_with("image/")
+  end
+
+  it "does not let catch-all page routes shadow Active Storage routes" do
+    paths = {
+      "/rails/active_storage/blobs/proxy/signed-id/avatar.png" => "active_storage/blobs/proxy",
+      "/rails/active_storage/blobs/redirect/signed-id/avatar.png" => "active_storage/blobs/redirect",
+      "/rails/active_storage/disk/encoded-key/avatar.png" => "active_storage/disk"
+    }
+    paths.each do |path, controller|
+      expect(Rails.application.routes.recognize_path(path)).to include(controller: controller, action: "show")
+    end
+  end
+end
