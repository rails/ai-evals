@@ -0,0 +1,23 @@
+module Images
+  # The small CarrierWave read interface used by views and serialized profiles.
+  # Use a permanent app URL, not an expiring storage-service URL, because these
+  # URLs are also persisted in article, notification and search caches.
+  class ProfileImage
+    def initialize(attachment, fallback_url: nil)
+      @attachment = attachment
+      @fallback_url = fallback_url
+    end
+
+    def url
+      return @fallback_url unless @attachment.blob.persisted?
+
+      URL.url(Rails.application.routes.url_helpers.rails_storage_proxy_path(@attachment.blob))
+    end
+
+    delegate :to_s, to: :url
+
+    def as_json(*)
+      { "url" => url }
+    end
+  end
+end
