+module User::Bot
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :bots, -> { bot }, class_name: "User", foreign_key: :creator_id, dependent: :destroy, inverse_of: :creator
+
+    validates :name, :creator, presence: true, if: :bot?
+    before_validation :set_bot_credentials, on: :create, if: :bot?
+  end
+
+  private
+    def set_bot_credentials
+      self.bot_token ||= SecureRandom.base58(32)
+      self.password_digest = ""
+    end
+end
