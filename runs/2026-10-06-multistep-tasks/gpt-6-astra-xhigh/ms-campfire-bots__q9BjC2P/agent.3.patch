diff --git a/app/models/room/bot_join.rb b/app/models/room/bot_join.rb
new file mode 100644
index 0000000..702ba76
--- /dev/null
+++ b/app/models/room/bot_join.rb
@@ -0,0 +1,23 @@
+# Kept independently of memberships so removing and re-adding a bot doesn't
+# greet the same room twice. Creating a membership and its join is atomic.
+class Room::BotJoin < ApplicationRecord
+  belongs_to :room
+  belongs_to :bot, class_name: "User"
+
+  after_create_commit :notify_bot
+
+  def deliver
+    # Claim before making the request: like mentions, delivery is best-effort,
+    # and a failed request must not be retried and cause duplicate side effects.
+    if self.class.where(id: id, delivery_attempted_at: nil).update_all(delivery_attempted_at: Time.current) == 1
+      unless room.direct?
+        BotWebhook.new(room: room, bot: bot, event: "joined").deliver
+      end
+    end
+  end
+
+  private
+    def notify_bot
+      Room::BotJoinedJob.perform_later(self) if bot.active? && bot.webhook_url.present?
+    end
+end
