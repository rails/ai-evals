+require "test_helper"
+
+class Room::BotJoinTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:david).bots.create!(name: "Greeter", webhook_url: "https://bot.example.com/joined")
+  end
+
+  test "manual grants notify once per room even after revocation and rejoining" do
+    [ rooms(:hq), rooms(:designers) ].each do |room|
+      assert_enqueued_jobs 1, only: Room::BotJoinedJob do
+        room.memberships.grant_to([ @bot, @bot ])
+        room.memberships.grant_to(@bot)
+        room.memberships.revoke_from(@bot)
+        room.memberships.grant_to(@bot)
+        room.memberships.find_by!(user: @bot).update!(involvement: "nothing")
+      end
+      assert_equal 1, room.bot_joins.where(bot: @bot).count
+      assert_equal 1, room.memberships.where(user: @bot).count
+    end
+  end
+
+  test "automatic grants notify only newly joined rooms" do
+    rooms(:hq).memberships.grant_to(@bot)
+    assert_enqueued_jobs Rooms::Open.count - 1, only: Room::BotJoinedJob do
+      @bot.update! auto_join_open_rooms: true
+    end
+
+    assert_no_enqueued_jobs only: Room::BotJoinedJob do
+      @bot.update! auto_join_open_rooms: false
+      @bot.update! auto_join_open_rooms: true
+      @bot.update! name: "Renamed"
+    end
+
+    assert_enqueued_jobs 1, only: Room::BotJoinedJob do
+      Rooms::Open.create_for({ name: "New open room", creator: users(:david) }, users: @bot)
+    end
+  end
+
+  test "creating an opted in bot notifies every existing open room" do
+    assert_enqueued_jobs Rooms::Open.count, only: Room::BotJoinedJob do
+      users(:david).bots.create!(name: "Greeter 2", webhook_url: @bot.webhook_url, auto_join_open_rooms: true)
+    end
+  end
+
+  test "opening a closed room adds only opted in bots and does not renotify existing bots" do
+    @bot.update! auto_join_open_rooms: true
+    manual_bot = users(:david).bots.create!(name: "Manual", webhook_url: @bot.webhook_url)
+    room = rooms(:designers)
+    room.memberships.grant_to(manual_bot)
+
+    assert_enqueued_jobs 1, only: Room::BotJoinedJob do
+      room.becomes!(Rooms::Open).save!
+    end
+    assert_includes Room.find(room.id).users, @bot
+    assert_includes room.users, manual_bot
+  end
+
+  test "direct conversations do not record or notify joins" do
+    assert_no_difference -> { Room::BotJoin.count } do
+      assert_no_enqueued_jobs only: Room::BotJoinedJob do
+        room = Rooms::Direct.create_for({ creator: users(:david) }, users: [ users(:david), @bot ])
+        assert_equal "everything", room.memberships.find_by!(user: @bot).involvement
+      end
+    end
+  end
+
+  test "no webhook inactive bots and people do not enqueue deliveries" do
+    assert_no_enqueued_jobs only: Room::BotJoinedJob do
+      @bot.update! webhook_url: nil
+      rooms(:hq).memberships.grant_to(@bot)
+      @bot.update! webhook_url: "https://bot.example.com/joined", status: :banned
+      rooms(:designers).memberships.grant_to(@bot)
+      rooms(:designers).memberships.grant_to(users(:bender))
+    end
+  end
+
+  test "membership creation through the association also notifies" do
+    assert_enqueued_jobs 1, only: Room::BotJoinedJob do
+      @bot.memberships.create!(room: rooms(:hq))
+    end
+  end
+
+  test "rolled back memberships do not record or enqueue joins" do
+    assert_no_difference -> { Room::BotJoin.count } do
+      assert_no_enqueued_jobs only: Room::BotJoinedJob do
+        Membership.transaction do
+          rooms(:hq).memberships.grant_to(@bot)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..543f16e
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "members cannot create more than five bots by default" do
+    member = users(:kevin)
+    5.times { |index| member.bots.create!(name: "Bot #{index}") }
+
+    assert_not member.can_create_bot?
+    assert_no_difference -> { User.count } do
+      bot = User.new(role: :bot, creator: member, name: "One too many")
+      assert_not bot.save
+      assert_includes bot.errors.full_messages.to_sentence, "reached the limit"
+    end
+    assert users(:jz).can_create_bot?
+    assert users(:jz).bots.create(name: "Another member's bot").persisted?
+  end
+
+  test "deleted bots do not count but banned bots still count" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    member = users(:kevin)
+    bot = member.bots.create!(name: "Bot")
+    bot.banned!
+    assert_not member.can_create_bot?
+
+    bot.deactivate
+    assert member.can_create_bot?
+    assert member.bots.create(name: "Replacement").persisted?
+    assert_not member.can_create_bot?
+  end
+
+  test "lowering the limit preserves existing bots and allows edits but not creation" do
+    member = users(:kevin)
+    bots = 3.times.map { |index| member.bots.create!(name: "Bot #{index}") }
+
+    assert_no_difference -> { member.bots.not_deactivated.count } do
+      accounts(:signal).update!(settings: { bots_per_member: 1 })
+    end
+    assert_not member.bots.create(name: "Extra").persisted?
+    bots.each { |bot| bot.update!(name: "Renamed #{bot.id}") }
+
+    bots.first.deactivate
+    assert_not member.can_create_bot?
+    bots.second.deactivate
+    assert_not member.can_create_bot?
+    bots.third.deactivate
+    assert member.can_create_bot?
+  end
+
+  test "zero blocks members but administrators are never limited" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    assert_not users(:kevin).bots.create(name: "Member bot").persisted?
+    assert users(:david).can_create_bot?
+    6.times { |index| users(:david).bots.create!(name: "Admin bot #{index}") }
+  end
+
+  test "raising the limit allows more bots" do
+    member = users(:kevin)
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    member.bots.create!(name: "Bot")
+    assert_not member.can_create_bot?
+
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+    assert member.can_create_bot?
+    assert member.bots.create(name: "Another bot").persisted?
+    assert_not member.can_create_bot?
+  end
+
+  test "bots have unique stable credentials and do not join rooms by default" do
+    first = users(:kevin).bots.create!(name: "Deploy Bot")
+    second = users(:kevin).bots.create!(name: "Build Bot")
+
+    assert first.bot?
+    assert_equal users(:kevin), first.creator
+    assert_empty first.rooms
+    assert_match /\A[1-9A-HJ-NP-Za-km-z]{32}\z/, first.bot_token
+    assert_not_equal first.bot_token, second.bot_token
+    assert_no_changes -> { first.reload.bot_token } do
+      first.update! name: "Renamed Bot"
+    end
+    assert_not first.can_administer?
+    assert_nil users(:kevin).bot_token
+    assert_not_includes first.inspect, first.bot_token
+  end
+
+  test "webhook URLs are optional normalized and restricted to HTTP URLs" do
+    bot = users(:kevin).bots.new(name: "Deploy Bot")
+    assert bot.valid?
+
+    [ "https://bot.example.com/mention?secret=abc", "http://bot.example.com:8080/mention" ].each do |url|
+      bot.webhook_url = " #{url} "
+      assert bot.valid?, bot.errors.full_messages.to_sentence
+      assert_equal url, bot.webhook_url
+    end
+
+    [ "not a URL", "/relative", "ftp://bot.example.com", "javascript:alert(1)", "https://", "https://name:secret@bot.example.com", "https://bot.example.com/#fragment" ].each do |url|
+      bot.webhook_url = url
+      assert_not bot.valid?, "Accepted #{url}"
+      assert bot.errors[:webhook_url].any?
+    end
+
+    bot.webhook_url = " \n\t "
+    assert bot.valid?
+    assert_nil bot.webhook_url
+  end
+
+  test "new open rooms do not include bots by default" do
+    bot = users(:kevin).bots.create!(name: "Deploy Bot")
+    room = Rooms::Open.create!(name: "New open room", creator: users(:kevin))
+    assert_not_includes room.users, bot
+  end
+
+  test "opting in joins existing and future open rooms but not closed or direct rooms" do
+    bot = users(:kevin).bots.create!(name: "Deploy Bot", auto_join_open_rooms: true)
+    assert_equal Rooms::Open.ids.sort, bot.room_ids.sort
+
+    room = Rooms::Open.create!(name: "New open room", creator: users(:kevin))
+    assert_includes room.users, bot
+  end
+
+  test "enabling joins existing rooms and disabling keeps memberships but stops future joins" do
+    bot = users(:kevin).bots.create!(name: "Deploy Bot")
+    rooms(:designers).memberships.grant_to(bot)
+    bot.update! auto_join_open_rooms: true
+    assert_equal (Rooms::Open.ids + [ rooms(:designers).id ]).sort, bot.room_ids.sort
+
+    assert_no_difference -> { bot.memberships.count } do
+      bot.update! auto_join_open_rooms: false
+    end
+    room = Rooms::Open.create!(name: "Later room", creator: users(:kevin))
+    assert_not_includes room.users, bot
+
+    bot.update! auto_join_open_rooms: true
+    assert_includes room.users, bot
+  end
+
+  test "inactive opted in bots are not added to new open rooms" do
+    banned = users(:kevin).bots.create!(name: "Banned Bot", auto_join_open_rooms: true)
+    deactivated = users(:kevin).bots.create!(name: "Deleted Bot", auto_join_open_rooms: true)
+    banned.banned!
+    deactivated.deactivate
+
+    room = Rooms::Open.create!(name: "New room", creator: users(:kevin))
+    assert_not_includes room.users, banned
+    assert_not_includes room.users, deactivated
+  end
+
+  test "people still join all existing and future open rooms" do
+    person = User.create!(name: "New person", email_address: "person@example.com", password: "secret123456")
+    assert_equal Rooms::Open.ids.sort, person.room_ids.sort
+    room = Rooms::Open.create!(name: "Later room", creator: users(:kevin))
+    assert_includes room.users, person
+  end
+
+  test "bots need a name and a creator" do
+    assert_not User.new(role: :bot, name: "Unowned").valid?
+    assert_not users(:kevin).bots.new(name: " ").valid?
+  end
+
+  test "deleting a bot preserves message history and removes shared memberships" do
+    bot = users(:kevin).bots.create!(name: "Deploy Bot")
+    message = rooms(:hq).messages.create!(creator: bot, body: "Shipped")
+
+    bot.deactivate
+
+    assert bot.reload.deactivated?
+    assert_empty bot.rooms
+    assert_equal "Deploy Bot", message.reload.creator.name
+  end
+end
