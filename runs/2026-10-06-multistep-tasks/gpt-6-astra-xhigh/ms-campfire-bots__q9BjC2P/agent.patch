diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..01e6a2a
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,40 @@
+# Bot codes are the only authentication for this endpoint, not browser sessions.
+class Bots::MessagesController < ActionController::API
+  include SetCurrentRequest, VersionHeaders
+
+  before_action :authenticate_bot
+  before_action :set_room
+
+  def create
+    body = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+
+    message = @room.messages.build
+    message.body = ERB::Util.html_escape(body).gsub("\n", "<br>") if body.valid_encoding?
+
+    case status = Current.user.post_bot_message(message)
+    when :created
+      message.broadcast_create
+      head :created, location: message_path(message)
+    when :too_many_requests
+      response.headers["Retry-After"] = Current.user.bot_retry_after.to_s
+      head status
+    else
+      head status
+    end
+  end
+
+  private
+    def authenticate_bot
+      Current.user = User.bot.where(status: %i[ active suspended ]).find_by(bot_token: request.path_parameters[:bot_token])
+      if Current.user
+        head :forbidden if Current.user.suspended?
+      else
+        head :unauthorized
+      end
+    end
+
+    def set_room
+      @room = Current.user.rooms.find_by(id: request.path_parameters[:room_id])
+      head :not_found unless @room
+    end
+end
