+require "application_system_test_case"
+
+class TimerSystemTest < ApplicationSystemTestCase
+  # The background worker must see real committed data, just as it does in Puma.
+  self.use_transactional_tests = false
+
+  setup do
+    @quiz = create_quiz(title: "Timed conference")
+    create_question(@quiz)
+    create_question(@quiz, body: "Second question")
+    @worker = GameTimer.new.start
+  end
+
+  teardown do
+    @worker&.stop
+    @quiz&.destroy!
+  end
+
+  test "settings default to zero, persist, and stay out of the export" do
+    visit edit_moderate_quiz_path(@quiz)
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+    fill_in "Timer minutes", with: "1"
+    fill_in "Timer seconds", with: "30"
+    click_on "Save quiz"
+    click_on "Settings"
+    assert_field "Timer minutes", with: "1"
+    assert_field "Timer seconds", with: "30"
+    click_on "Save quiz"
+    click_on "Export"
+    assert_equal %w[number_of_winners questions title], JSON.parse(find("pre").text).keys.sort
+    visit edit_moderate_quiz_path(@quiz)
+    fill_in "Timer minutes", with: "0"
+    fill_in "Timer seconds", with: "0"
+    click_on "Save quiz"
+    click_on "Start a game"
+    assert_no_selector "[data-countdown]"
+    click_on "Start"
+    assert_button "Finish"
+    assert_no_selector "[data-countdown]"
+    click_on "Finish"
+    assert_button "Next"
+  end
+
+  test "stage countdown uses M:SS, survives reload, and manual Finish still works" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    visit moderate_quiz_path(@quiz)
+    click_on "Start a game"
+    path = current_path
+    assert_no_selector "[data-countdown]"
+    click_on "Start"
+    assert_selector "[data-countdown]", text: "1:30"
+    assert_selector "[data-countdown]", text: "1:28", wait: 4
+    visit path
+    assert_selector "[data-countdown]", text: /1:2[678]/
+    click_on "Finish"
+    assert_button "Next"
+    assert_no_selector "[data-countdown]"
+    click_on "Next"
+    assert_selector "[data-countdown]", text: "1:30"
+    click_on "Finish"
+    click_on "End quiz"
+    assert_no_selector "[data-countdown]"
+  end
+
+  test "automatic Finish updates players, and also runs without the stage" do
+    @quiz.update!(timer_seconds: 5)
+    visit moderate_quiz_path(@quiz)
+    click_on "Start a game"
+    stage_path = current_path
+    join_url = find(".lobby__url").text
+    using_session(:timed_player) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_on "Join"
+      assert_text "Waiting for the start"
+      assert_selector "[data-connection]", exact_text: "Live"
+      # Verify server broadcasts, not a phone poll accidentally finishing it.
+      page.execute_script(<<~'JS')
+        window.noReload = true;
+        const originalFetch = window.fetch;
+        window.fetch = (url, options) => /\/(state|heartbeat)$/.test(url) ? Promise.reject(new Error('Push only')) : originalFetch(url, options);
+      JS
+    end
+    click_on "Start"
+    assert_selector "[data-countdown]", text: "0:05"
+    using_session(:timed_player) do
+      assert_text "Which planet is the largest?"
+      assert_no_selector "[data-countdown]", visible: :all
+      assert_no_text "0:05"
+      click_on "Jupiter"
+      assert_text "Your answer"
+    end
