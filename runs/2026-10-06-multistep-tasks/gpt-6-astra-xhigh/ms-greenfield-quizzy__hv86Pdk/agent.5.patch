+require "test_helper"
+
+class TimerIntegrationTest < ActionDispatch::IntegrationTest
+  setup do
+    @auth = { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "test-secret") }
+  end
+
+  test "timer inputs default to zero and persist through settings" do
+    get new_moderate_quiz_path, headers: @auth
+    %w[minutes seconds].each do |unit|
+      assert_select "label[for=quiz_timer_#{unit}]", text: "Timer #{unit}"
+      assert_select "input#quiz_timer_#{unit}[type=number][min='0'][step='1'][value='0']"
+    end
+    post moderate_quizzes_path, params: { quiz: { title: "Timed talk", timer_minutes: "1", timer_seconds: "30" } }, headers: @auth
+    quiz = Quiz.last
+    assert_equal 90, quiz.timer_duration
+    get edit_moderate_quiz_path(quiz), headers: @auth
+    assert_select "input#quiz_timer_minutes[value='1']"
+    assert_select "input#quiz_timer_seconds[value='30']"
+    %w[timer_minutes timer_seconds].each do |field|
+      [ "-1", "1.5", "", "abc" ].each do |value|
+        patch moderate_quiz_path(quiz), params: { quiz: { field => value } }, headers: @auth
+        assert_response :unprocessable_entity
+        assert_equal 90, quiz.reload.timer_duration
+      end
+    end
+    patch moderate_quiz_path(quiz), params: { quiz: { timer_minutes: 0, timer_seconds: 0 } }, headers: @auth
+    assert_response :see_other
+    assert_equal 0, quiz.reload.timer_duration
+  end
+
+  test "expired reads recover from a stopped server and expose no timer on phones" do
+    quiz = create_quiz
+    quiz.update!(timer_seconds: 5)
+    create_question(quiz)
+    game = Game.create_for!(quiz)
+    game.transition!("start", 0)
+    get state_moderate_game_path(game), as: :json
+    assert_response :unauthorized
+    get state_moderate_game_path(game), headers: @auth, as: :json
+    deadline = response.parsed_body.fetch("closes_at")
+    assert_equal game.question_closes_at.to_f, deadline
+    get state_play_path(game.code), as: :json
+    assert_response :ok
+    assert_not response.parsed_body.key?("closes_at")
+    assert_no_match(/timer_duration|timer_minutes|timer_seconds|question_closes_at/, response.body)
+    get play_path(game.code)
+    assert_select "[data-countdown]", count: 0
+    travel 6.seconds do
+      get state_play_path(game.code), as: :json
+      assert_equal "closed", response.parsed_body["status"]
+      assert_equal 2, game.reload.revision
+      get state_moderate_game_path(game), headers: @auth, as: :json
+      assert_equal "closed", response.parsed_body["status"]
+      assert_not response.parsed_body.key?("closes_at")
+      post transition_moderate_game_path(game), params: { command: "finish", revision: 1 }, headers: @auth, as: :json
+      assert_response :conflict
+      assert_equal 2, game.reload.revision
+    end
+  end
+end
