+++ b/test/models/timer_test.rb
@@ -0,0 +1,183 @@
+require "test_helper"
+
+class TimerTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    @quiz = create_quiz
+    create_question(@quiz)
+    create_question(@quiz, body: "Second question")
+  end
+
+  test "timer defaults to off and accepts only nonnegative whole numbers" do
+    assert_equal [ 0, 0, 0 ], [ @quiz.timer_minutes, @quiz.timer_seconds, @quiz.timer_duration ]
+    %i[timer_minutes timer_seconds].each do |field|
+      [ -1, "1.5", "abc", "", nil ].each do |value|
+        assert_not @quiz.update(field => value), "Accepted #{field}=#{value.inspect}"
+        @quiz.reload
+      end
+    end
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    assert_equal 90, @quiz.timer_duration
+    @quiz.update!(timer_minutes: 0, timer_seconds: 90)
+    assert_equal 90, @quiz.timer_duration
+  end
+
+  test "untimed games never expire" do
+    game = Game.create_for!(@quiz)
+    game.transition!("start", 0)
+    assert_nil game.question_closes_at
+    travel 1.day do
+      assert_not game.finish_if_expired!
+      assert_equal "open", GameState.new(game).for_stage[:status]
+      assert_not GameState.new(game).for_stage.key?(:closes_at)
+    end
+  end
+
+  test "opening persists a deadline and snapshots settings independently of later edits" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    game = Game.create_for!(@quiz)
+    assert_nil game.question_closes_at
+    @quiz.update!(timer_seconds: 0)
+    travel 2.minutes do
+      game.transition!("start", 0)
+      assert_equal 90, game.timer_duration
+      assert_equal game.current_question.opened_at + 90, game.question_closes_at
+      deadline = game.question_closes_at
+      travel 5.seconds
+      assert_equal deadline, Game.find(game.id).question_closes_at
+      assert_equal deadline.to_f, GameState.new(game).for_stage[:closes_at]
+      assert_equal "open", game.reload.status
+    end
+    assert_equal 60, Game.create_for!(@quiz).timer_duration
+  end
+
+  test "expiry closes exactly once at the deadline and reveals normal results" do
+    @quiz.update!(timer_seconds: 5)
+    game = Game.create_for!(@quiz)
+    player = game.join!("key", "Alice")
+    game.transition!("start", 0)
+    game.answer!(player, game.current_question.id, 0)
+    deadline = game.question_closes_at
+    travel_to deadline - 1 do
+      assert_not game.finish_if_expired!
+      assert_equal "open", game.reload.status
+    end
+    travel_to deadline do
+      assert game.finish_if_expired!
+      assert_equal [ "closed", 2, 1 ], game.reload.attributes.values_at("status", "revision", "position")
+      assert_not game.finish_if_expired!
+      assert_equal 2, game.reload.revision
+      state = GameState.new(game)
+      assert_equal "Correct!", state.for_player(player).dig(:player, :feedback)
+      assert_equal 1, state.for_stage.dig(:question, :options, 0, :count)
+      assert_not state.for_stage.key?(:closes_at)
+    end
+  end
+
+  test "late answers cannot be saved or change the last accepted pick" do
+    @quiz.update!(timer_seconds: 5)
+    game = Game.create_for!(@quiz)
+    player = game.join!("key", "Alice")
+    game.transition!("start", 0)
+    game.answer!(player, game.current_question.id, 0)
+    answer = player.answers.sole
+    travel_to game.question_closes_at do
+      assert_raises(Game::Conflict) { game.answer!(player, game.current_question.id, 1) }
+      assert_equal "closed", game.reload.status
+      assert_equal 0, answer.reload.option_index
+      assert_equal "Correct!", GameState.new(game).for_player(player).dig(:player, :feedback)
+    end
+  end
+
+  test "early Finish and a stale expiry cannot close the next question" do
+    @quiz.update!(timer_seconds: 5)
+    game = Game.create_for!(@quiz)
+    game.transition!("start", 0)
+    stale_game = Game.find(game.id)
+    deadline = game.question_closes_at
+    travel_to deadline - 2 do
+      game.transition!("finish", 1)
+      game.transition!("next", 2)
+      assert_equal deadline + 3, game.question_closes_at
+    end
+    travel_to deadline do
+      assert_not stale_game.finish_if_expired!
+      assert_equal [ "open", 3, 2 ], game.reload.attributes.values_at("status", "revision", "position")
+      assert_raises(Game::Conflict) { game.transition!("finish", 1) }
+    end
+    travel_to deadline + 3 do
+      GameTimer.sweep
+      assert_equal [ "closed", 4, 2 ], game.reload.attributes.values_at("status", "revision", "position")
+      game.transition!("end", 4)
+      GameTimer.sweep
+      assert_equal "ended", game.reload.status
+    end
+  end
+
+  test "a server sweep closes expired games without any connected browsers" do
+    @quiz.update!(timer_seconds: 1)
+    expired = Game.create_for!(@quiz)
+    expired.transition!("start", 0)
+    waiting = Game.create_for!(@quiz)
+    @quiz.update!(timer_seconds: 0)
+    untimed = Game.create_for!(@quiz)
+    untimed.transition!("start", 0)
+    travel 2.seconds do
+      GameTimer.sweep
+      assert_equal "closed", expired.reload.status
+      assert_equal "waiting", waiting.reload.status
+      assert_equal "open", untimed.reload.status
+    end
+  end
+
+  test "the fractional boundary accepts an earlier pick but rejects a first late answer" do
+    @quiz.update!(timer_seconds: 1)
+    game = Game.create_for!(@quiz)
+    early = game.join!("early", "Early")
+    late = game.join!("late", "Late")
+    game.transition!("start", 0)
+    deadline = game.question_closes_at
+    travel_to deadline - 0.001, with_usec: true do
+      game.answer!(early, game.current_question.id, 0)
+      assert_equal "open", game.reload.status
+      assert_not GameState.new(game).public_state.dig(:question, :options, 0).key?(:correct)
+    end
+    travel_to deadline + 0.001, with_usec: true do
+      assert_raises(Game::Conflict) { game.answer!(late, game.current_question.id, 0) }
+      assert_empty late.answers
+      assert_equal 1, early.answers.count
+      assert_equal "closed", game.reload.status
+    end
+  end
+
+  test "a timed game without active questions remains in the lobby until End quiz" do
+    @quiz.update!(timer_seconds: 1)
+    @quiz.questions.update_all(active: false)
+    game = Game.create_for!(@quiz)
+    travel 1.day do
+      GameTimer.sweep
+      assert_equal "waiting", game.reload.status
+      assert_nil game.question_closes_at
+      assert_not GameState.new(game).for_stage.key?(:closes_at)
+      game.transition!("end", 0)
+      assert_equal "ended", game.reload.status
+    end
+  end
+
+  test "timer is excluded from portable quizzes and public state" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    exported = JSON.parse(QuizTransfer.export(@quiz))
+    assert_equal %w[number_of_winners questions title], exported.keys.sort
+    exported.merge!("timer_minutes" => 9, "timer_seconds" => 9, "timer_duration" => 999)
+    copy = QuizTransfer.import(exported.to_json)
+    assert_equal 0, copy.timer_duration
+    game = Game.create_for!(@quiz)
+    player = game.join!("key", "Alice")
+    game.transition!("start", 0)
+    state = GameState.new(game)
+    assert state.for_stage.key?(:closes_at)
+    [ state.public_state, state.for_player(player) ].each do |data|
+      assert_no_match(/timer|closes_at|opened_at/, data.to_json)
+    end
+  end
+end
