new file mode 100644
index 0000000..90e4ba1
--- /dev/null
+++ b/script/timer_smoke.rb
@@ -0,0 +1,132 @@
+# Run against bin/serve: create, restart the server, check, cleanup.
+require "capybara/cuprite"
+require "json"
+require "fileutils"
+require "net/http"
+require "sqlite3"
+
+Capybara.enable_aria_label = true
+Capybara.default_max_wait_time = 6
+Capybara.register_driver(:timer_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: "/usr/bin/chromium",
+    window_size: [ 1440, 1100 ], browser_options: { "no-sandbox" => nil })
+end
+Capybara.app_host = ENV.fetch("APP_URL", "http://127.0.0.1:3000")
+stage, phone = Array.new(2) { Capybara::Session.new(:timer_chromium) }
+username, password = ENV.values_at("QUIZZY_MODERATOR_USERNAME", "QUIZZY_MODERATOR_PASSWORD")
+stage.driver.basic_authorize(username, password)
+output = File.expand_path("../storage/verification", __dir__)
+FileUtils.mkdir_p(output)
+state_file = File.join(output, "timer-smoke.json")
+uri = URI(Capybara.app_host)
+http = Net::HTTP.new(uri.host, uri.port, nil)
+
+begin
+  case ARGV.fetch(0, "create")
+  when "create"
+    abort "Clean up the previous timer smoke test first." if File.exist?(state_file)
+    raise "Health/host check failed" unless http.get("/up", "Host" => "conference.test").code == "200"
+    stage.visit "/moderate"
+    stage.click_on "Import quiz"
+    stage.fill_in "Quiz JSON", with: JSON.generate(title: "Timer smoke conference", questions: [
+      { text: "First timed question", options: [ { text: "Yes", correct: true }, { text: "No" } ] },
+      { text: "Second timed question", options: [ { text: "Yes", correct: true }, { text: "No" } ] }
+    ])
+    stage.click_on "Import"
+    state = { "quiz_path" => stage.current_path }
+    File.write(state_file, JSON.generate(state))
+    stage.click_on "Settings"
+    stage.assert_selector :field, "Timer minutes", with: "0"
+    stage.assert_selector :field, "Timer seconds", with: "0"
+    stage.fill_in "Timer seconds", with: "5"
+    stage.click_on "Save quiz"
+    stage.click_on "Start a game"
+    game_path = stage.current_path
+    phone.driver.resize(390, 844)
+    phone.visit stage.find(".lobby__url").text
+    phone.fill_in "Your name", with: "Alice"
+    phone.click_on "Join"
+    phone.assert_selector "[data-connection]", exact_text: "Live"
+    phone.execute_script(<<~'JS')
+      window.noReload = true;
+      const originalFetch = window.fetch;
+      window.fetch = (url, options) => /\/(state|heartbeat)$/.test(url) ? Promise.reject(new Error('Push only')) : originalFetch(url, options);
+    JS
+    stage.click_on "Start"
+    stage.assert_selector "[data-countdown]", text: "0:05"
+    phone.click_on "Yes"
+    phone.assert_text "Your answer"
+    phone.assert_no_selector "[data-countdown]", visible: :all
+    stage.assert_selector "[data-countdown]", text: "0:03", wait: 4
+    stage.visit game_path
+    stage.assert_selector "[data-countdown]", text: /0:0[123]/
+    stage.save_screenshot(File.join(output, "timer-stage.png"))
+    phone.save_screenshot(File.join(output, "timer-phone.png"))
+    stage.visit state["quiz_path"] # no stage, no player polls: worker must broadcast
+    phone.assert_text "Correct!", wait: 7
+    raise "Phone reloaded" unless phone.evaluate_script("window.noReload")
+    stage.visit game_path
+    stage.assert_selector :button, "Next"
+    stage.assert_no_selector "[data-countdown]"
+    stage.click_on "Next"
+    stage.assert_selector "[data-countdown]", text: "0:05"
+    stage.click_on "Finish"
+    stage.assert_selector :button, "End quiz"
+    stage.click_on "End quiz"
+
+    stage.visit state["quiz_path"]
+    stage.click_on "Settings"
+    stage.assert_selector :field, "Timer seconds", with: "5"
+    stage.fill_in "Timer seconds", with: "30"
+    stage.click_on "Save quiz"
+    stage.click_on "Export"
+    raise "Timer leaked into export" unless JSON.parse(stage.find("pre").text).keys.sort == %w[number_of_winners questions title]
+    stage.visit state["quiz_path"]
+    stage.click_on "Start a game"
+    state["game_path"] = stage.current_path
+    stage.click_on "Start"
+    stage.assert_selector "[data-countdown]", text: "0:30"
+    request = Net::HTTP::Get.new("#{state['game_path']}/state")
+    request.basic_auth(username, password)
+    state["deadline"] = JSON.parse(http.request(request).body).fetch("closes_at")
+    File.write(state_file, JSON.generate(state))
+    [ stage, phone ].each do |browser|
+      urls = browser.driver.browser.network.traffic.map { |exchange| exchange.request.url }
+      external = urls.reject { |url| url.start_with?(Capybara.app_host, Capybara.app_host.sub("http", "ws"), "data:") }
+      raise "External requests: #{external.inspect}" unless external.empty?
+    end
+    puts "Timer settings, reload, early Finish, player privacy, worker push and local-only requests passed. Restart bin/serve, then run check."
+  when "check"
+    state = JSON.parse(File.read(state_file))
+    # Read SQLite directly BEFORE visiting the game; a GET could reconcile it
+    # and hide a broken production worker. No browsers remain from create.
+    db = SQLite3::Database.new(File.expand_path("../storage/production.sqlite3", __dir__))
+    db.busy_timeout(5000)
+    id = state.fetch("game_path").split("/").last.to_i
+    original = db.get_first_row("SELECT question_closes_at FROM games WHERE id = ?", [ id ]).first
+    raise "Deadline reset on restart" unless (Time.parse("#{original} UTC").to_f - state.fetch("deadline")).abs < 0.001
+    sleep [ state.fetch("deadline") - Time.now.to_f + 1, 0 ].max
+    status, revision, position = db.get_first_row("SELECT status, revision, position FROM games WHERE id = ?", [ id ])
+    raise "Worker did not finish after restart: #{[ status, revision, position ].inspect}" unless [ status, revision, position ] == [ "closed", 2, 1 ]
+    db.close
+    stage.visit state.fetch("game_path")
+    stage.assert_selector :button, "Next"
+    stage.assert_no_selector "[data-countdown]"
+    stage.click_on "Next"
+    stage.assert_selector "[data-countdown]", text: "0:30"
+    stage.click_on "Finish"
+    stage.assert_selector :button, "End quiz"
+    puts "Persisted deadline, restart recovery, expiry with no browsers, and fresh Next timer passed."
+  when "cleanup"
+    state = JSON.parse(File.read(state_file))
+    stage.visit "#{state.fetch('quiz_path')}/edit"
+    stage.accept_confirm { stage.click_on "Delete quiz" }
+    stage.assert_no_text "Timer smoke conference"
+    File.delete(state_file)
+    puts "Timer smoke quiz removed."
+  else
+    abort "Use create, check, or cleanup."
+  end
+ensure
+  [ stage, phone ].each { |browser| browser.driver.quit }
+end
