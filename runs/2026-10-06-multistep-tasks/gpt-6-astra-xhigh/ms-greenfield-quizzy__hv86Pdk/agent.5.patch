diff --git a/app/services/game_timer.rb b/app/services/game_timer.rb
new file mode 100644
index 0000000..d3957e6
--- /dev/null
+++ b/app/services/game_timer.rb
@@ -0,0 +1,37 @@
+# A small, local deadline worker. SQLite holds the schedule, not this thread:
+# no jobs are lost on restart and no browser must stay connected to finish.
+class GameTimer
+  INTERVAL = 0.25
+
+  def self.sweep
+    Game.where(status: "open").where("question_closes_at <= ?", Time.current).find_each do |game|
+      game.finish_if_expired!
+    rescue ActiveRecord::RecordNotFound
+      # A moderator may have deleted the quiz since the scan.
+    end
+  end
+
+  def start
+    return self if @thread&.alive?
+
+    @stopping = false
+    @thread = Thread.new do
+      Thread.current.name = "quizzy-timer"
+      until @stopping
+        begin
+          Rails.application.executor.wrap { self.class.sweep }
+        rescue StandardError => error
+          Rails.logger.error("Quizzy timer: #{error.class}: #{error.message}")
+          # Retry on the next sweep; the durable deadline remains due.
+        end
+        sleep INTERVAL unless @stopping
+      end
+    end
+    self
+  end
+
+  def stop
+    @stopping = true
+    @thread&.join
+  end
+end
