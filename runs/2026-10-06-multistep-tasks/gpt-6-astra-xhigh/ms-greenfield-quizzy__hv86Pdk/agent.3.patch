index 4b33cc7..e21a642 100644
--- a/README.md
+++ b/README.md
@@ -1,6 +1,6 @@
 # Quizzy
 
-A Rails 8.1 application for preparing live conference quizzes. Moderator pages
+A Rails 8.1 application for preparing and running live conference quizzes. Moderator pages
 start at `/moderate` and require HTTP Basic authentication. All fonts, scripts,
 and styles are served locally; there are no external services or build tools.
 
@@ -73,3 +73,17 @@ bundle exec ruby script/transfer_smoke.rb create
 bundle exec ruby script/transfer_smoke.rb check
 bundle exec ruby script/transfer_smoke.rb cleanup
 ```
+
+## Run a live game
+
+Open a quiz in `/moderate` and choose **Start a game**. Share the full join URL
+or show the locally generated QR code. Players enter **Your name** and **Join**;
+their browser remembers them. Use **Start**, **Finish**, **Next**, and **End quiz**
+to run the talk. Every run gets independent players and answers and skips
+inactive questions. The stage and phones update without page reloads.
+
+Live delivery uses Action Cable backed by local SQLite, with HTTP reconciliation
+and fallback for unreliable Wi-Fi. Player counts use a 45-second heartbeat
+presence window; closing a phone does not immediately discard its presence or
+answers. See [live-game design and verification](docs/live-games.md) for the
+counter semantics, security boundaries, and production restart smoke test.
diff --git a/app/assets/javascripts/live_game.js b/app/assets/javascripts/live_game.js
new file mode 100644
index 0000000..b24d26d
--- /dev/null
+++ b/app/assets/javascripts/live_game.js
@@ -0,0 +1,261 @@
+(() => {
+  const root = document.querySelector("[data-live-game]");
+  if (!root) return;
+
+  const stage = root.dataset.role === "stage";
+  const participant = root.dataset.role === "player";
+  const content = root.querySelector("[data-game-content]");
+  const errorBox = root.querySelector("[data-live-error]");
+  const connection = root.querySelector("[data-connection]");
+  let state = JSON.parse(root.querySelector("[data-live-state]").textContent);
+  let signature, consumer, socketConnected = false, stopped = false;
+  let timer, refreshing = false, failures = 0, lastHeartbeat = 0;
+  let pendingAnswer, sendingAnswer = false, sendingCommand = false;
+
+  const element = (tag, className, text) => {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text !== undefined) node.textContent = text;
+    return node;
+  };
+  const error = (message = "") => {
+    errorBox.textContent = message;
+    errorBox.hidden = !message;
+  };
+  const feedback = () => {
+    if (state.player?.selected == null) return "No answer";
+    return state.question.options[state.player.selected]?.correct ? "Correct!" : "Wrong!";
+  };
+
+  function render() {
+    const ended = state.status === "ended";
+    const lobby = root.querySelector("[data-lobby]");
+    if (lobby) lobby.hidden = state.status !== "waiting";
+    const join = root.querySelector("[data-join]");
+    if (join) join.hidden = ended;
+    if (stage) {
+      root.querySelector("[data-players]").textContent = `Players: ${state.players}`;
+      root.querySelector("[data-counter]").textContent = state.status === "open" ? `Answers: ${state.answers} / ${state.players}` : "";
+    }
+
+    // Counter/heartbeat updates must not recreate focused buttons or join fields.
+    const nextSignature = JSON.stringify([state.status, state.question, state.player, state.revision]);
+    if (signature !== nextSignature) {
+      signature = nextSignature;
+      const focusKey = document.activeElement?.dataset.focusKey;
+      content.replaceChildren();
+      if (ended) {
+        content.append(element("h1", stage ? "lobby__title" : "play-question__body", "The quiz is over"),
+          element("p", "play-lead", "Thanks for playing along!"));
+      } else if (stage || participant) {
+        if (state.status === "waiting") {
+          if (!stage) {
+            const waiting = element("div", "waiting live-waiting");
+            const gem = element("span", "waiting__gem", "?");
+            gem.setAttribute("aria-hidden", "true");
+            waiting.append(gem, element("h1", "play-question__body", "Waiting for the start"),
+              element("p", "play-lead", "You're in! The moderator will start the quiz soon."));
+            content.append(waiting);
+          } else if (state.total === 0) {
+            content.append(element("p", "live-empty", "No active questions. Go back to the quiz to add or activate questions, then start a new game."));
+          }
+        } else if (state.question) {
+          const closed = state.status === "closed";
+          const prefix = stage ? "stage" : "play";
+          content.append(element("div", `${prefix}-question__num`, `Question ${state.position} of ${state.total}`),
+            element("h1", `${prefix}-question__body`, state.question.body));
+          const options = element("ul", `${prefix}-options live-options${closed ? (stage ? " stage-options--results" : " is-revealed") : ""}`);
+          options.setAttribute("aria-label", "Options");
+          state.question.options.forEach((option) => {
+            const item = element("li");
+            const picked = !stage && state.player?.selected === option.index;
+            const node = stage ? item : element("button");
+            node.className = `${prefix}-option${picked ? " is-picked" : ""}${closed && option.correct ? " is-correct" : ""}`;
+            const letter = element("span", `${prefix}-option__letter`, String.fromCharCode(65 + option.index));
+            letter.setAttribute("aria-hidden", "true");
+            node.append(letter, element("span", `${prefix}-option__title`, option.text));
+            if (stage && closed) {
+              node.append(element("span", "stage-option__count", `Answers: ${option.count}`));
+            }
+            if (!stage) {
+              node.type = "button";
+              node.disabled = closed;
+              node.setAttribute("aria-pressed", String(picked));
+              node.dataset.focusKey = `${state.question.id}-${option.index}`;
+              const questionId = state.question.id;
+              node.addEventListener("click", () => queueAnswer(questionId, option.index));
+              if (picked) node.append(element("span", "play-option__mark", "Your answer"));
+              item.append(node);
+            }
+            if (closed && option.correct) node.append(element("span", `${prefix}-option__mark`, "Correct"));
+            options.append(item);
+          });
+          content.append(options);
+          if (!stage) {
+            if (closed) {
+              const result = feedback();
+              const style = result === "Correct!" ? "right" : result === "Wrong!" ? "wrong" : "neutral";
+              content.append(element("p", `play-status play-status--${style}`, result),
+                element("p", "live-hint", "Waiting for the moderator…"));
+            } else {
+              content.append(element("p", "live-hint", state.player?.selected == null ? "Tap an option to answer." : "Answer saved. You can change it until the question closes."));
+            }
+          }
+        }
+      }
+      if (stage) renderControls();
+      if (focusKey) Array.from(content.querySelectorAll("[data-focus-key]")).find(node => node.dataset.focusKey === focusKey)?.focus({ preventScroll: true });
+    }
+    if (ended) {
+      stopped = true;
+      clearTimeout(timer);
+      consumer?.disconnect();
+      connection.textContent = "Game ended";
+      error();
+    }
+  }
+
+  function renderControls() {
+    const controls = root.querySelector("[data-controls]");
+    controls.replaceChildren();
+    let label, command;
+    if (state.status === "waiting") {
+      label = state.total ? "Start" : "End quiz";
+      command = state.total ? "start" : "end";
+    } else if (state.status === "open") {
+      label = "Finish"; command = "finish";
+    } else if (state.status === "closed") {
+      const last = state.position === state.total;
+      label = last ? "End quiz" : "Next"; command = last ? "end" : "next";
+    }
+    if (label) {
+      const button = element("button", "btn btn--pink", label);
+      button.type = "button";
+      button.disabled = sendingCommand;
+      button.addEventListener("click", () => sendCommand(command));
+      controls.append(button);
+    }
+  }
+
+  function apply(incoming) {
+    // Game phase and private answer acknowledgements travel independently. An
+    // accepted answer may arrive after Finish; retain it without reopening the
+    // question. The answer timestamp also prevents an older pick winning a race.
+    const sameQuestion = state.question?.id === incoming.question?.id;
+    const newerAnswer = sameQuestion && incoming.player &&
+      incoming.player.answer_version > (state.player?.answer_version || 0);
+    if (newerAnswer) state.player = incoming.player;
+    if (incoming.revision < state.revision || (incoming.revision === state.revision && incoming.sampled_at < state.sampled_at)) {
+      if (newerAnswer) render();
+      return;
+    }
+    if (state.player) {
+      if (sameQuestion && (!incoming.player || incoming.player.answer_version < state.player.answer_version)) {
+        incoming.player = state.player;
+      } else if (!incoming.player) {
+        incoming.player = { name: state.player.name, selected: null, answer_version: 0 };
+      }
+    }
+    if (incoming.revision !== state.revision) error();
+    state = incoming;
+    render();
+  }
+
+  async function request(url, data) {
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), 10000);
+    try {
+      const response = await fetch(url, {
+        method: data ? "POST" : "GET", credentials: "same-origin", cache: "no-store", signal: controller.signal,
+        headers: { "Accept": "application/json", "Content-Type": "application/json", "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content || "" },
+        body: data ? JSON.stringify(data) : undefined
+      });
+      if (!response.ok && response.status !== 409) throw new Error(`HTTP ${response.status}`);
+      apply(await response.json());
+      return response.status !== 409;
+    } finally {
+      clearTimeout(timeout);
+    }
+  }
+
+  async function sendCommand(command) {
+    if (sendingCommand) return;
+    sendingCommand = true;
+    renderControls();
+    error();
+    try {
+      await request(root.dataset.commandUrl, { command, revision: state.revision });
+    } catch (_) {
+      error("Connection interrupted. Check the game state and try again.");
+      refresh();
+    } finally {
+      sendingCommand = false;
+      renderControls();
+    }
+  }
+
+  async function queueAnswer(questionId, option) {
+    // Serialize taps and keep the latest pending pick, never retry an old pick
+    // behind a newer one. Mark 'Your answer' only after server acknowledgement.
+    pendingAnswer = { question_id: questionId, option };
+    if (sendingAnswer) return;
+    sendingAnswer = true;
+    while (pendingAnswer && state.status === "open") {
+      const answer = pendingAnswer;
+      pendingAnswer = null;
+      error("Sending answer…");
+      try {
+        const saved = await request(root.dataset.answerUrl, answer);
+        error(saved ? "" : "This question has closed. Your last saved answer counts.");
+      } catch (_) {
+        error("Could not confirm your answer. Tap an option to try again.");
+      }
+    }
+    pendingAnswer = null;
+    sendingAnswer = false;
+  }
+
+  function schedule(delay) {
+    clearTimeout(timer);
+    if (!stopped) timer = setTimeout(refresh, delay);
+  }
+  async function refresh() {
+    if (stopped || refreshing) return;
+    refreshing = true;
+    try {
+      const heartbeat = participant && Date.now() - lastHeartbeat > 12000;
+      await request(heartbeat ? root.dataset.heartbeatUrl : root.dataset.stateUrl, heartbeat ? {} : undefined);
+      if (heartbeat) lastHeartbeat = Date.now();
+      failures = 0;
+      if (!stopped) connection.textContent = socketConnected ? "Live" : "Live · reconnecting";
+    } catch (_) {
+      failures += 1;
+      connection.textContent = "Connection lost · retrying…";
+    } finally {
+      refreshing = false;
+      const interval = failures ? Math.min(10000, 1000 * 2 ** failures) : socketConnected ? (stage ? 5000 : 15000) : 2000;
+      schedule(interval + Math.random() * 400);
+    }
+  }
+
+  render();
+  if (!stopped) {
+    try {
+      consumer = ActionCable.createConsumer("/cable");
+      consumer.subscriptions.create({ channel: "GameChannel", role: root.dataset.role, token: root.dataset.token }, {
+        connected() { socketConnected = true; refresh(); },
+        disconnected() { socketConnected = false; if (!stopped) { connection.textContent = "Reconnecting…"; schedule(500); } },
+        rejected() { socketConnected = false; schedule(500); },
+        received(data) { apply(data); }
+      });
+    } catch (_) {
+      // Some browsers/networks disable WebSockets entirely. HTTP still works.
+      socketConnected = false;
+    }
+    refresh();
+  }
+  window.addEventListener("online", () => { if (!stopped) { consumer?.connect(); refresh(); } });
+  document.addEventListener("visibilitychange", () => { if (!document.hidden && !stopped) { lastHeartbeat = 0; consumer?.connect(); refresh(); } });
+  window.addEventListener("pagehide", () => { clearTimeout(timer); consumer?.disconnect(); });
+  window.addEventListener("pageshow", event => { if (event.persisted && !stopped) { consumer?.connect(); refresh(); } });
+})();
