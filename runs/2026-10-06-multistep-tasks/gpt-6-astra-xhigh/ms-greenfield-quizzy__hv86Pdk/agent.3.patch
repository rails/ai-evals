diff --git a/app/channels/game_channel.rb b/app/channels/game_channel.rb
new file mode 100644
index 0000000..a091ec0
--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,22 @@
+class GameChannel < ApplicationCable::Channel
+  def subscribed
+    case params[:role]
+    when "stage"
+      game = Game.find_signed(params[:token], purpose: :stage)
+      game ? stream_from("stage:#{game.id}") : reject
+    when "player"
+      player = Player.find_signed(params[:token], purpose: :player)
+      if player
+        stream_from "game:#{player.game_id}"
+        stream_from "player:#{player.id}"
+      else
+        reject
+      end
+    when "watch"
+      game = Game.find_signed(params[:token], purpose: :watch)
+      game ? stream_from("game:#{game.id}") : reject
+    else
+      reject
+    end
+  end
+end
