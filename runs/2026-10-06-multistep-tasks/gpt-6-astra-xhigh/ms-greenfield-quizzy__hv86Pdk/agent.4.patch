diff --git a/test/system/prizes_test.rb b/test/system/prizes_test.rb
new file mode 100644
index 0000000..d7c3fd2
--- /dev/null
+++ b/test/system/prizes_test.rb
@@ -0,0 +1,146 @@
+require "application_system_test_case"
+
+class PrizesSystemTest < ApplicationSystemTestCase
+  test "settings persist a positive winner count" do
+    visit new_moderate_quiz_path
+    assert_field "Number of winners", with: "3"
+    fill_in "Title", with: "Prize night"
+    fill_in "Number of winners", with: "1"
+    click_on "Save quiz"
+    click_on "Settings"
+    assert_field "Number of winners", with: "1"
+    fill_in "Number of winners", with: "2"
+    click_on "Save quiz"
+    click_on "Export"
+    assert_text '"number_of_winners": 2'
+    visit edit_moderate_quiz_path(Quiz.last)
+    assert_field "Number of winners", with: "2"
+  end
+
+  test "rankings and every prize selection update all screens live after End quiz" do
+    quiz = create_quiz(title: "Conference prizes")
+    quiz.update!(number_of_winners: 1)
+    create_question(quiz)
+    create_question(quiz, body: "Second question")
+    visit moderate_quiz_path(quiz)
+    click_on "Start a game"
+    stage_path = current_path
+    url = find(".lobby__url").text
+    using_session(:big_screen) do
+      page.driver.basic_authorize("moderator", "test-secret")
+      visit stage_path
+      assert_selector "[data-connection]", exact_text: "Live"
+      block_reconciliation
+    end
+    %w[Alice Bob Zero].each do |name|
+      using_session(name) do
+        page.driver.resize(390, 844)
+        visit url
+        fill_in "Your name", with: name
+        click_on "Join"
+        assert_selector "[data-connection]", exact_text: "Live"
+        block_reconciliation
+      end
+    end
+    assert_text "Players: 3"
+    click_on "Start"
+    using_session(:big_screen) { assert_text "Which planet is the largest?", wait: 1 }
+    using_session("Bob") do
+      assert_text "Which planet is the largest?", wait: 1
+      click_on "Jupiter"
+      assert_text "Your answer"
+      assert_no_text(/\d+ points?/)
+    end
+    using_session("Alice") do
+      assert_text "Which planet is the largest?", wait: 1
+      click_on "Jupiter"
+      assert_text "Your answer"
+      click_on "Earth"
+      assert_selector "button.is-picked", text: "Earth"
+      click_on "Jupiter"
+      assert_selector "button.is-picked", text: "Jupiter"
+    end
+    click_on "Finish"
+    using_session("Alice") do
+      assert_text "Correct!", wait: 1
+      assert_no_text(/\d+ points?/)
+    end
+    click_on "Next"
+    %w[Alice Bob].each do |name|
+      using_session(name) do
+        assert_text "Second question", wait: 1
+        click_on "Earth"
+        assert_text "Your answer"
+      end
+    end
+    click_on "Finish"
+    click_on "End quiz"
+    assert_selector "ol[aria-label='Leaderboard'] > li", count: 3
+    assert_equal [ "1 Bob 1 point", "2 Alice 1 point", "3 Zero 0 points" ], all(".leader").map { |row| row.text.squish }
+    using_session("Bob") do
+      assert_text "Place 1 of 3", wait: 1
+      assert_text "1 point"
+      assert_no_text "You won!"
+    end
+    using_session("Alice") do
+      assert_text "Place 2 of 3", wait: 1
+      assert_text "1 point"
+    end
+    using_session("Zero") do
+      assert_text "Place 3 of 3", wait: 1
+      assert_text "0 points"
+    end
+    click_on "Top 1"
+    assert_selector ".leader.is-winner", text: "Bob", count: 1
+    using_session(:big_screen) { assert_selector ".leader.is-winner", text: "Bob", count: 1, wait: 1 }
+    using_session("Bob") { assert_text "You won!", wait: 1 }
+    using_session("Alice") { assert_no_text "You won!" }
+    click_on "Reset winners"
+    assert_no_selector ".leader.is-winner"
+    using_session(:big_screen) { assert_no_selector ".leader.is-winner", wait: 1 }
+    using_session("Bob") { assert_no_text "You won!", wait: 1 }
+    3.times do
+      click_on "Draw"
+      assert_selector ".leader.is-winner", count: 1
+      winner = find(".leader.is-winner .leader__name").text.sub(/\s*Winner\z/, "")
+      assert_includes %w[Alice Bob], winner
+      using_session(:big_screen) { assert_selector ".leader.is-winner", text: winner, count: 1, wait: 1 }
+      %w[Alice Bob Zero].each do |name|
+        using_session(name) do
+          if name == winner
+            assert_text "You won!", wait: 1
+          else
+            assert_no_text "You won!", wait: 1
+          end
+          assert_equal true, page.evaluate_script("window.noReload")
+          assert page.evaluate_script("document.documentElement.scrollWidth <= innerWidth")
+        end
+      end
+    end
+    # A fresh page reads persisted winners; no event history is needed.
+    visit stage_path
+    assert_selector ".leader.is-winner", count: 1
+    click_on "Reset winners"
+    assert_no_selector ".leader.is-winner"
+    using_session("Bob") do
+      visit url
+      assert_text "Place 1 of 3"
+      assert_text "1 point"
+      assert_no_text "You won!"
+    end
+  end
+
+  private
+
+  def block_reconciliation
+    # Verify real pushed events, not a lucky HTTP poll; answer POSTs still work.
+    page.execute_script(<<~'JS')
+      window.noReload = true;
+      const nativeFetch = window.fetch;
+      window.fetch = (url, options) => {
+        if (/\/(state|heartbeat)$/.test(url)) return Promise.reject(new Error('Test: WebSocket delivery only'));
+        return nativeFetch(url, options);
+      };
+    JS
+  end
+end
