+require "test_helper"
+
+class PrizesIntegrationTest < ActionDispatch::IntegrationTest
+  setup do
+    @auth = { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "test-secret") }
+  end
+
+  test "settings default and persist and invalid counts do not save" do
+    get new_moderate_quiz_path, headers: @auth
+    assert_select 'label[for="quiz_number_of_winners"]', text: "Number of winners"
+    assert_select 'input[type="number"][min="1"][step="1"][value="3"]'
+    post moderate_quizzes_path, params: { quiz: { title: "Prizes", number_of_winners: "4" } }, headers: @auth
+    quiz = Quiz.last
+    assert_equal 4, quiz.number_of_winners
+    [ "0", "-1", "1.5", "", "abc" ].each do |value|
+      patch moderate_quiz_path(quiz), params: { quiz: { number_of_winners: value } }, headers: @auth
+      assert_response :unprocessable_entity
+      assert_equal 4, quiz.reload.number_of_winners
+    end
+  end
+
+  test "only moderators can pick winners and only after the quiz is over" do
+    quiz = create_quiz
+    create_question(quiz)
+    game = Game.create_for!(quiz)
+    player = game.join!("key", "Player")
+    %w[top draw reset_winners].each do |command|
+      post transition_moderate_game_path(game), params: { command: command, revision: game.revision }, as: :json
+      assert_response :unauthorized
+      post transition_moderate_game_path(game), params: { command: command, revision: game.revision }, headers: @auth, as: :json
+      assert_response :conflict
+    end
+    game.transition!("start", game.revision)
+    game.answer!(player, game.current_question.id, 0)
+    game.transition!("finish", game.revision)
+    get state_play_path(game.code), as: :json
+    assert_not response.parsed_body.key?("leaderboard")
+    assert_not_includes response.body, "points"
+    game.transition!("end", game.revision)
+    post transition_moderate_game_path(game), params: { command: "top", revision: game.revision }, headers: @auth, as: :json
+    assert_response :ok
+    assert_equal [ { "id" => player.id, "name" => "Player", "place" => 1, "points" => 1, "winner" => true } ], response.parsed_body["leaderboard"]
+    get state_play_path(game.code), as: :json
+    assert_equal true, response.parsed_body["leaderboard"].first["winner"]
+    assert_not_includes response.body, "browser_key"
+    assert_not_includes response.body, "correct_time_us"
+  end
+end
