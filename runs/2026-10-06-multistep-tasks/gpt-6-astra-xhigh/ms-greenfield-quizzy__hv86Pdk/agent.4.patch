diff --git a/app/services/leaderboard.rb b/app/services/leaderboard.rb
new file mode 100644
index 0000000..76959f8
--- /dev/null
+++ b/app/services/leaderboard.rb
@@ -0,0 +1,28 @@
+# One point per final correct answer. Integer microseconds avoid rounded display
+# values changing a tie's order. Presence is irrelevant: everyone who joined ranks.
+class Leaderboard
+  def initialize(game)
+    @game = game
+  end
+
+  def entries
+    questions = @game.game_questions.index_by(&:id)
+    ranked = @game.players.includes(:answers).map do |player|
+      points = 0
+      elapsed = 0
+      player.answers.each do |answer|
+        question = questions[answer.game_question_id]
+        next unless question&.options&.dig(answer.option_index, "correct")
+        points += 1
+        if question.opened_at && answer.picked_at
+          elapsed += [ ((answer.picked_at.to_r - question.opened_at.to_r) * 1_000_000).to_i, 0 ].max
+        end
+      end
+      { id: player.id, name: player.name, points: points, correct_time_us: elapsed, winner: player.winner? }
+    end
+    # A truly identical score/time gets a stable final ordering, not a changing
+    # database order or a shared place that would obscure the N-th-place cutoff.
+    ranked.sort_by! { |entry| [ -entry[:points], entry[:correct_time_us], entry[:id] ] }
+    ranked.each_with_index { |entry, index| entry[:place] = index + 1 }
+  end
+end
