new file mode 100644
index 0000000..7037696
--- /dev/null
+++ b/script/prizes_smoke.rb
@@ -0,0 +1,173 @@
+# Production-only browser check, including persistence across a server restart.
+# bin/serve must be running. Export the moderator credentials, then run:
+# bundle exec ruby script/prizes_smoke.rb create|check|cleanup
+require "capybara/cuprite"
+require "json"
+require "fileutils"
+require "net/http"
+
+Capybara.enable_aria_label = true
+Capybara.default_max_wait_time = 6
+Capybara.register_driver(:prizes_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: "/usr/bin/chromium",
+    window_size: [ 1440, 1100 ], browser_options: { "no-sandbox" => nil })
+end
+Capybara.app_host = ENV.fetch("APP_URL", "http://127.0.0.1:3000")
+stage, screen, alice, bob, charlie, zero = browsers = Array.new(6) { Capybara::Session.new(:prizes_chromium) }
+[ stage, screen ].each do |browser|
+  browser.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD"))
+end
+output = File.expand_path("../storage/verification", __dir__)
+FileUtils.mkdir_p(output)
+state_file = File.join(output, "prizes-smoke.json")
+
+# Once subscribed, disable HTTP reconciliation so only pushed events can pass.
+def socket_only(browser)
+  browser.assert_selector "[data-connection]", exact_text: "Live"
+  browser.execute_script(<<~'JS')
+    window.noReload = true;
+    window.questionTimes = {};
+    new MutationObserver(() => {
+      const heading = document.querySelector('[data-game-content] h1')?.textContent;
+      if (heading?.startsWith('Prize question') && !window.questionTimes[heading]) window.questionTimes[heading] = Date.now();
+    }).observe(document.querySelector('[data-game-content]'), { childList: true, subtree: true });
+    const originalFetch = window.fetch;
+    window.fetchForReconnect = originalFetch;
+    window.fetch = (url, options) => /\/(state|heartbeat)$/.test(url) ? Promise.reject(new Error('WebSocket-only test')) : originalFetch(url, options);
+  JS
+end
+
+begin
+  case ARGV.fetch(0, "create")
+  when "create"
+    abort "Clean up the previous prize smoke test first." if File.exist?(state_file)
+    uri = URI(Capybara.app_host)
+    http = Net::HTTP.new(uri.host, uri.port, nil)
+    raise "Health/host check failed" unless http.get("/up", "Host" => "any-conference.test").code == "200"
+    stage.visit "/moderate"
+    stage.click_on "Import quiz"
+    stage.fill_in "Quiz JSON", with: JSON.generate(title: "Production prize check", number_of_winners: 2, questions: (1..3).map do |n|
+      { text: "Prize question #{n}", options: [ { text: "Right", correct: true }, { text: "Wrong", correct: false } ] }
+    end)
+    stage.click_on "Import"
+    stage.assert_selector "h1", text: "Production prize check"
+    state = { "quiz_path" => stage.current_path }
+    File.write(state_file, JSON.generate(state))
+    stage.click_on "Start a game"
+    state["game_path"] = stage.current_path
+    state["join_url"] = stage.find(".lobby__url").text
+    File.write(state_file, JSON.generate(state))
+    screen.visit state["game_path"]
+    socket_only(screen)
+    [ [ alice, "Alice" ], [ bob, "Bob" ], [ charlie, "Charlie" ], [ zero, "Zero" ] ].each do |phone, name|
+      phone.driver.resize(390, 844)
+      phone.visit state["join_url"]
+      phone.fill_in "Your name", with: name
+      phone.click_on "Join"
+      socket_only(phone)
+    end
+    stage.assert_text "Players: 4"
+    latencies = []
+    3.times do |index|
+      sent_at = (Time.now.to_f * 1000).to_i
+      stage.click_on(index.zero? ? "Start" : "Next")
+      [ screen, alice, bob, charlie, zero ].each do |browser|
+        browser.assert_text "Prize question #{index + 1}", wait: 2
+        latency = browser.evaluate_script("window.questionTimes['Prize question #{index + 1}']") - sent_at
+        raise "Question push too slow: #{latency}ms" if latency > 1000
+        latencies << latency
+      end
+      [ bob, charlie, alice ].each do |phone|
+        phone.click_on(index == 2 && phone != alice ? "Wrong" : "Right")
+        phone.assert_text "Your answer"
+        phone.assert_no_text(/\d+ points?/)
+      end
+      stage.click_on "Finish"
+      alice.assert_text "Correct!", wait: 2
+      alice.assert_no_text(/\d+ points?/)
+    end
+    stage.click_on "End quiz"
+    stage.assert_selector ".leader", count: 4
+    ranking = stage.all(".leader").map { |row| row.text.gsub(/\s+/, " ").strip }
+    raise "Wrong ranking: #{ranking}" unless ranking == [ "1 Alice 3 points", "2 Bob 2 points", "3 Charlie 2 points", "4 Zero 0 points" ]
+    [ [ alice, 1, 3 ], [ bob, 2, 2 ], [ charlie, 3, 2 ], [ zero, 4, 0 ] ].each do |phone, place, points|
+      phone.assert_text "Place #{place} of 4", wait: 2
+      phone.assert_text "#{points} points"
+    end
+    stage.click_on "Top 2"
+    screen.assert_selector ".leader.is-winner", count: 2, wait: 2
+    alice.assert_text "You won!", wait: 2
+    bob.assert_text "You won!", wait: 2
+    charlie.assert_no_text "You won!"
+    zero.assert_no_text "You won!"
+    stage.click_on "Reset winners"
+    screen.assert_no_selector ".leader.is-winner", wait: 2
+    alice.assert_no_text "You won!", wait: 2
+    bob.assert_no_text "You won!", wait: 2
+    3.times do
+      stage.click_on "Draw"
+      stage.assert_selector ".leader.is-winner", count: 2
+      winners = stage.all(".leader.is-winner .leader__name").map { |row| row.text.sub(/\s*Winner\z/, "") }
+      raise "Wrong draw pool: #{winners}" unless winners.include?("Alice") && (winners.include?("Bob") || winners.include?("Charlie"))
+      [ [ alice, "Alice" ], [ bob, "Bob" ], [ charlie, "Charlie" ], [ zero, "Zero" ] ].each do |phone, name|
+        winners.include?(name) ? phone.assert_text("You won!", wait: 2) : phone.assert_no_text("You won!", wait: 2)
+      end
+    end
+    # A known winner misses Reset, then reconciles without a document reload.
+    stage.click_on "Top 2"
+    bob.assert_text "You won!", wait: 2
+    bob.execute_script("window.fetch = window.fetchForReconnect")
+    bob.driver.browser.network.offline_mode
+    stage.click_on "Reset winners"
+    stage.assert_no_selector ".leader.is-winner"
+    bob.driver.browser.network.emulate_network_conditions(offline: false)
+    bob.execute_script("window.dispatchEvent(new Event('online'))")
+    bob.assert_no_text "You won!", wait: 2
+    stage.click_on "Top 2"
+    stage.assert_selector ".leader.is-winner", count: 2
+    alice.assert_text "You won!", wait: 2
+    bob.assert_text "You won!", wait: 2
+    charlie.assert_no_text "You won!", wait: 2
+    [ screen, alice, bob, charlie, zero ].each { |browser| raise "Reloaded page" unless browser.evaluate_script("window.noReload") }
+    browsers.each do |browser|
+      external = browser.driver.browser.network.traffic.map { |exchange| exchange.request.url }.reject do |url|
+        url.start_with?(Capybara.app_host, Capybara.app_host.sub("http", "ws"), "data:")
+      end
+      raise "External requests: #{external}" unless external.empty?
+    end
+    state["cookie"] = bob.driver.browser.cookies.all.fetch("quizzy_browser").value
+    File.write(state_file, JSON.generate(state))
+    stage.save_screenshot(File.join(output, "prizes-stage.png"))
+    bob.save_screenshot(File.join(output, "prizes-phone.png"))
+    puts "Production prizes passed. Question delivery: #{latencies.min}–#{latencies.max}ms (HTTP reconciliation disabled). Restart bin/serve, then run check."
+  when "check"
+    state = JSON.parse(File.read(state_file))
+    stage.visit state.fetch("game_path")
+    stage.assert_selector ".leader", count: 4
+    stage.assert_selector ".leader.is-winner", count: 2
+    stage.assert_selector ".leader.is-winner", text: "Alice"
+    stage.assert_selector ".leader.is-winner", text: "Bob"
+    bob.visit state.fetch("join_url")
+    bob.driver.browser.cookies.set(name: "quizzy_browser", value: state.fetch("cookie"), domain: URI(Capybara.app_host).host, path: "/")
+    bob.visit state.fetch("join_url")
+    bob.assert_text "Place 2 of 4"
+    bob.assert_text "2 points"
+    bob.assert_text "You won!"
+    socket_only(bob)
+    stage.click_on "Reset winners"
+    bob.assert_no_text "You won!", wait: 2
+    puts "Ranks, points, identity, winners, and live reset survived the production restart."
+  when "cleanup"
+    state = JSON.parse(File.read(state_file))
+    stage.visit state.fetch("quiz_path")
+    stage.click_on "Settings"
+    stage.accept_confirm { stage.click_on "Delete quiz" }
+    stage.assert_selector "h1", text: "Your quizzes"
+    File.delete(state_file)
+    puts "Prize smoke-test quiz removed."
+  else
+    abort "Expected create, check, or cleanup"
+  end
+ensure
+  browsers.each { |browser| browser.driver.quit }
+end
