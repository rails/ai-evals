+  # A subquery avoids duplicate tickets (and inflated pagination counts) when
+  # multiple public comments match. Escape LIKE metacharacters as literal text.
+  scope :matching_text, ->(query) do
+    pattern = "%#{sanitize_sql_like(query)}%"
+    public_matches = Comment.publicly_visible.where("comments.body ILIKE ?", pattern).select(:ticket_id)
+    where("tickets.subject ILIKE ?", pattern).or(where(id: public_matches))
+  end
+
   def api_json(include_requester: false)
