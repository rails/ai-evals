+    assert_ignored email_source(to: Ticket.sole.email_reply_address)
+    requester.update!(suspended: false, role: "agent")
+    assert_ignored email_source
+  end
+
+  test "verification and password reset let an email customer use the portal" do
+    receive_email
+    customer = Ticket.sole.requester
+    confirm_email
+    assert_response :ok
+    assert customer.reload.verified?
+    request_link("password_reset", email: customer.email)
