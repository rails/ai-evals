+++ b/db/migrate/20261008161000_add_ticket_merges.rb
@@ -0,0 +1,15 @@
+class AddTicketMerges < ActiveRecord::Migration[8.1]
+  def change
+    remove_check_constraint :tickets, "status IN ('open', 'pending', 'solved')", name: "valid_ticket_status"
+    add_check_constraint :tickets, "status IN ('open', 'pending', 'solved', 'closed')", name: "valid_ticket_status"
+
+    add_reference :tickets, :merged_into, foreign_key: { to_table: :tickets, on_delete: :nullify }
+    add_check_constraint :tickets,
+      "merged_into_id IS NULL OR (merged_into_id <> id AND status = 'closed')",
+      name: "valid_ticket_merge"
+
+    # Persist this distinction so even a delayed/reloaded mailer cannot send a
+    # public merge note as an ordinary staff reply.
+    add_column :comments, :merge_note, :boolean, null: false, default: false
+  end
+end
