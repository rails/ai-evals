+    get "/api/v1/tickets", params: { page: 2, per_page: 1 }, headers: headers("acme", @admin_token)
+    assert_equal [ recent.id ], ids("tickets")
+    assert_equal [ 2, 2, 1, nil, 1 ], body.values_at("count", "page", "per_page", "next_page", "previous_page")
+    get "/api/v1/tickets", params: { page: "9" * 30, per_page: 1 }, headers: headers("acme", @admin_token)
