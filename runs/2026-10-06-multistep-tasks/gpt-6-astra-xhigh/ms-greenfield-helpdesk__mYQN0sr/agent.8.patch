+    recent = ticket
+    old.comments.create!(body: "New activity", author: @admin)
+    [ {}, { page: 1, per_page: 1 } ].each do |parameters|
+      get "/api/v1/tickets", params: parameters, headers: headers("acme", @admin_token)
+      assert_response :ok
+      assert_equal old.id, ids("tickets").first
