+class AddCursorPaginationIndexes < ActiveRecord::Migration[8.1]
+  disable_ddl_transaction!
+
+  def change
+    add_index :tickets, [ :account_id, :created_at, :id ], name: "tickets_by_creation", algorithm: :concurrently
+    add_index :tickets, [ :account_id, :requester_id, :created_at, :id ],
+      name: "requests_by_creation", algorithm: :concurrently
+    # Staff comments already have (ticket_id, created_at, id).
+    add_index :comments, [ :ticket_id, :created_at, :id ], where: '"public" = true',
+      name: "public_comments_by_creation", algorithm: :concurrently
+    %i[users invitations groups group_memberships].each do |table|
+      add_index table, [ :account_id, :id ], algorithm: :concurrently
+    end
+    %i[group_id user_id].each do |filter|
+      add_index :group_memberships, [ :account_id, filter, :id ], algorithm: :concurrently
+    end
+  end
+end
