+    follow(second.dig("links", "prev"))
+    assert_equal [ groups.first.id ], ids("groups")
+    assert_equal false, body.dig("meta", "has_more")
+    assert_nil body.dig("links", "prev")
+    follow(second.dig("links", "next"))
+    assert_equal [ groups.last.id ], ids("groups")
