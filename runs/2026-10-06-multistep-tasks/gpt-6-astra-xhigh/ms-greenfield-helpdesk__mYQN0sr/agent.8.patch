+  test "deleted boundaries work in both directions without looking up the marker row" do
+    groups = 5.times.map { |n| @account.groups.create!(name: "Group #{n}") }
+    get "/api/v1/groups", params: { page: { size: 2 } }, headers: headers("acme", @admin_token)
+    first = body
+    groups[1].destroy!
+    follow(first.dig("links", "next"))
+    assert_equal groups[2, 2].map(&:id), ids("groups")
+    second = body
