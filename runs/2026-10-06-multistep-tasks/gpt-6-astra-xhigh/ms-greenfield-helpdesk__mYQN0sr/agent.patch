@@ -0,0 +1,45 @@
+class Comment < ApplicationRecord
+  belongs_to :ticket, inverse_of: :comments
+  belongs_to :author, class_name: "User", inverse_of: :authored_comments
+
+  validates :body, presence: true
+  validates :public, inclusion: { in: [ true, false ] }
+  validate :author_belongs_to_account
+  validate :ticket_accepts_comments
+
+  has_one :inbound_email_receipt, dependent: :nullify
+
+  after_save :touch_activity
+  after_create_commit :email_requester
+
+  scope :chronological, -> { order(created_at: :asc, id: :asc) }
+  scope :publicly_visible, -> { where(public: true) }
+
+  def api_json
+    slice(:id, :body, :public, :created_at).merge(author: author.slice(:id, :name))
+  end
+
+  private
+
+  def email_requester
+    if !merge_note? && public? && author.staff? && author_id != ticket.requester_id && ticket.email_origin?
+      TicketMailer.public_reply(self).deliver_later
+    end
+  end
+
+  def touch_activity
+    # Keep internal activity useful to staff, without leaking it via request
+    # timestamps or customer list ordering.
+    ticket.touch(*(public? ? [ :public_updated_at ] : []))
+  end
+
+  def ticket_accepts_comments
+    errors.add(:ticket, "is closed") if ticket&.closed?
+  end
+
+  def author_belongs_to_account
+    if author && ticket && author.account_id != ticket.account_id
+      errors.add(:author, "must belong to the same account")
+    end
+  end
+end
diff --git a/app/models/concerns/retry_rejected_inbound_email.rb b/app/models/concerns/retry_rejected_inbound_email.rb
new file mode 100644
index 0000000..08d7ce6
--- /dev/null
+++ b/app/models/concerns/retry_rejected_inbound_email.rb
@@ -0,0 +1,16 @@
+# Rails deduplicates raw mail by (Message-ID, checksum), even when it was rejected.
+# Re-route rejected/failed exact retransmissions: business state may have changed
+# since the first attempt. Successful Message-ID deduplication lives in receipts.
+module RetryRejectedInboundEmail
+  def create_and_extract_message_id!(source, **options)
+    checksum = OpenSSL::Digest::SHA1.hexdigest(source)
+    message_id = extract_message_id(source) || generate_missing_message_id(checksum)
+    existing = find_by(message_id: message_id, message_checksum: checksum)
+    if existing
+      existing.route_later if existing.bounced? || existing.failed?
+      existing
+    else
+      super
+    end
+  end
+end
diff --git a/app/models/email_token.rb b/app/models/email_token.rb
new file mode 100644
index 0000000..54f57d7
--- /dev/null
+++ b/app/models/email_token.rb
@@ -0,0 +1,17 @@
+class EmailToken < ApplicationRecord
+  LIFETIMES = { "email_verification" => 24.hours, "password_reset" => 1.hour }.freeze
+
+  belongs_to :user
+  validates :token_digest, :expires_at, presence: true
+  validates :purpose, inclusion: { in: LIFETIMES.keys }
+  scope :usable, -> { where("expires_at > ?", Time.current) }
+
+  # One token per user and purpose; replacing its digest invalidates the old link.
+  # Callers serialize issuance and consumption using the account's row lock.
+  def self.issue!(user, purpose)
+    token = SecureRandom.urlsafe_base64(32)
+    record = user.email_tokens.find_or_initialize_by(purpose: purpose)
+    record.update!(token_digest: TokenDigest.call(token), expires_at: LIFETIMES.fetch(purpose).from_now)
+    token
+  end
+end
