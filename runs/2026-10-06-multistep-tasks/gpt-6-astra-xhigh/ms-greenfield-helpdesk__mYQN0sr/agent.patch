diff --git a/lib/tasks/helpdesk.rake b/lib/tasks/helpdesk.rake
new file mode 100644
index 0000000..1989627
--- /dev/null
+++ b/lib/tasks/helpdesk.rake
@@ -0,0 +1,20 @@
+namespace :helpdesk do
+  desc "Permanently delete accounts cancelled for at least 90 days and all their data"
+  task purge_cancelled_accounts: :environment do
+    count = 0
+    Account.due_for_purge.find_each do |account|
+      begin
+        # Recheck after locking: an owner may have reactivated since the scan.
+        account.with_lock do
+          if !account.active? && !account.reactivatable?
+            account.destroy!
+            count += 1
+          end
+        end
+      rescue ActiveRecord::RecordNotFound
+        # Another cleanup worker already removed it.
+      end
+    end
+    puts "Purged #{count} cancelled account(s)."
+  end
+end
