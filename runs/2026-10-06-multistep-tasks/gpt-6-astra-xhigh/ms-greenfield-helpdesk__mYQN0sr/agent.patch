+    assert_ignored "To: other@support.example.test\r\n#{email_source}"
+    assert_ignored "Auto-Submitted: auto-replied\r\n#{email_source(extra: { "Auto-Submitted" => "no" })}"
+    assert_ignored "From: attacker@example.test\r\n#{email_source}"
