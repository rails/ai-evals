+module Api
+  module V1
+    class AccountsController < BaseController
+      skip_before_action :load_account, only: :create
+      skip_around_action :lock_account, only: :create
+      skip_before_action :require_active_account, only: [ :create, :reactivate ]
+      before_action :authenticate_user!, except: :create
+      before_action :require_owner!, only: [ :cancel, :reactivate ]
+
+      def create
+        registration = params.expect(account: [ :name, :subdomain, admin: [ :name, :email, :password ] ])
+        admin = validate_strings(registration.expect(admin: [ :name, :email, :password ]))
+        attributes = validate_strings(registration.slice(:name, :subdomain))
+        account, user, token = Account.transaction do
+          account = Account.create!(attributes)
+          user = account.users.create!(admin.merge(role: "admin", owner: true))
+          [ account, user, EmailToken.issue!(user, "email_verification") ]
+        end
+        UserMailer.email_verification(user, token).deliver_now
+        render json: { account: account.api_json, user: user.api_json }, status: :created
+      end
+
+      def show
+        render json: { account: current_account.api_json }
+      end
+
+      def cancel
+        current_account.cancel!
+        render json: { account: current_account.api_json }
+      end
+
+      def reactivate
+        if current_account.active?
+          render json: { account: current_account.api_json }
+        elsif current_account.reactivatable?
+          current_account.update!(cancelled_at: nil)
+          render json: { account: current_account.api_json }
+        else
+          render_error("reactivation_expired", "The 90-day reactivation period has ended", :forbidden)
+        end
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..93e10bb
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,71 @@
+module Api
+  module V1
+    class BaseController < ApplicationController
+      before_action :load_account
+      around_action :lock_account
+      before_action :require_active_account
+
+      private
+
+      attr_reader :current_account, :current_user, :current_session
+
+      def load_account
+        subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase
+        if subdomain.empty?
+          render_error("account_required", "X-Helpdesk-Account is required", :bad_request)
+        else
+          @current_account = Account.find_by!(subdomain: subdomain)
+        end
+      end
+
+      # Serializing tenant operations prevents a concurrent login/token confirmation
+      # from bypassing cancellation or password-change session revocation.
+      def lock_account(&action)
+        current_account.with_lock(&action)
+      end
+
+      def require_active_account
+        unless current_account.active?
+          render_error("account_cancelled", "This account is cancelled", :forbidden)
+        end
+      end
+
+      def authenticate_user!
+        token = request.headers["Authorization"].to_s[/\ABearer ([A-Za-z0-9_-]{43})\z/i, 1]
+        @current_session = current_account.sessions.usable.find_by(token_digest: TokenDigest.call(token)) if token
+        @current_user = current_session&.user
+        unless current_user&.verified? && !current_user.suspended?
+          render_error("unauthorized", "A valid bearer session is required", :unauthorized)
+        end
+      end
+
+      def require_admin!
+        unless current_user.admin?
+          render_error("admin_required", "Only admins can do this", :forbidden)
+        end
+      end
+
+      def require_staff!
+        unless current_user.staff?
+          render_error("staff_required", "Only staff can do this", :forbidden)
+        end
+      end
+
+      def require_customer!
+        unless current_user.customer?
+          render_error("customer_required", "Only customers can do this", :forbidden)
+        end
+      end
+
+      def require_owner!
+        unless current_user.owner?
+          render_error("owner_required", "Only the account owner can do this", :forbidden)
+        end
+      end
+
+      def accessible_to?(user)
+        user && !user.suspended? && (current_account.active? || (user.owner? && current_account.reactivatable?))
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/conversations_controller.rb b/app/controllers/api/v1/conversations_controller.rb
new file mode 100644
index 0000000..2bcd6a6
--- /dev/null
+++ b/app/controllers/api/v1/conversations_controller.rb
@@ -0,0 +1,159 @@
+module Api
+  module V1
+    # Requests and tickets are role-specific views of the same conversation.
+    # BaseController holds the tenant lock/transaction throughout each action.
+    class ConversationsController < BaseController
+      include Pagination
+      before_action :authenticate_user!
+
+      def index
+        records = filtered_conversations.includes(:requester, :assignee, :group)
+        records = customer_view? ? records.publicly_recent : records.recently_active
+        render_paginated(records, resource_name.to_s.pluralize, cursor_order: { created_at: :desc, id: :desc }) do |ticket|
+          serialize(ticket)
+        end
+      end
+
+      def show
+        render_record(conversations.find(params[:id]))
+      end
+
+      def comments
+        ticket = conversations.find(params[:id])
+        records = ticket.comments
+        records = records.publicly_visible if customer_view?
+        render_paginated(records.includes(:author).chronological, :comments,
+          cursor_order: { created_at: :asc, id: :asc }, &:api_json)
+      end
+
+      def create
+        attributes = conversation_params(*creation_fields)
+        comment = attributes.delete(:comment) || {}
+        ticket = current_account.tickets.build(subject: attributes[:subject], requester: requester_for_creation(attributes))
+        ticket.group = group_for(attributes[:group_id]) if attributes.key?(:group_id)
+        ticket.assignee = assignee_for(attributes[:assignee_id]) if attributes.key?(:assignee_id)
+        ticket.priority = attributes[:priority] if attributes.key?(:priority)
+        ticket.comments.build(comment_attributes(comment))
+        ticket.save!
+        render_record(ticket, status: :created)
+      end
+
+      def update
+        ticket = conversations.find(params[:id])
+        ticket.ensure_editable!
+        attributes = conversation_params(*(customer_view? ? [ :status ] : [ :status, :assignee_id, :group_id, :priority ]))
+        if attributes.empty?
+          message = customer_view? ? "Supply a comment or status" : "Supply a comment, status, assignee, group, or priority"
+          raise ActionController::BadRequest, message
+        end
+        if customer_view? && attributes.key?(:status) && attributes[:status] != "solved"
+          return render_error("validation_failed", "Customers can only mark requests solved", :unprocessable_entity,
+            status: [ "must be solved" ])
+        end
+
+        if attributes.key?(:group_id)
+          attributes[:group] = group_for(attributes.delete(:group_id))
+        end
+        if attributes.key?(:assignee_id)
+          attributes[:assignee] = assignee_for(attributes.delete(:assignee_id))
+        end
+        Ticket.transaction do
+          if attributes.key?(:comment)
+            ticket.comments.create!(comment_attributes(attributes.delete(:comment)))
+            ticket.status = "open" if customer_view?
+          end
+          ticket.update!(attributes)
+        end
+        render_record(ticket)
+      end
+
+      private
+
+      def filtered_conversations
+        records = conversations
+        status = filter_value(:status, allowed: Ticket.statuses.keys)
+        records = records.where(status: status) if status
+        return records if customer_view?
+
+        priority = filter_value(:priority, allowed: Ticket.priorities.keys)
+        records = records.where(priority: priority) if priority
+        [ :assignee_id, :requester_id, :group_id ].each do |field|
+          value = filter_value(field)
+          next unless value
+
+          if [ :assignee_id, :group_id ].include?(field) && value == "unassigned"
+            records = records.where(field => nil)
+          elsif value.match?(/\A[1-9][0-9]*\z/)
+            records = records.where(field => value)
+          else
+            message = "#{field} must be a positive integer"
+            message += " or unassigned" if [ :assignee_id, :group_id ].include?(field)
+            raise ActionController::BadRequest, message
+          end
+        end
+        query = filter_value(:q)
+        query ? records.matching_text(query) : records
+      end
+
+      def filter_value(field, allowed: nil)
+        value = params[field]
+        return if value.nil? || value == ""
+
+        unless value.is_a?(String)
+          raise ActionController::BadRequest, "#{field} must be a string"
+        end
+        if allowed && !allowed.include?(value)
+          raise ActionController::BadRequest, "#{field} must be one of: #{allowed.join(', ')}"
+        end
+        value
+      end
+
+      def serialize(ticket)
+        ticket.api_json(include_requester: !customer_view?)
+      end
+
+      def render_record(ticket, status: :ok)
+        render json: { resource_name => serialize(ticket) }, status: status
+      end
+
+      def comment_attributes(attributes)
+        attributes = attributes.to_h.symbolize_keys.merge(author: current_user)
+        attributes[:public] = true if customer_view?
+        attributes
+      end
+
+      def group_for(id)
+        current_account.groups.find(id) unless id.nil?
+      end
+
+      def assignee_for(id)
+        return nil if id.nil?
+
+        current_account.users.available_staff.find(id)
+      end
+
+      def conversation_params(*fields)
+        envelope = params[resource_name]
+        unless envelope.is_a?(ActionController::Parameters)
+          raise ActionController::ParameterMissing, resource_name
+        end
+        validate_strings(envelope.slice(*(fields & [ :subject, :status, :priority ])))
+        id_fields = fields & [ :assignee_id, :group_id ] & envelope.keys.map(&:to_sym)
+        validate_ids(envelope, id_fields, allow_nil: true)
+        attributes = envelope.permit(*fields)
+        if envelope.key?(:comment)
+          comment = envelope[:comment]
+          unless comment.is_a?(ActionController::Parameters)
+            raise ActionController::BadRequest, "comment must be an object"
+          end
+          validate_strings(comment.slice(:body))
+          if comment.key?(:public) && ![ true, false ].include?(comment[:public])
+            raise ActionController::BadRequest, "public must be a boolean"
+          end
+          attributes[:comment] = comment.permit(:body, :public)
+        end
+        attributes
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_links_controller.rb b/app/controllers/api/v1/email_links_controller.rb
new file mode 100644
index 0000000..62ec7a9
--- /dev/null
+++ b/app/controllers/api/v1/email_links_controller.rb
@@ -0,0 +1,30 @@
+module Api
+  module V1
+    # Shared tenant scoping and anti-enumeration behavior for both link flows.
+    class EmailLinksController < BaseController
+      skip_before_action :require_active_account
+
+      private
+
+      def send_link(purpose)
+        attributes = string_params(purpose.to_sym, [ :email ])
+        user = current_account.users.find_by(email: attributes[:email].to_s.strip.downcase)
+        if accessible_to?(user) && (purpose != "email_verification" || !user.verified?)
+          token = EmailToken.issue!(user, purpose)
+          UserMailer.public_send(purpose, user, token).deliver_now
+        end
+        render json: { message: "If the address is eligible, a link has been sent." }, status: :accepted
+      end
+
+      def find_link(purpose, raw_token)
+        if raw_token.present?
+          link = current_account.email_tokens.usable.find_by(purpose: purpose, token_digest: TokenDigest.call(raw_token))
+        end
+        return link if link && accessible_to?(link.user)
+
+        render_error("invalid_token", "This link is invalid or has expired", :unprocessable_entity)
+        nil
+      end
+    end
+  end
+end
