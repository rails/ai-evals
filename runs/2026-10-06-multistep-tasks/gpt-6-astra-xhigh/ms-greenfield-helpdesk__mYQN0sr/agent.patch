+++ b/config/initializers/mail_delivery.rb
@@ -0,0 +1,15 @@
+# Development defaults to files in tmp/mails; tests use Action Mailer's test
+# delivery method. Production (or development with SMTP_ADDRESS) uses SMTP.
+if !Rails.env.test? && (Rails.env.production? || ENV["SMTP_ADDRESS"].present?)
+  ActionMailer::Base.delivery_method = :smtp
+  ActionMailer::Base.raise_delivery_errors = true
+  ActionMailer::Base.smtp_settings = {
+    address: ENV.fetch("SMTP_ADDRESS", "localhost"),
+    port: Integer(ENV.fetch("SMTP_PORT", "25")),
+    domain: ENV.fetch("SMTP_DOMAIN", "localhost"),
+    user_name: ENV["SMTP_USERNAME"],
+    password: ENV["SMTP_PASSWORD"],
+    authentication: ENV["SMTP_USERNAME"].present? ? ENV.fetch("SMTP_AUTHENTICATION", "plain") : nil,
+    enable_starttls_auto: true
+  }.compact
+end
