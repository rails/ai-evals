+
+  test "a pending staff invitation is not converted into an email customer" do
+    @account.invitations.create!(email: "customer@example.test", role: "agent",
+      token_digest: TokenDigest.call("invitation"), expires_at: 1.day.from_now)
+    assert_ignored email_source
