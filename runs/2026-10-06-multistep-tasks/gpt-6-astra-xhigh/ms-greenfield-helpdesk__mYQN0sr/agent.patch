+    }, @public_auth ]
+    assert_equal [ 201, 422 ], concurrently(operation, operation).sort
+    assert_equal 1, @account.users.where(email: invitation.email, role: "agent").where.not(verified_at: nil).count
+    assert invitation.reload.accepted?
+  end
+
+  test "simultaneous suspensions cannot remove all active admins" do
+    other = @account.users.create!(name: "Other", email: "other@example.test", role: "admin", password: PASSWORD, verified_at: Time.current)
+    first = [ :patch, "/api/v1/users/#{@admin.id}", { user: { suspended: true } }, @auth ]
