diff --git a/app/controllers/application_controller.rb b/app/controllers/application_controller.rb
new file mode 100644
index 0000000..4ac1a24
--- /dev/null
+++ b/app/controllers/application_controller.rb
@@ -0,0 +1,53 @@
+class ApplicationController < ActionController::API
+  before_action { response.set_header("Cache-Control", "no-store") }
+
+  rescue_from ActionController::ParameterMissing, ActionController::BadRequest do |exception|
+    render_error("invalid_request", exception.message, :bad_request)
+  end
+  rescue_from ActionDispatch::Http::Parameters::ParseError do
+    render_error("invalid_json", "Request body must be valid JSON", :bad_request)
+  end
+  rescue_from ActiveRecord::RecordInvalid do |exception|
+    render_error("validation_failed", "Validation failed", :unprocessable_entity, exception.record.errors.to_hash)
+  end
+  rescue_from ActiveRecord::RecordNotUnique do
+    render_error("validation_failed", "A record with these details already exists", :unprocessable_entity)
+  end
+  rescue_from ActiveRecord::RecordNotFound do
+    render_error("not_found", "Record not found", :not_found)
+  end
+
+  private
+
+  def render_error(code, message, status, details = nil)
+    error = { code: code, message: message }
+    error[:details] = details if details
+    render json: { error: error }, status: status
+  end
+
+  def string_params(key, fields)
+    validate_strings(params.expect(key => fields))
+  end
+
+  def validate_ids(attributes, fields, allow_nil: false)
+    fields.each do |field|
+      value = attributes[field]
+      next if allow_nil && value.nil?
+      next if value.is_a?(Integer) && value.positive?
+      next if value.is_a?(String) && value.match?(/\A[1-9][0-9]*\z/)
+
+      message = "#{field} must be a positive integer"
+      message += " or null" if allow_nil
+      raise ActionController::BadRequest, message
+    end
+  end
+
+  def validate_strings(attributes)
+    attributes.each do |key, value|
+      unless value.nil? || value.is_a?(String)
+        raise ActionController::BadRequest, "#{key} must be a string"
+      end
+    end
+    attributes
+  end
+end
diff --git a/app/controllers/concerns/pagination.rb b/app/controllers/concerns/pagination.rb
new file mode 100644
index 0000000..75ae70d
--- /dev/null
+++ b/app/controllers/concerns/pagination.rb
@@ -0,0 +1,86 @@
+module Pagination
+  CURSOR_DEFAULT_SIZE = 25
+  CURSOR_MAX_SIZE = 100
+
+  private
+
+  def render_paginated(scope, resource, cursor_order: { id: :asc }, &serialize)
+    if params[:page].is_a?(ActionController::Parameters)
+      render_cursor_paginated(scope, resource, cursor_order, &serialize)
+    else
+      render_numbered_page(scope, resource, &serialize)
+    end
+  end
+
+  def render_cursor_paginated(scope, resource, order)
+    page = params[:page]
+    if params.key?(:per_page) || (page.keys - %w[size after before]).any? ||
+        (page.key?(:after) && page.key?(:before))
+      raise ActionController::BadRequest, "Use page[size] with at most one of page[after] or page[before]; do not mix pagination modes"
+    end
+    size = positive_integer(page.fetch(:size, CURSOR_DEFAULT_SIZE), "page[size]")
+    if size > CURSOR_MAX_SIZE
+      raise ActionController::BadRequest, "page[size] must be at most #{CURSOR_MAX_SIZE}"
+    end
+    %i[after before].each do |direction|
+      next unless page.key?(direction)
+
+      value = page[direction]
+      unless value.is_a?(String) && value.present? && value.bytesize <= 2048
+        raise ActionController::BadRequest, "page[#{direction}] must be a nonempty cursor"
+      end
+    end
+
+    # Bind tokens to the tenant, viewer, endpoint (including a comment's parent),
+    # effective filters/visibility, and immutable ordering. Page size may change.
+    context = Digest::SHA256.hexdigest([
+      current_account.id, current_user.id, request.path, order.to_a,
+      scope.except(:order, :includes, :preload, :eager_load).to_sql
+    ].to_json)
+    result = CursorPage.new(scope, order: order, context: context, size: size,
+      after: page[:after], before: page[:before])
+    after_cursor = result.after_cursor
+    before_cursor = result.before_cursor
+    render json: {
+      resource => result.records.map { |record| yield record },
+      meta: { has_more: result.has_more, after_cursor: after_cursor, before_cursor: before_cursor },
+      links: {
+        next: result.next? ? cursor_link(size, :after, after_cursor) : nil,
+        prev: result.previous? ? cursor_link(size, :before, before_cursor) : nil
+      }
+    }
+  end
+
+  def cursor_link(size, direction, cursor)
+    query = request.query_parameters.except("page", "per_page")
+      .merge("page" => { "size" => size, direction.to_s => cursor })
+    "#{request.path}?#{query.to_query}"
+  end
+
+  def render_numbered_page(scope, resource)
+    page = positive_page_parameter(:page, 1)
+    per_page = positive_page_parameter(:per_page, 25)
+    count = scope.count
+    offset = (page - 1) * per_page
+    # Avoid a query (and oversized SQL offsets) for pages beyond the last record.
+    records = offset < count ? scope.offset(offset).limit([ per_page, count ].min) : []
+    render json: {
+      resource => records.map { |record| yield record },
+      count: count, page: page, per_page: per_page,
+      next_page: page * per_page < count ? page + 1 : nil,
+      previous_page: page > 1 ? page - 1 : nil
+    }
+  end
+
+  def positive_page_parameter(name, default)
+    positive_integer(params.fetch(name, default), name)
+  end
+
+  def positive_integer(value, name)
+    unless (value.is_a?(String) || value.is_a?(Integer)) &&
+        value.to_s.match?(/\A[0-9]+\z/) && value.to_i.positive?
+      raise ActionController::BadRequest, "#{name} must be a positive integer"
+    end
+    value.to_i
+  end
+end
