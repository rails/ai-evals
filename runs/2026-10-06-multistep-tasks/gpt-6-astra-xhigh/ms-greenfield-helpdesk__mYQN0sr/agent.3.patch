diff --git a/app/controllers/api/v1/invitations_controller.rb b/app/controllers/api/v1/invitations_controller.rb
new file mode 100644
index 0000000..6a6fc44
--- /dev/null
+++ b/app/controllers/api/v1/invitations_controller.rb
@@ -0,0 +1,50 @@
+module Api
+  module V1
+    class InvitationsController < BaseController
+      include Pagination
+      before_action :authenticate_user!
+      before_action :require_admin!
+      before_action { current_account.invitations.expire_pending! }
+
+      def index
+        records = current_account.invitations.order(:id)
+        if params.key?(:status)
+          unless Invitation.statuses.key?(params[:status])
+            raise ActionController::BadRequest, "status must be pending, accepted, revoked, or expired"
+          end
+          records = records.where(status: params[:status])
+        end
+        render_paginated(records, :invitations, &:api_json)
+      end
+
+      def show
+        render json: { invitation: invitation.api_json }
+      end
+
+      def create
+        record = current_account.invitations.build(string_params(:invitation, [ :email, :role ]))
+        token = record.renew!
+        InvitationMailer.invitation(record, token).deliver_now
+        render json: { invitation: record.api_json }, status: :created
+      end
+
+      def resend
+        record = invitation
+        token = record.renew!
+        InvitationMailer.invitation(record, token).deliver_now
+        render json: { invitation: record.api_json }
+      end
+
+      def destroy
+        invitation.revoke!
+        head :no_content
+      end
+
+      private
+
+      def invitation
+        current_account.invitations.find(params[:id])
+      end
+    end
+  end
+end
