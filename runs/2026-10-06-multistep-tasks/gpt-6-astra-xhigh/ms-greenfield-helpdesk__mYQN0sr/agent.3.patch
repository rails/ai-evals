diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..d7ca713
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,49 @@
+module Api
+  module V1
+    class UsersController < BaseController
+      include Pagination
+      before_action :authenticate_user!
+      before_action :require_admin!
+
+      def index
+        records = current_account.users.order(:id)
+        if params.key?(:role)
+          raise ActionController::BadRequest, "Invalid role" unless User.roles.key?(params[:role])
+          records = records.where(role: params[:role])
+        end
+        if params.key?(:suspended)
+          unless %w[true false].include?(params[:suspended])
+            raise ActionController::BadRequest, "suspended must be true or false"
+          end
+          records = records.where(suspended: params[:suspended] == "true")
+        end
+        render_paginated(records, :users, &:api_json)
+      end
+
+      def show
+        render json: { user: user.api_json }
+      end
+
+      def update
+        envelope = params[:user]
+        unless envelope.is_a?(ActionController::Parameters)
+          raise ActionController::ParameterMissing, :user
+        end
+        validate_strings(envelope.slice(:name))
+        if envelope.key?(:suspended) && ![ true, false ].include?(envelope[:suspended])
+          raise ActionController::BadRequest, "suspended must be a boolean"
+        end
+        attributes = params.expect(user: [ :name, :suspended ])
+        record = user
+        record.update!(attributes)
+        render json: { user: record.api_json }
+      end
+
+      private
+
+      def user
+        current_account.users.find(params[:id])
+      end
+    end
+  end
+end
