+    domain: ENV.fetch("SMTP_DOMAIN", "localhost"),
+    user_name: ENV["SMTP_USERNAME"],
+    password: ENV["SMTP_PASSWORD"],
+    authentication: ENV["SMTP_USERNAME"].present? ? ENV.fetch("SMTP_AUTHENTICATION", "plain") : nil,
