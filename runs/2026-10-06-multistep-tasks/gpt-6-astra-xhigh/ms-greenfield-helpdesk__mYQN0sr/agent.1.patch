@@ -0,0 +1,29 @@
+module Api
+  module V1
+    class SessionsController < BaseController
+      skip_before_action :require_active_account
+      before_action :authenticate_user!, only: :destroy
+
+      def create
+        credentials = string_params(:session, [ :email, :password ])
+        user = current_account.users.find_by(email: credentials[:email].to_s.strip.downcase)
+        unless user && credentials[:password].present? && user.authenticate(credentials[:password])
+          return render_error("invalid_credentials", "Invalid email or password", :unauthorized)
+        end
+        unless user.verified?
+          return render_error("email_unverified", "Verify your email before signing in", :forbidden)
+        end
+        unless accessible_to?(user)
+          return render_error("account_cancelled", "This account is cancelled or its reactivation period has ended", :forbidden)
+        end
+        token = Session.issue!(user)
+        render json: { user: user.api_json, account: current_account.api_json, session: { token: token } }, status: :created
+      end
+
+      def destroy
+        current_session.destroy!
+        head :no_content
+      end
+    end
+  end
+end
