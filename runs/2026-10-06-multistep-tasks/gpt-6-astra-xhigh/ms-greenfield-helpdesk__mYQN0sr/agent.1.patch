index 0000000..62ec7a9
--- /dev/null
+++ b/app/controllers/api/v1/email_links_controller.rb
@@ -0,0 +1,30 @@
+module Api
+  module V1
+    # Shared tenant scoping and anti-enumeration behavior for both link flows.
+    class EmailLinksController < BaseController
+      skip_before_action :require_active_account
+
+      private
+
+      def send_link(purpose)
+        attributes = string_params(purpose.to_sym, [ :email ])
+        user = current_account.users.find_by(email: attributes[:email].to_s.strip.downcase)
+        if accessible_to?(user) && (purpose != "email_verification" || !user.verified?)
+          token = EmailToken.issue!(user, purpose)
+          UserMailer.public_send(purpose, user, token).deliver_now
+        end
+        render json: { message: "If the address is eligible, a link has been sent." }, status: :accepted
+      end
+
+      def find_link(purpose, raw_token)
+        if raw_token.present?
+          link = current_account.email_tokens.usable.find_by(purpose: purpose, token_digest: TokenDigest.call(raw_token))
+        end
+        return link if link && accessible_to?(link.user)
+
+        render_error("invalid_token", "This link is invalid or has expired", :unprocessable_entity)
+        nil
+      end
+    end
+  end
+end
