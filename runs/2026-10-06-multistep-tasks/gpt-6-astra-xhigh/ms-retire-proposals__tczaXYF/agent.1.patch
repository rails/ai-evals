+    ordinary = legacy_row("delayed_jobs", handler: "A debate about a Proposal for a park", run_at: 1.minute.ago)
+    foreign_tenant = legacy_row("delayed_jobs", handler: "gid://consul/Comment/#{comment_id}",
+                                               run_at: 1.minute.ago, tenant: "another_tenant")
+    ready_ids = Delayed::Job.ready_to_run("test-worker", 1.hour).pluck(:id)
+    expect(ready_ids & retired).to be_empty
+    expect(ready_ids).to include(kept, ordinary, foreign_tenant)
+    expect(Delayed::Job.reserve(Delayed::Worker.new).id).to eq(kept)
+    expect(Delayed::Job.where(id: retired).count).to eq(retired.size)
+  end
+end
