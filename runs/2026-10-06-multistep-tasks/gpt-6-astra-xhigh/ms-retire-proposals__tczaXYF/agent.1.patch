diff --git a/config/initializers/retired_proposal_jobs.rb b/config/initializers/retired_proposal_jobs.rb
new file mode 100644
index 0000000..b4949df
--- /dev/null
+++ b/config/initializers/retired_proposal_jobs.rb
@@ -0,0 +1,43 @@
+# Do not deserialize work queued by the previous release for removed classes.
+# Leave these rows intact for the backed-up cleanup in deploy 3.
+module RetiredProposalJobs
+  def ready_to_run(...)
+    # Match serialization metadata, NOT ordinary text mentioning a proposal.
+    # Avoid literal ? in regexes: Delayed Job embeds this SQL in a second
+    # parameterized reservation query, where Rails would treat ? as a bind.
+    retired = "(Proposal(Notification){0,1}|Link|Dashboard::[[:alnum:]_:]+)"
+    yaml_class = "!ruby/(object|ActiveRecord):#{retired}([[:space:]]|$)|" \
+                 "!ruby/(class|module)[[:space:]]+['\"]{0,1}#{retired}['\"]{0,1}([[:space:]]|$)"
+    global_id = "gid://[^/[:space:]]+/#{retired}/"
+    owner_type = "(commentable|remote_translatable|signable|notifiable|followable|flaggable|" \
+                 "relatable|related)_type"
+    owner_metadata = "(name: #{owner_type}[[:space:]]+value_before_type_cast: |#{owner_type}: )" \
+                     "['\"]{0,1}#{retired}['\"]{0,1}([[:space:]]|$)"
+    scope = super.where("handler !~ ?", "#{yaml_class}|#{global_id}|#{owner_metadata}")
+                 .where("handler !~ ?", "(^|[[:space:]'\"])Dashboard::Mailer([[:space:]'\"]|$)")
+                 .where("handler NOT LIKE ?", "%proposal_notification_digest%")
+                 .where("handler !~ ?", "method_name: :{0,1}send_pending")
+
+    # ActiveJob stores only GlobalIDs, rather than the YAML owner attributes.
+    # Queue storage is shared across tenants: never compare another tenant's IDs
+    # with rows from the current schema. Other tenants' queues need their own review.
+    indirect = {
+      "Comment" => RetiredCitizenProposalData.comments,
+      "Topic" => RetiredCitizenProposalData.topics,
+      "Poll" => RetiredCitizenProposalData.polls,
+      "RemoteTranslation" => "SELECT id FROM remote_translations WHERE remote_translatable_type = 'Proposal'",
+      "SignatureSheet" => "SELECT id FROM signature_sheets WHERE signable_type = 'Proposal'"
+    }
+    indirect.each do |type, ids|
+      pattern = "gid://[^/[:space:]]+/#{type}/([0-9]+)"
+      scope = scope.where(
+        "COALESCE(tenant, 'public') <> ? OR " \
+        "COALESCE(substring(handler from ?), '') NOT IN (SELECT id::text FROM (#{ids}) retired_ids)",
+        Tenant.current_schema, pattern
+      )
+    end
+    scope
+  end
+end
+
+Delayed::Backend::ActiveRecord::Job.singleton_class.prepend(RetiredProposalJobs)
