+
+      other_bot = users(:jz).bots.create!(name: "Quiet Bot")
+      @room.memberships.grant_to(other_bot)
+      post bot_room_messages_url(@room, other_bot.bot_code), params: "Hello"
+      assert_response :created
+    end
+  end
