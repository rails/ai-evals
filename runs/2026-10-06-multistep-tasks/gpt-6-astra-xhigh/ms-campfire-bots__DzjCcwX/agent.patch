+<%= form_with model: bot, scope: :bot, url: bot.new_record? ? bots_path : bot_path(bot), class: "flex flex-column gap" do |form| %>
+  <% if bot.errors.any? %>
+    <div role="alert">
+      <%= bot.errors.full_messages.to_sentence %>
+    </div>
+  <% end %>
+
+  <div class="align-center center avatar__form gap" data-controller="upload-preview">
+    <label class="btn avatar input--file txt-xx-large">
+      <%= image_tag bot.persisted? ? fresh_user_avatar_path(bot) : "default-avatar.svg", size: 300, aria: { hidden: "true" }, data: { upload_preview_target: "image" } %>
+      <%= form.file_field :avatar, class: "input", accept: "image/*", data: { upload_preview_target: "input", action: "upload-preview#previewImage" } %>
+      <span class="for-screen-reader">Bot avatar</span>
+    </label>
+  </div>
+
+  <%= form.label :name, "Name the bot" %>
+  <%= form.text_field :name, class: "input", required: true, autofocus: true, autocomplete: "off" %>
+
+  <%= form.label :webhook_url, "Webhook URL" %>
+  <%= form.url_field :webhook_url, class: "input", autocomplete: "off" %>
+  <p class="txt-small">Optional. Receive a callback when this bot joins a room or someone mentions it.</p>
+
+  <%= form.label :add_to_all_open_rooms, class: "flex align-center gap" do %>
+    <span class="flex-item-grow">Add to all open rooms</span>
+    <span class="switch">
+      <%= form.check_box :add_to_all_open_rooms, class: "switch__input" %>
+      <span class="switch__btn round"></span>
+    </span>
+  <% end %>
+  <p class="txt-small">Include existing and future open rooms. Turning this off keeps the bot’s current rooms.</p>
+
+  <%= form.submit "Save changes", class: "btn btn--reversed center" %>
+<% end %>
