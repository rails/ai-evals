@@ -0,0 +1,26 @@
+require "test_helper"
+
+class BotMessageRequestTest < ActiveSupport::TestCase
+  test "codes are redacted from request paths, environment and parameters" do
+    path = "/rooms/123/secret-bot-code/messages"
+    request = ActionDispatch::Request.new(Rack::MockRequest.env_for("#{path}?bot_code=also-secret", method: "POST"))
+    request.set_header "action_dispatch.parameter_filter", Rails.application.config.filter_parameters
+    request.path_parameters = { room_id: "123", bot_code: "secret-bot-code" }
+
+    assert_equal "/rooms/123/[FILTERED]/messages?bot_code=[FILTERED]", request.filtered_path
+    assert_equal "/rooms/123/[FILTERED]/messages", request.filtered_env["PATH_INFO"]
+    assert_equal "[FILTERED]", request.filtered_parameters["bot_code"]
+    assert_empty request.request_parameters
+  end
+
+  test "trailing slash URLs are also redacted" do
+    request = ActionDispatch::Request.new(Rack::MockRequest.env_for("/rooms/123/secret-bot-code/messages/", method: "POST"))
+    assert_equal "/rooms/123/[FILTERED]/messages/", request.filtered_path
+    assert_empty request.request_parameters
+  end
+
+  test "normal requests still parse bodies" do
+    request = ActionDispatch::Request.new(Rack::MockRequest.env_for("/bots", method: "POST", input: "bot[name]=Deploy", "CONTENT_TYPE" => "application/x-www-form-urlencoded"))
+    assert_equal "Deploy", request.request_parameters.dig("bot", "name")
+  end
+end
