diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..3fb24b6
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,53 @@
+module User::Bot
+  extend ActiveSupport::Concern
+  include Safety
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :bots, -> { bot }, class_name: "User", foreign_key: :creator_id, dependent: :destroy
+
+    has_many :bot_room_joins, class_name: "User::Bot::RoomJoin", foreign_key: :bot_id, dependent: :delete_all
+
+    scope :automatically_joining_open_rooms, -> { where.not(role: :bot).or(where(role: :bot, add_to_all_open_rooms: true)) }
+
+    validates :name, :creator, presence: true, if: :bot?
+    validate :creator_has_capacity_for_another_bot, on: :create, if: :bot?
+    normalizes :webhook_url, with: ->(url) { url.strip.presence }
+    validate :webhook_url_is_http, if: -> { bot? && webhook_url.present? }
+
+    before_validation :set_bot_credentials, on: :create, if: :bot?
+    after_save_commit :join_all_open_rooms, if: -> { bot? && active? && add_to_all_open_rooms? && saved_change_to_add_to_all_open_rooms? }
+  end
+
+  def can_create_bot?
+    return true if administrator?
+
+    # The create validation must not reuse a cached preflight check from the controller.
+    User.uncached do
+      bots.not_deactivated.count < Current.account.settings.bots_per_member
+    end
+  end
+
+  private
+    def creator_has_capacity_for_another_bot
+      if creator && !creator.can_create_bot?
+        errors.add :base, "You've reached the limit of bots per member."
+      end
+    end
+
+    def join_all_open_rooms
+      Rooms::Open.find_each { |room| room.memberships.grant_to(self) }
+    end
+
+    def webhook_url_is_http
+      url = URI.parse(webhook_url) rescue nil
+      unless url.is_a?(URI::HTTP) && url.host.present? && url.userinfo.nil?
+        errors.add :webhook_url, "must be an HTTP or HTTPS URL without credentials"
+      end
+    end
+
+    def set_bot_credentials
+      self.bot_code ||= SecureRandom.base58(32)
+      self.password = SecureRandom.base58(32) if password_digest.blank?
+    end
+end
diff --git a/app/models/user/bot/room_join.rb b/app/models/user/bot/room_join.rb
new file mode 100644
index 0000000..012aff7
--- /dev/null
+++ b/app/models/user/bot/room_join.rb
@@ -0,0 +1,21 @@
+class User::Bot::RoomJoin < ApplicationRecord
+  self.table_name = "bot_room_joins"
+
+  belongs_to :bot, class_name: "User"
+  belongs_to :room
+
+  after_create_commit :deliver_later
+
+  def deliver
+    # Keep the receipt even when a membership is revoked. Claim before HTTP so
+    # rejoining, concurrent workers and replayed jobs cannot send a second hello.
+    if self.class.where(id: id, attempted_at: nil).update_all(attempted_at: Time.current) == 1
+      User::Bot::Webhook.new(bot: bot, room: room).deliver
+    end
+  end
+
+  private
+    def deliver_later
+      User::Bot::JoinedWebhookJob.perform_later(self)
+    end
+end
diff --git a/app/models/user/bot/safety.rb b/app/models/user/bot/safety.rb
new file mode 100644
index 0000000..b12f0b7
--- /dev/null
+++ b/app/models/user/bot/safety.rb
@@ -0,0 +1,82 @@
+module User::Bot::Safety
+  extend ActiveSupport::Concern
+
+  MESSAGE_LIMIT = 10
+  MESSAGE_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  class PostingForbidden < StandardError; end
+
+  class PostingThrottled < StandardError
+    attr_reader :retry_after
+
+    def initialize(retry_after)
+      @retry_after = retry_after
+      super("Bot is cooling down")
+    end
+  end
+
+  # Both posting paths create their message inside this lock. The bounded sliding
+  # window and message commit together, across rooms, requests and job workers.
+  def with_bot_posting
+    message = error = nil
+
+    with_lock do
+      now = Time.current
+
+      if !active?
+        error = PostingForbidden.new
+      elsif bot_cooldown_until && bot_cooldown_until > now
+        self.bot_cooldown_attempts += 1
+        suspend_bot("Flooding: five posting attempts during a cooldown.") if bot_cooldown_attempts >= COOLDOWN_ATTEMPT_LIMIT
+        save!
+        error = suspended? ? PostingForbidden.new : PostingThrottled.new((bot_cooldown_until - now).ceil)
+      else
+        self.bot_message_timestamps = bot_message_timestamps.select { |timestamp| timestamp > (now - MESSAGE_WINDOW).to_f }
+        self.bot_cooldown_attempts = 0
+        self.bot_cooldown_until = nil
+
+        if bot_message_timestamps.size >= MESSAGE_LIMIT
+          self.bot_cooldown_until = now + COOLDOWN
+          error = PostingThrottled.new(COOLDOWN.to_i)
+        elsif message = yield
+          self.bot_message_timestamps += [ now.to_f ]
+        end
+
+        save!
+      end
+    end
+
+    # Raise only after committing; a rejected attempt must not roll back the
+    # cooldown or suspension that it just triggered.
+    raise error if error
+    message
+  end
+
+  def record_bot_webhook_delivery(successful:)
+    with_lock do
+      if active?
+        self.bot_webhook_failures = successful ? 0 : bot_webhook_failures + 1
+        suspend_bot("Failing webhooks: ten consecutive failed deliveries.") if bot_webhook_failures >= WEBHOOK_FAILURE_LIMIT
+        save!
+      end
+    end
+  end
+
+  def reactivate_bot
+    with_lock do
+      if suspended?
+        update! status: :active, bot_suspension_reason: nil, bot_message_timestamps: [],
+          bot_cooldown_until: nil, bot_cooldown_attempts: 0, bot_webhook_failures: 0
+      end
+    end
+  end
+
+  private
+    def suspend_bot(reason)
+      self.status = :suspended
+      self.bot_suspension_reason = reason
+    end
+end
