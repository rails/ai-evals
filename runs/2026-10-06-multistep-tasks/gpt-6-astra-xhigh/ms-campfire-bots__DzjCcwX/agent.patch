diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..4ae0cd1
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,41 @@
+class Bots::MessagesController < ApplicationController
+  include ActiveStorage::SetCurrent, RoomScoped
+
+  allow_unauthenticated_access
+  skip_forgery_protection
+  prepend_before_action :authenticate_bot
+
+  rescue_from(ActiveRecord::RecordNotFound) { head :not_found }
+  rescue_from(User::Bot::Safety::PostingForbidden) { head :forbidden }
+  rescue_from User::Bot::Safety::PostingThrottled do |error|
+    response.headers["Retry-After"] = error.retry_after.to_s
+    head :too_many_requests
+  end
+
+  def create
+    body = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+    message = Current.user.with_bot_posting do
+      if body.valid_encoding? && body.present?
+        @room.messages.create!(body: ERB::Util.html_escape(body).gsub(/\r\n?|\n/, "<br>"))
+      end
+    end
+
+    if message
+      message.broadcast_create
+      head :created, location: message_path(message)
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  private
+    def authenticate_bot
+      # The path is the only source of credentials, never a query or body parameter.
+      Current.user = User.bot.active_or_suspended.find_by(bot_code: request.path_parameters[:bot_code])
+      if !Current.user
+        head :unauthorized
+      elsif Current.user.suspended?
+        head :forbidden
+      end
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..7855af6
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,69 @@
+class BotsController < ApplicationController
+  before_action :prevent_caching
+  before_action :ensure_can_create_bot, only: %i[ new create ]
+  before_action :ensure_can_administer, only: :reactivate
+  before_action :set_bot, only: %i[ edit update destroy reactivate ]
+
+  def index
+    @bots = accessible_bots.ordered.with_attached_avatar
+  end
+
+  def new
+    @bot = Current.user.bots.new
+  end
+
+  def create
+    @bot = Current.user.bots.new(bot_params)
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def reactivate
+    @bot.reactivate_bot
+    redirect_to bots_url, status: :see_other
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url, status: :see_other
+  end
+
+  private
+    def ensure_can_create_bot
+      unless Current.user.can_create_bot?
+        redirect_to bots_url, alert: "You've reached the limit of bots per member.", status: :see_other
+      end
+    end
+
+    def accessible_bots
+      bots = Current.user.administrator? ? User.bot : Current.user.bots
+      bots.active_or_suspended
+    end
+
+    def set_bot
+      @bot = accessible_bots.find(params[:id])
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar, :webhook_url, :add_to_all_open_rooms)
+    end
+
+    def prevent_caching
+      response.headers["Cache-Control"] = "no-store"
+    end
+end
