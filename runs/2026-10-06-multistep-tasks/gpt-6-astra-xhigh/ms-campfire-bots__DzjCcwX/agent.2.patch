diff --git a/app/models/user/bot/webhook.rb b/app/models/user/bot/webhook.rb
new file mode 100644
index 0000000..aaff3b2
--- /dev/null
+++ b/app/models/user/bot/webhook.rb
@@ -0,0 +1,84 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class User::Bot::Webhook
+  MAX_REPLY_SIZE = 1.megabyte
+  HTTP_TIMEOUT = 5
+
+  attr_reader :bot, :message
+
+  def initialize(bot:, message:)
+    @bot, @message = bot, message
+  end
+
+  def deliver
+    if deliverable? && (body = fetch_reply)
+      # Access or the webhook may have been revoked while waiting for the response.
+      if bot.reload.active? && bot.webhook_url.present? && bot.rooms.exists?(message.room_id)
+        message.room.messages.create!(creator: bot, body: body).broadcast_create
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      bot.bot? && bot.active? && bot.webhook_url.present? && !message.creator.bot? && message.mentionees.exists?(bot.id)
+    end
+
+    def payload
+      routes = Rails.application.routes.url_helpers
+      {
+        event: "mention",
+        author: { id: message.creator.id, name: message.creator.name },
+        room: { id: message.room.id, name: message.room.name, reply_to: routes.bot_room_messages_path(message.room, bot.bot_code) },
+        message: {
+          id: message.id,
+          body: { text: command_text, html: message.body.to_s },
+          link: routes.room_at_message_path(message.room, message)
+        }
+      }
+    end
+
+    def command_text
+      message.body.body.render_attachments do |attachment|
+        attachment.attachable == bot ? "" : attachment.to_html
+      end.to_plain_text.strip
+    end
+
+    def fetch_reply
+      url = URI.parse(bot.webhook_url)
+      ip = RestrictedHTTP::PrivateNetworkGuard.resolve(url.hostname)
+      request = Net::HTTP::Post.new(url, "Content-Type" => "application/json")
+      request.body = payload.to_json
+
+      # Pin the checked address and disable environment proxies. Never forward the
+      # message or bot posting credential to a redirect target.
+      Net::HTTP.start(url.hostname, url.port, nil, ipaddr: ip, use_ssl: url.scheme == "https",
+        open_timeout: HTTP_TIMEOUT, read_timeout: HTTP_TIMEOUT, write_timeout: HTTP_TIMEOUT, max_retries: 0) do |http|
+        http.request(request) { |response| return reply_body(response) }
+      end
+    rescue => error
+      # URLs and payloads can contain credentials; don't include them in logs.
+      Rails.logger.warn "Bot webhook failed for bot #{bot.id}, message #{message.id} (#{error.class})"
+      nil
+    end
+
+    def reply_body(response)
+      return unless response.is_a?(Net::HTTPOK) && response.content_type.in?(%w[ text/plain text/html ])
+      return if response.content_length.to_i > MAX_REPLY_SIZE
+
+      body = +""
+      response.read_body do |chunk|
+        return if body.bytesize + chunk.bytesize > MAX_REPLY_SIZE
+        body << chunk
+      end
+      body.force_encoding(Encoding::UTF_8)
+      return unless body.valid_encoding? && body.present?
+
+      if response.content_type == "text/plain"
+        ERB::Util.html_escape(body).gsub(/\r\n?|\n/, "<br>")
+      else
+        body
+      end
+    end
+end
