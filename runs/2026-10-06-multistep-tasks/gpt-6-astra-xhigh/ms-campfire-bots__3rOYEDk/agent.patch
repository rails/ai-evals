+++ b/lib/rails_ext/filter_bot_codes.rb
@@ -0,0 +1,8 @@
+# Parameter filtering does not redact credentials embedded in a URL's path.
+module FilterBotCodes
+  def filtered_path
+    super.sub(%r{\A(/rooms/[^/]+/)[^/]+(/messages(?:\.[^/?]+)?(?:\?|\z))}, '\1[FILTERED]\2')
+  end
+end
+
+ActionDispatch::Request.prepend FilterBotCodes
