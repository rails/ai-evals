+require "test_helper"
+
+class User::BotRoomsTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Selective Bot", webhook_url: "https://bot.example.com/events")
+  end
+
+  test "bots do not join existing or future open rooms by default" do
+    assert_not @bot.add_to_all_open_rooms?
+    assert_empty @bot.rooms
+
+    room = Rooms::Open.create!(name: "New room", creator: users(:david))
+    assert_not room.users.exists?(@bot.id)
+    assert room.users.exists?(users(:jz).id)
+  end
+
+  test "opting in on creation joins existing open rooms with one event each" do
+    bot = nil
+    assert_enqueued_jobs Rooms::Open.count, only: User::Bot::JoinedWebhookJob do
+      bot = users(:jz).bots.create!(name: "Everyone Bot", add_to_all_open_rooms: true, webhook_url: @bot.webhook_url)
+    end
+    assert_equal Rooms::Open.pluck(:id).sort, bot.reload.room_ids.sort
+    assert_equal bot.reload.room_ids.sort, bot.bot_room_joins.pluck(:room_id).sort
+  end
+
+  test "enabling auto enrollment preserves existing memberships and their involvement" do
+    membership = @bot.memberships.create!(room: rooms(:hq), involvement: :nothing)
+    rooms(:watercooler).memberships.grant_to(@bot)
+
+    assert_enqueued_jobs Rooms::Open.count - 1, only: User::Bot::JoinedWebhookJob do
+      @bot.update! add_to_all_open_rooms: true
+    end
+    assert_equal "nothing", membership.reload.involvement
+    assert_equal (Rooms::Open.pluck(:id) + [ rooms(:watercooler).id ]).sort, @bot.reload.room_ids.sort
+  end
+
+  test "opted-in bots join future open rooms and rooms converted to open" do
+    @bot.update! add_to_all_open_rooms: true
+    selective_bot = users(:jz).bots.create!(name: "Selective")
+    rooms(:watercooler).memberships.grant_to(selective_bot)
+
+    assert_enqueued_jobs 2, only: User::Bot::JoinedWebhookJob do
+      room = Rooms::Open.create!(name: "New open room", creator: users(:david))
+      assert room.users.exists?(@bot.id)
+      assert_not room.users.exists?(selective_bot.id)
+
+      rooms(:watercooler).becomes!(Rooms::Open).save!
+      assert rooms(:watercooler).users.exists?(@bot.id)
+      assert rooms(:watercooler).users.exists?(selective_bot.id)
+    end
+    assert_not rooms(:designers).users.exists?(@bot.id)
+  end
+
+  test "turning enrollment off retains access but does not join future rooms" do
+    @bot.update! add_to_all_open_rooms: true
+    previous_room_ids = @bot.reload.room_ids.sort
+
+    assert_no_enqueued_jobs only: User::Bot::JoinedWebhookJob do
+      @bot.update! add_to_all_open_rooms: false
+      Rooms::Open.create!(name: "Later", creator: users(:david))
+      rooms(:designers).becomes!(Rooms::Open).save!
+    end
+    assert_equal previous_room_ids, @bot.reload.room_ids.sort
+
+    assert_enqueued_jobs 2, only: User::Bot::JoinedWebhookJob do
+      @bot.update! add_to_all_open_rooms: true
+    end
+    assert_equal Rooms::Open.pluck(:id).sort, @bot.reload.room_ids.sort
+  end
+
+  test "saving unrelated settings and re-enabling do not duplicate join events" do
+    @bot.update! add_to_all_open_rooms: true
+    assert_no_enqueued_jobs only: User::Bot::JoinedWebhookJob do
+      @bot.update! name: "Renamed", add_to_all_open_rooms: true
+      @bot.update! add_to_all_open_rooms: false
+      @bot.update! add_to_all_open_rooms: true
+      rooms(:hq).update! name: "Renamed room"
+    end
+  end
+
+  test "banned and deactivated bots do not automatically join new rooms" do
+    @bot.update! add_to_all_open_rooms: true, status: :banned
+    deactivated = users(:jz).bots.create!(name: "Inactive", add_to_all_open_rooms: true)
+    deactivated.deactivate
+    room = Rooms::Open.create!(name: "Later", creator: users(:david))
+    assert_not room.users.exists?(@bot.id)
+    assert_not room.users.exists?(deactivated.id)
+  end
+
+  test "invalid and rolled back settings do not grant memberships" do
+    assert_no_enqueued_jobs only: User::Bot::JoinedWebhookJob do
+      assert_not @bot.update(name: "", add_to_all_open_rooms: true)
+      @bot.reload
+      User.transaction(requires_new: true) do
+        @bot.update! add_to_all_open_rooms: true
+        raise ActiveRecord::Rollback
+      end
+    end
+    assert_empty @bot.reload.rooms
+  end
+end
diff --git a/test/models/user/bot_safety_concurrency_test.rb b/test/models/user/bot_safety_concurrency_test.rb
new file mode 100644
index 0000000..6747d84
--- /dev/null
+++ b/test/models/user/bot_safety_concurrency_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class User::BotSafetyConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  setup do
+    @bot = users(:jz).bots.create!(name: "Concurrent Bot")
+  end
+
+  teardown do
+    @bot.destroy!
+  end
+
+  test "concurrent workers cannot overshoot the message limit or lose cooldown attempts" do
+    room_id = rooms(:pets).id
+    freeze_time do
+      results = concurrently(workers: 4) do |bot|
+        room = Room.find(room_id)
+        4.times.map do
+          bot.post_bot_message(room.messages.new(creator: bot, body: "Hello"))
+        end
+      end.flatten
+
+      assert_equal({ created: 10, too_many_requests: 5, forbidden: 1 }, results.tally)
+      assert_equal 10, @bot.messages.count
+      assert @bot.reload.suspended?
+      assert_equal 5, @bot.bot_cooldown_attempts
+    end
+  end
+
+  test "concurrent webhook failures cannot lose increments" do
+    concurrently(workers: 5) do |bot|
+      2.times { bot.record_bot_webhook_delivery(success: false) }
+    end
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.bot_webhook_failures
+  end
+
+  private
+    def concurrently(workers:)
+      ready, start = Queue.new, Queue.new
+      threads = workers.times.map do
+        Thread.new do
+          Rails.application.executor.wrap do
+            ActiveRecord::Base.connection_pool.with_connection do
+              bot = User.find(@bot.id)
+              ready << true
+              start.pop
+              yield bot
+            end
+          end
+        end
+      end
+      workers.times { ready.pop }
+      workers.times { start << true }
+      threads.map(&:value)
+    end
+end
diff --git a/test/models/user/bot_safety_test.rb b/test/models/user/bot_safety_test.rb
new file mode 100644
index 0000000..7cf94ee
--- /dev/null
+++ b/test/models/user/bot_safety_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class User::BotSafetyTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Deploy Bot")
+    @room = rooms(:pets)
+    @room.memberships.grant_to(@bot)
+  end
+
+  test "invalid messages do not consume the rolling message allowance" do
+    freeze_time do
+      11.times do
+        assert_equal :unprocessable_entity, post_as(@bot, body: "")
+      end
+      10.times { assert_equal :created, post_as(@bot) }
+    end
+  end
+
+  test "separate instances share posting counters and other bots have independent limits" do
+    freeze_time do
+      stale_bot = User.find(@bot.id)
+      10.times { assert_equal :created, post_as(@bot) }
+      assert_equal :too_many_requests, post_as(stale_bot)
+      assert_equal :too_many_requests, post_as(@bot)
+      assert_equal 1, @bot.bot_cooldown_attempts
+      other = users(:jz).bots.create!(name: "Another bot")
+      assert_equal :created, post_as(other)
+    end
+  end
+
+  test "deleting messages does not restore the posting allowance" do
+    freeze_time do
+      10.times { post_as(@bot) }
+      @bot.messages.destroy_all
+      assert_equal :too_many_requests, post_as(@bot)
+    end
+  end
+
+  test "retry after rounds up partial seconds" do
+    freeze_time do
+      11.times { post_as(@bot) }
+      travel_to Time.current + 0.1.seconds, with_usec: true
+      assert_equal 30, @bot.bot_retry_after
+      travel_to Time.current + 29.seconds, with_usec: true
+      assert_equal :too_many_requests, post_as(@bot)
+      assert_equal 1, @bot.bot_retry_after
+    end
+  end
+
+  test "suspension preserves rooms messages code and ownership limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    assert_equal :created, post_as(@bot)
+    rooms, messages, code = @bot.room_ids, @bot.message_ids, @bot.bot_code
+    10.times { @bot.record_bot_webhook_delivery(success: false) }
+
+    assert @bot.reload.suspended?
+    assert_equal rooms, @bot.room_ids
+    assert_equal messages, @bot.message_ids
+    assert_equal code, @bot.bot_code
+    assert_not users(:jz).can_create_bot?
+    assert_not users(:jz).bots.new(name: "Replacement").valid?
+    assert_equal :forbidden, post_as(User.find(@bot.id))
+  end
+
+  test "a late successful delivery does not unsuspend a bot" do
+    10.times { @bot.record_bot_webhook_delivery(success: false) }
+    @bot.record_bot_webhook_delivery(success: true)
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.bot_webhook_failures
+    assert_equal User::Bot::Safety::WEBHOOK_FAILURE_REASON, @bot.bot_suspension_reason
+  end
+
+  test "reactivation clears all safety state and allows posting immediately" do
+    freeze_time do
+      16.times { post_as(@bot) }
+      @bot.update! bot_webhook_failures: 9
+      @bot.reactivate_bot
+      assert @bot.reload.active?
+      assert_nil @bot.bot_suspension_reason
+      assert_nil @bot.bot_cooldown_until
+      assert_empty @bot.bot_message_timestamps
+      assert_equal 0, @bot.bot_cooldown_attempts
+      assert_equal 0, @bot.bot_webhook_failures
+      10.times { assert_equal :created, post_as(@bot) }
+      @bot.record_bot_webhook_delivery(success: false)
+      assert @bot.reload.active?
+      assert_equal 1, @bot.bot_webhook_failures
+    end
+  end
+
+  test "reactivation cannot bypass an active cooldown or undelete a bot" do
+    freeze_time do
+      11.times { post_as(@bot) }
+      @bot.reactivate_bot
+      assert_equal :too_many_requests, post_as(@bot)
+      @bot.deactivate
+      @bot.reactivate_bot
+      assert @bot.reload.deactivated?
+    end
+  end
+
+  private
+    def post_as(bot, body: "Hello")
+      bot.post_bot_message(@room.messages.new(creator: bot, body: body))
+    end
+end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..31ca170
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Deploy Bot")
+  end
+
+  test "bots have unique unguessable codes but humans have no bot codes" do
+    other = users(:jz).bots.create!(name: "Deploy Bot")
+    assert_match(/\A[1-9A-HJ-NP-Za-km-z]{32}\z/, @bot.bot_code)
+    assert_not_equal @bot.bot_code, other.bot_code
+    assert_nil users(:jz).bot_code
+    assert_not @bot.authenticate(@bot.bot_code)
+  end
+
+  test "new bots have no memberships by default" do
+    assert_empty @bot.rooms
+  end
+
+  test "opted-in bots join newly created open rooms" do
+    @bot.update! add_to_all_open_rooms: true
+    room = Rooms::Open.create!(name: "Releases", creator: users(:jz))
+    assert_includes @bot.reload.rooms, room
+  end
+
+  test "bots require a name and creator" do
+    assert_not User.new(role: :bot, name: "Test").valid?
+    assert_not users(:jz).bots.new(name: " ").valid?
+  end
+
+  test "webhook URLs are optional and normalized without making network requests" do
+    [ nil, "", " \n\t" ].each do |url|
+      @bot.update! webhook_url: url
+      assert_nil @bot.reload.webhook_url
+    end
+    [ "https://bot.example.com/hook?key=secret", "http://bot.example.com:8080/hook" ].each do |url|
+      @bot.update! webhook_url: " #{url} "
+      assert_equal url, @bot.reload.webhook_url
+    end
+  end
+
+  test "webhooks must use absolute HTTP or HTTPS URLs without embedded credentials" do
+    [ "not a URL", "/hook", "https://", "file:///etc/passwd", "javascript:alert(1)", "https://user:password@example.com/hook" ].each do |url|
+      @bot.webhook_url = url
+      assert_not @bot.valid?, "#{url} should be invalid"
+      assert @bot.errors[:webhook_url].any?
+    end
+  end
+
+  test "bot codes have a unique database constraint" do
+    other = users(:jz).bots.create!(name: "Other")
+    assert_raises ActiveRecord::RecordNotUnique do
+      other.update_column(:bot_code, @bot.bot_code)
+    end
+  end
+
+  test "bots cannot use session transfers" do
+    assert_nil User.find_by_transfer_id(@bot.transfer_id)
+    assert_equal users(:jz), User.find_by_transfer_id(users(:jz).transfer_id)
+  end
+end
diff --git a/test/system/bot_limits_test.rb b/test/system/bot_limits_test.rb
