+    assert @bot.reload.active?
+    assert_equal 0, @bot.bot_webhook_failures
+    follow_redirect!
+    assert_select "[role=status]", text: /Suspended/, count: 0
+    assert_select "button", text: "Reactivate", count: 0
+  end
+
+  test "editing cannot clear suspension or change safety counters" do
+    sign_in :jz
+    patch bot_url(@bot), params: { bot: { name: "Renamed Bot", status: "active", bot_suspension_reason: "", bot_webhook_failures: 0 } }
+    assert_redirected_to bots_url
+    assert_equal "Renamed Bot", @bot.reload.name
+    assert @bot.suspended?
+    assert_equal 10, @bot.bot_webhook_failures
+    assert_equal User::Bot::Safety::WEBHOOK_FAILURE_REASON, @bot.bot_suspension_reason
+  end
+
+  test "signed out requests cannot reactivate" do
+    post bot_reactivation_url(@bot)
+    assert_redirected_to new_session_url
+    assert @bot.reload.suspended?
+  end
+
+  test "reactivation is restricted to bots" do
+    sign_in :david
+    assert_raises ActiveRecord::RecordNotFound do
+      post bot_reactivation_url(users(:jz))
+    end
+  end
+end
diff --git a/test/controllers/bots/safety_test.rb b/test/controllers/bots/safety_test.rb
new file mode 100644
index 0000000..6cb7624
--- /dev/null
+++ b/test/controllers/bots/safety_test.rb
@@ -0,0 +1,143 @@
+require "test_helper"
+
+class Bots::SafetyTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = users(:jz).bots.create!(name: "Flood Bot", webhook_url: "https://bot.example.com/events")
+    @room = rooms(:pets)
+    @room.memberships.grant_to(@bot)
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "eleventh message is rejected with a thirty second cooldown" do
+    freeze_time do
+      10.times { post_message; assert_response :created }
+      assert_no_difference -> { Message.count } do
+        post_message
+        assert_response :too_many_requests
+        assert_equal "30", response.headers["Retry-After"]
+      end
+    end
+  end
+
+  test "ten consecutive failing webhooks suspend the bot and forbid posting" do
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 503)
+    10.times { User::Bot::Webhook.new(bot: @bot, room: @room).deliver }
+    post_message
+    assert_response :forbidden
+    User::Bot::Webhook.new(bot: @bot, room: @room).deliver
+    assert_requested request, times: 10
+  end
+
+  test "cooldown counts five additional attempts without extending its deadline" do
+    freeze_time do
+      11.times { post_message }
+      assert_equal 0, @bot.reload.bot_cooldown_attempts
+      deadline = @bot.bot_cooldown_until
+
+      4.times do |index|
+        travel 1.second
+        assert_no_difference -> { Message.count } do
+          assert_no_enqueued_jobs only: Room::PushMessageJob do
+            post_message
+          end
+        end
+        assert_response :too_many_requests
+        assert_equal (29 - index).to_s, response.headers["Retry-After"]
+        assert_equal deadline, @bot.reload.bot_cooldown_until
+        assert @bot.active?
+      end
+
+      post_message
+      assert_response :forbidden
+      assert_nil response.headers["Retry-After"]
+      assert @bot.reload.suspended?
+      assert_equal User::Bot::Safety::FLOODING_REASON, @bot.bot_suspension_reason
+
+      travel 1.day
+      post_message
+      assert_response :forbidden
+    end
+  end
+
+  test "expired cooldowns allow posting and start a fresh attempt count" do
+    freeze_time do
+      15.times { post_message }
+      assert_response :too_many_requests
+      travel 30.seconds
+      10.times { post_message; assert_response :created }
+      post_message
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+      post_message
+      assert_response :too_many_requests
+      assert_equal 1, @bot.reload.bot_cooldown_attempts
+    end
+  end
+
+  test "the ten second window rolls rather than resetting on clock boundaries" do
+    freeze_time do
+      5.times { post_message; assert_response :created }
+      travel 9.seconds
+      5.times { post_message; assert_response :created }
+      travel 1.second
+      5.times { post_message; assert_response :created }
+      post_message
+      assert_response :too_many_requests
+    end
+  end
+
+  test "API messages and both webhook reply types share a limit across rooms" do
+    freeze_time do
+      other_room = rooms(:hq)
+      other_room.memberships.grant_to(@bot)
+      message = other_room.messages.create!(creator: users(:david), body: mention_attachment_for(@bot))
+      stub_request(:post, @bot.webhook_url).to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Reply")
+
+      8.times { post_message; assert_response :created }
+      assert_difference -> { @bot.messages.count }, 2 do
+        User::Bot::JoinedWebhookJob.perform_now(@bot.bot_room_joins.find_by!(room: other_room))
+        User::Bot::WebhookJob.perform_now(@bot, message)
+      end
+      assert_no_difference -> { @bot.messages.count } do
+        User::Bot::WebhookJob.perform_now(@bot, message)
+        assert @bot.reload.bot_cooldown_until.future?
+        post_message
+        assert_response :too_many_requests
+        4.times { User::Bot::WebhookJob.perform_now(@bot, message) }
+      end
+      assert @bot.reload.suspended?
+      assert_equal User::Bot::Safety::FLOODING_REASON, @bot.bot_suspension_reason
+    end
+  end
+
+  test "rejected webhook replies do not broadcast or push notifications" do
+    freeze_time do
+      11.times { post_message }
+      stub_request(:post, @bot.webhook_url).to_return(status: 200, headers: { "Content-Type" => "text/html" }, body: "<b>Reply</b>")
+      assert_no_difference -> { Message.count } do
+        assert_no_enqueued_jobs only: Room::PushMessageJob do
+          assert_turbo_stream_broadcasts [ @room, :messages ], count: 0 do
+            User::Bot::Webhook.new(bot: @bot, room: @room).deliver
+          end
+        end
+      end
+      assert_equal 1, @bot.reload.bot_cooldown_attempts
+    end
+  end
+
+  test "invalid bodies still receive cooldown responses" do
+    freeze_time do
+      11.times { post_message }
+      [ "", "\xFF".b ].each do |body|
+        post room_bot_messages_path(@room, @bot.bot_code), params: body, headers: { "Content-Type" => "text/plain" }
+        assert_response :too_many_requests
+        assert_equal "30", response.headers["Retry-After"]
+      end
+    end
+  end
+
+  private
+    def post_message
+      post room_bot_messages_path(@room, @bot.bot_code), params: "Hello".dup, headers: { "Content-Type" => "text/plain" }
+    end
+end
diff --git a/test/controllers/bots/webhooks_test.rb b/test/controllers/bots/webhooks_test.rb
