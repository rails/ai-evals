@@ -0,0 +1,39 @@
+require "application_system_test_case"
+
+class BotSafetyTest < ApplicationSystemTestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Broken Bot")
+    10.times { @bot.record_bot_webhook_delivery(success: false) }
+  end
+
+  test "administrators confirm reactivation with the native browser dialog" do
+    sign_in users(:david).email_address
+    visit bots_url
+    assert_text "Broken Bot"
+    assert_text "Suspended"
+    assert_text @bot.bot_suspension_reason
+
+    dismiss_confirm { click_on "Reactivate" }
+    assert_button "Reactivate"
+    assert @bot.reload.suspended?
+
+    accept_confirm { click_on "Reactivate" }
+    assert_current_path bots_path
+    assert_no_text "Suspended"
+    assert_no_button "Reactivate"
+    assert_text "Broken Bot"
+    assert @bot.reload.active?
+  end
+
+  test "owners see the suspension reason and still use a bot slot" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in users(:jz).email_address
+    visit bots_url
+    assert_text "Broken Bot"
+    assert_text "Suspended"
+    assert_text @bot.bot_suspension_reason
+    assert_no_button "Reactivate"
+    assert_no_link "Add a chat bot"
+    assert_text "reached the limit"
+  end
+end
diff --git a/test/system/bots_test.rb b/test/system/bots_test.rb
new file mode 100644
index 0000000..9c83528
--- /dev/null
+++ b/test/system/bots_test.rb
@@ -0,0 +1,85 @@
+require "application_system_test_case"
+
+class BotsTest < ApplicationSystemTestCase
+  test "a member creates edits and deletes a bot with native confirmation" do
+    sign_in users(:jz).email_address
+    visit edit_account_url
+    click_on "Set up chat bots"
+    assert_current_path bots_path
+    click_on "Add a chat bot"
+    assert_current_path new_bot_path
+    assert_unchecked_field "Add to all open rooms"
+    fill_in "Name the bot", with: "Deploy Bot"
+    fill_in "Webhook URL", with: "https://bot.example.com/mentions"
+    attach_file "Bot avatar (optional)", file_fixture("moon.jpg"), make_visible: true
+    click_on "Save changes"
+    assert_current_path bots_path
+
+    within "li", text: "Deploy Bot" do
+      assert_field "Bot code", readonly: true, with: User.bot.last.bot_code
+      click_on "Edit Deploy Bot"
+    end
+    assert_unchecked_field "Add to all open rooms"
+    assert_empty User.bot.last.rooms
+    check "Add to all open rooms"
+    assert_field "Webhook URL", with: "https://bot.example.com/mentions"
+    fill_in "Webhook URL", with: ""
+    fill_in "Name the bot", with: "Release Bot"
+    click_on "Save changes"
+    assert_current_path bots_path
+    click_on "Edit Release Bot"
+    assert_checked_field "Add to all open rooms"
+    assert_equal Rooms::Open.pluck(:id).sort, User.bot.last.room_ids.sort
+    assert_field "Webhook URL", with: ""
+    assert_nil User.bot.last.webhook_url
+
+    dismiss_confirm do
+      click_on "Delete this chat bot"
+    end
+    assert_current_path edit_bot_path(User.bot.last)
+    accept_confirm do
+      click_on "Delete this chat bot"
+    end
+    assert_current_path bots_path
+    assert_no_text "Release Bot"
+    assert User.bot.last.deactivated?
+  end
+
+  test "enrollment can be enabled on creation and turned off without removing rooms" do
+    sign_in users(:jz).email_address
+    visit new_bot_url
+    assert_unchecked_field "Add to all open rooms"
+    fill_in "Name the bot", with: "Everyone Bot"
+    check "Add to all open rooms"
+    click_on "Save changes"
+    assert_current_path bots_path
+    bot = User.bot.last
+    room_ids = Rooms::Open.pluck(:id).sort
+    assert_equal room_ids, bot.room_ids.sort
+
+    click_on "Edit Everyone Bot"
+    assert_checked_field "Add to all open rooms"
+    uncheck "Add to all open rooms"
+    click_on "Save changes"
+    assert_current_path bots_path
+    click_on "Edit Everyone Bot"
+    assert_unchecked_field "Add to all open rooms"
+    assert_not bot.reload.add_to_all_open_rooms?
+    assert_equal room_ids, bot.room_ids.sort
+  end
+
+  test "room administrators can choose individual bots for an open room" do
+    bot = users(:jz).bots.create!(name: "Selective Bot")
+    sign_in users(:david).email_address
+    visit edit_rooms_open_url(rooms(:hq))
+    assert_unchecked_field "Give Selective Bot access to this room"
+    check "Give Selective Bot access to this room"
+    click_on "Save"
+    assert_current_path room_path(rooms(:hq))
+    assert rooms(:hq).users.exists?(bot.id)
+    assert_not rooms(:pets).users.exists?(bot.id)
+
+    visit edit_rooms_open_url(rooms(:hq))
+    assert_checked_field "Give Selective Bot access to this room"
+  end
+end
