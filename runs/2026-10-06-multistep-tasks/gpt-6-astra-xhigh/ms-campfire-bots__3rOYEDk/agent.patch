@@ -0,0 +1,13 @@
+class User::Bot::JoinedWebhookJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(join)
+    bot, room = join.bot, join.room
+
+    if bot.bot? && bot.active? && bot.webhook_url.present? && !room.direct? && room.users.exists?(bot.id)
+      if join.claim_webhook_delivery
+        User::Bot::Webhook.new(bot: bot, room: room).deliver
+      end
+    end
+  end
+end
