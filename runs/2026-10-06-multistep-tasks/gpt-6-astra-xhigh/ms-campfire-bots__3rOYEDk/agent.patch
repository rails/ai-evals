new file mode 100644
index 0000000..13f08e0
--- /dev/null
+++ b/app/models/user/bot/webhook.rb
@@ -0,0 +1,96 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class User::Bot::Webhook
+  include Rails.application.routes.url_helpers
+
+  MAX_RESPONSE_SIZE = 1.megabyte
+  TIMEOUT = 5
+
+  attr_reader :bot, :message, :room
+
+  def initialize(bot:, message: nil, room: message&.room)
+    @bot, @message, @room = bot, message, room
+  end
+
+  def deliver
+    return unless bot.reload.bot? && bot.active? && bot.webhook_url.present?
+
+    url = URI.parse(bot.webhook_url)
+    ip = RestrictedHTTP::PrivateNetworkGuard.resolve(url.hostname)
+
+    # Pin the resolved public IP and bypass environment proxies. Never redirect a
+    # payload containing the bot's posting credential to another destination.
+    Net::HTTP.start(url.hostname, url.port, nil, ipaddr: ip, use_ssl: url.scheme == "https",
+      open_timeout: TIMEOUT, read_timeout: TIMEOUT, write_timeout: TIMEOUT, max_retries: 0) do |http|
+      request = Net::HTTP::Post.new(url, "Content-Type" => "application/json")
+      request.body = payload.to_json
+
+      http.request(request) do |response|
+        body = reply_body(response)
+        bot.record_bot_webhook_delivery(success: response.is_a?(Net::HTTPSuccess))
+
+        if body
+          reply = room.messages.new(creator: bot, body: body)
+          reply.broadcast_create if bot.post_bot_message(reply) == :created
+        end
+        # Exit the request block without letting Net::HTTP drain rejected or
+        # oversized response bodies. The session's ensure closes the connection.
+        return
+      end
+    end
+  rescue RestrictedHTTP::Violation, Surfguard::Unresolvable, Resolv::ResolvError,
+      Timeout::Error, SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::ProtocolError, Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError => error
+    # URLs and exception messages may contain secrets. Don't log either, and don't
+    # retry: the bot may already have processed the command before a timeout.
+    bot.record_bot_webhook_delivery(success: false)
+    Rails.logger.warn "Bot webhook failed (bot_id=#{bot.id}, room_id=#{room.id}, message_id=#{message&.id}, #{error.class})"
+  end
+
+  private
+    def payload
+      if message
+        {
+          event: "mention",
+          author: { id: message.creator.id, name: message.creator.name },
+          room: room_payload,
+          message: {
+            id: message.id,
+            body: { text: command_text, html: message.body.to_s },
+            link: room_at_message_path(room, message.id)
+          }
+        }
+      else
+        { event: "joined", room: room_payload }
+      end
+    end
+
+    def room_payload
+      { id: room.id, name: room.name, reply_to: room_bot_messages_path(room, bot.bot_code) }
+    end
+
+    def command_text
+      message.body.body.render_attachments do |attachment|
+        attachment.attachable == bot ? "" : attachment.to_html
+      end.to_plain_text.gsub(/\A[[:space:]]+|[[:space:]]+\z/, "")
+    end
+
+    def reply_body(response)
+      return unless response.is_a?(Net::HTTPOK) && response.content_type.in?(%w[ text/plain text/html ])
+      return if response.content_length.to_i > MAX_RESPONSE_SIZE
+
+      body = +""
+      response.read_body do |chunk|
+        return if body.bytesize + chunk.bytesize > MAX_RESPONSE_SIZE
+        body << chunk
+      end
+      body.force_encoding(Encoding::UTF_8)
+      return unless body.valid_encoding? && body.present?
+
+      if response.content_type == "text/plain"
+        ERB::Util.html_escape(body).gsub(/\r\n?|\n/, "<br>")
+      else
+        body
+      end
+    end
+end
