+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = users(:jz).bots.create!(name: "Deploy Bot")
+    @room = rooms(:pets)
+    @room.memberships.grant_to(@bot)
+  end
+
+  test "raw curl body creates a message as the bot, broadcasts, and queues push" do
+    body = "Deploy of v1.2.3 finished ✅"
+    assert_difference -> { Message.count }, 1 do
+      assert_enqueued_jobs 1, only: Room::PushMessageJob do
+        post endpoint, params: body.dup, headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+      end
+    end
+    assert_response :created
+    message = Message.last
+    assert_equal message_path(message), response.headers["Location"]
+    assert_equal body, message.plain_text_body
+    assert_equal @bot, message.creator
+    assert_equal @room, message.room
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__body", text: /Deploy of v1.2.3 finished ✅/
+      assert_select ".message__body", text: /Deploy Bot/
+    end
+  end
+
+  test "push delivery uses the bot name and the normal room payload" do
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    payload = { title: @room.name, body: "Deploy Bot: Shipped!", path: room_path(@room) }
+    Rails.configuration.x.web_push_pool.expects(:queue).with(payload, anything).twice
+
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      post endpoint, params: "Shipped!"
+      assert_response :created
+    end
+  end
+
+  test "invalid UTF-8 is rejected" do
+    assert_no_difference -> { Message.count } do
+      post endpoint, params: "\xFF".b, headers: { "Content-Type" => "text/plain" }
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "raw text is never decoded as form fields, parsed as JSON, or interpreted as HTML" do
+    body = "<script>alert('oops')</script>\nstatus=done&build[]=1&build[x]=2 + 100% ✅"
+    [ "text/plain", "application/x-www-form-urlencoded", "application/json" ].each do |content_type|
+      post endpoint, params: body.dup, headers: { "Content-Type" => content_type }
+      assert_response :created
+      assert_equal body, Message.last.plain_text_body
+      assert_not_includes Message.last.body.to_s, "<script>"
+    end
+  end
+
+  test "empty and whitespace bodies are rejected without broadcasts or jobs" do
+    [ "", " \n\t" ].each do |body|
+      assert_no_difference -> { Message.count } do
+        assert_no_enqueued_jobs only: Room::PushMessageJob do
+          assert_turbo_stream_broadcasts [ @room, :messages ], count: 0 do
+            post endpoint, params: body
+            assert_response :unprocessable_entity
+          end
+        end
+      end
+    end
+  end
+
+  test "invalid codes do not fall back to browser authentication" do
+    sign_in :david
+    assert_no_difference -> { Message.count } do
+      post endpoint(code: "invalid"), params: "Hello"
+      assert_response :unauthorized
+    end
+  end
+
+  test "bad room ids and non-member rooms are not found" do
+    [ 0, rooms(:designers).id ].each do |room_id|
+      post endpoint(room_id: room_id), params: "Hello"
+      assert_response :not_found
+    end
+  end
+
+  test "bots can be added to closed rooms like people" do
+    @room = rooms(:designers)
+    sign_in :david
+    put rooms_closed_url(@room), params: { room: { name: @room.name }, user_ids: @room.user_ids + [ @bot.id ] }
+    assert_redirected_to room_url(@room)
+    post endpoint, params: "Hello from a private room"
+    assert_response :created
+    assert_equal @bot, Message.last.creator
+  end
+
+  test "deactivated and banned bots cannot post" do
+    @bot.banned!
+    post endpoint, params: "Hello"
+    assert_response :unauthorized
+    @bot.active!
+    code = @bot.bot_code
+    sign_in :jz
+    delete bot_url(@bot)
+    post endpoint(code: code), params: "Hello"
+    assert_response :unauthorized
+  end
+
+  test "API does not require a CSRF token" do
+    with_forgery_protection do
+      post endpoint, params: "Hello"
+      assert_response :created
+    end
+  end
+
+  test "codes are filtered from request parameters and URL paths" do
+    request = ActionDispatch::TestRequest.create
+    request.path_info = "/rooms/#{@room.id}/#{@bot.bot_code}/messages"
+    request.path_parameters = { room_id: @room.id, bot_code: @bot.bot_code }
+    request.set_header "action_dispatch.parameter_filter", Rails.application.config.filter_parameters
+    assert_not_includes request.filtered_path, @bot.bot_code
+    assert_equal "[FILTERED]", request.filtered_parameters["bot_code"]
+  end
+
+  private
+    def endpoint(code: @bot.bot_code, room_id: @room.id)
+      "/rooms/#{room_id}/#{code}/messages"
+    end
+
+    def with_forgery_protection
+      previous = ActionController::Base.allow_forgery_protection
+      ActionController::Base.allow_forgery_protection = true
+      yield
+    ensure
+      ActionController::Base.allow_forgery_protection = previous
+    end
+end
diff --git a/test/controllers/bots/reactivations_controller_test.rb b/test/controllers/bots/reactivations_controller_test.rb
