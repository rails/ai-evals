@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Bots::JoinsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+    @bot = users(:jz).bots.create!(name: "Greeter", webhook_url: "https://bot.example.com/events")
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "a person adds a bot to a room and receives one asynchronous greeting" do
+    room = rooms(:watercooler)
+    payload = nil
+    request = stub_request(:post, @bot.webhook_url).with do |request|
+      payload = JSON.parse(request.body)
+    end.to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Hello, room!")
+
+    assert_enqueued_jobs 1, only: User::Bot::JoinedWebhookJob do
+      2.times do
+        put rooms_closed_url(room), params: { room: { name: room.name }, user_ids: room.user_ids + [ @bot.id ] }
+        assert_redirected_to room_url(room)
+      end
+    end
+    assert_not_requested request
+    assert_difference -> { Message.count }, 1 do
+      perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+    end
+    assert_requested request, times: 1
+    assert_equal "joined", payload["event"]
+    assert_equal @bot, Message.last.creator
+    assert_equal room, Message.last.room
+    assert_equal "Hello, room!", Message.last.plain_text_body
+
+    post payload["room"]["reply_to"], params: "More about me", headers: { "Content-Type" => "text/plain" }
+    assert_response :created
+    assert_equal @bot, Message.last.creator
+    assert_equal room, Message.last.room
+  end
+
+  test "opting in and then creating an open room notifies once for every room" do
+    received_room_ids = []
+    request = stub_request(:post, @bot.webhook_url).with do |request|
+      received_room_ids << JSON.parse(request.body).fetch("room").fetch("id")
+    end.to_return(status: 204)
+
+    patch bot_url(@bot), params: { bot: { add_to_all_open_rooms: "1" } }
+    assert_redirected_to bots_url
+    post rooms_opens_url, params: { room: { name: "New open room" } }
+    assert_redirected_to room_url(Room.last)
+    perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+    assert_equal Rooms::Open.pluck(:id).sort, received_room_ids.sort
+    assert_requested request, times: Rooms::Open.count
+  end
+end
