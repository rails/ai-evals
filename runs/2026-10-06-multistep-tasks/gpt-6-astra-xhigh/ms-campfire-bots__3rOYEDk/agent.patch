diff --git a/test/jobs/user/bot/joined_webhook_job_test.rb b/test/jobs/user/bot/joined_webhook_job_test.rb
new file mode 100644
index 0000000..7999696
--- /dev/null
+++ b/test/jobs/user/bot/joined_webhook_job_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class User::Bot::JoinedWebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Greeter", webhook_url: "https://bot.example.com/events")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    @join = @bot.bot_room_joins.find_by!(room: @room)
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "posts only the joined event and room with the bot's posting URL" do
+    request = stub_request(:post, @bot.webhook_url).with do |request|
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal({
+        "event" => "joined",
+        "room" => { "id" => @room.id, "name" => @room.name, "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages" }
+      }, JSON.parse(request.body))
+      true
+    end.to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+      User::Bot::JoinedWebhookJob.perform_now(@join)
+    end
+    assert_requested request, times: 1
+    assert_not_nil @join.reload.webhook_attempted_at
+  end
+
+  test "plain text greetings are escaped and broadcast as bot messages with push notifications" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "Hello <everyone>!\nI'm here ✅")
+
+    assert_difference -> { Message.count }, 1 do
+      assert_enqueued_jobs 1, only: Room::PushMessageJob do
+        assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+          assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+            perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+          end
+        end
+      end
+    end
+    reply = Message.last
+    assert_equal @bot, reply.creator
+    assert_equal @room, reply.room
+    assert_equal "Hello <everyone>!\nI'm here ✅", reply.plain_text_body
+    assert_includes reply.body.to_s, "&lt;everyone&gt;"
+  end
+
+  test "HTML greetings are formatted and sanitized without triggering mention callbacks" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/html" }, body: "<div><strong>Hello!</strong><script>alert(1)</script>#{mention_attachment_for(@bot)}</div>")
+    assert_difference -> { Message.count }, 1 do
+      assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+        perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+      end
+    end
+    assert_includes Message.last.body.to_s, "<strong>Hello!</strong>"
+    assert_not_includes Message.last.body.to_s, "<script>"
+  end
+
+  test "no greeting for an unsupported response" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "application/json" }, body: '{"hello":true}')
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+    end
+  end
+
+  test "webhook removal cancels queued delivery" do
+    @bot.update! webhook_url: nil
+    assert_skipped_delivery
+  end
+
+  test "banning cancels queued delivery" do
+    @bot.banned!
+    assert_skipped_delivery
+  end
+
+  test "deactivation cancels queued delivery" do
+    @bot.deactivate
+    assert_skipped_delivery
+  end
+
+  test "revoking membership cancels queued delivery" do
+    @room.memberships.revoke_from(@bot)
+    assert_skipped_delivery
+  end
+
+  test "deleted rooms and bots discard their queued join events" do
+    @room.destroy!
+    @bot.destroy!
+    assert_skipped_delivery
+  end
+
+  test "failed requests are not retried even if a duplicate job runs" do
+    request = stub_request(:post, @bot.webhook_url).to_raise(Net::ReadTimeout)
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+      User::Bot::JoinedWebhookJob.perform_now(@join)
+    end
+    assert_requested request, times: 1
+  end
+
+  test "private destinations are blocked for join events too" do
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "127.0.0.1" ])
+    assert_skipped_delivery
+  end
+
+  private
+    def assert_skipped_delivery
+      assert_no_difference -> { Message.count } do
+        perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+      end
+      assert_not_requested :post, "https://bot.example.com/events"
+    end
+end
diff --git a/test/jobs/user/bot/safety_test.rb b/test/jobs/user/bot/safety_test.rb
new file mode 100644
index 0000000..3e04b87
--- /dev/null
+++ b/test/jobs/user/bot/safety_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class User::Bot::SafetyTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Broken Bot", webhook_url: "https://bot.example.com/events")
+    @room = rooms(:pets)
+    @room.memberships.grant_to(@bot)
+    @message = @room.messages.create!(creator: users(:david), body: mention_attachment_for(@bot))
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "all non-2xx statuses count as failures and the tenth suspends" do
+    [ 301, 302, 400, 401, 403, 404, 422, 429, 500, 503 ].each_with_index do |status, index|
+      stub_request(:post, @bot.webhook_url).to_return(status: status)
+      deliver
+      assert_equal index + 1, @bot.reload.bot_webhook_failures
+      assert_equal index == 9, @bot.suspended?
+    end
+    assert_equal User::Bot::Safety::WEBHOOK_FAILURE_REASON, @bot.bot_suspension_reason
+  end
+
+  test "every 2xx resets failures even when there is no usable reply" do
+    [ 200, 201, 202, 204, 206, 299 ].each do |status|
+      @bot.update! bot_webhook_failures: 9
+      stub_request(:post, @bot.webhook_url).to_return(status: status, headers: { "Content-Type" => "application/json" }, body: "{}")
+      assert_no_difference -> { Message.count } do
+        deliver
+      end
+      assert_equal 0, @bot.reload.bot_webhook_failures
+      assert @bot.active?
+    end
+  end
+
+  test "failures must be consecutive" do
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 500).times(9).then.to_return(status: 204).then.to_return(status: 500).times(10)
+    19.times { deliver }
+    assert @bot.reload.active?
+    assert_equal 9, @bot.bot_webhook_failures
+    deliver
+    assert @bot.reload.suspended?
+    assert_requested request, times: 20
+  end
+
+  test "timeouts and connection errors count towards suspension without retries" do
+    [ Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNREFUSED, SocketError, OpenSSL::SSL::SSLError ].cycle.take(10).each_with_index do |error, index|
+      stub_request(:post, @bot.webhook_url).to_raise(error)
+      deliver
+      assert_equal index + 1, @bot.reload.bot_webhook_failures
+    end
+    assert @bot.suspended?
+    assert_requested :post, @bot.webhook_url, times: 10
+  end
+
+  test "a timeout reading a 200 reply is a single failure not a success" do
+    @bot.update! bot_webhook_failures: 9
+    response = Net::HTTPOK.new("1.1", "200", "OK")
+    response["Content-Type"] = "text/plain"
+    response.stubs(:read_body).raises(Net::ReadTimeout)
+    http = mock
+    http.expects(:request).yields(response)
+    Net::HTTP.stubs(:start).yields(http)
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.bot_webhook_failures
+  end
+
+  test "joined and mention deliveries share a failure counter" do
+    @bot.update! bot_webhook_failures: 8
+    stub_request(:post, @bot.webhook_url).to_return(status: 500)
+    perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+    assert_equal 9, @bot.reload.bot_webhook_failures
+    deliver
+    assert @bot.reload.suspended?
+  end
+
+  test "suspended bots receive neither queued nor newly queued webhooks" do
+    10.times { @bot.record_bot_webhook_delivery(success: false) }
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: [ User::Bot::JoinedWebhookJob, User::Bot::WebhookJob ]
+      User::Bot::Webhook.new(bot: @bot, room: @room).deliver
+    end
+    assert_no_enqueued_jobs only: [ User::Bot::JoinedWebhookJob, User::Bot::WebhookJob ] do
+      @room.messages.create!(creator: users(:david), body: mention_attachment_for(@bot))
+      rooms(:hq).memberships.grant_to(@bot)
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "an in-flight successful response cannot post after suspension" do
+    stub_request(:post, @bot.webhook_url).to_return do
+      other_instance = User.find(@bot.id)
+      10.times { other_instance.record_bot_webhook_delivery(success: false) }
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "Too late" }
+    end
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.bot_webhook_failures
+  end
+
+  test "reactivated bots receive webhooks again" do
+    10.times { @bot.record_bot_webhook_delivery(success: false) }
+    @bot.reactivate_bot
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 204)
+    deliver
+    assert_requested request
+    assert_equal 0, @bot.reload.bot_webhook_failures
+  end
+
+  private
+    def deliver
+      User::Bot::WebhookJob.perform_now(@bot, @message)
+    end
+end
diff --git a/test/jobs/user/bot/webhook_job_test.rb b/test/jobs/user/bot/webhook_job_test.rb
new file mode 100644
index 0000000..1a1a3db
--- /dev/null
+++ b/test/jobs/user/bot/webhook_job_test.rb
@@ -0,0 +1,203 @@
+require "test_helper"
+
+class User::Bot::WebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Deploy Bot", webhook_url: "https://bot.example.com/mentions")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    @message = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(@bot)} restart the <strong>build</strong> please</div>")
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "posts the mention payload with the bot's own posting URL and numeric message deep link" do
+    request = stub_request(:post, @bot.webhook_url).with do |request|
+      payload = JSON.parse(request.body)
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal "mention", payload["event"]
+      assert_equal({ "id" => users(:david).id, "name" => "David" }, payload["author"])
+      assert_equal({ "id" => @room.id, "name" => @room.name, "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages" }, payload["room"])
+      assert_equal @message.id, payload["message"]["id"]
+      assert_equal "restart the build please", payload["message"]["body"]["text"]
+      assert_equal @message.body.to_s, payload["message"]["body"]["html"]
+      assert_equal "/rooms/#{@room.id}/@#{@message.id}", payload["message"]["link"]
+      true
+    end.to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert_requested request, times: 1
+  end
+
+  test "removes all own mention attachments but preserves other mentions, literal names and newlines" do
+    other = users(:jz).bots.create!(name: @bot.name)
+    @message.update! body: "<div>#{mention_attachment_for(@bot)} restart<br>#{mention_attachment_for(:david)} #{mention_attachment_for(other)} @Deploy Bot #{mention_attachment_for(@bot)}</div>"
+    original_html = @message.body.to_s
+    request = stub_request(:post, @bot.webhook_url).with do |request|
+      body = JSON.parse(request.body)["message"]["body"]
+      body["text"] == "restart\n@David @Deploy Bot @Deploy Bot" && body["html"] == original_html
+    end.to_return(status: 204)
+
+    deliver
+    assert_requested request
+    assert_equal original_html, @message.reload.body.to_s
+  end
+
+  test "trims the non-breaking spaces used by rich text mentions" do
+    @message.update! body: "<div>#{mention_attachment_for(@bot)}&nbsp;restart&nbsp;</div>"
+    request = stub_request(:post, @bot.webhook_url).with do |request|
+      JSON.parse(request.body)["message"]["body"]["text"] == "restart"
+    end.to_return(status: 204)
+
+    deliver
+    assert_requested request
+  end
+
+  test "plain text replies escape HTML and preserve line breaks, broadcast, and enqueue push" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "<strong>Done & dusted</strong>\nNext line ✅")
+
+    assert_difference -> { Message.count }, 1 do
+      assert_enqueued_jobs 1, only: Room::PushMessageJob do
+        assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+          assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+            deliver
+          end
+        end
+      end
+    end
+
+    reply = Message.last
+    assert_equal @bot, reply.creator
+    assert_equal @room, reply.room
+    assert_equal "<strong>Done & dusted</strong>\nNext line ✅", reply.plain_text_body
+    assert_not_includes reply.body.to_s, "<strong>"
+  end
+
+  test "HTML replies retain formatting and use Action Text sanitization" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/html; charset=UTF-8" }, body: '<div><strong>Done!</strong><script>alert(1)</script><img src="x" onerror="alert(1)"></div>')
+
+    assert_difference -> { Message.count }, 1 do
+      deliver
+    end
+    assert_includes Message.last.body.to_s, "<strong>Done!</strong>"
+    assert_not_includes Message.last.body.to_s, "<script>"
+    assert_not_includes Message.last.body.to_s, "onerror"
+  end
+
+  test "no replies for empty bodies, unsupported types, non-200 statuses, or invalid UTF-8" do
+    [
+      [ 204, "text/plain", "ignored" ],
+      [ 201, "text/plain", "ignored" ],
+      [ 500, "text/html", "error" ],
+      [ 200, "application/json", '{"message":"ignored"}' ],
+      [ 200, nil, "ignored" ],
+      [ 200, "text/plain", " \n\t" ],
+      [ 200, "text/html", "<div><br></div>" ],
+      [ 200, "text/plain", "\xFF".b ]
+    ].each do |status, type, body|
+      stub_request(:post, @bot.webhook_url).to_return(status: status, headers: { "Content-Type" => type }, body: body)
+      assert_no_difference -> { Message.count } do
+        deliver
+      end
+    end
+  end
+
+  test "timeouts and connection failures do not create messages or retry" do
+    [ Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNREFUSED, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError ].each do |error|
+      request = stub_request(:post, @bot.webhook_url).to_raise(error)
+      assert_no_difference -> { Message.count } do
+        assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+          deliver
+        end
+      end
+      remove_request_stub(request)
+    end
+  end
+
+  test "does not follow redirects carrying bot credentials" do
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 302, headers: { "Location" => "http://127.0.0.1/private" })
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert_requested request, times: 1
+    assert_not_requested :any, "http://127.0.0.1/private"
+  end
+
+  test "rejects private destinations at delivery time" do
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "127.0.0.1" ])
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "pins the public IP instead of resolving the hostname again when connecting" do
+    WebMock.disable_net_connect! allow: [ "bot.example.com" ]
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ], [ "127.0.0.1" ])
+    TCPSocket.expects(:open).with { |*args, **| args.first == "bot.example.com" }.never
+    TCPSocket.expects(:open).with { |*args, **| args.first == "93.184.216.34" && args[1] == 443 }.throws(:public_ip_pinned)
+
+    assert_throws :public_ip_pinned do
+      deliver
+    end
+  end
+
+  test "unresolvable webhook hosts are ignored" do
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([])
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "HTML replies mentioning bots do not enqueue more callbacks" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/html" }, body: "#{mention_attachment_for(@bot)} Done!")
+    assert_difference -> { Message.count }, 1 do
+      assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+        deliver
+      end
+    end
+    assert_equal @bot, Message.last.creator
+  end
+
+  test "limits response size regardless of Content-Length" do
+    [ nil, 10, 2.megabytes ].each do |length|
+      stub_request(:post, @bot.webhook_url).to_return(status: 200,
+        headers: { "Content-Type" => "text/plain", "Content-Length" => length }.compact, body: "x" * (User::Bot::Webhook::MAX_RESPONSE_SIZE + 1))
+      assert_no_difference -> { Message.count } do
+        deliver
+      end
+    end
+  end
+
+  test "skips callbacks if webhook is removed or bot loses access before execution" do
+    @bot.update! webhook_url: nil
+    deliver
+    @bot.update! webhook_url: "https://bot.example.com/mentions", status: :banned
+    deliver
+    @bot.active!
+    @room.memberships.revoke_from(@bot)
+    deliver
+    @room.memberships.grant_to(@bot)
+    @bot.deactivate
+    deliver
+
+    assert_not_requested :post, "https://bot.example.com/mentions"
+  end
+
+  test "discards jobs for deleted messages" do
+    @message.destroy!
+    assert_nothing_raised do
+      perform_enqueued_jobs only: User::Bot::WebhookJob
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  private
+    def deliver
+      User::Bot::WebhookJob.perform_now(@bot, @message)
+    end
+end
