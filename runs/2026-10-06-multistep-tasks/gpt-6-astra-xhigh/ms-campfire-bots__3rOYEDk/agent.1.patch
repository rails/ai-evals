+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = users(:jz).bots.create!(name: "Deploy Bot")
+    @room = rooms(:pets)
+  end
+
+  test "raw curl body creates a message as the bot, broadcasts, and queues push" do
+    body = "Deploy of v1.2.3 finished ✅"
+    assert_difference -> { Message.count }, 1 do
+      assert_enqueued_jobs 1, only: Room::PushMessageJob do
+        post endpoint, params: body.dup, headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+      end
+    end
+    assert_response :created
+    message = Message.last
+    assert_equal message_path(message), response.headers["Location"]
+    assert_equal body, message.plain_text_body
+    assert_equal @bot, message.creator
+    assert_equal @room, message.room
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__body", text: /Deploy of v1.2.3 finished ✅/
+      assert_select ".message__body", text: /Deploy Bot/
+    end
+  end
+
+  test "push delivery uses the bot name and the normal room payload" do
+    @room = rooms(:hq)
+    payload = { title: @room.name, body: "Deploy Bot: Shipped!", path: room_path(@room) }
+    Rails.configuration.x.web_push_pool.expects(:queue).with(payload, anything).twice
+
+    perform_enqueued_jobs only: Room::PushMessageJob do
+      post endpoint, params: "Shipped!"
+      assert_response :created
+    end
+  end
+
+  test "invalid UTF-8 is rejected" do
+    assert_no_difference -> { Message.count } do
+      post endpoint, params: "\xFF".b, headers: { "Content-Type" => "text/plain" }
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "raw text is never decoded as form fields, parsed as JSON, or interpreted as HTML" do
+    body = "<script>alert('oops')</script>\nstatus=done&build[]=1&build[x]=2 + 100% ✅"
+    [ "text/plain", "application/x-www-form-urlencoded", "application/json" ].each do |content_type|
+      post endpoint, params: body.dup, headers: { "Content-Type" => content_type }
+      assert_response :created
+      assert_equal body, Message.last.plain_text_body
+      assert_not_includes Message.last.body.to_s, "<script>"
+    end
+  end
+
+  test "empty and whitespace bodies are rejected without broadcasts or jobs" do
+    [ "", " \n\t" ].each do |body|
+      assert_no_difference -> { Message.count } do
+        assert_no_enqueued_jobs only: Room::PushMessageJob do
+          assert_turbo_stream_broadcasts [ @room, :messages ], count: 0 do
+            post endpoint, params: body
+            assert_response :unprocessable_entity
+          end
+        end
+      end
+    end
+  end
+
+  test "invalid codes do not fall back to browser authentication" do
+    sign_in :david
+    assert_no_difference -> { Message.count } do
+      post endpoint(code: "invalid"), params: "Hello"
+      assert_response :unauthorized
+    end
+  end
+
+  test "bad room ids and non-member rooms are not found" do
+    [ 0, rooms(:designers).id ].each do |room_id|
+      post endpoint(room_id: room_id), params: "Hello"
+      assert_response :not_found
+    end
+  end
+
+  test "bots can be added to closed rooms like people" do
+    @room = rooms(:designers)
+    sign_in :david
+    put rooms_closed_url(@room), params: { room: { name: @room.name }, user_ids: @room.user_ids + [ @bot.id ] }
+    assert_redirected_to room_url(@room)
+    post endpoint, params: "Hello from a private room"
+    assert_response :created
+    assert_equal @bot, Message.last.creator
+  end
+
+  test "deactivated and banned bots cannot post" do
+    @bot.banned!
+    post endpoint, params: "Hello"
+    assert_response :unauthorized
+    @bot.active!
+    code = @bot.bot_code
+    sign_in :jz
+    delete bot_url(@bot)
+    post endpoint(code: code), params: "Hello"
+    assert_response :unauthorized
+  end
+
+  test "API does not require a CSRF token" do
+    with_forgery_protection do
+      post endpoint, params: "Hello"
+      assert_response :created
+    end
+  end
+
+  test "codes are filtered from request parameters and URL paths" do
+    request = ActionDispatch::TestRequest.create
+    request.path_info = "/rooms/#{@room.id}/#{@bot.bot_code}/messages"
+    request.path_parameters = { room_id: @room.id, bot_code: @bot.bot_code }
+    request.set_header "action_dispatch.parameter_filter", Rails.application.config.filter_parameters
+    assert_not_includes request.filtered_path, @bot.bot_code
+    assert_equal "[FILTERED]", request.filtered_parameters["bot_code"]
+  end
+
+  private
+    def endpoint(code: @bot.bot_code, room_id: @room.id)
+      "/rooms/#{room_id}/#{code}/messages"
+    end
+
+    def with_forgery_protection
+      previous = ActionController::Base.allow_forgery_protection
+      ActionController::Base.allow_forgery_protection = true
+      yield
+    ensure
+      ActionController::Base.allow_forgery_protection = previous
+    end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..5d59e33
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :jz
+    @bot = users(:jz).bots.create!(name: "Deploy Bot")
+    @other_bot = users(:kevin).bots.create!(name: "Other Bot")
+  end
+
+  test "account settings links to bots for members" do
+    get edit_account_url
+    assert_select "a[href=?]", bots_path, text: "Set up chat bots"
+  end
+
+  test "index shows only owned bots with a labeled readonly code in each list item" do
+    get bots_url
+    assert_response :success
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "label", text: "Bot code"
+      assert_select "input[readonly][value=?]", @bot.bot_code
+      assert_select "a[href=?]", edit_bot_path(@bot), text: "Edit Deploy Bot"
+    end
+    assert_not_includes response.body, @other_bot.bot_code
+    assert_select "a", text: "Add a chat bot"
+  end
+
+  test "administrators see and can manage all bots" do
+    sign_in :david
+    get bots_url
+    assert_select "input[readonly][value=?]", @bot.bot_code
+    assert_select "input[readonly][value=?]", @other_bot.bot_code
+    patch bot_url(@other_bot), params: { bot: { name: "Renamed" } }
+    assert_redirected_to bots_url
+    assert_equal "Renamed", @other_bot.reload.name
+    delete bot_url(@other_bot)
+    assert_redirected_to bots_url
+    assert @other_bot.reload.deactivated?
+  end
+
+  test "all owned bots are shown without pagination" do
+    25.times { |i| users(:jz).bots.create!(name: "Bot #{i}") }
+    get bots_url
+    assert_select "input[readonly]", count: 26
+    assert_select "turbo-frame[src]", count: 0
+  end
+
+  test "new and edit use the bot form" do
+    [ new_bot_url, edit_bot_url(@bot) ].each do |url|
+      get url
+      assert_response :success
+      assert_select "label", text: "Name the bot"
+      assert_select "input[name='bot[name]'][required]"
+      assert_select "input[type=file][name='bot[avatar]']"
+      assert_select "button", text: "Save changes"
+    end
+    assert_select "form[data-turbo-confirm] button", text: "Delete this chat bot"
+  end
+
+  test "creating a bot accepts an avatar and cannot override credentials or ownership" do
+    assert_difference -> { User.bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Build Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg"),
+        role: "administrator", creator_id: users(:kevin).id, bot_code: "guessable" } }
+    end
+    assert_redirected_to bots_url
+    bot = User.last
+    assert bot.bot?
+    assert_equal users(:jz), bot.creator
+    assert bot.avatar.attached?
+    assert_not_equal "guessable", bot.bot_code
+    assert_equal Rooms::Open.pluck(:id).sort, bot.room_ids.sort
+  end
+
+  test "blank names render errors without creating a bot" do
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: " " } }
+    end
+    assert_response :unprocessable_entity
+    assert_select "[role=alert]", text: /Name can't be blank/
+  end
+
+  test "updating a bot changes its name and avatar but keeps its code" do
+    code = @bot.bot_code
+    patch bot_url(@bot), params: { bot: { name: "Release Bot", avatar: fixture_file_upload("earth.png", "image/png"), bot_code: "new-code" } }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", @bot.reload.name
+    assert @bot.avatar.attached?
+    assert_equal code, @bot.bot_code
+
+    patch bot_url(@bot), params: { bot: { name: "" } }
+    assert_response :unprocessable_entity
+    assert_equal "Release Bot", @bot.reload.name
+  end
+
+  test "other members cannot edit update or delete a bot" do
+    get edit_bot_url(@other_bot)
+    assert_response :not_found
+    patch bot_url(@other_bot), params: { bot: { name: "Stolen" } }
+    assert_response :not_found
+    delete bot_url(@other_bot)
+    assert_response :not_found
+    assert_equal "Other Bot", @other_bot.reload.name
+    assert @other_bot.active?
+  end
+
+  test "human users cannot be managed as bots" do
+    sign_in :david
+    delete bot_url(users(:kevin))
+    assert_response :not_found
+    assert users(:kevin).reload.active?
+  end
+
+  test "deletion revokes the code and preserves authored messages" do
+    message = @bot.messages.create!(room: rooms(:watercooler), body: "Shipped!")
+    delete bot_url(@bot)
+    assert_redirected_to bots_url
+    assert @bot.reload.deactivated?
+    assert_nil @bot.bot_code
+    assert_equal @bot, message.reload.creator
+    get bots_url
+    assert_not_includes response.body, "Deploy Bot"
+  end
+
+  test "codes are not exposed in profiles or room membership forms" do
+    sign_in :kevin
+    [ user_url(@bot), edit_account_url, edit_rooms_open_url(rooms(:hq)) ].each do |url|
+      get url
+      assert_response :success
+      assert_not_includes response.body, @bot.bot_code
+    end
+  end
+
+  test "bots cannot be promoted through people administration" do
+    sign_in :david
+    assert_raises ActiveRecord::RecordNotFound do
+      patch account_user_url(@bot), params: { user: { role: "administrator" } }
+    end
+    assert @bot.reload.bot?
+  end
+
+  test "signed out visitors cannot see codes" do
+    delete session_url
+    get bots_url
+    assert_redirected_to new_session_url
+    assert_not_includes response.body, @bot.bot_code
+  end
+end
