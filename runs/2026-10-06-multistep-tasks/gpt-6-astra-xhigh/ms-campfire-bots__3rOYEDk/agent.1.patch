diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..a20e5ad
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,36 @@
+# Bot codes, not browser sessions, authenticate this raw-body API.
+class Bots::MessagesController < ActionController::API
+  include SetCurrentRequest
+
+  before_action :authenticate_bot
+
+  def create
+    room = Current.user.rooms.find(params[:room_id])
+    body = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+    return head :unprocessable_entity unless body.valid_encoding? && body.present?
+
+    message = room.messages.new(body: ERB::Util.html_escape(body).gsub(/\r\n?|\n/, "<br>"))
+
+    if message.save
+      message.broadcast_create
+      head :created, location: message_path(message)
+    else
+      head :unprocessable_entity
+    end
+  rescue ActiveRecord::RecordNotFound
+    head :not_found
+  end
+
+  private
+    def authenticate_bot
+      Current.user = User.bot.active.find_by(bot_code: params[:bot_code])
+      head :unauthorized unless Current.user
+    end
+
+    def process_action(*)
+      # Even curl's default form content type (or a JSON content type) is raw text.
+      # Set this before instrumentation can parse or log the body as parameters.
+      request.request_parameters = {}
+      super
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..34307e9
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,57 @@
+class BotsController < ApplicationController
+  before_action :prevent_caching
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = accessible_bots.ordered.with_attached_avatar
+  end
+
+  def new
+    @bot = Current.user.bots.new
+  end
+
+  def create
+    @bot = Current.user.bots.new(bot_params)
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url, status: :see_other
+  end
+
+  private
+    def prevent_caching
+      response.headers["Cache-Control"] = "no-store"
+    end
+
+    def accessible_bots
+      bots = User.bot.where.not(status: :deactivated)
+      Current.user.administrator? ? bots : bots.where(creator: Current.user)
+    end
+
+    def set_bot
+      @bot = accessible_bots.find_by(id: params[:id])
+      head :not_found unless @bot
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
