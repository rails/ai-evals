diff --git a/test/jobs/user/bot/joined_webhook_job_test.rb b/test/jobs/user/bot/joined_webhook_job_test.rb
new file mode 100644
index 0000000..7999696
--- /dev/null
+++ b/test/jobs/user/bot/joined_webhook_job_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class User::Bot::JoinedWebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Greeter", webhook_url: "https://bot.example.com/events")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    @join = @bot.bot_room_joins.find_by!(room: @room)
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "posts only the joined event and room with the bot's posting URL" do
+    request = stub_request(:post, @bot.webhook_url).with do |request|
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal({
+        "event" => "joined",
+        "room" => { "id" => @room.id, "name" => @room.name, "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages" }
+      }, JSON.parse(request.body))
+      true
+    end.to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+      User::Bot::JoinedWebhookJob.perform_now(@join)
+    end
+    assert_requested request, times: 1
+    assert_not_nil @join.reload.webhook_attempted_at
+  end
+
+  test "plain text greetings are escaped and broadcast as bot messages with push notifications" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "Hello <everyone>!\nI'm here ✅")
+
+    assert_difference -> { Message.count }, 1 do
+      assert_enqueued_jobs 1, only: Room::PushMessageJob do
+        assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+          assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+            perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+          end
+        end
+      end
+    end
+    reply = Message.last
+    assert_equal @bot, reply.creator
+    assert_equal @room, reply.room
+    assert_equal "Hello <everyone>!\nI'm here ✅", reply.plain_text_body
+    assert_includes reply.body.to_s, "&lt;everyone&gt;"
+  end
+
+  test "HTML greetings are formatted and sanitized without triggering mention callbacks" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/html" }, body: "<div><strong>Hello!</strong><script>alert(1)</script>#{mention_attachment_for(@bot)}</div>")
+    assert_difference -> { Message.count }, 1 do
+      assert_no_enqueued_jobs only: User::Bot::WebhookJob do
+        perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+      end
+    end
+    assert_includes Message.last.body.to_s, "<strong>Hello!</strong>"
+    assert_not_includes Message.last.body.to_s, "<script>"
+  end
+
+  test "no greeting for an unsupported response" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "application/json" }, body: '{"hello":true}')
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+    end
+  end
+
+  test "webhook removal cancels queued delivery" do
+    @bot.update! webhook_url: nil
+    assert_skipped_delivery
+  end
+
+  test "banning cancels queued delivery" do
+    @bot.banned!
+    assert_skipped_delivery
+  end
+
+  test "deactivation cancels queued delivery" do
+    @bot.deactivate
+    assert_skipped_delivery
+  end
+
+  test "revoking membership cancels queued delivery" do
+    @room.memberships.revoke_from(@bot)
+    assert_skipped_delivery
+  end
+
+  test "deleted rooms and bots discard their queued join events" do
+    @room.destroy!
+    @bot.destroy!
+    assert_skipped_delivery
+  end
+
+  test "failed requests are not retried even if a duplicate job runs" do
+    request = stub_request(:post, @bot.webhook_url).to_raise(Net::ReadTimeout)
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+      User::Bot::JoinedWebhookJob.perform_now(@join)
+    end
+    assert_requested request, times: 1
+  end
+
+  test "private destinations are blocked for join events too" do
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "127.0.0.1" ])
+    assert_skipped_delivery
+  end
+
+  private
+    def assert_skipped_delivery
+      assert_no_difference -> { Message.count } do
+        perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+      end
+      assert_not_requested :post, "https://bot.example.com/events"
+    end
+end
