+class User::Bot::RoomJoin < ApplicationRecord
+  self.table_name = "bot_room_joins"
+
+  belongs_to :bot, class_name: "User"
+  belongs_to :room
+
+  after_create_commit :notify_bot_later
+
+  # Keep this record when membership is revoked: joined is sent once per room,
+  # not again when access is re-granted or an open-room setting is re-saved.
+  def claim_webhook_delivery
+    self.class.where(id: id, webhook_attempted_at: nil).update_all(webhook_attempted_at: Time.current) == 1
+  end
+
+  private
+    def notify_bot_later
+      if bot.active? && bot.webhook_url.present?
+        User::Bot::JoinedWebhookJob.perform_later(self)
+      end
+    end
+end
