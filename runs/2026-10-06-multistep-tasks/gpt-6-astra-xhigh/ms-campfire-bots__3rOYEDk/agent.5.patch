@@ -0,0 +1,117 @@
+require "test_helper"
+
+class User::Bot::SafetyTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Broken Bot", webhook_url: "https://bot.example.com/events")
+    @room = rooms(:pets)
+    @room.memberships.grant_to(@bot)
+    @message = @room.messages.create!(creator: users(:david), body: mention_attachment_for(@bot))
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "all non-2xx statuses count as failures and the tenth suspends" do
+    [ 301, 302, 400, 401, 403, 404, 422, 429, 500, 503 ].each_with_index do |status, index|
+      stub_request(:post, @bot.webhook_url).to_return(status: status)
+      deliver
+      assert_equal index + 1, @bot.reload.bot_webhook_failures
+      assert_equal index == 9, @bot.suspended?
+    end
+    assert_equal User::Bot::Safety::WEBHOOK_FAILURE_REASON, @bot.bot_suspension_reason
+  end
+
+  test "every 2xx resets failures even when there is no usable reply" do
+    [ 200, 201, 202, 204, 206, 299 ].each do |status|
+      @bot.update! bot_webhook_failures: 9
+      stub_request(:post, @bot.webhook_url).to_return(status: status, headers: { "Content-Type" => "application/json" }, body: "{}")
+      assert_no_difference -> { Message.count } do
+        deliver
+      end
+      assert_equal 0, @bot.reload.bot_webhook_failures
+      assert @bot.active?
+    end
+  end
+
+  test "failures must be consecutive" do
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 500).times(9).then.to_return(status: 204).then.to_return(status: 500).times(10)
+    19.times { deliver }
+    assert @bot.reload.active?
+    assert_equal 9, @bot.bot_webhook_failures
+    deliver
+    assert @bot.reload.suspended?
+    assert_requested request, times: 20
+  end
+
+  test "timeouts and connection errors count towards suspension without retries" do
+    [ Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNREFUSED, SocketError, OpenSSL::SSL::SSLError ].cycle.take(10).each_with_index do |error, index|
+      stub_request(:post, @bot.webhook_url).to_raise(error)
+      deliver
+      assert_equal index + 1, @bot.reload.bot_webhook_failures
+    end
+    assert @bot.suspended?
+    assert_requested :post, @bot.webhook_url, times: 10
+  end
+
+  test "a timeout reading a 200 reply is a single failure not a success" do
+    @bot.update! bot_webhook_failures: 9
+    response = Net::HTTPOK.new("1.1", "200", "OK")
+    response["Content-Type"] = "text/plain"
+    response.stubs(:read_body).raises(Net::ReadTimeout)
+    http = mock
+    http.expects(:request).yields(response)
+    Net::HTTP.stubs(:start).yields(http)
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.bot_webhook_failures
+  end
+
+  test "joined and mention deliveries share a failure counter" do
+    @bot.update! bot_webhook_failures: 8
+    stub_request(:post, @bot.webhook_url).to_return(status: 500)
+    perform_enqueued_jobs only: User::Bot::JoinedWebhookJob
+    assert_equal 9, @bot.reload.bot_webhook_failures
+    deliver
+    assert @bot.reload.suspended?
+  end
+
+  test "suspended bots receive neither queued nor newly queued webhooks" do
+    10.times { @bot.record_bot_webhook_delivery(success: false) }
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: [ User::Bot::JoinedWebhookJob, User::Bot::WebhookJob ]
+      User::Bot::Webhook.new(bot: @bot, room: @room).deliver
+    end
+    assert_no_enqueued_jobs only: [ User::Bot::JoinedWebhookJob, User::Bot::WebhookJob ] do
+      @room.messages.create!(creator: users(:david), body: mention_attachment_for(@bot))
+      rooms(:hq).memberships.grant_to(@bot)
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "an in-flight successful response cannot post after suspension" do
+    stub_request(:post, @bot.webhook_url).to_return do
+      other_instance = User.find(@bot.id)
+      10.times { other_instance.record_bot_webhook_delivery(success: false) }
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "Too late" }
+    end
+    assert_no_difference -> { Message.count } do
+      deliver
+    end
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.bot_webhook_failures
+  end
+
+  test "reactivated bots receive webhooks again" do
+    10.times { @bot.record_bot_webhook_delivery(success: false) }
+    @bot.reactivate_bot
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 204)
+    deliver
+    assert_requested request
+    assert_equal 0, @bot.reload.bot_webhook_failures
+  end
+
+  private
+    def deliver
+      User::Bot::WebhookJob.perform_now(@bot, @message)
+    end
+end
