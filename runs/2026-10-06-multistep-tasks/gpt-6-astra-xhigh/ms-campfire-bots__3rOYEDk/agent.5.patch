+require "application_system_test_case"
+
+class BotSafetyTest < ApplicationSystemTestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Broken Bot")
+    10.times { @bot.record_bot_webhook_delivery(success: false) }
+  end
+
+  test "administrators confirm reactivation with the native browser dialog" do
+    sign_in users(:david).email_address
+    visit bots_url
+    assert_text "Broken Bot"
+    assert_text "Suspended"
+    assert_text @bot.bot_suspension_reason
+
+    dismiss_confirm { click_on "Reactivate" }
+    assert_button "Reactivate"
+    assert @bot.reload.suspended?
+
+    accept_confirm { click_on "Reactivate" }
+    assert_current_path bots_path
+    assert_no_text "Suspended"
+    assert_no_button "Reactivate"
+    assert_text "Broken Bot"
+    assert @bot.reload.active?
+  end
+
+  test "owners see the suspension reason and still use a bot slot" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in users(:jz).email_address
+    visit bots_url
+    assert_text "Broken Bot"
+    assert_text "Suspended"
+    assert_text @bot.bot_suspension_reason
+    assert_no_button "Reactivate"
+    assert_no_link "Add a chat bot"
+    assert_text "reached the limit"
+  end
+end
