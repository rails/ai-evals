@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Bots::ReactivationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = users(:jz).bots.create!(name: "Broken Bot")
+    10.times { @bot.record_bot_webhook_delivery(success: false) }
+  end
+
+  test "owners see the suspended bot and reason but cannot reactivate" do
+    sign_in :jz
+    get bots_url
+    assert_response :success
+    assert_select "li", text: /Broken Bot/ do
+      assert_select "[role=status]", text: "Suspended — #{@bot.bot_suspension_reason}"
+      assert_select "button", text: "Reactivate", count: 0
+      assert_select "input[readonly][value=?]", @bot.bot_code
+    end
+    post bot_reactivation_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "other members cannot reactivate or see someone else's suspended bot" do
+    sign_in :kevin
+    get bots_url
+    assert_select "li", text: /Broken Bot/, count: 0
+    post bot_reactivation_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.suspended?
+  end
+
+  test "administrators can reactivate bots belonging to anyone from the bots page" do
+    sign_in :david
+    get bots_url
+    assert_select "li", text: /Broken Bot/ do
+      assert_select "[role=status]", text: /Suspended/
+      assert_select "form[action=?][data-turbo-confirm] button", bot_reactivation_path(@bot), text: "Reactivate"
+    end
+    post bot_reactivation_url(@bot)
+    assert_redirected_to bots_url
+    assert_response :see_other
+    assert @bot.reload.active?
+    assert_equal 0, @bot.bot_webhook_failures
+    follow_redirect!
+    assert_select "[role=status]", text: /Suspended/, count: 0
+    assert_select "button", text: "Reactivate", count: 0
+  end
+
+  test "editing cannot clear suspension or change safety counters" do
+    sign_in :jz
+    patch bot_url(@bot), params: { bot: { name: "Renamed Bot", status: "active", bot_suspension_reason: "", bot_webhook_failures: 0 } }
+    assert_redirected_to bots_url
+    assert_equal "Renamed Bot", @bot.reload.name
+    assert @bot.suspended?
+    assert_equal 10, @bot.bot_webhook_failures
+    assert_equal User::Bot::Safety::WEBHOOK_FAILURE_REASON, @bot.bot_suspension_reason
+  end
+
+  test "signed out requests cannot reactivate" do
+    post bot_reactivation_url(@bot)
+    assert_redirected_to new_session_url
+    assert @bot.reload.suspended?
+  end
+
+  test "reactivation is restricted to bots" do
+    sign_in :david
+    assert_raises ActiveRecord::RecordNotFound do
+      post bot_reactivation_url(users(:jz))
+    end
+  end
+end
