new file mode 100644
index 0000000..b551952
--- /dev/null
+++ b/app/models/user/bot/safety.rb
@@ -0,0 +1,79 @@
+module User::Bot::Safety
+  extend ActiveSupport::Concern
+
+  MESSAGE_LIMIT = 10
+  MESSAGE_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  FLOODING_REASON = "Flooding: five posting attempts during a cooldown."
+  WEBHOOK_FAILURE_REASON = "Webhooks: ten consecutive failed deliveries."
+
+  # Both API posts and webhook replies go through this gate. Commit the message
+  # and its rolling-window entry together, serializing concurrent workers on the
+  # bot (SQLite uses an immediate write transaction). Rejections must also commit
+  # their counters, so return a status rather than raising/rolling back.
+  def post_bot_message(message)
+    with_lock do
+      if suspended?
+        :forbidden
+      elsif !active?
+        :unauthorized
+      elsif bot_cooldown_until&.future?
+        self.bot_cooldown_attempts += 1
+        suspend_bot_for(FLOODING_REASON) if bot_cooldown_attempts >= COOLDOWN_ATTEMPT_LIMIT
+        save!
+        suspended? ? :forbidden : :too_many_requests
+      else
+        now = Time.current
+        self.bot_cooldown_until = nil
+        self.bot_cooldown_attempts = 0
+        self.bot_message_timestamps = bot_message_timestamps.select { |timestamp| timestamp > (now - MESSAGE_WINDOW).to_f }
+
+        result = if bot_message_timestamps.size >= MESSAGE_LIMIT
+          self.bot_cooldown_until = now + COOLDOWN
+          :too_many_requests
+        elsif message.save
+          self.bot_message_timestamps += [ now.to_f ]
+          :created
+        else
+          :unprocessable_entity
+        end
+
+        save!
+        result
+      end
+    end
+  end
+
+  def bot_retry_after
+    [ (bot_cooldown_until - Time.current).ceil, 1 ].max
+  end
+
+  def record_bot_webhook_delivery(success:)
+    with_lock do
+      if active?
+        self.bot_webhook_failures = success ? 0 : bot_webhook_failures + 1
+        suspend_bot_for(WEBHOOK_FAILURE_REASON) if bot_webhook_failures >= WEBHOOK_FAILURE_LIMIT
+        save!
+      end
+    end
+  end
+
+  def reactivate_bot
+    with_lock do
+      if bot? && suspended?
+        update! status: :active, bot_suspension_reason: nil,
+          bot_message_timestamps: [], bot_cooldown_until: nil,
+          bot_cooldown_attempts: 0, bot_webhook_failures: 0
+      end
+    end
+  end
+
+  private
+    def suspend_bot_for(reason)
+      self.status = :suspended
+      self.bot_suspension_reason = reason
+    end
+end
