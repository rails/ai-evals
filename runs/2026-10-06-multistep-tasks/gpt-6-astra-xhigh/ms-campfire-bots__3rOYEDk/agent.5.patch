+++ b/test/models/user/bot_safety_concurrency_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class User::BotSafetyConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  setup do
+    @bot = users(:jz).bots.create!(name: "Concurrent Bot")
+  end
+
+  teardown do
+    @bot.destroy!
+  end
+
+  test "concurrent workers cannot overshoot the message limit or lose cooldown attempts" do
+    room_id = rooms(:pets).id
+    freeze_time do
+      results = concurrently(workers: 4) do |bot|
+        room = Room.find(room_id)
+        4.times.map do
+          bot.post_bot_message(room.messages.new(creator: bot, body: "Hello"))
+        end
+      end.flatten
+
+      assert_equal({ created: 10, too_many_requests: 5, forbidden: 1 }, results.tally)
+      assert_equal 10, @bot.messages.count
+      assert @bot.reload.suspended?
+      assert_equal 5, @bot.bot_cooldown_attempts
+    end
+  end
+
+  test "concurrent webhook failures cannot lose increments" do
+    concurrently(workers: 5) do |bot|
+      2.times { bot.record_bot_webhook_delivery(success: false) }
+    end
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.bot_webhook_failures
+  end
+
+  private
+    def concurrently(workers:)
+      ready, start = Queue.new, Queue.new
+      threads = workers.times.map do
+        Thread.new do
+          Rails.application.executor.wrap do
+            ActiveRecord::Base.connection_pool.with_connection do
+              bot = User.find(@bot.id)
+              ready << true
+              start.pop
+              yield bot
+            end
+          end
+        end
+      end
+      workers.times { ready.pop }
+      workers.times { start << true }
+      threads.map(&:value)
+    end
+end
