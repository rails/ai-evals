@@ -0,0 +1,9 @@
+class User::Bot::WebhookJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bot, message)
+    if bot.bot? && bot.active? && bot.webhook_url.present? && !message.creator.bot? && message.mentionees.exists?(bot.id)
+      User::Bot::Webhook.new(bot: bot, message: message).deliver
+    end
+  end
+end
