+    expect(manifest["targets"]["public"].values.map { |t| t["data"]["count"] }.uniq).to eq [0]
+    migrate
+    expect(connection.table_exists?("public.proposals")).to be false
+  end
+
+  it "does not overwrite a previous archive" do
