diff --git a/bin/archive_citizen_proposals b/bin/archive_citizen_proposals
new file mode 100755
index 0000000..2817dff
--- /dev/null
+++ b/bin/archive_citizen_proposals
@@ -0,0 +1,14 @@
+#!/usr/bin/env ruby
+# Usage: RAILS_ENV=development bundle exec ruby bin/archive_citizen_proposals
+require_relative "../config/environment"
+require_relative "../db/citizen_proposal_removal/archive"
+
+root = Rails.root.join("db", "archives", "citizen_proposals")
+FileUtils.mkdir_p(root, mode: 0700)
+directory = root.join("#{Time.now.utc.strftime("%Y%m%dT%H%M%S")}-#{Rails.env}-#{SecureRandom.hex(6)}")
+ApplicationRecord.connection_pool.with_connection do |connection|
+  archive = CitizenProposalSchemaRemoval::Archive.new(connection.raw_connection)
+  archive.export!(directory.to_s)
+end
+puts "Verified archive retained at #{directory}"
+puts "CITIZEN_PROPOSAL_ARCHIVE=#{directory.relative_path_from(Rails.root)}"
