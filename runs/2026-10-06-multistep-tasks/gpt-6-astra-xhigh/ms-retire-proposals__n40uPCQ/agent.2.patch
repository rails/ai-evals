+      expect(connection.select_value("SELECT legislation_proposals_count FROM #{schema}.tags")).to eq 6
+      expect(connection.select_value("SELECT title FROM #{schema}.legislation_proposals"))
+        .to eq "Keep legislation"
+    end
+  end
+
+  it "keeps a previous-release connection with warmed column caches working across removal" do
+    previous_models = CitizenProposalSchemaRemoval::COLUMNS.map do |table, columns|
+      model = stub_const("PreviousRelease#{table.camelize}", Class.new(database_class))
+      model.table_name = "public.#{table}"
+      model.ignored_columns = columns
+      model
+    end
+    previous_models.each { |model| expect(model.first).to be_present }
+    export
+    migrate
+    previous_models.each { |model| expect(model.first.reload).to be_present }
