diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
new file mode 100644
index 0000000..63505a0
--- /dev/null
+++ b/config/initializers/active_storage.rb
@@ -0,0 +1,19 @@
+# ApplicationConfig is initialized by 0_application_config.rb, after environment
+# files are evaluated. Select production storage here, not in production.rb.
+module ActiveStorageInitializer
+  def self.production_service
+    if ENV["FILE_STORAGE_LOCATION"] == "file"
+      :local
+    elsif ENV["FOREM_CONTEXT"] == "forem_cloud"
+      :forem_cloud
+    elsif ApplicationConfig["AWS_ID"].present?
+      :amazon
+    else
+      :local
+    end
+  end
+end
+
+if Rails.env.production?
+  Rails.application.config.active_storage.service = ActiveStorageInitializer.production_service
+end
