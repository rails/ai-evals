diff --git a/app/services/images/profile_image.rb b/app/services/images/profile_image.rb
new file mode 100644
index 0000000..20056d3
--- /dev/null
+++ b/app/services/images/profile_image.rb
@@ -0,0 +1,19 @@
+module Images
+  # Keep CarrierWave's public URL/JSON interface for forms and serializers while
+  # the actual file is held by Active Storage. Legacy reads still use the mount.
+  class ProfileImage
+    def initialize(record)
+      @record = record
+    end
+
+    def url
+      @record.profile_image_url
+    end
+
+    delegate :to_s, to: :url
+
+    def as_json(*)
+      { "url" => url }
+    end
+  end
+end
