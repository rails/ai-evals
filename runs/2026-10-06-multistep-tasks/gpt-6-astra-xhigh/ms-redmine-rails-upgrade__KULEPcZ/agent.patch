diff --git a/bin/test-upgrade-compatibility b/bin/test-upgrade-compatibility
new file mode 100755
index 0000000..914ba32
--- /dev/null
+++ b/bin/test-upgrade-compatibility
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+current_root=$PWD
+artifacts=$(mktemp -d)
+trap 'rm -rf "$artifacts"' EXIT
+probe=test/compatibility/upgrade_probe.rb
+current() {
+  BUNDLE_GEMFILE="$current_root/Gemfile" bundle exec ruby "$probe" "$1" "$2" "$3"
+}
+# A local writer/reader check is useful in CI, but is NOT the rollback gate.
+if [[ $# -eq 1 && "${1:-}" == "--self-check" ]]; then
+  current write - "$artifacts/current.json"
+  current read "$artifacts/current.json" "$artifacts/reread.json"
+  exit
+fi
+if [[ $# -ne 0 || -z "${UPGRADE_PREVIOUS_ROOT:-}" ]]; then
+  echo 'Usage: UPGRADE_PREVIOUS_ROOT=/path/to/deployed-72 bin/test-upgrade-compatibility' >&2
+  echo 'Or use --self-check (does not verify cross-release rollback).' >&2
+  exit 1
+fi
+# Use the unchanged deployed 7.2 code, defaults and probe, not an alternate
+# Gemfile boot of this release. Both processes need the same disposable secret.
+previous_root=$(cd "$UPGRADE_PREVIOUS_ROOT" && pwd)
+if [[ "$previous_root" == "$current_root" ]]; then
+  echo 'Rollback target must be a separate deployed Rails 7.2 checkout.' >&2
+  exit 1
+fi
+previous() {
+  (cd "$previous_root" && PATH="${UPGRADE_PREVIOUS_RUBY_BIN:+$UPGRADE_PREVIOUS_RUBY_BIN:}$PATH" \
+    BUNDLE_GEMFILE="$previous_root/Gemfile" bundle exec ruby "$probe" "$1" "$2" "$3")
+}
+(cd "$previous_root" && PATH="${UPGRADE_PREVIOUS_RUBY_BIN:+$UPGRADE_PREVIOUS_RUBY_BIN:}$PATH" \
+  BUNDLE_GEMFILE="$previous_root/Gemfile" bundle exec ruby -e \
+  'require "rails"; abort "Expected the deployed Rails 7.2 release" unless Rails.gem_version.segments.first(2) == [7, 2]')
+previous write - "$artifacts/previous.json"
+current read "$artifacts/previous.json" "$artifacts/current.json"
+previous read "$artifacts/current.json" "$artifacts/rollback.json"
+current read "$artifacts/rollback.json" "$artifacts/reupgrade.json"
+# A user who first signs in on 8.1 must survive rollback and re-upgrade too.
+current write - "$artifacts/newcurrent.json"
+previous read "$artifacts/newcurrent.json" "$artifacts/newrollback.json"
+current read "$artifacts/newrollback.json" "$artifacts/newreupgrade.json"
