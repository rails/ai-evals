diff --git a/test/compatibility/upgrade_probe.rb b/test/compatibility/upgrade_probe.rb
new file mode 100644
index 0000000..c1070ba
--- /dev/null
+++ b/test/compatibility/upgrade_probe.rb
@@ -0,0 +1,135 @@
+# frozen_string_literal: true
+
+# Called by bin/test-upgrade-compatibility in separate Ruby/Rails processes.
+# No database needed: exercise the real cookie/session middleware and Mailer
+# token API. Integration tests additionally check Redmine's database session tk.
+ENV['RAILS_ENV'] = 'test'
+require_relative '../../config/environment'
+require 'rack/test'
+require 'json'
+
+mode, input, output = ARGV
+payload = {'user_id' => 2, 'tk' => 'persistent-database-token', 'nested' => {'notice' => 'Still signed in'}}
+mail_data = {'user_id' => 3, 'issue_id' => 2}
+app = Rails.application
+legacy_metadata_options = {:force_legacy_metadata_serializer => true}
+raise 'Expected Rails 8.1 defaults' unless app.config.loaded_config_version.to_s == '8.1'
+
+forms = []
+rejected_links = []
+endpoint = lambda do |env|
+  request = ActionDispatch::Request.new(env)
+  if request.path == '/write'
+    payload.each {|key, value| request.session[key] = value}
+    request.cookie_jar.signed[:upgrade_signed] = 'signed value'
+    request.cookie_jar.encrypted[:upgrade_encrypted] = 'encrypted value'
+  else
+    payload.each do |key, value|
+      raise "Lost session #{key} on Rails #{Rails.version}" unless request.session[key] == value
+    end
+    raise 'Lost signed cookie' unless request.cookie_jar.signed[:upgrade_signed] == 'signed value'
+    raise 'Lost encrypted cookie' unless request.cookie_jar.encrypted[:upgrade_encrypted] == 'encrypted value'
+  end
+  controller = ActionController::Base.new
+  controller.set_request!(request)
+  forms.each do |token|
+    unless controller.send(:valid_authenticity_token?, request.session, token)
+      raise 'Lost an already-open form CSRF token'
+    end
+  end
+  forms << controller.send(:form_authenticity_token, :form_options => {:action => '/read', :method => 'GET'})
+  controller.send(:commit_csrf_token, request)
+  # Check the primary per-form CSRF writer too.
+  expected = controller.send(:per_form_csrf_token, request.session, '/read', 'GET')
+  decoded = controller.send(:decode_csrf_token, forms.last)
+  raise 'Wrong primary CSRF writer' unless controller.send(:unmask_token, decoded) == expected
+
+  request.session[:requests] = request.session[:requests].to_i + 1
+  [200, {'Content-Type' => 'text/plain'}, ['ok']]
+end
+middleware = ActionDispatch::Cookies.new(
+  ActionDispatch::Session::CookieStore.new(endpoint, app.config.session_options)
+)
+client = Rack::Test::Session.new(lambda {|env| middleware.call(env.merge(app.env_config))})
+
+if mode == 'write'
+  client.get '/write'
+  links = [Mailer.mail_link_token(:unwatch, mail_data)]
+else
+  previous = JSON.parse(File.read(input))
+  forms.replace(previous.fetch('forms'))
+  previous.fetch('cookies').each do |key, value|
+    client.set_cookie "#{key}=#{Rack::Utils.escape(value)}"
+  end
+  rejected_links.concat(previous.fetch('rejected_links', []))
+  previous.fetch('links').each do |token|
+    raise 'Lost mail link' unless Mailer.verify_mail_link(token, :unwatch) == mail_data
+  end
+  links = previous.fetch('links') + [Mailer.mail_link_token(:unwatch, mail_data)]
+  client.get '/read'
+end
+raise "HTTP #{client.last_response.status}" unless client.last_response.status == 200
+
+# Independently verify the primary writer, not just the configured readers.
+# Key rotations must never change the default SHA256 primary writer.
+digest = OpenSSL::Digest::SHA256
+derive = lambda do |salt, length=64|
+  OpenSSL::PKCS5.pbkdf2_hmac(app.secret_key_base, salt, 1000, length, digest.new)
+end
+dispatch = app.config.action_dispatch
+cipher = 'aes-256-gcm'
+salt = dispatch.authenticated_encrypted_cookie_salt
+secret = derive.call(salt, ActiveSupport::MessageEncryptor.key_len(cipher))
+signing_secret = derive.call(dispatch.encrypted_signed_cookie_salt)
+primary = ActiveSupport::MessageEncryptor.new(secret, signing_secret, :cipher => cipher, :serializer => JSON, **legacy_metadata_options)
+options = {:purpose => 'cookie._redmine_session'}
+session = primary.decrypt_and_verify(client.cookie_jar['_redmine_session'], **options)
+payload.each {|key, value| raise "Wrong primary cookie writer: #{key}" unless session[key] == value}
+# Inspect actual bytes, independently of the framework's metadata globals.
+# 8.1 must write the native envelope, not a legacy rollback-pinned envelope.
+mail_serializer = JSON
+envelope = JSON.parse(Base64.strict_decode64(links.last.split('--').first)).fetch('_rails')
+expected_keys = ['data', 'exp', 'pur']
+raise 'Wrong primary metadata envelope' unless envelope.keys.sort == expected_keys
+
+written_data = envelope.fetch('data')
+raise 'Wrong primary mail serialization' unless written_data == mail_data
+raise 'Wrong mail purpose' unless envelope.fetch('pur') == 'unwatch'
+raise 'Wrong mail expiry' unless (Time.iso8601(envelope.fetch('exp')) - 30.days.from_now).abs < 5
+
+verifier = ActiveSupport::MessageVerifier.new(
+  derive.call('mail_links'), :digest => 'SHA1', :serializer => mail_serializer,
+  **legacy_metadata_options
+)
+raise 'Wrong primary mail writer' unless verifier.verify(links.last, :purpose => :unwatch) == mail_data
+
+# Check signed cookie serialization, digest and cookie-name metadata as well.
+signed = ActiveSupport::MessageVerifier.new(
+  derive.call(dispatch.signed_cookie_salt), :digest => 'SHA1',
+  :serializer => JSON, **legacy_metadata_options
+)
+signed_options = {:purpose => 'cookie.upgrade_signed'}
+raise 'Wrong primary signed cookie writer' unless signed.verify(client.cookie_jar['upgrade_signed'], **signed_options) == 'signed value'
+
+# Exchange genuine invalid artifacts as well as successful links. The older
+# deployed probe may not supply this field, so it remains optional on input.
+mail_verifier = app.message_verifier(:mail_links)
+rejected_links << mail_verifier.generate(mail_data, :purpose => :other)
+rejected_links << mail_verifier.generate(mail_data, :purpose => :unwatch, :expires_at => 1.day.ago)
+rejected_links << mail_verifier.generate(mail_data)
+rejected_links << app.message_verifier(:other).generate(mail_data, :purpose => :unwatch)
+tampered = links.last.dup
+tampered[-1] = tampered[-1] == '0' ? '1' : '0'
+rejected_links << tampered
+rejected_links.each do |token|
+  begin
+    Mailer.verify_mail_link(token, :unwatch)
+  rescue ActiveSupport::MessageVerifier::InvalidSignature
+    next
+  end
+  raise 'Accepted an invalid mail link'
+end
+
+File.write(output, JSON.generate('cookies' => client.cookie_jar.to_hash, 'links' => links,
+                                'forms' => forms, 'rejected_links' => rejected_links))
+puts "Rails #{Rails.version} / Ruby #{RUBY_VERSION}: #{mode} OK (#{links.size} mail links)"
