diff --git a/app/controllers/api/v1/invitations_controller.rb b/app/controllers/api/v1/invitations_controller.rb
new file mode 100644
index 0000000..4aa47b8
--- /dev/null
+++ b/app/controllers/api/v1/invitations_controller.rb
@@ -0,0 +1,45 @@
+module Api
+  module V1
+    class InvitationsController < BaseController
+      include Pagination
+      before_action :require_admin!
+
+      def index
+        status = filter_parameter(:status, Invitation::STATUSES)
+        current_account.invitations.expire_pending!
+        scope = current_account.invitations.order(:id)
+        scope = scope.where(status: status) if status
+        render json: paginated(scope, :invitations) { |invitation| ApiRepresentation.invitation(invitation) }
+      end
+
+      def show
+        render json: { invitation: ApiRepresentation.invitation(find_invitation) }
+      end
+
+      def create
+        invitation, token = Invitation.issue!(account: current_account,
+          attributes: string_fields(:invitation, :email, :role))
+        InvitationMailer.invitation(invitation, token).deliver_now
+        render json: { invitation: ApiRepresentation.invitation(invitation) }, status: :created
+      end
+
+      def resend
+        invitation = find_invitation
+        token = invitation.resend!
+        InvitationMailer.invitation(invitation, token).deliver_now
+        render json: { invitation: ApiRepresentation.invitation(invitation) }
+      end
+
+      def destroy
+        find_invitation.revoke!
+        head :no_content
+      end
+
+      private
+
+      def find_invitation
+        current_account.invitations.find(params[:id])
+      end
+    end
+  end
+end
