diff --git a/app/controllers/api/v1/users_controller.rb b/app/controllers/api/v1/users_controller.rb
new file mode 100644
index 0000000..f1e3e16
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,45 @@
+module Api
+  module V1
+    class UsersController < BaseController
+      include Pagination
+      before_action :require_admin!
+
+      def index
+        role = filter_parameter(:role, User::ROLES)
+        suspended = filter_parameter(:suspended, %w[true false])
+        scope = current_account.users.order(:id)
+        scope = scope.where(role: role) if role
+        scope = scope.where(suspended: suspended == "true") if suspended
+        render json: paginated(scope, :users) { |user| ApiRepresentation.user(user) }
+      end
+
+      def show
+        render json: { user: ApiRepresentation.user(find_user) }
+      end
+
+      def update
+        user = find_user
+        envelope = params.require(:user)
+        raise ActionController::BadRequest unless envelope.is_a?(ActionController::Parameters)
+        attributes = {}
+        if envelope.key?(:name)
+          attributes[:name] = envelope[:name]
+          ensure_string_fields!(attributes)
+        end
+        if envelope.key?(:suspended)
+          raise ActionController::BadRequest unless [true, false].include?(envelope[:suspended])
+          attributes[:suspended] = envelope[:suspended]
+        end
+        raise ActionController::BadRequest if attributes.empty?
+        user.update!(attributes)
+        render json: { user: ApiRepresentation.user(user) }
+      end
+
+      private
+
+      def find_user
+        current_account.users.find(params[:id])
+      end
+    end
+  end
+end
