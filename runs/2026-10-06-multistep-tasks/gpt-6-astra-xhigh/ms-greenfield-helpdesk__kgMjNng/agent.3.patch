+++ b/test/models/team_integrity_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class TeamIntegrityTest < ActiveSupport::TestCase
+  setup do
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @invitation, = Invitation.issue!(account: @account, attributes: { email: "sam@example.test", role: "agent" })
+  end
+
+  test "database enforces one pending invitation per case insensitive account email" do
+    assert_raises ActiveRecord::RecordNotUnique do
+      Invitation.transaction(requires_new: true) do
+        Invitation.insert_all!([{ account_id: @account.id, email: "SAM@EXAMPLE.TEST",
+          role: "admin", expires_at: 1.day.from_now }])
+      end
+    end
+    assert_equal 1, @account.invitations.count
+  end
+
+  test "database enforces invitation role and status" do
+    [ { role: "customer" }, { role: "member" }, { status: "bogus" } ].each do |attributes|
+      assert_raises ActiveRecord::StatementInvalid do
+        Invitation.transaction(requires_new: true) { @invitation.update_columns(attributes) }
+      end
+    end
+    assert_equal "pending", @invitation.reload.status
+    assert_equal "agent", @invitation.role
+  end
+
+  test "account deletion cascades invitations and assignee deletion nullifies assignments" do
+    customer = @account.users.create!(name: "Customer", email: "customer@example.test", password: "my-password", role: "customer")
+    agent = @invitation.accept!(name: "Agent", password: "my-password")
+    ticket = Ticket.open_request!(account: @account, requester: customer, subject: "Help", comment: { body: "Help" })
+    ticket.update!(assignee: agent)
+    agent.delete
+    assert_nil ticket.reload.assignee_id
+    @account.delete
+    assert_not Invitation.exists?(@invitation.id)
+    assert_not Ticket.exists?(ticket.id)
+  end
+
+  test "retention purge destroys invitation history with the account" do
+    @account.update!(cancelled_at: 91.days.ago)
+    assert_equal 1, Account.purge_cancelled!
+    assert_not Invitation.exists?(@invitation.id)
+  end
+end
