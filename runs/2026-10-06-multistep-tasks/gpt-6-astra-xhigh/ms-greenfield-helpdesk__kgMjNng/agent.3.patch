diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..35e453b
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,104 @@
+require "uri"
+
+class Invitation < ApplicationRecord
+  LIFETIME = 7.days
+  ROLES = %w[admin agent].freeze
+  STATUSES = %w[pending accepted revoked expired].freeze
+
+  belongs_to :account
+  normalizes :email, with: ->(value) { value.strip.downcase }
+  validates :email, presence: true, length: { maximum: 254 }, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, inclusion: { in: ROLES }
+  validates :status, inclusion: { in: STATUSES }
+  validates :expires_at, presence: true
+  validate :email_available, if: -> { status == "pending" }
+
+  scope :pending, -> { where(status: "pending").where("expires_at > ?", Time.current) }
+
+  # Expiry is accurate even before a subsequent write materializes it in the DB.
+  def status
+    stored = self[:status]
+    stored == "pending" && expires_at && expires_at <= Time.current ? "expired" : stored
+  end
+
+  def self.expire_pending!
+    where(status: "pending").where("expires_at <= ?", Time.current)
+      .update_all(status: "expired", updated_at: Time.current)
+  end
+
+  # Account locks also serialize these operations with customer registration.
+  def self.issue!(account:, attributes:)
+    account.with_lock do
+      account.invitations.expire_pending!
+      invitation = account.invitations.new(attributes)
+      token = invitation.rotate_token
+      invitation.save!
+      [invitation, token]
+    end
+  end
+
+  def self.from_token!(account:, token:)
+    if token.is_a?(String) && token.present? && token.length <= 128
+      invitation = account.invitations.pending.find_by(token_digest: Session.digest(token))
+      return invitation if invitation
+    end
+    raise ApiError.new(:unprocessable_entity, "invalid_token", "This invitation is invalid or has expired.")
+  end
+
+  def resend!
+    account.with_lock do
+      reload
+      require_status!("pending", "expired")
+      account.invitations.expire_pending!
+      reload
+      token = rotate_token
+      save!
+      token
+    end
+  end
+
+  def revoke!
+    account.with_lock do
+      reload
+      require_status!("pending", "expired", "revoked")
+      update!(status: "revoked", revoked_at: Time.current, token_digest: nil) unless status == "revoked"
+    end
+  end
+
+  def accept!(name:, password:)
+    account.with_lock do
+      reload
+      require_status!("pending")
+      user = account.users.create!(name: name, password: password, email: email,
+        role: role, owner: false, verified_at: Time.current)
+      update!(status: "accepted", accepted_at: Time.current, token_digest: nil)
+      user
+    end
+  end
+
+  def rotate_token
+    token = SecureRandom.urlsafe_base64(32)
+    self.token_digest = Session.digest(token)
+    self.expires_at = LIFETIME.from_now
+    self.status = "pending"
+    token
+  end
+
+  private
+
+  def require_status!(*allowed)
+    unless allowed.include?(status)
+      raise ApiError.new(:unprocessable_entity, "invalid_invitation_status", "This invitation can no longer be used for this action.")
+    end
+  end
+
+  def email_available
+    return unless account && email.present?
+    if account.users.where("lower(email) = ?", email).exists?
+      errors.add(:email, "is already registered")
+    end
+    if account.invitations.pending.where("lower(email) = ?", email).where.not(id: id).exists?
+      errors.add(:email, "already has a pending invitation")
+    end
+  end
+end
