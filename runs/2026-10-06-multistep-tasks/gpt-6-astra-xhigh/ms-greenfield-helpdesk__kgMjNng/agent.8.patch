+      scope.except(:order, :includes).to_sql, order
+    ].to_json)
+    result = CursorPagination.new(scope: scope, order: order, context: context,
+      size: size.to_i, direction: direction, cursor: cursor).call
+    { resource => result[:records].map { |record| yield record }, meta: result[:meta],
+      links: {
+        next: cursor_link(:after, result[:next_cursor], size.to_i),
+        prev: cursor_link(:before, result[:prev_cursor], size.to_i)
+      } }
+  end
+
+  def cursor_link(direction, cursor, size)
+    return nil unless cursor
+    query = request.query_parameters.except("page", "per_page")
+      .merge("page" => { "size" => size, direction.to_s => cursor })
+    "#{request.path}?#{query.to_query}"
+  end
