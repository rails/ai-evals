+++ b/app/mailers/ticket_mailer.rb
@@ -0,0 +1,11 @@
+class TicketMailer < ApplicationMailer
+  def reply(comment)
+    @comment = comment
+    ticket = comment.ticket
+    # Prevent vacation responders from generating another support conversation.
+    headers["Auto-Submitted"] = "auto-generated"
+    headers["X-Auto-Response-Suppress"] = "All"
+    mail(to: ticket.requester.email, from: ticket.account.support_address,
+      reply_to: ticket.reply_address, subject: "Re: #{ticket.subject}")
+  end
+end
