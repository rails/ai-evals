+    assert_equal 1, Ticket.count
+    assert_equal 1, ProcessedEmail.count
+    ticket = @business.tickets.sole
+    id = "reply-retry@example.test"
+    assert_ignored(rfc822(to: ticket.reply_address, id: id, from: "intruder@example.test"))
+    receive_mail(rfc822(to: ticket.reply_address, id: id))
+    assert_equal 2, ticket.comments.count
+  end
+
+  test "an identical payload can be retried after a cancelled account is reactivated" do
+    @business.update!(cancelled_at: Time.current)
