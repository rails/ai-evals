diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..930ce73
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,43 @@
+module Api
+  module V1
+    class AccountsController < BaseController
+      skip_around_action :with_account, only: :create
+      skip_before_action :authenticate!, only: %i[create portal]
+      skip_before_action :require_active_account!, only: %i[create cancel reactivate]
+      before_action :require_owner!, only: %i[cancel reactivate]
+
+      def create
+        attributes = params.expect(account: [:name, :subdomain, admin: [:name, :email, :password]])
+        admin = attributes.require(:admin)
+        ensure_string_fields!(admin)
+        attributes = attributes.except(:admin)
+        ensure_string_fields!(attributes)
+        account, user, token = Account.transaction do
+          account = Account.create!(attributes)
+          user = account.users.create!(admin.merge(role: "admin", owner: true))
+          [account, user, user.issue_verification!]
+        end
+        UserMailer.verification(user, token).deliver_now
+        render json: { account: ApiRepresentation.account(account), user: ApiRepresentation.user(user) }, status: :created
+      end
+
+      def portal
+        render json: { portal: current_account.as_json(only: %i[name subdomain]) }
+      end
+
+      def show
+        render json: { account: ApiRepresentation.account(current_account) }
+      end
+
+      def cancel
+        current_account.cancel!
+        render json: { account: ApiRepresentation.account(current_account) }
+      end
+
+      def reactivate
+        current_account.reactivate!
+        render json: { account: ApiRepresentation.account(current_account) }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/base_controller.rb b/app/controllers/api/v1/base_controller.rb
new file mode 100644
index 0000000..a947608
--- /dev/null
+++ b/app/controllers/api/v1/base_controller.rb
@@ -0,0 +1,104 @@
+module Api
+  module V1
+    class BaseController < ApplicationController
+      # Consistent lock ordering (account before user/session) also serializes
+      # authentication with cancellation, password changes and the purge task.
+      around_action :with_account
+      before_action :authenticate!
+      before_action :require_active_account!
+
+      private
+
+      attr_reader :current_account, :current_user, :current_session
+
+      def with_account
+        subdomain = request.headers["X-Helpdesk-Account"].to_s.strip.downcase
+        if subdomain.blank?
+          raise ApiError.new(:bad_request, "account_required", "Provide X-Helpdesk-Account.")
+        end
+        @current_account = Account.find_by!(subdomain: subdomain)
+        current_account.with_lock { yield }
+      end
+
+      def authenticate!
+        token = request.authorization.to_s.match(/\ABearer ([A-Za-z0-9_-]{43})\z/i)&.captures&.first
+        @current_session = current_account.sessions.active.find_by(token_digest: Session.digest(token)) if token
+        @current_user = current_session&.user
+        unless current_user&.verified? && !current_user.suspended?
+          raise ApiError.new(:unauthorized, "unauthorized", "A valid bearer token is required.")
+        end
+      end
+
+      def require_active_account!
+        if current_account.cancelled?
+          raise ApiError.new(:forbidden, "account_cancelled", "This account is cancelled. Its owner may sign in to reactivate it within 90 days.")
+        end
+      end
+
+      def require_admin!
+        unless current_user.admin?
+          raise ApiError.new(:forbidden, "admin_required", "Only admins can manage people.")
+        end
+      end
+
+      def require_staff!
+        unless current_user.staff?
+          raise ApiError.new(:forbidden, "staff_required", "Only staff can access this resource.")
+        end
+      end
+
+      def filter_parameter(name, allowed)
+        return unless params.key?(name)
+        value = params[name]
+        unless value.is_a?(String) && allowed.include?(value)
+          raise ApiError.new(:bad_request, "invalid_filter", "Invalid #{name} filter.")
+        end
+        value
+      end
+
+      def valid_id?(value)
+        value.is_a?(Integer) && value.positive? && value <= 9_223_372_036_854_775_807
+      end
+
+      def id_filter_parameter(name, unassigned: false)
+        value = params[name]
+        return nil if unassigned && value == "unassigned"
+        unless value.is_a?(String) && value.match?(/\A[1-9][0-9]{0,18}\z/) && valid_id?(value.to_i)
+          raise ApiError.new(:bad_request, "invalid_filter", "Invalid #{name} filter.")
+        end
+        value.to_i
+      end
+
+      def require_owner!
+        unless current_user.owner?
+          raise ApiError.new(:forbidden, "owner_required", "Only the account owner can perform this action.")
+        end
+      end
+
+      def string_fields(envelope, *fields)
+        attributes = params.expect(envelope => fields)
+        ensure_string_fields!(attributes)
+        attributes
+      end
+
+      def ensure_string_fields!(attributes)
+        unless attributes.values.all? { |value| value.nil? || value.is_a?(String) }
+          raise ActionController::BadRequest
+        end
+      end
+
+      def recovery_allowed?(user)
+        user && !user.suspended? && (!current_account.cancelled? || (user.owner? && !current_account.retention_expired?))
+      end
+
+      def link_user!(token, digest_column:, expires_column:)
+        if token.present? && token.length <= 128
+          user = current_account.users.where("#{expires_column} > ?", Time.current)
+            .find_by(digest_column => Session.digest(token))
+          return user if recovery_allowed?(user)
+        end
+        raise ApiError.new(:unprocessable_entity, "invalid_token", "This link is invalid or has expired.")
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/conversations_controller.rb b/app/controllers/api/v1/conversations_controller.rb
new file mode 100644
index 0000000..36216ee
--- /dev/null
+++ b/app/controllers/api/v1/conversations_controller.rb
@@ -0,0 +1,86 @@
+module Api
+  module V1
+    # Shared mechanics; subclasses supply the audience and tenant-scoped records.
+    class ConversationsController < BaseController
+      include Pagination
+
+      def index
+        scope = filtered_tickets
+        scope = current_user.customer? ? scope.recently_customer_active : scope.recently_active
+        render json: paginated(scope.includes(:requester, :assignee, :group), resource_name.to_s.pluralize,
+          cursor_order: { created_at: :desc, id: :desc }) { |ticket| representation(ticket) }
+      end
+
+      def show
+        render json: { resource_name => representation(find_ticket) }
+      end
+
+      def update
+        ticket = find_ticket
+        ticket.update_conversation!(author: current_user, attributes: conversation_attributes)
+        render json: { resource_name => representation(ticket) }
+      end
+
+      def comments
+        scope = find_ticket.comments
+        scope = scope.publicly_visible if current_user.customer?
+        render json: paginated(scope.oldest_first.includes(:author), :comments,
+          cursor_order: { created_at: :asc, id: :asc }) { |comment| ApiRepresentation.comment(comment) }
+      end
+
+      private
+
+      def filtered_tickets
+        status = filter_parameter(:status, Ticket::STATUSES)
+        scope = visible_tickets
+        status ? scope.where(status: status) : scope
+      end
+
+      def find_ticket
+        visible_tickets.find(params[:id])
+      end
+
+      def representation(ticket)
+        resource_name == :ticket ? ApiRepresentation.ticket(ticket) : ApiRepresentation.request(ticket)
+      end
+
+      def conversation_attributes(creating: false)
+        envelope = params.require(resource_name)
+        raise ActionController::BadRequest unless envelope.is_a?(ActionController::Parameters)
+
+        fields = creating ? [:subject] : [:status]
+        fields << :priority if !creating && current_user.staff?
+        attributes = fields.each_with_object({}) do |field, permitted|
+          permitted[field] = envelope[field] if envelope.key?(field)
+        end
+        ensure_string_fields!(attributes)
+        if !creating && current_user.staff?
+          %i[assignee_id group_id].each do |field|
+            next unless envelope.key?(field)
+            id = envelope[field]
+            raise ActionController::BadRequest unless id.nil? || valid_id?(id)
+            attributes[field] = id
+          end
+        end
+        if envelope.key?(:comment)
+          comment = envelope[:comment]
+          raise ActionController::BadRequest unless comment.is_a?(ActionController::Parameters)
+          attributes[:comment] = { body: comment[:body] }
+          ensure_string_fields!(attributes[:comment])
+          if current_user.staff? && comment.key?(:public)
+            unless [true, false].include?(comment[:public])
+              raise ActionController::BadRequest
+            end
+            attributes[:comment][:public] = comment[:public]
+          end
+        elsif creating
+          raise ActionController::ParameterMissing, :comment
+        end
+        if !creating && attributes.empty?
+          raise ActionController::BadRequest
+        end
+        attributes
+      end
+    end
+  end
+end
