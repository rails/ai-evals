+    assert ticket_queries.any? { |statement| statement.include?('("tickets"."created_at", "tickets"."id") <') }
+    assert ticket_queries.any? { |statement| statement.include?('("tickets"."created_at", "tickets"."id") >') }
+    assert ticket_queries.all? { |statement| statement.include?("LIMIT") }
