+      password: PASSWORD, role: "customer", suspended: true)
+    assert_ignored(rfc822(from: customer.email))
+    assert_ignored(rfc822(from: ["one@example.test", "two@example.test"]))
+    assert_ignored(rfc822(from: nil))
+    assert_ignored(rfc822(from: "not-an-email"))
+    assert_ignored(rfc822(from: @business.support_address))
+  end
+
+  test "automated and list mail is silently ignored without sending verification or reserving ids" do
+    [
+      { "Auto-Submitted" => "auto-replied" },
+      { "Auto-Submitted" => "auto-generated; owner-email=bot@example.test" },
+      { "Precedence" => "bulk" }, { "Precedence" => "list" }, { "Precedence" => "junk" },
+      { "List-Id" => "customers.example.test" }, { "List-Unsubscribe" => "<mailto:unsubscribe@example.test>" },
+      { "X-Autoreply" => "yes" }, { "X-Autorespond" => "yes" }, { "Return-Path" => "<>" }
