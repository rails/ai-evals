+require "test_helper"
+
+class UserMailerTest < ActiveSupport::TestCase
+  test "both emails use the configured sender and frontend URL with the correct account and token" do
+    settings = Rails.application.config.x.helpdesk
+    original_url, original_sender = settings.frontend_url, settings.mail_from
+    settings.frontend_url = "https://frontend.example.test:444/app"
