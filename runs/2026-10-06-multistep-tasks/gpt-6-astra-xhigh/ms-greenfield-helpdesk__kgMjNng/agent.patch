+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      skip_before_action :authenticate!, :require_active_account!
+
+      def create
+        attributes = string_fields(:email_verification, :email)
+        user = current_account.users.find_by(email: attributes[:email].to_s.strip.downcase)
+        if recovery_allowed?(user) && !user.verified?
+          UserMailer.verification(user, user.issue_verification!).deliver_now
