diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..c5d7768
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,61 @@
+class Account < ApplicationRecord
+  RETENTION_PERIOD = 90.days
+
+  has_many :processed_emails, dependent: :delete_all
+  has_many :invitations, dependent: :destroy
+  has_many :tickets, dependent: :destroy
+  has_many :groups, dependent: :destroy
+  has_many :group_memberships, dependent: :destroy
+  has_many :users, dependent: :destroy
+  has_many :sessions, through: :users
+  has_one :owner, -> { where(owner: true) }, class_name: "User"
+
+  normalizes :name, with: ->(value) { value.strip }
+  normalizes :subdomain, with: ->(value) { value.strip.downcase }
+  validates :name, presence: true, length: { maximum: 100 }
+  validates :subdomain, presence: true, length: { maximum: 63 },
+    format: { with: /\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z/ },
+    uniqueness: { case_sensitive: false }
+
+  def support_address
+    "#{subdomain}@#{Rails.application.config.x.helpdesk.support_domain}"
+  end
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def reactivation_deadline
+    cancelled_at && cancelled_at + RETENTION_PERIOD
+  end
+
+  def retention_expired?(at: Time.current)
+    cancelled? && reactivation_deadline <= at
+  end
+
+  # Call under the account row lock, shared by all account API requests.
+  def cancel!
+    update!(cancelled_at: Time.current) unless cancelled?
+    Session.where(user_id: users.select(:id)).delete_all
+  end
+
+  def reactivate!
+    raise ApiError.new(:forbidden, "reactivation_expired", "The 90-day reactivation period has ended.") if retention_expired?
+    update!(cancelled_at: nil) if cancelled?
+  end
+
+  def self.purge_cancelled!(at: Time.current)
+    count = 0
+    where(cancelled_at: ..(at - RETENTION_PERIOD)).find_each do |account|
+      transaction do
+        # Recheck after locking: reactivation and cleanup cannot race.
+        locked_account = lock.find_by(id: account.id)
+        if locked_account&.retention_expired?(at: at)
+          locked_account.destroy!
+          count += 1
+        end
+      end
+    end
+    count
+  end
+end
