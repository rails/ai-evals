+++ b/config/initializers/smtp.rb
@@ -0,0 +1,16 @@
+# Development writes mail to tmp/mails; test uses Action Mailer deliveries.
+# Production uses SMTP (localhost:25 by default), configurable without code changes.
+if Rails.env.production?
+  Rails.application.config.action_mailer.delivery_method = :smtp
+  Rails.application.config.action_mailer.smtp_settings = {
+    address: ENV.fetch("SMTP_ADDRESS", "localhost"),
+    port: ENV.fetch("SMTP_PORT", "25").to_i,
+    domain: ENV.fetch("SMTP_DOMAIN", "localhost"),
+    enable_starttls_auto: true
+  }
+  if ENV["SMTP_USERNAME"].present?
+    Rails.application.config.action_mailer.smtp_settings.merge!(
+      user_name: ENV["SMTP_USERNAME"], password: ENV["SMTP_PASSWORD"], authentication: :plain
+    )
+  end
+end
