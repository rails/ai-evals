diff --git a/spec/support/model_spec_setup.rb b/spec/support/model_spec_setup.rb
new file mode 100644
index 0000000..28d3bcb
--- /dev/null
+++ b/spec/support/model_spec_setup.rb
@@ -0,0 +1,20 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # Most model examples only need to enqueue jobs, not run unrelated callbacks.
+  # Opt in when asserting a worker's effects. The block restores the previous mode
+  # even on failure; rspec-sidekiq clears queued jobs before each example.
+  config.around :each, type: :model do |example|
+    Sidekiq.testing!(example.metadata[:inline_jobs] ? :inline : :fake) { example.run }
+  end
+
+  # Debug SQL logging includes an expensive source-location backtrace for every
+  # query. Keep warnings/errors, and restore the logger after each model example.
+  config.around :each, type: :model do |example|
+    if example.metadata[:verbose_logging]
+      example.run
+    else
+      Rails.logger.silence(Logger::WARN) { example.run }
+    end
+  end
+end
