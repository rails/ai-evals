@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+# Profile Fabrication calls in exactly one supported spec directory.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+if [[ $# -lt 1 || $# -gt 2 ]]; then
+  echo "Usage: $0 {models|requests} [run-label]" >&2
+  exit 1
+fi
+case "$1" in
+  models|requests) group=$1 ;;
+  *) echo 'Choose exactly one directory: models or requests.' >&2; exit 1 ;;
+esac
+export FPROF=json
+exec "docs/profile-$group.sh" "${2:-factories}"
