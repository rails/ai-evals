diff --git a/spec/support/model_spec_setup.rb b/spec/support/model_spec_setup.rb
new file mode 100644
index 0000000..dfc0aeb
--- /dev/null
+++ b/spec/support/model_spec_setup.rb
@@ -0,0 +1,18 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  config.around :each, type: :model do |example|
+    # SQL caller backtraces are costly in setup-heavy model specs. Keep normal
+    # SQL logging, with an opt-in for debugging an individual example.
+    verbose_query_logs = ActiveRecord.verbose_query_logs
+    ActiveRecord.verbose_query_logs = example.metadata.fetch(:verbose_query_logs, false)
+
+    # Most model examples test persistence, not the workers triggered by callbacks.
+    # Opt in when an assertion depends on a job's effects (e.g. media processing).
+    Sidekiq.testing!(example.metadata[:inline_jobs] ? :inline : :fake) do
+      example.run
+    end
+  ensure
+    ActiveRecord.verbose_query_logs = verbose_query_logs
+  end
+end
