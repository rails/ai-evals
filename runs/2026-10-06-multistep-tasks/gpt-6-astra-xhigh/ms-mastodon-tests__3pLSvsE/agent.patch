@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+# Run one spec directory only. Optional TEST_STACK_PROF=1 enables wall sampling.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+label=${1:-models}
+if [[ ! "$label" =~ ^[a-zA-Z0-9_-]+$ ]]; then
+  echo 'Use an alphanumeric run label (hyphens/underscores allowed).' >&2
+  exit 1
+fi
+output="tmp/model-profile/$label"
+mkdir -p "$output"
+export MODEL_PROFILE_OUTPUT="$output"
+export TEST_STACK_PROF_MODE=wall
+export TEST_STACK_PROF_RAW=0
+export TEST_STACK_PROF_INTERVAL=10000
+TIMEFORMAT='Wall time: %3R seconds; user: %3U seconds; system: %3S seconds'
+set +e
+{
+  time bundle exec rspec spec/models \
+    --require ./docs/model_profile.rb \
+    --seed "${SEED:-12345}" --profile 15 \
+    --format progress --out "$output/rspec.log" \
+    --format json --out "$output/rspec.json"
+} 2> "$output/process.log"
+status=$?
+set -e
+cat "$output/process.log"
+tail -65 "$output/rspec.log"
+if [[ -s "$output/rspec.json" ]]; then
+  ruby -rjson - "$output/rspec.json" <<'RUBY_REPORT' | tee "$output/summary.txt"
+report = JSON.parse(File.read(ARGV.fetch(0)))
+puts report.fetch('summary').inspect
+puts "\nSlowest examples:"
+report.fetch('examples').sort_by { |example| -example.fetch('run_time') }.first(15).each do |example|
+  puts format('%.3fs %s', example.fetch('run_time'), example.fetch('full_description'))
+end
+RUBY_REPORT
+fi
+exit "$status"
+
