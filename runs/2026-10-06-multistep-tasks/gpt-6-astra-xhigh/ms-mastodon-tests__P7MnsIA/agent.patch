+fi
+if [[ "${VERIFY_SETUP:-0}" == "1" ]]; then
+  options+=(--require ./docs/performance/verify_request_setup.rb)
+fi
+# Setup isolation checks must register their outer hooks before loading Rails.
+if [[ "${VERIFY_FACTORIES:-0}" == "1" ]]; then
+  options+=(--require ./docs/performance/verify_factories.rb)
