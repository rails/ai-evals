diff --git a/test/models/prizes_test.rb b/test/models/prizes_test.rb
new file mode 100644
index 0000000..c97e452
--- /dev/null
+++ b/test/models/prizes_test.rb
@@ -0,0 +1,180 @@
+require "test_helper"
+
+class PrizesTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+
+  setup do
+    @quiz = Quiz.create!(title: "Prizes", number_of_winners: 2)
+    2.times do |index|
+      @quiz.questions.create!(body: "Question #{index}", position: index + 1,
+        options: [ { text: "Yes", correct: true }, { text: "Also yes", correct: true }, { text: "No", correct: false } ])
+    end
+    @game = Game.for_quiz!(@quiz)
+    @players = %w[Ace Bee Cat Dee Zero].map { |name| @game.join!(name, name) }
+    @start = Time.utc(2026, 10, 8, 12)
+  end
+
+  test "winner count defaults to three, validates integers, and is snapshotted" do
+    assert_equal 3, Quiz.new.number_of_winners
+    [ nil, 0, -1, 1.5, "abc", "" ].each do |invalid|
+      @quiz.number_of_winners = invalid
+      assert_not @quiz.valid?, "accepted #{invalid.inspect}"
+    end
+    @quiz.update!(number_of_winners: 5)
+    assert_equal 2, @game.number_of_winners
+    assert_equal 5, Game.for_quiz!(@quiz).number_of_winners
+  end
+
+  test "points then total correct answer time use the last pick, even for the same option" do
+    play_game
+    results = @game.leaderboard
+    assert_equal %w[Ace Cat Dee Bee Zero], results.map { |entry| entry.player.name }
+    assert_equal [ 2, 1, 1, 1, 0 ], results.map(&:points)
+    assert_equal [ 1, 2, 3, 4, 5 ], results.map(&:place)
+    assert_equal [ 15_000_000, 3_000_000, 4_000_000, 8_000_000, 0 ], results.map(&:elapsed_microseconds)
+    assert_equal @start, @game.game_questions.first.opened_at
+    assert_equal @start + 8, @players[1].answers.first.picked_at
+  end
+
+  test "total time, not the last question alone, breaks ties at microsecond precision" do
+    at(0) { @game.advance!("start", 0) }
+    question = @game.current_question
+    at(1 + Rational(1, 1_000_000)) { @game.answer!(@players[0], question.id, 0) }
+    at(8) { @game.answer!(@players[1], question.id, 0) }
+    at(8) { @game.answer!(@players[2], question.id, 1) }
+    at(10) { @game.advance!("finish", 1) }
+    at(20) { @game.advance!("next", 2) }
+    question = @game.current_question
+    at(27 + Rational(1, 1_000_000)) { @game.answer!(@players[0], question.id, 0) }
+    at(21) { @game.answer!(@players[1], question.id, 0) }
+    at(21) { @game.answer!(@players[2], question.id, 0) }
+    at(30) { @game.advance!("finish", 3) }
+    at(31) { @game.advance!("end", 4) }
+    assert_equal %w[Ace Bee Cat Dee Zero], @game.leaderboard.map { |entry| entry.player.name }
+    assert_equal [ 8_000_002, 9_000_000, 9_000_000, 0, 0 ], @game.leaderboard.map(&:elapsed_microseconds)
+    # A full tie uses join order, not an unstable SQL or Ruby enumeration order.
+    assert_equal [ 1, 2, 3, 4, 5 ], @game.leaderboard.map(&:place)
+  end
+
+  test "a single prize draws from the highest points tie, not the fastest player" do
+    play_game
+    @game.update!(number_of_winners: 1)
+    %w[top draw].each do |strategy|
+      @game.select_winners!(strategy)
+      assert_equal [ "Ace" ], winners
+    end
+    # Remove Ace's second correct point: four people now tie for one prize.
+    @players.first.answers.order(:game_question_id).last.update!(option_index: 2)
+    drawn = 30.times.map do |seed|
+      @game.select_winners!("draw", random: Random.new(seed))
+      assert_equal 1, winners.size
+      winners.first
+    end
+    assert_equal %w[Ace Bee Cat Dee], drawn.uniq.sort
+  end
+
+  test "top winners use the leaderboard and reset is persisted and broadcast" do
+    play_game
+    stream = "game:#{@game.id}:public"
+    revision = @game.revision
+    assert_broadcast_on(stream, changed: true) { @game.select_winners!("top") }
+    assert_equal %w[Ace Cat], winners
+    assert_equal revision + 1, @game.reload.revision
+    assert_broadcast_on(stream, changed: true) { @game.select_winners!("reset") }
+    assert_empty winners
+    assert_equal revision + 2, @game.reload.revision
+  end
+
+  test "draw keeps everyone above the points cutoff and samples the entire tie regardless of speed" do
+    play_game
+    drawn = []
+    30.times do |seed|
+      @game.select_winners!("draw", random: Random.new(seed))
+      selected = winners
+      assert_equal 2, selected.size
+      assert_includes selected, "Ace"
+      assert_empty selected & [ "Zero" ]
+      drawn.concat(selected - [ "Ace" ])
+    end
+    assert_equal %w[Bee Cat Dee], drawn.uniq.sort
+    @game.select_winners!("top")
+    assert_equal %w[Ace Cat], winners
+  end
+
+  test "fewer scoring players than prizes all win but zero points never win" do
+    play_game
+    @game.update!(number_of_winners: 10)
+    %w[top draw].each do |strategy|
+      @game.select_winners!(strategy)
+      assert_equal %w[Ace Bee Cat Dee], winners
+    end
+  end
+
+  test "empty games and games with only zero points have no winners" do
+    empty = Game.for_quiz!(Quiz.create!(title: "Empty"))
+    empty.advance!("start", 0)
+    %w[top draw reset].each do |strategy|
+      empty.select_winners!(strategy)
+      assert_empty empty.leaderboard
+    end
+    @game.advance!("start", 0)
+    @game.advance!("finish", 1)
+    @game.advance!("next", 2)
+    @game.advance!("finish", 3)
+    @game.advance!("end", 4)
+    %w[top draw reset].each do |strategy|
+      @game.select_winners!(strategy)
+      assert_empty winners
+    end
+    assert_equal @players.map(&:id), @game.leaderboard.map { |entry| entry.player.id }
+  end
+
+  test "winner selection only accepts known commands on ended games" do
+    assert_raises(Game::Conflict) { @game.select_winners!("top") }
+    play_game
+    assert_raises(Game::Conflict) { @game.select_winners!("anything") }
+    assert_empty winners
+  end
+
+  test "a stale answer cannot change its timestamp after Finish" do
+    at(0) { @game.advance!("start", 0) }
+    question = @game.current_question
+    at(1) { @game.answer!(@players.first, question.id, 0) }
+    at(2) { @game.advance!("finish", 1) }
+    at(3) { assert_raises(Game::Conflict) { @game.answer!(@players.first, question.id, 1) } }
+    assert_equal @start + 1, @players.first.answers.first.picked_at
+    assert_equal @start, question.reload.opened_at
+  end
+
+  private
+
+  def at(seconds, &block)
+    travel_to(@start + seconds, with_usec: true, &block)
+  end
+
+  def play_game
+    at(0) { @game.advance!("start", 0) }
+    question = @game.current_question
+    # Bee's first correct pick is fast, but the last pick must count.
+    at(1) { @game.answer!(@players[1], question.id, 0) }
+    at(3) { @game.answer!(@players[2], question.id, 1) }
+    at(4) { @game.answer!(@players[3], question.id, 0) }
+    at(5) { @game.answer!(@players[0], question.id, 0) }
+    at(8) { @game.answer!(@players[1], question.id, 0) }
+    at(9) { @game.answer!(@players[4], question.id, 0) }
+    at(10) { @game.answer!(@players[4], question.id, 2) }
+    at(11) { @game.advance!("finish", 1) }
+    at(20) { @game.advance!("next", 2) }
+    question = @game.current_question
+    # Wrong answers and skipped questions don't enter the time tiebreaker.
+    at(21) { @game.answer!(@players[1], question.id, 2) }
+    at(30) { @game.answer!(@players[0], question.id, 0) }
+    at(40) { @game.answer!(@players[3], question.id, 2) }
+    at(41) { @game.advance!("finish", 3) }
+    at(42) { @game.advance!("end", 4) }
+  end
+
+  def winners
+    @game.players.where(winner: true).order(:name).pluck(:name)
+  end
+end
