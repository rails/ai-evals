@@ -0,0 +1,187 @@
+#!/usr/bin/env ruby
+# Runs against bin/serve: real production WebSockets, no browser reloads for updates.
+require "bundler/setup"
+require "capybara/cuprite"
+require "fileutils"
+
+Capybara.register_driver(:prizes_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app,
+    browser_path: "/usr/bin/chromium", window_size: [ 1440, 1000 ],
+    browser_options: { "no-sandbox" => nil, "disable-dev-shm-usage" => nil },
+    timeout: 15, process_timeout: 30, js_errors: true)
+end
+Capybara.default_max_wait_time = 5
+Capybara.enable_aria_label = true
+Capybara.run_server = false
+Capybara.app_host = ENV.fetch("APP_URL", "http://127.0.0.1:3000")
+FileUtils.mkdir_p("storage/screenshots")
+
+def verify(message)
+  raise message unless yield
+  puts "PASS: #{message}"
+end
+
+def observe(page)
+  page.execute_script <<~JS
+    window.liveSentinel = 'still-here';
+    window.shownAt = {};
+    new MutationObserver(() => {
+      const revision = document.querySelector('.game-panel').dataset.revision;
+      window.shownAt[revision] ||= Date.now();
+    }).observe(document.querySelector('#live-state'), {childList: true});
+    document.addEventListener('submit', () => { window.submittedAt = Date.now(); }, true);
+  JS
+end
+
+def revision(page)
+  page.find(".game-panel")["data-revision"].to_i
+end
+
+def pick(page, option)
+  page.click_button option, exact: false
+  page.within("button.play-option", text: option) { page.assert_text "Your answer" }
+end
+
+moderator, stage, *phones = Array.new(7) { Capybara::Session.new(:prizes_chromium) }
+all_sessions = [ moderator, stage, *phones ]
+names = %w[Ace Bee Cat Dee Zero]
+begin
+  [ moderator, stage ].each do |page|
+    page.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "test-password"))
+  end
+  moderator.visit "/moderate"
+  moderator.click_link "New quiz"
+  moderator.assert_selector :field, "Number of winners", with: "3"
+  moderator.fill_in "Title", with: "Prizes verification #{Process.pid}"
+  moderator.fill_in "Number of winners", with: 2
+  moderator.click_button "Save quiz"
+  quiz_url = moderator.current_url
+  moderator.click_link "Settings"
+  moderator.assert_selector :field, "Number of winners", with: "2"
+  moderator.click_button "Save quiz"
+  2.times do |index|
+    moderator.click_link "Add question"
+    moderator.fill_in "Question", with: "Prize question #{index + 1}"
+    moderator.fill_in "Option 1", with: "Yes"
+    moderator.fill_in "Option 2", with: "No"
+    moderator.check "Option 1 is correct"
+    moderator.click_button "Save question"
+  end
+  moderator.click_button "Start a game"
+  game_url = moderator.current_url
+  join_url = moderator.find("[data-join-url]").text
+  stage.visit game_url
+  phones.zip(names).each do |phone, name|
+    phone.driver.resize(390, 844)
+    phone.visit join_url
+    phone.fill_in "Your name", with: name
+    phone.click_button "Join"
+    phone.assert_text "Hi, #{name}!"
+  end
+  all_sessions.each do |page|
+    page.assert_selector "[data-connection-status]", exact_text: "Live"
+    observe(page)
+  end
+  moderator.assert_text "Players: 5"
+  moderator.click_button "Start"
+  stage.assert_text "Prize question 1"
+  phones.each { |phone| phone.assert_text "Prize question 1" }
+  started_at = moderator.evaluate_script("window.submittedAt")
+  latencies = [ stage, *phones ].map { |page| page.evaluate_script("window.shownAt['1']") - started_at }
+  puts "Question arrival times after Start (ms): #{latencies.inspect}"
+  verify("all screens receive the question within 1.5 seconds") { latencies.all? { |ms| ms.between?(0, 1500) } }
+
+  # Bee is initially fastest, then changes their answer last. Last-pick speed wins.
+  pick(phones[1], "Yes")
+  sleep 0.15
+  pick(phones[2], "Yes")
+  sleep 0.15
+  pick(phones[3], "Yes")
+  pick(phones[0], "Yes")
+  pick(phones[1], "No")
+  pick(phones[1], "Yes")
+  pick(phones[4], "No")
+  moderator.assert_text "Answers: 5 / 5"
+  moderator.click_button "Finish"
+  phones.first.assert_text "Correct!"
+  phones.each { |phone| phone.assert_no_text(/\d+ points?/) }
+  moderator.click_button "Next"
+  phones.each { |phone| phone.assert_text "Prize question 2" }
+  pick(phones[0], "Yes")
+  moderator.assert_text "Answers: 1 / 5"
+  moderator.click_button "Finish"
+  moderator.click_button "End quiz"
+  expected = %w[Ace Cat Dee Bee Zero]
+  [ moderator, stage ].each do |page|
+    page.assert_selector "ol.leaderboard > li", count: 5
+    verify("leaderboard orders points then last-pick speed") do
+      page.all("li.leader .leader__name").map(&:text) == expected
+    end
+    page.assert_selector "li.leader", text: /Ace.*2 points/m
+    page.assert_selector "li.leader", text: /Cat.*1 point/m
+    page.assert_selector "li.leader", text: /Zero.*0 points/m
+  end
+  phones.zip(names).each do |phone, name|
+    phone.assert_text "Place #{expected.index(name) + 1} of 5"
+    phone.assert_text(name == "Ace" ? "2 points" : (name == "Zero" ? "0 points" : "1 point"))
+    phone.assert_no_text "You won!"
+    phone.assert_selector "[data-connection-status]", exact_text: "Live"
+  end
+  moderator.click_button "Top 2"
+  [ moderator, stage ].each { |page| page.assert_selector "li.is-winner", count: 2 }
+  phones[0].assert_text "You won!"
+  phones[2].assert_text "You won!"
+  [ phones[1], phones[3], phones[4] ].each { |page| page.assert_no_text "You won!" }
+  moderator.save_screenshot("storage/screenshots/prize-leaderboard.png", full: true)
+  phones[2].save_screenshot("storage/screenshots/prize-phone.png", full: true)
+
+  5.times do
+    previous = revision(moderator)
+    moderator.click_button "Draw"
+    [ moderator, stage, *phones ].each do |page|
+      page.assert_selector ".game-panel[data-revision='#{previous + 1}']"
+    end
+    selected = moderator.all("li.is-winner .leader__name").map { |node| node.text.sub(/\s+Winner\z/, "") }
+    verify("draw keeps the higher scorer and chooses exactly one positive-points tie") do
+      selected.size == 2 && selected.include?("Ace") && !selected.include?("Zero")
+    end
+    phones.zip(names).each do |phone, name|
+      selected.include?(name) ? phone.assert_text("You won!") : phone.assert_no_text("You won!")
+    end
+  end
+  previous = revision(moderator)
+  moderator.execute_script("for (let i = 0; i < 3; i++) document.getElementById('winners-draw').click()")
+  all_sessions.each do |page|
+    page.assert_selector ".game-panel[data-revision='#{previous + 3}']"
+  end
+  verify("three rapid Draw clicks each create a fresh draw") { true }
+  moderator.click_button "Reset winners"
+  [ moderator, stage ].each { |page| page.assert_no_selector "li.is-winner" }
+  phones.each { |phone| phone.assert_no_text "You won!" }
+  verify("question and prize updates never navigate any screen") do
+    all_sessions.all? { |page| page.evaluate_script("window.liveSentinel") == "still-here" }
+  end
+  # Reloading an ended screen must subscribe, not just display a frozen result.
+  phones[2].visit join_url
+  stage.visit game_url
+  [ phones[2], stage ].each { |page| page.assert_selector "[data-connection-status]", exact_text: "Live" }
+  moderator.click_button "Top 2"
+  phones[2].assert_text "You won!"
+  stage.assert_selector "li.is-winner", count: 2
+  moderator.click_button "Reset winners"
+  phones[2].assert_no_text "You won!"
+  stage.assert_no_selector "li.is-winner"
+  verify("mobile results have no horizontal overflow") do
+    phones.all? { |page| page.evaluate_script("document.documentElement.scrollWidth <= innerWidth") }
+  end
+  moderator.visit quiz_url
+  moderator.click_link "Settings"
+  moderator.accept_confirm { moderator.click_button "Delete quiz" }
+  puts "Prize browser smoke test completed."
+rescue StandardError
+  moderator.save_screenshot("storage/screenshots/prizes-failure.png", full: true)
+  warn moderator.current_url
+  raise
+ensure
+  all_sessions.each { |page| page.driver.quit }
+end
