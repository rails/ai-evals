+  moderator.click_button "Next"
+  moderator.assert_selector "[data-countdown]", text: "0:05"
+  moderator.assert_selector :button, "End quiz", wait: 7
+  player.assert_text "No answer"
+  moderator.click_button "End quiz"
+  puts "PASS: automatic Finish reveals results, locks phones and does not skip questions"
+
+  moderator.visit quiz_url
+  moderator.click_link "Settings"
+  moderator.fill_in "Timer seconds", with: 0
+  moderator.click_button "Save quiz"
+  moderator.click_button "Start a game"
+  moderator.click_button "Start"
+  sleep 6
+  moderator.assert_selector :button, "Finish"
+  moderator.assert_no_selector "[data-countdown]"
+  puts "PASS: 0 minutes and 0 seconds leaves the question open without a countdown"
+
+  moderator.visit quiz_url
+  moderator.click_link "Settings"
+  moderator.accept_confirm { moderator.click_button "Delete quiz" }
+  puts "PASS: timer browser checks complete; temporary quiz removed"
+ensure
+  [ moderator, player ].each { |page| page.driver.quit }
+end
diff --git a/script/browser_transfer_smoke.rb b/script/browser_transfer_smoke.rb
new file mode 100755
index 0000000..eca7df2
--- /dev/null
+++ b/script/browser_transfer_smoke.rb
@@ -0,0 +1,157 @@
+#!/usr/bin/env ruby
+# Run against bin/serve. No database shortcuts: create, transfer, and clean up via the UI.
+require "bundler/setup"
+require "capybara/cuprite"
+require "fileutils"
+require "json"
+
+Capybara.register_driver(:transfer_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app,
+    browser_path: "/usr/bin/chromium", window_size: [ 1440, 1000 ],
+    browser_options: { "no-sandbox" => nil, "disable-dev-shm-usage" => nil },
+    timeout: 15, process_timeout: 30, js_errors: true)
+end
+Capybara.default_max_wait_time = 5
+Capybara.enable_aria_label = true
+Capybara.run_server = false
+Capybara.app_host = ENV.fetch("APP_URL", "http://127.0.0.1:3000")
+page = Capybara::Session.new(:transfer_chromium)
+FileUtils.mkdir_p("storage/screenshots")
+
+payload = {
+  "title" => "Transfer check #{Process.pid} — 日本語 🎉",
+  "number_of_winners" => 3,
+  "questions" => [
+    { "text" => 'Which HTTP status code means "Too Many Requests"?', "active" => true,
+      "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true }, { "text" => "503", "correct" => false } ] },
+    { "text" => 'Literal text: </pre><script>window.injected = true</script> & "café"', "active" => false,
+      "options" => [ { "text" => "Ruby", "correct" => true }, { "text" => "Python", "correct" => true }, { "text" => "HTML", "correct" => false } ] }
+  ]
+}
+created_urls = []
+
+def verify(message)
+  raise message unless yield
+  puts "PASS: #{message}"
+end
+
+def read_export(page)
+  page.click_link "Export"
+  page.assert_selector "pre", count: 1
+  page.find("pre").text(normalize_ws: false)
+end
+
+def open_import(page)
+  page.visit "/moderate"
+  page.click_button "Import quiz"
+  page.assert_selector "h1", text: "Import quiz"
+end
+
+begin
+  page.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "test-password"))
+  page.visit "/moderate"
+  original_count = page.all("li.quiz-list-item").size
+  page.click_link "New quiz"
+  page.fill_in "Title", with: payload["title"]
+  page.click_button "Save quiz"
+  page.assert_selector "h1", text: payload["title"]
+  original_url = page.current_url
+  created_urls << original_url
+  payload["questions"].each do |question|
+    page.click_link "Add question"
+    page.fill_in "Question", with: question["text"]
+    question["options"].each_with_index do |option, index|
+      page.fill_in "Option #{index + 1}", with: option["text"]
+      page.check "Option #{index + 1} is correct" if option["correct"]
+    end
+    page.uncheck "Active" unless question["active"]
+    page.click_button "Save question"
+    page.assert_selector "li.question-item", text: question["text"]
+  end
+  # Export the order visible in the editor, not creation order.
+  page.find("li.question-item", text: payload["questions"].last["text"]).click_button "Move up"
+  payload["questions"].reverse!
+  page.assert_selector "li.question-item:first-child", text: payload["questions"].first["text"]
+  source = read_export(page)
+  verify("export contains only ordered content, with active and correct flags") { JSON.parse(source) == payload }
+  verify("HTML-like quiz content stays literal") { page.evaluate_script("window.injected === undefined") }
+  page.save_screenshot("storage/screenshots/export-quiz.png", full: true)
+  page.driver.resize(390, 844)
+  verify("mobile export has no horizontal overflow") { page.evaluate_script("document.documentElement.scrollWidth <= innerWidth") }
+  page.save_screenshot("storage/screenshots/mobile-export.png", full: true)
+
+  open_import(page)
+  page.fill_in "Quiz JSON", with: '{"title": "broken"'
+  page.click_button "Import"
+  page.assert_selector "[role=alert]", text: "Nothing was saved"
+  page.assert_text "not valid JSON"
+  verify("invalid JSON remains in the textarea for correction") { page.find_field("Quiz JSON").value == '{"title": "broken"' }
+  invalid = JSON.parse(source)
+  invalid["questions"].last["options"].each { |option| option["correct"] = false }
+  page.fill_in "Quiz JSON", with: JSON.pretty_generate(invalid)
+  page.click_button "Import"
+  page.assert_selector "[role=alert]", text: "Question 2: Mark at least one option as correct"
+  verify("mobile import and its error have no horizontal overflow") { page.evaluate_script("document.documentElement.scrollWidth <= innerWidth") }
+  page.save_screenshot("storage/screenshots/mobile-import-error.png", full: true)
+  page.visit "/moderate"
+  page.assert_selector "li.quiz-list-item", count: original_count + 1
+  puts "PASS: invalid syntax and invalid later question create no partial quiz"
+  page.driver.resize(1440, 1000)
+
+  2.times do
+    open_import(page)
+    page.fill_in "Quiz JSON", with: source
+    page.click_button "Import"
+    page.assert_selector "h1", text: payload["title"]
+    url = page.current_url
+    verify("same-title import opens a newly created quiz") { !created_urls.include?(url) }
+    created_urls << url
+    page.assert_selector "li.question-item", count: 2
+    payload["questions"].each_with_index do |question, index|
+      row = page.find("li.question-item:nth-child(#{index + 1})", text: question["text"])
+      verify("question #{index + 1} active flag survives the round trip") do
+        question["active"] ? row.has_checked_field?("Active") : row.has_unchecked_field?("Active")
+      end
+    end
+    verify("re-export is identical, including multiple correct options") { JSON.parse(read_export(page)) == payload }
+  end
+
+  defaults = JSON.parse(source)
+  defaults["questions"].last.delete("active")
+  defaults["questions"].last["options"].first.delete("correct")
+  open_import(page)
+  page.fill_in "Quiz JSON", with: JSON.pretty_generate(defaults)
+  page.click_button "Import"
+  page.assert_selector "h1", text: payload["title"]
+  created_urls << page.current_url
+  verify("omitted flags default correctly; explicit inactive survives") { JSON.parse(read_export(page)) == payload }
+
+  open_import(page)
+  empty = { "title" => "#{payload['title']} (empty)", "number_of_winners" => 3, "questions" => [] }
+  page.fill_in "Quiz JSON", with: JSON.generate(empty)
+  page.click_button "Import"
+  page.assert_selector "h1", text: empty["title"]
+  created_urls << page.current_url
+  page.assert_text "No questions yet"
+  verify("an empty quiz can be imported and exported") { JSON.parse(read_export(page)) == empty }
+
+  page.visit original_url
+  verify("the original quiz is unchanged") { JSON.parse(read_export(page)) == payload }
+  page.visit "/moderate"
+  page.assert_selector "li.quiz-list-item", count: original_count + created_urls.size
+  created_urls.each do |url|
+    page.visit url
+    page.click_link "Settings"
+    page.accept_confirm { page.click_button "Delete quiz" }
+    page.assert_selector "h1", text: "Your quizzes"
+  end
+  verify("all browser-created quizzes have been cleaned up") { page.all("li.quiz-list-item").size == original_count }
+  puts "All production quiz transfer checks passed."
+rescue Exception
+  page.save_screenshot("storage/screenshots/transfer-failure.png", full: true) rescue nil
+  warn "Browser URL at failure: #{page.current_url}"
+  warn page.text rescue nil
+  raise
+ensure
+  page.driver.quit
+end
diff --git a/script/live_concurrency_smoke.rb b/script/live_concurrency_smoke.rb
new file mode 100644
index 0000000..842d47c
--- /dev/null
+++ b/script/live_concurrency_smoke.rb
@@ -0,0 +1,81 @@
+# Run with: bin/rails runner script/live_concurrency_smoke.rb
+# Exercises SQLite write serialization across independent connections.
+quiz = Quiz.create!(title: "Temporary concurrent live-game check")
+begin
+  quiz.questions.create!(body: "Choose", position: 1, options: [ { text: "First", correct: false }, { text: "Last", correct: true } ])
+  game = Game.for_quiz!(quiz)
+  players = 60.times.map { |index| game.join!("concurrency-#{index}", "Player #{index}") }
+  game.advance!("start", 0)
+  question_id = game.current_question.id
+  errors = Queue.new
+  jobs = Queue.new
+  players.each { |player| jobs << player.id }
+  workers = Array.new(12) do
+    Thread.new do
+      loop do
+        player_id = jobs.pop(true)
+        ActiveRecord::Base.connection_pool.with_connection do
+          player = Player.find(player_id)
+          current = Game.find(game.id)
+          current.answer!(player, question_id, 0)
+          current.answer!(player, question_id, 1)
+          current.answer!(player, question_id, 1) # another pick updates timing, not the answer count
+        end
+      rescue ThreadError
+        break
+      rescue => error
+        errors << error
+      end
+    end
+  end
+  workers.each(&:join)
+  raise errors.pop unless errors.empty?
+  raise "Answers mixed or duplicated" unless game.answers.count == 60 && game.answers.where(option_index: 1).count == 60
+  puts "PASS: 180 concurrent writes preserve 60 unique final answers"
+
+  # Race closing with more answers; every request must either commit while open
+  # or reject as a conflict. None may write after the close transaction commits.
+  workers = players.first(12).map do |player|
+    Thread.new do
+      ActiveRecord::Base.connection_pool.with_connection do
+        Game.find(game.id).answer!(player, question_id, 0)
+      end
+    rescue Game::Conflict
+      # Expected if Finish won the race.
+    rescue => error
+      errors << error
+    end
+  end
+  game.advance!("finish", 1)
+  workers.each(&:join)
+  raise errors.pop unless errors.empty?
+  final_answers = game.answers.order(:id).pluck(:option_index)
+  begin
+    game.answer!(players.first, question_id, 1)
+    raise "Closed question accepted an answer"
+  rescue Game::Conflict
+    raise "Closed answers changed" unless final_answers == game.answers.order(:id).pluck(:option_index)
+  end
+  puts "PASS: Finish serializes against in-flight answers and locks the results"
+  game.advance!("end", 2)
+  workers = %w[top draw reset draw top].map do |strategy|
+    Thread.new do
+      ActiveRecord::Base.connection_pool.with_connection do
+        Game.find(game.id).select_winners!(strategy)
+      end
+    rescue => error
+      errors << error
+    end
+  end
+  workers.each(&:join)
+  raise errors.pop unless errors.empty?
+  # Whichever command ran last produced one whole set, never a mixture.
+  winners = game.players.where(winner: true)
+  raise "Prize commands lost a revision" unless game.reload.revision == 8
+  raise "Mixed winner sets" unless [ 0, 3 ].include?(winners.count)
+  scored = game.leaderboard.select { |entry| entry.points.positive? }.map { |entry| entry.player.id }
+  raise "Zero-point winner" unless (winners.ids - scored).empty?
+  puts "PASS: concurrent prize commands replace one atomic winner set"
+ensure
+  quiz.destroy!
+end
diff --git a/script/timer_concurrency_smoke.rb b/script/timer_concurrency_smoke.rb
