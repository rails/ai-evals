+++ b/app/models/quiz.rb
@@ -0,0 +1,36 @@
+class Quiz < ApplicationRecord
+  has_many :questions, -> { order(:position, :id) }, dependent: :destroy, inverse_of: :quiz
+
+  has_many :games, dependent: :destroy
+
+  validates :title, presence: true
+  validates :number_of_winners, numericality: { only_integer: true, greater_than_or_equal_to: 1 }
+
+  validates :timer_minutes, :timer_seconds, numericality: { only_integer: true, greater_than_or_equal_to: 0 }
+
+  def timer_duration_seconds
+    timer_minutes * 60 + timer_seconds
+  end
+
+  def append_question(question)
+    with_lock do
+      question.position = questions.maximum(:position).to_i + 1
+      question.save
+    end
+  end
+
+  def move_question(question, direction)
+    with_lock do
+      ordered = questions.to_a
+      index = ordered.index { |item| item.id == question.id }
+      target = index + direction
+      if target.between?(0, ordered.length - 1)
+        question = ordered[index]
+        neighbor = ordered[target]
+        old_position = question.position
+        question.update!(position: neighbor.position)
+        neighbor.update!(position: old_position)
+      end
+    end
+  end
+end
diff --git a/app/services/game_timer.rb b/app/services/game_timer.rb
new file mode 100644
index 0000000..72f313a
--- /dev/null
+++ b/app/services/game_timer.rb
@@ -0,0 +1,42 @@
+# A local Puma lifecycle worker: deadlines live in SQLite, not in scheduled jobs
+# or browser tabs. Scanning persisted deadlines also recovers after a restart.
+class GameTimer
+  INTERVAL = 0.2
+
+  def self.expire_due!
+    Game.where(phase: "open").joins(:game_questions)
+      .where("game_questions.position = games.question_index")
+      .where("game_questions.closes_at <= ?", Time.current).find_each do |game|
+        game.expire_if_due!
+      rescue ActiveRecord::RecordNotFound
+        # A moderator may delete the quiz between the scan and the lock.
+      end
+  end
+
+  def self.start
+    return if @thread&.alive?
+    @mutex = Mutex.new
+    @wake = ConditionVariable.new
+    @stopped = false
+    @thread = Thread.new do
+      Thread.current.name = "quizzy-timer"
+      loop do
+        begin
+          Rails.application.executor.wrap do
+            ActiveRecord::Base.connection_pool.with_connection { expire_due! }
+          end
+        rescue StandardError => error
+          Rails.logger.error("Quizzy timer: #{error.class}: #{error.message}")
+        end
+        break if @mutex.synchronize { @wake.wait(@mutex, INTERVAL) unless @stopped; @stopped }
+      end
+    end
+  end
+
+  def self.stop
+    return unless @thread
+    @mutex.synchronize { @stopped = true; @wake.broadcast }
+    @thread.join
+    @thread = nil
+  end
+end
diff --git a/app/services/quiz_json.rb b/app/services/quiz_json.rb
new file mode 100644
index 0000000..52f9077
--- /dev/null
+++ b/app/services/quiz_json.rb
@@ -0,0 +1,89 @@
+# A portable content format, deliberately independent of database attributes.
+class QuizJson
+  class ImportError < StandardError; end
+
+  class << self
+    def export(quiz)
+      JSON.pretty_generate(
+        title: quiz.title,
+        number_of_winners: quiz.number_of_winners,
+        questions: quiz.questions.map do |question|
+          {
+            text: question.body,
+            active: question.active?,
+            options: question.options.map do |option|
+              { text: option.fetch("text"), correct: option.fetch("correct") }
+            end
+          }
+        end
+      )
+    end
+
+    def import(source)
+      data = parse(source)
+      validate_structure!(data)
+
+      # Use the editor's model validations/normalization, and let errors escape
+      # the transaction so even a failure in the last question rolls back all rows.
+      context = "Quiz"
+      Quiz.transaction do
+        quiz = Quiz.create!(title: data.fetch("title"), number_of_winners: data.fetch("number_of_winners", 3))
+        data.fetch("questions").each_with_index do |attributes, index|
+          context = "Question #{index + 1}"
+          quiz.questions.create!(
+            body: attributes.fetch("text"),
+            active: attributes.fetch("active", true),
+            position: index + 1,
+            option_rows: attributes.fetch("options").map do |option|
+              { "text" => option.fetch("text"), "correct" => option.fetch("correct", false) }
+            end
+          )
+        end
+        quiz
+      end
+    rescue ActiveRecord::RecordInvalid => error
+      raise ImportError, "#{context}: #{error.record.errors.full_messages.to_sentence}."
+    end
+
+    private
+
+    def parse(source)
+      require_type!(source, String, "Quiz JSON", "text containing a JSON object")
+      JSON.parse(source)
+    rescue JSON::ParserError
+      raise ImportError, "Quiz JSON is not valid JSON. Check its syntax and try again."
+    end
+
+    def validate_structure!(data)
+      require_type!(data, Hash, "Quiz JSON", "an object")
+      require_type!(data["title"], String, "Quiz title", "a string")
+      if data.key?("number_of_winners")
+        require_type!(data["number_of_winners"], Integer, "Number of winners", "an integer of at least 1")
+      end
+      require_type!(data["questions"], Array, "Quiz questions", "an array")
+      data["questions"].each_with_index do |question, index|
+        context = "Question #{index + 1}"
+        require_type!(question, Hash, context, "an object")
+        require_type!(question["text"], String, "#{context} text", "a string")
+        require_boolean!(question, "active", context)
+        require_type!(question["options"], Array, "#{context} options", "an array")
+        question["options"].each_with_index do |option, option_index|
+          option_context = "#{context}, option #{option_index + 1}"
+          require_type!(option, Hash, option_context, "an object")
+          require_type!(option["text"], String, "#{option_context} text", "a string")
+          require_boolean!(option, "correct", option_context)
+        end
+      end
+    end
+
+    def require_type!(value, type, context, description)
+      raise ImportError, "#{context} must be #{description}." unless value.is_a?(type)
+    end
+
+    def require_boolean!(object, key, context)
+      if object.key?(key) && ![ true, false ].include?(object[key])
+        raise ImportError, "#{context} #{key} must be true or false."
+      end
+    end
+  end
+end
diff --git a/app/views/layouts/application.html.erb b/app/views/layouts/application.html.erb
new file mode 100644
index 0000000..930ccb8
--- /dev/null
+++ b/app/views/layouts/application.html.erb
@@ -0,0 +1,14 @@
+<!DOCTYPE html>
+<html lang="en">
+  <head><%= render "shared/head" %></head>
+  <body>
+    <header class="admin-header">
+      <%= link_to moderate_root_path, class: "logo admin-header__logo", aria: { label: "Quizzy — All quizzes" } do %>
