diff --git a/app/views/play/_state.html.erb b/app/views/play/_state.html.erb
new file mode 100644
index 0000000..1272c97
--- /dev/null
+++ b/app/views/play/_state.html.erb
@@ -0,0 +1,47 @@
+<section class="game-panel" data-ended="<%= @game.phase == "ended" %>" data-version="<%= @version %>" data-revision="<%= @game.revision %>">
+  <% if @game.phase == "ended" %>
+    <%= render "result" %>
+  <% elsif !@player %>
+    <h1 class="play-title"><%= @game.title %></h1>
+    <p class="play-lead">A little curiosity goes a long way. Join in!</p>
+    <% if @error %><p class="form-errors" role="alert"><%= @error %></p><% end %>
+    <%= form_with url: join_play_path(@game.code), class: "join-form" do |form| %>
+      <%= form.label :name, "Your name" %>
+      <%= form.text_field :name, value: @name, placeholder: "Your name", maxlength: 80, required: true, autocomplete: "nickname", class: "input" %>
+      <%= form.button "Join", class: "btn btn--pink" %>
+    <% end %>
+  <% elsif @game.phase == "lobby" %>
+    <div class="waiting">
+      <span class="waiting__gem" aria-hidden="true">?</span>
+      <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+      <p class="play-lead">You’re in. Waiting for the quiz to start…</p>
+      <p class="meta">Keep this page open. Questions will appear here automatically.</p>
+    </div>
+  <% else %>
+    <p class="meta">Hi, <%= @player.name %>!</p>
+    <p class="play-progress">Question <%= @game.question_index + 1 %> of <%= @question_count %></p>
+    <h1 class="play-question"><%= @question.body %></h1>
+    <% if @game.phase == "closed" %>
+      <% result = !@answer ? "No answer" : (@question.options[@answer.option_index]['correct'] ? "Correct!" : "Wrong!") %>
+      <p class="play-status <%= result == 'Correct!' ? 'play-status--right' : (result == 'Wrong!' ? 'play-status--wrong' : 'play-status--neutral') %>"><%= result %></p>
+    <% end %>
+    <ul class="play-options live-options <%= 'is-revealed' if @game.phase == 'closed' %>">
+      <% @question.options.each_with_index do |option, index| %>
+        <% picked = @answer&.option_index == index %>
+        <li>
+          <%= form_with url: answer_play_path(@game.code), data: { live_form: true } do |form| %>
+            <%= form.hidden_field :question_id, value: @question.id %>
+            <%= form.hidden_field :option_index, value: index %>
+            <button id="answer-option-<%= index %>" type="submit" class="play-option <%= 'is-picked' if picked %> <%= 'is-correct' if @game.phase == 'closed' && option['correct'] %>" aria-pressed="<%= picked %>" <%= 'disabled' if @game.phase == 'closed' %>>
+              <span class="play-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+              <span class="play-option__text"><%= option['text'] %></span>
+              <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+              <% if @game.phase == "closed" && option['correct'] %><span class="play-option__mark">Correct</span><% end %>
+            </button>
+          <% end %>
+        </li>
+      <% end %>
+    </ul>
+    <p class="meta"><%= @game.phase == "open" ? "Tap an option to answer. You can change your answer until the question closes." : "Waiting for the moderator…" %></p>
+  <% end %>
+</section>
