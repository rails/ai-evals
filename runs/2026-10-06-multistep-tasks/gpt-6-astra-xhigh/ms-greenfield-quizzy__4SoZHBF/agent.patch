+threads threads_count, threads_count
+bind "tcp://0.0.0.0:#{ENV.fetch('PORT', 3000)}"
+environment ENV.fetch("RAILS_ENV", "production")
+pidfile ENV.fetch("PIDFILE", "storage/puma.pid")
+plugin :tmp_restart
+
