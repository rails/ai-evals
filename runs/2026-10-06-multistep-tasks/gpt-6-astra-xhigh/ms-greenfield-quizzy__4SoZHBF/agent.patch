diff --git a/app/views/moderate/games/_state.html.erb b/app/views/moderate/games/_state.html.erb
new file mode 100644
index 0000000..e1ff2ec
--- /dev/null
+++ b/app/views/moderate/games/_state.html.erb
@@ -0,0 +1,61 @@
+<section class="game-panel screen__body" data-ended="<%= @game.phase == "ended" %>" data-version="<%= @version %>" data-revision="<%= @game.revision %>">
+  <% if @game.phase == "lobby" %>
+    <div class="lobby">
+      <div>
+        <p class="screen__kicker">Ready when you are.</p>
+        <h1 class="lobby__title"><%= @game.title %></h1>
+        <p class="lobby__join">Scan to join, or open</p>
+        <p class="lobby__url" data-join-url><%= @join_url %></p>
+        <p class="counter-pill">Players: <%= @player_count %></p>
+        <% if @question_count.zero? %><p>No active questions. Start will end this game.</p><% end %>
+      </div>
+      <div class="qr" role="img" aria-label="QR code to join this game"><%= raw @qr %></div>
+    </div>
+  <% elsif @game.phase == "ended" %>
+    <%= render "leaderboard" %>
+  <% else %>
+    <div class="stage-question">
+      <div class="stage-question__heading">
+        <p class="stage-question__num">Question <%= @game.question_index + 1 %> of <%= @question_count %></p>
+        <% if @game.phase == "open" && @question.closes_at %>
+          <% now = Time.current; remaining = [(@question.closes_at - now).ceil, 0].max %>
+          <span class="question-countdown" role="timer" aria-label="Time remaining" aria-live="off" data-countdown data-deadline="<%= @question.closes_at.iso8601(3) %>" data-server-now="<%= now.iso8601(3) %>"><%= remaining / 60 %>:<%= "%02d" % (remaining % 60) %></span>
+        <% end %>
+      </div>
+
+      <h1 class="stage-question__body"><%= @question.body %></h1>
+      <ul class="stage-options <%= 'is-revealed' if @game.phase == 'closed' %>">
+        <% @question.options.each_with_index do |option, index| %>
+          <li class="stage-option <%= 'is-correct' if @game.phase == 'closed' && option['correct'] %>">
+            <span class="stage-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+            <span class="stage-option__text"><%= option['text'] %></span>
+            <% if @game.phase == "closed" %>
+              <span class="stage-option__count"><%= pluralize(@option_counts.fetch(index, 0), "answer") %></span>
+              <% if option['correct'] %><span class="stage-option__mark">Correct</span><% end %>
+            <% end %>
+          </li>
+        <% end %>
+      </ul>
+    </div>
+  <% end %>
+  <footer class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "← Back to quiz", moderate_quiz_path(@game.quiz_id) %>
+      <% if @question %><span class="answers-counter">Answers: <%= @answer_count %> / <%= @player_count %></span><% end %>
+    </div>
+    <% if @game.phase == "ended" %>
+      <%= render "winner_controls" %>
+    <% else %>
+      <% step, label = case @game.phase
+         when "lobby" then [ "start", "Start" ]
+         when "open" then [ "finish", "Finish" ]
+         when "closed" then @game.last_question? ? [ "end", "End quiz" ] : [ "next", "Next" ]
+         end %>
+      <%= form_with url: advance_moderate_game_path(@game), data: { live_form: true } do |form| %>
+        <%= form.hidden_field :revision, value: @game.revision %>
+        <%= form.hidden_field :step, value: step %>
+        <%= form.button label, class: "btn btn--pink" %>
+      <% end %>
+    <% end %>
+  </footer>
+</section>
