diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..1acd102
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+
+  setup do
+    @quiz = Quiz.create!(title: "Live quiz")
+    @source = @quiz.questions.create!(body: "Original?", position: 1, options: [ { text: "One", correct: true }, { text: "Two", correct: false } ])
+    @game = Game.for_quiz!(@quiz)
+    @player = @game.join!("browser-a", " Alice ")
+  end
+
+  test "game snapshots isolate edits and replay data" do
+    @source.update!(body: "Edited?", active: false)
+    @quiz.update!(title: "Edited title")
+    assert_equal "Live quiz", @game.title
+    assert_equal "Original?", @game.game_questions.first.body
+    assert_equal 1, @game.game_questions.count
+    assert_equal 0, Game.for_quiz!(@quiz).game_questions.count
+    @source.destroy!
+    assert_equal 1, @game.game_questions.count
+  end
+
+  test "empty quiz ends cleanly without attempting to open a question" do
+    game = Game.for_quiz!(Quiz.create!(title: "Empty"))
+    game.advance!("start", 0)
+    assert_equal "ended", game.phase
+    assert_nil game.current_question
+    assert_raises(Game::Conflict) { game.join!("browser", "Late") }
+  end
+
+  test "state machine prevents duplicate transitions and illegal steps" do
+    assert_raises(Game::Conflict) { @game.advance!("finish", 0) }
+    @game.advance!("start", 0)
+    assert_raises(Game::Conflict) { @game.advance!("start", 0) }
+    assert_raises(Game::Conflict) { @game.advance!("end", 1) }
+    @game.advance!("finish", 1)
+    assert_raises(Game::Conflict) { @game.advance!("next", 2) }
+    @game.advance!("end", 2)
+    assert_raises(Game::Conflict) { @game.advance!("start", 3) }
+    assert_equal 3, @game.reload.revision
+  end
+
+  test "answers are unique editable and validated against current open question" do
+    q = @game.game_questions.first
+    assert_raises(Game::Conflict) { @game.answer!(@player, q.id, 0) }
+    @game.advance!("start", 0)
+    [ nil, "junk", "1.5", "-1", "2", "0abc" ].each do |invalid|
+      assert_raises(Game::Conflict) { @game.answer!(@player, q.id, invalid) }
+    end
+    other = Game.for_quiz!(@quiz)
+    outsider = other.join!("browser-b", "Bob")
+    assert_raises(Game::Conflict) { @game.answer!(outsider, q.id, 0) }
+    assert_raises(Game::Conflict) { @game.answer!(@player, other.game_questions.first.id, 0) }
+    @game.answer!(@player, q.id, 1)
+    @game.answer!(@player, q.id, 0)
+    @game.answer!(@player, q.id, 0)
+    assert_equal [ 0 ], @game.answers.pluck(:option_index)
+    @game.advance!("finish", 1)
+    assert_raises(Game::Conflict) { @game.answer!(@player, q.id, 1) }
+    assert_equal [ 0 ], @game.answers.pluck(:option_index)
+  end
+
+  test "one identity per game allows duplicate names and validates blank or long names" do
+    assert_equal "Alice", @player.name
+    assert_equal @player, @game.join!("browser-a", "Other name")
+    assert_equal "Alice", @game.join!("browser-b", "Alice").name
+    assert_raises(ActiveRecord::RecordInvalid) { @game.join!("browser-c", "   ") }
+    assert_raises(ActiveRecord::RecordInvalid) { @game.join!("browser-c", "a" * 81) }
+    assert_equal 2, @game.players.count
+  end
+
+  test "presence counts distinct players, expires, revives, and broadcasts both joins and disconnects" do
+    stream = "game:#{@game.id}:moderator"
+    assert_broadcast_on(stream, changed: true) { PlayerPresence.renew(@player, "tab-one") }
+    assert_broadcast_on(stream, changed: true) { PlayerPresence.renew(@player, "tab-two") }
+    assert_equal 1, @game.player_count
+    assert_no_broadcasts(stream) { PlayerPresence.renew(@player, "tab-one") }
+    assert_broadcast_on(stream, changed: true) { @player.player_presences.find_by!(connection_key: "tab-one").destroy! }
+    assert_equal 1, @game.player_count
+    travel 46.seconds do
+      assert_equal 0, @game.player_count
+      assert_broadcast_on(stream, changed: true) { PlayerPresence.renew(@player, "tab-two") }
+      assert_equal 1, @game.player_count
+    end
+  end
+
+  test "public broadcast contains no answer data and picking an option only notifies moderator and owner" do
+    public_stream = "game:#{@game.id}:public"
+    assert_broadcast_on(public_stream, changed: true) { @game.advance!("start", 0) }
+    assert_no_broadcasts(public_stream) do
+      assert_broadcast_on("player:#{@player.id}", changed: true) do
+        assert_broadcast_on("game:#{@game.id}:moderator", changed: true) do
+          @game.answer!(@player, @game.current_question.id, 0)
+        end
+      end
+    end
+    assert_broadcast_on(public_stream, changed: true) { @game.advance!("finish", 1) }
+  end
+
+  test "deleting a quiz removes game data and presence" do
+    PlayerPresence.renew(@player, "tab")
+    @game.advance!("start", 0)
+    @game.answer!(@player, @game.current_question.id, 0)
+    @quiz.destroy!
+    assert_not Game.exists?(@game.id)
+    assert_not Player.exists?(@player.id)
+    assert_equal 0, PlayerPresence.where(player_id: @player.id).count
+  end
+end
diff --git a/test/models/prizes_test.rb b/test/models/prizes_test.rb
new file mode 100644
index 0000000..c97e452
--- /dev/null
+++ b/test/models/prizes_test.rb
@@ -0,0 +1,180 @@
+require "test_helper"
+
+class PrizesTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+
+  setup do
+    @quiz = Quiz.create!(title: "Prizes", number_of_winners: 2)
+    2.times do |index|
+      @quiz.questions.create!(body: "Question #{index}", position: index + 1,
+        options: [ { text: "Yes", correct: true }, { text: "Also yes", correct: true }, { text: "No", correct: false } ])
+    end
+    @game = Game.for_quiz!(@quiz)
+    @players = %w[Ace Bee Cat Dee Zero].map { |name| @game.join!(name, name) }
+    @start = Time.utc(2026, 10, 8, 12)
+  end
+
+  test "winner count defaults to three, validates integers, and is snapshotted" do
+    assert_equal 3, Quiz.new.number_of_winners
+    [ nil, 0, -1, 1.5, "abc", "" ].each do |invalid|
+      @quiz.number_of_winners = invalid
+      assert_not @quiz.valid?, "accepted #{invalid.inspect}"
+    end
+    @quiz.update!(number_of_winners: 5)
+    assert_equal 2, @game.number_of_winners
+    assert_equal 5, Game.for_quiz!(@quiz).number_of_winners
+  end
+
+  test "points then total correct answer time use the last pick, even for the same option" do
+    play_game
+    results = @game.leaderboard
+    assert_equal %w[Ace Cat Dee Bee Zero], results.map { |entry| entry.player.name }
+    assert_equal [ 2, 1, 1, 1, 0 ], results.map(&:points)
+    assert_equal [ 1, 2, 3, 4, 5 ], results.map(&:place)
+    assert_equal [ 15_000_000, 3_000_000, 4_000_000, 8_000_000, 0 ], results.map(&:elapsed_microseconds)
+    assert_equal @start, @game.game_questions.first.opened_at
+    assert_equal @start + 8, @players[1].answers.first.picked_at
+  end
+
+  test "total time, not the last question alone, breaks ties at microsecond precision" do
+    at(0) { @game.advance!("start", 0) }
+    question = @game.current_question
+    at(1 + Rational(1, 1_000_000)) { @game.answer!(@players[0], question.id, 0) }
+    at(8) { @game.answer!(@players[1], question.id, 0) }
+    at(8) { @game.answer!(@players[2], question.id, 1) }
+    at(10) { @game.advance!("finish", 1) }
+    at(20) { @game.advance!("next", 2) }
+    question = @game.current_question
+    at(27 + Rational(1, 1_000_000)) { @game.answer!(@players[0], question.id, 0) }
+    at(21) { @game.answer!(@players[1], question.id, 0) }
+    at(21) { @game.answer!(@players[2], question.id, 0) }
+    at(30) { @game.advance!("finish", 3) }
+    at(31) { @game.advance!("end", 4) }
+    assert_equal %w[Ace Bee Cat Dee Zero], @game.leaderboard.map { |entry| entry.player.name }
+    assert_equal [ 8_000_002, 9_000_000, 9_000_000, 0, 0 ], @game.leaderboard.map(&:elapsed_microseconds)
+    # A full tie uses join order, not an unstable SQL or Ruby enumeration order.
+    assert_equal [ 1, 2, 3, 4, 5 ], @game.leaderboard.map(&:place)
+  end
+
+  test "a single prize draws from the highest points tie, not the fastest player" do
+    play_game
+    @game.update!(number_of_winners: 1)
+    %w[top draw].each do |strategy|
+      @game.select_winners!(strategy)
+      assert_equal [ "Ace" ], winners
+    end
+    # Remove Ace's second correct point: four people now tie for one prize.
+    @players.first.answers.order(:game_question_id).last.update!(option_index: 2)
+    drawn = 30.times.map do |seed|
+      @game.select_winners!("draw", random: Random.new(seed))
+      assert_equal 1, winners.size
+      winners.first
+    end
+    assert_equal %w[Ace Bee Cat Dee], drawn.uniq.sort
+  end
+
+  test "top winners use the leaderboard and reset is persisted and broadcast" do
+    play_game
+    stream = "game:#{@game.id}:public"
+    revision = @game.revision
+    assert_broadcast_on(stream, changed: true) { @game.select_winners!("top") }
+    assert_equal %w[Ace Cat], winners
+    assert_equal revision + 1, @game.reload.revision
+    assert_broadcast_on(stream, changed: true) { @game.select_winners!("reset") }
+    assert_empty winners
+    assert_equal revision + 2, @game.reload.revision
+  end
+
+  test "draw keeps everyone above the points cutoff and samples the entire tie regardless of speed" do
+    play_game
+    drawn = []
+    30.times do |seed|
+      @game.select_winners!("draw", random: Random.new(seed))
+      selected = winners
+      assert_equal 2, selected.size
+      assert_includes selected, "Ace"
+      assert_empty selected & [ "Zero" ]
+      drawn.concat(selected - [ "Ace" ])
+    end
+    assert_equal %w[Bee Cat Dee], drawn.uniq.sort
+    @game.select_winners!("top")
+    assert_equal %w[Ace Cat], winners
+  end
+
+  test "fewer scoring players than prizes all win but zero points never win" do
+    play_game
+    @game.update!(number_of_winners: 10)
+    %w[top draw].each do |strategy|
+      @game.select_winners!(strategy)
+      assert_equal %w[Ace Bee Cat Dee], winners
+    end
+  end
+
+  test "empty games and games with only zero points have no winners" do
+    empty = Game.for_quiz!(Quiz.create!(title: "Empty"))
+    empty.advance!("start", 0)
+    %w[top draw reset].each do |strategy|
+      empty.select_winners!(strategy)
+      assert_empty empty.leaderboard
+    end
+    @game.advance!("start", 0)
+    @game.advance!("finish", 1)
+    @game.advance!("next", 2)
+    @game.advance!("finish", 3)
+    @game.advance!("end", 4)
+    %w[top draw reset].each do |strategy|
+      @game.select_winners!(strategy)
+      assert_empty winners
+    end
+    assert_equal @players.map(&:id), @game.leaderboard.map { |entry| entry.player.id }
+  end
+
+  test "winner selection only accepts known commands on ended games" do
+    assert_raises(Game::Conflict) { @game.select_winners!("top") }
+    play_game
+    assert_raises(Game::Conflict) { @game.select_winners!("anything") }
+    assert_empty winners
+  end
+
+  test "a stale answer cannot change its timestamp after Finish" do
+    at(0) { @game.advance!("start", 0) }
+    question = @game.current_question
+    at(1) { @game.answer!(@players.first, question.id, 0) }
+    at(2) { @game.advance!("finish", 1) }
+    at(3) { assert_raises(Game::Conflict) { @game.answer!(@players.first, question.id, 1) } }
+    assert_equal @start + 1, @players.first.answers.first.picked_at
+    assert_equal @start, question.reload.opened_at
+  end
+
+  private
+
+  def at(seconds, &block)
+    travel_to(@start + seconds, with_usec: true, &block)
+  end
+
+  def play_game
+    at(0) { @game.advance!("start", 0) }
+    question = @game.current_question
+    # Bee's first correct pick is fast, but the last pick must count.
+    at(1) { @game.answer!(@players[1], question.id, 0) }
+    at(3) { @game.answer!(@players[2], question.id, 1) }
+    at(4) { @game.answer!(@players[3], question.id, 0) }
+    at(5) { @game.answer!(@players[0], question.id, 0) }
+    at(8) { @game.answer!(@players[1], question.id, 0) }
+    at(9) { @game.answer!(@players[4], question.id, 0) }
+    at(10) { @game.answer!(@players[4], question.id, 2) }
+    at(11) { @game.advance!("finish", 1) }
+    at(20) { @game.advance!("next", 2) }
+    question = @game.current_question
+    # Wrong answers and skipped questions don't enter the time tiebreaker.
+    at(21) { @game.answer!(@players[1], question.id, 2) }
+    at(30) { @game.answer!(@players[0], question.id, 0) }
+    at(40) { @game.answer!(@players[3], question.id, 2) }
+    at(41) { @game.advance!("finish", 3) }
+    at(42) { @game.advance!("end", 4) }
+  end
+
+  def winners
+    @game.players.where(winner: true).order(:name).pluck(:name)
+  end
+end
diff --git a/test/models/timer_test.rb b/test/models/timer_test.rb
new file mode 100644
index 0000000..03003c5
--- /dev/null
+++ b/test/models/timer_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class TimerTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+
+  setup do
+    @quiz = Quiz.create!(title: "Timed talk", timer_minutes: 1, timer_seconds: 30)
+    2.times do |index|
+      @quiz.questions.create!(body: "Question #{index + 1}", position: index + 1,
+        options: [ { text: "Yes", correct: true }, { text: "No", correct: false } ])
+    end
+    @game = Game.for_quiz!(@quiz)
+    @player = @game.join!("timer-browser", "Alice")
+  end
+
+  test "timer defaults and validation" do
+    quiz = Quiz.new(title: "Untimed")
+    assert_equal 0, quiz.timer_minutes
+    assert_equal 0, quiz.timer_seconds
+    assert_equal 0, quiz.timer_duration_seconds
+    %i[timer_minutes timer_seconds].each do |field|
+      [ -1, 1.5, "abc", nil ].each do |value|
+        quiz[field] = value
+        assert_not quiz.valid?, "#{field}=#{value.inspect} should be invalid"
+      end
+      quiz[field] = 0
+    end
+    assert quiz.valid?
+  end
+
+  test "opening stores a shared deadline and reloads or settings edits never reset it" do
+    travel_to Time.zone.local(2026, 10, 8, 12) do
+      assert_nil @game.game_questions.first.closes_at
+      @game.advance!("start", 0)
+      question = @game.current_question
+      assert_equal Time.current, question.opened_at
+      assert_equal 90.seconds.from_now, question.closes_at
+      @quiz.update!(timer_minutes: 0, timer_seconds: 5)
+      assert_equal 90, @game.reload.timer_duration_seconds
+      travel 30.seconds
+      assert_not @game.expire_if_due!
+      assert_equal 60.seconds.from_now, @game.reload.current_question.closes_at
+      @game.advance!("finish", 1)
+      @game.advance!("next", 2)
+      assert_equal 90.seconds.from_now, @game.current_question.closes_at
+      assert_equal question.closes_at, question.reload.closes_at
+    end
+  end
+
+  test "expiry closes exactly once and broadcasts the same update as Finish" do
+    travel_to Time.zone.local(2026, 10, 8, 12) do
+      @game.advance!("start", 0)
+      travel 89.seconds
+      assert_not @game.expire_if_due!
+      assert_equal "open", @game.reload.phase
+      travel 1.second
+      assert_broadcast_on("game:#{@game.id}:public", changed: true) { assert @game.expire_if_due! }
+      assert_equal "closed", @game.reload.phase
+      assert_equal 2, @game.revision
+      assert_no_broadcasts("game:#{@game.id}:public") { assert_not @game.expire_if_due! }
+      assert_raises(Game::Conflict) { @game.advance!("finish", 1) }
+      assert_equal 2, @game.reload.revision
+      @game.advance!("next", 2)
+      assert_equal "open", @game.phase
+      assert_equal 90.seconds.from_now, @game.current_question.closes_at
+    end
+  end
+
+  test "late picks cannot change the final answer even before the timer worker runs" do
+    travel_to Time.zone.local(2026, 10, 8, 12) do
+      @game.advance!("start", 0)
+      question = @game.current_question
+      travel 89.seconds
+      @game.answer!(@player, question.id, 0)
+      picked_at = @game.answers.first.picked_at
+      travel 1.second
+      assert_raises(Game::Conflict) { @game.answer!(@player, question.id, 1) }
+      assert_equal "closed", @game.reload.phase, "rejecting a late answer must not roll back expiry"
+      assert_equal [ 0 ], @game.answers.pluck(:option_index)
+      assert_equal picked_at, @game.answers.first.picked_at
+    end
+  end
+
+  test "manual Finish at the deadline commits expiry without advancing twice" do
+    @game.advance!("start", 0)
+    travel 91.seconds do
+      assert_raises(Game::Conflict) { @game.advance!("finish", 1) }
+      assert_equal "closed", @game.reload.phase
+      assert_equal 2, @game.revision
+    end
+  end
+
+  test "worker expires due games without browsers and ignores early finishes and untimed games" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    untimed = Game.for_quiz!(@quiz)
+    untimed.advance!("start", 0)
+    assert_nil untimed.current_question.closes_at
+    @game.advance!("start", 0)
+    early = Game.for_quiz!(@quiz.tap { |quiz| quiz.update!(timer_seconds: 1) })
+    early.advance!("start", 0)
+    early.advance!("finish", 1)
+    travel 2.minutes do
+      GameTimer.expire_due!
+      assert_equal "closed", @game.reload.phase
+      assert_equal "open", untimed.reload.phase
+      assert_equal 2, early.reload.revision
+      GameTimer.expire_due!
+      assert_equal 2, @game.reload.revision
+    end
+  end
+
+  test "timer settings are not portable" do
+    data = JSON.parse(QuizJson.export(@quiz))
+    assert_equal %w[number_of_winners questions title], data.keys.sort
+    data.merge!("timer_minutes" => 5, "timer_seconds" => 10, "timer_duration_seconds" => 310)
+    imported = QuizJson.import(data.to_json)
+    assert_equal 0, imported.timer_minutes
+    assert_equal 0, imported.timer_seconds
+    assert_equal @quiz.questions.count, imported.questions.count
+  end
+end
