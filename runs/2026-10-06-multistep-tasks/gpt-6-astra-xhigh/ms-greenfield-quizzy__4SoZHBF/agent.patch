+        render :new, status: :unprocessable_entity
+      end
+    end
+
+    def edit
+    end
+
+    def update
+      if @quiz.update(quiz_params)
+        redirect_to moderate_quiz_path(@quiz), notice: "Quiz saved.", status: :see_other
+      else
+        render :edit, status: :unprocessable_entity
+      end
+    end
+
+    def destroy
+      @quiz.destroy!
+      redirect_to moderate_root_path, notice: "Quiz deleted.", status: :see_other
+    end
+
+    def export
+      @quiz_json = QuizJson.export(@quiz)
+    end
+
+    def preview
+      @preview_questions = @quiz.questions.active.map do |question|
+        { body: question.body, options: question.options }
+      end
+      render layout: "preview"
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:id])
+    end
+
+    def quiz_params
+      params.expect(quiz: [ :title, :number_of_winners, :timer_minutes, :timer_seconds ])
+    end
+  end
+end
