index 0000000..7a4331c
--- /dev/null
+++ b/app/controllers/moderate/base_controller.rb
@@ -0,0 +1,26 @@
+module Moderate
+  class BaseController < ApplicationController
+    prepend_before_action :require_moderator_authentication
+    before_action :prevent_caching
+
+    def not_found
+      head :not_found
+    end
+
+    private
+
+    def require_moderator_authentication
+      authenticate_or_request_with_http_basic("Quizzy Moderator") do |username, password|
+        expected_username = ENV["QUIZZY_MODERATOR_USERNAME"].presence
+        expected_password = ENV["QUIZZY_MODERATOR_PASSWORD"].presence
+        expected_username && expected_password &&
+          (ActiveSupport::SecurityUtils.secure_compare(username.to_s, expected_username) &
+           ActiveSupport::SecurityUtils.secure_compare(password.to_s, expected_password))
+      end
+    end
+
+    def prevent_caching
+      response.headers["Cache-Control"] = "no-store"
+    end
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..3537983
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,65 @@
+module Moderate
+  class GamesController < BaseController
+    before_action :set_game, except: :create
+    layout "stage"
+
+    def create
+      game = Game.for_quiz!(Quiz.find(params[:quiz_id]))
+      redirect_to moderate_game_path(game), status: :see_other
+    end
+
+    def show
+      prepare_state
+    end
+
+    def state
+      prepare_state
+      return head :no_content if request.headers["X-Quizzy-Version"] == @version
+      render partial: "state"
+    end
+
+    def advance
+      @game.advance!(params[:step], params[:revision])
+      state
+    rescue Game::Conflict
+      prepare_state
+      render partial: "state", status: :conflict
+    end
+
+    def winners
+      @game.select_winners!(params[:strategy])
+      state
+    rescue Game::Conflict
+      prepare_state
+      render partial: "state", status: :conflict
+    end
+
+    private
+
+    def set_game
+      @game = Game.find(params[:id])
+    end
+
+    def prepare_state
+      @game.reload
+      @game.expire_if_due!
+      if @game.phase == "lobby"
+        @join_url = play_url(code: @game.code)
+        @qr = Rails.cache.fetch([ "join-qr", @join_url ], expires_in: 1.day) do
+          RQRCode::QRCode.new(@join_url).as_svg(module_size: 5, offset: 20, use_path: true, viewbox: true)
+        end
+      end
+      @leaderboard = @game.leaderboard if @game.phase == "ended"
+      @question = @game.current_question
+      @question_count = @game.game_questions.count
+      @player_count = @game.player_count
+      @answer_count = @question ? @question.answers.count : 0
+      @option_counts = @game.phase == "closed" ? @question.answers.group(:option_index).count : {}
+      @version = Digest::SHA256.hexdigest([ @game.revision, @player_count, @answer_count, @option_counts ].to_json)
+      response.headers["X-Quizzy-Version"] = @version
+      response.headers["X-Quizzy-Revision"] = @game.revision.to_s
+      # Delete old leases even if a phone vanished without closing its socket.
+      PlayerPresence.where(player_id: @game.players.select(:id)).where("expires_at < ?", Time.current).delete_all
+    end
+  end
+end
diff --git a/app/controllers/moderate/questions_controller.rb b/app/controllers/moderate/questions_controller.rb
new file mode 100644
index 0000000..c8fd8a1
--- /dev/null
+++ b/app/controllers/moderate/questions_controller.rb
@@ -0,0 +1,70 @@
+module Moderate
+  class QuestionsController < BaseController
+    before_action :set_quiz
+    before_action :set_question, except: [ :new, :create ]
+
+    def new
+      @question = @quiz.questions.build
+      @question.option_rows = Array.new(4) { { "text" => "", "correct" => false } }
+    end
+
+    def create
+      @question = @quiz.questions.build(question_params)
+      if @quiz.append_question(@question)
+        redirect_to moderate_quiz_path(@quiz), notice: "Question added."
+      else
+        render :new, status: :unprocessable_entity
+      end
+    end
+
+    def edit
+    end
+
+    def update
+      if @question.update(question_params)
+        redirect_to moderate_quiz_path(@quiz), notice: "Question saved.", status: :see_other
+      else
+        render :edit, status: :unprocessable_entity
+      end
+    end
+
+    def destroy
+      @question.destroy!
+      redirect_to moderate_quiz_path(@quiz), notice: "Question deleted.", status: :see_other
+    end
+
+    def toggle
+      @question.update!(params.expect(question: [ :active ]))
+      redirect_to moderate_quiz_path(@quiz), status: :see_other
+    end
+
+    def move_up
+      move(-1)
+    end
+
+    def move_down
+      move(1)
+    end
+
+    private
+
+    def move(direction)
+      @quiz.move_question(@question, direction)
+      redirect_to moderate_quiz_path(@quiz), status: :see_other
+    end
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_question
+      @question = @quiz.questions.find(params[:id])
+    end
+
+    def question_params
+      attributes = params.require(:question).permit(:body, :active, option_rows: [ :text, :correct ])
+      attributes[:option_rows] ||= {}
+      attributes
+    end
+  end
+end
