new file mode 100644
index 0000000..75f3bec
--- /dev/null
+++ b/script/browser_live_smoke.rb
@@ -0,0 +1,153 @@
+#!/usr/bin/env ruby
+# Production, real WebSockets, independent Chromium browser identities.
+require "bundler/setup"
+require "capybara/cuprite"
+require "json"
+require "fileutils"
+
+Capybara.register_driver(:live_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app,
+    browser_path: "/usr/bin/chromium", window_size: [ 1440, 1000 ],
+    browser_options: { "no-sandbox" => nil, "disable-dev-shm-usage" => nil },
+    timeout: 15, process_timeout: 30, js_errors: true)
+end
+Capybara.default_max_wait_time = 8
+Capybara.enable_aria_label = true
+Capybara.run_server = false
+Capybara.app_host = ENV.fetch("APP_URL", "http://127.0.0.1:3000")
+FileUtils.mkdir_p("storage/screenshots")
+
+def verify(message)
+  raise message unless yield
+  puts "PASS: #{message}"
+end
+
+def join(page, url, name)
+  page.driver.resize(390, 844)
+  page.visit url
+  page.fill_in "Your name", with: name
+  page.click_button "Join"
+  page.assert_text "Hi, #{name}!"
+  page.assert_selector "[data-connection-status]", exact_text: "Live"
+  page.execute_script("window.liveSentinel = 'still-here'")
+end
+
+moderator, alice, bob, late = Array.new(4) { Capybara::Session.new(:live_chromium) }
+all_sessions = [ moderator, alice, bob, late ]
+begin
+  moderator.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "test-password"))
+  moderator.visit "/moderate"
+  moderator.click_link "New quiz"
+  moderator.fill_in "Title", with: "Live browser verification #{Process.pid}"
+  moderator.click_button "Save quiz"
+  quiz_url = moderator.current_url
+  [ [ "Pick the planet", true, [ "Mars", "Moon" ], [ 1 ] ],
+    [ "Inactive question", false, [ "Hidden yes", "Hidden no" ], [ 1 ] ],
+    [ "Pick a language", true, [ "Ruby", "Python", "Rails" ], [ 1, 2 ] ],
+    [ "Last question", true, [ "Yes", "No" ], [ 1 ] ] ].each do |text, active, options, correct|
+    moderator.click_link "Add question"
+    moderator.fill_in "Question", with: text
+    options.each_with_index { |option, index| moderator.fill_in "Option #{index + 1}", with: option }
+    correct.each { |index| moderator.check "Option #{index} is correct" }
+    moderator.uncheck "Active" unless active
+    moderator.click_button "Save question"
+  end
+  moderator.click_button "Start a game"
+  moderator.assert_text "Players: 0"
+  moderator.assert_selector ".qr svg"
+  moderator.assert_selector "[data-connection-status]", exact_text: "Live"
+  game_url = moderator.current_url
+  join_url = moderator.find("[data-join-url]").text
+  moderator.execute_script("window.liveSentinel = 'still-here'")
+  moderator.save_screenshot("storage/screenshots/live-lobby.png", full: true)
+
+  join(alice, join_url, "Alice")
+  join(bob, join_url, "Bob")
+  moderator.assert_text "Players: 2"
+  # Reopening the same URL must not create a third player.
+  alice.visit join_url
+  alice.assert_text "Hi, Alice!"
+  alice.assert_no_selector :field, "Your name"
+  alice.execute_script("window.liveSentinel = 'still-here'")
+  moderator.assert_text "Players: 2"
+  verify("distinct, remembered players appear live in the lobby") { true }
+
+  moderator.click_button "Start"
+  moderator.assert_text "Question 1 of 3"
+  moderator.assert_text "Answers: 0 / 2"
+  alice.assert_text "Pick the planet"
+  bob.assert_text "Pick the planet"
+  verify("open phone HTML contains no correctness flags or future question") do
+    !alice.html.match?(/correct|Pick a language|Inactive question/i)
+  end
+  alice.click_button "Moon"
+  alice.within("button", text: "Moon") { alice.assert_text "Your answer" }
+  moderator.assert_text "Answers: 1 / 2"
+  alice.click_button "Mars"
+  alice.within("button", text: "Mars") { alice.assert_text "Your answer" }
+  bob.click_button "Moon"
+  bob.within("button", text: "Moon") { bob.assert_text "Your answer" }
+  moderator.assert_text "Answers: 2 / 2"
+  moderator.save_screenshot("storage/screenshots/live-question.png", full: true)
+  alice.save_screenshot("storage/screenshots/live-phone.png", full: true)
+  moderator.click_button "Finish"
+  alice.assert_text "Correct!"
+  bob.assert_text "Wrong!"
+  moderator.within("li.stage-option", text: "Mars") do
+    moderator.assert_text "1 answer"
+    moderator.assert_text "Correct"
+  end
+  moderator.within("li.stage-option", text: "Moon") { moderator.assert_text "1 answer" }
+  verify("latest picks count and reveal on every screen without navigation") do
+    [ moderator, alice, bob ].all? { |page| page.evaluate_script("window.liveSentinel") == "still-here" }
+  end
+  moderator.save_screenshot("storage/screenshots/live-reveal.png", full: true)
+
+  moderator.click_button "Next"
+  alice.assert_text "Pick a language"
+  moderator.assert_text "Question 2 of 3"
+  moderator.assert_text "Answers: 0 / 2"
+  bob.driver.quit
+  moderator.assert_text "Answers: 0 / 1"
+  verify("disconnected phones no longer inflate the denominator") { true }
+  join(late, join_url, "Late player")
+  late.assert_text "Pick a language"
+  moderator.assert_text "Answers: 0 / 2"
+  late.click_button "Python"
+  moderator.assert_text "Answers: 1 / 2"
+  moderator.click_button "Finish"
+  alice.assert_text "No answer"
+  late.assert_text "Correct!"
+  moderator.assert_selector ".stage-option__mark", text: "Correct", count: 2
+  moderator.click_button "Next"
+  moderator.assert_text "Question 3 of 3"
+  alice.assert_text "Last question"
+  alice.click_button "Yes"
+  moderator.assert_text "Answers: 1 / 2"
+  moderator.click_button "Finish"
+  moderator.assert_selector :button, "End quiz"
+  moderator.assert_no_selector :button, "Next"
+  moderator.click_button "End quiz"
+  [ moderator, alice, late ].each { |page| page.assert_text "The quiz is over" }
+  late.visit join_url
+  late.assert_text "The quiz is over"
+  late.assert_no_selector :button, "Join"
+  verify("late join, multiple correct options, unanswered feedback, and end are live") { true }
+  verify("phone layout does not overflow") do
+    alice.evaluate_script("document.documentElement.scrollWidth <= innerWidth")
+  end
+
+  moderator.visit quiz_url
+  moderator.click_button "Start a game"
+  moderator.assert_text "Players: 0"
+  replay_url = moderator.find("[data-join-url]").text
+  verify("rehearsal and replay have independent join links") { replay_url != join_url && moderator.current_url != game_url }
+  alice.visit replay_url
+  alice.assert_selector :field, "Your name"
+  moderator.visit quiz_url
+  moderator.click_link "Settings"
+  moderator.accept_confirm { moderator.click_button "Delete quiz" }
+  puts "Live browser smoke test completed."
+ensure
+  all_sessions.each { |page| page.driver.quit }
+end
