 The browser smoke script expects a running production server at `http://127.0.0.1:3000`, Chromium at `/usr/bin/chromium`, and the credentials `moderator` / `test-password` unless overridden by the two moderator environment variables. `APP_URL` can override the server URL. It creates and deletes its own quiz, checks the full UI workflow and phone layouts, and saves screenshots under `storage/screenshots/`. A failed run intentionally leaves its quiz available for debugging.
@@ -50,3 +53,18 @@ An import is all-or-nothing. Errors identify invalid JSON, an invalid field type
 The transfer browser smoke script uses the same server, Chromium, and credentials as the main browser script. It checks exported content, duplicate-title imports, invalid imports, defaults, mobile layouts, and escaping, and deletes its test quizzes on success. Run the two browser scripts sequentially.
 
 See [quiz portability notes](docs/quiz-portability.md) for the format, defaults, and validation decisions.
+
+## Live games
+
+On a quiz, click **Start a game** to open the moderator's big screen. Share the
+join URL or local QR code; players enter **Your name** and **Join**, with no account.
+Use **Start**, **Finish**, **Next**, and **End quiz** to control the run. The big screen,
+answer counters, and phones update live. Players can change their answer until
+Finish, and their browser remembers their identity and saved choices.
+
+Each run snapshots the active questions and has separate players and answers.
+Correct answers are never sent to phones before the question is closed. WebSockets
+provide instant updates, with reconnect recovery and a lightweight HTTP fallback.
+The configured single Puma process shares the local Action Cable adapter; no
+external service or background worker is required. See [live-game design notes](docs/live-games.md)
+for presence semantics, state invariants, privacy, and deployment details.
diff --git a/app/assets/javascripts/live_game.js b/app/assets/javascripts/live_game.js
new file mode 100644
index 0000000..2c31c38
--- /dev/null
+++ b/app/assets/javascripts/live_game.js
@@ -0,0 +1,157 @@
+// Cable sends tiny invalidations, never answers. The server renders only the
+// information this browser is entitled to see, with recovery via ordinary HTTP.
+(() => {
+  const root = document.querySelector("[data-live-game]");
+  if (!root) return;
+  const panel = root.querySelector("#live-state");
+  const status = root.querySelector("[data-connection-status]");
+  const error = root.querySelector("[data-live-error]");
+  if (panel.firstElementChild.dataset.ended === "true") { status.textContent = ""; return; }
+  let version = panel.firstElementChild.dataset.version;
+  let revision = Number(panel.firstElementChild.dataset.revision);
+  let connected = false;
+  let refreshing = false;
+  let dirty = false;
+  let posting = false;
+  let pending = null;
+  let scheduled = null;
+  let epoch = 0;
+  let stopped = false;
+
+  const requestOptions = {
+    credentials: "same-origin",
+    cache: "no-store",
+    headers: { "Accept": "text/html", "X-Requested-With": "XMLHttpRequest" }
+  };
+
+  async function display(response, expectedEpoch = null) {
+    if (!(response.ok || response.status === 409)) throw new Error("Request failed");
+    if (response.status === 204) return;
+    const nextVersion = response.headers.get("X-Quizzy-Version");
+    const nextRevision = Number(response.headers.get("X-Quizzy-Revision"));
+    const html = await response.text();
+    if (expectedEpoch !== null && (expectedEpoch !== epoch || posting)) { dirty = true; return; }
+    if (nextVersion === version || nextRevision < revision) return;
+    const focused = document.activeElement?.id;
+    panel.innerHTML = html;
+    version = nextVersion;
+    revision = nextRevision;
+    if (focused) document.getElementById(focused)?.focus({ preventScroll: true });
+    if (panel.firstElementChild.dataset.ended === "true") {
+      stopped = true;
+      clearInterval(timer);
+      clearTimeout(scheduled);
+      consumer.disconnect();
+      status.textContent = "";
+    }
+  }
+
+  function scheduleRefresh() {
+    dirty = true;
+    if (scheduled || stopped) return;
+    // Collapse bursts of answer notifications, with jitter to spread Wi-Fi load.
+    scheduled = setTimeout(() => { scheduled = null; refresh(); }, 80 + Math.random() * 170);
+  }
+
+  async function refresh() {
+    if (refreshing || posting || stopped) { dirty = true; return; }
+    refreshing = true;
+    dirty = false;
+    const started = epoch;
+    const url = new URL(root.dataset.stateUrl, location.href);
+    if (!connected) url.searchParams.set("fallback", "1");
+    try {
+      const response = await fetch(url, {
+        ...requestOptions,
+        headers: { ...requestOptions.headers, "X-Quizzy-Version": version },
+        signal: AbortSignal.timeout(10000)
+      });
+      if (started === epoch && !posting) {
+        await display(response, started);
+        if (!stopped) status.textContent = connected ? "Live" : "Live · reconnecting to instant updates…";
+      } else {
+        dirty = true;
+      }
+    } catch (_) {
+      status.textContent = "Connection interrupted. Reconnecting…";
+    } finally {
+      refreshing = false;
+      if (dirty) scheduleRefresh();
+    }
+  }
+
+  root.addEventListener("submit", (event) => {
+    if (!event.target.matches("[data-live-form]")) return;
+    event.preventDefault();
+    pending = { url: event.target.action, body: new FormData(event.target) };
+    submit();
+  });
+
+  async function submit() {
+    if (posting) return; // Latest tap is queued, rather than racing earlier taps.
+    posting = true;
+    epoch += 1;
+    panel.setAttribute("aria-busy", "true");
+    while (pending) {
+      const submission = pending;
+      pending = null;
+      error.textContent = "";
+      try {
+        const response = await fetch(submission.url, {
+          ...requestOptions, method: "POST", body: submission.body,
+          headers: { ...requestOptions.headers, "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content },
+          signal: AbortSignal.timeout(10000)
+        });
+        await display(response);
+      } catch (_) {
+        error.textContent = "Could not confirm your submission. Please check your connection and try again.";
+      }
+    }
+    posting = false;
+    panel.removeAttribute("aria-busy");
+    scheduleRefresh();
+  }
+
+  const consumer = ActionCable.createConsumer("/cable");
+  const subscription = consumer.subscriptions.create({
+    channel: "GameChannel", code: root.dataset.code,
+    role: root.dataset.role, token: root.dataset.token
+  }, {
+    connected() { connected = true; status.textContent = "Live"; scheduleRefresh(); },
+    disconnected() { connected = false; if (!stopped) status.textContent = "Reconnecting…"; },
+    rejected() { connected = false; scheduleRefresh(); },
+    received() { scheduleRefresh(); }
+  });
+
+  // Heartbeats renew presence; a low-frequency read also heals any missed event.
+  // Without a socket, poll at a modest rate until Action Cable reconnects.
+  let ticks = 0;
+  function tick() {
+    ticks += 1;
+    if (connected && ticks % 3 === 0) subscription.perform("heartbeat");
+    if (!connected || ticks % 4 === 0) scheduleRefresh();
+  }
+  let timer = setInterval(tick, 5000);
+  window.addEventListener("online", scheduleRefresh);
+  document.addEventListener("visibilitychange", () => {
+    if (!document.hidden) {
+      if (connected) subscription.perform("heartbeat");
+      scheduleRefresh();
+    }
+  });
+  window.addEventListener("pagehide", () => {
+    stopped = true;
+    clearInterval(timer);
+    clearTimeout(scheduled);
+    consumer.disconnect();
+  });
+  window.addEventListener("pageshow", (event) => {
+    if (event.persisted && panel.firstElementChild.dataset.ended !== "true") {
+      stopped = false;
+      scheduled = null;
+      consumer.connect();
+      timer = setInterval(tick, 5000);
+      scheduleRefresh();
+    }
+  });
+})();
