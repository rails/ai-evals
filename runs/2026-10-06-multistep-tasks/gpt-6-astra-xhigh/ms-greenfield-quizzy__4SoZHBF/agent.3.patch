+#!/usr/bin/env ruby
+# Exercises missed events, remembered answers, multi-tab presence, and HTTP fallback.
+require "bundler/setup"
+require "capybara/cuprite"
+require "json"
+
+Capybara.register_driver(:recovery_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app,
+    browser_path: "/usr/bin/chromium", window_size: [ 1100, 850 ],
+    browser_options: { "no-sandbox" => nil, "disable-dev-shm-usage" => nil },
+    timeout: 15, process_timeout: 30, js_errors: true)
+end
+Capybara.default_max_wait_time = 12
+Capybara.run_server = false
+Capybara.app_host = ENV.fetch("APP_URL", "http://127.0.0.1:3000")
+moderator, phone, fallback = Array.new(3) { Capybara::Session.new(:recovery_chromium) }
+
+def join(page, url, name)
+  page.visit url
+  page.fill_in "Your name", with: name
+  page.click_button "Join"
+  page.assert_text "Hi, #{name}!"
+end
+
+begin
+  moderator.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "test-password"))
+  moderator.visit "/moderate"
+  moderator.click_button "Import quiz"
+  moderator.fill_in "Quiz JSON", with: {
+    title: "Network recovery #{Process.pid}",
+    questions: [ { text: "Network question?", options: [ { text: "Yes", correct: true }, { text: "No", correct: false } ] } ]
+  }.to_json
+  moderator.click_button "Import"
+  quiz_url = moderator.current_url
+  moderator.click_button "Start a game"
+  url = moderator.find("[data-join-url]").text
+  join(phone, url, "Alice")
+  moderator.assert_text "Players: 1"
+  second_window = phone.open_new_window
+  phone.within_window(second_window) do
+    phone.visit url
+    phone.assert_text "Hi, Alice!"
+    phone.assert_no_selector :field, "Your name"
+  end
+  moderator.assert_text "Players: 1"
+  second_window.close
+  moderator.assert_text "Players: 1"
+  puts "PASS: multiple tabs share an identity without inflating presence"
+
+  # Replace only the WebSocket transport before application scripts run. HTTP
+  # stays real, so this checks the actual fallback rather than faking responses.
+  fallback.driver.browser.evaluate_on_new_document(<<~JS)
+    const NativeSocket = window.WebSocket;
+    window.WebSocket = class extends NativeSocket {
+      constructor(url, protocols) {
+        super(url, protocols);
+        this.addEventListener('open', () => this.close());
+      }
+    };
+  JS
+  join(fallback, url, "No socket")
+  moderator.assert_text "Players: 2"
+  moderator.click_button "Start"
+  phone.assert_text "Network question?"
+  fallback.assert_text "Network question?"
+  fallback.assert_selector "[data-connection-status]", text: /reconnecting/i
+  fallback.click_button "No"
+  fallback.within("button", text: "No") { fallback.assert_text "Your answer" }
+  moderator.assert_text "Answers: 1 / 2"
+  puts "PASS: blocked WebSockets fall back to live HTTP updates and answers"
+
+  phone.click_button "Yes"
+  phone.within("button", text: "Yes") { phone.assert_text "Your answer" }
+  moderator.assert_text "Answers: 2 / 2"
+  phone.visit url
+  phone.within("button", text: "Yes") { phone.assert_text "Your answer" }
+  phone.execute_script("window.recoverySentinel = 'same-document'")
+  phone.driver.browser.network.offline_mode
+  moderator.click_button "Finish"
+  fallback.assert_text "Wrong!"
+  phone.driver.browser.network.emulate_network_conditions(offline: false)
+  phone.execute_script("window.dispatchEvent(new Event('online'))")
+  phone.assert_text "Correct!"
+  raise "Recovery navigated away" unless phone.evaluate_script("window.recoverySentinel") == "same-document"
+  puts "PASS: an interrupted phone recovers missed results and its saved answer without navigation"
+  moderator.click_button "End quiz"
+  phone.assert_text "The quiz is over"
+  fallback.assert_text "The quiz is over"
+  moderator.visit quiz_url
+  moderator.click_link "Settings"
+  moderator.accept_confirm { moderator.click_button "Delete quiz" }
+ensure
+  [ moderator, phone, fallback ].each { |session| session.driver.quit }
+end
