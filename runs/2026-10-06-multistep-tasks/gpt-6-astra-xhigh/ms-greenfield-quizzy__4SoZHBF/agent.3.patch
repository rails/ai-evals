+require "test_helper"
+
+class GameChannelTest < ActionCable::Channel::TestCase
+  setup do
+    @game = Game.for_quiz!(Quiz.create!(title: "Live"))
+    @player = @game.join!("signed-browser-digest", "Alice")
+  end
+
+  test "anonymous subscription can only listen for public state changes" do
+    stub_connection browser_digest: nil
+    subscribe code: @game.code, player_id: @player.id
+    assert subscription.confirmed?
+    assert_has_stream "game:#{@game.id}:public"
+    assert_equal [ "game:#{@game.id}:public" ], subscription.streams
+    assert_equal 0, @game.player_count
+  end
+
+  test "player identity comes from signed cookies rather than subscription parameters" do
+    stub_connection browser_digest: @player.browser_digest
+    subscribe code: @game.code
+    assert subscription.confirmed?
+    assert_has_stream "player:#{@player.id}"
+    assert_equal 1, @game.player_count
+    perform :heartbeat
+    assert_equal 1, @player.player_presences.count
+    unsubscribe
+    assert_equal 0, @game.player_count
+  end
+
+  test "moderator counter stream requires a game-scoped signed ticket" do
+    stub_connection browser_digest: nil
+    subscribe code: @game.code, role: "moderator", token: @game.moderator_token
+    assert subscription.confirmed?
+    assert_has_stream "game:#{@game.id}:moderator"
+  end
+
+  test "forged and other-game moderator tickets are rejected" do
+    stub_connection browser_digest: nil
+    subscribe code: @game.code, role: "moderator", token: "forged"
+    assert subscription.rejected?
+    other = Game.for_quiz!(@game.quiz)
+    subscribe code: @game.code, role: "moderator", token: other.moderator_token
+    assert subscription.rejected?
+  end
+
+  test "unknown games are rejected" do
+    stub_connection browser_digest: nil
+    subscribe code: "NONEXISTENT"
+    assert subscription.rejected?
+  end
+end
