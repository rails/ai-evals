diff --git a/app/models/player_presence.rb b/app/models/player_presence.rb
new file mode 100644
index 0000000..bceabbd
--- /dev/null
+++ b/app/models/player_presence.rb
@@ -0,0 +1,21 @@
+class PlayerPresence < ApplicationRecord
+  LEASE = 45.seconds
+  belongs_to :player
+  scope :alive, -> { where("expires_at > ?", Time.current) }
+  after_commit :notify, on: [ :create, :destroy ]
+
+  def self.renew(player, key)
+    presence = find_or_initialize_by(player: player, connection_key: key)
+    expired = presence.persisted? && presence.expires_at <= Time.current
+    presence.update!(expires_at: LEASE.from_now)
+    presence.notify if expired
+    presence
+  rescue ActiveRecord::RecordNotUnique
+    # Two tabs may establish the same temporary HTTP lease simultaneously.
+    retry
+  end
+
+  def notify
+    player.game.notify_moderator
+  end
+end
