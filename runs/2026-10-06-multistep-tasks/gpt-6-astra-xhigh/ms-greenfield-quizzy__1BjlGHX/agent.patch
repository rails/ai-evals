+++ b/script/timer_smoke.rb
@@ -0,0 +1,158 @@
+# Against bin/serve: bundle exec ruby script/timer_smoke.rb
+require "bundler/setup"
+require "capybara/cuprite"
+require "minitest/autorun"
+require "securerandom"
+require "fileutils"
+require "json"
+
+Capybara.register_driver(:timer_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: ENV.fetch("CHROMIUM_PATH", "/usr/bin/chromium"),
+    window_size: [1440, 1000], browser_options: { "no-sandbox" => nil, "disable-dev-shm-usage" => nil },
+    process_timeout: 20, timeout: 10, js_errors: true)
+end
+Capybara.enable_aria_label = true
+Capybara.run_server = false
+Capybara.app_host = ENV.fetch("APP_URL", "http://localhost:3000")
+Capybara.default_max_wait_time = 5
+
+class TimerSmokeTest < Minitest::Test
+  def setup
+    @sessions = []
+    @mod = browser
+    @mod.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "test-password"))
+    @phone = browser
+    @phone.current_window.resize_to(390, 844)
+    @fallback = browser
+    @fallback.driver.browser.page.command("Page.addScriptToEvaluateOnNewDocument", source: <<~JS)
+      window.WebSocket = class extends WebSocket {
+        constructor() { super('ws://' + location.host + '/blocked-websocket'); }
+      };
+    JS
+  end
+
+  def browser
+    Capybara::Session.new(:timer_chromium).tap { |session| @sessions << session }
+  end
+
+  def teardown
+    FileUtils.mkdir_p("storage/screenshots")
+    @sessions.each_with_index do |session, index|
+      session.save_screenshot("storage/screenshots/timer-failure-#{index}.png") unless passed?
+      session.driver.quit
+    end
+  end
+
+  def settings(minutes, seconds)
+    @mod.visit @quiz_url
+    @mod.click_link "Settings"
+    @mod.fill_in "Timer minutes", with: minutes
+    @mod.fill_in "Timer seconds", with: seconds
+    @mod.click_button "Save quiz"
+    @mod.click_link "Settings"
+    assert @mod.has_field?("Timer minutes", with: minutes.to_s)
+    assert @mod.has_field?("Timer seconds", with: seconds.to_s)
+    @mod.click_link "Cancel"
+  end
+
+  def start_game
+    @mod.click_button "Start a game"
+    @game_url = @mod.current_url
+    @join_url = @mod.find('[data-join-link]').text
+    assert @mod.has_no_selector?('[data-timer]')
+  end
+
+  def test_countdown_reload_finish_and_no_timer
+    title = "Timer smoke #{SecureRandom.hex(4)}"
+    document = { title: title, questions: 3.times.map { |i|
+      { text: "Timed question #{i + 1}", options: [{ text: "Yes", correct: true }, { text: "No", correct: false }] }
+    } }
+    @mod.visit "/moderate"
+    @mod.click_button "Import quiz"
+    @mod.fill_in "Quiz JSON", with: JSON.generate(document)
+    @mod.click_button "Import", exact: true
+    assert @mod.has_text?(title)
+    @quiz_url = @mod.current_url
+    @mod.click_link "Settings"
+    assert @mod.has_field?("Timer minutes", with: "0")
+    assert @mod.has_field?("Timer seconds", with: "0")
+    @mod.click_link "Cancel"
+
+    settings(1, 30)
+    @mod.click_link "Export"
+    json = JSON.parse(@mod.find('pre').text)
+    refute json.keys.any? { |key| key.include?("timer") }
+    @mod.visit @quiz_url
+    start_game
+    @mod.click_button "Start", exact: true
+    assert @mod.has_selector?('[data-timer]', text: '1:30', exact_text: true)
+    sleep 2.1
+    @mod.visit @game_url
+    assert @mod.has_selector?('[data-timer]', text: /1:2[0-8]/)
+    @mod.click_button "Finish", exact: true
+    assert @mod.has_button?("Next", exact: true)
+    assert @mod.has_no_selector?('[data-timer]')
+
+    settings(0, 5)
+    start_game
+    [@phone, @fallback].each_with_index do |phone, index|
+      phone.visit @join_url
+      phone.fill_in "Your name", with: "Player #{index}"
+      phone.click_button "Join", exact: true
+      assert phone.has_text?("Waiting for the quiz to start")
+      phone.execute_script('window.noReload = true')
+    end
+    @mod.click_button "Start", exact: true
+    assert @mod.has_selector?('[data-timer]', text: '0:05', exact_text: true)
+    [@phone, @fallback].each do |phone|
+      assert phone.has_button?("Yes", exact: true)
+      assert phone.has_no_selector?('[data-timer]', visible: :all, wait: 0)
+      state = phone.evaluate_async_script("fetch(location.pathname + '/state').then(r => r.json()).then(arguments[0])")
+      refute state.key?("timer")
+      refute_match(/closes_at|server_now/, JSON.generate(state))
+    end
+    @phone.click_button "Yes", exact: true
+    assert @phone.has_selector?('button.is-picked')
+    sleep 1.1
+    @mod.visit @game_url
+    assert @mod.has_selector?('[data-timer]', text: /0:0[1-4]/)
+    assert @mod.has_button?("Next", exact: true, wait: 7)
+    assert @phone.has_text?("Correct!")
+    assert @fallback.has_text?("No answer")
+    assert @phone.evaluate_script('window.noReload')
+    assert @fallback.evaluate_script('window.noReload')
+
+    @mod.click_button "Next", exact: true
+    assert @mod.has_selector?('[data-timer]', text: '0:05', exact_text: true)
+    @mod.click_button "Finish", exact: true
+    assert @mod.has_button?("Next", exact: true)
+    assert @mod.has_no_selector?('[data-timer]')
+    # Leaving all game screens tests the server worker, not a browser timeout.
+    @mod.click_button "Next", exact: true
+    @sessions.each { |session| session.visit 'about:blank' }
+    sleep 5.5
+    # Read the persisted phase directly; a game HTTP read could itself reconcile it.
+    game_id = @game_url.split('/').last
+    require "sqlite3"
+    phase = SQLite3::Database.new("storage/production.sqlite3", readonly: true).get_first_value("SELECT phase FROM games WHERE id = ?", [Integer(game_id)])
+    assert_equal 'closed', phase
+    @mod.visit @game_url
+    assert @mod.has_button?("End quiz", exact: true)
+    @mod.click_button "End quiz", exact: true
+    assert @mod.has_text?("The quiz is over")
+
+    settings(0, 0)
+    start_game
+    @mod.click_button "Start", exact: true
+    assert @mod.has_text?("Timed question 1")
+    assert @mod.has_no_selector?('[data-timer]')
+    sleep 5.5
+    assert @mod.has_button?("Finish", exact: true)
+    @mod.click_button "Finish", exact: true
+    assert @mod.has_button?("Next", exact: true)
+    @mod.visit @quiz_url
+    @mod.click_link "Settings"
+    @mod.accept_confirm { @mod.click_button "Delete quiz" }
+    assert @mod.has_text?("Quizzes")
+  end
+end
