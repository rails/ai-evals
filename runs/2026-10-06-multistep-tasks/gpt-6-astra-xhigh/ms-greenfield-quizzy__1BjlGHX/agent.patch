+# Against bin/serve: bundle exec ruby script/prizes_smoke.rb
+require "bundler/setup"
+require "capybara/cuprite"
+require "minitest/autorun"
+require "securerandom"
+require "fileutils"
+require "json"
+
+Capybara.register_driver(:prizes_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: ENV.fetch("CHROMIUM_PATH", "/usr/bin/chromium"),
+    window_size: [1440, 1000], browser_options: { "no-sandbox" => nil, "disable-dev-shm-usage" => nil },
+    process_timeout: 20, timeout: 10, js_errors: true)
+end
+Capybara.enable_aria_label = true
+Capybara.run_server = false
+Capybara.app_host = ENV.fetch("APP_URL", "http://localhost:3000")
+Capybara.default_max_wait_time = 5
+
+class PrizesSmokeTest < Minitest::Test
+  def setup
+    @sessions = []
+    @mod = browser
+    @mod.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "test-password"))
+    @phones = %w[Alice Bob Charlie Dana Zero].to_h { |name| [name, browser(phone: true)] }
+    # Bob can still follow the game and win with WebSockets blocked.
+    @phones["Bob"].driver.browser.page.command("Page.addScriptToEvaluateOnNewDocument", source: <<~JS)
+      window.WebSocket = class extends WebSocket {
+        constructor() { super('ws://' + location.host + '/blocked-websocket'); }
+      };
+    JS
+  end
+
+  def browser(phone: false)
+    Capybara::Session.new(:prizes_chromium).tap do |session|
+      @sessions << session
+      session.current_window.resize_to(390, 844) if phone
+    end
+  end
+
+  def teardown
+    FileUtils.mkdir_p("storage/screenshots")
+    @sessions.each_with_index do |session, index|
+      session.save_screenshot("storage/screenshots/prizes-failure-#{index}.png") unless passed?
+      session.driver.quit
+    end
+  end
+
+  def text(session, expected)
+    assert session.has_text?(expected), "Expected #{expected.inspect}: #{session.text}"
+  end
+
+  def pick(name, choice)
+    phone = @phones.fetch(name)
+    phone.click_button choice, exact: true
+    assert phone.has_selector?("button.is-picked", text: /#{choice}.*Your answer/m)
+  end
+
+  def winners
+    @mod.all(".leaderboard-row.is-winner .leaderboard-name").map(&:text)
+  end
+
+  def check_phones(names)
+    @phones.each do |name, phone|
+      if names.include?(name)
+        text(phone, "You won!")
+      else
+        assert phone.has_no_text?("You won!"), "#{name} should not have won"
+      end
+    end
+  end
+
+  def test_prizes_live_on_five_phones_and_two_big_screens
+    title = "Prizes smoke #{SecureRandom.hex(4)}"
+    document = { title: title, questions: 2.times.map { |i|
+      { text: "Prize question #{i + 1}", options: [{ text: "Yes", correct: true }, { text: "No", correct: false }] }
+    } }
+    @mod.visit "/moderate"
+    @mod.click_button "Import quiz"
+    @mod.fill_in "Quiz JSON", with: JSON.generate(document)
+    @mod.click_button "Import", exact: true
+    text(@mod, title)
+    quiz_url = @mod.current_url
+    @mod.click_link "Settings"
+    assert @mod.has_field?("Number of winners", with: "3")
+    @mod.fill_in "Number of winners", with: "2"
+    @mod.click_button "Save quiz"
+    @mod.click_link "Settings"
+    assert @mod.has_field?("Number of winners", with: "2")
+    @mod.fill_in "Number of winners", with: "3"
+    @mod.click_button "Save quiz"
+    @mod.click_button "Start a game"
+    game_url = @mod.current_url
+    join_url = @mod.find("[data-join-link]").text
+    @phones.each do |name, phone|
+      phone.visit join_url
+      phone.fill_in "Your name", with: name
+      phone.click_button "Join", exact: true
+      text(phone, "Waiting for the quiz to start")
+      phone.execute_script("window.noReload = true")
+    end
+    text(@mod, "Players: 5")
+    @sessions.each do |session|
+      session.execute_script(<<~JS)
+        window.phaseSeenAt = null;
+        const observer = new MutationObserver(() => {
+          if (document.querySelector('[data-game-content]').textContent.includes('Prize question 1')) {
+            window.phaseSeenAt = Date.now();
+            observer.disconnect();
+          }
+        });
+        observer.observe(document.querySelector('[data-game-content]'), { childList: true, subtree: true });
+      JS
+    end
+    started_at = Time.now.to_f * 1000
+    @mod.click_button "Start", exact: true
+    @sessions.each { |session| text(session, "Prize question 1") }
+    latencies = @sessions.map { |session| session.evaluate_script("window.phaseSeenAt") - started_at }
+    assert_operator latencies.max, :<, 1500
+    puts "Question delivery after Start (ms): #{latencies.map(&:round).inspect}"
+    %w[Bob Charlie Dana Alice].each { |name| pick(name, "Yes") }
+    pick("Zero", "No")
+    @phones.each_value { |phone| assert phone.has_no_text?(/\d+ points?/) }
+    @mod.click_button "Finish", exact: true
+    text(@phones["Alice"], "Correct!")
+    @mod.click_button "Next", exact: true
+    @phones.each_value { |phone| text(phone, "Prize question 2") }
+    pick("Alice", "Yes")
+    @mod.click_button "Finish", exact: true
+    @mod.click_button "End quiz", exact: true
+    text(@mod, "Leaderboard")
+    assert_equal ["1 Alice 2 points", "2 Bob 1 point", "3 Charlie 1 point", "4 Dana 1 point", "5 Zero 0 points"], @mod.all(".leaderboard > li").map { |row| row.text.split.join(" ") }
+    @phones.each_with_index do |(name, phone), index|
+      text(phone, "Place #{index + 1} of 5")
+      text(phone, name == "Alice" ? "2 points" : name == "Zero" ? "0 points" : "1 point")
+      assert phone.evaluate_script("window.noReload"), "Live changes reloaded #{name}'s page"
+      assert phone.evaluate_script("document.documentElement.scrollWidth <= innerWidth")
+    end
+    original_window = @mod.current_window
+    extra_window = @mod.open_new_window
+    @mod.within_window(extra_window) { @mod.visit game_url; text(@mod, "Leaderboard") }
+    @mod.click_button "Top 3", exact: true
+    assert @mod.has_selector?(".winner-mark", count: 3)
+    assert_equal %w[Alice Bob Charlie], winners
+    check_phones(winners)
+    @mod.within_window(extra_window) { assert @mod.has_selector?(".winner-mark", count: 3) }
+    @phones["Bob"].visit join_url
+    text(@phones["Bob"], "You won!")
+    @mod.click_button "Reset winners"
+    assert @mod.has_no_selector?(".winner-mark")
+    check_phones([])
+    8.times do
+      @mod.click_button "Draw", exact: true
+      assert @mod.has_button?("Draw", disabled: false)
+      assert @mod.has_selector?(".winner-mark", count: 3)
+      names = winners
+      assert_includes names, "Alice"
+      refute_includes names, "Zero"
+      check_phones(names)
+    end
+    @mod.within_window(extra_window) { assert @mod.has_selector?(".winner-mark", count: 3) }
+    FileUtils.mkdir_p("storage/screenshots")
+    @mod.save_screenshot("storage/screenshots/prizes-leaderboard.png")
+    @phones["Alice"].save_screenshot("storage/screenshots/prizes-phone.png")
+    @mod.click_button "Reset winners"
+    check_phones([])
+    @mod.within_window(extra_window) { assert @mod.has_no_selector?(".winner-mark") }
+    extra_window.close
+    @mod.switch_to_window(original_window)
+    @mod.visit quiz_url
+    @mod.click_link "Settings"
+    @mod.accept_confirm { @mod.click_button "Delete quiz" }
+    text(@mod, "Quizzes")
+  end
+end
