diff --git a/app/controllers/moderate/base_controller.rb b/app/controllers/moderate/base_controller.rb
new file mode 100644
index 0000000..b148a3f
--- /dev/null
+++ b/app/controllers/moderate/base_controller.rb
@@ -0,0 +1,22 @@
+module Moderate
+  class BaseController < ApplicationController
+    before_action :authenticate_moderator
+    before_action :disable_caching
+
+    private
+
+    def authenticate_moderator
+      authenticate_or_request_with_http_basic("Quizzy moderator") do |username, password|
+        expected_username = ENV["QUIZZY_MODERATOR_USERNAME"]
+        expected_password = ENV["QUIZZY_MODERATOR_PASSWORD"]
+        expected_username.present? && expected_password.present? &&
+          (ActiveSupport::SecurityUtils.secure_compare(username.to_s, expected_username) &
+           ActiveSupport::SecurityUtils.secure_compare(password.to_s, expected_password))
+      end
+    end
+
+    def disable_caching
+      response.headers["Cache-Control"] = "no-store, private"
+    end
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..a80c93b
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,47 @@
+module Moderate
+  class GamesController < BaseController
+    before_action :set_game, except: :create
+
+    def create
+      game = Game.from_quiz!(Quiz.find(params[:quiz_id]))
+      redirect_to moderate_game_path(game), status: :see_other
+    end
+
+    def show
+      @state = GameState.call(@game, moderator: true)
+      @join_url = play_url(@game.code)
+      @qr = RQRCode::QRCode.new(@join_url).as_svg(module_size: 6, standalone: true,
+        use_path: true, viewbox: true, fill: "ffffff", color: "0d0640")
+    end
+
+    def state
+      render json: GameState.call(@game, moderator: true)
+    end
+
+    def advance
+      @game.advance!(expected_phase: params[:phase], question_id: params[:question_id])
+      respond_to do |format|
+        format.json { render json: GameState.call(@game, moderator: true) }
+        format.html { redirect_to moderate_game_path(@game), status: :see_other }
+      end
+    rescue Game::Conflict
+      render json: { error: "The game has moved on. Please try again." }, status: :conflict
+    end
+
+    def winners
+      @game.select_winners!(params[:mode])
+      respond_to do |format|
+        format.json { render json: GameState.call(@game, moderator: true) }
+        format.html { redirect_to moderate_game_path(@game), status: :see_other }
+      end
+    rescue Game::Conflict
+      render json: { error: "Prizes can only be picked after the quiz ends." }, status: :conflict
+    end
+
+    private
+
+    def set_game
+      @game = Game.find(params[:id])
+    end
+  end
+end
