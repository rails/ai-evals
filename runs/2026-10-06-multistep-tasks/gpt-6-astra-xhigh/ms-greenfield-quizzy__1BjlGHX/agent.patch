@@ -0,0 +1,64 @@
+<% content_for :title, "#{@quiz.title} · Quizzy" %>
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head">
+  <div>
+    <h1><%= @quiz.title %></h1>
+    <div class="meta mt-2"><%= @questions.count(&:active?) %> of <%= @questions.size %> questions active · <%= link_to "Settings", edit_moderate_quiz_path(@quiz) %></div>
+  </div>
+  <div class="buttons">
+    <%= button_to "Start a game", moderate_quiz_games_path(@quiz), class: "btn btn--pink" %>
+    <%= link_to "Export", export_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+    <%= link_to "Preview", preview_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+  </div>
+</div>
+<section class="section mt-0" aria-labelledby="questions-heading">
+  <div class="section-head">
+    <h2 id="questions-heading">Questions</h2>
+    <%= link_to "Add question", new_moderate_quiz_question_path(@quiz), class: "btn" %>
+  </div>
+  <% if @questions.empty? %>
+    <div class="empty">No questions yet. Add your first question to get started.</div>
+  <% else %>
+    <ol class="question-list">
+      <% active_number = 0 %>
+      <% @questions.each_with_index do |question, index| %>
+        <li class="card question-item <%= "question-item--inactive" unless question.active? %>" id="question-<%= question.id %>">
+          <div class="question-item__num" aria-hidden="true"><%= question.active? ? (active_number += 1) : "—" %></div>
+          <div class="question-item__content">
+            <div class="question-item__body"><%= question.text %></div>
+            <ul class="question-item__options">
+              <% question.options.each_with_index do |option, option_index| %>
+                <li class="<%= "is-correct" if option["correct"] %>"><%= option_letter(option_index) %>. <%= option["text"] %><% if option["correct"] %><span class="sr-only"> (Correct)</span><% end %></li>
+              <% end %>
+            </ul>
+          </div>
+          <div class="question-item__actions">
+            <div class="buttons">
+              <%= button_to "↑", move_up_moderate_quiz_question_path(@quiz, question), method: :patch, class: "btn btn--ghost btn--icon", aria: { label: "Move up" }, title: "Move up", disabled: index.zero? %>
+              <%= button_to "↓", move_down_moderate_quiz_question_path(@quiz, question), method: :patch, class: "btn btn--ghost btn--icon", aria: { label: "Move down" }, title: "Move down", disabled: index == @questions.length - 1 %>
+            </div>
+            <%= form_with model: question, url: toggle_moderate_quiz_question_path(@quiz, question), method: :patch, data: { auto_submit: true } do |form| %>
+              <label class="checkbox" for="active-<%= question.id %>">
+                <%= form.check_box :active, id: "active-#{question.id}" %> Active
+              </label>
+            <% end %>
+            <div class="buttons">
+              <%= link_to "Edit", edit_moderate_quiz_question_path(@quiz, question), class: "btn btn--sm" %>
+              <%= button_to "Delete", moderate_quiz_question_path(@quiz, question), method: :delete, class: "btn btn--sm btn--danger", form: { data: { confirm: "Delete this question? This cannot be undone." } } %>
+            </div>
+          </div>
+        </li>
+      <% end %>
+    </ol>
+  <% end %>
+</section>
+<% if @quiz.games.exists? %>
+  <section class="section" aria-labelledby="games-heading">
+    <h2 id="games-heading">Games</h2>
+    <ul class="quiz-list">
+      <% @quiz.games.order(created_at: :desc).each do |game| %>
+        <li class="card live-history"><span><%= game.code %> · <%= game.phase == "ended" ? "The quiz is over" : game.phase.capitalize %></span><%= link_to "Open big screen", moderate_game_path(game), class: "btn btn--ghost btn--sm" %></li>
+      <% end %>
+    </ul>
+  </section>
+<% end %>
