diff --git a/test/models/prizes_test.rb b/test/models/prizes_test.rb
new file mode 100644
index 0000000..5e5432b
--- /dev/null
+++ b/test/models/prizes_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class PrizesTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper
+
+  setup do
+    @quiz = Quiz.create!(title: "Prizes", number_of_winners: 2)
+    2.times do |i|
+      @quiz.questions.create!(text: "Question #{i}", position: i + 1,
+        options: [{ text: "Yes", correct: true }, { text: "Also yes", correct: true }, { text: "No", correct: false }])
+    end
+    @game = Game.from_quiz!(@quiz)
+    @players = %w[Alice Bob Charlie Dana Zero].map { |name| @game.join!(name, name) }
+    @start = Time.utc(2026, 4, 1, 12)
+  end
+
+  def advance
+    @game.advance!(expected_phase: @game.phase, question_id: @game.current_question&.id)
+  end
+
+  def pick(player, option, seconds)
+    travel_to(@start + seconds, with_usec: true) { @game.answer!(player, @game.current_question.id, option) }
+  end
+
+  def finish_game
+    travel_to(@start) { advance }
+    pick(@players[0], 0, 3)
+    pick(@players[1], 1, 1)
+    pick(@players[2], 0, 2)
+    pick(@players[3], 0, 4)
+    pick(@players[4], 2, 0.5)
+    advance
+    travel_to(@start + 10) { advance }
+    pick(@players[0], 0, 20)
+    advance
+    advance
+  end
+
+  test "number of winners defaults to three and accepts only positive integers" do
+    assert_equal 3, Quiz.new.number_of_winners
+    [nil, 0, -1, 1.5, "abc"].each do |invalid|
+      assert_not Quiz.new(title: "Bad", number_of_winners: invalid).valid?, invalid.inspect
+    end
+    @quiz.update!(number_of_winners: 8)
+    assert_equal 2, @game.reload.number_of_winners
+    assert_equal 8, Game.from_quiz!(@quiz).number_of_winners
+  end
+
+  test "scores use last picks and sum only correct answer times from the common opening time" do
+    travel_to(@start, with_usec: true) { advance }
+    assert_equal @start, @game.current_question.opened_at
+    pick(@players[0], 0, 1)
+    pick(@players[0], 0, 9) # Even repeating the same option is a new last pick.
+    pick(@players[1], 2, 2)
+    pick(@players[1], 1, 3)
+    pick(@players[2], 0, 0.5)
+    pick(@players[2], 2, 12) # Correct, then wrong: zero for this question.
+    assert_equal @start + 9, @players[0].answers.first.picked_at
+    advance
+    travel_to(@start + 20, with_usec: true) { advance }
+    assert_equal @start + 20, @game.current_question.opened_at
+    pick(@players[0], 0, 21)
+    pick(@players[1], 0, 25)
+    pick(@players[2], 0, 21)
+    advance
+    advance
+    board = @game.leaderboard
+    assert_equal %w[Bob Alice Charlie Dana Zero], board.map { |row| row[:name] }
+    assert_equal [2, 2, 1, 0, 0], board.map { |row| row[:points] }
+    assert_equal [1, 2, 3, 4, 5], board.map { |row| row[:place] }
+    assert_equal board, @game.reload.leaderboard
+  end
+
+  test "top uses speed order and draw ignores speed at the points cutoff" do
+    finish_game
+    assert_equal %w[Alice Bob Charlie Dana Zero], @game.leaderboard.map { |row| row[:name] }
+    @game.select_winners!("top")
+    assert_equal %w[Alice Bob], @game.players.where(winner: true).order(:id).pluck(:name)
+    outcomes = []
+    random = Random.new(42)
+    40.times do
+      @game.select_winners!("draw", random: random)
+      names = @game.players.where(winner: true).pluck(:name)
+      assert_equal 2, names.length
+      assert_includes names, "Alice"
+      refute_includes names, "Zero"
+      outcomes.concat(names - ["Alice"])
+    end
+    assert_equal %w[Bob Charlie Dana], outcomes.uniq.sort
+    @game.select_winners!("reset")
+    assert_empty @game.players.where(winner: true)
+    assert @game.leaderboard.none? { |row| row[:winner] }
+  end
+
+  test "all positive players win when prizes outnumber them, never zero point players" do
+    finish_game
+    @game.update!(number_of_winners: 20)
+    %w[top draw].each do |mode|
+      @game.select_winners!(mode)
+      assert_equal %w[Alice Bob Charlie Dana], @game.players.where(winner: true).order(:id).pluck(:name)
+    end
+  end
+
+  test "no scores and empty games have no winners" do
+    5.times { advance }
+    %w[top draw reset].each do |mode|
+      @game.select_winners!(mode)
+      assert_empty @game.players.where(winner: true)
+    end
+    @game.players.destroy_all
+    @game.select_winners!("draw")
+    assert_empty @game.leaderboard
+  end
+
+  test "one prize draws among all equally scoring players regardless of speed" do
+    @game.update!(number_of_winners: 1)
+    travel_to(@start) { advance }
+    @players.first(4).each_with_index { |player, i| pick(player, 0, i + 1) }
+    advance
+    advance
+    advance
+    advance
+    @game.select_winners!("top")
+    assert_equal [@players.first.id], @game.players.where(winner: true).pluck(:id)
+    random = Random.new(123)
+    drawn = 40.times.map do
+      @game.select_winners!("draw", random: random)
+      assert_equal 1, @game.players.where(winner: true).count
+      @game.players.find_by!(winner: true).id
+    end
+    assert_equal @players.first(4).map(&:id).sort, drawn.uniq.sort
+  end
+
+  test "exact score and speed ties have stable distinct places" do
+    travel_to(@start) { advance }
+    @players.each { |player| pick(player, 0, 1) }
+    advance
+    advance
+    advance
+    advance
+    assert_equal @players.map(&:id), @game.reload.leaderboard.map { |row| row[:id] }
+    assert_equal [1, 2, 3, 4, 5], @game.leaderboard.map { |row| row[:place] }
+  end
+
+  test "selection is only allowed after the end and broadcasts every click after commit" do
+    assert_raises(Game::Conflict) { @game.select_winners!("top") }
+    finish_game
+    assert_raises(Game::Conflict) { @game.select_winners!("unknown") }
+    %w[top draw reset reset].each do |mode|
+      assert_broadcasts "game:#{@game.code}", 1 do
+        @game.select_winners!(mode)
+      end
+    end
+  end
+end
diff --git a/test/models/timer_test.rb b/test/models/timer_test.rb
new file mode 100644
index 0000000..505dc8a
--- /dev/null
+++ b/test/models/timer_test.rb
@@ -0,0 +1,143 @@
+require "test_helper"
+
+class TimerTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Timed talk", timer_minutes: 1, timer_seconds: 30)
+    2.times do |index|
+      @quiz.questions.create!(text: "Question #{index + 1}", position: index + 1,
+        options: [{ text: "Yes", correct: true }, { text: "No", correct: false }])
+    end
+    @game = Game.from_quiz!(@quiz)
+    @player = @game.join!("test-browser", "Alice")
+  end
+
+  def advance
+    @game.reload.advance!(expected_phase: @game.phase, question_id: @game.current_question&.id)
+  end
+
+  test "timer defaults and validation" do
+    quiz = Quiz.new(title: "Untimed")
+    assert_equal 0, quiz.timer_minutes
+    assert_equal 0, quiz.timer_seconds
+    assert_equal 0, quiz.timer_duration
+    %i[timer_minutes timer_seconds].each do |field|
+      [-1, 1.5, "no", nil].each do |invalid|
+        quiz.assign_attributes(timer_minutes: 0, timer_seconds: 0)
+        quiz.public_send("#{field}=", invalid)
+        assert_not quiz.valid?, "#{field} accepted #{invalid.inspect}"
+      end
+    end
+    quiz.assign_attributes(timer_minutes: 0, timer_seconds: 90)
+    assert quiz.valid?
+    assert_equal 90, quiz.timer_duration
+  end
+
+  test "deadline starts on open, survives reload and snapshots settings" do
+    assert_nil @game.current_question
+    assert @game.game_questions.all? { |q| q.closes_at.nil? }
+    @quiz.update!(timer_minutes: 0, timer_seconds: 2)
+    assert_equal 90, @game.timer_duration
+    travel_to Time.current.change(usec: 0) do
+      advance
+      question = @game.current_question
+      assert_equal Time.current, question.opened_at
+      assert_equal 90.seconds.from_now, question.closes_at
+      travel 7.seconds
+      state = GameState.call(@game, moderator: true)
+      assert_equal question.closes_at, Time.iso8601(state[:timer][:closes_at])
+      assert_equal Time.current, Time.iso8601(state[:timer][:server_now])
+      assert_equal question.closes_at, @game.reload.current_question.closes_at
+      assert_nil GameState.call(@game, player: @player)[:timer]
+      assert_nil GameState.call(@game)[:timer]
+    end
+  end
+
+  test "deadline finishes automatically without any browsers and does not advance twice" do
+    travel_to Time.current.change(usec: 0) do
+      advance
+      question = @game.current_question
+      @game.answer!(@player, question.id, 0)
+      travel 89.seconds
+      GameTimer.expire_due!
+      assert_equal "open", @game.reload.phase
+      travel 1.second
+      GameTimer.expire_due!
+      assert_equal "closed", @game.reload.phase
+      assert_equal "Correct!", GameState.call(@game, player: @player)[:result]
+      assert_nil GameState.call(@game, moderator: true)[:timer]
+      GameTimer.expire_due!
+      assert_equal "closed", @game.reload.phase
+      assert_raises(Game::Conflict) { @game.advance!(expected_phase: "open", question_id: question.id) }
+      assert_equal question.id, @game.reload.current_question.id
+      advance
+      assert_equal "open", @game.phase
+      assert_equal 90.seconds.from_now, @game.current_question.closes_at
+    end
+  end
+
+  test "late answers are rejected at the exact deadline even before the timer sweep" do
+    travel_to Time.current.change(usec: 0) do
+      advance
+      question = @game.current_question
+      travel 89.seconds
+      @game.answer!(@player, question.id, 0)
+      picked_at = @player.answers.first.picked_at
+      travel 1.second
+      assert_raises(Game::Conflict) { @game.answer!(@player, question.id, 1) }
+      assert_equal "closed", @game.reload.phase
+      assert_equal 0, @player.answers.first.option_index
+      assert_equal picked_at, @player.answers.first.picked_at
+    end
+  end
+
+  test "Finish can close early and the old deadline cannot close the next question" do
+    travel_to Time.current.change(usec: 0) do
+      advance
+      travel 5.seconds
+      advance
+      assert_equal "closed", @game.phase
+      advance
+      second = @game.current_question
+      travel 85.seconds
+      GameTimer.expire_due!
+      assert_equal "open", @game.reload.phase
+      assert_equal second.id, @game.current_question.id
+      travel 5.seconds
+      GameTimer.expire_due!
+      assert_equal "closed", @game.reload.phase
+      assert GameState.call(@game, moderator: true)[:last_question]
+      advance
+      assert_equal "ended", @game.phase
+    end
+  end
+
+  test "zero means no deadline and no automatic finish" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    @game = Game.from_quiz!(@quiz)
+    advance
+    assert_nil @game.current_question.closes_at
+    assert_nil GameState.call(@game, moderator: true)[:timer]
+    travel 1.day do
+      GameTimer.expire_due!
+      assert_equal "open", @game.reload.phase
+      advance
+      assert_equal "closed", @game.phase
+    end
+  end
+
+  test "state reads reconcile overdue games after downtime" do
+    advance
+    travel 2.minutes do
+      assert_equal "closed", GameState.call(@game, moderator: true)[:phase]
+      assert_equal "closed", @game.reload.phase
+    end
+  end
+
+  test "exports omit timer and imports ignore any supplied timer" do
+    exported = JSON.parse(QuizTransfer.export(@quiz))
+    assert_equal %w[number_of_winners questions title], exported.keys.sort
+    imported = QuizTransfer.import(exported.merge(timer_minutes: 4, timer_seconds: 12, timer_duration: 252).to_json)
+    assert_equal 0, imported.timer_minutes
+    assert_equal 0, imported.timer_seconds
+  end
+end
