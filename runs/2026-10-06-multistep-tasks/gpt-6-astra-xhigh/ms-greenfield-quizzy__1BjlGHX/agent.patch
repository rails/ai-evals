new file mode 100644
index 0000000..0a9355a
--- /dev/null
+++ b/config/puma.rb
@@ -0,0 +1,10 @@
+# Action Cable's in-process adapter is intentionally single-process (no Redis).
+workers 0
+threads_count = ENV.fetch("RAILS_MAX_THREADS", 3)
+threads threads_count, threads_count
+bind "tcp://0.0.0.0:#{ENV.fetch('PORT', 3000)}"
+pidfile ENV.fetch("PIDFILE", "storage/server.pid")
+
+# No external job service. Reconcile persisted deadlines even with no browsers.
+after_booted { GameTimer.start }
+after_stopped { GameTimer.stop }
diff --git a/config/routes.rb b/config/routes.rb
new file mode 100644
index 0000000..7d8c12b
--- /dev/null
+++ b/config/routes.rb
@@ -0,0 +1,35 @@
+Rails.application.routes.draw do
+  get "up" => "rails/health#show", as: :rails_health_check
+  root to: redirect("/moderate")
+
+  get "play/:code", to: "play#show", as: :play
+  post "play/:code/join", to: "play#join", as: :join_play
+  get "play/:code/state", to: "play#state", as: :state_play
+  post "play/:code/answer", to: "play#answer", as: :answer_play
+  post "play/:code/depart", to: "play#depart", as: :depart_play
+
+  namespace :moderate do
+    root to: "quizzes#index"
+    resources :games, only: :show do
+      get :state, on: :member
+      post :advance, on: :member
+      post :winners, on: :member
+    end
+    resources :quizzes do
+      resources :games, only: :create
+      collection do
+        get :import
+        post :import, action: :create_import
+      end
+      get :export, on: :member
+      get :preview, on: :member
+      resources :questions, except: [ :index, :show ] do
+        member do
+          patch :move_up
+          patch :move_down
+          patch :toggle
+        end
+      end
+    end
+  end
+end
