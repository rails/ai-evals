@@ -0,0 +1,37 @@
+<% content_for :title, "Live · #{@game.title} · Quizzy" %>
+<%= javascript_include_tag "actioncable", "live_game", defer: true %>
+<div class="breadcrumbs"><%= link_to "← Back to quiz", moderate_quiz_path(@game.quiz) %></div>
+<section class="live-stage" data-live-game data-moderator="true" data-code="<%= @game.code %>"
+  data-state-url="<%= state_moderate_game_path(@game) %>" data-action-url="<%= advance_moderate_game_path(@game) %>">
+  <div class="live-heading"><span class="live-badge">LIVE GAME</span><span data-connection role="status">Connecting…</span></div>
+  <h1><%= @game.title %></h1>
+  <div class="live-timer" data-timer hidden role="timer" aria-label="Time remaining" aria-live="off">0:00</div>
+  <div data-lobby <%= 'hidden' unless @game.phase == "waiting" %>>
+    <div class="live-lobby">
+      <div>
+        <h2>Ready when you are.</h2>
+        <p>Scan the code or open this link to join:</p>
+        <p class="join-link" data-join-link><%= @join_url %></p>
+        <p class="live-counter" data-player-count>Players: <%= @state[:players] %></p>
+      </div>
+      <div class="join-qr" role="img" aria-label="QR code to join the quiz"><%= @qr.html_safe %></div>
+    </div>
+  </div>
+  <div data-game-content aria-live="polite"></div>
+  <%= form_with url: advance_moderate_game_path(@game), data: { advance: true } do |form| %>
+    <%= form.hidden_field :phase, value: @game.phase %>
+    <%= form.hidden_field :question_id, value: @state.dig(:question, :id) %>
+    <%= form.button "Start", type: "submit", class: "btn btn--pink btn--lg", data: { advance_button: true } %>
+  <% end %>
+  <%= form_with url: winners_moderate_game_path(@game), data: { winners: true }, html: { hidden: @game.phase != "ended", class: "prize-controls" } do |form| %>
+    <h2>Pick the winners</h2>
+    <p>Choose the fastest top scorers, or draw among players tied on points for the remaining prizes. Players with 0 points never win.</p>
+    <div class="buttons">
+      <%= form.button "Top #{@game.number_of_winners}", name: "mode", value: "top", class: "btn btn--pink" %>
+      <%= form.button "Draw", name: "mode", value: "draw", class: "btn" %>
+      <%= form.button "Reset winners", name: "mode", value: "reset", class: "btn btn--ghost" %>
+    </div>
+  <% end %>
+  <p class="live-message" data-message role="alert"></p>
+  <script type="application/json" data-initial-state><%= raw json_escape(@state.to_json) %></script>
+</section>
