diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..66fe53e
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,144 @@
+class Game < ApplicationRecord
+  class Conflict < StandardError; end
+
+  belongs_to :quiz
+  has_many :game_questions, -> { order(:position) }, dependent: :destroy
+  has_many :players, dependent: :destroy
+  validates :code, :title, presence: true
+  validates :phase, inclusion: { in: %w[waiting open closed ended] }
+  validates :number_of_winners, numericality: { only_integer: true, greater_than_or_equal_to: 1 }
+  validates :timer_duration, numericality: { only_integer: true, greater_than_or_equal_to: 0 }
+  after_update_commit -> { LiveUpdates.state(self) }, if: -> { saved_change_to_phase? || saved_change_to_winners_version? }
+
+  def self.from_quiz!(quiz)
+    quiz.with_lock do
+      game = quiz.games.create!(title: quiz.title, number_of_winners: quiz.number_of_winners, timer_duration: quiz.timer_duration, code: SecureRandom.alphanumeric(8).upcase)
+      quiz.questions.where(active: true).each_with_index do |question, index|
+        game.game_questions.create!(text: question.text, options: question.options, position: index)
+      end
+      game
+    end
+  rescue ActiveRecord::RecordNotUnique
+    retry
+  end
+
+  def current_question
+    game_questions.find_by(position: current_index) unless phase.in?(%w[waiting ended])
+  end
+
+  # Expected phase and question guard against duplicate clicks and stale requests.
+  def advance!(expected_phase:, question_id:)
+    with_lock do
+      raise Conflict unless phase == expected_phase && current_question&.id.to_s == question_id.to_s
+      case phase
+      when "waiting"
+        if game_questions.exists?
+          open_question!(0)
+        else
+          update!(phase: "ended")
+        end
+      when "open"
+        finish_question!
+      when "closed"
+        if current_index + 1 < game_questions.count
+          open_question!(current_index + 1)
+        else
+          update!(phase: "ended")
+        end
+      else
+        raise Conflict
+      end
+    end
+  end
+
+  def timer_expired?(now = Time.current)
+    return false unless phase == "open"
+    deadline = current_question&.closes_at
+    deadline.present? && deadline <= now
+  end
+
+  # The timer worker and request fallback share this idempotent transition.
+  # Always recheck under the game lock: a late sweep must not finish a new question.
+  def finish_if_due!
+    with_lock do
+      timer_expired? ? finish_question! : false
+    end
+  end
+
+  def join!(browser_token, name)
+    with_lock do
+      raise Conflict if phase == "ended"
+      players.find_by(browser_token: browser_token) || players.create!(browser_token: browser_token, name: name)
+    end
+  end
+
+  def answer!(player, question_id, option_index)
+    expired = false
+    with_lock do
+      question = current_question
+      now = Time.current
+      if phase == "open" && question&.closes_at && question.closes_at <= now
+        # Commit the finish before raising; raising inside with_lock rolls it back.
+        finish_question!
+        expired = true
+      else
+        raise Conflict unless phase == "open" && question&.id.to_s == question_id.to_s && player.game_id == id
+        index = Integer(option_index.to_s, 10, exception: false)
+        raise Conflict unless index && index.between?(0, question.options.length - 1)
+        answer = player.answers.find_or_initialize_by(game_question: question)
+        # The same authoritative instant gates the deadline and records the pick.
+        answer.update!(option_index: index, picked_at: now)
+      end
+    end
+    raise Conflict if expired
+  end
+
+  def leaderboard
+    GameLeaderboard.call(self)
+  end
+
+  def select_winners!(mode, random: Random)
+    with_lock do
+      raise Conflict unless phase == "ended" && mode.in?(%w[top draw reset])
+      eligible = leaderboard.select { |row| row[:points].positive? }
+      count = [number_of_winners, eligible.length].min
+      winners = case mode
+      when "top"
+        eligible.first(count)
+      when "draw"
+        if count.positive?
+          cutoff = eligible[count - 1][:points]
+          guaranteed = eligible.select { |row| row[:points] > cutoff }
+          tied = eligible.select { |row| row[:points] == cutoff }
+          guaranteed + tied.sample(count - guaranteed.length, random: random)
+        else
+          []
+        end
+      else
+        []
+      end
+      players.update_all(winner: false)
+      players.where(id: winners.map { |row| row[:id] }).update_all(winner: true)
+      # Even repeated draws/resets notify open screens, after the commit.
+      update!(winners_version: winners_version + 1)
+    end
+  end
+
+  def present_player_ids
+    players.joins(:game_presences).merge(GamePresence.active).distinct.select(:id)
+  end
+
+  private
+
+  def finish_question!
+    update!(phase: "closed")
+  end
+
+  def open_question!(index)
+    # One authoritative opening instant, atomic with the phase transition.
+    now = Time.current
+    game_questions.find_by!(position: index).update!(opened_at: now,
+      closes_at: timer_duration.positive? ? now + timer_duration.seconds : nil)
+    update!(phase: "open", current_index: index)
+  end
+end
diff --git a/app/models/game_presence.rb b/app/models/game_presence.rb
new file mode 100644
index 0000000..91799f5
--- /dev/null
+++ b/app/models/game_presence.rb
@@ -0,0 +1,37 @@
+class GamePresence < ApplicationRecord
+  LEASE = 45.seconds
+  belongs_to :player
+  scope :active, -> { where(departed_at: nil, last_seen_at: LEASE.ago..) }
+  after_destroy_commit -> { LiveUpdates.counts(player.game) }
+
+  def self.valid_token?(token)
+    token.to_s.match?(/\A[a-f0-9]{32}\z/)
+  end
+
+  def self.renew!(player, token)
+    return unless valid_token?(token)
+    presence = find_or_initialize_by(player: player, token: token)
+    return if presence.departed_at # A late request must not resurrect a departed page.
+    expired = presence.new_record? || presence.last_seen_at < LEASE.ago
+    if expired || presence.last_seen_at < 10.seconds.ago
+      presence.update!(last_seen_at: Time.current)
+      LiveUpdates.counts(player.game) if expired
+    end
+  rescue ActiveRecord::RecordNotUnique
+    retry
+  end
+
+  def self.disconnect!(player, token)
+    player.game_presences.where(token: token).update_all(last_seen_at: LEASE.ago)
+    LiveUpdates.counts(player.game)
+  end
+
+  def self.depart!(player, token)
+    return unless valid_token?(token)
+    # Keep a tombstone so in-flight requests from the old page cannot recreate
+    # it. A newly loaded (or restored) page gets a fresh token.
+    upsert({ player_id: player.id, token: token, last_seen_at: Time.current, departed_at: Time.current },
+      unique_by: [:player_id, :token])
+    LiveUpdates.counts(player.game)
+  end
+end
