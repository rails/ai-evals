@@ -0,0 +1,51 @@
+require "test_helper"
+
+class GameChannelTest < ActionCable::Channel::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Channel test")
+    @quiz.questions.create!(text: "Pick", position: 1, options: [{ text: "Yes", correct: true }, { text: "No", correct: false }])
+    @game = Game.from_quiz!(@quiz)
+    @player = @game.join!("browser-one", "Alice")
+  end
+
+  test "subscription authenticates private player streams from the signed browser identity" do
+    stub_connection browser_token: "browser-one"
+    subscribe code: @game.code, presence: "a" * 32
+    assert subscription.confirmed?
+    assert_has_stream "game:#{@game.code}"
+    assert_has_stream "player:#{@player.id}"
+    assert_equal 1, @game.present_player_ids.count
+    perform :heartbeat
+    unsubscribe
+    assert_equal 0, @game.present_player_ids.count
+  end
+
+  test "an anonymous subscription cannot choose another player's stream" do
+    stub_connection browser_token: nil
+    subscribe code: @game.code, presence: "b" * 32, player_id: @player.id
+    assert subscription.confirmed?
+    assert_equal ["game:#{@game.code}"], subscription.streams
+    assert_equal 0, @game.present_player_ids.count
+  end
+
+  test "unknown games reject subscriptions" do
+    stub_connection browser_token: nil
+    subscribe code: "missing"
+    assert subscription.rejected?
+  end
+
+  test "answers notify only the moderator and the answering browser, not every phone" do
+    @game.advance!(expected_phase: "waiting", question_id: nil)
+    question = @game.current_question
+    assert_broadcasts "game:#{@game.code}", 0 do
+      assert_broadcast_on "counts:#{@game.code}", { changed: true } do
+        assert_broadcast_on "player:#{@player.id}", { changed: true } do
+          @game.answer!(@player, question.id, 0)
+        end
+      end
+    end
+    assert_broadcast_on "game:#{@game.code}", { changed: true, urgent: true } do
+      @game.advance!(expected_phase: "open", question_id: question.id)
+    end
+  end
+end
