@@ -0,0 +1,215 @@
+require "test_helper"
+
+class LiveGameTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "test-password"
+    @auth = { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "test-password") }
+    @quiz = Quiz.create!(title: "Live conference")
+    [true, false, true].each_with_index do |active, i|
+      @quiz.questions.create!(text: "Question #{i + 1}", position: i + 1, active: active,
+        options: [{ text: "Ruby", correct: true }, { text: "Other", correct: false }])
+    end
+  end
+
+  test "a moderator can create an isolated game of active questions" do
+    post "/moderate/quizzes/#{@quiz.id}/games", headers: @auth
+    assert_response :see_other
+    game = Game.last
+    assert_equal ["Question 1", "Question 3"], game.game_questions.map(&:text)
+    get response.location, headers: @auth
+    assert_response :success
+    assert_select "button", text: "Start"
+    assert_includes response.body, "/play/#{game.code}"
+  end
+  def create_game
+    Game.from_quiz!(@quiz)
+  end
+
+  def advance(game)
+    post advance_moderate_game_path(game), params: { phase: game.reload.phase, question_id: game.current_question&.id }, headers: @auth, as: :json
+    assert_response :success
+  end
+
+  def player_session(game, name)
+    open_session.tap do |browser|
+      browser.post join_play_path(game.code), params: { name: name }
+      assert_equal 303, browser.response.status
+      browser.get play_path(game.code)
+      assert_equal 200, browser.response.status
+    end
+  end
+
+  def state_for(browser, game)
+    browser.get state_play_path(game.code)
+    JSON.parse(browser.response.body)
+  end
+
+  test "live flow hides answers, remembers identity, counts last pick, skips inactive questions and closes entry" do
+    game = create_game
+    alice = player_session(game, "Alice")
+    bob = player_session(game, "Bob")
+    blank = player_session(game, "No pick")
+    assert_equal 3, game.players.count
+    alice.get play_path(game.code)
+    assert_includes alice.response.body, "Hi, Alice!"
+    assert_equal 3, game.players.count
+    get state_moderate_game_path(game), headers: @auth
+    assert_equal 3, response.parsed_body["players"]
+
+    advance(game)
+    current = game.reload.current_question
+    before = state_for(alice, game)
+    assert_equal "Question 1 of 2", before["progress"]
+    assert_equal [{ "text" => "Ruby" }, { "text" => "Other" }], before["question"]["options"]
+    assert_nil before["result"]
+    alice.get play_path(game.code)
+    refute_match(/"correct"\s*:/, alice.response.body)
+    refute_match(/is-correct/, alice.response.body)
+
+    alice.post answer_play_path(game.code), params: { question_id: current.id, option_index: 1 }, as: :json
+    assert_equal 200, alice.response.status
+    assert_equal 1, alice.response.parsed_body["selected"]
+    alice.post answer_play_path(game.code), params: { question_id: current.id, option_index: 0 }, as: :json
+    bob.post answer_play_path(game.code), params: { question_id: current.id, option_index: 1 }, as: :json
+    assert_equal 2, current.answers.count
+    assert_equal 0, game.players.find_by!(name: "Alice").answers.first.option_index
+    get state_moderate_game_path(game), headers: @auth
+    assert_equal 2, response.parsed_body["answers"]
+    assert_equal 3, response.parsed_body["players"]
+    refute response.parsed_body["question"]["options"].any? { |o| o.key?("correct") }
+
+    advance(game)
+    assert_equal "Correct!", state_for(alice, game)["result"]
+    assert_equal "Wrong!", state_for(bob, game)["result"]
+    assert_equal "No answer", state_for(blank, game)["result"]
+    get state_moderate_game_path(game), headers: @auth
+    assert_equal [1, 1], response.parsed_body["question"]["options"].map { |o| o["count"] }
+    assert_equal [true, false], response.parsed_body["question"]["options"].map { |o| o["correct"] }
+    alice.post answer_play_path(game.code), params: { question_id: current.id, option_index: 1 }, as: :json
+    assert_equal 409, alice.response.status
+    assert_equal 0, game.players.find_by!(name: "Alice").answers.first.option_index
+
+    advance(game)
+    assert_equal "Question 3", state_for(alice, game)["question"]["text"]
+    late = player_session(game, "Late arrival")
+    assert_equal "open", state_for(late, game)["phase"]
+    assert_nil state_for(alice, game)["selected"]
+    advance(game)
+    get state_moderate_game_path(game), headers: @auth
+    assert response.parsed_body["last_question"]
+    advance(game)
+    assert_equal "ended", state_for(alice, game)["phase"]
+    stranger = open_session
+    stranger.get play_path(game.code)
+    assert_includes stranger.response.body, "The quiz is over"
+    assert_equal "ended", game.reload.phase
+    assert_no_difference "Player.count" do
+      stranger.post join_play_path(game.code), params: { name: "Too late" }
+    end
+    assert_nil state_for(alice, game)["question"]
+  end
+
+  test "games snapshot questions and keep players and answers isolated" do
+    first = create_game
+    alice = player_session(first, "Alice")
+    @quiz.questions.first.update!(text: "Edited", active: false)
+    second = create_game
+    refute_equal first.code, second.code
+    assert_equal ["Question 1", "Question 3"], first.game_questions.map(&:text)
+    assert_equal ["Question 3"], second.game_questions.map(&:text)
+    assert_nil state_for(alice, second)["player_name"]
+    assert_empty second.players
+    @quiz.destroy!
+    assert_equal 0, Game.where(id: [first.id, second.id]).count
+    assert_equal 0, GamePresence.count
+  end
+
+  test "moderator routes and mutations are protected" do
+    game = create_game
+    get moderate_game_path(game)
+    assert_response :unauthorized
+    get state_moderate_game_path(game)
+    assert_response :unauthorized
+    post advance_moderate_game_path(game), params: { phase: "waiting" }
+    assert_response :unauthorized
+    assert_equal "waiting", game.reload.phase
+    assert_no_difference "Game.count" do
+      post moderate_quiz_games_path(@quiz)
+      assert_response :unauthorized
+    end
+  end
+
+  test "invalid and stale answers or duplicate transitions cannot alter the game" do
+    game = create_game
+    alice = player_session(game, "Alice")
+    question = game.game_questions.first
+    alice.post answer_play_path(game.code), params: { question_id: question.id, option_index: 0 }, as: :json
+    assert_equal 409, alice.response.status
+    advance(game)
+    post advance_moderate_game_path(game), params: { phase: "waiting" }, headers: @auth, as: :json
+    assert_response :conflict
+    assert_equal "open", game.reload.phase
+    other_game = create_game
+    [ [question.id, -1], [question.id, 3], [question.id, "bad"], [question.id, "0.2"], [other_game.game_questions.first.id, 0] ].each do |id, option|
+      alice.post answer_play_path(game.code), params: { question_id: id, option_index: option }, as: :json
+      assert_equal 409, alice.response.status
+    end
+    assert_empty question.answers
+    stranger = open_session
+    stranger.post answer_play_path(game.code), params: { question_id: question.id, option_index: 0 }, as: :json
+    assert_equal 401, stranger.response.status
+    assert_nil state_for(stranger, game)["question"]
+    alice.post answer_play_path(other_game.code), params: { question_id: other_game.game_questions.first.id, option_index: 0 }, as: :json
+    assert_equal 401, alice.response.status
+  end
+
+  test "presence counts a browser once across tabs and drops expired leases" do
+    game = create_game
+    player = game.join!("token", "Alice")
+    GamePresence.renew!(player, "a" * 32)
+    GamePresence.renew!(player, "b" * 32)
+    assert_equal 1, GameState.call(game, moderator: true)[:players]
+    player.game_presences.first.destroy!
+    assert_equal 1, GameState.call(game, moderator: true)[:players]
+    player.game_presences.update_all(last_seen_at: 1.minute.ago)
+    assert_equal 0, GameState.call(game, moderator: true)[:players]
+    GamePresence.renew!(player, "b" * 32)
+    assert_equal 1, GameState.call(game, moderator: true)[:players]
+  end
+
+  test "empty games end cleanly and names are validated and escaped" do
+    @quiz.questions.update_all(active: false)
+    game = create_game
+    post join_play_path(game.code), params: { name: "  " }
+    assert_response :unprocessable_entity
+    assert_no_difference "Player.count" do
+      post join_play_path(game.code), params: { name: "a" * 81 }
+      assert_response :unprocessable_entity
+    end
+    player_session(game, '<script>alert("test")</script>')
+    advance(game)
+    assert_equal "ended", game.reload.phase
+  end
+  test "departed pages cannot be resurrected by late polling or socket heartbeats" do
+    game = create_game
+    browser = player_session(game, "Alice")
+    player = game.players.first
+    token = player.game_presences.first.token
+    browser.post depart_play_path(game.code), params: { presence: token }
+    assert_equal 204, browser.response.status
+    browser.get state_play_path(game.code), params: { presence: token }
+    GamePresence.renew!(player, token)
+    assert_equal 0, game.present_player_ids.count
+    browser.get play_path(game.code)
+    assert_equal 1, game.present_player_ids.count
+    assert_equal 1, game.players.count
+  end
+
+  test "anonymous pages do not get a presence token to poll with after joining" do
+    game = create_game
+    get play_path(game.code)
+    assert_select "[data-presence='']"
+    assert_empty game.players
+  end
+end
diff --git a/test/integration/moderator_test.rb b/test/integration/moderator_test.rb
