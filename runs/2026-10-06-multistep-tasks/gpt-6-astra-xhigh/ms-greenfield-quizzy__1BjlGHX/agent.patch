diff --git a/app/services/game_leaderboard.rb b/app/services/game_leaderboard.rb
new file mode 100644
index 0000000..abde151
--- /dev/null
+++ b/app/services/game_leaderboard.rb
@@ -0,0 +1,21 @@
+# Always score the immutable game snapshot, never the editable source quiz.
+class GameLeaderboard
+  def self.call(game)
+    rows = game.players.preload(answers: :game_question).map do |player|
+      correct = player.answers.select do |answer|
+        answer.game_question.options.fetch(answer.option_index).fetch("correct", false)
+      end
+      elapsed = correct.sum do |answer|
+        opened_at = answer.game_question.opened_at
+        picked_at = answer.picked_at
+        # Older games have no timing history. They still score points, and use
+        # the stable player-ID tiebreak rather than fabricated response times.
+        opened_at && picked_at ? [(picked_at.to_r - opened_at.to_r), 0].max : 0
+      end
+      { id: player.id, name: player.name, points: correct.length, elapsed: elapsed, winner: player.winner? }
+    end
+    rows.sort_by { |row| [-row[:points], row[:elapsed], row[:id]] }.each_with_index.map do |row, index|
+      row.except(:elapsed).merge(place: index + 1)
+    end
+  end
+end
diff --git a/app/services/game_state.rb b/app/services/game_state.rb
new file mode 100644
index 0000000..865ed44
--- /dev/null
+++ b/app/services/game_state.rb
@@ -0,0 +1,55 @@
+class GameState
+  def self.call(game, player: nil, moderator: false)
+    # Reconcile missed deadlines (e.g. after downtime). Ordinary state reads
+    # remain lock-free; the rare overdue transition rechecks under a write lock.
+    game.reload
+    game.finish_if_due! if game.timer_expired?
+    data = { title: game.title, phase: game.phase }
+    data[:player_name] = player&.name unless moderator
+    if moderator
+      data[:players] = game.present_player_ids.count
+    end
+    question = game.current_question
+    if question && (moderator || player)
+      data[:progress] = "Question #{game.current_index + 1} of #{game.game_questions.count}"
+      data[:question] = { id: question.id, text: question.text, options: question.options.map { |o| { text: o.fetch("text") } } }
+      if moderator
+        data[:answers] = question.answers.count
+        if game.phase == "open" && question.closes_at
+          data[:timer] = { closes_at: question.closes_at.iso8601(3), server_now: Time.current.iso8601(3) }
+        end
+      else
+        answer = player.answers.find_by(game_question: question)
+        data[:selected] = answer&.option_index
+      end
+      if game.phase == "closed"
+        counts = question.answers.group(:option_index).count if moderator
+        question.options.each_with_index do |option, index|
+          data[:question][:options][index][:correct] = option.fetch("correct", false)
+          data[:question][:options][index][:count] = counts.fetch(index, 0) if moderator
+        end
+        data[:last_question] = game.current_index + 1 == game.game_questions.count if moderator
+        unless moderator
+          data[:result] = if answer.nil?
+            "No answer"
+          elsif question.options[answer.option_index]["correct"]
+            "Correct!"
+          else
+            "Wrong!"
+          end
+        end
+      end
+    end
+    if game.phase == "ended"
+      board = game.leaderboard
+      if moderator
+        data[:leaderboard] = board
+        data[:number_of_winners] = game.number_of_winners
+      elsif player
+        result = board.find { |row| row[:id] == player.id }
+        data[:standing] = result.slice(:place, :points, :winner).merge(total_players: board.length) if result
+      end
+    end
+    data
+  end
+end
diff --git a/app/services/game_timer.rb b/app/services/game_timer.rb
new file mode 100644
index 0000000..602cb86
--- /dev/null
+++ b/app/services/game_timer.rb
@@ -0,0 +1,36 @@
+# A local expiry sweep runs inside the single Puma process. Deadlines live in
+# SQLite, not this thread, so process restarts cannot reset or lose a timer.
+class GameTimer
+  INTERVAL = 0.2
+
+  def self.expire_due!
+    Game.where(phase: "open").joins(:game_questions)
+      .where("game_questions.position = games.current_index")
+      .where("game_questions.closes_at <= ?", Time.current)
+      .find_each(&:finish_if_due!)
+  end
+
+  def self.start
+    return if @thread&.alive?
+    @running = true
+    @thread = Thread.new do
+      Thread.current.name = "quizzy-question-timer"
+      while @running
+        begin
+          Rails.application.executor.wrap { expire_due! }
+        rescue StandardError => error
+          # Busy databases, transient errors, or a concurrently deleted game
+          # must not kill automatic finishing for all later questions.
+          Rails.logger.error("Question timer: #{error.class}: #{error.message}")
+        end
+        sleep INTERVAL
+      end
+    end
+  end
+
+  def self.stop
+    @running = false
+    @thread&.join
+    @thread = nil
+  end
+end
diff --git a/app/services/live_updates.rb b/app/services/live_updates.rb
