+  test "invalid and stale answers or duplicate transitions cannot alter the game" do
+    game = create_game
+    alice = player_session(game, "Alice")
+    question = game.game_questions.first
+    alice.post answer_play_path(game.code), params: { question_id: question.id, option_index: 0 }, as: :json
+    assert_equal 409, alice.response.status
+    advance(game)
+    post advance_moderate_game_path(game), params: { phase: "waiting" }, headers: @auth, as: :json
+    assert_response :conflict
+    assert_equal "open", game.reload.phase
+    other_game = create_game
+    [ [question.id, -1], [question.id, 3], [question.id, "bad"], [question.id, "0.2"], [other_game.game_questions.first.id, 0] ].each do |id, option|
+      alice.post answer_play_path(game.code), params: { question_id: id, option_index: option }, as: :json
+      assert_equal 409, alice.response.status
