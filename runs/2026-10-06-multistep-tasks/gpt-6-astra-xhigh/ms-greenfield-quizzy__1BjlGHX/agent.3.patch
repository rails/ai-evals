diff --git a/app/assets/javascripts/live_game.js b/app/assets/javascripts/live_game.js
new file mode 100644
index 0000000..546557d
--- /dev/null
+++ b/app/assets/javascripts/live_game.js
@@ -0,0 +1,226 @@
+(() => {
+  const root = document.querySelector('[data-live-game]');
+  if (!root) return;
+  const moderator = root.dataset.moderator === 'true';
+  const content = root.querySelector('[data-game-content]');
+  const connectionStatus = root.querySelector('[data-connection]');
+  const message = root.querySelector('[data-message]');
+  const advanceForm = root.querySelector('[data-advance]');
+  const advanceButton = root.querySelector('[data-advance-button]');
+  let state = JSON.parse(root.querySelector('[data-initial-state]').textContent);
+  let lastRendered = '';
+  let pageActive = true;
+  let connected = false;
+  let refreshing = false;
+  let refreshAgain = false;
+  let mutating = false;
+  let queuedAnswer = null;
+  let epoch = 0;
+  let failures = 0;
+  let debounce;
+  let consumer;
+  let heartbeatTimer;
+
+  function stopLive() {
+    clearInterval(heartbeatTimer);
+    consumer?.disconnect();
+    connectionStatus.textContent = 'Finished';
+  }
+
+  function node(tag, className, text) {
+    const el = document.createElement(tag);
+    if (className) el.className = className;
+    if (text !== undefined) el.textContent = text;
+    return el;
+  }
+
+  function render(next) {
+    const previousQuestion = state.question?.id;
+    state = next;
+    const serialized = JSON.stringify(next);
+    if (serialized === lastRendered) return;
+    lastRendered = serialized;
+    const previousFocus = previousQuestion === state.question?.id ? document.activeElement?.dataset.optionIndex : undefined;
+    content.replaceChildren();
+    const lobby = root.querySelector('[data-lobby]');
+    if (lobby) lobby.hidden = state.phase !== 'waiting';
+    const joinForm = root.querySelector('[data-join-form]');
+    if (joinForm) joinForm.hidden = !!state.player_name || state.phase === 'ended';
+    if (advanceForm) {
+      advanceForm.hidden = state.phase === 'ended';
+      advanceForm.elements.phase.value = state.phase;
+      advanceForm.elements.question_id.value = state.question?.id || '';
+      advanceButton.textContent = { waiting: 'Start', open: 'Finish', closed: state.last_question ? 'End quiz' : 'Next' }[state.phase] || '';
+    }
+    if (state.phase === 'ended') {
+      stopLive();
+      content.append(node('h1', 'live-ending', 'The quiz is over'), node('p', '', 'Thanks for playing along!'));
+      root.querySelector('.player-greeting')?.setAttribute('hidden', '');
+      return;
+    }
+    if (state.phase === 'waiting') {
+      if (moderator) root.querySelector('[data-player-count]').textContent = `Players: ${state.players}`;
+      else if (state.player_name) content.append(node('div', 'card live-waiting', 'Waiting for the quiz to start…'));
+      return;
+    }
+    if (!state.question) return;
+    content.append(node('p', 'screen__kicker', state.progress));
+    content.append(node('h2', 'live-question', state.question.text));
+    if (moderator && state.phase === 'open') content.append(node('p', 'live-counter', `Answers: ${state.answers} / ${state.players}`));
+    const options = node('ul', `live-options ${moderator ? 'live-options--stage' : ''}`);
+    state.question.options.forEach((option, index) => {
+      const li = node('li');
+      const picked = state.selected === index;
+      const item = node(moderator ? 'div' : 'button', 'play-option');
+      if (picked) item.classList.add('is-picked');
+      if (option.correct === true) item.classList.add('is-correct');
+      item.append(node('span', 'play-option__letter', String.fromCharCode(65 + index)));
+      item.append(node('span', 'play-option__title', option.text));
+      if (!moderator) {
+        item.type = 'button';
+        item.setAttribute('aria-label', option.text);
+        item.dataset.optionIndex = index;
+        item.disabled = state.phase !== 'open';
+        item.setAttribute('aria-pressed', picked ? 'true' : 'false');
+        if (picked) item.append(node('span', 'play-option__mark', 'Your answer'));
+      }
+      if (option.correct === true) item.append(node('span', 'live-correct', 'Correct'));
+      if (moderator && state.phase === 'closed') item.append(node('span', 'live-option-count', `Answers: ${option.count}`));
+      li.append(item);
+      options.append(li);
+    });
+    content.append(options);
+    if (!moderator) {
+      if (state.phase === 'closed') {
+        content.append(node('p', `play-status ${state.result === 'Correct!' ? 'play-status--right' : state.result === 'Wrong!' ? 'play-status--wrong' : 'play-status--neutral'}`, state.result));
+        content.append(node('p', 'live-hint', 'Waiting for the moderator…'));
+      } else {
+        content.append(node('p', 'live-hint', 'Tap an option to answer. You can change your mind until the question closes.'));
+      }
+    }
+    if (previousFocus !== undefined) content.querySelector(`[data-option-index="${previousFocus}"]`)?.focus({ preventScroll: true });
+  }
+
+  async function request(url, data) {
+    const response = await fetch(url, {
+      method: data ? 'POST' : 'GET', credentials: 'same-origin', cache: 'no-store',
+      signal: AbortSignal.timeout(8000),
+      headers: { Accept: 'application/json', ...(data ? { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content } : {}) },
+      body: data ? JSON.stringify(data) : undefined
+    });
+    if (!response.ok) {
+      const error = new Error('Request failed');
+      error.conflict = response.status === 409;
+      throw error;
+    }
+    return response.json();
+  }
+
+  async function refresh() {
+    if (!pageActive || state.phase === 'ended') return;
+    if (refreshing || mutating) { refreshAgain = true; return; }
+    refreshing = true;
+    refreshAgain = false;
+    const mine = epoch;
+    try {
+      const url = new URL(root.dataset.stateUrl, location.origin);
+      if (root.dataset.presence) url.searchParams.set('presence', root.dataset.presence);
+      const next = await request(url);
+      if (mine === epoch && !mutating) render(next);
+      failures = 0;
+      if (state.phase !== 'ended') connectionStatus.textContent = connected ? 'Live' : 'Live · backup connection';
+    } catch (_) {
+      failures++;
+      connectionStatus.textContent = 'Connection lost. Reconnecting…';
+    } finally {
+      refreshing = false;
+      if (refreshAgain && !mutating) scheduleRefresh();
+    }
+  }
+
+  function scheduleRefresh() {
+    if (debounce) return;
+    debounce = setTimeout(() => { debounce = null; refresh(); }, 120);
+  }
+
+  async function mutate(data) {
+    mutating = true;
+    epoch++;
+    message.textContent = moderator ? '' : 'Saving your answer…';
+    if (advanceButton) advanceButton.disabled = true;
+    try {
+      render(await request(root.dataset.actionUrl, data));
+      message.textContent = '';
+    } catch (error) {
+      message.textContent = error.conflict ? 'The game has moved on. Catching up…' : moderator ? 'Could not update the game. Please try again.' : 'Could not save your answer. Please tap your choice again.';
+    } finally {
+      mutating = false;
+      if (advanceButton) advanceButton.disabled = false;
+      if (queuedAnswer) {
+        const answer = queuedAnswer;
+        queuedAnswer = null;
+        if (state.phase === 'open' && answer.question_id === state.question?.id) mutate(answer);
+      }
+      scheduleRefresh();
+    }
+  }
+
+  root.addEventListener('click', (event) => {
+    const button = event.target.closest('[data-option-index]');
+    if (!button || button.disabled || state.phase !== 'open') return;
+    const answer = { question_id: state.question.id, option_index: Number(button.dataset.optionIndex) };
+    // Serialize submissions; when someone taps quickly, the last choice wins.
+    if (mutating) queuedAnswer = answer;
+    else mutate(answer);
+  });
+  advanceForm?.addEventListener('submit', (event) => {
+    event.preventDefault();
+    if (!mutating) mutate({ phase: state.phase, question_id: state.question?.id });
+  });
+
+  render(state);
+  if (state.phase === 'ended') return;
+  consumer = ActionCable.createConsumer('/cable');
+  function subscribe() {
+    return consumer.subscriptions.create({ channel: 'GameChannel', code: root.dataset.code, presence: root.dataset.presence, watch_counts: moderator }, {
+      connected() { connected = true; connectionStatus.textContent = 'Live'; scheduleRefresh(); },
+      disconnected() { connected = false; connectionStatus.textContent = state.phase === 'ended' ? 'Finished' : 'Reconnecting…'; },
+      received() { scheduleRefresh(); },
+      rejected() { connected = false; scheduleRefresh(); }
+    });
+  }
+  let subscription = subscribe();
+  heartbeatTimer = setInterval(() => { if (pageActive && connected && state.phase !== 'ended') subscription.perform('heartbeat'); }, 15000);
+  async function poll() {
+    await refresh();
+    if (state.phase === 'ended') return;
+    const delay = failures ? Math.min(30000, 1500 * 2 ** failures) : connected ? 15000 : 2500;
+    setTimeout(poll, delay * (0.85 + Math.random() * 0.3));
+  }
+  setTimeout(poll, 3000 + Math.random() * 2000);
+  document.addEventListener('visibilitychange', () => { if (!document.hidden) scheduleRefresh(); });
+  window.addEventListener('online', scheduleRefresh);
+  window.addEventListener('pagehide', () => {
+    pageActive = false;
+    clearTimeout(debounce);
+    debounce = null;
+    if (root.dataset.presence && root.dataset.departUrl) {
+      const data = new FormData();
+      data.append('presence', root.dataset.presence);
+      data.append('authenticity_token', document.querySelector('meta[name="csrf-token"]').content);
+      navigator.sendBeacon(root.dataset.departUrl, data);
+    }
+    consumer.disconnect();
+  });
+  window.addEventListener('pageshow', (event) => {
+    if (!event.persisted || state.phase === 'ended') return;
+    pageActive = true;
+    if (root.dataset.presence) {
+      root.dataset.presence = Array.from(crypto.getRandomValues(new Uint8Array(16)), n => n.toString(16).padStart(2, '0')).join('');
+    }
+    subscription.unsubscribe();
+    subscription = subscribe();
+    consumer.connect();
+    scheduleRefresh();
+  });
+})();
