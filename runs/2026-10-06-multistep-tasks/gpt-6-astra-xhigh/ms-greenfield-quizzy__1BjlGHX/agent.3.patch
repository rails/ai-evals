diff --git a/app/channels/game_channel.rb b/app/channels/game_channel.rb
new file mode 100644
index 0000000..267c992
--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,25 @@
+class GameChannel < ActionCable::Channel::Base
+  def subscribed
+    @game = Game.find_by(code: params[:code])
+    return reject unless @game
+    stream_from "game:#{@game.code}"
+    # Count streams contain only invalidations, so no credential is needed.
+    stream_from "counts:#{@game.code}" if params[:watch_counts]
+    @player = @game.players.find_by(browser_token: connection.browser_token) if connection.browser_token
+    if @player && params[:presence].to_s.match?(/\A[a-f0-9]{32}\z/)
+      @presence = params[:presence]
+      stream_from "player:#{@player.id}"
+      heartbeat
+    end
+  end
+
+  def heartbeat
+    GamePresence.renew!(@player, @presence) if @player && @presence && @game.reload.phase != "ended"
+  rescue ActiveRecord::RecordNotFound
+    stop_all_streams
+  end
+
+  def unsubscribed
+    GamePresence.disconnect!(@player, @presence) if @player && @presence
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
