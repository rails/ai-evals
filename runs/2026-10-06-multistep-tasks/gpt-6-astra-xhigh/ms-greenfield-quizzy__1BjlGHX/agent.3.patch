+    assert_equal 401, stranger.response.status
+    assert_nil state_for(stranger, game)["question"]
+    alice.post answer_play_path(other_game.code), params: { question_id: other_game.game_questions.first.id, option_index: 0 }, as: :json
+    assert_equal 401, alice.response.status
