diff --git a/app/services/game_state.rb b/app/services/game_state.rb
new file mode 100644
index 0000000..6d12b1e
--- /dev/null
+++ b/app/services/game_state.rb
@@ -0,0 +1,41 @@
+class GameState
+  def self.call(game, player: nil, moderator: false)
+    # Load phase/index together. Questions are immutable, and a closed question
+    # can no longer accept answers. Reads therefore need no SQLite write lock.
+    game.reload
+    data = { title: game.title, phase: game.phase }
+    data[:player_name] = player&.name unless moderator
+    if moderator
+      data[:players] = game.present_player_ids.count
+    end
+    question = game.current_question
+    if question && (moderator || player)
+      data[:progress] = "Question #{game.current_index + 1} of #{game.game_questions.count}"
+      data[:question] = { id: question.id, text: question.text, options: question.options.map { |o| { text: o.fetch("text") } } }
+      if moderator
+        data[:answers] = question.answers.count
+      else
+        answer = player.answers.find_by(game_question: question)
+        data[:selected] = answer&.option_index
+      end
+      if game.phase == "closed"
+        counts = question.answers.group(:option_index).count if moderator
+        question.options.each_with_index do |option, index|
+          data[:question][:options][index][:correct] = option.fetch("correct", false)
+          data[:question][:options][index][:count] = counts.fetch(index, 0) if moderator
+        end
+        data[:last_question] = game.current_index + 1 == game.game_questions.count if moderator
+        unless moderator
+          data[:result] = if answer.nil?
+            "No answer"
+          elsif question.options[answer.option_index]["correct"]
+            "Correct!"
+          else
+            "Wrong!"
+          end
+        end
+      end
+    end
+    data
+  end
+end
diff --git a/app/services/live_updates.rb b/app/services/live_updates.rb
new file mode 100644
index 0000000..5435ec7
--- /dev/null
+++ b/app/services/live_updates.rb
@@ -0,0 +1,15 @@
+# Broadcast invalidations, never question data. Answer traffic only wakes the
+# moderator and the answering player's tabs, not every phone in the audience.
+module LiveUpdates
+  def self.state(game)
+    ActionCable.server.broadcast("game:#{game.code}", { changed: true })
+  end
+
+  def self.counts(game)
+    ActionCable.server.broadcast("counts:#{game.code}", { changed: true })
+  end
+
+  def self.player(player)
+    ActionCable.server.broadcast("player:#{player.id}", { changed: true })
+  end
+end
