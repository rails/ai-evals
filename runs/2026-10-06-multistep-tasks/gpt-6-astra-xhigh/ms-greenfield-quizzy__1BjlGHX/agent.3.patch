+
+  belongs_to :quiz
+  has_many :game_questions, -> { order(:position) }, dependent: :destroy
+  has_many :players, dependent: :destroy
+  validates :code, :title, presence: true
+  validates :phase, inclusion: { in: %w[waiting open closed ended] }
+  after_update_commit -> { LiveUpdates.state(self) }, if: :saved_change_to_phase?
+
+  def self.from_quiz!(quiz)
+    quiz.with_lock do
+      game = quiz.games.create!(title: quiz.title, code: SecureRandom.alphanumeric(8).upcase)
+      quiz.questions.where(active: true).each_with_index do |question, index|
+        game.game_questions.create!(text: question.text, options: question.options, position: index)
+      end
+      game
+    end
+  rescue ActiveRecord::RecordNotUnique
+    retry
+  end
+
+  def current_question
+    game_questions.find_by(position: current_index) unless phase.in?(%w[waiting ended])
+  end
+
+  # Expected phase and question guard against duplicate clicks and stale requests.
+  def advance!(expected_phase:, question_id:)
+    with_lock do
+      raise Conflict unless phase == expected_phase && current_question&.id.to_s == question_id.to_s
+      case phase
+      when "waiting"
+        update!(phase: game_questions.exists? ? "open" : "ended")
+      when "open"
+        update!(phase: "closed")
+      when "closed"
+        if current_index + 1 < game_questions.count
+          update!(phase: "open", current_index: current_index + 1)
+        else
+          update!(phase: "ended")
+        end
+      else
+        raise Conflict
+      end
+    end
+  end
+
+  def join!(browser_token, name)
+    with_lock do
+      raise Conflict if phase == "ended"
+      players.find_by(browser_token: browser_token) || players.create!(browser_token: browser_token, name: name)
+    end
+  end
+
+  def answer!(player, question_id, option_index)
+    with_lock do
+      question = current_question
+      raise Conflict unless phase == "open" && question&.id.to_s == question_id.to_s && player.game_id == id
+      index = Integer(option_index.to_s, 10, exception: false)
+      raise Conflict unless index && index.between?(0, question.options.length - 1)
+      answer = player.answers.find_or_initialize_by(game_question: question)
+      answer.update!(option_index: index)
+    end
+  end
+
+  def present_player_ids
+    players.joins(:game_presences).merge(GamePresence.active).distinct.select(:id)
+  end
+end
diff --git a/app/models/game_presence.rb b/app/models/game_presence.rb
new file mode 100644
index 0000000..91799f5
--- /dev/null
+++ b/app/models/game_presence.rb
@@ -0,0 +1,37 @@
+class GamePresence < ApplicationRecord
+  LEASE = 45.seconds
+  belongs_to :player
+  scope :active, -> { where(departed_at: nil, last_seen_at: LEASE.ago..) }
+  after_destroy_commit -> { LiveUpdates.counts(player.game) }
+
+  def self.valid_token?(token)
+    token.to_s.match?(/\A[a-f0-9]{32}\z/)
+  end
+
+  def self.renew!(player, token)
+    return unless valid_token?(token)
+    presence = find_or_initialize_by(player: player, token: token)
+    return if presence.departed_at # A late request must not resurrect a departed page.
+    expired = presence.new_record? || presence.last_seen_at < LEASE.ago
+    if expired || presence.last_seen_at < 10.seconds.ago
+      presence.update!(last_seen_at: Time.current)
+      LiveUpdates.counts(player.game) if expired
+    end
+  rescue ActiveRecord::RecordNotUnique
+    retry
+  end
+
+  def self.disconnect!(player, token)
+    player.game_presences.where(token: token).update_all(last_seen_at: LEASE.ago)
+    LiveUpdates.counts(player.game)
+  end
+
+  def self.depart!(player, token)
+    return unless valid_token?(token)
+    # Keep a tombstone so in-flight requests from the old page cannot recreate
+    # it. A newly loaded (or restored) page gets a fresh token.
+    upsert({ player_id: player.id, token: token, last_seen_at: Time.current, departed_at: Time.current },
+      unique_by: [:player_id, :token])
+    LiveUpdates.counts(player.game)
+  end
+end
