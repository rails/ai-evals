@@ -0,0 +1,46 @@
+# Database race regression. Run after bin/rails db:test:prepare.
+ENV["RAILS_ENV"] = "test"
+require_relative "../config/environment"
+
+quiz = Quiz.create!(title: "Concurrent game check")
+begin
+  quiz.questions.create!(text: "One choice", position: 1,
+    options: [{ text: "Yes", correct: true }, { text: "No", correct: false }])
+  game = Game.from_quiz!(quiz)
+  players = 12.times.map { |i| game.join!("browser-#{i}", "Player #{i}") }
+  errors = Queue.new
+  outcomes = Queue.new
+  run = lambda do |tasks|
+    tasks.map do |task|
+      Thread.new do
+        ActiveRecord::Base.connection_pool.with_connection { task.call }
+      rescue Game::Conflict
+        outcomes << :conflict
+      rescue => error
+        errors << error
+      end
+    end.each(&:join)
+    raise errors.pop unless errors.empty?
+  end
+  run.call(8.times.map do
+    -> { Game.find(game.id).advance!(expected_phase: "waiting", question_id: nil) }
+  end)
+  raise "Duplicate Start advanced too far" unless game.reload.phase == "open"
+  raise "Expected seven rejected duplicate starts" unless outcomes.size == 7
+  question = game.current_question
+  3.times do |round|
+    run.call(players.flat_map do |player|
+      [0, 1].map { |choice| -> { Game.find(game.id).answer!(player, question.id, choice) } }
+    end)
+    raise "More than one answer per player" unless question.answers.count == players.length
+  end
+  run.call(players.map { |player| -> { Game.find(game.id).answer!(player, question.id, 0) } } +
+    [-> { Game.find(game.id).advance!(expected_phase: "open", question_id: question.id) }])
+  raise "Finish did not close question" unless game.reload.phase == "closed"
+  frozen_answers = question.answers.order(:player_id).pluck(:option_index)
+  run.call(players.map { |player| -> { Game.find(game.id).answer!(player, question.id, 1) } })
+  raise "Closed answers changed" unless question.answers.order(:player_id).pluck(:option_index) == frozen_answers
+  puts "PASS: duplicate transitions, simultaneous last-pick updates, and Finish/answer race"
+ensure
+  quiz.destroy!
+end
