diff --git a/docs/timers.md b/docs/timers.md
new file mode 100644
index 0000000..ef93f7a
--- /dev/null
+++ b/docs/timers.md
@@ -0,0 +1,68 @@
+# Question timers
+
+## Settings and portability
+
+Quiz settings expose **Timer minutes** and **Timer seconds**, both nonnegative
+integers defaulting to 0. Their sum (`minutes * 60 + seconds`) is the duration of
+each question; a zero total disables timing. Seconds can exceed 59 and are
+combined into the duration. Values persist on the quiz, and new games snapshot
+the total, like the existing question and prize settings. Editing a quiz cannot
+change an in-progress game. Existing quizzes/games remain untimed after migration.
+
+The timer is installation-local configuration: the explicit `QuizTransfer`
+whitelist remains unchanged. Export contains no timer fields; import ignores
+such fields and uses the zero defaults.
+
+## Authoritative deadline
+
+`Game#open_question!` writes `opened_at` and `closes_at` from the same server
+instant, atomically with the phase/index transition. Untimed questions have a
+null deadline. Reloads, connections, answers and presence do not write these
+values. Each Next gets a new question and a fresh deadline.
+
+`GameTimer` sweeps overdue *current* questions every 200 ms inside the single
+Puma process, started/stopped through Puma lifecycle hooks. It needs no new gem,
+external service, job store, or separate process. Deadlines live in SQLite under
+`storage/`, not in thread-local scheduled jobs. The sweep resumes on startup;
+overdue questions close even without a browser connected. Errors are logged and
+retried on the next sweep. State reads also reconcile overdue questions, so an
+HTTP refresh can recover immediately after downtime or a delayed sweep.
+
+Expiry uses the same `finish_question!` transition and after-commit live
+broadcast as manual **Finish**. It stops at results, never at Next or End quiz.
+The game lock rechecks phase and current deadline, so duplicate/stale sweeps,
+multiple screens and manual Finish cannot skip results or finish a later
+question early. Answer submission gates its server-side pick timestamp against
+the deadline inside that same lock. At or after the deadline it commits the
+finish, then rejects the answer (raising inside the transaction would undo it).
+
+## Big-screen clock
+
+Only open, timed moderator state includes deadline and current server time.
+Player JSON and HTML never include timer data or a countdown element. The
+moderator uses the server's remaining duration anchored to `performance.now()`,
+not a decrementing counter or the browser wall clock, displaying `M:SS` with
+zero-padded seconds and clamping at `0:00`. Updates/reloads use the same deadline.
+The timer is outside the question's live region so each tick doesn't recreate
+options or announce the whole question. It disappears on results.
+
+At zero the browser requests authoritative state; it never submits a simulated
+Finish, avoiding stale-tab transitions. Cable normally delivers closure
+immediately, and HTTP fallback also works. The server accepts no late picks even
+if a suspended phone or delayed network still displays an open question.
+
+## Verification
+
+```sh
+bin/rails test
+bin/rails db:test:prepare
+bundle exec ruby script/timer_race_check.rb
+# With bin/serve running locally on the production database:
+bundle exec ruby script/timer_smoke.rb
+```
+
+The browser test covers 1:30 and 0:05, reload persistence, early Finish, fresh
+Next deadlines, player privacy, Cable and HTTP fallback, zero/zero, export, and
+expiry with every game screen closed (verified with a read-only SQLite query).
+Like the existing smoke tests, it creates temporary quizzes and deletes them
+on success; a failed run may leave one for inspection.
diff --git a/script/timer_race_check.rb b/script/timer_race_check.rb
new file mode 100644
index 0000000..167d80b
--- /dev/null
+++ b/script/timer_race_check.rb
@@ -0,0 +1,54 @@
+# Run after bin/rails db:test:prepare. Real connections, no transactional fixtures.
+ENV["RAILS_ENV"] = "test"
+require_relative "../config/environment"
+
+quiz = Quiz.create!(title: "Timer concurrency check", timer_seconds: 30)
+begin
+  2.times do |i|
+    quiz.questions.create!(text: "Timed #{i}", position: i + 1,
+      options: [{ text: "Yes", correct: true }, { text: "No", correct: false }])
+  end
+  run = lambda do |tasks|
+    errors = Queue.new
+    tasks.map do |task|
+      Thread.new do
+        ActiveRecord::Base.connection_pool.with_connection { task.call }
+      rescue Game::Conflict
+        # Expected when another finish won or an answer missed the deadline.
+      rescue => error
+        errors << error
+      end
+    end.each(&:join)
+    raise errors.pop unless errors.empty?
+  end
+
+  8.times do
+    game = Game.from_quiz!(quiz)
+    player = game.join!(SecureRandom.hex(16), "Player")
+    game.advance!(expected_phase: "waiting", question_id: nil)
+    first = game.current_question
+    game.answer!(player, first.id, 0)
+    first.update!(closes_at: 1.second.ago)
+    run.call([
+      -> { GameTimer.expire_due! },
+      -> { Game.find(game.id).finish_if_due! },
+      -> { Game.find(game.id).advance!(expected_phase: "open", question_id: first.id) },
+      -> { Game.find(game.id).answer!(player, first.id, 1) }
+    ] * 3)
+    raise "Expiry advanced past results" unless game.reload.phase == "closed" && game.current_index == 0
+    raise "Late answer changed results" unless player.answers.first.option_index == 0
+
+    stale_timer_game = Game.find(game.id)
+    run.call([
+      -> { Game.find(game.id).advance!(expected_phase: "closed", question_id: first.id) },
+      -> { stale_timer_game.finish_if_due! },
+      -> { GameTimer.expire_due! }
+    ])
+    raise "Old deadline closed new question" unless game.reload.phase == "open" && game.current_index == 1
+    raise "New deadline was not reset" unless game.current_question.closes_at > Time.current
+    game.destroy!
+  end
+  puts "PASS: expiry/Finish/answer races and stale timers cannot advance twice or close the next question"
+ensure
+  quiz.destroy!
+end
diff --git a/script/timer_smoke.rb b/script/timer_smoke.rb
new file mode 100644
index 0000000..50ccfbe
--- /dev/null
+++ b/script/timer_smoke.rb
@@ -0,0 +1,158 @@
+# Against bin/serve: bundle exec ruby script/timer_smoke.rb
+require "bundler/setup"
+require "capybara/cuprite"
+require "minitest/autorun"
+require "securerandom"
+require "fileutils"
+require "json"
+
+Capybara.register_driver(:timer_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: ENV.fetch("CHROMIUM_PATH", "/usr/bin/chromium"),
+    window_size: [1440, 1000], browser_options: { "no-sandbox" => nil, "disable-dev-shm-usage" => nil },
+    process_timeout: 20, timeout: 10, js_errors: true)
+end
+Capybara.enable_aria_label = true
+Capybara.run_server = false
+Capybara.app_host = ENV.fetch("APP_URL", "http://localhost:3000")
+Capybara.default_max_wait_time = 5
+
+class TimerSmokeTest < Minitest::Test
+  def setup
+    @sessions = []
+    @mod = browser
+    @mod.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "test-password"))
+    @phone = browser
+    @phone.current_window.resize_to(390, 844)
+    @fallback = browser
+    @fallback.driver.browser.page.command("Page.addScriptToEvaluateOnNewDocument", source: <<~JS)
+      window.WebSocket = class extends WebSocket {
+        constructor() { super('ws://' + location.host + '/blocked-websocket'); }
+      };
+    JS
+  end
+
+  def browser
+    Capybara::Session.new(:timer_chromium).tap { |session| @sessions << session }
+  end
+
+  def teardown
+    FileUtils.mkdir_p("storage/screenshots")
+    @sessions.each_with_index do |session, index|
+      session.save_screenshot("storage/screenshots/timer-failure-#{index}.png") unless passed?
+      session.driver.quit
+    end
+  end
+
+  def settings(minutes, seconds)
+    @mod.visit @quiz_url
+    @mod.click_link "Settings"
+    @mod.fill_in "Timer minutes", with: minutes
+    @mod.fill_in "Timer seconds", with: seconds
+    @mod.click_button "Save quiz"
+    @mod.click_link "Settings"
+    assert @mod.has_field?("Timer minutes", with: minutes.to_s)
+    assert @mod.has_field?("Timer seconds", with: seconds.to_s)
+    @mod.click_link "Cancel"
+  end
+
+  def start_game
+    @mod.click_button "Start a game"
+    @game_url = @mod.current_url
+    @join_url = @mod.find('[data-join-link]').text
+    assert @mod.has_no_selector?('[data-timer]')
+  end
+
+  def test_countdown_reload_finish_and_no_timer
+    title = "Timer smoke #{SecureRandom.hex(4)}"
+    document = { title: title, questions: 3.times.map { |i|
+      { text: "Timed question #{i + 1}", options: [{ text: "Yes", correct: true }, { text: "No", correct: false }] }
+    } }
+    @mod.visit "/moderate"
+    @mod.click_button "Import quiz"
+    @mod.fill_in "Quiz JSON", with: JSON.generate(document)
+    @mod.click_button "Import", exact: true
+    assert @mod.has_text?(title)
+    @quiz_url = @mod.current_url
+    @mod.click_link "Settings"
+    assert @mod.has_field?("Timer minutes", with: "0")
+    assert @mod.has_field?("Timer seconds", with: "0")
+    @mod.click_link "Cancel"
+
+    settings(1, 30)
+    @mod.click_link "Export"
+    json = JSON.parse(@mod.find('pre').text)
+    refute json.keys.any? { |key| key.include?("timer") }
+    @mod.visit @quiz_url
+    start_game
+    @mod.click_button "Start", exact: true
+    assert @mod.has_selector?('[data-timer]', text: '1:30', exact_text: true)
+    sleep 2.1
+    @mod.visit @game_url
+    assert @mod.has_selector?('[data-timer]', text: /1:2[0-8]/)
+    @mod.click_button "Finish", exact: true
+    assert @mod.has_button?("Next", exact: true)
+    assert @mod.has_no_selector?('[data-timer]')
+
+    settings(0, 5)
+    start_game
+    [@phone, @fallback].each_with_index do |phone, index|
+      phone.visit @join_url
+      phone.fill_in "Your name", with: "Player #{index}"
+      phone.click_button "Join", exact: true
+      assert phone.has_text?("Waiting for the quiz to start")
+      phone.execute_script('window.noReload = true')
+    end
+    @mod.click_button "Start", exact: true
+    assert @mod.has_selector?('[data-timer]', text: '0:05', exact_text: true)
+    [@phone, @fallback].each do |phone|
+      assert phone.has_button?("Yes", exact: true)
+      assert phone.has_no_selector?('[data-timer]', visible: :all, wait: 0)
+      state = phone.evaluate_async_script("fetch(location.pathname + '/state').then(r => r.json()).then(arguments[0])")
+      refute state.key?("timer")
+      refute_match(/closes_at|server_now/, JSON.generate(state))
+    end
+    @phone.click_button "Yes", exact: true
+    assert @phone.has_selector?('button.is-picked')
+    sleep 1.1
+    @mod.visit @game_url
+    assert @mod.has_selector?('[data-timer]', text: /0:0[1-4]/)
+    assert @mod.has_button?("Next", exact: true, wait: 7)
+    assert @phone.has_text?("Correct!")
+    assert @fallback.has_text?("No answer")
+    assert @phone.evaluate_script('window.noReload')
+    assert @fallback.evaluate_script('window.noReload')
+
+    @mod.click_button "Next", exact: true
+    assert @mod.has_selector?('[data-timer]', text: '0:05', exact_text: true)
+    @mod.click_button "Finish", exact: true
+    assert @mod.has_button?("Next", exact: true)
+    assert @mod.has_no_selector?('[data-timer]')
+    # Leaving all game screens tests the server worker, not a browser timeout.
+    @mod.click_button "Next", exact: true
+    @sessions.each { |session| session.visit 'about:blank' }
+    sleep 5.5
+    # Read the persisted phase directly; a game HTTP read could itself reconcile it.
+    game_id = @game_url.split('/').last
+    require "sqlite3"
+    phase = SQLite3::Database.new("storage/production.sqlite3", readonly: true).get_first_value("SELECT phase FROM games WHERE id = ?", [Integer(game_id)])
+    assert_equal 'closed', phase
+    @mod.visit @game_url
+    assert @mod.has_button?("End quiz", exact: true)
+    @mod.click_button "End quiz", exact: true
+    assert @mod.has_text?("The quiz is over")
+
+    settings(0, 0)
+    start_game
+    @mod.click_button "Start", exact: true
+    assert @mod.has_text?("Timed question 1")
+    assert @mod.has_no_selector?('[data-timer]')
+    sleep 5.5
+    assert @mod.has_button?("Finish", exact: true)
+    @mod.click_button "Finish", exact: true
+    assert @mod.has_button?("Next", exact: true)
+    @mod.visit @quiz_url
+    @mod.click_link "Settings"
+    @mod.accept_confirm { @mod.click_button "Delete quiz" }
+    assert @mod.has_text?("Quizzes")
+  end
+end
