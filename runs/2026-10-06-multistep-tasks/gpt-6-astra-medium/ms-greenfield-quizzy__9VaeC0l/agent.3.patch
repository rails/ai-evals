--- /dev/null
+++ b/app/channels/live_game_channel.rb
@@ -0,0 +1,12 @@
+class LiveGameChannel < ActionCable::Channel::Base
+  def subscribed
+    access = Rails.application.message_verifier(:live_game).verified(params[:token], purpose: :live_game)
+    return reject unless access && Game.exists?(access["game_id"])
+    stream_from "game:#{access['game_id']}"
+    if access["moderator"]
+      stream_from "counters:#{access['game_id']}"
+    elsif access["player_id"]
+      stream_from "player:#{access['player_id']}"
+    end
+  end
+end
