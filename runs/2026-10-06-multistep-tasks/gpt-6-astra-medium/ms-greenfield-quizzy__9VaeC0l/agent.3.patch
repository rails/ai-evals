+class Player < ApplicationRecord
+  PRESENCE_WINDOW = 35.seconds
+  belongs_to :game
+  has_many :answers, dependent: :destroy
+  validates :name, presence: true, length: { maximum: 80 }
+  scope :present_now, -> { where(last_seen_at: PRESENCE_WINDOW.ago..) }
+
+  def pulse!
+    if last_seen_at < 10.seconds.ago
+      update!(last_seen_at: Time.current)
+      game.notify_counters
+    end
+  end
+end
