index 0000000..abcbcc4
--- /dev/null
+++ b/app/assets/javascripts/live.js
@@ -0,0 +1,205 @@
+(() => {
+  const root = document.getElementById("live-game");
+  if (!root) return;
+  const moderator = root.dataset.role === "moderator";
+  const content = document.getElementById("live-content");
+  const status = document.getElementById("connection-status");
+  const csrf = document.querySelector('meta[name="csrf-token"]').content;
+  let state, rendered, busy = false, fetching = false, pendingPick = null, mutation = 0;
+  let socket, retryTimer, notificationTimer, pollTimer, pulseTimer, stopped = false, reconnectDelay = 1000, lastMessage = Date.now();
+  const node = (tag, text, cls) => {
+    const el = document.createElement(tag);
+    if (text != null) el.textContent = text;
+    if (cls) el.className = cls;
+    return el;
+  };
+  function render(next) {
+    if (state && next.revision < state.revision) return;
+    state = next;
+    // Counter-only updates must not replace buttons under the moderator's pointer.
+    if (moderator) {
+      document.getElementById("waiting-count").textContent = `Players: ${state.players}`;
+      document.getElementById("answer-count").textContent = state.question ? `Answers: ${state.answers} / ${state.players}` : "";
+    }
+    const signature = JSON.stringify(moderator ? { ...next, players: null, answers: null } : next);
+    if (signature === rendered) return;
+    rendered = signature;
+    const oldFocus = document.activeElement?.dataset.option;
+    content.replaceChildren();
+    const ended = state.status === "ended";
+    const waiting = state.status === "waiting";
+    const question = state.question;
+    if (moderator) {
+      document.getElementById("lobby").hidden = !waiting;
+      document.getElementById("waiting-count").textContent = `Players: ${state.players}`;
+      document.getElementById("answer-count").textContent = question ? `Answers: ${state.answers} / ${state.players}` : "";
+      const actions = document.getElementById("game-actions");
+      actions.replaceChildren();
+      if (!ended) {
+        const command = waiting ? "start" : state.status === "open" ? "finish" : question.number === question.total ? "end" : "next";
+        const button = node("button", { start: "Start", finish: "Finish", next: "Next", end: "End quiz" }[command], "btn btn--lg");
+        button.type = "button";
+        button.dataset.command = command;
+        actions.append(button);
+      }
+    } else {
+      document.getElementById("join-panel").hidden = !!state.name || ended;
+    }
+    if (ended) {
+      content.append(node("h1", "The quiz is over"), node("p", "Thanks for playing!"));
+      return;
+    }
+    if (!moderator && !state.name) return;
+    if (waiting) {
+      if (!moderator) content.append(node("h1", `Hi, ${state.name}!`), node("p", "Waiting for the quiz to start…"));
+      return;
+    }
+    if (!question) return;
+    content.append(node("p", `Question ${question.number} of ${question.total}`, moderator ? "stage-question__num" : "play-question__num"));
+    content.append(node("h1", question.text, moderator ? "stage-question__body" : "play-question__body"));
+    const closed = state.status === "closed";
+    const options = node("ul", null, moderator ? `stage-options ${closed ? "stage-options--results" : ""}` : "play-options");
+    question.options.forEach((option, index) => {
+      const li = node("li");
+      const item = moderator ? li : node("button");
+      item.className = moderator ? "stage-option" : "play-option";
+      if (!moderator) {
+        item.type = "button";
+        item.dataset.option = index;
+        item.disabled = closed;
+        item.setAttribute("aria-pressed", state.selection === index ? "true" : "false");
+        if (state.selection === index) item.classList.add("is-picked");
+        li.append(item);
+      }
+      if (closed && option.correct) item.classList.add("is-correct");
+      item.append(node("span", index < 26 ? String.fromCharCode(65 + index) : index + 1, moderator ? "stage-option__letter" : "play-option__letter"));
+      item.append(node("span", option.text, moderator ? "stage-option__title" : "play-option__text"));
+      if (moderator && closed) item.append(node("strong", `${option.count}`, "stage-option__count"));
+      if (closed && option.correct) item.append(node("span", "Correct", "answer-mark"));
+      if (!moderator && state.selection === index) item.append(node("span", "Your answer", "answer-mark"));
+      options.append(li);
+    });
+    content.append(options);
+    if (!moderator) {
+      if (closed) content.append(node("p", state.result, `play-status ${state.result === "Correct!" ? "play-status--correct" : state.result === "Wrong!" ? "play-status--wrong" : "play-status--neutral"}`));
+      content.append(node("p", closed ? "Waiting for the moderator…" : "Tap an option. You can change your answer until the question closes.", "meta"));
+      if (oldFocus !== undefined) content.querySelector(`[data-option="${oldFocus}"]`)?.focus({ preventScroll: true });
+    }
+  }
+  async function request(url, payload) {
+    const response = await fetch(url, {
+      method: payload === undefined ? "GET" : "POST", credentials: "same-origin", cache: "no-store",
+      headers: { Accept: "application/json", "Content-Type": "application/json", "X-CSRF-Token": csrf },
+      body: payload === undefined ? undefined : JSON.stringify(payload), signal: AbortSignal.timeout(10000)
+    });
+    if (!response.ok) {
+      let error;
+      try { error = (await response.json()).error; } catch (_) {}
+      throw new Error(error || "Connection interrupted. Retrying…");
+    }
+    return response.status === 204 ? null : response.json();
+  }
+  async function refresh() {
+    if (fetching || busy || stopped) return;
+    fetching = true;
+    const before = mutation;
+    try {
+      const next = await request(root.dataset.stateUrl);
+      if (!busy && before === mutation) render(next);
+      if (!busy) status.textContent = "";
+    } catch (_) { status.textContent = "Connection interrupted. Retrying…"; }
+    finally { fetching = false; }
+  }
+  function scheduleRefresh() {
+    clearTimeout(notificationTimer);
+    notificationTimer = setTimeout(refresh, 60 + Math.random() * 180);
+  }
+  async function submit(payload) {
+    busy = true;
+    mutation++;
+    status.textContent = "Saving…";
+    try {
+      const next = await request(root.dataset.actionUrl, payload);
+      render(next);
+      status.textContent = "";
+    } catch (error) { status.textContent = error.message; }
+    finally { busy = false; }
+    if (pendingPick) {
+      const pick = pendingPick;
+      pendingPick = null;
+      if (state.status === "open" && state.question.id === pick.question_id) return submit(pick);
+    }
+    scheduleRefresh();
+  }
+  root.addEventListener("click", (event) => {
+    const command = event.target.closest("[data-command]");
+    if (command && !busy) {
+      command.disabled = true;
+      submit({ command: command.dataset.command, revision: state.revision }).finally(() => { command.disabled = false; });
+    }
+    const option = event.target.closest("[data-option]");
+    if (option && state.status === "open") {
+      const pick = { question_id: state.question.id, option_index: Number(option.dataset.option) };
+      if (busy) pendingPick = pick;
+      else submit(pick);
+    }
+  });
+  async function pulse() {
+    if (!root.dataset.pulseUrl || state.status === "ended" || stopped) return;
+    try { await request(root.dataset.pulseUrl, {}); }
+    catch (_) { status.textContent = "Connection interrupted. Retrying…"; }
+  }
+  function connect() {
+    if (stopped || socket && socket.readyState < 2) return;
+    const url = new URL("/cable", location.href);
+    url.protocol = location.protocol === "https:" ? "wss:" : "ws:";
+    try {
+      socket = new WebSocket(url, ["actioncable-v1-json"]);
+    } catch (_) {
+      // Some networks/browsers disallow sockets entirely; polling remains available.
+      return;
+    }
+    const identifier = JSON.stringify({ channel: "LiveGameChannel", token: root.dataset.liveToken });
+    socket.onmessage = (event) => {
+      lastMessage = Date.now();
+      const message = JSON.parse(event.data);
+      if (message.type === "welcome") socket.send(JSON.stringify({ command: "subscribe", identifier }));
+      if (message.type === "confirm_subscription") reconnectDelay = 1000;
+      if (message.type === "confirm_subscription" || message.message) scheduleRefresh();
+    };
+    socket.onclose = () => {
+      if (!stopped) {
+        retryTimer = setTimeout(connect, reconnectDelay + Math.random() * 1500);
+        reconnectDelay = Math.min(reconnectDelay * 2, 30000);
+      }
+    };
+    socket.onerror = () => socket.close();
+  }
+  render(JSON.parse(document.getElementById("initial-state").textContent));
+  pulse();
+  connect();
+  // Heartbeats and periodic authoritative reads recover lost notifications and expired presence.
+  function startTimers() {
+    clearInterval(pollTimer); clearInterval(pulseTimer);
+    pollTimer = setInterval(() => {
+      refresh();
+      if (Date.now() - lastMessage > 15000) socket?.close();
+    }, moderator ? 4000 : 10000);
+    pulseTimer = setInterval(pulse, 12000);
+  }
+  startTimers();
+  window.addEventListener("online", () => { connect(); pulse(); refresh(); });
+  document.addEventListener("visibilitychange", () => { if (!document.hidden) { connect(); pulse(); refresh(); } });
+  window.addEventListener("pagehide", () => {
+    stopped = true;
+    clearInterval(pollTimer); clearInterval(pulseTimer);
+    clearTimeout(retryTimer); clearTimeout(notificationTimer);
+    socket?.close();
+  });
+  window.addEventListener("pageshow", (event) => {
+    if (event.persisted) {
+      stopped = false;
+      startTimers(); connect(); pulse(); refresh();
+    }
+  });
+})();
