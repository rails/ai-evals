+    @access = Rails.application.message_verifier(:live_game).verified(params[:token], purpose: :live_game)
+    return reject unless @access && Game.exists?(@access["game_id"])
+
+    # Push personalized authoritative state immediately: no randomized client
+    # debounce and no extra HTTP round trip before a question can appear.
+    stream_from "game:#{@access['game_id']}" do |_message|
+      transmit_state
     end
+    if @access["moderator"]
+      stream_from "counters:#{@access['game_id']}" do |_message|
+        transmit_state
+      end
+    elsif @access["player_id"]
