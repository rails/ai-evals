diff --git a/docs/implementation.md b/docs/implementation.md
index b07cef2..c585b1b 100644
--- a/docs/implementation.md
+++ b/docs/implementation.md
@@ -27,3 +27,35 @@ own small form. Quiz/question list items own their associated action controls.
 Verification includes model/request regression tests plus a Cuprite/Chromium
 workflow against `bin/serve` in production. Screenshots generated by that workflow
 are disposable and ignored under `storage/`.
+
+## Quiz contents transfer
+
+`GET /moderate/quizzes/:id/export` renders exactly one escaped `<pre>` containing
+pretty-printed JSON. `GET /moderate/quizzes/import` and the corresponding POST
+are protected by the same moderator authentication as quiz editing.
+
+`QuizTransfer` explicitly maps title, question text/active, and option
+text/correct; it does not serialize database attributes. All questions (including
+inactive ones) use the current position order, and option array order is retained.
+Imported IDs, positions, or other unrecognized keys are ignored, never assigned.
+Every import creates a new quiz; an empty questions array is valid.
+
+Import requires an object with a string title and a questions array. Questions
+and options must be objects with string text; options must be an array. Optional
+booleans default only when absent (`active: true`, `correct: false`); explicit
+nulls, numbers, and string booleans are rejected. Model validation is shared with
+the question form: question text is required, blank option rows are discarded,
+option text is trimmed, and at least two nonblank options and at least one correct
+option are required. Multiple correct options are allowed.
+
+All saves run inside one database transaction. Shape errors or model validation
+failures roll back the quiz and every question, with a numbered error on the
+import page and the submitted JSON retained for correction. No external services
+or additional dependencies are used.
+
+Regression coverage is in `test/integration/quiz_transfer_test.rb`. Run
+`bundle exec ruby script/transfer_smoke.rb` against `bin/serve` for the production
+Chromium copy/import workflow, malformed JSON recovery, atomic failure,
+duplicate titles, inactive flags, safe text rendering, and mobile export layout.
+The script uses the credentials and URL variables described in README.md and
+cleans up its successful imports.
diff --git a/script/transfer_smoke.rb b/script/transfer_smoke.rb
new file mode 100644
index 0000000..be9caa6
--- /dev/null
+++ b/script/transfer_smoke.rb
@@ -0,0 +1,68 @@
+# Run against bin/serve; uses the same credentials and URL as browser_smoke.rb.
+require "capybara/cuprite"
+require "json"
+Capybara.register_driver(:cuprite) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: "/usr/bin/chromium", browser_options: { "no-sandbox" => nil }, window_size: [ 1280, 900 ])
+end
+Capybara.default_max_wait_time = 5
+session = Capybara::Session.new(:cuprite)
+base = ENV.fetch("QUIZZY_TEST_URL", "http://localhost:3000")
+session.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "quizzy"))
+def assert(value, message)
+  raise message unless value
+end
+s = session
+created_urls = []
+data = {
+  "title" => "Transfer test #{Time.now.to_i}",
+  "questions" => [
+    { "text" => 'Which HTTP code means "Too Many Requests"?', "active" => false,
+      "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ] },
+    { "text" => "Next <question> & café", "active" => true,
+      "options" => [ { "text" => "First", "correct" => true }, { "text" => "Second", "correct" => false } ] }
+  ]
+}
+begin
+  s.visit("#{base}/moderate")
+  s.click_link "Import quiz"
+  s.fill_in "Quiz JSON", with: "{bad JSON"
+  s.click_button "Import"
+  assert(s.has_css?('[role="alert"]', text: "not valid JSON"), "Missing parse error")
+  assert(s.has_field?("Quiz JSON", with: "{bad JSON"), "Input lost")
+  invalid = Marshal.load(Marshal.dump(data))
+  invalid["questions"].last["options"].each { |o| o["correct"] = false }
+  s.fill_in "Quiz JSON", with: JSON.generate(invalid)
+  s.click_button "Import"
+  assert(s.has_css?('[role="alert"]', text: "Question 2: Mark at least one option as correct"), "Missing validation error")
+  s.click_link "Cancel"
+  assert(s.has_no_css?(".quiz-tile", text: data["title"]), "Partial quiz imported")
+
+  2.times do
+    s.click_link "Import quiz"
+    s.fill_in "Quiz JSON", with: JSON.pretty_generate(data)
+    s.click_button "Import"
+    assert(s.has_css?("h1", text: data["title"]), "Did not open imported quiz")
+    created_urls << s.current_url
+    assert(s.has_css?(".question-item", count: 2), "Missing questions")
+    s.within(s.all(".question-item").first) do
+      assert(s.has_unchecked_field?("Active"), "Inactive flag lost")
+    end
+    s.click_link "Export"
+    assert(s.all("pre").size == 1, "Expected one pre")
+    data = JSON.parse(s.find("pre").text)
+    assert(data["questions"].last["text"] == "Next <question> & café", "Text changed")
+    s.driver.resize(390, 844)
+    assert(s.evaluate_script("document.documentElement.scrollWidth <= window.innerWidth"), "Mobile export overflow")
+    s.visit("#{base}/moderate")
+  end
+  assert(created_urls.uniq.size == 2, "Import reused a quiz")
+  assert(s.all(".quiz-tile", text: data["title"]).size == 2, "Duplicate title quiz missing")
+  puts "Transfer browser smoke: all checks passed"
+ensure
+  created_urls.each do |url|
+    s.visit(url)
+    s.click_link "Settings"
+    s.accept_confirm { s.click_button "Delete quiz" }
+  end
+  s.driver.quit
+end
diff --git a/test/integration/quiz_transfer_test.rb b/test/integration/quiz_transfer_test.rb
new file mode 100644
index 0000000..d7829ad
--- /dev/null
+++ b/test/integration/quiz_transfer_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class QuizTransferTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "moderator"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "secret"
+    @auth = { "HTTP_AUTHORIZATION" => ActionController::HttpAuthentication::Basic.encode_credentials("moderator", "secret") }
+    @contents = {
+      "title" => "Frontend Fest 2026",
+      "questions" => [
+        { "text" => 'Which code means "Too Many Requests"?', "active" => false,
+          "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ] },
+        { "text" => "Second question", "active" => true,
+          "options" => [ { "text" => "Yes", "correct" => true }, { "text" => "No", "correct" => false } ] }
+      ]
+    }
+  end
+
+  test "moderator can import and export ordered contents without metadata" do
+    get moderate_root_path, headers: @auth
+    assert_select "a", text: "Import quiz"
+    get import_moderate_quizzes_path, headers: @auth
+    assert_select "label", text: "Quiz JSON"
+    assert_difference [ "Quiz.count", "Question.count" ], 2 do
+      2.times { post import_moderate_quizzes_path, params: { quiz_json: @contents.merge("questions" => [ @contents["questions"].first ]).to_json }, headers: @auth }
+    end
+    assert_difference "Question.count", 2 do
+      post import_moderate_quizzes_path, params: { quiz_json: @contents.to_json }, headers: @auth
+    end
+    quiz = Quiz.order(:id).last
+    assert_redirected_to moderate_quiz_path(quiz)
+    follow_redirect! headers: @auth
+    assert_select "a", text: "Export"
+    get export_moderate_quiz_path(quiz), headers: @auth
+    assert_response :success
+    assert_select "pre", count: 1 do |nodes|
+      assert_equal @contents, JSON.parse(nodes.first.text)
+    end
+    assert_equal [ 1, 2 ], quiz.questions.pluck(:position)
+  end
+
+  test "optional booleans default and empty quiz is allowed" do
+    @contents["questions"].each do |q|
+      q.delete("active")
+      q["options"].reject { |o| o["correct"] }.each { |o| o.delete("correct") }
+    end
+    post import_moderate_quizzes_path, params: { quiz_json: @contents.to_json }, headers: @auth
+    assert_response :redirect
+    quiz = Quiz.order(:id).last
+    assert quiz.questions.all?(&:active?)
+    assert_equal false, quiz.questions.first.options.first["correct"]
+    post import_moderate_quizzes_path, params: { quiz_json: { title: "Empty", questions: [] }.to_json }, headers: @auth
+    assert_response :redirect
+    assert_empty Quiz.order(:id).last.questions
+  end
+
+  test "invalid structures and rules import nothing and preserve input" do
+    invalid = [ "{", "null", "[]", "42", "true", '"string"' ]
+    invalid += [ {}, { title: "X" }, { title: " ", questions: [] }, { title: 5, questions: [] },
+      { title: "X", questions: {} }, { title: "X", questions: [ nil ] } ].map(&:to_json)
+    [ { "text" => " " }, { "text" => [] }, { "active" => "false" }, { "active" => nil },
+      { "options" => nil }, { "options" => [ "bad" ] },
+      { "options" => [ { "text" => "only", "correct" => true } ] },
+      { "options" => [ { "text" => "a" }, { "text" => "b" } ] },
+      { "options" => [ { "text" => "a", "correct" => "true" }, { "text" => "b" } ] },
+      { "options" => [ { "text" => 123, "correct" => true }, { "text" => "b" } ] }
+    ].each do |changes|
+      data = Marshal.load(Marshal.dump(@contents))
+      data["questions"].last.merge!(changes)
+      invalid << data.to_json
+    end
+    invalid.each do |json|
+      assert_no_difference [ "Quiz.count", "Question.count" ], json do
+        post import_moderate_quizzes_path, params: { quiz_json: json }, headers: @auth
+      end
+      assert_response :unprocessable_entity
+      assert_select '[role="alert"]'
+      assert_select "textarea", text: json
+    end
+  end
+
+  test "import uses form normalization and ignores metadata rather than assigning it" do
+    original = Quiz.create!(title: "Untouched")
+    @contents["id"] = original.id
+    @contents["questions"].first["options"].insert(1, { "text" => "   ", "correct" => true })
+    @contents["questions"].first["options"].last["text"] = "  429  "
+    @contents["questions"].first.merge!("position" => 99, "quiz_id" => original.id)
+    post import_moderate_quizzes_path, params: { quiz_json: @contents.to_json }, headers: @auth
+    assert_response :redirect
+    quiz = Quiz.order(:id).last
+    assert_not_equal original.id, quiz.id
+    assert_equal "Untouched", original.reload.title
+    assert_empty original.questions
+    assert_equal [ "418", "429" ], quiz.questions.first.options.map { |o| o["text"] }
+    assert_equal 1, quiz.questions.first.position
+  end
+
+  test "export follows current order and escapes HTML without altering JSON contents" do
+    @contents["title"] = '</pre><script>alert("quiz")</script> & Café'
+    post import_moderate_quizzes_path, params: { quiz_json: @contents.to_json }, headers: @auth
+    quiz = Quiz.order(:id).last
+    post_question = quiz.questions.last
+    patch move_moderate_quiz_question_path(quiz, post_question), params: { direction: "up" }, headers: @auth
+    get export_moderate_quiz_path(quiz), headers: @auth
+    assert_response :success
+    assert_select "script", text: 'alert("quiz")', count: 0
+    assert_select "pre", count: 1 do |nodes|
+      assert_equal @contents.merge("questions" => @contents["questions"].reverse), JSON.parse(nodes.first.text)
+    end
+  end
+
+  test "transfer endpoints require authentication" do
+
+    quiz = Quiz.create!(title: "Private")
+    get export_moderate_quiz_path(quiz)
+    assert_response :unauthorized
+    get import_moderate_quizzes_path
+    assert_response :unauthorized
+    assert_no_difference "Quiz.count" do
+      post import_moderate_quizzes_path, params: { quiz_json: @contents.to_json }
+    end
+    assert_response :unauthorized
+  end
+end
