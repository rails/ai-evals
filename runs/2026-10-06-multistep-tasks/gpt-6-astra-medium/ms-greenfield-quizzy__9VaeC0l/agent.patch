diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..b63ec5f
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,208 @@
+class Game < ApplicationRecord
+  class Conflict < StandardError; end
+  validates :number_of_winners, numericality: { only_integer: true, greater_than_or_equal_to: 1 }
+  validates :timer_duration_seconds, numericality: { only_integer: true, greater_than_or_equal_to: 0 }
+  belongs_to :quiz
+  has_many :game_questions, -> { order(:position) }, dependent: :destroy
+  has_many :players, dependent: :destroy
+  has_many :answers, through: :game_questions
+
+  def self.start_for!(quiz)
+    transaction do
+      game = create!(
+        quiz: quiz, title: quiz.title, number_of_winners: quiz.number_of_winners,
+        timer_duration_seconds: quiz.timer_minutes * 60 + quiz.timer_seconds,
+        code: SecureRandom.alphanumeric(8).upcase
+      )
+      quiz.questions.where(active: true).each_with_index do |question, index|
+        game.game_questions.create!(text: question.text, options: question.options, position: index)
+      end
+      game
+    end
+  end
+
+  def current_question
+    game_questions.find_by(position: question_index) unless question_index.negative?
+  end
+
+  def advance!(command, expected_revision)
+    expire_if_due!
+    with_lock do
+      raise Conflict, "The game has moved on. Please try again." unless revision.to_s == expected_revision.to_s
+      case [ status, command ]
+      when [ "waiting", "start" ]
+        self.question_index = 0
+        self.status = game_questions.exists? ? "open" : "ended"
+      when [ "open", "finish" ]
+        self.status = "closed"
+      when [ "closed", "next" ]
+        raise Conflict, "This is the last question." if question_index + 1 >= game_questions.count
+        self.question_index += 1
+        self.status = "open"
+      when [ "closed", "end" ]
+        raise Conflict, "There are more questions." unless question_index + 1 == game_questions.count
+        self.status = "ended"
+      when [ "ended", "top" ], [ "ended", "draw" ], [ "ended", "reset" ]
+        select_winners!(command)
+      else
+        raise Conflict, "That action is not available now."
+      end
+      if status == "open"
+        opened_at = Time.current
+        current_question.update!(opened_at: opened_at)
+        self.question_deadline = opened_at + timer_duration_seconds.seconds if timer_duration_seconds.positive?
+      else
+        self.question_deadline = nil
+      end
+      self.revision += 1
+      save!
+    end
+    notify
+  end
+
+  def record_answer!(player, question_id, option_index)
+    expired = false
+    with_lock do
+      picked_at = Time.current
+      # Check inside the same transaction as the answer. Do not raise until the
+      # expired transition commits, or the exception would roll it back.
+      expired = close_if_due!(picked_at)
+      unless expired
+        question = current_question
+        raise Conflict, "This question is no longer open." unless status == "open" && question&.id.to_s == question_id.to_s
+        raise Conflict, "Choose an option from this question." unless option_index.to_s.match?(/\A\d+\z/) && option_index.to_i < question.options.size
+        raise Conflict, "Join this game first." unless player.game_id == id
+        answer = player.answers.find_or_initialize_by(game_question: question)
+        answer.update!(option_index: option_index.to_i, picked_at: picked_at)
+        player.update!(last_seen_at: picked_at)
+      end
+    end
+    if expired
+      notify
+      raise Conflict, "This question is no longer open."
+    end
+    notify_counters
+    ActionCable.server.broadcast("player:#{player.id}", { changed: true })
+  end
+
+  # The deadline is durable; the sweeper needs no in-memory scheduled jobs and
+  # recovers overdue questions after restarts. Reads also recover missed ticks.
+  def self.expire_due!
+    where(status: "open").where("question_deadline <= ?", Time.current).find_each(&:expire_if_due!)
+  end
+
+  def expire_if_due!
+    return false unless timer_due?
+    expired = with_lock { close_if_due! }
+    notify if expired
+    expired
+  end
+
+  def timer_due?(now = Time.current)
+    status == "open" && question_deadline.present? && question_deadline <= now
+  end
+
+  # Caller must hold the game's lock. Rechecking makes competing timer ticks,
+  # manual Finish actions, and stale screens safe and idempotent.
+  def close_if_due!(now = Time.current)
+    return false unless timer_due?(now)
+    update!(status: "closed", question_deadline: nil, revision: revision + 1)
+    true
+  end
+  private :close_if_due!
+
+  def notify
+    ActionCable.server.broadcast("game:#{id}", { changed: true })
+  end
+
+  def notify_counters
+    ActionCable.server.broadcast("counters:#{id}", { changed: true })
+  end
+
+  # Explicit allowlist: never serialize the question's raw options to an open phone.
+  def live_state(player: nil, moderator: false)
+    expire_if_due!
+    data = { title: title, status: status, revision: revision }
+    if moderator
+      active = players.present_now
+      data[:players] = active.count
+      if status == "open" && question_deadline
+        data[:timer] = { deadline: question_deadline.iso8601(6), server_now: Time.current.iso8601(6) }
+      end
+    else
+      data[:name] = player&.name
+    end
+    if status == "ended"
+      rows = leaderboard
+      if moderator
+        data[:number_of_winners] = number_of_winners
+        data[:leaderboard] = rows
+      elsif player && (row = rows.find { |entry| entry[:id] == player.id })
+        data[:standing] = row.slice(:place, :points, :winner).merge(total: rows.size)
+      end
+    end
+    question = current_question
+    if question && status.in?([ "open", "closed" ])
+      data[:question] = {
+        id: question.id, text: question.text, number: question_index + 1,
+        total: game_questions.count,
+        options: question.options.map { |option| { text: option.fetch("text") } }
+      }
+      answer = player&.answers&.find_by(game_question: question)
+      data[:selection] = answer&.option_index unless moderator
+      if moderator
+        data[:answers] = question.answers.where(player_id: active.select(:id)).count
+      end
+      if status == "closed"
+        counts = question.answers.group(:option_index).count if moderator
+        question.options.each_with_index do |option, i|
+          data[:question][:options][i][:correct] = option["correct"]
+          data[:question][:options][i][:count] = counts.fetch(i, 0) if moderator
+        end
+        unless moderator
+          data[:result] = answer ? (question.options[answer.option_index]["correct"] ? "Correct!" : "Wrong!") : "No answer"
+        end
+      end
+    end
+    data
+  end
+
+  # All joined players rank, even if disconnected. A perfect tie is resolved by
+  # join order so repeated reads and winner selections stay deterministic.
+  def leaderboard
+    questions = game_questions.index_by(&:id)
+    rows = players.includes(:answers).map do |player|
+      correct = player.answers.select do |answer|
+        questions[answer.game_question_id]&.options&.dig(answer.option_index, "correct")
+      end
+      elapsed = correct.sum do |answer|
+        opened_at = questions.fetch(answer.game_question_id).opened_at
+        # Historical games predate timing; do not invent elapsed times for them.
+        opened_at && answer.picked_at ? [((answer.picked_at - opened_at) * 1_000_000).round, 0].max : 0
+      end
+      { id: player.id, name: player.name, points: correct.size, elapsed: elapsed, winner: player.winner? }
+    end
+    rows.sort_by! { |row| [-row[:points], row[:elapsed], row[:id]] }
+    rows.each_with_index.map { |row, index| row.except(:elapsed).merge(place: index + 1) }
+  end
+
+  private
+
+  # Called under the same game lock as transitions and answers. Each draw is a
+  # fresh selection from the entire cutoff pool, not the previous winners.
+  def select_winners!(command)
+    selected = []
+    unless command == "reset"
+      eligible = leaderboard.select { |row| row[:points].positive? }
+      selected = eligible.take(number_of_winners)
+      if command == "draw" && eligible.size > number_of_winners
+        cutoff = selected.last.fetch(:points)
+        guaranteed = eligible.select { |row| row[:points] > cutoff }
+        pool = eligible.select { |row| row[:points] == cutoff }
+        selected = guaranteed + pool.sample(number_of_winners - guaranteed.size)
+      end
+    end
+    players.update_all(winner: false)
+    players.where(id: selected.map { |row| row[:id] }).update_all(winner: true)
+  end
+end
