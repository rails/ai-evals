diff --git a/test/models/game_test.rb b/test/models/game_test.rb
new file mode 100644
index 0000000..555bc67
--- /dev/null
+++ b/test/models/game_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class GameTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Original title")
+    @question = @quiz.questions.create!(text: "Original question", position: 1,
+      options: [{ "text" => "Right", "correct" => true }, { "text" => "Wrong", "correct" => false }])
+    @game = Game.start_for!(@quiz)
+    @player = @game.players.create!(name: "Alice", browser_token: "alice", last_seen_at: Time.current)
+  end
+
+  test "snapshots remain stable after editing or deleting source questions" do
+    @quiz.update!(title: "Edited title")
+    @question.update!(text: "Changed", active: false)
+    @question.destroy!
+    assert_equal "Original title", @game.title
+    assert_equal "Original question", @game.game_questions.sole.text
+    @game.advance!("start", 0)
+    assert_equal "Original question", @game.live_state(player: @player).dig(:question, :text)
+    assert_empty Game.start_for!(@quiz).game_questions
+  end
+
+  test "stale or out-of-order controls cannot move game twice" do
+    assert_raises(Game::Conflict) { @game.advance!("next", 0) }
+    @game.advance!("start", 0)
+    assert_raises(Game::Conflict) { @game.advance!("start", 0) }
+    assert_raises(Game::Conflict) { @game.advance!("end", 1) }
+    @game.advance!("finish", 1)
+    assert_raises(Game::Conflict) { @game.advance!("next", 2) }
+    @game.advance!("end", 2)
+    assert_raises(Game::Conflict) { @game.advance!("start", 3) }
+    assert_equal "ended", @game.reload.status
+  end
+
+  test "invalid choices and foreign questions or players cannot submit" do
+    @game.advance!("start", 0)
+    id = @game.current_question.id
+    [-1, 2, nil, "abc", "0oops", "1.5"].each do |bad|
+      assert_raises(Game::Conflict) { @game.record_answer!(@player, id, bad) }
+    end
+    assert_raises(Game::Conflict) { @game.record_answer!(@player, id + 1, 0) }
+    other = Game.start_for!(@quiz)
+    outsider = other.players.create!(name: "Bob", browser_token: "bob", last_seen_at: Time.current)
+    assert_raises(Game::Conflict) { @game.record_answer!(outsider, id, 0) }
+    assert_empty @game.answers
+  end
+
+  test "presence expiry removes active counts but retains answers and identity" do
+    @game.advance!("start", 0)
+    @game.record_answer!(@player, @game.current_question.id, 0)
+    bob = @game.players.create!(name: "Bob", browser_token: "bob", last_seen_at: Time.current)
+    state = @game.live_state(moderator: true)
+    assert_equal [1, 2], state.values_at(:answers, :players)
+    travel 36.seconds do
+      bob.pulse!
+      state = @game.live_state(moderator: true)
+      assert_equal [0, 1], state.values_at(:answers, :players)
+      @player.pulse!
+      state = @game.live_state(moderator: true)
+      assert_equal [1, 2], state.values_at(:answers, :players)
+      assert_equal 0, @game.live_state(player: @player)[:selection]
+    end
+    @player.update!(last_seen_at: 1.minute.ago)
+    @game.advance!("finish", 1)
+    assert_equal 1, @game.live_state(moderator: true).dig(:question, :options, 0, :count)
+  end
+
+  test "a quiz with no active questions ends cleanly on start" do
+    @question.update!(active: false)
+    game = Game.start_for!(@quiz)
+    game.advance!("start", 0)
+    assert_equal "ended", game.reload.status
+    assert_nil game.live_state[:question]
+  end
+
+  test "deleting a quiz cleans its games, players and answers" do
+    @game.advance!("start", 0)
+    @game.record_answer!(@player, @game.current_question.id, 0)
+    @quiz.destroy!
+    assert_not Game.exists?(@game.id)
+    assert_not Player.exists?(@player.id)
+    assert_not Answer.exists?(player_id: @player.id)
+  end
+end
diff --git a/test/models/prizes_test.rb b/test/models/prizes_test.rb
new file mode 100644
index 0000000..fe6ab46
--- /dev/null
+++ b/test/models/prizes_test.rb
@@ -0,0 +1,146 @@
+require "test_helper"
+
+class PrizesTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Prizes")
+    2.times do |i|
+      @quiz.questions.create!(text: "Question #{i}", position: i,
+        options: [{ "text" => "Yes", "correct" => true }, { "text" => "No", "correct" => false }])
+    end
+  end
+
+  def start_game(names = %w[Alice Bob Charlie Nobody])
+    @game = Game.start_for!(@quiz)
+    @players = names.map { |name| @game.players.create!(name: name, browser_token: name, last_seen_at: Time.current) }
+    advance("start")
+  end
+
+  def advance(command)
+    @game.advance!(command, @game.reload.revision)
+  end
+
+  def pick(player, seconds, option = 0)
+    travel_to(@game.current_question.opened_at + seconds, with_usec: true) do
+      @game.record_answer!(player, @game.current_question.id, option)
+    end
+  end
+
+  def finish_game
+    advance("finish")
+    advance("end")
+  end
+
+  test "settings default, validation and snapshot" do
+    assert_equal 3, @quiz.number_of_winners
+    [0, -1, nil, 1.5, "invalid"].each do |invalid|
+      @quiz.number_of_winners = invalid
+      assert_not @quiz.valid?, "accepted #{invalid.inspect}"
+    end
+    @quiz.update!(number_of_winners: 2)
+    start_game
+    @quiz.update!(number_of_winners: 7)
+    assert_equal 2, @game.number_of_winners
+  end
+
+  test "points then total correct-answer speed using last pick, including repeated picks" do
+    start_game
+    alice, bob, charlie, = @players
+    pick(alice, 1)
+    pick(alice, 8) # picking the same option must update the clock too
+    pick(bob, 2)
+    pick(charlie, 20, 1) # wrong answers contribute neither points nor time
+    assert_nil @game.live_state(player: alice)[:standing]
+    assert_nil @game.live_state(moderator: true)[:leaderboard]
+    advance("finish")
+    advance("next")
+    pick(alice, 1)
+    pick(bob, 10)
+    pick(charlie, 1)
+    finish_game
+    rows = @game.live_state(moderator: true).fetch(:leaderboard)
+    assert_equal %w[Alice Bob Charlie Nobody], rows.map { |row| row[:name] }
+    assert_equal [2, 2, 1, 0], rows.map { |row| row[:points] }
+    assert_equal [1, 2, 3, 4], rows.map { |row| row[:place] }
+    assert_equal({ place: 2, total: 4, points: 2, winner: false }, @game.live_state(player: bob).fetch(:standing))
+    assert_nil @game.live_state[:standing]
+    assert_nil @game.live_state(player: bob)[:leaderboard]
+  end
+
+  test "top and draw use points cutoff, persist, reset, and never award zero points" do
+    @quiz.update!(number_of_winners: 2)
+    start_game
+    alice, bob, charlie, = @players
+    @players.take(3).each_with_index { |player, i| pick(player, i + 1) }
+    advance("finish")
+    advance("next")
+    pick(alice, 1)
+    finish_game
+    advance("top")
+    assert_equal [alice.id, bob.id], @game.players.where(winner: true).order(:id).pluck(:id)
+    drawn = []
+    30.times do
+      advance("draw")
+      ids = @game.players.where(winner: true).pluck(:id)
+      assert_equal 2, ids.size
+      assert_includes ids, alice.id
+      assert (ids - [alice.id, bob.id, charlie.id]).empty?
+      drawn.concat(ids)
+    end
+    assert_includes drawn, charlie.id # slower player remains eligible for a points tie
+    assert @game.live_state(player: alice.reload).dig(:standing, :winner)
+    advance("reset")
+    assert_empty @game.players.where(winner: true)
+    assert_not @game.live_state(player: alice.reload).dig(:standing, :winner)
+    @game.update!(number_of_winners: 10)
+    %w[top draw].each do |command|
+      advance(command)
+      assert_equal 3, @game.players.where(winner: true).count
+    end
+  end
+
+  test "no positive scores and no players are safe; premature and stale awards rejected" do
+    start_game([])
+    assert_raises(Game::Conflict) { advance("top") }
+    advance("finish")
+    advance("next")
+    finish_game
+    %w[top draw reset].each { |command| advance(command) }
+    assert_equal [], @game.live_state(moderator: true)[:leaderboard]
+    assert_raises(Game::Conflict) { @game.advance!("draw", -1) }
+    @game.players.create!(name: "Zero", browser_token: "zero", last_seen_at: Time.current)
+    %w[top draw].each { |command| advance(command); assert_empty @game.players.where(winner: true) }
+  end
+  test "repeated picks reset timing and final wrong picks lose their point" do
+    start_game
+    alice, bob, charlie, = @players
+    pick(alice, 1)
+    pick(alice, 8)
+    pick(bob, 2)
+    pick(charlie, 1)
+    pick(charlie, 3, 1)
+    advance("finish")
+    advance("next")
+    finish_game
+    assert_equal %w[Bob Alice Charlie Nobody], @game.leaderboard.map { |row| row[:name] }
+    assert_equal [1, 1, 0, 0], @game.leaderboard.map { |row| row[:points] }
+    assert_raises(Game::Conflict) { pick(bob, 1) }
+  end
+
+  test "microsecond speed ties are stable and include disconnected players" do
+    start_game
+    alice, bob, charlie, = @players
+    pick(alice, 1.000002)
+    pick(bob, 1.000001)
+    pick(charlie, 1.000001)
+    advance("finish")
+    advance("next")
+    finish_game
+    bob.update!(last_seen_at: 1.day.ago)
+    assert_equal %w[Bob Charlie Alice Nobody], @game.leaderboard.map { |row| row[:name] }
+    advance("top")
+    assert_equal 3, @game.players.where(winner: true).count
+    fresh = Game.start_for!(@quiz)
+    assert_empty fresh.players
+    assert_empty fresh.leaderboard
+  end
+end
diff --git a/test/models/question_test.rb b/test/models/question_test.rb
new file mode 100644
index 0000000..6cb8ee5
--- /dev/null
+++ b/test/models/question_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class QuestionTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Conference")
+  end
+
+  test "blank rows are ignored and multiple correct options are valid" do
+    q = @quiz.questions.new(text: "Choose one", position: 1)
+    q.option_rows = { "0" => { text: " One ", correct: "1" }, "1" => { text: "  ", correct: "1" }, "2" => { text: "Two", correct: "1" } }
+    assert q.save
+    assert_equal [ { "text" => "One", "correct" => true }, { "text" => "Two", "correct" => true } ], q.reload.options
+    assert q.active?
+  end
+
+  test "invalid edits do not change saved data and retain all typed rows" do
+    q = @quiz.questions.create!(text: "Original", position: 1, options: [ { text: "One", correct: true }, { text: "Two", correct: false } ])
+    q.option_rows = { "0" => { text: "Changed", correct: "0" }, "1" => { text: "", correct: "1" } }
+    q.text = "Unsaved edit"
+    assert_not q.save
+    assert_includes q.errors.full_messages, "Add at least two options"
+    assert_includes q.errors.full_messages, "Mark at least one option as correct"
+    assert_equal "Changed", q.option_rows.first["text"]
+    assert_equal 2, q.option_rows.size
+    assert_equal "Original", Question.find(q.id).text
+    assert_equal "One", Question.find(q.id).options.first["text"]
+  end
+
+  test "question and quiz text is required and quiz deletion cascades" do
+    assert_not Quiz.new(title: " ").valid?
+    q = @quiz.questions.new(text: " ", position: 1, options: [ { text: "One", correct: true }, { text: "Two", correct: false } ])
+    assert_not q.valid?
+    q.update!(text: "Question")
+    assert_difference "Question.count", -1 do
+      @quiz.destroy!
+    end
+  end
+end
diff --git a/test/models/timer_test.rb b/test/models/timer_test.rb
new file mode 100644
index 0000000..8abae26
--- /dev/null
+++ b/test/models/timer_test.rb
@@ -0,0 +1,149 @@
+require "test_helper"
+
+class TimerTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Timed quiz", timer_minutes: 0, timer_seconds: 5)
+    2.times do |index|
+      @quiz.questions.create!(text: "Question #{index + 1}", position: index, options: [ { text: "Right", correct: true }, { text: "Wrong", correct: false } ])
+    end
+    @game = Game.start_for!(@quiz)
+    @player = @game.players.create!(name: "Player", browser_token: "timer-player", last_seen_at: Time.current)
+  end
+
+  test "countdown starts on opening and reload never changes its deadline" do
+    assert_nil @game.question_deadline
+    travel_to Time.current.change(usec: 0) do
+      @game.advance!("start", 0)
+      deadline = Time.current + 5.seconds
+      assert_equal deadline, @game.reload.question_deadline
+      travel 2.seconds
+      state = @game.reload.live_state(moderator: true)
+      assert_equal deadline.iso8601(6), state.dig(:timer, :deadline)
+      assert_nil @game.live_state(player: @player)[:timer]
+      assert_equal "open", @game.reload.status
+      assert_equal deadline, @game.question_deadline
+    end
+  end
+
+  test "expiration finishes exactly once and reveals results" do
+    @game.advance!("start", 0)
+    @game.record_answer!(@player, @game.current_question.id, 0)
+    travel_to @game.question_deadline, with_usec: true do
+      assert @game.expire_if_due!
+      assert_equal "closed", @game.reload.status
+      assert_equal 2, @game.revision
+      assert_not @game.expire_if_due!
+      assert_equal 2, @game.reload.revision
+      assert_equal "Correct!", @game.live_state(player: @player)[:result]
+      assert_nil @game.live_state(moderator: true)[:timer]
+    end
+  end
+
+  test "late answers are rejected and expiration persists despite the rejection" do
+    @game.advance!("start", 0)
+    travel_to @game.question_deadline, with_usec: true do
+      assert_raises(Game::Conflict) { @game.record_answer!(@player, @game.current_question.id, 0) }
+      assert_equal "closed", @game.reload.status
+      assert_empty @player.answers
+    end
+  end
+
+  test "early finish and next have independent deadlines" do
+    @game.advance!("start", 0)
+    old_deadline = @game.question_deadline
+    @game.advance!("finish", 1)
+    assert_nil @game.reload.question_deadline
+    travel_to old_deadline + 1.second do
+      assert_not @game.expire_if_due!
+      @game.advance!("next", 2)
+      assert_equal Time.current + 5.seconds, @game.reload.question_deadline
+      assert_equal "open", @game.status
+      assert_not @game.expire_if_due!
+    end
+  end
+
+  test "a stale expiry cannot close the next question or finish twice" do
+    @game.advance!("start", 0)
+    stale = Game.find(@game.id)
+    @game.advance!("finish", 1)
+    travel_to stale.question_deadline, with_usec: true do
+      @game.advance!("next", 2)
+      assert_not stale.expire_if_due!
+      assert_equal "open", @game.reload.status
+      assert_equal 3, @game.revision
+    end
+    first, second = Game.find(@game.id), Game.find(@game.id)
+    travel_to @game.question_deadline, with_usec: true do
+      assert first.expire_if_due!
+      assert_not second.expire_if_due!
+      assert_equal 4, @game.reload.revision
+    end
+  end
+
+  test "an answer immediately before the deadline counts and cannot change afterward" do
+    @game.advance!("start", 0)
+    deadline = @game.question_deadline
+    travel_to deadline - 0.001.seconds, with_usec: true do
+      @game.record_answer!(@player, @game.current_question.id, 0)
+    end
+    travel_to deadline, with_usec: true do
+      assert_raises(Game::Conflict) { @game.record_answer!(@player, @game.current_question.id, 1) }
+      assert_equal 0, @player.answers.sole.option_index
+      assert_equal "Correct!", @game.live_state(player: @player)[:result]
+    end
+  end
+
+  test "no timer means no automatic finish" do
+    @quiz.update!(timer_seconds: 0)
+    game = Game.start_for!(@quiz)
+    game.advance!("start", 0)
+    travel 1.day do
+      assert_not game.expire_if_due!
+      assert_equal "open", game.reload.status
+      assert_nil game.question_deadline
+      assert_nil game.live_state(moderator: true)[:timer]
+    end
+  end
+
+  test "server sweep recovers overdue games without a connected browser" do
+    @game.advance!("start", 0)
+    travel_to @game.question_deadline + 1.minute do
+      Game.expire_due!
+      assert_equal "closed", @game.reload.status
+    end
+  end
+
+  test "state reads recover overdue games after a restart" do
+    @game.advance!("start", 0)
+    travel_to @game.question_deadline, with_usec: true do
+      assert_equal "closed", @game.reload.live_state(player: @player)[:status]
+      assert_equal "closed", @game.reload.status
+    end
+  end
+
+  test "timer is snapshotted for the game but never transferred" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    game = Game.start_for!(@quiz)
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    assert_equal 90, game.timer_duration_seconds
+    game.advance!("start", 0)
+    assert_in_delta 90, game.question_deadline - game.current_question.opened_at, 0.001
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    exported = QuizTransfer.export(@quiz)
+    assert_equal %w[number_of_winners questions title], exported.keys.sort
+    imported = QuizTransfer.import(exported.merge("timer_minutes" => 5, "timer_seconds" => 20).to_json)
+    assert_equal [0, 0], imported.values_at(:timer_minutes, :timer_seconds)
+  end
+
+  test "settings default to zero and reject negative or fractional numbers" do
+    quiz = Quiz.new(title: "Defaults")
+    assert_equal [0, 0], quiz.values_at(:timer_minutes, :timer_seconds)
+    [:timer_minutes, :timer_seconds].each do |field|
+      [-1, 1.5, "abc", nil].each do |invalid|
+        quiz.assign_attributes(timer_minutes: 0, timer_seconds: 0)
+        quiz[field] = invalid
+        assert_not quiz.valid?, "#{field} accepted #{invalid.inspect}"
+      end
+    end
+  end
+end
