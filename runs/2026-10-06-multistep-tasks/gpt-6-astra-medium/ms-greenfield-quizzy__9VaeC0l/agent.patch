new file mode 100644
index 0000000..f4ebe44
--- /dev/null
+++ b/script/browser_smoke.rb
@@ -0,0 +1,112 @@
+# Run against bin/serve with moderator / quizzy credentials, or set the variables below.
+require "capybara/cuprite"
+Capybara.register_driver(:cuprite) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: "/usr/bin/chromium", browser_options: { "no-sandbox" => nil }, window_size: [ 1440, 1000 ])
+end
+Capybara.default_driver = :cuprite
+Capybara.default_max_wait_time = 5
+Capybara.enable_aria_label = true
+session = Capybara::Session.new(:cuprite)
+base = ENV.fetch("QUIZZY_TEST_URL", "http://localhost:3000")
+session.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "quizzy"))
+def assert(value, message)
+  raise message unless value
+end
+s = session
+s.visit("file:///app/docs/mockups/quiz.html")
+s.save_screenshot("/app/storage/mockup-quiz.png")
+s.visit("file:///app/docs/mockups/question-form.html")
+s.save_screenshot("/app/storage/mockup-form.png")
+s.visit("#{base}/moderate")
+s.click_link "New quiz"
+s.fill_in "Title", with: "Browser test #{Time.now.to_i}"
+s.click_button "Save quiz"
+quiz_url = s.current_url
+s.click_link "Preview"
+assert(s.has_text?("No active questions"), "Empty preview missing")
+s.click_button "Start over"
+assert(s.has_text?("No active questions"), "Empty restart failed")
+s.visit(quiz_url)
+assert(s.evaluate_script('getComputedStyle(document.body).backgroundColor') == "rgb(233, 230, 255)", "Design stylesheet missing")
+assert(s.evaluate_script('document.fonts.check("18px Inter")'), "Local font missing")
+s.click_link "Add question"
+assert(s.all('.option-row').size == 4, "Must start with four rows")
+assert(s.has_checked_field?("Active"), "Active should default on")
+s.fill_in "Question", with: "Which planet is the largest?"
+s.fill_in "Option 1", with: "Jupiter"
+s.check "Option 1 is correct"
+s.click_button "Save question"
+assert(s.has_text?("Add at least two options"), "Missing minimum validation")
+assert(s.has_field?("Option 1", with: "Jupiter"), "Lost entered text")
+s.fill_in "Option 2", with: "Saturn"
+s.uncheck "Option 1 is correct"
+s.click_button "Save question"
+assert(s.has_text?("Mark at least one option as correct"), "Missing correct validation")
+s.check "Option 1 is correct"
+s.click_button "Add option"
+s.fill_in "Option 5", with: "Earth"
+s.check "Option 5 is correct"
+s.save_screenshot("/app/storage/actual-form.png")
+s.click_button "Save question"
+assert(s.has_selector?(".question-item", count: 1), "Question not saved")
+assert(s.all(".question-item__options .is-correct").size == 2, "Correct flags missing")
+s.click_link "Add question"
+s.fill_in "Question", with: "Second question"
+s.fill_in "Option 1", with: "Yes"
+s.fill_in "Option 2", with: "No"
+s.check "Option 1 is correct"
+s.click_button "Save question"
+s.within(s.all(".question-item").last) { s.click_button "Move up" }
+assert(s.all(".question-item").first.has_text?("Second question"), "Move up failed")
+s.within(s.all(".question-item").first) { s.click_button "Move down" }
+assert(s.all(".question-item").last.has_text?("Second question"), "Move down failed")
+s.within(s.all(".question-item").last) { s.uncheck "Active" }
+assert(s.has_text?("1 of 2 questions active"), "Toggle did not save")
+s.save_screenshot("/app/storage/actual-quiz.png")
+s.click_link "Preview"
+assert(s.has_text?("Question 1 of 1"), "Inactive question not skipped")
+s.click_button "Saturn"
+assert(s.has_text?("Wrong!"), "Incorrect feedback")
+assert(s.all(".play-option.is-correct").size == 2, "Answers not revealed")
+s.click_button "See score"
+assert(s.has_text?("Score: 0/1"), "Incorrect score")
+s.click_button "Start over"
+s.click_button "Jupiter"
+assert(s.has_text?("Correct!"), "Correct feedback missing")
+s.click_button "See score"
+assert(s.has_text?("Score: 1/1"), "Restart didn't reset score")
+s.visit(quiz_url)
+s.within(s.all(".question-item").last) { s.check "Active" }
+assert(s.has_text?("2 of 2 questions active"), "Activation failed")
+s.click_link "Preview"
+s.click_button "Jupiter"
+s.click_button "Next question"
+assert(s.has_text?("Question 2 of 2"), "Preview sequence failed")
+s.click_button "Yes"
+s.click_button "See score"
+assert(s.has_text?("Score: 2/2"), "Multi-question score failed")
+s.visit(quiz_url)
+s.within(s.all(".question-item").first) { s.click_link "Edit" }
+assert(s.has_field?("Option 3", with: "Earth"), "Blank rows not skipped")
+s.fill_in "Question", with: "Edited question"
+s.uncheck "Option 3 is correct"
+s.click_button "Save question"
+assert(s.has_text?("Edited question"), "Edit failed")
+s.dismiss_confirm { s.within(s.all(".question-item").first) { s.click_button "Delete" } }
+assert(s.has_selector?(".question-item", count: 2), "Cancel deleted question")
+s.accept_confirm { s.within(s.all(".question-item").first) { s.click_button "Delete" } }
+assert(s.has_selector?(".question-item", count: 1), "Delete failed")
+s.click_link "Settings"
+s.fill_in "Title", with: "Renamed quiz"
+s.click_button "Save quiz"
+assert(s.has_css?("h1", text: "Renamed quiz"), "Quiz rename failed")
+s.driver.resize(390, 844)
+s.save_screenshot("/app/storage/mobile-quiz.png")
+assert(s.evaluate_script("document.documentElement.scrollWidth <= window.innerWidth"), "Mobile overflow")
+s.click_link "Settings"
+s.dismiss_confirm { s.click_button "Delete quiz" }
+assert(s.has_button?("Save quiz"), "Cancel deleted quiz")
+s.accept_confirm { s.click_button "Delete quiz" }
+assert(s.has_text?("Your quizzes"), "Quiz delete failed")
+puts "Browser smoke: all checks passed"
+s.driver.quit
diff --git a/script/live_smoke.rb b/script/live_smoke.rb
new file mode 100644
index 0000000..81c7851
--- /dev/null
+++ b/script/live_smoke.rb
@@ -0,0 +1,106 @@
+# Production, multi-browser regression: run bin/serve first.
+require "capybara/cuprite"
+require "json"
+Capybara.register_driver(:live_chromium) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: "/usr/bin/chromium", browser_options: { "no-sandbox" => nil }, window_size: [ 1440, 1000 ])
+end
+Capybara.default_max_wait_time = ENV["NO_WEBSOCKETS"] ? 15 : 6
+Capybara.enable_aria_label = true
+base = ENV.fetch("QUIZZY_TEST_URL", "http://localhost:3000")
+moderator, alice, bob, late = Array.new(4) { Capybara::Session.new(:live_chromium) }
+if ENV["NO_WEBSOCKETS"]
+  [moderator, alice, bob, late].each do |browser|
+    browser.driver.browser.evaluate_on_new_document <<~JS
+      window.WebSocket = class { constructor() { this.readyState = 3; } close() {} };
+    JS
+  end
+end
+moderator.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "quizzy"))
+def check(condition, message)
+  raise message unless condition
+end
+begin
+  title = "Live browser #{Time.now.to_i}"
+  options = [{ text: "Blue", correct: true }, { text: "Pink", correct: false }, { text: "Green", correct: true }]
+  moderator.visit("#{base}/moderate/quizzes/import")
+  moderator.fill_in "Quiz JSON", with: JSON.generate(title: title, questions: [
+    { text: "First live question?", options: options },
+    { text: "Do not show this", active: false, options: options },
+    { text: "Second live question?", options: options },
+    { text: "Last live question?", options: options }
+  ])
+  moderator.click_button "Import", exact: true
+  quiz_url = moderator.current_url
+  moderator.click_button "Start a game"
+  screen_url = moderator.current_url
+  check(screen_url.include?("/moderate/games/"), "Screen left moderator area")
+  check(moderator.has_text?("Players: 0"), "Empty lobby missing")
+  join_url = moderator.find(".lobby__url").text
+  check(moderator.has_css?(".qr svg"), "QR missing")
+  check(moderator.find(".qr")[:'aria-label'].include?(join_url), "QR URL differs")
+  moderator.save_screenshot("/app/storage/live-lobby.png")
+  [ [alice, "Alice"], [bob, "Bob"] ].each do |browser, name|
+    browser.visit(join_url)
+    browser.fill_in "Your name", with: name
+    browser.click_button "Join"
+    check(browser.has_text?("Hi, #{name}!"), "Greeting missing")
+  end
+  check(moderator.has_text?("Players: 2"), "Live waiting count missing")
+  alice.visit(join_url)
+  check(alice.has_text?("Hi, Alice!"), "Player not remembered")
+  [moderator, alice, bob].each { |browser| browser.execute_script("window.noReloadMarker = 42") }
+  moderator.click_button "Start", exact: true
+  check(alice.has_text?("First live question?", wait: ENV["NO_WEBSOCKETS"] ? 15 : 4), "Phone did not follow Start")
+  check(bob.has_text?("Question 1 of 3"), "Inactive question not skipped")
+  check(moderator.has_text?("Answers: 0 / 2"), "Answer denominator missing")
+  check(!alice.evaluate_script("document.getElementById('initial-state').textContent").include?("correct"), "Initial source leaks keys")
+  open_state = alice.evaluate_async_script("fetch(location.pathname + '/state').then(r=>r.json()).then(arguments[0])")
+  check(!open_state.to_json.include?("correct"), "Open state leaks keys")
+  alice.click_button "Pink"
+  check(alice.has_css?("button.is-picked", text: "Your answer"), "Answer acknowledgement missing")
+  check(moderator.has_text?("Answers: 1 / 2"), "Answer count did not update")
+  alice.click_button "Blue"
+  check(alice.has_css?("button.is-picked", text: "Blue"), "Answer could not change")
+  bob.click_button "Pink"
+  check(moderator.has_text?("Answers: 2 / 2"), "Second answer not counted")
+  late.visit(join_url)
+  late.fill_in "Your name", with: "Charlie"
+  late.click_button "Join"
+  check(late.has_text?("First live question?"), "Late join did not continue")
+  check(moderator.has_text?("Answers: 2 / 3"), "Late join denominator wrong")
+  moderator.click_button "Finish"
+  check(alice.has_text?("Correct!", wait: ENV["NO_WEBSOCKETS"] ? 15 : 4), "Correct result missing")
+  check(bob.has_text?("Wrong!"), "Wrong result missing")
+  check(late.has_text?("No answer"), "No-answer result missing")
+  check(moderator.has_css?(".stage-option.is-correct", count: 2), "Multiple correct options not marked")
+  check(moderator.find(".stage-option", text: "Blue").has_css?(".stage-option__count", text: "1"), "Last pick not counted")
+  check(moderator.find(".stage-option", text: "Pink").has_css?(".stage-option__count", text: "1"), "Wrong pick count incorrect")
+  moderator.save_screenshot("/app/storage/live-results.png")
+  alice.driver.resize(390, 844)
+  alice.save_screenshot("/app/storage/live-phone.png")
+  moderator.click_button "Next"
+  check(alice.has_text?("Second live question?"), "Phone did not follow Next")
+  moderator.click_button "Finish"
+  check(alice.has_text?("No answer"), "New question retained old answer")
+  moderator.click_button "Next"
+  check(bob.has_text?("Question 3 of 3"), "Last question missing")
+  moderator.click_button "Finish"
+  moderator.click_button "End quiz"
+  [moderator, alice, bob, late].each { |browser| check(browser.has_text?("The quiz is over"), "End did not propagate") }
+  [moderator, alice, bob].each { |browser| check(browser.evaluate_script("window.noReloadMarker") == 42, "Page reloaded") }
+  late.driver.clear_cookies
+  late.visit(join_url)
+  check(late.has_text?("The quiz is over") && !late.has_button?("Join"), "Ended game allowed join")
+  moderator.visit(quiz_url)
+  moderator.click_button "Start a game"
+  check(moderator.current_url != screen_url, "Game reused")
+  check(moderator.has_text?("Players: 0"), "New game inherited players")
+  puts "Live Chromium checks passed"
+ensure
+  if quiz_url
+    moderator.visit(quiz_url)
+    moderator.click_link "Settings"
+    moderator.accept_confirm { moderator.click_button "Delete quiz" }
+  end
+  [moderator, alice, bob, late].each { |browser| browser.driver.quit }
+end
diff --git a/script/prizes_smoke.rb b/script/prizes_smoke.rb
new file mode 100644
index 0000000..4ebe509
--- /dev/null
+++ b/script/prizes_smoke.rb
@@ -0,0 +1,103 @@
+# Production browser check. Set NO_WEBSOCKETS=1 to exercise fast HTTP fallback.
+require "capybara/cuprite"
+require "json"
+Capybara.register_driver(:prizes) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: "/usr/bin/chromium", browser_options: { "no-sandbox" => nil }, window_size: [1440, 1000])
+end
+Capybara.default_max_wait_time = 5
+base = ENV.fetch("QUIZZY_TEST_URL", "http://localhost:3000")
+moderator, alice, bob, charlie, zero = browsers = Array.new(5) { Capybara::Session.new(:prizes) }
+if ENV["NO_WEBSOCKETS"]
+  browsers.each { |b| b.driver.browser.evaluate_on_new_document('window.WebSocket = class { constructor() { this.readyState = 3; } close() {} };') }
+end
+moderator.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "quizzy"))
+def check(condition, message)
+  raise message unless condition
+end
+begin
+  moderator.visit("#{base}/moderate/quizzes/import")
+  options = [{ text: "Right", correct: true }, { text: "Wrong", correct: false }]
+  moderator.fill_in "Quiz JSON", with: JSON.generate(title: "Prize browser #{Time.now.to_i}", questions: [
+    { text: "First prize question?", options: options }, { text: "Second prize question?", options: options }
+  ])
+  moderator.click_button "Import", exact: true
+  quiz_url = moderator.current_url
+  moderator.click_link "Settings"
+  check(moderator.find_field("Number of winners").value == "3", "Missing default prize count")
+  moderator.fill_in "Number of winners", with: "2"
+  moderator.click_button "Save quiz"
+  moderator.click_button "Start a game"
+  join_url = moderator.find(".lobby__url").text
+  [[alice, "Alice"], [bob, "Bob"], [charlie, "Charlie"], [zero, "Zero"]].each do |browser, name|
+    browser.visit(join_url)
+    browser.fill_in "Your name", with: name
+    browser.click_button "Join"
+    check(browser.has_text?("Hi, #{name}!"), "Join failed")
+  end
+  check(moderator.has_text?("Players: 4"), "Player count failed")
+  unless ENV["NO_WEBSOCKETS"]
+    sleep 0.5 # allow final subscription confirmation before disabling recovery reads
+    browsers.each do |browser|
+      browser.execute_script <<~JS
+        window.marker = "no reload";
+        const originalFetch = window.fetch;
+        window.fetch = (...args) => String(args[0]).endsWith('/state') ? Promise.reject(new Error('Polling disabled for socket test')) : originalFetch(...args);
+      JS
+    end
+  end
+  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+  moderator.click_button "Start"
+  [alice, bob, charlie, zero].each { |b| check(b.has_text?("First prize question?", wait: 2), "Question did not push promptly") }
+  puts "Question reached all phones in #{((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round}ms"
+  bob.click_button "Right"
+  sleep 0.15
+  charlie.click_button "Right"
+  alice.click_button "Wrong"
+  alice.click_button "Right"
+  zero.click_button "Wrong"
+  check(alice.has_no_text?(/\d+ points?/), "Points leaked during play")
+  moderator.click_button "Finish"
+  check(alice.has_text?("Correct!"), "Last pick not scored")
+  moderator.click_button "Next"
+  check(alice.has_text?("Second prize question?"), "Next did not push")
+  alice.click_button "Right"
+  moderator.click_button "Finish"
+  moderator.click_button "End quiz"
+  check(moderator.has_css?(".leaderboard li", count: 4), "Leaderboard missing players")
+  rows = moderator.all(".leaderboard li").map { |row| row.text.gsub(/\s+/, " ") }
+  check(rows == ["1 Alice 2 points", "2 Bob 1 point", "3 Charlie 1 point", "4 Zero 0 points"], "Wrong leaderboard: #{rows.inspect}")
+  [[alice, 1, "2 points"], [bob, 2, "1 point"], [charlie, 3, "1 point"], [zero, 4, "0 points"]].each do |browser, place, points|
+    check(browser.has_text?("Place #{place} of 4") && browser.has_text?(points), "Wrong phone result")
+  end
+  moderator.click_button "Top 2"
+  check(moderator.has_css?(".leaderboard li.is-winner", count: 2), "Top prizes not marked")
+  check(alice.has_text?("You won!") && bob.has_text?("You won!"), "Winner phones not live")
+  check(charlie.has_no_text?("You won!") && zero.has_no_text?("You won!"), "Incorrect prize")
+  moderator.click_button "Reset winners"
+  check(alice.has_no_text?("You won!") && bob.has_no_text?("You won!"), "Reset did not push")
+  check(moderator.has_no_text?("Winner", exact: true), "Reset kept marks")
+  3.times do
+    moderator.click_button "Draw"
+    check(moderator.has_css?(".leaderboard li.is-winner", count: 2), "Draw prize count wrong")
+    check(alice.has_text?("You won!") && zero.has_no_text?("You won!"), "Draw eligibility wrong")
+    winner_name = moderator.all(".leaderboard li.is-winner").last.find(".leaderboard__name").text
+    winner, loser = winner_name == "Bob" ? [bob, charlie] : [charlie, bob]
+    check(winner.has_text?("You won!") && loser.has_no_text?("You won!"), "Draw phone results wrong")
+  end
+  moderator.save_screenshot("/app/storage/prizes-leaderboard.png")
+  alice.driver.resize(390, 844)
+  alice.save_screenshot("/app/storage/prizes-phone.png")
+  unless ENV["NO_WEBSOCKETS"]
+    browsers.each { |b| check(b.evaluate_script("window.marker") == "no reload", "Page reloaded") }
+  end
+  alice.visit(join_url)
+  check(alice.has_text?("Place 1 of 4") && alice.has_text?("You won!"), "Results did not persist")
+  puts "Prize Chromium checks passed"
+ensure
+  if quiz_url
+    moderator.visit(quiz_url)
+    moderator.click_link "Settings"
+    moderator.accept_confirm { moderator.click_button "Delete quiz" }
+  end
+  browsers.each { |b| b.driver.quit }
+end
diff --git a/script/timer_smoke.rb b/script/timer_smoke.rb
new file mode 100644
index 0000000..87f1a78
--- /dev/null
+++ b/script/timer_smoke.rb
@@ -0,0 +1,110 @@
+# Production multi-browser checks; NO_WEBSOCKETS=1 also tests HTTP recovery.
+require "capybara/cuprite"
+require "json"
+Capybara.register_driver(:timer) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: "/usr/bin/chromium", browser_options: { "no-sandbox" => nil }, window_size: [1440, 1000])
+end
+Capybara.default_max_wait_time = 5
+base = ENV.fetch("QUIZZY_TEST_URL", "http://localhost:3000")
+moderator, player = browsers = Array.new(2) { Capybara::Session.new(:timer) }
+if ENV["NO_WEBSOCKETS"]
+  browsers.each { |b| b.driver.browser.evaluate_on_new_document('window.WebSocket = class { constructor() { this.readyState = 3; } close() {} };') }
+end
+moderator.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "quizzy"))
+def check(condition, message)
+  raise message unless condition
+end
+def set_timer(browser, quiz_url, minutes, seconds)
+  browser.visit(quiz_url)
+  browser.click_link "Settings"
+  browser.fill_in "Timer minutes", with: minutes.to_s
+  browser.fill_in "Timer seconds", with: seconds.to_s
+  browser.click_button "Save quiz"
+end
+def join_game(moderator, player)
+  player.visit(moderator.find(".lobby__url").text)
+  player.fill_in "Your name", with: "Timer player"
+  player.click_button "Join"
+  check(player.has_text?("Hi, Timer player!"), "Joining failed")
+end
+begin
+  moderator.visit("#{base}/moderate/quizzes/import")
+  options = [{ text: "Right", correct: true }, { text: "Wrong", correct: false }]
+  moderator.fill_in "Quiz JSON", with: JSON.generate(title: "Timer browser #{Time.now.to_i}", questions: [
+    { text: "First timed question?", options: options }, { text: "Second timed question?", options: options }
+  ])
+  moderator.click_button "Import", exact: true
+  quiz_url = moderator.current_url
+  moderator.click_link "Settings"
+  check(moderator.find_field("Timer minutes").value == "0", "Minutes default isn't zero")
+  check(moderator.find_field("Timer seconds").value == "0", "Seconds default isn't zero")
+  set_timer(moderator, quiz_url, 1, 30)
+  moderator.click_link "Export", exact: true
+  exported = JSON.parse(moderator.find("pre.quiz-json").text)
+  check(exported.keys.sort == %w[number_of_winners questions title], "Timer leaked into export")
+  moderator.visit(quiz_url)
+  moderator.click_button "Start a game"
+  join_game(moderator, player)
+  check(moderator.has_no_css?("[role=timer]", wait: 0), "Timer visible in lobby")
+  moderator.click_button "Start"
+  check(moderator.has_css?("[role=timer]", text: "1:30"), "Minute countdown format incorrect")
+  check(player.has_button?("Right"), "Question did not reach phone")
+  check(player.has_no_css?("[role=timer]", visible: :all), "Phone has a countdown")
+  moderator.click_button "Finish"
+  check(moderator.has_button?("Next"), "Early Finish failed")
+  check(moderator.has_no_css?("[role=timer]", wait: 0), "Timer visible in results")
+  moderator.click_button "Next"
+  check(moderator.has_css?("[role=timer]", text: "1:30"), "Next did not start a new countdown")
+  moderator.click_button "Finish"
+  moderator.click_button "End quiz"
+
+  set_timer(moderator, quiz_url, 0, 5)
+  moderator.click_link "Settings"
+  check(moderator.find_field("Timer seconds").value == "5", "Timer setting did not persist")
+  moderator.visit(quiz_url)
+  moderator.click_button "Start a game"
+  join_game(moderator, player)
+  moderator.click_button "Start"
+  check(moderator.has_css?("[role=timer]", text: "0:05"), "Seconds not padded")
+  player.click_button "Right"
+  sleep 2.2
+  moderator.refresh
+  check(moderator.has_css?("[role=timer]", text: /0:0[123]/), "Reload restarted the countdown")
+  unless ENV["NO_WEBSOCKETS"]
+    # No state reads: automatic finishing must push to both screens by itself.
+    browsers.each do |browser|
+      browser.execute_script <<~JS
+        const originalFetch = window.fetch;
+        window.fetch = (...args) => String(args[0]).endsWith('/state') ? Promise.reject(new Error('Polling disabled for timer push test')) : originalFetch(...args);
+      JS
+    end
+  end
+  check(moderator.has_button?("Next", wait: 6), "Question did not automatically finish")
+  check(player.has_text?("Correct!"), "Automatic results did not reach player")
+  check(moderator.has_no_css?("[role=timer]", wait: 0), "Closed countdown stayed visible")
+  moderator.click_button "Next"
+  check(moderator.has_css?("[role=timer]", text: "0:05"), "Second countdown didn't start fresh")
+  check(moderator.has_button?("End quiz", wait: 7), "Second question didn't automatically finish")
+  check(player.has_text?("No answer"), "No-answer result missing")
+  moderator.click_button "End quiz"
+
+  set_timer(moderator, quiz_url, 0, 0)
+  moderator.click_button "Start a game"
+  join_game(moderator, player)
+  moderator.click_button "Start"
+  check(player.has_button?("Right"), "Untimed game did not start")
+  sleep 6
+  check(moderator.has_button?("Finish"), "Untimed question closed unexpectedly")
+  check(moderator.has_no_css?("[role=timer]", wait: 0), "Untimed question shows timer")
+  check(player.has_button?("Right", disabled: false), "Untimed phone stopped accepting answers")
+  moderator.click_button "Finish"
+  check(moderator.has_button?("Next"), "Manual Finish on untimed game failed")
+  puts "Timer Chromium checks passed#{ENV['NO_WEBSOCKETS'] ? ' (HTTP fallback)' : ' (WebSocket push)'}"
+ensure
+  if quiz_url
+    moderator.visit(quiz_url)
+    moderator.click_link "Settings"
+    moderator.accept_confirm { moderator.click_button "Delete quiz" }
+  end
+  browsers.each { |browser| browser.driver.quit }
+end
diff --git a/script/transfer_smoke.rb b/script/transfer_smoke.rb
new file mode 100644
index 0000000..be9caa6
--- /dev/null
+++ b/script/transfer_smoke.rb
@@ -0,0 +1,68 @@
+# Run against bin/serve; uses the same credentials and URL as browser_smoke.rb.
+require "capybara/cuprite"
+require "json"
+Capybara.register_driver(:cuprite) do |app|
+  Capybara::Cuprite::Driver.new(app, browser_path: "/usr/bin/chromium", browser_options: { "no-sandbox" => nil }, window_size: [ 1280, 900 ])
+end
+Capybara.default_max_wait_time = 5
+session = Capybara::Session.new(:cuprite)
+base = ENV.fetch("QUIZZY_TEST_URL", "http://localhost:3000")
+session.driver.basic_authorize(ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "quizzy"))
+def assert(value, message)
+  raise message unless value
+end
+s = session
+created_urls = []
+data = {
+  "title" => "Transfer test #{Time.now.to_i}",
+  "questions" => [
+    { "text" => 'Which HTTP code means "Too Many Requests"?', "active" => false,
+      "options" => [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ] },
+    { "text" => "Next <question> & café", "active" => true,
+      "options" => [ { "text" => "First", "correct" => true }, { "text" => "Second", "correct" => false } ] }
+  ]
+}
+begin
+  s.visit("#{base}/moderate")
+  s.click_link "Import quiz"
+  s.fill_in "Quiz JSON", with: "{bad JSON"
+  s.click_button "Import"
+  assert(s.has_css?('[role="alert"]', text: "not valid JSON"), "Missing parse error")
+  assert(s.has_field?("Quiz JSON", with: "{bad JSON"), "Input lost")
+  invalid = Marshal.load(Marshal.dump(data))
+  invalid["questions"].last["options"].each { |o| o["correct"] = false }
+  s.fill_in "Quiz JSON", with: JSON.generate(invalid)
+  s.click_button "Import"
+  assert(s.has_css?('[role="alert"]', text: "Question 2: Mark at least one option as correct"), "Missing validation error")
+  s.click_link "Cancel"
+  assert(s.has_no_css?(".quiz-tile", text: data["title"]), "Partial quiz imported")
+
+  2.times do
+    s.click_link "Import quiz"
+    s.fill_in "Quiz JSON", with: JSON.pretty_generate(data)
+    s.click_button "Import"
+    assert(s.has_css?("h1", text: data["title"]), "Did not open imported quiz")
+    created_urls << s.current_url
+    assert(s.has_css?(".question-item", count: 2), "Missing questions")
+    s.within(s.all(".question-item").first) do
+      assert(s.has_unchecked_field?("Active"), "Inactive flag lost")
+    end
+    s.click_link "Export"
+    assert(s.all("pre").size == 1, "Expected one pre")
+    data = JSON.parse(s.find("pre").text)
+    assert(data["questions"].last["text"] == "Next <question> & café", "Text changed")
+    s.driver.resize(390, 844)
+    assert(s.evaluate_script("document.documentElement.scrollWidth <= window.innerWidth"), "Mobile export overflow")
+    s.visit("#{base}/moderate")
+  end
+  assert(created_urls.uniq.size == 2, "Import reused a quiz")
+  assert(s.all(".quiz-tile", text: data["title"]).size == 2, "Duplicate title quiz missing")
+  puts "Transfer browser smoke: all checks passed"
+ensure
+  created_urls.each do |url|
+    s.visit(url)
+    s.click_link "Settings"
+    s.accept_confirm { s.click_button "Delete quiz" }
+  end
+  s.driver.quit
+end
