diff --git a/app/views/moderate/quizzes/show.html.erb b/app/views/moderate/quizzes/show.html.erb
new file mode 100644
index 0000000..0d18e6f
--- /dev/null
+++ b/app/views/moderate/quizzes/show.html.erb
@@ -0,0 +1,40 @@
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head">
+  <div><h1><%= @quiz.title %></h1><div class="meta mt-2"><%= @questions.count(&:active?) %> of <%= @questions.size %> questions active · <%= link_to "Settings", edit_moderate_quiz_path(@quiz) %></div></div>
+  <div class="buttons"><%= button_to "Start a game", moderate_quiz_games_path(@quiz), class: "btn" %><%= link_to "Export", export_moderate_quiz_path(@quiz), class: "btn btn--ghost" %><%= link_to "Preview", preview_moderate_quiz_path(@quiz), class: "btn btn--ghost" %></div>
+</div>
+<section class="section mt-0">
+  <div class="section-head"><h2>Questions</h2><%= link_to "Add question", new_moderate_quiz_question_path(@quiz), class: "btn" %></div>
+  <% if @questions.empty? %><div class="empty">No questions yet. Add your first question.</div><% end %>
+  <ol class="plain-list">
+    <% active_number = 0 %>
+    <% @questions.each_with_index do |question, index| %>
+      <li class="card question-item <%= 'question-item--inactive' unless question.active? %>" id="question-<%= question.id %>">
+        <div class="question-item__num"><%= question.active? ? (active_number += 1) : "—" %></div>
+        <div>
+          <div class="question-item__body"><%= question.text %></div>
+          <ul class="question-item__options"><% question.options.each_with_index do |option, i| %>
+            <li class="<%= 'is-correct' if option['correct'] %>"><%= i < 26 ? (65 + i).chr : (i + 1).to_s %>. <%= option['text'] %><% if option['correct'] %><span class="sr-only"> (correct)</span><% end %></li>
+          <% end %></ul>
+        </div>
+        <div class="question-item__actions">
+          <div class="buttons">
+            <%= button_to "↑", move_moderate_quiz_question_path(@quiz, question), method: :patch, params: { direction: "up" }, class: "btn btn--ghost btn--icon", disabled: index.zero?, aria: { label: "Move up" }, title: "Move up" %>
+            <%= button_to "↓", move_moderate_quiz_question_path(@quiz, question), method: :patch, params: { direction: "down" }, class: "btn btn--ghost btn--icon", disabled: index == @questions.size - 1, aria: { label: "Move down" }, title: "Move down" %>
+          </div>
+          <%= form_with model: question, url: toggle_moderate_quiz_question_path(@quiz, question), method: :patch do |form| %>
+            <label class="checkbox"><%= form.check_box :active, id: "active-#{question.id}", data: { autosubmit: true } %> Active</label>
+          <% end %>
+          <div class="buttons"><%= link_to "Edit", edit_moderate_quiz_question_path(@quiz, question), class: "btn btn--sm" %><%= button_to "Delete", moderate_quiz_question_path(@quiz, question), method: :delete, class: "btn btn--sm btn--danger", form: { data: { confirm: "Delete this question?" } } %></div>
+        </div>
+      </li>
+    <% end %>
+  </ol>
+</section>
+<% if @quiz.games.exists? %>
+  <section class="section"><h2>Games</h2><ul class="plain-list">
+    <% @quiz.games.order(created_at: :desc).each do |game| %>
+      <li class="card game-list-item"><span><%= game.created_at.strftime("%d %b %Y, %H:%M") %> · <%= game.status.humanize %> · <%= game.code %></span><%= link_to "Open big screen", moderate_game_path(game), class: "btn btn--ghost" %></li>
+    <% end %>
+  </ul></section>
+<% end %>
