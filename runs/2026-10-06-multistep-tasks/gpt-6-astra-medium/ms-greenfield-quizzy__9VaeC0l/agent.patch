diff --git a/app/assets/javascripts/application.js b/app/assets/javascripts/application.js
new file mode 100644
index 0000000..c4b5db9
--- /dev/null
+++ b/app/assets/javascripts/application.js
@@ -0,0 +1,89 @@
+document.addEventListener("submit", (event) => {
+  const message = event.target.dataset.confirm;
+  if (message && !window.confirm(message)) event.preventDefault();
+});
+document.addEventListener("change", (event) => {
+  if (event.target.matches("[data-autosubmit]")) event.target.form.requestSubmit();
+});
+document.addEventListener("click", (event) => {
+  const clear = event.target.closest("[data-clear-option]");
+  if (clear) {
+    const row = clear.closest(".option-row");
+    row.querySelector('input[type="text"]').value = "";
+    row.querySelector('input[type="checkbox"]').checked = false;
+    row.querySelector('input[type="text"]').focus();
+  }
+});
+const addOption = document.getElementById("add-option");
+if (addOption) addOption.addEventListener("click", () => {
+  const rows = document.getElementById("option-rows");
+  const i = rows.children.length;
+  const row = document.createElement("div");
+  row.className = "option-row";
+  row.innerHTML = `<input class="input" type="text" name="question[option_rows][${i}][text]" id="option-${i}" aria-label="Option ${i + 1}" placeholder="Option ${i + 1}"><label class="checkbox"><input type="checkbox" name="question[option_rows][${i}][correct]" value="1" id="correct-${i}" aria-label="Option ${i + 1} is correct"> Correct</label><button type="button" class="btn btn--danger btn--icon" data-clear-option aria-label="Clear option ${i + 1}" title="Clear option">✕</button>`;
+  rows.appendChild(row);
+  row.querySelector("input").focus();
+});
+const preview = document.getElementById("preview");
+if (preview) {
+  const questions = JSON.parse(preview.dataset.questions);
+  const content = document.getElementById("preview-content");
+  let index = 0, score = 0, answered = false;
+  function element(tag, className, text) {
+    const node = document.createElement(tag);
+    node.className = className;
+    if (text !== undefined) node.textContent = text;
+    return node;
+  }
+  function showQuestion() {
+    content.replaceChildren();
+    answered = false;
+    if (!questions.length) {
+      content.append(element("div", "empty", "No active questions. Add or activate a question to try the preview."));
+      return;
+    }
+    const question = questions[index];
+    content.append(element("div", "play-question__num", `Question ${index + 1} of ${questions.length}`));
+    content.append(element("h2", "play-question__body", question.text));
+    const options = element("div", "play-options");
+    question.options.forEach((option, i) => {
+      const button = element("button", "play-option");
+      button.type = "button";
+      button.setAttribute("aria-label", option.text);
+      button.append(element("span", "play-option__letter", i < 26 ? String.fromCharCode(65 + i) : String(i + 1)));
+      button.append(element("span", "play-option__title", option.text));
+      button.addEventListener("click", () => answer(i));
+      options.append(button);
+    });
+    content.append(options);
+  }
+  function answer(picked) {
+    if (answered) return;
+    answered = true;
+    const question = questions[index];
+    const correct = question.options[picked].correct;
+    if (correct) score++;
+    content.querySelectorAll(".play-option").forEach((button, i) => {
+      button.disabled = true;
+      if (question.options[i].correct) {
+        button.classList.add("is-correct");
+        button.append(element("span", "answer-mark", "✓ Correct"));
+      } else if (i === picked) button.classList.add("is-wrong");
+    });
+    content.append(element("div", "play-status", correct ? "Correct!" : "Wrong!"));
+    const next = element("button", "btn btn--pink", index === questions.length - 1 ? "See score" : "Next question");
+    next.type = "button";
+    next.addEventListener("click", () => {
+      index++;
+      if (index < questions.length) showQuestion();
+      else {
+        content.replaceChildren(element("h2", "card", `Score: ${score}/${questions.length}`));
+      }
+    });
+    content.append(next);
+  }
+  document.getElementById("start-over").addEventListener("click", () => {
+    index = 0; score = 0; showQuestion();
+  });
+  showQuestion();
+}
diff --git a/app/assets/javascripts/live.js b/app/assets/javascripts/live.js
new file mode 100644
index 0000000..1f9d78b
--- /dev/null
+++ b/app/assets/javascripts/live.js
@@ -0,0 +1,268 @@
+(() => {
+  const root = document.getElementById("live-game");
+  if (!root) return;
+  const moderator = root.dataset.role === "moderator";
+  const content = document.getElementById("live-content");
+  const status = document.getElementById("connection-status");
+  const countdown = moderator ? document.getElementById("question-countdown") : null;
+  let countdownEndsAt = null, countdownTimer, lastExpiryRead = 0;
+  const csrf = document.querySelector('meta[name="csrf-token"]').content;
+  let state, rendered, busy = false, fetching = false, pendingPick = null, mutation = 0;
+  let socket, retryTimer, notificationTimer, pollTimer, pulseTimer, stopped = false, reconnectDelay = 1000, lastMessage = Date.now();
+  const node = (tag, text, cls) => {
+    const el = document.createElement(tag);
+    if (text != null) el.textContent = text;
+    if (cls) el.className = cls;
+    return el;
+  };
+  function tickCountdown() {
+    if (!countdown || countdownEndsAt === null || stopped) return;
+    const seconds = Math.max(0, Math.ceil((countdownEndsAt - performance.now()) / 1000));
+    countdown.textContent = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
+    countdown.classList.toggle("is-urgent", seconds <= 5);
+    // Ask for authoritative results, never issue a potentially stale Finish POST.
+    if (seconds === 0 && performance.now() - lastExpiryRead > 500) {
+      lastExpiryRead = performance.now();
+      refresh();
+    }
+  }
+  function syncCountdown() {
+    if (!countdown) return;
+    const timer = state.status === "open" ? state.timer : null;
+    countdown.hidden = !timer;
+    // Server-relative time avoids dependence on a moderator's wall-clock setting;
+    // monotonic elapsed time keeps the countdown moving between state updates.
+    countdownEndsAt = timer ? performance.now() + Date.parse(timer.deadline) - Date.parse(timer.server_now) : null;
+    tickCountdown();
+  }
+  function render(next) {
+    if (state && next.revision < state.revision) return;
+    state = next;
+    syncCountdown();
+    // Counter-only updates must not replace buttons under the moderator's pointer.
+    if (moderator) {
+      document.getElementById("waiting-count").textContent = `Players: ${state.players}`;
+      document.getElementById("answer-count").textContent = state.question ? `Answers: ${state.answers} / ${state.players}` : "";
+    }
+    const signature = JSON.stringify(moderator ? { ...next, players: null, answers: null, timer: next.timer?.deadline } : next);
+    if (signature === rendered) return;
+    rendered = signature;
+    const oldFocus = document.activeElement?.dataset.option;
+    content.replaceChildren();
+    const ended = state.status === "ended";
+    const waiting = state.status === "waiting";
+    const question = state.question;
+    if (moderator) {
+      document.getElementById("lobby").hidden = !waiting;
+      document.getElementById("waiting-count").textContent = `Players: ${state.players}`;
+      document.getElementById("answer-count").textContent = question ? `Answers: ${state.answers} / ${state.players}` : "";
+      const actions = document.getElementById("game-actions");
+      actions.replaceChildren();
+      if (ended) {
+        [["top", `Top ${state.number_of_winners}`], ["draw", "Draw"], ["reset", "Reset winners"]].forEach(([command, label]) => {
+          const button = node("button", label, command === "reset" ? "btn btn--ghost" : "btn btn--lg");
+          button.type = "button";
+          button.dataset.command = command;
+          actions.append(button);
+        });
+      } else {
+        const command = waiting ? "start" : state.status === "open" ? "finish" : question.number === question.total ? "end" : "next";
+        const button = node("button", { start: "Start", finish: "Finish", next: "Next", end: "End quiz" }[command], "btn btn--lg");
+        button.type = "button";
+        button.dataset.command = command;
+        actions.append(button);
+      }
+    } else {
+      document.getElementById("join-panel").hidden = !!state.name || ended;
+    }
+    if (ended) {
+      content.append(node("h1", "The quiz is over"));
+      const points = (value) => `${value} ${value === 1 ? "point" : "points"}`;
+      if (moderator) {
+        content.append(node("h2", "Leaderboard"));
+        const list = node("ol", null, "leaderboard");
+        (state.leaderboard || []).forEach((player) => {
+          const row = node("li", null, `leaderboard__row ${player.winner ? "is-winner" : ""}`);
+          row.append(node("span", player.place, "leaderboard__place"), node("span", player.name, "leaderboard__name"), node("span", points(player.points), "leaderboard__points"));
+          if (player.winner) row.append(node("strong", "Winner", "winner-mark"));
+          list.append(row);
+        });
+        content.append(list);
+        if (!state.leaderboard?.length) content.append(node("p", "No players joined this game."));
+        content.append(node("p", "Top ranks by points, then speed. Draw shares tied prizes at random. Players need at least one point to win.", "meta"));
+      } else if (state.standing) {
+        content.append(node("h2", `Place ${state.standing.place} of ${state.standing.total}`, "final-place"), node("p", points(state.standing.points), "final-points"));
+        if (state.standing.winner) content.append(node("p", "You won!", "winner-mark winner-mark--phone"));
+        content.append(node("p", "Thanks for playing!"));
+      } else {
+        content.append(node("p", "Thanks for playing!"));
+      }
+      return;
+    }
+    if (!moderator && !state.name) return;
+    if (waiting) {
+      if (!moderator) content.append(node("h1", `Hi, ${state.name}!`), node("p", "Waiting for the quiz to start…"));
+      return;
+    }
+    if (!question) return;
+    content.append(node("p", `Question ${question.number} of ${question.total}`, moderator ? "stage-question__num" : "play-question__num"));
+    content.append(node("h1", question.text, moderator ? "stage-question__body" : "play-question__body"));
+    const closed = state.status === "closed";
+    const options = node("ul", null, moderator ? `stage-options ${closed ? "stage-options--results" : ""}` : "play-options");
+    question.options.forEach((option, index) => {
+      const li = node("li");
+      const item = moderator ? li : node("button");
+      item.className = moderator ? "stage-option" : "play-option";
+      if (!moderator) {
+        item.type = "button";
+        item.dataset.option = index;
+        item.disabled = closed;
+        item.setAttribute("aria-pressed", state.selection === index ? "true" : "false");
+        if (state.selection === index) item.classList.add("is-picked");
+        li.append(item);
+      }
+      if (closed && option.correct) item.classList.add("is-correct");
+      item.append(node("span", index < 26 ? String.fromCharCode(65 + index) : index + 1, moderator ? "stage-option__letter" : "play-option__letter"));
+      item.append(node("span", option.text, moderator ? "stage-option__title" : "play-option__text"));
+      if (moderator && closed) item.append(node("strong", `${option.count}`, "stage-option__count"));
+      if (closed && option.correct) item.append(node("span", "Correct", "answer-mark"));
+      if (!moderator && state.selection === index) item.append(node("span", "Your answer", "answer-mark"));
+      options.append(li);
+    });
+    content.append(options);
+    if (!moderator) {
+      if (closed) content.append(node("p", state.result, `play-status ${state.result === "Correct!" ? "play-status--correct" : state.result === "Wrong!" ? "play-status--wrong" : "play-status--neutral"}`));
+      content.append(node("p", closed ? "Waiting for the moderator…" : "Tap an option. You can change your answer until the question closes.", "meta"));
+      if (oldFocus !== undefined) content.querySelector(`[data-option="${oldFocus}"]`)?.focus({ preventScroll: true });
+    }
+  }
+  async function request(url, payload) {
+    const response = await fetch(url, {
+      method: payload === undefined ? "GET" : "POST", credentials: "same-origin", cache: "no-store",
+      headers: { Accept: "application/json", "Content-Type": "application/json", "X-CSRF-Token": csrf },
+      body: payload === undefined ? undefined : JSON.stringify(payload), signal: AbortSignal.timeout(10000)
+    });
+    if (!response.ok) {
+      let error;
+      try { error = (await response.json()).error; } catch (_) {}
+      throw new Error(error || "Connection interrupted. Retrying…");
+    }
+    return response.status === 204 ? null : response.json();
+  }
+  async function refresh() {
+    if (fetching || busy || stopped) return;
+    fetching = true;
+    const before = mutation;
+    try {
+      const next = await request(root.dataset.stateUrl);
+      if (!busy && before === mutation) render(next);
+      if (!busy) status.textContent = "";
+    } catch (_) { status.textContent = "Connection interrupted. Retrying…"; }
+    finally { fetching = false; }
+  }
+  function scheduleRefresh() {
+    clearTimeout(notificationTimer);
+    notificationTimer = setTimeout(refresh, 0);
+  }
+  async function submit(payload) {
+    busy = true;
+    mutation++;
+    status.textContent = "Saving…";
+    try {
+      const next = await request(root.dataset.actionUrl, payload);
+      render(next);
+      status.textContent = "";
+    } catch (error) { status.textContent = error.message; }
+    finally { busy = false; }
+    if (pendingPick) {
+      const pick = pendingPick;
+      pendingPick = null;
+      if (state.status === "open" && state.question.id === pick.question_id) return submit(pick);
+    }
+    scheduleRefresh();
+  }
+  root.addEventListener("click", (event) => {
+    const command = event.target.closest("[data-command]");
+    if (command && !busy) {
+      command.disabled = true;
+      submit({ command: command.dataset.command, revision: state.revision }).finally(() => { command.disabled = false; });
+    }
+    const option = event.target.closest("[data-option]");
+    if (option && state.status === "open") {
+      const pick = { question_id: state.question.id, option_index: Number(option.dataset.option) };
+      if (busy) pendingPick = pick;
+      else submit(pick);
+    }
+  });
+  async function pulse() {
+    if (!root.dataset.pulseUrl || state.status === "ended" || stopped) return;
+    try { await request(root.dataset.pulseUrl, {}); }
+    catch (_) { status.textContent = "Connection interrupted. Retrying…"; }
+  }
+  function connect() {
+    if (stopped || socket && socket.readyState < 2) return;
+    const url = new URL("/cable", location.href);
+    url.protocol = location.protocol === "https:" ? "wss:" : "ws:";
+    try {
+      socket = new WebSocket(url, ["actioncable-v1-json"]);
+    } catch (_) {
+      // Some networks/browsers disallow sockets entirely; polling remains available.
+      return;
+    }
+    const identifier = JSON.stringify({ channel: "LiveGameChannel", token: root.dataset.liveToken });
+    socket.onmessage = (event) => {
+      lastMessage = Date.now();
+      const message = JSON.parse(event.data);
+      if (message.type === "welcome") socket.send(JSON.stringify({ command: "subscribe", identifier }));
+      if (message.type === "confirm_subscription") reconnectDelay = 1000;
+      if (message.message?.state) {
+        // Invalidate any older HTTP read. Transitions must render even while an
+        // answer POST is in flight; revision checks discard stale responses.
+        mutation++;
+        render(message.message.state);
+        if (!busy) status.textContent = "";
+      } else if (message.type === "confirm_subscription" || message.message) {
+        scheduleRefresh();
+      }
+    };
+    socket.onclose = () => {
+      if (!stopped) {
+        retryTimer = setTimeout(connect, reconnectDelay + Math.random() * 1500);
+        reconnectDelay = Math.min(reconnectDelay * 2, 30000);
+      }
+    };
+    socket.onerror = () => socket.close();
+  }
+  render(JSON.parse(document.getElementById("initial-state").textContent));
+  pulse();
+  connect();
+  // Heartbeats and periodic authoritative reads recover lost notifications and expired presence.
+  function startTimers() {
+    clearInterval(pollTimer); clearInterval(pulseTimer); clearInterval(countdownTimer);
+    if (moderator) countdownTimer = setInterval(tickCountdown, 100);
+    let lastRead = 0;
+    pollTimer = setInterval(() => {
+      if (!socket || socket.readyState !== WebSocket.OPEN || Date.now() - lastRead > 4000) {
+        refresh();
+        lastRead = Date.now();
+      }
+      if (Date.now() - lastMessage > 15000) socket?.close();
+    }, 500);
+    pulseTimer = setInterval(pulse, 12000);
+  }
+  startTimers();
+  window.addEventListener("online", () => { connect(); pulse(); refresh(); });
+  document.addEventListener("visibilitychange", () => { if (!document.hidden) { connect(); pulse(); refresh(); } });
+  window.addEventListener("pagehide", () => {
+    stopped = true;
+    clearInterval(pollTimer); clearInterval(pulseTimer); clearInterval(countdownTimer);
+    clearTimeout(retryTimer); clearTimeout(notificationTimer);
+    socket?.close();
+  });
+  window.addEventListener("pageshow", (event) => {
+    if (event.persisted) {
+      stopped = false;
+      startTimers(); connect(); pulse(); refresh();
+    }
+  });
+})();
