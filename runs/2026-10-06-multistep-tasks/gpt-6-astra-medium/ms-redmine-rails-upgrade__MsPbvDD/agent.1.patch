diff --git a/test/upgrade/artifacts.rb b/test/upgrade/artifacts.rb
new file mode 100644
index 0000000..43cb7a2
--- /dev/null
+++ b/test/upgrade/artifacts.rb
@@ -0,0 +1,125 @@
+# frozen_string_literal: true
+
+# Run through test/upgrade/compatibility.sh. No database is needed.
+ENV['RAILS_ENV'] = 'test'
+require_relative '../../config/application'
+# Simulate the NEXT release, with the bridge's writer overrides removed.
+future_defaults = ARGV.delete('--defaults-7')
+Rails.application.config.load_defaults('7.0') if future_defaults
+Rails.application.config.action_dispatch.cookies_serializer = :hybrid if ARGV.delete('--legacy-reader')
+original = ARGV.delete('--original-61')
+Rails.application.config.action_dispatch.cookies_serializer = :marshal if original
+require_relative '../../config/environment'
+if original
+  check_version = Rails::VERSION::MAJOR == 6
+  raise 'Original defaults probe requires Rails 6.1' unless check_version
+
+  Rails.application.config.action_dispatch.cookies_rotations.signed.clear
+  Rails.application.config.action_dispatch.cookies_rotations.encrypted.clear
+  Rails.application.instance_variable_get(:@message_verifiers).clear
+end
+Rails.application.env_config['action_dispatch.show_exceptions'] = false
+require 'rack/test'
+require 'json'
+require 'active_support/testing/time_helpers'
+clock = Class.new {include ActiveSupport::Testing::TimeHelpers}.new
+# Fixed clock keeps the checked-in pre-upgrade artifacts reproducible.
+clock.travel_to Time.utc(2026, 1, 1, 12)
+
+def check(value, message)
+  raise message unless value
+end
+
+# Deliberately isolate cookie middleware from database-backed authentication.
+# rubocop:disable Rails/ApplicationController
+class UpgradeArtifactsController < ActionController::Base
+  def write
+    session[:user_id] = 42
+    session[:tk] = 'unchanged-session-token'
+    cookies.signed[:upgrade_signed] = {value: {'user_id' => 42}}
+    cookies.encrypted[:upgrade_encrypted] = {value: {'user_id' => 42}}
+    render plain: 'written'
+  end
+
+  def read
+    render json: {user_id: session[:user_id], tk: session[:tk],
+                  signed: cookies.signed[:upgrade_signed],
+                  encrypted: cookies.encrypted[:upgrade_encrypted]}
+  end
+end
+# rubocop:enable Rails/ApplicationController
+Rails.application.routes.draw do
+  get '/upgrade/write', to: 'upgrade_artifacts#write'
+  get '/upgrade/read', to: 'upgrade_artifacts#read'
+end
+
+mode, file, rewritten_file = ARGV
+client = Rack::Test::Session.new(Rack::MockSession.new(Rails.application))
+data = {'user_id' => 42, 'issue_id' => 7}
+if mode == 'write'
+  if future_defaults
+    expected_key = OpenSSL::PKCS5.pbkdf2_hmac(
+      Rails.application.secret_key_base, 'mail_links', 1000, 64, OpenSSL::Digest.new('SHA256')
+    )
+    check(Rails.application.key_generator.generate_key('mail_links') == expected_key, 'not using SHA256 defaults')
+    config = Rails.application.config.action_dispatch
+    check(config.use_authenticated_cookie_encryption, 'not using GCM defaults')
+    check(config.use_cookies_with_metadata, 'not using cookie metadata defaults')
+    check(config.cookies_serializer == :json, 'not using JSON writer defaults')
+  end
+  client.get('/upgrade/write')
+  check(client.last_response.status == 200, client.last_response.body)
+  clock.travel_back
+  clock.travel_to Time.utc(2026, 1, 1, 12) - 31.days
+  expired = Mailer.mail_link_token(:unwatch, data)
+  clock.travel_back
+  clock.travel_to Time.utc(2026, 1, 1, 12)
+  artifacts = {
+    'metadata' => Rails.application.config.action_dispatch.use_cookies_with_metadata,
+    'cookies' => client.cookie_jar.to_hash,
+    'token' => Mailer.mail_link_token(:unwatch, data),
+    'expired' => expired
+  }
+  File.write(file, JSON.pretty_generate(artifacts))
+else
+  artifacts = JSON.parse(File.read(file))
+  artifacts.fetch('cookies').each {|name, value| client.set_cookie("#{name}=#{Rack::Utils.escape(value)}")}
+  client.get('/upgrade/read')
+  check(client.last_response.status == 200, client.last_response.body)
+  expected = {'user_id' => 42, 'tk' => 'unchanged-session-token',
+              'signed' => {'user_id' => 42}, 'encrypted' => {'user_id' => 42}}
+  check(JSON.parse(client.last_response.body) == expected, "cookies lost: #{client.last_response.body}")
+  check(Mailer.verify_mail_link(artifacts.fetch('token'), :unwatch) == data, 'mail link lost')
+  [[artifacts['token'], :other], [artifacts['expired'], :unwatch],
+   [artifacts['token'] + 'tampered', :unwatch]].each do |token, purpose|
+    Mailer.verify_mail_link(token, purpose)
+    raise 'invalid mail link accepted'
+  rescue ActiveSupport::MessageVerifier::InvalidSignature
+    # Expected: rotations must retain authentication, purpose and expiry.
+  end
+  # Moving a future purpose-bound cookie to the session name must not work.
+  if artifacts['metadata']
+    other_client = Rack::Test::Session.new(Rack::MockSession.new(Rails.application))
+    value = artifacts.fetch('cookies').fetch('upgrade_encrypted')
+    other_client.set_cookie("_redmine_session=#{Rack::Utils.escape(value)}")
+    other_client.get('/upgrade/read')
+    check(JSON.parse(other_client.last_response.body)['user_id'].nil?, 'cookie purpose ignored')
+  end
+  wrong_key = ActiveSupport::MessageVerifier.new('not the application secret')
+  begin
+    Mailer.verify_mail_link(wrong_key.generate(data, purpose: :unwatch), :unwatch)
+    raise 'wrong-secret token accepted'
+  rescue ActiveSupport::MessageVerifier::InvalidSignature
+    # Authentication still applies to all rotated keys.
+  end
+  if rewritten_file
+    artifacts['cookies'] = client.cookie_jar.to_hash
+    artifacts['metadata'] = Rails.application.config.action_dispatch.use_cookies_with_metadata
+    File.write(rewritten_file, JSON.pretty_generate(artifacts))
+  end
+  # Cookie rotations must not allow unauthenticated values.
+  artifacts.fetch('cookies').each {|name, value| client.set_cookie("#{name}=#{Rack::Utils.escape(value + 'tampered')}")}
+  client.get('/upgrade/read')
+  check(JSON.parse(client.last_response.body).values.all?(&:nil?), 'tampered cookies accepted')
+end
+puts "#{Rails.version}/Ruby #{RUBY_VERSION}: #{mode} #{file} OK"
diff --git a/test/upgrade/compatibility.sh b/test/upgrade/compatibility.sh
new file mode 100644
index 0000000..0507cd6
--- /dev/null
+++ b/test/upgrade/compatibility.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+artifacts=$(mktemp -d)
+trap 'rm -rf "$artifacts"' EXIT
+probe=test/upgrade/artifacts.rb
+legacy=test/upgrade/fixtures/rails61_ruby30.json
+run() { BUNDLE_GEMFILE="$1" bundle exec ruby "$probe" "${@:2}"; }
+
+# Actual pre-upgrade Rails 6.1/Ruby 3.0 artifact, with a fixed test-only key/clock.
+run Gemfile read "$legacy"
+run Gemfile.next read "$legacy"
+run Gemfile.next --defaults-7 --legacy-reader read "$legacy"
+
+# This release writes a format the previous release still accepts.
+run Gemfile write "$artifacts/bridge.json"
+run Gemfile --original-61 read "$artifacts/bridge.json"
+run Gemfile.next read "$artifacts/bridge.json"
+run Gemfile.next write "$artifacts/next-lane.json"
+run Gemfile --original-61 read "$artifacts/next-lane.json"
+
+# Next release uses default SHA256 PBKDF2, GCM, metadata and JSON writers.
+run Gemfile.next --defaults-7 read "$artifacts/bridge.json"
+run Gemfile.next --defaults-7 write "$artifacts/future.json"
+run Gemfile read "$artifacts/future.json" "$artifacts/rolled-back.json"
+run Gemfile.next read "$artifacts/future.json"
+# Cookies reissued by the rollback target must survive roll-forward too.
+run Gemfile.next --defaults-7 read "$artifacts/rolled-back.json"
