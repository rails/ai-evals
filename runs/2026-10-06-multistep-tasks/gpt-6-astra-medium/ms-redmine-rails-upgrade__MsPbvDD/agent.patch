diff --git a/test/upgrade/artifacts.rb b/test/upgrade/artifacts.rb
new file mode 100644
index 0000000..9a951f7
--- /dev/null
+++ b/test/upgrade/artifacts.rb
@@ -0,0 +1,155 @@
+# frozen_string_literal: true
+
+# Run through test/upgrade/compatibility.sh. No database is needed.
+ENV['RAILS_ENV'] = 'test'
+previous = ARGV.delete('--previous')
+if previous
+  require_relative 'previous/application'
+else
+  require_relative '../../config/environment'
+end
+Rails.application.env_config['action_dispatch.show_exceptions'] = :none
+require 'rack/test'
+require 'json'
+require 'active_support/testing/time_helpers'
+clock = Class.new {include ActiveSupport::Testing::TimeHelpers}.new
+# Fixed clock keeps the checked-in pre-upgrade artifacts reproducible.
+clock.travel_to Time.utc(2026, 1, 1, 12)
+
+def check(value, message)
+  raise message unless value
+end
+
+# Deliberately isolate cookie middleware from database-backed authentication.
+# rubocop:disable Rails/ApplicationController
+class UpgradeArtifactsController < ActionController::Base
+  def write
+    session[:user_id] = 42
+    session[:tk] = 'unchanged-session-token'
+    cookies.signed[:upgrade_signed] = {value: {'user_id' => 42}}
+    cookies.encrypted[:upgrade_encrypted] = {value: {'user_id' => 42}}
+    render plain: 'written'
+  end
+
+  def read
+    render json: {user_id: session[:user_id], tk: session[:tk],
+                  signed: cookies.signed[:upgrade_signed],
+                  encrypted: cookies.encrypted[:upgrade_encrypted]}
+  end
+end
+# rubocop:enable Rails/ApplicationController
+Rails.application.routes.draw do
+  get '/upgrade/write', to: 'upgrade_artifacts#write'
+  get '/upgrade/read', to: 'upgrade_artifacts#read'
+end
+
+mode, file, rewritten_file = ARGV
+client = Rack::Test::Session.new(Rack::MockSession.new(Rails.application))
+data = {'user_id' => 42, 'issue_id' => 7}
+if mode == 'write'
+  expected_key = OpenSSL::PKCS5.pbkdf2_hmac(
+    Rails.application.secret_key_base, 'mail_links', 1000, 64, OpenSSL::Digest.new('SHA256')
+  )
+  check(Rails.application.key_generator.generate_key('mail_links') == expected_key, 'not using SHA256 defaults')
+  config = Rails.application.config.action_dispatch
+  check(config.use_authenticated_cookie_encryption, 'not using GCM defaults')
+  check(config.use_cookies_with_metadata, 'not using cookie metadata defaults')
+  check(config.cookies_serializer == :hybrid, 'not using JSON writer defaults')
+  check(ActiveSupport::Digest.hash_digest_class == OpenSSL::Digest::SHA256, 'cache digest override remains')
+  check(ActiveSupport::Cache.format_version.to_s == '7.1', 'cache format override remains')
+  check(Rails.application.config.loaded_config_version == (previous ? '7.2' : '8.1'), 'wrong framework defaults')
+  check(ActiveSupport::Messages::Metadata.use_message_serializer_for_metadata == !previous, 'wrong metadata writer')
+  check(Rails.application.config.active_support.message_serializer == :json_allow_marshal, 'not using JSON mail writer')
+  unless previous
+    config = Rails.application.config
+    check(config.action_dispatch.strict_freshness, 'freshness default overridden')
+    check(config.action_controller.action_on_path_relative_redirect == :raise, 'redirect default overridden')
+    check(config.action_controller.escape_json_responses == false, 'JSON response default overridden')
+    check(config.active_support.escape_js_separators_in_json == false, 'JSON separator default overridden')
+    check(config.active_record.raise_on_missing_required_finder_order_columns, 'finder ordering default overridden')
+    check(config.action_view.render_tracker == :ruby, 'render tracker default overridden')
+    check(config.action_view.remove_hidden_field_autocomplete, 'hidden field default overridden')
+  end
+  client.get('/upgrade/write')
+  check(client.last_response.status == 200, client.last_response.body)
+  clock.travel_back
+  clock.travel_to Time.utc(2026, 1, 1, 12) - 31.days
+  expired = Mailer.mail_link_token(:unwatch, data)
+  clock.travel_back
+  clock.travel_to Time.utc(2026, 1, 1, 12)
+  artifacts = {
+    'metadata' => Rails.application.config.action_dispatch.use_cookies_with_metadata,
+    'cookies' => client.cookie_jar.to_hash,
+    'token' => Mailer.mail_link_token(:unwatch, data),
+    'expired' => expired
+  }
+  # Check actual wire formats, not merely the requested configuration.
+  encoded, signature = artifacts.fetch('token').split('--')
+  key = Rails.application.key_generator.generate_key('mail_links')
+  check(OpenSSL::HMAC.hexdigest('SHA1', key, encoded) == signature, 'mail HMAC changed')
+  envelope = JSON.parse(Base64.strict_decode64(encoded)).fetch('_rails')
+  check(envelope.fetch('pur') == 'unwatch', 'mail purpose changed')
+  check(envelope.fetch('exp') == '2026-01-31T12:00:00.000Z', 'mail expiry changed')
+  if previous
+    payload = Base64.strict_decode64(envelope.fetch('message'))
+    check(JSON.parse(payload) == data, 'mail payload is not JSON')
+  else
+    check(envelope.fetch('data') == data, 'native metadata not written')
+    check(!envelope.key?('message'), 'legacy metadata still written')
+  end
+  File.write(file, JSON.pretty_generate(artifacts))
+else
+  artifacts = JSON.parse(File.read(file))
+  artifacts.fetch('cookies').each {|name, value| client.set_cookie("#{name}=#{Rack::Utils.escape(value)}")}
+  client.get('/upgrade/read')
+  check(client.last_response.status == 200, client.last_response.body)
+  expected = {'user_id' => 42, 'tk' => 'unchanged-session-token',
+              'signed' => {'user_id' => 42}, 'encrypted' => {'user_id' => 42}}
+  check(JSON.parse(client.last_response.body) == expected, "cookies lost: #{client.last_response.body}")
+  check(Mailer.verify_mail_link(artifacts.fetch('token'), :unwatch) == data, 'mail link lost')
+  unpurposed = Rails.application.message_verifier(:mail_links).generate(data)
+  [[unpurposed, :unwatch], [artifacts['token'], :other], [artifacts['expired'], :unwatch],
+   [artifacts['token'] + 'tampered', :unwatch], ['', :unwatch], ['malformed--token', :unwatch]].each do |token, purpose|
+    Mailer.verify_mail_link(token, purpose)
+    raise 'invalid mail link accepted'
+  rescue ActiveSupport::MessageVerifier::InvalidSignature
+    # Expected: rotations must retain authentication, purpose and expiry.
+  end
+  # Moving a future purpose-bound cookie to the session name must not work.
+  if artifacts['metadata']
+    other_client = Rack::Test::Session.new(Rack::MockSession.new(Rails.application))
+    value = artifacts.fetch('cookies').fetch('upgrade_encrypted')
+    other_client.set_cookie("_redmine_session=#{Rack::Utils.escape(value)}")
+    other_client.get('/upgrade/read')
+    check(JSON.parse(other_client.last_response.body)['user_id'].nil?, 'cookie purpose ignored')
+  end
+  wrong_key = ActiveSupport::MessageVerifier.new('not the application secret')
+  begin
+    Mailer.verify_mail_link(wrong_key.generate(data, purpose: :unwatch), :unwatch)
+    raise 'wrong-secret token accepted'
+  rescue ActiveSupport::MessageVerifier::InvalidSignature
+    # Authentication still applies to all rotated keys.
+  end
+  # Correctly shaped cookies from another secret must not authenticate either.
+  wrong_encryptor = ActiveSupport::MessageEncryptor.new('x' * 32, cipher: 'aes-256-gcm')
+  other_client = Rack::Test::Session.new(Rack::MockSession.new(Rails.application))
+  wrong_cookies = {
+    '_redmine_session' => wrong_encryptor.encrypt_and_sign(data, purpose: 'cookie._redmine_session'),
+    'upgrade_signed' => wrong_key.generate(data, purpose: 'cookie.upgrade_signed'),
+    'upgrade_encrypted' => wrong_encryptor.encrypt_and_sign(data, purpose: 'cookie.upgrade_encrypted')
+  }
+  wrong_cookies.each {|name, value| other_client.set_cookie("#{name}=#{Rack::Utils.escape(value)}")}
+  other_client.get('/upgrade/read')
+  check(JSON.parse(other_client.last_response.body).values.all?(&:nil?), 'wrong-secret cookies accepted')
+  if rewritten_file
+    artifacts['token'] = Mailer.mail_link_token(:unwatch, data)
+    artifacts['cookies'] = client.cookie_jar.to_hash
+    artifacts['metadata'] = Rails.application.config.action_dispatch.use_cookies_with_metadata
+    File.write(rewritten_file, JSON.pretty_generate(artifacts))
+  end
+  # Cookie rotations must not allow unauthenticated values.
+  artifacts.fetch('cookies').each {|name, value| client.set_cookie("#{name}=#{Rack::Utils.escape(value + 'tampered')}")}
+  client.get('/upgrade/read')
+  check(JSON.parse(client.last_response.body).values.all?(&:nil?), 'tampered cookies accepted')
+end
+puts "#{Rails.version}/Ruby #{RUBY_VERSION}: #{mode} #{file} OK"
diff --git a/test/upgrade/compatibility.sh b/test/upgrade/compatibility.sh
new file mode 100644
index 0000000..c3038a6
--- /dev/null
+++ b/test/upgrade/compatibility.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+artifacts=$(mktemp -d)
+trap 'rm -rf "$artifacts"' EXIT
+probe=test/upgrade/artifacts.rb
+run() { BUNDLE_GEMFILE="$1" bundle exec ruby "$probe" "${@:2}"; }
+
+# Idle sessions and already-sent links, without an intervening bridge visit.
+for fixture in test/upgrade/fixtures/*.json; do
+  run Gemfile read "$fixture"
+  run Gemfile.previous --previous read "$fixture" "$artifacts/renewed.json"
+  run Gemfile read "$artifacts/renewed.json"
+done
+
+# Frozen deployed 7.2 configuration, independent of current initializers.
+run Gemfile.previous --previous write "$artifacts/previous.json"
+run Gemfile read "$artifacts/previous.json" "$artifacts/upgraded.json"
+run Gemfile.previous --previous read "$artifacts/upgraded.json"
+
+# Native 8.1 defaults must be readable during rollback, and new rollback links
+# and reissued cookies must survive rolling forward again.
+run Gemfile write "$artifacts/current.json"
+run Gemfile.previous --previous read "$artifacts/current.json" "$artifacts/rollback.json"
+run Gemfile read "$artifacts/rollback.json"
