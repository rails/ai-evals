+++ b/test/upgrade/defaults81.rb
@@ -0,0 +1,14 @@
+# frozen_string_literal: true
+
+# Test-only following release: native 8.1 defaults, no rollback writer pins.
+# BUNDLE_GEMFILE=Gemfile.next bundle exec ruby -r ./test/upgrade/defaults81.rb bin/rails test ...
+ENV['RAILS_ENV'] = 'test'
+require_relative '../../config/application'
+config = Rails.application.config
+raise 'missing rollback metadata override' unless config.active_support.use_message_serializer_for_metadata == false
+
+config.load_defaults '8.1'
+# Reader-only exception: strict JSON would discard dormant Marshal cookies.
+config.action_dispatch.cookies_serializer = :hybrid
+# Application association policy, not a rollback writer exception.
+config.active_record.belongs_to_required_by_default = false
