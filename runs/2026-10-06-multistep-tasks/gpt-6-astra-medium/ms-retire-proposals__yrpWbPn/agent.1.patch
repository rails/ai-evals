   included do
     acts_as_taggable_on :tags, :ml_tags
+    singleton_class.prepend(StableTagProjection)
     validate :max_number_of_tags, on: :create
     before_validation :sanitize_tag_list
   end
 
+  module StableTagProjection
+    # The gem explicitly selects tags.* for clouds and administrative tag lists.
+    # Keep a stable projection while the next release drops proposals_count.
+    def tag_scope_joins(tag_scope, tagging_scope)
+      tag_class = ActsAsTaggableOn::Tag
+      columns = tag_class.column_names.map do |name|
+        "#{tag_class.quoted_table_name}.#{tag_class.connection.quote_column_name(name)}"
+      end.join(", ")
+      projection = tag_scope.select_values.map do |field|
+        field.is_a?(String) ? field.gsub("#{tag_class.table_name}.*", columns) : field
+      end
+      super(tag_scope.reselect(*projection), tagging_scope)
+    end
+  end
+
