+                                        created_at: Time.current, updated_at: Time.current)
+    ids = [
+      legacy_row("notifications", user_id: user.id, notifiable_type: "Proposal", notifiable_id: 123),
+      legacy_row("notifications", user_id: user.id, notifiable_type: "ProposalNotification",
