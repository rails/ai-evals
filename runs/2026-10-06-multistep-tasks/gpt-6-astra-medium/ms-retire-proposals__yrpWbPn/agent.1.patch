diff --git a/config/initializers/retired_citizen_jobs.rb b/config/initializers/retired_citizen_jobs.rb
new file mode 100644
index 0000000..d9f6e99
--- /dev/null
+++ b/config/initializers/retired_citizen_jobs.rb
@@ -0,0 +1,22 @@
+# During a rolling deploy, previous workers may still enqueue proposal jobs.
+# Quarantine (do not delete) those payloads for the final archive/cleanup deploy.
+Rails.application.reloader.to_prepare do
+  unless Delayed::Job.singleton_class < RetiredCitizenJobs
+    Delayed::Job.singleton_class.prepend(RetiredCitizenJobs)
+  end
+
+  Delayed::Job.class_eval do
+    unless @retired_citizen_jobs_scoped
+      default_scope do
+        # Avoid literal question marks: DJ embeds this SQL in a second bound query.
+        retired_payload = "!ruby/(object:|ActiveRecord:|class ['\"]{0,1})" \
+                          "((Proposal|Link)([[:space:]'\"/:]|$)|ProposalNotification|" \
+                          "Dashboard::|EmailDigest)|" \
+                          "method_name: :{0,1}proposal_notification_digest|" \
+                          "!ruby/class ['\"]Notification['\"][[:space:]]+method_name: :{0,1}send_pending"
+        where("handler !~ ?", retired_payload)
+      end
+      @retired_citizen_jobs_scoped = true
+    end
+  end
+end
