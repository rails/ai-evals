diff --git a/spec/requests/citizen_proposal_retirement_spec.rb b/spec/requests/citizen_proposal_retirement_spec.rb
new file mode 100644
index 0000000..6f6e418
--- /dev/null
+++ b/spec/requests/citizen_proposal_retirement_spec.rb
@@ -0,0 +1,212 @@
+require "rails_helper"
+
+# Raw inserts mimic the previous release without retaining its removed models.
+describe "Citizen proposal retirement" do
+  def legacy_row(table, attributes)
+    connection = ActiveRecord::Base.connection
+    attributes = attributes.stringify_keys
+    %w[created_at updated_at].each do |column|
+      attributes[column] ||= Time.current if connection.columns(table).any? { |c| c.name == column }
+    end
+    columns = attributes.keys.map { |key| connection.quote_column_name(key) }.join(", ")
+    values = attributes.values.map { |value| connection.quote(value) }.join(", ")
+    connection.select_value("INSERT INTO #{table} (#{columns}) VALUES (#{values}) RETURNING id").to_i
+  end
+
