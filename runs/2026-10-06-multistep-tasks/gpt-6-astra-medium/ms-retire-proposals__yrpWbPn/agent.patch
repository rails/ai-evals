+  }.freeze
+  # Non-polymorphic ownership, including relationships with no database FK.
+  EDGES = [
+    %w[comments comment_translations comment_id], %w[communities topics community_id],
+    %w[signature_sheets signatures signature_sheet_id],
+    %w[related_contents related_contents related_content_id],
+    %w[related_contents related_content_scores related_content_id],
+    %w[milestones milestone_translations milestone_id], %w[progress_bars progress_bar_translations progress_bar_id],
+    %w[web_sections banner_sections web_section_id], %w[widget_cards widget_card_translations widget_card_id],
+    %w[polls poll_translations poll_id], %w[polls poll_questions poll_id],
+    %w[polls geozones_polls poll_id], %w[polls poll_voters poll_id],
+    %w[polls poll_booth_assignments poll_id], %w[polls poll_ballot_sheets poll_id],
+    %w[poll_questions poll_question_translations poll_question_id],
+    %w[poll_questions poll_question_answers question_id], %w[poll_questions poll_answers question_id],
