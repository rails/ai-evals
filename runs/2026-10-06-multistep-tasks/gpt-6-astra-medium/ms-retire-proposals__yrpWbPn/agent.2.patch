+  end
+
+  it "refuses unreviewed tenant schemas" do
+    @db.exec('CREATE SCHEMA another_city; CREATE TABLE another_city.users (id integer)')
+    expect { run_removal }.to raise_error(/Unreviewed tenant schemas/)
+    schema_intact!
+  end
+end
