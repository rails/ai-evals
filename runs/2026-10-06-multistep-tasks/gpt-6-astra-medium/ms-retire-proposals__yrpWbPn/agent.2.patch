+    expect(files.any? { |f| f.end_with?('/completed.json') }).to be(false)
+  end
+
+  it "refuses unreviewed incoming foreign keys" do
+    @db.exec('CREATE TABLE custom_dependency (proposal_id integer REFERENCES proposals(id))')
+    expect { run_removal }.to raise_error(/Unreviewed incoming foreign keys/)
