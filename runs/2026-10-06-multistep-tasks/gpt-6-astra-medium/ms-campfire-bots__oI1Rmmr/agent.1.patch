diff --git a/docs/bots.md b/docs/bots.md
new file mode 100644
index 0000000..fd2bf97
--- /dev/null
+++ b/docs/bots.md
@@ -0,0 +1,56 @@
+# Chat bots
+
+Any member can create a bot from **Account settings → Set up chat bots**. Members
+manage their own bots; administrators manage all bots. The unpaginated bots page
+shows each bot's secret code. Names are required and avatars are optional.
+
+Bots are users with the `bot` role, an owning `creator`, and a unique random
+32-character `bot_code`. They reuse user avatars, membership pickers, automatic
+membership in open rooms, message authorship, broadcasts, unread tracking, and
+push delivery. They have no email or user-chosen password. Account role management
+excludes bots so a people-only role switch cannot change their identity.
+
+Deleting a bot deactivates it, immediately rejecting its API credentials while
+preserving previously posted messages and their author attribution.
+
+## Posting
+
+```sh
+curl --data-binary 'Deploy of v1.2.3 finished ✅' \
+  https://chat.example.com/rooms/ROOM_ID/BOT_CODE/messages
+```
+
+The entire body is UTF-8 plain text, not a form or JSON envelope. HTML characters
+are escaped, and line breaks are preserved. `--data-binary @file.txt` preserves
+newlines when sending a file. The bot must belong to the target room.
+
+Responses:
+
+- `201 Created`, with `Location: /messages/MESSAGE_ID`
+- `422 Unprocessable Content` for blank or invalid UTF-8 text
+- `404 Not Found` for a missing room or a room the bot cannot access
+- `401 Unauthorized` for an invalid or inactive bot code
+
+The raw-text endpoint does not process attachment uploads. It uses bot credentials
+rather than browser sessions or CSRF tokens. A narrowly scoped middleware disables
+form parsing before Rack's method override, so even `_method=delete` remains text.
+
+## Credential handling
+
+Treat bot codes like passwords. Management is authorization-scoped, its responses
+use `Cache-Control: no-store`, and Turbo page caching is disabled. Rails parameter,
+model inspection, and request path filtering redact bot codes. The database and
+backups contain credentials and must be protected. Avoid SQL debug logging in
+production, and configure reverse proxies, access logs, and external telemetry to
+redact the credential segment in `/rooms/:room_id/:bot_code/messages` too: Rails
+cannot filter logs captured upstream. Always use HTTPS.
+
+## Regression tests
+
+```sh
+bin/rails test test/controllers/bots_controller_test.rb test/controllers/bots/messages_controller_test.rb
+bin/rails test test/system/bots_test.rb
+```
+
+The system test covers the account entry point, exact labels, editing, and both
+canceling and accepting the native delete confirmation. It requires ChromeDriver.
diff --git a/lib/bot_message_body.rb b/lib/bot_message_body.rb
new file mode 100644
index 0000000..39844fb
--- /dev/null
+++ b/lib/bot_message_body.rb
@@ -0,0 +1,16 @@
+# Bot messages are raw text even when curl sends a form Content-Type. Prevent
+# parameter parsing (and _method overrides) before Rack or Rails consumes them.
+class BotMessageBody
+  def initialize(app)
+    @app = app
+  end
+
+  def call(env)
+    if env["REQUEST_METHOD"] == "POST" && env["PATH_INFO"].match?(%r{\A/rooms/[^/]+/[^/]+/messages(?:\.[^/]+)?\z})
+      env["rack.request.form_hash"] = {}
+      env["action_dispatch.request.request_parameters"] = {}
+    end
+
+    @app.call(env)
+  end
+end
diff --git a/lib/rails_ext/bot_code_filtering.rb b/lib/rails_ext/bot_code_filtering.rb
new file mode 100644
index 0000000..9c9f06a
--- /dev/null
+++ b/lib/rails_ext/bot_code_filtering.rb
@@ -0,0 +1,18 @@
+# Rails normally filters query parameters, but bot credentials live in the path.
+module BotCodeFiltering
+  BOT_MESSAGE_PATH = %r{(/rooms/[^/]+/)[^/]+(/messages(?:\.[^/?]+)?)(?=\?|\z)}
+
+  def filtered_path
+    super.sub(BOT_MESSAGE_PATH, '\1[FILTERED]\2')
+  end
+
+  def filtered_env
+    super.dup.tap do |filtered|
+      %w[ PATH_INFO REQUEST_URI ORIGINAL_FULLPATH ].each do |key|
+        filtered[key] = filtered[key].sub(BOT_MESSAGE_PATH, '\1[FILTERED]\2') if filtered[key].is_a?(String)
+      end
+    end
+  end
+end
+
+ActionDispatch::Request.prepend BotCodeFiltering
diff --git a/test/controllers/bots/messages_controller_test.rb b/test/controllers/bots/messages_controller_test.rb
new file mode 100644
index 0000000..8a4ab79
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:jz))
+    @room = rooms(:hq)
+  end
+
+  test "raw curl body creates a bot authored message with broadcasts and push" do
+    text = "Deploy of v1.2.3 finished ✅ & <tag>\nAll done."
+    assert_enqueued_with job: Room::PushMessageJob do
+      assert_difference -> { Message.count } do
+        post room_bot_messages_url(@room, @bot.bot_code), params: text.dup,
+          headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+      end
+    end
+    assert_response :created
+    message = Message.last
+    assert_equal message_path(message.id), response.headers["Location"]
+    assert_equal text, message.plain_text_body
+    assert_equal @bot, message.creator
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__body", text: /Deploy of v1.2.3/
+    end
+  end
+
+  test "bodies are literal text regardless of content type" do
+    [ "text/plain", "application/json", "application/x-www-form-urlencoded" ].each do |content_type|
+      [ "_method=delete", "{not json}", "body=Hello&name=Bot", "100% done", "<script>alert('hi')</script>" ].each do |text|
+        post room_bot_messages_url(@room, @bot.bot_code), params: text.dup, headers: { "Content-Type" => content_type }
+        assert_response :created
+        assert_equal text, Message.last.plain_text_body
+        assert_equal({}, request.request_parameters)
+      end
+    end
+  end
+
+  test "invalid UTF-8 is rejected without creating a message" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "\xFF".b, headers: { "Content-Type" => "text/plain" }
+    end
+    assert_response :unprocessable_entity
+  end
+
+  test "bot codes are filtered from Rails request diagnostics" do
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Hello"
+    assert_not_includes request.filtered_path, @bot.bot_code
+    assert_not_includes request.filtered_parameters.inspect, @bot.bot_code
+    assert_not_includes request.filtered_env.slice("PATH_INFO", "REQUEST_URI", "ORIGINAL_FULLPATH").inspect, @bot.bot_code
+    assert_not_includes @bot.inspect, @bot.bot_code
+  end
+
+  test "browser sessions cannot substitute for bot credentials" do
+    sign_in :david
+    post room_bot_messages_url(@room, "invalid"), params: "Hello"
+    assert_response :unauthorized
+  end
+
+  test "the API does not require a CSRF token" do
+    ActionController::Base.stubs(:allow_forgery_protection).returns(true)
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Hello"
+    assert_response :created
+  end
+
+  test "empty and whitespace only bodies are rejected" do
+    [ "", " \n\t" ].each do |body|
+      assert_no_difference -> { Message.count } do
+        post room_bot_messages_url(@room, @bot.bot_code), params: body, headers: { "Content-Type" => "text/plain" }
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "invalid and deactivated credentials are unauthorized" do
+    [ "invalid", "" ].each do |code|
+      post "/rooms/#{@room.id}/#{code.presence || 'unknown'}/messages", params: "Hello"
+      assert_response :unauthorized
+    end
+    @bot.deactivate
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Hello"
+    assert_response :unauthorized
+  end
+
+  test "bad rooms and rooms without membership are not found" do
+    [ 0, rooms(:watercooler).id ].each do |room_id|
+      post room_bot_messages_url(room_id, @bot.bot_code), params: "Hello"
+      assert_response :not_found
+    end
+    @room = rooms(:watercooler)
+    @room.memberships.grant_to @bot
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Hello"
+    assert_response :created
+  end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..bc42702
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :jz
+  end
+
+  test "members can create bots and see their credentials" do
+    get edit_account_url
+    assert_select "a[aria-label='Set up chat bots']"
+
+    get new_bot_url
+    assert_select "label", text: "Name the bot"
+
+    assert_difference -> { User.bot.count } do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+    bot = User.bot.last
+    assert_equal users(:jz), bot.creator
+    assert_equal Rooms::Open.order(:id).ids, bot.rooms.order(:id).ids
+    assert_redirected_to bots_url
+    follow_redirect!
+    assert_select "li" do
+      assert_select "a", text: "Edit Deploy Bot"
+      assert_select "input[readonly][value='#{bot.bot_code}']"
+    end
+    assert_includes response.headers["Cache-Control"], "no-store"
+  end
+
+  test "bots can have avatars added and replaced" do
+    post bots_url, params: { bot: { name: "Avatar Bot", avatar: fixture_file_upload("earth.png", "image/png") } }
+    bot = User.bot.last
+    assert_redirected_to bots_url
+    assert bot.avatar.attached?
+    assert_equal "earth.png", bot.avatar.filename.to_s
+
+    patch bot_url(bot), params: { bot: { name: "New name", avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+    assert_redirected_to bots_url
+    assert_equal "moon.jpg", bot.reload.avatar.filename.to_s
+  end
+
+  test "account role management cannot change a bot into a person" do
+    bot = User.create!(name: "Bot", role: :bot, creator: users(:jz))
+    sign_in :david
+    assert_raises(ActiveRecord::RecordNotFound) do
+      patch account_user_url(bot), params: { user: { role: "administrator" } }
+    end
+    assert bot.reload.bot?
+  end
+
+  test "bot management requires a signed in member" do
+    delete session_url
+    get bots_url
+    assert_redirected_to new_session_url
+
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: "Anonymous bot" } }
+    end
+    assert_redirected_to new_session_url
+  end
+
+  test "invalid updates keep the existing name" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:jz))
+    patch bot_url(bot), params: { bot: { name: " " } }
+    assert_response :unprocessable_entity
+    assert_equal "Deploy Bot", bot.reload.name
+    assert_select "[role=alert]", text: /Name can't be blank/
+  end
+
+  test "name is required" do
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: " " } }
+    end
+    assert_response :unprocessable_entity
+    assert_select "input[required]"
+  end
+
+  test "members can only manage their own bots but administrators can manage all" do
+    mine = User.create!(name: "My bot", role: :bot, creator: users(:jz))
+    other = User.create!(name: "Other bot", role: :bot, creator: users(:kevin))
+
+    get bots_url
+    assert_select "input[value='#{mine.bot_code}']"
+    assert_select "input[value='#{other.bot_code}']", count: 0
+    assert_raises(ActiveRecord::RecordNotFound) { get edit_bot_url(other) }
+    assert_raises(ActiveRecord::RecordNotFound) { patch bot_url(other), params: { bot: { name: "Stolen" } } }
+    assert_raises(ActiveRecord::RecordNotFound) { delete bot_url(other) }
+    assert_raises(ActiveRecord::RecordNotFound) { get edit_bot_url(users(:kevin)) }
+
+    sign_in :david
+    get bots_url
+    assert_select "input[value='#{mine.bot_code}']"
+    assert_select "input[value='#{other.bot_code}']"
+    patch bot_url(other), params: { bot: { name: "Updated" } }
+    assert_redirected_to bots_url
+    assert_equal "Updated", other.reload.name
+  end
+
+  test "edit and delete a bot" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:jz))
+    code = bot.bot_code
+    get edit_bot_url(bot)
+    assert_select "form[data-turbo-confirm] button", text: "Delete this chat bot"
+    patch bot_url(bot), params: { bot: { name: "Release Bot", bot_code: "changed", creator_id: users(:kevin).id, role: "administrator" } }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+    assert_equal code, bot.bot_code
+    assert bot.bot?
+    assert_equal users(:jz), bot.creator
+
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+    get bots_url
+    assert_select "input[value='#{code}']", count: 0
+  end
+end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..93193df
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "bots have distinct credentials and join current and future open rooms" do
+    first = User.create!(name: "Deploy", role: :bot, creator: users(:jz))
+    second = User.create!(name: "Monitor", role: :bot, creator: users(:jz))
+    assert_match(/\A[1-9A-HJ-NP-Za-km-z]{32}\z/, first.bot_code)
+    assert_not_equal first.bot_code, second.bot_code
+    assert_equal Rooms::Open.order(:id).ids, first.rooms.order(:id).ids
+
+    room = Rooms::Open.create!(name: "New room", creator: users(:david))
+    assert_includes room.users, first
+    assert_includes room.users, second
+  end
+
+  test "deleting a bot preserves message history and authorship" do
+    bot = User.create!(name: "Deploy", role: :bot, creator: users(:jz))
+    message = rooms(:hq).messages.create!(creator: bot, body: "Shipped")
+    bot.deactivate
+
+    assert bot.deactivated?
+    assert_equal "Deploy", message.reload.creator.name
+    assert_equal "Shipped", message.plain_text_body
+  end
+
+  test "people do not receive bot credentials" do
+    assert_nil users(:jz).bot_code
+  end
+end
