diff --git a/docs/bots.md b/docs/bots.md
new file mode 100644
index 0000000..95d563f
--- /dev/null
+++ b/docs/bots.md
@@ -0,0 +1,62 @@
+# Chat bots
+
+Any member can manage their bots via **Account settings → Set up chat bots**.
+Administrators can manage all bots. Bot codes are shown only on that management
+page; treat them like passwords.
+
+Bots are `User` records with the `bot` role, a creator, and a unique random
+`bot_code`. They reuse avatars, room membership, authorship, unread tracking,
+broadcasts, and push notifications. Creating a bot joins all existing open rooms;
+new open rooms also include active bots. The normal room member picker includes
+bots for private rooms.
+
+Deletion deactivates the bot: its code immediately stops authenticating, its
+non-direct memberships are removed, and existing messages keep their author.
+The code stays reserved in the database and is never reassigned to a new bot.
+Bot role changes through account settings are intentionally prohibited.
+
+## Posting
+
+```sh
+curl --data-binary 'Deploy of v1.2.3 finished ✅' \
+  https://chat.example.com/rooms/ROOM_ID/BOT_CODE/messages
+```
+
+The endpoint authenticates only active bots; browser sessions are irrelevant.
+A bot must belong to the room. Missing and inaccessible rooms both return 404.
+The body is UTF-8 plain text, with HTML escaped and newlines preserved, regardless
+of the supplied content type. No JSON envelope or form field names are needed.
+
+Responses:
+
+- 201 with `Location: /messages/MESSAGE_ID` on success
+- 422 for blank or invalid UTF-8 content
+- 401 for invalid, banned, or deleted bot credentials
+- 404 for a missing or inaccessible room
+
+`BotMessageRequests` normalizes content types before Rack/Rails parsing so shell
+output is not interpreted as form data, JSON, or a method override. The endpoint
+uses the normal message creation callback and `broadcast_create` method, including
+push job scheduling.
+
+## Credential handling
+
+- The bot list is unpaginated, scoped by creator (or administrator), and marked
+  `no-store` in HTTP and Turbo caches.
+- Only name/avatar are permitted in management forms. Codes and ownership cannot
+  be set through these forms.
+- `bot_code` is filtered in Rails parameters and model inspection. Request-path
+  filtering also redacts the credential in Rails' initial request log.
+- **Serve over HTTPS. Configure reverse proxies, CDNs, APM/error collectors, and
+  access logs to redact `/rooms/:room_id/:bot_code/messages` URLs or exclude this
+  endpoint.** Rails filtering cannot protect logs outside Rails. Do not publish
+  these URLs in chat messages, screenshots, or CI logs.
+
+Run the migration with `bin/rails db:migrate` before deploying.
+
+Tests:
+
+```sh
+bin/rails test test/controllers/bots_controller_test.rb test/controllers/bots/messages_controller_test.rb
+bin/rails test test/system/bots_test.rb
+```
diff --git a/lib/rails_ext/bot_message_requests.rb b/lib/rails_ext/bot_message_requests.rb
new file mode 100644
index 0000000..310e8ee
--- /dev/null
+++ b/lib/rails_ext/bot_message_requests.rb
@@ -0,0 +1,25 @@
+# This endpoint accepts a raw text body even when curl supplies a form content
+# type. Normalize it before Rack's method override or Rails parameter parsing.
+class BotMessageRequests
+  PATH = %r{\A(/rooms/[^/]+/)[^/]+(/messages)/?\z}
+
+  def initialize(app)
+    @app = app
+  end
+
+  def call(env)
+    if env["REQUEST_METHOD"] == "POST" && PATH.match?(env["PATH_INFO"])
+      env["CONTENT_TYPE"] = "text/plain; charset=utf-8"
+    end
+
+    @app.call(env)
+  end
+
+  # Rails' standard parameter filtering handles query/body parameters, but not
+  # credentials in path segments (including the initial "Started POST" log).
+  module FilteredPath
+    def filtered_path
+      super.sub(%r{\A(/rooms/[^/]+/)[^/]+(/messages)(?=/|\?|\z)}, '\1[FILTERED]\2')
+    end
+  end
+end
diff --git a/test/controllers/bots/messages_controller_test.rb b/test/controllers/bots/messages_controller_test.rb
new file mode 100644
index 0000000..7fea485
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    @room = rooms(:hq)
+  end
+
+  test "raw messages use the bot as author and broadcast and notify" do
+    text = "Deploy of v1.2.3 finished ✅\nstatus=ok & <done>"
+    assert_enqueued_with job: Room::PushMessageJob do
+      assert_difference "Message.count" do
+        post endpoint, params: text.dup, headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+      end
+    end
+    assert_response :created
+    message = Message.last
+    assert_equal @bot, message.creator
+    payload = Room::MessagePusher.new(room: @room, message: message).push
+    assert_equal "Deploy Bot: #{text}", payload[:body]
+    assert_equal text, message.plain_text_body
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__body", text: /Deploy of v1.2.3/
+    end
+  end
+
+  test "empty and whitespace messages are rejected" do
+    [ "", " \n\t" ].each do |body|
+      assert_no_difference "Message.count" do
+        post endpoint, params: body, headers: { "Content-Type" => "text/plain" }
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "invalid codes and deleted bots are unauthorized" do
+    post endpoint(code: "invalid"), params: "Hello"
+    assert_response :unauthorized
+    @bot.banned!
+    post endpoint, params: "Hello"
+    assert_response :unauthorized
+    @bot.deactivate
+    post endpoint, params: "Hello"
+    assert_response :unauthorized
+  end
+
+  test "unknown rooms and rooms the bot has not joined are not found" do
+    [ 0, rooms(:watercooler).id ].each do |room_id|
+      post endpoint(room_id: room_id), params: "Hello"
+      assert_response :not_found
+    end
+    rooms(:watercooler).memberships.grant_to [ @bot ]
+    post endpoint(room_id: rooms(:watercooler).id), params: "Hello"
+    assert_response :created
+  end
+
+  test "request content types do not interpret or reject the raw text" do
+    [ "application/json", "application/x-www-form-urlencoded", "multipart/form-data", "text/plain" ].each do |content_type|
+      text = "unparsed [a]=b & 100% ✅ <script>alert('hello')</script>"
+      post endpoint, params: text.dup, headers: { "Content-Type" => content_type }
+      assert_response :created
+      assert_equal text, Message.last.plain_text_body
+    end
+  end
+
+  test "session cookies do not override bot authentication" do
+    sign_in :david
+    post endpoint(code: "invalid"), params: "Hello"
+    assert_response :unauthorized
+    post endpoint, params: "Hello"
+    assert_response :created
+    assert_equal @bot, Message.last.creator
+  end
+
+  test "bot codes are filtered from request paths and parameters" do
+    post endpoint, params: "Hello"
+    assert_not_includes request.filtered_path, @bot.bot_code
+    assert_includes request.filtered_path, "[FILTERED]"
+    assert_equal "[FILTERED]", request.filtered_parameters["bot_code"]
+    assert_not_includes request.filtered_parameters.keys, "Hello"
+    assert_not_includes @bot.inspect, @bot.bot_code
+  end
+
+  test "invalid UTF-8 is rejected" do
+    assert_no_difference "Message.count" do
+      post endpoint, params: "\xFF".b, headers: { "Content-Type" => "text/plain" }
+    end
+    assert_response :unprocessable_entity
+  end
+
+  test "malformed body does not affect invalid credential responses" do
+    assert_no_difference "Message.count" do
+      post endpoint(code: "invalid"), params: "not json", headers: { "Content-Type" => "application/json" }
+    end
+    assert_response :unauthorized
+  end
+
+  test "shell clients can post without a CSRF token when forgery protection is enabled" do
+    previous = ActionController::Base.allow_forgery_protection
+    ActionController::Base.allow_forgery_protection = true
+
+    post endpoint, params: "Deploy completed", headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+    assert_response :created
+  ensure
+    ActionController::Base.allow_forgery_protection = previous
+  end
+
+  private
+
+    def endpoint(code: @bot.bot_code, room_id: @room.id)
+      "/rooms/#{room_id}/#{code}/messages"
+    end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..12b69e1
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "members can create bots that join open rooms" do
+    get edit_account_url
+    assert_select "a[aria-label='Set up chat bots'][href=?]", bots_path
+    get new_bot_url
+    assert_select "label", text: "Name the bot"
+
+    assert_difference "User.bot.count" do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+    assert_redirected_to bots_url
+    bot = User.bot.last
+    assert_equal users(:kevin), bot.creator
+    assert_equal Room.opens.ids.sort, bot.room_ids.sort
+    assert bot.bot_code.present?
+
+    follow_redirect!
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "input[readonly][value=?]", bot.bot_code
+      assert_select "a", text: "Edit Deploy Bot"
+    end
+    assert_includes response.headers["Cache-Control"], "no-store"
+  end
+
+  test "management requires authentication" do
+    delete session_url
+    get bots_url
+    assert_redirected_to new_session_url
+    assert_no_difference "User.count" do
+      post bots_url, params: { bot: { name: "Anonymous Bot" } }
+    end
+    assert_redirected_to new_session_url
+  end
+
+  test "bots cannot become administrators through account settings" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    sign_in :david
+    patch account_user_url(bot), params: { user: { role: "administrator" } }
+    assert_response :forbidden
+    assert bot.reload.bot?
+  end
+
+  test "editing a person through the bot interface is not allowed" do
+    sign_in :david
+    assert_raises(ActiveRecord::RecordNotFound) { get edit_bot_url(users(:jz)) }
+  end
+
+  test "deleting a bot preserves its messages" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    message = rooms(:hq).messages.create!(creator: bot, body: "Deployed")
+    delete bot_url(bot)
+    assert_equal bot, message.reload.creator
+    assert bot.reload.deactivated?
+  end
+
+  test "banned bots remain manageable" do
+    bot = User.create!(name: "Banned Bot", role: :bot, creator: users(:kevin), status: :banned)
+    get bots_url
+    assert_select "a", text: "Edit Banned Bot"
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+  end
+
+  test "name is required" do
+    assert_no_difference "User.count" do
+      post bots_url, params: { bot: { name: "  " } }
+    end
+    assert_response :unprocessable_entity
+    assert_select "input[name='bot[name]'][required]"
+  end
+
+  test "only creators and administrators can see and manage bots" do
+    own = User.create!(name: "Own Bot", role: :bot, creator: users(:kevin))
+    other = User.create!(name: "Other Bot", role: :bot, creator: users(:jz))
+    assert_not_equal own.bot_code, other.bot_code
+
+    get bots_url
+    assert_select "input[value=?]", own.bot_code
+    assert_select "input[value=?]", other.bot_code, count: 0
+    assert_raises(ActiveRecord::RecordNotFound) { get edit_bot_url(other) }
+    assert_raises(ActiveRecord::RecordNotFound) { patch bot_url(other), params: { bot: { name: "Stolen" } } }
+    assert_raises(ActiveRecord::RecordNotFound) { delete bot_url(other) }
+
+    sign_in :david
+    get bots_url
+    assert_select "input[value=?]", own.bot_code
+    assert_select "input[value=?]", other.bot_code
+    patch bot_url(other), params: { bot: { name: "Renamed" } }
+    assert_redirected_to bots_url
+    assert_equal "Renamed", other.reload.name
+  end
+
+  test "editing and deleting bots" do
+    bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:kevin))
+    get edit_bot_url(bot)
+    assert_select "form[data-turbo-confirm] button", text: "Delete this chat bot"
+    patch bot_url(bot), params: { bot: { name: "Release Bot", avatar: fixture_file_upload("moon.jpg", "image/jpeg"), role: "administrator", bot_code: "insecure", creator_id: users(:jz).id } }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+    assert bot.avatar.attached?
+    assert bot.bot?
+    assert_equal users(:kevin), bot.creator
+    assert_not_equal "insecure", bot.bot_code
+
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+    get bots_url
+    assert_select "input[value=?]", bot.bot_code, count: 0
+  end
+end
