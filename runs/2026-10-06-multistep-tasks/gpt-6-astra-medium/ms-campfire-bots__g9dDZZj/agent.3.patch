diff --git a/app/models/user/bot_webhook.rb b/app/models/user/bot_webhook.rb
new file mode 100644
index 0000000..7b859bd
--- /dev/null
+++ b/app/models/user/bot_webhook.rb
@@ -0,0 +1,70 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class User::BotWebhook
+  include Rails.application.routes.url_helpers
+
+  MAX_REPLY_SIZE = 1.megabyte
+
+  attr_reader :bot, :room
+
+  def initialize(bot:, room:)
+    @bot, @room = bot, room
+  end
+
+  def deliver
+    if deliverable? && (body = fetch_reply).present?
+      # Membership or the webhook may have been removed while waiting for HTTP.
+      bot.reload
+      if deliverable?
+        reply = room.messages.create!(creator: bot, body: body)
+        reply.broadcast_create
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      bot.bot? && bot.active? && bot.webhook_url.present? &&
+        room.users.exists?(bot.id)
+    end
+
+    def room_payload
+      { id: room.id, name: room.name, reply_to: bot_room_messages_path(room_id: room.id, bot_code: bot.bot_code) }
+    end
+
+    def fetch_reply
+      url = URI.parse(bot.webhook_url)
+      ip = RestrictedHTTP::PrivateNetworkGuard.resolve(url.host)
+      request = Net::HTTP::Post.new(url, "Content-Type" => "application/json")
+      request.body = payload.to_json
+
+      # Pin the validated address and never follow redirects with bot credentials.
+      Net::HTTP.start(url.host, url.port, nil, ipaddr: ip, use_ssl: url.scheme == "https",
+        open_timeout: 5, read_timeout: 10, write_timeout: 10) do |http|
+        http.request(request) do |response|
+          return reply_body(response)
+        end
+      end
+    rescue => error
+      # URLs and exception messages may contain credentials; do not log them.
+      Rails.logger.warn "Bot webhook failed for bot #{bot.id}, room #{room.id} (#{error.class})"
+      nil
+    end
+
+    def reply_body(response)
+      return unless response.is_a?(Net::HTTPOK)
+      return unless response.content_type.in?(%w[ text/plain text/html ])
+      return if response.content_length.to_i > MAX_REPLY_SIZE
+
+      body = +""
+      response.read_body do |chunk|
+        return if body.bytesize + chunk.bytesize > MAX_REPLY_SIZE
+        body << chunk
+      end
+      body.force_encoding(Encoding::UTF_8)
+      return unless body.valid_encoding? && body.present?
+
+      response.content_type == "text/html" ? body : ERB::Util.html_escape(body).gsub(/\r\n|\r|\n/, "<br>")
+    end
+end
