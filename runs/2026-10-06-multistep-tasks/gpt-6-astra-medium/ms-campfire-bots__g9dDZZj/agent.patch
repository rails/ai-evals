+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "members can create bots without joining open rooms" do
+    get edit_account_url
+    assert_select "a[aria-label='Set up chat bots'][href=?]", bots_path
+    get new_bot_url
+    assert_select "label", text: "Name the bot"
+
+    assert_difference "User.bot.count" do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+    assert_redirected_to bots_url
+    bot = User.bot.last
+    assert_equal users(:kevin), bot.creator
+    assert_empty bot.rooms
+    assert bot.bot_code.present?
+
+    follow_redirect!
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "input[readonly][value=?]", bot.bot_code
+      assert_select "a", text: "Edit Deploy Bot"
+    end
+    assert_includes response.headers["Cache-Control"], "no-store"
+  end
+
+  test "the open room checkbox defaults off and can be changed on both forms" do
+    get new_bot_url
+    assert_select "label", text: "Add to all open rooms" do
+      assert_select "input[type=checkbox][name='bot[add_to_all_open_rooms]']:not([checked])"
+    end
+
+    post bots_url, params: { bot: { name: "Everyone Bot", add_to_all_open_rooms: "1" } }
+    bot = User.bot.last
+    assert bot.add_to_all_open_rooms?
+    assert_equal Room.opens.ids.sort, bot.room_ids.sort
+
+    get edit_bot_url(bot)
+    assert_select "label", text: "Add to all open rooms" do
+      assert_select "input[type=checkbox][name='bot[add_to_all_open_rooms]'][checked]"
+    end
+
+    patch bot_url(bot), params: { bot: { add_to_all_open_rooms: "0" } }
+    assert_not bot.reload.add_to_all_open_rooms?
+    assert_equal Room.opens.ids.sort, bot.room_ids.sort
+
+    room = Rooms::Open.create!(name: "Later", creator: users(:david))
+    assert_not room.users.exists?(bot.id)
+    patch bot_url(bot), params: { bot: { add_to_all_open_rooms: "1" } }
+    assert bot.reload.add_to_all_open_rooms?
+    assert room.users.exists?(bot.id)
+  end
+
+  test "webhook URL is optional on both forms and can be set, changed and removed" do
+    get new_bot_url
+    assert_select "label[for='bot_webhook_url']", text: "Webhook URL"
+    assert_select "input[name='bot[webhook_url]'][required]", count: 0
