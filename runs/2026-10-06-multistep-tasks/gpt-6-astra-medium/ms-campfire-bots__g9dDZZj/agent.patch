diff --git a/test/models/message/bot_webhook_test.rb b/test/models/message/bot_webhook_test.rb
new file mode 100644
index 0000000..a7cd2b6
--- /dev/null
+++ b/test/models/message/bot_webhook_test.rb
@@ -0,0 +1,174 @@
+require "test_helper"
+
+class Message::BotWebhookTest < ActiveSupport::TestCase
+  setup do
+    @bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:david), webhook_url: "https://bot.example.com/mention")
+    @room = rooms(:hq)
+    @room.memberships.grant_to @bot
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example.com").returns("93.184.216.34")
+  end
+
+  test "mentions enqueue one callback per bot without making HTTP requests" do
+    assert_enqueued_jobs 1, only: Message::BotWebhookJob do
+      create_message("#{mention(@bot)} restart #{mention(@bot)}")
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "only active member bots with webhooks are notified and bot replies do not loop" do
+    [ { webhook_url: nil }, { status: :banned }, { status: :deactivated }, { status: :suspended } ].each do |attributes|
+      @bot.update!(webhook_url: "https://bot.example.com/mention", status: :active, **attributes)
+      assert_no_enqueued_jobs only: Message::BotWebhookJob do
+        create_message(mention(@bot))
+      end
+    end
+
+    @bot.update!(status: :active)
+    assert_no_enqueued_jobs only: Message::BotWebhookJob do
+      create_message(mention(@bot), creator: @bot)
+      create_message("@Deploy Bot restart")
+      create_message(mention(users(:david)))
+      @room.memberships.revoke_from @bot
+      create_message(mention(@bot))
+    end
+  end
+
+  test "payload includes command text, rich HTML, deep link and the bot's posting path" do
+    message = create_message("<div>#{mention(@bot)} restart #{mention(users(:david))}<br>please</div>")
+    payload = {
+      event: "mention",
+      author: { id: users(:david).id, name: "David" },
+      room: { id: @room.id, name: @room.name, reply_to: "/rooms/#{@room.id}/#{@bot.bot_code}/messages" },
+      message: {
+        id: message.id,
+        body: { text: "restart @David\nplease", html: message.body.to_s },
+        link: "/rooms/#{@room.id}/@#{message.id}"
+      }
+    }
+    request = stub_request(:post, @bot.webhook_url)
+      .with(headers: { "Content-Type" => "application/json" }, body: payload.to_json)
+      .to_return(status: 204)
+
+    assert_no_difference "Message.count" do
+      Message::BotWebhookJob.perform_now(@bot, message)
+    end
+    assert_requested request
+    assert_includes message.reload.body.to_plain_text, "@Deploy Bot"
+  end
+
+  test "plain text replies are escaped, attributed and broadcast" do
+    message = create_message(mention(@bot))
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "Done <b>now</b>\nNext step")
+
+    assert_difference "Message.count", 1 do
+      Message::BotWebhookJob.perform_now(@bot, message)
+    end
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal "Done <b>now</b>\nNext step", reply.body.to_plain_text
+    assert_includes find_broadcasts_for(@room, :messages), reply.client_message_id
+  end
+
+  test "HTML replies retain formatting and sanitize unsafe content" do
+    message = create_message(mention(@bot))
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/html" }, body: "<div><strong>Done</strong><script>alert(1)</script></div>")
+
+    assert_difference "Message.count", 1 do
+      Message::BotWebhookJob.perform_now(@bot, message)
+    end
+    assert_includes @room.messages.last.body.to_s, "<strong>Done</strong>"
+    assert_not_includes @room.messages.last.body.to_s, "<script>"
+  end
+
+  test "no content, errors, redirects, unsupported types and blank replies do not post" do
+    message = create_message(mention(@bot))
+    [ [ 204, "text/plain", "ignored" ], [ 500, "text/plain", "error" ],
+      [ 302, "text/plain", "redirect" ], [ 200, "application/json", "{}" ],
+      [ 200, "text/plain", "  " ] ].each do |status, type, body|
+      stub_request(:post, @bot.webhook_url).to_return(status: status, headers: { "Content-Type" => type }, body: body)
+      assert_no_difference "Message.count" do
+        Message::BotWebhookJob.perform_now(@bot, message)
+      end
+    end
+  end
+
+  test "each bot gets its own command and posting credentials" do
+    other_bot = User.create!(name: "Other Bot", role: :bot, creator: users(:david), webhook_url: "https://bot.example.com/other")
+    @room.memberships.grant_to other_bot
+    message = nil
+    assert_enqueued_jobs 2, only: Message::BotWebhookJob do
+      message = create_message("#{mention(@bot)} #{mention(other_bot)} go")
+    end
+
+    [ [ @bot, "@Other Bot go" ], [ other_bot, "@Deploy Bot  go" ] ].each do |bot, command|
+      request = stub_request(:post, bot.webhook_url).with do |request|
+        payload = JSON.parse(request.body)
+        payload.dig("message", "body", "text") == command &&
+          payload.dig("room", "reply_to") == "/rooms/#{@room.id}/#{bot.bot_code}/messages"
+      end.to_return(status: 204)
+      Message::BotWebhookJob.perform_now(bot, message)
+      assert_requested request
+    end
+  end
+
+  test "edits and rolled back messages do not trigger callbacks" do
+    message = create_message("Hello")
+    assert_no_enqueued_jobs only: Message::BotWebhookJob do
+      message.update!(body: mention(@bot))
+      Message.transaction do
+        create_message(mention(@bot))
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+
+  test "private network destinations are blocked" do
+    message = create_message(mention(@bot))
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).raises(RestrictedHTTP::Violation)
+    assert_no_difference "Message.count" do
+      Message::BotWebhookJob.perform_now(@bot, message)
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "oversized and invalid UTF-8 replies are ignored" do
+    message = create_message(mention(@bot))
+    [ "a" * (Message::BotWebhook::MAX_REPLY_SIZE + 1), "\xFF".b ].each do |body|
+      stub_request(:post, @bot.webhook_url).to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: body)
+      assert_no_difference "Message.count" do
+        Message::BotWebhookJob.perform_now(@bot, message)
+      end
+    end
+  end
+
+  test "network failures do not post a reply" do
+    message = create_message(mention(@bot))
+    stub_request(:post, @bot.webhook_url).to_timeout
+    assert_no_difference "Message.count" do
+      Message::BotWebhookJob.perform_now(@bot, message)
+    end
+  end
+
+  test "jobs recheck webhook, status and membership before delivery" do
+    message = create_message(mention(@bot))
+    @bot.update!(webhook_url: nil)
+    Message::BotWebhookJob.perform_now(@bot, message)
+    @bot.update!(webhook_url: "https://bot.example.com/mention", status: :banned)
+    Message::BotWebhookJob.perform_now(@bot, message)
+    @bot.update!(status: :active)
+    @room.memberships.revoke_from @bot
+    Message::BotWebhookJob.perform_now(@bot, message)
+    assert_not_requested :post, "https://bot.example.com/mention"
+  end
+
+  private
+    def mention(user)
+      %(<action-text-attachment sgid="#{user.attachable_sgid}"></action-text-attachment>)
+    end
+
+    def create_message(body, creator: users(:david))
+      @room.messages.create!(body: body, creator: creator)
+    end
+end
diff --git a/test/models/room/bot_webhook_test.rb b/test/models/room/bot_webhook_test.rb
new file mode 100644
index 0000000..267683b
--- /dev/null
+++ b/test/models/room/bot_webhook_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Room::BotWebhookTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:david).bots.create!(name: "Hello Bot", webhook_url: "https://bot.example.com/events")
+    @room = rooms(:watercooler)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example.com").returns("93.184.216.34")
+  end
+
+  test "membership creation delivers exactly the joined payload" do
+    payload = {
+      event: "joined",
+      room: { id: @room.id, name: @room.name, reply_to: "/rooms/#{@room.id}/#{@bot.bot_code}/messages" }
+    }
+    request = stub_request(:post, @bot.webhook_url)
+      .with(headers: { "Content-Type" => "application/json" }, body: payload.to_json)
+      .to_return(status: 204)
+
+    assert_no_difference "Message.count" do
+      perform_enqueued_jobs only: Room::BotWebhookJob do
+        @room.memberships.grant_to @bot
+        @room.memberships.grant_to @bot
+      end
+    end
+    assert_requested request, times: 1
+  end
+
+  test "text and HTML greetings become broadcast bot messages without mention callbacks" do
+    [ [ "text/plain", "Hello <everyone>\nWelcome" ], [ "text/html", "<strong>Hello</strong><script>alert(1)</script>" ] ].each do |type, body|
+      @room = Rooms::Closed.create!(name: "Greetings", creator: users(:david))
+      stub_request(:post, @bot.webhook_url).to_return(status: 200, headers: { "Content-Type" => type }, body: body)
+
+      assert_no_enqueued_jobs only: Message::BotWebhookJob do
+        assert_difference "Message.count", 1 do
+          perform_enqueued_jobs only: Room::BotWebhookJob do
+            @room.memberships.grant_to @bot
+          end
+        end
+      end
+      reply = @room.messages.last
+      assert_equal @bot, reply.creator
+      assert_includes find_broadcasts_for(@room, :messages), reply.client_message_id
+      if type == "text/plain"
+        assert_equal body, reply.body.to_plain_text
+      else
+        assert_includes reply.body.to_s, "<strong>Hello</strong>"
+        assert_not_includes reply.body.to_s, "<script>"
+      end
+    end
+  end
+
+  test "jobs recheck membership webhook status and room type" do
+    @room.memberships.grant_to @bot
+    [ { webhook_url: nil }, { status: :banned }, { status: :deactivated }, { status: :suspended } ].each do |attributes|
+      @bot.update!(webhook_url: "https://bot.example.com/events", status: :active, **attributes)
+      Room::BotWebhookJob.perform_now(@bot, @room)
+    end
+    @bot.update!(status: :active)
+    @room.memberships.revoke_from @bot
+    Room::BotWebhookJob.perform_now(@bot, @room)
+    direct = Rooms::Direct.create_for({ creator: users(:david) }, users: [ users(:david), @bot ])
+    Room::BotWebhookJob.perform_now(@bot, direct)
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "revoked membership while waiting for HTTP prevents a reply" do
+    @room.memberships.grant_to @bot
+    stub_request(:post, @bot.webhook_url).to_return do
+      @room.memberships.revoke_from @bot
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "Hello" }
+    end
+    assert_no_difference "Message.count" do
+      Room::BotWebhookJob.perform_now(@bot, @room)
+    end
+  end
+end
