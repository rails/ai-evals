+      {
+        event: "mention",
+        author: { id: message.creator.id, name: message.creator.name },
+        room: room_payload,
+        message: {
+          id: message.id,
+          body: { text: command_text, html: message.body.to_s },
+          link: room_at_message_path(room_id: message.room.id, message_id: message.id)
