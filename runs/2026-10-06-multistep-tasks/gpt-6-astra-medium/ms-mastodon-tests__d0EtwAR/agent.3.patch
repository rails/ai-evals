diff --git a/spec/models/fabricate_spec.rb b/spec/models/fabricate_spec.rb
new file mode 100644
index 0000000..32b6fcf
--- /dev/null
+++ b/spec/models/fabricate_spec.rb
@@ -0,0 +1,71 @@
+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe Fabricate do
+  it 'creates a status without unrelated bookmarks or accounts' do
+    account = Fabricate(:account)
+    status = nil
+
+    expect { status = Fabricate(:status, account: account) }
+      .to not_change(Bookmark, :count)
+      .and not_change(Account, :count)
+
+    expect(status.reload.account).to eq(account)
+  end
+
+  it 'creates a user without incidental login history' do
+    user = nil
+
+    expect { user = Fabricate(:user) }
+      .to not_change(LoginActivity, :count)
+
+    expect(user.reload.account).to be_persisted
+    expect(user.valid_password?('123456789')).to be(true)
+  end
+
+  it 'can explicitly create a bookmark with persisted associations' do
+    bookmark = Fabricate(:bookmark)
+
+    expect(bookmark.reload.account).to be_persisted
+    expect(bookmark.status).to be_persisted
+    expect(bookmark.status.account).to be_persisted
+  end
+
+  it 'can explicitly create login history for a supplied user' do
+    user = Fabricate(:user)
+    activity = nil
+
+    expect { activity = Fabricate(:login_activity, user: user) }
+      .to change(LoginActivity, :count).by(1)
+      .and not_change(User, :count)
+
+    expect(activity.reload.user).to eq(user)
+  end
+
+  it 'keeps build-only status graphs unpersisted' do
+    status = nil
+
+    expect { status = described_class.build(:status) }
+      .to not_change(Status, :count)
+      .and not_change(Account, :count)
+      .and not_change(User, :count)
+      .and not_change(Bookmark, :count)
+      .and not_change(LoginActivity, :count)
+
+    expect(status.account).to be_new_record
+    expect(status.account.user).to be_new_record
+  end
+
+  it 'retains remote status URI setup without creating a local user' do
+    account = Fabricate(:remote_account)
+    status = nil
+
+    expect { status = Fabricate(:status, account: account) }
+      .to not_change(User, :count)
+      .and not_change(Bookmark, :count)
+
+    expect(status.reload.uri).to be_present
+    expect(status.account).to eq(account)
+  end
+end
