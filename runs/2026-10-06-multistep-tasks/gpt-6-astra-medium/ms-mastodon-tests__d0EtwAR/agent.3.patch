diff --git a/docs/profile_factories.rb b/docs/profile_factories.rb
new file mode 100644
index 0000000..da5b404
--- /dev/null
+++ b/docs/profile_factories.rb
@@ -0,0 +1,47 @@
+# frozen_string_literal: true
+
+# Opt-in, sequential-suite instrumentation. Not loaded by normal specs.
+require 'fabrication'
+require 'json'
+require 'rspec/core'
+
+module FactoryProfile
+  ROWS = Hash.new { |hash, key| hash[key] = { calls: 0, inclusive_seconds: 0.0, exclusive_seconds: 0.0 } }
+  EDGES = Hash.new(0)
+
+  def self.measure(strategy, name)
+    stack = (Thread.current[:factory_profile_stack] ||= [])
+    key = "#{strategy}:#{name}"
+    EDGES["#{stack.last[:key]} -> #{key}"] += 1 unless stack.empty?
+    frame = { key: key, children: 0.0 }
+    stack << frame
+    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+    yield
+  ensure
+    elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
+    row = ROWS[key]
+    row[:calls] += 1
+    row[:inclusive_seconds] += elapsed
+    row[:exclusive_seconds] += elapsed - frame[:children]
+    stack.pop
+    stack.last[:children] += elapsed unless stack.empty?
+  end
+
+  module Instrumentation
+    def fabricate(...)
+      FactoryProfile.measure(:create, name) { super }
+    end
+
+    def build(...)
+      FactoryProfile.measure(:build, name) { super }
+    end
+  end
+end
+
+Fabrication::Schematic::Definition.prepend(FactoryProfile::Instrumentation)
+
+RSpec.configure do |config|
+  config.after(:suite) do
+    File.write(ENV.fetch('FACTORY_PROFILE_OUTPUT'), JSON.pretty_generate(factories: FactoryProfile::ROWS, edges: FactoryProfile::EDGES))
+  end
+end
