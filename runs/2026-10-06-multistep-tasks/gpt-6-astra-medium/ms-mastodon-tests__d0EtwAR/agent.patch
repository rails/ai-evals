@@ -0,0 +1,45 @@
+# frozen_string_literal: true
+
+# Load via --require before the spec files so this hook wraps their support hooks.
+require 'rspec/core'
+
+RSpec.configure do |config|
+  config.before :each, type: :request do |example|
+    mode = example.metadata.fetch(:sidekiq, :fake)
+    raise "Wrong Sidekiq mode for #{example.id}" unless Sidekiq::Testing.public_send("#{mode == :disable ? :disabled : mode}?")
+
+    unless example.metadata[:verbose_logging]
+      loggers = [Rails.logger, ActiveRecord::Base.logger].compact.uniq
+      raise "Request logging was not silenced for #{example.id}" unless loggers.all? { |logger| logger.level >= Logger::WARN }
+    end
+  end
+
+  config.around :each, type: :request do |example|
+    levels = [Rails.logger, ActiveRecord::Base.logger].compact.uniq.index_with(&:level)
+    mode = [Sidekiq::Testing.fake?, Sidekiq::Testing.inline?, Sidekiq::Testing.disabled?]
+
+    example.run
+
+    raise "Logger levels leaked from #{example.id}" unless levels.all? { |logger, level| logger.level == level }
+    raise "Sidekiq mode leaked from #{example.id}" unless mode == [Sidekiq::Testing.fake?, Sidekiq::Testing.inline?, Sidekiq::Testing.disabled?]
+  end
+end
+
+# The caching matrix shares database setup, not mutable Ruby model instances.
+# Verify both per-example rollback and the outer transaction's cleanup.
+RSpec.configure do |config|
+  config.around :each, file_path: %r{/spec/requests/cache_spec\.rb} do |example|
+    models = [Account, User, Status, Poll, Invite, Doorkeeper::AccessToken, Follow, LoginActivity, Keypair]
+    # Serialized types such as UserSettings compare by identity, not contents.
+    snapshot = -> { models.map { |model| model.order(:id).map(&:attributes_before_type_cast) } }
+    before = snapshot.call
+
+    example.run
+
+    raise "Shared request data mutated across #{example.id}" unless snapshot.call == before
+  end
+
+  config.after :suite do
+    raise 'Shared caching setup leaked out of its group transaction' if Status.exists?(id: [110_224_538_612_341_312, 110_224_538_643_211_312]) || User.exists?(email: 'user@host.example')
+  end
+end
