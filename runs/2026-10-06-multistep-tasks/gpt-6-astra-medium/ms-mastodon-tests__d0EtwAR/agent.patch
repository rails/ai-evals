+#!/usr/bin/env bash
+# Run only model specs; pass a label and optionally an RSpec random seed.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+label=${1:-models}
+seed=${2:-12345}
+mkdir -p tmp/rspec-profile
+args=()
+if [[ ${FACTORY_PROFILE:-0} == 1 ]]; then
+  export FACTORY_PROFILE_OUTPUT="$PWD/tmp/rspec-profile/$label.factories.json"
+  args+=(--require "$PWD/docs/profile_factories.rb")
+fi
+if [[ ${PROFILE:-0} == 1 ]]; then
+  export MODEL_PROFILE_OUTPUT="$PWD/tmp/rspec-profile/$label.stackprof"
+  args+=(--require "$PWD/docs/profile_models.rb")
+fi
+if [[ ${VERIFY_SETUP:-0} == 1 ]]; then
+  args+=(--require "$PWD/docs/verify_model_setup.rb")
+fi
+{
+  time -p bundle exec rspec spec/models --seed "$seed" --profile 15 \
+    --format progress --format json --out "tmp/rspec-profile/$label.json" "${args[@]}"
+} > "tmp/rspec-profile/$label.log" 2>&1
