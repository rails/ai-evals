diff --git a/spec/support/model_performance.rb b/spec/support/model_performance.rb
new file mode 100644
index 0000000..9bc7586
--- /dev/null
+++ b/spec/support/model_performance.rb
@@ -0,0 +1,28 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # Most model specs need jobs to be enqueued, not executed. Sidekiq's block
+  # API restores the previous mode, including when setup or an example fails.
+  config.around :each, type: :model do |example|
+    Sidekiq.testing!(example.metadata.fetch(:sidekiq, :fake)) { example.run }
+  end
+
+  # SQL debug logging also computes a cleaned caller backtrace for every query.
+  # Keep warnings/errors, and restore levels even when an example raises. Do not
+  # change logging for other spec types or examples explicitly testing logging.
+  config.around :each, type: :model do |example|
+    if example.metadata[:verbose_logging]
+      example.run
+    else
+      loggers = [Rails.logger, ActiveRecord::Base.logger].compact.uniq
+      levels = loggers.index_with(&:level)
+
+      begin
+        loggers.each { |logger| logger.level = Logger::WARN }
+        example.run
+      ensure
+        levels.each { |logger, level| logger.level = level }
+      end
+    end
+  end
+end
diff --git a/spec/support/request_performance.rb b/spec/support/request_performance.rb
new file mode 100644
index 0000000..b0cc084
--- /dev/null
+++ b/spec/support/request_performance.rb
@@ -0,0 +1,27 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # Most requests need enqueueing, not inline execution of unrelated workers.
+  # Tag worker-dependent setup/examples with sidekiq: :inline.
+  config.around :each, type: :request do |example|
+    Sidekiq.testing!(example.metadata.fetch(:sidekiq, :fake)) { example.run }
+  end
+
+  # Request setup and rendering generate substantial incidental debug output.
+  # Keep warnings/errors and restore levels even when setup or an example fails.
+  config.around :each, type: :request do |example|
+    if example.metadata[:verbose_logging]
+      example.run
+    else
+      loggers = [Rails.logger, ActiveRecord::Base.logger].compact.uniq
+      levels = loggers.index_with(&:level)
+
+      begin
+        loggers.each { |logger| logger.level = Logger::WARN }
+        example.run
+      ensure
+        levels.each { |logger, level| logger.level = level }
+      end
+    end
+  end
+end
