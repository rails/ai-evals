--- /dev/null
+++ b/docs/profile_models.rb
@@ -0,0 +1,16 @@
+# frozen_string_literal: true
+
+# Optional instrumentation for docs/profile-models.sh, not loaded by normal specs.
+require 'stackprof'
+require 'rspec/core'
+
+RSpec.configure do |config|
+  config.before(:suite) do
+    StackProf.start(mode: :cpu, out: ENV.fetch('MODEL_PROFILE_OUTPUT'))
+  end
+
+  config.after(:suite) do
+    StackProf.stop
+    StackProf.results
+  end
+end
diff --git a/docs/verify_model_setup.rb b/docs/verify_model_setup.rb
new file mode 100644
index 0000000..29efff1
--- /dev/null
+++ b/docs/verify_model_setup.rb
@@ -0,0 +1,26 @@
+# frozen_string_literal: true
+
+# Load via --require before the spec files so this hook wraps their support hooks.
+require 'rspec/core'
+
+RSpec.configure do |config|
+  config.before :each, type: :model do |example|
+    mode = example.metadata.fetch(:sidekiq, :fake)
+    raise "Wrong Sidekiq mode for #{example.id}" unless Sidekiq::Testing.public_send("#{mode == :disable ? :disabled : mode}?")
+
+    unless example.metadata[:verbose_logging]
+      loggers = [Rails.logger, ActiveRecord::Base.logger].compact.uniq
+      raise "Model logging was not silenced for #{example.id}" unless loggers.all? { |logger| logger.level >= Logger::WARN }
+    end
+  end
+
+  config.around :each, type: :model do |example|
+    levels = [Rails.logger, ActiveRecord::Base.logger].compact.uniq.index_with(&:level)
+    mode = [Sidekiq::Testing.fake?, Sidekiq::Testing.inline?, Sidekiq::Testing.disabled?]
+
+    example.run
+
+    raise "Logger levels leaked from #{example.id}" unless levels.all? { |logger, level| logger.level == level }
+    raise "Sidekiq mode leaked from #{example.id}" unless mode == [Sidekiq::Testing.fake?, Sidekiq::Testing.inline?, Sidekiq::Testing.disabled?]
+  end
+end
