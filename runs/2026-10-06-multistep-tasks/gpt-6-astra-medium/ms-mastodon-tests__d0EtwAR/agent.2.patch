new file mode 100755
index 0000000..54ca50c
--- /dev/null
+++ b/docs/profile-requests.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+# Run only request specs; pass a label and optionally an RSpec random seed.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+label=${1:-requests}
+seed=${2:-12345}
+mkdir -p tmp/rspec-profile
+args=()
+if [[ ${PROFILE:-0} == 1 ]]; then
+  export REQUEST_PROFILE_OUTPUT="$PWD/tmp/rspec-profile/$label.stackprof"
+  args+=(--require "$PWD/docs/profile_requests.rb")
+fi
+if [[ ${VERIFY_SETUP:-0} == 1 ]]; then
+  args+=(--require "$PWD/docs/verify_request_setup.rb")
+fi
+{
+  time -p bundle exec rspec spec/requests --seed "$seed" --profile 15 \
+    --format progress --format json --out "tmp/rspec-profile/$label.json" "${args[@]}"
+} > "tmp/rspec-profile/$label.log" 2>&1
