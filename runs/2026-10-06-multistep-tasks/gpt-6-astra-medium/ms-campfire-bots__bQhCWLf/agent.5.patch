diff --git a/app/models/user/bot/safety.rb b/app/models/user/bot/safety.rb
new file mode 100644
index 0000000..e4b9b22
--- /dev/null
+++ b/app/models/user/bot/safety.rb
@@ -0,0 +1,81 @@
+module User::Bot::Safety
+  extend ActiveSupport::Concern
+
+  MESSAGE_LIMIT = 10
+  MESSAGE_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  class Suspended < StandardError; end
+
+  class RateLimited < StandardError
+    attr_reader :retry_after
+
+    def initialize(retry_after)
+      @retry_after = retry_after
+      super("Bot posting cooldown")
+    end
+  end
+
+  # The block creates a message, or returns nil for an invalid posting request.
+  # Serialize the check, accounting, and creation across API requests and jobs.
+  def with_bot_posting
+    result = with_lock do
+      now = Time.current
+
+      if !active?
+        Suspended.new
+      elsif bot_cooldown_until && bot_cooldown_until > now
+        increment(:bot_cooldown_attempts)
+        if bot_cooldown_attempts >= COOLDOWN_ATTEMPT_LIMIT
+          suspend_bot("Flooding: five posting attempts during a cooldown.")
+          Suspended.new
+        else
+          save!
+          RateLimited.new((bot_cooldown_until - now).ceil)
+        end
+      else
+        timestamps = bot_message_timestamps.select { |timestamp| timestamp > (now - MESSAGE_WINDOW).to_f }
+        if timestamps.size >= MESSAGE_LIMIT
+          update! bot_cooldown_until: now + COOLDOWN, bot_cooldown_attempts: 0
+          RateLimited.new(COOLDOWN.to_i)
+        elsif message = yield
+          update! bot_message_timestamps: timestamps + [ now.to_f ], bot_cooldown_until: nil, bot_cooldown_attempts: 0
+          message
+        end
+      end
+    end
+
+    # Raise only after committing cooldown/suspension changes.
+    raise result if result.is_a?(StandardError)
+    result
+  end
+
+  def record_bot_webhook_delivery(success:)
+    with_lock do
+      if active?
+        self.bot_webhook_failures = success ? 0 : bot_webhook_failures + 1
+        if bot_webhook_failures >= WEBHOOK_FAILURE_LIMIT
+          suspend_bot("Failing webhooks: ten consecutive failed deliveries.")
+        else
+          save!
+        end
+      end
+    end
+  end
+
+  def reactivate_bot
+    with_lock do
+      if bot? && suspended?
+        update! status: :active, bot_suspension_reason: nil, bot_message_timestamps: [],
+          bot_cooldown_until: nil, bot_cooldown_attempts: 0, bot_webhook_failures: 0
+      end
+    end
+  end
+
+  private
+    def suspend_bot(reason)
+      update! status: :suspended, bot_suspension_reason: reason
+    end
+end
