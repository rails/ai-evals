+    assert_equal User.active.where.not(role: :bot).ids.sort, room.users.where.not(role: :bot).ids.sort
+  end
+
+  test "adding a bot to an existing open room sends one joined event" do
+    bot = users(:jz).created_bots.create! name: "Selective Bot", webhook_url: "https://bot.example/joined"
+    assert_enqueued_jobs 1, only: Room::DeliverBotWebhookJob do
