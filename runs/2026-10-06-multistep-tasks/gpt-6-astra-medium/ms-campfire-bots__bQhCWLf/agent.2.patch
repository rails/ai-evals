diff --git a/test/models/bot_webhook_test.rb b/test/models/bot_webhook_test.rb
new file mode 100644
index 0000000..c541050
--- /dev/null
+++ b/test/models/bot_webhook_test.rb
@@ -0,0 +1,175 @@
+require "test_helper"
+
+class BotWebhookTest < ActiveSupport::TestCase
+  include Rails.application.routes.url_helpers
+
+  setup do
+    @room = rooms(:hq)
+    @bot = users(:jz).created_bots.create! name: "Deploy Bot", webhook_url: "https://bot.example/mention"
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example").returns("93.184.216.34")
+  end
+
+  test "mentions enqueue delivery without calling the webhook during message creation" do
+    assert_enqueued_with job: Message::DeliverBotWebhookJob do
+      @room.messages.create! creator: users(:david), body: command
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "callback includes the command, full HTML and the bot's own reply path" do
+    message = @room.messages.create! creator: users(:david), body: command
+    callback = stub_request(:post, @bot.webhook_url).with do |request|
+      payload = JSON.parse(request.body)
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal "mention", payload["event"]
+      assert_equal({ "id" => users(:david).id, "name" => "David" }, payload["author"])
+      assert_equal @room.id, payload.dig("room", "id")
+      assert_equal @room.name, payload.dig("room", "name")
+      assert_equal bot_room_messages_path(@room, @bot.bot_code), payload.dig("room", "reply_to")
+      assert_equal message.id, payload.dig("message", "id")
+      assert_equal "restart the build please", payload.dig("message", "body", "text")
+      assert_equal message.body.to_s, payload.dig("message", "body", "html")
+      assert_equal room_at_message_path(@room, message.id), payload.dig("message", "link")
+      true
+    end.to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      Message::DeliverBotWebhookJob.perform_now(@bot, message)
+    end
+    assert_requested callback
+  end
+
+  test "plain text responses are escaped, preserve line breaks, and broadcast as the bot" do
+    message = @room.messages.create! creator: users(:david), body: command
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "<b>Done</b>\nNext step")
+    Message.any_instance.expects(:broadcast_create).once
+
+    assert_difference -> { @room.messages.count }, 1 do
+      Message::DeliverBotWebhookJob.perform_now(@bot, message)
+    end
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal "<b>Done</b>\nNext step", reply.plain_text_body
+    assert_not_includes reply.body.to_s, "<b>Done</b>"
+  end
+
+  test "HTML responses retain rich text and are sanitized when rendered" do
+    message = @room.messages.create! creator: users(:david), body: command
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/html" }, body: "<div><strong>Done</strong><script>alert(1)</script></div>")
+
+    assert_difference -> { @room.messages.count }, 1 do
+      Message::DeliverBotWebhookJob.perform_now(@bot, message)
+    end
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.to_s, "<strong>Done</strong>"
+    assert_not_includes reply.body.to_s, "<script>"
+  end
+
+  test "only successful nonempty text responses become messages" do
+    message = @room.messages.create! creator: users(:david), body: command
+    [ [ 204, "text/plain", "" ], [ 500, "text/plain", "Failure" ],
+      [ 302, "text/plain", "Redirect" ], [ 200, "application/json", '{"text":"Done"}' ],
+      [ 200, "text/plain", "   " ], [ 200, "text/plain", "\xFF" ],
+      [ 200, "text/plain", "x" * (Message::BotWebhook::MAX_REPLY_SIZE + 1) ] ].each do |status, content_type, body|
+      stub_request(:post, @bot.webhook_url).to_return(status: status,
+        headers: { "Content-Type" => content_type, "Location" => "https://other.example/" }, body: body)
+      assert_no_difference -> { Message.count } do
+        Message::DeliverBotWebhookJob.perform_now(@bot, message)
+      end
+    end
+    assert_not_requested :post, "https://other.example/"
+  end
+
+  test "timeouts and private network destinations do not post replies" do
+    message = @room.messages.create! creator: users(:david), body: command
+    stub_request(:post, @bot.webhook_url).to_timeout
+    assert_no_difference -> { Message.count } do
+      Message::DeliverBotWebhookJob.perform_now(@bot, message)
+    end
+
+    WebMock.reset!
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).raises(RestrictedHTTP::Violation)
+    assert_no_difference -> { Message.count } do
+      Message::DeliverBotWebhookJob.perform_now(@bot, message)
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "repeated mentions produce one callback and other mentions remain in the command" do
+    body = "#{command}<div>#{mention_attachment_for(:jz)} #{command}</div>"
+    assert_enqueued_jobs 1, only: Message::DeliverBotWebhookJob do
+      message = @room.messages.create! creator: users(:david), body: body
+      stub_request(:post, @bot.webhook_url).with do |request|
+        text = JSON.parse(request.body).dig("message", "body", "text")
+        assert_not_includes text, "@Deploy Bot"
+        assert_includes text, "@JZ"
+        true
+      end.to_return(status: 204)
+      Message::DeliverBotWebhookJob.perform_now(@bot, message)
+      assert_includes message.reload.plain_text_body, "@Deploy Bot"
+    end
+  end
+
+  test "several bots receive their own callback" do
+    other = users(:jz).created_bots.create! name: "Other Bot", webhook_url: "https://other.example/mention"
+    assert_enqueued_jobs 2, only: Message::DeliverBotWebhookJob do
+      @room.messages.create! creator: users(:david), body: "#{command}<action-text-attachment sgid=\"#{other.attachable_sgid}\"></action-text-attachment>"
+    end
+  end
+
+  test "ordinary messages, edits, and bot responses do not trigger callbacks" do
+    assert_no_enqueued_jobs only: Message::DeliverBotWebhookJob do
+      message = @room.messages.create! creator: users(:david), body: "Hello @Deploy Bot"
+      message.update! body: command
+      @room.messages.create! creator: @bot, body: command
+    end
+  end
+
+  test "bots with no webhook, inactive bots, and nonmembers are not notified" do
+    @bot.update! webhook_url: ""
+    assert_no_enqueued_jobs only: Message::DeliverBotWebhookJob do
+      @room.messages.create! creator: users(:david), body: command
+    end
+    @bot.update! webhook_url: "https://bot.example/mention", status: :deactivated
+    assert_no_enqueued_jobs only: Message::DeliverBotWebhookJob do
+      @room.messages.create! creator: users(:david), body: command
+    end
+    @bot.update! status: :active
+    @bot.memberships.where(room: @room).delete_all
+    assert_no_enqueued_jobs only: Message::DeliverBotWebhookJob do
+      @room.messages.create! creator: users(:david), body: command
+    end
+  end
+
+  test "queued delivery rechecks webhook, status, and room membership" do
+    message = @room.messages.create! creator: users(:david), body: command
+    @bot.update! webhook_url: ""
+    Message::DeliverBotWebhookJob.perform_now(@bot, message)
+    @bot.update! webhook_url: "https://bot.example/mention", status: :deactivated
+    Message::DeliverBotWebhookJob.perform_now(@bot, message)
+    @bot.update! status: :active
+    @bot.memberships.where(room: @room).delete_all
+    Message::DeliverBotWebhookJob.perform_now(@bot, message)
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "queued callbacks for deleted messages are discarded" do
+    message = @room.messages.create! creator: users(:david), body: command
+    message.destroy!
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: Message::DeliverBotWebhookJob
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  private
+
+
+    def command
+      "<div><action-text-attachment sgid=\"#{@bot.attachable_sgid}\"></action-text-attachment> restart the build please</div>"
+    end
+end
