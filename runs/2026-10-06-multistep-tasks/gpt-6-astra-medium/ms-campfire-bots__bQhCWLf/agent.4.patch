+    assert_select "a", text: "Add a chat bot"
+    get new_bot_url
+    assert_response :success
+    assert_difference -> { User.bot.count } do
+      post bots_url, params: { bot: { name: "Admin bot" } }
+    end
+    assert_redirected_to bots_url
