+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,247 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+    sign_in :jz
+  end
+
+  test "owners see suspended bots and the reason but cannot reactivate them" do
+    bot = users(:jz).created_bots.create! name: "Stopped bot"
+    10.times { bot.record_bot_webhook_delivery(success: false) }
+    get bots_url
+    assert_select "li", text: /Stopped bot/ do
+      assert_select "strong", text: "Suspended"
+      assert_select "p", text: /ten consecutive failed deliveries/
+      assert_select "button", text: "Reactivate", count: 0
+    end
+    post reactivate_bot_url(bot)
+    assert_response :forbidden
+    patch bot_url(bot), params: { bot: { name: "Renamed", status: "active", bot_webhook_failures: 0 } }
+    assert_redirected_to bots_url
+    assert bot.reload.suspended?
+    assert_equal 10, bot.bot_webhook_failures
+  end
+
+  test "administrators can reactivate another owner's bot with confirmation" do
+    bot = users(:jz).created_bots.create! name: "Stopped bot"
+    bot.update! status: :suspended, bot_suspension_reason: "Flooding", bot_cooldown_until: 30.seconds.from_now,
+      bot_cooldown_attempts: 5, bot_message_timestamps: [ Time.current.to_f ]
+    sign_in :david
+    get bots_url
+    assert_select "form[action=?][data-turbo-confirm]", reactivate_bot_path(bot) do
+      assert_select "button", text: "Reactivate"
+    end
+    post reactivate_bot_url(bot)
+    assert_redirected_to bots_url
+    assert bot.reload.active?
+    assert_nil bot.bot_suspension_reason
+    assert_nil bot.bot_cooldown_until
+    assert_equal 0, bot.bot_cooldown_attempts
+    assert_empty bot.bot_message_timestamps
+    get bots_url
+    assert_select "button", text: "Reactivate", count: 0
+  end
+
+  test "reactivation cannot restore a deleted bot" do
+    bot = users(:jz).created_bots.create! name: "Deleted bot"
+    bot.deactivate
+    sign_in :david
+    assert_raises(ActiveRecord::RecordNotFound) { post reactivate_bot_url(bot) }
+    assert bot.reload.deactivated?
+  end
+
+  test "webhooks can be created, changed and removed through the labeled forms" do
+    get new_bot_url
+    assert_select 'label[for="bot_webhook_url"]', text: "Webhook URL"
+    post bots_url, params: { bot: { name: "Webhook Bot", webhook_url: "https://bot.example/mention" } }
+    assert_redirected_to bots_url
+    bot = User.bot.last
+    assert_equal "https://bot.example/mention", bot.webhook_url
+
+    get edit_bot_url(bot)
+    assert_select 'label[for="bot_webhook_url"]', text: "Webhook URL"
+    assert_select 'input[name="bot[webhook_url]"][value=?]', bot.webhook_url
+    patch bot_url(bot), params: { bot: { webhook_url: "https://bot.example/new" } }
+    assert_redirected_to bots_url
+    assert_equal "https://bot.example/new", bot.reload.webhook_url
+    patch bot_url(bot), params: { bot: { webhook_url: "" } }
+    assert_redirected_to bots_url
+    assert_nil bot.reload.webhook_url
+  end
+
+  test "all open rooms checkbox defaults off and persists on create and edit" do
+    get new_bot_url
+    assert_select "label", text: "Add to all open rooms"
+    assert_select 'input[type="checkbox"][name="bot[add_to_all_open_rooms]"]:not([checked])'
+
+    post bots_url, params: { bot: { name: "Everyone Bot", add_to_all_open_rooms: "1" } }
+    bot = User.bot.last
+    assert bot.add_to_all_open_rooms?
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+
+    get edit_bot_url(bot)
+    assert_select 'input[type="checkbox"][name="bot[add_to_all_open_rooms]"][checked]'
+    patch bot_url(bot), params: { bot: { add_to_all_open_rooms: "0" } }
+    assert_redirected_to bots_url
+    assert_not bot.reload.add_to_all_open_rooms?
+    assert_equal Rooms::Open.ids.sort, bot.rooms.ids.sort
+    patch bot_url(bot), params: { bot: { add_to_all_open_rooms: "1" } }
+    assert bot.reload.add_to_all_open_rooms?
+  end
+
+  test "webhooks must use HTTP or HTTPS" do
+    [ "file:///etc/passwd", "javascript:alert(1)", "https://", "not a URL", "https://user:password@example.com/" ].each do |url|
+      assert_no_difference -> { User.bot.count } do
+        post bots_url, params: { bot: { name: "Webhook Bot", webhook_url: url } }
+      end
+      assert_response :unprocessable_entity
+      assert_select 'label[for="bot_webhook_url"]', text: "Webhook URL"
+    end
+  end
+
+  test "members can create and manage their bots" do
+    get edit_account_url
+    assert_select "a[href=?]", bots_path, text: "Set up chat bots"
+
+    get new_bot_url
+    assert_response :success
+    assert_select "label", text: "Name the bot"
+
+    assert_difference -> { User.bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+    bot = User.bot.last
+    assert_equal users(:jz), bot.creator
+    assert_redirected_to bots_url
+    assert_empty bot.rooms
+
+    get bots_url
+    assert_select "li" do
+      assert_select "a", text: "Edit Deploy Bot"
+      assert_select "input[readonly][value=?]", bot.bot_code
+    end
+    assert_equal "no-store", response.headers["Cache-Control"]
+
+    patch bot_url(bot), params: { bot: { name: "Release Bot", role: "administrator", bot_code: "guessable" } }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+    assert bot.bot?
+    assert_not_equal "guessable", bot.bot_code
+
+    get edit_bot_url(bot)
+    assert_select "button", text: "Delete this chat bot"
+    assert_select "form[data-turbo-confirm]"
+
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+  end
+
+  test "avatars can be uploaded and replaced without changing the code" do
+    post bots_url, params: { bot: { name: "Picture Bot", avatar: fixture_file_upload("earth.png", "image/png") } }
+    bot = User.bot.last
+    code = bot.bot_code
+    assert bot.avatar.attached?
+    assert_equal "earth.png", bot.avatar.filename.to_s
+    get edit_bot_url(bot)
+    assert_response :success
+
+    patch bot_url(bot), params: { bot: { avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+    assert_redirected_to bots_url
+    assert_equal "moon.jpg", bot.reload.avatar.filename.to_s
+    assert_equal code, bot.bot_code
+
+    post bots_url, params: { bot: { name: "", avatar: fixture_file_upload("earth.png", "image/png") } }
+    assert_response :unprocessable_entity
+  end
+
+  test "non-bots cannot be managed through bot routes" do
+    assert_raises ActiveRecord::RecordNotFound do
+      get edit_bot_url(users(:jz))
+    end
+    sign_in :david
+    assert_raises ActiveRecord::RecordNotFound do
+      delete bot_url(users(:jz))
+    end
+  end
+
+  test "deleting a bot preserves its messages" do
+    bot = users(:jz).created_bots.create! name: "History Bot"
+    rooms(:hq).memberships.grant_to(bot)
+    message = rooms(:hq).messages.create! creator: bot, body: "History"
+    delete bot_url(bot)
+    assert_equal "History", message.reload.plain_text_body
+    assert_equal "History Bot", message.creator.name
+    get bots_url
+    assert_select "input[value=?]", bot.bot_code, count: 0
+  end
+
+  test "name is required" do
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: " " } }
+    end
+    assert_response :unprocessable_entity
+    assert_select "label", text: "Name the bot"
+  end
+
+  test "only owners and administrators can see or manage bots" do
+    bot = User.create! name: "Private Bot", role: :bot, creator: users(:kevin)
+    get bots_url
+    assert_select "input[value=?]", bot.bot_code, count: 0
+    assert_raises ActiveRecord::RecordNotFound do
+      get edit_bot_url(bot)
+    end
+    assert_raises ActiveRecord::RecordNotFound do
+      patch bot_url(bot), params: { bot: { name: "Hijacked" } }
+    end
+    assert_raises ActiveRecord::RecordNotFound do
+      delete bot_url(bot)
+    end
+
+    sign_in :david
+    get bots_url
+    assert_select "input[value=?]", bot.bot_code
+    patch bot_url(bot), params: { bot: { name: "Managed" } }
+    assert_redirected_to bots_url
+    assert_equal "Managed", bot.reload.name
+  end
+
+  test "members at the limit cannot access creation or submit a stale form" do
+    accounts(:signal).update! settings: { bots_per_member: 1 }
+    get new_bot_url
+    assert_response :success
+    bot = users(:jz).created_bots.create! name: "Last bot"
+
+    get bots_url
+    assert_select "a", text: "Add a chat bot", count: 0
+    assert_select "p", text: /reached the limit/
+    get new_bot_url
+    assert_redirected_to bots_url
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { bot: { name: "Blocked", creator_id: users(:david).id, role: "administrator" } }
+    end
+    assert_response :unprocessable_entity
+    assert_select '[role="alert"]', text: /reached the limit/
+
+    delete bot_url(bot)
+    get bots_url
+    assert_select "a", text: "Add a chat bot"
+    post bots_url, params: { bot: { name: "Replacement" } }
+    assert_redirected_to bots_url
+  end
+
