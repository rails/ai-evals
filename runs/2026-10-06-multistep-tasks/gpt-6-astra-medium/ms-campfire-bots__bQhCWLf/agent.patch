diff --git a/app/models/bot_webhook.rb b/app/models/bot_webhook.rb
new file mode 100644
index 0000000..bfe96fa
--- /dev/null
+++ b/app/models/bot_webhook.rb
@@ -0,0 +1,75 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class BotWebhook
+  include Rails.application.routes.url_helpers
+
+  MAX_REPLY_SIZE = 1.megabyte
+
+  def initialize(bot, room)
+    @bot, @room = bot, room
+  end
+
+  def deliver
+    return unless @bot.reload.active? && @bot.webhook_url.present?
+
+    url = URI.parse(@bot.webhook_url)
+    ip = RestrictedHTTP::PrivateNetworkGuard.resolve(url.host)
+
+    Net::HTTP.start(url.host, url.port, nil, ipaddr: ip, use_ssl: url.scheme == "https",
+      open_timeout: 5, read_timeout: 10, write_timeout: 10) do |http|
+      http.max_retries = 0
+      request = Net::HTTP::Post.new(url, "Content-Type" => "application/json")
+      request.body = payload.to_json
+      http.request(request) do |response|
+        if response.is_a?(Net::HTTPSuccess)
+          body = read_reply(response) if response.is_a?(Net::HTTPOK) && response.content_type.in?(%w[ text/plain text/html ])
+          @bot.record_bot_webhook_delivery(success: true)
+          post_reply(body) if body
+        else
+          @bot.record_bot_webhook_delivery(success: false)
+        end
+
+        # Exit the request too, so Net::HTTP doesn't drain an ignored or oversized body.
+        return
+      end
+    end
+  rescue User::Bot::Safety::RateLimited, User::Bot::Safety::Suspended
+    # Delivery succeeded, but this reply is not allowed to post.
+  rescue RestrictedHTTP::Violation, Surfguard::Unresolvable, SocketError, SystemCallError,
+    Timeout::Error, IOError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, URI::InvalidURIError => error
+    @bot.record_bot_webhook_delivery(success: false)
+    # Don't log URLs or payloads: they may contain webhook secrets and bot credentials.
+    Rails.logger.warn "Bot webhook delivery failed for bot #{@bot.id}: #{error.class}"
+  end
+
+  private
+    def room_payload
+      { id: @room.id, name: @room.name, reply_to: bot_room_messages_path(@room, @bot.bot_code) }
+    end
+
+    def read_reply(response)
+      return if response.content_length.to_i > MAX_REPLY_SIZE
+
+      body = +""
+      response.read_body do |chunk|
+        return if body.bytesize + chunk.bytesize > MAX_REPLY_SIZE
+        body << chunk
+      end
+      body.force_encoding(Encoding::UTF_8)
+      return unless body.valid_encoding? && body.present?
+
+      if response.content_type == "text/plain"
+        body = ERB::Util.html_escape(body).gsub(/\r\n|\n|\r/, "<br>")
+      end
+
+      body
+    end
+
+    def post_reply(body)
+      reply = @bot.with_bot_posting do
+        @room.messages.create! creator: @bot, body: body
+      end
+      reply.broadcast_create
+    end
+end
