diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..e8e680f
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,53 @@
+module User::Bot
+  extend ActiveSupport::Concern
+  include User::Bot::Safety
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :created_bots, -> { bot }, class_name: "User", foreign_key: :creator_id
+
+    after_save_commit :join_all_open_rooms, if: -> { bot? && active? && add_to_all_open_rooms? && saved_change_to_add_to_all_open_rooms? }
+
+    before_validation :set_bot_code, on: :create, if: :bot?
+    validates :name, presence: true, if: :bot?
+    validates :creator, presence: true, if: :bot?
+    validate :creator_has_capacity_for_bot, on: :create, if: :bot?
+    normalizes :webhook_url, with: ->(url) { url.strip.presence }
+    validate :webhook_url_is_http, if: -> { bot? && webhook_url.present? }
+
+    # Bots never sign in with a password, but users require a password digest.
+    before_validation :set_bot_password, on: :create, if: :bot?
+  end
+
+  def can_create_bot?
+    administrator? || created_bots.where(status: %i[ active suspended ]).count < Current.account.settings.bots_per_member
+  end
+
+  private
+    def creator_has_capacity_for_bot
+      if creator && !creator.can_create_bot?
+        errors.add :base, "You've reached the limit of bots per member."
+      end
+    end
+
+    def join_all_open_rooms
+      Rooms::Open.find_each { |room| room.memberships.grant_to(self) }
+    end
+
+    def webhook_url_is_http
+      url = URI.parse(webhook_url)
+      unless url.is_a?(URI::HTTP) && url.host.present? && url.userinfo.nil? && url.fragment.nil?
+        errors.add :webhook_url, "must be an HTTP or HTTPS URL without credentials or a fragment"
+      end
+    rescue URI::InvalidURIError
+      errors.add :webhook_url, "must be a valid HTTP or HTTPS URL"
+    end
+
+    def set_bot_code
+      self.bot_code ||= SecureRandom.base58(32)
+    end
+
+    def set_bot_password
+      self.password = SecureRandom.base58(48) if password_digest.blank?
+    end
+end
diff --git a/app/models/user/bot/safety.rb b/app/models/user/bot/safety.rb
new file mode 100644
index 0000000..e4b9b22
--- /dev/null
+++ b/app/models/user/bot/safety.rb
@@ -0,0 +1,81 @@
+module User::Bot::Safety
+  extend ActiveSupport::Concern
+
+  MESSAGE_LIMIT = 10
+  MESSAGE_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  class Suspended < StandardError; end
+
+  class RateLimited < StandardError
+    attr_reader :retry_after
+
+    def initialize(retry_after)
+      @retry_after = retry_after
+      super("Bot posting cooldown")
+    end
+  end
+
+  # The block creates a message, or returns nil for an invalid posting request.
+  # Serialize the check, accounting, and creation across API requests and jobs.
+  def with_bot_posting
+    result = with_lock do
+      now = Time.current
+
+      if !active?
+        Suspended.new
+      elsif bot_cooldown_until && bot_cooldown_until > now
+        increment(:bot_cooldown_attempts)
+        if bot_cooldown_attempts >= COOLDOWN_ATTEMPT_LIMIT
+          suspend_bot("Flooding: five posting attempts during a cooldown.")
+          Suspended.new
+        else
+          save!
+          RateLimited.new((bot_cooldown_until - now).ceil)
+        end
+      else
+        timestamps = bot_message_timestamps.select { |timestamp| timestamp > (now - MESSAGE_WINDOW).to_f }
+        if timestamps.size >= MESSAGE_LIMIT
+          update! bot_cooldown_until: now + COOLDOWN, bot_cooldown_attempts: 0
+          RateLimited.new(COOLDOWN.to_i)
+        elsif message = yield
+          update! bot_message_timestamps: timestamps + [ now.to_f ], bot_cooldown_until: nil, bot_cooldown_attempts: 0
+          message
+        end
+      end
+    end
+
+    # Raise only after committing cooldown/suspension changes.
+    raise result if result.is_a?(StandardError)
+    result
+  end
+
+  def record_bot_webhook_delivery(success:)
+    with_lock do
+      if active?
+        self.bot_webhook_failures = success ? 0 : bot_webhook_failures + 1
+        if bot_webhook_failures >= WEBHOOK_FAILURE_LIMIT
+          suspend_bot("Failing webhooks: ten consecutive failed deliveries.")
+        else
+          save!
+        end
+      end
+    end
+  end
+
+  def reactivate_bot
+    with_lock do
+      if bot? && suspended?
+        update! status: :active, bot_suspension_reason: nil, bot_message_timestamps: [],
+          bot_cooldown_until: nil, bot_cooldown_attempts: 0, bot_webhook_failures: 0
+      end
+    end
+  end
+
+  private
+    def suspend_bot(reason)
+      update! status: :suspended, bot_suspension_reason: reason
+    end
+end
