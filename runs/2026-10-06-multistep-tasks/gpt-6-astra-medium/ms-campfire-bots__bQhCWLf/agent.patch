+require "test_helper"
+
+class RoomBotWebhookTest < ActiveSupport::TestCase
+  include Rails.application.routes.url_helpers
+
+  setup do
+    @room = rooms(:watercooler)
+    @bot = users(:jz).created_bots.create! name: "Welcome Bot", webhook_url: "https://bot.example/joined"
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example").returns("93.184.216.34")
+  end
+
+  test "joined is asynchronous and contains only the event and room" do
+    callback = stub_request(:post, @bot.webhook_url).with(
+      headers: { "Content-Type" => "application/json" },
+      body: { event: "joined", room: { id: @room.id, name: @room.name,
+        reply_to: bot_room_messages_path(@room, @bot.bot_code) } }.to_json
+    ).to_return(status: 204)
+
+    @room.memberships.grant_to([ @bot, @bot ])
+    assert_not_requested callback
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: Room::DeliverBotWebhookJob
+    end
+    assert_requested callback, times: 1
+  end
+
+  test "a joined text reply is escaped, attributed to the bot and broadcast" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/plain" }, body: "Hello <everyone>!\nI'm here")
+    Message.any_instance.expects(:broadcast_create).once
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: Room::DeliverBotWebhookJob do
+        @room.memberships.grant_to(@bot)
+      end
+    end
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal "Hello <everyone>!\nI'm here", reply.plain_text_body
+    assert_includes reply.body.to_s, "&lt;everyone&gt;"
+  end
+
+  test "a joined HTML reply uses normal rich text sanitization" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/html" }, body: "<div><strong>Hello</strong><script>alert(1)</script></div>")
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: Room::DeliverBotWebhookJob do
+        @room.memberships.grant_to(@bot)
+      end
+    end
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.to_s, "<strong>Hello</strong>"
+    assert_not_includes reply.body.to_s, "<script>"
+  end
+
+  test "delivery rechecks status and webhook presence" do
+    membership = @bot.memberships.create! room: @room
+    @bot.update! status: :deactivated
+    perform_enqueued_jobs only: Room::DeliverBotWebhookJob
+    @bot.update! status: :active, webhook_url: nil
+    Room::DeliverBotWebhookJob.perform_now(membership.reload)
+    assert_not_requested :post, "https://bot.example/joined"
+  end
+
+  test "removed memberships discard queued joins even after a new membership is granted" do
+    @room.memberships.grant_to(@bot)
+    @bot.memberships.destroy_all
+    @room.memberships.grant_to(@bot)
+    callback = stub_request(:post, @bot.webhook_url).to_return(status: 204)
+    perform_enqueued_jobs only: Room::DeliverBotWebhookJob
+    assert_requested callback, times: 1
+  end
+
+  test "deleted rooms discard queued joins" do
+    @room.memberships.grant_to(@bot)
+    @room.destroy!
+    perform_enqueued_jobs only: Room::DeliverBotWebhookJob
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "direct conversations never deliver even if explicitly queued" do
+    room = Rooms::Direct.create_for({ creator: users(:jz) }, users: [ users(:jz), @bot ])
+    Room::DeliverBotWebhookJob.perform_now(room.memberships.find_by!(user: @bot))
+    assert_not_requested :post, @bot.webhook_url
+  end
+end
diff --git a/test/models/user/bot_safety_test.rb b/test/models/user/bot_safety_test.rb
new file mode 100644
index 0000000..aa4b2bb
--- /dev/null
+++ b/test/models/user/bot_safety_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class User::BotSafetyTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:jz).created_bots.create! name: "Deploy Bot"
+    @room = rooms(:watercooler)
+    @room.memberships.grant_to(@bot)
+  end
+
+  test "the message window rolls rather than resetting at fixed intervals" do
+    freeze_time do
+      5.times { post_message }
+      travel 6.seconds
+      5.times { post_message }
+      travel 4.seconds
+      5.times { post_message }
+      assert_raises(User::Bot::Safety::RateLimited) { post_message }
+      assert_equal 15, @bot.messages.count
+    end
+  end
+
+  test "limits span rooms and survive deletion of messages and reloading the bot" do
+    freeze_time do
+      10.times { post_message }
+      @bot.messages.destroy_all
+      @bot = User.find(@bot.id)
+      assert_raises(User::Bot::Safety::RateLimited) { post_message(room: rooms(:hq)) }
+      assert_equal 0, @bot.messages.count
+    end
+  end
+
+  test "cooldown attempts reset for the next cooldown and retry times round up" do
+    freeze_time do
+      10.times { post_message }
+      assert_raises(User::Bot::Safety::RateLimited) { post_message }
+      3.times { assert_raises(User::Bot::Safety::RateLimited) { post_message } }
+      travel 29.5.seconds, with_usec: true
+      error = assert_raises(User::Bot::Safety::RateLimited) { post_message }
+      assert_equal 1, error.retry_after
+      travel 0.5.seconds, with_usec: true
+      10.times { post_message }
+      assert_raises(User::Bot::Safety::RateLimited) { post_message }
+      assert_equal 0, @bot.reload.bot_cooldown_attempts
+      error = assert_raises(User::Bot::Safety::RateLimited) { post_message }
+      assert_equal 30, error.retry_after
+      assert @bot.reload.active?
+    end
+  end
+
+  test "invalid and rolled back posts do not use a message slot" do
+    freeze_time do
+      10.times { assert_nil @bot.with_bot_posting { nil } }
+      assert_raises(ActiveRecord::RecordInvalid) do
+        @bot.with_bot_posting { Message.create! }
+      end
+      assert_empty @bot.reload.bot_message_timestamps
+      10.times { post_message }
+      assert_equal 10, @bot.messages.count
+    end
+  end
+
+  test "limits are per bot" do
+    freeze_time do
+      10.times { post_message }
+      assert_raises(User::Bot::Safety::RateLimited) { post_message }
+      other = users(:jz).created_bots.create! name: "Other bot"
+      assert_difference -> { Message.count } do
+        other.with_bot_posting { @room.messages.create! creator: other, body: "Hello" }
+      end
+    end
+  end
+
+  test "suspension retains rooms messages and owner quota and reactivation clears safety state" do
+    accounts(:signal).update! settings: { bots_per_member: 1 }
+    post_message
+    10.times { @bot.record_bot_webhook_delivery(success: false) }
+    assert @bot.reload.suspended?
+    assert_match /webhooks/, @bot.bot_suspension_reason
+    assert_not users(:jz).can_create_bot?
+    assert_equal [ @room.id ], @bot.rooms.ids
+    assert_equal 1, @bot.messages.count
+    assert_raises(User::Bot::Safety::Suspended) { post_message }
+
+    @bot.reactivate_bot
+    assert @bot.reload.active?
+    assert_nil @bot.bot_suspension_reason
+    assert_nil @bot.bot_cooldown_until
+    assert_equal 0, @bot.bot_cooldown_attempts
+    assert_equal 0, @bot.bot_webhook_failures
+    assert_empty @bot.bot_message_timestamps
+    assert_equal 1, @bot.messages.count
+    assert_equal [ @room.id ], @bot.rooms.ids
+    assert_not users(:jz).can_create_bot?
+    post_message
+  end
+
+  private
+    def post_message(room: @room)
+      @bot.with_bot_posting { room.messages.create! creator: @bot, body: "Hello" }
+    end
+end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..39e5d99
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "members cannot create more than five bots by default" do
+    member = users(:jz)
+    5.times { |number| member.created_bots.create! name: "Bot #{number}" }
+
+    bot = member.created_bots.new(name: "One too many")
+    assert_no_difference -> { User.bot.count } do
+      assert_not bot.save
+    end
+    assert_includes bot.errors[:base], "You've reached the limit of bots per member."
+  end
+
+  test "the quota is per member and excludes deleted bots" do
+    accounts(:signal).update! settings: { bots_per_member: 1 }
+    member = users(:jz)
+    bot = member.created_bots.create! name: "First"
+    assert_not member.can_create_bot?
+    assert users(:kevin).created_bots.create!(name: "Someone else's bot")
+
+    bot.deactivate
+    assert member.can_create_bot?
+    assert member.created_bots.create!(name: "Replacement")
+  end
+
+  test "lowering the limit leaves existing bots editable and blocks new ones" do
+    member = users(:jz)
+    bots = 2.times.map { |number| member.created_bots.create! name: "Bot #{number}" }
+    accounts(:signal).update! settings: { bots_per_member: 1 }
+
+    assert_equal 2, member.created_bots.active.count
+    assert bots.first.update(name: "Renamed")
+    assert_not member.created_bots.new(name: "Another").save
+
+    bots.first.deactivate
+    assert_not member.can_create_bot?
+    accounts(:signal).update! settings: { bots_per_member: 2 }
+    assert member.created_bots.create!(name: "Another")
+  end
+
+  test "zero blocks members but administrators are unlimited" do
+    accounts(:signal).update! settings: { bots_per_member: 0 }
+    assert_not users(:jz).created_bots.new(name: "Blocked").save
+
+    6.times do |number|
+      assert users(:david).created_bots.create!(name: "Admin bot #{number}")
+    end
+    assert users(:david).can_create_bot?
+  end
+
+  test "bots created outside the association still respect their creator's limit" do
+    accounts(:signal).update! settings: { bots_per_member: 0 }
+    assert_raises ActiveRecord::RecordInvalid do
+      User.create! role: :bot, creator: users(:jz), name: "Blocked"
+    end
+  end
+end
diff --git a/test/system/bots_test.rb b/test/system/bots_test.rb
new file mode 100644
index 0000000..04ac1c5
--- /dev/null
+++ b/test/system/bots_test.rb
@@ -0,0 +1,104 @@
+require "application_system_test_case"
+
+class BotsTest < ApplicationSystemTestCase
+  setup do
+    sign_in "jz@37signals.com"
+  end
+
+  test "only administrators can reactivate a suspended bot after confirming" do
+    bot = users(:jz).created_bots.create! name: "Stopped Bot"
+    10.times { bot.record_bot_webhook_delivery(success: false) }
+    visit bots_path
+    assert_text "Stopped Bot"
+    assert_text "Suspended"
+    assert_text "ten consecutive failed deliveries"
+    assert_no_button "Reactivate"
+
+    Capybara.reset_sessions!
+    sign_in "david@37signals.com"
+    visit bots_path
+    dismiss_confirm { click_on "Reactivate" }
+    assert_text "Suspended"
+    assert bot.reload.suspended?
+    accept_confirm { click_on "Reactivate" }
+    assert_no_text "Suspended"
+    assert_no_button "Reactivate"
+    assert_text "Stopped Bot"
+    assert bot.reload.active?
+  end
+
+  test "creating editing and deleting a chat bot" do
+    visit edit_account_path
+    click_on "Set up chat bots"
+    click_on "Add a chat bot"
+    fill_in "Name the bot", with: "Deploy Bot"
+    fill_in "Webhook URL", with: "https://bot.example/mention"
+    assert_unchecked_field "Add to all open rooms", visible: :all
+    check "Add to all open rooms", allow_label_click: true
+    attach_file "Bot avatar", file_fixture("earth.png"), make_visible: true
+    click_on "Save changes"
+
+    assert_current_path bots_path
+    within "li", text: "Deploy Bot" do
+      assert_field "Bot code", readonly: true
+      click_on "Edit Deploy Bot"
+    end
+
+    assert_field "Webhook URL", with: "https://bot.example/mention"
+    assert_checked_field "Add to all open rooms", visible: :all
+    uncheck "Add to all open rooms", allow_label_click: true
+    fill_in "Webhook URL", with: ""
+    fill_in "Name the bot", with: "Release Bot"
+    click_on "Save changes"
+    click_on "Edit Release Bot"
+    assert_unchecked_field "Add to all open rooms", visible: :all
+    assert_field "Webhook URL", with: ""
+    assert_nil User.bot.find_by!(name: "Release Bot").webhook_url
+
+    dismiss_confirm do
+      click_on "Delete this chat bot"
+    end
+    assert_current_path edit_bot_path(User.bot.find_by!(name: "Release Bot"))
+
+    accept_confirm do
+      click_on "Delete this chat bot"
+    end
+    assert_current_path bots_path
+    assert_no_text "Release Bot"
+  end
+
+  test "members see the limit and can create again after deleting a bot" do
+    accounts(:signal).update! settings: { bots_per_member: 1 }
+    visit bots_path
+    click_on "Add a chat bot"
+    fill_in "Name the bot", with: "Only Bot"
+    click_on "Save changes"
+
+    assert_current_path bots_path
+    assert_text "reached the limit"
+    assert_no_link "Add a chat bot"
+    click_on "Edit Only Bot"
+    accept_confirm { click_on "Delete this chat bot" }
+
+    assert_current_path bots_path
+    assert_link "Add a chat bot"
+    assert_no_text "reached the limit"
+  end
+
+  test "administrators can save the bots per member setting" do
+    Capybara.reset_sessions!
+    sign_in "david@37signals.com"
+    visit edit_account_path
+    assert_field "Bots per member", with: "5"
+    within "form", text: "Bots per member" do
+      fill_in "Bots per member", with: "0"
+      click_on "Save changes"
+    end
+
+    assert_selector '.flash [role="alert"]', text: "✓", visible: :all
+    assert_field "Bots per member", with: "0"
+    assert_equal 0, accounts(:signal).reload.settings.bots_per_member
+    click_on "Set up chat bots"
+    assert_link "Add a chat bot"
+  end
+end
