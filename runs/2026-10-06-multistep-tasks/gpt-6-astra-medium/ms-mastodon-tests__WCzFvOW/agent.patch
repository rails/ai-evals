diff --git a/spec/support/model_performance.rb b/spec/support/model_performance.rb
new file mode 100644
index 0000000..ef207d6
--- /dev/null
+++ b/spec/support/model_performance.rb
@@ -0,0 +1,14 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # SQL debug output (especially query-source backtraces) is expensive across
+  # thousands of records. Keep warnings/errors and restore logging after each
+  # example, including failures. Opt in to verbose logging when debugging.
+  config.around(:each, type: :model) do |example|
+    if example.metadata[:verbose_logging]
+      example.run
+    else
+      Rails.logger.silence(Logger::WARN) { example.run }
+    end
+  end
+end
diff --git a/spec/support/request_performance.rb b/spec/support/request_performance.rb
new file mode 100644
index 0000000..f573fd7
--- /dev/null
+++ b/spec/support/request_performance.rb
@@ -0,0 +1,22 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # Request specs normally exercise the HTTP boundary, not background workers.
+  # Opt in when assertions need completed job side effects (feeds, mail, etc.).
+  # Block-scoped mode restores the caller's setting even if an example fails.
+  config.around(:each, type: :request) do |example|
+    previous_mode = Sidekiq::Testing.__test_mode
+
+    Sidekiq.testing!(example.metadata[:inline_jobs] ? :inline : :fake) do
+      if example.metadata[:verbose_logging]
+        example.run
+      else
+        Rails.logger.silence(Logger::WARN) { example.run }
+      end
+    end
+  ensure
+    # Some existing examples set the global mode without a block. Restore that
+    # fallback too, so requests cannot change the mode of another spec type.
+    Sidekiq.testing!(previous_mode)
+  end
+end
