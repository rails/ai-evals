diff --git a/spec/support/model_performance.rb b/spec/support/model_performance.rb
new file mode 100644
index 0000000..ef207d6
--- /dev/null
+++ b/spec/support/model_performance.rb
@@ -0,0 +1,14 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # SQL debug output (especially query-source backtraces) is expensive across
+  # thousands of records. Keep warnings/errors and restore logging after each
+  # example, including failures. Opt in to verbose logging when debugging.
+  config.around(:each, type: :model) do |example|
+    if example.metadata[:verbose_logging]
+      example.run
+    else
+      Rails.logger.silence(Logger::WARN) { example.run }
+    end
+  end
+end
