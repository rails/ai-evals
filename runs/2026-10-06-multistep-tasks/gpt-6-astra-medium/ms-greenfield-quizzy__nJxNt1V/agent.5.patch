new file mode 100644
index 0000000..3a9b1e7
--- /dev/null
+++ b/script/timer_smoke.rb
@@ -0,0 +1,26 @@
+# Run with RAILS_ENV=production bin/rails runner script/timer_smoke.rb
+# while bin/serve is running. Intentionally opens no game browser or state URL.
+require "net/http"
+url = URI("#{ENV.fetch('BASE_URL', 'http://127.0.0.1:3000')}/up")
+request = Net::HTTP::Get.new(url)
+request["Host"] = "conference.invalid"
+response = Net::HTTP.start(url.hostname, url.port) { |http| http.request(request) }
+raise "Readiness failed: #{response.code}" unless response.code == "200"
+
+quiz = Quiz.create!(title: "Unattended timer smoke", timer_seconds: 2)
+begin
+  quiz.questions.create!(text: "Will this close without browsers?", position: 0,
+    options: [ { text: "Yes", correct: true }, { text: "No", correct: false } ])
+  game = Game.for_quiz!(quiz)
+  game.transition!("start", 0)
+  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 8
+  until game.reload.phase == "closed"
+    raise "Worker did not expire question" if Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
+    sleep 0.1
+  end
+  raise "Unexpected revision" unless game.revision == 2
+  puts "PASS: HTTP readiness, arbitrary Host, and automatic expiry without browsers"
+ensure
+  game&.destroy!
+  quiz.destroy!
+end
diff --git a/script/timer_worker.rb b/script/timer_worker.rb
new file mode 100644
index 0000000..a1189f1
--- /dev/null
+++ b/script/timer_worker.rb
@@ -0,0 +1,9 @@
+# Started and supervised by bin/serve. No external queue or services required.
+loop do
+  begin
+    Rails.application.executor.wrap { Game.expire_due! }
+  rescue StandardError => error
+    Rails.logger.error("Timer worker: #{error.class}: #{error.message}")
+  end
+  sleep 0.25
+end
