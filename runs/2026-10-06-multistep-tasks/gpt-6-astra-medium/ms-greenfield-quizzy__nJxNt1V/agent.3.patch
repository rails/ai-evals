+module Moderate
+  class GamesController < BaseController
+    include LiveState
+    before_action :set_game, except: :create
+
+    def create
+      game = Game.for_quiz!(Quiz.find(params[:quiz_id]))
+      redirect_to moderate_game_path(game), status: :see_other
+    end
+
+    def show
+      prepare_live_state
+    end
+
+    def state
+      render_live
+    end
+
+    def transition
+      @game.transition!(params[:command], params[:revision])
+      render_live(conditional: false)
+    rescue Game::InvalidAction
+      @game.reload
+      render_live(status: :conflict, conditional: false)
+    end
+
+    def qr
+      svg = RQRCode::QRCode.new(play_url(@game.code)).as_svg(module_size: 8, offset: 32, standalone: true)
+      render body: svg, content_type: "image/svg+xml"
+    end
+
+    private
+
+    def set_game
+      @moderator = true
+      @game = Game.find(params[:id])
+    end
+  end
+end
diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
