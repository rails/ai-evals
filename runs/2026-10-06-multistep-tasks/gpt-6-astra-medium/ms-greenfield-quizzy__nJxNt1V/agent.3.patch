diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..79e8b85
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,82 @@
+class Game < ApplicationRecord
+  class InvalidAction < StandardError; end
+
+  belongs_to :quiz, optional: true
+  has_many :players, dependent: :destroy
+  has_many :answers, through: :players
+  validates :title, :code, presence: true
+  validates :phase, inclusion: { in: %w[waiting open closed ended] }
+  after_update_commit :notify_transition, if: :saved_change_to_revision?
+
+  def self.for_quiz!(quiz)
+    quiz.with_lock do
+      create!(quiz: quiz, title: quiz.title, code: SecureRandom.alphanumeric(8).upcase,
+        questions: quiz.questions.where(active: true).map { |question|
+          { text: question.text, options: question.options }
+        })
+    end
+  end
+
+  def current_question
+    questions[current_index] unless phase.in?(%w[waiting ended])
+  end
+
+  def active_players
+    players.where(last_seen_at: Player::PRESENCE_WINDOW.ago..)
+  end
+
+  # The revision makes double-clicks and stale moderator tabs harmless.
+  def transition!(command, expected_revision)
+    with_lock do
+      raise InvalidAction unless expected_revision.to_s == revision.to_s
+      case [ phase, command ]
+      when [ "waiting", "start" ]
+        self.phase = questions.empty? ? "ended" : "open"
+      when [ "open", "finish" ]
+        self.phase = "closed"
+      when [ "closed", "next" ]
+        raise InvalidAction if current_index >= questions.length - 1
+        self.current_index += 1
+        self.phase = "open"
+      when [ "closed", "end" ]
+        raise InvalidAction unless current_index == questions.length - 1
+        self.phase = "ended"
+      else
+        raise InvalidAction
+      end
+      self.revision += 1
+      save!
+    end
+  end
+
+  def join!(browser_token, name)
+    with_lock do
+      return if phase == "ended"
+      players.find_by(browser_token: browser_token) || players.create!(
+        browser_token: browser_token, name: name.to_s.strip, last_seen_at: Time.current)
+    end
+  end
+
+  def answer!(player, question_index, option_index)
+    with_lock do
+      raise InvalidAction unless player&.game_id == id && phase == "open" && question_index.to_s == current_index.to_s
+      # Strict integer parsing: never turn malformed input into option zero.
+      index = Integer(option_index.to_s, exception: false)
+      raise InvalidAction unless index && index.between?(0, current_question.fetch("options").size - 1)
+      answer = player.answers.find_or_initialize_by(question_index: current_index)
+      answer.update!(option_index: index)
+      player.record_presence!
+    end
+  end
+
+  def notify_moderator
+    ActionCable.server.broadcast("game:#{id}:moderator", { changed: true })
+  end
+
+  private
+
+  def notify_transition
+    ActionCable.server.broadcast("game:#{id}", { changed: true })
+    notify_moderator
+  end
+end
diff --git a/app/models/player.rb b/app/models/player.rb
new file mode 100644
index 0000000..cf7d093
--- /dev/null
+++ b/app/models/player.rb
@@ -0,0 +1,15 @@
+class Player < ApplicationRecord
+  PRESENCE_WINDOW = 50.seconds
+  belongs_to :game
+  has_many :answers, dependent: :destroy
+  validates :name, presence: true, length: { maximum: 80 }
+  validates :browser_token, presence: true
+  after_create_commit -> { game.notify_moderator }
+
+  def record_presence!
+    return if last_seen_at > 10.seconds.ago
+    returning = last_seen_at < PRESENCE_WINDOW.ago
+    update_columns(last_seen_at: Time.current)
+    game.notify_moderator if returning
+  end
+end
