@@ -44,8 +44,23 @@ bundle exec ruby script/production_smoke.rb
 The smoke test creates and deletes a sample quiz and saves screenshots under
 `storage/`. Override `BASE_URL` if the server is not at `http://127.0.0.1:3000`.
 
+## Live games
+
+On a quiz page, choose **Start a game**. The moderator big screen displays the
+full join URL, a locally generated QR code, and the live waiting-player count.
+Players enter **Your name** on their phones; no account is needed. Use **Start**,
+**Finish**, **Next**, and **End quiz** to run the talk. Every game has independent
+players and answers and skips inactive questions. Answers can change until
+Finish; correctness is never sent to phones early.
+
+Live updates use local Action Cable/Solid Cable with private state responses,
+reconnection, and conditional polling fallback for conference Wi-Fi. A signed
+browser cookie resumes the same player. See [live-game notes](docs/live-games.md)
+for presence semantics, privacy boundaries, and production smoke testing.
+
 ## Behavior
 
+
 - Quizzes and ordered questions are protected by HTTP Basic authentication.
 - Blank option rows are ignored; two nonblank options and at least one correct
   option are required. Invalid forms preserve the submitted rows and checkboxes.
diff --git a/app/assets/javascripts/live_game.js b/app/assets/javascripts/live_game.js
new file mode 100644
index 0000000..217aa91
--- /dev/null
+++ b/app/assets/javascripts/live_game.js
@@ -0,0 +1,128 @@
+(() => {
+  const root = document.getElementById("live-game");
+  if (!root || root.querySelector(".live-state")?.dataset.phase === "ended") return;
+  const status = document.getElementById("connection-status");
+  const csrf = document.querySelector('meta[name="csrf-token"]')?.content || "";
+  let etag = null;
+  let loading = false;
+  let saving = false;
+  let dirty = false;
+  let serial = 0;
+  let connected = false;
+  let finished = false;
+  let refreshTimer;
+
+  function apply(html) {
+    // A state check must not erase a name while somebody is typing it.
+    const template = document.createElement("template");
+    template.innerHTML = html;
+    if (root.querySelector(".join-form") && template.content.querySelector(".join-form")) return;
+    const focus = document.activeElement?.dataset.option;
+    const previous = root.querySelector(".live-state");
+    const phase = previous?.dataset.phase;
+    const question = previous?.dataset.question;
+    root.innerHTML = html;
+    const current = root.querySelector(".live-state");
+    if (current?.dataset.phase === "ended") {
+      finished = true;
+      consumer?.disconnect();
+    }
+    if (phase !== current?.dataset.phase || question !== current?.dataset.question) {
+      const heading = root.querySelector("h2, h1");
+      if (heading) { heading.tabIndex = -1; heading.focus({ preventScroll: true }); }
+    } else if (focus !== undefined) {
+      root.querySelector(`[data-option="${focus}"]`)?.focus({ preventScroll: true });
+    }
+  }
+
+  async function request(url, options = {}) {
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), 12000);
+    try {
+      const response = await fetch(url, { credentials: "same-origin", cache: "no-store", ...options, signal: controller.signal });
+      const html = response.status === 304 ? null : await response.text();
+      if (response.status !== 304 && (!response.ok && response.status !== 409)) throw new Error("Request failed");
+      if (html !== null && !html.trimStart().startsWith('<div class="live-state"')) throw new Error("Unexpected response");
+      return { response, html };
+    } finally { clearTimeout(timeout); }
+  }
+
+  async function refresh() {
+    if (finished) return;
+    if (saving || loading) { dirty = true; return; }
+    loading = true;
+    dirty = false;
+    const id = ++serial;
+    try {
+      const { response, html } = await request(root.dataset.url, {
+        headers: etag ? { "If-None-Match": etag } : {}
+      });
+      if (id !== serial) return;
+      if (html !== null) apply(html);
+      etag = response.headers.get("ETag") || etag;
+      status.textContent = connected || finished ? "" : "Connected · checking for updates";
+    } catch (_) {
+      if (id === serial) status.textContent = "Connection interrupted. Reconnecting…";
+    } finally {
+      loading = false;
+      if (dirty && !saving) scheduleRefresh();
+    }
+  }
+
+  function scheduleRefresh() {
+    if (finished || refreshTimer) return;
+    // Throttle bursts without postponing updates indefinitely during a busy vote.
+    refreshTimer = setTimeout(() => { refreshTimer = null; refresh(); }, 150 + Math.random() * 250);
+  }
+
+  root.addEventListener("submit", async (event) => {
+    const form = event.target;
+    if (!form.matches("form[data-live]")) return; // Join uses a normal, CSRF-protected form.
+    event.preventDefault();
+    if (saving) return;
+    saving = true;
+    ++serial; // Discard any older GET still in flight.
+    const body = new FormData(form);
+    root.querySelectorAll("button, input[type=submit]").forEach(button => button.disabled = true);
+    status.textContent = "Saving…";
+    try {
+      const { response, html } = await request(form.action, {
+        method: "POST", body, headers: { "X-CSRF-Token": csrf }
+      });
+      apply(html);
+      etag = null;
+      status.textContent = response.status === 409 ? "The game has moved on. Showing the latest state." : "";
+    } catch (_) {
+      status.textContent = "Could not confirm the save. Please check your answer and try again.";
+      dirty = true;
+    } finally {
+      saving = false;
+      root.querySelectorAll("button, input[type=submit]").forEach(button => button.disabled = false);
+      if (dirty) scheduleRefresh();
+    }
+  });
+
+  const consumer = window.ActionCable?.createConsumer("/cable");
+  try {
+    consumer?.subscriptions.create({ channel: "GameChannel", code: root.dataset.code, screen: root.dataset.screen }, {
+      connected() { connected = true; scheduleRefresh(); },
+      disconnected() { connected = false; if (!finished) status.textContent = "Reconnecting…"; },
+      received() { scheduleRefresh(); }
+    });
+  } catch (_) {
+    status.textContent = "Live connection unavailable. Checking for updates…";
+  }
+
+  // Low-frequency revalidation is also the presence heartbeat. It recovers missed
+  // messages, suspended tabs, server restarts and networks that block WebSockets.
+  function poll() {
+    if (finished) return;
+    const delay = connected ? (root.dataset.screen ? 5000 : 15000) : 3000;
+    setTimeout(() => { refresh(); poll(); }, delay + Math.random() * 1000);
+  }
+  poll();
+  window.addEventListener("online", scheduleRefresh);
+  document.addEventListener("visibilitychange", () => { if (!document.hidden) scheduleRefresh(); });
+  window.addEventListener("pagehide", () => consumer?.disconnect());
+  window.addEventListener("pageshow", (event) => { if (event.persisted) { consumer?.connect(); scheduleRefresh(); } });
+})();
