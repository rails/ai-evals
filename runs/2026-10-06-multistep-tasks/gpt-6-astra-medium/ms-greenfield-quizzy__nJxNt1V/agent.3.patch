diff --git a/app/channels/game_channel.rb b/app/channels/game_channel.rb
new file mode 100644
index 0000000..eea2352
--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,18 @@
+class GameChannel < ApplicationCable::Channel
+  def subscribed
+    game = Game.find_by(code: params[:code])
+    return reject unless game
+
+    # Only invalidations are broadcast, never questions, answers or correctness.
+    # Moderator notifications require a capability minted by the authenticated page.
+    if params[:screen].present?
+      return reject unless Game.find_signed(params[:screen], purpose: :screen)&.id == game.id
+      stream_from "game:#{game.id}:moderator"
+    else
+      stream_from "game:#{game.id}"
+      token = connection.browser_token
+      player = game.players.find_by(browser_token: token) if token.present?
+      stream_from "player:#{player.id}" if player
+    end
+  end
+end
diff --git a/app/controllers/concerns/live_state.rb b/app/controllers/concerns/live_state.rb
new file mode 100644
index 0000000..64e7436
--- /dev/null
+++ b/app/controllers/concerns/live_state.rb
@@ -0,0 +1,27 @@
+module LiveState
+  extend ActiveSupport::Concern
+
+  private
+
+  def prepare_live_state
+    @player&.record_presence! unless @game.phase == "ended"
+    @question = @game.current_question
+    @answer = @player&.answers&.find_by(question_index: @game.current_index)
+    if @moderator
+      active = @game.active_players
+      @player_count = active.count
+      @answer_count = @game.answers.where(player_id: active.select(:id), question_index: @game.current_index).count
+      @counts = @game.answers.where(question_index: @game.current_index).group(:option_index).count if @game.phase == "closed"
+    end
+  end
+
+  def render_live(status: :ok, conditional: true)
+    prepare_live_state
+    # Clients revalidate explicitly. No shared or persistent caches may retain phones' answers.
+    response.headers["Cache-Control"] = "private, no-cache, no-store"
+    key = [ "live-v1", @game, @moderator, @player&.id, @answer, @player_count, @answer_count, @counts, request.base_url ]
+    if !conditional || stale?(etag: key, public: false)
+      render partial: "games/state", status: status
+    end
+  end
+end
