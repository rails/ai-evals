diff --git a/app/views/games/_state.html.erb b/app/views/games/_state.html.erb
new file mode 100644
index 0000000..9fceac2
--- /dev/null
+++ b/app/views/games/_state.html.erb
@@ -0,0 +1,95 @@
+<div class="live-state" data-phase="<%= @game.phase %>" data-question="<%= @game.current_index %>">
+  <% if @game.phase == "ended" %>
+    <div class="game-finale card">
+      <p class="eyebrow"><%= @game.title %></p>
+      <h1>The quiz is over</h1>
+      <p class="meta">Thanks for playing!</p>
+    </div>
+  <% elsif !@moderator && !@player %>
+    <div class="card join-card">
+      <p class="eyebrow">You're invited</p>
+      <h1><%= @game.title %></h1>
+      <p class="meta">Join the room. Be part of the talk.</p>
+      <% if @join_error %><p class="form-errors" role="alert"><%= @join_error %></p><% end %>
+      <%= form_with url: play_path(@game.code), class: "join-form" do |form| %>
+        <div class="field">
+          <%= form.label :name, "Your name" %>
+          <%= form.text_field :name, value: params[:name], class: "input", required: true, maxlength: 80, autocomplete: "given-name" %>
+        </div>
+        <%= form.submit "Join", class: "btn btn--pink" %>
+      <% end %>
+    </div>
+  <% else %>
+    <% unless @moderator %><h1 class="player-greeting">Hi, <%= @player.name %>!</h1><% end %>
+    <% if @game.phase == "waiting" %>
+      <div class="card lobby">
+        <% if @moderator %>
+          <p class="eyebrow">Ready when you are</p>
+          <h1><%= @game.title %></h1>
+          <div class="join-instructions">
+            <img class="join-qr" src="<%= qr_moderate_game_path(@game) %>" alt="QR code to join the quiz" width="256" height="256">
+            <div><h2>Scan to join</h2><p class="join-link"><%= play_url(@game.code) %></p>
+              <p class="live-counter" aria-live="polite">Players: <%= @player_count %></p>
+            </div>
+          </div>
+          <% if @game.questions.empty? %><p class="meta">No active questions. Starting will end this game.</p><% end %>
+          <%= render "games/control", command: "start", label: "Start" %>
+        <% else %>
+          <h2><%= @game.title %></h2>
+          <p class="waiting-dot" aria-hidden="true">●</p>
+          <p class="waiting-message">Waiting for the quiz to start</p>
+          <p class="meta">Keep this page open. Questions will appear here.</p>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="live-question">
+        <p class="play-question__num">Question <%= @game.current_index + 1 %> of <%= @game.questions.length %></p>
+        <h2 class="play-question__body"><%= @question.fetch("text") %></h2>
+        <% if @moderator %>
+          <p class="live-counter" aria-live="polite">Answers: <%= @answer_count %> / <%= @player_count %></p>
+        <% elsif @game.phase == "closed" %>
+          <% feedback = !@answer ? "No answer" : (@question.fetch("options")[@answer.option_index]["correct"] ? "Correct!" : "Wrong!") %>
+          <p class="play-status" role="status"><%= feedback %></p>
+        <% end %>
+        <ol class="plain-list play-options live-options">
+          <% @question.fetch("options").each_with_index do |option, index| %>
+            <% selected = @answer&.option_index == index %>
+            <% revealed = @game.phase == "closed" && option["correct"] %>
+            <li class="live-option <%= "is-selected" if selected %> <%= "is-revealed" if revealed %>">
+              <% if !@moderator && @game.phase == "open" %>
+                <%= form_with url: answer_path(@game.code), data: { live: true } do |form| %>
+                  <%= form.hidden_field :question_index, value: @game.current_index %>
+                  <%= form.hidden_field :option_index, value: index %>
+                  <button type="submit" class="play-option" aria-pressed="<%= selected %>" data-option="<%= index %>">
+                    <span class="play-option__title"><%= option.fetch("text") %></span>
+                    <% if selected %><span class="answer-mark">Your answer</span><% end %>
+                  </button>
+                <% end %>
+              <% else %>
+                <div class="play-option">
+                  <span class="play-option__title"><%= option.fetch("text") %></span>
+                  <% if @moderator && @game.phase == "closed" %><span class="option-count"><%= pluralize(@counts.fetch(index, 0), "answer") %></span><% end %>
+                  <% if selected %><span class="answer-mark">Your answer</span><% end %>
+                  <% if revealed %><span class="answer-mark">Correct</span><% end %>
+                </div>
+              <% end %>
+            </li>
+          <% end %>
+        </ol>
+        <% if @moderator %>
+          <% if @game.phase == "open" %>
+            <%= render "games/control", command: "finish", label: "Finish" %>
+          <% elsif @game.current_index == @game.questions.length - 1 %>
+            <%= render "games/control", command: "end", label: "End quiz" %>
+          <% else %>
+            <%= render "games/control", command: "next", label: "Next" %>
+          <% end %>
+        <% elsif @game.phase == "open" %>
+          <p class="meta answer-hint"><%= @answer ? "Answer saved. You can change it until the question closes." : "Tap an option to answer." %></p>
+        <% else %>
+          <p class="meta">Waiting for the moderator…</p>
+        <% end %>
+      </div>
+    <% end %>
+  <% end %>
+</div>
