+  def select_winners(command)
+    return [] if command == "reset_winners"
+    eligible = leaderboard.select { |row| row[:points].positive? }
+    if command == "top" || eligible.size <= number_of_winners
+      return eligible.first(number_of_winners).map { |row| row[:player].id }
+    end
+
+    cutoff = eligible[number_of_winners - 1][:points]
+    guaranteed = eligible.select { |row| row[:points] > cutoff }
+    tied = eligible.select { |row| row[:points] == cutoff }
+    (guaranteed + tied.sample(number_of_winners - guaranteed.size)).map { |row| row[:player].id }
+  end
