+module Images
+  # Preserve the small uploader read interface used by forms and serializers.
+  class ProfileImage
+    def initialize(record)
+      @record = record
+    end
+
+    def url
+      @record.profile_image_url
+    end
+
+    def blank?
+      !@record.profile_image_asset.attached? && @record.legacy_profile_image.blank?
+    end
+
+    delegate :to_s, to: :url
+
+    def as_json(*)
+      { "url" => url }
+    end
+  end
+end
