+ENV["RAILS_ENV"] = "test"
+require "spec_helper"
+require_relative "../../config/environment"
+
+RSpec.describe ProfileImageCacheUploader do
+  let(:model) { Struct.new(:id).new(1) }
+  let(:uploader) { described_class.new(model, :profile_image) }
+
+  after { uploader.remove! }
+
+  it "uses local temporary files even with a Fog permanent storage configuration" do
+    allow(described_class).to receive(:storage).and_return(CarrierWave::Storage::Fog)
+    path = Rails.root.join("spec/support/fixtures/images/image1.jpeg")
+    File.open(path) { |file| uploader.cache!(file) }
+
+    expect(uploader.file).to be_a(CarrierWave::SanitizedFile)
+    expect(uploader.file.read).to eq(File.binread(path))
+    expect(uploader.filename).to end_with(".jpeg")
+  end
+
+  it "retains the existing file size and extension restrictions" do
+    expect(uploader.size_range).to eq(1..ProfileImageUploader::MAX_FILE_SIZE)
+    expect(uploader.extension_allowlist).to eq(BaseUploader::EXTENSION_ALLOWLIST)
+  end
+end
