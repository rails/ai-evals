+        <% elsif screen[:index] == screen[:total] - 1 %>
+          <span class="meta">That’s the final question.</span><%= render "live/control", event: "end", label: "End quiz" %>
+        <% else %>
+          <span class="meta">Answers are closed.</span><%= render "live/control", event: "next", label: "Next" %>
+        <% end %>
+      <% elsif phase == "open" %>
+        <p class="meta"><%= screen[:selected].nil? ? "Tap an option to answer." : "Answer saved. You can change it until the question closes." %></p>
+      <% else %>
+        <p class="meta">Waiting for the moderator…</p>
+      <% end %>
+    </div>
+  </section>
+<% end %>
