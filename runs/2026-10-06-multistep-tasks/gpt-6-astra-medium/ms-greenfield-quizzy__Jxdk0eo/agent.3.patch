diff --git a/app/assets/javascripts/application.js b/app/assets/javascripts/application.js
index 0a37516..5041361 100644
--- a/app/assets/javascripts/application.js
+++ b/app/assets/javascripts/application.js
@@ -88,3 +88,104 @@ function showQuestion() {
   document.getElementById("start-over").addEventListener("click", () => { index = 0; score = 0; showQuestion(); });
   showQuestion();
 }
+
+// A single in-flight request per screen. Conditional polling is deliberately
+// stateless: reconnecting after Wi-Fi loss always recovers the latest snapshot.
+const live = document.querySelector("[data-live-url]");
+if (live) {
+  const content = live.querySelector("[data-live-content]");
+  const connection = live.querySelector("[data-connection]");
+  let revision = live.dataset.revision;
+  let timer;
+  let requestController;
+  let serial = 0;
+  let failures = 0;
+  let saving = false;
+
+  function apply(snapshot) {
+    if (snapshot.revision !== revision) {
+      content.innerHTML = snapshot.html;
+      revision = snapshot.revision;
+    }
+  }
+
+  function schedule() {
+    clearTimeout(timer);
+    const delay = failures ? Math.min(15000, 1000 * 2 ** failures) : (document.hidden ? 3000 : 1000);
+    timer = setTimeout(poll, delay + Math.random() * 200);
+  }
+
+  async function request(url, options) {
+    const controller = new AbortController();
+    requestController = controller;
+    const timeout = setTimeout(() => controller.abort(), 8000);
+    try {
+      const response = await fetch(url, { credentials: "same-origin", cache: "no-store", ...options, signal: controller.signal });
+      const snapshot = response.status === 304 ? null : await response.json();
+      return { response, snapshot };
+    } finally {
+      clearTimeout(timeout);
+    }
+  }
+
+  async function poll() {
+    if (saving) return;
+    const current = ++serial;
+    try {
+      const { response, snapshot } = await request(live.dataset.liveUrl, { headers: { Accept: "application/json", "If-None-Match": revision } });
+      if (current !== serial) return;
+      if (response.status !== 304) {
+        if (!response.ok) throw new Error("Unable to update");
+        if (current !== serial) return;
+        apply(snapshot);
+      }
+      failures = 0;
+      connection.textContent = "";
+    } catch (error) {
+      if (current !== serial) return;
+      failures++;
+      connection.textContent = "Connection interrupted. Reconnecting…";
+    } finally {
+      if (current === serial) schedule();
+    }
+  }
+
+  live.addEventListener("submit", async (event) => {
+    const form = event.target;
+    if (!form.matches("[data-live-form]")) return;
+    event.preventDefault();
+    if (saving) return;
+    saving = true;
+    ++serial;
+    clearTimeout(timer);
+    requestController?.abort();
+    const data = new FormData(form);
+    const buttons = content.querySelectorAll("button, input[type=submit]");
+    buttons.forEach(button => button.disabled = true);
+    connection.textContent = "Saving…";
+    try {
+      const { response, snapshot } = await request(form.action, {
+        method: "POST", body: data,
+        headers: { Accept: "application/json", "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content }
+      });
+      if (!response.ok) throw new Error(snapshot.error || "Could not save. Please try again.");
+      apply(snapshot);
+      failures = 0;
+      connection.textContent = "";
+    } catch (error) {
+      connection.textContent = error.message === "Failed to fetch" || error.name === "AbortError"
+        ? "Connection interrupted. Your choice may not be saved; please try again."
+        : error.message;
+    } finally {
+      buttons.forEach(button => button.disabled = false);
+      saving = false;
+      schedule();
+    }
+  });
+
+  window.addEventListener("online", () => { if (!saving) { clearTimeout(timer); requestController?.abort(); poll(); } });
+  document.addEventListener("visibilitychange", () => {
+    if (!document.hidden && !saving) { clearTimeout(timer); requestController?.abort(); poll(); }
+  });
+  schedule();
+}
