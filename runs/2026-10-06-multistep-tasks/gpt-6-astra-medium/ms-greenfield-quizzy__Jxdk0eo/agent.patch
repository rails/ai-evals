@@ -0,0 +1,39 @@
+module LiveScreenResponse
+  extend ActiveSupport::Concern
+
+  private
+
+  def prepare_screen
+    @screen = GameScreen.for(@game, player: @player, moderator: @moderator || false)
+    @revision = %Q("#{Digest::SHA256.hexdigest(@screen.to_json)}")
+    @join_url = play_url(code: @game.code)
+    response.headers["X-Server-Time"] = (Time.current.to_f * 1000).to_s
+    response.headers["Cache-Control"] = "no-store"
+  end
+
+  def render_live_screen(status: :ok)
+    prepare_screen
+    response.headers["ETag"] = @revision
+    if request.get? && request.headers["If-None-Match"] == @revision
+      head :not_modified
+    else
+      render json: { html: render_to_string(partial: "live/screen", formats: [ :html ]), revision: @revision }, status: status
+    end
+  end
+
+  def live_redirect(path)
+    if request.format.json?
+      render_live_screen
+    else
+      redirect_to path, status: :see_other
+    end
+  end
+
+  def game_conflict(error)
+    if request.format.json?
+      render json: { error: error.message }, status: :conflict
+    else
+      render plain: error.message, status: :conflict
+    end
+  end
+end
diff --git a/app/controllers/moderate/base_controller.rb b/app/controllers/moderate/base_controller.rb
new file mode 100644
index 0000000..364d885
--- /dev/null
+++ b/app/controllers/moderate/base_controller.rb
@@ -0,0 +1,20 @@
+class Moderate::BaseController < ApplicationController
+  before_action :authenticate_moderator
+  before_action :prevent_caching
+
+  private
+
+  def authenticate_moderator
+    authenticate_or_request_with_http_basic("Quizzy Moderator") do |username, password|
+      expected_user = ENV["QUIZZY_MODERATOR_USERNAME"]
+      expected_password = ENV["QUIZZY_MODERATOR_PASSWORD"]
+      expected_user.present? && expected_password.present? &&
+        ActiveSupport::SecurityUtils.secure_compare(username, expected_user) &
+          ActiveSupport::SecurityUtils.secure_compare(password, expected_password)
+    end
+  end
+
+  def prevent_caching
+    response.headers["Cache-Control"] = "no-store"
+  end
+end
