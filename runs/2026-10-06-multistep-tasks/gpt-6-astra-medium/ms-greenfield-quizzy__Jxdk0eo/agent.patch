--- /dev/null
+++ b/script/timer_worker.rb
@@ -0,0 +1,10 @@
+# Supervised by bin/serve. Persisted deadlines survive restarts and do not
+# require any browser to remain connected. Multiple sweepers are safe.
+loop do
+  begin
+    Rails.application.executor.wrap { Game.expire_due! }
+  rescue StandardError => error
+    Rails.logger.error("Timer sweep failed: #{error.class}: #{error.message}")
+  end
+  sleep 0.1
+end
