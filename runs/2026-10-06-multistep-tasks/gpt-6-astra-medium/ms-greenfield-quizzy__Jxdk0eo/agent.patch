+module ApplicationHelper
+  def option_letter(index)
+    label = +""
+    number = index + 1
+    while number.positive?
+      number, remainder = (number - 1).divmod(26)
+      label.prepend((65 + remainder).chr)
+    end
+    label
+  end
+end
