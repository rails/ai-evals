diff --git a/app/views/live/_screen.html.erb b/app/views/live/_screen.html.erb
new file mode 100644
index 0000000..813ee30
--- /dev/null
+++ b/app/views/live/_screen.html.erb
@@ -0,0 +1,131 @@
+<% screen = @screen %>
+<% phase = screen[:phase] %>
+<% if phase == "ended" %>
+  <section class="live-center card">
+    <span class="live-eyebrow">THANKS FOR PLAYING</span>
+    <h1>The quiz is over</h1>
+    <p class="live-subtitle"><%= screen[:title] %></p>
+    <% if screen[:moderator] %>
+      <h2>Leaderboard</h2>
+      <ol class="leaderboard" aria-label="Leaderboard">
+        <% screen[:leaderboard].each do |row| %>
+          <li class="leaderboard-row <%= 'is-winner' if row[:winner] %>">
+            <span class="leaderboard-place"><%= row[:place] %></span>
+            <span class="leaderboard-name"><%= row[:name] %></span>
+            <strong><%= pluralize(row[:points], "point") %></strong>
+            <% if row[:winner] %><span class="winner-mark">Winner</span><% end %>
+          </li>
+        <% end %>
+      </ol>
+      <% if screen[:leaderboard].empty? %><p>No players joined this quiz.</p><% end %>
+      <div class="buttons prize-controls">
+        <% [["top", "Top #{screen[:number_of_winners]}"], ["draw", "Draw"], ["reset", "Reset winners"]].each do |selection, label| %>
+          <%= form_with url: winners_moderate_game_path(@game), data: { live_form: true } do |form| %>
+            <%= form.hidden_field :selection, value: selection %>
+            <%= form.submit label, class: "btn" %>
+          <% end %>
+        <% end %>
+      </div>
+    <% elsif screen[:standing] %>
+      <h2>Place <%= screen[:standing][:place] %> of <%= screen[:total_players] %></h2>
+      <p class="live-subtitle"><%= pluralize(screen[:standing][:points], "point") %></p>
+      <% if screen[:standing][:winner] %><p class="winner-celebration" role="status">You won!</p><% end %>
+    <% else %>
+      <p class="meta">See you at the next talk.</p>
+    <% end %>
+  </section>
+<% elsif phase == "join" %>
+  <section class="card join-card">
+    <span class="live-eyebrow">YOU’RE INVITED</span>
+    <h1><%= screen[:title] %></h1>
+    <p class="live-subtitle">A little curiosity. A little competition. Let’s play.</p>
+    <% if @error %><p class="error" role="alert"><%= @error %></p><% end %>
+    <%= form_with url: join_play_path(code: @game.code) do |form| %>
+      <div class="field"><%= form.label :name, "Your name" %><%= form.text_field :name, value: params[:name], class: "input", required: true, maxlength: 80, autocomplete: "nickname", placeholder: "Your name" %></div>
+      <%= form.submit "Join", class: "btn btn--lg join-button" %>
+    <% end %>
+    <p class="meta mt-4">No account needed. Just bring your best guesses.</p>
+  </section>
+<% elsif phase == "waiting" %>
+  <% if screen[:moderator] %>
+    <section class="live-center">
+      <span class="live-eyebrow">LET’S GET EVERYONE IN</span>
+      <h1><%= screen[:title] %></h1>
+      <div class="join-display card">
+        <div class="qr-code" role="img" aria-label="QR code to join the quiz"><%= raw RQRCode::QRCode.new(@join_url).as_svg(module_size: 5, standalone: true, use_path: true, color: "1428A0", offset: 20) %></div>
+        <div class="join-instructions"><h2>Scan to join</h2><p>Or open this link on your phone</p><p class="join-url"><%= @join_url %></p><p class="live-counter" data-counter>Players: <%= screen[:players] %></p></div>
+      </div>
+      <%= render "live/control", event: "start", label: "Start" %>
+      <% if @game.questions.empty? %><p class="meta mt-4">This quiz has no active questions. Starting will end the game.</p><% end %>
+    </section>
+  <% else %>
+    <section class="card live-center">
+      <span class="live-eyebrow">YOU’RE IN</span>
+      <h1>Hi, <%= screen[:name] %>!</h1>
+      <div class="waiting-mark" aria-hidden="true">?</div>
+      <h2><%= screen[:title] %></h2>
+      <p class="live-subtitle">Waiting for the moderator to start…</p>
+      <p class="meta">Keep this page open. Your questions will appear here.</p>
+    </section>
+  <% end %>
+<% else %>
+  <section>
+    <div class="live-question-head">
+      <span class="live-eyebrow">Question <%= screen[:index] + 1 %> of <%= screen[:total] %></span>
+      <% if screen[:moderator] %><span class="live-counter" data-counter>Answers: <%= screen[:answer_count] %> / <%= screen[:players] %></span>
+      <% else %><span class="meta">Hi, <%= screen[:name] %>!</span><% end %>
+    </div>
+<% if screen[:deadline] %>
+  <% remaining = [(screen[:deadline] / 1000 - Time.current.to_f).ceil, 0].max %>
+  <div class="question-timer" role="timer" aria-label="Time remaining" data-deadline="<%= screen[:deadline] %>"><%= remaining / 60 %>:<%= "%02d" % (remaining % 60) %></div>
+<% end %>
+    <h1 class="live-question"><%= screen[:text] %></h1>
+    <% if phase == "closed" && !screen[:moderator] %>
+      <p class="answer-result <%= 'answer-result--correct' if screen[:result] == 'Correct!' %>" data-result role="status"><%= screen[:result] %></p>
+    <% end %>
+    <ol class="plain-list live-options">
+      <% screen[:options].each do |option| %>
+        <li class="live-option <%= 'is-selected' if screen[:selected] == option[:index] %> <%= 'is-correct' if option[:correct] %>">
+          <% if phase == "open" && !screen[:moderator] %>
+            <%= form_with url: answer_play_path(code: @game.code), data: { live_form: true } do |form| %>
+              <%= form.hidden_field :question_index, value: screen[:index] %>
+              <%= form.hidden_field :option_index, value: option[:index] %>
+              <button type="submit" class="live-option-inner" aria-pressed="<%= screen[:selected] == option[:index] %>">
+                <span class="option-letter"><%= option_letter(option[:index]) %></span>
+                <span class="option-text"><%= option[:text] %></span>
+                <% if screen[:selected] == option[:index] %><span class="option-badge">Your answer</span><% end %>
+              </button>
+            <% end %>
+          <% else %>
+            <div class="live-option-inner">
+              <span class="option-letter"><%= option_letter(option[:index]) %></span>
+              <span class="option-text"><%= option[:text] %></span>
+              <span class="option-marks">
+                <% if screen[:selected] == option[:index] %><span class="option-badge">Your answer</span><% end %>
+                <% if phase == "closed" %>
+                  <% if screen[:moderator] %><span class="vote-count"><%= pluralize(option[:count], "answer") %></span><% end %>
+                  <% if option[:correct] %><span class="option-badge correct-badge">Correct</span><% end %>
+                <% end %>
+              </span>
+            </div>
+          <% end %>
+        </li>
+      <% end %>
+    </ol>
+    <div class="live-footer">
+      <% if screen[:moderator] %>
+        <% if phase == "open" %>
+          <span class="meta">Answers are coming in live.</span><%= render "live/control", event: "finish", label: "Finish" %>
+        <% elsif screen[:index] == screen[:total] - 1 %>
+          <span class="meta">That’s the final question.</span><%= render "live/control", event: "end", label: "End quiz" %>
+        <% else %>
+          <span class="meta">Answers are closed.</span><%= render "live/control", event: "next", label: "Next" %>
+        <% end %>
+      <% elsif phase == "open" %>
+        <p class="meta"><%= screen[:selected].nil? ? "Tap an option to answer." : "Answer saved. You can change it until the question closes." %></p>
+      <% else %>
+        <p class="meta">Waiting for the moderator…</p>
+      <% end %>
+    </div>
+  </section>
+<% end %>
