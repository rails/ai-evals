new file mode 100755
index 0000000..0252910
--- /dev/null
+++ b/bin/serve
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+export RAILS_ENV=production
+mkdir -p storage tmp/pids
+bin/rails db:prepare
+bin/rails assets:precompile
+# Keep both processes supervised and forward shutdown signals to each.
+cleanup() {
+  trap - EXIT INT TERM
+  kill -TERM "${timer_pid:-}" "${web_pid:-}" 2>/dev/null || true
+  wait "${timer_pid:-}" "${web_pid:-}" 2>/dev/null || true
+}
+trap cleanup EXIT
+trap 'exit 0' INT TERM
+bin/rails runner script/timer_worker.rb &
+timer_pid=$!
+bundle exec puma -C config/puma.rb -b "tcp://0.0.0.0:${PORT:-3000}" &
+web_pid=$!
+wait -n "$timer_pid" "$web_pid"
