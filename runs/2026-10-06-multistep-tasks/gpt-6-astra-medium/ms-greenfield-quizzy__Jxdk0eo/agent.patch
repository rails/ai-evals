+class Moderate::QuizzesController < Moderate::BaseController
+  before_action :set_quiz, only: [ :show, :edit, :update, :destroy, :preview, :export ]
+
+  def index
+    @quizzes = Quiz.order(created_at: :desc, id: :desc)
+  end
+
+  def new
+    @quiz = Quiz.new
+  end
+
+  def create
+    @quiz = Quiz.new(quiz_params)
+    if @quiz.save
+      redirect_to moderate_quiz_path(@quiz)
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def show
+    @questions = @quiz.questions.to_a
+  end
+
+  def edit
+  end
+
+  def update
+    if @quiz.update(quiz_params)
+      redirect_to moderate_quiz_path(@quiz), status: :see_other
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @quiz.destroy!
+    redirect_to moderate_root_path, status: :see_other
+  end
+
+  def preview
+    @preview_questions = @quiz.questions.where(active: true).map { |q| { text: q.text, options: q.options } }
+  end
+
+  def export
+    @quiz_json = QuizTransfer.export(@quiz)
+  end
+
+  def import
+  end
+
+  def import_create
+    @quiz_json = params[:quiz_json]
+    quiz = QuizTransfer.import(@quiz_json)
+    redirect_to moderate_quiz_path(quiz), status: :see_other
+  rescue QuizTransfer::InvalidImport => error
+    @error = error.message
+    render :import, status: :unprocessable_entity
+  end
+
+  private
+
+  def set_quiz
+    @quiz = Quiz.find(params[:id])
+  end
+
+  def quiz_params
+    params.require(:quiz).permit(:title, :number_of_winners, :timer_minutes, :timer_seconds)
+  end
+end
