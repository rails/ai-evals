diff --git a/app/services/game_screen.rb b/app/services/game_screen.rb
new file mode 100644
index 0000000..a292a40
--- /dev/null
+++ b/app/services/game_screen.rb
@@ -0,0 +1,53 @@
+# Explicitly allow-listed presentation data. Before closure no answer key,
+# correctness flag, or vote distribution is available to the public renderer.
+class GameScreen
+  def self.for(game, player: nil, moderator: false)
+    game.expire_question!
+    state = { title: game.title, phase: game.state, moderator: moderator, name: player&.name }
+    if game.state == "ended"
+      if moderator || player
+        leaderboard = game.leaderboard
+        if moderator
+          state.merge!(leaderboard: leaderboard, number_of_winners: game.number_of_winners)
+        else
+          state.merge!(standing: leaderboard.find { |row| row[:id] == player.id }, total_players: leaderboard.size)
+        end
+      end
+      return state
+    end
+    unless moderator || player
+      return state.merge(phase: "join")
+    end
+
+    if moderator
+      state[:deadline] = game.question_deadline_at.to_f * 1000 if game.state == "open" && game.question_deadline_at
+      present_players = game.players.present_now
+      state[:players] = present_players.count
+      state[:answer_count] = game.answers.where(question_index: game.question_index, player_id: present_players.select(:id)).count
+    end
+    return state if game.state == "waiting"
+
+    question = game.current_question
+    own_answer = player && game.answers.find_by(player: player, question_index: game.question_index)
+    state.merge!(index: game.question_index, total: game.questions.size, text: question.fetch("text"), selected: own_answer&.option_index)
+    counts = game.state == "closed" && moderator ? game.answers.where(question_index: game.question_index).group(:option_index).count : {}
+    state[:options] = question.fetch("options").each_with_index.map do |option, index|
+      item = { text: option.fetch("text"), index: index }
+      if game.state == "closed"
+        item[:correct] = option.fetch("correct")
+        item[:count] = counts.fetch(index, 0) if moderator
+      end
+      item
+    end
+    if game.state == "closed" && player
+      state[:result] = if own_answer.nil?
+        "No answer"
+      elsif question.fetch("options")[own_answer.option_index].fetch("correct")
+        "Correct!"
+      else
+        "Wrong!"
+      end
+    end
+    state
+  end
+end
diff --git a/app/services/quiz_transfer.rb b/app/services/quiz_transfer.rb
new file mode 100644
index 0000000..14c3ee3
--- /dev/null
+++ b/app/services/quiz_transfer.rb
@@ -0,0 +1,79 @@
+# Portable quiz contents only: never import database IDs or runtime state.
+class QuizTransfer
+  class InvalidImport < StandardError; end
+
+  def self.export(quiz)
+    JSON.pretty_generate(
+      title: quiz.title,
+      number_of_winners: quiz.number_of_winners,
+      questions: quiz.questions.map do |question|
+        {
+          text: question.text,
+          active: question.active?,
+          options: question.options.map { |option| { text: option.fetch("text"), correct: option.fetch("correct") } }
+        }
+      end
+    )
+  end
+
+  def self.import(json)
+    new.import(json)
+  end
+
+  def import(json)
+    check_type!(json, String, "Quiz JSON")
+    data = JSON.parse(json)
+    check_type!(data, Hash, "Quiz")
+    check_type!(data["title"], String, "Title")
+    check_type!(data["questions"], Array, "Questions")
+
+    if data.key?("number_of_winners") && !data["number_of_winners"].is_a?(Integer)
+      raise InvalidImport, "Number of winners must be an integer."
+    end
+    Quiz.transaction do
+      quiz = Quiz.create!(title: data["title"], number_of_winners: data.fetch("number_of_winners", 3))
+      data["questions"].each_with_index do |question, index|
+        import_question!(quiz, question, index + 1)
+      end
+      quiz
+    end
+  rescue JSON::ParserError
+    raise InvalidImport, "Quiz JSON is not valid JSON. Check its syntax and try again."
+  rescue ActiveRecord::RecordInvalid => error
+    raise InvalidImport, error.record.errors.full_messages.join(". ")
+  end
+
+  private
+
+  def import_question!(quiz, data, position)
+    check_type!(data, Hash, "Question")
+    check_type!(data["text"], String, "Question text")
+    check_type!(data["options"], Array, "Options")
+    options = data["options"].each_with_index.map do |option, index|
+      check_type!(option, Hash, "Option #{index + 1}")
+      check_type!(option["text"], String, "Option #{index + 1} text")
+      { "text" => option["text"], "correct" => boolean!(option, "correct", false) }
+    end
+    # Use the form's option_rows setter: blank rows are omitted and all of the
+    # question model's validations apply equally to forms and imports.
+    quiz.questions.create!(text: data["text"], active: boolean!(data, "active", true),
+      position: position, option_rows: options)
+  rescue ActiveRecord::RecordInvalid => error
+    raise InvalidImport, "Question #{position}: #{error.record.errors.full_messages.join('. ')}"
+  rescue InvalidImport => error
+    raise InvalidImport, "Question #{position}: #{error.message}"
+  end
+
+  def check_type!(value, type, label)
+    return if value.is_a?(type)
+    description = { Hash => "an object", Array => "an array", String => "a string" }.fetch(type)
+    raise InvalidImport, "#{label} must be #{description}."
+  end
+
+  def boolean!(data, key, default)
+    return default unless data.key?(key)
+    value = data[key]
+    return value if value == true || value == false
+    raise InvalidImport, "#{key} must be true or false."
+  end
+end
