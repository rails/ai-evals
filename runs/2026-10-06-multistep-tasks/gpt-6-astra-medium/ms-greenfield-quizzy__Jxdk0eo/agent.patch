new file mode 100644
index 0000000..3543a53
--- /dev/null
+++ b/app/views/moderate/quizzes/show.html.erb
@@ -0,0 +1,53 @@
+<% content_for :title, @quiz.title %>
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head">
+  <div><h1><%= @quiz.title %></h1><div class="meta mt-2"><%= @questions.count(&:active?) %> of <%= @questions.size %> questions active · <%= link_to "Settings", edit_moderate_quiz_path(@quiz) %></div></div>
+  <div class="buttons"><%= button_to "Start a game", moderate_quiz_games_path(@quiz), class: "btn" %><%= link_to "Export", export_moderate_quiz_path(@quiz), class: "btn btn--ghost" %><%= link_to "Preview", preview_moderate_quiz_path(@quiz), class: "btn btn--ghost" %></div>
+</div>
+<section class="section mt-0">
+  <div class="section-head"><h2>Questions</h2><%= link_to "Add question", new_moderate_quiz_question_path(@quiz), class: "btn" %></div>
+  <% if @questions.empty? %><div class="empty">No questions yet. Add your first question to get started.</div><% end %>
+  <ol class="plain-list">
+    <% active_number = 0 %>
+    <% @questions.each_with_index do |question, index| %>
+      <li class="card question-item <%= 'question-item--inactive' unless question.active? %>">
+        <div class="question-item__num"><%= question.active? ? (active_number += 1) : "—" %></div>
+        <div>
+          <div class="question-item__body"><%= question.text %></div>
+          <ul class="question-item__options">
+            <% question.options.each_with_index do |option, i| %>
+              <li class="<%= 'is-correct' if option['correct'] %>"><%= option_letter(i) %>. <%= option['text'] %><% if option['correct'] %><span class="sr-only"> (Correct)</span><% end %></li>
+            <% end %>
+          </ul>
+        </div>
+        <div class="question-item__actions">
+          <div class="buttons">
+            <%= button_to "↑", move_moderate_quiz_question_path(@quiz, question), params: { direction: "up" }, method: :patch, class: "btn btn--ghost btn--icon", aria: { label: "Move up" }, title: "Move up", disabled: index.zero? %>
+            <%= button_to "↓", move_moderate_quiz_question_path(@quiz, question), params: { direction: "down" }, method: :patch, class: "btn btn--ghost btn--icon", aria: { label: "Move down" }, title: "Move down", disabled: index == @questions.size - 1 %>
+          </div>
+          <%= form_with model: question, url: toggle_moderate_quiz_question_path(@quiz, question), method: :patch do |form| %>
+            <label class="checkbox"><%= form.check_box :active, id: "active_#{question.id}", data: { autosubmit: true } %> Active</label>
+          <% end %>
+          <div class="buttons">
+            <%= link_to "Edit", edit_moderate_quiz_question_path(@quiz, question), class: "btn btn--sm" %>
+            <%= button_to "Delete", moderate_quiz_question_path(@quiz, question), method: :delete, class: "btn btn--sm btn--danger", form: { data: { confirm: "Delete this question?" } } %>
+          </div>
+        </div>
+      </li>
+    <% end %>
+  </ol>
+</section>
+
+<% if @quiz.games.exists? %>
+  <section class="section">
+    <div class="section-head"><h2>Games</h2></div>
+    <ul class="plain-list game-list">
+      <% @quiz.games.order(created_at: :desc).each do |game| %>
+        <li class="card game-history">
+          <div><strong><%= game.created_at.strftime("%b %-d, %Y · %H:%M") %></strong><div class="meta"><%= game.code %> · <%= game.state.capitalize %> · <%= pluralize(game.players.count, "player") %></div></div>
+          <%= link_to "Open game", moderate_game_path(game), class: "btn btn--ghost" %>
+        </li>
+      <% end %>
+    </ul>
+  </section>
+<% end %>
