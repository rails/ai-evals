diff --git a/test/models/game_concurrency_test.rb b/test/models/game_concurrency_test.rb
new file mode 100644
index 0000000..db79bfe
--- /dev/null
+++ b/test/models/game_concurrency_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+# Real committed transactions and separate connections: these races cannot be
+# tested inside the normal per-test transaction.
+class GameConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  setup do
+    @quiz = Quiz.create!(title: "Concurrent game #{SecureRandom.hex(5)}")
+    @quiz.questions.create!(text: "Race safely?", position: 1,
+      options: [ { text: "Yes", correct: true }, { text: "No", correct: false } ])
+    @game = Game.for_quiz!(@quiz)
+  end
+
+  teardown do
+    @quiz.destroy!
+  end
+
+  def concurrently(count, &block)
+    ready, go = Queue.new, Queue.new
+    threads = count.times.map do |index|
+      Thread.new do
+        ready << true
+        go.pop
+        ActiveRecord::Base.connection_pool.with_connection { block.call(index) }
+      end
+    end
+    count.times { ready.pop }
+    count.times { go << true }
+    threads.map(&:value)
+  end
+
+  test "concurrent retries join only once and cannot start twice" do
+    ids = concurrently(4) do
+      Game.find(@game.id).join!(name: "Alice", token_digest: "one-browser").id
+    end
+    assert_equal 1, ids.uniq.size
+    assert_equal 1, @game.players.count
+    outcomes = concurrently(4) do
+      Game.find(@game.id).transition!("start", expected_state: "waiting", expected_index: -1)
+      :started
+    rescue Game::Conflict
+      :stale
+    end
+    assert_equal 1, outcomes.count(:started)
+    assert_equal 3, outcomes.count(:stale)
+    assert_equal "open", @game.reload.state
+    assert_equal 0, @game.question_index
+  end
+
+  test "simultaneous answers and finishing serialize without late writes" do
+    players = 8.times.map { |i| @game.join!(name: "Player #{i}", token_digest: "browser-#{i}") }
+    @game.transition!("start", expected_state: "waiting", expected_index: -1)
+    outcomes = concurrently(9) do |index|
+      game = Game.find(@game.id)
+      if index == 4
+        game.transition!("finish", expected_state: "open", expected_index: 0)
+        :closed
+      else
+        player = players[index > 4 ? index - 1 : index]
+        game.answer!(player: player, index: 0, option: 0)
+        :accepted
+      end
+    rescue Game::Conflict
+      :rejected
+    end
+    assert_equal "closed", @game.reload.state
+    assert_equal 1, outcomes.count(:closed)
+    assert_equal outcomes.count(:accepted), @game.answers.count
+    before = @game.answers.pluck(:id, :option_index, :updated_at)
+    players.each do |player|
+      assert_raises(Game::Conflict) { @game.answer!(player: player, index: 0, option: 1) }
+    end
+    assert_equal before, @game.answers.pluck(:id, :option_index, :updated_at)
+  end
+end
diff --git a/test/models/game_prizes_test.rb b/test/models/game_prizes_test.rb
new file mode 100644
index 0000000..d909a97
--- /dev/null
+++ b/test/models/game_prizes_test.rb
@@ -0,0 +1,143 @@
+require "test_helper"
+
+class GamePrizesTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Prizes", number_of_winners: 2)
+    2.times do |i|
+      @quiz.questions.create!(text: "Question #{i}", position: i,
+        options: [ { text: "Yes", correct: true }, { text: "No", correct: false } ])
+    end
+    @game = Game.for_quiz!(@quiz)
+    @players = %w[Alice Bob Cara Zero].map { |name| @game.join!(name: name, token_digest: name) }
+  end
+
+  def advance(event)
+    @game.transition!(event, expected_state: @game.state, expected_index: @game.question_index)
+  end
+
+  def play
+    travel_to Time.current.change(usec: 0) do
+      advance("start")
+      travel 1.second
+      @game.answer!(player: @players[0], index: 0, option: 0)
+      travel 1.second
+      @game.answer!(player: @players[1], index: 0, option: 0)
+      travel 1.second
+      @game.answer!(player: @players[2], index: 0, option: 0)
+      travel 1.second
+      # Even re-picking the same option must reset the last-pick time.
+      @game.answer!(player: @players[1], index: 0, option: 0)
+      @game.answer!(player: @players[3], index: 0, option: 1)
+      advance("finish")
+      advance("next")
+      travel 2.seconds
+      @game.answer!(player: @players[0], index: 1, option: 0)
+      advance("finish")
+      advance("end")
+    end
+  end
+
+  test "rank by points then total time of correct answers using last picks" do
+    play
+    rows = @game.leaderboard
+    assert_equal %w[Alice Cara Bob Zero], rows.map { |r| r[:name] }
+    assert_equal [ 2, 1, 1, 0 ], rows.map { |r| r[:points] }
+    assert_equal [ 3_000_000, 3_000_000, 4_000_000, 0 ], rows.map { |r| r[:time] }
+    assert_equal [ 1, 2, 3, 4 ], rows.map { |r| r[:place] }
+  end
+
+  test "top and draw replace winners and reset removes them" do
+    play
+    @game.select_winners!("top")
+    assert_equal %w[Alice Cara], @game.players.where(winner: true).order(:id).pluck(:name)
+    observed = []
+    30.times do
+      @game.select_winners!("draw")
+      names = @game.players.where(winner: true).pluck(:name)
+      assert_includes names, "Alice"
+      assert_equal 2, names.size
+      assert_empty names & [ "Zero" ]
+      observed.concat(names)
+    end
+    assert_includes observed, "Bob"
+    assert_includes observed, "Cara"
+    @game.select_winners!("reset")
+    assert_empty @game.players.where(winner: true)
+  end
+
+  test "only positive scores win even when prizes exceed players" do
+    play
+    @game.update!(number_of_winners: 10)
+    %w[top draw].each do |method|
+      @game.select_winners!(method)
+      assert_equal %w[Alice Bob Cara], @game.players.where(winner: true).order(:id).pluck(:name)
+    end
+  end
+
+  test "settings validation and game snapshot" do
+    assert_equal 3, Quiz.new.number_of_winners
+    [ 0, -1, nil, 1.5, "no" ].each do |invalid|
+      assert_not Quiz.new(title: "Bad", number_of_winners: invalid).valid?
+    end
+    @quiz.update!(number_of_winners: 9)
+    assert_equal 2, @game.number_of_winners
+    assert_raises(Game::Conflict) { @game.select_winners!("top") }
+  end
+
+  test "empty game has no winners" do
+    game = Game.for_quiz!(Quiz.create!(title: "Empty"))
+    game.transition!("start", expected_state: "waiting", expected_index: -1)
+    %w[top draw reset].each do |method|
+      game.select_winners!(method)
+      assert_empty game.leaderboard
+    end
+  end
+  test "only correct final answers contribute time, summed over questions" do
+    travel_to Time.current.change(usec: 0) do
+      advance("start")
+      travel 1.second
+      @game.answer!(player: @players[0], index: 0, option: 0)
+      travel 1.second
+      @game.answer!(player: @players[1], index: 0, option: 0)
+      @game.answer!(player: @players[2], index: 0, option: 0)
+      travel 3.seconds
+      @game.answer!(player: @players[2], index: 0, option: 1)
+      advance("finish")
+      advance("next")
+      travel 1.second
+      @game.answer!(player: @players[1], index: 1, option: 0)
+      @game.answer!(player: @players[2], index: 1, option: 0)
+      travel 5.seconds
+      @game.answer!(player: @players[0], index: 1, option: 0)
+      advance("finish")
+      advance("end")
+    end
+    @players[1].update!(last_seen_at: 1.day.ago)
+    rows = @game.leaderboard
+    assert_equal %w[Bob Alice Cara Zero], rows.map { |r| r[:name] }
+    assert_equal [ 2, 2, 1, 0 ], rows.map { |r| r[:points] }
+    assert_equal [ 3_000_000, 7_000_000, 1_000_000, 0 ], rows.map { |r| r[:time] }
+    @game.update!(number_of_winners: 1)
+    @game.select_winners!("top")
+    assert_equal [ @players[1].id ], @game.players.where(winner: true).pluck(:id)
+    10.times do
+      @game.select_winners!("draw")
+      assert_equal 1, @game.players.where(winner: true).count
+      assert_includes @players.first(2).map(&:id), @game.players.find_by!(winner: true).id
+    end
+  end
+
+  test "all zero points and exact speed ties are deterministic and never award zero" do
+    advance("start")
+    advance("finish")
+    advance("next")
+    advance("finish")
+    advance("end")
+    assert_equal @players.map(&:id), @game.leaderboard.map { |r| r[:id] }
+    %w[top draw reset].each do |method|
+      @game.select_winners!(method)
+      assert_empty @game.players.where(winner: true)
+    end
+    assert_raises(Game::Conflict) { @game.select_winners!("unrecognized") }
+  end
+end
