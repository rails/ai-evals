diff --git a/script/browser_smoke.rb b/script/browser_smoke.rb
new file mode 100644
index 0000000..8cb1d33
--- /dev/null
+++ b/script/browser_smoke.rb
@@ -0,0 +1,160 @@
+# Run against bin/serve with matching QUIZZY_MODERATOR_* credentials.
+require "ferrum"
+require "timeout"
+
+browser = Ferrum::Browser.new(browser_path: "/usr/bin/chromium", browser_options: { "no-sandbox" => nil }, window_size: [ 1440, 1100 ])
+base = ENV.fetch("APP_URL", "http://localhost:3000")
+title = "Browser verification #{Time.now.to_i}"
+
+def wait
+  Timeout.timeout(10) do
+    loop do
+      result = yield
+      return result if result
+      sleep 0.05
+    end
+  end
+end
+
+def assert(condition, message)
+  raise message unless condition
+end
+
+def click(browser, text)
+  node = wait { browser.css("a, button, input[type=submit]").find { |n| n.text.strip == text || n.attribute("value") == text || n.attribute("aria-label") == text } }
+  click_node(node)
+end
+
+def click_node(node)
+  node.evaluate("this.scrollIntoView({block: 'center', behavior: 'instant'})")
+  sleep 0.15
+  node.click
+end
+
+def fill(browser, label, value)
+  node = browser.at_css("[aria-label='#{label}']") || browser.at_css("##{browser.css('label').find { |n| n.text == label }.attribute('for')}")
+  node.focus
+  node.type(value)
+end
+
+def visible_text(browser, text)
+  wait { browser.at_css("body").text.include?(text) }
+end
+
+begin
+  # Open the actual design exports in Chromium, including their local font.
+  %w[styleguide quiz question-form].each do |name|
+    browser.go_to("file:///app/docs/mockups/#{name}.html")
+    browser.screenshot(path: "/app/storage/mockup-#{name}.png", full: true)
+    assert(browser.evaluate("getComputedStyle(document.body).backgroundColor") == "rgb(233, 230, 255)", "Mockup background")
+  end
+
+  browser.network.authorize(user: ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), password: ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "test-password")) { |request| request.continue }
+  browser.go_to("#{base}/moderate")
+  click(browser, "New quiz")
+  wait { browser.at_css("#quiz_title") }
+  fill(browser, "Title", title)
+  click(browser, "Save quiz")
+  visible_text(browser, "Questions")
+  quiz_url = browser.url
+
+  click(browser, "Add question")
+  wait { browser.at_css("#question_text") }
+  assert(browser.css(".option-row").size == 4, "Four default options")
+  assert(browser.at_css("#question_active").property("checked"), "Active defaults on")
+  fill(browser, "Question", "Which planet is largest?")
+  fill(browser, "Option 1", "Jupiter")
+  click(browser, "Save question")
+  visible_text(browser, "Add at least two options")
+  visible_text(browser, "Mark at least one option as correct")
+  assert(browser.at_css("[aria-label='Option 1']").property("value") == "Jupiter", "Failed form preserves text")
+  fill(browser, "Option 2", "Earth")
+  click_node(browser.at_css("[aria-label='Option 1 is correct']"))
+  click(browser, "Add option")
+  fill(browser, "Option 5", "Saturn")
+  click(browser, "Save question")
+  visible_text(browser, "1 of 1 questions active")
+  assert(browser.css(".question-item__options li").size == 3, "Empty options skipped")
+  browser.screenshot(path: "/app/storage/quiz-browser.png", full: true)
+
+  click(browser, "Edit")
+  wait { browser.at_css("#question_text") }
+  browser.screenshot(path: "/app/storage/question-form-browser.png", full: true)
+  assert(browser.at_css("[aria-label='Option 1 is correct']").property("checked"), "Correct option retained")
+  click(browser, "Save question")
+  visible_text(browser, "Questions")
+
+  [ [ "Pick a primary color", "Blue", "Orange" ], [ "Inactive question", "Yes", "No" ] ].each do |text, correct, wrong|
+    click(browser, "Add question")
+    wait { browser.at_css("#question_text") }
+    fill(browser, "Question", text)
+    fill(browser, "Option 1", correct)
+    fill(browser, "Option 2", wrong)
+    click_node(browser.at_css("[aria-label='Option 1 is correct']"))
+    click(browser, "Save question")
+    visible_text(browser, "Questions")
+  end
+  cards = browser.css(".question-item")
+  click_node(cards.last.at_css("[data-autosubmit]"))
+  visible_text(browser, "2 of 3 questions active")
+  click_node(browser.css(".question-item")[1].at_css("[aria-label='Move up']"))
+  wait { browser.css(".question-item__body").first.text == "Pick a primary color" }
+  click_node(browser.css(".question-item").first.at_css("[aria-label='Move down']"))
+  wait { browser.css(".question-item__body").first.text == "Which planet is largest?" }
+
+  click(browser, "Preview")
+  visible_text(browser, "Question 1 of 2")
+  click(browser, "Jupiter")
+  visible_text(browser, "Correct!")
+  click(browser, "Next question")
+  visible_text(browser, "Question 2 of 2")
+  click(browser, "Orange")
+  visible_text(browser, "Wrong!")
+  assert(browser.at_css(".play-option.is-correct").text.include?("Blue"), "Reveals correct option")
+  click(browser, "See score")
+  visible_text(browser, "Score: 1/2")
+  click(browser, "Start over")
+  visible_text(browser, "Question 1 of 2")
+  browser.resize(width: 390, height: 844)
+  browser.screenshot(path: "/app/storage/preview-mobile.png", full: true)
+  assert(browser.evaluate("document.documentElement.scrollWidth <= innerWidth"), "Preview fits mobile")
+  click(browser, "Earth")
+  click(browser, "Next question")
+  click(browser, "Blue")
+  click(browser, "See score")
+  visible_text(browser, "Score: 1/2")
+  browser.go_to(quiz_url)
+  assert(browser.evaluate("document.documentElement.scrollWidth <= innerWidth"), "Quiz page fits mobile")
+
+  accept_dialog = false
+  dialogs = []
+  browser.on(:dialog) do |dialog|
+    dialogs << dialog.message
+    accept_dialog ? dialog.accept : dialog.dismiss
+  end
+  click_node(browser.css(".question-item").last.at_css(".btn--danger"))
+  wait { dialogs.size == 1 }
+  assert(browser.css(".question-item").size == 3, "Cancelled question deletion")
+  accept_dialog = true
+  click_node(browser.css(".question-item").last.at_css(".btn--danger"))
+  visible_text(browser, "2 of 2 questions active")
+  click(browser, "Settings")
+  visible_text(browser, "Delete quiz")
+  accept_dialog = false
+  click(browser, "Delete quiz")
+  wait { dialogs.size == 3 }
+  assert(browser.at_css("#quiz_title"), "Cancelled quiz deletion")
+  accept_dialog = true
+  click(browser, "Delete quiz")
+  visible_text(browser, "Your quizzes")
+  assert(!browser.at_css("body").text.include?(title), "Quiz deleted")
+  assert(dialogs.all? { |message| message.start_with?("Delete this") }, "Native confirms")
+  puts "PASS: design pages, quiz CRUD, question validation/editing, dynamic options, ordering, autosave, preview, mobile layout, native confirmations."
+rescue Exception
+  warn "Failed at #{browser.url}"
+  warn browser.at_css("body").text
+  browser.screenshot(path: "/app/storage/browser-failure.png", full: true)
+  raise
+ensure
+  browser.quit
+end
diff --git a/script/live_smoke.rb b/script/live_smoke.rb
new file mode 100644
index 0000000..3e2b333
--- /dev/null
+++ b/script/live_smoke.rb
@@ -0,0 +1,148 @@
+# Run against bin/serve. Chromium is driven directly; no driver downloads.
+require "ferrum"
+require "json"
+require "timeout"
+
+BASE = ENV.fetch("APP_URL", "http://localhost:3000")
+def wait(message = "condition", &block)
+  Timeout.timeout(15) do
+    loop do
+      value = block.call
+      return value if value
+      sleep 0.07
+    end
+  end
+rescue Timeout::Error
+  raise "Timed out waiting for #{message}"
+end
+
+def click(browser, text)
+  wait("button/link #{text}") do
+    browser.css("a, button, input[type=submit]").find { |node| node.text.strip == text || node.attribute("value") == text }
+  end.click
+end
+
+def body(browser)
+  browser.at_css("body").text
+end
+
+def check(condition, message)
+  raise message unless condition
+end
+
+def pick(browser, text)
+  wait("option #{text}") { browser.css("button.live-option-inner").find { |node| node.at_css(".option-text").text == text } }.click
+  wait("saved #{text}") { browser.at_css(".is-selected .option-text")&.text == text }
+end
+
+def join(browser, url, name)
+  browser.go_to(url)
+  browser.at_css('input[name="name"]').focus.type(name)
+  click(browser, "Join")
+  wait("greeting #{name}") { body(browser).include?("Hi, #{name}!") }
+  browser.evaluate("window.noNavigation = 'still-here'")
+end
+
+browsers = []
+begin
+  4.times do |i|
+    browsers << Ferrum::Browser.new(browser_path: "/usr/bin/chromium", browser_options: { "no-sandbox" => nil }, window_size: i.zero? ? [ 1440, 1000 ] : [ 390, 844 ])
+  end
+  moderator, alice, bob, late = browsers
+  moderator.network.authorize(user: ENV.fetch("QUIZZY_MODERATOR_USERNAME", "moderator"), password: ENV.fetch("QUIZZY_MODERATOR_PASSWORD", "test-password")) { |request| request.continue }
+  payload = { title: "Live browser check #{Time.now.to_i}", questions: [
+    { text: "Do not show this inactive question", active: false, options: [ { text: "Hidden yes", correct: true }, { text: "Hidden no", correct: false } ] },
+    { text: "Which are Ruby tools?", options: [ { text: "Rails & Ruby", correct: true }, { text: "Python", correct: false }, { text: "Bundler", correct: true } ] },
+    { text: "Is the update live?", options: [ { text: "Yes", correct: true }, { text: "No", correct: false } ] },
+    { text: "One last question?", options: [ { text: "Absolutely", correct: true }, { text: "Nope", correct: false } ] }
+  ] }
+  moderator.go_to("#{BASE}/moderate/quizzes/import")
+  moderator.at_css("#quiz_json").focus.type(JSON.generate(payload))
+  click(moderator, "Import")
+  wait("created quiz") { moderator.at_css("h1")&.text == payload[:title] }
+  quiz_url = moderator.url
+  click(moderator, "Start a game")
+  wait("join link") { moderator.at_css(".join-url") }
+  game_url = moderator.url
+  join_url = moderator.at_css(".join-url").text
+  check(join_url.start_with?("http://"), "Join link must be an absolute HTTP URL")
+  check(moderator.at_css(".qr-code svg path"), "Local QR code should be rendered")
+  moderator.evaluate("window.noNavigation = 'still-here'")
+  join(alice, join_url, "Alice")
+  join(bob, join_url, "Bob")
+  wait("two waiting players") { body(moderator).include?("Players: 2") }
+  moderator.screenshot(path: "/app/storage/live-lobby.png", full: true)
+  alice.screenshot(path: "/app/storage/live-phone-waiting.png", full: true)
+  alice.go_to(join_url)
+  wait("remembered player") { body(alice).include?("Hi, Alice!") }
+  alice.evaluate("window.noNavigation = 'still-here'")
+  check(body(moderator).include?("Players: 2"), "Returning browser must not add a player")
+
+  click(moderator, "Start")
+  [ moderator, alice, bob ].each do |browser|
+    wait("first question") { body(browser).include?("Question 1 of 3") }
+    check(!body(browser).include?("Do not show"), "Inactive question should be skipped")
+  end
+  check(!alice.body.include?("is-correct"), "No correct option class before Finish")
+  check(!alice.body.include?('"correct"'), "No answer key before Finish")
+  pick(alice, "Rails & Ruby")
+  wait("one answer") { body(moderator).include?("Answers: 1 / 2") }
+  pick(alice, "Python")
+  pick(bob, "Bundler")
+  wait("two answers") { body(moderator).include?("Answers: 2 / 2") }
+  join(late, join_url, "Charlie")
+  wait("late join denominator") { body(moderator).include?("Answers: 2 / 3") }
+  wait("late join question") { body(late).include?("Which are Ruby tools?") }
+  alice.screenshot(path: "/app/storage/live-phone-answer.png", full: true)
+  click(moderator, "Finish")
+  wait("Alice wrong") { body(alice).include?("Wrong!") }
+  wait("Bob correct") { body(bob).include?("Correct!") }
+  wait("Charlie no answer") { body(late).include?("No answer") }
+  check(moderator.css(".is-correct").size == 2, "Both correct options must be marked")
+  check(moderator.css(".live-option").map { |node| node.at_css(".vote-count").text } == [ "0 answers", "1 answer", "1 answer" ], "Last pick must count")
+  moderator.screenshot(path: "/app/storage/live-results.png", full: true)
+
+  # Simulate a dropped Wi-Fi connection; the player must resync, not restart.
+  alice.page.command("Network.enable")
+  alice.page.command("Network.emulateNetworkConditions", offline: true, latency: 0, downloadThroughput: 0, uploadThroughput: 0)
+  click(moderator, "Next")
+  wait("second question for Bob") { body(bob).include?("Is the update live?") }
+  wait("reconnecting notice") { body(alice).include?("Reconnecting") }
+  alice.page.command("Network.emulateNetworkConditions", offline: false, latency: 0, downloadThroughput: -1, uploadThroughput: -1)
+  wait("Alice resynced") { body(alice).include?("Is the update live?") }
+  pick(alice, "Yes")
+  click(moderator, "Finish")
+  wait("second result") { body(alice).include?("Correct!") }
+  click(moderator, "Next")
+  wait("last question") { body(alice).include?("One last question?") }
+  click(moderator, "Finish")
+  wait("end control") { moderator.css("input[type=submit]").any? { |node| node.attribute("value") == "End quiz" } }
+  click(moderator, "End quiz")
+  browsers.each do |browser|
+    wait("game over") { body(browser).include?("The quiz is over") }
+    check(browser.evaluate("window.noNavigation") == "still-here", "Live game must not navigate/reload")
+    check(browser.evaluate("document.documentElement.scrollWidth <= innerWidth"), "Screen should fit viewport")
+  end
+  late.cookies.clear
+  late.go_to(join_url)
+  wait("ended public join link") { body(late).include?("The quiz is over") }
+  check(!late.at_css('input[name="name"]'), "Cannot join an ended game")
+
+  moderator.go_to(quiz_url)
+  click(moderator, "Start a game")
+  wait("second game") { moderator.at_css(".join-url") }
+  check(moderator.url != game_url, "Starting again creates another game")
+  check(moderator.at_css(".join-url").text != join_url, "Each game has its own link")
+  check(body(moderator).include?("Players: 0"), "New game starts without players")
+  alice.go_to(moderator.at_css(".join-url").text)
+  check(alice.at_css('input[name="name"]'), "New game has its own membership")
+
+  moderator.on(:dialog) { |dialog| dialog.accept }
+  moderator.go_to(quiz_url)
+  click(moderator, "Settings")
+  click(moderator, "Delete quiz")
+  wait("cleanup") { moderator.at_css("h1")&.text == "Your quizzes" }
+  puts "PASS: live counters, QR, remembered players, late joins, private answer keys, changing answers, all feedback, Wi-Fi reconnect, no page reloads, mobile fit, ended joins, independent games."
+ensure
+  browsers.each(&:quit)
+end
