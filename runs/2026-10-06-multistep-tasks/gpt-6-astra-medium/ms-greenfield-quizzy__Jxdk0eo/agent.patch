@@ -0,0 +1,64 @@
+class Moderate::QuestionsController < Moderate::BaseController
+  before_action :set_quiz
+  before_action :set_question, only: [ :edit, :update, :destroy, :toggle, :move ]
+
+  def new
+    @question = @quiz.questions.new
+  end
+
+  def create
+    @question = @quiz.questions.new(question_params)
+    saved = false
+    @quiz.with_lock do
+      @question.position = (@quiz.questions.maximum(:position) || 0) + 1
+      saved = @question.save
+    end
+    if saved
+      redirect_to moderate_quiz_path(@quiz)
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @question.update(question_params)
+      redirect_to moderate_quiz_path(@quiz), status: :see_other
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def toggle
+    @question.update!(params.require(:question).permit(:active))
+    redirect_to moderate_quiz_path(@quiz), status: :see_other
+  end
+
+  def move
+    @question.move!(params[:direction]) if %w[up down].include?(params[:direction])
+    redirect_to moderate_quiz_path(@quiz), status: :see_other
+  end
+
+  def destroy
+    @question.destroy!
+    redirect_to moderate_quiz_path(@quiz), status: :see_other
+  end
+
+  private
+
+  def set_quiz
+    @quiz = Quiz.find(params[:quiz_id])
+  end
+
+  def set_question
+    @question = @quiz.questions.find(params[:id])
+  end
+
+  def question_params
+    permitted = params.require(:question).permit(:text, :active, option_rows: [ :text, :correct ])
+    permitted[:option_rows] = permitted[:option_rows].values.map(&:to_h) if permitted[:option_rows]
+    permitted
+  end
+end
