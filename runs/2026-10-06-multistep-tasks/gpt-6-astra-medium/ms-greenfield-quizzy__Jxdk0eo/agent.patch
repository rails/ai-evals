+require "test_helper"
+
+class GameChannelTest < ActionCable::Channel::TestCase
+  test "valid join code subscribes to invalidations only" do
+    game = Game.for_quiz!(Quiz.create!(title: "Push"))
+    subscribe(code: game.code)
+    assert subscription.confirmed?
+    assert_has_stream "game:#{game.code}"
+    assert_broadcast_on("game:#{game.code}", changed: true) do
+      game.transition!("start", expected_state: "waiting", expected_index: -1)
+    end
+    assert_broadcast_on("game:#{game.code}", changed: true) { game.select_winners!("reset") }
+  end
+
+  test "invalid join code is rejected" do
+    subscribe(code: "missing")
+    assert subscription.rejected?
+    assert_no_streams
+  end
+end
