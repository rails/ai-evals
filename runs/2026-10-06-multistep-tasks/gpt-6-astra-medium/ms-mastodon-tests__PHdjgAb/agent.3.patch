index 0000000..88edfbc
--- /dev/null
+++ b/docs/scripts/profile-factories.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+# Run one supported group only. FPROF=1 for counts/timing, FPROF=flamegraph for cascades.
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+group=${1:-models}
+case "$group" in
+  models|requests) ;;
+  *) echo 'Usage: profile-factories.sh models|requests [label]' >&2; exit 1 ;;
+esac
+label=${2:-factories}
+mkdir -p "tmp/${group}-profiles"
+bundle exec rspec "spec/${group}" --require test_prof --seed "${SEED:-12345}" --profile 15 \
+  --format progress --format json --out "tmp/${group}-profiles/${label}.json" \
+  2>&1 | tee "tmp/${group}-profiles/${label}.log"
