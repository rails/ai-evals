--- a/spec/fabricators/status_fabricator.rb
+++ b/spec/fabricators/status_fabricator.rb
@@ -7,7 +7,10 @@ Fabricator(:status) do
   after_build do |status|
     status.uri = Faker::Internet.device_token if !status.account.local? && status.uri.nil?
   end
+end
 
+# Most statuses need no bookmark (or the extra account that owns it).
+Fabricator(:bookmarked_status, from: :status) do
   after_create do |status|
     Fabricate(:bookmark, status: status)
   end
