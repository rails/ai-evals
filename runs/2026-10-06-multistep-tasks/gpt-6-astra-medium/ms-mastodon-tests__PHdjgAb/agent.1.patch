diff --git a/spec/support/model_performance.rb b/spec/support/model_performance.rb
new file mode 100644
index 0000000..2dab7b2
--- /dev/null
+++ b/spec/support/model_performance.rb
@@ -0,0 +1,12 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # Preserve explicit mode switches within examples, and restore the global
+  # setting even on failure so model defaults cannot leak to other spec types.
+  config.around :each, type: :model do |example|
+    previous_mode = Sidekiq::Testing.__global_test_mode
+    example.run
+  ensure
+    Sidekiq::Testing.__global_test_mode = previous_mode
+  end
+end
