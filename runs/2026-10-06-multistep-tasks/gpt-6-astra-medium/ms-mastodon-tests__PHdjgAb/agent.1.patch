@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+# Run only model specs. Optional TestProf profiling: TEST_STACK_PROF=1 or EVENT_PROF=...
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+label=${1:-models}
+mkdir -p tmp/model-profiles
+bundle exec rspec spec/models --require test_prof --seed "${SEED:-12345}" --profile 15 \
+  --format progress --format json --out "tmp/model-profiles/${label}.json" \
+  2>&1 | tee "tmp/model-profiles/${label}.log"
