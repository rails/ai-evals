--- /dev/null
+++ b/spec/models/fabrication_spec.rb
@@ -0,0 +1,64 @@
+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe Fabrication do
+  %i(user admin_user moderator_user owner_user private_user).each do |factory|
+    it "creates a valid #{factory} without implicit login history" do
+      user = nil
+
+      expect { user = Fabricate(factory) }
+        .to not_change(LoginActivity, :count)
+
+      expect(user).to be_persisted
+      expect(user.account).to be_persisted
+      expect(user).to be_valid
+    end
+  end
+
+  it 'creates a status with only its author account and no implicit bookmark' do
+    status = nil
+
+    expect { status = Fabricate(:status) }
+      .to change(Account, :count).by(1)
+      .and not_change(Bookmark, :count)
+      .and not_change(LoginActivity, :count)
+
+    expect(status).to be_persisted
+    expect(status).to be_valid
+  end
+
+  it 'creates exactly the requested bookmark when its status is implicit' do
+    expect { Fabricate(:bookmark) }
+      .to change(Bookmark, :count).by(1)
+      .and change(Status, :count).by(1)
+  end
+
+  it 'supports explicitly requesting a bookmarked status' do
+    status = Fabricate(:bookmarked_status)
+
+    expect(Bookmark.where(status: status)).to contain_exactly(
+      have_attributes(account: be_persisted)
+    )
+  end
+
+  it 'supports explicitly requesting login history' do
+    user = Fabricate(:user_with_login_activities)
+
+    expect(user.login_activities).to contain_exactly(
+      have_attributes(success: true, authentication_method: 'password'),
+      have_attributes(success: true, authentication_method: 'password')
+    )
+  end
+
+  it 'does not persist optional associations when building' do
+    expect do
+      Fabricate.build(:bookmarked_status)
+      Fabricate.build(:user_with_login_activities)
+    end.to not_change(Bookmark, :count)
+      .and not_change(LoginActivity, :count)
+      .and not_change(Account, :count)
+      .and not_change(User, :count)
+      .and not_change(Status, :count)
+  end
+end
