+++ b/docs/scripts/profile-requests.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+# Run only request specs. Optional TestProf profiling: TEST_STACK_PROF=1 or EVENT_PROF=...
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+label=${1:-requests}
+mkdir -p tmp/request-profiles
+bundle exec rspec spec/requests --require test_prof --seed "${SEED:-12345}" --profile 15 \
+  --format progress --format json --out "tmp/request-profiles/${label}.json" \
+  2>&1 | tee "tmp/request-profiles/${label}.log"
