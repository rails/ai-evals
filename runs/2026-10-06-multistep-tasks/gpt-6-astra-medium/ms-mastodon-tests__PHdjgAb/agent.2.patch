diff --git a/spec/support/request_performance.rb b/spec/support/request_performance.rb
new file mode 100644
index 0000000..1d8e2f5
--- /dev/null
+++ b/spec/support/request_performance.rb
@@ -0,0 +1,19 @@
+# frozen_string_literal: true
+
+RSpec.configure do |config|
+  # Keep explicit mode switches available to queue assertions, without leaking
+  # the request default (or an example's override) to other spec types.
+  config.around :each, type: :request do |example|
+    previous_mode = Sidekiq::Testing.__global_test_mode
+
+    # SQL and request debug logs are expensive across thousands of examples.
+    # Preserve warnings/errors, and opt in when debugging or testing logging.
+    if example.metadata[:verbose_logging]
+      example.run
+    else
+      Rails.logger.silence(Logger::WARN) { example.run }
+    end
+  ensure
+    Sidekiq::Testing.__global_test_mode = previous_mode
+  end
+end
