new file mode 100644
index 0000000..45c4a7c
--- /dev/null
+++ b/lib/redmine/compatibility/mail_link_metadata.rb
@@ -0,0 +1,57 @@
+# frozen_string_literal: true
+
+module Redmine
+  module Compatibility
+    # Rails 7.0 reader for Rails 7.1/7.2 JSON messages. Extend ONLY the named
+    # mail-link verifier, never ActiveSupport::MessageVerifier globally.
+    # Rails calls decode only after authenticating the original signed bytes.
+    # Translate the envelope to 7.0's in-memory representation, then let Rails
+    # enforce purpose and expiry. generate/encode and the writer are untouched.
+    module MailLinkMetadata
+      def verified(*args, **options)
+        super
+      rescue ActiveSupport::MessageVerifier::InvalidSignature
+        nil
+      end
+
+      private
+
+      def build_rotation(*args, **options)
+        super.extend(MailLinkMetadata)
+      end
+
+      def decode(data)
+        decoded = super
+        return decoded if decoded.start_with?("\x04\x08")
+
+        envelope = ActiveSupport::JSON.decode(decoded)
+        if envelope.is_a?(Hash) && envelope.key?('_rails')
+          metadata = envelope['_rails']
+          unless metadata.is_a?(Hash) &&
+              (metadata['exp'].nil? || metadata['exp'].is_a?(String)) &&
+              (metadata['pur'].nil? || metadata['pur'].is_a?(String))
+            raise ActiveSupport::MessageVerifier::InvalidSignature
+          end
+
+          Time.iso8601(metadata['exp']) if metadata['exp']
+
+          if metadata.key?('data')
+            metadata['message'] = Base64.strict_encode64(Marshal.dump(metadata.delete('data')))
+          elsif metadata['message'].is_a?(String)
+            payload = Base64.strict_decode64(metadata['message'])
+            unless payload.start_with?("\x04\x08")
+              metadata['message'] = Base64.strict_encode64(Marshal.dump(ActiveSupport::JSON.decode(payload)))
+            end
+          else
+            raise ActiveSupport::MessageVerifier::InvalidSignature
+          end
+          ActiveSupport::JSON.encode(envelope)
+        else
+          Marshal.dump(envelope)
+        end
+      rescue JSON::ParserError, ArgumentError
+        raise ActiveSupport::MessageVerifier::InvalidSignature
+      end
+    end
+  end
+end
