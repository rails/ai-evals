new file mode 100644
index 0000000..5549736
--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,36 @@
+module Api
+  module V1
+    class UsersController < BaseController
+      include Pagination
+      before_action :require_admin
+
+      def index
+        scope = current_account.users
+        if params.key?(:role)
+          return error("Invalid role", :unprocessable_entity) unless %w[admin agent customer].include?(params[:role])
+          scope = scope.where(role: params[:role])
+        end
+        if params.key?(:suspended)
+          return error("Invalid suspended filter", :unprocessable_entity) unless %w[true false].include?(params[:suspended])
+          scope = scope.where(suspended: params[:suspended] == "true")
+        end
+        render json: paginated_json(scope.order(:id), :users, &:public_json)
+      end
+
+      def show
+        render json: { user: current_account.users.find(params[:id]).public_json }
+      end
+
+      def update
+        user = current_account.users.find(params[:id])
+        attributes = params.expect(user: [:name, :suspended])
+        string_values!(attributes.slice(:name))
+        if attributes.key?(:suspended) && ![true, false].include?(attributes[:suspended])
+          raise ActionController::ParameterMissing, :suspended
+        end
+        user.update!(attributes)
+        render json: { user: user.public_json }
+      end
+    end
+  end
+end
