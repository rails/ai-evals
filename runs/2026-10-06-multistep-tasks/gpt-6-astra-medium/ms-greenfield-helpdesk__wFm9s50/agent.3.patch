+module Api
+  module V1
+    class InvitationPreviewsController < BaseController
+      skip_before_action :authenticate
+
+      def create
+        attributes = payload(:invitation_preview, [:token])
+        invitation = pending_invitation(attributes.require(:token))
+        return error("Invalid or expired token", :unprocessable_entity) unless invitation
+
