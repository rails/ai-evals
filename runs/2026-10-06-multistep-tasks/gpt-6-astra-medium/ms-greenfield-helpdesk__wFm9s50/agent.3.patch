+    if role == "customer" && account&.invitations&.pending&.exists?(email: email)
+      errors.add(:email, "has a pending invitation")
+    end
+  end
+
+  def keep_active_admin
+    if persisted? && will_save_change_to_suspended? && suspended? && role == "admin" &&
+        !account.users.where(role: "admin", suspended: false, verified: true).where.not(id: id).exists?
+      errors.add(:suspended, "cannot suspend the last active admin")
+    end
+  end
+
+  def revoke_suspended_access
+    return unless saved_change_to_suspended? && suspended?
+    sessions.destroy_all
+    account.tickets.where(assignee_id: id).update_all(assignee_id: nil, updated_at: Time.current)
+    update_columns(reset_token_digest: nil, reset_expires_at: nil,
+      verification_token_digest: nil, verification_expires_at: nil)
   end
 end
