diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..85e77d4
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,19 @@
+module Api
+  module V1
+    class InvitationAcceptancesController < InvitationPreviewsController
+      def create
+        attributes = payload(:invitation_acceptance, %i[token name password])
+        invitation = pending_invitation(attributes.require(:token))
+        return error("Invalid or expired token", :unprocessable_entity) unless invitation
+
+        user = nil
+        Invitation.transaction do
+          user = current_account.users.create!(name: attributes.require(:name), password: attributes.require(:password),
+            email: invitation.email, role: invitation.role, verified: true, owner: false)
+          invitation.update!(status: "accepted", accepted_at: Time.current)
+        end
+        render json: { user: user.public_json, account: current_account.public_json }, status: :created
+      end
+    end
+  end
+end
