+    assert_equal 1, response.parsed_body["previous_page"]
+    assert_nil response.parsed_body["next_page"]
+    ["page=0", "page=-1", "per_page=no", "per_page=0", "page[]=1"].each do |query|
+      api :get, "requests?#{query}"
+      assert_response :bad_request
+    end
+  end
