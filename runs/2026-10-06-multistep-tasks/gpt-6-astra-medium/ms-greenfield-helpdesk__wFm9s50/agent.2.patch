@@ -0,0 +1,23 @@
+class Comment < ApplicationRecord
+  belongs_to :ticket, touch: true
+  belongs_to :author, class_name: "User"
+
+  validates :body, presence: true
+  validates :public, inclusion: { in: [true, false] }
+  validate :author_belongs_to_account
+
+  scope :oldest_first, -> { order(created_at: :asc, id: :asc) }
+  scope :visible_to_customers, -> { where(public: true) }
+
+  def public_json
+    as_json(only: %i[id body public created_at]).merge("author" => author.as_json(only: %i[id name]))
+  end
+
+  private
+
+  def author_belongs_to_account
+    if author && ticket && author.account_id != ticket.account_id
+      errors.add(:author, "must belong to the ticket's account")
+    end
+  end
+end
diff --git a/app/models/ticket.rb b/app/models/ticket.rb
new file mode 100644
index 0000000..7f161a6
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,25 @@
+class Ticket < ApplicationRecord
+  STATUSES = %w[open pending solved].freeze
+
+  belongs_to :account
+  belongs_to :requester, class_name: "User"
+  has_many :comments, dependent: :destroy
+
+  validates :subject, presence: true
+  validates :status, inclusion: { in: STATUSES }
+  validate :requester_belongs_to_account
+
+  scope :recently_active, -> { order(updated_at: :desc, id: :desc) }
+
+  def public_json(staff: false)
+    as_json(only: %i[id subject status requester_id created_at updated_at]).tap do |result|
+      result["requester"] = requester.as_json(only: %i[id name email]) if staff
+    end
+  end
+
+  private
+
+  def requester_belongs_to_account
+    errors.add(:requester, "must belong to the account") if requester && requester.account_id != account_id
+  end
+end
