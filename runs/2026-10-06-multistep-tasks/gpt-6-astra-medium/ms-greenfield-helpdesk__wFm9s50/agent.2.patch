+    assert_response :ok
+    assert_equal [third, second, first], response.parsed_body["requests"].map { |r| r["id"] }
+    assert_equal({ "count" => 3, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil }, response.parsed_body.except("requests"))
+    travel 1.minute
+    api :patch, "requests/#{first}", { request: { comment: { body: "More information" } } }
+    assert_response :ok
+    api :get, "tickets?page=1&per_page=2", token: @staff_token
