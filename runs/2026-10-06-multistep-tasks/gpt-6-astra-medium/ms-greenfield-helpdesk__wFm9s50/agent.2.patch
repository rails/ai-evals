+module Api
+  module V1
+    class RequestsController < ConversationsController
+      def create
+        attributes = conversation_payload
+        raise ActionController::ParameterMissing, :comment unless attributes.key?(:comment)
+        ticket = nil
+        Ticket.transaction do
+          ticket = current_account.tickets.create!(subject: attributes[:subject], requester: current_user, status: "open")
+          ticket.comments.create!(comment_attributes(attributes))
+        end
+        render json: { request: serialize(ticket.reload) }, status: :created
+      end
+
+      private
+
+      def resource_name
+        :request
+      end
+    end
+  end
+end
