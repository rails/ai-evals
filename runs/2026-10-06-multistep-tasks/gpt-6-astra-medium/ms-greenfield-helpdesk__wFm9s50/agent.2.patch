diff --git a/app/controllers/api/v1/conversations_controller.rb b/app/controllers/api/v1/conversations_controller.rb
new file mode 100644
index 0000000..c288fe0
--- /dev/null
+++ b/app/controllers/api/v1/conversations_controller.rb
@@ -0,0 +1,87 @@
+module Api
+  module V1
+    # Requests and tickets are two authorized views of the same conversation.
+    class ConversationsController < BaseController
+      include Pagination
+      before_action :require_conversation_role
+
+      def index
+        render json: paginated_json(conversations.includes(:requester).recently_active, resource_name.to_s.pluralize) { |ticket| serialize(ticket) }
+      end
+
+      def show
+        render json: { resource_name => serialize(conversations.find(params[:id])) }
+      end
+
+      def comments
+        ticket = conversations.find(params[:id])
+        scope = ticket.comments
+        scope = scope.visible_to_customers unless staff_view?
+        render json: paginated_json(scope.includes(:author).oldest_first, :comments, &:public_json)
+      end
+
+      def update
+        ticket = conversations.find(params[:id])
+        attributes = conversation_payload
+        status = attributes[:status]
+        allowed_statuses = staff_view? ? Ticket::STATUSES : %w[open solved]
+        if attributes.key?(:status) && !allowed_statuses.include?(status)
+          return error("Invalid status", :unprocessable_entity)
+        end
+        unless attributes.key?(:status) || attributes.key?(:comment)
+          return error("A comment or status is required", :unprocessable_entity)
+        end
+
+        Ticket.transaction do
+          if attributes.key?(:comment)
+            ticket.comments.create!(comment_attributes(attributes))
+            status = "open" if !staff_view? && status != "solved"
+          end
+          ticket.update!(status: status) if status
+        end
+        render json: { resource_name => serialize(ticket.reload) }
+      end
+
+      private
+
+      def staff_view?
+        resource_name == :ticket
+      end
+
+      def require_conversation_role
+        allowed = staff_view? ? %w[admin agent].include?(current_user.role) : current_user.role == "customer"
+        error("Not authorized for this resource", :forbidden) unless allowed
+      end
+
+      def conversations
+        scope = current_account.tickets
+        staff_view? ? scope : scope.where(requester_id: current_user.id)
+      end
+
+      def serialize(ticket)
+        ticket.public_json(staff: staff_view?)
+      end
+
+      def conversation_payload
+        raw = params.require(resource_name)
+        raise ActionController::ParameterMissing, resource_name unless raw.is_a?(ActionController::Parameters)
+        string_values!(raw.slice(:subject, :status))
+        if raw.key?(:comment)
+          comment = raw[:comment]
+          raise ActionController::ParameterMissing, :comment unless comment.is_a?(ActionController::Parameters)
+          string_values!(comment.slice(:body))
+          if staff_view? && comment.key?(:public) && ![true, false].include?(comment[:public])
+            raise ActionController::ParameterMissing, :public
+          end
+        end
+        raw.permit(:subject, :status, comment: [:body, :public])
+      end
+
+      def comment_attributes(attributes)
+        comment = attributes.fetch(:comment)
+        { body: comment[:body], author: current_user,
+          public: staff_view? ? comment.fetch(:public, true) : true }
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/registrations_controller.rb b/app/controllers/api/v1/registrations_controller.rb
