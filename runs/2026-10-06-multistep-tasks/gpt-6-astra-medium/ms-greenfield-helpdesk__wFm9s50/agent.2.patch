@@ -0,0 +1,19 @@
+module Api
+  module V1
+    class RegistrationsController < BaseController
+      skip_before_action :authenticate
+
+      def create
+        user = nil
+        token = nil
+        User.transaction do
+          user = current_account.users.create!(payload(:user, %i[name email password]).merge(
+            role: "customer", owner: false, verified: false))
+          token = user.issue_verification!
+        end
+        AccountMailer.verification(user, token).deliver_now
+        render json: { user: user.public_json }, status: :created
+      end
+    end
+  end
+end
