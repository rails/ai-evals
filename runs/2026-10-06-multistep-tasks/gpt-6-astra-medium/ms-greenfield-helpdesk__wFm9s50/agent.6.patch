+      def index
+        render json: paginated_json(current_account.groups.order(:id), :groups, &:public_json)
+      end
+
+      def show
+        render json: { group: current_account.groups.find(params[:id]).public_json }
+      end
+
+      def create
+        group = current_account.groups.create!(payload(:group, [:name]))
+        render json: { group: group.public_json }, status: :created
+      end
+
+      def update
+        group = current_account.groups.find(params[:id])
+        group.update!(payload(:group, [:name]))
+        render json: { group: group.public_json }
+      end
+
+      def destroy
+        current_account.groups.find(params[:id]).destroy!
+        head :no_content
+      end
+    end
+  end
+end
