+    assert_response :ok
+    api :get, "groups/#{billing}", token: @agent_token
+    assert_equal "Accounts", response.parsed_body.dig("group", "name")
+    api :delete, "groups/#{technical}"
+    assert_response :no_content
+    api :get, "groups/#{technical}"
+    assert_response :not_found
+    api :post, "groups", { group: { name: " " } }
