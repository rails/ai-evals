+  test "legacy page number responses and activity ordering stay unchanged" do
+    records = 3.times.map { make_ticket }
+    records.first.touch(time: 1.hour.from_now)
+    body = fetch_page("/api/v1/tickets", page: "1", per_page: "2")
+    assert_equal [records.first.id, records.last.id], ids(body, "tickets")
