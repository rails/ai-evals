+  def cursor_paginated_json(scope, key, order)
+    raise ActionController::ParameterMissing, :per_page if params.key?(:per_page)
+    filters = request.query_parameters.except("page", "per_page")
+    context = [current_account.id, current_user.id, current_user.role, request.path, filters.to_query]
+    page = CursorPage.new(scope: scope, order: order, page: params[:page].to_unsafe_h, context: context)
