+    %i[users invitations groups group_memberships].each do |table|
+      add_index table, [:account_id, :id], algorithm: :concurrently
+    end
+    add_index :group_memberships, [:account_id, :group_id, :id],
+      name: "index_group_memberships_on_group_cursor", algorithm: :concurrently
+    add_index :group_memberships, [:account_id, :user_id, :id],
+      name: "index_group_memberships_on_user_cursor", algorithm: :concurrently
+  end
+end
