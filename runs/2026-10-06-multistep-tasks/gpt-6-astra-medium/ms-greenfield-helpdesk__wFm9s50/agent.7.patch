+
+  test "merge chains retain the original links and cannot form cycles" do
+    third = @account.tickets.create!(subject: "Third", requester: @customer, status: "solved")
+    merge
+    original_note = @source.comments.sole.attributes
+    merge(source: @target, target: third)
+    assert_response :ok
+    assert_equal @target.id, @source.reload.merged_into_id
+    assert_equal third.id, @target.reload.merged_into_id
+    assert_equal "solved", third.reload.status
+    assert_equal original_note, @source.comments.sole.attributes
+    assert_no_difference "Comment.count" do
