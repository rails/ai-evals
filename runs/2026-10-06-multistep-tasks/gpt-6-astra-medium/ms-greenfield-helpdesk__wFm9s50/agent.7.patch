+  test "malformed merge parameters are rejected without side effects" do
+    invalid = [nil, [], "bad", {}, { target_id: nil }, { target_id: [] }, { target_id: {} },
+      { target_id: true }, { target_id: 1.5 }, { target_id: 0 }, { target_id: -1 }, { target_id: "1junk" }]
+    %i[source_comment target_comment].each do |side|
+      [nil, [], "bad", { body: 3 }, { body: nil }, { public: "false" }, { public: nil }].each do |note|
+        invalid << { target_id: @target.id, side => note }
+      end
+    end
+    assert_no_difference "Comment.count" do
