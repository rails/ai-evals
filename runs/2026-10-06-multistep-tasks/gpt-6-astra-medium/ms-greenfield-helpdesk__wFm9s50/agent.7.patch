+  test "assignment cleanup continues to apply to closed tickets" do
+    group = @account.groups.create!(name: "Support")
+    member = @account.group_memberships.create!(group: group, user: @staff)
+    [@source, @target].each { |ticket| ticket.update!(group: group, assignee: @staff) }
+    merge
