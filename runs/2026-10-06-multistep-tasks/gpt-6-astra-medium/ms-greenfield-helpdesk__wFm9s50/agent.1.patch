@@ -0,0 +1,26 @@
+module Api
+  module V1
+    class SessionsController < BaseController
+      skip_before_action :authenticate, only: :create
+      skip_before_action :require_active_account
+
+      def create
+        attributes = payload(:session, [:email, :password])
+        user = current_account.users.find_by(email: attributes.require(:email))
+        unless user&.authenticate(attributes.require(:password))
+          return error("Invalid email or password", :unauthorized)
+        end
+        return error("Email verification required", :forbidden) unless user.verified?
+        return error("Account is cancelled", :forbidden) unless recovery_allowed?(user)
+
+        token = Session.issue!(user)
+        render json: { user: user.public_json, account: current_account.public_json, session: { token: token } }
+      end
+
+      def destroy
+        current_session.destroy!
+        head :no_content
+      end
+    end
+  end
+end
