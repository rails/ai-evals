@@ -0,0 +1,22 @@
+class AccountMailer < ApplicationMailer
+  def verification(user, token)
+    @link = frontend_link("/verify-email", user, token)
+    mail(to: user.email, subject: "Verify your email") do |format|
+      format.text { render plain: "Verify your email for #{user.account.name}:\n\n#{@link}\n\nThis link expires in 24 hours." }
+    end
+  end
+
+  def password_reset(user, token)
+    @link = frontend_link("/reset-password", user, token)
+    mail(to: user.email, subject: "Reset your password") do |format|
+      format.text { render plain: "Reset your password for #{user.account.name}:\n\n#{@link}\n\nThis link expires in 1 hour. If you did not request it, ignore this email." }
+    end
+  end
+
+  private
+
+  def frontend_link(path, user, token)
+    base = ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001").chomp("/")
+    "#{base}#{path}?#{URI.encode_www_form(account: user.account.subdomain, token: token)}"
+  end
+end
