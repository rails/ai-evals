+module Api
+  module V1
+    class PasswordResetsController < BaseController
+      skip_before_action :authenticate, :require_active_account
+
+      def create
+        attributes = payload(:password_reset, [:email])
+        user = current_account.users.find_by(email: attributes.require(:email))
+        if recovery_allowed?(user)
+          AccountMailer.password_reset(user, user.issue_password_reset!).deliver_now
+        end
+        render json: { message: "If eligible, a password reset link has been sent" }, status: :accepted
+      end
+
+      def confirm
+        attributes = payload(:password_reset, [:token, :password])
+        user = current_account.users.where("reset_expires_at > ?", Time.current)
+          .find_by(reset_token_digest: Session.digest(attributes.require(:token)))
+        return error("Invalid or expired token", :unprocessable_entity) unless recovery_allowed?(user)
+
+        user.change_password!(attributes.require(:password))
+        head :no_content
+      end
+    end
+  end
+end
