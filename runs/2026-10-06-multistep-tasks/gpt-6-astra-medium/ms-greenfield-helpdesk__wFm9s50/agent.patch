new file mode 100644
index 0000000..7a70e61
--- /dev/null
+++ b/app/controllers/api/v1/tickets_controller.rb
@@ -0,0 +1,39 @@
+module Api
+  module V1
+    class TicketsController < ConversationsController
+      def merge
+        attributes = merge_payload
+        source, target = TicketMerge.call(account: current_account, author: current_user,
+          source_id: params[:id], **attributes)
+        render json: { source: serialize(source), target: serialize(target) }
+      end
+
+      private
+
+      def merge_payload
+        raw = params.require(:merge)
+        raise ActionController::ParameterMissing, :merge unless raw.is_a?(ActionController::Parameters)
+        id = raw[:target_id]
+        unless (id.is_a?(Integer) && id.positive?) || (id.is_a?(String) && id.match?(/\A[1-9][0-9]*\z/))
+          raise ActionController::ParameterMissing, :target_id
+        end
+        attributes = { target_id: id }
+        %i[source_comment target_comment].each do |key|
+          next unless raw.key?(key)
+          note = raw[key]
+          raise ActionController::ParameterMissing, key unless note.is_a?(ActionController::Parameters)
+          string_values!(note.slice(:body))
+          if note.key?(:public) && ![true, false].include?(note[:public])
+            raise ActionController::ParameterMissing, :public
+          end
+          attributes[key] = note.permit(:body, :public).to_h.symbolize_keys
+        end
+        attributes
+      end
+
+      def resource_name
+        :ticket
+      end
+    end
+  end
+end
