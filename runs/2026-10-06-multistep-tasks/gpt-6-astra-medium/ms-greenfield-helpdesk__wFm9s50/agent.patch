+    api :get, "tickets", { q: "receipt", per_page: "1", page: "2" }
+    assert_equal [subject.id], response.parsed_body["tickets"].map { |t| t["id"] }
+  end
+
+  test "search treats SQL wildcard characters and punctuation literally" do
+    percent = ticket(subject: "100% paid")
