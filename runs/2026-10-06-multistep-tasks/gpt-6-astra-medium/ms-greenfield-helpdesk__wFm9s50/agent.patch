+    t.index ["assignee_id"], name: "index_tickets_on_assignee_id"
+    t.index ["email_reply_token"], name: "index_tickets_on_email_reply_token", unique: true
+    t.index ["group_id"], name: "index_tickets_on_group_id"
+    t.index ["merged_into_id"], name: "index_tickets_on_merged_into_id"
+    t.index ["requester_id"], name: "index_tickets_on_requester_id"
+    t.check_constraint "merged_into_id IS NULL OR merged_into_id <> id AND status::text = 'closed'::text", name: "valid_ticket_merge"
+    t.check_constraint "priority::text = ANY (ARRAY['normal'::character varying, 'high'::character varying]::text[])", name: "valid_ticket_priority"
+    t.check_constraint "source::text = ANY (ARRAY['portal'::character varying, 'email'::character varying]::text[])", name: "valid_ticket_source"
+    t.check_constraint "status::text = ANY (ARRAY['open'::character varying, 'pending'::character varying, 'solved'::character varying, 'closed'::character varying]::text[])", name: "valid_ticket_status"
+  end
+
+  create_table "users", force: :cascade do |t|
+    t.bigint "account_id", null: false
+    t.string "name", null: false
+    t.string "email", null: false
+    t.string "password_digest", null: false
+    t.string "role", default: "admin", null: false
+    t.boolean "owner", default: false, null: false
+    t.boolean "verified", default: false, null: false
+    t.string "verification_token_digest"
+    t.datetime "verification_expires_at"
+    t.string "reset_token_digest"
+    t.datetime "reset_expires_at"
+    t.datetime "created_at", null: false
+    t.datetime "updated_at", null: false
+    t.boolean "suspended", default: false, null: false
+    t.index ["account_id", "email"], name: "index_users_on_account_id_and_email", unique: true
+    t.index ["account_id", "id"], name: "index_users_on_account_id_and_id"
+    t.index ["account_id"], name: "index_users_on_account_id"
+    t.index ["account_id"], name: "one_owner_per_account", unique: true, where: "(owner = true)"
+    t.index ["reset_token_digest"], name: "index_users_on_reset_token_digest", unique: true
+    t.index ["verification_token_digest"], name: "index_users_on_verification_token_digest", unique: true
+    t.check_constraint "role::text = ANY (ARRAY['admin'::character varying, 'agent'::character varying, 'customer'::character varying]::text[])", name: "valid_user_role"
+  end
+
+  add_foreign_key "active_storage_attachments", "active_storage_blobs", column: "blob_id"
+  add_foreign_key "active_storage_variant_records", "active_storage_blobs", column: "blob_id"
+  add_foreign_key "comments", "tickets", on_delete: :cascade
+  add_foreign_key "comments", "users", column: "author_id", on_delete: :cascade
+  add_foreign_key "group_memberships", "accounts", on_delete: :cascade
+  add_foreign_key "group_memberships", "groups", on_delete: :cascade
+  add_foreign_key "group_memberships", "users", on_delete: :cascade
+  add_foreign_key "groups", "accounts", on_delete: :cascade
+  add_foreign_key "invitations", "accounts", on_delete: :cascade
+  add_foreign_key "sessions", "users", on_delete: :cascade
+  add_foreign_key "tickets", "accounts", on_delete: :cascade
+  add_foreign_key "tickets", "groups", on_delete: :nullify
+  add_foreign_key "tickets", "tickets", column: "merged_into_id", on_delete: :nullify
+  add_foreign_key "tickets", "users", column: "assignee_id", on_delete: :nullify
+  add_foreign_key "tickets", "users", column: "requester_id", on_delete: :cascade
+  add_foreign_key "users", "accounts", on_delete: :cascade
+end
