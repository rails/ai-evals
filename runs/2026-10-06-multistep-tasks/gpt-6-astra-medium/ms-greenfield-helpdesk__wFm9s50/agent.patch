@@ -0,0 +1,27 @@
+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      skip_before_action :authenticate, :require_active_account
+
+      def create
+        attributes = payload(:email_verification, [:email])
+        user = current_account.users.find_by(email: attributes.require(:email))
+        if recovery_allowed?(user) && !user.verified?
+          AccountMailer.verification(user, user.issue_verification!).deliver_now
+        end
+        render json: { message: "If eligible, a verification link has been sent" }, status: :accepted
+      end
+
+      def confirm
+        attributes = payload(:email_verification, [:token])
+        user = current_account.users.where("verification_expires_at > ?", Time.current)
+          .find_by(verification_token_digest: Session.digest(attributes.require(:token)))
+        unless recovery_allowed?(user) && !user.verified?
+          return error("Invalid or expired token", :unprocessable_entity)
+        end
+        user.update!(verified: true, verification_token_digest: nil, verification_expires_at: nil)
+        render json: { user: user.public_json }
+      end
+    end
+  end
+end
