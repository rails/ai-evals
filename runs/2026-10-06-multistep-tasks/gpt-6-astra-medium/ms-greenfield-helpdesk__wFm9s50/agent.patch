+++ b/test/integration/portal_conversations_test.rb
@@ -0,0 +1,323 @@
+require "test_helper"
+
+class PortalConversationsTest < ActionDispatch::IntegrationTest
+  PASSWORD = "my-customer-password"
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @owner = @account.users.create!(name: "Owner", email: "owner@example.test",
+      password: PASSWORD, role: "admin", owner: true, verified: true)
+    @staff_token = Session.issue!(@owner)
+  end
+
+  def api(method, path, data = nil, token: @customer_token, account: "acme")
+    headers = { "X-Helpdesk-Account" => account }
+    headers["Authorization"] = "Bearer #{token}" if token
+    public_send(method, "/api/v1/#{path}", params: data, headers: headers, as: :json)
+  end
+
+  def register_customer
+    api :post, "registrations", { user: { name: "Avery", email: "avery@example.test", password: PASSWORD,
+      role: "admin", owner: true, verified: true, account_id: 999 } }, token: nil
+    assert_response :created
+    @customer = @account.users.find_by!(email: "avery@example.test")
+    assert_equal "customer", @customer.role
+    assert_not @customer.owner?
+    assert_not @customer.verified?
+    verification = ActionMailer::Base.deliveries.last.body.decoded.match(/token=([A-Za-z0-9_-]+)/)[1]
+    api :post, "sessions", { session: { email: @customer.email, password: PASSWORD } }, token: nil
+    assert_response :forbidden
+    api :post, "email_verifications/confirm", { email_verification: { token: verification } }, token: nil
+    assert_response :ok
+    api :post, "sessions", { session: { email: @customer.email, password: PASSWORD } }, token: nil
+    assert_response :ok
+    @customer_token = response.parsed_body.dig("session", "token")
+  end
+
+  def open_request(subject = "Cannot download my receipt")
+    api :post, "requests", { request: { subject: subject, comment: { body: "The download button does nothing." } } }
+    assert_response :created
+    response.parsed_body.fetch("request")
+  end
+
+  test "customer registration and portal conversation lifecycle" do
+    register_customer
+    record = open_request
+    id = record.fetch("id")
+    assert_equal "open", record["status"]
+    assert_equal @customer.id, record["requester_id"]
+    assert record["created_at"]
+    assert record["updated_at"]
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      api :patch, "tickets/#{id}", { ticket: { comment: { body: "Please try again now." }, status: "pending" } }, token: @staff_token
+      assert_response :ok
+      assert_equal "pending", response.parsed_body.dig("ticket", "status")
+      assert_equal({ "id" => @customer.id, "name" => "Avery", "email" => @customer.email }, response.parsed_body.dig("ticket", "requester"))
+      api :patch, "requests/#{id}", { request: { comment: { body: "Still broken" } } }
+      assert_response :ok
+      assert_equal "open", response.parsed_body.dig("request", "status")
+      api :patch, "requests/#{id}", { request: { comment: { body: "Works now" }, status: "solved" } }
+      assert_response :ok
+      assert_equal "solved", response.parsed_body.dig("request", "status")
+      api :patch, "tickets/#{id}", { ticket: { comment: { body: "Thanks!" } } }, token: @staff_token
+      assert_response :ok
+      assert_equal "solved", response.parsed_body.dig("ticket", "status")
+      api :get, "requests/#{id}/comments"
+      assert_response :ok
+      comments = response.parsed_body.fetch("comments")
+      assert_equal ["The download button does nothing.", "Please try again now.", "Still broken", "Works now", "Thanks!"], comments.map { |c| c["body"] }
+      assert_equal({ "id" => @customer.id, "name" => "Avery" }, comments.first["author"])
+      assert comments.all? { |c| c["public"] && c["created_at"] }
+    end
+  end
+
+  test "registration is tenant scoped, validated, normalized and uses existing profile and recovery" do
+    register_customer
+    assert_no_difference ["User.count", "ActionMailer::Base.deliveries.size"] do
+      api :post, "registrations", { user: { name: "Other", email: " AVERY@EXAMPLE.TEST ", password: PASSWORD } }
+      assert_response :unprocessable_entity
+      api :post, "registrations", { user: { name: "", email: "bad", password: "short" } }
+      assert_response :unprocessable_entity
+      api :post, "registrations", { user: "bad" }
+      assert_response :bad_request
+    end
+    other = Account.create!(name: "Other", subdomain: "other")
+    api :post, "registrations", { user: { name: " Avery ", email: " AVERY@EXAMPLE.TEST ", password: PASSWORD } }, account: "other", token: nil
+    assert_response :created
+    assert_equal "Avery", other.users.sole.name
+    assert_equal @customer.email, other.users.sole.email
+
+    api :get, "me"
+    assert_response :ok
+    assert_equal @customer.id, response.parsed_body.dig("user", "id")
+    api :patch, "me", { user: { name: "Avery Updated", role: "admin" } }
+    assert_response :ok
+    assert_equal "Avery Updated", @customer.reload.name
+    assert_equal "customer", @customer.role
+    api :post, "password_resets", { password_reset: { email: @customer.email } }, token: nil
+    assert_response :accepted
+    reset = ActionMailer::Base.deliveries.last.body.decoded.match(/token=([A-Za-z0-9_-]+)/)[1]
+    api :post, "password_resets/confirm", { password_reset: { token: reset, password: "replacement-password" } }, token: nil
+    assert_response :no_content
+    api :get, "requests"
+    assert_response :unauthorized
+    api :post, "sessions", { session: { email: @customer.email, password: "replacement-password" } }, token: nil
+    assert_response :ok
+  end
+
+  test "customers see only their requests and cannot use staff routes or another portal" do
+    register_customer
+    id = open_request.fetch("id")
+    other = @account.users.create!(name: "Other", email: "other@example.test", password: PASSWORD, role: "customer", verified: true)
+    other_token = Session.issue!(other)
+    %W[requests/#{id} requests/#{id}/comments].each do |path|
+      api :get, path, token: other_token
+      assert_response :not_found
+    end
+    api :patch, "requests/#{id}", { request: { status: "solved" } }, token: other_token
+    assert_response :not_found
+    api :get, "requests", token: other_token
+    assert_response :ok
+    assert_empty response.parsed_body["requests"]
+    assert_equal 0, response.parsed_body["count"]
+    %W[tickets tickets/#{id} tickets/#{id}/comments].each do |path|
+      api :get, path
+      assert_response :forbidden
+    end
+    api :patch, "tickets/#{id}", { ticket: { status: "solved" } }
+    assert_response :forbidden
+    api :get, "requests", token: @staff_token
+    assert_response :forbidden
+
+    account = Account.create!(name: "Other", subdomain: "other")
+    staff = account.users.create!(name: "Agent", email: "agent@example.test", password: PASSWORD, role: "agent", verified: true)
+    token = Session.issue!(staff)
+    api :get, "tickets/#{id}", token: token, account: "other"
+    assert_response :not_found
+    api :get, "tickets/#{id}/comments", token: token, account: "other"
+    assert_response :not_found
+    api :patch, "tickets/#{id}", { ticket: { status: "solved" } }, token: token, account: "other"
+    assert_response :not_found
+    api :get, "tickets", token: @staff_token, account: "other"
+    assert_response :unauthorized
+    api :get, "requests", token: nil
+    assert_response :unauthorized
+  end
+
+  test "staff agents can reply and private notes stay out of customer comments and counts" do
+    register_customer
+    id = open_request.fetch("id")
+    agent = @account.users.create!(name: "Agent", email: "agent@example.test", password: PASSWORD, role: "agent", verified: true)
+    token = Session.issue!(agent)
+    api :patch, "tickets/#{id}", { ticket: { comment: { body: "Internal note", public: false }, status: "pending" } }, token: token
+    assert_response :ok
+    api :get, "tickets/#{id}/comments", token: token
+    assert_response :ok
+    assert_equal 2, response.parsed_body["count"]
+    assert_equal false, response.parsed_body["comments"].last["public"]
+    api :get, "requests/#{id}/comments"
+    assert_response :ok
+    assert_equal 1, response.parsed_body["count"]
+    assert_equal 1, response.parsed_body["comments"].size
+    api :patch, "requests/#{id}", { request: { comment: { body: "Customer reply", public: false, author_id: agent.id } } }
+    assert_response :ok
+    assert_equal "open", response.parsed_body.dig("request", "status")
+    comment = Ticket.find(id).comments.order(:id).last
+    assert comment.public?
+    assert_equal @customer.id, comment.author_id
+  end
+
+  test "invalid creation and updates leave no partial records or timestamp changes" do
+    register_customer
+    assert_no_difference ["Ticket.count", "Comment.count"] do
+      api :post, "requests", { request: { subject: "Test", comment: { body: "  " } } }
+      assert_response :unprocessable_entity
+      api :post, "requests", { request: { subject: "", comment: { body: "Hello" } } }
+      assert_response :unprocessable_entity
+      api :post, "requests", { request: { subject: "Test" } }
+      assert_response :bad_request
+    end
+    id = open_request.fetch("id")
+    ticket = Ticket.find(id)
+    updated_at = ticket.updated_at
+    assert_no_difference "Comment.count" do
+      api :patch, "tickets/#{id}", { ticket: { status: "pending", comment: { body: " " } } }, token: @staff_token
+      assert_response :unprocessable_entity
+      api :patch, "tickets/#{id}", { ticket: { status: "closed", comment: { body: "Hello" } } }, token: @staff_token
+      assert_response :unprocessable_entity
+      api :patch, "requests/#{id}", { request: { status: "pending", comment: { body: "Hello" } } }
+      assert_response :unprocessable_entity
+    end
+    assert_equal "open", ticket.reload.status
+    assert_equal updated_at, ticket.updated_at
+    [ { request: "bad" }, { request: { comment: "bad" } }, { request: { comment: { body: 123 } } },
+      { request: { status: [] } }, { request: { subject: 123 } } ].each do |payload|
+      api :patch, "requests/#{id}", payload
+      assert_response :bad_request
+    end
+    api :patch, "tickets/#{id}", { ticket: { comment: { body: "Test", public: "false" } } }, token: @staff_token
+    assert_response :bad_request
+  end
+
+  test "customer replies reopen pending and solved while explicit solved wins" do
+    register_customer
+    id = open_request.fetch("id")
+    %w[pending solved].each do |status|
+      api :patch, "tickets/#{id}", { ticket: { status: status } }, token: @staff_token
+      assert_response :ok
+      api :patch, "tickets/#{id}", { ticket: { comment: { body: "Staff reply" } } }, token: @staff_token
+      assert_response :ok
+      assert_equal status, response.parsed_body.dig("ticket", "status")
+      api :patch, "requests/#{id}", { request: { comment: { body: "Customer reply" } } }
+      assert_response :ok
+      assert_equal "open", response.parsed_body.dig("request", "status")
+      api :patch, "tickets/#{id}", { ticket: { status: status } }, token: @staff_token
+      api :patch, "requests/#{id}", { request: { status: "solved", comment: { body: "All fixed" } } }
+      assert_response :ok
+      assert_equal "solved", response.parsed_body.dig("request", "status")
+    end
+  end
+
+  test "lists paginate consistently and replies move requests to the top" do
+    register_customer
+    freeze_time
+    first = open_request("First").fetch("id")
+    second = open_request("Second").fetch("id")
+    third = open_request("Third").fetch("id")
+    api :get, "requests"
+    assert_response :ok
+    assert_equal [third, second, first], response.parsed_body["requests"].map { |r| r["id"] }
+    assert_equal({ "count" => 3, "page" => 1, "per_page" => 25, "next_page" => nil, "previous_page" => nil }, response.parsed_body.except("requests"))
+    travel 1.minute
+    api :patch, "requests/#{first}", { request: { comment: { body: "More information" } } }
+    assert_response :ok
+    api :get, "tickets?page=1&per_page=2", token: @staff_token
+    assert_response :ok
+    assert_equal [first, third], response.parsed_body["tickets"].map { |r| r["id"] }
+    assert_equal 2, response.parsed_body["next_page"]
+    assert_nil response.parsed_body["previous_page"]
+    api :get, "requests?page=2&per_page=2"
+    assert_response :ok
+    assert_equal [second], response.parsed_body["requests"].map { |r| r["id"] }
+    assert_equal 3, response.parsed_body["count"]
+    assert_equal 1, response.parsed_body["previous_page"]
+    assert_nil response.parsed_body["next_page"]
+    api :get, "requests?page=9&per_page=2"
+    assert_response :ok
+    assert_empty response.parsed_body["requests"]
+    api :get, "requests/#{first}/comments?page=2&per_page=1"
+    assert_response :ok
+    assert_equal "More information", response.parsed_body["comments"].sole["body"]
+    assert_equal 2, response.parsed_body["count"]
+    assert_equal 1, response.parsed_body["previous_page"]
+    assert_nil response.parsed_body["next_page"]
+    ["page=0", "page=-1", "per_page=no", "per_page=0", "page[]=1"].each do |query|
+      api :get, "requests?#{query}"
+      assert_response :bad_request
+    end
+  end
+
+  test "cancelled accounts reject registration and conversations and purge deletes conversations" do
+    register_customer
+    id = open_request.fetch("id")
+    @account.update!(cancelled_at: 91.days.ago)
+    assert_no_difference ["User.count", "ActionMailer::Base.deliveries.size"] do
+      api :post, "registrations", { user: { name: "New", email: "new@example.test", password: PASSWORD } }, token: nil
+      assert_response :forbidden
+    end
+    api :get, "requests"
+    assert_response :forbidden
+    api :patch, "tickets/#{id}", { ticket: { status: "solved" } }, token: @staff_token
+    assert_response :forbidden
+    assert_equal 1, Account.purge_cancelled!
+    assert_not Ticket.exists?(id)
+    assert_not Comment.exists?(ticket_id: id)
+  end
+
+  test "default limits and extreme pages work for all conversation lists" do
+    register_customer
+    freeze_time
+    tickets = 26.times.map do |i|
+      @account.tickets.create!(subject: "Request #{i}", requester: @customer)
+    end
+    [["requests", @customer_token], ["tickets", @staff_token]].each do |resource, token|
+      api :get, resource, token: token
+      assert_response :ok
+      assert_equal 26, response.parsed_body["count"]
+      assert_equal 25, response.parsed_body[resource].size
+      assert_equal tickets.reverse.take(25).map(&:id), response.parsed_body[resource].map { |t| t["id"] }
+      assert_equal 2, response.parsed_body["next_page"]
+      api :get, "#{resource}?page=99999999999999999999999", token: token
+      assert_response :ok
+      assert_empty response.parsed_body[resource]
+    end
+    ticket = tickets.first
+    comments = 26.times.map { |i| ticket.comments.create!(body: "Reply #{i}", author: @customer) }
+    api :get, "requests/#{ticket.id}/comments"
+    assert_response :ok
+    assert_equal 26, response.parsed_body["count"]
+    assert_equal comments.take(25).map(&:id), response.parsed_body["comments"].map { |c| c["id"] }
+    assert_equal 2, response.parsed_body["next_page"]
+    api :get, "tickets/#{ticket.id}/comments?per_page=99999999999999999999999", token: @staff_token
+    assert_response :ok
+    assert_equal 26, response.parsed_body["comments"].size
+    assert_nil response.parsed_body["next_page"]
+  end
+
+  test "request identity status and comment author cannot be supplied by the customer" do
+    register_customer
+    api :post, "requests", { request: { subject: "Test", status: "solved", account_id: 999,
+      requester_id: @owner.id, comment: { body: "Hello", author_id: @owner.id, public: false } } }
+    assert_response :created
+    ticket = Ticket.find(response.parsed_body.dig("request", "id"))
+    assert_equal @account, ticket.account
+    assert_equal @customer, ticket.requester
+    assert_equal "open", ticket.status
+    assert_equal @customer, ticket.comments.sole.author
+    assert ticket.comments.sole.public?
+    @customer.reload.update!(verified: false)
+    api :get, "requests"
+    assert_response :unauthorized
+  end
+end
