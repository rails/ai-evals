+  end
+
+  test "merge only allows authenticated staff and same-account tickets" do
+    other = Account.create!(name: "Other", subdomain: "merge-other")
+    outsider = other.users.create!(name: "Other", email: @customer.email,
+      password: "merge-password", role: "customer", verified: true)
