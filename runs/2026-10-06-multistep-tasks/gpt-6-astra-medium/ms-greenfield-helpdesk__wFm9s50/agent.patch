+  namespace :api do
+    namespace :v1 do
+      post "account/create", to: "accounts#create"
+      get "portal", to: "accounts#portal"
+      get "account", to: "accounts#show"
+      post "account/cancel", to: "accounts#cancel"
+      post "account/reactivate", to: "accounts#reactivate"
+      resources :invitations, only: %i[index show create destroy] do
+        post :resend, on: :member
+      end
+      post "invitation_previews", to: "invitation_previews#create"
+      post "invitation_acceptances", to: "invitation_acceptances#create"
+      resources :users, only: %i[index show update]
+      get "staff", to: "staff#index"
+      resources :groups, only: %i[index show create update destroy]
+      resources :group_memberships, only: %i[index show create destroy] do
+        put :make_default, on: :member
+      end
+      post "registrations", to: "registrations#create"
+      resources :requests, only: %i[index create show update] do
+        get :comments, on: :member
