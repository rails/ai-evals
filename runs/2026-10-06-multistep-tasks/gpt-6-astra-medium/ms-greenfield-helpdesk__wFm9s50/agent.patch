+    assert_tickets [subject, public_reply], q: "rEcEiPt"
+    api :get, "tickets", { q: "receipt", per_page: "1" }
+    assert_response :ok
+    assert_equal 2, response.parsed_body["count"]
+    assert_equal [public_reply.id], response.parsed_body["tickets"].map { |t| t["id"] }
