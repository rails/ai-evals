+
+  test "merge validation failures leave both tickets and comments untouched" do
+    other_customer = @account.users.create!(name: "Other", email: "other@example.test",
+      password: "merge-password", role: "customer", verified: true)
+    other_ticket = @account.tickets.create!(subject: "Other customer", requester: other_customer)
