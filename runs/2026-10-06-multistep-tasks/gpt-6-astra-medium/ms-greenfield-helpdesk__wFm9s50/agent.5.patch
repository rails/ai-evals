--- /dev/null
+++ b/config/initializers/action_mailbox.rb
@@ -0,0 +1,8 @@
+# Route and deliver mail within test requests. Do not make all jobs inline:
+# incineration schedules future jobs, which the inline adapter cannot handle.
+Rails.application.config.to_prepare do
+  if Rails.env.test?
+    ActionMailbox::RoutingJob.queue_adapter = :inline
+    ActionMailer::MailDeliveryJob.queue_adapter = :inline
+  end
+end
