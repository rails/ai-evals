new file mode 100644
index 0000000..f593fdc
--- /dev/null
+++ b/app/mailers/ticket_mailer.rb
@@ -0,0 +1,12 @@
+class TicketMailer < ApplicationMailer
+  def reply(comment)
+    ticket = comment.ticket
+    return unless comment.public? && comment.author.staff? && ticket.email_origin?
+
+    headers["Auto-Submitted"] = "auto-generated"
+    mail(to: ticket.requester.email, from: SupportEmail.address(ticket.account),
+      reply_to: ticket.reply_email_address, subject: "Re: #{ticket.subject}") do |format|
+      format.text { render plain: comment.body }
+    end
+  end
+end
