+module Api
+  module V1
+    class RegistrationsController < BaseController
+      skip_before_action :authenticate!
+
+      def create
+        attributes = string_attributes!(params.expect(user: [ :name, :email, :password ]))
+        User.transaction do
+          @customer = @account.users.create!(attributes.merge(role: "customer"))
+          @verification_token = @customer.issue_token!(:verification)
+        end
+        UserMailer.verification(@customer, @verification_token).deliver_now
+        render json: { user: @customer.api_json }, status: :created
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/requests_controller.rb b/app/controllers/api/v1/requests_controller.rb
