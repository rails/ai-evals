@@ -0,0 +1,36 @@
+module Api
+  module V1
+    class RequestsController < ConversationsController
+      before_action :require_customer!
+
+      def create
+        attributes = conversation_attributes(create: true)
+        comment = attributes.require(:comment)
+        ticket = nil
+        Ticket.transaction do
+          ticket = conversations.create!(subject: attributes[:subject], requester: @user)
+          ticket.comments.create!(comment_attributes(comment))
+        end
+        render_conversation(ticket.reload, status: :created)
+      end
+
+      private
+
+      def require_customer!
+        render_error(:forbidden, "customer_required", "Only customers can access requests.") unless @user.customer?
+      end
+
+      def conversations
+        @account.tickets.where(requester_id: @user.id)
+      end
+
+      def resource_name
+        :request
+      end
+
+      def staff_view?
+        false
+      end
+    end
+  end
+end
