+class Comment < ApplicationRecord
+  belongs_to :ticket, touch: true
+  belongs_to :author, class_name: "User"
+
+  validates :body, presence: true
+  validates :public, inclusion: { in: [ true, false ] }
+  validate :author_belongs_to_account
+
+  scope :visible_to_customers, -> { where(public: true) }
+  scope :chronological, -> { order(created_at: :asc, id: :asc) }
+
+  def api_json
+    as_json(only: %i[id body public created_at]).merge("author" => author.as_json(only: %i[id name]))
+  end
+
+  private
+
+  def author_belongs_to_account
+    if author && ticket && author.account_id != ticket.account_id
+      errors.add(:author, "must belong to the ticket's account")
+    end
+  end
+end
