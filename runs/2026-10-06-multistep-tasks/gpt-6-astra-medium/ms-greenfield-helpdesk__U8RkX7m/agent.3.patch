--- /dev/null
+++ b/app/controllers/api/v1/users_controller.rb
@@ -0,0 +1,35 @@
+module Api
+  module V1
+    class UsersController < BaseController
+      include Pagination
+      before_action :require_admin!
+
+      def index
+        scope = @account.users.order(:id)
+        if params.key?(:role)
+          raise ActionController::ParameterMissing, :role unless User::ROLES.include?(params[:role])
+          scope = scope.where(role: params[:role])
+        end
+        if params.key?(:suspended)
+          raise ActionController::ParameterMissing, :suspended unless %w[true false].include?(params[:suspended])
+          scope = scope.where(suspended: params[:suspended] == "true")
+        end
+        render_page(scope, :users, &:api_json)
+      end
+
+      def show
+        render json: { user: @account.users.find(params[:id]).api_json }
+      end
+
+      def update
+        user = @account.users.find(params[:id])
+        attributes = params.expect(user: [ :suspended ])
+        unless attributes.key?(:suspended) && [ true, false ].include?(attributes[:suspended])
+          raise ActionController::ParameterMissing, :suspended
+        end
+        user.update!(attributes)
+        render json: { user: user.api_json }
+      end
+    end
+  end
+end
diff --git a/app/mailers/invitation_mailer.rb b/app/mailers/invitation_mailer.rb
new file mode 100644
index 0000000..654c59c
--- /dev/null
+++ b/app/mailers/invitation_mailer.rb
@@ -0,0 +1,11 @@
+class InvitationMailer < ApplicationMailer
+  def invitation(invitation, token)
+    base = ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001").chomp("/")
+    link = "#{base}/accept-invitation?#{URI.encode_www_form(account: invitation.account.subdomain, token: token)}"
+    mail(to: invitation.email, subject: "Join #{invitation.account.name} on Helpdesk") do |format|
+      format.text do
+        render plain: "You are invited to join #{invitation.account.name} as an #{invitation.role}:\n#{link}\n\nThis link expires at #{invitation.expires_at.iso8601}."
+      end
+    end
+  end
+end
