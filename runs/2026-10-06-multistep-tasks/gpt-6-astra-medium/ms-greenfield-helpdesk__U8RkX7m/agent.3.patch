diff --git a/app/controllers/api/v1/invitations_controller.rb b/app/controllers/api/v1/invitations_controller.rb
new file mode 100644
index 0000000..70e554e
--- /dev/null
+++ b/app/controllers/api/v1/invitations_controller.rb
@@ -0,0 +1,47 @@
+module Api
+  module V1
+    class InvitationsController < BaseController
+      include Pagination
+      before_action :require_admin!
+
+      def index
+        scope = @account.invitations.order(:id)
+        if params.key?(:status)
+          raise ActionController::ParameterMissing, :status unless Invitation::STATUSES.include?(params[:status])
+          scope = scope.with_status(params[:status])
+        end
+        render_page(scope, :invitations, &:api_json)
+      end
+
+      def show
+        render json: { invitation: invitation.api_json }
+      end
+
+      def create
+        attributes = string_attributes!(params.expect(invitation: [ :email, :role ]))
+        record = @account.invitations.new(attributes)
+        token = record.issue_token!
+        InvitationMailer.invitation(record, token).deliver_now
+        render json: { invitation: record.api_json }, status: :created
+      end
+
+      def resend
+        record = invitation
+        token = record.issue_token!
+        InvitationMailer.invitation(record, token).deliver_now
+        render json: { invitation: record.api_json }
+      end
+
+      def destroy
+        invitation.revoke!
+        head :no_content
+      end
+
+      private
+
+      def invitation
+        @account.invitations.find(params[:id])
+      end
+    end
+  end
+end
