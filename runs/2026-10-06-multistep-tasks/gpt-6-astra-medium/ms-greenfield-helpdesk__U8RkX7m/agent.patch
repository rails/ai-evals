@@ -0,0 +1,75 @@
+module Api
+  module V1
+    class TicketsController < ConversationsController
+      before_action :require_staff!
+
+      def merge
+        attributes = merge_attributes
+        source = conversations.find(params[:id])
+        target = conversations.find(attributes.fetch(:target_id))
+        source.merge_into!(target, author: @user,
+          source_comment: (attributes[:source_comment]&.to_h&.symbolize_keys || {}),
+          target_comment: (attributes[:target_comment]&.to_h&.symbolize_keys || {}))
+        render json: { source: source.reload.api_json(staff: true), target: target.reload.api_json(staff: true) }
+      end
+
+      private
+
+      def merge_attributes
+        attributes = params.expect(merge: [ :target_id,
+          { source_comment: [ :body, :public ], target_comment: [ :body, :public ] } ])
+        target_id = attributes[:target_id]
+        unless target_id.is_a?(Integer) && target_id.positive?
+          raise ActionController::ParameterMissing, :target_id
+        end
+        %i[source_comment target_comment].each do |key|
+          next unless params[:merge].key?(key)
+
+          note = attributes[key]
+          raise ActionController::ParameterMissing, key unless note.is_a?(ActionController::Parameters)
+          string_attributes!(params[:merge][key].slice(:body))
+          if params[:merge][key].key?(:public) && ![ true, false ].include?(params[:merge][key][:public])
+            raise ActionController::ParameterMissing, :public
+          end
+        end
+        attributes
+      end
+
+      def filtered_conversations
+        scope = super
+        if params.key?(:priority)
+          raise ActionController::ParameterMissing, :priority unless Ticket::PRIORITIES.include?(params[:priority])
+          scope = scope.where(priority: params[:priority])
+        end
+        if params.key?(:assignee_id)
+          assignee_id = params[:assignee_id] == "unassigned" ? nil : positive_integer_parameter(:assignee_id, nil)
+          scope = scope.where(assignee_id: assignee_id)
+        end
+        if params.key?(:group_id)
+          group_id = params[:group_id] == "unassigned" ? nil : positive_integer_parameter(:group_id, nil)
+          scope = scope.where(group_id: group_id)
+        end
+        if params.key?(:requester_id)
+          scope = scope.where(requester_id: positive_integer_parameter(:requester_id, nil))
+        end
+        if params.key?(:q)
+          string_attributes!(params.slice(:q))
+          scope = scope.matching_text(params[:q]) unless params[:q].empty?
+        end
+        scope
+      end
+
+      def conversations
+        @account.tickets
+      end
+
+      def resource_name
+        :ticket
+      end
+
+      def staff_view?
+        true
+      end
+    end
+  end
+end
