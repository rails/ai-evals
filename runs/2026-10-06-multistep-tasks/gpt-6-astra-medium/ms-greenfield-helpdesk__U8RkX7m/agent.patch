diff --git a/app/models/group_membership.rb b/app/models/group_membership.rb
new file mode 100644
index 0000000..7b4ec84
--- /dev/null
+++ b/app/models/group_membership.rb
@@ -0,0 +1,59 @@
+class GroupMembership < ApplicationRecord
+  belongs_to :account
+  belongs_to :group
+  belongs_to :user
+
+  validates :user_id, uniqueness: { scope: :group_id }
+  validates :default, inclusion: { in: [ true, false ] }
+  validate :staff_in_same_account
+  validate :membership_is_immutable
+
+  # Serialize all changes for a user, including the first membership and default replacement.
+  around_save :lock_user
+  before_save :select_default
+  around_destroy :lock_user
+  after_destroy :repair_assignments_and_default
+
+  def make_default!
+    user.with_lock do
+      reload
+      update!(default: true)
+    end
+  end
+
+  def api_json
+    as_json(only: %i[id account_id group_id user_id default created_at updated_at])
+  end
+
+  private
+
+  def lock_user(&action)
+    user.with_lock(&action)
+  end
+
+  def select_default
+    others = user.group_memberships.where.not(id: id)
+    self.default = true unless others.exists?(default: true)
+    others.where(default: true).update_all(default: false, updated_at: Time.current) if default?
+  end
+
+  def repair_assignments_and_default
+    account.tickets.where(group_id: group_id, assignee_id: user_id)
+      .update_all(assignee_id: nil, updated_at: Time.current)
+    remaining = user.group_memberships
+    remaining.order(:id).first&.make_default! unless remaining.exists?(default: true)
+  end
+
+  def staff_in_same_account
+    errors.add(:group, "must belong to the account") if group && group.account_id != account_id
+    unless user && user.account_id == account_id && user.staff?
+      errors.add(:user, "must be staff in this account")
+    end
+  end
+
+  def membership_is_immutable
+    if persisted? && (will_save_change_to_account_id? || will_save_change_to_group_id? || will_save_change_to_user_id?)
+      errors.add(:base, "Membership's account, group and user cannot be changed")
+    end
+  end
+end
diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..e7edb68
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,81 @@
+class Invitation < ApplicationRecord
+  LIFETIME = 7.days
+  STATUSES = %w[pending accepted revoked expired].freeze
+  ROLES = %w[admin agent].freeze
+
+  belongs_to :account
+  normalizes :email, with: ->(value) { value.strip.downcase }
+  validates :email, presence: true, length: { maximum: 254 }, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, inclusion: { in: ROLES }
+  validates :status, inclusion: { in: STATUSES }
+  validates :token_digest, :expires_at, presence: true
+  validate :email_available, if: -> { status == "pending" }
+
+  scope :pending, -> { where(status: "pending").where("expires_at > ?", Time.current) }
+
+  def self.expire_pending!
+    where(status: "pending").where("expires_at <= ?", Time.current).update_all(status: "expired")
+  end
+
+  def self.with_status(value)
+    case value
+    when "pending" then pending
+    when "expired" then where(status: "expired").or(where(status: "pending").where("expires_at <= ?", Time.current))
+    else where(status: value)
+    end
+  end
+
+  def self.with_token(token)
+    pending.find_by(token_digest: Session.digest(token))
+  end
+
+  def status
+    value = super
+    value == "pending" && expires_at && expires_at <= Time.current ? "expired" : value
+  end
+
+  # Call under the account lifecycle lock, also used by registration and acceptance.
+  def issue_token!
+    reject_transition! unless %w[pending expired].include?(status)
+    account.invitations.expire_pending!
+    reload if persisted?
+    token = SecureRandom.urlsafe_base64(32)
+    update!(status: "pending", token_digest: Session.digest(token), expires_at: LIFETIME.from_now)
+    token
+  end
+
+  def revoke!
+    reject_transition! if status == "accepted"
+    update!(status: "revoked", revoked_at: Time.current) unless status == "revoked"
+  end
+
+  def accept!(name:, password:)
+    reject_transition! unless status == "pending"
+    transaction do
+      user = account.users.create!(email: email, role: role, name: name, password: password, verified: true)
+      update!(status: "accepted", accepted_at: Time.current)
+      user
+    end
+  end
+
+  def api_json
+    as_json(only: %i[id email role expires_at accepted_at revoked_at created_at updated_at]).merge("status" => status)
+  end
+
+  def preview_json
+    as_json(only: %i[email role expires_at]).merge("business_name" => account.name, "subdomain" => account.subdomain)
+  end
+
+  private
+
+  def reject_transition!
+    errors.add(:status, "does not allow this action")
+    raise ActiveRecord::RecordInvalid, self
+  end
+
+  def email_available
+    if account && (account.users.exists?(email: email) || account.invitations.pending.where(email: email).where.not(id: id).exists?)
+      errors.add(:email, "already belongs to a user or pending invitation")
+    end
+  end
+end
