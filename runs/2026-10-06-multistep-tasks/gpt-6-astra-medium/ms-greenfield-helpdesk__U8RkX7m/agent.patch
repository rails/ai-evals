diff --git a/config/initializers/inbound_email.rb b/config/initializers/inbound_email.rb
new file mode 100644
index 0000000..1fd43ac
--- /dev/null
+++ b/config/initializers/inbound_email.rb
@@ -0,0 +1,26 @@
+# Rails deduplicates identical raw messages before routing. Rejected deliveries
+# are not successful receipts: allow retry after e.g. an account is reactivated.
+module RetryRejectedInboundEmail
+  def create_and_extract_message_id!(source, **options)
+    checksum = OpenSSL::Digest::SHA1.hexdigest(source)
+    message_id = extract_message_id(source) || generate_missing_message_id(checksum)
+    existing = find_by(message_id: message_id, message_checksum: checksum)
+    return super unless existing
+
+    retry_delivery = false
+    existing.with_lock do
+      if existing.bounced? || existing.failed?
+        existing.update!(status: :pending)
+        retry_delivery = true
+      end
+    end
+    existing.route_later if retry_delivery
+    existing
+  end
+end
+
+Rails.application.config.to_prepare do
+  ActionMailbox::InboundEmail.singleton_class.prepend(RetryRejectedInboundEmail)
+  # Only routing runs inline: scheduled incineration must remain asynchronous.
+  ActionMailbox::RoutingJob.queue_adapter = :inline if Rails.env.test?
+end
