diff --git a/app/controllers/api/v1/group_memberships_controller.rb b/app/controllers/api/v1/group_memberships_controller.rb
new file mode 100644
index 0000000..52ff9c6
--- /dev/null
+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,53 @@
+module Api
+  module V1
+    class GroupMembershipsController < BaseController
+      include Pagination
+      before_action :require_staff!
+      before_action :require_admin!, only: %i[create destroy make_default]
+
+      def index
+        scope = @account.group_memberships.order(:id)
+        %i[group_id user_id].each do |key|
+          scope = scope.where(key => positive_integer_parameter(key, nil)) if params.key?(key)
+        end
+        render_page(scope, :group_memberships, &:api_json)
+      end
+
+      def show
+        render json: { group_membership: membership.api_json }
+      end
+
+      def create
+        attributes = params.expect(group_membership: [ :group_id, :user_id, :default ])
+        %i[group_id user_id].each do |key|
+          value = attributes[key]
+          raise ActionController::ParameterMissing, key unless value.is_a?(Integer) && value.positive?
+        end
+        if attributes.key?(:default) && ![ true, false ].include?(attributes[:default])
+          raise ActionController::ParameterMissing, :default
+        end
+        record = @account.group_memberships.create!(
+          group: @account.groups.find(attributes[:group_id]),
+          user: @account.users.find(attributes[:user_id]), default: attributes.fetch(:default, false))
+        render json: { group_membership: record.api_json }, status: :created
+      end
+
+      def make_default
+        record = membership
+        record.make_default!
+        render json: { group_membership: record.api_json }
+      end
+
+      def destroy
+        membership.destroy!
+        head :no_content
+      end
+
+      private
+
+      def membership
+        @account.group_memberships.find(params[:id])
+      end
+    end
+  end
+end
