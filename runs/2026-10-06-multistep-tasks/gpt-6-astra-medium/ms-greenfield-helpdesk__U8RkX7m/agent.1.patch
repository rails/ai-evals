+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      skip_before_action :authenticate!
+      skip_before_action :require_active_account!
+
+      def create
+        attributes = params.expect(email_verification: [ :email ])
+        user = @account.users.find_by(email: required_string(attributes, :email))
+        if user && !user.verified? && !@account.expired?
+          UserMailer.verification(user, user.issue_token!(:verification)).deliver_now
+        end
+        render json: { message: "If eligible, a verification link has been sent." }, status: :accepted
+      end
+
+      def confirm
+        attributes = params.expect(email_verification: [ :token ])
+        user = @account.users.with_token(:verification, required_string(attributes, :token))
+        if user && !@account.expired?
+          user.update!(verified: true, verification_token_digest: nil, verification_token_expires_at: nil)
+          render json: { user: user.api_json }
+        else
+          render_error(:unprocessable_entity, "invalid_token", "The token is invalid or expired.")
+        end
+      end
+    end
+  end
