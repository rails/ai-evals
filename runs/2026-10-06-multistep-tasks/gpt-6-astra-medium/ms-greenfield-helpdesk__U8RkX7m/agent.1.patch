+class ApplicationController < ActionController::API
+  rescue_from ActionController::ParameterMissing, ActionDispatch::Http::Parameters::ParseError do
+    render_error(:bad_request, "invalid_request", "A valid JSON request with the required fields is needed.")
+  end
+  rescue_from ActiveRecord::RecordInvalid do |exception|
+    render json: { error: { code: "validation_failed", message: "Validation failed.",
+      details: exception.record.errors.to_hash } }, status: :unprocessable_entity
+  end
+  rescue_from ActiveRecord::RecordNotUnique do
+    render_error(:unprocessable_entity, "validation_failed", "The subdomain or email is already taken.")
+  end
+  rescue_from ActiveRecord::RecordNotFound do
+    render_error(:not_found, "not_found", "Record not found.")
+  end
+
+  private
+
+  def render_error(status, code, message)
+    render json: { error: { code: code, message: message } }, status: status
+  end
+end
