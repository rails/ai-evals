+            SELECT blob_id FROM active_storage_attachments GROUP BY blob_id HAVING COUNT(DISTINCT account_id) = 1
+          )
+        SQL
+        break if assigned.zero?
+      end
+
+      # Reused blobs with multiple known tenants aren't orphans. Don't discard
+      # their files or assign them to an arbitrary account.
+      if connection.select_value(<<~SQL)
+        SELECT 1 FROM active_storage_attachments GROUP BY blob_id HAVING COUNT(DISTINCT account_id) > 1 LIMIT 1
+      SQL
+        raise "Resolve blobs attached to multiple accounts before migrating"
+      end
+
+      execute <<~SQL
+        DELETE FROM active_storage_attachments WHERE NOT EXISTS (
+          SELECT 1 FROM active_storage_blobs WHERE id = active_storage_attachments.blob_id
+          AND account_id = active_storage_attachments.account_id
+        )
+      SQL
+      tables.each { |table| require_key(table) }
+    end
+end
