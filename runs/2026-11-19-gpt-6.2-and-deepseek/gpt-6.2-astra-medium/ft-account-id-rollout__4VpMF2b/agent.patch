diff --git a/test/models/account_keys_test.rb b/test/models/account_keys_test.rb
new file mode 100644
index 0000000..0f6b953
--- /dev/null
+++ b/test/models/account_keys_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class AccountKeysTest < ActiveSupport::TestCase
+  test "tenant tables have a required indexed UUID account key" do
+    global_tables = %w[accounts account_external_id_sequences identities identity_access_tokens sessions magic_links action_pack_passkeys]
+    connection = ApplicationRecord.connection
+    tables = connection.tables - global_tables - %w[ar_internal_metadata schema_migrations]
+
+    # The SQLite FTS index (including its shadow tables) is keyed by search_records.rowid.
+    tables.reject { |table| table.start_with?("search_records_fts") }.each do |table|
+      column = connection.columns(table).find { |column| column.name == "account_id" }
+      assert column, table
+      assert_equal :uuid, column.type, table
+      assert_not column.null, table
+      assert connection.index_exists?(table, :account_id), table
+    end
+
+    global_tables.each do |table|
+      assert_not connection.column_exists?(table, :account_id), table
+    end
+  end
+
+  test "filter links and bulk board access inherit the owner's account" do
+    board = boards(:miltons_wish_list)
+    user = users(:mike)
+    assert_not_equal Current.account, board.account
+
+    filter = user.filters.create!(board_ids: [ board.id ], assignee_ids: [ user.id ])
+    assert_equal board.account, filter.board_links.sole.account
+    assert_equal board.account, filter.assignee_links.sole.account
+
+    board.accesses.where(user: user).delete_all
+    board.accesses.grant_to([ user ])
+    assert_equal board.account, board.accesses.find_by!(user: user).account
+  end
+
+  test "rich text and files inherit the record's account without a current tenant" do
+    card = cards(:radio)
+    Current.without_account do
+      card.update!(description: "Notes")
+      card.image.attach(io: StringIO.new("image"), filename: "test.png", content_type: "image/png")
+    end
+
+    assert_equal card.account, card.rich_text_description.reload.account
+    assert_equal card.account, card.image.attachment.reload.account
+    assert_equal card.account, card.image.blob.reload.account
+  end
+end
