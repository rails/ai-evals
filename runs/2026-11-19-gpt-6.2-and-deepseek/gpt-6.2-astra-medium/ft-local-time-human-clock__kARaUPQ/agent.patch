@@ -0,0 +1,26 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "comments and deadlines use the browser's calendar days" do
+    zone = "America/Los_Angeles"
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: zone)
+    today = Time.find_zone!(zone).now.beginning_of_day
+
+    comments(:logo_agreement_kevin).update_column(:created_at, today.change(hour: 13, min: 42))
+    comments(:logo_agreement_jz).update_column(:created_at, today - 1.minute)
+    comments(:logo_1).update_column(:created_at, today - 5.days)
+    card = cards(:logo)
+    card.update_column(:last_active_at, today.tomorrow - card.auto_postpone_period)
+
+    sign_in_as(users(:david))
+    visit card_url(card)
+
+    assert_selector ".comment__permalink-title time", text: "1:42 PM"
+    assert_selector ".comment__permalink-title time", text: "yesterday"
+    click_on "Full history"
+    assert_selector ".comment__permalink-title time", text: "5 days ago"
+    assert_text "Moves to “Not Now” tomorrow"
+  ensure
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+  end
+end
