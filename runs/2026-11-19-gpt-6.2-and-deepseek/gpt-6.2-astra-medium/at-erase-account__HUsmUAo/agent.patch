new file mode 100644
index 0000000..d5dcc1d
--- /dev/null
+++ b/db/migrate/20241106093000_add_user_to_sign_in_events.rb
@@ -0,0 +1,18 @@
+class AddUserToSignInEvents < ActiveRecord::Migration[8.0]
+  def change
+    add_reference :sign_in_events, :user, foreign_key: true
+
+    reversible do |dir|
+      dir.up do
+        # Link existing events while the account still has its login address.
+        # Older, rewritten addresses are handled when erasing that user.
+        execute <<~SQL
+          UPDATE sign_in_events SET user_id = users.id
+          FROM users
+          WHERE sign_in_events.email_address = users.email_address
+            AND sign_in_events.created_at >= users.created_at
+        SQL
+      end
+    end
+  end
+end
