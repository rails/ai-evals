diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..26517a2
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroy erases personal records but keeps an everyone book readable and searchable" do
+    user = users(:kevin)
+    book = books(:handbook)
+    book.update!(creator: user, author: user.name)
+    leaf = leaves(:welcome_page)
+    leaf.reindex
+    mark = ReadingMark.remember(leaf, user: users(:jz))
+    ReadingMark.remember(leaf, user: user)
+    user.sessions.create!
+    old_address = user.email_address
+    user.update!(email_address: "new@example.com")
+
+    user.destroy!
+
+    assert_not Session.exists?(user_id: user.id)
+    assert_not Access.exists?(user_id: user.id)
+    assert_not ReadingMark.exists?(user_id: user.id)
+    assert_not SignInEvent.for_address(old_address).exists?
+    assert_not SignInEvent.for_address(user.email_address).exists?
+    assert_nil book.reload.creator_id
+    assert_equal "Deleted author", book.author
+    Current.set(user: users(:jason)) { book.update!(title: "Revised handbook") }
+    assert_nil book.reload.creator_id
+    assert book.accessable?(user: users(:jz))
+    assert ReadingMark.exists?(mark.id)
+    assert_includes book.leaves.search("great handbook"), leaf
+  end
+
+  test "destroy removes a private book, its versions, uploads and raw search rows" do
+    user = users(:kevin)
+    book = books(:handbook)
+    book.update!(creator: user, everyone_access: false, published: true)
+    leaf = leaves(:welcome_page)
+    original = leaf.page
+    original.body.uploads.attach(io: StringIO.new("private"), filename: "private.txt")
+    blob = original.body.uploads.first.blob
+    leaf.edit(leafable_params: { body: "private revision" })
+    current = leaf.page
+    leaf.trashed!
+    section = leaves(:welcome_section)
+    section.section.update!(body: "formerly searchable")
+    Leaf.reindex_all
+    section.section.update!(body: nil)
+    assert_not_empty search_rows(section)
+    assert_not_empty search_rows(leaf)
+    ReadingMark.remember(leaf, user: users(:david))
+
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) { user.destroy! }
+
+    assert_not Book.exists?(book.id)
+    assert_not Leaf.exists?(book_id: book.id)
+    assert_not Edit.exists?(leaf_id: leaf.id)
+    assert_not ReadingMark.exists?(leaf_id: leaf.id)
+    assert_not Page.exists?(id: [ original.id, current.id ])
+    assert_not ActionText::Markdown.exists?(record_type: "Page", record_id: [ original.id, current.id ])
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_empty search_rows(leaf)
+    assert_empty search_rows(section)
+    assert Book.exists?(books(:manual).id)
+  end
+
+  private
+    def search_rows(leaf)
+      Leaf.connection.select_values(Leaf.sanitize_sql([ "SELECT rowid FROM leaf_search_index WHERE rowid = ?", leaf.id ]))
+    end
+end
