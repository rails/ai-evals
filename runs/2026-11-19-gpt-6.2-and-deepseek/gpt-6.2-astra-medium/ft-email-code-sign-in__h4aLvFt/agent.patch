diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..df31cef
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,29 @@
+class MagicLink < ApplicationRecord
+  CODE_CHARACTERS = ("A".."Z").to_a + ("0".."9").to_a
+  LIFETIME = 15.minutes
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  def self.issue(email_address, purpose:, join_code: nil)
+    code = SecureRandom.alphanumeric(6, chars: CODE_CHARACTERS)
+    link = create!(email_address: email_address, purpose: purpose, code_digest: digest(code),
+      join_code: join_code, invitation_code: join_code&.code)
+    if purpose != :sign_in || Identity.exists?(email_address: email_address)
+      MagicLinkMailer.sign_in_code(email_address, code).deliver_later
+    end
+    link
+  end
+
+  def self.cleanup
+    where(created_at: ..LIFETIME.ago).delete_all
+  end
+
+  def self.digest(code)
+    OpenSSL::HMAC.hexdigest("SHA256", Rails.application.key_generator.generate_key("email sign-in code"), code)
+  end
+
+  def consume(code)
+    matching = self.class.where(id: id, code_digest: self.class.digest(code.to_s.strip.upcase))
+    matching.where("created_at > ?", LIFETIME.ago).delete_all == 1
+  end
+end
