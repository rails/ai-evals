@@ -0,0 +1,18 @@
+module EmailCodeAuthentication
+  private
+
+  def request_email_code(email_address, purpose:, join_code: nil)
+    identity = Identity.new(email_address: email_address)
+    if identity.valid?
+      link = MagicLink.issue(identity.email_address, purpose: purpose, join_code: join_code)
+      cookies.signed[:pending_authentication_token] = { value: link.id, expires: MagicLink::LIFETIME.from_now, httponly: true, same_site: :lax }
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil) }
+        format.json { render json: { pending_authentication_token: cookies[:pending_authentication_token] }, status: :created }
+      end
+    else
+      head :unprocessable_entity
+    end
+  end
+end
diff --git a/app/controllers/concerns/join_code_redemption.rb b/app/controllers/concerns/join_code_redemption.rb
