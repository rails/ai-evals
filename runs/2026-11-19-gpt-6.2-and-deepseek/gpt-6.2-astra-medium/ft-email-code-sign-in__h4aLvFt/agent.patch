index 0000000..4a8fa4f
--- /dev/null
+++ b/app/controllers/concerns/join_code_redemption.rb
@@ -0,0 +1,25 @@
+module JoinCodeRedemption
+  private
+
+  def redeem_join_code(join_code, expected_code)
+    identity = nil
+    join_code&.redeem_if(expected_code: expected_code) do |account|
+      identity = yield
+      identity.join(account)
+    end
+
+    if identity
+      user = join_code.account.users.active.find_by!(identity: identity)
+      if user.setup?
+        redirect_to landing_url(script_name: user.account.slug)
+      else
+        redirect_to new_users_verification_url(script_name: user.account.slug)
+      end
+    elsif join_code && join_code.code == expected_code
+      @join_code = join_code
+      render "join_codes/inactive", formats: :html, status: :gone
+    else
+      head :not_found
+    end
+  end
+end
