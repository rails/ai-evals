diff --git a/test/controllers/sessions/magic_links_controller_test.rb b/test/controllers/sessions/magic_links_controller_test.rb
new file mode 100644
index 0000000..ff4f6f7
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  test "sign in with the code from the email subject" do
+    untenanted do
+      identity = identities(:kevin)
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      assert_redirected_to new_session_magic_link_path
+      follow_redirect!
+      assert_select 'input[name="code"]'
+
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ identity.email_address ], mail.to
+      code = mail.subject[/\b[A-Z0-9]{6}\b/]
+      assert code
+
+      post session_magic_link_path, params: { code: "wrong" }
+      assert_response :unauthorized
+      assert_nil cookies[:session_token]
+
+      assert_difference -> { identity.sessions.count } do
+        post session_magic_link_path, params: { code: code }
+      end
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "a JSON sign-in code works only once, with the matching pending token" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:kevin).email_address }, as: :json
+      end
+      assert_response :created
+      token = response.parsed_body.fetch("pending_authentication_token")
+      code = emailed_code
+      cookies.delete("pending_authentication_token")
+      post session_magic_link_path, params: { code: code }, as: :json
+      assert_response :unauthorized
+
+      cookies["pending_authentication_token"] = token
+      travel 14.minutes do
+        post session_magic_link_path, params: { code: code }, as: :json
+        assert_response :success
+        assert_equal cookies[:session_token], response.parsed_body.fetch("session_token")
+      end
+
+      cookies["pending_authentication_token"] = token
+      post session_magic_link_path, params: { code: code }, as: :json
+      assert_response :unauthorized
+    end
+  end
+
+  test "expired code cannot sign in" do
+    untenanted do
+      perform_enqueued_jobs { post session_path, params: { email_address: identities(:kevin).email_address } }
+      travel 15.minutes + 1.second do
+        assert_no_difference -> { Session.count } do
+          post session_magic_link_path, params: { code: emailed_code }
+        end
+        assert_response :unauthorized
+      end
+    end
+  end
+
+  test "unknown email at sign in does not create an identity or reveal whether it exists" do
+    untenanted do
+      assert_no_difference [ -> { Identity.count }, -> { ActionMailer::Base.deliveries.size } ] do
+        perform_enqueued_jobs { post session_path, params: { email_address: "unknown@example.com" } }
+      end
+      assert_redirected_to new_session_magic_link_path
+    end
+  end
+
+  test "sign up and complete the new account after verifying the code" do
+    with_multi_tenant_mode(true) do
+      untenanted do
+        perform_enqueued_jobs { post signup_path, params: { signup: { email_address: "new@example.com" } } }
+        assert_redirected_to new_session_magic_link_path
+        post session_magic_link_path, params: { code: emailed_code }
+        assert_redirected_to new_signup_completion_path
+        assert_difference -> { Account.count } do
+          post signup_completion_path, params: { signup: { full_name: "New Owner" } }
+        end
+        assert_equal "New Owner", Identity.find_by!(email_address: "new@example.com").users.sole.name
+      end
+    end
+  end
+
+  test "joining redeems the invitation only after verifying the code" do
+    join_code = account_join_codes(:"37s")
+    assert_no_difference -> { join_code.reload.usage_count } do
+      perform_enqueued_jobs { post join_path(code: join_code.code), params: { email_address: "new@example.com" } }
+    end
+    untenanted do
+      assert_redirected_to new_session_magic_link_path
+      assert_difference -> { join_code.reload.usage_count } do
+        post session_magic_link_path, params: { code: emailed_code }
+      end
+      assert_redirected_to new_users_verification_url(script_name: join_code.account.slug)
+    end
+    assert Identity.find_by!(email_address: "new@example.com").users.exists?(account: join_code.account)
+  end
+
+  test "a reset invitation cannot be used to join with an outstanding email code" do
+    join_code = account_join_codes(:"37s")
+    perform_enqueued_jobs { post join_path(code: join_code.code), params: { email_address: "new@example.com" } }
+    join_code.reset
+    untenanted do
+      assert_no_difference [ -> { User.count }, -> { Session.count } ] do
+        post session_magic_link_path, params: { code: emailed_code }
+      end
+      assert_response :not_found
+    end
+  end
+
+  private
+    def emailed_code
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
