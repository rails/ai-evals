diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..1a1e8ff
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,66 @@
+class Sessions::MagicLinksController < ApplicationController
+  include JoinCodeRedemption
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    link = MagicLink.find_by(id: cookies.signed[:pending_authentication_token])
+    if link && link.consume(params.expect(:code))
+      cookies.delete(:pending_authentication_token)
+      case link.purpose
+      when "sign_in" then sign_in(link.email_address)
+      when "signup"  then sign_up(link.email_address)
+      when "join"    then join_account(link)
+      end
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def sign_in(email_address)
+      if identity = Identity.find_by(email_address: email_address)
+        start_new_session_for identity
+        respond_to do |format|
+          format.html { redirect_to after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        invalid_code
+      end
+    end
+
+    def sign_up(email_address)
+      if Account.accepting_signups?
+        start_new_session_for Identity.find_or_create_by!(email_address: email_address)
+        redirect_to new_signup_completion_path
+      else
+        redirect_to new_session_path
+      end
+    end
+
+    def join_account(link)
+      redeem_join_code(link.join_code, link.invitation_code) do
+        identity = Identity.find_or_create_by!(email_address: link.email_address)
+        start_new_session_for identity
+        identity
+      end
+    end
+
+    def invalid_code
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = "That code is incorrect or has expired. Try again or request a new code."
+          render :new, status: :unauthorized
+        end
+        format.json { head :unauthorized }
+      end
+    end
+end
