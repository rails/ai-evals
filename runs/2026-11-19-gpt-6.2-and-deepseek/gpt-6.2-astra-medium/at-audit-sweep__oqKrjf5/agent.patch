diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..c22e533
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  test "title matches are limited to readable books" do
+    leaves(:summary_page).update!(book: books(:manual), title: "Welcome to the Manual")
+    sign_in :kevin
+
+    get library_search_path, params: { q: "welcome" }
+    assert_response :success
+    assert_in_body leaves(:welcome_page).title
+    assert_not_in_body leaves(:summary_page).title
+
+    sign_out
+    books(:manual).update!(published: true)
+    get library_search_path, params: { q: "welcome" }
+    assert_response :success
+    assert_in_body leaves(:summary_page).title
+    assert_not_in_body leaves(:welcome_page).title
+  end
+
+  test "search matches punctuation literally" do
+    sign_in :kevin
+    leaf = leaves(:summary_page)
+    leaf.update!(title: "Reader's guide_1: Save 50% off!")
+
+    [ "Reader's", "_", "%", "Save 50% off", leaf.title ].each do |term|
+      get library_search_path, params: { q: term }
+      assert_response :success
+      assert_select "a.search__result", count: 1
+      assert_select "a.search__result[href=?]", leafable_slug_path(leaf)
+    end
+  end
+end
