diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..74acb58
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  test "terms match literal substrings of titles" do
+    sign_in :kevin
+    leaf = leaves(:summary_page)
+    leaf.update!(title: "Reader's guide: Save 50% off_today!")
+
+    [ "Reader's", "Save 50% off", "%", "_", "off_today!" ].each do |term|
+      get library_search_path, params: { q: term }
+
+      assert_response :success
+      assert_select "a.search__result", count: 1
+      assert_select "a.search__result[href=?]", leafable_slug_path(leaf)
+    end
+  end
+
+  test "results follow the searcher's book access" do
+    leaves(:summary_page).update!(book: books(:manual), title: "Welcome summary")
+    sign_in :kevin
+
+    get library_search_path, params: { q: "welcome" }
+    assert_response :success
+    assert_select "a.search__result", count: 2
+    assert_select "a.search__result[href=?]", leafable_slug_path(leaves(:summary_page)), count: 0
+
+    books(:manual).update!(published: true)
+    sign_out
+    get library_search_path, params: { q: "welcome" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_select "a.search__result[href=?]", leafable_slug_path(leaves(:summary_page))
+  end
+end
