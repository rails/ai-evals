diff --git a/test/integration/editing_presence_test.rb b/test/integration/editing_presence_test.rb
new file mode 100644
index 0000000..70f5636
--- /dev/null
+++ b/test/integration/editing_presence_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class EditingPresenceTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+  include ActiveJob::TestHelper
+
+  test "only current editors receive the being edited indicator" do
+    leaf = leaves(:welcome_page)
+    removed_stream = open_editor_stream(:kevin, leaf)
+    remaining_stream = open_editor_stream(:jason, leaf)
+
+    sign_in :david
+    put leafable_path(leaf), params: { leaf: { title: "New title" } }
+    assert_response :no_content
+
+    accesses(:kevin_handbook).destroy!
+    messages = capture_broadcasts(remaining_stream) { perform_enqueued_jobs }
+
+    assert_no_broadcasts removed_stream
+    assert_no_broadcasts "#{leaf.to_gid_param}:being_edited"
+    assert_equal 1, messages.size
+    assert_includes messages.first, users(:david).name
+    assert_includes messages.first, ActionView::RecordIdentifier.dom_id(leaf, :being_edited)
+  end
+
+  private
+    def open_editor_stream(user, leaf)
+      sign_in user
+      get edit_leafable_path(leaf)
+      assert_response :ok
+      source = css_select("turbo-cable-stream-source").sole
+      sign_out
+      Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    end
+end
