diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..c143530
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,60 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  def self.for_checkout(account)
+    find_by(account: account) || create_for_checkout(account)
+  end
+
+  def self.create_for_checkout(account)
+    customer = Stripe::Customer.create({ metadata: { account_id: account.id } },
+      { api_key: ENV.fetch("STRIPE_SECRET_KEY"), idempotency_key: "account-#{account.id}" })
+    create_or_find_by!(account: account) { |record| record.stripe_customer_id = customer.id }
+  end
+  private_class_method :create_for_checkout
+
+  def paid_plan
+    ::Subscription.paid_plans.find { |plan| plan.short_name == plan_key }
+  end
+
+  def ongoing?
+    stripe_subscription_id.present? && !ended?
+  end
+
+  def checkout_url(plan, return_url:)
+    Stripe::Checkout::Session.create({ mode: "subscription", customer: stripe_customer_id,
+      line_items: [ { price: ENV.fetch(plan.price_env), quantity: 1 } ], success_url: return_url,
+      cancel_url: return_url }, { api_key: ENV.fetch("STRIPE_SECRET_KEY") }).url
+  end
+
+  def portal_url(return_url:)
+    Stripe::BillingPortal::Session.create({ customer: stripe_customer_id, return_url: return_url },
+      { api_key: ENV.fetch("STRIPE_SECRET_KEY") }).url
+  end
+
+  def cancel
+    Stripe::Subscription.cancel(stripe_subscription_id, {}, { api_key: ENV.fetch("STRIPE_SECRET_KEY") })
+  end
+
+  def apply_event(event)
+    object = event.data.object
+    with_lock do
+      next if last_event_at && event.created < last_event_at
+      next if ended? && stripe_subscription_id == object.id
+      next if ongoing? && stripe_subscription_id != object.id && event.type == "customer.subscription.deleted"
+
+      status = event.type == "customer.subscription.deleted" ? "canceled" : object.status
+      plan = plan_for(object) if %w[ active trialing ].include?(status)
+      update!(status: status, plan_key: plan&.short_name, stripe_subscription_id: object.id, last_event_at: event.created)
+    end
+  end
+
+  private
+    def ended?
+      %w[ canceled incomplete_expired ].include?(status)
+    end
+
+    def plan_for(object)
+      prices = object.items.data.map { |item| item.price.id }
+      ::Subscription.paid_plans.find { |plan| prices.include?(ENV.fetch(plan.price_env)) }
+    end
+end
