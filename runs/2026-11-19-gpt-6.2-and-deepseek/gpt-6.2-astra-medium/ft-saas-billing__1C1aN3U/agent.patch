+module AccountBillingAccess
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :ensure_admin
+    rescue_from Stripe::StripeError, with: :billing_unavailable
+  end
+
+  private
+    def billing_return_url
+      main_app.account_settings_url(script_name: Current.account.slug)
+    end
