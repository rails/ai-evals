diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..91bbe25
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup { @account = accounts(:initech) }
+
+  test "staff can comp and override usage independently and undo both" do
+    sign_in_as :david
+    untenanted do
+      get saas.admin_accounts_path
+      assert_select "a[href=?]", saas.admin_account_path(@account), text: @account.name
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "label", "Card count"
+      assert_select "label", "Bytes used"
+      post saas.admin_account_comp_path(@account)
+      assert @account.reload.comped?
+      assert_nil @account.cards_left
+      follow_redirect!
+      assert_select "button", "Uncomp"
+      patch saas.admin_account_override_path(@account), params: { override: { card_count: 950, bytes_used: 200 } }
+      assert_equal 200, @account.reload.bytes_used
+      delete saas.admin_account_comp_path(@account)
+      assert_equal 50, @account.reload.cards_left
+      delete saas.admin_account_override_path(@account)
+      assert_nil @account.reload.overridden_limit
+    end
+  end
+
+  test "account admins are not support staff" do
+    sign_in_as :mike
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+      post saas.admin_account_comp_path(@account)
+      assert_response :forbidden
+      patch saas.admin_account_override_path(@account), params: { override: { card_count: 1 } }
+      assert_response :forbidden
+    end
+  end
+end
diff --git a/saas/test/controllers/billing_test.rb b/saas/test/controllers/billing_test.rb
new file mode 100644
index 0000000..b353506
--- /dev/null
+++ b/saas/test/controllers/billing_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class BillingTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    config = { "STRIPE_SECRET_KEY" => "test-key", "STRIPE_MONTHLY_V1_PRICE_ID" => "price_basic" }
+    @old_config = config.keys.index_with { |key| ENV[key] }
+    ENV.update(config)
+  end
+
+  teardown { ENV.update(@old_config) }
+
+  test "an admin can open hosted checkout and the customer portal for their account" do
+    sign_in_as :kevin
+    get account_settings_path
+    assert_select "a[href=?]", "#{@account.slug}/account/billing", text: "Upgrade"
+    get "#{@account.slug}/account/billing"
+    assert_response :success
+    assert_select "form[action=?]", "#{@account.slug}/account/billing", count: 2
+
+    Stripe::Customer.expects(:create).returns(stub(id: "cus_1"))
+    Stripe::Checkout::Session.expects(:create).with do |params, options|
+      params[:customer] == "cus_1" && params[:line_items] == [ { price: "price_basic", quantity: 1 } ] &&
+        params[:success_url] == account_settings_url && options[:api_key] == "test-key"
+    end.returns(stub(url: "https://checkout.stripe.com/example"))
+    post "#{@account.slug}/account/billing", params: { plan: "MonthlyV1" }
+    assert_redirected_to "https://checkout.stripe.com/example"
+    assert_equal Subscription::FreeV1, @account.reload.billing_plan
+
+    Stripe::BillingPortal::Session.expects(:create).with({ customer: "cus_1", return_url: account_settings_url }, { api_key: "test-key" }).returns(stub(url: "https://billing.stripe.com/example"))
+    post "#{@account.slug}/account/billing_portal", params: { customer: "cus_elsewhere" }
+    assert_redirected_to "https://billing.stripe.com/example"
+  end
+
+  test "checkout refuses unconfigured prices and existing subscriptions" do
+    sign_in_as :kevin
+    post "#{@account.slug}/account/billing", params: { plan: "price_unapproved" }
+    assert_response :bad_request
+    @account.create_subscription!(stripe_customer_id: "cus_paid", stripe_subscription_id: "sub_paid", status: "past_due")
+    post "#{@account.slug}/account/billing", params: { plan: "MonthlyV1" }
+    assert_response :conflict
+  end
+
+  test "closing an account cancels its ongoing subscription" do
+    sign_in_as :jason
+    @account.create_subscription!(stripe_customer_id: "cus_paid", stripe_subscription_id: "sub_paid", status: "active", plan_key: "MonthlyV1")
+    Stripe::Subscription.expects(:cancel).with("sub_paid", {}, { api_key: "test-key" })
+    post account_cancellation_path
+    assert @account.reload.cancelled?
+  end
+
+  test "members cannot manage billing" do
+    sign_in_as :jz
+    get account_settings_path
+    assert_select "a", text: "Upgrade", count: 0
+    post "#{@account.slug}/account/billing", params: { plan: "MonthlyV1" }
+    assert_response :forbidden
+    post "#{@account.slug}/account/billing_portal"
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/card_quota_test.rb b/saas/test/controllers/card_quota_test.rb
new file mode 100644
index 0000000..4a8a58f
--- /dev/null
+++ b/saas/test/controllers/card_quota_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class CardQuotaTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @draft = cards(:unfinished_thoughts)
+    @usage = @account.create_overridden_limit!(card_count: 1000)
+  end
+
+  test "full accounts can draft but not publish" do
+    post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug)
+    assert_response :redirect
+    follow_redirect!
+    assert_select "form[action*='publish']", count: 0
+    assert_match "Upgrade", response.body
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug), params: { card: { title: "Full" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "near-full accounts see the countdown" do
+    @usage.update!(card_count: 950)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_match "50 cards left", response.body
+    assert_select "form[action*='publish']"
+  end
+  test "the warning starts at 100 remaining and the last card can be published" do
+    @usage.update!(card_count: 899)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_no_match /101 cards left/, response.body
+    @usage.update!(card_count: 900)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_match "100 cards left", response.body
+    @usage.update!(card_count: 999)
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert @draft.reload.published?
+  end
+
+  test "paid accounts can publish more cards and use their plan's storage" do
+    @account.create_subscription!(stripe_customer_id: "cus_paid", plan_key: "MonthlyV1")
+    @usage.update!(bytes_used: 4.gigabytes)
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert @draft.reload.published?
+    @usage.update!(bytes_used: 5.gigabytes + 1)
+    post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug), params: { card: { title: "Too much storage" } }, as: :json
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/stripe_webhooks_test.rb b/saas/test/controllers/stripe_webhooks_test.rb
new file mode 100644
index 0000000..d34b67b
--- /dev/null
+++ b/saas/test/controllers/stripe_webhooks_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class StripeWebhooksTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @account.create_subscription!(stripe_customer_id: "cus_test")
+    config = { "STRIPE_WEBHOOK_SECRET" => "signing-secret", "STRIPE_MONTHLY_V1_PRICE_ID" => "price_basic", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus" }
+    @old_config = config.keys.index_with { |key| ENV[key] }
+    ENV.update(config)
+  end
+
+  teardown { ENV.update(@old_config) }
+
+  test "signed subscription changes update the entitlement, including retries and cancellation" do
+    deliver "created", "price_basic", created: 10
+    assert_response :success
+    assert_equal 5.gigabytes, @account.reload.storage_limit
+    assert_nil @account.cards_left
+
+    2.times { deliver "updated", "price_plus", created: 20 }
+    deliver "updated", "price_basic", created: 19
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+
+    deliver "deleted", "price_plus", created: 21
+    deliver "updated", "price_plus", created: 21
+    assert_equal 1.gigabyte, @account.reload.storage_limit
+    assert_not_nil @account.cards_left
+  end
+
+  test "unsigned requests cannot grant paid access" do
+    post "/stripe/webhooks", params: "{}", headers: { "Content-Type" => "application/json" }
+    assert_response :bad_request
+    assert_equal Subscription::FreeV1, @account.reload.billing_plan
+  end
+
+  private
+    def deliver(type, price, created:)
+      payload = { id: "evt_#{created}", object: "event", type: "customer.subscription.#{type}", created: created,
+        data: { object: { id: "sub_test", object: "subscription", customer: "cus_test", status: "active",
+          items: { object: "list", data: [ { price: { id: price } } ] } } } }.to_json
+      timestamp = Time.now.to_i
+      signature = OpenSSL::HMAC.hexdigest("SHA256", "signing-secret", "#{timestamp}.#{payload}")
+      post "/stripe/webhooks", params: payload, headers: { "Stripe-Signature" => "t=#{timestamp},v1=#{signature}", "Content-Type" => "application/json" }
+    end
+end
