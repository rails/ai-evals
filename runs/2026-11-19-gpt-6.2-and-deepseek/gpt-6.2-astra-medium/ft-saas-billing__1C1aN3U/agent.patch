+class Account::BillingsController < ApplicationController
+  include AccountBillingAccess
+
+  def show
+  end
+
+  def create
+    plan = ::Subscription.paid_plans.find { |candidate| candidate.short_name == params[:plan] }
+    return head :bad_request unless plan
+    return head :conflict if Current.account.comped? || Current.account.active_subscription
+
+    subscription = Account::Subscription.for_checkout(Current.account)
+    redirect_to subscription.checkout_url(plan, return_url: billing_return_url), allow_other_host: true, status: :see_other
+  end
+end
