index 0000000..2156583
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,10 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    user = bundle.user
+    entries = bundle.entries.where(card: user.accessible_cards).includes(:source, :card).order(:id)
+    @payloads = entries.map(&:payload)
+    if @payloads.any?
+      mail to: user.identity.email_address, subject: "Your Fizzy notification digest"
+    end
+  end
+end
