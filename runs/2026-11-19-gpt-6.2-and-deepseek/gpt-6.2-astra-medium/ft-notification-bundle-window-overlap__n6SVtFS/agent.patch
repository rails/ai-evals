diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..1319e80
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "late sources join the first arrival's window, including updates on the same card" do
+    freeze_time do
+      @notification.update!(source: events(:logo_published))
+      bundle = @user.notification_bundles.sole
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+
+      travel 1.hour
+      @notification.update!(source: events(:logo_assignment_km))
+      @notification.read
+      assert_equal 2, bundle.entries.count
+      assert_equal 1, @user.notification_bundles.count
+
+      travel 3.hours
+      @notification.update!(source: events(:logo_assignment_david))
+      assert_equal bundle.ends_at, @user.notification_bundles.last.starts_at
+      assert_emails 1 do
+        perform_enqueued_jobs(only: Notification::Bundle::DeliveryJob, at: Time.current)
+      end
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ @user.identity.email_address ], email.to
+      assert_match "Added by", email.body.decoded
+      assert_match "Assigned to you", email.body.decoded
+    end
+  end
+
+  test "each recipient opens their own window on creation, with their chosen duration" do
+    freeze_time do
+      david = users(:david)
+      david.settings.update!(bundle_email_frequency: :daily)
+      @user.settings.update!(bundle_email_frequency: :weekly)
+      [ david, @user ].each do |recipient|
+        recipient.notifications.create!(source: events(:text_published), creator: users(:jz))
+      end
+      assert_equal 1.day.from_now, david.notification_bundles.sole.ends_at
+      assert_equal 1.week.from_now, @user.notification_bundles.sole.ends_at
+
+      @user.settings.update!(bundle_email_frequency: :daily)
+      @notification.update!(source: events(:logo_published))
+      assert_equal 1.week.from_now, @user.notification_bundles.sole.ends_at
+    end
+  end
+
+  test "concurrent arrivals create one bundle" do
+    event_ids = [ events(:layout_published).id, events(:logo_published).id ]
+    threads = event_ids.map do |event_id|
+      Thread.new do
+        event = Event.find(event_id)
+        Notification.find_by!(user: @user, card: event.card).update!(source: event)
+      end
+    end
+    threads.each(&:value)
+
+    assert_equal 2, @user.notification_bundles.sole.entries.count
+  end
+
+  test "never opens no window and suppresses pending mail" do
+    @notification.update!(source: events(:logo_published))
+    @user.settings.update!(bundle_email_frequency: :never)
+    travel 1.day
+    assert_no_emails do
+      perform_enqueued_jobs(only: Notification::Bundle::DeliveryJob)
+    end
+    @notification.update!(source: events(:logo_assignment_david))
+    assert_empty @user.notification_bundles
+  end
+
+  test "does not mail notifications for boards the recipient can no longer access" do
+    @notification.update!(source: events(:logo_published))
+    @user.accesses.where(board: @notification.card.board).delete_all
+    travel 1.day
+    assert_no_emails do
+      perform_enqueued_jobs(only: Notification::Bundle::DeliveryJob)
+    end
+  end
+end
