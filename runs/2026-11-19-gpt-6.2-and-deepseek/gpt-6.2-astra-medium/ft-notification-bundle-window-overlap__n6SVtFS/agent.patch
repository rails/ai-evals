diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..91be9ea
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,48 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :user
+  has_many :entries, class_name: "Notification::Bundle::Entry", dependent: :delete_all
+
+  after_create_commit :schedule_delivery
+
+  class << self
+    def add(notification)
+      transaction do
+        # Lock the recipient's settings even when there isn't a bundle to lock yet.
+        settings = User::Settings.lock.find_by(user: notification.user)
+        if duration = settings&.bundle_email_interval
+          bundle = current_or_new(notification.user, duration)
+          bundle.entries.create!(card: notification.card, source: notification.source)
+        end
+      end
+    end
+
+    private
+      def current_or_new(user, duration)
+        bundles = user.notification_bundles
+        latest = bundles.lock.order(:ends_at).last
+        arrival = Time.current
+
+        if latest && latest.ends_at > arrival
+          latest
+        else
+          bundles.create!(starts_at: arrival, ends_at: arrival + duration)
+        end
+      end
+  end
+
+  def deliver
+    with_lock do
+      if ends_at <= Time.current
+        if user.active? && user.account.active? && user.settings&.bundle_email_interval
+          NotificationMailer.digest(self).deliver_now
+        end
+        destroy!
+      end
+    end
+  end
+
+  private
+    def schedule_delivery
+      DeliveryJob.set(wait_until: ends_at).perform_later(self)
+    end
+end
