diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..5c796ba
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,38 @@
+class Card::Search
+  attr_reader :query
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.strip
+  end
+
+  def cards
+    return Card.none if query.blank?
+
+    visible = @user.accessible_cards.published
+    visible.where("instr(lower(cards.title), lower(?)) > 0", query)
+      .or(visible.where(id: matching_descriptions.select(:record_id)))
+      .or(visible.where(id: matching_comments.select(:card_id)))
+      .reverse_chronologically.preload(:rich_text_description)
+  end
+
+  def comment_texts_for(cards)
+    matching_comments.where(card_id: cards.map(&:id))
+      .order(:created_at, :id).pluck(:card_id, "action_text_rich_texts.plain_text")
+      .each_with_object({}) { |(id, text), texts| (texts[id] ||= []) << text }
+  end
+
+  private
+    def matching_descriptions
+      matching_texts.where(record_type: "Card", name: "description")
+    end
+
+    def matching_comments
+      Comment.joins(:rich_text_body).merge(matching_texts)
+    end
+
+    def matching_texts
+      ActionText::RichText.where(account_id: @user.account_id)
+        .where("instr(lower(action_text_rich_texts.plain_text), lower(?)) > 0", query)
+    end
+end
