diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..77ea6cd
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.user = users(:david)
+  end
+
+  test "finds titles, descriptions and comments once per card, newest first" do
+    cards(:shipping).update! title: "Needle in title", created_at: 1.day.ago
+    cards(:text).update! description: "The nee<strong>dle</strong> in the description", created_at: 2.days.ago
+    comments(:logo_agreement_kevin).update! body: "Comment on the NEEDLE"
+    comments(:logo_agreement_jz).update! body: "Another needle"
+
+    get search_path(q: "needle")
+    assert_response :success
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_equal [ :shipping, :text, :logo ].map { card_path(cards(it)) }, css_select("main article h2 a").map { it["href"] }
+    assert_select "article h2 mark", text: "Needle"
+    assert_select "article p mark", text: "needle"
+    assert_select "article p mark", text: "NEEDLE"
+  end
+
+  test "checks current board access and publication status, including for comment matches" do
+    comments(:logo_agreement_jz).update! body: "restricted"
+    cards(:logo).update! title: "restricted draft", status: :drafted
+    cards(:text).update! title: "restricted"
+    comments(:layout_overflowing_david).update! body: "restricted"
+    cards(:layout).update! board: boards(:private)
+
+    get search_path(q: "restricted")
+    assert_select "main article", count: 1
+    assert_select "article a[href=?]", card_path(cards(:text))
+
+    accesses(:writebook_david).destroy!
+    get search_path(q: "restricted")
+    assert_select "main article", count: 0
+  end
+
+  test "matches visible text, not HTML attributes or stale content" do
+    comment = comments(:logo_agreement_jz)
+    comment.update! body: '<a href="https://example.com/hiddenword">Fish &amp; chips</a>'
+
+    get search_path(q: "hiddenword")
+    assert_select "article", count: 0
+
+    get search_path(q: "Fish & chips")
+    assert_select "article p mark", text: "Fish & chips"
+
+    comment.update! body: "A changed comment"
+    get search_path(q: "Fish & chips")
+    assert_select "article", count: 0
+  end
+
+  test "treats search and highlighted content as plain text" do
+    cards(:text).update! title: "<em>50%_off</em>"
+    get search_path(q: "%_")
+    assert_select "article", count: 1
+    assert_select "article mark", text: "%_"
+    assert_select "article em", count: 0
+
+    get search_path(q: " ")
+    assert_select "article", count: 0
+  end
+end
