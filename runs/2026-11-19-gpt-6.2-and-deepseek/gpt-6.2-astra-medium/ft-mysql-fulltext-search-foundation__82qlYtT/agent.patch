diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..d4e4dad
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,33 @@
+<% @page_title = "Search cards" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel center-block">
+  <%= form_with url: search_path, method: :get, role: "search", class: "flex gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search titles, descriptions, and comments", class: "input" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @search.query.present? %>
+    <%= with_manual_pagination :search_results, @page do %>
+      <% @page.records.each do |card| %>
+        <article class="margin-block">
+          <h2><%= link_to highlight_search_match(card.title, @search.query), card_path(card), data: { turbo_frame: "_top" } %></h2>
+          <% if snippet = excerpt(card.rich_text_description&.plain_text, @search.query) %>
+            <p><%= highlight_search_match(snippet, @search.query) %></p>
+          <% end %>
+          <% @comment_texts.fetch(card.id, []).each do |text| %>
+            <p><%= highlight_search_match(excerpt(text, @search.query).to_s, @search.query) %></p>
+          <% end %>
+        </article>
+      <% end %>
+      <% if @page.empty? %>
+        <p>No matching cards</p>
+      <% end %>
+    <% end %>
+  <% end %>
+</section>
