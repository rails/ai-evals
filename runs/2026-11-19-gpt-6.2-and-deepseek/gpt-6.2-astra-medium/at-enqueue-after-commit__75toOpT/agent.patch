new file mode 100644
index 0000000..8186df2
--- /dev/null
+++ b/test/models/book/editing_test.rb
@@ -0,0 +1,17 @@
+require "test_helper"
+
+class Book::EditingTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "edit jobs wait for the surrounding transaction to commit" do
+    book = books(:handbook)
+
+    Book.transaction do
+      book.apply_edit(cover: active_storage_blobs(:handbook_reading_image_blob))
+      assert_no_enqueued_jobs only: [ Book::CoverProcessingJob, Book::SearchIndexJob ]
+    end
+
+    assert_enqueued_with job: Book::CoverProcessingJob, args: [ book ]
+    assert_enqueued_with job: Book::SearchIndexJob, args: [ book ]
+  end
+end
