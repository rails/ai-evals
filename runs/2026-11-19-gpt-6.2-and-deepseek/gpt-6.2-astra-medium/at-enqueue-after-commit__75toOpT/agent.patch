@@ -0,0 +1,19 @@
+require "test_helper"
+
+class Books::ImportsControllerTest < ActionDispatch::IntegrationTest
+  test "failed batch rolls back earlier edits but still notifies the operator" do
+    sign_in :kevin
+    book = books(:handbook)
+    original_title = book.title
+
+    post books_import_path, params: { books: {
+      book.id => { title: "Imported", cover: fixture_file_upload("reading.webp", "image/webp") },
+      0 => { title: "Missing book" }
+    } }
+
+    assert_response :not_found
+    assert_equal original_title, book.reload.title
+    assert_enqueued_with job: Books::ImportFailureJob
+    assert_no_enqueued_jobs only: [ Book::CoverProcessingJob, Book::SearchIndexJob ]
+  end
+end
