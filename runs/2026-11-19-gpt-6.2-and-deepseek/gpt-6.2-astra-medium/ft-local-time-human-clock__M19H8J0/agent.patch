+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "comments and auto-postponement use the browser's calendar" do
+    timezone = "America/Los_Angeles"
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+    sign_in_as(users(:kevin))
+
+    today = Time.current.in_time_zone(timezone).beginning_of_day
+    comments(:logo_agreement_kevin).update!(created_at: today.change(hour: 13, min: 42))
+    comments(:logo_agreement_jz).update!(created_at: today - 1.minute)
+    card = cards(:logo)
+    card.update!(last_active_at: today.tomorrow.noon - card.auto_postpone_period)
+
+    visit card_url(card)
+    assert_selector ".comment__permalink-title", exact_text: "1:42 PM"
+    assert_selector ".comment__permalink-title", exact_text: "yesterday"
+    assert_text "Moves to “Not Now” tomorrow"
+  ensure
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+  end
+end
