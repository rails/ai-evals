+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/local_time"
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.render()
+  }
+
+  render() {
+    const date = new Date(this.element.dateTime)
+    this.element.textContent = formatLocalTime(date, this.formatValue)
+    if (this.formatValue !== "weekday") this.element.title = formatLocalTime(date, "datetime")
+  }
+}
