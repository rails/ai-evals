diff --git a/app/javascript/helpers/local_time.js b/app/javascript/helpers/local_time.js
new file mode 100644
index 0000000..4c82830
--- /dev/null
+++ b/app/javascript/helpers/local_time.js
@@ -0,0 +1,28 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const formats = {
+  clock: { hour: "numeric", minute: "2-digit" },
+  date: { month: "short", day: "numeric" },
+  dated: { year: "numeric", month: "short", day: "numeric" },
+  datetime: { dateStyle: "short", timeStyle: "short" },
+  // Timeline headings identify a calendar date, not an instant at midnight.
+  weekday: { weekday: "long", month: "long", day: "numeric", timeZone: "UTC" }
+}
+const formatters = Object.fromEntries(Object.entries(formats).map(([ name, options ]) =>
+  [ name, new Intl.DateTimeFormat("en-US", options) ]
+))
+const relativeDays = new Intl.RelativeTimeFormat("en", { numeric: "auto" })
+
+export function formatLocalTime(date, format, now = new Date()) {
+  if (format === "relative" || format === "due") {
+    const days = signedDifferenceInDays(now, date)
+
+    if (format === "due") return relativeDays.format(Math.max(0, days), "day")
+    if (days === 0) return formatters.clock.format(date)
+    if (Math.abs(days) < 7) return relativeDays.format(days, "day")
+
+    format = date.getFullYear() === now.getFullYear() ? "date" : "dated"
+  }
+
+  return formatters[format].format(date)
+}
