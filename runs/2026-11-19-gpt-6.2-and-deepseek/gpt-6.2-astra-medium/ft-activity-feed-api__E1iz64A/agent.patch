+++ b/docs/api/sections/activities.md
@@ -0,0 +1,16 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a paginated array of events on boards the current user can access, newest first. Use `creator_ids[]` and `board_ids[]` to filter by creator and board. Follow the `Link` header for the next page.
+
+Each event includes `id`, `action`, `created_at`, a plain-text `description`, and a `url` that opens the card (at the comment for a comment event). The `eventable_type` is `Card` or `Comment`; `eventable`, `board`, and `creator` use the standard card or comment, board, and user representations.
+
+| Action | Fields in `particulars` |
+| --- | --- |
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Missing board names, titles, and column names are empty strings. For other actions, `particulars` is `{}`.
diff --git a/lib/rails_ext/geared_pagination_query_parameters.rb b/lib/rails_ext/geared_pagination_query_parameters.rb
new file mode 100644
index 0000000..e4a79cd
--- /dev/null
+++ b/lib/rails_ext/geared_pagination_query_parameters.rb
@@ -0,0 +1,14 @@
+require "geared_pagination/headers"
+
+# Geared Pagination 1.2 flattens the query to a hash of strings, losing all but
+# the last value of array filters such as creator_ids[] in next-page links.
+module GearedPaginationQueryParameters
+  private
+    def uri(page:)
+      Addressable::URI.parse(request.url).tap do |uri|
+        uri.query = request.query_parameters.merge("page" => page).to_query
+      end
+    end
+end
+
+GearedPagination::Headers.prepend GearedPaginationQueryParameters
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..2badbb6
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "lists card and comment activity newest first" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    activities = response.parsed_body
+    assert_equal activities.pluck("created_at").sort.reverse, activities.pluck("created_at")
+    by_id = activities.index_by { |activity| activity.fetch("id") }
+
+    event = events(:layout_assignment_jz)
+    activity = by_id.fetch(event.id)
+    assert_equal %w[ action board created_at creator description eventable eventable_type id particulars url ], activity.keys.sort
+    assert_equal "card_assigned", activity["action"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal event.card.title, activity.dig("eventable", "title")
+    assert_equal event.board.name, activity.dig("board", "name")
+    assert_equal event.creator.name, activity.dig("creator", "name")
+    assert_equal event.description_for(users(:david)).to_plain_text, activity["description"]
+    assert_equal({ "assignee_ids" => event.assignee_ids }, activity["particulars"])
+    assert_equal card_url(event.card), activity["url"]
+
+    comment = events(:layout_commented).eventable
+    activity = by_id.fetch(events(:layout_commented).id)
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.body.to_plain_text, activity.dig("eventable", "body", "plain_text")
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "only includes supported actions and their public particulars" do
+    events(:logo_published).update!(action: "card_collection_changed")
+    events(:layout_published).update!(action: "card_resumed")
+    events(:text_published).update!(action: "card_title_changed", particulars: { particulars: { old_title: "Before", internal: 123 } })
+    events(:shipping_published).update!(action: "card_board_changed", particulars: { particulars: { new_board: "Elsewhere" } })
+    events(:shipping_closed).update!(action: "card_triaged")
+
+    get activities_path(format: :json)
+    assert_response :success
+    by_action = response.parsed_body.index_by { |activity| activity.fetch("action") }
+    assert_not by_action.key?("card_collection_changed")
+    assert_not by_action.key?("card_resumed")
+    assert_equal({ "old_title" => "Before", "new_title" => "" }, by_action.fetch("card_title_changed")["particulars"])
+    assert_equal({ "old_board" => "", "new_board" => "Elsewhere" }, by_action.fetch("card_board_changed")["particulars"])
+    assert_equal({ "column" => "" }, by_action.fetch("card_triaged")["particulars"])
+  end
+
+  test "filters by creator and board without exposing inaccessible boards" do
+    hidden = events(:text_published)
+    hidden.update!(board: boards(:private))
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id, boards(:private).id ] }
+    assert_response :success
+    assert_equal events(:shipping_closed, :shipping_published).map(&:id), response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_empty response.parsed_body
+  end
+
+  test "paginates the filtered activity feed" do
+    card = cards(:layout)
+    16.times { card.track_event(:published, creator: users(:jz)) }
+
+    creators = users(:jz, :kevin)
+    expected_ids = Event.where(creator: creators).order(created_at: :desc, id: :desc).ids
+    get activities_path(format: :json), params: { creator_ids: creators.map(&:id) }
+    assert_response :success
+    first_ids = response.parsed_body.pluck("id")
+    assert_equal expected_ids.size.to_s, response.headers["X-Total-Count"]
+    next_url = response.headers.fetch("Link")[/<(.*?)>; rel="next"/, 1]
+
+    get next_url
+    assert_response :success
+    assert_nil response.headers["Link"]
+    all_ids = first_ids + response.parsed_body.pluck("id")
+    assert_equal expected_ids, all_ids
+  end
+end
