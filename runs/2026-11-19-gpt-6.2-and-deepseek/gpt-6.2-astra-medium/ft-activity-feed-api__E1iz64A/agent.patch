--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,24 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      activity_details(:old_board, :new_board)
+    when "card_title_changed"
+      activity_details(:old_title, :new_title)
+    when "card_triaged"
+      activity_details(:column)
+    else
+      {}
+    end
+  end
+
+  private
+    def activity_details(*keys)
+      keys.index_with { |key| particulars.dig("particulars", key.to_s).to_s }
+    end
 end
