@@ -36,6 +36,27 @@ class SessionsControllerTest < ActionDispatch::IntegrationTest
     assert parsed_cookies.signed[:session_token]
   end
 
+  test "create preserves local return paths and same-origin deep links" do
+    leaf = leaves(:welcome_page)
+    path = leafable_slug_path(leaf, page: 2, anchor: "notes")
+
+    [ path, leafable_slug_url(leaf, page: 2, anchor: "notes") ].each do |destination|
+      post session_path, params: { email_address: "david@example.com", password: "secret123456", return_to: destination }
+
+      assert_redirected_to path
+    end
+  end
+
+  test "create falls back after authenticating with an unsafe return destination" do
+    [ "https://example.org/page", "//example.org/page", root_url(port: 8080),
+      "/bad\npath", [ "/page" ], { path: "/page" } ].each do |destination|
+      post session_path, params: { email_address: "david@example.com", password: "secret123456", return_to: destination }
+
+      assert_redirected_to root_path
+      assert parsed_cookies.signed[:session_token]
+    end
+  end
+
