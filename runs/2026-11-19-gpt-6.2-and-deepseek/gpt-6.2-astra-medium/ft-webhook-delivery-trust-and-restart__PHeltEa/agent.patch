diff --git a/docs/api/sections/webhooks.md b/docs/api/sections/webhooks.md
index a4f48b5..e92bfb9 100644
--- a/docs/api/sections/webhooks.md
+++ b/docs/api/sections/webhooks.md
@@ -2,6 +2,14 @@
 
 Webhooks notify another application when something happens on a board. Only account admins can list, view, create, update, delete, or reactivate webhooks.
 
+## Receiving deliveries
+
+When an event matches an active subscription on its board, Fizzy queues a POST to the configured URL. A generic receiver gets JSON with the event ID, action, creation time, board, creator, and affected card or comment. Verify `X-Webhook-Signature` against the hex HMAC-SHA256 of the raw body using the webhook’s signing secret.
+
+There is one delivery per webhook and event. Each POST includes the delivery ID as its `Idempotency-Key`. Fizzy does not retry an attempted POST: if a connection drops after sending, it cannot tell whether the receiver processed the event. A 2xx response is a success; redirects are not followed.
+
+Fizzy deactivates a webhook after at least ten consecutive failures spanning at least one hour. A success or manual reactivation clears the streak. Delivery history is pruned after seven days.
+
 ## `GET /:account_slug/boards/:board_id/webhooks`
 
 Returns a paginated list of webhooks for a board.
diff --git a/test/jobs/webhook/delivery_job_test.rb b/test/jobs/webhook/delivery_job_test.rb
new file mode 100644
index 0000000..26717bf
--- /dev/null
+++ b/test/jobs/webhook/delivery_job_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class WebhookDeliveryJobTest < ActiveSupport::TestCase
+  test "a board event sends one signed POST to each subscribed active webhook" do
+    webhook = webhooks(:active)
+    webhook.board.webhooks.create!(name: "Inactive", url: webhook.url, active: false, subscribed_actions: webhook.subscribed_actions)
+    webhook.board.webhooks.create!(name: "Unsubscribed", url: webhook.url, subscribed_actions: [])
+    webhooks(:inactive).activate
+    SsrfProtection.stubs(:resolve_public_ip).returns("93.184.216.34")
+    stub_request(:post, webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 201)
+
+    event = Event.new(board: webhook.board, eventable: cards(:logo), creator: users(:david), action: "card_published")
+    assert_difference "Webhook::Delivery.count", 1 do
+      event.save!
+    end
+    delivery = event.webhook_deliveries.sole
+    assert_equal webhook, delivery.webhook
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert_requested :post, webhook.url, times: 1 do |request|
+      payload = JSON.parse(request.body)
+      assert_equal event.id, payload.fetch("id")
+      assert_equal delivery.id, request.headers["Idempotency-Key"]
+      assert_includes payload.dig("board", "url"), webhook.account.slug
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+    end
+    assert_predicate delivery.reload, :succeeded?
+    assert_equal 201, delivery.response[:code]
+  end
+
+  test "a rolled back event neither creates a log nor queues a POST" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference "Webhook::Delivery.count" do
+        Event.transaction(requires_new: true) do
+          Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_closed")
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "ten consecutive failures spanning at least one hour switch off the webhook" do
+    webhook = webhooks(:active)
+    SsrfProtection.stubs(:resolve_public_ip).returns("93.184.216.34")
+    post = stub_request(:post, webhook.url).to_return(status: 503)
+
+    freeze_time do
+      10.times { publish_and_deliver(webhook) }
+      assert_predicate webhook.reload, :active?, "a burst of failures should not switch off a webhook"
+
+      travel 1.hour
+      stub_request(:post, webhook.url).to_return(status: 204)
+      publish_and_deliver(webhook)
+      assert_equal 0, webhook.delinquency_tracker.reload.consecutive_failures_count
+
+      stub_request(:post, webhook.url).to_return(status: 503)
+      9.times { publish_and_deliver(webhook) }
+      travel 1.hour
+      assert_predicate webhook.reload, :active?
+      failure = publish_and_deliver(webhook)
+      assert_predicate failure, :failed?
+      assert_equal 503, failure.response[:code]
+      assert_not webhook.reload.active?
+      webhook_deliveries(:pending).deliver
+      assert_requested post, times: 21
+
+      webhook.activate
+      publish_and_deliver(webhook)
+      assert_predicate webhook.reload, :active?
+      assert_equal 1, webhook.delinquency_tracker.consecutive_failures_count
+    end
+  end
+
+  test "a timed out POST is logged without a second attempt" do
+    delivery = webhook_deliveries(:pending)
+    SsrfProtection.stubs(:resolve_public_ip).returns("93.184.216.34")
+    post = stub_request(:post, delivery.webhook.url).to_timeout
+
+    2.times { Webhook::DeliveryJob.perform_now(delivery) }
+
+    assert_requested post, times: 1
+    assert_predicate delivery.reload, :errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_equal 1, delivery.webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "a blocked destination is logged without a POST" do
+    delivery = webhook_deliveries(:pending)
+    SsrfProtection.expects(:resolve_public_ip).with("api.example.com").once.returns(nil)
+    2.times { delivery.deliver }
+
+    assert_predicate delivery.reload, :errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_not_requested :post, delivery.webhook.url
+  end
+
+  private
+    def publish_and_deliver(webhook)
+      event = Event.create!(board: webhook.board, eventable: cards(:logo), creator: users(:david), action: "card_published")
+      event.webhook_deliveries.sole.tap(&:deliver)
+    end
+end
