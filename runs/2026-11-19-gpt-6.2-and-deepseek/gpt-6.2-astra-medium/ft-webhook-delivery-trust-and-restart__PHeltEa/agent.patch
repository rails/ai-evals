   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).in_batches.delete_all
+  end
+
+  def deliver
+    # Claim before doing I/O. A duplicate job must never replay a POST whose
+    # response was lost, even if the first worker died before recording it.
+    return unless self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+
+    if webhook.reload.active? && event.eventable&.board == webhook.board
+      send_request
+    else
+      update!(state: :errored, response: { error: "no_longer_applicable" })
+    end
+  end
+
