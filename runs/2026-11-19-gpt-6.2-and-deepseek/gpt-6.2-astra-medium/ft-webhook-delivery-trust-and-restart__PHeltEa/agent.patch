     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +45,24 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def send_request
+      post = Request.new(self)
+      update!(request: { headers: post.headers })
+      finish(:completed, code: post.post)
+    rescue ActionView::Template::Error => error
+      Rails.error.report(error)
+      update!(state: :errored, response: { error: "payload_unavailable" })
+    rescue Request::DestinationUnreachable
+      finish(:errored, error: "destination_unreachable")
+    end
+
+    def finish(state, **response)
+      webhook.with_lock do
+        update!(state: state, response: response)
+        tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+        succeeded? ? tracker.reset_failures : tracker.record_failure
+      end
+    end
 end
diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..41db941
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,63 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  class DestinationUnreachable < StandardError; end
+
+  attr_reader :delivery
+  delegate :event, :webhook, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def headers
+    @headers ||= {
+      "Content-Type" => webhook.for_campfire? ? "text/html" : "application/json",
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Idempotency-Key" => delivery.id,
+      "X-Webhook-Timestamp" => Time.current.iso8601,
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    }
+  end
+
+  def post
+    uri = URI.parse(webhook.url)
+    raise URI::InvalidURIError unless uri.is_a?(URI::HTTP) && uri.hostname.present?
+
+    ip = SsrfProtection.resolve_public_ip(uri.hostname)
+    raise DestinationUnreachable unless ip
+
+    # Pin the validated address, retaining the hostname for TLS. Do not use an
+    # environment proxy or follow redirects to a second, unchecked destination.
+    http = Net::HTTP.new(uri.hostname, uri.port, nil)
+    http.ipaddr = ip
+    http.use_ssl = uri.is_a?(URI::HTTPS)
+    http.open_timeout = http.read_timeout = http.write_timeout = 5
+    http.max_retries = 0
+
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+    http.request(request) { |response| return response.code.to_i }
+  rescue URI::InvalidURIError, Resolv::ResolvError, IOError, SystemCallError, SocketError, Timeout::Error,
+      OpenSSL::SSL::SSLError, Net::ProtocolError, Net::HTTPBadResponse
+    raise DestinationUnreachable
+  end
+
+  private
+    def body
+      @body ||= if webhook.for_slack?
+        { text: event.description_for(nil).to_plain_text }.to_json
+      elsif webhook.for_campfire?
+        render_event(:html)
+      elsif webhook.for_basecamp?
+        { content: render_event(:html) }.to_json
+      else
+        render_event(:json)
+      end
+    end
+
+    def render_event(format)
+      ApplicationController.renderer.new(script_name: event.account.slug).render(
+        template: "webhooks/event", formats: [ format ], layout: false, assigns: { event: event })
+    end
+end
