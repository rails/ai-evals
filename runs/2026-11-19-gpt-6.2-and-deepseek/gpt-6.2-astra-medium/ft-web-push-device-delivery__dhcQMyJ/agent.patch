new file mode 100644
index 0000000..d408fae
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,21 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :ensure_current_user
+
+  def create
+    attributes = params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    subscription = PushSubscription.register(user: Current.user, session: Current.session, attributes: attributes)
+    render json: { id: subscription.id }
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  def destroy
+    Current.user.push_subscriptions.where(session: Current.session).find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def ensure_current_user
+      head :forbidden unless Current.session && Current.user.id == params[:user_id]
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..cb5f4d0
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,73 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "help", "error" ]
+  static values = { url: String, publicKey: String, devices: Object }
+
+  async connect() {
+    this.buttonTarget.disabled = true
+    if (!("serviceWorker" in navigator && "PushManager" in window && "Notification" in window) || Notification.permission === "denied") {
+      this.element.classList.remove("notifications--on")
+      this.helpTarget.hidden = false
+      return
+    }
+
+    try {
+      this.registration = await navigator.serviceWorker.ready
+      const subscription = await this.registration.pushManager.getSubscription()
+      this.deviceKey = subscription?.toJSON().keys?.p256dh
+      this.#updateStatus()
+    } catch {
+      this.helpTarget.hidden = false
+    }
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+    this.errorTarget.hidden = true
+    try {
+      if (this.deviceId) {
+        await this.#disable()
+      } else if (await Notification.requestPermission() === "granted") {
+        await this.#enable()
+      }
+    } catch {
+      this.errorTarget.hidden = false
+    } finally {
+      this.#updateStatus()
+    }
+  }
+
+  get deviceId() {
+    return this.devicesValue[this.deviceKey]
+  }
+
+  async #enable() {
+    const subscription = await this.registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.publicKeyValue })
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.urlValue, { responseKind: "json", body: {
+      push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth }
+    } })
+    if (!response.ok) throw new Error("Could not register device")
+
+    this.deviceKey = keys.p256dh
+    this.devicesValue = { ...this.devicesValue, [this.deviceKey]: (await response.json).id }
+  }
+
+  async #disable() {
+    // The browser subscription can still be in use by another account on this device.
+    const response = await destroy(`${this.urlValue}/${this.deviceId}`, { responseKind: "json" })
+    if (!response.ok) throw new Error("Could not remove device")
+
+    const devices = this.devicesValue
+    delete devices[this.deviceKey]
+    this.devicesValue = devices
+  }
+
+  #updateStatus() {
+    this.element.classList.toggle("notifications--on", Boolean(this.deviceId))
+    this.buttonTarget.disabled = Notification.permission === "denied"
+    this.helpTarget.hidden = Notification.permission !== "denied"
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
new file mode 100644
