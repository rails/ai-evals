--- /dev/null
+++ b/app/jobs/notification/push_job.rb
@@ -0,0 +1,10 @@
+class Notification::PushJob < ApplicationJob
+  self.log_arguments = false
+
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError, wait: :polynomially_longer
+
+  def perform(notification, subscription, message)
+    subscription.deliver(message) if PushSubscription.configured? && notification.user.active? && notification.card.accessible_to?(notification.user)
+  end
+end
