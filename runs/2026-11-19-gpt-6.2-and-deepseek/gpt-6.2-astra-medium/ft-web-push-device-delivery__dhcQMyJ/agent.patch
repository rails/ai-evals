@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @user = users(:david)
+    @subscription = { endpoint: "https://fcm.googleapis.com/fcm/send/device", p256dh_key: "public-key", auth_key: "secret" }
+  end
+
+  test "registering the same device refreshes its keys" do
+    2.times do |index|
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.merge(auth_key: "secret-#{index}") }, as: :json
+      assert_response :success
+    end
+
+    assert_equal "secret-1", @user.push_subscriptions.sole.auth_key
+  end
+
+  test "cannot register for another user" do
+    post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @subscription }, as: :json
+    assert_response :forbidden
+  end
+
+  test "signing out removes subscriptions for this session" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    assert_response :success
+    @user.push_subscriptions.sole.session.destroy!
+    assert_empty @user.push_subscriptions.reload
+  end
+
+  test "does not accept arbitrary delivery hosts" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.merge(endpoint: "https://internal.example/test") }, as: :json
+    assert_response :unprocessable_entity
+  end
+end
diff --git a/test/jobs/notification/push_job_test.rb b/test/jobs/notification/push_job_test.rb
new file mode 100644
index 0000000..0348f5b
--- /dev/null
+++ b/test/jobs/notification/push_job_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Notification::PushJobTest < ActiveJob::TestCase
+  setup do
+    @user = users(:david)
+    @subscription = @user.push_subscriptions.create!(endpoint: "https://web.push.apple.com/device", p256dh_key: "public", auth_key: "secret", session: sessions(:david))
+    PushSubscription.stubs(:configured?).returns(true)
+  end
+
+  test "delivers the event then the mention even when they share a tray row" do
+    card = cards(:logo)
+    notifications(:logo_mentioned_david).destroy!
+    mention = mentions(:logo_comment_david_mention_by_jz)
+    messages = []
+    PushSubscription.any_instance.stubs(:deliver).with { |message| messages << JSON.parse(message); true }
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      notification = Notification.create!(user: @user, source: events(:logo_assignment_david), creator: users(:david))
+      notification.update!(source: mention, creator: mention.mentioner)
+      notification.read
+      notification.unread
+    end
+
+    assert_equal [ card.title, "JZ @mentioned you" ], messages.pluck("title")
+    assert_equal [ "Assigned to David", mention.source.mentionable_content.truncate(200) ], messages.pluck("body")
+    assert_equal [ "#{card.account.slug}/cards/#{card.to_param}" ], messages.pluck("url").uniq
+  end
+
+  test "enqueues one push per recipient device, none for other users" do
+    second = @user.push_subscriptions.create!(@subscription.attributes.slice("session_id", "p256dh_key", "auth_key").merge(endpoint: "https://fcm.googleapis.com/fcm/send/second"))
+    users(:kevin).push_subscriptions.create!(session: sessions(:kevin), endpoint: "https://web.push.apple.com/other", p256dh_key: "other", auth_key: "secret")
+
+    notification = notifications(:logo_mentioned_david)
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      notification.update!(source: mentions(:logo_card_david_mention_by_jz))
+    end
+    [ @subscription, second ].each do |subscription|
+      assert_enqueued_with(job: Notification::PushJob, args: ->(args) { args.first(2) == [ notification, subscription ] })
+    end
+  end
+
+  test "sends encrypted Web Push with the configured VAPID key and retires expired endpoints" do
+    vapid = WebPush.generate_key
+    ENV.stubs(:fetch).with("VAPID_PUBLIC_KEY").returns(vapid.public_key)
+    ENV.stubs(:fetch).with("VAPID_PRIVATE_KEY").returns(vapid.private_key)
+    @subscription.update!(p256dh_key: WebPush.generate_key.public_key, auth_key: Base64.urlsafe_encode64(SecureRandom.random_bytes(16)))
