diff --git a/app/javascript/helpers/locale_helpers.js b/app/javascript/helpers/locale_helpers.js
new file mode 100644
index 0000000..40bd0eb
--- /dev/null
+++ b/app/javascript/helpers/locale_helpers.js
@@ -0,0 +1,9 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+// Changing locale reloads the document (the locale meta tag is Turbo-tracked).
+export const locale = document.documentElement.lang === "en" ? "en-US" : (document.documentElement.lang || "en-US")
+const translations = JSON.parse(getMetaContent("translations") || "{}")
+
+export function translate(key, values = {}) {
+  return translations[key].replace(/%\{(\w+)\}/g, (_, name) => values[name])
+}
