diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..9e4e953
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,29 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_request_locale
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def with_request_locale(&)
+      requested = params[:locale]
+      if I18n.available_locales.map(&:to_s).include?(requested)
+        session[:locale] = requested
+      end
+
+      I18n.with_locale(session[:locale] || I18n.default_locale, &)
+    end
+
+    # A choice made before authentication belongs to the browser until we know
+    # who signed in. Never change a preference just because an email was entered.
+    def apply_identity_locale(identity)
+      if choice = session[:locale]
+        identity.update!(locale: choice) unless choice == identity.locale
+        session.delete(:locale)
+      end
+      I18n.locale = identity.preferred_locale
+    end
+end
