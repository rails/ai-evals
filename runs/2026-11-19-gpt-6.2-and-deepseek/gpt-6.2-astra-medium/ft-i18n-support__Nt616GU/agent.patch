diff --git a/app/helpers/job_console_helper.rb b/app/helpers/job_console_helper.rb
new file mode 100644
index 0000000..693d6d5
--- /dev/null
+++ b/app/helpers/job_console_helper.rb
@@ -0,0 +1,41 @@
+module JobConsoleHelper
+  # Used only by Mission Control's Japanese template overrides.
+  def job_elapsed_time(time)
+    tag.span time_ago_in_words(time, include_seconds: true), title: l(time, format: :long)
+  end
+
+  def job_relative_time(time)
+    safe_join [ job_elapsed_time(time), time.past? ? "前" : "後" ]
+  end
+
+  def localized_job_navigation
+    { queues: [ "キュー", application_queues_path(@application) ] }.tap do |sections|
+      supported_job_statuses.without(:pending).each do |status|
+        label = "#{t("operations.status.#{status}")}のジョブ（#{jobs_count_with_status(status)}）"
+        sections[navigation_section_for_status(status)] = [ label, application_jobs_path(@application, status) ]
+      end
+      sections[:workers] = [ "ワーカー", application_workers_path(@application) ] if workers_exposed?
+      sections[:recurring_tasks] = [ "定期タスク", application_recurring_tasks_path(@application) ] if recurring_tasks_supported?
+    end
+  end
+
+  # These flashes originate inside the engine; leave arbitrary diagnostic
+  # messages and identifiers intact rather than translating job payloads.
+  def localized_job_notice(message)
+    case message
+    when /\ADiscarded (\d+) jobs\z/ then "#{$1}件のジョブを破棄しました"
+    when /\ARetried (\d+) jobs\z/ then "#{$1}件のジョブを再試行しました"
+    when /\ADiscarded job with id (.+)\z/ then "ジョブ #{$1} を破棄しました"
+    when /\ARetried job with id (.+)\z/ then "ジョブ #{$1} を再試行しました"
+    when /\ADispatched job with id (.+)\z/ then "ジョブ #{$1} を実行しました"
+    when /\AEnqueued recurring task (.+)\z/ then "定期タスク #{$1} を登録しました"
+    when /\A(?:Job|Worker|Recurring task) with id '(.+)' not found\z/, /\AQueue '(.+)' not found\z/ then "「#{$1}」が見つかりません"
+    when "Application not found" then "アプリケーションが見つかりません"
+    when "Server not found" then "サーバーが見つかりません"
+    when "Something went wrong enqueuing this recurring task", "This task can't be enqueued" then "定期タスクを登録できませんでした"
+    when "This server doesn't support recurring tasks" then "このサーバーは定期タスクに対応していません"
+    when "This server doesn't expose workers" then "このサーバーではワーカーを表示できません"
+    else message
+    end
+  end
+end
