diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..c7e9fa7
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates only accounts past the cancellation grace period" do
+    account = accounts("37s")
+    other = accounts(:initech)
+    identity = users(:david).identity
+    ActiveStorage::Blob.create_and_upload!(io: StringIO.new("upload"), filename: "unused.txt")
+    cards(:logo).image.attach(io: StringIO.new("attachment"), filename: "card.txt")
+
+    cards(:logo).reindex
+    cards(:radio).reindex
+    board_total = boards(:writebook).create_storage_total!
+
+    freeze_time do
+      account.create_cancellation!(initiated_by: users(:david), created_at: 30.days.ago - 1.second)
+      other.create_cancellation!(initiated_by: users(:mike), created_at: 30.days.ago)
+
+      perform_enqueued_jobs(only: ActiveStorage::PurgeJob) do
+        Current.without_account { Account::IncinerateDueJob.perform_now }
+      end
+
+      assert_not Account.exists?(account.id)
+      assert_not Account::Cancellation.exists?(account: account)
+      assert_not Board.exists?(account: account)
+      assert_not User.exists?(account: account)
+      assert_not Card.exists?(account: account)
+      assert_not ActionText::RichText.exists?(account: account)
+      assert_not Search::Record.for(account.id).exists?(account_id: account.id)
+      assert_not Storage::Total.exists?(board_total.id)
+      assert_not ActiveStorage::Attachment.exists?(account: account)
+      assert_not Storage::Entry.exists?(account: account)
+      assert_not ActiveStorage::Blob.exists?(account: account)
+      assert Identity.exists?(identity.id)
+      assert Board.exists?(account: other)
+      assert Search::Record.for(other.id).exists?(account_id: other.id)
+      assert Account.exists?(other.id)
+      assert Account.exists?(accounts(:acme).id)
+    end
+  end
+
+  test "reactivation prevents incineration" do
+    account = accounts("37s")
+    account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    candidate = Account.due_for_incineration.find(account.id)
+    account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      candidate.incinerate
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+end
