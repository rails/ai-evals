diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..bf0775e 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,55 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    transaction do
+      # Recheck under lock: the account may have been reactivated since the sweep began.
+      if self.class.due_for_incineration.lock.exists?(id)
+        incinerate_storage
+        incinerate_content
+        destroy!
+      end
+    end
+  end
+
+  private
+    def incinerate_storage
+      # Remove content attachments without generating new storage ledger entries. Let
+      # Active Storage purge previews/variants with their blobs, and keep shared blobs.
+      ActiveStorage::Attachment.where(account: self)
+        .where.not(record_type: %w[ ActiveStorage::Blob ActiveStorage::VariantRecord Identity ]).delete_all
+      ActiveStorage::Blob.unattached.where(account: self).find_each(&:purge_later)
+      Storage::Entry.where(account: self).delete_all
+      Storage::Total.where(owner: boards).delete_all
+    end
+
+    def incinerate_content
+      # Filters own join rows without an account_id. Search records own FTS rows on SQLite.
+      Filter.where(account: self).find_each(&:destroy!)
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy!)
+
+      # Delete by tenant, not by walking every card's associations. This removes even
+      # records whose parent has gone away and avoids enqueuing per-record callbacks.
+      [ Webhook::Delivery, Webhook::DelinquencyTracker, Notification, Notification::Bundle,
+        Event, Mention, Reaction, Pin, Watch, Tagging, Assignment, Closure, Step, Card::Goldness,
+        Card::NotNow, Card::ActivitySpike, ActionText::RichText, Comment, Card, Access,
+        Board::Publication, Column, Webhook, Entropy, Board, Tag, Search::Query, Push::Subscription,
+        User::Settings, Export, Account::Import, Account::JoinCode, User ].each do |model|
+        model.where(account_id: id).delete_all
+      end
+    end
 end
