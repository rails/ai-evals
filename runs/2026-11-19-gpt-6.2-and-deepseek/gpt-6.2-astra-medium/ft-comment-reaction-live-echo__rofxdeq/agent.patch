diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..e07890a
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "add and remove a reaction" do
+    post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "Great 👍" } }, as: :turbo_stream
+    assert_response :success
+    assert_turbo_stream action: :append
+    reaction = @comment.reactions.sole
+    assert_equal "Great 👍", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+
+    delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    assert_turbo_stream action: :remove
+    assert_empty @comment.reactions.reload
+  end
+
+  test "cached comments show the current reactions on a later visit" do
+    with_actionview_partial_caching do
+      get card_path(@comment.card)
+      assert_select "##{dom_id(@comment, :reactions)} .reaction", count: 0
+
+      reaction = @comment.reactions.create!(content: "Yes!", reacter: users(:david))
+      get card_path(@comment.card)
+      assert_select "##{dom_id(@comment, :reactions)} ##{dom_id(reaction)}", text: /Yes!/
+
+      reaction.destroy!
+      get card_path(@comment.card)
+      assert_select "##{dom_id(@comment, :reactions)} .reaction", count: 0
+    end
+  end
+
+  test "reactions cannot be blank or longer than sixteen characters" do
+    [ " ", "x" * 17 ].each do |content|
+      assert_no_difference -> { @comment.reactions.count } do
+        post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+        assert_response :unprocessable_entity
+      end
+    end
+
+    post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "👍" * 16 } }, as: :json
+    assert_response :created
+    get card_comment_reactions_path(@comment.card, @comment), as: :json
+    assert_equal "👍" * 16, response.parsed_body.sole["content"]
+  end
+
+  test "cannot remove someone else's reaction or remove it via another comment" do
+    reaction = @comment.reactions.create!(content: "👏", reacter: users(:david))
+    delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+    assert_response :forbidden
+
+    delete card_comment_reaction_path(@comment.card, comments(:logo_agreement_kevin), reaction), as: :json
+    assert_response :not_found
+    assert Reaction.exists?(reaction.id)
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..18767dd
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,39 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:david)
+    @comment = comments(:logo_agreement_jz)
+    visit card_url(@comment.card)
+  end
+
+  test "adding, canceling and removing a reaction" do
+    within "##{dom_id(@comment)}" do
+      find(".reactions__trigger").click
+      find(".reaction__cancel-btn").click
+      find(".reactions__trigger").click
+      find(".reaction__input").set(" ")
+      find(".reaction__submit-btn").click
+      assert_selector "[role=alert]", text: "blank"
+      find(".reaction__input").set("Thanks! 👍")
+      find(".reaction__submit-btn").click
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction__input"
+      assert_no_selector "button[aria-label='Remove reaction']"
+      find("summary", text: "Thanks! 👍").click
+      find("button[aria-label='Remove reaction']").click
+      assert_no_selector ".reaction"
+    end
+  end
+
+  test "other viewers receive additions and removals" do
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+    assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+
+    reaction = @comment.reactions.create!(content: "🎉", reacter: users(:kevin))
+    perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+    assert_selector "##{dom_id(reaction)} [data-only-visible-to-others]", text: "🎉"
+    reaction.destroy!
+    assert_no_selector "##{dom_id(reaction)}"
+  end
+end
