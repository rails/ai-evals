new file mode 100644
index 0000000..5793059
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,47 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+
+  def index
+  end
+
+  def new
+    @reaction = @comment.reactions.new
+  end
+
+  def create
+    @reaction = @comment.reactions.new(params.expect(reaction: [ :content ]))
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { head :created }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { render :new, formats: :html, content_type: "text/html", status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction = @comment.reactions.find(params[:id])
+
+    if @reaction.reacter == Current.user
+      @reaction.destroy!
+      respond_to do |format|
+        format.turbo_stream { render turbo_stream: turbo_stream.remove(@reaction) }
+        format.json { head :no_content }
+      end
+    else
+      head :forbidden
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+end
