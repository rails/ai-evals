diff --git a/app/models/book/search_limit.rb b/app/models/book/search_limit.rb
new file mode 100644
index 0000000..a9a168a
--- /dev/null
+++ b/app/models/book/search_limit.rb
@@ -0,0 +1,40 @@
+# A rolling window of admitted searches, shared by all books.
+class Book::SearchLimit
+  LIMIT = 30
+  WINDOW = 1.minute
+
+  # Check and record in one operation across web workers. Only the oldest of
+  # the last LIMIT admissions needs checking; refusals do not extend the TTL.
+  ADMIT = <<~LUA
+    local key, limit, window = KEYS[1], tonumber(ARGV[1]), tonumber(ARGV[2])
+    local time = redis.call('TIME')
+    local now = time[1] * 1000000 + time[2]
+    local oldest = redis.call('LINDEX', key, limit - 1)
+    if oldest and tonumber(oldest) > now - window * 1000000 then return 0 end
+
+    redis.call('LPUSH', key, now)
+    redis.call('LTRIM', key, 0, limit - 1)
+    redis.call('EXPIRE', key, window)
+    return 1
+  LUA
+
+  # Development and test can run without Redis (and with Rails caching off).
+  LOCAL_WINDOWS = ActiveSupport::Cache::MemoryStore.new
+  LOCAL_LOCK = Mutex.new
+
+  def self.allow?(address)
+    key = "book-search:#{address}"
+    if Rails.cache.is_a?(ActiveSupport::Cache::RedisCacheStore)
+      Rails.cache.redis.then { |redis| redis.eval(ADMIT, keys: [ key ], argv: [ LIMIT, WINDOW.to_i ]) == 1 }
+    else
+      LOCAL_LOCK.synchronize do
+        now = Time.current
+        times = LOCAL_WINDOWS.read(key) || []
+        return false if times.size == LIMIT && times.first > now - WINDOW
+
+        times.shift if times.size == LIMIT
+        LOCAL_WINDOWS.write(key, times << now, expires_in: WINDOW)
+      end
+    end
+  end
+end
