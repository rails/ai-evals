@@ -27,6 +27,44 @@ class Books::SearchesControllerTest < ActionDispatch::IntegrationTest
     assert_response :not_found
   end
 
+  test "anonymous searches share a rolling minute limit per address across books" do
+    sign_out
+    handbook, manual = books(:handbook, :manual)
+    [ handbook, manual ].each { |book| book.update!(published: true) }
+    reader = { "REMOTE_ADDR" => "192.0.2.1" }
+    query = { search: "Thanks" }
+
+    freeze_time do
+      post book_search_path(manual), params: query, headers: reader
+      assert_response :success
+
+      travel 50.seconds
+      29.times do
+        post book_search_path(handbook), params: query, headers: reader
+        assert_response :success
+      end
+      post book_search_path(handbook), params: query, headers: reader
+      assert_response :too_many_requests
+
+      post book_search_path(handbook), params: query, headers: { "REMOTE_ADDR" => "192.0.2.2" }
+      assert_response :success
+      assert_select "a", text: /Thanks for reading/i
+
+      get leafable_slug_path(leaves(:welcome_page)), headers: reader
+      assert_response :success
+
+      travel 11.seconds # Only the first request has aged out.
+      post book_search_path(manual), params: query, headers: reader
+      assert_response :success
+      post book_search_path(manual), params: query, headers: reader
+      assert_response :too_many_requests
+
+      travel 1.minute
+      post book_search_path(handbook), params: query, headers: reader
+      assert_response :success
+    end
+  end
+
