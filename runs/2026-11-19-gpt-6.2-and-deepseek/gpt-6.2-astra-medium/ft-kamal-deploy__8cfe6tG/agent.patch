+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - &hostname fizzy.example.com
+
+proxy:
+  host: *hostname
+  ssl: true
+
+# Kamal runs a local registry on the deploying machine and tunnels it over SSH.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64
+
+volumes:
+  - fizzy_storage:/rails/storage
+
+env:
+  clear:
+    APP_FQDN: *hostname
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
