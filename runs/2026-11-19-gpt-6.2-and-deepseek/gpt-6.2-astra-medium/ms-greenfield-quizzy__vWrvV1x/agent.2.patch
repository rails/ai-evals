diff --git a/app/services/quiz_document.rb b/app/services/quiz_document.rb
new file mode 100644
index 0000000..4533718
--- /dev/null
+++ b/app/services/quiz_document.rb
@@ -0,0 +1,56 @@
+class QuizDocument
+  class Invalid < StandardError; end
+
+  def self.dump(quiz)
+    questions = quiz.questions.map do |question|
+      options = question.options.map { |option| { text: option.fetch('text'), correct: option.fetch('correct', false) } }
+      { text: question.body, active: question.active?, options: options }
+    end
+    JSON.pretty_generate(title: quiz.title, questions: questions)
+  end
+
+  def self.import(json)
+    raise Invalid, 'Enter a quiz JSON document.' unless json.is_a?(String)
+    new(JSON.parse(json)).save!
+  rescue JSON::ParserError
+    raise Invalid, 'Quiz JSON is not valid JSON.'
+  end
+
+  def initialize(document)
+    @document = document
+  end
+
+  def save!
+    Quiz.transaction do
+      quiz = Quiz.create!(title: field(@document, 'title', String))
+      field(@document, 'questions', Array).each_with_index do |question, index|
+        import_question(quiz, question)
+      rescue Invalid, ActiveRecord::RecordInvalid => e
+        raise Invalid, "Question #{index + 1}: #{e.message}"
+      end
+      quiz
+    end
+  rescue ActiveRecord::RecordInvalid => e
+    raise Invalid, e.message
+  end
+
+  private
+
+  def import_question(quiz, question)
+    options = field(question, 'options', Array).map do |option|
+      { 'text' => field(option, 'text', String), 'correct' => boolean(option, 'correct', false) }
+    end
+    quiz.questions.create!(body: field(question, 'text', String), active: boolean(question, 'active', true), options: options)
+  end
+
+  def field(object, key, type)
+    raise Invalid, "Expected #{key} to be a #{type.name.downcase}." unless object.is_a?(Hash) && object[key].is_a?(type)
+    object[key]
+  end
+
+  def boolean(object, key, default)
+    value = object.fetch(key, default)
+    raise Invalid, "Expected #{key} to be true or false." unless value == true || value == false
+    value
+  end
+end
