new file mode 100644
index 0000000..3f2e108
--- /dev/null
+++ b/app/controllers/concerns/live_screen.rb
@@ -0,0 +1,15 @@
+module LiveScreen
+  private
+
+  # Only send personalized markup when something visible to this viewer changed.
+  def render_screen(*state)
+    no_store
+    @revision = Digest::SHA256.hexdigest(state.to_json).first(24)
+    if request.headers['X-Live-Screen'] == '1'
+      return head :no_content if request.headers['X-Screen-Version'] == @revision
+      render partial: 'screen'
+    else
+      render :show, layout: 'live'
+    end
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..5e35e65
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,42 @@
+class Moderate::GamesController < Moderate::BaseController
+  include LiveScreen
+  before_action :load_game, except: :create
+
+  def create
+    game = Game.start_lobby!(Quiz.find(params[:quiz_id]))
+    redirect_to moderate_game_path(game), status: :see_other
+  end
+
+  def show
+    case @game.phase
+    when 'lobby', 'open'
+      present = @game.players.present_now
+      @players = present.count
+      if @game.phase == 'open'
+        @round = @game.current_round
+        @answered = @round.answers.where(player_id: present.select(:id)).count
+      end
+    when 'closed'
+      @round = @game.current_round
+      @counts = @round.answers.group(:choice).count
+    end
+    render_screen(@game.id, @game.phase, @game.round_number, @players, @answered, @counts)
+  end
+
+  def advance
+    @game.advance!(params[:phase], params[:number])
+    redirect_to moderate_game_path(@game), status: :see_other
+  end
+
+  def qr
+    expires_in 1.day, public: false
+    svg = RQRCode::QRCode.new(play_url(@game.code)).as_svg(use_path: true, viewbox: true, offset: 4, module_size: 1)
+    send_data svg, type: 'image/svg+xml', disposition: 'inline'
+  end
+
+  private
+
+  def load_game
+    @game = Game.find(params[:id])
+  end
+end
diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..8e5dc82
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,60 @@
+class PlayController < ApplicationController
+  include LiveScreen
+  before_action :load_identity
+
+  def show
+    key = request.headers["X-Page-Key"].to_s
+    @page_key = key.match?(/\A[0-9a-f]{32}\z/) ? key : SecureRandom.hex(16)
+    @player&.heartbeat!(@page_key) unless @game.phase == "ended"
+    if @player && %w[open closed].include?(@game.phase)
+      @round = @game.current_round
+      @choice = @round.answers.where(player: @player).pick(:choice)
+    end
+    phase = !@player && @game.phase != 'ended' ? 'join' : @game.phase
+    render_screen(@game.id, phase, @player&.id, @round&.number, @choice, @error)
+  end
+
+  def join
+    @game.with_lock do
+      unless @game.phase == 'ended' || @player
+        @player = @game.players.find_or_initialize_by(token: @token)
+        unless @player.persisted? || @player.update(name: params[:name].to_s.strip)
+          @error = @player.errors.full_messages.to_sentence
+          @player = nil
+        end
+      end
+    end
+    return show if @error
+    redirect_to play_path(@game.code), status: :see_other
+  end
+
+  def answer
+    return head :forbidden unless @player
+    @game.with_lock do
+      if @game.phase == 'open' && @game.round_number.to_s == params[:number]
+        round = @game.current_round
+        choice = Integer(params[:choice], exception: false)
+        return head :unprocessable_entity unless choice && (0...round.options.size).cover?(choice)
+        round.answers.find_or_initialize_by(player: @player).update!(choice: choice)
+      end
+    end
+    redirect_to play_path(@game.code), status: :see_other
+  end
+
+  def leave
+    @player.player_visits.where(page_key: params[:page_key].to_s).delete_all if @player
+    head :no_content
+  end
+
+  private
+
+  def load_identity
+    @game = Game.find_by!(code: params[:code])
+    @token = cookies.signed[:quizzy_player]
+    unless @token
+      @token = SecureRandom.urlsafe_base64(24)
+      cookies.permanent.signed[:quizzy_player] = { value: @token, httponly: true, same_site: :lax, path: '/play' }
+    end
+    @player = @game.players.find_by(token: @token)
+  end
+end
