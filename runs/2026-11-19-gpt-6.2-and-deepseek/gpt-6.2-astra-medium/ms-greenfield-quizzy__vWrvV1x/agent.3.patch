diff --git a/README.md b/README.md
index 6f11bd1..b782cb4 100644
--- a/README.md
+++ b/README.md
@@ -15,3 +15,11 @@ All fonts and assets are local. The server uses plain HTTP as requested; deploy
 ## Verify
 
 Run `bin/rails test` for integration tests and `bin/rails test:system` for the Chromium moderator workflow. The browser tests use Cuprite with the locally installed Chromium.
+
+## Live games
+
+Choose **Start a game** on a quiz and project the moderator screen. Participants scan the QR code or visit the displayed URL; use a hostname or LAN address reachable from their phones. Each run has its own join code and an ordered snapshot of the active questions, so editing the quiz does not change a game in progress.
+
+Player identity is a signed browser cookie, with a separate player record in each game. A phone fetches only its current screen; Action Cable sends a refresh signal (never the answer key) on phase changes. Phones also check in periodically and switch to short polls if the socket is unavailable. The projector polls for count changes; unchanged screens return an empty response. The in-process Cable adapter needs no external service and is intended for the single Puma process started by `bin/serve`.
+
+Closing the last game tab releases presence; if the phone cannot notify the server, presence has a one-minute grace period for Wi-Fi interruptions. The open-question counter measures how many of the currently present players have answered. Closed-question totals include every recorded answer, even if the player has disconnected. Both advancing and answering check the expected round under a database lock, so a delayed tap cannot affect the next question.
diff --git a/app/assets/javascripts/live.js b/app/assets/javascripts/live.js
new file mode 100644
index 0000000..2c69277
--- /dev/null
+++ b/app/assets/javascripts/live.js
@@ -0,0 +1,82 @@
+// Serialize state reads and writes. On slow connections an old poll must not
+// overwrite a submitted answer, nor should rapid taps arrive out of order.
+let screen = document.querySelector('[data-version]');
+const notice = document.querySelector('#live-error');
+let queue = Promise.resolve();
+let timer;
+let failures = 0;
+let connected = false;
+let consumer;
+const phone = document.querySelector("[data-game-code]");
+
+function schedule() {
+  clearTimeout(timer);
+  if (screen.dataset.ended === 'true') {
+    const cable = consumer;
+    consumer = null;
+    cable?.disconnect();
+    return;
+  }
+  const base = connected && !failures ? 18000 : Math.min(15000, 1050 * 2 ** failures);
+  const delay = base + Math.random() * 400;
+  timer = setTimeout(() => enqueue(), delay);
+}
+
+function enqueue(post) {
+  clearTimeout(timer);
+  queue = queue.then(async () => {
+    const headers = { 'X-Live-Screen': '1' };
+    if (phone) headers["X-Page-Key"] = phone.dataset.pageKey;
+    if (!post) headers['X-Screen-Version'] = screen.dataset.version;
+    const response = await fetch(location.origin + (post?.url || location.pathname), {
+      headers, method: post ? 'POST' : 'GET', body: post?.body,
+      cache: 'no-store', signal: AbortSignal.timeout(10000)
+    });
+    if (!response.ok) throw new Error('Request failed');
+    if (response.status !== 204) {
+      const template = document.createElement('template');
+      template.innerHTML = await response.text();
+      const next = template.content.querySelector('[data-version]');
+      if (!next) throw new Error('Missing screen');
+      screen.replaceWith(next);
+      screen = next;
+    }
+    failures = 0;
+    notice.hidden = true;
+  }).catch(() => {
+    failures++;
+    notice.textContent = post ? 'Could not confirm that action. Check the screen and try again.' : 'Reconnecting…';
+    notice.hidden = false;
+  }).finally(schedule);
+}
+
+document.addEventListener('submit', event => {
+  if (!screen.contains(event.target)) return;
+  event.preventDefault();
+  enqueue({ url: new URL(event.target.action).pathname, body: new FormData(event.target) });
+});
+window.addEventListener('online', () => enqueue());
+document.addEventListener('visibilitychange', () => { if (!document.hidden) enqueue(); });
+schedule();
+
+// Phones only need immediate updates at phase boundaries. Cable carries no
+// quiz contents or player data; reconnection always fetches authoritative HTML.
+const gameCode = phone?.dataset.gameCode;
+if (gameCode && screen.dataset.ended !== 'true' && window.ActionCable) {
+  consumer = ActionCable.createConsumer('/cable');
+  consumer.subscriptions.create({ channel: 'GameChannel', code: gameCode }, {
+    connected() { connected = true; enqueue(); },
+    disconnected() { connected = false; schedule(); },
+    received() { setTimeout(() => enqueue(), Math.random() * 250); }
+  });
+}
+
+if (phone) {
+  window.addEventListener('pagehide', () => {
+    const data = new FormData();
+    data.set('page_key', phone.dataset.pageKey);
+    data.set('authenticity_token', document.querySelector('[name=csrf-token]')?.content || '');
+    navigator.sendBeacon(phone.dataset.leaveUrl, data);
+  });
+  window.addEventListener('pageshow', event => { if (event.persisted) enqueue(); });
+}
