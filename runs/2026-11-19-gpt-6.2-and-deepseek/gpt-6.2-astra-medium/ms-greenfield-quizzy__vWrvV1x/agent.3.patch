+<section class="screen__body" data-version="<%= @revision %>" data-ended="<%= @game.phase == 'ended' %>">
+  <% if @game.phase == 'ended' %>
+    <h1 class="lobby__title">The quiz is over</h1>
+  <% elsif @game.phase == 'lobby' %>
+    <div class="lobby"><div>
+      <h1 class="lobby__title"><%= @game.title %></h1>
+      <p class="lobby__join">Join on your phone</p>
+      <div class="lobby__url"><%= play_url(@game.code) %></div>
+      <div class="counter-pill">Players: <%= @players %></div>
+    </div><%= image_tag qr_moderate_game_path(@game), class: 'qr', alt: 'Scan to join the game' %></div>
+  <% else %>
+    <p class="stage-question__num">Question <%= @round.number %> of <%= @game.round_count %></p>
+    <h1 class="stage-question__body"><%= @round.body %></h1>
+    <ol class="stage-options <%= 'stage-options--results' if @counts %>">
+      <% lettered(@round.options).each_with_index do |(option, letter), i| %>
+        <li class="stage-option <%= 'is-correct' if @counts && option['correct'] %>">
+          <span class="stage-option__letter"><%= letter %></span><span class="stage-option__title"><%= option['text'] %></span>
+          <% if @counts %>
+            <% if option['correct'] %><span class="stage-option__mark">Correct</span><% end %>
+            <span class="stage-option__count"><%= @counts.fetch(i, 0) %></span>
+          <% end %>
+        </li>
+      <% end %>
+    </ol>
+  <% end %>
+  <footer class="screen-controls">
+    <div class="screen-controls__info"><%= link_to 'Back to quiz', moderate_quiz_path(@game.quiz_id) %>
+      <% if @game.phase == 'open' %><strong class="answers-counter">Answers: <%= @answered %> / <%= @players %></strong><% end %>
+    </div>
+    <% unless @game.phase == 'ended' %>
+      <% action = { 'lobby' => 'Start', 'open' => 'Finish', 'closed' => @game.round_number == @game.round_count ? 'End quiz' : 'Next' }.fetch(@game.phase) %>
+      <%= button_to action, advance_moderate_game_path(@game), params: { phase: @game.phase, number: @game.round_number }, class: 'btn btn--pink' %>
+    <% end %>
+  </footer>
+</section>
