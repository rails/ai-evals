diff --git a/config/cable.yml b/config/cable.yml
new file mode 100644
index 0000000..05fd891
--- /dev/null
+++ b/config/cable.yml
@@ -0,0 +1,8 @@
+# bin/serve runs one Puma process. State and answers live in SQLite; the
+# in-process pub/sub only carries hints that a phone should fetch its state.
+development:
