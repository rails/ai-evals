+let countdown;
+function startCountdown() {
+  clearTimeout(countdown);
+  const display = screen.querySelector('[data-remaining-ms]');
+  if (!display) return;
+  // Use server-computed time remaining: a projector's clock may be wrong.
+  const deadline = performance.now() + Number(display.dataset.remainingMs);
+  function tick() {
+    const ms = Math.max(0, deadline - performance.now());
+    const seconds = Math.ceil(ms / 1000);
+    display.textContent = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
+    if (ms > 0) countdown = setTimeout(tick, ms - (seconds - 1) * 1000 + 1);
+    else enqueue();
+  }
+  tick();
+}
+startCountdown();
