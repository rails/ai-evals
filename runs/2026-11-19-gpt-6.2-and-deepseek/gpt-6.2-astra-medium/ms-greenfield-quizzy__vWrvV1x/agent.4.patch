+++ b/db/migrate/20260504000000_add_game_prizes.rb
@@ -0,0 +1,30 @@
+class AddGamePrizes < ActiveRecord::Migration[8.1]
+  def change
+    add_column :quizzes, :number_of_winners, :integer, default: 3, null: false
+    add_column :games, :number_of_winners, :integer, default: 3, null: false
+    add_column :rounds, :opened_at, :datetime
+    add_column :answers, :elapsed_us, :bigint, default: 0, null: false
+    add_column :players, :points, :integer, default: 0, null: false
+    add_column :players, :place, :integer
+    add_column :games, :winner_ids, :json, default: [], null: false
+    add_index :players, [:game_id, :place]
+
+    reversible do |dir|
+      dir.up do
+        # Existing games have answer keys and final picks but no timing data.
+        # Equal historical scores therefore fall back to join order.
+        execute <<~SQL
+          WITH scores AS (
+            SELECT p.id, p.game_id, COUNT(CASE WHEN json_extract(r.options, '$[' || a.choice || '].correct') THEN 1 END) AS points
+            FROM players p JOIN games g ON g.id = p.game_id AND g.phase = 'ended'
+            LEFT JOIN answers a ON a.player_id = p.id LEFT JOIN rounds r ON r.id = a.round_id
+            GROUP BY p.id
+          ), ranked AS (
+            SELECT id, points, ROW_NUMBER() OVER (PARTITION BY game_id ORDER BY points DESC, id) AS place FROM scores
+          )
+          UPDATE players SET points = ranked.points, place = ranked.place FROM ranked WHERE ranked.id = players.id
+        SQL
+      end
+    end
+  end
+end
