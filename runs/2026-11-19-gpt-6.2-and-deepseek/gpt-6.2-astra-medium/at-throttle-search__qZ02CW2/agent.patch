diff --git a/app/models/book_search_limit.rb b/app/models/book_search_limit.rb
new file mode 100644
index 0000000..8c7d0ae
--- /dev/null
+++ b/app/models/book_search_limit.rb
@@ -0,0 +1,15 @@
+class BookSearchLimit
+  REQUESTS_PER_MINUTE = 30
+  STORE = Rails.cache.is_a?(ActiveSupport::Cache::NullStore) ? ActiveSupport::Cache::MemoryStore.new : Rails.cache
+
+  def self.allow?(address)
+    slots = Array.new(REQUESTS_PER_MINUTE) { |i| "book-search-limit:#{address}:#{i}" }
+    available = slots - STORE.read_multi(*slots).keys
+
+    # Claim one slot for a full minute, atomically across competing requests.
+    available.any? do |slot|
+      # false means already claimed; nil means Redis is unavailable (fail open).
+      STORE.write(slot, true, expires_in: 1.minute, unless_exist: true) != false
+    end
+  end
+end
