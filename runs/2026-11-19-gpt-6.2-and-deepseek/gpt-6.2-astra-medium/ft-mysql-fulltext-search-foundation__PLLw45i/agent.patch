diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..1dcd178
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,32 @@
+<% @page_title = "Search cards" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide shadow">
+  <%= form_with url: search_path, method: :get, role: "search" do |form| %>
+    <%= form.label :q, "Search titles, descriptions, and comments" %>
+    <%= form.search_field :q, value: @search.term, class: "input" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @page.records.any? %>
+    <%= with_manual_pagination :search_results, @page do %>
+      <% @page.records.each do |card| %>
+        <article>
+          <h2><%= link_to highlighted_match(card.title, @search.term), card_path(card), data: { turbo_frame: "_top" } %></h2>
+          <% if snippet = highlighted_excerpt(card.rich_text_description&.plain_text, @search.term) %>
+            <p><%= snippet %></p>
+          <% end %>
+          <% @comment_texts.fetch(card.id, []).each do |text| %>
+            <p><%= highlighted_excerpt(text, @search.term) %></p>
+          <% end %>
+        </article>
+      <% end %>
+    <% end %>
+  <% elsif @search.term.present? %>
+    <p>No matching cards.</p>
+  <% end %>
+</section>
