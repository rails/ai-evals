diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..73eefc0
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,35 @@
+class Card::Search
+  attr_reader :user, :term
+
+  def initialize(user, term)
+    @user, @term = user, term.to_s.strip
+  end
+
+  def cards
+    scope = user.accessible_cards.published
+    return scope.none if term.blank?
+
+    scope.where("instr(lower(cards.title), lower(?)) > 0", term)
+      .or(scope.where(id: matching_descriptions.select(:record_id)))
+      .or(scope.where(id: matching_comments.select(:card_id)))
+      .reverse_chronologically.with_rich_text_description
+  end
+
+  def comment_texts_for(cards)
+    matching_comments.where(card_id: cards.map(&:id)).chronologically
+      .pluck(:card_id, :plain_text).group_by(&:first).transform_values { it.map(&:last) }
+  end
+
+  private
+    def matching_descriptions
+      matching_texts.where(record_type: "Card", name: "description")
+    end
+
+    def matching_comments
+      Comment.joins(:rich_text_body).merge(matching_texts)
+    end
+
+    def matching_texts
+      ActionText::RichText.where(account_id: user.account_id).where("instr(lower(plain_text), lower(?)) > 0", term)
+    end
+end
