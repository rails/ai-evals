--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,12 @@
+module SearchesHelper
+  def highlighted_match(text, term)
+    parts = text.split(/(#{Regexp.escape(term)})/i)
+    safe_join parts.map.with_index { |part, index| index.odd? ? tag.mark(part) : part }
+  end
+
+  def highlighted_excerpt(text, term)
+    if snippet = excerpt(text, term, radius: 80)
+      highlighted_match(snippet, term)
+    end
+  end
+end
