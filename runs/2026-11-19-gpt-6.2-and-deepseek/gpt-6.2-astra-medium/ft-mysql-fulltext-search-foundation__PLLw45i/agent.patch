diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..d47f1f4
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "matches visible text in titles, descriptions and comments, newest card first" do
+    cards(:text).update_columns title: "<b>Needle</b>", created_at: 3.days.ago
+    cards(:layout).update! description: "<p>One nee<strong>dle</strong></p>", created_at: 2.days.ago
+    cards(:logo).update! created_at: 1.day.ago
+    comments(:logo_agreement_jz).update! body: "That NEEDLE"
+    comments(:logo_agreement_kevin).update! body: "Another Needle"
+
+    get search_path(q: "needle")
+    assert_response :success
+    assert_equal [ :logo, :layout, :text ].map { card_path(cards(it)) }, css_select("main article a").pluck("href")
+    assert_select "article mark", text: "NEEDLE"
+    assert_select "article p mark", text: "needle"
+    assert_select "article a mark", text: "Needle"
+    assert_select "article b", count: 0
+  end
+
+  test "rechecks publication and board access for comment matches" do
+    get search_path(q: "overflowing")
+    assert_select "article a[href=?]", card_path(cards(:layout))
+
+    cards(:layout).drafted!
+    get search_path(q: "overflowing")
+    assert_select "article", count: 0
+
+    cards(:layout).published!
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+    get search_path(q: "overflowing")
+    assert_select "article", count: 0
+  end
+
+  test "search reflects edits without matching HTML attributes or old body text" do
+    comment = comments(:logo_agreement_jz)
+    comment.update! body: '<a href="https://example.com/private-marker">visible-marker</a>'
+    get search_path(q: "private-marker")
+    assert_select "article", count: 0
+
+    get search_path(q: "visible-marker")
+    assert_select "article mark", text: "visible-marker"
+
+    comment.update! body: "Replacement"
+    get search_path(q: "visible-marker")
+    assert_select "article", count: 0
+  end
+
+  test "blank queries show no cards and special characters match literally" do
+    cards(:logo).update! description: "Only 5%_ &amp; counting"
+    get search_path(q: "%_ &")
+    assert_select "article", count: 1
+    assert_select "article mark", text: "%_ &"
+
+    get search_path(q: "  ")
+    assert_select "article", count: 0
+  end
+end
