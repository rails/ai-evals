diff --git a/app/models/concerns/storage_usage_tracking.rb b/app/models/concerns/storage_usage_tracking.rb
new file mode 100644
index 0000000..1b4b5c1
--- /dev/null
+++ b/app/models/concerns/storage_usage_tracking.rb
@@ -0,0 +1,32 @@
+module StorageUsageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    enum :storage_state, %i[ unmeasured current pending ], prefix: :storage
+    scope :awaiting_storage_refresh, -> { where(storage_state: %i[ unmeasured pending ]) }
+
+    # Existing rows and bulk inserts start unmeasured. A new, empty owner doesn't need a scan.
+    before_create { self.storage_state = :current }
+  end
+
+  class_methods do
+    def refresh_storage_usage(id)
+      transaction do
+        if owner = awaiting_storage_refresh.lock.find_by(id: id)
+          owner.apply_storage_usage
+        end
+      end
+    end
+
+    def refresh_storage_usage_later(id)
+      transaction do
+        owner = select(:id, :storage_state).lock.find_by(id: id)
+        # Wait for any in-flight refresh before deciding that its job covers this change.
+        if owner && !owner.storage_pending?
+          owner.update_column(:storage_state, :pending)
+          StorageUsageJob.perform_later(self, [ id ])
+        end
+      end
+    end
+  end
+end
diff --git a/config/initializers/storage_usage.rb b/config/initializers/storage_usage.rb
new file mode 100644
index 0000000..0cdc0bb
--- /dev/null
+++ b/config/initializers/storage_usage.rb
@@ -0,0 +1,57 @@
+module AttachmentStorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :mark_storage_dirty
+    before_destroy :mark_storage_dirty
+  end
+
+  # Active Storage purges and detaches individual attachments with delete, not destroy.
+  def delete
+    self.class.transaction do
+      mark_storage_dirty
+      super
+    end
+  end
+
+  private
+    def mark_storage_dirty
+      case [ record_type, name ]
+      when [ "Card", "image" ]
+        Card.refresh_storage_usage_later(record_id)
+      when [ "ActionText::RichText", "embeds" ]
+        record&.mark_storage_dirty
+      end
+    end
+end
+
+module RichTextStorageUsage
+  def mark_storage_dirty
+    case [ record_type, name ]
+    when [ "Board", "public_description" ]
+      Board.refresh_storage_usage_later(record_id)
+    when [ "Card", "description" ]
+      Card.refresh_storage_usage_later(record_id)
+    when [ "Comment", "body" ]
+      Card.refresh_storage_usage_later(record.card_id) if record
+    end
+  end
+end
+
+module BulkDetachStorageUsage
+  # Unlike purge, detaching a collection deletes its rows without visiting the attachments.
+  def detach
+    if record.is_a?(ActionText::RichText) && name.to_s == "embeds"
+      record.class.transaction do
+        record.mark_storage_dirty
+        super
+      end
+    else
+      super
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) { include AttachmentStorageUsage }
+ActiveSupport.on_load(:action_text_rich_text) { include RichTextStorageUsage }
+ActiveStorage::Attached::Many.prepend BulkDetachStorageUsage
