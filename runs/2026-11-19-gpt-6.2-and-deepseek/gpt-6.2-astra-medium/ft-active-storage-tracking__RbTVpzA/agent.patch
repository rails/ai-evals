diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..3bb0435
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "usage follows counted attachments, including comments on moved cards" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("12345"), filename: "file.txt")
+    embed = ActionText::Attachment.from_attachable(blob).to_html
+
+    @board.update!(public_description: embed)
+    @card.update!(description: embed)
+    @comment.update!(body: embed)
+    @card.image.attach(blob)
+    users(:david).avatar.attach(blob)
+    flush_usage
+
+    assert_equal 20, @board.bytes_used
+    assert_equal 20, @board.account.bytes_used
+    assert_equal 0, accounts(:initech).bytes_used
+
+    destination = boards(:private)
+    @card.move_to(destination)
+    flush_usage
+    assert_equal 5, @board.bytes_used
+    assert_equal 15, destination.bytes_used
+    assert_equal 20, @board.account.bytes_used
+
+    @card.image.purge_later
+    flush_usage
+    assert_equal 10, destination.bytes_used
+
+    @comment.destroy!
+    flush_usage
+    assert_equal 5, destination.bytes_used
+
+    @card.destroy!
+    flush_usage
+    assert_equal 0, destination.bytes_used
+    assert_equal 5, @board.account.bytes_used
+  end
+
+  test "refreshes coalesce, survive retries, and account for removal of rich text embeds" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("abc"), filename: "file.txt")
+    embed = ActionText::Attachment.from_attachable(blob).to_html
+
+    assert_enqueued_jobs 1, only: StorageUsageJob do
+      @comment.update!(body: embed)
+      @card.update!(description: embed)
+    end
+    assert_equal 0, @board.bytes_used
+    flush_usage
+    StorageUsageJob.perform_now(Card, [ @card.id ])
+    assert_equal 6, @board.bytes_used
+
+    @card.description.embeds.detach
+    flush_usage
+    assert_equal 3, @board.bytes_used
+
+    @comment.update!(body: "just text now")
+    flush_usage
+    assert_equal 0, @board.account.bytes_used
+  end
+
+  test "sweep recovers a missed refresh without counting other boards' attachments" do
+    @card.image.attach(io: StringIO.new("bytes"), filename: "image.txt")
+    clear_enqueued_jobs
+    StorageUsageJob.enqueue_pending
+    flush_usage
+    assert_equal 5, @board.bytes_used
+    assert_equal 0, boards(:private).bytes_used
+    assert_equal 5, @board.account.bytes_used
+  end
+
+  test "replacements and deletions before queued refreshes use the last charged subtotal" do
+    @card.image.attach(io: StringIO.new("old"), filename: "old.txt")
+    flush_usage
+    assert_equal 3, @board.bytes_used
+
+    @card.image.attach(io: StringIO.new("replacement"), filename: "new.txt")
+    destination = boards(:private)
+    @card.move_to(destination)
+    flush_usage
+    assert_equal 0, @board.bytes_used
+    assert_equal 11, destination.bytes_used
+
+    @card.image.detach
+    destination.destroy!
+    flush_usage
+    assert_equal 0, @board.account.bytes_used
+  end
+
+  test "rolled back removal does not change the subtotal" do
+    @card.image.attach(io: StringIO.new("abc"), filename: "file.txt")
+    flush_usage
+    Card.transaction do
+      @card.image.detach
+      raise ActiveRecord::Rollback
+    end
+    flush_usage
+    assert_equal 3, @board.bytes_used
+    assert_predicate @card.reload, :storage_current?
+  end
+
+  test "moving an embedded comment refreshes both cards" do
+    destination = boards(:private)
+    new_card = cards(:layout)
+    new_card.move_to(destination)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("123"), filename: "file.txt")
+    @comment.update!(body: ActionText::Attachment.from_attachable(blob).to_html)
+    flush_usage
+    assert_equal 3, @board.bytes_used
+
+    @comment.update!(card: new_card)
+    flush_usage
+    assert_equal 0, @board.bytes_used
+    assert_equal 3, destination.bytes_used
+  end
+
+  private
+    def flush_usage
+      perform_enqueued_jobs only: StorageUsageJob
+    end
+end
