diff --git a/app/models/card/storage_usage.rb b/app/models/card/storage_usage.rb
new file mode 100644
index 0000000..f3edc03
--- /dev/null
+++ b/app/models/card/storage_usage.rb
@@ -0,0 +1,44 @@
+module Card::StorageUsage
+  extend ActiveSupport::Concern
+  include StorageUsageTracking
+
+  included do
+    before_update :transfer_storage_usage, if: :will_save_change_to_board_id?
+    before_destroy :deduct_storage_usage, prepend: true
+  end
+
+  def apply_storage_usage
+    bytes = image_attachment_bytes + description_attachment_bytes + comments_attachment_bytes
+    Board.update_counters(board_id, card_bytes: bytes - attachment_bytes) unless bytes == attachment_bytes
+    update_columns(attachment_bytes: bytes, storage_state: :current)
+  end
+
+  private
+    def image_attachment_bytes
+      Card.where(id: id).joins(:image_blob).sum(:byte_size)
+    end
+
+    def description_attachment_bytes
+      Card.where(id: id).joins(rich_text_description: :embeds_blobs).sum(:byte_size)
+    end
+
+    def comments_attachment_bytes
+      comments.joins(rich_text_body: :embeds_blobs).sum(:byte_size)
+    end
+
+    def transfer_storage_usage
+      # A job may have refreshed the subtotal since this instance was loaded.
+      old_board_id, bytes = Card.lock.where(id: id).pick(:board_id, :attachment_bytes)
+      if bytes.to_i.nonzero? && board_id != old_board_id
+        # Opposite moves should acquire the two board locks in the same order.
+        { old_board_id => -bytes, board_id => bytes }.sort.each do |id, delta|
+          Board.update_counters(id, card_bytes: delta)
+        end
+      end
+    end
+
+    def deduct_storage_usage
+      owner_id, bytes = Card.lock.where(id: id).pick(:board_id, :attachment_bytes)
+      Board.update_counters(owner_id, card_bytes: -bytes) if bytes && bytes.nonzero?
+    end
+end
