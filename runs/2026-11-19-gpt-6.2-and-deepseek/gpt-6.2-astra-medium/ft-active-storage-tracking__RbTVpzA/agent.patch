new file mode 100644
index 0000000..ece7345
--- /dev/null
+++ b/app/jobs/storage_usage_job.rb
@@ -0,0 +1,17 @@
+class StorageUsageJob < ApplicationJob
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked
+
+  def self.enqueue_pending
+    [ Board, Card ].each do |model|
+      model.awaiting_storage_refresh.in_batches(of: 100) do |batch|
+        perform_later(model, batch.ids)
+      end
+    end
+  end
+
+  def perform(model, ids)
+    ids.each { |id| model.refresh_storage_usage(id) }
+  end
+end
