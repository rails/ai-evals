new file mode 100644
index 0000000..7df692d
--- /dev/null
+++ b/app/models/user/sign_in_history.rb
@@ -0,0 +1,32 @@
+module User::SignInHistory
+  extend ActiveSupport::Concern
+
+  LEGACY_DEACTIVATION_SUFFIX = /-deactivated-[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}(?=@)/i
+
+  included do
+    has_many :sign_in_events, dependent: :delete_all
+
+    before_update :claim_legacy_sign_in_events, if: :will_save_change_to_email_address?
+    before_destroy :erase_legacy_sign_in_events
+  end
+
+  private
+    def claim_legacy_sign_in_events
+      legacy_events_for(email_address_in_database).update_all(user_id: id)
+    end
+
+    def erase_legacy_sign_in_events
+      legacy_events_for(email_address).delete_all
+      return if active?
+
+      original = email_address.sub(LEGACY_DEACTIVATION_SUFFIX, "")
+      if original != email_address
+        # The old deactivation freed this address for another account to use.
+        legacy_events_for(original).where(created_at: ..updated_at).delete_all
+      end
+    end
+
+    def legacy_events_for(address)
+      SignInEvent.where(user_id: nil, email_address: address, created_at: created_at..)
+    end
+end
