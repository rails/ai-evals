diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..0f68d7d
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "sign-in events follow the account when its address changes" do
+    user = users(:kevin)
+    old_address = user.email_address
+    legacy_event = SignInEvent.create!(email_address: old_address, action: :signed_out)
+    user.sessions.start!(user_agent: "browser", ip_address: "127.0.0.1")
+    user.update!(email_address: "new@example.com")
+    replacement = User.create!(email_address: old_address, name: "Replacement", password: "secret123456")
+    replacement.sessions.start!(user_agent: "browser", ip_address: "127.0.0.1")
+
+    user.destroy!
+
+    assert_not SignInEvent.exists?(legacy_event.id)
+    assert_equal [ replacement.id ], SignInEvent.for_address(old_address).pluck(:user_id)
+  end
+
+  test "destroy erases private books including trash, revision history, files and search rows" do
+    user = users(:kevin)
+    private_book = books(:handbook)
+    private_book.update!(creator: user, everyone_access: false, published: true)
+    shared_book = books(:manual)
+    shared_book.update!(creator: user, author: user.name)
+    shared_page = shared_book.press(Page.new(body: "Still here"), title: "Shared")
+    ReadingMark.remember(shared_page, user: user)
+    user.sessions.start!(user_agent: "browser", ip_address: "127.0.0.1")
+
+    page = leaves(:welcome_page)
+    original = page.page
+    original.body.uploads.attach(io: StringIO.new("private file"), filename: "private.txt")
+    upload = original.body.uploads.first.blob
+    page.edit(leafable_params: { body: "New version" })
+    page.trashed!
+    # A formerly searchable section can have an FTS row even with a nil body.
+    section = leaves(:welcome_section)
+    section.section.update!(body: "Indexed")
+    section.reindex
+    section.section.update!(body: nil)
+    picture = leaves(:reading_picture).picture
+    shared_book.cover.attach(picture.image.blob)
+    ReadingMark.remember(page, user: users(:david))
