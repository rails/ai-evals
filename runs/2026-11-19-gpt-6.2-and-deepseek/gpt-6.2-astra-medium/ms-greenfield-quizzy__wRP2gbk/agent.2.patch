+class QuizImportsController < ApplicationController
+  def new
+  end
+
+  def create
+    @quiz_json = params[:quiz_json]
+    quiz = QuizDocument.import(@quiz_json)
+    redirect_to quiz, status: :see_other
+  rescue QuizDocument::Invalid => e
+    @error = e.message
+    render :new, status: :unprocessable_content
+  end
+end
