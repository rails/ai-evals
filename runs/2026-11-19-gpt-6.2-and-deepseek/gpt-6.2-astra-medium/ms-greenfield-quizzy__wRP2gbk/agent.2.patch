+++ b/test/system/quiz_transfer_test.rb
@@ -0,0 +1,19 @@
+require "application_system_test_case"
+
+class QuizTransferSystemTest < ApplicationSystemTestCase
+  test "moderator can correct an invalid import and copy the exported document" do
+    visit moderate_path
+    click_button "Import quiz"
+    fill_in "Quiz JSON", with: "broken"
+    click_button "Import", exact: true
+    assert_selector "[role=alert]", text: "not valid JSON"
+    assert_field "Quiz JSON", with: "broken"
+
+    data = { "title" => "Talk <2026>", "questions" => [] }
+    fill_in "Quiz JSON", with: JSON.generate(data)
+    click_button "Import", exact: true
+    assert_selector "h1", text: data["title"]
+    click_link "Export"
+    assert_equal data, JSON.parse(find("pre").text)
+  end
+end
