@@ -126,4 +128,32 @@ class LiveGameFlowTest < ActionDispatch::IntegrationTest
       assert_includes response.body, 'Answers: 1 / 1'
     end
   end
+
+  test 'round timer survives reload, rejects late picks and starts fresh each round' do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 5)
+    @game = Game.start_lobby!(@quiz)
+    @url = play_path(@game.code)
+    join_guest
+    freeze_time do
+      assert_enqueued_with(job: FinishQuestionJob, args: [@game.id, 'open-0'], at: 65.seconds.from_now) { advance }
+      get game_path(@game), headers: @auth
+      assert_select '[role=timer]', '1:05'
+      travel 60.seconds
+      get game_path(@game), headers: @auth
+      assert_select '[role=timer]', '0:05'
+      @guest.get @url
+      refute_includes @guest.response.body, 'role="timer"'
+      pick(1)
+      travel 5.seconds
+      pick(0)
+      assert_equal 1, @game.answers.sole.choice
+      assert_equal 'closed', @game.reload.phase
+      advance
+      FinishQuestionJob.perform_now(@game.id, 'open-0')
+      get game_path(@game), headers: @auth
+      assert_select '[role=timer]', '1:05'
+      advance
+      assert_equal 'closed', @game.phase
+    end
+  end
 end
