+++ b/app/controllers/games_controller.rb
@@ -0,0 +1,45 @@
+class GamesController < ApplicationController
+  include LiveScreen
+  before_action :load_game, except: :create
+
+  def create
+    game = Game.start_lobby!(Quiz.find(params[:quiz_id]))
+    redirect_to game_path(game), status: :see_other
+  end
+
+  def show
+    case @game.phase
+    when "lobby"
+      @counter = "Players: #{@game.players.present_now.count}"
+    when "open"
+      present = @game.players.present_now
+      answered = @game.answers.where(round: @game.round, player_id: present.select(:id)).count
+      @counter = "Answers: #{answered} / #{present.count}"
+    when "closed"
+      @counts = @game.answers.where(round: @game.round).group(:choice).count
+    end
+
+    version = [@game.step, @counter].join("|")
+    if request.xhr? && params[:version].to_s.start_with?("#{@game.step}|") && params[:version] != version && @counter
+      render json: { counter: @counter, version: version }
+    else
+      render_screen version
+    end
+  end
+
+  def advance
+    @game.advance!(params[:step])
+    after_input game_path(@game)
+  end
+
+  def qr
+    svg = RQRCode::QRCode.new(play_url(@game.code)).as_svg(use_path: true, viewbox: true, standalone: true, offset: 24, module_size: 6)
+    send_data svg, type: "image/svg+xml", disposition: "inline"
+  end
+
+  private
+
+  def load_game
+    @game = Game.find(params[:id])
+  end
+end
diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..3b1a659
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,61 @@
+class PlayController < ApplicationController
+  include LiveScreen
+  skip_before_action :require_moderator
+  before_action :load_game_and_player
+
+  def show
+    if @game.phase == "ended"
+      version = "ended"
+    elsif @player
+      @player.seen_in(@tab)
+      @pick = @player.answers.find_by(round: @game.round)&.choice
+      version = [@game.step, @player.id, @pick].join(":")
+    else
+      version = "join"
+    end
+    render_screen version
+  end
+
+  def join
+    @game.with_lock do
+      unless @game.phase == "ended" || @player
+        @player = @game.players.find_or_initialize_by(browser_token: @token)
+        @player.update!(name: params[:name].to_s.strip)
+      end
+      @player&.seen_in(@tab) unless @game.phase == "ended"
+    end
+    after_input play_path(@game.code)
+  rescue ActiveRecord::RecordInvalid
+    render plain: "Enter a name between 1 and 80 characters.", status: :unprocessable_entity
+  end
+
+  def answer
+    return head :forbidden unless @player
+    @game.with_lock do
+      choice = Integer(params[:choice], exception: false)
+      if @game.phase == "open" && @game.step == params[:step] && choice&.between?(0, @game.question.fetch("options").length - 1)
+        @player.answers.find_or_initialize_by(round: @game.round).update!(choice: choice)
+        @player.seen_in(@tab)
+      end
+    end
+    after_input play_path(@game.code)
+  end
+
+  def leave
+    @player&.presences&.where(tab: @tab)&.delete_all
+    head :no_content
+  end
+
+  private
+
+  def load_game_and_player
+    @game = Game.find_by!(code: params[:code])
+    @tab = params[:tab].to_s.match?(/\A[a-f0-9]{24}\z/) ? params[:tab] : SecureRandom.hex(12)
+    @token = cookies.signed[:quizzy_player]
+    unless @token
+      @token = SecureRandom.urlsafe_base64(32)
+      cookies.signed.permanent[:quizzy_player] = { value: @token, httponly: true, same_site: :lax, path: "/play" }
+    end
+    @player = @game.players.find_by(browser_token: @token)
+  end
+end
