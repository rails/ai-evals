diff --git a/README.md b/README.md
index 11f604f..10980a2 100644
--- a/README.md
+++ b/README.md
@@ -13,3 +13,11 @@ The server intentionally speaks plain HTTP. Run it on a trusted network or put t
 `bin/rails test:all` runs the integration and Chromium browser tests. Set `CHROMIUM_PATH` if Chromium isn't at `/usr/bin/chromium`.
 
 Each question owns its ordered options and correct-answer flags. Preview renders only active questions; stepping through them and counting correct picks happen in page memory, without sending answers back to Rails.
+
+## Live games
+
+Choose **Start a game** on a quiz page. Each game snapshots the current active questions in order and gets a new public `/play/:code` URL. The QR image is generated locally. A signed browser cookie identifies a separate player record in each joined game.
+
+The single-process Puma deployment uses Action Cable for phase-change notifications; no Redis or other service is required. Phones fetch only their own current screen, resync on reconnect, and fall back to polling without a socket. The moderator samples live counters separately, so one vote doesn't trigger requests from every phone. A phone has a 60-second presence grace period for brief Wi-Fi interruptions. Open-question progress counts present players; the final tally keeps all submitted answers, even if their owners have since disconnected.
+
+Moderator transitions and answer writes check the expected phase and round under a database lock. Delayed submissions cannot reopen a question or land in a later round. If deploying multiple Puma processes in the future, use a shared Action Cable adapter for cross-process notifications.
diff --git a/app/assets/javascripts/live.js b/app/assets/javascripts/live.js
new file mode 100644
index 0000000..a1eb425
--- /dev/null
+++ b/app/assets/javascripts/live.js
@@ -0,0 +1,77 @@
+// The socket carries only phase-change hints. Reading the authoritative screen
+// on (re)connect also repairs missed events without replaying old questions.
+(() => {
+  const root = document.querySelector('#live');
+  const note = document.querySelector('#connection-note');
+  const phone = root.dataset.role === 'play';
+  const headers = { 'X-Requested-With': 'XMLHttpRequest' };
+  let queue = Promise.resolve(), pendingRead = false, connected = false, cable;
+  const ended = () => root.firstElementChild.dataset.ended === 'true';
+  function report(message) {
+    note.textContent = message;
+    note.hidden = false;
+  }
+  async function read() {
+    const url = new URL(location.href);
+    if (phone) url.searchParams.set('tab', root.dataset.tab);
+    url.searchParams.set('version', root.firstElementChild.dataset.version);
+    const response = await fetch(url, { headers, signal: AbortSignal.timeout(10000) });
+    if (!response.ok) throw Error();
+    if (response.headers.get('Content-Type')?.includes('application/json')) {
+      const { counter, version } = await response.json();
+      root.querySelector('[data-counter]').textContent = counter;
+      root.firstElementChild.dataset.version = version;
+    } else if (response.status !== 204) {
+      root.innerHTML = await response.text();
+    }
+    note.hidden = true;
+    if (ended()) cable?.disconnect();
+  }
+  function refresh() {
+    if (ended() || pendingRead) return;
+    pendingRead = true;
+    queue = queue.then(() => { pendingRead = false; return read(); })
+      .catch(() => report('Connection interrupted. Reconnecting…'));
+  }
+  // Serialize taps and reads so a delayed response cannot undo a newer pick.
+  root.addEventListener('submit', event => {
+    event.preventDefault();
+    const form = event.target, body = new FormData(form, event.submitter);
+    if (phone) body.set('tab', root.dataset.tab);
+    queue = queue.then(async () => {
+      const response = await fetch(form.action, { method: 'POST', body, headers: {
+        ...headers, 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
+      }, signal: AbortSignal.timeout(10000) });
+      if (!response.ok) { report(response.status === 422 ? 'Please check your entry and try again.' : 'Not submitted. Please try again.'); return; }
+      await read();
+    }).catch(() => report('Could not confirm submission. Please try again.'));
+  });
+  if (!ended() && phone && window.ActionCable) {
+    cable = ActionCable.createConsumer('/cable');
+    cable.subscriptions.create({ channel: 'PhaseChannel', code: root.dataset.code }, {
+      received: refresh,
+      connected() { connected = true; refresh(); },
+      disconnected() { connected = false; }
+    });
+  }
+  function tick() {
+    if (ended()) return;
+    refresh();
+    // Phones heartbeat infrequently; jitter spreads reconnect traffic. Only
+    // the one presenter samples counters at a high rate, not the whole room.
+    setTimeout(tick, phone ? (connected ? 15000 : 1800) * (1 + Math.random() / 3) : 850);
+  }
+  setTimeout(tick, 800);
+  if (phone) {
+    window.addEventListener('pagehide', () => {
+      if (ended()) return;
+      const data = new FormData();
+      data.set('tab', root.dataset.tab);
+      data.set('authenticity_token', document.querySelector('meta[name="csrf-token"]')?.content || '');
+      navigator.sendBeacon(root.dataset.leave, data);
+    });
+    window.addEventListener('pageshow', event => { if (event.persisted) refresh(); });
+  }
+  window.addEventListener('online', refresh);
+  document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
+})();
