diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..132f8c5
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,32 @@
+class Game < ApplicationRecord
+  CODE_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789".chars.freeze
+
+  belongs_to :quiz
+  has_many :players
+  has_many :answers, through: :players
+  before_validation(on: :create) { self.code ||= SecureRandom.alphanumeric(8, chars: CODE_ALPHABET) }
+
+  def self.start_lobby!(quiz)
+    create!(quiz: quiz, title: quiz.title, rounds: quiz.questions.where(active: true).as_json(only: %i[body options]))
+  end
+
+  def question = rounds[round]
+  def step = "#{phase}-#{round}"
+  def last_round? = round + 1 == rounds.size
+
+  def advance!(expected_step)
+    with_lock do
+      next unless step == expected_step
+      case phase
+      when "lobby" then update!(phase: rounds.empty? ? "ended" : "open")
+      when "open" then update!(phase: "closed")
+      when "closed"
+        last_round? ? update!(phase: "ended") : update!(round: round + 1, phase: "open")
+      end
+    end
+  end
+
+  after_update_commit do
+    ActionCable.server.broadcast("phase:#{code}", { changed: true }) if saved_change_to_phase?
+  end
+end
diff --git a/app/models/player.rb b/app/models/player.rb
new file mode 100644
index 0000000..94cc352
--- /dev/null
+++ b/app/models/player.rb
@@ -0,0 +1,15 @@
+class Player < ApplicationRecord
+  belongs_to :game
+  has_many :answers
+  has_many :presences
+  validates :name, presence: true, length: { maximum: 80 }
+  scope :present_now, -> { where(id: Presence.recent.select(:player_id)) }
+
+  def seen_in(tab)
+    seat = presences.find_by(tab: tab)
+    return if seat && seat.seen_at > 12.seconds.ago
+
+    presences.where(seen_at: ...60.seconds.ago).delete_all unless seat
+    presences.upsert({ tab: tab, seen_at: Time.current }, unique_by: [:player_id, :tab])
+  end
+end
