+<section class="screen" data-version="<%= @version %>" data-ended="<%= @game.phase == 'ended' %>">
+  <header class="screen__top"><span class="logo screen__logo"><span class="logo__mark">?</span> Quizzy</span><span>Live game</span></header>
+  <div class="screen__body">
+    <% case @game.phase %>
+    <% when "lobby" %>
+      <div class="lobby"><div><h1 class="lobby__title"><%= @game.title %></h1>
+        <div class="lobby__join">Join on your phone</div><div class="lobby__url"><%= play_url(@game.code) %></div>
+        <div class="counter-pill" data-counter><%= @counter %></div>
+      </div><div class="qr"><img src="<%= qr_game_path(@game) %>" alt="Scan to join this game"></div></div>
+    <% when "ended" %>
+      <h1>The quiz is over</h1>
+    <% else %>
+      <div class="stage-question__num">Question <%= @game.round + 1 %> of <%= @game.rounds.size %></div>
+      <h1 class="stage-question__body"><%= @game.question['body'] %></h1>
+      <ul class="stage-options"><% @game.question['options'].each_with_index do |option, i| %>
+        <li class="stage-option <%= 'is-correct' if @counts && option['correct'] %>"><span class="stage-option__letter"><%= option_letter(i) %></span><span class="stage-option__title"><%= option['text'] %></span>
+        <% if @counts %><% if option['correct'] %><span class="stage-option__mark">Correct</span><% end %><strong class="stage-option__count"><%= @counts.fetch(i, 0) %></strong><% end %></li>
+      <% end %></ul>
+    <% end %>
+  </div>
+  <footer class="screen-controls"><%= link_to "← Quiz", quiz_path(@game.quiz_id) %>
+    <% if @game.phase == 'open' %><span class="answers-counter" data-counter><%= @counter %></span><% end %>
+    <% label = { 'lobby' => 'Start', 'open' => 'Finish', 'closed' => @game.last_round? ? 'End quiz' : 'Next' }[@game.phase] %>
+    <%= button_to label, advance_game_path(@game), params: { step: @game.step }, class: "btn btn--light" if label %>
+  </footer>
+</section>
