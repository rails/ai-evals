@@ -0,0 +1,7 @@
+# Public invalidation only. Private answer state is rendered over authenticated HTTP.
+class PhaseChannel < ActionCable::Channel::Base
+  def subscribed
+    game = Game.find_by(code: params[:code])
+    game ? stream_from("phase:#{game.code}") : reject
+  end
+end
diff --git a/app/controllers/concerns/live_screen.rb b/app/controllers/concerns/live_screen.rb
new file mode 100644
index 0000000..4b55571
--- /dev/null
+++ b/app/controllers/concerns/live_screen.rb
@@ -0,0 +1,23 @@
+module LiveScreen
+  extend ActiveSupport::Concern
+
+  included do
+    layout "live"
+    before_action :no_store
+  end
+
+  private
+
+  def render_screen(version)
+    @version = version
+    if request.xhr? && params[:version] == version
+      head :no_content
+    else
+      render :show, layout: (request.xhr? ? false : "live")
+    end
+  end
+
+  def after_input(url)
+    request.xhr? ? head(:no_content) : redirect_to(url, status: :see_other)
+  end
+end
