diff --git a/test/integration/live_game_flow_test.rb b/test/integration/live_game_flow_test.rb
new file mode 100644
index 0000000..4342788
--- /dev/null
+++ b/test/integration/live_game_flow_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class LiveGameFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV['QUIZZY_MODERATOR_USERNAME'] = 'tester'
+    ENV['QUIZZY_MODERATOR_PASSWORD'] = 'test-password'
+    @auth = { 'Authorization' => ActionController::HttpAuthentication::Basic.encode_credentials('tester', 'test-password') }
+    @quiz = Quiz.create!(title: 'Conference quiz')
+    [true, false, true].each_with_index do |active, i|
+      @quiz.questions.create!(active: active, body: "Topic #{i}", options: [{ text: 'One', correct: false }, { text: 'Two', correct: true }])
+    end
+    @game = Game.start_lobby!(@quiz)
+    @url = play_path(@game.code)
+    @guest = open_session
+  end
+
+  def advance
+    post advance_game_path(@game), params: { step: @game.reload.step }, headers: @auth
+    @game.reload
+  end
+
+  def join_guest
+    @guest.get @url
+    @guest.post join_play_path(@game.code), params: { name: 'Guest' }
+  end
+
+  def pick(i, step = @game.step)
+    @guest.post answer_play_path(@game.code), params: { step: step, choice: i }
+  end
+
+  test 'late join, snapshot, private answer key, stale writes, replay and terminal state' do
+    @quiz.questions.delete_all
+    get game_path(@game)
+    assert_response :unauthorized
+    post advance_game_path(@game), params: { step: @game.step }
+    assert_response :unauthorized
+    advance
+    join_guest
+    @guest.get @url
+    assert_includes @guest.response.body, 'Topic 0'
+    refute_match(/correct|Topic 2|Topic 1/i, @guest.response.body)
+    pick(-1)
+    assert_empty @game.answers
+    pick(1)
+    pick(0)
+    assert_equal [0], @game.answers.pluck(:choice)
+    advance
+    pick(1, 'open-0')
+    @guest.get @url
+    assert_includes @guest.response.body, 'Wrong!'
+    get game_path(@game), headers: @auth
+    assert_select 'li.stage-option:not(.is-correct) .stage-option__count', '1'
+    assert_select 'li.stage-option.is-correct .stage-option__count', '0'
+    advance
+    pick(1, 'open-0')
+    assert_empty @game.answers.where(round: 1)
+    @guest.get @url
+    assert_includes @guest.response.body, 'Topic 2'
+    advance
+    @guest.get @url
+    assert_includes @guest.response.body, 'No answer'
+    advance
+    open_session do |new_phone|
+      new_phone.get @url
+      assert_includes new_phone.response.body, 'The quiz is over'
+      refute_includes new_phone.response.body, 'Your name'
+      assert_no_difference('Player.count') { new_phone.post join_play_path(@game.code), params: { name: 'Late' } }
+    end
+    replay = Game.start_lobby!(@quiz)
+    assert_empty replay.players
+    @guest.get play_path(replay.code)
+    assert_includes @guest.response.body, 'Your name'
+  end
+
+  test 'players count once across tabs, and answers belong to individual players' do
+    tab, other_tab = Array.new(2) { SecureRandom.hex(12) }
+    @guest.get @url
+    @guest.post join_play_path(@game.code), params: { name: 'First', tab: tab }
+    @guest.get @url, params: { tab: other_tab }
+    @guest.post leave_play_path(@game.code), params: { tab: tab }
+
+    second = open_session
+    second.get @url
+    second.post join_play_path(@game.code), params: { name: 'Second' }
+    get game_path(@game), headers: @auth
+    assert_select '[data-counter]', 'Players: 2'
+    advance
+    pick(0)
+    get game_path(@game), headers: @auth
+    assert_select '[data-counter]', 'Answers: 1 / 2'
+    second.post answer_play_path(@game.code), params: { step: @game.step, choice: 1 }
+    get game_path(@game), headers: @auth
+    assert_select '[data-counter]', 'Answers: 2 / 2'
+    advance
+    assert_equal({ 0 => 1, 1 => 1 }, @game.answers.group(:choice).count)
+  end
+
+  test 'presence expires without losing identity or picks' do
+    join_guest
+    advance
+    pick(1)
+    travel 61.seconds do
+      get game_path(@game), headers: @auth
+      assert_includes response.body, 'Answers: 0 / 0'
+      @guest.get @url
+      assert_includes @guest.response.body, 'Your answer'
+      get game_path(@game), headers: @auth
+      assert_includes response.body, 'Answers: 1 / 1'
+    end
+  end
+end
diff --git a/test/system/live_game_test.rb b/test/system/live_game_test.rb
new file mode 100644
index 0000000..6bd975e
--- /dev/null
+++ b/test/system/live_game_test.rb
@@ -0,0 +1,38 @@
+require "application_system_test_case"
+
+class LiveGameTest < ApplicationSystemTestCase
+  test "moderator and phone follow one another through a round" do
+    quiz = Quiz.create!(title: "In orbit")
+    quiz.questions.create!(body: "Which planet?", options: [{ text: "Mars", correct: true }, { text: "Venus", correct: false }])
+    visit quiz_path(quiz)
+    click_button "Start a game"
+    join_url = find('.lobby__url').text
+    using_session(:phone) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+    assert_text "Players: 1"
+    using_session(:phone) { visit '/up' }
+    assert_text 'Players: 0'
+    using_session(:phone) do
+      visit join_url
+      assert_text 'Hi, Alice!'
+    end
+    assert_text 'Players: 1'
+    click_button "Start"
+    using_session(:phone) do
+      click_button "Venus"
+      assert_text "Your answer"
+      click_button "Mars"
+      assert_selector 'button[aria-label="Mars"]', text: 'Your answer'
+    end
+    assert_text "Answers: 1 / 1"
+    click_button "Finish"
+    assert_text "Correct"
+    using_session(:phone) { assert_text "Correct!" }
+    click_button "End quiz"
+    using_session(:phone) { assert_text "The quiz is over" }
+  end
+end
