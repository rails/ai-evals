diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..d23cb33 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,56 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate_if_due)
+    end
+  end
+
+  def incinerate_if_due
+    transaction do
+      # Reactivation also locks the account. Recheck after acquiring the lock,
+      # since the cancellation may have changed since the batch was selected.
+      if Account.due_for_incineration.lock.exists?(id)
+        incinerate
+      end
+    end
+  end
+
+  private
+    def incinerate
+      delete_filter_joins
+      ::Storage::Total.where(owner: boards).delete_all
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy!) # Includes the SQLite FTS index
+
+      # Delete by tenant rather than walking the object graph. This includes orphaned
+      # records and avoids enqueuing broadcasts and storage updates for a deleted account.
+      [ ActiveStorage::Attachment, ActiveStorage::VariantRecord, ActionText::RichText,
+        ::Storage::Entry, Webhook::Delivery, Webhook::DelinquencyTracker, Webhook,
+        Notification, Notification::Bundle, Push::Subscription, Search::Query,
+        Event, Mention, Reaction, Watch, Pin, Card::ActivitySpike, Card::Goldness,
+        Card::NotNow, Closure, Step, Assignment, Tagging, Comment, Card, Column,
+        Board::Publication, Access, Filter, Tag, Entropy, Board, User::Settings,
+        ::Export, Account::Import, Account::JoinCode, User ].each do |model|
+        model.where(account_id: id).delete_all
+      end
+
+      ActiveStorage::Blob.unattached.where(account_id: id).find_each(&:purge_later)
+      destroy!
+    end
+
+    def delete_filter_joins
+      filter_ids = Filter.where(account_id: id).select(:id)
+      %w[ assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags ].each do |table|
+        self.class.with_connection do |connection|
+          connection.delete("DELETE FROM #{table} WHERE filter_id IN (#{filter_ids.to_sql})")
+        end
+      end
+    end
 end
