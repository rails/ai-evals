new file mode 100644
index 0000000..b9ca1aa
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,47 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+
+  def index
+  end
+
+  def new
+    @reaction = @comment.reactions.build
+  end
+
+  def create
+    @reaction = @comment.reactions.build(params.expect(reaction: [ :content ]))
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { head :created }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { render :new, formats: :html, status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction = @comment.reactions.find(params[:id])
+
+    if @reaction.reacter == Current.user
+      @reaction.destroy!
+      respond_to do |format|
+        format.turbo_stream { render turbo_stream: turbo_stream.remove(@reaction) }
+        format.json { head :no_content }
+      end
+    else
+      head :forbidden
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..cd6272f
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,26 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "label" ]
+  static values = { reacter: String }
+
+  connect() {
+    if (this.owned) {
+      this.element.classList.add("reaction--deleteable")
+      this.labelTarget.role = "button"
+      this.labelTarget.tabIndex = 0
+      this.labelTarget.setAttribute("aria-expanded", this.element.classList.contains("expanded"))
+    }
+  }
+
+  toggle(event) {
+    if (this.owned && !event.target.closest("a")) {
+      event.preventDefault()
+      this.labelTarget.setAttribute("aria-expanded", this.element.classList.toggle("expanded"))
+    }
+  }
+
+  get owned() {
+    return this.reacterValue === window.Current.user?.id
+  }
+}
