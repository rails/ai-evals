diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..69ba575
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  test "search treats punctuation as part of the title" do
+    sign_in :kevin
+    leaves(:summary_page).update!(title: "Save 50% off")
+    leaves(:reading_picture).update!(title: "Reader's pick_1")
+
+    { "Save 50% off" => :summary_page, "%" => :summary_page, "_" => :reading_picture, "Reader's" => :reading_picture }.each do |term, fixture|
+      get library_search_path, params: { q: term }
+      assert_response :success
+      assert_select ".search__result", count: 1
+      assert_select ".search__result[href=?]", leafable_slug_path(leaves(fixture))
+    end
+  end
+
+  test "results reflect book access and publication" do
+    leaves(:welcome_page).update!(book: books(:manual))
+    sign_in :kevin
+    get library_search_path, params: { q: "welcome" }
+    assert_select ".search__result", count: 1
+    assert_select ".search__result[href=?]", leafable_slug_path(leaves(:welcome_section))
+
+    books(:manual).update!(published: true)
+    sign_out
+    get library_search_path, params: { q: "welcome" }
+    assert_select ".search__result", count: 1
+    assert_select ".search__result[href=?]", leafable_slug_path(leaves(:welcome_page))
+  end
+end
