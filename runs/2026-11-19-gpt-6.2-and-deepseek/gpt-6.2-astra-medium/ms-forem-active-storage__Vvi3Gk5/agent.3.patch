diff --git a/spec/migrations/verify_profile_picture_cutover_spec.rb b/spec/migrations/verify_profile_picture_cutover_spec.rb
new file mode 100644
index 0000000..2181d5c
--- /dev/null
+++ b/spec/migrations/verify_profile_picture_cutover_spec.rb
@@ -0,0 +1,23 @@
+require "rails_helper"
+require Rails.root.join("db/migrate/20260917120000_verify_profile_picture_cutover")
+
+RSpec.describe VerifyProfilePictureCutover do
+  %i[user organization].each do |factory|
+    it "blocks the release until a legacy #{factory} picture has an attachment" do
+      owner = create(factory)
+      owner.profile_picture.purge
+      owner.update_column(:profile_image, "https://example.org/original.png")
+      expect { described_class.new.up }.to raise_error(RuntimeError, /profile_images:copy/)
+
+      owner.update!(profile_image: fixture_file_upload("800x600.png", "image/png"))
+      expect { described_class.new.up }.not_to raise_error
+      expect(owner.reload[:profile_image]).to eq("https://example.org/original.png")
+    end
+  end
+
+  it "allows users who never had a profile picture" do
+    create(:user, profile_image: nil)
+    create(:user, profile_image: nil).update_column(:profile_image, " ")
+    expect { described_class.new.up }.not_to raise_error
+  end
+end
