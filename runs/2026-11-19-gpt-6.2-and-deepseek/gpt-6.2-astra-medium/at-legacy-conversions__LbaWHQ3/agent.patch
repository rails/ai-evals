@@ -0,0 +1,10 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest displays the short date" do
+    books(:handbook).update!(published: true, updated_at: Time.utc(2025, 3, 4))
+
+    digest = ReportDigestMailer.weekly(users(:kevin))
+    assert_includes digest.body.decoded, "* Handbook, last edited 04 Mar"
+  end
+end
