diff --git a/test/integration/book_absence_test.rb b/test/integration/book_absence_test.rb
index b9c20ac..daff094 100644
--- a/test/integration/book_absence_test.rb
+++ b/test/integration/book_absence_test.rb
@@ -8,4 +8,17 @@ class BookAbsenceTest < ActionDispatch::IntegrationTest
       end
     end
   end
+
+  test "raising exceptions is scoped to the block even after a previous request" do
+    path = book_slug_path(books(:manual))
+    get path
+    assert_response :not_found
+
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions { get path }
+    end
+
+    get path
+    assert_response :not_found
+  end
 end
diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..54d461e 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -13,11 +13,13 @@ module ActiveSupport
     include SessionTestHelper
 
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      # Requests use the cached Rack env defaults, not the boot-time config.
+      env = Rails.application.env_config
+      previous = env["action_dispatch.show_exceptions"]
+      env["action_dispatch.show_exceptions"] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env["action_dispatch.show_exceptions"] = previous
     end
   end
 end
