diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..a9b68bf
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,46 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  def self.for_checkout(account)
+    return account.subscription if account.subscription
+
+    customer = Stripe::Customer.create({ email: account.owner_email, metadata: { account_id: account.id } },
+      { idempotency_key: "account-customer-#{account.id}" })
+    find_or_create_by!(account_id: account.id, stripe_customer_id: customer.id)
+  end
+
+  def checkout_url(plan, return_url:)
+    Stripe::Checkout::Session.create(mode: "subscription", customer: stripe_customer_id,
+      line_items: [ { price: ENV.fetch(plan.price_setting), quantity: 1 } ],
+      success_url: return_url, cancel_url: return_url).url
+  end
+
+  def portal_url(return_url:)
+    Stripe::BillingPortal::Session.create(customer: stripe_customer_id, return_url: return_url).url
+  end
+
+  def ongoing?
+    stripe_subscription_id.present? && !status.in?(%w[ canceled incomplete_expired ])
+  end
+
+  def paid_plan
+    if status.in?(%w[ active trialing ])
+      ::Subscription::PAID.find { |plan| plan.short_name == plan_key }
+    end
+  end
+
+  def apply_event(event)
+    object = event.data.object
+    with_lock do
+      return if last_event_at && event.created < last_event_at
+      # A canceled Stripe subscription cannot be resumed; a new checkout has a new ID.
+      return if status == "canceled" && object.id == stripe_subscription_id
+      return if event.type == "customer.subscription.deleted" && stripe_subscription_id && object.id != stripe_subscription_id
+
+      price = object.items.data.first&.price&.id
+      plan = ::Subscription::PAID.find { |candidate| price.present? && ENV[candidate.price_setting] == price }
+      update!(stripe_subscription_id: object.id, plan_key: plan&.short_name,
+        status: event.type == "customer.subscription.deleted" ? "canceled" : object.status, last_event_at: event.created)
+    end
+  end
+end
