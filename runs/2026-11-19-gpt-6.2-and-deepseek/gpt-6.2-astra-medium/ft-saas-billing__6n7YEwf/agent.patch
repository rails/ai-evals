@@ -0,0 +1,17 @@
+module Card::CardLimited
+  extend ActiveSupport::Concern
+
+  private
+    def within_card_limit
+      return yield unless Current.account.billing_plan.card_limit
+
+      # Serialize the check with publication so two requests cannot both take the last card.
+      Current.account.with_lock do
+        if Current.account.cards_remaining == 0
+          head :forbidden
+        else
+          yield
+        end
+      end
+    end
+end
