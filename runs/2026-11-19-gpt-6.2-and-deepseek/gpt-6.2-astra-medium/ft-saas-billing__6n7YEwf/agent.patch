index 0000000..925edc4
--- /dev/null
+++ b/saas/test/controllers/account/billing_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Account::BillingTest < ActionDispatch::IntegrationTest
+  test "admin can choose a hosted checkout from settings" do
+    sign_in_as :jason
+    get account_settings_path
+    assert_select "a[href=?]", saas.account_billing_path, text: "Upgrade"
+    get saas.account_billing_path
+    assert_response :success
+    assert_match "Unlimited+ — $25/month", response.body
+    assert_select "form[action=?]", saas.account_checkout_path
+
+    return_url = account_settings_url
+    Stripe::Customer.expects(:create).returns(stub(id: "cus_test"))
+    ENV.expects(:fetch).with("STRIPE_MONTHLY_V1_PRICE_ID").returns("price_20")
+    Stripe::Checkout::Session.expects(:create).with(mode: "subscription", customer: "cus_test",
+      line_items: [ { price: "price_20", quantity: 1 } ], success_url: return_url, cancel_url: return_url).returns(stub(url: "https://checkout.stripe.com/example"))
+    post saas.account_checkout_path, params: { plan: "MonthlyV1" }
+    assert_redirected_to "https://checkout.stripe.com/example"
+    assert_equal "FreeV1", accounts(:"37s").reload.plan
+  end
+
+  test "portal uses the account's own customer" do
+    sign_in_as :jason
+    accounts(:"37s").create_subscription!(stripe_customer_id: "cus_test")
+    Stripe::BillingPortal::Session.expects(:create).with(customer: "cus_test", return_url: account_settings_url).returns(stub(url: "https://billing.stripe.com/example"))
+    post saas.account_billing_portal_path, params: { customer: "cus_other" }
+    assert_redirected_to "https://billing.stripe.com/example"
+  end
+
+  test "members cannot initiate checkout or portal sessions" do
+    sign_in_as :jz
+    post saas.account_checkout_path, params: { plan: "MonthlyV1" }
+    assert_response :forbidden
+    post saas.account_billing_portal_path
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
