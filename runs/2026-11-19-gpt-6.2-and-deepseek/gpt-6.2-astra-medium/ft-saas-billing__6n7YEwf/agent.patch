+class Account::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = ::Subscription::PAID.find { |candidate| candidate.short_name == params[:plan] }
+    return head :bad_request unless plan
+
+    subscription = Account::Subscription.for_checkout(Current.account)
+    url = if subscription.ongoing?
+      subscription.portal_url(return_url: account_settings_url)
+    else
+      subscription.checkout_url(plan, return_url: account_settings_url)
+    end
+    redirect_to url, allow_other_host: true, status: :see_other
+  end
+end
