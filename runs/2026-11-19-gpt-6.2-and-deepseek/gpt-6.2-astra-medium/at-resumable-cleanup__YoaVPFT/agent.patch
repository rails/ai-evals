--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  test "a restarted cleanup preserves inner quotes and finishes the remaining leaves" do
+    first, second = Leaf.order(:id).first(2)
+    first.update!(title: %q(""Hello" again"))
+    second.update!(title: %q(""Goodbye""))
+
+    job = TitleCleanupJob.new
+    job.define_singleton_method(:cleaned) do |title|
+      raise Interrupt if title == second.title
+      super(title)
+    end
+
+    assert_raises(Interrupt) { job.perform_now }
+    assert_equal %q("Hello" again), first.reload.title
+    assert_equal %q(""Goodbye""), second.reload.title
+
+    TitleCleanupJob.perform_now
+    assert_equal %q("Hello" again), first.reload.title
+    assert_equal %q("Goodbye"), second.reload.title
+  end
+end
