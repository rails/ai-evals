diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..d3fb287
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,34 @@
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - &host fizzy.example.com
+
+proxy:
+  host: *host
+  ssl: true
+  app_port: 80 # Thruster in the production Dockerfile
+
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Use arm64 for an ARM server
+
+env:
+  clear:
+    APP_FQDN: *host
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    MAILER_FROM_ADDRESS: Fizzy <notifications@example.com>
+    DATABASE_ADAPTER: sqlite
+    SOLID_QUEUE_IN_PUMA: "true"
+    JOB_CONCURRENCY: "1"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+volumes:
+  - fizzy_storage:/rails/storage
