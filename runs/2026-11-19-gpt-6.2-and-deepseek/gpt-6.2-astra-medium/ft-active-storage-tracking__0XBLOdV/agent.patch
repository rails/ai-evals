@@ -0,0 +1,17 @@
+module StorageUsage::Source
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy -> { StorageUsage.where(source: self).delete_all }
+  end
+
+  # A rich-text edit can insert/delete many attachment rows in one transaction.
+  # One post-commit recount of their common source is sufficient.
+  def refresh_storage_usage_later
+    transaction_id = self.class.current_transaction.uuid
+    unless transaction_id && @storage_usage_refresh_transaction == transaction_id
+      StorageUsage::RefreshJob.perform_later(self)
+      @storage_usage_refresh_transaction = transaction_id
+    end
+  end
+end
