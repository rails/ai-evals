@@ -0,0 +1,18 @@
+# Bulk imports bypass model callbacks. Also used to backfill existing accounts.
+class StorageUsage::RebuildJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account)
+    { boards: account.boards, cards: account.cards }.each do |name, sources|
+      step name do |step|
+        sources.find_each(start: step.cursor) do |source|
+          StorageUsage.refresh(source)
+          step.set! source.id
+        end
+      end
+    end
+  end
+end
