+# Detaching an embeds collection uses delete_all, bypassing attachment callbacks.
+module ActiveStorageDetachEmbeds
+  def detach
+    super.tap do
+      if name == "embeds" && record.is_a?(ActionText::RichText)
+        record.storage_usage_source&.refresh_storage_usage_later
+      end
+    end
+  end
+end
