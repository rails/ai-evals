diff --git a/app/models/concerns/storage_usage_tracking.rb b/app/models/concerns/storage_usage_tracking.rb
new file mode 100644
index 0000000..97be4dd
--- /dev/null
+++ b/app/models/concerns/storage_usage_tracking.rb
@@ -0,0 +1,29 @@
+module StorageUsageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :refresh_storage_usage_later
+    before_destroy :refresh_storage_usage_later
+  end
+
+  # Active Storage's detach and purge paths delete the row without running
+  # destroy callbacks. Resolve its owner before the association disappears.
+  def delete
+    source = storage_usage_source
+    super.tap { source&.refresh_storage_usage_later }
+  end
+
+  private
+    def refresh_storage_usage_later
+      storage_usage_source&.refresh_storage_usage_later
+    end
+
+    def storage_usage_source
+      case [ record_type, name ]
+      when [ "Card", "image" ]
+        record
+      when [ "ActionText::RichText", "embeds" ]
+        record&.storage_usage_source
+      end
+    end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..c0e2c96
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,51 @@
+# One sparse subtotal per card (image, description and comments), plus one for
+# the board's own description. Writers on different cards never share a counter.
+class StorageUsage < ApplicationRecord
+  belongs_to :source, polymorphic: true
+  belongs_to :board
+  belongs_to :account
+
+  class << self
+    def refresh(source)
+      transaction do
+        # Serialize recounts with one another and with moves/deletion of this
+        # source. It may already be gone by the time a job gets the lock.
+        if current = source.class.lock.find_by(id: source.id)
+          store_subtotal(current, bytes_attached_to(current))
+        end
+      end
+    end
+
+    private
+      def store_subtotal(source, bytes)
+        usage = where(source: source)
+        if bytes.zero?
+          usage.delete_all
+        else
+          board = source.is_a?(Card) ? source.board : source
+          usage.first_or_initialize.update!(account: board.account, board: board, bytes_used: bytes)
+        end
+      end
+
+      def bytes_attached_to(source)
+        case source
+        when Board
+          embedded_bytes("Board", source.id, "public_description")
+        when Card
+          attached_bytes("Card", source.id, "image") +
+            embedded_bytes("Card", source.id, "description") +
+            embedded_bytes("Comment", source.comments.select(:id), "body")
+        end
+      end
+
+      def embedded_bytes(type, ids, name)
+        rich_texts = ActionText::RichText.where(record_type: type, record_id: ids, name: name)
+        attached_bytes("ActionText::RichText", rich_texts.select(:id), "embeds")
+      end
+
+      def attached_bytes(type, ids, name)
+        ActiveStorage::Attachment.where(record_type: type, record_id: ids, name: name)
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+  end
+end
