diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..8b3c284
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,22 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_current_locale
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def with_current_locale(&)
+      identity = find_session_by_cookie&.identity
+      requested = params[:locale]
+
+      if I18n.available_locales.map(&:to_s).include?(requested)
+        session[:locale] = requested
+        identity.update!(locale: requested) if identity && identity.locale != requested
+      end
+
+      I18n.with_locale(session[:locale] || identity&.locale || I18n.default_locale, &)
+    end
+end
