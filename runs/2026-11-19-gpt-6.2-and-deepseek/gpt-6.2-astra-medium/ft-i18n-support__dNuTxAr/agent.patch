diff --git a/app/javascript/helpers/translation_helpers.js b/app/javascript/helpers/translation_helpers.js
new file mode 100644
index 0000000..5f47dec
--- /dev/null
+++ b/app/javascript/helpers/translation_helpers.js
@@ -0,0 +1,13 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+// The locale meta tag is tracked by Turbo, so switching languages reloads the document.
+const messages = JSON.parse(getMetaContent("client-translations") || "{}")
+
+export function translate(key, values = {}) {
+  return messages[key].replace(/%\{(\w+)\}/g, (_, name) => values[name])
+}
+
+export function locale() {
+  const lang = document.documentElement.lang
+  return lang === "en" ? "en-US" : lang
+}
