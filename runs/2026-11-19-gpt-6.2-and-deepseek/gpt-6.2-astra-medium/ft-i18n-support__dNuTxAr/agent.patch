@@ -119,6 +119,25 @@ class Notification::BundleMailerTest < ActionMailer::TestCase
     assert_emails 1
   end
 
+  test "renders a delayed digest in the recipient's language, including dates in both parts" do
+    @user.identity.update!(locale: "ja")
+    create_notification(@user)
+
+    perform_enqueued_jobs do
+      I18n.with_locale(:en) { Notification::BundleMailer.notification(@bundle).deliver_later }
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_includes email.subject, "新しい通知"
+    date = I18n.l(@bundle.starts_at, format: :digest, locale: :ja)
+    [ email.text_part, email.html_part ].each do |part|
+      assert_includes part.body.decoded, date
+      assert_includes part.body.decoded, "1件の新しい通知"
+      assert_not_includes part.body.decoded, "Notifications since"
+    end
+    assert_equal :en, I18n.locale
+  end
+
   private
     def create_notification(user, source: events(:logo_published))
       Notification.create!(user: user, creator: user, source: source, created_at: 30.minutes.ago)
