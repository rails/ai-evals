--- /dev/null
+++ b/test/system/localized_dates_test.rb
@@ -0,0 +1,17 @@
+require "application_system_test_case"
+
+class LocalizedDatesTest < ApplicationSystemTestCase
+  test "the browser formats relative times in the selected language" do
+    sign_in_as users(:kevin)
+    card = cards(:logo)
+    card.update_column(:created_at, 5.days.ago)
+
+    visit card_url(card, locale: :ja)
+    assert_selector 'html[lang="ja"]'
+    assert_selector "time[data-local-time-target='daysago']", text: "5日前", visible: :all
+
+    visit card_url(card, locale: :en)
+    assert_selector 'html[lang="en"]'
+    assert_selector "time[data-local-time-target='daysago']", text: "5 days ago", visible: :all
+  end
+end
