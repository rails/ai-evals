diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..3c25fc4
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "anonymous locale choice survives navigation and unsupported locales" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_select "h1", "Get into Fizzy"
+
+      get new_session_path(locale: "ja")
+      assert_select 'html[lang="ja"]'
+      assert_select "h1", "Fizzyにログイン"
+      assert_select 'a[href="#main"]', "メインコンテンツに移動"
+      assert_select 'input[placeholder="メールアドレスを入力…"]'
+
+      get new_session_path(locale: "xx")
+      assert_select "h1", "Fizzyにログイン"
+      get new_session_path(locale: "en")
+      assert_select 'html[lang="en"]', text: /Get into Fizzy/
+    end
+  end
+
+  test "anonymous preference is saved only after signing in" do
+    untenanted { get new_session_path(locale: "ja") }
+    assert_nil identities(:kevin).locale
+    sign_in_as :kevin
+    assert_equal "ja", identities(:kevin).reload.locale
+    sign_out
+    sign_in_as :david
+    get new_board_path
+    assert_select 'html[lang="en"]'
+    assert_nil identities(:david).reload.locale
+  end
+
+  test "signed in preference survives a fresh session" do
+    sign_in_as :kevin
+    get board_path(boards(:writebook), locale: "ja")
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    account_scope = integration_session.default_url_options[:script_name]
+    reset!
+    integration_session.default_url_options[:script_name] = account_scope
+    sign_in_as :kevin
+    get new_board_path
+    assert_select 'html[lang="ja"]'
+    assert_select "input[placeholder='名前を入力…']"
+
+    get new_board_path(locale: "unknown")
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_select 'html[lang="ja"]'
+  end
+
+  test "cached collections and conditional responses respect the selected language" do
+    sign_in_as :kevin
+    with_actionview_partial_caching do
+      get tray_notifications_path
+      assert_select 'button[title="Mark as read"]'
+      etag = response.headers.fetch("ETag")
+
+      get tray_notifications_path(locale: "ja"), headers: { "If-None-Match" => etag }
+      assert_response :success
+      assert_select 'button[title="既読にする"]'
+      assert_select 'button[title="Mark as read"]', count: 0
+    end
+  end
+
+  test "the installed app shortcuts use the session language too" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      get pwa_manifest_path(format: :json)
+      assert_response :success
+      assert_equal "通知", response.parsed_body.fetch("shortcuts").first.fetch("name")
+    end
+  end
+end
