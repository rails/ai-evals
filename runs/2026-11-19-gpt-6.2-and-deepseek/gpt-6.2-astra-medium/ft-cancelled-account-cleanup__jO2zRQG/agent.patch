diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..a93b593
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates cancelled accounts and their data but preserves global identities" do
+    account = accounts(:"37s")
+    cards(:logo).reindex
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    ActiveStorage::Blob.create_and_upload!(io: StringIO.new("unused"), filename: "unused.txt")
+    account.create_cancellation!(initiated_by: users(:jason), created_at: 31.days.ago)
+
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) { Account::IncinerateDueJob.perform_now }
+
+    assert_not Account.exists?(account.id)
+    [ Account::Cancellation, User, Board, Card, Comment, Event, Filter, Storage::Entry, ActionText::RichText,
+      Search::Record.for(account.id), ActiveStorage::Attachment, ActiveStorage::Blob ].each do |model|
+      assert_not model.exists?(account_id: account.id), "Expected #{model} records to be incinerated"
+    end
+    assert Identity.exists?(identities(:jason).id)
+    assert Account.exists?(accounts(:initech).id)
+    assert User.exists?(users(:mike).id)
+  end
+
+  test "retains the account until more than 30 days after cancellation" do
+    account = accounts(:initech)
+    freeze_time do
+      account.create_cancellation!(initiated_by: users(:mike), created_at: 30.days.ago)
+      Account::IncinerateDueJob.perform_now
+      assert account.reload.cancelled?
+
+      travel 1.second
+      Account::IncinerateDueJob.perform_now
+      assert_not Account.exists?(account.id)
+    end
+  end
+
+  test "skips accounts reactivated after selection for incineration" do
+    account = accounts(:initech)
+    account.create_cancellation!(initiated_by: users(:mike), created_at: 31.days.ago)
+    candidate = Account.due_for_incineration.find(account.id)
+    account.reactivate
+
+    candidate.incinerate_if_due
+
+    assert account.reload.active?
+  end
+end
