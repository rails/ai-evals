diff --git a/docs/api/sections/account.md b/docs/api/sections/account.md
index 7984aee..21d8c27 100644
--- a/docs/api/sections/account.md
+++ b/docs/api/sections/account.md
@@ -111,3 +111,18 @@ __Request:__
 __Response:__
 
 Returns the board object.
+
+## `GET /:account_slug/activities.json`
+
+Returns a paginated array of activity from boards the current user can access, newest first. Filter by one or more `creator_ids[]` or `board_ids[]`; supplying both filters returns events matching both. Follow the `Link` header for the next page.
+
+Events match the HTML timeline except that title changes are included and deprecated `card_collection_changed` events are omitted. Each entry includes `id`, `action`, `created_at`, a plain-text `description`, and the `eventable_type` (`Card` or `Comment`). The `eventable`, `board`, and `creator` objects use the standard card or comment, board, and user representations. The `url` opens the card, anchored to the comment for comment activity.
+
+| Action | Fields in `particulars` |
+|--------|-------------------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Missing board, title, or column values are empty strings. For other actions, `particulars` is `{}`.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..f65fe17
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "lists accessible activity newest first with card and comment representations" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = response.parsed_body
+    assert_equal activity.pluck("created_at").sort.reverse, activity.pluck("created_at")
+
+    published = events(:logo_published)
+    entry = activity.find { |item| item["id"] == published.id }
+    assert_equal "card_published", entry["action"]
+    assert_equal "Card", entry["eventable_type"]
+    assert_equal published.eventable.title, entry.dig("eventable", "title")
+    assert_equal published.board.name, entry.dig("board", "name")
+    assert_equal published.creator.name, entry.dig("creator", "name")
+    assert_equal published.description_for(users(:david)).to_plain_text, entry["description"]
+    assert_equal card_url(published.card), entry["url"]
+    assert_equal({}, entry["particulars"])
+
+    comment = events(:layout_commented).eventable
+    entry = activity.find { |item| item["action"] == "comment_created" }
+    assert_equal "Comment", entry["eventable_type"]
+    assert_equal comment.body.to_plain_text, entry.dig("eventable", "body", "plain_text")
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), entry["url"]
+  end
+
+  test "includes action-specific particulars but not deprecated or non-timeline events" do
+    events(:layout_published).update!(action: "card_title_changed", particulars: { particulars: { old_title: "Before", new_title: "After" } })
+    events(:logo_published).update!(action: "card_board_changed", particulars: { particulars: { new_board: "Writebook" } })
+    events(:text_published).update!(action: "card_triaged")
+    events(:shipping_closed).update!(action: "card_collection_changed")
+    events(:shipping_published).update!(action: "card_resumed")
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    entries = response.parsed_body.index_by { |entry| entry["action"] }
+    assert_equal({ "old_title" => "Before", "new_title" => "After" }, entries.dig("card_title_changed", "particulars"))
+    assert_equal({ "old_board" => "", "new_board" => "Writebook" }, entries.dig("card_board_changed", "particulars"))
+    assert_equal({ "column" => "" }, entries.dig("card_triaged", "particulars"))
+    assignment = events(:layout_assignment_jz)
+    assert_equal({ "assignee_ids" => assignment.assignee_ids }, response.parsed_body.find { |entry| entry["id"] == assignment.id }["particulars"])
+    assert_not entries.key?("card_collection_changed")
+    assert_not entries.key?("card_resumed")
+  end
+
+  test "filters within the user's accessible boards" do
+    events(:text_published).update!(board: boards(:private))
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_empty response.parsed_body
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id, boards(:private).id ] }
+    assert_response :success
+    assert_equal [ events(:shipping_closed).id, events(:shipping_published).id ], response.parsed_body.pluck("id")
+  end
+
+  test "paginates the filtered feed" do
+    event = events(:logo_published)
+    20.times { event.card.track_event(:published, creator: event.creator) }
+    get activities_path(format: :json), params: { creator_ids: [ event.creator_id, users(:jz).id ] }
+    assert_response :success
+    first_ids = response.parsed_body.pluck("id")
+    total = response.headers.fetch("X-Total-Count").to_i
+
+    get response.headers.fetch("Link")[/<(.*?)>; rel="next"/, 1]
+    assert_response :success
+    assert_equal [ event.creator_id ], response.parsed_body.map { |entry| entry.dig("creator", "id") }.uniq
+    assert_equal total, (first_ids | response.parsed_body.pluck("id")).size
+  end
+end
