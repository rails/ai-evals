+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,12 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest shows the short date" do
+    book = books(:handbook)
+    book.update!(published: true)
+
+    digest = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_includes digest.body.decoded, "#{book.title}, last edited #{book.updated_at.to_date.to_fs(:short)}"
+  end
+end
