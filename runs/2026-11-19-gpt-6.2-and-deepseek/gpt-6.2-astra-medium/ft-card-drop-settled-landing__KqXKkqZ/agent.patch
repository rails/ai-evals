diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..a60bfb5
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,141 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const draggedClass = "drag-and-drop__dragged-item"
+const hoverClass = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "card" ]
+
+  #card
+  #hover
+  #saving = new WeakSet()
+
+  cardTargetConnected(card) {
+    card.draggable = !this.#saving.has(card)
+  }
+
+  preserveDraggable(event) {
+    if (event.detail.attributeName === "draggable" && this.cardTargets.includes(event.target)) {
+      event.preventDefault()
+    }
+  }
+
+  disconnect() {
+    this.end()
+  }
+
+  start(event) {
+    const card = event.target
+    if (!this.cardTargets.includes(card) || !card.draggable) return
+
+    this.#card = card
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+    card.classList.add(draggedClass)
+  }
+
+  over(event) {
+    const column = this.#destination(event)
+    this.#highlight(column)
+    if (column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (!this.#hover?.contains(event.relatedTarget)) this.#highlight(null)
+  }
+
+  end() {
+    this.#card?.classList.remove(draggedClass)
+    this.#card = null
+    this.#highlight(null)
+  }
+
+  async drop(event) {
+    const column = this.#destination(event)
+    const card = this.#card
+    this.end()
+    if (!column) return
+
+    event.preventDefault()
+    const source = card.closest("[data-drag-destination]")
+    this.#saving.add(card)
+    card.draggable = false
+    this.#insert(card, column)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(column, 1)
+    this.#updatePreview(card, column)
+
+    try {
+      const response = await this.#save(card, column)
+      if (!response.ok || response.redirected) throw new Error("Move failed")
+    } catch {
+      // A failed response may still have committed. Restore authoritative board state.
+      if (this.element.isConnected) window.location.reload()
+    } finally {
+      this.#saving.delete(card)
+      card.draggable = true
+    }
+  }
+
+  #updatePreview(card, column) {
+    card.style.setProperty("--card-color", column.style.getPropertyValue("--card-color") || "var(--color-card-default)")
+    card.querySelector(".card__closed")?.remove()
+    card.querySelector(".bubble")?.remove()
+    card.classList.toggle("card--postponed", column.dataset.dragDestination === "not-now")
+    card.classList.toggle("card--active", [ "maybe", "column" ].includes(column.dataset.dragDestination))
+    card.removeAttribute("aria-selected")
+    const updatedAt = card.querySelector(".card__meta-text--updated time")
+    if (updatedAt) updatedAt.dateTime = Math.floor(Date.now() / 1000)
+  }
+
+  #destination(event) {
+    const column = event.target.closest("[data-drag-destination]")
+    if (!this.element.contains(this.#card) || column?.contains(this.#card)) return
+    if (column?.querySelector(".cards__list")) return column
+  }
+
+  #highlight(column) {
+    if (column !== this.#hover) {
+      this.#hover?.classList.remove(hoverClass)
+      column?.classList.add(hoverClass)
+      this.#hover = column
+    }
+  }
+
+  #insert(card, column) {
+    const list = column.querySelector(".cards__list")
+    const cards = list.querySelectorAll(".card")
+    const goldenFirst = [ "maybe", "column" ].includes(column.dataset.dragDestination)
+    // Moving is activity: insert as newest, respecting the destination's golden group.
+    const next = goldenFirst && !card.matches(".golden-effect") ? list.querySelector(".card:not(.golden-effect)") : cards[0]
+    if (next) {
+      next.before(card)
+    } else if (cards.length) {
+      cards[cards.length - 1].after(card)
+    } else {
+      list.prepend(card)
+    }
+  }
+
+  #adjustCount(column, delta) {
+    const badge = column.querySelector(".cards__expander-count")
+    const count = Number(badge.dataset.count) + delta
+    badge.dataset.count = count
+    badge.textContent = count > 99 ? "99+" : count
+    badge.closest(".cards__expander").style.setProperty("--card-count", Math.min(count, 15))
+  }
+
+  #save(card, column) {
+    const options = { responseKind: "json" }
+    switch (column.dataset.dragDestination) {
+      case "maybe": return destroy(card.dataset.cardTriageUrl, options)
+      case "done": return post(card.dataset.cardClosureUrl, options)
+      case "not-now": return post(card.dataset.cardNotNowUrl, options)
+      case "column": return post(card.dataset.cardTriageUrl, { ...options, body: { column_id: column.dataset.columnId } })
+    }
+  }
+}
