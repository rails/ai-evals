diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..6d0b6f8
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,95 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup { sign_in_as users(:david) }
+
+  test "dropping immediately moves the card into the destination's own order" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_triage)
+    visit board_url(card.board)
+
+    assert_selector "##{dom_id(column)} ##{dom_id(cards(:logo), :article)}", visible: :all
+    drop card, onto: dom_id(column)
+    assert_equal [ cards(:logo), card, cards(:layout) ].map { |c| dom_id(c, :article) },
+      all("##{dom_id(column)} article.card", visible: :all).map { |node| node[:id] }
+    assert_equal column, card.reload.column
+    drop card, onto: "closed-cards"
+    assert_predicate card.reload, :closed?
+    drop card, onto: "not-now"
+    assert_predicate card.reload, :postponed?
+    drop card, onto: "maybe"
+
+    refresh
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    assert_predicate card.reload, :awaiting_triage?
+  end
+
+  test "native drag moves a card into an empty collapsed column" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_review)
+    visit board_url(card.board)
+
+    destination = find("##{dom_id(column)}")
+    article = find("##{dom_id(card, :article)}[draggable=true]")
+    destination.assert_selector ".cards__list", visible: :all
+    article.drag_to(destination.find(".cards__expander"))
+
+    destination.assert_selector "##{dom_id(card, :article)}[draggable=true]", visible: :all
+    assert_equal column, card.reload.column
+    assert_equal "1", destination.find(".cards__expander-count", visible: :all).text(:all)
+  end
+
+  test "a drop in the source column is a no-op" do
+    card = cards(:layout)
+    visit board_url(card.board)
+
+    # Reload the column as a Turbo refresh would, morphing the existing card in place.
+    frame = find("##{dom_id(card.column, :cards)}", visible: :all)
+    frame.assert_selector "##{dom_id(card, :article)}[draggable=true]", visible: :all
+    page.evaluate_async_script("arguments[0].reload().then(arguments[1])", frame)
+
+    before = card.last_active_at
+    drop card, onto: dom_id(card.column)
+    assert_equal before, card.reload.last_active_at
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+  end
+
+  test "a rejected move restores the saved board" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_review)
+    visit board_url(card.board)
+
+    article = find("##{dom_id(card, :article)}[draggable=true]")
+    destination = find("##{dom_id(column)}")
+    destination.assert_selector ".cards__list", visible: :all
+    page.execute_script("arguments[0].dataset.columnId = 'missing'", destination)
+    article.drag_to(destination.find(".cards__expander"))
+
+    assert_no_selector "[data-column-id='missing']"
+    assert_selector "#maybe ##{dom_id(card, :article)}[draggable=true]"
+    assert_predicate card.reload, :awaiting_triage?
+  end
+
+  private
+    def drop(card, onto:)
+      article = find("##{dom_id(card, :article)}[draggable=true]", visible: :all)
+      destination = find("##{onto}")
+      assert page.evaluate_script(<<~JS, article, destination), "card should move before the drop handler returns"
+        (function(card, column) {
+          const dataTransfer = new DataTransfer()
+          const drag = (node, type) => node.dispatchEvent(new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer }))
+          const changingColumn = !column.contains(card)
+          drag(card, "dragstart")
+          if (!card.classList.contains("drag-and-drop__dragged-item")) return false
+          drag(column, "dragover")
+          if (column.classList.contains("drag-and-drop__hover-container") !== changingColumn) return false
+          drag(column, "drop")
+          drag(card, "dragend")
+          return column.contains(card)
+        })(arguments[0], arguments[1])
+      JS
+      assert_selector "##{onto} ##{dom_id(card, :article)}[draggable=true]", visible: :all
+    end
+end
