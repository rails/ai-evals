diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..26530c5
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,92 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:buy_domain)
+    visit board_path(@card.board)
+  end
+
+  test "dropping on a collapsed column moves the card below golden cards and persists" do
+    destination = "##{dom_id(columns(:writebook_triage))}"
+    drag_from_to "#maybe", destination
+
+    assert_order destination, cards(:logo), @card, cards(:layout)
+    assert_saved_in destination
+    refresh
+    assert_order destination, cards(:logo), @card, cards(:layout)
+  end
+
+  test "moving through Done and Not Now and back to Maybe" do
+    drag_from_to "#maybe", "#closed-cards"
+    assert_saved_in "#closed-cards"
+    assert_predicate @card.reload, :closed?
+
+    drag_from_to "#closed-cards", "#not-now"
+    assert_saved_in "#not-now"
+    assert_predicate @card.reload, :postponed?
+
+    drag_from_to "#not-now", "#maybe"
+    assert_saved_in "#maybe"
+    assert_predicate @card.reload, :awaiting_triage?
+    assert_selector "#maybe ##{dom_id(@card, :article)}.card--active"
+  end
+
+  test "counts and placement are immediate and a rejected drop restores both" do
+    page.execute_script <<~JS
+      const fetch = window.fetch
+      window.fetch = (url, options) => {
+        if (options?.method === "POST") {
+          return new Promise(resolve => window.rejectDrop = () => resolve(new Response(null, { status: 422 })))
+        } else {
+          return fetch(url, options)
+        }
+      }
+    JS
+
+    drag_from_to "#maybe", "#not-now" do
+      assert_selector "#maybe .drag-and-drop__dragged-item"
+      assert_selector "#not-now.drag-and-drop__hover-container"
+    end
+    assert_selector "#maybe .cards__expander-count[data-count='0']", visible: :all
+    assert_selector "#not-now .cards__expander-count[data-count='1']", visible: :all
+    assert_selector "#not-now ##{dom_id(@card, :article)}", visible: :all
+
+    page.execute_script "window.rejectDrop()"
+    assert_selector "#maybe ##{dom_id(@card, :article)}"
+    assert_selector "#maybe .cards__expander-count[data-count='1']", visible: :all
+    assert_selector "#not-now .cards__expander-count[data-count='0']", visible: :all
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+  end
+
+  test "a drop within the original column does not triage or reorder cards" do
+    column = "##{dom_id(columns(:writebook_triage))}"
+    assert_no_difference -> { cards(:layout).events.count } do
+      drag_from_to column, column, card: cards(:layout)
+      assert_order column, cards(:logo), cards(:layout)
+    end
+  end
+
+  private
+    def drag_from_to(source, destination, card: @card)
+      find("#{source} .cards__expander").click if has_css?("#{source}.is-collapsed", wait: 0)
+      item = find("#{source} ##{dom_id(card, :article)}")
+      target = find("#{destination} .cards__expander")
+      # Start the native drag while the pointer is still over the card.
+      page.driver.browser.action.move_to(item.native).click_and_hold.move_by(10, 0)
+        .move_to(target.native).move_by(1, 0).perform
+      yield if block_given?
+      page.driver.browser.action.release.perform
+    end
+
+    def assert_saved_in(column)
+      assert_selector "#{column} ##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+    end
+
+    def assert_order(column, *cards)
+      selector = cards.map { |card| "##{dom_id(card, :article)}" }.join(" + ")
+      assert_selector "#{column} #{selector}", visible: :all
+    end
+end
