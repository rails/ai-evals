diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..4cc0052
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,140 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  #card
+  #hovered
+
+  // Previews are shared with read-only lists and can be replaced by Turbo at
+  // any time. Enable the native drag only when pressing a card on this board.
+  prepare(event) {
+    const card = event.target.closest("article[data-card-triage-url]")
+    if (card) card.draggable = event.pointerType !== "touch"
+  }
+
+  disconnect() {
+    this.end()
+  }
+
+  start(event) {
+    const card = event.target.closest("article[data-card-triage-url]")
+    if (!card) return
+    if (card.hasAttribute("aria-busy")) return event.preventDefault()
+
+    this.#card = card
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("application/x-fizzy-card", card.id)
+    card.classList.add("drag-and-drop__dragged-item")
+  }
+
+  over(event) {
+    const column = this.#destination(event)
+    this.#highlight(column)
+    if (column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (!this.#hovered?.contains(event.relatedTarget)) this.#highlight(null)
+  }
+
+  async drop(event) {
+    const card = this.#card
+    const column = this.#destination(event)
+    this.end()
+    if (!column) return
+    event.preventDefault()
+
+    const source = card.closest("[data-drop-status]")
+    const original = card.cloneNode(true)
+    const marker = document.createComment("card move")
+    card.before(marker)
+    card.setAttribute("aria-busy", "true")
+    this.#place(card, column)
+    this.#updateAppearance(card, column)
+    this.#updateCount(source, -1)
+    this.#updateCount(column, 1)
+
+    try {
+      const response = await this.#save(card, column)
+      if (!response.ok || response.redirected) throw new Error("Card move was not saved")
+    } catch {
+      card.remove()
+      marker.replaceWith(original)
+      this.#updateCount(source, 1)
+      this.#updateCount(column, -1)
+    } finally {
+      marker.remove()
+      card.removeAttribute("aria-busy")
+    }
+  }
+
+  end() {
+    this.#card?.classList.remove("drag-and-drop__dragged-item")
+    this.#card = null
+    this.#highlight(null)
+  }
+
+  #destination(event) {
+    const column = event.target.closest("[data-drop-status]")
+    if (this.element.contains(this.#card) && column?.querySelector(".cards__list") && !column.contains(this.#card)) return column
+  }
+
+  #highlight(column) {
+    if (column !== this.#hovered) {
+      this.#hovered?.classList.remove("drag-and-drop__hover-container")
+      column?.classList.add("drag-and-drop__hover-container")
+      this.#hovered = column
+    }
+  }
+
+  #place(card, column) {
+    const list = column.querySelector(".cards__list")
+    const belowGold = this.#isActiveColumn(column) && !card.matches(".golden-effect")
+
+    // Moves are new activity. Only active columns sort gold ahead of recency.
+    const cards = Array.from(list.querySelectorAll("article.card"))
+    const next = cards.find(other => !belowGold || !other.matches(".golden-effect"))
+    if (next) {
+      next.before(card)
+    } else if (cards.length) {
+      cards.at(-1).after(card)
+    } else {
+      (list.querySelector("turbo-frame") || list).prepend(card)
+    }
+  }
+
+  #updateAppearance(card, column) {
+    const active = this.#isActiveColumn(column)
+    card.removeAttribute("aria-selected")
+    card.style.setProperty("--card-color", column.style.getPropertyValue("--card-color") || "var(--color-card-default)")
+    card.classList.toggle("card--active", active)
+    card.classList.toggle("card--postponed", column.dataset.dropStatus === "postponed")
+    card.querySelector(".card__closed")?.remove()
+    card.querySelector(".bubble")?.remove()
+    card.querySelector(".card__meta-text--updated time").setAttribute("datetime", Math.floor(Date.now() / 1000))
+  }
+
+  #isActiveColumn(column) {
+    return [ "column", "maybe" ].includes(column.dataset.dropStatus)
+  }
+
+  #updateCount(column, delta) {
+    const badge = column.querySelector(".cards__expander-count")
+    const count = Number(badge.dataset.count) + delta
+    badge.dataset.count = count
+    badge.textContent = count > 99 ? "99+" : count
+  }
+
+  #save(card, column) {
+    const options = { responseKind: "json" }
+    switch (column.dataset.dropStatus) {
+      case "column": return post(card.dataset.cardTriageUrl, { ...options, body: { column_id: column.dataset.columnId } })
+      case "maybe": return destroy(card.dataset.cardTriageUrl, options)
+      case "closed": return post(card.dataset.cardClosureUrl, options)
+      case "postponed": return post(card.dataset.cardNotNowUrl, options)
+    }
+  }
+}
