diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..993bdfe 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -79,6 +79,26 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
   end
 
+  test "show serves the picture processed after upload without transforming it again" do
+    picture = pictures(:reading)
+    perform_enqueued_jobs(only: [ ActiveStorage::CreateVariantsJob, ActiveStorage::TransformJob ]) do
+      picture.image.attach fixture_file_upload("white-rabbit.webp", "image/webp")
+    end
+    variants = picture.image.blob.variant_records
+    processed_image = variants.sole.image
+
+    assert_no_notifications("transform.active_storage") do
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      thumbnail = assert_select(".toc__thumbnail img[src$='white-rabbit.webp']", count: 1).first
+      get thumbnail["src"]
+      follow_redirect!
+      assert_response :success
+      assert_equal processed_image.download, response.body.b
+    end
+    assert_equal 1, variants.count
+  end
+
   test "show includes OG metadata for public access" do
     get book_slug_url(books(:handbook))
     assert_response :success
