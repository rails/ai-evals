--- /dev/null
+++ b/app/jobs/notification/push_job.rb
@@ -0,0 +1,11 @@
+class Notification::PushJob < ApplicationJob
+  self.log_arguments = false
+  discard_on ActiveJob::DeserializationError
+  retry_on Net::OpenTimeout, Net::ReadTimeout, Net::HTTPFatalError, wait: :polynomially_longer
+
+  def perform(notification, subscription, payload)
+    if PushSubscription.configured? && subscription.user_id == notification.user_id && subscription.user.accessible_cards.exists?(notification.card_id)
+      subscription.deliver(payload)
+    end
+  end
+end
