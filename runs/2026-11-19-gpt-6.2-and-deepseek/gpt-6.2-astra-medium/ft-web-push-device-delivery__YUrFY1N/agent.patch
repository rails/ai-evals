@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @subscription = { endpoint: "https://push.example.test/abc", p256dh_key: "public-key", auth_key: "auth-secret" }
+  end
+
+  test "registering the same device twice refreshes its keys" do
+    path = user_push_subscriptions_path(users(:david))
+    post path, params: { push_subscription: @subscription }, as: :json
+    assert_response :success
+    post path, params: { push_subscription: @subscription.merge(auth_key: "replacement") }, as: :json
+    assert_response :success
+    assert_equal "replacement", users(:david).push_subscriptions.sole.auth_key
+  end
+
+  test "cannot register a device for another user" do
+    post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @subscription }, as: :json
+    assert_response :forbidden
+  end
+  test "only removes the selected device" do
+    user = users(:david)
+    first = PushSubscription.register(user, @subscription)
+    second = PushSubscription.register(user, @subscription.merge(endpoint: "https://push.example.test/def"))
+    delete user_push_subscription_path(user, first), as: :json
+    assert_response :no_content
+    assert_equal second, user.push_subscriptions.sole
+  end
+
+  test "signing out stops delivery to subscriptions registered in this session" do
+    post user_push_subscriptions_path(users(:david)), params: { push_subscription: @subscription }, as: :json
+    assert_response :success
+    assert_difference -> { PushSubscription.count }, -1 do
+      sign_out
+    end
+  end
+
+  test "rejects an insecure endpoint" do
+    post user_push_subscriptions_path(users(:david)), as: :json,
+      params: { push_subscription: @subscription.merge(endpoint: "http://push.example.test/sub") }
+    assert_response :unprocessable_entity
+  end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..035d6ca
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @user = users(:david)
+    [ "phone", "desktop" ].each do |device|
+      PushSubscription.register(@user, endpoint: "https://push.example/#{device}", p256dh_key: "public", auth_key: "secret")
+    end
+  end
+
+  test "pushes the new tray item to each registered device" do
+    source = events(:layout_commented)
+    payload = { "title" => "RE: #{source.card.title}", "body" => source.eventable.body.to_plain_text.truncate(200),
+      "url" => Rails.application.routes.url_helpers.card_path(source.card, script_name: @user.account.slug) }
+    PushSubscription.any_instance.expects(:deliver).with(payload).twice
+    perform_enqueued_jobs(only: Notification::PushJob) do
+      Notification.create!(user: @user, source: source, creator: source.creator)
+    end
+  end
+
+  test "pushes a new mention on an existing tray item but not read and unread changes" do
+    item = notifications(:logo_mentioned_david)
+    source = mentions(:logo_card_david_mention_by_jz)
+    PushSubscription.any_instance.expects(:deliver).twice.with do |payload|
+      payload["title"] == "#{source.mentioner.first_name} @mentioned you" && payload["body"] == source.source.mentionable_content.truncate(200)
+    end
+    perform_enqueued_jobs(only: Notification::PushJob) { item.update!(source: source) }
+    assert_no_enqueued_jobs(only: Notification::PushJob) do
+      item.read
+      item.unread
+    end
+  end
+end
