+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    vapid = WebPush.generate_key
+    PushSubscription.stubs(:vapid).returns(vapid.to_h)
+    @subscription = PushSubscription.register(users(:david), endpoint: "https://push.example/sub",
+      p256dh_key: WebPush.generate_key.public_key, auth_key: Base64.urlsafe_encode64(SecureRandom.random_bytes(16)))
+  end
+
+  test "sends an encrypted and signed push to the validated address" do
+    stub_dns_resolution("93.184.216.34")
+    request = stub_request(:post, @subscription.endpoint).with(ipaddr: "93.184.216.34",
+      headers: { "Content-Encoding" => "aes128gcm", "Authorization" => /\Avapid / }).to_return(status: 201)
+    @subscription.deliver(title: "Card", body: "Assigned", url: "/123/cards/1")
+    assert_requested request
+  end
+
+  test "removes a subscription rejected as expired by the push service" do
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, @subscription.endpoint).to_return(status: 410)
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.deliver(title: "Card")
+    end
+  end
+
+  test "never sends to a private address" do
+    stub_dns_resolution("127.0.0.1")
+    request = stub_request(:post, @subscription.endpoint)
+    @subscription.deliver(title: "Card")
+    assert_not_requested request
+  end
+end
