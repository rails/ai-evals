+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  test "enable and disable notifications for this browser" do
+    PushSubscription.stubs(:configured?).returns(true)
+    PushSubscription.stubs(:public_key).returns(WebPush.generate_key.public_key)
+    sign_in_as users(:david)
+    visit notifications_settings_path
+
+    # Exercise the settings, worker registration and server round trip without a
+    # real permission prompt or a call to an external browser push service.
+    page.execute_script <<~JS
+      Notification.requestPermission = async () => "granted"
+      PushManager.prototype.subscribe = async () => ({
+        toJSON: () => ({ endpoint: "https://push.example.test/device", keys: { p256dh: "public", auth: "secret" } })
+      })
+    JS
+    click_on "Turn on push notifications"
+    assert_button "Turn off push notifications"
+    assert_equal "https://push.example.test/device", users(:david).push_subscriptions.sole.endpoint
+
+    click_on "Turn off push notifications"
+    assert_button "Turn on push notifications"
+    assert_empty users(:david).push_subscriptions.reload
+  end
+end
