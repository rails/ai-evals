+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,27 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: -> { saved_change_to_source_id? || saved_change_to_source_type? }
+  end
+
+  private
+    def push_later
+      if PushSubscription.configured?
+        payload = nil
+        user.push_subscriptions.find_each do |subscription|
+          # Capture the text now: another event can replace this notification's source.
+          payload ||= push_payload
+          Notification::PushJob.perform_later(self, subscription, payload)
+        end
+      end
+    end
+
+    def push_payload
+      body = ApplicationController.render(partial: "notifications/notification/#{source_type.underscore}/body",
+        formats: [ :json ], locals: { notification: self })
+      JSON.parse(body).transform_values { |text| text.truncate_bytes(1500) }.merge(
+        "url" => Rails.application.routes.url_helpers.card_path(card, script_name: account.slug)
+      )
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..d4be316
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,62 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :user
+  belongs_to :session, optional: true
+
+  validates :p256dh_key, :auth_key, presence: true, length: { maximum: 255 }
+  validate :secure_endpoint
+
+  def self.public_key
+    ENV["VAPID_PUBLIC_KEY"]
+  end
+
+  def self.vapid
+    { public_key: public_key, private_key: ENV["VAPID_PRIVATE_KEY"], subject: ENV["BASE_URL"].presence }.compact
+  end
+
+  def self.configured?
+    public_key.present? && ENV["VAPID_PRIVATE_KEY"].present?
+  end
+
+  def self.register(user, attributes)
+    digest = Digest::SHA256.hexdigest(attributes[:endpoint].to_s)
+    subscription = user.push_subscriptions.create_or_find_by!(endpoint_digest: digest) do |record|
+      record.assign_attributes(attributes)
+    end
+    subscription.update!(attributes) unless subscription.previously_new_record?
+    subscription
+  end
+
+  def deliver(payload)
+    uri = URI(endpoint)
+    # Pin the connection to a public IP, retaining the hostname for TLS verification.
+    if ip = SsrfProtection.resolve_public_ip(uri.hostname)
+      response = send_payload(payload, uri, ip)
+      if response.is_a?(Net::HTTPGone) || response.is_a?(Net::HTTPNotFound)
+        destroy!
+      else
+        response.value
+      end
+    end
+  end
+
+  private
+    def send_payload(payload, uri, ip)
+      request = WebPush::Request.new(message: JSON.generate(payload),
+        subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        vapid: self.class.vapid)
+
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = true
+      http.open_timeout = http.read_timeout = 7
+      # Stream and discard the response rather than buffering it in memory.
+      http.post(uri.request_uri, request.body, request.headers) { |_chunk| }
+    end
+
+    def secure_endpoint
+      uri = URI.parse(endpoint.to_s)
+      errors.add(:endpoint, :invalid) unless uri.is_a?(URI::HTTPS) && uri.host.present? && !uri.userinfo && !uri.fragment
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, :invalid)
+    end
+end
