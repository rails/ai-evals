@@ -0,0 +1,24 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :ensure_current_user
+
+  def create
+    subscription = PushSubscription.register(Current.user, subscription_params.merge(session: Current.session))
+    render json: { id: subscription.id }, status: :created
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  def destroy
+    Current.user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def ensure_current_user
+      head :forbidden unless Current.user.id == params[:user_id]
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..d5c9d80
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,77 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "toggle", "status", "help" ]
+  static values = { url: String, publicKey: String, devices: Object }
+
+  async connect() {
+    this.toggleTarget.disabled = true
+    if (!("serviceWorker" in navigator && "PushManager" in window && "Notification" in window)) {
+      this.#showHelp("This browser does not support push notifications.")
+    } else if (Notification.permission === "denied") {
+      this.#showHelp("This browser is blocking notifications.")
+    } else {
+      try {
+        this.registration = await navigator.serviceWorker.ready
+        const subscription = await this.registration.pushManager.getSubscription()
+        this.digest = subscription && await this.#endpointDigest(subscription.endpoint)
+        this.#refresh()
+      } catch {
+        this.#showHelp("Could not check notifications on this device.")
+      }
+    }
+  }
+
+  async toggle() {
+    this.toggleTarget.disabled = true
+    try {
+      if (this.devicesValue[this.digest]) {
+        // The browser subscription can still be in use by another account.
+        const response = await destroy(`${this.urlValue}/${this.devicesValue[this.digest]}`)
+        if (!response.ok) throw new Error()
+        const devices = this.devicesValue
+        delete devices[this.digest]
+        this.devicesValue = devices
+      } else {
+        if (await Notification.requestPermission() !== "granted") {
+          this.#showHelp("Allow notifications in your browser to turn them on here.")
+          this.toggleTarget.disabled = Notification.permission === "denied"
+          return
+        }
+
+        const subscription = await this.registration.pushManager.subscribe({
+          userVisibleOnly: true, applicationServerKey: this.publicKeyValue
+        })
+        const { endpoint, keys } = subscription.toJSON()
+        const response = await post(this.urlValue, { responseKind: "json", body: {
+          push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth }
+        } })
+        if (!response.ok) throw new Error()
+        this.digest = await this.#endpointDigest(endpoint)
+        this.devicesValue = { ...this.devicesValue, [this.digest]: (await response.json).id }
+      }
+      this.#refresh()
+    } catch {
+      this.#showHelp("Could not change notifications. Please try again.")
+      this.toggleTarget.disabled = false
+    }
+  }
+
+  async #endpointDigest(endpoint) {
+    const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(endpoint))
+    return Array.from(new Uint8Array(bytes), (byte) => byte.toString(16).padStart(2, "0")).join("")
+  }
+
+  #refresh() {
+    this.element.classList.toggle("notifications--on", !!this.devicesValue[this.digest])
+    this.toggleTarget.disabled = false
+    this.statusTarget.textContent = ""
+    this.helpTarget.hidden = true
+  }
+
+  #showHelp(message) {
+    this.statusTarget.textContent = message
+    this.helpTarget.hidden = false
+  }
+}
