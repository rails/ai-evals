diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..6d99ea5
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,22 @@
+class Bots::MessagesController < ActionController::API
+  include BlockBannedRequests, SetCurrentRequest
+
+  def create
+    Current.user = User.active.bots.find_signed(request.get_header("campfire.bot_code"), purpose: :bot_messages)
+    return head :unauthorized unless Current.user
+    return head :forbidden if Current.user.bot_suspension_reason?
+    return head :not_found unless params[:room_id].match?(/\A\d+\z/)
+
+    post = BotPost.new(Current.user, params[:room_id])
+    status = post.create(message_body)
+    response.headers["Retry-After"] = post.retry_after.to_s if status == :too_many_requests
+    response.location = message_path(post.message.id) if post.message
+    head status
+  end
+
+  private
+    def message_body
+      text = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+      ERB::Util.html_escape(text).gsub(/\r?\n/, "<br>") if text.valid_encoding? && text.present?
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
