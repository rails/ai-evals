diff --git a/test/jobs/bot_joined_webhook_job_test.rb b/test/jobs/bot_joined_webhook_job_test.rb
new file mode 100644
index 0000000..5b0f268
--- /dev/null
+++ b/test/jobs/bot_joined_webhook_job_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class BotJoinedWebhookJobTest < ActiveJob::TestCase
+  setup do
+    @owner = users(:david)
+    @bot = @owner.created_bots.create!(name: "Greeter", webhook_url: "https://bot.example/hook")
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example").returns("93.184.216.34")
+  end
+
+  test "granting room membership sends joined once and posts the reply in that room" do
+    room = rooms(:designers)
+    request = stub_request(:post, @bot.webhook_url).with(body: {
+      event: "joined", room: { id: room.id, name: room.name, reply_to: "/rooms/#{room.id}/#{@bot.bot_code}/messages" }
+    }).to_return(status: 200, headers: { "Content-Type" => "text/html" }, body: "<strong>Hello!</strong>")
+
+    perform_enqueued_jobs only: BotJoinedWebhookJob do
+      2.times { room.memberships.grant_to(@bot) }
+    end
+
+    assert_requested request, times: 1
+    assert_includes room.messages.where(creator: @bot).sole.body.to_s, "<strong>Hello!</strong>"
+  end
+
+  test "automatic grants only notify for new memberships" do
+    rooms(:hq).memberships.grant_to(@bot)
+    assert_enqueued_jobs Rooms::Open.count - 1, only: BotJoinedWebhookJob do
+      @bot.update!(add_to_all_open_rooms: true)
+    end
+    assert_enqueued_jobs 1, only: BotJoinedWebhookJob do
+      Rooms::Open.create!(creator: @owner, name: "New room")
+    end
+  end
+
+  test "direct rooms never notify" do
+    assert_no_enqueued_jobs only: BotJoinedWebhookJob do
+      Rooms::Direct.create_for({ creator: @owner }, users: [ @owner, @bot ])
+    end
+  end
+
+  test "a revoked membership cancels the queued callback" do
+    room = rooms(:designers)
+    room.memberships.grant_to(@bot)
+    room.memberships.revoke_from(@bot)
+    perform_enqueued_jobs only: BotJoinedWebhookJob
+    assert_not_requested :post, @bot.webhook_url
+  end
+end
diff --git a/test/jobs/bot_webhook_job_test.rb b/test/jobs/bot_webhook_job_test.rb
new file mode 100644
index 0000000..af84e81
--- /dev/null
+++ b/test/jobs/bot_webhook_job_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class BotWebhookJobTest < ActiveJob::TestCase
+  setup do
+    @author = users(:jz)
+    @bot = @author.created_bots.create!(name: "Deploy", webhook_url: "https://bot.example/mention")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example").returns("93.184.216.34")
+  end
+
+  test "a rich mention delivers one callback and posts the plain text reply as the bot" do
+    mention = ActionText::Attachment.from_attachable(@bot).to_html
+    message = @room.messages.create!(creator: @author, body: "<div>#{mention} #{mention} run <strong>build</strong> #{mention_attachment_for(:david)}</div>")
+    request = stub_request(:post, @bot.webhook_url).with(headers: { "Content-Type" => "application/json" }) do |req|
+      payload = JSON.parse(req.body)
+      assert_equal "mention", payload["event"]
+      assert_equal({ "id" => @author.id, "name" => @author.name }, payload["author"])
+      assert_equal({ "id" => @room.id, "name" => @room.name, "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages" }, payload["room"])
+      assert_equal message.id, payload.dig("message", "id")
+      assert_equal "/rooms/#{@room.id}/@#{message.id}", payload.dig("message", "link")
+      assert_equal "run build @David", payload.dig("message", "body", "text")
+      assert_includes payload.dig("message", "body", "html"), "<strong>build</strong>"
+    end.to_return(status: 200, headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "<ok>\ndone")
+
+    perform_enqueued_jobs only: BotWebhookJob
+    assert_requested request, times: 1
+    assert_equal "<ok>\ndone", @room.messages.where(creator: @bot).sole.plain_text_body
+  end
+
+  test "HTML replies preserve formatting without active content" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200, headers: { "Content-Type" => "text/html" }, body: '<strong onclick="bad()">ok</strong>')
+    perform_enqueued_jobs only: BotWebhookJob do
+      mention_bot
+    end
+    html = @bot.messages.sole.body.to_s
+    assert_includes html, "<strong>ok</strong>"
+    assert_not_includes html, "onclick"
+  end
+
+  test "204, redirects and unsupported response types produce no reply" do
+    request = stub_request(:post, @bot.webhook_url).to_return({ status: 204 },
+      { status: 302, headers: { "Location" => "https://other.example/" } },
+      { status: 200, headers: { "Content-Type" => "application/json" }, body: "{}" })
+    perform_enqueued_jobs only: BotWebhookJob do
+      3.times { mention_bot }
+    end
+    assert_requested request, times: 3
+    assert_empty @bot.messages
+  end
+
+  test "a bot cannot receive messages from a room it does not belong to" do
+    @room = rooms(:designers)
+    assert_no_enqueued_jobs only: BotWebhookJob do
+      mention_bot
+    end
+  end
+
+  test "membership revoked after enqueue prevents delivery" do
+    mention_bot
+    @room.memberships.revoke_from(@bot)
+    perform_enqueued_jobs only: BotWebhookJob
+    assert_not_requested :post, %r{bot\.example}
+  end
+
+  test "clearing the URL before delivery cancels the callback" do
+    mention_bot
+    @bot.update!(webhook_url: " ")
+    perform_enqueued_jobs only: BotWebhookJob
+    assert_nil @bot.reload.webhook_url
+    assert_not_requested :post, %r{bot\.example}
+    assert_no_enqueued_jobs only: BotWebhookJob do
+      mention_bot
+    end
+  end
+
+  test "ten consecutive failed deliveries suspend the bot and cancel queued deliveries" do
+    membership = @room.memberships.find_by!(user: @bot)
+    mention = mention_bot
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 503).times(9).
+      then.to_return(status: 202).
+      then.to_return(status: 302).times(8).
+      then.to_timeout.
+      then.to_raise(Errno::ECONNRESET)
+
+    10.times { BotWebhookJob.perform_now(mention, @bot) }
+    assert_equal 0, @bot.reload.bot_webhook_failures
+    9.times { BotJoinedWebhookJob.perform_now(membership) }
+    assert_not_predicate @bot.reload, :bot_suspension_reason?
+    BotWebhookJob.perform_now(mention, @bot)
+    assert_equal "Repeated webhook failures", @bot.reload.bot_suspension_reason
+
+    BotJoinedWebhookJob.perform_now(membership)
+    BotWebhookJob.perform_now(mention, @bot)
+    assert_requested request, times: 20
+    assert_empty @bot.messages
+  end
+
+  private
+    def mention_bot
+      @room.messages.create!(creator: @author, body: ActionText::Attachment.from_attachable(@bot).to_html)
+    end
+end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..43bb200
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "bots only join open rooms automatically while opted in" do
+    bot = users(:david).created_bots.create!(name: "Deploy")
+    assert_empty bot.rooms
+    existing = Rooms::Open.create!(name: "Existing", creator: users(:david))
+    assert_not_includes existing.users, bot
+
+    bot.update!(add_to_all_open_rooms: true)
+    assert_equal Rooms::Open.count, bot.rooms.opens.count
+    converted = rooms(:designers).becomes!(Rooms::Open)
+    converted.save!
+    assert_includes converted.users, bot
+    bot.update!(add_to_all_open_rooms: false)
+    assert_includes existing.users.reload, bot
+    later = Rooms::Open.create!(name: "Later", creator: users(:david))
+    assert_not_includes later.users, bot
+  end
+end
