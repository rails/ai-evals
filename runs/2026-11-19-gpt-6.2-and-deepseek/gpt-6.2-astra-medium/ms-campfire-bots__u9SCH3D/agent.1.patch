diff --git a/docs/bots.md b/docs/bots.md
new file mode 100644
index 0000000..53279b4
--- /dev/null
+++ b/docs/bots.md
@@ -0,0 +1,20 @@
+# Posting as a chat bot
+
+In Account settings, select **Set up chat bots**, add a bot, and copy its bot
+code into your CI secret store. Bots join open rooms automatically. To post in
+a closed room, the bot must first be added to the room.
+
+```sh
+curl --fail-with-body --data-binary 'Deploy of v1.2.3 finished ✅' \
+  "https://chat.example.com/rooms/${ROOM_ID}/${BOT_CODE}/messages"
+```
+
+Send UTF-8 text, not a form or JSON object. Success is `201 Created` with a
+`Location` pointing to the message. An invalid or revoked code returns `401`;
+missing or inaccessible rooms return `404`; blank text returns `422`.
+
+Anyone holding the URL can post as the bot in that room, and the code works
+in any room the bot belongs to. Use HTTPS, mask the code in CI output, and
+redact these paths in reverse-proxy access logs. If a code leaks, delete the
+bot and create a replacement. Deletion revokes posting access but preserves
+the authorship of past messages.
diff --git a/lib/middleware/bot_message_request.rb b/lib/middleware/bot_message_request.rb
new file mode 100644
index 0000000..fb9c2a1
--- /dev/null
+++ b/lib/middleware/bot_message_request.rb
@@ -0,0 +1,16 @@
+# Keep the credential out of Rails request paths/logs, and don't let Rack or
+# Action Dispatch interpret a curl -d payload as form fields (or JSON).
+class BotMessageRequest
+  def initialize(app)
+    @app = app
+  end
+
+  def call(env)
+    if match = %r{\A(/rooms/[^/]+)/([^/]+)/messages/?\z}.match(env["PATH_INFO"])
+      env["campfire.bot_code"] = match[2]
+      env["PATH_INFO"] = "#{match[1]}/filtered/messages"
+      env["CONTENT_TYPE"] = "text/plain"
+    end
+    @app.call(env)
+  end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..9dc8723
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :jz
+    post "/bots", params: { bot: { name: "Deploy Bot" } }
+    assert_redirected_to "/bots"
+    @bot = User.find_by!(name: "Deploy Bot")
+    @room = rooms(:hq)
+    get "/bots"
+    @code = css_select("li input[readonly]").sole["value"]
+  end
+
+  test "setup and edit forms are accessible to a member" do
+    get edit_account_path
+    assert_select "a[href=?][aria-label=?]", bots_path, "Set up chat bots"
+    get new_bot_path
+    assert_select "label", text: "Name the bot"
+    assert_select "input[type=file]"
+    assert_select "input[type=submit][value=?]", "Save changes"
+    get edit_bot_path(@bot)
+    assert_select "form[data-turbo-confirm] button", text: "Delete this chat bot"
+    assert_no_difference "User.count" do
+      post bots_path, params: { bot: { name: " " } }
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "a code posts plain text as the bot and notifies the room" do
+    body = "Deploy <v1> & 100% finished ✅"
+    reset!
+    assert_enqueued_with job: Room::PushMessageJob do
+      post "/rooms/#{@room.id}/#{@code}/messages", params: body.dup
+    end
+    assert_response :created
+    message = @bot.messages.sole
+    assert_equal @room, message.room
+    assert_equal body, message.plain_text_body
+    assert_equal message_path(message.id), URI(response.location).path
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author", text: @bot.name
+    end
+
+    sign_in :jz
+    get message_path(message.id)
+    assert_response :success
+    sign_in :bender
+    assert_raises ActiveRecord::RecordNotFound do
+      get message_path(message.id)
+    end
+  end
+
+  test "posting requires an active code, room membership and content" do
+    assert_no_difference "Message.count" do
+      post "/rooms/#{@room.id}/bad/messages", params: "hello"
+      assert_response :unauthorized
+      post "/rooms/#{@room.id}oops/#{@code}/messages", params: "hello"
+      assert_response :not_found
+      post "/rooms/#{rooms(:designers).id}/#{@code}/messages", params: "hello"
+      assert_response :not_found
+      post "/rooms/#{@room.id}/#{@code}/messages", params: "  "
+      assert_response :unprocessable_entity
+      delete bot_path(@bot)
+      assert_redirected_to bots_path
+      post "/rooms/#{@room.id}/#{@code}/messages", params: "hello"
+      assert_response :unauthorized
+    end
+  end
+
+  test "management and credentials are restricted to the creator and administrators" do
+    sign_in :kevin
+    get bots_path
+    assert_select "input[readonly]", count: 0
+    assert_raises ActiveRecord::RecordNotFound do
+      patch bot_path(@bot), params: { bot: { name: "Oops" } }
+    end
+    assert_raises ActiveRecord::RecordNotFound do
+      delete bot_path(@bot)
+    end
+    sign_in :david
+    get bots_path
+    assert_equal @code, css_select("li input[readonly]").sole["value"]
+    patch bot_path(@bot), params: { bot: { name: "Renamed" } }
+    assert_equal "Renamed", @bot.reload.name
+  end
+end
