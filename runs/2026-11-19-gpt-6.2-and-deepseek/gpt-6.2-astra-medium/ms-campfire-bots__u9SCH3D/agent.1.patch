new file mode 100644
index 0000000..40f73d1
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,19 @@
+class Bots::MessagesController < ActionController::API
+  include BlockBannedRequests, SetCurrentRequest
+
+  def create
+    Current.user = User.active.bots.find_signed(request.get_header("campfire.bot_code"), purpose: :bot_messages)
+    return head :unauthorized unless Current.user
+
+    return head :not_found unless params[:room_id].match?(/\A\d+\z/)
+    room = Current.user.rooms.find_by(id: params[:room_id])
+    return head :not_found unless room
+
+    body = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+    return head :unprocessable_entity unless body.valid_encoding? && body.present?
+
+    message = room.messages.create!(body: ERB::Util.html_escape(body).gsub(/\r?\n/, "<br>"))
+    message.broadcast_create
+    head :created, location: message_path(message.id)
+  end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..8f3c2b1
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,51 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    no_store
+    @bots = manageable_bots.ordered
+  end
+
+  def new
+    @bot = Current.user.created_bots.build
+  end
+
+  def create
+    @bot = Current.user.created_bots.build(bot_params)
+    if @bot.save
+      redirect_to bots_path
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_path
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @bot.remove_bot
+    redirect_to bots_path, status: :see_other
+  end
+
+  private
+    def manageable_bots
+      bots = Current.user.administrator? ? User.bots : Current.user.created_bots
+      bots.where.not(status: :deactivated)
+    end
+
+    def set_bot
+      @bot = manageable_bots.find(params[:id])
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
