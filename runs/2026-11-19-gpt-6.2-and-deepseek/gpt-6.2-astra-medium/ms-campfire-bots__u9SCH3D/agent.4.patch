diff --git a/test/controllers/accounts_controller_test.rb b/test/controllers/accounts_controller_test.rb
index 8292c6f..c1d9ecb 100644
--- a/test/controllers/accounts_controller_test.rb
+++ b/test/controllers/accounts_controller_test.rb
@@ -58,4 +58,21 @@ class AccountsControllerTest < ActionDispatch::IntegrationTest
     put account_url, params: { account: { name: "Different" } }
     assert_response :forbidden
   end
+
+  test "only administrators can configure bots per member" do
+    get edit_account_url
+    assert_select "label[for=account_settings_bots_per_member]", text: "Bots per member"
+    assert_select "input#account_settings_bots_per_member[type=number][value='5']"
+
+    put account_url, params: { account: { settings: { bots_per_member: "2" } } }
+    assert_redirected_to edit_account_url
+    assert_equal 2, accounts(:signal).settings.bots_per_member
+
+    sign_in :kevin
+    get edit_account_url
+    assert_select "input#account_settings_bots_per_member", count: 0
+    put account_url, params: { account: { settings: { bots_per_member: "3" } } }
+    assert_response :forbidden
+    assert_equal 2, accounts(:signal).reload.settings.bots_per_member
+  end
 end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
index 595df7e..69b80ec 100644
--- a/test/controllers/bots_controller_test.rb
+++ b/test/controllers/bots_controller_test.rb
@@ -100,4 +100,44 @@ class BotsControllerTest < ActionDispatch::IntegrationTest
     patch bot_path(@bot), params: { bot: { name: "Renamed" } }
     assert_equal "Renamed", @bot.reload.name
   end
+
+  test "the limit applies per owner and deleted bots free a slot" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    get bots_path
+    assert_select "a[href=?]", new_bot_path, count: 0
+    assert_match "reached the limit", response.body
+    get new_bot_path
+    assert_redirected_to bots_path
+    assert_no_difference "User.bots.count" do
+      post bots_path, params: { bot: { name: "Extra" } }
+      assert_response :unprocessable_entity
+    end
+
+    sign_in :kevin
+    post bots_path, params: { bot: { name: "Kevin's bot" } }
+    assert_redirected_to bots_path
+
+    sign_in :jz
+    delete bot_path(@bot)
+    get bots_path
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+    post bots_path, params: { bot: { name: "Replacement" } }
+    assert_redirected_to bots_path
+  end
+
+  test "lowering the limit preserves existing bots and does not restrict administrators" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    patch bot_path(@bot), params: { bot: { name: "Still here" } }
+    assert_equal "Still here", @bot.reload.name
+    assert_no_difference "User.bots.count" do
+      post bots_path, params: { bot: { name: "Extra" } }
+    end
+
+    sign_in :david
+    get bots_path
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+    assert_difference "User.bots.count" do
+      post bots_path, params: { bot: { name: "Admin bot" } }
+    end
+  end
 end
