-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+
+      # A fixed cutoff per board lets the database range-scan the cards index.
+      Board.preload(:entropy, account: :entropy).find_each do |board|
+        if board.account && (period = board.entropy&.auto_postpone_period)
+          active.where(board: board, last_active_at: ..(now - period)).find_in_batches do |cards|
+            system_user = board.account.system_user
+            cards.each { |card| card.auto_postpone(user: system_user) }
+          end
+        end
       end
     end
   end
