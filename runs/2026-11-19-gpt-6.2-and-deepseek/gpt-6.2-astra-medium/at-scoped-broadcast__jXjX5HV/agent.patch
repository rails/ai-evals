diff --git a/app/jobs/broadcast_being_edited_indicator_job.rb b/app/jobs/broadcast_being_edited_indicator_job.rb
new file mode 100644
index 0000000..82ba8d2
--- /dev/null
+++ b/app/jobs/broadcast_being_edited_indicator_job.rb
@@ -0,0 +1,13 @@
+class BroadcastBeingEditedIndicatorJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(leaf, user)
+    return unless leaf.active?
+
+    indicator = ApplicationController.render partial: "leaves/being_edited_by", formats: [ :turbo_stream ], locals: { leaf: leaf, user: user }
+
+    leaf.book.editors.where.not(id: user.id).find_each do |recipient|
+      Turbo::StreamsChannel.broadcast_stream_to leaf, :being_edited, recipient, content: indicator
+    end
+  end
+end
