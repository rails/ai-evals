+  test "queued editing presence goes only to editors who still have access" do
+    leaf = leaves(:welcome_page)
+    removed_editor_stream = editing_stream_for(leaf)
+    sign_out
+    sign_in :jason
+    remaining_editor_stream = editing_stream_for(leaf)
+    sign_out
+    sign_in :david
+
+    put leafable_path(leaf), params: { page: { body: "New text" } }
+    assert_response :no_content
+    accesses(:kevin_handbook).destroy!
+
+    assert_no_broadcasts "#{leaf.to_gid_param}:being_edited" do
+      assert_no_broadcasts removed_editor_stream do
+        messages = capture_broadcasts(remaining_editor_stream) { perform_enqueued_jobs }
+        assert_equal 1, messages.size
+        assert_includes messages.first, users(:david).name
+      end
+    end
+  end
+
   private
+    def editing_stream_for(leaf)
+      get edit_leafable_path(leaf)
+      assert_response :success
+      source = assert_select("turbo-cable-stream-source[signed-stream-name]", count: 1).first
+      Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    end
+
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
     end
