+++ b/app/controllers/concerns/email_authentication.rb
@@ -0,0 +1,19 @@
+module EmailAuthentication
+  private
+
+  def request_email_code(email_address, purpose:, join_code: nil)
+    identity = Identity.new(email_address: email_address)
+    return head :unprocessable_entity unless identity.valid?
+
+    challenge = EmailCode.issue(email_address: identity.email_address, purpose: purpose, join_code: join_code)
+    token = challenge.pending_token
+    cookies[:pending_authentication_token] = {
+      value: token, httponly: true, same_site: :lax, secure: request.ssl?, expires: EmailCode::LIFETIME.from_now
+    }
+
+    respond_to do |format|
+      format.html { redirect_to new_session_magic_link_path(script_name: nil) }
+      format.json { render json: { pending_authentication_token: token }, status: :created }
+    end
+  end
+end
