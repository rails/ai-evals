diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..68d0208
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,69 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, name: "ip"
+  rate_limit to: 10, within: EmailCode::LIFETIME, only: :create, name: "challenge", by: -> { Digest::SHA256.hexdigest(pending_token.to_s) }
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if challenge = EmailCode.consume(pending_token, params[:code])
+      cookies.delete(:pending_authentication_token)
+      case challenge.purpose
+      when "sign_in" then complete_sign_in(challenge)
+      when "signup"  then complete_signup(challenge)
+      when "join"    then complete_join(challenge)
+      end
+    else
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = "That code didn’t work. Try again or request a new code."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { head :unauthorized }
+      end
+    end
+  end
+
+  private
+    def pending_token
+      cookies[:pending_authentication_token]
+    end
+
+    def complete_sign_in(challenge)
+      if identity = Identity.find_by(email_address: challenge.email_address)
+        sign_in identity, after_authentication_url
+      else
+        head :unauthorized
+      end
+    end
+
+    def complete_signup(challenge)
+      if Account.accepting_signups?
+        identity = Signup.new(email_address: challenge.email_address).create_identity
+        sign_in identity, new_signup_completion_url
+      else
+        head :forbidden
+      end
+    end
+
+    def complete_join(challenge)
+      invitation = Account::JoinCode.find_by(account_id: challenge.account_id, code: challenge.join_code)
+      if user = invitation&.redeem_for(challenge.join_code) { Identity.find_or_create_by!(email_address: challenge.email_address) }
+        sign_in user.identity, joined_account_url(user)
+      else
+        head :gone
+      end
+    end
+
+    def sign_in(identity, destination)
+      start_new_session_for identity
+      respond_to do |format|
+        format.html { redirect_to destination }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+end
