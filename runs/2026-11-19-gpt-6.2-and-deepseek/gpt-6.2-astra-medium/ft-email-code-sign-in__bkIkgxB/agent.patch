diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..a4af476
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,31 @@
+class EmailCode < ApplicationRecord
+  LIFETIME = 15.minutes
+
+  scope :expired, -> { where(created_at: ..LIFETIME.ago) }
+
+  def self.issue(email_address:, purpose:, join_code: nil)
+    create!(email_address: email_address, purpose: purpose, account_id: join_code&.account_id, join_code: join_code&.code).tap do |challenge|
+      if purpose != :sign_in || Identity.exists?(email_address: email_address)
+        EmailCodeMailer.verification(challenge).deliver_later
+      end
+    end
+  end
+
+  def self.consume(token, code)
+    challenge = find_signed(token, purpose: :email_authentication)
+    if challenge && ActiveSupport::SecurityUtils.secure_compare(challenge.code, code.to_s.strip.upcase)
+      # Only the request that deletes the still-valid challenge may start a session.
+      challenge if where(id: challenge.id).where("created_at > ?", LIFETIME.ago).delete_all == 1
+    end
+  end
+
+  def pending_token
+    signed_id(expires_at: created_at + LIFETIME, purpose: :email_authentication)
+  end
+
+  # Derive the code so neither the database nor mail job arguments contain it.
+  def code
+    key = Rails.application.key_generator.generate_key("Fizzy email authentication code")
+    OpenSSL::HMAC.hexdigest("SHA256", key, id).first(6).upcase
+  end
+end
