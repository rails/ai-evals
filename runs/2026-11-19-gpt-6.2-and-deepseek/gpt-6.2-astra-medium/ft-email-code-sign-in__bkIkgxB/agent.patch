diff --git a/test/integration/email_authentication_test.rb b/test/integration/email_authentication_test.rb
new file mode 100644
index 0000000..ad574aa
--- /dev/null
+++ b/test/integration/email_authentication_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class EmailAuthenticationTest < ActionDispatch::IntegrationTest
+  test "sign in with the emailed code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      perform_enqueued_jobs { post session_path, params: { email_address: identity.email_address } }
+      follow_redirect!
+      assert_select 'form input[name="code"]'
+
+      post session_magic_link_path, params: { code: emailed_code(identity.email_address) }
+      assert_redirected_to landing_url
+      assert_equal identity, Session.find_signed!(parsed_cookies.signed[:session_token]).identity
+    end
+  end
+
+  test "sign up after proving ownership and submitting a name" do
+    email = "new-person@example.com"
+    untenanted do
+      assert_no_difference [ "Identity.count", "Account.count" ] do
+        perform_enqueued_jobs { post signup_path, params: { signup: { email_address: email } } }
+        assert_redirected_to new_session_magic_link_path
+      end
+      assert_difference "Identity.count" do
+        post session_magic_link_path, params: { code: emailed_code(email) }
+      end
+      assert_redirected_to new_signup_completion_path
+      assert_difference "Account.count" do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+      assert Identity.find_by!(email_address: email).users.sole.owner?
+    end
+  end
+
+  test "join after proving ownership" do
+    email = "new-member@example.com"
+    invitation = account_join_codes(:"37s")
+    assert_no_difference [ "User.count", "Identity.count", "invitation.reload.usage_count" ] do
+      perform_enqueued_jobs { post join_path(code: invitation.code), params: { email_address: email } }
+    end
+    untenanted do
+      assert_redirected_to new_session_magic_link_path
+      assert_difference [ "User.count", "Identity.count", "invitation.reload.usage_count" ] do
+        post session_magic_link_path, params: { code: emailed_code(email) }
+      end
+      assert_redirected_to new_users_verification_url(script_name: invitation.account.slug)
+      assert invitation.account.users.exists?(identity: Identity.find_by!(email_address: email))
+    end
+  end
+
+  test "a reset invitation cannot be used to finish joining" do
+    email = "new-member@example.com"
+    invitation = account_join_codes(:"37s")
+    perform_enqueued_jobs { post join_path(code: invitation.code), params: { email_address: email } }
+    invitation.reset
+    untenanted do
+      assert_no_difference [ "User.count", "Identity.count", "Session.count" ] do
+        post session_magic_link_path, params: { code: emailed_code(email) }
+      end
+      assert_response :gone
+    end
+  end
+
+  test "JSON verification needs both the pending token and correct code, and succeeds only once" do
+    identity = identities(:kevin)
+    untenanted do
+      perform_enqueued_jobs { post session_path, params: { email_address: identity.email_address }, as: :json }
+      assert_response :created
+      token = response.parsed_body.fetch("pending_authentication_token")
+      code = emailed_code(identity.email_address)
+
+      cookies.delete("pending_authentication_token")
+      assert_no_difference "Session.count" do
+        post session_magic_link_path, params: { code: code }, as: :json
+        assert_response :unauthorized
+        cookies[:pending_authentication_token] = token
+        post session_magic_link_path, params: { code: "wrong!" }, as: :json
+        assert_response :unauthorized
+      end
+      travel 14.minutes + 59.seconds do
+        post session_magic_link_path, params: { code: code }, as: :json
+        assert_response :success
+        assert_equal cookies[:session_token], response.parsed_body.fetch("session_token")
+        cookies[:pending_authentication_token] = token
+        assert_no_difference "Session.count" do
+          post session_magic_link_path, params: { code: code }, as: :json
+          assert_response :unauthorized
+        end
+      end
+    end
+  end
+
+  test "code expires after fifteen minutes" do
+    identity = identities(:kevin)
+    untenanted do
+      perform_enqueued_jobs { post session_path, params: { email_address: identity.email_address }, as: :json }
+      token = response.parsed_body.fetch("pending_authentication_token")
+      travel 15.minutes + 1.second do
+        cookies[:pending_authentication_token] = token
+        assert_no_difference "Session.count" do
+          post session_magic_link_path, params: { code: emailed_code(identity.email_address) }, as: :json
+          assert_response :unauthorized
+        end
+      end
+    end
+  end
+
+  test "requesting sign-in for an unknown address does not sign it up or reveal whether it exists" do
+    untenanted do
+      assert_no_difference [ "Identity.count", "Session.count", "ActionMailer::Base.deliveries.size" ] do
+        perform_enqueued_jobs { post session_path, params: { email_address: "unknown@example.com" } }
+      end
+      assert_redirected_to new_session_magic_link_path
+    end
+  end
+
+  private
+    def emailed_code(address)
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ address ], mail.to
+      mail.subject.match(/\b[A-Z0-9]{6}\b/)[0]
+    end
+end
