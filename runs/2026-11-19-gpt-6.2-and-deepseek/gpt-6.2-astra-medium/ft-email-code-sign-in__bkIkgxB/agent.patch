+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+  <p>Enter the six-character code from your email. It expires in 15 minutes.</p>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium" do |form| %>
+    <%= form.label :code, "Verification code" %>
+    <%= form.text_field :code, required: true, autofocus: true, maxlength: 6, autocomplete: "one-time-code", class: "input txt-large" %>
+    <%= form.submit "Continue", class: "btn btn--link center" %>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
