diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..b1e9db6
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,26 @@
+<% @page_title = "Search cards" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide center-block">
+  <%= form_with url: search_path, method: :get, role: "search" do |form| %>
+    <%= form.label :q, "Search cards" %>
+    <%= form.search_field :q, value: @search.query, class: "input" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @page %>
+    <div id="search-results">
+      <% if @page.empty? %>
+        <p>No matching cards.</p>
+      <% else %>
+        <%= with_manual_pagination :search_results, @page do %>
+          <%= render partial: "result", collection: @page.records, as: :card, locals: { query: @search.query, comment_texts: @comment_texts } %>
+        <% end %>
+      <% end %>
+    </div>
+  <% end %>
+</section>
