diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..5230df6
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "finds and highlights matching card content once per card, newest first" do
+    cards(:logo).update!(title: "<script>Needle</script>", created_at: 1.day.ago)
+    cards(:text).update!(description: "<p>Find the <b>nee</b>dle here.</p>", created_at: 2.days.ago)
+    comments(:layout_overflowing_david).update!(body: "A NEEDLE in a haystack")
+    comments(:layout_1).update!(body: "Another needle")
+
+    get search_path, params: { q: "needle" }
+    assert_response :success
+    assert_equal [ :logo, :text, :layout ].map { |name| card_path(cards(name)) }, css_select("#search-results article a").pluck("href")
+    assert_select "article a mark", text: "Needle"
+    assert_select "article a script", count: 0
+    assert_select "article p mark", text: "needle", minimum: 1
+    assert_select "article p mark", text: "NEEDLE"
+  end
+
+  test "comments follow current board access and publication status" do
+    card = cards(:layout)
+    card.update!(board: boards(:private))
+    get search_path, params: { q: "overflowing" }
+    assert_select "article a[href=?]", card_path(card)
+
+    accesses(:private_kevin).destroy!
+    get search_path, params: { q: "overflowing" }
+    assert_select "article", count: 0
+
+    card.update_columns(board_id: boards(:writebook).id, status: :drafted, title: "Overflowing")
+    get search_path, params: { q: "overflowing" }
+    assert_select "article", count: 0
+  end
+
+  test "comment edits and deletions are reflected in literal search results" do
+    comment = comments(:layout_overflowing_david)
+    comment.update!(body: "Progress is 10%_done!")
+
+    get search_path, params: { q: "overflowing" }
+    assert_select "article", count: 0
+    get search_path, params: { q: "%_done!" }
+    assert_select "article mark", text: "%_done!"
+
+    comment.destroy!
+    get search_path, params: { q: "%_done!" }
+    assert_select "article", count: 0
+  end
+
+  test "does not find another account's cards" do
+    get search_path, params: { q: cards(:radio).title }
+    assert_response :success
+    assert_select "article", count: 0
+  end
+
+  test "blank and literal wildcard queries do not list all cards" do
+    [ nil, " ", "%", "_" ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_select "article", count: 0
+    end
+  end
+end
