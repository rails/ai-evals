diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..5ec78c5
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,34 @@
+class Card::Search
+  attr_reader :query
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.strip
+  end
+
+  def cards
+    visible = @user.accessible_cards.published
+    visible.where("cards.title LIKE ? ESCAPE '!'", pattern)
+      .or(visible.where(id: matching_texts.where(record_type: "Card", name: "description").select(:record_id)))
+      .or(visible.where(id: matching_comments.select(:card_id)))
+      .reverse_chronologically.with_rich_text_description
+  end
+
+  def comment_texts_for(cards)
+    matching_comments.where(card_id: cards.map(&:id)).pluck(:card_id, "action_text_rich_texts.search_text")
+      .group_by(&:first).transform_values { |pairs| pairs.map(&:last) }
+  end
+
+  private
+    def matching_comments
+      Comment.joins(:rich_text_body).merge(matching_texts)
+    end
+
+    def matching_texts
+      ActionText::RichText.where(account_id: @user.account_id).where("search_text LIKE ? ESCAPE '!'", pattern)
+    end
+
+    def pattern
+      @pattern ||= "%#{Card.sanitize_sql_like(query, "!")}%"
+    end
+end
