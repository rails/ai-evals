index 0000000..ac37e03
--- /dev/null
+++ b/db/migrate/20241106000000_link_sign_in_events_to_users.rb
@@ -0,0 +1,17 @@
+class LinkSignInEventsToUsers < ActiveRecord::Migration[8.0]
+  def change
+    add_reference :sign_in_events, :user, foreign_key: true
+
+    reversible do |direction|
+      direction.up do
+        execute <<~SQL
+          UPDATE sign_in_events SET user_id = (
+            SELECT users.id FROM users
+            WHERE users.email_address = sign_in_events.email_address
+              AND users.created_at <= sign_in_events.created_at
+          )
+        SQL
+      end
+    end
+  end
+end
