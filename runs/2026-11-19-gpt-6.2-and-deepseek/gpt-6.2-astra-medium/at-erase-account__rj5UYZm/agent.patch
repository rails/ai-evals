diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..0697a9b
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "erasing a creator removes private content, including revisions, uploads and search rows" do
+    user = users(:kevin)
+    book = books(:handbook)
+    book.update!(creator: user, everyone_access: false, published: true)
+    kept_book = books(:manual)
+    kept_book.update!(creator: user, author: user.name, cover: pictures(:reading).image.blob)
+    leaf = leaves(:welcome_page)
+    old_page = leaf.page
+    old_page.body.uploads.attach(io: StringIO.new("private"), filename: "private.txt")
+    blob = old_page.body.uploads.first.blob
+    leaf.edit(leafable_params: { body: "private revision" })
+    leaf.trashed!
+    Leaf.reindex_all
+    assert Leaf.search("private revision").exists?
+    user.sessions.create!
+    ReadingMark.remember(leaf, user: users(:jz))
+
+    perform_enqueued_jobs { user.destroy! }
+
+    assert_not Book.exists?(book.id)
+    assert_empty Leaf.where(book: book)
+    assert_empty Edit.where(leaf: leaf)
+    assert_not Page.exists?(old_page.id)
+    assert_not Page.exists?(leaf.leafable_id)
+    assert_not ActionText::Markdown.exists?(record: old_page)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+    assert_empty Leaf.connection.select_values("SELECT rowid FROM leaf_search_index")
+    assert_not ReadingMark.exists?(leaf: leaf)
+    assert_not Access.exists?(user: user)
+    assert_not Session.exists?(user: user)
+    assert_not SignInEvent.exists?(email_address: user.email_address)
+    assert_equal "Deleted author", kept_book.reload.author
+    assert kept_book.cover.blob.service.exist?(kept_book.cover.key)
+  end
+
+  test "erasure removes events from before a profile email change" do
+    user = users(:kevin)
+    user.sessions.create!
+    event = user.sign_in_events.sole
+    user.update!(email_address: "new@example.com")
+    user.destroy!
+    assert_not SignInEvent.exists?(event.id)
+  end
+
+  test "legacy erasure preserves sign-ins after the original address was reclaimed" do
+    user = users(:kevin)
+    email = user.email_address
+    user.update!(active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com")
+    replacement = User.create!(name: "Another Kevin", email_address: email, password: "secret123456")
+    event = SignInEvent.create!(email_address: email, action: :signed_in)
+
+    user.destroy!
+
+    assert User.exists?(replacement.id)
+    assert SignInEvent.exists?(event.id)
+  end
+
+  test "everyone books remain accessible and searchable without their creator" do
+    user = users(:kevin)
+    book = books(:handbook)
+    book.update!(creator: user, author: user.name)
+    ReadingMark.remember(leaves(:welcome_page), user: user)
+    Leaf.reindex_all
+
+    user.destroy!
+
+    assert_nil book.reload.creator
+    assert_equal "Deleted author", book.author
+    assert book.accessable?(user: users(:jz))
+    assert_includes book.leaves.search("great handbook"), leaves(:welcome_page)
+    assert_not ReadingMark.exists?(user: user)
+
+    Current.set(user: users(:david)) { book.update!(subtitle: "Still editable") }
+    assert_nil book.reload.creator
+  end
+end
