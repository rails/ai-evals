@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create!(title: "Busy card", status: :published)
+  end
+
+  test "assignment followed by two quiet weeks stalls a card until new activity" do
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks - 1.second
+    assert_not @card.reload.stalled?
+    travel 1.second
+    assert @card.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.steps.create!(content: "Next step")
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "reopening counts as a burst but closing does not show a stalled card" do
+    @card.close
+    @card.reopen
+    travel 2.weeks
+    assert @card.reload.stalled?
+    @card.close
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "a comment burst needs three human comments and two participants inside the board window" do
+    comment_by :jz
+    travel (@card.auto_postpone_period / 3).seconds + 1.second
+    2.times { comment_by :kevin }
+    comment_by :system
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+
+    comment_by :kevin
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+
+    comment_by :jz
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "backdated comments at the edge of the inherited account window count" do
+    @card.board.entropy.destroy!
+    @card.reload
+    oldest = Time.current - @card.account.entropy.auto_postpone_period / 3
+    comment_by :kevin
+    comment_by :kevin
+    @card.comments.create!(creator: users(:david), body: "Earlier", created_at: oldest)
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "editing the description restarts the inactivity period" do
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks
+    @card.update!(description: "A new approach")
+    assert_not @card.reload.stalled?
+    travel 2.weeks
+    assert @card.stalled?
+  end
+
+  private
+    def comment_by(user)
+      @card.comments.create!(creator: users(user), body: "Comment")
+    end
+end
