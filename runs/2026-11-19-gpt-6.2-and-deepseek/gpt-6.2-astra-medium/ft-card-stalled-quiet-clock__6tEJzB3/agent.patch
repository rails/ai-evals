new file mode 100644
index 0000000..cd02170
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,30 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks.in_seconds
+
+  included do
+    scope :stalled, -> { active.where(had_burst: true, last_active_at: ..(Time.current - STALL_PERIOD)) }
+  end
+
+  def stalls_at
+    last_active_at + STALL_PERIOD if had_burst? && active?
+  end
+
+  def stalled?
+    had_burst? && active? && last_active_at <= Time.current - STALL_PERIOD
+  end
+
+  def comment_burst?(around: nil)
+    window = auto_postpone_period / 3
+    candidates = comments.by_user
+    candidates = candidates.where(created_at: (around - window)..(around + window)) if around
+
+    activity = candidates.order(:created_at, :id).pluck(:created_at, :creator_id)
+
+    # Any qualifying window contains a consecutive triple with two different authors.
+    activity.each_cons(3).any? do |(start_at, first_author), (_, middle_author), (end_at, last_author)|
+      end_at - start_at <= window && (first_author != middle_author || middle_author != last_author)
+    end
+  end
+end
