--- /dev/null
+++ b/app/models/concerns/storage_usage_source.rb
@@ -0,0 +1,16 @@
+module StorageUsageSource
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy { StorageUsage.lock.find_by(record: self)&.destroy! }
+  end
+
+  def refresh_storage_usage_later
+    # A rich-text edit can create/destroy many attachments in one transaction.
+    transaction_id = self.class.current_transaction.uuid
+    unless transaction_id && transaction_id == @storage_usage_refresh_transaction
+      RefreshStorageUsageJob.perform_later(self)
+      @storage_usage_refresh_transaction = transaction_id
+    end
+  end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..91a039e
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,62 @@
+# One subtotal per nonempty card (including its comments) or board description.
+# Serialize refreshes on the source, not the account. Update the board counter in
+# the same transaction so concurrent changes and job retries do not lose bytes.
+class StorageUsage < ApplicationRecord
+  belongs_to :record, polymorphic: true
+
+  after_save :adjust_board_totals
+  after_destroy { adjust_board(board_id, -bytes_used) }
+
+  def self.refresh(source)
+    transaction do
+      # The source can disappear between enqueue (or a backfill batch) and execution.
+      next unless record = source.class.lock.find_by(id: source.id)
+
+      bytes = bytes_for(record)
+      usage = find_by(record: record)
+
+      if bytes.positive?
+        usage ||= new(record: record)
+        usage.update!(board_id: record.is_a?(Card) ? record.board_id : record.id, bytes_used: bytes)
+      else
+        usage&.destroy!
+      end
+    end
+  end
+
+  class << self
+    private
+      def bytes_for(record)
+        if record.is_a?(Card)
+          image = ActiveStorage::Attachment.where(record: record, name: "image")
+          description = ActionText::RichText.where(record: record, name: "description")
+          comments = ActionText::RichText.where(record_type: "Comment", record_id: record.comments.select(:id), name: "body")
+          attachment_bytes(image) + embedded_bytes(description) + embedded_bytes(comments)
+        else
+          embedded_bytes(ActionText::RichText.where(record: record, name: "public_description"))
+        end
+      end
+
+      def embedded_bytes(rich_texts)
+        attachment_bytes(ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_texts.select(:id), name: "embeds"))
+      end
+
+      def attachment_bytes(attachments)
+        attachments.joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+  end
+
+  private
+    def adjust_board_totals
+      if board_id_before_last_save == board_id
+        adjust_board(board_id, bytes_used - bytes_used_before_last_save)
+      else
+        adjust_board(board_id_before_last_save, -bytes_used_before_last_save.to_i)
+        adjust_board(board_id, bytes_used)
+      end
+    end
+
+    def adjust_board(id, delta)
+      Board.update_counters(id, storage_bytes: delta) if id && !delta.zero?
+    end
+end
