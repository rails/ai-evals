index 0000000..59331c5
--- /dev/null
+++ b/app/jobs/rebuild_storage_usage_job.rb
@@ -0,0 +1,21 @@
+# Backfill existing installations (or an account whose attachments were bulk imported).
+# Safe to resume or rerun alongside incremental refreshes.
+class RebuildStorageUsageJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked
+
+  def perform(account = nil)
+    [ Board, Card ].each do |model|
+      step model.table_name.to_sym do |step|
+        records = account ? model.where(account: account) : model.all
+        records.select(:id).find_each(start: step.cursor) do |record|
+          StorageUsage.refresh(record)
+          step.set! record.id
+        end
+      end
+    end
+  end
+end
