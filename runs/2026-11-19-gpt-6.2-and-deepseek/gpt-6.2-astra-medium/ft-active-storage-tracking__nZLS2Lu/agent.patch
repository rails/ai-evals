diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..15eaf4d
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @account = @board.account
+    @comment = comments(:logo_agreement_jz)
+    @blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("12345"), filename: "five.txt")
+    @embed = ActionText::Attachment.from_attachable(@blob).to_html
+  end
+
+  test "counts each image and embed on its own board but not avatars or unattached blobs" do
+    Current.user.avatar.attach(@blob)
+    ActionText::RichText.create!(record: @board, name: "unrelated", body: @embed)
+    assert_usage 0
+
+    @board.update!(public_description: @embed)
+    @card.image.attach(@blob)
+    @card.update!(description: @embed)
+    @comment.update!(body: @embed)
+    assert_usage 20
+    assert_equal 0, accounts(:initech).bytes_used
+    assert_equal 0, boards(:private).bytes_used
+
+    # Replayed jobs read the current state, rather than applying a delta twice.
+    2.times { @card.refresh_storage_usage_later }
+    assert_usage 20
+
+    @card.image.purge_later
+    @board.update!(public_description: "No more embeds")
+    @card.update!(description: "No more embeds")
+    assert_usage 5
+
+    @comment.destroy!
+    assert_usage 0
+  end
+
+  test "moving and deleting a card transfers then removes all its contributions" do
+    @card.image.attach(@blob)
+    @comment.update!(body: @embed)
+    @board.update!(public_description: @embed)
+    assert_usage 15
+
+    @card.move_to(boards(:private))
+    assert_usage 5, account: 15
+    assert_equal 10, boards(:private).bytes_used
+
+    @card.destroy!
+    assert_usage 5
+    @board.destroy!
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "moving a comment to another card transfers its embeds" do
+    other_card = cards(:layout)
+    other_card.move_to(boards(:private))
+    @comment.update!(body: @embed)
+    assert_usage 5
+
+    @comment.update!(card: other_card)
+    assert_usage 0, account: 5
+    assert_equal 5, boards(:private).bytes_used
+  end
+
+  test "replacement, single and bulk detachment" do
+    @card.image.attach(@blob)
+    @card.update!(description: @embed)
+    assert_usage 10
+
+    @card.image.attach(io: StringIO.new("12"), filename: "two.txt")
+    assert_usage 7
+    @card.image.detach
+    @card.rich_text_description.embeds.detach
+    assert_usage 0
+  end
+
+  test "backfill accounts for preexisting attachments exactly once" do
+    @board.update!(public_description: @embed)
+    @card.image.attach(@blob)
+    clear_enqueued_jobs
+
+    assert_usage 0
+    2.times { RebuildStorageUsageJob.perform_now(@account) }
+    assert_usage 10
+  end
+
+  test "one rich-text edit with multiple files only needs one refresh" do
+    other_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("678"), filename: "three.txt")
+    assert_enqueued_jobs 1, only: RefreshStorageUsageJob do
+      @card.update!(description: @embed + ActionText::Attachment.from_attachable(other_blob).to_html)
+    end
+    assert_usage 8
+  end
+
+  test "uses 64-bit byte counts" do
+    @blob.update_column(:byte_size, 5.gigabytes)
+    @card.image.attach(@blob)
+    assert_usage 5.gigabytes
+  end
+
+  test "rolled back attachment changes are not counted" do
+    Card.transaction do
+      @card.image.attach(@blob)
+      raise ActiveRecord::Rollback
