diff --git a/test/controllers/accounts_controller_test.rb b/test/controllers/accounts_controller_test.rb
index 8292c6f..962855e 100644
--- a/test/controllers/accounts_controller_test.rb
+++ b/test/controllers/accounts_controller_test.rb
@@ -58,4 +58,20 @@ class AccountsControllerTest < ActionDispatch::IntegrationTest
     put account_url, params: { account: { name: "Different" } }
     assert_response :forbidden
   end
+
+  test "only administrators see the bots per member setting" do
+    get edit_account_url
+    assert_select "label[for=account_settings_bots_per_member]", text: "Bots per member"
+    assert_select "input#account_settings_bots_per_member[type=number][value='5']"
+
+    patch account_url, params: { account: { settings: { bots_per_member: "2" } } }
+    assert_redirected_to edit_account_url
+    assert_equal 2, accounts(:signal).reload.settings.bots_per_member
+
+    sign_in :kevin
+    get edit_account_url
+    assert_select "input#account_settings_bots_per_member", count: 0
+    patch account_url, params: { account: { settings: { bots_per_member: "3" } } }
+    assert_response :forbidden
+  end
 end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
index 189014e..6b44f8b 100644
--- a/test/controllers/bots_controller_test.rb
+++ b/test/controllers/bots_controller_test.rb
@@ -56,4 +56,26 @@ class BotsControllerTest < ActionDispatch::IntegrationTest
       assert_response :unprocessable_entity
     end
   end
+
+  test "members at the limit cannot add a bot until they delete one" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    bot = users(:jz).created_bots.create!(name: "First")
+
+    get bots_url
+    assert_select "a[href=?]", new_bot_path, count: 0
+    assert_select "p", text: /reached the limit/
+    get new_bot_url
+    assert_redirected_to bots_url
+    assert_no_difference [ "Bot.count", "User.count" ] do
+      post bots_url, params: { bot: { name: "Extra" } }
+      assert_response :unprocessable_entity
+    end
+
+    delete bot_url(bot)
+    get bots_url
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+    assert_difference "Bot.count" do
+      post bots_url, params: { bot: { name: "Replacement" } }
+    end
+  end
 end
diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
index 9ceb55b..4927e57 100644
--- a/test/models/bot_test.rb
+++ b/test/models/bot_test.rb
@@ -19,4 +19,16 @@ class BotTest < ActiveSupport::TestCase
     assert_not_includes second.users, bot.user
     assert_includes second.users, users(:david)
   end
+
+  test "lowering the limit blocks only new member bots" do
+    bot = users(:jz).created_bots.create!(name: "First")
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    assert users(:kevin).created_bots.create!(name: "Another member’s bot").persisted?
+
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+    assert bot.reload.update(name: "Renamed")
+    assert_not users(:jz).created_bots.create(name: "Extra").persisted?
+    assert users(:david).created_bots.create!(name: "Admin bot").persisted?
+  end
 end
