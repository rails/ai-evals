+class Bot::JoinedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(join)
+    bot, room = join.bot, join.room
+    if bot.webhook_url? && !room.direct? && room.users.active.exists?(bot.user_id)
+      Bot::Webhook.new(bot, room: room).deliver
+    end
+  end
+end
