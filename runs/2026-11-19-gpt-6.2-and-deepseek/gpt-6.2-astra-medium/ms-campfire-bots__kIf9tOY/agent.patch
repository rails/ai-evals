diff --git a/test/jobs/bot/joined_job_test.rb b/test/jobs/bot/joined_job_test.rb
new file mode 100644
index 0000000..5835628
--- /dev/null
+++ b/test/jobs/bot/joined_job_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Bot::JoinedJobTest < ActiveSupport::TestCase
+  setup do
+    @bot = Bot.create!(creator: users(:jz), name: "Hello Bot", webhook_url: "https://bot.example.com/events")
+    @room = rooms(:designers)
+  end
+
+  test "greets a manually granted room only once" do
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).returns("93.184.216.34")
+    request = stub_request(:post, @bot.webhook_url).with(body: {
+      event: "joined", room: { id: @room.id, name: @room.name, reply_to: "/rooms/#{@room.id}/#{@bot.code}/messages" }
+    }).to_return(status: 200, headers: { "Content-Type" => "text/html" }, body: "<strong>Hello!</strong>")
+
+    perform_enqueued_jobs only: Bot::JoinedJob do
+      @room.memberships.grant_to @bot.user
+      @room.memberships.grant_to @bot.user
+      @room.memberships.revoke_from @bot.user
+      @room.memberships.grant_to @bot.user
+    end
+    assert_requested request, times: 1
+    assert_equal @bot.user, @room.messages.last.creator
+    assert_includes @room.messages.last.body.to_s, "<strong>Hello!</strong>"
+  end
+
+  test "automatic grants enqueue joined events for new memberships only" do
+    rooms(:hq).memberships.grant_to @bot.user
+    assert_enqueued_jobs Rooms::Open.count - 1, only: Bot::JoinedJob do
+      @bot.update!(add_to_all_open_rooms: true)
+    end
+    assert_enqueued_jobs 1, only: Bot::JoinedJob do
+      Rooms::Open.create!(name: "Ops", creator: users(:jz))
+    end
+  end
+
+  test "opting in at bot creation notifies each existing open room" do
+    assert_enqueued_jobs Rooms::Open.count, only: Bot::JoinedJob do
+      Bot.create!(creator: users(:jz), name: "Helper", webhook_url: @bot.webhook_url, add_to_all_open_rooms: true)
+    end
+  end
+
+  test "a revoked membership cannot deliver a queued greeting" do
+    @room.memberships.grant_to @bot.user
+    @room.memberships.revoke_from @bot.user
+    perform_enqueued_jobs only: Bot::JoinedJob
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "direct conversations never enqueue joined events" do
+    assert_no_enqueued_jobs only: Bot::JoinedJob do
+      Rooms::Direct.create_for({ creator: users(:jz) }, users: [ users(:jz), @bot.user ])
+    end
+  end
+end
diff --git a/test/jobs/bot/mention_job_test.rb b/test/jobs/bot/mention_job_test.rb
new file mode 100644
index 0000000..d55a7d9
--- /dev/null
+++ b/test/jobs/bot/mention_job_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Bot::MentionJobTest < ActiveSupport::TestCase
+  setup do
+    @url = "https://bot.example.com/events"
+    @bot = Bot.create!(creator: users(:jz), name: "Build Bot", webhook_url: @url)
+    @room = rooms(:hq)
+    @room.memberships.grant_to @bot.user
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("bot.example.com").returns("93.184.216.34")
+  end
+
+  test "delivers the mention in a job and posts the plain text reply as the bot" do
+    message = mention_bot
+    request = stub_request(:post, @url).with(headers: { "Content-Type" => "application/json" }) do |req|
+      payload = JSON.parse(req.body)
+      assert_equal "mention", payload["event"]
+      assert_equal({ "id" => users(:david).id, "name" => "David" }, payload["author"])
+      assert_equal({ "id" => @room.id, "name" => @room.name, "reply_to" => "/rooms/#{@room.id}/#{@bot.code}/messages" }, payload["room"])
+      assert_equal message.id, payload.dig("message", "id")
+      assert_equal "/rooms/#{@room.id}/@#{message.id}", payload.dig("message", "link")
+      assert_equal "build for @David", payload.dig("message", "body", "text")
+      assert_includes payload.dig("message", "body", "html"), "<strong>build</strong>"
+      true
+    end.to_return(status: 200, headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "ok <1>\nready")
+
+    perform_enqueued_jobs only: Bot::MentionJob
+    assert_requested request, times: 1
+    reply = @room.messages.last
+    assert_equal @bot.user, reply.creator
+    assert_equal "ok <1>\nready", reply.plain_text_body
+  end
+
+  test "posts an HTML reply as rich text" do
+    mention_bot
+    stub_request(:post, @url).to_return(status: 200, headers: { "Content-Type" => "text/html" }, body: "<strong>ready</strong>")
+    perform_enqueued_jobs only: Bot::MentionJob
+    assert_includes @room.messages.last.body.to_s, "<strong>ready</strong>"
+  end
+
+  [ [ 204, "text/plain" ], [ 200, "application/json" ], [ 500, "text/plain" ] ].each do |status, type|
+    test "ignores a #{status} #{type} response" do
+      mention_bot
+      request = stub_request(:post, @url).to_return(status: status, headers: { "Content-Type" => type }, body: "ignored")
+      assert_no_difference "Message.count" do
+        perform_enqueued_jobs only: Bot::MentionJob
+      end
+      assert_requested request
+    end
+  end
+
+  test "does not post to a blocked destination" do
+    message = mention_bot
+    RestrictedHTTP::PrivateNetworkGuard.expects(:resolve).with("bot.example.com").raises(RestrictedHTTP::Violation)
+    assert_raises(RestrictedHTTP::Violation) { Bot::MentionJob.perform_now(@bot, message) }
+    assert_not_requested :post, @url
+  end
+
+  test "removing the webhook disables queued and future callbacks" do
+    mention_bot
+    @bot.update!(webhook_url: "")
+    perform_enqueued_jobs only: Bot::MentionJob
+    assert_not_requested :post, @url
+    assert_no_enqueued_jobs only: Bot::MentionJob do
+      mention_bot
+    end
+  end
+
+  test "membership is checked before delivery" do
+    mention_bot
+    @room.memberships.revoke_from @bot.user
+    perform_enqueued_jobs only: Bot::MentionJob
+    assert_not_requested :post, @url
+    assert_no_enqueued_jobs only: Bot::MentionJob do
+      mention_bot
+    end
+  end
+
+  test "any 2xx resets the failure streak and ten consecutive failures stop deliveries" do
+    message = mention_bot
+    deliver = -> { Bot::MentionJob.perform_now(@bot, message) }
+    stub_request(:post, @url).to_return(status: 302)
+    9.times { deliver.call }
+    assert_not @bot.reload.suspended?
+
+    stub_request(:post, @url).to_return(status: 202)
+    deliver.call
+    stub_request(:post, @url).to_timeout
+    deliver.call
+    stub_request(:post, @url).to_raise(Errno::ECONNREFUSED)
+    deliver.call
+    stub_request(:post, @url).to_return(status: 500)
+    7.times { deliver.call }
+    assert_not @bot.reload.suspended?
+    deliver.call
+    assert_equal "Repeated webhook failures", @bot.reload.suspension_reason
+
+    # Both the join and the mention were already queued before suspension.
+    perform_enqueued_jobs only: [ Bot::MentionJob, Bot::JoinedJob ]
+    assert_requested :post, @url, times: 20
+    assert_no_enqueued_jobs only: Bot::MentionJob do
+      mention_bot
+    end
+  end
+
+  private
+    def mention_bot
+      mention = %(<action-text-attachment sgid="#{@bot.user.attachable_sgid}"></action-text-attachment>)
+      @room.messages.create!(creator: users(:david), body: "#{mention}&nbsp;<strong>build</strong> for #{mention_attachment_for(:david)} #{mention}")
+    end
+end
