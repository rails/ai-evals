diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..9115296
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,41 @@
+class Bot < ApplicationRecord
+  include Moderation
+
+  belongs_to :creator, class_name: "User"
+  belongs_to :user, autosave: true
+
+  delegate :name, :name=, :avatar, :avatar=, to: :identity
+  validates :name, presence: true
+  validate :within_creator_limit, on: :create
+  normalizes :webhook_url, with: ->(url) { url.strip.presence }
+  validate :webhook_url_is_http, if: :webhook_url?
+
+  scope :selective, -> { where(add_to_all_open_rooms: false) }
+
+  after_save :join_open_rooms, if: -> { saved_change_to_add_to_all_open_rooms?(to: true) }
+  before_destroy -> { user.deactivate }
+
+  def code
+    signed_id(purpose: :post_messages)
+  end
+
+  private
+    def within_creator_limit
+      errors.add(:base, "You’ve reached the limit for chat bots.") if creator&.bot_limit_reached?
+    end
+
+    def join_open_rooms
+      Rooms::Open.find_each { |room| room.memberships.grant_to(user) }
+    end
+
+    def webhook_url_is_http
+      uri = URI.parse(webhook_url)
+      errors.add(:webhook_url, :invalid) unless uri.is_a?(URI::HTTP) && uri.host.present?
+    rescue URI::InvalidURIError
+      errors.add(:webhook_url, :invalid)
+    end
+
+    def identity
+      user || build_user(password: SecureRandom.base58(48))
+    end
+end
diff --git a/app/models/bot/moderation.rb b/app/models/bot/moderation.rb
new file mode 100644
index 0000000..50db080
--- /dev/null
+++ b/app/models/bot/moderation.rb
@@ -0,0 +1,79 @@
+module Bot::Moderation
+  extend ActiveSupport::Concern
+
+  POST_LIMIT = 10
+  POST_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  PostResult = Struct.new(:status, :message, :retry_after, keyword_init: true)
+
+  included do
+    scope :with_enabled_webhook, -> { where(suspension_reason: nil).where.not(webhook_url: nil) }
+  end
+
+  def suspended?
+    suspension_reason.present?
+  end
+
+  def reactivate!
+    with_lock do
+      if suspended?
+        update!(suspension_reason: nil, cooldown_until: nil, cooldown_attempts: 0, recent_post_times: [], webhook_failures: 0)
+      end
+    end
+  end
+
+  def post_message(room, body:)
+    result = with_lock do
+      now = Time.current
+      if suspended?
+        PostResult.new(status: :forbidden)
+      elsif cooldown_until && cooldown_until > now
+        record_cooldown_attempt(now)
+      elsif body.blank?
+        PostResult.new(status: :unprocessable_entity)
+      else
+        post_within_limit(room, body, now)
+      end
+    end
+    result.message&.broadcast_create
+    result
+  end
+
+  def record_webhook_delivery(success:)
+    with_lock do
+      unless suspended?
+        self.webhook_failures = success ? 0 : webhook_failures + 1
+        self.suspension_reason = "Repeated webhook failures" if webhook_failures >= WEBHOOK_FAILURE_LIMIT
+        save! if changed?
+      end
+    end
+  end
+
+  private
+    def record_cooldown_attempt(now)
+      self.cooldown_attempts += 1
+      self.suspension_reason = "Message flooding" if cooldown_attempts >= COOLDOWN_ATTEMPT_LIMIT
+      save!
+      if suspended?
+        PostResult.new(status: :forbidden)
+      else
+        PostResult.new(status: :too_many_requests, retry_after: (cooldown_until - now).ceil)
+      end
+    end
+
+    def post_within_limit(room, body, now)
+      cutoff = (now - POST_WINDOW).to_f
+      times = recent_post_times.select { |timestamp| timestamp > cutoff }
+      if times.size >= POST_LIMIT
+        update!(cooldown_until: now + COOLDOWN, cooldown_attempts: 0)
+        PostResult.new(status: :too_many_requests, retry_after: COOLDOWN.to_i)
+      else
+        message = room.messages.create!(creator: user, body: body)
+        update!(recent_post_times: times << now.to_f)
+        PostResult.new(status: :created, message: message)
+      end
+    end
+end
diff --git a/app/models/bot/room_join.rb b/app/models/bot/room_join.rb
