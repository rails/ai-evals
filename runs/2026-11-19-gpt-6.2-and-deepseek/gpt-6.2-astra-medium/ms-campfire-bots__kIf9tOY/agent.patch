--- /dev/null
+++ b/app/models/bot/room_join.rb
@@ -0,0 +1,15 @@
+# Keep the event separate from the membership so re-granting access doesn't send another greeting.
+class Bot::RoomJoin < ApplicationRecord
+  belongs_to :bot
+  belongs_to :room
+
+  after_create_commit { Bot::JoinedJob.perform_later(self) }
+
+  def self.record_for(room, user_ids)
+    unless room.direct? || user_ids.empty?
+      Bot.with_enabled_webhook.where(user_id: user_ids).find_each do |bot|
+        find_or_create_by!(bot: bot, room: room)
+      end
+    end
+  end
+end
diff --git a/app/models/bot/webhook.rb b/app/models/bot/webhook.rb
new file mode 100644
index 0000000..15effff
--- /dev/null
+++ b/app/models/bot/webhook.rb
@@ -0,0 +1,84 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class Bot::Webhook
+  include Rails.application.routes.url_helpers
+
+  MAX_REPLY_SIZE = 1.megabyte
+
+  attr_reader :bot, :room, :message
+
+  def initialize(bot, room:, message: nil)
+    @bot, @room, @message = bot, room, message
+  end
+
+  def deliver
+    bot.reload
+    return if bot.suspended? || !bot.webhook_url?
+
+    success, body = post_event
+    bot.record_webhook_delivery(success: success)
+    if body.present? && room.users.active.exists?(bot.user_id)
+      bot.post_message(room, body: body)
+    end
+  end
+
+  private
+    def post_event
+      uri = URI.parse(bot.webhook_url)
+      ip = RestrictedHTTP::PrivateNetworkGuard.resolve(uri.hostname)
+      request = Net::HTTP::Post.new(uri, "Content-Type" => "application/json")
+      request.body = payload.to_json
+
+      # Connect directly to the checked address rather than re-resolving it via a proxy.
+      Net::HTTP.start(uri.hostname, uri.port, nil, ipaddr: ip, use_ssl: uri.scheme == "https",
+          open_timeout: 5, read_timeout: 10, write_timeout: 10) do |http|
+        http.request(request) { |response| return [ response.is_a?(Net::HTTPSuccess), reply_body(response) ] }
+      end
+    rescue Timeout::Error, SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Surfguard::Unresolvable, Net::ProtocolError, Net::HTTPBadResponse
+      [ false, nil ]
+    end
+
+    def reply_body(response)
+      return unless response.is_a?(Net::HTTPOK) && response.content_type.in?(%w[ text/plain text/html ])
+
+      body = String.new(encoding: Encoding::BINARY)
+      response.read_body do |chunk|
+        return if body.bytesize + chunk.bytesize > MAX_REPLY_SIZE
+        body << chunk
+      end
+      body.force_encoding(Encoding::UTF_8)
+      return unless body.valid_encoding?
+
+      if response.content_type == "text/html"
+        ActionController::Base.helpers.sanitize(body)
+      else
+        ERB::Util.html_escape(body).gsub(/\r?\n/, "<br>")
+      end
+    end
+
+    def room_payload
+      { id: room.id, name: ApplicationController.helpers.room_display_name(room, for_user: bot.user),
+        reply_to: room_bot_messages_path(room, bot.code) }
+    end
+
+    def payload
+      return { event: "joined", room: room_payload } unless message
+
+      {
+        event: "mention",
+        author: { id: message.creator_id, name: message.creator.name },
+        room: room_payload,
+        message: {
+          id: message.id, body: { text: command, html: message.body.to_s },
+          link: room_at_message_path(room, message.id)
+        }
+      }
+    end
+
+    def command
+      message.body.body.render_attachments(with_full_attributes: false) do |attachment|
+        ERB::Util.html_escape(attachment.to_plain_text) unless attachment.attachable == bot.user
+      end.fragment.to_plain_text.gsub(/\A[[:space:]]+|[[:space:]]+\z/, "")
+    end
+end
