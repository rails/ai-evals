+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup { sign_in :jz }
+
+  test "members can create, edit and delete their bots" do
+    get edit_account_url
+    assert_select "a[href=?]", bots_path, text: /Set up chat bots/
+
+    get new_bot_url
+    assert_select "form input[required]"
+    assert_select "label[for=bot_add_to_all_open_rooms]", text: "Add to all open rooms"
+    assert_select "input#bot_add_to_all_open_rooms[type=checkbox]:not([checked])"
+    assert_select "label[for=bot_webhook_url]", text: "Webhook URL"
+    post bots_url, params: { bot: { name: "Deploy Bot", webhook_url: "https://bot.example.com/events" } }
+    assert_redirected_to bots_url
+    follow_redirect!
+    bot = Bot.last
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "input[readonly][value=?]", bot.code
+      assert_select "a[href=?]", edit_bot_path(bot), text: "Edit Deploy Bot"
+    end
+    assert_empty bot.user.rooms
+
+    get edit_bot_url(bot)
+    assert_select "input[name=?][value=?]", "bot[webhook_url]", "https://bot.example.com/events"
+    assert_select "form[data-turbo-confirm] button", text: "Delete this chat bot"
+    patch bot_url(bot), params: { bot: { name: "Build Bot", webhook_url: "", add_to_all_open_rooms: "1", avatar: fixture_file_upload("earth.png", "image/png") } }
+    assert bot.reload.avatar.attached?
+    assert_equal "Build Bot", bot.reload.name
+    assert_nil bot.webhook_url
+    assert_equal Rooms::Open.ids.sort, bot.user.room_ids.sort
+    delete bot_url(bot)
+    post "/rooms/#{rooms(:hq).id}/#{bot.code}/messages", params: "test"
+    assert_response :unauthorized
+  end
+
+  test "members cannot list or change another member's bot but admins can" do
+    post bots_url, params: { bot: { name: "Deploy Bot" } }
+    bot = Bot.last
+    sign_in :kevin
+    get bots_url
+    assert_select "input[value=?]", bot.code, count: 0
+    patch bot_url(bot), params: { bot: { name: "Changed" } }
+    assert_response :not_found
+    delete bot_url(bot)
+    assert_response :not_found
+    sign_in :david
+    get bots_url
+    assert_select "input[value=?]", bot.code
+  end
+
+  test "blank names are rejected" do
+    assert_no_difference "Bot.count" do
+      post bots_url, params: { bot: { name: " " } }
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "members at the limit cannot add a bot until they delete one" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    bot = users(:jz).created_bots.create!(name: "First")
+
+    get bots_url
+    assert_select "a[href=?]", new_bot_path, count: 0
+    assert_select "p", text: /reached the limit/
+    get new_bot_url
+    assert_redirected_to bots_url
+    assert_no_difference [ "Bot.count", "User.count" ] do
+      post bots_url, params: { bot: { name: "Extra" } }
+      assert_response :unprocessable_entity
+    end
+
+    delete bot_url(bot)
+    get bots_url
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+    assert_difference "Bot.count" do
+      post bots_url, params: { bot: { name: "Replacement" } }
+    end
+  end
+
+  test "suspended bots stay listed and only administrators can reactivate them" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    bot = users(:jz).created_bots.create!(name: "First", suspension_reason: "Message flooding",
+      cooldown_until: 30.seconds.from_now, cooldown_attempts: 5)
+    rooms(:hq).memberships.grant_to bot.user
+
+    get bots_url
+    assert_select "li p", text: "Suspended: Message flooding"
+    assert_select "button", text: "Reactivate", count: 0
+    assert_select "a[href=?]", new_bot_path, count: 0
+    post bot_reactivation_url(bot)
+    assert_response :forbidden
+    assert bot.reload.suspended?
+
+    sign_in :david
+    get bots_url
+    assert_select "form[action=?][data-turbo-confirm] button", bot_reactivation_path(bot), text: "Reactivate"
+    post bot_reactivation_url(bot)
+    assert_redirected_to bots_url
+    follow_redirect!
+    assert_select "button", text: "Reactivate", count: 0
+    post room_bot_messages_path(rooms(:hq), bot.code), params: "back"
+    assert_response :created
+  end
+end
