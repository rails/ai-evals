index 0000000..66177b7
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,31 @@
+class Bots::MessagesController < ActionController::API
+  include BlockBannedRequests, SetCurrentRequest
+
+  before_action :authenticate_bot
+
+  def create
+    room = Current.user.rooms.find_by(id: params[:room_id])
+    return head :not_found unless room
+
+    result = @bot.post_message(room, body: message_body)
+    if result.message
+      head :created, location: message_path(result.message.id)
+    else
+      response.headers["Retry-After"] = result.retry_after.to_s if result.retry_after
+      head result.status
+    end
+  end
+
+  private
+    def message_body
+      text = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+      ERB::Util.html_escape(text).gsub(/\r?\n/, "<br>") if text.valid_encoding? && text.present?
+    end
+
+    def authenticate_bot
+      @bot = Bot.find_signed(request.get_header("campfire.bot_code"), purpose: :post_messages)
+      Current.user = @bot&.user
+      return head :unauthorized unless Current.user&.active?
+      head :forbidden if @bot.suspended?
+    end
+end
