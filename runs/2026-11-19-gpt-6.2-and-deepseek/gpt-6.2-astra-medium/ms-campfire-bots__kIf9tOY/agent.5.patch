diff --git a/docs/bots.md b/docs/bots.md
index a8eae7f..45ffeef 100644
--- a/docs/bots.md
+++ b/docs/bots.md
@@ -20,3 +20,11 @@ The first time a bot with a webhook is added to a room, Campfire sends a `joined
 The `mention` event includes `author` (id and name), `room` (id, name and `reply_to`), and `message` (id, `body.text`, `body.html` and `link`). Use the text for the command, without the bot's own mention, or the HTML for the complete message. Both paths are relative to your Campfire origin. The `reply_to` path contains the bot code: keep it out of logs.
 
 Return `200` with UTF-8 `text/plain` or `text/html` to post a reply immediately. To defer a reply, return `204`, then POST plain text to `room.reply_to` as above. Deliveries run in the background; replies larger than 1 MiB are ignored.
+
+## Cooldowns and suspension
+
+A bot can post ten messages in a rolling ten-second window across all its rooms. API posts and webhook replies share this limit. The next post is rejected and starts a 30-second cooldown. Wait for the number of seconds in the API’s `Retry-After` header before retrying a `429`. Webhook replies during cooldown are dropped, not deferred. Five further posting attempts during the same cooldown suspend the bot.
+
+Ten consecutive failed webhook deliveries also suspend a bot. A non-`2xx` response, timeout, or connection error counts as a failure; any `2xx` response resets the streak, even if it contains no reply.
+
+Suspended bots receive no webhooks, and their posting endpoint returns `403`. Their memberships, messages, and place in the owner's bot limit are unchanged. The bots page shows the reason for suspension. An administrator can choose **Reactivate** there to clear the suspension and reset the counters.
diff --git a/test/controllers/bots/messages_controller_test.rb b/test/controllers/bots/messages_controller_test.rb
index a0bdf0b..d12d100 100644
--- a/test/controllers/bots/messages_controller_test.rb
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -55,6 +55,68 @@ class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
     end
   end
 
+  test "flooding starts a cooldown and five further attempts suspend the bot" do
+    freeze_time do
+      10.times do
+        post endpoint, params: "build"
+        assert_response :created
+      end
+      assert_no_difference "Message.count" do
+        post endpoint, params: "over limit"
+        assert_response :too_many_requests
+        assert_equal "30", response.headers["Retry-After"]
+        travel 12.seconds
+        [ "too soon", "again", "", "still too soon" ].each do |body|
+          post endpoint, params: body
+          assert_response :too_many_requests
+          assert_equal "18", response.headers["Retry-After"]
+        end
+        post endpoint, params: "too soon again"
+        assert_response :forbidden
+        travel 1.day
+        post endpoint, params: "still suspended"
+        assert_response :forbidden
+      end
+    end
+  end
+
+  test "API posts and webhook replies share a rolling window across rooms" do
+    other_room = rooms(:watercooler)
+    other_room.memberships.grant_to @bot.user
+    @bot.update!(webhook_url: "https://bot.example.com/events")
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).returns("93.184.216.34")
+    stub_request(:post, @bot.webhook_url).to_return(headers: { "Content-Type" => "text/plain" }, body: "reply")
+    webhook = Bot::Webhook.new(@bot, room: other_room)
+
+    freeze_time do
+      post endpoint, params: "oldest"
+      travel 6.seconds
+      9.times { post endpoint, params: "build" }
+      travel 4.seconds
+      assert_difference "Message.count", 1 do
+        webhook.deliver # Only the oldest post has aged out.
+        webhook.deliver # Starts cooldown.
+      end
+      post endpoint, params: "build"
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+      assert_no_difference "Message.count" do
+        3.times { webhook.deliver }
+      end
+      travel 30.seconds
+      post endpoint, params: "build"
+      assert_response :created
+      9.times { post endpoint, params: "build" }
+      webhook.deliver
+      webhook.deliver # Attempts from the previous cooldown must not carry over.
+      post endpoint, params: "build"
+      assert_response :too_many_requests
+      3.times { webhook.deliver }
+      post endpoint, params: "build"
+      assert_response :forbidden
+    end
+  end
+
   private
     def endpoint(room_id: @room.id, code: @bot.code)
       "/rooms/#{room_id}/#{code}/messages"
