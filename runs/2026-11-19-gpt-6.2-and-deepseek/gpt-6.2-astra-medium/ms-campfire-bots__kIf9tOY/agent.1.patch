+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup { sign_in :jz }
+
+  test "members can create, edit and delete their bots" do
+    get edit_account_url
+    assert_select "a[href=?]", bots_path, text: /Set up chat bots/
+
+    get new_bot_url
+    assert_select "form input[required]"
+    post bots_url, params: { bot: { name: "Deploy Bot" } }
+    assert_redirected_to bots_url
+    follow_redirect!
+    bot = Bot.last
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "input[readonly][value=?]", bot.code
+      assert_select "a[href=?]", edit_bot_path(bot), text: "Edit Deploy Bot"
+    end
+    assert_equal Rooms::Open.ids.sort, bot.user.room_ids.sort
+
+    get edit_bot_url(bot)
+    assert_select "form[data-turbo-confirm] button", text: "Delete this chat bot"
+    patch bot_url(bot), params: { bot: { name: "Build Bot", avatar: fixture_file_upload("earth.png", "image/png") } }
+    assert bot.reload.avatar.attached?
+    assert_equal "Build Bot", bot.reload.name
+    delete bot_url(bot)
+    post "/rooms/#{rooms(:hq).id}/#{bot.code}/messages", params: "test"
+    assert_response :unauthorized
+  end
+
+  test "members cannot list or change another member's bot but admins can" do
+    post bots_url, params: { bot: { name: "Deploy Bot" } }
+    bot = Bot.last
+    sign_in :kevin
+    get bots_url
+    assert_select "input[value=?]", bot.code, count: 0
+    patch bot_url(bot), params: { bot: { name: "Changed" } }
+    assert_response :not_found
+    delete bot_url(bot)
+    assert_response :not_found
+    sign_in :david
+    get bots_url
+    assert_select "input[value=?]", bot.code
+  end
+
+  test "blank names are rejected" do
+    assert_no_difference "Bot.count" do
+      post bots_url, params: { bot: { name: " " } }
+      assert_response :unprocessable_entity
+    end
+  end
+end
