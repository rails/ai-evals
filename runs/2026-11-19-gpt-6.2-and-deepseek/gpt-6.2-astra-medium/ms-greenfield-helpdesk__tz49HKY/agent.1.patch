@@ -0,0 +1,7 @@
+namespace :helpdesk do
+  desc "Permanently delete accounts cancelled at least 90 days ago"
+  task purge_cancelled_accounts: :environment do
+    # A conditional DELETE rechecks cancelled_at if concurrent reactivation holds the row lock.
+    Account.where(cancelled_at: ..Account::GRACE_PERIOD.ago).in_batches.delete_all
+  end
+end
