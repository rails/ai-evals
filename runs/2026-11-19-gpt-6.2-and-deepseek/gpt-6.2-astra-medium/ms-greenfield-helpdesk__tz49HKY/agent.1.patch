+class Api::V1::ProfileController < Api::V1::BaseController
+  def show
+    render json: { user: @user.public_attributes }
+  end
+
+  def update
+    @user.update!(name: text(params.expect(user: [:name]), :name))
+    show
+  end
+
+  def password
+    input = params.expect(password_change: [:current_password, :password])
+    return error("Incorrect password", :unauthorized) unless @user.authenticate(text(input, :current_password))
+    @user.replace_password!(text(input, :password))
+    head :no_content
+  end
+end
diff --git a/app/controllers/api/v1/sessions_controller.rb b/app/controllers/api/v1/sessions_controller.rb
new file mode 100644
index 0000000..612a29a
--- /dev/null
+++ b/app/controllers/api/v1/sessions_controller.rb
@@ -0,0 +1,21 @@
+class Api::V1::SessionsController < Api::V1::BaseController
+  skip_before_action :require_active_account
+  skip_before_action :authenticate, only: :create
+
+  def create
+    input = params.expect(session: [:email, :password])
+    @user = @account.users.authenticate_by(email: text(input, :email), password: text(input, :password))
+    return error("Invalid credentials", :unauthorized) unless @user
+    return error("Verify your email first", :forbidden) unless @user.verified?
+    if @account.cancelled_at && (!@user.owner? || @account.expired?)
+      return error("Account cancelled", :forbidden)
+    end
+    render json: { user: @user.public_attributes, account: @account.public_attributes,
+      session: { token: Session.issue!(@user) } }
+  end
+
+  def destroy
+    @session.destroy!
+    head :no_content
+  end
+end
