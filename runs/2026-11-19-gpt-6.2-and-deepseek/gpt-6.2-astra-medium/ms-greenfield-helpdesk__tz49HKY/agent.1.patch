@@ -0,0 +1,11 @@
+class Api::V1::EmailVerificationsController < Api::V1::LinksController
+  private
+
+  def purpose = :verification
+  def envelope = :email_verification
+  def eligible?(user) = !user.verified?
+
+  def consume(user, _input)
+    user.update!(verified: true, verification_digest: nil, verification_expires_at: nil)
+  end
+end
diff --git a/app/controllers/api/v1/links_controller.rb b/app/controllers/api/v1/links_controller.rb
new file mode 100644
index 0000000..9f85f96
--- /dev/null
+++ b/app/controllers/api/v1/links_controller.rb
@@ -0,0 +1,21 @@
+class Api::V1::LinksController < Api::V1::BaseController
+  skip_before_action :authenticate
+
+  def create
+    input = params.expect(envelope => [:email])
+    user = @account.users.find_by(email: text(input, :email))
+    email_link(user, purpose) if user && eligible?(user)
+    head :accepted
+  end
+
+  def confirm
+    input = params.expect(envelope => [:token, :password])
+    digest = Digest::SHA256.hexdigest(text(input, :token))
+    user = @account.users.find_by("#{purpose}_digest" => digest)
+    unless user && eligible?(user) && user.public_send("#{purpose}_expires_at").future?
+      return error("Invalid or expired link", :unprocessable_entity)
+    end
+    consume(user, input)
+    head :no_content
+  end
+end
diff --git a/app/controllers/api/v1/password_resets_controller.rb b/app/controllers/api/v1/password_resets_controller.rb
new file mode 100644
index 0000000..41b6a20
--- /dev/null
+++ b/app/controllers/api/v1/password_resets_controller.rb
@@ -0,0 +1,14 @@
+class Api::V1::PasswordResetsController < Api::V1::LinksController
+  # The owner may need password recovery in order to reactivate.
+  skip_before_action :require_active_account
+
+  private
+
+  def purpose = :reset
+  def envelope = :password_reset
+  def eligible?(user) = !@account.cancelled_at || (user.owner? && !@account.expired?)
+
+  def consume(user, input)
+    user.replace_password!(text(input, :password))
+  end
+end
