diff --git a/config/initializers/rolling_upgrade.rb b/config/initializers/rolling_upgrade.rb
new file mode 100644
index 0000000..0332632
--- /dev/null
+++ b/config/initializers/rolling_upgrade.rb
@@ -0,0 +1,30 @@
+# frozen_string_literal: true
+
+# Register *read* keys only. Writes always use this release's primary key.
+# Run after settings (including the generated secret_token.rb) are loaded.
+Rails.application.config.after_initialize do |app|
+  dispatch = app.config.action_dispatch
+  legacy_writer = Rails::VERSION::MAJOR == 6
+  digest = legacy_writer ? 'SHA256' : 'SHA1'
+  # Rails 6.1's KeyGenerator always uses SHA1; derive the alternate key
+  # without changing the process-wide key generator.
+  secret = app.secret_key_base
+  derive = lambda do |salt, length = 64|
+    OpenSSL::PKCS5.pbkdf2_hmac(secret, salt, 1000, length, digest)
+  end
+
+  # The 6.1 jar can also read (or be configured to write) authenticated
+  # encryption with the old KDF, so carry that reader forward too.
+  cipher = dispatch.encrypted_cookie_cipher || 'aes-256-gcm'
+  key = derive.call(dispatch.authenticated_encrypted_cookie_salt, ActiveSupport::MessageEncryptor.key_len(cipher))
+  dispatch.cookies_rotations.rotate :encrypted, key, nil, cipher: cipher
+
+  unless legacy_writer
+    cipher = 'aes-256-cbc'
+    key = derive.call(dispatch.encrypted_cookie_salt, ActiveSupport::MessageEncryptor.key_len(cipher))
+    signing_key = derive.call(dispatch.encrypted_signed_cookie_salt)
+    dispatch.cookies_rotations.rotate :encrypted, key, signing_key, cipher: cipher
+  end
+  dispatch.cookies_rotations.rotate :signed, derive.call(dispatch.signed_cookie_salt)
+  app.message_verifier(:mail_links).rotate(derive.call('mail_links'))
+end
