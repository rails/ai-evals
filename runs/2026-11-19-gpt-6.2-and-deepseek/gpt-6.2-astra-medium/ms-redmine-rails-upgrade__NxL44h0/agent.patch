diff --git a/test/extra/rolling_upgrade_cache.rb b/test/extra/rolling_upgrade_cache.rb
new file mode 100644
index 0000000..ffc1189
--- /dev/null
+++ b/test/extra/rolling_upgrade_cache.rb
@@ -0,0 +1,15 @@
+# frozen_string_literal: true
+
+# Run in two separate Rails processes against the same temporary FileStore.
+# See docs/UPGRADE.md. Never load marshalled data from an untrusted directory.
+abort 'Use the test database' unless Rails.env.test?
+mode, directory = ARGV
+abort 'Expected: read|write CACHE_DIRECTORY' unless %w[read write].include?(mode) && directory
+
+store = ActiveSupport::Cache::FileStore.new(directory)
+subject = 'rollback cache probe'
+if mode == 'write'
+  abort 'Cache write failed' unless store.write('issue', Issue.new(subject: subject))
+else
+  abort 'Cached model unreadable' unless store.read('issue')&.subject == subject
+end
