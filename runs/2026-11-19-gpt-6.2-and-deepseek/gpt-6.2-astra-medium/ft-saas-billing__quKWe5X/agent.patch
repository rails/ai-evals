@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can open an account, comp it and override its usage independently" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_select "a[href=?]", saas.admin_account_path(account), text: account.name
+      get saas.admin_account_path(account)
+      assert_response :success
+      assert_select "button", text: "Comp"
+
+      post saas.admin_account_comp_path(account)
+      follow_redirect!
+      assert_select "button", text: "Uncomp"
+      assert_equal 5.gigabytes, account.reload.storage_limit
+
+      patch saas.admin_account_override_path(account), params: { override: { card_count: 1000, bytes_used: 123 } }
+      follow_redirect!
+      assert_select "button", text: "Reset"
+      assert_equal 123, account.reload.bytes_used
+      assert_nil account.cards_left
+
+      delete saas.admin_account_comp_path(account)
+      assert_equal 0, account.reload.cards_left
+      delete saas.admin_account_override_path(account)
+      assert_nil account.reload.overridden_limit
+      assert_operator account.cards_left, :>, 0
+    end
+  end
+
+  test "ordinary admins cannot use support tools" do
+    sign_in_as :mike
+    untenanted do
+      post saas.admin_account_comp_path(accounts(:initech))
+      assert_response :forbidden
+    end
+  end
+end
