@@ -0,0 +1,9 @@
+class Account::Subscription::CancellationJob < ApplicationJob
+  self.enqueue_after_transaction_commit = true
+
+  retry_on Stripe::APIConnectionError, Stripe::APIError, Stripe::RateLimitError, wait: :polynomially_longer
+
+  def perform(stripe_subscription_id)
+    Stripe::Subscription.cancel(stripe_subscription_id, {}, api_key: ENV.fetch("STRIPE_SECRET_KEY"))
+  end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..00f421d
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,51 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limit, dependent: :destroy
+
+    set_callback :cancel, :after do
+      active_subscription&.cancel_later
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.ongoing?
+  end
+
+  def billing_plan
+    subscription&.paid_plan || (comped? ? ::Subscription::MonthlyV1 : ::Subscription::FreeV1)
+  end
+
+  def can_start_subscription?
+    !comped? && !subscription&.ongoing?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      self.billing_waiver ||= Account::BillingWaiver.create_or_find_by!(account: self)
+    else
+      self.billing_waiver = nil
+    end
+  end
+
+  def billable_card_count
+    overridden_limit&.card_count || cards.published.count
+  end
+
+  def cards_left
+    if limit = billing_plan.card_limit
+      [ limit - billable_card_count, 0 ].max
+    end
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+end
