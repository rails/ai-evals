diff --git a/saas/test/integration/billing_test.rb b/saas/test/integration/billing_test.rb
new file mode 100644
index 0000000..08639f3
--- /dev/null
+++ b/saas/test/integration/billing_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class BillingTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @draft = cards(:unfinished_thoughts)
+    sign_in_as :mike
+  end
+
+  test "only published cards use the allowance, including the final slot" do
+    Subscription::FreeV1.stubs(:card_limit).returns(@account.cards.published.count + 1)
+    post board_cards_path(@draft.board, script_name: @account.slug)
+    assert_equal 1, @account.cards_left
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert_equal 0, @account.cards_left
+  end
+
+  test "the countdown starts at exactly 100 remaining" do
+    override = @account.create_overridden_limit!(card_count: 899)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_no_match(/cards left/, response.body)
+    override.update!(card_count: 900)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_select "body", text: /100 cards left/
+  end
+
+  test "free card allowance applies to publish and API creation but not drafting" do
+    override = @account.create_overridden_limit!(card_count: 950)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_select "body", text: /50 cards left/
+
+    override.update!(card_count: 1000)
+    post board_cards_path(@draft.board, script_name: @account.slug)
+    assert_response :redirect
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_select "body", text: /Upgrade/
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@draft.board, script_name: @account.slug), params: { card: { title: "Over quota" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/integration/stripe_billing_test.rb b/saas/test/integration/stripe_billing_test.rb
new file mode 100644
index 0000000..91b5f7b
--- /dev/null
+++ b/saas/test/integration/stripe_billing_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class StripeBillingTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    settings = { "STRIPE_SECRET_KEY" => "test-key", "STRIPE_WEBHOOK_SECRET" => "test-secret",
+      "STRIPE_MONTHLY_V1_PRICE_ID" => "price_monthly", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus" }
+    @original_settings = settings.keys.index_with { |key| ENV[key] }
+    ENV.update(settings)
+  end
+
+  teardown do
+    ENV.update(@original_settings)
+  end
+
+  test "admin chooses a hosted checkout and can open their customer's portal" do
+    sign_in_as :mike
+    get account_settings_path(script_name: @account.slug)
+    assert_select "a[href=?]", saas.account_billing_path(script_name: @account.slug), text: "Upgrade"
+    get saas.account_billing_path(script_name: @account.slug)
+    assert_select "button", text: "Upgrade to Unlimited+"
+
+    return_url = account_settings_url(script_name: @account.slug)
+    Stripe::Customer.expects(:create).with({ metadata: { account_id: @account.id } },
+      { api_key: "test-key", idempotency_key: "fizzy-account-#{@account.id}" }).returns(Stripe::Customer.construct_from(id: "cus_test"))
+    Stripe::Checkout::Session.expects(:create).with({ customer: "cus_test", mode: "subscription",
+      line_items: [ { price: "price_plus", quantity: 1 } ], success_url: return_url, cancel_url: return_url }, { api_key: "test-key" })
+      .returns(Stripe::Checkout::Session.construct_from(url: "https://checkout.stripe.com/test"))
+    post saas.account_checkout_path(script_name: @account.slug), params: { plan: "MonthlyExtraStorageV1" }
+    assert_redirected_to "https://checkout.stripe.com/test"
+    assert_equal Subscription::FreeV1, @account.reload.billing_plan
+
+    Stripe::BillingPortal::Session.expects(:create).with({ customer: "cus_test", return_url: return_url }, { api_key: "test-key" })
+      .returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/test"))
+    post saas.account_billing_portal_path(script_name: @account.slug)
+    assert_redirected_to "https://billing.stripe.com/test"
+  end
+
+  test "only catalog plans are accepted" do
+    sign_in_as :mike
+    post saas.account_checkout_path(script_name: @account.slug), params: { plan: "price_forged" }
+    assert_response :bad_request
+  end
+
+  test "members cannot initiate checkout or portal sessions" do
+    sign_in_as :jz
+    post saas.account_checkout_path(script_name: accounts(:"37s").slug), params: { plan: "MonthlyV1" }
+    assert_response :forbidden
+    post saas.account_billing_portal_path(script_name: accounts(:"37s").slug)
+    assert_response :forbidden
+  end
+
+  test "canceling a hosted account also cancels its Stripe subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_test", stripe_subscription_id: "sub_test", status: "active", plan_key: "MonthlyV1")
+    Stripe::Subscription.expects(:cancel).with("sub_test", {}, { api_key: "test-key" })
+    perform_enqueued_jobs(only: Account::Subscription::CancellationJob) do
+      @account.cancel(initiated_by: users(:mike))
+    end
+  end
+
+  test "only signed subscription events change allowances" do
+    @account.create_subscription!(stripe_customer_id: "cus_test")
+    untenanted do
+      deliver_event("created", 1, secret: "forged")
+      assert_response :bad_request
+      assert_equal 1.gigabyte, @account.reload.storage_limit
+
+      deliver_event("created", 1)
+      assert_response :success
+      assert_equal 5.gigabytes, @account.reload.storage_limit
+      assert_nil @account.cards_left
+
+      deliver_event("updated", 2, price: "price_plus")
+      assert_equal 500.gigabytes, @account.reload.storage_limit
+      deliver_event("deleted", 3, price: "price_plus")
+      deliver_event("deleted", 3, price: "price_plus")
+      deliver_event("updated", 2, price: "price_plus")
+      assert_equal 1.gigabyte, @account.reload.storage_limit
+      assert_not_nil @account.cards_left
+    end
+  end
+
+  private
+    def deliver_event(action, created, price: "price_monthly", secret: ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+      payload = { id: "evt_#{created}", object: "event", type: "customer.subscription.#{action}", created: created,
+        data: { object: { id: "sub_test", object: "subscription", customer: "cus_test", status: "active",
+          items: { object: "list", data: [ { price: { id: price } } ] } } } }.to_json
+      time = Time.current
+      signature = Stripe::Webhook::Signature.compute_signature(time, payload, secret)
+      post "/stripe/webhooks", params: payload, headers: { "Content-Type" => "application/json",
+        "Stripe-Signature" => Stripe::Webhook::Signature.generate_header(time, signature) }
+    end
+end
