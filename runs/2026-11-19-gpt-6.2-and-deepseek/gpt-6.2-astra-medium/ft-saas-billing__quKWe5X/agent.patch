diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..5a30e80
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,68 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  def self.for_checkout(account)
+    find_by(account: account) || create_for_checkout(account)
+  end
+
+  def self.create_for_checkout(account)
+    customer = Stripe::Customer.create({ metadata: { account_id: account.id } },
+      api_key: ENV.fetch("STRIPE_SECRET_KEY"), idempotency_key: "fizzy-account-#{account.id}")
+    create_or_find_by!(account: account, stripe_customer_id: customer.id)
+  end
+
+  def ongoing?
+    stripe_subscription_id.present? && !%w[ canceled incomplete_expired ].include?(status)
+  end
+
+  def cancel_later
+    CancellationJob.perform_later(stripe_subscription_id)
+  end
+
+  def paid_plan
+    if %w[ active trialing ].include?(status)
+      ::Subscription::PAID.find { |plan| plan.short_name == plan_key }
+    end
+  end
+
+  def checkout_url(plan, return_url:)
+    Stripe::Checkout::Session.create({
+      customer: stripe_customer_id, mode: "subscription",
+      line_items: [ { price: ENV.fetch(plan.price_setting), quantity: 1 } ],
+      success_url: return_url, cancel_url: return_url
+    }, api_key: ENV.fetch("STRIPE_SECRET_KEY")).url
+  end
+
+  def portal_url(return_url:)
+    Stripe::BillingPortal::Session.create({ customer: stripe_customer_id, return_url: return_url },
+      api_key: ENV.fetch("STRIPE_SECRET_KEY")).url
+  end
+
+  def apply_event(event)
+    with_lock do
+      unless obsolete_event?(event)
+        resource = event.data.object
+        if event.type == "customer.subscription.deleted"
+          update!(stripe_subscription_id: resource.id, status: "canceled", plan_key: nil, last_event_at: event.created)
+        else
+          plan = ::Subscription.for_price(resource.items.data.first&.price&.id)
+          update!(stripe_subscription_id: resource.id, status: resource.status, plan_key: plan&.short_name, last_event_at: event.created)
+          cancel_later if ongoing? && account.cancelled?
+        end
+      end
+    end
+  end
+
+  private
+    # Stripe retries deliveries and doesn't guarantee their order. A deletion
+    # is final for that subscription, but not for a replacement subscription.
+    def obsolete_event?(event)
+      return true if last_event_at && event.created < last_event_at
+
+      if event.data.object.id == stripe_subscription_id
+        status == "canceled" || event.type == "customer.subscription.created"
+      else
+        stripe_subscription_id.present? && event.type == "customer.subscription.deleted"
+      end
+    end
+end
