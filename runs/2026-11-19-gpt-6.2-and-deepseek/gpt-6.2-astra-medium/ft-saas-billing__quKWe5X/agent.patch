+<% @page_title = @account.name %>
+<section class="settings__panel panel shadow">
+  <%= link_to "Accounts", saas.admin_accounts_path %>
+  <h1><%= @account.name %></h1>
+  <p>Plan: <%= @account.billing_plan.proper_name %></p>
+  <% if @account.comped? %>
+    <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete %>
+  <% else %>
+    <%= button_to "Comp", saas.admin_account_comp_path(@account) %>
+  <% end %>
+
+  <h2>Usage override</h2>
+  <p><%= pluralize(@account.billable_card_count, "card") %>, <%= number_to_human_size(@account.bytes_used) %> used.</p>
+  <%= form_with model: (@account.overridden_limit || Account::OverriddenLimit.new), scope: :override, url: saas.admin_account_override_path(@account), method: :patch do |form| %>
+    <% if @account.overridden_limit&.errors&.any? %>
+      <p><%= @account.overridden_limit.errors.full_messages.to_sentence %></p>
+    <% end %>
+    <%= form.label :card_count, "Card count" %>
