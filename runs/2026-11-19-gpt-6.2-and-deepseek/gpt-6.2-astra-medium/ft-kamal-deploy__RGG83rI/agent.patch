+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - &host fizzy.example.com
+
+proxy:
+  host: *host
+  ssl: true
+
+# Kamal makes this local registry available to the server over SSH.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64
+
+volumes:
+  - fizzy_storage:/rails/storage
+
+env:
+  clear:
+    APP_FQDN: *host
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    JOB_CONCURRENCY: "1"
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
