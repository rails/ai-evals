@@ -0,0 +1,7 @@
+class EmailChallengeMailer < ApplicationMailer
+  def verification(challenge)
+    code = challenge.code
+    mail to: challenge.email_address, subject: "#{code} is your Fizzy code",
+      body: "Enter #{code} in Fizzy to continue. This code expires in 15 minutes."
+  end
+end
