+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+  <p>Enter the six-character code from your email. It’s valid for 15 minutes.</p>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap" do |form| %>
+    <%= form.label :code, "Email code" %>
+    <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", maxlength: 6, spellcheck: false, class: "input txt-large" %>
+    <%= form.submit "Continue", class: "btn btn--link center" %>
+  <% end %>
+</div>
