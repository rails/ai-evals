diff --git a/app/models/email_challenge.rb b/app/models/email_challenge.rb
new file mode 100644
index 0000000..0fef93a
--- /dev/null
+++ b/app/models/email_challenge.rb
@@ -0,0 +1,29 @@
+class EmailChallenge < ApplicationRecord
+  LIFETIME = 15.minutes
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase }
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }, length: { maximum: 255 }
+  validates :purpose, inclusion: { in: %w[ sign_in signup join ] }
+
+  def invitation
+    Account::JoinCode.find_by(account_id: account_id, code: join_code)
+  end
+
+  def deliver_later
+    if purpose != "sign_in" || Identity.exists?(email_address: email_address)
+      EmailChallengeMailer.verification(self).deliver_later
+    end
+  end
+
+  # Derive the code from a server secret so it never needs to be stored or queued.
+  def code
+    key = Rails.application.key_generator.generate_key("email challenge code")
+    OpenSSL::HMAC.hexdigest("SHA256", key, id).hex.to_s(36).last(6).upcase
+  end
+
+  def consume(submitted_code)
+    if ActiveSupport::SecurityUtils.secure_compare(code, submitted_code.to_s.strip.upcase)
+      self.class.where(id: id).where("created_at > ?", LIFETIME.ago).delete_all == 1
+    end
+  end
+end
