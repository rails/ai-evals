diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..90e1995
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,69 @@
+class Sessions::MagicLinksController < ApplicationController
+  include JoinCodeRedemption
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, name: "ip", only: :create, with: -> { head :too_many_requests }
+  rate_limit to: 10, within: EmailChallenge::LIFETIME, name: "challenge", only: :create,
+    by: -> { cookies[:pending_authentication_token] }, with: -> { head :too_many_requests }
+
+  layout "public"
+
+  def show
+  end
+
+  def create
+    challenge = EmailChallenge.find_signed(cookies[:pending_authentication_token])
+
+    if challenge&.consume(params[:code])
+      cookies.delete(:pending_authentication_token)
+      complete_authentication(challenge)
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def complete_authentication(challenge)
+      case challenge.purpose
+      when "sign_in" then sign_in_existing_identity(challenge.email_address)
+      when "signup"  then sign_up(challenge.email_address)
+      when "join"    then redeem_join_code(challenge.invitation, challenge.email_address)
+      end
+    end
+
+    def sign_in_existing_identity(email_address)
+      if identity = Identity.find_by(email_address: email_address)
+        sign_in identity, after_authentication_url
+      else
+        invalid_code
+      end
+    end
+
+    def sign_up(email_address)
+      if Account.accepting_signups?
+        sign_in Signup.new(email_address: email_address).create_identity, new_signup_completion_url
+      else
+        head :forbidden
+      end
+    end
+
+    def sign_in(identity, destination)
+      start_new_session_for identity
+      respond_to do |format|
+        format.html { redirect_to destination }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_code
+      message = "That code is incorrect or has expired. Try again or request a new code."
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = message
+          render :show, status: :unauthorized
+        end
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+end
