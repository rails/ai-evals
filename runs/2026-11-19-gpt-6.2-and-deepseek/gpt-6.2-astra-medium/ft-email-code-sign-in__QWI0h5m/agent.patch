new file mode 100644
index 0000000..116e18b
--- /dev/null
+++ b/app/controllers/concerns/email_authentication.rb
@@ -0,0 +1,20 @@
+module EmailAuthentication
+  private
+
+  def request_email_code(email_address, purpose:, join_code: nil)
+    challenge = EmailChallenge.new(email_address: email_address, purpose: purpose, account_id: join_code&.account_id, join_code: join_code&.code)
+
+    if challenge.save
+      challenge.deliver_later
+      token = challenge.signed_id(expires_in: EmailChallenge::LIFETIME)
+      cookies[:pending_authentication_token] = { value: token, expires: EmailChallenge::LIFETIME.from_now, httponly: true, same_site: :lax }
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path(script_name: nil) }
+        format.json { render json: { pending_authentication_token: token }, status: :created }
+      end
+    else
+      head :unprocessable_entity
+    end
+  end
+end
