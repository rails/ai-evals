diff --git a/test/integration/email_authentication_test.rb b/test/integration/email_authentication_test.rb
new file mode 100644
index 0000000..6ea98c0
--- /dev/null
+++ b/test/integration/email_authentication_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class EmailAuthenticationTest < ActionDispatch::IntegrationTest
+  test "sign in with the code from the email subject" do
+    untenanted do
+      email_address = identities(:kevin).email_address
+      code = emailed_code(email_address) { post session_path, params: { email_address: email_address } }
+      follow_redirect!
+      assert_select "input[name=code][autocomplete=one-time-code]"
+
+      post session_magic_link_path, params: { code: "WRONG!" }
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+
+      travel 14.minutes
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "expired or already used codes cannot create a session" do
+    freeze_time
+    untenanted do
+      email_address = identities(:kevin).email_address
+      code = emailed_code(email_address) { post session_path(format: :json), params: { email_address: email_address }, as: :json }
+      assert_response :created
+      token = response.parsed_body.fetch("pending_authentication_token")
+
+      post session_magic_link_path(format: :json), params: { code: code }, as: :json
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body.fetch("session_token")
+      sign_out
+      cookies[:pending_authentication_token] = token
+      post session_magic_link_path, params: { code: code }
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+
+      code = emailed_code(email_address) { post session_path, params: { email_address: email_address } }
+      token = cookies[:pending_authentication_token]
+      travel 15.minutes
+      cookies[:pending_authentication_token] = token
+      post session_magic_link_path, params: { code: code }
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "the email code requires its matching pending authentication token" do
+    untenanted do
+      email_address = identities(:kevin).email_address
+      code = emailed_code(email_address) { post session_path, params: { email_address: email_address } }
+      cookies.delete "pending_authentication_token"
+      post session_magic_link_path, params: { code: code }
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "a sign-in request for an unknown address does not disclose membership or create an identity" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        assert_no_emails { post session_path, params: { email_address: "unknown@example.com" } }
+        assert_redirected_to session_magic_link_path
+      end
+    end
+  end
+
+  test "a verified email can complete signup" do
+    untenanted do
+      with_multi_tenant_mode(true) do
+        email_address = "new@example.com"
+        code = emailed_code(email_address) { post signup_path, params: { signup: { email_address: email_address } } }
+        assert_not Identity.exists?(email_address: email_address)
+        post session_magic_link_path, params: { code: code }
+        assert_redirected_to new_signup_completion_url
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+        owner = Identity.find_by!(email_address: email_address).users.sole
+        assert owner.owner?
+        assert_redirected_to landing_url(script_name: owner.account.slug)
+      end
+    end
+  end
+
+  test "a verified email can join the invited account" do
+    join_code = account_join_codes(:"37s")
+    email_address = "invitee@example.com"
+    code = emailed_code(email_address) do
+      post join_path(code: join_code.code, script_name: join_code.account.slug), params: { email_address: email_address }
+    end
+    assert_not Identity.exists?(email_address: email_address)
+    untenanted do
+      assert_redirected_to session_magic_link_path
+      assert_difference -> { join_code.reload.usage_count }, 1 do
+        post session_magic_link_path, params: { code: code }
+      end
+    end
+    assert_redirected_to new_users_verification_url(script_name: join_code.account.slug)
+    assert_equal join_code.account, Identity.find_by!(email_address: email_address).users.sole.account
+  end
+
+  test "resetting a join code invalidates a pending invitation" do
+    join_code = account_join_codes(:"37s")
+    email_address = "invitee@example.com"
+    code = emailed_code(email_address) do
+      post join_path(code: join_code.code, script_name: join_code.account.slug), params: { email_address: email_address }
+    end
+    join_code.reset
+    untenanted { post session_magic_link_path, params: { code: code } }
+    assert_response :gone
+    assert_not cookies[:session_token].present?
+    assert_not Identity.exists?(email_address: email_address)
+  end
+
+  private
+    def emailed_code(email_address)
+      assert_emails 1 do
+        yield
+      end
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ email_address ], mail.to
+      mail.subject.match(/\b([A-Z0-9]{6})\b/)[1]
+    end
+end
