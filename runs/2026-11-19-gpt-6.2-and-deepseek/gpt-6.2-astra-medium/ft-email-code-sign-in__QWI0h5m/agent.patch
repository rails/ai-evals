+module JoinCodeRedemption
+  private
+
+  def redeem_join_code(join_code, email_address)
+    if user = join_code&.redeem_for(email_address)
+      start_new_session_for(user.identity) unless Current.identity == user.identity
+      destination = user.setup? ? landing_url(script_name: user.account.slug) : new_users_verification_url(script_name: user.account.slug)
+      respond_to do |format|
+        format.html { redirect_to destination }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      head :gone
+    end
+  end
+end
