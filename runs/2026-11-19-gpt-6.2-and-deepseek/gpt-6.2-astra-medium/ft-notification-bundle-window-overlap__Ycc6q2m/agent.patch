diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..bfd3c15
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,47 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :user
+  has_many :entries, dependent: :delete_all
+
+  after_create_commit :schedule_delivery
+
+  def self.collect(notification)
+    # The settings row exists even before the first window. Lock it for the
+    # lookup AND creation, and sample the arrival time only once we hold it.
+    transaction do
+      settings = User::Settings.lock.find_by(user_id: notification.user_id)
+      if interval = settings&.bundle_interval
+        bundles = notification.user.notification_bundles
+        bundle = bundles.lock.order(ends_at: :desc).first
+        now = Time.current
+        unless bundle && now < bundle.ends_at
+          bundle = bundles.create!(starts_at: now, ends_at: now + interval)
+        end
+
+        payload = notification.payload
+        bundle.entries.create!(notification: notification, title: payload.title, body: payload.body)
+      end
+    end
+  end
+
+  def deliver
+    with_lock do
+      if ends_at <= Time.current
+        NotificationMailer.digest(self).deliver_now if deliverable?
+        destroy!
+      end
+    end
+  end
+
+  def visible_entries
+    entries.joins(:notification).where(notifications: { card_id: user.accessible_cards.select(:id) })
+  end
+
+  private
+    def deliverable?
+      user.active? && user.account.active? && user.identity && !user.settings.never? && visible_entries.exists?
+    end
+
+    def schedule_delivery
+      DeliveryJob.set(wait_until: ends_at).perform_later(self)
+    end
+end
