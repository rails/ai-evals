+class AddHadBurstToCards < ActiveRecord::Migration[8.2]
+  def change
+    add_column :cards, :had_burst, :boolean, null: false, default: false
+
+    reversible do |dir|
+      dir.up do
+        Card.reset_column_information
+        Card.where(id: Assignment.select(:card_id)).update_all(had_burst: true)
+        Card.where(id: Event.where(eventable_type: "Card", action: %w[ card_assigned card_reopened ]).select(:eventable_id)).update_all(had_burst: true)
+
+        candidates = Comment.by_user.group(:card_id).having("COUNT(*) >= 3 AND COUNT(DISTINCT comments.creator_id) >= 2").select(:card_id)
+        Card.where(had_burst: false, id: candidates).includes(board: [ :entropy, account: :entropy ]).find_each do |card|
+          card.update_column(:had_burst, true) if card.comment_burst?
+        end
+      end
+    end
+  end
+end
