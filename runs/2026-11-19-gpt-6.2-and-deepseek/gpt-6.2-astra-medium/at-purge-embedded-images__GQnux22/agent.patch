 require "test_helper"
 
 class PageTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges its markdown image" do
+    page = pages(:welcome)
+    file_fixture("reading.webp").open { |file| page.body.uploads.attach(io: file, filename: "reading.webp") }
+    image = page.body.uploads.last
+    page.update!(body: "![Reading](#{image.slug_path})")
+    blob = image.blob
+    assert blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs { page.destroy! }
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
