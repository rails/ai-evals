+++ b/test/system/local_time_test.rb
@@ -0,0 +1,28 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "comments and deadlines use the browser's calendar day" do
+    sign_in_as users(:david)
+    timezone = "America/Los_Angeles"
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+
+    today = Time.current.in_time_zone(timezone).beginning_of_day
+    card = cards(:logo)
+    comments(:logo_agreement_kevin).update_column(:created_at, today.change(hour: 13, min: 42))
+    comments(:logo_agreement_jz).update_column(:created_at, today - 1.minute)
+    comments(:logo_1).update_columns(created_at: today - 5.days, creator_id: users(:david).id)
+    card.update_column(:last_active_at, today.tomorrow - card.auto_postpone_period)
+
+    visit card_url(card)
+    assert_selector ".comment__permalink-title time", text: "1:42 PM"
+    assert_selector ".comment__permalink-title time", text: "yesterday"
+    assert_selector ".comment__permalink-title time", text: "5 days ago"
+    assert_selector ".card-perma__closure-message time", text: "tomorrow"
+
+    card.update_column(:last_active_at, today + 3.days - card.auto_postpone_period)
+    visit card_url(card)
+    assert_selector ".card-perma__closure-message time", text: "in 3 days"
+  ensure
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+  end
+end
