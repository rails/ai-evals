diff --git a/app/javascript/helpers/local_time.js b/app/javascript/helpers/local_time.js
new file mode 100644
index 0000000..fb83c46
--- /dev/null
+++ b/app/javascript/helpers/local_time.js
@@ -0,0 +1,27 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const formats = {
+  time: { hour: "numeric", minute: "2-digit" },
+  date: { month: "short", day: "numeric" },
+  date_with_year: { year: "numeric", month: "short", day: "numeric" },
+  datetime: { dateStyle: "short", timeStyle: "short" },
+  // A timeline heading names a query day, not an instant at midnight.
+  calendar_day: { weekday: "long", month: "long", day: "numeric", timeZone: "UTC" }
+}
+
+const formatters = new Map()
+const relativeDays = new Intl.RelativeTimeFormat(undefined, { numeric: "auto" })
+
+export function formatLocalTime(date, format, now = new Date()) {
+  if (format === "relative" || format === "deadline") {
+    const days = signedDifferenceInDays(now, date)
+
+    if (format === "deadline") return relativeDays.format(Math.max(0, days), "day")
+    if (days === 0) return formatLocalTime(date, "time")
+    if (Math.abs(days) < 7) return relativeDays.format(days, "day")
+    format = date.getFullYear() === now.getFullYear() ? "date" : "date_with_year"
+  }
+
+  if (!formatters.has(format)) formatters.set(format, new Intl.DateTimeFormat(undefined, formats[format]))
+  return formatters.get(format).format(date)
+}
