+++ b/app/models/webhook/delivery.rb
@@ -10,6 +10,26 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).in_batches.delete_all
+  end
+
+  def deliver_now
+    # Claim before doing I/O. A replay after a lost HTTP response must not POST again.
+    return unless self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+
+    if still_applicable?
+      post = Webhook::Post.new(self)
+      update! request: { headers: post.headers }
+      record_result(post.submit)
+    else
+      update! state: :errored, response: { error: "no_longer_applicable" }
+    end
+  rescue ActionView::Template::Error => error
+    Rails.error.report(error, context: { delivery_id: id })
+    update! state: :errored, response: { error: "payload_rendering_failed" }
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +49,19 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def still_applicable?
+      webhook.reload.active? && event.board_id == webhook.board_id && event.card.board_id == webhook.board_id
+    end
+
+    def record_result(result)
+      webhook.with_lock do
+        update! state: result[:code] ? :completed : :errored, response: result
+        if webhook.active?
+          tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+          succeeded? ? tracker.reset : tracker.record_failure
+        end
+      end
+    end
 end
diff --git a/app/models/webhook/post.rb b/app/models/webhook/post.rb
new file mode 100644
index 0000000..a05fdcf
--- /dev/null
+++ b/app/models/webhook/post.rb
@@ -0,0 +1,37 @@
+require "net/http"
+
+class Webhook::Post
+  attr_reader :headers
+
+  def initialize(delivery)
+    @uri = URI.parse(delivery.webhook.url)
+    renderer = ApplicationController.renderer.new(script_name: delivery.account.slug)
+    @body = renderer.render(template: "webhooks/event", formats: [ :json ], assigns: { event: delivery.event }, layout: false)
+    @headers = {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Timestamp" => delivery.event.created_at.utc.iso8601,
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", delivery.webhook.signing_secret, @body),
+      "Idempotency-Key" => delivery.id
+    }
+  end
+
+  def submit
+    ip = SsrfProtection.resolve_public_ip(@uri.hostname)
+    return { error: "destination_unreachable" } unless ip
+
+    # Pin the public address while retaining the original hostname for TLS.
+    # Disable environment proxies so the proxy cannot resolve a different address.
+    http = Net::HTTP.new(@uri.hostname, @uri.port, nil)
+    http.ipaddr = ip
+    http.use_ssl = @uri.scheme == "https"
+    http.open_timeout = http.read_timeout = http.write_timeout = 5
+    http.max_retries = 0
+
+    request = Net::HTTP::Post.new(@uri.request_uri, headers)
+    request.body = @body
+    http.request(request) { |response| return { code: response.code.to_i } }
+  rescue IOError, SystemCallError, SocketError, Resolv::ResolvError, Resolv::DNS::EncodeError, Resolv::DNS::DecodeError, Timeout::Error, OpenSSL::SSL::SSLError, Net::ProtocolError, Net::HTTPBadResponse
+    { error: "destination_unreachable" }
+  end
+end
