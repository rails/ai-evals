diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..2086f40 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -79,6 +79,33 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
   end
 
+  test "cached table of contents is correct whether an editor or reader visits first" do
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+
+    [ %i[ kevin jz ], %i[ jz kevin ] ].each do |visitors|
+      store = ActiveSupport::Cache::MemoryStore.new
+      BooksController.with(perform_caching: true, cache_store: store) do
+        ActionView::PartialRenderer.with(collection_cache: store) do
+          visitors.each do |visitor|
+            sign_out
+            sign_in visitor
+            assert_notifications_count("cache_read_multi.active_support", 1) { get book_slug_path(book) }
+            assert_response :success
+            editable = visitor == :kevin
+            assert_select "#leaves a[href=?]", edit_leafable_path(leaf), count: editable ? 2 : 0
+            assert_select "#leaves .leaf__delete", editable
+            assert_select "#leaves .arrangement__handle", editable
+          end
+
+          leaf.update!(title: "Renamed by #{visitors.first}")
+          get book_slug_path(book)
+          assert_select "#leaves a.toc__title", text: leaf.title
+        end
+      end
+    end
+  end
+
   test "show includes OG metadata for public access" do
     get book_slug_url(books(:handbook))
     assert_response :success
