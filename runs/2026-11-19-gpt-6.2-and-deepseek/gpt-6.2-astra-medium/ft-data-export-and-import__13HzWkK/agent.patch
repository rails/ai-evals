@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Account::TransfersControllerTest < ActionDispatch::IntegrationTest
+  test "only admins can request an account export" do
+    sign_in_as :david
+    assert_no_difference "Export.count" do
+      post account_exports_path
+      assert_response :forbidden
+    end
+
+    logout_and_sign_in_as users(:kevin)
+    assert_enqueued_with(job: ExportJob) { post account_exports_path }
+    assert_equal users(:kevin), Export.last.user
+    assert_redirected_to account_settings_path
+  end
+
+  test "personal export links work only for the requester and expire after a day" do
+    sign_in_as :david
+    perform_enqueued_jobs(only: ExportJob) { post my_exports_path }
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:david).email_address ], email.to
+    url = email.body.to_s[/https?:\/\/\S+/]
+    get url
+    assert_response :redirect
+    travel 25.hours do
+      get url
+      assert_response :not_found
+    end
+    logout_and_sign_in_as users(:jz)
+    get url
+    assert_response :forbidden
+  end
+
+  test "import requires sign in and reports an invalid upload by email" do
+    untenanted do
+      get new_account_import_path
+      assert_response :redirect
+      sign_in_as :david
+      get new_account_import_path
+      assert_response :success
+      assert_no_difference "Account.count" do
+        perform_enqueued_jobs do
+          post account_imports_path, params: { archive: fixture_file_upload("moon.jpg", "application/zip") }
+        end
+      end
+      assert_match(/import failed/, ActionMailer::Base.deliveries.last.subject)
+      assert_match(/ZIP file is damaged/, ActionMailer::Base.deliveries.last.body.to_s)
+    end
+  end
+
+  test "uploading a backup emails a link to a new account" do
+    sign_in_as :david
+    export = accounts(:"37s").exports.create!(user: users(:jason), kind: :account)
+    Current.with_account(export.account) { export.build_archive }
+    export.archive.blob.open do |file|
+      untenanted do
+        assert_difference "Account.count", 1 do
+          perform_enqueued_jobs(only: [ Account::ImportJob, ActionMailer::MailDeliveryJob ]) do
+            post account_imports_path, params: { archive: Rack::Test::UploadedFile.new(file.path, "application/zip") }
+          end
+        end
+      end
+    end
+    account = Account.last
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_includes email.body.to_s, account.slug
+    assert account.users.find_by!(identity: identities(:david)).owner?
+  end
+end
diff --git a/test/models/account/data_transfer_test.rb b/test/models/account/data_transfer_test.rb
