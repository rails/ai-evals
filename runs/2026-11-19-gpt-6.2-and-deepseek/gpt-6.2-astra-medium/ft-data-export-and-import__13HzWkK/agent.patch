diff --git a/app/models/account/data_transfer/restore.rb b/app/models/account/data_transfer/restore.rb
new file mode 100644
index 0000000..2dc77ae
--- /dev/null
+++ b/app/models/account/data_transfer/restore.rb
@@ -0,0 +1,159 @@
+class Account::DataTransfer::Restore
+  Invalid = ZipFile::Reader::Invalid
+
+  POLYMORPHIC_TARGETS = {
+    "Entropy" => %w[Account Board], "Event" => %w[Card Comment],
+    "Mention" => %w[Card Comment], "Reaction" => %w[Card Comment],
+    "Notification" => %w[Event Mention], "ActionText::RichText" => %w[Board Card Comment],
+    "ActiveStorage::Attachment" => %w[User Card ActionText::RichText]
+  }.freeze
+
+  def initialize(file, identity)
+    @zip = ZipFile::Reader.new(file)
+    @identity = identity
+    @ids = Hash.new { |hash, type| hash[type] = {} }
+    @uploaded_keys = []
+  end
+
+  def restore
+    manifest = @zip.json("manifest.json")
+    raise Invalid, "Not a Fizzy account backup" unless manifest.fetch("format") == Account::DataTransfer::Manifest::FORMAT
+    @counts = manifest.fetch("counts")
+    raise Invalid, "Expected one account" unless @counts.fetch("accounts") == 1
+
+    Account.transaction(requires_new: true) do |transaction|
+      transaction.after_rollback { @uploaded_keys.each { |key| ActiveStorage::Blob.service.delete(key) } }
+      row = @zip.json("records/accounts/0.json")
+      @account = Account.create!(row.slice("name", "cards_count"))
+      remember(Account, row.fetch("id"), @account.id)
+      Current.with_account(@account) do
+        Account::DataTransfer::Manifest.new(@account).each_record_set do |set|
+          next if set.model == Account || set.directory == "files"
+          count = @counts.fetch(set.directory)
+          raise Invalid, "Invalid record count" unless count.is_a?(Integer) && count >= 0
+          count.times { |i| restore_record(set, @zip.json("records/#{set.directory}/#{i}.json")) }
+        end
+        finish_account
+      end
+      @account
+    end
+  end
+
+  private
+    def restore_record(set, row)
+      model = set.model
+      source_id = row.fetch("id")
+      if model == ActiveStorage::Blob
+        remember(model, source_id, restore_file(row).id)
+      else
+        attrs = row.slice(*set.attributes).except("id", "identity_id")
+        remap_associations(model, attrs)
+        case model.name
+        when "User"
+          attrs["identity_id"] = Identity.find_or_create_by!(email_address: row["email"]).id if row["email"].present?
+          raise Invalid, "Invalid user role" unless User.roles.key?(attrs["role"])
+        when "Entropy"
+          @account.entropy&.delete if attrs["container_type"] == "Account"
+        when "Board::Publication"
+          attrs["key"] = SecureRandom.base58(24)
+        when "Notification::Bundle"
+          attrs["status"] = "delivered" # Do not re-send historical email.
+        when "Webhook"
+          attrs.merge!("active" => false, "signing_secret" => SecureRandom.base58(24))
+        when "Event"
+          raise Invalid, "Invalid event action" unless attrs["action"].to_s.match?(/\A[a-z_]+\z/)
+
+          if ids = attrs.dig("particulars", "assignee_ids")
+            attrs["particulars"]["assignee_ids"] = ids.map { |id| mapped("User", id) }
+          end
+        when "Filter"
+          filter = restore_filter(attrs, row.fetch("resources"))
+          return remember(model, source_id, filter.id)
+        when "ActionText::RichText"
+          attrs["body"] = restore_body(attrs.fetch("body"))
+        end
+        attrs["id"] = ActiveRecord::Type::Uuid.generate
+        model.insert_all!([ attrs ]) # Restore history without generating new events or notifications.
+        remember(model, source_id, attrs["id"])
+      end
+    end
+
+    def remap_associations(model, attrs)
+      model.reflect_on_all_associations(:belongs_to).each do |association|
+        key = association.foreign_key
+        if association.polymorphic?
+          type = attrs.fetch(association.foreign_type)
+          raise Invalid, "Invalid #{association.name} type" unless POLYMORPHIC_TARGETS.fetch(model.name).include?(type)
+          attrs[key] = mapped(type, attrs.fetch(key))
+        elsif id = attrs[key]
+          attrs[key] = mapped(association.klass.name, id)
+        end
+      end
+    end
+
+    def mapped(type, id)
+      @ids.fetch(type, {}).fetch(id) { raise Invalid, "Missing referenced #{type.to_s.truncate(80)}" }
+    end
+
+    def remember(model, old_id, new_id)
+      raise Invalid, "Duplicate #{model.name}" if @ids[model.name].key?(old_id)
+      @ids[model.name][old_id] = new_id
+    end
+
+    def restore_filter(attrs, resources)
+      { "card_ids" => "Card", "column_ids" => "Column" }.each do |key, type|
+        if ids = attrs.fetch("fields")[key]
+          attrs["fields"][key] = ids.map { |id| mapped(type, id) }
+        end
+      end
+      filter = Filter.new(attrs.except("params_digest"))
+      Account::DataTransfer::FilterRecordSet::RESOURCES.each do |name|
+        type = Filter.reflect_on_association(name).klass.name
+        filter.public_send("#{name.singularize}_ids=", resources.fetch(name).map { |id| mapped(type, id) })
+      end
+      filter.save!
+      filter
+    end
+
+    def restore_file(row)
+      filename = ActiveStorage::Filename.new(row.fetch("filename"))
+      @zip.file(Account::DataTransfer::FilePath.for(row.fetch("id"), filename), row.fetch("byte_size")) do |io|
+        key = ActiveStorage::Blob.generate_unique_secure_token
+        @uploaded_keys << key
+        blob = ActiveStorage::Blob.create_and_upload!(key: key, io: io, filename: filename, content_type: row["content_type"])
+        raise Invalid, "File checksum mismatch" if row["checksum"] && row["checksum"] != blob.checksum
+        blob
+      end
+    end
+
+    def restore_body(html)
+      fragment = Nokogiri::HTML5.fragment(ActionText::Content.new(html).to_html)
+      fragment.css("action-text-attachment").each do |node|
+        node.remove_attribute("sgid")
+        if type = node["data-transfer-type"]
+          node.remove_attribute("data-transfer-type")
+          model = { "User" => User, "ActiveStorage::Blob" => ActiveStorage::Blob }.fetch(type)
+          record = model.find(mapped(type, node["data-transfer-id"]))
+          node.remove_attribute("data-transfer-id")
+          node["sgid"] = record.attachable_sgid
+          if record.is_a?(ActiveStorage::Blob)
+            node["url"] = Rails.application.routes.url_helpers.rails_blob_path(record, only_path: true, script_name: @account.slug)
+          end
+        end
+      end
+      fragment.to_html
+    end
+
+    def finish_account
+      raise Invalid, "Missing system user" unless @account.users.exists?(role: :system)
+      owner = @account.users.find_or_initialize_by(identity: @identity)
+      owner.update!(role: :owner, active: true, verified_at: Time.current, name: owner.name || @identity.email_address)
+      @account.boards.find_each { |board| board.accesses.find_or_create_by!(user: owner) }
+      highest_number = @account.cards.maximum(:number).to_i
+      @account.update!(cards_count: highest_number) if highest_number > @account.cards_count
+      @account.cards.find_each(&:reindex)
+      Comment.where(account: @account).find_each(&:reindex)
+      @account.boards.find_each(&:reconcile_storage)
+      @account.reconcile_storage
+    end
+end
