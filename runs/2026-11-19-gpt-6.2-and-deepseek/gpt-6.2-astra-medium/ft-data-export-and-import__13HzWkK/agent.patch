+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+  layout "public"
+
+  def new
+  end
+
+  def create
+    upload = params[:archive]
+    unless upload.is_a?(ActionDispatch::Http::UploadedFile)
+      return redirect_to new_account_import_path, alert: "Choose a Fizzy account ZIP file."
+    end
+
+    # Imports belong to a signed-in identity, which may not have any account yet.
+    # Stage the upload under a fresh storage key, not a tenant-owned blob.
+    key = ActiveStorage::Blob.generate_unique_secure_token
+    service = ActiveStorage::Blob.service
+    begin
+      service.upload(key, upload.tempfile)
+      Account::ImportJob.perform_later(Current.identity.id, key, upload.size) || raise(ActiveJob::EnqueueError)
+    rescue StandardError => error
+      service.delete(key)
+      Rails.error.report(error)
+      reason = "Your upload could not be saved for import. Please try uploading it again."
+      TransferMailer.import_failed(Current.identity, reason).deliver_later
+      return redirect_to new_account_import_path, alert: reason
+    end
+    redirect_to new_account_import_path, notice: "We’ll email you when the import finishes."
+  end
+end
