diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..e7c241a
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,64 @@
+# Entries are addressed by archive name, never extracted to a user-supplied path.
+class ZipFile::Reader
+  class Invalid < StandardError; end
+
+  def initialize(file)
+    @file = file
+    @entries = {}
+    compressed_size = 0
+    ZipKit::FileReader.read_zip_structure(io: BoundedReads.new(file)).each do |entry|
+      entry.filename.force_encoding(Encoding::UTF_8)
+      raise Invalid, "Invalid filename" unless entry.filename.valid_encoding?
+      raise Invalid, "Duplicate archive entry" if @entries.key?(entry.filename)
+      compressed_size += entry.compressed_size
+      if compressed_size > file.size || entry.compressed_data_offset + entry.compressed_size > file.size
+        raise Invalid, "Invalid archive offsets"
+      end
+      @entries[entry.filename] = entry
+    end
+  end
+
+  def json(path)
+    content = +"".b
+    extract(path, limit: 64.megabytes) { |chunk| content << chunk }
+    JSON.parse(content)
+  end
+
+  def file(path, size)
+    entry = @entries.fetch(path)
+    raise Invalid, "Invalid file size or encoding" unless entry.storage_mode.zero? && entry.uncompressed_size == size
+
+    Tempfile.create(binmode: true) do |io|
+      extract(path, limit: size) { |chunk| io.write(chunk) }
+      io.rewind
+      yield io
+    end
+  end
+
+  private
+    def extract(path, limit:)
+      entry = @entries.fetch(path) { raise Invalid, "Missing #{path.truncate(120)}" }
+      raise Invalid, "Archive entry too large" if entry.uncompressed_size > limit
+      reader = entry.extractor_from(@file)
+      bytes = crc = 0
+      until reader.eof?
+        position = @file.tell
+        chunk = reader.extract(entry.storage_mode.zero? ? 1.megabyte : 8.kilobytes)
+        raise Invalid, "Truncated archive" unless chunk && (@file.tell > position || reader.eof?)
+        bytes += chunk.bytesize
+        raise Invalid, "Incorrect entry length" if bytes > entry.uncompressed_size
+        crc = Zlib.crc32(chunk, crc)
+        yield chunk
+      end
+      raise Invalid, "Corrupt archive entry" unless bytes == entry.uncompressed_size && crc == entry.crc32
+    end
+
+    # ZipKit reads from the central directory offset to EOF. Bound this read
+    # even if a malformed ZIP points it at the start of a very large upload.
+    class BoundedReads < SimpleDelegator
+      def read(length = nil)
+        raise Invalid, "Archive directory too large" if (length || size - pos) > 256.megabytes
+        super
+      end
+    end
+end
diff --git a/app/models/zip_file/stored_io.rb b/app/models/zip_file/stored_io.rb
new file mode 100644
index 0000000..f2c3d9b
--- /dev/null
+++ b/app/models/zip_file/stored_io.rb
@@ -0,0 +1,30 @@
+# A seekable window on a staged upload: ZIP64 archives can be much larger than
+# the worker’s local disk. Cache nearby reads from Active Storage (disk or S3).
+class ZipFile::StoredIO
+  attr_reader :size, :pos
+  alias_method :tell, :pos
+
+  def initialize(service, key, size)
+    @service, @key, @size = service, key, size
+    @pos = @start = 0
+    @buffer = "".b
+  end
+
+  def seek(offset, mode = IO::SEEK_SET)
+    raise IOError unless mode == IO::SEEK_SET && offset.between?(0, size)
+    @pos = offset
+  end
+
+  def read(length = nil)
+    length = [ length || size - pos, size - pos ].min
+    return "".b if length.zero?
+
+    unless pos >= @start && pos + length <= @start + @buffer.bytesize
+      @start = pos
+      finish = [ pos + [ length, 1.megabyte ].max, size ].min
+      @buffer = @service.download_chunk(@key, pos..(finish - 1))
+      raise EOFError unless @buffer&.bytesize == finish - pos
+    end
+    @buffer.byteslice(pos - @start, length).tap { @pos += length }
+  end
+end
