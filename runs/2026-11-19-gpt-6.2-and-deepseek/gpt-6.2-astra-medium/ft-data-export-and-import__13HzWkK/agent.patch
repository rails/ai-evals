+++ b/app/models/account/data_transfer/cards.rb
@@ -0,0 +1,43 @@
+class Account::DataTransfer::Cards
+  def initialize(cards, include_files:)
+    @cards = cards
+    @include_files = include_files
+    @written_files = Set.new
+  end
+
+  def write(zip)
+    @cards.preload(:board, :column, :creator, :tags, :assignees, :steps, :closure, :goldness, :not_now).find_each do |card|
+      files = {}
+      zip.add_file("cards/#{card.number}.json") do |sink|
+        write_card(sink, card, files)
+      end
+      files.each do |path, blob|
+        zip.add_file(path, compress: false) { |sink| blob.download { |chunk| sink << chunk } }
+      end
+    end
+  end
+
+  private
+    def write_card(sink, card, files)
+      attributes = card.attributes.merge(
+        board: card.board.name, column: card.column&.name, creator: card.creator.name,
+        tags: card.tags.map(&:title), assignees: card.assignees.map(&:name), steps: card.steps.map(&:attributes),
+        closed: card.closed?, golden: card.golden?, postponed: card.postponed?, description: card.description.body&.to_html,
+        files: paths_for([ card.image.blob, *card.attachments.map(&:blob) ].compact, files))
+      sink << attributes.to_json.chomp("}") << ',"comments":['
+      card.comments.find_each.with_index do |comment, index|
+        sink << "," unless index.zero?
+        sink << comment.attributes.merge(creator: comment.creator.name, body: comment.body.body&.to_html,
+          files: paths_for(comment.attachments.map(&:blob), files)).to_json
+      end
+      sink << "]}"
+    end
+
+    def paths_for(blobs, files)
+      blobs.map do |blob|
+        path = Account::DataTransfer::FilePath.for(blob.id, blob.filename)
+        files[path] = blob if @include_files && @written_files.add?(blob.id)
+        path
+      end
+    end
+end
