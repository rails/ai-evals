@@ -0,0 +1,31 @@
+class Account::ImportJob < ApplicationJob
+  def perform(identity_id, key, size)
+    service = ActiveStorage::Blob.service
+    begin
+      identity = Identity.find_by(id: identity_id)
+      return unless identity
+
+      file = ZipFile::StoredIO.new(service, key, size)
+      account = Account::DataTransfer::Restore.new(file, identity).restore
+    rescue StandardError => error
+      Rails.error.report(error)
+      raise unless identity
+      TransferMailer.import_failed(identity, failure_reason(error)).deliver_later
+    else
+      TransferMailer.imported(identity, account).deliver_later
+    ensure
+      service.delete(key)
+    end
+  end
+
+  private
+    def failure_reason(error)
+      case error
+      when ZipFile::Reader::Invalid then error.message
+      when ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::UnsupportedFeature, Zlib::Error, EOFError then "The ZIP file is damaged or incomplete."
+      when KeyError, JSON::ParserError, TypeError then "The file is missing valid Fizzy account data."
+      when ActiveRecord::ActiveRecordError then "The account contains invalid or conflicting records."
+      else "The archive could not be read or saved. Please check the file and try again."
+      end
+    end
+end
