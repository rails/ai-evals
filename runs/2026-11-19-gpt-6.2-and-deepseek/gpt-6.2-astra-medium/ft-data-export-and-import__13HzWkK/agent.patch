@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  test "a backup restores a separate account with the same cards and comments" do
+    account = accounts(:"37s")
+    Current.with_account(account) do
+      card = cards(:logo)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+      blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("Meeting notes"), filename: "会議.txt")
+      comment = card.comments.first
+      comment.update!(body: "<p>See notes</p>#{ActionText::Attachment.from_attachable(blob).to_html}")
+      export = Export.create!(user: users(:jason), account: account, kind: "account")
+      export.build_archive
+      export.archive.blob.open do |file|
+        restored = Account::DataTransfer::Restore.new(file, identities(:jason)).restore
+        assert_not_equal account, restored
+        assert_equal account.cards.pluck(:title).sort_by(&:to_s), restored.cards.pluck(:title).sort_by(&:to_s)
+        assert_equal Comment.where(account: account).count, Comment.where(account: restored).count
+        assert restored.users.find_by!(identity: identities(:jason)).owner?
+        copy = restored.cards.find_by!(number: card.number)
+        assert_equal card.image.download, copy.image.download
+        assert_not_equal card.image.key, copy.image.key
+        restored_comment = copy.comments.find_by!(created_at: comment.created_at)
+        attachment = restored_comment.body.body.attachables.sole
+        assert_equal restored, attachment.account
+        assert_equal "Meeting notes", attachment.download
+        assert_equal attachment, restored_comment.attachments.sole.blob
+      end
+    end
+  end
+
+  test "personal archive contains only visible cards, their comments and files" do
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("Design notes"), filename: "会議.txt")
+    card.comments.first.update!(body: ActionText::Attachment.from_attachable(blob).to_html)
+    Current.user = users(:kevin)
+    private_card = boards(:private).cards.create!(creator: users(:kevin), title: "Private", status: :published)
+    private_card.image.attach(io: StringIO.new("private"), filename: "private.txt")
