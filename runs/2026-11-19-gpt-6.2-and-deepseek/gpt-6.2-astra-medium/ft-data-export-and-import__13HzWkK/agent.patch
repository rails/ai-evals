@@ -0,0 +1,17 @@
+class TransferMailer < ApplicationMailer
+  def export_ready(export)
+    url = rails_blob_url(export.archive.blob, disposition: "attachment", expires_in: 1.day, script_name: export.account.slug)
+    mail to: export.user.identity.email_address, subject: "Your Fizzy export is ready",
+      body: "Download your #{export.kind} export within one day:\n\n#{url}"
+  end
+
+  def imported(identity, account)
+    mail to: identity.email_address, subject: "Your Fizzy account import is complete",
+      body: "Your imported account is ready:\n\n#{root_url(script_name: account.slug)}"
+  end
+
+  def import_failed(identity, reason)
+    mail to: identity.email_address, subject: "Your Fizzy account import failed",
+      body: "No account was imported. #{reason}"
+  end
+end
