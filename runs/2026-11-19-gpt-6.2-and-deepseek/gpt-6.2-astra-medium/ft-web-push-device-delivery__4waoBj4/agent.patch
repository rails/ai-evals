+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  test "sends an encrypted payload with VAPID and removes an expired subscription" do
+    vapid = WebPush.generate_key
+    ENV.stubs(:fetch).with("VAPID_PUBLIC_KEY").returns(vapid.public_key)
+    ENV.stubs(:fetch).with("VAPID_PRIVATE_KEY").returns(vapid.private_key)
+    device = users(:david).push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/device",
+      p256dh_key: WebPush.generate_key.public_key, auth_key: Base64.urlsafe_encode64(SecureRandom.random_bytes(16)))
+
+    request = stub_request(:post, device.endpoint).with(headers: { "Content-Encoding" => "aes128gcm" }) do |req|
+      req.headers.fetch("Authorization").start_with?("vapid t=") && !req.body.include?("Tray contents")
+    end.to_return(status: 410)
+
+    device.deliver("Tray contents")
+    assert_requested request
+    assert_predicate device, :destroyed?
+  end
+end
