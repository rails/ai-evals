index 0000000..0cf6c10
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @user = users(:david)
+    @attributes = { endpoint: "https://fcm.googleapis.com/fcm/send/device", p256dh_key: "public", auth_key: "auth" }
+  end
+
+  test "registers the current device idempotently" do
+    2.times do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @attributes }
+      assert_response :success
+    end
+
+    assert_equal @attributes.stringify_keys, @user.push_subscriptions.sole.attributes.slice(*@attributes.keys.map(&:to_s))
+  end
+
+  test "cannot register for another user" do
+    post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @attributes }
+    assert_response :forbidden
+  end
+
+  test "removes only the selected device for the current user" do
+    device = @user.push_subscriptions.create!(@attributes)
+    other = @user.push_subscriptions.create!(@attributes.merge(endpoint: "https://web.push.apple.com/other"))
+    foreign = users(:kevin).push_subscriptions.create!(@attributes)
+
+    delete user_push_subscription_path(@user, foreign)
+    assert_response :not_found
+
+    delete user_push_subscription_path(@user, device)
+    assert_response :no_content
+    assert_equal [ other ], @user.push_subscriptions.reload
+    assert foreign.reload.persisted?
+  end
+
+  test "rejects a non-push endpoint" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @attributes.merge(endpoint: "https://localhost/") }
+    assert_response :unprocessable_entity
+  end
+end
