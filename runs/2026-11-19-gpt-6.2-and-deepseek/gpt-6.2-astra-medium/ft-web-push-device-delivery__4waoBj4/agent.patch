new file mode 100644
index 0000000..507be27
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,25 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :ensure_current_user
+
+  def create
+    attributes = params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    subscription = Current.user.with_lock do
+      Current.user.push_subscriptions.find_or_initialize_by(endpoint_digest: Digest::SHA256.hexdigest(attributes[:endpoint].to_s)).tap do |record|
+        record.update!(attributes.merge(user_agent: request.user_agent))
+      end
+    end
+    render json: { id: subscription.id }, status: :created
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  def destroy
+    Current.user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def ensure_current_user
+      head :forbidden unless Current.user.id == params[:user_id]
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..1b2892b
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,86 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { registerServiceWorker } from "initializers/offline"
+
+export default class extends Controller {
+  static targets = [ "toggle", "help", "status" ]
+  static values = { url: String, key: String, devices: Object }
+
+  async connect() {
+    this.toggleTarget.disabled = true
+    if (!("serviceWorker" in navigator && "PushManager" in window && "Notification" in window)) {
+      this.#explain("Push notifications aren’t supported in this browser.")
+      return
+    }
+
+    try {
+      if (!await registerServiceWorker()) throw new Error()
+      this.registration = await navigator.serviceWorker.ready
+      const subscription = await this.registration.pushManager.getSubscription()
+      this.deviceDigest = subscription && await this.#digest(subscription.endpoint)
+      this.#refresh()
+    } catch {
+      this.#explain("Couldn’t check notifications on this device.")
+    }
+  }
+
+  async toggle() {
+    this.toggleTarget.disabled = true
+    try {
+      if (this.#deviceId) {
+        await this.#disable()
+      } else if (await Notification.requestPermission() === "granted") {
+        await this.#enable()
+      }
+      this.#refresh()
+    } catch {
+      this.#refresh()
+      this.#explain("Couldn’t change notifications. Please try again.")
+    }
+  }
+
+  get #deviceId() {
+    return this.devicesValue[this.deviceDigest]
+  }
+
+  async #enable() {
+    const manager = this.registration.pushManager
+    const subscription = await manager.getSubscription() || await manager.subscribe({
+      userVisibleOnly: true, applicationServerKey: this.keyValue
+    })
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.urlValue, {
+      responseKind: "json",
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } }
+    })
+    if (!response.ok) throw new Error()
+
+    this.deviceDigest = await this.#digest(endpoint)
+    this.devicesValue = { ...this.devicesValue, [this.deviceDigest]: (await response.json).id }
+  }
+
+  async #disable() {
+    // Other accounts on this browser can share the underlying PushSubscription.
+    const response = await destroy(`${this.urlValue}/${this.#deviceId}`)
+    if (!response.ok && response.statusCode !== 404) throw new Error()
+    this.devicesValue = { ...this.devicesValue, [this.deviceDigest]: null }
+  }
+
+  #refresh() {
+    const blocked = Notification.permission === "denied"
+    this.element.classList.toggle("notifications--on", !!this.#deviceId)
+    this.toggleTarget.disabled = blocked && !this.#deviceId
+    this.helpTarget.hidden = !blocked
+    this.statusTarget.textContent = blocked ? "Notifications are blocked on this device." : ""
+  }
+
+  #explain(message) {
+    this.statusTarget.textContent = message
+    this.helpTarget.hidden = false
+  }
+
+  async #digest(endpoint) {
+    const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(endpoint))
+    return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, "0")).join("")
+  }
+}
