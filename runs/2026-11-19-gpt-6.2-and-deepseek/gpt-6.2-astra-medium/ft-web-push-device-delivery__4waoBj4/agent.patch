diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..5b47500
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,32 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :user
+  belongs_to :account, default: -> { user.account }
+
+  before_validation { self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s) }
+  validates :p256dh_key, :auth_key, presence: true, length: { maximum: 255 }
+  validate :endpoint_is_push_service
+
+  def deliver(message)
+    WebPush.payload_send(message: message, endpoint: endpoint, p256dh: p256dh_key, auth: auth_key,
+      vapid: { public_key: ENV.fetch("VAPID_PUBLIC_KEY"), private_key: ENV.fetch("VAPID_PRIVATE_KEY") },
+      open_timeout: 5, read_timeout: 10)
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy!
+  end
+
+  private
+    # Don't let a posted endpoint turn a background worker into an arbitrary HTTP client.
+    def endpoint_is_push_service
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.port == 443 && !uri.userinfo && push_service_host?(uri.host)
+        errors.add :endpoint, "must be an HTTPS push service URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "is not a URL"
+    end
+
+    def push_service_host?(host)
+      host == "fcm.googleapis.com" ||
+        host.to_s.end_with?(".push.apple.com", ".push.services.mozilla.com", ".notify.windows.com")
+    end
+end
