+++ b/test/jobs/push/delivery_job_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Push::DeliveryJobTest < ActiveSupport::TestCase
+  setup do
+    Push.stubs(:configured?).returns(true)
+    @user = users(:kevin)
+    @subscription = @user.push_subscriptions.create!(endpoint: "https://web.push.apple.com/device", p256dh_key: "public", auth_key: "auth")
+  end
+
+  test "enqueues once per device for a new tray entry and when its source changes" do
+    @user.push_subscriptions.create!(endpoint: "https://web.push.apple.com/phone", p256dh_key: "other", auth_key: "auth")
+    notification = notifications(:logo_assignment_kevin)
+    attributes = notification.attributes.slice("user_id", "creator_id", "source_type", "source_id")
+    notification.destroy!
+
+    assert_enqueued_jobs 2, only: Push::DeliveryJob do
+      notification = Notification.create!(attributes)
+    end
+    assert_enqueued_jobs 2, only: Push::DeliveryJob do
+      notification.update!(source: mentions(:logo_card_david_mention_by_jz))
+    end
+    assert_no_enqueued_jobs only: Push::DeliveryJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "delivers tray text and a tenant-scoped card link for events and mentions" do
+    [ notifications(:layout_commented_kevin), notifications(:logo_mentioned_david) ].each do |notification|
+      subscription = notification.user.push_subscriptions.first || notification.user.push_subscriptions.create!(
+        endpoint: "https://web.push.apple.com/other", p256dh_key: "public", auth_key: "auth")
+      renderer = ApplicationController.renderer.new(script_name: notification.account.slug)
+      tray = JSON.parse(renderer.render(partial: "notifications/notification", formats: [ :json ], locals: { notification: notification }))
+
+      subscription.expects(:deliver).with do |message|
+        payload = JSON.parse(message)
+        assert_equal tray.slice("title", "body"), payload.slice("title", "body")
+        assert_equal "#{notification.account.slug}/cards/#{notification.card.number}", payload.fetch("url")
+      end
+      Push::DeliveryJob.perform_now(subscription, notification, notification.source)
+    end
+  end
+end
