--- /dev/null
+++ b/app/jobs/push/delivery_job.rb
@@ -0,0 +1,11 @@
+class Push::DeliveryJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError, wait: :polynomially_longer
+
+  def perform(subscription, notification, source)
+    if Push.configured? && subscription.user.accessible_cards.exists?(notification.card_id)
+      renderer = ApplicationController.renderer.new(script_name: subscription.account.slug)
+      subscription.deliver renderer.render(template: "notifications/push", formats: [ :json ], locals: { source: source })
+    end
+  end
+end
