+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  test "registering and disabling this browser from settings" do
+    key = WebPush.generate_key
+    public_key, ENV["VAPID_PUBLIC_KEY"] = ENV["VAPID_PUBLIC_KEY"], key.public_key
+    private_key, ENV["VAPID_PRIVATE_KEY"] = ENV["VAPID_PRIVATE_KEY"], key.private_key
+    sign_in_as(users(:david))
+    visit notifications_settings_path
+
+    assert_button "Turn on notifications", disabled: false
+    # Stand in for the permission prompt and an external push service.
+    page.execute_script <<~JS
+      Notification.requestPermission = async () => "granted"
+      PushManager.prototype.subscribe = async () => ({ toJSON() { return {
+        endpoint: "https://web.push.apple.com/device", keys: { p256dh: "public", auth: "auth" }
+      } } })
+    JS
+    click_button "Turn on notifications"
+    assert_button "Turn off notifications"
+    assert_equal "https://web.push.apple.com/device", users(:david).push_subscriptions.sole.endpoint
+
+    click_button "Turn off notifications"
+    assert_button "Turn on notifications", disabled: false
+    assert_empty users(:david).push_subscriptions.reload
+  ensure
+    ENV["VAPID_PUBLIC_KEY"] = public_key
+    ENV["VAPID_PRIVATE_KEY"] = private_key
+  end
+end
