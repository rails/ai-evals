new file mode 100644
index 0000000..67737f1
--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,9 @@
+# Only a refresh hint crosses this channel. State is always read via the
+# authenticated (moderator) or player-specific HTTP endpoint.
+class GameChannel < ActionCable::Channel::Base
+  def subscribed
+    stream = Rails.application.message_verifier(:game_stream).verified(params[:ticket])
+    return reject unless stream
+    stream_from stream
+  end
+end
diff --git a/app/controllers/concerns/live_view.rb b/app/controllers/concerns/live_view.rb
new file mode 100644
index 0000000..687a872
--- /dev/null
+++ b/app/controllers/concerns/live_view.rb
@@ -0,0 +1,24 @@
+module LiveView
+  private
+
+  def live_view(partial, stream, *state)
+    no_store
+    @view_key = ActiveSupport::Digest.hexdigest(state.to_json)
+    return head :no_content if request.headers["X-Game-Version"] == @view_key
+    @partial = partial
+    @ticket = Rails.application.message_verifier(:game_stream).generate(stream)
+    if request.headers["X-Game-Version"]
+      render partial: "live/state"
+    else
+      render "live/show"
+    end
+  end
+
+  def notify_screen
+    ActionCable.server.broadcast("screen:#{@game.code}", "refresh")
+  end
+
+  def mutation_response(path)
+    request.xhr? ? head(:no_content) : redirect_to(path, status: :see_other)
+  end
+end
