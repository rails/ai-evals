@@ -0,0 +1,40 @@
+class Moderate::GamesController < Moderate::BaseController
+  include LiveView
+  before_action :load_game, except: :create
+
+  def create
+    redirect_to moderate_game_path(Game.for_quiz!(Quiz.find(params[:quiz_id]))), status: :see_other
+  end
+
+  def show
+    if @game.phase == "open" || @game.phase == "closed"
+      answers = @game.answers.where(round: @game.round)
+      @counts = answers.group(:option).count
+      # A phone that already voted need not stay awake for its vote to count.
+      @players = @counts.values.sum + @game.players.present_now.where.not(id: answers.select(:player_id)).count
+    elsif @game.phase == "lobby"
+      @players = @game.players.present_now.count
+    end
+    live_view("moderate/games/screen", "screen:#{@game.code}", @game.phase, @game.round, @counts, @players)
+  end
+
+  def qr
+    url = play_url(@game.code)
+    image = RQRCode::QRCode.new(url).as_png(module_px_size: 9)
+    send_data image.to_s, type: "image/png", disposition: "inline"
+  end
+
+  def advance
+    if @game.advance!(params[:command], Integer(params[:round], exception: false))
+      notify_screen
+      ActionCable.server.broadcast("play:#{@game.code}", "refresh")
+    end
+    mutation_response(moderate_game_path(@game))
+  end
+
+  private
+
+  def load_game
+    @game = Game.find(params[:id])
+  end
+end
diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..9a9e2b4
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,44 @@
+class PlayController < ApplicationController
+  include LiveView
+  before_action :identify
+
+  def show
+    if @player && @game.phase != "ended"
+      if @player.seen_at < 20.seconds.ago
+        returning = @player.seen_at < Player::LEASE.ago
+        @player.update_column(:seen_at, Time.current)
+        notify_screen if returning
+      end
+      @pick = @player.answers.find_by(round: @game.round)&.option
+    end
+    phase = !@player && @game.phase != "ended" ? "join" : @game.phase
+    live_view("play/phone", "play:#{@game.code}", phase, (@game.round if @player), @player&.id, @pick)
+  end
+
+  def join
+    @game.with_lock do
+      unless @game.phase == "ended" || @player
+        player = @game.players.create!(name: params[:name].to_s.strip, seen_at: Time.current)
+        cookies.permanent.signed[:quizzy_player] = { value: player.id, path: play_path(@game.code), httponly: true, same_site: :lax }
+      end
+    end
+    notify_screen
+    mutation_response(play_path(@game.code))
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_content
+  end
+
+  def answer
+    return head :forbidden unless @player
+    notify_screen if @game.record_answer!(@player, Integer(params[:round], exception: false), Integer(params[:option], exception: false))
+    mutation_response(play_path(@game.code))
+  end
+
+  private
+
+  def identify
+    @game = Game.find_by!(code: params[:code])
+    id = cookies.signed[:quizzy_player]
+    @player = @game.players.find_by(id: id) if id
+  end
+end
