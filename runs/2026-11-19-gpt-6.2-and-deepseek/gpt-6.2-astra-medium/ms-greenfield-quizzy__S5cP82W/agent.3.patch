diff --git a/README.md b/README.md
index b0363e3..2092257 100644
--- a/README.md
+++ b/README.md
@@ -11,3 +11,11 @@ Set `SECRET_KEY_BASE`, `QUIZZY_MODERATOR_USERNAME` and `QUIZZY_MODERATOR_PASSWOR
 Quizzes own ordered questions. Each question stores its text options and correctness flags as one ordered JSON array so an edit succeeds or fails as a unit. Preview uses the active questions in that order; choices and score live only in the current browser page, with no answer requests, cookies or local storage used to record them.
 
 Run `bin/rails test` for the request tests and `bin/rails test:system` for the Chromium workflows.
+
+## Live games
+
+On a quiz page, **Start a game** creates a separate run with a snapshot of the title and active questions. Share its `/play/:code` URL with the audience. A persistent, signed, path-scoped cookie remembers each phone for that run. Votes are unique per player and round. Writes check the current phase and round in a transaction so a delayed tap cannot answer a later question.
+
+The default single-process Puma server uses Action Cable’s in-process adapter; no Redis or other service is required. WebSocket messages only signal a change. The projector and each phone fetch their own state, coalescing notifications, resyncing on reconnect and polling if WebSockets are unavailable. An unchanged view gets an empty response. The public view includes only the current question, with correctness withheld until the moderator closes it.
+
+Presence uses a 90-second lease, refreshed by periodic state checks. This tolerates brief Wi-Fi drops without counting a disconnected phone indefinitely. An already-cast vote still counts for that round if the phone goes to sleep. Rejoining the same game restores the player and their answer.
diff --git a/app/assets/javascripts/live_game.js b/app/assets/javascripts/live_game.js
new file mode 100644
index 0000000..8028f69
--- /dev/null
+++ b/app/assets/javascripts/live_game.js
@@ -0,0 +1,80 @@
+// Notifications are hints, never deltas: reconnects always reconcile from the
+// server. Coalesce bursts of votes and allow only one state request at a time.
+(() => {
+  const root = document.querySelector('[data-game-ticket]');
+  const state = () => root.firstElementChild;
+  if (state().hasAttribute('data-ended')) return;
+  const notice = document.querySelector('#game-notice');
+  const consumer = ActionCable.createConsumer(location.origin + '/cable');
+  let connected = false, busy = false, pending = false, timer, due = Infinity;
+
+  function schedule(delay = 80) {
+    if (state().hasAttribute('data-ended')) return;
+    if (busy) { pending = true; return; }
+    const time = Date.now() + delay;
+    if (time >= due) return;
+    clearTimeout(timer);
+    due = time;
+    timer = setTimeout(refresh, delay);
+  }
+  async function refresh() {
+    due = Infinity;
+    let retry = false;
+    busy = true;
+    try {
+      const response = await fetch(location.origin + location.pathname, {
+        headers: { 'X-Game-Version': state().dataset.gameVersion }, signal: AbortSignal.timeout(10000)
+      });
+      if (!response.ok) throw Error();
+      if (response.status !== 204) {
+        const template = document.createElement('template');
+        template.innerHTML = await response.text();
+        const next = template.content.firstElementChild;
+        const counter = state().querySelector('[data-counter]');
+        if (counter && state().dataset.stage === next.dataset.stage) {
+          counter.textContent = next.querySelector('[data-counter]').textContent;
+          state().dataset.gameVersion = next.dataset.gameVersion;
+        } else {
+          state().replaceWith(next);
+        }
+      }
+      if (state().hasAttribute('data-ended')) consumer.disconnect();
+    } catch {
+      retry = true; // Reconcile again soon without discarding form input.
+    } finally {
+      busy = false;
+      schedule(pending ? 0 : (connected && !retry ? 22000 : 1600) + Math.random() * 500);
+      pending = false;
+    }
+  }
+  consumer.subscriptions.create({ channel: 'GameChannel', ticket: root.dataset.gameTicket }, {
+    connected() { connected = true; schedule(0); },
+    disconnected() { connected = false; schedule(500); },
+    received() { connected = true; schedule(); }
+  });
+  document.addEventListener('visibilitychange', () => { if (!document.hidden) schedule(0); });
+  window.addEventListener('online', () => schedule(0));
+  schedule(1500);
+
+  // Queue choices so a delayed POST cannot overtake a later tap.
+  let writes = Promise.resolve();
+  root.addEventListener('submit', event => {
+    event.preventDefault();
+    const form = event.target;
+    const data = new FormData(form);
+    const url = location.origin + new URL(form.action).pathname;
+    writes = writes.then(async () => {
+      try {
+        const response = await fetch(url, { method: 'POST', body: data,
+          headers: { 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': document.querySelector('meta[name=csrf-token]')?.content || '' },
+          signal: AbortSignal.timeout(15000) });
+        if (!response.ok) throw Error();
+        notice.hidden = true;
+      } catch {
+        notice.textContent = 'Could not confirm your submission. Check your connection and try again.';
+        notice.hidden = false;
+      }
+      schedule(0);
+    });
+  });
+})();
