@@ -0,0 +1,51 @@
+require "test_helper"
+require "capybara/cuprite"
+
+class LiveGameBrowserTest < ActionDispatch::SystemTestCase
+  driven_by :cuprite, options: { browser_path: "/usr/bin/chromium", browser_options: { "no-sandbox" => nil }, js_errors: true }
+
+  test "phones and projector follow the same game without navigations" do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "host"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "password"
+    page.driver.browser.headers.set("Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("host", "password"))
+    quiz = Quiz.create!(title: "Space")
+    options = [{ "text" => "Earth", "correct" => true }, { "text" => "Pluto", "correct" => false }]
+    quiz.questions.create!(body: "A planet?", position: 1, options: options)
+    visit moderate_quiz_path(quiz)
+    click_button "Start a game"
+    join_url = find(".lobby__url").text
+    assert_text "Players: 0"
+    assert page.evaluate_script("document.querySelector('.qr').naturalWidth > 0")
+    page.execute_script("window.navigationMarker = true")
+    using_session(:phone) do
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+      visit join_url
+      assert_text "Hi, Alice!"
+      page.execute_script("window.navigationMarker = true")
+    end
+    assert_text "Players: 1"
+    click_button "Start"
+    assert_text "Answers: 0 / 1"
+    using_session(:phone) do
+      click_button "Pluto"
+      assert_button "Pluto Your answer"
+      click_button "Earth"
+      assert_button "Earth Your answer"
+      assert_no_selector ".is-correct", visible: :all
+    end
+    assert_text "Answers: 1 / 1"
+    click_button "Finish"
+    assert_selector "li.is-correct", text: /Earth.*Correct.*1/m
+    using_session(:phone) { assert_text "Correct!" }
+    click_button "End quiz"
+    assert_text "The quiz is over"
+    assert page.evaluate_script("window.navigationMarker")
+    using_session(:phone) do
+      assert_text "The quiz is over"
+      assert page.evaluate_script("window.navigationMarker")
+    end
+  end
+end
