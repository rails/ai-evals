diff --git a/test/models/game_prizes_test.rb b/test/models/game_prizes_test.rb
new file mode 100644
index 0000000..935af31
--- /dev/null
+++ b/test/models/game_prizes_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class GamePrizesTest < ActiveSupport::TestCase
+  setup do
+    @quiz = Quiz.create!(title: "Final", number_of_winners: 2)
+    2.times do |i|
+      @quiz.questions.create!(position: i, body: "Question #{i}", options: [
+        { "text" => "Yes", "correct" => true }, { "text" => "No", "correct" => false }
+      ])
+    end
+    @game = Game.for_quiz!(@quiz)
+    @players = %w[A B C D].map { |name| @game.players.create!(name: name, seen_at: Time.current) }
+  end
+
+  test "only final correct picks count, ranked by points then total elapsed time" do
+    a, b, c, d = @players
+    @quiz.update!(number_of_winners: 1)
+    @game.advance!("start", 0)
+    refute @game.select_winners!("top")
+    pick_after(1, b)
+    pick_after(2, a)
+    pick_after(3, d)
+    pick_after(4, b) # Even a repeat of the same choice updates its time.
+    pick_after(5, d, 1)
+    @game.advance!("finish", 0)
+    travel_to(1.hour.from_now) { @game.advance!("next", 0) }
+    pick_after(3, c)
+    pick_after(5, a)
+    end_game
+    assert_equal [a.id, c.id, b.id, d.id], @game.leaderboard.pluck(:id)
+    assert_equal [2, 1, 1, 0], @game.leaderboard.pluck(:points)
+    assert_equal [7, 3, 4, 0].map { |s| s * 1_000_000 }, @game.leaderboard.pluck(:time)
+    @game.select_winners!("top")
+    assert_equal [a.id, c.id], @game.reload.winner_ids
+    10.times do
+      @game.select_winners!("draw")
+      assert_equal a.id, @game.winner_ids.first
+      assert_includes [b.id, c.id], @game.winner_ids.last
+      assert_equal 2, @game.winner_ids.size
+    end
+    @game.select_winners!("reset")
+    assert_empty @game.reload.winner_ids
+  end
+
+  test "unclaimed prizes never go to zero scores" do
+    @game.advance!("start", 0)
+    @game.advance!("finish", 0)
+    @game.advance!("next", 0)
+    pick_after(1, @players.first)
+    end_game
+    %w[top draw].each do |mode|
+      @game.select_winners!(mode)
+      assert_equal [@players.first.id], @game.winner_ids
+    end
+  end
+
+  test "a quiz with no rounds or participants can end and draw" do
+    @quiz.questions.delete_all
+    game = Game.for_quiz!(@quiz)
+    game.advance!("start", 0)
+    assert game.select_winners!("draw")
+    assert_empty game.winner_ids
+  end
+
+  test "winner limit must be a positive integer" do
+    assert_equal 3, Quiz.new.number_of_winners
+    [0, -1, 1.5, nil].each do |invalid|
+      assert_not @quiz.update(number_of_winners: invalid)
+    end
+  end
+
+  private
+
+  def pick_after(seconds, player, option = 0)
+    travel_to(@game.opened_at + seconds, with_usec: true) do
+      @game.record_answer!(player, @game.round, option)
+    end
+  end
+
+  def end_game
+    @game.advance!("finish", 1)
+    @game.advance!("end", 1)
+  end
+end
