diff --git a/app/services/quiz_document.rb b/app/services/quiz_document.rb
new file mode 100644
index 0000000..285dfeb
--- /dev/null
+++ b/app/services/quiz_document.rb
@@ -0,0 +1,48 @@
+# Portable quiz content, independent of record IDs and database column names.
+module QuizDocument
+  extend self
+
+  class Invalid < StandardError; end
+
+  def dump(quiz)
+    JSON.pretty_generate(title: quiz.title, questions: quiz.questions.map do |question|
+      { text: question.body, active: question.active?, options: question.options.map { |o| o.slice("text", "correct") } }
+    end)
+  end
+
+  def import!(json)
+    doc = JSON.parse(json)
+    Quiz.transaction do
+      quiz = Quiz.create!(title: field(doc, "title", String))
+      field(doc, "questions", Array).each_with_index do |question, i|
+        options = field(question, "options", Array).map do |option|
+          { "text" => field(option, "text", String), "correct" => flag(option, "correct", false) }
+        end
+        quiz.questions.create!(position: i + 1, body: field(question, "text", String),
+          active: flag(question, "active", true), options: options)
+      rescue Invalid, ActiveRecord::RecordInvalid => e
+        raise Invalid, "Question #{i + 1}: #{e.message}"
+      end
+      quiz
+    end
+  rescue JSON::ParserError
+    raise Invalid, "Enter valid JSON."
+  rescue ActiveRecord::RecordInvalid => e
+    raise Invalid, e.record.errors.full_messages.to_sentence
+  end
+
+  private
+
+  def field(object, key, type)
+    raise Invalid, "Expected a JSON object containing #{key}." unless object.is_a?(Hash)
+    value = object[key]
+    raise Invalid, "#{key} must be a #{type.name.downcase}." unless value.is_a?(type)
+    value
+  end
+
+  def flag(object, key, default)
+    value = object.fetch(key, default)
+    raise Invalid, "#{key} must be true or false." unless value == true || value == false
+    value
+  end
+end
