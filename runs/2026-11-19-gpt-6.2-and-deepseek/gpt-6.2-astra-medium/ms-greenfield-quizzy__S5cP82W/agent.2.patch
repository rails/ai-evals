+class Moderate::ImportsController < Moderate::BaseController
+  def new
+  end
+
+  def create
+    @json = params.permit(:quiz_json)[:quiz_json].to_s
+    quiz = QuizDocument.import!(@json)
+    redirect_to moderate_quiz_path(quiz), status: :see_other
