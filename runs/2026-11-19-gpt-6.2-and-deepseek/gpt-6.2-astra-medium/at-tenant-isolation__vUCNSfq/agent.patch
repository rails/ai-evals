diff --git a/test/integration/tenant_access_test.rb b/test/integration/tenant_access_test.rb
new file mode 100644
index 0000000..0d0395b
--- /dev/null
+++ b/test/integration/tenant_access_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class TenantAccessTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant = Tenant.create!(name: "A")
+    @other = Tenant.create!(name: "B")
+    users(:david).update!(tenant: @tenant)
+    books(:manual).update!(tenant: @tenant)
+    books(:handbook).update!(tenant: @other)
+    sign_in :david
+  end
+
+  test "foreign grants and publication do not expose a book, page or edit" do
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+    leaf.edit leafable_params: { body: "Revision" }
+
+    [ false, true ].each do |published|
+      book.update!(published: published)
+      get root_path
+      assert_in_body "Manual"
+      assert_not_in_body "Handbook"
+
+      [ book_slug_path(book), edit_book_path(book), book_page_path(book, leaf), leafable_slug_path(leaf),
+        page_edit_path(leaf, leaf.edits.last), page_edit_path(leaf, "latest") ].each do |path|
+        get path
+        assert_response :not_found, path
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :success
+
+    book.update!(tenant: @tenant)
+    get page_edit_path(leaf, "latest")
+    assert_response :success
+  end
+
+  test "signed-out visitors see published books in both tenants" do
+    books(:manual).update!(published: true)
+    books(:handbook).update!(published: true)
+    sign_out
+
+    get root_path
+    assert_in_body "Handbook"
+    assert_in_body "Manual"
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+  end
+
+  test "new tenant members get only their tenant's everyone books" do
+    user = @tenant.users.create!(name: "New member", email_address: "new@example.com", password: "secret123456")
+    assert_equal [ books(:manual).id ], user.accesses.pluck(:book_id)
+  end
+
+  test "creation and everyone sharing use the creator's tenant" do
+    users(:kevin).update!(tenant: @tenant)
+    users(:jason).update!(tenant: @other)
+    post books_path, params: { book: { title: "A only", everyone_access: true }, editor_ids: [ users(:jason).id ] }
+
+    book = Book.last
+    assert_equal @tenant, book.tenant
+    assert_equal [ users(:david).id, users(:kevin).id ].sort, book.accesses.order(:user_id).pluck(:user_id)
+  end
+end
