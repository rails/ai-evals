index 0000000..2801b5a
--- /dev/null
+++ b/db/migrate/20240929000000_add_tenants.rb
@@ -0,0 +1,19 @@
+class AddTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |dir|
+      dir.up do
+        execute "INSERT INTO tenants (name, created_at, updated_at) VALUES ('Writebook', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)"
+        execute "UPDATE users SET tenant_id = (SELECT id FROM tenants)"
+        execute "UPDATE books SET tenant_id = (SELECT id FROM tenants)"
+      end
+    end
+  end
+end
