diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..a763b5f
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,20 @@
+class Reaction < ApplicationRecord
+  MAX_LENGTH = 16
+
+  belongs_to :comment
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: MAX_LENGTH }
+
+  after_save :expire_comment_cache
+  after_destroy :expire_comment_cache
+  after_create_commit -> { broadcast_append_later_to comment.card, target: [ comment, :reactions ] }
+  after_destroy_commit -> { broadcast_remove_to comment.card }, unless: -> { destroyed_by_association&.active_record == Comment }
+
+  private
+    def expire_comment_cache
+      # Expire the rendered comment without cascading a page refresh through its card and board.
+      Comment.where(id: comment_id).touch_all
+    end
+end
