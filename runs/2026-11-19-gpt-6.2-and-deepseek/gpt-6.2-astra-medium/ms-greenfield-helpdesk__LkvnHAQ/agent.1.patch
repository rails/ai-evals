+class AccountMailer < ApplicationMailer
+  def verification(user, token)
+    send_link(user, token, 'verify-email', 'Verify your email')
+  end
+
+  def reset(user, token)
+    send_link(user, token, 'reset-password', 'Reset your password')
+  end
+
+  private
+
+  def send_link(user, token, path, subject)
+    base = Rails.configuration.x.frontend_url
+    query = URI.encode_www_form(account: user.account.subdomain, token: token)
+    mail(to: user.email, subject: subject, content_type: 'text/plain', body: "#{subject}: #{base}/#{path}?#{query}\n")
+  end
+end
