+module Api
+  module V1
+    class ProfileController < BaseController
+      def show
+        render json: { user: @user.public_attributes }
+      end
+
+      def update
+        @user.update!(fields(:user, :name))
+        show
+      end
+
+      def password
+        change = fields(:password_change, :current_password, :password)
+        return error('Incorrect current password', :unauthorized) unless @user.authenticate(change[:current_password])
+        @user.replace_password!(change[:password])
+        head :no_content
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/sessions_controller.rb b/app/controllers/api/v1/sessions_controller.rb
new file mode 100644
index 0000000..764fac0
--- /dev/null
+++ b/app/controllers/api/v1/sessions_controller.rb
@@ -0,0 +1,26 @@
+module Api
+  module V1
+    class SessionsController < BaseController
+      skip_before_action :authenticate, only: :create
+      skip_before_action :require_active_account
+
+      def create
+        credentials = fields(:session, :email, :password)
+        user = @account.users.authenticate_by(credentials)
+        return error('Invalid credentials', :unauthorized) unless user
+        return error('Verify your email first', :forbidden) unless user.verified?
+        if @account.expired? || (@account.cancelled_at && !user.owner?)
+          return error('Account is cancelled', :forbidden)
+        end
+
+        token = user.sessions.build.issue!
+        render json: { user: user.public_attributes, account: @account.public_attributes, session: { token: token } }
+      end
+
+      def destroy
+        @session.destroy!
+        head :no_content
+      end
+    end
+  end
+end
