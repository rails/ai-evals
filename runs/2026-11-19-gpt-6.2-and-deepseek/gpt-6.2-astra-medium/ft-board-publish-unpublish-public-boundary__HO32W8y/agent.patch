diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..09f6df5
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,13 @@
+module Board::Publishable
+  def published?
+    public_key.present?
+  end
+
+  def publish
+    with_lock { update!(public_key: SecureRandom.hex(24)) unless published? }
+  end
+
+  def unpublish
+    update!(public_key: nil)
+  end
+end
