@@ -0,0 +1,19 @@
+class Public::BaseController < ApplicationController
+  allow_unauthenticated_access
+  layout "public"
+
+  before_action :set_public_board
+  after_action :protect_secret_link
+
+  private
+    def set_public_board
+      raise ActiveRecord::RecordNotFound unless Current.account.active?
+
+      @board = Current.account.boards.find_by!(public_key: params[:key])
+    end
+
+    def protect_secret_link
+      no_store
+      response.headers["Referrer-Policy"] = "no-referrer"
+    end
+end
