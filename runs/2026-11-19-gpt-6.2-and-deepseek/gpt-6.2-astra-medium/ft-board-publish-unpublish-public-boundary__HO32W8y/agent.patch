 To change who has access, use `PUT /:account_slug/boards/:board_id` with the `user_ids` parameter.
+
+## `POST /:account_slug/boards/:board_id/publication`
+
+Publishes a board and returns its board JSON, including `public_url`. Only account admins with access to the board can publish it. Repeating this request keeps the same URL.
+
+Treat `public_url` as a secret: anyone with the link can read the board without signing in. Append `/columns/:id` to view a column or `/cards/:number` to view a published card. Drafts are never shared.
+
+## `DELETE /:account_slug/boards/:board_id/publication`
+
+Unpublishes the board (`204 No Content`). This requires the same permission as publishing. `public_url` becomes `null`, and the old board, column, and card links stop working. Publishing again creates a new URL.
diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..b7b64a4
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "admins can share and revoke a board URL" do
+    sign_in_as :kevin
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body.fetch("public_url")
+
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    get board_path(@board), as: :json
+    url = response.parsed_body.fetch("public_url")
+    post board_publication_path(@board), as: :json
+    assert_equal url, response.parsed_body.fetch("public_url")
+    sign_out
+
+    card = cards(:logo)
+    get url
+    assert_response :success
+    assert_select "a[href=?]", "#{URI(url).path}/cards/#{card.number}", text: card.title
+    get "#{url}/columns/#{card.column.id}"
+    assert_response :success
+    get "#{url}/cards/#{card.number}"
+    assert_response :success
+    assert_select "h1", text: card.title
+
+    sign_in_as :kevin
+    delete board_publication_path(@board), as: :json
+    assert_response :success
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body.fetch("public_url")
+    get "#{url}/cards/#{card.number}"
+    assert_response :not_found
+    get "#{url}/columns/#{card.column.id}"
+    assert_response :not_found
+    get url
+    assert_response :not_found
+
+    post board_publication_path(@board), as: :json
+    get url
+    assert_response :not_found
+  end
+
+  test "even the board creator cannot publish or unpublish without admin rights" do
+    sign_in_as :david
+    post board_publication_path(@board)
+    assert_response :forbidden
+    delete board_publication_path(@board)
+    assert_response :forbidden
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..1eed933
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  test "a public key grants read access only to its board and published cards" do
+    board = boards(:private)
+    board.publish
+    column = board.columns.create!(name: "Review", color: "var(--color-card-1)")
+    draft = board.cards.create!(creator: users(:kevin), title: "Private draft", column: column, status: :drafted)
+
+    get public_board_path(board.public_key)
+    assert_response :success
+    assert_select "a[href=?]", public_board_column_path(board.public_key, column)
+    assert_not_includes response.body, draft.title
+
+    get public_board_column_path(board.public_key, column)
+    assert_response :success
+    assert_not_includes response.body, draft.title
+
+    get public_board_card_path(board.public_key, draft)
+    assert_response :not_found
+    get public_board_card_path(board.public_key, cards(:logo))
+    assert_response :not_found
+    get public_board_column_path(board.public_key, columns(:writebook_triage))
+    assert_response :not_found
+
+    get public_board_path(board.public_key, script_name: accounts(:initech).slug)
+    assert_response :not_found
+    get public_board_path(board.id)
+    assert_response :not_found
+  end
+end
