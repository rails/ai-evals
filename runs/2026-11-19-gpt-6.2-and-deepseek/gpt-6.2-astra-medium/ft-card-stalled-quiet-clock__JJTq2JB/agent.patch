+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  test "stalled cards are flagged in previews and on the card until activity resumes" do
+    sign_in_as users(:david)
+    card = cards(:buy_domain)
+    card.update!(had_burst: true, last_active_at: 15.days.ago)
+
+    visit cards_url(indexed_by: "stalled")
+    assert_selector ".bubble", text: /stalled/i
+    visit card_url(card)
+    assert_selector ".bubble", text: /stalled/i
+
+    find(".comment--new [contenteditable=true]").send_keys("Working on it")
+    click_on "Post"
+    assert_no_selector ".bubble", text: /stalled/i
+  end
+end
