diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..f8a7b23
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:buy_domain)
+    freeze_time
+  end
+
+  test "an assignment followed by two quiet weeks stalls until the next activity" do
+    @card.toggle_assignment(users(:jz))
+    travel 2.weeks - 1.second
+    assert_not @card.reload.stalled?
+    travel 1.second
+    assert @card.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.reactions.create!(content: "👍")
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "editing the card restarts the inactivity clock" do
+    @card.toggle_assignment(users(:jz))
+    travel 2.weeks
+    @card.update!(description: "Revised scope")
+    assert_not @card.reload.stalled?
+    travel 2.weeks
+    assert @card.stalled?
+    @card.steps.create!(content: "Follow up")
+    assert_not @card.reload.stalled?
+  end
+
+  test "reopening starts a burst" do
+    @card.close
+    @card.reopen
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "two people still need a third comment, using the account period if the board inherits it" do
+    @card.board.entropy.destroy!
+    @card.reload
+    comment_by :jz
+    comment_by :david
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+
+    comment_by :jz
+    travel 10.days
+    2.times { comment_by :david }
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "three comments need two people within a third of the board period" do
+    @card.board.update!(auto_postpone_period: 3.days)
+    comment_by :jz
+    travel 1.day + 1.second
+    3.times { comment_by :david }
+    comment_by :system
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+
+    comment_by :jz
+    travel 1.day
+    2.times { comment_by :david }
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  private
+    def comment_by(person)
+      @card.comments.create!(body: "A comment", creator: users(person))
+    end
+end
