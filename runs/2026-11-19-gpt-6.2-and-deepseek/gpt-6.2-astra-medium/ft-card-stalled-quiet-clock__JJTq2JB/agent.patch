diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..aa8bdbb
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,33 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  QUIET_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> { where(had_burst: true, last_active_at: ..QUIET_PERIOD.ago) }
+  end
+
+  def stalls_at
+    last_active_at + QUIET_PERIOD if had_burst?
+  end
+
+  def stalled?
+    had_burst? && stalls_at <= Time.current
+  end
+
+  def register_comment_activity(comment)
+    self.had_burst ||= comment_burst?(around: comment.created_at)
+    touch_last_active_at
+  end
+
+  def comment_burst?(around: nil)
+    window = auto_postpone_period / 3
+    candidates = comments.by_user
+    candidates = candidates.where(created_at: (around - window)..(around + window)) if around
+
+    # Every qualifying window contains three consecutive comments with mixed authors.
+    candidates.select(:id, :created_at, :creator_id).find_each(cursor: [ :created_at, :id ]).each_cons(3).any? do |first, middle, last|
+      last.created_at - first.created_at <= window && (first.creator_id != middle.creator_id || first.creator_id != last.creator_id)
+    end
+  end
+end
