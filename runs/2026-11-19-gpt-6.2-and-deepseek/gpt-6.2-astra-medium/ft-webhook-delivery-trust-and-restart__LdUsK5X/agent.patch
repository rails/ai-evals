--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -10,6 +10,27 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).in_batches.delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    # Claim before I/O: a replay after an ambiguous timeout must never send again.
+    return unless self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+
+    if !webhook.reload.active?
+      update!(state: :errored, response: { error: "webhook_inactive" })
+    elsif event.board_id != webhook.board_id || event.card.board_id != webhook.board_id
+      update!(state: :errored, response: { error: "board_changed" })
+    else
+      post_event
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +50,24 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def post_event
+      post = Webhook::Post.new(self)
+      update!(request: { headers: post.headers.except("X-Webhook-Signature") })
+      record_result(post.send_request)
+    rescue ActionView::Template::Error => error
+      Rails.error.report(error)
+      update!(state: :errored, response: { error: "payload_unavailable" })
+    end
+
+    def record_result(result)
+      webhook.with_lock do
+        update!(state: result[:error] ? :errored : :completed, response: result)
+        if webhook.active?
+          tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+          succeeded? ? tracker.reset : tracker.record_failure
+        end
+      end
+    end
 end
diff --git a/app/models/webhook/post.rb b/app/models/webhook/post.rb
new file mode 100644
index 0000000..a8f472e
--- /dev/null
+++ b/app/models/webhook/post.rb
@@ -0,0 +1,39 @@
+require "net/http"
+
+class Webhook::Post
+  attr_reader :headers
+
+  def initialize(delivery)
+    webhook = delivery.webhook
+    @url = URI.parse(webhook.url)
+    @body = ApplicationController.renderer.new(script_name: webhook.account.slug).render(
+      template: "webhooks/event", assigns: { event: delivery.event }, formats: [ :json ], layout: false
+    )
+    @headers = {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "Idempotency-Key" => delivery.id,
+      "X-Webhook-Timestamp" => Time.current.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, @body)
+    }
+  end
+
+  def send_request
+    if ip = SsrfProtection.resolve_public_ip(@url.hostname)
+      http = Net::HTTP.new(@url.hostname, @url.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = @url.scheme == "https"
+      http.open_timeout = http.read_timeout = http.write_timeout = 5
+      http.max_retries = 0
+
+      request = Net::HTTP::Post.new(@url.request_uri, headers)
+      http.request(request, @body) { |response| return { code: response.code.to_i } }
+    else
+      { error: "destination_unreachable" }
+    end
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue Resolv::ResolvError, IOError, SocketError, SystemCallError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::ProtocolError
+    { error: "destination_unreachable" }
+  end
+end
