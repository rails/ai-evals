diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..7439e18 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -5,6 +5,23 @@ module Event::Particulars
     store_accessor :particulars, :assignee_ids
   end
 
+  def activity_particulars
+    details = particulars.to_h["particulars"] || {}
+
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: details["old_board"].to_s, new_board: details["new_board"].to_s }
+    when "card_title_changed"
+      { old_title: details["old_title"].to_s, new_title: details["new_title"].to_s }
+    when "card_triaged"
+      { column: details["column"].to_s }
+    else
+      {}
+    end
+  end
+
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
