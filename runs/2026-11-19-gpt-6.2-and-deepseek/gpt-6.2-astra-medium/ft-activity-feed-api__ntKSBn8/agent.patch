diff --git a/app/views/activities/index.json.jbuilder b/app/views/activities/index.json.jbuilder
new file mode 100644
index 0000000..db247d1
--- /dev/null
+++ b/app/views/activities/index.json.jbuilder
@@ -0,0 +1,17 @@
+json.array! @page.records do |event|
+  json.(event, :id, :action, :eventable_type)
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text
+  json.particulars event.activity_particulars
+  json.url polymorphic_url(event.eventable)
+
+  json.eventable do
+    case event.eventable
+    when Card then json.partial! "cards/card", card: event.eventable
+    when Comment then json.partial! "cards/comments/comment", comment: event.eventable
+    end
+  end
+
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
diff --git a/config/initializers/geared_pagination.rb b/config/initializers/geared_pagination.rb
new file mode 100644
index 0000000..2ed60cd
--- /dev/null
+++ b/config/initializers/geared_pagination.rb
@@ -0,0 +1,14 @@
+require "geared_pagination/headers"
+
+# Geared Pagination 1.2 merges the page number into a flat hash, losing all but
+# the last value of repeated query parameters such as creator_ids[].
+module GearedPaginationArrayFilters
+  private
+    def uri(page:)
+      Addressable::URI.parse(request.url).tap do |uri|
+        uri.query = request.query_parameters.merge("page" => page).to_query
+      end
+    end
+end
+
+GearedPagination::Headers.prepend GearedPaginationArrayFilters
