diff --git a/docs/api/sections/activities.md b/docs/api/sections/activities.md
new file mode 100644
index 0000000..8c7488a
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,20 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a [paginated](../README.md#pagination) array of events from boards you can access, newest first. It includes the same actions as the activity timeline, except that it includes `card_title_changed` and omits the deprecated `card_collection_changed`.
+
+Use `creator_ids[]` to filter by the users who performed the actions, and `board_ids[]` to filter by board. Each filter accepts multiple IDs; when both are present, events must match both filters.
+
+Each event has an `id`, `action`, `created_at`, plain-text `description`, and `url`. The URL opens the card, anchored to the comment for comment activity. `eventable_type` is `Card` or `Comment`; `eventable`, `board`, and `creator` contain the corresponding API resource representations.
+
+The `particulars` object depends on the action:
+
+| Action | Fields |
+| --- | --- |
+| `card_assigned`, `card_unassigned` | `assignee_ids` (array) |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Missing board names, titles, and column names are empty strings. All other actions return `{}` for `particulars`.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..49c16a7
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "lists card and comment activity newest first" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = response.parsed_body
+    assert_equal activity.pluck("created_at").sort.reverse, activity.pluck("created_at")
+
+    event = events(:logo_assignment_jz)
+    assignment = activity.find { |entry| entry["id"] == event.id }
+    assert_equal %w[ action board created_at creator description eventable eventable_type id particulars url ], assignment.keys.sort
+    assert_equal event.description_for(users(:david)).to_plain_text, assignment["description"]
+    assert_equal({ "assignee_ids" => event.assignee_ids }, assignment["particulars"])
+    assert_equal "Card", assignment["eventable_type"]
+    assert_equal event.eventable.title, assignment.dig("eventable", "title")
+    assert_equal event.board.name, assignment.dig("board", "name")
+    assert_equal event.creator.name, assignment.dig("creator", "name")
+    assert_equal card_url(event.card), assignment["url"]
+
+    comment = events(:layout_commented).eventable
+    entry = activity.find { |entry| entry["action"] == "comment_created" }
+    assert_equal "Comment", entry["eventable_type"]
+    assert_equal comment.body.to_plain_text, entry.dig("eventable", "body", "plain_text")
+    assert_equal({}, entry["particulars"])
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), entry["url"]
+  end
+
+  test "includes title changes but not deprecated or non-timeline actions" do
+    events(:logo_published).update!(action: "card_title_changed", particulars: { particulars: { old_title: "Original", new_title: "Updated" } })
+    events(:layout_published).update!(action: "card_collection_changed")
+    events(:text_published).update!(action: "card_resumed")
+
+    get activities_path(format: :json)
+    assert_response :success
+    activity = response.parsed_body.index_by { |entry| entry["action"] }
+    assert_equal({ "old_title" => "Original", "new_title" => "Updated" }, activity.fetch("card_title_changed")["particulars"])
+    assert_not activity.key?("card_collection_changed")
+    assert_not activity.key?("card_resumed")
+  end
+
+  test "exposes only action-specific particulars and defaults missing values to empty strings" do
+    events(:logo_published).update!(action: "card_board_changed", particulars: { particulars: { new_board: "Writebook", internal: true } })
+    events(:layout_published).update!(action: "card_title_changed")
+    events(:text_published).update!(action: "card_triaged")
+
+    get activities_path(format: :json)
+    assert_response :success
+    activity = response.parsed_body.index_by { |entry| entry["action"] }
+    assert_equal({ "old_board" => "", "new_board" => "Writebook" }, activity.fetch("card_board_changed")["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, activity.fetch("card_title_changed")["particulars"])
+    assert_equal({ "column" => "" }, activity.fetch("card_triaged")["particulars"])
+  end
+
+  test "filters by creator and board without granting access to private activity" do
+    Current.set(user: users(:kevin)) { cards(:shipping).move_to(boards(:private)) }
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:private).id, boards(:writebook).id ] }
+    assert_response :success
+    assert_equal [ events(:text_published).id ], response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_empty response.parsed_body
+  end
+
+  test "paginates the filtered feed" do
+    16.times { cards(:logo).track_event(:published, creator: users(:david)) }
+    creator_ids = users(:david, :kevin).map(&:id)
+    expected_ids = users(:david).accessible_events.where(creator_id: creator_ids).order(created_at: :desc, id: :desc).ids
+
+    get activities_path(format: :json), params: { creator_ids: creator_ids }
+    assert_response :success
+    first_ids = response.parsed_body.pluck("id")
+    assert_equal expected_ids.size.to_s, response.headers["X-Total-Count"]
+    next_url = response.headers.fetch("Link").match(/<([^>]+)>; rel="next"/)[1]
+
+    get URI.parse(next_url).request_uri
+    assert_response :success
+    assert_equal expected_ids, first_ids + response.parsed_body.pluck("id")
+  end
+end
