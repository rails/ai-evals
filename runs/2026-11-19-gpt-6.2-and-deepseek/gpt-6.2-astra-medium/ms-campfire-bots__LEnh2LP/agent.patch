@@ -0,0 +1,58 @@
+class BotsController < ApplicationController
+  before_action :ensure_can_administer, only: :reactivate
+  before_action :set_bot, only: %i[ edit update destroy reactivate ]
+
+  def index
+    no_store
+    @bots = manageable_bots.includes(:user).order(:id)
+  end
+
+  def new
+    return redirect_to bots_url unless Current.user.can_create_bot?
+
+    @bot = Bot.build_for(Current.user)
+  end
+
+  def create
+    @bot = Bot.build_for(Current.user)
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def reactivate
+    @bot.reactivate!
+    redirect_to bots_url, status: :see_other
+  end
+
+  def destroy
+    @bot.destroy!
+    redirect_to bots_url, status: :see_other
+  end
+
+  private
+    def manageable_bots
+      Current.user.administrator? ? Bot.all : Bot.where(creator: Current.user)
+    end
+
+    def set_bot
+      @bot = manageable_bots.find(params[:id])
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar, :webhook_url, :add_to_all_open_rooms, open_room_ids: [])
+    end
+end
