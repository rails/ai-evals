+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    post bots_path, params: { bot: { name: "Deploy Bot" } }
+    assert_redirected_to bots_path
+    @bot = Bot.last
+    rooms(:hq).memberships.grant_to(@bot.user)
+  end
+
+  test "member can reach the forms and upload an avatar" do
+    get edit_account_path
+    assert_select "a[href=?][aria-label=?]", bots_path, "Set up chat bots"
+    get new_bot_path
+    assert_select "label[for=bot_name]", "Name the bot"
+    assert_select "input[name='bot[name]'][required]"
+    post bots_path, params: { bot: { name: "" } }
+    assert_response :unprocessable_entity
+    get edit_bot_path(@bot)
+    assert_select "form[data-turbo-confirm] button", "Delete this chat bot"
+    patch bot_path(@bot), params: { bot: { avatar: fixture_file_upload("earth.png", "image/png") } }
+    assert_redirected_to bots_path
+    assert @bot.reload.user.avatar.attached?
+  end
+
+  test "the bot limit blocks new bots but not editing or deleting existing ones" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    patch bot_path(@bot), params: { bot: { name: "Renamed" } }
+    assert_equal "Renamed", @bot.reload.name
+
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    get bots_path
+    assert_select "a[href=?]", new_bot_path, count: 0
+    assert_match "reached the limit", response.body
+    get new_bot_path
+    assert_redirected_to bots_path
+    assert_no_difference [ "Bot.count", "User.count" ] do
+      post bots_path, params: { bot: { name: "Too many" } }
+      assert_response :unprocessable_entity
+    end
+
+    delete bot_path(@bot)
+    get bots_path
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+    assert_difference "Bot.count" do
+      post bots_path, params: { bot: { name: "Replacement" } }
+    end
+  end
+
+  test "the limit is per creator and does not apply to administrators" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in :jz
+    assert_difference "Bot.count" do
+      post bots_path, params: { bot: { name: "Another member's bot" } }
+    end
+
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    sign_in :david
+    get bots_path
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+    assert_difference "Bot.count" do
+      post bots_path, params: { bot: { name: "Admin bot" } }
+    end
+  end
+
+  test "select open rooms or opt in to them all on the bot form" do
+    get new_bot_path
+    assert_select "label[for=bot_add_to_all_open_rooms]", "Add to all open rooms"
+    assert_select "input#bot_add_to_all_open_rooms[type=checkbox]:not([checked])"
+    post bots_path, params: { bot: { name: "Helper", open_room_ids: [ rooms(:pets).id, rooms(:designers).id ] } }
+    bot = Bot.last
+    assert_equal [ rooms(:pets) ], bot.user.rooms.to_a
+
+    patch bot_path(bot), params: { bot: { add_to_all_open_rooms: "1" } }
+    get edit_bot_path(bot)
+    assert_select "input#bot_add_to_all_open_rooms[checked]"
+    patch bot_path(bot), params: { bot: { add_to_all_open_rooms: "0" } }
+    assert_equal Rooms::Open.ids.sort, bot.user.rooms.reload.ids.sort
+  end
+
+  test "optional webhook can be set on creation and cleared on edit" do
+    get new_bot_path
+    assert_select "label[for=bot_webhook_url]", "Webhook URL"
+    post bots_path, params: { bot: { name: "Helper", webhook_url: "https://example.com/mention" } }
+    bot = Bot.last
+    get edit_bot_path(bot)
+    assert_select "input[name='bot[webhook_url]'][value=?]", "https://example.com/mention"
+    patch bot_path(bot), params: { bot: { webhook_url: "" } }
+    assert_nil bot.reload.webhook_url
+  end
+
+  test "bot can be selected as a mention in its room" do
+    get autocompletable_users_path(format: :json), params: { room_id: rooms(:hq).id, query: "Deploy Bot" }
+    assert_equal @bot.user.attachable_sgid, response.parsed_body.sole["sgid"]
+  end
+
+  test "owner manages their bot and revokes the code on deletion" do
+    get bots_path
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "input[readonly][value=?]", @bot.bot_code
+    end
+    patch bot_path(@bot), params: { bot: { name: "Release Bot" } }
+    assert_equal "Release Bot", @bot.reload.user.name
+    delete bot_path(@bot)
+    assert_redirected_to bots_path
+    post endpoint
+    assert_response :unauthorized
+  end
+
+  test "only creator and administrator can manage bot" do
+    sign_in :jz
+    get bots_path
+    assert_not_includes response.body, @bot.bot_code
+    assert_raises(ActiveRecord::RecordNotFound) { get edit_bot_path(@bot) }
+    assert_raises(ActiveRecord::RecordNotFound) { delete bot_path(@bot) }
+    sign_in :david
+    get bots_path
+    assert_select "input[readonly][value=?]", @bot.bot_code
+  end
+
+  test "raw curl body is posted as plain text by the bot" do
+    delete session_path
+    body = "Release <v1> & fix=done ✅"
+    assert_enqueued_with(job: Room::PushMessageJob) do
+      post endpoint, params: body.dup, headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :created
+    message = rooms(:hq).messages.last
+    assert_equal message_path(message.id), URI(response.location).path
+    assert_equal @bot.user, message.creator
+    assert_equal body, message.plain_text_body
+    assert_rendered_turbo_stream_broadcast rooms(:hq), :messages, action: "append", target: [ rooms(:hq), :messages ] do
+      assert_select ".message__author", text: /Deploy Bot/
+    end
+    sign_in :kevin
+    get message_path(message.id)
+    assert_response :success
+    assert_select ".message__author", text: /Deploy Bot/
+  end
+
+  test "a form-like body stays literal in a closed room the bot joined" do
+    room = rooms(:designers)
+    room.memberships.grant_to(@bot.user)
+    post endpoint(room: room.id), params: +"_method=DELETE"
+    assert_response :created
+    assert_equal "_method=DELETE", room.messages.last.plain_text_body
+  end
+
+  test "rejects bad code, inaccessible rooms, and empty text" do
+    assert_no_difference "Message.count" do
+      post endpoint(code: "wrong")
+      assert_response :unauthorized
+      post endpoint(room: 0)
+      assert_response :not_found
+      post endpoint(room: rooms(:designers).id)
+      assert_response :not_found
+      post endpoint, params: +"  "
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "only posts that have aged out of the sliding window stop counting" do
+    freeze_time
+    post endpoint, params: +"first"
+    travel 9.seconds
+    9.times { post endpoint, params: +"burst" }
+    travel 1.second
+    post endpoint, params: +"one slot freed"
+    assert_response :created
+    post endpoint, params: +"the burst still counts"
+    assert_response :too_many_requests
+  end
+
+  test "flooding starts a cooldown, then suspends until an administrator reactivates" do
+    freeze_time
+    10.times do
+      post endpoint, params: +"ping"
+      assert_response :created
+    end
+    assert_no_difference "Message.count" do
+      post endpoint, params: +"one too many"
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+      travel 6.seconds
+      4.times do
+        post endpoint, params: +"again"
+        assert_response :too_many_requests
+        assert_equal "24", response.headers["Retry-After"]
+      end
+      post endpoint, params: +"again"
+      assert_response :forbidden
+      travel 1.minute
+      post endpoint, params: +"still suspended"
+      assert_response :forbidden
+    end
+
+    assert_includes @bot.user.rooms, rooms(:hq)
+    assert_equal 10, rooms(:hq).messages.where(creator: @bot.user).count
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    get bots_path
+    assert_select "a[href=?]", new_bot_path, count: 0
+    assert_select "li", text: /Suspended.*Flooding/m
+    assert_select "button", text: "Reactivate", count: 0
+    post reactivate_bot_path(@bot)
+    assert_response :forbidden
+    sign_in :david
+    get bots_path
+    assert_select "form[data-turbo-confirm] button", "Reactivate"
+    post reactivate_bot_path(@bot)
+    assert_redirected_to bots_path
+    post endpoint, params: +"back"
+    assert_response :created
+  end
+
+  private
+    def endpoint(room: rooms(:hq).id, code: @bot.bot_code)
+      room_bot_messages_path(room, code)
+    end
+end
