diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..ae50a13
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,61 @@
+class Bot < ApplicationRecord
+  include Moderation
+
+  belongs_to :creator, class_name: "User"
+  belongs_to :user, autosave: true
+
+  has_secure_token :bot_code
+  delegate :name, :name=, :avatar, :avatar=, to: :user
+  validates :name, presence: true
+  normalizes :webhook_url, with: ->(url) { url.strip.presence }
+  validate :webhook_url_is_http, if: :webhook_url?
+  validate :creator_has_capacity, on: :create
+
+  after_save :update_open_room_memberships
+  before_destroy -> { user.deactivate }
+
+  def self.build_for(creator)
+    new(creator: creator, user: User.new(password: SecureRandom.base58))
+  end
+
+  scope :receiving_webhooks, -> { where(suspension_reason: nil).where.not(webhook_url: nil) }
+
+  attr_writer :open_room_ids
+
+  def open_room_ids
+    @open_room_ids || user.rooms.opens.ids
+  end
+
+  def post_message(room, body)
+    result = with_post_limit { room.messages.create!(creator: user, body: body) }
+    result.broadcast_create if result.is_a?(Message)
+    result
+  end
+
+  private
+    def creator_has_capacity
+      errors.add(:base, "You've reached the limit for chat bots.") if creator && !creator.can_create_bot?
+    end
+
+    def update_open_room_memberships
+      if saved_change_to_add_to_all_open_rooms?
+        join_open_rooms(Rooms::Open.all) if add_to_all_open_rooms?
+      elsif @open_room_ids && !add_to_all_open_rooms?
+        selected = Rooms::Open.where(id: @open_room_ids)
+        user.memberships.where(room: Rooms::Open.where.not(id: selected)).destroy_all
+        join_open_rooms(selected)
+      end
+      @open_room_ids = nil
+    end
+
+    def join_open_rooms(rooms)
+      rooms.find_each { |room| room.memberships.grant_to(user) }
+    end
+
+    def webhook_url_is_http
+      url = URI.parse(webhook_url)
+      errors.add(:webhook_url, "must be an HTTP or HTTPS URL") unless url.is_a?(URI::HTTP) && url.host.present?
+    rescue URI::InvalidURIError
+      errors.add(:webhook_url, "is invalid")
+    end
+end
