--- /dev/null
+++ b/app/models/bot/room_join.rb
@@ -0,0 +1,17 @@
+# Outlives the membership so a re-grant doesn't send another greeting.
+class Bot::RoomJoin < ApplicationRecord
+  self.table_name = "bot_room_joins"
+
+  belongs_to :bot
+  belongs_to :room
+
+  after_create_commit -> { Bot::JoinedWebhookJob.perform_later(bot, room) }
+
+  def self.record_for(room, user_ids)
+    return if room.direct? || user_ids.empty?
+
+    Bot.receiving_webhooks.where(user_id: user_ids).find_each do |bot|
+      find_or_create_by!(bot: bot, room: room)
+    end
+  end
+end
diff --git a/app/models/bot/webhook.rb b/app/models/bot/webhook.rb
new file mode 100644
index 0000000..b9b39dd
--- /dev/null
+++ b/app/models/bot/webhook.rb
@@ -0,0 +1,63 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class Bot::Webhook
+  include Rails.application.routes.url_helpers
+
+  MAX_REPLY_SIZE = 1.megabyte
+
+  def initialize(bot, room)
+    @bot, @room = bot, room
+  end
+
+  def deliver
+    return if bot.reload.suspended? || !bot.webhook_url?
+
+    success, body = fetch_reply
+    bot.record_webhook_delivery(success: success)
+    if body.present? && room.users.active.exists?(bot.user_id)
+      bot.post_message(room, body)
+    end
+  end
+
+  private
+    attr_reader :bot, :room
+
+    def fetch_reply
+      url = URI.parse(bot.webhook_url)
+      ip = RestrictedHTTP::PrivateNetworkGuard.resolve(url.hostname)
+      request = Net::HTTP::Post.new(url, "Content-Type" => "application/json")
+      request.body = payload.to_json
+
+      # Connect directly to the validated address, not through an environment proxy.
+      Net::HTTP.start(url.hostname, url.port, nil, ipaddr: ip, use_ssl: url.scheme == "https",
+          open_timeout: 5, read_timeout: 10, write_timeout: 10) do |http|
+        http.request(request) do |response|
+          return [ response.is_a?(Net::HTTPSuccess), reply_body(response) ]
+        end
+      end
+    rescue Timeout::Error, SocketError, IOError, SystemCallError, OpenSSL::SSL::SSLError, Surfguard::Unresolvable, Net::HTTPBadResponse
+      [ false, nil ]
+    end
+
+    def room_payload
+      { id: room.id, name: ApplicationController.helpers.room_display_name(room, for_user: bot.user), reply_to: room_bot_messages_path(room, bot.bot_code) }
+    end
+
+    def reply_body(response)
+      return unless response.is_a?(Net::HTTPOK) && %w[ text/plain text/html ].include?(response.content_type)
+
+      body = "".b
+      response.read_body do |chunk|
+        return if body.bytesize + chunk.bytesize > MAX_REPLY_SIZE
+        body << chunk
+      end
+      return unless body.force_encoding(Encoding::UTF_8).valid_encoding?
+
+      if response.content_type == "text/html"
+        ActionController::Base.helpers.sanitize(body)
+      else
+        ERB::Util.html_escape(body).gsub(/\r?\n/, "<br>")
+      end
+    end
+end
