diff --git a/test/jobs/bot/joined_webhook_job_test.rb b/test/jobs/bot/joined_webhook_job_test.rb
new file mode 100644
index 0000000..5b10dad
--- /dev/null
+++ b/test/jobs/bot/joined_webhook_job_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Bot::JoinedWebhookJobTest < ActiveJob::TestCase
+  setup do
+    @bot = Bot.build_for(users(:david))
+    @bot.update!(name: "Greeter", webhook_url: "https://example.com/events")
+    Resolv.stubs(:getaddresses).with("example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "a manual grant sends one joined event and posts the reply" do
+    room = rooms(:designers)
+    callback = stub_request(:post, @bot.webhook_url).with(body: {
+      event: "joined", room: { id: room.id, name: room.name, reply_to: "/rooms/#{room.id}/#{@bot.bot_code}/messages" }
+    }.to_json).to_return(headers: { "Content-Type" => "text/html" }, body: "<strong>Hello!</strong>")
+
+    perform_enqueued_jobs(only: Bot::JoinedWebhookJob) do
+      room.memberships.grant_to(@bot.user)
+      room.memberships.grant_to(@bot.user)
+      room.memberships.revoke_from(@bot.user)
+      room.users << @bot.user
+    end
+    assert_requested callback, times: 1
+    assert_equal @bot.user, room.messages.last.creator
+    assert_includes room.messages.last.body.body.to_html, "<strong>Hello!</strong>"
+  end
+
+  test "automatic grants notify for existing, new, and newly open rooms" do
+    assert_enqueued_jobs Rooms::Open.count, only: Bot::JoinedWebhookJob do
+      @bot.update!(add_to_all_open_rooms: true)
+    end
+    assert_enqueued_jobs 2, only: Bot::JoinedWebhookJob do
+      Rooms::Open.create_for({ name: "Ops", creator: users(:david) }, users: @bot.user)
+      rooms(:designers).becomes!(Rooms::Open).save!
+    end
+  end
+
+  test "a rolled back grant leaves no notification and does not consume the greeting" do
+    room = rooms(:designers)
+    assert_no_enqueued_jobs only: Bot::JoinedWebhookJob do
+      Room.transaction do
+        room.memberships.grant_to(@bot.user)
+        raise ActiveRecord::Rollback
+      end
+    end
+    assert_enqueued_jobs 1, only: Bot::JoinedWebhookJob do
+      room.memberships.grant_to(@bot.user)
+    end
+  end
+
+  test "a queued notification does not expose the room after access is revoked" do
+    room = rooms(:designers)
+    room.memberships.grant_to(@bot.user)
+    room.memberships.revoke_from(@bot.user)
+    perform_enqueued_jobs(only: Bot::JoinedWebhookJob)
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "direct conversations do not notify" do
+    assert_no_enqueued_jobs only: Bot::JoinedWebhookJob do
+      Rooms::Direct.create_for({ creator: users(:david) }, users: [ @bot.user, users(:david) ])
+    end
+  end
+end
diff --git a/test/jobs/bot/mention_webhook_job_test.rb b/test/jobs/bot/mention_webhook_job_test.rb
new file mode 100644
index 0000000..fe83eb9
--- /dev/null
+++ b/test/jobs/bot/mention_webhook_job_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+require "restricted_http/private_network_guard"
+
+class Bot::MentionWebhookJobTest < ActionDispatch::IntegrationTest
+  setup do
+    @author = users(:david)
+    @room = rooms(:hq)
+    @bot = Bot.build_for(@author)
+    @bot.update!(name: "Build Bot", webhook_url: "https://example.com/events")
+    @room.memberships.grant_to(@bot.user)
+    @mention = ActionText::Attachment.from_attachable(@bot.user).to_html
+    Resolv.stubs(:getaddresses).with("example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "posts one callback for repeated mentions and broadcasts the plain text reply" do
+    message = nil
+    assert_enqueued_jobs 1, only: Bot::MentionWebhookJob do
+      message = say("#{@mention}#{@mention}&nbsp;<strong>ping</strong> #{mention_attachment_for(:jz)} and literal @Build Bot")
+    end
+
+    callback = stub_request(:post, @bot.webhook_url).with(headers: { "Content-Type" => "application/json" }) do |request|
+      payload = JSON.parse(request.body)
+      assert_equal "mention", payload["event"]
+      assert_equal({ "id" => @author.id, "name" => @author.name }, payload["author"])
+      assert_equal({ "id" => @room.id, "name" => @room.name, "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages" }, payload["room"])
+      assert_equal message.id, payload.dig("message", "id")
+      assert_equal "/rooms/#{@room.id}/@#{message.id}", payload.dig("message", "link")
+      assert_includes payload.dig("message", "body", "html"), "<strong>ping</strong>"
+      assert_equal "ping @#{users(:jz).name} and literal @Build Bot", payload.dig("message", "body", "text")
+      true
+    end.to_return(status: 200, headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "<b>pong</b>\n✅")
+
+    perform_enqueued_jobs(only: Bot::MentionWebhookJob)
+    assert_requested callback, times: 1
+    reply = @room.messages.last
+    assert_equal @bot.user, reply.creator
+    assert_equal "<b>pong</b>\n✅", reply.plain_text_body
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author", text: /Build Bot/
+    end
+  end
+
+  test "preserves safe formatting in HTML replies" do
+    stub_request(:post, @bot.webhook_url).to_return(headers: { "Content-Type" => "text/html" }, body: "<strong onclick='bad()'>pong</strong>")
+    perform_enqueued_jobs(only: Bot::MentionWebhookJob) { say(@mention) }
+    assert_includes @room.messages.last.body.body.to_html, "<strong>pong</strong>"
+  end
+
+  test "each addressed bot gets its own command and posting credential" do
+    other = Bot.build_for(@author)
+    other.update!(name: "Helper", webhook_url: "https://example.com/helper")
+    @room.memberships.grant_to(other.user)
+    [ [ @bot, "ping @Helper" ], [ other, "@Build Bot ping" ] ].each do |bot, command|
+      stub_request(:post, bot.webhook_url).with do |request|
+        payload = JSON.parse(request.body)
+        assert_equal command, payload.dig("message", "body", "text")
+        assert_equal "/rooms/#{@room.id}/#{bot.bot_code}/messages", payload.dig("room", "reply_to")
+        true
+      end.to_return(status: 204)
+    end
+
+    assert_no_enqueued_jobs(only: Bot::MentionWebhookJob) { say("@Build Bot @Helper") }
+    assert_performed_jobs 2, only: Bot::MentionWebhookJob do
+      say("#{@mention} ping #{ActionText::Attachment.from_attachable(other.user).to_html}")
+    end
+  end
+
+  test "blocks callbacks to private addresses" do
+    @bot.update!(webhook_url: "http://127.0.0.1/events")
+    message = say(@mention)
+    assert_raises(RestrictedHTTP::Violation) { Bot::MentionWebhookJob.perform_now(@bot, message) }
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "ignores 204, redirects and unsupported response types" do
+    message = say(@mention)
+    stub_request(:post, @bot.webhook_url).to_return({ status: 204 }, { status: 302, headers: { "Location" => "https://other.example/" } }, { headers: { "Content-Type" => "application/json" }, body: "{}" })
+    assert_no_difference "Message.count" do
+      3.times { Bot::MentionWebhookJob.perform_now(@bot, message) }
+    end
+  end
+
+  test "does not deliver after membership or webhook removal" do
+    message = say(@mention)
+    @room.memberships.revoke_from(@bot.user)
+    perform_enqueued_jobs(only: Bot::MentionWebhookJob)
+    assert_no_enqueued_jobs(only: Bot::MentionWebhookJob) { say(@mention) }
+    @room.memberships.grant_to(@bot.user)
+    @bot.update!(webhook_url: "")
+    Bot::MentionWebhookJob.perform_now(@bot, message)
+    assert_no_enqueued_jobs(only: Bot::MentionWebhookJob) { say(@mention) }
+  end
+
+  test "counts consecutive failed deliveries, including network errors, but resets on any success" do
+    message = say(@mention)
+    callback = stub_request(:post, @bot.webhook_url).to_return(status: 500).times(9).
+      then.to_return(status: 204).then.to_return(status: 302).times(8).
+      then.to_timeout.then.to_raise(Errno::ECONNREFUSED)
+
+    19.times { Bot::MentionWebhookJob.perform_now(@bot, message) }
+    assert_not @bot.reload.suspended?
+    Bot::JoinedWebhookJob.perform_now(@bot, @room)
+    assert_equal "Repeated webhook failures", @bot.reload.suspension_reason
+    Bot::MentionWebhookJob.perform_now(@bot, message)
+    Bot::JoinedWebhookJob.perform_now(@bot, @room)
+    assert_requested callback, times: 20
+  end
+
+  test "webhook replies share the API posting window and cooldown" do
+    freeze_time
+    message = say(@mention)
+    endpoint = room_bot_messages_path(@room, @bot.bot_code)
+    stub_request(:post, @bot.webhook_url).to_return(headers: { "Content-Type" => "text/plain" }, body: "pong")
+    9.times { post endpoint, params: +"ping" }
+    travel 9.seconds
+    assert_difference "Message.count", 1 do
+      2.times { Bot::MentionWebhookJob.perform_now(@bot, message) }
+    end
+    post endpoint, params: +"ping"
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+    assert_no_difference "Message.count" do
+      3.times { Bot::MentionWebhookJob.perform_now(@bot, message) }
+    end
+    travel 30.seconds
+    post endpoint, params: +"ping"
+    assert_response :created
+    9.times { post endpoint, params: +"ping" }
+    2.times { Bot::MentionWebhookJob.perform_now(@bot, message) }
+    assert_not @bot.reload.suspended?
+  end
+
+  private
+    def say(body)
+      @room.messages.create!(body: "<div>#{body}</div>", creator: @author)
+    end
+end
diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
new file mode 100644
