+class Bot::JoinedWebhookJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bot, room)
+    if bot.webhook_url? && !room.direct? && room.users.active.exists?(bot.user_id)
+      Bot::JoinedWebhook.new(bot, room).deliver
+    end
+  end
+end
