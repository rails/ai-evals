diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
new file mode 100644
index 0000000..2f56dd0
--- /dev/null
+++ b/test/models/bot_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class BotTest < ActiveSupport::TestCase
+  test "open room memberships are opt-in for bots" do
+    bot = Bot.build_for(users(:david))
+    bot.update!(name: "Helper")
+    assert_empty bot.user.rooms
+
+    room = Rooms::Open.create!(name: "Ops", creator: users(:david))
+    assert_not_includes room.users, bot.user
+    assert_includes room.users, users(:jz)
+
+    bot.update!(add_to_all_open_rooms: true)
+    assert_equal Rooms::Open.ids.sort, bot.user.rooms.ids.sort
+    later = Rooms::Open.create!(name: "Alerts", creator: users(:david))
+    assert_includes later.users, bot.user
+
+    bot.update!(add_to_all_open_rooms: false)
+    assert_includes later.users, bot.user
+    rooms(:designers).becomes!(Rooms::Open).save!
+    assert_not_includes rooms(:designers).users, bot.user
+  end
+end
