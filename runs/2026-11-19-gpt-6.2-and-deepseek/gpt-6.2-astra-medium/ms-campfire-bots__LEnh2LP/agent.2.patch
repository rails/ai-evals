@@ -0,0 +1,9 @@
+class Bot::MentionWebhookJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bot, message)
+    if bot.webhook_url? && message.mentionees.active.exists?(bot.user_id)
+      Bot::MentionWebhook.new(bot, message).deliver
+    end
+  end
+end
diff --git a/app/models/bot.rb b/app/models/bot.rb
index 7a500da..ab0db9e 100644
--- a/app/models/bot.rb
+++ b/app/models/bot.rb
@@ -5,10 +5,24 @@ class Bot < ApplicationRecord
   has_secure_token :bot_code
   delegate :name, :name=, :avatar, :avatar=, to: :user
   validates :name, presence: true
+  normalizes :webhook_url, with: ->(url) { url.strip.presence }
+  validate :webhook_url_is_http, if: :webhook_url?
 
   before_destroy -> { user.deactivate }
 
   def self.build_for(creator)
     new(creator: creator, user: User.new(password: SecureRandom.base58))
   end
+
+  def post_message(room, body)
+    room.messages.create!(creator: user, body: body).tap(&:broadcast_create)
+  end
+
+  private
+    def webhook_url_is_http
+      url = URI.parse(webhook_url)
+      errors.add(:webhook_url, "must be an HTTP or HTTPS URL") unless url.is_a?(URI::HTTP) && url.host.present?
+    rescue URI::InvalidURIError
+      errors.add(:webhook_url, "is invalid")
+    end
 end
diff --git a/app/models/bot/mention_webhook.rb b/app/models/bot/mention_webhook.rb
new file mode 100644
index 0000000..4ca8ad2
--- /dev/null
+++ b/app/models/bot/mention_webhook.rb
@@ -0,0 +1,68 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class Bot::MentionWebhook
+  include Rails.application.routes.url_helpers
+
+  MAX_REPLY_SIZE = 1.megabyte
+
+  def initialize(bot, message)
+    @bot, @message, @room = bot, message, message.room
+  end
+
+  def deliver
+    if (body = fetch_reply).present? && room.users.active.exists?(bot.user_id)
+      bot.post_message(room, body)
+    end
+  end
+
+  private
+    attr_reader :bot, :message, :room
+
+    def fetch_reply
+      url = URI.parse(bot.webhook_url)
+      ip = RestrictedHTTP::PrivateNetworkGuard.resolve(url.hostname)
+      request = Net::HTTP::Post.new(url, "Content-Type" => "application/json")
+      request.body = payload.to_json
+
+      # Connect directly to the validated address, not through an environment proxy.
+      Net::HTTP.start(url.hostname, url.port, nil, ipaddr: ip, use_ssl: url.scheme == "https",
+          open_timeout: 5, read_timeout: 10, write_timeout: 10) do |http|
+        http.request(request) do |response|
+          return reply_body(response)
+        end
+      end
+    end
+
+    def payload
+      {
+        event: "mention",
+        author: { id: message.creator_id, name: message.creator.name },
+        room: { id: room.id, name: ApplicationController.helpers.room_display_name(room, for_user: bot.user), reply_to: room_bot_messages_path(room, bot.bot_code) },
+        message: { id: message.id, body: { text: command, html: message.body.to_s }, link: room_at_message_path(room, message.id) }
+      }
+    end
+
+    def command
+      message.body.body.render_attachments(with_full_attributes: false) do |attachment|
+        attachment.attachable == bot.user ? "" : attachment.node
+      end.to_plain_text.gsub(/\A[[:space:]]+|[[:space:]]+\z/, "")
+    end
+
+    def reply_body(response)
+      return unless response.is_a?(Net::HTTPOK) && %w[ text/plain text/html ].include?(response.content_type)
+
+      body = "".b
+      response.read_body do |chunk|
+        return if body.bytesize + chunk.bytesize > MAX_REPLY_SIZE
+        body << chunk
+      end
+      return unless body.force_encoding(Encoding::UTF_8).valid_encoding?
+
+      if response.content_type == "text/html"
+        ActionController::Base.helpers.sanitize(body)
+      else
+        ERB::Util.html_escape(body).gsub(/\r?\n/, "<br>")
+      end
+    end
+end
