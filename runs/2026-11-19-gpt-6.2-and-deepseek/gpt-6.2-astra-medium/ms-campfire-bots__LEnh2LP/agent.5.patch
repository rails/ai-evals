diff --git a/docs/chat-bots.md b/docs/chat-bots.md
index 9a85be0..26be973 100644
--- a/docs/chat-bots.md
+++ b/docs/chat-bots.md
@@ -46,3 +46,19 @@ does not send a second greeting. Direct conversations never send `joined`.
 Return `200` with a UTF-8 `text/plain` or `text/html` body to post a reply as the
 bot. For longer-running commands, return `204` promptly and POST text to
 `room.reply_to` later. Campfire does not follow webhook redirects.
+
+## Cooldowns and suspension
+
+A bot can post 10 messages in any 10 seconds across all its rooms, including
+webhook replies. The next post is rejected and starts a 30-second cooldown.
+On `429 Too Many Requests`, wait the number of seconds in `Retry-After` before
+posting again. Five more attempts during that cooldown suspend the bot.
+
+Ten consecutive failed webhook deliveries also suspend a bot. A timeout,
+connection error, or non-`2xx` response counts as a failure; any `2xx` resets
+the streak, even if there's no reply to post.
+
+Suspended bots receive no webhooks and posting returns `403 Forbidden`. They
+keep their memberships and messages and still count toward the owner's limit.
+The bots page shows the reason. After addressing the cause, an administrator
+can choose **Reactivate** there to restore the bot with its counters reset.
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
index 4433c96..5c42c24 100644
--- a/test/controllers/bots_controller_test.rb
+++ b/test/controllers/bots_controller_test.rb
@@ -160,6 +160,59 @@ class BotsControllerTest < ActionDispatch::IntegrationTest
     end
   end
 
+  test "only posts that have aged out of the sliding window stop counting" do
+    freeze_time
+    post endpoint, params: +"first"
+    travel 9.seconds
+    9.times { post endpoint, params: +"burst" }
+    travel 1.second
+    post endpoint, params: +"one slot freed"
+    assert_response :created
+    post endpoint, params: +"the burst still counts"
+    assert_response :too_many_requests
+  end
+
+  test "flooding starts a cooldown, then suspends until an administrator reactivates" do
+    freeze_time
+    10.times do
+      post endpoint, params: +"ping"
+      assert_response :created
+    end
+    assert_no_difference "Message.count" do
+      post endpoint, params: +"one too many"
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+      travel 6.seconds
+      4.times do
+        post endpoint, params: +"again"
+        assert_response :too_many_requests
+        assert_equal "24", response.headers["Retry-After"]
+      end
+      post endpoint, params: +"again"
+      assert_response :forbidden
+      travel 1.minute
+      post endpoint, params: +"still suspended"
+      assert_response :forbidden
+    end
+
+    assert_includes @bot.user.rooms, rooms(:hq)
+    assert_equal 10, rooms(:hq).messages.where(creator: @bot.user).count
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    get bots_path
+    assert_select "a[href=?]", new_bot_path, count: 0
+    assert_select "li", text: /Suspended.*Flooding/m
+    assert_select "button", text: "Reactivate", count: 0
+    post reactivate_bot_path(@bot)
+    assert_response :forbidden
+    sign_in :david
+    get bots_path
+    assert_select "form[data-turbo-confirm] button", "Reactivate"
+    post reactivate_bot_path(@bot)
+    assert_redirected_to bots_path
+    post endpoint, params: +"back"
+    assert_response :created
+  end
+
   private
     def endpoint(room: rooms(:hq).id, code: @bot.bot_code)
       room_bot_messages_path(room, code)
