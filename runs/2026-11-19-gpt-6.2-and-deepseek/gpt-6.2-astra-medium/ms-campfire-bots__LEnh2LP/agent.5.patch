diff --git a/app/models/bot/moderation.rb b/app/models/bot/moderation.rb
new file mode 100644
index 0000000..b76054d
--- /dev/null
+++ b/app/models/bot/moderation.rb
@@ -0,0 +1,60 @@
+module Bot::Moderation
+  POST_LIMIT = 10
+  POST_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  Cooldown = Data.define(:retry_after)
+
+  def suspended?
+    suspension_reason.present?
+  end
+
+  def reactivate!
+    with_lock do
+      if suspended?
+        update!(suspension_reason: nil, recent_post_times: [], cooldown_until: nil, cooldown_attempts: 0, webhook_failures: 0)
+      end
+    end
+  end
+
+  def record_webhook_delivery(success:)
+    with_lock do
+      unless suspended?
+        self.webhook_failures = success ? 0 : webhook_failures + 1
+        self.suspension_reason = "Repeated webhook failures" if webhook_failures >= WEBHOOK_FAILURE_LIMIT
+        save! if changed?
+      end
+    end
+  end
+
+  private
+    def with_post_limit
+      with_lock do
+        now = Time.current
+        if suspended?
+          :suspended
+        elsif cooldown_until && cooldown_until > now
+          record_cooldown_attempt(now)
+        else
+          cutoff = (now - POST_WINDOW).to_f
+          recent = recent_post_times.select { |timestamp| timestamp > cutoff }
+          if recent.size >= POST_LIMIT
+            update!(cooldown_until: now + COOLDOWN, cooldown_attempts: 0)
+            Cooldown.new(COOLDOWN.to_i)
+          else
+            update!(recent_post_times: recent << now.to_f)
+            yield
+          end
+        end
+      end
+    end
+
+    def record_cooldown_attempt(now)
+      self.cooldown_attempts += 1
+      self.suspension_reason = "Flooding" if cooldown_attempts >= COOLDOWN_ATTEMPT_LIMIT
+      save!
+      suspended? ? :suspended : Cooldown.new((cooldown_until - now).ceil)
+    end
+end
