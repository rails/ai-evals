new file mode 100644
index 0000000..7a500da
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,14 @@
+class Bot < ApplicationRecord
+  belongs_to :creator, class_name: "User"
+  belongs_to :user, autosave: true
+
+  has_secure_token :bot_code
+  delegate :name, :name=, :avatar, :avatar=, to: :user
+  validates :name, presence: true
+
+  before_destroy -> { user.deactivate }
+
+  def self.build_for(creator)
+    new(creator: creator, user: User.new(password: SecureRandom.base58))
+  end
+end
