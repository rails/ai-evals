diff --git a/docs/chat-bots.md b/docs/chat-bots.md
new file mode 100644
index 0000000..77d580b
--- /dev/null
+++ b/docs/chat-bots.md
@@ -0,0 +1,19 @@
+# Posting as a chat bot
+
+Open **Set up chat bots** in Account settings. Add a bot and copy its bot code
+into your CI secret store. Like people, bots join open rooms automatically;
+add them to a closed room from that room’s settings.
+
+```sh
+curl --fail --data-binary 'Deploy of v1.2.3 finished ✅' \
+  "https://chat.example.com/rooms/${ROOM_ID}/${BOT_CODE}/messages"
+```
+
+Send UTF-8 text, not a JSON object. To send multiple lines from a file, use
+`--data-binary @filename`. Success returns `201` and a `Location` header.
+`401` means the credential is invalid or inactive, `404` means the room is
+missing or inaccessible to the bot, and `422` means the text is missing or invalid.
+
+Treat the entire posting URL as a password. Use HTTPS, avoid shell tracing,
+and configure proxies and access logs not to record these paths. Deleting the
+bot revokes its code without removing its previous messages.
diff --git a/lib/middleware/bot_message_request.rb b/lib/middleware/bot_message_request.rb
new file mode 100644
index 0000000..ab2a91c
--- /dev/null
+++ b/lib/middleware/bot_message_request.rb
@@ -0,0 +1,19 @@
+module Middleware
+  class BotMessageRequest
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      # Remove credentials from the path before Rails logs the incoming request.
+      if match = %r{\A(/rooms/[^/]+)/([^/]+)/messages/?\z}.match(env["PATH_INFO"])
+        env["campfire.bot_code"] = match[2]
+        env["PATH_INFO"] = "#{match[1]}/bot/messages"
+        # curl -d defaults to form encoding, but this endpoint always takes plain text.
+        env["CONTENT_TYPE"] = "text/plain" if env["REQUEST_METHOD"] == "POST"
+      end
+
+      @app.call(env)
+    end
+  end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..d0d0e1d
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    post bots_path, params: { bot: { name: "Deploy Bot" } }
+    assert_redirected_to bots_path
+    @bot = Bot.last
+  end
+
+  test "member can reach the forms and upload an avatar" do
+    get edit_account_path
+    assert_select "a[href=?][aria-label=?]", bots_path, "Set up chat bots"
+    get new_bot_path
+    assert_select "label[for=bot_name]", "Name the bot"
+    assert_select "input[name='bot[name]'][required]"
+    post bots_path, params: { bot: { name: "" } }
+    assert_response :unprocessable_entity
+    get edit_bot_path(@bot)
+    assert_select "form[data-turbo-confirm] button", "Delete this chat bot"
+    patch bot_path(@bot), params: { bot: { avatar: fixture_file_upload("earth.png", "image/png") } }
+    assert_redirected_to bots_path
+    assert @bot.reload.user.avatar.attached?
+  end
+
+  test "owner manages their bot and revokes the code on deletion" do
+    get bots_path
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "input[readonly][value=?]", @bot.bot_code
+    end
+    patch bot_path(@bot), params: { bot: { name: "Release Bot" } }
+    assert_equal "Release Bot", @bot.reload.user.name
+    delete bot_path(@bot)
+    assert_redirected_to bots_path
+    post endpoint
+    assert_response :unauthorized
+  end
+
+  test "only creator and administrator can manage bot" do
+    sign_in :jz
+    get bots_path
+    assert_not_includes response.body, @bot.bot_code
+    assert_raises(ActiveRecord::RecordNotFound) { get edit_bot_path(@bot) }
+    assert_raises(ActiveRecord::RecordNotFound) { delete bot_path(@bot) }
+    sign_in :david
+    get bots_path
+    assert_select "input[readonly][value=?]", @bot.bot_code
+  end
+
+  test "raw curl body is posted as plain text by the bot" do
+    delete session_path
+    body = "Release <v1> & fix=done ✅"
+    assert_enqueued_with(job: Room::PushMessageJob) do
+      post endpoint, params: body.dup, headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+    assert_response :created
+    message = rooms(:hq).messages.last
+    assert_equal message_path(message.id), URI(response.location).path
+    assert_equal @bot.user, message.creator
+    assert_equal body, message.plain_text_body
+    assert_rendered_turbo_stream_broadcast rooms(:hq), :messages, action: "append", target: [ rooms(:hq), :messages ] do
+      assert_select ".message__author", text: /Deploy Bot/
+    end
+    sign_in :kevin
+    get message_path(message.id)
+    assert_response :success
+    assert_select ".message__author", text: /Deploy Bot/
+  end
+
+  test "a form-like body stays literal in a closed room the bot joined" do
+    room = rooms(:designers)
+    room.memberships.grant_to(@bot.user)
+    post endpoint(room: room.id), params: +"_method=DELETE"
+    assert_response :created
+    assert_equal "_method=DELETE", room.messages.last.plain_text_body
+  end
+
+  test "rejects bad code, inaccessible rooms, and empty text" do
+    assert_no_difference "Message.count" do
+      post endpoint(code: "wrong")
+      assert_response :unauthorized
+      post endpoint(room: 0)
+      assert_response :not_found
+      post endpoint(room: rooms(:designers).id)
+      assert_response :not_found
+      post endpoint, params: +"  "
+      assert_response :unprocessable_entity
+    end
+  end
+
+  private
+    def endpoint(room: rooms(:hq).id, code: @bot.bot_code)
+      room_bot_messages_path(room, code)
+    end
+end
