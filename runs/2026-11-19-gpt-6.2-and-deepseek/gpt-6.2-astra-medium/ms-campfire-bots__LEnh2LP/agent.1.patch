diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..1afa8b1
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,19 @@
+class Bots::MessagesController < ActionController::API
+  include BlockBannedRequests, SetCurrentRequest
+
+  def create
+    bot = Bot.find_by(bot_code: request.get_header("campfire.bot_code"))
+    return head :unauthorized unless bot&.user&.active?
+
+    Current.user = bot.user
+    room = Current.user.rooms.find_by(id: Integer(params[:room_id], 10, exception: false))
+    return head :not_found unless room
+
+    text = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+    return head :unprocessable_entity unless text.valid_encoding? && text.present?
+
+    message = room.messages.create!(body: ERB::Util.html_escape(text).gsub(/\r?\n/, "<br>"))
+    message.broadcast_create
+    head :created, location: message_path(message.id)
+  end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..daf5a24
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,50 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    no_store
+    @bots = manageable_bots.includes(:user).order(:id)
+  end
+
+  def new
+    @bot = Bot.build_for(Current.user)
+  end
+
+  def create
+    @bot = Bot.build_for(Current.user)
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @bot.destroy!
+    redirect_to bots_url, status: :see_other
+  end
+
+  private
+    def manageable_bots
+      Current.user.administrator? ? Bot.all : Bot.where(creator: Current.user)
+    end
+
+    def set_bot
+      @bot = manageable_bots.find(params[:id])
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
