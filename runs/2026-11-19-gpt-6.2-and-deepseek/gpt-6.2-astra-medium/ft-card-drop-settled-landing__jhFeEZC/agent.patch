diff --git a/test/system/board_drag_and_drop_test.rb b/test/system/board_drag_and_drop_test.rb
new file mode 100644
index 0000000..2c7328c
--- /dev/null
+++ b/test/system/board_drag_and_drop_test.rb
@@ -0,0 +1,91 @@
+require "application_system_test_case"
+
+class BoardDragAndDropTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:buy_domain)
+    visit board_url(@card.board)
+  end
+
+  test "a drop places the card immediately in the destination's order" do
+    column = columns(:writebook_triage)
+    destination = "##{dom_id(column)}"
+    expected = [ cards(:logo), @card, cards(:layout) ].map { |card| dom_id(card, :article) }
+
+    assert_equal expected, drop_into(destination)
+    assert_saved_in destination
+    assert_equal column, @card.reload.column
+
+    # A drop within the same column must not reorder or record activity.
+    assert_no_changes -> { @card.reload.last_active_at } do
+      assert_equal expected, drop_into(destination)
+    end
+    refresh
+    assert_selector "#{destination} ##{expected[0]} + ##{expected[1]} + ##{expected[2]}", visible: :all
+  end
+
+  test "dragging between status columns updates the board and saves each transition" do
+    find("#maybe #{card_selector}").drag_to(find("#closed-cards .cards__expander"))
+    assert_saved_in "#closed-cards"
+    assert_predicate @card.reload, :closed?
+    assert_selector "#maybe .cards__expander-count", exact_text: "0", visible: :all
+
+    drop_into "#not-now"
+    assert_saved_in "#not-now"
+    assert_predicate @card.reload, :postponed?
+
+    drop_into "#maybe"
+    assert_saved_in "#maybe"
+    assert_predicate @card.reload, :awaiting_triage?
+    assert_selector "#maybe .cards__expander-count", exact_text: "1", visible: :all
+  end
+
+  test "drag feedback clears when a drag is cancelled" do
+    card = find(card_selector)
+    column = find("#closed-cards .cards__list", visible: :all)
+    page.execute_script(<<~JS, card, column)
+      const options = { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() }
+      arguments[0].dispatchEvent(new DragEvent('dragstart', options))
+      arguments[1].dispatchEvent(new DragEvent('dragover', options))
+    JS
+    assert_selector "#maybe .drag-and-drop__dragged-item"
+    assert_selector "#closed-cards.drag-and-drop__hover-container"
+
+    page.execute_script("arguments[0].dispatchEvent(new DragEvent('dragend', { bubbles: true }))", card)
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+    assert_saved_in "#maybe"
+  end
+
+  test "a failed move returns the card and restores the counters" do
+    page.execute_script("arguments[0].dataset.cardNotNowUrl += '/missing'", find(card_selector))
+    assert_includes drop_into("#not-now"), dom_id(@card, :article)
+    assert_saved_in "#maybe"
+    assert_selector "#maybe .cards__expander-count", exact_text: "1", visible: :all
+    assert_selector "#not-now .cards__expander-count", exact_text: "0", visible: :all
+  end
+
+  private
+    def card_selector
+      "##{dom_id(@card, :article)}[draggable='true']"
+    end
+
+    def assert_saved_in(destination)
+      assert_selector "#{destination} #{card_selector}", visible: :all
+    end
+
+    # Capture placement in the drop event's task, before any response can arrive.
+    def drop_into(destination)
+      card = find(card_selector, visible: :all)
+      column = find("#{destination} .cards__list", visible: :all)
+      page.evaluate_script(<<~JS, card, column)
+        ((card, list) => {
+          const dataTransfer = new DataTransfer()
+          const options = { bubbles: true, cancelable: true, dataTransfer }
+          card.dispatchEvent(new DragEvent('dragstart', options))
+          list.dispatchEvent(new DragEvent('dragover', options))
+          list.dispatchEvent(new DragEvent('drop', options))
+          return Array.from(list.querySelectorAll('article.card'), card => card.id)
+        })(arguments[0], arguments[1])
+      JS
+    end
+end
