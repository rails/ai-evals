diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..c7a365a
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,155 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const columnSelector = "[data-drop-destination]"
+const draggedClass = "drag-and-drop__dragged-item"
+const hoverClass = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "card" ]
+
+  #card
+  #hovered
+  #saving = new WeakSet()
+
+  cardTargetConnected(card) {
+    card.draggable = !this.#saving.has(card)
+  }
+
+  cardTargetDisconnected(card) {
+    if (card === this.#card) this.end()
+  }
+
+  preserveDraggable(event) {
+    if (event.detail.attributeName === "draggable" && event.target.matches("[data-card-triage-url]")) {
+      event.preventDefault()
+    }
+  }
+
+  disconnect() {
+    this.end()
+  }
+
+  start(event) {
+    const card = event.target.closest("[data-card-triage-url]")
+    if (!card?.draggable) return
+
+    this.#card = card
+    event.dataTransfer.setData("text/plain", card.id)
+    event.dataTransfer.effectAllowed = "move"
+    card.classList.add(draggedClass)
+  }
+
+  over(event) {
+    const column = this.#destination(event)
+    this.#highlight(column)
+    if (column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (!this.#hovered?.contains(event.relatedTarget)) this.#highlight(null)
+  }
+
+  end() {
+    this.#card?.classList.remove(draggedClass)
+    this.#card = null
+    this.#highlight(null)
+  }
+
+  async drop(event) {
+    const column = this.#destination(event)
+    const card = this.#card
+    this.end()
+    if (!column) return
+
+    event.preventDefault()
+    const source = card.closest(columnSelector)
+    const original = card.cloneNode(true)
+    const marker = document.createComment("card being moved")
+    card.before(marker)
+
+    this.#saving.add(card)
+    card.draggable = false
+    this.#insertCard(card, column)
+    this.#updatePreview(card, column)
+    this.#changeCount(source, -1)
+    this.#changeCount(column, 1)
+
+    try {
+      const response = await this.#save(card, column)
+      if (!response.ok) throw new Error(`Card move failed: ${response.statusCode}`)
+    } catch (error) {
+      card.remove()
+      marker.replaceWith(original)
+      this.#changeCount(source, 1)
+      this.#changeCount(column, -1)
+      console.error(error)
+    } finally {
+      marker.remove()
+      this.#saving.delete(card)
+      card.draggable = true
+    }
+  }
+
+  #destination(event) {
+    const column = event.target.closest(columnSelector)
+    if (this.#card && column && !column.contains(this.#card) && column.querySelector(".cards__list")) return column
+  }
+
+  #highlight(column) {
+    if (column !== this.#hovered) {
+      this.#hovered?.classList.remove(hoverClass)
+      column?.classList.add(hoverClass)
+      this.#hovered = column
+    }
+  }
+
+  #insertCard(card, column) {
+    const destination = column.dataset.dropDestination
+    const active = destination === "maybe" || destination === "column"
+    const list = column.querySelector(".cards__list")
+    const cards = list.querySelectorAll("article.card")
+
+    // Moving records fresh activity. Active columns keep gold cards above the rest.
+    const belowGold = active && !card.matches(".golden-effect")
+    const next = belowGold ? Array.from(cards).find(item => !item.matches(".golden-effect")) : cards[0]
+    if (next) {
+      next.before(card)
+    } else if (cards.length) {
+      cards[cards.length - 1].after(card)
+    } else {
+      list.prepend(card)
+    }
+  }
+
+  #updatePreview(card, column) {
+    const destination = column.dataset.dropDestination
+    card.removeAttribute("aria-selected")
+    card.classList.toggle("card--active", destination === "maybe" || destination === "column")
+    card.classList.toggle("card--postponed", destination === "not-now")
+    card.style.setProperty("--card-color", column.style.getPropertyValue("--card-color") || "var(--color-card-default)")
+    card.querySelector(".card__closed")?.remove()
+    card.querySelector(".bubble")?.remove()
+    card.querySelector(".card__meta-text--updated time")?.setAttribute("datetime", Math.floor(Date.now() / 1000))
+  }
+
+  #changeCount(column, delta) {
+    const counter = column.querySelector(".cards__expander-count")
+    const count = Number(counter.dataset.count) + delta
+    counter.dataset.count = count
+    counter.textContent = count > 99 ? "99+" : count
+  }
+
+  #save(card, column) {
+    const options = { responseKind: "json" }
+    switch (column.dataset.dropDestination) {
+      case "column": return post(card.dataset.cardTriageUrl, { ...options, body: { column_id: column.dataset.columnId } })
+      case "maybe": return destroy(card.dataset.cardTriageUrl, options)
+      case "closed": return post(card.dataset.cardClosureUrl, options)
+      case "not-now": return post(card.dataset.cardNotNowUrl, options)
+    }
+  }
+}
