 Returns `204 No Content` on success.
 
+## Board publication
+
+`public_url` is `null` by default. Account admins with access to a board can publish it with `POST /:account_slug/boards/:board_id/publication`. The JSON response is `201 Created` with the board, including its secret `public_url`.
+
+Anyone with that URL can view the board without signing in. Append `/columns/:id` or `/cards/:number` to open a column or published card directly. Drafts are not shared.
+
+`DELETE /:account_slug/boards/:board_id/publication` revokes the link and returns `204 No Content`. Publishing again creates a new link.
+
 ## Board Accesses
 
 Board accesses let you see who has access to a board and their involvement level (watching or access only). Any board member can view this information.
diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..1e31ac2
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    sign_in_as :kevin
+  end
+
+  test "publish, browse without a session, and revoke" do
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body.fetch("public_url")
+
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    get board_path(@board), as: :json
+    url = response.parsed_body.fetch("public_url")
+
+    sign_out
+    get url
+    assert_response :success
+    assert_select "a[href=?]", "#{URI(url).path}/columns/#{columns(:writebook_triage).id}"
+
+    get "#{url}/columns/#{columns(:writebook_triage).id}"
+    assert_response :success
+    assert_select "a[href=?]", "#{URI(url).path}/cards/1", text: cards(:logo).title
+    get "#{url}/cards/1"
+    assert_response :success
+    assert_select "h1", cards(:logo).title
+
+    cards(:logo).drafted!
+    get "#{url}/cards/1"
+    assert_response :not_found
+
+    sign_in_as :kevin
+    delete board_publication_path(@board), as: :json
+    assert_response :success
+    get url
+    assert_response :not_found
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body.fetch("public_url")
+  end
+
+  test "only account admins can publish or revoke, even if the member created the board" do
+    logout_and_sign_in_as :david
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_nil @board.reload.public_key
+
+    @board.publish
+    key = @board.public_key
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_equal key, @board.reload.public_key
+  end
+
+  test "publishing twice preserves the URL but republishing after revocation issues a fresh one" do
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    key = @board.reload.public_key
+    post board_publication_path(@board)
+    assert_equal key, @board.reload.public_key
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    post board_publication_path(@board)
+    assert_not_equal key, @board.reload.public_key
+    get public_board_card_path(key, cards(:logo))
+    assert_response :not_found
+  end
+
+  test "a key cannot open resources on other boards or accounts" do
+    private_board = boards(:private)
+    private_board.publish
+    key = private_board.public_key
+    sign_out
+
+    get public_board_column_path(key, columns(:writebook_triage))
+    assert_response :not_found
+    get public_board_card_path(key, cards(:logo))
+    assert_response :not_found
+    get public_board_path(key, script_name: accounts(:initech).slug)
+    assert_response :not_found
+  end
+end
