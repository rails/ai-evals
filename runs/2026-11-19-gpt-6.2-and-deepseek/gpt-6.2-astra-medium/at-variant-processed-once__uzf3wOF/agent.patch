diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..4615f64 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -22,6 +22,30 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "white-rabbit.webp", updated_picture.image.filename.to_s
   end
 
+  test "reading an uploaded picture serves the background variant without transforming it again" do
+    leaf = leaves(:reading_picture)
+    put leafable_path(leaf), params: { picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") } }
+    assert_response :no_content
+
+    assert_notifications_count("transform.active_storage", 1) do
+      perform_enqueued_jobs only: ActiveStorage::CreateVariantsJob
+      perform_enqueued_jobs only: ActiveStorage::TransformJob
+    end
+    variants = leaf.reload.picture.image.blob.variant_records
+    derived_image = variants.sole.image
+
+    assert_no_notifications("transform.active_storage") do
+      get leafable_slug_path(leaf)
+      assert_response :ok
+      get css_select("figure.page--picture img").sole["src"]
+      follow_redirect!
+      assert_response :ok
+      assert_equal "image/webp", response.media_type
+      assert_equal derived_image.download, response.body
+    end
+    assert_equal 1, variants.count
+  end
+
   test "update caption" do
     get edit_leafable_path(leaves(:reading_picture))
     assert_response :ok
