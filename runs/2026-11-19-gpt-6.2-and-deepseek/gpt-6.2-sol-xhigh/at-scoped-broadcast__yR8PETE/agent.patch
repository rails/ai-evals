diff --git a/app/jobs/broadcast_being_edited_job.rb b/app/jobs/broadcast_being_edited_job.rb
new file mode 100644
index 0000000..f107f6a
--- /dev/null
+++ b/app/jobs/broadcast_being_edited_job.rb
@@ -0,0 +1,15 @@
+class BroadcastBeingEditedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(leaf, user)
+    return unless leaf.active?
+
+    content = ApplicationController.render partial: "leaves/being_edited_by",
+      formats: [ :turbo_stream ], locals: { leaf: leaf, user: user }
+
+    # Resolve editors at delivery time; a revoked editor may still have the stream open.
+    leaf.book.active_editors.where.not(id: user.id).find_each do |editor|
+      Turbo::StreamsChannel.broadcast_stream_to leaf, :being_edited, editor, content: content
+    end
+  end
+end
