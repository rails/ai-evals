     access_for(user: user)&.editor? || user&.administrator?
   end
 
+  def active_editors
+    editors = User.active.where(id: accesses.editor.select(:user_id))
+    administrators = User.active.administrator
+    # The editor loads books through accessable_or_published, which joins accesses.
+    administrators = administrators.where(id: accesses.select(:user_id)) unless published? && accesses.exists?
+
+    editors.or(administrators)
+  end
+
   def access_for(user: Current.user)
     accesses.find_by(user: user)
   end
