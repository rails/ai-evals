diff --git a/test/integration/editing_presence_test.rb b/test/integration/editing_presence_test.rb
new file mode 100644
index 0000000..555effd
--- /dev/null
+++ b/test/integration/editing_presence_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class EditingPresenceTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+  include ActiveJob::TestHelper
+
+  test "a save notifies existing editors but not a collaborator removed from the book" do
+    leaf = leaves(:welcome_page)
+    removed_stream = editing_stream(leaf, :kevin)
+    retained_stream = editing_stream(leaf, :jason)
+    other_page_stream = editing_stream(leaves(:summary_page), :jason)
+
+    sign_in :david
+    patch book_path(leaf.book), params: { book: { everyone_access: false }, editor_ids: [ users(:jason).id ] }
+    assert_redirected_to book_slug_path(leaf.book)
+    assert_not leaf.book.accessable?(user: users(:kevin))
+
+    messages = capture_broadcasts(retained_stream) do
+      perform_enqueued_jobs { save_page(leaf) }
+    end
+
+    assert_no_broadcasts "#{leaf.to_gid_param}:being_edited"
+    assert_no_broadcasts removed_stream
+    assert_no_broadcasts other_page_stream
+    assert_equal 1, messages.size
+
+    target = ActionView::RecordIdentifier.dom_id(leaf, :being_edited)
+    indicator = Nokogiri::HTML.fragment(messages.first).at_css("turbo-stream[action='append'][target='#{target}'] .being-edited-by strong")
+    assert_equal users(:david).name, indicator&.text
+  end
+
+  test "a queued update does not notify an editor downgraded to reader before delivery" do
+    leaf = leaves(:welcome_page)
+    downgraded_stream = editing_stream(leaf, :kevin)
+    retained_stream = editing_stream(leaf, :jason)
+
+    sign_in :david
+    assert_enqueued_jobs(1) { save_page(leaf) }
+    accesses(:kevin_handbook).reader!
+
+    assert_broadcasts(retained_stream, 1) { perform_enqueued_jobs }
+    assert_no_broadcasts downgraded_stream
+  end
+
+  private
+    def editing_stream(leaf, viewer)
+      sign_in viewer
+      get edit_leafable_path(leaf)
+      assert_response :ok
+
+      source = assert_select("turbo-cable-stream-source[signed-stream-name]", count: 1).first
+      Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    end
+
+    def save_page(leaf)
+      put leafable_path(leaf), params: { leaf: { title: "Better welcome" }, page: { body: "More interesting words." } }
+      assert_response :no_content
+    end
+end
