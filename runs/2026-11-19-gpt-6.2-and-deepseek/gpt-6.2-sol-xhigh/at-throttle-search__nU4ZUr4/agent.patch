+++ b/test/integration/book_search_rate_limit_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+require "active_record/testing/query_assertions"
+
+class BookSearchRateLimitTest < ActionDispatch::IntegrationTest
+  include ActiveRecord::Assertions::QueryAssertions
+
+  setup do
+    books(:handbook).update!(published: true)
+    books(:manual).update!(published: true)
+    Leaf.reindex_all
+  end
+
+  test "limits anonymous searches per address across books without blocking reading" do
+    freeze_time do
+      reader = { "REMOTE_ADDR" => "127.0.0.1", "HTTP_X_FORWARDED_FOR" => "198.51.100.1" }
+      other_reader = reader.merge("HTTP_X_FORWARDED_FOR" => "198.51.100.2")
+      handbook, manual = books(:handbook, :manual)
+
+      get book_slug_path(handbook), env: reader
+      assert_response :success
+
+      15.times do
+        search handbook, from: reader
+        assert_response :success
+        search manual, from: reader
+        assert_response :success
+      end
+
+      assert_no_queries_match(/leaf_search_index/) do
+        search handbook, from: reader
+        assert_response :too_many_requests
+        search manual, from: reader
+        assert_response :too_many_requests
+      end
+
+      get book_slug_path(handbook), env: reader
+      assert_response :success
+      get leafable_slug_path(leaves(:welcome_page)), env: reader
+      assert_response :success
+
+      search handbook, from: other_reader
+      assert_response :success
+      assert_select "a.search__result", text: /Thanks for reading/i
+    end
+  end
+
+  test "only searches admitted in the last minute count toward the limit" do
+    freeze_time do
+      reader = { "REMOTE_ADDR" => "198.51.100.3" }
+      handbook = books(:handbook)
+
+      search handbook, from: reader
+      assert_response :success
+
+      travel 50.seconds
+      29.times do
+        search handbook, from: reader
+        assert_response :success
+      end
+
+      travel 9.seconds
+      search handbook, from: reader
+      assert_response :too_many_requests
+
+      travel 1.second
+      search handbook, from: reader
+      assert_response :success
+      search handbook, from: reader
+      assert_response :too_many_requests
+
+      travel 1.minute
+      search handbook, from: reader
+      assert_response :success
+    end
+  end
+
+  private
+    def search(book, from:)
+      post book_search_path(book), params: { search: "Thanks" }, env: from
+    end
+end
