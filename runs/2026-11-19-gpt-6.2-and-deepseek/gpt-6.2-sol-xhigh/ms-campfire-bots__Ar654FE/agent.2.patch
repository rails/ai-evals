diff --git a/app/models/bot/mention_webhook.rb b/app/models/bot/mention_webhook.rb
new file mode 100644
index 0000000..f62c24e
--- /dev/null
+++ b/app/models/bot/mention_webhook.rb
@@ -0,0 +1,83 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class Bot::MentionWebhook
+  REPLY_CONTENT_TYPES = %w[ text/plain text/html ].freeze
+  MAX_REPLY_SIZE = 1.megabyte
+
+  def initialize(bot, message)
+    @bot, @message, @room = bot, message, message.room
+  end
+
+  def deliver
+    return unless bot.active? && bot.webhook_url.present? && message.mentionees.exists?(bot.id)
+
+    if reply = request_reply(payload)
+      # Membership or webhook settings may have changed while waiting for the reply.
+      bot.post_message(room, **reply) if still_allowed_to_reply?
+    end
+  end
+
+  private
+    attr_reader :bot, :message, :room
+
+    def payload
+      routes = Rails.application.routes.url_helpers
+      {
+        event: "mention",
+        author: { id: message.creator.id, name: message.creator.name },
+        room: { id: room.id, name: room.name, reply_to: routes.room_bot_messages_path(room, bot.code) },
+        message: {
+          id: message.id,
+          body: { text: message.plain_text_body_without_mentioning(bot), html: message.body.body.to_html },
+          link: routes.room_at_message_path(room, message)
+        }
+      }
+    end
+
+    def request_reply(payload)
+      url = URI.parse(bot.webhook_url)
+      request = Net::HTTP::Post.new(url, "Content-Type" => "application/json", "Accept-Encoding" => "identity")
+      request.body = payload.to_json
+
+      Timeout.timeout(10) do
+        # Pin the checked address, disable environment proxies, and never follow redirects.
+        ip = RestrictedHTTP::PrivateNetworkGuard.resolve(url.hostname)
+        Net::HTTP.start(url.hostname, url.port, nil, ipaddr: ip, use_ssl: url.scheme == "https",
+          open_timeout: 3, read_timeout: 5, write_timeout: 5, ignore_eof: false) do |http|
+          http.request(request) { |response| return reply_from(response) }
+        end
+      end
+    rescue RestrictedHTTP::Violation, Surfguard::Unresolvable, Timeout::Error, SocketError,
+      SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::ProtocolError, Net::HTTPBadResponse,
+      Net::HTTPHeaderSyntaxError, URI::Error => error
+      Rails.logger.warn "Bot webhook delivery failed for bot #{bot.id} (#{error.class})"
+      nil
+    end
+
+    def reply_from(response)
+      content_type = response.content_type&.downcase
+      return unless response.is_a?(Net::HTTPOK) && REPLY_CONTENT_TYPES.include?(content_type)
+      return if response.content_length.to_i > MAX_REPLY_SIZE
+
+      bytes = String.new(encoding: Encoding::BINARY)
+      response.read_body do |chunk|
+        return if bytes.bytesize + chunk.bytesize > MAX_REPLY_SIZE
+        bytes << chunk.b
+      end
+
+      charset = response["Content-Type"][/;\s*charset\s*=\s*"?([^";\s]+)/i, 1] || Encoding::UTF_8
+      bytes.force_encoding(charset)
+      return unless bytes.valid_encoding?
+
+      if body = bytes.encode(Encoding::UTF_8).presence
+        { body: body, content_type: content_type }
+      end
+    rescue ArgumentError, EncodingError
+      nil
+    end
+
+    def still_allowed_to_reply?
+      room.users.merge(Bot.active.where(webhook_url: bot.webhook_url)).exists?(bot.id)
+    end
+end
diff --git a/app/models/message/mentionee.rb b/app/models/message/mentionee.rb
index c109f9c..8fda346 100644
--- a/app/models/message/mentionee.rb
+++ b/app/models/message/mentionee.rb
@@ -5,7 +5,28 @@ module Message::Mentionee
     room.users.where(id: mentioned_users.map(&:id))
   end
 
+  def plain_text_body_without_mentioning(user)
+    return "" unless content = body.body
+
+    fragment = content.fragment.replace(ActionText::Attachment.tag_name) do |node|
+      if ActionText::Attachable.from_node(node) == user
+        remove_adjacent_mention_space(node)
+        nil
+      else
+        node
+      end
+    end
+    ActionText::Content.new(fragment, canonicalize: false).to_plain_text.gsub(/\A[[:space:]]+|[[:space:]]+\z/, "")
+  end
+
   private
+    def remove_adjacent_mention_space(node)
+      previous, following = node.previous_sibling, node.next_sibling
+      if previous&.text? && previous.content.match?(/[[:blank:]]\z/) && following&.text?
+        following.content = following.content.sub(/\A[[:blank:]]/, "")
+      end
+    end
+
     def mentioned_users
       if body.body
         body.body.attachables.grep(User).uniq
