@@ -0,0 +1,54 @@
+require "test_helper"
+
+class BotWebhooksTest < ActionDispatch::IntegrationTest
+  test "a mention delivers a callback in the background and the bot can reply both ways" do
+    author = users(:kevin)
+    room = rooms(:hq)
+    bot = author.bots.create!(name: "Build Bot", webhook_url: "https://example.com/mentions")
+    sign_in :kevin
+
+    payload = nil
+    Resolv.stubs(:getaddresses).with("example.com").returns([ "93.184.216.34" ])
+    webhook = stub_request(:post, bot.webhook_url).with(headers: { "Content-Type" => "application/json" }).to_return do |request|
+      payload = JSON.parse(request.body)
+      { status: 200, headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "Build queued ✅\n<em>literally</em>" }
+    end
+
+    body = "<div>#{mention_attachment_for(bot)}&nbsp;<strong>restart</strong> the build please</div>"
+    assert_enqueued_jobs 1, only: Bot::MentionJob do
+      post room_messages_url(room, format: :turbo_stream), params: { message: { body: body } }
+      assert_response :success
+    end
+    assert_not_requested webhook
+    message = room.messages.ordered.last
+    assert_empty bot.messages
+
+    assert_difference -> { bot.messages.count }, 1 do
+      perform_enqueued_jobs only: Bot::MentionJob
+    end
+    assert_requested webhook, times: 1
+    assert_equal({
+      "event" => "mention",
+      "author" => { "id" => author.id, "name" => author.name },
+      "room" => { "id" => room.id, "name" => room.name, "reply_to" => room_bot_messages_path(room, bot.code) },
+      "message" => {
+        "id" => message.id,
+        "body" => { "text" => "restart the build please", "html" => message.body.body.to_html },
+        "link" => room_at_message_path(room, message)
+      }
+    }, payload)
+    assert_equal "Build queued ✅\n<em>literally</em>", bot.messages.last.plain_text_body
+    assert_rendered_turbo_stream_broadcast room, :messages, action: :append, target: [ room, :messages ] do
+      assert_select ".message__author", text: "Build Bot"
+      assert_select ".message__body em", count: 0
+    end
+
+    post payload.dig("room", "reply_to"), params: +"Build finished"
+    assert_response :created
+    assert_includes bot.messages.map(&:plain_text_body), "Build finished"
+
+    get payload.dig("message", "link")
+    assert_response :success
+    assert_select "#message_#{message.client_message_id}"
+  end
+end
