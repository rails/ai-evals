+++ b/test/jobs/bot/mention_job_test.rb
@@ -0,0 +1,158 @@
+require "test_helper"
+require "rails/dom/testing/assertions"
+
+class Bot::MentionJobTest < ActiveSupport::TestCase
+  include Rails::Dom::Testing::Assertions
+
+  setup do
+    @author = users(:kevin)
+    @bot = @author.bots.create!(name: "Build Bot", webhook_url: "https://example.com/mentions")
+    @room = rooms(:hq)
+    Resolv.stubs(:getaddresses).with("example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "each mentioned bot gets one callback with only its own mentions removed" do
+    other_bot = @author.bots.create!(name: "Release Bot", webhook_url: "https://example.com/releases")
+    build_webhook = expect_command(@bot, "ask @Release Bot to deploy @Build Bot")
+    release_webhook = expect_command(other_bot, "@Build Bot @Build Bot ask to deploy @Build Bot")
+
+    assert_enqueued_jobs 2, only: Bot::MentionJob do
+      create_message("#{mention_attachment_for(@bot)} #{mention_attachment_for(@bot)} ask #{mention_attachment_for(other_bot)} to deploy @Build Bot")
+    end
+
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Bot::MentionJob
+    end
+    assert_requested build_webhook, times: 1
+    assert_requested release_webhook, times: 1
+  end
+
+  test "only structured mentions of active room members with a webhook trigger delivery" do
+    closed_room = rooms(:designers)
+    no_webhook = @author.bots.create!(name: "No Webhook")
+    inactive = @author.bots.create!(name: "Inactive", webhook_url: @bot.webhook_url, status: :deactivated)
+    closed_room.memberships.grant_to([ no_webhook, inactive ])
+
+    assert_no_enqueued_jobs only: Bot::MentionJob do
+      closed_room.messages.create!(creator: @author, body: [ @bot, no_webhook, inactive ].map { mention_attachment_for(it) }.join(" "))
+      create_message("@Build Bot as literal text")
+      @room.messages.create!(creator: no_webhook, body: mention_attachment_for(@bot))
+    end
+  end
+
+  test "posts HTML replies as rich text and publishes the usual message events" do
+    webhook = stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => 'Text/HTML; Charset="iso-8859-1"' },
+      body: "<p><strong>Café</strong></p><script>alert(1)</script>".encode("ISO-8859-1"))
+    message = create_mention
+
+    assert_enqueued_with job: Room::PushMessageJob do
+      assert_broadcasts UnreadRoomsChannel.stream_name_for(@author.id), 1 do
+        perform_enqueued_jobs only: Bot::MentionJob
+      end
+    end
+
+    assert_requested webhook
+    assert_equal "Café", @bot.messages.sole.plain_text_body
+    assert_equal message.room, @bot.messages.sole.room
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: :append, target: [ @room, :messages ] do
+      assert_select ".message__body strong", text: "Café"
+      assert_select ".message__body script", count: 0
+    end
+  end
+
+  test "ignores replies that are not successful, supported, nonempty text" do
+    replies = [
+      { status: 201, headers: { "Content-Type" => "text/plain" }, body: "Not a reply" },
+      { status: 302, headers: { "Location" => "https://example.com/redirect" } },
+      { status: 500, headers: { "Content-Type" => "text/html" }, body: "Server error" },
+      { status: 200, headers: { "Content-Type" => "application/json" }, body: "{}" },
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "  \n" },
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "\xff".b },
+      { status: 200, headers: { "Content-Type" => "text/html" }, body: "x" * (1.megabyte + 1) }
+    ]
+    webhook = stub_request(:post, @bot.webhook_url).to_return(*replies)
+
+    replies.size.times { create_mention }
+    assert_no_difference -> { @bot.messages.count } do
+      perform_enqueued_jobs only: Bot::MentionJob
+    end
+    assert_requested webhook, times: replies.size
+    assert_not_requested :post, "https://example.com/redirect"
+    assert_not_requested :get, "https://example.com/redirect"
+  end
+
+  test "an unreachable webhook does not post a reply or retry the request" do
+    webhook = stub_request(:post, @bot.webhook_url).to_timeout
+    create_mention
+
+    assert_no_difference -> { @bot.messages.count } do
+      perform_enqueued_jobs only: Bot::MentionJob
+    end
+    assert_requested webhook, times: 1
+  end
+
+  test "private webhook destinations are blocked" do
+    @bot.update!(webhook_url: "https://internal.example.com/mentions")
+    Resolv.stubs(:getaddresses).with("internal.example.com").returns([ "127.0.0.1" ])
+    webhook = stub_request(:post, @bot.webhook_url)
+    create_mention
+
+    assert_no_difference -> { @bot.messages.count } do
+      perform_enqueued_jobs only: Bot::MentionJob
+    end
+    assert_not_requested webhook
+  end
+
+  test "does not deliver queued messages if the bot loses access or the mention is removed" do
+    webhook = stub_request(:post, @bot.webhook_url)
+    first = create_mention
+    first.update!(body: "No longer mentioning a bot")
+    perform_enqueued_jobs only: Bot::MentionJob
+
+    create_mention
+    @room.memberships.revoke_from(@bot)
+    perform_enqueued_jobs only: Bot::MentionJob
+
+    assert_not_requested webhook
+  end
+
+  test "clearing a webhook prevents delivery of queued mentions" do
+    webhook = stub_request(:post, @bot.webhook_url)
+    create_mention
+    @bot.update!(webhook_url: "")
+
+    perform_enqueued_jobs only: Bot::MentionJob
+    assert_not_requested webhook
+  end
+
+  test "does not post a reply if the bot loses access while the request is running" do
+    webhook = stub_request(:post, @bot.webhook_url).to_return do
+      @room.memberships.revoke_from(@bot)
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "Here is a reply" }
+    end
+    create_mention
+
+    assert_no_difference -> { @bot.messages.count } do
+      perform_enqueued_jobs only: Bot::MentionJob
+    end
+    assert_requested webhook
+  end
+
+  private
+    def create_mention
+      create_message("#{mention_attachment_for(@bot)} deploy")
+    end
+
+    def create_message(body)
+      @room.messages.create!(creator: @author, body: "<div>#{body}</div>")
+    end
+
+    def expect_command(bot, text)
+      stub_request(:post, bot.webhook_url).with do |request|
+        payload = JSON.parse(request.body)
+        payload.dig("message", "body", "text") == text &&
+          payload.dig("room", "reply_to") == Rails.application.routes.url_helpers.room_bot_messages_path(@room, bot.code)
+      end.to_return(status: 204)
+    end
+end
