new file mode 100644
index 0000000..2625e92
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,17 @@
+class Bot < User
+  belongs_to :creator, class_name: "User"
+
+  validates :name, presence: true
+
+  # Users require a password digest, but bots cannot sign in to the web app.
+  before_create { self.password = SecureRandom.base64(32) }
+
+  # Purpose-scoped signed IDs let us show a stable code without storing the credential.
+  def self.authenticate_code(code)
+    active.find_signed(code, purpose: :bot_code)
+  end
+
+  def code
+    signed_id(purpose: :bot_code)
+  end
+end
