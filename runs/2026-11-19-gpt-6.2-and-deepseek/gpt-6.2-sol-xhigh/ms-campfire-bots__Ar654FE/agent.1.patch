+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "a member can set up a bot with an avatar from account settings" do
+    get edit_account_url
+    assert_select "a[href='/bots']", text: "Set up chat bots"
+
+    get bots_url
+    assert_select "a[href='/bots/new']", text: "Add a chat bot"
+
+    get new_bot_url
+    assert_select "label", text: "Name the bot"
+    assert_select "button[type=submit]", text: "Save changes"
+
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Deploy Bot", avatar: file_fixture_upload("earth.png"), role: "administrator" } }
+    end
+    assert_redirected_to bots_url
+
+    bot = Bot.last
+    assert_equal users(:kevin), bot.creator
+    assert bot.member?
+    assert bot.avatar.attached?
+    assert_equal Room.opens.ids.sort, bot.room_ids.sort
+
+    follow_redirect!
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_select "li" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "label[for='code_bot_#{bot.id}']", text: "Bot code"
+      assert_select "input#code_bot_#{bot.id}[readonly][value='#{bot.code}']"
+      assert_select "a[href='#{edit_bot_path(bot)}']", text: "Edit Deploy Bot"
+    end
+  end
+
+  test "a blank name does not create a bot" do
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { name: " " } }
+    end
+    assert_response :unprocessable_content
+    assert_select "label", text: "Name the bot"
+  end
+
+  test "members only see and manage their bots, while administrators manage all bots" do
+    own_bot = users(:kevin).bots.create!(name: "Deploy Bot")
+    other_bot = users(:jz).bots.create!(name: "Build Bot")
+    assert_not_equal own_bot.code, other_bot.code
+
+    get bots_url(page: 2)
+    assert_includes response.body, own_bot.code
+    assert_not_includes response.body, other_bot.code
+
+    get edit_bot_url(other_bot)
+    assert_response :not_found
+    patch bot_url(other_bot), params: { bot: { name: "Changed" } }
+    assert_response :not_found
+    delete bot_url(other_bot)
+    assert_response :not_found
+
+    sign_in :david
+    get bots_url
+    assert_includes response.body, own_bot.code
+    assert_includes response.body, other_bot.code
+
+    code = other_bot.code
+    get edit_bot_url(other_bot)
+    assert_select "form[data-turbo-confirm] button", text: "Delete this chat bot"
+    assert_not_includes response.body, code
+
+    patch bot_url(other_bot), params: { bot: { name: "Renamed Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Renamed Bot", other_bot.reload.name
+    assert_equal code, other_bot.code
+
+    delete bot_url(other_bot)
+    assert_redirected_to bots_url
+    follow_redirect!
+    assert_not_includes response.body, code
+  end
+end
