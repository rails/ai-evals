+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = users(:kevin).bots.create!(name: "Deploy Bot")
+    @room = rooms(:hq)
+  end
+
+  test "posts the raw body as the bot and delivers it like other messages" do
+    body = "Deploy of v1.2.3 finished ✅\n<em>literal</em> & done"
+
+    assert_difference -> { @room.messages.count }, 1 do
+      assert_enqueued_with(job: Room::PushMessageJob) do
+        post room_bot_messages_path(@room, @bot.code), params: body.dup, headers: form_headers
+        assert_response :created
+      end
+    end
+
+    message = @bot.messages.last
+    assert_equal body, message.plain_text_body
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: :append, target: [ @room, :messages ] do
+      assert_select ".message__author", text: "Deploy Bot"
+      assert_select ".message__body em", count: 0
+    end
+
+    location = response.headers["Location"]
+    sign_in :kevin
+    get location
+    assert_response :ok
+    assert_select ".message__author", text: "Deploy Bot"
+  end
+
+  test "does not interpret body bytes as an envelope or method override" do
+    post room_bot_messages_path(@room, @bot.code), params: +"_method=DELETE&value=%FF", headers: form_headers
+    assert_response :created
+    assert_equal "_method=DELETE&value=%FF", @bot.messages.last.plain_text_body
+
+    post room_bot_messages_path(@room, @bot.code), params: +"not JSON", headers: { "CONTENT_TYPE" => "application/json" }
+    assert_response :created
+    assert_equal "not JSON", @bot.messages.last.plain_text_body
+  end
+
+  test "rejects missing content, invalid credentials, and inaccessible rooms without publishing" do
+    assert_no_difference -> { Message.count } do
+      [ "", " \n\t" ].each do |body|
+        post room_bot_messages_path(@room, @bot.code), params: body.dup
+        assert_response :unprocessable_content
+      end
+
+      sign_in :kevin
+      post room_bot_messages_path(@room, "invalid.code"), params: +"Hello", headers: form_headers
+      assert_response :unauthorized
+
+      post room_bot_messages_path("#{@room.id}-invalid", @bot.code), params: +"Hello", headers: form_headers
+      assert_response :not_found
+
+      post room_bot_messages_path(rooms(:designers), @bot.code), params: +"Hello", headers: form_headers
+      assert_response :not_found
+    end
+  end
+
+  test "can post to a closed room after being granted membership, until deleted" do
+    room = rooms(:designers)
+    sign_in :david
+    get edit_rooms_closed_url(room)
+    assert_select "label.switch" do
+      assert_select "input[type=checkbox][value='#{@bot.id}']"
+    end
+
+    patch rooms_closed_url(room), params: { room: { name: room.name }, user_ids: room.user_ids.including(@bot.id) }
+    assert_redirected_to room_url(room)
+    code = @bot.code
+
+    post room_bot_messages_path(room, code), params: +"Hello", headers: form_headers
+    assert_response :created
+    message = @bot.messages.last
+
+    sign_in :kevin
+    delete bot_url(@bot)
+    assert_redirected_to bots_url
+    assert_equal @bot, message.reload.creator
+
+    post room_bot_messages_path(room, code), params: +"Hello again", headers: form_headers
+    assert_response :unauthorized
+  end
+
+  test "redacts the credential in request instrumentation" do
+    path = room_bot_messages_path(@room, @bot.code)
+    events = []
+
+    ActiveSupport::Notifications.subscribed(->(event) { events << event.payload }, "start_processing.action_controller") do
+      post path, params: +"Hello", headers: form_headers
+      assert_response :created
+    end
+
+    payload = events.sole
+    assert_equal "/rooms/#{@room.id}/[FILTERED]/messages", payload[:path]
+    assert_equal "[FILTERED]", payload[:params]["bot_code"]
+  end
+
+  private
+    def form_headers
+      { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..26824fb
