diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..7689481
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,29 @@
+class Bots::MessagesController < ActionController::API
+  include BlockBannedRequests, SetCurrentRequest, VersionHeaders
+
+  before_action :authenticate_bot
+
+  def create
+    return head :not_found unless room = find_room
+
+    text = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+    return head :unprocessable_content unless text.valid_encoding? && text.present?
+
+    body = ERB::Util.html_escape(text).gsub(/\r\n?|\n/, "<br>")
+    message = room.messages.create_with_attachment!(body: body, creator: @bot)
+    message.broadcast_create
+
+    head :created, location: message_path(message)
+  end
+
+  private
+    def find_room
+      room_id = request.path_parameters[:room_id]
+      @bot.rooms.find_by(id: room_id) if /\A[0-9]+\z/.match?(room_id)
+    end
+
+    def authenticate_bot
+      @bot = Bot.authenticate_code(request.path_parameters[:bot_code])
+      head :unauthorized unless @bot
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..49fcdce
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,52 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+  before_action :no_store, only: :index
+
+  def index
+    @bots = accessible_bots.with_attached_avatar.ordered
+  end
+
+  def new
+    @bot = Current.user.bots.build
+  end
+
+  def create
+    @bot = Current.user.bots.build(bot_params)
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url, status: :see_other
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url, status: :see_other
+  end
+
+  private
+    def set_bot
+      @bot = accessible_bots.find_by(id: params[:id])
+      head :not_found unless @bot
+    end
+
+    def accessible_bots
+      (Current.user.administrator? ? Bot : Current.user.bots).active
+    end
+
+    def bot_params
+      params.expect(bot: [ :name, :avatar ])
+    end
+end
