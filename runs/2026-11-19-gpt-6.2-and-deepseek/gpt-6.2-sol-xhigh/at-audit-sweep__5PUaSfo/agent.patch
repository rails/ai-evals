diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..96816a6
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  test "search only returns active results from readable books" do
+    handbook_page = leaves(:welcome_page)
+    manual_page = leaves(:summary_page)
+    manual_page.update!(book: books(:manual), title: "Welcome to the Manual")
+    leaves(:welcome_section).trashed!
+
+    sign_in :kevin
+    search " welcome "
+    assert_results handbook_page
+
+    books(:manual).update!(published: true)
+    search "welcome"
+    assert_results handbook_page, manual_page
+
+    sign_out
+    search "welcome"
+    assert_results manual_page
+  end
+
+  test "search returns no results when no books are readable" do
+    search "welcome"
+
+    assert_select "a.search__result", count: 0
+    assert_in_body "No matches."
+  end
+
+  test "search finds titles containing an apostrophe" do
+    sign_in :kevin
+    page = leaves(:welcome_page)
+    page.update!(title: "Reader's Guide")
+
+    search "Reader's"
+    assert_results page
+  end
+
+  test "search treats percent signs, underscores, and the escape character literally" do
+    sign_in :kevin
+    discount = leaves(:welcome_page)
+    filename = leaves(:summary_page)
+    other_discount = leaves(:welcome_section)
+    discount.update!(title: "Save 50% off")
+    filename.update!(title: "File_name")
+    other_discount.update!(title: "Save 50x off!")
+    leaves(:reading_picture).update!(title: "File name")
+
+    { "Save 50% off" => discount, "%" => discount, "File_name" => filename, "_" => filename, "!" => other_discount }.each do |term, result|
+      search term
+      assert_results result
+    end
+  end
+
+  private
+    def search(term)
+      get library_search_path, params: { q: term }
+      assert_response :success
+    end
+
+    def assert_results(*leaves)
+      assert_select "a.search__result", count: leaves.size do |results|
+        assert_equal leaves.map { |leaf| leafable_slug_path(leaf) }, results.map { |result| result["href"] }
+      end
+    end
+end
