diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..1107f50
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,35 @@
+class Bots::MessagesController < ActionController::API
+  include BlockBannedRequests, SetCurrentRequest, VersionHeaders
+
+  before_action :no_store, :set_bot
+
+  def create
+    result = @bot.bot_moderation.post(room_id, message_body)
+    if result.message
+      head :created, location: message_path(result.message)
+    else
+      response.set_header("Retry-After", result.retry_after.to_s) if result.retry_after
+      head result.status
+    end
+  end
+
+  private
+    def set_bot
+      @bot = User.find_by_bot_code(request.path_parameters[:bot_code])
+      if @bot.nil?
+        head :unauthorized
+      elsif @bot.suspended?
+        head :forbidden
+      end
+    end
+
+    def room_id
+      id = request.path_parameters[:room_id]
+      id if id.match?(/\A\d+\z/)
+    end
+
+    def message_body
+      text = request.raw_post.to_s.dup.force_encoding(Encoding::UTF_8)
+      ERB::Util.html_escape(text).gsub(/\r\n?|\n/, "<br>") if text.valid_encoding? && text.present?
+    end
+end
