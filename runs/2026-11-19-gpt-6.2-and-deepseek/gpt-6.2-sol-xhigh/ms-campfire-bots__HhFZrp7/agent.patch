+    <p class="txt-align-center margin-none" role="alert"><%= t("bots.limit_reached") %></p>
+  <% else %>
+    <%= link_to new_bot_path, class: "btn btn--reversed center" do %>
+      <%= image_tag "add.svg", size: 20, aria: { hidden: "true" } %>
+      <span>Add a chat bot</span>
