+require "test_helper"
+
+class BotJoinedWebhooksTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+    @bot = users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://bot.example.com/events")
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "adding a bot through room settings sends one joined callback, with a plain text reply" do
+    room = rooms(:designers)
+    webhook = stub_request(:post, @bot.webhook_url).with(
+      headers: { "Content-Type" => "application/json" },
+      body: { event: "joined", room: { id: room.id, name: room.name, reply_to: room_bot_messages_path(room, @bot.bot_code) } }.to_json
+    ).to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Hello <team>!\nReady to deploy.")
+
+    save_members(room, @bot, users(:david))
+    save_members(room, @bot, users(:david))
+    assert_not_requested webhook
+
+    assert_difference -> { room.messages.count }, 1 do
+      perform_enqueued_jobs
+    end
+    assert_rendered_turbo_stream_broadcast room, :messages, action: :append, target: [ room, :messages ] do
+      assert_select ".message__author", text: @bot.name
+    end
+    reply = room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Hello <team>!\nReady to deploy.", reply.plain_text_body
+
+    save_members(room, users(:david))
+    save_members(room, @bot, users(:david))
+    perform_enqueued_jobs
+    assert_requested webhook, times: 1
+  end
+
+  test "enabling automatic membership notifies only for new rooms, including rooms that later become open" do
+    room = rooms(:hq)
+    room.memberships.grant_to @bot
+    webhook = stub_request(:post, @bot.webhook_url).to_return(status: 204)
+    perform_enqueued_jobs only: Room::DeliverBotJoinedJob
+
+    patch bot_url(@bot), params: { bot: { add_to_all_open_rooms: "1" } }
+    assert_redirected_to bots_url
+    post rooms_opens_url, params: { room: { name: "Ops" } }
+    future_room = Room.last
+    converted_room = rooms(:designers)
+    patch rooms_open_url(converted_room), params: { room: { name: converted_room.name } }
+
+    perform_enqueued_jobs only: Room::DeliverBotJoinedJob
+
+    assert_equal Rooms::Open.ids.sort, @bot.room_ids.sort
+    assert_requested webhook, times: Rooms::Open.count
+    Rooms::Open.find_each do |open_room|
+      assert_requested :post, @bot.webhook_url, body: { event: "joined", room: {
+        id: open_room.id, name: open_room.name, reply_to: room_bot_messages_path(open_room, @bot.bot_code)
+      } }.to_json, times: 1
+    end
+    assert_includes @bot.rooms, future_room
+    assert_includes @bot.rooms, converted_room
+  end
+
+  test "a joined callback's HTML reply is posted and sanitized" do
+    room = rooms(:hq)
+    webhook = stub_request(:post, @bot.webhook_url).to_return(status: 200, headers: { "Content-Type" => "text/html" },
+      body: "<script>alert(1)</script><p onclick='alert(2)'>Hello <strong>team</strong>!</p>")
+
+    membership = room.memberships.create!(user: @bot)
+    perform_enqueued_jobs only: Room::DeliverBotJoinedJob
+    Room::DeliverBotJoinedJob.perform_now(membership)
+
+    reply = room.messages.order(:id).last
+    assert_requested webhook, times: 1
+    assert_equal @bot, reply.creator
+    assert_equal "<p>Hello <strong>team</strong>!</p>", reply.body.body.to_html
+  end
+
+  test "a membership that is rolled back or revoked before delivery does not send a callback" do
+    room = rooms(:hq)
+    webhook = stub_request(:post, @bot.webhook_url).to_return(status: 204)
+
+    assert_no_enqueued_jobs only: Room::DeliverBotJoinedJob do
+      Room.transaction(requires_new: true) do
+        room.memberships.grant_to @bot
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    room.memberships.grant_to @bot
+    room.memberships.revoke_from @bot
+    perform_enqueued_jobs only: Room::DeliverBotJoinedJob
+    assert_not_requested webhook
+
+    room.memberships.grant_to @bot
+    perform_enqueued_jobs only: Room::DeliverBotJoinedJob
+    assert_requested webhook, times: 1
+  end
+
+  test "direct conversations never send joined callbacks" do
+    webhook = stub_request(:post, @bot.webhook_url)
+
+    perform_enqueued_jobs do
+      post rooms_directs_url, params: { user_ids: [ @bot.id ] }
+      assert_includes @bot.rooms, Room.directs.last
+    end
+
+    assert_not_requested webhook
+  end
+
+  private
+    def save_members(room, *members)
+      patch rooms_closed_url(room), params: { room: { name: room.name }, user_ids: members.map(&:id) }
+      assert_redirected_to room_url(room)
+    end
+end
diff --git a/test/controllers/bot_webhooks_test.rb b/test/controllers/bot_webhooks_test.rb
new file mode 100644
index 0000000..f2348ba
--- /dev/null
+++ b/test/controllers/bot_webhooks_test.rb
@@ -0,0 +1,177 @@
+require "test_helper"
+
+class BotWebhooksTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+    @room = rooms(:hq)
+    @bot = users(:kevin).bots.create!(name: "Deploy Bot", webhook_url: "https://bot.example.com/mentions")
+    @room.memberships.grant_to @bot
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "mentioning a bot delivers a callback after posting and broadcasts its plain text reply" do
+    webhook = stub_request(:post, @bot.webhook_url).to_return(
+      status: 200, headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "Build <started>\nThanks! 🔥")
+
+    message = post_mention("#{bot_mention}&nbsp;restart the <strong>build</strong> please")
+    assert_not_requested webhook
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: Message::DeliverBotMentionJob
+    end
+
+    assert_requested :post, @bot.webhook_url, headers: { "Content-Type" => "application/json" }, times: 1 do |request|
+      payload = JSON.parse(request.body)
+      assert_equal "mention", payload["event"]
+      assert_equal({ "id" => users(:david).id, "name" => "David" }, payload["author"])
+      assert_equal({ "id" => @room.id, "name" => @room.name, "reply_to" => room_bot_messages_path(@room, @bot.bot_code) }, payload["room"])
+      assert_equal message.id, payload.dig("message", "id")
+      assert_equal room_at_message_path(@room, message), payload.dig("message", "link")
+      assert_equal "restart the build please", payload.dig("message", "body", "text")
+      assert_includes payload.dig("message", "body", "html"), "Deploy Bot"
+      assert_includes payload.dig("message", "body", "html"), "<strong>build</strong>"
+    end
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Build <started>\nThanks! 🔥", reply.plain_text_body
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: :append, target: [ @room, :messages ] do
+      assert_select ".message__author", text: @bot.name
+      assert_select ".message__body", text: /Build <started>/
+    end
+  end
+
+  test "an HTML reply keeps formatting but does not allow scripts or attachments" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200, headers: { "Content-Type" => "text/html" },
+      body: "<script>alert(1)</script><p onclick='alert(2)'>Build <strong>finished</strong>#{bot_mention}</p>")
+
+    post_mention bot_mention
+    assert_no_enqueued_jobs only: Message::DeliverBotMentionJob do
+      perform_enqueued_jobs only: Message::DeliverBotMentionJob
+    end
+
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Build finished", reply.plain_text_body
+    assert_equal "<p>Build <strong>finished</strong></p>", reply.body.body.to_html
+  end
+
+  test "a bot can return no content and use the supplied path to reply later" do
+    reply_to = nil
+    webhook = stub_request(:post, @bot.webhook_url).to_return do |request|
+      reply_to = JSON.parse(request.body).dig("room", "reply_to")
+      { status: 204 }
+    end
+
+    post_mention bot_mention
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Message::DeliverBotMentionJob
+    end
+    assert_requested webhook
+    assert reply_to.start_with?("/rooms/")
+
+    post reply_to, params: +"Build finished", headers: { "Content-Type" => "text/plain" }
+    assert_response :created
+    assert_equal @bot, @room.messages.order(:id).last.creator
+    assert_equal "Build finished", @room.messages.order(:id).last.plain_text_body
+  end
+
+  test "API posts and webhook replies share the same limit and cooldown attempts" do
+    webhook = stub_request(:post, @bot.webhook_url).to_return(
+      status: 200, headers: { "Content-Type" => "text/plain" }, body: "Build finished")
+
+    freeze_time do
+      message = post_mention bot_mention
+      9.times do
+        post room_bot_messages_path(@room, @bot.bot_code), params: +"Deploy"
+        assert_response :created
+      end
+      Message::DeliverBotMentionJob.perform_now(message, @bot)
+      assert_equal 10, @bot.messages.count
+
+      assert_no_difference -> { @bot.messages.count } do
+        # The first excess reply starts the cooldown; five more attempts suspend.
+        6.times { Message::DeliverBotMentionJob.perform_now(message, @bot) }
+        post room_bot_messages_path(@room, @bot.bot_code), params: +"Suspended"
+        assert_response :forbidden
+      end
+      assert_requested webhook, times: 7
+    end
+  end
+
+  test "consecutive failures of both callback types suspend the bot, but any 2xx resets the streak" do
+    webhook = stub_request(:post, @bot.webhook_url)
+    webhook.to_return(status: 500).times(9).then.to_return(status: 202).then
+      .to_return(status: 302).times(7).then.to_timeout.then.to_raise(Errno::ECONNREFUSED)
+      .then.to_return(status: 404)
+
+    message = post_mention bot_mention
+    9.times { Message::DeliverBotMentionJob.perform_now(message, @bot) }
+    perform_enqueued_jobs only: Room::DeliverBotJoinedJob # 202 (no reply)
+    9.times { Message::DeliverBotMentionJob.perform_now(message, @bot) }
+
+    post room_bot_messages_path(@room, @bot.bot_code), params: +"Still active"
+    assert_response :created
+
+    room = rooms(:designers)
+    room.memberships.grant_to @bot
+    perform_enqueued_jobs only: Room::DeliverBotJoinedJob # tenth consecutive failure
+    post room_bot_messages_path(@room, @bot.bot_code), params: +"Suspended"
+    assert_response :forbidden
+    assert_equal 1, @bot.messages.count
+
+    assert_no_enqueued_jobs only: [ Message::DeliverBotMentionJob, Room::DeliverBotJoinedJob ] do
+      post_mention bot_mention
+      @room.memberships.revoke_from @bot
+      @room.memberships.grant_to @bot
+    end
+    # Jobs that were already queued must also skip delivery.
+    perform_enqueued_jobs only: Message::DeliverBotMentionJob
+    Room::DeliverBotJoinedJob.perform_now(@room.memberships.find_by!(user: @bot))
+    assert_requested webhook, times: 20
+
+    get bots_url
+    assert_select "li", text: /Deploy Bot.*Suspended.*webhook failures/im
+
+    post bot_reactivation_url(@bot)
+    assert_redirected_to bots_url
+    stub_request(:post, @bot.webhook_url).to_return(status: 500)
+    Message::DeliverBotMentionJob.perform_now(post_mention(bot_mention), @bot)
+    assert_requested webhook, times: 21
+
+    post room_bot_messages_path(@room, @bot.bot_code), params: +"Reactivated after failures"
+    assert_response :created
+  end
+
+  test "a reply from before reactivation is ignored even if it arrives after reactivation" do
+    webhook = stub_request(:post, @bot.webhook_url).to_return do
+      # Simulate a suspension and reactivation while the remote server is responding.
+      @bot.update!(bot_suspension_reason: "flooding")
+      post bot_reactivation_url(@bot)
+      assert_redirected_to bots_url
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "Stale reply" }
+    end
+    message = post_mention bot_mention
+
+    assert_no_difference -> { @bot.messages.count } do
+      Message::DeliverBotMentionJob.perform_now(message, @bot)
+    end
+    assert_requested webhook, times: 1
+
+    stub_request(:post, @bot.webhook_url).to_return(
+      status: 200, headers: { "Content-Type" => "text/plain" }, body: "New reply")
+    Message::DeliverBotMentionJob.perform_now(post_mention(bot_mention), @bot)
+    assert_equal "New reply", @bot.messages.sole.plain_text_body
+  end
+
+  private
+    def post_mention(body)
+      post room_messages_url(@room, format: :turbo_stream), params: { message: { body: "<div>#{body}</div>" } }
+      assert_response :success
+      @room.messages.order(:id).last
+    end
+
+    def bot_mention
+      %(<action-text-attachment sgid="#{@bot.attachable_sgid}" content-type="application/vnd.campfire.mention"></action-text-attachment>)
+    end
+end
