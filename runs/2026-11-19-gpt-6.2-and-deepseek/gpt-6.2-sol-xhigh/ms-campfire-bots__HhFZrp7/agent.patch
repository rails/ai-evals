diff --git a/test/system/managing_bots_test.rb b/test/system/managing_bots_test.rb
new file mode 100644
index 0000000..094735e
--- /dev/null
+++ b/test/system/managing_bots_test.rb
@@ -0,0 +1,111 @@
+require "application_system_test_case"
+
+class ManagingBotsTest < ApplicationSystemTestCase
+  test "a member creates, edits, and deletes a bot from account settings" do
+    sign_in "kevin@37signals.com"
+    visit edit_account_path
+    click_on "Set up chat bots"
+    assert_current_path bots_path
+
+    click_on "Add a chat bot"
+    assert_unchecked_field "Add to all open rooms"
+    fill_in "Name the bot", with: "Deploy Bot"
+    fill_in "Webhook URL", with: "https://bot.example.com/mentions"
+    click_on "Save changes"
+
+    assert_current_path bots_path
+    within "li", text: "Deploy Bot" do
+      assert_selector :field, "Bot code", readonly: true
+      click_on "Edit Deploy Bot"
+    end
+
+    assert_field "Webhook URL", with: "https://bot.example.com/mentions"
+    assert_unchecked_field "Add to all open rooms"
+    check "Add to all open rooms"
+    fill_in "Webhook URL", with: ""
+    fill_in "Name the bot", with: "Release Bot"
+    click_on "Save changes"
+    click_on "Edit Release Bot"
+    assert_field "Webhook URL", with: ""
+    assert_checked_field "Add to all open rooms"
+
+    dismiss_confirm do
+      click_on "Delete this chat bot"
+    end
+    assert_text "Edit Release Bot"
+
+    accept_confirm do
+      click_on "Delete this chat bot"
+    end
+    assert_current_path bots_path
+    assert_no_text "Release Bot"
+  end
+
+  test "only an administrator can reactivate a suspended bot after confirming" do
+    bot = users(:kevin).bots.create!(name: "Deploy Bot", bot_suspension_reason: "webhook_failures")
+    sign_in "kevin@37signals.com"
+    visit bots_path
+    within "li", text: "Deploy Bot" do
+      assert_text "Suspended"
+      assert_text "Too many consecutive webhook failures"
+      assert_no_button "Reactivate"
+    end
+
+    Capybara.reset_sessions!
+    sign_in "david@37signals.com"
+    visit bots_path
+    within "li", text: "Deploy Bot" do
+      dismiss_confirm do
+        click_on "Reactivate"
+      end
+      assert_text "Suspended"
+
+      accept_confirm do
+        click_on "Reactivate"
+      end
+    end
+
+    assert_current_path bots_path
+    assert_no_text "Suspended"
+    assert_no_button "Reactivate"
+    refute bot.reload.suspended?
+  end
+
+  test "an administrator sets the per-member bot limit" do
+    sign_in "david@37signals.com"
+    visit edit_account_path
+    assert_field "Bots per member", with: "5"
+    fill_in "Bots per member", with: "1"
+    click_on "Save changes"
+    assert_selector ".flash__inner"
+
+    Capybara.reset_sessions!
+    sign_in "kevin@37signals.com"
+    visit edit_account_path
+    assert_no_field "Bots per member"
+    click_on "Set up chat bots"
+    click_on "Add a chat bot"
+    fill_in "Name the bot", with: "Deploy Bot"
+    click_on "Save changes"
+
+    assert_current_path bots_path
+    assert_text "reached the limit"
+    assert_no_link "Add a chat bot"
+  end
+
+  test "a room administrator can give an opted-out bot access to one open room" do
+    bot = users(:david).bots.create!(name: "Deploy Bot")
+    room = rooms(:hq)
+    sign_in "david@37signals.com"
+    visit edit_rooms_open_path(room)
+
+    assert_unchecked_field "Give Deploy Bot access to this room"
+    check "Give Deploy Bot access to this room"
+    click_on "Save"
+
+    assert_current_path room_path(room)
+    assert_equal [ room.id ], bot.room_ids
+    visit edit_rooms_open_path(room)
+    assert_checked_field "Give Deploy Bot access to this room"
+  end
+end
