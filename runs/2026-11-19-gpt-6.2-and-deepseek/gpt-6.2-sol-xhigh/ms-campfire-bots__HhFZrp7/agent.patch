+class Room::DeliverBotJoinedJob < ApplicationJob
+  self.enqueue_after_transaction_commit = true
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(membership)
+    room, bot = membership.room, membership.user
+    return unless room && bot && !room.direct?
+
+    User::Bot::Webhook::Delivery.new(room, bot).deliver(event: "joined") do
+      BotRoomJoin.claim_delivery(room, bot)
+    end
+  end
+end
