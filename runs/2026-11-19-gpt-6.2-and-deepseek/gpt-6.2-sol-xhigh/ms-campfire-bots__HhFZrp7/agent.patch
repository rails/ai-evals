diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..cd5b9c2
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,72 @@
+module User::Bot
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bot_creator, class_name: "User", optional: true
+    has_many :bots, class_name: "User", foreign_key: :bot_creator_id, inverse_of: :bot_creator
+
+    scope :bots, -> { where.not(bot_creator_id: nil) }
+    scope :people, -> { where(bot_creator_id: nil) }
+    scope :with_bot_webhook, -> { bots.active.where(bot_suspension_reason: nil).where.not(webhook_url: nil) }
+
+    normalizes :webhook_url, with: ->(url) { url.strip.presence }
+
+    validates :name, presence: true, if: :bot?
+    validate :validate_bot_limit, on: :create, if: :bot?
+    validate :validate_webhook_url, if: -> { bot? && webhook_url.present? }
+    before_create :set_bot_password, if: :bot?
+    after_save :grant_membership_to_open_rooms, if: :should_add_bot_to_all_open_rooms?
+  end
+
+  class_methods do
+    def find_by_bot_code(code)
+      bots.active.find_signed(code, purpose: :bot)
+    end
+  end
+
+  def bot?
+    bot_creator_id.present?
+  end
+
+  def bot_code
+    signed_id(purpose: :bot) if bot? && !deactivated?
+  end
+
+  def suspended?
+    bot_suspension_reason.present?
+  end
+
+  def bot_moderation
+    User::Bot::Moderation.new(self)
+  end
+
+  def bot_limit_reached?
+    !administrator? && bots.not_deactivated.count >= Current.account.bots_per_member
+  end
+
+  private
+    def validate_bot_limit
+      if bot_creator&.bot_limit_reached?
+        errors.add :base, :bot_limit_reached, message: I18n.t("bots.limit_reached")
+      end
+    end
+
+    def should_add_bot_to_all_open_rooms?
+      bot? && active? && add_to_all_open_rooms? &&
+        (saved_change_to_add_to_all_open_rooms?(to: true) || saved_change_to_status?(to: "active"))
+    end
+
+    def validate_webhook_url
+      url = URI.parse(webhook_url)
+      unless url.is_a?(URI::HTTP) && url.hostname.present? && url.userinfo.nil? && url.fragment.nil?
+        errors.add :webhook_url, "must be an HTTP or HTTPS URL without credentials or a fragment"
+      end
+    rescue URI::InvalidURIError
+      errors.add :webhook_url, "is not a valid URL"
+    end
+
+    def set_bot_password
+      # Bots never sign in, but share the users table's non-null password digest.
+      self.password = SecureRandom.base58(32)
+    end
+end
diff --git a/app/models/user/bot/moderation.rb b/app/models/user/bot/moderation.rb
new file mode 100644
index 0000000..9e81609
--- /dev/null
+++ b/app/models/user/bot/moderation.rb
@@ -0,0 +1,83 @@
+class User::Bot::Moderation
+  POST_LIMIT = 10
+  POST_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  PostResult = Struct.new(:status, :message, :retry_after)
+
+  def initialize(bot)
+    @bot = bot
+  end
+
+  def post(room_id, body)
+    # Check the shared posting budget and create the message in the same transaction.
+    result = bot.with_lock do
+      if !bot.active?
+        PostResult.new(:unauthorized)
+      elsif bot.suspended? || (block_given? && !yield)
+        PostResult.new(:forbidden)
+      else
+        post_within_limit(room_id, body)
+      end
+    end
+    result.message&.broadcast_create
+    result
+  end
+
+  def record_webhook_delivery(success:, generation:)
+    bot.with_lock do
+      # A delivery that was in flight before reactivation must not affect the new streak.
+      next unless bot.active? && !bot.suspended? && bot.bot_moderation_generation == generation
+
+      if success
+        bot.update_columns(bot_webhook_failures: 0) unless bot.bot_webhook_failures.zero?
+      else
+        failures = bot.bot_webhook_failures + 1
+        bot.update_columns bot_webhook_failures: failures,
+          bot_suspension_reason: ("webhook_failures" if failures >= WEBHOOK_FAILURE_LIMIT)
+      end
+    end
+  end
+
+  def reactivate
+    bot.with_lock do
+      if bot.suspended? && !bot.deactivated?
+        bot.update_columns bot_suspension_reason: nil, bot_post_timestamps: [], bot_cooldown_until: nil,
+          bot_cooldown_attempts: 0, bot_webhook_failures: 0, bot_moderation_generation: bot.bot_moderation_generation + 1
+      end
+    end
+  end
+
+  private
+    attr_reader :bot
+
+    def post_within_limit(room_id, body)
+      now = Time.current
+      if bot.bot_cooldown_until && now < bot.bot_cooldown_until
+        return reject_during_cooldown(now)
+      end
+
+      room = bot.rooms.find_by(id: room_id)
+      return PostResult.new(:not_found) unless room
+      return PostResult.new(:unprocessable_content) unless body
+
+      cutoff = (now - POST_WINDOW).to_f
+      timestamps = bot.bot_post_timestamps.select { |timestamp| timestamp > cutoff }
+      if timestamps.size >= POST_LIMIT
+        bot.update_columns bot_cooldown_until: now + COOLDOWN, bot_cooldown_attempts: 0
+        PostResult.new(:too_many_requests, nil, COOLDOWN.to_i)
+      else
+        bot.update_columns bot_post_timestamps: timestamps << now.to_f, bot_cooldown_until: nil, bot_cooldown_attempts: 0
+        PostResult.new(:created, room.messages.create!(creator: bot, body: body))
+      end
+    end
+
+    def reject_during_cooldown(now)
+      attempts = bot.bot_cooldown_attempts + 1
+      bot.update_columns bot_cooldown_attempts: attempts,
+        bot_suspension_reason: ("flooding" if attempts >= COOLDOWN_ATTEMPT_LIMIT)
+      PostResult.new(:too_many_requests, nil, (bot.bot_cooldown_until - now).ceil)
+    end
+end
diff --git a/app/models/user/bot/webhook.rb b/app/models/user/bot/webhook.rb
new file mode 100644
index 0000000..a1f3ede
--- /dev/null
+++ b/app/models/user/bot/webhook.rb
@@ -0,0 +1,48 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class User::Bot::Webhook
+  MAX_REPLY_SIZE = 256.kilobytes
+  DELIVERY_TIMEOUT = 10.seconds
+  REPLY_TYPES = %w[ text/plain text/html ]
+
+  Result = Struct.new(:success, :reply)
+
+  def initialize(url)
+    @url = URI.parse(url)
+  end
+
+  def post(payload)
+    request = Net::HTTP::Post.new(@url, "Content-Type" => "application/json", "Accept-Encoding" => "identity")
+    request.body = payload.to_json
+
+    # Pin the public IP and bypass environment proxies so the destination isn't re-resolved.
+    # Don't follow redirects: the payload contains the bot's posting credential.
+    Timeout.timeout(DELIVERY_TIMEOUT) do
+      ip = RestrictedHTTP::PrivateNetworkGuard.resolve(@url.hostname)
+      Net::HTTP.start(@url.hostname, @url.port, nil, ipaddr: ip, use_ssl: @url.scheme == "https",
+          open_timeout: 3, read_timeout: 5, write_timeout: 5, max_retries: 0) do |http|
+        http.request(request) { |response| return Result.new(response.is_a?(Net::HTTPSuccess), read_reply(response)) }
+      end
+    end
+  rescue RestrictedHTTP::Violation, Surfguard::Unresolvable, Timeout::Error, SocketError, SystemCallError,
+      IOError, Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError, Net::ProtocolError, OpenSSL::SSL::SSLError => error
+    Rails.logger.warn "Bot webhook delivery failed (#{error.class})"
+    Result.new(false)
+  end
+
+  private
+    def read_reply(response)
+      content_type = response.content_type&.downcase
+      return unless response.is_a?(Net::HTTPOK) && REPLY_TYPES.include?(content_type)
+      return if response.content_length.to_i > MAX_REPLY_SIZE
+
+      body = "".b
+      response.read_body do |chunk|
+        return if body.bytesize + chunk.bytesize > MAX_REPLY_SIZE
+        body << chunk
+      end
+      body.force_encoding(Encoding::UTF_8)
+      [ content_type, body ] if body.valid_encoding? && body.present?
+    end
+end
diff --git a/app/models/user/bot/webhook/delivery.rb b/app/models/user/bot/webhook/delivery.rb
new file mode 100644
index 0000000..2162a2a
--- /dev/null
+++ b/app/models/user/bot/webhook/delivery.rb
@@ -0,0 +1,41 @@
+class User::Bot::Webhook::Delivery
+  def initialize(room, bot)
+    @room, @bot_id = room, bot.id
+  end
+
+  def deliver(event:, **details)
+    bot = room.users.with_bot_webhook.find_by(id: bot_id)
+    return unless bot
+    return if block_given? && !yield
+
+    webhook_url, generation = bot.webhook_url, bot.bot_moderation_generation
+    result = User::Bot::Webhook.new(webhook_url).post({ event: event, room: room_payload(bot), **details })
+    moderation = bot.bot_moderation
+    moderation.record_webhook_delivery(success: result.success, generation: generation)
+
+    if result.reply && (body = reply_body(*result.reply))
+      moderation.post(room.id, body) do
+        # The bot or room membership may have changed while the request was in flight.
+        bot.bot_moderation_generation == generation && bot.webhook_url == webhook_url && bot.rooms.exists?(room.id)
+      end
+    end
+  end
+
+  private
+    attr_reader :room, :bot_id
+
+    def room_payload(bot)
+      routes = Rails.application.routes.url_helpers
+      { id: room.id, name: room.name, reply_to: routes.room_bot_messages_path(room, bot.bot_code) }
+    end
+
+    def reply_body(content_type, body)
+      case content_type
+      when "text/plain"
+        ERB::Util.html_escape(body).gsub(/\r\n?|\n/, "<br>")
+      when "text/html"
+        ActionText::ContentHelper.sanitizer.class.new(prune: true).sanitize(body,
+          tags: ContentFilters::SanitizeTags::ALLOWED_TAGS - [ ActionText::Attachment.tag_name ]).presence
+      end
+    end
+end
