+  def plain_text_without_mention(user)
+    if content = body.body
+      fragment = content.fragment.replace(ActionText::Attachment.tag_name) do |node|
+        node unless ActionText::Attachable.from_node(node) == user
+      end
+      ActionText::Content.new(fragment, canonicalize: false).to_plain_text.gsub(/\A[[:space:]]+|[[:space:]]+\z/, "")
+    else
+      ""
+    end
+  end
+
   private
+    def deliver_bot_mentions_later
+      mentionees.with_bot_webhook.each do |bot|
+        Message::DeliverBotMentionJob.perform_later(self, bot)
+      end
+    end
+
     def mentioned_users
       if body.body
         body.body.attachables.grep(User).uniq
