+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,225 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = users(:kevin).bots.create!(name: "Deploy Bot")
+    @room = rooms(:hq)
+    @room.memberships.grant_to @bot
+  end
+
+  test "posts the raw body as the bot, broadcasts it, and queues push notifications" do
+    text = "_method=DELETE&result=Deploy of v1.2.3 finished ✅ (% completed)\n<done>"
+    assert_difference -> { @room.messages.count }, 1 do
+      assert_enqueued_jobs 1, only: Room::PushMessageJob do
+        post_message text, content_type: "application/x-www-form-urlencoded"
+      end
+    end
+
+    assert_response :created
+    message = @room.messages.order(:id).last
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal @bot, message.creator
+    assert_equal text, message.plain_text_body
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: :append, target: [ @room, :messages ] do
+      assert_select ".message__author", text: @bot.name
+    end
+
+    sign_in :kevin
+    get message_path(message)
+    assert_response :ok
+    assert_select ".message__author", text: @bot.name
+  end
+
+  test "does not parse the body even if the client declares JSON" do
+    post_message "not a JSON envelope", content_type: "application/json"
+
+    assert_response :created
+    assert_equal "not a JSON envelope", @room.messages.order(:id).last.plain_text_body
+  end
+
+  test "rejects empty and whitespace-only bodies" do
+    assert_no_difference -> { Message.count } do
+      post_message ""
+      assert_response :unprocessable_content
+      post_message "  \n"
+      assert_response :unprocessable_content
+    end
+  end
+
+  test "rejects invalid and non-bot credentials, even with a session cookie" do
+    sign_in :kevin
+
+    assert_no_difference -> { Message.count } do
+      post_message "Deploy", code: "not.a.bot.code"
+      assert_response :unauthorized
+      post_message "Deploy", code: @bot.avatar_token
+      assert_response :unauthorized
+      post_message "Deploy", code: users(:kevin).signed_id(purpose: :bot)
+      assert_response :unauthorized
+    end
+  end
+
+  test "requires a room that the bot belongs to" do
+    assert_no_difference -> { Message.count } do
+      post_message "Deploy", room_id: 0
+      assert_response :not_found
+      post_message "Deploy", room_id: "#{@room.id}bad"
+      assert_response :not_found
+      post_message "Deploy", room_id: rooms(:designers).id
+      assert_response :not_found
+    end
+  end
+
+  test "a bot can post to a closed room it is added to" do
+    sign_in :david
+    get edit_rooms_closed_url(rooms(:designers))
+    assert_select "label", text: "Give Deploy Bot access to this room" do
+      assert_select "input[type=checkbox][value='#{@bot.id}']"
+    end
+
+    patch rooms_closed_url(rooms(:designers)), params: {
+      room: { name: "Designers" }, user_ids: [ users(:david).id, @bot.id ]
+    }
+    assert_redirected_to room_url(rooms(:designers))
+
+    post_message "Deploy", room_id: rooms(:designers).id
+    assert_response :created
+  end
+
+  test "deleting messages does not replenish the posting budget" do
+    freeze_time do
+      10.times { post_message "Deploy" }
+      assert_response :created
+      @bot.messages.last.destroy!
+
+      post_message "Too fast"
+      assert_response :too_many_requests
+      assert_equal 9, @bot.messages.count
+    end
+  end
+
+  test "the message location does not let nonmembers read it" do
+    room = rooms(:designers)
+    room.memberships.grant_to @bot
+    post_message "Private deploy", room_id: room.id
+    location = response.headers.fetch("Location")
+
+    sign_in :bender
+    assert_raises ActiveRecord::RecordNotFound do
+      get location
+    end
+  end
+
+  test "filters codes from the logged path and parameters" do
+    post_message "Deploy"
+
+    assert_equal "/rooms/#{@room.id}/[FILTERED]/messages", request.filtered_path
+    assert_equal "[FILTERED]", request.filtered_parameters["bot_code"]
+  end
+
+  test "enforces a rolling window across rooms, independently for each bot" do
+    room = rooms(:designers)
+    room.memberships.grant_to @bot
+    other_bot = users(:kevin).bots.create!(name: "Other Bot")
+    room.memberships.grant_to other_bot
+
+    travel_to Time.zone.local(2026, 1, 1, 0, 0, 9) do
+      9.times do
+        post_message "Deploy"
+        assert_response :created
+      end
+      travel 9.seconds
+      post_message "Build", room_id: room.id
+      assert_response :created
+
+      assert_no_difference -> { @bot.messages.count } do
+        post_message "Too fast", room_id: room.id
+        assert_response :too_many_requests
+        assert_equal "30", response.headers["Retry-After"]
+      end
+
+      post_message "Independent", room_id: room.id, code: other_bot.bot_code
+      assert_response :created
+    end
+  end
+
+  test "messages exactly ten seconds old no longer count toward the limit" do
+    freeze_time do
+      10.times { post_message "Deploy" }
+      travel 10.seconds
+
+      post_message "Another deploy"
+      assert_response :created
+    end
+  end
+
+  test "a cooldown expires without being extended by blocked posts" do
+    freeze_time do
+      11.times { post_message "Deploy" }
+      assert_response :too_many_requests
+
+      travel 29.5.seconds, with_usec: true
+      4.times do
+        post_message "Still cooling down"
+        assert_response :too_many_requests
+        assert_equal "1", response.headers["Retry-After"]
+      end
+
+      travel 0.5.seconds, with_usec: true
+      10.times do
+        post_message "Cooldown ended"
+        assert_response :created
+      end
+
+      2.times do
+        post_message "Next burst"
+        assert_response :too_many_requests
+        assert_equal "30", response.headers["Retry-After"]
+      end
+      refute @bot.reload.suspended?
+    end
+  end
+
+  test "five more cooldown attempts suspend the bot until an administrator reactivates it" do
+    code = @bot.bot_code
+    accounts(:signal).update!(bots_per_member: 1)
+
+    freeze_time do
+      10.times { post_message "Deploy", code: code }
+      assert_no_difference -> { @bot.messages.count } do
+        6.times do
+          post_message "Too fast", code: code
+          assert_response :too_many_requests
+          assert_equal "30", response.headers["Retry-After"]
+        end
+
+        post_message "Suspended", code: code
+        assert_response :forbidden
+        assert_nil response.headers["Retry-After"]
+      end
+
+      sign_in :kevin
+      get bots_url
+      assert_select "li", text: /Deploy Bot.*Suspended.*too many messages/im
+      assert_select "button", text: "Reactivate", count: 0
+      assert_select "a", text: "Add a chat bot", count: 0
+      post bot_reactivation_url(@bot)
+      assert_response :forbidden
+      post_message "Still suspended", code: code
+      assert_response :forbidden
+
+      sign_in :david
+      post bot_reactivation_url(@bot)
+      assert_redirected_to bots_url
+      assert_equal [ @room ], @bot.rooms.reload.to_a
+      assert_equal 10, @bot.messages.count
+      post_message "Reactivated", code: code
+      assert_response :created
+    end
+  end
+
+  private
+    def post_message(text, room_id: @room.id, code: @bot.bot_code, content_type: "text/plain")
+      post "/rooms/#{room_id}/#{code}/messages", params: text.dup, headers: { "Content-Type" => content_type }
+    end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..0f63fca
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,226 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "a member can find bot settings and create a bot with an avatar" do
+    get edit_account_url
+    assert_select "a[href='/bots']", text: "Set up chat bots"
+
+    get "/bots/new"
+    assert_select "label", text: "Name the bot"
+    assert_select "label[for='bot_add_to_all_open_rooms']", text: "Add to all open rooms"
+    assert_select "input#bot_add_to_all_open_rooms[type='checkbox']:not([checked])"
+
+    post "/bots", params: { bot: { name: "Deploy Bot", avatar: file_fixture_upload("moon.jpg", "image/jpeg") } }
+    assert_redirected_to "/bots"
+
+    bot = User.find_by!(name: "Deploy Bot")
+    assert_equal users(:kevin), bot.bot_creator
+    assert bot.avatar.attached?
+    assert_empty bot.rooms
+
+    follow_redirect!
+    assert_select "li" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "input[aria-label='Bot code'][readonly]" do |fields|
+        assert_equal bot.bot_code, fields.first["value"]
+      end
+      assert_select "a[href='/bots/#{bot.id}/edit']", text: "Edit Deploy Bot"
+    end
+    assert_includes response.headers["Cache-Control"], "no-store"
+  end
+
+  test "a member can create five bots by default but cannot exceed the limit" do
+    4.times { |i| users(:kevin).bots.create!(name: "Bot #{i}") }
+    users(:jz).bots.create!(name: "Another member's bot")
+
+    get bots_url
+    assert_select "a[href='/bots/new']", text: "Add a chat bot"
+    post bots_url, params: { bot: { name: "Fifth bot" } }
+    assert_redirected_to bots_url
+
+    follow_redirect!
+    assert_select "a[href='/bots/new']", count: 0
+    assert_select "p", text: /reached the limit/
+
+    get new_bot_url
+    assert_redirected_to bots_url
+
+    assert_no_difference -> { users(:kevin).bots.count } do
+      post bots_url, params: { bot: { name: "Sixth bot" } }
+      assert_response :unprocessable_content
+      assert_select "[role='alert']", text: /reached the limit/
+      assert_select "a[href='/bots/new']", count: 0
+    end
+  end
+
+  test "a banned bot counts toward the limit until deleted" do
+    accounts(:signal).update!(bots_per_member: 1)
+    bot = users(:kevin).bots.create!(name: "Bot", status: :banned)
+
+    get bots_url
+    assert_select "a[href='/bots/new']", count: 0
+    assert_select "p", text: /reached the limit/
+
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    follow_redirect!
+    assert_select "a[href='/bots/new']", text: "Add a chat bot"
+
+    post bots_url, params: { bot: { name: "Replacement bot" } }
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+  end
+
+  test "lowering the limit keeps existing bots and allows editing them" do
+    bot = users(:kevin).bots.create!(name: "Bot")
+    other_bot = users(:kevin).bots.create!(name: "Another bot")
+
+    sign_in :david
+    patch account_url, params: { account: { bots_per_member: "1" } }
+    assert_redirected_to edit_account_url
+
+    sign_in :kevin
+    get bots_url
+    assert_select "strong", text: "Bot"
+    assert_select "strong", text: "Another bot"
+    assert_select "a[href='/bots/new']", count: 0
+    assert_select "p", text: /reached the limit/
+
+    patch bot_url(bot), params: { bot: { name: "Renamed bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Renamed bot", bot.reload.name
+    assert bot.active?
+    assert other_bot.reload.active?
+  end
+
+  test "a zero limit blocks members but not administrators" do
+    accounts(:signal).update!(bots_per_member: 0)
+
+    get bots_url
+    assert_select "a[href='/bots/new']", count: 0
+    assert_select "p", text: /reached the limit/
+    post bots_url, params: { bot: { name: "Member bot" } }
+    assert_response :unprocessable_content
+
+    sign_in :david
+    get bots_url
+    assert_select "a[href='/bots/new']", text: "Add a chat bot"
+    get new_bot_url
+    assert_response :ok
+    post bots_url, params: { bot: { name: "Admin bot" } }
+    assert_redirected_to bots_url
+  end
+
+  test "a bot author can opt into all open rooms and opt out without losing membership" do
+    post bots_url, params: { bot: { name: "Deploy Bot", add_to_all_open_rooms: "1" } }
+    assert_redirected_to bots_url
+    bot = users(:kevin).bots.find_by!(name: "Deploy Bot")
+    assert_equal Rooms::Open.ids.sort, bot.room_ids.sort
+
+    get edit_bot_url(bot)
+    assert_select "label[for='bot_add_to_all_open_rooms']", text: "Add to all open rooms"
+    assert_select "input#bot_add_to_all_open_rooms[type='checkbox'][checked]"
+
+    future_room = Rooms::Open.create!(name: "Ops", creator: users(:kevin))
+    assert_includes bot.rooms, future_room
+
+    patch bot_url(bot), params: { bot: { add_to_all_open_rooms: "0" } }
+    assert_redirected_to bots_url
+    assert_equal Rooms::Open.ids.sort, bot.reload.room_ids.sort
+
+    another_room = Rooms::Open.create!(name: "Builds", creator: users(:kevin))
+    assert_not_includes bot.rooms.reload, another_room
+  end
+
+  test "a bot author can set, change, and remove a webhook URL" do
+    get new_bot_url
+    assert_select "label[for='bot_webhook_url']", text: "Webhook URL"
+    assert_select "input#bot_webhook_url[type='url']:not([required])"
+
+    url = "https://bot.example.com/mentions?token=secret"
+    post bots_url, params: { bot: { name: "Deploy Bot", webhook_url: url } }
+    assert_redirected_to bots_url
+
+    bot = users(:kevin).bots.find_by!(name: "Deploy Bot")
+    assert_equal url, bot.webhook_url
+    assert_equal "[FILTERED]", request.filtered_parameters.dig("bot", "webhook_url")
+
+    get edit_bot_url(bot)
+    assert_select "label[for='bot_webhook_url']", text: "Webhook URL"
+    assert_select "input#bot_webhook_url" do |fields|
+      assert_equal url, fields.first["value"]
+    end
+
+    new_url = "https://bot.example.com/new"
+    patch bot_url(bot), params: { bot: { webhook_url: new_url } }
+    assert_redirected_to bots_url
+    assert_equal new_url, bot.reload.webhook_url
+
+    patch bot_url(bot), params: { bot: { webhook_url: "" } }
+    assert_redirected_to bots_url
+    assert_nil bot.reload.webhook_url
+  end
+
+  test "the webhook URL must be an HTTP or HTTPS URL" do
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: "Deploy Bot", webhook_url: "file:///tmp/bot" } }
+      assert_response :unprocessable_content
+      assert_select "[role='alert']", text: /Webhook URL/
+    end
+  end
+
+  test "members only see and manage their own bots, while admins can manage all" do
+    own_bot = users(:kevin).bots.create!(name: "Deploy Bot")
+    other_bot = users(:jz).bots.create!(name: "Build Bot")
+
+    get "/bots"
+    assert_includes response.body, own_bot.bot_code
+    refute_includes response.body, other_bot.bot_code
+
+    get "/bots/#{other_bot.id}/edit"
+    assert_response :not_found
+    patch "/bots/#{other_bot.id}", params: { bot: { name: "Wrong owner" } }
+    assert_response :not_found
+    delete "/bots/#{other_bot.id}"
+    assert_response :not_found
+
+    sign_in :david
+    get "/bots"
+    assert_includes response.body, own_bot.bot_code
+    assert_includes response.body, other_bot.bot_code
+
+    patch "/bots/#{other_bot.id}", params: { bot: { name: "Build Monitor" } }
+    assert_redirected_to "/bots"
+    assert_equal "Build Monitor", other_bot.reload.name
+  end
+
+  test "a bot needs a name" do
+    assert_no_difference -> { User.count } do
+      post "/bots", params: { bot: { name: " " } }
+    end
+    assert_response :unprocessable_content
+  end
+
+  test "deletion revokes the code without removing already posted messages" do
+    bot = users(:kevin).bots.create!(name: "Deploy Bot")
+    message = rooms(:hq).messages.create!(creator: bot, body: "Previous deploy")
+    code = bot.bot_code
+
+    delete "/bots/#{bot.id}"
+    assert_redirected_to "/bots"
+    assert_equal bot, message.reload.creator
+    follow_redirect!
+    refute_includes response.body, code
+
+    sign_in :david
+    delete user_ban_url(bot)
+    assert_response :not_found
+
+    post "/rooms/#{rooms(:hq).id}/#{code}/messages", params: +"Another deploy"
+    assert_response :unauthorized
+  end
+end
