diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..3e54388
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,62 @@
+class BotsController < ApplicationController
+  before_action :no_store
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = manageable_bots.ordered
+    @bot_limit_reached = Current.user.bot_limit_reached?
+  end
+
+  def new
+    if Current.user.bot_limit_reached?
+      redirect_to bots_url
+    else
+      @bot = Current.user.bots.build
+    end
+  end
+
+  def create
+    @bot = Current.user.bots.build(bot_params)
+
+    if @bot.save
+      redirect_to bots_url, status: :see_other
+    elsif @bot.errors.of_kind?(:base, :bot_limit_reached)
+      @bots = manageable_bots.ordered
+      @bot_limit_reached = true
+      render :index, status: :unprocessable_content
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url, status: :see_other
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url, status: :see_other
+  end
+
+  private
+    def set_bot
+      @bot = manageable_bots.find_by(id: params[:id])
+      head :not_found unless @bot
+    end
+
+    def manageable_bots
+      bots = Current.user.administrator? ? User.bots : Current.user.bots
+      bots.not_deactivated
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar, :webhook_url, :add_to_all_open_rooms)
+    end
+end
