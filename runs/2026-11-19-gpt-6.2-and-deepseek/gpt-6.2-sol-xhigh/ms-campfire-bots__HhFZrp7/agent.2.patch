+require "test_helper"
+
+class Message::BotMentionTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:hq)
+    @bot = users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://deploy.example.com/")
+  end
+
+  test "queues a delivery for each configured bot in the room, only once per bot" do
+    other_bot = users(:david).bots.create!(name: "Build Bot", webhook_url: "https://build.example.com/")
+
+    assert_enqueued_jobs 2, only: Message::DeliverBotMentionJob do
+      message = post_message "#{mention(@bot)} #{mention(other_bot)} tell #{mention_attachment_for(:david)} to write @Deploy Bot #{mention(@bot)}"
+
+      assert_enqueued_with job: Message::DeliverBotMentionJob, args: [ message, @bot ]
+      assert_enqueued_with job: Message::DeliverBotMentionJob, args: [ message, other_bot ]
+      assert_equal "@Build Bot tell @David to write @Deploy Bot", message.plain_text_without_mention(@bot)
+    end
+  end
+
+  test "does not deliver plain text, mentions from bots, or mentions of bots without a webhook or room access" do
+    unconfigured_bot = users(:david).bots.create!(name: "Other Bot")
+    inaccessible_bot = users(:david).bots.create!(name: "Private Bot", webhook_url: "https://private.example.com/")
+    @room.memberships.revoke_from inaccessible_bot
+
+    assert_no_enqueued_jobs only: Message::DeliverBotMentionJob do
+      post_message "@Deploy Bot #{mention(unconfigured_bot)} #{mention(inaccessible_bot)}"
+      post_message mention(@bot), creator: unconfigured_bot
+    end
+  end
+
+  test "does not deliver a queued mention after the bot loses access to the room" do
+    webhook = stub_request(:post, @bot.webhook_url)
+
+    post_message mention(@bot)
+    @room.memberships.revoke_from @bot
+
+    perform_enqueued_jobs only: Message::DeliverBotMentionJob
+    assert_not_requested webhook
+  end
+
+  test "does not deliver a queued mention after the webhook is removed" do
+    webhook = stub_request(:post, @bot.webhook_url)
+
+    post_message mention(@bot)
+    @bot.update!(webhook_url: "")
+
+    perform_enqueued_jobs only: Message::DeliverBotMentionJob
+    assert_not_requested webhook
+  end
+
+  private
+    def post_message(body, creator: users(:david))
+      @room.messages.create!(creator: creator, body: "<div>#{body}</div>")
+    end
+
+    def mention(user)
+      %(<action-text-attachment sgid="#{user.attachable_sgid}" content-type="application/vnd.campfire.mention"></action-text-attachment>)
+    end
+end
diff --git a/test/models/user/bot/webhook_test.rb b/test/models/user/bot/webhook_test.rb
new file mode 100644
index 0000000..4cf1d55
--- /dev/null
+++ b/test/models/user/bot/webhook_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class User::Bot::WebhookTest < ActiveSupport::TestCase
+  setup do
+    @url = "https://bot.example.com/mentions"
+    @webhook = User::Bot::Webhook.new(@url)
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "does not send the payload to private addresses" do
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "127.0.0.1" ])
+    request = stub_request(:post, @url)
+
+    assert_nil @webhook.post(event: "mention")
+    assert_not_requested request
+  end
+
+  test "does not forward the payload through a redirect" do
+    stub_request(:post, @url).to_return(status: 302, headers: { "Location" => "https://other.example.com/" })
+    redirected_request = stub_request(:any, "https://other.example.com/")
+
+    assert_nil @webhook.post(event: "mention")
+    assert_not_requested redirected_request
+  end
+
+  test "handles timeouts without retrying delivery" do
+    request = stub_request(:post, @url).to_timeout
+
+    assert_nil @webhook.post(event: "mention")
+    assert_requested request, times: 1
+  end
+
+  test "ignores unsupported media types, failure statuses and blank bodies" do
+    stub_request(:post, @url).to_return(
+      { status: 200, body: "{}", headers: { "Content-Type" => "application/json" } },
+      { status: 500, body: "Error", headers: { "Content-Type" => "text/plain" } },
+      { status: 200, body: " \n", headers: { "Content-Type" => "text/plain" } })
+
+    3.times { assert_nil @webhook.post(event: "mention") }
+  end
+
+  test "ignores replies over the size limit even without a content length" do
+    stub_request(:post, @url).to_return(status: 200, headers: { "Content-Type" => "text/plain" },
+      body: "a" * (User::Bot::Webhook::MAX_REPLY_SIZE + 1))
+
+    assert_nil @webhook.post(event: "mention")
+  end
+end
