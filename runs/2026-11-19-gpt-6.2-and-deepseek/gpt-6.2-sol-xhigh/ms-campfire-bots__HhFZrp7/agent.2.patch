diff --git a/app/models/message/bot_mention.rb b/app/models/message/bot_mention.rb
new file mode 100644
index 0000000..b283368
--- /dev/null
+++ b/app/models/message/bot_mention.rb
@@ -0,0 +1,48 @@
+class Message::BotMention
+  def initialize(message, bot)
+    @message, @bot = message, bot
+  end
+
+  def deliver
+    webhook_url = bot.webhook_url
+    return unless webhook_url.present? && bot.bot? && bot.active? && message.mentionees.exists?(bot.id)
+
+    content_type, body = User::Bot::Webhook.new(webhook_url).post(payload)
+    if (reply = reply_body(content_type, body)) && can_reply?(webhook_url)
+      room.messages.create!(creator: bot, body: reply).broadcast_create
+    end
+  end
+
+  private
+    attr_reader :message, :bot
+    delegate :room, to: :message
+
+    def payload
+      routes = Rails.application.routes.url_helpers
+      {
+        event: "mention",
+        author: { id: message.creator_id, name: message.creator.name },
+        room: { id: room.id, name: room.name, reply_to: routes.room_bot_messages_path(room, bot.bot_code) },
+        message: {
+          id: message.id,
+          body: { text: message.plain_text_without_mention(bot), html: message.body.to_s },
+          link: routes.room_at_message_path(room, message)
+        }
+      }
+    end
+
+    def reply_body(content_type, body)
+      case content_type
+      when "text/plain"
+        ERB::Util.html_escape(body).gsub(/\r\n?|\n/, "<br>")
+      when "text/html"
+        ActionText::ContentHelper.sanitizer.class.new(prune: true).sanitize(body,
+          tags: ContentFilters::SanitizeTags::ALLOWED_TAGS - [ ActionText::Attachment.tag_name ]).presence
+      end
+    end
+
+    def can_reply?(webhook_url)
+      # The room membership or webhook may have changed while the request was in flight.
+      room.users.bots.active.exists?(id: bot.id, webhook_url: webhook_url)
+    end
+end
