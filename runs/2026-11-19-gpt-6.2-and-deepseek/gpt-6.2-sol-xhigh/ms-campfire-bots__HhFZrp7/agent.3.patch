@@ -0,0 +1,9 @@
+class BotRoomJoin < ApplicationRecord
+  belongs_to :room
+  belongs_to :bot, class_name: "User"
+
+  def self.claim_delivery(room, bot)
+    # Memberships can be removed, but a bot should only be notified once per room.
+    insert({ room_id: room.id, bot_id: bot.id }, unique_by: %i[ room_id bot_id ], returning: %w[ id ]).any?
+  end
+end
