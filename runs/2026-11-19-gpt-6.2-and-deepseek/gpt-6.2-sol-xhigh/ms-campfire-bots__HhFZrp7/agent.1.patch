diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..6995d37
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,34 @@
+module User::Bot
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bot_creator, class_name: "User", optional: true
+    has_many :bots, class_name: "User", foreign_key: :bot_creator_id, inverse_of: :bot_creator
+
+    scope :bots, -> { where.not(bot_creator_id: nil) }
+    scope :people, -> { where(bot_creator_id: nil) }
+
+    validates :name, presence: true, if: :bot?
+    before_create :set_bot_password, if: :bot?
+  end
+
+  class_methods do
+    def find_by_bot_code(code)
+      bots.active.find_signed(code, purpose: :bot)
+    end
+  end
+
+  def bot?
+    bot_creator_id.present?
+  end
+
+  def bot_code
+    signed_id(purpose: :bot) if bot? && !deactivated?
+  end
+
+  private
+    def set_bot_password
+      # Bots never sign in, but share the users table's non-null password digest.
+      self.password = SecureRandom.base58(32)
+    end
+end
