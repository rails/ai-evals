new file mode 100644
index 0000000..b57ad97
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,28 @@
+class Bots::MessagesController < ActionController::API
+  include BlockBannedRequests, SetCurrentRequest, VersionHeaders
+
+  before_action :no_store, :set_bot, :set_room
+
+  def create
+    text = request.raw_post.to_s.dup.force_encoding(Encoding::UTF_8)
+    return head :unprocessable_content unless text.valid_encoding? && text.present?
+
+    body = ERB::Util.html_escape(text).gsub(/\r\n?|\n/, "<br>")
+    message = @room.messages.create!(creator: @bot, body: body)
+    message.broadcast_create
+
+    head :created, location: message_path(message)
+  end
+
+  private
+    def set_bot
+      @bot = User.find_by_bot_code(request.path_parameters[:bot_code])
+      head :unauthorized unless @bot
+    end
+
+    def set_room
+      room_id = request.path_parameters[:room_id]
+      @room = @bot.rooms.find_by(id: room_id) if room_id.match?(/\A\d+\z/)
+      head :not_found unless @room
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
