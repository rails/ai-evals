+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,12 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "bots created outside the controller still respect the owner's limit" do
+    accounts(:signal).update!(bots_per_member: 1)
+    users(:kevin).bots.create!(name: "Bot")
+
+    bot = User.new(name: "Extra bot", bot_creator: users(:kevin))
+    assert_not bot.save
+    assert_match /reached the limit/, bot.errors[:base].to_sentence
+  end
+end
