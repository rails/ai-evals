diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
index ca5bac0..0f63fca 100644
--- a/test/controllers/bots_controller_test.rb
+++ b/test/controllers/bots_controller_test.rb
@@ -33,6 +33,88 @@ class BotsControllerTest < ActionDispatch::IntegrationTest
     assert_includes response.headers["Cache-Control"], "no-store"
   end
 
+  test "a member can create five bots by default but cannot exceed the limit" do
+    4.times { |i| users(:kevin).bots.create!(name: "Bot #{i}") }
+    users(:jz).bots.create!(name: "Another member's bot")
+
+    get bots_url
+    assert_select "a[href='/bots/new']", text: "Add a chat bot"
+    post bots_url, params: { bot: { name: "Fifth bot" } }
+    assert_redirected_to bots_url
+
+    follow_redirect!
+    assert_select "a[href='/bots/new']", count: 0
+    assert_select "p", text: /reached the limit/
+
+    get new_bot_url
+    assert_redirected_to bots_url
+
+    assert_no_difference -> { users(:kevin).bots.count } do
+      post bots_url, params: { bot: { name: "Sixth bot" } }
+      assert_response :unprocessable_content
+      assert_select "[role='alert']", text: /reached the limit/
+      assert_select "a[href='/bots/new']", count: 0
+    end
+  end
+
+  test "a banned bot counts toward the limit until deleted" do
+    accounts(:signal).update!(bots_per_member: 1)
+    bot = users(:kevin).bots.create!(name: "Bot", status: :banned)
+
+    get bots_url
+    assert_select "a[href='/bots/new']", count: 0
+    assert_select "p", text: /reached the limit/
+
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    follow_redirect!
+    assert_select "a[href='/bots/new']", text: "Add a chat bot"
+
+    post bots_url, params: { bot: { name: "Replacement bot" } }
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+  end
+
+  test "lowering the limit keeps existing bots and allows editing them" do
+    bot = users(:kevin).bots.create!(name: "Bot")
+    other_bot = users(:kevin).bots.create!(name: "Another bot")
+
+    sign_in :david
+    patch account_url, params: { account: { bots_per_member: "1" } }
+    assert_redirected_to edit_account_url
+
+    sign_in :kevin
+    get bots_url
+    assert_select "strong", text: "Bot"
+    assert_select "strong", text: "Another bot"
+    assert_select "a[href='/bots/new']", count: 0
+    assert_select "p", text: /reached the limit/
+
+    patch bot_url(bot), params: { bot: { name: "Renamed bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Renamed bot", bot.reload.name
+    assert bot.active?
+    assert other_bot.reload.active?
+  end
+
+  test "a zero limit blocks members but not administrators" do
+    accounts(:signal).update!(bots_per_member: 0)
+
+    get bots_url
+    assert_select "a[href='/bots/new']", count: 0
+    assert_select "p", text: /reached the limit/
+    post bots_url, params: { bot: { name: "Member bot" } }
+    assert_response :unprocessable_content
+
+    sign_in :david
+    get bots_url
+    assert_select "a[href='/bots/new']", text: "Add a chat bot"
+    get new_bot_url
+    assert_response :ok
+    post bots_url, params: { bot: { name: "Admin bot" } }
+    assert_redirected_to bots_url
+  end
+
   test "a bot author can opt into all open rooms and opt out without losing membership" do
     post bots_url, params: { bot: { name: "Deploy Bot", add_to_all_open_rooms: "1" } }
     assert_redirected_to bots_url
