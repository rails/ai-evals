+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,11 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "the weekly digest shows the short date for a published book" do
+    books(:handbook).update!(published: true, updated_at: Time.utc(2024, 3, 7, 14, 15, 16))
+
+    email = ReportDigestMailer.weekly(users(:david))
+
+    assert_includes email.body.decoded, "* Handbook, last edited 07 Mar\n"
+  end
+end
