diff --git a/test/models/account/storage_usage_test.rb b/test/models/account/storage_usage_test.rb
new file mode 100644
index 0000000..bb8b0cc
--- /dev/null
+++ b/test/models/account/storage_usage_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class Account::StorageUsageTest < ActiveSupport::TestCase
+  test "board and account totals include only card images and the three kinds of embeds" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+    comment = comments(:logo_1)
+    other_board = boards(:private)
+
+    card.image.attach upload(10)
+    embed board, :public_description, upload(20)
+    embed card, :description, upload(30)
+    embed comment, :body, upload(40)
+    embed other_board, :public_description, upload(50)
+    exports(:pending_account_export).file.attach upload(60)
+    upload(70) # Not attached to anything
+    users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg")
+    variant = ActiveStorage::VariantRecord.create!(blob: card.image.blob, variation_digest: "test-variant")
+    variant.image.attach upload(100)
+
+    Current.with_account(accounts(:initech)) do
+      cards(:radio).image.attach upload(80)
+    end
+
+    assert_equal 0, account.bytes_used
+    assert_equal 0, board.bytes_used
+
+    perform_enqueued_jobs(only: Account::RefreshStorageUsageJob) do
+      Account::StorageUsage.refresh_all_later
+    end
+
+    assert_equal 100, board.reload.bytes_used
+    assert_equal 50, other_board.reload.bytes_used
+    assert_equal 150, account.reload.bytes_used
+    assert_equal 80, accounts(:initech).reload.bytes_used
+    assert_equal 0, accounts(:acme).reload.bytes_used
+  end
+
+  test "clearing a description removes its usage" do
+    board = boards(:writebook)
+    embed board, :public_description, upload(25)
+    refresh
+    assert_equal 25, board.reload.bytes_used
+
+    assert_difference -> { ActiveStorage::Attachment.where(record: board.public_description).count }, -1 do
+      board.update!(public_description: "")
+    end
+    refresh
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, board.account.reload.bytes_used
+  end
+
+  test "refresh ignores legacy embed references left behind when a body was cleared" do
+    board = boards(:writebook)
+    embed board, :public_description, upload(25)
+    board.public_description.update_column(:body, "")
+    assert board.public_description.embeds.attached?
+
+    refresh
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, board.account.reload.bytes_used
+  end
+
+  test "refresh picks up card moves, attachment replacement, detach and deletion" do
+    board = boards(:writebook)
+    destination = boards(:private)
+    card = cards(:logo)
+    comment = comments(:logo_1)
+    Current.session = sessions(:david)
+
+    card.image.attach upload(20)
+    embed card, :description, upload(30)
+    embed comment, :body, upload(40)
+    refresh
+    assert_equal 90, board.reload.bytes_used
+
+    card.move_to(destination)
+    card.image.attach upload(5)
+    refresh
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 75, destination.reload.bytes_used
+    assert_equal 75, board.account.reload.bytes_used
+
+    card.reload.image.detach
+    comment.destroy!
+    refresh
+    assert_equal 30, destination.reload.bytes_used
+    assert_equal 30, board.account.reload.bytes_used
+
+    destination.destroy!
+    perform_enqueued_jobs(only: Account::RefreshStorageUsageJob) { Account::StorageUsage.refresh_all_later }
+    assert_equal 0, board.account.reload.bytes_used
+  end
+
+  test "the scheduler revisits a board with stale usage even if its account has no attachments" do
+    board = boards(:writebook)
+    board.update_column(:bytes_used, 100)
+
+    perform_enqueued_jobs(only: Account::RefreshStorageUsageJob) do
+      Account::StorageUsage.refresh_all_later
+    end
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, board.account.reload.bytes_used
+  end
+
+  test "refresh adds up attachment batches and does not touch the account or board" do
+    board = boards(:writebook)
+    account = board.account
+    card = cards(:logo)
+    blob = upload(1)
+    blob.update_column :byte_size, 3.gigabytes
+
+    card.image.attach blob
+    cards(:layout).image.attach upload(15)
+    embed board, :public_description, blob
+    before = [ account.reload.updated_at, board.reload.updated_at ]
+
+    stub_const(Account::StorageUsage, :ATTACHMENT_BATCH_SIZE, 1) do
+      2.times { refresh }
+    end
+
+    assert_equal 6.gigabytes + 15, board.reload.bytes_used
+    assert_equal 6.gigabytes + 15, account.reload.bytes_used
+    assert_equal before, [ account.updated_at, board.updated_at ]
+  end
+
+  private
+    def refresh
+      Account::RefreshStorageUsageJob.perform_now(Current.account.id)
+    end
+
+    def upload(bytes)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * bytes), filename: "file.txt")
+    end
+
+    def embed(record, field, blob)
+      record.update!(field => ActionText::Content.new.append_attachables(blob))
+    end
+end
