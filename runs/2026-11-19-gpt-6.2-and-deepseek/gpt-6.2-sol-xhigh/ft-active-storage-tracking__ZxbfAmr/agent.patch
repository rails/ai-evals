--- /dev/null
+++ b/app/jobs/account/refresh_storage_usage_job.rb
@@ -0,0 +1,12 @@
+class Account::RefreshStorageUsageJob < ApplicationJob
+  queue_as :backend
+
+  # If an account is still being refreshed, skip this round rather than growing a backlog.
+  limits_concurrency to: 1, key: ->(account_id) { account_id }, duration: 30.minutes, on_conflict: :discard
+
+  def perform(account_id)
+    if account = Account.find_by(id: account_id)
+      Account::StorageUsage.new(account).refresh
+    end
+  end
+end
