diff --git a/app/models/account/storage_usage.rb b/app/models/account/storage_usage.rb
new file mode 100644
index 0000000..04dfe46
--- /dev/null
+++ b/app/models/account/storage_usage.rb
@@ -0,0 +1,94 @@
+class Account::StorageUsage
+  ATTACHMENT_BATCH_SIZE = 1000
+
+  # Count each original attachment, not generated variants or unattached uploads.
+  # Resolve it to the current board, so card moves also move description and comment usage.
+  BOARD_ID = <<~SQL.squish
+    COALESCE(cards.board_id, CASE WHEN rich_text.record_type = 'Board'
+      AND rich_text.name = 'public_description' THEN rich_text.record_id END)
+  SQL
+
+  def self.refresh_all_later
+    # Revisit nonzero totals even if the attachments are gone. A previous refresh
+    # might have been interrupted after updating boards but before updating the account.
+    accounts = Account.where("bytes_used > 0 OR EXISTS (?) OR EXISTS (?)",
+      ActiveStorage::Attachment.where("active_storage_attachments.account_id = accounts.id").select(1),
+      Board.where("boards.account_id = accounts.id AND boards.bytes_used > 0").select(1))
+
+    Current.without_account do
+      accounts.in_batches(of: 100, use_ranges: true) do |batch|
+        ActiveJob.perform_all_later batch.skip_query_cache!.ids.map { |id| Account::RefreshStorageUsageJob.new(id) }
+      end
+    end
+  end
+
+  def initialize(account)
+    @account = account
+  end
+
+  def refresh
+    totals = bytes_by_board
+
+    # Don't touch boards or accounts: these are derived values, not user activity.
+    @account.boards.in_batches do |batch|
+      batch.skip_query_cache!.pluck(:id, :bytes_used).each do |id, previous_bytes|
+        bytes = totals[id]
+        @account.boards.where(id: id).update_all(bytes_used: bytes) if bytes != previous_bytes
+      end
+    end
+
+    bytes = @account.boards.sum(:bytes_used)
+    @account.update_column(:bytes_used, bytes) if bytes != @account.bytes_used
+  end
+
+  private
+    def bytes_by_board
+      totals = Hash.new(0)
+      attachments = counted_attachments
+      # Stop at the current last attachment even if uploads continue during the scan.
+      last_id = attachments.reorder(id: :desc).pick(:id)
+
+      if last_id
+        attachments.in_batches(of: ATTACHMENT_BATCH_SIZE, finish: last_id, use_ranges: true) do |batch|
+          batch_totals = batch.skip_query_cache!.joins(:blob).joins(board_joins)
+            .group(Arel.sql(BOARD_ID)).sum("active_storage_blobs.byte_size")
+
+          batch_totals.each do |key, bytes|
+            if key
+              board_id = Board.type_for_attribute("id").deserialize(key)
+              totals[board_id] += bytes
+            end
+          end
+        end
+      end
+
+      totals
+    end
+
+    def counted_attachments
+      attachments = ActiveStorage::Attachment.where(account_id: @account.id)
+      attachments.where(record_type: "Card", name: "image")
+        .or(attachments.where(record_type: "ActionText::RichText", name: "embeds"))
+    end
+
+    # Old rich-text rows can retain embed associations after their body was cleared.
+    def board_joins
+      <<~SQL
+        LEFT JOIN action_text_rich_texts AS rich_text
+          ON active_storage_attachments.record_type = 'ActionText::RichText'
+          AND rich_text.id = active_storage_attachments.record_id
+          AND rich_text.account_id = active_storage_attachments.account_id
+          AND OCTET_LENGTH(rich_text.body) > 0
+        LEFT JOIN comments
+          ON rich_text.record_type = 'Comment' AND rich_text.name = 'body'
+          AND comments.id = rich_text.record_id AND comments.account_id = active_storage_attachments.account_id
+        LEFT JOIN cards
+          ON cards.id = CASE
+            WHEN active_storage_attachments.record_type = 'Card' THEN active_storage_attachments.record_id
+            WHEN rich_text.record_type = 'Card' AND rich_text.name = 'description' THEN rich_text.record_id
+            ELSE comments.card_id
+          END
+          AND cards.account_id = active_storage_attachments.account_id
+      SQL
+    end
+end
