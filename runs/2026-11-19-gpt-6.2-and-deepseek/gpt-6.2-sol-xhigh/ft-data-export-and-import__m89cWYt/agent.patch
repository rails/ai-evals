diff --git a/app/models/account/data_transfer/archive.rb b/app/models/account/data_transfer/archive.rb
new file mode 100644
index 0000000..bd4e819
--- /dev/null
+++ b/app/models/account/data_transfer/archive.rb
@@ -0,0 +1,84 @@
+class Account::DataTransfer::Archive
+  HEADER = { "format" => "fizzy-account", "version" => 1 }.freeze
+
+  def initialize(account)
+    @account = account
+  end
+
+  def write(zip)
+    zip.add_file("manifest.json", HEADER.to_json)
+    Account::DataTransfer::Manifest.new(@account).each_record_set do |set|
+      set.each_record do |record|
+        if set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+          write_blob(zip, record)
+        else
+          attributes = record.attributes.slice(*set.attributes).transform_values do |value|
+            value.is_a?(Time) ? value.iso8601(6) : value
+          end
+          if record.is_a?(User)
+            attributes["email_address"] = record.identity&.email_address
+          elsif record.is_a?(Filter)
+            attributes["resources"] = %w[tags boards assignees creators closers].to_h do |name|
+              [ name, record.association(name).scope.ids ]
+            end
+          elsif record.is_a?(ActionText::RichText)
+            attributes["body"] = portable_body(record.body)
+          end
+          zip.add_file("#{set.directory}/#{record.id}.json", attributes.to_json)
+        end
+      end
+    end
+    write_cards(zip, @account.cards)
+  end
+
+  def write_cards(zip, cards)
+    cards.includes(:board, :creator, :image_attachment, :rich_text_description, comments: [ :creator, :rich_text_body ]).find_each do |card|
+      data = card.attributes.merge("board" => card.board.name, "creator" => card.creator.name,
+        "description" => portable_body(card.description.body), "image" => file_data(card.image.blob),
+        "comments" => card.comments.map { |comment| comment.attributes.merge("creator" => comment.creator.name, "body" => portable_body(comment.body.body)) })
+      zip.add_file("card-details/#{card.number}.json", data.to_json)
+      [ card.image.blob, *embedded_blobs(card.description), *card.comments.flat_map { |comment| embedded_blobs(comment.body) } ].compact.each do |blob|
+        write_blob(zip, blob) if exportable_blob?(blob)
+      end
+    end
+  end
+
+  private
+    def portable_body(body)
+      fragment = Nokogiri::HTML5.fragment(body.to_s)
+      fragment.css("action-text-attachment").each do |node|
+        attachable = ActionText::Attachable.from_node(node)
+        node.attribute_nodes.each(&:remove) unless attachable.is_a?(ActionText::Attachables::ContentAttachment)
+        if attachable.is_a?(ActiveStorage::Blob) && exportable_blob?(attachable)
+          file_data(attachable).each { |key, value| node["data-#{key}"] = value.to_s }
+        elsif attachable.is_a?(User) && attachable.account_id == @account.id
+          node["data-user"] = attachable.id
+          node.content = attachable.name
+        else
+          node.remove_attribute("sgid")
+        end
+      end
+      fragment.to_html
+    end
+
+    def embedded_blobs(rich_text)
+      rich_text.body&.attachables.to_a.grep(ActiveStorage::Blob)
+    end
+
+    def file_data(blob)
+      if blob && exportable_blob?(blob)
+        { "file" => "files/#{blob.id}", "filename" => blob.filename.to_s, "content-type" => blob.content_type }
+      end
+    end
+
+    def exportable_blob?(blob)
+      blob.account_id == @account.id || blob.account_id == Storage::TEMPLATE_ACCOUNT_ID
+    end
+
+    def write_blob(zip, blob)
+      path = "files/#{blob.id}"
+      unless zip.exists?(path)
+        zip.add_file(path, compress: false) { |sink| blob.download { |chunk| sink.write(chunk) } }
+      end
+    end
+end
