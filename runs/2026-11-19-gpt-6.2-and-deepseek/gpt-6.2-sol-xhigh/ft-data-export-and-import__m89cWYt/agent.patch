--- /dev/null
+++ b/app/mailers/data_transfer_mailer.rb
@@ -0,0 +1,18 @@
+class DataTransferMailer < ApplicationMailer
+  def export_ready(identity, blob)
+    @download_url = rails_storage_redirect_url(blob, expires_in: 1.day,
+      disposition: :attachment, script_name: nil)
+    mail(to: identity.email_address, subject: "Your Fizzy export is ready")
+  end
+
+  def import_finished(identity, account)
+    @account = account
+    @account_url = root_url(script_name: account.slug)
+    mail(to: identity.email_address, subject: "Your Fizzy import is complete")
+  end
+
+  def import_failed(identity, reason)
+    @reason = reason
+    mail(to: identity.email_address, subject: "Your Fizzy import failed")
+  end
+end
