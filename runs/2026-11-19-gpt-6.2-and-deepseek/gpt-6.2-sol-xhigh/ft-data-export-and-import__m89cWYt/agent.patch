diff --git a/app/jobs/account/export_job.rb b/app/jobs/account/export_job.rb
new file mode 100644
index 0000000..e3830b1
--- /dev/null
+++ b/app/jobs/account/export_job.rb
@@ -0,0 +1,30 @@
+class Account::ExportJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(user, whole_account:)
+    return unless user.active? && user.identity && user.account.active?
+    return if whole_account && !user.admin?
+
+    Current.with_account(user.account) do
+      archive = Account::DataTransfer::Archive.new(user.account)
+      Tempfile.create(binmode: true) do |file|
+        zip = ZipFile::Writer.new(file)
+        if whole_account
+          archive.write(zip)
+        else
+          cards = user.accessible_cards.where(account: user.account)
+          archive.write_cards(zip, cards.published.or(cards.drafted.where(creator: user)))
+        end
+        zip.close
+        file.rewind
+
+        blob = ActiveStorage::Blob.create_and_upload!(io: file, filename: whole_account ? "fizzy-account.zip" : "fizzy-cards.zip",
+          content_type: "application/zip", identify: false)
+        ActiveStorage::PurgeJob.set(wait: 25.hours).perform_later(blob)
+        DataTransferMailer.export_ready(user.identity, blob).deliver_now
+      end
+    end
+  end
+end
diff --git a/app/jobs/account/import_job.rb b/app/jobs/account/import_job.rb
new file mode 100644
index 0000000..af4e8d8
--- /dev/null
+++ b/app/jobs/account/import_job.rb
@@ -0,0 +1,28 @@
+class Account::ImportJob < ApplicationJob
+  queue_as :backend
+
+  def perform(identity_id, blob_id)
+    blob = ActiveStorage::Blob.find(blob_id)
+    return unless identity = Identity.find_by(id: identity_id)
+
+    account = restore(blob, identity)
+    DataTransferMailer.import_finished(identity, account).deliver_now if account
+  ensure
+    blob&.purge
+  end
+
+  private
+    def restore(blob, identity)
+      blob.open { |file| Account::DataTransfer::Restore.new(file.path, identity).run }
+    rescue Account::DataTransfer::Restore::InvalidArchive => error
+      DataTransferMailer.import_failed(identity, error.message).deliver_now
+      nil
+    rescue Zip::Error, JSON::ParserError, EOFError
+      DataTransferMailer.import_failed(identity, "The ZIP file or its JSON data could not be read.").deliver_now
+      nil
+    rescue StandardError => error
+      Rails.error.report(error)
+      DataTransferMailer.import_failed(identity, "The account data could not be restored. It may be incomplete or inconsistent.").deliver_now
+      nil
+    end
+end
diff --git a/app/mailers/data_transfer_mailer.rb b/app/mailers/data_transfer_mailer.rb
