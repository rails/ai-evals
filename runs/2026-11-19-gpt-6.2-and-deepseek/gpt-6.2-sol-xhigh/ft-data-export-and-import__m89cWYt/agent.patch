@@ -0,0 +1,28 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+  layout "public"
+
+  rate_limit to: 5, within: 10.minutes, only: :create
+
+  def new
+  end
+
+  def create
+    file = params[:archive]
+    unless file.is_a?(ActionDispatch::Http::UploadedFile) && file.size.between?(1, Account::DataTransfer::Restore::MAX_ARCHIVE_SIZE)
+      return redirect_to new_account_import_path, alert: "Choose a Fizzy account ZIP file to import.", status: :see_other
+    end
+
+    # The upload is temporary and belongs to the requester, who may not have an account yet.
+    blob = ActiveStorage::Blob.build_after_unfurling(io: file.tempfile, filename: file.original_filename,
+      content_type: "application/zip", identify: false)
+    blob.account_id = Current.identity.id
+    blob.save!(validate: false)
+    blob.upload_without_unfurling(file.tempfile)
+    Account::ImportJob.perform_later(Current.identity.id, blob.id)
+    redirect_to new_account_import_path, notice: "We’ll email you when your import finishes.", status: :see_other
+  rescue StandardError
+    blob&.purge if blob&.persisted?
+    raise
+  end
+end
