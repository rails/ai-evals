@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Account::DataTransfersTest < ActionDispatch::IntegrationTest
+  test "only admins can request a whole account export" do
+    sign_in_as :david
+    assert_no_enqueued_jobs only: Account::ExportJob do
+      post account_export_path
+    end
+    assert_response :forbidden
+
+    sign_out
+    sign_in_as :jason
+    assert_enqueued_with(job: Account::ExportJob) { post account_export_path }
+    assert_response :see_other
+  end
+
+  test "members can request an export of visible cards" do
+    sign_in_as :david
+    assert_enqueued_with(job: Account::ExportJob) { post my_export_path }
+    assert_response :see_other
+  end
+
+  test "a signed in identity can upload an archive without an account" do
+    identity = Identity.create!(email_address: "importer@example.com")
+    sign_in_as identity
+    untenanted do
+      get new_account_import_path
+      assert_response :success
+      Tempfile.create([ "invalid", ".zip" ]) do |file|
+        file.write("not a zip")
+        file.rewind
+        assert_enqueued_with(job: Account::ImportJob) do
+          post account_imports_path, params: { archive: Rack::Test::UploadedFile.new(file.path, "application/zip") }
+        end
+        assert_response :see_other
+        assert_no_difference "Account.count" do
+          assert_difference "ActiveStorage::Blob.count", -1 do
+            perform_enqueued_jobs only: Account::ImportJob
+          end
+        end
+        assert_equal "Your Fizzy import failed", ActionMailer::Base.deliveries.last.subject
+        assert_includes ActionMailer::Base.deliveries.last.body.decoded, "ZIP file"
+      end
+    end
+  end
+  test "importing a valid export creates an account and emails its owner" do
+    source = accounts("37s")
+    identity = identities(:jason)
+    sign_in_as identity
+
+    Tempfile.create([ "account", ".zip" ], binmode: true) do |file|
+      writer = ZipFile::Writer.new(file)
+      Account::DataTransfer::Archive.new(source).write(writer)
+      writer.close
+      file.flush
+
+      untenanted do
+        post account_imports_path, params: { archive: Rack::Test::UploadedFile.new(file.path, "application/zip") }
+      end
+      assert_response :see_other
+      assert_difference "Account.count" do
+        perform_enqueued_jobs only: Account::ImportJob
+      end
+    end
+
+    restored = identity.accounts.order(:created_at).last
+    assert_not_equal source, restored
+    assert_equal identity, restored.users.find_by!(role: :owner).identity
+    assert_equal "Your Fizzy import is complete", ActionMailer::Base.deliveries.last.subject
+    assert_includes ActionMailer::Base.deliveries.last.body.decoded, restored.slug
+    get account_settings_path(script_name: restored.slug)
+    assert_response :success
+  end
+end
