+++ b/test/jobs/account/export_job_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+require "zip"
+
+class Account::ExportJobTest < ActiveSupport::TestCase
+  test "emails a one-day link to a ZIP containing only accessible cards" do
+    user = users(:david)
+    private_board = user.account.boards.create!(name: "Private", creator: users(:kevin), all_access: false)
+    private_card = Current.with(user: users(:kevin)) do
+      private_board.cards.create!(title: "Private card", creator: users(:kevin), status: :published)
+    end
+    expected = user.accessible_cards.published.ids
+    assert_not_includes expected, private_card.id
+    assert expected.any?
+
+    assert_changes -> { ActionMailer::Base.deliveries.size }, from: ActionMailer::Base.deliveries.size do
+      Account::ExportJob.perform_now(user, whole_account: false)
+    end
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ user.identity.email_address ], mail.to
+    url = URI.extract(mail.body.decoded, [ "http", "https" ]).sole
+    token = URI.parse(url).path.split("/")[-2]
+    blob = ActiveStorage::Blob.find_signed!(token)
+    blob.open do |file|
+      Zip::File.open(file.path) do |zip|
+        ids = zip.glob("card-details/*.json").map { |entry| JSON.parse(entry.get_input_stream.read).fetch("id") }
+        assert_equal expected.sort, ids.sort
+      end
+    end
+    travel 1.day + 1.second do
+      assert_nil ActiveStorage::Blob.find_signed(token)
+    end
+  end
+end
diff --git a/test/models/account/data_transfer/archive_test.rb b/test/models/account/data_transfer/archive_test.rb
new file mode 100644
index 0000000..5440162
--- /dev/null
+++ b/test/models/account/data_transfer/archive_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Account::DataTransfer::ArchiveTest < ActiveSupport::TestCase
+  test "an account archive can be restored into a separate account" do
+    source = accounts("37s")
+    identity = identities(:jason)
+
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("header image"), filename: "header.png", content_type: "image/png", identify: false)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("embedded file"), filename: "notes.txt")
+    comment = card.comments.create!(creator: users(:jason), body: "Notes #{ActionText::Attachment.from_attachable(blob).to_html}")
+
+    Tempfile.create(binmode: true) do |file|
+      writer = ZipFile::Writer.new(file)
+      Account::DataTransfer::Archive.new(source).write(writer)
+      writer.close
+      file.flush
+      restored = Account::DataTransfer::Restore.new(file.path, identity).run
+
+      assert_not_equal source.id, restored.id
+      assert_equal source.cards.order(:number).pluck(:title), restored.cards.order(:number).pluck(:title)
+      assert_equal source.boards.order(:name).pluck(:name), restored.boards.order(:name).pluck(:name)
+      assert_equal identity, restored.users.find_by!(role: :owner).identity
+      restored_card = restored.cards.find_by!(number: card.number)
+      assert_equal "header image", restored_card.image.download
+      restored_comment = restored_card.comments.find_by!(created_at: comment.created_at)
+      assert_equal "embedded file", restored_comment.body.body.attachables.first.download
+      assert_equal "Jason", restored_comment.creator.name
+      assert_not_equal blob.id, restored_comment.body.body.attachables.first.id
+    end
+  end
+
+  test "an invalid relationship rolls back records and deletes uploaded files" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("header image"), filename: "header.png", content_type: "image/png", identify: false)
+
+    Tempfile.create(binmode: true) do |file|
+      writer = ZipFile::Writer.new(file)
+      Account::DataTransfer::Archive.new(card.account).write(writer)
+      writer.close
+      file.flush
+      Zip::File.open(file.path) do |zip|
+        attachment = card.image.attachment
+        entry = "active_storage_attachments/#{attachment.id}.json"
+        data = JSON.parse(zip.read(entry)).merge("record_id" => ActiveRecord::Type::Uuid.generate)
+        zip.get_output_stream(entry) { |stream| stream.write(data.to_json) }
+      end
+
+      service = card.image.blob.service
+      files = Dir.glob("#{service.root}/**/*").select { |path| File.file?(path) }.sort
+      assert_no_difference [ "Account.count", "Card.count", "ActiveStorage::Blob.count" ] do
+        assert_raises(Account::DataTransfer::Restore::InvalidArchive) do
+          Account::DataTransfer::Restore.new(file.path, identities(:jason)).run
+        end
+      end
+      assert_equal files, Dir.glob("#{service.root}/**/*").select { |path| File.file?(path) }.sort
+    end
+  end
+end
