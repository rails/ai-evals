@@ -6,20 +6,46 @@ class Book::AccessImport
   end
 
   def import
-    accesses = []
-    duplicate_index = nil
+    return Result.new([], nil) if @grants.empty?
 
-    Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
+    result = Access.transaction { import_grants }
+
+    if result.duplicate_index.nil?
+      accesses = result.accesses.dup
+      ActiveRecord.after_all_transactions_commit do
+        accesses.each { |access| Book::AccessNotificationJob.perform_later(access) }
       end
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    result
   end
+
+  private
+    def import_grants
+      unless @book.persisted?
+        raise ActiveRecord::RecordNotSaved.new("You cannot call create unless the parent is saved", @book)
+      end
+
+      # SQLite's immediate transaction keeps the duplicate check and insert atomic.
+      user_id_type = Access.type_for_attribute("user_id")
+      user_ids = @grants.map { |grant| user_id_type.cast(grant[:user_id]) }
+      users_by_id = User.where(id: user_ids).index_by(&:id)
+      seen_user_ids = @book.accesses.where(user_id: user_ids).pluck(:user_id).to_set
+      rows = []
+
+      @grants.each_with_index do |grant, index|
+        return Result.new([], index) unless Access.levels.key?(grant[:level])
+
+        access = Access.new(book: @book, user_id: grant[:user_id], level: grant[:level])
+        access.user = users_by_id[access.user_id] if users_by_id.key?(access.user_id)
+        access.validate!
+        return Result.new([], index) unless seen_user_ids.add?(access.user_id)
+
+        rows << { user_id: access.user_id, level: access.level }
+      end
+
+      ids = @book.accesses.insert_all!(rows).rows.flatten
+      saved_accesses = @book.accesses.where(id: ids).index_by(&:user_id)
+      Result.new(rows.map { |row| saved_accesses.fetch(row[:user_id]) }, nil)
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..97c860e
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,162 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "imports grants in order and notifies each new recipient after commit" do
+    grants = [ { user_id: users(:kevin).id.to_s, level: :editor }, { user_id: users(:jz).id, level: "reader" } ]
+    result = nil
+
+    accesses(:jz_manual).destroy!
+    @book.accesses.load
+
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      Access.transaction do
+        assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+          result = Book::AccessImport.new(@book, grants).import
+        end
+      end
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal [ [ users(:kevin).id, "editor" ], [ users(:jz).id, "reader" ] ], result.accesses.map { |access| [ access.user_id, access.level ] }
+    result.accesses.each do |access|
+      assert access.persisted?
+      assert_includes @book.accesses, access
+      assert_enqueued_with job: Book::AccessNotificationJob, args: [ access ]
+    end
+  end
+
+  test "rejects a grant for an existing recipient without persisting or notifying" do
+    grants = [ { user_id: users(:kevin).id, level: :reader }, { user_id: users(:david).id, level: :reader } ]
+    result = nil
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      Access.transaction do
+        result = Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_not @book.accesses.exists?(user: users(:kevin))
+    assert accesses(:david_manual).reload.editor?
+  end
+
+  test "rejects a repeated recipient within the roster" do
+    user_id = users(:kevin).id
+    grants = [ { user_id: user_id, level: :reader }, { user_id: user_id.to_s, level: :editor } ]
+    result = nil
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_not @book.accesses.exists?(user_id: user_id)
+  end
+
+  test "rejects an unknown level at its position without persisting or notifying" do
+    accesses(:jz_manual).destroy!
+    grants = [ { user_id: users(:kevin).id, level: :reader }, { user_id: users(:jz).id, level: :owner }, { user_id: users(:david).id, level: :reader } ]
+    result = nil
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      assert_no_difference -> { @book.accesses.count } do
+        result = Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+  end
+
+  test "reports an earlier duplicate before an invalid level" do
+    grants = [ { user_id: users(:david).id, level: :reader }, { user_id: users(:kevin).id, level: :owner } ]
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal 0, result.duplicate_index
+    assert_empty result.accesses
+  end
+
+  test "empty rosters succeed without writes or notifications" do
+    result = nil
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      assert_equal 0, count_writes { result = Book::AccessImport.new(@book, []).import }
+    end
+
+    assert_nil result.duplicate_index
+    assert_empty result.accesses
+  end
+
+  test "still validates that the recipient exists" do
+    grants = [ { user_id: users(:kevin).id, level: :reader }, { user_id: User.maximum(:id) + 1, level: :editor } ]
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      assert_no_difference -> { @book.accesses.count } do
+        assert_raises(ActiveRecord::RecordInvalid) { Book::AccessImport.new(@book, grants).import }
+      end
+    end
+  end
+
+  test "does not notify if the surrounding transaction rolls back" do
+    grants = [ { user_id: users(:kevin).id, level: :reader } ]
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      Access.transaction do
+        Book::AccessImport.new(@book, grants).import
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.accesses.exists?(user: users(:kevin))
+  end
+
+  test "write count does not grow for successful rosters" do
+    grants = new_grants(20)
+    small, large = [ grants.first(4), grants.last(16) ].map do |roster|
+      count_writes do
+        result = Book::AccessImport.new(@book, roster).import
+        assert_nil result.duplicate_index
+        assert_equal roster.size, result.accesses.size
+      end
+    end
+
+    assert_equal small, large
+  end
+
+  test "write count does not grow for rejected rosters" do
+    grants = new_grants(15)
+    duplicate = { user_id: users(:david).id, level: :reader }
+    small, large = [ grants.first(3) + [ duplicate ], grants + [ duplicate ] ].map do |roster|
+      count_writes do
+        result = Book::AccessImport.new(@book, roster).import
+        assert_equal roster.size - 1, result.duplicate_index
+        assert_empty result.accesses
+      end
+    end
+
+    assert_equal small, large
+  end
+
+  private
+    def new_grants(count)
+      rows = count.times.map do |index|
+        { name: "Recipient #{index}", email_address: "recipient-#{index}@example.com", password_digest: users(:kevin).password_digest, role: :member }
+      end
+      User.insert_all!(rows).rows.map { |id,| { user_id: id, level: :reader } }
+    end
+
+    def count_writes
+      writes = 0
+      subscriber = ->(*, payload) { writes += 1 if payload[:sql].match?(/\A\s*(?:INSERT|UPDATE|DELETE|REPLACE)\b/i) }
+      ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") { yield }
+      writes
+    end
+end
