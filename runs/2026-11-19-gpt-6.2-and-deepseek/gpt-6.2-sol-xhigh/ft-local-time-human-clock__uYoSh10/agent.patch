diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..430f7c5
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,108 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    now = Time.utc(2026, 9, 20, 23, 42)
+    travel_to now
+    @clock_script = page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: <<~JS).fetch("identifier")
+      window.Date = class extends Date {
+        constructor(...args) { super(...(args.length ? args : [#{now.to_i * 1000}])) }
+        static now() { return #{now.to_i * 1000} }
+      }
+    JS
+    set_browser_timezone "America/New_York"
+    sign_in_as users(:david)
+    @card = cards(:logo)
+  end
+
+  teardown do
+    if @clock_script
+      page.driver.browser.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: @clock_script)
+      set_browser_timezone ""
+    end
+  end
+
+  test "the same timestamps use each browser's clock and calendar" do
+    today = comments(:logo_agreement_kevin)
+    last_night = comments(:logo_agreement_jz)
+    today.update!(created_at: Time.utc(2026, 9, 20, 17, 42))
+    last_night.update!(created_at: Time.utc(2026, 9, 20, 2))
+    earlier_this_week = @card.comments.create!(body: "Earlier this week", creator: users(:david), created_at: Time.utc(2026, 9, 15, 20, 30))
+    older = @card.comments.create!(body: "Older", creator: users(:david), created_at: Time.utc(2026, 9, 12, 16))
+    last_year = @card.comments.create!(body: "Last year", creator: users(:david), created_at: Time.utc(2025, 12, 15, 10))
+    @card.update!(last_active_at: Time.utc(2026, 9, 21, 4, 30) - @card.auto_postpone_period)
+
+    visit card_url(@card)
+
+    assert_comment_time today, "1:42 PM"
+    assert_comment_time last_night, "yesterday"
+    assert_comment_time earlier_this_week, "5 days ago"
+    assert_comment_time older, "Sep 12"
+    assert_comment_time last_year, "Dec 15, 2025"
+    assert_selector ".card-perma__closure-message", text: /Moves to “Not Now” tomorrow if there’s no activity/
+
+    set_browser_timezone "Asia/Tokyo"
+    visit card_url(@card)
+
+    assert_comment_time today, "2:42 AM"
+    assert_comment_time last_night, "yesterday"
+    assert_comment_time earlier_this_week, "5 days ago"
+    assert_comment_time older, "Sep 13"
+    assert_selector ".card-perma__closure-message", text: /Moves to “Not Now” today if there’s no activity/
+  end
+
+  test "renders timestamps inserted by a Turbo Stream and restores text after morphing" do
+    @card.update!(last_active_at: Time.utc(2026, 9, 23, 16) - @card.auto_postpone_period)
+    visit card_url(@card)
+    assert_selector ".card-perma__closure-message time", exact_text: "in 3 days"
+
+    find(".comment--new lexxy-editor [contenteditable=true]").send_keys("A new comment")
+    click_on "Post"
+    assert_selector ".comment:not(.comment--new) .comment__body", exact_text: "A new comment"
+    comment = @card.comments.find_by!(created_at: Time.current, creator: users(:david))
+    assert_comment_time comment, "7:42 PM"
+
+    # A morph keeps the existing <time> element, but the incoming HTML has no text.
+    page.execute_script(<<~JS, dom_id(@card, :closure_notice))
+      const notice = document.getElementById(arguments[0])
+      const time = notice.querySelector("time")
+      const updatedTime = time.cloneNode(false)
+      updatedTime.dateTime = "2026-09-21T04:30:00.000Z"
+      window.originalTime = time
+      Turbo.renderStreamMessage(`<turbo-stream action="update" method="morph" target="${notice.id}">
+        <template>Moves to “Not Now” ${updatedTime.outerHTML} if there’s no activity.</template>
+      </turbo-stream>`)
+    JS
+
+    assert_selector ".card-perma__closure-message time", exact_text: "tomorrow"
+    assert page.evaluate_script("window.originalTime === document.querySelector('.card-perma__closure-message time')")
+  end
+
+  test "calendar days are not elapsed 24-hour periods" do
+    visit card_url(@card)
+
+    labels = page.evaluate_async_script(<<~JS)
+      const done = arguments[0]
+      import("helpers/time_helpers").then(({ formatTimestamp }) => {
+        done([
+          formatTimestamp("2026-03-08T05:00:00Z", "relative", new Date("2026-03-09T04:00:00Z")),
+          formatTimestamp("2026-03-09T04:00:00Z", "deadline", new Date("2026-03-09T03:59:00Z")),
+          formatTimestamp("2026-03-08", "weekday_date")
+        ])
+      })
+    JS
+
+    assert_equal [ "yesterday", "tomorrow", "Sunday, March 8" ], labels
+  end
+
+  private
+    def set_browser_timezone(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+    end
+
+    def assert_comment_time(comment, text)
+      assert_selector "##{dom_id(comment)} .comment__permalink-title time", exact_text: text
+    end
+end
