diff --git a/app/javascript/helpers/time_helpers.js b/app/javascript/helpers/time_helpers.js
new file mode 100644
index 0000000..c1d9d7b
--- /dev/null
+++ b/app/javascript/helpers/time_helpers.js
@@ -0,0 +1,51 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const formats = {
+  time: { hour: "numeric", minute: "2-digit" },
+  short_date: { month: "short", day: "numeric" },
+  date: { year: "numeric", month: "short", day: "numeric" },
+  weekday_date: { weekday: "long", month: "long", day: "numeric" },
+  numeric_date_time: { year: "2-digit", month: "numeric", day: "numeric", hour: "numeric", minute: "2-digit" },
+  full: { year: "numeric", month: "long", day: "numeric", hour: "numeric", minute: "2-digit", timeZoneName: "short" }
+}
+
+const formatters = new Map()
+const relativeDays = new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+
+export function formatTimestamp(timestamp, format, now = new Date()) {
+  if (!timestamp) return ""
+
+  const date = new Date(timestamp)
+  if (isNaN(date.getTime())) return ""
+
+  if (format === "deadline") {
+    const days = signedDifferenceInDays(now, date)
+    return days < 0 ? "soon" : relativeDays.format(days, "day")
+  }
+
+  if (format === "relative") {
+    const days = signedDifferenceInDays(now, date)
+    if (days === 0) return dateFormatter("time").format(date)
+    if (days > -7) return relativeDays.format(days, "day")
+
+    format = date.getFullYear() === now.getFullYear() ? "short_date" : "date"
+  }
+
+  // A date without a time (such as a timeline heading) names a calendar day, not an instant.
+  return dateFormatter(format, isCalendarDate(timestamp)).format(date)
+}
+
+export function isCalendarDate(timestamp) {
+  return /^\d{4}-\d{2}-\d{2}$/.test(timestamp)
+}
+
+function dateFormatter(format, calendarDate = false) {
+  const key = `${format}:${calendarDate}`
+  if (!formatters.has(key)) {
+    formatters.set(key, new Intl.DateTimeFormat("en-US", {
+      ...formats[format],
+      timeZone: calendarDate ? "UTC" : undefined
+    }))
+  }
+  return formatters.get(key)
+}
