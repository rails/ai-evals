--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,19 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp, isCalendarDate } from "helpers/time_helpers"
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.render()
+  }
+
+  render() {
+    const timestamp = this.element.dateTime
+    this.element.textContent = formatTimestamp(timestamp, this.formatValue)
+
+    if (!isCalendarDate(timestamp)) {
+      this.element.title = formatTimestamp(timestamp, "full")
+    }
+  }
+}
