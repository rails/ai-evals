diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..3d649e7
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "permanently deletes expired accounts and their data" do
+    account = accounts("37s")
+    account.create_cancellation!(initiated_by: users(:jason), created_at: 31.days.ago)
+    Storage::Entry.create!(account: account, delta: 1, operation: "attach")
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    attachment_id = card.image.attachment.id
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment_id)
+    [ Account::Cancellation, Board, Card, Comment, User, Storage::Entry, Search::Record.for(account.id) ].each do |model|
+      assert_not model.exists?(account_id: account.id), "Expected #{model} to be removed"
+    end
+    assert Identity.exists?(identities(:jason).id)
+    assert Account.exists?(accounts(:initech).id)
+  end
+
+  test "preserves accounts at the cutoff, recently canceled accounts, and reactivated accounts" do
+    freeze_time do
+      at_cutoff, recent, reactivated = accounts("37s", :initech, :acme)
+      at_cutoff.create_cancellation!(initiated_by: users(:jason), created_at: 30.days.ago)
+      recent.create_cancellation!(initiated_by: users(:mike), created_at: 29.days.ago)
+      reactivated.create_cancellation!(initiated_by: reactivated.users.create!(name: "System", role: :system), created_at: 31.days.ago)
+      reactivated.reactivate
+
+      assert_no_difference "Account.count" do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+  end
+end
