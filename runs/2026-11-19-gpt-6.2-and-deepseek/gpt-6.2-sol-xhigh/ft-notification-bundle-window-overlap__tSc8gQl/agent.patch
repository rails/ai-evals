diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..1aeeb80
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,71 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :user
+  belongs_to :account, default: -> { user.account }
+
+  has_many :items, dependent: :delete_all
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add(notification)
+      user = notification.user
+      return unless user.settings&.bundle_email_interval && !notification.creator.system?
+
+      # Serialize both opening and closing windows for this user. Read the windows
+      # after acquiring the lock so a concurrent notification cannot open another one.
+      user.with_lock do
+        if interval = user.settings&.bundle_email_interval
+          now = Time.current
+          source = notification.source
+          recorded_at = notification.previously_new_record? ? notification.created_at : notification.updated_at
+          occurred_at = [ source.created_at, recorded_at, now ].min
+          bundle = pending_at(user, occurred_at) || user.notification_bundles.create!(starts_at: now, ends_at: now + interval)
+          bundle.items.find_or_create_by!(notification: notification, source: source)
+        end
+      end
+    end
+
+    private
+      def pending_at(user, occurred_at)
+        # No lower bound: activity that predates the first arrival belongs in the
+        # window that is already open, rather than starting a window in the past.
+        user.notification_bundles.where(closed_at: nil).where("ends_at > ?", occurred_at).order(:ends_at).first
+      end
+  end
+
+  def deliver
+    if close_for_delivery
+      if user.settings&.bundle_email_interval && user.active? && user.identity && account.active?
+        payloads = deliverable_payloads
+        NotificationMailer.digest(self, payloads).deliver_now if payloads.any?
+      end
+
+      destroy!
+    end
+  end
+
+  private
+    def deliver_later
+      Current.with_account(account) do
+        Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+      end
+    end
+
+    def close_for_delivery
+      # Seal the batch before sending, but don't hold the lock during SMTP.
+      user.with_lock do
+        reload
+        if ends_at <= Time.current
+          update!(closed_at: Time.current) unless closed_at
+          true
+        end
+      end
+    end
+
+    def deliverable_payloads
+      notifications = user.notifications.where(card: user.accessible_cards)
+      items.where(notification: notifications).order(:id).preload(:source, notification: :card).filter_map do |item|
+        Notification::DefaultPayload.for(item) if item.source
+      end
+    end
+end
