@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Account::DataTransfer::UserSettingsRecordSetTest < ActiveSupport::TestCase
+  test "settings exported before email digests can still be imported" do
+    id = ActiveRecord::Type::Uuid.generate
+    data = users(:kevin).settings.attributes.except("bundle_email_frequency").merge(
+      "id" => id, "user_id" => ActiveRecord::Type::Uuid.generate, "account_id" => ActiveRecord::Type::Uuid.generate
+    )
+
+    Tempfile.create([ "legacy_settings", ".zip" ]) do |file|
+      file.binmode
+      writer = ZipFile::Writer.new(file)
+      writer.add_file("data/user_settings/#{id}.json", data.to_json)
+      writer.close
+      file.rewind
+
+      zip = ZipFile::Reader.new(file)
+      record_set = Account::DataTransfer::UserSettingsRecordSet.new(Current.account)
+      record_set.check(from: zip)
+      record_set.import(from: zip)
+    end
+
+    assert_equal "never", User::Settings.find(id).bundle_email_frequency
+  end
+end
