--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,187 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @creator = users(:david)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "the first notification starts the window and later activity is sent in a single email" do
+    freeze_time do
+      first = notify(:logo)
+      bundle = @user.notification_bundles.sole
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+
+      travel 2.hours
+      second = notify(:layout)
+      assert_equal bundle, @user.notification_bundles.sole
+      assert_enqueued_jobs 1, only: Notification::Bundle::DeliveryJob
+
+      assert_no_emails do
+        perform_enqueued_jobs(only: Notification::Bundle::DeliveryJob, at: Time.current)
+      end
+
+      travel 2.hours
+      email = capture_emails do
+        perform_enqueued_jobs(only: Notification::Bundle::DeliveryJob, at: Time.current)
+      end.sole
+
+      assert_equal [ @user.identity.email_address ], email.to
+      assert_includes email.text_part.decoded, first.card.title
+      assert_includes email.text_part.decoded, second.card.title
+      assert_includes email.html_part.decoded, "#{@user.account.slug}/cards/#{first.card.number}"
+    end
+  end
+
+  test "late activity joins the pending window without moving its start or delivery time" do
+    freeze_time do
+      notify(:logo)
+      bundle = @user.notification_bundles.sole
+      starts_at = bundle.starts_at
+      ends_at = bundle.ends_at
+
+      travel 5.hours
+      notify(:layout, occurred_at: 6.hours.ago)
+
+      assert_equal bundle, @user.notification_bundles.sole
+      assert_equal starts_at, bundle.reload.starts_at
+      assert_equal ends_at, bundle.ends_at
+      assert_equal 2, bundle.items.count
+    end
+  end
+
+  test "activity at the closing boundary opens a new window even if the first email is delayed" do
+    freeze_time do
+      first = notify(:logo, action: "card_published")
+      earlier = @user.notification_bundles.sole
+      @user.settings.update!(bundle_email_frequency: :daily)
+
+      travel_to earlier.ends_at
+      second = notify(:logo, action: "card_closed")
+      later = @user.notification_bundles.order(:starts_at).last
+
+      assert_equal earlier.ends_at, later.starts_at
+      assert_equal 1.day.from_now, later.ends_at
+      assert_equal first, second # Fizzy reuses the same notification row for the card.
+
+      email = capture_emails do
+        perform_enqueued_jobs(only: Notification::Bundle::DeliveryJob, at: Time.current)
+      end.sole
+      assert_includes email.text_part.decoded, "Added by #{@creator.name}"
+      refute_includes email.text_part.decoded, "Closed by #{@creator.name}"
+
+      travel_to later.ends_at
+      email = capture_emails do
+        perform_enqueued_jobs(only: Notification::Bundle::DeliveryJob, at: Time.current)
+      end.sole
+      assert_includes email.text_part.decoded, "Closed by #{@creator.name}"
+    end
+  end
+
+  test "each user starts their own window with their chosen interval" do
+    weekly_user = users(:jz)
+    weekly_user.settings.update!(bundle_email_frequency: :weekly)
+
+    freeze_time do
+      notify(:logo)
+      travel 1.hour
+      notify(:logo, user: weekly_user)
+
+      weekly_bundle = weekly_user.notification_bundles.sole
+      assert_equal Time.current, weekly_bundle.starts_at
+      assert_equal 1.week.from_now, weekly_bundle.ends_at
+      assert_equal 3.hours.from_now, @user.notification_bundles.sole.ends_at
+    end
+  end
+
+  test "a mention delivered through the notifier appears in the digest" do
+    mention = mentions(:logo_card_david_mention_by_jz)
+    mention.mentionee.settings.update!(bundle_email_frequency: :daily)
+
+    freeze_time do
+      NotifyRecipientsJob.perform_now(mention)
+      travel 1.day
+      email = capture_emails do
+        perform_enqueued_jobs(only: Notification::Bundle::DeliveryJob, at: Time.current)
+      end.sole
+
+      assert_equal [ mention.mentionee.identity.email_address ], email.to
+      assert_includes email.text_part.decoded, "#{mention.mentioner.first_name} mentioned you"
+    end
+  end
+
+  test "off does not open a window or schedule a delivery" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliveryJob do
+      notify(:logo)
+    end
+    assert_empty @user.notification_bundles
+  end
+
+  test "turning email off suppresses a pending digest" do
+    notify(:logo)
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    travel 4.hours + 1.second
+    assert_no_emails do
+      perform_enqueued_jobs(only: Notification::Bundle::DeliveryJob, at: Time.current)
+    end
+    assert_empty @user.notification_bundles.reload
+  end
+
+  test "read state changes do not add digest entries" do
+    notification = notify(:logo)
+    bundle = @user.notification_bundles.sole
+
+    assert_no_difference -> { bundle.items.count } do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "the delivery job does not email twice for the same window" do
+    freeze_time do
+      notify(:logo)
+      bundle = @user.notification_bundles.sole
+      Notification::Bundle::DeliveryJob.set(wait_until: bundle.ends_at).perform_later(bundle)
+
+      travel_to bundle.ends_at
+      assert_emails 1 do
+        perform_enqueued_jobs(only: Notification::Bundle::DeliveryJob, at: Time.current)
+      end
+      assert_not Notification::Bundle.exists?(bundle.id)
+    end
+  end
+
+  test "cards the recipient can no longer access are excluded from the digest" do
+    cards(:buy_domain).update_column(:board_id, boards(:private).id)
+
+    freeze_time do
+      notify(:logo)
+      notify(:buy_domain)
+      cards(:logo).board.accesses.find_by!(user: @user).destroy!
+
+      travel 4.hours
+      email = capture_emails do
+        perform_enqueued_jobs(only: Notification::Bundle::DeliveryJob, at: Time.current)
+      end.sole
+
+      assert_includes email.text_part.decoded, cards(:buy_domain).title
+      refute_includes email.text_part.decoded, cards(:logo).title
+    end
+  end
+
+  private
+    def notify(card, occurred_at: Time.current, action: "card_published", user: @user)
+      card = cards(card)
+      event = card.events.create!(board: card.board, creator: @creator, action: action, created_at: occurred_at)
+      notification = user.notifications.find_or_initialize_by(card: card)
+      notification.update!(source: event, creator: @creator)
+      notification
+    end
+end
