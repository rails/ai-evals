diff --git a/app/jobs/broadcast_editing_presence_job.rb b/app/jobs/broadcast_editing_presence_job.rb
new file mode 100644
index 0000000..2eb634f
--- /dev/null
+++ b/app/jobs/broadcast_editing_presence_job.rb
@@ -0,0 +1,11 @@
+class BroadcastEditingPresenceJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(leaf, user)
+    # Resolve recipients at delivery time: an open editor can keep its subscription after revocation.
+    leaf.book.active_editors.find_each do |editor|
+      Turbo::StreamsChannel.broadcast_render_to leaf, :being_edited, editor,
+        partial: "leaves/being_edited_by", locals: { leaf: leaf, user: user }
+    end
+  end
+end
