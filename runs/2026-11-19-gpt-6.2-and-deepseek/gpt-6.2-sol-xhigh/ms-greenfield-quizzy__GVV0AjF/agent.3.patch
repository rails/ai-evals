@@ -0,0 +1,14 @@
+class GamePresence < ApplicationRecord
+  TTL = 35.seconds
+  TAB_PATTERN = /\A[0-9a-f]{32}\z/
+
+  belongs_to :game_player
+  scope :current, -> { where(departed: false, seen_at: TTL.ago..) }
+
+  def self.report(player, tab, leaving:)
+    # A late heartbeat from a closing tab cannot undo its departure. Other
+    # tabs for the same player still have their own leases.
+    upsert({ game_player_id: player.id, tab: tab, seen_at: Time.current, departed: leaving },
+      unique_by: [:game_player_id, :tab], update_only: leaving ? [:departed] : [:seen_at])
+  end
+end
