diff --git a/app/assets/javascripts/live_game.js b/app/assets/javascripts/live_game.js
new file mode 100644
index 0000000..36a5f1c
--- /dev/null
+++ b/app/assets/javascripts/live_game.js
@@ -0,0 +1,314 @@
+(() => {
+  const page = document.querySelector("[data-live-game]");
+  if (!page) return;
+
+  const find = (name) => page.querySelector(`[data-${name}]`);
+  const moderator = page.dataset.liveGame === "moderator";
+  const csrf = document.querySelector('meta[name="csrf-token"]').content;
+  const notice = find("notice");
+  const round = find("round");
+  const ended = find("ended");
+  const control = find("advance");
+  const join = find("join");
+  let state;
+  let socket;
+  let connected = false;
+  let stopped = false;
+
+  function node(tag, classes, text) {
+    const element = document.createElement(tag);
+    if (classes) element.className = classes;
+    if (text != null) element.textContent = text;
+    return element;
+  }
+
+  function setMessage(element, message) {
+    if (element.textContent !== message) element.textContent = message;
+    element.hidden = !message;
+  }
+
+  const jitter = (ms) => ms * (0.85 + Math.random() * 0.3);
+
+  async function request(url, data) {
+    const abort = new AbortController();
+    const timeout = setTimeout(() => abort.abort(), 5000);
+    const headers = { Accept: "application/json" };
+    const options = { headers, signal: abort.signal, cache: "no-store" };
+    if (data) {
+      headers["X-CSRF-Token"] = csrf;
+      if (!(data instanceof URLSearchParams)) headers["Content-Type"] = "application/json";
+      options.method = "POST";
+      options.body = data instanceof URLSearchParams ? data : JSON.stringify(data);
+    }
+    try {
+      const response = await fetch(url, options);
+      if (response.status === 404) {
+        stop();
+        throw new Error("This game is no longer available.");
+      }
+      if (!response.ok && ![409, 422].includes(response.status)) throw new Error("Request failed");
+      return response.status === 204 ? null : await response.json();
+    } finally {
+      clearTimeout(timeout);
+    }
+  }
+
+  let pollTimer;
+  let polling = false;
+  let pollAgain = false;
+  let retryDelay = 0;
+  let answerEpoch = 0;
+
+  async function refresh() {
+    if (stopped || state?.phase === "ended") return;
+    if (polling) {
+      pollAgain = true;
+      return;
+    }
+    clearTimeout(pollTimer);
+    polling = true;
+    const epoch = answerEpoch;
+    const playerAtRequest = state.player;
+    try {
+      const data = await request(page.dataset.stateUrl);
+      // A GET started before an answer was saved may still contain the old
+      // pick. Always accept phase changes, never let an old GET undo a save.
+      if (!playerAtRequest && state.player && !data.player && data.phase !== "ended") {
+        // This read left before the join response set the player's cookie.
+        pollAgain = true;
+      } else if (data.version !== state.version || !(saving || epoch !== answerEpoch)) {
+        apply(data);
+      }
+      if (retryDelay) setMessage(notice, "");
+      retryDelay = 0;
+    } catch (error) {
+      retryDelay = Math.min((retryDelay || 1200) * 2, 12000);
+      setMessage(notice, stopped ? error.message : "Reconnecting to the game…");
+    } finally {
+      polling = false;
+      if (!stopped && state.phase !== "ended") {
+        const interval = moderator ? 800 : connected ? 14000 : 2200;
+        pollTimer = setTimeout(refresh, pollAgain && !retryDelay ? 0 : jitter(retryDelay || interval));
+        pollAgain = false;
+      }
+    }
+  }
+
+  function stop() {
+    stopped = true;
+    clearTimeout(pollTimer);
+    clearTimeout(heartbeatTimer);
+    socket?.disconnect();
+  }
+
+  function letter(index) {
+    if (index >= 26) return letter(Math.floor(index / 26) - 1) + letter(index % 26);
+    return String.fromCharCode(65 + index);
+  }
+
+  function renderRound(data) {
+    const open = data.phase === "open";
+    const prefix = moderator ? "stage" : "play";
+    const progress = node("p", `${prefix}-question__num`, `Question ${data.number} of ${data.total}`);
+    const heading = node("h1", `${prefix}-question__body`, data.question.text);
+    heading.tabIndex = -1;
+    const options = node("ul", `${prefix}-options${open ? "" : moderator ? " stage-options--results" : " is-locked is-revealed"}`);
+    options.setAttribute("role", "list");
+    data.question.options.forEach((option, index) => {
+      const item = node("li", moderator ? "stage-option" : "");
+      const body = moderator ? item : node(open ? "button" : "div", "play-option");
+      if (!moderator && open) {
+        body.type = "button";
+        body.dataset.choose = index;
+        body.setAttribute("aria-label", option.text);
+      }
+      body.classList.toggle("is-correct", !open && option.correct === true);
+      const badge = node("span", `${prefix}-option__letter`, moderator ? letter(index) : null);
+      if (!moderator) badge.dataset.letter = letter(index);
+      badge.setAttribute("aria-hidden", "true");
+      body.append(badge, node("span", `${prefix}-option__title`, option.text));
+      if (moderator && !open) {
+        body.append(node("span", "stage-option__count", `${option.count} ${option.count === 1 ? "answer" : "answers"}`));
+      }
+      if (!open && option.correct) body.append(node("span", "live-correct", "Correct"));
+      if (!moderator) {
+        const pick = node("span", "play-option__mark", "Your answer");
+        pick.dataset.pick = index;
+        body.append(pick);
+        item.append(body);
+      }
+      options.append(item);
+    });
+    const hadFocus = round.contains(document.activeElement);
+    round.replaceChildren(progress, heading);
+    if (!moderator && !open) {
+      const style = { "Correct!": "right", "Wrong!": "wrong", "No answer": "neutral" }[data.feedback];
+      const feedback = node("p", `play-status play-status--${style}`, data.feedback);
+      feedback.setAttribute("role", "status");
+      round.append(feedback);
+    }
+    round.append(options);
+    if (hadFocus || moderator) heading.focus({ preventScroll: true });
+  }
+
+  function renderPick(picked) {
+    for (const badge of round.querySelectorAll("[data-pick]")) {
+      const chosen = Number(badge.dataset.pick) === picked;
+      const option = badge.parentElement;
+      badge.hidden = !chosen;
+      option.classList.toggle("is-picked", chosen);
+      if (option.matches("button")) option.setAttribute("aria-pressed", chosen);
+    }
+  }
+
+  function apply(data) {
+    if (stopped || (state && data.version < state.version)) return;
+    const changedRound = !state || data.version !== state.version || data.player !== state.player;
+    state = data;
+    ended.hidden = data.phase !== "ended";
+    round.hidden = !data.question;
+    if (changedRound) {
+      setMessage(notice, "");
+      if (data.question) renderRound(data);
+    }
+    if (moderator) {
+      const lobby = find("lobby");
+      if (lobby) lobby.hidden = data.phase !== "waiting";
+      if (data.phase === "waiting") setMessage(find("players"), `Players: ${data.players}`);
+      setMessage(find("answers"), data.phase === "open" ? `Answers: ${data.answered} / ${data.players}` : "");
+      const labels = { start: "Start", finish: "Finish", next: "Next", end: "End quiz" };
+      setMessage(control, labels[data.control] || "");
+    } else {
+      if (join) join.hidden = Boolean(data.player) || data.phase === "ended";
+      setMessage(find("greeting"), data.player && data.phase !== "ended" ? `Hi, ${data.player}!` : "");
+      find("waiting").hidden = !data.player || data.phase !== "waiting";
+      if (data.question) renderPick(data.picked);
+      if (data.player && data.phase !== "ended" && !tab) heartbeat();
+    }
+    if (data.phase === "ended") {
+      setMessage(notice, "");
+      stop();
+    }
+  }
+
+  let saving = false;
+  let queuedPick;
+
+  async function sendPick() {
+    if (saving || !queuedPick || stopped) return;
+    const pick = queuedPick;
+    queuedPick = undefined;
+    if (pick.version !== state.version) return;
+    saving = true;
+    answerEpoch += 1;
+    try {
+      apply(await request(page.dataset.answerUrl, pick));
+      if (!stopped) setMessage(notice, "");
+    } catch (error) {
+      setMessage(notice, stopped ? error.message : "Couldn’t confirm your answer. Tap an option to try again.");
+    } finally {
+      answerEpoch += 1;
+      saving = false;
+      if (queuedPick) sendPick();
+      else if (state.picked !== pick.option) refresh();
+    }
+  }
+
+  let tab;
+  let heartbeatTimer;
+  let reporting = false;
+
+  async function heartbeat() {
+    if (stopped || !state.player || reporting) return;
+    clearTimeout(heartbeatTimer);
+    // getRandomValues works on the plain HTTP origins used by conference LANs.
+    tab ||= Array.from(crypto.getRandomValues(new Uint8Array(16)), (byte) => byte.toString(16).padStart(2, "0")).join("");
+    reporting = true;
+    try {
+      await request(page.dataset.presenceUrl, new URLSearchParams({ tab }));
+    } catch (_) {
+      // An expired lease is re-established on the next successful heartbeat.
+    } finally {
+      reporting = false;
+      if (!stopped && tab) heartbeatTimer = setTimeout(heartbeat, jitter(10000));
+    }
+  }
+
+  apply(JSON.parse(page.dataset.initialState));
+  if (stopped) return;
+
+  if (moderator) {
+    control.addEventListener("click", async () => {
+      control.disabled = true;
+      try {
+        apply(await request(page.dataset.advanceUrl, { version: state.version, command: state.control }));
+        if (!stopped) setMessage(notice, "");
+      } catch (error) {
+        setMessage(notice, stopped ? error.message : "Couldn’t update the game. Try again.");
+        refresh();
+      } finally {
+        control.disabled = false;
+      }
+    });
+  } else {
+    join?.querySelector("form").addEventListener("submit", async (event) => {
+      event.preventDefault();
+      const form = event.currentTarget;
+      const button = form.querySelector("button");
+      if (button.disabled) return;
+      button.disabled = true;
+      try {
+        const data = await request(form.action, new URLSearchParams(new FormData(form)));
+        apply(data);
+        setMessage(find("join-error"), data.error || "");
+        if (data.player && !state.player) refresh();
+      } catch (error) {
+        setMessage(find("join-error"), stopped ? error.message : "Couldn’t join yet. Try again.");
+      } finally {
+        button.disabled = false;
+      }
+    });
+    round.addEventListener("click", (event) => {
+      const button = event.target.closest("[data-choose]");
+      if (!button || state.phase !== "open" || stopped) return;
+      queuedPick = { version: state.version, option: Number(button.dataset.choose) };
+      sendPick();
+    });
+
+    // Spread the room's concurrent reads when a question opens or closes.
+    const nudge = () => setTimeout(refresh, Math.random() * 300);
+    if (window.ActionCable && window.WebSocket) {
+      socket = window.ActionCable.createConsumer("/cable");
+      socket.subscriptions.create({ channel: "GameUpdatesChannel", code: page.dataset.code }, {
+        connected() { connected = true; nudge(); },
+        disconnected() { connected = false; refresh(); },
+        received() { nudge(); }
+      });
+    }
+
+    window.addEventListener("pagehide", () => {
+      if (!tab || stopped) return;
+      navigator.sendBeacon?.(page.dataset.presenceUrl,
+        new URLSearchParams({ tab, leave: "1", authenticity_token: csrf }));
+      tab = undefined;
+      clearTimeout(heartbeatTimer);
+    });
+    window.addEventListener("pageshow", (event) => {
+      if (event.persisted) {
+        heartbeat();
+        refresh();
+      }
+    });
+  }
+
+  function resync() {
+    if (!moderator) heartbeat();
+    refresh();
+  }
+
+  window.addEventListener("online", resync);
+  document.addEventListener("visibilitychange", () => {
+    if (!document.hidden) resync();
+  });
+  pollTimer = setTimeout(refresh, jitter(moderator ? 800 : 2200));
+})();
