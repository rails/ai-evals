diff --git a/app/channels/game_updates_channel.rb b/app/channels/game_updates_channel.rb
new file mode 100644
index 0000000..cfa80d4
--- /dev/null
+++ b/app/channels/game_updates_channel.rb
@@ -0,0 +1,11 @@
+class GameUpdatesChannel < ActionCable::Channel::Base
+  def subscribed
+    game = Game.select(:id, :phase).find_by(code: params[:code]) if params[:code].is_a?(String)
+    if game && !game.ended?
+      # No answers or player data are broadcast, only a signal to refetch.
+      stream_for game
+    else
+      reject
+    end
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
