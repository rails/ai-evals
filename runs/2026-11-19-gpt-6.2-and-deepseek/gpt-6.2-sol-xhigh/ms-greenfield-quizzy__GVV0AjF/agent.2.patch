+  def test_importing_and_exporting_a_quiz
+    title = "Quiz transfer #{SecureRandom.hex(4)}"
+    document = {
+      "title" => title,
+      "questions" => [
+        { "text" => %q{Which means "Too Many Requests"?}, "active" => false, "options" => [
+          { "text" => "418" }, { "text" => "429", "correct" => true }
+        ] },
+        { "text" => "Which is less than 3?", "options" => [
+          { "text" => "1 < 3", "correct" => true }, { "text" => "5 & 6", "correct" => false }
+        ] }
+      ]
+    }
+
+    visit_moderation
+    @page.click_button("Import quiz", exact: true)
+    @page.fill_in("Quiz JSON", with: "{ broken")
+    @page.click_button("Import", exact: true)
+    assert_text @page, "Quiz JSON is not valid JSON."
+    assert_field @page, "Quiz JSON", with: "{ broken"
+
+    @page.fill_in("Quiz JSON", with: JSON.pretty_generate(document))
+    @page.click_button("Import", exact: true)
+    assert_selector @page, "h1", exact_text: title
+    assert_selector question(document["questions"][0]["text"]), :checkbox, "Active", checked: false
+    assert_selector question(document["questions"][1]["text"]), :checkbox, "Active", checked: true
+    assert_equal document["questions"].map { |entry| entry["text"] }, question_order
+    first_path = @page.current_path
+
+    @page.click_link("Export", exact: true)
+    assert_selector @page, "pre", count: 1
+    exported_json = @page.find("pre").evaluate_script("this.textContent")
+    document["questions"][0]["options"][0]["correct"] = false
+    document["questions"][1]["active"] = true
+    assert_equal document, JSON.parse(exported_json)
+
+    @page.visit("/moderate")
+    @page.click_button("Import quiz", exact: true)
+    @page.fill_in("Quiz JSON", with: exported_json)
+    @page.click_button("Import", exact: true)
+    assert_selector @page, "h1", exact_text: title
+    refute_equal first_path, @page.current_path
+
+    delete_quiz
+    assert_selector @page, ".quiz-list li", text: title, count: 1
+    @page.visit(first_path)
+    delete_quiz
+    assert_no_selector @page, ".quiz-list li", text: title
+  end
+
   private
 
+  def visit_moderation
+    @page = Capybara::Session.new(:quizzy_chromium)
+    @page.driver.browser.network.authorize(user: @username, password: @password) { |req| req.continue }
+    @page.visit("/moderate")
+  end
+
+  def delete_quiz
+    @page.click_link("Settings")
+    @page.accept_confirm { @page.click_button("Delete quiz") }
+    assert_selector @page, "h1", exact_text: "Quizzes"
+  end
+
   def request(path, user = nil, password = nil)
