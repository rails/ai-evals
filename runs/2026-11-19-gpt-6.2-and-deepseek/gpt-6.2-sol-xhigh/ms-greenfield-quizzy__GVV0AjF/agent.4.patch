diff --git a/app/models/game_leaderboard.rb b/app/models/game_leaderboard.rb
new file mode 100644
index 0000000..7bbbd63
--- /dev/null
+++ b/app/models/game_leaderboard.rb
@@ -0,0 +1,38 @@
+class GameLeaderboard
+  def self.build(game)
+    correct_options = game.rounds.map { |round| round.fetch("options").pluck("correct") }
+    scores = Hash.new { |hash, id| hash[id] = [0, 0] }
+    game.answers.pluck(:game_player_id, :question_index, :option_index, :elapsed_microseconds).each do |id, round, option, elapsed|
+      next unless correct_options.fetch(round).fetch(option)
+
+      score = scores[id]
+      score[0] += 1
+      # Games played before timing was introduced have no elapsed measurements.
+      score[1] += elapsed.to_i
+    end
+
+    game.players.pluck(:id, :name).sort_by do |id, _|
+      points, elapsed = scores[id]
+      [-points, elapsed, id]
+    end.map do |id, name|
+      { "id" => id, "name" => name, "points" => scores[id].first }
+    end
+  end
+
+  def initialize(entries)
+    @entries = entries
+  end
+
+  def winners(command, limit, random: SecureRandom)
+    return [] if command == "reset"
+
+    eligible = @entries.take_while { |entry| entry.fetch("points").positive? }
+    count = [limit, eligible.size].min
+    return eligible.first(count).pluck("id") if command == "top" || count == eligible.size
+
+    cutoff = eligible.fetch(count - 1).fetch("points")
+    guaranteed = eligible.take_while { |entry| entry.fetch("points") > cutoff }
+    tied = eligible.select { |entry| entry.fetch("points") == cutoff }
+    (guaranteed + tied.sample(count - guaranteed.size, random: random)).pluck("id")
+  end
+end
