+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    untimed = Game.create_for!(@quiz)
+    stream = GameUpdatesChannel.broadcasting_for(game)
+    phone = open_session
+    phone.post play_path(game.code), params: { name: "Ada" }, as: :json
+    refute moderator_state(game).key?("remaining_ms")
+    assert_nil game.reload.question_deadline_at
+
+    opened_at = Time.zone.local(2026, 7, 13, 12)
+    travel_to(opened_at) do
+      updates = capture_broadcasts(stream) do
+        assert_equal 90_000, advance(game, "start", 0).fetch("remaining_ms")
+      end
+      assert_equal "open", updates.sole.fetch("phase")
+      refute updates.sole.key?("remaining_ms")
+      assert_equal opened_at + 90, game.reload.question_deadline_at
+      refute advance(untimed, "start", 0).key?("remaining_ms")
+      phone.get play_state_path(game.code), as: :json
+      refute phone.response.parsed_body.key?("remaining_ms")
+      phone.get play_path(game.code)
+      refute_includes phone.response.body, "remaining_ms"
+    end
+
+    travel_to(opened_at + 89) do
+      assert_no_broadcasts(stream) { GameTimer.close_expired_rounds }
+      assert_equal 1000, moderator_state(game).fetch("remaining_ms")
+      assert_equal 200, answer(phone, game, 1, 0).status
+    end
+
+    travel_to(opened_at + 90) do
+      assert_equal 409, answer(phone, game, 1, 1).status # Still open in the DB, but the deadline has passed.
+      assert_broadcast_on(stream, version: 2) { GameTimer.close_expired_rounds }
+      assert_no_broadcasts(stream) { GameTimer.close_expired_rounds }
+      assert_equal "next", moderator_state(game).fetch("control")
+      refute moderator_state(game).key?("remaining_ms")
+      assert_predicate untimed.reload, :open?
+      assert_nil game.reload.question_deadline_at
+      assert_equal 0, game.answers.sole.option_index
+      phone.get play_state_path(game.code), as: :json
+      assert_equal "Correct!", phone.response.parsed_body.fetch("feedback")
+      advance(game, "finish", 1, status: :conflict)
+      assert_equal 90_000, advance(game, "next", 2).fetch("remaining_ms")
+      assert_equal opened_at + 180, game.reload.question_deadline_at
+    end
+  end
+
+  test "a manual finish and a new round supersede the old deadline" do
+    question("First timed question", 1)
+    question("Second timed question", 2)
+    @quiz.update!(timer_seconds: 5)
+    game = Game.create_for!(@quiz)
+    opened_at = Time.zone.local(2026, 7, 13, 12)
+    travel_to(opened_at) { advance(game, "start", 0) }
+    old_round = Game.find(game.id)
+    travel_to(opened_at + 1) do
+      refute advance(game, "finish", 1).key?("remaining_ms")
+      assert_nil game.reload.question_deadline_at
+      assert_equal 5000, advance(game, "next", 2).fetch("remaining_ms")
+    end
+    travel_to(opened_at + 5) do
+      refute old_round.close_expired_question!
+      GameTimer.close_expired_rounds
+      assert_equal "finish", moderator_state(game).fetch("control")
+      assert_equal 1000, moderator_state(game).fetch("remaining_ms")
+    end
+    travel_to(opened_at + 6) do
+      GameTimer.close_expired_rounds
+      assert_equal "end", moderator_state(game).fetch("control")
+      assert_equal 4, game.reload.lock_version
+    end
+  end
