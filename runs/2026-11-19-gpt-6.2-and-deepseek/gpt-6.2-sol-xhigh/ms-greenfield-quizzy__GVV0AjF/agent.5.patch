+class GameTimer
+  def self.close_expired_rounds
+    Game.open.where(question_deadline_at: ..Time.current).find_each do |game|
+      if game.close_expired_question!
+        # Like a manual Finish: notify both screens to read the closed state.
+        GameUpdatesChannel.broadcast_to(game, version: game.lock_version)
+      end
+    end
+  end
+end
