diff --git a/test/system/local_times_test.rb b/test/system/local_times_test.rb
new file mode 100644
index 0000000..f999d59
--- /dev/null
+++ b/test/system/local_times_test.rb
@@ -0,0 +1,103 @@
+require "application_system_test_case"
+
+class LocalTimesTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:kevin)
+    @card = cards(:logo)
+  end
+
+  test "comment times use the viewer's clock and calendar" do
+    comments(:logo_agreement_kevin).update_column :created_at, Time.utc(2025, 9, 13, 20, 42)
+    comments(:logo_agreement_jz).update_column :created_at, Time.utc(2025, 9, 13, 6, 30)
+    comments(:logo_5).update_column :created_at, Time.utc(2025, 9, 8, 17)
+    comments(:logo_3).update_column :created_at, Time.utc(2025, 9, 5, 17)
+    comments(:logo_1).update_column :created_at, Time.utc(2024, 12, 31, 23)
+
+    with_browser_clock("America/Los_Angeles", Time.utc(2025, 9, 13, 22, 42)) do
+      visit card_url(@card)
+
+      assert_comment_time :logo_agreement_kevin, "1:42 PM"
+      assert_comment_time :logo_agreement_jz, "yesterday"
+      click_on "Full history"
+      assert_comment_time :logo_5, "5 days ago"
+      assert_comment_time :logo_3, "Sep 5"
+      assert_comment_time :logo_1, "Dec 31, 2024"
+
+      set_browser_timezone "Asia/Tokyo"
+      visit card_url(@card)
+
+      assert_comment_time :logo_agreement_kevin, "5:42 AM"
+    end
+  end
+
+  test "auto-postpone times use local days across a daylight saving transition" do
+    # 11:42 PM Saturday in New York. The deadline is only a few hours away, but is on Sunday.
+    now = Time.utc(2025, 3, 9, 4, 42)
+    @card.update_column :last_active_at, Time.utc(2025, 3, 9, 8) - @card.auto_postpone_period
+
+    with_browser_clock("America/New_York", now) do
+      visit card_url(@card)
+      assert_selector ".card-perma__closure-message", text: "Moves to “Not Now” tomorrow if there’s no activity."
+
+      # Local midnight on Tuesday, less than 48 hours later because the clocks moved forward.
+      @card.update_column :last_active_at, Time.utc(2025, 3, 11, 4) - @card.auto_postpone_period
+      visit card_url(@card)
+      assert_selector ".card-perma__closure-message", text: "Moves to “Not Now” in 3 days if there’s no activity."
+    end
+  end
+
+  test "activity headings keep their calendar date while event times use the local clock" do
+    events(:layout_assignment_jz).update_column :created_at, Time.utc(2025, 3, 8, 13)
+
+    with_browser_clock("America/New_York", Time.utc(2025, 3, 8, 17)) do
+      visit events_url(day: "2025-03-08")
+
+      assert_selector ".events__column-header time[datetime='2025-03-08']", text: "SATURDAY, MARCH 8"
+      assert_selector ".event__timestamp", text: "8:00 AM"
+    end
+  end
+
+  test "Turbo morphs re-render a timestamp that stays in the page" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update_column :created_at, Time.utc(2025, 9, 13, 20, 42)
+
+    with_browser_clock("America/Los_Angeles", Time.utc(2025, 9, 13, 22, 42)) do
+      visit card_url(@card)
+      assert_comment_time :logo_agreement_kevin, "1:42 PM"
+
+      page.execute_script "Turbo.renderStreamMessage(arguments[0])", <<~HTML
+        <turbo-stream action="update" method="morph" targets="##{dom_id(comment)} .comment__permalink-title">
+          <template>#{ApplicationController.helpers.local_time_tag(Time.utc(2025, 9, 13, 6, 30))}</template>
+        </turbo-stream>
+      HTML
+
+      assert_comment_time :logo_agreement_kevin, "yesterday"
+    end
+  end
+
+  private
+    def assert_comment_time(comment, text)
+      assert_selector "##{dom_id(comments(comment))} .comment__permalink-title time", exact_text: text
+    end
+
+    def with_browser_clock(timezone, time)
+      set_browser_timezone timezone
+      script = page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: <<~JS)
+        const now = #{time.to_i * 1000};
+        Date = class extends Date {
+          constructor(...args) { super(...(args.length ? args : [now])); }
+          static now() { return now; }
+        };
+      JS
+      yield
+    ensure
+      page.driver.browser.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: script.fetch("identifier")) if script
+      set_browser_timezone ""
+    end
+
+    def set_browser_timezone(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+    end
+end
