diff --git a/test/integration/localization_test.rb b/test/integration/localization_test.rb
new file mode 100644
index 0000000..a062f99
--- /dev/null
+++ b/test/integration/localization_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "an anonymous language choice survives navigation and unsupported choices" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_select "html[lang=en] h1", text: "Get into Fizzy"
+
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang=ja] h1", text: "Fizzy にログイン"
+      assert_select "a.header__skip-navigation", text: "メインコンテンツに移動"
+      assert_select "input[type=email][placeholder='メールアドレスを入力…']"
+
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_select "html[lang=ja]"
+
+      get new_session_path(locale: { unexpected: "ja" })
+      assert_response :success
+      assert_select "html[lang=ja]"
+    end
+  end
+
+  test "a signed-in language choice follows the identity to a new browser" do
+    sign_in_as :kevin
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_equal I18n.default_locale, I18n.locale
+
+    reset!
+    sign_in_as :kevin
+    get root_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+
+    get root_path(locale: "xx")
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    get root_path(locale: "en")
+    assert_select "html[lang=en]"
+    assert_equal "en", identities(:kevin).reload.locale
+  end
+
+  test "a language chosen before sign-in is saved only after verification" do
+    identity = identities(:kevin)
+
+    untenanted do
+      get new_session_path(locale: "ja")
+      perform_enqueued_jobs(only: ActionMailer::MailDeliveryJob) do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      assert_nil identity.reload.locale
+      assert_match "Fizzy の認証コード", ActionMailer::Base.deliveries.last.subject
+
+      get session_magic_link_path
+      assert_select "html[lang=ja]"
+      assert_match "間有効です", response.body
+
+      post session_magic_link_path, params: { code: identity.magic_links.order(:id).last.code }
+      assert_response :redirect
+      assert_equal "ja", identity.reload.locale
+    end
+  end
+
+  test "conditional responses and cached card content vary by language" do
+    sign_in_as :kevin
+
+    with_actionview_partial_caching do
+      get root_path
+      etag = response.headers.fetch("ETag")
+      get root_path(locale: "ja"), headers: { "If-None-Match" => etag }
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_not_equal etag, response.headers.fetch("ETag")
+
+      get card_path(cards(:logo), locale: "en")
+      assert_select ".for-screen-reader", text: "Card number"
+      get card_path(cards(:logo), locale: "ja")
+      assert_response :success
+      assert_select ".for-screen-reader", text: "カード番号"
+      assert_select ".translation_missing", count: 0
+    end
+  end
+
+  test "system activity is rendered in the viewer's language" do
+    sign_in_as :kevin
+    card = cards(:logo)
+    card.close(user: users(:kevin))
+
+    get card_path(card, locale: "ja")
+    assert_response :success
+    assert_select ".comment-by-system .comment__body", text: /「完了」に移動/
+
+    get card_path(card, locale: "en")
+    assert_select ".comment-by-system .comment__body", text: /Moved to “Done”/
+  end
+
+  test "the web app manifest uses the browser's language" do
+    untenanted do
+      get pwa_manifest_path(format: :json, locale: "ja")
+      assert_response :success
+      assert_equal "通知", response.parsed_body.fetch("shortcuts").first.fetch("name")
+
+      get pwa_manifest_path(format: :json, locale: "en")
+      assert_response :success
+      assert_equal "Notifications", response.parsed_body.fetch("shortcuts").first.fetch("name")
+    end
+  end
+
+  test "public error pages include English and Japanese without a session" do
+    %w[400 404 406-unsupported-browser 422 500].each do |page|
+      html = Nokogiri::HTML5(File.read(Rails.public_path.join("#{page}.html")))
+      assert_equal "en", html.at_css("html")["lang"]
+      assert html.at_css("h2[lang=ja]")
+      assert html.at_css("a [lang=ja]")
+    end
+  end
+end
diff --git a/test/mailers/localized_mailers_test.rb b/test/mailers/localized_mailers_test.rb
new file mode 100644
index 0000000..c7e0d6d
--- /dev/null
+++ b/test/mailers/localized_mailers_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class LocalizedMailersTest < ActionMailer::TestCase
+  setup do
+    @user = users(:david)
+    @identity = @user.identity
+    @identity.update!(locale: "ja")
+  end
+
+  test "magic-link subject, HTML and text use the saved language outside a request" do
+    link = @identity.magic_links.create!
+    email = MagicLinkMailer.sign_in_instructions(link).message
+
+    assert_equal "Fizzy の認証コードは #{link.code} です", email.subject
+    assert_localized_parts email, "分間有効です", link.code
+  end
+
+  test "an English recipient does not inherit the job locale" do
+    link = identities(:kevin).magic_links.create!
+
+    I18n.with_locale(:ja) do
+      email = MagicLinkMailer.sign_in_instructions(link).message
+      assert_equal "Your Fizzy code is #{link.code}", email.subject
+      assert_includes email.text_part.decoded, "Please enter this 6-character verification code"
+      assert_equal :ja, I18n.locale
+    end
+  end
+
+  test "cancellation and export messages are localized in both formats" do
+    export = Account::Export.create!(account: Current.account, user: @user)
+    email = ExportMailer.completed(export).message
+    assert_match "エクスポート", email.subject
+    assert_localized_parts email, "ダウンロード", "/exports/#{export.id}"
+
+    Current.account.cancel(initiated_by: @user)
+    email = AccountMailer.cancellation(Current.account.cancellation).message
+    assert_match "削除されました", email.subject
+    assert_localized_parts email, "削除されます", "support@fizzy.do"
+  end
+
+  test "import success and failure messages are localized in both formats" do
+    email = ImportMailer.completed(@identity, Current.account).message
+    assert_match "インポートが完了しました", email.subject
+    assert_localized_parts email, "インポートが完了しました", Current.account.slug
+
+    import = Account::Import.create!(account: Current.account, identity: @identity, status: :failed, failure_reason: :conflict)
+    email = ImportMailer.failed(import).message
+    assert_match "インポートに失敗しました", email.subject
+    assert_localized_parts email, "既に存在", "support@fizzy.do"
+  end
+
+  test "email-address confirmation uses the identity's language" do
+    email = UserMailer.email_change_confirmation(email_address: "new@example.test", token: "confirmation-token", user: @user).message
+    assert_equal "新しいメールアドレスをご確認ください", email.subject
+    assert_includes email.body.decoded, "メールアドレスの変更を確認"
+    assert_includes email.body.decoded, "confirmation-token"
+  end
+
+  test "notification bundles localize dates and notification descriptions" do
+    @user.notifications.destroy_all
+    bundle = Notification::Bundle.create!(user: @user, starts_at: Time.utc(2026, 1, 2, 13), ends_at: 1.hour.from_now)
+    card = cards(:logo)
+    event = Event.create!(eventable: card, board: card.board, action: "card_published", creator: users(:kevin))
+    @user.notifications.create!(source: event, creator: users(:kevin), card: card)
+
+    email = Notification::BundleMailer.notification(bundle).message
+    assert_match "新着通知", email.subject
+    assert_localized_parts email, "1月2日（金曜日） 13:00以降の通知", "担当者：自分"
+  end
+
+  private
+    def assert_localized_parts(email, *phrases)
+      assert_equal "ja", email["Content-Language"].to_s
+      assert_includes email.html_part.decoded, '<html lang="ja">'
+      [ email.html_part, email.text_part ].each do |part|
+        phrases.each { |phrase| assert_includes part.decoded, phrase }
+        assert_not_includes part.decoded, "translation missing"
+      end
+    end
+end
