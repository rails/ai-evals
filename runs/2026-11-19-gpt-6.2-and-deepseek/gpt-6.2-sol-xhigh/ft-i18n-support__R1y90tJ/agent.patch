diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..9d27e6e
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,35 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :use_current_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def use_current_locale(&action)
+      # Resolve the signed-in identity before authentication callbacks can redirect away from the query.
+      identity = find_session_by_cookie&.identity
+      if locale = offered_locale(request.query_parameters["locale"])
+        if identity
+          identity.update!(locale: locale) if identity.locale != locale
+        else
+          session[:locale] = locale
+        end
+      end
+
+      I18n.with_locale(identity&.preferred_locale || offered_locale(session[:locale]) || I18n.default_locale, &action)
+    end
+
+    def offered_locale(value)
+      value if value.is_a?(String) && I18n.available_locales.map(&:to_s).include?(value)
+    end
+
+    def apply_locale_after_sign_in(identity)
+      if locale = offered_locale(session[:locale])
+        session.delete(:locale)
+        identity.update!(locale: locale) if identity.locale != locale
+      end
+      I18n.locale = identity.preferred_locale
+    end
+end
