+require "application_system_test_case"
+
+class LocalizationSystemTest < ApplicationSystemTestCase
+  test "JavaScript formats dates and tooltips using the selected language" do
+    sign_in_as users(:kevin)
+
+    visit card_url(cards(:logo), locale: "ja")
+    assert_selector "html[lang=ja]"
+    assert_selector "time[data-local-time-target='daysago'][title]", text: /日前|今日|昨日/
+    assert_selector "time[title*='/']"
