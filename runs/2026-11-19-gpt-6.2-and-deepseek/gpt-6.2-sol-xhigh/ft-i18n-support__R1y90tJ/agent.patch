diff --git a/app/javascript/helpers/locale_helpers.js b/app/javascript/helpers/locale_helpers.js
new file mode 100644
index 0000000..2d97475
--- /dev/null
+++ b/app/javascript/helpers/locale_helpers.js
@@ -0,0 +1,22 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+export function locale() {
+  return document.documentElement.lang || "en"
+}
+
+let cachedContent, messages
+
+export function translate(key, values = {}, count) {
+  const content = getMetaContent("fizzy-messages")
+  if (content !== cachedContent) {
+    cachedContent = content
+    messages = JSON.parse(content || "{}")
+  }
+
+  let message = key.split(".").reduce((section, part) => section?.[part], messages)
+  if (count !== undefined) {
+    const category = new Intl.PluralRules(locale()).select(count)
+    message = message[category] ?? message.other
+  }
+  return typeof message === "string" ? message.replace(/%\{(\w+)\}/g, (_, name) => values[name]) : message
+}
