diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..9b0b6b3
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "create and list a reaction as JSON" do
+    content = "👍" * 16
+
+    assert_difference -> { @comment.reactions.count }, 1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: content, reacter_id: users(:jz).id } }, as: :json
+    end
+    assert_response :created
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+    assert_response :success
+    reaction = @response.parsed_body.sole
+    assert_equal @comment.reactions.sole.id, reaction["id"]
+    assert_equal content, reaction["content"]
+    assert_equal users(:kevin).id, reaction.dig("reacter", "id")
+  end
+
+  test "reject blank or oversized reactions" do
+    [ "", "   ", "👍" * 17 ].each do |content|
+      assert_no_difference -> { @comment.reactions.count } do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: content } }, as: :json
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "cannot react to a comment through another card" do
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(cards(:layout), @comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+    assert_response :not_found
+  end
+
+  test "cannot react to a comment on a card without access" do
+    accesses(:writebook_kevin).destroy!
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+    assert_response :not_found
+  end
+
+  test "only the reacter can remove a reaction" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:jz))
+    path = card_comment_reaction_path(@card, @comment, reaction)
+
+    assert_no_difference "Reaction.count" do
+      delete path, as: :json
+    end
+    assert_response :forbidden
+
+    sign_out
+    sign_in_as :jz
+    assert_difference "Reaction.count", -1 do
+      delete path, as: :json
+    end
+    assert_response :no_content
+  end
+
+  test "cannot remove a reaction through another comment" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@card, comments(:logo_agreement_kevin), reaction), as: :json
+    end
+    assert_response :not_found
+  end
+end
