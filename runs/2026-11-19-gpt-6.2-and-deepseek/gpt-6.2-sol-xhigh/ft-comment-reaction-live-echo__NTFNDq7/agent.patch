+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,93 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @comment = comments(:logo_agreement_jz)
+    sign_in_as(users(:kevin))
+    visit card_url(@comment.card)
+  end
+
+  test "add, cancel, and remove your reactions" do
+    within "##{dom_id(@comment)}" do
+      assert_no_field "Reaction"
+      click_on "Add a reaction"
+      assert_no_button "Add a reaction"
+      fill_in "Reaction", with: "Discard me"
+      click_on "Cancel reaction"
+      assert_no_field "Reaction"
+      assert_no_text "Discard me"
+
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "👍"
+      click_on "Post reaction"
+      assert_selector ".reactions__list .reaction", text: "👍"
+      assert_no_field "Reaction"
+
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "Looks good"
+      click_on "Post reaction"
+      assert_selector ".reactions__list .reaction", text: "Looks good"
+      assert_button "Add a reaction"
+
+      assert_no_button "Remove reaction"
+      find("summary", text: "👍").click
+      click_on "Remove reaction"
+      assert_no_selector ".reactions__list .reaction", text: "👍"
+      assert_selector ".reactions__list .reaction", text: "Looks good"
+    end
+
