@@ -0,0 +1,25 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  after_create_commit :broadcast_creation
+  after_destroy_commit :broadcast_removal, unless: :destroyed_by_association
+
+  def to_partial_path
+    "cards/comments/#{super}"
+  end
+
+  private
+    def broadcast_creation
+      broadcast_append_to comment.card, target: [ comment, :reactions ]
+    end
+
+    def broadcast_removal
+      broadcast_remove_to comment.card
+    end
+end
