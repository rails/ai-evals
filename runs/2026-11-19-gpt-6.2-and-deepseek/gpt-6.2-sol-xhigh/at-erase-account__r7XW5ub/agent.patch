diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..a855015
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "erases sessions, sign-in events, accesses, and reading marks" do
+    user = users(:kevin)
+    user.sessions.start!(user_agent: "Browser", ip_address: "192.0.2.1").destroy!
+    active_session = user.sessions.start!(user_agent: "Browser", ip_address: "192.0.2.1")
+    ReadingMark.remember leaves(:welcome_page), user: user
+    other_session = users(:jz).sessions.start!(user_agent: "Browser", ip_address: "192.0.2.2")
+
+    user.destroy!
+
+    assert_not User.exists?(user.id)
+    assert_not Session.exists?(active_session.id)
+    active_session.destroy! # A sign-out that loaded the session before erasure.
+    assert_not SignInEvent.for_address(user.email_address).exists?
+    assert_not Access.exists?(user_id: user.id)
+    assert_not ReadingMark.exists?(user_id: user.id)
+    assert Session.exists?(other_session.id)
+    assert SignInEvent.for_address(users(:jz).email_address).exists?
+  end
+
+  test "erases sign-in events under both the original and rewritten email addresses" do
+    user = users(:kevin)
+    original_address = user.email_address
+    rewritten_address = "kevin-deactivated-52bf8c33-4685-41f4-9f56-a5d1203ebf2a@example.com"
+    SignInEvent.create!(email_address: original_address, action: :signed_in)
+    user.update!(active: false, email_address: rewritten_address)
+    SignInEvent.create!(email_address: rewritten_address, action: :signed_out)
+    unrelated = SignInEvent.create!(email_address: "kevin@example.net", action: :signed_in)
+
+    user.destroy!
+
+    assert_not SignInEvent.for_address(original_address).exists?
+    assert_not SignInEvent.for_address(rewritten_address).exists?
+    assert SignInEvent.exists?(unrelated.id)
+  end
+
+  test "does not undo the legacy rewrite for an active user's email" do
+    user = users(:kevin)
+    original_address = user.email_address
+    user.update!(email_address: "kevin-deactivated-52bf8c33-4685-41f4-9f56-a5d1203ebf2a@example.com")
+    event = SignInEvent.create!(email_address: original_address, action: :signed_in)
+
+    user.destroy!
+
+    assert SignInEvent.exists?(event.id)
+  end
+
+  test "erasing a deactivated account preserves newer sign-ins under a reused address" do
+    user = users(:kevin)
+    original_address = user.email_address
+    first_event = SignInEvent.create!(email_address: original_address, action: :signed_in)
+    user.update!(active: false, email_address: "kevin-deactivated-52bf8c33-4685-41f4-9f56-a5d1203ebf2a@example.com")
+
+    travel 1.day do
+      new_user = User.create!(name: "New Kevin", email_address: original_address, password: "secret123456")
+      new_user.sessions.start!(user_agent: "Browser", ip_address: "192.0.2.1")
+
+      user.destroy!
+
+      assert_not SignInEvent.exists?(first_event.id)
+      assert_equal 1, SignInEvent.for_address(original_address).count
+    end
+  end
+
+  test "preserves shared books and erases private books and their contents" do
+    user = users(:kevin)
+    shared_book = books(:manual)
+    shared_book.update!(creator: user, author: user.name, everyone_access: true)
+    shared_leaf = leaves(:summary_page)
+    shared_leaf.update!(book: shared_book)
+    other_reader = users(:jz)
+    shared_mark = ReadingMark.remember shared_leaf, user: other_reader
+    shared_book.cover.attach pictures(:reading).image.blob
+
+    private_book = books(:handbook)
+    private_book.update!(creator: user, author: user.name, everyone_access: false)
+    page = leaves(:welcome_page)
+    page.page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp"
+    revision_upload = page.page.body.uploads.first
+    page.edit leafable_params: { body: "erasuresentinel" }
+    page.trashed!
+    ReadingMark.remember page, user: other_reader
+    Leaf.reindex_all
+
+    assert_includes Leaf.search("erasuresentinel"), page
+    assert_includes Leaf.search(shared_leaf.title), shared_leaf
+    private_leaves = private_book.leaves.to_a
+    private_leafables = private_leaves.map(&:leafable) + page.edits.map(&:leafable)
+    user.created_books.load # Erasure should not destroy shared books even when this association is loaded.
+
+    perform_enqueued_jobs { user.destroy! }
+
+    assert_not Book.exists?(private_book.id)
+    private_leaves.each do |leaf|
+      assert_not Leaf.exists?(leaf.id)
+      assert_not Edit.exists?(leaf_id: leaf.id)
+      assert_not ReadingMark.exists?(leaf_id: leaf.id)
+      assert_nil Leaf.lease_connection.select_value("SELECT rowid FROM leaf_search_index WHERE rowid = #{leaf.id}")
+    end
+    private_leafables.each { |record| assert_not record.class.exists?(record.id) }
+    assert_not ActionText::Markdown.exists?(record_type: "Page", record_id: private_leafables.grep(Page).map(&:id))
+    assert_not ActiveStorage::Attachment.exists?(revision_upload.id)
+    assert_not ActiveStorage::Blob.exists?(revision_upload.blob_id)
+    assert_not revision_upload.blob.service.exist?(revision_upload.blob.key)
+
+    assert_nil shared_book.reload.creator_id
+    assert_equal "Deleted author", shared_book.author
+    assert shared_book.accessable?(user: other_reader)
+    assert shared_book.cover.attached?
+    assert ReadingMark.exists?(shared_mark.id)
+    assert_includes Leaf.search(shared_leaf.title), shared_leaf
+  end
+end
