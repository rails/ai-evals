@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  teardown do
+    users(:jz).notification_bundles.destroy_all
+  end
+
+  test "simultaneous first arrivals open only one window" do
+    user = users(:jz)
+    user.settings.update!(bundle_email_frequency: :daily)
+    gate = Concurrent::CyclicBarrier.new(2)
+
+    assert_enqueued_jobs 1, only: Notification::BundleDeliveryJob do
+      threads = [ events(:layout_assignment_jz), events(:logo_assignment_jz) ].map do |event|
+        Thread.new do
+          Rails.application.executor.wrap do
+            raise "Timed out waiting for concurrent arrival" unless gate.wait(5)
+            event.notify_recipients
+          end
+        end
+      end
+      threads.each(&:value)
+    end
+
+    assert_equal 2, user.notification_bundles.sole.entries.count
+  end
+end
