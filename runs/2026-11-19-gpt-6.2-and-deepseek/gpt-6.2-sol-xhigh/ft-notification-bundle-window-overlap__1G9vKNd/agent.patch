diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..13685a5
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,56 @@
+class Notification::Bundle < ApplicationRecord
+  INTERVALS = { "every_few_hours" => 4.hours, "daily" => 24.hours, "weekly" => 168.hours }.freeze
+
+  belongs_to :user
+  has_many :entries, dependent: :delete_all
+
+  after_create_commit :deliver_later
+
+  def self.add(notification)
+    user = notification.user
+    return unless INTERVALS.key?(User::Settings.where(user: user).pick(:bundle_email_frequency))
+
+    # Serialize window selection and creation on the recipient, even when they have no bundle yet.
+    user.with_lock do
+      if interval = INTERVALS[user.settings&.bundle_email_frequency]
+        # Use arrival time, not the source's timestamp: old events can arrive out of order.
+        now = Time.current
+        bundle = user.notification_bundles.where("ends_at > ?", now).order(ends_at: :desc).first ||
+          user.notification_bundles.create!(starts_at: now, ends_at: now + interval)
+
+        bundle.entries.create!(notification: notification, source: notification.source)
+      end
+    end
+  end
+
+  def deliver
+    return if ends_at.future?
+
+    # Wait for any notification that was added just before the cutoff to commit.
+    payloads = user.with_lock do
+      entries_for_delivery.filter_map(&:payload) if emailable?
+    end
+
+    NotificationMailer.digest(user, payloads).deliver_now if payloads.present?
+
+    destroy!
+  end
+
+  private
+    def deliver_later
+      Current.with_account(user.account) do
+        Notification::BundleDeliveryJob.set(wait_until: ends_at).perform_later(self)
+      end
+    end
+
+    def emailable?
+      user.active? && user.identity.present? && INTERVALS.key?(user.settings&.bundle_email_frequency) && user.account.active?
+    end
+
+    def entries_for_delivery
+      entries.joins(:notification)
+        .where(notifications: { user_id: user.id, card_id: user.accessible_cards.select(:id) })
+        .preload(:source, notification: [ :card, :account ])
+        .order(:id)
+    end
+end
