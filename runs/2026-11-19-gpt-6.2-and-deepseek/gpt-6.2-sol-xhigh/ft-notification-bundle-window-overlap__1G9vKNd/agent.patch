+require "test_helper"
+
+class Account::DataTransfer::UserSettingsRecordSetTest < ActiveSupport::TestCase
+  test "imports settings exported before digests existed" do
+    data = user_settings(:david_settings).attributes.except("bundle_email_frequency").merge(
+      "id" => ActiveRecord::Type::Uuid.generate,
+      "account_id" => ActiveRecord::Type::Uuid.generate,
+      "user_id" => ActiveRecord::Type::Uuid.generate
+    )
+
+    Tempfile.create([ "user_settings", ".zip" ], binmode: true) do |file|
+      writer = ZipFile::Writer.new(file)
+      writer.add_file("data/user_settings/#{data.fetch('id')}.json", data.to_json)
+      writer.close
+      file.rewind
+
+      reader = ZipFile::Reader.new(file)
+      record_set = Account::DataTransfer::UserSettingsRecordSet.new(Current.account)
+      record_set.check(from: reader)
+      record_set.import(from: reader)
+
+      assert_equal "never", User::Settings.find(data.fetch("id")).bundle_email_frequency
+    end
+  end
+end
