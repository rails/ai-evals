diff --git a/test/integration/notification_email_digests_test.rb b/test/integration/notification_email_digests_test.rb
new file mode 100644
index 0000000..ada5f99
--- /dev/null
+++ b/test/integration/notification_email_digests_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class NotificationEmailDigestsTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:jz)
+  end
+
+  test "batches arrivals, including an older event that lands late, into one email" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    first_event = events(:layout_assignment_jz)
+    late_event = events(:logo_assignment_jz)
+    assert_operator late_event.created_at, :<, first_event.created_at
+
+    freeze_time do
+      closes_at = 4.hours.from_now
+      first_event.notify_recipients
+      travel 3.hours
+      late_event.notify_recipients
+
+      assert_enqueued_jobs 1, only: Notification::BundleDeliveryJob
+      assert_no_emails { deliver_due_digests }
+
+      travel_to closes_at
+      email = capture_emails { deliver_due_digests }.sole
+      assert_equal [ @user.identity.email_address ], email.to
+      assert_includes email.text_part.body.decoded, card_path_for(:layout)
+      assert_includes email.text_part.body.decoded, card_path_for(:logo)
+      assert_includes email.html_part.body.decoded, "#{@user.account.slug}/notifications/settings"
+      assert_empty @user.notification_bundles.reload
+    end
+  end
+
+  test "users can choose independent daily and weekly windows" do
+    daily_user = @user
+    weekly_user = users(:david)
+    daily_user.settings.update!(bundle_email_frequency: :daily)
+    weekly_user.settings.update!(bundle_email_frequency: :weekly)
+
+    freeze_time do
+      now = Time.current
+      create_notification(daily_user, events(:layout_commented))
+      travel 2.hours
+      create_notification(weekly_user, events(:layout_commented))
+
+      assert_equal now + 1.day, daily_user.notification_bundles.sole.ends_at
+      assert_equal now + 2.hours + 1.week, weekly_user.notification_bundles.sole.ends_at
+      travel_to now + 1.day
+      assert_equal [ daily_user.identity.email_address ], capture_emails { deliver_due_digests }.sole.to
+      travel_to now + 2.hours + 1.week
+      assert_equal [ weekly_user.identity.email_address ], capture_emails { deliver_due_digests }.sole.to
+    end
+  end
+
+  test "a notification at the cutoff starts a new window even if the old email has not been sent" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    freeze_time do
+      # The same in-app notification is updated by both events.
+      notification = create_notification(@user, events(:layout_commented))
+      first_window = @user.notification_bundles.sole
+      @user.settings.update!(bundle_email_frequency: :daily)
+
+      travel_to first_window.ends_at - 1.second
+      notification.read
+      assert_equal 1, first_window.entries.count
+      assert_equal first_window.starts_at + 4.hours, first_window.reload.ends_at
+
+      travel_to first_window.ends_at
+      events(:layout_assignment_jz).notify_recipients
+      assert_equal 1, @user.notifications.count
+      first, second = @user.notification_bundles.order(:starts_at)
+      assert_equal first.ends_at, second.starts_at
+      assert_equal second.starts_at + 1.day, second.ends_at
+
+      first_email = capture_emails { deliver_due_digests }.sole
+      assert_includes first_email.text_part.body.decoded, "RE: #{cards(:layout).title}"
+      assert_not_includes first_email.text_part.body.decoded, "Assigned to you"
+
+      travel_to second.ends_at
+      second_email = capture_emails { deliver_due_digests }.sole
+      assert_includes second_email.text_part.body.decoded, "Assigned to you"
+      assert_not_includes second_email.text_part.body.decoded, "RE: #{cards(:layout).title}"
+    end
+  end
+
+  test "disabling digests suppresses pending delivery and does not start new windows" do
+    assert_no_enqueued_jobs only: Notification::BundleDeliveryJob do
+      create_notification(@user, events(:layout_commented))
+    end
+    assert_empty @user.notification_bundles.reload
+
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    freeze_time do
+      create_notification(@user, events(:logo_assignment_jz))
+      @user.settings.update!(bundle_email_frequency: :never)
+      travel 4.hours
+
+      assert_no_emails { deliver_due_digests }
+      assert_empty @user.notification_bundles.reload
+    end
+  end
+
+  test "a digest skips inaccessible and deleted notifications without sending an empty email" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    freeze_time do
+      create_notification(@user, events(:layout_commented)).destroy!
+      create_notification(@user, events(:logo_assignment_jz))
+      boards(:writebook).access_for(@user).delete
+      travel 4.hours
+
+      assert_no_emails { deliver_due_digests }
+      assert_empty @user.notification_bundles.reload
+    end
+  end
+
+  private
+    def create_notification(user, event)
+      user.notifications.create!(source: event, creator: event.creator)
+    end
+
+    def deliver_due_digests
+      perform_enqueued_jobs only: Notification::BundleDeliveryJob, at: Time.current
+    end
+
+    def card_path_for(card)
+      "#{@user.account.slug}/cards/#{cards(card).number}"
+    end
+end
