diff --git a/test/system/board_drag_and_drop_test.rb b/test/system/board_drag_and_drop_test.rb
new file mode 100644
index 0000000..4156ede
--- /dev/null
+++ b/test/system/board_drag_and_drop_test.rb
@@ -0,0 +1,210 @@
+require "application_system_test_case"
+
+class BoardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+    visit board_url(@board)
+  end
+
+  test "dropping a card moves it before the save completes" do
+    destination = columns(:writebook_in_progress)
+    column = "##{dom_id(destination)}"
+    find("#{column} .cards__expander").click
+    assert_selector "#{column} #{card_selector(cards(:text))}"
+    hold_card_saves
+
+    page.execute_script("window.movedCard = arguments[0]", find(card_selector))
+    start_drag
+    assert_selector "#{card_selector}.drag-and-drop__dragged-item"
+    drag_event "dragover", "#{column} #{card_selector(cards(:text))}"
+    assert_selector "#{column}.drag-and-drop__hover-container"
+    drag_event "drop", "#{column} #{card_selector(cards(:text))}"
+
+    assert_selector "#{column} #{card_selector}"
+    assert_no_selector "#maybe #{card_selector}", visible: :all
+    assert_no_selector ".drag-and-drop__hover-container, .drag-and-drop__dragged-item"
+    assert_nil @card.reload.column
+    assert_equal [ dom_id(@card, :article), dom_id(cards(:text), :article) ], card_order(column)
+
+    release_card_save
+
+    assert_equal destination, @card.reload.column
+    assert page.evaluate_script("window.moveRequests[0].requestId"), "The save should carry Turbo's refresh-suppression request ID"
+    assert page.evaluate_script("window.movedCard === arguments[0]", find(card_selector))
+    assert_equal [ dom_id(@card, :article), dom_id(cards(:text), :article) ], card_order(column)
+  end
+
+  test "moves a card with the pointer into an empty collapsed column" do
+    destination = columns(:writebook_on_hold)
+    column = "##{dom_id(destination)}"
+    assert_selector "#{column} turbo-frame[complete] .cards__list", visible: :all
+    card = find("#{card_selector}[draggable=true]")
+    card.drag_to find("#{column} .cards__expander")
+
+    assert_selector "#{column} #{card_selector}", visible: :all
+    find("#{column} .cards__expander").click
+    assert_selector "#{column} #{card_selector} .card__column-name--current:not([hidden])", visible: :all, text: destination.name
+    assert_current_path board_path(@board)
+  end
+
+  test "drops change status and persist after revisiting the board" do
+    assert_selector "#not-now turbo-frame[complete] .cards__list", visible: :all
+    assert_selector "#closed-cards turbo-frame[complete] .cards__list", visible: :all
+
+    drop_and_save "#not-now"
+    assert_selector "#not-now #{card_selector}.card--postponed", visible: :all
+    assert @card.reload.postponed?
+
+    find("#not-now .cards__expander").click
+    drop_and_save "#closed-cards"
+    assert_selector "#closed-cards #{card_selector}:not(.card--postponed)", visible: :all
+    assert @card.reload.closed?
+    assert_equal [ @card, cards(:shipping) ].map { |card| dom_id(card, :article) }, card_order("#closed-cards")
+
+    find("#closed-cards .cards__expander").click
+    drop_and_save "#maybe"
+    assert_selector "#maybe #{card_selector}.card--active"
+    assert @card.reload.awaiting_triage?
+
+    visit board_url(@board)
+    assert_selector "#maybe #{card_selector}"
+  end
+
+  test "the destination keeps golden cards first regardless of where the pointer drops" do
+    golden = cards(:text)
+    golden.gild
+    Current.user = users(:david)
+    regular = @board.cards.create!(title: "Another card", status: :published, column: golden.column, creator: users(:david))
+    column = "##{dom_id(golden.column)}"
+    visit board_url(@board)
+    find("#{column} .cards__expander").click
+    assert_selector "#{column} #{card_selector(golden)}.golden-effect"
+
+    drop_and_save "#{column} #{card_selector(golden)}"
+    expected_order = [ golden, @card, regular ].map { |card| dom_id(card, :article) }
+    assert_equal expected_order, card_order(column)
+
+    visit board_url(@board)
+    assert_selector "#{column} #{card_selector}", visible: :all
+    assert_equal expected_order, card_order(column)
+  end
+
+  test "same-column drops and canceled drags leave the board unchanged" do
+    column = "##{dom_id(columns(:writebook_triage))}"
+    find("#{column} .cards__expander").click
+    card = cards(:logo)
+    assert_selector "#{column} #{card_selector(card)}[draggable=true]"
+    original_order = card_order(column)
+    hold_card_saves
+
+    start_drag card
+    drag_event "dragover", "#{column} #{card_selector(cards(:layout))}"
+    assert_no_selector ".drag-and-drop__hover-container"
+    drag_event "drop", "#{column} #{card_selector(cards(:layout))}"
+    assert_equal original_order, card_order(column)
+
+    start_drag card
+    drag_event "dragenter", "#maybe .cards__header"
+    assert_selector "#maybe.drag-and-drop__hover-container"
+    drag_event "dragleave", "#maybe .cards__header", related: "#maybe .cards__list"
+    assert_selector "#maybe.drag-and-drop__hover-container"
+    drag_event "dragend", card_selector(card)
+
+    assert_no_selector ".drag-and-drop__hover-container, .drag-and-drop__dragged-item"
+    assert_equal original_order, card_order(column)
+    assert_empty performed_move_requests
+  end
+
+  test "standalone column cards are not draggable" do
+    column = columns(:writebook_triage)
+    visit board_column_url(@board, column)
+
+    assert_selector card_selector(cards(:logo))
+    assert_no_selector "#{card_selector(cards(:logo))}[draggable=true]"
+  end
+
+  test "a failed save restores the card, counts, and empty state" do
+    column = "##{dom_id(columns(:writebook_on_hold))}"
+    find("#{column} .cards__expander").click
+    assert_selector "#{column} .blank-slate--drag"
+    hold_card_saves(fail: true)
+
+    start_drag
+    drag_event "drop", "#{column} .blank-slate--drag"
+    assert_selector "#{column} #{card_selector}"
+    assert_no_selector "#{column} .blank-slate--drag"
+    assert_selector "#{column} [data-card-count='1']", visible: :all
+    assert_selector "#maybe [data-card-count='0']", visible: :all
+
+    release_card_save(status: 500)
+    assert_selector "[role='alert']", text: "Could not move the card"
+    assert_selector "#maybe #{card_selector}"
+    assert_selector "#maybe [data-card-count='1']", visible: :all
+    assert_selector "#{column} [data-card-count='0']", visible: :all
+    assert_selector "#{column} .blank-slate--drag"
+    assert_nil @card.reload.column
+  end
+
+  private
+    def card_selector(card = @card)
+      "##{dom_id(card, :article)}"
+    end
+
+    def card_order(column)
+      all("#{column} .cards__list .card", visible: :all).map { |card| card[:id] }
+    end
+
+    def drop_and_save(selector)
+      hold_card_saves
+      start_drag
+      drag_event "drop", selector
+      release_card_save
+    end
+
+    def start_drag(card = @card)
+      assert_selector "#{card_selector(card)}[draggable=true]"
+      page.execute_script("window.dragData = new DataTransfer()")
+      drag_event "dragstart", card_selector(card)
+    end
+
+    def drag_event(type, selector, related: nil)
+      page.execute_script(<<~JS, type, find(selector, visible: :all), related && find(related))
+        arguments[1].dispatchEvent(new DragEvent(arguments[0], {
+          bubbles: true, cancelable: true, dataTransfer: window.dragData, relatedTarget: arguments[2]
+        }))
+      JS
+    end
+
+    def hold_card_saves(fail: false)
+      page.execute_script <<~'JS', fail
+        const fail = arguments[0]
+        window.moveRequests = []
+        delete document.body.dataset.cardSaveResponse
+        window.originalFetch ||= window.fetch
+        const holdSave = new Promise(resolve => { window.releaseCardSave = resolve })
+        window.fetch = async (url, options) => {
+          if (["POST", "DELETE"].includes(options?.method) && /\/cards\/\d+\//.test(url)) {
+            window.moveRequests.push({ requestId: options.headers.get("X-Turbo-Request-Id") })
+            await holdSave
+            const response = fail ? new Response(null, { status: 500 }) : await window.originalFetch(url, options)
+            document.body.dataset.cardSaveResponse = response.status
+            return response
+          }
+          return window.originalFetch(url, options)
+        }
+      JS
+    end
+
+    def performed_move_requests
+      page.evaluate_script("window.moveRequests")
+    end
+
+    def release_card_save(status: 204)
+      page.execute_script("window.releaseCardSave()")
+      assert_selector "body[data-card-save-response='#{status}']"
+    end
+end
