diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..fc39d3a
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,217 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVERED_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "item", "column", "error" ]
+  static values = { autoPostponePeriod: Number }
+
+  #desktopViewport = window.matchMedia("(min-width: 640px)")
+  #dragged
+  #hovered
+  #saving = new Set()
+  #saveQueue = Promise.resolve()
+
+  connect() {
+    this.#desktopViewport.addEventListener("change", this.#updateDraggability)
+    this.#updateDraggability()
+  }
+
+  disconnect() {
+    this.#desktopViewport.removeEventListener("change", this.#updateDraggability)
+    this.end()
+  }
+
+  itemTargetConnected(card) {
+    card.draggable = this.#desktopViewport.matches
+  }
+
+  itemTargetDisconnected(card) {
+    if (card === this.#dragged) this.end()
+    card.removeAttribute("draggable")
+  }
+
+  start(event) {
+    const card = event.target.closest('[data-drag-and-drop-target~="item"]')
+    if (!card || !this.#columnFor(card)) return
+
+    if (!card.draggable || this.#saving.has(card.id)) {
+      event.preventDefault()
+      return
+    }
+
+    this.#dragged = card
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("application/x-fizzy-card", card.id)
+    card.classList.add(DRAGGED_CLASS)
+  }
+
+  end() {
+    this.#dragged?.classList.remove(DRAGGED_CLASS)
+    this.#dragged = null
+    this.#highlight(null)
+  }
+
+  hover(event) {
+    if (!this.#dragged) return
+
+    const destination = this.#destinationFor(event)
+    this.#highlight(destination)
+    if (destination) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (this.#hovered?.contains(event.target) && !this.#hovered.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    if (!this.#dragged) return
+
+    const card = this.#dragged
+    const source = this.#columnFor(card)
+    const destination = this.#destinationFor(event)
+    this.end()
+    if (!destination) return
+
+    event.preventDefault()
+    const request = this.#requestFor(card, destination)
+    const original = card.cloneNode(true)
+    const origin = document.createComment("")
+    card.before(origin)
+    this.#moveCard(card, destination)
+    this.#updateCount(source, -1)
+    this.#updateCount(destination, 1)
+
+    // All drops appear immediately; send saves in drop order so the server's
+    // newest-first ordering matches the board even when dropping several cards.
+    this.#saving.add(card.id)
+    this.#saveQueue = this.#saveQueue.then(() => this.#saveMove(request, { card, destination, original, origin, source }))
+  }
+
+  #updateDraggability = () => {
+    this.itemTargets.forEach(card => this.itemTargetConnected(card))
+  }
+
+  #destinationFor(event) {
+    const column = this.#columnFor(event.target)
+    if (column && column !== this.#columnFor(this.#dragged) && this.#firstPage(column)) return column
+    return null
+  }
+
+  #columnFor(element) {
+    return element.closest('[data-drag-and-drop-target~="column"]')
+  }
+
+  #firstPage(column) {
+    return column.querySelector(".cards__list turbo-frame")
+  }
+
+  #highlight(column) {
+    if (this.#hovered === column) return
+
+    this.#hovered?.classList.remove(HOVERED_CLASS)
+    this.#hovered = column
+    this.#hovered?.classList.add(HOVERED_CLASS)
+  }
+
+  #moveCard(card, column) {
+    const status = column.dataset.dragAndDropStatus
+    const active = status === "column" || status === "maybe"
+    this.#updatePreview(card, column, active)
+
+    if (active && !card.classList.contains("golden-effect")) {
+      // Active columns sort golden cards first, then by latest activity.
+      const cards = Array.from(column.querySelectorAll(".cards__list .card"))
+      const firstRegular = cards.find(card => !card.classList.contains("golden-effect"))
+      if (firstRegular) {
+        firstRegular.before(card)
+        return
+      } else if (cards.length) {
+        cards.at(-1).after(card)
+        return
+      }
+    }
+
+    this.#firstPage(column).prepend(card)
+  }
+
+  #updatePreview(card, column, active) {
+    const { dragAndDropStatus: status, columnName } = column.dataset
+    card.classList.toggle("card--active", active)
+    card.classList.toggle("card--postponed", status === "not-now")
+    const color = status === "column" ? column.style.getPropertyValue("--card-color") : "var(--color-card-default)"
+    card.style.setProperty("--card-color", color)
+    card.removeAttribute("aria-selected")
+    card.querySelector(".card__closed")?.remove()
+
+    const badge = card.querySelector(".card__header .card__column-name--current")
+    badge.hidden = status !== "column"
+    badge.firstElementChild.textContent = badge.hidden ? "" : columnName
+    card.dataset.action = status === "done" ? "" : "mouseenter->navigable-list#hoverSelect"
+    this.#updateActivity(card)
+  }
+
+  #updateActivity(card) {
+    const now = Date.now()
+    const time = card.querySelector(".card__meta-text--updated time")
+    const updated = time.cloneNode(true)
+    updated.dateTime = Math.floor(now / 1000)
+    time.replaceWith(updated)
+
+    const bubble = card.querySelector(".bubble")
+    if (bubble) {
+      const entropy = JSON.parse(bubble.dataset.bubbleEntropyValue)
+      entropy.closesAt = new Date(now + this.autoPostponePeriodValue * 1000).toISOString()
+      bubble.dataset.bubbleEntropyValue = JSON.stringify(entropy)
+      delete bubble.dataset.bubbleStalledValue
+      bubble.hidden = true
+    }
+  }
+
+  #updateCount(column, delta) {
+    const count = column.querySelector("[data-card-count]")
+    const total = Math.max(0, Number(count.dataset.cardCount) + delta)
+    count.dataset.cardCount = total
+    count.textContent = total > 99 ? "99+" : total
+    count.parentElement.style.setProperty("--card-count", Math.min(total, 15))
+  }
+
+  async #saveMove(request, { card, destination, original, origin, source }) {
+    try {
+      const response = await request.perform()
+      if (response.statusCode !== 204) throw new Error("Card move was not saved")
+    } catch {
+      if (origin.isConnected && this.element.contains(card)) {
+        card.remove()
+        origin.replaceWith(original)
+        this.#updateCount(source, 1)
+        this.#updateCount(destination, -1)
+      }
+      if (this.element.isConnected) this.element.append(this.errorTarget.content.cloneNode(true))
+    } finally {
+      origin.remove()
+      this.#saving.delete(card.id)
+    }
+  }
+
+  #requestFor(card, destination) {
+    const { cardTriageUrl, cardClosureUrl, cardNotNowUrl } = card.dataset
+    const { dragAndDropStatus, dragAndDropColumnId } = destination.dataset
+    // Request.js uses Turbo.fetch, so this client's own refresh broadcast is
+    // ignored while other viewers still see the saved move.
+    const options = { responseKind: "json" }
+    switch (dragAndDropStatus) {
+      case "column": return new FetchRequest("post", cardTriageUrl, { ...options, body: { column_id: dragAndDropColumnId } })
+      case "maybe": return new FetchRequest("delete", cardTriageUrl, options)
+      case "done": return new FetchRequest("post", cardClosureUrl, options)
+      case "not-now": return new FetchRequest("post", cardNotNowUrl, options)
+    }
+  }
+}
