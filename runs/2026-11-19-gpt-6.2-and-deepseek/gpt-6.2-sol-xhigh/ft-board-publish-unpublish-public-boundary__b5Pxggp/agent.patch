diff --git a/app/controllers/public/boards/base_controller.rb b/app/controllers/public/boards/base_controller.rb
new file mode 100644
index 0000000..8e07fd2
--- /dev/null
+++ b/app/controllers/public/boards/base_controller.rb
@@ -0,0 +1,27 @@
+class Public::Boards::BaseController < ApplicationController
+  disallow_account_scope
+  skip_before_action :require_authentication, :ensure_can_access_account
+
+  before_action :protect_public_link, :set_board
+
+  layout "public"
+
+  private
+    def protect_public_link
+      no_store
+      response.headers["Referrer-Policy"] = "no-referrer"
+    end
+
+    def set_board
+      key = request.path_parameters[:board_key] || request.path_parameters[:key]
+      publication = Board::Publication.find_by!(key: key)
+      @board = publication.board
+
+      # Match the key exactly even on databases with case-insensitive collations.
+      unless publication.key == key && @board&.account&.active?
+        raise ActiveRecord::RecordNotFound
+      end
+
+      @board_key = key
+    end
+end
