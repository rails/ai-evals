 Returns `204 No Content` on success.
 
+## Board Publication
+
+Only account admins and owners who have access to the board can publish or unpublish it.
+The `public_url` field in board responses is `null` unless the board is published.
+
+### `POST /:account_slug/boards/:board_id/publication`
+
+Publishes the board and returns `201 Created` with the board JSON, including the absolute `public_url`. The `Location` header also points to the public URL. Publishing an already public board keeps the same URL.
+
+Anyone with the secret URL can open `/public/boards/:key` without signing in. They can also open columns at `/public/boards/:key/columns/:id` and published cards at `/public/boards/:key/cards/:number`. These pages are read-only; drafts are not visible.
+
+### `DELETE /:account_slug/boards/:board_id/publication`
+
+Unpublishes the board and returns `204 No Content`. The old URL and its column and card links no longer work. Publishing the board again creates a new URL.
+
 ## Board Accesses
 
 Board accesses let you see who has access to a board and their involvement level (watching or access only). Any board member can view this information.
diff --git a/test/integration/board_publication_test.rb b/test/integration/board_publication_test.rb
new file mode 100644
index 0000000..99f8be9
--- /dev/null
+++ b/test/integration/board_publication_test.rb
@@ -0,0 +1,196 @@
+require "test_helper"
+
+class BoardPublicationTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "unpublished boards have a null public URL in the board API" do
+    sign_in_as :kevin
+
+    get board_path(@board), as: :json
+    assert_response :success
+    assert_nil response.parsed_body.fetch("public_url")
+
+    get boards_path, as: :json
+    assert_response :success
+    assert_nil response.parsed_body.find { |board| board["id"] == @board.id }.fetch("public_url")
+  end
+
+  test "publishing lets visitors open a board, its columns and its published cards" do
+    sign_in_as :kevin
+    draft = cards(:layout)
+    draft.drafted!
+    cards(:logo).update! description: "<p>Give the logo <strong>more space</strong>.</p>"
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    url = response.parsed_body.fetch("public_url")
+    assert_match %r{\Ahttp://www.example.com/public/boards/[^/]+\z}, url
+    assert_equal url, response.headers["Location"]
+
+    get board_path(@board), as: :json
+    assert_equal url, response.parsed_body.fetch("public_url")
+
+    get boards_path, as: :json
+    assert_equal url, response.parsed_body.find { |board| board["id"] == @board.id }.fetch("public_url")
+
+    open_session do |visitor|
+      column = columns(:writebook_triage)
+      card = cards(:logo)
+      public_path = URI(url).path
+
+      visitor.get public_path
+      assert_equal 200, visitor.response.status
+      assert_equal "none", visitor.response.headers["X-Robots-Tag"]
+      assert_equal "no-referrer", visitor.response.headers["Referrer-Policy"]
+      assert_empty visitor.response.parsed_body.css("form, turbo-cable-stream-source")
+      assert_includes visitor.response.body, @board.name
+      assert_includes visitor.response.body, "#{public_path}/columns/#{column.id}"
+      assert_includes visitor.response.body, "#{public_path}/cards/#{card.number}"
+      assert_not_includes visitor.response.body, draft.title
+
+      visitor.get "#{public_path}/columns/#{column.id}"
+      assert_equal 200, visitor.response.status
+      assert_includes visitor.response.body, column.name
+      assert_not_includes visitor.response.body, draft.title
+      assert_includes visitor.response.parsed_body.text, card.title
+
+      visitor.get "#{public_path}/cards/#{card.number}"
+      assert_equal 200, visitor.response.status
+      assert_includes visitor.response.parsed_body.text, card.title
+      assert_equal "more space", visitor.response.parsed_body.at_css(".lexxy-content strong").text
+      assert_includes visitor.response.headers.fetch("Cache-Control"), "no-store"
+
+      visitor.get "#{public_path}/cards/#{draft.number}"
+      assert_equal 404, visitor.response.status
+    end
+  end
+
+  test "unpublishing invalidates all public URLs and republishing creates a new URL" do
+    sign_in_as :kevin
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    url = response.parsed_body.fetch("public_url")
+
+    post board_publication_path(@board), as: :json
+    assert_equal url, response.parsed_body.fetch("public_url")
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body.fetch("public_url")
+
+    open_session do |visitor|
+      [ url, "#{url}/columns/#{columns(:writebook_triage).id}", "#{url}/cards/#{cards(:logo).number}" ].each do |revoked_url|
+        visitor.get revoked_url
+        assert_equal 404, visitor.response.status
+      end
+    end
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    assert_not_equal url, response.parsed_body.fetch("public_url")
+  end
+
+  test "board creators who are not account admins cannot manage publication" do
