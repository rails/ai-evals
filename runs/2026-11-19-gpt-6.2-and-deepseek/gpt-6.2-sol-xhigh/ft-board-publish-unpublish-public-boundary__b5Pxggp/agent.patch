new file mode 100644
index 0000000..3602e7b
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,22 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy
+  end
+
+  def published?
+    publication.present?
+  end
+
+  def publish
+    with_lock { publication || create_publication! }
+  end
+
+  def unpublish
+    with_lock do
+      publication&.destroy!
+      reset_publication
+    end
+  end
+end
