+    other_board.accesses.where(user: users(:kevin)).delete_all
+
+    post board_publication_path(other_board), as: :json
+    assert_response :not_found
+    assert_not other_board.reload.published?
+  end
+
+  test "admins can publish a restricted board from board settings" do
+    sign_in_as :kevin
+    board = boards(:private)
+
+    post board_publication_path(board)
+    assert_redirected_to edit_board_path(board)
+    follow_redirect!
+    assert_select "a[href='#{public_board_url(board.reload.publication.key, script_name: nil)}']", text: "Open public board"
+
+    open_session do |visitor|
+      visitor.get public_board_path(board.publication.key, script_name: nil)
+      assert_equal 200, visitor.response.status
+      assert_includes visitor.response.body, board.name
+
+      visitor.get board_path(board)
+      assert_equal 302, visitor.response.status
+    end
+
+    delete board_publication_path(board)
+    assert_redirected_to edit_board_path(board)
+    assert_not board.reload.published?
