diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..daf84e9
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    freeze_time
+    @card = boards(:writebook).cards.create!(title: "Burst", status: "published")
+  end
+
+  test "assignment stalls after two weeks and activity restarts the clock" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 2.weeks do
+      assert @card.reload.stalled?
+      assert_includes Card.indexed_by("stalled"), @card
+      @card.update!(title: "Still working")
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.indexed_by("stalled"), @card
+    end
+  end
+
+  test "reopening starts a burst" do
+    @card.close
+    @card.reopen
+
+    travel 2.weeks do
+      assert @card.reload.stalled?
+    end
+  end
+
+  test "a comment burst requires three comments from multiple people within the window" do
+    @card.board.auto_postpone_period = 30.days.to_i
+    @card.comments.create!(body: "Old comment", creator: users(:kevin))
+    travel 10.days + 1.second
+    3.times { @card.comments.create!(body: "Same author", creator: users(:david)) }
+
+    travel 2.weeks do
+      assert_not @card.reload.stalled?
+    end
+
+    @card.comments.create!(body: "Another author", creator: users(:kevin))
+    travel 2.weeks do
+      assert @card.reload.stalled?
+    end
+  end
+end
