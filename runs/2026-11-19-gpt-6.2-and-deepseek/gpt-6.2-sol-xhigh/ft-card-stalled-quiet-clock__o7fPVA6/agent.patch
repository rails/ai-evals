diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..e6a753f
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,29 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> do
+      cutoff = STALL_PERIOD.ago
+      published.where.not(last_burst_at: nil)
+        .where(cards: { last_burst_at: ..cutoff, last_active_at: ..cutoff, updated_at: ..cutoff })
+    end
+  end
+
+  def stalled?
+    cutoff = STALL_PERIOD.ago
+    published? && last_burst_at.present? && [ last_burst_at, last_active_at, updated_at ].max <= cutoff
+  end
+
+  def record_burst
+    update!(last_burst_at: Time.current)
+  end
+
+  def record_comment_burst(comment)
+    window_start = comment.created_at - auto_postpone_period / 3.0
+    recent_comments = comments.by_user.where(created_at: window_start..comment.created_at)
+
+    record_burst if recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+  end
+end
