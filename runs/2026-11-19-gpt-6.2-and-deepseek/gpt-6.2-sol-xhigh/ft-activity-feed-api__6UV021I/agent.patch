+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json { set_page_and_extract_portion_from activities }
+    end
+  end
+
+  private
+    def activities
+      filters = params.permit(creator_ids: [], board_ids: [])
+      events = Current.user.accessible_events.for_activity.preloaded.order(created_at: :desc, id: :desc)
+      events = events.where(creator_id: filters[:creator_ids]) if filters[:creator_ids].present?
+      events = events.where(board_id: filters[:board_ids]) if filters[:board_ids].present?
+      events
+    end
+end
