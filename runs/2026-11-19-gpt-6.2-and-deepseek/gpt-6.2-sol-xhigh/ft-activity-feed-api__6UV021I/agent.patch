diff --git a/config/initializers/geared_pagination.rb b/config/initializers/geared_pagination.rb
new file mode 100644
index 0000000..606c8bb
--- /dev/null
+++ b/config/initializers/geared_pagination.rb
@@ -0,0 +1,13 @@
+# Preserve repeated query parameters (such as board_ids[]) in pagination links.
+module GearedPagination::RepeatedQueryParameters
+  private
+
+  def uri(page:)
+    Addressable::URI.parse(request.url).tap do |uri|
+      parameters = uri.query_values(Array).to_a.reject { |key, _| key == "page" }
+      uri.query_values = parameters + [ [ "page", page ] ]
+    end.to_s
+  end
+end
+
+GearedPagination::Headers.prepend GearedPagination::RepeatedQueryParameters
