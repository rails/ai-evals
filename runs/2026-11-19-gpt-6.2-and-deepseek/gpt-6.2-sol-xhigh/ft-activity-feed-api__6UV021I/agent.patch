new file mode 100644
index 0000000..d75f995
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,24 @@
+# Activity
+
+## `GET /:account_slug/activities.json`
+
+Returns a paginated, flat array of account activity, newest first. The response includes only events on boards the authenticated user can access. If more results are available, follow the `Link` header with `rel="next"`.
+
+| Query parameter | Description |
+|-----------------|-------------|
+| `creator_ids[]` | Only include events created by one of these user IDs. |
+| `board_ids[]` | Only include events on one of these board IDs. |
+
+Repeat a parameter to supply multiple IDs. When both filters are supplied, events must match both.
+
+Each event contains `id`, `action`, `created_at`, `description`, `particulars`, `url`, `eventable_type`, `eventable`, `board`, and `creator`. `description` is the plain-text event description. `eventable_type` is `Card` or `Comment`, and `eventable`, `board`, and `creator` use the standard API resource representations. `url` opens the card for card events and links to the comment on its card for comment events.
+
+| Action | `particulars` fields |
+|--------|----------------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids`: array of user IDs |
+| `card_board_changed` | `old_board`, `new_board`: board names |
+| `card_title_changed` | `old_title`, `new_title`: card titles |
+| `card_triaged` | `column`: column name |
+| `card_published`, `card_closed`, `card_reopened`, `card_postponed`, `card_auto_postponed`, `card_sent_back_to_triage`, `comment_created` | None (`{}`) |
+
+Missing board names, titles, and column names in `particulars` are returned as empty strings. Deprecated `card_collection_changed` events are not returned.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..76fc00c
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,133 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @path = "#{accounts("37s").slug}/activities.json"
+    @headers = { "Authorization" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+  end
+
+  test "lists card and comment activity with API resource representations" do
+    get @path, headers: @headers
+    assert_response :success
+
+    activities = response.parsed_body
+    timestamps = activities.pluck("created_at")
+    assert_equal timestamps.sort.reverse, timestamps
+
+    published = events(:logo_published)
+    card = activity_for(published)
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, card.keys.sort
+    assert_equal "card_published", card["action"]
+    assert_equal published.created_at.utc.as_json, card["created_at"]
+    assert_equal published.description_for(users(:david)).to_plain_text, card["description"]
+    assert_equal({}, card["particulars"])
+    assert_equal card_url(published.card), card["url"]
+    assert_equal "Card", card["eventable_type"]
+
+    commented = events(:layout_commented)
+    comment = activity_for(commented)
+    assert_equal "Comment", comment["eventable_type"]
+    assert_equal card_url(commented.card, anchor: dom_id(commented.eventable)), comment["url"]
+
+    get card_path(published.card, format: :json), headers: @headers
+    assert_equal response.parsed_body.except("steps"), card["eventable"]
+    get card_comment_path(commented.card, commented.eventable, format: :json), headers: @headers
+    assert_equal response.parsed_body, comment["eventable"]
+    get board_path(published.board, format: :json), headers: @headers
+    assert_equal response.parsed_body, card["board"]
+    assert_equal card["board"]["creator"], card["creator"]
+  end
+
+  test "includes title changes and omits deprecated and non-timeline actions" do
+    old_title = cards(:logo).title
+    with_current_user(:david) { cards(:logo).update!(title: "The new title") }
+    renamed = cards(:logo).events.find_by!(action: "card_title_changed")
+    deprecated = track_card_event("collection_changed")
+    resumed = track_card_event("resumed")
+
+    get @path, headers: @headers
+    assert_response :success
+    assert_equal({ "old_title" => old_title, "new_title" => "The new title" }, activity_for(renamed)["particulars"])
+    assert_nil activity_for(deprecated)
+    assert_nil activity_for(resumed)
+  end
+
+  test "includes particulars for assignment, board, and triage events" do
+    unassigned = track_card_event("unassigned", assignee_ids: [ users(:kevin).id ])
+    moved = track_card_event("board_changed", particulars: { old_board: "Roadmap", new_board: "Writebook" })
+    triaged = track_card_event("triaged", particulars: { column: "In Progress" })
+
+    get @path, headers: @headers
+    assert_response :success
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity_for(events(:logo_assignment_jz))["particulars"])
+    assert_equal({ "assignee_ids" => [ users(:kevin).id ] }, activity_for(unassigned)["particulars"])
+    assert_equal({ "old_board" => "Roadmap", "new_board" => "Writebook" }, activity_for(moved)["particulars"])
+    assert_equal({ "column" => "In Progress" }, activity_for(triaged)["particulars"])
+  end
+
+  test "returns missing board, title, and column values as empty strings" do
+    moved = track_card_event("board_changed", particulars: { old_board: nil })
+    renamed = track_card_event("title_changed")
+    triaged = track_card_event("triaged")
+    triaged.update_column(:particulars, nil)
+
+    get @path, headers: @headers
+    assert_response :success
+    assert_equal({ "old_board" => "", "new_board" => "" }, activity_for(moved)["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, activity_for(renamed)["particulars"])
+    assert_equal({ "column" => "" }, activity_for(triaged)["particulars"])
+  end
+
+  test "filters by creator and board without exposing inaccessible events" do
+    with_current_user(:kevin) { cards(:layout).move_to(boards(:private)) }
+    other_account_event = track_card_event("published", card: cards(:radio), creator: users(:mike))
+
+    get @path, headers: @headers
+    assert_response :success
+    assert_nil activity_for(events(:layout_published))
+    assert_nil activity_for(events(:layout_commented))
+    assert_nil activity_for(other_account_event)
+
+    get @path, params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id, boards(:private).id ] }, headers: @headers
+    assert_response :success
+    assert_equal events(:shipping_closed, :shipping_published, :text_published).map(&:id).sort, response.parsed_body.pluck("id").sort
+
+    get @path, params: { board_ids: [ boards(:private).id, boards(:miltons_wish_list).id ] }, headers: @headers
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+
+  test "paginates newest first and preserves list filters in next links" do
+    creator_ids = users(:david, :kevin).map(&:id)
+    board_ids = boards(:writebook, :private).map(&:id)
+    travel_to Time.current do
+      16.times do |i|
+        track_card_event("published", creator: users(i.even? ? :david : :kevin))
+      end
+    end
+    expected_ids = boards(:writebook).events.where(creator_id: creator_ids).order(created_at: :desc, id: :desc).ids
+
+    get @path, params: { creator_ids: creator_ids, board_ids: board_ids }, headers: @headers
+    assert_response :success
+    assert_equal expected_ids.size.to_s, response.headers["X-Total-Count"]
+    first_page_ids = response.parsed_body.pluck("id")
+    next_page = response.headers["Link"][/<([^>]+)>; rel="next"/, 1]
+    assert next_page
+
+    get next_page, headers: @headers
+    assert_response :success
+    assert_equal expected_ids, first_page_ids + response.parsed_body.pluck("id")
+    assert_nil response.headers["Link"]
+  end
+
+  private
+    include ActionView::RecordIdentifier
+
+    def track_card_event(action, card: cards(:logo), creator: users(:david), **particulars)
+      card.track_event(action, creator: creator, **particulars)
+    end
+
+    def activity_for(event)
+      response.parsed_body.find { |activity| activity["id"] == event.id }
+    end
+end
