@@ -0,0 +1,11 @@
+class Account::RefreshStorageUsageJob < ApplicationJob
+  queue_as :backend
+
+  limits_concurrency key: ->(account) { account }, on_conflict: :discard
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked
+
+  def perform(account)
+    account.refresh_storage_usage_now
+  end
+end
