diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..54f201f
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,35 @@
+<% @page_title = "Search cards" %>
+<% turbo_exempts_page_from_cache %>
+
+<section class="panel panel--wide center flex flex-column gap txt-align-start">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+
+  <%= form_with url: search_path, method: :get, html: { role: "search" }, class: "flex gap-half" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, class: "input", placeholder: "Search cards…", maxlength: Card::Search::QUERY_LIMIT, autocomplete: "off" %>
+    <button type="submit" class="btn">Search</button>
+  <% end %>
+
+  <% if @search.query.blank? %>
+    <p class="margin-none txt-small">Search card titles, descriptions, and comments.</p>
+  <% elsif @cards.empty? %>
+    <p class="margin-none txt-small">No cards match your search.</p>
+  <% else %>
+    <ul id="search-results" role="list" class="flex flex-column gap margin-none">
+      <% @cards.each do |card| %>
+        <%= render "searches/result", card: card, comment: @comments_by_card[card.id], pattern: @search.pattern %>
+      <% end %>
+    </ul>
+  <% end %>
+
+  <% if !@page.first? || @page.before_last? %>
+    <nav aria-label="Search result pages" data-turbo-prefetch="false" class="flex gap-half">
+      <% unless @page.first? %>
+        <%= link_to "Previous page", search_path(q: @search.query, page: @page.number - 1), class: "btn txt-small" %>
+      <% end %>
+      <% if @page.before_last? %>
+        <%= link_to "Next page", search_path(q: @search.query, page: @page.next_param), class: "btn txt-small" %>
+      <% end %>
+    </nav>
+  <% end %>
+</section>
