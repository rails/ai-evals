--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,18 @@
+module SearchesHelper
+  def highlight_search_match(text, pattern)
+    safe_join(text.to_s.split(/(#{pattern})/).map.with_index do |part, index|
+      index.odd? ? tag.mark(part) : part
+    end)
+  end
+
+  def search_excerpt(rich_text, pattern)
+    text = Card::Search.plain_text(rich_text&.body)
+
+    if match = pattern.match(text)
+      left = [ match.begin(0) - 75, 0 ].max
+      right = [ match.end(0) + 75, text.length ].min
+      snippet = "#{'…' if left.positive?}#{text[left...right]}#{'…' if right < text.length}"
+      highlight_search_match(snippet, pattern)
+    end
+  end
+end
