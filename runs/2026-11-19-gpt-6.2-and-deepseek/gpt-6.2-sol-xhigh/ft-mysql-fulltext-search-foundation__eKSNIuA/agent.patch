diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..342f06e
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,61 @@
+class Card::Search
+  QUERY_LIMIT = 200
+  RICH_TEXT_NAMES = { "Card" => "description", "Comment" => "body" }.freeze
+
+  class << self
+    def rich_text_value(body, record_type:, name:)
+      plain_text(body).downcase if body && RICH_TEXT_NAMES[record_type] == name
+    end
+
+    def plain_text(body)
+      fragment = body.is_a?(ActionText::Content) ? body.fragment : ActionText::Fragment.wrap(body)
+      fragment.to_plain_text.squish
+    end
+  end
+
+  attr_reader :query, :pattern
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.first(QUERY_LIMIT).squish
+    @terms = @query.downcase.split.uniq
+    @pattern = Regexp.union(@terms.sort_by { |term| -term.length }.map { |term| /#{Regexp.escape(term)}/i })
+  end
+
+  def cards
+    scope = @user.accessible_cards.published.where(account_id: @user.account_id).reverse_chronologically
+    return scope.none if @terms.empty?
+
+    @terms.reduce(scope) { |results, term| results.where(card_matches(term)) }
+  end
+
+  def comments_by_card(cards)
+    return {} if cards.empty?
+
+    # Show one matching comment per card, without loading every matching comment.
+    matches = @terms.map { |term| contains("action_text_rich_texts.search_text", term) }.reduce(&:or)
+    ids = matching_comments(matches).where(card: cards).group(:card_id).maximum(:id).values
+    Comment.with_rich_text_body.where(id: ids).index_by(&:card_id)
+  end
+
+  private
+    def card_matches(term)
+      body_match = contains("action_text_rich_texts.search_text", term)
+      description = ActionText::RichText.where(record_type: "Card", name: "description")
+        .where("action_text_rich_texts.record_id = cards.id").where(body_match)
+      comments = matching_comments(body_match).where("comments.card_id = cards.id")
+
+      contains("cards.search_title", term).or(description.arel.exists).or(comments.arel.exists)
+    end
+
+    def matching_comments(condition)
+      Comment.joins(:rich_text_body).where(condition)
+    end
+
+    def contains(column, term)
+      # Search values are already downcased; don't let MySQL's accent-insensitive
+      # collation match text that won't be highlighted. INSTR treats % and _ literally.
+      value = Card.connection_pool.db_config.adapter == "sqlite3" ? "?" : "CAST(? AS BINARY)"
+      Arel.sql("INSTR(#{column}, #{value}) > 0", term)
+    end
+end
