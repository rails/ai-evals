 class Books::SearchesController < ApplicationController
   allow_unauthenticated_access
 
+  before_action :limit_searches, only: :create
+
   include BookScoped
 
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    def limit_searches
+      unless Books::SearchRateLimit.allow?(request.remote_ip)
+        no_store
+        head :too_many_requests
+      end
+    end
 end
diff --git a/test/integration/book_search_rate_limit_test.rb b/test/integration/book_search_rate_limit_test.rb
new file mode 100644
index 0000000..f154070
--- /dev/null
+++ b/test/integration/book_search_rate_limit_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class BookSearchRateLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    @handbook = books(:handbook)
+    @manual = books(:manual)
+    @handbook.update!(published: true)
+    @manual.update!(published: true)
+    Leaf.reindex_all
+    freeze_time
+  end
+
+  test "one address shares a search quota across books without blocking other readers or page views" do
+    throttled = open_session { |reader| reader.remote_addr = "192.0.2.10" }
+    other_reader = open_session { |reader| reader.remote_addr = "192.0.2.11" }
+
+    15.times do
+      [ @handbook, @manual ].each do |book|
+        throttled.post book_search_path(book), params: { search: "Thanks" }
+        throttled.assert_response :success
+      end
+    end
+
+    same_address = open_session { |reader| reader.remote_addr = throttled.remote_addr }
+    [ @handbook, @manual ].each do |book|
+      assert_no_queries_match(/leaf_search_index/) do
+        same_address.post book_search_path(book), params: { search: "Thanks" }
+      end
+      same_address.assert_response 429
+    end
+
+    other_reader.post book_search_path(@handbook), params: { search: "Thanks" }
+    other_reader.assert_response :success
+    other_reader.assert_select "a.search__result", text: /Thanks for reading/i
+    assert_nil other_reader.cookies[:session_token]
+
+    throttled.get book_slug_path(@handbook)
+    throttled.assert_response :success
+    throttled.get leafable_slug_path(leaves(:summary_page))
+    throttled.assert_response :success
+    assert_nil throttled.cookies[:session_token]
+  end
+
+  test "the quota recovers one slot at a time as searches leave the rolling minute" do
+    self.remote_addr = "192.0.2.12"
+
+    post book_search_path(@handbook), params: { search: "Thanks" }
+    assert_response :success
+
+    travel 59.seconds
+    29.times do
+      post book_search_path(@handbook), params: { search: "Thanks" }
+      assert_response :success
+    end
+    post book_search_path(@handbook), params: { search: "Thanks" }
+    assert_response 429
+
+    travel 1.second
+    post book_search_path(@handbook), params: { search: "Thanks" }
+    assert_response :success
+    post book_search_path(@handbook), params: { search: "Thanks" }
+    assert_response 429
+
+    travel 1.minute
+    post book_search_path(@handbook), params: { search: "Thanks" }
+    assert_response :success
+  end
+end
