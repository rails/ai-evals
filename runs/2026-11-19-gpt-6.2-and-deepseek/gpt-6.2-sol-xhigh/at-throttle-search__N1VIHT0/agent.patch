diff --git a/app/controllers/books/search_rate_limit.rb b/app/controllers/books/search_rate_limit.rb
new file mode 100644
index 0000000..29e0fef
--- /dev/null
+++ b/app/controllers/books/search_rate_limit.rb
@@ -0,0 +1,65 @@
+class Books::SearchRateLimit
+  LIMIT = 30
+  WINDOW = 1.minute
+
+  LOCAL_CACHE = ActiveSupport::Cache::MemoryStore.new
+  LOCAL_LOCK = Mutex.new
+
+  # Keep just the last LIMIT accepted timestamps. The oldest one determines
+  # whether another request fits, and refused requests never refresh the TTL.
+  REDIS_SCRIPT = <<~LUA.freeze
+    local key = KEYS[1]
+    local limit = tonumber(ARGV[1])
+    local seconds = tonumber(ARGV[2])
+    local time = redis.call("TIME")
+    local now = tonumber(time[1]) * 1000000 + tonumber(time[2])
+
+    if redis.call("LLEN", key) >= limit then
+      local oldest = tonumber(redis.call("LINDEX", key, 0))
+      if now - oldest < seconds * 1000000 then
+        return 0
+      end
+      redis.call("LPOP", key)
+    end
+
+    redis.call("RPUSH", key, string.format("%.0f", now))
+    -- Round up the TTL so millisecond expiry cannot drop a microsecond timestamp early.
+    redis.call("PEXPIRE", key, seconds * 1000 + 1)
+    return 1
+  LUA
+
+  class << self
+    def allow?(address)
+      if Rails.env.production?
+        allow_in_redis?(address)
+      else
+        allow_locally?(address)
+      end
+    end
+
+    private
+      def allow_in_redis?(address)
+        Rails.cache.redis.with do |redis|
+          redis.eval(REDIS_SCRIPT, keys: [ "writebook:book-search-rate-limit:#{address}" ], argv: [ LIMIT, WINDOW.to_i ]) == 1
+        end
+      rescue Redis::BaseConnectionError, ConnectionPool::TimeoutError => error
+        # Keep serving readers if Redis is temporarily unavailable.
+        Rails.error.report(error, severity: :warning)
+        allow_locally?(address)
+      end
+
+      def allow_locally?(address)
+        LOCAL_LOCK.synchronize do
+          now = Time.current.to_f
+          timestamps = LOCAL_CACHE.read(address) || []
+          if timestamps.size >= LIMIT
+            return false if now - timestamps.first < WINDOW.to_i
+            timestamps.shift
+          end
+
+          LOCAL_CACHE.write(address, timestamps << now, expires_in: WINDOW)
+          true
+        end
+      end
+  end
+end
