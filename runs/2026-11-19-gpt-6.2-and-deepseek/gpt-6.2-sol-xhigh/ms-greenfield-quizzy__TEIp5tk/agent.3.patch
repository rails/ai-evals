@@ -1,6 +1,6 @@
 # Quizzy
 
-Quizzy is a Rails app for preparing conference quizzes. Moderators can create a quiz, arrange and activate its questions, and test it in a phone-friendly player preview.
+Quizzy is a Rails app for preparing and running live conference quizzes. Moderators can arrange and preview questions, then run a game on a big screen while the audience plays on their phones.
 
 ## Run
 
@@ -16,6 +16,12 @@ RAILS_ENV=production PORT=3000 \
 
 Use a stable `SECRET_KEY_BASE` across restarts in a real deployment. `bin/serve` prepares the SQLite database, compiles local assets, and runs Puma in the foreground. Visit `http://localhost:3000/moderate`; `/up` is the unauthenticated health check. Quiz data is in `storage/production.sqlite3`. The app uses plain HTTP as requested, so use it only on a trusted network.
 
+## Run a live quiz
+
+Open the moderator site using the conference-reachable hostname or IP address (not `localhost` when players are on other devices). Open a quiz and choose **Start a game**. The lobby shows a join URL and QR code. Players enter their names and can join until the quiz ends; opening the link again on the same browser and host resumes their place.
+
+Choose **Start**, then **Finish** once you are ready to reveal the answers. Use **Next** for the following question or **End quiz** on the last one. Every game starts with a fresh set of players and answers and uses the questions that were active when the game was created.
+
 ## Move or share a quiz
 
 On a quiz page, choose **Export** and copy the JSON. In the destination Quizzy app, go to the moderator dashboard, choose **Import quiz**, and paste it into **Quiz JSON**. Import creates a separate quiz with the same contents, even if the title already exists. The JSON includes the correct answers, so share it only with the intended moderators.
diff --git a/app/assets/javascripts/live_game.js b/app/assets/javascripts/live_game.js
new file mode 100644
index 0000000..42ff159
--- /dev/null
+++ b/app/assets/javascripts/live_game.js
@@ -0,0 +1,179 @@
+"use strict";
+
+function followLiveGame(root) {
+  const region = root.querySelector("[data-live-region]");
+  const notice = root.querySelector("[data-live-notice]");
+  const phase = () => region.firstElementChild.dataset.livePhase;
+  const interval = root.dataset.liveGame === "stage" ? 650 : 1250;
+  let etag = root.dataset.liveEtag;
+  let timer;
+  let currentPoll;
+  let sending = false;
+  let queuedPick;
+  let failures = 0;
+  let unavailable = false;
+
+  function schedule(delay) {
+    clearTimeout(timer);
+    if (phase() === "ended" || unavailable || sending) return;
+    // Jitter prevents a room full of phones from polling at the same moment.
+    const pace = document.hidden ? Math.max(interval, 3500) : interval;
+    const backoff = Math.min(pace * 2 ** failures, 10000);
+    timer = setTimeout(poll, delay ?? backoff * (0.85 + Math.random() * 0.3));
+  }
+
+  function patchSameRound(previous, next) {
+    if (previous.dataset.livePhase !== next.dataset.livePhase ||
+        previous.dataset.liveRound !== next.dataset.liveRound) return false;
+
+    const counter = previous.querySelector("[data-live-counter]");
+    if (counter) {
+      counter.textContent = next.querySelector("[data-live-counter]").textContent;
+      return true;
+    }
+    if (phase() !== "open") return false;
+
+    // Keep the actual buttons mounted while picks arrive, so rapid taps and
+    // keyboard focus are not lost when the server acknowledges a selection.
+    const selected = next.querySelector("button[aria-pressed=true]")?.value;
+    for (const button of previous.querySelectorAll("button[name=option_index]")) {
+      const picked = button.value === selected;
+      button.classList.toggle("is-picked", picked);
+      button.setAttribute("aria-pressed", picked);
+      if (picked) button.setAttribute("aria-description", "Your answer");
+      else button.removeAttribute("aria-description");
+      const mark = button.querySelector("[data-pick-mark]");
+      mark.textContent = picked ? "Your answer" : "";
+      mark.hidden = !picked;
+    }
+    return true;
+  }
+
+  function replaceView(html, nextTag) {
+    const template = document.createElement("template");
+    template.innerHTML = html; // A same-origin Rails fragment with quiz text escaped by ERB.
+    const next = template.content.firstElementChild;
+    if (!next?.hasAttribute("data-live-phase")) throw new Error("Invalid game response");
+
+    etag = nextTag;
+    if (patchSameRound(region.firstElementChild, next)) return;
+
+    const focused = document.activeElement;
+    const focusKey = region.contains(focused) ? focused.dataset.liveFocus : null;
+    const oldPhase = phase();
+    region.replaceChildren(next);
+
+    if (focusKey) {
+      const sameControl = oldPhase === phase() &&
+        next.querySelector(`[data-live-focus="${CSS.escape(focusKey)}"]:not(:disabled)`);
+      (sameControl || next.querySelector("[data-live-focus=heading]"))?.focus({ preventScroll: true });
+    }
+  }
+
+  function connected() {
+    failures = 0;
+    notice.hidden = true;
+  }
+
+  function connectionIssue(message) {
+    failures += 1;
+    notice.textContent = message;
+    notice.hidden = false;
+  }
+
+  async function poll() {
+    if (currentPoll || sending || phase() === "ended") return;
+    const controller = new AbortController();
+    currentPoll = controller;
+    const timeout = setTimeout(() => controller.abort(), 6000);
+
+    try {
+      const response = await fetch(root.dataset.liveUrl, {
+        cache: "no-store",
+        signal: controller.signal,
+        headers: etag ? { "If-None-Match": etag } : {}
+      });
+      const html = response.ok ? await response.text() : null;
+      if (currentPoll !== controller) return;
+
+      if (html !== null) {
+        replaceView(html, response.headers.get("ETag"));
+      } else if (response.status === 404) {
+        unavailable = true;
+        connectionIssue("This game is no longer available.");
+        return;
+      } else if (response.status !== 304) {
+        throw new Error("Could not sync game");
+      }
+      connected();
+    } catch {
+      if (currentPoll === controller) connectionIssue("Connection interrupted. Reconnecting…");
+    } finally {
+      clearTimeout(timeout);
+      if (currentPoll === controller) {
+        currentPoll = null;
+        schedule();
+      }
+    }
+  }
+
+  async function submit(action) {
+    sending = true;
+    clearTimeout(timer);
+    const oldPoll = currentPoll;
+    currentPoll = null;
+    oldPoll?.abort(); // A read started before this action must not overwrite it.
+
+    try {
+      // Serialize answer requests, keeping only the latest pick waiting to send.
+      // This avoids slower earlier requests replacing a player's newer choice.
+      while (action) {
+        const controller = new AbortController();
+        const timeout = setTimeout(() => controller.abort(), 6000);
+        try {
+          const response = await fetch(action.url, {
+            method: "POST",
+            headers: { "X-Quizzy-Live": "1" },
+            body: action.fields,
+            signal: controller.signal,
+            cache: "no-store",
+            redirect: "error"
+          });
+          if (!response.ok && ![409, 422].includes(response.status)) throw new Error("Game action failed");
+
+          const html = await response.text();
+          if (!queuedPick) replaceView(html, response.headers.get("ETag"));
+          connected();
+        } catch {
+          connectionIssue("Could not confirm that action. Reconnecting…");
+        } finally {
+          clearTimeout(timeout);
+        }
+        action = queuedPick;
+        queuedPick = null;
+      }
+    } finally {
+      sending = false;
+      schedule();
+    }
+  }
+
+  root.addEventListener("submit", (event) => {
+    const form = event.target;
+    if (!form.hasAttribute("data-live-action") || event.defaultPrevented) return;
+    event.preventDefault();
+    if (unavailable) return;
+
+    const action = { url: form.action, fields: new URLSearchParams(new FormData(form, event.submitter)) };
+    if (!sending) submit(action);
+    else if (form.dataset.liveAction === "answer") queuedPick = action;
+  });
+
+  window.addEventListener("online", () => schedule(0));
+  window.addEventListener("pageshow", (event) => { if (event.persisted) schedule(0); });
+  document.addEventListener("visibilitychange", () => schedule(document.hidden ? undefined : 0));
+  schedule();
+}
+
+const liveGame = document.querySelector("[data-live-game]");
+if (liveGame) followLiveGame(liveGame);
