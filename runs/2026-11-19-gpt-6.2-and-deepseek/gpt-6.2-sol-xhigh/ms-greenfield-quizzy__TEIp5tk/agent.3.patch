diff --git a/app/views/plays/_player.html.erb b/app/views/plays/_player.html.erb
new file mode 100644
index 0000000..19bef1d
--- /dev/null
+++ b/app/views/plays/_player.html.erb
@@ -0,0 +1,56 @@
+<section data-live-phase="<%= @live_phase %>" data-live-round="<%= @game.round_index %>">
+  <% case @live_phase
+     when "ended" %>
+    <div class="waiting">
+      <h1 class="play-title" tabindex="-1" data-live-focus="heading">The quiz is over</h1>
+      <p class="play-lead">Thanks for being here!</p>
+    </div>
+  <% when "join" %>
+    <h1 class="play-title" tabindex="-1" data-live-focus="heading">Join the quiz</h1>
+    <%= form_with url: join_play_path(@game.code), class: "join-form", data: { live_action: "join" } do |form| %>
+      <%= form.label :name, "Your name", class: "field-label" %>
+      <%= form.text_field :name, class: "input", value: @join_name, autocomplete: "nickname",
+            maxlength: 60, required: true, data: { live_focus: "name" } %>
+      <% if @join_error %><p role="alert"><%= @join_error %></p><% end %>
+      <%= form.submit "Join", class: "btn btn--pink", data: { live_focus: "join" } %>
+    <% end %>
+  <% when "lobby" %>
+    <div class="waiting">
+      <div class="waiting__gem" aria-hidden="true">?</div>
+      <h1 class="play-title" tabindex="-1" data-live-focus="heading">Hi, <%= @player.name %>!</h1>
+      <p class="play-lead">Waiting for the quiz to start…</p>
+    </div>
+  <% else %>
+    <% round = @game.current_round %>
+    <p class="live-play__greeting">Hi, <%= @player.name %>!</p>
+    <p class="play-question__num">Question <%= @game.round_index + 1 %> of <%= @game.rounds.size %></p>
+    <h1 class="play-question__body" tabindex="-1" data-live-focus="heading"><%= round.fetch("body") %></h1>
+    <% if @game.closed? %>
+      <% style, feedback = if @selected.nil?
+        ["neutral", "No answer"]
+      elsif round.fetch("options").fetch(@selected).fetch("correct")
+        ["right", "Correct!"]
+      else
+        ["wrong", "Wrong!"]
+      end %>
+      <p class="play-status play-status--<%= style %>" role="status"><%= feedback %></p>
+    <% end %>
+    <%= form_with url: answer_play_path(@game.code), data: { live_action: "answer" } do |form| %>
+      <%= form.hidden_field :round_index, value: @game.round_index %>
+      <div class="play-options<%= ' is-locked is-revealed' if @game.closed? %>">
+        <% round.fetch("options").each_with_index do |option, index| %>
+          <% picked = @selected == index %>
+          <% correct = @game.closed? && option.fetch("correct") %>
+          <%= button_tag type: "submit", name: "option_index", value: index, disabled: @game.closed?,
+                class: class_names("play-option", "is-picked" => picked, "is-correct" => correct),
+                aria: { label: option.fetch("text"), pressed: picked, description: ("Your answer" if picked) },
+                data: { live_focus: "option-#{index}" } do %>
+            <span class="play-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+            <span class="play-option__title"><%= option.fetch("text") %></span>
+            <span class="play-option__mark" data-pick-mark <%= 'hidden' unless picked %>><%= "Your answer" if picked %></span>
+          <% end %>
+        <% end %>
+      </div>
+    <% end %>
+  <% end %>
+</section>
