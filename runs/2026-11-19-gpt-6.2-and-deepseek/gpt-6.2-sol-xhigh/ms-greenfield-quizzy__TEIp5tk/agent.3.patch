diff --git a/app/views/moderate/games/_stage.html.erb b/app/views/moderate/games/_stage.html.erb
new file mode 100644
index 0000000..ed3ec5c
--- /dev/null
+++ b/app/views/moderate/games/_stage.html.erb
@@ -0,0 +1,63 @@
+<section data-live-phase="<%= @game.phase %>" data-live-round="<%= @game.round_index %>">
+  <% if @game.lobby? %>
+    <div class="lobby">
+      <div>
+        <p class="screen__kicker">Live quiz</p>
+        <h1 class="lobby__title" tabindex="-1" data-live-focus="heading"><%= @game.title %></h1>
+        <p class="lobby__join">Scan to join or visit</p>
+        <p class="lobby__url"><%= @join_url %></p>
+        <p class="counter-pill" role="status" data-live-counter>Players: <%= @player_count %></p>
+      </div>
+      <div class="qr"><%= join_qr_code(@join_url) %></div>
+    </div>
+    <% if @game.rounds.empty? %>
+      <p>This game has no active questions.</p>
+    <% end %>
+    <% command, label = "start", "Start" %>
+  <% elsif @game.ended? %>
+    <p class="screen__kicker"><%= @game.title %></p>
+    <h1 class="lobby__title" tabindex="-1" data-live-focus="heading">The quiz is over</h1>
+  <% else %>
+    <% round = @game.current_round %>
+    <p class="stage-question__num">Question <%= @game.round_index + 1 %> of <%= @game.rounds.size %></p>
+    <h1 class="stage-question__body" tabindex="-1" data-live-focus="heading"><%= round.fetch("body") %></h1>
+    <ol class="stage-options<%= ' stage-options--results' if @game.closed? %>">
+      <% round.fetch("options").each_with_index do |option, index| %>
+        <% correct = @game.closed? && option.fetch("correct") %>
+        <li class="stage-option<%= ' is-correct' if correct %>">
+          <span class="stage-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+          <span class="stage-option__title"><%= option.fetch("text") %></span>
+          <% if @game.closed? %>
+            <% count = @result_counts.fetch(index, 0) %>
+            <span class="stage-option__count" aria-label="<%= pluralize(count, 'answer') %>"><%= count %></span>
+            <% if correct %><span class="stage-option__mark">Correct</span><% end %>
+          <% end %>
+        </li>
+      <% end %>
+    </ol>
+    <% if @game.open? %>
+      <% command, label = "finish", "Finish" %>
+    <% else %>
+      <% command, label = @game.last_round? ? [ "end", "End quiz" ] : [ "next", "Next" ] %>
+    <% end %>
+  <% end %>
+
+  <footer class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "Back to quiz", moderate_quiz_path(@game.quiz_id) %>
+      <% if @game.open? || @game.closed? %>
+        <span class="screen-controls__join"><%= @join_url %></span>
+      <% end %>
+    </div>
+    <div class="live-screen__actions">
+      <% if @game.open? %>
+        <span class="answers-counter" role="status" data-live-counter>Answers: <%= @answer_count %> / <%= @player_count %></span>
+      <% end %>
+      <% if command %>
+        <%= button_to label, transition_moderate_game_path(@game), class: "btn btn--pink",
+              form: { data: { live_action: "transition" } },
+              data: { live_focus: "transition" }, params: { command: command, round_index: @game.round_index } %>
+      <% end %>
+    </div>
+  </footer>
+</section>
