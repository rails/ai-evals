diff --git a/app/models/game.rb b/app/models/game.rb
new file mode 100644
index 0000000..dc90720
--- /dev/null
+++ b/app/models/game.rb
@@ -0,0 +1,86 @@
+class Game < ApplicationRecord
+  belongs_to :quiz, inverse_of: :games
+  has_many :players, class_name: "GamePlayer", inverse_of: :game
+  has_many :answers, through: :players
+
+  enum :phase, { lobby: "lobby", open: "open", closed: "closed", ended: "ended" }
+
+  def self.launch(quiz)
+    rounds = quiz.questions.where(active: true).pluck(:body, :options).map do |body, options|
+      { "body" => body, "options" => options }
+    end
+
+    create!(quiz: quiz, title: quiz.title, rounds: rounds, code: SecureRandom.alphanumeric(8).upcase)
+  rescue ActiveRecord::RecordNotUnique
+    retry # A join code collision must never reuse an existing game.
+  end
+
+  def current_round
+    rounds.fetch(round_index)
+  end
+
+  def last_round?
+    round_index == rounds.length - 1
+  end
+
+  def join(browser_key, name)
+    with_lock do
+      next if ended?
+
+      player = players.find_or_initialize_by(browser_key: browser_key)
+      if player.new_record?
+        player.assign_attributes(name: name, last_seen_at: Time.current)
+        player.save
+      else
+        player.check_in
+      end
+      player
+    end
+  end
+
+  # The phase and question checks happen inside the same write transaction as
+  # the change. A delayed request cannot finish/answer a different question.
+  def transition(command, expected_round)
+    with_lock do
+      next false unless round_index.to_s == expected_round.to_s
+
+      case [phase, command]
+      when ["lobby", "start"]
+        update!(phase: rounds.empty? ? :ended : :open)
+      when ["open", "finish"]
+        update!(phase: :closed)
+      when ["closed", "next"]
+        !last_round? && update!(phase: :open, round_index: round_index + 1)
+      when ["closed", "end"]
+        last_round? && update!(phase: :ended)
+      else
+        false
+      end
+    end
+  end
+
+  def pick(player, expected_round, option)
+    with_lock do
+      next false unless open? && round_index.to_s == expected_round.to_s && player&.game_id == id
+
+      index = Integer(option.to_s, 10, exception: false)
+      next false unless index && index.between?(0, current_round.fetch("options").length - 1)
+
+      player.answers.find_or_initialize_by(round_index: round_index).update!(option_index: index)
+      player.check_in
+      true
+    end
+  end
+
+  def open_counts
+    # From the same snapshot of active players, count both the submissions and
+    # the audience. Results after Finish still include disconnected players.
+    join = "LEFT JOIN game_answers ON game_answers.game_player_id = game_players.id " \
+      "AND game_answers.round_index = #{Integer(round_index)}"
+    players.present_in_game.joins(join).pick(Arel.star.count, GameAnswer.arel_table[:id].count)
+  end
+
+  def result_counts
+    answers.where(round_index: round_index).group(:option_index).count
+  end
+end
