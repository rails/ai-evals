new file mode 100644
index 0000000..619c488
--- /dev/null
+++ b/app/models/game_player.rb
@@ -0,0 +1,21 @@
+class GamePlayer < ApplicationRecord
+  HEARTBEAT_INTERVAL = 10.seconds
+  PRESENCE_WINDOW = 45.seconds
+
+  belongs_to :game, inverse_of: :players
+  has_many :answers, class_name: "GameAnswer", inverse_of: :game_player
+
+  normalizes :name, with: ->(name) { name.strip }
+  validates :name, presence: true, length: { maximum: 60 }
+
+  scope :present_in_game, -> { where(last_seen_at: (Time.current - PRESENCE_WINDOW)..) }
+
+  def check_in
+    now = Time.current
+    cutoff = now - HEARTBEAT_INTERVAL
+    return if last_seen_at > cutoff
+
+    # Multiple tabs can check in, but there's no need to write every poll.
+    self.class.where(id: id, last_seen_at: ..cutoff).update_all(last_seen_at: now)
+  end
+end
