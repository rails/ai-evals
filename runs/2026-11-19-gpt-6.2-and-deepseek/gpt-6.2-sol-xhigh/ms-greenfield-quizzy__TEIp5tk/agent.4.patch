diff --git a/app/channels/game_updates_channel.rb b/app/channels/game_updates_channel.rb
new file mode 100644
index 0000000..8e637b8
--- /dev/null
+++ b/app/channels/game_updates_channel.rb
@@ -0,0 +1,18 @@
+class GameUpdatesChannel < ActionCable::Channel::Base
+  def subscribed
+    code = params[:code]
+    return reject unless code.is_a?(String) && code.match?(/\A[A-Z0-9]{8}\z/)
+
+    # This stream contains only invalidation signals. Player identity and
+    # moderator authorization are still checked on the HTTP view endpoints.
+    stream_from self.class.stream_name(code)
+  end
+
+  def self.publish(code)
+    ActionCable.server.broadcast(stream_name(code), { changed: true })
+  end
+
+  def self.stream_name(code)
+    "game_updates:#{code}"
+  end
+end
