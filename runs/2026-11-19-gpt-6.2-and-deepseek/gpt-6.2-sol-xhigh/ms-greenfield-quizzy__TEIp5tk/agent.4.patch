diff --git a/app/services/game_leaderboard.rb b/app/services/game_leaderboard.rb
new file mode 100644
index 0000000..1f86a60
--- /dev/null
+++ b/app/services/game_leaderboard.rb
@@ -0,0 +1,30 @@
+class GameLeaderboard
+  def initialize(game)
+    @game = game
+  end
+
+  # Called inside the end transition's write transaction, after all picks are
+  # locked. The results are then immutable except for the separate winner marks.
+  def finalize!
+    correct_options = @game.rounds.map do |round|
+      round.fetch("options").map { |option| option.fetch("correct") }
+    end
+    scores = Hash.new { |hash, id| hash[id] = [0, 0, 0] }
+    @game.answers.pluck(:game_player_id, :round_index, :option_index, :elapsed_us).each do |id, round, option, elapsed|
+      next unless correct_options.fetch(round).fetch(option)
+
+      score = scores[id]
+      score[0] += 1
+      score[1] += 1 if elapsed.nil? # Legacy correct picks have no recorded time.
+      score[2] += elapsed.to_i
+    end
+
+    players = @game.players.sort_by do |player|
+      points, missing, time = scores[player.id]
+      [-points, missing, time, player.id]
+    end
+    players.each_with_index do |player, index|
+      player.update!(place: index + 1, points: scores[player.id].first)
+    end
+  end
+end
