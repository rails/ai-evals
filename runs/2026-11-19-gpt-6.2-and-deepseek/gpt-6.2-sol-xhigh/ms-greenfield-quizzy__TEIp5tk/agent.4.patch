@@ -0,0 +1,38 @@
+class AddGamePrizes < ActiveRecord::Migration[8.1]
+  def up
+    add_column :quizzes, :number_of_winners, :integer, limit: 8, default: 3, null: false
+    add_column :games, :number_of_winners, :integer, limit: 8, default: 3, null: false
+    add_column :games, :round_opened_at, :datetime
+    add_column :game_answers, :elapsed_us, :integer, limit: 8
+    add_column :game_players, :points, :integer, default: 0, null: false
+    add_column :game_players, :place, :integer
+    add_column :game_players, :winner, :boolean, default: false, null: false
+
+    # A previously open round last changed when it opened. Times for historical
+    # picks are unavailable, but we can still recover the scores of ended games.
+    execute "UPDATE games SET round_opened_at = updated_at WHERE phase = 'open'"
+    execute <<~SQL
+      WITH scores AS (
+        SELECT p.id, p.game_id,
+          COUNT(CASE WHEN json_extract(g.rounds, '$[' || a.round_index || '].options[' ||
+            a.option_index || '].correct') = 1 THEN 1 END) AS points
+        FROM game_players p JOIN games g ON g.id = p.game_id
+        LEFT JOIN game_answers a ON a.game_player_id = p.id
+        WHERE g.phase = 'ended'
+        GROUP BY p.id
+      ), ranked AS (
+        SELECT id, points, ROW_NUMBER() OVER (PARTITION BY game_id ORDER BY points DESC, id) AS place
+        FROM scores
+      )
+      UPDATE game_players SET points = ranked.points, place = ranked.place
+      FROM ranked WHERE game_players.id = ranked.id
+    SQL
+  end
+
+  def down
+    remove_columns :game_players, :points, :place, :winner
+    remove_column :game_answers, :elapsed_us
+    remove_columns :games, :number_of_winners, :round_opened_at
+    remove_column :quizzes, :number_of_winners
+  end
+end
