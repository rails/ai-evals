+      assert_text "1 point"
+      assert_no_text "You won!"
+    end
+
+    click_button "Draw"
+    Capybara.using_session(:screen) do
+      assert_selector "ol.leaderboard > li", text: /Ada.*Winner.*1 point/m, wait: 2
+      assert_same_document
