new file mode 100644
index 0000000..59f97aa
--- /dev/null
+++ b/app/services/round_expiry.rb
@@ -0,0 +1,13 @@
+class RoundExpiry
+  def self.sweep
+    Game.open.where(round_deadline_at: ..Time.current).find_each do |game|
+      reconcile(game)
+    rescue ActiveRecord::RecordNotFound
+      # The moderator deleted the quiz between the scan and the lock.
+    end
+  end
+
+  def self.reconcile(game)
+    GameUpdatesChannel.publish(game.code) if game.finish_expired_round
+  end
+end
