@@ -33,3 +33,19 @@ plugin :tmp_restart
 # Specify the PID file. Defaults to tmp/pids/server.pid in development.
 # In other environments, only set the PID file if requested.
 pidfile ENV["PIDFILE"] if ENV["PIDFILE"]
+
+# Check persisted deadlines even when no browsers are connected. A restart
+# will pick up any expired open rounds from SQLite on the next sweep.
+after_booted do
+  Thread.new do
+    Thread.current.name = "quizzy-round-expiry"
+    loop do
+      begin
+        Rails.application.reloader.wrap { RoundExpiry.sweep }
+      rescue StandardError => error
+        Rails.error.report(error, handled: true, source: "quizzy.round_expiry")
+      end
+      sleep 0.25
+    end
+  end
+end
