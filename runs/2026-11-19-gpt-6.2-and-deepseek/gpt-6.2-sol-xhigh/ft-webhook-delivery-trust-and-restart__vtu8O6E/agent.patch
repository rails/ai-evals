+++ b/test/models/webhook/dispatch_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Webhook::DispatchTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @card = cards(:logo)
+    @creator = users(:kevin)
+  end
+
+  test "only active webhooks subscribed to the event on its board get a delivery" do
+    matching = create_webhook(@card.board, subscribed_actions: %w[card_closed])
+    create_webhook(@card.board, subscribed_actions: %w[card_closed], active: false)
+    create_webhook(@card.board, subscribed_actions: %w[card_published])
+    create_webhook(boards(:private), subscribed_actions: %w[card_closed])
+    create_webhook(boards(:miltons_wish_list), subscribed_actions: %w[card_closed])
+
+    assert_enqueued_jobs 2, only: Webhook::DeliveryJob do
+      event = @card.track_event(:closed, creator: @creator)
+      assert_equal [ @webhook.id, matching.id ].sort, event.webhook_deliveries.pluck(:webhook_id).sort
+    end
+  end
+
+  test "an event that rolls back does not leave a delivery or enqueue a job" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference -> { Webhook::Delivery.count } do
+        Event.transaction(requires_new: true) do
+          @card.track_event(:closed, creator: @creator)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "a comment delivery contains a link to the comment on its board" do
+    @webhook.update! subscribed_actions: %w[comment_created]
+    stub_dns_resolution("93.184.216.34")
+
+    comment = @card.comments.create!(body: "Looks good!", creator: @creator)
+    delivery = comment.events.last.webhook_deliveries.sole
+    outbound = stub_request(:post, @webhook.url).with do |request|
+      event = JSON.parse(request.body).fetch("event")
+      event.fetch("action") == "comment_created" && event.fetch("eventable") == {
+        "type" => "Comment", "id" => comment.id,
+        "url" => "http://example.com#{@webhook.account.slug}/cards/#{@card.number}#comment_#{comment.id}"
+      }
+    end
+
+    delivery.deliver
+    assert_requested outbound, times: 1
+  end
+
+  private
+    def create_webhook(board, **attributes)
+      board.webhooks.create! name: "Receiver", url: "https://example.com/webhook", **attributes
+    end
+end
diff --git a/test/models/webhook/reliability_test.rb b/test/models/webhook/reliability_test.rb
new file mode 100644
index 0000000..4c394de
--- /dev/null
+++ b/test/models/webhook/reliability_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Webhook::ReliabilityTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "a second job cannot send a delivery while its POST is in progress" do
+    delivery = new_delivery
+    outbound = stub_request(:post, @webhook.url).to_return do
+      assert delivery.reload.in_progress?
+      Webhook::DeliveryJob.perform_now Webhook::Delivery.find(delivery.id)
+      { status: 204 }
+    end
+
+    Webhook::DeliveryJob.perform_now delivery
+
+    assert_requested outbound, times: 1
+    assert delivery.reload.succeeded?
+  end
+
+  test "there can only be one delivery per webhook and event" do
+    delivery = new_delivery
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      @webhook.deliveries.create! event: delivery.event
+    end
+  end
+
+  test "ten consecutive failures spanning an hour deactivate a webhook and cancel queued deliveries" do
+    outbound = stub_request(:post, @webhook.url).to_return(status: 503)
+    first = new_delivery
+    first.deliver
+    assert first.failed?
+    assert_equal 503, first.response_summary[:code]
+
+    travel 1.hour, with_usec: true do
+      8.times { new_delivery.deliver }
+      assert @webhook.reload.active?
+
+      queued = new_delivery
+      new_delivery.deliver
+      assert_not @webhook.reload.active?
+
+      queued.deliver
+      assert_equal "webhook_inactive", queued.response_summary[:error]
+      assert_requested outbound, times: 10
+      assert_empty new_event.webhook_deliveries
+
+      @webhook.activate
+      assert @webhook.active?
+      assert_nil @webhook.delinquency_tracker.first_failure_at
+      new_delivery.deliver
+      assert @webhook.reload.active?
+      assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+    end
+  end
+
+  test "a short burst of failures does not deactivate a webhook and success resets the streak" do
+    stub_request(:post, @webhook.url).to_return(status: 422)
+    10.times { new_delivery.deliver }
+    assert @webhook.reload.active?
+    assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+
+    stub_request(:post, @webhook.url).to_return(status: 299)
+    new_delivery.deliver
+    assert_nil @webhook.reload.delinquency_tracker.first_failure_at
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "a timeout is logged as a failure and is not retried" do
+    outbound = stub_request(:post, @webhook.url).to_timeout
+    delivery = new_delivery
+    2.times { delivery.deliver }
+
+    assert_requested outbound, times: 1
+    assert delivery.errored?
+    assert_equal "timeout", delivery.response_summary[:error]
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "cleanup drops deliveries older than a week, not recent ones" do
+    now = Time.current.change(usec: 0)
+    travel_to now do
+      old = new_delivery
+      old.update!(created_at: 1.week.ago - 1.second)
+      at_cutoff = new_delivery
+      at_cutoff.update!(created_at: 1.week.ago)
+      recent = new_delivery
+      recent.update!(created_at: 1.day.ago)
+
+      Webhook::Delivery.cleanup
+
+      assert_not Webhook::Delivery.exists?(old.id)
+      assert Webhook::Delivery.exists?(at_cutoff.id)
+      assert Webhook::Delivery.exists?(recent.id)
+    end
+  end
+
+  private
+    def new_delivery
+      new_event.webhook_deliveries.sole
+    end
+
+    def new_event
+      cards(:logo).track_event(:closed, creator: users(:kevin))
+    end
+end
diff --git a/test/models/webhook/request_test.rb b/test/models/webhook/request_test.rb
new file mode 100644
index 0000000..a1b4bd5
--- /dev/null
+++ b/test/models/webhook/request_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Webhook::RequestTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+  end
+
+  test "a host with no public address is not contacted" do
+    stub_dns_resolution("192.168.1.1")
+    Net::HTTP.expects(:new).never
+
+    delivery = deliver_event
+
+    assert delivery.errored?
+    assert_equal "destination_unreachable", delivery.response_summary[:error]
+  end
+
+  test "an existing webhook with a malformed URL is logged without connecting" do
+    @webhook.update_column :url, "https:"
+    Net::HTTP.expects(:new).never
+
+    delivery = deliver_event
+
+    assert delivery.errored?
+    assert_equal "destination_unreachable", delivery.response_summary[:error]
+  end
+
+  test "a redirect is logged without sending a second HTTP request" do
+    stub_dns_resolution("93.184.216.34")
+    target = "https://example.net/redirected"
+    stub_request(:post, @webhook.url).to_return(status: 307, headers: { "Location" => target })
+    redirected_post = stub_request(:post, target)
+    redirected_get = stub_request(:get, target)
+
+    delivery = deliver_event
+
+    assert delivery.failed?
+    assert_equal 307, delivery.response_summary[:code]
+    assert_not_requested redirected_post
+    assert_not_requested redirected_get
+  end
+
+  test "chat webhook messages are snapshotted before the card can change" do
+    stub_dns_resolution("93.184.216.34")
+    slack_webhook = @webhook.board.webhooks.create!(name: "Slack",
+      url: "https://hooks.slack.com/services/T123/B123/fake", subscribed_actions: %w[card_closed])
+    campfire_webhook = @webhook.board.webhooks.create!(name: "Campfire",
+      url: "https://campfire.example.com/rooms/123/456-room-name/messages", subscribed_actions: %w[card_closed])
+
+    card = cards(:logo)
+    title = card.title
+    event = card.track_event(:closed, creator: users(:kevin))
+    card.update_column :title, "Changed after delivery was queued"
+
+    slack = stub_request(:post, slack_webhook.url).with do |request|
+      JSON.parse(request.body).fetch("text").include?(title)
+    end
+    campfire = stub_request(:post, campfire_webhook.url).with do |request|
+      CGI.unescapeHTML(JSON.parse(request.body).fetch("content")).include?(title)
+    end
+    stub_request(:post, @webhook.url)
+
+    event.webhook_deliveries.each(&:deliver)
+
+    assert_requested slack, times: 1
+    assert_requested campfire, times: 1
+  end
+
+  private
+    def deliver_event
+      cards(:logo).track_event(:closed, creator: users(:kevin)).webhook_deliveries.sole.tap(&:deliver)
+    end
+end
