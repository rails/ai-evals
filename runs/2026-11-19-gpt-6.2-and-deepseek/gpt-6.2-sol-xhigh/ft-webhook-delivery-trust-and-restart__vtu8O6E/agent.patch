@@ -27,6 +42,46 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && (200..299).cover?(response[:code])
   end
+
+  private
+    def snapshot_payload
+      # Capture the event before its card or comment can change.
+      self.request = { body: Webhook::Payload.new(self).to_json }
+    end
+
+    def deliver_later
+      Current.with_account(account) { Webhook::DeliveryJob.perform_later(self) }
+    end
+
+    def claim
+      receiver = webhook
+      receiver.with_lock do
+        if reload.pending?
+          receiver.active? ? start : skip
+        end
+      end
+    end
+
+    def start
+      Webhook::Request.new(self).tap do |outbound|
+        # Commit the claim before sending. A repeat job must never send this POST again.
+        update!(state: :in_progress, request: { body: outbound.body, headers: outbound.headers.except("X-Webhook-Signature") })
+      end
+    end
+
+    def skip
+      update!(state: :errored, response: { error: "webhook_inactive" })
+      nil
+    end
+
+    def finish(result)
+      receiver = webhook
+      receiver.with_lock do
+        reload
+        update!(state: result[:error] ? :errored : :completed, response: result)
+        receiver.record_delivery_result(self)
+      end
+    end
 end
