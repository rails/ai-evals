diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..2b6018e
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,20 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_PERIOD = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure
+    update! first_failure_at: first_failure_at || Time.current,
+      consecutive_failures_count: consecutive_failures_count.to_i + 1
+  end
+
+  def delinquent?
+    consecutive_failures_count.to_i >= FAILURE_THRESHOLD && first_failure_at.present? && first_failure_at <= FAILURE_PERIOD.ago
+  end
+
+  def reset
+    update! first_failure_at: nil, consecutive_failures_count: 0 if first_failure_at
+  end
+end
