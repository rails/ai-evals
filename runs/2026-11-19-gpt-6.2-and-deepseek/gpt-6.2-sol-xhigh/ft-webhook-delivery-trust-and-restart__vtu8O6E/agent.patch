@@ -0,0 +1,53 @@
+require "cgi"
+
+class Webhook::Payload
+  def initialize(delivery)
+    @webhook = delivery.webhook
+    @event = delivery.event
+  end
+
+  def as_json(*)
+    payload = {
+      event: {
+        id: @event.id,
+        action: @event.action,
+        created_at: @event.created_at.utc,
+        particulars: @event.api_particulars,
+        creator: { id: @event.creator_id, name: @event.creator.name },
+        eventable: { id: @event.eventable_id, type: @event.eventable_type, url: eventable_url }
+      },
+      board: { id: @webhook.board_id }
+    }
+
+    if @webhook.for_slack?
+      payload[:text] = "#{slack_description}\n#{eventable_url}"
+    elsif @webhook.for_basecamp? || @webhook.for_campfire?
+      payload[:content] = "#{description}<br>#{ERB::Util.html_escape(eventable_url)}"
+    end
+
+    payload
+  end
+
+  private
+    def slack_description
+      CGI.unescapeHTML(description).gsub(/[&<>]/, "&" => "&amp;", "<" => "&lt;", ">" => "&gt;")
+    end
+
+    def description
+      @event.description_for(nil).to_plain_text
+    end
+
+    def eventable_url
+      @eventable_url ||= begin
+        routes = Rails.application.routes
+        options = routes.default_url_options.presence || Rails.application.config.action_mailer.default_url_options || {}
+        options = options.merge(script_name: @webhook.account.slug)
+
+        if options[:host].present?
+          routes.url_helpers.polymorphic_url(@event.eventable, options)
+        else
+          routes.url_helpers.polymorphic_path(@event.eventable, options)
+        end
+      end
+    end
+end
diff --git a/app/models/webhook/request.rb b/app/models/webhook/request.rb
new file mode 100644
index 0000000..3bf11f3
--- /dev/null
+++ b/app/models/webhook/request.rb
@@ -0,0 +1,62 @@
+require "net/http"
+require "openssl"
+require "resolv"
+
+class Webhook::Request
+  TIMEOUT = 10
+
+  attr_reader :body, :headers
+
+  def initialize(delivery)
+    @url = delivery.webhook.url
+    @body = delivery.request[:body] || Webhook::Payload.new(delivery).to_json
+    @headers = {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Delivery-Id" => delivery.id,
+      "X-Webhook-Timestamp" => Time.current.utc.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", delivery.webhook.signing_secret, body)
+    }
+  end
+
+  def post
+    Timeout.timeout(TIMEOUT) do
+      @uri = URI.parse(@url)
+      if ip = public_ip
+        request = Net::HTTP::Post.new(@uri, headers)
+        request.body = body
+        response = connection(ip).request(request) { |reply| reply.read_body { } }
+        { code: response.code.to_i }
+      else
+        { error: "destination_unreachable" }
+      end
+    end
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError,
+      Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError, Net::ProtocolError, Resolv::ResolvError, URI::InvalidURIError
+    { error: "destination_unreachable" }
+  end
+
+  private
+    def public_ip
+      hostname = @uri.hostname
+      return unless @uri.is_a?(URI::HTTP) && hostname.present? && (1..65_535).cover?(@uri.port)
+
+      if Resolv::AddressRegex.match?(hostname)
+        hostname unless SsrfProtection.blocked_address?(hostname)
+      else
+        SsrfProtection.resolve_public_ip(hostname)
+      end
+    end
+
+    def connection(ip)
+      # Use the checked address without a second DNS lookup or an environment proxy.
+      Net::HTTP.new(@uri.hostname, @uri.port, nil).tap do |http|
+        http.ipaddr = ip
+        http.use_ssl = @uri.scheme == "https"
+        http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+        http.max_retries = 0
+      end
+    end
+end
