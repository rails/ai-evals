+  test "auto postpone all due only postpones active cards at or before the cutoff" do
+    freeze_time
+
+    cutoff = Time.current - entropies(:writebook_board).auto_postpone_period
+    due, recent, drafted, closed, postponed = cards(:logo, :text, :layout, :shipping, :buy_domain)
+    drafted.drafted!
+    postponed.postpone
