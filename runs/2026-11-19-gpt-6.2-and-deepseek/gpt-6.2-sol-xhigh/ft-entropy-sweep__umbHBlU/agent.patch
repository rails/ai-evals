index ebaad78..81a8d09 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -25,10 +25,33 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      system_users = {}
+
+      each_card_due_to_be_postponed do |card|
+        card.auto_postpone(user: system_users[card.account_id] ||= card.account.system_user)
       end
     end
+
+    private
+      def each_card_due_to_be_postponed(&block)
+        if connection.adapter_name == "SQLite"
+          each_card_due_to_be_postponed_by_board(&block)
+        else
+          due_to_be_postponed.find_each(&block)
+        end
+      end
+
+      def each_card_due_to_be_postponed_by_board(&block)
+        # Match the whole-second cutoff from SQLite's datetime().
+        now = Time.now.change(usec: 0)
+
+        Board.joins(:account).preload(:entropy, account: :entropy).find_each do |board|
+          if period = board.entropy&.auto_postpone_period
+            # A fixed cutoff lets SQLite seek into the board's activity index instead of joining entropy for each card.
+            active.where(board: board, last_active_at: ..(now - period)).find_each(cursor: [ :last_active_at, :id ], &block)
+          end
+        end
+      end
   end
 
   def entropy
