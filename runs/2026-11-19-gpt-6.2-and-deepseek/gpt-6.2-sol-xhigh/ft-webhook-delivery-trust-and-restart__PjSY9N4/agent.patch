+  def deliver_later
+    ActiveRecord.after_all_transactions_commit { enqueue }
+  end
+
+  def deliver_now
+    return unless pending? && claim
+
+    outgoing_request = Webhook::Request.new(self)
+    result = outgoing_request.post
+    finish(request: { headers: outgoing_request.logged_headers }, response: result)
