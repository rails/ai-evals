@@ -0,0 +1,188 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    stub_dns_resolution(WEB_PUSH_PUBLIC_TEST_IP)
+  end
+
+  test "publishing a card sends a signed POST once and records the result" do
+    payload = headers = nil
+    request = stub_request(:post, @webhook.url).with(ipaddr: WEB_PUSH_PUBLIC_TEST_IP).to_return do |post|
+      payload = JSON.parse(post.body)
+      headers = post.headers
+      assert_equal "application/json", headers["Content-Type"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, post.body), headers["X-Webhook-Signature"]
+      { status: 204 }
+    end
+
+    card = nil
+    perform_enqueued_jobs(only: Webhook::DeliveryJob) do
+      Current.set(user: users(:david)) do
+        card = @webhook.board.cards.create!(title: "A new card", status: :published)
+      end
+    end
+
+    event = card.events.find_by!(action: "card_published")
+    delivery = @webhook.deliveries.find_by!(event: event)
+    assert delivery.succeeded?
+    assert_equal 204, delivery.response_summary[:code]
+    assert_not delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+    assert_equal delivery.id, headers["X-Webhook-Delivery"]
+    assert_equal delivery.sanitized_request[:headers]["X-Webhook-Timestamp"], headers["X-Webhook-Timestamp"]
+    assert_equal event.id, payload["id"]
+    assert_equal "card_published", payload["action"]
+    assert_equal @webhook.board_id, payload.dig("board", "id")
+    assert_equal card.id, payload.dig("eventable", "id")
+    assert_equal "#{card.account.slug}/cards/#{card.number}", URI.parse(payload.dig("eventable", "url")).path
+
+    Webhook::DeliveryJob.perform_now(delivery.id, @webhook.id)
+    assert_requested request, times: 1
+  end
+
+  test "recovers a committed delivery that never reached the queue" do
+    Webhook::DeliveryJob.expects(:perform_later).once.raises(SolidQueue::Job::EnqueueError, "queue unavailable")
+    delivery = new_delivery
+    assert delivery.awaiting_enqueue?
+    assert delivery.pending?
+    Webhook::DeliveryJob.unstub(:perform_later)
+
+    travel 2.minutes do
+      assert_enqueued_with job: Webhook::DeliveryJob, args: [ delivery.id, @webhook.id ] do
+        Webhook::Delivery.enqueue_pending
+      end
+      assert_not delivery.reload.awaiting_enqueue?
+
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        Webhook::Delivery.enqueue_pending
+      end
+
+      request = stub_request(:post, @webhook.url).to_return(status: 200)
+      perform_enqueued_jobs(only: Webhook::DeliveryJob)
+      assert delivery.reload.succeeded?
+      assert_requested request, times: 1
+    end
+  end
+
+  test "an overlapping job cannot claim the same delivery twice" do
+    delivery = new_delivery
+    duplicate = Webhook::Delivery.find(delivery.id)
+    calls = 0
+    request = stub_request(:post, @webhook.url).to_return do
+      assert_equal 0, calls
+      calls += 1
+      assert delivery.reload.in_progress?
+      duplicate.deliver_now
+      { status: 200 }
+    end
+
+    Webhook::DeliveryJob.perform_now(delivery.id, @webhook.id)
+
+    assert delivery.reload.succeeded?
+    assert_requested request, times: 1
+  end
+
+  test "logs an unsuccessful HTTP status without following redirects or retrying" do
+    delivery = new_delivery
+    redirected = stub_request(:post, "https://other.example.com/receiver").to_return(status: 200)
+    request = stub_request(:post, @webhook.url).to_return(status: 307, headers: { "Location" => "https://other.example.com/receiver" })
+
+    2.times { Webhook::DeliveryJob.perform_now(delivery.id, @webhook.id) }
+
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal({ code: 307, error: nil }, delivery.response_summary)
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+    assert_requested request, times: 1
+    assert_not_requested redirected
+  end
+
+  test "logs timeouts without retrying" do
+    delivery = new_delivery
+    request = stub_request(:post, @webhook.url).to_timeout
+
+    2.times { Webhook::DeliveryJob.perform_now(delivery.id, @webhook.id) }
+
+    assert delivery.reload.errored?
+    assert_equal({ code: nil, error: "timeout" }, delivery.response_summary)
+    assert_requested request, times: 1
+  end
+
+  test "logs a blocked destination without sending a request" do
+    stub_dns_resolution("127.0.0.1")
+    delivery = new_delivery
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    Webhook::DeliveryJob.perform_now(delivery.id, @webhook.id)
+
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response_summary[:error]
+    assert_not_requested request
+  end
+
+  test "does not contact a receiver that has been disabled since the event" do
+    delivery = new_delivery
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+    @webhook.deactivate
+
+    Webhook::DeliveryJob.perform_now(delivery.id, @webhook.id)
+
+    assert delivery.reload.errored?
+    assert_equal "webhook_inactive", delivery.response_summary[:error]
+    assert_not_requested request
+  end
+
+  test "disables a receiver after a run of ten failures spanning an hour" do
+    request = stub_request(:post, @webhook.url).to_return(status: 503)
+
+    travel_to Time.current do
+      deliver_next_event
+      travel 1.hour
+      8.times { deliver_next_event }
+      assert @webhook.reload.active?
+
+      deliver_next_event
+      assert_not @webhook.reload.active?
+      assert_nil new_delivery
+    end
+
+    assert_requested request, times: 10
+    @webhook.activate
+    assert @webhook.active?
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "a burst of failures does not disable a receiver and a success resets its streak" do
+    stub_request(:post, @webhook.url).to_return({ status: 503 }).times(10).then.to_return({ status: 200 }).then.to_timeout
+
+    travel_to Time.current do
+      10.times { deliver_next_event }
+      assert @webhook.reload.active?
+      assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+
+      travel 2.hours
+      assert deliver_next_event.succeeded?
+      assert_equal 0, @webhook.reload.delinquency_tracker.consecutive_failures_count
+      assert_nil @webhook.delinquency_tracker.first_failure_at
+
+      deliver_next_event
+      assert @webhook.reload.active?
+      assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+      assert_equal Time.current, @webhook.delinquency_tracker.first_failure_at
+    end
+  end
+
+  private
+    def new_delivery
+      event = cards(:logo).track_event(:published, creator: users(:david))
+      event.webhook_deliveries.find_by(webhook: @webhook)
+    end
+
+    def deliver_next_event
+      new_delivery.tap do |delivery|
+        Webhook::DeliveryJob.perform_now(delivery.id, @webhook.id)
+        delivery.reload
+      end
+    end
+end
