+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  test "chat integrations get a message rather than the generic event payload" do
+    delivery = webhook_deliveries(:successfully_completed)
+
+    {
+      "https://hooks.slack.com/services/T123/B123/example" => :text,
+      "https://chat.example.com/rooms/123/456-room/messages" => :text,
+      "https://3.basecamp.com/123/integrations/example/buckets/456/chats/789/lines" => :content
+    }.each do |url, key|
+      delivery.webhook.url = url
+      payload = Webhook::Payload.new(delivery).to_h
+      assert_includes payload.fetch(key), 'added "'
+      assert_includes payload.fetch(key), "#{delivery.account.slug}/cards/#{delivery.event.card.number}"
+    end
+  end
+
+  test "includes comment and assignment details for standard receivers" do
+    webhook = webhooks(:active)
+    comment_delivery = webhook.deliveries.build(event: events(:layout_commented))
+    payload = Webhook::Payload.new(comment_delivery).to_h
+    assert_equal "Comment", payload.dig(:eventable, :type)
+    assert_equal events(:layout_commented).eventable_id, payload.dig(:eventable, :id)
+
+    assignment_delivery = webhook_deliveries(:unsuccessfully_completed)
+    payload = Webhook::Payload.new(assignment_delivery).to_h
+    assert_equal [ users(:jz).id ], payload.dig(:particulars, "assignee_ids")
+  end
+end
