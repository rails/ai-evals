diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..da11263
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,19 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_LIMIT = 10
+  GRACE_PERIOD = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure
+    update!(first_failure_at: first_failure_at || Time.current, consecutive_failures_count: consecutive_failures_count.to_i + 1)
+  end
+
+  def reset
+    update!(first_failure_at: nil, consecutive_failures_count: 0) if first_failure_at || consecutive_failures_count.to_i.positive?
+  end
+
+  def delinquent?
+    consecutive_failures_count.to_i >= FAILURE_LIMIT && first_failure_at.present? && first_failure_at <= GRACE_PERIOD.ago
+  end
+end
