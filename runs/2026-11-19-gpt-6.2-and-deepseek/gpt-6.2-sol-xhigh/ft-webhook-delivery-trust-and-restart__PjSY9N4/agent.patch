@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Event::DispatchableTest < ActiveSupport::TestCase
+  test "only active webhooks on the event's board subscribed to its action are enqueued" do
+    active = webhooks(:active)
+    matching = active.board.webhooks.create!(name: "Another subscriber", url: "https://example.com/one", subscribed_actions: [ "card_published" ])
+    active.board.webhooks.create!(name: "Inactive", url: "https://example.com/two", subscribed_actions: [ "card_published" ], active: false)
+    active.board.webhooks.create!(name: "Other action", url: "https://example.com/three", subscribed_actions: [ "card_closed" ])
+    active.board.webhooks.create!(name: "No subscriptions", url: "https://example.com/four")
+    webhooks(:inactive).activate
+
+    event = nil
+    assert_enqueued_jobs 2, only: Webhook::DeliveryJob do
+      event = cards(:logo).track_event(:published, creator: users(:david))
+    end
+
+    assert_equal [ active.id, matching.id ].sort, event.webhook_deliveries.pluck(:webhook_id).sort
+  end
+
+  test "rolled back events don't leave deliveries or enqueue jobs" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference "Webhook::Delivery.count" do
+        Event.transaction(requires_new: true) do
+          cards(:logo).track_event(:published, creator: users(:david))
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "moving a card does not reroute earlier events to the destination board" do
+    Current.user = users(:david)
+    card = cards(:logo)
+    destination = boards(:private)
+    destination.webhooks.create!(name: "Destination", url: "https://example.com/destination", subscribed_actions: [ "card_published" ])
+
+    event = nil
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      Card.transaction do
+        event = card.track_event(:published)
+        card.move_to(destination)
+      end
+    end
+
+    assert_equal destination, event.reload.board
+    assert_equal [ webhooks(:active).id ], event.webhook_deliveries.pluck(:webhook_id)
+  end
+end
