+module Event::Dispatchable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :webhook_deliveries, class_name: "Webhook::Delivery", dependent: :delete_all
+
+    after_create :prepare_webhook_deliveries, if: :webhook_action?
+  end
+
+  private
+    def webhook_action?
+      action.in?(Webhook::PERMITTED_ACTIONS)
+    end
+
+    def prepare_webhook_deliveries
+      board.webhooks.active.find_each do |webhook|
+        if webhook.subscribed_actions.include?(action)
+          webhook_deliveries.create!(webhook: webhook, awaiting_enqueue: true).deliver_later
+        end
+      end
+    end
+end
