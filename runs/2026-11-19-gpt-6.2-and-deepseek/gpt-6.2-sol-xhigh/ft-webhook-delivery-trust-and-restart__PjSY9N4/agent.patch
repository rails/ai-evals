@@ -27,6 +51,54 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].in?(200..299)
   end
+
+  private
+    def enqueue
+      Current.with_account(account) do
+        if Webhook::DeliveryJob.perform_later(id, webhook_id)
+          self.class.where(id: id, awaiting_enqueue: true).update_all(awaiting_enqueue: false)
+        end
+      end
+    rescue SolidQueue::Job::EnqueueError => error
+      # The pending delivery is still there for the next enqueue sweep.
+      Rails.error.report(error, context: { delivery_id: id })
+    end
+
+    def claim
+      with_receiver_lock do |receiver|
+        if receiver.active?
+          # Commit the claim before sending. A duplicate job must never repeat a POST.
+          transition(:pending, state: :in_progress, awaiting_enqueue: false)
+        else
+          transition(:pending, state: :errored, awaiting_enqueue: false, response: { error: "webhook_inactive" })
+          false
+        end
+      end
+    end
+
+    def finish(request:, response:)
+      with_receiver_lock do |receiver|
+        if transition(:in_progress, state: response[:error] ? :errored : :completed, request: request, response: response)
+          receiver.track_delivery(self)
+        end
+      end
+    end
+
+    def transition(from, **attributes)
+      if self.class.where(id: id, state: from).update_all(**attributes, updated_at: Time.current) == 1
+        assign_attributes(attributes)
+        true
+      end
+    end
+
+    def with_receiver_lock
+      Webhook.transaction do
+        if receiver = Webhook.lock.find_by(id: webhook_id)
+          self.webhook = receiver
+          yield receiver
+        end
+      end
+    end
 end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..a761cef
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,48 @@
+class Webhook::Payload
+  def initialize(delivery)
+    @event = delivery.event
+    @webhook = delivery.webhook
+  end
+
+  def to_h
+    if webhook.for_slack?
+      { text: message, mrkdwn: false }
+    elsif webhook.for_basecamp?
+      { content: message }
+    elsif webhook.for_campfire?
+      { text: message }
+    else
+      event_data
+    end
+  end
+
+  private
+    attr_reader :event, :webhook
+
+    def event_data
+      {
+        id: event.id,
+        action: event.action,
+        created_at: event.created_at.utc,
+        board: { id: webhook.board_id },
+        creator: { id: event.creator_id, name: event.creator.name },
+        eventable: { type: event.eventable_type, id: event.eventable_id, url: event_url },
+        particulars: event.api_particulars
+      }
+    end
+
+    def message
+      # Cards can move after a delivery is queued. Don't copy content from another board.
+      if event.card.board_id == webhook.board_id
+        "#{CGI.unescapeHTML(event.description_for(nil).to_plain_text)}: #{event_url}"
+      else
+        "#{event.action.humanize}: #{event_url}"
+      end
+    end
+
+    def event_url
+      options = Rails.application.routes.default_url_options.presence || Rails.application.config.action_mailer.default_url_options || {}
+      Rails.application.routes.url_helpers.polymorphic_url(event.eventable,
+        **options, script_name: webhook.account.slug, only_path: options[:host].blank?)
+    end
+end
diff --git a/app/models/webhook/request.rb b/app/models/webhook/request.rb
new file mode 100644
index 0000000..bf850ba
--- /dev/null
+++ b/app/models/webhook/request.rb
@@ -0,0 +1,68 @@
+require "net/http"
+require "openssl"
+require "timeout"
+
+class Webhook::Request
+  def initialize(delivery)
+    @url = delivery.webhook.url
+    @body = Webhook::Payload.new(delivery).to_h.to_json
+    @headers = {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Delivery" => delivery.id,
+      "X-Webhook-Timestamp" => Time.current.utc.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", delivery.webhook.signing_secret, @body)
+    }
+  end
+
+  def logged_headers
+    @headers.except("X-Webhook-Signature")
+  end
+
+  def post
+    @uri = URI.parse(@url)
+
+    Timeout.timeout(10) do
+      if ip_address = destination_ip
+        request = Net::HTTP::Post.new(@uri, @headers)
+        request.body = @body
+
+        # Only the status is needed; don't download or store the receiver's response body.
+        connection(ip_address).request(request) { |response| return { code: response.code.to_i } }
+      else
+        { error: "destination_unreachable" }
+      end
+    end
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue URI::InvalidURIError, SocketError, SystemCallError, IOError, Resolv::ResolvError, Net::HTTPBadResponse, Net::ProtocolError, OpenSSL::SSL::SSLError
+    { error: "destination_unreachable" }
+  end
+
+  private
+    def destination_ip
+      if @uri.is_a?(URI::HTTP) && @uri.hostname.present? && !@uri.userinfo && @uri.port.in?(1..65_535)
+        if ip = literal_ip
+          ip.to_s unless SsrfProtection.blocked_address?(ip)
+        else
+          SsrfProtection.resolve_public_ip(@uri.hostname)
+        end
+      end
+    end
+
+    def literal_ip
+      IPAddr.new(@uri.hostname)
+    rescue IPAddr::InvalidAddressError
+      nil
+    end
+
+    def connection(ip_address)
+      Net::HTTP.new(@uri.hostname, @uri.port, nil).tap do |http|
+        # Keep the original host for TLS verification, but don't resolve it again or go through a proxy.
+        http.ipaddr = ip_address
+        http.use_ssl = @uri.scheme == "https"
+        http.open_timeout = http.read_timeout = http.write_timeout = 5
+        http.max_retries = 0
+      end
+    end
+end
