@@ -1,7 +1,28 @@
 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  # Resque can immediately requeue a job without resque-scheduler.
+  self.resume_options = {}
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :clean_titles do |step|
+      progress = TitleCleanupProgress.find_or_create_by!(id: 1)
+      unless progress.completed?
+        remaining = Leaf.all
+        remaining = remaining.where("id > ?", progress.last_leaf_id) if progress.last_leaf_id
+        remaining.find_each do |leaf|
+          progress.with_lock do
+            unless progress.completed? || (progress.last_leaf_id && leaf.id <= progress.last_leaf_id)
+              # Commit the destructive edit and its checkpoint together.
+              current_leaf = Leaf.find_by(id: leaf.id)
+              current_leaf&.update!(title: cleaned(current_leaf.title))
+              progress.update!(last_leaf_id: leaf.id)
+            end
+          end
+          step.checkpoint!
+        end
+        progress.with_lock { progress.update!(completed: true) }
+      end
     end
   end
 
