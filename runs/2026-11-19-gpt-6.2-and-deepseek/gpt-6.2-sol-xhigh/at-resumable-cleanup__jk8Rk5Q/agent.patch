new file mode 100644
index 0000000..d048caa
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  test "resumes after a worker stops without stripping inner quotes" do
+    first, second = Leaf.order(:id).first(2)
+    first.update!(title: '""First phrase" and more"')
+    second.update!(title: '""Second phrase""')
+    adapter = TitleCleanupJob.queue_adapter
+
+    adapter.stopping = true
+    assert_enqueued_jobs 1 do
+      TitleCleanupJob.perform_now
+    end
+    assert_equal '"First phrase" and more', first.reload.title
+    assert_equal '""Second phrase""', second.reload.title
+
+    adapter.stopping = false
+    perform_enqueued_jobs
+    assert_equal '"First phrase" and more', first.reload.title
+    assert_equal '"Second phrase"', second.reload.title
+
+    TitleCleanupJob.perform_now
+    assert_equal '"Second phrase"', second.reload.title
+  ensure
+    adapter.stopping = false if adapter
+  end
+
+  test "a fresh job resumes from the committed database checkpoint" do
+    first, second = Leaf.order(:id).first(2)
+    first.update!(title: '""First phrase""')
+    second.update!(title: '"Second title"')
+    interrupted_job = TitleCleanupJob.new
+    def interrupted_job.checkpoint!
+      raise "worker lost"
+    end
+
+    assert_raises(RuntimeError) { interrupted_job.perform_now }
+    assert_equal first.id, TitleCleanupProgress.sole.last_leaf_id
+    assert_equal '"First phrase"', first.reload.title
+    assert_equal '"Second title"', second.reload.title
+
+    TitleCleanupJob.perform_now
+    assert_equal '"First phrase"', first.reload.title
+    assert_equal "Second title", second.reload.title
+  end
+end
