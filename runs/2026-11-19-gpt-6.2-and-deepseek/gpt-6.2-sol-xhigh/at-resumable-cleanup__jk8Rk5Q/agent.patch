new file mode 100644
index 0000000..966661e
--- /dev/null
+++ b/config/initializers/resque_shutdown.rb
@@ -0,0 +1,12 @@
+if Rails.application.config.active_job.queue_adapter == :resque
+  # The production pool runs with FORK_PER_JOB=false, so the worker's signal
+  # handler and Active Job checkpoints share the same process.
+  module ResqueShutdown
+    def shutdown
+      super
+      ActiveJob::Base.queue_adapter.stopping = true
+    end
+  end
+
+  Resque::Worker.prepend(ResqueShutdown)
+end
