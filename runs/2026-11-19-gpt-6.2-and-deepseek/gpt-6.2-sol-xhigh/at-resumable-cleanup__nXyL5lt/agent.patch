+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  test "a fresh execution resumes after the last committed title" do
+    first, interrupted, last = Leaf.order(:id).first(3)
+    [ first, interrupted, last ].each { |leaf| leaf.update!(title: '""Quoted phrase" and more"') }
+
+    interrupt = ->(leaf) { raise "interrupted" if leaf.id == interrupted.id }
+    Leaf.set_callback(:update, :after, interrupt)
+    begin
+      assert_raises(RuntimeError, match: "interrupted") { TitleCleanupJob.perform_now }
+    ensure
+      Leaf.skip_callback(:update, :after, interrupt)
+    end
+
+    assert_equal '"Quoted phrase" and more', first.reload.title
+    assert_equal '""Quoted phrase" and more"', interrupted.reload.title
+
+    2.times { TitleCleanupJob.perform_now }
+
+    [ first, interrupted, last ].each do |leaf|
+      assert_equal '"Quoted phrase" and more', leaf.reload.title
+    end
+  end
+end
