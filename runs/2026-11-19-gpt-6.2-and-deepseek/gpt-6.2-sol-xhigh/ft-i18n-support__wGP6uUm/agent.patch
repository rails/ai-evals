--- /dev/null
+++ b/app/javascript/helpers/locale_helpers.js
@@ -0,0 +1,9 @@
+export function dateLocale() {
+  const locale = document.documentElement.lang
+  return !locale || locale === "en" ? "en-US" : locale
+}
+
+export function translate(key, values = {}) {
+  const translations = JSON.parse(document.querySelector('meta[name="fizzy-translations"]')?.content || "{}")
+  return translations[key]?.replace(/%\{(\w+)\}/g, (_, key) => values[key])
+}
