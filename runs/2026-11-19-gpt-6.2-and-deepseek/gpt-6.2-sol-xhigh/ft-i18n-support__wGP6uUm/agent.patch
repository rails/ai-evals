diff --git a/test/system/locales_test.rb b/test/system/locales_test.rb
new file mode 100644
index 0000000..75b6d35
--- /dev/null
+++ b/test/system/locales_test.rb
@@ -0,0 +1,19 @@
+require "application_system_test_case"
+
+class LocalesSystemTest < ApplicationSystemTestCase
+  test "browser-formatted dates follow the page language" do
+    user = users(:david)
+    card = cards(:logo)
+    Current.with(user: user) { card.close }
+    sign_in_as user
+
+    visit card_path(card)
+    assert_selector "html[lang=en]"
+    assert_selector "time[data-local-time-target=shortdate]", text: /[A-Z][a-z]{2} \d+/
+
+    visit card_path(card, locale: "ja")
+    assert_selector "html[lang=ja]"
+    assert_selector "time[data-local-time-target=shortdate]", text: /\d+月\d+日/
+    assert_selector ".card__closed-date", text: /\d+年\d+月\d+日/
+  end
+end
