diff --git a/test/integration/locale_catalogs_test.rb b/test/integration/locale_catalogs_test.rb
new file mode 100644
index 0000000..3d67fc1
--- /dev/null
+++ b/test/integration/locale_catalogs_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class LocaleCatalogsTest < ActiveSupport::TestCase
+  test "every app translation has a Japanese entry with the same interpolation variables" do
+    Dir[Rails.root.join("config/locales/*.en.yml")].each do |file|
+      english = flatten(YAML.safe_load_file(file).fetch("en"))
+      japanese = flatten(YAML.safe_load_file(file.sub(/\.en\.yml\z/, ".ja.yml")).fetch("ja"))
+
+      assert_equal english.keys.sort, japanese.keys.sort, file
+      english.each do |key, value|
+        assert_equal placeholders(value), placeholders(japanese.fetch(key)), "#{file}: #{key}"
+      end
+    end
+  end
+
+  test "static errors are bilingual without a session" do
+    Dir[Rails.public_path.join("[45]*.html")].each do |file|
+      html = Nokogiri::HTML(File.read(file))
+      assert_equal "en", html.at_css("html")["lang"]
+      assert html.at_css("h2:not([lang])")&.text.present?, file
+      assert_match(/\p{Han}|\p{Hiragana}/, html.at_css("h2[lang=ja]").text, file)
+      assert_equal "ホームに戻る", html.at_css("a [lang=ja]").text
+    end
+  end
+
+  private
+    def flatten(hash, prefix = nil)
+      hash.each_with_object({}) do |(key, value), result|
+        path = [ prefix, key ].compact.join(".")
+        if value.is_a?(Hash)
+          result.merge!(flatten(value, path))
+        else
+          result[path] = value
+        end
+      end
+    end
+
+    def placeholders(text)
+      text.scan(/%\{\w+\}/).uniq.sort
+    end
+end
diff --git a/test/integration/locales_test.rb b/test/integration/locales_test.rb
new file mode 100644
index 0000000..2ccd61e
--- /dev/null
+++ b/test/integration/locales_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class LocalesTest < ActionDispatch::IntegrationTest
+  test "a language choice survives redirects and unsupported locales before sign in" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_select "html[lang=ja]"
+      assert_select "input[placeholder='メールアドレスを入力…']"
+
+      post session_path, params: { email_address: identities(:david).email_address }
+      follow_redirect!
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "メールをご確認ください"
+
+      get session_magic_link_path, params: { locale: "xx" }
+      assert_response :success
+      assert_select "html[lang=ja]"
+
+      assert_nil identities(:david).reload.locale
+      post session_magic_link_path, params: { code: identities(:david).magic_links.last.code }
+      assert_equal "ja", identities(:david).reload.locale
+    end
+  end
+
+  test "a signed in language choice is restored in a clean browser" do
+    sign_in_as :david
+    get board_path(boards(:writebook)), params: { locale: "ja" }
+    assert_select "html[lang=ja]"
+
+    reset!
+    sign_in_as :david
+    get board_path(boards(:writebook), script_name: accounts("37s").slug), params: { locale: "xx" }
+    assert_select "html[lang=ja]"
+    assert_select ".header__skip-navigation", text: "メインコンテンツへ移動"
+
+    get board_path(boards(:writebook), script_name: accounts("37s").slug), params: { locale: "en" }
+    assert_select "html[lang=en]"
+    assert_equal "en", identities(:david).reload.locale
+  end
+
+  test "a visitor without a language choice sees the original English" do
+    untenanted do
+      get new_session_path, params: { locale: [ "ja" ] }
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_select "input[placeholder='Enter your email address…']"
+      assert_select ".header__skip-navigation", text: "Skip to main content"
+    end
+  end
+
+  test "a locale switch invalidates an earlier English response" do
+    sign_in_as :david
+    path = board_path(boards(:writebook))
+    get path
+    etag = response.headers.fetch("ETag")
+    assert_select "html[lang=en]"
+
+    get path, params: { locale: "ja" }, headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_select ".for-screen-reader", text: "列のオプション"
+    assert_no_match(/translation.missing/i, response.body)
+    assert_equal :en, I18n.locale
+  end
+
+  test "cached cards do not mix languages" do
+    sign_in_as :david
+    path = card_path(cards(:logo))
+
+    with_actionview_partial_caching do
+      get path
+      assert_select ".for-screen-reader", text: "Card number"
+
+      get path, params: { locale: "ja" }
+      assert_select ".for-screen-reader", text: "カード番号"
+      assert_select ".for-screen-reader", text: "Card number", count: 0
+    end
+  end
+
+  test "a magic link sent from a clean browser uses the recipient's saved language" do
+    identity = identities(:david)
+    identity.update!(locale: "ja")
+
+    untenanted do
+      perform_enqueued_jobs(only: ActionMailer::MailDeliveryJob) do
+        post session_path, params: { email_address: identity.email_address }
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identity.email_address ], email.to
+    assert_match(/Fizzy の確認コードは/, email.subject)
+    assert_includes email.html_part.body.decoded, 'lang="ja"'
+    assert_includes email.text_part.body.decoded, "15分"
+  end
+end
