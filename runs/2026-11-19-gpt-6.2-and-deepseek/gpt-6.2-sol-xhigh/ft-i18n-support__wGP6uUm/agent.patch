diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..84829b9
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,33 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    # Authentication may replace the anonymous locale with the identity preference.
+    prepend_around_action :with_current_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def with_current_locale(&)
+      choice = params[:locale]
+      if choice.is_a?(String) && I18n.locale_available?(choice)
+        session[:locale] = choice
+      end
+
+      I18n.with_locale(pending_locale || I18n.default_locale, &)
+    end
+
+    # A new choice made before authentication is applied only once the identity is verified.
+    def pending_locale
+      session[:locale].presence_in(I18n.available_locales.map(&:to_s))
+    end
+
+    def use_identity_locale(identity)
+      if choice = pending_locale
+        identity.update!(locale: choice) unless identity.locale == choice
+        session.delete(:locale)
+      end
+
+      I18n.locale = identity.preferred_locale
+    end
+end
