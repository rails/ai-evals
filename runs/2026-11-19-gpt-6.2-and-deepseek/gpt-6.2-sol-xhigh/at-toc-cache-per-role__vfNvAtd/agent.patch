diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..2bd7c53 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -79,6 +79,44 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
   end
 
+  [ [ :kevin, :jz ], [ :jz, :kevin ] ].each do |first, second|
+    test "cached contents respect permissions when #{first} opens the book first" do
+      previous_caching = BooksController.perform_caching
+      previous_store = BooksController.cache_store
+      previous_collection_store = ActionView::CollectionRenderer.collection_cache
+      store = ActiveSupport::Cache::MemoryStore.new
+      BooksController.perform_caching = true
+      BooksController.cache_store = store
+      ActionView::CollectionRenderer.collection_cache = store
+
+      book = books(:handbook)
+      leaf = leaves(:welcome_page)
+      [ first, second, first ].each do |user|
+        sign_in user
+        get book_slug_path(book)
+
+        assert_response :success
+        assert_select "#leaf_#{leaf.id} a[href=?]", edit_leafable_path(leaf), count: user == :kevin ? 2 : 0
+        assert_select "#leaf_#{leaf.id} .leaf__delete", count: user == :kevin ? 1 : 0
+        assert_select "#leaf_#{leaf.id} .arrangement__handle", count: user == :kevin ? 1 : 0
+        assert_in_body leaf.title
+      end
+
+      old_title = leaf.title
+      leaf.update!(title: "Renamed welcome page")
+      sign_in second
+      get book_slug_path(book)
+
+      assert_response :success
+      assert_in_body leaf.title
+      assert_not_in_body old_title
+    ensure
+      BooksController.perform_caching = previous_caching
+      BooksController.cache_store = previous_store
+      ActionView::CollectionRenderer.collection_cache = previous_collection_store
+    end
+  end
+
   test "show includes OG metadata for public access" do
     get book_slug_url(books(:handbook))
     assert_response :success
