@@ -2,11 +2,14 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :announce_publication_after_commit, if: -> { saved_change_to_published?(from: false, to: true) }
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    def announce_publication_after_commit
+      # A later save or page touch can overwrite the book's saved changes before commit.
+      self.class.current_transaction.after_commit do
+        AnnouncePublicationJob.perform_later self if self.class.published.exists?(id)
+      end
     end
 end
