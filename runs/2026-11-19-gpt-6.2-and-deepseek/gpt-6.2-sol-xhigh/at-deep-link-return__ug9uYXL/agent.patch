+  test "create returns to a local path with its query and fragment" do
+    destination = leafable_slug_path(leaves(:welcome_page), search: "welcome page", anchor: "intro")
+
+    post session_path, params: {
+      email_address: users(:david).email_address, password: "secret123456", return_to: destination
+    }
+
+    assert_redirected_to destination
+  end
+
+  test "signing in returns to the protected page originally requested" do
+    https!
+    host! "writebook.example.com:8443"
+    book = books(:handbook)
+    destination = edit_book_path(book, tab: "access")
+    return_to = edit_book_url(book, tab: "access")
+
+    get destination
+    assert_redirected_to new_session_path(return_to: return_to)
+    follow_redirect!
+    assert_select "input[name=return_to][value=?]", return_to
+
+    post session_path, params: {
+      email_address: users(:david).email_address, password: "secret123456", return_to: return_to
+    }
+
+    assert_redirected_to destination
+    follow_redirect!
+    assert_response :success
+  end
+
+  test "create ignores an external return destination" do
+    post session_path, params: {
+      email_address: users(:david).email_address, password: "secret123456",
+      return_to: "https://example.invalid/"
+    }
+
+    assert_redirected_to root_path
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create falls back for unsafe or malformed return destinations" do
+    [
+      "", " ", "//example.invalid/", "https://#{host}/", "http://#{host}:8080/",
+      "ftp://#{host}/", "example.invalid", "/\\example.invalid/", "/books?title=\u0001", "http://[",
+      [ "/books" ], { path: "/books" }
+    ].each do |return_to|
+      post session_path, params: {
+        email_address: users(:david).email_address, password: "secret123456", return_to: return_to
+      }
+
+      assert_redirected_to root_path, "Expected fallback for return_to=#{return_to.inspect}"
+    end
+  end
+
