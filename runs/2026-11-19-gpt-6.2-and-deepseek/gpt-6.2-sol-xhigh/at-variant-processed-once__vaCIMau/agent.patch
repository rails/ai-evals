diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..552e27b 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -76,6 +76,35 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
     assert_in_body "title: \"Reading\""
   end
 
+  test "fetching a picture reuses the variant created by the background job" do
+    leaf = leaves(:reading_picture)
+    picture = leaf.picture
+
+    perform_enqueued_jobs do
+      File.open(file_fixture("white-rabbit.webp")) do |file|
+        picture.image.attach io: file, filename: "white-rabbit.webp", content_type: "image/webp"
+      end
+    end
+
+    variants = picture.image.blob.variant_records
+    expected_image = variants.sole.image.download
+    transformations = []
+
+    ActiveSupport::Notifications.subscribed(->(*args) { transformations << args }, "transform.active_storage") do
+      get leafable_slug_path(leaf)
+      assert_response :success
+      images = assert_select "img[loading=lazy]", count: 1
+      get URI.parse(images.first["src"]).request_uri
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+    end
+
+    assert_equal expected_image, response.body.b
+    assert_empty transformations
+    assert_equal 1, variants.reload.count
+  end
+
   test "show a picture whose image cannot be resized" do
     leaves(:reading_picture).leafable.image.attach io: file_fixture("pixel.bmp").open,
       filename: "pixel.bmp", content_type: "image/bmp"
