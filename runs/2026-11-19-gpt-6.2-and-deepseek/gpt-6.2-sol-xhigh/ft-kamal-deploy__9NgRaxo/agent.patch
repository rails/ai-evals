--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,37 @@
+<% host = "fizzy.example.com" %>
+service: fizzy
+image: your-docker-hub-user/fizzy
+
+servers:
+  web:
+    - <%= host %>
+
+proxy:
+  host: <%= host %>
+  ssl: true
+  app_port: 80
+
+registry:
+  username: your-docker-hub-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64
+
+env:
+  clear:
+    APP_FQDN: <%= host %>
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_USERNAME: fizzy@example.com
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+
+volumes:
+  - fizzy_storage:/rails/storage
