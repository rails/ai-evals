new file mode 100644
index 0000000..67228d1
--- /dev/null
+++ b/saas/app/controllers/stripe_webhooks_controller.rb
@@ -0,0 +1,23 @@
+class StripeWebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  SUBSCRIPTION_EVENTS = %w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted customer.subscription.paused customer.subscription.resumed ].freeze
+
+  def create
+    return head :not_found if request.env["fizzy.external_account_id"]
+    return head :bad_request if request.headers["Stripe-Signature"].blank?
+
+    secret = ENV["STRIPE_WEBHOOK_SECRET"].presence
+    return head :service_unavailable unless secret
+
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], secret)
+
+    if event.type.in?(SUBSCRIPTION_EVENTS)
+      Account::Subscription.find_by(stripe_customer_id: event.data.object.customer)&.sync_from_stripe
+    end
+
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
