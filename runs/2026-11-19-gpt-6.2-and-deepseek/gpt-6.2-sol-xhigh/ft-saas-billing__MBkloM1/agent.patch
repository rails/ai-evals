diff --git a/saas/test/controllers/account/card_limit_test.rb b/saas/test/controllers/account/card_limit_test.rb
new file mode 100644
index 0000000..fe881ef
--- /dev/null
+++ b/saas/test/controllers/account/card_limit_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class Account::CardLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+    @account.update!(cards_count: @account.cards.maximum(:number).to_i)
+    sign_in_as :mike
+  end
+
+  test "a free account at its card limit can draft but cannot publish or create via the API" do
+    fill_card_slots(1_000)
+
+    post board_cards_path(@board, script_name: @account.slug)
+    assert_redirected_to card_draft_path(@draft, script_name: @account.slug)
+    follow_redirect!
+    assert_select "a", text: "Upgrade"
+    assert_select "button", text: "Create card", count: 0
+    assert_select "button", text: "Create and add another", count: 0
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+
+    assert_no_difference -> { @account.cards.published.count } do
+      post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Blocked" } }, as: :json
+      assert_response :forbidden
+    end
+  end
+
+  test "the warning starts at 100 cards left and counts down as published usage changes" do
+    limits = @account.create_overridden_limits!(card_count: 899)
+    draft_path = card_draft_path(@draft, script_name: @account.slug)
+    get draft_path
+    assert_select "strong", text: /cards? left/, count: 0
+
+    limits.update!(card_count: 900)
+    get draft_path
+    assert_select "strong", text: "100 cards left"
+
+    limits.update!(card_count: 950)
+    get draft_path
+    assert_select "strong", text: "50 cards left"
+    assert_select "button", text: "Create card"
+
+    limits.update!(card_count: 999)
+    get draft_path
+    assert_select "strong", text: "1 card left"
+  end
+
+  test "a draft doesn't use a slot but publishing takes the last one" do
+    fill_card_slots(999)
+
+    post card_publish_path(@draft, script_name: @account.slug), params: { creation_type: "add_another" }
+    assert_response :redirect
+    assert @draft.reload.published?
+    follow_redirect!
+    assert_select "a", text: "Upgrade"
+    assert_equal 1_000, @account.cards.published.count
+
+    post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "No slot" } }, as: :json
+    assert_response :forbidden
+  end
+
+  test "paid plans remove the card limit but enforce their own storage quota" do
+    @account.create_overridden_limits!(card_count: 1_100, bytes_used: 2.gigabytes)
+    @account.create_billing_subscription!(stripe_customer_id: "cus_fizzy", stripe_subscription_id: "sub_fizzy", status: "active", plan_key: "unlimited")
+
+    post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Unlimited card" } }, as: :json
+    assert_response :created
+
+    @account.overridden_limits.update!(bytes_used: 6.gigabytes)
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+
+    @account.billing_subscription.update!(plan_key: "unlimited_plus")
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  private
+    def fill_card_slots(count)
+      now = Time.current
+      @account.cards.insert_all!((1..(count - @account.cards.published.count)).map do |n|
+        { id: ActiveRecord::Type::Uuid.generate, board_id: @board.id, creator_id: users(:mike).id, status: "published", number: 10_000 + n,
+          title: "Published card #{n}", last_active_at: now }
+      end)
+    end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..64a5655
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff can browse accounts and open support tools" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href='#{saas.admin_account_path(@account)}']", text: @account.name
+
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "button", text: "Comp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type='submit'][value='Override']"
+    end
+  end
+
+  test "staff can comp and uncomp an account" do
+    sign_in_as :david
+
+    untenanted do
+      assert_difference -> { Account::BillingWaiver.count }, 1 do
+        post saas.comp_admin_account_path(@account)
+        assert_redirected_to saas.admin_account_path(@account)
+      end
+      assert_equal Billing::Plan::UNLIMITED, @account.reload.billing_plan
+      follow_redirect!
+      assert_select "button", text: "Uncomp"
+
+      assert_no_difference -> { Account::BillingWaiver.count } do
+        post saas.comp_admin_account_path(@account)
+        assert_redirected_to saas.admin_account_path(@account)
+      end
+
+      delete saas.uncomp_admin_account_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_equal Billing::Plan::FREE, @account.reload.billing_plan
+    end
+  end
+
+  test "staff can override usage and reset it without changing actual data" do
+    sign_in_as :david
+    actual_usage = [ @account.cards.published.count, @account.bytes_used ]
+
+    untenanted do
+      patch saas.override_admin_account_path(@account), params: { overridden_limits: { card_count: 950, bytes_used: 501.gigabytes } }
+      assert_redirected_to saas.admin_account_path(@account)
+      follow_redirect!
+      assert_select "button", text: "Reset"
+      assert_equal 50, @account.reload.cards_remaining
+      assert @account.exceeding_storage_limit?
+
+      patch saas.override_admin_account_path(@account), params: { overridden_limits: { card_count: "", bytes_used: 0 } }
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_equal actual_usage.first, @account.reload.billing_card_count
+      assert_equal 0, @account.billing_bytes_used
+
+      delete saas.reset_admin_account_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_nil @account.reload.overridden_limits
+      assert_equal actual_usage, [ @account.billing_card_count, @account.billing_bytes_used ]
+    end
+  end
+
+  test "invalid usage overrides are not persisted" do
+    sign_in_as :david
+
+    untenanted do
+      patch saas.override_admin_account_path(@account), params: { overridden_limits: { card_count: -1, bytes_used: "1.5" } }
+    end
+    assert_response :unprocessable_content
+    assert_nil @account.reload.overridden_limits
+  end
+
+  test "non-staff including account admins cannot view or change billing support data" do
+    sign_in_as :mike
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+      get saas.admin_account_path(@account)
+      assert_response :forbidden
+      post saas.comp_admin_account_path(@account)
+      assert_response :forbidden
+      delete saas.uncomp_admin_account_path(@account)
+      assert_response :forbidden
+      patch saas.override_admin_account_path(@account), params: { overridden_limits: { card_count: 0 } }
+      assert_response :forbidden
+      delete saas.reset_admin_account_path(@account)
+      assert_response :forbidden
+    end
+  end
+end
diff --git a/saas/test/controllers/stripe_webhooks_controller_test.rb b/saas/test/controllers/stripe_webhooks_controller_test.rb
new file mode 100644
index 0000000..8ee4973
--- /dev/null
+++ b/saas/test/controllers/stripe_webhooks_controller_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+require_relative "../test_helpers/stripe_test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_billing_subscription!(stripe_customer_id: "cus_fizzy")
+  end
+
+  test "signed subscription events apply Stripe's current plan and storage allowance" do
+    stub_subscriptions("cus_fizzy", stripe_subscription(customer: "cus_fizzy", price: "price_unlimited"))
+    deliver_event("customer.subscription.created")
+    assert_response :ok
+    assert_equal Billing::Plan::UNLIMITED, @account.reload.billing_plan
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    stub_subscriptions("cus_fizzy", stripe_subscription(customer: "cus_fizzy", price: "price_unlimited_plus"))
+    deliver_event("customer.subscription.updated")
+    assert_response :ok
+    assert_equal Billing::Plan::UNLIMITED_PLUS, @account.reload.billing_plan
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    deliver_event("customer.subscription.created")
+    assert_response :ok
+    assert_equal Billing::Plan::UNLIMITED_PLUS, @account.reload.billing_plan
+
+    stub_subscriptions("cus_fizzy", stripe_subscription(customer: "cus_fizzy", price: "price_unlimited_plus", status: "canceled"))
+    deliver_event("customer.subscription.deleted")
+    assert_response :ok
+    assert_equal Billing::Plan::FREE, @account.reload.billing_plan
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "invalid signatures cannot affect billing" do
+    deliver_event("customer.subscription.created", secret: "invalid")
+    assert_response :bad_request
+    assert_nil @subscription.reload.status
+  end
+
+  test "unrelated and unknown-customer events are acknowledged without changing accounts" do
+    deliver_event("customer.subscription.updated", customer: "cus_unknown")
+    assert_response :ok
+    deliver_event("invoice.paid")
+    assert_response :ok
+    assert_nil @subscription.reload.status
+  end
+
+  test "past due subscriptions don't grant paid limits but stay manageable" do
+    stub_subscriptions("cus_fizzy", stripe_subscription(customer: "cus_fizzy", price: "price_unlimited_plus", status: "past_due"))
+    deliver_event("customer.subscription.updated")
+    assert_response :ok
+    assert_equal Billing::Plan::FREE, @account.reload.billing_plan
+    assert @subscription.reload.subscribed?
+  end
+
+  private
+    def deliver_event(type, customer: "cus_fizzy", secret: ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+      payload = { id: "evt_#{type}", object: "event", type: type, data: { object: { id: "sub_fizzy", customer: customer } } }.to_json
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, secret)
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: {
+          "Content-Type" => "application/json", "Stripe-Signature" => Stripe::Webhook::Signature.generate_header(timestamp, signature)
+        }
+      end
+    end
+end
diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..148144b
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+require_relative "../../test_helpers/stripe_test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  include StripeTestHelper
+
+  test "deleting an account stops its Stripe subscription" do
+    account = accounts(:"37s")
+    subscription = account.create_billing_subscription!(stripe_customer_id: "cus_fizzy", stripe_subscription_id: "sub_fizzy", plan_key: "unlimited", status: "active")
+    stub_subscriptions("cus_fizzy", stripe_subscription(customer: "cus_fizzy", price: "price_unlimited"))
+    cancellation = stripe_request(:delete, "subscriptions/sub_fizzy")
+      .to_return(stripe_response(id: "sub_fizzy", object: "subscription", status: "canceled"))
+
+    account.cancel(initiated_by: users(:jason))
+
+    assert_requested cancellation
+    assert account.cancelled?
+    assert_not subscription.reload.subscribed?
+    assert_equal Billing::Plan::FREE, account.reload.billing_plan
+  end
+
+  test "comping and uncomping does not replace a paid Unlimited+ plan or change Stripe" do
+    account = accounts(:"37s")
+    account.create_billing_subscription!(stripe_customer_id: "cus_fizzy", stripe_subscription_id: "sub_fizzy", plan_key: "unlimited_plus", status: "active")
+
+    account.billing_comped = true
+    assert account.billing_comped?
+    assert_equal Billing::Plan::UNLIMITED_PLUS, account.billing_plan
+
+    account.billing_comped = false
+    assert_not account.billing_comped?
+    assert_equal Billing::Plan::UNLIMITED_PLUS, account.billing_plan
+  end
+end
diff --git a/saas/test/test_helpers/stripe_test_helper.rb b/saas/test/test_helpers/stripe_test_helper.rb
new file mode 100644
index 0000000..52b5129
--- /dev/null
+++ b/saas/test/test_helpers/stripe_test_helper.rb
@@ -0,0 +1,44 @@
+module StripeTestHelper
+  extend ActiveSupport::Concern
+
+  STRIPE_TEST_ENV = {
+    "STRIPE_SECRET_KEY" => "sk_test_fizzy",
+    "STRIPE_WEBHOOK_SECRET" => "whsec_fizzy",
+    "STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited",
+    "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_unlimited_plus"
+  }.freeze
+
+  included do
+    setup do
+      @stripe_original_env = ENV.to_h.slice(*STRIPE_TEST_ENV.keys)
+      ENV.update(STRIPE_TEST_ENV)
+      WebMock.disable_net_connect!
+    end
+
+    teardown do
+      STRIPE_TEST_ENV.each_key { |key| ENV[key] = @stripe_original_env[key] }
+      WebMock.allow_net_connect!
+    end
+  end
+
+  private
+    def stripe_request(method, path)
+      stub_request(method, "https://api.stripe.com/v1/#{path}")
+        .with(headers: { "Authorization" => "Bearer sk_test_fizzy" })
+    end
+
+    def stripe_response(**object)
+      { body: object.to_json, headers: { "Content-Type" => "application/json" } }
+    end
+
+    def stub_subscriptions(customer, *subscriptions)
+      stripe_request(:get, "subscriptions")
+        .with(query: { customer: customer, status: "all" })
+        .to_return(stripe_response(object: "list", data: subscriptions, has_more: false))
+    end
+
+    def stripe_subscription(customer:, price:, status: "active")
+      { id: "sub_fizzy", object: "subscription", customer: customer, status: status,
+        items: { object: "list", data: [ { price: { id: price } } ], has_more: false } }
+    end
+end
