index 0000000..8e1a2b1
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,54 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :billing_subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limits, class_name: "Account::OverriddenLimits", dependent: :destroy
+
+    set_callback :cancel, :before, :cancel_billing
+  end
+
+  def billing_plan
+    billing_subscription&.paid_plan || (billing_comped? ? Billing::Plan::UNLIMITED : Billing::Plan::FREE)
+  end
+
+  def billing_comped?
+    billing_waiver&.persisted? || false
+  end
+
+  def billing_comped=(comped)
+    with_lock do
+      if comped
+        billing_waiver || create_billing_waiver!
+      else
+        billing_waiver&.destroy!
+      end
+    end
+  end
+
+  def billing_card_count(limit: nil)
+    overridden_limits&.card_count || cards.published.limit(limit).count
+  end
+
+  def billing_bytes_used
+    overridden_limits&.bytes_used || bytes_used
+  end
+
+  def cards_remaining
+    if limit = billing_plan.card_limit
+      [ limit - billing_card_count(limit: limit), 0 ].max
+    end
+  end
+
+  def card_limit_reached?
+    cards_remaining == 0
+  end
+
+  private
+    def cancel_billing
+      billing_subscription&.cancel
+    end
+end
