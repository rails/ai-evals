@@ -0,0 +1,44 @@
+class Account::BillingsController < ApplicationController
+  before_action :ensure_admin, except: :show
+  rescue_from Stripe::StripeError, with: :billing_unavailable
+
+  def show
+    @plan = Current.account.billing_plan
+  end
+
+  def checkout
+    plan = Billing::Plan.find(params[:plan])
+    return head :unprocessable_content unless plan&.paid?
+    return head :service_unavailable unless plan.stripe_price_id
+
+    url = Current.account.with_lock do
+      if Current.account.active?
+        Account::Subscription.for_checkout(Current.account).checkout_url(plan: plan, return_url: billing_return_url)
+      end
+    end
+
+    if url
+      redirect_to url, allow_other_host: true, status: :see_other
+    else
+      head :forbidden
+    end
+  end
+
+  def portal
+    if subscription = Current.account.billing_subscription
+      redirect_to subscription.portal_url(return_url: billing_return_url), allow_other_host: true, status: :see_other
+    else
+      redirect_to saas.account_billing_path(script_name: Current.account.slug), status: :see_other
+    end
+  end
+
+  private
+    def billing_return_url
+      main_app.account_settings_url(script_name: Current.account.slug)
+    end
+
+    def billing_unavailable(error)
+      Rails.error.report(error, handled: true)
+      redirect_to saas.account_billing_path(script_name: Current.account.slug), alert: "Stripe billing is temporarily unavailable. Please try again.", status: :see_other
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..f9fd25a
--- /dev/null
