+<% @page_title = "Plans and billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel shadow center margin-block-start" aria-label="Fizzy plans">
+  <p>Your current plan: <strong><%= @plan.name %></strong></p>
+  <% Billing::Plan::ALL.each do |plan| %>
+    <section class="settings__section">
+      <h2 class="divider"><%= plan.name %></h2>
+      <p>
+        <%= plan.paid? ? "$#{plan.monthly_price}/month" : "$0/month" %> ·
+        <%= plan.card_limit ? "#{number_with_delimiter(plan.card_limit)} cards" : "Unlimited cards" %> ·
+        <%= number_to_human_size(plan.storage_limit) %> storage
+      </p>
+      <% if Current.user.admin? && plan.storage_limit > @plan.storage_limit %>
+        <%= button_to "Upgrade to #{plan.name}", saas.checkout_account_billing_path(script_name: Current.account.slug), params: { plan: plan.key },
+              class: "btn", form: { data: { turbo: false } } %>
+      <% end %>
+    </section>
+  <% end %>
+  <% if Current.user.admin? %>
+    <%= render "account/billings/manage", account: Current.account %>
+  <% else %>
+    <p>Ask an account admin to change your plan.</p>
+  <% end %>
+</section>
