diff --git a/saas/test/controllers/account/billings_controller_test.rb b/saas/test/controllers/account/billings_controller_test.rb
new file mode 100644
index 0000000..372051d
--- /dev/null
+++ b/saas/test/controllers/account/billings_controller_test.rb
@@ -0,0 +1,120 @@
+require "test_helper"
+require_relative "../../test_helpers/stripe_test_helper"
+
+class Account::BillingsControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    untenanted do
+      @settings_url = account_settings_url(script_name: @account.slug)
+      @billing_path = saas.account_billing_path(script_name: @account.slug)
+      @checkout_path = saas.checkout_account_billing_path(script_name: @account.slug)
+      @portal_path = saas.portal_account_billing_path(script_name: @account.slug)
+    end
+  end
+
+  test "admins see their plan, upgrade link and approved prices" do
+    sign_in_as :kevin
+
+    get @settings_url
+    assert_response :success
+    assert_select "section[aria-label='Billing']" do
+      assert_select "strong", text: "Free"
+      assert_select "a[href='#{@billing_path}']", text: "Upgrade"
+    end
+
+    get @billing_path
+    assert_response :success
+    assert_select "p", text: /1,000 cards ·\s+1 GB storage/
+    assert_select "p", text: /\$20\/month ·\s+Unlimited cards ·\s+5 GB storage/
+    assert_select "p", text: /\$25\/month ·\s+Unlimited cards ·\s+500 GB storage/
+    assert_select "form[action='#{@checkout_path}']", count: 2
+  end
+
+  test "members can view plans but cannot start checkout or visit the portal" do
+    sign_in_as :jz
+
+    get @settings_url
+    assert_select "section[aria-label='Billing']", count: 0
+    get @billing_path
+    assert_response :success
+    assert_select "form[action='#{@checkout_path}']", count: 0
+
+    post @checkout_path, params: { plan: "unlimited", stripe_customer_id: "cus_other" }
+    assert_response :forbidden
+    post @portal_path
+    assert_response :forbidden
+  end
+
+  test "checkout uses a Stripe customer belonging to the tenant and a server-selected price" do
+    sign_in_as :kevin
+    stripe_request(:post, "customers").with(body: hash_including({ "metadata" => { "fizzy_account_id" => @account.id } }))
+      .to_return(stripe_response(id: "cus_fizzy", object: "customer"))
+    stub_subscriptions("cus_fizzy")
+    checkout_params = {
+      "mode" => "subscription", "customer" => "cus_fizzy", "line_items" => { "0" => { "price" => "price_unlimited_plus", "quantity" => "1" } },
+      "metadata" => { "plan_key" => "unlimited_plus" }, "success_url" => @settings_url, "cancel_url" => @settings_url
+    }
+    stripe_request(:post, "checkout/sessions").with { |request| Rack::Utils.parse_nested_query(request.body) == checkout_params }
+      .to_return(stripe_response(id: "cs_fizzy", object: "checkout.session", url: "https://checkout.stripe.com/pay/cs_fizzy"))
+
+    post @checkout_path, params: { plan: "unlimited_plus", price: "price_other", stripe_customer_id: "cus_other" }
+
+    assert_response :see_other
+    assert_redirected_to "https://checkout.stripe.com/pay/cs_fizzy"
+    subscription = @account.reload.billing_subscription
+    assert_equal "cus_fizzy", subscription.stripe_customer_id
+    assert_equal "cs_fizzy", subscription.stripe_checkout_session_id
+    assert_equal Billing::Plan::FREE, @account.billing_plan
+  end
+
+  test "repeat checkout reuses the existing open session" do
+    sign_in_as :kevin
+    @account.create_billing_subscription!(stripe_customer_id: "cus_fizzy", stripe_checkout_session_id: "cs_fizzy")
+    stub_subscriptions("cus_fizzy")
+    stripe_request(:get, "checkout/sessions/cs_fizzy").to_return(stripe_response(
+      id: "cs_fizzy", object: "checkout.session", status: "open", metadata: { plan_key: "unlimited" },
+      url: "https://checkout.stripe.com/pay/cs_fizzy"
+    ))
+
+    post @checkout_path, params: { plan: "unlimited" }
+
+    assert_redirected_to "https://checkout.stripe.com/pay/cs_fizzy"
+  end
+
+  test "portal uses the tenant's customer and sends an admin to Stripe" do
+    sign_in_as :kevin
+    @account.create_billing_subscription!(stripe_customer_id: "cus_fizzy", stripe_subscription_id: "sub_fizzy", plan_key: "unlimited", status: "active")
+    stripe_request(:post, "billing_portal/sessions").with(body: { "customer" => "cus_fizzy", "return_url" => @settings_url })
+      .to_return(stripe_response(id: "bps_fizzy", object: "billing_portal.session", url: "https://billing.stripe.com/session/fizzy"))
+
+    get @settings_url
+    assert_select "section[aria-label='Billing']" do
+      assert_select "strong", text: "Unlimited"
+      assert_select "form[action='#{@portal_path}'] button", text: "Manage billing"
+    end
+
+    post @portal_path, params: { stripe_customer_id: "cus_other" }
+    assert_response :see_other
+    assert_redirected_to "https://billing.stripe.com/session/fizzy"
+  end
+
+  test "a paid customer upgrading is sent to the portal rather than purchasing twice" do
+    sign_in_as :kevin
+    @account.create_billing_subscription!(stripe_customer_id: "cus_fizzy")
+    stub_subscriptions("cus_fizzy", stripe_subscription(customer: "cus_fizzy", price: "price_unlimited"))
+    stripe_request(:post, "billing_portal/sessions").with(body: { "customer" => "cus_fizzy", "return_url" => @settings_url })
+      .to_return(stripe_response(id: "bps_fizzy", object: "billing_portal.session", url: "https://billing.stripe.com/session/fizzy"))
+
+    post @checkout_path, params: { plan: "unlimited_plus" }
+    assert_redirected_to "https://billing.stripe.com/session/fizzy"
+  end
+
+  test "unrecognized plans cannot be purchased" do
+    sign_in_as :kevin
+    post @checkout_path, params: { plan: "price_custom" }
+    assert_response :unprocessable_content
+    assert_nil @account.reload.billing_subscription
+  end
