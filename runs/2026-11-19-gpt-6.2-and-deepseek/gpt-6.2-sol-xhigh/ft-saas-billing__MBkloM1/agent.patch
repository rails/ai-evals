@@ -0,0 +1,40 @@
+<% @page_title = @account.name %>
+
+<section class="panel shadow center margin-block-start">
+  <%= link_to "Accounts", saas.admin_accounts_path %>
+  <h1><%= @page_title %></h1>
+  <p>Account <%= @account.external_account_id %> · <strong><%= @account.billing_plan.name %></strong></p>
+
+  <section class="settings__section">
+    <h2 class="divider">Comp status</h2>
+    <p>Comp grants at least Unlimited without changing any existing Stripe subscription.</p>
+    <% if @account.billing_comped? %>
+      <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), method: :delete, class: "btn" %>
+    <% else %>
+      <%= button_to "Comp", saas.comp_admin_account_path(@account), class: "btn" %>
+    <% end %>
+  </section>
+
+  <section class="settings__section">
+    <h2 class="divider">Usage override</h2>
+    <p>Effective usage: <%= pluralize(@account.billing_card_count, "card") %>, <%= number_to_human_size(@account.billing_bytes_used) %>.</p>
+    <p>Leave a field blank to use actual usage.</p>
+    <%= form_with model: @limits, scope: :overridden_limits, url: saas.override_admin_account_path(@account), method: :patch, class: "flex flex-column align-center gap" do |form| %>
+      <% if @limits.errors.any? %>
+        <p role="alert"><%= @limits.errors.full_messages.to_sentence %></p>
+      <% end %>
+      <label>
+        Card count
+        <%= form.number_field :card_count, min: 0, class: "input" %>
+      </label>
+      <label>
+        Bytes used
+        <%= form.number_field :bytes_used, min: 0, class: "input" %>
+      </label>
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+    <% if @account.overridden_limits&.persisted? %>
+      <%= button_to "Reset", saas.reset_admin_account_path(@account), method: :delete, class: "btn margin-block-start-half" %>
+    <% end %>
+  </section>
+</section>
