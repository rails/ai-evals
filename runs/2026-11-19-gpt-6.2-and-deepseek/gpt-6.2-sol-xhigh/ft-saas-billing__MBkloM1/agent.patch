+module Card::CardLimited
+  extend ActiveSupport::Concern
+
+  private
+    def enforce_card_limit
+      # Serialize the quota check with publication, so two requests can't claim the last slot.
+      Current.account.with_lock do
+        if Current.account.card_limit_reached?
+          head :forbidden
+        else
+          yield
+        end
+      end
+    end
+end
