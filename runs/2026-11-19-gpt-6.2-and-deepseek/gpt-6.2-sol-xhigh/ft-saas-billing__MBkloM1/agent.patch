@@ -0,0 +1,55 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, except: :index
+
+  def index
+    set_page_and_extract_portion_from Account.order(:name, :id)
+  end
+
+  def show
+    @limits = @account.overridden_limits || @account.build_overridden_limits
+  end
+
+  def comp
+    @account.billing_comped = true
+    redirect_to_account
+  end
+
+  def uncomp
+    @account.billing_comped = false
+    redirect_to_account
+  end
+
+  def override
+    @account.with_lock do
+      @limits = @account.overridden_limits || @account.build_overridden_limits
+      @limits.update(limits_params)
+    end
+
+    if @limits.errors.empty?
+      redirect_to_account
+    else
+      @account.reload
+      render :show, status: :unprocessable_content
+    end
+  end
+
+  def reset
+    @account.with_lock { @account.overridden_limits&.destroy! }
+    redirect_to_account
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:id])
+    end
+
+    def limits_params
+      params.expect(overridden_limits: %i[ card_count bytes_used ])
+    end
+
+    def redirect_to_account
+      redirect_to saas.admin_account_path(@account), status: :see_other
+    end
+end
