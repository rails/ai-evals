diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..dfc1c59
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,108 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  ENTITLED_STATUSES = %w[ active trialing ].freeze
+  ENDED_STATUSES = %w[ canceled incomplete_expired ].freeze
+
+  def self.for_checkout(account)
+    account.billing_subscription || account.create_billing_subscription!(stripe_customer_id: create_stripe_customer(account).id)
+  end
+
+  def self.create_stripe_customer(account)
+    stripe.customers.create({ name: account.name, email: account.owner_email, metadata: { fizzy_account_id: account.id } },
+      { idempotency_key: "fizzy-customer-#{account.id}" })
+  end
+
+  def self.stripe
+    Stripe::StripeClient.new(ENV.fetch("STRIPE_SECRET_KEY")).v1
+  end
+
+  def paid_plan
+    Billing::Plan.find(plan_key) if status.in?(ENTITLED_STATUSES)
+  end
+
+  def subscribed?
+    stripe_subscription_id.present?
+  end
+
+  def checkout_url(plan:, return_url:)
+    with_lock do
+      # Inspect the session before listing subscriptions: either we can reuse/expire
+      # an open session, or a completed session's subscription is already visible.
+      session = checkout_session
+      synchronize_subscriptions
+      if subscribed?
+        portal_url(return_url: return_url)
+      else
+        reusable_checkout_url(session, plan) || create_checkout_url(plan, return_url)
+      end
+    end
+  end
+
+  def portal_url(return_url:)
+    stripe.billing_portal.sessions.create(customer: stripe_customer_id, return_url: return_url).url
+  end
+
+  def sync_from_stripe
+    with_lock { synchronize_subscriptions }
+  end
+
+  def cancel
+    with_lock do
+      if (session = checkout_session) && session.status == "open"
+        stripe.checkout.sessions.expire(session.id)
+      end
+      ongoing_subscriptions.each { |subscription| stripe.subscriptions.cancel(subscription.id) }
+      update!(stripe_subscription_id: nil, stripe_checkout_session_id: nil, status: nil, plan_key: nil)
+    end
+  end
+
+  private
+    def synchronize_subscriptions
+      # Read Stripe's current state, not the event snapshot; webhooks can be retried or arrive out of order.
+      current = ongoing_subscriptions.map { |subscription| [ subscription, plan_for(subscription) ] }
+      subscription, plan = current.max_by do |candidate, candidate_plan|
+        candidate.status.in?(ENTITLED_STATUSES) ? candidate_plan&.storage_limit.to_i : 0
+      end
+      update!(stripe_subscription_id: subscription&.id, status: subscription&.status, plan_key: plan&.key)
+    end
+
+    def ongoing_subscriptions
+      stripe.subscriptions.list(customer: stripe_customer_id, status: "all").auto_paging_each.reject do |subscription|
+        subscription.status.in?(ENDED_STATUSES)
+      end
+    end
+
+    def plan_for(subscription)
+      subscription.items.data.filter_map { |item| Billing::Plan.for_stripe_price(item.price.id) }.max_by(&:storage_limit)
+    end
+
+    def checkout_session
+      stripe.checkout.sessions.retrieve(stripe_checkout_session_id) if stripe_checkout_session_id
+    end
+
+    def reusable_checkout_url(session, plan)
+      if session&.status == "open"
+        if session.metadata.plan_key == plan.key
+          session.url
+        else
+          stripe.checkout.sessions.expire(session.id)
+          nil
+        end
+      end
+    end
+
+    def create_checkout_url(plan, return_url)
+      session = stripe.checkout.sessions.create(
+        mode: "subscription", customer: stripe_customer_id,
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        metadata: { plan_key: plan.key }, success_url: return_url, cancel_url: return_url
+      )
+      update!(stripe_checkout_session_id: session.id)
+      session.url
+    end
+
+    def stripe
+      self.class.stripe
+    end
+end
diff --git a/saas/app/models/billing/plan.rb b/saas/app/models/billing/plan.rb
new file mode 100644
index 0000000..e67a054
--- /dev/null
+++ b/saas/app/models/billing/plan.rb
@@ -0,0 +1,22 @@
+class Billing::Plan < Data.define(:key, :name, :monthly_price, :card_limit, :storage_limit, :stripe_price_env)
+  FREE = new("free", "Free", 0, 1_000, 1.gigabyte, nil)
+  UNLIMITED = new("unlimited", "Unlimited", 20, nil, 5.gigabytes, "STRIPE_MONTHLY_V1_PRICE_ID")
+  UNLIMITED_PLUS = new("unlimited_plus", "Unlimited+", 25, nil, 500.gigabytes, "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ].freeze
+
+  def self.find(key)
+    ALL.find { |plan| plan.key == key }
+  end
+
+  def self.for_stripe_price(price_id)
+    ALL.find { |plan| plan.stripe_price_id == price_id } if price_id.present?
+  end
+
+  def paid?
+    stripe_price_env.present?
+  end
+
+  def stripe_price_id
+    ENV[stripe_price_env].presence if paid?
+  end
+end
