+class Public::BaseController < ApplicationController
+  disallow_account_scope
+  skip_before_action :require_authentication
+
+  before_action :protect_public_link, :set_public_board
+
+  layout "public"
+
+  private
+    def protect_public_link
+      no_store
+      response.set_header "Referrer-Policy", "no-referrer"
+    end
+
+    def set_public_board
+      key = request.path_parameters[:board_key] || request.path_parameters[:key]
+      @publication = Board::Publication.find_by_key!(key)
+      @board = @publication.board
+      raise ActiveRecord::RecordNotFound unless @board&.account&.active?
+    end
+end
