+    sign_in_as :kevin
+
+    get board_path(board, format: :json)
+    assert_nil response.parsed_body.fetch("public_url")
+
+    post board_publication_path(board), as: :json
+    assert_response :created
+    public_url = response.parsed_body.fetch("public_url")
+    assert_match %r{\Ahttp://www.example.com/public/boards/[^/]+\z}, public_url
+    assert_not board.reload.all_access?
+    assert_equal [ users(:kevin) ], board.users
+
+    get boards_path(format: :json)
+    assert_equal public_url, response.parsed_body.find { |entry| entry["id"] == board.id }.fetch("public_url")
+
+    sign_out
+    get public_url
+    assert_response :success
+    assert_select "h1", text: board.name
+  end
+
+  test "unpublishing revokes all old links and republishing does not reuse the key" do
+    board = boards(:writebook)
+    sign_in_as :kevin
+
+    post board_publication_path(board), as: :json
+    public_url = response.parsed_body.fetch("public_url")
+    card_url = "#{public_url}/cards/#{cards(:logo).number}"
+    column_url = "#{public_url}/columns/#{columns(:writebook_triage).id}"
+
+    post board_publication_path(board), as: :json
+    assert_equal public_url, response.parsed_body.fetch("public_url")
+
+    get board_path(board, format: :json)
+    assert_equal public_url, response.parsed_body.fetch("public_url")
+    etag = response.headers.fetch("ETag")
+
+    delete board_publication_path(board), as: :json
+    assert_response :no_content
+
+    get board_path(board, format: :json), headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_nil response.parsed_body.fetch("public_url")
+
+    [ public_url, card_url, column_url ].each do |url|
+      get url
+      assert_response :not_found
+    end
+
+    post board_publication_path(board), as: :json
+    assert_response :created
+    assert_not_equal public_url, response.parsed_body.fetch("public_url")
+    get public_url
+    assert_response :not_found
+  end
+
+  test "admins can publish and unpublish from board settings" do
+    board = boards(:writebook)
+    sign_in_as :kevin
+
+    get edit_board_path(board)
+    assert_select "form[action=?] button", board_publication_path(board), text: "Publish board"
+
+    post board_publication_path(board)
+    assert_redirected_to edit_board_path(board)
+    follow_redirect!
+
+    assert_select "a[href=?]", public_board_url(board.reload.publication.key, script_name: nil), text: "Open public board"
+    assert_select "form[action=?] button", board_publication_path(board), text: "Unpublish board"
+
+    delete board_publication_path(board)
+    assert_response :see_other
+    assert_redirected_to edit_board_path(board)
+  end
+
+  test "admins cannot publish boards they cannot access" do
+    board = boards(:private)
+    sign_in_as :jason
+
+    post board_publication_path(board), as: :json
+    assert_response :not_found
+    assert_nil board.reload.publication
+  end
+
+  test "even the board creator cannot manage publication as a regular member" do
+    board = boards(:writebook)
+    sign_in_as :david
+
+    post board_publication_path(board), as: :json
+    assert_response :forbidden
+    assert_nil board.reload.publication
+
+    publication = board.publish
+    delete board_publication_path(board), as: :json
+    assert_response :forbidden
+    assert_equal publication, board.reload.publication
+  end
+end
