+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @key = @board.publish.key
+  end
+
+  test "anyone with the key can browse the board and its columns and cards" do
+    card = cards(:logo)
+    column = columns(:writebook_triage)
+    card.update!(description: "<p>Use the <strong>larger logo</strong>.</p>")
+    card.steps.create!(content: "Get approval")
+
+    untenanted do
+      get public_board_path(@key)
+      assert_response :success
+      assert_select "h1", text: @board.name
+      assert_select "a[href=?]", public_board_column_path(@key, column), text: column.name
+      assert_select "a[href=?]", public_board_card_path(@key, card), text: card.title
+      assert_select "a[href=?]", public_board_card_path(@key, cards(:buy_domain)), text: cards(:buy_domain).title
+      assert_includes response.headers.fetch("Cache-Control"), "no-store"
+      assert_equal "no-referrer", response.headers["Referrer-Policy"]
+      assert_equal "none", response.headers["X-Robots-Tag"]
+
+      get public_board_column_path(@key, column)
+      assert_response :success
+      assert_select "h1", text: column.name
+      assert_select "a[href=?]", public_board_card_path(@key, card), text: card.title
+      assert_select "a[href=?]", public_board_card_path(@key, cards(:text)), count: 0
+
+      get public_board_card_path(@key, card)
+      assert_response :success
+      assert_select "h1", text: card.title
+      assert_select "strong", text: "larger logo"
+      assert_select "li", text: "Get approval"
+      assert_select "form", count: 0
+      assert_not_includes response.body, comments(:logo_agreement_jz).body.to_plain_text
+    end
+  end
+
+  test "a signed-in visitor from another account sees the same read-only page" do
+    sign_in_as :mike
+
+    untenanted do
+      get public_board_path(@key)
+      assert_response :success
+      assert_select "h1", text: @board.name
+      assert_select "meta[name='current-user-id']", count: 0
+    end
+  end
+
+  test "draft cards are not visible on public boards or columns or at their direct links" do
+    column = columns(:writebook_triage)
+    draft = @board.cards.create!(title: "Unpublished design", status: :drafted, creator: users(:kevin), column: column)
+
+    untenanted do
+      get public_board_path(@key)
+      assert_response :success
+      assert_not_includes response.body, draft.title
+
+      get public_board_column_path(@key, column)
+      assert_response :success
+      assert_not_includes response.body, draft.title
+
+      get public_board_card_path(@key, draft)
+      assert_response :not_found
+    end
+  end
+
+  test "a key never grants access to columns or cards on other boards" do
+    other_board = boards(:private)
+    other_board.publish
+    other_column = other_board.columns.create!(name: "Private column")
+    other_card = Current.set(user: users(:kevin)) do
+      other_board.cards.create!(title: "Private card", status: :published)
+    end
+
+    untenanted do
+      get public_board_column_path(@key, other_column)
+      assert_response :not_found
+
+      get public_board_card_path(@key, other_card)
+      assert_response :not_found
+    end
+  end
+
+  test "public board and column listings link to further pages" do
+    column = columns(:writebook_triage)
+    card = cards(:logo)
+    Current.set(user: users(:kevin)) do
+      15.times { |i| @board.cards.create!(title: "New card #{i}", column: column, status: :published) }
+    end
+
+    untenanted do
+      [ public_board_path(@key), public_board_column_path(@key, column) ].each do |path|
+        get path
+        assert_response :success
+        assert_select "a[rel=next][href=?]", "#{path}?page=2"
+        assert_select "a[href=?]", public_board_card_path(@key, card), count: 0
+
+        get "#{path}?page=2"
+        assert_response :success
+        assert_select "a[href=?]", public_board_card_path(@key, card), text: card.title
+      end
+    end
+  end
+
+  test "only the exact key in the path grants access" do
+    untenanted do
+      get public_board_path(@board.id), params: { board_key: @key }
+      assert_response :not_found
+
+      get public_board_path(@key.swapcase)
+      assert_response :not_found
+    end
+  end
+
+  test "public links are unavailable while an account is inactive" do
+    @board.account.create_cancellation!(initiated_by: users(:kevin))
+
+    untenanted do
+      get public_board_path(@key)
+      assert_response :not_found
+    end
+  end
+
+  test "the publication is removed when the board is deleted" do
+    board = boards(:private)
+    publication = board.publish
+    board.destroy!
+
+    assert_not Board::Publication.exists?(publication.id)
+  end
+end
