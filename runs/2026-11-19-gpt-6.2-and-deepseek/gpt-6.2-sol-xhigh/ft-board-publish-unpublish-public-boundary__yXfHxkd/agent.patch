@@ -0,0 +1,15 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy, class_name: "Board::Publication"
+  end
+
+  def publish
+    with_lock { publication || create_publication! }
+  end
+
+  def unpublish
+    with_lock { self.publication = nil }
+  end
+end
