new file mode 100644
index 0000000..3114d8c
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,14 @@
+class Board::Publication < ApplicationRecord
+  belongs_to :board, touch: true
+
+  has_secure_token :key
+  self.filter_attributes += [ :key ]
+
+  def self.find_by_key!(key)
+    publication = find_by!(key: key)
+    # The database collation may match keys case-insensitively.
+    raise ActiveRecord::RecordNotFound unless publication.key == key
+
+    publication
+  end
+end
