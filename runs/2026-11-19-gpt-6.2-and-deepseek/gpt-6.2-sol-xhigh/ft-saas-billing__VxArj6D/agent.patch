diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..1f75e66
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,36 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <%= link_to "Accounts", saas.admin_accounts_path, class: "btn" %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel shadow">
+  <h2>Billing</h2>
+  <p>Account #<%= @account.external_account_id %> · <%= @account.billing_plan.name %><%= " (comped)" if @account.comped? %></p>
+  <p>Comping grants Unlimited without changing any Stripe subscription.</p>
+
+  <% if @account.comped? %>
+    <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+  <% else %>
+    <%= button_to "Comp", saas.admin_account_comp_path(@account), class: "btn" %>
+  <% end %>
+
+  <h2 class="margin-block-start">Usage override</h2>
+  <p>Measured usage: <%= pluralize(@account.cards.published.count, "card") %>, <%= number_to_human_size(@account.bytes_used) %>. Leave a field blank to use measured usage.</p>
+  <% if @overridden_limits.errors.any? %>
+    <ul role="alert">
+      <% @overridden_limits.errors.full_messages.each do |message| %>
+        <li><%= message %></li>
+      <% end %>
+    </ul>
+  <% end %>
+  <%= form_with model: @overridden_limits, scope: :overridden_limits, url: saas.admin_account_override_path(@account), method: :post do |form| %>
