+class Admin::Accounts::OverridesController < AdminController
+  layout "public"
+
+  before_action :set_account
+
+  def create
+    @overridden_limits = @account.overridden_limits || @account.build_overridden_limits
+
+    if @overridden_limits.update(override_params)
+      redirect_to saas.admin_account_path(@account), status: :see_other
+    else
+      render "admin/accounts/show", status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @account.overridden_limits&.destroy!
+    redirect_to saas.admin_account_path(@account), status: :see_other
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:account_id])
+    end
+
+    def override_params
+      params.expect(overridden_limits: %i[ card_count bytes_used ])
+    end
+end
