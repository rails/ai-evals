diff --git a/saas/test/controllers/account/billing_test.rb b/saas/test/controllers/account/billing_test.rb
new file mode 100644
index 0000000..0642f44
--- /dev/null
+++ b/saas/test/controllers/account/billing_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class Account::BillingTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @billing_path = "#{@account.slug}/account/billing"
+    @settings_url = "http://www.example.com#{@account.slug}/account/settings"
+    @plus_price_id = "price_test_plus"
+    @api_key = "stripe-test-key"
+    @previous_env = ENV.to_h.slice("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID", "STRIPE_SECRET_KEY")
+    ENV.update("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => @plus_price_id, "STRIPE_SECRET_KEY" => @api_key)
+  end
+
+  teardown do
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+    ENV.delete("STRIPE_SECRET_KEY")
+    ENV.update(@previous_env)
+  end
+
+  test "admins see the approved prices and allowances and can open Stripe Checkout" do
+    sign_in_as :mike
+    get @billing_path
+    assert_response :success
+    assert_match(/form-action[^;]*https:\/\/checkout\.stripe\.com/, response.headers["Content-Security-Policy"])
+    assert_select ".settings__panel", text: /Free.*1,000 cards.*1 GB/m
+    assert_select ".settings__panel", text: /Unlimited.*\$20\/month.*5 GB/m
+    assert_select ".settings__panel", text: /Unlimited\+.*\$25\/month.*500 GB/m
+    assert_select "form[action='#{@billing_path}/checkout'][data-turbo='false']", count: 2
+
+    customers = mock
+    customers.expects(:create).with(
+      { metadata: { fizzy_account_id: @account.id } }, { idempotency_key: "fizzy-account-#{@account.id}" }
+    ).returns(stub(id: "cus_checkout"))
+    checkout_sessions = mock
+    checkout_sessions.expects(:create).with(
+      mode: "subscription", customer: "cus_checkout", line_items: [ { price: @plus_price_id, quantity: 1 } ],
+      success_url: @settings_url, cancel_url: @settings_url
+    ).twice.returns(stub(url: "https://checkout.stripe.com/c/pay/test"))
+    Stripe::StripeClient.expects(:new).with(@api_key).twice.returns(stub(v1: stub(customers: customers, checkout: stub(sessions: checkout_sessions))))
+
+    2.times do
+      post "#{@billing_path}/checkout", params: { plan: "unlimited_plus", customer: "cus_untrusted", success_url: "https://example.org/" }
+      assert_response :see_other
+      assert_redirected_to "https://checkout.stripe.com/c/pay/test"
+    end
+    assert_equal "cus_checkout", @account.reload.billing_subscription.stripe_customer_id
+    assert_equal Billing::Plan::FREE, @account.billing_plan
+  end
+
+  test "portal uses the current account's Stripe customer and returns to its settings" do
+    @account.create_billing_subscription!(stripe_customer_id: "cus_portal", plan_key: "unlimited")
+    sign_in_as :mike
+
+    get @settings_url
+    assert_response :success
