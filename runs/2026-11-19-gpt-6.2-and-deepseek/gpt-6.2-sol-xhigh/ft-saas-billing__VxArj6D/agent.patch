diff --git a/saas/test/controllers/stripe_webhooks_controller_test.rb b/saas/test/controllers/stripe_webhooks_controller_test.rb
new file mode 100644
index 0000000..cdf2001
--- /dev/null
+++ b/saas/test/controllers/stripe_webhooks_controller_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_billing_subscription!(stripe_customer_id: "cus_billing")
+    @signing_secret = "test-webhook-secret"
+    @plus_price_id = "price_plus_test"
+    @unlimited_price_id = "price_unlimited_test"
+    @api_key = "stripe-test-key"
+    @stripe_env = {
+      "STRIPE_WEBHOOK_SECRET" => @signing_secret,
+      "STRIPE_SECRET_KEY" => @api_key,
+      "STRIPE_MONTHLY_V1_PRICE_ID" => @unlimited_price_id,
+      "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => @plus_price_id
+    }
+    @previous_env = ENV.to_h.slice(*@stripe_env.keys)
+    ENV.update(@stripe_env)
+  end
+
+  teardown do
+    @stripe_env.each_key { |key| ENV.delete(key) }
+    ENV.update(@previous_env)
+  end
+
+  test "signed subscription events apply the current Stripe plan including downgrades and cancellation" do
+    stripe = mock
+    stripe.expects(:list).with(customer: "cus_billing", status: "all", limit: 100).times(4).returns(
+      subscriptions([ @unlimited_price_id, "active" ]),
+      subscriptions([ @plus_price_id, "active" ]),
+      subscriptions([ @plus_price_id, "canceled" ], [ "price_unknown", "active" ]),
+      subscriptions([ @plus_price_id, "canceled" ])
+    )
+    Stripe::StripeClient.expects(:new).with(@api_key).times(4).returns(stub(v1: stub(subscriptions: stripe)))
+
+    send_signed_event("customer.subscription.created")
+    assert_response :no_content
+    assert_equal Billing::Plan::UNLIMITED, @subscription.reload.paid_plan
+    assert_equal 5.gigabytes, @account.reload.storage_limit
+
+    send_signed_event("customer.subscription.updated")
+    assert_response :no_content
+    assert_equal Billing::Plan::UNLIMITED_PLUS, @subscription.reload.paid_plan
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+
+    send_signed_event("customer.subscription.deleted", status: "canceled")
+    assert_response :no_content
+    assert_nil @subscription.reload.paid_plan
+    assert_equal 1.gigabyte, @account.reload.storage_limit
+
+    # An old event arriving late cannot reactivate a canceled subscription.
+    send_signed_event("customer.subscription.created")
+    assert_response :no_content
+    assert_nil @subscription.reload.paid_plan
+  end
+
+  test "invalid, missing, and stale signatures never reach Stripe or update the plan" do
+    Stripe::StripeClient.expects(:new).never
+
+    payload = event_payload("customer.subscription.updated")
+    post "/stripe/webhooks", params: payload, headers: { "Content-Type" => "application/json" }
+    assert_response :bad_request
+
+    sign_and_post(payload, secret: "wrong-secret")
+    assert_response :bad_request
+
+    sign_and_post(payload, timestamp: 10.minutes.ago)
+    assert_response :bad_request
+    assert_nil @subscription.reload.paid_plan
+  end
+
+  test "only the known customer mapping can update an account" do
+    Stripe::StripeClient.expects(:new).never
+
+    send_signed_event("customer.subscription.created", customer: "cus_unrecognized")
+    assert_response :no_content
+    assert_nil @subscription.reload.paid_plan
+
+    send_signed_event("invoice.payment_succeeded")
+    assert_response :no_content
+
+    sign_and_post(event_payload("customer.subscription.updated"), path: "#{@account.slug}/stripe/webhooks")
+    assert_response :not_found
+  end
+
+  test "Stripe API failures are retriable and preserve the current entitlement" do
+    @subscription.update!(plan_key: "unlimited")
+    stripe = mock
+    stripe.expects(:list).raises(Stripe::APIConnectionError)
+    Stripe::StripeClient.expects(:new).with(@api_key).returns(stub(v1: stub(subscriptions: stripe)))
+
+    send_signed_event("customer.subscription.deleted")
+    assert_response :service_unavailable
+    assert_equal Billing::Plan::UNLIMITED, @subscription.reload.paid_plan
+  end
+
+  private
+    def send_signed_event(type, **options)
+      sign_and_post event_payload(type, **options)
+    end
+
+    def event_payload(type, customer: "cus_billing", status: "active")
+      {
+        id: "evt_test", object: "event", type: type,
+        data: { object: { object: "subscription", id: "sub_test", customer: customer, status: status } }
+      }.to_json
+    end
+
+    def sign_and_post(payload, secret: @signing_secret, timestamp: Time.now, path: "/stripe/webhooks")
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, secret)
+      header = Stripe::Webhook::Signature.generate_header(timestamp, signature)
+      post path, params: payload, headers: { "Content-Type" => "application/json", "Stripe-Signature" => header }
+    end
+
+    def subscriptions(*price_and_statuses)
+      Stripe::ListObject.construct_from(
+        object: "list", has_more: false, data: price_and_statuses.map.with_index do |(price, status), index|
+          { object: "subscription", id: "sub_test_#{index}", status: status, items: { data: [ { price: { id: price } } ] } }
+        end
+      )
+    end
+end
