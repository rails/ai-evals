@@ -0,0 +1,16 @@
+class Account::Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Billing::Plan.paid(params.expect(:plan))
+    return head :unprocessable_entity unless plan
+    return head :service_unavailable unless plan.stripe_price_id
+    return redirect_to saas.account_billing_path, status: :see_other unless Current.account.billing_plan == Billing::Plan::FREE
+
+    subscription = Account::Subscription.create_or_find_by!(account: Current.account)
+    redirect_to subscription.checkout_url(plan, return_url: main_app.account_settings_url), allow_other_host: true, status: :see_other
+  rescue Stripe::StripeError => error
+    Rails.error.report(error, handled: true)
+    redirect_to saas.account_billing_path, alert: "Couldn’t open Stripe Checkout. Please try again.", status: :see_other
+  end
+end
