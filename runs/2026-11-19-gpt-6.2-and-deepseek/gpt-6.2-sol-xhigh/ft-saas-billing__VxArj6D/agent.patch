diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..d39b740
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,61 @@
+class Account::Subscription < SaasRecord
+  ENTITLED_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  def paid_plan
+    Billing::Plan.paid(plan_key)
+  end
+
+  def checkout_url(plan, return_url:)
+    stripe.checkout.sessions.create(
+      mode: "subscription",
+      customer: ensure_stripe_customer,
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      success_url: return_url,
+      cancel_url: return_url
+    ).url
+  end
+
+  def portal_url(return_url:)
+    stripe.billing_portal.sessions.create(customer: stripe_customer_id, return_url: return_url).url
+  end
+
+  def sync_from_stripe
+    with_lock do
+      update!(plan_key: current_stripe_plan&.key)
+    end
+  end
+
+  private
+    def stripe
+      @stripe ||= Stripe::StripeClient.new(ENV["STRIPE_SECRET_KEY"].presence).v1
+    end
+
+    def ensure_stripe_customer
+      with_lock do
+        unless stripe_customer_id
+          customer = stripe.customers.create(
+            { metadata: { fizzy_account_id: account_id } },
+            { idempotency_key: "fizzy-account-#{account_id}" }
+          )
+          update!(stripe_customer_id: customer.id)
+        end
+
+        stripe_customer_id
+      end
+    end
+
+    # Events can be duplicated or delivered out of order. Re-read Stripe's
+    # current state under the lock instead of applying an event snapshot.
+    def current_stripe_plan
+      subscriptions = stripe.subscriptions.list(customer: stripe_customer_id, status: "all", limit: 100)
+      subscriptions.auto_paging_each.flat_map do |subscription|
+        if ENTITLED_STATUSES.include?(subscription.status)
+          subscription.items.data.filter_map { |item| Billing::Plan.for_stripe_price(item.price.id) }
+        else
+          []
+        end
+      end.max_by(&:storage_limit)
+    end
+end
diff --git a/saas/app/models/billing/plan.rb b/saas/app/models/billing/plan.rb
new file mode 100644
index 0000000..1b9c600
--- /dev/null
+++ b/saas/app/models/billing/plan.rb
@@ -0,0 +1,18 @@
+class Billing::Plan < Data.define(:key, :name, :monthly_price, :card_limit, :storage_limit, :stripe_price_env)
+  FREE = new("free", "Free", 0, 1_000, 1.gigabyte, nil)
+  UNLIMITED = new("unlimited", "Unlimited", 20, nil, 5.gigabytes, "STRIPE_MONTHLY_V1_PRICE_ID")
+  UNLIMITED_PLUS = new("unlimited_plus", "Unlimited+", 25, nil, 500.gigabytes, "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  PAID = [ UNLIMITED, UNLIMITED_PLUS ].freeze
+
+  def self.paid(key)
+    PAID.find { |plan| plan.key == key }
+  end
+
+  def self.for_stripe_price(price_id)
+    PAID.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id }
+  end
+
+  def stripe_price_id
+    ENV[stripe_price_env].presence if stripe_price_env
+  end
+end
