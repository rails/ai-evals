+module Card::PublicationLimited
+  extend ActiveSupport::Concern
+
+  private
+    def enforce_card_limit
+      account = Current.account
+
+      if account.billing_plan.card_limit
+        account.with_lock do
+          if account.card_limit_reached?
+            head :forbidden
+          else
+            yield
+          end
+        end
+      else
+        yield
+      end
+    end
+end
