+<% @page_title = "Billing" %>
+
+<% content_for :header do %>
+  <%= link_to "Account Settings", main_app.account_settings_path, class: "btn" %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <p>Current plan: <strong><%= @account.billing_plan.name %></strong></p>
+    <% if @account.billing_subscription&.stripe_customer_id? %>
+      <%= render "account/billings/manage" %>
+    <% end %>
+  </div>
+
+  <% ([ Billing::Plan::FREE ] + Billing::Plan::PAID).each do |plan| %>
+    <div class="settings__panel panel shadow">
+      <h2><%= plan.name %></h2>
+      <p><%= number_to_currency(plan.monthly_price, precision: 0) %>/month</p>
+      <p><%= plan.card_limit ? number_with_delimiter(plan.card_limit) + " cards" : "Unlimited cards" %> · <%= number_to_human_size(plan.storage_limit) %> storage</p>
+      <% if @account.billing_plan == Billing::Plan::FREE && plan.stripe_price_env %>
+        <%= button_to "Upgrade to #{plan.name}", saas.account_billing_checkout_path, params: { plan: plan.key }, class: "btn", form: { data: { turbo: false } } %>
+      <% end %>
+    </div>
+  <% end %>
+</section>
