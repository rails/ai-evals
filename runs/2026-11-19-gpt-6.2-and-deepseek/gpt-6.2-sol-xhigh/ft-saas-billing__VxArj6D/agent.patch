diff --git a/saas/app/controllers/stripe_webhooks_controller.rb b/saas/app/controllers/stripe_webhooks_controller.rb
new file mode 100644
index 0000000..067e285
--- /dev/null
+++ b/saas/app/controllers/stripe_webhooks_controller.rb
@@ -0,0 +1,27 @@
+class StripeWebhooksController < ActionController::Base
+  skip_forgery_protection
+  wrap_parameters false
+
+  SUBSCRIPTION_EVENTS = %w[
+    customer.subscription.created customer.subscription.updated customer.subscription.deleted
+    customer.subscription.paused customer.subscription.resumed
+  ].freeze
+
+  def create
+    return head :not_found if request.env["fizzy.external_account_id"]
+    return head :service_unavailable unless secret = ENV["STRIPE_WEBHOOK_SECRET"].presence
+
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], secret)
+    if SUBSCRIPTION_EVENTS.include?(event[:type])
+      customer_id = event[:data]&.[](:object)&.[](:customer)
+      Account::Subscription.find_by(stripe_customer_id: customer_id)&.sync_from_stripe if customer_id.is_a?(String) && customer_id.present?
+    end
+
+    head :no_content
+  rescue Stripe::SignatureVerificationError, JSON::ParserError
+    head :bad_request
+  rescue Stripe::StripeError => error
+    Rails.error.report(error, handled: true)
+    head :service_unavailable
+  end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..ff226b3
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,44 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :billing_subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limits, class_name: "Account::OverriddenLimits", dependent: :destroy
+  end
+
+  def billing_plan
+    billing_subscription&.paid_plan || (comped? ? Billing::Plan::UNLIMITED : Billing::Plan::FREE)
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(comped)
+    if comped
+      Account::BillingWaiver.create_or_find_by!(account: self)
+    else
+      billing_waiver&.destroy!
+    end
+    reset_billing_waiver
+  end
+
+  def card_usage
+    overridden_limits&.card_count || cards.published.count
+  end
+
+  def cards_left
+    if limit = billing_plan.card_limit
+      [ limit - card_usage, 0 ].max
+    end
+  end
+
+  def card_limit_reached?
+    cards_left == 0
+  end
+
+  def storage_usage
+    overridden_limits&.bytes_used || bytes_used
+  end
+end
