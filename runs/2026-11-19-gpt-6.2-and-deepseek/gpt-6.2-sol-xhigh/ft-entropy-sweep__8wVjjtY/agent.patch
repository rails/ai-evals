+          .left_outer_joins(board: :entropy)
+          .joins(ACCOUNT_ENTROPY_JOIN)
+          .where("last_active_at <= #{connection.date_subtract("?", EFFECTIVE_ENTROPY_PERIOD)}", now)
+      end
