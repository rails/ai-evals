diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..c6552f1
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,195 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { FetchRequest } from "@rails/request.js"
+
+const ITEM_SELECTOR = '[data-drag-and-drop-target~="item"]'
+const COLUMN_SELECTOR = '[data-drag-and-drop-target~="column"]'
+
+export default class extends Controller {
+  static targets = [ "item", "error" ]
+
+  #desktop = window.matchMedia("(min-width: 640px)")
+  #draggedItem
+  #hoveredColumn
+  #saving = Promise.resolve()
+
+  connect() {
+    this.#desktop.addEventListener("change", this.#updateDraggability)
+  }
+
+  disconnect() {
+    this.#desktop.removeEventListener("change", this.#updateDraggability)
+    this.end()
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = this.#desktop.matches
+  }
+
+  itemTargetDisconnected(item) {
+    item.removeAttribute("draggable")
+  }
+
+  prepareItem({ target }) {
+    if (target.matches(ITEM_SELECTOR)) this.itemTargetConnected(target)
+  }
+
+  start(event) {
+    const item = event.target
+    if (!item.matches(ITEM_SELECTOR)) return
+
+    if (!this.#desktop.matches || item.hasAttribute("data-drag-and-drop-pending")) {
+      event.preventDefault()
+      return
+    }
+
+    this.end()
+    this.#draggedItem = item
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+    item.classList.add("drag-and-drop__dragged-item")
+  }
+
+  hover(event) {
+    const column = this.#destinationFor(event.target)
+    this.#highlight(column)
+
+    if (column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave({ target, relatedTarget }) {
+    const column = target.closest(COLUMN_SELECTOR)
+    if (column && column === this.#hoveredColumn && !column.contains(relatedTarget)) this.#highlight(null)
+  }
+
+  drop(event) {
+    const item = this.#draggedItem
+    const destination = this.#destinationFor(event.target)
+    this.end()
+    if (!destination) return
+
+    event.preventDefault()
+    this.#move(item, destination)
+  }
+
+  end() {
+    this.#draggedItem?.classList.remove("drag-and-drop__dragged-item")
+    this.#draggedItem = null
+    this.#highlight(null)
+  }
+
+  #updateDraggability = () => {
+    this.end()
+    this.itemTargets.forEach(item => this.itemTargetConnected(item))
+  }
+
+  #destinationFor(target) {
+    if (!this.#draggedItem || !this.element.contains(this.#draggedItem)) return null
+
+    const column = target.closest(COLUMN_SELECTOR)
+    if (column && !column.contains(this.#draggedItem) && column.querySelector(".cards__list")) return column
+
+    return null
+  }
+
+  #highlight(column) {
+    if (this.#hoveredColumn === column) return
+
+    this.#hoveredColumn?.classList.remove("drag-and-drop__hover-container")
+    column?.classList.add("drag-and-drop__hover-container")
+    this.#hoveredColumn = column
+  }
+
+  async #move(item, destination) {
+    const source = item.closest(COLUMN_SELECTOR)
+    const { parentNode, nextSibling, previousSibling } = item
+
+    item.removeAttribute("aria-selected")
+    item.setAttribute("data-drag-and-drop-pending", "")
+    this.#insertInColumnOrder(item, destination)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(destination, 1)
+
+    // Save in drop order so the server's activity-based order matches the board.
+    const save = this.#saving.then(() => this.#save(item, destination))
+    this.#saving = save.catch(() => {})
+
+    try {
+      const preview = await save
+      // Refresh the card's content without re-rendering either column.
+      if (this.element.contains(item)) Turbo.morphElements(item, preview)
+    } catch {
+      if (this.element.contains(item) && this.element.contains(parentNode)) {
+        if (nextSibling?.parentNode === parentNode) {
+          parentNode.insertBefore(item, nextSibling)
+        } else if (previousSibling?.parentNode === parentNode) {
+          previousSibling.after(item)
+        } else {
+          parentNode.prepend(item)
+        }
+        this.#adjustCount(source, 1)
+        this.#adjustCount(destination, -1)
+        this.element.after(this.errorTarget.content.cloneNode(true))
+      }
+    } finally {
+      item.removeAttribute("data-drag-and-drop-pending")
+    }
+  }
+
+  #insertInColumnOrder(item, column) {
+    const list = column.querySelector(".cards__list")
+    const cards = [...list.querySelectorAll(ITEM_SELECTOR)]
+    const goldenFirst = [ "maybe", "column" ].includes(column.dataset.dragAndDropDestination)
+    const following = goldenFirst && !item.classList.contains("golden-effect")
+      ? cards.find(card => !card.classList.contains("golden-effect"))
+      : cards[0]
+
+    if (following) {
+      following.before(item)
+    } else if (cards.length) {
+      cards.at(-1).after(item)
+    } else {
+      // Keep the card inside the first page if a paginated list is now empty.
+      const firstPage = list.querySelector("turbo-frame") || list
+      firstPage.prepend(item)
+    }
+  }
+
+  #adjustCount(column, adjustment) {
+    const counter = column.querySelector(".cards__expander-count")
+    const count = Number(counter.dataset.count) + adjustment
+    counter.dataset.count = count
+    counter.textContent = count > 99 ? "99+" : count
+  }
+
+  async #save(item, column) {
+    const { method, url, columnId } = this.#moveRequest(item, column)
+    const query = { preview: true }
+    if (columnId) query.column_id = columnId
+
+    // Request.js uses Turbo.fetch so this tab ignores its own refresh broadcast.
+    const response = await new FetchRequest(method, url, { query, responseKind: "html", redirect: "error" }).perform()
+    if (!response.ok) throw new Error("Card move failed")
+
+    const template = document.createElement("template")
+    template.innerHTML = await response.html
+    const preview = template.content.firstElementChild
+    if (preview?.id !== item.id) throw new Error("Missing card preview")
+
+    return preview
+  }
+
+  #moveRequest(item, column) {
+    const { cardTriageUrl, cardNotNowUrl, cardClosureUrl } = item.dataset
+
+    switch (column.dataset.dragAndDropDestination) {
+      case "column": return { method: "post", url: cardTriageUrl, columnId: column.dataset.dragAndDropColumnId }
+      case "maybe":  return { method: "delete", url: cardTriageUrl }
+      case "not-now": return { method: "post", url: cardNotNowUrl }
+      case "done": return { method: "post", url: cardClosureUrl }
+    }
+  }
+}
