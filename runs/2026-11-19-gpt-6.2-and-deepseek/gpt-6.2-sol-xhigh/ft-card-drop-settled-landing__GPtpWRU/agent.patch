diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..4d5d69e
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,118 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  test "dropping a card moves it before the save finishes and respects column order" do
+    card = cards(:logo)
+    golden = cards(:text)
+    golden.gild
+    card.ungild
+    destination = dom_id(columns(:writebook_in_progress))
+    visit_board
+
+    assert_selector "##{destination} ##{dom_id(golden, :article)}.golden-effect", visible: :all
+    drag_card card, to: destination
+
+    assert_card_order destination, golden, card
+    assert_equal columns(:writebook_in_progress), card.reload.column
+    refresh
+    assert_card_order destination, golden, card
+  end
+
+  test "moving through Not Now, Done, and Maybe" do
+    card = cards(:logo)
+    visit_board
+
+    drag_card card, to: "not-now"
+    assert card.reload.postponed?
+    assert_selector "#not-now ##{dom_id(card, :article)} .card__closed-title[data-text='Not Now']", visible: :all
+
+    drag_card card, to: "closed-cards"
+    assert card.reload.closed?
+    assert_selector "#closed-cards ##{dom_id(card, :article)} .card__closed-title[data-text='Done']", visible: :all
+
+    drag_card card, to: "maybe"
+    assert card.reload.awaiting_triage?
+    assert_no_selector "#maybe ##{dom_id(card, :article)} .card__closed", visible: :all
+  end
+
+  test "dropping within a column does not reorder or save" do
+    card = cards(:logo)
+    visit_board
+    activity = card.last_active_at
+    source = find("##{dom_id(card, :article)}", visible: :all)
+    target = find("##{dom_id(card.column)}")
+
+    page.execute_script(<<~JS, source, target)
+      const [card, column] = arguments
+      const previous = card.previousElementSibling
+      const transfer = new DataTransfer()
+      card.dispatchEvent(new DragEvent('dragstart', { bubbles: true, dataTransfer: transfer }))
+      column.dispatchEvent(new DragEvent('drop', { bubbles: true, cancelable: true, dataTransfer: transfer }))
+      if (previous !== card.previousElementSibling || card.hasAttribute('data-move-pending')) {
+        throw new Error('A same-column drop must not move or save the card')
+      }
+    JS
+
+    assert_equal activity, card.reload.last_active_at
+  end
+
+  test "a failed save restores the card to its original column" do
+    card = cards(:logo)
+    source = dom_id(card.column)
+    visit_board
+    page.execute_script(<<~JS)
+      const fetch = window.fetch
+      window.fetch = (url, options) => {
+        if (options?.method === 'POST' && String(url).includes('/not_now')) {
+          return Promise.resolve(new Response(null, { status: 500 }))
+        }
+        return fetch(url, options)
+      }
+    JS
+
+    drag_card card, to: "not-now", saved: false
+
+    assert_selector "##{source} ##{dom_id(card, :article)}:not([data-move-pending])", visible: :all
+    assert_no_selector "#not-now ##{dom_id(card, :article)}", visible: :all
+    assert_equal columns(:writebook_triage), card.reload.column
+  end
+
+  private
+    def visit_board
+      sign_in_as users(:david)
+      visit board_url(boards(:writebook))
+    end
+
+    def drag_card(card, to:, saved: true)
+      source = find("##{dom_id(card, :article)}[draggable=true]", visible: :all)
+      target = find("##{to}")
+      assert_selector "##{to} .cards__list turbo-frame", visible: :all
+
+      page.execute_script(<<~JS, source, target)
+        const [card, target] = arguments
+        const transfer = new DataTransfer()
+        const drag = (element, type) => element.dispatchEvent(new DragEvent(type, {
+          bubbles: true, cancelable: true, dataTransfer: transfer
+        }))
+
+        drag(card, 'dragstart')
+        drag(target, 'dragover')
+        if (!card.classList.contains('drag-and-drop__dragged-item') ||
+            !target.classList.contains('drag-and-drop__hover-container')) throw new Error('Missing drag feedback')
+
+        drag(target, 'drop')
+        if (!target.contains(card) || !card.hasAttribute('data-move-pending')) {
+          throw new Error('Card did not move synchronously')
+        }
+        if (card.classList.contains('drag-and-drop__dragged-item') ||
+            target.classList.contains('drag-and-drop__hover-container')) throw new Error('Drag feedback was not cleared')
+      JS
+
+      assert_selector "##{to} ##{dom_id(card, :article)}:not([data-move-pending])", visible: :all if saved
+    end
+
+    def assert_card_order(column, *cards)
+      assert_selector "##{column} article.card", count: cards.size, visible: :all
+      assert_equal cards.map { |card| dom_id(card, :article) }, all("##{column} article.card", visible: :all).map { |element| element[:id] }
+    end
+end
