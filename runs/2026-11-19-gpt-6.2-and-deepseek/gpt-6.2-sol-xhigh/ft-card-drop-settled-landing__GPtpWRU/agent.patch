diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..ab98c4d
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,182 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const columnSelector = "[data-card-drop-destination]"
+const draggedClass = "drag-and-drop__dragged-item"
+const hoverClass = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "card" ]
+
+  #card
+  #hoveredColumn
+  #pending = new Set()
+
+  cardTargetConnected(card) {
+    if (card.closest(columnSelector)) card.draggable = true
+  }
+
+  cardTargetDisconnected(card) {
+    card.removeAttribute("draggable")
+    if (card === this.#card) this.end()
+  }
+
+  disconnect() {
+    this.end()
+  }
+
+  start(event) {
+    const card = event.target.closest("article[data-drag-and-drop-target='card']")
+    if (!card?.closest(columnSelector) || !event.dataTransfer) return
+    if (this.#pending.has(card.id)) {
+      event.preventDefault()
+      return
+    }
+
+    this.#card = card
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+    card.classList.add(draggedClass)
+  }
+
+  over(event) {
+    if (!this.#card) return
+
+    const column = event.target.closest(columnSelector)
+    const destination = column !== this.#card.closest(columnSelector) && this.#firstPage(column) ? column : null
+    this.#highlight(destination)
+
+    if (destination) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (!this.#hoveredColumn?.contains(event.relatedTarget)) this.#highlight(null)
+  }
+
+  async drop(event) {
+    const card = this.#card
+    this.end()
+    if (!card) return
+
+    event.preventDefault()
+    const source = card.closest(columnSelector)
+    const destination = event.target.closest(columnSelector)
+    const firstPage = this.#firstPage(destination)
+    if (!source || source === destination || !firstPage) return
+
+    const original = card.cloneNode(true)
+    const originalParent = card.parentElement
+    const originalNext = card.nextElementSibling
+    const status = destination.dataset.cardDropDestination
+
+    this.#pending.add(card.id)
+    card.dataset.movePending = ""
+    this.#insert(card, destination, firstPage)
+    this.#updatePreview(card, destination, status)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(destination, 1)
+    if (destination.classList.contains("is-collapsed")) destination.focus({ preventScroll: true })
+
+    try {
+      const response = await this.#save(card, status)
+      if (!response.ok) throw new Error(`HTTP ${response.statusCode}`)
+    } catch (error) {
+      if (destination.contains(card) && this.element.contains(originalParent)) {
+        originalParent.insertBefore(original, originalNext?.parentElement === originalParent ? originalNext : null)
+        card.remove()
+        this.#adjustCount(source, 1)
+        this.#adjustCount(destination, -1)
+      }
+      console.error("Could not move card", error)
+    } finally {
+      this.#pending.delete(card.id)
+      delete card.dataset.movePending
+    }
+  }
+
+  end() {
+    this.#card?.classList.remove(draggedClass)
+    this.#card = null
+    this.#highlight(null)
+  }
+
+  #highlight(column) {
+    if (column === this.#hoveredColumn) return
+    this.#hoveredColumn?.classList.remove(hoverClass)
+    column?.classList.add(hoverClass)
+    this.#hoveredColumn = column
+  }
+
+  #firstPage(column) {
+    return column?.querySelector('.cards__list turbo-frame[id$="-pagination-contents-1"]')
+  }
+
+  #insert(card, column, firstPage) {
+    const status = column.dataset.cardDropDestination
+    // Moving records fresh activity (or a fresh closure). Active lists still put gold cards first.
+    if (status === "closed" || status === "not-now" || card.classList.contains("golden-effect")) {
+      firstPage.prepend(card)
+    } else {
+      const cards = [...column.querySelectorAll("article.card")]
+      const firstRegular = cards.find(item => !item.classList.contains("golden-effect"))
+      if (firstRegular) firstRegular.before(card)
+      else if (cards.length) cards.at(-1).after(card)
+      else firstPage.prepend(card)
+    }
+  }
+
+  #save(card, status) {
+    const options = { responseKind: "json" }
+    switch (status) {
+      case "maybe": return destroy(card.dataset.moveTriageUrl, options)
+      case "closed": return post(card.dataset.moveClosureUrl, options)
+      case "not-now": return post(card.dataset.moveNotNowUrl, options)
+      default: return post(card.dataset.moveTriageUrl, { ...options, query: { column_id: status } })
+    }
+  }
+
+  #updatePreview(card, column, status) {
+    const active = status !== "closed" && status !== "not-now"
+    card.classList.toggle("card--active", active)
+    card.classList.toggle("card--postponed", status === "not-now")
+    card.removeAttribute("aria-selected")
+    card.querySelector(".card__header .card__column-name--current")?.remove()
+    card.querySelector(".card__closed")?.remove()
+    card.querySelector(".bubble")?.remove()
+
+    if (status !== "closed") {
+      card.style.setProperty("--card-color", active && status !== "maybe" ? column.style.getPropertyValue("--card-color") : "var(--color-card-default)")
+      for (const stage of card.querySelectorAll("[data-stage-column]")) {
+        stage.classList.toggle("card__column-name--current", stage.dataset.stageColumn === status)
+      }
+    }
+
+    if (active && status !== "maybe") {
+      const label = document.createElement("span")
+      label.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+      const text = document.createElement("span")
+      text.className = "overflow-ellipsis"
+      text.textContent = column.dataset.columnName
+      label.append(text)
+      card.querySelector(".card__header").append(label)
+    }
+
+    if (!active) {
+      const stamp = this.element.querySelector(`template[data-drop-stamp="${status}"]`).content.cloneNode(true)
+      stamp.querySelector(".card__closed-date").textContent = new Intl.DateTimeFormat("en-US", {
+        month: "short", day: "2-digit", year: "numeric"
+      }).format(new Date())
+      card.querySelector(".card__body").append(stamp)
+    }
+  }
+
+  #adjustCount(column, delta) {
+    const button = column.querySelector("[data-card-count]")
+    const count = Number(button.dataset.cardCount) + delta
+    button.dataset.cardCount = count
+    button.querySelector(".cards__expander-count").textContent = count > 99 ? "99+" : count
+  }
+}
