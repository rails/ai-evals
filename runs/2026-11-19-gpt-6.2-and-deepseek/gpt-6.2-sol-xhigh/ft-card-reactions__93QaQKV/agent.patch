@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Account::DataTransfer::ReactionRecordSetTest < ActiveSupport::TestCase
+  test "imports legacy comment reactions" do
+    account = accounts("37s")
+    data = {
+      id: ActiveRecord::FixtureSet.identify("legacy_reaction", :uuid),
+      account_id: account.id,
+      comment_id: comments(:logo_1).id,
+      reacter_id: users(:david).id,
+      content: "👍",
+      created_at: Time.current,
+      updated_at: Time.current
+    }
+    io = StringIO.new
+    zip = ZipFile::Writer.new(io)
+    zip.add_file("data/reactions/#{data[:id]}.json", data.to_json)
+    zip.close
+    io.rewind
+
+    Account::DataTransfer::ReactionRecordSet.new(account).import(from: ZipFile::Reader.new(io))
+
+    assert_equal comments(:logo_1), Reaction.find(data[:id]).reactable
+  end
+end
