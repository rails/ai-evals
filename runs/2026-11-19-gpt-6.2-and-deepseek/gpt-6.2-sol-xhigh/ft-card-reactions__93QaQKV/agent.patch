diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..5da6d04
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+  end
+
+  test "card detail offers a reaction control for the card itself" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@card, :reacting)} a.reactions__trigger[href=?]", new_card_reaction_path(@card), text: "Add your own reaction"
+  end
+
+  test "new reaction form targets the card" do
+    get new_card_reaction_path(@card)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@card, :new_reaction)}" do
+      assert_select "form[action=?]", card_reactions_path(@card)
+      assert_select "a[href=?]", card_reactions_path(@card), text: "Cancel"
+    end
+  end
+
+  test "create a card reaction" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+
+    assert_equal users(:david), @card.reactions.last.reacter
+  end
+
+  test "delete your own card reaction" do
+    reaction = @card.reactions.create!(content: "Great work!", reacter: users(:david))
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "cannot delete someone else's card reaction" do
+    reaction = @card.reactions.create!(content: "Great work!", reacter: users(:kevin))
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+
+      assert_response :forbidden
+    end
+  end
+
+  test "a comment reaction cannot be deleted as a card reaction" do
+    comment = comments(:logo_1)
+    reaction = comment.reactions.create!(content: "Great work!", reacter: users(:david))
+
+    assert_no_difference -> { comment.reactions.count } do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+
+      assert_response :not_found
+    end
+  end
+
+  test "cannot react to an inaccessible card" do
+    card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Private card", status: :published) }
+
+    assert_no_difference -> { card.reactions.count } do
+      post card_reactions_path(card), params: { content: "👍" }, as: :json
+
+      assert_response :not_found
+    end
+  end
+
+  test "create, list and delete card reactions as JSON" do
+    post card_reactions_path(@card), params: { content: "👍" }, as: :json
+
+    assert_response :created
+    reaction = @card.reactions.last
+    assert_equal "👍", response.parsed_body["content"]
+    assert_equal card_reaction_url(@card, reaction), response.parsed_body["url"]
+
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal [ reaction.id ], response.parsed_body.pluck("id")
+
+    delete card_reaction_path(@card, reaction), as: :json
+
+    assert_response :no_content
+    assert_empty @card.reactions
+  end
+end
