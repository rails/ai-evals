@@ -0,0 +1,28 @@
+require "application_system_test_case"
+
+class CardReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "reacting to a card and deleting the reaction from its detail view" do
+    card = cards(:logo)
+    sign_in_as users(:david)
+    visit card_url(card)
+
+    reacting_frame = "##{dom_id(card, :reacting)}"
+    within reacting_frame do
+      click_on "Add your own reaction"
+      click_on "Cancel"
+      click_on "Add your own reaction"
+      find(".reaction__menu-btn").click
+      find("button[title='Thumbs up']").click
+      click_on "Submit"
+    end
+
+    within reacting_frame do
+      find(".reaction--deleteable [data-reaction-delete-target='content']", text: "👍").click
+      click_on "Delete this reaction"
+    end
+
+    assert_no_selector "#{reacting_frame} .reaction"
+  end
+end
