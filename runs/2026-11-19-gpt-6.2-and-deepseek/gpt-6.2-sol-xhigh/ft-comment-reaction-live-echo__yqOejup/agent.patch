+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding, canceling, and removing reactions updates both viewers" do
+    open_card_as :kevin
+
+    using_session(:other_viewer) do
+      open_card_as :jz
+      within_reactions do
+        click_on "Add a reaction"
+        fill_in "Reaction", with: "My draft"
+      end
+    end
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "Not sent"
+      click_on "Cancel reaction"
+      assert_button "Add a reaction"
+      assert_no_field "Reaction"
+      assert_no_text "Not sent"
+
+      click_on "Add a reaction"
+      assert_field "Reaction", with: ""
+      fill_in "Reaction", with: "Nice work"
+      click_on "Confirm reaction"
+      assert_button "Nice work"
+      assert_button "Add a reaction"
+      assert_no_field "Reaction"
+      assert_selector ".reactions__list .reaction", count: 1
+    end
+
+    using_session(:other_viewer) do
+      within_reactions do
+        assert_text "Nice work"
+        assert_selector "img[title='#{users(:kevin).name}']"
+        assert_no_button "Nice work"
+        assert_no_button "Remove reaction"
+        assert_field "Reaction", with: "My draft"
+      end
+    end
+
+    within_reactions do
+      find(".reactions__list .reaction").click
+      click_on "Remove reaction"
+      assert_no_text "Nice work"
+    end
+
+    using_session(:other_viewer) do
+      within_reactions do
+        assert_no_text "Nice work"
+        assert_field "Reaction", with: "My draft"
+      end
+    end
+  end
+
+  test "the composer enforces the length limit and can add more than one reaction" do
+    open_card_as :kevin
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "12345678901234567"
+      click_on "Confirm reaction"
+      assert_selector ".reaction__input:invalid"
+      assert_no_selector ".reactions__list .reaction"
+
+      fill_in "Reaction", with: "1234567890123456"
+      click_on "Confirm reaction"
+      assert_button "Add a reaction"
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "✨"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", count: 2
+      assert_button "Add a reaction"
+    end
+
+    visit card_url(@comment.card)
+    within_reactions do
+      assert_button "1234567890123456"
+      assert_button "✨"
+    end
+  end
+
+  private
+    def open_card_as(user)
+      sign_in_as users(user)
+      visit card_url(@comment.card)
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def within_reactions(&block)
+      within "##{dom_id(@comment)} .reactions", &block
+    end
+end
