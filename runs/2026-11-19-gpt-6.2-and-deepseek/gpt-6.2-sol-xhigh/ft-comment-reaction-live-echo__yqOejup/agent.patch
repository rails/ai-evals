diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..1322377
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,31 @@
+class Reaction < ApplicationRecord
+  MAX_LENGTH = 16
+  MAX_CONTENT_BYTES = 65_535 # MySQL TEXT limit
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, inverse_of: :reactions
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: -> { it.strip }
+
+  validates :content, presence: true
+  validate :content_length
+
+  after_create_commit :broadcast_addition
+  after_destroy_commit :broadcast_removal
+
+  private
+    def content_length
+      if content && (content.bytesize > MAX_CONTENT_BYTES || content.each_grapheme_cluster.take(MAX_LENGTH + 1).size > MAX_LENGTH)
+        errors.add(:content, :too_long, count: MAX_LENGTH)
+      end
+    end
+
+    def broadcast_addition
+      broadcast_append_to comment.card, :activity, target: [ comment, :reactions ]
+    end
+
+    def broadcast_removal
+      broadcast_remove_to comment.card, :activity
+    end
+end
