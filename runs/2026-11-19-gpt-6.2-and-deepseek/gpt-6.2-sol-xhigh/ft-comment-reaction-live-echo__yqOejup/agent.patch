+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,48 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :ensure_comment_is_reactable, only: :create
+
+  def create
+    respond_to do |format|
+      format.turbo_stream do
+        reaction = @comment.reactions.create(reaction_params)
+
+        if reaction.persisted?
+          render turbo_stream: turbo_stream.append([ @comment, :reactions ], partial: "reactions/reaction", locals: { reaction: reaction })
+        else
+          head :unprocessable_entity
+        end
+      end
+    end
+  end
+
+  def destroy
+    reaction = @comment.reactions.find(params[:id])
+
+    respond_to do |format|
+      format.turbo_stream do
+        if reaction.creator == Current.user
+          reaction.destroy!
+          render turbo_stream: turbo_stream.remove(reaction)
+        else
+          head :forbidden
+        end
+      end
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def ensure_comment_is_reactable
+      head :forbidden unless @comment.reactable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..1f2cdfb
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,29 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "label", "trigger", "deleteForm" ]
+  static values = { creatorId: String }
+
+  connect() {
+    this.updateOwnership()
+  }
+
+  updateOwnership() {
+    const isOwner = this.#isOwner
+    this.element.classList.toggle("reaction--deleteable", isOwner)
+    this.triggerTarget.hidden = !isOwner
+    this.labelTarget.hidden = isOwner
+  }
+
+  toggle(event) {
+    if (!this.#isOwner || this.deleteFormTarget.contains(event.target)) return
+
+    const expanded = this.element.classList.toggle("expanded")
+    this.triggerTarget.setAttribute("aria-expanded", expanded)
+    this.deleteFormTarget.hidden = !expanded
+  }
+
+  get #isOwner() {
+    return window.Current.user?.id === this.creatorIdValue
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..1e20c26
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,52 @@
+import { Controller } from "@hotwired/stimulus"
+
+const segmenter = Intl.Segmenter && new Intl.Segmenter(undefined, { granularity: "grapheme" })
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "error" ]
+  static values = { maxLength: Number }
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    if (!this.formTarget.hasAttribute("aria-busy")) this.#close()
+  }
+
+  validate() {
+    const content = this.inputTarget.value.trim()
+    let message = ""
+
+    if (!content) {
+      message = "Enter a reaction."
+    } else if (segmenter && [...segmenter.segment(content)].length > this.maxLengthValue) {
+      message = `Use ${this.maxLengthValue} characters or fewer.`
+    }
+
+    this.inputTarget.setCustomValidity(message)
+    this.errorTarget.hidden = true
+  }
+
+  submitted({ detail: { success } }) {
+    if (success) {
+      this.#close()
+    } else {
+      this.errorTarget.hidden = false
+      this.inputTarget.focus()
+    }
+  }
+
+  #close() {
+    this.formTarget.reset()
+    this.inputTarget.setCustomValidity("")
+    this.errorTarget.hidden = true
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+}
