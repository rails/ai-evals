index 0000000..72ba3ac
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,24 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  test "a multi-codepoint emoji counts as one character" do
+    emoji = "👩‍💻"
+    reaction = comments(:logo_agreement_jz).reactions.new(creator: users(:kevin), content: " #{emoji * 16} ")
+
+    assert reaction.valid?
+    assert_equal emoji * 16, reaction.content
+
+    reaction.content += emoji
+    assert_not reaction.valid?
+    assert reaction.errors.added?(:content, :too_long, count: 16)
+  end
+
+  test "destroying a comment destroys its reactions" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(creator: users(:kevin), content: "Nice work")
+
+    comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
