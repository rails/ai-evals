diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..19c350a
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "creating a reaction appends escaped text to the comment for everyone viewing the card" do
+    content = "<b>Nice work</b>"
+    target = dom_id(@comment, :reactions)
+
+    broadcasts = capture_turbo_stream_broadcasts([ @card, :activity ]) do
+      assert_difference -> { @comment.reactions.count }, 1 do
+        post card_comment_reactions_path(@card, @comment), params: {
+          reaction: { content: content, creator_id: users(:jz).id }
+        }, as: :turbo_stream
+      end
+    end
+
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @card.account, reaction.account
+    assert_response :success
+    assert_select "turbo-stream[action='append'][target='#{target}'] ##{dom_id(reaction)} .txt-small", text: content
+    assert_select "##{dom_id(reaction)} b", count: 0
+    assert_equal [ [ "append", target ] ], broadcasts.map { |stream| [ stream["action"], stream["target"] ] }
+  end
+
+  test "blank and overlong reactions are rejected" do
+    [ "   ", "12345678901234567" ].each do |content|
+      assert_no_difference -> { @comment.reactions.count } do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "system history does not accept reactions" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, comments(:logo_1)), params: { reaction: { content: "Nice work" } }, as: :turbo_stream
+    end
+    assert_response :forbidden
+  end
+
+  test "a comment must belong to the card in the URL" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(cards(:layout), @comment), params: { reaction: { content: "Nice work" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "viewers without access to a board cannot react" do
+    private_board = boards(:private)
+    private_card = Current.with(user: users(:kevin)) do
+      private_board.cards.create!(title: "Private card", status: :published)
+    end
+    private_comment = private_card.comments.create!(body: "Private comment", creator: users(:kevin))
+    logout_and_sign_in_as :jz
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(private_card, private_comment), params: { reaction: { content: "Nice work" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "removing your own reaction broadcasts its removal" do
+    reaction = @comment.reactions.create!(creator: users(:kevin), content: "Nice work")
+
+    broadcasts = capture_turbo_stream_broadcasts([ @card, :activity ]) do
+      assert_difference -> { @comment.reactions.count }, -1 do
+        delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+      end
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action='remove'][target='#{dom_id(reaction)}']"
+    assert_equal [ [ "remove", dom_id(reaction) ] ], broadcasts.map { |stream| [ stream["action"], stream["target"] ] }
+  end
+
+  test "only the author of a reaction can remove it" do
+    reaction = @comment.reactions.create!(creator: users(:jz), content: "Nice work")
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
