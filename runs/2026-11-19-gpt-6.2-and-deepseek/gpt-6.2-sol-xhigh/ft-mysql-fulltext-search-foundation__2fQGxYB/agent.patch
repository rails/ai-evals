index 0000000..98af93a
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,26 @@
+module SearchesHelper
+  def search_highlight_pattern(terms)
+    alternatives = terms.sort_by { |term| -term.length }.map { |term| Regexp.escape(term) }
+    /(#{alternatives.join("|")})/i
+  end
+
+  def highlight_search_text(text, pattern)
+    parts = text.to_s.split(pattern).map.with_index do |part, index|
+      index.odd? ? tag.mark(part) : part
+    end
+
+    safe_join(parts)
+  end
+
+  def search_excerpt(text, pattern)
+    if text && (match = pattern.match(text))
+      start = [ match.begin(0) - 70, 0 ].max
+      finish = [ match.end(0) + 70, text.length ].min
+      safe_join([
+        ("…" if start.positive?),
+        highlight_search_text(text[start...finish], pattern),
+        ("…" if finish < text.length)
+      ].compact)
+    end
+  end
+end
