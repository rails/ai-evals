diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..fecb559
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,64 @@
+class Card::Search
+  MAX_QUERY_LENGTH = 200
+
+  attr_reader :query, :terms
+
+  def initialize(user:, query:)
+    @user = user
+    @query = query.to_s.strip
+    @terms = too_long? ? [] : @query.scan(/[^[:space:]]+/).map(&:downcase).uniq
+  end
+
+  def too_long?
+    query.length > MAX_QUERY_LENGTH
+  end
+
+  def searching?
+    terms.present?
+  end
+
+  def cards
+    cards = accessible_cards
+    return cards.none unless searching?
+
+    terms.each do |term|
+      body_match = matches("action_text_rich_texts.plain_text_body", term)
+      cards = cards.where(matches("cards.title", term)
+        .or(descriptions.where(body_match).select(1).arel.exists)
+        .or(comments.where(body_match).select(1).arel.exists))
+    end
+
+    cards.reverse_chronologically.preload(:board, :rich_text_description)
+  end
+
+  def matching_comments_for(cards)
+    return {} if !searching? || cards.empty?
+
+    body_match = terms.map { |term| matches("action_text_rich_texts.plain_text_body", term) }.reduce(&:or)
+    latest_match = comments.where(body_match).order(created_at: :desc, id: :desc).select(:id).limit(1)
+    comment_ids = accessible_cards.where(id: cards.map(&:id)).select(latest_match.arel)
+
+    Comment.where(id: comment_ids).with_rich_text_body.index_by(&:card_id)
+  end
+
+  private
+    def accessible_cards
+      @user.accessible_cards.published.where(account_id: @user.account_id)
+    end
+
+    def descriptions
+      ActionText::RichText.where(record_type: "Card", name: "description")
+        .where("action_text_rich_texts.record_id = cards.id")
+    end
+
+    def comments
+      Comment.joins(:rich_text_body).where("comments.card_id = cards.id")
+    end
+
+    def matches(column, term)
+      text = "LOWER(#{column})"
+      # Keep MySQL's accent-insensitive collation from matching unhighlightable text.
+      text = "CAST(#{text} AS BINARY)" unless Fizzy.db_adapter.sqlite?
+      Arel.sql("INSTR(#{text}, ?) > 0", term)
+    end
+end
