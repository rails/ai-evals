+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,27 @@
+class SearchesController < ApplicationController
+  prepend_around_action :read_from_primary
+
+  def show
+    no_store
+    @search = Card::Search.new(user: Current.user, query: search_params[:q])
+
+    if @search.searching?
+      @cards = set_page_and_extract_portion_from(@search.cards, per_page: 30).load
+      @matching_comments = @search.matching_comments_for(@cards)
+    end
+  end
+
+  private
+    def read_from_primary(&)
+      # Don't rely on a replica that might not know about a just-revoked access.
+      ActiveRecord::Base.connected_to(role: :writing, prevent_writes: true, &)
+    end
+
+    def current_page_param
+      search_params[:page]
+    end
+
+    def search_params
+      @search_params ||= params.permit(:q, :page)
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
