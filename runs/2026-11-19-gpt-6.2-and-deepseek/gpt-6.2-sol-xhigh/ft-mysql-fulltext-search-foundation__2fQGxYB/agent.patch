diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..56db0ab
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,37 @@
+<% @page_title = "Search cards" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide center txt-align-start">
+  <%= form_with url: search_path, method: :get, html: { role: "search", class: "flex gap margin-block-end" } do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, maxlength: Card::Search::MAX_QUERY_LENGTH,
+          placeholder: "Search titles, descriptions, and comments…", class: "input min-width flex-item-grow" %>
+    <button type="submit" class="btn">Search</button>
+  <% end %>
+
+  <% if @search.too_long? %>
+    <p>Enter up to <%= Card::Search::MAX_QUERY_LENGTH %> characters.</p>
+  <% elsif !@search.searching? %>
+    <p>Search your boards for a card title, description, or comment.</p>
+  <% elsif @cards.empty? %>
+    <p>No cards found.</p>
+  <% else %>
+    <% pattern = search_highlight_pattern(@search.terms) %>
+    <ol id="search-results" class="unpad list-style-none" role="list">
+      <% @cards.each do |card| %>
+        <%= render "result", card: card, comment: @matching_comments[card.id], pattern: pattern %>
+      <% end %>
+    </ol>
+
+    <% unless @page.only? %>
+      <div class="flex gap" data-turbo-prefetch="false" role="navigation" aria-label="Search result pages">
+        <%= link_to "Previous page", search_path(q: @search.query, page: @page.number - 1), class: "btn" unless @page.first? %>
+        <%= link_to "Next page", search_path(q: @search.query, page: @page.next_param), class: "btn" if @page.before_last? %>
+      </div>
+    <% end %>
+  <% end %>
+</section>
