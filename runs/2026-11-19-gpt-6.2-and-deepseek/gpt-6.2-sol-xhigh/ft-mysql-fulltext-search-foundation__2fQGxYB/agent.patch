@@ -0,0 +1,18 @@
+require "application_system_test_case"
+
+class SearchTest < ApplicationSystemTestCase
+  test "searching for a card from the menu" do
+    sign_in_as users(:david)
+
+    find(".nav__trigger").click
+    click_on "Search cards"
+    fill_in "Search cards", with: "overflowing"
+    click_button "Search"
+
+    assert_current_path search_path(q: "overflowing")
+    assert_selector "#search-results mark", text: "overflowing"
+
+    click_on cards(:layout).title
+    assert_current_path card_path(cards(:layout))
+  end
+end
