diff --git a/app/models/processed_inbound_email.rb b/app/models/processed_inbound_email.rb
new file mode 100644
index 0000000..3b6804e
--- /dev/null
+++ b/app/models/processed_inbound_email.rb
@@ -0,0 +1,10 @@
+require "digest"
+
+class ProcessedInboundEmail < ApplicationRecord
+  # A receipt must be written in the same transaction as the conversation change.
+  # Use the unique index to arbitrate concurrent deliveries, including across tenants.
+  def self.claim(message_id)
+    insert_all([{ message_id_digest: Digest::SHA256.hexdigest(message_id) }],
+      unique_by: :message_id_digest, returning: [:id]).any?
+  end
+end
