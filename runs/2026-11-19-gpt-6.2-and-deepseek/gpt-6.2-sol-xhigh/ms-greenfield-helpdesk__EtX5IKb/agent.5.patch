@@ -0,0 +1,19 @@
+module SupportEmail
+  REPLY_PREFIX = "reply+"
+  REPLY_TOKEN_FORMAT = /\A[0-9a-f]{48}\z/
+
+  def self.domain
+    ENV.fetch("HELPDESK_SUPPORT_DOMAIN", "support.example.test").downcase
+  end
+
+  def self.local_part(address)
+    return unless address.ascii_only?
+
+    local, separator, host = address.downcase.rpartition("@")
+    local if separator.present? && host == domain
+  end
+
+  def self.reply_address(token)
+    "#{REPLY_PREFIX}#{token}@#{domain}"
+  end
+end
