+      t.string :password_digest, null: false
+      t.string :role, null: false, default: "member"
+      t.boolean :owner, null: false, default: false
+      t.datetime :verified_at
+      t.timestamps
+
+      t.index [:account_id, :email], unique: true
+      t.index :account_id, unique: true, where: "owner", name: "index_users_on_one_owner_per_account"
+      t.check_constraint "role IN ('member', 'admin') AND (NOT owner OR role = 'admin')", name: "users_valid_role"
+    end
+
+    create_table :sessions do |t|
+      t.references :user, null: false, foreign_key: { on_delete: :cascade }
+      t.string :token_digest, null: false
+      t.datetime :expires_at, null: false
+      t.timestamps
+
+      t.index :token_digest, unique: true
+    end
+
+    create_table :access_links do |t|
+      t.references :user, null: false, index: false, foreign_key: { on_delete: :cascade }
+      t.string :purpose, null: false
+      t.string :token_digest, null: false
+      t.datetime :expires_at, null: false
+      t.timestamps
+
+      t.index [:user_id, :purpose], unique: true
+      t.index :token_digest, unique: true
+    end
+  end
+end
