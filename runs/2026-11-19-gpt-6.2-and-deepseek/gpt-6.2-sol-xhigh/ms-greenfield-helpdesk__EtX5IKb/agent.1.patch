+class AccessMailer < ApplicationMailer
+  def email_verification
+    @link = frontend_link("/verify-email")
+    mail(to: params.fetch(:user).email, subject: "Verify your email address")
+  end
+
+  def password_reset
+    @link = frontend_link("/reset-password")
+    mail(to: params.fetch(:user).email, subject: "Reset your password")
+  end
+
+  private
+
+  def frontend_link(path)
+    query = URI.encode_www_form(account: params.fetch(:user).account.subdomain, token: params.fetch(:token))
+    "#{Rails.configuration.x.helpdesk.frontend_origin}#{path}?#{query}"
+  end
+end
