--- /dev/null
+++ b/app/models/token_secret.rb
@@ -0,0 +1,12 @@
+require "digest"
+require "securerandom"
+
+module TokenSecret
+  def self.generate
+    SecureRandom.urlsafe_base64(32)
+  end
+
+  def self.digest(token)
+    Digest::SHA256.hexdigest(token) if token.is_a?(String) && /\A[a-zA-Z0-9_-]{43}\z/.match?(token)
+  end
+end
