+require "uri"
+
+frontend = URI.parse(ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001"))
+unless frontend.is_a?(URI::HTTP) && frontend.host.present? && frontend.userinfo.nil?
+  raise ArgumentError, "HELPDESK_FRONTEND_URL must be an absolute HTTP(S) URL"
+end
+front_origin = frontend.normalize.origin
+Rails.application.config.x.helpdesk.frontend_origin = front_origin
+
+Rails.application.config.middleware.insert_before 0, Rack::Cors do
+  allow do
+    origins front_origin
+    resource "/api/v1/*",
+      headers: %w[Authorization Content-Type X-Helpdesk-Account],
+      methods: %i[get head post patch put delete options]
+  end
+end
