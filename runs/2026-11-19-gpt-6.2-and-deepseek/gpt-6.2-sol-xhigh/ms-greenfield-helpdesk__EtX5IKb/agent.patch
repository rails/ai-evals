+class AccessLink < ApplicationRecord
+  LIFETIMES = { "email_verification" => 24.hours, "password_reset" => 1.hour }.freeze
+
+  belongs_to :user
+
+  scope :unexpired, -> { where("expires_at > ?", Time.current) }
+
+  def self.issue_for!(user, purpose)
+    token = TokenSecret.generate
+    link = user.access_links.find_or_initialize_by(purpose: purpose)
