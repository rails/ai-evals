+    other_ticket = other.tickets.sole
+
+    assert_no_difference ["Comment.count", "Ticket.count", "User.count"] do
+      deliver(source(id: "ambiguous", to: ticket.email_reply_address, cc: "other@support.example.test"))
+      deliver(source(id: "ambiguous", to: ticket.email_reply_address, cc: other_ticket.email_reply_address))
+      deliver(source(id: "ambiguous", to: SUPPORT, cc: "reply+unknown@support.example.test"))
+    end
+    assert_difference "Comment.count" do
+      deliver(source(id: "ambiguous", to: ticket.email_reply_address))
+    end
+    assert_equal 2, ticket.comments.count
+    assert_equal 1, other_ticket.comments.count
+  end
+
+  test "a portal-origin ticket does not send staff replies" do
+    customer = create_customer
+    post "/api/v1/requests", params: { request: { subject: "From the portal", comment: { body: "Hello" } } },
+      headers: api_headers(customer), as: :json
