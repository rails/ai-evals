+module Api
+  module V1
+    class InvitationsController < AccountContextController
+      before_action :authenticate!
+      before_action :require_active_account!
+      before_action :require_admin!
+
+      def index
+        invitations = @account.invitations
+        if params.key?(:status)
+          unless Invitation.states.key?(params[:status])
+            raise ActionController::ParameterMissing, "status (expected pending, accepted, revoked, or expired)"
+          end
+          invitations = invitations.with_status(params[:status])
+        end
+        render json: paginate_collection(invitations, :invitations) { |invitation| invitation_json(invitation) }
+      end
+
+      def show
+        render json: { invitation: invitation_json(find_invitation) }
+      end
+
+      def create
+        invitation = @account.invitations.build(params.expect(invitation: %i[email role]))
+        IssueInvitation.call(invitation)
+        render json: { invitation: invitation_json(invitation) }, status: :created
+      end
+
+      def resend
+        invitation = find_invitation
+        IssueInvitation.call(invitation)
+        render json: { invitation: invitation_json(invitation) }
+      end
+
+      def destroy
+        invitation = find_invitation
+        unless invitation.status == "pending"
+          return error_response(:unprocessable_content, "Only pending invitations can be revoked")
+        end
+
+        invitation.revoked!
+        head :no_content
+      end
+
+      private
+
+      def find_invitation
+        @account.invitations.find(params[:id])
+      end
+
+      def invitation_json(invitation)
+        invitation.as_json(only: %i[id email role expires_at created_at updated_at]).merge(status: invitation.status)
+      end
+    end
+  end
+end
