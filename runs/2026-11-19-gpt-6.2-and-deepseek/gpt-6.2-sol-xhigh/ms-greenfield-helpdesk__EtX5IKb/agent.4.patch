index 3f77cec..7ebec1f 100644
--- a/app/models/ticket.rb
+++ b/app/models/ticket.rb
@@ -5,6 +5,7 @@ class Ticket < ApplicationRecord
   has_many :comments, inverse_of: :ticket, autosave: true
 
