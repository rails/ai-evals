@@ -1,7 +1,27 @@
 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  # Resque does not support delayed enqueueing without resque-scheduler.
+  self.resume_options = {}
+
+  class Checkpoint < ApplicationRecord
+    self.table_name = "title_cleanup_checkpoints"
+  end
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :clean_titles do |step|
+      progress = Checkpoint.find_or_create_by!(id: 1)
+
+      Leaf.where("id > ?", progress.last_leaf_id).find_each(order: :asc) do |leaf|
+        # Keep the durable cursor and the non-idempotent edit in one transaction.
+        progress.with_lock do
+          if leaf.id > progress.last_leaf_id
+            leaf.update!(title: cleaned(leaf.title))
+            progress.update!(last_leaf_id: leaf.id)
+          end
+        end
+        step.checkpoint!
+      end
     end
   end
 
diff --git a/config/initializers/resque_shutdown.rb b/config/initializers/resque_shutdown.rb
new file mode 100644
index 0000000..ee6ca66
--- /dev/null
+++ b/config/initializers/resque_shutdown.rb
@@ -0,0 +1,14 @@
+Rails.application.config.after_initialize do
+  adapter = ActiveJob::Base.queue_adapter
+
+  if adapter.is_a?(ActiveJob::QueueAdapters::ResqueAdapter)
+    # The pool runs jobs in the worker process (FORK_PER_JOB=false), so the
+    # worker's shutdown signal and the job's checkpoints share this adapter.
+    Resque::Worker.prepend(Module.new do
+      define_method(:shutdown) do
+        super()
+        adapter.stopping = true
+      end
+    end)
+  end
+end
