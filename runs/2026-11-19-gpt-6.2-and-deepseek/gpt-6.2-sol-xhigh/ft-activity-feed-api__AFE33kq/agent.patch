diff --git a/config/initializers/geared_pagination.rb b/config/initializers/geared_pagination.rb
new file mode 100644
index 0000000..c5c5573
--- /dev/null
+++ b/config/initializers/geared_pagination.rb
@@ -0,0 +1,15 @@
+require "geared_pagination/headers"
+
+module GearedPagination::PreserveListParams
+  private
+
+  def uri(page:)
+    Addressable::URI.parse(request.url).tap do |uri|
+      query = Array(uri.query_values(Array)).reject { |name, _| name == "page" }
+      uri.query_values = query << [ "page", page ]
+    end
+  end
+end
+
+# The gem reads query values as a hash, which drops repeated list parameters.
+GearedPagination::Headers.prepend GearedPagination::PreserveListParams
