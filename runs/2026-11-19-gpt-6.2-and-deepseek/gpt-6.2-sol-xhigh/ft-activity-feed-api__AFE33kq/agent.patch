diff --git a/docs/api/sections/activities.md b/docs/api/sections/activities.md
new file mode 100644
index 0000000..e7f01b7
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,40 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat, [paginated](../README.md#pagination) array of activity from boards you can access, newest first. It includes the events shown in the account timeline, except that `card_collection_changed` is omitted and `card_title_changed` is included.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the users who performed the activity |
+| `board_ids[]` | Filter by board ID |
+
+Multiple IDs for the same parameter are matched with OR. The two filters combine with AND.
+
+__Response fields:__
+
+| Field | Description |
+|-------|-------------|
+| `id` | Event ID |
+| `action` | Event action, such as `card_published` or `comment_created` |
+| `created_at` | When the event occurred, in UTC |
+| `description` | Plain-text description of the event |
+| `particulars` | Action-specific details (see below) |
+| `url` | Link to the card, with a comment anchor for `comment_created` |
+| `eventable_type` | `Card` or `Comment` |
+| `eventable` | The [card](cards.md) or [comment](comments.md) in its usual API representation |
+| `board` | The event's [board](boards.md) |
+| `creator` | The [user](users.md) who performed the activity |
+
+__Particulars by action:__
+
+| Action | Fields |
+|--------|--------|
+| `card_assigned`, `card_unassigned` | `assignee_ids`, an array of affected user IDs |
+| `card_board_changed` | `old_board` and `new_board`, the board names |
+| `card_title_changed` | `old_title` and `new_title` |
+| `card_triaged` | `column`, the destination column name |
+
+Missing board names, titles, or column names are returned as empty strings. For all other actions, `particulars` is an empty object.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..5ee71cf
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @headers = { "Authorization" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+    @activity_path = activities_path(format: :json)
+  end
+
+  test "rejects an invalid access token" do
+    get @activity_path, headers: { "Authorization" => "Bearer invalid" }
+    assert_response :unauthorized
+  end
+
+  test "lists card and comment activity with existing API representations" do
+    get @activity_path, headers: @headers
+    assert_response :success
+    activities = response.parsed_body.index_by { |activity| activity.fetch("id") }
+
+    event = events(:layout_published)
+    activity = activities.fetch(event.id)
+    assert_equal %w[ action board created_at creator description eventable eventable_type id particulars url ], activity.keys.sort
+    assert_equal "card_published", activity["action"]
+    assert_equal event.created_at, Time.iso8601(activity["created_at"])
+    assert_equal 'David added "Layout is broken"', activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_url(event.card), activity["url"]
+    assert_equal api_response(cards_path(format: :json), card_ids: [ event.card.id ]).sole, activity["eventable"]
+    assert_equal api_response(board_path(event.board, format: :json)), activity["board"]
+    assert_equal api_response(user_path(event.creator, format: :json)), activity["creator"]
+
+    comment = comments(:layout_overflowing_david)
+    activity = activities.fetch(events(:layout_commented).id)
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal api_response(card_comment_path(comment.card, comment, format: :json)), activity["eventable"]
+  end
+
+  test "includes title changes but omits legacy collection changes and non-timeline events" do
+    with_current_user :david do
+      card = cards(:layout)
+      card.update!(title: "Layout & overflow")
+      card.track_event :collection_changed
+      card.track_event :resumed
+    end
+
+    activities = api_response(@activity_path).index_by { |activity| activity.fetch("action") }
+    assert_not_includes activities, "card_collection_changed"
+    assert_not_includes activities, "card_resumed"
+    assert_equal 'David renamed "Layout & overflow" (was: "Layout is broken")', activities.fetch("card_title_changed")["description"]
+    assert_equal({ "old_title" => "Layout is broken", "new_title" => "Layout & overflow" }, activities.fetch("card_title_changed")["particulars"])
+  end
+
+  test "includes particulars for assignments, board changes, and triage" do
+    card = cards(:logo)
+    with_current_user :kevin do
+      card.toggle_assignment users(:jz)
+      card.triage_into columns(:writebook_in_progress)
+      card.move_to boards(:private)
+    end
+
+    token = identities(:kevin).access_tokens.create!(description: "Activity reader")
+    @headers = { "Authorization" => "Bearer #{token.token}" }
+    activities = api_response(@activity_path, board_ids: [ boards(:private).id ])
+    particulars = activities.to_h { |activity| activity.values_at("action", "particulars") }
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, particulars.fetch("card_assigned"))
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, particulars.fetch("card_unassigned"))
+    assert_equal({ "column" => columns(:writebook_in_progress).name }, particulars.fetch("card_triaged"))
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, particulars.fetch("card_board_changed"))
+  end
+
+  test "returns empty strings for missing particulars" do
+    expected_particulars = {
+      "board_changed" => { "old_board" => "", "new_board" => "" },
+      "title_changed" => { "old_title" => "", "new_title" => "" },
+      "triaged" => { "column" => "" }
+    }
+
+    with_current_user :david do
+      expected_particulars.each_key do |action|
+        cards(:layout).track_event(action).update_column(:particulars, nil)
+      end
+    end
+
+    activities = api_response(@activity_path).index_by { |activity| activity.fetch("action") }
+    expected_particulars.each do |action, particulars|
+      assert_equal particulars, activities.fetch("card_#{action}")["particulars"]
+    end
+  end
+
+  test "filters by event creator and board without exposing inaccessible activity" do
+    with_current_user :kevin do
+      cards(:layout).move_to boards(:private)
+    end
+
+    activities = api_response(@activity_path, creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id, boards(:private).id ])
+    assert_not_empty activities
+    assert_equal [ users(:david).id ], activities.map { |activity| activity.dig("creator", "id") }.uniq
+    assert_equal [ boards(:writebook).id ], activities.map { |activity| activity.dig("board", "id") }.uniq
+    assert_not_includes activities.pluck("id"), events(:layout_commented).id
+    assert_not_includes api_response(@activity_path).pluck("id"), events(:layout_published).id
+    assert_empty api_response(@activity_path, board_ids: [ boards(:private).id ])
+    assert_empty api_response(@activity_path, board_ids: [ boards(:miltons_wish_list).id ])
+    assert_empty api_response(@activity_path, creator_ids: [ users(:mike).id ])
+  end
+
+  test "paginates newest first and preserves repeated filters in the next link" do
+    travel_to Time.current do
+      with_current_user :david do
+        6.times { cards(:layout).track_event :published }
+      end
+    end
+
+    filters = { creator_ids: [ users(:david).id, users(:kevin).id ], board_ids: [ boards(:writebook).id, boards(:private).id ] }
+    first_page = api_response(@activity_path, **filters)
+    next_url = response.headers.fetch("Link")[/<([^>]+)>; rel="next"/, 1]
+    assert next_url
+    assert_equal "17", response.headers["X-Total-Count"]
+
+    second_page = api_response(next_url)
+    activities = first_page + second_page
+    assert_equal 17, activities.pluck("id").uniq.size
+    assert_equal activities.map { |activity| activity.values_at("created_at", "id") }.sort.reverse,
+      activities.map { |activity| activity.values_at("created_at", "id") }
+    assert_nil response.headers["Link"]
+  end
+
+  private
+    def api_response(path, **params)
+      get path, headers: @headers, params: params
+      assert_response :success
+      response.parsed_body
+    end
+end
