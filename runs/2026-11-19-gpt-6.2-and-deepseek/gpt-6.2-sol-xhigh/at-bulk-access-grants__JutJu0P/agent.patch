+
+    # SQLite's immediate transaction prevents another writer from racing the duplicate check.
+    Access.transaction do |transaction|
+      if (index = rejected_index(rows))
+        # Preserve duplicate_index as the rejected row index, including for invalid levels.
+        Result.new([], index)
+      else
+        accesses = insert_accesses(rows)
+        accesses.each do |access|
+          transaction.after_commit { Book::AccessNotificationJob.perform_later(access) }
+        end
