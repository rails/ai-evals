+  test "renders Japanese for the recipient, independently of the caller locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identity)
+
+    I18n.with_locale(:en) do
+      email = MagicLinkMailer.sign_in_instructions(magic_link)
+      assert_equal "Fizzyの確認コード：#{magic_link.code}", email.subject
+      assert_includes email.html_part.decoded, 'lang="ja"'
+      assert_includes email.text_part.decoded, "このコードは"
+      assert_includes email.text_part.decoded, "分間有効です"
+      assert_equal :en, I18n.locale
+    end
+  end
 end
