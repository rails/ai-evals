diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..d0cb732
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "anonymous locale survives navigation and ignores unsupported values" do
+    untenanted do
+      get new_session_path
+      assert_select "html[lang=en]"
+      assert_select "h1", "Get into Fizzy"
+
+      get new_session_path, params: { locale: "xx" }
+      assert_select "html[lang=en]"
+      assert_select "h1", "Get into Fizzy"
+
+      get new_session_path, params: { locale: "ja" }
+      assert_select "html[lang=ja]"
+      assert_select "h1", "Fizzyにログイン"
+
+      get new_session_path, params: { locale: "xx" }
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", "Fizzyにログイン"
+    end
+  end
+
+  test "an anonymous choice is saved only after authentication" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+    end
+    assert_nil identities(:kevin).reload.locale
+
+    sign_in_as :kevin
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_equal :en, I18n.locale
+  end
+
+  test "a signed-in preference survives a new browser session" do
+    sign_in_as :kevin
+    get board_path(boards(:writebook)), params: { locale: "ja" }
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    url_options = integration_session.default_url_options.dup
+    reset!
+    integration_session.default_url_options.merge!(url_options)
+    sign_in_as :kevin
+    get board_path(boards(:writebook))
+    assert_select "html[lang=ja]"
+
+    get board_path(boards(:writebook)), params: { locale: ["en"] }
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    get board_path(boards(:writebook)), params: { locale: "en" }
+    assert_select "html[lang=en]"
+    assert_equal "en", identities(:kevin).reload.locale
+  end
+end
