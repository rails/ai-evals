diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..8310bf3
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,40 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_request_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def with_request_locale
+      if locale = requested_locale
+        session[:locale] = locale
+        session[:locale_pending] = true
+      end
+
+      I18n.with_locale(supported_locale(session[:locale]) || I18n.default_locale) { yield }
+    end
+
+    def apply_identity_locale(identity)
+      # Only transfer an anonymous choice after the identity has been authenticated.
+      if session.delete(:locale_pending) && (locale = supported_locale(session[:locale]))
+        identity.update!(locale: locale) unless identity.locale == locale
+      end
+
+      I18n.locale = identity.preferred_locale
+      session[:locale] = identity.locale if session[:locale] != identity.locale
+    end
+
+    def pending_locale
+      supported_locale(session[:locale]) if session[:locale_pending]
+    end
+
+    def requested_locale
+      supported_locale(request.query_parameters["locale"])
+    end
+
+    def supported_locale(value)
+      value if value.is_a?(String) && I18n.available_locales.any? { |locale| locale.to_s == value }
+    end
+end
