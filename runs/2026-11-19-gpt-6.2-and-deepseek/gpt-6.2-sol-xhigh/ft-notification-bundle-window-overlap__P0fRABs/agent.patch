diff --git a/test/integration/notification_digests_test.rb b/test/integration/notification_digests_test.rb
new file mode 100644
index 0000000..1423ea5
--- /dev/null
+++ b/test/integration/notification_digests_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+
+class NotificationDigestsTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+    @creator = users(:david)
+  end
+
+  test "notifications that land in the same window produce one email four hours after the first" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    freeze_time do
+      starts_at = Time.current
+      NotifyRecipientsJob.perform_now(events(:logo_assignment_km))
+
+      travel_to starts_at + 3.hours
+      # This event predates the window but its notification has only just arrived.
+      record_notification(:layout_commented)
+      assert_no_emails { deliver_due_digests }
+
+      travel_to starts_at + 4.hours
+      email = capture_emails { deliver_due_digests }.sole
+      assert_equal [ @user.identity.email_address ], email.to
+      assert_includes email.text_part.body.decoded, cards(:logo).title
+      assert_includes email.text_part.body.decoded, cards(:layout).title
+      assert_includes email.html_part.body.decoded, "#{@user.account.slug}/notifications/settings"
+      assert_no_emails { deliver_due_digests }
+    end
+  end
+
+  test "people can choose different frequencies and each clock starts on arrival" do
+    other_user = users(:jz)
+    @user.settings.update!(bundle_email_frequency: :daily)
+    other_user.settings.update!(bundle_email_frequency: :weekly)
+
+    freeze_time do
+      starts_at = Time.current
+      record_notification(:logo_assignment_km)
+
+      travel_to starts_at + 2.hours
+      record_notification(:logo_assignment_jz, user: other_user)
+
+      travel_to starts_at + 24.hours
+      assert_equal [ @user.identity.email_address ], capture_emails { deliver_due_digests }.sole.to
+
+      travel_to starts_at + 1.week
+      assert_no_emails { deliver_due_digests }
+
+      travel_to starts_at + 1.week + 2.hours
+      assert_equal [ other_user.identity.email_address ], capture_emails { deliver_due_digests }.sole.to
+    end
+  end
+
+  test "the cutoff starts a non-overlapping window even if delivery is delayed" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    freeze_time do
+      starts_at = Time.current
+      notification = record_notification(:logo_published)
+      @user.settings.update!(bundle_email_frequency: :weekly)
+
+      travel_to starts_at + 1.hour
+      record_notification(:layout_commented)
+      assert_equal starts_at + 4.hours, @user.notification_bundles.sole.ends_at
+
+      travel_to starts_at + 4.hours
+      notification.update!(source: events(:logo_assignment_km))
+      first, second = @user.notification_bundles.order(:starts_at).to_a
+      assert_equal first.ends_at, second.starts_at
+      assert_equal second.starts_at + 1.week, second.ends_at
+
+      travel_to starts_at + 5.hours
+      first_email = capture_emails { deliver_due_digests }.sole.text_part.body.decoded
+      assert_includes first_email, "Added by David"
+      assert_not_includes first_email, "Assigned to you"
+      assert_no_emails { Notification::Bundle::DeliveryJob.perform_now(first) }
+
+      travel_to second.ends_at
+      second_email = capture_emails { deliver_due_digests }.sole.text_part.body.decoded
+      assert_includes second_email, "Assigned to you by David"
+      assert_not_includes second_email, cards(:layout).title
+    end
+  end
+
+  test "distinct activities on the same card are included once each" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    freeze_time do
+      notification = record_notification(:logo_published)
+      notification.update!(source: events(:logo_assignment_km))
+      notification.update!(source: events(:logo_published))
+
+      travel 4.hours
+      body = capture_emails { deliver_due_digests }.sole.text_part.body.decoded
+      assert_equal 1, body.scan("Added by David").size
+      assert_equal 1, body.scan("Assigned to you by David").size
+    end
+  end
+
+  test "email digests are off by default" do
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliveryJob do
+      record_notification(:logo_assignment_km)
+    end
+
+    assert_empty @user.notification_bundles.reload
+  end
+
+  test "turning emails off before delivery suppresses a scheduled digest" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    freeze_time do
+      record_notification(:logo_assignment_km)
+      @user.settings.update!(bundle_email_frequency: :never)
+
+      travel 4.hours
+      assert_no_emails { deliver_due_digests }
+      assert_empty @user.notification_bundles.reload
+    end
+  end
+
+  test "changing read state is not a new arrival" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    freeze_time do
+      notification = record_notification(:logo_assignment_km)
+
+      travel 4.hours
+      assert_emails(1) { deliver_due_digests }
+      assert_no_enqueued_jobs only: Notification::Bundle::DeliveryJob do
+        notification.read
+        notification.unread
+      end
+    end
+  end
+
+  test "a digest does not share cards the recipient can no longer access" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    freeze_time do
+      record_notification(:logo_assignment_km)
+      accesses(:writebook_kevin).destroy!
+
+      travel 4.hours
+      assert_no_emails { deliver_due_digests }
+      assert_empty @user.notification_bundles.reload
+    end
+  end
+
+  private
+    def record_notification(event, user: @user)
+      user.notifications.create!(source: events(event), creator: @creator, unread_count: 1)
+    end
+
+    def deliver_due_digests
+      perform_enqueued_jobs only: Notification::Bundle::DeliveryJob, at: Time.current
+    end
+end
