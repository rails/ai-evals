diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..bef746b
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,56 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :user
+  has_many :entries, dependent: :delete_all
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add(notification)
+      user = notification.user
+
+      # Serialize window selection with other arrivals and with delivery.
+      user.with_lock do
+        if user.active? && user.identity_id? && (interval = user.settings&.bundle_email_interval)
+          # Use arrival time, not the source's timestamp. A delayed event can join an open bundle.
+          now = Time.current
+          bundle = user.notification_bundles.where("ends_at > ?", now).lock.first ||
+            user.notification_bundles.create!(starts_at: now, ends_at: now + interval)
+
+          bundle.entries.find_or_create_by!(source: notification.source) do |entry|
+            entry.card = notification.card
+            entry.creator = notification.creator
+          end
+        end
+      end
+    end
+  end
+
+  def deliver
+    user.with_lock do
+      reload
+
+      if ends_at.future?
+        deliver_later
+      else
+        deliver_email if user.active? && user.identity_id? && user.settings&.bundle_email_interval && user.account.active?
+        destroy!
+      end
+    end
+  end
+
+  private
+    def deliver_later
+      Current.with_account(user.account) do
+        Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+      end
+    end
+
+    def deliver_email
+      payloads = entries.where(card_id: user.accessible_cards.select(:id)).order(:id)
+        .includes(:source, card: :account).filter_map { |entry| entry.payload if entry.source }
+
+      if payloads.any?
+        NotificationMailer.digest(user, payloads).deliver_now
+      end
+    end
+end
