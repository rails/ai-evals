diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..c0377df
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  test "search finds active titles only from books the member can read" do
+    readable = leaves(:welcome_page)
+    unreadable = leaves(:summary_page)
+    unreadable.update!(book: books(:manual), title: "Welcome to the Manual")
+    trashed = leaves(:welcome_section)
+    trashed.trashed!
+
+    sign_in :kevin
+    get library_search_path, params: { q: "  WeLcOmE  " }
+
+    assert_response :success
+    assert_in_body result_link(readable)
+    assert_not_in_body result_link(unreadable)
+    assert_not_in_body result_link(trashed)
+  end
+
+  test "published titles appear without a book access grant, even when signed out" do
+    book = books(:manual)
+    page = leaves(:summary_page)
+    page.update!(book: book, title: "Welcome to the Manual")
+
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_in_body "No matches."
+
+    book.update!(published: true)
+
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_in_body result_link(page)
+    assert_not_in_body result_link(leaves(:welcome_page))
+
+    sign_in :kevin
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_in_body result_link(page)
+    assert_in_body result_link(leaves(:welcome_page))
+  end
+
+  test "apostrophes are matched as part of a title" do
+    page = leaves(:welcome_page)
+    page.update!(title: "Reader's guide")
+    sign_in :kevin
+
+    get library_search_path, params: { q: "Reader's guide" }
+
+    assert_response :success
+    assert_in_body result_link(page)
+  end
+
+  test "percent signs, underscores, and the escape character are matched literally" do
+    percent_page = leaves(:welcome_page)
+    percent_page.update!(title: "Save 50% off")
+    underscore_page = leaves(:summary_page)
+    underscore_page.update!(title: "Step!_one")
+    sign_in :kevin
+
+    { "Save 50% off" => percent_page, "%" => percent_page, "_" => underscore_page, "!_" => underscore_page }.each do |query, page|
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_in_body result_link(page)
+      assert_select "a.search__result", count: 1
+    end
+  end
+
+  private
+    def result_link(leaf)
+      %(href="#{leafable_slug_path(leaf)}")
+    end
+end
