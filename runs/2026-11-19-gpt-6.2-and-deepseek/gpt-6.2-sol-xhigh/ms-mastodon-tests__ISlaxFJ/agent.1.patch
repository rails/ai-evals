diff --git a/spec/rails_helper.rb b/spec/rails_helper.rb
index a91461b..218b0f9 100644
--- a/spec/rails_helper.rb
+++ b/spec/rails_helper.rb
@@ -109,6 +109,25 @@ RSpec.configure do |config|
     Sidekiq.testing!(:inline)
   end
 
+  # Model specs usually only need to enqueue jobs, not run the workers created
+  # by setup callbacks. Opt in with :sidekiq_inline for worker side effects.
+  config.around(:each, type: :model) do |example|
+    if example.metadata[:sidekiq_inline]
+      example.run
+    else
+      Sidekiq.testing!(:fake) { example.run }
+    end
+  end
+
+  # SQL and cache debug logging can dominate model specs with large setups.
+  unless ENV['MODEL_SPEC_DEBUG_LOGS'] == '1'
+    config.around(:each, type: :model) do |example|
+      next example.run unless Rails.logger.debug?
+
+      Rails.logger.log_at(:info) { example.run }
+    end
+  end
+
   config.before :each, type: :cli do
     stub_reset_connection_pools
   end
