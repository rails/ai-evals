diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..ec1dcf0
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can override usage and reset it" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href=?]", saas.admin_account_path(account), text: account.name
+
+      patch saas.override_admin_account_path(account), params: { usage: { card_count: 950, bytes_used: 0 } }
+      assert_response :redirect
+      assert_equal 50, Account.find(account.id).cards_left
+      assert_equal 0, Account.find(account.id).bytes_used
+
+      get saas.admin_account_path(account)
+      assert_response :success
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+
+      post saas.comp_admin_account_path(account)
+      assert_response :redirect
+      assert_equal 5.gigabytes, Account.find(account.id).storage_limit
+      assert_nil Account.find(account.id).cards_left
+
+      delete saas.uncomp_admin_account_path(account)
+      assert_response :redirect
+      assert_equal 50, Account.find(account.id).cards_left
+
+      delete saas.reset_admin_account_path(account)
+      assert_response :redirect
+      assert_nil Account.find(account.id).billing_record.card_count_override
+    end
+  end
+
+  test "non-staff cannot comp an account" do
+    sign_in_as :jz
+    untenanted do
+      post saas.comp_admin_account_path(accounts(:initech))
+      assert_response :forbidden
+    end
+  end
+end
diff --git a/saas/test/controllers/billings_controller_test.rb b/saas/test/controllers/billings_controller_test.rb
new file mode 100644
index 0000000..5bae9ba
--- /dev/null
+++ b/saas/test/controllers/billings_controller_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class BillingsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @tenant = { script_name: @account.slug }
+  end
+
+  test "remaining cards are shown and the upgrade pitch replaces create at the limit" do
+    sign_in_as :mike
+    record = Account::BillingRecord.create!(account: @account, card_count_override: 950)
+    get root_path(**@tenant)
+    assert_response :success
+    assert_select "div", text: /50 cards left/
+
+    record.update!(card_count_override: 1_000)
+    get root_path(**@tenant)
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select "span", text: "Add a card", count: 0
+
+    post board_cards_path(boards(:miltons_wish_list), **@tenant)
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+
+    post board_cards_path(boards(:miltons_wish_list), **@tenant), params: { title: "Not yet" }, as: :json
+    assert_response :forbidden
+    post card_publish_path(cards(:unfinished_thoughts), **@tenant), as: :json
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "admin can view pricing and start hosted checkout or portal" do
+    sign_in_as :mike
+    get account_settings_path(**@tenant)
+    assert_select "h2", text: "Plan: Free"
+    get saas.billing_path(**@tenant)
+    assert_response :success
+    assert_select "h2", text: "Unlimited+"
+
+    Account::BillingRecord.create!(account: @account, stripe_customer_id: "cus_test")
+    ENV.stubs(:[]).with { |key| !key.start_with?("STRIPE_") }.returns(nil)
+    ENV.stubs(:[]).with("STRIPE_SECRET_KEY").returns("sk_test")
+    ENV.stubs(:[]).with("STRIPE_MONTHLY_V1_PRICE_ID").returns("price_test")
+    StripeBilling.any_instance.expects(:checkout).returns("https://checkout.stripe.com/example")
+    post saas.checkout_billing_path(plan: "unlimited", **@tenant)
+    assert_redirected_to "https://checkout.stripe.com/example"
+
+    StripeBilling.any_instance.expects(:portal).returns("https://billing.stripe.com/example")
+    post saas.portal_billing_path(**@tenant)
+    assert_redirected_to "https://billing.stripe.com/example"
+  end
+end
diff --git a/saas/test/controllers/stripe_webhooks_controller_test.rb b/saas/test/controllers/stripe_webhooks_controller_test.rb
new file mode 100644
index 0000000..a76407e
--- /dev/null
+++ b/saas/test/controllers/stripe_webhooks_controller_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @record = Account::BillingRecord.create!(account: @account, stripe_customer_id: "cus_test")
+    ENV.stubs(:[]).with("STRIPE_WEBHOOK_SECRET").returns("whsec_test")
+    ENV.stubs(:[]).with { |key| !key.start_with?("STRIPE_") }.returns(nil)
+    ENV.stubs(:[]).with("STRIPE_SECRET_KEY").returns("sk_test")
+    ENV.stubs(:[]).with("STRIPE_MONTHLY_V1_PRICE_ID").returns("price_standard")
+    ENV.stubs(:[]).with("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID").returns("price_plus")
+  end
+
+  test "signed subscription events reconcile current Stripe state, including cancellation" do
+    item = Stripe::StripeObject.construct_from(price: { id: "price_plus" })
+    subscription = Stripe::StripeObject.construct_from(status: "active", items: { data: [ item ] })
+    Stripe::Subscription.expects(:list).twice.returns(stub(auto_paging_each: [ subscription ].each), stub(auto_paging_each: [].each))
+
+    deliver_event("customer.subscription.updated")
+    assert_response :ok
+    assert_equal "Unlimited+", @record.reload.plan.name
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+    assert_nil @account.cards_left
+
+    deliver_event("customer.subscription.deleted")
+    assert_response :ok
+    assert_equal "Free", @record.reload.plan.name
+  end
+
+  test "invalid signatures do not update billing" do
+    Stripe::Subscription.expects(:list).never
+    deliver_event("customer.subscription.updated", secret: "wrong")
+    assert_response :bad_request
+    assert_nil @record.reload.paid_plan_key
+  end
+
+  private
+    def deliver_event(type, secret: "whsec_test")
+      payload = { type: type, data: { object: { customer: "cus_test" } } }.to_json
+      time = Time.now.to_i
+      signature = OpenSSL::HMAC.hexdigest("SHA256", secret, "#{time}.#{payload}")
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: { "Content-Type" => "application/json", "Stripe-Signature" => "t=#{time},v1=#{signature}" }
+      end
+    end
+end
diff --git a/saas/test/models/stripe_billing_test.rb b/saas/test/models/stripe_billing_test.rb
new file mode 100644
index 0000000..aa95202
--- /dev/null
+++ b/saas/test/models/stripe_billing_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class StripeBillingTest < ActiveSupport::TestCase
+  test "checkout creates a customer and uses the configured recurring price" do
+    record = Account::BillingRecord.create!(account: accounts(:initech))
+    plan = BillingPlan::PLANS.fetch("unlimited")
+    return_url = "https://app.example/123/billing"
+    email = "owner@example.com"
+    options = { api_key: "sk_test" }
+    ENV.stubs(:[]).with("STRIPE_SECRET_KEY").returns("sk_test")
+    ENV.stubs(:[]).with(plan.stripe_price_env).returns("price_standard")
+
+    Stripe::Customer.expects(:create).with({ email: email, metadata: { account_id: record.account_id } },
+      options.merge(idempotency_key: "fizzy-account-#{record.account_id}")).returns(stub(id: "cus_test"))
+    Stripe::Subscription.expects(:list).with({ customer: "cus_test", status: "all" }, options)
+      .returns(stub(auto_paging_each: [].each))
+    Stripe::Checkout::Session.expects(:list).returns(stub(data: []))
+    Stripe::Checkout::Session.expects(:create).with({ customer: "cus_test", mode: "subscription",
+      line_items: [ { price: "price_standard", quantity: 1 } ], success_url: return_url, cancel_url: return_url }, options)
+      .returns(stub(url: "https://checkout.stripe.com/example"))
+
+    assert_equal "https://checkout.stripe.com/example", StripeBilling.new(record).checkout(plan, return_url: return_url, email: email)
+    assert_equal "cus_test", record.reload.stripe_customer_id
+    assert_equal "Free", record.plan.name
+  end
+end
