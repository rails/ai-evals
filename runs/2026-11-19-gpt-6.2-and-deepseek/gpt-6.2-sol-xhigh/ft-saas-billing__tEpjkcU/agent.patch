@@ -0,0 +1,13 @@
+class BillingPlan
+  Plan = Data.define(:name, :monthly_price, :card_limit, :storage_limit, :stripe_price_env) do
+    def stripe_price_id
+      ENV[stripe_price_env] if stripe_price_env
+    end
+  end
+
+  PLANS = {
+    "free" => Plan.new("Free", 0, 1_000, 1.gigabyte, nil),
+    "unlimited" => Plan.new("Unlimited", 20, nil, 5.gigabytes, "STRIPE_MONTHLY_V1_PRICE_ID"),
+    "unlimited_plus" => Plan.new("Unlimited+", 25, nil, 500.gigabytes, "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  }.freeze
+end
diff --git a/saas/app/models/stripe_billing.rb b/saas/app/models/stripe_billing.rb
new file mode 100644
index 0000000..a23e8ae
--- /dev/null
+++ b/saas/app/models/stripe_billing.rb
@@ -0,0 +1,64 @@
+class StripeBilling
+  def initialize(record)
+    @record = record
+  end
+
+  def checkout(plan, return_url:, email:)
+    customer = @record.with_lock { stripe_customer(email) }
+
+    @record.with_lock do
+      if subscribed_plan(customer)
+        portal(return_url: return_url)
+      else
+        session = Stripe::Checkout::Session.list({ customer: customer, status: "open", limit: 1,
+          expand: [ "data.line_items" ] }, stripe_options).data.first
+        return session.url if session&.line_items&.data&.first&.price&.id == plan.stripe_price_id
+
+        Stripe::Checkout::Session.expire(session.id, {}, stripe_options) if session
+        Stripe::Checkout::Session.create({
+          customer: customer, mode: "subscription", line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+          success_url: return_url, cancel_url: return_url
+        }, stripe_options).url
+      end
+    end
+  end
+
+  def portal(return_url:)
+    Stripe::BillingPortal::Session.create({ customer: @record.stripe_customer_id, return_url: return_url }, stripe_options).url
+  end
+
+  def synchronize_subscription
+    @record.with_lock do
+      @record.update!(paid_plan_key: subscribed_plan(@record.stripe_customer_id))
+    end
+  end
+
+  private
+    def stripe_customer(email)
+      @record.stripe_customer_id || Stripe::Customer.create({ email: email, metadata: { account_id: @record.account_id } },
+        stripe_options.merge(idempotency_key: "fizzy-account-#{@record.account_id}")).id.tap do |id|
+        @record.update!(stripe_customer_id: id)
+      end
+    end
+
+    def subscribed_plan(customer)
+      # Read current state instead of applying potentially out-of-order event snapshots.
+      plans = Stripe::Subscription.list({ customer: customer, status: "all" }, stripe_options).auto_paging_each.flat_map do |subscription|
+        if %w[ active trialing past_due ].include?(subscription.status)
+          subscription.items.data.filter_map do |item|
+            BillingPlan::PLANS.keys.find do |key|
+              price = BillingPlan::PLANS.fetch(key).stripe_price_id
+              price.present? && price == item.price.id
+            end
+          end
+        else
+          []
+        end
+      end
+      plans.max_by { |key| BillingPlan::PLANS.fetch(key).storage_limit }
+    end
+
+    def stripe_options
+      { api_key: ENV["STRIPE_SECRET_KEY"] }
+    end
+end
