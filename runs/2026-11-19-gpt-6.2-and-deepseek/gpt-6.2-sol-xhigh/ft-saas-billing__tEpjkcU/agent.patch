diff --git a/saas/README.md b/saas/README.md
index 28b0891..ffa6dfc 100644
--- a/saas/README.md
+++ b/saas/README.md
@@ -105,3 +105,22 @@ knife ssh 'hostname:fizzy-lb-*' 'sudo docker exec fizzy-load-balancer kamal-prox
 ## License
 
 fizzy-saas is released under the [O'Saasy License](LICENSE.md).
+
+### Billing configuration
+
+Configure `STRIPE_SECRET_KEY` and `STRIPE_WEBHOOK_SECRET` for each hosted
+installation. Set `STRIPE_MONTHLY_V1_PRICE_ID` to the recurring $20/month
+Unlimited price and `STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID` to the recurring
+$25/month Unlimited+ price. Enable the Stripe customer portal, including
+switching between these prices and subscription cancellation.
+
+Point the Stripe webhook at the untenanted `/stripe/webhooks` endpoint and
+subscribe to `customer.subscription.created`, `customer.subscription.updated`,
+`customer.subscription.deleted`, `customer.subscription.paused`, and
+`customer.subscription.resumed`. Fizzy verifies the signature and reads the
+customer's current subscription from Stripe; checkout redirects don't grant
+entitlements.
+
+In `/admin/accounts`, staff can grant Unlimited entitlements with **Comp**
+without changing or canceling a Stripe subscription. The usage override changes
+what Fizzy uses for limit checks without editing cards or the storage ledger.
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..f0a449a
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,46 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+  before_action :set_account, except: :index
+
+  def index
+    set_page_and_extract_portion_from Account.order(:name, :id)
+    @accounts = @page.records
+  end
+
+  def show
+  end
+
+  def comp
+    @account.billing_record_for_update.update!(comped: true)
+    redirect_to saas.admin_account_path(@account), status: :see_other
+  end
+
+  def uncomp
+    @account.billing_record_for_update.update!(comped: false)
+    redirect_to saas.admin_account_path(@account), status: :see_other
+  end
+
+  def override
+    usage = params.expect usage: %i[ card_count bytes_used ]
+    unless usage.values.all? { |value| value.to_s.match?(/\A[0-9]+\z/) } && usage.keys.size == 2
+      return head :unprocessable_entity
+    end
+
+    record = @account.billing_record_for_update
+    if record.update(card_count_override: usage[:card_count], bytes_used_override: usage[:bytes_used])
+      redirect_to saas.admin_account_path(@account), status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def reset
+    @account.billing_record&.update!(card_count_override: nil, bytes_used_override: nil)
+    redirect_to saas.admin_account_path(@account), status: :see_other
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:id])
+    end
+end
diff --git a/saas/app/controllers/billings_controller.rb b/saas/app/controllers/billings_controller.rb
new file mode 100644
index 0000000..c397efe
--- /dev/null
+++ b/saas/app/controllers/billings_controller.rb
@@ -0,0 +1,30 @@
+class BillingsController < ApplicationController
+  before_action :ensure_admin, except: :show
+
+  rescue_from Stripe::StripeError do
+    head :service_unavailable
+  end
+
+  def show
+  end
+
+  def checkout
+    plan = BillingPlan::PLANS[params[:plan]]
+    if plan&.stripe_price_id.present? && ENV["STRIPE_SECRET_KEY"].present?
+      billing = StripeBilling.new(Current.account.billing_record_for_update)
+      redirect_to billing.checkout(plan, return_url: saas.billing_url, email: Current.identity.email_address),
+        allow_other_host: true, status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def portal
+    record = Current.account.billing_record
+    if record&.stripe_customer_id.present? && ENV["STRIPE_SECRET_KEY"].present?
+      redirect_to StripeBilling.new(record).portal(return_url: saas.billing_url), allow_other_host: true, status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  end
+end
