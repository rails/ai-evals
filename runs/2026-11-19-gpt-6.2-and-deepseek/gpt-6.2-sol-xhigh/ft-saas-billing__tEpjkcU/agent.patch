diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..fb315e1
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,19 @@
+class Stripe::WebhooksController < ActionController::Base
+  def create
+    secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    return head :service_unavailable if secret.blank?
+
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"].to_s, secret)
+    if %w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted customer.subscription.paused customer.subscription.resumed ].include?(event.type)
+      if record = Account::BillingRecord.find_by(stripe_customer_id: event.data.object.customer.presence || "")
+        return head :service_unavailable if ENV["STRIPE_SECRET_KEY"].blank?
+        StripeBilling.new(record).synchronize_subscription
+      end
+    end
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError
+    head :bad_request
+  rescue Stripe::StripeError
+    head :service_unavailable
+  end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..3ff4fd8
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,33 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :billing_record, dependent: :destroy
+  end
+
+  def billing_record_for_update
+    billing_record || Account::BillingRecord.create_or_find_by!(account: self)
+  end
+
+  def billing_plan
+    billing_record&.plan || BillingPlan::PLANS.fetch("free")
+  end
+
+  def published_card_count
+    billing_record&.card_count_override || cards.published.count
+  end
+
+  def cards_left
+    if limit = billing_plan.card_limit
+      [ limit - published_card_count, 0 ].max
+    end
+  end
+
+  def card_limit_reached?
+    cards_left == 0
+  end
+
+  def bytes_used
+    billing_record&.bytes_used_override || super
+  end
+end
