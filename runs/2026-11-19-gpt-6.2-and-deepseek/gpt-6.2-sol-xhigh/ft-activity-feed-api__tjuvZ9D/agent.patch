diff --git a/docs/api/sections/activities.md b/docs/api/sections/activities.md
new file mode 100644
index 0000000..e5fd444
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,35 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat array of account activity, newest first. Results are limited to
+boards and cards the authenticated user can access. The feed follows the HTML
+timeline's event types, except that it includes `card_title_changed` and omits
+the deprecated `card_collection_changed`.
+
+| Parameter | Type | Description |
+|-----------|------|-------------|
+| `creator_ids[]` | array of user IDs | Return only activity by these users. |
+| `board_ids[]` | array of board IDs | Return only activity on these boards. |
+
+Both filters are optional and can be combined. Follow the `Link` header with
+`rel="next"` to fetch the next page, as with other
+[paginated API endpoints](../README.md#pagination).
+
+Each activity has `id`, `action`, `created_at`, `description`, `particulars`,
+`url`, `eventable_type`, `eventable`, `board`, and `creator`. The `description`
+is the timeline description in plain text. The `url` opens the card and, for
+comment activity, jumps to the comment. `eventable_type` is `Card` or `Comment`;
+`eventable`, `board`, and `creator` use the standard API representations for
+[cards](cards.md), [comments](comments.md), [boards](boards.md), and [users](users.md).
+
+| Action | `particulars` keys |
+|--------|--------------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+`old_board`, `new_board`, and `column` contain names. Missing board, title, or
+column values are returned as empty strings. All other actions return an empty
+`particulars` object.
diff --git a/lib/rails_ext/geared_pagination_preserve_query_parameters.rb b/lib/rails_ext/geared_pagination_preserve_query_parameters.rb
new file mode 100644
index 0000000..0fbaa53
--- /dev/null
+++ b/lib/rails_ext/geared_pagination_preserve_query_parameters.rb
@@ -0,0 +1,12 @@
+module GearedPaginationPreserveQueryParameters
+  private
+    def uri(page:)
+      Addressable::URI.parse(request.url).tap do |uri|
+        # A hash would collapse repeated parameters such as creator_ids[].
+        query = Array(uri.query_values(Array)).reject { |key, _| key == "page" }
+        uri.query_values = query + [ [ "page", page ] ]
+      end.to_s
+    end
+end
+
+GearedPagination::Headers.prepend(GearedPaginationPreserveQueryParameters)
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..4eaeb10
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,156 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @headers = { "Authorization" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+  end
+
+  test "lists account activity as a flat array, newest first" do
+    get "#{accounts("37s").slug}/activities.json", headers: @headers
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+    assert_equal events(:layout_assignment_jz).id, response.parsed_body.first.fetch("id")
+    times = response.parsed_body.map { |activity| Time.iso8601(activity.fetch("created_at")) }
+    assert_equal times.sort.reverse, times
+  end
+
+  test "serializes card and comment events using the existing API representations" do
+    get activities_path(format: :json), headers: @headers
+    activities = response.parsed_body.index_by { |activity| activity.fetch("id") }
+
+    published = events(:logo_published)
+    card_activity = activities.fetch(published.id)
+    assert_equal %w[ action board created_at creator description eventable eventable_type id particulars url ], card_activity.keys.sort
+    assert_equal "card_published", card_activity.fetch("action")
+    assert_equal "Card", card_activity.fetch("eventable_type")
+    assert_equal card_url(published.card), card_activity.fetch("url")
+    assert_equal published.description_for(users(:david)).to_plain_text, card_activity.fetch("description")
+    assert_equal({}, card_activity.fetch("particulars"))
+
+    get cards_path(format: :json), headers: @headers
+    assert_equal response.parsed_body.find { |card| card["id"] == published.card.id }, card_activity.fetch("eventable")
+    get board_path(published.board, format: :json), headers: @headers
+    assert_equal response.parsed_body, card_activity.fetch("board")
+    get user_path(published.creator, format: :json), headers: @headers
+    assert_equal response.parsed_body, card_activity.fetch("creator")
+
+    commented = events(:layout_commented)
+    comment = commented.eventable
+    comment_activity = activities.fetch(commented.id)
+    assert_equal "Comment", comment_activity.fetch("eventable_type")
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), comment_activity.fetch("url")
+    assert_equal commented.description_for(users(:david)).to_plain_text, comment_activity.fetch("description")
+    assert_equal({}, comment_activity.fetch("particulars"))
+
+    get card_comment_path(comment.card, comment, format: :json), headers: @headers
+    assert_equal response.parsed_body, comment_activity.fetch("eventable")
+  end
+
+  test "includes title changes and omits deprecated collection changes and non-timeline events" do
+    card = cards(:logo)
+    with_current_user(:david) do
+      card.update!(title: "A bigger logo")
+      card.track_event("collection_changed")
+      card.track_event("resumed")
+    end
+
+    get activities_path(format: :json), headers: @headers
+    activities = response.parsed_body.index_by { |activity| activity.fetch("action") }
+
+    assert_equal({ "old_title" => "The logo isn't big enough", "new_title" => "A bigger logo" }, activities.fetch("card_title_changed").fetch("particulars"))
+    assert_not activities.key?("card_collection_changed")
+    assert_not activities.key?("card_resumed")
+  end
+
+  test "exposes assignment, board, and column details" do
+    card = cards(:logo)
+    column = columns(:writebook_review)
+    destination = boards(:private)
+    destination.accesses.grant_to(users(:david))
+
+    with_current_user(:david) do
+      card.toggle_assignment(users(:jz))
+      card.triage_into(column)
+      card.move_to(destination)
+    end
+
+    get activities_path(format: :json), headers: @headers
+    activities = response.parsed_body.index_by { |activity| activity.fetch("id") }
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activities.fetch(events(:logo_assignment_jz).id).fetch("particulars"))
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activities.fetch(card.events.find_by!(action: "card_unassigned").id).fetch("particulars"))
+    assert_equal({ "old_board" => boards(:writebook).name, "new_board" => destination.name }, activities.fetch(card.events.find_by!(action: "card_board_changed").id).fetch("particulars"))
+    assert_equal({ "column" => column.name }, activities.fetch(card.events.find_by!(action: "card_triaged").id).fetch("particulars"))
+  end
+
+  test "defaults missing board, title, and column details to empty strings" do
+    events(:logo_published).update_columns(action: "card_board_changed", particulars: nil)
+    events(:layout_published).update_columns(action: "card_title_changed", particulars: {})
+    events(:text_published).update_columns(action: "card_triaged", particulars: { "particulars" => { "column" => nil } })
+
+    get activities_path(format: :json), headers: @headers
+    activities = response.parsed_body.index_by { |activity| activity.fetch("action") }
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, activities.fetch("card_board_changed").fetch("particulars"))
+    assert_equal({ "old_title" => "", "new_title" => "" }, activities.fetch("card_title_changed").fetch("particulars"))
+    assert_equal({ "column" => "" }, activities.fetch("card_triaged").fetch("particulars"))
+  end
+
+  test "filters by creators and boards together" do
+    boards(:private).accesses.grant_to(users(:david))
+    with_current_user(:kevin) { cards(:text).move_to(boards(:private)) }
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id, users(:jz).id ], board_ids: [ boards(:writebook).id ] }, headers: @headers
+
+    assert_response :success
+    assert_equal events(:shipping_published, :shipping_closed).map(&:id).sort, response.parsed_body.pluck("id").sort
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:mike).id ] }, headers: @headers
+    assert_equal [], response.parsed_body
+  end
+
+  test "does not expose activity for inaccessible boards or cards" do
+    # Moving a card directly leaves its older events associated with the old board.
+    with_current_user(:kevin) { cards(:layout).update!(board: boards(:private)) }
+    other_account_event = Current.with_account(accounts(:initech)) do
+      with_current_user(:mike) { cards(:radio).track_event("published") }
+    end
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id, boards(:private).id, boards(:miltons_wish_list).id ] }, headers: @headers
+
+    assert_response :success
+    ids = response.parsed_body.pluck("id")
+    assert_includes ids, events(:logo_published).id
+    assert_empty ids & events(:layout_published, :layout_commented, :layout_assignment_jz).map(&:id)
+    assert_not_includes ids, cards(:layout).events.find_by!(action: "card_board_changed").id
+    assert_not_includes ids, other_account_event.id
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }, headers: @headers
+    assert_equal [], response.parsed_body
+  end
+
+  test "paginates in a stable order and preserves list filters in the next link" do
+    boards(:private).accesses.grant_to(users(:david))
+    freeze_time do
+      with_current_user(:david) { 8.times { cards(:logo).track_event("published") } }
+      with_current_user(:kevin) { cards(:text).move_to(boards(:private)) }
+    end
+    expected_ids = Event.order(created_at: :desc, id: :desc).ids
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id, users(:kevin).id ], board_ids: [ boards(:writebook).id, boards(:private).id ] }, headers: @headers
+
+    assert_response :success
+    assert_equal expected_ids.size.to_s, response.headers["X-Total-Count"]
+    first_page_ids = response.parsed_body.pluck("id")
+    assert_equal expected_ids.first(first_page_ids.size), first_page_ids
+    next_page = response.headers.fetch("Link")[/<([^>]+)>; rel="next"/, 1]
+    assert next_page
+
+    get next_page, headers: @headers
+
+    assert_response :success
+    assert_equal expected_ids.drop(first_page_ids.size), response.parsed_body.pluck("id")
+    assert_nil response.headers["Link"]
+  end
+end
