@@ -34,6 +34,27 @@ port ENV.fetch("PORT", 3000)
 # Allow puma to be restarted by `bin/rails restart` command.
 plugin :tmp_restart
 
+# Sweep persisted deadlines even when nobody has a game page open. Run only in
+# the server, not during migrations, asset compilation, or other Rails commands.
+stop_round_expirer = false
+after_booted do
+  Thread.new do
+    Thread.current.name = "quizzy-round-expirer"
+    until stop_round_expirer
+      begin
+        Rails.application.reloader.wrap { Game.expire_due_rounds! }
+      rescue StandardError => error
+        Rails.logger.error("Could not expire timed rounds: #{error.class}: #{error.message}")
+      end
+      sleep 0.25
+    end
+  end
+end
+
+after_stopped do
+  stop_round_expirer = true
+end
+
 # Specify the PID file. Defaults to tmp/pids/server.pid in development.
 # In other environments, only set the PID file if requested.
 pidfile ENV["PIDFILE"] if ENV["PIDFILE"]
