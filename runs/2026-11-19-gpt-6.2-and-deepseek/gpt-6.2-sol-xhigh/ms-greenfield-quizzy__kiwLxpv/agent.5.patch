--- /dev/null
+++ b/test/integration/round_timer_test.rb
@@ -0,0 +1,170 @@
+require "test_helper"
+
+class RoundTimerTest < ActionDispatch::IntegrationTest
+  JSON_REQUEST = { "Accept" => "application/json" }.freeze
+  TIMER = '[role="timer"]'
+
+  setup do
+    @credentials = ENV.values_at("QUIZZY_MODERATOR_USERNAME", "QUIZZY_MODERATOR_PASSWORD")
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "host"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "test-password"
+    @auth = { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("host", "test-password") }
+    freeze_time
+    @quiz = Quiz.create!(title: "Timed talk")
+    options = [{ "text" => "Right", "correct" => true }, { "text" => "Wrong", "correct" => false }]
+    @quiz.questions.create!(body: "First question", position: 1, options: options)
+    @quiz.questions.create!(body: "Second question", position: 2, options: options)
+  end
+
+  teardown do
+    ENV["QUIZZY_MODERATOR_USERNAME"], ENV["QUIZZY_MODERATOR_PASSWORD"] = @credentials
+  end
+
+  test "settings are numeric, default to zero, and stay local to the quiz" do
+    get edit_moderate_quiz_path(@quiz), headers: @auth
+    assert_select 'label[for="quiz_timer_minutes"]', text: "Timer minutes"
+    assert_select 'label[for="quiz_timer_seconds"]', text: "Timer seconds"
+    assert_select '#quiz_timer_minutes[type="number"][value="0"]'
+    assert_select '#quiz_timer_seconds[type="number"][value="0"]'
+
+    patch moderate_quiz_path(@quiz), headers: @auth, params: { quiz: { timer_minutes: 1, timer_seconds: 30 } }
+    assert_response :see_other
+    assert_equal [1, 30], @quiz.reload.values_at(:timer_minutes, :timer_seconds)
+    get export_moderate_quiz_path(@quiz), headers: @auth
+    exported = JSON.parse(css_select("pre").sole.text)
+    assert_equal %w[questions title], exported.keys.sort
+
+    # Even if a transfer document includes these extra keys, they are not used.
+    post import_moderate_quizzes_path, headers: @auth,
+      params: { quiz_json: exported.merge(timer_minutes: 1, timer_seconds: 30).to_json }
+    assert_response :see_other
+    assert_equal 0, Quiz.order(:id).last.timer_duration_seconds
+  end
+
+  test "invalid timer fields do not change the quiz" do
+    { timer_minutes: [-1, "1.5"], timer_seconds: [-5, "", 2**31] }.each do |field, values|
+      values.each do |value|
+        patch moderate_quiz_path(@quiz), headers: @auth, params: { quiz: { field => value } }
+        assert_response :unprocessable_content
+        assert_select '[role="alert"] li', text: /#{field.to_s.humanize}/
+        assert_equal 0, @quiz.reload.timer_duration_seconds
+      end
+    end
+  end
+
+  test "the stage renders time remaining on a reload, but player responses never include it" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    game = Game.launch!(@quiz)
+    get moderate_game_path(game), headers: @auth
+    assert_select TIMER, count: 0
+    phone = join_game(game)
+
+    advance(game, "start", 0)
+    assert_response :ok
+    deadline = 90.seconds.from_now
+    assert_equal deadline, game.reload.round_deadline_at
+    get moderate_game_path(game), headers: @auth
+    assert_select TIMER, text: "1:30"
+
+    travel 85.seconds
+    get moderate_game_path(game), headers: @auth
+    assert_select TIMER, text: "0:05"
+    assert_equal deadline, game.reload.round_deadline_at
+    phone.get play_path(game.code)
+    phone.assert_select 'button[name="choice"]', count: 2
+    phone.assert_select TIMER, count: 0
+    phone.get play_state_path(game.code)
+    phone.assert_response :ok
+    assert_not_includes phone.response.body, "data-live-countdown-ms"
+  end
+
+  test "answers are rejected at the deadline even before the sweep closes the round" do
+    @quiz.update!(timer_seconds: 2)
+    game = Game.launch!(@quiz)
+    phone = join_game(game)
+    advance(game, "start", 0)
+
+    travel 1.second
+    Game.expire_due_rounds!
+    assert game.reload.open?
+    phone.post play_answer_path(game.code), headers: JSON_REQUEST, params: { revision: 1, choice: 0 }
+    phone.assert_response :ok
+
+    travel 1.second
+    assert game.reload.open?
+    phone.post play_answer_path(game.code), headers: JSON_REQUEST, params: { revision: 1, choice: 1 }
+    phone.assert_response :conflict
+    assert_equal({ 0 => 1 }, game.round_totals)
+
+    Game.expire_due_rounds!
+    Game.expire_due_rounds!
+    assert game.reload.closed?
+    assert_equal 2, game.lock_version
+    assert_nil game.round_deadline_at
+    get moderate_game_path(game), headers: @auth
+    assert_select TIMER, count: 0
+    assert_select ".stage-option.is-correct", text: /Right/
+    phone.get play_state_path(game.code)
+    assert_includes phone.response.parsed_body.fetch("html"), "Correct!"
+  end
+
+  test "finishing early and starting the next round doesn't let a stale sweep finish it" do
+    @quiz.update!(timer_seconds: 5)
+    game = Game.launch!(@quiz)
+    advance(game, "start", 0)
+    originally_open = Game.find(game.id)
+
+    travel 2.seconds
+    advance(game, "finish", 1)
+    assert_response :ok
+    assert_nil game.reload.round_deadline_at
+    advance(game, "next", 2)
+    assert_response :ok
+    assert_equal 5.seconds.from_now, game.reload.round_deadline_at
+
+    travel 3.seconds
+    originally_open.expire_round!
+    assert game.reload.open?
+    assert_equal 1, game.round_index
+    assert_equal 3, game.lock_version
+
+    travel 2.seconds
+    Game.expire_due_rounds!
+    assert game.reload.closed?
+    advance(game, "end", 4)
+    assert_response :ok
+    assert game.reload.ended?
+  end
+
+  test "zero is untimed and settings changes apply to subsequent games" do
+    original = Game.launch!(@quiz)
+    @quiz.update!(timer_seconds: 90)
+    replay = Game.launch!(@quiz)
+    advance(original, "start", 0)
+    advance(replay, "start", 0)
+    assert_nil original.reload.round_deadline_at
+    assert_equal 90.seconds.from_now, replay.reload.round_deadline_at
+
+    travel 2.minutes
+    Game.expire_due_rounds!
+    assert original.reload.open?
+    assert replay.reload.closed?
+    get moderate_game_path(original), headers: @auth
+    assert_select TIMER, count: 0
+    assert_select 'button', text: "Finish"
+  end
+
+  private
+
+  def advance(game, command, revision)
+    post advance_moderate_game_path(game), headers: @auth.merge(JSON_REQUEST), params: { command: command, revision: revision }
+  end
+
+  def join_game(game)
+    open_session do |phone|
+      phone.get play_path(game.code)
+      phone.post play_join_path(game.code), headers: JSON_REQUEST, params: { name: "Alice" }
+      phone.assert_response :ok
+    end
+  end
+end
