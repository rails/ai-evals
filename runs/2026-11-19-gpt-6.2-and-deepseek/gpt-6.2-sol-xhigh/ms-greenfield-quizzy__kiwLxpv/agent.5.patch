+++ b/script/check_timer
@@ -0,0 +1,83 @@
+#!/usr/bin/env ruby
+require "capybara/cuprite"
+require "json"
+require "securerandom"
+
+Capybara.app_host = ENV.fetch("QUIZZY_URL", "http://127.0.0.1:3000")
+Capybara.run_server = false
+Capybara.enable_aria_label = true
+Capybara.default_max_wait_time = 12
+Capybara.register_driver(:quizzy_timer) do |app|
+  Capybara::Cuprite::Driver.new(app,
+    browser_path: ENV.fetch("CHROMIUM_PATH", "chromium"),
+    browser_options: { "no-sandbox": nil, "disable-dev-shm-usage": nil, "disable-background-networking": nil })
+end
+
+def expect(condition, message)
+  raise "Failed: #{message}" unless condition
+end
+
+screen, phone = Array.new(2) { Capybara::Session.new(:quizzy_timer) }
+screen.driver.browser.network.authorize(user: ENV.fetch("QUIZZY_MODERATOR_USERNAME"),
+  password: ENV.fetch("QUIZZY_MODERATOR_PASSWORD")) { |request| request.continue }
+quiz_path = nil
+begin
+  title = "Timer check #{SecureRandom.hex(4)}"
+  screen.visit("/moderate")
+  screen.click_button("Import quiz", exact: true)
+  screen.fill_in("Quiz JSON", with: JSON.generate(title: title, questions: ["First round", "Second round"].map do |text|
+    { text: text, options: [{ text: "Right answer", correct: true }, { text: "Wrong answer", correct: false }] }
+  end))
+  screen.click_button("Import", exact: true)
+  expect(screen.has_css?("h1", text: title), "Quiz imports")
+  quiz_path = screen.current_path
+
+  screen.click_link("Settings", exact: true)
+  expect(screen.has_field?("Timer minutes", type: "number", with: "0", wait: 0), "Timer minutes defaults to zero")
+  expect(screen.has_field?("Timer seconds", type: "number", with: "0", wait: 0), "Timer seconds defaults to zero")
+  screen.fill_in("Timer seconds", with: 9)
+  screen.click_button("Save quiz", exact: true)
+  screen.click_link("Export", exact: true)
+  exported = JSON.parse(screen.find("pre").text)
+  expect(exported.keys.sort == %w[questions title], "Timer settings are not exported")
+
+  screen.visit(quiz_path)
+  screen.click_button("Start a game", exact: true)
+  game_url = screen.current_url
+  join_url = screen.find(".lobby__url").text
+  expect(screen.has_no_css?('[role="timer"]', wait: 0), "There is no lobby countdown")
+  phone.visit(join_url)
+  phone.fill_in("Your name", with: "Alice")
+  phone.click_button("Join", exact: true)
+  expect(phone.has_text?("Hi, Alice!"), "Player joined")
+
+  screen.click_button("Start", exact: true)
+  timer = '[role="timer"]'
+  expect(screen.has_css?(timer, text: /\A0:0[89]\z/), "Stage shows the countdown when the round opens")
+  expect(phone.has_button?("Right answer", exact: true), "Player sees the question")
+  expect(phone.has_no_css?(timer, wait: 0), "Player does not see the countdown")
+  phone.click_button("Right answer", exact: true)
+  expect(phone.has_text?("Your answer"), "A pick before zero is accepted")
+  expect(screen.has_css?(timer, text: /\A0:0[3-6]\z/), "The countdown ticks down")
+  screen.refresh
+  expect(screen.find(timer).text.match?(/\A0:0[1-6]\z/), "Reload keeps the original deadline")
+
+  screen.visit("/up")
+  expect(phone.has_text?("Correct!"), "Round finishes and results arrive even without the stage open")
+  screen.visit(game_url)
+  expect(screen.has_no_css?(timer, wait: 0), "Finished rounds have no countdown")
+  screen.click_button("Next", exact: true)
+  expect(screen.has_css?(timer, text: /\A0:0[89]\z/), "The next round gets a fresh countdown")
+  screen.click_button("Finish", exact: true)
+  expect(screen.has_button?("End quiz", exact: true), "Finish closes a round early")
+  expect(screen.has_no_css?(timer, wait: 0), "Finishing manually removes the countdown")
+  screen.click_button("End quiz", exact: true)
+  expect(phone.has_text?("The quiz is over"), "The quiz can end normally")
+  puts "Chromium round timer workflow passed."
+ensure
+  if quiz_path
+    screen.visit("#{quiz_path}/edit")
+    screen.accept_confirm("Delete this quiz and all its questions?") { screen.click_button("Delete quiz", exact: true) }
+  end
+  [screen, phone].each { |page| page.driver.quit }
+end
diff --git a/test/integration/round_timer_test.rb b/test/integration/round_timer_test.rb
new file mode 100644
