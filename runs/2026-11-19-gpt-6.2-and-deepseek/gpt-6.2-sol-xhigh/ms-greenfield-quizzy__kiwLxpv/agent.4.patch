+require "test_helper"
+
+class GameLeaderboardTest < ActiveSupport::TestCase
+  test "a draw samples the full cutoff group without using its speed order" do
+    standings = [4, 3, 2, 2, 2, 2, 1, 0].map.with_index(1) do |points, id|
+      { "id" => id, "points" => points }
+    end
+
+    assert_equal [1, 2, 3, 4], GameLeaderboard.prize_ids(standings, count: 4, draw: false)
+    # A fixed random choice near the end of the group lets us test this without flakiness.
+    draws_from_end = Object.new
+    def draws_from_end.rand(limit) = limit - 1
+    picks = GameLeaderboard.prize_ids(standings, count: 4, draw: true, random: draws_from_end)
+    assert_equal [1, 2], picks.first(2)
+    assert_equal [5, 6], picks.last(2).sort
+  end
+end
