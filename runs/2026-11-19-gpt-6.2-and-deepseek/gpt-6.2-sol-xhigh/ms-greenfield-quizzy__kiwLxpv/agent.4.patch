diff --git a/app/models/game_leaderboard.rb b/app/models/game_leaderboard.rb
new file mode 100644
index 0000000..97e3acd
--- /dev/null
+++ b/app/models/game_leaderboard.rb
@@ -0,0 +1,31 @@
+class GameLeaderboard
+  def self.build(game)
+    correct_choices = game.rounds.map { |round| round.fetch("options").pluck("correct") }
+    scores = Hash.new { |all, player_id| all[player_id] = [0, 0] }
+    game.answers.pluck(:game_player_id, :round_index, :choice, :elapsed_microseconds).each do |player_id, round, choice, elapsed|
+      next unless correct_choices.dig(round, choice) == true
+
+      score = scores[player_id]
+      score[0] += 1
+      # Older answers still count, but have no measured speed to compare.
+      score[1] += elapsed || Float::INFINITY
+    end
+
+    game.players.pluck(:id, :name).sort_by do |id, _name|
+      points, elapsed = scores[id]
+      [-points, elapsed, id]
+    end.map do |id, name|
+      { "id" => id, "name" => name, "points" => scores[id].first }
+    end
+  end
+
+  def self.prize_ids(leaderboard, count:, draw:, random: Random)
+    top = leaderboard.first(count).take_while { |entry| entry.fetch("points").positive? }
+    return top.pluck("id") unless draw && top.size == count
+
+    cutoff = top.last.fetch("points")
+    guaranteed = top.take_while { |entry| entry.fetch("points") > cutoff }
+    tied = leaderboard.select { |entry| entry.fetch("points") == cutoff }
+    (guaranteed + tied.sample(count - guaranteed.size, random: random)).pluck("id")
+  end
+end
