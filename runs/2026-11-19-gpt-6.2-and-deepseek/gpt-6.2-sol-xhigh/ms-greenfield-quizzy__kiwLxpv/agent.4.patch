new file mode 100644
index 0000000..be53a94
--- /dev/null
+++ b/app/channels/live_game_channel.rb
@@ -0,0 +1,10 @@
+class LiveGameChannel < ActionCable::Channel::Base
+  def subscribed
+    code = params[:code]
+    return reject unless code.is_a?(String) && code.match?(/\A[A-Z0-9]{7}\z/) && Game.exists?(code: code)
+
+    # This public stream only signals a change. HTTP still applies moderator
+    # authentication and the browser's game-scoped identity to the real state.
+    stream_for code
+  end
+end
