new file mode 100644
index 0000000..6cd2b0a
--- /dev/null
+++ b/app/views/play/_player.html.erb
@@ -0,0 +1,70 @@
+<% if @game.ended? %>
+  <section class="waiting">
+    <p class="play-lead"><%= @game.title %></p>
+    <h1 class="play-title" data-live-heading tabindex="-1">The quiz is over</h1>
+  </section>
+<% elsif !@player %>
+  <section>
+    <p class="play-lead">Join the quiz</p>
+    <h1 class="play-title" data-live-heading tabindex="-1"><%= @game.title %></h1>
+    <%= form_with url: play_join_path(@game.code), class: "join-form", data: { live_action: "join" } do |form| %>
+      <% if @join_error %><p class="join-error" role="alert"><%= @join_error %></p><% end %>
+      <%= form.label :name, "Your name" %>
+      <%= form.text_field :name, value: @name, class: "input", required: true, maxlength: 80, autocomplete: "nickname", data: { live_focus: "name" } %>
+      <%= form.submit "Join", class: "btn btn--pink" %>
+    <% end %>
+  </section>
+<% elsif @game.waiting? %>
+  <section class="waiting">
+    <div class="waiting__gem" aria-hidden="true">?</div>
+    <h1 class="play-title" data-live-heading tabindex="-1">Hi, <%= @player.name %>!</h1>
+    <p class="play-lead">Waiting for the quiz to start…</p>
+  </section>
+<% else %>
+  <% round = @game.current_round %>
+  <% options = round.fetch("options") %>
+  <section class="live-question">
+    <p class="player-greeting">Hi, <%= @player.name %>!</p>
+    <p class="play-question__num">Question <%= @game.round_index + 1 %> of <%= @game.rounds.length %></p>
+    <h1 class="play-question__body" data-live-heading tabindex="-1"><%= round.fetch("body") %></h1>
+    <% if @game.open? %>
+      <%= form_with url: play_answer_path(@game.code), class: "play-options", data: { live_action: "answer" } do |form| %>
+        <%= form.hidden_field :revision, value: @game.lock_version %>
+        <% options.each_with_index do |option, index| %>
+          <% picked = @choice == index %>
+          <button type="submit" name="choice" value="<%= index %>" class="play-option <%= 'is-picked' if picked %>"
+                  aria-pressed="<%= picked %>" aria-label="<%= option.fetch("text") %>" data-live-focus="option-<%= @game.round_index %>-<%= index %>">
+            <span class="play-option__letter" aria-hidden="true" data-letter="<%= option_letter(index) %>"></span>
+            <span class="play-option__title"><%= option.fetch("text") %></span>
+            <% if picked %><span class="play-option__mark" aria-hidden="true">Your answer</span><% end %>
+          </button>
+        <% end %>
+      <% end %>
+    <% else %>
+      <% feedback, style = if @choice.nil?
+        ["No answer", "neutral"]
+      elsif options.fetch(@choice).fetch("correct")
+        ["Correct!", "right"]
+      else
+        ["Wrong!", "wrong"]
+      end %>
+      <ol class="play-options play-results is-locked is-revealed">
+        <% options.each_with_index do |option, index| %>
+          <% picked = @choice == index %>
+          <% correct = option.fetch("correct") %>
+          <li class="play-option <%= 'is-picked' if picked %> <%= 'is-correct' if correct %>">
+            <span class="play-option__letter" aria-hidden="true" data-letter="<%= option_letter(index) %>"></span>
+            <span class="play-option__title"><%= option.fetch("text") %></span>
+            <% if picked || correct %>
+              <div class="play-option__mark play-option__result">
+                <% if picked %><span>Your answer</span><% end %>
+                <% if correct %><span>Correct</span><% end %>
+              </div>
+            <% end %>
+          </li>
+        <% end %>
+      </ol>
+      <p class="play-status play-status--<%= style %>" role="status"><%= feedback %></p>
+    <% end %>
+  </section>
+<% end %>
