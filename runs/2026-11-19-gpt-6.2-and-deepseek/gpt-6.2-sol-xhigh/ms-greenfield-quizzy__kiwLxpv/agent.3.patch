diff --git a/app/controllers/concerns/live_game_response.rb b/app/controllers/concerns/live_game_response.rb
new file mode 100644
index 0000000..334c9c4
--- /dev/null
+++ b/app/controllers/concerns/live_game_response.rb
@@ -0,0 +1,25 @@
+module LiveGameResponse
+  private
+
+  # Keep polling responses small. A view key represents only information the
+  # viewer is already allowed to see; never derive it from the hidden answer key.
+  def respond_with_game(status: :ok)
+    prepare_live_view
+    if request.format.json?
+      if request.get? && @view_key == params[:view]
+        return @counter ? render(json: { counter: @counter }) : head(:no_content)
+      end
+
+      render json: {
+        view: @view_key,
+        ended: @game.ended?,
+        counter: @counter,
+        html: render_to_string(partial: live_game_partial, formats: [:html])
+      }, status: status
+    elsif request.get? || status == :unprocessable_content
+      render :show, status: status
+    else
+      redirect_to live_game_path, status: :see_other
+    end
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
