diff --git a/app/assets/javascripts/live_game.js b/app/assets/javascripts/live_game.js
new file mode 100644
index 0000000..280108d
--- /dev/null
+++ b/app/assets/javascripts/live_game.js
@@ -0,0 +1,118 @@
+(() => {
+  const root = document.querySelector("[data-live-game]");
+  if (!root) return;
+
+  const content = root.querySelector("[data-live-content]");
+  const notice = root.querySelector("[data-live-notice]");
+  const stateUrl = new URL(root.dataset.stateUrl, window.location.href);
+  const interval = Number(root.dataset.pollMs);
+  let ended = content.dataset.ended === "true";
+  let timer, pollController, queued;
+  let running = false;
+  let writing = false;
+  let failures = 0;
+  let unconfirmed = false;
+
+  function showNotice(message) {
+    if (notice.textContent !== message) notice.textContent = message;
+    notice.hidden = !message;
+  }
+
+  function apply(state) {
+    if (state.html !== undefined) {
+      const focused = document.activeElement;
+      const wasFocused = content.contains(focused);
+      const focusKey = focused?.dataset.liveFocus;
+      content.innerHTML = state.html;
+      content.dataset.view = state.view;
+      ended = state.ended;
+      if (wasFocused) {
+        const target = Array.from(content.querySelectorAll("[data-live-focus]"))
+          .find((element) => element.dataset.liveFocus === focusKey);
+        (target || content.querySelector("[data-live-heading]"))?.focus({ preventScroll: true });
+      }
+      unconfirmed = false;
+    }
+    const counter = content.querySelector("[data-live-counter]");
+    if (counter && state.counter && counter.textContent !== state.counter) {
+      counter.textContent = state.counter;
+    }
+  }
+
+  function schedule(delay) {
+    clearTimeout(timer);
+    if (!ended || queued) timer = setTimeout(sync, delay);
+  }
+
+  async function sync() {
+    if (running || (ended && !queued)) return;
+    running = true;
+    const job = queued;
+    queued = null;
+    writing = Boolean(job);
+
+    const controller = new AbortController();
+    if (!job) pollController = controller;
+    const deadline = setTimeout(() => controller.abort("timeout"), job ? 8000 : 5000);
+    stateUrl.searchParams.set("view", content.dataset.view);
+
+    try {
+      const response = await fetch(job?.url || stateUrl, {
+        method: job ? "POST" : "GET",
+        body: job?.body,
+        headers: { Accept: "application/json" },
+        signal: controller.signal,
+        cache: "no-store"
+      });
+      if (response.status === 404) {
+        queued = null;
+        ended = true;
+        content.hidden = true;
+        showNotice("This game is no longer available.");
+        return;
+      }
+      if (!response.ok && !(job && [409, 422].includes(response.status))) throw new Error("Sync failed");
+      if (response.status !== 204) {
+        const state = await response.json();
+        if (!queued) apply(state);
+      }
+      failures = 0;
+      if (job) unconfirmed = false;
+      showNotice(unconfirmed ? "Could not confirm your last action. You can try again." : "");
+    } catch {
+      if (controller.signal.reason !== "superseded") {
+        failures += 1;
+        if (job) unconfirmed = true;
+        showNotice("Connection interrupted. Reconnecting…");
+      }
+    } finally {
+      clearTimeout(deadline);
+      running = writing = false;
+      pollController = null;
+      const delay = Math.min(8000, interval * (2 ** Math.min(failures, 4)));
+      schedule(queued ? 0 : delay * (0.8 + 0.4 * Math.random()));
+    }
+  }
+
+  root.addEventListener("submit", (event) => {
+    const form = event.target;
+    const action = form.dataset.liveAction;
+    if (!action) return;
+    event.preventDefault();
+    if (ended || (action !== "answer" && (writing || queued))) return;
+    // Serialize submissions from this page. If several choices are tapped on a
+    // slow connection, send only the newest one after the in-flight choice.
+    const body = new FormData(form);
+    if (event.submitter?.name) body.append(event.submitter.name, event.submitter.value);
+    queued = { url: form.action, body };
+    clearTimeout(timer);
+    pollController?.abort("superseded");
+    sync();
+  });
+
+  const catchUp = () => schedule(0);
+  window.addEventListener("online", catchUp);
+  window.addEventListener("pageshow", catchUp);
+  document.addEventListener("visibilitychange", () => { if (!document.hidden) catchUp(); });
+  schedule(interval * Math.random());
+})();
