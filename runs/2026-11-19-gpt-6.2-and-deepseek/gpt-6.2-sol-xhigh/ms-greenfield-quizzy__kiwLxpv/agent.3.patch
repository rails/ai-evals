+<header class="screen__top">
+  <div class="screen__logo"><%= render "shared/logo" %></div>
+  <span class="live-tag">Live game</span>
+</header>
+
+<div class="screen__body">
+  <% if @game.waiting? %>
+    <section class="lobby">
+      <div>
+        <p class="screen__kicker">Join the quiz</p>
+        <h1 class="lobby__title" data-live-heading tabindex="-1"><%= @game.title %></h1>
+        <p class="lobby__url"><%= play_url(@game.code) %></p>
+        <p class="counter-pill" data-live-counter aria-live="polite"><%= @counter %></p>
+        <% if @game.rounds.empty? %><p>No active questions</p><% end %>
+      </div>
+      <div class="qr">
+        <%= image_tag qr_moderate_game_path(@game, format: :svg), alt: "QR code for the join link" %>
+      </div>
+    </section>
+  <% elsif @game.ended? %>
+    <section class="stage-end">
+      <p class="screen__kicker"><%= @game.title %></p>
+      <h1 class="lobby__title" data-live-heading tabindex="-1">The quiz is over</h1>
+    </section>
+  <% else %>
+    <% round = @game.current_round %>
+    <% totals = @game.round_totals if @game.closed? %>
+    <section>
+      <p class="stage-question__num">Question <%= @game.round_index + 1 %> of <%= @game.rounds.length %></p>
+      <h1 class="stage-question__body" data-live-heading tabindex="-1"><%= round.fetch("body") %></h1>
+      <ol class="stage-options <%= 'stage-options--results' if totals %>">
+        <% round.fetch("options").each_with_index do |option, index| %>
+          <% correct = totals && option.fetch("correct") %>
+          <li class="stage-option <%= 'is-correct' if correct %>">
+            <span class="stage-option__letter" aria-hidden="true"><%= option_letter(index) %></span>
+            <span class="stage-option__title"><%= option.fetch("text") %></span>
+            <% if totals %>
+              <div class="stage-option__result">
+                <span class="stage-option__count"><%= totals.fetch(index, 0) %></span>
+                <% if correct %><span class="stage-option__badge">Correct</span><% end %>
+              </div>
+            <% end %>
+          </li>
+        <% end %>
+      </ol>
+    </section>
+  <% end %>
+</div>
+
+<footer class="screen-controls">
+  <div class="screen-controls__info">
+    <%= link_to "← Back to quiz", moderate_quiz_path(@game.quiz_id) %>
+    <% if @game.open? %><span class="answers-counter" data-live-counter aria-live="polite"><%= @counter %></span><% end %>
+  </div>
+  <% unless @game.ended? %>
+    <% label, command = if @game.waiting?
+      ["Start", "start"]
+    elsif @game.open?
+      ["Finish", "finish"]
+    elsif @game.last_round?
+      ["End quiz", "end"]
+    else
+      ["Next", "next"]
+    end %>
+    <%= button_to label, advance_moderate_game_path(@game), class: "btn btn--pink btn--lg",
+          params: { command: command, revision: @game.lock_version }, form: { data: { live_action: "advance" } } %>
+  <% end %>
+</footer>
