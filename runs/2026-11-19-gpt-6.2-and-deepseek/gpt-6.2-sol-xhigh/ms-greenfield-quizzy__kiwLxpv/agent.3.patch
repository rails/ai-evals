new file mode 100644
index 0000000..0ee966e
--- /dev/null
+++ b/app/models/game_player.rb
@@ -0,0 +1,20 @@
+class GamePlayer < ApplicationRecord
+  PRESENCE_WINDOW = 20.seconds
+  CHECK_IN_INTERVAL = 5.seconds
+
+  belongs_to :game, inverse_of: :players
+  has_many :answers, class_name: "GameAnswer", inverse_of: :game_player
+
+  scope :present_in_game, -> { where(last_seen_at: PRESENCE_WINDOW.ago..) }
+
+  validates :name, presence: true, length: { maximum: 80 }
+
+  def check_in
+    now = Time.current
+    cutoff = now - CHECK_IN_INTERVAL
+    return if last_seen_at >= cutoff
+
+    # Multiple tabs share a lease. Only one of them needs to refresh it.
+    self.class.where(id: id, last_seen_at: ...cutoff).update_all(last_seen_at: now)
+  end
+end
