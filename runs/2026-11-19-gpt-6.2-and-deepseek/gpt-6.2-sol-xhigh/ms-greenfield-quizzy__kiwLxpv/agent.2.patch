diff --git a/app/models/quiz_import.rb b/app/models/quiz_import.rb
new file mode 100644
index 0000000..596f706
--- /dev/null
+++ b/app/models/quiz_import.rb
@@ -0,0 +1,70 @@
+class QuizImport
+  include ActiveModel::Model
+
+  InvalidFormat = Class.new(StandardError)
+  TYPE_NAMES = { Hash => "an object", Array => "an array", String => "a string" }.freeze
+
+  attr_accessor :quiz_json
+  attr_reader :quiz
+
+  def save
+    errors.clear
+    @quiz = nil
+    contents = require_type(JSON.parse(quiz_json.to_s), Hash, "Quiz JSON")
+    title = require_type(contents["title"], String, "Quiz title")
+    questions = require_type(contents["questions"], Array, "Quiz questions")
+
+    @quiz = Quiz.transaction(requires_new: true) do
+      imported_quiz = Quiz.create!(title: title)
+      questions.each_with_index do |question, index|
+        imported_quiz.questions.create!(question_attributes(question, index + 1))
+      end
+      imported_quiz
+    end
+    true
+  rescue JSON::ParserError
+    errors.add(:base, "Invalid JSON. Paste the contents of an exported quiz.")
+    false
+  rescue InvalidFormat => error
+    errors.add(:base, error.message)
+    false
+  rescue ActiveRecord::RecordInvalid => error
+    record = error.record
+    label = record.is_a?(Question) ? "Question #{record.position}" : "Quiz"
+    errors.add(:base, "#{label}: #{record.errors.full_messages.to_sentence}")
+    false
+  end
+
+  private
+
+  def question_attributes(question, position)
+    label = "Question #{position}"
+    require_type(question, Hash, label)
+    body = require_type(question["text"], String, "#{label} text")
+    active = require_boolean(question.fetch("active", true), "#{label} active")
+    options = require_type(question["options"], Array, "#{label} options")
+    rows = options.map.with_index(1) { |option, number| option_row(option, "#{label}, option #{number}") }
+
+    { body: body, active: active, position: position, option_rows: rows }
+  end
+
+  def option_row(option, label)
+    require_type(option, Hash, label)
+    {
+      "text" => require_type(option["text"], String, "#{label} text"),
+      "correct" => require_boolean(option.fetch("correct", false), "#{label} correct")
+    }
+  end
+
+  def require_type(value, type, label)
+    return value if value.is_a?(type)
+
+    raise InvalidFormat, "#{label} must be #{TYPE_NAMES.fetch(type)}."
+  end
+
+  def require_boolean(value, label)
+    return value if value == true || value == false
+
+    raise InvalidFormat, "#{label} must be true or false."
+  end
+end
