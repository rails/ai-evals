diff --git a/spec/support/fabricator_defaults.rb b/spec/support/fabricator_defaults.rb
new file mode 100644
index 0000000..98b75d2
--- /dev/null
+++ b/spec/support/fabricator_defaults.rb
@@ -0,0 +1,16 @@
+# frozen_string_literal: true
+
+# Keep legacy fixture graphs outside the model and request performance phases.
+module FabricatorDefaults
+  def self.without_extras
+    previous = Thread.current[:fabricator_defaults_without_extras]
+    Thread.current[:fabricator_defaults_without_extras] = true
+    yield
+  ensure
+    Thread.current[:fabricator_defaults_without_extras] = previous
+  end
+
+  def self.extras?
+    !Thread.current[:fabricator_defaults_without_extras]
+  end
+end
