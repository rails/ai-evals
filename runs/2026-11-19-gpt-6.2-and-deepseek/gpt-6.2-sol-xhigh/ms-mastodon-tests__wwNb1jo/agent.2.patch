diff --git a/spec/rails_helper.rb b/spec/rails_helper.rb
index d90610d..009d80e 100644
--- a/spec/rails_helper.rb
+++ b/spec/rails_helper.rb
@@ -69,12 +69,24 @@ RSpec.configure do |config|
     metadata[:type] = :cli
   end
 
-  # Model specs normally only need to enqueue jobs. Opt into inline execution
-  # with `sidekiq: :inline` when an example depends on a job's effects.
-  config.define_derived_metadata(file_path: %r{(?:\A|/)spec/models/}) do |metadata|
+  # Model and request specs usually only need to enqueue jobs. Use
+  # `sidekiq: :inline` when setup or assertions need a job's effects.
+  config.define_derived_metadata(file_path: %r{(?:\A|/)spec/(?:models|requests)/}) do |metadata|
     metadata[:sidekiq] ||= :fake
   end
 
+  config.define_derived_metadata(file_path: %r{(?:\A|/)spec/requests/}) do |metadata|
+    metadata[:quiet_rails_logs] = true unless metadata.key?(:quiet_rails_logs)
+  end
+
+  # Skip debug log formatting (especially SQL binds) during request examples.
+  # Keep request summaries and warnings, and restore the level after each example.
+  unless ENV['RSPEC_DEBUG_LOGS'] == '1'
+    config.around(:each, :quiet_rails_logs) do |example|
+      Rails.logger.silence([Rails.logger.level, Logger::INFO].max) { example.run }
+    end
+  end
+
   # Set `search` metadata true for all specs in spec/search/
   config.define_derived_metadata(file_path: Regexp.new('spec/search/*')) do |metadata|
     metadata[:search] = true
