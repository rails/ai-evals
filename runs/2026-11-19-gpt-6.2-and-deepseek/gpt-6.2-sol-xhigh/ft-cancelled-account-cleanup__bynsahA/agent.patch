diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..f85a61f 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,39 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  class_methods do
+    def incinerate_due
+      Account::Cancellation.where(created_at: ...INCINERATION_GRACE_PERIOD.ago).find_each do |cancellation|
+        transaction do
+          account = lock.find_by(id: cancellation.account_id)
+
+          # Reactivation and cancellation take the same lock and may have replaced this cancellation.
+          if account&.cancellation == cancellation
+            incinerate(account)
+          end
+        end
+      end
+    end
+
+    private
+      def incinerate(account)
+        incinerate_storage(account)
+        Search::Record.for(account.id).where(account_id: account.id).find_each(&:destroy!)
+        account.destroy!
+      end
+
+      def incinerate_storage(account)
+        # Skip detach callbacks: the whole account and its storage ledger are being deleted.
+        ActiveStorage::Attachment.where(account: account).delete_all
+        ActiveStorage::VariantRecord.where(account: account).delete_all
+        ::Storage::Entry.where(account: account).delete_all
+
+        ActiveStorage::Blob.where(account: account).find_each do |blob|
+          blob.destroy!
+          ActiveRecord.after_all_transactions_commit { blob.delete }
+        end
+      end
+  end
 end
