diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..087cc02
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "permanently removes an overdue account and its data without removing shared identities" do
+    account = accounts(:"37s")
+    other_account = accounts(:initech)
+    identity = identities(:david)
+    other_user = other_account.users.create!(name: "David", identity: identity)
+    card = cards(:logo)
+    card.reindex
+    search_record = Search::Record.for(account.id).find_by!(searchable: card)
+    card.image.attach(io: StringIO.new("attached"), filename: "attached.txt")
+    card.image.blob.variant_records.create!(variation_digest: "example")
+    unattached_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("unattached"), filename: "unattached.txt")
+    other_blob = Current.with_account(other_account) do
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("other account"), filename: "other.txt")
+    end
+
+    travel_to 31.days.ago do
+      account.cancel(initiated_by: users(:david))
+    end
+    assert Storage::Entry.exists?(account: account)
+
+    Current.without_account { Account::IncinerateDueJob.perform_now }
+
+    assert_not Account.exists?(account.id)
+    assert_not Account::Cancellation.exists?(account: account)
+    assert_not User.exists?(account: account)
+    assert_not Board.exists?(account: account)
+    assert_not Card.exists?(account: account)
+    assert_not Export.exists?(account: account)
+    assert_not ActionText::RichText.exists?(account: account)
+    assert_not Search::Record.for(account.id).exists?(account_id: account.id)
+    assert_not Storage::Entry.exists?(account: account)
+    assert_not ActiveStorage::Attachment.exists?(account: account)
+    assert_not ActiveStorage::VariantRecord.exists?(account: account)
+    assert_not ActiveStorage::Blob.exists?(account: account)
+    assert_not unattached_blob.service.exist?(unattached_blob.key)
+    assert_not Search::Record::SQLite::Fts.exists?(rowid: search_record.id) if Fizzy.db_adapter.sqlite?
+
+    assert Account.exists?(other_account.id)
+    assert Card.exists?(cards(:radio).id)
+    assert Identity.exists?(identity.id)
+    assert User.exists?(other_user.id)
+    assert ActiveStorage::Blob.exists?(other_blob.id)
+  end
+
+  test "retains accounts until their cancellations are more than 30 days old" do
+    account = accounts(:"37s")
+    recent_account = accounts(:initech)
+
+    freeze_time do
+      account.cancel(initiated_by: users(:david))
+      travel 1.day
+      recent_account.cancel(initiated_by: users(:mike))
+      travel 29.days
+
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+      assert Account.exists?(account.id), "An account canceled exactly 30 days ago should be retained"
+      assert Account.exists?(recent_account.id)
+
+      travel 1.second
+
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+      assert_not Account.exists?(account.id)
+      assert Account.exists?(recent_account.id)
+    end
+  end
+
+  test "retains reactivated accounts" do
+    account = accounts(:"37s")
+    travel_to 31.days.ago do
+      account.cancel(initiated_by: users(:david))
+    end
+    account.reactivate
+
+    Current.without_account { Account::IncinerateDueJob.perform_now }
+
+    assert Account.exists?(account.id)
+    assert account.reload.active?
+  end
+end
