diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..72cfe83
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,69 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> do
+      cutoff = STALL_PERIOD.ago
+      active.where(activity_burst_at: ..cutoff, last_active_at: ..cutoff)
+    end
+  end
+
+  class_methods do
+    def backfill_activity_bursts
+      published.where(activity_burst_at: nil).preload(board: [ :entropy, { account: :entropy } ]).find_each do |card|
+        card.backfill_activity_burst
+      end
+    end
+  end
+
+  def stalled?
+    cutoff = STALL_PERIOD.ago
+    activity_burst_at.present? && activity_burst_at <= cutoff && last_active_at <= cutoff && active?
+  end
+
+  def display_cache_key
+    [ self, stalled? ]
+  end
+
+  def record_activity_burst(at)
+    update!(activity_burst_at: at) unless activity_burst_at?
+  end
+
+  def record_comment_burst(commented_at)
+    return if activity_burst_at?
+
+    window = comment_burst_window
+    nearby_comments = comments.by_user.where(created_at: (commented_at - window)..(commented_at + window))
+    if burst_at = comment_burst_at(nearby_comments, window)
+      record_activity_burst(burst_at)
+    end
+  end
+
+  def backfill_activity_burst
+    burst_at = assignments.minimum(:created_at) ||
+      events.where(action: %w[ card_assigned card_reopened ]).minimum(:created_at) ||
+      comment_burst_at(comments.by_user, comment_burst_window)
+
+    if burst_at
+      # Keep last_active_at unchanged, and don't overwrite a burst recorded while backfilling.
+      Card.where(id: id, activity_burst_at: nil).update_all(activity_burst_at: burst_at)
+    end
+  end
+
+  private
+    def comment_burst_window
+      auto_postpone_period.fdiv(3)
+    end
+
+    def comment_burst_at(comments, window)
+      # Any qualifying group contains three consecutive comments by at least two people.
+      comments.order(:created_at, :id).pluck(:created_at, :creator_id).each_cons(3) do |first, middle, last|
+        if last.first - first.first <= window && (first.last != middle.last || middle.last != last.last)
+          return last.first
+        end
+      end
+      nil
+    end
+end
