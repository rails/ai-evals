new file mode 100644
index 0000000..fe293f2
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,175 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create!(title: "A card", status: :published)
+  end
+
+  test "an inactive card without a burst does not stall" do
+    travel 3.weeks
+    refute_stalled @card
+  end
+
+  test "three comments from two people within a third of the board period start the stall clock" do
+    @card.board.auto_postpone_period_in_days = 3
+    comment_as :david
+    travel 12.hours
+    comment_as :david
+    travel 12.hours
+    comment_as :kevin
+
+    travel 2.weeks - 1.second
+    refute_stalled @card
+    travel 1.second
+    assert_stalled @card
+  end
+
+  test "comments from only one person and system comments do not make a burst" do
+    3.times { comment_as :david }
+    comment_as :system
+
+    travel 2.weeks
+    refute_stalled @card
+  end
+
+  test "comments outside the board window do not count towards a burst" do
+    @card.board.auto_postpone_period_in_days = 3
+    comment_as :kevin
+    travel 1.day + 1.second
+    comment_as :david
+    comment_as :kevin
+
+    travel 2.weeks
+    refute_stalled @card
+  end
+
+  test "a board without an override uses the account's auto-close period" do
+    entropies(:writebook_board).destroy!
+    @card.reload
+    comment_as :kevin
+    travel 5.days
+    comment_as :david
+    travel 5.days
+    comment_as :david
+
+    travel 2.weeks
+    assert_stalled @card
+  end
+
+  test "an assignment starts the stall clock" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 2.weeks
+    assert_stalled @card
+  end
+
+  test "reopening starts the stall clock but closing does not" do
+    @card.close
+    assert_nil @card.reload.activity_burst_at
+    travel 2.weeks
+    refute_stalled @card
+
+    @card.reopen
+    refute_stalled @card
+    travel 2.weeks
+    assert_stalled @card
+  end
+
+  test "activity restarts the inactivity clock" do
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks
+    assert_stalled @card
+
+    comment_as :david
+    refute_stalled @card
+    travel 2.weeks
+    assert_stalled @card
+
+    @card.update!(description: "More context")
+    refute_stalled @card
+    travel 2.weeks
+    assert_stalled @card
+
+    @card.steps.create!(content: "Follow up")
+    refute_stalled @card
+  end
+
+  test "two comments by different people are not enough" do
+    comment_as :david
+    comment_as :kevin
+    comment_as :system
+
+    travel 2.weeks
+    refute_stalled @card
+  end
+
+  test "backdated comments count in their chronological window" do
+    @card.board.auto_postpone_period_in_days = 3
+    comment_as :david
+    comment_as :david
+    @card.comments.create!(body: "A late import", creator: users(:kevin), created_at: 1.day.ago)
+
+    travel 2.weeks
+    assert_stalled @card
+  end
+
+  test "closed and postponed cards are not stalled" do
+    @card.toggle_assignment users(:kevin)
+    @card.close
+    travel 2.weeks
+    refute_stalled @card
+
+    @card.postpone
+    travel 2.weeks
+    refute_stalled @card
+  end
+
+  test "editing comments and removing reactions restart the inactivity clock" do
+    @card.toggle_assignment users(:kevin)
+    comment = comment_as :david
+    reaction = comment.reactions.create!(content: "👍")
+    travel 2.weeks
+    assert_stalled @card
+
+    comment.update!(body: "An edit")
+    refute_stalled @card
+    travel 2.weeks
+    assert_stalled @card
+
+    reaction.destroy!
+    refute_stalled @card
+  end
+
+  test "backfill uses historical comments and assignment events without resetting inactivity" do
+    assigned_card = cards(:buy_domain)
+    assigned_card.toggle_assignment users(:kevin)
+    assigned_card.toggle_assignment users(:kevin)
+    refute assigned_card.reload.assigned?
+    2.times { comment_as :david }
+    comment_as :kevin
+    [ @card, assigned_card ].each { |card| card.update_column(:activity_burst_at, nil) }
+
+    travel 2.weeks
+    Card.backfill_activity_bursts
+
+    assert_stalled @card
+    assert_stalled assigned_card
+  end
+
+  private
+    def comment_as(user)
+      @card.comments.create!(body: "My thoughts", creator: users(user))
+    end
+
+    def assert_stalled(card)
+      assert card.reload.stalled?
+      assert Card.stalled.exists?(card.id)
+    end
+
+    def refute_stalled(card)
+      refute card.reload.stalled?
+      refute Card.stalled.exists?(card.id)
+    end
+end
