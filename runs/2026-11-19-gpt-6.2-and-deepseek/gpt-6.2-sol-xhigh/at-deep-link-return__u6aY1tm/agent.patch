+  test "create returns to a same-origin deep link from the sign-in form" do
+    host! "writebook.example:8443"
+    https!
+    destination = leafable_slug_url(leaves(:welcome_page), q: "reading guide", anchor: "overview")
+
+    get new_session_path(return_to: destination)
+    assert_select 'input[type="hidden"][name="return_to"]', count: 1 do |fields|
+      assert_equal destination, fields.first["value"]
+    end
+
+    sign_in_with_return_to destination
+    assert_redirected_to destination
+    follow_redirect!
+    assert_response :success
+  end
+
+  test "create returns to a root-relative deep link" do
+    destination = leafable_slug_path(leaves(:welcome_page), q: "reading guide", anchor: "overview")
+
+    sign_in_with_return_to destination
+
+    assert_redirected_to destination
+  end
+
+  test "create falls back for an off-origin return destination" do
+    [ "https://elsewhere.invalid/page", "//elsewhere.invalid/page", book_slug_url(books(:handbook), port: 8443),
+      book_slug_url(books(:handbook), protocol: "https") ].each do |destination|
+      reset!
+      sign_in_with_return_to destination
+      assert_redirected_to root_path
+    end
+  end
+
+  test "create falls back for invalid return destinations" do
+    [ "", "  ", "page", "/bad\\path", "/bad\r\npath", "http://[invalid", [ "/" ], { path: "/" } ].each do |destination|
+      reset!
+      sign_in_with_return_to destination
+      assert_redirected_to root_path
+    end
+  end
+
   test "create with invalid credentials" do
