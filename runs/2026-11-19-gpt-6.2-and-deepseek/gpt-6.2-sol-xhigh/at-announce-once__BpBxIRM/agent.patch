diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..46e424f
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "announcement waits for the outer transaction to commit" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.transaction(requires_new: true) { @book.update! published: true }
+        @book.update! subtitle: "Second edition"
+
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ]
+  end
+
+  test "retrying publication after a savepoint rolls back announces only once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.transaction(requires_new: true) do
+          @book.update! published: true
+          raise ActiveRecord::Rollback
+        end
+
+        @book.reload.update! published: true
+      end
+    end
+  end
+
+  test "a book that returns to draft before commit is not announced" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        Book.find(@book.id).update! published: false
+      end
+    end
+
+    assert_not_predicate @book.reload, :published?
+  end
+end
