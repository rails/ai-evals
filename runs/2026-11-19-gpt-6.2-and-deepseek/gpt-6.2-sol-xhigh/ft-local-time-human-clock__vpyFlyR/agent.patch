diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..11722e1
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,18 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "timestamp markup is independent of the server timezone and clock" do
+    timestamp = Time.iso8601("2026-09-12T20:42:00Z")
+    markup = Time.use_zone("Pacific/Auckland") { local_datetime_tag(timestamp.in_time_zone) }
+
+    travel 3.days do
+      Time.use_zone("America/Los_Angeles") do
+        assert_equal markup, local_datetime_tag(timestamp.in_time_zone)
+      end
+    end
+
+    assert_dom Nokogiri::HTML.fragment(markup), 'time[datetime="2026-09-12T20:42:00Z"][data-controller="local-time"]' do |elements|
+      assert_empty elements.first.text
+    end
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..1326a99
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,51 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "comments render in the browser timezone and update after a morph" do
+    sign_in_as(users(:david))
+    browser = page.driver.browser
+    browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    script = browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: <<~JS)
+      const RealDate = Date
+      window.Date = class extends RealDate {
+        constructor(...args) { super(...(args.length ? args : ["2026-09-13T00:42:00Z"])) }
+      }
+    JS
+
+    comment = comments(:logo_agreement_kevin)
+    comment.update_column(:created_at, Time.iso8601("2026-09-12T20:42:00Z"))
+    card = comment.card
+    card.update_column(:last_active_at, Time.iso8601("2026-09-13T07:05:00Z") - card.auto_postpone_period)
+    visit card_path(card)
+    selector = "#comment_#{comment.id} .comment__permalink-title time"
+    assert_selector selector, exact_text: "1:42 PM"
+
+    countdown = "#closure_notice_card_#{card.id} time"
+    assert_selector countdown, exact_text: "tomorrow"
+
+    morph_timestamp selector, "2026-09-12T06:55:00Z"
+    assert_selector selector, exact_text: "yesterday"
+
+    morph_timestamp selector, "2026-09-07T20:42:00Z"
+    assert_selector selector, exact_text: "5 days ago"
+
+    morph_timestamp selector, "2026-08-31T20:42:00Z"
+    assert_selector selector, exact_text: "Aug 31"
+
+    morph_timestamp countdown, "2026-09-15T07:05:00Z"
+    assert_selector countdown, exact_text: "in 3 days"
+  ensure
+    browser&.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: script.fetch("identifier")) if script
+    browser&.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+  end
+
+  private
+    def morph_timestamp(selector, timestamp)
+      page.execute_script <<~JS, selector, timestamp
+        const time = document.querySelector(arguments[0])
+        const replacement = time.cloneNode(false)
+        replacement.dateTime = arguments[1]
+        Turbo.morphElements(time, replacement)
+      JS
+    end
+end
