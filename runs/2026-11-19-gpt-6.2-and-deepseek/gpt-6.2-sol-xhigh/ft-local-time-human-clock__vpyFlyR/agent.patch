diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..fdf7288
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,20 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/local_time_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+  }
+
+  render() {
+    if (!this.element.dateTime) return
+
+    const date = new Date(this.element.dateTime)
+    if (Number.isNaN(date.getTime())) return
+
+    this.element.textContent = formatLocalTime(date, this.formatValue)
+    if (this.formatValue !== "calendar") this.element.title = formatLocalTime(date, "full")
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..9567ba0
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,36 @@
+const formats = {
+  time: { hour: "numeric", minute: "2-digit" },
+  short: { month: "short", day: "numeric" },
+  date: { month: "short", day: "numeric", year: "numeric" },
+  full: { dateStyle: "long", timeStyle: "short" },
+  calendar: { weekday: "long", month: "long", day: "numeric", timeZone: "UTC" }
+}
+
+const formatters = new Map()
+const relativeDays = new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+
+export function formatLocalTime(date, format, now = new Date()) {
+  if (format === "relative" || format === "countdown") {
+    const days = calendarDay(date) - calendarDay(now)
+
+    if (days === 0) {
+      if (format === "countdown") return "today"
+      format = "time"
+    } else if (Math.abs(days) < 7 || (format === "countdown" && days > 0)) {
+      return relativeDays.format(days, "day")
+    } else {
+      format = date.getFullYear() === now.getFullYear() ? "short" : "date"
+    }
+  }
+
+  if (!formatters.has(format)) {
+    formatters.set(format, new Intl.DateTimeFormat("en-US", formats[format]))
+  }
+
+  return formatters.get(format).format(date)
+}
+
+function calendarDay(date) {
+  // Compare civil dates rather than elapsed hours, including across DST changes.
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) / 86_400_000
+}
