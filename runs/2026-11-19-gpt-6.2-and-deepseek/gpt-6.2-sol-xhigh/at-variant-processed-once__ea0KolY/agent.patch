diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..f9b21b6 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -76,6 +76,36 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
     assert_in_body "title: \"Reading\""
   end
 
+  test "show reuses the picture variant created by the background job" do
+    leaf = leaves(:reading_picture)
+    perform_enqueued_jobs(only: [ ActiveStorage::CreateVariantsJob, ActiveStorage::TransformJob ]) do
+      put leafable_path(leaf), params: { picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") } }
+      assert_response :no_content
+    end
+
+    blob = leaf.reload.picture.image.blob
+    derived_image = blob.variant_records.sole.image
+
+    books(:handbook).update!(published: true)
+    sign_out
+
+    transformations = 0
+    ActiveSupport::Notifications.subscribed(->(*) { transformations += 1 }, "transform.active_storage") do
+      get leafable_slug_path(leaf)
+      assert_response :success
+      assert_select "figure img", count: 1 do |images|
+        get URI.parse(images.first["src"]).request_uri
+      end
+      follow_redirect! while response.redirect?
+      assert_response :success
+    end
+
+    assert_equal "image/webp", response.media_type
+    assert_equal derived_image.download, response.body
+    assert_equal 1, blob.variant_records.count
+    assert_equal 0, transformations
+  end
+
   test "show a picture whose image cannot be resized" do
     leaves(:reading_picture).leafable.image.attach io: file_fixture("pixel.bmp").open,
       filename: "pixel.bmp", content_type: "image/bmp"
