+++ b/app/jobs/account/measure_storage_job.rb
@@ -0,0 +1,11 @@
+class Account::MeasureStorageJob < ApplicationJob
+  queue_as :backend
+  limits_concurrency key: ->(account_id) { account_id }, on_conflict: :discard
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::LockWaitTimeout
+
+  def perform(account_id)
+    if account = Account.find_by(id: account_id)
+      Account::StorageUsage.new(account).measure
+    end
+  end
+end
