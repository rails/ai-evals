diff --git a/app/models/account/storage_usage.rb b/app/models/account/storage_usage.rb
new file mode 100644
index 0000000..c8b2cc6
--- /dev/null
+++ b/app/models/account/storage_usage.rb
@@ -0,0 +1,89 @@
+class Account::StorageUsage
+  ATTACHMENT_BATCH_SIZE = 5_000
+  BOARD_BATCH_SIZE = 500
+  ATTACHMENT_TYPES = { "Card" => "image", "ActionText::RichText" => "embeds" }.freeze
+
+  def self.measure_all_later
+    accounts = ATTACHMENT_TYPES.reduce(Account.where.not(bytes_used: 0)) do |scope, (type, name)|
+      attachments = ActiveStorage::Attachment.where(record_type: type, name: name)
+        .where("active_storage_attachments.account_id = accounts.id")
+      scope.or(Account.where(attachments.arel.exists))
+    end
+
+    accounts.in_batches do |batch|
+      ActiveJob.perform_all_later batch.pluck(:id).map { |id| Account::MeasureStorageJob.new(id) }
+    end
+  end
+
+  def initialize(account)
+    @account = account
+  end
+
+  def measure
+    started_at = Time.current
+    totals = measure_boards
+    store(totals, started_at)
+  end
+
+  private
+    def measure_boards
+      totals = Hash.new(0)
+
+      # Bound the queries to attachment metadata, regardless of the size of each file
+      # or how many cards and comments do not have attachments.
+      ActiveStorage::Attachment.uncached do
+        ATTACHMENT_TYPES.each do |type, name|
+          attachments = ActiveStorage::Attachment.where(account_id: @account.id, record_type: type, name: name)
+          if last_id = attachments.maximum(:id)
+            attachments.in_batches(of: ATTACHMENT_BATCH_SIZE, finish: last_id, use_ranges: true) do |batch|
+              bytes_by_board(batch).each { |id, bytes| totals[id] += bytes }
+            end
+          end
+        end
+      end
+
+      totals
+    end
+
+    def bytes_by_board(attachments)
+      attachments.joins(:blob).joins(<<~SQL.squish).group("boards.id").sum("active_storage_blobs.byte_size")
+        LEFT JOIN action_text_rich_texts AS rich_text ON
+          active_storage_attachments.record_type = 'ActionText::RichText'
+          AND rich_text.id = active_storage_attachments.record_id
+          AND rich_text.account_id = active_storage_attachments.account_id
+        LEFT JOIN comments ON rich_text.record_type = 'Comment' AND rich_text.name = 'body'
+          AND comments.id = rich_text.record_id AND comments.account_id = active_storage_attachments.account_id
+        LEFT JOIN cards ON cards.id = CASE
+            WHEN active_storage_attachments.record_type = 'Card' THEN active_storage_attachments.record_id
+            WHEN rich_text.record_type = 'Card' AND rich_text.name = 'description' THEN rich_text.record_id
+            ELSE comments.card_id
+          END AND cards.account_id = active_storage_attachments.account_id
+        INNER JOIN boards ON boards.id = CASE
+            WHEN rich_text.record_type = 'Board' AND rich_text.name = 'public_description' THEN rich_text.record_id
+            ELSE cards.board_id
+          END AND boards.account_id = active_storage_attachments.account_id
+      SQL
+    end
+
+    def store(totals, started_at)
+      # Do not lock any account or board rows while measuring attachments. Only
+      # publish once the measurement is ready, and never overwrite a newer one.
+      Account.transaction do
+        updated = Account.where(id: @account.id).where("storage_measured_at IS NULL OR storage_measured_at < ?", started_at)
+          .update_all(bytes_used: totals.values.sum, storage_measured_at: started_at)
+        store_board_totals(totals) if updated == 1
+      end
+    end
+
+    def store_board_totals(totals)
+      previous_totals = @account.boards.where.not(bytes_used: 0).pluck(:id, :bytes_used).to_h
+      changed_ids = (previous_totals.keys | totals.keys).reject { |id| previous_totals.fetch(id, 0) == totals[id] }
+
+      changed_ids.each_slice(BOARD_BATCH_SIZE) do |ids|
+        board_id = Board.arel_table[:id]
+        bytes_used = Arel::Nodes::Case.new(board_id)
+        ids.each { |id| bytes_used.when(Arel::Nodes.build_quoted(id, board_id)).then(totals[id]) }
+        @account.boards.where(id: ids).update_all(bytes_used: bytes_used)
+      end
+    end
+end
