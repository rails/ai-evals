diff --git a/test/models/account/storage_usage_test.rb b/test/models/account/storage_usage_test.rb
new file mode 100644
index 0000000..e1700ef
--- /dev/null
+++ b/test/models/account/storage_usage_test.rb
@@ -0,0 +1,164 @@
+require "test_helper"
+
+class Account::StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    Current.account = @account
+    Current.user = users(:david)
+  end
+
+  test "reports the measured storage used by a board and its account" do
+    image = upload("image.jpg", "image/jpeg", file_fixture("moon.jpg").binread)
+    card_file = upload("card.txt", "text/plain", "card description")
+    board_file = upload("board.txt", "text/plain", "board description")
+    comment_file = upload("comment.txt", "text/plain", "comment body")
+    upload("unattached.txt", "text/plain", "unattached")
+
+    @card.image.attach(image)
+    @card.update!(description: embed(card_file))
+    @board.update!(public_description: embed(board_file))
+    @card.comments.create!(body: embed(comment_file))
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    perform_measurement
+
+    expected_bytes = [ image, card_file, board_file, comment_file ].sum(&:byte_size)
+    assert_equal expected_bytes, @board.reload.bytes_used
+    assert_equal expected_bytes, @account.reload.bytes_used
+  end
+
+  test "excludes avatars, variants, and other accounts' files" do
+    image = upload("image.jpg", "image/jpeg", file_fixture("moon.jpg").binread)
+    users(:david).avatar.attach(image)
+    assert image.variant_records.exists?
+    @card.image.attach(image)
+
+    other_account = accounts(:initech)
+    other_board = boards(:miltons_wish_list)
+    other_file = Current.with_account(other_account) { upload("other.txt", "text/plain", "another account's file") }
+    other_board.update!(public_description: embed(other_file))
+
+    perform_measurement
+    assert_equal image.byte_size, @board.reload.bytes_used
+    assert_equal image.byte_size, @account.reload.bytes_used
+    assert_equal 0, other_board.reload.bytes_used
+
+    Account::MeasureStorageJob.perform_now(other_account.id)
+    assert_equal other_file.byte_size, other_board.reload.bytes_used
+    assert_equal other_file.byte_size, other_account.reload.bytes_used
+  end
+
+  test "counts existing attachments across batches and boards using 64-bit totals" do
+    stub_const(Account::StorageUsage, :ATTACHMENT_BATCH_SIZE, 1) do
+      blob = ActiveStorage::Blob.create!(filename: "large.txt", byte_size: 5.gigabytes, checksum: "unused")
+      other_board = boards(:private)
+
+      # Bulk writes bypass model callbacks, as they do in an account import.
+      ActiveStorage::Attachment.insert_all! [ @card, cards(:layout), other_board.cards.create!(title: "Draft") ].map { |card|
+        { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, record_type: "Card", record_id: card.id, name: "image", blob_id: blob.id }
+      }
+
+      perform_measurement
+
+      assert_equal 10.gigabytes, @board.reload.bytes_used
+      assert_equal 5.gigabytes, other_board.reload.bytes_used
+      assert_equal 15.gigabytes, @account.reload.bytes_used
+    end
+  end
+
+  test "moves a card's image, description, and comment files to its new board" do
+    file = upload("shared.txt", "text/plain", "shared file")
+    @card.image.attach(file)
+    @card.update!(description: embed(file))
+    @card.comments.create!(body: embed(file))
+    perform_measurement
+
+    other_board = boards(:private)
+    @card.move_to(other_board)
+    perform_measurement
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 3 * file.byte_size, other_board.reload.bytes_used
+    assert_equal 3 * file.byte_size, @account.reload.bytes_used
+  end
+
+  test "removes usage when attachments and their owners are removed" do
+    image = upload("image.jpg", "image/jpeg", file_fixture("moon.jpg").binread)
+    @card.image.attach(image)
+    @board.update!(public_description: embed(upload("board.txt", "text/plain", "board file")))
+    @card.update!(description: embed(upload("card.txt", "text/plain", "card file")))
+    comment = @card.comments.create!(body: embed(upload("comment.txt", "text/plain", "comment file")))
+    perform_measurement
+
+    @card.image.purge_later
+    @board.update!(public_description: "")
+    @card.update!(description: nil)
+    comment.destroy!
+    perform_measurement
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "remeasures the account even after the last attachment is gone" do
+    @card.image.attach(upload("file.txt", "text/plain", "only attachment"))
+    assert_enqueued_with(job: Account::MeasureStorageJob, args: [ @account.id ]) do
+      Account::StorageUsage.measure_all_later
+    end
+    perform_enqueued_jobs(only: Account::MeasureStorageJob)
+    assert_operator @account.reload.bytes_used, :>, 0
+
+    @card.image.detach
+    assert_enqueued_jobs 1, only: Account::MeasureStorageJob do
+      Account::StorageUsage.measure_all_later
+    end
+    perform_enqueued_jobs(only: Account::MeasureStorageJob)
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+
+    assert_no_enqueued_jobs(only: Account::MeasureStorageJob) { Account::StorageUsage.measure_all_later }
+  end
+
+  test "replaces the measured size when a file is replaced" do
+    initial_file = upload("initial.txt", "text/plain", "initial file")
+    replacement = upload("replacement.txt", "text/plain", "a much longer file")
+    @board.update!(public_description: embed(initial_file))
+    perform_measurement
+    assert_equal initial_file.byte_size, @board.reload.bytes_used
+
+    @board.update!(public_description: embed(replacement))
+    perform_measurement
+    assert_equal replacement.byte_size, @board.reload.bytes_used
+    assert_equal replacement.byte_size, @account.reload.bytes_used
+  end
+
+  test "an older measurement cannot replace a newer measurement" do
+    file = upload("file.txt", "text/plain", "current file")
+    @card.image.attach(file)
+    perform_measurement
+    measured_at = @account.reload.storage_measured_at
+
+    @card.image.detach
+    travel_to(measured_at - 1.minute) { perform_measurement }
+
+    assert_equal file.byte_size, @account.reload.bytes_used
+    assert_equal file.byte_size, @board.reload.bytes_used
+  end
+
+  private
+    def perform_measurement
+      Account::MeasureStorageJob.perform_now(@account.id)
+    end
+
+    def upload(filename, content_type, content)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new(content), filename: filename, content_type: content_type)
+    end
+
+    def embed(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+end
