diff --git a/test/integration/book_absence_test.rb b/test/integration/book_absence_test.rb
index b9c20ac..742ca55 100644
--- a/test/integration/book_absence_test.rb
+++ b/test/integration/book_absence_test.rb
@@ -8,4 +8,35 @@ class BookAbsenceTest < ActionDispatch::IntegrationTest
       end
     end
   end
+
+  test "raises only inside the block after a normal request" do
+    path = book_slug_path(books(:manual))
+
+    get path
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_raises(ActiveRecord::RecordNotFound) { get path }
+    end
+
+    get path
+    assert_response :not_found
+  end
+
+  test "restores exception rendering after errors escape nested blocks" do
+    path = book_slug_path(books(:manual))
+
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions do
+        assert_raises ActiveRecord::RecordNotFound do
+          with_raised_exceptions { get path }
+        end
+
+        get path
+      end
+    end
+
+    get path
+    assert_response :not_found
+  end
 end
