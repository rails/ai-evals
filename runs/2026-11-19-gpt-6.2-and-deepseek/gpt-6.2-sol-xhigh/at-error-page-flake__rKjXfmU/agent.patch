index 0000000..ec896e0
--- /dev/null
+++ b/test/test_helpers/raised_exceptions_test_helper.rb
@@ -0,0 +1,21 @@
+module RaisedExceptionsTestHelper
+  def with_raised_exceptions
+    previous = Thread.current[:writebook_test_raise_exceptions]
+    Thread.current[:writebook_test_raise_exceptions] = true
+    yield
+  ensure
+    Thread.current[:writebook_test_raise_exceptions] = previous
+  end
+
+  class Middleware
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      # Rails has already merged its cached defaults into this request's env.
+      env["action_dispatch.show_exceptions"] = :none if Thread.current[:writebook_test_raise_exceptions]
+      @app.call(env)
+    end
+  end
+end
