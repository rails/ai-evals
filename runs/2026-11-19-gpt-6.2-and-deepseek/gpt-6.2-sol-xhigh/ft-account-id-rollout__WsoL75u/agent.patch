diff --git a/test/models/account/ownership_test.rb b/test/models/account/ownership_test.rb
new file mode 100644
index 0000000..27486e8
--- /dev/null
+++ b/test/models/account/ownership_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Account::OwnershipTest < ActiveSupport::TestCase
+  test "search history is saved under the user's account, not the current account" do
+    user = users(:mike)
+
+    assert_not_equal Current.account, user.account
+    assert_equal user.account_id, user.remember_search("release notes").reload.account_id
+  end
+
+  test "filter links inherit the filter's account" do
+    user = users(:mike)
+    board = boards(:miltons_wish_list)
+    filter = user.filters.create!(boards: [ board ], assignees: [ user ])
+
+    assert_equal [ user.account_id ], filter.board_links.pluck(:account_id)
+    assert_equal [ user.account_id ], filter.assignee_links.pluck(:account_id)
+    assert_includes board.filters, filter
+  end
+
+  test "rich text, attachments and variants inherit the owning record's account" do
+    card = cards(:radio)
+    assert_not_equal Current.account, card.account
+
+    card.update!(description: "New description")
+    card.image.attach(io: StringIO.new("test"), filename: "test.txt")
+    blob = card.image.blob
+    variant = blob.variant_records.create!(variation_digest: "test")
+    variant.image.attach(io: StringIO.new("variant"), filename: "variant.txt")
+
+    [ card.rich_text_description, card.image.attachment, blob, variant, variant.image.attachment, variant.image.blob ].each do |record|
+      assert_equal card.account_id, record.reload.account_id
+    end
+  end
+
+  test "identity avatar storage stays global even in a tenant context" do
+    identity = identities(:david)
+    identity.avatar.attach(io: StringIO.new("avatar"), filename: "avatar.txt")
+
+    assert_nil identity.avatar.attachment.reload.account_id
+    assert_nil identity.avatar.blob.reload.account_id
+  end
+end
