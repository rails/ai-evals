diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..c0a7614
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,105 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :no_store
+  before_action :set_magic_link
+  before_action :ensure_signups_are_allowed
+
+  layout "public"
+  helper_method :restart_path
+
+  def show
+  end
+
+  def create
+    if @magic_link.consume(params[:code])
+      cookies.delete(:pending_authentication_token)
+      complete_authentication
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def set_magic_link
+      unless @magic_link = MagicLink.find_by_token(cookies[:pending_authentication_token])
+        authentication_failed "That code expired or was already used. Request a new one."
+      end
+    end
+
+    def ensure_signups_are_allowed
+      if @magic_link.sign_up? && !Account.accepting_signups?
+        authentication_failed "Signups aren't available right now.", status: :forbidden
+      end
+    end
+
+    def complete_authentication
+      case @magic_link.purpose
+      when "sign_in"
+        if identity = Identity.find_by(email_address: @magic_link.email_address)
+          sign_in(identity) { after_authentication_url }
+        else
+          authentication_failed "That code didn't work. Request a new one."
+        end
+      when "sign_up"
+        identity = Signup.new(email_address: @magic_link.email_address).create_identity
+        sign_in(identity) { new_signup_completion_url }
+      when "join"
+        if user = @magic_link.redeem_join_code
+          sign_in(user.identity) { after_joining_url(user) }
+        else
+          authentication_failed "That join code is no longer available. Ask for a new invitation.", status: :gone
+        end
+      end
+    end
+
+    def sign_in(identity)
+      if Current.identity != identity
+        terminate_session if Current.session
+        start_new_session_for identity
+      end
+
+      respond_to do |format|
+        format.html { redirect_to yield, status: :see_other }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work. Check your email or request a new code."
+
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = message
+          render :show, status: :unprocessable_entity
+        end
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: "Try again later.", status: :see_other }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+
+    def authentication_failed(message, status: :unauthorized)
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: message, status: :see_other }
+        format.json { render json: { message: message }, status: status }
+      end
+    end
+
+    def restart_path
+      if @magic_link.sign_up?
+        new_signup_path
+      elsif @magic_link.join? && @magic_link.account
+        join_path(code: @magic_link.invite_code, script_name: @magic_link.account.slug)
+      else
+        new_session_path
+      end
+    end
+end
