diff --git a/app/views/sessions/magic_links/show.html.erb b/app/views/sessions/magic_links/show.html.erb
new file mode 100644
index 0000000..66967fe
--- /dev/null
+++ b/app/views/sessions/magic_links/show.html.erb
@@ -0,0 +1,24 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+
+  <p>Enter the six-character code for <strong><%= @magic_link.email_address %></strong>. It expires in 15 minutes.</p>
+
+  <%= form_with url: session_magic_link_path, method: :post, class: "flex flex-column align-center gap" do |form| %>
+    <%= form.label :code, "Verification code", class: "for-screen-reader" %>
+    <%= form.text_field :code, class: "input", autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false,
+          autofocus: true, required: true, minlength: MagicLink::CODE_LENGTH, maxlength: MagicLink::CODE_LENGTH %>
+
+    <button type="submit" class="btn btn--link center">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p><%= link_to "Use a different email or request a new code", restart_path, class: "txt-small" %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
