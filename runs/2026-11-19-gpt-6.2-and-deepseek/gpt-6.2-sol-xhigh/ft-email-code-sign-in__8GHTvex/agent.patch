diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..3f9740d
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,68 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_CHARACTERS = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ".chars.freeze
+  EXPIRATION = 15.minutes
+  MAX_ATTEMPTS = 5
+  TOKEN_PURPOSE = :email_authentication
+
+  belongs_to :account, optional: true
+
+  enum :purpose, %w[ sign_in sign_up join ].index_by(&:itself), scopes: false
+
+  def self.issue(email_address:, purpose:, join_code: nil)
+    if purpose != :sign_in || Identity.exists?(email_address: email_address)
+      code = SecureRandom.alphanumeric(CODE_LENGTH, chars: CODE_CHARACTERS)
+    end
+
+    create!(email_address: email_address, purpose: purpose, code_digest: code && digest_code(code),
+      account_id: join_code&.account_id, invite_code: join_code&.code).tap do |link|
+      MagicLinkMailer.sign_in_code(email_address: email_address, code: code).deliver_later if code
+    end
+  end
+
+  def self.find_by_token(token)
+    find_signed(token, purpose: TOKEN_PURPOSE)
+  end
+
+  def self.cleanup
+    where(created_at: ..1.hour.ago).delete_all
+  end
+
+  def self.digest_code(code)
+    key = Rails.application.key_generator.generate_key("magic_link_code")
+    OpenSSL::HMAC.hexdigest("SHA256", key, code)
+  end
+
+  def token
+    signed_id(purpose: TOKEN_PURPOSE, expires_at: expires_at)
+  end
+
+  def expires_at
+    created_at + EXPIRATION
+  end
+
+  def consume(code)
+    with_lock do
+      if code_digest.present? && attempts < MAX_ATTEMPTS && Time.current < expires_at
+        if matches_code?(code)
+          update!(code_digest: nil)
+          true
+        else
+          increment!(:attempts)
+          false
+        end
+      end
+    end
+  end
+
+  def redeem_join_code
+    if join_code = Account::JoinCode.find_by(account_id: account_id, code: invite_code)
+      join_code.redeem(code: invite_code) { Identity.find_or_create_by!(email_address: email_address) }
+    end
+  end
+
+  private
+    def matches_code?(code)
+      code.is_a?(String) && ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.digest_code(code.strip.upcase))
+    end
+end
