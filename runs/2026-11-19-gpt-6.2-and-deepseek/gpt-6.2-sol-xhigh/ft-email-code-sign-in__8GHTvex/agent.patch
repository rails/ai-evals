+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,182 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "signs in with the six-character code from the email subject" do
+    untenanted do
+      code = request_sign_in_code(email_address: " #{@identity.email_address.upcase} ")
+      assert_not cookies[:session_token].present?
+
+      follow_redirect!
+      assert_response :success
+      assert_select "form[action=?] input[name=code][autocomplete=one-time-code]", session_magic_link_path
+
+      assert_difference -> { @identity.sessions.count }, 1 do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "returns to the requested page after signing in" do
+    destination = board_url(boards(:writebook), script_name: accounts(:"37s").slug)
+    get destination
+
+    untenanted do
+      code = request_sign_in_code
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to destination
+    end
+  end
+
+  test "a wrong code can be retried" do
+    untenanted do
+      code = request_sign_in_code
+      post session_magic_link_path, params: { code: "000000" }
+
+      assert_response :unprocessable_entity
+      assert_select ".flash__inner", text: /That code didn't work/
+      assert_not cookies[:session_token].present?
+
+      post session_magic_link_path, params: { code: " #{code.downcase} " }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "cannot retry indefinitely" do
+    untenanted do
+      code = request_sign_in_code
+
+      MagicLink::MAX_ATTEMPTS.times do
+        post session_magic_link_path, params: { code: "000000" }
+        assert_response :unprocessable_entity
+      end
+
+      post session_magic_link_path, params: { code: code }
+
+      assert_response :unprocessable_entity
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "a code is valid just before it expires" do
+    freeze_time
+
+    untenanted do
+      code = request_sign_in_code
+
+      travel 14.minutes + 59.seconds do
+        post session_magic_link_path, params: { code: code }
+
+        assert_redirected_to landing_path
+        assert cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "a code expires after fifteen minutes even if the cookie is sent" do
+    freeze_time
+
+    untenanted do
+      code = request_sign_in_code
+      token = cookies[:pending_authentication_token]
+
+      travel 15.minutes do
+        cookies[:pending_authentication_token] = token
+        post session_magic_link_path, params: { code: code }, as: :json
+
+        assert_response :unauthorized
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "API verification requires the pending token and a code can be used only once" do
+    untenanted do
+      code = request_sign_in_code(as: :json)
+      assert_response :created
+      token = response.parsed_body.fetch("pending_authentication_token")
+      assert_equal cookies[:pending_authentication_token], token
+
+      cookies.delete("pending_authentication_token")
+      post session_magic_link_path, params: { code: code }, as: :json
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+
+      cookies[:pending_authentication_token] = token
+      post session_magic_link_path, params: { code: code }, as: :json
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body.fetch("session_token")
+
+      sign_out
+      cookies[:pending_authentication_token] = token
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: code }, as: :json
+      end
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "confirmation screen does not disclose whether an email is registered" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        assert_no_enqueued_emails do
+          post session_path, params: { email_address: "unknown@example.com" }
+        end
+      end
+
+      assert_redirected_to session_magic_link_path
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code]"
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "invalid email addresses do not receive codes" do
+    untenanted do
+      assert_no_enqueued_emails do
+        post session_path, params: { email_address: "not-an-email" }, as: :json
+      end
+
+      assert_response :unprocessable_entity
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "verification is rate limited" do
+    untenanted do
+      code = request_sign_in_code
+      Rails.cache.stubs(:increment).returns(11)
+
+      post session_magic_link_path, params: { code: code }, as: :json
+
+      assert_response :too_many_requests
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  private
+    def request_sign_in_code(email_address: @identity.email_address, **kwargs)
+      emails = capture_emails do
+        post session_path, params: { email_address: email_address }, **kwargs
+      end
+
+      assert_equal 1, emails.size
+      assert_equal [ @identity.email_address ], emails.first.to
+      assert_match(/\A[A-Z0-9]{6}\b/, emails.first.subject)
+      emails.first.subject.split.first
+    end
+end
