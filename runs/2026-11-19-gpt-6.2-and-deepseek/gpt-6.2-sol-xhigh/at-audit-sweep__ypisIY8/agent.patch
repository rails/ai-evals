diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..c6b8f92
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  test "search only returns active leaves from books the searcher can read" do
+    handbook_page = leaves(:welcome_page)
+    manual_page = leaves(:summary_page)
+    manual_page.update!(book: books(:manual), title: "The Handbook Summary")
+    leaves(:welcome_section).update!(title: "The Handbook Introduction", status: :trashed)
+    accesses(:kevin_handbook).update!(level: :reader)
+    sign_in :kevin
+
+    assert_search_results " the handbook ", handbook_page
+
+    books(:manual).update!(published: true)
+    assert_search_results " the handbook ", handbook_page, manual_page
+
+    sign_out
+    assert_search_results " the handbook ", manual_page
+  end
+
+  test "search treats apostrophes and the escape character as ordinary punctuation" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: "The Reader's Guide!")
+    sign_in :kevin
+
+    assert_search_results "Reader's", leaf
+    assert_search_results "!", leaf
+  end
+
+  test "search treats percent and underscore as literal characters" do
+    offer = leaves(:welcome_page)
+    filename = leaves(:summary_page)
+    offer.update!(title: "Save 50% off")
+    filename.update!(title: "File_name")
+    sign_in :kevin
+
+    assert_search_results "Save 50% off", offer
+    assert_search_results "%", offer
+    assert_search_results "_", filename
+  end
+
+  test "search returns no results without readable books" do
+    assert_search_results "handbook"
+    assert_in_body "No matches."
+  end
+
+  test "blank search does not list any pages" do
+    sign_in :kevin
+
+    assert_search_results " "
+    assert_not_in_body "No matches."
+  end
+
+  private
+    def assert_search_results(query, *leaves)
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "a.search__result", count: leaves.size
+      leaves.each do |leaf|
+        assert_select "a.search__result[href=?]", leafable_slug_path(leaf), count: 1
+      end
+    end
+end
