diff --git a/test/controllers/book_contents_cache_test.rb b/test/controllers/book_contents_cache_test.rb
new file mode 100644
index 0000000..12993ba
--- /dev/null
+++ b/test/controllers/book_contents_cache_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class BookContentsCacheTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_store = BooksController.cache_store
+    @previous_collection_store = ActionView::PartialRenderer.collection_cache
+    @previous_setting = BooksController.perform_caching
+    BooksController.cache_store = ActiveSupport::Cache::MemoryStore.new
+    ActionView::PartialRenderer.collection_cache = BooksController.cache_store
+    BooksController.perform_caching = true
+  end
+
+  teardown do
+    BooksController.cache_store = @previous_store
+    ActionView::PartialRenderer.collection_cache = @previous_collection_store
+    BooksController.perform_caching = @previous_setting
+  end
+
+  test "reader after editor receives only reading links" do
+    open_handbook_as :kevin, editable: true
+    open_handbook_as :jz, editable: false
+  end
+
+  test "editor after reader receives edit controls" do
+    open_handbook_as :jz, editable: false
+    open_handbook_as :kevin, editable: true
+  end
+
+  test "renaming an entry refreshes both cached versions" do
+    open_handbook_as :kevin, editable: true
+    open_handbook_as :jz, editable: false
+
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: "Renamed welcome page")
+
+    { kevin: true, jz: false }.each do |user, editable|
+      open_handbook_as user, editable: editable
+      assert_select "#leaf_#{leaf.id} .toc__title", text: "Renamed welcome page", count: editable ? 2 : 1
+    end
+  end
+
+  private
+    def open_handbook_as(user, editable:)
+      sign_in user
+      get book_slug_path(books(:handbook))
+
+      assert_response :success
+      assert_select "#leaves .toc__leaf" do |entries|
+        entries.each do |entry|
+          count = editable ? 1 : 0
+          assert_select entry, "a.toc__link.hide_from_reading_mode", count: count
+          assert_select entry, "a.toc__title.hide_from_reading_mode", count: count
+          assert_select entry, "form.leaf__delete", count: count
+          assert_select entry, ".arrangement__handle", count: count
+          assert_select entry, "a.toc__link:not(.hide_from_reading_mode)", count: 1
+        end
+      end
+    end
+end
