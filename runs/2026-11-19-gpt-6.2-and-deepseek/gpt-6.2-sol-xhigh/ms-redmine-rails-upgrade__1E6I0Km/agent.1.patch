+  rails-upgrade:
+    name: Rails upgrade and rollback (SQLite, Ruby 3.2)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: ./.github/actions/setup-redmine
+        with:
+          db-type: sqlite3
+          ruby-version: '3.2.9'
+      - name: Install the Rails 7 bundle
+        run: BUNDLE_GEMFILE=Gemfile.next bundle install
+      - name: Check both upgrade directions
+        env:
+          RAILS_ENV: test
+        run: |
+          BUNDLE_GEMFILE=Gemfile bin/rails runner bin/check-upgrade-compatibility write > "$RUNNER_TEMP/rails61.json"
+          BUNDLE_GEMFILE=Gemfile.next bin/rails runner bin/check-upgrade-compatibility read < "$RUNNER_TEMP/rails61.json"
+          BUNDLE_GEMFILE=Gemfile.next bin/rails runner bin/check-upgrade-compatibility write > "$RUNNER_TEMP/rails70.json"
+          BUNDLE_GEMFILE=Gemfile bin/rails runner bin/check-upgrade-compatibility read < "$RUNNER_TEMP/rails70.json"
+      - name: Run tests with Rails 7
+        env:
+          BUNDLE_GEMFILE: Gemfile.next
+        run: bin/rails test
+
   system-tests:
     name: system test
     runs-on: ubuntu-latest
