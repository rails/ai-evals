diff --git a/bin/check-upgrade-compatibility b/bin/check-upgrade-compatibility
new file mode 100644
index 0000000..900329b
--- /dev/null
+++ b/bin/check-upgrade-compatibility
@@ -0,0 +1,42 @@
+#!/usr/bin/env ruby
+# frozen_string_literal: true
+
+# Run with bin/rails runner; pipe write output into read on the other release.
+require 'json'
+
+name = Rails.application.config.session_options.fetch(:key)
+payload = {'session_id' => 'upgrade-check', 'user_id' => 42, 'tk' => 'session-token'}
+request = ActionDispatch::Request.new(Rails.application.env_config.merge('HTTP_HOST' => 'localhost'))
+case ARGV.fetch(0)
+when 'write'
+  app = Rails.application
+  digest = Rails::VERSION::MAJOR >= 7 ? 'SHA256' : 'SHA1'
+  expected_key = OpenSSL::PKCS5.pbkdf2_hmac(app.secret_key_base, 'mail_links', 1000, 64, digest)
+  abort 'Unexpected primary key derivation' unless app.key_generator.generate_key('mail_links') == expected_key
+
+  request.cookie_jar.encrypted[name] = {value: payload}
+  request.cookie_jar.signed[:upgrade_check] = 42
+  puts JSON.generate([
+    request.cookie_jar[name], request.cookie_jar[:upgrade_check],
+    Mailer.mail_link_token(:unwatch, payload),
+    app.message_verifier(:mail_links).generate(payload, purpose: :unwatch, expires_at: 1.minute.ago)
+  ])
+when 'read'
+  encrypted, signed, token, expired = JSON.parse($stdin.read)
+  jar = ActionDispatch::Cookies::CookieJar.build(request, name => encrypted, 'upgrade_check' => signed)
+  abort 'Session did not survive' unless jar.encrypted[name] == payload
+  abort 'Signed cookie did not survive' unless jar.signed[:upgrade_check] == 42
+  abort 'Mail link did not survive' unless Mailer.verify_mail_link(token, :unwatch) == payload
+  tampered = ActionDispatch::Cookies::CookieJar.build(request, name => encrypted + 'invalid')
+  abort 'Accepted invalid session cookie' if tampered.encrypted[name]
+  [[:other, token], [:unwatch, token + 'invalid'], [:unwatch, expired]].each do |purpose, value|
+    begin
+      Mailer.verify_mail_link(value, purpose)
+      abort 'Accepted invalid mail link'
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      # Expected.
+    end
+  end
+else
+  abort 'Expected write or read'
+end
