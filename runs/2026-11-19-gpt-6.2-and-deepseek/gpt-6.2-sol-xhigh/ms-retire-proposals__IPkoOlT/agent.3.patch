+    @entries = {}
+    @targets = {}
+    execute "CREATE TEMP TABLE #{SOURCE} (kind text NOT NULL, id bigint NOT NULL) ON COMMIT DROP"
+    execute "CREATE TEMP TABLE #{PLAN} (kind text, id bigint, PRIMARY KEY (kind, id)) ON COMMIT DROP"
+    archive = CitizenProposalCleanupArchive.new(connection, @schema, version)
+    archive.load_source_ids(SOURCE)
+
+    plan_communities_and_maps
+    plan_polls
+    plan_comments
+    plan_references
+    plan_storage
+    plan_jobs
+    plan_counters
+    check_database_side_effects
