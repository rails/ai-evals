+                     Dashboard::ExecutedAction Dashboard::AdministratorTask].freeze
+  RETIRED_SETTINGS = %w[
+    feature.dashboard.notification_emails feature.featured_proposals
+    feature.user.recommendations_on_proposals featured_proposals_number
+    homepage.widgets.feeds.proposals months_to_archive_proposals process.proposals
+    proposal_notification_minimum_interval_in_days proposals.email_description proposals.email_short_title
+    proposals.poll_description proposals.poll_link proposals.poll_short_title proposals.poster_description
+    proposals.poster_short_title proposals.successful_proposal_id
+    sdg.process.proposals votes_for_proposal_success
+  ].freeze
+  RETIRED_ML_SCRIPTS = %w[proposals_related_content_and_tags_nmf.py
+                          proposals_summary_comments_textrank.py].freeze
