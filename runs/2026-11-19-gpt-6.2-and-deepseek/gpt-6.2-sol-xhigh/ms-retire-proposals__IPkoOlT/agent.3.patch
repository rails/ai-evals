+  REFERENCES = {
+    "activities" => %w[actionable],
+    "flags" => %w[flaggable],
+    "follows" => %w[followable],
+    "links" => %w[linkable],
+    "ml_summary_comments" => %w[commentable],
+    "notifications" => %w[notifiable],
+    "reports" => %w[process],
+    "sdg_relations" => %w[relatable related_sdg],
+    "sdg_reviews" => %w[relatable],
+    "taggings" => %w[taggable tagger],
+    "votes" => %w[votable voter],
+    "votation_types" => %w[questionable]
+  }.freeze
+  STORAGE = %w[active_storage_attachments active_storage_variant_records active_storage_blobs].freeze
+  COMMENT_COUNTERS = {
+    "Debate" => "debates",
+    "Budget::Investment" => "budget_investments",
+    "Legislation::Proposal" => "legislation_proposals",
+    "Legislation::Annotation" => "legislation_annotations",
+    "Legislation::Question" => "legislation_questions",
+    "Poll" => "polls",
+    "Poll::Question" => "poll_questions",
