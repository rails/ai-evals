+
+    # Archive a single snapshot without blocking shared-table writers. PostgreSQL rejects
+    # updates/deletes if those rows have changed since the snapshot was taken.
+    execute "SET TRANSACTION ISOLATION LEVEL REPEATABLE READ"
+    execute "SET LOCAL lock_timeout = '250ms'"
+    execute "SET LOCAL statement_timeout = '60s'"
+    execute "SET LOCAL row_security = off"
+    execute "SET LOCAL DateStyle = 'ISO'"
