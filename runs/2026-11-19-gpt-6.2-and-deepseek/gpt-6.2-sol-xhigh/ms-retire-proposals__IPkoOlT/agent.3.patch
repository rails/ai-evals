+    def plan_polls
+      # A budget-owned poll is not disposable, even if it also had a citizen proposal link.
+      budget_history = <<~SQL
+        EXISTS (SELECT 1 FROM #{table("poll_ballot_sheets")} s
+          JOIN #{table("poll_ballots")} p ON p.ballot_sheet_id = s.id
+          JOIN #{table("budget_ballots")} b ON b.poll_ballot_id = p.id WHERE s.poll_id = t.id)
