+      unlink "polls", retired("related"), "related_type", "related_id"
+      children "poll_translations", "poll_id" => "polls"
+      children "geozones_polls", "poll_id" => "polls"
+      children "poll_questions", "poll_id" => "polls"
+      target "Poll::Question", "poll_questions"
+      children "poll_question_translations", "poll_question_id" => "poll_questions"
+      children "poll_question_answers", "question_id" => "poll_questions"
+      target "Poll::Question::Option", "poll_question_answers"
+      children "poll_question_answer_translations", "poll_question_answer_id" => "poll_question_answers"
+      children "poll_question_answer_videos", "answer_id" => "poll_question_answers"
+      children "poll_booth_assignments", "poll_id" => "polls"
+      children "poll_officer_assignments", "booth_assignment_id" => "poll_booth_assignments"
+      poll_children "poll_answers", { "question_id" => "poll_questions" },
+                    "option_id" => "poll_question_answers"
+      poll_children "poll_partial_results", { "question_id" => "poll_questions" },
+                    "option_id" => "poll_question_answers", "booth_assignment_id" => "poll_booth_assignments",
+                    "officer_assignment_id" => "poll_officer_assignments"
+      poll_children "poll_recounts", { "booth_assignment_id" => "poll_booth_assignments" },
+                    "officer_assignment_id" => "poll_officer_assignments"
+      poll_children "poll_voters", { "poll_id" => "polls" },
+                    "booth_assignment_id" => "poll_booth_assignments",
+                    "officer_assignment_id" => "poll_officer_assignments"
+      poll_children "poll_ballot_sheets", { "poll_id" => "polls" },
+                    "officer_assignment_id" => "poll_officer_assignments"
+      children "poll_ballots", "ballot_sheet_id" => "poll_ballot_sheets"
