diff --git a/app/jobs/broadcast_being_edited_job.rb b/app/jobs/broadcast_being_edited_job.rb
new file mode 100644
index 0000000..0cfb8fe
--- /dev/null
+++ b/app/jobs/broadcast_being_edited_job.rb
@@ -0,0 +1,12 @@
+class BroadcastBeingEditedJob < ApplicationJob
+  def perform(leaf, user)
+    content = ApplicationController.render partial: "leaves/being_edited_by", formats: [ :turbo_stream ],
+      locals: { leaf: leaf, user: user }
+
+    # Check access when delivering, not when the save queues this job. An old
+    # editor tab can stay subscribed, but its stream must stop receiving updates.
+    leaf.book.active_editors.find_each do |editor|
+      Turbo::StreamsChannel.broadcast_stream_to leaf, :being_edited, editor, content: content
+    end
+  end
+end
