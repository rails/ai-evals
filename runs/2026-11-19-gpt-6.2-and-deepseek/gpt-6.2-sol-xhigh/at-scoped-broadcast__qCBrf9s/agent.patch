+  test "an open editor stops receiving presence after losing edit access" do
+    leaf = leaves(:welcome_page)
+    get edit_leafable_path(leaf)
+    assert_response :ok
+    source = assert_select("turbo-cable-stream-source").sole
+    stale_stream = Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    assert stale_stream.present?
+
+    sign_in :jason
+    get edit_leafable_path(leaf)
+    assert_response :ok
+    source = assert_select("turbo-cable-stream-source").sole
+    remaining_stream = Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    assert remaining_stream.present?
+    assert_not_equal stale_stream, remaining_stream
+
+    sign_in :david
+    put leafable_path(leaf), params: { page: { body: "Updated" } }
+    assert_response :no_content
+    accesses(:kevin_handbook).destroy!
+
+    assert_no_turbo_stream_broadcasts stale_stream do
+      perform_enqueued_jobs
+    end
+    update = capture_turbo_stream_broadcasts(remaining_stream).sole
+    assert_equal "append", update["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(leaf, :being_edited), update["target"]
+    assert_includes update.inner_html, users(:david).name
+  end
+
   private
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
