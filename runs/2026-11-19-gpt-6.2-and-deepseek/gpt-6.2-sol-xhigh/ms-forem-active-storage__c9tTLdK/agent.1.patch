+require "rails_helper"
+require "active_storage/service/forem_s3_service"
+
+RSpec.describe ActiveStorage::Service::ForemS3Service do
+  let(:bucket) { "profile-images" }
+  let(:credentials) { { aws_access_key_id: "test", aws_secret_access_key: "test" } }
+  let(:storage) { Fog::Storage.new(provider: "AWS", **credentials) }
+  let(:service) { described_class.new(bucket: bucket, **credentials) }
+
+  around do |example|
+    Fog.mock!
+    example.run
+  ensure
+    Fog.unmock!
+  end
+
+  before { storage.put_bucket(bucket) }
+
+  it "uploads and serves objects without requiring public bucket access", :aggregate_failures do
+    data = "some image bytes".b
+    service.upload("image", StringIO.new(data), checksum: Digest::MD5.base64digest(data), content_type: "image/png")
+
+    expect(service).to exist("image")
+    expect(service.download("image")).to eq(data)
+    expect(service.download_chunk("image", 5..9)).to eq("image")
+    expect { |chunk| service.download("image", &chunk) }.to yield_with_args(data)
+
+    service.delete("image")
+    expect { service.download("image") }.to raise_error(ActiveStorage::FileNotFoundError)
+  end
+
+  it "deletes only the objects under the given prefix", :aggregate_failures do
+    service.upload("image", StringIO.new("original"))
+    service.upload("variants/image/thumbnail", StringIO.new("thumbnail"))
+
+    service.delete_prefixed("variants/image/")
+
+    expect(service).to exist("image")
+    expect(service).not_to exist("variants/image/thumbnail")
+    service.delete("image")
+  end
+end
