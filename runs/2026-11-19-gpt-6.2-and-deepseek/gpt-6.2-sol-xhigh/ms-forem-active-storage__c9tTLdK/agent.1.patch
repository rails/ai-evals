diff --git a/app/uploaders/profile_image_staging_uploader.rb b/app/uploaders/profile_image_staging_uploader.rb
new file mode 100644
index 0000000..5ed633a
--- /dev/null
+++ b/app/uploaders/profile_image_staging_uploader.rb
@@ -0,0 +1,17 @@
+# Reuse the existing image processing, validation and safe remote download logic,
+# but never store these uploads in CarrierWave. The temporary copy is local only.
+class ProfileImageStagingUploader < ProfileImageUploader
+  cache_storage :file
+
+  def self.prepare
+    Dir.mktmpdir("forem-profile-image") do |directory|
+      uploader = new
+      uploader.cache_dir = directory
+      yield uploader
+      next unless uploader.file
+
+      filename = "#{SecureRandom.uuid}.#{uploader.file.extension}"
+      { io: StringIO.new(uploader.file.read), filename: filename }
+    end
+  end
+end
