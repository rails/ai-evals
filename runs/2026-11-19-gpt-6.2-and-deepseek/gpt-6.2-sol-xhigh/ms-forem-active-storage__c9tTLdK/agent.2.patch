diff --git a/spec/tasks/profile_images_spec.rb b/spec/tasks/profile_images_spec.rb
new file mode 100644
index 0000000..1400c3e
--- /dev/null
+++ b/spec/tasks/profile_images_spec.rb
@@ -0,0 +1,123 @@
+require "rails_helper"
+
+RSpec.describe "profile_images:copy", type: :task do
+  let(:task) { Rake::Task["profile_images:copy"] }
+  let(:image_path) { Rails.root.join("app/assets/images/1.png") }
+  let(:legacy_uploads) { [] }
+
+  before { task.reenable }
+  after { legacy_uploads.each(&:remove!) }
+
+  def store_legacy_image(owner)
+    uploader = ProfileImageUploader.new(owner, :profile_image)
+    image_path.open { |file| uploader.store!(file) }
+    legacy_uploads << uploader
+    owner.update_column(:profile_image, uploader.identifier)
+    uploader
+  end
+
+  it "skips users without uploads and never replaces an existing Active Storage image", :aggregate_failures do
+    blank_user = create(:user, profile_image: nil)
+    organization = create(:organization)
+    store_legacy_image(organization)
+    live_image = organization.profile_image_url
+    user = create(:user, profile_image: nil)
+    store_legacy_image(user)
+
+    expect { task.invoke }.to change(ActiveStorage::Blob, :count).by(1)
+    copied_image = user.reload.profile_image_url
+    task.reenable
+    expect { task.invoke }.not_to change(ActiveStorage::Blob, :count)
+
+    expect(user.reload.profile_image_url).to eq(copied_image)
+    expect(organization.reload.profile_image_url).to eq(live_image)
+    expect(blank_user.reload.profile_image_upload).not_to be_attached
+  end
+
+  it "copies other pictures despite missing files and retries after they are restored", :aggregate_failures do
+    missing = create(:user, profile_image: nil)
+    legacy = store_legacy_image(missing)
+    legacy.remove!
+    legacy_url = missing.reload.profile_image_url
+    available = create(:user, profile_image: nil)
+    store_legacy_image(available)
+
+    expect do
+      expect { task.invoke }.to raise_error(SystemExit) { |error| expect(error.status).to eq(1) }
+    end.to output(%r{User #{missing.id}: Errno::ENOENT.*rerun bin/rails profile_images:copy}m).to_stderr
+
+    expect(missing.reload.profile_image_url).to eq(legacy_url)
+    expect(missing.profile_image_upload).not_to be_attached
+    expect(available.reload.profile_image_upload).to be_attached
+
+    store_legacy_image(missing)
+    task.reenable
+    expect { task.invoke }.to change(ActiveStorage::Attachment, :count).by(1)
+    expect(missing.reload.profile_image_upload.download).to eq(image_path.binread)
+  end
+
+  it "never publishes an incomplete upload and can be rerun after a storage failure", :aggregate_failures do
+    user = create(:user, profile_image: nil)
+    legacy = store_legacy_image(user)
+    service = ActiveStorage::Blob.service
+    attempted_keys = []
+    allow(service).to receive(:upload).and_wrap_original do |upload, key, io, **options|
+      upload.call(key, io, **options)
+      attempted_keys << key
+      raise IOError, "Upload interrupted" if attempted_keys.one?
+    end
+
+    expect do
+      expect { task.invoke }.to raise_error(SystemExit)
+    end.to output(/Upload interrupted/).to_stderr
+    expect(service).not_to exist(attempted_keys.first)
+    expect(user.reload.profile_image_url).to eq(legacy.url)
+    expect(user.profile_image_upload).not_to be_attached
+
+    task.reenable
+    expect { task.invoke }.to change(ActiveStorage::Blob, :count).by(1)
+    expect(user.reload.profile_image_upload.download).to eq(image_path.binread)
+  end
+
+  it "rechecks for new uploads made after selecting a copy candidate", :aggregate_failures do
+    user = create(:user, profile_image: nil)
+    store_legacy_image(user)
+    candidate = ProfileImages::CopyLegacy.new(user.reload)
+    update = User.find(user.id)
+    image_path.open { |file| update.update!(profile_image: file) }
+    new_blob_id = update.profile_image_upload.blob.id
+
+    expect { expect(candidate.call).to eq(:skipped) }.not_to change(ActiveStorage::Blob, :count)
+    expect(user.reload.profile_image_upload.blob.id).to eq(new_blob_id)
+  end
+
+  context "when the legacy files are private in S3" do
+    let(:bucket) { "legacy-profile-images" }
+    let(:credentials) { { provider: "AWS", aws_access_key_id: "test", aws_secret_access_key: "test" } }
+    let(:storage) { Fog::Storage.new(**credentials) }
+
+    around do |example|
+      Fog.mock!
+      example.run
+    ensure
+      Fog.unmock!
+    end
+
+    before do
+      storage.put_bucket(bucket)
+      allow(ProfileImageUploader).to receive_messages(storage: CarrierWave::Storage::Fog, fog_directory: bucket,
+                                                      fog_credentials: credentials, fog_public: false)
+    end
+
+    it "copies the stored bytes through the CarrierWave backend", :aggregate_failures do
+      user = create(:user, profile_image: nil)
+      legacy = store_legacy_image(user)
+      expect(legacy.file).to be_a(CarrierWave::Storage::Fog::File)
+
+      task.invoke
+
+      expect(user.reload.profile_image_upload.download).to eq(image_path.binread)
+      expect(storage.get_object(bucket, legacy.path).body).to eq(image_path.binread)
+    end
+  end
+end
