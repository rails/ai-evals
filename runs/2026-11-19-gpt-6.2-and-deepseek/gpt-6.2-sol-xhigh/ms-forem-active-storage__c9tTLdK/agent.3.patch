diff --git a/app/services/profile_images/legacy_upload.rb b/app/services/profile_images/legacy_upload.rb
new file mode 100644
index 0000000..cd07c85
--- /dev/null
+++ b/app/services/profile_images/legacy_upload.rb
@@ -0,0 +1,28 @@
+module ProfileImages
+  # Resolve historical files without mounting an uploader or registering any
+  # CarrierWave persistence callbacks on the owner.
+  class LegacyUpload
+    def initialize(owner)
+      @owner = owner
+    end
+
+    def url
+      with_file(&:url)
+    end
+
+    def read
+      with_file { |uploader| uploader.file&.read }
+    end
+
+    private
+
+    def with_file
+      identifier = @owner[:profile_image] if @owner.has_attribute?(:profile_image)
+      return if identifier.blank?
+
+      uploader = ProfileImageUploader.new(@owner, :profile_image)
+      uploader.retrieve_from_store!(identifier)
+      yield uploader
+    end
+  end
+end
