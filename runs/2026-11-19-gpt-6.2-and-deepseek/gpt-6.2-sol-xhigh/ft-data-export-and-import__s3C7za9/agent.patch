+++ b/app/models/export.rb
@@ -0,0 +1,56 @@
+class Export < ApplicationRecord
+  LIFETIME = 24.hours
+
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file
+
+  enum :kind, %w[ account cards ].index_by(&:itself), prefix: true
+
+  scope :expired, -> { where(completed_at: ..LIFETIME.ago).or(where(completed_at: nil, created_at: ..1.week.ago)) }
+
+  def generate
+    unless completed_at?
+      ZipFile.create_for(file, filename: "fizzy-#{kind}-#{Date.current}.zip") do |zip|
+        if kind_account?
+          Account::DataTransfer::Manifest.new(account).write(zip)
+        else
+          write_visible_cards(zip)
+        end
+      end
+      update!(completed_at: Time.current)
+    end
+  end
+
+  def permitted?
+    account.active? && user.active? && user.account_id == account_id &&
+      (kind_account? ? user.admin? : available_boards?)
+  end
+
+  def expires_at
+    completed_at + LIFETIME
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_at: expires_at)
+  end
+
+  private
+    def available_boards?
+      board_ids.blank? || user.boards.where(id: board_ids).count == board_ids.size
+    end
+
+    def write_visible_cards(zip)
+      files, boards = {}, Set.new
+      cards = user.accessible_cards
+      visible_cards = cards.published.or(cards.where(creator: user))
+
+      Card::Export.new(visible_cards).write_summaries(zip) do |card, blobs|
+        boards << card.board_id
+        blobs.each { |blob| files[blob.id] = blob }
+      end
+
+      files.each_value { |blob| Account::DataTransfer::ActiveStorage::FileRecordSet.write_file(zip, blob) }
+      self.board_ids = boards.to_a
+    end
+end
