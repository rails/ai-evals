--- /dev/null
+++ b/app/mailers/data_transfer_mailer.rb
@@ -0,0 +1,16 @@
+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    @download_url = account_export_url(export.download_token, script_name: export.account.slug)
+
+    mail to: export.user.identity.email_address,
+      subject: "Your Fizzy #{export.kind_account? ? 'account' : 'card'} export is ready"
+  end
+
+  def import_finished(import)
+    @account = import.account
+    @failure = import.failure
+    mail to: import.identity.email_address,
+      subject: @failure ? "Your Fizzy account import failed" : "Your Fizzy account import is ready"
+  end
+end
