--- /dev/null
+++ b/app/models/zip_file/storage_io.rb
@@ -0,0 +1,62 @@
+# Seekable, bounded reads from a private Active Storage object. Buffer small
+# reads so that sequential ZIP members don't each require a storage request.
+class ZipFile::StorageIO
+  MAX_READ = 128.megabytes
+  BUFFER_SIZE = 8.megabytes
+
+  attr_reader :size, :tell
+
+  def initialize(service, key, size)
+    @service, @key, @size = service, key, size
+    @tell = 0
+    @buffers = {}
+  end
+
+  def seek(offset, whence = IO::SEEK_SET)
+    position = case whence
+    when IO::SEEK_SET then offset
+    when IO::SEEK_CUR then tell + offset
+    when IO::SEEK_END then size + offset
+    end
+
+    unless position&.between?(0, size)
+      raise ZipFile::Reader::InvalidArchive, "The ZIP contains an invalid offset."
+    end
+    @tell = position
+    0
+  end
+
+  def read(length = nil)
+    length ||= size - tell
+    if length > MAX_READ || length < 0
+      raise ZipFile::Reader::InvalidArchive, "The ZIP directory is too large or invalid."
+    end
+    return "".b if length.zero?
+    return nil if tell == size
+
+    length = [ length, size - tell ].min
+    if length > BUFFER_SIZE
+      data = download(tell, length)
+    else
+      start, buffer = @buffers.find { |offset, data| tell >= offset && tell + length <= offset + data.bytesize }
+      unless buffer
+        start, buffer = tell, download(tell, [ BUFFER_SIZE, size - tell ].min)
+        @buffers.shift if @buffers.size == 2
+      end
+      @buffers.delete(start)
+      @buffers[start] = buffer
+      data = buffer.byteslice(tell - start, length)
+    end
+    @tell += length
+    data
+  end
+
+  private
+    def download(offset, length)
+      @service.download_chunk(@key, offset...(offset + length)).tap do |data|
+        unless data.bytesize == length
+          raise ZipFile::Reader::InvalidArchive, "The uploaded ZIP is incomplete."
+        end
+      end
+    end
+end
