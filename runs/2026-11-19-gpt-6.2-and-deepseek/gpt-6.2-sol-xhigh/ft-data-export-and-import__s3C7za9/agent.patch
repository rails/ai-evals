diff --git a/docs/data-transfer.md b/docs/data-transfer.md
new file mode 100644
index 0000000..19591b9
--- /dev/null
+++ b/docs/data-transfer.md
@@ -0,0 +1,12 @@
+# Exporting and importing Fizzy data
+
+- **Account settings → Export account**: administrators can export the entire account, including private boards and archived card state. This is the ZIP to use when moving to another Fizzy instance.
+- **Your profile → Export cards**: members can export the cards they can see. The ZIP contains a JSON file for each card, with its comments and paths to files included in the ZIP. This is not an account backup and cannot be imported.
+
+Fizzy emails the requester a download link when the ZIP is ready. The requester must sign in, and the link expires after 24 hours.
+
+To restore a full account ZIP, sign in on the destination instance and visit `/account/imports/new`. Fizzy creates a separate account and makes the requester its owner. People are matched by email; any previous owners retain administrator access. Sign-in credentials, sessions, and join codes are not transferred. Imported webhooks start disabled and have new signing secrets. Fizzy emails the requester the result, and a failed import does not publish a partial account.
+
+### Deploying for large transfers
+
+Keep the web and worker processes on the same private Active Storage service. With local storage, both processes must have access to the same volume. ZIP64 is supported; S3 exports use multipart writes, and import workers read the source ZIP using ranges rather than downloading the whole archive into memory. For large browser uploads, make sure the reverse proxy permits the upload size and duration and that the web process has space to spool the upload. Allow worker temporary disk space for a local export or for the largest individual file being restored.
diff --git a/test/controllers/accounts/data_transfer_test.rb b/test/controllers/accounts/data_transfer_test.rb
new file mode 100644
index 0000000..33437a6
--- /dev/null
+++ b/test/controllers/accounts/data_transfer_test.rb
@@ -0,0 +1,197 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+  end
+
+  test "an administrator can request an account export and download it from email" do
+    sign_in_as users(:kevin)
+
+    perform_enqueued_jobs do
+      post "#{@account.slug}/account/exports"
+      assert_response :redirect
+    end
+
+    export = @account.exports.last
+    mail = ActionMailer::Base.deliveries.find { |email| email.subject == "Your Fizzy account export is ready" }
+    assert_equal [ users(:kevin).identity.email_address ], mail.to
+    link = Nokogiri::HTML(mail.body.decoded).at_css("a")["href"]
+    download_path = URI.parse(link).path
+
+    get download_path
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+    assert_includes response.headers["Content-Disposition"], "attachment"
+    assert_equal "fizzy-account", read_zip(response.body).read_json("manifest.json")["format"]
+
+    logout_and_sign_in_as users(:jason)
+    get download_path
+    assert_response :not_found
+
+    logout_and_sign_in_as users(:kevin)
+    travel_to export.expires_at + 1.second do
+      get download_path
+      assert_response :not_found
+    end
+  end
+
+  test "members can only export their visible cards" do
+    sign_in_as users(:david)
+    post "#{@account.slug}/account/exports"
+    assert_response :forbidden
+
+    hidden = Current.set(account: @account, user: users(:kevin)) do
+      boards(:private).cards.create!(creator: users(:kevin), status: :published, title: "Private card")
+    end
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "Other person's draft")
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("example attachment"), filename: "résumé 🗒.txt", content_type: "text/plain")
+    comment = cards(:logo).comments.create!(creator: users(:david), body: "A comment to export #{ActionText::Attachment.from_attachable(blob).to_html}")
+    cards(:logo).image.attach(fixture_file_upload("moon.jpg", "image/jpeg"))
+
+    perform_enqueued_jobs(only: ExportJob) do
+      post "#{@account.slug}/my/exports"
+      assert_response :redirect
+    end
+
+    zip = read_zip(@account.exports.last.file.download)
+    assert_not_includes zip.paths("cards"), "cards/#{hidden.number}.json"
+    assert_not_includes zip.paths("cards"), "cards/#{draft.number}.json"
+    card = zip.read_json("cards/#{cards(:logo).number}.json")
+    exported_comment = card["comments"].find { |entry| entry["body"]&.include?("A comment to export") }
+    assert_equal comment.creator.name, exported_comment["creator"]
+    assert zip.exists?(exported_comment["attachments"].first["path"])
+    assert zip.exists?(card.dig("image", "path"))
+
+    users(:david).accesses.find_by!(board: boards(:writebook)).delete
+    get "#{@account.slug}/account/exports/#{@account.exports.last.download_token}"
+    assert_response :not_found
+  end
+
+  test "a signed-in person can open the account import form without an account prefix" do
+    get "/account/imports/new"
+    assert_response :redirect
+
+    sign_in_as users(:david)
+    get "/account/imports/new"
+    assert_response :success
+    assert_select "input[type=file]"
+  end
+
+  test "restore an exported account into a new account with people, files, and history" do
+    source = @account
+    card = cards(:logo)
+    image = File.binread(file_fixture("moon.jpg"))
+    card.image.attach(fixture_file_upload("moon.jpg", "image/jpeg"))
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("example attachment"), filename: "résumé 🗒.txt", content_type: "text/plain")
+    card.update!(description: "A card with a mention #{ActionText::Attachment.from_attachable(users(:jz)).to_html}")
+    comment = card.comments.create!(creator: users(:kevin), body: "Here is the file: #{ActionText::Attachment.from_attachable(blob).to_html}")
+    archived_board = boards(:private)
+    archived_board.publish
+    filter = users(:kevin).filters.create!(terms: [ "logo" ], assignees: [ users(:david) ], boards: [ boards(:writebook) ])
+
+    archive = export_account(source)
+    sign_in_as users(:mike) # Signed in, but not a member of the source account.
+
+    assert_difference -> { Account.count }, 1 do
+      import_zip(archive)
+    end
+
+    import = Account::Import.last
+    assert_nil import.failure
+    account = import.account
+    assert_not_equal source.external_account_id, account.external_account_id
+    assert_equal source.name, account.name
+    assert_equal source.boards.pluck(:name).sort, account.boards.pluck(:name).sort
+    assert_not_equal archived_board.publication.key, account.boards.find_by!(name: archived_board.name).publication.key
+    assert_equal source.cards.count, account.cards.count
+    assert_equal source.users.count + 1, account.users.count
+    assert_equal [ users(:mike).identity ], account.users.owner.map(&:identity)
+    assert account.users.find_by!(identity: users(:jason).identity).admin?
+
+    restored_card = account.cards.find_by!(number: card.number)
+    assert_not_equal card.id, restored_card.id
+    assert_equal card.title, restored_card.title
+    assert_equal card.creator.identity, restored_card.creator.identity
+    assert_equal card.column.name, restored_card.column.name
+    assert_equal image, restored_card.image.download
+    assert_not_equal card.image.key, restored_card.image.key
+    assert_includes restored_card.description.body.attachables, account.users.find_by!(identity: users(:jz).identity)
+    restored_comment = restored_card.comments.where(creator: account.users.find_by!(identity: comment.creator.identity)).order(:created_at).last!
+    assert_equal "example attachment", restored_comment.body.embeds.first.download
+    assert_includes restored_comment.body.body.attachables, restored_comment.body.embeds.first.blob
+    assert_equal filter.assignees.pluck(:name), account.users.find_by!(identity: users(:kevin).identity).filters.find_by!(fields: filter.fields).assignees.pluck(:name)
+    assert_equal image.bytesize + blob.byte_size, account.bytes_used
+    assert_equal Event.where(account: source).count, Event.where(account: account).count
+    assert_not ActiveStorage::Blob.service.exist?(import.archive_key)
+    assert_equal "Your Fizzy account import is ready", ActionMailer::Base.deliveries.last.subject
+  end
+
+  test "failure after staging files rolls back the account and removes uploaded objects" do
+    cards(:logo).image.attach(fixture_file_upload("moon.jpg", "image/jpeg"))
+    archive = export_account(@account) do |path, data|
+      if path == "records/cards/#{cards(:logo).id}.json"
+        JSON.parse(data).merge("board_id" => boards(:miltons_wish_list).id).to_json
+      else
+        data
+      end
+    end
+    sign_in_as users(:david)
+    service = ActiveStorage::Blob.service
+    before = Dir.glob("#{service.root}/**/*").select { |path| File.file?(path) }.sort
+
+    assert_no_difference [ "Account.count", "Card.count", "ActiveStorage::Blob.count", "Identity.count" ] do
+      import_zip(archive)
+    end
+
+    assert_match(/missing Board reference/, Account::Import.last.failure)
+    assert_equal before, Dir.glob("#{service.root}/**/*").select { |path| File.file?(path) }.sort
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal "Your Fizzy account import failed", mail.subject
+    assert_match(/missing Board reference/, mail.body.decoded)
+  end
+
+  test "an invalid ZIP produces a failure email without creating an account" do
+    sign_in_as users(:david)
+    assert_no_difference "Account.count" do
+      import_zip("not a ZIP file")
+    end
+    assert_match(/not a readable ZIP/, Account::Import.last.failure)
+    assert_equal "Your Fizzy account import failed", ActionMailer::Base.deliveries.last.subject
+  end
+
+  private
+    def export_account(account)
+      # Keep this helper independent of the HTTP export tests so it can also
+      # construct malformed archives for testing rollback.
+      io = StringIO.new("".b)
+      zip = ZipFile::Writer.new(io)
+      if block_given?
+        original_add_file = zip.method(:add_file)
+        edit_data = Proc.new { |path, data| yield(path, data) }
+        zip.define_singleton_method(:add_file) do |path, data = nil, **options, &block|
+          original_add_file.call(path, data && edit_data.call(path, data), **options, &block)
+        end
+      end
+      Account::DataTransfer::Manifest.new(account).write(zip)
+      zip.close
+      io.string
+    end
+
+    def import_zip(bytes)
+      Tempfile.create([ "account", ".zip" ], binmode: true) do |file|
+        file.write(bytes)
+        file.flush
+        perform_enqueued_jobs(only: [ Account::ImportJob, ActionMailer::MailDeliveryJob ]) do
+          post "/account/imports", params: { archive: Rack::Test::UploadedFile.new(file.path, "application/zip") }
+          assert_response :redirect
+        end
+      end
+    end
+
+    def read_zip(bytes)
+      ZipFile::Reader.new(StringIO.new(bytes))
+    end
+end
