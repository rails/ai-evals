+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,27 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+  layout "public"
+
+  def new
+  end
+
+  def create
+    upload = params[:archive]
+    if upload.is_a?(ActionDispatch::Http::UploadedFile) && upload.size.positive?
+      Account::Import.enqueue(identity: Current.identity, upload: upload)
+      redirect_to new_account_import_path, notice: "We’ll email you when the import finishes."
+    else
+      flash.now[:alert] = "Choose a Fizzy account export to upload."
+      render :new, status: :unprocessable_entity
+    end
+  rescue Account::Import::UploadFailed
+    flash.now[:alert] = "Fizzy couldn’t store your upload. Please try again."
+    render :new, status: :service_unavailable
+  end
+
+  private
+    def request_authentication
+      session[:return_to_after_authenticating] = new_account_import_url
+      super
+    end
+end
