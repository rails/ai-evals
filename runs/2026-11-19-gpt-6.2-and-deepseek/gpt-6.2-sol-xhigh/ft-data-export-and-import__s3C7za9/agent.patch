--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,51 @@
+class Account::Import < ApplicationRecord
+  class UploadFailed < StandardError; end
+
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  before_destroy :remove_archive, unless: :finished?
+
+  def self.enqueue(identity:, upload:)
+    service = ActiveStorage::Blob.service
+    import = create!(identity: identity, service_name: service.name, byte_size: upload.size)
+    upload.tempfile.rewind
+    ZipFile.upload(service, import.archive_key, upload.tempfile, content_type: ZipFile::CONTENT_TYPE)
+    raise ActiveJob::EnqueueError unless Account::ImportJob.perform_later(import)
+  rescue => error
+    Rails.error.report(error)
+    Rails.error.handle { import.destroy! } if import
+    raise UploadFailed
+  end
+
+  def perform
+    unless finished?
+      reader = ZipFile::Reader.new(ZipFile::StorageIO.new(service, archive_key, byte_size))
+      Account::DataTransfer::Import.new(self, reader).restore
+    end
+  rescue ZipFile::Reader::InvalidArchive => error
+    update!(failure: error.message)
+  rescue => error
+    Rails.error.report(error)
+    update!(failure: "Fizzy couldn't restore the archive. Please try again or contact your administrator.")
+  ensure
+    remove_archive
+  end
+
+  def archive_key
+    "imports/#{id}"
+  end
+
+  private
+    def finished?
+      account_id? || failure?
+    end
+
+    def remove_archive
+      service.delete(archive_key)
+    end
+
+    def service
+      ActiveStorage::Blob.services.fetch(service_name)
+    end
+end
diff --git a/app/models/card/export.rb b/app/models/card/export.rb
new file mode 100644
index 0000000..6af6cdd
--- /dev/null
+++ b/app/models/card/export.rb
@@ -0,0 +1,51 @@
+class Card::Export
+  FILES = Account::DataTransfer::ActiveStorage::FileRecordSet
+  RICH_TEXT = Account::DataTransfer::RichText
+
+  def initialize(cards)
+    @cards = cards
+  end
+
+  def write_summaries(zip)
+    @cards.includes(:creator, :board).with_attached_image.with_rich_text_description_and_embeds.find_each do |card|
+      image = card.image.blob if card.image.blob&.account_id == card.account_id
+      entry = card_data(card, image)
+      files = [ image, *embed_blobs(card.rich_text_description) ].compact
+
+      card.comments.chronologically.includes(:creator).with_rich_text_body_and_embeds.each do |comment|
+        files.concat(embed_blobs(comment.rich_text_body))
+        entry[:comments] << comment_data(comment)
+      end
+
+      zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(entry))
+      yield card, files if block_given?
+    end
+  end
+
+  private
+    def card_data(card, image)
+      {
+        number: card.number, title: card.title, board: card.board.name, status: card.status, creator: card.creator.name,
+        created_at: card.created_at, updated_at: card.updated_at, due_on: card.due_on,
+        description: RICH_TEXT.export(card.rich_text_description), image: file_data(image),
+        attachments: embed_blobs(card.rich_text_description).map { |blob| file_data(blob) }, comments: []
+      }
+    end
+
+    def comment_data(comment)
+      {
+        creator: comment.creator.name, created_at: comment.created_at, updated_at: comment.updated_at,
+        body: RICH_TEXT.export(comment.rich_text_body), attachments: embed_blobs(comment.rich_text_body).map { |blob| file_data(blob) }
+      }
+    end
+
+    def embed_blobs(rich_text)
+      Array(rich_text&.embeds_attachments).filter_map { |attachment| attachment.blob if attachment.blob.account_id == rich_text.account_id }
+    end
+
+    def file_data(blob)
+      if blob
+        { name: blob.filename.to_s, content_type: blob.content_type, path: FILES.path(blob.id, blob.filename.to_s) }
+      end
+    end
+end
