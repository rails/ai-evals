index 0000000..fabc949
--- /dev/null
+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,20 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create
+
+  def create
+    export = Current.account.exports.create!(user: Current.user, kind: :account)
+    ExportJob.perform_later(export)
+    redirect_to account_settings_path, notice: "We’ll email you a download link when your account export is ready."
+  end
+
+  def show
+    export = Current.account.exports.find_signed(params[:id], purpose: :download)
+    unless export && export.user == Current.user && export.permitted? && export.file.attached? && export.completed_at? && export.expires_at.future?
+      return head :not_found
+    end
+
+    ActiveStorage::Current.url_options = { protocol: request.protocol, host: request.host, port: request.port, script_name: request.script_name }
+    no_store
+    redirect_to export.file.url(disposition: :attachment, expires_in: [ 5.minutes, export.expires_at - Time.current ].min), allow_other_host: true
+  end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
