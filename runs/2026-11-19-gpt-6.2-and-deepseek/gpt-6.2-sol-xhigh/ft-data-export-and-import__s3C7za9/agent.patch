@@ -0,0 +1,12 @@
+class ExportJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(export)
+    if export.permitted?
+      export.generate
+      DataTransferMailer.export_ready(export).deliver_later if export.reload.permitted?
+    else
+      export.destroy!
+    end
+  end
+end
