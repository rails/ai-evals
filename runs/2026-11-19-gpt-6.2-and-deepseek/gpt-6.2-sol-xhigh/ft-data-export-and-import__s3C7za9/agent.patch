new file mode 100644
index 0000000..c4b72b6
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,109 @@
+class ZipFile::Reader
+  class InvalidArchive < StandardError; end
+
+  MAX_JSON_SIZE = 16.megabytes
+  CHUNK_SIZE = 64.kilobytes
+
+  def initialize(io)
+    raise InvalidArchive, "The upload is not a readable ZIP archive." if io.size < 22
+
+    @io = io
+    @parser = ZipKit::FileReader.new
+    @entries = {}
+
+    # Only read the directory here. Local headers and file data are read on demand.
+    entries = @parser.read_zip_structure(io: io, read_local_headers: false)
+    entries.each do |entry|
+      raise InvalidArchive, "The ZIP contains duplicate entries." if @entries.key?(entry.filename.b)
+      @entries[entry.filename.b] = entry
+    end
+
+    @entry_limits = {}
+    next_offset = io.size
+    entries.sort_by(&:local_file_header_offset).reverse_each do |entry|
+      if entry.local_file_header_offset >= next_offset
+        raise InvalidArchive, "The ZIP contains overlapping entries."
+      end
+      @entry_limits[entry.filename.b] = next_offset
+      next_offset = entry.local_file_header_offset
+    end
+  rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::UnsupportedFeature
+    raise InvalidArchive, "The upload is not a readable ZIP archive."
+  end
+
+  def exists?(path)
+    @entries.key?(path.b)
+  end
+
+  def paths(directory)
+    prefix = "#{directory}/"
+    @entries.keys.select { |path| path.start_with?(prefix) }
+  end
+
+  def read_json(path)
+    json = +"".b
+    read_entry(path, limit: MAX_JSON_SIZE) { |chunk| json << chunk }
+    JSON.parse(json)
+  rescue JSON::ParserError
+    raise InvalidArchive, "The ZIP contains invalid JSON."
+  end
+
+  def copy_file(path, to:, size:)
+    entry = fetch_entry(path)
+    unless entry.storage_mode == 0 && entry.uncompressed_size == size
+      raise InvalidArchive, "An attached file has the wrong size or compression."
+    end
+
+    digest = Digest::MD5.new
+    read_entry(path, limit: size) do |chunk|
+      digest.update(chunk)
+      to.write(chunk)
+    end
+    digest.base64digest
+  end
+
+  private
+    def fetch_entry(path)
+      @entries.fetch(path.b) { raise InvalidArchive, "A required entry is missing from the ZIP." }
+    end
+
+    def read_entry(path, limit:)
+      entry = fetch_entry(path)
+      unless entry.uncompressed_size <= limit && entry.compressed_size <= limit + CHUNK_SIZE && entry.gp_flags.nobits?(1) && [ 0, 8 ].include?(entry.storage_mode)
+        raise InvalidArchive, "A ZIP entry is too large, encrypted, or uses unsupported compression."
+      end
+
+      @io.seek(entry.local_file_header_offset)
+      header = @parser.read_local_file_header(io: @io)
+      if header.filename != entry.filename || header.storage_mode != entry.storage_mode ||
+          header.compressed_data_offset + entry.compressed_size > @entry_limits.fetch(path.b)
+        raise InvalidArchive, "A ZIP entry has an invalid header."
+      end
+      @io.seek(header.compressed_data_offset)
+
+      size = crc = 0
+      emit = ->(chunk) do
+        size += chunk.bytesize
+        raise InvalidArchive, "A ZIP entry exceeds its declared size." if size > entry.uncompressed_size
+        crc = Zlib.crc32(chunk, crc)
+        yield chunk
+      end
+
+      inflater = Zlib::Inflate.new(-Zlib::MAX_WBITS) if entry.storage_mode == 8
+      remaining = entry.compressed_size
+      while remaining > 0
+        chunk = @io.read([ remaining, CHUNK_SIZE ].min)
+        raise InvalidArchive, "A ZIP entry is truncated." if chunk.nil? || chunk.empty?
+        remaining -= chunk.bytesize
+        inflater ? inflater.inflate(chunk, &emit) : emit.call(chunk)
+      end
+
+      unless size == entry.uncompressed_size && crc == entry.crc32 && (!inflater || (inflater.finished? && inflater.total_in == entry.compressed_size))
+        raise InvalidArchive, "A ZIP entry did not pass its integrity check."
+      end
+    rescue ZipKit::FileReader::ReadError, Zlib::Error
+      raise InvalidArchive, "A ZIP entry is damaged."
+    ensure
+      inflater&.close
+    end
+end
diff --git a/app/models/zip_file/s3_upload.rb b/app/models/zip_file/s3_upload.rb
new file mode 100644
index 0000000..23d2955
--- /dev/null
+++ b/app/models/zip_file/s3_upload.rb
@@ -0,0 +1,19 @@
+class ZipFile::S3Upload
+  PART_SIZE = 128.megabytes
+
+  # The SDK's default executor queues parts without a limit. Upload each part
+  # before reading the next so a slow connection cannot fill memory or disk.
+  class InlineExecutor
+    def post(*args)
+      yield(*args)
+    end
+  end
+
+  def self.write(service, key, content_type:, part_size: PART_SIZE, private_object: true, &block)
+    options = service.upload_options.merge(content_type: content_type)
+    options = options.except(:acl) if private_object
+    Aws::S3::TransferManager.new(client: service.client.client, executor: InlineExecutor.new).upload_stream(
+      bucket: service.bucket.name, key: key, part_size: part_size, tempfile: true, **options, &block
+    )
+  end
+end
