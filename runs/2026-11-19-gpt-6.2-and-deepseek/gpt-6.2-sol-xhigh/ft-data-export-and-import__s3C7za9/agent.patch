diff --git a/app/models/account/data_transfer/import.rb b/app/models/account/data_transfer/import.rb
new file mode 100644
index 0000000..1d7870b
--- /dev/null
+++ b/app/models/account/data_transfer/import.rb
@@ -0,0 +1,218 @@
+class Account::DataTransfer::Import
+  InvalidArchive = ZipFile::Reader::InvalidArchive
+  FILES = Account::DataTransfer::ActiveStorage::FileRecordSet
+  ID = /\A[0-9a-z]{25}\z/
+  BATCH_SIZE = 250
+
+  def initialize(import, zip)
+    @import = import
+    @zip = zip
+    @references = Account::DataTransfer::References.new
+    @record_sets = Account::DataTransfer::Manifest.new(nil).each_record_set.to_a
+    @service = ::ActiveStorage::Blob.service
+    @files = {}
+  end
+
+  def restore
+    index_records
+    upload_files
+    provision_account
+    @restored = true
+  rescue ActiveRecord::RecordInvalid, ActiveRecord::RecordNotUnique, ActiveRecord::NotNullViolation, ActiveRecord::SerializationTypeMismatch
+    raise InvalidArchive, "The ZIP contains invalid or conflicting records."
+  ensure
+    unless @restored
+      @files.each_value do |file|
+        Rails.error.handle { @service.delete(file.fetch("key")) }
+      end
+    end
+  end
+
+  private
+    def index_records
+      manifest = @zip.read_json("manifest.json") if @zip.exists?("manifest.json")
+      unless manifest.is_a?(Hash) && manifest["format"] == "fizzy-account" && manifest["version"] == Account::DataTransfer::Manifest::VERSION
+        raise InvalidArchive, "Choose a full Fizzy account export in a supported format."
+      end
+
+      counts = manifest["records"]
+      @paths = @record_sets.to_h do |set|
+        paths = @zip.paths(set.directory)
+        unless counts.is_a?(Hash) && counts[set.model.table_name] == paths.size
+          raise InvalidArchive, "The ZIP is missing #{set.model.table_name} records."
+        end
+
+        paths.each do |path|
+          id = record_id(path)
+          unless ID.match?(id) && path == "#{set.directory}/#{id}.json"
+            raise InvalidArchive, "The ZIP contains an invalid record path."
+          end
+          @references.assign(set.model.name, id)
+        end
+        [ set.model, paths ]
+      end
+
+      unless @paths.fetch(Account).one?
+        raise InvalidArchive, "The ZIP must contain exactly one account."
+      end
+      @source_id = record_id(@paths.fetch(Account).first)
+      @source = read_record(@paths.fetch(Account).first)
+      unless @source["name"].is_a?(String) && @source["name"].present?
+        raise InvalidArchive, "The exported account has no name."
+      end
+    end
+
+    def upload_files
+      @paths.fetch(::ActiveStorage::Blob).each do |path|
+        blob = read_record(path)
+        id, filename, size = blob.values_at("id", "filename", "byte_size")
+        unless filename.is_a?(String) && size.is_a?(Integer) && size >= 0
+          raise InvalidArchive, "The ZIP contains invalid file metadata."
+        end
+
+        Tempfile.create([ "import", ".file" ], binmode: true) do |file|
+          checksum = @zip.copy_file(FILES.path(id, filename), to: file, size: size)
+          if blob["checksum"].present? && blob["checksum"] != checksum
+            raise InvalidArchive, "An attached file did not pass its checksum verification."
+          end
+
+          key = ::ActiveStorage::Blob.generate_unique_secure_token
+          @files[id] = { "key" => key, "checksum" => checksum, "service_name" => @service.name }
+          file.rewind
+          ZipFile.upload(@service, key, file, checksum: checksum, content_type: "application/octet-stream", private_object: false)
+        end
+      end
+    end
+
+    def provision_account
+      identity = @import.identity
+      signup = Signup.new(identity: identity, full_name: identity.users.active.first&.name || identity.email_address)
+
+      signup.provision_account(name: @source.fetch("name")) do |external_id|
+        Account.transaction(requires_new: true) do
+          account = Account.create!(
+            id: @references.fetch("Account", @source_id), external_account_id: external_id,
+            **@source.slice("name", "cards_count", "created_at", "updated_at").symbolize_keys
+          )
+
+          Current.with_account(account) do
+            account.entropy.delete
+
+            @record_sets.each { |set| restore_record_set(set) unless set.model == Account }
+            restore_filter_resources
+            complete_account(account, identity)
+            @import.update!(account: account)
+          end
+        end
+      end
+    end
+
+    def restore_record_set(set)
+      # Insert historical data without publishing cards, dispatching webhooks,
+      # or sending notifications. Rebuild derived data after all rows exist.
+      @paths.fetch(set.model).each_slice(BATCH_SIZE) do |paths|
+        rows = paths.map do |path|
+          record = read_record(path)
+          @references.translate(set.model, record.slice(*set.attributes)).tap do |row|
+            prepare_record(set.model, record, row)
+          end
+        end
+        set.model.insert_all!(rows)
+      end
+    end
+
+    def read_record(path)
+      record = @zip.read_json(path)
+      unless record.is_a?(Hash) && record["id"] == record_id(path) && (record["id"] == @source_id || record["account_id"] == @source_id)
+        raise InvalidArchive, "The ZIP contains a record from an unexpected account."
+      end
+      record
+    end
+
+    def record_id(path)
+      File.basename(path, ".json")
+    end
+
+    def prepare_record(model, original, row)
+      case model.name
+      when "User"
+        prepare_user(original, row)
+      when "Board::Publication"
+        row["key"] = Board::Publication.generate_unique_secure_token
+      when "Webhook"
+        row.merge!("signing_secret" => Webhook.generate_unique_secure_token, "active" => false)
+      when "Webhook::Delivery"
+        row["state"] = "errored" if row["state"].in?(%w[ pending in_progress ])
+      when "Notification::Bundle"
+        row["status"] = :delivered # Historical notifications should not send new mail.
+      when "Event"
+        remap_ids(row["particulars"], "assignee_ids", "User")
+      when "Filter"
+        remap_ids(row["fields"], "card_ids", "Card")
+        remap_ids(row["fields"], "column_ids", "Column")
+      when "ActiveStorage::Blob"
+        row.merge!(@files.fetch(original.fetch("id")))
+      when "ActionText::RichText"
+        row["body"] = Account::DataTransfer::RichText.restore(row["body"], @references) if row["body"]
+      end
+    end
+
+    def prepare_user(original, row)
+      unless row["name"].is_a?(String) && row["name"].present? && User.roles.key?(row["role"])
+        raise InvalidArchive, "The ZIP contains an invalid person."
+      end
+
+      email = original["email_address"]
+      if row["active"] == true && row["role"] != "system" && email.present?
+        unless email.is_a?(String) && URI::MailTo::EMAIL_REGEXP.match?(email)
+          raise InvalidArchive, "The ZIP contains an invalid email address."
+        end
+        row["identity_id"] = Identity.find_or_create_by!(email_address: email).id
+      else
+        row["identity_id"] = nil
+      end
+    end
+
+    def remap_ids(fields, key, type)
+      fields[key] = @references.existing_ids(type, fields[key]) if fields.is_a?(Hash) && fields.key?(key)
+    end
+
+    def restore_filter_resources
+      @paths.fetch(Filter).each do |path|
+        record = read_record(path)
+        filter = Filter.find(@references.fetch("Filter", record.fetch("id")))
+        Account::DataTransfer::FilterRecordSet::RESOURCES.each do |name|
+          association = filter.association(name)
+          ids = @references.existing_ids(association.klass.name, record.fetch("resources")[name])
+          association.ids_writer(ids)
+        end
+        filter.update_columns(params_digest: Filter.digest_params(filter.as_params))
+      rescue ActiveRecord::RecordNotUnique
+        filter.destroy!
+      end
+    end
+
+    def complete_account(account, identity)
+      unless Entropy.exists?(container: account)
+        account.create_entropy!(auto_postpone_period: Account::Entropic::DEFAULT_ENTROPY_PERIOD, account: account)
+      end
+      account.users.create!(role: :system, name: "System") unless account.users.exists?(role: :system)
+      owner = account.users.find_by(identity: identity) || account.users.build(identity: identity, name: identity.users.active.first&.name || identity.email_address)
+      previous_owners = account.users.where(role: :owner)
+      previous_owners = previous_owners.where.not(id: owner.id) if owner.persisted?
+      previous_owners.update_all(role: :admin)
+      owner.update!(role: :owner, active: true, verified_at: owner.verified_at || Time.current)
+      account.boards.find_each { |board| board.accesses.grant_to(owner) }
+      account.update_columns(cards_count: [ account.cards_count, account.cards.maximum(:number).to_i ].max)
+
+      account.cards.find_each(&:reindex)
+      Comment.where(account: account).find_each(&:reindex)
+      bytes = 0
+      account.boards.find_each do |board|
+        size = board.send(:calculate_real_storage_bytes)
+        Storage::Total.create!(owner: board, bytes_stored: size)
+        bytes += size
+      end
+      Storage::Total.create!(owner: account, bytes_stored: bytes)
+    end
+end
