@@ -0,0 +1,48 @@
+class Account::DataTransfer::References
+  POLYMORPHIC_TYPES = {
+    "action_text_rich_texts" => %w[ Board Card Comment ],
+    "active_storage_attachments" => Account::DataTransfer::ActiveStorage::AttachmentRecordSet::RECORD_TYPES,
+    "entropies" => %w[ Account Board ],
+    "events" => %w[ Card Comment Mention ],
+    "mentions" => %w[ Card Comment ],
+    "notifications" => %w[ Event Mention ],
+    "reactions" => %w[ Card Comment ]
+  }.freeze
+
+  def initialize
+    @ids = Hash.new { |hash, type| hash[type] = {} }
+  end
+
+  def assign(type, id)
+    @ids[type][id] = ActiveRecord::Type::Uuid.generate
+  end
+
+  def fetch(type, id)
+    @ids[type].fetch(id) do
+      raise ZipFile::Reader::InvalidArchive, "The ZIP contains a missing #{type} reference."
+    end
+  end
+
+  def existing_ids(type, ids)
+    Array(ids).filter_map { |id| @ids[type][id] }
+  end
+
+  def translate(model, attributes)
+    attributes.merge("id" => fetch(model.name, attributes.fetch("id"))).tap do |translated|
+      model.reflect_on_all_associations(:belongs_to).each do |association|
+        if id = attributes[association.foreign_key]
+          type = if association.polymorphic?
+            attributes[association.foreign_type].tap do |value|
+              unless POLYMORPHIC_TYPES.fetch(model.table_name, []).include?(value)
+                raise ZipFile::Reader::InvalidArchive, "The ZIP contains an unsupported record reference."
+              end
+            end
+          else
+            association.klass.name
+          end
+          translated[association.foreign_key] = fetch(type, id)
+        end
+      end
+    end
+  end
+end
diff --git a/app/models/account/data_transfer/rich_text.rb b/app/models/account/data_transfer/rich_text.rb
new file mode 100644
index 0000000..befa8d2
--- /dev/null
+++ b/app/models/account/data_transfer/rich_text.rb
@@ -0,0 +1,51 @@
+module Account::DataTransfer::RichText
+  FILES = Account::DataTransfer::ActiveStorage::FileRecordSet
+
+  class << self
+    def export(rich_text)
+      if rich_text&.body
+        embeds = rich_text.embeds_attachments.map(&:blob).index_by(&:id)
+
+        transform(rich_text.body.to_html) do |node|
+          if node["sgid"]
+            attachable = ::ActionText::Attachable.from_node(node)
+            strip_local_reference(node)
+
+            if attachable.is_a?(::ActiveStorage::Blob) && embeds.key?(attachable.id) && attachable.account_id == rich_text.account_id
+              node["data-fizzy-blob"] = attachable.id
+              node["url"] = "../#{FILES.path(attachable.id, attachable.filename.to_s)}"
+            elsif attachable.is_a?(User) && attachable.account_id == rich_text.account_id
+              node["data-fizzy-user"] = attachable.id
+            end
+          end
+        end
+      end
+    end
+
+    def restore(html, references)
+      # Canonicalize legacy editor attachment markup too, so no source SGIDs survive.
+      transform(::ActionText::Content.new(html).to_html) do |node|
+        if node["data-fizzy-blob"]
+          strip_local_reference(node)
+          node["sgid"] = ::ActiveStorage::Blob.find(references.fetch("ActiveStorage::Blob", node.delete("data-fizzy-blob").value)).attachable_sgid
+        elsif node["data-fizzy-user"]
+          strip_local_reference(node)
+          node["sgid"] = User.find(references.fetch("User", node.delete("data-fizzy-user").value)).attachable_sgid
+        elsif node["sgid"]
+          strip_local_reference(node)
+        end
+      end
+    end
+
+    private
+      def transform(html)
+        fragment = Nokogiri::HTML5.fragment(html)
+        fragment.css(::ActionText::Attachment.tag_name).each { |node| yield node }
+        fragment.to_html
+      end
+
+      def strip_local_reference(node)
+        %w[ sgid url href ].each { |attribute| node.remove_attribute(attribute) }
+      end
+  end
+end
