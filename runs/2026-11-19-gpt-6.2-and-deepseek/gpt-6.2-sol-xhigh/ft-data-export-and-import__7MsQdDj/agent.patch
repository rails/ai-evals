+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @download_url = account_export_url(export.download_token, script_name: export.account.slug)
+    mail to: export.user.identity.email_address, subject: "Your Fizzy #{export.kind_account? ? 'account' : 'card'} export is ready"
