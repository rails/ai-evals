+  def storage_key
+    "#{self.class.table_name}/#{id}.zip"
+  end
+
+  private
+    def delete_archive
+      service.delete(storage_key)
+    end
+end
diff --git a/app/models/account/data_transfer/card_archive.rb b/app/models/account/data_transfer/card_archive.rb
new file mode 100644
index 0000000..3056c79
--- /dev/null
+++ b/app/models/account/data_transfer/card_archive.rb
@@ -0,0 +1,39 @@
+class Account::DataTransfer::CardArchive
+  def initialize(cards)
+    @cards = cards
+    @written_files = Set.new
+  end
+
+  def write(zip, include_files: true)
+    @cards.includes(:board, :creator, image_attachment: :blob,
+      rich_text_description: { embeds_attachments: :blob },
+      comments: [ :creator, { rich_text_body: { embeds_attachments: :blob } } ]).find_each(batch_size: 100) do |card|
+      description = Account::DataTransfer::RichText.new(card.rich_text_description)
+      image = card.image.blob if card.image.attached? && Account::DataTransfer.blob_account_ids(card.account_id).include?(card.image.blob.account_id)
+      data = card.attributes.slice("number", "title", "status", "created_at", "updated_at", "due_on").merge(
+        board: card.board.name, creator: card.creator.name, description: description.portable_html(for_card: true),
+        image: image && file_details(image), files: describe_files(zip, description.blobs + Array(image), include_files: include_files),
+        comments: card.comments.sort_by { |comment| [ comment.created_at, comment.id ] }.map do |comment|
+          body = Account::DataTransfer::RichText.new(comment.rich_text_body)
+          { creator: comment.creator.name, created_at: comment.created_at, updated_at: comment.updated_at,
+            body: body.portable_html(for_card: true), files: describe_files(zip, body.blobs, include_files: include_files) }
+        end
+      )
+      zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(data))
+    end
+  end
+
+  private
+    def describe_files(zip, blobs, include_files:)
+      blobs.uniq.map do |blob|
+        if include_files && @written_files.add?(blob.id)
+          Account::DataTransfer::ActiveStorage::FileRecordSet.write(zip, blob)
+        end
+        file_details(blob)
+      end
+    end
+
+    def file_details(blob)
+      { path: Account::DataTransfer.file_path(blob.id, blob.filename), filename: blob.filename.to_s, content_type: blob.content_type, byte_size: blob.byte_size }
+    end
+end
