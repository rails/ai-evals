@@ -0,0 +1,31 @@
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  COLLECTIONS = { "boards" => "Board", "tags" => "Tag", "assignees" => "User", "creators" => "User", "closers" => "User" }.freeze
+
+  def initialize(account)
+    super(account: account, model: Filter, attributes: Filter.column_names - %w[ params_digest ])
+  end
+
+  def restore(zip, destination)
+    zip.each_json(path) do |row|
+      filter = model.new(import_attributes(row, destination))
+      COLLECTIONS.each do |name, type|
+        filter.public_send("#{name.singularize}_ids=", destination.resolve_all(type, row[name]))
+      end
+      filter.save!
+    end
+  end
+
+  private
+    def export_attributes(record)
+      super.merge(COLLECTIONS.keys.index_with { |name| record.public_send(name).ids })
+    end
+
+    def import_attributes(row, destination)
+      super.tap do |imported|
+        if fields = imported["fields"]
+          fields["card_ids"] = destination.resolve_all("Card", fields["card_ids"]) if fields.key?("card_ids")
+          fields["column_ids"] = destination.resolve_all("Column", fields["column_ids"]) if fields.key?("column_ids")
+        end
+      end
+    end
+end
