diff --git a/docs/data-transfers.md b/docs/data-transfers.md
new file mode 100644
index 0000000..371582b
--- /dev/null
+++ b/docs/data-transfers.md
@@ -0,0 +1,11 @@
+# Exporting and importing Fizzy data
+
+Admins can request an account ZIP from **Account Settings → Account data**. To download just the cards you can access, use **Card data** on your own profile. Fizzy emails the requester when the ZIP is ready. To use the link, sign in as the requester within 24 hours.
+
+Both ZIPs contain JSON files in `cards/`, with comments and paths to the original attachments in `files/`. An account ZIP also contains the records needed for a restore. A profile ZIP is for reading or processing your cards outside Fizzy; it cannot be used to restore an account.
+
+Sign in and visit `/account/imports/new` to restore an account ZIP. Fizzy creates a separate account and makes the uploader an owner. Existing accounts are unchanged. Members are matched by email address; authentication credentials and sessions are not transferred. Webhooks are restored disabled with new signing secrets, and published boards and join links receive new URLs. Fizzy emails the uploader with the result. Keep the original ZIP intact for import.
+
+## Self-hosted storage
+
+Transfers use the configured private Active Storage service (Disk or S3). Large archives use ZIP64, and S3 exports use multipart streaming. The import form uploads via the application server: configure any reverse proxy's upload size and time limits and provision temporary disk space for the request body and extracted attachments. With Disk storage, allow space for a temporary export as well as the saved ZIP. Use S3's lifecycle setting to abort incomplete multipart uploads if a worker is interrupted. Completed export ZIPs are removed after expiry by the recurring cleanup job.
diff --git a/test/integration/data_transfer_test.rb b/test/integration/data_transfer_test.rb
new file mode 100644
index 0000000..2de6255
--- /dev/null
+++ b/test/integration/data_transfer_test.rb
@@ -0,0 +1,235 @@
+require "test_helper"
+require "zip"
+
+class DataTransferTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "an administrator can export an account and restore its data and attachments to a new account" do
+    sign_in_as :kevin
+    card, file, image = add_card_files
+
+    get account_settings_path
+    assert_select "form[action='#{account_exports_path}']"
+
+    export = export_account
+    with_archive(export) do |zip|
+      data = JSON.parse(zip.read("cards/#{card.number}.json"))
+      assert_equal card.title, data.fetch("title")
+      assert data.fetch("comments").any? { |comment| comment.fetch("body").include?("I agree.") }
+      assert_equal image.download, zip.read(data.dig("image", "path"))
+      assert_equal file.download, zip.read(data.fetch("comments").flat_map { |comment| comment.fetch("files") }.sole.fetch("path"))
+    end
+
+    assert_difference [ "Account.count", "ActionMailer::Base.deliveries.size" ], 1 do
+      upload_export(export)
+    end
+    assert_redirected_to "/account/imports/new"
+
+    import = Account::Import.last
+    restored = import.account
+    assert_not import.service.exist?(import.storage_key)
+    assert_equal accounts("37s").name, restored.name
+    assert_not_equal accounts("37s").external_account_id, restored.external_account_id
+    assert_equal accounts("37s").boards.count, restored.boards.count
+    assert_equal accounts("37s").cards.count, restored.cards.count
+    assert_equal accounts("37s").users.count, restored.users.count
+    assert restored.users.owner.exists?(identity: identities(:kevin))
+    assert restored.users.find_by!(identity: identities(:david)).boards.exists?(name: boards(:writebook).name)
+    assert_not restored.users.find_by!(identity: identities(:david)).boards.exists?(name: boards(:private).name)
+    assert_equal users(:jz).identity, Filter.find_by!(account: restored).assignees.sole.identity
+
+    imported_card = restored.cards.find_by!(number: card.number)
+    assert_not_equal card.id, imported_card.id
+    assert_equal card.title, imported_card.title
+    assert_equal card.column.name, imported_card.column.name
+    assert_equal card.created_at, imported_card.created_at
+    assert_equal image.download, imported_card.image.download
+    assert_not_equal image.key, imported_card.image.key
+    assert_equal card.comments.count, imported_card.comments.count
+    imported_body = imported_card.comments.find_by!(creator: restored.users.find_by!(identity: identities(:jz))).body
+    assert_equal file.download, imported_body.embeds.sole.download
+    assert_equal imported_body.embeds.sole.blob, imported_body.body.attachables.grep(ActiveStorage::Blob).sole
+    assert_equal restored.users.find_by!(identity: identities(:david)), imported_body.body.attachables.grep(User).sole
+    assert_equal image.byte_size + file.byte_size, restored.bytes_used_exact
+    assert_includes ActionMailer::Base.deliveries.last.text_part.decoded, "#{restored.slug}/"
+  end
+
+  test "members can export from their own profile but cannot export the account or another profile" do
+    sign_in_as :david
+    card, file, = add_card_files
+    private_card = with_current_user(users(:kevin)) do
+      boards(:private).cards.create!(title: "Private card", creator: users(:kevin), status: :published)
+    end
+    own_draft = boards(:writebook).cards.create!(title: "My draft", creator: users(:david))
+    other_draft = boards(:writebook).cards.create!(title: "Their draft", creator: users(:kevin))
+
+    assert_no_difference "Account::Export.count" do
+      post account_exports_path
+      assert_response :forbidden
+      post user_exports_path(users(:kevin))
+      assert_response :forbidden
+    end
+
+    get user_path(users(:david))
+    assert_select "form[action='#{user_exports_path(users(:david))}']"
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      perform_enqueued_jobs { post user_exports_path(users(:david)) }
+    end
+    assert_redirected_to user_path(users(:david))
+
+    export = Account::Export.last
+    with_archive(export) do |zip|
+      assert_nil zip.find_entry("manifest.json")
+      assert_nil zip.find_entry("cards/#{private_card.number}.json")
+      assert_nil zip.find_entry("cards/#{other_draft.number}.json")
+      assert zip.find_entry("cards/#{own_draft.number}.json")
+      data = JSON.parse(zip.read("cards/#{card.number}.json"))
+      assert_equal file.download, zip.read(data.fetch("comments").flat_map { |comment| comment.fetch("files") }.sole.fetch("path"))
+    end
+
+    path = account_export_path(export.download_token)
+    get path
+    assert_response :redirect
+    users(:david).accesses.where(board: boards(:writebook)).delete_all
+    get path
+    assert_response :not_found
+  end
+
+  test "the emailed link downloads a zip for its requester and expires after one day" do
+    sign_in_as :kevin
+    export = export_account
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:kevin).email_address ], mail.to
+    path = URI(mail.text_part.decoded[/https?:\/\/\S+/]).request_uri
+
+    get path
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+    assert_match(/attachment.*\.zip/, response.headers["Content-Disposition"])
+    assert_equal "PK", response.body[0, 2]
+
+    logout_and_sign_in_as :jason
+    get path
+    assert_response :not_found
+    logout_and_sign_in_as :kevin
+
+    travel 23.hours do
+      get path
+      assert_response :redirect
+    end
+    travel 1.day + 1.second do
+      get path
+      assert_response :not_found
+      Account::Export.cleanup
+      assert_not Account::Export.exists?(export.id)
+      assert_not export.service.exist?(export.storage_key)
+    end
+  end
+
+  test "an identity without a membership can restore an account and become its owner" do
+    get "/account/imports/new"
+    assert_response :redirect
+
+    sign_in_as :kevin
+    export = export_account
+    importer = Identity.create!(email_address: "importer@example.com")
+    reset!
+    sign_in_as importer
+    get "/account/imports/new"
+    assert_response :success
+    assert_select "input[type=file][name='import[archive]']"
+
+    assert_difference "Account.count", 1 do
+      upload_export(export)
+    end
+
+    restored = Account::Import.last.account
+    assert restored.users.owner.exists?(identity: importer)
+    assert_equal restored.boards.count, restored.users.find_by!(identity: importer).boards.count
+    assert_equal [ importer.email_address ], ActionMailer::Base.deliveries.last.to
+  end
+
+  test "an invalid zip sends a reason and leaves no account" do
+    sign_in_as :david
+    Tempfile.create([ "invalid", ".zip" ]) do |archive|
+      archive.write("not a zip file")
+      archive.flush
+      assert_no_difference "Account.count" do
+        assert_difference "ActionMailer::Base.deliveries.size", 1 do
+          perform_enqueued_jobs { upload_archive(archive.path) }
+        end
+      end
+    end
+
+    import = Account::Import.last
+    assert_not import.service.exist?(import.storage_key)
+    assert_includes ActionMailer::Base.deliveries.last.text_part.decoded, "not a readable ZIP file"
+  end
+
+  test "failure after staging files and writing account data rolls back the entire import" do
+    sign_in_as :kevin
+    add_card_files
+    export = export_account
+    # Omit the final set of database records, after all files were staged and linked to blobs.
+    ZipFile.create(service: export.service, key: export.storage_key) do |zip|
+      zip.add_file("manifest.json", Account::DataTransfer::FORMAT.to_json, compress: false)
+      Account::DataTransfer::Manifest.new(accounts("37s")).each_record_set do |record_set|
+        record_set.write(zip) unless record_set.is_a?(Account::DataTransfer::ActiveStorage::AttachmentRecordSet)
+      end
+    end
+
+    assert_no_difference [ "Account.count", "Board.count", "Card.count", "Comment.count", "User.count", "ActiveStorage::Blob.count" ] do
+      assert_difference "ActionMailer::Base.deliveries.size", 1 do
+        upload_export(export)
+      end
+    end
+
+    import = Account::Import.last
+    assert_nil import.account
+    assert_includes import.failure_reason, "active_storage_attachments.jsonl"
+    assert_not import.service.exist?(import.storage_key)
+    assert_empty Dir.glob("#{import.service.path_for(import.files_prefix)}/*")
+  end
+
+  private
+    def export_account
+      assert_difference "ActionMailer::Base.deliveries.size", 1 do
+        perform_enqueued_jobs { post account_exports_path }
+      end
+      assert_redirected_to account_settings_path
+      Account::Export.last.tap { |export| assert export.ready? }
+    end
+
+    def add_card_files
+      Current.with_account(accounts("37s")) do
+        card = cards(:logo)
+        file = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("notes for the team\n"), filename: "notes.txt")
+        comment = comments(:logo_agreement_jz)
+        comment.update!(body: comment.body.body.append_attachables([ file, users(:david) ]))
+        file_fixture("moon.jpg").open { |io| card.image.attach(io: io, filename: "moon.jpg") }
+        [ card, file, card.image.blob ]
+      end
+    end
+
+    def with_archive(export)
+      Tempfile.create([ "account", ".zip" ], binmode: true) do |archive|
+        export.service.download(export.storage_key) { |chunk| archive.write(chunk) }
+        archive.flush
+        Zip::File.open(archive.path) { |zip| yield zip }
+      end
+    end
+
+    def upload_export(export)
+      Tempfile.create([ "account", ".zip" ], binmode: true) do |archive|
+        export.service.download(export.storage_key) { |chunk| archive.write(chunk) }
+        archive.flush
+        perform_enqueued_jobs { upload_archive(archive.path) }
+      end
+    end
+
+    def upload_archive(path)
+      post "/account/imports", params: { import: { archive: Rack::Test::UploadedFile.new(path, "application/zip") } }
+    end
+end
