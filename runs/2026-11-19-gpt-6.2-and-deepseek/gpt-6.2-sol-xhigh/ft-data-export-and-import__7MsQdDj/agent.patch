diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..02f2728
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,121 @@
+require "zip"
+
+class ZipFile::Reader
+  class InvalidArchive < StandardError; end
+
+  MAX_ENTRIES = 2_000_000
+  MAX_JSON_LINE_SIZE = 16.megabytes
+
+  # Timestamps from local extra fields aren't used. Skipping them lets the
+  # directory be read sequentially instead of doing two range reads per entry.
+  class CentralDirectory < Zip::CentralDirectory
+    private
+      def read_local_extra_field(_io)
+        "".b
+      end
+  end
+  private_constant :CentralDirectory
+
+  def initialize(io)
+    @streams = [ io ]
+    @depth = 0
+    @size = io.size
+    entry_count = Zip::File.count_entries(io)
+    raise InvalidArchive, "The ZIP contains too many entries." if entry_count > MAX_ENTRIES
+
+    @zip = CentralDirectory.new
+    @zip.read_from_stream(io)
+    raise InvalidArchive, "The ZIP has duplicate or missing entries." unless @zip.size == entry_count
+  rescue Zip::Error, EOFError, IOError, Errno::EINVAL, ArgumentError, RangeError
+    raise InvalidArchive, "The archive is not a readable ZIP file."
+  end
+
+  def exists?(path)
+    @zip.find_entry(path).present?
+  end
+
+  def read(path, limit:)
+    buffer = "".b
+    stream(path, limit: limit) { |chunk| buffer << chunk }
+    buffer
+  end
+
+  def each_json(path, with_size: false)
+    each_line(path) do |line|
+      record = parse_line(line)
+      if with_size
+        yield record, line.bytesize
+      else
+        yield record
+      end
+    end
+  end
+
+  def stream(path, limit:)
+    io = (@streams[@depth] ||= @streams.first.dup)
+    @depth += 1
+    entry = @zip.find_entry(path)
+    raise InvalidArchive, "The archive is missing #{path}." unless entry
+    # The restorable part of a Fizzy archive is always stored, not compressed.
+    unless entry.file? && !entry.encrypted? && entry.compression_method == Zip::Entry::STORED &&
+        entry.size == entry.compressed_size && entry.size.between?(0, [ limit, @size ].min)
+      raise InvalidArchive, "Invalid file in the archive: #{path}."
+    end
+
+    io.seek(entry.local_header_offset)
+    local = local_entry(io)
+    unless local&.name == path && local.compression_method == Zip::Entry::STORED &&
+        !local.encrypted? && io.tell + entry.size <= @size
+      raise InvalidArchive, "Invalid file header in the archive: #{path}."
+    end
+
+    size = crc = 0
+    while size < entry.size && (chunk = io.read([ 64.kilobytes, entry.size - size ].min))
+      size += chunk.bytesize
+      crc = Zlib.crc32(chunk, crc)
+      yield chunk
+    end
+    unless size == entry.size && crc == entry.crc
+      raise InvalidArchive, "The archive contains a damaged file: #{path}."
+    end
+  rescue Zip::Error, EOFError, Errno::EINVAL
+    raise InvalidArchive, "The archive contains an unreadable file: #{path}."
+  ensure
+    @depth -= 1
+  end
+
+  private
+    def each_line(path)
+      pending = "".b
+      stream(path, limit: @size) do |chunk|
+        lines = chunk.split("\n", -1)
+        pending << lines.shift.to_s
+        if lines.any?
+          yield pending
+          pending = lines.pop
+          lines.each { |line| yield line }
+        end
+        check_line_size(pending)
+      end
+      raise InvalidArchive, "A record in the archive is incomplete." unless pending.empty?
+    end
+
+    def local_entry(io)
+      Zip::Entry.read_local_entry(io)
+    rescue ArgumentError, RangeError, NoMethodError
+      nil
+    end
+
+    def parse_line(line)
+      check_line_size(line)
+      JSON.parse(line).tap do |record|
+        raise InvalidArchive, "An archive record isn't a JSON object." unless record.is_a?(Hash)
+      end
+    rescue JSON::ParserError
+      raise InvalidArchive, "An archive record contains invalid JSON."
+    end
+
+    def check_line_size(line)
+      raise InvalidArchive, "An archive record is too large." if line.bytesize > MAX_JSON_LINE_SIZE
+    end
+end
diff --git a/app/models/zip_file/storage_io.rb b/app/models/zip_file/storage_io.rb
new file mode 100644
index 0000000..1bb5f4d
--- /dev/null
+++ b/app/models/zip_file/storage_io.rb
@@ -0,0 +1,63 @@
+# A seekable view of an archive in object storage. ZIP readers consult the directory
+# at the end of the archive before reading individual entries.
+class ZipFile::StorageIO
+  CHUNK_SIZE = 5.megabytes
+
+  attr_reader :size, :pos
+  alias_method :tell, :pos
+
+  def initialize(service, key, size)
+    @service, @key, @size = service, key, size
+    @pos = 0
+  end
+
+  def seek(offset, whence = IO::SEEK_SET)
+    position = case whence
+    when IO::SEEK_SET then offset
+    when IO::SEEK_CUR then @pos + offset
+    when IO::SEEK_END then size + offset
+    end
+    raise Errno::EINVAL unless position && position >= 0
+
+    @pos = position
+    0
+  end
+
+  def read(length = size - @pos, buffer = nil)
+    raise IOError, "Oversized ZIP read" if length > CHUNK_SIZE || length < 0
+
+    buffer = buffer ? buffer.clear : "".b
+    return buffer if length.zero?
+    return nil if eof?
+
+    remaining = [ length, size - @pos ].min
+    while remaining > 0
+      ensure_chunk
+      offset = @pos - @chunk_start
+      count = [ remaining, @chunk.bytesize - offset ].min
+      buffer << @chunk.byteslice(offset, count)
+      @pos += count
+      remaining -= count
+    end
+    buffer
+  end
+
+  def eof?
+    @pos >= size
+  end
+  alias_method :eof, :eof?
+
+  def close
+    @chunk = nil
+  end
+
+  private
+    def ensure_chunk
+      unless @chunk && @pos >= @chunk_start && @pos < @chunk_start + @chunk.bytesize
+        @chunk_start = @pos
+        range = @pos...[ @pos + CHUNK_SIZE, size ].min
+        @chunk = @service.download_chunk(@key, range)
+        raise IOError, "Incomplete archive read" unless @chunk&.bytesize == range.size
+      end
+    end
+end
