index 0000000..e597012
--- /dev/null
+++ b/app/models/account/data_transfer/restoration.rb
@@ -0,0 +1,138 @@
+class Account::DataTransfer::Restoration
+  InvalidArchive = Account::DataTransfer::InvalidArchive
+  ARCHIVE_ID = /\A[0-9a-z]{25}\z/
+
+  attr_reader :account
+
+  def initialize(import)
+    @import = import
+    @ids = Hash.new { |hash, type| hash[type] = {} }
+    @blobs = []
+  end
+
+  def restore(zip)
+    validate_format(zip)
+    Account::DataTransfer::ActiveStorage::BlobRecordSet.new(nil).stage(zip, self)
+
+    @import.with_lock(requires_new: true) do
+      return if @import.finished?
+
+      Account::DataTransfer::Manifest.new(nil).each_record_set { |set| set.restore(zip, self) }
+      finish_account
+      @import.update!(account: account)
+    end
+  rescue
+    @signup&.cancel_import_provisioning
+    raise
+  end
+
+  def create_account(attributes)
+    name = attributes["name"]
+    unless name.is_a?(String) && name.present? && name.length <= 255
+      raise InvalidArchive, "The archive has an invalid account name."
+    end
+
+    identity = @import.identity
+    @signup = Signup.new(identity: identity, full_name: identity.users.active.first&.name || identity.email_address)
+    external_id = @signup.provision_import(name) || Account::ExternalIdSequence.next
+    id = register("Account", attributes["id"])
+    Account.insert_all!([ attributes.merge("id" => id, "external_account_id" => external_id) ])
+    @account = Account.find(id)
+    account.create_join_code!
+  end
+
+  def register(type, source_id)
+    unless source_id.is_a?(String) && ARCHIVE_ID.match?(source_id) && !@ids[type].key?(source_id)
+      raise InvalidArchive, "Invalid or duplicate #{type} ID in the archive."
+    end
+    @ids[type][source_id] = ActiveRecord::Type::Uuid.generate
+  end
+
+  def resolve(type, source_id)
+    @ids[type].fetch(source_id) { raise InvalidArchive, "A #{type} referenced in the archive is missing." }
+  end
+
+  def resolve_all(type, source_ids)
+    Array(source_ids).filter_map { |source_id| @ids[type][source_id] }
+  end
+
+  def stage_blob(zip, attributes)
+    source_id = attributes.fetch("id")
+    id = register("ActiveStorage::Blob", source_id)
+    size = attributes["byte_size"]
+    filename = attributes["filename"]
+    unless filename.is_a?(String) && filename.present? && filename.length <= 255
+      raise InvalidArchive, "The archive has an invalid attachment filename."
+    end
+    unless size.is_a?(Integer) && size >= 0
+      raise InvalidArchive, "The archive has an invalid attachment size."
+    end
+
+    Tempfile.create([ "fizzy-attachment", ".upload" ], binmode: true) do |file|
+      zip.stream(Account::DataTransfer.file_path(source_id, filename), limit: size) { |chunk| file.write(chunk) }
+      raise InvalidArchive, "An attachment has the wrong size." unless file.size == size
+
+      file.rewind
+      blob = ActiveStorage::Blob.build_after_unfurling(
+        io: file, filename: filename, content_type: attributes["content_type"], identify: false,
+        metadata: attributes["metadata"], key: "#{@import.files_prefix}#{id}", service_name: @import.service_name
+      )
+      blob.upload_without_unfurling(file)
+      @blobs << blob.attributes.slice(*ActiveStorage::Blob.column_names).merge("id" => id, "created_at" => attributes["created_at"])
+    end
+  end
+
+  def restore_blobs
+    @blobs.each_slice(100) do |batch|
+      ActiveStorage::Blob.insert_all!(batch.map { |row| row.merge("account_id" => account.id) })
+    end
+  end
+
+  private
+    def validate_format(zip)
+      unless zip.exists?("manifest.json")
+        raise InvalidArchive, "Choose an account ZIP exported from Account Settings, not a profile card export."
+      end
+
+      header = JSON.parse(zip.read("manifest.json", limit: 4.kilobytes))
+      raise InvalidArchive, "This is not a supported Fizzy account export." unless header == Account::DataTransfer::FORMAT
+    rescue JSON::ParserError
+      raise InvalidArchive, "The account archive has an invalid manifest."
+    end
+
+    def finish_account
+      ensure_account_defaults
+      owner = restore_owner
+      account.boards.find_each do |board|
+        board.accesses.grant_to(owner)
+        board.reconcile_storage
+        board.materialize_storage
+      end
+      account.update!(cards_count: [ account.cards_count, account.cards.maximum(:number).to_i ].max)
+      account.reconcile_storage
+      account.materialize_storage
+      account.cards.published.with_rich_text_description.find_each(&:reindex)
+      Comment.where(account: account).includes(:card, :rich_text_body).find_each(&:reindex)
+    end
+
+    def ensure_account_defaults
+      unless account.entropy
+        Entropy.insert_all!([ { id: ActiveRecord::Type::Uuid.generate, account_id: account.id, container_id: account.id,
+          container_type: "Account", auto_postpone_period: Account::Entropic::DEFAULT_ENTROPY_PERIOD.to_i } ])
+      end
+      unless account.users.exists?(role: :system)
+        account.users.insert_all!([ { id: ActiveRecord::Type::Uuid.generate, name: "System", role: :system } ])
+      end
+    end
+
+    def restore_owner
+      attributes = { role: :owner, active: true, verified_at: Time.current }
+      if owner = account.users.find_by(identity: @import.identity)
+        owner.update_columns(attributes)
+        owner
+      else
+        account.users.insert_all!([ attributes.merge(id: ActiveRecord::Type::Uuid.generate, name: @signup.full_name, identity_id: @import.identity_id) ])
+        account.users.find_by!(identity: @import.identity)
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/rich_text.rb b/app/models/account/data_transfer/rich_text.rb
new file mode 100644
index 0000000..80c462f
--- /dev/null
+++ b/app/models/account/data_transfer/rich_text.rb
@@ -0,0 +1,81 @@
+class Account::DataTransfer::RichText
+  BLOB_ATTRIBUTE = "data-fizzy-blob"
+  USER_ATTRIBUTE = "data-fizzy-user"
+
+  def self.restore(body, destination)
+    fragment = Nokogiri::HTML5.fragment(body.to_s)
+    fragment.css("[data-trix-attachment]").each { |node| node.remove_attribute("data-trix-attachment") }
+    fragment.css(ActionText::Attachment.tag_name).each do |node|
+      # Never let an uploaded archive carry a signed reference to another tenant.
+      node.remove_attribute("sgid")
+      if id = node.remove_attribute(BLOB_ATTRIBUTE)&.value
+        node.remove_attribute("href")
+        node.remove_attribute("url")
+        blob = ActiveStorage::Blob.find(destination.resolve("ActiveStorage::Blob", id))
+        Current.with_account(destination.account) do
+          blob.to_rich_text_attributes.each { |name, value| node[name.to_s.dasherize] = value.to_s }
+        end
+      elsif id = node.remove_attribute(USER_ATTRIBUTE)&.value
+        user = User.find(destination.resolve("User", id))
+        node["sgid"] = user.attachable_sgid
+      end
+    end
+    fragment.to_html
+  end
+
+  def initialize(record)
+    @record = record
+  end
+
+  def portable_html(for_card: false)
+    if @record&.body
+      fragment = Nokogiri::HTML5.fragment(@record.body.to_html)
+      fragment.css(ActionText::Attachment.tag_name).each do |node|
+        make_portable(node, for_card: for_card)
+      end
+      fragment.to_html
+    else
+      ""
+    end
+  end
+
+  def blobs
+    if @record
+      permitted_accounts = Account::DataTransfer.blob_account_ids(@record.account_id)
+      @record.embeds_attachments.map(&:blob).select { |blob| permitted_accounts.include?(blob.account_id) }
+    else
+      []
+    end
+  end
+
+  private
+    def make_portable(node, for_card:)
+      node.remove_attribute(BLOB_ATTRIBUTE)
+      node.remove_attribute(USER_ATTRIBUTE)
+      if sgid = node.remove_attribute("sgid")&.value
+        node.remove_attribute("href")
+        node.remove_attribute("url")
+        if blob = blobs_by_sgid[sgid]
+          if for_card
+            node["url"] = "../#{Account::DataTransfer.file_path(blob.id, blob.filename)}"
+          else
+            node[BLOB_ATTRIBUTE] = blob.id
+          end
+        elsif user = GlobalID::Locator.locate_signed(sgid, for: ActionText::Attachable::LOCATOR_NAME, only: User)
+          if user.account_id == @record.account_id
+            if for_card
+              node.replace(Nokogiri::XML::Text.new("@#{user.name}", node.document))
+            else
+              node[USER_ATTRIBUTE] = user.id
+            end
+          end
+        end
+      end
+    rescue ActiveRecord::RecordNotFound
+      # Deleted mentions are allowed in historical text; drop their stale reference.
+    end
+
+    def blobs_by_sgid
+      @blobs_by_sgid ||= blobs.index_by(&:attachable_sgid)
+    end
+end
