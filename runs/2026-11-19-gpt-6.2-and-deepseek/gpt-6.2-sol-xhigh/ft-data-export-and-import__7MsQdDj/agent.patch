 end
diff --git a/app/models/account/export.rb b/app/models/account/export.rb
new file mode 100644
index 0000000..327acf4
--- /dev/null
+++ b/app/models/account/export.rb
@@ -0,0 +1,79 @@
+class Account::Export < ApplicationRecord
+  include Account::DataTransfer::ArchiveStorage
+
+  LIFETIME = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  enum :kind, %w[ account cards ].index_by(&:itself), prefix: true
+
+  def self.cleanup
+    where(ready_at: ...LIFETIME.ago).or(where(ready_at: nil, created_at: ...1.week.ago)).find_each(&:destroy!)
+  end
+
+  def prepare_later
+    Account::ExportJob.perform_later(self)
+  end
+
+  def prepare_now
+    return if ready_at? || !permitted_for?(user)
+
+    board_ids = accessible_board_ids if kind_cards?
+    ZipFile.create(service: service, key: storage_key) do |zip|
+      if kind_account?
+        zip.add_file("manifest.json", Account::DataTransfer::FORMAT.to_json, compress: false)
+        Account::DataTransfer::Manifest.new(account).each_record_set { |set| set.write(zip) }
+        Account::DataTransfer::CardArchive.new(account.cards).write(zip, include_files: false)
+      else
+        Account::DataTransfer::CardArchive.new(visible_cards(board_ids)).write(zip)
+      end
+    end
+    update!(ready_at: Time.current, board_access_digest: board_ids && board_digest(board_ids))
+    DataTransferMailer.export_ready(self).deliver_later
+  rescue
+    delete_archive unless ready_at?
+    raise
+  end
+
+  def ready?
+    ready_at? && expires_at.future?
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_at: expires_at)
+  end
+
+  def downloadable_by?(requester)
+    ready? && permitted_for?(requester) && (kind_account? || board_access_digest == board_digest(accessible_board_ids))
+  end
+
+  def download_url
+    service.url(storage_key, expires_in: [ (expires_at - Time.current).ceil, 5.minutes.to_i ].min,
+      filename: ActiveStorage::Filename.new("fizzy-#{kind}-#{ready_at.to_date}.zip"),
+      content_type: "application/zip", disposition: :attachment)
+  end
+
+  private
+    def visible_cards(board_ids)
+      cards = account.cards.where(board_id: board_ids)
+      cards.published.or(cards.drafted.where(creator: user))
+    end
+
+    def accessible_board_ids
+      user.boards.where(account: account).order(:id).ids
+    end
+
+    def board_digest(board_ids)
+      Digest::SHA256.hexdigest(board_ids.join(","))
+    end
+
+    def permitted_for?(requester)
+      account.active? && requester == user && requester.active? && requester.identity.present? &&
+        requester.account_id == account_id && (!kind_account? || requester.admin?)
+    end
+
+    def expires_at
+      ready_at + LIFETIME
+    end
+end
diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..4153e0d
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,70 @@
+class Account::Import < ApplicationRecord
+  include Account::DataTransfer::ArchiveStorage
+
+  belongs_to :account, optional: true
+  belongs_to :identity
+
+  before_destroy :delete_failed_files
+
+  def self.cleanup
+    where(created_at: ...1.week.ago).find_each(&:destroy!)
+  end
+
+  def stage(archive)
+    storage = service
+    self.byte_size = archive.size
+    save!
+    storage.upload(storage_key, archive.tempfile, content_type: "application/zip")
+    true
+  rescue StandardError => error
+    Rails.error.handle { destroy! } if persisted?
+    Rails.error.report(error)
+    errors.add(:base, "The archive could not be uploaded. Please try again.")
+    false
+  end
+
+  def restore_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def restore_now
+    return if finished?
+
+    restore_archive
+    DataTransferMailer.import_finished(self).deliver_later
+  ensure
+    if finished?
+      Rails.error.handle { delete_archive }
+      Rails.error.handle { delete_failed_files }
+    end
+  end
+
+  def finished?
+    account_id? || failure_reason?
+  end
+
+  def files_prefix
+    "account_imports/#{id}/files/"
+  end
+
+  private
+    def delete_failed_files
+      service.delete_prefixed(files_prefix) unless account_id?
+    end
+
+    def restore_archive
+      ZipFile.read(service: service, key: storage_key, byte_size: byte_size) do |zip|
+        Account::DataTransfer::Restoration.new(self).restore(zip)
+      end
+    rescue Account::DataTransfer::InvalidArchive => error
+      update!(failure_reason: error.message.truncate(255))
+    rescue ActiveStorage::FileNotFoundError
+      update!(failure_reason: "The uploaded archive could not be found.")
+    rescue ActiveRecord::RecordInvalid, ActiveRecord::StatementInvalid => error
+      Rails.error.report(error)
+      update!(failure_reason: "The archive contains invalid or conflicting account records.")
+    rescue StandardError => error
+      Rails.error.report(error)
+      update!(failure_reason: "The account could not be restored. Check that you uploaded an intact Fizzy account export and try again.")
+    end
+end
