+  InvalidArchive = Account::DataTransfer::InvalidArchive
+
+  POLYMORPHIC_TYPES = {
+    "Entropy" => { "container" => %w[ Account Board ] },
+    "Mention" => { "source" => %w[ Card Comment ] },
+    "Reaction" => { "reactable" => %w[ Card Comment ] },
+    "Event" => { "eventable" => %w[ Card Comment ] },
+    "Notification" => { "source" => %w[ Event Mention ] },
+    "ActionText::RichText" => { "record" => %w[ Board Card Comment ] },
+    "ActiveStorage::Attachment" => { "record" => %w[ User Board Card Comment ActionText::RichText ] }
+  }.freeze
+
+  REGENERATED_ATTRIBUTES = { "Board::Publication" => %w[ key ], "Webhook" => %w[ signing_secret ] }.freeze
 
   attr_reader :account, :model, :attributes
 
   def initialize(account:, model:, attributes: nil)
     @account = account
     @model = model
-    @attributes = (attributes || model.column_names).map(&:to_s)
+    @attributes = attributes || model.column_names - REGENERATED_ATTRIBUTES.fetch(model.name, [])
   end
 
-  private
-    attr_reader :zip
+  def write(zip)
+    zip.add_file(path, compress: false) do |output|
+      each_record { |record| output.write("#{export_attributes(record).to_json}\n") }
+    end
+  end
 
-    def with_zip(zip)
-      old_zip = @zip
-      @zip = zip
-      yield
-    ensure
-      @zip = old_zip
+  def restore(zip, destination)
+    batch = []
+    bytes = 0
+    zip.each_json(path, with_size: true) do |row, size|
+      batch << import_attributes(row, destination)
+      bytes += size
+      if batch.size >= 100 || bytes >= 1.megabyte
+        model.insert_all!(batch)
+        batch = []
+        bytes = 0
+      end
+    end
+    model.insert_all!(batch) if batch.any?
+  end
+
+  private
+    def each_record(&block)
+      records.find_each(&block)
     end
 
     def records
       model.where(account_id: account.id)
     end
 
-    def model_dir
-      model.table_name
+    def path
+      "records/#{model.table_name}.jsonl"
+    end
+
+    def export_attributes(record)
+      record.attributes.slice(*attributes).transform_values do |value|
+        value.respond_to?(:acts_like_time?) ? value.iso8601(6) : value
+      end
+    end
+
+    def import_attributes(row, destination)
+      row.slice(*attributes).tap do |imported|
+        imported["id"] = destination.register(model.name, row["id"])
+        imported["account_id"] = destination.account.id
+        model.reflect_on_all_associations(:belongs_to).each do |association|
+          key = association.foreign_key
+          if key != "account_id" && imported[key]
+            type = reference_type(association, row)
+            imported[key] = destination.resolve(type, imported[key])
+          end
+        end
+        reset_instance_specific_attributes(imported, destination)
+      end
+    end
+
+    def reference_type(association, row)
+      if association.polymorphic?
+        type = row[association.foreign_type]
+        allowed = POLYMORPHIC_TYPES.fetch(model.name).fetch(association.name.to_s)
+        raise InvalidArchive, "Invalid reference in #{model.table_name}." unless allowed.include?(type)
+        type
+      else
+        association.class_name
+      end
+    end
+
+    def reset_instance_specific_attributes(row, destination)
+      case model.name
+      when "Board::Publication"
+        row["key"] = SecureRandom.base58(32)
+      when "Webhook"
+        row["active"] = false
+        row["signing_secret"] = SecureRandom.base58(32)
+      when "Notification::Bundle"
+        row["status"] = "delivered"
+      when "Event"
+        if row["particulars"].is_a?(Hash) && row["particulars"].key?("assignee_ids")
