+module Account::DataTransfer::ArchiveStorage
+  extend ActiveSupport::Concern
+
+  included do
+    attribute :service_name, :string, default: -> { ActiveStorage::Blob.service.name }
+    before_destroy :delete_archive
+  end
+
+  def service
+    ActiveStorage::Blob.services.fetch(service_name).tap do |storage|
+      raise "Data transfers require private storage" if storage.public?
+    end
+  end
