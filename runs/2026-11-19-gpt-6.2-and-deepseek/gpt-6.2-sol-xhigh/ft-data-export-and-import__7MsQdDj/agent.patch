+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  layout "public"
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    @import = Account::Import.new(identity: Current.identity)
+    archive = params.expect(import: [ :archive ])[:archive]
+
+    if archive.is_a?(ActionDispatch::Http::UploadedFile) && archive.size.positive?
+      if @import.stage(archive)
+        @import.restore_later
+        redirect_to new_account_import_path, notice: "We’ll email you when your account import finishes.", status: :see_other
+      else
+        render :new, status: :unprocessable_entity
+      end
+    else
+      @import.errors.add(:base, "Choose a Fizzy account ZIP file to import.")
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def request_authentication
+      session[:return_to_after_authenticating] = request.url if request.get?
+      super
+    end
+end
