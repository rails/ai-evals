@@ -0,0 +1,26 @@
+require "test_helper"
+
+class Books::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  self.use_transactional_tests = false
+
+  test "a failed batch discards edit jobs but queues the operator notification" do
+    sign_in :kevin
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    assert_enqueued_jobs 1, only: Books::ImportFailureJob do
+      assert_no_enqueued_jobs(only: [ Book::CoverProcessingJob, Book::SearchIndexJob ]) do
+        post books_import_path, params: { books: {
+          handbook.id.to_s => { title: "Updated handbook", cover: file_fixture_upload("white-rabbit.webp") },
+          manual.id.to_s => { title: "Inaccessible manual" }
+        } }
+      end
+    end
+
+    assert_response :not_found
+    assert_equal "Handbook", handbook.reload.title
+    assert_not handbook.cover.attached?
+  end
+end
