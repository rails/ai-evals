diff --git a/config/initializers/cors.rb b/config/initializers/cors.rb
new file mode 100644
index 0000000..5831e40
--- /dev/null
+++ b/config/initializers/cors.rb
@@ -0,0 +1,18 @@
+require "uri"
+
+frontend_url = URI(ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001"))
+unless frontend_url.is_a?(URI::HTTP) && frontend_url.host.present? && frontend_url.userinfo.nil?
+  raise ArgumentError, "HELPDESK_FRONTEND_URL must be an HTTP(S) URL"
+end
+
+frontend_origin = frontend_url.normalize.origin.freeze
+Rails.configuration.x.helpdesk.frontend_origin = frontend_origin
+
+Rails.application.config.middleware.insert_before 0, Rack::Cors do
+  allow do
+    origins frontend_origin
+    resource "/api/v1/*",
+      headers: %w[Authorization Content-Type X-Helpdesk-Account],
+      methods: %i[get head post put patch delete options]
+  end
+end
