+module Api
+  module V1
+    class ProfilesController < BaseController
+      before_action :require_active_account
+      before_action :require_session
+
+      def show
+        render json: { user: user_json(@current_user) }
+      end
+
+      def update
+        @current_user.update!(params.expect(user: [:name]))
+        show
+      end
+
+      def update_password
+        change = params.expect(password_change: [:current_password, :password])
+        unless @current_user.authenticates?(change[:current_password])
+          return render_error("Current password is incorrect", :unprocessable_content)
+        end
+
+        @current_user.change_password!(change[:password])
+        head :no_content
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/sessions_controller.rb b/app/controllers/api/v1/sessions_controller.rb
