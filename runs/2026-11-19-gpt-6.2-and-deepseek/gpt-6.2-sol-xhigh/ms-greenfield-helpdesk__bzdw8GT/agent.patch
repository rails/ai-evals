--- /dev/null
+++ b/app/models/group_membership.rb
@@ -0,0 +1,49 @@
+class GroupMembership < ApplicationRecord
+  belongs_to :group
+  belongs_to :user
+
+  validates :user_id, uniqueness: { scope: :group_id }
+  validate :user_is_account_staff
+
+  before_create :select_initial_default
+  after_destroy :clean_up_routing
+
+  # Membership and ticket writes in the API are serialized by the account lock.
+  def make_default!
+    return if default?
+
+    transaction do
+      clear_default
+      update!(default: true)
+    end
+  end
+
+  private
+
+  def user_is_account_staff
+    unless user&.staff? && user.account_id == group&.account_id
+      errors.add(:user, "must be staff on the group's account")
+    end
+  end
+
+  def default_memberships
+    self.class.where(user_id: user_id, default: true)
+  end
+
+  def clear_default
+    default_memberships.update_all(default: false, updated_at: Time.current)
+  end
+
+  def select_initial_default
+    if default?
+      clear_default
+    else
+      self.default = !default_memberships.exists?
+    end
+  end
+
+  def clean_up_routing
+    Ticket.where(group_id: group_id, assignee_id: user_id).update_all(assignee_id: nil)
+    self.class.where(user_id: user_id).order(:id).first&.make_default! if default?
+  end
+end
diff --git a/app/models/invitation.rb b/app/models/invitation.rb
new file mode 100644
index 0000000..c2a22b2
--- /dev/null
+++ b/app/models/invitation.rb
@@ -0,0 +1,34 @@
+class Invitation < ApplicationRecord
+  LIFETIME = 7.days
+  STATUSES = %w[pending accepted revoked expired].freeze
+
+  belongs_to :account
+  normalizes :email, with: ->(email) { email.strip.downcase }
+  validates :email, length: { maximum: 254 }, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :role, inclusion: { in: User::STAFF_ROLES }
+
+  scope :unresolved, -> { where(accepted_at: nil, revoked_at: nil) }
+  scope :pending, -> { unresolved.where("expires_at > ?", Time.current) }
+
+  def self.with_status(status)
+    case status
+    when "pending" then pending
+    when "accepted" then where.not(accepted_at: nil)
+    when "revoked" then where.not(revoked_at: nil)
+    when "expired" then unresolved.where("expires_at <= ?", Time.current)
+    end
+  end
+
+  def status
+    return "accepted" if accepted_at
+    return "revoked" if revoked_at
+    expires_at > Time.current ? "pending" : "expired"
+  end
+
+  def deliver!
+    token = OpaqueToken.generate
+    update!(token_digest: OpaqueToken.digest(token), expires_at: LIFETIME.from_now)
+    mail = AccountMailer.with(email: email, subdomain: account.subdomain, token: token)
+    ActiveRecord.after_all_transactions_commit { mail.invitation.deliver_now }
+  end
+end
diff --git a/app/models/opaque_token.rb b/app/models/opaque_token.rb
new file mode 100644
index 0000000..3447f8e
--- /dev/null
+++ b/app/models/opaque_token.rb
@@ -0,0 +1,12 @@
+require "digest"
+require "securerandom"
+
+module OpaqueToken
+  def self.generate
+    SecureRandom.urlsafe_base64(32)
+  end
+
+  def self.digest(token)
+    Digest::SHA256.hexdigest(token) if token.is_a?(String) && token.match?(/\A[A-Za-z0-9_-]{43}\z/)
+  end
+end
