diff --git a/app/controllers/api/v1/invitations_controller.rb b/app/controllers/api/v1/invitations_controller.rb
new file mode 100644
index 0000000..4fae915
--- /dev/null
+++ b/app/controllers/api/v1/invitations_controller.rb
@@ -0,0 +1,56 @@
+module Api::V1
+  class InvitationsController < BaseController
+    before_action :require_active_account, :require_session, :require_admin
+    before_action :find_invitation, only: [:show, :resend, :destroy]
+
+    def index
+      scope = @account.invitations
+      if params.key?(:status)
+        return render_error("Invalid invitation status", :bad_request) unless Invitation::STATUSES.include?(params[:status])
+        scope = scope.with_status(params[:status])
+      end
+      render json: collection_page(scope, :invitations, filter_keys: %w[status]) { |invitation| invitation_json(invitation) }
+    end
+
+    def show
+      render json: { invitation: invitation_json(@invitation) }
+    end
+
+    def create
+      invitation = @account.invitations.build(params.expect(invitation: [:email, :role]))
+      raise ActiveRecord::RecordInvalid, invitation unless invitation.valid?
+      if find_user_by_email(invitation.email) || @account.invitations.pending.exists?(email: invitation.email)
+        return render_error("Email is already in use or invited", :unprocessable_content)
+      end
+      invitation.deliver!
+      render json: { invitation: invitation_json(invitation) }, status: :created
+    end
+
+    def resend
+      return not_pending unless @invitation.status == "pending"
+      @invitation.deliver!
+      show
+    end
+
+    def destroy
+      return not_pending unless @invitation.status == "pending"
+      @invitation.update!(revoked_at: Time.current)
+      head :no_content
+    end
+
+    private
+
+    def find_invitation
+      @invitation = @account.invitations.find_by(id: params[:id]) if params[:id].match?(/\A\d+\z/)
+      render_error("Invitation not found", :not_found) unless @invitation
+    end
+
+    def not_pending
+      render_error("Invitation is not pending", :unprocessable_content)
+    end
+
+    def invitation_json(invitation)
+      invitation.as_json(only: %i[id email role expires_at accepted_at revoked_at created_at updated_at], methods: :status)
+    end
+  end
+end
diff --git a/app/controllers/api/v1/password_resets_controller.rb b/app/controllers/api/v1/password_resets_controller.rb
new file mode 100644
index 0000000..616f973
--- /dev/null
+++ b/app/controllers/api/v1/password_resets_controller.rb
@@ -0,0 +1,36 @@
+module Api
+  module V1
+    class PasswordResetsController < BaseController
+      before_action :require_recoverable_account
+
+      def create
+        attributes = params.expect(password_reset: [:email])
+        user = find_user_by_email(attributes[:email])
+        EmailLink.deliver!(user, "password_reset") if can_recover?(user)
+        head :accepted
+      end
+
+      def confirm
+        attributes = params.expect(password_reset: [:token, :password])
+        link = find_email_link("password_reset", attributes[:token])
+        return invalid_email_link unless link && can_recover?(link.user)
+
+        # Also consumes the reset link and revokes any existing sessions.
+        link.user.change_password!(attributes[:password])
+        head :no_content
+      end
+
+      private
+
+      def require_recoverable_account
+        return if @account.active? || @account.reactivatable?
+
+        render_error("Account is cancelled", :forbidden)
+      end
+
+      def can_recover?(user)
+        user && (@account.active? || user.owner?)
+      end
+    end
+  end
+end
