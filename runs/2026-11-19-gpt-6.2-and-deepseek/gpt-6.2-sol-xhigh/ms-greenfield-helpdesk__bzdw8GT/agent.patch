+class ApplicationController < ActionController::API
+  wrap_parameters false
+
+  before_action { response.headers["Cache-Control"] = "no-store" }
+
+  rescue_from ActionController::ParameterMissing, ActionController::BadRequest do |error|
+    render_error(error.message, :bad_request)
+  end
+
+  rescue_from ActiveRecord::RecordInvalid do |error|
+    render json: { error: "Validation failed", details: error.record.errors.to_hash }, status: :unprocessable_content
+  end
+
+  rescue_from ActiveRecord::RecordNotUnique do
+    render_error("A record with those details already exists", :conflict)
+  end
+
+  private
+
+  def render_error(message, status)
+    render json: { error: message }, status: status
+  end
+end
