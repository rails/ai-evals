+  has_many :email_links
+  has_many :group_memberships
+  has_many :groups, through: :group_memberships
+  has_one :default_group_membership, -> { where(default: true) }, class_name: "GroupMembership"
+  has_one :default_group, through: :default_group_membership, source: :group
+
+  has_secure_password reset_token: false
+  enum :role, { member: "member", admin: "admin", agent: "agent" }, validate: true
+
+  normalizes :email, with: ->(value) { value.strip.downcase }
+
+  validates :name, presence: true, format: { without: /\x00/ }
+  validates :email, length: { maximum: 254 }, format: { with: URI::MailTo::EMAIL_REGEXP },
+    uniqueness: { scope: :account_id }
+
+  def password=(value)
+    super(value.is_a?(String) && value.present? && !value.include?("\0") ? value : nil)
+  end
+
+  def authenticates?(candidate)
+    candidate.is_a?(String) && candidate.bytesize <= ActiveModel::SecurePassword::MAX_PASSWORD_LENGTH_ALLOWED &&
+      !candidate.include?("\0") && authenticate(candidate)
+  end
+
+  def change_password!(new_password)
+    transaction do
+      update!(password: new_password)
+      user_sessions.delete_all
+      email_links.where(purpose: "password_reset").delete_all
+    end
+  end
+end
