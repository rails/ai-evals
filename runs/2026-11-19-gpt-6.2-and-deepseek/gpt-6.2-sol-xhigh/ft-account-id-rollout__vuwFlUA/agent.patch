diff --git a/test/models/account/ownership_test.rb b/test/models/account/ownership_test.rb
new file mode 100644
index 0000000..490e239
--- /dev/null
+++ b/test/models/account/ownership_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Account::OwnershipTest < ActiveSupport::TestCase
+  test "new records take their account from their owner rather than the current account" do
+    board = boards(:miltons_wish_list)
+    card = cards(:radio)
+    user = users(:mike)
+
+    assert_not_equal Current.account, board.account
+
+    system_user = users(:system_initech)
+    board.accesses.grant_to(system_user)
+    assert_equal board.account_id, board.accesses.find_by!(user: system_user).account_id
+    assert_equal board.account_id, card.create_goldness!.reload.account_id
+    assert_equal board.account_id, user.remember_search("radio").reload.account_id
+
+    filter = user.filters.create!(board_ids: [ board.id ], assignee_ids: [ user.id ])
+    assert_equal [ board.account_id ], filter.board_memberships.pluck(:account_id)
+    assert_equal [ board.account_id ], filter.assignee_memberships.pluck(:account_id)
+  end
+
+  test "rich text, attachments, blobs and variants inherit ownership outside their account context" do
+    card = cards(:radio)
+
+    variant = Current.without_account do
+      card.update!(description: "A description")
+      card.image.attach(io: StringIO.new("image"), filename: "test.png", content_type: "image/png")
+      card.image.blob.variant_records.create!(variation_digest: "digest").tap do |record|
+        record.image.attach(io: StringIO.new("variant"), filename: "variant.png", content_type: "image/png")
+      end
+    end
+
+    assert_equal card.account_id, card.rich_text_description.reload.account_id
+    assert_equal card.account_id, card.image.attachment.reload.account_id
+    assert_equal card.account_id, card.image.blob.reload.account_id
+    assert_equal card.account_id, variant.reload.account_id
+    assert_equal card.account_id, variant.image.attachment.reload.account_id
+    assert_equal card.account_id, variant.image.blob.reload.account_id
+  end
+
+  test "an unattached direct upload belongs to the account that started it" do
+    account = accounts(:initech)
+    upload = Current.with_account(account) do
+      ActiveStorage::Blob.create_before_direct_upload!(filename: "upload.txt", byte_size: 0, checksum: "checksum")
+    end
+
+    assert_equal account.id, upload.reload.account_id
+  end
+
+  test "the database rejects tenant records without an account even when validations are bypassed" do
+    pin = pins(:logo_kevin)
+
+    assert_raises ActiveRecord::NotNullViolation do
+      Pin.transaction(requires_new: true) { pin.update_column(:account_id, nil) }
+    end
+  end
+end
