@@ -22,6 +22,43 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "white-rabbit.webp", updated_picture.image.filename.to_s
   end
 
+  test "readers reuse the picture variant created in the background" do
+    leaf = leaves(:reading_picture)
+
+    assert_no_notifications("transform.active_storage") do
+      put leafable_path(leaf), params: {
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+      }
+      assert_response :no_content
+    end
+
+    assert_notifications_count("transform.active_storage", 1) do
+      perform_enqueued_jobs(only: ActiveStorage::CreateVariantsJob)
+      perform_enqueued_jobs(only: ActiveStorage::TransformJob)
+    end
+
+    variants = leaf.reload.picture.image.blob.variant_records
+    derived_image = variants.sole.image
+
+    sign_out
+    sign_in :jz
+
+    assert_no_notifications(/(?:transform|service_upload)\.active_storage\z/) do
+      get leafable_slug_path(leaf)
+      assert_response :success
+      image_src = css_select("figure img").sole["src"]
+
+      get image_src
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+      assert_equal "image/webp", response.media_type
+      assert_equal derived_image.download, response.body.b
+    end
+
+    assert_equal 1, variants.count
+  end
+
   test "update caption" do
     get edit_leafable_path(leaves(:reading_picture))
     assert_response :ok
