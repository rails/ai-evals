diff --git a/spec/support/fabricator_defaults.rb b/spec/support/fabricator_defaults.rb
new file mode 100644
index 0000000..4af0955
--- /dev/null
+++ b/spec/support/fabricator_defaults.rb
@@ -0,0 +1,9 @@
+# frozen_string_literal: true
+
+module FabricatorDefaults
+  def self.populate_optional_records?
+    # Keep the existing fixture defaults outside the examples being optimized.
+    metadata = RSpec.current_example&.metadata if defined?(RSpec.current_example)
+    !metadata || !metadata[:lean_fabricators]
+  end
+end
