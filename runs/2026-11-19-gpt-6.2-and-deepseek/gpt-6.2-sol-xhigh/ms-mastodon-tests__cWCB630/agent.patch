   end
 
+  # Formatting SQL debug output is expensive when running request setup at scale.
+  # Keep request summaries, warnings, and errors; restore debug logs on demand.
+  unless ENV['RSPEC_DEBUG_LOGS'] == '1'
+    config.around(:each, :request_spec) do |example|
+      Rails.logger.silence(Logger::INFO) { example.run }
+    end
+  end
+
   config.before :each, type: :request do
     # Use https and configured hostname in request spec requests
     integration_session.https!
