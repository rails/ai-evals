+      recipient = Fabricate(:user, account_attributes: { username: 'alice' })
+      first_status = PostStatusService.new.call(recipient.account, text: 'Test')
+      ReblogService.new.call(Fabricate(:account), first_status)
+      PostStatusService.new.call(Fabricate(:account), text: 'Hello @alice')
+      FavouriteService.new.call(Fabricate(:account), first_status)
+      FavouriteService.new.call(Fabricate(:account), first_status)
+      FollowService.new.call(Fabricate(:account), recipient.account)
+      recipient
+    end
+  end
+end
+
+RSpec.shared_context 'with notifications for listing' do |filtered_mention: false|
+  # Persist the common notifications, not the Active Record objects. Examples
+  # that replace these notifications do so in their own rollback transaction.
+  let_it_be(:notification_user_ids) do
+    Sidekiq.testing!(:inline) do
+      recipient = Fabricate(:user, account_attributes: { username: 'alice' })
+      first_status = PostStatusService.new.call(recipient.account, text: 'Test')
+      bob = Fabricate(:user)
+      ReblogService.new.call(bob.account, first_status)
+      PostStatusService.new.call(bob.account, text: 'Hello @alice')
+      tom = Fabricate(:user)
+      PostStatusService.new.call(tom.account, text: 'Hello @alice', visibility: :direct) if filtered_mention
+      FavouriteService.new.call(bob.account, first_status)
+      FavouriteService.new.call(tom.account, first_status)
+      FollowService.new.call(bob.account, recipient.account)
+      { recipient: recipient.id, bob: bob.id, tom: tom.id }.freeze
+    end
+  end
+
+  let(:user) { User.find(notification_user_ids.fetch(:recipient)) }
+  let(:bob) { User.find(notification_user_ids.fetch(:bob)) }
+  let(:tom) { User.find(notification_user_ids.fetch(:tom)) }
+end
