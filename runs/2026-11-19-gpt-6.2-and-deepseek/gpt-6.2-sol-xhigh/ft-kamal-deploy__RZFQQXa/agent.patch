diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..cdf9126
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,47 @@
+service: fizzy
+image: fizzy
+minimum_version: 2.11.0
+
+servers:
+  web:
+    - &host fizzy.example.com # Use the public hostname of your server.
+
+proxy:
+  host: *host
+  ssl: true
+  app_port: 80
+  healthcheck:
+    path: /up
+
+# Kamal runs a local registry on the deploy machine and tunnels it over SSH.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Use arm64 for an ARM server.
+
+# Kamal connects as root by default. For another Docker-enabled SSH user:
+# ssh:
+#   user: deploy
+
+env:
+  clear:
+    APP_FQDN: *host
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    WEB_CONCURRENCY: "2"
+    JOB_CONCURRENCY: "1"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+# SQLite (including the job queue) and Active Storage uploads share this volume.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
