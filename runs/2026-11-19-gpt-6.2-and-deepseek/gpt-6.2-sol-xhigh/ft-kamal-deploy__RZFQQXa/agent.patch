+# Copy to .kamal/secrets. Do not commit that file.
+# Generate a new value with `openssl rand -hex 64` and keep it across deploys.
+SECRET_KEY_BASE=
+
+# Leave both empty for an SMTP relay that does not require authentication.
+# Use single quotes around credentials that contain $ or #.
+SMTP_USERNAME=
+SMTP_PASSWORD=
