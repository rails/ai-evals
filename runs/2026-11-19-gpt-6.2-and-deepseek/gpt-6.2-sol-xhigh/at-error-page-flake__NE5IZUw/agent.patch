diff --git a/test/test_helpers/raised_exceptions_helper.rb b/test/test_helpers/raised_exceptions_helper.rb
new file mode 100644
index 0000000..a111e79
--- /dev/null
+++ b/test/test_helpers/raised_exceptions_helper.rb
@@ -0,0 +1,23 @@
+module RaisedExceptionsHelper
+  KEY = :writebook_test_raise_exceptions
+
+  def with_raised_exceptions
+    previous = Thread.current[KEY]
+    Thread.current[KEY] = true
+    yield
+  ensure
+    Thread.current[KEY] = previous
+  end
+
+  class Middleware
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      # Rails has already merged its cached defaults into this request's env.
+      env["action_dispatch.show_exceptions"] = :none if Thread.current[KEY]
+      @app.call(env)
+    end
+  end
+end
