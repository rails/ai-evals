new file mode 100644
index 0000000..40b89b6
--- /dev/null
+++ b/test/integration/raised_exceptions_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class RaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "an exception escaping the block restores error rendering" do
+    path = book_slug_path(books(:manual))
+
+    get path
+    assert_response :not_found
+
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions { get path }
+    end
+
+    get path
+    assert_response :not_found
+  end
+
+  test "nested blocks keep raising until the outer block exits" do
+    path = book_slug_path(books(:manual))
+
+    with_raised_exceptions do
+      with_raised_exceptions do
+        assert_raises(ActiveRecord::RecordNotFound) { get path }
+      end
+
+      assert_raises(ActiveRecord::RecordNotFound) { get path }
+    end
+
+    get path
+    assert_response :not_found
+  end
+
+  test "raising exceptions does not affect requests on another thread" do
+    other_session = open_session
+    path = "/no-such-route"
+
+    with_raised_exceptions do
+      assert_equal 404, Thread.new { other_session.get(path) }.value
+      assert_raises(ActionController::RoutingError) { get path }
+    end
+  end
+end
