index 0000000..e657a2a
--- /dev/null
+++ b/test/test_helpers/raised_exceptions_test_helper.rb
@@ -0,0 +1,24 @@
+module RaisedExceptionsTestHelper
+  SCOPE_KEY = :writebook_test_raised_exceptions
+  private_constant :SCOPE_KEY
+
+  def with_raised_exceptions
+    previous = Thread.current[SCOPE_KEY]
+    Thread.current[SCOPE_KEY] = true
+    yield
+  ensure
+    Thread.current[SCOPE_KEY] = previous
+  end
+
+  class Middleware
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      # Rails copies its cached defaults into the request env before running middleware.
+      env["action_dispatch.show_exceptions"] = :none if Thread.current[SCOPE_KEY]
+      @app.call(env)
+    end
+  end
+end
