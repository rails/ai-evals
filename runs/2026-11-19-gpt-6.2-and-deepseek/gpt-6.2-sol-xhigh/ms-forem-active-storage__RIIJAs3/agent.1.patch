index 0000000..52ccee7
--- /dev/null
+++ b/spec/models/concerns/has_profile_image_spec.rb
@@ -0,0 +1,101 @@
+require "rails_helper"
+require "exifr/jpeg"
+
+RSpec.describe HasProfileImage do
+  shared_examples "a profile image owner" do |factory|
+    let(:owner) { build(factory, profile_image: nil) }
+    let(:legacy_uploader) { ProfileImageUploader.new(owner, :profile_image) }
+    let(:legacy_image) { Rails.root.join("app/assets/images/1.png") }
+    let(:new_image) { Rails.root.join("app/assets/images/2.png") }
+
+    before do
+      owner[:profile_image] = "legacy.png"
+      owner.save!
+      legacy_image.open { |file| legacy_uploader.store!(file) }
+      owner.update_columns(profile_image: legacy_uploader.identifier)
+    end
+
+    after { legacy_uploader.remove! }
+
+    it "continues to use the original CarrierWave URL on legacy-only records" do
+      expect(owner.reload.profile_image_url).to eq(legacy_uploader.url)
+      expect(owner.as_json.fetch("profile_image")).to eq("url" => legacy_uploader.url)
+      expect(owner.profile_image_upload).not_to be_attached
+    end
+
+    it "uses Active Storage for a replacement without changing or deleting the old upload" do
+      new_image.open { |file| owner.update!(profile_image: file) }
+      owner.reload
+
+      expect(owner.profile_image_upload.download).to eq(new_image.binread)
+      expect(owner.profile_image_url).to include("/rails/active_storage/blobs/proxy/")
+      expect(owner[:profile_image]).to eq(legacy_uploader.identifier)
+      expect(File.binread(legacy_uploader.path)).to eq(legacy_image.binread)
+    end
+
+    it "does not change the current image when validation fails" do
+      invalid_image = fixture_file_upload("800x600.pdf", "application/pdf")
+
+      expect(owner.update(profile_image: invalid_image)).to be(false)
+      expect(owner.errors[:profile_image]).to be_present
+      expect(owner.reload.profile_image_url).to eq(legacy_uploader.url)
+    end
+  end
+
+  context "with a user" do
+    it_behaves_like "a profile image owner", :user
+  end
+
+  context "with an organization" do
+    it_behaves_like "a profile image owner", :organization
+  end
+
+  it "preserves the default avatar for users without either kind of image" do
+    user = create(:user, profile_image: nil)
+
+    expect(user.profile_image_url_for(length: 90)).to eq(Images::Profile.call(nil, length: 90))
+  end
+
+  it "leaves the current attachment in place if its replacement cannot be stored" do
+    user = create(:user)
+    original_url = user.profile_image_url
+    service = user.profile_image_upload.blob.service
+    allow(service).to receive(:upload).and_raise(IOError, "upload failed")
+
+    expect { user.update!(profile_image: fixture_file_upload("800x600.png")) }.to raise_error(IOError, "upload failed")
+    expect(user.reload.profile_image_url).to eq(original_url)
+  end
+
+  it "strips GPS and EXIF metadata before storing a new profile image" do
+    allow(Images::ProfileImageUpload::TemporaryUploader).to receive(:enable_processing).and_return(true)
+    image = fixture_file_upload("image_gps_data.jpg", "image/jpeg")
+    user = create(:user, profile_image: image)
+
+    user.profile_image_upload.open do |file|
+      expect(EXIFR::JPEG.new(file.path)).not_to be_exif
+    end
+  end
+
+  it "removes a new blob and preserves the old image if a surrounding transaction rolls back" do
+    user = create(:user)
+    original_url = user.profile_image_url
+    blob = nil
+
+    User.transaction(requires_new: true) do
+      user.update!(profile_image: fixture_file_upload("800x600.png", "image/png"))
+      blob = user.profile_image_upload.blob
+      raise ActiveRecord::Rollback
+    end
+
+    expect(blob.service).not_to exist(blob.key)
+    expect(user.profile_image_url).to eq(original_url)
+    expect(user.reload.profile_image_url).to eq(original_url)
+  end
+
+  it "leaves organization cover images on CarrierWave" do
+    organization = create(:organization, cover_image: fixture_file_upload("800x600.png"))
+
+    expect(organization.reload.cover_image_url).to start_with("/uploads/organization/cover_image/")
+    expect(organization.profile_image_upload).to be_attached
+  end
+end
