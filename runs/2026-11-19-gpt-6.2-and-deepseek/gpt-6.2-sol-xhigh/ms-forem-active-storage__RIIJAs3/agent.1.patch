@@ -0,0 +1,49 @@
+require "rails_helper"
+require "active_storage/service/forem_s3_service"
+
+RSpec.describe ActiveStorage::Service::ForemS3Service do
+  let(:object_url) { "https://forem-profile-test.s3.amazonaws.com/active-storage/profile" }
+  let(:service) do
+    described_class.new(bucket: "forem-profile-test", region: "us-east-1",
+                        aws_access_key_id: "test", aws_secret_access_key: "test")
+  end
+
+  it "writes and serves blobs under the Active Storage prefix" do
+    data = "image-bytes"
+    checksum = Digest::MD5.base64digest(data)
+    upload = stub_request(:put, object_url)
+      .with(body: data, headers: { "Content-Type" => "image/png", "Content-MD5" => checksum })
+    stub_request(:get, object_url).to_return(body: data)
+    stub_request(:get, object_url).with(headers: { "Range" => "bytes=0-4" }).to_return(status: 206, body: "image")
+
+    service.upload("profile", StringIO.new(data), checksum: checksum, content_type: "image/png")
+
+    expect(upload).to have_been_requested
+    expect(service.download("profile")).to eq(data)
+    expect(service.download_chunk("profile", 0..4)).to eq("image")
+    expect { |block| service.download("profile", &block) }.to yield_with_args(data)
+  end
+
+  it "deletes only the requested Active Storage object and handles missing images" do
+    delete = stub_request(:delete, object_url).to_return(status: 204)
+    stub_request(:head, object_url).to_return(status: 404)
+    stub_request(:get, object_url).to_return(status: 404)
+
+    service.delete("profile")
+
+    expect(delete).to have_been_requested
+    expect(service).not_to exist("profile")
+    expect { service.download("profile") }.to raise_error(ActiveStorage::FileNotFoundError)
+  end
+
+  it "limits variant cleanup to the Active Storage prefix" do
+    prefix = "active-storage/variants/profile/"
+    body = "<ListBucketResult><Prefix>#{prefix}</Prefix><IsTruncated>false</IsTruncated></ListBucketResult>"
+    list = stub_request(:get, "https://forem-profile-test.s3.amazonaws.com/").with(query: { "prefix" => prefix })
+      .to_return(body: body)
+
+    service.delete_prefixed("variants/profile/")
+
+    expect(list).to have_been_requested.once
+  end
+end
