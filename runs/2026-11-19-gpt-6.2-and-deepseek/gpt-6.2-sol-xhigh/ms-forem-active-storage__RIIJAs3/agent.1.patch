diff --git a/app/models/concerns/has_profile_image.rb b/app/models/concerns/has_profile_image.rb
new file mode 100644
index 0000000..08bd290
--- /dev/null
+++ b/app/models/concerns/has_profile_image.rb
@@ -0,0 +1,116 @@
+module HasProfileImage
+  extend ActiveSupport::Concern
+
+  included do
+    include Images::Profile.for(:profile_image_url)
+
+    has_one_attached :profile_image_upload
+    validate :validate_profile_image_upload
+    before_save :store_pending_profile_image
+    after_destroy_commit :remove_legacy_profile_image
+  end
+
+  attr_reader :remote_profile_image_url
+
+  def profile_image=(file)
+    prepare_profile_image(file)
+  end
+
+  def remote_profile_image_url=(source)
+    return if source.blank?
+
+    @remote_profile_image_url = source if source.is_a?(String)
+    prepare_profile_image(source, remote: source.is_a?(String))
+  end
+
+  def profile_image_present?
+    @pending_profile_image.present? || legacy_profile_image_identifier.present? || profile_image_upload.attached?
+  end
+
+  def profile_image_url
+    if (blob = profile_image_upload.blob)
+      path = Rails.application.routes.url_helpers.rails_service_blob_proxy_path(blob.signed_id, blob.filename)
+      URL.url(path)
+    elsif legacy_profile_image_identifier&.match?(%r{\Ahttps?://}i)
+      legacy_profile_image_identifier
+    else
+      legacy_profile_image&.url
+    end
+  end
+
+  def profile_image_json
+    { url: profile_image_url }
+  end
+
+  private
+
+  # Keep the {url: ...} shape previously serialized by the mounted uploader.
+  def read_attribute_for_serialization(name)
+    name.to_s == "profile_image" ? profile_image_json : super
+  end
+
+  def prepare_profile_image(file, remote: false)
+    return if file.blank?
+
+    @pending_profile_image = nil
+    @profile_image_error = nil
+    unless remote || file.respond_to?(:read)
+      @profile_image_error = I18n.t("concerns.image_uploads.is_not_file")
+      return
+    end
+
+    @pending_profile_image = Images::ProfileImageUpload.prepare(file, remote: remote)
+  rescue CarrierWave::IntegrityError, CarrierWave::ProcessingError, CarrierWave::DownloadError => e
+    @profile_image_error = e.message
+  end
+
+  def validate_profile_image_upload
+    errors.add(:profile_image, @profile_image_error) if @profile_image_error
+  end
+
+  def store_pending_profile_image
+    return unless @pending_profile_image
+
+    # Upload before switching the record to the new blob. Active Storage's
+    # default IO assignment uploads after commit, which would publish a broken
+    # image URL if the storage write failed.
+    io = @pending_profile_image.fetch(:io)
+    io.rewind
+    blob = ActiveStorage::Blob.create_after_unfurling!(**@pending_profile_image)
+    self.class.current_transaction.after_rollback { discard_profile_image(blob) }
+    blob.upload_without_unfurling(io)
+    self.profile_image_upload = blob
+    self.updated_at = Time.current
+    @pending_profile_image = nil
+  end
+
+  def discard_profile_image(blob)
+    if attachment_changes["profile_image_upload"]&.blob == blob
+      attachment_changes.delete("profile_image_upload")
+      association(:profile_image_upload_attachment).reset
+      association(:profile_image_upload_blob).reset
+    end
+    blob.service.delete(blob.key)
+  rescue StandardError => e
+    Rails.logger.error("Could not clean up rolled-back profile image: #{e.message}")
+  end
+
+  def profile_image_changed_on_save?
+    saved_change_to_profile_image? || attachment_changes.key?("profile_image_upload")
+  end
+
+  def legacy_profile_image_identifier
+    self[:profile_image].presence if has_attribute?(:profile_image)
+  end
+
+  def legacy_profile_image
+    identifier = legacy_profile_image_identifier
+    return unless identifier && !identifier.match?(%r{\Ahttps?://}i)
+
+    ProfileImageUploader.new(self, :profile_image).tap { |uploader| uploader.retrieve_from_store!(identifier) }
+  end
+
+  def remove_legacy_profile_image
+    legacy_profile_image&.remove!
+  end
+end
