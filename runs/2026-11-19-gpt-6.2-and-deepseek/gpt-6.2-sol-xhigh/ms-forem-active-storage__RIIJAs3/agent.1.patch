diff --git a/app/services/images/profile_image_upload.rb b/app/services/images/profile_image_upload.rb
new file mode 100644
index 0000000..beb2ea3
--- /dev/null
+++ b/app/services/images/profile_image_upload.rb
@@ -0,0 +1,27 @@
+module Images
+  module ProfileImageUpload
+    # Reuse the extension, size, dimensions, frame and EXIF checks without
+    # persisting a CarrierWave file or using the production upload cache.
+    class TemporaryUploader < ProfileImageUploader
+      cache_storage :file
+    end
+
+    def self.prepare(file, remote: false)
+      Dir.mktmpdir("profile-image") do |directory|
+        uploader = TemporaryUploader.new
+        uploader.root = directory
+        if remote
+          uploader.download!(file)
+        else
+          uploader.cache!(file)
+        end
+        raise CarrierWave::IntegrityError, I18n.t("concerns.image_uploads.is_not_file") unless uploader.file
+
+        {
+          io: StringIO.new(File.binread(uploader.file.path)),
+          filename: "profile-image.#{uploader.file.extension.downcase}"
+        }
+      end
+    end
+  end
+end
