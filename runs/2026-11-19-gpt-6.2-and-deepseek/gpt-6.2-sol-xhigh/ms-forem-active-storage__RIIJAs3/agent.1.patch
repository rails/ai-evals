diff --git a/docs/profile-image-storage-cutover.md b/docs/profile-image-storage-cutover.md
new file mode 100644
index 0000000..0382ab4
--- /dev/null
+++ b/docs/profile-image-storage-cutover.md
@@ -0,0 +1,9 @@
+# Profile image storage cutover
+
+Run the database migrations before sending traffic to this release. The migration only creates Active Storage tables. It does not rewrite `users.profile_image` or `organizations.profile_image`, copy existing images, or remove any CarrierWave files.
+
+- **S3 deployments:** Active Storage uses the existing bucket and credentials (including Forem Cloud's IAM role). Allow the web and worker processes to read, write, and delete objects under `active-storage/`, and list that prefix for cleanup. Keep the existing CarrierWave configuration and paths in service.
+- **Filesystem deployments:** Mount a persistent directory shared by the web and worker processes at `ACTIVE_STORAGE_ROOT` (defaults to `storage/` under the app root). Leave the existing `public/uploads` mount in place.
+- The new public image URLs use `/rails/active_storage/blobs/proxy/`. Route that path to this release before accepting new uploads, or switch traffic to the new fleet together. Preserve `SECRET_KEY_BASE` across releases so previously generated URLs continue to work.
+
+Check an existing user and organization avatar after deploying. Then upload a replacement and check its new URL and the previous CarrierWave URL. Once new uploads have been accepted, keep Active Storage reads and the proxy route available in any rollback; a pre-cutover release only knows how to display CarrierWave images.
diff --git a/lib/active_storage/service/forem_s3_service.rb b/lib/active_storage/service/forem_s3_service.rb
new file mode 100644
index 0000000..05b8b94
--- /dev/null
+++ b/lib/active_storage/service/forem_s3_service.rb
@@ -0,0 +1,63 @@
+module ActiveStorage
+  class Service
+    # Server-side uploads to the same S3 backend Forem already uses via fog-aws.
+    # The signed Rails proxy route serves these objects without making the bucket public.
+    class ForemS3Service < Service
+      PREFIX = "active-storage/".freeze
+
+      def initialize(bucket:, **credentials)
+        super()
+        @bucket = bucket
+        @credentials = credentials.compact
+      end
+
+      def upload(key, io, checksum: nil, content_type: nil, **)
+        headers = { "Content-MD5" => checksum, "Content-Type" => content_type }.compact
+        client.put_object(@bucket, object_key(key), io.read, headers)
+      end
+
+      def download(key)
+        if block_given?
+          client.get_object(@bucket, object_key(key)) { |chunk, *| yield chunk }
+        else
+          client.get_object(@bucket, object_key(key)).body.b
+        end
+      rescue Excon::Error::NotFound
+        raise ActiveStorage::FileNotFoundError
+      end
+
+      def download_chunk(key, range)
+        last_byte = range.exclude_end? ? range.end - 1 : range.end
+        client.get_object(@bucket, object_key(key), "Range" => "bytes=#{range.begin}-#{last_byte}").body.b
+      rescue Excon::Error::NotFound
+        raise ActiveStorage::FileNotFoundError
+      end
+
+      def exist?(key)
+        client.head_object(@bucket, object_key(key)).status == 200
+      rescue Excon::Error::NotFound
+        false
+      end
+
+      def delete(key)
+        client.delete_object(@bucket, object_key(key))
+      end
+
+      def delete_prefixed(prefix)
+        files = client.directories.new(key: @bucket).files
+        files.prefix = object_key(prefix)
+        files.each(&:destroy)
+      end
+
+      private
+
+      def object_key(key)
+        "#{PREFIX}#{key}"
+      end
+
+      def client
+        Fog::AWS::Storage.new(@credentials)
+      end
+    end
+  end
+end
diff --git a/spec/lib/active_storage/service/forem_s3_service_spec.rb b/spec/lib/active_storage/service/forem_s3_service_spec.rb
