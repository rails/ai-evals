diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..f019f02
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    Current.user = users(:david)
+    @card = boards(:writebook).cards.create!(title: "Needs attention", status: :published)
+  end
+
+  test "three comments by at least two people can lead to a stall" do
+    comment_as users(:david)
+    comment_as users(:kevin)
+    comment_as users(:david)
+
+    travel 2.weeks - 1.second
+    assert_not_predicate @card.reload, :stalled?
+
+    travel 1.second
+    assert_predicate @card.reload, :stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "two people and a system comment do not make a burst" do
+    comment_as users(:david)
+    comment_as users(:kevin)
+    comment_as @card.account.system_user
+
+    travel 2.weeks
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "three comments from the same person do not make a burst" do
+    3.times { comment_as users(:david) }
+
+    travel 2.weeks
+    assert_not_predicate @card.reload, :stalled?
+  end
+
+  test "comments must fit in a third of the board's auto-postpone period" do
+    @card.board.auto_postpone_period_in_days = 7
+    comment_as users(:david)
+    travel 2.days + 8.hours + 1.second
+    comment_as users(:kevin)
+    comment_as users(:david)
+
+    travel 2.weeks
+    assert_not_predicate @card.reload, :stalled?
+  end
+
+  test "a burst can span exactly a third of the period inherited from the account" do
+    entropies(:writebook_board).destroy!
+    comment_as users(:kevin)
+    travel 10.days
+    3.times { comment_as users(:david) }
+
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+  end
+
+  test "a backdated comment can complete a burst with newer comments" do
+    2.times { comment_as users(:david) }
+    @card.comments.create!(creator: users(:kevin), body: "Older comment", created_at: 1.day.ago)
+
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+  end
+
+  test "assignment starts the clock and other activity resets it" do
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+
+    @card.reactions.create!(content: "👍")
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+
+    @card.update!(description: "More detail")
+    assert_not_predicate @card.reload, :stalled?
+  end
+
+  test "reopening starts the clock but a closed or postponed card is not stalled" do
+    @card.close
+    @card.reopen
+
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+
+    @card.postpone
+    travel 2.weeks
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.close
+    travel 2.weeks
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "step and comment edits count as activity but board settings do not" do
+    comment = comment_as users(:david)
+    @card.toggle_assignment users(:kevin)
+    step = @card.steps.create!(content: "Follow up")
+    travel 2.weeks
+
+    @card.board.update!(name: "Renamed board")
+    assert_predicate @card.reload, :stalled?
+
+    step.update!(completed: true)
+    assert_not_predicate @card.reload, :stalled?
+
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+
+    comment.update!(body: "More information")
+    assert_not_predicate @card.reload, :stalled?
+  end
+
+  test "backfill recognizes historical assignments and comments without resetting activity" do
+    previously_assigned = cards(:logo)
+    comment_as users(:kevin)
+    3.times { comment_as users(:david) }
+    previous_activity = @card.last_active_at
+    @card.update_column :attention_burst_at, nil
+
+    travel 2.weeks
+    Card::Stallable::Backfill.new(Current.account.cards).run
+
+    assert_predicate previously_assigned.reload, :stalled?
+    assert_predicate @card.reload, :stalled?
+    assert_equal previous_activity, @card.last_active_at
+    assert_not_predicate cards(:buy_domain), :stalled?
+  end
+
+  private
+    def comment_as(creator)
+      @card.comments.create!(creator: creator, body: "Thoughts?")
+    end
+end
