diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..6b9b0cf
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,32 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+  BURST_ACTIONS = %w[ card_assigned card_reopened ]
+
+  included do
+    scope :stalled, -> { active.where.not(attention_burst_at: nil).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def stalled?
+    attention_burst_at.present? && last_active_at <= STALL_PERIOD.ago && active?
+  end
+
+  def register_comment_activity(comment)
+    unless attention_burst_at?
+      mark_attention_burst(CommentBurst.new(self, around: comment.created_at).occurred_at)
+    end
+    touch_last_active_at
+  end
+
+  # The badge and JSON status change with time, even if the card was not updated.
+  def cache_version
+    version = super
+    version && stalled? ? "#{version}-stalled" : version
+  end
+
+  private
+    def mark_attention_burst(at)
+      self.attention_burst_at ||= at
+    end
+end
diff --git a/app/models/card/stallable/backfill.rb b/app/models/card/stallable/backfill.rb
new file mode 100644
index 0000000..8d7bd6e
--- /dev/null
+++ b/app/models/card/stallable/backfill.rb
@@ -0,0 +1,13 @@
+class Card::Stallable::Backfill
+  def initialize(cards)
+    @cards = cards.where(attention_burst_at: nil).published
+  end
+
+  def run
+    @cards.includes(board: [ :entropy, { account: :entropy } ]).find_each do |card|
+      if burst_at = card.events.where(action: Card::Stallable::BURST_ACTIONS).minimum(:created_at) || Card::Stallable::CommentBurst.new(card).occurred_at
+        @cards.where(id: card.id).update_all(attention_burst_at: burst_at, updated_at: Time.current)
+      end
+    end
+  end
+end
diff --git a/app/models/card/stallable/comment_burst.rb b/app/models/card/stallable/comment_burst.rb
new file mode 100644
index 0000000..e17b99a
--- /dev/null
+++ b/app/models/card/stallable/comment_burst.rb
@@ -0,0 +1,24 @@
+class Card::Stallable::CommentBurst
+  def initialize(card, around: nil)
+    @period = card.auto_postpone_period / 3
+    @comments = card.comments.by_user.chronologically
+    @comments = @comments.where(created_at: (around - @period)..(around + @period)) if around
+  end
+
+  def occurred_at
+    previous_at = third_latest_at = other_author_at = previous_author = nil
+
+    @comments.pluck(:created_at, :creator_id).each do |time, creator_id|
+      other_author_at = previous_at if previous_author != creator_id
+
+      # The third comment and a comment by someone else must both be in the window.
+      if third_latest_at && other_author_at && [ third_latest_at, other_author_at ].min >= time - @period
+        return time
+      end
+
+      third_latest_at, previous_at, previous_author = previous_at, time, creator_id
+    end
+
+    nil
+  end
+end
