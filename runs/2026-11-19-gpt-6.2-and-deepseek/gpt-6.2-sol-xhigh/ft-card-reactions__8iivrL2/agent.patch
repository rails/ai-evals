diff --git a/test/system/card_reactions_test.rb b/test/system/card_reactions_test.rb
new file mode 100644
index 0000000..a52e3b3
--- /dev/null
+++ b/test/system/card_reactions_test.rb
@@ -0,0 +1,50 @@
+require "application_system_test_case"
+
+class CardReactionsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:david)
+    @card = cards(:logo)
+  end
+
+  test "boosting a card from its detail view updates its column preview" do
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :reacting)}" do
+      click_on "Add your own reaction"
+      find("input[aria-label='Add a reaction']").set "Nice work!"
+      click_on "Submit"
+      assert_text "Nice work!"
+    end
+
+    visit board_column_url(@card.board, @card.column)
+    assert_selector "##{dom_id(@card, :article)} .card__boosts", text: "1"
+
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :reacting)}" do
+      find(".reaction [role=button]", text: "Nice work!").click
+      click_on "Delete this reaction"
+      assert_no_text "Nice work!"
+    end
+
+    visit board_column_url(@card.board, @card.column)
+    assert_no_selector "##{dom_id(@card, :article)} .card__boosts"
+  end
+
+  test "a card reaction can be canceled or submitted using the emoji picker" do
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :reacting)}" do
+      click_on "Add your own reaction"
+      find("input[aria-label='Add a reaction']").set "Discard this"
+      click_on "Cancel"
+      assert_no_selector "form[aria-label='New reaction']"
+
+      click_on "Add your own reaction"
+      find(".reaction__menu-btn").click
+      click_on "Thumbs up"
+      click_on "Submit"
+      assert_selector ".reaction", text: "👍"
+    end
+  end
+end
