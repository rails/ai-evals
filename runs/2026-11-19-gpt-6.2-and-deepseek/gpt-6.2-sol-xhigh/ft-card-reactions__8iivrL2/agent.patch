@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+  end
+
+  test "creates a card reaction with JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+      assert_response :created
+    end
+
+    reaction = @card.reactions.last
+    assert_equal "👍", response.parsed_body["content"]
+    assert_equal users(:david).id, response.parsed_body.dig("reacter", "id")
+    assert_equal card_reaction_url(@card, reaction), response.parsed_body["url"]
+  end
+
+  test "lists card reactions in creation order without including comment reactions" do
+    comments(:logo_1).reactions.create!(content: "Comment boost", reacter: users(:david))
+    first = @card.reactions.create!(content: "First", reacter: users(:david), created_at: 2.minutes.ago)
+    second = @card.reactions.create!(content: "Second", reacter: users(:kevin), created_at: 1.minute.ago)
+
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal [ first.id, second.id ], response.parsed_body.pluck("id")
+  end
+
+  test "only the reacter can delete a card reaction" do
+    reaction = @card.reactions.create!(content: "Nice!", reacter: users(:kevin))
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, reaction), as: :json
+      assert_response :forbidden
+    end
+
+    logout_and_sign_in_as :kevin
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction), as: :json
+      assert_response :no_content
+    end
+  end
+
+  test "cannot delete a comment reaction through the card reaction route" do
+    reaction = comments(:logo_1).reactions.create!(content: "Nice!", reacter: users(:david))
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_reaction_path(@card, reaction), as: :json
+      assert_response :not_found
+    end
+  end
+
+  test "cannot react to cards on inaccessible boards" do
+    card = boards(:private).cards.create!(title: "Private card", creator: users(:kevin))
+
+    assert_no_difference -> { card.reactions.count } do
+      post card_reactions_path(card), params: { reaction: { content: "Nice!" } }, as: :json
+      assert_response :not_found
+    end
+  end
+
+  test "cannot react to drafts" do
+    card = @card.board.cards.create!(creator: users(:david), status: :drafted)
+
+    assert_no_difference -> { card.reactions.count } do
+      post card_reactions_path(card), params: { reaction: { content: "Nice!" } }, as: :json
+      assert_response :forbidden
+    end
+  end
+end
