@@ -0,0 +1,24 @@
+require "test_helper"
+
+class Account::DataTransfer::ReactionRecordSetTest < ActiveSupport::TestCase
+  test "imports a comment reaction from a legacy export" do
+    account = accounts("37s")
+    comment = comments(:logo_1)
+    reaction = comment.reactions.create!(content: "👍", reacter: users(:david))
+    legacy_data = reaction.attributes.except("reactable_type", "reactable_id").merge("comment_id" => comment.id)
+    reaction.destroy!
+
+    io = StringIO.new
+    writer = ZipFile::Writer.new(io)
+    writer.add_file("data/reactions/#{reaction.id}.json", legacy_data.to_json)
+    writer.close
+    reader = ZipFile::Reader.new(io)
+    record_set = Account::DataTransfer::ReactionRecordSet.new(account)
+
+    record_set.import(from: reader)
+
+    imported_reaction = comment.reactions.find(reaction.id)
+    assert_equal reaction.content, imported_reaction.content
+    assert_equal reaction.reacter, imported_reaction.reacter
+  end
+end
