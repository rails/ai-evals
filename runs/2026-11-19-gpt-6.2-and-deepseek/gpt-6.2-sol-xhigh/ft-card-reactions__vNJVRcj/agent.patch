diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..f0d96ca
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+  end
+
+  test "card detail has its own add reaction control" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@card, :reacting)} a[href=?]", new_card_reaction_path(@card), text: "Add your own reaction"
+  end
+
+  test "create and remove a card reaction" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: { content: "Great work!" } }, as: :turbo_stream
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+
+    reaction = @card.reactions.last
+    assert_equal users(:david), reaction.reacter
+    assert_equal @card.account, reaction.account
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction), as: :turbo_stream
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "reactions can be created, listed and removed as JSON" do
+    post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+    assert_response :created
+    assert_equal "👍", response.parsed_body["content"]
+
+    reaction = @card.reactions.last
+    assert_equal card_reaction_url(@card, reaction), response.parsed_body["url"]
+
+    get card_reactions_path(@card), as: :json
+    assert_response :success
+    assert_equal [ reaction.id ], response.parsed_body.pluck("id")
+
+    delete card_reaction_path(@card, reaction), as: :json
+    assert_response :no_content
+    assert_empty @card.reactions
+  end
+
+  test "only the reaction author can remove a reaction" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, reaction), as: :turbo_stream
+      assert_response :forbidden
+    end
+  end
+
+  test "a comment reaction cannot be removed from the card reaction URL" do
+    reaction = comments(:logo_1).reactions.create!(content: "👍", reacter: users(:david))
+
+    delete card_reaction_path(@card, reaction), as: :turbo_stream
+    assert_response :not_found
+  end
+
+  test "cannot react to a card in an inaccessible board" do
+    @card.board.update! all_access: false
+    @card.board.accesses.revoke_from users(:david)
+
+    post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+    assert_response :not_found
+  end
+
+  test "cannot react to a draft" do
+    draft = @card.board.cards.create!(status: :drafted, creator: users(:david))
+
+    post card_reactions_path(draft), params: { reaction: { content: "👍" } }, as: :json
+    assert_response :not_found
+  end
+end
