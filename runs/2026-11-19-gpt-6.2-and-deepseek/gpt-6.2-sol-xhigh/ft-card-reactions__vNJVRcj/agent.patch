diff --git a/test/system/card_reactions_test.rb b/test/system/card_reactions_test.rb
new file mode 100644
index 0000000..182c3c0
--- /dev/null
+++ b/test/system/card_reactions_test.rb
@@ -0,0 +1,34 @@
+require "application_system_test_case"
+
+class CardReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "add a boost to a card, see it in its column, and remove it" do
+    sign_in_as users(:david)
+    card = cards(:logo)
+    column_url = board_column_url(card.board, card.column)
+
+    visit card_url(card)
+    within "##{dom_id(card, :reacting)}" do
+      click_on "Add your own reaction"
+      find(".reaction__menu-btn").click
+      find("button[title='Thumbs up']").click
+      assert_field "reaction[content]", with: "👍"
+      click_on "Submit"
+      assert_selector ".reaction", text: "👍"
+    end
+
+    visit column_url
+    assert_selector "##{dom_id(card, :article)} .card__boosts", text: /1\s+boost/
+
+    visit card_url(card)
+    within "##{dom_id(card, :reacting)}" do
+      find(".reaction [role='button']", text: "👍").click
+      click_on "Delete this reaction"
+      assert_no_selector ".reaction"
+    end
+
+    visit column_url
+    assert_no_selector "##{dom_id(card, :article)} .card__boosts"
+  end
+end
