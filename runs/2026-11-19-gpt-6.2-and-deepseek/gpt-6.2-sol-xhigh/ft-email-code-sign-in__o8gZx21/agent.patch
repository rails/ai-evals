diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..25fd27b
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,100 @@
+class Sessions::MagicLinksController < ApplicationController
+  include JoinCodeRedemption
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :no_store, :set_magic_link
+
+  layout "public"
+  helper_method :restart_path
+
+  def show
+  end
+
+  def create
+    if @magic_link.redeem(params[:code])
+      cookies.delete(:pending_authentication_token)
+      complete_authentication
+    else
+      code_did_not_work
+    end
+  end
+
+  private
+    def set_magic_link
+      @magic_link = MagicLink.find_signed(cookies[:pending_authentication_token], purpose: MagicLink::TOKEN_PURPOSE)
+
+      unless @magic_link
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Request a new email code to continue.", status: :see_other }
+          format.json { head :unauthorized }
+        end
+      end
+    end
+
+    def complete_authentication
+      case @magic_link.purpose
+      when "sign_in"
+        if identity = Identity.find_by(email_address: @magic_link.email_address)
+          sign_in(identity) { after_authentication_url }
+        else
+          code_did_not_work
+        end
+      when "sign_up"
+        if Account.accepting_signups?
+          identity = Signup.new(email_address: @magic_link.email_address).create_identity
+          sign_in(identity) { new_signup_completion_url }
+        else
+          redirect_to new_session_path, status: :see_other
+        end
+      when "join"
+        if join_code = @magic_link.join_code
+          redeem_join_code(join_code, code: @magic_link.invitation_code) do
+            Identity.find_or_create_by!(email_address: @magic_link.email_address)
+          end
+        else
+          head :gone
+        end
+      end
+    end
+
+    def sign_in(identity)
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to yield, status: :see_other }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def code_did_not_work
+      message = "That code didn’t work. Check the code or request a new one."
+
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = message
+          render :show, status: :unprocessable_entity
+        end
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def restart_path
+      if @magic_link.sign_up?
+        new_signup_path
+      elsif @magic_link.join? && (join_code = @magic_link.join_code)
+        join_path(code: @magic_link.invitation_code, script_name: join_code.account.slug)
+      else
+        new_session_path
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: "Try again later.", status: :see_other }
+        format.json { head :too_many_requests }
+      end
+    end
+end
