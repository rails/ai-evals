@@ -0,0 +1,24 @@
+module JoinCodeRedemption
+  private
+
+  def redeem_join_code(join_code, code: join_code.code, &identity)
+    if user = join_code.redeem_for(code: code, &identity)
+      start_new_session_for user.identity unless Current.identity == user.identity
+
+      respond_to do |format|
+        format.html { redirect_to after_join_url(user), status: :see_other }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      head :gone
+    end
+  end
+
+  def after_join_url(user)
+    if user.setup?
+      landing_url(script_name: user.account.slug)
+    else
+      new_users_verification_url(script_name: user.account.slug)
+    end
+  end
+end
