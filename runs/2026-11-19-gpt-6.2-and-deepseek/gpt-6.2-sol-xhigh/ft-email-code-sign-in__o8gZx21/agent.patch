index 0000000..a758ed3
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "an incorrect code can be retried before fifteen minutes are up" do
+    freeze_time do
+      untenanted do
+        code = request_sign_in_code
+
+        assert_no_difference "Session.count" do
+          post session_magic_link_path, params: { code: "000000" }
+        end
+        assert_response :unprocessable_entity
+        assert_in_body "That code didn’t work."
+
+        travel 14.minutes + 59.seconds
+        post session_magic_link_path, params: { code: " #{code.downcase} " }
+        assert_redirected_to landing_path
+        assert cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "a code expires after fifteen minutes" do
+    freeze_time do
+      untenanted do
+        code = request_sign_in_code
+
+        travel 15.minutes
+        assert_no_difference "Session.count" do
+          post session_magic_link_path, params: { code: code }
+        end
+        assert_redirected_to new_session_path
+        assert_nil cookies[:session_token]
+      end
+    end
+  end
+
+  test "a code stops working after too many incorrect attempts" do
+    untenanted do
+      code = request_sign_in_code
+
+      MagicLink::MAX_ATTEMPTS.times do
+        post session_magic_link_path, params: { code: "000000" }
+        assert_response :unprocessable_entity
+      end
+
+      assert_no_difference "Session.count" do
+        post session_magic_link_path, params: { code: code }
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "a code requires its pending token and cannot be replayed" do
+    untenanted do
+      code = request_sign_in_code
+      pending_token = cookies[:pending_authentication_token]
+
+      open_session do |other_browser|
+        other_browser.post session_magic_link_path, params: { code: code }, as: :json
+        other_browser.assert_response :unauthorized
+        assert_nil other_browser.cookies[:session_token]
+      end
+
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to landing_path
+      assert_not cookies[:pending_authentication_token].present?
+
+      open_session do |other_browser|
+        other_browser.cookies[:pending_authentication_token] = pending_token
+        other_browser.post session_magic_link_path, params: { code: code }, as: :json
+        other_browser.assert_response :unauthorized
+        assert_nil other_browser.cookies[:session_token]
+      end
+    end
+  end
+
+  test "requesting sign-in does not disclose whether the address has an identity" do
+    untenanted do
+      assert_no_emails do
+        assert_no_difference "Identity.count" do
+          post session_path, params: { email_address: "unknown@example.com" }
+        end
+      end
+      assert_redirected_to session_magic_link_path
+      follow_redirect!
+      assert_response :success
+      assert_in_body "If you have a Fizzy account"
+    end
+  end
+
+  test "sign in by email through the JSON API" do
+    untenanted do
+      code = request_sign_in_code
+
+      post session_magic_link_path, params: { code: "000000" }, as: :json
+      assert_response :unauthorized
+
+      post session_magic_link_path, params: { code: code }, as: :json
+      assert_response :ok
+      assert_equal cookies[:session_token], response.parsed_body.fetch("session_token")
+    end
+  end
+
+  private
+    def request_sign_in_code
+      email = identities(:kevin).email_address
+      message = capture_emails do
+        post session_path, params: { email_address: " #{email.upcase} " }, as: :json
+      end.sole
+      assert_response :created
+      assert_equal cookies[:pending_authentication_token], response.parsed_body.fetch("pending_authentication_token")
+      assert_equal [ email ], message.to
+      message.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
