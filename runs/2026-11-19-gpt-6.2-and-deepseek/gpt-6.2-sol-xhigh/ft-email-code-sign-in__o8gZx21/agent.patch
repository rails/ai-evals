diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..e225ff1
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,59 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_ALPHABET = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ".chars.freeze
+  EXPIRATION = 15.minutes
+  MAX_ATTEMPTS = 5
+  TOKEN_PURPOSE = :email_authentication
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  enum :purpose, %w[ sign_in sign_up join ].index_by(&:itself), scopes: false
+
+  scope :redeemable, -> { where("expires_at > ?", Time.current).where(attempts: ...MAX_ATTEMPTS) }
+
+  def self.issue(email_address:, purpose:, join_code: nil)
+    link = new(email_address: email_address, purpose: purpose, expires_at: EXPIRATION.from_now,
+      join_code: join_code, invitation_code: join_code&.code)
+
+    if !link.sign_in? || Identity.exists?(email_address: email_address)
+      code = SecureRandom.alphanumeric(CODE_LENGTH, chars: CODE_ALPHABET)
+      link.code = code
+    end
+
+    link.save!
+    IdentityMailer.sign_in_code(email_address: email_address, code: code).deliver_later if code
+    link
+  end
+
+  def self.cleanup
+    where(expires_at: ..Time.current).in_batches.delete_all
+  end
+
+  def pending_authentication_token
+    signed_id(purpose: TOKEN_PURPOSE, expires_at: expires_at)
+  end
+
+  def code=(code)
+    self.code_digest = code && digest(code)
+  end
+
+  def redeem(code)
+    available = self.class.redeemable.where(id: id)
+    normalized_code = code.strip.upcase if code.is_a?(String)
+
+    if code_digest && normalized_code&.length == CODE_LENGTH &&
+        ActiveSupport::SecurityUtils.secure_compare(code_digest, digest(normalized_code))
+      # Only the request that deletes the challenge can use it to authenticate.
+      available.delete_all == 1
+    else
+      available.update_counters(attempts: 1)
+      false
+    end
+  end
+
+  private
+    def digest(code)
+      key = Rails.application.key_generator.generate_key("magic link code")
+      OpenSSL::HMAC.hexdigest("SHA256", key, "#{id}:#{code}")
+    end
+end
