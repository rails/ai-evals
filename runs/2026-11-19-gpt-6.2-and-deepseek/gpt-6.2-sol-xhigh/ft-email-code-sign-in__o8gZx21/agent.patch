index 0000000..15d1c81
--- /dev/null
+++ b/app/views/sessions/magic_links/show.html.erb
@@ -0,0 +1,28 @@
+<% @page_title = "Enter your email code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+
+  <% if @magic_link.sign_in? %>
+    <p class="margin-block-half">If you have a Fizzy account, we sent a six-character code to <strong><%= @magic_link.email_address %></strong>.</p>
+  <% else %>
+    <p class="margin-block-half">We sent a six-character code to <strong><%= @magic_link.email_address %></strong>.</p>
+  <% end %>
+  <p class="margin-none">The code expires in 15 minutes.</p>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <%= form.label :code, "Email code", class: "visually-hidden" %>
+    <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, maxlength: MagicLink::CODE_LENGTH, class: "input center" %>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small"><%= link_to "Request a new code", restart_path, class: "txt-link" %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
