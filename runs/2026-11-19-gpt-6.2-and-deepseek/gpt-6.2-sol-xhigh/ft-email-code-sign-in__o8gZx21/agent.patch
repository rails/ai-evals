@@ -0,0 +1,147 @@
+require "test_helper"
+
+class EmailAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "sign in by email and return to the requested page" do
+    identity = identities(:kevin)
+    account = accounts(:"37s")
+    destination = board_url(boards(:writebook), script_name: account.slug)
+    get destination
+    assert_redirected_to new_session_url(script_name: nil)
+
+    untenanted do
+      code = request_email_code(identity.email_address) do
+        post session_path(script_name: nil), params: { email_address: identity.email_address }
+      end
+      assert_difference -> { identity.sessions.count }, 1 do
+        post session_magic_link_path, params: { code: code }
+      end
+      assert_redirected_to destination
+    end
+
+    follow_redirect!
+    assert_response :success
+  end
+
+  test "sign up by email and finish creating an account" do
+    email = "new-owner@example.com"
+
+    untenanted do
+      code = request_email_code(email) do
+        assert_no_difference [ "Identity.count", "Account.count" ] do
+          post signup_path, params: { signup: { email_address: email } }
+        end
+      end
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Owner" } }
+      end
+    end
+
+    owner = Identity.find_by!(email_address: email).users.sole
+    assert owner.owner?
+    assert_equal "New Owner", owner.name
+    assert_redirected_to landing_url(script_name: owner.account.slug)
+  end
+
+  test "join by email and finish setting up membership" do
+    email = "new-member@example.com"
+    join_code = account_join_codes(:"37s")
+    slug = join_code.account.slug
+
+    code = request_email_code(email) do
+      assert_no_difference [ "Identity.count", "User.count", -> { join_code.reload.usage_count } ] do
+        post join_path(code: join_code.code, script_name: slug), params: { email_address: email }
+      end
+    end
+    assert_difference -> { join_code.reload.usage_count }, 1 do
+      post session_magic_link_path(script_name: nil), params: { code: code }
+    end
+    assert_redirected_to new_users_verification_url(script_name: slug)
+    assert cookies[:session_token].present?
+
+    post users_verifications_path(script_name: slug)
+    assert_redirected_to new_users_join_url(script_name: slug)
+    post users_joins_path(script_name: slug), params: { user: { name: "New Member" } }
+    assert_redirected_to landing_url(script_name: slug)
+
+    member = join_code.account.users.find_by!(identity: Identity.find_by!(email_address: email))
+    assert member.verified?
+    assert_equal "New Member", member.name
+  end
+
+  test "a signup code does not create an identity if signups close" do
+    email = "new-owner@example.com"
+    untenanted do
+      code = request_email_code(email) do
+        post signup_path, params: { signup: { email_address: email } }
+      end
+
+      with_multi_tenant_mode(false) do
+        assert_no_difference [ "Account.count", "Identity.count", "Session.count" ] do
+          post session_magic_link_path, params: { code: code }
+        end
+        assert_redirected_to new_session_path
+      end
+    end
+  end
+
+  test "joining by email reuses an existing membership" do
+    identity = identities(:jz)
+    join_code = account_join_codes(:"37s")
+    slug = join_code.account.slug
+    code = request_email_code(identity.email_address) do
+      post join_path(code: join_code.code, script_name: slug), params: { email_address: identity.email_address }
+    end
+
+    assert_no_difference [ "Identity.count", "User.count", -> { join_code.reload.usage_count } ] do
+      post session_magic_link_path(script_name: nil), params: { code: code }
+    end
+    assert_redirected_to landing_url(script_name: slug)
+    assert cookies[:session_token].present?
+  end
+
+  test "a pending join is rejected if the join code is reset" do
+    assert_revoked_join { |join_code| join_code.reset }
+  end
+
+  test "a pending join is rejected if the join code runs out of uses" do
+    assert_revoked_join { |join_code| join_code.update!(usage_count: join_code.usage_limit) }
+  end
+
+  private
+    def assert_revoked_join
+      email = "new-member@example.com"
+      join_code = account_join_codes(:"37s")
+      code = request_email_code(email) do
+        post join_path(code: join_code.code, script_name: join_code.account.slug), params: { email_address: email }
+      end
+      yield join_code
+
+      assert_no_difference [ "Identity.count", "User.count", "Session.count", -> { join_code.reload.usage_count } ] do
+        post session_magic_link_path(script_name: nil), params: { code: code }
+      end
+      assert_response :gone
+    end
+
+    def request_email_code(email, &block)
+      deliveries = capture_emails(&block)
+      assert_equal 1, deliveries.size, "Expected an email with a code"
+      message = deliveries.sole
+      assert_equal [ email ], message.to
+      code = message.subject[/\b[A-Z0-9]{6}\b/]
+      assert code, "Expected a six-character code in the subject"
+      assert_includes message.body.decoded, code
+      assert_includes message.body.decoded, "15 minutes"
+
+      assert_redirected_to session_magic_link_path(script_name: nil)
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code][autocomplete=one-time-code]"
+      code
+    end
+end
