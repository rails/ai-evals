@@ -0,0 +1,14 @@
+module EmailAuthentication
+  private
+
+  def send_email_code(email_address, purpose:, join_code: nil)
+    link = MagicLink.issue(email_address: email_address, purpose: purpose, join_code: join_code)
+    token = link.pending_authentication_token
+    cookies[:pending_authentication_token] = { value: token, expires: link.expires_at, httponly: true, same_site: :lax }
+
+    respond_to do |format|
+      format.html { redirect_to session_magic_link_path(script_name: nil), status: :see_other }
+      format.json { render json: { pending_authentication_token: token }, status: :created }
+    end
+  end
+end
