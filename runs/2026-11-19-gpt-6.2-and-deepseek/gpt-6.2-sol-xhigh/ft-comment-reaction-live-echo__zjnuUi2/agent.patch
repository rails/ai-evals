diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..0b5d615
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,40 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :ensure_card_is_commentable
+
+  def create
+    reaction = @comment.reactions.build(reaction_params)
+
+    if reaction.save
+      render turbo_stream: turbo_stream.append([ @comment, :reactions ], partial: "cards/comments/reactions/reaction", locals: { reaction: reaction })
+    else
+      head :unprocessable_entity, content_type: Mime[:turbo_stream]
+    end
+  end
+
+  def destroy
+    reaction = @comment.reactions.find(params[:id])
+
+    if reaction.creator_id == Current.user.id
+      reaction.destroy!
+      render turbo_stream: turbo_stream.remove(reaction)
+    else
+      head :forbidden
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
