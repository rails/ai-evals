+<% owned = reaction.creator == Current.user %>
+<% content = capture do %>
+  <span class="reaction__avatar">
+    <%= avatar_preview_tag reaction.creator, hidden_for_screen_reader: true %>
+  </span>
+  <span class="for-screen-reader"><%= reaction.creator.name %>:</span>
+  <bdi class="txt-small"><%= reaction.content %></bdi>
+<% end %>
+
+<%= tag.div id: dom_id(reaction), class: class_names("reaction", "reaction--deleteable": owned),
+      title: reaction.creator.name, data: { controller: ("reaction" if owned) } do %>
+  <% if owned %>
+    <button type="button" class="reaction__toggle" aria-expanded="false" aria-label="Manage reaction: <%= reaction.content %>"
+        data-action="reaction#toggle" data-reaction-target="toggle">
+      <%= content %>
+    </button>
+
+    <%= form_with url: card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction), method: :delete,
+          data: { turbo_frame: "_top" } do |form| %>
+      <%= form.button type: :submit, class: "reaction__delete btn btn--circle btn--plain", title: "Remove reaction" do %>
+        <%= icon_tag "trash" %>
+        <span class="for-screen-reader">Remove reaction</span>
+      <% end %>
+    <% end %>
+  <% else %>
+    <%= content %>
+  <% end %>
+<% end %>
