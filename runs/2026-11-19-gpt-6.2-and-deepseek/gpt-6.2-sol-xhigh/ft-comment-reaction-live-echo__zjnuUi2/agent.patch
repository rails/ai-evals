+    <button type="button" class="reactions__trigger btn btn--circle" title="Add reaction" aria-label="Add reaction"
+        data-reaction-form-target="trigger" data-action="reaction-form#open">
+      <%= image_tag "boost-color.svg", alt: "" %>
