diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..1153a6c
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "create a reaction as the signed in user" do
+    content = "🚀" * 16
+
+    assert_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), as: :turbo_stream,
+        params: { reaction: { content: content, creator_id: users(:jz).id } }
+    end
+
+    reaction = @comment.reactions.last
+    assert_equal content, reaction.content
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @card.account, reaction.account
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions) do
+      assert_select "##{dom_id(reaction)} bdi", text: content
+    end
+  end
+
+  test "reject blank and overlong reactions" do
+    [ "", "   ", "🚀" * 17 ].each do |content|
+      assert_no_difference -> { @comment.reactions.count } do
+        post card_comment_reactions_path(@card, @comment), as: :turbo_stream, params: { reaction: { content: content } }
+      end
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "create renders reaction text without interpreting it as HTML" do
+    content = "<b>Great!</b>"
+    post card_comment_reactions_path(@card, @comment), as: :turbo_stream, params: { reaction: { content: content } }
+
+    assert_select ".reaction bdi", text: content do
+      assert_select "b", count: 0
+    end
+  end
+
+  test "remove your own reaction" do
+    reaction = @comment.reactions.create!(creator: users(:kevin), content: "🎉")
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "cannot remove someone else's reaction" do
+    reaction = @comment.reactions.create!(creator: users(:jz), content: "🎉")
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot remove a reaction on a different comment" do
+    reaction = @comment.reactions.create!(creator: users(:kevin), content: "🎉")
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, comments(:logo_agreement_kevin), reaction), as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "cannot react to a comment on a card you cannot access" do
+    comment = Current.with(user: users(:kevin)) do
+      card = boards(:private).cards.create!(title: "Private card", status: :published)
+      card.comments.create!(body: "Private comment")
+    end
+    logout_and_sign_in_as :jz
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(comment.card, comment), as: :turbo_stream, params: { reaction: { content: "🎉" } }
+    end
+
+    assert_response :not_found
+  end
+end
