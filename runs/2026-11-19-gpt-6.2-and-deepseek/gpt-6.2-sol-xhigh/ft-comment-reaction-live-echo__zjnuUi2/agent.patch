diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..30c3511
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,68 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @comment = comments(:logo_agreement_jz)
+    sign_in_as users(:kevin)
+    visit card_url(@comment.card)
+  end
+
+  test "add, cancel, and remove reactions on someone else's comment" do
+    within "##{dom_id(@comment)}" do
+      click_on "Add reaction"
+      fill_in "Reaction", with: "Not this one"
+      click_on "Cancel reaction"
+      assert_no_field "Reaction"
+      assert_no_text "Not this one"
+
+      click_on "Add reaction"
+      assert_field "Reaction", with: ""
+      fill_in "Reaction", with: "🚀"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "🚀", count: 1
+      assert_no_field "Reaction"
+      assert_button "Add reaction"
+
+      click_on "Add reaction"
+      fill_in "Reaction", with: "a" * 17
+      click_on "Confirm reaction"
+      assert_selector "input.reaction__input:invalid"
+
+      fill_in "Reaction", with: "Nicely done"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "Nicely done"
+      assert_no_field "Reaction"
+
+      assert_no_button "Remove reaction"
+      find(".reaction__toggle", text: "🚀").click
+      click_on "Remove reaction"
+      assert_no_selector ".reactions__list .reaction", text: "🚀"
+      assert_selector ".reactions__list .reaction", text: "Nicely done"
+    end
+  end
+
+  test "other viewers receive live updates without losing a reaction in progress" do
+    assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+
+    within "##{dom_id(@comment)}" do
+      click_on "Add reaction"
+      fill_in "Reaction", with: "My draft"
+
+      reaction = @comment.reactions.create!(creator: users(:jz), content: "Looks good")
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+      assert_selector ".reactions__list .reaction", text: "Looks good", wait: 5
+      assert_selector ".reaction__avatar img[title='#{users(:jz).name}']"
+      assert_no_selector ".reaction__toggle", text: "Looks good"
+      assert_field "Reaction", with: "My draft"
+
+      reaction.destroy!
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+      assert_no_selector ".reactions__list .reaction", text: "Looks good", wait: 5
+      assert_field "Reaction", with: "My draft"
+    end
+  end
+end
