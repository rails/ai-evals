+      <button type="button" class="reaction__cancel-btn btn btn--circle btn--plain" title="Cancel reaction" aria-label="Cancel reaction" data-action="reaction-form#close">
+        <%= icon_tag "close-circle" %>
+      </button>
+    <% end %>
+  </div>
+</div>
