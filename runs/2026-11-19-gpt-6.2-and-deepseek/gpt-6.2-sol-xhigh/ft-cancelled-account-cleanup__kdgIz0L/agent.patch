diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..8c50a2e
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates overdue accounts and their data without deleting shared identities" do
+    account = accounts(:"37s")
+    identity = identities(:david)
+    other_membership = accounts(:initech).users.create!(name: "David", identity: identity)
+    board = boards(:writebook)
+    card = cards(:logo)
+    card.reindex
+    other_card = cards(:radio)
+    other_card.reindex
+    file_fixture("moon.jpg").open do |image|
+      card.image.attach io: image, filename: "moon.jpg", content_type: "image/jpeg"
+    end
+    blob = card.image.blob
+    board.update!(public_description: ActionText::Attachment.from_attachable(blob).to_html)
+    account.materialize_storage
+    unattached_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("unused"), filename: "unused.txt")
+    cancel(account, 31.days.ago, initiated_by: users(:david))
+
+    perform_enqueued_jobs(only: [ Account::IncinerateDueJob, ActiveStorage::PurgeJob ]) do
+      Account::IncinerateDueJob.perform_later
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_not Account::Cancellation.exists?(account_id: account.id)
+    assert_not Account::JoinCode.exists?(account_id: account.id)
+    assert_not User.exists?(account_id: account.id)
+    assert_not Board.exists?(account_id: account.id)
+    assert_not Card.exists?(account_id: account.id)
+    assert_not Comment.exists?(account_id: account.id)
+    assert_not Export.exists?(account_id: account.id)
+    assert_not ActionText::RichText.exists?(account_id: account.id)
+    assert_not Search::Record.for(account.id).exists?(account_id: account.id)
+    assert_not Storage::Entry.exists?(account_id: account.id)
+    assert_not Storage::Total.exists?(owner: account)
+    assert_not ActiveStorage::Attachment.exists?(account_id: account.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.exists?(unattached_blob.id)
+    assert Search::Record.for(other_card.account_id).exists?(searchable_type: "Card", searchable_id: other_card.id)
+    assert_equal identity, other_membership.reload.identity
+    assert_equal identity, sessions(:david).identity
+  end
+
+  test "keeps active accounts and cancellations no more than 30 days old" do
+    recent = accounts(:"37s")
+    at_cutoff = accounts(:initech)
+    active = accounts(:acme)
+
+    now = Time.current.change(usec: 0)
+    cancel(recent, now - 29.days, initiated_by: users(:david))
+    cancel(at_cutoff, now - 30.days, initiated_by: users(:mike))
+
+    travel_to(now) { Account::IncinerateDueJob.perform_now }
+
+    assert recent.reload.cancelled?
+    assert at_cutoff.reload.cancelled?
+    assert active.reload.active?
+  end
+
+  test "keeps an account reactivated before incineration" do
+    account = accounts(:"37s")
+    cancel(account, 31.days.ago, initiated_by: users(:david))
+    account.reactivate
+
+    Account::IncinerateDueJob.perform_now
+
+    assert account.reload.active?
+  end
+
+  test "incinerates every overdue account and can be run again" do
+    first = accounts(:"37s")
+    second = accounts(:initech)
+    now = Time.current.change(usec: 0)
+    cancel(first, now - 32.days, initiated_by: users(:david))
+    cancel(second, now - 30.days - 1.second, initiated_by: users(:mike))
+
+    travel_to now do
+      assert_difference -> { Account.count }, -2 do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+  end
+
+  private
+    def cancel(account, at, initiated_by:)
+      travel_to(at) { account.cancel(initiated_by: initiated_by) }
+    end
+end
