diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..7be45a1 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,30 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  class_methods do
+    def incinerate_due
+      cutoff = INCINERATION_GRACE_PERIOD.ago
+
+      Account::Cancellation.where(created_at: ...cutoff).find_each do |cancellation|
+        transaction do
+          # Reactivation takes the same lock, so recheck after acquiring it.
+          if (account = lock.find_by(id: cancellation.account_id)) && account.cancellation&.created_at&.before?(cutoff)
+            incinerate(account)
+          end
+        end
+      end
+    end
+
+    private
+      def incinerate(account)
+        # Attached blobs are purged by their attachment callbacks. Also purge unused uploads.
+        ActiveStorage::Blob.unattached.where(account: account).find_each(&:purge_later)
+        account.destroy!
+
+        # Clear any stale search entries left behind by earlier deletions.
+        Search::Record.for(account.id).where(account_id: account.id).find_each(&:destroy!)
+      end
+  end
 end
