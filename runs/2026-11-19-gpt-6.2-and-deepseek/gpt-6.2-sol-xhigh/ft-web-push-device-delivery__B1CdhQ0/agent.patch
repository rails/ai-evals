+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    @endpoint = "https://fcm.googleapis.com/fcm/send/test-browser"
+    @p256dh = WebPush.generate_key.public_key
+    @auth = WebPush.encode64(SecureRandom.random_bytes(16))
+    Push.stubs(:enabled?).returns(true)
+    Push.stubs(:public_key).returns(WebPush.generate_key.public_key)
+
+    sign_in_as @user
+  end
+
+  test "turns on push for this device and remembers the saved subscription" do
+    stub_browser_push_manager
+    visit notifications_settings_path
+
+    assert_text "Push notifications are off for this device."
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      assert_button "Turn on push notifications"
+    end
+    click_on "Turn on push notifications"
+    assert_text "Push notifications are on for this device."
+
+    subscription = @user.push_subscriptions.sole
+    assert_equal @endpoint, subscription.endpoint
+    assert_equal @p256dh, subscription.p256dh_key
+    assert_equal @auth, subscription.auth_key
+
+    visit notifications_settings_path
+    assert_text "Push notifications are on for this device."
+    assert_no_button "Turn on push notifications"
+  end
+
+  test "shows help instead of asking again when the browser blocks notifications" do
+    browser_script <<~JS
+      Object.defineProperty(Notification, "permission", { value: "denied" })
+    JS
+    visit notifications_settings_path
+
+    assert_text "Your browser is blocking notifications."
+    assert_selector "details[open]", text: "Trouble getting notifications?"
+    assert_no_button "Turn on push notifications"
+  end
+
+  test "the service worker shows the tray message and opens its card" do
+    path = card_path(cards(:logo))
+    worker = page.evaluate_async_script('fetch("/service-worker.js").then(response => response.text()).then(arguments[0])')
+    result = page.evaluate_async_script(<<~JS)
+      const done = arguments[0]
+      const handlers = {}
+      const actions = {}
+      const self = {
+        location: window.location,
+        addEventListener: (type, handler) => { handlers[type] = handler },
+        registration: { showNotification: async (title, options) => { actions.notification = { title, ...options } } },
+        clients: {
+          matchAll: async () => [],
+          openWindow: async (url) => { actions.opened = url }
+        }
+      }
+      const importScripts = () => {}
+      const TurboOffline = { addRule() {}, start() {}, handlers: { networkFirst() {}, cacheFirst() {} } }
+      #{worker}
+
+      const payload = { title: "Logo", body: "Assigned to Kevin", url: #{path.to_json} }
+      handlers.push({ data: { json: () => payload }, waitUntil: async (promise) => {
+        await promise
+        handlers.notificationclick({
+          notification: { data: actions.notification.data, close: () => { actions.closed = true } },
+          waitUntil: async (promise) => { await promise; done(actions) }
+        })
+      } })
+    JS
+
+    assert_equal "Logo", result.dig("notification", "title")
+    assert_equal "Assigned to Kevin", result.dig("notification", "body")
+    assert result["closed"]
+    assert_equal path, URI.parse(result["opened"]).path
+  end
+
+  private
+    def stub_browser_push_manager
+      browser_script <<~JS
+        const subscription = {
+          endpoint: #{@endpoint.to_json},
+          keys: { p256dh: #{@p256dh.to_json}, auth: #{@auth.to_json} }
+        }
+        Object.defineProperty(Notification, "permission", { get: () => localStorage.pushSubscribed ? "granted" : "default" })
+        PushManager.prototype.getSubscription = async () => localStorage.pushSubscribed ? subscription : null
+        PushManager.prototype.subscribe = async ({ userVisibleOnly, applicationServerKey }) => {
+          if (!userVisibleOnly || applicationServerKey.byteLength !== 65) throw new Error("Invalid options")
+          localStorage.pushSubscribed = "1"
+          return { toJSON: () => subscription }
+        }
+      JS
+    end
+
+    def browser_script(source)
+      page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: source)
+    end
