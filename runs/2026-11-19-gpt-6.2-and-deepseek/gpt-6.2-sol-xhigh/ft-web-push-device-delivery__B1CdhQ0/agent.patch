diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..7a94c64
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,88 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+import { serviceWorkerRegistration } from "initializers/offline"
+
+export default class extends Controller {
+  static targets = ["enable", "error", "help"]
+  static values = { url: String, publicKey: String, endpoints: Array }
+
+  async connect() {
+    this.helpTarget.hidden = false
+    this.#showError("")
+
+    if (!("Notification" in window && "PushManager" in window && "serviceWorker" in navigator)) {
+      this.#showError("Push notifications aren't available in this browser.")
+    } else if (Notification.permission === "denied") {
+      this.#showBlocked()
+    } else {
+      try {
+        if (!await serviceWorkerRegistration) throw new Error("Service worker unavailable")
+
+        this.registration = await navigator.serviceWorker.ready
+        const subscription = await this.registration.pushManager.getSubscription()
+        const enabled = subscription && this.endpointsValue.includes(await this.#digest(subscription.endpoint))
+        this.#showStatus(enabled)
+      } catch {
+        this.#showError("Push notifications couldn't be set up. Reload this page and try again.")
+      }
+    }
+  }
+
+  async enable() {
+    this.enableTarget.disabled = true
+    this.#showError("")
+
+    try {
+      // Subscribe directly in the click handler so the browser can ask for permission.
+      const subscription = await this.registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+      const { endpoint, keys } = subscription.toJSON()
+      const response = await post(this.urlValue, {
+        body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+        responseKind: "json",
+        redirect: "error"
+      })
+      if (!response.ok) throw new Error("Subscription registration failed")
+
+      this.endpointsValue = [...this.endpointsValue, await this.#digest(endpoint)]
+      this.#showStatus(true)
+    } catch {
+      if (Notification.permission === "denied") {
+        this.#showBlocked()
+      } else {
+        this.#showError("Push notifications couldn't be turned on. Please try again.")
+      }
+    } finally {
+      this.enableTarget.disabled = false
+    }
+  }
+
+  #showStatus(enabled) {
+    this.element.classList.toggle("notifications--on", Boolean(enabled))
+    this.enableTarget.hidden = Boolean(enabled)
+  }
+
+  #showBlocked() {
+    this.element.classList.remove("notifications--on")
+    this.enableTarget.hidden = true
+    this.#showError("Your browser is blocking notifications. Allow them in your settings, then reload this page.")
+  }
+
+  #showError(message) {
+    this.errorTarget.textContent = message
+    this.errorTarget.hidden = !message
+    if (message) this.helpTarget.open = true
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+
+  async #digest(endpoint) {
+    const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(endpoint))
+    return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, "0")).join("")
+  }
+}
