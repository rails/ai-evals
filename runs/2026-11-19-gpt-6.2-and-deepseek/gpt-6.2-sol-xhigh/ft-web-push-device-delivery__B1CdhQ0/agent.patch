+    }
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..94d23e4
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,93 @@
+class Push::Subscription < ApplicationRecord
+  # Endpoints come from the browser but are submitted by the user. Only send
+  # requests to known push providers, never to arbitrary HTTPS URLs.
+  PUSH_SERVICE_HOSTS = /\A(?:
+    fcm\.googleapis\.com|android\.googleapis\.com|
+    updates\.push\.services\.mozilla\.com|
+    [\w.-]+\.push\.apple\.com|[\w.-]+\.notify\.windows\.com
+  )\z/ix
+  ENDPOINT_TIMEOUT = 5.seconds
+  MAX_MESSAGE_BYTES = 3900 # Leave room for encrypted Web Push framing in a 4 KiB request.
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  belongs_to :session
+
+  validates :endpoint, presence: true, length: { maximum: 4096 }
+  validates :p256dh_key, :auth_key, presence: true, length: { maximum: 88 }
+  validate :validate_endpoint, :validate_keys
+
+  before_validation { self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s) }
+
+  def self.register(user:, session:, endpoint: nil, **keys)
+    user.with_lock do
+      user.push_subscriptions.find_or_initialize_by(endpoint_digest: Digest::SHA256.hexdigest(endpoint.to_s)).tap do |subscription|
+        subscription.update(endpoint: endpoint, session: session, **keys)
+      end
+    end
+  end
+
+  def deliver(notification, source:)
+    if deliverable?(notification)
+      WebPush.payload_send(
+        message: message_for(source),
+        endpoint: endpoint, p256dh: p256dh_key, auth: auth_key, vapid: Push.vapid,
+        open_timeout: ENDPOINT_TIMEOUT, read_timeout: ENDPOINT_TIMEOUT, ttl: 1.day.to_i
+      )
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def message_for(source)
+      content = Notification::Content.new(source)
+      path = Rails.application.routes.url_helpers.polymorphic_path(source.notifiable_target, script_name: account.slug, only_path: true)
+      payload = { title: content.title, body: content.body, url: path }
+      message = payload.to_json
+
+      if message.bytesize <= MAX_MESSAGE_BYTES
+        message
+      else
+        payload.merge(title: payload[:title].truncate(280), body: payload[:body].truncate(350)).to_json
+      end
+    end
+
+    def deliverable?(notification)
+      Push.enabled? && valid_endpoint? && account.active? && user.active? &&
+        user_id == notification.user_id && session && user.identity_id == session.identity_id &&
+        notification.card&.board&.accessible_to?(user)
+    end
+
+    def validate_endpoint
+      errors.add(:endpoint, "must be a browser push service URL") unless valid_endpoint?
+    end
+
+    def valid_endpoint?
+      uri = URI.parse(endpoint.to_s)
+      uri.is_a?(URI::HTTPS) && uri.port == 443 && uri.userinfo.nil? && uri.fragment.nil? &&
+        uri.host&.match?(PUSH_SERVICE_HOSTS) && uri.request_uri != "/"
+    rescue URI::InvalidURIError
+      false
+    end
+
+    def validate_keys
+      errors.add(:auth_key, :invalid) unless decode_key(auth_key)&.bytesize == 16
+      errors.add(:p256dh_key, :invalid) unless valid_public_key?
+    end
+
+    def valid_public_key?
+      key = decode_key(p256dh_key)
+      if key&.bytesize == 65 && key.getbyte(0) == 4
+        OpenSSL::PKey::EC::Point.new(OpenSSL::PKey::EC::Group.new("prime256v1"), key).on_curve?
+      end
+    rescue OpenSSL::PKey::EC::Point::Error
+      false
+    end
+
+    def decode_key(key)
+      WebPush.decode64(key) if key.present? && key.bytesize <= 88
+    rescue ArgumentError
+      nil
+    end
+end
