diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..995b828
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    Push.stubs(:enabled?).returns(true)
+
+    @subscription = {
+      endpoint: "https://fcm.googleapis.com/fcm/send/test-device",
+      p256dh_key: WebPush.generate_key.public_key,
+      auth_key: WebPush.encode64(SecureRandom.random_bytes(16))
+    }
+  end
+
+  test "registers the current browser for the signed-in user" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+
+    assert_response :no_content
+    subscription = @user.push_subscriptions.sole
+    assert_equal @subscription.stringify_keys, subscription.attributes.slice(*@subscription.keys.map(&:to_s))
+    assert_equal @user.account, subscription.account
+    assert_equal @user.identity, subscription.session.identity
+  end
+
+  test "registering the same browser refreshes the keys without adding a duplicate" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    assert_response :no_content
+
+    @subscription[:auth_key] = WebPush.encode64(SecureRandom.random_bytes(16))
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    end
+    assert_response :no_content
+    assert_equal @subscription[:auth_key], @user.push_subscriptions.sole.auth_key
+  end
+
+  test "cannot register a browser for another user" do
+    post user_push_subscriptions_path(users(:jz)), params: { push_subscription: @subscription }, as: :json
+
+    assert_response :forbidden
+  end
+
+  test "rejects a URL that is not a push service endpoint" do
+    @subscription[:endpoint] = "https://127.0.0.1/push"
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+
+    assert_response :unprocessable_entity
+  end
+
+  test "rejects malformed subscription keys" do
+    @subscription[:p256dh_key] = "not a key"
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+
+    assert_response :unprocessable_entity
+  end
+
+  test "rejects an incomplete registration" do
+    @subscription.delete(:auth_key)
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+
+    assert_response :unprocessable_entity
+  end
+
+  test "registration is unavailable if push is not configured" do
+    Push.stubs(:enabled?).returns(false)
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+
+    assert_response :service_unavailable
+    assert_empty @user.push_subscriptions
+  end
+
+  test "signing out removes only the subscription for this session" do
+    other_device = @user.push_subscriptions.create!(**@subscription, endpoint: "https://fcm.googleapis.com/fcm/send/other-device",
+      session: @user.identity.sessions.create!)
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    assert_response :no_content
+
+    sign_out
+
+    assert_equal other_device, @user.push_subscriptions.sole
+  end
+end
diff --git a/test/jobs/push/delivery_job_test.rb b/test/jobs/push/delivery_job_test.rb
new file mode 100644
index 0000000..4a26168
--- /dev/null
+++ b/test/jobs/push/delivery_job_test.rb
@@ -0,0 +1,154 @@
+require "test_helper"
+
+class Push::DeliveryJobTest < ActiveJob::TestCase
+  include ActionView::RecordIdentifier
+  include Rails.application.routes.url_helpers
+
+  setup do
+    @user = users(:kevin)
+    @session = @user.identity.sessions.create!
+    @vapid_key = WebPush.generate_key
+    @previous_vapid = ENV.to_h.slice("VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY")
+    ENV["VAPID_PUBLIC_KEY"] = @vapid_key.public_key
+    ENV["VAPID_PRIVATE_KEY"] = @vapid_key.private_key
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+    ENV.update(@previous_vapid)
+  end
+
+  test "a new tray notification delivers to all of the recipient's devices and no one else's" do
+    phone = subscribe("phone")
+    desktop = subscribe("desktop", session: @user.identity.sessions.create!)
+    other_user = users(:david)
+    subscribe("other-user", user: other_user, session: other_user.identity.sessions.create!)
+    source = events(:logo_assignment_km)
+    notifications(:logo_assignment_kevin).destroy!
+
+    [ phone, desktop ].each do |subscription|
+      expect_push(subscription, title: cards(:logo).title, body: "Assigned to #{@user.name}", url: card_path(cards(:logo), script_name: @user.account.slug))
+    end
+
+    perform_enqueued_jobs only: Push::DeliveryJob do
+      source.notify_recipients
+    end
+  end
+
+  test "new activity still pushes when an existing tray notification is updated" do
+    notification = notifications(:logo_mentioned_david)
+    source = notification.source
+    comment = source.source
+    notification.update!(source: events(:logo_published), creator: users(:david))
+
+    user = notification.user
+    subscription = subscribe("phone", user: user, session: user.identity.sessions.create!)
+
+    expect_push(subscription, title: "#{source.mentioner.first_name} @mentioned you", body: comment.mentionable_content,
+      url: card_path(comment.card, script_name: user.account.slug, anchor: dom_id(comment)))
+
+    assert_no_difference -> { Notification.count } do
+      perform_enqueued_jobs only: Push::DeliveryJob do
+        notification.update!(source: source, creator: source.mentioner, unread_count: notification.unread_count + 1)
+      end
+    end
+  end
+
+  test "reads and manual marks as unread do not push" do
+    subscribe("desktop")
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs only: Push::DeliveryJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "deleting a session before a job runs prevents delivery" do
+    subscribe("phone")
+    notification = notifications(:logo_assignment_kevin)
+    notification.update!(source: events(:logo_published))
+    @session.destroy!
+
+    WebPush.expects(:payload_send).never
+    perform_enqueued_jobs only: Push::DeliveryJob
+  end
+
+  test "does not deliver if the recipient can no longer access the card" do
+    subscription = subscribe("phone")
+    notification = notifications(:logo_assignment_kevin)
+    notification.card.board.access_for(@user).delete
+
+    WebPush.expects(:payload_send).never
+    Push::DeliveryJob.perform_now(subscription, notification, notification.source)
+  end
+
+  test "the push service receives an encrypted, VAPID signed request" do
+    subscription = subscribe("phone")
+    notification = notifications(:logo_assignment_kevin)
+    request = stub_request(:post, subscription.endpoint).with(headers: {
+      "Content-Encoding" => "aes128gcm",
+      "Authorization" => /\Avapid t=.+,k=#{Regexp.escape(@vapid_key.public_key.delete('='))}\z/
+    }).to_return(status: 201)
+
+    Push::DeliveryJob.perform_now(subscription, notification, notification.source)
+
+    assert_requested request
+  end
+
+  test "an unusually long tray message still fits into a Web Push request" do
+    subscription = subscribe("phone")
+    notification = notifications(:logo_assignment_kevin)
+    content = Notification::Content.new(notification.source)
+    content.stubs(:title).returns("<&>" * 1000)
+    Notification::Content.stubs(:new).returns(content)
+
+    request = stub_request(:post, subscription.endpoint).with { |req| req.body.bytesize <= 4096 }.to_return(status: 201)
+
+    Push::DeliveryJob.perform_now(subscription, notification, notification.source)
+
+    assert_requested request
+  end
+
+  test "gone and not found subscriptions are removed without affecting another device" do
+    phone = subscribe("phone")
+    tablet = subscribe("tablet")
+    desktop = subscribe("desktop")
+    [ [ phone, 410 ], [ tablet, 404 ], [ desktop, 201 ] ].each do |subscription, status|
+      stub_request(:post, subscription.endpoint).to_return(status: status)
+    end
+
+    perform_enqueued_jobs only: Push::DeliveryJob do
+      notifications(:logo_assignment_kevin).update!(source: events(:logo_published))
+    end
+
+    assert_equal desktop, @user.push_subscriptions.sole
+    assert_requested :post, desktop.endpoint
+  end
+
+  test "a temporary push service failure is retried and does not remove the device" do
+    subscription = subscribe("phone")
+    notification = notifications(:logo_assignment_kevin)
+    stub_request(:post, subscription.endpoint).to_return(status: 503)
+
+    assert_enqueued_with(job: Push::DeliveryJob, args: [ subscription, notification, notification.source ]) do
+      Push::DeliveryJob.perform_now(subscription, notification, notification.source)
+    end
+    assert_equal subscription, @user.push_subscriptions.sole
+  end
+
+  private
+    def subscribe(device, user: @user, session: @session)
+      user.push_subscriptions.create!(session: session, endpoint: "https://fcm.googleapis.com/fcm/send/#{device}",
+        p256dh_key: WebPush.generate_key.public_key, auth_key: WebPush.encode64(SecureRandom.random_bytes(16)))
+    end
+
+    def expect_push(subscription, **payload)
+      WebPush.expects(:payload_send).with do |message:, endpoint:, p256dh:, auth:, vapid:, **|
+        JSON.parse(message, symbolize_names: true) == payload && endpoint == subscription.endpoint &&
+          p256dh == subscription.p256dh_key && auth == subscription.auth_key &&
+          vapid[:public_key] == @vapid_key.public_key && vapid[:private_key] == @vapid_key.private_key
+      end
+    end
+end
