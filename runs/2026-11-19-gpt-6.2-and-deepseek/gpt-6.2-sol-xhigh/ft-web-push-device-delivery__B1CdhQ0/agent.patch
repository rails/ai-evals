new file mode 100644
index 0000000..d2d7264
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,21 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :ensure_current_session_user
+
+  def create
+    if Push.enabled?
+      subscription = Push::Subscription.register(user: Current.user, session: Current.session, **subscription_params.to_h.symbolize_keys)
+      head(subscription.errors.empty? ? :no_content : :unprocessable_entity)
+    else
+      head :service_unavailable
+    end
+  end
+
+  private
+    def ensure_current_session_user
+      head :forbidden unless Current.session && Current.user.id == params[:user_id]
+    end
+
+    def subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
