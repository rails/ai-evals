+require "rails_helper"
+
+RSpec.describe ActiveStorage::Service::ForemS3Service do
+  subject(:service) { described_class.new(bucket: bucket, **credentials) }
+
+  let(:bucket) { "forem-profile-picture-test" }
+  let(:credentials) { { region: "us-east-1", aws_access_key_id: "test", aws_secret_access_key: "test" } }
+  let(:client) { Fog::AWS::Storage.new(credentials) }
+
+  before do
+    allow(Fog).to receive(:mocking?).and_return(true)
+    client.put_bucket(bucket)
+    allow(Fog::Storage).to receive(:new).with(provider: "AWS", **credentials).and_return(client)
+  end
+
+  it "stores and streams the picture from its own prefix in the existing bucket" do
+    image = "image contents"
+    service.upload("avatar", StringIO.new(image), content_type: "image/png", checksum: Digest::MD5.base64digest(image))
+
+    expect(client.get_object(bucket, "active-storage/avatar").body).to eq(image)
+    expect(service.download("avatar")).to eq(image)
+    expect { |block| service.download("avatar", &block) }.to yield_with_args(image)
+    expect(service.download_chunk("avatar", 0..4)).to eq("image")
+  end
+
+  it "does not delete legacy files when purging Active Storage objects" do
+    client.put_object(bucket, "uploads/user/profile_image/1/legacy.png", "legacy")
+    service.upload("avatar", StringIO.new("profile image"))
+    service.upload("variants/avatar/small", StringIO.new("variant"))
+    service.delete("avatar")
+    service.delete_prefixed("variants/avatar/")
+
+    expect(service.exist?("avatar")).to be(false)
+    expect(service.exist?("variants/avatar/small")).to be(false)
+    expect(client.get_object(bucket, "uploads/user/profile_image/1/legacy.png").body).to eq("legacy")
+  end
+end
