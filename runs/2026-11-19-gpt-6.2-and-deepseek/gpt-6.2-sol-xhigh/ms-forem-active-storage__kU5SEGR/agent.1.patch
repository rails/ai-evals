diff --git a/app/services/images/profile_picture_upload.rb b/app/services/images/profile_picture_upload.rb
new file mode 100644
index 0000000..d75c385
--- /dev/null
+++ b/app/services/images/profile_picture_upload.rb
@@ -0,0 +1,33 @@
+module Images
+  module ProfilePictureUpload
+    # Reuse the existing image checks, EXIF stripping, and SSRF-safe downloader,
+    # but only stage data in a private temporary directory. Never store it with CarrierWave.
+    class TemporaryUploader < ProfileImageUploader
+      cache_storage :file
+      self.cache_dir = "cache"
+    end
+    private_constant :TemporaryUploader
+
+    def self.call(source)
+      Dir.mktmpdir("profile-picture") do |dir|
+        uploader = TemporaryUploader.new
+        uploader.root = dir
+        uploader.enable_processing = ProfileImageUploader.enable_processing
+        if source.is_a?(String) && source.match?(%r{\Ahttps?://}i)
+          uploader.download!(source)
+        elsif source.respond_to?(:read)
+          uploader.cache!(source)
+          raise CarrierWave::IntegrityError, I18n.t("errors.messages.unsupported_image_type") if uploader.file.blank?
+        else
+          raise CarrierWave::IntegrityError, I18n.t("errors.messages.unsupported_image_type")
+        end
+
+        next if uploader.file.blank?
+
+        # Do not disclose the original upload filename in the public URL.
+        filename = "#{SecureRandom.uuid}.#{uploader.file.extension}"
+        { io: StringIO.new(File.binread(uploader.path)), filename: filename }
+      end
+    end
+  end
+end
