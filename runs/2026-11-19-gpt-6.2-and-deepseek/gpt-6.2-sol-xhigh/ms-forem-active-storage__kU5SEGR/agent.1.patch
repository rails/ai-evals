diff --git a/app/models/concerns/profile_picture.rb b/app/models/concerns/profile_picture.rb
new file mode 100644
index 0000000..0b8293a
--- /dev/null
+++ b/app/models/concerns/profile_picture.rb
@@ -0,0 +1,96 @@
+# The profile_image column still contains the original CarrierWave identifier.
+# Keep it intact: old pages, feeds, and notifications can still reference that file.
+module ProfilePicture
+  extend ActiveSupport::Concern
+
+  ImageReference = Struct.new(:url) do
+    def as_json(*)
+      { "url" => url }
+    end
+
+    delegate :to_s, to: :url
+  end
+  private_constant :ImageReference
+
+  included do
+    has_one_attached :profile_picture
+    before_save { @saved_profile_picture_change = attachment_changes.key?("profile_picture") }
+    after_touch { @saved_profile_picture_change = false unless attachment_changes.key?("profile_picture") }
+    after_destroy_commit :remove_legacy_profile_image
+    validate :validate_profile_picture_upload
+  end
+
+  # Preserve the existing form field and JSON shape (profile_image.url).
+  def profile_image
+    return legacy_profile_image unless profile_picture.attached?
+
+    ImageReference.new(profile_image_url)
+  end
+
+  def profile_image_url
+    # Do not publish a pending replacement if another validation prevents it from saving.
+    blob = profile_picture_attachment&.blob
+    return legacy_profile_image.url unless blob&.persisted?
+
+    # Use a non-expiring origin URL, not a service URL that expires in cached content.
+    path = Rails.application.routes.url_helpers.rails_service_blob_proxy_path(blob.signed_id, blob.filename)
+    URL.url(path)
+  end
+
+  def profile_image=(file)
+    assign_profile_picture(file)
+  end
+
+  attr_reader :remote_profile_image_url
+
+  def remote_profile_image_url=(source)
+    @remote_profile_image_url = source if source.is_a?(String) || source.nil?
+    assign_profile_picture(source)
+  end
+
+  def reload(...)
+    super.tap do
+      @profile_picture_upload_error = nil
+      @saved_profile_picture_change = false
+      @remote_profile_image_url = nil
+    end
+  end
+
+  private
+
+  def assign_profile_picture(source)
+    @profile_picture_upload_error = nil
+    return if source.blank?
+
+    attachable = Images::ProfilePictureUpload.call(source)
+    self.profile_picture = attachable if attachable
+  rescue CarrierWave::IntegrityError, CarrierWave::ProcessingError, CarrierWave::DownloadError => e
+    @profile_picture_upload_error = e.message
+  end
+
+  def validate_profile_picture_upload
+    return unless @profile_picture_upload_error
+
+    errors.add(:profile_image, @profile_picture_upload_error)
+  end
+
+  def legacy_profile_image
+    ProfileImageUploader.new(self, :profile_image).tap do |uploader|
+      identifier = self[:profile_image] if has_attribute?(:profile_image)
+      uploader.retrieve_from_store!(identifier) if identifier.present?
+    end
+  end
+
+  def remove_legacy_profile_image
+    uploader = legacy_profile_image
+    uploader.remove! if uploader.file
+  end
+
+  def saved_change_to_profile_picture?
+    @saved_profile_picture_change
+  end
+
+  def profile_image_changed_for_cache?
+    saved_change_to_profile_picture? || saved_change_to_profile_image?
+  end
+end
