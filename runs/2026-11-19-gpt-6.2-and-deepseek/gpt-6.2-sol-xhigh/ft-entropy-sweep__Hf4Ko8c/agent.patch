+      def each_card_in_activity_order(scope, &block)
+        query = scope.reorder(:last_active_at, :id).limit(SWEEP_BATCH_SIZE).skip_query_cache!
+        batch = query
+
+        loop do
+          cards = batch.to_a
+          break if cards.empty?
+
+          # Capture the cursor before postponing changes last_active_at.
+          last = cards.last
+          cursor = [ last.last_active_at_before_type_cast, last.id_for_database ]
