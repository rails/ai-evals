diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..b45c702
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    Push.stubs(:enabled?).returns(true)
+
+    @subscription = {
+      endpoint: "https://push.example.com/subscriptions/device",
+      p256dh_key: WebPush.generate_key.public_key,
+      auth_key: SecureRandom.urlsafe_base64(16)
+    }
+  end
+
+  test "registers a device without duplicating the subscription on repeat requests" do
+    2.times do
+      post "#{@user.account.slug}/users/#{@user.id}/push_subscriptions", params: { push_subscription: @subscription }
+      assert_response :no_content
+    end
+
+    assert_equal 1, @user.push_subscriptions.count
+    assert_equal @subscription.stringify_keys, @user.push_subscriptions.sole.attributes.slice(*@subscription.keys.map(&:to_s))
+  end
+
+  test "cannot register a device for another user even as an administrator" do
+    post "#{@user.account.slug}/users/#{users(:kevin).id}/push_subscriptions", params: { push_subscription: @subscription }, as: :json
+
+    assert_response :forbidden
+  end
+
+  test "updates the keys for an existing endpoint" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    new_key = SecureRandom.urlsafe_base64(16)
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.merge(auth_key: new_key) }, as: :json
+    end
+
+    assert_response :no_content
+    assert_equal new_key, @user.push_subscriptions.sole.auth_key
+  end
+
+  test "rejects an invalid HTTPS endpoint or encryption key" do
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      [ { endpoint: "http://push.example.com/device" }, { p256dh_key: "not-a-key" }, { auth_key: nil } ].each do |invalid|
+        post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.merge(invalid) }, as: :json
+        assert_response :unprocessable_entity
+      end
+    end
+  end
+
+  test "turning off a device only removes the current user's registration" do
+    own = @user.push_subscriptions.create!(@subscription)
+    other = users(:kevin).push_subscriptions.create!(@subscription)
+    other_device = @user.push_subscriptions.create!(@subscription.merge(endpoint: "https://push.example.com/subscriptions/other"))
+
+    delete user_push_subscription_path(other.user, other.endpoint_digest), as: :json
+    assert_response :forbidden
+
+    delete user_push_subscription_path(@user, own.endpoint_digest), as: :json
+    assert_response :no_content
+    assert_equal [ other_device ], @user.push_subscriptions.reload.to_a
+    assert Push::Subscription.exists?(other.id)
+  end
+end
diff --git a/test/jobs/push/delivery_job_test.rb b/test/jobs/push/delivery_job_test.rb
new file mode 100644
index 0000000..3149115
--- /dev/null
+++ b/test/jobs/push/delivery_job_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Push::DeliveryJobTest < ActiveSupport::TestCase
+  setup do
+    @vapid = WebPush.generate_key
+    @user = users(:kevin)
+    @notification = notifications(:layout_commented_kevin)
+    @subscription = subscribe(@user, "phone")
+    Push.stubs(:public_key).returns(@vapid.public_key)
+    @old_private_key, ENV["VAPID_PRIVATE_KEY"] = ENV["VAPID_PRIVATE_KEY"], @vapid.private_key
+  end
+
+  teardown do
+    ENV["VAPID_PRIVATE_KEY"] = @old_private_key
+  end
+
+  test "delivers new tray activity on an existing notification" do
+    notification = notifications(:logo_assignment_kevin)
+    event = events(:logo_assignment_jz)
+    path = Rails.application.routes.url_helpers.card_path(cards(:logo), script_name: @user.account.slug)
+    Push::Request.expects(:deliver).with(@subscription, { title: cards(:logo).title, body: "Assigned to JZ", url: path }, has_keys(:public_key, :private_key)).returns(201)
+
+    perform_enqueued_jobs only: Push::DeliveryJob do
+      notification.update!(source: event, creator: users(:david), unread_count: notification.unread_count + 1)
+    end
+  end
+
+  test "sends a new mention to all the recipient's devices with the comment link" do
+    existing = notifications(:logo_mentioned_david)
+    existing.destroy!
+    mention = existing.source
+    subscriptions = [ subscribe(existing.user, "desktop"), subscribe(existing.user, "phone") ]
+    path = Rails.application.routes.url_helpers.polymorphic_url(mention, only_path: true, script_name: existing.account.slug)
+    assert_match(/\/cards\/\d+#comment_/, path)
+    message = { title: "#{mention.mentioner.first_name} @mentioned you", body: mention.source.mentionable_content.truncate(200), url: path }
+    subscriptions.each do |subscription|
+      Push::Request.expects(:deliver).with(subscription, message, has_keys(:public_key, :private_key)).returns(201)
+    end
+
+    perform_enqueued_jobs only: Push::DeliveryJob do
+      Notification.create!(user: existing.user, source: mention, creator: mention.mentioner, unread_count: 1)
+    end
+  end
+
+  test "does not send when marked read or unread manually" do
+    assert_no_enqueued_jobs only: Push::DeliveryJob do
+      @notification.read
+      @notification.unread
+    end
+  end
+
+  test "does not enqueue without a configured key pair" do
+    ENV.delete("VAPID_PRIVATE_KEY")
+    @notification.destroy!
+
+    assert_no_enqueued_jobs only: Push::DeliveryJob do
+      Notification.create!(user: @user, source: @notification.source, creator: @notification.creator, unread_count: 1)
+    end
+  end
+
+  test "sends an encrypted VAPID-authenticated request and cleans up a gone endpoint" do
+    stub_dns_resolution("8.8.8.8")
+    request = stub_request(:post, @subscription.endpoint).with do |request|
+      request.headers["Authorization"].start_with?("vapid t=") &&
+        request.headers["Content-Encoding"] == "aes128gcm" && request.body.present?
+    end.to_return(status: 410)
+    other_subscription = subscribe(@user, "desktop")
+
+    Push::DeliveryJob.perform_now(@subscription, @notification, @notification.source)
+
+    assert_requested request
+    assert_not Push::Subscription.exists?(@subscription.id)
+    assert Push::Subscription.exists?(other_subscription.id)
+  end
+
+  test "retries a push service outage without removing the subscription" do
+    stub_dns_resolution("8.8.8.8")
+    stub_request(:post, @subscription.endpoint).to_return(status: 503)
+
+    assert_enqueued_with(job: Push::DeliveryJob, args: [ @subscription, @notification, @notification.source ]) do
+      Push::DeliveryJob.perform_now(@subscription, @notification, @notification.source)
+    end
+    assert Push::Subscription.exists?(@subscription.id)
+  end
+
+  test "does not connect to a private address" do
+    stub_dns_resolution("127.0.0.1")
+    Net::HTTP.expects(:new).never
+
+    assert_nil Push::Request.deliver(@subscription, { title: "Test" }, Push.vapid)
+  end
+
+  test "does not send after access is revoked" do
+    @notification.card.board.access_for(@user).destroy!
+    Push::Request.expects(:deliver).never
+
+    assert_nothing_raised do
+      Push::DeliveryJob.perform_now(@subscription, @notification, @notification.source)
+    end
+  end
+
+  private
+    def subscribe(user, device)
+      user.push_subscriptions.create!(
+        endpoint: "https://push.example.com/subscriptions/#{device}",
+        p256dh_key: WebPush.generate_key.public_key,
+        auth_key: SecureRandom.urlsafe_base64(16, padding: false)
+      )
+    end
+end
diff --git a/test/system/push_notifications_test.rb b/test/system/push_notifications_test.rb
new file mode 100644
index 0000000..8ddee6b
--- /dev/null
+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,69 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    @subscription = {
+      endpoint: "https://push.example.com/subscriptions/browser",
+      keys: { p256dh: WebPush.generate_key.public_key, auth: SecureRandom.urlsafe_base64(16) }
+    }
+    Push.stubs(:enabled?).returns(true)
+    Push.stubs(:public_key).returns(WebPush.generate_key.public_key)
+    sign_in_as @user
+  end
+
+  teardown do
+    if @script_id
+      page.driver.browser.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: @script_id)
+    end
+  end
+
+  test "turning push on and off only affects this device" do
+    simulate_push_service
+    other_device = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/another-browser",
+      p256dh_key: @subscription[:keys][:p256dh], auth_key: @subscription[:keys][:auth]
+    )
+
+    visit notifications_settings_path
+    click_on "Turn on for this device"
+    assert_text "Push notifications are on for this device."
+    assert_equal @subscription[:endpoint], @user.push_subscriptions.find_by!(endpoint: @subscription[:endpoint]).endpoint
+
+    refresh
+    assert_text "Push notifications are on for this device."
+    click_on "Turn off on this device"
+    assert_text "Push notifications are off for this device."
+    assert_equal [ other_device.id ], @user.push_subscriptions.ids
+  end
+
+  test "denied permission shows browser help without registering a device" do
+    simulate_push_service(permission: "denied")
+
+    visit notifications_settings_path
+    assert_text "Notifications are blocked. Check your browser and device settings."
+    assert_no_button "Turn on for this device"
+    assert_empty @user.push_subscriptions
+  end
+
+  private
+    def simulate_push_service(permission: "default")
+      # Keep the real service worker registration; replace only the browser's external push service.
+      result = page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: <<~JS)
+        const data = #{@subscription.to_json}
+        let permission = #{permission.to_json}
+        let subscription = sessionStorage.getItem("subscribed") ? { endpoint: data.endpoint, toJSON: () => data } : null
+        Object.defineProperty(Notification, "permission", { get: () => permission })
+        Notification.requestPermission = async () => permission = "granted"
+        PushManager.prototype.getSubscription = async () => subscription
+        PushManager.prototype.subscribe = async ({ userVisibleOnly, applicationServerKey }) => {
+          if (!userVisibleOnly || applicationServerKey.length !== 65) throw new Error("Invalid subscription options")
+          sessionStorage.setItem("subscribed", "true")
+          permission = "granted"
+          return subscription = { endpoint: data.endpoint, toJSON: () => data }
+        }
+        if (subscription) permission = "granted"
+      JS
+      @script_id = result.fetch("identifier")
+    end
+end
