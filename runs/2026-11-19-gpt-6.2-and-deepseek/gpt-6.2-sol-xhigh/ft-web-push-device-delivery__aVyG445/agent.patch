diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..4a55a1a
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,98 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "blocked", "unsupported", "error" ]
+  static values = { url: String, publicKey: String, endpointDigests: Array }
+
+  async connect() {
+    if (!("Notification" in window && "PushManager" in window && "serviceWorker" in navigator)) {
+      this.unsupportedTarget.hidden = false
+      this.buttonTarget.hidden = true
+      return
+    }
+
+    this.registration = await navigator.serviceWorker.ready
+    await this.refresh()
+  }
+
+  async refresh() {
+    if (!this.registration || this.updating) return
+
+    const blocked = Notification.permission === "denied"
+    this.blockedTarget.hidden = !blocked
+    this.buttonTarget.hidden = blocked
+
+    try {
+      const subscription = await this.registration.pushManager.getSubscription()
+      const digest = await this.#endpointDigest(subscription)
+      this.enabled = Notification.permission === "granted" && this.endpointDigestsValue.includes(digest)
+      this.element.classList.toggle("notifications--on", this.enabled)
+      this.buttonTarget.disabled = false
+    } catch {
+      this.errorTarget.hidden = false
+    }
+  }
+
+  async toggle() {
+    if (this.updating) return
+
+    this.updating = true
+    this.buttonTarget.disabled = true
+    this.errorTarget.hidden = true
+
+    try {
+      if (this.enabled) {
+        await this.#disable()
+      } else if (Notification.permission === "granted" || await Notification.requestPermission() === "granted") {
+        await this.#enable()
+      }
+    } catch {
+      if (Notification.permission !== "denied") this.errorTarget.hidden = false
+    } finally {
+      this.updating = false
+      await this.refresh()
+    }
+  }
+
+  async #enable() {
+    const manager = this.registration.pushManager
+    const subscription = await manager.getSubscription() || await manager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#decodedPublicKey
+    })
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.urlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+    if (response.statusCode !== 204) throw new Error("Could not register subscription")
+
+    const digest = await this.#endpointDigest(subscription)
+    this.endpointDigestsValue = [...this.endpointDigestsValue, digest]
+  }
+
+  async #disable() {
+    const subscription = await this.registration.pushManager.getSubscription()
+    const digest = await this.#endpointDigest(subscription)
+    if (!digest) return
+
+    const response = await destroy(`${this.urlValue}/${digest}`, { responseKind: "json" })
+    if (response.statusCode !== 204) throw new Error("Could not remove subscription")
+
+    // The same browser subscription may still be registered in another Fizzy account.
+    this.endpointDigestsValue = this.endpointDigestsValue.filter(endpoint => endpoint !== digest)
+  }
+
+  async #endpointDigest(subscription) {
+    if (subscription) {
+      const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(subscription.endpoint))
+      return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, "0")).join("")
+    }
+  }
+
+  get #decodedPublicKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+}
