diff --git a/app/models/push/request.rb b/app/models/push/request.rb
new file mode 100644
index 0000000..4130cd6
--- /dev/null
+++ b/app/models/push/request.rb
@@ -0,0 +1,41 @@
+class Push::Request
+  class RetryableError < StandardError; end
+
+  TIMEOUT = 5.seconds
+
+  def self.deliver(subscription, message, vapid)
+    new(subscription, message, vapid).deliver
+  end
+
+  def initialize(subscription, message, vapid)
+    @uri = URI.parse(subscription.endpoint)
+    @request = WebPush::Request.new(
+      message: message.to_json,
+      subscription: { endpoint: subscription.endpoint, keys: { p256dh: subscription.p256dh_key, auth: subscription.auth_key } },
+      vapid: vapid, ttl: 1.hour.to_i
+    )
+  end
+
+  def deliver
+    if address = SsrfProtection.resolve_public_ip(@uri.hostname)
+      status = post_to(address)
+      raise RetryableError, "Push service returned HTTP #{status}" if status == 429 || status >= 500
+      status
+    end
+  rescue Resolv::ResolvTimeout, Resolv::ResolvError, SocketError, Timeout::Error, SystemCallError, IOError => error
+    raise RetryableError, "Push service connection failed (#{error.class})", cause: nil
+  end
+
+  private
+    def post_to(address)
+      request = Net::HTTP::Post.new(@uri, @request.headers)
+      request.body = @request.body
+
+      # Connect to the checked IP while keeping the original hostname for TLS.
+      http = Net::HTTP.new(@uri.hostname, @uri.port, nil)
+      http.ipaddr = address
+      http.use_ssl = true
+      http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+      http.request(request) { |response| return response.code.to_i }
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..6c03742
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,68 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  before_validation :set_endpoint_digest
+
+  validates :endpoint, presence: true, length: { maximum: 2048 }
+  validate :validate_endpoint, :validate_keys
+
+  class << self
+    def register(attributes)
+      digest = Digest::SHA256.hexdigest(attributes[:endpoint].to_s)
+      find_or_initialize_by(endpoint_digest: digest).update!(attributes)
+    rescue ActiveRecord::RecordNotUnique
+      find_by!(endpoint_digest: digest).update!(attributes)
+    end
+  end
+
+  def deliver(notification, source)
+    if deliverable?(notification)
+      case Push::Request.deliver(self, message_for(notification, source), Push.vapid)
+      when 404, 410
+        destroy
+      end
+    end
+  end
+
+  private
+    def deliverable?(notification)
+      Push.enabled? && user_id == notification.user_id && account.active? && user.active? && notification.card.accessible_to?(user)
+    end
+
+    def message_for(notification, source)
+      content = Notification::Content.new(source)
+      path = Rails.application.routes.url_helpers.polymorphic_url(source.notifiable_target, only_path: true, script_name: account.slug)
+      { title: content.title.truncate(200), body: content.body.truncate(200), url: path }
+    end
+
+    def set_endpoint_digest
+      self.endpoint_digest = Digest::SHA256.hexdigest(endpoint) if endpoint.present?
+    end
+
+    def validate_endpoint
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.port == 443 && uri.userinfo.nil? && uri.fragment.nil?
+        errors.add(:endpoint, :invalid)
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, :invalid)
+    end
+
+    def validate_keys
+      errors.add(:p256dh_key, :invalid) unless valid_public_key?
+      errors.add(:auth_key, :invalid) unless auth_key && auth_key.length.in?(22..24) && WebPush.decode64(auth_key).bytesize == 16
+    rescue ArgumentError
+      errors.add(:auth_key, :invalid)
+    end
+
+    def valid_public_key?
+      return false unless p256dh_key && p256dh_key.length.in?(87..88)
+
+      bytes = WebPush.decode64(p256dh_key)
+      bytes.bytesize == 65 && bytes.getbyte(0) == 4 &&
+        OpenSSL::PKey::EC::Point.new(OpenSSL::PKey::EC::Group.new("prime256v1"), bytes).on_curve?
+    rescue ArgumentError, OpenSSL::OpenSSLError
+      false
+    end
+end
