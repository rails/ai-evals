@@ -0,0 +1,11 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "show the last edited date in short format" do
+    books(:handbook).update!(published: true, updated_at: Time.utc(2025, 1, 2, 13, 4, 5))
+
+    digest = ReportDigestMailer.weekly(users(:david))
+
+    assert_includes digest.body.decoded, "* Handbook, last edited 02 Jan\n"
+  end
+end
