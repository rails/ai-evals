@@ -0,0 +1,28 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium" do |form| %>
+    <% if @magic_link.sign_in? %>
+      <p>If you have a Fizzy account, we sent a six-character code to <strong><%= @magic_link.email_address %></strong>.</p>
+    <% else %>
+      <p>We sent a six-character code to <strong><%= @magic_link.email_address %></strong>.</p>
+    <% end %>
+    <p>Enter the code within 15 minutes.</p>
+
+    <%= form.text_field :code, class: "input txt-large full-width", required: true, autofocus: true,
+          autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, aria: { label: "Email code" }, placeholder: "Enter your code…" %>
+
+    <button type="submit" class="btn btn--link center">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <%= link_to "Start over", restart_path, class: "btn btn--plain txt-link center txt-small" %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
