diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..abf2b32
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,114 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+  before_action :set_magic_link
+
+  layout "public"
+  helper_method :restart_path
+
+  def show
+    no_store
+    redirect_to new_session_path unless @magic_link
+  end
+
+  def create
+    no_store
+    if @magic_link&.redeem(params[:code])
+      cookies.delete(:pending_authentication_token)
+      complete_authentication
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def set_magic_link
+      @magic_link = MagicLink.find_signed(cookies[:pending_authentication_token], purpose: MagicLink::TOKEN_PURPOSE)
+    end
+
+    def complete_authentication
+      case @magic_link.purpose
+      when "sign_in"
+        if identity = @magic_link.find_identity
+          sign_in(identity) { after_authentication_url }
+        else
+          invalid_code
+        end
+      when "sign_up"
+        if Account.accepting_signups? && (identity = @magic_link.find_identity(create: true))
+          sign_in(identity) { new_signup_completion_path }
+        else
+          redirect_to new_session_path, status: :see_other
+        end
+      when "join"
+        join_account
+      end
+    end
+
+    def join_account
+      user = @magic_link.join_code&.redeem(code: @magic_link.join_code_value) do
+        @magic_link.find_identity(create: true)
+      end
+
+      if user
+        user.verify
+        sign_in(user.identity) do
+          if user.setup?
+            landing_path(script_name: user.account.slug)
+          else
+            new_users_join_path(script_name: user.account.slug)
+          end
+        end
+      else
+        respond_to do |format|
+          format.html { redirect_to restart_path, alert: "That join code is no longer available. Ask for a new invitation.", status: :see_other }
+          format.json { head :gone }
+        end
+      end
+    end
+
+    def sign_in(identity)
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to yield, status: :see_other }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_code
+      message = "That code is invalid or has expired. Try again or request a new code."
+      retryable = @magic_link && !@magic_link.destroyed?
+      cookies.delete(:pending_authentication_token) unless retryable
+
+      respond_to do |format|
+        format.html do
+          if retryable
+            flash.now[:alert] = message
+            render :show, status: :unprocessable_entity
+          else
+            redirect_to restart_path, alert: message, status: :see_other
+          end
+        end
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def restart_path
+      if @magic_link&.sign_up?
+        new_signup_path
+      elsif (join_code = @magic_link&.join_code) && join_code.code == @magic_link.join_code_value
+        join_path(code: @magic_link.join_code_value, script_name: join_code.account.slug)
+      else
+        new_session_path
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: "Try again later.", status: :see_other }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
