+  test "JSON verification requires the pending token and cannot be replayed" do
+    untenanted do
+      identity = identities(:kevin)
+      emails = capture_emails { post session_path, params: { email_address: identity.email_address }, as: :json }
+      assert_response :created
+      token = response.parsed_body.fetch("pending_authentication_token")
+      assert_equal token, cookies[:pending_authentication_token]
+      code = code_from_subject(emails.sole)
+
+      cookies.delete("pending_authentication_token")
+      post session_magic_link_path, params: { code: code }, as: :json
+      assert_response :unauthorized
+
+      cookies[:pending_authentication_token] = token
+      assert_difference -> { identity.sessions.count }, 1 do
+        post session_magic_link_path, params: { code: code }, as: :json
+      end
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body.fetch("session_token")
+      assert cookies[:pending_authentication_token].blank?
+
+      cookies.delete("session_token")
+      cookies[:pending_authentication_token] = token
+      assert_no_difference "Session.count" do
+        post session_magic_link_path, params: { code: code }, as: :json
+      end
+      assert_response :unauthorized
+    end
+  end
