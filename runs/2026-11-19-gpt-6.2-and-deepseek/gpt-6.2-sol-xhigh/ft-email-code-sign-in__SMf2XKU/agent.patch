+  test "verification is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    post session_magic_link_path(script_name: nil), params: { code: "000000" }, as: :json
+
+    assert_response :too_many_requests
+  end
+
+  private
+    def request_email_code(path, params)
+      emails = capture_emails { post path, params: params }
+      assert_response :redirect
+      assert_redirected_to session_magic_link_path(script_name: nil)
+      assert_equal 1, emails.size
+      assert_equal [ params[:email_address] || params.dig(:signup, :email_address) ], emails.sole.to
+      code_from_subject(emails.sole)
+    end
+
+    def code_from_subject(email)
+      assert_match(/\b[A-Z0-9]{6}\b/, email.subject)
+      email.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
