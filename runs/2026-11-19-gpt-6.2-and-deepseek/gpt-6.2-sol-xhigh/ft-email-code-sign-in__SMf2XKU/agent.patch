diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..5f16b8e
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,71 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  MAX_ATTEMPTS = 5
+  ALPHABET = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ".chars.freeze
+  TOKEN_PURPOSE = :pending_authentication
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+  enum :purpose, %w[ sign_in sign_up join ].index_by(&:itself), scopes: false
+
+  def self.issue(email_address:, purpose:, join_code: nil)
+    code = Array.new(CODE_LENGTH) { ALPHABET[SecureRandom.random_number(ALPHABET.size)] }.join
+
+    link = create!(
+      email_address: Identity.normalize_value_for(:email_address, email_address),
+      purpose: purpose, join_code: join_code, join_code_value: join_code&.code,
+      code_digest: digest_code(code), expires_at: EXPIRATION.from_now
+    )
+
+    # Keep the response the same for unknown sign-in addresses without sending them a code.
+    MagicLinkMailer.sign_in_code(link.email_address, code).deliver_later if !link.sign_in? || link.find_identity
+    link
+  end
+
+  def self.cleanup
+    where(expires_at: ..Time.current).in_batches.delete_all
+  end
+
+  def self.digest_code(code)
+    key = Rails.application.key_generator.generate_key("email sign-in codes")
+    OpenSSL::HMAC.hexdigest("SHA256", key, code)
+  end
+
+  def pending_authentication_token
+    signed_id(purpose: TOKEN_PURPOSE, expires_at: expires_at)
+  end
+
+  def redeem(code)
+    with_lock do
+      if expires_at <= Time.current
+        destroy!
+        false
+      elsif code.is_a?(String) && matches?(code)
+        destroy!
+        true
+      else
+        increment!(:attempts)
+        destroy! if attempts >= MAX_ATTEMPTS
+        false
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    false
+  end
+
+  def find_identity(create: false)
+    identity = if create
+      Identity.find_or_create_by!(email_address: email_address)
+    else
+      Identity.find_by(email_address: email_address)
+    end
+
+    # A case- or accent-insensitive database match isn't proof of access to a different mailbox.
+    identity if identity&.email_address == email_address
+  end
+
+  private
+    def matches?(code)
+      ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.digest_code(code.strip.upcase))
+    end
+end
