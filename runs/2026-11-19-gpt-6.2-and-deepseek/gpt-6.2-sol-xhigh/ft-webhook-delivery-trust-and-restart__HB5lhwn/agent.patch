   end
+
+  private
+    def claim
+      # Commit the claim before sending. A retried job must not repost even if
+      # the previous worker stopped before it could record the response.
+      if self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+        reload
+      end
+    end
+
+    def skip(reason)
+      update!(state: :errored, request: nil, response: { error: reason })
+    end
+
+    def post(body)
+      outbound_request = Webhook::Delivery::Request.new(self, body)
+      update!(request: { headers: outbound_request.headers.except("X-Webhook-Signature") })
+      outcome = outbound_request.post
+
+      webhook.with_lock do
