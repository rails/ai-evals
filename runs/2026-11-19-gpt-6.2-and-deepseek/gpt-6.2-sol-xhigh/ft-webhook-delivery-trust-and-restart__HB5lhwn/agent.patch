+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @event = events(:logo_published)
+    @webhook = webhooks(:active)
+  end
+
+  test "Slack gets a text message with a link" do
+    @webhook.url = "https://hooks.slack.com/services/T12345/B12345/test" # gitleaks:allow
+
+    payload = JSON.parse(Webhook::Payload.new(@webhook, @event).body)
+    assert_includes payload["text"], @event.card.title
+    assert_includes payload["text"], "#{@event.account.slug}/cards/#{@event.card.number}"
+  end
+
+  test "Campfire and Basecamp get a content message with a link" do
+    %w[ https://campfire.example.com/rooms/1/2-room/messages https://3.basecamp.example.com/1/integrations/test/buckets/2/chats/3/lines ].each do |url|
+      @webhook.url = url
+
+      payload = JSON.parse(Webhook::Payload.new(@webhook, @event).body)
+      assert_includes CGI.unescapeHTML(payload["content"]), @event.card.title
+      assert_includes payload["content"], "#{@event.account.slug}/cards/#{@event.card.number}"
+    end
+  end
+end
