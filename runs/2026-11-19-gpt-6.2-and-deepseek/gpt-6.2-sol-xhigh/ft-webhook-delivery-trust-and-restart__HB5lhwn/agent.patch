@@ -0,0 +1,196 @@
+require "test_helper"
+
+class Webhook::DispatchTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @card = cards(:logo)
+    stub_dns_resolution "93.184.216.34"
+  end
+
+  test "a committed board event is signed, posted and logged once" do
+    assert_difference -> { @webhook.deliveries.count }, 1 do
+      @card.close(user: users(:david))
+    end
+
+    event = @card.events.find_by!(action: "card_closed")
+    delivery = @webhook.deliveries.find_by!(event: event)
+    assert_predicate delivery, :pending?
+    duplicate = Webhook::Delivery.find(delivery.id)
+
+    stub_request(:post, @webhook.url)
+      .with(ipaddr: "93.184.216.34", headers: { "Content-Type" => "application/json", "X-Webhook-Delivery-ID" => delivery.id })
+      .to_return do |request|
+        assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+        payload = JSON.parse(request.body)
+        assert_equal event.id, payload["id"]
+        assert_equal "card_closed", payload["action"]
+        assert_equal @webhook.board_id, payload.dig("board", "id")
+
+        assert_predicate delivery.reload, :in_progress?
+        Webhook::DeliveryJob.perform_now(duplicate)
+        { status: 204 }
+      end
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert_requested :post, @webhook.url, times: 1
+    assert_predicate delivery.reload, :succeeded?
+    assert_equal 204, delivery.response_summary[:code]
+    assert_equal delivery.id, delivery.sanitized_request.dig(:headers, "X-Webhook-Delivery-ID")
+    assert_not delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+  end
+
+  test "only active webhooks subscribed on the event's board get deliveries" do
+    second = @card.board.webhooks.create!(name: "Second", url: "https://second.example.com", subscribed_actions: [ "card_closed" ])
+    @card.board.webhooks.create!(name: "Paused", url: "https://paused.example.com", subscribed_actions: [ "card_closed" ], active: false)
+    @card.board.webhooks.create!(name: "Other action", url: "https://other.example.com", subscribed_actions: [ "comment_created" ])
+    boards(:private).webhooks.create!(name: "Other board", url: "https://private.example.com", subscribed_actions: [ "card_closed" ])
+    boards(:miltons_wish_list).webhooks.create!(name: "Other account", url: "https://initech.example.com", subscribed_actions: [ "card_closed" ])
+
+    assert_enqueued_jobs 2, only: Webhook::DeliveryJob do
+      @card.close(user: users(:david))
+    end
+    event = @card.events.find_by!(action: "card_closed")
+    assert_equal [ @webhook.id, second.id ].sort, event.webhook_deliveries.pluck(:webhook_id).sort
+  end
+
+  test "a rolled back event is neither logged nor enqueued" do
+    assert_no_difference -> { @webhook.deliveries.count } do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        Card.transaction(requires_new: true) do
+          @card.close(user: users(:david))
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "payload uses the card title and board at the time of the event" do
+    Current.user = users(:david)
+    @card.close
+    title = @card.title
+    @card.move_to(boards(:private))
+    @card.update!(title: "A private update")
+
+    post = stub_request(:post, @webhook.url).to_return do |request|
+      payload = JSON.parse(request.body)
+      assert_equal @webhook.board_id, payload.dig("board", "id")
+      assert_equal title, payload.dig("eventable", "title")
+      { status: 200 }
+    end
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+    assert_requested post, times: 1
+  end
+
+  test "a comment includes the comment link and the card it is on" do
+    @webhook.update!(subscribed_actions: [ "comment_created" ])
+    comment = @card.comments.create!(body: "Looks good!", creator: users(:david))
+
+    post = stub_request(:post, @webhook.url).to_return do |request|
+      payload = JSON.parse(request.body)
+      assert_equal "comment_created", payload["action"]
+      assert_equal comment.id, payload.dig("eventable", "id")
+      assert_equal "Looks good!", payload.dig("eventable", "body", "plain_text")
+      assert_includes payload.dig("eventable", "url"), "#{@card.account.slug}/cards/#{@card.number}/comments/#{comment.id}"
+      assert_equal @card.id, payload.dig("eventable", "card", "id")
+      { status: 201 }
+    end
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+    assert_requested post, times: 1
+  end
+
+  test "a webhook disabled after enqueue does not receive the pending event" do
+    delivery = queue_delivery
+    @webhook.deactivate
+    post = stub_request(:post, @webhook.url)
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_not_requested post
+    assert_predicate delivery.reload, :errored?
+    assert_equal "webhook_inactive", delivery.response_summary[:error]
+  end
+
+  test "a receiver must have ten consecutive failures spanning an hour before it is disabled" do
+    post = stub_request(:post, @webhook.url).to_return(status: 500)
+    failures = travel_to(61.minutes.ago) { deliver_events(8) }
+
+    failures.concat deliver_events(1)
+    assert_predicate @webhook.reload, :active?
+    assert_equal 9, @webhook.delinquency_tracker.consecutive_failures_count
+
+    failures.concat deliver_events(1)
+    assert_not @webhook.reload.active?
+    assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+    failures.each do |delivery|
+      assert_predicate delivery.reload, :failed?
+      assert_equal 500, delivery.response_summary[:code]
+    end
+    assert_no_difference -> { @webhook.deliveries.count } do
+      @card.track_event(:closed, creator: users(:david))
+    end
+    assert_requested post, times: 10
+
+    @webhook.activate
+    assert_predicate @webhook.reload, :active?
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "ten failures in less than an hour do not disable a receiver and success resets the streak" do
+    freeze_time
+    stub_request(:post, @webhook.url).to_timeout.times(10).then.to_return(status: 200).then.to_return(status: 500)
+
+    deliveries = deliver_events(10)
+    assert_predicate @webhook.reload, :active?
+    assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_equal Time.current, @webhook.delinquency_tracker.first_failure_at
+    assert_equal "timeout", deliveries.first.reload.response_summary[:error]
+
+    travel 2.hours
+    assert_predicate deliver_events(1).first.reload, :succeeded?
+    assert_equal 0, @webhook.reload.delinquency_tracker.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+
+    deliver_events(1)
+    assert_predicate @webhook.reload, :active?
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_equal Time.current, @webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "a receiver on a private IP is logged as unreachable without a POST" do
+    stub_dns_resolution "192.168.1.2"
+    post = stub_request(:post, @webhook.url)
+
+    delivery = deliver_events(1).first.reload
+
+    assert_not_requested post
+    assert_predicate delivery, :errored?
+    assert_equal "destination_unreachable", delivery.response_summary[:error]
+  end
+
+  test "a redirect is logged as a failure without following it" do
+    post = stub_request(:post, @webhook.url).to_return(status: 307, headers: { "Location" => "https://redirect.example.com/" })
+    redirected = stub_request(:any, "https://redirect.example.com/")
+
+    delivery = deliver_events(1).first.reload
+
+    assert_requested post, times: 1
+    assert_not_requested redirected
+    assert_predicate delivery, :failed?
+    assert_equal 307, delivery.response_summary[:code]
+  end
+
+  private
+    def queue_delivery
+      event = @card.track_event(:closed, creator: users(:david))
+      @webhook.deliveries.find_by!(event: event)
+    end
+
+    def deliver_events(count)
+      deliveries = Array.new(count) { queue_delivery }
+      perform_enqueued_jobs only: Webhook::DeliveryJob
+      deliveries
+    end
+end
