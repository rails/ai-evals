diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..ec075b7
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,22 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_LIMIT = 10
+  FAILURE_DURATION = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure
+    update! consecutive_failures_count: consecutive_failures_count.to_i + 1,
+      first_failure_at: first_failure_at || Time.current
+  end
+
+  def reset
+    if first_failure_at || consecutive_failures_count.to_i.positive?
+      update! consecutive_failures_count: 0, first_failure_at: nil
+    end
+  end
+
+  def delinquent?
+    consecutive_failures_count.to_i >= FAILURE_LIMIT && first_failure_at.present? && first_failure_at <= FAILURE_DURATION.ago
+  end
+end
