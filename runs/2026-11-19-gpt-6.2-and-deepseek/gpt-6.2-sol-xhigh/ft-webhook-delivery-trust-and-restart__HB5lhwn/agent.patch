diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..98e6081
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,60 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  TIMEOUT = 10
+
+  attr_reader :headers
+
+  def initialize(delivery, body)
+    @webhook = delivery.webhook
+    @body = body
+    @headers = {
+      "Content-Type" => "application/json",
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "X-Webhook-Delivery-ID" => delivery.id,
+      "X-Webhook-Timestamp" => Time.current.utc.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, body)
+    }
+  end
+
+  def post
+    Timeout.timeout(TIMEOUT) do
+      uri = URI.parse(@webhook.url)
+
+      if Webhook::PERMITTED_SCHEMES.include?(uri.scheme) && uri.hostname.present? && (ip = public_ip(uri.hostname))
+        { code: post_to(uri, ip) }
+      else
+        { error: "destination_unreachable" }
+      end
+    end
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue URI::InvalidURIError, Resolv::ResolvError, SocketError, SystemCallError, IOError,
+      OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::ProtocolError
+    { error: "destination_unreachable" }
+  end
+
+  private
+    def public_ip(hostname)
+      if Resolv::AddressRegex.match?(hostname)
+        hostname unless SsrfProtection.blocked_address?(hostname)
+      else
+        SsrfProtection.resolve_public_ip(hostname)
+      end
+    end
+
+    def post_to(uri, ip)
+      # Pin the vetted address without changing the hostname used for TLS or Host.
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.max_retries = 0
+      http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+
+      request = Net::HTTP::Post.new(uri, headers)
+      request.body = @body
+
+      # Only the status is logged. Close the connection without reading the body.
+      http.request(request) { |response| return response.code.to_i }
+    end
+end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..e7fd49c
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,47 @@
+class Webhook::Payload
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def body
+    if @webhook.for_basecamp?
+      { content: render(:html).strip }.to_json
+    elsif @webhook.for_campfire?
+      { content: message }.to_json
+    elsif @webhook.for_slack?
+      { text: message, mrkdwn: false }.to_json
+    else
+      render(:json)
+    end
+  end
+
+  private
+    def render(format)
+      ApplicationController.renderer.new(rendering_options).render(
+        template: "webhooks/event", formats: [ format ], assigns: { event: @event }, layout: false
+      )
+    end
+
+    def rendering_options
+      options = { script_name: @event.account.slug }
+
+      if url_options[:host].present?
+        options[:http_host] = [ url_options[:host], url_options[:port] ].compact.join(":")
+        options[:https] = url_options[:protocol].to_s.start_with?("https")
+      end
+
+      options
+    end
+
+    def message
+      url = Rails.application.routes.url_helpers.polymorphic_url(@event.eventable,
+        **url_options, script_name: @event.account.slug, only_path: url_options[:host].blank?)
+      "#{CGI.unescapeHTML(@event.description_for(nil).to_plain_text)} #{url}"
+    end
+
+    def url_options
+      @url_options ||= Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+    end
+end
