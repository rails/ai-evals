diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..684ef44
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,35 @@
+class Bots::MessagesController < ActionController::Base
+  include BlockBannedRequests, SetCurrentRequest, VersionHeaders
+
+  # The bot code authenticates the request; browser sessions are not used.
+  skip_forgery_protection
+
+  before_action :authenticate_bot, :set_room
+
+  def create
+    if body = request.raw_post.to_s.dup.force_encoding(Encoding::UTF_8).scrub.presence
+      message = @room.messages.create!(creator: @bot, body: rich_text_body(body))
+      message.broadcast_create
+      head :created, location: message_path(message)
+    else
+      head :unprocessable_content
+    end
+  end
+
+  private
+    def authenticate_bot
+      @bot = Bot.find_by_code(request.delete_header("campfire.bot_code"))
+      head :unauthorized unless @bot
+    end
+
+    def set_room
+      if params[:room_id].match?(/\A[0-9]+\z/)
+        @room = @bot.rooms.find_by(id: params[:room_id])
+      end
+      head :not_found unless @room
+    end
+
+    def rich_text_body(text)
+      "<div>#{ERB::Util.html_escape(text).gsub(/\r\n?|\n/, "<br>")}</div>"
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..3d40ecf
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,51 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    no_store
+    @bots = manageable_bots.with_attached_avatar.ordered
+  end
+
+  def new
+    @bot = Bot.new
+  end
+
+  def create
+    @bot = Current.user.created_bots.build(bot_params)
+
+    if @bot.save
+      redirect_to bots_path
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_path, status: :see_other
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_path, status: :see_other
+  end
+
+  private
+    def manageable_bots
+      (Current.user.administrator? ? Bot.all : Current.user.created_bots).active
+    end
+
+    def set_bot
+      @bot = manageable_bots.find(params[:id])
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
