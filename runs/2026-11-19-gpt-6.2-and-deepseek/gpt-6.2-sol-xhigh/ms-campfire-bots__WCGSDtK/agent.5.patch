diff --git a/app/models/bot/moderation.rb b/app/models/bot/moderation.rb
new file mode 100644
index 0000000..3916217
--- /dev/null
+++ b/app/models/bot/moderation.rb
@@ -0,0 +1,110 @@
+module Bot::Moderation
+  POST_LIMIT = 10
+  POST_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  PostResult = Data.define(:status, :message, :retry_after) do
+    def initialize(status:, message: nil, retry_after: nil)
+      super(status: status, message: message, retry_after: retry_after)
+    end
+  end
+
+  def post_message(room, body)
+    rich_text = message_html(body)
+    with_lock { attempt_post(room, rich_text) }.tap do |result|
+      result.message&.broadcast_create
+    end
+  end
+
+  def complete_webhook_delivery(room, delivery, webhook_url:, activation_version:)
+    if reply = delivery.reply
+      rich_text = message_html(reply.body, content_type: reply.content_type)
+    end
+
+    result = with_lock do
+      # Ignore in-flight deliveries from an old URL or before an administrator reactivated the bot.
+      if active? && self.webhook_url == webhook_url && self.activation_version == activation_version
+        record_webhook_delivery(delivery.success?)
+        attempt_post(room, rich_text) if rich_text.present?
+      end
+    end
+    result&.message&.broadcast_create
+  end
+
+  def reactivate
+    with_lock do
+      if suspended?
+        update! status: :active, suspension_reason: nil, recent_post_times: [], cooldown_until: nil,
+          cooldown_attempts: 0, webhook_failures: 0, activation_version: activation_version + 1
+      end
+    end
+  end
+
+  private
+    # Called under the bot lock to serialize the shared limit and the message insert.
+    def attempt_post(room, rich_text)
+      now = Time.current
+
+      if suspended?
+        PostResult.new(status: :forbidden)
+      elsif !active?
+        PostResult.new(status: :unauthorized)
+      elsif !memberships.exists?(room_id: room.id)
+        PostResult.new(status: :not_found)
+      elsif cooldown_until && now < cooldown_until
+        reject_during_cooldown(now)
+      elsif rich_text.blank?
+        PostResult.new(status: :unprocessable_content)
+      else
+        post_or_start_cooldown(room, rich_text, now)
+      end
+    end
+
+    def post_or_start_cooldown(room, rich_text, now)
+      cutoff = (now - POST_WINDOW).to_f
+      recent = recent_post_times.select { |time| time > cutoff }
+      if recent.size >= POST_LIMIT
+        update_columns cooldown_until: now + COOLDOWN, cooldown_attempts: 0
+        PostResult.new(status: :too_many_requests, retry_after: COOLDOWN.to_i)
+      else
+        message = room.messages.create!(creator: self, body: rich_text)
+        update_columns recent_post_times: recent << now.to_f, cooldown_until: nil, cooldown_attempts: 0
+        PostResult.new(status: :created, message: message)
+      end
+    end
+
+    def reject_during_cooldown(now)
+      attempts = cooldown_attempts + 1
+      if attempts >= COOLDOWN_ATTEMPT_LIMIT
+        suspend("Message rate limit exceeded", cooldown_attempts: attempts)
+      else
+        update_columns cooldown_attempts: attempts
+      end
+      PostResult.new(status: :too_many_requests, retry_after: (cooldown_until - now).ceil)
+    end
+
+    def record_webhook_delivery(successful)
+      failures = successful ? 0 : webhook_failures + 1
+      if failures >= WEBHOOK_FAILURE_LIMIT
+        suspend("Too many consecutive webhook failures", webhook_failures: failures)
+      elsif failures != webhook_failures
+        update_columns webhook_failures: failures
+      end
+    end
+
+    def suspend(reason, **attributes)
+      update! status: :suspended, suspension_reason: reason, **attributes
+    end
+
+    def message_html(body, content_type: "text/plain")
+      if text = body.dup.force_encoding(Encoding::UTF_8).scrub.presence
+        if content_type == "text/html"
+          ActionController::Base.helpers.sanitize(text)
+        else
+          "<div>#{ERB::Util.html_escape(text).gsub(/\r\n?|\n/, "<br>")}</div>"
+        end
+      end
+    end
+end
