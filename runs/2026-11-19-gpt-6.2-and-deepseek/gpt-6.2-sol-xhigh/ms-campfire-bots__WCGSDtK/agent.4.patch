diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
index 8c80754..4c6f248 100644
--- a/test/controllers/bots_controller_test.rb
+++ b/test/controllers/bots_controller_test.rb
@@ -35,6 +35,85 @@ class BotsControllerTest < ActionDispatch::IntegrationTest
     assert_equal "Release Bot", bot.reload.name
   end
 
+  test "members are limited to five bots each by default" do
+    Bot.create!(name: "Another Member's Bot", creator: users(:jz))
+    sign_in :kevin
+
+    assert_difference -> { users(:kevin).created_bots.count }, 5 do
+      5.times do |number|
+        post bots_path, params: { bot: { name: "Bot #{number}" } }
+        assert_redirected_to bots_path
+      end
+    end
+
+    get bots_path
+    assert_select "a", text: "Add a chat bot", count: 0
+    assert_select "p", text: /reached the limit/
+
+    get new_bot_path
+    assert_redirected_to bots_path
+
+    assert_no_difference -> { Bot.count } do
+      post bots_path, params: { bot: { name: "One Too Many" } }
+      assert_response :unprocessable_content
+      assert_select "[role=alert]", text: /reached the limit/
+    end
+  end
+
+  test "lowering the limit keeps existing bots and deletion only frees a spot below the limit" do
+    member = users(:kevin)
+    first = member.created_bots.create!(name: "First Bot")
+    second = member.created_bots.create!(name: "Second Bot")
+    accounts(:signal).update!(bots_per_member: 1)
+    sign_in :kevin
+
+    get bots_path
+    assert_select "a", text: "Edit First Bot"
+    assert_select "a", text: "Edit Second Bot"
+    assert_select "a", text: "Add a chat bot", count: 0
+
+    patch bot_path(second), params: { bot: { name: "Renamed Bot" } }
+    assert_redirected_to bots_path
+    assert_equal "Renamed Bot", second.reload.name
+
+    delete bot_path(first)
+    follow_redirect!
+    assert_select "p", text: /reached the limit/
+    assert_select "a", text: "Add a chat bot", count: 0
+
+    delete bot_path(second)
+    follow_redirect!
+    assert_select "a", text: "Add a chat bot"
+    assert_select "p", text: /reached the limit/, count: 0
+
+    assert_difference -> { member.created_bots.active.count }, 1 do
+      post bots_path, params: { bot: { name: "Replacement Bot" } }
+      assert_redirected_to bots_path
+    end
+  end
+
+  test "a zero limit blocks members but not administrators" do
+    accounts(:signal).update!(bots_per_member: 0)
+    sign_in :kevin
+
+    get bots_path
+    assert_select "p", text: /reached the limit/
+    assert_select "a", text: "Add a chat bot", count: 0
+
+    sign_in :david
+
+    assert_difference -> { users(:david).created_bots.count }, 2 do
+      2.times do |number|
+        get bots_path
+        assert_select "a", text: "Add a chat bot"
+        assert_select "p", text: /reached the limit/, count: 0
+
+        post bots_path, params: { bot: { name: "Admin Bot #{number}" } }
+        assert_redirected_to bots_path
+      end
+    end
+  end
+
