diff --git a/app/jobs/bot/webhook_job.rb b/app/jobs/bot/webhook_job.rb
new file mode 100644
index 0000000..5acc876
--- /dev/null
+++ b/app/jobs/bot/webhook_job.rb
@@ -0,0 +1,23 @@
+class Bot::WebhookJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  private
+    def deliver(bot, room)
+      return unless bot.active? && (url = bot.webhook_uri)
+      return unless payload = yield
+
+      reply = Bot::Webhook.new(url).deliver(payload)
+      if reply && still_accepts_replies?(bot, room)
+        bot.post_message(room, reply.body, content_type: reply.content_type)
+      end
+    end
+
+    def still_accepts_replies?(bot, room)
+      Bot.active.where(id: bot.id).pick(:webhook_url) == bot.webhook_url && bot.memberships.exists?(room_id: room.id)
+    end
+
+    def room_payload(bot, room)
+      routes = Rails.application.routes.url_helpers
+      { id: room.id, name: room.name, reply_to: routes.room_bot_messages_path(room, bot.bot_code) }
+    end
+end
