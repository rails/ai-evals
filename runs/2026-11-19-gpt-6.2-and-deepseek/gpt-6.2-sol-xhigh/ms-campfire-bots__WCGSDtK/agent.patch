diff --git a/test/models/bot/webhook_test.rb b/test/models/bot/webhook_test.rb
new file mode 100644
index 0000000..0069cbc
--- /dev/null
+++ b/test/models/bot/webhook_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Bot::WebhookTest < ActiveSupport::TestCase
+  setup do
+    @url = URI.parse("https://hooks.example.com/campfire")
+    @webhook = Bot::Webhook.new(@url)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with(@url.hostname).returns("93.184.216.34")
+  end
+
+  test "does not follow redirects or accept non-200 replies" do
+    stub_request(:post, @url).to_return(status: 302, headers: { "Location" => "https://example.com/", "Content-Type" => "text/plain" }, body: "Ignored")
+    delivery = @webhook.deliver(event: "mention")
+    assert_not delivery.success?
+    assert_nil delivery.reply
+    assert_not_requested :post, "https://example.com/"
+
+    stub_request(:post, @url).to_return(status: 201, headers: { "Content-Type" => "text/plain" }, body: "Ignored")
+    delivery = @webhook.deliver(event: "mention")
+    assert delivery.success?
+    assert_nil delivery.reply
+  end
+
+  test "does not accept other media types or oversized replies" do
+    stub_request(:post, @url).to_return(headers: { "Content-Type" => "application/json" }, body: '{"ignored":true}')
+    delivery = @webhook.deliver(event: "mention")
+    assert delivery.success?
+    assert_nil delivery.reply
+
+    stub_request(:post, @url).to_return(headers: { "Content-Type" => "text/plain" }, body: "a" * (Bot::Webhook::MAX_REPLY_SIZE + 1))
+    delivery = @webhook.deliver(event: "mention")
+    assert delivery.success?
+    assert_nil delivery.reply
+  end
+
+  test "a network failure does not produce a reply" do
+    stub_request(:post, @url).to_timeout
+    delivery = @webhook.deliver(event: "mention")
+    assert_not delivery.success?
+    assert_nil delivery.reply
+  end
+
+  test "private network addresses are rejected before sending the request" do
+    url = URI.parse("http://127.0.0.1/hooks")
+    RestrictedHTTP::PrivateNetworkGuard.unstub(:resolve)
+
+    assert_not Bot::Webhook.new(url).deliver(event: "mention").success?
+    assert_not_requested :post, url
+  end
+end
diff --git a/test/system/managing_bots_test.rb b/test/system/managing_bots_test.rb
new file mode 100644
index 0000000..b94d259
--- /dev/null
+++ b/test/system/managing_bots_test.rb
@@ -0,0 +1,59 @@
+require "application_system_test_case"
+
+class ManagingBotsTest < ApplicationSystemTestCase
+  test "a member can manage a chat bot from account settings" do
+    sign_in users(:kevin).email_address
+
+    visit edit_account_path
+    click_on "Set up chat bots"
+    click_on "Add a chat bot"
+    assert_unchecked_field "Add to all open rooms"
+    check "Add to all open rooms"
+    fill_in "Name the bot", with: "Deploy Bot"
+    fill_in "Webhook URL", with: "https://hooks.example.com/campfire"
+    click_on "Save changes"
+
+    code = within find("li", text: "Deploy Bot") do
+      find_field("Bot code", readonly: true).value
+    end
+    assert_predicate code, :present?
+
+    click_on "Edit Deploy Bot"
+    assert_checked_field "Add to all open rooms"
+    uncheck "Add to all open rooms"
+    assert_field "Webhook URL", with: "https://hooks.example.com/campfire"
+    fill_in "Name the bot", with: "Release Bot"
+    fill_in "Webhook URL", with: ""
+    click_on "Save changes"
+    assert_field "Bot code", readonly: true, with: code
+
+    click_on "Edit Release Bot"
+    assert_unchecked_field "Add to all open rooms"
+    assert_field "Webhook URL", with: ""
+    dismiss_confirm { click_on "Delete this chat bot" }
+    assert_button "Delete this chat bot"
+
+    accept_confirm { click_on "Delete this chat bot" }
+    assert_current_path bots_path
+    assert_no_link "Edit Release Bot"
+  end
+
+  test "an administrator confirms reactivation from the bots page" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:kevin), status: :suspended,
+      suspension_reason: "Too many consecutive webhook failures")
+    sign_in users(:david).email_address
+
+    visit bots_path
+    within find("li", text: "Deploy Bot") do
+      assert_text "Suspended"
+      assert_text "Too many consecutive webhook failures"
+      dismiss_confirm { click_on "Reactivate" }
+      assert_button "Reactivate"
+      accept_confirm { click_on "Reactivate" }
+    end
+
+    assert_no_text "Suspended"
+    assert_no_button "Reactivate"
+    assert_predicate bot.reload, :active?
+  end
+end
