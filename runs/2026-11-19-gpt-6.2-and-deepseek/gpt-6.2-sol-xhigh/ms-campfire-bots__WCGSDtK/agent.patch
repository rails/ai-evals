index 0000000..2efc6c1
--- /dev/null
+++ b/app/jobs/bot/webhook_job.rb
@@ -0,0 +1,18 @@
+class Bot::WebhookJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  private
+    def deliver(bot, room)
+      return unless bot = Bot.active.find_by(id: bot.id)
+      return unless url = bot.webhook_uri
+      return unless payload = yield
+
+      delivery = Bot::Webhook.new(url).deliver(payload)
+      bot.complete_webhook_delivery(room, delivery, webhook_url: bot.webhook_url, activation_version: bot.activation_version)
+    end
+
+    def room_payload(bot, room)
+      routes = Rails.application.routes.url_helpers
+      { id: room.id, name: room.name, reply_to: routes.room_bot_messages_path(room, bot.bot_code) }
+    end
+end
