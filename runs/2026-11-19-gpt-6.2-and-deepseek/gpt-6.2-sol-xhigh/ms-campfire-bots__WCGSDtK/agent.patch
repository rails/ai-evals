+    assert_equal({ "id" => @author.id, "name" => @author.name }, @payload["author"])
+    assert_equal({ "id" => @room.id, "name" => @room.name, "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages" }, @payload["room"])
+    assert_equal original.id, @payload.dig("message", "id")
+    assert_equal "/rooms/#{@room.id}/@#{original.id}", @payload.dig("message", "link")
+    assert_equal "Restart for @David (literal @Release Bot)", @payload.dig("message", "body", "text")
+    html = Nokogiri::HTML.fragment(@payload.dig("message", "body", "html"))
+    assert_equal "Restart", html.at_css("strong").text
+    assert_equal [ "Release Bot", "David", "Release Bot" ], html.css(".mention").map { |node| node.text.strip }
+
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal "Restarted!\n<literal> & done", reply.plain_text_body
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author", text: @bot.name
+      assert_select ".message__body", text: /Restarted!/
+    end
+    get @payload.dig("message", "link")
+    assert_response :success
+    assert_select "##{ActionView::RecordIdentifier.dom_id(original)}"
+  end
+
+  test "each bot gets the same message with only its own mention omitted" do
+    other_bot = Bot.create!(name: "Build Bot", creator: @author, webhook_url: "#{@url}/build")
+    @room.memberships.grant_to other_bot
+    release_callback = stub_callback(status: 204)
+    build_callback = stub_request(:post, other_bot.webhook_url).with do |request|
+      JSON.parse(request.body).dig("message", "body", "text") == "@Release Bot restart"
+    end.to_return(status: 204)
+
+    assert_enqueued_jobs 2, only: Bot::MentionWebhookJob do
+      post_message "#{mention(@bot)} restart #{mention(other_bot)}"
+    end
+    deliver_callbacks
+
+    assert_requested release_callback, times: 1
+    assert_requested build_callback, times: 1
+    assert_equal "restart @Build Bot", @payload.dig("message", "body", "text")
+  end
+
+  test "a bot can acknowledge without replying and post later using its reply path" do
+    callback = stub_callback(status: 204)
+    post_message mention(@bot)
+
+    assert_no_difference -> { @room.messages.count } do
+      deliver_callbacks
+    end
+    assert_requested callback
+    assert_equal "", @payload.dig("message", "body", "text")
+
+    open_session do |bot_session|
+      bot_session.post @payload.dig("room", "reply_to"), params: +"Later", headers: { "Content-Type" => "text/plain" }
+      assert_equal 201, bot_session.response.status
+    end
+    assert_equal @bot, @room.messages.last.creator
+    assert_equal "Later", @room.messages.last.plain_text_body
+  end
+
+  test "HTML replies keep formatting but not unsafe markup" do
+    stub_callback(status: 200, type: "text/html", body: '<p onclick="alert(1)">All <strong>done</strong></p>')
+    post_message mention(@bot)
+
+    assert_difference -> { @room.messages.count } do
+      deliver_callbacks
+    end
+    assert_includes @room.messages.last.body.to_s, "<strong>done</strong>"
+    assert_not_includes @room.messages.last.body.to_s, "onclick"
+  end
+
+  test "a removed webhook or a revoked membership prevents queued delivery" do
+    callback = stub_callback(status: 204)
+    post_message mention(@bot)
+    @bot.update!(webhook_url: "")
+    deliver_callbacks
+    assert_not_requested callback
+
+    @bot.update!(webhook_url: @url)
+    post_message mention(@bot)
+    @room.memberships.revoke_from @bot
+    deliver_callbacks
+    assert_not_requested callback
+  end
+
+  test "messages without an eligible bot mention do not enqueue callbacks" do
+    assert_no_enqueued_jobs only: Bot::MentionWebhookJob do
+      post_message "Hi @Release Bot #{mention(@author)}"
+
+      @room.memberships.revoke_from @bot
+      post_message mention(@bot)
+
+      @room.memberships.grant_to @bot
+      @room.messages.create!(creator: @bot, body: mention(@bot))
+
+      @bot.update!(webhook_url: nil)
+      post_message mention(@bot)
+
+      @bot.update!(status: :deactivated, webhook_url: @url)
+      post_message mention(@bot)
+    end
+  end
+
+  test "API posts and webhook replies share the same limit" do
+    freeze_time
+    callback = stub_callback(status: 200, body: "Reply")
+    post_message mention(@bot)
+    deliver_callbacks
+    assert_equal 1, @bot.messages.count
+
+    9.times do
+      post room_bot_messages_path(@room, @bot.bot_code), params: +"API post"
+      assert_response :created
+    end
+
+    5.times do
+      post_message mention(@bot)
+      assert_no_difference -> { @bot.messages.count } do
+        deliver_callbacks
+      end
+    end
+    assert_requested callback, times: 6
+
+    post room_bot_messages_path(@room, @bot.bot_code), params: +"During cooldown"
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+    assert_predicate @bot.reload, :suspended?
+    assert_match(/rate limit/i, @bot.suspension_reason)
+  end
+
+  test "ten consecutive failed deliveries suspend the bot and skip remaining queued webhooks" do
+    attachment = mention(@bot)
+    failure = stub_callback(status: 302)
+    9.times { post_message attachment }
+    deliver_callbacks
+    assert_requested failure, times: 9
+    assert_predicate @bot.reload, :active?
+
+    WebMock.reset!
+    stub_callback(status: 204)
+    post_message attachment
+    deliver_callbacks
+
+    WebMock.reset!
+    failure = stub_request(:post, @url).to_timeout
+    9.times { post_message attachment }
+    deliver_callbacks
+    assert_requested failure, times: 9
+    assert_predicate @bot.reload, :active?
+
+    WebMock.reset!
+    failure = stub_request(:post, @url).to_raise(Errno::ECONNREFUSED)
+    2.times { post_message attachment }
+    deliver_callbacks
+    assert_requested failure, times: 1
+    assert_predicate @bot.reload, :suspended?
+    assert_match(/webhook/i, @bot.suspension_reason)
+
+    assert_no_enqueued_jobs only: Bot::MentionWebhookJob do
+      post_message attachment
+    end
+  end
+
+  test "an in-flight reply from before reactivation is discarded" do
+    callback = stub_request(:post, @url).to_return do
+      @bot.suspended!
+      @bot.reactivate
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "Old reply" }
+    end
+    post_message mention(@bot)
+
+    assert_no_difference -> { @bot.messages.count } do
+      deliver_callbacks
+    end
+    assert_requested callback
+    assert_predicate @bot.reload, :active?
+  end
+
+  private
+    def post_message(body)
+      post room_messages_path(@room, format: :turbo_stream), params: { message: { body: body } }
+      assert_response :success
+    end
+
+    def mention(user)
+      ActionText::Attachment.from_attachable(user).to_html
+    end
+
+    def stub_callback(status:, type: "text/plain", body: "")
+      stub_request(:post, @url).with(headers: { "Content-Type" => "application/json" }).to_return do |request|
+        @payload = JSON.parse(request.body)
+        { status: status, headers: { "Content-Type" => type }, body: body }
+      end
+    end
+
+    def deliver_callbacks
+      perform_enqueued_jobs(only: Bot::MentionWebhookJob)
+    end
+end
diff --git a/test/controllers/bots/messages_controller_test.rb b/test/controllers/bots/messages_controller_test.rb
new file mode 100644
index 0000000..c35c735
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,184 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:kevin))
+    @room = rooms(:hq)
+    @room.memberships.grant_to @bot
+    @original_forgery_protection = Bots::MessagesController.allow_forgery_protection
+    Bots::MessagesController.allow_forgery_protection = true
+  end
+
+  teardown do
+    Bots::MessagesController.allow_forgery_protection = @original_forgery_protection
+  end
+
+  test "a raw message is delivered and attributed to the bot" do
+    body = "Deploy of v1.2.3 finished ✅\n<literal> & 100%"
+
+    assert_enqueued_with(job: Room::PushMessageJob) do
+      assert_difference -> { @room.messages.count } do
+        post_bot_message body
+      end
+    end
+
+    message = @room.messages.last
+    assert_response :created
+    assert_equal message_path(message), response.headers["Location"]
+    assert_equal body, message.plain_text_body
+    assert_equal @bot, message.creator
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author", text: @bot.name
+      assert_select ".message__body", text: /Deploy of v1.2.3 finished ✅/
+    end
+
+    sign_in :david
+    get message_path(message)
+    assert_response :success
+    assert_select ".message__author", text: @bot.name
+  end
+
+  test "a bot needs membership to post to an open room" do
+    @room = rooms(:pets)
+    post_bot_message "Hello"
+    assert_response :not_found
+  end
+
+  test "a bot needs membership to post to a closed room" do
+    @room = rooms(:designers)
+
+    assert_no_difference -> { Message.count } do
+      post_bot_message "Hello"
+      assert_response :not_found
+    end
+
+    @room.memberships.grant_to @bot
+    post_bot_message "Hello"
+    assert_response :created
+  end
+
+  test "invalid codes and room IDs fail without posting" do
+    assert_no_difference -> { Message.count } do
+      post_bot_message "Hello", code: "invalid"
+      assert_response :unauthorized
+
+      post_bot_message "Hello", code: @bot.avatar_token
+      assert_response :unauthorized
+
+      post_bot_message "Hello", room_id: "#{@room.id}abc"
+      assert_response :not_found
+
+      post_bot_message "Hello", room_id: 0
+      assert_response :not_found
+    end
+  end
+
+  test "posting accepts raw data regardless of content type or form syntax" do
+    post_bot_message "not valid JSON", content_type: "application/json"
+    assert_response :created
+    assert_equal "not valid JSON", @room.messages.last.plain_text_body
+
+    post_bot_message "_method=delete&q=one+two", content_type: "application/x-www-form-urlencoded"
+    assert_response :created
+    assert_equal "_method=delete&q=one+two", @room.messages.last.plain_text_body
+  end
+
+  test "empty messages are rejected" do
+    assert_no_difference -> { Message.count } do
+      post_bot_message
+      assert_response :unprocessable_content
+
+      post_bot_message " \n\t"
+      assert_response :unprocessable_content
+    end
+  end
+
+  test "deleting a bot revokes its code without deleting past messages" do
+    post_bot_message "Hello"
+    assert_response :created
+    message = @room.messages.last
+
+    sign_in :kevin
+    delete bot_path(@bot)
+    assert_redirected_to bots_path
+    assert_equal @bot, message.reload.creator
+
+    get bots_path
+    assert_select "li", text: /Deploy Bot/, count: 0
+
+    assert_no_difference -> { Message.count } do
+      post_bot_message "Hello again"
+      assert_response :unauthorized
+    end
+  end
+
+  test "the rolling limit applies across rooms and cooldown expires without being extended" do
+    freeze_time
+    started_at = Time.current
+    other_room = rooms(:designers)
+    other_room.memberships.grant_to @bot
+
+    5.times do
+      post_bot_message "First burst"
+      assert_response :created
+    end
+    travel_to started_at + 9.seconds
+    5.times do
+      post_bot_message "Second burst", room_id: other_room.id
+      assert_response :created
+    end
+    travel_to started_at + 10.seconds
+    5.times do
+      post_bot_message "Third burst"
+      assert_response :created
+    end
+
+    assert_no_difference -> { @bot.messages.count } do
+      post_bot_message "Over the limit", room_id: other_room.id
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+
+      travel_to started_at + 39.seconds
+      post_bot_message "Still cooling down"
+      assert_response :too_many_requests
+      assert_equal "1", response.headers["Retry-After"]
+    end
+
+    travel_to started_at + 40.seconds
+    post_bot_message "Back again"
+    assert_response :created
+  end
+
+  test "five attempts during the same cooldown suspend the bot without removing its messages or rooms" do
+    freeze_time
+    10.times do
+      post_bot_message "Hello"
+      assert_response :created
+    end
+    post_bot_message "Start cooldown"
+    assert_response :too_many_requests
+
+    4.times do
+      post_bot_message "During cooldown"
+      assert_response :too_many_requests
+      assert_predicate @bot.reload, :active?
+    end
+    post_bot_message "Fifth cooldown attempt"
+    assert_response :too_many_requests
+    assert_predicate @bot.reload, :suspended?
+    assert_equal 10, @bot.messages.count
+    assert_includes @bot.rooms, @room
+
+    travel 1.minute
+    post_bot_message "Still suspended"
+    assert_response :forbidden
+    assert_nil response.headers["Retry-After"]
+    post_bot_message "Still suspended", room_id: 0
+    assert_response :forbidden
+  end
+
+  private
+    def post_bot_message(body = "", room_id: @room.id, code: @bot.bot_code, content_type: "application/x-www-form-urlencoded")
+      post "/rooms/#{room_id}/#{code}/messages", params: body.dup, headers: { "Content-Type" => content_type }
+    end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..9950424
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,262 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  test "a member can create and edit a bot" do
+    sign_in :kevin
+
+    get edit_account_path
+    assert_select "a[href='#{bots_path}']", text: "Set up chat bots"
+
+    get new_bot_path
+    assert_select "label", text: "Name the bot"
+    assert_select "button", text: "Save changes"
+
+    assert_difference -> { Bot.count }, 1 do
+      post bots_path, params: { bot: { name: "Deploy Bot", avatar: fixture_file_upload("earth.png", "image/png") } }
+      assert_redirected_to bots_path
+    end
+
+    bot = Bot.last
+    assert_equal users(:kevin), bot.creator
+    assert bot.avatar.attached?
+    assert_empty bot.rooms
+
+    get bots_path
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_select "meta[name=turbo-cache-control][content=no-cache]"
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "label", text: "Bot code"
+      assert_select "input[readonly][value='#{bot.bot_code}']"
+      assert_select "a[href='#{edit_bot_path(bot)}']", text: "Edit Deploy Bot"
+    end
+
+    patch bot_path(bot), params: { bot: { name: "Release Bot" } }
+    assert_redirected_to bots_path
+    assert_equal "Release Bot", bot.reload.name
+  end
+
+  test "members are limited to five bots each by default" do
+    Bot.create!(name: "Another Member's Bot", creator: users(:jz))
+    sign_in :kevin
+
+    assert_difference -> { users(:kevin).created_bots.count }, 5 do
+      5.times do |number|
+        post bots_path, params: { bot: { name: "Bot #{number}" } }
+        assert_redirected_to bots_path
+      end
+    end
+
+    get bots_path
+    assert_select "a", text: "Add a chat bot", count: 0
+    assert_select "p", text: /reached the limit/
+
+    get new_bot_path
+    assert_redirected_to bots_path
+
+    assert_no_difference -> { Bot.count } do
+      post bots_path, params: { bot: { name: "One Too Many" } }
+      assert_response :unprocessable_content
+      assert_select "[role=alert]", text: /reached the limit/
+    end
+  end
+
+  test "lowering the limit keeps existing bots and deletion only frees a spot below the limit" do
+    member = users(:kevin)
+    first = member.created_bots.create!(name: "First Bot")
+    second = member.created_bots.create!(name: "Second Bot")
+    accounts(:signal).update!(bots_per_member: 1)
+    sign_in :kevin
+
+    get bots_path
+    assert_select "a", text: "Edit First Bot"
+    assert_select "a", text: "Edit Second Bot"
+    assert_select "a", text: "Add a chat bot", count: 0
+
+    patch bot_path(second), params: { bot: { name: "Renamed Bot" } }
+    assert_redirected_to bots_path
+    assert_equal "Renamed Bot", second.reload.name
+
+    delete bot_path(first)
+    follow_redirect!
+    assert_select "p", text: /reached the limit/
+    assert_select "a", text: "Add a chat bot", count: 0
+
+    delete bot_path(second)
+    follow_redirect!
+    assert_select "a", text: "Add a chat bot"
+    assert_select "p", text: /reached the limit/, count: 0
+
+    assert_difference -> { member.created_bots.active.count }, 1 do
+      post bots_path, params: { bot: { name: "Replacement Bot" } }
+      assert_redirected_to bots_path
+    end
+  end
+
+  test "a zero limit blocks members but not administrators" do
+    accounts(:signal).update!(bots_per_member: 0)
+    sign_in :kevin
+
+    get bots_path
+    assert_select "p", text: /reached the limit/
+    assert_select "a", text: "Add a chat bot", count: 0
+
+    sign_in :david
+
+    assert_difference -> { users(:david).created_bots.count }, 2 do
+      2.times do |number|
+        get bots_path
+        assert_select "a", text: "Add a chat bot"
+        assert_select "p", text: /reached the limit/, count: 0
+
+        post bots_path, params: { bot: { name: "Admin Bot #{number}" } }
+        assert_redirected_to bots_path
+      end
+    end
+  end
+
+  test "a member cannot see or manage another member's bot, but an administrator can" do
+    bot = Bot.create!(name: "Another Bot", creator: users(:jz))
+
+    sign_in :kevin
+    get bots_path
+    assert_select "li", text: /Another Bot/, count: 0
+    assert_not_includes response.body, bot.bot_code
+    assert_raises(ActiveRecord::RecordNotFound) { get edit_bot_path(bot) }
+    assert_raises(ActiveRecord::RecordNotFound) { patch bot_path(bot), params: { bot: { name: "Renamed" } } }
+    assert_raises(ActiveRecord::RecordNotFound) { delete bot_path(bot) }
+
+    sign_in :david
+    get bots_path
+    assert_select "a[href='#{edit_bot_path(bot)}']", text: "Edit Another Bot"
+
+    get edit_bot_path(bot)
+    assert_select "form[data-turbo-confirm] button", text: "Delete this chat bot"
+  end
+
+  test "suspended bots remain listed and count towards their owner's limit" do
+    member = users(:kevin)
+    bot = Bot.create!(name: "Flooding Bot", creator: member, status: :suspended, suspension_reason: "Message rate limit exceeded")
+    accounts(:signal).update!(bots_per_member: 1)
+
+    sign_in :kevin
+    get bots_path
+    assert_select "li", text: /Flooding Bot/ do
+      assert_select "strong", text: "Suspended"
+      assert_select "p", text: /Message rate limit exceeded/
+      assert_select "button", text: "Reactivate", count: 0
+    end
+    assert_select "a", text: "Add a chat bot", count: 0
+
+    post bot_reactivation_path(bot)
+    assert_response :forbidden
+    assert_predicate bot.reload, :suspended?
+  end
+
+  test "administrators can reactivate a bot and clear its moderation state" do
+    freeze_time
+    bot = Bot.create!(name: "Flooding Bot", creator: users(:kevin), status: :suspended,
+      suspension_reason: "Message rate limit exceeded", recent_post_times: [ Time.current.to_f ] * 10,
+      cooldown_until: 30.seconds.from_now, cooldown_attempts: 5, webhook_failures: 9)
+    room = rooms(:hq)
+    room.memberships.grant_to bot
+    reply_to = room_bot_messages_path(room, bot.bot_code)
+
+    sign_in :david
+    get bots_path
+    assert_select "form[action='#{bot_reactivation_path(bot)}'][data-turbo-confirm] button", text: "Reactivate"
+
+    post bot_reactivation_path(bot)
+    assert_redirected_to bots_path
+    assert_predicate bot.reload, :active?
+    assert_nil bot.suspension_reason
+    assert_equal 0, bot.webhook_failures
+
+    post reply_to, params: +"Back online"
+    assert_response :created
+    assert_equal "Back online", bot.messages.last.plain_text_body
+  end
+
+  test "a bot can opt in to all open rooms on creation or update" do
+    sign_in :kevin
+
+    get new_bot_path
+    assert_select "label[for=bot_add_to_all_open_rooms]", text: "Add to all open rooms"
+    assert_select "input#bot_add_to_all_open_rooms[type=checkbox]:not([checked])"
+
+    post bots_path, params: { bot: { name: "Release Bot", add_to_all_open_rooms: "1" } }
+    assert_redirected_to bots_path
+    bot = Bot.last
+    assert_equal Rooms::Open.ids.sort, bot.room_ids.sort
+
+    get edit_bot_path(bot)
+    assert_select "label[for=bot_add_to_all_open_rooms]", text: "Add to all open rooms"
+    assert_select "input#bot_add_to_all_open_rooms[type=checkbox][checked]"
+
+    patch bot_path(bot), params: { bot: { add_to_all_open_rooms: "0" } }
+    assert_redirected_to bots_path
+    assert_not bot.reload.add_to_all_open_rooms?
+    assert_equal Rooms::Open.ids.sort, bot.room_ids.sort
+
+    new_room = Rooms::Open.create!(name: "Ops", creator: users(:kevin))
+    assert_not_includes bot.reload.rooms, new_room
+
+    patch bot_path(bot), params: { bot: { add_to_all_open_rooms: "1" } }
+    assert_redirected_to bots_path
+    assert_equal Rooms::Open.ids.sort, bot.reload.room_ids.sort
+  end
+
+  test "a webhook URL can be set and cleared" do
+    sign_in :kevin
+    url = "https://bot.example.com/hooks/release"
+
+    get new_bot_path
+    assert_select "label[for=bot_webhook_url]", text: "Webhook URL"
+    assert_select "input#bot_webhook_url:not([required])"
+
+    post bots_path, params: { bot: { name: "Release Bot", webhook_url: url } }
+    assert_redirected_to bots_path
+    bot = Bot.last
+    assert_equal url, bot.webhook_url
+
+    get edit_bot_path(bot)
+    assert_select "label[for=bot_webhook_url]", text: "Webhook URL"
+    assert_select "input#bot_webhook_url[value=?]", url
+
+    patch bot_path(bot), params: { bot: { webhook_url: "" } }
+    assert_redirected_to bots_path
+    assert_nil bot.reload.webhook_url
+  end
+
