+class Bot::MentionWebhookJob < Bot::WebhookJob
+  def perform(bot, message)
+    deliver(bot, message.room) do
+      payload(bot, message) if message.mentionees.exists?(bot.id)
+    end
+  end
+
+  private
+    def payload(bot, message)
+      routes = Rails.application.routes.url_helpers
+      author = message.creator
+      room = message.room
+
+      {
+        event: "mention",
+        author: { id: author.id, name: author.name },
+        room: room_payload(bot, room),
+        message: {
+          id: message.id,
+          body: { text: message.plain_text_body_without_mention(bot), html: message.body.to_s },
+          link: routes.room_at_message_path(room, message)
+        }
+      }
+    end
+end
diff --git a/app/jobs/bot/webhook_job.rb b/app/jobs/bot/webhook_job.rb
