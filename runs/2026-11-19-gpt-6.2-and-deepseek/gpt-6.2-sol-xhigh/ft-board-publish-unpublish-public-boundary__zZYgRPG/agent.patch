+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "admin can publish a board and revoke its public URL" do
+    sign_in_as :kevin
+
+    get board_path(@board), as: :json
+    assert_includes response.parsed_body, "public_url"
+    assert_nil response.parsed_body["public_url"]
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    public_url = response.parsed_body.fetch("public_url")
+    assert_match %r{\Ahttp://www\.example\.com/public/boards/[^/]+\z}, public_url
+    assert_equal public_url, response.location
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    assert_equal public_url, response.parsed_body["public_url"]
+
+    get boards_path, as: :json
+    assert_equal public_url, response.parsed_body.find { |board| board["id"] == @board.id }.fetch("public_url")
+
+    published_etag = response.headers.fetch("ETag")
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+
+    get boards_path, as: :json, headers: { "If-None-Match" => published_etag }
+    assert_response :success
+    assert_nil response.parsed_body.find { |board| board["id"] == @board.id }.fetch("public_url")
+
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body.fetch("public_url")
+
+    get public_url
+    assert_response :not_found
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    assert_not_equal public_url, response.parsed_body.fetch("public_url")
+  end
+
+  test "board creator who is not an admin cannot publish or unpublish" do
+    publication = @board.publish
+    sign_in_as :david
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_equal publication, @board.reload.publication
+  end
+
+  test "admin cannot publish a board in another account" do
+    sign_in_as :kevin
+
+    post board_publication_path(boards(:miltons_wish_list)), as: :json
+    assert_response :not_found
+  end
+
+  test "board settings let admins copy or revoke the public link" do
+    sign_in_as :kevin
+    get edit_board_path(@board)
+    assert_select "form[action='#{board_publication_path(@board)}'] button", text: "Publish board"
+
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    follow_redirect!
+    assert_select "a", text: "View public board"
+    assert_select "button[data-copy-to-clipboard-content-value]", text: "Copy public link"
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    follow_redirect!
+    assert_select "a", text: "View public board", count: 0
+  end
+
+  test "destroying the board removes its publication" do
+    publication = @board.publish
+    sign_in_as :kevin
+
+    delete board_path(@board), as: :json
+    assert_response :no_content
+    assert_not Board::Publication.exists?(publication.id)
+  end
+
+  test "publishing requires authentication" do
+    post board_publication_path(@board)
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+end
