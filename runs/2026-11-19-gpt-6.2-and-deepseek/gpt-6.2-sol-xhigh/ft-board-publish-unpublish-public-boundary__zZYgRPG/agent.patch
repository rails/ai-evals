+require "test_helper"
+
+class PublicBoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @public_path = "/public/boards/#{@board.publish.key}"
+    @column = columns(:writebook_triage)
+    @card = cards(:logo)
+    @draft = @board.cards.create!(status: :drafted, title: "Private draft", column: @column, creator: users(:david))
+  end
+
+  test "anyone with the public URL can open the board and visit its columns and published cards" do
+    get @public_path
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a[href='#{@public_path}/columns/#{@column.id}']", text: @column.name
+    assert_select "a[href='#{@public_path}/cards/#{@card.number}']", text: @card.title
+    assert_no_match @draft.title, response.body
+    assert_equal "no-referrer", response.headers["Referrer-Policy"]
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_equal "none", response.headers["X-Robots-Tag"]
+    assert_select 'meta[name="turbo-cache-control"][content="no-cache"]'
+
+    get "#{@public_path}/columns/#{@column.id}"
+    assert_response :success
+    assert_select "a[href='#{@public_path}/cards/#{@card.number}']", text: @card.title
+    assert_no_match @draft.title, response.body
+
+    @card.update!(description: "Make it a lot bigger")
+    get "#{@public_path}/cards/#{@card.number}"
+    assert_response :success
+    assert_select "h1", text: @card.title
+    assert_includes response.body, "Make it a lot bigger"
+    assert_select "main form", count: 0
+  end
+
+  test "public card descriptions do not link to private uploads" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("private"), filename: "private.txt", content_type: "text/plain")
+    attachment = ActionText::Attachment.from_attachable(blob)
+    @card.update!(description: "<p><strong>Card details</strong> #{attachment.to_html}</p>")
+
+    get "#{@public_path}/cards/#{@card.number}"
+    assert_response :success
+    assert_select ".card__description strong", text: "Card details"
+    assert_select ".card__description a[href*='active_storage']", count: 0
+    assert_includes response.body, "[private.txt]"
+  end
+
+  test "draft cards are not available by direct link" do
+    get "#{@public_path}/cards/#{@draft.number}"
+    assert_response :not_found
+  end
+
+  test "a key only grants access to its own board" do
+    other_board = boards(:private)
+    other_column = other_board.columns.create!(name: "Private column")
+    other_card = with_current_user(:kevin) { other_board.cards.create!(status: :published, title: "Private card") }
+
+    get "#{@public_path}/columns/#{other_column.id}"
+    assert_response :not_found
+
+    get "#{@public_path}/cards/#{other_card.number}"
+    assert_response :not_found
+  end
+
+  test "public viewing does not grant access to the authenticated board endpoints or change the board" do
+    get board_path(@board)
+    assert_redirected_to new_session_path(script_name: nil)
+
+    post @public_path
+    assert_response :not_found
+  end
+
+  test "keys in the query string do not override the path" do
+    get "/public/boards/unknown", params: { board_key: @board.publication.key }
+    assert_response :not_found
+
+    get "/public/boards/unknown/cards/#{@card.number}", params: { key: @board.publication.key }
+    assert_response :not_found
+  end
+
+  test "a restricted board can be shared without granting account access" do
+    board = boards(:private)
+    sign_in_as :david
+
+    get "/public/boards/#{board.publish.key}"
+    assert_response :success
+    assert_select "h1", text: board.name
+
+    get board_path(board)
+    assert_response :not_found
+  end
+
+  test "card numbers resolve within the published board's account" do
+    other_board = boards(:miltons_wish_list)
+    other_card = cards(:radio)
+    assert_equal @card.number, other_card.number
+
+    get "/public/boards/#{other_board.publish.key}/cards/#{other_card.number}"
+    assert_response :success
+    assert_select "h1", text: other_card.title
+  end
+
+  test "unpublishing revokes the board and its direct links" do
+    @board.unpublish
+
+    [ @public_path, "#{@public_path}/columns/#{@column.id}", "#{@public_path}/cards/#{@card.number}" ].each do |path|
+      get path
+      assert_response :not_found
+    end
+  end
+end
