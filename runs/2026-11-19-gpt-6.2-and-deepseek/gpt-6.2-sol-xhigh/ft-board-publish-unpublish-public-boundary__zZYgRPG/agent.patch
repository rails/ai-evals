diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..85b5c47
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,23 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_admin
+
+  def create
+    publication = @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), status: :see_other, notice: "Board published" }
+      format.json { render "boards/show", status: :created, location: public_board_url(publication, script_name: nil) }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), status: :see_other, notice: "Board unpublished" }
+      format.json { head :no_content }
+    end
+  end
+end
