+service: fizzy
+image: fizzy
+minimum_version: 2.11.0
+
+servers:
+  web:
+    - &host fizzy.example.com # Replace with your server's public hostname.
+
+proxy:
+  host: *host
+  ssl: true
+  app_port: 80 # Thruster listens here; Kamal Proxy terminates TLS.
+  healthcheck:
+    path: /up
+
+# Kamal starts this registry on your workstation and tunnels it over SSH.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Use arm64 if that's what your server runs.
+
+# Uncomment if you connect as a user other than root (must be able to run Docker).
+# ssh:
+#   user: deploy
+
+env:
+  clear:
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true" # Run jobs in the web container.
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    FIZZY_HOST: *host
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_USERNAME: fizzy@example.com # Omit for an unauthenticated relay.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    # SMTP_TLS: implicit # Default: starttls (587). Use implicit (465) or none (25) if needed.
+    # SMTP_PORT: 2525    # Override the port for your SMTP server if needed.
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+
+volumes:
+  - fizzy_storage:/rails/storage # SQLite databases and local uploads.
+
+asset_path: /rails/public/assets
