diff --git a/app/controllers/sessions_controller.rb b/app/controllers/sessions_controller.rb
index 2bef7c1..27d764d 100644
--- a/app/controllers/sessions_controller.rb
+++ b/app/controllers/sessions_controller.rb
@@ -10,7 +10,7 @@ class SessionsController < ApplicationController
   def create
     if user = User.active.authenticate_by(email_address: params[:email_address], password: params[:password])
       start_new_session_for user
-      redirect_to params[:return_to].presence || post_authenticating_url, allow_other_host: true
+      redirect_to safe_return_to || post_authenticating_url, allow_other_host: false
     else
       render_rejection :unauthorized
     end
@@ -22,6 +22,21 @@ class SessionsController < ApplicationController
   end
 
   private
+    def safe_return_to
+      location = params[:return_to]
+      return unless location.is_a?(String) && location.ascii_only?
+      return if location.match?(/[[:space:][:cntrl:]\\]/)
+
+      uri = URI.parse(location)
+      if uri.relative?
+        location if location.start_with?("/") && !location.start_with?("//")
+      elsif uri.is_a?(URI::HTTP) && uri.host.present? && uri.userinfo.nil? && uri.origin == request.base_url
+        location
+      end
+    rescue URI::Error
+      nil
+    end
+
     def ensure_user_exists
       redirect_to first_run_url if User.none?
     end
diff --git a/test/controllers/sessions/return_to_test.rb b/test/controllers/sessions/return_to_test.rb
new file mode 100644
index 0000000..cee7c31
--- /dev/null
+++ b/test/controllers/sessions/return_to_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Sessions::ReturnToTest < ActionDispatch::IntegrationTest
+  test "sign-in returns to the protected page that requested authentication" do
+    https!
+    host! "books.example.test:8443"
+    destination = edit_book_path(books(:handbook), tab: "book details")
+
+    get destination
+    assert_redirected_to new_session_path(return_to: request.url)
+    follow_redirect!
+    assert_response :success
+
+    sign_in_with_return_to css_select("input[name=return_to]").sole["value"]
+
+    assert_redirected_to destination
+    follow_redirect!
+    assert_response :success
+  end
+
+  test "sign-in preserves a local path with a query and fragment" do
+    destination = leafable_slug_path(leaves(:welcome_page), search: "read more", anchor: "notes")
+
+    sign_in_with_return_to destination
+
+    assert_redirected_to destination
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "sign-in ignores a return URL on another host" do
+    sign_in_with_return_to "https://example.org/page"
+
+    assert_redirected_to root_path
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "sign-in ignores return URLs that are not clearly on the current origin" do
+    https!
+    host! "books.example.test"
+
+    [
+      "//books.example.test/page",
+      "http://books.example.test/page",
+      "https://books.example.test:8443/page",
+      "ftp://books.example.test/page",
+      "https://reader@books.example.test/page",
+      "page"
+    ].each do |destination|
+      assert_difference -> { Session.count }, 1 do
+        sign_in_with_return_to destination
+      end
+      assert_redirected_to root_path, "Expected fallback for #{destination.inspect}"
+    end
+  end
+
+  test "sign-in ignores malformed or non-string return destinations" do
+    [ " ", "/invalid%path", "/\\page", "/page?query=\u0001", [ "/page" ], { path: "/page" } ].each do |destination|
+      assert_difference -> { Session.count }, 1 do
+        sign_in_with_return_to destination
+      end
+      assert_redirected_to root_path, "Expected fallback for #{destination.inspect}"
+    end
+  end
+
+  private
+    def sign_in_with_return_to(destination)
+      post session_path, params: { email_address: users(:david).email_address, password: "secret123456", return_to: destination }
+    end
+end
