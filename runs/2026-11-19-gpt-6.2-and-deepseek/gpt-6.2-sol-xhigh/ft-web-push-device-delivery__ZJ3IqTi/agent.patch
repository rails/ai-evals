index 0000000..02d05c1
--- /dev/null
+++ b/test/system/notification_settings_test.rb
@@ -0,0 +1,58 @@
+require "application_system_test_case"
+
+class NotificationSettingsTest < ApplicationSystemTestCase
+  setup do
+    @vapid_keys = WebPush.generate_key
+    @old_public_key, @old_private_key = ENV.values_at("VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY")
+    ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = @vapid_keys.public_key, @vapid_keys.private_key
+    @user = users(:david)
+  end
+
+  teardown do
+    ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = @old_public_key, @old_private_key
+    page.driver.browser.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: @script_id) if @script_id
+  end
+
+  test "turning on push registers this browser and stays on across page loads" do
+    stub_push_manager(permission: "granted")
+    sign_in_as @user
+    visit notifications_settings_path
+
+    click_on "Turn on notifications"
+    assert_text "Push notifications are on for this device."
+    assert_equal @subscription.fetch(:endpoint), @user.push_subscriptions.sole.endpoint
+
+    refresh
+    assert_text "Push notifications are on for this device."
+
+    click_on "Turn off notifications"
+    assert_text "Push notifications are off on this device."
+    assert_empty @user.push_subscriptions
+  end
+
+  test "settings show the browser help when permission is blocked" do
+    stub_push_manager(permission: "denied")
+    sign_in_as @user
+    visit notifications_settings_path
+
+    assert_selector ".notifications-help", text: "Turn on notifications"
+    assert_no_button "Turn on notifications"
+  end
+
+  private
+    def stub_push_manager(permission:)
+      @subscription = {
+        endpoint: "https://fcm.googleapis.com/fcm/send/browser-device",
+        keys: { p256dh: WebPush.generate_key.public_key, auth: WebPush.encode64(SecureRandom.random_bytes(16)) }
+      }
+      @script_id = page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: <<~JS).fetch("identifier")
+        Object.defineProperty(Notification, "permission", { value: #{permission.to_json} })
+        const subscription = { ...#{@subscription.to_json}, toJSON() { return #{@subscription.to_json} } }
+        PushManager.prototype.getSubscription = async () => sessionStorage.pushSubscribed ? subscription : null
+        PushManager.prototype.subscribe = async () => {
+          sessionStorage.pushSubscribed = "true"
+          return subscription
+        }
+      JS
+    end
+end
