diff --git a/app/models/push/request.rb b/app/models/push/request.rb
new file mode 100644
index 0000000..adfcc73
--- /dev/null
+++ b/app/models/push/request.rb
@@ -0,0 +1,39 @@
+class Push::Request
+  class ServiceUnavailable < StandardError; end
+
+  TIMEOUT = 5.seconds
+
+  def initialize(subscription, message)
+    @uri = URI(subscription.endpoint)
+    @push_request = WebPush::Request.new(
+      message: message,
+      subscription: { endpoint: subscription.endpoint, keys: { p256dh: subscription.p256dh_key, auth: subscription.auth_key } },
+      vapid: Push::Subscription.vapid,
+      ttl: 1.day.to_i
+    )
+  end
+
+  def perform
+    if ip = SsrfProtection.resolve_public_ip(@uri.hostname)
+      request = Net::HTTP::Post.new(@uri.request_uri, @push_request.headers)
+      request.body = @push_request.body
+
+      # The endpoint is supplied by the browser. Pin the checked IP without
+      # changing the TLS hostname, and don't follow redirects or use a proxy.
+      http(ip).start do |connection|
+        connection.request(request) { |response| return response.code.to_i }
+      end
+    end
+  end
+
+  private
+    def http(ip)
+      Net::HTTP.new(@uri.hostname, @uri.port, nil).tap do |http|
+        http.ipaddr = ip
+        http.use_ssl = true
+        http.open_timeout = TIMEOUT
+        http.read_timeout = TIMEOUT
+        http.write_timeout = TIMEOUT
+      end
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..765877d
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,93 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  # Leave room for the encryption overhead in the push service's 4 KiB limit.
+  MAX_PAYLOAD_SIZE = 3992
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  belongs_to :session, optional: true
+
+  before_validation -> { self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s) }
+
+  validates :endpoint, presence: true, length: { maximum: 2048 }
+  validate :validate_endpoint, :validate_keys
+
+  class << self
+    def configured?
+      ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+
+    def vapid
+      {
+        public_key: ENV["VAPID_PUBLIC_KEY"],
+        private_key: ENV["VAPID_PRIVATE_KEY"],
+        subject: ENV["BASE_URL"].presence || "mailto:support@fizzy.do"
+      }
+    end
+  end
+
+  def deliver(source)
+    if self.class.configured? && deliverable?(source)
+      case status = Push::Request.new(self, payload_for(source)).perform
+      when 404, 410
+        destroy
+      when 429, 500..599
+        raise Push::Request::ServiceUnavailable, "Push service returned HTTP #{status}"
+      when Integer
+        Rails.logger.warn("Push service returned HTTP #{status}") unless status.between?(200, 299)
+      end
+    end
+  end
+
+  private
+    def deliverable?(source)
+      user.active? && account.active? && (!session_id || session&.identity_id == user.identity_id) &&
+        source.account_id == account_id && source.notifiable_target.present? && user.accessible_cards.exists?(source.card&.id)
+    end
+
+    def payload_for(source)
+      message = ApplicationController.renderer.new(script_name: account.slug).render(
+        template: "notifications/push", formats: [ :json ], layout: false, locals: { source: source }
+      )
+
+      if message.bytesize > MAX_PAYLOAD_SIZE
+        payload = JSON.parse(message)
+        payload["title"] = payload["title"].truncate_bytes(300)
+        payload["body"] = payload["body"].truncate_bytes(300)
+        JSON.generate(payload)
+      else
+        message
+      end
+    end
+
+    def validate_endpoint
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.hostname.present? && uri.port == 443 && !uri.userinfo && !uri.fragment
+        errors.add(:endpoint, :invalid)
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, :invalid)
+    end
+
+    def validate_keys
+      errors.add(:auth_key, :invalid) unless valid_auth_key?
+      errors.add(:p256dh_key, :invalid) unless valid_p256dh_key?
+    end
+
+    def valid_auth_key?
+      WebPush.decode64(auth_key.to_s).bytesize == 16
+    rescue ArgumentError
+      false
+    end
+
+    def valid_p256dh_key?
+      key = WebPush.decode64(p256dh_key.to_s)
+      return false unless key.bytesize == 65 && key.getbyte(0) == 4
+
+      group = OpenSSL::PKey::EC::Group.new("prime256v1")
+      OpenSSL::PKey::EC::Point.new(group, OpenSSL::BN.new(key, 2)).on_curve?
+    rescue ArgumentError, OpenSSL::PKey::EC::Point::Error
+      false
+    end
+end
