diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..249532e
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    @keys = WebPush.generate_key
+    @attributes = {
+      endpoint: "https://fcm.googleapis.com/fcm/send/device-token",
+      p256dh_key: WebPush.generate_key.public_key,
+      auth_key: WebPush.encode64(SecureRandom.random_bytes(16))
+    }
+
+    sign_in_as @user
+  end
+
+  test "registers the browser subscription for the signed-in user" do
+    with_vapid_keys do
+      post "#{@user.account.slug}/users/#{@user.id}/push_subscriptions",
+        params: { push_subscription: @attributes }
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.find(response.parsed_body.fetch("id"))
+    assert_equal @attributes.stringify_keys, subscription.attributes.slice(*@attributes.keys.map(&:to_s))
+    assert_equal @user.account, subscription.account
+    assert_equal @user.identity, subscription.session.identity
+  end
+
+  test "requires both VAPID keys to register a device" do
+    with_vapid_keys do
+      ENV.delete("VAPID_PRIVATE_KEY")
+
+      assert_no_difference -> { @user.push_subscriptions.count } do
+        post user_push_subscriptions_path(@user), params: { push_subscription: @attributes }, as: :json
+      end
+      assert_response :service_unavailable
+    end
+  end
+
+  test "re-registering an endpoint refreshes the credentials without creating another subscription" do
+    with_vapid_keys do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @attributes }, as: :json
+      id = response.parsed_body.fetch("id")
+      auth_key = WebPush.encode64(SecureRandom.random_bytes(16))
+
+      assert_no_difference -> { @user.push_subscriptions.count } do
+        post user_push_subscriptions_path(@user), params: { push_subscription: @attributes.merge(auth_key: auth_key) }, as: :json
+      end
+
+      assert_equal id, response.parsed_body.fetch("id")
+      assert_equal auth_key, @user.push_subscriptions.find(id).auth_key
+    end
+  end
+
+  test "cannot register a device for another user" do
+    with_vapid_keys do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @attributes }, as: :json
+      assert_response :forbidden
+
+      post user_push_subscriptions_path(users(:mike)), params: { push_subscription: @attributes }, as: :json
+      assert_response :not_found
+    end
+  end
+
+  test "rejects invalid browser subscription data" do
+    with_vapid_keys do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @attributes.merge(auth_key: "not a key") }, as: :json
+      assert_response :unprocessable_entity
+
+      post user_push_subscriptions_path(@user), params: { push_subscription: @attributes.merge(endpoint: "http://example.com/device") }, as: :json
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "can disable push on just the current device" do
+    with_vapid_keys do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @attributes }, as: :json
+      first_id = response.parsed_body.fetch("id")
+      post user_push_subscriptions_path(@user), params: { push_subscription: @attributes.merge(endpoint: "https://fcm.googleapis.com/fcm/send/other-device") }, as: :json
+      second_id = response.parsed_body.fetch("id")
+
+      delete user_push_subscription_path(@user, first_id), as: :json
+      assert_response :no_content
+      assert_equal [ second_id ], @user.push_subscriptions.ids
+    end
+  end
+
+  test "signing out removes registered subscriptions from that session" do
+    with_vapid_keys do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @attributes }, as: :json
+      id = response.parsed_body.fetch("id")
+
+      sign_out
+      assert_not @user.push_subscriptions.exists?(id)
+    end
+  end
+
+  private
+    def with_vapid_keys
+      old_public, old_private = ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = @keys.public_key, @keys.private_key
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = old_public, old_private
+    end
+end
diff --git a/test/jobs/push/delivery_job_test.rb b/test/jobs/push/delivery_job_test.rb
new file mode 100644
index 0000000..bad31d8
--- /dev/null
+++ b/test/jobs/push/delivery_job_test.rb
@@ -0,0 +1,149 @@
+require "test_helper"
+
+class Push::DeliveryJobTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @endpoint = "https://fcm.googleapis.com/fcm/send/device-token"
+    @subscription = subscribe(@user, @endpoint)
+    @source = events(:layout_commented)
+
+    key = WebPush.generate_key
+    Push::Subscription.stubs(:configured?).returns(true)
+    Push::Subscription.stubs(:vapid).returns(public_key: key.public_key, private_key: key.private_key)
+    stub_dns_resolution "8.8.8.8"
+  end
+
+  test "new tray entries enqueue one delivery for each registered device of the recipient" do
+    other_device = subscribe(@user, "https://fcm.googleapis.com/fcm/send/other-device")
+    subscribe(users(:david), "https://fcm.googleapis.com/fcm/send/not-the-recipient")
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_jobs 2, only: Push::DeliveryJob do
+      Notification.create!(user: @user, source: @source, creator: @source.creator)
+    end
+
+    assert_enqueued_with job: Push::DeliveryJob, args: [ @subscription, @source ]
+    assert_enqueued_with job: Push::DeliveryJob, args: [ other_device, @source ]
+  end
+
+  test "new activity on an existing tray entry pushes but marking it read or unread does not" do
+    subscriber = users(:david)
+    device = subscribe(subscriber, "https://fcm.googleapis.com/fcm/send/david")
+    notification = notifications(:logo_mentioned_david)
+    mention = mentions(:logo_card_david_mention_by_jz)
+
+    assert_enqueued_with job: Push::DeliveryJob, args: [ device, mention ] do
+      Notifier.for(mention).notify
+    end
+
+    assert_no_enqueued_jobs only: Push::DeliveryJob do
+      notification.reload.read
+      notification.unread
+    end
+  end
+
+  test "comment messages reuse the tray text and open the comment on the account-scoped card" do
+    comment = @source.eventable
+    expect_payload @subscription, {
+      "title" => "RE: #{comment.card.title}",
+      "body" => comment.body.to_plain_text.truncate(200),
+      "url" => "#{@user.account.slug}/cards/#{comment.card.number}#comment_#{comment.id}"
+    }
+
+    Push::DeliveryJob.perform_now(@subscription, @source)
+  end
+
+  test "mention messages reuse the tray text and open the card" do
+    mention = mentions(:logo_card_david_mention_by_jz)
+    subscription = subscribe(mention.mentionee, @endpoint)
+    expect_payload subscription, {
+      "title" => "#{mention.mentioner.first_name} @mentioned you",
+      "body" => mention.source.mentionable_content.truncate(200),
+      "url" => "#{@user.account.slug}/cards/#{mention.card.number}"
+    }
+
+    Push::DeliveryJob.perform_now(subscription, mention)
+  end
+
+  test "card updates reuse the tray text and open the card" do
+    event = events(:logo_assignment_km)
+    expect_payload @subscription, {
+      "title" => event.card.title,
+      "body" => "Assigned to #{@user.name}",
+      "url" => "#{@user.account.slug}/cards/#{event.card.number}"
+    }
+
+    Push::DeliveryJob.perform_now(@subscription, event)
+  end
+
+  test "limits oversized push messages without losing the card link" do
+    event = events(:logo_assignment_km)
+    event.assign_attributes(action: "card_triaged", particulars: { "particulars" => { "column" => "💬" * 1200 } })
+    request = mock("push request", perform: 201)
+    Push::Request.expects(:new).with { |_, message|
+      message.bytesize <= 3992 && JSON.parse(message).fetch("url") == "#{@user.account.slug}/cards/#{event.card.number}"
+    }.returns(request)
+
+    Push::DeliveryJob.perform_now(@subscription, event)
+  end
+
+  test "posts an encrypted and VAPID-authenticated message to the push service" do
+    request = stub_request(:post, @endpoint).with(headers: {
+      "Authorization" => /\Avapid t=.+,k=.+\z/,
+      "Content-Encoding" => "aes128gcm"
+    }).to_return(status: 201)
+
+    Push::DeliveryJob.perform_now(@subscription, @source)
+
+    assert_requested request
+  end
+
+  test "removes subscriptions that the push service no longer recognizes" do
+    other_device = subscribe(@user, "https://fcm.googleapis.com/fcm/send/other-device")
+    stub_request(:post, @endpoint).to_return(status: 410)
+    stub_request(:post, other_device.endpoint).to_return(status: 404)
+
+    Push::DeliveryJob.perform_now(@subscription, @source)
+    assert_not @user.push_subscriptions.exists?(@subscription.id)
+    assert @user.push_subscriptions.exists?(other_device.id)
+
+    Push::DeliveryJob.perform_now(other_device, @source)
+    assert_not @user.push_subscriptions.exists?(other_device.id)
+  end
+
+  test "retries a transient service failure without deleting the subscription" do
+    stub_request(:post, @endpoint).to_return(status: 503)
+
+    assert_enqueued_with job: Push::DeliveryJob, args: [ @subscription, @source ] do
+      Push::DeliveryJob.perform_now(@subscription, @source)
+    end
+    assert @user.push_subscriptions.exists?(@subscription.id)
+  end
+
+  test "skips delivery if the push host resolves to a non-public address" do
+    stub_dns_resolution "127.0.0.1"
+
+    Push::DeliveryJob.perform_now(@subscription, @source)
+
+    assert_not_requested :post, @endpoint
+  end
+
+  test "skips delivery when the user has lost access to the card" do
+    @user.accesses.find_by!(board: @source.board).destroy!
+
+    Push::DeliveryJob.perform_now(@subscription, @source)
+
+    assert_not_requested :post, @endpoint
+  end
+
+  private
+    def subscribe(user, endpoint)
+      user.push_subscriptions.create!(endpoint: endpoint, p256dh_key: WebPush.generate_key.public_key,
+        auth_key: WebPush.encode64(SecureRandom.random_bytes(16)))
+    end
+
+    def expect_payload(subscription, payload)
+      request = mock("push request", perform: 201)
+      Push::Request.expects(:new).with { |device, message| device == subscription && JSON.parse(message) == payload }.returns(request)
+    end
+end
diff --git a/test/system/notification_settings_test.rb b/test/system/notification_settings_test.rb
