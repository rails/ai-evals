new file mode 100644
index 0000000..10db65a
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,31 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    return head :service_unavailable unless Push::Subscription.configured?
+
+    subscription = @user.subscribe_to_push(subscription_params, session: Current.session, user_agent: request.user_agent)
+    render json: { id: subscription.id }, status: :created
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
