+class Push::DeliveryJob < ApplicationJob
+  queue_as :default
+
+  discard_on ActiveJob::DeserializationError
+  retry_on Push::Request::ServiceUnavailable, Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout, wait: :polynomially_longer, attempts: 3
+
+  def perform(subscription, source)
+    subscription.deliver(source)
+  end
+end
