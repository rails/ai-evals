diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..a969c73
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,102 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "status", "enable", "disable", "error", "help", "unsupported", "details" ]
+  static values = { url: String, publicKey: String, subscriptions: Object }
+
+  async connect() {
+    if ("serviceWorker" in navigator && "PushManager" in window && "Notification" in window) {
+      this.registration = await navigator.serviceWorker.ready
+      await this.refresh()
+    } else {
+      this.helpTarget.hidden = false
+      this.unsupportedTarget.hidden = false
+      this.detailsTargets.forEach(details => details.hidden = true)
+    }
+  }
+
+  async refresh() {
+    if (!this.registration || this.busy) return
+
+    this.statusTarget.hidden = false
+    try {
+      this.subscription = await this.registration.pushManager.getSubscription()
+      this.subscriptionId = this.subscription && this.subscriptionsValue[await this.#endpointDigest()]
+      this.#updateControls()
+    } catch {
+      this.errorTarget.hidden = false
+    }
+  }
+
+  enable() {
+    return this.#changeSubscription(async () => {
+      this.subscription ||= await this.registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+
+      const { endpoint, keys } = this.subscription.toJSON()
+      const response = await post(this.urlValue, {
+        body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+        responseKind: "json"
+      })
+      if (response.statusCode !== 201) throw new Error("Could not register push subscription")
+
+      this.subscriptionId = (await response.json).id
+      this.subscriptionsValue = { ...this.subscriptionsValue, [await this.#endpointDigest()]: this.subscriptionId }
+    })
+  }
+
+  disable() {
+    return this.#changeSubscription(async () => {
+      const response = await destroy(`${this.urlValue}/${this.subscriptionId}`, { responseKind: "json" })
+      if (![ 204, 404 ].includes(response.statusCode)) throw new Error("Could not remove push subscription")
+
+      // Keep the browser subscription because it can be in use by other accounts.
+      const subscriptions = this.subscriptionsValue
+      delete subscriptions[await this.#endpointDigest()]
+      this.subscriptionsValue = subscriptions
+      this.subscriptionId = null
+    })
+  }
+
+  async #changeSubscription(change) {
+    if (this.busy) return
+
+    this.busy = true
+    this.errorTarget.hidden = true
+    this.#updateControls()
+
+    try {
+      await change()
+    } catch {
+      this.errorTarget.hidden = Notification.permission === "denied"
+    } finally {
+      this.busy = false
+      this.#updateControls()
+    }
+  }
+
+  #updateControls() {
+    const enabled = Boolean(this.subscriptionId)
+    const blocked = Notification.permission === "denied"
+
+    this.element.classList.toggle("notifications--on", enabled && !blocked)
+    this.enableTarget.hidden = enabled || blocked
+    this.disableTarget.hidden = !enabled
+    this.enableTarget.disabled = this.busy
+    this.disableTarget.disabled = this.busy
+    this.helpTarget.hidden = !blocked
+  }
+
+  get #applicationServerKey() {
+    const bytes = atob(this.publicKeyValue.replaceAll("-", "+").replaceAll("_", "/"))
+    return Uint8Array.from(bytes, character => character.charCodeAt(0))
+  }
+
+  async #endpointDigest() {
+    const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(this.subscription.endpoint))
+    return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, "0")).join("")
+  }
+}
