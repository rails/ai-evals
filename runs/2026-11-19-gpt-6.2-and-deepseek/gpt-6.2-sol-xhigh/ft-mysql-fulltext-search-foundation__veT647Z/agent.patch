diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..1bf14f1
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,77 @@
+class Card::Search
+  MAX_QUERY_LENGTH = 200
+
+  attr_reader :query, :pattern
+
+  def self.searchable_rich_text?(record_type, name)
+    [ record_type, name ].in?([ [ "Card", "description" ], [ "Comment", "body" ] ])
+  end
+
+  def self.plain_text(body)
+    # Search written content, without HTML markup or resolving embedded records.
+    content = body.is_a?(ActionText::Content) ? body : ActionText::Content.new(body)
+    content.fragment.to_plain_text.squish.presence
+  end
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.squish.first(MAX_QUERY_LENGTH)
+    @terms = @query.split.uniq
+    if @terms.any?
+      @pattern = Regexp.new(Regexp.union(@terms.sort_by { |term| -term.length }).source, Regexp::IGNORECASE)
+    end
+  end
+
+  def cards
+    @terms.reduce(published_cards) do |cards, term|
+      cards.where(title_matches(term).or(description_matches(term)).or(comment_matches(term)))
+    end.preload(:board).reverse_chronologically
+  end
+
+  def description_excerpts(cards)
+    descriptions.where(record_id: cards.map(&:id)).pluck(:record_id, :search_text).to_h
+  end
+
+  def comment_excerpts(cards)
+    any_term = @terms.map { |term| text_matches(ActionText::RichText.arel_table[:search_text], term) }.reduce(:or)
+    matching_comments = comments.where(card_id: cards.map(&:id)).where(any_term)
+
+    # Pick one matching comment per card, without loading the entire discussion.
+    comment_ids = matching_comments.group(:card_id).select(Comment.arel_table[:id].maximum)
+    comments.where(id: comment_ids).pluck(:card_id, "action_text_rich_texts.search_text").to_h
+  end
+
+  private
+    def published_cards
+      cards = @user.accessible_cards.where(account_id: @user.account_id).published
+      @terms.empty? ? cards.none : cards
+    end
+
+    def title_matches(term)
+      text_matches(Card.arel_table[:title], term)
+    end
+
+    def description_matches(term)
+      rich_texts = ActionText::RichText.arel_table
+      descriptions.where(rich_texts[:record_id].eq(Card.arel_table[:id]))
+        .where(text_matches(rich_texts[:search_text], term)).arel.exists
+    end
+
+    def comment_matches(term)
+      comments.where(Comment.arel_table[:card_id].eq(Card.arel_table[:id]))
+        .where(text_matches(ActionText::RichText.arel_table[:search_text], term)).arel.exists
+    end
+
+    def descriptions
+      ActionText::RichText.where(account_id: @user.account_id, record_type: "Card", name: "description")
+    end
+
+    def comments
+      Comment.where(account_id: @user.account_id).joins(:rich_text_body)
+        .where(action_text_rich_texts: { account_id: @user.account_id })
+    end
+
+    def text_matches(column, term)
+      column.matches("%#{ActiveRecord::Base.sanitize_sql_like(term, "!")}%", "!")
+    end
+end
