@@ -0,0 +1,16 @@
+module SearchesHelper
+  def highlight_search_matches(text, pattern)
+    safe_join(text.split(/(#{pattern})/).map { |part| pattern.match?(part) ? tag.mark(part) : part })
+  end
+
+  def highlighted_search_excerpt(text, pattern, length: 200)
+    if match = pattern.match(text.to_s)
+      start = [ match.begin(0) - length / 3, 0 ].max
+      finish = [ start + length, match.end(0) ].max
+      excerpt = text[start...finish]
+      excerpt = "…#{excerpt}" if start.positive?
+      excerpt = "#{excerpt}…" if finish < text.length
+      highlight_search_matches(excerpt, pattern)
+    end
+  end
+end
