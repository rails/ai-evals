+class SearchesController < ApplicationController
+  def show
+    no_store
+    response.headers["Vary"] = "*" # Older service workers must not cache search results either.
+
+    query = params[:q] if params[:q].is_a?(String)
+    @search = Card::Search.new(Current.user, query)
+    @cards = set_page_and_extract_portion_from(@search.cards, per_page: 25)
+    if @cards.any?
+      @description_excerpts = @search.description_excerpts(@cards)
+      @comment_excerpts = @search.comment_excerpts(@cards)
+    end
+  end
+end
