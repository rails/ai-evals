diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..c18e4df
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,39 @@
+<% @page_title = "Search cards" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide borderless center flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half", html: { role: "search" } do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, class: "input full-width", placeholder: "Search cards…", maxlength: Card::Search::MAX_QUERY_LENGTH %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @search.query.blank? %>
+    <p>Search card titles, descriptions, and comments.</p>
+  <% elsif @cards.empty? %>
+    <p>No cards match your search.</p>
+  <% else %>
+    <ol id="search-results" class="unpad margin-none flex flex-column gap-half" role="list">
+      <% @cards.each do |card| %>
+        <li class="panel full-width pad txt-break">
+          <div class="txt-small txt-subtle"><%= card.board.name %> · #<%= card.number %></div>
+          <h2 class="txt-medium margin-none"><%= link_to highlight_search_matches(card.title.to_s, @search.pattern), card_path(card) %></h2>
+          <% if excerpt = highlighted_search_excerpt(@description_excerpts[card.id], @search.pattern) %>
+            <p class="txt-small margin-none"><%= excerpt %></p>
+          <% end %>
+          <% if excerpt = highlighted_search_excerpt(@comment_excerpts[card.id], @search.pattern) %>
+            <p class="txt-small margin-none">Comment: <%= excerpt %></p>
+          <% end %>
+        </li>
+      <% end %>
+    </ol>
+
+    <% unless @page.last? %>
+      <%= link_to "Next page", search_path(q: @search.query, page: @page.next_param), class: "btn center", data: { turbo_prefetch: false } %>
+    <% end %>
+  <% end %>
+</section>
