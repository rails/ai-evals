diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..53ea4bc
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,157 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  test "finds cards by title, description, and comment body, newest first" do
+    sign_in_as :david
+    board = boards(:writebook)
+    title_match, description_match, comment_match = with_current_user(:david) do
+      title_match = board.cards.create!(title: "Needle in the title", status: :published, created_at: 3.days.ago)
+      description_match = board.cards.create!(title: "Description match", description: "<p>A <b>need</b>le here</p>", status: :published, created_at: 2.days.ago)
+      comment_match = board.cards.create!(title: "Comment match", status: :published, created_at: 1.day.ago)
+      comment_match.comments.create!(body: "<p>A needle in a comment</p>")
+      comment_match.comments.create!(body: "Another NEEDLE")
+      [ title_match, description_match, comment_match ]
+    end
+
+    get search_path, params: { q: "needle" }
+
+    assert_result_cards comment_match, description_match, title_match
+    assert_select "#search-results p mark", text: "needle"
+    assert_select "#search-results p mark", text: "NEEDLE"
+    assert_select "#search-results h2 mark", text: "Needle"
+  end
+
+  test "uses current board access even for a publicly shared board" do
+    sign_in_as :david
+    user = users(:david)
+    board = boards(:private)
+    card = with_current_user(:kevin) do
+      board.publish
+      board.cards.create!(title: "Restricted card", status: :published).tap do |card|
+        card.comments.create!(body: "Restricted comment")
+      end
+    end
+
+    get search_path, params: { q: "Restricted" }
+    assert_result_cards
+    assert_not_includes response.body, "Restricted comment"
+
+    board.accesses.grant_to(user)
+    get search_path, params: { q: "Restricted" }
+    assert_result_cards card
+    assert_select "#search-results p mark", text: "Restricted"
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_includes response.headers["Vary"].split(/,\s*/), "*"
+    assert_select 'meta[name="turbo-cache-control"][content="no-cache"]'
+
+    board.accesses.revoke_from(user)
+    get search_path, params: { q: "Restricted" }
+    assert_result_cards
+    assert_not_includes response.body, "Restricted comment"
+  end
+
+  test "does not search other accounts" do
+    sign_in_as :david
+    get search_path, params: { q: "reasonable volume" }
+    assert_result_cards
+  end
+
+  test "excludes a draft's title, description, and comments" do
+    sign_in_as :david
+    card = with_current_user(:david) do
+      boards(:writebook).cards.create!(title: "Drafttitle", description: "Draftdescription", status: :published).tap do |card|
+        card.comments.create!(body: "Draftcomment")
+        card.drafted!
+      end
+    end
+
+    %w[ Drafttitle Draftdescription Draftcomment ].each do |query|
+      get search_path, params: { q: query }
+      assert_result_cards
+    end
+
+    with_current_user(:david) { card.publish }
+    get search_path, params: { q: "Drafttitle Draftdescription Draftcomment" }
+    assert_result_cards card
+  end
+
+  test "updates results when descriptions are edited or comments deleted" do
+    sign_in_as :david
+    card = cards(:logo)
+    comment = with_current_user(:david) do
+      card.update!(description: "Legacysearchword in the description")
+      card.comments.create!(body: "Legacysearchword in a comment")
+    end
+
+    get search_path, params: { q: "Legacysearchword" }
+    assert_result_cards card
+    assert_select "#search-results p mark", text: "Legacysearchword", count: 2
+
+    with_current_user(:david) do
+      card.update!(description: "Updatedsearchword in the description")
+      comment.destroy!
+    end
+
+    get search_path, params: { q: "Legacysearchword" }
+    assert_result_cards
+    get search_path, params: { q: "Updatedsearchword" }
+    assert_result_cards card
+  end
+
+  test "treats special characters as literal text and marks escaped content" do
+    sign_in_as :david
+    card = with_current_user(:david) do
+      board = boards(:writebook)
+      board.cards.create!(title: "100x [ready_] <img>", status: :published)
+      board.cards.create!(title: "100% [readya] <img>", status: :published)
+      board.cards.create!(title: "100% [ready_] <img>", description: '<p title="hiddenword">A &amp; B</p>', status: :published)
+    end
+
+    get search_path, params: { q: "  100% [ready_] <img> " }
+    assert_result_cards card
+    assert_select "#search-results h2 mark", text: "[ready_]"
+    assert_select "#search-results h2 mark", text: "<img>"
+    assert_select "#search-results img", count: 0
+
+    get search_path, params: { q: "&" }
+    assert_result_cards card
+    assert_select "#search-results p mark", text: "&"
+
+    get search_path, params: { q: "hiddenword" }
+    assert_result_cards
+  end
+
+  test "excerpts show matches far into a comment" do
+    sign_in_as :david
+    card = cards(:logo)
+    with_current_user(:david) { card.comments.create!(body: "#{'Some earlier text. ' * 100}Needle at the end") }
+
+    get search_path, params: { q: "needle" }
+    assert_result_cards card
+    assert_select "#search-results p mark", text: "Needle"
+    assert_select "#search-results p", text: /Comment: …/
+  end
+
+  test "blank and non-string queries show the search form without results" do
+    sign_in_as :david
+
+    [ nil, "  ", [ "logo" ] ].each do |query|
+      get search_path, params: { q: query }
+      assert_result_cards
+      assert_select 'form[role="search"] input[type="search"][name="q"]'
+      assert_select "p", text: "Search card titles, descriptions, and comments."
+    end
+  end
+
+  test "requires a session" do
+    get search_path, params: { q: "logo" }
+    assert_response :redirect
+    assert_select "#search-results", count: 0
+  end
+
+  private
+    def assert_result_cards(*cards)
+      assert_response :success
+      assert_equal cards.map { |card| card_path(card) }, css_select("#search-results h2 a").map { |link| link["href"] }
+    end
+end
