diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..8a00314
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,29 @@
+# The primary key is the attachment id. Retain its last contribution even after
+# the attachment (and possibly its entire board) has been deleted.
+class Storage::Entry < ApplicationRecord
+  self.table_name = "storage_entries"
+
+  after_create  -> { adjust_usage(byte_size) }
+  after_destroy -> { adjust_usage(-byte_size) }
+
+  def self.refresh(attachment_id)
+    transaction do
+      # Serialize workers refreshing the same attachment. Once it is gone, the
+      # entry itself is the lock that prevents two workers debiting it twice.
+      attachment = ActiveStorage::Attachment.lock.find_by(id: attachment_id)
+      previous = (attachment ? all : lock).find_by(id: attachment_id)
+      current = attachment&.storage_entry
+
+      unless previous&.attributes == current&.attributes
+        previous&.destroy!
+        current&.save!
+      end
+    end
+  end
+
+  private
+    def adjust_usage(delta)
+      Board.where(id: board_id, account_id: account_id).update_counters(bytes_used: delta)
+      Account.update_counters(account_id, bytes_used: delta)
+    end
+end
diff --git a/app/models/storage/tracked_attachment.rb b/app/models/storage/tracked_attachment.rb
new file mode 100644
index 0000000..2c4df42
--- /dev/null
+++ b/app/models/storage/tracked_attachment.rb
@@ -0,0 +1,47 @@
+module Storage::TrackedAttachment
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :refresh_storage_entry_later, on: [ :create, :destroy ]
+  end
+
+  def storage_candidate?
+    (record_type == "Card" && name == "image") || (record_type == "ActionText::RichText" && name == "embeds")
+  end
+
+  def storage_entry
+    if storage_candidate? && (board_id = storage_board_id)
+      Storage::Entry.new(id: id, account_id: account_id, board_id: board_id, byte_size: byte_size)
+    end
+  end
+
+  # Active Storage purges (and single-attachment detaches) use delete, not destroy.
+  def delete
+    super.tap { refresh_storage_entry_later }
+  end
+
+  private
+    def refresh_storage_entry_later
+      Storage::RefreshJob.perform_later(id) if storage_candidate?
+    end
+
+    def storage_board_id
+      case record_type
+      when "Card"
+        Card.where(id: record_id, account_id: account_id).pick(:board_id)
+      when "ActionText::RichText"
+        rich_text_board_id
+      end
+    end
+
+    def rich_text_board_id
+      # Only fetch ownership metadata, not the (potentially large) body.
+      type, field, parent_id = ActionText::RichText.where(id: record_id, account_id: account_id).pick(:record_type, :name, :record_id)
+
+      case [ type, field ]
+      when [ "Board", "public_description" ] then Board.where(id: parent_id, account_id: account_id).pick(:id)
+      when [ "Card", "description" ]        then Card.where(id: parent_id, account_id: account_id).pick(:board_id)
+      when [ "Comment", "body" ]            then Comment.where(id: parent_id, account_id: account_id).joins(:card).pick("cards.board_id")
+      end
+    end
+end
