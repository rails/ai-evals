diff --git a/app/jobs/storage/reindex_job.rb b/app/jobs/storage/reindex_job.rb
new file mode 100644
index 0000000..b3faa18
--- /dev/null
+++ b/app/jobs/storage/reindex_job.rb
@@ -0,0 +1,59 @@
+class Storage::ReindexJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::LockWaitTimeout, ActiveRecord::StatementTimeout, wait: :polynomially_longer
+
+  def perform(scope = nil)
+    if scope.is_a?(Card)
+      each_batch :moved, attachments_on_card(scope).select(:id) do |batch|
+        batch.each { |attachment| Storage::Entry.refresh(attachment.id) }
+      end
+    else
+      reconcile(scope)
+    end
+  end
+
+  private
+    def attachments_on_card(card)
+      descriptions = ActionText::RichText.where(record: card, name: "description")
+      comments = ActionText::RichText.where(record_type: "Comment", record_id: card.comments.select(:id), name: "body")
+      embeds = ActiveStorage::Attachment.where(record: descriptions.or(comments), name: "embeds")
+
+      ActiveStorage::Attachment.where(record: card, name: "image").or(embeds)
+    end
+
+    # Backfill existing/imported attachments and catch bulk deletes that bypass
+    # callbacks. Walk the primary keys; only inspect owners and blobs for gaps.
+    def reconcile(account)
+      attachments = ActiveStorage::Attachment.all
+      entries = Storage::Entry.all
+      if account
+        attachments = attachments.where(account_id: account.id)
+        entries = entries.where(account_id: account.id)
+      end
+
+      each_batch :additions, attachments.select(:id, :record_type, :name) do |batch|
+        ids = batch.filter_map { |attachment| attachment.id if attachment.storage_candidate? }
+        refresh_missing(ids, entries)
+      end
+
+      each_batch :removals, entries.select(:id) do |batch|
+        refresh_missing(batch.map(&:id), attachments)
+      end
+    end
+
+    def refresh_missing(ids, from)
+      (ids - from.where(id: ids).ids).each { |id| Storage::Entry.refresh(id) }
+    end
+
+    def each_batch(name, records)
+      step name do |step|
+        records.find_in_batches(start: step.cursor) do |batch|
+          yield batch
+          step.set! batch.last.id
+        end
+      end
+    end
+end
