diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..b1b2b4f
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,138 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = Current.account
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "board and account usage include only card images and board, card and comment embeds" do
+    @card.image.attach(blob(2))
+    @board.update!(public_description: embed(3))
+    @card.update!(description: embed(5))
+    @comment.update!(body: embed(7))
+    boards(:private).update!(public_description: embed(11))
+    exports(:pending_account_export).file.attach(blob(13))
+    blob(17) # Unattached upload
+    ActionText::RichText.create!(record: @board, name: "other", body: embed(19))
+    Current.with_account(accounts(:initech)) { cards(:radio).image.attach(blob(23)) }
+
+    assert_equal 0, @account.reload.bytes_used
+    perform_enqueued_jobs only: Storage::RefreshJob
+    assert_equal 17, @board.reload.bytes_used
+    assert_equal 11, boards(:private).reload.bytes_used
+    assert_equal 28, @account.reload.bytes_used
+    assert_equal 23, accounts(:initech).reload.bytes_used
+  end
+
+  test "replacement, embed removal, and purging an image reverse only their own bytes" do
+    @card.image.attach(blob(2))
+    @card.update!(description: embed(3) + embed(5))
+    @comment.update!(body: embed(7))
+    refresh
+    assert_usage 17
+
+    @card.image.attach(blob(11))
+    @card.update!(description: "")
+    @comment.destroy!
+    refresh
+    assert_usage 11
+
+    @card.image.purge_later
+    refresh
+    assert_usage 0
+  end
+
+  test "moving a card transfers all of its usage but not the board's own description" do
+    @board.update!(public_description: embed(2))
+    @card.image.attach(blob(3))
+    @card.update!(description: embed(5))
+    @comment.update!(body: embed(7))
+    refresh
+    assert_usage 17
+
+    @card.move_to(boards(:private))
+    perform_enqueued_jobs only: Storage::ReindexJob
+    assert_equal 2, @board.reload.bytes_used
+    assert_equal 15, boards(:private).reload.bytes_used
+    assert_equal 17, @account.reload.bytes_used
+
+    boards(:private).destroy!
+    refresh
+    assert_usage 2
+  end
+
+  test "a delayed or retried job reconciles against current state" do
+    @card.image.attach(blob(2))
+    id = @card.image.attachment.id
+    @card.image.detach
+    @card.image.attach(blob(5))
+    refresh
+    assert_usage 5
+
+    2.times do
+      Storage::RefreshJob.perform_now(@card.image.attachment.id)
+      Storage::RefreshJob.perform_now(id)
+    end
+    assert_usage 5
+
+    @card.image.detach
+    refresh
+    assert_usage 0
+  end
+
+  test "backfill picks up existing attachments without double counting" do
+    @card.image.attach(blob(2))
+    @comment.update!(body: embed(5))
+    clear_enqueued_jobs
+
+    2.times { Storage::ReindexJob.perform_now(@account) }
+    assert_usage 7
+
+    ActiveStorage::Attachment.where(id: @card.image.attachment.id).delete_all
+    Storage::ReindexJob.perform_now
+    assert_usage 5
+  end
+
+  test "detaching multiple embeds removes their usage" do
+    @comment.update!(body: embed(5) + embed(7))
+    refresh
+    assert_usage 12
+
+    @comment.body.embeds.detach
+    refresh
+    assert_usage 0
+  end
+
+  test "rolled back attachment changes do not affect usage" do
+    @card.image.attach(blob(2))
+    refresh
+    @card.transaction do
+      @card.image.purge_later
+      raise ActiveRecord::Rollback
+    end
+    refresh
+    assert_usage 2
+  end
+
+  private
+    def refresh
+      perform_enqueued_jobs only: Storage::RefreshJob
+    end
+
+    def assert_usage(bytes)
+      assert_equal bytes, @board.reload.bytes_used
+      assert_equal bytes, @account.reload.bytes_used
+    end
+
+    def blob(size)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * size), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def embed(size)
+      ActionText::Attachment.from_attachable(blob(size)).to_html
+    end
+end
