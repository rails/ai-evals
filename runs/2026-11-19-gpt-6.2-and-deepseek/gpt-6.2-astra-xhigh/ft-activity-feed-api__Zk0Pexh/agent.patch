+class ActivitiesController < ApplicationController
+  def index
+    events = Current.user.accessible_events.for_activity_feed
+    events = events.where(creator_id: params.expect(creator_ids: [])) if params[:creator_ids].present?
+    events = events.where(board_id: params.expect(board_ids: [])) if params[:board_ids].present?
+
+    set_page_and_extract_portion_from events.preloaded.order(created_at: :desc, id: :desc)
+  end
+end
