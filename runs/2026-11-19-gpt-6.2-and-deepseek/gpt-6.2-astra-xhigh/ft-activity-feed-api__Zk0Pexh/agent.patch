diff --git a/docs/api/sections/activities.md b/docs/api/sections/activities.md
new file mode 100644
index 0000000..0ccc71e
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,33 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat array of activity on boards the current user can access, newest first.
+Follow the `Link` header with `rel="next"` for the [next page](../README.md#pagination).
+
+| Optional parameter | Description |
+|--------------------|-------------|
+| `creator_ids[]` | Include events created by any of these users. |
+| `board_ids[]` | Include events on any of these boards. |
+
+When both filters are supplied, events must match both. For example:
+
+```
+GET /:account_slug/activities.json?creator_ids[]=USER_ID&board_ids[]=BOARD_ID
+```
+
+Each event includes `id`, `action`, `created_at`, a plain-text `description`, and `particulars`.
+`eventable_type` is `Card` or `Comment`, and `eventable` contains the corresponding
+[card](cards.md) or [comment](comments.md) object. `board` is the [board](boards.md) and
+`creator` is the [user](users.md) who created the event. The event's `url` opens the card
+in the browser, anchored to the comment for a `comment_created` event.
+
+| Action | Fields in `particulars` |
+|--------|-------------------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` (array of user IDs) |
+| `card_board_changed` | `old_board`, `new_board` (board names) |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` (column name) |
+| `card_published`, `card_closed`, `card_reopened`, `card_postponed`, `card_auto_postponed`, `card_sent_back_to_triage`, `comment_created` | None (`{}`) |
+
+Missing board names, titles, or column names in `particulars` are returned as empty strings.
diff --git a/lib/rails_ext/geared_pagination_list_parameters.rb b/lib/rails_ext/geared_pagination_list_parameters.rb
new file mode 100644
index 0000000..2218071
--- /dev/null
+++ b/lib/rails_ext/geared_pagination_list_parameters.rb
@@ -0,0 +1,12 @@
+# geared_pagination 1.2 converts the query string to a flat hash, dropping repeated
+# filter parameters (e.g. creator_ids[]) from the link to the next page.
+module GearedPaginationListParameters
+  private
+    def uri(page:)
+      uri = Addressable::URI.parse(request.url)
+      uri.query = request.query_parameters.merge("page" => page).to_query
+      uri.to_s
+    end
+end
+
+GearedPagination::Headers.prepend GearedPaginationListParameters
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..91029e8
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "index returns card and comment activities with their API representations" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    activities = @response.parsed_body.index_by { |activity| activity.fetch("id") }
+    event = events(:logo_published)
+    activity = activities.fetch(event.id)
+    card = event.eventable
+
+    assert_equal "card_published", activity["action"]
+    assert_equal event.created_at.as_json, activity["created_at"]
+    assert_equal event.description_for(users(:david)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(card), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+
+    get cards_path(card_ids: [ card.id ]), as: :json
+    assert_response :success
+    card_json = @response.parsed_body.sole
+    assert_equal card_json, activity["eventable"]
+    assert_equal card_json["board"], activity["board"]
+    assert_equal card_json["creator"], activity["creator"]
+
+    event = events(:layout_commented)
+    activity = activities.fetch(event.id)
+    comment = event.eventable
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+    get card_comment_path(comment.card, comment), as: :json
+    assert_response :success
+    assert_equal @response.parsed_body, activity["eventable"]
+  end
+
+  test "index selects activity actions and exposes only their particulars" do
+    card = cards(:layout)
+    creator = users(:jz)
+    assignee_ids = users(:kevin, :david).map(&:id)
+    card.track_event(:assigned, creator:, assignee_ids:)
+    card.track_event(:unassigned, creator:, assignee_ids:)
+    card.track_event(:board_changed, creator:, particulars: { old_board: "Old", new_board: "New" })
+    card.track_event(:title_changed, creator:, particulars: { old_title: "Before", new_title: "After" })
+    card.track_event(:triaged, creator:, particulars: { column: "In progress" })
+    card.track_event(:reopened, creator:, particulars: { extra: "not exposed" })
+    card.track_event(:collection_changed, creator:)
+    card.track_event(:resumed, creator:)
+
+    get activities_path(creator_ids: [ creator.id ]), as: :json
+    assert_response :success
+    assert_equal({
+      "card_assigned" => { "assignee_ids" => assignee_ids },
+      "card_unassigned" => { "assignee_ids" => assignee_ids },
+      "card_board_changed" => { "old_board" => "Old", "new_board" => "New" },
+      "card_title_changed" => { "old_title" => "Before", "new_title" => "After" },
+      "card_triaged" => { "column" => "In progress" },
+      "card_reopened" => {}
+    }, @response.parsed_body.to_h { |activity| activity.values_at("action", "particulars") })
+  end
+
+  test "missing board, title and column particulars are empty strings" do
+    creator = users(:jz)
+    card = cards(:layout)
+    card.track_event(:board_changed, creator:, particulars: { old_board: nil })
+    card.track_event(:title_changed, creator:)
+    card.track_event(:triaged, creator:).update_column(:particulars, nil)
+
+    get activities_path(creator_ids: [ creator.id ]), as: :json
+    assert_response :success
+    assert_equal({
+      "card_board_changed" => { "old_board" => "", "new_board" => "" },
+      "card_title_changed" => { "old_title" => "", "new_title" => "" },
+      "card_triaged" => { "column" => "" }
+    }, @response.parsed_body.to_h { |activity| activity.values_at("action", "particulars") })
+  end
+
+  test "filters apply within the user's accessible boards" do
+    private_board = boards(:private)
+    with_current_user(:kevin) { cards(:layout).move_to(private_board) }
+    cards(:radio).track_event(:published, creator: users(:mike))
+
+    get activities_path, as: :json
+    assert_response :success
+    assert_equal [ boards(:writebook).id ], @response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq
+
+    get activities_path(board_ids: [ private_board.id, boards(:miltons_wish_list).id ]), as: :json
+    assert_response :success
+    assert_empty @response.parsed_body
+
+    private_board.accesses.grant_to(users(:david))
+    get activities_path(board_ids: [ private_board.id ], creator_ids: [ users(:david).id ]), as: :json
+    assert_response :success
+    assert_equal events(:layout_published, :layout_assignment_jz, :layout_commented).map(&:id).sort, @response.parsed_body.pluck("id").sort
+  end
+
+  test "index paginates newest first, keeping the filters on subsequent pages" do
+    12.times { cards(:logo).track_event(:published, creator: users(:kevin)) }
+    expected_ids = boards(:writebook).events.order(created_at: :desc, id: :desc).ids
+
+    get activities_path(format: :json, creator_ids: users(:david, :kevin).map(&:id))
+    assert_response :success
+    ids = @response.parsed_body.pluck("id")
+    assert_equal expected_ids.size.to_s, @response.headers["X-Total-Count"]
+    next_url = @response.headers.fetch("Link")[/<([^>]+)>; rel="next"/, 1]
+
+    get next_url
+    assert_response :success
+    assert_equal expected_ids, ids + @response.parsed_body.pluck("id")
+    assert_nil @response.headers["Link"]
+  end
+end
