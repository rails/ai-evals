diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..517e46b
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "searches titles, descriptions and comments, returning each matching card once, newest first" do
+    cards(:logo).update_columns title: "Fix the Needle", created_at: 2.days.ago
+    cards(:text).update! description: "<div>Missing <b>NEE</b>DLE in haystack</div>", created_at: 1.day.ago
+    cards(:layout).update! created_at: 3.days.ago
+    comments(:layout_overflowing_david).update! body: "Where's the needle?"
+    cards(:layout).comments.create! body: "Another needle", creator: users(:jz)
+
+    get search_path(q: "needle")
+    assert_response :success
+    assert_equal [ cards(:text), cards(:logo), cards(:layout) ].map { card_path(it) }, result_links
+    assert_select "main mark", text: "NEEDLE"
+    assert_select "main a mark", text: "Needle"
+    assert_select "main mark", text: "needle"
+  end
+
+  test "search checks current board access even when a comment matches" do
+    get search_path(q: "overflowing")
+    assert_equal [ card_path(cards(:layout)) ], result_links
+    assert_match "no-store", response.headers["Cache-Control"]
+    assert_select "meta[name='turbo-cache-control'][content='no-cache']"
+
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:david)
+
+    get search_path(q: "overflowing")
+    assert_response :success
+    assert_empty result_links
+    assert_select "main mark", count: 0
+  end
+
+  test "draft cards and their comments are not searchable" do
+    cards(:layout).drafted!
+
+    [ "Layout", "overflowing" ].each do |query|
+      get search_path(q: query)
+      assert_response :success
+      assert_empty result_links
+    end
+  end
+
+  test "requires a signed-in user" do
+    sign_out
+    get search_path(q: "overflowing")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "cannot search other accounts" do
+    get search_path(q: "radio")
+    assert_response :success
+    assert_empty result_links
+  end
+
+  test "offers a search form without listing all cards for a blank query" do
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select "form[action=?][method=get] input[name=q]", search_path
+    assert_empty result_links
+    assert_select "main mark", count: 0
+  end
+
+  test "matches words across fields and does not include cards matching only one word" do
+    get search_path(q: "  layout   overflowing ")
+    assert_equal [ card_path(cards(:layout)) ], result_links
+    assert_select "main mark", text: "Layout"
+    assert_select "main mark", text: "overflowing"
+
+    get search_path(q: "logo overflowing")
+    assert_empty result_links
+  end
+
+  test "searches visible text, treating HTML and special characters literally" do
+    cards(:text).update! description: '<p class="hidden-keyword">Use &lt;img&gt; &amp; 100%_[x]</p>'
+    cards(:logo).update_columns title: "100abcZ[x]"
+
+    get search_path(q: "100%_[x]")
+    assert_equal [ card_path(cards(:text)) ], result_links
+    assert_select "main mark", text: "100%_[x]"
+    assert_select "article img", count: 0
+
+    get search_path(q: "<img>")
+    assert_equal [ card_path(cards(:text)) ], result_links
+    assert_select "main mark", text: "<img>"
+    assert_select "article img", count: 0
+
+    get search_path(q: "hidden-keyword")
+    assert_empty result_links
+  end
+
+  test "reflects comment edits and deletion" do
+    comment = comments(:layout_overflowing_david)
+    comment.update! body: "Resized the container."
+
+    get search_path(q: "overflowing")
+    assert_empty result_links
+    get search_path(q: "resized")
+    assert_equal [ card_path(cards(:layout)) ], result_links
+
+    comment.destroy!
+    get search_path(q: "resized")
+    assert_empty result_links
+  end
+
+  private
+    def result_links
+      css_select("main a[href*='/cards/']").map { it["href"] }
+    end
+end
