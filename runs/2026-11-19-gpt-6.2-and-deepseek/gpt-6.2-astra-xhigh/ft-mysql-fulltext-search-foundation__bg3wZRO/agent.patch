diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..b357a4b
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,41 @@
+class Card::Search
+  MAX_QUERY_LENGTH = 200
+
+  attr_reader :query
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.squish.first(MAX_QUERY_LENGTH)
+    @words = @query.split.uniq(&:downcase)
+  end
+
+  def cards
+    cards = Card.where(account_id: @user.account_id, board: @user.boards).published.left_joins(:rich_text_description)
+    return cards.none if @words.empty?
+
+    @words.each do |word|
+      card_matches = cards.where(<<~SQL.squish, word: word)
+        INSTR(LOWER(cards.title), LOWER(:word)) > 0 OR INSTR(LOWER(action_text_rich_texts.plain_text), LOWER(:word)) > 0
+      SQL
+      cards = card_matches.or(cards.where(comments_containing(word).arel.exists))
+    end
+
+    cards.reverse_chronologically.select("cards.*", "action_text_rich_texts.plain_text AS description_text", matching_comment_text)
+  end
+
+  def pattern
+    @pattern ||= /#{Regexp.union(@words.sort_by { -it.length }).source}/i
+  end
+
+  private
+    def comments_containing(word)
+      # Drive the lookup from the card's comments rather than scanning all rich text bodies for every card.
+      Comment.left_joins(:rich_text_body).where("comments.card_id = cards.id")
+        .where("INSTR(LOWER(action_text_rich_texts.plain_text), LOWER(?)) > 0", word)
+    end
+
+    def matching_comment_text
+      matches = @words.map { comments_containing(it) }.reduce(:or)
+      matches.order(created_at: :desc, id: :desc).limit(1).select("action_text_rich_texts.plain_text").arel.as("comment_text")
+    end
+end
