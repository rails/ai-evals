diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..b506463
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,9 @@
+<article class="margin-block txt-break">
+  <h2 class="txt-medium"><%= link_to highlight_search_matches(card.title, pattern), card, data: { turbo_frame: "_top" } %></h2>
+  <% if description = excerpt(card.description_text, pattern) %>
+    <p class="txt-small"><%= highlight_search_matches(description, pattern) %></p>
+  <% end %>
+  <% if comment = excerpt(card.comment_text, pattern) %>
+    <p class="txt-small">Comment: <%= highlight_search_matches(comment, pattern) %></p>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..365de7c
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,22 @@
+<% @page_title = "Search cards" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide shadow center txt-align-start">
+  <%= form_with url: search_path, method: :get, role: "search", class: "flex gap-half" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Titles, descriptions, or comments…", maxlength: Card::Search::MAX_QUERY_LENGTH, autofocus: true, class: "input full-width" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @page.records.present? %>
+    <%= with_manual_pagination :search_results, @page do %>
+      <%= render partial: "result", collection: @page.records, as: :card, locals: { pattern: @search.pattern } %>
+    <% end %>
+  <% elsif @search.query.present? %>
+    <p>No cards match your search.</p>
+  <% end %>
+</section>
