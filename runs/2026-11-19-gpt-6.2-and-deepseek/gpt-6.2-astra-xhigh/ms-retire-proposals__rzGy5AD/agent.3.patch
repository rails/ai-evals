+# Ownership edges in the release-2 schema (including associations without DB
+# constraints). Never infer a polymorphic owner from the numeric ID alone.
+module CitizenProposalDependencies
+  RETIRED = %w[Proposal ProposalNotification Proposal::Translation Dashboard::Action
+               Dashboard::ExecutedAction Dashboard::AdministratorTask].freeze
+  POLYMORPHIC = {
+    activities: %w[actionable],
+    active_storage_attachments: %w[record],
+    audits: %w[auditable associated user],
+    comments: %w[commentable],
+    documents: %w[documentable],
+    flags: %w[flaggable],
+    follows: %w[followable],
+    images: %w[imageable],
+    links: %w[linkable],
+    milestones: %w[milestoneable],
+    ml_summary_comments: %w[commentable],
+    notifications: %w[notifiable],
+    polls: %w[related],
+    progress_bars: %w[progressable],
+    related_contents: %w[parent_relationable child_relationable],
+    remote_translations: %w[remote_translatable],
+    reports: %w[process],
+    sdg_relations: %w[relatable related_sdg],
+    sdg_reviews: %w[relatable],
+    signature_sheets: %w[signable],
+    taggings: %w[taggable tagger],
+    votation_types: %w[questionable],
+    votes: %w[votable voter],
+    widget_cards: %w[cardable]
+  }.freeze
+
+  # Child first: also the delete order for foreign keys. No CASCADE or callbacks.
+  CHILDREN = {
+    poll_answers: { question_id: :poll_questions, option_id: :poll_question_answers },
+    poll_partial_results: { question_id: :poll_questions,
+                            option_id: :poll_question_answers,
+                            officer_assignment_id: :poll_officer_assignments,
+                            booth_assignment_id: :poll_booth_assignments },
+    poll_recounts: { officer_assignment_id: :poll_officer_assignments,
+                     booth_assignment_id: :poll_booth_assignments },
+    poll_voters: { poll_id: :polls,
+                   officer_assignment_id: :poll_officer_assignments,
+                   booth_assignment_id: :poll_booth_assignments },
+    poll_ballots: { ballot_sheet_id: :poll_ballot_sheets },
+    poll_ballot_sheets: { poll_id: :polls, officer_assignment_id: :poll_officer_assignments },
+    poll_officer_assignments: { booth_assignment_id: :poll_booth_assignments },
+    poll_booth_assignments: { poll_id: :polls },
+    geozones_polls: { poll_id: :polls },
+    poll_question_answer_videos: { answer_id: :poll_question_answers },
+    poll_question_answer_translations: { poll_question_answer_id: :poll_question_answers },
+    poll_question_answers: { question_id: :poll_questions },
+    poll_question_translations: { poll_question_id: :poll_questions },
+    poll_questions: { poll_id: :polls },
+    poll_translations: { poll_id: :polls },
+    topics: { community_id: :communities },
+    comment_translations: { comment_id: :comments },
+    related_content_scores: { related_content_id: :related_contents },
+    related_contents: { related_content_id: :related_contents },
+    signatures: { signature_sheet_id: :signature_sheets },
+    milestone_translations: { milestone_id: :milestones },
+    progress_bar_translations: { progress_bar_id: :progress_bars },
+    banner_sections: { web_section_id: :web_sections },
+    widget_card_translations: { widget_card_id: :widget_cards },
+    i18n_content_translations: { i18n_content_id: :i18n_contents }
+  }.freeze
+
+  TYPES = {
+    active_storage_attachments: "ActiveStorage::Attachment",
+    audits: "Audited::Audit",
+    banner_sections: "Banner::Section",
+    comment_translations: "Comment::Translation",
+    i18n_content_translations: "I18nContent::Translation",
+    milestone_translations: "Milestone::Translation",
+    poll_answers: "Poll::Answer",
+    poll_ballots: "Poll::Ballot",
+    poll_ballot_sheets: "Poll::BallotSheet",
+    poll_booth_assignments: "Poll::BoothAssignment",
+    poll_officer_assignments: "Poll::OfficerAssignment",
+    poll_partial_results: "Poll::PartialResult",
+    poll_questions: "Poll::Question",
+    poll_question_answers: "Poll::Question::Option",
+    poll_question_answer_videos: "Poll::Question::Option::Video",
+    poll_question_answer_translations: "Poll::Question::Option::Translation",
+    poll_question_translations: "Poll::Question::Translation",
+    poll_recounts: "Poll::Recount",
+    poll_translations: "Poll::Translation",
+    poll_voters: "Poll::Voter",
+    progress_bar_translations: "ProgressBar::Translation",
+    sdg_relations: "SDG::Relation",
+    sdg_reviews: "SDG::Review",
+    taggings: "ActsAsTaggableOn::Tagging",
+    votes: "ActsAsVotable::Vote",
+    widget_cards: "Widget::Card",
+    widget_card_translations: "Widget::Card::Translation",
+    widget_feeds: "Widget::Feed"
+  }.freeze
+
+  OBSOLETE_SETTINGS = %w[feature.featured_proposals feature.user.recommendations_on_proposals
+                         homepage.widgets.feeds.proposals process.proposals sdg.process.proposals
+                         proposals.successful_proposal_id proposals.poll_short_title
+                         proposals.poll_description
+                         proposals.poll_link proposals.email_short_title proposals.email_description
+                         proposals.poster_short_title proposals.poster_description
+                         months_to_archive_proposals
+                         proposal_notification_minimum_interval_in_days featured_proposals_number
+                         feature.dashboard.notification_emails].freeze
+end
