@@ -0,0 +1,11 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest shows the short date" do
+    books(:handbook).update!(published: true, updated_at: Time.zone.local(2025, 2, 3))
+
+    mail = ReportDigestMailer.weekly(users(:david))
+
+    assert_includes mail.body.decoded.lines.map(&:chomp), "* Handbook, last edited 03 Feb"
+  end
+end
