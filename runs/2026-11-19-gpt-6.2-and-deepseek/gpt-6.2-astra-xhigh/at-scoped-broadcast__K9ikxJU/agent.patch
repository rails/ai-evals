diff --git a/app/jobs/leaf/broadcast_being_edited_job.rb b/app/jobs/leaf/broadcast_being_edited_job.rb
new file mode 100644
index 0000000..c26cfeb
--- /dev/null
+++ b/app/jobs/leaf/broadcast_being_edited_job.rb
@@ -0,0 +1,15 @@
+class Leaf::BroadcastBeingEditedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(leaf, user)
+    return unless leaf.active?
+
+    content = ApplicationController.render partial: "leaves/being_edited_by",
+      formats: [ :turbo_stream ], locals: { leaf: leaf, user: user }
+
+    # Choose recipients here, since edit access can change while the broadcast is queued.
+    leaf.book.editors.where.not(id: user.id).find_each do |recipient|
+      Turbo::StreamsChannel.broadcast_stream_to leaf, :being_edited, recipient, content: content
+    end
+  end
+end
