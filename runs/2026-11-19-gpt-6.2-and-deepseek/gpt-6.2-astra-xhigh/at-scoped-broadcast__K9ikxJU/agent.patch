+  test "being edited indicator only goes to editors who still have access at broadcast time" do
+    leaf = leaves(:welcome_page)
+    removed_editor_stream = editing_stream_for(leaf)
+    sign_in :david
+    remaining_editor_stream = editing_stream_for(leaf)
+    other_page_stream = editing_stream_for(leaves(:summary_page))
+
+    sign_in :jason
+    put leafable_path(leaf), params: { page: { body: "Updated welcome" } }
+    assert_response :no_content
+
+    patch book_path(leaf.book), params: { book: { everyone_access: false }, editor_ids: [ users(:david).id ] }
+    assert_redirected_to book_slug_path(leaf.book)
+
+    messages = capture_broadcasts(remaining_editor_stream) { perform_enqueued_jobs }
+
+    assert_no_broadcasts removed_editor_stream
+    assert_no_broadcasts other_page_stream
+    assert_no_broadcasts "#{leaf.to_gid_param}:being_edited"
+    assert_select Nokogiri::HTML.fragment(messages.sole), "turbo-stream[action=append][target=?]", dom_id(leaf, :being_edited) do
+      assert_select "strong", text: users(:jason).name
+    end
+  end
+
   private
+    def editing_stream_for(leaf)
+      get edit_leafable_path(leaf)
+      assert_response :ok
+      source = assert_select("turbo-cable-stream-source[signed-stream-name]", count: 1).first
+      Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    end
+
     def sample_page_leaf(markdown)
