+require "test_helper"
+
+class EmailCodeAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "sign in with the code from the email subject" do
+    identity = identities(:kevin)
+
+    untenanted do
+      code = emailed_code(identity.email_address) do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      assert_not cookies[:session_token].present?
+
+      follow_redirect!
+      assert_select "form[action=?] input[name=code]", session_magic_link_path
+
+      assert_difference -> { identity.sessions.count }, 1 do
+        post session_magic_link_path, params: { code: code }
+      end
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "sign up and complete the new account" do
+    untenanted do
+      code = emailed_code("new@example.com") do
+        post signup_path, params: { signup: { email_address: " New@Example.com " } }
+      end
+      assert_redirected_to new_session_magic_link_path
+      assert_not Identity.exists?(email_address: "new@example.com")
+
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to new_signup_completion_path
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+      owner = Identity.find_by!(email_address: "new@example.com").users.sole
+      assert owner.owner?
+      assert_equal "New Person", owner.name
+      assert_redirected_to landing_path(script_name: owner.account.slug)
+    end
+  end
+
+  test "join by email and finish setting up the membership" do
+    invite = account_join_codes(:"37s")
+    account = invite.account
+    code = emailed_code("member@example.com") do
+      assert_no_difference -> { invite.reload.usage_count } do
+        post join_path(code: invite.code, script_name: account.slug), params: { email_address: "member@example.com" }
+      end
+    end
+    assert_not Identity.exists?(email_address: "member@example.com")
+
+    untenanted do
+      assert_redirected_to new_session_magic_link_path
+      assert_difference -> { invite.reload.usage_count }, 1 do
+        post session_magic_link_path, params: { code: code }
+      end
+    end
+    assert_redirected_to new_users_verification_path(script_name: account.slug)
+    post users_verifications_path(script_name: account.slug)
+    assert_redirected_to new_users_join_path(script_name: account.slug)
+    post users_joins_path(script_name: account.slug), params: { user: { name: "New Member" } }
+    assert_redirected_to landing_path(script_name: account.slug)
+    member = Identity.find_by!(email_address: "member@example.com").users.sole
+    assert_equal account, member.account
+    assert_equal "New Member", member.name
+    assert member.verified?
+  end
+
+  test "an invitation reset while the recipient checks their email cannot be redeemed" do
+    invite = account_join_codes(:"37s")
+    code = emailed_code("member@example.com") do
+      post join_path(code: invite.code, script_name: invite.account.slug), params: { email_address: "member@example.com" }
+    end
+    invite.reset
+    untenanted do
+      assert_no_difference [ -> { Session.count }, -> { User.count }, -> { invite.reload.usage_count } ] do
+        post session_magic_link_path, params: { code: code }
+      end
+      assert_response :not_found
+    end
+  end
+
+  test "an exhausted invitation cannot create an identity or membership" do
+    invite = account_join_codes(:"37s")
+    code = emailed_code("member@example.com") do
+      post join_path(code: invite.code, script_name: invite.account.slug), params: { email_address: "member@example.com" }
+    end
+    invite.update!(usage_limit: invite.usage_count)
+    untenanted do
+      assert_no_difference [ -> { Identity.count }, -> { User.count }, -> { Session.count } ] do
+        post session_magic_link_path, params: { code: code }
+      end
+      assert_response :gone
+    end
+  end
+
+  test "unknown sign-in emails get the same prompt but no code or identity" do
+    untenanted do
+      assert_no_difference [ -> { Identity.count }, -> { ActionMailer::Base.deliveries.size } ] do
+        perform_enqueued_jobs { post session_path, params: { email_address: "unknown@example.com" } }
+      end
+      assert_redirected_to new_session_magic_link_path
+      follow_redirect!
+      assert_select "input[name=code]"
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "incorrect codes can be retried, and a code can only be used once" do
+    identity = identities(:kevin)
+    untenanted do
+      code = emailed_code(identity.email_address) do
+        post session_path, params: { email_address: identity.email_address }, as: :json
+      end
+      assert_response :created
+      token = response.parsed_body.fetch("pending_authentication_token")
+      assert_equal cookies[:pending_authentication_token], token
+      post session_magic_link_path, params: { code: "000000" }, as: :json
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+
+      travel 14.minutes do
+        post session_magic_link_path, params: { code: code.downcase }, as: :json
+        assert_response :success
+        assert_equal cookies[:session_token], response.parsed_body.fetch("session_token")
+      end
+
+      sign_out
+      cookies[:pending_authentication_token] = token
+      post session_magic_link_path, params: { code: code }, as: :json
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "the code and pending authentication token must match" do
+    identity = identities(:kevin)
+    untenanted do
+      code = emailed_code(identity.email_address) do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      post session_path, params: { email_address: identities(:david).email_address }
+      post session_magic_link_path, params: { code: code }
+      assert_response :unprocessable_entity
+      assert_select "input[name=code]"
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "codes expire after fifteen minutes" do
+    identity = identities(:kevin)
+    freeze_time do
+      untenanted do
+        code = emailed_code(identity.email_address) do
+          post session_path, params: { email_address: identity.email_address }
+        end
+        token = cookies[:pending_authentication_token]
+        travel 15.minutes
+        cookies[:pending_authentication_token] = token
+        post session_magic_link_path, params: { code: code }, as: :json
+        assert_response :unauthorized
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  private
+    def emailed_code(recipient, &block)
+      email = capture_emails(&block).sole
+      assert_equal [ recipient ], email.to
+      assert_match(/\b[A-Z0-9]{6}\b/, email.subject)
+      email.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
