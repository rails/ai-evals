diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..3ceafc5
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,87 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create
+  before_action :set_email_code
+  rate_limit to: 10, within: EmailCode::LIFETIME, only: :create,
+    name: "per-code", by: -> { @email_code.id }, if: -> { @email_code.present? }
+
+  layout "public"
+
+  def new
+    redirect_to new_session_path, alert: "Request a new sign-in code." unless @email_code
+  end
+
+  def create
+    if @email_code&.consume(params.permit(:code)[:code])
+      cookies.delete(:pending_authentication_token)
+
+      case @email_code.purpose
+      when "sign_in" then complete_sign_in
+      when "sign_up" then complete_signup
+      when "join"    then complete_join
+      end
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def set_email_code
+      @email_code = EmailCode.find_signed(cookies[:pending_authentication_token], purpose: :authentication)
+    end
+
+    def complete_sign_in
+      if identity = Identity.find_by(email_address: @email_code.email_address)
+        sign_in identity, after_authentication_url
+      else
+        invalid_code
+      end
+    end
+
+    def complete_signup
+      if Account.accepting_signups?
+        identity = Signup.new(email_address: @email_code.email_address).create_identity
+        sign_in identity, new_signup_completion_url
+      else
+        redirect_to new_session_path
+      end
+    end
+
+    def complete_join
+      @join_code = Account::JoinCode.find_by(account_id: @email_code.account_id, code: @email_code.join_code)
+      if @join_code.nil?
+        head :not_found
+      elsif user = @join_code.redeem_for(@email_code.email_address)
+        sign_in user.identity, after_join_url(user)
+      else
+        respond_to do |format|
+          format.html { render "join_codes/inactive", status: :gone }
+          format.json { head :gone }
+        end
+      end
+    end
+
+    def sign_in(identity, location)
+      start_new_session_for identity
+      respond_to do |format|
+        format.html { redirect_to location }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_code
+      message = "That code is incorrect or has expired."
+      respond_to do |format|
+        format.html do
+          if @email_code
+            flash.now[:alert] = message
+            render :new, status: :unprocessable_entity
+          else
+            redirect_to new_session_path, alert: message
+          end
+        end
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+end
