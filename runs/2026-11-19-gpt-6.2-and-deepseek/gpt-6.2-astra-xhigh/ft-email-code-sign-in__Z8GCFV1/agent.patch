diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..2275d7c
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,39 @@
+class EmailCode < ApplicationRecord
+  LENGTH = 6
+  LIFETIME = 15.minutes
+  ALPHABET = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ".chars.freeze
+
+  belongs_to :account, optional: true
+  has_secure_password :code, validations: false, reset_token: false
+
+  enum :purpose, %w[ sign_in sign_up join ].index_by(&:itself), scopes: false
+  normalizes :email_address, with: ->(address) { Identity.normalize_value_for(:email_address, address) }
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }, length: { maximum: 255 }
+
+  before_create :generate_code
+  after_create_commit :deliver_code, if: :deliverable?
+
+  def self.cleanup
+    where(created_at: ..LIFETIME.ago).delete_all
+  end
+
+  def consume(submitted_code)
+    candidate = submitted_code.to_s.strip.upcase
+    if candidate.match?(/\A[A-Z0-9]{#{LENGTH}}\z/) && authenticate_code(candidate)
+      self.class.where(id: id).where("created_at > ?", LIFETIME.ago).delete_all == 1
+    end
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(LENGTH, chars: ALPHABET)
+    end
+
+    def deliverable?
+      !sign_in? || Identity.exists?(email_address: email_address)
+    end
+
+    def deliver_code
+      IdentityMailer.sign_in_code(email_address, code).deliver_later
+    end
+end
