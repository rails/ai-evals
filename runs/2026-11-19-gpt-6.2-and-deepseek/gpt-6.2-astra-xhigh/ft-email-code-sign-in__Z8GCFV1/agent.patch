--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,20 @@
+module EmailCodeAuthentication
+  private
+
+  def request_email_code(email_address, purpose:, join_code: nil)
+    email_code = EmailCode.new(email_address: email_address, purpose: purpose)
+    email_code.assign_attributes(account: join_code.account, join_code: join_code.code) if join_code
+
+    if email_code.save
+      token = email_code.signed_id(expires_in: EmailCode::LIFETIME, purpose: :authentication)
+      cookies[:pending_authentication_token] = { value: token, expires: EmailCode::LIFETIME.from_now, httponly: true, same_site: :lax }
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil) }
+        format.json { render json: { pending_authentication_token: token }, status: :created }
+      end
+    else
+      head :unprocessable_entity
+    end
+  end
+end
