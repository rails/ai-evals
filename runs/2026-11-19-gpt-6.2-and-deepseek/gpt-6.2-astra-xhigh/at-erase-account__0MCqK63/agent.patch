diff --git a/app/models/user/sign_in_history.rb b/app/models/user/sign_in_history.rb
new file mode 100644
index 0000000..82bb465
--- /dev/null
+++ b/app/models/user/sign_in_history.rb
@@ -0,0 +1,24 @@
+module User::SignInHistory
+  extend ActiveSupport::Concern
+
+  # The old Remove action inserted this suffix immediately before the @.
+  DEACTIVATION_SUFFIX = /-deactivated-\h{8}-(?:\h{4}-){3}\h{12}(?=@)/
+
+  included do
+    has_many :sign_in_events, dependent: :delete_all
+    before_destroy :erase_legacy_sign_in_events
+  end
+
+  private
+    def erase_legacy_sign_in_events
+      legacy_events = SignInEvent.where(user_id: nil, created_at: created_at..)
+      legacy_events.for_address(email_address).delete_all
+
+      if !active? && email_address.match?(DEACTIVATION_SUFFIX)
+        original_address = email_address.gsub(DEACTIVATION_SUFFIX, "")
+        events = legacy_events.for_address(original_address)
+        events = events.where(created_at: ..updated_at) if User.exists?(email_address: original_address)
+        events.delete_all
+      end
+    end
+end
