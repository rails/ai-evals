--- /dev/null
+++ b/db/migrate/20241106000000_add_user_to_sign_in_events.rb
@@ -0,0 +1,26 @@
+class AddUserToSignInEvents < ActiveRecord::Migration[8.0]
+  class LegacyEvent < ActiveRecord::Base
+    self.table_name = "sign_in_events"
+  end
+
+  def up
+    add_reference :sign_in_events, :user, foreign_key: true
+
+    # Attribute released addresses first: their current holder may be someone else.
+    select_all("SELECT id, email_address, created_at, updated_at FROM users WHERE active = 0 ORDER BY updated_at").each do |user|
+      original = user["email_address"].gsub(/-deactivated-\h{8}-(?:\h{4}-){3}\h{12}(?=@)/, "")
+      LegacyEvent.where(user_id: nil, email_address: original, created_at: user["created_at"]..user["updated_at"])
+        .update_all(user_id: user["id"])
+    end
+
+    execute <<~SQL
+      UPDATE sign_in_events SET user_id = users.id FROM users
+      WHERE sign_in_events.user_id IS NULL AND users.email_address = sign_in_events.email_address
+        AND sign_in_events.created_at >= users.created_at
+    SQL
+  end
+
+  def down
+    remove_reference :sign_in_events, :user, foreign_key: true
+  end
+end
