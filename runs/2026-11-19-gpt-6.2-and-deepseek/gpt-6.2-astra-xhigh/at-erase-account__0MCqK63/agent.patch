@@ -0,0 +1,52 @@
+require "test_helper"
+
+class User::SignInHistoryTest < ActiveSupport::TestCase
+  test "sign-in events follow the user across email changes, not the current address holder" do
+    user = users(:kevin)
+    session = user.sessions.start!(user_agent: "browser", ip_address: "127.0.0.1")
+    session.destroy!
+    original = user.email_address
+    user.update!(email_address: "new@example.com")
+    replacement = users(:jz)
+    replacement.update!(email_address: original)
+    replacement.sessions.start!(user_agent: "browser", ip_address: "127.0.0.1")
+
+    user.destroy!
+
+    assert_equal [ replacement.id ], SignInEvent.for_address(original).pluck(:user_id)
+  end
+
+  test "erasing a deactivated user does not erase a later holder's events under the released address" do
+    user = users(:kevin)
+    address = user.email_address
+    original_event = SignInEvent.create!(email_address: address, action: :signed_in)
+    user.update!(active: false, email_address: address.sub("@", "-deactivated-#{SecureRandom.uuid}@"))
+
+    travel 1.day
+    replacement = users(:jz)
+    replacement.update!(email_address: address)
+    # Pre-upgrade events had no user_id; new events do.
+    later_event = SignInEvent.create!(email_address: address, action: :signed_in)
+    replacement.sessions.start!(user_agent: "browser", ip_address: "127.0.0.1")
+
+    user.destroy!
+
+    assert_not SignInEvent.exists?(original_event.id)
+    assert SignInEvent.exists?(later_event.id)
+    assert replacement.sign_in_events.exists?
+  end
+
+  test "a deactivation-like suffix in an active user's real address is not stripped" do
+    user = users(:kevin)
+    other_address = users(:jason).email_address
+    real_address = other_address.sub("@", "-deactivated-#{SecureRandom.uuid}@")
+    other = SignInEvent.create!(email_address: other_address, action: :signed_in)
+    user.update!(email_address: real_address)
+    event = SignInEvent.create!(email_address: real_address, action: :signed_in)
+
+    user.destroy!
+
+    assert_not SignInEvent.exists?(event.id)
+    assert SignInEvent.exists?(other.id)
+  end
+end
