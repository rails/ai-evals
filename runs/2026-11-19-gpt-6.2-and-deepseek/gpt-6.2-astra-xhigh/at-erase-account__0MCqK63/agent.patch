diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..3624bff
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @user = users(:kevin)
+  end
+
+  test "everyone books keep their contents, search index and other readers, but lose their attribution" do
+    book = books(:handbook)
+    book.update!(creator: @user, author: @user.name)
+    leaf = leaves(:welcome_page)
+    leaf.reindex
+    ReadingMark.remember(leaf, user: @user)
+    reader = users(:jz)
+    mark = ReadingMark.remember(leaf, user: reader)
+    unrelated_book = books(:manual)
+    unrelated_book.update!(author: @user.name, creator: reader)
+
+    Current.set(user: users(:david)) do
+      @user.destroy!
+      assert_nil book.reload.creator_id
+      assert_equal "Deleted author", book.author
+      book.update!(subtitle: "Still in print")
+      assert_nil book.reload.creator_id
+    end
+
+    assert book.accessable?(user: reader)
+    assert_includes Leaf.search("great handbook"), leaf
+    assert ReadingMark.exists?(mark.id)
+    assert_not ReadingMark.exists?(user_id: @user.id)
+    assert_equal reader, unrelated_book.reload.creator
+    assert_equal @user.name, unrelated_book.author
+  end
+
+  test "non-everyone books are completely removed, including trashed leaves and old versions" do
+    book = books(:handbook)
+    book.update!(creator: @user, everyone_access: false, published: true)
+    leaf = leaves(:welcome_page)
+    old_page = leaf.page
+    upload = old_page.body.uploads.attach(io: StringIO.new("private contents"), filename: "private.txt").first.blob
+    leaf.edit(leafable_params: { body: "Revised private contents" })
+    leaf.trashed!
+    leaf.reindex
+    mark = ReadingMark.remember(leaf, user: users(:david))
+    section_id = sections(:welcome).id
+    picture = pictures(:reading)
+    books(:manual).cover.attach(picture.image.blob)
+    leaf_ids = book.leaves.ids
+    page_ids = [ old_page.id, leaf.page.id, pages(:summary).id ]
+    assert index_contains?(leaf.id)
+
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) { @user.destroy! }
+
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+    assert_not Leaf.exists?(id: leaf_ids)
+    assert_not Edit.exists?(leaf_id: leaf_ids)
+    assert_not Page.exists?(id: page_ids)
+    assert_not ActionText::Markdown.exists?(record_type: "Page", record_id: page_ids)
+    assert_not Section.exists?(section_id)
+    assert_not Picture.exists?(picture.id)
+    assert_not ReadingMark.exists?(mark.id)
+    assert_not ActiveStorage::Attachment.exists?(record: picture)
+    assert books(:manual).reload.cover.download.present?
+    assert_not ActiveStorage::Blob.exists?(upload.id)
+    assert_not upload.service.exist?(upload.key)
+    assert_not index_contains?(leaf.id)
+    leaf.reindex # A stale instance must not recreate an orphaned search entry.
+    assert_not index_contains?(leaf.id)
+  end
+
+  test "erasure rolls back with its dependent rows and search entries" do
+    book = books(:handbook)
+    book.update!(creator: @user, everyone_access: false)
+    leaf = leaves(:welcome_page)
+    leaf.reindex
+
+    User.transaction(requires_new: true) do
+      @user.destroy!
+      assert_not index_contains?(leaf.id)
+      raise ActiveRecord::Rollback
+    end
+
+    assert User.exists?(@user.id)
+    assert_equal @user, book.reload.creator
+    assert index_contains?(leaf.id)
+  end
+
+  private
+    def index_contains?(leaf_id)
+      Leaf.connection.select_value(Leaf.sanitize_sql([ "SELECT 1 FROM leaf_search_index WHERE rowid = ?", leaf_id ]))
+    end
+end
