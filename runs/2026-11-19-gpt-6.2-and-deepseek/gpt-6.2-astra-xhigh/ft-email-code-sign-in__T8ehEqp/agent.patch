diff --git a/test/integration/email_authentication_test.rb b/test/integration/email_authentication_test.rb
new file mode 100644
index 0000000..7ea4e2c
--- /dev/null
+++ b/test/integration/email_authentication_test.rb
@@ -0,0 +1,195 @@
+require "test_helper"
+
+class EmailAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "sign in with the code from the email subject" do
+    identity = identities(:kevin)
+
+    untenanted do
+      code = emailed_code(identity.email_address) do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      assert_nil cookies[:session_token]
+
+      follow_redirect!
+      assert_response :success
+      assert_select "form input[name=code][autocomplete=one-time-code]"
+
+      assert_difference -> { identity.sessions.count }, 1 do
+        post session_magic_link_path, params: { code: code }
+      end
+      assert_redirected_to landing_url
+      assert_predicate cookies[:session_token], :present?
+    end
+  end
+
+  test "sign up and complete the account after confirming the email address" do
+    untenanted do
+      code = emailed_code("new@example.com") do
+        post signup_path, params: { signup: { email_address: " New@Example.com " } }
+      end
+      assert_redirected_to new_session_magic_link_path
+      assert_not Identity.exists?(email_address: "new@example.com")
+      assert_nil cookies[:session_token]
+
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to new_signup_completion_path
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+      owner = Identity.find_by!(email_address: "new@example.com").users.sole
+      assert_predicate owner, :owner?
+      assert_redirected_to landing_url(script_name: owner.account.slug)
+    end
+  end
+
+  test "join with an email code before completing the new member's profile" do
+    invite = account_join_codes(:"37s")
+    email = "new-member@example.com"
+    code = emailed_code(email) do
+      post join_path(code: invite.code), params: { email_address: email }
+    end
+    assert_redirected_to new_session_magic_link_path
+    assert_nil cookies[:session_token]
+    assert_not Identity.exists?(email_address: email)
+    assert_equal 0, invite.reload.usage_count
+
+    post session_magic_link_path(script_name: accounts(:initech).slug), params: { code: code }, as: :json
+    assert_response :unauthorized
+    assert_nil cookies[:session_token]
+
+    post session_magic_link_path, params: { code: code }
+    assert_redirected_to new_users_verification_path
+    assert_equal 1, invite.reload.usage_count
+
+    post users_verifications_path
+    assert_redirected_to new_users_join_path
+    post users_joins_path, params: { user: { name: "New Member" } }
+    assert_redirected_to landing_path
+    member = Identity.find_by!(email_address: email).users.sole
+    assert_equal invite.account, member.account
+    assert_equal "New Member", member.name
+    assert_predicate member, :verified?
+  end
+
+  test "returning members don't use up another join code" do
+    invite = account_join_codes(:"37s")
+    identity = identities(:jz)
+    code = emailed_code(identity.email_address) do
+      post join_path(code: invite.code), params: { email_address: identity.email_address }
+    end
+    assert_no_difference [ "User.count", "invite.reload.usage_count" ] do
+      post session_magic_link_path, params: { code: code }
+    end
+    assert_redirected_to landing_path
+  end
+
+  test "a reset invitation cannot be redeemed by a pending request" do
+    invite = account_join_codes(:"37s")
+    code = emailed_code("new@example.com") do
+      post join_path(code: invite.code), params: { email_address: "new@example.com" }
+    end
+    invite.reset
+    assert_no_difference [ "User.count", "invite.reload.usage_count" ] do
+      post session_magic_link_path, params: { code: code }
+    end
+    assert_response :gone
+    assert_nil cookies[:session_token]
+  end
+
+  test "an exhausted join code cannot be redeemed after email verification" do
+    invite = account_join_codes(:"37s")
+    code = emailed_code("new@example.com") do
+      post join_path(code: invite.code), params: { email_address: "new@example.com" }
+    end
+    invite.update!(usage_limit: 0)
+    assert_no_difference [ "User.count", "Identity.count", "invite.reload.usage_count" ] do
+      post session_magic_link_path, params: { code: code }
+    end
+    assert_response :gone
+    assert_nil cookies[:session_token]
+  end
+
+  test "a code requires its pending token and can be used only once" do
+    identity = identities(:kevin)
+    untenanted do
+      code = emailed_code(identity.email_address) do
+        post session_path, params: { email_address: identity.email_address }, as: :json
+      end
+      assert_response :created
+      pending_token = response.parsed_body.fetch("pending_authentication_token")
+      assert_equal cookies[:pending_authentication_token], pending_token
+
+      cookies.delete("pending_authentication_token")
+      post session_magic_link_path, params: { code: code }, as: :json
+      assert_response :unauthorized
+      assert_nil cookies[:session_token]
+
+      cookies[:pending_authentication_token] = pending_token
+      post session_magic_link_path, params: { code: "wrong" }, as: :json
+      assert_response :unauthorized
+      assert_nil cookies[:session_token]
+
+      post session_magic_link_path, params: { code: code.downcase }, as: :json
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body.fetch("session_token")
+      assert_predicate cookies[:pending_authentication_token], :blank?
+
+      cookies.delete("session_token")
+      cookies[:pending_authentication_token] = pending_token
+      post session_magic_link_path, params: { code: code }, as: :json
+      assert_response :unauthorized
+      assert_nil cookies[:session_token]
+    end
+  end
+
+  test "a code expires after fifteen minutes" do
+    identity = identities(:kevin)
+    untenanted do
+      freeze_time do
+        code = emailed_code(identity.email_address) do
+          post session_path, params: { email_address: identity.email_address }
+        end
+        travel 15.minutes
+        post session_magic_link_path, params: { code: code }, as: :json
+        assert_response :unauthorized
+        assert_nil cookies[:session_token]
+      end
+    end
+  end
+
+  test "too many code attempts are rate limited" do
+    identity = identities(:kevin)
+    untenanted do
+      code = emailed_code(identity.email_address) do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      Rails.cache.stubs(:increment).returns(11)
+      post session_magic_link_path, params: { code: code }, as: :json
+      assert_response :too_many_requests
+      assert_nil cookies[:session_token]
+    end
+  end
+
+  test "signing in with an unknown address does not create an identity or disclose whether it exists" do
+    untenanted do
+      assert_no_emails do
+        post session_path, params: { email_address: "unknown@example.com" }
+      end
+      assert_redirected_to new_session_magic_link_path
+      follow_redirect!
+      assert_select "input[name=code]"
+      assert_not Identity.exists?(email_address: "unknown@example.com")
+      assert_nil cookies[:session_token]
+    end
+  end
+
+  private
+    def emailed_code(address, &request_code)
+      mail, = capture_emails(&request_code)
+      assert_not_nil mail, "Expected a code by email"
+      assert_equal [ address ], mail.to
+      mail.subject[/\b[A-Z0-9]{6}\b/].tap { |code| assert_not_nil code, "Expected a six-character code in the subject" }
+    end
+end
