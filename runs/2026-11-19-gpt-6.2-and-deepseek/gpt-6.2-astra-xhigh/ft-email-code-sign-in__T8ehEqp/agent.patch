+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "codes are valid until fifteen minutes after issue, even if cleanup hasn't run" do
+    freeze_time do
+      first, second = Array.new(2) { MagicLink.create!(email_address: "person@example.com", purpose: :sign_in) }
+      travel 15.minutes - 1.second
+      assert first.consume(first.code)
+
+      travel 1.second
+      assert_not second.consume(second.code)
+      assert_difference -> { MagicLink.count }, -1 do
+        MagicLink.cleanup
+      end
+    end
+  end
+end
