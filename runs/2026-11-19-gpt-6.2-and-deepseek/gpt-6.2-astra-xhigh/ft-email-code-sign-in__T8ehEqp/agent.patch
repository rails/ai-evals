diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..8467fb2
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,71 @@
+class Sessions::MagicLinksController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, name: "ip"
+  before_action :set_magic_link
+  rate_limit to: 10, within: MagicLink::LIFETIME, only: :create, by: -> { @magic_link.email_address }, name: "email"
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if @magic_link.consume(params.permit(:code)[:code])
+      cookies.delete(:pending_authentication_token)
+      complete_authentication
+    else
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: "That code didn’t work. Please try again." }
+        format.json { head :unauthorized }
+      end
+    end
+  end
+
+  private
+    def set_magic_link
+      @magic_link = MagicLink.active.find_by(id: cookies.signed[:pending_authentication_token], account_id: Current.account&.id)
+
+      unless @magic_link
+        respond_to do |format|
+          format.html { redirect_to new_session_path(script_name: nil), alert: "Please request a new sign-in code." }
+          format.json { head :unauthorized }
+        end
+      end
+    end
+
+    def complete_authentication
+      if @magic_link.join?
+        complete_join
+      elsif @magic_link.sign_up? && !Account.accepting_signups?
+        head :forbidden
+      elsif identity = @magic_link.identify
+        sign_in(identity) { @magic_link.sign_up? ? new_signup_completion_path : after_authentication_url }
+      else
+        head :unauthorized
+      end
+    end
+
+    def complete_join
+      join_code = Account::JoinCode.active.find_by(account: Current.account, code: @magic_link.join_code)
+
+      if join_code && (user = join_code.redeem_for(@magic_link.identify))
+        sign_in(user.identity) { after_join_url(user) }
+      else
+        respond_to do |format|
+          format.html { render "join_codes/inactive", status: :gone }
+          format.json { head :gone }
+        end
+      end
+    end
+
+    def sign_in(identity)
+      terminate_session if Current.session
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to yield }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+end
