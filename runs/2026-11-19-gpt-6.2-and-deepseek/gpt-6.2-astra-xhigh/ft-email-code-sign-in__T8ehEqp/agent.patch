diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..ed75e12
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,37 @@
+class MagicLink < ApplicationRecord
+  LIFETIME = 15.minutes
+
+  enum :purpose, %w[ sign_in sign_up join ].index_by(&:itself), scopes: false
+  normalizes :email_address, with: ->(address) { Identity.normalize_value_for(:email_address, address) }
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }, length: { maximum: 255 }
+
+  scope :active, -> { where("created_at > ?", LIFETIME.ago) }
+
+  def self.cleanup
+    where(created_at: ..LIFETIME.ago).delete_all
+  end
+
+  def deliverable?
+    !sign_in? || Identity.exists?(email_address: email_address)
+  end
+
+  def code
+    # Derive the code from this challenge’s ID so neither the database nor the mail job needs its plaintext.
+    key = Rails.application.key_generator.generate_key("magic link codes")
+    OpenSSL::HMAC.hexdigest("SHA256", key, id).first(6).upcase
+  end
+
+  def consume(submitted_code)
+    if ActiveSupport::SecurityUtils.secure_compare(code, submitted_code.to_s.strip.upcase)
+      MagicLink.active.where(id: id).delete_all == 1
+    end
+  end
+
+  def identify
+    if sign_in?
+      Identity.find_by(email_address: email_address)
+    else
+      Identity.find_or_create_by!(email_address: email_address)
+    end
+  end
+end
