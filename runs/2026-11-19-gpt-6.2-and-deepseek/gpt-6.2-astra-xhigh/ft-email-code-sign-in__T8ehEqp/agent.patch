new file mode 100644
index 0000000..2e61ac8
--- /dev/null
+++ b/app/controllers/concerns/email_authentication.rb
@@ -0,0 +1,22 @@
+module EmailAuthentication
+  private
+
+  def request_email_code(email_address, purpose:, join_code: nil)
+    magic_link = MagicLink.new(email_address: email_address, purpose: purpose,
+      account_id: join_code&.account_id, join_code: join_code&.code)
+
+    if magic_link.save
+      MagicLinkMailer.sign_in_code(magic_link.id).deliver_later
+      cookies.signed[:pending_authentication_token] = {
+        value: magic_link.id, expires: MagicLink::LIFETIME.from_now, httponly: true, same_site: :lax
+      }
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path }
+        format.json { render json: { pending_authentication_token: cookies[:pending_authentication_token] }, status: :created }
+      end
+    else
+      head :unprocessable_entity
+    end
+  end
+end
