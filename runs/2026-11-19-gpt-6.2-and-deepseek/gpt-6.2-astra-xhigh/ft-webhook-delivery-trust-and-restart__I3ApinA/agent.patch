@@ -10,6 +10,25 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).in_batches.delete_all
+  end
+
+  def deliver
+    return unless claim
+
+    if webhook.subscribed_to?(event) && event.card.board_id == webhook.board_id
+      outbound = Webhook::Request.new(self)
+      update!(request: { headers: outbound.headers.except("X-Webhook-Signature") })
+      finish(outbound.post)
+    else
+      update!(state: :errored, response: { error: "no_longer_subscribed" })
+    end
+  rescue ActionView::Template::Error
+    update!(state: :errored, response: { error: "payload_generation_failed" })
+    raise
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +46,24 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && (200..299).cover?(response[:code])
   end
+
+  private
+    # Commit the claim before contacting the receiver. An ambiguous outcome
+    # (e.g. the worker dying after POST) must never result in a second POST.
+    def claim
+      self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+    end
+
+    def finish(result)
+      webhook.with_lock do
+        update!(state: result[:error] ? :errored : :completed, response: result)
+
+        if webhook.active?
+          tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+          succeeded? ? tracker.reset_streak : tracker.record_failure
+        end
+      end
+    end
 end
diff --git a/app/models/webhook/request.rb b/app/models/webhook/request.rb
new file mode 100644
index 0000000..81a3bc6
--- /dev/null
+++ b/app/models/webhook/request.rb
@@ -0,0 +1,66 @@
+require "net/http"
+
+class Webhook::Request
+  attr_reader :delivery
+
+  delegate :event, :webhook, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def headers
+    @headers ||= {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => webhook.for_campfire? ? "text/html" : "application/json",
+      "Idempotency-Key" => delivery.id,
+      "X-Webhook-Timestamp" => Time.current.utc.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    }
+  end
+
+  def post
+    uri = URI.parse(webhook.url)
+    ip = SsrfProtection.resolve_public_ip(uri.hostname) if uri.is_a?(URI::HTTP) && uri.hostname.present?
+    return { error: "destination_unreachable" } unless ip
+
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+    connection(uri, ip).request(request) do |response|
+      return { code: response.code.to_i } # Don't download the response body or follow redirects.
+    end
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue URI::InvalidURIError, SocketError, Resolv::ResolvError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::ProtocolError
+    { error: "destination_unreachable" }
+  end
+
+  private
+    def connection(uri, ip)
+      # Connect directly to the vetted address, retaining the hostname for TLS.
+      Net::HTTP.new(uri.hostname, uri.port, nil).tap do |http|
+        http.ipaddr = ip
+        http.use_ssl = uri.is_a?(URI::HTTPS)
+        http.open_timeout = http.read_timeout = http.write_timeout = 5
+        http.max_retries = 0
+      end
+    end
+
+    def body
+      @body ||= if webhook.for_slack?
+        { text: render_event(:text).strip }.to_json
+      elsif webhook.for_basecamp?
+        { content: render_event(:html) }.to_json
+      elsif webhook.for_campfire?
+        render_event(:html)
+      else
+        render_event(:json)
+      end
+    end
+
+    def render_event(format)
+      ApplicationController.renderer.new(script_name: event.account.slug).render(
+        template: "webhooks/event", formats: [ format ], assigns: { event: event }, layout: false
+      )
+    end
+end
