diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..b54d6ad
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "title substring search returns only active leaves from readable books" do
+    welcome = leaves(:welcome_page)
+    summary = leaves(:summary_page)
+    summary.update!(book: books(:manual), title: "Welcome to the manual")
+    leaves(:welcome_section).trashed!
+
+    assert_search_results "ELcom", welcome
+
+    books(:manual).update!(published: true)
+    assert_search_results "ELcom", welcome, summary
+
+    sign_out
+    assert_search_results "ELcom", summary
+
+    books(:manual).update!(published: false)
+    assert_search_results "ELcom"
+  end
+
+  test "punctuation in search terms matches literal title characters" do
+    sale = leaves(:welcome_page)
+    sale.update!(title: "Save 50% off")
+    notes = leaves(:summary_page)
+    notes.update!(title: "Reader's_notes!")
+
+    assert_search_results "Save 50% off", sale
+    assert_search_results "%", sale
+    assert_search_results "_", notes
+    assert_search_results "Reader's", notes
+    assert_search_results "!", notes
+  end
+
+  private
+    def assert_search_results(query, *leaves)
+      get library_search_path, params: { q: query }
+      assert_response :success
+      assert_equal leaves.map { |leaf| leafable_slug_path(leaf) }, css_select("a.search__result").map { |link| link["href"] }
+    end
+end
