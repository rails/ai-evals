diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..eff680a
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @owner = users(:jason)
+  end
+
+  test "incinerates accounts only after the full cancellation grace period" do
+    freeze_time
+    @account.cancel(initiated_by: @owner)
+
+    travel 30.days
+    Account::IncinerateDueJob.perform_now
+    assert Account.exists?(@account.id)
+    assert Card.exists?(account_id: @account.id)
+
+    travel 1.second
+    Account::IncinerateDueJob.perform_now
+    assert_not Account.exists?(@account.id)
+    assert_not Account::Cancellation.exists?(account_id: @account.id)
+    assert_not Card.exists?(account_id: @account.id)
+  end
+
+  test "reactivating a due account protects it even if it was already selected for incineration" do
+    travel_to(31.days.ago) { @account.cancel(initiated_by: @owner) }
+    candidate = Account.due_for_incineration.find(@account.id)
+    @account.reactivate
+
+    candidate.incinerate_if_due
+    Account::IncinerateDueJob.perform_now
+
+    assert @account.reload.active?
+    assert Card.exists?(account_id: @account.id)
+  end
+
+  test "deletes tenant data, including uploads, storage accounting and search, without affecting other memberships" do
+    other_account = accounts(:initech)
+    other_membership = other_account.users.create!(identity: @owner.identity, name: @owner.name)
+    card = cards(:logo)
+    other_card = cards(:radio)
+    card.reindex
+    other_card.reindex
+    search_record = Search::Record.for(@account.id).find_by!(searchable: card)
+
+    card.image.attach(io: StringIO.new("attached"), filename: "attachment.txt")
+    unattached = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("unused"), filename: "unused.txt")
+    card.board.materialize_storage
+    @account.materialize_storage
+
+    travel_to(31.days.ago) { @account.cancel(initiated_by: @owner) }
+    Current.without_account { Account::IncinerateDueJob.perform_now }
+    perform_enqueued_jobs only: ActiveStorage::PurgeJob
+
+    [ User, Board, Comment, ActionText::RichText, Export, Event, Filter, Storage::Entry,
+      ActiveStorage::Attachment, ActiveStorage::Blob ].each do |model|
+      assert_not model.exists?(account_id: @account.id), "#{model} data was left behind"
+    end
+    assert_not unattached.service.exist?(unattached.key)
+    assert_not Storage::Total.exists?(owner: @account)
+    assert_not Storage::Total.exists?(owner: card.board)
+    assert_not search_record.class.exists?(search_record.id)
+    if Fizzy.db_adapter.sqlite?
+      assert_not Search::Record::SQLite::Fts.exists?(search_record.id)
+    end
+
+    assert Account.exists?(other_account.id)
+    assert Card.exists?(other_card.id)
+    assert Search::Record.for(other_account.id).exists?(searchable: other_card)
+    assert User.exists?(other_membership.id)
+    assert Identity.exists?(@owner.identity_id)
+  end
+end
