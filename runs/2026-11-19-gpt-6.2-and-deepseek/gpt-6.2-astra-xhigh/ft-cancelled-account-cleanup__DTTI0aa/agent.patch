diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..23316e6 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,45 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  def incinerate_if_due
+    transaction do
+      # Reactivation takes the same account lock. Recheck in case it happened
+      # after the recurring job selected this account.
+      if Account.due_for_incineration.lock.exists?(id)
+        delete_filter_memberships
+        Storage::Total.where(owner: boards).delete_all
+        Search::Record.delete_all_for_account(id)
+        delete_tenant_records
+        ActiveStorage::Blob.unattached.where(account_id: id).find_each(&:purge_later)
+        destroy!
+      end
+    end
+  end
+
+  private
+    def delete_filter_memberships
+      filter_ids = Filter.where(account_id: id).select(:id)
+      %w[ assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags ].each do |table|
+        Filter.connection.delete("DELETE FROM #{table} WHERE filter_id IN (#{filter_ids.to_sql})")
+      end
+    end
+
+    # Delete by tenant rather than walking the entire graph and running callbacks
+    # that broadcast changes, reindex content or write new storage ledger entries.
+    def delete_tenant_records
+      [
+        ActiveStorage::Attachment, ActiveStorage::VariantRecord, ActionText::RichText,
+        Storage::Entry, Search::Query, Push::Subscription, Notification, Notification::Bundle,
+        Webhook::Delivery, Webhook::DelinquencyTracker, Webhook, Event, Mention, Reaction,
+        Watch, Pin, Closure, Card::Goldness, Card::NotNow, Card::ActivitySpike, Tagging,
+        Assignment, Step, Comment, Card, Column, Board::Publication, Access, Entropy,
+        Board, Tag, Filter, Export, Account::Import, User::Settings, User
+      ].each { |model| model.where(account_id: id).delete_all }
+    end
 end
