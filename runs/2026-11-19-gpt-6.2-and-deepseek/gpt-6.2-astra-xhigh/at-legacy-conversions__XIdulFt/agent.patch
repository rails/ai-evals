@@ -0,0 +1,11 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest shows the short date of each book's last edit" do
+    books(:handbook).update! published: true, updated_at: Time.zone.local(2025, 2, 3, 14, 56)
+
+    digest = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_includes digest.body.decoded, "* Handbook, last edited 03 Feb\n"
+  end
+end
