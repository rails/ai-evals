diff --git a/test/integration/being_edited_indicator_test.rb b/test/integration/being_edited_indicator_test.rb
new file mode 100644
index 0000000..9543264
--- /dev/null
+++ b/test/integration/being_edited_indicator_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  test "a page save only notifies viewers who still have edit access" do
+    leaf = leaves(:welcome_page)
+    accesses(:jz_handbook).editor!
+    sign_in :jz
+    removed_stream = indicator_stream(leaf)
+
+    sign_in :kevin
+    editor_stream = indicator_stream(leaf)
+    other_page_stream = indicator_stream(leaves(:summary_page))
+
+    sign_in :david
+    put leafable_path(leaf), params: { leaf: { title: "New title" } }
+    assert_response :no_content
+
+    put book_path(leaf.book), params: { book: { everyone_access: false }, editor_ids: [ users(:kevin).id ] }
+    assert_response :redirect
+    perform_enqueued_jobs
+
+    assert_no_broadcasts removed_stream
+    assert_no_broadcasts other_page_stream
+    assert_no_turbo_stream_broadcasts [ leaf, :being_edited ]
+
+    indicator = capture_turbo_stream_broadcasts(editor_stream).sole
+    assert_equal "append", indicator["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(leaf, :being_edited), indicator["target"]
+    assert_select indicator, "strong", text: users(:david).name
+  end
+
+  private
+    def indicator_stream(leaf)
+      get edit_leafable_path(leaf)
+      assert_response :success
+      source = css_select("turbo-cable-stream-source").sole
+      Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    end
+end
