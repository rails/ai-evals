diff --git a/app/jobs/broadcast_being_edited_indicator_job.rb b/app/jobs/broadcast_being_edited_indicator_job.rb
new file mode 100644
index 0000000..8e3b579
--- /dev/null
+++ b/app/jobs/broadcast_being_edited_indicator_job.rb
@@ -0,0 +1,15 @@
+class BroadcastBeingEditedIndicatorJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(leaf, editor)
+    return unless leaf.active?
+
+    content = ApplicationController.render partial: "leaves/being_edited_by", formats: [ :turbo_stream ],
+      locals: { leaf: leaf, user: editor }
+
+    # Open subscriptions and queued saves can both outlive a viewer's edit access.
+    leaf.book.active_editors.find_each do |recipient|
+      Turbo::StreamsChannel.broadcast_stream_to leaf, :being_edited, recipient, content: content
+    end
+  end
+end
