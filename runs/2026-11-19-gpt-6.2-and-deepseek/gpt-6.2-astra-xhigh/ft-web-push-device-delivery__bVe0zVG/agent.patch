diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..65dae43
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,27 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :ensure_current_user
+
+  def create
+    attributes = subscription_params.merge(session: Current.session, user_agent: request.user_agent&.truncate(4096))
+    subscription = Push::Subscription.register!(Current.user, attributes)
+    render json: { id: subscription.id }, status: :created
+  rescue ActiveRecord::RecordInvalid => error
+    render json: error.record.errors, status: :unprocessable_entity
+  end
+
+  def destroy
+    Current.user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def ensure_current_user
+      head :forbidden unless Current.user.id == params[:user_id]
+    end
+
+    def subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ]).tap do |subscription|
+        subscription.require(%i[ endpoint p256dh_key auth_key ])
+      end
+    end
+end
