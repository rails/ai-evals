diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..9bcef56
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    @params = { endpoint: "https://fcm.googleapis.com/fcm/send/phone", p256dh_key: WebPush.generate_key.public_key, auth_key: SecureRandom.urlsafe_base64(16) }
+    sign_in_as @user
+  end
+
+  test "registers the browser's subscription for the current user" do
+    register
+    assert_response :created
+    subscription = @user.push_subscriptions.find(response.parsed_body.fetch("id"))
+    assert_equal @user.account, subscription.account
+    assert_equal @params.stringify_keys, subscription.attributes.slice(*@params.keys.map(&:to_s))
+  end
+
+  test "registering the same endpoint refreshes its keys without duplicating deliveries" do
+    register
+    id = response.parsed_body.fetch("id")
+    @params[:auth_key] = SecureRandom.urlsafe_base64(16)
+    assert_no_difference "Push::Subscription.count" do
+      register
+      assert_response :created
+      assert_equal id, response.parsed_body.fetch("id")
+    end
+    assert_equal @params[:auth_key], @user.push_subscriptions.find(id).auth_key
+  end
+
+  test "turning off one device leaves other devices registered" do
+    register
+    phone_id = response.parsed_body.fetch("id")
+    register(endpoint: "https://web.push.apple.com/desktop")
+    desktop_id = response.parsed_body.fetch("id")
+
+    delete user_push_subscription_path(@user, phone_id), as: :json
+    assert_response :no_content
+    assert_equal [ desktop_id ], @user.push_subscriptions.ids
+  end
+
+  test "cannot manage another user's subscriptions" do
+    other = users(:kevin)
+    assert_no_difference "Push::Subscription.count" do
+      post user_push_subscriptions_path(other), params: { push_subscription: @params }, as: :json
+      assert_response :forbidden
+    end
+
+    subscription = other.push_subscriptions.create!(@params)
+    assert_no_difference "Push::Subscription.count" do
+      delete user_push_subscription_path(other, subscription), as: :json
+      assert_response :forbidden
+      delete user_push_subscription_path(@user, subscription), as: :json
+      assert_response :not_found
+    end
+  end
+
+  test "rejects incomplete subscriptions and endpoints outside push services" do
+    assert_no_difference "Push::Subscription.count" do
+      register(auth_key: nil)
+      assert_response :bad_request
+      register(p256dh_key: "invalid")
+      assert_response :unprocessable_entity
+      register(endpoint: "https://localhost/not-a-push-service")
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "logging out removes the subscriptions from that login" do
+    register
+    assert_difference "Push::Subscription.count", -1 do
+      sign_out
+    end
+  end
+
+  private
+    def register(**overrides)
+      post user_push_subscriptions_path(@user), params: { push_subscription: @params.merge(overrides) }, as: :json
+    end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..3e563a7
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    Push.stubs(:configured?).returns(true)
+    @user = users(:kevin)
+    @phone = subscribe(@user, "phone")
+  end
+
+  test "new activity fans out to all and only the tray recipient's devices, even when the tray item is reused" do
+    desktop = subscribe(@user, "desktop")
+    subscribe(users(:jz), "someone-else")
+    notifications(:layout_commented_kevin).destroy!
+    comment = events(:layout_commented)
+
+    notification = Notification.create!(user: @user, source: comment, creator: comment.creator)
+    update = events(:layout_published)
+    notification.update!(source: update, creator: update.creator)
+
+    [ @phone, desktop ].each do |device|
+      [ comment, update ].each do |source|
+        assert_enqueued_with(job: Push::DeliveryJob, args: [ device, source ])
+      end
+    end
+    assert_enqueued_jobs 4, only: Push::DeliveryJob
+
+    assert_no_enqueued_jobs only: Push::DeliveryJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "sends tray text and a tenanted link to the card or comment" do
+    Push.stubs(:vapid).returns({})
+    [ events(:layout_published), events(:layout_commented), mentions(:logo_comment_david_mention_by_jz) ].each do |source|
+      target = source.notifiable_target
+      url = "#{@user.account.slug}/cards/#{source.card.number}"
+      url += "#comment_#{target.id}" if target.is_a?(Comment)
+
+      WebPush.expects(:payload_send).with do |options|
+        JSON.parse(options[:message]) == { "title" => source.notification_title, "body" => source.notification_body, "url" => url } &&
+          options.values_at(:endpoint, :p256dh, :auth) == [ @phone.endpoint, @phone.p256dh_key, @phone.auth_key ]
+      end
+      @phone.deliver(source)
+    end
+  end
+
+  test "signs and encrypts the request and removes a subscription the push service has retired" do
+    vapid = WebPush.generate_key
+    Push.stubs(:vapid).returns(public_key: vapid.public_key, private_key: vapid.private_key)
+    request = stub_request(:post, @phone.endpoint).with(headers: { "Content-Encoding" => "aes128gcm", "Authorization" => /\Avapid / }).to_return(status: 410)
+
+    assert_difference "Push::Subscription.count", -1 do
+      @phone.deliver(events(:layout_commented))
+    end
+    assert_requested request
+  end
+
+  test "skips delivery after board access is revoked or when VAPID is not configured" do
+    event = events(:layout_commented)
+    WebPush.expects(:payload_send).never
+    Push.stubs(:configured?).returns(false)
+    @phone.deliver(event)
+
+    Push.stubs(:configured?).returns(true)
+    event.board.accesses.where(user: @user).delete_all
+    @phone.deliver(event)
+  end
+
+  private
+    def subscribe(user, device)
+      user.push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/#{device}", p256dh_key: WebPush.generate_key.public_key,
+        auth_key: SecureRandom.urlsafe_base64(16))
+    end
+end
diff --git a/test/system/push_notifications_test.rb b/test/system/push_notifications_test.rb
new file mode 100644
index 0000000..433afb8
--- /dev/null
+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,47 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    key = WebPush.generate_key.public_key
+    Push.stubs(:configured?).returns(true)
+    Push.stubs(:public_key).returns(key)
+    @user = users(:david)
+    sign_in_as @user
+    visit notifications_settings_path
+  end
+
+  test "turning on notifications registers this browser; turning them off removes just its subscription" do
+    # Exercise the real settings UI, service worker registration, and server. Only
+    # the permission prompt and the browser vendor's push service are simulated.
+    page.execute_script(<<~JS, WebPush.generate_key.public_key, SecureRandom.urlsafe_base64(16))
+      const [p256dh, auth] = arguments
+      Notification.requestPermission = async () => "granted"
+      PushManager.prototype.subscribe = async function() {
+        return { toJSON: () => ({ endpoint: "https://web.push.apple.com/phone", keys: { p256dh, auth } }) }
+      }
+    JS
+
+    click_button "Turn on notifications for this device"
+    assert_button "Turn off notifications for this device"
+    assert_equal [ "https://web.push.apple.com/phone" ], @user.push_subscriptions.pluck(:endpoint)
+
+    click_button "Turn off notifications for this device"
+    assert_button "Turn on notifications for this device"
+    assert_empty @user.push_subscriptions.reload
+  end
+
+  test "blocked notifications show the browser help without registering a device" do
+    page.execute_script(<<~JS)
+      Object.defineProperty(Notification, "permission", { configurable: true, value: "default" })
+      Notification.requestPermission = async () => {
+        Object.defineProperty(Notification, "permission", { value: "denied" })
+        return "denied"
+      }
+    JS
+    click_button "Turn on notifications for this device"
+
+    assert_selector ".notifications-help", text: "Turn on notifications for this website."
+    assert_button "Turn on notifications for this device", disabled: true
+    assert_empty @user.push_subscriptions
+  end
+end
