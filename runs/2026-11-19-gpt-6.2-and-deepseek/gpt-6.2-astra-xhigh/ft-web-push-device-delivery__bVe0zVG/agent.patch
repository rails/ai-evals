diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..60c6bbf
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,77 @@
+class Push::Subscription < ApplicationRecord
+  include Rails.application.routes.url_helpers
+
+  PUSH_SERVICES = %w[ fcm.googleapis.com push.services.mozilla.com notify.windows.com push.apple.com ].freeze
+
+  # Allow room for the encryption overhead in the push service’s 4 KiB payload.
+  MAX_MESSAGE_BYTES = 3990
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  belongs_to :session, optional: true
+
+  before_validation { self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s) }
+
+  validates :endpoint, length: { maximum: 4096 }
+  validate :validate_endpoint, :validate_p256dh_key, :validate_auth_key
+
+  def self.register!(user, attributes)
+    user.with_lock do
+      digest = Digest::SHA256.hexdigest(attributes[:endpoint].to_s)
+      user.push_subscriptions.find_or_initialize_by(endpoint_digest: digest).tap do |subscription|
+        subscription.update!(attributes)
+      end
+    end
+  end
+
+  def deliver(source)
+    if Push.configured? && account.active? && user.active? && source.card.accessible_to?(user)
+      WebPush.payload_send endpoint: endpoint, p256dh: p256dh_key, auth: auth_key, vapid: Push.vapid,
+        message: message_for(source), open_timeout: 5, read_timeout: 5
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy!
+  end
+
+  private
+    # Never let a client-supplied endpoint turn the job worker into an HTTP proxy.
+    def validate_endpoint
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.port == 443 && !uri.userinfo && !uri.fragment && uri.path.present? && push_service?(uri.host)
+        errors.add(:endpoint, "must be an HTTPS push service URL")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, :invalid)
+    end
+
+    def push_service?(host)
+      PUSH_SERVICES.any? { |domain| host == domain || host.to_s.end_with?(".#{domain}") }
+    end
+
+    def validate_p256dh_key
+      bytes = Base64.urlsafe_decode64(p256dh_key.to_s)
+      group = OpenSSL::PKey::EC::Group.new("prime256v1")
+      unless bytes.bytesize == 65 && bytes.getbyte(0) == 4 && OpenSSL::PKey::EC::Point.new(group, bytes).on_curve?
+        errors.add(:p256dh_key, :invalid)
+      end
+    rescue ArgumentError, OpenSSL::PKey::EC::Point::Error
+      errors.add(:p256dh_key, :invalid)
+    end
+
+    def validate_auth_key
+      errors.add(:auth_key, :invalid) unless Base64.urlsafe_decode64(auth_key.to_s).bytesize == 16
+    rescue ArgumentError
+      errors.add(:auth_key, :invalid)
+    end
+
+    def message_for(source)
+      message = { title: source.notification_title, body: source.notification_body,
+        url: polymorphic_path(source.notifiable_target, only_path: true, script_name: account.slug) }
+      json = message.to_json
+      if json.bytesize > MAX_MESSAGE_BYTES
+        message.merge(title: message[:title].truncate(255), body: message[:body].truncate(255)).to_json
+      else
+        json
+      end
+    end
+end
