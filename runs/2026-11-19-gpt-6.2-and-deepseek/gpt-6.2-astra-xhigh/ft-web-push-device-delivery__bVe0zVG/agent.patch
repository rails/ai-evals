@@ -64,4 +64,19 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+self.addEventListener("push", (event) => {
+  if (!event.data) return
+
+  const { title, body, url } = event.data.json()
+  event.waitUntil(self.registration.showNotification(title, { body, data: { url }, icon: "/app-icon-192.png" }))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  if (event.notification.data?.url) {
+    const url = new URL(event.notification.data.url, self.location.origin)
+    if (url.origin === self.location.origin) event.waitUntil(self.clients.openWindow(url.href))
+  }
+})
+
 TurboOffline.start()
