diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..f44a101
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,86 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+import { registerServiceWorker } from "initializers/offline"
+
+export default class extends Controller {
+  static targets = [ "button", "help", "status" ]
+  static values = { url: String, publicKey: String, subscriptions: Object }
+
+  async connect() {
+    this.element.classList.remove("notifications--on")
+    this.buttonTarget.disabled = true
+
+    if (!("serviceWorker" in navigator && "PushManager" in window && "Notification" in window)) {
+      return this.#explain("This browser doesn’t support push notifications.")
+    }
+    if (Notification.permission === "denied") return this.#explain("This browser is blocking notifications.")
+
+    try {
+      if (!await registerServiceWorker()) return this.#explain("Notifications are unavailable on this device.")
+
+      this.registration = await navigator.serviceWorker.ready
+      this.subscription = await this.registration.pushManager.getSubscription()
+      this.#refresh()
+    } catch {
+      this.#explain("Couldn’t check notification settings. Reload the page to try again.")
+    }
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+    try {
+      if (this.#subscriptionId) {
+        await this.#disable()
+      } else {
+        await this.#enable()
+      }
+      this.#refresh()
+    } catch {
+      this.#explain("Couldn’t update notifications. Check your browser settings and try again.")
+      this.buttonTarget.disabled = Notification.permission === "denied"
+    }
+  }
+
+  async #enable() {
+    if (Notification.permission !== "granted" && await Notification.requestPermission() !== "granted") {
+      throw new Error("Permission not granted")
+    }
+
+    this.subscription = await this.registration.pushManager.getSubscription() || await this.registration.pushManager.subscribe({
+      userVisibleOnly: true, applicationServerKey: this.publicKeyValue.replace(/=+$/, "")
+    })
+    const { endpoint, keys } = this.subscription.toJSON()
+    const response = await post(this.urlValue, { responseKind: "json", body: {
+      push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth }
+    } })
+    if (!response.ok) throw new Error("Registration failed")
+
+    this.subscriptionsValue = { ...this.subscriptionsValue, [keys.p256dh]: (await response.json).id }
+  }
+
+  async #disable() {
+    // The service worker's browser subscription may still be in use by another account.
+    const response = await destroy(`${this.urlValue}/${this.#subscriptionId}`, { responseKind: "json" })
+    if (!response.ok && response.statusCode !== 404) throw new Error("Removal failed")
+
+    const subscriptions = this.subscriptionsValue
+    delete subscriptions[this.subscription.toJSON().keys.p256dh]
+    this.subscriptionsValue = subscriptions
+  }
+
+  get #subscriptionId() {
+    return this.subscription && this.subscriptionsValue[this.subscription.toJSON().keys.p256dh]
+  }
+
+  #refresh() {
+    this.element.classList.toggle("notifications--on", !!this.#subscriptionId)
+    this.buttonTarget.disabled = false
+    this.helpTarget.hidden = true
+    this.statusTarget.textContent = ""
+  }
+
+  #explain(message) {
+    this.helpTarget.hidden = false
+    this.statusTarget.textContent = message
+  }
+}
