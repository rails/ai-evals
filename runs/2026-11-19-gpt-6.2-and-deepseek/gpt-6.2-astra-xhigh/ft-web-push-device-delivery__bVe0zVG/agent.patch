+class Push::DeliveryJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::PushServiceError, WebPush::TooManyRequests, Net::OpenTimeout, Net::ReadTimeout, wait: :polynomially_longer
+
+  def perform(subscription, source)
+    subscription.deliver(source)
+  end
+end
