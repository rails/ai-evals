diff --git a/app/models/event/notification_content.rb b/app/models/event/notification_content.rb
new file mode 100644
index 0000000..a6e441b
--- /dev/null
+++ b/app/models/event/notification_content.rb
@@ -0,0 +1,33 @@
+module Event::NotificationContent
+  def notification_title
+    title = card.title.presence || "Card #{card.number}"
+    action.comment_created? ? "RE: #{title}" : title
+  end
+
+  def notification_body
+    case notification_action
+    when "card_assigned" then "Assigned to #{assignees.none? ? "self" : assignees.pluck(:name).to_sentence}"
+    when "card_unassigned" then "Unassigned by #{creator.name}"
+    when "card_published" then "Added by #{creator.name}"
+    when "card_closed" then "Moved to Done by #{creator.name}"
+    when "card_reopened" then "Reopened by #{creator.name}"
+    when "card_postponed" then "Moved to Not Now by #{creator.name}"
+    when "card_auto_postponed" then "Moved to Not Now due to inactivity"
+    when "card_title_changed" then "Renamed by #{creator.name}"
+    when "card_board_changed" then "Moved by #{creator.name}"
+    when "card_triaged" then "Moved to #{particulars.dig("particulars", "column")} by #{creator.name}"
+    when "card_sent_back_to_triage" then "Moved back to Maybe? by #{creator.name}"
+    when "comment_created" then eventable.body.to_plain_text.truncate(200)
+    else creator.name
+    end
+  end
+
+  private
+    def notification_action
+      if action.card_published? && eventable.assigned_to?(creator)
+        "card_assigned"
+      else
+        action
+      end
+    end
+end
