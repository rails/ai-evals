+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    freeze_time
+    @user = users(:david)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "two arrivals share one email four hours after the first" do
+    notification = notify(:text_published)
+    first_arrival = Time.current
+    travel 3.hours
+    notify(:shipping_closed)
+    notification.read
+
+    assert_no_emails { deliver_due_bundles }
+
+    travel_to first_arrival + 4.hours
+    assert_emails 1 do
+      deliver_due_bundles
+    end
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_includes email.text_part.decoded, cards(:text).title
+    assert_includes email.text_part.decoded, cards(:shipping).title
+    assert_includes email.html_part.decoded, "#{@user.account.slug}/cards/#{cards(:text).number}"
+  end
+
+  test "late sources join the open window without moving its end" do
+    notify(:shipping_closed)
+    bundle = @user.notification_bundles.sole
+    assert_equal Time.current, bundle.starts_at
+    assert_equal 4.hours.from_now, bundle.ends_at
+
+    travel 2.hours
+    assert_operator events(:text_published).created_at, :<, events(:shipping_closed).created_at
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+      notify(:text_published)
+    end
+    assert_equal 2, bundle.entries.count
+    assert_equal 2.hours.from_now, bundle.reload.ends_at
+  end
+
+  test "an arrival at the deadline starts the next window even if delivery is behind" do
+    notification = notify(:shipping_published)
+    first = @user.notification_bundles.sole
+    @user.settings.update!(bundle_email_frequency: "weekly")
+
+    travel_to first.ends_at
+    notification.update!(source: events(:shipping_closed))
+    second = @user.notification_bundles.excluding(first).sole
+    assert_equal first.ends_at, second.starts_at
+    assert_equal 1.week.from_now, second.ends_at
+
+    # The second update on the same card must not replace the first email's source.
+    assert_emails(1) { deliver_due_bundles }
+    email = ActionMailer::Base.deliveries.last.text_part.decoded
+    assert_includes email, "Added by Kevin"
+    assert_not_includes email, "Moved to Done"
+
+    travel_to second.ends_at
+    assert_emails(1) { deliver_due_bundles }
+    assert_includes ActionMailer::Base.deliveries.last.text_part.decoded, "Moved to Done by Kevin"
+  end
+
+  test "people have independent windows and frequencies" do
+    other = users(:jz)
+    other.settings.update!(bundle_email_frequency: "daily")
+    notify(:shipping_closed)
+    travel 1.hour
+    notify(:text_published, user: other)
+    other_bundle = other.notification_bundles.sole
+    assert_equal Time.current, other_bundle.starts_at
+    assert_equal 1.day.from_now, other_bundle.ends_at
+
+    travel 3.hours
+    assert_emails(1) { deliver_due_bundles }
+    assert_equal [ @user.identity.email_address ], ActionMailer::Base.deliveries.last.to
+    assert_not_includes ActionMailer::Base.deliveries.last.text_part.decoded, cards(:text).title
+
+    travel_to other_bundle.ends_at
+    assert_emails(1) { deliver_due_bundles }
+    assert_equal [ other.identity.email_address ], ActionMailer::Base.deliveries.last.to
+  end
+
+  test "turning email off discards pending mail and does not start new windows" do
+    notify(:shipping_closed)
+    @user.settings.update!(bundle_email_frequency: "never")
+    assert_empty @user.notification_bundles.reload
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+      notify(:text_published)
+    end
+    travel 1.week
+    assert_no_emails { deliver_due_bundles }
+  end
+
+  test "includes mentions and ignores read state updates" do
+    Notifier.for(mentions(:logo_card_david_mention_by_jz)).notify
+    notification = notifications(:logo_mentioned_david).reload
+    notification.read
+    notification.unread
+    assert_equal 1, @user.notification_bundles.sole.entries.count
+    travel 4.hours
+    assert_emails(1) { deliver_due_bundles }
+    assert_includes ActionMailer::Base.deliveries.last.text_part.decoded, "JZ mentioned you"
+  end
+
+  test "does not email inaccessible cards or send an empty digest" do
+    notify(:shipping_closed)
+    @user.accesses.find_by!(board: cards(:shipping).board).destroy!
+    travel 4.hours
+    assert_no_emails { deliver_due_bundles }
+  end
+
+  test "a person's windows cannot overlap, but their boundaries can touch" do
+    notify(:shipping_closed)
+    bundles = @user.notification_bundles
+    first = bundles.sole
+    assert_not bundles.new(starts_at: first.starts_at - 1.hour, ends_at: first.starts_at + 1.hour).valid?
+    assert_not bundles.new(starts_at: first.starts_at + 1.hour, ends_at: first.ends_at - 1.hour).valid?
+    assert_not bundles.new(starts_at: first.ends_at - 1.hour, ends_at: first.ends_at + 1.hour).valid?
+    assert_predicate bundles.new(starts_at: first.ends_at, ends_at: first.ends_at + 4.hours), :valid?
+  end
+
+  test "a repeated delivery job does not send a second email" do
+    notify(:shipping_closed)
+    bundle = @user.notification_bundles.sole
+    Notification::Bundle::DeliverJob.set(wait_until: bundle.ends_at).perform_later(bundle)
+
+    travel_to bundle.ends_at
+    assert_emails(1) { deliver_due_bundles }
+    assert_empty @user.notification_bundles.reload
+  end
+
+  private
+    def notify(event_name, user: @user)
+      event = events(event_name)
+      user.notifications.create!(source: event, creator: event.creator)
+    end
+
+    def deliver_due_bundles
+      perform_enqueued_jobs(only: Notification::Bundle::DeliverJob, at: Time.current)
+    end
+end
