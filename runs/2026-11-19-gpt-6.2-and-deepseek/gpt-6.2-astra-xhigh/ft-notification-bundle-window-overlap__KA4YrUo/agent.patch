diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..4c90561
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,74 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :user
+  belongs_to :account, default: -> { user.account }
+  has_many :entries, class_name: "Notification::Bundle::Entry", dependent: :delete_all
+
+  attr_readonly :user_id, :starts_at, :ends_at
+  validates :starts_at, presence: true
+  validates :ends_at, comparison: { greater_than: :starts_at }, if: :starts_at?
+  validate :disjoint_window, on: :create
+
+  after_create_commit :schedule_delivery
+
+  class << self
+    def collect(notification)
+      transaction do
+        # Lock a row that exists even before the first window, and read the
+        # preference under that lock (including concurrent opt-outs).
+        settings = User::Settings.lock.find_by(user_id: notification.user_id)
+        if interval = settings&.bundle_email_interval
+          bundle = open_for(notification.user, interval)
+          bundle.entries.create!(notification: notification, source: notification.source)
+        end
+      end
+    end
+
+    private
+      def open_for(user, interval)
+        # Use arrival time, not the (possibly older) source event's timestamp.
+        bundles = user.notification_bundles
+        bundles.lock.find_by("ends_at > ?", Time.current) || bundles.create! do |bundle|
+          bundle.starts_at = Time.current
+          bundle.ends_at = bundle.starts_at + interval
+        end
+      end
+  end
+
+  def deliver
+    if ends_at <= Time.current
+      NotificationMailer.bundle(self).deliver_now if deliverable?
+      destroy!
+    end
+  end
+
+  def accessible_entries
+    entries.joins(:notification).where(notifications: { card_id: user.accessible_cards.select(:id) })
+      .preload(:source, notification: :card).order(:created_at, :id)
+  end
+
+  private
+    def disjoint_window
+      if user_id && starts_at && ends_at
+        if !User::Settings.lock.exists?(user_id: user_id)
+          errors.add(:user, "has no notification settings")
+        elsif user.notification_bundles.lock.where("starts_at < ? AND ends_at > ?", ends_at, starts_at).exists?
+          errors.add(:starts_at, "overlaps an existing window")
+        end
+      end
+    end
+
+    def schedule_delivery
+      Current.with_account(account) do
+        Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+      end
+    end
+
+    def deliverable?
+      # Wait for any last arrival that took the settings lock before the deadline.
+      # Later arrivals must open another window. Don't hold a DB lock across SMTP.
+      transaction do
+        settings = User::Settings.lock.find_by(user_id: user_id)
+        settings&.bundle_email_interval && user.active? && user.identity.present? && account.active?
+      end
+    end
+end
