diff --git a/test/models/notification/bundle_concurrency_test.rb b/test/models/notification/bundle_concurrency_test.rb
new file mode 100644
index 0000000..6a34559
--- /dev/null
+++ b/test/models/notification/bundle_concurrency_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  test "simultaneous first arrivals open and schedule only one window" do
+    user = Current.account.users.create!(name: "Digest recipient")
+    user.settings.update!(bundle_email_frequency: "daily")
+    account = user.account
+    barrier = Concurrent::CyclicBarrier.new(2)
+
+    assert_enqueued_jobs 1, only: Notification::Bundle::DeliverJob do
+      events(:text_published, :shipping_closed).map do |event|
+        Thread.new do
+          ActiveRecord::Base.connection_pool.with_connection do
+            Current.with_account(account) do
+              barrier.wait(5)
+              Notification.create!(user_id: user.id, creator: event.creator, source: event)
+            end
+          end
+        end
+      end.each(&:value)
+    end
+
+    assert_equal 2, user.notification_bundles.sole.entries.count
+  ensure
+    user&.destroy!
+  end
+end
