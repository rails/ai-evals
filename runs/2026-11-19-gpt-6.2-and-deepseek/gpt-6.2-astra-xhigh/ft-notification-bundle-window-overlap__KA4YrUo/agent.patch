+class Account::DataTransfer::UserSettingsRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account)
+    super(account: account, model: User::Settings)
+  end
+
+  private
+    def load(file_path)
+      # Exports made before digests have no email preference.
+      super.with_defaults("bundle_email_frequency" => "never").tap do |settings|
+        unless User::Settings.bundle_email_frequencies.key?(settings["bundle_email_frequency"])
+          raise IntegrityError, "#{file_path} has an invalid bundle_email_frequency"
+        end
+      end
+    end
+end
