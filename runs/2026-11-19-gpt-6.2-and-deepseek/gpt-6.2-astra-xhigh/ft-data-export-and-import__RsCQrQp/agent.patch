+class ExportsController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  def show
+    # Use an export-specific token, not a blob signed_id that could also be
+    # submitted to an attachment endpoint.
+    export = Current.account.exports.find_signed(params[:id], purpose: :download) || raise(ActiveRecord::RecordNotFound)
+    if export.accessible_to?(Current.user)
+      no_store
+      lifetime = [ export.expires_at - Time.current, ActiveStorage.service_urls_expire_in ].min
+      redirect_to export.file.url(expires_in: lifetime, disposition: :attachment), allow_other_host: true
+    else
+      head :forbidden
+    end
+  end
+end
