--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -37,4 +37,42 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "docs/guide.txt", "docs/readme.txt" ], writer.glob("docs/*.txt")
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
+  test "streamed ZIP size and checksum include the central directory" do
+    io = StringIO.new("".b)
+    writer = ZipFile::Writer.new(digest: :sha256)
+    writer.stream_to(io)
+    writer.add_file("manifest.json", '{"version":1}')
+    writer.close
+
+    assert_equal io.size, writer.byte_size
+    assert_equal "sha256:#{Digest::SHA256.base64digest(io.string)}", writer.checksum
+    assert_equal({ "version" => 1 }, ZipFile::Reader.new(io).read_json("manifest.json"))
+  end
+
+  test "storage-backed IO reads only the requested window of a large archive" do
+    size = 501.gigabytes
+    service = mock
+    service.expects(:download_chunk).with("import", (size - 64)...size).returns("x" * 64)
+    io = ZipFile::StorageIO.new(service, "import", size)
+    io.seek(size - 64, IO::SEEK_SET)
+    assert_equal "xxxx", io.read(4)
+    assert_equal size - 60, io.tell
+    assert_equal "x" * 60, io.read
+  end
+  test "creates a downloadable ZIP on an S3 multipart upload stream" do
+    services = ActiveStorage::Service::Registry.new(archive: { service: "S3", region: "us-east-1", bucket: "archives", stub_responses: true })
+    service = services.fetch(:archive)
+    ActiveStorage::Blob.stubs(:services).returns(services)
+    ActiveStorage::Blob.stubs(:service).returns(service)
+    io = StringIO.new("".b)
+    service.expects(:upload_stream).yields(io)
+    service.stubs(:download_chunk).returns("PK".b)
+    export = Export.create!(user: users(:jason), kind: :account)
+    ZipFile.create_for(export.file, filename: "archive.zip") { |zip| zip.add_file("test.json", "[]") }
+
+    assert_equal "archive", export.file.service_name
+    assert_equal io.size, export.file.byte_size
+    assert_equal Digest::MD5.base64digest(io.string), export.file.checksum
+    assert_equal [], ZipFile::Reader.new(io).read_json("test.json")
+  end
 end
