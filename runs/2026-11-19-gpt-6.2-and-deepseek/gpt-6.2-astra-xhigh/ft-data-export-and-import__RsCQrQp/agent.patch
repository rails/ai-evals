+class Account::ImportsController < ApplicationController
+  layout "public"
+  disallow_account_scope
+
+  def new
+  end
+
+  def create
+    upload = params[:file]
+    if upload.is_a?(ActionDispatch::Http::UploadedFile)
+      if Account::Import.stage(Current.identity, upload)
+        redirect_to session_menu_path, notice: "We’ll email you when the import is finished."
+      else
+        flash.now[:alert] = "We couldn’t store your upload. Please try again."
+        render :new, status: :service_unavailable
+      end
+    else
+      flash.now[:alert] = "Choose an account ZIP file to import."
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
