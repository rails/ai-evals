+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    @download_url = export_url(export.signed_id(purpose: :download, expires_at: export.expires_at), script_name: export.account.slug)
+    mail to: export.user.identity.email_address, subject: "Your Fizzy export is ready"
+  end
+
+  def import_completed(identity, account)
+    @account = account
+    mail to: identity.email_address, subject: "Your Fizzy account has been imported"
+  end
+
+  def import_failed(identity, reason)
+    @reason = reason
+    mail to: identity.email_address, subject: "Your Fizzy account import failed"
+  end
+end
