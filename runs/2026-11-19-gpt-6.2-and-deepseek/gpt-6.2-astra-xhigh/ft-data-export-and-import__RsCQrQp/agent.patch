diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..088658f
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,59 @@
+# Uploads are staged outside the tenant-owned blob tables: at this point the
+# signed-in identity need not belong to any account yet.
+class Account::Import < ApplicationRecord
+  belongs_to :identity
+  after_destroy_commit :delete_archive
+
+  def self.stage(identity, upload)
+    service = ActiveStorage::Blob.service
+    import = create!(identity: identity, service_name: service.name, byte_size: upload.size)
+    begin
+      service.upload(import.key, upload.tempfile, content_type: "application/zip")
+      raise ActiveJob::EnqueueError unless Account::ImportJob.perform_later(import)
+      import
+    rescue => error
+      Rails.error.report(error)
+      import.destroy!
+      DataTransferMailer.import_failed(identity, "The uploaded ZIP could not be stored for import.").deliver_later
+      nil
+    end
+  end
+
+  def key
+    "imports/#{id}"
+  end
+
+  def process
+    with_lock do
+      account = restore_account
+      if account
+        DataTransferMailer.import_completed(identity, account).deliver_later
+      end
+      destroy!
+    end
+  end
+
+  private
+    def restore_account
+      zip = ZipFile::Reader.new(ZipFile::StorageIO.new(service, key, byte_size))
+      Account::DataTransfer::Restore.new(zip, identity).restore!
+    rescue StandardError => error
+      Rails.error.report(error)
+      reason = case error
+      when ZipFile::Reader::InvalidArchive then error.message.truncate(300)
+      when ActiveRecord::RecordInvalid then error.record.errors.full_messages.to_sentence.truncate(300)
+      when ActiveStorage::FileNotFoundError then "The uploaded file could not be found."
+      else "The archive could not be restored. It may be incomplete or contain invalid data."
+      end
+      DataTransferMailer.import_failed(identity, reason).deliver_later
+      nil
+    end
+
+    def delete_archive
+      service.delete(key)
+    end
+
+    def service
+      ActiveStorage::Blob.services.fetch(service_name)
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..6509d1e
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,46 @@
+class Export < ApplicationRecord
+  belongs_to :user
+  belongs_to :account, default: -> { user.account }
+  has_one_attached :file
+
+  enum :kind, %w[ account personal ].index_by(&:itself), prefix: true
+
+  def self.request(user, kind:)
+    create!(user: user, kind: kind).tap { |export| GenerateJob.perform_later(export) }
+  end
+
+  def self.cleanup
+    where(expires_at: ..Time.current).find_each(&:destroy!)
+  end
+
+  def generate
+    return destroy! unless permitted?(user)
+    return if expires_at?
+
+    ZipFile.create_for(file, filename: "fizzy-#{kind}-#{Date.current}.zip") do |zip|
+      with_snapshot do
+        cards = kind_account? ? account.cards : user.accessible_cards
+        Account::DataTransfer::Cards.new(cards).write_to(zip, with_files: kind_personal?)
+        Account::DataTransfer::Manifest.new(account).write_to(zip) if kind_account?
+      end
+    end
+    update!(expires_at: 1.day.from_now)
+    DataTransferMailer.export_ready(self).deliver_later
+  end
+
+  def accessible_to?(requester)
+    permitted?(requester) && expires_at&.future?
+  end
+
+  private
+    def with_snapshot(&block)
+      # MySQL installations may use READ COMMITTED. All of the batched reads
+      # must see the same boards, memberships and attachments.
+      isolation = :repeatable_read unless Fizzy.db_adapter.sqlite? || Account.current_transaction.open?
+      Account.transaction(isolation: isolation, &block)
+    end
+
+    def permitted?(requester)
+      requester == user && user.active? && account.active? && (kind_personal? || user.admin?)
+    end
+end
