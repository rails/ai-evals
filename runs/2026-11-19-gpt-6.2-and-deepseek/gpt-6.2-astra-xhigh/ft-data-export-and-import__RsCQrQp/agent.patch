diff --git a/docs/data-transfer.md b/docs/data-transfer.md
new file mode 100644
index 0000000..d26f410
--- /dev/null
+++ b/docs/data-transfer.md
@@ -0,0 +1,18 @@
+# Moving data into and out of Fizzy
+
+- **Account settings → Export account** (owner or admin): backs up the whole account, including private boards.
+- **Your profile → Export my cards**: downloads only cards on boards you can access. This is not an account backup.
+
+Fizzy prepares the ZIP in the background and emails the requester a download link. Sign in to download it within one day. Treat an account ZIP as sensitive: it includes people's email addresses, private discussions, and board webhook configuration.
+
+To restore, sign in, visit `/account/imports/new` (also linked from the account chooser), and upload the account ZIP unchanged. Fizzy emails the outcome. A restore creates a **new** account, never merges into or overwrites another one. The importer is the owner. People are matched by email address; board access, authorship and card numbers are preserved. An unsuccessful restore is rolled back.
+
+## Inside the ZIP
+
+`cards/<number>.json` contains the card, its description and comments. File paths in the `files` lists are relative to the ZIP root. Original uploads, including inline attachments, live under `files/<blob-id>/` so duplicate filenames do not collide. Remotely hosted media remain links.
+
+An account ZIP also has a versioned `manifest.json` and batches of records under `records/`. Archive IDs are local references, not IDs to reuse on the destination. Join codes, public board URLs, and attachment signatures are generated on the destination. Login credentials, sessions, device registrations, billing data, previous exports, and generated previews/search indexes are not copied.
+
+## Operating notes
+
+Run background workers and configure outgoing mail and Active Storage. ZIPs use the configured disk or S3 service. Exports stream file bytes; imports read ZIP members by offset and verify them before uploading under new storage keys. Allow temporary disk space for multipart form uploads, local ZIP generation, and the largest individual file being restored. Configure the reverse proxy's upload size and timeout limits to accommodate the archive.
diff --git a/test/integration/data_transfer_test.rb b/test/integration/data_transfer_test.rb
new file mode 100644
index 0000000..151219d
--- /dev/null
+++ b/test/integration/data_transfer_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class DataTransferTest < ActionDispatch::IntegrationTest
+  test "only admins can request account exports; the emailed link is private and expires a day after generation" do
+    sign_in_as :david
+    clear_enqueued_jobs
+    get account_settings_path
+    assert_select "form[action=?]", account_exports_path, count: 0
+    assert_no_difference "Export.count" do
+      post account_exports_path
+      assert_response :forbidden
+    end
+
+    logout_and_sign_in_as :jason
+    clear_enqueued_jobs
+    get account_settings_path
+    assert_select "form[action=?]", account_exports_path
+    assert_enqueued_with(job: Export::GenerateJob) { post account_exports_path }
+    assert_redirected_to account_settings_path
+    travel 2.days do
+      perform_enqueued_jobs only: Export::GenerateJob
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ identities(:jason).email_address ], mail.to
+      url = mail.text_part.body.decoded[%r{http://\S+/exports/\S+}]
+      assert url, "Expected a signed download URL in the email"
+      get URI(url).request_uri
+      assert_response :redirect
+      assert_includes response.location, "/disk/"
+      follow_redirect!
+      assert_response :success
+      assert_equal "application/zip", response.media_type
+      assert_equal Account::DataTransfer::Manifest::FORMAT, ZipFile::Reader.new(StringIO.new(response.body)).read_json("manifest.json").fetch("format")
+
+      logout_and_sign_in_as :david
+      get URI(url).request_uri
+      assert_response :forbidden
+      logout_and_sign_in_as :jason
+      travel_to 25.hours.from_now
+      get URI(url).request_uri
+      assert_response :not_found
+    end
+  end
+
+  test "personal export is always for the signed-in member and only contains accessible cards and files" do
+    sign_in_as :david
+    clear_enqueued_jobs
+    Current.account = accounts("37s")
+    Current.user = users(:kevin)
+    secret = boards(:private).cards.create!(creator: users(:kevin), title: "Secret", status: :published)
+    secret.image.attach io: file_fixture("moon.jpg").open, filename: "secret.jpg"
+    cards(:logo).image.attach io: file_fixture("moon.jpg").open, filename: "logo.jpg"
+    get user_path(users(:david))
+    assert_select "form[action=?]", my_exports_path
+    assert_enqueued_with(job: Export::GenerateJob) { post my_exports_path, params: { kind: "account", user_id: users(:kevin).id } }
+    assert_redirected_to user_path(users(:david))
+    perform_enqueued_jobs only: Export::GenerateJob
+    export = Export.last
+    assert export.kind_personal?
+    assert_equal users(:david), export.user
+    export.file.open do |io|
+      paths = ZipKit::FileReader.read_zip_structure(io: io).map(&:filename)
+      assert_includes paths, "cards/#{cards(:logo).number}.json"
+      assert paths.any? { |path| path.end_with?("/logo.jpg") }
+      assert_not_includes paths, "cards/#{secret.number}.json"
+      assert_not paths.any? { |path| path.end_with?("/secret.jpg") || path.start_with?("records/") }
+      assert_not_includes paths, "manifest.json"
+      assert_no_difference "Account.count" do
+        error = assert_raises(ZipFile::Reader::InvalidArchive) do
+          Account::DataTransfer::Restore.new(ZipFile::Reader.new(io), identities(:david)).restore!
+        end
+        assert_includes error.message, "full account export"
+      end
+    end
+  end
+
+  test "a signed-in identity can upload an account archive outside any account" do
+    export = Export.create!(user: users(:jason), kind: :account)
+    export.generate
+    importer = Identity.create!(email_address: "new-owner@example.com")
+    sign_in_as importer
+    clear_enqueued_jobs
+    untenanted do
+      get new_account_import_path
+      assert_response :success
+      export.file.open do |file|
+        post account_imports_path, params: { file: Rack::Test::UploadedFile.new(file.path, "application/zip") }
+      end
+      assert_redirected_to session_menu_path
+      staging_key = Account::Import.sole.key
+      assert_difference "Account.count", 1 do
+        perform_enqueued_jobs only: Account::ImportJob
+        perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+      end
+      assert_not ActiveStorage::Blob.service.exist?(staging_key)
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ importer.email_address ], mail.to
+      assert_includes mail.text_part.body.decoded, importer.accounts.sole.slug
+    end
+  end
+
+  test "an import requires authentication and reports a bad archive without creating an account" do
+    untenanted do
+      get new_account_import_path
+      assert_response :redirect
+      assert_no_difference "Account::Import.count" do
+        post account_imports_path, params: { file: fixture_file_upload("moon.jpg") }
+      end
+    end
+
+    sign_in_as :david
+    clear_enqueued_jobs
+    untenanted do
+      post account_imports_path
+      assert_response :unprocessable_entity
+      post account_imports_path, params: { file: fixture_file_upload("moon.jpg") }
+      key = Account::Import.sole.key
+      assert_no_difference [ "Account.count", "User.count", "ActiveStorage::Blob.count" ] do
+        perform_enqueued_jobs only: Account::ImportJob
+        perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+      end
+      assert_not ActiveStorage::Blob.service.exist?(key)
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ identities(:david).email_address ], mail.to
+      assert_includes mail.body.decoded, "not a complete ZIP"
+    end
+  end
+end
diff --git a/test/models/account/data_transfer/round_trip_test.rb b/test/models/account/data_transfer/round_trip_test.rb
new file mode 100644
index 0000000..29845c4
--- /dev/null
+++ b/test/models/account/data_transfer/round_trip_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Account::DataTransfer::RoundTripTest < ActiveSupport::TestCase
+  test "restores history, people, access and files under fresh IDs, even on the source instance" do
+    card = cards(:logo)
+    card.board.publish
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "photo.jpg"
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("the document"), filename: "会議-notes.txt")
+    comment = card.comments.first
+    comment.update!(body: "See this: #{attachment(blob)} #{attachment(users(:jz))}")
+
+    export = Export.create!(user: users(:jason), kind: :account)
+    export.generate
+    export.file.open do |file|
+      zip = ZipFile::Reader.new(file)
+      data = zip.read_json("cards/#{card.number}.json")
+      assert_equal card.title, data.fetch("title")
+      assert_equal [ "files/#{blob.id}/会議-notes.txt" ], data.fetch("comments").find { |c| c.fetch("id") == comment.id }.fetch("files")
+
+      copy = Account::DataTransfer::Restore.new(zip, identities(:mike)).restore!
+      assert_not_equal Current.account.slug, copy.slug
+      assert_equal Current.account.cards.count, copy.cards.count
+      assert copy.users.find_by!(identity: identities(:mike)).owner?
+      restored = copy.cards.find_by!(number: card.number)
+      assert_not_equal card.id, restored.id
+      assert_equal card.reload.updated_at, restored.updated_at
+      assert_equal card.image.download, restored.image.download
+      assert_not_equal card.image.key, restored.image.key
+      restored_blob, mentionee = restored.comments.find { |c| c.body.to_plain_text.include?("See this") }.body.body.attachables
+      assert_equal "the document", restored_blob.download
+      assert_equal copy, restored_blob.account
+      assert_equal copy.users.find_by!(identity: identities(:jz)), mentionee
+      assert_equal card.creator.identity, restored.creator.identity
+      assert_equal card.column.name, restored.column.name
+      assert_equal card.board.name, restored.board.name
+      assert_not_equal card.board.publication.key, restored.board.publication.key
+      assert_equal card.assignees.pluck(:name).sort, restored.assignees.pluck(:name).sort
+      assert_equal card.tags.pluck(:title).sort, restored.tags.pluck(:title).sort
+      assert_not copy.boards.find_by!(name: boards(:private).name).accessible_to?(restored.creator)
+      assert_equal card.comments.count, restored.comments.count
+      assert_equal card.events.count, restored.events.count
+      assert_equal filters(:jz_assignments).tags.pluck(:title), restored.creator.filters.sole.tags.pluck(:title)
+    end
+  end
+
+  test "a missing archive reference never resolves to an existing tenant and rolls back previously uploaded files" do
+    card = cards(:logo)
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "photo.jpg"
+    # Simulate a corrupt attachment late in the archive, after the blob and
+    # all of the account's records have been restored.
+    card.image.attachment.update_column(:record_id, cards(:radio).id)
+    Signup.any_instance.stubs(:create_tenant).returns(12345)
+    Signup.any_instance.expects(:handle_account_creation_error).with(is_a(ActiveRecord::Rollback))
+    export = Export.create!(user: users(:jason), kind: :account)
+    export.generate
+    export.file.open do |file|
+      keys = []
+      subscriber = ->(event) { keys << event.payload.fetch(:key) }
+      ActiveSupport::Notifications.subscribed(subscriber, "service_upload.active_storage") do
+        assert_no_difference [ "Account.count", "User.count", "Board.count", "Card.count", "Comment.count", "ActiveStorage::Blob.count", "ActionText::RichText.count" ] do
+          error = assert_raises(ZipFile::Reader::InvalidArchive) do
+            Account::DataTransfer::Restore.new(ZipFile::Reader.new(file), identities(:jason)).restore!
+          end
+          assert_includes error.message, "Missing referenced Card"
+        end
+      end
+      assert_predicate keys, :present?
+      keys.each { |key| assert_not ActiveStorage::Blob.service.exist?(key) }
+    end
+  end
+
+  private
+    def attachment(attachable)
+      ActionText::Attachment.from_attachable(attachable).to_html
+    end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
