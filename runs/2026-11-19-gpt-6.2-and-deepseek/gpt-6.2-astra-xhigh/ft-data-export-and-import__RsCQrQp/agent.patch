+++ b/app/models/account/data_transfer/filter_record_set.rb
@@ -0,0 +1,32 @@
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  RESOURCES = { tags: Tag, boards: Board, assignees: User, creators: User, closers: User }
+
+  def initialize(account)
+    super(account: account, model: Filter)
+  end
+
+  private
+    def serialize(filter)
+      super.merge("resources" => RESOURCES.keys.index_with { |name| filter.public_send(name).ids })
+    end
+
+    def import_batch(rows, restore)
+      super
+      rows.each do |row|
+        filter = Filter.find(restore.lookup(model, row.fetch("id")))
+        RESOURCES.each do |name, type|
+          ids = row.fetch("resources").fetch(name.to_s).map { |id| restore.lookup(type, id) }
+          filter.public_send("#{name.to_s.singularize}_ids=", ids)
+        end
+        filter.reload.save!
+      end
+    end
+
+    def import_attributes(row, restore)
+      fields = row.fetch("fields").dup
+      { "card_ids" => Card, "column_ids" => Column }.each do |key, type|
+        fields[key] = fields[key].map { |id| restore.lookup(type, id) } if fields[key]
+      end
+      super.merge("fields" => fields)
+    end
+end
