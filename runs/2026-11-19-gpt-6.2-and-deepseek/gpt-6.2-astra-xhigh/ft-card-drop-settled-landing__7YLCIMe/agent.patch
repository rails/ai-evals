diff --git a/app/javascript/lib/card_move.js b/app/javascript/lib/card_move.js
new file mode 100644
index 0000000..a1643c2
--- /dev/null
+++ b/app/javascript/lib/card_move.js
@@ -0,0 +1,91 @@
+import { Turbo } from "@hotwired/turbo-rails"
+import { post, destroy } from "@rails/request.js"
+
+// A move keeps the original preview at its exact (possibly paginated) position,
+// inert inside a template, until the server confirms the move.
+export class CardMove {
+  #source
+  #destination
+  #position = document.createElement("template")
+  #card
+
+  constructor(original, destination) {
+    this.#source = original.closest(".cards")
+    this.#destination = destination
+    this.#card = original.cloneNode(true)
+
+    original.replaceWith(this.#position)
+    this.#position.content.append(original)
+    this.#insertPreview()
+    this.#updateCounts(1)
+  }
+
+  async save() {
+    const response = await this.#request()
+    if (!response.ok) throw new Error(`Card move failed: ${response.statusCode}`)
+
+    const preview = new DOMParser().parseFromString(await response.html, "text/html").querySelector("article.card")
+    if (preview?.id !== this.#card.id) throw new Error("Missing card preview")
+
+    if (this.#card.isConnected) {
+      Turbo.morphElements(this.#card, preview)
+    } else {
+      // Already moved again. Update the next move's rollback copy, not the board.
+      this.#card.replaceWith(preview)
+    }
+    this.#position.remove()
+  }
+
+  undo() {
+    this.#card.remove()
+    this.#position.replaceWith(this.#position.content)
+    this.#updateCounts(-1)
+  }
+
+  #insertPreview() {
+    const column = this.#destination
+    const card = this.#card
+    const active = column.id === "maybe" || !!column.dataset.columnId
+    card.classList.toggle("card--active", active)
+    card.classList.toggle("card--postponed", column.id === "not-now")
+    card.style.setProperty("--card-color", column.style.getPropertyValue("--card-color") || "var(--color-card-default)")
+    card.querySelector(".card__closed")?.remove()
+    card.querySelector(".bubble")?.remove()
+    card.querySelector(".card__meta-text--updated time")?.setAttribute("datetime", Math.floor(Date.now() / 1000))
+    card.removeAttribute("aria-selected")
+
+    // Moving is activity: the card is newest, but active columns pin golden cards first.
+    const list = column.querySelector(".cards__list")
+    const goldenCards = active && !card.matches(".golden-effect") ? list.querySelectorAll("article.golden-effect") : []
+    if (goldenCards.length) {
+      goldenCards[goldenCards.length - 1].after(card)
+    } else {
+      list.querySelector("turbo-frame").prepend(card)
+    }
+  }
+
+  #updateCounts(delta) {
+    this.#updateCount(this.#source, -delta)
+    this.#updateCount(this.#destination, delta)
+  }
+
+  #updateCount(column, delta) {
+    const expander = column.querySelector(".cards__expander")
+    const count = Number(expander.style.getPropertyValue("--card-count")) + delta
+    expander.style.setProperty("--card-count", count)
+    expander.querySelector(".cards__expander-count").textContent = count > 99 ? "99+" : count
+  }
+
+  #request() {
+    const column = this.#destination
+    const { cardTriageUrl, cardClosureUrl, cardNotNowUrl } = this.#card.dataset
+    const options = { query: { card_preview: true }, responseKind: "html" }
+
+    switch (column.id) {
+      case "maybe": return destroy(cardTriageUrl, options)
+      case "closed-cards": return post(cardClosureUrl, options)
+      case "not-now": return post(cardNotNowUrl, options)
+      default: return post(cardTriageUrl, { ...options, body: { column_id: column.dataset.columnId } })
+    }
+  }
+}
