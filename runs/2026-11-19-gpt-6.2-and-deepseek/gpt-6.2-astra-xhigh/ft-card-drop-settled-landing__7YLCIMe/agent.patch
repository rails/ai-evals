diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..27856d9
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,95 @@
+import { Controller } from "@hotwired/stimulus"
+import { CardMove } from "lib/card_move"
+
+export default class extends Controller {
+  static targets = [ "card" ]
+
+  #card
+  #hoveredColumn
+  #moves = []
+
+  cardTargetConnected(card) {
+    card.draggable = true
+  }
+
+  cardTargetDisconnected(card) {
+    if (card === this.#card) this.end()
+    card.removeAttribute("draggable")
+  }
+
+  prepareCardForMorph({ target, detail: { newElement } }) {
+    if (newElement?.matches('[data-drag-and-drop-target~="card"]')) {
+      newElement.draggable = true
+      if (target === this.#card) newElement.classList.add("drag-and-drop__dragged-item")
+    }
+  }
+
+  start(event) {
+    if (!this.cardTargets.includes(event.target)) return
+
+    this.#card = event.target
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", this.#card.id)
+    this.#card.classList.add("drag-and-drop__dragged-item")
+  }
+
+  over(event) {
+    if (this.#canDrop(event.currentTarget)) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(event.currentTarget)
+    }
+  }
+
+  leave({ currentTarget, relatedTarget }) {
+    if (currentTarget === this.#hoveredColumn && !currentTarget.contains(relatedTarget)) this.#highlight(null)
+  }
+
+  drop(event) {
+    const column = event.currentTarget
+    if (!this.#canDrop(column)) return
+
+    event.preventDefault()
+    const card = this.#card
+    this.end()
+    this.#moves.push(new CardMove(card, column))
+    if (this.#moves.length === 1) this.#saveMoves()
+  }
+
+  end() {
+    this.#card?.classList.remove("drag-and-drop__dragged-item")
+    this.#card = null
+    this.#highlight(null)
+  }
+
+  disconnect() {
+    this.end()
+  }
+
+  #canDrop(column) {
+    return this.#card && !column.contains(this.#card) && column.querySelector(".cards__list turbo-frame")
+  }
+
+  #highlight(column) {
+    if (this.#hoveredColumn !== column) {
+      this.#hoveredColumn?.classList.remove("drag-and-drop__hover-container")
+      column?.classList.add("drag-and-drop__hover-container")
+      this.#hoveredColumn = column
+    }
+  }
+
+  // Save in drop order. A second drag never has to wait for the first save.
+  async #saveMoves() {
+    try {
+      while (this.#moves.length) {
+        await this.#moves[0].save()
+        this.#moves.shift()
+      }
+    } catch (error) {
+      this.#moves.reverse().forEach(move => move.undo())
+      this.#moves = []
+      if (this.element.isConnected) window.alert("Couldn't save your card move. Please try again.")
+      console.error(error)
+    }
+  }
+}
