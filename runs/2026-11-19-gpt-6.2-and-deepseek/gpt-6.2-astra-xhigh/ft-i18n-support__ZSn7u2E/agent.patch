--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,14 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+export function locale() {
+  const language = document.documentElement.lang
+  return language === "en" ? "en-US" : language
+}
+
+// The locale meta tag is tracked by Turbo: changing language reloads the
+// document, including permanent elements and this dictionary.
+let messages
+export function t(key, values = {}) {
+  messages ||= JSON.parse(getMetaContent("client-translations"))
+  return messages[key].replace(/%\{(\w+)\}/g, (_, name) => values[name])
+}
