@@ -0,0 +1,71 @@
+---
+en:
+  playground:
+    orientation:
+      title: Finally, watch this Fizzy orientation video
+      instructions_html: "<p>There’s a whole lot more you can do in Fizzy. In the video below, 37signals founder and CEO, Jason Fried, will walk you through the basics in just 17 minutes.</p>"
+      caption: Fizzy orientation
+    passkey:
+      title: Then, set up a Passkey
+      instructions_html: "<p>Passkeys let you sign in securely without using passwords or email codes. To set one up, open the Fizzy menu and go to “<b><strong>My Profile > Manage Passkeys</b></strong>”. Using a passkey is optional, but recommended.</p>"
+      caption: Create a passkey to sign in without passwords or email codes
+      alt: Demo of adding a passkey
+    invite:
+      title: Now, grab the invite link to invite someone else
+      instructions_html: "<p>Open the Fizzy menu, select “<b><strong>+ Add people</b></strong>”, then copy the invite link. You can give this link to someone else so they can make a login for themselves in your account.</p>"
+      caption: Get a link to invite co-workers
+      alt: Demo of copying invite link
+    home:
+      title: Then, head back home to check out activity
+      instructions_html: "<p>Hit “1” or pull down the Fizzy menu and select “Home”.</p>"
+      caption: Go back to Home for Latest Activity
+      alt: Demo of visiting Home
+    assigned:
+      title: Now, check out all cards assigned to you
+      instructions_html: "<p>Pull down the Fizzy menu at the top of the screen, and select “<b><strong>Assigned to me</b></strong>” or just hit “2” on your keyboard any time.</p>"
+      caption: See all cards assigned to me
+      alt: Demo of navigating to 'Assigned to Me'
+    menu:
+      title: Then, open the Fizzy menu
+      instructions_html: "<p>The Fizzy menu is how you get around the app. Click “<b><strong>Fizzy</b></strong>” at the top of the screen or hit the “J” key on your keyboard to pop it open.</p>"
+      caption: Open the Fizzy menu
+      alt: Demo of opening the main menu
+    assign:
+      title: Next, assign this card to yourself
+      instructions_html: "<p>Click the little head with the + next to it, then pick yourself.</p>"
+      caption: Assign this to yourself
+      alt: Demo of assigning a card
+    tag:
+      title: Now, tag this card “Design” then move it to YES
+      instructions_html: "<p>Click the little Tag icon, type “design”, then “<b><strong>Create tag</b></strong>”. Then, move the card to the new “YES” column you created in the previous step.</p>"
+      caption: 'Tag this #design'
+      alt: Demo of tagging a card
+    columns:
+      title: Next, make two more columns
+      instructions_html: |-
+        <ol>
+          <li>Make one called "Yes"</li>
+          <li>Make another called "Working on"</li>
+        </ol>
+        <p>Go back to the Board view, click the little “+” to the right of the DONE column, name the column, pick a color, then do it again.</p>
+        <p><br></p>
+        <p>After that, drag this card to “DONE” or select “DONE” in the sidebar.</p>
+      caption: Make two more columns
+      alt: Demo of adding columns
+    postpone:
+      title: Second, move this card to NOT NOW
+      instructions_html: |-
+        <p>You can either select “NOT NOW” over in the sidebar, or you can go back out to the board view and drag this card into the “NOT NOW” column on the left side.</p>
+        <p><br></p>
+      caption: Move to Not Now
+      alt: Demo of moving a card to Not Now
+    rename:
+      title: First, rename this card
+      instructions_html: |-
+        <ol>
+          <li>Click the title and you can rename the card, change the description, or add more information to the card.</li>
+          <li>Then, hit "Mark as Done" at the bottom of the card.</li>
+          <li>Finally, hit “<b><strong>Back to Playground</strong></b>” in the top left of the screen to go back to the board.</li>
+        </ol>
+      caption: Rename this card
+      alt: Demo of renaming a card
