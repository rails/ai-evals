diff --git a/app/helpers/jobs_dashboard_helper.rb b/app/helpers/jobs_dashboard_helper.rb
new file mode 100644
index 0000000..af18fc4
--- /dev/null
+++ b/app/helpers/jobs_dashboard_helper.rb
@@ -0,0 +1,42 @@
+# Presentation adapter for the Japanese templates of mission_control-jobs.
+# The engine supplies its own English templates and helpers.
+module JobsDashboardHelper
+  def dashboard_sections
+    sections = { queues: [ t("dashboard.queues"), application_queues_path(@application) ] }
+    supported_job_statuses.without(:pending).each do |status|
+      label = t("dashboard.jobs_with_status", status: t(status, scope: "dashboard.status"), count: jobs_count_with_status(status))
+      sections[navigation_section_for_status(status)] = [ label, application_jobs_path(@application, status) ]
+    end
+    sections[:workers] = [ t("dashboard.workers"), application_workers_path(@application) ] if workers_exposed?
+    sections[:recurring_tasks] = [ t("dashboard.recurring_tasks"), application_recurring_tasks_path(@application) ] if recurring_tasks_supported?
+    sections
+  end
+
+  def dashboard_duration(time)
+    tag.span time_ago_in_words(time, include_seconds: true), title: l(time, format: :long)
+  end
+
+  def dashboard_relative_time(time)
+    distance = time_ago_in_words(time, include_seconds: true)
+    tag.span t(time.past? ? "dashboard.ago" : "dashboard.from_now", distance: distance), title: l(time, format: :long)
+  end
+
+  # Engine controllers return literal flash messages, not translation keys.
+  # Adapt those at the engine boundary; leave arbitrary job errors alone.
+  def dashboard_message(message)
+    case message
+    when /\ADiscarded (\d+) jobs\z/ then t("dashboard.discarded", count: $1)
+    when /\ARetried (\d+) jobs\z/ then t("dashboard.retried", count: $1)
+    when /\ADiscarded job with id (.+)\z/ then t("dashboard.discarded_job", id: $1)
+    when /\ARetried job with id (.+)\z/ then t("dashboard.retried_job", id: $1)
+    when /\ADispatched job with id (.+)\z/ then t("dashboard.dispatched_job", id: $1)
+    when /\AEnqueued recurring task (.+)\z/ then t("dashboard.enqueued_task", id: $1)
+    when "Something went wrong enqueuing this recurring task" then t("dashboard.enqueue_failed")
+    when "This server doesn't support recurring tasks" then t("dashboard.no_recurring_tasks")
+    when "This task can't be enqueued" then t("dashboard.not_runnable")
+    when "This server doesn't expose workers" then t("dashboard.no_workers")
+    when /\A(.+) not found\z/, /\ANo (?:application with id|server for) (.+) found\z/ then t("dashboard.not_found")
+    else message
+    end
+  end
+end
