new file mode 100644
index 0000000..8f6034e
--- /dev/null
+++ b/app/views/mission_control/jobs/jobs/_title.ja.html.erb
@@ -0,0 +1,19 @@
+<h1 class="title">
+  <div class="level">
+    <div class="level-left">
+      <%= job_title(job) %>
+      <div class="<%= modifier_for_status(job.status) %> tag ml-4"><%= t(job.status, scope: "dashboard.status") %></div>
