diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..a01a239
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,29 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :use_request_locale
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def use_request_locale(&action)
+      requested = params[:locale].presence_in(I18n.available_locales.map(&:to_s))
+      session[:locale] = requested if requested
+
+      identity = find_session_by_cookie&.identity
+      remember_locale(identity) if identity
+
+      I18n.with_locale(identity&.locale || session[:locale] || I18n.default_locale, &action)
+    end
+
+    # Keep anonymous choices in the session until the identity has been
+    # authenticated. Never update a preference based on an email address alone.
+    def remember_locale(identity)
+      if locale = session[:locale]
+        identity.update!(locale: locale) unless identity.locale == locale
+        session.delete(:locale)
+      end
+    end
+end
