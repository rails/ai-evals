diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..6666128
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "anonymous choice survives sign in and is restored in a clean session" do
+    untenanted do
+      get new_session_path
+      assert_select "html[lang=en] h1", "Get into Fizzy"
+
+      get new_session_path(locale: :ja)
+      assert_select "html[lang=ja] h1", "Fizzy にログイン"
+      get new_session_path(locale: "xx")
+      assert_select "html[lang=ja]"
+    end
+
+    sign_in_as :kevin
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    reset!
+    integration_session.default_url_options[:script_name] = accounts("37s").slug
+    sign_in_as :kevin
+    get root_path
+    assert_select "html[lang=ja]"
+    assert_select "a[href='#main']", "メインコンテンツへ移動"
+
+    get root_path(locale: :en)
+    assert_select "html[lang=en]"
+    assert_equal "en", identities(:kevin).reload.locale
+  end
+
+  test "the anonymous language applies to the first code email without modifying an unverified identity" do
+    identity = identities(:kevin)
+    untenanted do
+      get new_session_path(locale: "ja")
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      assert_includes ActionMailer::Base.deliveries.last.subject, "Fizzy の確認コード"
+      assert_nil identity.reload.locale
+    end
+  end
+
+  test "static errors give the explanation in both languages" do
+    %w[ 400 404 406-unsupported-browser 422 500 ].each do |page|
+      get "/#{page}.html"
+      assert_response :success
+      assert_select "h2", /[a-z]/i
+      assert_select "h2 [lang=ja]", /\p{Han}/
+      assert_select "div[lang=ja]", /\p{Hiragana}/
+      assert_select "a[href='/'] [lang=ja]", "ホームへ戻る"
+    end
+  end
+
+  test "a switch invalidates the previous representation and unknown locales are ignored" do
+    sign_in_as :david
+    get my_menu_path
+    assert_response :success
+    assert_select "summary", /Settings/
+    english_etag = response.headers.fetch("ETag")
+
+    get my_menu_path(locale: :ja), headers: { "If-None-Match" => english_etag }
+    assert_response :success
+    assert_select "summary", /設定/
+
+    get account_settings_path(locale: "xx")
+    assert_select "html[lang=ja]"
+    assert_select "label[aria-label^='権限：']"
+    assert_equal "ja", identities(:david).reload.locale
+
+    sign_out
+    sign_in_as :kevin
+    get account_settings_path
+    assert_select "html[lang=en]"
+    assert_select "label[aria-label^='Role:']"
+    assert_nil identities(:kevin).reload.locale
+  end
+end
diff --git a/test/lib/locale_catalog_test.rb b/test/lib/locale_catalog_test.rb
new file mode 100644
index 0000000..15bd72b
--- /dev/null
+++ b/test/lib/locale_catalog_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class LocaleCatalogTest < ActiveSupport::TestCase
+  test "Japanese covers the application messages and their interpolations" do
+    %w[ en.yml playground.en.yml ].each do |file|
+      english = YAML.load_file(Rails.root.join("config/locales", file)).fetch("en")
+      japanese = YAML.load_file(Rails.root.join("config/locales", file.sub("en.yml", "ja.yml"))).fetch("ja")
+      compare_messages english, japanese
+    end
+  end
+
+  private
+    def compare_messages(english, japanese, path = [])
+      english.each do |key, value|
+        message = [ *path, key ]
+        translation = japanese.fetch(key) { flunk "Missing Japanese message: #{message.join('.')}" }
+        if value.is_a?(Hash)
+          compare_messages(value, translation, message)
+        else
+          assert_predicate translation, :present?, message.join(".")
+          assert_equal value.scan(/%\{\w+\}/).uniq.sort, translation.scan(/%\{\w+\}/).uniq.sort, message.join(".")
+        end
+      end
+    end
+end
diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..984f1ee
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  test "account mail uses the intended recipient rather than the job's locale" do
+    user = users(:david)
+    identity = user.identity
+    identity.update!(locale: "ja")
+    account = user.account
+
+    export = Account::Export.create!(account: account, user: user)
+    import = Account::Import.create!(account: account, identity: identity, status: :failed, failure_reason: :conflict)
+    cancellation = Account::Cancellation.new(account: account, initiated_by: user)
+
+    [ [ AccountMailer.cancellation(cancellation), "解約" ],
+      [ ExportMailer.completed(export), "ダウンロード" ],
+      [ ImportMailer.completed(identity, account), "インポート" ],
+      [ ImportMailer.failed(import), "インポート" ],
+      [ UserMailer.email_change_confirmation(user: user, token: "test", email_address: "new@example.com"), "メールアドレス" ] ].each do |mail, phrase|
+      assert_includes mail.subject, phrase
+      parts = mail.multipart? ? mail.parts : [ mail ]
+      parts.each do |part|
+        assert_includes part.decoded, phrase
+        assert_not_includes part.decoded, "Translation missing"
+      end
+    end
+  end
+end
