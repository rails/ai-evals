diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..5629cd8
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create!(title: "Follow up", status: :published)
+  end
+
+  test "an assignment followed by two quiet weeks stalls a card until the next activity" do
+    @card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+    travel 2.weeks - 1.second
+    assert_not @card.reload.stalled?
+
+    travel 1.second
+    assert @card.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.reactions.create!(content: "👍")
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "a burst needs three human comments from at least two people" do
+    comment_by :david
+    comment_by :kevin
+    comment_by :system
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    comment_by :kevin
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "comments by a single person don't make a burst" do
+    4.times { comment_by :kevin }
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "the rolling comment window uses the board override, including its boundary" do
+    @card.board.auto_postpone_period = 3.days
+    comment_by :david
+    travel 1.day + 1.second
+    comment_by :kevin
+    comment_by :kevin
+    assert_not @card.reload.had_burst?
+
+    travel 1.day
+    comment_by :david
+    assert @card.reload.had_burst?
+  end
+
+  test "a board without an override uses the account period, even for backdated comments arriving out of order" do
+    @card.board.entropy.destroy!
+    @card.reload
+    comment_by :david, at: 20.days.ago
+    comment_by :david, at: 10.days.ago
+    comment_by :kevin, at: 15.days.ago
+    assert @card.reload.had_burst?
+  end
+
+  test "reopening starts the quiet period; closed, postponed, and draft cards are not stalled" do
+    @card.close
+    travel 2.weeks
+    @card.reopen
+    assert_not @card.reload.stalled?
+    travel 2.weeks
+    assert @card.stalled?
+
+    @card.close
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.postpone
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.drafted!
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "editing the card and its steps restarts the quiet period without another burst" do
+    @card.toggle_assignment(users(:kevin))
+    travel 2.weeks
+    @card.update! description: "New plan"
+    assert_not @card.reload.stalled?
+
+    travel 2.weeks
+    assert @card.stalled?
+    @card.steps.create!(content: "Try again")
+    assert_not @card.reload.stalled?
+  end
+
+  private
+    def comment_by(user, at: Time.current)
+      @card.comments.create!(creator: users(user), body: "Comment", created_at: at)
+    end
+end
