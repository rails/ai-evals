+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  test "stalled badge on the index, the card, and public cards" do
+    card = cards(:layout)
+    step = card.steps.create!(content: "Follow up")
+    card.update!(last_active_at: 15.days.ago)
+    card.board.publish
+    sign_in_as users(:david)
+
+    [ cards_path(indexed_by: "stalled"),
+      public_board_column_path(card.board.publication.key, card.column), published_card_path(card), card_path(card) ].each do |path|
+      visit path
+      assert_selector "#bubble_card_#{card.id}", text: /stalled/i
+    end
+
+    find("#step_#{step.id} input[type=checkbox]").click
+    assert_no_selector "#bubble_card_#{card.id}", text: /stalled/i
+  end
+end
