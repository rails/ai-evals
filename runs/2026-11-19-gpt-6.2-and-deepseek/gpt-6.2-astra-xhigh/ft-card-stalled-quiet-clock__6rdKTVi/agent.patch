diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..80fdd41
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,33 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks.to_i
+
+  included do
+    scope :stalled, -> { active.where(had_burst: true, last_active_at: ..(Time.current - STALL_PERIOD)) }
+  end
+
+  def stalls_at
+    last_active_at + STALL_PERIOD if had_burst? && active?
+  end
+
+  def stalled?
+    had_burst? && last_active_at <= Time.current - STALL_PERIOD && active?
+  end
+
+  def record_comment_activity(comment)
+    touch_last_active_at(burst: !had_burst? && comment_burst?(around: comment.created_at))
+  end
+
+  def comment_burst?(around: nil)
+    window = auto_postpone_period / 3
+    discussion = comments.by_user
+    discussion = discussion.where(created_at: (around - window)..(around + window)) if around
+
+    # Any qualifying window contains three consecutive comments with mixed authors.
+    timeline = discussion.select(:id, :created_at, :creator_id).find_each(cursor: [ :created_at, :id ])
+    timeline.each_cons(3).any? do |first, middle, last|
+      last.created_at - first.created_at <= window && (first.creator_id != middle.creator_id || middle.creator_id != last.creator_id)
+    end
+  end
+end
