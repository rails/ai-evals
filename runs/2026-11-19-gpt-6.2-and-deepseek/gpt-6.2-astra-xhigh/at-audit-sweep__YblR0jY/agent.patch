diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..707ff1c
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "title searches return active matches only from readable books" do
+    section = leaves(:welcome_section)
+    page = leaves(:welcome_page)
+    page.update!(book: books(:manual))
+    leaves(:summary_page).update!(title: "Welcome back", status: :trashed)
+
+    assert_results "elcom", section
+
+    books(:manual).update!(published: true)
+    assert_results "elcom", section, page
+
+    sign_out
+    assert_results "elcom", page
+  end
+
+  test "apostrophes in titles are searchable" do
+    page = leaves(:welcome_page)
+    page.update!(title: "Reader's guide")
+    assert_results "Reader's", page
+  end
+
+  test "percent, underscore and the escape character are literal title characters" do
+    sale = leaves(:welcome_page)
+    sale.update!(title: "Save 50% off")
+    chapter = leaves(:summary_page)
+    chapter.update!(title: "Chapter_one!")
+
+    assert_results "Save 50% off", sale
+    assert_results "%", sale
+    assert_results "_", chapter
+    assert_results "!", chapter
+  end
+
+  private
+    def assert_results(query, *leaves)
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_equal leaves.map { |leaf| leafable_slug_path(leaf) }, assert_select("a.search__result").map { |a| a["href"] }
+    end
+end
