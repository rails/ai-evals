+++ b/test/extra/rolling_upgrade_handoff.rb
@@ -0,0 +1,38 @@
+# frozen_string_literal: true
+
+# Run with `rails runner -e test` in each release, against the same disposable
+# fixture database. Only browser-visible bytes cross between processes.
+abort 'Use a disposable test database' unless Rails.env.test?
+mode, file = ARGV
+abort 'Usage: rolling_upgrade_handoff.rb write|read FILE' unless %w(write read).include?(mode) && file
+
+ActionController::Base.allow_forgery_protection = true
+Rails.application.config.redmine_verify_sessions = true
+browser = ActionDispatch::Integration::Session.new(Rails.application)
+name = Rails.application.config.session_options.fetch(:key)
+watcher = User.find(3)
+issue = Issue.find(2)
+issue.set_watcher(watcher, true)
+
+if mode == 'write'
+  browser.get '/login'
+  csrf = Nokogiri::HTML(browser.response.body).at_css('form[action="/login"] input[name=authenticity_token]')['value']
+  browser.post '/login', params: {username: 'jsmith', password: 'jsmith', authenticity_token: csrf}
+  browser.get '/my/account'
+  abort 'Login failed' unless browser.response.successful? && browser.request.session[:user_id] == 2
+  form = Nokogiri::HTML(browser.response.body).at_css('#my_account_form input[name=authenticity_token]')['value']
+
+  Setting.plain_text_mail = '0'
+  mail = Mailer.issue_add(watcher, issue)
+  link = mail.text_part.body.decoded[%r{https?://\S+/mail_links/unwatch\?token=\S+}]
+  abort 'No unwatch link' unless link
+  File.open(file, 'w', 0o600) {|io| io.write(JSON.generate([browser.cookies[name], form, URI.parse(link).request_uri]))}
+else
+  cookie, form, link = JSON.parse(File.read(file))
+  browser.cookies[name] = cookie
+  browser.put '/my/account', params: {authenticity_token: form}
+  abort 'Session or open form lost' unless browser.response.redirect? && browser.request.session[:user_id] == 2
+  browser.get link
+  abort 'Unwatch failed' unless browser.response.successful? && !issue.reload.watched_by?(watcher)
+end
+puts "#{mode} OK (Rails #{Rails.version})"
