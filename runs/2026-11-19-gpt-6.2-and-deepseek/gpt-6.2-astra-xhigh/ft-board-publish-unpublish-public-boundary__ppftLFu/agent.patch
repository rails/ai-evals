index 0000000..ca34a37
--- /dev/null
+++ b/test/integration/public_boards_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class PublicBoardsTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @column = columns(:writebook_triage)
+    @card = cards(:logo)
+    sign_in_as :kevin
+  end
+
+  test "an admin can share a board and revoke the board, column and card URLs together" do
+    @card.update!(description: "<p>A <strong>formatted</strong> description</p>")
+    @card.steps.create!(content: "First step")
+    assert_nil public_url
+
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    url = public_url
+    assert_match %r{/public/boards/[^/]+\z}, url
+    column_url = "#{url}/columns/#{@column.id}"
+    card_url = "#{url}/cards/#{@card.number}"
+
+    post board_publication_path(@board), as: :json
+    assert_equal url, public_url
+    sign_out
+
+    get url
+    assert_response :success
+    assert_select "a[href=?]", URI(column_url).path, text: @column.name
+    assert_select "a[href=?]", URI(card_url).path
+
+    get column_url
+    assert_response :success
+    assert_select "a[href=?]", URI(card_url).path
+
+    get card_url
+    assert_response :success
+    assert_select "h1", @card.title
+    assert_select "strong", "formatted"
+    assert_select "li", text: "First step"
+    assert_select "form", count: 0
+
+    sign_in_as :kevin
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert_nil public_url
+    get url
+    assert_response :not_found
+
+    post board_publication_path(@board), as: :json
+    assert_not_equal url, public_url
+    [ url, column_url, card_url ].each do |old_url|
+      get old_url
+      assert_response :not_found
+    end
+  end
+
+  test "board creators without an admin role cannot publish or unpublish" do
+    logout_and_sign_in_as :david
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_nil public_url
+
+    logout_and_sign_in_as :kevin
+    post board_publication_path(@board), as: :json
+    url = public_url
+    logout_and_sign_in_as :david
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_equal url, public_url
+  end
+
+  test "the public key only reveals published cards and columns from its own board" do
+    draft = @board.cards.create!(title: "Draft for later", column: @column, creator: users(:kevin), status: :drafted)
+    other = boards(:private)
+    other_card = with_current_user(:kevin) { other.cards.create!(title: "Unrelated", status: :published) }
+    other_column = other.columns.create!(name: "Unrelated column")
+    @board.publish
+    sign_out
+
+    get public_board_path(@board.public_key)
+    assert_response :success
+    assert_select "main", text: /#{Regexp.escape(draft.title)}/, count: 0
+    assert_select "main", text: /Unrelated/, count: 0
+
+    get public_board_column_path(@board.public_key, @column)
+    assert_response :success
+    assert_select "main", text: /#{Regexp.escape(draft.title)}/, count: 0
+    assert_select "a[href=?]", public_board_card_path(@board.public_key, cards(:text)), count: 0
+
+    [ public_board_card_path(@board.public_key, draft), public_board_card_path(@board.public_key, other_card),
+      public_board_column_path(@board.public_key, other_column), public_board_path(@board.id),
+      public_board_path(@board.public_key, script_name: accounts(:initech).slug) ].each do |path|
+      get path
+      assert_response :not_found
+    end
+  end
+
+  test "publishing a private board does not grant access to its member pages" do
+    @board = boards(:private)
+    get edit_board_path(@board)
+    assert_select "form[action=?]", board_publication_path(@board)
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    url = public_url
+    get edit_board_path(@board)
+    assert_select "a[href=?]", url, text: "Open public board"
+
+    logout_and_sign_in_as :david
+    get url
+    assert_response :success
+    assert_select "h1", @board.name
+    get board_path(@board)
+    assert_response :not_found
+    sign_out
+    get board_path(@board)
+    assert_response :redirect
+    delete board_publication_path(@board)
+    assert_response :redirect
+    get url
+    assert_response :success
+  end
+
+  test "publication changes are limited to boards the admin can access" do
+    post board_publication_path(boards(:miltons_wish_list)), as: :json
+    assert_response :not_found
+    assert_not boards(:miltons_wish_list).reload.published?
+  end
+
+  private
+    def public_url
+      get board_path(@board), as: :json
+      assert_response :success
+      response.parsed_body.fetch("public_url")
+    end
+end
