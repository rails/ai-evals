diff --git a/app/controllers/public/base_controller.rb b/app/controllers/public/base_controller.rb
new file mode 100644
index 0000000..9e158cc
--- /dev/null
+++ b/app/controllers/public/base_controller.rb
@@ -0,0 +1,28 @@
+class Public::BaseController < ApplicationController
+  layout "public"
+
+  allow_unauthenticated_access
+  skip_before_action :require_account
+  before_action :set_published_board
+  after_action do
+    no_store
+    response.headers["Referrer-Policy"] = "no-referrer"
+  end
+
+  # Even when entering via the key alone, generate account-scoped links (including blob URLs).
+  def url_options
+    if @board && request.script_name.empty?
+      super.merge(script_name: @board.account.slug)
+    else
+      super
+    end
+  end
+
+  private
+    def set_published_board
+      publications = Board::Publication.where(account: Account.active)
+      publications = publications.where(account: Current.account) if request.script_name.present?
+      @publication = publications.find_by!(key: params[:key])
+      @board = @publication.board
+    end
+end
