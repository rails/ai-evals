new file mode 100644
index 0000000..7c91c4f
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,19 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy
+  end
+
+  def publish
+    with_lock { publication || create_publication! }
+  end
+
+  def unpublish
+    with_lock { self.publication = nil }
+  end
+
+  def published?
+    publication.present?
+  end
+end
