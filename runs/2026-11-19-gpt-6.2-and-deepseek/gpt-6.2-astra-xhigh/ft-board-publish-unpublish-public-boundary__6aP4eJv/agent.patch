diff --git a/test/integration/board_publication_test.rb b/test/integration/board_publication_test.rb
new file mode 100644
index 0000000..8e8cb03
--- /dev/null
+++ b/test/integration/board_publication_test.rb
@@ -0,0 +1,180 @@
+require "test_helper"
+
+class BoardPublicationTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "publishing and unpublishing a board" do
+    sign_in_as :kevin
+    assert_nil public_url
+
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    url = public_url
+    assert_match %r{/public/boards/[^/]+\z}, url
+
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    assert_equal url, public_url
+
+    column = columns(:writebook_triage)
+    card = cards(:logo)
+    sign_out
+
+    get url
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a[href=?]", URI(url).path + "/columns/#{column.id}"
+
+    get "#{url}/columns/#{column.id}"
+    assert_response :success
+    assert_select "a[href=?]", URI(url).path + "/cards/#{card.number}"
+
+    get "#{url}/cards/#{card.number}"
+    assert_response :success
+    assert_select "h1", text: card.title
+    assert_select "form", count: 0
+
+    sign_in_as :kevin
+    delete board_publication_path(@board), as: :json
+    assert_response :success
+    assert_nil public_url
+
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    assert_not_equal url, public_url
+
+    [ url, "#{url}/columns/#{column.id}", "#{url}/cards/#{card.number}" ].each do |revoked_url|
+      get revoked_url
+      assert_response :not_found
+    end
+  end
+
+  test "changing publication requires authentication" do
+    post board_publication_path(@board)
+    assert_redirected_to new_session_path(script_name: nil)
+    assert_not_predicate @board.reload, :published?
+
+    publication = @board.publish
+    delete board_publication_path(@board)
+    assert_redirected_to new_session_path(script_name: nil)
+    assert_equal publication, @board.reload.publication
+  end
+
+  test "a non-admin cannot change publication, even as the board creator" do
+    sign_in_as @board.creator
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_nil public_url
+
+    logout_and_sign_in_as :kevin
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    url = public_url
+
+    logout_and_sign_in_as @board.creator
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_equal url, public_url
+  end
+
+  test "only columns and published cards on the matching board are visible" do
+    column = columns(:writebook_triage)
+    draft = @board.cards.create!(title: "Unpublished work", creator: users(:david), status: :drafted, column: column)
+    other_column = boards(:private).columns.create!(name: "Private column")
+    Current.session = sessions(:kevin)
+    other_card = boards(:private).cards.create!(title: "Private card", creator: users(:kevin), status: :published)
+
+    sign_in_as :kevin
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    url = public_url
+    sign_out
+
+    [ url, "#{url}/columns/#{column.id}" ].each do |listing|
+      get listing
+      assert_response :success
+      assert_no_match draft.title, response.body
+      assert_no_match other_card.title, response.body
+    end
+
+    [ "columns/#{other_column.id}", "cards/#{other_card.number}", "cards/#{draft.number}" ].each do |resource|
+      get "#{url}/#{resource}"
+      assert_response :not_found
+    end
+
+    get "#{accounts(:initech).slug}/public/boards/#{url.split('/').last}"
+    assert_response :not_found
+  end
+
+  test "possession of the key grants read-only access without board membership or an account prefix" do
+    board = boards(:private)
+    publication = board.publish
+    column = board.columns.create!(name: "In progress")
+    Current.session = sessions(:kevin)
+    card = board.cards.create!(status: :published, title: "Announcement", description: "Hello!", column: column)
+
+    sign_in_as :mike
+    path = public_board_path(publication, script_name: "")
+    get path
+    assert_response :success
+    assert_select "h1", text: board.name
+
+    get "#{path}/columns/#{column.id}"
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(publication, card)
+
+    get "#{path}/cards/#{card.number}"
+    assert_response :success
+    assert_select ".card__description", text: /Hello!/
+
+    get board_path(board)
+    assert_redirected_to session_menu_path(script_name: nil)
+  end
+
+  test "a board ID is not a publication key" do
+    @board.publish
+    get public_board_path(@board.id)
+    assert_response :not_found
+  end
+
+  test "publication cannot bypass account cancellation" do
+    publication = @board.publish
+    @board.account.create_cancellation!(initiated_by: users(:jason))
+    get public_board_path(publication)
+    assert_response :not_found
+  end
+
+  test "an admin cannot publish a board they cannot access" do
+    sign_in_as :kevin
+    post board_publication_path(boards(:miltons_wish_list)), as: :json
+    assert_response :not_found
+  end
+
+  test "publication controls on the board settings page" do
+    sign_in_as :kevin
+    get edit_board_path(@board)
+    assert_select "button", text: "Publish board"
+
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    follow_redirect!
+    assert_select "a[href=?]", public_board_url(@board.reload.publication), text: "View public board"
+    assert_select "button", text: "Unpublish board"
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+
+    logout_and_sign_in_as @board.creator
+    get edit_board_path(@board)
+    assert_select "form[action=?]", board_publication_path(@board), count: 0
+  end
+
+  private
+    def public_url
+      get board_path(@board), as: :json
+      assert_response :success
+      response.parsed_body.fetch("public_url")
+    end
+end
