+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "a board has at most one live key and republishing generates a new one" do
+    board = boards(:writebook)
+    assert_not_predicate board, :published?
+
+    publication = board.publish
+    assert_predicate board, :published?
+    assert_equal publication, board.publish
+
+    board.unpublish
+    board.unpublish
+    assert_not_predicate board, :published?
+    assert_not_equal publication.key, board.publish.key
+  end
+end
