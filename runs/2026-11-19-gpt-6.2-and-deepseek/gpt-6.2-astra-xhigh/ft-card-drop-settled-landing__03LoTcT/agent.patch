diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..44f1873
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,134 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+    visit board_url(boards(:writebook))
+  end
+
+  test "dropping into a column places the card in its final position before saving" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_triage)
+    destination = find("##{dom_id(column)}")
+    assert_selector "##{dom_id(cards(:logo), :article)}", visible: :all
+
+    page.execute_script <<~JS
+      const fetch = window.fetch
+      window.fetch = async (...args) => {
+        if (args[1]?.method === "POST") {
+          await new Promise(resolve => window.releaseSave = resolve)
+        }
+        return fetch(...args)
+      }
+    JS
+
+    find("##{dom_id(card, :article)}").drag_to(destination)
+
+    expected = [ cards(:logo), card, cards(:layout) ].map { |c| dom_id(c, :article) }
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", visible: :all
+    assert_equal expected, destination.all("article.card", visible: :all).map { |article| article[:id] }
+    assert_selector "#maybe .cards__expander-count", text: "0", visible: :all
+    assert_selector "##{dom_id(column)} .cards__expander-count", text: "3", visible: :all
+    assert_includes destination.find("##{dom_id(card, :article)}", visible: :all)[:style], column.color.to_s
+    assert_nil card.reload.column
+
+    page.execute_script("window.releaseSave()")
+    assert_no_selector "##{dom_id(card, :article)}[aria-busy]", visible: :all
+    assert_equal column, card.reload.column
+    assert_equal expected, destination.all("article.card", visible: :all).map { |article| article[:id] }
+    refresh
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", visible: :all
+    assert_equal expected, find("##{dom_id(column)}").all("article.card", visible: :all).map { |article| article[:id] }
+  end
+
+  test "dragging changes status both into and out of the special columns" do
+    card = cards(:buy_domain)
+    drag_card card, to: "#closed-cards"
+    assert_predicate card.reload, :closed?
+
+    find("#closed-cards .cards__expander").click
+    drag_card card, to: "#not-now"
+    assert_predicate card.reload, :postponed?
+
+    find("#not-now .cards__expander").click
+    drag_card card, to: "#maybe"
+    assert_predicate card.reload, :awaiting_triage?
+    assert_selector "#not-now .blank-slate--drag", text: "Drag cards here", visible: :all
+  end
+
+  test "only a different column is a drop target and cancelling clears drag feedback" do
+    card = cards(:layout)
+    source = "##{dom_id(card.column)}"
+    find("#{source} .cards__expander").click
+    article = find("##{dom_id(card, :article)}")
+    count = card.events.count
+    order = find(source).all("article.card").map { |c| c[:id] }
+
+    page.execute_script <<~JS, article, find("#maybe .cards__list")
+      const [card, destination] = arguments
+      const dataTransfer = new DataTransfer()
+      window.dragEvent = (el, type) => el.dispatchEvent(new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer }))
+      dragEvent(card, "dragstart")
+      dragEvent(destination, "dragover")
+    JS
+    assert_selector "#maybe.drag-and-drop__hover-container"
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+
+    page.execute_script('dragEvent(arguments[0], "dragend")', article)
+    assert_no_selector ".drag-and-drop__hover-container, .drag-and-drop__dragged-item"
+
+    page.execute_script <<~JS, article, find(source)
+      dragEvent(arguments[0], "dragstart")
+      dragEvent(arguments[1], "dragover")
+      dragEvent(arguments[1], "drop")
+      dragEvent(arguments[0], "dragend")
+    JS
+    assert_no_selector ".drag-and-drop__hover-container, .drag-and-drop__dragged-item"
+    assert_equal order, find(source).all("article.card").map { |c| c[:id] }
+    assert_equal count, card.events.count
+  end
+
+  test "a rejected save restores the original card, position and counts" do
+    card = cards(:logo)
+    source = "##{dom_id(card.column)}"
+    find("#{source} .cards__expander").click
+    page.execute_script <<~JS
+      const fetch = window.fetch
+      window.fetch = (...args) => args[1]?.method === "POST" ? Promise.resolve(new Response(null, { status: 422 })) : fetch(...args)
+    JS
+
+    find("##{dom_id(card, :article)}").drag_to(find("#not-now"))
+    assert_text "The card couldn’t be moved"
+
+    assert_selector "#{source} article.card:first-child", id: dom_id(card, :article)
+    assert_selector "#{source} .cards__expander-count", text: "2", visible: :all
+    assert_selector "#not-now .cards__expander-count", text: "0", visible: :all
+    assert_no_selector "#not-now article.card", visible: :all
+  end
+
+  test "loading the next page after drops neither skips nor duplicates cards" do
+    column = columns(:writebook_triage)
+    Current.user = users(:david)
+    15.times { |i| column.cards.create!(board: column.board, title: "Golden #{i}", status: :published).gild }
+    refresh
+
+    selector = "##{dom_id(column)}"
+    assert_selector "#{selector} article.card", count: 15, visible: :all
+    drag_card cards(:buy_domain), to: selector
+    find("#{selector} .cards__expander").click
+    drag_card column.cards.active.golden.latest.first, to: "#maybe"
+    page.execute_script("arguments[0].scrollIntoView({ block: 'center' })", find("#{selector} .pagination-link", visible: :all))
+
+    expected = column.cards.active.latest.with_golden_first.map { |card| dom_id(card, :article) }
+    assert_selector "#{selector} article.card", count: expected.size
+    assert_equal expected, find(selector).all("article.card").map { |article| article[:id] }
+  end
+
+  private
+    def drag_card(card, to:)
+      find("##{dom_id(card, :article)}").drag_to(find(to))
+      assert_selector "#{to} ##{dom_id(card, :article)}:not([aria-busy])", visible: :all
+    end
+end
