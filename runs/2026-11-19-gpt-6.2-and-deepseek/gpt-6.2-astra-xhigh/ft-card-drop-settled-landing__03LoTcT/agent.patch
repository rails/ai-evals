diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..c948b42
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,198 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { post, destroy } from "@rails/request.js"
+
+const CARD = "article[data-card-triage-url]"
+const COLUMN = "[data-drop-status]"
+const DRAGGED = "drag-and-drop__dragged-item"
+const HOVER = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "card", "errorMessage" ]
+
+  #card
+  #hoverColumn
+  #saves = Promise.resolve()
+
+  cardTargetConnected(card) {
+    this.#enableDragging(card)
+  }
+
+  cardTargetDisconnected(card) {
+    card.removeAttribute("draggable")
+    if (card === this.#card) this.end()
+  }
+
+  disconnect() {
+    this.end()
+  }
+
+  // Recheck on pointer down after a Turbo morph or a viewport resize.
+  prepare({ target }) {
+    const card = target.closest(CARD)
+    if (card) this.#enableDragging(card)
+  }
+
+  start({ target, dataTransfer }) {
+    if (!target.matches(CARD) || !target.draggable) return
+
+    this.#card = target
+    dataTransfer.effectAllowed = "move"
+    dataTransfer.setData("text/plain", target.id)
+    target.classList.add(DRAGGED)
+  }
+
+  over(event) {
+    const column = this.#destination(event.target)
+    this.#highlight(column)
+    if (column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave({ relatedTarget }) {
+    if (!this.#hoverColumn?.contains(relatedTarget)) this.#highlight(null)
+  }
+
+  drop(event) {
+    const card = this.#card
+    const column = this.#destination(event.target)
+    this.end()
+
+    if (column) {
+      event.preventDefault()
+      this.#move(card, column)
+    }
+  }
+
+  end() {
+    this.#card?.classList.remove(DRAGGED)
+    this.#card = null
+    this.#highlight(null)
+  }
+
+  // Continue from the actual end of the loaded pages, not their pre-drop sizes.
+  async paginate(event) {
+    const frame = event.target
+    if (!frame.matches(".cards__list [data-controller~='pagination'] > turbo-frame[src]")) return
+
+    event.preventDefault()
+    await this.#saves
+    const pages = Array.from(frame.parentElement?.children || [])
+    const sizes = pages.slice(0, pages.indexOf(frame)).map(page => page.querySelectorAll(CARD).length)
+    event.detail.url.searchParams.set("loaded_pages", sizes.join(","))
+    event.detail.resume()
+  }
+
+  pageLoaded({ target }) {
+    const list = target.closest(".cards__list")
+    for (const tail of list?.querySelectorAll(`:scope > ${CARD}`) || []) {
+      if (target.querySelector(`#${tail.id}`)) tail.remove()
+    }
+  }
+
+  #enableDragging(card) {
+    card.draggable = !card.hasAttribute("aria-busy") && matchMedia("(min-width: 640px)").matches
+  }
+
+  #destination(target) {
+    const source = this.#card?.closest(COLUMN)
+    const destination = target.closest(COLUMN)
+    if (!source || !destination || source === destination) return
+
+    if (destination.querySelector(".cards__list turbo-frame") && ![ source, destination ].some(column => column.querySelector("turbo-frame[busy]"))) {
+      return destination
+    }
+  }
+
+  #highlight(column) {
+    if (this.#hoverColumn !== column) {
+      this.#hoverColumn?.classList.remove(HOVER)
+      column?.classList.add(HOVER)
+      this.#hoverColumn = column
+    }
+  }
+
+  #move(card, destination) {
+    const source = card.closest(COLUMN)
+    const marker = document.createComment("card before drop")
+    const preview = this.#previewFor(card, destination)
+    card.replaceWith(marker)
+    this.#insert(preview, destination)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(destination, 1)
+
+    // Save in drop order: each move becomes the latest activity in its destination.
+    this.#saves = this.#saves.then(async () => {
+      try {
+        const response = await this.#save(card, destination)
+        if (!response.ok) throw new Error("Card move failed")
+        Turbo.morphElements(preview, await response.text)
+        this.#enableDragging(preview)
+        marker.remove()
+      } catch {
+        if (marker.isConnected && preview.isConnected) {
+          preview.remove()
+          marker.replaceWith(card)
+          this.#adjustCount(source, 1)
+          this.#adjustCount(destination, -1)
+          document.getElementById("flash")?.replaceWith(this.errorMessageTarget.content.cloneNode(true))
+        }
+      }
+    })
+  }
+
+  #previewFor(card, column) {
+    const preview = card.cloneNode(true)
+    preview.setAttribute("aria-busy", "true")
+    preview.removeAttribute("aria-selected")
+    preview.draggable = false
+    preview.classList.toggle("card--active", this.#isActiveColumn(column))
+    preview.classList.toggle("card--postponed", column.dataset.dropStatus === "not-now")
+    preview.style.setProperty("--card-color", column.style.getPropertyValue("--card-color") || "var(--color-card-default)")
+    preview.querySelector(".card__closed")?.remove()
+    preview.querySelector(".bubble")?.remove()
+    preview.querySelector(".card__meta-text--updated time").dateTime = Math.floor(Date.now() / 1000)
+    return preview
+  }
+
+  #insert(card, column) {
+    const list = column.querySelector(".cards__list")
+    const pages = list.querySelector("[data-controller~='pagination']")
+    const firstOrdinary = list.querySelector(`${CARD}:not(.golden-effect)`)
+
+    if (!this.#isActiveColumn(column) || card.classList.contains("golden-effect")) {
+      pages.firstElementChild.prepend(card)
+    } else if (firstOrdinary) {
+      firstOrdinary.before(card)
+    } else if (pages.lastElementChild.querySelector(".pagination-link")) {
+      // There may be more golden cards on the next page. Keep this preview after
+      // the loaded prefix until pagination reaches its saved position.
+      list.append(card)
+    } else {
+      pages.lastElementChild.append(card)
+    }
+  }
+
+  #isActiveColumn(column) {
+    return [ "maybe", "column" ].includes(column.dataset.dropStatus)
+  }
+
+  #adjustCount(column, delta) {
+    const expander = column.querySelector(".cards__expander")
+    const count = Number(expander.style.getPropertyValue("--card-count")) + delta
+    expander.style.setProperty("--card-count", count)
+    expander.querySelector(".cards__expander-count").textContent = count > 99 ? "99+" : count
+  }
+
+  #save(card, column) {
+    const options = { responseKind: "html", redirect: "error", query: { card_preview: true } }
+    switch (column.dataset.dropStatus) {
+      case "column": return post(card.dataset.cardTriageUrl, { ...options, body: { column_id: column.dataset.columnId } })
+      case "maybe": return destroy(card.dataset.cardTriageUrl, options)
+      case "not-now": return post(card.dataset.cardNotNowUrl, options)
+      case "closed": return post(card.dataset.cardClosureUrl, options)
+    }
+  }
+}
