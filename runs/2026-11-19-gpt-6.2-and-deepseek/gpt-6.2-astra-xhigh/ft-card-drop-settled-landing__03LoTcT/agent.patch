diff --git a/app/controllers/concerns/column_pagination.rb b/app/controllers/concerns/column_pagination.rb
new file mode 100644
index 0000000..f581a32
--- /dev/null
+++ b/app/controllers/concerns/column_pagination.rb
@@ -0,0 +1,18 @@
+module ColumnPagination
+  private
+    def set_column_page(cards)
+      set_page_and_extract_portion_from cards, per_page: column_page_sizes
+    end
+
+    # On the board, drops can grow or shrink pages that have already been rendered.
+    # Keep the normal gear for the requested page; only its starting offset changes.
+    def column_page_sizes
+      if turbo_frame_request? && params[:loaded_pages].present?
+        sizes = params.expect(:loaded_pages).split(",").map { |size| size.to_i.clamp(0, Current.account.cards_count) }
+        if sizes.size == params[:page].to_i - 1
+          gears = GearedPagination::Ratios::DEFAULTS
+          sizes + (gears.drop(sizes.size).presence || [ gears.last ])
+        end
+      end
+    end
+end
