@@ -0,0 +1,58 @@
+require "test_helper"
+
+class BookSearchRateLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    @handbook, @manual = books(:handbook, :manual)
+    [ @handbook, @manual ].each { |book| book.update!(published: true) }
+    Leaf.reindex_all
+  end
+
+  test "search budget is shared across books, not readers or other actions" do
+    reader = { "REMOTE_ADDR" => "192.0.2.1" }
+    other_reader = { "REMOTE_ADDR" => "192.0.2.2" }
+
+    freeze_time do
+      30.times do
+        post book_search_path(@manual), params: { search: "Thanks" }, headers: reader
+        assert_response :success
+      end
+
+      post book_search_path(@handbook), params: { search: "Thanks" }, headers: reader
+      assert_response :too_many_requests
+
+      post book_search_path(@handbook), params: { search: "Thanks" }, headers: other_reader
+      assert_response :success
+      assert_select "a", text: /Thanks for reading/i
+
+      get leafable_slug_path(leaves(:welcome_page)), headers: reader
+      assert_response :success
+    end
+  end
+
+  test "each search frees its place one minute later" do
+    reader = { "REMOTE_ADDR" => "192.0.2.3" }
+    search = -> { post book_search_path(@handbook), params: { search: "Thanks" }, headers: reader }
+
+    freeze_time do
+      search.call
+      assert_response :success
+
+      travel 59.seconds
+      29.times do
+        search.call
+        assert_response :success
+      end
+
+      travel 1.second
+      search.call
+      assert_response :success
+      search.call
+      assert_response :too_many_requests
+
+      travel 1.minute
+      search.call
+      assert_response :success
+      assert_select "a", text: /Thanks for reading/i
+    end
+  end
+end
