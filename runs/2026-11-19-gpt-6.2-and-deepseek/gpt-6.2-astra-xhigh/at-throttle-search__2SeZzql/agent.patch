diff --git a/app/models/book/search_rate_limit.rb b/app/models/book/search_rate_limit.rb
new file mode 100644
index 0000000..039123c
--- /dev/null
+++ b/app/models/book/search_rate_limit.rb
@@ -0,0 +1,19 @@
+class Book::SearchRateLimit
+  # Keep enforcing the limit when general-purpose caching is disabled in dev/test.
+  STORE = Rails.cache.is_a?(ActiveSupport::Cache::NullStore) ? ActiveSupport::Cache::MemoryStore.new : Rails.cache
+
+  def self.allow?(ip)
+    # Each accepted search holds one slot for its own minute, not until a shared counter resets.
+    slots = Array.new(30) { |n| "rate-limit:book-search:#{ip}:#{n}" }
+
+    if STORE.is_a?(ActiveSupport::Cache::RedisCacheStore)
+      # Skip occupied slots in one round trip. The conditional write below arbitrates concurrent claims.
+      slots -= STORE.read_multi(*slots, raw: true).keys
+    end
+
+    slots.any? do |slot|
+      # False means the slot is occupied; nil means the cache is down (fail open for readers).
+      STORE.write(slot, 1, raw: true, expires_in: 1.minute, unless_exist: true) != false
+    end
+  end
+end
