diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..a5aa111
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    Current.session = sessions(:david)
+    @card = cards(:buy_domain)
+  end
+
+  test "a comment burst uses a rolling third of the effective auto-close period" do
+    @card.board.update! auto_postpone_period: 7.days
+    window = (7.days.to_i / 3).seconds
+
+    comment :david
+    travel window + 1.second
+    comment :kevin
+    comment :kevin
+    travel 2.weeks
+    assert_not_stalled
+
+    comment :david
+    travel window
+    comment :david
+    comment :kevin
+    travel 2.weeks - 1.second
+    assert_not_stalled
+    travel 1.second
+    assert_stalled
+  end
+
+  test "backdated comments use their timestamps and the account period when there is no board override" do
+    @card.board.entropy.destroy!
+    @card.reload
+    comment :david, at: 10.days.ago
+    comment :kevin
+    travel 2.weeks
+    assert_not_stalled
+
+    comment :david, at: 2.weeks.ago - 5.days
+    travel 2.weeks
+    assert_stalled
+  end
+
+  test "comments must be on this card and from at least two people, not the system" do
+    comment :david
+    comment :david
+    comment :david
+    comment :system
+    cards(:layout).comments.create!(creator: users(:kevin), body: "On another card")
+    travel 2.weeks
+    assert_not_stalled
+
+    comment :kevin
+    travel 2.weeks
+    assert_stalled
+  end
+
+  test "assignment and reopening each start a burst, and ordinary activity restarts the clock" do
+    @card.toggle_assignment(users(:kevin))
+    travel 2.weeks
+    assert_stalled
+    @card.toggle_assignment(users(:kevin))
+    assert_not_stalled
+
+    @card = cards(:shipping)
+    @card.reopen
+    travel 2.weeks
+    assert_stalled
+    comment :david
+    assert_not_stalled
+    travel 2.weeks
+    assert_stalled
+  end
+
+  test "editing card content or its steps restarts the clock" do
+    @card.toggle_assignment(users(:kevin))
+    step = @card.steps.create!(content: "Review")
+    travel 2.weeks
+    assert_stalled
+    step.update!(completed: true)
+    assert_not_stalled
+    travel 2.weeks
+    assert_stalled
+    @card.update!(description: "Progress update")
+    assert_not_stalled
+  end
+
+  test "only active cards can be stalled" do
+    @card.toggle_assignment(users(:kevin))
+    @card.postpone
+    travel 2.weeks
+    assert_not_stalled
+    @card.close
+    travel 2.weeks
+    assert_not_stalled
+    @card.reopen
+    @card.drafted!
+    travel 2.weeks
+    assert_not_stalled
+  end
+
+  private
+    def comment(author, at: Time.current)
+      @card.comments.create!(creator: users(author), body: "An update", created_at: at)
+    end
+
+    def assert_stalled
+      assert_predicate @card.reload, :stalled?
+      assert_includes Card.stalled, @card
+    end
+
+    def assert_not_stalled
+      assert_not_predicate @card.reload, :stalled?
+      assert_not_includes Card.stalled, @card
+    end
+end
diff --git a/test/system/stalled_cards_test.rb b/test/system/stalled_cards_test.rb
new file mode 100644
index 0000000..1f5dcd5
--- /dev/null
+++ b/test/system/stalled_cards_test.rb
@@ -0,0 +1,25 @@
+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "a stalled card is flagged in previews and on the card until activity resumes" do
+    card = cards(:buy_domain)
+    travel_to 16.days.ago do
+      with_current_user(:david) { card.toggle_assignment(users(:kevin)) }
+    end
+    sign_in_as(users(:david))
+
+    visit cards_url(indexed_by: "stalled")
+    within "##{dom_id(card, :article)}" do
+      assert_selector ".bubble", text: /Stalled for/i
+      find(".card__link").click
+    end
+    assert_selector ".card-perma .bubble", text: /Stalled for/i
+
+    find("lexxy-editor [contenteditable=true]").send_keys("Picking this back up")
+    click_on "Post"
+    assert_text "Picking this back up"
+    assert_no_selector ".card-perma .bubble", text: /Stalled/i
+  end
+end
