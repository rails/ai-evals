diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..35e95a3
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,42 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_AFTER = 2.weeks.in_seconds
+
+  included do
+    scope :stalled, -> { active.where(had_activity_burst: true, last_active_at: ..(Time.current - STALL_AFTER)) }
+  end
+
+  class_methods do
+    def backfill_activity_bursts_for(account)
+      cards = account.cards.where(had_activity_burst: false)
+      assigned = Assignment.where(account: account).select(:card_id)
+      events = Event.where(account: account, eventable_type: "Card", action: %w[ card_assigned card_reopened ])
+      cards.where(id: assigned).or(cards.where(id: events.select(:eventable_id))).update_all(had_activity_burst: true)
+
+      candidates = Comment.by_user.where(account: account).group(:card_id).having("COUNT(*) >= 3 AND COUNT(DISTINCT comments.creator_id) >= 2")
+      cards.where(id: candidates.select(:card_id)).preload(board: [ :entropy, account: :entropy ]).find_each do |card|
+        card.update_column(:had_activity_burst, true) if card.comment_burst?
+      end
+    end
+  end
+
+  def stalls_at
+    last_active_at + STALL_AFTER if had_activity_burst? && active?
+  end
+
+  def stalled?
+    had_activity_burst? && last_active_at <= Time.current - STALL_AFTER && active?
+  end
+
+  def comment_burst?(around: nil)
+    window = auto_postpone_period / 3
+    candidates = comments.by_user
+    candidates = candidates.where(created_at: (around - window)..(around + window)) if around
+
+    # Any qualifying window contains three consecutive comments by at least two people.
+    candidates.chronologically.pluck(:created_at, :creator_id).each_cons(3).any? do |(start, first), (_, middle), (finish, last)|
+      finish - start <= window && (first != middle || middle != last)
+    end
+  end
+end
