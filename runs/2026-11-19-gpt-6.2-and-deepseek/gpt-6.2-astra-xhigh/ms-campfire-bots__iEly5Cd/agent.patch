+    follow_redirect!
+    assert_select "li", text: /Deploy Bot/ do
+      assert_select "input[readonly][value=?]", bot.bot_code
+      assert_select "label", text: "Bot code"
+      assert_select "a[href=?][aria-label=?]", edit_bot_path(bot), "Edit Deploy Bot"
+    end
+    get edit_bot_url(bot)
+    assert_select "form[data-turbo-confirm] button", text: "Delete this chat bot"
+    patch bot_url(bot), params: { bot: { name: "Release Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    follow_redirect!
+    assert_no_match(/Release Bot/, response.body)
+    post room_bot_messages_url(rooms(:hq), bot.bot_code), params: "deleted bot".b
+    assert_response :unauthorized
+  end
+
+  test "lowering the limit keeps existing bots but blocks new ones until below the limit" do
+    helper = users(:jz).bots.create!(name: "Helper")
+    greeter = users(:jz).bots.create!(name: "Greeter")
