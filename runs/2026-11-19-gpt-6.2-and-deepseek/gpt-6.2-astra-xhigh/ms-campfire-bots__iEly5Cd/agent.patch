diff --git a/app/views/bots/index.html.erb b/app/views/bots/index.html.erb
new file mode 100644
index 0000000..af71281
--- /dev/null
+++ b/app/views/bots/index.html.erb
@@ -0,0 +1,47 @@
+<% @page_title = "Chat bots" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to edit_account_path %>
+  </div>
+<% end %>
+
+<section class="panel flex flex-column gap">
+  <h1 class="txt-x-large txt-align-center margin-none">Chat bots</h1>
+  <p class="margin-none">To post as a bot, send a plain-text POST request to <code>/rooms/&lt;room-id&gt;/&lt;bot-code&gt;/messages</code>.</p>
+  <p class="margin-none">Keep bot codes private. Anyone with the code can post as the bot in its rooms.</p>
+
+  <ul class="flex flex-column gap margin-none pad-none">
+    <% @bots.each do |bot| %>
+      <li class="flex flex-column gap pad fill-shade border-radius">
+        <div class="flex align-center gap">
+          <%= avatar_tag bot %>
+          <strong class="flex-item-grow"><%= bot.name %></strong>
+          <%= link_to edit_bot_path(bot), class: "btn", aria: { label: "Edit #{bot.name}" } do %>
+            <%= image_tag "pencil.svg", size: 20, aria: { hidden: "true" } %>
+          <% end %>
+        </div>
+
+        <% if bot.suspended? %>
+          <p class="margin-none"><strong>Suspended</strong>: <%= bot.suspension_reason %></p>
+          <% if Current.user.administrator? %>
+            <%= button_to "Reactivate", reactivate_bot_path(bot), class: "btn",
+                  form: { data: { turbo_confirm: "Reactivate this chat bot?" } } %>
+          <% end %>
+        <% end %>
+
+        <label for="<%= dom_id(bot, :code) %>">Bot code</label>
+        <%= text_field_tag nil, bot.bot_code, id: dom_id(bot, :code), readonly: true, class: "input full-width", autocomplete: "off", spellcheck: false %>
+      </li>
+    <% end %>
+  </ul>
+
+  <% if Current.user.can_create_bot? %>
+    <%= link_to new_bot_path, class: "btn btn--reversed center" do %>
+      <%= image_tag "add.svg", size: 20, aria: { hidden: "true" } %> Add a chat bot
+    <% end %>
+  <% else %>
+    <p class="margin-none txt-align-center">You've reached the limit for chat bots.</p>
+  <% end %>
+</section>
