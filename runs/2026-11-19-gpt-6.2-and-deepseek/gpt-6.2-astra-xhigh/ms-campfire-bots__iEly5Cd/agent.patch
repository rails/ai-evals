@@ -0,0 +1,43 @@
+class Bots::MessagesController < ActionController::API
+  include ActiveStorage::SetCurrent, BlockBannedRequests, SetCurrentRequest
+
+  before_action :authenticate_bot, :set_room
+
+  def create
+    case result = Current.user.post_to(@room, message_attributes)
+    when Message
+      head :created, location: message_path(result)
+    when Bot::Moderation::Cooldown
+      response.set_header("Retry-After", result.retry_after.to_s)
+      head :too_many_requests
+    when :suspended then head :forbidden
+    when :inactive  then head :unauthorized
+    else head :unprocessable_content
+    end
+  end
+
+  private
+    def authenticate_bot
+      Current.user = Bot.find_by_bot_code(request.get_header("campfire.bot_code"))
+      return head :unauthorized unless Current.user
+      head :forbidden if Current.user.suspended?
+    end
+
+    def set_room
+      @room = Current.user.rooms.find_by(id: params[:room_id]) if params[:room_id].match?(/\A\d+\z/)
+      head :not_found unless @room
+    end
+
+    def message_attributes
+      body = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+      attachment = find_attachment if params[:attachment].present?
+      return if params[:attachment].present? && !attachment
+      return unless body.valid_encoding? && (body.present? || attachment)
+
+      { body: Message.rich_text_from_plain_text(body), attachment: attachment }
+    end
+
+    def find_attachment
+      ActiveStorage::Blob.find_signed(params[:attachment]) if params[:attachment].is_a?(String)
+    end
+end
