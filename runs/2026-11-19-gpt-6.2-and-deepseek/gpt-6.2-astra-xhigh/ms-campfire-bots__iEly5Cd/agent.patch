diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..617291c
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,46 @@
+class Bot < User
+  include Moderation
+
+  belongs_to :creator, class_name: "User", inverse_of: :bots
+
+  has_many :open_rooms, -> { opens }, through: :memberships, source: :room
+
+  # Bots have no password and cannot sign into a browser session.
+  attribute :password_digest, default: ""
+
+  normalizes :webhook_url, with: ->(url) { url.strip.presence }
+
+  validates :name, presence: true
+  validate :webhook_url_is_http, if: :webhook_url?
+  validate :creator_is_within_bot_limit, on: :create
+
+  after_save :grant_membership_to_open_rooms, if: :newly_joining_open_rooms?
+
+  scope :subscribed_to_webhooks, -> { active.where(suspension_reason: nil).where.not(webhook_url: nil) }
+
+  def self.find_by_bot_code(code)
+    active.find_signed(code, purpose: :bot_code)
+  end
+
+  def bot_code
+    signed_id(purpose: :bot_code)
+  end
+
+  private
+    def creator_is_within_bot_limit
+      if creator && !creator.can_create_bot?
+        errors.add(:base, "You've reached the limit for chat bots.")
+      end
+    end
+
+    def newly_joining_open_rooms?
+      active? && add_to_all_open_rooms? && (saved_change_to_add_to_all_open_rooms? || saved_change_to_status?)
+    end
+
+    def webhook_url_is_http
+      url = URI.parse(webhook_url)
+      errors.add(:webhook_url, :invalid) unless url.is_a?(URI::HTTP) && url.host.present? && url.port.in?(1..65535) && !url.userinfo
+    rescue URI::Error
+      errors.add(:webhook_url, :invalid)
+    end
+end
diff --git a/app/models/bot/moderation.rb b/app/models/bot/moderation.rb
new file mode 100644
index 0000000..bbeec81
--- /dev/null
+++ b/app/models/bot/moderation.rb
@@ -0,0 +1,75 @@
+module Bot::Moderation
+  MESSAGE_LIMIT = 10
+  MESSAGE_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  Cooldown = Data.define(:retry_after)
+
+  def suspended?
+    suspension_reason.present?
+  end
+
+  def reactivate!
+    with_lock do
+      if suspended?
+        update! suspension_reason: nil, recent_post_times: [], cooldown_until: nil, cooldown_attempts: 0, webhook_failures: 0
+      end
+    end
+  end
+
+  # Serialize admission and message creation together across API requests and webhook workers.
+  # Even an invalid payload (nil attributes) counts as a retry during cooldown.
+  def post_to(room, attributes)
+    with_lock do
+      now = Time.current
+      if !active?
+        :inactive
+      elsif suspended?
+        :suspended
+      elsif cooldown_until && cooldown_until > now
+        record_cooldown_attempt(now)
+      elsif attributes
+        post_within_limit(room, attributes, now)
+      end
+    end
+  end
+
+  def record_webhook_delivery(success:)
+    with_lock do
+      if active? && !suspended?
+        failures = success ? 0 : webhook_failures + 1
+        if failures >= WEBHOOK_FAILURE_LIMIT
+          update! webhook_failures: failures, suspension_reason: "Repeated webhook delivery failures"
+        elsif failures != webhook_failures
+          update_columns webhook_failures: failures
+        end
+      end
+    end
+  end
+
+  private
+    def record_cooldown_attempt(now)
+      if cooldown_attempts + 1 >= COOLDOWN_ATTEMPT_LIMIT
+        update! suspension_reason: "Message flooding"
+        :suspended
+      else
+        update_columns cooldown_attempts: cooldown_attempts + 1
+        Cooldown.new((cooldown_until - now).ceil)
+      end
+    end
+
+    def post_within_limit(room, attributes, now)
+      # Keep at most MESSAGE_LIMIT timestamps, independent of rooms and message deletion.
+      cutoff = (now - MESSAGE_WINDOW).to_f
+      recent = recent_post_times.select { |timestamp| timestamp > cutoff }
+      if recent.size >= MESSAGE_LIMIT
+        update_columns cooldown_until: now + COOLDOWN, cooldown_attempts: 0
+        Cooldown.new(COOLDOWN.to_i)
+      else
+        update_columns recent_post_times: recent << now.to_f
+        room.post_message(attributes.merge(creator: self))
+      end
+    end
+end
diff --git a/app/models/bot/webhook.rb b/app/models/bot/webhook.rb
new file mode 100644
index 0000000..764f0ba
--- /dev/null
+++ b/app/models/bot/webhook.rb
@@ -0,0 +1,82 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class Bot::Webhook
+  include Rails.application.routes.url_helpers
+
+  MAX_REPLY_SIZE = 1.megabyte
+
+  def initialize(bot, room)
+    @bot, @room = bot, room
+    @webhook_url = bot.webhook_url
+  end
+
+  def deliver_mention(message)
+    return unless subscribed? && message.mentionees.exists?(bot.id)
+
+    deliver event: "mention", author: { id: message.creator.id, name: message.creator.name },
+      message: { id: message.id, body: { text: command(message), html: message.body.to_s }, link: room_at_message_path(room, message) }
+  end
+
+  def deliver_joined
+    return if room.direct? || !subscribed?
+
+    deliver event: "joined" if BotJoinNotification.record_once(bot, room)
+  end
+
+  private
+    attr_reader :bot, :room, :webhook_url
+
+    def subscribed?
+      webhook_url.present? && room.users.merge(Bot.subscribed_to_webhooks).exists?(id: bot.id, webhook_url: webhook_url)
+    end
+
+    def deliver(payload)
+      payload[:room] = { id: room.id, name: room.name, reply_to: room_bot_messages_path(room, bot.bot_code) }
+
+      success, reply = post(payload)
+      bot.record_webhook_delivery(success: success)
+      bot.post_to(room, body: reply) if reply && subscribed?
+    end
+
+    def post(payload)
+      url = URI.parse(webhook_url)
+      ip = RestrictedHTTP::PrivateNetworkGuard.resolve(url.hostname)
+      # Pin the validated address and disable proxies. The credential in the payload must not follow redirects.
+      Net::HTTP.start(url.hostname, url.port, nil, ipaddr: ip, use_ssl: url.scheme == "https",
+          open_timeout: 5, read_timeout: 10, write_timeout: 10) do |http|
+        http.request_post(url.request_uri, payload.to_json, "Content-Type" => "application/json") do |response|
+          return [ response.is_a?(Net::HTTPSuccess), read_reply(response) ]
+        end
+      end
+    rescue RestrictedHTTP::Violation, Surfguard::Unresolvable, IOError, SocketError, SystemCallError, Timeout::Error,
+        OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError => error
+      Rails.logger.warn "Webhook delivery for bot #{bot.id} failed: #{error.class}"
+      [ false, nil ]
+    end
+
+    def command(message)
+      message.body.body.render_attachments(with_full_attributes: false) do |attachment|
+        ERB::Util.html_escape(attachment.to_plain_text) unless attachment.attachable == bot
+      end.fragment.to_plain_text.gsub(/\A[[:space:]]+|[[:space:]]+\z/, "")
+    end
+
+    def read_reply(response)
+      content_type = response.content_type&.downcase
+      return unless response.is_a?(Net::HTTPOK) && content_type.in?(%w[ text/plain text/html ])
+
+      body = "".b
+      response.read_body do |chunk|
+        return if body.bytesize + chunk.bytesize > MAX_REPLY_SIZE
+        body << chunk
+      end
+      body.force_encoding(Encoding::UTF_8)
+      return unless body.valid_encoding? && body.present?
+
+      if content_type == "text/plain"
+        Message.rich_text_from_plain_text(body)
+      else
+        ActionController::Base.helpers.sanitize(body).presence
+      end
