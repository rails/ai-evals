+  class << self
+    def grant_all(attributes)
+      # Bulk grants skip callbacks. RETURNING excludes conflicts on (room_id, user_id),
+      # so revising an existing membership doesn't announce another join.
+      inserted = insert_all(attributes, returning: %w[ id ])
+      notify_bots_of_joins(inserted.rows.flatten)
+    end
+
+    def notify_bots_of_joins(ids)
+      where(id: ids).without_direct_rooms.joins(:user).merge(Bot.subscribed_to_webhooks).find_each do |membership|
+        Bot::JoinedWebhookJob.perform_later(membership)
+      end
+    end
+  end
+
   def read
     update!(unread_at: nil)
   end
