@@ -0,0 +1,41 @@
+require "test_helper"
+
+class BotMentionsTest < ActionDispatch::IntegrationTest
+  test "mentioning a bot queues a JSON callback with usable reply and message paths" do
+    sign_in :david
+    author = users(:david)
+    room = rooms(:hq)
+    bot = author.bots.create!(name: "Deploy Bot", webhook_url: "https://bot.example.com/hooks/build")
+    room.memberships.grant_to(bot)
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+    payload = nil
+    webhook = WebMock.stub_request(:post, bot.webhook_url).with(headers: { "Content-Type" => "application/json" }).to_return do |request|
+      payload = JSON.parse(request.body)
+      { status: 204 }
+    end
+
+    mention = ActionText::Attachment.from_attachable(bot).to_html
+    post room_messages_url(room, format: :turbo_stream), params: { message: { body: "<div>#{mention}&nbsp;#{mention} <strong>restart</strong> for #{mention_attachment_for(:kevin)}</div>" } }
+    assert_response :success
+    message = room.messages.last
+    assert_not_requested webhook
+
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+    assert_requested webhook, times: 1
+    assert_equal "mention", payload["event"]
+    assert_equal({ "name" => author.name, "id" => author.id }, payload["author"])
+    assert_equal({ "name" => room.name, "id" => room.id, "reply_to" => room_bot_messages_path(room, bot.bot_code) }, payload["room"])
+    assert_equal message.id, payload.dig("message", "id")
+    assert_equal room_at_message_path(room, message.id), payload.dig("message", "link")
+    assert_equal "restart for @Kevin", payload.dig("message", "body", "text")
+    assert_includes payload.dig("message", "body", "html"), "<strong>restart</strong>"
+    assert_includes payload.dig("message", "body", "html"), bot.name
+
+    post payload.dig("room", "reply_to"), params: "Restarted".b
+    assert_response :created
+    assert_equal bot, room.messages.last.creator
+    assert_equal "Restarted", room.messages.last.plain_text_body
+  end
+end
diff --git a/test/integration/bot_moderation_test.rb b/test/integration/bot_moderation_test.rb
new file mode 100644
index 0000000..2853c28
--- /dev/null
+++ b/test/integration/bot_moderation_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class BotModerationTest < ActionDispatch::IntegrationTest
+  setup do
+    freeze_time
+    @room = rooms(:hq)
+    @bot = users(:kevin).bots.create!(name: "Build", webhook_url: "https://hooks.example.com/build")
+    @room.memberships.grant_to(@bot)
+    Resolv.stubs(:getaddresses).with("hooks.example.com").returns([ "93.184.216.34" ])
+    @endpoint = room_bot_messages_url(@room, @bot.bot_code)
+  end
+
+  test "API posts, join replies and mention replies share one allowance and cooldown" do
+    hook = WebMock.stub_request(:post, @bot.webhook_url).to_return(body: "Reply", headers: { content_type: "text/plain" })
+    9.times do
+      post @endpoint, params: "Allowed".b
+      assert_response :created
+    end
+    perform_enqueued_jobs only: Bot::JoinedWebhookJob
+    assert_equal 10, @bot.messages.count
+
+    mention = mention_bot
+    assert_no_difference -> { @bot.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob # The eleventh post starts the cooldown.
+      4.times do
+        post @endpoint, params: "Too soon".b
+        assert_response :too_many_requests
+        assert_equal "30", response.headers["Retry-After"]
+      end
+      Bot::WebhookJob.perform_now(@bot, mention) # A webhook reply is the fifth retry.
+      post @endpoint, params: "Still trying".b
+      assert_response :forbidden
+    end
+    assert_requested hook, times: 3
+    assert_match(/flooding/i, @bot.reload.suspension_reason)
+
+    sign_in :david
+    post reactivate_bot_url(@bot)
+    post @endpoint, params: "No need to wait out the old cooldown".b
+    assert_response :created
+  end
+
+  test "only an administrator can reactivate a suspended bot, with its original code and rooms" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    post @endpoint, params: "Keep this message".b
+    assert_response :created
+    10.times { @bot.record_webhook_delivery(success: false) }
+    post @endpoint, params: "Must not post".b
+    assert_response :forbidden
+
+    sign_in :kevin
+    get bots_url
+    assert_select "li", text: /Build/ do
+      assert_select "strong", text: "Suspended"
+      assert_select "p", text: /webhook delivery failures/i
+      assert_select "button", text: "Reactivate", count: 0
+    end
+    assert_select "a[href=?]", new_bot_path, count: 0
+    post bots_url, params: { bot: { name: "Extra bot" } }
+    assert_response :unprocessable_content
+    post reactivate_bot_url(@bot)
+    assert_response :forbidden
+    patch bot_url(@bot), params: { bot: { name: "Repaired", suspension_reason: "" } }
+    assert @bot.reload.suspended?
+    assert_equal [ @room.id ], @bot.room_ids
+    assert_equal "Keep this message", @bot.messages.sole.plain_text_body
+
+    sign_in :david
+    get bots_url
+    assert_select "form[action=?][data-turbo-confirm] button", reactivate_bot_path(@bot), text: "Reactivate"
+    post reactivate_bot_url(@bot)
+    assert_redirected_to bots_url
+    follow_redirect!
+    assert_select "strong", text: "Suspended", count: 0
+    assert_select "button", text: "Reactivate", count: 0
+
+    post @endpoint, params: "Working again".b
+    assert_response :created
+    hook = WebMock.stub_request(:post, @bot.webhook_url).to_return(status: 500)
+    mention_bot
+    perform_enqueued_jobs only: Bot::WebhookJob
+    assert_requested hook
+    assert_not @bot.reload.suspended?
+  end
+
+  private
+    def mention_bot
+      @room.messages.create!(creator: users(:david), body: ActionText::Attachment.from_attachable(@bot).to_html)
+    end
+end
diff --git a/test/integration/bot_room_memberships_test.rb b/test/integration/bot_room_memberships_test.rb
new file mode 100644
index 0000000..a02abc2
--- /dev/null
+++ b/test/integration/bot_room_memberships_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class BotRoomMembershipsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+    @url = "https://bot.example.com/events"
+    Resolv.stubs(:getaddresses).with("bot.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "bots can opt in to existing and future open rooms and opt out without leaving" do
+    get new_bot_url
+    assert_select "label", text: "Add to all open rooms"
+    assert_select "input[type=checkbox][name='bot[add_to_all_open_rooms]']:not([checked])"
+
+    post bots_url, params: { bot: { name: "Greeter", webhook_url: @url } }
+    bot = Bot.last
+    assert_empty bot.rooms
+
+    room = rooms(:hq)
+    hook = stub_joined(bot, room, reply: "Hello <HQ>!")
+    get edit_rooms_open_url(room)
+    assert_select "label", text: "Give Greeter access to this room" do
+      assert_select "input[type=checkbox]:not([checked])"
+    end
+    2.times do
+      patch rooms_open_url(room), params: { room: { name: room.name }, user_ids: [ bot.id ] }
+    end
+    perform_enqueued_jobs only: Bot::JoinedWebhookJob
+    assert_requested hook, times: 1
+    assert_equal bot, room.messages.last.creator
+    assert_equal "Hello <HQ>!", room.messages.last.plain_text_body
+
+    other = rooms(:pets)
+    second_hook = stub_joined(bot, other)
+    patch bot_url(bot), params: { bot: { add_to_all_open_rooms: "1" } }
+    assert_equal Rooms::Open.ids.sort, bot.reload.room_ids.sort
+    get edit_bot_url(bot)
+    assert_select "label", text: "Add to all open rooms"
+    assert_select "input[type=checkbox][name='bot[add_to_all_open_rooms]'][checked]"
+    perform_enqueued_jobs only: Bot::JoinedWebhookJob
+    assert_requested second_hook, times: 1
+    assert_requested hook, times: 1
+
+    post rooms_opens_url, params: { room: { name: "Ops" } }
+    ops = Rooms::Open.last
+    assert_includes ops.users, bot
+    ops_hook = stub_joined(bot, ops, reply: "<strong>Hello!</strong>", type: "text/html")
+    perform_enqueued_jobs only: Bot::JoinedWebhookJob
+    assert_requested ops_hook, times: 1
+    assert_includes ops.messages.last.body.to_s, "<strong>Hello!</strong>"
+
+    patch bot_url(bot), params: { bot: { add_to_all_open_rooms: "0" } }
+    assert_equal Rooms::Open.ids.sort, bot.reload.room_ids.sort
+    post rooms_opens_url, params: { room: { name: "Another room" } }
+    assert_not_includes Rooms::Open.last.users, bot
+    assert_includes Rooms::Open.last.users, users(:kevin)
+  end
+
+  test "manual grants notify a configured bot in a closed room but not a direct room" do
+    bot = users(:david).bots.create!(name: "Greeter", webhook_url: @url)
+    room = rooms(:watercooler)
+    hook = stub_joined(bot, room)
+    2.times { room.memberships.grant_to(bot) }
+    Rooms::Direct.create_for({ creator: users(:david) }, users: [ users(:david), bot ])
+    perform_enqueued_jobs only: Bot::JoinedWebhookJob
+    assert_requested hook, times: 1
+  end
+
+  test "re-adding a bot does not send a second joined event for that room" do
+    room = rooms(:hq)
+    post bots_url, params: { bot: { name: "Greeter", webhook_url: @url, open_room_ids: [ room.id ] } }
+    bot = Bot.last
+    hook = stub_joined(bot, room)
+    perform_enqueued_jobs only: Bot::JoinedWebhookJob
+    assert_requested hook, times: 1
+
+    room.memberships.revoke_from(bot)
+    room.memberships.grant_to(bot)
+    perform_enqueued_jobs only: Bot::JoinedWebhookJob
+    assert_requested hook, times: 1
+  end
+
+  test "a rolled back grant never queues a joined event" do
+    bot = users(:david).bots.create!(name: "Greeter", webhook_url: @url)
+    assert_no_enqueued_jobs only: Bot::JoinedWebhookJob do
+      Membership.transaction do
+        rooms(:watercooler).memberships.grant_to(bot)
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+
+  test "revoking access or clearing the webhook cancels pending joined events" do
+    bot = users(:david).bots.create!(name: "Greeter", webhook_url: @url)
+    room = rooms(:hq)
+    hook = stub_joined(bot, room)
+    room.memberships.grant_to(bot)
+    room.memberships.revoke_from(bot)
+    perform_enqueued_jobs only: Bot::JoinedWebhookJob
+    assert_not_requested hook
+
+    room.memberships.grant_to(bot)
+    bot.update!(webhook_url: nil)
+    perform_enqueued_jobs only: Bot::JoinedWebhookJob
+    assert_not_requested hook
+  end
+
+  private
+    def stub_joined(bot, room, reply: nil, type: "text/plain")
+      payload = { event: "joined", room: { id: room.id, name: room.name, reply_to: room_bot_messages_path(room, bot.bot_code) } }
+      WebMock.stub_request(:post, @url).with(headers: { "Content-Type" => "application/json" }, body: payload)
+        .to_return(status: reply ? 200 : 204, body: reply.to_s, headers: { content_type: type })
+    end
+end
diff --git a/test/models/bot/webhook_test.rb b/test/models/bot/webhook_test.rb
new file mode 100644
index 0000000..b10129b
--- /dev/null
+++ b/test/models/bot/webhook_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class Bot::WebhookTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:hq)
+    @bot = users(:kevin).bots.create!(name: "Build", webhook_url: "https://hooks.example.com/build")
+    @room.memberships.grant_to(@bot)
+    Resolv.stubs(:getaddresses).with("hooks.example.com").returns([ "93.184.216.34" ])
+  end
+
+  test "text replies are posted as the bot, preserving literal markup and newlines" do
+    text = "Deploy <ok> ✅\nA & B"
+    WebMock.stub_request(:post, @bot.webhook_url).to_return(body: text, headers: { content_type: "text/plain; charset=utf-8" })
+    mention_bot
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+    assert_equal @bot, @room.messages.last.creator
+    assert_equal text, @room.messages.last.plain_text_body
+  end
+
+  test "HTML replies retain formatting but not unsafe attributes" do
+    WebMock.stub_request(:post, @bot.webhook_url).to_return(body: '<div><strong onclick="foo()">Built</strong></div>', headers: { content_type: "Text/HTML; charset=UTF-8" })
+    mention_bot
+
+    assert_difference -> { @room.messages.count }, 1 do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+    assert_equal @bot, @room.messages.last.creator
+    assert_includes @room.messages.last.body.to_s, "<strong>Built</strong>"
+  end
+
+  test "each bot gets only its own mention stripped and its own posting credential" do
+    other = users(:jz).bots.create!(name: @bot.name, webhook_url: "https://hooks.example.com/other")
+    @room.memberships.grant_to(other)
+    { @bot => "test literal @Build for @Build", other => "@Build test literal @Build for" }.each do |bot, expected_text|
+      WebMock.stub_request(:post, bot.webhook_url).to_return do |request|
+        payload = JSON.parse(request.body)
+        assert_equal expected_text, payload.dig("message", "body", "text")
+        assert_equal Rails.application.routes.url_helpers.room_bot_messages_path(@room, bot.bot_code), payload.dig("room", "reply_to")
+        { status: 204 }
+      end
+    end
+
+    assert_enqueued_jobs 2, only: Bot::WebhookJob do
+      mention_bot(body: "#{mention(@bot)} test literal @Build for #{mention(other)}")
+    end
+    perform_enqueued_jobs only: Bot::WebhookJob
+    [ @bot, other ].each { |bot| assert_requested :post, bot.webhook_url, times: 1 }
+  end
+
+  test "no callbacks for nonmembers, unconfigured bots, literal names or bot authors" do
+    silent_bot = users(:kevin).bots.create!(name: "Silent")
+    @room.memberships.grant_to(silent_bot)
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      mention_bot(body: "@Build #{mention(silent_bot)} #{mention_attachment_for(:david)}")
+      mention_bot(room: rooms(:watercooler))
+      mention_bot(creator: silent_bot)
+    end
+  end
+
+  test "clearing a webhook or revoking room access cancels pending delivery" do
+    hook = WebMock.stub_request(:post, @bot.webhook_url)
+    mention_bot
+    @room.memberships.revoke_from(@bot)
+    perform_enqueued_jobs only: Bot::WebhookJob
+    assert_not_requested hook
+
+    @room.memberships.grant_to(@bot)
+    mention_bot
+    @bot.update!(webhook_url: " ")
+    perform_enqueued_jobs only: Bot::WebhookJob
+    assert_not_requested hook
+  end
+
+  test "a bot cannot post its reply if removed from the room while handling a mention" do
+    WebMock.stub_request(:post, @bot.webhook_url).to_return do
+      @room.memberships.revoke_from(@bot)
+      { body: "too late", headers: { content_type: "text/plain" } }
+    end
+    mention_bot
+    assert_no_difference -> { @room.messages.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+  test "unsupported, unsuccessful, oversized and blank replies produce no message" do
+    mention = mention_bot
+    responses = [
+      [ 200, "application/json", "{ }" ],
+      [ 200, "text/plain", " " ],
+      [ 200, "text/plain", "\xff".b ],
+      [ 200, "text/plain", "x" * (Bot::Webhook::MAX_REPLY_SIZE + 1) ],
+      [ 201, "text/plain", "Created" ],
+      [ 404, "text/html", "Not found" ]
+    ]
+    assert_no_difference -> { @room.messages.count } do
+      responses.each do |status, type, body|
+        WebMock.stub_request(:post, @bot.webhook_url).to_return(status: status, headers: { content_type: type }, body: body)
+        Bot::WebhookJob.perform_now(@bot, mention)
+      end
+    end
+  end
+
+  test "failed connections, redirects and private destinations produce no reply" do
+    mention = mention_bot
+    assert_no_difference -> { @room.messages.count } do
+      WebMock.stub_request(:post, @bot.webhook_url).to_timeout
+      Bot::WebhookJob.perform_now(@bot, mention)
+
+      WebMock.stub_request(:post, @bot.webhook_url).to_return(status: 307, headers: { location: "https://elsewhere.example.com/" })
+      Bot::WebhookJob.perform_now(@bot, mention)
+
+      Resolv.stubs(:getaddresses).with("hooks.example.com").returns([ "127.0.0.1" ])
+      Bot::WebhookJob.perform_now(@bot, mention)
+    end
+    assert_requested :post, @bot.webhook_url, times: 2
+  end
+
+  test "ten consecutive failed deliveries across event types stop further webhooks" do
+    mention = mention_bot
+    url = @bot.webhook_url
+    WebMock.stub_request(:post, url).to_return(status: 503)
+    9.times { Bot::WebhookJob.perform_now(@bot, mention) }
+
+    # A 2xx is a success even if there is no supported reply to post.
+    WebMock.stub_request(:post, url).to_return(status: 202, body: "accepted")
+    Bot::WebhookJob.perform_now(@bot, mention)
+    WebMock.stub_request(:post, url).to_return(status: 302)
+    8.times { Bot::WebhookJob.perform_now(@bot, mention) }
+    WebMock.stub_request(:post, url).to_timeout
+    Bot::WebhookJob.perform_now(@bot, mention)
+    rooms(:watercooler).memberships.grant_to(@bot) # A second join is already queued when the first suspends the bot.
+    WebMock.stub_request(:post, url).to_raise(Errno::ECONNREFUSED)
+    perform_enqueued_jobs only: Bot::JoinedWebhookJob
+    assert_requested :post, url, times: 20
+
+    perform_enqueued_jobs only: Bot::WebhookJob
+    assert_requested :post, url, times: 20
+    assert_no_enqueued_jobs only: [ Bot::WebhookJob, Bot::JoinedWebhookJob ] do
+      mention_bot
+      rooms(:pets).memberships.grant_to(@bot)
+    end
+  end
+
+  private
+    def mention(user)
+      ActionText::Attachment.from_attachable(user).to_html
+    end
+
+    def mention_bot(body: mention(@bot), creator: users(:david), room: @room)
+      room.messages.create!(creator: creator, body: body)
+    end
+end
