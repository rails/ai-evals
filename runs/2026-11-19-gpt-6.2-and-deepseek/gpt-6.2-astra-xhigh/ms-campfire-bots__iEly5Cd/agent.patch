+    bots.each { |bot| assert_select "li input[readonly][value=?]", bot.bot_code }
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+    assert_difference -> { users(:david).bots.count }, 1 do
+      post bots_url, params: { bot: { name: "Admin bot" } }
+      assert_redirected_to bots_url
+    end
+    get user_url(bots.first)
+    assert_response :success
+    assert_select "input#session_transfer_url", count: 0
+    patch bot_url(bots.first), params: { bot: { name: "Edited by admin" } }
+    assert_redirected_to bots_url
+    assert_equal "Edited by admin", bots.first.reload.name
