new file mode 100644
index 0000000..d5cfe2b
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,150 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = users(:kevin).bots.create!(name: "Deploy Bot")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+  end
+
+  test "posts raw curl data as the bot, including literal markup and newlines" do
+    body = "Deploy of <v1.2.3> finished ✅\n100%: a+b & x=1"
+    assert_enqueued_with(job: Room::PushMessageJob) do
+      post_message body
+      assert_response :created
+    end
+    message = @room.messages.last
+    location = response.location
+    assert_equal "/messages/#{message.id}", location
+    assert_equal @bot, message.creator
+    assert_equal body, message.plain_text_body
+    assert_not_includes request.filtered_path, @bot.bot_code
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__author", text: @bot.name
+      assert_select ".message__body-content", text: /Deploy of <v1.2.3> finished ✅/
+    end
+
+    sign_in :jz
+    get location
+    assert_response :success
+    assert_select ".message__author", text: @bot.name
+  end
+
+  test "raw data is not parsed as request parameters" do
+    [ [ "application/x-www-form-urlencoded", "_method=delete&body=literal" ], [ "application/json", "not a JSON envelope" ] ].each do |content_type, body|
+      post_message body, content_type: content_type
+      assert_response :created
+      assert_equal body, @room.messages.last.plain_text_body
+    end
+  end
+
+  test "requires a bot code, not a session or another kind of signed ID" do
+    sign_in :david
+    assert_no_difference -> { Message.count } do
+      [ "invalid", @bot.avatar_token, users(:jz).signed_id(purpose: :bot_code) ].each do |invalid_code|
+        post_message "ignored", code: invalid_code
+        assert_response :unauthorized
+      end
+    end
+  end
+
+  test "can post to a closed room only after being added in room settings" do
+    closed_room = rooms(:watercooler)
+    assert_no_difference -> { Message.count } do
+      [ 0, "#{@room.id}-missing", closed_room.id ].each do |room_id|
+        post_message "ignored", room: room_id
+        assert_response :not_found
+      end
+    end
+
+    sign_in :david
+    get edit_rooms_closed_url(closed_room)
+    assert_select "label", text: "Give Deploy Bot access to this room" do
+      assert_select "input[type=checkbox][value=?]", @bot.id.to_s
+    end
+    patch rooms_closed_url(closed_room), params: { room: { name: closed_room.name }, user_ids: closed_room.user_ids + [ @bot.id ] }
+    post_message "Hello", room: closed_room
+    assert_response :created
+    assert_equal @bot, closed_room.messages.last.creator
+  end
+
+  test "blank and invalid text messages are not created" do
+    assert_no_difference -> { Message.count } do
+      [ "", " \n", "\xFF".b ].each do |body|
+        post_message body
+        assert_response :unprocessable_content
+      end
+    end
+  end
+
+  test "can send an attachment without text" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("Build passed"), filename: "build.txt", content_type: "text/plain")
+    post_message "", attachment: blob.signed_id
+    assert_response :created
+    assert_equal blob, @room.messages.last.attachment.blob
+  end
+
+  test "a sliding window across rooms, followed by one fixed cooldown" do
+    freeze_time
+    other = rooms(:pets)
+    other.memberships.grant_to(@bot)
+    4.times do
+      post_message "First burst"
+      assert_response :created
+    end
+    travel 6.seconds
+    6.times do
+      post_message "Second burst", room: other
+      assert_response :created
+    end
+    travel 4.seconds
+    4.times do
+      post_message "Oldest four have expired"
+      assert_response :created
+    end
+
+    assert_no_difference -> { @bot.messages.count } do
+      post_message "One too many"
+      assert_response :too_many_requests
+      assert_equal "30", response.headers["Retry-After"]
+      travel 29.5.seconds, with_usec: true
+      4.times do
+        post_message "Still too soon", room: other
+        assert_response :too_many_requests
+        assert_equal "1", response.headers["Retry-After"]
+      end
+    end
+    travel 0.5.seconds
+    post_message "Back on time"
+    assert_response :created
+  end
+
+  test "five further attempts in the same cooldown suspend only the offending bot" do
+    freeze_time
+    10.times do
+      post_message "Allowed"
+      assert_response :created
+    end
+    assert_no_difference -> { @bot.messages.count } do
+      5.times do
+        post_message "Too soon"
+        assert_response :too_many_requests
+      end
+      post_message "Fifth retry"
+      assert_response :forbidden
+      travel 31.seconds
+      post_message "Still suspended"
+      assert_response :forbidden
+    end
+    assert_includes @bot.rooms, @room
+    other = users(:kevin).bots.create!(name: "Well behaved")
+    @room.memberships.grant_to(other)
+    post_message "Independent allowance", code: other.bot_code
+    assert_response :created
+  end
+
+  private
+    def post_message(body, room: @room, code: @bot.bot_code, content_type: "application/x-www-form-urlencoded", **query)
+      post room_bot_messages_url(room, code, **query), params: body.b, headers: { "Content-Type" => content_type }
+    end
+end
