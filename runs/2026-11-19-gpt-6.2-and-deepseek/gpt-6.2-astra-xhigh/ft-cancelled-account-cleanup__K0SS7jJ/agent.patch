diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..7fd1077 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,55 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+  end
+
+  def incinerate
+    transaction do
+      # Recheck under lock: the account may have been reactivated since the sweep found it.
+      if Account.due_for_incineration.lock.exists?(id)
+        delete_filter_links
+        Search::Record.delete_all_for(id)
+        delete_storage_records
+        delete_account_records
+        reload.destroy!
+      end
+    end
+  end
+
+  private
+    def delete_filter_links
+      filter_ids = Filter.where(account_id: id).select(:id)
+      %w[ assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags ].each do |table|
+        Account.connection.delete("DELETE FROM #{table} WHERE filter_id IN (#{filter_ids.to_sql})")
+      end
+    end
+
+    def delete_storage_records
+      Storage::Total.where(owner: boards).delete_all
+      Storage::Entry.where(account_id: id).delete_all
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+      ActiveStorage::VariantRecord.where(account_id: id).delete_all
+
+      # Blobs still attached in another account (e.g. template images) aren't exclusively ours.
+      ActiveStorage::Blob.where(account_id: id).unattached.delete_all
+    end
+
+    def delete_account_records
+      # There is no need to broadcast, reindex, or track storage when the entire account is going away.
+      [
+        Webhook::Delivery, Webhook::DelinquencyTracker, Webhook, Notification, Notification::Bundle,
+        Mention, Event, Reaction, Pin, Watch, Search::Query, Push::Subscription, User::Settings,
+        ActionText::RichText, Export, Account::Import, Account::JoinCode, Assignment, Closure,
+        Card::ActivitySpike, Card::Goldness, Card::NotNow, Step, Tagging, Comment, Card, Column,
+        Board::Publication, Access, Filter, Tag, Entropy, Board, User
+      ].each do |model|
+        model.where(account_id: id).delete_all
+      end
+    end
 end
