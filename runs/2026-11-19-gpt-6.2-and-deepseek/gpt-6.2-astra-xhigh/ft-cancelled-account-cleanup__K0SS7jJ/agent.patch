diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..f2a299f
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates an expired account's data without affecting other accounts or global identities" do
+    account = accounts("37s")
+    other = accounts(:initech)
+    identity = identities(:david)
+    other_user = other.users.create!(name: "David", identity: identity)
+
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("test image"), filename: "test.png", content_type: "image/png")
+    ActiveStorage::VariantRecord.create!(blob: card.image.blob, variation_digest: "thumbnail")
+    ActiveStorage::Blob.create_and_upload!(io: StringIO.new("draft"), filename: "draft.txt")
+    account.materialize_storage
+    card.board.materialize_storage
+    card.reindex
+    cards(:radio).reindex
+    indexed_card = Search::Record.for(account.id).find_by!(searchable: card)
+
+    travel_to(31.days.ago) { account.cancel(initiated_by: users(:jason)) }
+    assert_difference -> { Account.connection.select_value("SELECT COUNT(*) FROM assignees_filters") }, -1 do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_no_account_rows(account)
+    assert_not Storage::Total.exists?(owner: account)
+    assert_not Storage::Total.exists?(owner: card.board)
+    assert_not Search::Record::SQLite::Fts.exists?(rowid: indexed_card.id) if Fizzy.db_adapter.sqlite?
+
+    assert_equal identity, other_user.reload.identity
+    assert other.reload.active?
+    assert_equal other, cards(:radio).reload.account
+    assert Search::Record.for(other.id).exists?(account_id: other.id)
+  end
+
+  test "only incinerates cancellations strictly older than the grace period" do
+    account = accounts("37s")
+    other = accounts(:initech)
+    importing = accounts(:acme)
+    importing.imports.create!(identity: identities(:david))
+
+    freeze_time do
+      account.cancel(initiated_by: users(:jason))
+      other.cancel(initiated_by: users(:mike))
+      other.reactivate
+
+      travel 30.days
+      Account::IncinerateDueJob.perform_now
+      assert Account.exists?(account.id)
+
+      travel 1.second
+      2.times { Account::IncinerateDueJob.perform_now }
+      assert_not Account.exists?(account.id)
+      assert other.reload.active?
+      assert importing.reload.importing?
+    end
+  end
+
+  test "rechecks eligibility if an account is reactivated and cancelled again during a sweep" do
+    account = accounts(:initech)
+    travel_to(31.days.ago) { account.cancel(initiated_by: users(:mike)) }
+    candidate = Account.due_for_incineration.find(account.id)
+    account.reactivate
+    account.cancel(initiated_by: users(:mike))
+
+    candidate.incinerate
+
+    assert account.reload.cancelled?
+    assert account.cards.exists?
+  end
+
+  private
+    def assert_no_account_rows(account)
+      Account.with_connection do |db|
+        id = db.quote(Account.type_for_attribute("id").serialize(account.id))
+        db.tables.each do |table|
+          if db.schema_cache.columns_hash(table).key?("account_id")
+            row = db.select_value("SELECT 1 FROM #{db.quote_table_name(table)} WHERE account_id = #{id} LIMIT 1")
+            assert_nil row, "#{table} retained account data"
+          end
+        end
+      end
+    end
+end
