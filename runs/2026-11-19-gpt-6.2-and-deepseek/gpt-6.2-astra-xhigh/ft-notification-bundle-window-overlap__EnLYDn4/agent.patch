diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..c32e949
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,157 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @recipient = users(:jz)
+    @recipient.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "the first arrival starts the clock and late events join the open window" do
+    freeze_time do
+      started_at = Time.current
+      notify(:layout_assignment_jz)
+      travel 3.hours
+      notify(:logo_assignment_jz) # An older event that arrived later.
+
+      assert_no_emails do
+        perform_enqueued_jobs(only: Notification::Bundle::DeliverJob, at: started_at + 4.hours - 1.second)
+      end
+
+      travel_to started_at + 4.hours
+      email = deliver_due_digest
+      assert_equal [ @recipient.identity.email_address ], email.to
+      assert_includes email.text_part.decoded, cards(:layout).title
+      assert_includes email.text_part.decoded, cards(:logo).title
+    end
+  end
+
+  test "a notification at the deadline starts a new window even if delivery is delayed" do
+    freeze_time do
+      notify(:layout_assignment_jz)
+      travel 4.hours
+      # A new source on the same inbox notification must not replace the first digest's content.
+      @recipient.notifications.sole.update!(source: events(:layout_published))
+
+      first = deliver_due_digest
+      assert_includes first.text_part.decoded, "Assigned to you"
+      assert_not_includes first.text_part.decoded, "Added by"
+
+      travel 4.hours
+      second = deliver_due_digest
+      assert_includes second.text_part.decoded, "Added by"
+    end
+  end
+
+  test "recipients have independent windows and frequencies" do
+    freeze_time do
+      @recipient.settings.update!(bundle_email_frequency: :weekly)
+      assert_enqueued_with job: Notification::Bundle::DeliverJob, at: 1.week.from_now do
+        notify(:layout_assignment_jz)
+      end
+
+      travel 2.hours
+      david = users(:david)
+      david.settings.update!(bundle_email_frequency: :daily)
+      assert_enqueued_with job: Notification::Bundle::DeliverJob, at: 1.day.from_now do
+        Notifier.for(mentions(:logo_card_david_mention_by_jz)).notify
+      end
+
+      travel 1.day
+      daily = deliver_due_digest
+      assert_equal [ david.identity.email_address ], daily.to
+      assert_includes daily.text_part.decoded, "mentioned you"
+      assert_not_includes daily.text_part.decoded, cards(:layout).title
+
+      travel 6.days - 2.hours
+      weekly = deliver_due_digest
+      assert_equal [ @recipient.identity.email_address ], weekly.to
+      assert_includes weekly.text_part.decoded, "Assigned to you"
+      assert_includes weekly.text_part.decoded, "#{@recipient.account.slug}/cards/#{cards(:layout).number}"
+      assert_not_includes weekly.text_part.decoded, "mentioned you"
+    end
+  end
+
+  test "never does not start a window, and opting out suppresses a pending email" do
+    notify(:layout_assignment_jz)
+    @recipient.settings.update!(bundle_email_frequency: :never)
+
+    assert_empty @recipient.notification_bundles.reload
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+      notify(:logo_assignment_jz)
+    end
+    @recipient.settings.update!(bundle_email_frequency: :daily)
+    travel 4.hours + 1.second
+    assert_no_emails { perform_enqueued_jobs(only: Notification::Bundle::DeliverJob) }
+    assert_empty @recipient.notification_bundles.reload
+  end
+
+  test "reading or unreading does not add to the digest" do
+    notify(:layout_assignment_jz)
+    notification = @recipient.notifications.sole
+
+    assert_no_difference -> { Notification::Bundle::Entry.count } do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "changing frequency does not move the deadline of an open window" do
+    freeze_time do
+      notify(:layout_assignment_jz)
+      travel 1.hour
+      @recipient.settings.update!(bundle_email_frequency: :weekly)
+      assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+        notify(:logo_assignment_jz)
+      end
+
+      travel 3.hours
+      @recipient.notifications.find_by!(card: cards(:layout)).update!(source: events(:layout_published))
+      first, second = @recipient.notification_bundles.order(:starts_at)
+      assert_equal first.ends_at, second.starts_at
+      assert_equal 2, first.entries.size
+      assert_equal 1.week.from_now, second.ends_at
+    end
+  end
+
+  test "an email does not expose cards the recipient can no longer access" do
+    notify(:layout_assignment_jz)
+    boards(:writebook).access_for(@recipient).destroy!
+
+    travel 4.hours + 1.second
+    assert_no_emails { perform_enqueued_jobs(only: Notification::Bundle::DeliverJob) }
+    assert_empty @recipient.notification_bundles.reload
+  end
+
+  test "simultaneous first arrivals share a window" do
+    user_id = @recipient.id
+    sources = [ events(:layout_assignment_jz), events(:logo_assignment_jz) ]
+    start = Concurrent::CyclicBarrier.new(sources.size)
+
+    assert_enqueued_jobs 1, only: Notification::Bundle::DeliverJob do
+      sources.map do |source|
+        Thread.new do
+          start.wait
+          ActiveRecord::Base.connection_pool.with_connection do
+            Notification.create!(user_id: user_id, source: source, creator: source.creator)
+          end
+        end
+      end.each(&:value)
+    end
+
+    assert_equal 2, @recipient.notification_bundles.sole.entries.count
+  ensure
+    @recipient.notification_bundles.destroy_all
+  end
+  uses_transaction :test_simultaneous_first_arrivals_share_a_window
+
+  private
+    def deliver_due_digest
+      capture_emails { perform_enqueued_jobs(only: Notification::Bundle::DeliverJob, at: Time.current) }.sole
+    end
+
+    def notify(event)
+      Notifier.for(events(event)).notify
+    end
+end
