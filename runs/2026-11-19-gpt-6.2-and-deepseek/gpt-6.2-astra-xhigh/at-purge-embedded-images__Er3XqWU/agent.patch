 require "test_helper"
 
 class PageTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges images uploaded to its markdown body" do
+    page = pages(:welcome)
+    page.body.uploads.attach file_fixture("reading.webp")
+    upload = page.body.uploads.last
+    blob = upload.blob
+    page.update!(body: "![Reading](#{upload.slug_path})")
+    assert blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs { page.reload.destroy! }
+
+    assert_not ActiveStorage::Attachment.exists?(upload.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
