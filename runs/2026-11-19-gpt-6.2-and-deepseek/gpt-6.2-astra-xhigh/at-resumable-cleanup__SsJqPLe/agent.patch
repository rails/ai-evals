diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..9ccfdfe
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  test "worker shutdown checkpoints after one leaf and requeues the remaining work" do
+    first, second = Leaf.order(:id).first(2)
+    first.update!(title: '""First" things first"')
+    second.update!(title: '"Second"')
+
+    queue_adapter.stopping = true
+    assert_enqueued_with(job: TitleCleanupJob) { TitleCleanupJob.perform_now }
+    assert_equal '"First" things first', first.reload.title
+    assert_equal '"Second"', second.reload.title
+
+    queue_adapter.stopping = false
+    perform_enqueued_jobs
+    assert_equal '"First" things first', first.reload.title
+    assert_equal "Second", second.reload.title
+  ensure
+    queue_adapter.stopping = false
+  end
+
+  test "a restart after a committed update preserves inner quotes and finishes the tail" do
+    first, second = Leaf.order(:id).first(2)
+    last = Leaf.last
+    first.update!(title: '""First" things first"')
+    second.update!(title: '""Second""')
+    last.update!(title: '"Last"')
+
+    interrupt_after(:commit, second)
+    assert_equal '"Second"', second.reload.title
+    assert_equal '"Last"', last.reload.title
+
+    TitleCleanupJob.perform_now
+    assert_equal '"First" things first', first.reload.title
+    assert_equal '"Second"', second.reload.title
+    assert_equal "Last", last.reload.title
+  end
+
+  test "a restart retries an uncommitted leaf" do
+    first, second = Leaf.order(:id).first(2)
+    first.update!(title: '""First""')
+    second.update!(title: '"Second"')
+
+    interrupt_after(:update, second)
+    assert_equal '"Second"', second.reload.title
+
+    TitleCleanupJob.perform_now
+    assert_equal '"First"', first.reload.title
+    assert_equal "Second", second.reload.title
+  end
+
+  private
+    def interrupt_after(callback, leaf)
+      interrupt = -> { raise Interrupt if id == leaf.id }
+      Leaf.set_callback(callback, :after, interrupt)
+      assert_raises(Interrupt) { TitleCleanupJob.perform_now }
+    ensure
+      Leaf.skip_callback(callback, :after, interrupt)
+    end
+end
