+
+## Resuming legacy title cleanup
+
+Stop any workers running the old `TitleCleanupJob`, then run `bin/rails db:migrate`.
+If the old job already changed some titles, set `title_cleaned_at` on leaves you
+can verify are clean, or restore their wrapped titles from the original export.
+Old runs recorded no progress, and title text alone cannot distinguish an
+exporter quote from a legitimate quote.
+
+Start or resume the cleanup with `TitleCleanupJob.perform_later`. If a deploy
+loses the queued job, enqueue it again. Each title update commits with its
+`title_cleaned_at` marker, so even a fresh job skips finished leaves.
diff --git a/app/jobs/title_cleanup_job.rb b/app/jobs/title_cleanup_job.rb
index 13721ed..26a0b6b 100644
--- a/app/jobs/title_cleanup_job.rb
+++ b/app/jobs/title_cleanup_job.rb
@@ -1,11 +1,27 @@
 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  self.resume_options = {} # Resque supports immediate retries without resque-scheduler.
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :clean_titles do |step|
+      while leaf_id = clean_next_title(step.cursor)
+        step.advance! from: leaf_id
+      end
     end
   end
 
   private
+    def clean_next_title(start_id)
+      Leaf.transaction do
+        if leaf = Leaf.where(title_cleaned_at: nil, id: start_id..).lock.first
+          # A worker can die after this commit but before advancing the job cursor.
+          leaf.update!(title: cleaned(leaf.title), title_cleaned_at: Time.current)
+          leaf.id
+        end
+      end
+    end
+
     def cleaned(title)
       title.delete_prefix('"').delete_suffix('"')
     end
