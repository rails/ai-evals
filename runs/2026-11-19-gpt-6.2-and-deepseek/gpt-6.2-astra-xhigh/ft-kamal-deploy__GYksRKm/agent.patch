+++ b/config/deploy.yml
@@ -0,0 +1,40 @@
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - &host fizzy.example.com # Your server's public DNS name, without https://
+
+proxy:
+  host: *host
+  ssl: true
+
+# Kamal pushes to a registry on the deploy machine and forwards it over SSH.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Use arm64 for an ARM server.
+
+env:
+  clear:
+    APP_FQDN: *host
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    WEB_CONCURRENCY: 2
+    JOB_CONCURRENCY: 1
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
