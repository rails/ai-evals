+# Copy to .kamal/secrets on the deploy machine. Never commit the filled-in file.
+# Generate once with bin/rails secret; keep it across deploys.
+SECRET_KEY_BASE=
+
+# Leave both blank for a relay that doesn't require authentication.
+SMTP_USERNAME=
+SMTP_PASSWORD=
+
+# Set both for browser push notifications (see docs/deployment.md).
+VAPID_PUBLIC_KEY=
+VAPID_PRIVATE_KEY=
