diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..7fda83e
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,46 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  teardown do
+    set_browser_timezone ""
+  end
+
+  test "comments and closure notices use the browser's clock and calendar, including after a refresh" do
+    zone = "America/Los_Angeles"
+    set_browser_timezone zone
+    today = Time.current.in_time_zone(zone)
+    card = cards(:logo)
+    comments(:logo_agreement_kevin).update_column :created_at, today.change(hour: 13, min: 42)
+    comments(:logo_agreement_jz).update_column :created_at, today.yesterday.end_of_day
+    card.update_columns created_at: today - 5.days, last_active_at: today.tomorrow.beginning_of_day - card.auto_postpone_period
+
+    sign_in_as users(:david)
+    visit card_url(card)
+    assert_selector ".comment__permalink-title time", text: "1:42 PM"
+    assert_selector ".comment__permalink-title time", text: "yesterday"
+    assert_selector ".card__meta-text--added", text: /Added 5 days ago/i
+    assert_selector ".card-perma__closure-message", text: "Moves to “Not Now” tomorrow"
+
+    card.update_column :last_active_at, (today + 3.days).beginning_of_day - card.auto_postpone_period
+    page.execute_script("Turbo.visit(location.href, { action: 'replace' })")
+    assert_selector ".card-perma__closure-message", text: "Moves to “Not Now” in 3 days"
+    assert_selector ".comment__permalink-title time", text: "1:42 PM"
+  end
+
+  test "the same public card stamp shows different dates across timezones" do
+    card = cards(:shipping)
+    card.board.publish
+    card.closure.update_column :created_at, Time.utc(2025, 1, 1, 1)
+
+    { "America/Los_Angeles" => "Dec 31, 2024", "Asia/Tokyo" => "Jan 1, 2025" }.each do |zone, date|
+      set_browser_timezone zone
+      visit public_board_card_url(card.board.publication.key, card)
+      assert_selector ".card__closed-date time[datetime='2025-01-01T01:00:00Z']", text: /#{date}/i
+    end
+  end
+
+  private
+    def set_browser_timezone(zone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: zone)
+    end
+end
