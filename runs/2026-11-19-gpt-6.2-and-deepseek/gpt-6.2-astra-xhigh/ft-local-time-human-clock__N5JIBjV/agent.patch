diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..a0c2a92
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,43 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static targets = [ "time" ]
+
+  #timer
+
+  connect() {
+    this.#refreshAtMidnight()
+  }
+
+  disconnect() {
+    clearTimeout(this.#timer)
+  }
+
+  timeTargetConnected(time) {
+    this.#render(time)
+  }
+
+  renderAfterMorph({ currentTarget }) {
+    this.#render(currentTarget)
+  }
+
+  #render(time) {
+    const date = new Date(time.dateTime)
+    const format = time.dataset.format
+
+    if (!isNaN(date.getTime())) {
+      time.textContent = formatLocalTime(date, format)
+      if (format !== "calendar") time.title = formatLocalTime(date, "datetime")
+    }
+  }
+
+  #refreshAtMidnight() {
+    const midnight = new Date()
+    midnight.setHours(24, 0, 0, 0)
+    this.#timer = setTimeout(() => {
+      this.timeTargets.forEach(time => this.#render(time))
+      this.#refreshAtMidnight()
+    }, midnight - Date.now())
+  }
+}
