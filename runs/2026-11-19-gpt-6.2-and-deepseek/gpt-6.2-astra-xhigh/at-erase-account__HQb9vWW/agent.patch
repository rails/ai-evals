diff --git a/app/models/user/sign_in_history.rb b/app/models/user/sign_in_history.rb
new file mode 100644
index 0000000..34bf85e
--- /dev/null
+++ b/app/models/user/sign_in_history.rb
@@ -0,0 +1,46 @@
+module User::SignInHistory
+  extend ActiveSupport::Concern
+
+  DEACTIVATION_SUFFIX = /-deactivated-\h{8}-\h{4}-\h{4}-\h{4}-\h{12}(?=@)/
+
+  included do
+    has_many :sign_in_events, dependent: :delete_all
+
+    before_update :claim_legacy_sign_in_events, if: :will_save_change_to_email_address?
+    before_destroy(if: :persisted?) { legacy_sign_in_events.delete_all }
+  end
+
+  private
+    def claim_legacy_sign_in_events
+      legacy_sign_in_events.update_all(user_id: id)
+    end
+
+    def legacy_sign_in_events
+      events = SignInEvent.where(user_id: nil, created_at: created_at..)
+      address = email_address_in_database
+      original = active_in_database ? address : address.sub(DEACTIVATION_SUFFIX, "")
+      logins = events.for_address(original)
+
+      # A released address could be used again, even by an older account
+      # changing its email. Partition address-only history at each removal.
+      previous = other_deactivation_times(original)
+      if original != address
+        previous, subsequent = previous.partition { |time| time < updated_at_in_database }
+        if subsequent.any? || User.exists?(email_address: original)
+          logins = logins.where(created_at: ..updated_at_in_database)
+        end
+      end
+      logins = logins.where("created_at > ?", previous.max) if previous.any?
+
+      original == address ? logins : logins.or(events.for_address(address))
+    end
+
+    def other_deactivation_times(address)
+      local, _, domain = address.partition("@")
+      pattern = "#{User.sanitize_sql_like(local)}-deactivated-%@#{User.sanitize_sql_like(domain)}"
+      User.where(active: false).where.not(id: id).where("email_address LIKE ? ESCAPE '\\'", pattern)
+        .pluck(:email_address, :updated_at).filter_map do |email, time|
+          time if email.sub(DEACTIVATION_SUFFIX, "") == address
+        end
+    end
+end
