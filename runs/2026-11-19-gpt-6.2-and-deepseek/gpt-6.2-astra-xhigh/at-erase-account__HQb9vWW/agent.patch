--- /dev/null
+++ b/lib/rails_ext/active_storage_purge_on_erasure.rb
@@ -0,0 +1,20 @@
+module ActiveStorage::PurgeOnErasure
+  extend ActiveSupport::Concern
+
+  prepended do
+    before_destroy { @purge_on_erasure = Current.erasing_user }
+  end
+
+  private
+    # Active Storage calls this after the attachment's destruction commits.
+    # During an erasure, purge before returning, including any derived images.
+    def purge_dependent_blob_later
+      return super unless @purge_on_erasure
+
+      Current.set(erasing_user: true) { blob&.purge } if dependent == :purge_later
+    end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  prepend ActiveStorage::PurgeOnErasure
+end
