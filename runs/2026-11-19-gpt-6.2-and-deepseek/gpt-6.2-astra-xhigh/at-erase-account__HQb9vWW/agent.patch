diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..f40a4fe
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  test "erases personal records and only anonymizes everyone books" do
+    user = users(:kevin)
+    reader = users(:jz)
+    book = books(:handbook)
+    book.update! creator: user, author: user.name
+    leaf = leaves(:welcome_page)
+    leaf.reindex
+    user.sessions.start!(ip_address: "127.0.0.1", user_agent: "Example")
+    ReadingMark.remember(leaf, user: user)
+    mark = ReadingMark.remember(leaf, user: reader)
+    other_book = books(:manual)
+    other_book.update! creator: reader, author: user.name, everyone_access: false
+
+    Current.set(user: users(:david)) { user.destroy! }
+
+    assert_not User.exists?(user.id)
+    assert_not Session.exists?(user_id: user.id)
+    assert_not Access.exists?(user_id: user.id)
+    assert_not ReadingMark.exists?(user_id: user.id)
+    assert_not SignInEvent.for_address(user.email_address).exists?
+    assert_nil book.reload.creator_id
+    assert_equal "Deleted author", book.author
+    assert book.accessable?(user: reader)
+    assert ReadingMark.exists?(mark.id)
+    assert_includes Leaf.search("great handbook"), leaf
+    assert_equal reader, other_book.reload.creator
+    assert_equal user.name, other_book.author
+
+    Current.set(user: reader) { book.update!(title: "New edition") }
+    assert_nil book.reload.creator_id
+  end
+
+  test "erases restricted books including trash, revisions, markdown, uploads and raw FTS rows" do
+    user = users(:kevin)
+    book = books(:handbook)
+    book.update! creator: user, everyone_access: false, published: true
+    leaf_ids = book.leaves.ids
+    page = leaves(:welcome_page)
+    stale_leaf = Leaf.includes(:leafable).find(page.id)
+    original = page.page
+    original.body.uploads.attach(io: StringIO.new("old draft"), filename: "draft.txt")
+    upload = original.body.uploads.blobs.sole
+    page.edit leafable_params: { body: "revised draft" }
+    page.trashed!
+    section = sections(:welcome)
+    section.update!(body: "now stale")
+    section.leaf.reindex
+    section.update!(body: nil)
+    other_mark = ReadingMark.remember(page, user: users(:jz))
+    image = pictures(:reading).image.blob
+    books(:manual).cover.attach(image)
+
+    user.destroy!
+
+    assert_not Book.exists?(book.id)
+    assert_not Leaf.exists?(id: leaf_ids)
+    assert_not Edit.exists?(leaf_id: leaf_ids)
+    assert_not Page.exists?(original.id)
+    assert_not Page.exists?(page.page_id)
+    assert_not Section.exists?(section.id)
+    assert_not Picture.exists?(pictures(:reading).id)
+    assert_not ActionText::Markdown.exists?(record_type: "Page", record_id: [ original.id, page.page_id ])
+    assert_not ReadingMark.exists?(other_mark.id)
+    assert_not Access.exists?(book_id: book.id)
+    assert_not ActiveStorage::Blob.exists?(upload.id)
+    assert_not upload.service.exist?(upload.key)
+    assert_equal image, books(:manual).reload.cover.blob
+    stale_leaf.reindex # A delayed reindex must not put an erased leaf back into FTS.
+    assert_empty Leaf.connection.select_values(Leaf.sanitize_sql([ "SELECT rowid FROM leaf_search_index WHERE rowid IN (?)", leaf_ids ]))
+  end
+
+  test "erases covers and derived images after the transaction commits" do
+    user = users(:kevin)
+    book = books(:manual)
+    book.update!(creator: user, everyone_access: false)
+    # Use a fresh upload: the fixture image is also attached to a surviving book.
+    book.cover.attach(io: file_fixture("white-rabbit.webp").open, filename: "cover.webp")
+    cover = book.cover.blob
+    variant = book.cover.variant(resize_to_limit: [ 50, 50 ]).processed.image.blob
+
+    User.transaction do
+      user.destroy!
+      assert cover.service.exist?(cover.key)
+    end
+
+    assert_not ActiveStorage::Blob.exists?(id: [ cover.id, variant.id ])
+    assert_not ActiveStorage::VariantRecord.exists?(blob_id: cover.id)
+    assert_not cover.service.exist?(cover.key)
+    assert_not variant.service.exist?(variant.key)
+  end
+
+  test "rolling back erasure keeps files, books and their index intact" do
+    user = users(:kevin)
+    book = books(:handbook)
+    book.update!(creator: user, everyone_access: false)
+    page = leaves(:welcome_page)
+    page.reindex
+    file = pictures(:reading).image.blob
+
+    User.transaction(requires_new: true) do
+      user.destroy!
+      assert_not Book.exists?(book.id)
+      assert_empty Leaf.search("great handbook")
+      raise ActiveRecord::Rollback
+    end
+
+    assert User.exists?(user.id)
+    assert Book.exists?(book.id)
+    assert_includes Leaf.search("great handbook"), page
+    assert_equal file, pictures(:reading).reload.image.blob
+    assert file.service.exist?(file.key)
+  end
+end
