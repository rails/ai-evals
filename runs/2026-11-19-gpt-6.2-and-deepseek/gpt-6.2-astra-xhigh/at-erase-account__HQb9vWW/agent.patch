@@ -0,0 +1,64 @@
+require "test_helper"
+
+class User::SignInHistoryTest < ActiveSupport::TestCase
+  test "erases sign-ins after an email change without erasing another account's" do
+    user = users(:kevin)
+    address = user.email_address
+    legacy_event = SignInEvent.create!(action: :signed_in, email_address: address)
+    user.sessions.start!(ip_address: "127.0.0.1", user_agent: "Browser").destroy!
+    user.update!(email_address: "new@example.com")
+    replacement = users(:jz)
+    replacement.update!(email_address: address)
+    replacement.sessions.start!(ip_address: "127.0.0.1", user_agent: "Browser")
+
+    assert_equal user, legacy_event.reload.user
+    user.destroy!
+    assert_equal replacement, SignInEvent.for_address(address).sole.user
+  end
+
+  test "when a legacy address was reused only erase the original account's events" do
+    user = users(:kevin)
+    address = user.email_address
+    original_event = SignInEvent.create!(action: :signed_in, email_address: address)
+    deactivate_the_old_way(user)
+
+    replacement = User.create!(email_address: address, name: "New reader", password: "secret")
+    later_event = SignInEvent.create!(action: :signed_in, email_address: address)
+    deactivate_the_old_way(replacement)
+
+    user.destroy!
+    assert_not SignInEvent.exists?(original_event.id)
+    assert SignInEvent.exists?(later_event.id)
+    replacement.destroy!
+    assert_not SignInEvent.exists?(later_event.id)
+  end
+
+  test "erasing an account that took a released email does not erase the prior owner's logins" do
+    prior = users(:kevin)
+    address = prior.email_address
+    prior_event = SignInEvent.create!(action: :signed_in, email_address: address)
+    deactivate_the_old_way(prior)
+    current = users(:david)
+    current.update!(email_address: address)
+    current_event = SignInEvent.create!(action: :signed_in, email_address: address)
+
+    current.destroy!
+    assert_not SignInEvent.exists?(current_event.id)
+    assert SignInEvent.exists?(prior_event.id)
+  end
+
+  test "an active user's literal deactivation-like address is not decoded" do
+    user = users(:kevin)
+    address = users(:david).email_address
+    user.update!(email_address: address.sub("@", "-deactivated-#{SecureRandom.uuid}@"))
+    other_event = SignInEvent.create!(action: :signed_in, email_address: address)
+    user.destroy!
+    assert SignInEvent.exists?(other_event.id)
+  end
+  private
+    def deactivate_the_old_way(user)
+      # Bypass today's email-change callback: legacy events didn't have a user_id.
+      rewritten = user.email_address.sub("@", "-deactivated-#{SecureRandom.uuid}@")
+      user.update_columns(active: false, email_address: rewritten, updated_at: Time.current)
+    end
+end
