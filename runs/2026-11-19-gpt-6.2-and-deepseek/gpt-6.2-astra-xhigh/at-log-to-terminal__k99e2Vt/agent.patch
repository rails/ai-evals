diff --git a/script/library_report.rb b/script/library_report.rb
index 76294dc..f9422c9 100644
--- a/script/library_report.rb
+++ b/script/library_report.rb
@@ -1,15 +1,24 @@
+# Reuse Rails' log devices (including file rotation), but broadcast only the report.
+logger = Rails.logger.dup
+[ $stdout, Rails.application.config.paths["log"].first ].each do |destination|
+  unless ActiveSupport::Logger.logger_outputs_to?(logger, destination)
+    logger.broadcast_to ActiveSupport::Logger.new(destination, formatter: logger.formatter)
+  end
+end
+logger.level = :info
+
 books = Book.order(:id).to_a
 
-Rails.logger.info "Library report: #{books.size} books"
+logger.info "Library report: #{books.size} books"
 
 books.each do |book|
   pages = book.leaves.count
 
   if pages.zero?
-    Rails.logger.warn "Library report: #{book.title} has no pages"
+    logger.warn "Library report: #{book.title} has no pages"
   else
-    Rails.logger.info "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}"
+    logger.info "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}"
   end
 end
 
-Rails.logger.info "Library report: done"
+logger.info "Library report: done"
diff --git a/test/script/library_report_test.rb b/test/script/library_report_test.rb
new file mode 100644
index 0000000..dae1f0e
--- /dev/null
+++ b/test/script/library_report_test.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  test "prints the report and appends the same lines to the environment log" do
+    expected = <<~REPORT
+      Library report: 2 books
+      Library report: Manual has no pages
+      Library report: Handbook has 4 pages
+      Library report: done
+    REPORT
+
+    File.open(Rails.application.config.paths["log"].first) do |log|
+      log.seek(0, IO::SEEK_END)
+      stdout, = capture_io { load Rails.root.join("script/library_report.rb") }
+
+      assert_equal expected, stdout
+      assert_equal expected.lines, log.readlines.grep(/^Library report:/)
+    end
+  end
+end
