+  test "non-admin board creators cannot manage publication" do
+    sign_in_as :david
+    assert_equal users(:david), @board.creator
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_nil board_json.fetch("public_url")
+
+    publication = @board.publish
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_equal public_board_url(publication), board_json.fetch("public_url")
+
+    get edit_board_path(@board)
