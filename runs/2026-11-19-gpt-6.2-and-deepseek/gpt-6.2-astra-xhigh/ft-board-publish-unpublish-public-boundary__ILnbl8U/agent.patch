+
+    delete board_publication_path(board)
+    assert_response :redirect
+    assert_predicate board.reload, :published?
+
+    sign_in_as :jason # account owner, but not a member of this private board
+    delete board_publication_path(board)
+    assert_response :not_found
+    assert_predicate board.reload, :published?
