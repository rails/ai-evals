diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..8cf5e7a
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,37 @@
+class Board::Publication < ApplicationRecord
+  ColumnListing = Data.define(:id, :name, :cards)
+
+  belongs_to :board, touch: true
+  belongs_to :account, default: -> { board.account }
+
+  has_secure_token :key
+
+  # Card JSON embeds the board, including its public URL.
+  after_commit -> { board.cards.touch_all }, on: %i[ create destroy ]
+
+  def to_param
+    key
+  end
+
+  def cards
+    board.cards.published
+  end
+
+  def columns
+    [ column("not_now"), column("stream"), *board.columns.sorted.map { custom_column(it) }, column("closed") ]
+  end
+
+  def column(id)
+    case id
+    when "not_now" then ColumnListing.new(id, "Not Now", cards.postponed.latest)
+    when "stream"  then ColumnListing.new(id, "Maybe?", cards.awaiting_triage.latest.with_golden_first)
+    when "closed"  then ColumnListing.new(id, "Done", cards.recently_closed_first)
+    else custom_column(board.columns.find(id))
+    end
+  end
+
+  private
+    def custom_column(column)
+      ColumnListing.new(column.id, column.name, cards.active.where(column: column).latest.with_golden_first)
+    end
+end
diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
