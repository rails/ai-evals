diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..24dac9a
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,16 @@
+class Stripe::WebhooksController < ActionController::API
+  SUBSCRIPTION_EVENTS = %w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted
+    customer.subscription.paused customer.subscription.resumed ].freeze
+
+  def create
+    return head :service_unavailable unless secret = ENV["STRIPE_WEBHOOK_SECRET"].presence
+
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], secret)
+    if SUBSCRIPTION_EVENTS.include?(event.type)
+      Account::Subscription.find_by(stripe_customer_id: event.data.object.customer)&.sync(event)
+    end
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..24b314f
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,46 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :overridden_limit, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+
+    set_callback :cancel, :after, -> { subscription&.cancel }
+  end
+
+  def billing_plan
+    subscription&.paid_plan || (comped? ? ::Subscription::MonthlyV1 : ::Subscription::FreeV1)
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      create_billing_waiver! unless comped?
+    else
+      billing_waiver&.destroy!
+      reset_billing_waiver
+    end
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards.published.count
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def cards_remaining
+    if limit = billing_plan.card_limit
+      [ limit - card_count, 0 ].max
+    end
+  end
+
+  def card_limit_reached?
+    cards_remaining == 0
+  end
+end
