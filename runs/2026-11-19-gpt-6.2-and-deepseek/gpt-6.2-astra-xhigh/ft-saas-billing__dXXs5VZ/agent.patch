+      <p><%= plan.card_limit ? number_with_delimiter(plan.card_limit) : "Unlimited" %> cards, <%= number_to_human_size(plan.storage_limit) %> storage</p>
+      <% if Subscription::PAID_PLANS.include?(plan) && plan != @account.billing_plan && !@account.subscription&.ongoing? %>
+        <%= button_to "Upgrade to #{plan.proper_name}", saas.account_billing_checkout_path, params: { plan: plan.short_name }, class: "btn btn--link", form: { data: { turbo: false } } %>
