+class Account::Billing::CheckoutsController < Account::Billing::BaseController
+  def create
+    account = Current.account
+    plan = Subscription.paid_plan(params[:plan])
+
+    if plan.nil?
+      head :bad_request
+    elsif account.subscription&.ongoing?
+      redirect_to saas.account_billing_path, alert: "Manage your existing subscription in the customer portal."
+    elsif account.billing_plan == plan
+      redirect_to saas.account_billing_path, notice: "Your account already has this plan."
+    else
+      subscription = Account::Subscription.for_checkout(account)
+      redirect_to subscription.checkout_url(plan, return_url: main_app.account_settings_url), allow_other_host: true, status: :see_other
+    end
+  end
+end
