+<% @page_title = @account.name %>
+
+<section class="panel panel--centered flex flex-column gap">
+  <h1><%= @account.name %></h1>
+  <p>Current plan: <strong><%= @account.billing_plan.proper_name %></strong><%= " (comped)" if @account.comped? %></p>
+  <p>A comp grants Unlimited without starting or changing a Stripe subscription.</p>
+  <% if @account.comped? %>
+    <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+  <% else %>
+    <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), class: "btn" %>
+  <% end %>
+
+  <h2>Usage override</h2>
+  <p>Usage for billing: <%= number_with_delimiter(@account.card_count) %> cards, <%= number_with_delimiter(@account.bytes_used) %> bytes.</p>
+  <p>Leave a field blank to use the measured usage.</p>
+  <%= form_with model: @override, scope: :override, url: saas.admin_account_overridden_limit_path(@account), method: :patch, class: "flex flex-column gap" do |form| %>
