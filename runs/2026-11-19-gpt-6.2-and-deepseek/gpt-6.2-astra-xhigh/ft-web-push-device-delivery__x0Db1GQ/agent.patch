diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..3875072
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,89 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { serviceWorkerPath } from "initializers/offline"
+
+export default class extends Controller {
+  static targets = [ "button", "error", "help" ]
+  static values = { url: String, publicKey: String, devices: Object }
+
+  #pushManager
+  #deviceKey
+
+  async connect() {
+    this.buttonTarget.disabled = true
+
+    try {
+      if ("Notification" in window && Notification.permission !== "denied" && "serviceWorker" in navigator && "PushManager" in window) {
+        const registration = await navigator.serviceWorker.getRegistration("/") || await navigator.serviceWorker.register(serviceWorkerPath)
+        this.#pushManager = registration.pushManager
+        const subscription = await this.#pushManager.getSubscription()
+        this.#deviceKey = subscription?.toJSON().keys?.p256dh
+      }
+    } catch {
+      this.#pushManager = null
+    } finally {
+      this.#refresh()
+    }
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+    this.errorTarget.hidden = true
+    try {
+      if (this.#deviceId) {
+        await this.#disable()
+      } else if (await Notification.requestPermission() === "granted") {
+        await this.#enable()
+      } else {
+        this.helpTarget.hidden = false
+      }
+    } catch {
+      this.errorTarget.hidden = false
+    } finally {
+      this.#refresh()
+    }
+  }
+
+  async #enable() {
+    await navigator.serviceWorker.ready
+    const subscription = await this.#pushManager.getSubscription() || await this.#pushManager.subscribe({
+      userVisibleOnly: true, applicationServerKey: this.#applicationServerKey
+    })
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.urlValue, { responseKind: "json", body: {
+      push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth }
+    } })
+    if (!response.ok) throw new Error("Could not register device")
+
+    this.#deviceKey = keys.p256dh
+    this.devicesValue = { ...this.devicesValue, [this.#deviceKey]: (await response.json).id }
+    this.helpTarget.hidden = true
+  }
+
+  async #disable() {
+    // Other accounts in this browser may use the same PushManager subscription.
+    // Remove only this user's registration for it.
+    const response = await destroy(`${this.urlValue}/${this.#deviceId}`, { responseKind: "json" })
+    if (!response.ok && response.statusCode !== 404) throw new Error("Could not remove device")
+
+    const devices = this.devicesValue
+    delete devices[this.#deviceKey]
+    this.devicesValue = devices
+  }
+
+  #refresh() {
+    const blocked = !this.#pushManager || Notification.permission === "denied"
+    this.element.classList.toggle("notifications--on", !blocked && !!this.#deviceId)
+    this.buttonTarget.disabled = blocked
+    if (blocked) this.helpTarget.hidden = false
+  }
+
+  get #deviceId() {
+    return window.Notification?.permission === "granted" && this.devicesValue[this.#deviceKey]
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), char => char.charCodeAt(0))
+  }
+}
