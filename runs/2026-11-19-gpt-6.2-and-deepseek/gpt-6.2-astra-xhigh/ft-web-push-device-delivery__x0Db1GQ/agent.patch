diff --git a/app/models/push/delivery.rb b/app/models/push/delivery.rb
new file mode 100644
index 0000000..07544b4
--- /dev/null
+++ b/app/models/push/delivery.rb
@@ -0,0 +1,58 @@
+class Push::Delivery
+  include Rails.application.routes.url_helpers
+
+  class ServiceUnavailable < StandardError; end
+
+  attr_reader :subscription, :source
+
+  def initialize(subscription, source)
+    @subscription, @source = subscription, source
+  end
+
+  def deliver
+    http.request(encrypted_post) do |response|
+      case response
+      when Net::HTTPGone, Net::HTTPNotFound then subscription.destroy!
+      when Net::HTTPServerError, Net::HTTPTooManyRequests then raise ServiceUnavailable, response.code
+      else response.value
+      end
+      return # No need to read a push service's response body.
+    end
+  end
+
+  private
+    def http
+      # Pin the connection to a public IP while keeping the hostname from the
+      # untrusted endpoint for TLS verification and VAPID.
+      ip = SsrfProtection.resolve_public_ip(uri.host) || raise(SocketError, "No public IP for push service")
+      Net::HTTP.new(uri.host, uri.port, nil).tap do |http|
+        http.ipaddr = ip
+        http.use_ssl = true
+        http.open_timeout = http.read_timeout = 5
+      end
+    end
+
+    def uri
+      @uri ||= URI(subscription.endpoint)
+    end
+
+    def encrypted_post
+      request = WebPush::Request.new(message: payload, vapid: vapid, subscription: {
+        endpoint: subscription.endpoint, keys: { p256dh: subscription.p256dh_key, auth: subscription.auth_key }
+      })
+      Net::HTTP::Post.new(uri.request_uri, request.headers).tap { |post| post.body = request.body }
+    end
+
+    def payload
+      message = Notification::Message.new(source)
+      data = { title: message.title, body: message.body, url: polymorphic_path(source.notifiable_target, script_name: subscription.account.slug, only_path: true) }
+      json = data.to_json
+      # Leave room for Web Push encryption overhead in the 4 KiB payload.
+      json.bytesize <= 3900 ? json : data.merge(title: data[:title].truncate(240), body: data[:body].truncate(240)).to_json
+    end
+
+    def vapid
+      { public_key: ENV.fetch("VAPID_PUBLIC_KEY"), private_key: ENV.fetch("VAPID_PRIVATE_KEY"),
+        subject: "mailto:#{Mail::Address.new(ApplicationMailer.default[:from]).address}" }
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..e6aa4e1
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,33 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  belongs_to :session, optional: true
+
+  before_validation { self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s) }
+
+  validates :p256dh_key, :auth_key, presence: true, length: { maximum: 255 }
+  validates :endpoint, length: { maximum: 4096 }
+  validate :validate_endpoint
+
+  def self.register(user:, attributes:, session:, user_agent:)
+    user.with_lock do
+      user.push_subscriptions.find_or_initialize_by(endpoint_digest: Digest::SHA256.hexdigest(attributes[:endpoint].to_s)).tap do |subscription|
+        subscription.update!(attributes.merge(session: session, user_agent: user_agent&.truncate(4096)))
+      end
+    end
+  end
+
+  def deliver(source)
+    if Push.configured? && user.active? && account.active? && source.card.board.accessible_to?(user)
+      Push::Delivery.new(self, source).deliver
+    end
+  end
+
+  private
+    def validate_endpoint
+      uri = URI.parse(endpoint.to_s)
+      errors.add(:endpoint, "must be an HTTPS URL") unless uri.is_a?(URI::HTTPS) && uri.host.present? && !uri.userinfo && !uri.fragment
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "is not a URL")
+    end
+end
