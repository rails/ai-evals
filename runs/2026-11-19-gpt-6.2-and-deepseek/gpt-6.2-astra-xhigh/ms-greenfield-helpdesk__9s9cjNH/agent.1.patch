--- /dev/null
+++ b/app/controllers/api/v1/profiles_controller.rb
@@ -0,0 +1,22 @@
+module Api
+  module V1
+    class ProfilesController < BaseController
+      def show
+        render json: { user: user_json(@user) }
+      end
+
+      def update
+        @user.update!(string_fields(:user, :name))
+        render json: { user: user_json(@user) }
+      end
+
+      def change_password
+        change = string_fields(:password_change, :current_password, :password)
+        @user.with_lock do
+          @user.update!(password_challenge: change.require(:current_password), password: change.require(:password))
+        end
+        head :no_content
+      end
+    end
+  end
+end
