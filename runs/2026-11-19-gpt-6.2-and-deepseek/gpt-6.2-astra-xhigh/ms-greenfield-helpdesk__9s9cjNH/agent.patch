+class UserMailer < ApplicationMailer
+  def verification(user, token)
+    @link = frontend_link("verify-email", user, token)
+    mail(to: user.email, subject: "Verify your helpdesk email")
+  end
+
+  def password_reset(user, token)
+    @link = frontend_link("reset-password", user, token)
+    mail(to: user.email, subject: "Reset your helpdesk password")
+  end
+
+  def invitation(invite, token)
+    @link = frontend_link("accept-invitation", invite, token)
+    mail(to: invite.email, subject: "You're invited to #{invite.account.name}'s helpdesk")
+  end
+
+  private
+
+  def frontend_link(path, recipient, token)
+    query = URI.encode_www_form(account: recipient.account.subdomain, token: token)
+    "#{Rails.configuration.x.frontend_url}/#{path}?#{query}"
+  end
+end
