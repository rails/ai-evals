+        fields = string_fields(:request, :subject)
+        ticket = @user.requests.build(fields)
+        ticket.comments.build(author: @user, **comment_attributes(params[:request]))
+        ticket.save!
+        render_ticket(ticket, status: :created)
+      end
+
+      private
+
+      def require_customer
+        error("Customer required", :forbidden) unless @user.customer?
+      end
+
+      def ticket_scope
+        @user.requests.recently_public
+      end
+
+      def ticket_json(ticket)
+        super.merge(updated_at: ticket.public_updated_at)
+      end
+
+      def visible_comments(ticket)
+        ticket.comments.where(public: true)
+      end
+    end
+  end
+end
