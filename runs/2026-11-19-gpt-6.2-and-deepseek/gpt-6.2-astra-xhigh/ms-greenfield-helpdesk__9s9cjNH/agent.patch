+namespace :helpdesk do
+  desc "Permanently remove accounts cancelled for at least 90 days and all their data"
+  task purge_cancelled_accounts: :environment do
+    # Each DELETE retains the age predicate. A concurrent reactivation cannot
+    # be lost between selecting a batch and deleting it. FKs cascade atomically.
+    count = Account.past_retention.in_batches.delete_all
+    puts "Purged #{count} cancelled account(s)."
+  end
+end
