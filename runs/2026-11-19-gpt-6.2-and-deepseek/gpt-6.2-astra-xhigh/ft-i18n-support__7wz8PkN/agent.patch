diff --git a/test/system/japanese_interface_test.rb b/test/system/japanese_interface_test.rb
new file mode 100644
index 0000000..6a1e69b
--- /dev/null
+++ b/test/system/japanese_interface_test.rb
@@ -0,0 +1,16 @@
+require "application_system_test_case"
+
+class JapaneseInterfaceTest < ApplicationSystemTestCase
+  test "card dates are formatted in the page language" do
+    sign_in_as users(:david)
+    card = cards(:layout)
+    visit card_url(card, locale: "ja")
+
+    assert_selector "html[lang=ja]"
+    assert_selector "time[data-local-time-target=daysago]", text: /今日|昨日|日前/, visible: :all
+    assert_selector ".for-screen-reader", text: "カード番号", visible: :all
+
+    visit card_url(card, locale: "en")
+    assert_selector "time[data-local-time-target=daysago]", text: /today|yesterday|days ago/, visible: :all
+  end
+end
