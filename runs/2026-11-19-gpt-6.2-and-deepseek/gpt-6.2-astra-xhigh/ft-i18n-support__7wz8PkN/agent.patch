diff --git a/app/views/mission_control/jobs/jobs/_error_information.ja.html.erb b/app/views/mission_control/jobs/jobs/_error_information.ja.html.erb
new file mode 100644
index 0000000..9a45f20
--- /dev/null
+++ b/app/views/mission_control/jobs/jobs/_error_information.ja.html.erb
@@ -0,0 +1,22 @@
+<% if job.failed? %>
+  <h2 class="subtitle">エラー情報</h2>
+
+  <table class="table">
+    <tbody>
+    <tr>
+      <th>種類</th>
+      <td> <%= job.last_execution_error.error_class %> </td>
+    </tr>
+    <tr>
+      <th>メッセージ</th>
+      <td> <%= job.last_execution_error.try(:message) || job.last_execution_error.inspect %> </td>
+    </tr>
+    </tbody>
+  </table>
+
+  <% if @server.backtrace_cleaner %>
+    <%= render "mission_control/jobs/jobs/failed/backtrace_toggle", application: @application, job: job %>
+  <% end %>
+
+  <pre class="is-family-monospace mb-4 backtrace-content"><%= failed_job_backtrace(job, @server) %></pre>
+<% end %>
diff --git a/app/views/mission_control/jobs/jobs/_filters.ja.html.erb b/app/views/mission_control/jobs/jobs/_filters.ja.html.erb
new file mode 100644
index 0000000..6b65292
--- /dev/null
+++ b/app/views/mission_control/jobs/jobs/_filters.ja.html.erb
@@ -0,0 +1,55 @@
+<div class="filter level-left">
+  <%= form_for :filter, url: application_jobs_path(MissionControl::Jobs::Current.application, jobs_status), method: :get,
+    data: { controller: "form", action: "input->form#debouncedSubmit" } do |form| %>
+
+    <div class="field is-grouped">
+      <div class="control">
+        <%= form.label :job_class_name, "ジョブクラス", class: "label" %>
+        <div class="select is-rounded">
+          <%= form.text_field :job_class_name, value: @job_filters[:job_class_name], class: "input", list: "job-classes", placeholder: "ジョブクラスで絞り込み…", autocomplete: "off" %>
+        </div>
+      </div>
+
+      <div class="control">
+        <%= form.label :queue_name, "キュー名", class: "label" %>
+        <div class="select is-rounded">
+          <%= form.text_field :queue_name, value: @job_filters[:queue_name], class: "input", list: "queue-names", placeholder: "キュー名で絞り込み…", autocomplete: "off" %>
+        </div>
+      </div>
+
+      <% if jobs_status == "finished" %>
+        <div class="control">
+          <%= form.label :finished_at_start, "完了日時（開始）", class: "label" %>
+          <div class="select is-rounded">
+            <%= form.datetime_field :finished_at_start, value: @job_filters[:finished_at]&.begin, class: "input", placeholder: "完了日時（開始）" %>
+          </div>
+        </div>
+
+        <div class="control">
+          <%= form.label :finished_at_end, "完了日時（終了）", class: "label" %>
+          <div class="select is-rounded">
+            <%= form.datetime_field :finished_at_end, value: @job_filters[:finished_at]&.end, class: "input", placeholder: "完了日時（終了）" %>
+          </div>
+        </div>
+      <% end %>
+
+      <%= hidden_field_tag :server_id, MissionControl::Jobs::Current.server.id %>
+
+      <datalist id="job-classes" class="is-hidden">
+        <% job_class_names.each do |job_class_name| %>
+          <option value="<%= job_class_name %>"></option>
+        <% end %>
+      </datalist>
+
+      <datalist id="queue-names" class="is-hidden">
+        <% queue_names.each do |queue_name| %>
+          <option value="<%= queue_name %>"></option>
+        <% end %>
+      </datalist>
+
+      <div class="control is-align-self-flex-end">
+        <%= link_to "クリア", application_jobs_path(MissionControl::Jobs::Current.application, jobs_status, job_class_name: nil, queue_name: nil, finished_at: nil..nil), class: "button" %>
+      </div>
+    </div>
+  <% end %>
+</div>
diff --git a/app/views/mission_control/jobs/jobs/_general_information.ja.html.erb b/app/views/mission_control/jobs/jobs/_general_information.ja.html.erb
new file mode 100644
index 0000000..1fa4f35
--- /dev/null
+++ b/app/views/mission_control/jobs/jobs/_general_information.ja.html.erb
@@ -0,0 +1,71 @@
+<table class="table">
+  <tbody>
+  <tr>
+    <th>引数</th>
+    <td>
+      <div class="is-family-monospace">
+        <%= job_arguments(job) %>
+      </div>
+    </td>
+  </tr>
+  <tr>
+    <th>ジョブ ID</th>
+    <td><%= job.job_id %></td>
+  </tr>
+  <tr>
+    <th>キュー</th>
+    <td>
+      <div class="tag">
+        <%= link_to job.queue_name, application_queue_path(@application, job.queue) %>
+      </div>
+    </td>
+  </tr>
+  <tr>
+    <th>登録日時</th>
+    <td>
+      <%= job_time_distance(job.enqueued_at.to_datetime) %>前
+    </td>
+  </tr>
+  <% if job.scheduled? %>
+    <tr>
+      <th>実行予定</th>
+      <td>
+        <%= relative_job_time(job.scheduled_at) %>
+        <% if job_delayed?(job) %>
+          <div class="is-danger tag ml-4">遅延</div>
+        <% end %>
+      </td>
+    </tr>
+  <% end %>
+  <% if job.failed? %>
+    <tr>
+      <th>失敗</th>
+      <td>
+        <%= job_time_distance(job.failed_at) %>前
+      </td>
+    </tr>
+  <% end %>
+  <% if job.finished_at.present? %>
+    <tr>
+      <th>完了</th>
+      <td>
+        <%= job_time_distance(job.finished_at) %>前
+      </td>
+    </tr>
+    <tr>
+      <th>所要時間</th>
+      <td>
+        <%= job.duration.round(3) %> 秒
+      </td>
+    </tr>
+  <% end %>
+  <% if job.worker_id.present? %>
+    <tr>
+      <th>実行ワーカー</th>
+      <td>
+        <%= link_to "ワーカー #{job.worker_id}", application_worker_path(@application, job.worker_id) %>
+      </td>
+    </tr>
+  <% end %>
+  </tbody>
+</table>
