diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..0031172
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,27 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_current_locale
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def with_current_locale(&action)
+      if I18n.locale_available?(params[:locale])
+        session[:locale] = params[:locale]
+      end
+
+      I18n.with_locale(session[:locale] || I18n.default_locale, &action)
+    end
+
+    # Only attach an anonymous choice to an identity once it has authenticated.
+    def apply_identity_locale(identity)
+      if locale = session.delete(:locale)
+        identity.update!(locale: locale) unless identity.locale == locale
+      end
+
+      I18n.locale = identity.locale || I18n.default_locale
+    end
+end
