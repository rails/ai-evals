diff --git a/app/helpers/job_admin_helper.rb b/app/helpers/job_admin_helper.rb
new file mode 100644
index 0000000..4624494
--- /dev/null
+++ b/app/helpers/job_admin_helper.rb
@@ -0,0 +1,35 @@
+# Presentation for the Japanese variants of the mounted job dashboard. The
+# engine doesn't expose translation keys; its original English views are used
+# as-is in the default locale.
+module JobAdminHelper
+  def localized_job_sections
+    sections = { queues: [ t("job_admin.queues"), application_queues_path(@application) ] }
+    supported_job_statuses.without(:pending).each do |status|
+      label = t("job_admin.status_jobs", status: t("job_admin.status.#{status}"), count: jobs_count_with_status(status))
+      sections[navigation_section_for_status(status)] = [ label, application_jobs_path(@application, status) ]
+    end
+    sections[:workers] = [ t("job_admin.workers"), application_workers_path(@application) ] if workers_exposed?
+    sections[:recurring_tasks] = [ t("job_admin.recurring_tasks"), application_recurring_tasks_path(@application) ] if recurring_tasks_supported?
+    sections
+  end
+
+  def job_time_distance(time)
+    tag.span time_ago_in_words(time, include_seconds: true), title: t("job_admin.since", time: l(time, format: :long))
+  end
+
+  def relative_job_time(time)
+    tag.span t(time.past? ? "job_admin.ago" : "job_admin.in_time", time: time_ago_in_words(time, include_seconds: true)), title: l(time, format: :long)
+  end
+
+  # The engine puts completed English sentences in the flash. Translate just
+  # its known notices; job arguments, exception messages and IDs are data.
+  def localized_job_notice(message)
+    t("job_admin.notices", locale: :en).each do |key, template|
+      pattern = Regexp.escape(template).sub(Regexp.escape("%{value}"), "(?<value>.+)")
+      if match = /\A#{pattern}\z/.match(message.to_s)
+        return t("job_admin.notices.#{key}", **match.named_captures.symbolize_keys)
+      end
+    end
+    message
+  end
+end
