diff --git a/app/javascript/helpers/i18n.js b/app/javascript/helpers/i18n.js
new file mode 100644
index 0000000..e88c423
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,11 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+// The head is tracked by Turbo: changing languages reloads the document and
+// the small subset of the Rails catalog used by Stimulus controllers.
+export const locale = document.documentElement.lang === "en" ? "en-US" : document.documentElement.lang
+let messages
+
+export function t(key, values = {}) {
+  messages ??= JSON.parse(getMetaContent("translations"))
+  return messages[key].replace(/%\{(\w+)\}/g, (_, name) => values[name])
+}
