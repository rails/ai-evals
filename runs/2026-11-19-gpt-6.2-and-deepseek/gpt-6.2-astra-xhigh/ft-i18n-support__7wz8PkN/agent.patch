diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..b0577cb
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "a public page remembers the choice and ignores unsupported locales" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_select "h1", "Get into Fizzy"
+      get new_session_path(locale: "ja")
+      assert_select "html[lang=ja]"
+      assert_select "h1", "Fizzy にログイン"
+      get new_session_path(locale: "xx")
+      assert_select "html[lang=ja]"
+    end
+  end
+
+  test "a signed-out choice is used for the code email but only saved after authentication" do
+    identity = identities(:kevin)
+    untenanted do
+      get new_session_path(locale: "ja")
+      perform_enqueued_jobs { post session_path, params: { email_address: identity.email_address } }
+
+      assert_nil identity.reload.locale
+      assert_match "確認コード", ActionMailer::Base.deliveries.last.subject
+      post session_magic_link_path, params: { code: identity.magic_links.last.code }
+      assert_equal "ja", identity.reload.locale
+    end
+  end
+
+  test "the preference belongs to the signed-in identity" do
+    sign_in_as :kevin
+    get board_path(boards(:writebook), locale: "ja")
+    assert_response :success
+    assert_select "a.header__skip-navigation", "メインコンテンツに移動"
+    get board_path(boards(:writebook), locale: "xx")
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:kevin).reload.locale
+    reset!
+    sign_in_as :kevin
+    get board_path(boards(:writebook), script_name: accounts("37s").slug)
+    assert_select "html[lang=ja]"
+
+    get board_path(boards(:writebook), script_name: accounts("37s").slug, locale: "en")
+    assert_equal "en", identities(:kevin).reload.locale
+    assert_select "a.header__skip-navigation", "Skip to main content"
+  end
+
+  test "signing in as another person does not carry over the first person's language" do
+    sign_in_as :kevin
+    get account_settings_path(locale: "ja")
+    sign_out
+    sign_in_as :david
+    get account_settings_path
+    assert_select "html[lang=en]"
+    assert_nil identities(:david).reload.locale
+  end
+
+  test "the manifest uses the page locale" do
+    sign_in_as :kevin
+    get board_path(boards(:writebook), locale: "ja")
+    get pwa_manifest_path(format: :json)
+    assert_response :success
+    assert_equal "通知", response.parsed_body["shortcuts"].first["name"]
+  end
+
+  test "cached fragments are not shared across languages" do
+    sign_in_as :david
+    with_actionview_partial_caching do
+      get card_path(cards(:layout))
+      assert_select "span.for-screen-reader", text: "Card number"
+      get card_path(cards(:layout), locale: "ja")
+      assert_select "span.for-screen-reader", text: "カード番号"
+    end
+    assert_select "html[lang=ja]"
+  end
+end
diff --git a/test/mailers/localized_delivery_test.rb b/test/mailers/localized_delivery_test.rb
new file mode 100644
index 0000000..332e44e
--- /dev/null
+++ b/test/mailers/localized_delivery_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class LocalizedDeliveryTest < ActionMailer::TestCase
+  test "account and profile emails use the identity's language" do
+    user = users(:david)
+    identity = user.identity
+    identity.update!(locale: "ja")
+    account = user.account
+    export = User::DataExport.create!(account: account, user: user)
+    import = Account::Import.new(account: account, identity: identity, failure_reason: :conflict)
+    cancellation = Account::Cancellation.new(account: account, initiated_by: user)
+
+    [
+      [ ExportMailer.completed(export), "ダウンロード" ],
+      [ ImportMailer.completed(identity, account), "インポートが完了" ],
+      [ ImportMailer.failed(import), "既に存在" ],
+      [ AccountMailer.cancellation(cancellation), "解約されました" ]
+    ].each do |email, expected|
+      assert_match(/\p{Hiragana}/, email.subject)
+      [ email.html_part, email.text_part ].each { |part| assert_includes part.body.decoded, expected }
+    end
+
+    confirmation = UserMailer.email_change_confirmation(email_address: "new@example.com", token: "test", user: user)
+    assert_equal "新しいメールアドレスを確認してください", confirmation.subject
+    assert_includes confirmation.body.decoded, "メールアドレス変更の確認"
+  end
+end
