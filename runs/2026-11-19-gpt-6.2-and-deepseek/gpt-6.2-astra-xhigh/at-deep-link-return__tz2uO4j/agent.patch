+++ b/test/controllers/sessions_controller_test.rb
@@ -36,6 +36,44 @@ class SessionsControllerTest < ActionDispatch::IntegrationTest
     assert parsed_cookies.signed[:session_token]
   end
 
+  test "create preserves a root-relative deep link" do
+    destination = book_slug_path(books(:handbook), page: 2, anchor: "contents")
+
+    sign_in_with_return_to destination
+
+    assert_redirected_to destination
+  end
+
+  test "create preserves an absolute deep link on the request's origin" do
+    https!
+    host! "books.example.com:8443"
+    destination = book_slug_url(books(:handbook), host: "BOOKS.example.com", port: 8443, page: 2, anchor: "contents")
+
+    get new_session_path(return_to: destination)
+    assert_select "input[name=return_to][value=?]", destination
+
+    sign_in_with_return_to destination
+
+    assert_redirected_to book_slug_path(books(:handbook), page: 2, anchor: "contents")
+  end
+
+  test "create ignores return destinations outside the request's origin" do
+    [ "https://other.invalid/book", "//other.invalid/book", "ftp://#{host}/book",
+      "http://#{host}:8080/book", "https://#{host}/book" ].each do |destination|
+      reset!
+      sign_in_with_return_to destination
+      assert_redirected_to root_path, "Unexpected redirect for #{destination.inspect}"
+    end
+  end
+
+  test "create ignores malformed return destinations" do
+    [ "", "books/1", "/bad path", "/books?q=\n", "https://[", [ "/books" ], { path: "/books" } ].each do |destination|
+      reset!
+      sign_in_with_return_to destination
+      assert_redirected_to root_path, "Unexpected redirect for #{destination.inspect}"
+    end
+  end
+
   test "create with invalid credentials" do
     post session_url, params: { email_address: "david@example.com", password: "wrong" }
 
