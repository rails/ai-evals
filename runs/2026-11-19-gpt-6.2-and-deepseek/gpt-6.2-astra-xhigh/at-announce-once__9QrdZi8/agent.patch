+  test "publishing and adding a page together announces the book once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "1" }, added_pages: [ "Introduction" ] }
+    end
+
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ]
+    assert_redirected_to book_slug_path(@book)
+    assert_predicate @book.reload, :published?
+    assert @book.leaves.exists?(title: "Introduction")
+  end
+
+  test "saving a live book again does not announce it again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "1", slug: "new-slug" } }
+    end
+    assert_predicate @book.reload, :published?
+    assert_equal "new-slug", @book.slug
+  end
+
+  test "taking a book back down does not announce it" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "0" } }
+    end
+    assert_not_predicate @book.reload, :published?
+  end
+
