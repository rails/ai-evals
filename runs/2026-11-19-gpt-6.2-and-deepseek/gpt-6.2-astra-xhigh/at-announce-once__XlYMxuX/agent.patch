+  test "publishing alongside page changes announces the book once" do
+    book = books(:handbook)
+    patch book_publication_path(book), params: {
+      book: { published: "1" }, added_pages: [ "Appendix" ],
+      trashed_page_ids: [ leaves(:summary_page).id ], renamed_pages: { leaves(:welcome_page).id => "Preface" }
+    }
+
+    assert_redirected_to book_slug_path(book)
+    assert_predicate book.reload, :published?
+    assert book.leaves.exists?(title: "Appendix")
+    assert_predicate leaves(:summary_page).reload, :trashed?
+    assert_equal "Preface", leaves(:welcome_page).reload.title
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ book ]
+  end
+
+  test "saving an already-published book alongside page changes does not announce again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "1" }, added_pages: [ "Appendix" ] }
+    end
+    assert_redirected_to book_slug_path(@book)
+    assert @book.leaves.exists?(title: "Appendix")
+  end
+
+  test "unpublishing does not announce the book" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "0" } }
+    end
+    assert_not @book.reload.published?
+  end
+
+  test "a failed page change rolls back publication without announcing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: {
+        book: { published: "1" }, added_pages: [ "Appendix" ], trashed_page_ids: [ leaves(:summary_page).id ]
+      }
+    end
+
+    # The page to trash belongs to a different book.
+    assert_response :not_found
+    assert_not @book.reload.published?
+    assert_not @book.leaves.exists?(title: "Appendix")
+  end
+
