diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..c02a22f
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "substring search only lists active leaves of readable books" do
+    private_page = leaves(:summary_page)
+    private_page.update!(book: books(:manual), title: "Welcome to the Manual")
+    leaves(:reading_picture).update!(title: "Welcome picture", status: :trashed)
+
+    assert_search_results "lCoM", leaves(:welcome_section), leaves(:welcome_page)
+
+    books(:manual).update!(published: true)
+    assert_search_results "lCoM", leaves(:welcome_section), leaves(:welcome_page), private_page
+
+    sign_out
+    assert_search_results "lCoM", private_page
+  end
+
+  test "search finds titles containing an apostrophe" do
+    page = leaves(:summary_page)
+    page.update!(title: "Reader's guide")
+
+    assert_search_results "der's", page
+  end
+
+  test "search matches pattern characters literally" do
+    sale = leaves(:welcome_page)
+    sale.update!(title: "Save 50% off")
+    index = leaves(:summary_page)
+    index.update!(title: "Price_list!")
+
+    assert_search_results "Save 50% off", sale
+    assert_search_results "%", sale
+    assert_search_results "_", index
+    assert_search_results "!", index
+  end
+
+  private
+    def assert_search_results(term, *leaves)
+      get library_search_path, params: { q: term }
+
+      assert_response :success
+      assert_select "a.search__result", count: leaves.size
+      leaves.each { |leaf| assert_select "a.search__result[href=?]", leafable_slug_path(leaf) }
+    end
+end
