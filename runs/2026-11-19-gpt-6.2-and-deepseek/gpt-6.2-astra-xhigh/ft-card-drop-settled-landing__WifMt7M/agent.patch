diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..34c72a5
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,124 @@
+import { Controller } from "@hotwired/stimulus"
+import BoardCardMove from "lib/board_card_move"
+
+const DRAGGED = "drag-and-drop__dragged-item"
+const HOVERED = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "card", "error" ]
+
+  #card
+  #hovered
+  #saves = Promise.resolve()
+
+  cardTargetConnected(card) {
+    card.draggable = true
+  }
+
+  cardTargetDisconnected(card) {
+    card.removeAttribute("draggable")
+    if (card === this.#card) this.end()
+  }
+
+  disconnect() {
+    this.end()
+  }
+
+  start(event) {
+    if (!this.cardTargets.includes(event.target)) return
+    if (event.target.ariaBusy === "true") return event.preventDefault()
+
+    this.errorTarget.hidden = true
+    this.#card = event.target
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("application/x-fizzy-card", this.#card.id)
+    this.#card.classList.add(DRAGGED)
+  }
+
+  over(event) {
+    const destination = this.#destination(event)
+    this.#highlight(destination)
+    if (destination) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (!this.#hovered?.contains(event.relatedTarget)) this.#highlight(null)
+  }
+
+  drop(event) {
+    if (!this.#card) return
+
+    event.preventDefault()
+    const card = this.#card
+    const destination = this.#destination(event)
+    this.end()
+
+    if (destination) {
+      const move = new BoardCardMove(card, destination)
+      move.apply()
+
+      // Saves must arrive in drop order: the newest move sorts first.
+      this.#saves = this.#saves.then(() => this.#save(move))
+    }
+  }
+
+  async continuePagination(event) {
+    const list = event.target.closest(".cards__list[data-cards-moved]")
+    if (list && event.target.matches("turbo-frame[src]") && !event.target.hasChildNodes()) {
+      event.preventDefault()
+      await this.#saves
+      event.detail.url.searchParams.set("cards_loaded", list.querySelectorAll(":scope > [data-controller~=pagination] article.card").length)
+      event.detail.resume()
+    }
+  }
+
+  reconcilePage({ target }) {
+    const list = target.closest(".cards__list[data-cards-moved]")
+    if (list) {
+      for (const card of list.querySelectorAll(":scope > article.card")) {
+        if (target.querySelector(`#${card.id}`)) card.remove()
+      }
+    }
+  }
+
+  end() {
+    this.#card?.classList.remove(DRAGGED)
+    this.#card = null
+    this.#highlight(null)
+  }
+
+  async #save(move) {
+    try {
+      await move.save()
+    } catch {
+      move.undo()
+      if (this.hasErrorTarget) this.errorTarget.hidden = false
+    }
+  }
+
+  #destination({ target }) {
+    if (!this.#card) return
+
+    const column = target.closest("[data-card-status]")
+    const source = this.#card.closest("[data-card-status]")
+    if (column && column !== source && this.#ready(column) && this.#ready(source)) {
+      return column
+    }
+  }
+
+  #ready(column) {
+    const list = column?.querySelector(".cards__list")
+    return list && !list.querySelector("turbo-frame[src]:not([complete])")
+  }
+
+  #highlight(column) {
+    if (this.#hovered !== column) {
+      this.#hovered?.classList.remove(HOVERED)
+      column?.classList.add(HOVERED)
+      this.#hovered = column
+    }
+  }
+}
