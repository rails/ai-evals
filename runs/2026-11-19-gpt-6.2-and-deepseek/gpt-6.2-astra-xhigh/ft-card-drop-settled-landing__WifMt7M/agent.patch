diff --git a/test/system/board_drag_and_drop_test.rb b/test/system/board_drag_and_drop_test.rb
new file mode 100644
index 0000000..1743f98
--- /dev/null
+++ b/test/system/board_drag_and_drop_test.rb
@@ -0,0 +1,143 @@
+require "application_system_test_case"
+
+class BoardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+  end
+
+  test "dropping on a column places the card behind golden cards before the save" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_triage)
+    source = find("#maybe")
+    destination = find("##{dom_id(column)}")
+    assert_selector "##{dom_id(column)} article.card", visible: :all, count: 2
+
+    page.execute_script <<~JS
+      const fetch = window.fetch
+      window.fetch = async (...args) => {
+        if (args[1]?.method === "POST") {
+          await new Promise(resolve => window.saveMove = resolve)
+        }
+        return fetch(...args)
+      }
+    JS
+
+    source.find("##{dom_id(card, :article)}").drag_to destination.find(".cards__expander")
+    expected = [ cards(:logo), card, cards(:layout) ].map { |item| dom_id(item, :article) }
+    assert_selector "##{dom_id(column)} article.card", visible: :all, count: 3
+    assert_equal expected, destination.all("article.card", visible: :all).map { |item| item[:id] }
+    assert_equal "3", destination.find(".cards__expander-count", visible: :all).text(:all)
+    assert_equal "0", source.find(".cards__expander-count", visible: :all).text(:all)
+    assert_nil card.reload.column
+
+    page.execute_script("window.saveMove()")
+    assert_no_selector "##{dom_id(card, :article)}[aria-busy]", visible: :all
+    assert_equal column, card.reload.column
+    refresh
+    assert_selector "##{dom_id(column)} article.card", visible: :all, count: 3
+    assert_equal expected, find("##{dom_id(column)}").all("article.card", visible: :all).map { |item| item[:id] }
+  end
+
+  test "moving between Not Now, Done, and Maybe" do
+    card = cards(:buy_domain)
+    article = "##{dom_id(card, :article)}"
+
+    drag_between article, "#maybe", "#not-now"
+    assert_selector "#not-now #{article}.card--postponed", visible: :all
+    assert card.reload.postponed?
+    drag_between article, "#not-now", "#closed-cards"
+    assert card.reload.closed?
+    assert_nil card.not_now
+    drag_between article, "#closed-cards", "#maybe"
+    assert_selector "#maybe #{article}.card--active"
+    assert card.reload.awaiting_triage?
+  end
+
+  test "same-column drops and canceled drags leave the board alone" do
+    card = cards(:buy_domain)
+    card_selector = "##{dom_id(card, :article)}"
+    assert_selector "#{card_selector}[draggable=true]"
+    assert_selector "#closed-cards article.card", visible: :all
+    page.execute_script <<~JS, card_selector
+      window.drag = (type, selector) => document.querySelector(selector).dispatchEvent(
+        new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() })
+      )
+      window.drag("dragstart", arguments[0])
+      window.drag("dragover", "#closed-cards .cards__expander")
+    JS
+    assert_selector "#{card_selector}.drag-and-drop__dragged-item"
+    assert_selector "#closed-cards.drag-and-drop__hover-container"
+    page.execute_script("window.drag('dragend', arguments[0])", card_selector)
+    assert_no_selector ".drag-and-drop__hover-container, .drag-and-drop__dragged-item"
+
+    assert_no_changes -> { card.reload.last_active_at } do
+      page.execute_script <<~JS, card_selector
+        window.drag("dragstart", arguments[0])
+        window.drag("dragover", "#maybe")
+        window.drag("drop", "#maybe")
+      JS
+      assert_selector "#maybe #{card_selector}:not([aria-busy])"
+      assert_no_selector ".drag-and-drop__hover-container, .drag-and-drop__dragged-item"
+    end
+  end
+
+  test "a failed save restores the source order and counts" do
+    column = dom_id(columns(:writebook_triage))
+    source = find("##{column}")
+    card = cards(:logo)
+    source.find(".cards__expander").click
+    page.execute_script <<~JS
+      const fetch = window.fetch
+      window.fetch = (...args) => args[1]?.method === "POST" ? Promise.resolve(new Response(null, { status: 422 })) : fetch(...args)
+    JS
+    source.find("##{dom_id(card, :article)}").drag_to find("#not-now .cards__expander")
+    assert_text "Couldn't save the move"
+    assert_equal [ cards(:logo), cards(:layout) ].map { |item| dom_id(item, :article) }, source.all("article.card").map { |item| item[:id] }
+    assert_equal "2", source.find(".cards__expander-count", visible: :all).text(:all)
+    assert_equal "0", find("#not-now .cards__expander-count").text
+    assert_no_selector "#not-now article.card, .drag-and-drop__hover-container, .drag-and-drop__dragged-item", visible: :all
+  end
+
+  test "continuing a partially loaded column after a move neither skips nor duplicates cards" do
+    Current.user = users(:david)
+    board = boards(:writebook)
+    column = columns(:writebook_triage)
+    15.times do |i|
+      board.cards.create!(title: "Golden #{i}", column: column, status: :published).gild
+      board.cards.create!(title: "Maybe #{i}", status: :published)
+    end
+    refresh
+
+    destination = "##{dom_id(column)}"
+    assert_selector "#{destination} article.golden-effect", count: 15, visible: :all
+    source_card = first("#maybe article.card")
+    source_card.drag_to find("#{destination} .cards__expander")
+    assert_selector "#{destination} ##{source_card[:id]}:not([aria-busy])", visible: :all
+
+    load_next_page "#maybe"
+    assert_card_order "#maybe", board.cards.awaiting_triage.latest.with_golden_first
+    find("#{destination} .cards__expander").click
+    load_next_page destination
+    assert_card_order destination, column.cards.active.latest.with_golden_first
+  end
+
+  private
+    def load_next_page(column)
+      page.execute_script("document.querySelector(arguments[0]).scrollIntoView()", "#{column} .pagination-link")
+    end
+
+    def assert_card_order(column, cards)
+      expected = cards.map { |card| dom_id(card, :article) }
+      assert_selector "#{column} article.card", count: expected.size, visible: :all
+      assert_equal expected, all("#{column} article.card", visible: :all).map { |item| item[:id] }
+    end
+
+    def drag_between(article, from, to)
+      find("#{from} .cards__expander").click if page.has_selector?("#{from}.is-collapsed", wait: 0)
+      find("#{from} #{article}").drag_to find("#{to} .cards__expander")
+      assert_selector "#{to} #{article}:not([aria-busy])", visible: :all
+    end
+end
