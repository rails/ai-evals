diff --git a/app/javascript/lib/board_card_move.js b/app/javascript/lib/board_card_move.js
new file mode 100644
index 0000000..7e430f3
--- /dev/null
+++ b/app/javascript/lib/board_card_move.js
@@ -0,0 +1,108 @@
+import { destroy, post } from "@rails/request.js"
+
+export default class BoardCardMove {
+  constructor(card, destination) {
+    this.card = card
+    this.source = card.closest("[data-card-status]")
+    this.destination = destination
+    this.status = destination.dataset.cardStatus
+  }
+
+  apply() {
+    this.original = this.card.cloneNode(true)
+    this.place = document.createComment("card before move")
+    this.card.before(this.place)
+
+    this.card.ariaBusy = "true"
+    this.#updatePreview()
+    this.#insertCard()
+    this.#updateCounts(1)
+    for (const column of [ this.source, this.destination ]) {
+      column.querySelector(".cards__list").toggleAttribute("data-cards-moved", true)
+    }
+  }
+
+  async save() {
+    const response = await this.#saveStatus()
+    if (response.statusCode !== 204) throw new Error("Move not saved")
+    this.card.removeAttribute("aria-busy")
+    this.place.remove()
+  }
+
+  undo() {
+    this.card.remove()
+    this.place.replaceWith(this.original)
+    this.#updateCounts(-1)
+  }
+
+  #updatePreview() {
+    this.card.removeAttribute("aria-selected")
+    this.card.classList.toggle("card--active", this.#active)
+    this.card.classList.toggle("card--postponed", this.status === "postponed")
+    this.card.style.setProperty("--card-color", this.destination.style.getPropertyValue("--card-color") || "var(--color-card-default)")
+    this.card.querySelector(".card__closed")?.remove()
+    this.#recordActivity()
+  }
+
+  #recordActivity() {
+    const time = this.card.querySelector(".card__meta-text--updated time")
+    const now = Math.floor(Date.now() / 1000)
+    const bubble = this.card.querySelector(".bubble")
+
+    if (bubble) {
+      const entropy = JSON.parse(bubble.dataset.bubbleEntropyValue)
+      const elapsed = now - Number(time.dateTime)
+      entropy.closesAt = new Date(Date.parse(entropy.closesAt) + elapsed * 1000).toISOString()
+      bubble.dataset.bubbleEntropyValue = JSON.stringify(entropy)
+      delete bubble.dataset.bubbleStalledValue
+      bubble.hidden = true
+    }
+
+    time.dateTime = now
+  }
+
+  // A move is new activity (or a new closure). Only active columns put gold first.
+  #insertCard() {
+    const pages = this.destination.querySelector(".cards__list [data-controller~=pagination]")
+    const firstOrdinaryCard = pages.querySelector("article.card:not(.golden-effect)")
+
+    if (!this.#active || this.card.classList.contains("golden-effect")) {
+      pages.firstElementChild.prepend(this.card)
+    } else if (firstOrdinaryCard) {
+      firstOrdinaryCard.before(this.card)
+    } else if (pages.lastElementChild.querySelector(".pagination-link")) {
+      // More gold may follow. Leave the card after the pages until its page arrives.
+      pages.after(this.card)
+    } else {
+      pages.lastElementChild.append(this.card)
+    }
+  }
+
+  get #active() {
+    return this.status === "triaged" || this.status === "maybe"
+  }
+
+  #updateCounts(delta) {
+    this.#adjustCount(this.source, -delta)
+    this.#adjustCount(this.destination, delta)
+  }
+
+  #adjustCount(column, delta) {
+    const expander = column.querySelector(".cards__expander")
+    const count = Number(expander.style.getPropertyValue("--card-count")) + delta
+    expander.style.setProperty("--card-count", count)
+    expander.querySelector(".cards__expander-count").textContent = count > 99 ? "99+" : count
+  }
+
+  #saveStatus() {
+    const { cardTriageUrl, cardClosureUrl, cardNotNowUrl } = this.card.dataset
+    const options = { responseKind: "json" }
+
+    switch (this.status) {
+      case "triaged": return post(cardTriageUrl, { ...options, body: { column_id: this.destination.dataset.columnId } })
+      case "maybe": return destroy(cardTriageUrl, options)
+      case "closed": return post(cardClosureUrl, options)
+      case "postponed": return post(cardNotNowUrl, options)
+    }
+  }
+}
