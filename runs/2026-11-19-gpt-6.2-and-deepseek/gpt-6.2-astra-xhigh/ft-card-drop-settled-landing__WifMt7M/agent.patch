diff --git a/app/controllers/concerns/column_card_pagination.rb b/app/controllers/concerns/column_card_pagination.rb
new file mode 100644
index 0000000..da5999d
--- /dev/null
+++ b/app/controllers/concerns/column_card_pagination.rb
@@ -0,0 +1,24 @@
+module ColumnCardPagination
+  class Continuation < SimpleDelegator
+    attr_reader :records
+
+    def initialize(page, offset)
+      super(page)
+      @records = page.records.offset(offset.clamp(0, page.recordset.records_count))
+    end
+
+    def before_last?
+      records.offset_value + records.size < recordset.records_count
+    end
+  end
+
+  private
+    def set_column_page(cards)
+      @page = current_page_from(cards)
+
+      # After a drop, the cards already on screen needn't fill an exact number of pages.
+      if request.format.html? && turbo_frame_request? && params[:cards_loaded].present?
+        @page = Continuation.new(@page, params[:cards_loaded].to_s.to_i)
+      end
+    end
+end
