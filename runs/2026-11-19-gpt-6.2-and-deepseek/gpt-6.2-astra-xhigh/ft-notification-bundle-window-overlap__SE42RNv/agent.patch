diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..f8e7659
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,52 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :user
+  belongs_to :account, default: -> { user.account }
+  has_many :entries, dependent: :delete_all
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add(notification)
+      transaction do
+        # Lock a stable row even when there is no bundle to lock yet.
+        settings = User::Settings.lock.find_by(user_id: notification.user_id)
+        if interval = settings&.bundle_email_interval
+          bundle = open_for(notification.user, interval)
+          bundle.entries.find_or_create_by!(source: notification.source) { |entry| entry.card = notification.card }
+        end
+      end
+    end
+
+    private
+      def open_for(user, interval)
+        # Use arrival time under the lock, not event time: notifier jobs may run out of order.
+        now = Time.current.utc
+        user.notification_bundles.where("ends_at > ?", now).order(:ends_at).lock.first ||
+          user.notification_bundles.create!(starts_at: now, ends_at: now + interval)
+      end
+  end
+
+  def deliver
+    if ends_at <= Time.current
+      NotificationMailer.digest(self).deliver_now if deliverable?
+      destroy!
+    end
+  end
+
+  def visible_entries
+    entries.where(card_id: user.accessible_cards.select(:id)).preload(:account, :card, :source).order(:id)
+  end
+
+  private
+    def deliverable?
+      # Wait for any final arrival to commit, but don't hold the lock during SMTP.
+      transaction do
+        settings = User::Settings.lock.find_by(user_id: user_id)
+        settings&.bundle_email_interval && user.active? && user.identity && account.active?
+      end
+    end
+
+    def deliver_later
+      Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+    end
+end
