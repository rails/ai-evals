diff --git a/test/integration/notification_digests_test.rb b/test/integration/notification_digests_test.rb
new file mode 100644
index 0000000..c03ab15
--- /dev/null
+++ b/test/integration/notification_digests_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class NotificationDigestsTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    freeze_time
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "two arrivals, including new activity on the same card, send one digest four hours after the first" do
+    @user.notifications.destroy_all
+    events(:logo_published).notify_recipients
+
+    travel 3.hours
+    events(:logo_assignment_km).notify_recipients
+    assert_no_emails { deliver_due_bundles }
+
+    travel 1.hour
+    assert_emails 1 do
+      deliver_due_bundles
+    end
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_includes email.text_part.decoded, "Added by David"
+    assert_includes email.text_part.decoded, "Assigned to you by David"
+    assert_includes email.html_part.decoded, "#{@user.account.slug}/cards/#{cards(:logo).number}"
+    assert_includes email.text_part.decoded, "#{@user.account.slug}/notifications/settings"
+  end
+
+  test "an older event arriving after the first is included without moving the window" do
+    @user.notifications.destroy_all
+    first, late = events(:logo_assignment_km, :layout_commented)
+    first.notify_recipients
+    travel 2.hours
+    assert_operator late.created_at, :<, first.created_at
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+      late.notify_recipients
+    end
+    bundle = @user.notification_bundles.sole
+    assert_equal 2.hours.ago, bundle.starts_at
+    assert_equal 2.hours.from_now, bundle.ends_at
+    assert_equal [ first, late ], bundle.entries.order(:id).map(&:source)
+  end
+
+  test "an arrival on the closing boundary opens a new window at the new frequency" do
+    events(:logo_published).notify_recipients
+    @user.settings.update!(bundle_email_frequency: :daily)
+    travel 4.hours
+    events(:logo_assignment_km).notify_recipients
+
+    first, second = @user.notification_bundles.order(:starts_at)
+    assert_equal first.ends_at, second.starts_at
+    assert_equal 1.day.from_now, second.ends_at
+    assert_emails 1 do
+      deliver_due_bundles
+    end
+    assert_not_includes ActionMailer::Base.deliveries.last.text_part.decoded, "Assigned to you"
+
+    travel 1.day
+    assert_emails 1 do
+      deliver_due_bundles
+    end
+    assert_includes ActionMailer::Base.deliveries.last.text_part.decoded, "Assigned to you"
+  end
+
+  test "different recipients use independent windows, including for mentions" do
+    david = users(:david)
+    david.settings.update!(bundle_email_frequency: :weekly)
+    mentions(:logo_card_david_mention_by_jz).notify_recipients
+    travel 1.hour
+    events(:logo_published).notify_recipients
+
+    travel 4.hours
+    assert_emails 1 do
+      deliver_due_bundles
+    end
+    assert_equal [ @user.identity.email_address ], ActionMailer::Base.deliveries.last.to
+
+    travel_to david.notification_bundles.sole.ends_at
+    assert_equal 1.week.ago, david.notification_bundles.sole.starts_at
+    assert_emails 1 do
+      deliver_due_bundles
+    end
+    assert_equal [ david.identity.email_address ], ActionMailer::Base.deliveries.last.to
+    assert_includes ActionMailer::Base.deliveries.last.text_part.decoded, "JZ mentioned you"
+  end
+
+  test "turning off email suppresses pending and subsequent digests" do
+    events(:logo_published).notify_recipients
+    @user.settings.update!(bundle_email_frequency: :never)
+    travel 4.hours
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+      events(:logo_assignment_km).notify_recipients
+    end
+    assert_no_emails { deliver_due_bundles }
+  end
+
+  test "opting back in starts fresh rather than sending a cancelled digest" do
+    events(:logo_published).notify_recipients
+    @user.settings.update!(bundle_email_frequency: :never)
+    @user.settings.update!(bundle_email_frequency: :daily)
+    travel 4.hours
+    assert_no_emails { deliver_due_bundles }
+
+    events(:logo_assignment_km).notify_recipients
+    assert_equal 1.day.from_now, @user.notification_bundles.sole.ends_at
+  end
+
+  test "reading or marking unread does not start a digest" do
+    notification = notifications(:logo_assignment_kevin)
+    assert_no_difference -> { @user.notification_bundles.count } do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "revoked access does not leak activity in an email" do
+    events(:logo_published).notify_recipients
+    boards(:writebook).access_for(@user).destroy!
+    travel 4.hours
+    assert_no_emails { deliver_due_bundles }
+  end
+
+  private
+    def deliver_due_bundles
+      perform_enqueued_jobs only: Notification::Bundle::DeliverJob, at: Time.current
+    end
+end
