diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..2a01931
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  # Each worker must see the committed settings and acquire its own DB lock.
+  self.use_transactional_tests = false
+
+  test "simultaneous first arrivals share a window and one scheduled delivery" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: :daily)
+    notifications = user.notifications.limit(2).to_a
+    ready, start = Queue.new, Queue.new
+
+    assert_enqueued_jobs 1, only: Notification::Bundle::DeliverJob do
+      workers = notifications.map do |notification|
+        Thread.new do
+          ready << true
+          start.pop
+          ActiveRecord::Base.connection_pool.with_connection do
+            Current.with_account(notification.account) { Notification::Bundle.add(notification) }
+          end
+        end
+      end
+      workers.size.times { ready.pop }
+      workers.size.times { start << true }
+      workers.each(&:value)
+    end
+
+    assert_equal notifications.size, user.notification_bundles.sole.entries.count
+  ensure
+    user.notification_bundles.destroy_all
+    user.settings.update!(bundle_email_frequency: :never)
+  end
+end
