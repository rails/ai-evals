+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - &host fizzy.example.com # Your public hostname, also used for SSH
+
+proxy:
+  host: *host
+  ssl: true
+
+# Kamal pushes to a registry on your development machine and tunnels it over SSH.
