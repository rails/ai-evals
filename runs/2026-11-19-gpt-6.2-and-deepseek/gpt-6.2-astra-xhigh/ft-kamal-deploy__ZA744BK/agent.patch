+    MAILER_FROM_ADDRESS: notifications@example.com
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    JOB_CONCURRENCY: "1"
+    WEB_CONCURRENCY: "2"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    # Uncomment to enable browser push notifications.
+    # - VAPID_PUBLIC_KEY
+    # - VAPID_PRIVATE_KEY
+
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
