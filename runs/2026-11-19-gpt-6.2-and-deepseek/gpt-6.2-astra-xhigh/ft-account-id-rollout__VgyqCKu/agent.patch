diff --git a/test/models/account/tenant_schema_test.rb b/test/models/account/tenant_schema_test.rb
new file mode 100644
index 0000000..5715efd
--- /dev/null
+++ b/test/models/account/tenant_schema_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Account::TenantSchemaTest < ActiveSupport::TestCase
+  test "account data has a required, indexed UUID account_id" do
+    connection = ApplicationRecord.connection
+    global_tables = %w[ accounts account_external_id_sequences identities identity_access_tokens sessions magic_links action_pack_passkeys ]
+    internal_tables = %w[ ar_internal_metadata schema_migrations ]
+
+    global_tables.each do |table|
+      assert_not connection.column_exists?(table, :account_id), "#{table} should remain global"
+    end
+
+    (connection.tables - global_tables - internal_tables).reject { |table| table.start_with?("search_records_fts") }.each do |table|
+      column = connection.columns(table).find { |column| column.name == "account_id" }
+      assert column, "#{table} is missing account_id"
+      assert_equal :uuid, column.type, table
+      assert_not column.null, "#{table}.account_id is nullable"
+      assert connection.indexes(table).any? { |index| index.columns.first == "account_id" }, "#{table}.account_id is not indexed"
+    end
+  end
+
+  test "join rows and bulk grants belong to their owners, not the current request" do
+    account = accounts(:initech)
+    user = users(:mike)
+    board = boards(:miltons_wish_list)
+    tag = account.tags.create!(title: "tenant")
+    filter = user.filters.create!(boards: [ board ], assignees: [ user ], creators: [ user ], closers: [ user ], tags: [ tag ])
+
+    %i[ board tag assignee creator closer ].each do |kind|
+      assert_equal account, filter.public_send("#{kind}_selections").sole.account
+    end
+
+    member = account.users.create!(name: "New member")
+    assert_equal account, board.accesses.find_by!(user: member).account
+    board.accesses.grant_to(account.system_user)
+    assert_equal account, board.accesses.find_by!(user: account.system_user).account
+  end
+
+  test "rich text, inline uploads and derivatives inherit ownership without a request" do
+    card = cards(:radio)
+    Current.without_account do
+      card.update!(description: "new description")
+      assert_equal card.account, card.rich_text_description.reload.account
+
+      card.image.attach(io: StringIO.new("image"), filename: "image.png", content_type: "image/png")
+      assert_equal card.account, card.image.attachment.reload.account
+      assert_equal card.account, card.image.blob.reload.account
+
+      variant = card.image.blob.variant_records.create!(variation_digest: "digest")
+      assert_equal card.account, variant.reload.account
+      variant.image.attach(io: StringIO.new("variant"), filename: "variant.png", content_type: "image/png")
+      assert_equal card.account, variant.image.attachment.reload.account
+      assert_equal card.account, variant.image.blob.reload.account
+    end
+  end
+end
