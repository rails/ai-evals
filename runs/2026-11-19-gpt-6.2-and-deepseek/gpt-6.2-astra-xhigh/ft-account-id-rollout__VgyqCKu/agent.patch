+        inherit_polymorphic_account(:active_storage_attachments, :record, %w[ ActiveStorage::Blob ActiveStorage::VariantRecord ])
+        assigned = connection.update(<<~SQL)
+          UPDATE active_storage_blobs SET account_id = (
+            SELECT MIN(account_id) FROM active_storage_attachments WHERE blob_id = active_storage_blobs.id
+          ) WHERE account_id IS NULL AND EXISTS (
+            SELECT 1 FROM active_storage_attachments WHERE blob_id = active_storage_blobs.id AND account_id IS NOT NULL
+          )
+        SQL
+        break if assigned.zero?
+      end
+
+      # A shared blob has no unambiguous owner; don't silently expose its
+      # contents to whichever tenant happened to attach it first.
+      if shared_blob_id = connection.select_value(<<~SQL)
+        SELECT HEX(b.id) FROM active_storage_attachments a JOIN active_storage_blobs b ON b.id = a.blob_id
+        WHERE a.account_id <> b.account_id LIMIT 1
+      SQL
+        raise "Blob #{shared_blob_id} is shared between accounts; resolve its ownership before continuing the account_id rollout"
+      end
+
+      # An identity isn't an account. Its attachment can only be attributed
+      # when the blob has an independently established account.
+      execute <<~SQL
+        UPDATE active_storage_attachments SET account_id = (
+          SELECT account_id FROM active_storage_blobs WHERE id = active_storage_attachments.blob_id
+        ) WHERE account_id IS NULL AND record_type = 'Identity' AND record_id IN (SELECT id FROM identities)
+      SQL
+      execute "DELETE FROM active_storage_attachments WHERE blob_id NOT IN (SELECT id FROM active_storage_blobs)"
+    end
+
+    def remove_account_orphans(table)
+      execute "DELETE FROM #{connection.quote_table_name(table)} WHERE account_id IS NULL OR account_id NOT IN (SELECT id FROM accounts)"
+    end
+
+    def require_indexed_account(table)
+      change_column_null table, :account_id, false if column_exists?(table, :account_id, null: true)
+      unless connection.indexes(table).any? { |index| index.columns.first == "account_id" }
+        add_index table, :account_id
+      end
+    end
+end
