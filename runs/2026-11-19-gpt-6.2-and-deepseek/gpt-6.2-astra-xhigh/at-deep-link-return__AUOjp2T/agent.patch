+    url = book_slug_url(books(:handbook), page: 2, anchor: "notes")
+
+    [ path, url ].each do |destination|
+      sign_in_returning_to destination
+      assert_redirected_to path
+    end
+  end
+
+  test "create ignores unsafe return destinations" do
+    destinations = [
+      "https://elsewhere.example/book", "//elsewhere.example/book", root_url(port: 8888),
