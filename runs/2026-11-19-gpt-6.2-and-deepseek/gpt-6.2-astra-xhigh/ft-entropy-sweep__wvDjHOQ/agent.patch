diff --git a/app/models/board/entropic.rb b/app/models/board/entropic.rb
index d3e48d6..94ed3e8 100644
--- a/app/models/board/entropic.rb
+++ b/app/models/board/entropic.rb
@@ -6,6 +6,17 @@ module Board::Entropic
     has_one :entropy, as: :container, dependent: :destroy
   end
 
+  class_methods do
+    # Resolve the period per board, not per card, so the sweep can use an indexed activity cutoff.
+    def each_auto_postpone_group
+      preload(:entropy, account: :entropy).find_in_batches do |boards|
+        boards.group_by { |board| board.entropy&.auto_postpone_period }.each do |period, group|
+          yield group, period if period
+        end
+      end
+    end
+  end
+
   def entropy
     super || account.entropy
   end
diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..5830415 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -25,8 +25,14 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+      Board.each_auto_postpone_group do |boards, period|
+        system_users = {}
+        due = active.where(board: boards, last_active_at: ..(now - period))
+        due.find_each(cursor: [ :board_id, :last_active_at, :id ]) do |card|
+          system_user = system_users[card.account_id] ||= card.account.system_user
+          card.auto_postpone(user: system_user)
+        end
       end
     end
   end
