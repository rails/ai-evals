diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..f9de927
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "finds each card once by title, description or comment, newest first" do
+    with_current_user :david do
+      cards(:text).update!(title: "A Needle in the haystack", created_at: 3.days.ago)
+      cards(:shipping).update!(description: "<p>A <strong>NEED</strong>LE in the description</p>", created_at: 1.day.ago)
+      cards(:logo).update!(created_at: 2.days.ago)
+      comments(:logo_agreement_jz).update!(body: "First needle comment")
+      comments(:logo_agreement_kevin).update!(body: "Second needle comment")
+    end
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_equal [ cards(:shipping), cards(:logo), cards(:text) ].map { card_path(it) }, css_select("main article a").map { it["href"] }
+    assert_select "main article mark", text: "NEEDLE"
+    assert_select "main article mark", text: "needle"
+    assert_select "main article a mark", text: "Needle"
+  end
+
+  test "uses current board access for matching comments" do
+    card = cards(:logo)
+    board = boards(:private)
+    with_current_user(:david) { card.move_to(board) }
+
+    get search_path(q: "agree")
+    assert_response :success
+    assert_select "main article", count: 0
+
+    board.accesses.grant_to(users(:david))
+    get search_path(q: "agree")
+    assert_select "main article a", text: card.title
+    assert_select "main article mark", text: "agree"
+    assert_includes response.headers["Cache-Control"], "no-store"
+
+    board.accesses.revoke_from(users(:david))
+    get search_path(q: "agree")
+    assert_select "main article", count: 0
+  end
+
+  test "excludes draft cards and their comments, even for the creator" do
+    card = cards(:logo)
+    card.update!(status: :drafted, description: "Draft description")
+
+    [ "logo", "Draft description", "agree" ].each do |query|
+      get search_path(q: query)
+      assert_response :success
+      assert_select "main article", count: 0
+    end
+  end
+
+  test "does not return cards from other accounts" do
+    get search_path(q: cards(:radio).title)
+    assert_response :success
+    assert_select "main article", count: 0
+  end
+
+  test "searches literal text, not SQL wildcards or HTML, and escapes highlighted results" do
+    with_current_user :david do
+      cards(:logo).update!(title: "<em>100%_done</em>")
+      cards(:text).update!(title: "100xxdone")
+      comments(:logo_agreement_kevin).update!(body: '<p class="hidden-keyword">&lt;em&gt;100%_done&lt;/em&gt;</p>')
+    end
+
+    get search_path(q: "%_")
+    assert_response :success
+    assert_select "main article", count: 1
+    assert_select "main article a", text: "<em>100%_done</em>"
+    assert_select "main article p", text: "<em>100%_done</em>"
+    assert_select "main article mark", text: "%_", count: 2
+    assert_select "main article em", count: 0
+
+    get search_path(q: "hidden-keyword")
+    assert_select "main article", count: 0
+  end
+
+  test "blank query shows the search form without results" do
+    get search_path(q: "  ")
+    assert_response :success
+    assert_select "main form[action=?][method=get] input[type=search][name=q]", search_path
+    assert_select "main article", count: 0
+  end
+
+  test "later pages preserve the query and newest-first order" do
+    with_current_user :david do
+      16.times do |i|
+        boards(:writebook).cards.create!(title: "Searchable card #{i}", status: :published, created_at: i.days.ago)
+      end
+    end
+
+    get search_path(q: "Searchable")
+    assert_select "main article", count: 15
+    assert_select "main article:first-of-type a", text: "Searchable card 0"
+    get css_select("main a.pagination-link").first["href"]
+    assert_response :success
+    assert_select "main article", count: 1
+    assert_select "main article a", text: "Searchable card 15"
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path(q: "logo")
+    assert_response :redirect
+  end
+end
