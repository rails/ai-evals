diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..1080f7a
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,39 @@
+class Card::Search
+  attr_reader :query
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.strip
+  end
+
+  def cards
+    if query.present?
+      Card.from(cards_with_passages, :cards)
+        .where("INSTR(LOWER(title), :needle) > 0 OR INSTR(LOWER(description_text), :needle) > 0 OR comment_text IS NOT NULL", needle: folded_query)
+        .reverse_chronologically
+    else
+      Card.none
+    end
+  end
+
+  private
+    def cards_with_passages
+      @user.accessible_cards.published.where(account_id: @user.account_id)
+        .left_joins(:rich_text_description)
+        .select("cards.*", "action_text_rich_texts.plain_text AS description_text", matching_comment.arel.as("comment_text"))
+    end
+
+    # A scalar subquery keeps one row per card, no matter how many comments match.
+    def matching_comment
+      comments = Comment.where("comments.card_id = cards.id")
+      ActionText::RichText.where(record_type: "Comment", name: "body", record_id: comments.select(:id))
+        .where("INSTR(LOWER(plain_text), ?) > 0", folded_query)
+        .select(:plain_text).limit(1)
+    end
+
+    def folded_query
+      # Compare folded text literally, without MySQL's default accent folding.
+      sql = Fizzy.db_adapter.sqlite? ? "LOWER(?)" : "CAST(LOWER(?) AS BINARY)"
+      Arel.sql(sql, query)
+    end
+end
