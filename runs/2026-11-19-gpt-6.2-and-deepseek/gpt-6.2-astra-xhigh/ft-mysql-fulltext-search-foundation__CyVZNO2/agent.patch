diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..2897a48
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,29 @@
+<% @page_title = "Search cards" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="panel panel--wide center txt-align-start">
+  <%= form_with url: search_path, method: :get, role: "search", class: "flex align-center gap-half" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search titles, descriptions, and comments…", class: "input full-width", autofocus: true %>
+    <button type="submit" class="btn">Search</button>
+  <% end %>
+
+  <% if @page.used? %>
+    <%= with_automatic_pagination :search_results, @page do %>
+      <% @page.records.each do |card| %>
+        <article class="margin-block">
+          <h2 class="txt-medium"><%= link_to highlight_search_match(card.title, @search.query), card, data: { turbo_frame: "_top" } %></h2>
+          <% if passage = excerpt(card.description_text, @search.query) || excerpt(card.comment_text, @search.query) %>
+            <p><%= highlight_search_match(passage, @search.query) %></p>
+          <% end %>
+        </article>
+      <% end %>
+    <% end %>
+  <% elsif @search.query.present? %>
+    <p>No cards match your search.</p>
+  <% end %>
+</div>
