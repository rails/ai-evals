index 0000000..ea2c1e9
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    stub_dns_resolution "93.184.216.34"
+    freeze_time
+  end
+
+  test "the tenth consecutive failure after an hour disables the webhook until reactivated" do
+    stub_request(:post, @webhook.url).to_return(status: 503)
+    deliver_event
+    travel 1.hour
+    8.times { deliver_event }
+    assert @webhook.reload.active?, "Nine failures are not enough"
+
+    delivery = deliver_event
+    assert delivery.failed?
+    assert_equal 503, delivery.response[:code]
+    assert_not @webhook.reload.active?
+
+    @webhook.activate
+    deliver_event
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+    assert @webhook.active?
+  end
+
+  test "a burst of ten failures does not deactivate the webhook, and a success resets the clock" do
+    stub_request(:post, @webhook.url).to_return({ status: 429 }).times(10).then.to_return({ status: 200 }, { status: 500 })
+    10.times { deliver_event }
+    assert @webhook.reload.active?
+
+    travel 2.hours
+    assert deliver_event.succeeded?
+    assert_nil @webhook.reload.delinquency_tracker.first_failure_at
+    deliver_event
+    assert @webhook.reload.active?
+    assert_equal Time.current, @webhook.delinquency_tracker.first_failure_at
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  private
+    def deliver_event
+      event = cards(:logo).track_event("closed", creator: users(:david))
+      event.webhook_deliveries.sole.tap(&:deliver)
+    end
+end
diff --git a/test/models/webhook/delivery/request_test.rb b/test/models/webhook/delivery/request_test.rb
new file mode 100644
index 0000000..c03c423
--- /dev/null
+++ b/test/models/webhook/delivery/request_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Webhook::Delivery::RequestTest < ActiveSupport::TestCase
+  setup do
+    @event = events(:layout_commented)
+    stub_dns_resolution "93.184.216.34"
+  end
+
+  test "generic JSON includes the comment and board" do
+    body = JSON.parse(post_body("https://example.com/incoming"))
+    assert_equal @event.action, body["action"]
+    assert_equal @event.eventable_id, body.dig("eventable", "id")
+    assert_equal @event.card.id, body.dig("eventable", "card", "id")
+  end
+
+  test "Slack receives a JSON text message" do
+    body = post_body("https://hooks.slack.com/services/T123/B456/test") # gitleaks:allow
+    assert_includes JSON.parse(body).fetch("text"), "commented on"
+  end
+
+  test "Basecamp receives a JSON content message" do
+    body = post_body("https://3.basecamp.com/123/integrations/test/buckets/456/chats/789/lines")
+    assert_includes JSON.parse(body).fetch("content"), "<a href="
+  end
+
+  test "Campfire receives an HTML message" do
+    body = post_body("https://campfire.example.com/rooms/123/456-test/messages", content_type: "text/html")
+    assert_includes body, "commented on"
+    assert_includes body, "<a href="
+  end
+
+  private
+    def post_body(url, content_type: "application/json")
+      webhook = @event.board.webhooks.create!(name: "Receiver", url: url)
+      body = nil
+      stub_request(:post, url).with(headers: { "Content-Type" => content_type }).to_return do |request|
+        body = request.body
+        { status: 200 }
+      end
+      webhook.deliveries.create!(event: @event).deliver
+      body
+    end
+end
