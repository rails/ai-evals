@@ -10,6 +10,26 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).in_batches.delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    return unless claim
+
+    if !webhook.active?
+      update! state: :errored, response: { error: "webhook_inactive" }
+    elsif event.board_id != webhook.board_id || event.card.board_id != webhook.board_id
+      update! state: :errored, response: { error: "event_moved" }
+    else
+      record_result(transmit)
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +49,28 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    # Commit the claim before doing I/O. Never repeat an attempt whose receiver
+    # might already have acted on it, even if the worker didn't record a result.
+    def claim
+      with_lock { in_progress! if pending? }
+    end
+
+    def transmit
+      outgoing = Request.new(self)
+      update! request: { headers: outgoing.headers.except("X-Webhook-Signature") }
+      outgoing.post
+    rescue StandardError
+      # Unexpected local errors belong in the job monitor, not in the receiver's failure streak.
+      update! state: :errored, response: { error: "delivery_error" }
+      raise
+    end
+
+    def record_result(result)
+      transaction do
+        update! state: result[:error] ? :errored : :completed, response: result
+        webhook.record_outcome(self)
+      end
+    end
 end
diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..31d8709
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,71 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  attr_reader :delivery
+  delegate :webhook, :event, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def headers
+    @headers ||= {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => webhook.for_campfire? ? "text/html" : "application/json",
+      "Idempotency-Key" => delivery.id,
+      "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    }
+  end
+
+  def post
+    uri = URI.parse(webhook.url)
+    return { error: "invalid_url" } unless uri.is_a?(URI::HTTP) && uri.hostname.present?
+
+    if ip = SsrfProtection.resolve_public_ip(uri.hostname)
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      # Only the status is needed: don't download a receiver-controlled body.
+      Timeout.timeout(15) do
+        connection(uri, ip).request(request, body) { |response| return { code: response.code.to_i } }
+      end
+    else
+      { error: "destination_unreachable" }
+    end
+  rescue URI::InvalidURIError
+    { error: "invalid_url" }
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError, Resolv::ResolvError
+    { error: "destination_unreachable" }
+  end
+
+  private
+    def connection(uri, ip)
+      # Pin the vetted IP, keeping the hostname for TLS and the Host header.
+      # Do not use environment proxies, follow redirects or retry a POST.
+      Net::HTTP.new(uri.hostname, uri.port, nil).tap do |http|
+        http.ipaddr = ip
+        http.use_ssl = uri.is_a?(URI::HTTPS)
+        http.open_timeout = http.read_timeout = http.write_timeout = 5
+        http.max_retries = 0
+      end
+    end
+
+    def body
+      @body ||= if webhook.for_slack?
+        { text: render_event(:text).strip }.to_json
+      elsif webhook.for_basecamp?
+        { content: render_event(:html).strip }.to_json
+      elsif webhook.for_campfire?
+        render_event(:html)
+      else
+        render_event(:json)
+      end
+    end
+
+    def render_event(format)
+      ApplicationController.renderer.new(script_name: event.account.slug).render(
+        template: "webhooks/event", formats: [ format ], assigns: { event: event }, layout: false
+      )
+    end
+end
