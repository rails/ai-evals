diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..da0f29b
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,37 @@
+<% @page_title = "Search cards" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide center txt-align-start">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half", html: { role: "search" } do |form| %>
+    <%= form.label :q, "Search titles, descriptions and comments", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search titles, descriptions and comments…",
+          class: "input full-width", maxlength: Card::Search::MAX_QUERY_LENGTH, autofocus: true %>
+    <%= form.submit "Search", name: nil, class: "btn" %>
+  <% end %>
+
+  <% if @search.too_long? %>
+    <p>Use <%= Card::Search::MAX_QUERY_LENGTH %> characters or fewer.</p>
+  <% elsif @search.query.present? %>
+    <%= with_manual_pagination :search_results, @page do %>
+      <% @page.records.each do |card| %>
+        <article class="margin-block">
+          <small><%= card.board_name %> · #<%= card.number %></small>
+          <h2><%= link_to highlight_search_matches(card.title, @search.highlight_pattern), card, data: { turbo_frame: "_top" } %></h2>
+          <% if description = highlighted_search_excerpt(card.description_text, @search.highlight_pattern) %>
+            <p><%= description %></p>
+          <% end %>
+          <% if comment = highlighted_search_excerpt(card.comment_text, @search.highlight_pattern) %>
+            <p>Comment: <%= comment %></p>
+          <% end %>
+        </article>
+      <% end %>
+      <% if @page.empty? %>
+        <p>No cards match your search.</p>
+      <% end %>
+    <% end %>
+  <% end %>
+</section>
