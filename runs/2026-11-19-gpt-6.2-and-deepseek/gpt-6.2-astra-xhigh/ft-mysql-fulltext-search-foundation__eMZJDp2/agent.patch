diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..f786f0c
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.user = users(:david)
+  end
+
+  test "finds and highlights title, description and comment matches once per card, newest first" do
+    oldest = boards(:writebook).cards.create!(title: "A Sundial", status: :published, created_at: 3.days.ago)
+    cards(:layout).update!(description: "<p>An old <b>sun</b>dial.</p>", created_at: 1.day.ago)
+    cards(:text).update!(created_at: 2.days.ago)
+    2.times { cards(:text).comments.create!(creator: users(:kevin), body: "<p>Use a SUNDIAL instead</p>") }
+
+    get search_path(q: "sundial")
+
+    assert_response :success
+    assert_equal [ cards(:layout), cards(:text), oldest ].map { card_path(it) }, css_select("main a[href*='/cards/']").map { it["href"] }
+    assert_dom "main mark", text: "sundial"
+    assert_dom "main mark", text: "SUNDIAL"
+    assert_dom "main a mark", text: "Sundial"
+  end
+
+  test "only searches currently accessible boards and never drafts or their comments" do
+    boards(:private).accesses.grant_to(users(:david))
+    private_card = boards(:private).cards.create!(creator: users(:kevin), status: :published, title: "Private plans")
+    private_card.comments.create!(creator: users(:kevin), body: "Sundial construction")
+    cards(:logo).update!(title: "Sundial draft")
+    comments(:layout_overflowing_david).update!(body: "Sundial comment on a draft")
+    cards(:logo, :layout).each(&:drafted!)
+    cards(:radio).update_column(:title, "Sundial in another account")
+
+    get search_path(q: "sundial")
+    assert_response :success
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_dom "meta[name='turbo-cache-control'][content='no-cache']"
+    assert_dom "main a[href*='/cards/']", count: 1, text: private_card.title
+
+    boards(:private).accesses.revoke_from(users(:david))
+    get search_path(q: "sundial")
+    assert_response :success
+    assert_dom "main a[href*='/cards/']", count: 0
+    assert_dom "main mark", count: 0
+  end
+
+  test "search is literal, matches visible text rather than markup, and escapes snippets" do
+    cards(:text).update!(description: '<p class="markup-only">&lt;em&gt;50%_off [Deal]&lt;/em&gt;</p>')
+    cards(:layout).update!(description: "50XXoff [Deal]")
+    cards(:shipping).update!(description: "50%_off [Déal]")
+
+    get search_path(q: "[deal] 50%_off")
+    assert_response :success
+    assert_dom "main article", count: 1 do
+      assert_dom "a[href=?]", card_path(cards(:text))
+      assert_dom "mark", text: "[Deal]"
+      assert_dom "mark", text: "50%_off"
+      assert_dom "p", text: "<em>50%_off [Deal]</em>"
+      assert_dom "em", count: 0
+    end
+
+    get search_path(q: "markup-only")
+    assert_dom "main article", count: 0
+  end
+
+  test "changes to comments are reflected on the next search" do
+    comment = comments(:logo_agreement_jz)
+    comment.update!(body: "A sundial")
+    get search_path(q: "sundial")
+    assert_dom "main a[href=?]", card_path(cards(:logo))
+
+    comment.update!(body: "A clock")
+    get search_path(q: "sundial")
+    assert_dom "main article", count: 0
+
+    get search_path(q: "clock")
+    assert_dom "main mark", text: "clock"
+
+    comment.destroy!
+    get search_path(q: "clock")
+    assert_dom "main article", count: 0
+  end
+
+  test "blank search shows the search form without listing cards" do
+    get search_path
+    assert_response :success
+    assert_dom "main form[action=?][method=get] input[type=search][name=q]", search_path
+    assert_dom "main article", count: 0
+
+    get search_path(q: "  ")
+    assert_response :success
+    assert_dom "main article", count: 0
+  end
+
+  test "search requires signing in" do
+    sign_out
+    get search_path(q: "logo")
+    assert_response :redirect
+    assert_dom "main mark", count: 0
+  end
+end
