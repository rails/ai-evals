@@ -0,0 +1,11 @@
+module SearchesHelper
+  def highlight_search_matches(text, pattern)
+    safe_join(text.split(pattern).map.with_index { |part, index| index.odd? ? tag.mark(part) : part })
+  end
+
+  def highlighted_search_excerpt(text, pattern)
+    if snippet = excerpt(text, pattern)
+      highlight_search_matches(snippet, pattern)
+    end
+  end
+end
