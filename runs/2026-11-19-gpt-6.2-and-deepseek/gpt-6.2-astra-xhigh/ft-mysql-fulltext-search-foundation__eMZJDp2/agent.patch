diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..ca1af58
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,63 @@
+class Card::Search
+  MAX_QUERY_LENGTH = 256
+
+  attr_reader :query
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.strip
+    @terms = @query.split.uniq
+  end
+
+  def cards
+    return Card.none if terms.empty? || too_long?
+
+    cards = @user.accessible_cards.published.where(account_id: @user.account_id).left_joins(:rich_text_description)
+    comment = matching_comment_text.arel
+
+    matching(cards, Card.arel_table[:title])
+      .or(matching(cards, plain_text_column))
+      .or(cards.where(comment.exists))
+      .select("cards.*", "boards.name AS board_name", "action_text_rich_texts.plain_text AS description_text", comment.as("comment_text"))
+      .reverse_chronologically
+  end
+
+  def too_long?
+    query.length > MAX_QUERY_LENGTH
+  end
+
+  def highlight_pattern
+    @highlight_pattern ||= /(#{Regexp.union(terms.sort_by { -it.length }).source})/i
+  end
+
+  private
+    attr_reader :terms
+
+    # Select one matching body, rather than duplicating cards with several matching comments.
+    def matching_comment_text
+      comments = Comment.left_joins(:rich_text_body).where("comments.card_id = cards.id")
+      matching(comments, plain_text_column)
+        .order(created_at: :desc, id: :desc).limit(1).select(plain_text_column)
+    end
+
+    def plain_text_column
+      ActionText::RichText.arel_table[:plain_text]
+    end
+
+    def matching(scope, column)
+      terms.reduce(scope) do |matches, term|
+        matches.where(column.lower.matches(literal_pattern(term), "!"))
+      end
+    end
+
+    def literal_pattern(term)
+      pattern = "%#{Card.sanitize_sql_like(term, "!")}%"
+
+      # MySQL's default collation ignores accents; highlighting matches literal text.
+      if Fizzy.db_adapter.sqlite?
+        Arel.sql("LOWER(?)", pattern)
+      else
+        Arel.sql("CAST(LOWER(?) AS BINARY)", pattern)
+      end
+    end
+end
