diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..0831372
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,33 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 14 * 24.hours
+
+  included do
+    scope :stalled, -> { active.where(had_burst: true, last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def stalls_at
+    last_active_at + STALL_PERIOD if had_burst? && active?
+  end
+
+  def stalled?
+    had_burst? && last_active_at <= STALL_PERIOD.ago && active?
+  end
+
+  def comment_burst?(around: nil)
+    window = auto_postpone_period / 3
+    conversation = comments.by_user
+
+    if around
+      conversation = conversation.where(created_at: (around.created_at - window)..(around.created_at + window))
+      return false unless conversation.where.not(creator_id: around.creator_id).exists?
+    end
+
+    # Any qualifying conversation contains three consecutive comments that
+    # qualify. Look on both sides because comments can be backdated on import.
+    conversation.select(:id, :created_at, :creator_id).find_each(cursor: [ :created_at, :id ]).each_cons(3).any? do |trio|
+      trio.last.created_at - trio.first.created_at <= window && trio.map(&:creator_id).uniq.many?
+    end
+  end
+end
