new file mode 100644
index 0000000..b665246
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create!(title: "Going cold", status: :published)
+  end
+
+  test "a conversation within a third of the board period stalls after two quiet weeks" do
+    comment_by :david
+    travel 30.days # One third of Writebook's 90-day override
+    comment_by :kevin
+    comment_by :kevin
+
+    travel 2.weeks - 1.second
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+    travel 1.second
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+
+    @card.reactions.create!(content: "👍")
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "two comments, a single author, or a system comment do not make a burst" do
+    comment_by :david
+    comment_by :kevin
+    comment_by :system
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+
+    travel 30.days
+    3.times { comment_by :david }
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "the whole conversation must fit in the window, using account entropy without a board override" do
+    @card.board.entropy.destroy!
+    @card.reload
+    comment_by :david
+    travel 5.days
+    comment_by :kevin
+    travel 5.days + 1.second
+    comment_by :david
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "assignment and reopening are bursts without a conversation" do
+    @card.toggle_assignment(users(:kevin))
+    travel 2.weeks
+    assert @card.reload.stalled?
+
+    @card.close
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    other = cards(:shipping)
+    other.reopen
+    travel 2.weeks
+    assert other.reload.stalled?
+  end
+
+  test "backdated comments can complete a burst in the middle of the window" do
+    [ [ :david, 30.days.ago ], [ :david, Time.current ], [ :kevin, 15.days.ago ] ].each do |user, time|
+      @card.comments.create!(creator: users(user), created_at: time, body: "Imported comment")
+    end
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "editing content and working on steps restart the inactivity clock" do
+    @card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+    travel 2.weeks
+    assert @card.reload.stalled?
+
+    @card.update!(description: "Draft ready for review")
+    assert_not @card.reload.stalled?
+    travel 2.weeks - 1.second
+    assert_not @card.stalled?
+    travel 1.second
+    assert @card.stalled?
+
+    @card.steps.create!(content: "Review")
+    assert_not @card.reload.stalled?
+  end
+
+  test "a postponed card is not stalled" do
+    @card.toggle_assignment(users(:kevin))
+    @card.postpone
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  private
+    def comment_by(user)
+      @card.comments.create!(creator: users(user), body: "A thought")
+    end
+end
