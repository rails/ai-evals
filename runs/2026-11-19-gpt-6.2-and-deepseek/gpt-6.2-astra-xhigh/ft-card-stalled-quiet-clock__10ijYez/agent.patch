+++ b/test/system/stalled_cards_test.rb
@@ -0,0 +1,26 @@
+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  test "a stalled card is flagged on previews and on the card until someone comments" do
+    card = cards(:buy_domain)
+    with_current_user(:david) { card.toggle_assignment(users(:kevin)) }
+    card.update!(last_active_at: 15.days.ago)
+    sign_in_as(users(:david))
+
+    card.board.publish
+    visit published_board_url(card.board)
+    within("##{dom_id(card, :article)}") { assert_selector ".bubble", text: /stalled/i }
+
+    visit published_card_url(card)
+    assert_selector ".card-perma .bubble", text: /stalled/i
+
+    visit cards_url(indexed_by: "stalled")
+    within("##{dom_id(card, :article)}") { assert_selector ".bubble", text: /stalled/i }
+
+    visit card_url(card)
+    assert_selector ".card-perma .bubble", text: /stalled/i
+    find("lexxy-editor [contenteditable=true]").send_keys("Picking this back up")
+    click_on "Post"
+    assert_no_selector ".card-perma .bubble", text: /stalled/i
+  end
+end
