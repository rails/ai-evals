diff --git a/app/controllers/sessions_controller.rb b/app/controllers/sessions_controller.rb
index 2bef7c1..81262b3 100644
--- a/app/controllers/sessions_controller.rb
+++ b/app/controllers/sessions_controller.rb
@@ -10,7 +10,7 @@ class SessionsController < ApplicationController
   def create
     if user = User.active.authenticate_by(email_address: params[:email_address], password: params[:password])
       start_new_session_for user
-      redirect_to params[:return_to].presence || post_authenticating_url, allow_other_host: true
+      redirect_to safe_return_to_url || post_authenticating_url
     else
       render_rejection :unauthorized
     end
@@ -22,6 +22,22 @@ class SessionsController < ApplicationController
   end
 
   private
+    def safe_return_to_url
+      location = params[:return_to]
+      return unless location.is_a?(String) && !location.match?(/[[:cntrl:]\\]/)
+      return url_from(location) if location.start_with?("/") && !location.start_with?("//")
+      return unless location.match?(%r{\Ahttps?://}i)
+
+      uri = URI.parse(location)
+      if !uri.userinfo && uri.origin.casecmp?(request.base_url)
+        # Rails compares redirect hosts case-sensitively. Use the request's spelling.
+        uri.host = request.host
+        uri.to_s
+      end
+    rescue URI::Error, ArgumentError
+      nil
+    end
+
     def ensure_user_exists
       redirect_to first_run_url if User.none?
     end
