+  test "create returns to a deep link supplied as a path or a same-origin URL" do
+    https!
+    host! "books.example.test:8443"
+    path = leafable_slug_path(leaves(:welcome_page), highlight: "welcome back", anchor: "intro")
+
+    [ path, "https://#{host.upcase}#{path}" ].each do |return_to|
+      sign_in_returning_to return_to
+      assert_redirected_to path
+    end
+  end
+
+  test "create ignores return locations outside the current origin" do
+    https!
+    host! "books.example.test"
+
+    [ "https://other.example.test/book", "//other.example.test/book", "http://#{host}/book",
+      "https://#{host}:8443/book", "ftp://#{host}/book" ].each do |return_to|
+      sign_in_returning_to return_to
+      assert_redirected_to root_path
+    end
+  end
+
+  test "create ignores malformed and non-string return locations" do
