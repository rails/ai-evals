diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..c889efb
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts("37s")
+    @other_account = accounts(:initech)
+  end
+
+  test "incinerates only accounts cancelled more than 30 days ago" do
+    freeze_time do
+      @account.cancel(initiated_by: users(:jason))
+      travel 30.days
+      @other_account.cancel(initiated_by: users(:mike))
+
+      assert_no_difference "Account.count" do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      travel 1.second
+      Account::IncinerateDueJob.perform_now
+      assert_not Account.exists?(@account.id)
+      assert Account.exists?(@other_account.id)
+      assert Account.exists?(accounts(:acme).id)
+    end
+  end
+
+  test "reactivation followed by a new cancellation starts a new grace period" do
+    travel_to(31.days.ago) { @account.cancel(initiated_by: users(:jason)) }
+    candidate = Account.due_for_incineration.find(@account.id)
+    @account.reactivate
+    candidate.incinerate_if_due
+    assert Account.exists?(@account.id)
+
+    @account.cancel(initiated_by: users(:jason))
+    Account::IncinerateDueJob.perform_now
+    assert Account.exists?(@account.id)
+  end
+
+  test "removes tenant data but preserves other tenants and shared identities" do
+    identity = users(:david).identity
+    other_user = @other_account.users.create!(name: "David", identity: identity)
+    cards(:logo).reindex
+    cards(:radio).reindex
+
+    travel_to(31.days.ago) { @account.cancel(initiated_by: users(:jason)) }
+    assert_difference -> { Filter.connection.select_value("SELECT COUNT(*) FROM assignees_filters") }, -1 do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+
+    [ Account::Cancellation, User, Board, Card, Comment, ActionText::RichText, Export, Event ].each do |model|
+      assert_not model.exists?(account_id: @account.id), "expected all #{model.name} rows for the account to be removed"
+    end
+    assert_not Search::Record.for(@account.id).exists?(account_id: @account.id)
+    assert Search::Record.for(@other_account.id).exists?(account_id: @other_account.id)
+    if Fizzy.db_adapter.sqlite?
+      fts = Search::Record::SQLite::Fts
+      assert_not fts.exists?(title: cards(:logo).title)
+      assert fts.exists?(title: cards(:radio).title)
+    end
+    assert Card.exists?(account: @other_account)
+    assert User.exists?(other_user.id)
+    assert Identity.exists?(identity.id)
+    assert Session.exists?(identity: identity)
+  end
+
+  test "purges uploads, including unattached blobs, and clears storage accounting" do
+    board = boards(:writebook)
+    other_blob = Current.with_account(@other_account) do
+      ActiveStorage::Blob.create_before_direct_upload!(filename: "keep.txt", byte_size: 4, checksum: Digest::MD5.base64digest("keep"))
+    end
+    cards(:logo).image.attach(io: StringIO.new("content"), filename: "file.txt")
+    ActiveStorage::Blob.create_and_upload!(io: StringIO.new("direct upload"), filename: "private.txt")
+    board.materialize_storage
+    @account.materialize_storage
+    assert Storage::Entry.exists?(account: @account)
+
+    travel_to(31.days.ago) { @account.cancel(initiated_by: users(:jason)) }
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) { Account::IncinerateDueJob.perform_now }
+
+    assert_not ActiveStorage::Attachment.exists?(account: @account)
+    assert_not ActiveStorage::Blob.exists?(account: @account)
+    assert ActiveStorage::Blob.exists?(other_blob.id)
+    assert_not Storage::Entry.exists?(account: @account)
+    assert_not Storage::Total.exists?(owner: board)
+    assert_not Storage::Total.exists?(owner: @account)
+  end
+end
