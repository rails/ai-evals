new file mode 100644
index 0000000..04a3b4f
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,21 @@
+module EmailCodeAuthentication
+  private
+
+  def request_email_code(email_address, purpose:, invitation: nil)
+    link = MagicLink.new(email_address: email_address, purpose: purpose, invitation: invitation)
+
+    if link.save
+      link.deliver_later
+      cookies.signed[:pending_authentication_token] = {
+        value: link.id, expires: link.created_at + MagicLink::LIFETIME, httponly: true, same_site: :lax
+      }
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil) }
+        format.json { render json: { pending_authentication_token: cookies[:pending_authentication_token] }, status: :created }
+      end
+    else
+      head :unprocessable_entity
+    end
+  end
+end
