diff --git a/test/integration/email_code_authentication_test.rb b/test/integration/email_code_authentication_test.rb
new file mode 100644
index 0000000..b3c1e69
--- /dev/null
+++ b/test/integration/email_code_authentication_test.rb
@@ -0,0 +1,182 @@
+require "test_helper"
+
+class EmailCodeAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "sign in with the code from the email subject" do
+    identity = identities(:kevin)
+
+    untenanted do
+      code = request_code(identity.email_address) do
+        post session_path, params: { email_address: identity.email_address.upcase }
+      end
+
+      follow_redirect!
+      assert_select "form[action=?] input[name=code][autocomplete=one-time-code]", session_magic_link_path
+
+      travel 14.minutes
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to landing_path
+      assert_equal identity, Session.find_signed!(parsed_cookies.signed[:session_token]).identity
+    end
+  end
+
+  test "signup completes after confirming the email address" do
+    email = "new-person@example.com"
+
+    untenanted do
+      code = request_code(email) do
+        post signup_path, params: { signup: { email_address: email } }
+      end
+
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to new_signup_completion_path
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+      owner = Identity.find_by!(email_address: email).users.sole
+      assert_predicate owner, :owner?
+      assert_redirected_to landing_path(script_name: owner.account.slug)
+    end
+  end
+
+  test "join redeems the original invitation after confirming the email address" do
+    email = "new-member@example.com"
+    invitation = account_join_codes(:"37s")
+
+    code = request_code(email) do
+      assert_no_difference [ -> { User.count }, -> { invitation.reload.usage_count } ] do
+        post join_path(code: invitation.code, script_name: invitation.account.slug), params: { email_address: email }
+      end
+    end
+
+    untenanted do
+      follow_redirect!
+      assert_select "form[action=?] input[name=code]", session_magic_link_path(script_name: nil)
+      assert_difference -> { invitation.reload.usage_count }, 1 do
+        post session_magic_link_path, params: { code: code }
+      end
+    end
+    assert_redirected_to new_users_verification_url(script_name: invitation.account.slug)
+    post users_verifications_path(script_name: invitation.account.slug)
+    assert_redirected_to new_users_join_path(script_name: invitation.account.slug)
+    post users_joins_path(script_name: invitation.account.slug), params: { user: { name: "New Member" } }
+    assert_redirected_to landing_path(script_name: invitation.account.slug)
+    assert_predicate invitation.account.users.find_by!(name: "New Member"), :verified?
+  end
+
+  test "native clients can exchange the pending cookie and code for a session token" do
+    identity = identities(:david)
+    untenanted do
+      code = request_code(identity.email_address) do
+        post session_path, params: { email_address: identity.email_address }, as: :json
+      end
+      assert_response :created
+      pending_token = response.parsed_body.fetch("pending_authentication_token")
+      assert_equal cookies[:pending_authentication_token], pending_token
+
+      cookies.delete("pending_authentication_token")
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: code }, as: :json
+        assert_response :unauthorized
+      end
+
+      cookies[:pending_authentication_token] = pending_token
+      post session_magic_link_path, params: { code: "wrong" }, as: :json
+      assert_response :unauthorized
+      assert_nil cookies[:session_token]
+
+      post session_magic_link_path, params: { code: code.downcase }, as: :json
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body.fetch("session_token")
+      assert_equal identity, Session.find_signed!(parsed_cookies.signed[:session_token]).identity
+      assert_not cookies[:pending_authentication_token].present?
+
+      cookies[:pending_authentication_token] = pending_token
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: code }, as: :json
+        assert_response :unauthorized
+      end
+    end
+  end
+
+  test "verification signs in the requested identity and returns to the original page" do
+    board = boards(:writebook)
+    destination = board_url(board, script_name: board.account.slug)
+    get destination
+    assert_redirected_to new_session_url(script_name: nil)
+
+    identity = identities(:kevin)
+    code = request_code(identity.email_address) { post session_path(script_name: nil), params: { email_address: identity.email_address } }
+    post session_magic_link_path(script_name: nil), params: { code: code, email_address: identities(:mike).email_address }
+    assert_redirected_to destination
+    assert_equal identity, Session.find_signed!(parsed_cookies.signed[:session_token]).identity
+  end
+
+  test "code expires after fifteen minutes" do
+    freeze_time
+    email = identities(:kevin).email_address
+    untenanted do
+      code = request_code(email) { post session_path, params: { email_address: email } }
+      travel 15.minutes
+      post session_magic_link_path, params: { code: code }, as: :json
+      assert_response :unauthorized
+      assert_nil cookies[:session_token]
+    end
+  end
+
+  test "invalid addresses are rejected, and sign-in does not register unknown addresses" do
+    untenanted do
+      assert_no_emails do
+        post session_path, params: { email_address: "invalid" }
+        assert_response :unprocessable_entity
+
+        assert_no_difference [ -> { Identity.count }, -> { Session.count } ] do
+          post session_path, params: { email_address: "unknown@example.com" }
+          assert_redirected_to new_session_magic_link_path
+          follow_redirect!
+          assert_response :success
+        end
+      end
+    end
+  end
+
+  test "an invitation reset after the email was sent cannot be redeemed" do
+    invitation = account_join_codes(:"37s")
+    email = "invitee@example.com"
+    code = request_code(email) do
+      post join_path(code: invitation.code, script_name: invitation.account.slug), params: { email_address: email }
+    end
+    invitation.reset
+
+    untenanted do
+      assert_no_difference [ -> { User.count }, -> { Identity.count }, -> { invitation.reload.usage_count } ] do
+        post session_magic_link_path(script_name: nil), params: { code: code }
+        assert_response :gone
+        assert_nil cookies[:session_token]
+      end
+    end
+  end
+
+  test "verification attempts are rate limited" do
+    email = identities(:kevin).email_address
+    untenanted do
+      code = request_code(email) { post session_path, params: { email_address: email } }
+      Rails.cache.stubs(:increment).returns(11)
+      post session_magic_link_path, params: { code: code }
+      assert_response :too_many_requests
+      assert_nil cookies[:session_token]
+    end
+  end
+
+  private
+    def request_code(email)
+      message = capture_emails { yield }.sole
+      assert_redirected_to new_session_magic_link_path(script_name: nil) unless request.format.json?
+      assert_equal [ email ], message.to
+      assert_match(/\b[A-Z0-9]{6}\b/, message.subject)
+      assert_nil cookies[:session_token]
+      message.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
