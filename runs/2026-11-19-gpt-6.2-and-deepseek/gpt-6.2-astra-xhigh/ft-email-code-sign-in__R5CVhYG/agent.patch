diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..baff6dd
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,83 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+  before_action :set_magic_link
+  rate_limit to: 10, within: MagicLink::LIFETIME, by: -> { @link.id }, name: "code", only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @start_over_path = if @link.sign_up?
+      new_signup_path
+    elsif @link.join? && (invitation = @link.invitation)
+      join_path(code: @link.invitation_code, script_name: invitation.account.slug)
+    else
+      new_session_path
+    end
+  end
+
+  def create
+    if @link.consume(params[:code])
+      cookies.delete(:pending_authentication_token)
+      case @link.purpose
+      when "sign_in" then complete_sign_in
+      when "sign_up" then continue_signup
+      when "join" then complete_join
+      end
+    else
+      invalid_code(retry_at: new_session_magic_link_path)
+    end
+  end
+
+  private
+    def set_magic_link
+      @link = MagicLink.pending.find_by(id: cookies.signed[:pending_authentication_token])
+      invalid_code unless @link
+    end
+
+    def complete_sign_in
+      if identity = Identity.find_by(email_address: @link.email_address)
+        sign_in identity, after_authentication_url
+      else
+        invalid_code
+      end
+    end
+
+    def continue_signup
+      if Account.accepting_signups?
+        sign_in Signup.new(email_address: @link.email_address).create_identity, new_signup_completion_url
+      else
+        head :forbidden
+      end
+    end
+
+    def complete_join
+      if user = @link.invitation&.redeem_for(@link.email_address, expected_code: @link.invitation_code)
+        sign_in user.identity, after_join_url(user)
+      else
+        render plain: "This join link is no longer valid. Ask for a new invitation.", status: :gone
+      end
+    end
+
+    def sign_in(identity, destination)
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to destination }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_code(retry_at: new_session_path)
+      message = "That code didn’t work. Check the code or request a new one."
+      respond_to do |format|
+        format.html { redirect_to retry_at, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      render plain: "Too many attempts. Try again later.", status: :too_many_requests
+    end
+end
