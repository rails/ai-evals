diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..c27427c
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,38 @@
+class MagicLink < ApplicationRecord
+  LIFETIME = 15.minutes
+
+  belongs_to :invitation, class_name: "Account::JoinCode", optional: true
+  enum :purpose, %w[ sign_in sign_up join ].index_by(&:itself), scopes: false
+
+  normalizes :email_address, with: ->(value) { Identity.normalize_value_for(:email_address, value) }
+  validates :email_address, length: { maximum: 255 }, format: { with: URI::MailTo::EMAIL_REGEXP }
+
+  validates :invitation, presence: true, if: :join?
+  before_create -> { self.invitation_code = invitation.code }, if: :join?
+
+  scope :pending, -> { where("created_at > ?", LIFETIME.ago) }
+
+  def self.cleanup
+    where(created_at: ..LIFETIME.ago).in_batches.delete_all
+  end
+
+  def deliver_later
+    if !sign_in? || Identity.exists?(email_address: email_address)
+      MagicLinkMailer.sign_in_code(self).deliver_later
+    end
+  end
+
+  # Derive the code from this challenge so neither the database nor the mail job
+  # arguments need to contain the secret that the person will type.
+  def code
+    key = Rails.application.key_generator.generate_key("email sign-in codes")
+    number = OpenSSL::HMAC.digest("SHA256", key, id).unpack1("Q>")
+    number.to_s(36).last(6).rjust(6, "0").upcase
+  end
+
+  def consume(submitted_code)
+    if ActiveSupport::SecurityUtils.secure_compare(code, submitted_code.to_s.strip.upcase)
+      self.class.pending.delete_by(id: id) == 1
+    end
+  end
+end
