new file mode 100644
index 0000000..c44b9c7
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,24 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "consuming a challenge is single-use including across separately loaded records" do
+    link = MagicLink.create!(email_address: identities(:kevin).email_address, purpose: :sign_in)
+    other_copy = MagicLink.find(link.id)
+
+    assert_not link.consume(nil)
+    assert link.consume(link.code)
+    assert_not other_copy.consume(link.code)
+  end
+
+  test "expiration is enforced independently of the pending cookie or cleanup" do
+    freeze_time
+    expired = MagicLink.create!(email_address: identities(:kevin).email_address, purpose: :sign_in)
+    travel 15.minutes
+    pending = MagicLink.create!(email_address: identities(:david).email_address, purpose: :sign_in)
+    assert_not expired.consume(expired.code)
+
+    MagicLink.cleanup
+    assert_not MagicLink.exists?(expired.id)
+    assert MagicLink.exists?(pending.id)
+  end
+end
