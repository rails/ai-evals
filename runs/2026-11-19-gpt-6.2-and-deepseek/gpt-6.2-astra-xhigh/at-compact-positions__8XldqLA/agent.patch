diff --git a/test/models/book/maintenance_test.rb b/test/models/book/maintenance_test.rb
new file mode 100644
index 0000000..e250347
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compaction assigns consecutive scores in positioned order" do
+    book = books(:handbook)
+    leaves(:reading_picture).update!(position_score: -5)
+    leaves(:welcome_page).update!(position_score: 10)
+    leaves(:summary_page).update!(position_score: 10)
+    ordered_ids = book.leaves.active.positioned.ids
+
+    book.compact_positions!
+
+    assert_equal ordered_ids.zip(1..4), book.leaves.active.positioned.pluck(:id, :position_score)
+  end
+
+  test "compaction skips trash and leaves in other books" do
+    book = books(:handbook)
+    trashed = leaves(:welcome_page)
+    trashed.update!(status: :trashed, position_score: 1.5)
+    other = leaves(:reading_picture)
+    other.update!(book: books(:manual), position_score: 42)
+
+    book.compact_positions!
+
+    assert_equal [ 1, 2 ], book.leaves.active.positioned.pluck(:position_score)
+    assert_equal 42, other.reload.position_score
+    assert_equal 1.5, trashed.reload.position_score
+    trashed.active!
+    assert_equal [ leaves(:welcome_section), trashed, leaves(:summary_page) ], book.leaves.active.positioned
+  end
+
+  test "live leaf count only counts active leaves of this book" do
+    leaves(:welcome_page).trashed!
+    leaves(:summary_page).update!(book: books(:manual))
+
+    assert_equal 2, books(:handbook).live_leaf_count
+    assert_equal 1, books(:manual).live_leaf_count
+  end
+
+  test "SQLite rejects unknown double-quoted column names" do
+    assert_raises(ActiveRecord::StatementInvalid) do
+      Leaf.connection.select_value('SELECT "unknown_position_column" FROM leaves LIMIT 1')
+    end
+  end
+end
