new file mode 100644
index 0000000..e94ca16
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,39 @@
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - &host fizzy.example.com # Point this hostname at your server.
+
+proxy:
+  host: *host
+  ssl: true
+
+# Kamal transfers the image via SSH; no external image registry is needed.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Use arm64 for an ARM server.
+
+env:
+  clear:
+    APP_FQDN: *host
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    WEB_CONCURRENCY: "1"
+    JOB_CONCURRENCY: "1"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+# All four SQLite databases and Active Storage uploads live here.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
