@@ -0,0 +1,11 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest uses the short last edited date" do
+    books(:handbook).update!(published: true, updated_at: Time.utc(2025, 4, 15, 12, 34, 56))
+
+    digest = ReportDigestMailer.weekly(users(:david))
+
+    assert_includes digest.body.decoded, "* Handbook, last edited 15 Apr\n"
+  end
+end
