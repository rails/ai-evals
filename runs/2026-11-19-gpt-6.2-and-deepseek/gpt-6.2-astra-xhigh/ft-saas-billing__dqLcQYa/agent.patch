+require "test_helper"
+
+class Card::BillingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+  end
+
+  test "the free plan counts down from 100 remaining published cards" do
+    limits = @account.create_overridden_limits!(card_count: 899)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_no_match(/cards left/, response.body)
+
+    [ [ 900, "100 cards left" ], [ 950, "50 cards left" ], [ 999, "1 card left" ] ].each do |count, notice|
+      limits.update!(card_count: count)
+      get card_draft_path(@draft, script_name: @account.slug)
+      assert_includes response.body, notice
+      assert_select ".card-perma__notch-new-card-buttons"
+    end
+  end
+
+  test "the last available slot counts published cards, not draft numbers" do
+    Subscription::FreeV1.stubs(:card_limit).returns(@account.cards.published.count + 1)
+    @account.update!(cards_count: 50)
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+    assert_equal 0, @account.reload.cards_remaining
+
+    assert_difference -> { @account.cards.drafted.count } do
+      post board_cards_path(@board, script_name: @account.slug)
+    end
+    assert_response :redirect
+    assert_equal 0, @account.reload.cards_remaining
+  end
+
+  test "complimentary accounts can publish and create through the API past the free limit" do
+    @account.create_overridden_limits!(card_count: 1_005, bytes_used: 3.gigabytes)
+    @account.comped = true
+    @account.update!(cards_count: 100)
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+
+    post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Included" } }, as: :json
+    assert_response :created
+  end
+
+  test "exhaustion blocks publishing and the API, but not drafting" do
+    @account.create_overridden_limits!(card_count: 1_000)
+
+    post board_cards_path(@board, script_name: @account.slug)
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select "a", text: "Upgrade"
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Too many" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..910a233
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+require_relative "../../helpers/stripe_test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    @customer = @account.create_billing_customer!(stripe_customer_id: "cus_initech")
+    @account.create_overridden_limits!(card_count: 1_000, bytes_used: 2.gigabytes)
+  end
+
+  test "signed subscription changes grant, change and revoke entitlements even on replay" do
+    assert_difference -> { Account::Subscription.count }, 1 do
+      deliver "created", created: 1, price: "price_standard"
+      deliver "created", created: 1, price: "price_standard"
+    end
+    assert_nil @account.reload.cards_remaining
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_storage_limit?
+
+    deliver "updated", created: 2, price: "price_plus"
+    deliver "created", created: 1, price: "price_standard"
+    assert_equal "Unlimited+", @account.reload.billing_plan.proper_name
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_equal 1.gigabyte, accounts(:"37s").storage_limit
+
+    deliver "deleted", created: 3
+    deliver "updated", created: 2, price: "price_plus"
+    assert_equal 0, @account.reload.cards_remaining
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "unknown price, inactive subscription and unknown customer cannot grant paid access" do
+    deliver "updated", price: "price_other"
+    assert_equal "Free", @account.reload.billing_plan.proper_name
+    deliver "updated", status: "incomplete"
+    assert_equal "Free", @account.reload.billing_plan.proper_name
+    assert_no_difference -> { Account::Subscription.count } do
+      deliver "created", customer: "cus_unknown"
+    end
+  end
+
+  test "an invalid signature cannot update any subscription" do
+    assert_no_difference -> { Account::Subscription.count } do
+      deliver "created", secret: "wrong", expected: :bad_request
+    end
+    assert_equal 0, @account.reload.cards_remaining
+  end
+
+  private
+    def deliver(type, price: "price_standard", status: "active", customer: "cus_initech", created: Time.now.to_i, secret: "webhook-secret", expected: :ok)
+      body = { object: "event", type: "customer.subscription.#{type}", created: created, data: { object: {
+        object: "subscription", id: "sub_test", status: status, customer: customer,
+        items: { object: "list", data: [ { price: { object: "price", id: price } } ] }
+      } } }.to_json
+      now = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(now, body, secret)
+      untenanted do
+        post "/stripe/webhooks", params: body, headers: {
+          "Content-Type" => "application/json", "Stripe-Signature" => Stripe::Webhook::Signature.generate_header(now, signature)
+        }
+      end
+      assert_response expected
+    end
+end
