diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..b7a626e
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,48 @@
+class Account::Subscription < SaasRecord
+  belongs_to :billing_customer
+
+  ENDED_STATUSES = %w[ canceled incomplete_expired ].freeze
+
+  scope :ongoing, -> { where.not(status: ENDED_STATUSES) }
+  scope :entitled, -> { where(status: %w[ active trialing ]) }
+
+  def self.sync(event)
+    return unless event.type.in?(%w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ])
+
+    remote = event.data.object
+    if customer = Account::BillingCustomer.find_by(stripe_customer_id: remote.customer)
+      customer.with_lock do
+        subscription = customer.subscriptions.find_or_initialize_by(stripe_subscription_id: remote.id)
+        subscription.apply(event)
+        subscription.cancel_later if subscription.ongoing? && customer.account.cancelled?
+      end
+    end
+  end
+
+  def apply(event)
+    return if status == "canceled" || (persisted? && event.type == "customer.subscription.created")
+
+    remote = event.data.object
+    if event.type == "customer.subscription.deleted"
+      update!(status: "canceled", plan_key: nil, stripe_event_created_at: event.created)
+    elsif stripe_event_created_at.nil? || event.created >= stripe_event_created_at
+      price_ids = remote.items.data.map { |item| item.price.id }
+      plan = ::Subscription::PAID_PLANS.reverse_each.find { |plan| price_ids.include?(ENV.fetch(plan.price_id_env)) }
+      update!(status: remote.status, plan_key: plan&.short_name, stripe_event_created_at: event.created)
+    end
+  end
+
+  def ongoing?
+    !status.in?(ENDED_STATUSES)
+  end
+
+  def cancel_later
+    CancellationJob.perform_later(self)
+  end
+
+  def cancel_at_stripe
+    Stripe::Subscription.cancel(stripe_subscription_id, {}, { api_key: ENV.fetch("STRIPE_SECRET_KEY") }) if ongoing?
+  rescue Stripe::InvalidRequestError => error
+    raise unless error.code == "resource_missing"
+  end
+end
