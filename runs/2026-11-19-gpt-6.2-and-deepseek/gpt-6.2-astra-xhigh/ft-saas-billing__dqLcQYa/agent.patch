@@ -0,0 +1,22 @@
+<% @page_title = "Account billing" %>
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings panel shadow center">
+  <h2>Your plan: <%= Current.account.billing_plan.proper_name %></h2>
+  <% [ Subscription::FreeV1, *Subscription::PAID_PLANS ].each do |plan| %>
+    <section class="settings__section">
+      <h3><%= plan.proper_name %><%= " · $#{plan.price}/month" if plan.price.positive? %></h3>
+      <p><%= plan.card_limit ? number_with_delimiter(plan.card_limit) : "Unlimited" %> cards, <%= number_to_human_size(plan.storage_limit) %> storage</p>
+      <% if Current.account.can_check_out?(plan) %>
+        <%= button_to "Upgrade to #{plan.proper_name}", saas.account_checkout_path(script_name: Current.account.slug), params: { plan: plan.short_name }, class: "btn", form: { data: { turbo: false } } %>
+      <% end %>
+    </section>
+  <% end %>
+  <% if Current.account.billing_customer %>
+    <p>Use the customer portal to view invoices, change plans, or cancel your subscription.</p>
+    <%= button_to "Manage billing with Stripe", saas.account_billing_portal_path(script_name: Current.account.slug), class: "btn", form: { data: { turbo: false } } %>
+  <% end %>
+  <%= link_to "Back to settings", main_app.account_settings_path(script_name: Current.account.slug) %>
+</section>
