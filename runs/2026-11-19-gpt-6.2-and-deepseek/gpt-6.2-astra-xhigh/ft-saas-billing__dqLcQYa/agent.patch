--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,60 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :billing_customer, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limits, dependent: :destroy
+
+    set_callback :cancel, :after do
+      billing_customer.subscriptions.ongoing.find_each(&:cancel_later) if billing_customer
+    end
+  end
+
+  def billing_plan
+    paid_plan || (comped? ? ::Subscription::MonthlyV1 : ::Subscription::FreeV1)
+  end
+
+  def upgrade_available?
+    billing_plan != ::Subscription::MonthlyExtraStorageV1
+  end
+
+  def can_check_out?(plan)
+    plan.price > billing_plan.price && !billing_customer&.subscribed?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      Account::BillingWaiver.find_or_create_by!(account: self)
+    else
+      billing_waiver&.destroy!
+    end
+    reset_billing_waiver
+  end
+
+  def card_count
+    overridden_limits&.card_count || cards.published.count
+  end
+
+  def bytes_used
+    overridden_limits&.bytes_used || super
+  end
+
+  def cards_remaining
+    if limit = billing_plan.card_limit
+      [ limit - card_count, 0 ].max
+    end
+  end
+
+  private
+    def paid_plan
+      if billing_customer
+        keys = billing_customer.subscriptions.entitled.pluck(:plan_key)
+        ::Subscription::PAID_PLANS.reverse_each.find { |plan| keys.include?(plan.short_name) }
+      end
+    end
+end
diff --git a/saas/app/models/account/billing_customer.rb b/saas/app/models/account/billing_customer.rb
