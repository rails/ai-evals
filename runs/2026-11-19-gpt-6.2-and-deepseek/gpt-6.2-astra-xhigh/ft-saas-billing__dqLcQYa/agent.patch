+module StripeTestHelper
+  extend ActiveSupport::Concern
+
+  SETTINGS = {
+    "STRIPE_SECRET_KEY" => "test-key",
+    "STRIPE_WEBHOOK_SECRET" => "webhook-secret",
+    "STRIPE_MONTHLY_V1_PRICE_ID" => "price_standard",
+    "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus"
+  }.freeze
+
+  included do
+    setup do
+      @previous_stripe_settings = SETTINGS.keys.index_with { |key| ENV[key] }
+      ENV.update(SETTINGS)
+      WebMock.disable_net_connect!
+    end
+
+    teardown do
+      ENV.update(@previous_stripe_settings)
+      WebMock.allow_net_connect!
+    end
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..6c6fdb7
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+require_relative "../../helpers/stripe_test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  include StripeTestHelper
+
+  test "waiving and unwaiving a paid account preserves its subscription" do
+    account = accounts(:acme)
+    assert_equal "Unlimited+", account.billing_plan.proper_name
+    account.comped = true
+    assert_equal "Unlimited+", account.reload.billing_plan.proper_name
+    account.comped = false
+    assert_equal 500.gigabytes, account.reload.storage_limit
+    assert_nil account.cards_remaining
+  end
+
+  test "an existing storage exception cannot take away storage included with a paid plan" do
+    account = accounts(:acme)
+    account.add_storage_exception(3.gigabytes)
+    assert_equal 500.gigabytes, account.storage_limit
+    account.add_storage_exception(600.gigabytes)
+    assert_equal 600.gigabytes, account.storage_limit
+  end
+
+  test "overrides are independent, including zero usage" do
+    account = accounts(:initech)
+    limits = account.create_overridden_limits!(bytes_used: 5.gigabytes)
+    assert_equal account.cards.published.count, account.card_count
+    assert account.exceeding_storage_limit?
+    limits.update!(bytes_used: nil, card_count: 0)
+    assert_not account.exceeding_storage_limit?
+    assert_equal 1_000, account.cards_remaining
+  end
+
+  test "closing an account cancels billing through Stripe" do
+    Stripe::Subscription.expects(:cancel).with("sub_acme", {}, { api_key: "test-key" })
+    perform_enqueued_jobs(only: Account::Subscription::CancellationJob) do
+      accounts(:acme).cancel(initiated_by: users(:jason))
+    end
+  end
+end
