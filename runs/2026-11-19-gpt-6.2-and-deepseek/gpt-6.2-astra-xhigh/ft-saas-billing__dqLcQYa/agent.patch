+++ b/saas/app/models/account/billing_customer.rb
@@ -0,0 +1,29 @@
+class Account::BillingCustomer < SaasRecord
+  belongs_to :account
+  has_many :subscriptions, dependent: :destroy
+
+  def self.for_checkout(account)
+    find_or_create_by!(account: account) do |customer|
+      remote = Stripe::Customer.create({ metadata: { fizzy_account_id: account.id } },
+        { api_key: ENV.fetch("STRIPE_SECRET_KEY"), idempotency_key: "fizzy-customer-#{account.id}" })
+      customer.stripe_customer_id = remote.id
+    end
+  end
+
+  def checkout_url(plan:, return_url:)
+    Stripe::Checkout::Session.create({
+      mode: "subscription", customer: stripe_customer_id,
+      line_items: [ { price: ENV.fetch(plan.price_id_env), quantity: 1 } ],
+      success_url: return_url, cancel_url: return_url
+    }, { api_key: ENV.fetch("STRIPE_SECRET_KEY") }).url
+  end
+
+  def portal_url(return_url:)
+    Stripe::BillingPortal::Session.create({ customer: stripe_customer_id, return_url: return_url },
+      { api_key: ENV.fetch("STRIPE_SECRET_KEY") }).url
+  end
+
+  def subscribed?
+    subscriptions.ongoing.exists?
+  end
+end
