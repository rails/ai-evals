@@ -0,0 +1,32 @@
+<% @page_title = @account.name %>
+<section class="settings panel shadow">
+  <%= link_to "Accounts", saas.admin_accounts_path %>
+  <h1><%= @account.name %> (#<%= @account.external_account_id %>)</h1>
+  <section class="settings__section">
+    <h2>Plan: <%= @account.billing_plan.proper_name %></h2>
+    <p>Comp grants complimentary Unlimited access. It does not cancel an existing Stripe subscription.</p>
+    <% if @account.comped? %>
+      <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+    <% else %>
+      <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), class: "btn" %>
+    <% end %>
+  </section>
+
+  <section class="settings__section">
+    <h2>Usage override</h2>
+    <p>Leave a field blank to use measured usage. Reset removes both overrides.</p>
+    <% if @limits.errors.any? %>
+      <p role="alert"><%= @limits.errors.full_messages.to_sentence %></p>
+    <% end %>
+    <%= form_with model: @limits, scope: :overridden_limits, url: saas.admin_account_overridden_limits_path(@account), method: :patch do |form| %>
+      <%= form.label :card_count, "Card count" %>
+      <%= form.number_field :card_count, min: 0, placeholder: @account.card_count %>
+      <%= form.label :bytes_used, "Bytes used" %>
+      <%= form.number_field :bytes_used, min: 0, placeholder: @account.bytes_used %>
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+    <% if @limits.persisted? %>
+      <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn" %>
+    <% end %>
+  </section>
+</section>
