diff --git a/app/models/concerns/has_profile_picture.rb b/app/models/concerns/has_profile_picture.rb
new file mode 100644
index 0000000..9793565
--- /dev/null
+++ b/app/models/concerns/has_profile_picture.rb
@@ -0,0 +1,95 @@
+# The profile_image column is a CarrierWave identifier, never an Active Storage key.
+# Leave it and the file it references alone: cached pages may still use that URL.
+module HasProfilePicture
+  extend ActiveSupport::Concern
+  include Images::Profile.for(:profile_image_url)
+
+  included do
+    has_one_attached :profile_picture
+    validate { errors.add(:profile_image, @profile_image_error) if @profile_image_error }
+    after_destroy_commit { legacy_profile_uploader&.remove! }
+  end
+
+  # Preserve the uploader's public read interface used by forms, views and JSON clients.
+  Image = Data.define(:owner) do
+    def url
+      owner.profile_image_url
+    end
+
+    def blank?
+      !owner.profile_image?
+    end
+
+    delegate :to_s, to: :url
+
+    def as_json(*)
+      { "url" => url }
+    end
+  end
+
+  def profile_image
+    Image.new(self)
+  end
+
+  def profile_image?
+    profile_picture.attached? || legacy_profile_image.present?
+  end
+
+  def profile_image_url
+    # A pending replacement has no deliverable URL until the owner is saved.
+    blob = profile_picture_attachment&.blob
+    if blob&.persisted?
+      path = Rails.application.routes.url_helpers.rails_service_blob_proxy_path(blob.signed_id, blob.filename)
+      return URL.url(path)
+    end
+
+    identifier = legacy_profile_image
+    return if identifier.blank?
+    return identifier if identifier.start_with?("https://", "http://")
+
+    legacy_profile_uploader.url
+  end
+
+  def profile_image=(file)
+    assign_profile_picture(file) if file.present?
+  end
+
+  attr_reader :remote_profile_image_url
+
+  def remote_profile_image_url=(source)
+    @remote_profile_image_url = source
+    assign_profile_picture(source, remote: source.is_a?(String)) if source.present?
+  end
+
+  def reload(...)
+    @profile_image_error = @remote_profile_image_url = nil
+    super
+  end
+
+  private
+
+  def legacy_profile_image
+    self[:profile_image] if has_attribute?(:profile_image)
+  end
+
+  def legacy_profile_uploader
+    identifier = legacy_profile_image
+    return if identifier.blank? || identifier.start_with?("https://", "http://")
+
+    ProfileImageUploader.new(self, :profile_image).tap { |uploader| uploader.retrieve_from_store!(identifier) }
+  end
+
+  def assign_profile_picture(source, remote: false)
+    @profile_image_error = nil
+    upload = Images::ProfilePictureUpload.prepare(self, source, remote: remote)
+    self.profile_picture = upload if upload
+  rescue CarrierWave::UploadError => e
+    @profile_image_error = e.message
+  end
+
+  # Active Storage clears attachment_changes on commit. Inspect it during save,
+  # then defer cache jobs until the transaction (including the upload) commits.
+  def profile_image_changed_on_save?
+    attachment_changes.key?("profile_picture") || saved_change_to_profile_image?
+  end
+end
