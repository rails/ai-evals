diff --git a/app/services/images/profile_picture_upload.rb b/app/services/images/profile_picture_upload.rb
new file mode 100644
index 0000000..7956f77
--- /dev/null
+++ b/app/services/images/profile_picture_upload.rb
@@ -0,0 +1,26 @@
+module Images
+  # Reuse the profile uploader's file checks, metadata stripping and SSRF-protected
+  # downloader. Only stage the processed bytes locally; Active Storage owns persistence.
+  class ProfilePictureUpload < ProfileImageUploader
+    cache_storage :file
+
+    def self.prepare(owner, source, remote:)
+      Dir.mktmpdir do |dir|
+        uploader = new(owner, :profile_image)
+        uploader.cache_dir = dir
+        if remote
+          uploader.download!(source)
+          # An identity provider can return an empty body when the user has no photo.
+          next unless uploader.file
+        else
+          raise CarrierWave::FormNotMultipart if source.is_a?(String)
+
+          uploader.cache!(source)
+        end
+        raise CarrierWave::IntegrityError, I18n.t("errors.messages.carrierwave_integrity_error") unless uploader.file
+
+        { io: StringIO.new(uploader.file.read), filename: uploader.filename, content_type: uploader.file.content_type }
+      end
+    end
+  end
+end
