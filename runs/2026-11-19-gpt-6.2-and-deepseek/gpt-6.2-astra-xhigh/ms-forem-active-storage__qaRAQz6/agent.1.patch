index 0000000..e2c1a3c
--- /dev/null
+++ b/spec/models/concerns/has_profile_picture_spec.rb
@@ -0,0 +1,84 @@
+require "rails_helper"
+
+RSpec.describe HasProfilePicture do
+  %i[user organization].each do |factory|
+    context "with a #{factory}" do
+      let(:image) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+      let(:owner) { create(factory) }
+
+      it "stores new uploads only in Active Storage and exposes a stable image URL" do
+        image.open { |file| owner.update!(profile_image: file) }
+        owner.reload
+
+        expect(owner[:profile_image]).to be_nil
+        expect(owner.profile_picture.download).to eq(image.binread)
+        expect(owner.profile_image_url).to eq(owner.class.find(owner.id).profile_image_url)
+        expect(owner.as_json.fetch("profile_image")).to eq("url" => owner.profile_image_url)
+      end
+
+      it "accepts an image from the remote URL writer" do
+        url = "https://example.org/photo.jpeg"
+        stub_request(:get, url).to_return(body: image.binread, headers: { "Content-Type" => "image/jpeg" })
+        owner.update!(remote_profile_image_url: url)
+
+        expect(owner.reload.profile_picture.download).to eq(image.binread)
+        expect(owner[:profile_image]).to be_nil
+      end
+
+      context "with an existing CarrierWave picture" do
+        let(:legacy) { ProfileImageUploader.new(owner, :profile_image) }
+
+        before do
+          owner.profile_picture.purge
+          image.open { |file| legacy.store!(file) }
+          owner.update_column(:profile_image, legacy.identifier)
+          owner.reload
+        end
+
+        after { legacy.remove! }
+
+        it "does not migrate on read or an unrelated save" do
+          expect(owner.profile_image_url).to eq(legacy.url)
+          owner.update!(name: "New name")
+          expect(owner.reload.profile_image_url).to eq(legacy.url)
+          expect(owner.profile_picture).not_to be_attached
+        end
+
+        it "rejects an invalid replacement without losing the existing picture" do
+          expect(owner.update(profile_image: fixture_file_upload("800x600.pdf"))).to be(false)
+          expect(owner.errors[:profile_image]).to be_present
+          expect(owner.reload.profile_image_url).to eq(legacy.url)
+          expect(owner.profile_picture).not_to be_attached
+        end
+
+        it "prefers a valid replacement but keeps the old identifier and file intact" do
+          image.open { |file| owner.update!(profile_image: file) }
+          expect(owner.reload.profile_image_url).not_to eq(legacy.url)
+          expect(owner.profile_picture.download).to eq(image.binread)
+          expect(owner[:profile_image]).to eq(legacy.identifier)
+          expect(File.binread(legacy.path)).to eq(image.binread)
+        end
+      end
+    end
+  end
+
+  it "keeps organization covers on CarrierWave" do
+    org = create(:organization, cover_image: fixture_file_upload("800x600.png"))
+    expect(org.reload.cover_image.url).to include("/uploads/organization/cover_image/#{org.id}/")
+    expect(org[:cover_image]).to be_present
+  end
+
+  it "uses the existing sized fallback for a user without a picture" do
+    user = create(:user, profile_image: nil)
+    expect(user.profile_image).to be_blank
+    expect(user.profile_image_url).to be_nil
+    expect(user.profile_image_90).to eq(Images::Profile.call(nil, length: 90))
+  end
+
+  it "busts the user image cache on an attachment-only change" do
+    user = create(:user)
+    sidekiq_assert_enqueued_with(job: Users::BustProfileImageCacheWorker, args: [user.id]) do
+      user.update!(profile_image: fixture_file_upload("800x600.png"))
+    end
+  end
+end
