new file mode 100644
index 0000000..a8844b7
--- /dev/null
+++ b/app/jobs/finish_question_job.rb
@@ -0,0 +1,11 @@
+class FinishQuestionJob < ActiveJob::Base
+  retry_on ActiveRecord::StatementTimeout, ActiveRecord::ConnectionTimeoutError, wait: 1.second
+
+  def perform(game_id, number)
+    game = Game.open.find_by(id: game_id, question_number: number)
+    return unless (deadline = game&.question_deadline)
+    return retry_job(wait_until: deadline) if deadline.future?
+
+    game.finish_if_expired!
+  end
+end
