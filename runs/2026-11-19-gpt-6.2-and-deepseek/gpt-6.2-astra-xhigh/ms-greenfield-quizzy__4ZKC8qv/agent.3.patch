@@ -0,0 +1,15 @@
+class PlayerVisit < ApplicationRecord
+  belongs_to :player
+  scope :recent, -> { where(seen_at: 1.minute.ago..) }
+
+  def self.valid_token?(value)
+    value.is_a?(String) && value.match?(/\A[0-9a-f]{32}\z/)
+  end
+
+  # Each open document owns one lease. Closing one of two tabs must not
+  # remove the player from the stage counter. Abandoned leases expire.
+  def self.renew(player, token)
+    return unless player && token
+    upsert({ player_id: player.id, token: token, seen_at: Time.current }, unique_by: [:player_id, :token])
+  end
+end
