+<div class="screen cover <%= @game.waiting? ? 'cover--blue' : 'cover--night' %>" data-view-key="<%= @game.stage %>" <%= 'data-ended' if @game.ended? %>>
+  <header class="screen__top">
+    <span class="logo screen__logo"><span class="logo__mark" aria-hidden="true">?</span>Quizzy</span>
+    <span><%= @game.waiting? ? "Live quiz" : @game.title %></span>
+  </header>
+  <div class="screen__body">
+    <% if @game.waiting? %>
+      <% join_url = play_url(@game.code) %>
+      <div class="lobby">
+        <div>
+          <h1 class="lobby__title"><%= @game.title %></h1>
+          <p class="lobby__join">Scan to join, or open</p>
+          <div class="lobby__url"><%= join_url %></div>
+          <div class="counter-pill" role="status" data-counter><%= @counter %></div>
+        </div>
+        <div class="qr"><%= join_qr(join_url) %></div>
+      </div>
+    <% elsif @game.ended? %>
+      <div class="screen__kicker">Thanks for playing</div>
+      <h1>The quiz is over</h1>
+    <% else %>
+      <div class="stage-question__num">Question <%= @game.question_number %> of <%= @game.question_count %></div>
+      <h1 class="stage-question__body"><%= @question.body %></h1>
+      <ol class="stage-options <%= 'stage-options--results' if @game.closed? %>">
+        <% each_lettered_option(@question) do |letter, option, i| %>
+          <% correct = @game.closed? && option['correct'] %>
+          <li class="stage-option <%= 'is-correct' if correct %>">
+            <span class="stage-option__letter" aria-hidden="true"><%= letter %></span>
+            <span class="stage-option__title"><%= option['text'] %></span>
+            <% if @game.closed? %>
+              <% if correct %><span class="stage-option__mark">Correct</span><% end %>
+              <span class="stage-option__count"><%= pluralize(@counts.fetch(i, 0), "answer") %></span>
+            <% end %>
+          </li>
+        <% end %>
+      </ol>
+    <% end %>
+  </div>
+  <footer class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "Back to quiz", moderate_quiz_path(@game.quiz_id) %>
+      <% if @game.open? %><span class="answers-counter" role="status" data-counter><%= @counter %></span><% end %>
+    </div>
+    <% unless @game.ended? %>
+      <%= button_to stage_action(@game), advance_moderate_game_path(@game), params: { stage: @game.stage }, class: "btn btn--pink btn--lg" %>
+    <% end %>
+  </footer>
+</div>
