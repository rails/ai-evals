 ## Run
 
@@ -35,3 +35,15 @@ bin/rails test:system
 ```
 
 System tests use headless Chromium through Cuprite (`CHROMIUM_PATH` can override the default `chromium` executable). Tests use `storage/test.sqlite3` and separate test credentials.
+
+## Run a live game
+
+Choose **Start a game** on the quiz page. Project the moderator screen; participants can scan the QR code or type the URL into their own browser. Open the moderator page using a host name reachable from the audience’s phones so that the join URL works for everyone.
+
+Each launch snapshots the title and ordered active questions under a new join code. Edit the source quiz for the next talk without changing the current game. **Start**, **Finish**, **Next**, and **End quiz** move everyone through the game. Starting a game with no active questions goes straight to the end screen.
+
+Players need no account. A persistent, signed HTTP-only cookie identifies a browser, with a separate player and answers in each game. The current open question accepts one changeable choice per player. Closing it locks the results. All moderator controls and answer submissions check the expected stage or question number in a database transaction, so a delayed request cannot affect a later round.
+
+The lobby shows distinct present players, not tabs. On an open question the stage shows saved answers / present players. Leaving closes that tab’s presence lease; a one-minute timeout covers unclean disconnects. Returning restores the same player and pick. Answers still count even if their players have since left.
+
+Phones subscribe via same-origin Action Cable. Phase changes trigger a fresh, server-rendered view; voting doesn't broadcast choices or refresh the audience. Reconnecting resyncs from SQLite. Staggered presence renewals and an HTTP fallback cover lost events and networks that block sockets. Only the moderator screen polls frequently, updating the counter in place rather than downloading the presentation again. `bin/serve` uses a single Puma process and the local async cable adapter, with no external broker.
diff --git a/app/assets/javascripts/live.js b/app/assets/javascripts/live.js
new file mode 100644
index 0000000..3019038
--- /dev/null
+++ b/app/assets/javascripts/live.js
@@ -0,0 +1,131 @@
+// The server owns the game state. Socket events are invalidations, not a log
+// the client must replay. One sync after (re)subscribing catches any gap.
+(() => {
+  const root = document.querySelector('[data-live]');
+  const { code, sync, leave, visit } = root.dataset;
+  const notice = document.querySelector('[data-connection-notice]');
+  const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
+  const view = () => root.firstElementChild.dataset.viewKey;
+  const ended = () => root.firstElementChild.hasAttribute('data-ended');
+  let connected = false;
+  let away = false;
+  let consumer, timer;
+  let queue = Promise.resolve();
+  let refreshPending = false;
+  let lastPulse = 0;
+  let failures = 0;
+
+  function enqueue(work, isAction = false) {
+    // Preserve tap order and don't let an older read replace a newer view.
+    queue = queue.then(work).catch(() => {
+      notice.textContent = isAction ? 'Could not confirm your action. Check the screen and try again.' : 'Connection interrupted. Reconnecting…';
+      notice.hidden = false;
+      failures = Math.min(failures + 1, 5);
+      schedule();
+    });
+  }
+
+  async function request(url, body) {
+    const abort = new AbortController();
+    const timeout = setTimeout(() => abort.abort(), 12000);
+    try {
+      const headers = { 'X-Requested-With': 'XMLHttpRequest', Accept: 'text/html' };
+      if (body && csrf) headers['X-CSRF-Token'] = csrf;
+      // A moderator can arrive via a Basic-auth URL. Fetch uses the browser's
+      // cached HTTP credentials, not userinfo in the URL string.
+      const target = new URL(url, location.href);
+      target.username = target.password = '';
+      const response = await fetch(target, { method: body ? 'POST' : 'GET', body,
+        headers, cache: 'no-store', signal: abort.signal });
+      if (!response.ok && response.status !== 422) throw Error('Request failed');
+      if (response.status !== 204) {
+        if (response.headers.get('Content-Type')?.includes('application/json')) {
+          const { counter } = await response.json();
+          const element = root.querySelector('[data-counter]');
+          if (element && element.textContent !== counter) element.textContent = counter;
+        } else {
+          const template = document.createElement('template');
+          template.innerHTML = (await response.text()).trim();
+          if (!template.content.firstElementChild?.hasAttribute('data-view-key')) throw Error('Invalid screen');
+          root.replaceChildren(template.content);
+        }
+      }
+      notice.hidden = true;
+      if (failures) { failures = 0; schedule(); }
+      if (ended()) {
+        clearTimeout(timer);
+        consumer?.disconnect();
+      }
+    } finally {
+      clearTimeout(timeout);
+    }
+  }
+
+  function refresh() {
+    if (away || ended() || refreshPending) return;
+    refreshPending = true;
+    enqueue(async () => {
+      refreshPending = false;
+      if (away || ended()) return;
+      if (code) {
+        const data = new URLSearchParams({ view: view() });
+        // A phase change causes many simultaneous reads. Renew leases on a
+        // slower, staggered cadence instead of writing on every notification.
+        const pulse = Date.now() - lastPulse > 12000;
+        if (pulse) data.set('visit', visit);
+        await request(sync, data);
+        if (pulse) lastPulse = Date.now();
+      } else await request(`${sync}?view=${encodeURIComponent(view())}`);
+    });
+  }
+
+  function schedule() {
+    clearTimeout(timer);
+    if (away || ended()) return;
+    // One stage polls its tiny counter; phones normally only renew presence.
+    // Fall back to HTTP if the venue's network doesn't carry WebSockets.
+    const retry = Math.min(12000, 500 * 2 ** failures) * (0.8 + Math.random() * 0.4);
+    const delay = failures ? retry : !code ? 800 : connected ? 15000 + Math.random() * 5000 : 1200 + Math.random() * 400;
+    timer = setTimeout(() => { refresh(); schedule(); }, delay);
+  }
+
+  root.addEventListener('submit', event => {
+    event.preventDefault();
+    const form = event.target;
+    const data = new FormData(form, event.submitter);
+    if (visit) data.set('visit', visit);
+    enqueue(() => request(form.action, data), true);
+  });
+
+  if (code && !ended() && window.ActionCable) {
+    consumer = ActionCable.createConsumer();
+    consumer.subscriptions.create({ channel: 'GameChannel', code, visit }, {
+      connected() { connected = true; lastPulse = 0; refresh(); schedule(); },
+      disconnected() { connected = false; lastPulse = 0; schedule(); },
+      received(message) { if (message.except !== visit) refresh(); }
+    });
+  }
+  refresh();
+  schedule();
+  window.addEventListener('online', refresh);
+  document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
+  window.addEventListener('pagehide', () => {
+    away = true;
+    clearTimeout(timer);
+    consumer?.disconnect();
+    if (leave && !ended() && view() !== 'join') {
+      const data = new URLSearchParams({ visit });
+      if (csrf) data.set('authenticity_token', csrf);
+      navigator.sendBeacon(leave, data);
+    }
+  });
+  window.addEventListener('pageshow', event => {
+    if (event.persisted && !ended()) {
+      away = false;
+      lastPulse = 0;
+      consumer?.connect();
+      refresh();
+      schedule();
+    }
+  });
+})();
