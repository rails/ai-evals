+<div class="play-question__num">Question <%= @game.question_number %> of <%= @game.question_count %></div>
+<h1 class="play-question__body"><%= @question.body %></h1>
+<%= form_with url: answer_play_path(@game.code), class: "play-options #{'is-locked is-revealed' if @game.closed?}" do |form| %>
+  <%= form.hidden_field :number, value: @game.question_number %>
+  <% each_lettered_option(@question) do |letter, option, i| %>
+    <% picked = i == @pick %>
+    <% correct = @game.closed? && option['correct'] %>
+    <%= button_tag name: :option, value: i, disabled: @game.closed?, aria: { label: option['text'], pressed: picked }, class: class_names("play-option", "is-picked": picked, "is-correct": correct) do %>
+      <span class="play-option__letter" aria-hidden="true"><%= letter %></span>
+      <span class="play-option__title"><%= option['text'] %></span>
+      <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+    <% end %>
+  <% end %>
+<% end %>
+<% if @game.closed? %>
+  <% if @pick.nil? %>
+    <p class="play-status play-status--neutral" role="status">No answer</p>
+  <% elsif @question.options.fetch(@pick)['correct'] %>
+    <p class="play-status play-status--right" role="status">Correct!</p>
+  <% else %>
+    <p class="play-status play-status--wrong" role="status">Wrong!</p>
+  <% end %>
+<% end %>
