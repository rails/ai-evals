diff --git a/app/channels/game_channel.rb b/app/channels/game_channel.rb
new file mode 100644
index 0000000..dd98646
--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,24 @@
+# Notifications are hints to read the current state, never game data. Votes
+# only wake other tabs belonging to the same browser, not the whole audience.
+class GameChannel < ActionCable::Channel::Base
+  def self.browser_stream(code, key)
+    [code, Digest::SHA256.hexdigest(key)]
+  end
+
+  def subscribed
+    code = params[:code]
+    @game = Game.find_by(code: code) if code.is_a?(String)
+    return reject unless @game
+    stream_for code
+    stream_for self.class.browser_stream(code, connection.browser_key) if connection.browser_key
+  end
+
+  def unsubscribed
+    # Browser processes can disappear without sending the pagehide beacon.
+    # A device switching to HTTP fallback renews its own lease on disconnect.
+    if @game && connection.browser_key && PlayerVisit.valid_token?(params[:visit])
+      player = @game.players.where(browser_key: connection.browser_key)
+      PlayerVisit.where(player_id: player.select(:id), token: params[:visit]).delete_all
+    end
+  end
+end
diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..54dac8f
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,59 @@
+module Moderate
+  class GamesController < BaseController
+    layout "live"
+    before_action :set_game, except: :create
+
+    def create
+      game = Game.launch!(Quiz.find(params[:quiz_id]))
+      redirect_to moderate_game_path(game), status: :see_other
+    end
+
+    def show
+      load_screen
+    end
+
+    # Only the stage polls the counters. When the phase is unchanged, do not
+    # retransmit the QR code, option text, answer key or form controls.
+    def state
+      if params[:view] == @game.stage
+        render json: { counter: counter }
+      else
+        load_screen
+        render partial: "screen"
+      end
+    end
+
+    def advance
+      if @game.advance!(from: params[:stage])
+        GameChannel.broadcast_to(@game.code, { changed: true })
+      end
+      if request.xhr?
+        load_screen
+        render partial: "screen"
+      else
+        redirect_to moderate_game_path(@game), status: :see_other
+      end
+    end
+
+    private
+      def set_game
+        @game = Game.find(params[:id])
+      end
+
+      def load_screen
+        @question = @game.current_question
+        @counts = @question.answers.group(:option_index).count if @game.closed?
+        @counter = counter
+      end
+
+      def counter
+        if @game.waiting?
+          "Players: #{@game.present_players.count}"
+        elsif @game.open?
+          # Count saved picks even if their authors have since disconnected.
+          question = @game.game_questions.where(number: @game.question_number).select(:id)
+          "Answers: #{Answer.where(game_question_id: question).count} / #{@game.present_players.count}"
+        end
+      end
+  end
+end
diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..2762158
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,87 @@
+class PlayController < ApplicationController
+  layout "live"
+  before_action :no_store, :find_participant
+
+  def show
+    @visit = SecureRandom.hex(16)
+    load_screen
+  end
+
+  def join
+    @player = @game.admit!(@browser_key, params[:name].is_a?(String) ? params[:name].strip : nil)
+    notify_other_tabs if @player
+    respond_after_action
+  rescue ActiveRecord::RecordInvalid => error
+    @error = error.record.errors.full_messages.to_sentence
+    load_screen
+    if request.xhr?
+      render partial: "screen", status: :unprocessable_content
+    else
+      render :show, status: :unprocessable_content
+    end
+  end
+
+  def answer
+    if @game.pick!(@player, number: params[:number], option: params[:option])
+      notify_other_tabs
+    end
+    respond_after_action
+  end
+
+  def sync
+    renew_presence
+    load_screen
+    if @view_key == params[:view]
+      head :no_content
+    else
+      render partial: "screen"
+    end
+  end
+
+  def leave
+    @player&.player_visits&.where(token: @visit)&.delete_all
+    head :no_content
+  end
+
+  private
+    def find_participant
+      @game = Game.find_by!(code: params[:code])
+      @browser_key = cookies.signed[:quizzy_browser]
+      unless @browser_key
+        @browser_key = SecureRandom.hex(24)
+        cookies.permanent.signed[:quizzy_browser] = { value: @browser_key, httponly: true, same_site: :lax }
+      end
+      @player = @game.players.find_by(browser_key: @browser_key)
+      @visit = params[:visit] if PlayerVisit.valid_token?(params[:visit])
+    end
+
+    def notify_other_tabs
+      GameChannel.broadcast_to(GameChannel.browser_stream(@game.code, @browser_key), { except: @visit })
+    end
+
+    def renew_presence
+      PlayerVisit.renew(@player, @visit) unless @game.ended?
+    end
+
+    def respond_after_action
+      renew_presence
+      if request.xhr?
+        load_screen
+        render partial: "screen"
+      else
+        redirect_to play_path(@game.code), status: :see_other
+      end
+    end
+
+    def load_screen
+      @view_key = if @game.ended?
+        "ended"
+      elsif !@player
+        "join"
+      else
+        @question = @game.current_question
+        @pick = @question&.answers&.find_by(player_id: @player.id)&.option_index
+        [@game.stage, @player.id, @pick].join(":")
+      end
+    end
+end
