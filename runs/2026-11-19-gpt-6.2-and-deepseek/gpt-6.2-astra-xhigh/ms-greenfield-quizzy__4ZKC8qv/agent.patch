+require "application_system_test_case"
+
+class LiveGameTest < ApplicationSystemTestCase
+  test "the stage and a phone follow a complete game without navigating" do
+    quiz = Quiz.create!(title: "Conference check-in")
+    [ [ "First poll?", true ], [ "Rehearsal only", false ], [ "Final poll?", true ] ].each do |body, active|
+      quiz.questions.create!(body: body, active: active, option_rows: [ { text: "Aster" }, { text: "Birch", correct: true } ])
+    end
+    visit moderate_quiz_path(quiz)
+    click_link "Settings"
+    assert_field "Number of winners", with: "3"
+    fill_in "Number of winners", with: "2"
+    click_button "Save quiz"
+    click_button "Start a game"
+    assert_text "Players: 0"
+    assert_selector ".qr img[alt^='QR code']"
+    assert page.evaluate_script("document.querySelector('.qr img').naturalWidth > 0")
+    link = find(".lobby__url").text
+    page.execute_script("window.stageLoaded = true")
+    stage_url = URI(current_url)
+    stage_url.user = ENV.fetch("QUIZZY_MODERATOR_USERNAME")
+    stage_url.password = ENV.fetch("QUIZZY_MODERATOR_PASSWORD")
+    projector = open_new_window
+    within_window(projector) do
+      visit stage_url.to_s
+      assert_text "Players: 0"
+    end
+    Capybara.using_session(:phone) do
+      visit link
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+      visit link
+      assert_text "Hi, Alice!"
+      page.execute_script("window.phoneLoaded = true")
+    end
+    assert_text "Players: 1"
+    click_button "Start", exact: true
+    assert_text "Question 1 of 2"
+    assert_text "Answers: 0 / 1"
+    Capybara.using_session(:late_phone) do
+      visit link
+      fill_in "Your name", with: "Bob"
+      click_button "Join"
+      assert_text "First poll?"
+    end
+    assert_text "Answers: 0 / 2"
+    Capybara.using_session(:phone) do
+      assert_text "First poll?"
+      click_button "Aster"
+      assert_selector "button", text: /Aster.*Your answer/m
+      click_button "Birch"
+      assert_selector "button", text: /Birch.*Your answer/m
+    end
+    assert_text "Answers: 1 / 2"
+    Capybara.using_session(:late_phone) { visit "about:blank" }
+    assert_text "Answers: 1 / 1"
+    Capybara.using_session(:late_phone) do
+      visit link
+      click_button "Aster"
+      assert_text "Your answer"
+      visit link
+      assert_selector "button", text: /Aster.*Your answer/m
+    end
+    assert_text "Answers: 2 / 2"
+    click_button "Finish"
+    assert_selector "li", text: /Birch.*Correct.*1/m
+    assert_selector "li", text: /Aster.*1/m
+    Capybara.using_session(:phone) do
+      assert_text "Correct!"
+      assert_no_text(/\b\d+ points?\b/)
+      # No HTTP refresh can deliver the next question to this phone. It
+      # must arrive in the WebSocket message itself.
+      page.execute_script(<<~JS)
+        window.normalFetch = window.fetch;
+        window.fetch = (url, options) => new URL(url).pathname.endsWith('/sync')
+          ? Promise.resolve(new Response(null, {status: 204})) : window.normalFetch(url, options);
+      JS
+    end
+    Capybara.using_session(:late_phone) { assert_text "Wrong!" }
+    click_button "Next"
+    Capybara.using_session(:phone) do
+      assert_text "Final poll?"
+      page.execute_script("window.fetch = window.normalFetch")
+    end
+    within_window(projector) { assert_text "Final poll?" }
+    click_button "Finish"
+    Capybara.using_session(:phone) { assert_text "No answer" }
+    click_button "End quiz"
+    assert_text "The quiz is over"
+    assert page.evaluate_script("window.stageLoaded")
+    Capybara.using_session(:phone) do
+      assert_text "The quiz is over"
+      assert page.evaluate_script("window.phoneLoaded")
+      assert_text "Place 1 of 2"
+      assert_selector ".result-card__score", exact_text: "1 point"
+      assert_no_text "You won!"
+    end
+    Capybara.using_session(:late_phone) do
+      assert_text "Place 2 of 2"
+      assert_selector ".result-card__score", exact_text: "0 points"
+    end
+    assert_selector ".leaderboard li", count: 2
+    assert_selector ".leaderboard li:first-child", text: /1\s+Alice\s+1 point/
+    assert_selector ".leaderboard li:last-child", text: /2\s+Bob\s+0 points/
+    click_button "Top 2"
+    within_window(projector) do
+      assert_selector "li", text: /Alice.*Winner/m
+      assert_no_selector "li", text: /Bob.*Winner/m
+    end
+    Capybara.using_session(:phone) do
+      assert_text "You won!"
+      visit link
+      assert_text "You won!"
+    end
+    within_window(projector) { click_button "Reset winners" }
+    assert_no_selector ".leader__badge", text: "Winner"
+    Capybara.using_session(:phone) { assert_no_text "You won!" }
+    click_button "Draw"
+    Capybara.using_session(:phone) do
+      assert_text "You won!"
+    end
+  end
+end
