+      <span class="play-option__title"><%= option['text'] %></span>
+      <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+    <% end %>
+  <% end %>
+<% end %>
+<% if @game.closed? %>
+  <% if @pick.nil? %>
+    <p class="play-status play-status--neutral" role="status">No answer</p>
+  <% elsif @question.options.fetch(@pick)['correct'] %>
+    <p class="play-status play-status--right" role="status">Correct!</p>
+  <% else %>
+    <p class="play-status play-status--wrong" role="status">Wrong!</p>
+  <% end %>
+<% end %>
