+          <%= form.label :timer_minutes, "Timer minutes" %>
+          <%= form.number_field :timer_minutes, required: true, min: 0, step: 1, class: "input input--number" %>
+        </div>
+        <div class="field">
+          <%= form.label :timer_seconds, "Timer seconds" %>
+          <%= form.number_field :timer_seconds, required: true, min: 0, step: 1, class: "input input--number" %>
+        </div>
+      </div>
+    </fieldset>
+    <%= render "shared/errors", record: quiz %>
+    <div class="buttons">
