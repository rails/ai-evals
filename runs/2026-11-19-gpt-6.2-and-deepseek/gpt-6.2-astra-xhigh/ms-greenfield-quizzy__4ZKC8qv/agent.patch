@@ -0,0 +1,47 @@
+require "application_system_test_case"
+
+class QuestionTimerTest < ApplicationSystemTestCase
+  test "only the stage counts down, including after reload, then reveals results" do
+    quiz = Quiz.create!(title: "Lightning round")
+    2.times do |i|
+      quiz.questions.create!(body: "Poll #{i + 1}", option_rows: [{ text: "Yes", correct: true }, { text: "No" }])
+    end
+
+    visit edit_moderate_quiz_path(quiz)
+    assert_field "Timer minutes", with: "0", type: "number"
+    assert_field "Timer seconds", with: "0", type: "number"
+    fill_in "Timer seconds", with: "5"
+    click_button "Save quiz"
+    click_button "Start a game"
+    assert_no_selector "[role=timer]"
+    link = find(".lobby__url").text
+    Capybara.using_session(:audience) do
+      visit link
+      fill_in "Your name", with: "Alice"
+      click_button "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    click_button "Start", exact: true
+    assert_selector "[role=timer]", exact_text: "0:05"
+    Capybara.using_session(:audience) do
+      assert_text "Poll 1"
+      assert_no_text(/\b\d+:\d\d\b/)
+      click_button "Yes"
+      assert_text "Your answer"
+    end
+    assert_selector "[role=timer]", text: /0:0[1-3]/, wait: 3
+    visit current_url
+    assert_selector "[role=timer]", text: /0:0[1-3]/
+    assert_button "Next", wait: 5
+    assert_no_selector "[role=timer]"
+    assert_selector "li", text: /Yes.*Correct.*1 answer/m
+    Capybara.using_session(:audience) { assert_text "Correct!" }
+
+    click_button "Next"
+    assert_selector "[role=timer]", exact_text: "0:05"
+    click_button "Finish"
+    assert_no_selector "[role=timer]"
+    assert_button "End quiz"
+  end
+end
diff --git a/test/system/quiz_transfer_test.rb b/test/system/quiz_transfer_test.rb
new file mode 100644
index 0000000..e17f6f2
--- /dev/null
+++ b/test/system/quiz_transfer_test.rb
@@ -0,0 +1,43 @@
+require "application_system_test_case"
+
+class QuizTransferTest < ApplicationSystemTestCase
+  test "a moderator can copy an export and import it as an independent quiz" do
+    title = "Frontend Fest 2026"
+    question = 'Which code means "Too Many Requests"?'
+    create_quiz(title)
+    add_question(question, ["418", "429"], correct: [2])
+    add_question("Which tags?", ["</pre>", "<b> & <i>"], correct: [1, 2], active: false)
+    within_question("Which tags?") { click_button "Move up" }
+    original_path = current_path
+
+    click_link "Export"
+    assert_selector "pre", count: 1
+    exported = find("pre").text
+    expected = {
+      "title" => title,
+      "questions" => [
+        { "text" => "Which tags?", "active" => false, "options" => [
+          { "text" => "</pre>", "correct" => true }, { "text" => "<b> & <i>", "correct" => true }
+        ] },
+        { "text" => question, "active" => true, "options" => [
+          { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true }
+        ] }
+      ]
+    }
+    assert_equal expected, JSON.parse(exported)
+
+    visit moderate_root_path
+    click_button "Import quiz"
+    fill_in "Quiz JSON", with: exported
+    click_button "Import", exact: true
+    assert_selector "h1", text: title
+    assert_not_equal original_path, current_path
+    assert_text "1 of 2 questions active"
+    within_question("Which tags?") { assert_unchecked_field "Active" }
+    click_link "Export"
+    assert_equal expected, JSON.parse(find("pre").text)
+
+    visit moderate_root_path
+    assert_selector ".quiz-list > li", text: title, count: 2
+  end
+end
