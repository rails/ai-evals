+class AddGamePrizes < ActiveRecord::Migration[8.1]
+  def change
+    add_column :quizzes, :number_of_winners, :integer, null: false, default: 3
+    add_column :games, :number_of_winners, :integer, null: false, default: 3
+    add_column :games, :question_opened_at, :datetime
+    add_column :answers, :elapsed_us, :integer, limit: 8, null: false, default: 0
+    add_column :players, :points, :integer, null: false, default: 0
+    add_column :players, :correct_time_us, :integer, limit: 8, null: false, default: 0
+    add_column :players, :winner, :boolean, null: false, default: false
+    add_index :players, [:game_id, :points, :correct_time_us, :id], order: { points: :desc }, name: :index_players_on_standing
+
+    reversible do |dir|
+      dir.up do
+        # In the old schema only a phase change touched the game. Preserve
+        # points for finished rounds; historical picks have no recorded time.
+        execute "UPDATE games SET question_opened_at = updated_at WHERE phase = 'open'"
+        execute <<~SQL
+          UPDATE players SET points = (
+            SELECT COUNT(*) FROM answers a
+            JOIN game_questions q ON q.id = a.game_question_id
+            JOIN games g ON g.id = q.game_id
+            WHERE a.player_id = players.id
+              AND (q.number < g.question_number OR g.phase IN ('closed', 'ended'))
+              AND json_extract(q.options, '$[' || a.option_index || '].correct') = 1
+          )
+        SQL
+      end
+    end
+  end
+end
