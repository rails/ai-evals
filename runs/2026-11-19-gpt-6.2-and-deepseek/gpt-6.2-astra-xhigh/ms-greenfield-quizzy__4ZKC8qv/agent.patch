+class GameQuestion < ApplicationRecord
+  belongs_to :game
+  has_many :answers
+
+  # Called once, inside the open -> closed transaction. The unique answer
+  # per player/question holds the last pick, including its elapsed time.
+  def score!
+    correct = options.each_index.select { |i| options[i]["correct"] }
+    game.players.joins(:answers).where(answers: { game_question_id: id, option_index: correct })
+      .update_all("points = players.points + 1, correct_time_us = players.correct_time_us + answers.elapsed_us")
+  end
+end
