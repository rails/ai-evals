@@ -0,0 +1,30 @@
+require "test_helper"
+
+class ModeratorAccessTest < ActionDispatch::IntegrationTest
+  test "health check is public but all moderator resources challenge before lookup or mutation" do
+    get "/up"
+    assert_response :ok
+
+    paths = %w[/moderate /moderate/quizzes/new /moderate/quizzes/1 /moderate/quizzes/1/edit
+               /moderate/quizzes/1/questions/new /moderate/quizzes/1/questions/2/edit /moderate/quizzes/1/preview
+               /moderate/quizzes/import /moderate/quizzes/1/export]
+    paths.each do |path|
+      get path
+      assert_response :unauthorized, path
+      assert_match(/Basic/, response.headers["WWW-Authenticate"])
+    end
+    post "/moderate/quizzes/import", params: { quiz_json: '{"title":"No access","questions":[]}' }
+    assert_response :unauthorized
+    delete "/moderate/quizzes/1"
+    assert_response :unauthorized
+  end
+
+  test "only the configured credentials admit the moderator" do
+    [ [ "test-host", "wrong", :unauthorized ], [ "wrong", "test-pass", :unauthorized ],
+      [ "test-host", "test-pass", :ok ] ].each do |user, password, status|
+      get "/moderate", headers: { Authorization: ActionController::HttpAuthentication::Basic.encode_credentials(user, password) }
+      assert_response status
+    end
+    assert_select "a", text: "New quiz"
+  end
+end
