--- /dev/null
+++ b/config/routes.rb
@@ -0,0 +1,37 @@
+Rails.application.routes.draw do
+  get "up" => "rails/health#show", as: :rails_health_check
+  root to: redirect("/moderate", status: 302)
+
+  scope "play/:code", controller: :play do
+    get "", action: :show, as: :play
+    post :join, as: :join_play
+    post :answer, as: :answer_play
+    post :sync, as: :sync_play
+    post :leave, as: :leave_play
+  end
+
+  namespace :moderate do
+    root "quizzes#index"
+    resources :games, only: :show do
+      get :state, on: :member
+      post :advance, on: :member
+      post :winners, on: :member
+    end
+    resources :quizzes do
+      resources :games, only: :create
+      collection do
+        get :import, to: "quiz_imports#new"
+        post :import, to: "quiz_imports#create"
+      end
+      get :export, on: :member
+      get :preview, on: :member
+      resources :questions, except: %i[index show] do
+        member do
+          patch :move_up
+          patch :move_down
+          patch :set_active
+        end
+      end
+    end
+  end
+end
