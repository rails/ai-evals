+require "application_system_test_case"
+
+class ModerationTest < ApplicationSystemTestCase
+  test "quiz settings, list navigation and confirmed deletion" do
+    create_quiz("Opening keynote")
+    click_link "Settings"
+    assert_field "Title", with: "Opening keynote"
+    fill_in "Title", with: "Closing keynote"
+    click_button "Save quiz"
+    click_link "← All quizzes"
+    within "li", text: "Closing keynote" do
+      click_link "Closing keynote"
+    end
+    click_link "Settings"
+    dismiss_confirm { click_button "Delete quiz" }
+    assert_field "Title", with: "Closing keynote"
+    accept_confirm { click_button "Delete quiz" }
+    assert_selector "h1", text: "Quizzes"
+    assert_no_link "Closing keynote"
+  end
+
+  test "option validation keeps all submitted rows and only complete questions are saved" do
+    create_quiz("Science hour")
+    click_link "Add question"
+    assert_selector '.option-row', count: 4
+    assert_checked_field "Active"
+    click_button "Save question"
+    assert_text "Question can't be blank"
+    assert_text "Add at least two options"
+    assert_text "Mark at least one option as correct"
+    fill_in "Question", with: "Which planet is the largest?"
+    fill_in "Option 2", with: "Saturn", exact: true
+    check "Option 1 is correct" # an empty row does not count as a correct option
+    uncheck "Active"
+    click_button "Add option"
+    assert_field "Option 5", with: "", exact: true
+    click_button "Save question"
+    assert_text "Add at least two options"
+    assert_text "Mark at least one option as correct"
+    assert_field "Question", with: "Which planet is the largest?"
+    assert_field "Option 2", with: "Saturn", exact: true
+    assert_checked_field "Option 1 is correct"
+    assert_unchecked_field "Active"
+    assert_selector '.option-row', count: 5
+    fill_in "Option 5", with: "Jupiter", exact: true
+    check "Option 5 is correct"
+    click_button "Save question"
+    within_question "Which planet is the largest?" do
+      assert_unchecked_field "Active"
+      assert_selector ".question-item__options li", count: 2
+      assert_selector ".is-correct", text: "Jupiter", count: 1
+      click_link "Edit"
+    end
+    assert_field "Option 1", with: "Saturn", exact: true
+    assert_checked_field "Option 2 is correct"
+    fill_in "Option 1", with: "Mars", exact: true
+    check "Active"
+    click_button "Save question"
+    within_question "Which planet is the largest?" do
+      assert_text "Mars"
+      assert_checked_field "Active"
+      click_link "Edit"
+    end
+    click_button "Remove option 1"
+    assert_checked_field "Option 1 is correct"
+    fill_in "Question", with: "Changed but invalid"
+    click_button "Save question"
+    assert_text "Add at least two options"
+    click_link "Cancel"
+    within_question "Which planet is the largest?" do
+      assert_text "Mars"
+      dismiss_confirm { click_button "Delete", exact: true }
+      assert_text "Jupiter"
+      accept_confirm { click_button "Delete", exact: true }
+    end
+    assert_no_selector '.question-list > li'
+  end
+
+  test "the phone preview plays just active questions in their saved order" do
+    create_quiz("Festival trivia")
+    click_link "Preview"
+    assert_text "No active questions to preview"
+    click_link "Back to quiz"
+    add_question("Fruit?", ["Apple", "Lemon", "Pea"], correct: [1, 2])
+    add_question("Omit this question", ["OK", "Other"], correct: [1])
+    add_question("Pick an even number", ["Two", "Three"], correct: [1])
+    add_question("Capital of France?", ["Paris", "Berlin"], correct: [1], active: false)
+    within_question("Omit this question") { uncheck "Active" }
+    assert_text "2 of 4 questions active"
+    within_question("Capital of France?") { check "Active" }
+    assert_text "3 of 4 questions active"
+    within_question("Pick an even number") { click_button "Move up" }
+    within_question("Fruit?") { click_button "Move down" }
+    assert_equal ["Pick an even number", "Fruit?", "Omit this question", "Capital of France?"],
+      all(".question-list > li .question-item__body").map(&:text)
+    click_link "Preview"
+    page.current_window.resize_to(390, 844)
+    assert_text "Question 1 of 3"
+    assert_selector "h1", text: "Pick an even number"
+    assert_no_button "Next question"
+    click_button "Two"
+    assert_text "Correct!"
+    assert_button "Three", disabled: true
+    click_button "Next question"
+    assert_text "Question 2 of 3"
+    click_button "Pea"
+    assert_text "Wrong!"
+    assert_selector "button.is-correct", text: "Lemon"
+    assert_selector "button.is-correct", text: "Apple"
+    click_button "Next question"
+    assert_text "Question 3 of 3"
+    click_button "Paris"
+    click_button "See score"
+    assert_text "Score: 2/3"
+    click_button "Start over"
+    assert_text "Question 1 of 3"
+    click_button "Three"
+    click_button "Next question"
+    click_button "Lemon"
+    click_button "Next question"
+    click_button "Berlin"
+    click_button "See score"
+    assert_text "Score: 1/3"
+  end
+end
