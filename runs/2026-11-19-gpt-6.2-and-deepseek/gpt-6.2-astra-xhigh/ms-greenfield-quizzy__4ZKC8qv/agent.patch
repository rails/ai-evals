+module Moderate
+  class QuestionsController < BaseController
+    before_action :set_quiz
+    before_action :set_question, except: %i[new create]
+
+    def new
+      @question = @quiz.questions.build
+    end
+
+    def create
+      @question = @quiz.questions.build(question_params)
+      if @question.save
+        return_to_quiz
+      else
+        render :new, status: :unprocessable_content
+      end
+    end
+
+    def edit
+    end
+
+    def update
+      if @question.update(question_params)
+        return_to_quiz
+      else
+        render :edit, status: :unprocessable_content
+      end
+    end
+
+    def move_up
+      @question.move!(:up)
+      return_to_quiz
+    end
+
+    def move_down
+      @question.move!(:down)
+      return_to_quiz
+    end
+
+    def set_active
+      @question.update!(params.expect(question: [ :active ]))
+      return_to_quiz
+    end
+
+    def destroy
+      @question.destroy!
+      return_to_quiz
+    end
+
+    private
+      def set_quiz
+        @quiz = Quiz.find(params[:quiz_id])
+      end
+
+      def set_question
+        @question = @quiz.questions.find(params[:id])
+      end
+
+      def question_params
+        permitted = params.expect(question: [ :body, :active, option_rows: [ [ :text, :correct ] ] ])
+        permitted.with_defaults(option_rows: [])
+      end
+
+      def return_to_quiz
+        redirect_to moderate_quiz_path(@quiz), status: :see_other
+      end
+  end
+end
