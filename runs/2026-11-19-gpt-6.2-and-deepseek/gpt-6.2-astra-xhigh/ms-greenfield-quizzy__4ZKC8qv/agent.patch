+++ b/app/models/player_visit.rb
@@ -0,0 +1,15 @@
+class PlayerVisit < ApplicationRecord
+  belongs_to :player
+  scope :recent, -> { where(seen_at: 1.minute.ago..) }
+
+  def self.valid_token?(value)
+    value.is_a?(String) && value.match?(/\A[0-9a-f]{32}\z/)
+  end
+
+  # Each open document owns one lease. Closing one of two tabs must not
+  # remove the player from the stage counter. Abandoned leases expire.
+  def self.renew(player, token)
+    return unless player && token
+    upsert({ player_id: player.id, token: token, seen_at: Time.current }, unique_by: [:player_id, :token])
+  end
+end
diff --git a/app/models/question.rb b/app/models/question.rb
new file mode 100644
index 0000000..2079668
--- /dev/null
+++ b/app/models/question.rb
@@ -0,0 +1,50 @@
+class Question < ApplicationRecord
+  belongs_to :quiz, counter_cache: true
+  validates :body, presence: true
+  validate :playable_options
+  before_create :append_to_quiz
+
+  # Keep the unfiltered rows around to re-render the editor on validation errors.
+  # Only the ordered, nonblank choices become part of the persisted question.
+  def option_rows=(rows)
+    @option_rows = rows.map do |row|
+      row = row.to_h.stringify_keys
+      { "text" => row["text"].to_s, "correct" => ActiveModel::Type::Boolean.new.cast(row["correct"]) || false }
+    end
+    self.options = @option_rows.reject { |row| row["text"].blank? }
+  end
+
+  def option_rows
+    @option_rows || (new_record? ? Array.new(4) { {} } : options)
+  end
+
+  def move!(direction)
+    quiz.with_lock do
+      reload
+      others = quiz.questions
+      neighbor = case direction
+      when :up then others.where("position < ?", position).last
+      when :down then others.where("position > ?", position).first
+      else raise ArgumentError, "Unknown direction"
+      end
+      if neighbor
+        from, to = position, neighbor.position
+        # Park one row at zero while exchanging the two unique positions.
+        update!(position: 0)
+        neighbor.update!(position: from)
+        update!(position: to)
+      end
+    end
+  end
+
+  private
+    def append_to_quiz
+      quiz.lock!
+      self.position = quiz.questions.maximum(:position).to_i + 1
+    end
+
+    def playable_options
+      errors.add(:base, "Add at least two options") if options.size < 2
+      errors.add(:base, "Mark at least one option as correct") unless options.any? { |row| row["correct"] }
+    end
+end
