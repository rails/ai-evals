+module Moderate
+  class QuizImportsController < BaseController
+    def new
+    end
+
+    def create
+      @quiz_json = params.permit(:quiz_json)[:quiz_json].to_s
+      quiz = QuizDocument.import!(@quiz_json)
+      redirect_to moderate_quiz_path(quiz), status: :see_other
+    rescue QuizDocument::Invalid => error
+      @error = error.message
+      render :new, status: :unprocessable_content
+    end
+  end
+end
