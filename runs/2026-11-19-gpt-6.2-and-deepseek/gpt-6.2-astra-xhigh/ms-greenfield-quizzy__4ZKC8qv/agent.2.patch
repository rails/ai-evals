diff --git a/test/integration/quiz_import_test.rb b/test/integration/quiz_import_test.rb
new file mode 100644
index 0000000..1f0908d
--- /dev/null
+++ b/test/integration/quiz_import_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class QuizImportTest < ActionDispatch::IntegrationTest
+  setup do
+    @headers = { Authorization: ActionController::HttpAuthentication::Basic.encode_credentials("test-host", "test-pass") }
+    @question = { text: "Which option?", options: [ { text: "First" }, { text: "Last", correct: true } ] }
+  end
+
+  test "omitted flags take their defaults and blank editor rows are skipped" do
+    options = [ { text: " ", correct: true }, *@question[:options] ]
+    submit JSON.generate(title: "Defaults", questions: [ @question.merge(options: options) ])
+    quiz = Quiz.last
+    assert_redirected_to moderate_quiz_path(quiz)
+    question = quiz.questions.sole
+    assert_predicate question, :active?
+    assert_equal [ { "text" => "First", "correct" => false }, { "text" => "Last", "correct" => true } ], question.options
+  end
+
+  test "an empty quiz can be imported and exported" do
+    data = { "title" => "Next year", "questions" => [] }
+    submit JSON.generate(data)
+    quiz = Quiz.last
+    assert_redirected_to moderate_quiz_path(quiz)
+    get export_moderate_quiz_path(quiz), headers: @headers
+    assert_equal data, JSON.parse(css_select("pre").sole.text)
+  end
+
+  test "invalid JSON and malformed or untitled quiz objects are rejected" do
+    [ "", "{broken", "null", "[]", "{}", '{"title":"Empty"}', '{"title":"Q","questions":null}',
+      '{"title":42,"questions":[]}', '{"title":"  ","questions":[]}' ].each do |source|
+      assert_rejected source
+    end
+  end
+
+  test "a bad question rolls back the quiz and all earlier questions" do
+    existing = Quiz.create!(title: "Keynote")
+    existing.questions.create!(body: "Original", option_rows: @question[:options])
+    invalid_questions = [
+      nil,
+      @question.except(:text), @question.merge(text: " "), @question.merge(text: 42),
+      @question.merge(active: "false"), @question.merge(active: nil),
+      @question.except(:options), @question.merge(options: {}),
+      @question.merge(options: [ { text: "Only one", correct: true } ]),
+      @question.merge(options: [ { text: "A" }, { text: "B" }, { text: " ", correct: true } ]),
+      @question.merge(options: [ *@question[:options], "C" ]),
+      @question.merge(options: [ *@question[:options], { correct: true } ]),
+      @question.merge(options: [ *@question[:options], { text: "C", correct: 0 } ])
+    ]
+    invalid_questions.each do |invalid|
+      source = JSON.generate(title: existing.title, questions: [ @question, invalid ])
+      assert_rejected source, /Question 2:/
+    end
+    assert_equal [ "Original" ], existing.reload.questions.pluck(:body)
+  end
+
+  private
+    def submit(source)
+      post import_moderate_quizzes_path, params: { quiz_json: source }, headers: @headers
+    end
+
+    def assert_rejected(source, message = /\S/)
+      assert_no_difference [ "Quiz.count", "Question.count" ] do
+        submit source
+      end
+      assert_response :unprocessable_content
+      assert_select "[role=alert]", text: message
+      assert_select "textarea[name=quiz_json]", text: source
+    end
+end
diff --git a/test/system/quiz_transfer_test.rb b/test/system/quiz_transfer_test.rb
new file mode 100644
index 0000000..e17f6f2
--- /dev/null
+++ b/test/system/quiz_transfer_test.rb
@@ -0,0 +1,43 @@
+require "application_system_test_case"
+
+class QuizTransferTest < ApplicationSystemTestCase
+  test "a moderator can copy an export and import it as an independent quiz" do
+    title = "Frontend Fest 2026"
+    question = 'Which code means "Too Many Requests"?'
+    create_quiz(title)
+    add_question(question, ["418", "429"], correct: [2])
+    add_question("Which tags?", ["</pre>", "<b> & <i>"], correct: [1, 2], active: false)
+    within_question("Which tags?") { click_button "Move up" }
+    original_path = current_path
+
+    click_link "Export"
+    assert_selector "pre", count: 1
+    exported = find("pre").text
+    expected = {
+      "title" => title,
+      "questions" => [
+        { "text" => "Which tags?", "active" => false, "options" => [
+          { "text" => "</pre>", "correct" => true }, { "text" => "<b> & <i>", "correct" => true }
+        ] },
+        { "text" => question, "active" => true, "options" => [
+          { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true }
+        ] }
+      ]
+    }
+    assert_equal expected, JSON.parse(exported)
+
+    visit moderate_root_path
+    click_button "Import quiz"
+    fill_in "Quiz JSON", with: exported
+    click_button "Import", exact: true
+    assert_selector "h1", text: title
+    assert_not_equal original_path, current_path
+    assert_text "1 of 2 questions active"
+    within_question("Which tags?") { assert_unchecked_field "Active" }
+    click_link "Export"
+    assert_equal expected, JSON.parse(find("pre").text)
+
+    visit moderate_root_path
+    assert_selector ".quiz-list > li", text: title, count: 2
+  end
+end
