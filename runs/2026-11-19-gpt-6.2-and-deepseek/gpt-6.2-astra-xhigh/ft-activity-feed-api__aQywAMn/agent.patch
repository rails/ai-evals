diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..993a180 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,28 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array.wrap(assignee_ids) }
+    when "card_board_changed"
+      string_particulars("old_board", "new_board")
+    when "card_title_changed"
+      string_particulars("old_title", "new_title")
+    when "card_triaged"
+      string_particulars("column")
+    else
+      {}
+    end
+  end
+
+  def particular(key)
+    particulars&.dig("particulars", key)
+  end
+
+  private
+    def string_particulars(*keys)
+      keys.index_with { |key| particular(key).to_s }
+    end
 end
