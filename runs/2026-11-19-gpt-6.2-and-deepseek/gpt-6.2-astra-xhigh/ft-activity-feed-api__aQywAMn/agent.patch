diff --git a/config/initializers/geared_pagination.rb b/config/initializers/geared_pagination.rb
new file mode 100644
index 0000000..4d27770
--- /dev/null
+++ b/config/initializers/geared_pagination.rb
@@ -0,0 +1,12 @@
+# Geared Pagination 1.2 turns the query into a hash, dropping all but the last
+# value of repeated filters such as creator_ids[] in next-page links.
+module GearedPagination::PreserveListParameters
+  private
+    def uri(page:)
+      Addressable::URI.parse(request.url).tap do |uri|
+        uri.query = request.query_parameters.merge("page" => page).to_query
+      end.to_s
+    end
+end
+
+GearedPagination::Headers.prepend GearedPagination::PreserveListParameters
