new file mode 100644
index 0000000..6860200
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,28 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a [paginated](../README.md#pagination) array of events on boards you can access, newest first.
+
+| Parameter | Type | Required | Description |
+|-----------|------|----------|-------------|
+| `creator_ids[]` | array of IDs | No | Include events created by any of these users |
+| `board_ids[]` | array of IDs | No | Include events on any of these boards |
+
+When both filters are supplied, events must match both.
+
+Each event has an `id`, `action`, `created_at` timestamp, plain-text `description`, and `url`. The URL opens the card, with an anchor to the comment for comment events.
+
+`eventable_type` is `Card` or `Comment`. `eventable` contains the corresponding [card](cards.md) or [comment](comments.md) object. The `board` and `creator` fields contain the standard [board](boards.md) and [user](users.md) objects.
+
+The `particulars` object depends on the action:
+
+| Action | `particulars` |
+|--------|---------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` (array of user IDs) |
+| `card_board_changed` | `old_board`, `new_board` (board names) |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` (column name) |
+| `card_published`, `card_closed`, `card_reopened`, `card_postponed`, `card_auto_postponed`, `card_sent_back_to_triage`, `comment_created` | `{}` |
+
+Missing board names, titles, and column names are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..6690935
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  test "lists card and comment activity as JSON" do
+    activities = get_activities.index_by { |activity| activity.fetch("id") }
+    event = events(:logo_assignment_david)
+    activity = activities.fetch(event.id)
+    assert_equal "card_assigned", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:david)).to_plain_text, activity["description"]
+    assert_equal({ "assignee_ids" => [ users(:david).id ] }, activity["particulars"])
+    assert_equal card_url(event.card), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal event.card.number, activity.dig("eventable", "number")
+    assert_equal event.board.name, activity.dig("board", "name")
+    assert_equal event.creator.identity.email_address, activity.dig("creator", "email_address")
+
+    event = events(:layout_commented)
+    activity = activities.fetch(event.id)
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal event.eventable.body.to_plain_text, activity.dig("eventable", "body", "plain_text")
+    assert_equal card_url(event.card, anchor: dom_id(event.eventable)), activity["url"]
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "includes timeline actions and title changes but not deprecated or non-timeline actions" do
+    card = cards(:logo)
+    creator = users(:jz)
+    card.track_event(:board_changed, creator: creator, particulars: { old_board: "Before", new_board: "After" })
+    card.track_event(:title_changed, creator: creator, particulars: { old_title: "Old title", new_title: "New title" })
+    card.track_event(:triaged, creator: creator, particulars: { column: "In progress" })
+    card.track_event(:unassigned, creator: creator, assignee_ids: [ users(:kevin).id ])
+    card.track_event(:closed, creator: creator, particulars: { internal: "not exposed" })
+    card.track_event(:collection_changed, creator: creator)
+    card.track_event(:resumed, creator: creator)
+
+    activities = get_activities(creator_ids: [ creator.id ])
+    assert_equal({
+      "card_board_changed" => { "old_board" => "Before", "new_board" => "After" },
+      "card_title_changed" => { "old_title" => "Old title", "new_title" => "New title" },
+      "card_triaged" => { "column" => "In progress" },
+      "card_unassigned" => { "assignee_ids" => [ users(:kevin).id ] },
+      "card_closed" => {}
+    }, activities.to_h { |activity| activity.values_at("action", "particulars") })
+  end
+
+  test "missing board, title and column details are empty strings" do
+    creator = users(:jz)
+    %i[ board_changed title_changed triaged ].each do |action|
+      cards(:logo).track_event(action, creator: creator)
+    end
+
+    activities = get_activities(creator_ids: [ creator.id ]).index_by { |activity| activity.fetch("action") }
+    assert_equal({ "old_board" => "", "new_board" => "" }, activities.fetch("card_board_changed")["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, activities.fetch("card_title_changed")["particulars"])
+    assert_equal({ "column" => "" }, activities.fetch("card_triaged")["particulars"])
+  end
+
+  test "board filters narrow the feed without granting access" do
+    private_board = boards(:private)
+    with_current_user(:kevin) { private_board.cards.create!(title: "Secret", status: :published) }
+    cards(:radio).track_event(:published, creator: users(:mike))
+
+    assert_equal [ boards(:writebook).id ], get_activities.map { |activity| activity.dig("board", "id") }.uniq
+    assert_empty get_activities(board_ids: [ private_board.id, boards(:miltons_wish_list).id ])
+
+    private_board.accesses.grant_to(users(:david))
+    assert_equal private_board.events.ids, get_activities(board_ids: [ private_board.id ]).pluck("id")
+    assert_empty get_activities(board_ids: [ private_board.id ], creator_ids: [ users(:david).id ])
+  end
+
+  test "paginates filtered activity in descending order" do
+    freeze_time do
+      16.times { cards(:layout).track_event(:published, creator: users(:jz)) }
+    end
+    creators = users(:david, :jz)
+    expected_ids = boards(:writebook).events.where(creator: creators).order(created_at: :desc, id: :desc).ids
+
+    first_page = get_activities(creator_ids: creators.map(&:id))
+    assert_equal expected_ids.size.to_s, @response.headers["X-Total-Count"]
+    next_url = @response.headers.fetch("Link")[/<([^>]+)>; rel="next"/, 1]
+    second_page = get_activities(next_url)
+    assert_equal expected_ids, (first_page + second_page).pluck("id")
+    assert_nil @response.headers["Link"]
+  end
+
+  private
+    def get_activities(path = activities_path(format: :json), **filters)
+      get path, params: filters, headers: { "Authorization" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+      assert_response :success
+      @response.parsed_body
+    end
+end
