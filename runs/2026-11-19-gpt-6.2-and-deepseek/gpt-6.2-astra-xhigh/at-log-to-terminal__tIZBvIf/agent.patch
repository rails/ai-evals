--- /dev/null
+++ b/test/script/library_report_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  test "writes the report once, in order, to stdout and the environment log" do
+    assert_report :debug, <<~REPORT
+      Library report: 2 books
+      Library report: Manual has no pages
+      Library report: Handbook has 4 pages
+      Library report: done
+    REPORT
+    assert_report :warn, "Library report: Manual has no pages\n"
+  end
+
+  private
+    def assert_report(level, expected)
+      File.open(Rails.application.paths["log"].first) do |log|
+        log.seek(0, IO::SEEK_END)
+        stdout, = capture_io do
+          Rails.logger.log_at(level) { load Rails.root.join("script/library_report.rb") }
+        end
+
+        assert_equal expected, stdout
+        assert_equal expected.lines, log.readlines.grep(/\ALibrary report:/)
+      end
+    end
+end
