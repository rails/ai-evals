diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..0f18e30
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,53 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    sign_in_as users(:kevin)
+  end
+
+  teardown do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+  end
+
+  test "comment and deadline labels use the browser's day, regardless of the request timezone" do
+    afternoon = Time.find_zone!("America/Los_Angeles").now.change(hour: 13, min: 42)
+    comment = comments(:logo_agreement_kevin)
+    card = comment.card
+    comment.update_column :created_at, afternoon
+    comments(:logo_agreement_jz).update_column :created_at, afternoon.yesterday.end_of_day
+    card.update_column :created_at, Time.utc(2020, 9, 13, 2) # Sep 12 in Los Angeles
+    card.update_column :last_active_at, afternoon.tomorrow.beginning_of_day - card.auto_postpone_period
+
+    page.execute_script("document.cookie = 'timezone=Asia%2FTokyo; path=/'")
+    visit card_url(card)
+    timestamp = "##{dom_id(comment)} .comment__permalink-title time"
+    assert_selector timestamp, text: "1:42 PM"
+    assert_selector ".comment__permalink-title time", text: "yesterday"
+    assert_selector ".card__meta-text--added time", text: /Sep 12, 2020/i
+    assert_selector ".bubble [data-bubble-target=bottom]", text: /tomorrow/i
+    assert_text "Moves to “Not Now” tomorrow if there’s no activity."
+
+    # A morph may keep the connected <time> and replace both its datetime and its text.
+    page.execute_script(<<~JS, find(timestamp), (afternoon - 5.days).utc.iso8601)
+      const [time, datetime] = arguments
+      const incoming = time.cloneNode()
+      incoming.dateTime = incoming.textContent = datetime
+      Turbo.morphElements(time, incoming)
+    JS
+    assert_selector timestamp, text: "5 days ago"
+  end
+
+  test "a deadline across the spring DST change counts calendar days" do
+    # Late March 7 to early March 10 is less than 48 hours in Los Angeles.
+    label = page.evaluate_async_script(<<~JS)
+      const done = arguments[0]
+      import("helpers/date_helpers").then(({ formatLocalTime }) => {
+        done(formatLocalTime(new Date("2025-03-10T07:01:00Z"), "due", new Date("2025-03-08T07:59:00Z")))
+      })
+    JS
+    assert_equal "in 3 days", label
+  end
+end
