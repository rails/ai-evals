diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..86eaf0f
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,31 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.render()
+  }
+
+  disconnect() {
+    clearTimeout(this.midnightTimer)
+  }
+
+  render() {
+    const datetime = this.element.dateTime
+    // Timeline headings identify a calendar day, not midnight UTC.
+    const dateOnly = !datetime.includes("T")
+    const date = new Date(dateOnly ? `${datetime}T00:00:00` : datetime)
+    const now = new Date()
+
+    this.element.textContent = formatLocalTime(date, this.formatValue, now)
+    if (!dateOnly) this.element.title = formatLocalTime(date, "datetime")
+
+    clearTimeout(this.midnightTimer)
+    if ([ "relative", "due" ].includes(this.formatValue)) {
+      const midnight = new Date(now).setHours(24, 0, 0, 0)
+      this.midnightTimer = setTimeout(() => this.render(), midnight - now)
+    }
+  }
+}
