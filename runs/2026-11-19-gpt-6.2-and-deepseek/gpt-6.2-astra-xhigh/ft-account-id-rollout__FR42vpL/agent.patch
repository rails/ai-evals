+  end
+
+  def down
+    raise ActiveRecord::IrreversibleMigration, "Orphaned records were deleted"
+  end
+
+  private
+    def scope_tables(*tables, via: nil, from: nil)
+      tables.each do |table|
+        add_account_column(table)
+        if from.is_a?(Hash)
+          from.each { |type, parent| inherit_account(table, via, parent, type: type) }
+        elsif from
+          inherit_account(table, via, from)
+        end
+        require_account(table)
+      end
+    end
+
+    def add_account_column(table)
+      add_column table, :account_id, :uuid unless column_exists?(table, :account_id)
+    end
+
+    def inherit_account(table, via, parent, type: nil)
+      table = connection.quote_table_name(table)
+      account_key = parent == :accounts ? "id" : "account_id"
+      execute <<~SQL
+        UPDATE #{table} SET account_id = (
+          SELECT p.#{account_key} FROM #{connection.quote_table_name(parent)} p WHERE p.id = #{table}.#{via}_id
+        ) WHERE account_id IS NULL #{"AND #{via}_type = #{connection.quote(type)}" if type}
+      SQL
+    end
+
+    def require_account(table)
+      execute "DELETE FROM #{connection.quote_table_name(table)} WHERE account_id IS NULL OR account_id NOT IN (SELECT id FROM accounts)"
+      if connection.columns(table).find { |column| column.name == "account_id" }.null
+        change_column_null table, :account_id, false
+      end
+      unless connection.indexes(table).any? { |index| index.columns.first == "account_id" }
+        add_index table, :account_id
+      end
+    end
+
+    def scope_active_storage
+      tables = %i[ active_storage_attachments active_storage_blobs active_storage_variant_records ]
+      tables.each { |table| add_account_column(table) }
+
+      connection.transaction { backfill_active_storage }
+      tables.each { |table| require_account(table) }
+    end
+
+    def backfill_active_storage
+      execute "DELETE FROM active_storage_attachments WHERE blob_id NOT IN (SELECT id FROM active_storage_blobs)"
