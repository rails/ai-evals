+        inherit_account(:active_storage_variant_records, :blob, :active_storage_blobs)
+        inherit_account(:active_storage_attachments, :record, :active_storage_variant_records, type: "ActiveStorage::VariantRecord")
+        inherit_account(:active_storage_attachments, :record, :active_storage_blobs, type: "ActiveStorage::Blob")
+        break if fill_attached_blobs.zero?
+      end
+
+      # Never silently attribute shared files to whichever tenant happened to be first.
+      if connection.select_value("SELECT 1 FROM active_storage_attachments GROUP BY blob_id HAVING COUNT(DISTINCT account_id) > 1 LIMIT 1")
+        raise "Found blobs attached to multiple accounts; resolve ownership before migrating"
+      end
+    end
+
+    def fill_attached_blobs
+      connection.update(<<~SQL)
+        UPDATE active_storage_blobs SET account_id = (
+          SELECT MIN(a.account_id) FROM active_storage_attachments a WHERE a.blob_id = active_storage_blobs.id
+        ) WHERE account_id IS NULL AND id IN (SELECT blob_id FROM active_storage_attachments WHERE account_id IS NOT NULL)
+      SQL
+    end
