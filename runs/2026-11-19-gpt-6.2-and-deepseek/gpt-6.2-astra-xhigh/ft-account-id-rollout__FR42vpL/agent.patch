diff --git a/test/models/account/tenant_rows_test.rb b/test/models/account/tenant_rows_test.rb
new file mode 100644
index 0000000..03cb6c6
--- /dev/null
+++ b/test/models/account/tenant_rows_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Account::TenantRowsTest < ActiveSupport::TestCase
+  GLOBAL_TABLES = %w[ accounts account_external_id_sequences identities identity_access_tokens
+    sessions magic_links action_pack_passkeys ar_internal_metadata schema_migrations ]
+
+  test "all tenant tables have an indexed, non-null UUID account key" do
+    connection = ApplicationRecord.connection
+    connection.tables.each do |table|
+      # The FTS5 virtual table and its shadow tables mirror search_records by rowid.
+      next if table.start_with?("search_records_fts")
+
+      account_id = connection.columns(table).find { |column| column.name == "account_id" }
+      if GLOBAL_TABLES.include?(table)
+        assert_nil account_id, table
+      else
+        assert_equal :uuid, account_id&.type, table
+        assert_not account_id.null, table
+        assert connection.indexes(table).any? { |index| index.columns.first == "account_id" }, table
+      end
+    end
+  end
+
+  test "bulk grants and filter links inherit the owner's tenant rather than Current.account" do
+    board = boards(:miltons_wish_list)
+    user = board.account.users.create!(name: "New Member")
+    assert_equal board.account, board.accesses.find_by!(user: user).account
+    new_board = board.account.boards.create!(name: "New board", creator: users(:mike), all_access: true)
+    assert_equal board.account, new_board.accesses.find_by!(user: user).account
+
+    filter = user.filters.create!(boards: [ board ], assignees: [ user ])
+    assert_equal board.account, filter.board_links.sole.account
+    assert_equal board.account, filter.assignee_links.sole.account
+  end
+
+  test "rich text, attachments, blobs and variants inherit the record's tenant without a request" do
+    card = cards(:radio)
+    Current.without_account do
+      card.update!(description: "New description")
+      card.image.attach(io: StringIO.new("original"), filename: "original.txt")
+      variant = card.image.blob.variant_records.create!(variation_digest: "digest")
+      variant.image.attach(io: StringIO.new("variant"), filename: "variant.txt")
+
+      [ card.rich_text_description, card.image.attachment, card.image.blob, variant, variant.image.attachment, variant.image.blob ].each do |row|
+        assert_equal card.account_id, row.reload.account_id
+      end
+    end
+  end
+end
