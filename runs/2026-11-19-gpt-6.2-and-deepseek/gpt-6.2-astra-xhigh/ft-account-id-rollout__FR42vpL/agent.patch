+class FinishAccountIdRollout < ActiveRecord::Migration[8.2]
+  # Identity is global. Its memberships don't identify the owner of an upload.
+  ATTACHED_RECORD_TABLES = {
+    "Account" => :accounts, "Board" => :boards, "Card" => :cards, "Comment" => :comments, "User" => :users,
+    "Export" => :exports, "Account::Import" => :account_imports, "ActionText::RichText" => :action_text_rich_texts
+  }.freeze
+
+  def up
+    # Tag titles are unique within the account, not across all tenants.
+    add_index :tags, [ :account_id, :title ], unique: true unless index_exists?(:tags, [ :account_id, :title ], unique: true)
+    remove_index :tags, :title if index_exists?(:tags, :title)
+
+    # Work from owners to dependents so a recovered account propagates all the
+    # way down (e.g. user -> board -> card -> comment -> rich text -> embed).
+    scope_tables :tags, :users, :account_join_codes, :account_imports, :account_cancellations, :storage_entries
+    scope_tables :boards, :filters, via: :creator, from: :users
+    scope_tables :notification_bundles, :notifications, :push_subscriptions, :user_settings,
+      :search_queries, :exports, via: :user, from: :users
+    scope_tables :cards, :columns, :events, :webhooks, :accesses, :board_publications, via: :board, from: :boards
+    scope_tables :comments, :steps, :assignments, :card_activity_spikes, :card_goldnesses, :card_not_nows,
+      :closures, :pins, :taggings, :watches, via: :card, from: :cards
+    scope_tables :webhook_deliveries, :webhook_delinquency_trackers, via: :webhook, from: :webhooks
+    scope_tables :assignees_filters, :assigners_filters, :boards_filters, :closers_filters,
+      :creators_filters, :filters_tags, via: :filter, from: :filters
+
+    scope_tables :entropies, via: :container, from: { "Account" => :accounts, "Board" => :boards }
+    scope_tables :storage_totals, via: :owner, from: { "Account" => :accounts, "Board" => :boards }
+    scope_tables :mentions, via: :source, from: { "Card" => :cards, "Comment" => :comments }
+    scope_tables :reactions, via: :reactable, from: { "Card" => :cards, "Comment" => :comments }
+    scope_tables :action_text_rich_texts, via: :record, from: { "Board" => :boards, "Card" => :cards, "Comment" => :comments }
+
+    scope_active_storage
