new file mode 100644
index 0000000..4d29f1f
--- /dev/null
+++ b/app/views/bots/index.html.erb
@@ -0,0 +1,53 @@
+<% @page_title = "Chat bots" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to edit_account_path %>
+  </div>
+<% end %>
+
+<section class="panel flex flex-column gap">
+  <h1 class="txt-align-center margin-none">Chat bots</h1>
+  <p class="margin-none">Send messages to a room from a script or CI job. Keep each bot code secret: anyone with it can post as that bot.</p>
+
+  <details>
+    <summary>How to post a message</summary>
+    <p>Replace ROOM_ID with the number in the room URL and BOT_CODE with the bot's code.</p>
+    <code>curl -d "Hello from a bot" "<%= room_bot_messages_url("ROOM_ID", "BOT_CODE") %>"</code>
+  </details>
+
+  <ul class="flex flex-column gap unpad margin-none">
+    <% @bots.each do |bot| %>
+      <li class="flex flex-column gap pad fill-shade border-radius">
+        <div class="flex align-center gap">
+          <%= avatar_tag bot.user, loading: :lazy %>
+          <strong class="flex-item-grow overflow-ellipsis"><%= bot.name %></strong>
+          <%= link_to edit_bot_path(bot), class: "btn", aria: { label: "Edit #{bot.name}" } do %>
+            <%= image_tag "pencil.svg", size: 20, aria: { hidden: "true" } %>
+            <span class="for-screen-reader">Edit <%= bot.name %></span>
+          <% end %>
+        </div>
+        <% if bot.suspended? %>
+          <p class="margin-none"><strong>Suspended</strong>: <%= bot.suspension_reason %></p>
+          <% if Current.user.administrator? %>
+            <%= button_to "Reactivate", bot_reactivation_path(bot), class: "btn", data: { turbo_confirm: "Reactivate this chat bot?" } %>
+          <% end %>
+        <% end %>
+        <label class="flex align-center gap">
+          Bot code
+          <input type="text" class="input flex-item-grow min-width" value="<%= bot.code %>" aria-label="Bot code" readonly autocomplete="off" spellcheck="false">
+        </label>
+      </li>
+    <% end %>
+  </ul>
+
+  <% if Current.user.bot_limit_reached? %>
+    <p class="margin-none">You've reached the limit for chat bots.</p>
+  <% else %>
+    <%= link_to new_bot_path, class: "btn btn--reversed center" do %>
+      <%= image_tag "add.svg", size: 20, aria: { hidden: "true" } %>
+      Add a chat bot
+    <% end %>
+  <% end %>
+</section>
