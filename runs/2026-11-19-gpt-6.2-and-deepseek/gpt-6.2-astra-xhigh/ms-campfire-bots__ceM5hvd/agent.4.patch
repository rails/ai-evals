diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
new file mode 100644
index 0000000..b9fae9c
--- /dev/null
+++ b/test/models/bot_test.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+
+class BotTest < ActiveSupport::TestCase
+  test "lowering the limit blocks only new bots for members at or above it" do
+    creator = users(:kevin)
+    first = creator.bots.create!(name: "One")
+    second = creator.bots.create!(name: "Two")
+
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    assert_equal 2, creator.bots.count
+    assert first.update(name: "Renamed")
+    assert_not creator.bots.create(name: "Another").persisted?
+    assert users(:jz).bots.create(name: "Another member's bot").persisted?
+
+    second.destroy!
+    assert_not creator.bots.create(name: "Still at the limit").persisted?
+    first.destroy!
+    assert creator.bots.create(name: "Replacement").persisted?
+  end
+end
