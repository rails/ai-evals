+
+  test "ignores redirects, errors and non-message content types" do
+    stub_request(:post, @url).to_return({ status: 307, headers: { location: "https://other.example.test" } },
+      { status: 502, headers: { content_type: "text/html" }, body: "Bad gateway" },
+      { status: 200, headers: { content_type: "application/json" }, body: "{}" })
+    3.times { assert_nil @webhook.post(event: "mention") }
