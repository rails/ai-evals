new file mode 100644
index 0000000..d3f9e08
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,23 @@
+class Bots::MessagesController < ActionController::API
+  include BlockBannedRequests, SetCurrentRequest, VersionHeaders
+
+  before_action :authenticate_bot
+
+  def create
+    room = Current.user.rooms.find_by(id: Integer(params[:room_id], 10, exception: false))
+    return head :not_found unless room
+
+    body = request.raw_post.to_s.dup.force_encoding(Encoding::UTF_8)
+    return head :unprocessable_content unless body.valid_encoding? && body.present?
+
+    message = room.messages.create!(body: ERB::Util.html_escape(body).gsub(/\r\n?|\n/, "<br>"))
+    message.broadcast_create
+    head :created, location: message_path(message)
+  end
+
+  private
+    def authenticate_bot
+      Current.user = Bot.authenticate(request.get_header("campfire.bot_code"))
+      head :unauthorized unless Current.user
+    end
+end
