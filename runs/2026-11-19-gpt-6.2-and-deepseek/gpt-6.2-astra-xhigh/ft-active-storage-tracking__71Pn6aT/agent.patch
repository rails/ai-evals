diff --git a/app/models/storage/attachments.rb b/app/models/storage/attachments.rb
new file mode 100644
index 0000000..72184e8
--- /dev/null
+++ b/app/models/storage/attachments.rb
@@ -0,0 +1,46 @@
+# The associations supply the polymorphic type AND field name restrictions.
+# Project only ids and blob lengths, never rich text bodies or file contents.
+class Storage::Attachments
+  CANDIDATES = { "Card" => "image", "ActionText::RichText" => "embeds" }.freeze
+
+  class << self
+    def candidates
+      ActiveStorage::Attachment.where([ :record_type, :name ] => CANDIDATES.to_a)
+    end
+
+    def charges(attachment_ids)
+      scopes = [ board_embeds, card_images.joins(:board), card_embeds.joins(:board), comment_embeds.joins(card: :board) ]
+
+      scopes.flat_map do |scope|
+        scope.where(active_storage_attachments: { id: attachment_ids }).pluck(
+          "active_storage_attachments.id", "boards.account_id", "boards.id", "active_storage_blobs.byte_size"
+        ).map do |id, account_id, board_id, byte_size|
+          { id: id, account_id: account_id, board_id: board_id, byte_size: byte_size, pending: false }
+        end
+      end
+    end
+
+    def on_card(card)
+      [ card_images.where(id: card.id), card_embeds.where(id: card.id), comment_embeds.where(card_id: card.id) ].map do |scope|
+        scope.select("active_storage_attachments.id")
+      end
+    end
+
+    private
+      def board_embeds
+        Board.joins(rich_text_public_description: { embeds_attachments: :blob })
+      end
+
+      def card_images
+        Card.joins(image_attachment: :blob)
+      end
+
+      def card_embeds
+        Card.joins(rich_text_description: { embeds_attachments: :blob })
+      end
+
+      def comment_embeds
+        Comment.joins(rich_text_body: { embeds_attachments: :blob })
+      end
+  end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..3767ad9
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,55 @@
+# One charge per attachment, not per blob: a file attached to two records
+# contributes to each. Writers only mark entries pending; they never contend
+# on a shared account or board counter.
+class Storage::Entry < ApplicationRecord
+  self.table_name = "storage_entries"
+
+  scope :pending, -> { where(pending: true) }
+
+  class << self
+    def track(ids, account_id)
+      rows = ids.map { |id| { id: id, account_id: account_id, pending: true } }
+      upsert_all(rows, update_only: [ :pending ])
+    end
+
+    # Reconcile after bulk writes (e.g. imports) that bypass callbacks. Include
+    # old charges in case their attachments have already disappeared.
+    def reconcile(account)
+      where(account_id: account.id, pending: false).in_batches.update_all(pending: true)
+      Storage::Attachments.candidates.where(account: account).in_batches do |attachments|
+        track(attachments.ids, account.id)
+      end
+    end
+
+    def invalidate(attachments)
+      where(id: attachments).update_all(pending: true)
+    end
+
+    def invalidate_card(card)
+      Storage::Attachments.on_card(card).each { |attachments| invalidate(attachments) }
+    end
+
+    def refresh_pending_later
+      pending.distinct.pluck(:account_id).each { |id| Storage::RefreshJob.perform_later(id) }
+    end
+
+    def refresh_pending(account_id)
+      pending.where(account_id: account_id).in_batches(of: 100) { |batch| refresh_batch(batch) }
+    end
+
+    private
+      def refresh_batch(batch)
+        transaction do
+          # Serialize against invalidations and other workers. A write during
+          # measurement either becomes visible here or leaves the entry pending.
+          previous = batch.order(:id).lock.to_a
+          ids = previous.map(&:id)
+          current = Storage::Attachments.charges(ids)
+
+          Storage::Total.replace_charges(previous, current)
+          upsert_all(current)
+          where(id: ids - current.pluck(:id)).delete_all
+        end
+      end
+  end
+end
diff --git a/app/models/storage/total.rb b/app/models/storage/total.rb
new file mode 100644
index 0000000..61d1586
--- /dev/null
+++ b/app/models/storage/total.rb
@@ -0,0 +1,27 @@
+# Independent of the (frequently touched) board and account rows. Fold all
+# changes in a batch into at most one counter update per owner.
+class Storage::Total < ApplicationRecord
+  self.table_name = "storage_totals"
+
+  class << self
+    def replace_charges(previous, current)
+      apply_changes("Board", :board_id, previous, current)
+      apply_changes("Account", :account_id, previous, current)
+    end
+
+    private
+      def apply_changes(record_type, key, previous, current)
+        changes = Hash.new(0)
+        previous.each { |entry| changes[entry[key]] -= entry[:byte_size] if entry[key] }
+        current.each  { |entry| changes[entry[key]] += entry[:byte_size] }
+
+        changes.sort.each do |id, delta|
+          unless delta.zero?
+            total = lock.find_or_create_by!(record_type: record_type, record_id: id)
+            total.bytes_used += delta
+            total.bytes_used.zero? ? total.destroy! : total.save!
+          end
+        end
+      end
+  end
+end
