diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..05a9a17
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,153 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    Current.user = users(:david)
+  end
+
+  test "board and account usage includes only card images and board, card, and comment embeds" do
+    @card.image.attach(blob(7))
+    @board.update!(public_description: embed(11))
+    @card.update!(description: embed(13))
+    comments(:logo_1).update!(body: embed(17))
+    boards(:private).update!(public_description: embed(19))
+    users(:david).avatar.attach(blob(23))
+    blob(29) # Unattached direct upload
+    ActionText::RichText.create!(record: @board, name: "other", body: embed(31))
+
+    assert_equal 0, @board.bytes_used
+    refresh_usage
+    assert_equal 48, @board.bytes_used
+    assert_equal 19, boards(:private).bytes_used
+    assert_equal 67, @account.bytes_used
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+
+  test "refreshes independent accounts and counts attachments on drafts" do
+    @card.image.attach(blob(3))
+    other = accounts(:initech)
+    Current.with_account(other) { cards(:unfinished_thoughts).image.attach(blob(5)) }
+
+    Storage::RefreshJob.perform_now(other.id)
+    assert_equal 5, other.bytes_used
+    assert_equal 5, boards(:miltons_wish_list).bytes_used
+    assert_equal 0, @account.bytes_used
+
+    refresh_usage
+    assert_equal 3, @account.bytes_used
+    assert_equal 3, @board.bytes_used
+    assert_equal 5, other.bytes_used
+  end
+
+  test "a shared blob counts once per eligible attachment" do
+    file = blob(11)
+    @card.image.attach(file)
+    @card.update!(description: ActionText::Attachment.from_attachable(file).to_html)
+    refresh_usage
+
+    assert_equal 22, @board.bytes_used
+    @card.image.detach
+    refresh_usage
+    assert_equal 11, @account.bytes_used
+  end
+
+  test "replacing and removing files removes only the old charges" do
+    @card.image.attach(blob(5))
+    @card.update!(description: embed(7))
+    comment = comments(:logo_1)
+    comment.update!(body: embed(11))
+    refresh_usage
+    assert_equal 23, @board.bytes_used
+
+    @card.image.attach(blob(13))
+    @card.update!(description: "")
+    comment.destroy!
+    refresh_usage
+    assert_equal 13, @board.bytes_used
+
+    @card.image.purge_later
+    refresh_usage
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "detaching a collection of embeds updates usage without purging the blobs" do
+    @board.update!(public_description: embed(7) + embed(13))
+    refresh_usage
+    assert_equal 20, @board.bytes_used
+
+    @board.reload.public_description.embeds.detach
+    refresh_usage
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "moving a card transfers its image, description and comments, including changes awaiting refresh" do
+    destination = boards(:private)
+    @board.update!(public_description: embed(3))
+    @card.image.attach(blob(5))
+    @card.update!(description: embed(7))
+    comments(:logo_1).update!(body: embed(11))
+    refresh_usage
+    assert_equal 26, @board.bytes_used
+
+    comments(:logo_3).update!(body: embed(13))
+    perform_enqueued_jobs(only: Storage::RevalidateCardJob) { @card.move_to(destination) }
+    refresh_usage
+    assert_equal 3, @board.bytes_used
+    assert_equal 36, destination.bytes_used
+    assert_equal 39, @account.bytes_used
+
+    destination.destroy!
+    refresh_usage
+    assert_equal 3, @account.bytes_used
+    assert_equal 3, @board.bytes_used
+  end
+
+  test "rolled back changes and repeated jobs do not change totals" do
+    @card.image.attach(blob(7))
+    refresh_usage
+    @card.transaction do
+      @card.image.detach
+      raise ActiveRecord::Rollback
+    end
+
+    2.times { refresh_usage }
+    assert_equal 7, @board.bytes_used
+    assert_equal 7, @account.bytes_used
+  end
+
+  test "backfills bulk-inserted attachments in batches and holds totals larger than 4 GiB" do
+    rich_text = @card.description
+    rich_text.save!
+    files = Array.new(105) do
+      file = ActiveStorage::Blob.create_before_direct_upload!(filename: "video.mp4", byte_size: 5.gigabytes, checksum: "checksum")
+      { id: ActiveRecord::Type::Uuid.generate, name: "embeds", record_type: "ActionText::RichText", record_id: rich_text.id,
+        account_id: @account.id, blob_id: file.id }
+    end
+    ActiveStorage::Attachment.insert_all!(files)
+
+    2.times do
+      Storage::Entry.reconcile(@account)
+      refresh_usage
+      assert_equal 525.gigabytes, @account.bytes_used
+      assert_equal 525.gigabytes, @board.bytes_used
+    end
+  end
+
+  private
+    def refresh_usage
+      perform_enqueued_jobs(only: Storage::RefreshJob) { Storage::Entry.refresh_pending_later }
+    end
+
+    def blob(size)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("a" * size), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def embed(size)
+      ActionText::Attachment.from_attachable(blob(size)).to_html
+    end
+end
