diff --git a/docs/storage-usage.md b/docs/storage-usage.md
new file mode 100644
index 0000000..69775b7
--- /dev/null
+++ b/docs/storage-usage.md
@@ -0,0 +1,15 @@
+`Board#bytes_used` and `Account#bytes_used` return the most recently metered
+logical storage usage, in bytes (zero for an empty board or account). Each card
+image or file embedded in a board description, card description, or comment
+counts once per attachment. Avatars, variants, and unattached uploads do not
+count. Measuring uses blob lengths from the database, not the storage service.
+
+The `refresh_storage_usage` recurring task dispatches work every minute, only
+for accounts with pending changes. Each worker updates a bounded batch of
+attachment entries and their board and account totals in the same transaction.
+Reads do not traverse boards, cards, or attachments.
+
+Existing attachments are queued by the migration, and account imports queue a
+reconciliation after all records are present. If changes were made outside the
+model callbacks (for example by old processes during a rolling upgrade), queue
+a fresh measurement for the affected accounts with `Storage::Entry.reconcile(account)`.
diff --git a/lib/rails_ext/active_storage_usage_tracking.rb b/lib/rails_ext/active_storage_usage_tracking.rb
new file mode 100644
index 0000000..686d634
--- /dev/null
+++ b/lib/rails_ext/active_storage_usage_tracking.rb
@@ -0,0 +1,35 @@
+# Active Storage's purge, purge_later and single detach call delete instead of
+# destroy. Keep invalidation in the same transaction as the attachment change.
+ActiveSupport.on_load(:active_storage_attachment) do
+  after_create -> { Storage::Entry.track([ id ], account_id) }, if: :storage_candidate?
+  after_destroy -> { Storage::Entry.invalidate(id) }, if: :storage_candidate?
+
+  def delete
+    if storage_candidate?
+      transaction { super.tap { Storage::Entry.invalidate(id) } }
+    else
+      super
+    end
+  end
+
+  private
+    def storage_candidate?
+      Storage::Attachments::CANDIDATES[record_type] == name
+    end
+end
+
+# Collection detach uses delete_all, bypassing individual attachments entirely.
+module ActiveStorageTrackDetachedEmbeds
+  def detach
+    if record.is_a?(ActionText::RichText) && name == "embeds"
+      record.transaction do
+        Storage::Entry.invalidate(record.embeds_attachments.select(:id))
+        super
+      end
+    else
+      super
+    end
+  end
+end
+
+ActiveStorage::Attached::Many.prepend ActiveStorageTrackDetachedEmbeds
