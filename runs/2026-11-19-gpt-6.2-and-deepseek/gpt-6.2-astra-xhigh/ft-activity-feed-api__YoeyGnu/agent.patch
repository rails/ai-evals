index 2cd808a..d69d0e7 100644
--- a/app/models/user/timelined.rb
+++ b/app/models/user/timelined.rb
@@ -1,10 +1,19 @@
 module User::Timelined
   extend ActiveSupport::Concern
 
+  ACTIVITY_ACTIONS = (User::DayTimeline::TIMELINEABLE_ACTIONS.without("card_collection_changed") + [ "card_title_changed" ]).freeze
+
   included do
     has_many :accessible_events, through: :boards, source: :events
   end
 
+  def activities(creator_ids: nil, board_ids: nil)
+    events = accessible_events.where(action: ACTIVITY_ACTIONS)
+    events = events.where(creator_id: creator_ids) if creator_ids.present?
+    events = events.where(board_id: board_ids) if board_ids.present?
+    events.preloaded.order(created_at: :desc, id: :desc)
+  end
+
   def timeline_for(day, filter:)
     User::DayTimeline.new(self, day, filter)
   end
