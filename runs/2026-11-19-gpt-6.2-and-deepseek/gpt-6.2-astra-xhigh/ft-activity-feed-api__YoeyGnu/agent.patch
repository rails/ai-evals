new file mode 100644
index 0000000..e127697
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,24 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a paginated array of events on boards you can access, newest first. Follow the `Link` header with `rel="next"` to fetch the next page.
+
+| Query parameter | Description |
+|-----------------|-------------|
+| `creator_ids[]` | Only events performed by these users |
+| `board_ids[]` | Only events on these boards |
+
+You can repeat either parameter to include more than one ID. When you supply both filters, events must match both.
+
+Each event includes its `id`, `action`, `created_at`, plain-text `description`, `particulars`, and `url`. The `eventable_type` is `Card` or `Comment`, and `eventable` contains the corresponding [card](cards.md) or [comment](comments.md). The `board` and `creator` use the [board](boards.md) and [user](users.md) representations. The event's `url` opens the card and, for a comment, jumps to that comment.
+
+| Action | Fields in `particulars` |
+|--------|-------------------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` (array of user IDs) |
+| `card_board_changed` | `old_board`, `new_board` (board names) |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` (column name) |
+| `card_published`, `card_closed`, `card_reopened`, `card_postponed`, `card_auto_postponed`, `card_sent_back_to_triage`, `comment_created` | None (`{}`) |
+
+Missing board names, titles, and column names in `particulars` are empty strings.
diff --git a/lib/rails_ext/geared_pagination_list_parameters.rb b/lib/rails_ext/geared_pagination_list_parameters.rb
new file mode 100644
index 0000000..6d9a3f0
--- /dev/null
+++ b/lib/rails_ext/geared_pagination_list_parameters.rb
@@ -0,0 +1,12 @@
+# Geared Pagination 1.2 uses Addressable's hash of query values, which drops
+# repeated parameters such as creator_ids[] from the next-page link.
+module GearedPaginationListParameters
+  private
+    def uri(page:)
+      Addressable::URI.parse(request.url).tap do |uri|
+        uri.query = request.query_parameters.merge("page" => page).to_query
+      end
+    end
+end
+
+GearedPagination::Headers.prepend GearedPaginationListParameters
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..e3a8069
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "index returns card and comment activity with links to the timeline targets" do
+    get "#{accounts("37s").slug}/activities.json"
+    assert_response :success
+
+    activities = response.parsed_body.index_by { |activity| activity["id"] }
+    event = events(:logo_published)
+    activity = activities.fetch(event.id)
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.as_json, activity["created_at"]
+    assert_equal event.description_for(users(:david)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_url(event.card), activity["url"]
+
+    get cards_path(card_ids: [ event.card.id ], format: :json)
+    assert_equal response.parsed_body.sole, activity["eventable"]
+    get board_path(event.board, format: :json)
+    assert_equal response.parsed_body, activity["board"]
+    get user_path(event.creator, format: :json)
+    assert_equal response.parsed_body, activity["creator"]
+
+    event = events(:layout_commented)
+    activity = activities.fetch(event.id)
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(event.card, anchor: dom_id(event.eventable)), activity["url"]
+    get card_comment_path(event.card, event.eventable, format: :json)
+    assert_equal response.parsed_body, activity["eventable"]
+  end
+
+  test "index exposes only the particulars for each timeline action, including title changes" do
+    card = cards(:logo)
+    creator = users(:jz)
+    assignees = [ users(:david).id ]
+    card.track_event(:assigned, creator: creator, assignee_ids: assignees)
+    card.track_event(:unassigned, creator: creator, assignee_ids: assignees)
+    card.track_event(:board_changed, creator: creator, particulars: { old_board: "One", new_board: "Two" })
+    card.track_event(:title_changed, creator: creator, particulars: { old_title: "Original", new_title: "Revised" })
+    card.track_event(:triaged, creator: creator, particulars: { column: "In progress" })
+    card.track_event(:published, creator: creator, ignored: "detail")
+    card.track_event(:collection_changed, creator: creator)
+    card.track_event(:resumed, creator: creator)
+
+    get activities_path(format: :json, creator_ids: [ creator.id ])
+    assert_response :success
+    assert_equal({
+      "card_assigned" => { "assignee_ids" => assignees },
+      "card_unassigned" => { "assignee_ids" => assignees },
+      "card_board_changed" => { "old_board" => "One", "new_board" => "Two" },
+      "card_title_changed" => { "old_title" => "Original", "new_title" => "Revised" },
+      "card_triaged" => { "column" => "In progress" },
+      "card_published" => {}
+    }, response.parsed_body.to_h { |event| event.values_at("action", "particulars") })
+  end
+
+  test "missing board, title, and column values are empty strings" do
+    creator = users(:jz)
+    %w[ board_changed title_changed triaged ].each do |action|
+      event = cards(:logo).track_event(action, creator: creator)
+      event.update!(particulars: nil)
+    end
+
+    get activities_path(format: :json, creator_ids: [ creator.id ])
+    assert_response :success
+    assert_equal({
+      "card_board_changed" => { "old_board" => "", "new_board" => "" },
+      "card_title_changed" => { "old_title" => "", "new_title" => "" },
+      "card_triaged" => { "column" => "" }
+    }, response.parsed_body.to_h { |event| event.values_at("action", "particulars") })
+  end
+
+  test "filters intersect with the current user's accessible boards" do
+    private_board = boards(:private)
+    with_current_user(:kevin) do
+      private_board.cards.create!(title: "Private card", status: "published")
+    end
+    cards(:radio).track_event(:published, creator: users(:mike)) # In a different account
+
+    get activities_path(format: :json)
+    assert_equal [ boards(:writebook).id ], response.parsed_body.map { |event| event.dig("board", "id") }.uniq
+
+    get activities_path(format: :json, board_ids: [ private_board.id, boards(:miltons_wish_list).id ])
+    assert_equal [], response.parsed_body
+
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ], board_ids: [ private_board.id, boards(:writebook).id ])
+    assert_equal events(:shipping_closed, :text_published, :shipping_published).map(&:id).sort, response.parsed_body.pluck("id").sort
+  end
+
+  test "next page links preserve filters and newest-first order" do
+    freeze_time do
+      16.times { cards(:layout).comments.create!(creator: users(:david), body: "Another comment") }
+    end
+    creator_ids = [ users(:david).id, users(:kevin).id ]
+    expected_ids = boards(:writebook).events.where(creator_id: creator_ids).order(created_at: :desc, id: :desc).ids
+
+    get activities_path(format: :json, creator_ids: creator_ids)
+    assert_response :success
+    ids = response.parsed_body.pluck("id")
+    next_url = response.headers["Link"][/<([^>]+)>; rel="next"/, 1]
+    get next_url
+    assert_response :success
+    assert_nil response.headers["Link"]
+    assert_equal expected_ids, ids + response.parsed_body.pluck("id")
+  end
+end
