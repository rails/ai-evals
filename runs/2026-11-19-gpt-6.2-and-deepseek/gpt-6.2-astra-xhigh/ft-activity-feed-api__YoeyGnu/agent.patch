+++ b/app/models/event/particulars.rb
@@ -8,4 +8,28 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def change_detail(key)
+    particulars&.dig("particulars", key)
+  end
+
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { "assignee_ids" => Array(assignee_ids) }
+    when "card_board_changed"
+      change_details_for("old_board", "new_board")
+    when "card_title_changed"
+      change_details_for("old_title", "new_title")
+    when "card_triaged"
+      change_details_for("column")
+    else
+      {}
+    end
+  end
+
+  private
+    def change_details_for(*keys)
+      keys.index_with { |key| change_detail(key).to_s }
+    end
 end
