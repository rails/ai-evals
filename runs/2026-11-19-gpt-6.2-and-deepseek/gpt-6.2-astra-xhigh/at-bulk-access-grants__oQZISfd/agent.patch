+  private
+    def rejected_index(candidates)
+      existing = @book.accesses.where(user_id: candidates.map(&:user_id))
+      # Check against this transaction's view, not a roster cached before it began.
+      seen = Access.uncached { existing.pluck(:user_id).to_set }
+      ActiveRecord::Associations::Preloader.new(records: candidates, associations: :user).call
