+
+  test "ascending ID collections retain their records, serializers, scopes and filters" do
+    agent = user("Sam", "agent")
+    other_agent = user("Lee", "agent")
+    groups = %w[Billing Technical].map { |name| @account.groups.create!(name: name) }
