+class AddCursorPaginationIndexes < ActiveRecord::Migration[8.1]
+  disable_ddl_transaction!
+
+  def change
+    # The staff activity feed spans requesters. Portal activity and comment
+    # threads already have indexes ending in their (timestamp, id) keys.
+    add_index :tickets, [:updated_at, :id], algorithm: :concurrently
+    add_index :users, [:account_id, :id], algorithm: :concurrently
+    add_index :groups, [:account_id, :id], algorithm: :concurrently
+    add_index :invitations, [:account_id, :id], algorithm: :concurrently
+    add_index :group_memberships, [:group_id, :id], algorithm: :concurrently
+    add_index :group_memberships, [:user_id, :id], algorithm: :concurrently
+  end
+end
