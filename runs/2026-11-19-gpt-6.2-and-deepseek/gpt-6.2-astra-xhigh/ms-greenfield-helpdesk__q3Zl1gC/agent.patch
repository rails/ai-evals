new file mode 100644
index 0000000..f25ae38
--- /dev/null
+++ b/app/models/ticket.rb
@@ -0,0 +1,102 @@
+class Ticket < ApplicationRecord
+  STATUSES = %w[open pending solved closed].freeze
+  PRIORITIES = %w[normal high].freeze
+
+  belongs_to :requester, class_name: "User", inverse_of: :requests
+  belongs_to :group, optional: true
+  belongs_to :assignee, class_name: "User", optional: true
+  belongs_to :merged_into, class_name: "Ticket", optional: true
+  has_many :comments, inverse_of: :ticket
+
+  validates :subject, presence: true
+  validates :status, inclusion: { in: STATUSES }
+  validates :merged_into_id, presence: true, if: :closed?
+  validates :priority, inclusion: { in: PRIORITIES }
+  before_create { self.public_updated_at = updated_at || Time.current }
+
+  scope :recently_active, -> { order(updated_at: :desc, id: :desc) }
+  scope :recently_publicly_active, -> { order(public_updated_at: :desc, id: :desc) }
+
+  scope :matching_text, ->(text) {
+    where(<<~SQL, pattern: "%#{sanitize_sql_like(text)}%")
+      tickets.subject ILIKE :pattern OR EXISTS (
+        SELECT 1 FROM comments
+        WHERE comments.ticket_id = tickets.id AND comments.public AND comments.body ILIKE :pattern
+      )
+    SQL
+  }
+
+  def closed? = status == "closed"
+
+  def merge_into!(target, author:, source_comment: {}, target_comment: {})
+    transaction do
+      # Check both current states under lock, in the same order even for A→B and B→A.
+      [self, target].sort_by(&:id).each do |ticket|
+        ticket.lock!
+        ticket.ensure_editable!
+      end
+      if self == target || requester_id != target.requester_id
+        errors.add(:merged_into, "must be a different ticket from the same customer")
+        raise ActiveRecord::RecordInvalid.new(self)
+      end
+
+      now = Time.current
+      update!(status: "closed", merged_into: target, updated_at: now, public_updated_at: now)
+      add_merge_note!(author, "Merged into ticket ##{target.id}.", source_comment)
+      note = target.add_merge_note!(author, "Ticket ##{id} was merged into this ticket.", target_comment)
+      note.public? ? target.touch(:public_updated_at) : target.touch
+    end
+  end
+
+  def update_conversation!(author:, changes:, comment:)
+    with_lock do
+      ensure_editable!
+      if author.customer? && changes.key?(:status) && changes[:status] != "solved"
+        errors.add(:status, "must be solved when set by a customer")
+        raise ActiveRecord::RecordInvalid.new(self)
+      end
+
+      assign_attributes(changes)
+      reconcile_assignment(changes) if changes.key?(:group) || changes.key?(:assignee)
+      self.status = "open" if author.customer? && comment && !changes.key?(:status)
+      now = Time.current
+      self.public_updated_at = now if will_save_change_to_status? || comment&.fetch(:public)
+      self.updated_at = now if comment || changed?
+      save!
+      comments.create!(**comment, author: author) if comment
+    end
+  end
+
+  def details
+    slice(:id, :subject, :status, :merged_into_id, :requester_id, :created_at, :updated_at)
+  end
+
+  protected
+
+  def add_merge_note!(author, default_body, overrides)
+    comments.create!(body: default_body, public: false, **overrides, author: author, suppress_email: true)
+  end
+
+  def ensure_editable!
+    return unless closed?
+    errors.add(:base, "Closed tickets cannot be changed")
+    raise ActiveRecord::RecordInvalid.new(self)
+  end
+
+  private
+
+  # Run under the ticket lock, distinguishing omitted fields from explicit nulls.
+  def reconcile_assignment(changes)
+    if changes.key?(:group) && !group_id
+      self.assignee = nil
+    elsif assignee_id && !group_id
+      self.group_id = assignee.group_memberships.where(default: true).pick(:group_id)
+    elsif group_id && assignee_id && !GroupMembership.exists?(group_id: group_id, user_id: assignee_id)
+      if changes.key?(:assignee)
+        errors.add(:assignee, "must belong to the ticket's group")
+        raise ActiveRecord::RecordInvalid.new(self)
+      end
+      self.assignee = nil
+    end
+  end
+end
diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..143ac17
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,86 @@
+class User < ApplicationRecord
+  STAFF_ROLES = %w[admin agent member].freeze
+  ROLES = (STAFF_ROLES + %w[customer]).freeze
+
+  belongs_to :account
+  has_many :sessions, dependent: :delete_all
+  has_many :group_memberships
+  has_many :groups, through: :group_memberships
+  has_many :requests, class_name: "Ticket", foreign_key: :requester_id, inverse_of: :requester
+  has_many :assigned_tickets, class_name: "Ticket", foreign_key: :assignee_id
+  has_secure_password reset_token: false
+
+  normalizes :name, with: ->(value) { value.strip }
+  normalizes :email, with: ->(value) { value.strip.downcase }
+  validates :name, presence: true, length: { maximum: 255 }
+  validates :email, format: { with: URI::MailTo::EMAIL_REGEXP }, length: { maximum: 254 },
+    uniqueness: { scope: :account_id }
+  validates :role, inclusion: { in: ROLES }
+  validates :password, length: { minimum: 8 }, allow_nil: true
+
+  validate :email_not_reserved, on: :create, if: :customer?
+  validate :keep_active_admin, if: -> { will_save_change_to_suspended?(to: true) && admin? && verified? }
+
+  after_update :clear_suspended_access, if: -> { saved_change_to_suspended?(to: true) }
+  before_update :clear_reset_link, if: :will_save_change_to_password_digest?
+  after_update :revoke_sessions, if: :saved_change_to_password_digest?
+
+  scope :active, -> { where(verified: true, suspended: false) }
+  scope :available_staff, -> { active.where(role: STAFF_ROLES) }
+
+  scope :with_verification_token, ->(token) {
+    where(verification_token_digest: OpaqueToken.digest(token)).where("verification_expires_at > ?", Time.current)
+  }
+  scope :with_reset_token, ->(token) {
+    where(reset_token_digest: OpaqueToken.digest(token)).where("reset_expires_at > ?", Time.current)
+  }
+
+  def admin? = role == "admin"
+  def staff? = STAFF_ROLES.include?(role)
+  def customer? = role == "customer"
+
+  def send_verification!
+    token = OpaqueToken.generate
+    update!(verification_token_digest: OpaqueToken.digest(token), verification_expires_at: 24.hours.from_now)
+    ActiveRecord.after_all_transactions_commit { UserMailer.verification(self, token).deliver_now }
+  end
+
+  def verify!
+    update!(verified: true, verification_token_digest: nil, verification_expires_at: nil)
+  end
+
+  def send_password_reset!
+    token = OpaqueToken.generate
+    update!(reset_token_digest: OpaqueToken.digest(token), reset_expires_at: 1.hour.from_now)
+    ActiveRecord.after_all_transactions_commit { UserMailer.password_reset(self, token).deliver_now }
+  end
+
+  def details
+    slice(:id, :account_id, :name, :email, :role, :verified, :suspended, :created_at, :updated_at)
+  end
+
+  private
+
+  def email_not_reserved
+    errors.add(:email, "has a pending invitation") if account && account.invitations.pending.exists?(email: email)
+  end
+
+  def keep_active_admin
+    unless account.users.active.where(role: "admin").where.not(id: id).exists?
+      errors.add(:base, "Cannot suspend the last active admin")
+    end
+  end
+
+  def clear_suspended_access
+    revoke_sessions
+    assigned_tickets.update_all(assignee_id: nil, updated_at: Time.current)
+  end
+
+  def clear_reset_link
+    self.reset_token_digest = self.reset_expires_at = nil
+  end
+
+  def revoke_sessions
+    sessions.delete_all
+  end
+end
diff --git a/app/services/cursor_page.rb b/app/services/cursor_page.rb
new file mode 100644
index 0000000..2c8cbaa
--- /dev/null
+++ b/app/services/cursor_page.rb
@@ -0,0 +1,69 @@
+# A bounded window over an already authorized, filtered and ordered relation.
+# All sort components have the same direction and the last component is unique.
+class CursorPage
+  attr_reader :records, :has_more
+
+  def initialize(scope, columns:, descending:, backwards:, size:, cursor:)
+    @scope = scope
+    @columns = columns
+    @descending = descending
+    @backwards = backwards
+    table = scope.model.quoted_table_name
+    @key_sql = columns.map { |column| "#{table}.#{scope.model.adapter_class.quote_column_name(column)}" }.join(", ")
+
+    if cursor
+      @upper = cursor.fetch("upper")
+      window = seek(cursor.fetch("position"), backwards)
+    else
+      window = first_window
+    end
+    window = window.reverse_order if backwards
+    rows = window.limit(size + 1).to_a
+    @has_more = rows.size > size
+    @records = rows.first(size)
+    @records.reverse! if backwards
+    @upper ||= key(records.first) if records.any?
+
+    # Recheck the opposite side: even the incoming cursor's row may be gone.
+    @has_return_page = cursor && records.any? && seek(key(backwards ? records.last : records.first), !backwards).exists?
+  end
+
+  def next? = @backwards ? @has_return_page : has_more
+  def prev? = @backwards ? has_more : @has_return_page
+
+  def boundary(record)
+    { position: key(record), upper: @upper } if record
+  end
+
+  private
+
+  def first_window
+    # On newest-first feeds the first returned row itself supplies the ceiling.
+    return @scope if @descending
+    highest = @scope.reverse_order.pick(*@columns)
+    return @scope.none unless highest
+    @upper = encode_key(Array(highest))
+    bounded_scope
+  end
+
+  def key(record) = encode_key(@columns.map { |column| record[column] })
+
+  # The default JSON time precision is milliseconds; Postgres keys have microseconds.
+  def encode_key(values) = values.map { |v| v.is_a?(Time) ? v.utc.iso8601(6) : v }
+
+  def bounded_scope = compare(@scope, "<=", @upper)
+
+  def seek(position, backwards)
+    if @descending == backwards # moving toward greater keys
+      compare(bounded_scope, ">", position)
+    else
+      # Position is already at or below the ceiling. Seek directly from it.
+      compare(@scope, "<", position)
+    end
+  end
+
+  def compare(scope, operator, values)
+    binds = Array.new(@columns.size, "?").join(", ")
+    scope.where("(#{@key_sql}) #{operator} (#{binds})", *values)
+  end
+end
