--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,32 @@
+class Account < ApplicationRecord
+  RETENTION = 90.days
+
+  has_many :users, dependent: :delete_all
+  has_many :sessions, through: :users
+
+  normalizes :subdomain, with: ->(value) { value.strip.downcase }
+  normalizes :name, with: ->(value) { value.strip }
+  validates :name, presence: true, length: { maximum: 255 }
+  validates :subdomain, uniqueness: true, length: { maximum: 63 },
+    format: { with: /\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z/ }
+
+  def cancelled? = cancelled_at.present?
+  def retention_elapsed? = cancelled? && cancelled_at <= RETENTION.ago
+
+  def cancel!
+    transaction do
+      update!(cancelled_at: Time.current)
+      Session.where(user_id: users.select(:id)).delete_all
+    end
+  end
+
+  def self.purge_cancelled!
+    # Keep the deadline predicate on the DELETE itself (even if reactivation
+    # races a cleanup batch). Foreign keys cascade to all tenant data.
+    where(cancelled_at: ..RETENTION.ago).in_batches.delete_all
+  end
+
+  def details
+    slice(:id, :name, :subdomain, :created_at, :updated_at, :cancelled_at)
+  end
+end
