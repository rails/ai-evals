@@ -0,0 +1,56 @@
+require "test_helper"
+
+class BookSearchRateLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    @handbook, @manual = books(:handbook, :manual)
+    [ @handbook, @manual ].each { |book| book.update!(published: true) }
+    Leaf.reindex_all
+    freeze_time
+  end
+
+  test "a reader's search quota is shared across books but not with other readers or page views" do
+    reader = "192.0.2.1"
+    30.times do
+      search @manual, from: reader
+      assert_response :success
+    end
+
+    reset! # A new session at the same address doesn't reset the quota.
+    assert_no_queries_match(/leaf_search_index/) { search @handbook, from: reader }
+    assert_response :too_many_requests
+
+    get leafable_slug_path(leaves(:welcome_page)), headers: { "REMOTE_ADDR" => reader }
+    assert_response :success
+
+    search @handbook, from: "192.0.2.2"
+    assert_response :success
+    assert_select "a", text: /Thanks for reading/i
+  end
+
+  test "search quota returns as individual requests age out of the last minute" do
+    reader = "192.0.2.3"
+    search @handbook, from: reader
+    assert_response :success
+
+    travel 50.seconds
+    29.times do
+      search @handbook, from: reader
+      assert_response :success
+    end
+
+    travel 11.seconds
+    search @handbook, from: reader
+    assert_response :success
+    search @handbook, from: reader
+    assert_response :too_many_requests
+
+    travel 1.minute
+    search @handbook, from: reader
+    assert_response :success
+  end
+
+  private
+    def search(book, from:)
+      post book_search_path(book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => from }
+    end
+end
