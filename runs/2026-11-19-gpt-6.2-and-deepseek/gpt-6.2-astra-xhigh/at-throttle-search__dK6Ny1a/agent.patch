diff --git a/app/models/book/search_quota.rb b/app/models/book/search_quota.rb
new file mode 100644
index 0000000..475b190
--- /dev/null
+++ b/app/models/book/search_quota.rb
@@ -0,0 +1,19 @@
+module Book::SearchQuota
+  # Production uses shared Redis; keep the quota active when application caching is disabled locally.
+  STORE = Rails.cache.is_a?(ActiveSupport::Cache::NullStore) ? ActiveSupport::Cache::MemoryStore.new : Rails.cache
+
+  def self.claim(address)
+    # Expire each accepted search separately so the quota rolls rather than resetting all at once.
+    slots = Array.new(30) { |i| "book-search:#{address}:#{i}" }
+
+    # On Redis, rule out occupied slots in one round trip before trying to claim one atomically.
+    if STORE.is_a?(ActiveSupport::Cache::RedisCacheStore)
+      slots -= STORE.read_multi(*slots, raw: true).keys
+    end
+
+    slots.any? do |slot|
+      # False means occupied. A nil (cache unavailable) shouldn't lock readers out.
+      STORE.write(slot, 1, unless_exist: true, expires_in: 1.minute, raw: true) != false
+    end
+  end
+end
