+  <% if @error %>
+    <div class="errors" role="alert"><strong>Import error:</strong> <%= @error %></div>
+  <% end %>
+  <div class="buttons">
+    <%= form.submit "Import", class: "btn btn--pink" %>
+    <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+  </div>
+<% end %>
