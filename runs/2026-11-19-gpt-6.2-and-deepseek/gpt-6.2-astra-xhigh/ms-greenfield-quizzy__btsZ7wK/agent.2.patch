diff --git a/test/services/quiz_document_test.rb b/test/services/quiz_document_test.rb
new file mode 100644
index 0000000..e118cbb
--- /dev/null
+++ b/test/services/quiz_document_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class QuizDocumentTest < ActiveSupport::TestCase
+  def valid_question
+    { text: "Pick one", options: [{ text: "A" }, { text: "B", correct: true }] }
+  end
+
+  test "defaults missing booleans, drops empty form rows and imports only quiz contents" do
+    original = Quiz.create!(title: "Sessions")
+    document = { id: original.id, title: original.title, questions: [
+      { text: "Pick two", options: [
+        { text: " ", correct: true }, { text: "C", correct: true },
+        { text: "B", correct: true, votes: 3 }, { text: "A" }
+      ] }
+    ] }
+    copy = QuizDocument.import!(JSON.generate(document))
+    refute_equal original.id, copy.id
+    assert_empty original.questions
+    question = copy.questions.sole
+    assert_predicate question, :active?
+    assert_equal [
+      { "text" => "C", "correct" => true }, { "text" => "B", "correct" => true }, { "text" => "A", "correct" => false }
+    ], question.options
+  end
+
+  test "can transfer an empty quiz" do
+    document = { "title" => "Coming soon", "questions" => [] }
+    quiz = QuizDocument.import!(JSON.generate(document))
+    assert_equal document, JSON.parse(QuizDocument.export(quiz))
+  end
+
+  test "requires a JSON quiz object with a nonblank string title and an array of questions" do
+    invalid = ["", "not JSON", "null", "[]", "{}", '{"title":"Talk"}',
+      '{"title":"","questions":[]}', '{"title":42,"questions":[]}', '{"title":"Talk","questions":{}}']
+    invalid.each { |json| assert_rejected(json) }
+  end
+
+  test "rejects invalid question and option data without keeping earlier questions" do
+    [nil, {}, valid_question.merge(text: []), valid_question.merge(text: "\n"),
+      valid_question.merge(options: nil), valid_question.merge(options: [nil]),
+      valid_question.merge(options: [{ text: 12 }]), valid_question.merge(active: "false"),
+      valid_question.merge(active: nil), valid_question.merge(options: [{ text: "A", correct: 1 }, { text: "B" }]),
+      valid_question.merge(options: [{ text: "A" }, { text: "B" }])].each do |invalid_question|
+      assert_rejected(JSON.generate(title: "Sessions", questions: [valid_question, invalid_question]))
+    end
+  end
+
+  private
+    def assert_rejected(json)
+      assert_no_difference ["Quiz.count", "Question.count"], json do
+        assert_raises(QuizDocument::Invalid) { QuizDocument.import!(json) }
+      end
+    end
+end
diff --git a/test/system/quiz_transfer_test.rb b/test/system/quiz_transfer_test.rb
new file mode 100644
index 0000000..52eca2f
--- /dev/null
+++ b/test/system/quiz_transfer_test.rb
@@ -0,0 +1,53 @@
+require "application_system_test_case"
+
+class QuizTransferTest < ApplicationSystemTestCase
+  test "copy an ordered export and import it as a separate quiz" do
+    quiz = Quiz.create!(title: "Frontend Fest 2026")
+    options = [{ "text" => "418", "correct" => false }, { "text" => "429", "correct" => true }]
+    first = quiz.questions.create!(body: 'What means "Too Many Requests"?', options: options)
+    second = quiz.questions.create!(body: "What does </pre> mean?", active: false, options: options.reverse)
+    second.move(:up)
+
+    visit moderate_quiz_path(quiz)
+    click_link "Export"
+    assert_selector "pre", count: 1
+    document = find("pre").text
+    assert_equal({ "title" => quiz.title, "questions" => [
+      { "text" => second.body, "active" => false, "options" => options.reverse },
+      { "text" => first.body, "active" => true, "options" => options }
+    ] }, JSON.parse(document))
+
+    visit moderate_root_path
+    click_button "Import quiz"
+    fill_in "Quiz JSON", with: document
+    click_button "Import", exact: true
+    assert_selector "h1", exact_text: quiz.title
+    copy = Quiz.where.not(id: quiz.id).sole
+    assert_current_path moderate_quiz_path(copy)
+    assert_equal [second.body, first.body], all(".question-item__body").map(&:text)
+    click_link "Export"
+    assert_equal document, find("pre").text
+  end
+
+  test "failed imports show an error and keep the document for correction" do
+    question = { text: "Choose", options: [{ text: "A", correct: true }, { text: "B" }] }
+    bad_question = { text: "Choose again", options: [{ text: "B" }, { text: "", correct: true }] }
+    document = { title: "Workshops", questions: [question, bad_question] }
+    json = JSON.pretty_generate(document)
+
+    visit new_moderate_import_path
+    fill_in "Quiz JSON", with: json
+    click_button "Import", exact: true
+    assert_selector "[role=alert]", text: "Question 2: Add at least two options"
+    assert_text "Mark at least one option as correct"
+    assert_field "Quiz JSON", with: json
+    assert_empty Quiz.all
+    assert_empty Question.all
+
+    bad_question[:options][1][:text] = "C"
+    fill_in "Quiz JSON", with: JSON.pretty_generate(document)
+    click_button "Import", exact: true
+    assert_selector "h1", exact_text: "Workshops"
+    assert_text "2 of 2 questions active"
+  end
+end
