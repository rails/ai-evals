diff --git a/app/jobs/finish_question_job.rb b/app/jobs/finish_question_job.rb
new file mode 100644
index 0000000..1a35c38
--- /dev/null
+++ b/app/jobs/finish_question_job.rb
@@ -0,0 +1,15 @@
+class FinishQuestionJob < ActiveJob::Base
+  retry_on ActiveRecord::StatementTimeout, ActiveRecord::ConnectionTimeoutError, wait: 1.second, attempts: :unlimited
+
+  def perform(game_id, number)
+    game = Game.find_by(id: game_id)
+    return unless game && game.number == number && (deadline = game.question_deadline)
+
+    if Time.current >= deadline
+      game.advance("finish", from: number.to_s)
+    else
+      # A clock adjustment can make the scheduled wake-up early.
+      game.schedule_question_finish
+    end
+  end
+end
