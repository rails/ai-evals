-# The public stream only signals that the stage has changed. Identity, picks,
-# unrevealed answers and moderator controls never travel on this channel.
+# The only shared HTML is the newly opened, unanswered question. Personal
+# results, existing picks and moderator controls are fetched over scoped HTTP.
 class GameChannel < ActionCable::Channel::Base
+  def self.stage_changed(game)
+    message = if game.open?
+      html = PlayController.render(partial: "play/question_stage",
+        assigns: { game: game, question: game.current_question, version: game.stage_version },
+        locals: { authenticity_token: false })
+      { number: game.number, question_html: html }
+    else
+      "refresh"
+    end
+    broadcast_to(game, message)
+  end
+
   def subscribed
     @game = Game.find_by(code: params[:code])
     @tab = params[:tab]
