+<section data-version="<%= @version %>" data-phase="<%= @game.phase %>" data-number="<%= @game.number %>">
+  <p class="play-question__num">Question <%= @game.number %> of <%= @game.question_count %></p>
+  <h1 class="play-question__body"><%= @question.body %></h1>
+  <% if @game.closed? %>
+    <% if @choice.nil? %>
+      <p class="play-status play-status--neutral" role="status">No answer</p>
+    <% elsif @question.options.fetch(@choice)['correct'] %>
+      <p class="play-status play-status--right" role="status">Correct!</p>
+    <% else %>
+      <p class="play-status play-status--wrong" role="status">Wrong!</p>
+    <% end %>
+  <% end %>
+  <%= form_with url: answer_play_path(@game.code), authenticity_token: local_assigns.fetch(:authenticity_token, true) do |f| %>
+    <%= f.hidden_field :question_id, value: @question.id %>
+    <ol class="play-options <%= 'is-locked' if @game.closed? %>">
+      <% @question.options.each_with_index do |option, i| %>
+        <li>
+          <button type="submit" name="choice" aria-label="<%= option['text'] %>" value="<%= i %>" class="play-option <%= 'is-picked' if i == @choice %>" aria-pressed="<%= i == @choice %>" <%= 'disabled' if @game.closed? %>>
+            <span class="play-option__letter" aria-hidden="true"><%= option_letter(i) %></span>
+            <span class="play-option__title"><%= option['text'] %></span>
+            <% if i == @choice %><span class="play-option__mark">Your answer</span><% end %>
+          </button>
+        </li>
+      <% end %>
+    </ol>
+  <% end %>
+</section>
