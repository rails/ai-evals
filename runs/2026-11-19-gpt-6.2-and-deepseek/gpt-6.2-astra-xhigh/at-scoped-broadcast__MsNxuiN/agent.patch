+  test "editing indicators only go to editors who still have access when the save is broadcast" do
+    leaf = leaves(:welcome_page)
+    removed_editor_stream = editing_indicator_stream(leaf)
+
+    sign_in :jason
+    remaining_editor_stream = editing_indicator_stream(leaf)
+    other_page_stream = editing_indicator_stream(leaves(:summary_page))
+
+    sign_in :david
+    put leafable_path(leaf), params: { page: { body: "Updated welcome" } }
+    assert_response :no_content
+
+    accesses(:kevin_handbook).destroy!
+    messages = capture_broadcasts(remaining_editor_stream) { perform_enqueued_jobs }
+
+    assert_no_broadcasts removed_editor_stream
+    assert_no_broadcasts other_page_stream
+    assert_no_broadcasts "#{leaf.to_gid_param}:being_edited"
+    indicator = Nokogiri::HTML5.fragment(messages.sole)
+    assert_select indicator, "turbo-stream[action=append][target=?]", "being_edited_leaf_#{leaf.id}" do
+      assert_select "strong", text: users(:david).name
+    end
+  end
+
   private
+    def editing_indicator_stream(leaf)
+      get edit_leafable_path(leaf)
+      assert_response :success
+      source = assert_select("turbo-cable-stream-source", count: 1).first
+      Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    end
+
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
     end
