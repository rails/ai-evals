diff --git a/app/models/concerns/profile_image_attachment.rb b/app/models/concerns/profile_image_attachment.rb
new file mode 100644
index 0000000..b226bde
--- /dev/null
+++ b/app/models/concerns/profile_image_attachment.rb
@@ -0,0 +1,102 @@
+# The profile_image column remains a CarrierWave identifier until a later backfill.
+# Never write an Active Storage key into it, or move/remove its file on replacement.
+module ProfileImageAttachment
+  extend ActiveSupport::Concern
+  include Images::Profile.for(:profile_image_url)
+
+  included do
+    has_one_attached :profile_image_file
+    validate :validate_profile_image_upload
+    before_save :track_profile_image_change
+    after_destroy_commit { legacy_profile_image.remove! }
+  end
+
+  # Preserve the uploader's public URL, string and JSON interfaces for views,
+  # mail, serializers and cached article entities.
+  AttachedImage = Data.define(:blob) do
+    def url
+      return unless blob.persisted?
+
+      URL.url(Rails.application.routes.url_helpers.profile_image_blob_path(blob.signed_id, blob.filename))
+    end
+
+    delegate :to_s, to: :url
+
+    def as_json(*)
+      { "url" => url }
+    end
+  end
+
+  def profile_image
+    return AttachedImage.new(profile_image_file.blob) if profile_image_file.attached?
+
+    legacy_profile_image
+  end
+
+  def profile_image?
+    profile_image.present?
+  end
+
+  delegate :url, to: :profile_image, prefix: true
+
+  def profile_image=(file)
+    return if file.blank?
+
+    unless file.respond_to?(:read)
+      @profile_image_error = I18n.t("concerns.image_uploads.is_not_file")
+      return
+    end
+
+    assign_profile_image { |processor| processor.cache!(file) }
+  end
+
+  def reload(...)
+    super.tap do
+      @profile_image_error = @remote_profile_image_url = @saving_profile_image = nil
+    end
+  end
+
+  attr_reader :remote_profile_image_url
+
+  def remote_profile_image_url=(source)
+    return if source.blank?
+
+    if source.is_a?(String)
+      @remote_profile_image_url = source
+      assign_profile_image { |processor| processor.download!(source) }
+    else
+      self.profile_image = source # generated fallback image
+    end
+  end
+
+  private
+
+  def legacy_profile_image
+    ProfileImageUploader.new(self, :profile_image).tap do |uploader|
+      identifier = self[:profile_image] if has_attribute?(:profile_image)
+      uploader.retrieve_from_store!(identifier) if identifier.present?
+    end
+  end
+
+  def assign_profile_image(&block)
+    @profile_image_error = nil
+    self.profile_image_file = Images::PrepareProfileImage.call(self, &block)
+  rescue CarrierWave::UploadError => e
+    @profile_image_error = e.message
+  end
+
+  def validate_profile_image_upload
+    errors.add(:profile_image, @profile_image_error) if @profile_image_error
+  end
+
+  # Active Storage clears attachment_changes on commit. Keep the signal for
+  # the owner's after_commit cache callbacks, but not for later saves/touches.
+  def track_profile_image_change
+    @saving_profile_image = attachment_changes.key?("profile_image_file")
+    self.class.current_transaction.after_commit { @saving_profile_image = false } if @saving_profile_image
+  end
+
+  def saved_profile_image_change?
+    @saving_profile_image || saved_change_to_profile_image?
+  end
+end
