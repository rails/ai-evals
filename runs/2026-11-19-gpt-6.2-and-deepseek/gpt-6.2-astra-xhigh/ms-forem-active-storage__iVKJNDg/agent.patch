+require "rails_helper"
+
+RSpec.describe ActiveStorage::Service::ForemS3Service do
+  let(:bucket) { "profile-images" }
+  let(:credentials) { { aws_access_key_id: "example", aws_secret_access_key: "example" } }
+  let(:service) { described_class.new(bucket: bucket, **credentials) }
+
+  around do |example|
+    Fog.mock!
+    Fog::AWS::Storage.new(credentials).put_bucket(bucket)
+    example.run
+  ensure
+    Fog.unmock!
+  end
+
+  it "round trips image data for the blob proxy and deletes only its own objects" do
+    io = StringIO.new("profile picture".b)
+    service.upload("picture", io, checksum: Digest::MD5.base64digest(io.string), content_type: "image/png")
+    expect(service.exist?("picture")).to be(true)
+    expect(service.download("picture")).to eq(io.string)
+    expect { |b| service.download("picture", &b) }.to yield_with_args(io.string)
+    expect(service.download_chunk("picture", 0...3)).to eq("pro")
+
+    service.upload("variants/picture/one", StringIO.new("variant"))
+    service.delete_prefixed("variants/picture/")
+    expect(service.exist?("variants/picture/one")).to be(false)
+    expect(service.exist?("picture")).to be(true)
+    service.delete("picture")
+    expect { service.download("picture") }.to raise_error(ActiveStorage::FileNotFoundError)
+  end
+end
