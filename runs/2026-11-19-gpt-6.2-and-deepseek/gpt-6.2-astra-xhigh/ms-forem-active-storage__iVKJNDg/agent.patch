+  it "serves the stored image without authentication or an expiring service URL" do
+    user = create(:user)
+    get URI(user.profile_image_url).request_uri
+
+    expect(response).to have_http_status(:ok)
+    expect(response.media_type).to eq("image/jpeg")
+    expect(response.body.b).to eq(user.profile_image_file.download)
+  end
+
+  %i[user organization].each do |factory|
+    it "serves published #{factory} URLs after source retirement, independently of the current picture" do
+      owner = create(factory)
+      legacy = ProfileImageUploader.new(owner, :profile_image)
+      image.open { |file| legacy.store!(file) }
+      owner.update_column(:profile_image, legacy.identifier)
+      old_path = URI(legacy.url).path
+      Images::CopyProfileImage.call(owner.class, owner.id, legacy.identifier) { legacy.read }
+      legacy.remove!
+
+      get api_profile_image_path(owner.username)
+      expect(response.parsed_body.fetch("profile_image")).to eq(owner.profile_image_url)
+      expect(owner.profile_image_url).not_to include(old_path)
+      [old_path, "/remoteimages#{old_path}"].each do |path|
+        get path
+        expect(response).to have_http_status(:ok)
+        expect(response.media_type).to eq("image/png")
+        expect(response.body.b).to eq(image.binread)
+      end
+      get File.join(File.dirname(old_path), "unknown.png")
+      expect(response).to have_http_status(:not_found)
+    ensure
+      legacy&.remove!
+    end
+  end
+end
