@@ -0,0 +1,169 @@
+require "rails_helper"
+
+RSpec.describe "profile_images:copy", type: :task do
+  let(:image) { Rails.root.join("spec/fixtures/files/800x600.png") }
+  let(:uploads) { [] }
+
+  def copy
+    task = Rake::Task["profile_images:copy"]
+    task.reenable
+    task.invoke
+  end
+
+  def store_legacy_image(owner)
+    ProfileImageUploader.new(owner, :profile_image).tap do |upload|
+      image.open { |file| upload.store!(file) }
+      uploads << upload
+      owner.update_column(:profile_image, upload.identifier)
+    end
+  end
+
+  after { uploads.each(&:remove!) }
+
+  %i[user organization].each do |factory|
+    it "copies a legacy #{factory} once and preserves the previously published file", :aggregate_failures do
+      owner = create(factory)
+      owner.profile_image_file.purge
+      legacy = store_legacy_image(owner)
+      expect(owner.reload.profile_image_url).to eq(legacy.url)
+
+      expect { copy }.to change(ActiveStorage::Attachment, :count).by(1)
+      file = owner.reload.profile_image_file
+      expect(file.download).to eq(image.binread)
+      expect(file.filename.to_s).to eq(legacy.identifier)
+      expect(file.content_type).to eq("image/png")
+      url = owner.profile_image_url
+      expect(url).to include("/rails/active_storage/blobs/proxy/")
+      expect(owner[:profile_image]).to eq(legacy.identifier)
+      expect(legacy.read).to eq(image.binread)
+
+      expect { copy }.not_to change(ActiveStorage::Blob, :count)
+      expect(owner.reload.profile_image_url).to eq(url)
+    end
+  end
+
+  it "refreshes cached feed avatars even on a retry after their attachments were committed" do
+    user = create(:user, profile_image: nil)
+    store_legacy_image(user)
+    organization = create(:organization)
+    organization.profile_image_file.purge
+    store_legacy_image(organization)
+    article = create(:article, user: user.reload, organization: organization.reload)
+    expect(article.cached_user.profile_image_url).to eq(user.profile_image_url)
+    expect(article.cached_organization.profile_image_url).to eq(organization.profile_image_url)
+    Images::CopyProfileImage.call(user)
+    Images::CopyProfileImage.call(organization)
+
+    expect { copy }.not_to change(ActiveStorage::Blob, :count)
+    expect(article.reload.cached_user.profile_image_url).to eq(user.reload.profile_image_url)
+    expect(article.cached_user.profile_image_90).to eq(user.profile_image_90)
+    expect(article.cached_organization.profile_image_url).to eq(organization.reload.profile_image_url)
+    expect(article.cached_organization.profile_image_90).to eq(organization.profile_image_90)
+  end
+
+  it "skips a newer attachment and owners without a legacy picture" do
+    owner = create(:user)
+    current_url = owner.profile_image_url
+    owner.update_column(:profile_image, "no-longer-readable.jpg")
+    create(:user, profile_image: nil)
+
+    expect { copy }.not_to change(ActiveStorage::Blob, :count)
+    expect(owner.reload.profile_image_url).to eq(current_url)
+  end
+
+  it "reads private Fog objects through CarrierWave without fetching a public URL" do
+    owner = create(:user, profile_image: nil)
+    owner.update_column(:profile_image, "legacy.png")
+    credentials = { provider: "AWS", aws_access_key_id: "copy-spec", aws_secret_access_key: "copy-spec" }
+    bucket = "legacy-uploads"
+    Fog.mock!
+    client = Fog::Storage.new(credentials)
+    client.put_bucket(bucket)
+    client.put_object(bucket, "uploads/user/profile_image/#{owner.id}/legacy.png", image.binread)
+    allow(ProfileImageUploader).to receive_messages(storage: CarrierWave::Storage::Fog, fog_credentials: credentials,
+                                                    fog_directory: bucket, fog_public: false)
+
+    copy
+    expect(owner.reload.profile_image_file.download).to eq(image.binread)
+  ensure
+    Fog.unmock!
+  end
+
+  it "reports an unreadable source, continues, and copies it on retry after repair" do
+    missing = create(:user, profile_image: nil)
+    missing.update_column(:profile_image, "missing.jpg")
+    owner = create(:user, profile_image: nil)
+    store_legacy_image(owner)
+
+    expect { copy }.to raise_error(RuntimeError, /1.*failed/i)
+      .and output(/User.*#{missing.id}\b/).to_stderr
+    expect(missing.reload.profile_image_file).not_to be_attached
+    expect(missing.profile_image_url).to end_with("/missing.jpg")
+    expect(owner.reload.profile_image_file.download).to eq(image.binread)
+
+    store_legacy_image(missing)
+    expect { copy }.to change(ActiveStorage::Attachment, :count).by(1)
+  end
+
+  it "doesn't publish an attachment before the bytes have uploaded" do
+    owner = create(:user, profile_image: nil)
+    legacy = store_legacy_image(owner)
+    service = ActiveStorage::Blob.service
+    allow(service).to receive(:upload).and_raise(IOError, "upload failed")
+
+    expect { copy }.to raise_error(RuntimeError, /1.*failed/i)
+    expect(owner.reload.profile_image_url).to eq(legacy.url)
+    expect(owner.profile_image_file).not_to be_attached
+
+    allow(service).to receive(:upload).and_call_original
+    expect { copy }.to change(ActiveStorage::Blob, :count).by(1)
+    expect(owner.reload.profile_image_file.download).to eq(image.binread)
+  end
+
+  it "can be interrupted mid-upload and resumed without recopying completed profiles" do
+    user = create(:user, profile_image: nil)
+    store_legacy_image(user)
+    organization = create(:organization)
+    organization.profile_image_file.purge
+    legacy = store_legacy_image(organization)
+    service = ActiveStorage::Blob.service
+    allow(service).to receive(:upload).and_wrap_original do |upload, *args, **kwargs|
+      upload.call(*args, **kwargs)
+      raise Interrupt if user.reload.profile_image_file.attached?
+    end
+
+    expect { copy }.to raise_error(Interrupt)
+    user_url = user.reload.profile_image_url
+    expect(organization.reload.profile_image_url).to eq(legacy.url)
+
+    allow(service).to receive(:upload).and_call_original
+    expect { copy }.to change(ActiveStorage::Blob, :count).by(1)
+    expect(user.reload.profile_image_url).to eq(user_url)
+    expect(organization.reload.profile_image_file.download).to eq(image.binread)
+  end
+
+  it "keeps a replacement committed during the transfer and discards the unused copy" do
+    replacement = create(:user).profile_image_file.blob
+    owner = create(:user, profile_image: nil)
+    store_legacy_image(owner)
+    allow(ActiveStorage::Blob.service).to receive(:upload).and_wrap_original do |upload, *args, **kwargs|
+      upload.call(*args, **kwargs)
+      owner.profile_image_file.attach(replacement)
+    end
+
+    expect { copy }.not_to change(ActiveStorage::Blob, :count)
+    expect(owner.reload.profile_image_file.blob).to eq(replacement)
+  end
+
+  it "lets an in-flight upload replace the copy even if it previously saw no attachment" do
+    owner = create(:user, profile_image: nil)
+    store_legacy_image(owner)
+    expect(owner.reload.profile_image_file).not_to be_attached
+    copy
+
+    replacement = Rails.root.join("spec/support/fixtures/images/image1.jpeg")
+    replacement.open { |file| owner.update!(profile_image: file) }
+    expect(owner.reload.profile_image_file.download).to eq(replacement.binread)
+    expect(ActiveStorage::Attachment.where(record: owner, name: "profile_image_file").count).to eq(1)
+  end
+end
