diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..64d81fd
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,41 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    @zone = "America/Los_Angeles"
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: @zone)
+    sign_in_as(users(:david))
+  end
+
+  teardown do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+  end
+
+  test "timestamps use the browser's calendar even when the request is in another zone" do
+    today = Time.current.in_time_zone(@zone).beginning_of_day
+    card = cards(:logo)
+    comments(:logo_agreement_kevin).update_column :created_at, today.change(hour: 13, min: 42)
+    comments(:logo_agreement_jz).update_column :created_at, today - 1.minute
+    card.update_columns(created_at: today - 5.days, last_active_at: today.tomorrow - card.auto_postpone_period)
+
+    page.execute_script("document.cookie = 'timezone=Asia/Tokyo; path=/'")
+    visit card_url(card)
+    assert_selector ".comment__permalink-title", text: "1:42 PM"
+    assert_selector ".comment__permalink-title", text: /yesterday/i
+    assert_selector ".card__meta-text--added", text: /5 days ago/i
+    assert_selector ".card-perma__closure-message", text: /tomorrow/
+
+    card.update_column :last_active_at, (today + 3.days) - card.auto_postpone_period
+    page.execute_script("Turbo.visit(location.href, { action: 'replace' })")
+    assert_selector ".card-perma__closure-message", text: /in 3 days/
+    assert_selector ".comment__permalink-title", text: "1:42 PM"
+  end
+
+  test "timeline headings keep the selected calendar day while event clocks show local time" do
+    events(:layout_assignment_jz).update_column :created_at, Time.utc(2025, 3, 9, 7, 42)
+    visit events_url(day: "2025-03-08")
+
+    assert_selector ".events__column-header", text: /Saturday, March 8/i
+    assert_selector ".event__timestamp", text: "11:42 PM"
+  end
+end
