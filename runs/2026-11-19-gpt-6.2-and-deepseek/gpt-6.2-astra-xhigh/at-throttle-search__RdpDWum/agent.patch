diff --git a/app/models/book/search_rate_limit.rb b/app/models/book/search_rate_limit.rb
new file mode 100644
index 0000000..53105da
--- /dev/null
+++ b/app/models/book/search_rate_limit.rb
@@ -0,0 +1,20 @@
+class Book::SearchRateLimit
+  LIMIT = 30
+  WINDOW = 1.minute
+
+  # Keep the limiter active even when general caching is disabled in development/test.
+  STORE = Rails.cache.is_a?(ActiveSupport::Cache::NullStore) ? ActiveSupport::Cache::MemoryStore.new : Rails.cache
+
+  def self.allow?(address)
+    # Each admitted search holds one slot for its own full minute. Bulk-read the
+    # occupied slots so a throttled request needs only one round trip to Redis.
+    slots = Array.new(LIMIT) { |i| "rate-limit:book-search:#{address}:#{i}" }
+    available = slots - STORE.read_multi(*slots, raw: true).keys
+
+    available.any? do |slot|
+      # Atomic even if several workers see the same free slot. False means it
+      # was taken; nil means the cache is down, in which case let readers through.
+      STORE.write(slot, 1, unless_exist: true, expires_in: WINDOW, raw: true) != false
+    end
+  end
+end
