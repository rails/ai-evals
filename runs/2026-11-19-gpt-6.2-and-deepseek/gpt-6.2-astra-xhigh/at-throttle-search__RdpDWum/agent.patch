@@ -0,0 +1,50 @@
+require "test_helper"
+
+class BookSearchRateLimitTest < ActionDispatch::IntegrationTest
+  test "only thirty searches per address in a rolling minute, across published books" do
+    books(:handbook).update!(published: true)
+    books(:manual).update!(published: true)
+    Leaf.reindex_all
+
+    address = "192.0.2.31"
+    freeze_time
+    search :manual, from: address
+    assert_response :success
+
+    travel 59.seconds
+    29.times do
+      search :handbook, from: address
+      assert_response :success
+    end
+
+    search :handbook, from: address
+    assert_response :too_many_requests
+
+    search :handbook, from: "192.0.2.32"
+    assert_response :success
+    assert_select "a.search__result", text: /Thanks for reading/i
+
+    get leafable_slug_path(leaves(:welcome_page)), env: { "REMOTE_ADDR" => address }
+    assert_response :success
+    assert_select "p", "This is such a great handbook."
+
+    # Only the first search has aged out; the other 29 still count.
+    travel 1.second
+    search :handbook, from: address
+    assert_response :success
+    assert_no_queries_match(/leaf_search_index/) do
+      search :handbook, from: address
+    end
+    assert_response :too_many_requests
+
+    travel 1.minute
+    search :handbook, from: address
+    assert_response :success
+    assert_select "a.search__result", text: /Thanks for reading/i
+  end
+
+  private
+    def search(book, from:)
+      post book_search_path(books(book)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => from }
+    end
+end
