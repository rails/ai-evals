diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..6989dbc
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,68 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  def self.for_checkout(account)
+    find_or_create_by!(account: account) do |subscription|
+      customer = Stripe::Customer.create({ metadata: { account_id: account.id } }, { idempotency_key: "account-#{account.id}" })
+      subscription.stripe_customer_id = customer.id
+    end
+  end
+
+  def checkout_url(plan:, return_url:)
+    Stripe::Checkout::Session.create(mode: "subscription", customer: stripe_customer_id,
+      line_items: [ { price: ENV.fetch(plan.price_id_env), quantity: 1 } ],
+      success_url: return_url, cancel_url: return_url).url
+  end
+
+  def portal_url(return_url:)
+    Stripe::BillingPortal::Session.create(customer: stripe_customer_id, return_url: return_url).url
+  end
+
+  def cancel
+    Stripe::Subscription.cancel(stripe_subscription_id)
+  end
+
+  def ongoing?
+    stripe_subscription_id.present? && !%w[ canceled incomplete_expired ].include?(status)
+  end
+
+  def paid_plan
+    ::Subscription.paid_plan_for(plan_key) if status.in?(%w[ active trialing ])
+  end
+
+  def sync(event)
+    snapshot = event.data.object
+    event_at = Time.at(event.created)
+
+    with_lock do
+      unless superseded?(snapshot, event.type, event_at)
+        # Event timestamps have one-second precision. For conflicting updates
+        # in the same second, only Stripe can tell which snapshot is current.
+        if stripe_subscription_id == snapshot.id && last_update_at == event_at && event.type == "customer.subscription.updated"
+          return if status == snapshot.status && plan_key == plan_key_for(snapshot)
+          snapshot = Stripe::Subscription.retrieve(snapshot.id)
+        end
+
+        update!(stripe_subscription_id: snapshot.id, plan_key: plan_key_for(snapshot),
+          status: event.type == "customer.subscription.deleted" ? "canceled" : snapshot.status,
+          subscription_created_at: Time.at(snapshot.created), last_update_at: (event_at if event.type == "customer.subscription.updated"))
+      end
+    end
+  end
+
+  private
+    # A late event for a previous subscription must not overwrite its replacement.
+    def superseded?(snapshot, type, at)
+      if stripe_subscription_id != snapshot.id
+        subscription_created_at && Time.at(snapshot.created) < subscription_created_at
+      elsif status == "canceled" || type == "customer.subscription.created"
+        true
+      else
+        type == "customer.subscription.updated" && last_update_at && at < last_update_at
+      end
+    end
+
+    def plan_key_for(snapshot)
+      ::Subscription.for_price(snapshot.items.data.first&.price&.id)&.short_name
+    end
+end
diff --git a/saas/app/models/card/publication_limited.rb b/saas/app/models/card/publication_limited.rb
