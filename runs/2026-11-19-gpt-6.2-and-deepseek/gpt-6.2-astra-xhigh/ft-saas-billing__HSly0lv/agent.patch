diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..2cde725
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup { @account = accounts(:initech) }
+
+  test "staff can find an account, comp it and override or restore its measured usage" do
+    sign_in_as :david
+    untenanted do
+      get "/admin/accounts"
+      assert_response :success
+      assert_select "a[href=?]", saas.admin_account_path(@account), text: @account.name
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "button", text: "Comp"
+
+      post saas.admin_account_billing_waiver_path(@account)
+      follow_redirect!
+      assert_select "button", text: "Uncomp"
+      assert @account.reload.comped?
+      assert_nil @account.cards_left
+      assert_equal 5.gigabytes, @account.storage_limit
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_not @account.reload.comped?
+
+      override_path = saas.admin_account_overridden_limit_path(@account)
+      patch override_path, params: { overridden_limit: { card_count: 1000, bytes_used: 2.gigabytes } }
+      follow_redirect!
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type='submit'][value='Override']"
+      assert_select "button", text: "Reset"
+      assert @account.reload.card_limit_reached?
+      assert @account.exceeding_storage_limit?
+      assert_nil accounts(:acme).overridden_limit
+
+      patch override_path, params: { overridden_limit: { card_count: -1 } }
+      assert_response :unprocessable_entity
+      assert_equal 1000, @account.reload.card_count
+
+      patch override_path, params: { overridden_limit: { card_count: "", bytes_used: 0 } }
+      assert_equal 2, @account.reload.card_count
+      assert_equal 0, @account.bytes_used
+      assert_equal 0, @account.overridden_limit.bytes_used
+
+      delete override_path
+      assert_nil @account.reload.overridden_limit
+      assert_equal 2, @account.card_count
+      assert_not @account.exceeding_storage_limit?
+    end
+  end
+
+  test "being an account admin does not grant access to support tools" do
+    sign_in_as :mike
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+      get saas.admin_account_path(@account)
+      assert_response :forbidden
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+      patch saas.admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: 42 } }
+      assert_response :forbidden
+      assert_nil @account.billing_waiver
+      assert_nil @account.overridden_limit
+    end
+  end
+end
diff --git a/saas/test/integration/billing_test.rb b/saas/test/integration/billing_test.rb
new file mode 100644
index 0000000..e35c69e
--- /dev/null
+++ b/saas/test/integration/billing_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class BillingTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @scope = { script_name: @account.slug }
+    @env = {
+      "STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited",
+      "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus",
+      "STRIPE_WEBHOOK_SECRET" => "webhooks-test"
+    }
+    @original_env = @env.keys.index_with { |key| ENV[key] }
+    ENV.update(@env)
+  end
+
+  teardown { ENV.update(@original_env) }
+
+  test "choose a plan, check out and visit the portal for the same customer" do
+    sign_in_as :mike
+    get account_settings_path(**@scope)
+    get css_select("#billing a").first["href"]
+    assert_response :success
+    assert_select "section", text: /Unlimited\+.*\$25\/month.*500 GB/m
+    assert_select "section", text: /Unlimited.*\$20\/month.*5 GB/m
+
+    Stripe::Customer.expects(:create).with({ metadata: { account_id: @account.id } }, { idempotency_key: "account-#{@account.id}" }).returns(stub(id: "cus_fizzy"))
+    Stripe::Checkout::Session.expects(:create).with(mode: "subscription", customer: "cus_fizzy",
+      line_items: [ { price: "price_plus", quantity: 1 } ], success_url: account_settings_url(**@scope), cancel_url: account_settings_url(**@scope))
+      .returns(stub(url: "https://checkout.stripe.com/pay/test"))
+    post css_select("form[action$='/account/subscription']").last["action"], params: { plan: "MonthlyExtraStorageV1" }
+    assert_redirected_to "https://checkout.stripe.com/pay/test"
+    assert_equal "Free", @account.reload.billing_plan.proper_name
+
+    send_event "created", price: "price_plus"
+    assert_response :success
+    assert_equal "Unlimited+", @account.reload.billing_plan.proper_name
+    get account_settings_path(**@scope)
+    assert_select "#billing", text: /Unlimited\+.*500 GB/m
+    Stripe::BillingPortal::Session.expects(:create).with(customer: "cus_fizzy", return_url: account_settings_url(**@scope))
+      .returns(stub(url: "https://billing.stripe.com/session/test"))
+    post css_select("#billing form").first["action"], params: { customer: "some_other_customer" }
+    assert_redirected_to "https://billing.stripe.com/session/test"
+  end
+
+  test "only admins can check out or open a portal" do
+    sign_in_as :jz
+    get account_settings_path
+    assert_select "#billing", count: 0
+    get saas.new_account_subscription_path
+    assert_response :forbidden
+    post saas.account_subscription_path, params: { plan: "MonthlyV1" }
+    assert_response :forbidden
+    post saas.account_billing_portal_path
+    assert_response :forbidden
+  end
+
+  test "only known plans can be purchased" do
+    sign_in_as :mike
+    post saas.account_subscription_path(**@scope), params: { plan: "price_supplied_by_client" }
+    assert_response :bad_request
+    post saas.account_billing_portal_path(**@scope)
+    assert_response :not_found
+  end
+
+  test "subscription changes update only the bound account, ignoring retries and stale changes" do
+    @account.create_subscription!(stripe_customer_id: "cus_fizzy")
+    send_event "created", price: "price_unlimited", at: 100
+    assert_response :ok
+    assert_equal 5.gigabytes, @account.reload.storage_limit
+    assert_nil @account.cards_left
+
+    send_event "updated", price: "price_plus", at: 120
+    send_event "updated", price: "price_plus", at: 120
+    send_event "updated", price: "price_unlimited", at: 110
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+    assert_equal 1.gigabyte, accounts(:acme).storage_limit
+
+    send_event "deleted", at: 140
+    send_event "updated", price: "price_plus", at: 130
+    assert_equal 1.gigabyte, @account.reload.storage_limit
+    assert_equal 998, @account.cards_left
+  end
+
+  test "conflicting updates in the same second use the current Stripe subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_fizzy")
+    send_event "updated", price: "price_plus", at: 120
+    current = Stripe::Subscription.construct_from(id: "sub_fizzy", created: 100, status: "active",
+      items: { data: [ { price: { id: "price_plus" } } ] })
+    Stripe::Subscription.expects(:retrieve).with("sub_fizzy").returns(current)
+    send_event "updated", price: "price_unlimited", at: 120
+    assert_response :ok
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+  end
+
+  test "an account with an ongoing subscription cannot check out twice, and canceling stops billing" do
+    @account.create_subscription!(stripe_customer_id: "cus_fizzy")
+    send_event "created"
+    sign_in_as :mike
+    post saas.account_subscription_path(**@scope), params: { plan: "MonthlyV1" }
+    assert_response :conflict
+
+    Stripe::Subscription.expects(:cancel).with("sub_fizzy")
+    @account.cancel(initiated_by: users(:mike))
+    assert @account.reload.cancelled?
+  end
+
+  test "unrecognized prices and unpaid subscriptions do not grant paid features" do
+    @account.create_subscription!(stripe_customer_id: "cus_fizzy")
+    send_event "created", price: "price_plus", status: "incomplete"
+    assert_equal "Free", @account.reload.billing_plan.proper_name
+    send_event "updated", price: "price_unknown"
+    assert_equal "Free", @account.reload.billing_plan.proper_name
+  end
+
+  test "unsigned or malformed webhook requests are rejected without changing the plan" do
+    @account.create_subscription!(stripe_customer_id: "cus_fizzy")
+    send_event "created", price: "price_plus", secret: "wrong"
+    assert_response :bad_request
+    post_event "not JSON", secret: @env.fetch("STRIPE_WEBHOOK_SECRET")
+    assert_response :bad_request
+    assert_nil @account.reload.subscription.status
+  end
+
+  private
+    def send_event(type, price: "price_unlimited", status: "active", at: Time.now.to_i, secret: @env.fetch("STRIPE_WEBHOOK_SECRET"))
+      snapshot = { id: "sub_fizzy", object: "subscription", customer: "cus_fizzy", status: status, created: 100,
+        items: { object: "list", data: [ { object: "subscription_item", price: { id: price, object: "price" } } ] } }
+      post_event({ id: "evt_#{at}", object: "event", type: "customer.subscription.#{type}", created: at, data: { object: snapshot } }.to_json, secret: secret)
+    end
+
+    def post_event(body, secret:)
+      now = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(now, body, secret)
+      post "/stripe/webhooks", params: body, headers: { "Content-Type" => "application/json", "Stripe-Signature" => Stripe::Webhook::Signature.generate_header(now, signature) }
+    end
+end
diff --git a/saas/test/integration/card_quota_test.rb b/saas/test/integration/card_quota_test.rb
new file mode 100644
index 0000000..ebd4227
--- /dev/null
+++ b/saas/test/integration/card_quota_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class CardQuotaTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+    @scope = { script_name: @account.slug }
+    sign_in_as :mike
+  end
+
+  test "an exhausted account can draft but cannot publish or create through the API" do
+    @account.create_overridden_limit!(card_count: 1000)
+
+    get card_draft_path(@draft, **@scope)
+    assert_select "a", text: "Upgrade"
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+
+    post card_publish_path(@draft, **@scope)
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, **@scope), params: { card: { title: "One too many" } }, as: :json
+    end
+    assert_response :forbidden
+
+    @draft.destroy!
+    @account.update!(cards_count: 3) # Keep the fixture card-number sequence current.
+    assert_difference -> { @board.cards.drafted.count } do
+      post board_cards_path(@board, **@scope)
+    end
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+  end
+
+  test "a draft can use the final slot, and existing cards remain editable afterwards" do
+    # Two published cards and one draft belong to Initech.
+    Subscription::FreeV1.stubs(:card_limit).returns(3)
+    assert_equal 1, @account.cards_left
+    post card_publish_path(@draft, **@scope)
+    assert_response :redirect
+    assert @draft.reload.published?
+    assert_equal 0, @account.reload.cards_left
+
+    post board_cards_path(@board, **@scope), params: { card: { title: "At capacity" } }, as: :json
+    assert_response :forbidden
+    patch card_path(@draft, **@scope), params: { card: { title: "Still editable" } }, as: :json
+    assert_response :success
+  end
+
+  test "a paid account can publish past 1,000 but not past its storage allowance" do
+    @account.create_subscription!(stripe_customer_id: "cus_paid", stripe_subscription_id: "sub_paid", plan_key: "MonthlyV1", status: "active")
+    override = @account.create_overridden_limit!(card_count: 1000, bytes_used: 5.gigabytes + 1)
+    post card_publish_path(@draft, **@scope)
+    assert_response :forbidden
+
+    override.update!(bytes_used: 5.gigabytes)
+    post card_publish_path(@draft, **@scope)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "draft footer counts down the last hundred cards" do
+    override = @account.create_overridden_limit!(card_count: 899)
+    get card_draft_path(@draft, **@scope)
+    assert_no_match /cards left/, response.body
+
+    [ 900, 950, 999 ].each do |used|
+      override.update!(card_count: used)
+      get card_draft_path(@draft, **@scope)
+      assert_select ".card-perma__notch", text: /#{1000 - used} cards? left/
+      assert_select ".card-perma__notch-new-card-buttons"
+    end
+  end
+
+  test "account admins see their plan and can reach the upgrade flow" do
+    get account_settings_path(**@scope)
+    assert_response :success
+    assert_select "section", text: /Free/ do
+      assert_select "a", text: "Upgrade"
+    end
+  end
+end
