@@ -0,0 +1,18 @@
+module Card::PublicationLimited
+  extend ActiveSupport::Concern
+
+  class LimitReached < StandardError; end
+
+  included do
+    before_save :ensure_room_to_publish, if: -> { published? && will_save_change_to_status? }
+  end
+
+  private
+    def ensure_room_to_publish
+      if account.billing_plan.card_limit
+        # Serialize publications competing for the last slot, not draft edits.
+        account.lock!
+        raise LimitReached if account.card_limit_reached?
+      end
+    end
+end
