@@ -0,0 +1,25 @@
+<% @page_title = @account.name %>
+<% content_for :header do %><h1 class="header__title"><%= @page_title %></h1><% end %>
+
+<section class="settings__panel panel shadow">
+  <%= link_to "All accounts", saas.admin_accounts_path %>
+  <h2>Plan: <%= @account.billing_plan.proper_name %></h2>
+  <p>Comp grants complimentary Unlimited access. It doesn’t change an existing Stripe subscription.</p>
+  <% if @account.comped? %>
+    <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+  <% else %>
+    <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), class: "btn" %>
+  <% end %>
+
+  <h2>Usage override</h2>
+  <p>Leave a field blank to use the measured usage.</p>
+  <%= form_with model: @override, scope: :overridden_limit, url: saas.admin_account_overridden_limit_path(@account), method: :patch do |form| %>
+    <% @override.errors.full_messages.each do |message| %><p><%= message %></p><% end %>
+    <p><%= form.label :card_count, "Card count" %> <%= form.number_field :card_count, min: 0, placeholder: @account.card_count %></p>
+    <p><%= form.label :bytes_used, "Bytes used" %> <%= form.number_field :bytes_used, min: 0, placeholder: @account.bytes_used %></p>
