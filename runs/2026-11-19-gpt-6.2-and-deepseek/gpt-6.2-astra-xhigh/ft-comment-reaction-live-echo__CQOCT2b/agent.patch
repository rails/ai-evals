diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..ba0807b
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,53 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, :ensure_creatorship, only: :destroy
+
+  def index
+  end
+
+  def new
+    @reaction = @comment.reactions.new
+  end
+
+  def create
+    @reaction = @comment.reactions.build(params.expect(reaction: [ :content ]))
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render partial: "reactions/reaction", locals: { reaction: @reaction }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { render :new, formats: :html, content_type: :html, status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream { render turbo_stream: turbo_stream.remove(@reaction) }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden unless @reaction.reacter == Current.user
+    end
+end
