diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..ef66fc2
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "post a reaction to a comment" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :turbo_stream
+
+    assert_response :success
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions)
+    reaction = @comment.reactions.sole
+    assert_equal "Great 👍", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "create, list and remove reactions as JSON" do
+    content = "👍" * 16
+    post card_comment_reactions_path(@card, @comment), params: { content: content }, as: :json
+    assert_response :created
+    id = @response.parsed_body.fetch("id")
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+    assert_response :success
+    reaction = @response.parsed_body.sole
+    assert_equal content, reaction["content"]
+    assert_equal users(:kevin).name, reaction.dig("reacter", "name")
+
+    delete card_comment_reaction_path(@card, @comment, id), as: :json
+    assert_response :no_content
+    assert_empty @comment.reactions
+  end
+
+  test "reject blank and overlong reactions" do
+    assert_no_difference -> { Reaction.count } do
+      [ "   ", "a" * 17 ].each do |content|
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+        assert_response :unprocessable_entity
+        assert_equal "text/html", @response.media_type
+        assert_dom "turbo-frame##{dom_id(@comment, :new_reaction)} [role='alert']"
+      end
+    end
+  end
+
+  test "reject removal by anyone but the reacter" do
+    reaction = @comment.reactions.create!(content: "Yes!", reacter: users(:jz))
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+    assert_response :forbidden
+  end
+
+  test "scope comments to accessible cards and reactions to their comment" do
+    reaction = @comment.reactions.create!(content: "Yes!", reacter: users(:kevin))
+    delete card_comment_reaction_path(@card, comments(:logo_agreement_kevin), reaction), as: :json
+    assert_response :not_found
+    assert Reaction.exists?(reaction.id)
+
