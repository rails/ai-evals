+
+    @card.board.accesses.find_by!(user: users(:kevin)).destroy!
+    get card_comment_reactions_path(@card, @comment), as: :json
+    assert_response :not_found
+  end
+
+  test "cached cards reflect the current set of reactions" do
+    with_actionview_partial_caching do
+      get card_path(@card)
+      assert_dom "##{dom_id(@comment, :reactions)} .reaction", count: 0
+
+      first = @comment.reactions.create!(content: "First", reacter: users(:kevin))
+      get card_path(@card)
+      assert_dom "##{dom_id(first)}"
+
+      first.destroy!
+      second = @comment.reactions.create!(content: "Second", reacter: users(:kevin))
+      get card_path(@card)
+      assert_dom "##{dom_id(first)}", count: 0
+      assert_dom "##{dom_id(second)}"
+    end
+  end
