+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "add, cancel and remove reactions while someone else is looking at the card" do
+    content = "Thanks so much 👍"
+
+    using_session(:observer) do
+      open_card_as users(:jz)
+      within_strip do
+        find(".reactions__trigger").click
+        find(".reaction__input").set "In progress"
+      end
+    end
+
+    open_card_as users(:kevin)
+    within_strip do
+      find(".reactions__trigger").click
+      find(".reaction__input").set "Not this one"
+      find(".reaction__cancel-btn").click
+      find(".reactions__trigger").click
+      assert_field "reaction[content]", with: ""
+      find(".reaction__input").set "a" * 17
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction__input:invalid"
+      find(".reaction__input").set content
+      find(".reaction__submit-btn").click
+      assert_selector ".reactions__list .reaction", text: content, count: 1
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction__input"
+    end
+
+    perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+    using_session(:observer) do
+      within_strip do
+        assert_selector ".reactions__list .reaction", text: content
+        assert_selector ".reaction__avatar img[title='Kevin']"
+        assert_no_selector ".reaction--deleteable"
+        assert_field "reaction[content]", with: "In progress"
+      end
+    end
+
+    within_strip do
+      assert_no_selector ".reaction__delete"
+      find(".reaction--deleteable", text: content).click
+      find(".reaction__delete button").click
+      assert_no_selector ".reactions__list .reaction"
+    end
+
+    using_session(:observer) do
+      within_strip { assert_no_selector ".reactions__list .reaction" }
+    end
+  end
+
+  private
+    def open_card_as(user)
+      sign_in_as user
+      visit card_url(@comment.card)
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def within_strip(&block)
+      within "##{dom_id(@comment)} .reactions", &block
+    end
+end
