new file mode 100644
index 0000000..369e581
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,17 @@
+class Reaction < ApplicationRecord
+  CONTENT_LIMIT = 16
+
+  belongs_to :comment
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: CONTENT_LIMIT }
+
+  after_create_commit :broadcast_creation
+  after_destroy_commit -> { broadcast_remove_to comment.card }, if: :comment
+
+  private
+    def broadcast_creation
+      broadcast_append_later_to comment.card, target: [ comment, :reactions ]
+    end
+end
