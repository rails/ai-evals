@@ -1,23 +1,34 @@
 module Card::Entropic
   extend ActiveSupport::Concern
 
+  ACCOUNT_ENTROPY_JOIN = "LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id " \
+    "AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id"
+  AUTO_POSTPONE_PERIOD_SQL = "COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)"
+
   included do
     scope :due_to_be_postponed, -> do
-      active
-        .joins(board: :account)
-        .left_outer_joins(board: :entropy)
-        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", Time.now)
+      board_periods = Board.joins(:account).left_outer_joins(:entropy).joins(ACCOUNT_ENTROPY_JOIN)
+        .select("boards.id AS board_id, #{AUTO_POSTPONE_PERIOD_SQL} AS period")
+
+      # Keep boards in the outer loop on SQLite, even when find_each orders by card ID.
+      # Each board then needs only an index range scan up to its own cutoff.
+      active.with(board_periods:)
+        .from("board_periods CROSS JOIN cards")
+        .where("cards.board_id = board_periods.board_id")
+        .where("cards.last_active_at <= #{connection.date_subtract('?', 'board_periods.period')}", Time.current)
     end
 
     scope :postponing_soon, -> do
       now = Time.now
+      due_cutoff = connection.date_subtract("?", AUTO_POSTPONE_PERIOD_SQL)
+      soon_cutoff = connection.date_subtract("?", "#{AUTO_POSTPONE_PERIOD_SQL} * 0.75")
+
       active
         .joins(board: :account)
         .left_outer_joins(board: :entropy)
-        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at > #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", now)
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period) * 0.75')}", now)
+        .joins(ACCOUNT_ENTROPY_JOIN)
+        .where("last_active_at > #{due_cutoff}", now)
+        .where("last_active_at <= #{soon_cutoff}", now)
     end
 
     delegate :auto_postpone_period, to: :board
