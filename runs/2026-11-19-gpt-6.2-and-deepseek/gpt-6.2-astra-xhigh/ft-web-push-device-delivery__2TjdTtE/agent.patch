+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    Push.stubs(:configured?).returns(true)
+    Push.stubs(:public_key).returns(WebPush.generate_key.public_key)
+    sign_in_as @user
+  end
+
+  test "enables and disables notifications for the current browser" do
+    keys = { p256dh: WebPush.generate_key.public_key, auth: SecureRandom.urlsafe_base64(16) }
+    # Stand in for the platform permission prompt and external push service.
+    stub_browser <<~JS
+      Object.defineProperty(Notification, "permission", { get: () => "granted" })
+      Notification.requestPermission = async () => "granted"
+      const subscription = { endpoint: "https://push.example.org/device", toJSON() { return { endpoint: this.endpoint, keys: #{keys.to_json} } } }
+      PushManager.prototype.getSubscription = async () => sessionStorage.subscribed ? subscription : null
+      PushManager.prototype.subscribe = async ({ userVisibleOnly, applicationServerKey }) => {
+        if (!userVisibleOnly || !(applicationServerKey instanceof Uint8Array) || applicationServerKey.length !== 65) throw new Error("Missing push options")
+        sessionStorage.subscribed = "yes"
+        return subscription
+      }
+    JS
+
+    visit notifications_settings_path
+    assert_text "Push notifications are off for this device."
+    click_on "Turn on push notifications"
+    assert_text "Push notifications are on for this device."
+    assert_equal keys[:auth], @user.push_subscriptions.sole.auth_key
+
+    visit notifications_settings_path
+    click_on "Turn off push notifications"
+    assert_text "Push notifications are off for this device."
+    assert_empty @user.push_subscriptions
+  end
+
+  test "shows instructions when permission is denied" do
+    stub_browser 'Object.defineProperty(Notification, "permission", { get: () => "denied" })'
+    visit notifications_settings_path
+
+    assert_text "Notifications are blocked on this device."
+    assert_button "Turn on push notifications", disabled: true
+    assert_selector ".notifications-help"
+    assert_empty @user.push_subscriptions
+  end
+
+  teardown do
+    if @script_id
+      page.driver.browser.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: @script_id)
+    end
+  end
+
+  private
+    def stub_browser(script)
+      @script_id = page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: script).fetch("identifier")
+    end
+end
