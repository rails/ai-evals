new file mode 100644
index 0000000..53d7305
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,26 @@
+class Users::PushSubscriptionsController < ApplicationController
+  SUBSCRIPTION_FIELDS = %i[ endpoint p256dh_key auth_key ].freeze
+
+  before_action :ensure_current_user
+
+  def create
+    Current.user.register_push_subscription!(subscription_params.merge(session: Current.session, user_agent: request.user_agent.to_s.first(4096)))
+    head :created
+  rescue ActiveRecord::RecordInvalid => error
+    render json: { errors: error.record.errors.full_messages }, status: :unprocessable_entity
+  end
+
+  def destroy
+    Current.user.push_subscriptions.destroy_by(endpoint_digest: params[:endpoint_digest])
+    head :no_content
+  end
+
+  private
+    def ensure_current_user
+      head :forbidden unless Current.user.id == params[:user_id]
+    end
+
+    def subscription_params
+      params.expect(push_subscription: SUBSCRIPTION_FIELDS).tap { it.require(SUBSCRIPTION_FIELDS) }
+    end
+end
