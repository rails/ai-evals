diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..240ecc5
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    @subscription = { endpoint: "https://push.example.org/device", p256dh_key: WebPush.generate_key.public_key, auth_key: SecureRandom.urlsafe_base64(16) }
+  end
+
+  test "registers this device and refreshes its keys on a repeated POST" do
+    register @user
+    assert_response :created
+
+    @subscription[:auth_key] = SecureRandom.urlsafe_base64(16)
+    register @user
+    assert_response :success
+
+    device = @user.push_subscriptions.sole
+    assert_equal @user.account, device.account
+    assert_equal @subscription[:endpoint], device.endpoint
+    assert_equal @subscription[:auth_key], device.auth_key
+    assert_equal @subscription[:p256dh_key], device.p256dh_key
+  end
+
+  test "cannot register a device for someone else" do
+    register users(:kevin)
+    assert_response :forbidden
+  end
+
+  test "unregistering this device leaves other devices alone" do
+    register @user
+    first = @user.push_subscriptions.sole
+    @subscription[:endpoint] += "-other"
+    register @user
+
+    delete user_push_subscription_path(@user, first.endpoint_digest), as: :json
+    assert_response :no_content
+    assert_equal @subscription[:endpoint], @user.push_subscriptions.sole.endpoint
+  end
+
+  test "signing out unregisters the session's devices" do
+    register @user
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      sign_out
+    end
+  end
+
+  test "rejects an insecure endpoint or invalid keys" do
+    @subscription[:endpoint] = "http://example.org/device"
+    register @user
+    assert_response :unprocessable_entity
+
+    @subscription.merge!(endpoint: "https://example.org/device", p256dh_key: "bogus")
+    register @user
+    assert_response :unprocessable_entity
+    assert_empty @user.push_subscriptions
+  end
+
+  private
+    def register(user)
+      post user_push_subscriptions_path(user), params: { push_subscription: @subscription }, as: :json
+    end
+end
