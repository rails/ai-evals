diff --git a/app/models/push/delivery.rb b/app/models/push/delivery.rb
new file mode 100644
index 0000000..b42315b
--- /dev/null
+++ b/app/models/push/delivery.rb
@@ -0,0 +1,47 @@
+class Push::Delivery
+  include Rails.application.routes.url_helpers
+
+  class TemporaryFailure < StandardError; end
+
+  def initialize(subscription)
+    @subscription = subscription
+    @uri = URI.parse(subscription.endpoint)
+  end
+
+  def send_message(source)
+    if ip = SsrfProtection.resolve_public_ip(@uri.hostname)
+      response = post(encrypted_request(source), ip)
+      case response
+      when Net::HTTPGone, Net::HTTPNotFound then @subscription.destroy!
+      when Net::HTTPTooManyRequests, Net::HTTPServerError then raise TemporaryFailure, "Push service returned #{response.code}"
+      else response.value
+      end
+    end
+  end
+
+  private
+    def encrypted_request(source)
+      WebPush::Request.new(message: message(source), vapid: Push.vapid, subscription: {
+        endpoint: @subscription.endpoint, keys: { p256dh: @subscription.p256dh_key, auth: @subscription.auth_key }
+      })
+    end
+
+    def message(source)
+      payload = { title: source.notification_title, body: source.notification_body,
+        url: polymorphic_path(source.notifiable_target, only_path: true, script_name: @subscription.account.slug) }
+
+      # Leave room for the encryption overhead in the push service's 4 KiB limit.
+      json = JSON.generate(payload)
+      json.bytesize <= 3993 ? json : JSON.generate(payload.merge(body: payload[:body].truncate(350)))
+    end
+
+    def post(request, ip)
+      # Don't let a second DNS lookup choose a different address for this client-supplied endpoint.
+      http = Net::HTTP.new(@uri.hostname, @uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = true
+      http.open_timeout = http.read_timeout = 5
+      # We only need the status, not a potentially unbounded response body.
+      http.request_post(@uri.request_uri, request.body, request.headers) { |response| return response }
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..1ea3f1b
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,47 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  belongs_to :session, optional: true
+
+  before_validation { self.endpoint_digest = self.class.digest(endpoint) }
+
+  validates :endpoint, length: { maximum: 4096 }
+  validate :validate_endpoint, :validate_p256dh_key, :validate_auth_key
+
+  def self.digest(endpoint)
+    Digest::SHA256.hexdigest(endpoint.to_s)
+  end
+
+  def deliver(source)
+    if Push.configured? && user.active? && account.active? && source.card.accessible_to?(user)
+      Push::Delivery.new(self).send_message(source)
+    end
+  end
+
+  private
+    def validate_endpoint
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && (1..65535).cover?(uri.port) && uri.userinfo.nil? && uri.fragment.nil?
+        errors.add(:endpoint, "must be an HTTPS push service URL")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, :invalid)
+    end
+
+    def validate_p256dh_key
+      # An uncompressed P-256 public key is 65 bytes, starting with 0x04.
+      key = Base64.urlsafe_decode64(p256dh_key.to_s)
+      group = OpenSSL::PKey::EC::Group.new("prime256v1")
+      unless key.bytesize == 65 && key.getbyte(0) == 4 && OpenSSL::PKey::EC::Point.new(group, key).on_curve?
+        errors.add(:p256dh_key, :invalid)
+      end
+    rescue ArgumentError, OpenSSL::PKey::EC::Point::Error
+      errors.add(:p256dh_key, :invalid)
+    end
+
+    def validate_auth_key
+      errors.add(:auth_key, :invalid) unless Base64.urlsafe_decode64(auth_key.to_s).bytesize == 16
+    rescue ArgumentError
+      errors.add(:auth_key, :invalid)
+    end
+end
