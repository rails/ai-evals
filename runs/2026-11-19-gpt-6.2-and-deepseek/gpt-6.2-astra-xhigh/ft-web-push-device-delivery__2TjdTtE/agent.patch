@@ -0,0 +1,10 @@
+class Push::DeliveryJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+  retry_on Push::Delivery::TemporaryFailure, Net::OpenTimeout, Net::ReadTimeout, wait: :polynomially_longer, attempts: 4
+
+  def perform(subscription, source)
+    subscription.deliver(source)
+  end
+end
