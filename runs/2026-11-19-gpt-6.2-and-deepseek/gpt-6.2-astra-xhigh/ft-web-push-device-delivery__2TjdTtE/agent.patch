diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..f68038c
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,85 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { registerServiceWorker } from "initializers/offline"
+
+export default class extends Controller {
+  static targets = [ "button", "help", "status" ]
+  static values = { url: String, publicKey: String, devices: Array }
+
+  async connect() {
+    this.buttonTarget.disabled = true
+    if (!("serviceWorker" in navigator && "PushManager" in window && "Notification" in window)) {
+      this.#showHelp("This browser can’t receive push notifications.")
+    } else if (Notification.permission === "denied") {
+      this.#showHelp("Notifications are blocked on this device. After allowing them, reload this page.")
+    } else {
+      try {
+        if (!await registerServiceWorker()) throw new Error()
+        this.registration = await navigator.serviceWorker.ready
+        const subscription = await this.registration.pushManager.getSubscription()
+        this.digest = subscription && await endpointDigest(subscription.endpoint)
+        this.#setEnabled(Notification.permission === "granted" && this.devicesValue.includes(this.digest))
+      } catch {
+        this.#showHelp("Couldn’t check notifications on this device.")
+      }
+    }
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+    try {
+      if (this.enabled) {
+        await this.#unsubscribe()
+        this.#setEnabled(false)
+      } else if (await Notification.requestPermission() === "granted") {
+        await this.#subscribe()
+        this.#setEnabled(true)
+      } else {
+        this.#showHelp("Allow notifications to receive updates on this device.")
+        this.buttonTarget.disabled = Notification.permission === "denied"
+      }
+    } catch {
+      this.#showHelp("Couldn’t update push notifications. Please try again.")
+      this.buttonTarget.disabled = false
+    }
+  }
+
+  async #subscribe() {
+    const key = atob(this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/"))
+    const subscription = await this.registration.pushManager.getSubscription() || await this.registration.pushManager.subscribe({
+      userVisibleOnly: true, applicationServerKey: Uint8Array.from(key, character => character.charCodeAt(0))
+    })
+    const { endpoint, keys } = subscription.toJSON()
+    this.digest = await endpointDigest(endpoint)
+    const response = await post(this.urlValue, { responseKind: "json", body: {
+      push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth }
+    } })
+    if (!response.ok || response.redirected) throw new Error()
+    this.devicesValue = [ ...this.devicesValue, this.digest ]
+  }
+
+  async #unsubscribe() {
+    const response = await destroy(`${this.urlValue}/${this.digest}`, { responseKind: "json" })
+    if (!response.ok || response.redirected) throw new Error()
+    // The browser subscription can still be in use by another account on this device.
+    this.devicesValue = this.devicesValue.filter(digest => digest !== this.digest)
+  }
+
+  #setEnabled(enabled) {
+    this.enabled = enabled
+    this.element.classList.toggle("notifications--on", enabled)
+    this.statusTarget.textContent = `Push notifications are ${enabled ? "on" : "off"} for this device.`
+    this.helpTarget.hidden = true
+    this.buttonTarget.disabled = false
+  }
+
+  #showHelp(message) {
+    this.statusTarget.textContent = message
+    this.helpTarget.hidden = false
+  }
+}
+
+async function endpointDigest(endpoint) {
+  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(endpoint))
+  return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, "0")).join("")
+}
