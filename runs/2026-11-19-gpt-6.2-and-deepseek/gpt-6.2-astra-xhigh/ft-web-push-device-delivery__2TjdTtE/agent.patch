diff --git a/test/models/push/delivery_test.rb b/test/models/push/delivery_test.rb
new file mode 100644
index 0000000..fdf5a6e
--- /dev/null
+++ b/test/models/push/delivery_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Push::DeliveryTest < ActiveSupport::TestCase
+  setup do
+    @vapid = WebPush.generate_key
+    Push.stubs(:configured?).returns(true)
+    Push.stubs(:vapid).returns(@vapid.to_h.merge(subject: "https://fizzy.example.org"))
+    @subscription = users(:david).push_subscriptions.create!(endpoint: "https://push.example.org/browser", p256dh_key: WebPush.generate_key.public_key, auth_key: SecureRandom.urlsafe_base64(16))
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "delivers an encrypted and VAPID-signed web push" do
+    request = stub_request(:post, @subscription.endpoint).with(ipaddr: "93.184.216.34",
+      headers: { "Authorization" => /\Avapid t=.+,k=#{Regexp.escape(@vapid.public_key.delete('='))}\z/, "Content-Encoding" => "aes128gcm" }) { |req|
+      req.body.present? && !req.body.include?(cards(:logo).title)
+    }.to_return(status: 201)
+
+    Push::DeliveryJob.perform_now(@subscription, events(:logo_assignment_jz))
+
+    assert_requested request
+  end
+
+  test "uses the tray's assignment text and the tenanted card path" do
+    assert_push_message events(:logo_assignment_jz), title: cards(:logo).title, body: "Assigned to JZ", url: card_path(cards(:logo))
+  end
+
+  test "uses the tray's comment text and links to the comment on the card" do
+    comment = events(:layout_commented).eventable
+    assert_push_message events(:layout_commented), title: "RE: Layout is broken", body: comment.body.to_plain_text.truncate(200), url: comment_path_on_card(comment)
+  end
+
+  test "uses the tray's mention text and links to the mention on the card" do
+    mention = mentions(:logo_comment_david_mention_by_jz)
+    assert_push_message mention, title: "JZ @mentioned you", body: mention.source.mentionable_content.truncate(200), url: comment_path_on_card(mention.source)
+  end
+
+  test "a gone device is removed" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 410)
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver(events(:logo_assignment_jz))
+    end
+  end
+
+  test "transient push service errors do not unregister the device" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 503)
+    assert_enqueued_with job: Push::DeliveryJob do
+      Push::DeliveryJob.perform_now(@subscription, events(:logo_assignment_jz))
+    end
+    assert Push::Subscription.exists?(@subscription.id)
+  end
+
+  test "does not deliver to private addresses" do
+    SsrfProtection.stubs(:resolve_public_ip).returns(nil)
+    request = stub_request(:post, @subscription.endpoint)
+    @subscription.deliver(events(:logo_assignment_jz))
+    assert_not_requested request
+  end
+
+  test "does not deliver after losing access to a card" do
+    accesses(:writebook_david).destroy!
+    request = stub_request(:post, @subscription.endpoint)
+    @subscription.deliver(events(:logo_assignment_jz))
+    assert_not_requested request
+  end
+
+  private
+    def assert_push_message(source, **payload)
+      WebPush::Encryption.expects(:encrypt).with(JSON.generate(payload), @subscription.p256dh_key, @subscription.auth_key).returns("ciphertext")
+      stub_request(:post, @subscription.endpoint).to_return(status: 201)
+      @subscription.deliver(source)
+    end
+
+    def card_path(card)
+      "#{card.account.slug}/cards/#{card.number}"
+    end
+
+    def comment_path_on_card(comment)
+      "#{card_path(comment.card)}##{ActionView::RecordIdentifier.dom_id(comment)}"
+    end
+end
