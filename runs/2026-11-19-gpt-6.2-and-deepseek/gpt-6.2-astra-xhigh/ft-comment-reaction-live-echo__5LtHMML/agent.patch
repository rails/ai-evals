new file mode 100644
index 0000000..0849502
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,24 @@
+class Reaction < ApplicationRecord
+  MAX_LENGTH = 16
+
+  belongs_to :comment
+  belongs_to :account, default: -> { comment&.account }
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: MAX_LENGTH }
+
+  after_create_commit :broadcast_addition
+  after_destroy_commit :broadcast_removal
+
+  private
+    def broadcast_addition
+      broadcast_append_later_to comment.card, :activity, target: [ comment, :reactions ], partial: "cards/comments/reactions/reaction"
+    end
+
+    def broadcast_removal
+      # The comment may already be gone during account deletion.
+      if card = comment&.card
+        broadcast_remove_to card, :activity
+      end
+    end
+end
