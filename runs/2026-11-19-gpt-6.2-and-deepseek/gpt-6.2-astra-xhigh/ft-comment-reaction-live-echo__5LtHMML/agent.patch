+<%= turbo_frame_tag @comment, :new_reaction do %>
+  <%= form_with model: [ @card, @comment, @reaction ], class: "reaction reaction__form expanded",
+        data: { controller: "form", action: "keydown.esc->form#cancel:stop" } do |form| %>
+    <%= form.label :content, "Reaction", class: "for-screen-reader", for: dom_id(@comment, :reaction_content) %>
+    <%# Unlike maxlength (UTF-16 units), a Unicode pattern counts emoji the same way as the model. %>
+    <%= form.text_field :content, id: dom_id(@comment, :reaction_content), class: "input reaction__input", required: true, autofocus: true,
+          pattern: "(?=.*\\S).{1,#{Reaction::MAX_LENGTH}}", placeholder: "React…", title: "Enter up to #{Reaction::MAX_LENGTH} characters", autocomplete: "off" %>
+
+    <%= form.button class: "btn btn--circle borderless reaction__submit-btn" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm reaction</span>
+    <% end %>
+    <%= link_to card_comment_path(@card, @comment), class: "btn btn--circle borderless reaction__cancel-btn", data: { form_target: "cancel" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel reaction</span>
+    <% end %>
+  <% end %>
+<% end %>
