diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..5287738
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,66 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "reacting to a comment while another viewer has a reaction in progress" do
+    comment = comments(:logo_agreement_jz)
+    reaction = "Lovely work! 🎉🎉🎉"
+    open_card_as users(:kevin), comment.card
+
+    using_session(:other_viewer) do
+      open_card_as users(:jz), comment.card
+      within "##{dom_id(comment)}" do
+        click_on "Add reaction"
+        fill_in "Reaction", with: "My draft"
+      end
+    end
+
+    within "##{dom_id(comment)}" do
+      click_on "Add reaction"
+      fill_in "Reaction", with: "a" * 17
+      click_on "Confirm reaction"
+      assert_selector ".reaction__input:invalid"
+
+      fill_in "Reaction", with: reaction
+      click_on "Confirm reaction"
+      assert_button "Add reaction"
+      assert_no_field "Reaction"
+      assert_selector ".reactions__list .reaction", text: reaction, count: 1
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+    end
+
+    using_session(:other_viewer) do
+      within "##{dom_id(comment)}" do
+        assert_selector ".reaction", text: reaction
+        assert_field "Reaction", with: "My draft"
+        find(".reaction", text: reaction).click
+        assert_no_button "Remove reaction"
+        click_on "Cancel reaction"
+        assert_button "Add reaction"
+        assert_no_field "Reaction"
+      end
+    end
+
+    within "##{dom_id(comment)}" do
+      assert_no_button "Remove reaction"
+      find(".reaction", text: reaction).click
+      click_on "Remove reaction"
+      assert_no_selector ".reactions__list .reaction"
+    end
+
+    using_session(:other_viewer) do
+      within "##{dom_id(comment)}" do
+        assert_no_selector ".reactions__list .reaction"
+      end
+    end
+  end
+
+  private
+    def open_card_as(user, card)
+      sign_in_as user
+      visit card_url(card)
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
