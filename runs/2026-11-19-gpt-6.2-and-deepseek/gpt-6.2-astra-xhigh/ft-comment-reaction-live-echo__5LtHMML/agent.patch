diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..5998128
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,46 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, :ensure_ownership, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.preload(reacter: :identity)
+  end
+
+  def new
+    @reaction = @comment.reactions.build
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(params.expect(reaction: [ :content ]))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream { render turbo_stream: turbo_stream.remove(@reaction) }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_ownership
+      head :forbidden unless @reaction.reacter == Current.user
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..0e9d261
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,27 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "label" ]
+  static values = { reacterId: String }
+
+  connect() {
+    if (this.#mine) {
+      this.element.classList.add("reaction--deleteable")
+      this.labelTarget.setAttribute("role", "button")
+      this.labelTarget.setAttribute("aria-expanded", this.element.classList.contains("expanded"))
+      this.labelTarget.tabIndex = 0
+    }
+  }
+
+  toggle(event) {
+    if (this.#mine && !event.target.closest("form")) {
+      event.preventDefault()
+      const expanded = this.element.classList.toggle("expanded")
+      this.labelTarget.setAttribute("aria-expanded", expanded)
+    }
+  }
+
+  get #mine() {
+    return this.reacterIdValue === Current.user?.id
+  }
+}
