diff --git a/config/initializers/upgrade_rotations.rb b/config/initializers/upgrade_rotations.rb
new file mode 100644
index 0000000..7ee1e4f
--- /dev/null
+++ b/config/initializers/upgrade_rotations.rb
@@ -0,0 +1,20 @@
+# frozen_string_literal: true
+
+# Read artifacts issued with Rails 7.0 defaults if we roll back to this
+# release. Rotations are readers only: the previous production release must
+# still be able to read everything we write. See docs/UPGRADE.md.
+Rails.application.config.after_initialize do |app|
+  # KeyGenerator on Rails 6.1 only implements PBKDF2-HMAC-SHA1. Match the
+  # Rails 7 application key generator, NOT KeyGenerator's standalone defaults.
+  future_key = lambda do |salt, length = 64|
+    OpenSSL::PKCS5.pbkdf2_hmac(app.secret_key_base, salt, 1000, length, 'SHA256')
+  end
+
+  dispatch = app.config.action_dispatch
+  cipher = dispatch.encrypted_cookie_cipher || 'aes-256-gcm'
+  key = future_key.call(dispatch.authenticated_encrypted_cookie_salt, ActiveSupport::MessageEncryptor.key_len(cipher))
+  dispatch.cookies_rotations.rotate :encrypted, key, :cipher => cipher
+  dispatch.cookies_rotations.rotate :signed, future_key.call(dispatch.signed_cookie_salt)
+
+  app.message_verifier(:mail_links).rotate(future_key.call('mail_links'))
+end
