diff --git a/test/rolling_upgrade/exchange.rb b/test/rolling_upgrade/exchange.rb
new file mode 100644
index 0000000..24d4cb9
--- /dev/null
+++ b/test/rolling_upgrade/exchange.rb
@@ -0,0 +1,26 @@
+# frozen_string_literal: true
+
+# Run the SAME script with bin/rails runner in two release checkouts (see
+# docs/UPGRADE.md). Unlike a same-process test, each side uses its own Rails
+# implementation, configured keys, serializers, rotations and metadata.
+abort 'Use RAILS_ENV=test' unless Rails.env.test?
+mode, path = ARGV
+abort 'Usage: exchange.rb (write|read) PATH' unless %w[write read].include?(mode) && path
+
+app = Rails.application
+jar = ActionDispatch::Request.new(app.env_config.dup).cookie_jar
+session_name = app.config.session_options.fetch(:key)
+session_data = {'session_id' => 'ab' * 16, 'user_id' => 3, 'tk' => 'test session token'}
+mail_data = {'user_id' => 3, 'issue_id' => 2}
+
+if mode == 'write'
+  jar.encrypted[session_name] = {value: session_data}
+  jar.signed['preference'] = 'compact'
+  File.write(path, JSON.generate([jar[session_name], jar['preference'], Mailer.mail_link_token(:unwatch, mail_data)]))
+else
+  jar[session_name], jar['preference'], link = JSON.parse(File.read(path))
+  abort 'Session unreadable' unless jar.encrypted[session_name] == session_data
+  abort 'Signed cookie unreadable' unless jar.signed['preference'] == 'compact'
+  abort 'Mail link unreadable' unless Mailer.verify_mail_link(link, :unwatch) == mail_data
+end
+puts "Rails #{Rails.version} (defaults #{app.config.loaded_config_version.inspect}): #{mode} OK"
