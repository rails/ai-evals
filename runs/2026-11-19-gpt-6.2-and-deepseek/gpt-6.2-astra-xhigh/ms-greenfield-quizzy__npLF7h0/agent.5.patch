diff --git a/test/jobs/finish_timed_round_job_test.rb b/test/jobs/finish_timed_round_job_test.rb
new file mode 100644
index 0000000..328efa2
--- /dev/null
+++ b/test/jobs/finish_timed_round_job_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class FinishTimedRoundJobTest < ActiveJob::TestCase
+  setup do
+    travel_to Time.utc(2026, 8, 4, 14)
+    @quiz = Quiz.create!(title: "Timed talk", timer_minutes: 1, timer_seconds: 30)
+    %w[First Second].each do |prompt|
+      @quiz.questions.create!(prompt: prompt, options: [{ text: "A", correct: true }, { text: "B" }])
+    end
+    @game = Game.create_for!(@quiz)
+    @player = @game.players.create!(name: "Alex", browser_key: "alex")
+  end
+
+  test "opening a question schedules its finish, even with no further requests" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0) # changes only future games
+    travel 5.minutes # time in the lobby doesn't count
+    assert_enqueued_with(job: FinishTimedRoundJob, args: [@game.id, 1], at: 90.seconds.from_now) do
+      @game.advance!(from: "lobby-0")
+    end
+    travel 89.seconds
+    @game.record_answer(@player, number: "1", option: 0)
+    perform_enqueued_jobs(at: Time.current)
+    assert_predicate @game.reload, :open?
+    travel 1.second
+    perform_enqueued_jobs(at: Time.current)
+    assert_predicate @game.reload, :closed?
+    assert_nil @game.closes_at
+    assert_equal 1, @player.reload.points
+
+    @game.advance!(from: "open-1") # old Finish in flight
+    FinishTimedRoundJob.perform_now(@game.id, 1) # duplicate wake-up
+    assert_equal "closed-1", @game.reload.version
+    assert_equal 1, @player.reload.points
+  end
+
+  test "a delayed job is not a grace period for changing the last pick" do
+    @game.advance!(from: "lobby-0")
+    travel 5.seconds
+    @game.record_answer(@player, number: "1", option: 1)
+    travel_to @game.reload.closes_at
+    @game.record_answer(@player, number: "1", option: 0)
+    assert_predicate @game.reload, :closed?
+    assert_equal 1, @game.current_round.answers.sole.option_index
+    assert_equal 0, @player.reload.points
+  end
+
+  test "finishing early and opening the next question gives it a fresh deadline" do
+    @game.advance!(from: "lobby-0")
+    first_deadline = @game.closes_at
+    travel 10.seconds
+    @game.advance!(from: "open-1")
+    @game.advance!(from: "closed-1")
+    assert_equal 90.seconds.from_now, @game.closes_at
+    travel_to first_deadline
+    perform_enqueued_jobs(at: Time.current)
+    assert_equal "open-2", @game.reload.version
+  end
+
+  test "untimed questions stay open without scheduling work" do
+    @quiz.update!(timer_minutes: 0, timer_seconds: 0)
+    untimed = Game.create_for!(@quiz)
+    assert_no_enqueued_jobs { untimed.advance!(from: "lobby-0") }
+    assert_nil untimed.closes_at
+    travel 1.day
+    untimed.finish_if_due!
+    assert_predicate untimed.reload, :open?
+  end
+end
