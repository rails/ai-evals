@@ -0,0 +1,46 @@
+require "application_system_test_case"
+
+class QuestionTimerTest < ApplicationSystemTestCase
+  test "only the projector counts down, then reveals answers without a click" do
+    quiz = Quiz.create!(title: "Lightning round")
+    %w[First Second].each do |prompt|
+      quiz.questions.create!(prompt: prompt, options: [{ text: "Yes", correct: true }, { text: "No" }])
+    end
+    visit moderate_quiz_path(quiz)
+    click_link "Settings"
+    assert_field "Timer minutes", with: "0", type: "number"
+    assert_field "Timer seconds", with: "0", type: "number"
+    fill_in "Timer seconds", with: "5"
+    click_button "Save quiz"
+    click_button "Start a game"
+    assert_no_selector "[role=timer]"
+    join_url = find(".lobby__url").text
+    using_session(:player) do
+      visit join_url
+      fill_in "Your name", with: "Pat"
+      click_button "Join"
+      assert_text "Hi, Pat!"
+    end
+
+    click_button "Start", exact: true
+    assert_selector "[role=timer]", text: "0:05"
+    using_session(:player) do
+      assert_button "Yes"
+      assert_no_selector "[role=timer]"
+      assert_no_text(/0:0\d/)
+      click_button "Yes"
+    end
+    assert_selector "[role=timer]", text: /0:0[2-4]/
+    refresh
+    assert_selector "[role=timer]", text: /0:0[1-4]/
+    assert_button "Next", wait: 6
+    assert_no_selector "[role=timer]"
+    using_session(:player) { assert_text "Correct!" }
+
+    click_button "Next"
+    assert_selector "[role=timer]", text: "0:05"
+    click_button "Finish"
+    assert_button "End quiz"
+    assert_no_selector "[role=timer]"
+  end
+end
