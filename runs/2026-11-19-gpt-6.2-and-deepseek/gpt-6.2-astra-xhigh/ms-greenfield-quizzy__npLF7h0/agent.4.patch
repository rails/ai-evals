+        execute <<~SQL
+          UPDATE players SET points = (
+            SELECT COUNT(*) FROM answers a JOIN game_rounds r ON r.id = a.game_round_id
+              JOIN games g ON g.id = r.game_id
+            WHERE a.player_id = players.id AND (g.phase IN ('closed', 'ended') OR r.number < g.round_number)
+              AND json_extract(r.options, '$[' || a.option_index || '].correct') = 1
+          )
+        SQL
+        execute <<~SQL
+          UPDATE game_rounds SET opened_at = games.updated_at FROM games
+          WHERE games.id = game_rounds.game_id AND games.phase = 'open' AND games.round_number = game_rounds.number
+        SQL
+      end
+    end
+  end
+end
