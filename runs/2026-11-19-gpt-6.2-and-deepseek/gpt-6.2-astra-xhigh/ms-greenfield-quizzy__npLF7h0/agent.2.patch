diff --git a/test/services/quiz_document_test.rb b/test/services/quiz_document_test.rb
new file mode 100644
index 0000000..bc68a89
--- /dev/null
+++ b/test/services/quiz_document_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class QuizDocumentTest < ActiveSupport::TestCase
+  setup do
+    @question = { text: "Choose", options: [ { text: "B" }, { text: "A", correct: true } ] }
+    @document = { title: "A talk", questions: [ @question ] }
+  end
+
+  test "missing flags take their defaults and blank rows are discarded as in the editor" do
+    @question[:options].insert(1, { text: " ", correct: true })
+    quiz = QuizDocument.import!(@document.to_json)
+    question = quiz.reload.questions.sole
+    assert question.active?
+    assert_equal [ { "text" => "B", "correct" => false }, { "text" => "A", "correct" => true } ], question.options
+  end
+
+  test "invalid quiz envelopes do not create even an empty quiz" do
+    [ nil, [], {}, @document.except(:questions), @document.merge(questions: {}),
+      @document.merge(title: "  "), @document.merge(title: 123) ].each do |data|
+      assert_invalid_import(data)
+    end
+  end
+
+  test "a malformed or unplayable later question rolls back the quiz and its earlier questions" do
+    invalid_questions = [
+      nil, @question.except(:text), @question.merge(text: " "), @question.merge(text: 123),
+      @question.merge(active: nil), @question.merge(active: "false"),
+      @question.except(:options), @question.merge(options: {}), @question.merge(options: [ 123 ]),
+      @question.merge(options: [ { text: "A", correct: 1 }, { text: "B" } ]),
+      @question.merge(options: [ { text: "A", correct: true }, { text: "  " } ]),
+      @question.merge(options: [ { text: " ", correct: true }, { text: "A" }, { text: "B" } ])
+    ]
+    invalid_questions.each do |invalid|
+      assert_invalid_import(@document.merge(questions: [ @question, invalid ]))
+    end
+  end
+
+  private
+    def assert_invalid_import(data)
+      assert_no_difference [ "Quiz.count", "Question.count" ] do
+        assert_raises(QuizDocument::Invalid) { QuizDocument.import!(data.to_json) }
+      end
+    end
+end
diff --git a/test/system/quiz_transfer_test.rb b/test/system/quiz_transfer_test.rb
new file mode 100644
index 0000000..c0b9a3f
--- /dev/null
+++ b/test/system/quiz_transfer_test.rb
@@ -0,0 +1,43 @@
+require "application_system_test_case"
+
+class QuizTransferTest < ApplicationSystemTestCase
+  test "copying an export into the import form opens a separate quiz with the same contents" do
+    original = Quiz.create!(title: "Frontend Fest 2026")
+    options = [ { "text" => "418", "correct" => false }, { "text" => "429", "correct" => true } ]
+    original.questions.create!(prompt: 'Which status means "Too Many Requests"?', options: options)
+    original.questions.create!(prompt: "What does </pre> mean?", active: false, options: options).move!(:up)
+
+    visit moderate_quiz_path(original)
+    click_link "Export"
+    assert_selector "pre", count: 1
+    exported = find("pre").text
+    assert_equal({ "title" => original.title, "questions" => [
+      { "text" => "What does </pre> mean?", "active" => false, "options" => options },
+      { "text" => 'Which status means "Too Many Requests"?', "active" => true, "options" => options }
+    ] }, JSON.parse(exported))
+
+    visit "/moderate"
+    click_button "Import quiz"
+    fill_in "Quiz JSON", with: exported
+    click_button "Import", exact: true
+    assert_selector "h1", exact_text: original.title
+    copy = Quiz.where(title: original.title).where.not(id: original.id).sole
+    assert_current_path moderate_quiz_path(copy)
+    assert_text "1 of 2 questions active"
+    click_link "Export"
+    assert_equal JSON.parse(exported), JSON.parse(find("pre").text)
+  end
+
+  test "a failed import leaves the JSON available for correction" do
+    visit "/moderate"
+    click_button "Import quiz"
+    fill_in "Quiz JSON", with: "not JSON"
+    click_button "Import", exact: true
+    assert_selector "[role=alert]"
+    assert_field "Quiz JSON", with: "not JSON"
+    fill_in "Quiz JSON", with: '{"title":"Empty quiz","questions":[]}'
+    click_button "Import", exact: true
+    assert_selector "h1", exact_text: "Empty quiz"
+    assert_text "No questions yet"
+  end
+end
