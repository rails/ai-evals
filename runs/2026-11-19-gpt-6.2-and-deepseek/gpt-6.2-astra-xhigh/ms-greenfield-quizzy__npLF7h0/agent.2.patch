diff --git a/app/services/quiz_document.rb b/app/services/quiz_document.rb
new file mode 100644
index 0000000..b9f3921
--- /dev/null
+++ b/app/services/quiz_document.rb
@@ -0,0 +1,57 @@
+module QuizDocument
+  class Invalid < StandardError; end
+
+  class << self
+    def export(quiz)
+      questions = quiz.questions.map do |question|
+        options = question.options.map { |row| { text: row.fetch("text"), correct: row.fetch("correct", false) } }
+        { text: question.prompt, active: question.active?, options: options }
+      end
+      JSON.pretty_generate({ title: quiz.title, questions: questions })
+    end
+
+    def import!(source)
+      data = JSON.parse(source)
+      raise Invalid, "Expected a quiz object with a title and questions." unless data.is_a?(Hash)
+      raise Invalid, "Title must be a string." unless data["title"].is_a?(String)
+      raise Invalid, "Questions must be an array." unless data["questions"].is_a?(Array)
+
+      Quiz.transaction(requires_new: true) do
+        quiz = Quiz.create!(title: data["title"])
+        data["questions"].each.with_index(1) do |entry, number|
+          quiz.questions.create!(question_attributes(entry))
+        rescue Invalid, ActiveRecord::RecordInvalid => error
+          raise Invalid, "Question #{number}: #{error.message}"
+        end
+        quiz
+      end
+    rescue JSON::ParserError
+      raise Invalid, "Invalid JSON. Paste a complete quiz JSON document."
+    rescue ActiveRecord::RecordInvalid => error
+      raise Invalid, error.message
+    end
+
+    private
+      def question_attributes(entry)
+        unless entry.is_a?(Hash) && entry["text"].is_a?(String)
+          raise Invalid, "Expected an object with a text string."
+        end
+        raise Invalid, "Options must be an array." unless entry["options"].is_a?(Array)
+
+        options = entry["options"].map.with_index(1) do |row, number|
+          unless row.is_a?(Hash) && row["text"].is_a?(String)
+            raise Invalid, "Option #{number} must be an object with a text string."
+          end
+          { text: row["text"], correct: boolean(row, "correct", default: false) }
+        end
+        { prompt: entry["text"], active: boolean(entry, "active", default: true), options: options }
+      end
+
+      def boolean(object, key, default:)
+        value = object.fetch(key, default)
+        return value if value == true || value == false
+
+        raise Invalid, "#{key} must be true or false."
+      end
+  end
+end
