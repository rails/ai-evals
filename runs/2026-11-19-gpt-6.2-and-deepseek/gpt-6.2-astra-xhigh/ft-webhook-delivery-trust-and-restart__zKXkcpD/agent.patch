diff --git a/test/jobs/webhook/delivery_job_test.rb b/test/jobs/webhook/delivery_job_test.rb
new file mode 100644
index 0000000..c430e38
--- /dev/null
+++ b/test/jobs/webhook/delivery_job_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveJob::TestCase
+  test "a subscribed board event sends one signed POST and records the outcome" do
+    webhook = webhooks(:active)
+    stub_dns_resolution("93.184.216.34")
+    receiver = stub_request(:post, webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 202)
+
+    event = cards(:logo).close(user: users(:david))
+    perform_enqueued_jobs(only: Webhook::DeliveryJob)
+
+    delivery = event.webhook_deliveries.sole
+    assert_equal webhook, delivery.webhook
+    assert delivery.completed?
+    assert delivery.succeeded?
+    assert_equal 202, delivery.response[:code]
+    assert_equal event.id, delivery.sanitized_request[:headers]["Idempotency-Key"]
+    assert_not delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+
+    Webhook::DeliveryJob.perform_now(delivery)
+    assert_requested receiver, times: 1
+    assert_requested :post, webhook.url do |request|
+      payload = JSON.parse(request.body)
+      assert_equal event.id, payload["id"]
+      assert_equal event.action, payload["action"]
+      assert_equal event.board_id, payload.dig("board", "id")
+      assert_includes payload.dig("eventable", "url"), "#{webhook.account.slug}/cards/"
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+    end
+  end
+
+  test "a comment event delivers comment JSON or a chat message according to the receiver" do
+    board = boards(:writebook)
+    webhook = webhooks(:active)
+    webhook.update!(subscribed_actions: %w[ comment_created ])
+    slack = board.webhooks.create!(name: "Slack", url: "https://hooks.slack.com/services/T123/B456/test", subscribed_actions: webhook.subscribed_actions) # gitleaks:allow
+    campfire = board.webhooks.create!(name: "Campfire", url: "https://chat.example.org/rooms/1/2-token/messages", subscribed_actions: webhook.subscribed_actions)
+    stub_dns_resolution("93.184.216.34")
+    [ webhook, slack, campfire ].each { |hook| stub_request(:post, hook.url).to_return(status: 200) }
+
+    comment = cards(:layout).comments.create!(body: "A new comment", creator: users(:david))
+    perform_enqueued_jobs(only: Webhook::DeliveryJob)
+
+    assert_requested :post, webhook.url do |request|
+      payload = JSON.parse(request.body)
+      assert_equal "comment_created", payload["action"]
+      assert_equal comment.id, payload.dig("eventable", "id")
+      assert_equal "A new comment", payload.dig("eventable", "body", "plain_text")
+    end
+    assert_requested :post, slack.url do |request|
+      text = JSON.parse(request.body).fetch("text")
+      assert_includes text, "commented on"
+      assert_includes text, "#{board.account.slug}/cards/#{comment.card.number}"
+    end
+    assert_requested :post, campfire.url do |request|
+      assert_equal "text/html", request.headers["Content-Type"]
+      assert_includes request.body, "commented on"
+      assert_includes request.body, "<a href="
+    end
+  end
+
+  test "a concurrent job cannot claim an in-progress delivery" do
+    delivery = webhook_deliveries(:pending)
+    stub_dns_resolution("93.184.216.34")
+    receiver = stub_request(:post, delivery.webhook.url).to_return do
+      assert_predicate delivery.reload, :in_progress?
+      Webhook::DeliveryJob.perform_now(Webhook::Delivery.find(delivery.id))
+      { status: 204 }
+    end
+
+    Webhook::DeliveryJob.perform_now(delivery)
+    assert_requested receiver, times: 1
+    assert_predicate delivery.reload, :succeeded?
+  end
+
+  test "a timeout is logged once even if the job is repeated" do
+    delivery = webhook_deliveries(:pending)
+    stub_dns_resolution("93.184.216.34")
+    receiver = stub_request(:post, delivery.webhook.url).to_timeout
+
+    2.times { Webhook::DeliveryJob.perform_now(delivery) }
+
+    assert_requested receiver, times: 1
+    assert_predicate delivery.reload, :errored?
+    assert_equal "timeout", delivery.response[:error]
+    assert_equal 1, delivery.webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "a redirect is logged as an unsuccessful HTTP response and not followed" do
+    delivery = webhook_deliveries(:pending)
+    stub_dns_resolution("93.184.216.34")
+    redirect = stub_request(:any, "https://other.example.com/")
+    stub_request(:post, delivery.webhook.url).to_return(status: 307, headers: { "Location" => "https://other.example.com/" })
+
+    delivery.deliver_now
+
+    assert_not_requested redirect
+    assert_predicate delivery.reload, :completed?
+    assert_predicate delivery, :failed?
+    assert_equal 307, delivery.response[:code]
+  end
+
+  test "a private destination is logged without making a request" do
+    delivery = webhook_deliveries(:pending)
+    stub_dns_resolution("127.0.0.1")
+    receiver = stub_request(:post, delivery.webhook.url)
+
+    delivery.deliver_now
+
+    assert_not_requested receiver
+    assert_predicate delivery.reload, :errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "queued deliveries cannot post after the webhook is deactivated or the card moves" do
+    delivery = webhook_deliveries(:pending)
+    webhook = delivery.webhook
+    receiver = stub_request(:post, webhook.url)
+    webhook.deactivate
+    delivery.deliver_now
+    assert_equal "webhook_inactive", delivery.reload.response[:error]
+
+    webhook.activate
+    event = cards(:logo).track_event(:published, creator: users(:david))
+    Current.user = users(:david)
+    cards(:logo).move_to(boards(:private))
+    delivery = event.webhook_deliveries.sole
+    delivery.deliver_now
+    assert_equal "event_moved", delivery.reload.response[:error]
+    assert_not_requested receiver
+  end
+end
