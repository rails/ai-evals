diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..15bf56c
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, @webhook.url).to_return(status: 503)
+  end
+
+  test "ten consecutive failures spanning an hour deactivate; reactivation starts fresh" do
+    freeze_time do
+      8.times { deliver_event }
+      travel 1.hour
+      deliver_event
+      assert_predicate @webhook.reload, :active?
+      deliver_event
+      assert_not_predicate @webhook.reload, :active?
+      assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+
+      assert_no_difference "Webhook::Delivery.count" do
+        cards(:logo).track_event(:published, creator: users(:david))
+      end
+
+      @webhook.activate
+      assert_nil @webhook.delinquency_tracker.first_failure_at
+      deliver_event
+      assert_predicate @webhook.reload, :active?
+      assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+    end
+  end
+
+  test "a short burst of failures does not deactivate, and a success breaks the streak" do
+    freeze_time do
+      10.times { deliver_event }
+      assert_predicate @webhook.reload, :active?
+      assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+
+      travel 1.hour
+      stub_request(:post, @webhook.url).to_return({ status: 204 }, { status: 503 })
+      deliver_event
+      assert_nil @webhook.reload.delinquency_tracker.first_failure_at
+      deliver_event
+      assert_predicate @webhook.reload, :active?
+      assert_equal Time.current, @webhook.delinquency_tracker.first_failure_at
+      assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+    end
+  end
+
+  private
+    def deliver_event
+      event = cards(:logo).track_event(:published, creator: users(:david))
+      event.webhook_deliveries.sole.deliver_now
+    end
+end
