@@ -10,6 +10,26 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).in_batches.delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    return unless claim
+
+    if !webhook.active?
+      update! state: :errored, response: { error: "webhook_inactive" }
+    elsif event.board_id != webhook.board_id || event.card.board_id != webhook.board_id
+      update! state: :errored, response: { error: "event_moved" }
+    else
+      post_event
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +49,22 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    # Commit the claim before touching the network. A repeated job cannot POST
+    # again, even if the receiver accepted a request but we lost its response.
+    def claim
+      if self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+        reload
+      end
+    end
+
+    def post_event
+      outbound = Webhook::Request.new(webhook, event)
+      update! request: { headers: outbound.headers.except("X-Webhook-Signature") }
+      webhook.record_delivery_result(self, outbound.post)
+    rescue ActionView::Template::Error => error
+      update! state: :errored, response: { error: "payload_error" }
+      Rails.error.report(error)
+    end
 end
diff --git a/app/models/webhook/request.rb b/app/models/webhook/request.rb
new file mode 100644
index 0000000..9e7e846
--- /dev/null
+++ b/app/models/webhook/request.rb
@@ -0,0 +1,72 @@
+class Webhook::Request
+  NETWORK_ERRORS = [ IOError, SystemCallError, SocketError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse,
+    Net::ProtocolError, Resolv::ResolvError, Resolv::DNS::EncodeError, Resolv::DNS::DecodeError ].freeze
+
+  def initialize(webhook, event)
+    @webhook, @event = webhook, event
+  end
+
+  def headers
+    @headers ||= {
+      "Content-Type" => html? ? "text/html" : "application/json",
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Idempotency-Key" => event.id,
+      "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    }
+  end
+
+  def post
+    uri = URI.parse(webhook.url)
+    if ip = public_ip(uri)
+      connection(uri, ip).request_post(uri.request_uri, body, headers) do |response|
+        return { code: response.code.to_i } # Don't follow redirects or buffer a response body.
+      end
+    else
+      { error: "destination_unreachable" }
+    end
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue URI::InvalidURIError, *NETWORK_ERRORS
+    { error: "destination_unreachable" }
+  end
+
+  private
+    attr_reader :webhook, :event
+
+    def public_ip(uri)
+      if uri.is_a?(URI::HTTP) && uri.hostname.present? && uri.port.between?(1, 65_535)
+        SsrfProtection.resolve_public_ip(uri.hostname)
+      end
+    end
+
+    # Pin the socket to the checked address without using an environment proxy.
+    # Keep the hostname for the Host header and TLS certificate verification.
+    def connection(uri, ip)
+      Net::HTTP.new(uri.hostname, uri.port, nil).tap do |http|
+        http.ipaddr = ip
+        http.use_ssl = uri.is_a?(URI::HTTPS)
+        http.open_timeout = http.read_timeout = http.write_timeout = 5
+        http.max_retries = 0
+      end
+    end
+
+    def html?
+      webhook.for_basecamp? || webhook.for_campfire?
+    end
+
+    def body
+      @body ||= if html?
+        render(:html)
+      elsif webhook.for_slack?
+        { text: render(:text).strip }.to_json
+      else
+        render(:json)
+      end
+    end
+
+    def render(format)
+      ApplicationController.renderer.new(script_name: event.account.slug).render(
+        template: "webhooks/event", formats: [ format ], layout: false, assigns: { event: event })
+    end
+end
