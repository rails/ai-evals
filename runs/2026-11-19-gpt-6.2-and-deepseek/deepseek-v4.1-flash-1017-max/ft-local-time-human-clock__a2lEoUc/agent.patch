diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..20b3008
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time renders only the raw timestamp" do
+    html = local_time(Time.utc(2025, 1, 22, 13, 42))
+
+    time = Nokogiri::HTML5.fragment(html).at_css("time")
+    assert_equal "2025-01-22T13:42:00Z", time["datetime"]
+    assert_equal "local-time", time["data-controller"]
+    assert_equal "relative", time["data-local-time-format-value"]
+    assert_equal "2025-01-22T13:42:00Z", time.text
+  end
+
+  test "local_time accepts a format" do
+    html = local_time(Time.utc(2025, 1, 22, 13, 42), format: :date)
+
+    time = Nokogiri::HTML5.fragment(html).at_css("time")
+    assert_equal "date", time["data-local-time-format-value"]
+  end
+
+  test "local_date renders a date-only timestamp" do
+    html = local_date(Date.new(2025, 1, 22), format: :weekday_date)
+
+    time = Nokogiri::HTML5.fragment(html).at_css("time")
+    assert_equal "2025-01-22", time["datetime"]
+    assert_equal "true", time["data-local-time-date-only-value"]
+    assert_equal "weekday_date", time["data-local-time-format-value"]
+  end
+end
diff --git a/test/system/local_time_rendering_test.rb b/test/system/local_time_rendering_test.rb
new file mode 100644
index 0000000..64a0777
--- /dev/null
+++ b/test/system/local_time_rendering_test.rb
@@ -0,0 +1,41 @@
+require "application_system_test_case"
+
+class LocalTimeRenderingTest < ApplicationSystemTestCase
+  test "formats timestamps in the browser" do
+    sign_in_as users(:kevin)
+
+    results = page.driver.browser.execute_async_script(<<~JS)
+      const done = arguments[arguments.length - 1]
+      import("helpers/date_helpers").then(({ formatLocalTime }) => {
+        const now = new Date("2025-01-22T17:30:00")
+        done({
+          twoHoursAgo: formatLocalTime(new Date("2025-01-22T15:30:00"), "relative", now),
+          lastNight: formatLocalTime(new Date("2025-01-21T23:00:00"), "relative", now),
+          fiveDaysAgo: formatLocalTime(new Date("2025-01-17T15:30:00"), "relative", now),
+          oldDate: formatLocalTime(new Date("2025-01-10T15:30:00"), "relative", now),
+          tomorrow: formatLocalTime(new Date("2025-01-23T09:00:00"), "relative", now),
+          inThreeDays: formatLocalTime(new Date("2025-01-25T09:00:00"), "relative", now),
+          time: formatLocalTime(new Date("2025-01-22T15:30:00"), "time", now),
+          weekdayDate: formatLocalTime(new Date("2025-01-10T15:30:00"), "weekday_date", now)
+        })
+      })
+    JS
+
+    assert_equal "3:30 PM", results["twoHoursAgo"]
+    assert_equal "yesterday", results["lastNight"]
+    assert_equal "5 days ago", results["fiveDaysAgo"]
+    assert_equal "Jan 10", results["oldDate"]
+    assert_equal "tomorrow", results["tomorrow"]
+    assert_equal "in 3 days", results["inThreeDays"]
+    assert_equal "3:30 PM", results["time"]
+    assert_equal "Friday, January 10", results["weekdayDate"]
+  end
+
+  test "renders timestamps through the local time controller" do
+    sign_in_as users(:kevin)
+
+    visit events_path
+
+    assert_selector "time[data-controller='local-time'][data-local-time-format-value='time']", text: /\d{1,2}:\d{2} [AP]M/
+  end
+end
