diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..14f2285 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,43 @@
 module TimeHelper
+  # Renders a <time> element containing only the raw timestamp. The browser is
+  # responsible for formatting it in the viewer's timezone.
+  #
+  # format can be one of: :relative, :time, :date, :full_date, :weekday_date,
+  # :datetime. See app/javascript/helpers/date_helpers.js for the exact output.
+  def local_time(time, format = nil, date_only: nil, **attributes)
+    return if time.blank?
+
+    format = attributes.delete(:format) || format || :relative
+    date_only = date_only?(time) if date_only.nil?
+
+    data = (attributes.delete(:data) || {}).merge(
+      controller: "local-time",
+      action: "turbo:morph-element->local-time#render",
+      local_time_format_value: format
+    )
+    data[:local_time_date_only_value] = true if date_only
+
+    timestamp = timestamp_for(time, date_only:)
+    tag.time(timestamp, **attributes, datetime: timestamp, data:)
+  end
+
+  def local_date(date, format = :date, **attributes)
+    local_time(date, format, date_only: true, **attributes)
+  end
+
+  alias_method :local_time_tag, :local_time
+  alias_method :local_date_tag, :local_date
+
+  private
+    def date_only?(time)
+      time.is_a?(Date) && !time.is_a?(Time)
+    end
+
+    def timestamp_for(time, date_only:)
+      if date_only
+        time.to_date.iso8601
+      else
+        time.utc.iso8601
+      end
+    end
 end
