+# Allows a test to request exception-raising behavior for its own requests without
+# changing application-wide configuration. Rails copies the application env_config
+# into each request, so the override is applied to the request environment immediately
+# before ShowExceptions handles it.
+module WithRaisedExceptionsRequestOverride
+  KEY = :writebook_with_raised_exceptions
+
+  def call(env)
+    env["action_dispatch.show_exceptions"] = :none if Thread.current[KEY]
+    super
+  end
+end
+
+ActionDispatch::ShowExceptions.prepend(WithRaisedExceptionsRequestOverride)
+
