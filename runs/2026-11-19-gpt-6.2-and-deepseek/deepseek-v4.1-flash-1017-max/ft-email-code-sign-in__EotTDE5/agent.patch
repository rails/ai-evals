+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  test "sign in by email code" do
+    identity = identities(:kevin)
+
+    assert_emails 1 do
+      untenanted do
+        post session_path, params: { email_address: identity.email_address }
+      end
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+    assert cookies[:pending_authentication_token].present?
+
+    email = ActionMailer::Base.deliveries.last
+    code = email.subject[/[A-Z0-9]{6}/]
+
+    assert_includes email.subject, code
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+    end
+
+    assert_redirected_to landing_path
+    assert cookies[:session_token].present?
+  end
+
+  test "invalid code does not sign in" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+    end
+
+    untenanted do
+      post session_magic_link_path, params: { code: "WRONG1" }
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+    assert_not cookies[:session_token].present?
+    assert_equal "That code didn't work. Try again.", flash[:alert]
+  end
+
+  test "code expires after fifteen minutes" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+    end
+
+    code = ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+
+    travel 16.minutes do
+      untenanted do
+        post session_magic_link_path, params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_session_path(script_name: nil)
+    assert_not cookies[:session_token].present?
+  end
+
+  test "sign up by email code" do
+    with_multi_tenant_mode(true) do
+      untenanted do
+        assert_difference -> { Identity.count }, 1 do
+          post signup_path, params: { signup: { email_address: "new-user@example.com" } }
+        end
+      end
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+
+    code = ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+    end
+
+    assert_redirected_to new_signup_completion_url(script_name: nil)
+    assert cookies[:session_token].present?
+  end
+
+  test "join an account by email code" do
+    account = accounts(:"37s")
+    join_code = account_join_codes(:"37s")
+
+    post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "joiner@example.com" }
+
+    assert_redirected_to new_session_magic_link_path(script_name: account.slug)
+    assert cookies[:pending_authentication_token].present?
+
+    code = ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+
+    post session_magic_link_path, params: { code: code }
+
+    assert_redirected_to new_users_join_url(script_name: account.slug)
+    assert cookies[:session_token].present?
+
+    identity = Identity.find_by!(email_address: "joiner@example.com")
+    user = account.users.find_by!(identity: identity)
+
+    assert user.verified?
+    assert_equal 1, join_code.reload.usage_count
+  end
+end
