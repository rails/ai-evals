diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..e9bd95b
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,124 @@
+class Sessions::MagicLinksController < ApplicationController
+  include EmailAuthentication
+
+  layout "public"
+  allow_unauthenticated_access
+  skip_before_action :require_account
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  def new
+    if pending_authentication.present? && !pending_authentication.expired?
+      @email_address = pending_authentication.email_address
+      @code = pending_authentication.code if Rails.env.development?
+    else
+      clear_pending_authentication
+      redirect_to new_session_path, alert: "That code has expired. Request a new one."
+    end
+  end
+
+  def create
+    if pending_authentication.present? && !pending_authentication.expired? && pending_authentication.matches?(code)
+      clear_pending_authentication
+      authenticate_with pending_authentication
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def pending_authentication
+      return @pending_authentication if defined?(@pending_authentication)
+
+      @pending_authentication = super
+    end
+
+    def code
+      params[:code].presence || params.dig(:magic_link, :code).presence
+    end
+
+    def authenticate_with(pending)
+      if pending.join?
+        join_account pending
+      else
+        identity = Identity.find_or_create_by!(email_address: pending.email_address)
+        start_session_for identity
+
+        respond_to do |format|
+          format.html { redirect_to redirect_after_authentication_for(pending, identity) }
+          format.json { render json: { session_token: session_token } }
+        end
+      end
+    end
+
+    def join_account(pending)
+      account = pending.account
+      join_code = account&.join_code
+
+      if join_code && join_code.code == pending.join_code && join_code.active?
+        identity = Identity.find_or_create_by!(email_address: pending.email_address)
+        start_session_for identity
+
+        join_code.redeem_if { |joined_account| identity.join(joined_account) }
+        user = User.active.find_by!(account: account, identity: identity)
+        user.verify
+
+        respond_to do |format|
+          format.html { redirect_after_join(account, user) }
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        invalid_code
+      end
+    end
+
+    def start_session_for(identity)
+      terminate_session if Current.session
+      start_new_session_for identity
+    end
+
+    def redirect_after_authentication_for(pending, identity)
+      if pending.sign_up? || identity.accounts.none?
+        new_signup_completion_url(script_name: nil)
+      else
+        after_authentication_url
+      end
+    end
+
+    def redirect_after_join(account, user)
+      if user.setup?
+        redirect_to landing_url(script_name: account.slug)
+      else
+        redirect_to new_users_join_url(script_name: account.slug)
+      end
+    end
+
+    def invalid_code
+      message = if pending_authentication.present? && !pending_authentication.expired?
+        "That code didn't work. Try again."
+      else
+        clear_pending_authentication
+        "That code has expired. Request a new one."
+      end
+
+      respond_to do |format|
+        format.html do
+          if pending_authentication.present? && !pending_authentication.expired?
+            redirect_to new_session_magic_link_path, alert: message
+          else
+            redirect_to new_session_path, alert: message
+          end
+        end
+
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
