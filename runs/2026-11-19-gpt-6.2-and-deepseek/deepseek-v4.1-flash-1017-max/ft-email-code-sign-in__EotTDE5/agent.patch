+
+    post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "flow-join@example.com" }
+    code = ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+
+    post session_magic_link_path, params: { code: code }
+    assert_redirected_to new_users_join_url(script_name: account.slug)
