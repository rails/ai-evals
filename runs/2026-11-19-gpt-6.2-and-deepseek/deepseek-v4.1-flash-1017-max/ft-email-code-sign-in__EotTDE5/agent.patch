+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: code }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "accepts the pending token as a parameter" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path(format: :json), params: { email_address: identity.email_address }
+    end
+
+    pending_token = @response.parsed_body["pending_authentication_token"]
+    code = ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+
+    cookies.delete :pending_authentication_token
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: code, pending_authentication_token: pending_token }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+end
