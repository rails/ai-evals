diff --git a/app/models/pending_authentication.rb b/app/models/pending_authentication.rb
new file mode 100644
index 0000000..061a69a
--- /dev/null
+++ b/app/models/pending_authentication.rb
@@ -0,0 +1,90 @@
+class PendingAuthentication
+  EXPIRATION = 15.minutes
+
+  attr_reader :email_address, :code, :flow, :account_id, :join_code
+
+  class << self
+    def start(email_address:, flow:, account: nil, join_code: nil)
+      new(
+        email_address: email_address,
+        code: SecureRandom.alphanumeric(6).upcase,
+        flow: flow,
+        account_id: account&.id,
+        join_code: join_code
+      )
+    end
+
+    def from_token(token)
+      if token.present?
+        payload = JSON.parse(encryptor.decrypt_and_verify(Base64.urlsafe_decode64(token)))
+        new(**payload.symbolize_keys)
+      end
+    rescue ArgumentError, JSON::ParserError, OpenSSL::Cipher::CipherError,
+      ActiveSupport::MessageEncryptor::InvalidMessage, ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+
+    private
+      def encryptor
+        @encryptor ||= ActiveSupport::MessageEncryptor.new(
+          Rails.application.key_generator.generate_key("pending_authentication", 32),
+          cipher: "aes-256-gcm"
+        )
+      end
+  end
+
+  def initialize(email_address:, code:, flow:, account_id: nil, join_code: nil, expires_at: nil)
+    @email_address = email_address
+    @code = code
+    @flow = flow.to_s
+    @account_id = account_id
+    @join_code = join_code
+    @expires_at = expires_at ? Time.zone.at(expires_at) : EXPIRATION.from_now
+  end
+
+  def token
+    @token ||= Base64.urlsafe_encode64(encryptor.encrypt_and_sign(payload.to_json), padding: false)
+  end
+
+  def expired?
+    @expires_at <= Time.current
+  end
+
+  def matches?(candidate)
+    candidate = candidate.to_s.strip.upcase
+
+    candidate.present? && !expired? && ActiveSupport::SecurityUtils.secure_compare(code, candidate)
+  end
+
+  def account
+    @account ||= Account.find_by(id: account_id) if account_id
+  end
+
+  def sign_in?
+    flow == "sign_in"
+  end
+
+  def sign_up?
+    flow == "sign_up"
+  end
+
+  def join?
+    flow == "join"
+  end
+
+  private
+    def payload
+      {
+        email_address: email_address,
+        code: code,
+        flow: flow,
+        account_id: account_id,
+        join_code: join_code,
+        expires_at: @expires_at.to_f
+      }
+    end
+
+    def encryptor
+      self.class.send(:encryptor)
+    end
+end
