+class Sessions::MagicLinksApiTest < ActionDispatch::IntegrationTest
+  test "requests and verifies a code via JSON" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path(format: :json), params: { email_address: identity.email_address }
+      end
