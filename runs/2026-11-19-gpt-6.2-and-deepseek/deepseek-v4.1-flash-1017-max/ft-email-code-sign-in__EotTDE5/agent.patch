@@ -0,0 +1,12 @@
+class IdentityMailer < ApplicationMailer
+  def sign_in_code(email_address = nil, code = nil, **options)
+    recipient = email_address || options[:email_address] || options[:identity]
+    recipient = recipient.email_address if recipient.respond_to?(:email_address)
+
+    @code = code || options[:code]
+
+    mail to: recipient, subject: "Your Fizzy sign-in code is #{@code}"
+  end
+  alias_method :magic_link, :sign_in_code
+  alias_method :verification_code, :sign_in_code
+end
