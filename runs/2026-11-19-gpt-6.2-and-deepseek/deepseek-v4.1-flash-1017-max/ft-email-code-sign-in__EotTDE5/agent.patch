+    get new_users_join_url(script_name: account.slug)
+    assert_response :success
+
+    post users_joins_url(script_name: account.slug), params: { user: { name: "Flow Joiner" } }
+    assert_redirected_to landing_url(script_name: account.slug)
+
+    user = account.users.find_by!(identity: Identity.find_by!(email_address: "flow-join@example.com"))
+    assert_equal "Flow Joiner", user.name
+    assert user.verified?
+  end
+end
