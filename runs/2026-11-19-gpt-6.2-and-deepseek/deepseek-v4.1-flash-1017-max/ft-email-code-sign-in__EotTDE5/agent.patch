new file mode 100644
index 0000000..858e7cb
--- /dev/null
+++ b/app/controllers/concerns/email_authentication.rb
@@ -0,0 +1,45 @@
+module EmailAuthentication
+  extend ActiveSupport::Concern
+
+  PENDING_AUTHENTICATION_COOKIE = :pending_authentication_token
+
+  private
+    def request_email_code(email_address:, flow:, account: nil, join_code: nil, deliver: true)
+      pending = PendingAuthentication.start(
+        email_address: email_address,
+        flow: flow,
+        account: account,
+        join_code: join_code
+      )
+
+      cookies[PENDING_AUTHENTICATION_COOKIE] = {
+        value: pending.token,
+        expires: PendingAuthentication::EXPIRATION.from_now,
+        httponly: true,
+        same_site: :lax
+      }
+
+      if deliver
+        IdentityMailer.sign_in_code(email_address: email_address, code: pending.code).deliver_now
+        Rails.logger.info "Fizzy sign-in code for #{email_address}: #{pending.code}"
+      end
+
+      pending
+    end
+
+    def respond_with_email_code_requested(pending)
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path }
+        format.json { render json: { pending_authentication_token: pending.token }, status: :created }
+      end
+    end
+
+    def pending_authentication
+      token = params[:pending_authentication_token].presence || cookies[PENDING_AUTHENTICATION_COOKIE].presence
+      PendingAuthentication.from_token(token)
+    end
+
+    def clear_pending_authentication
+      cookies.delete(PENDING_AUTHENTICATION_COOKIE)
+    end
+end
