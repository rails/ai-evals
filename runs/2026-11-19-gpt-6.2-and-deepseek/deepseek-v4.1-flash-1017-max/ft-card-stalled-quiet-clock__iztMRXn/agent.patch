diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..f6b9f13
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,31 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_AFTER = 2.weeks
+
+  included do
+    alias_attribute :burst_at, :last_burst_at
+    scope :stalled, -> { where.not(last_burst_at: nil).where(last_active_at: ..STALL_AFTER.ago) }
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at <= STALL_AFTER.ago
+  end
+
+  def burst?
+    last_burst_at.present?
+  end
+
+  def detect_burst_from_comment(comment)
+    window = auto_postpone_period / 3
+    comments_in_window = comments.by_user.where(created_at: (comment.created_at - window)..comment.created_at)
+
+    if comments_in_window.count >= 3 && comments_in_window.distinct.count(:creator_id) >= 2
+      record_burst
+    end
+  end
+
+  def record_burst
+    update_columns last_burst_at: Time.current, last_active_at: Time.current, updated_at: Time.current
+  end
+end
