diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..fa8adeb
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "a burst is recorded when three comments from two people land within a third of the board period" do
+    card = boards(:writebook).cards.create!(title: "Bursty card", creator: users(:david), status: :published)
+
+    travel_to 3.days.ago do
+      card.comments.create!(body: "First", creator: users(:david))
+    end
+
+    travel_to 2.days.ago do
+      card.comments.create!(body: "Second", creator: users(:kevin))
+    end
+
+    travel_to 1.day.ago do
+      card.comments.create!(body: "Third", creator: users(:david))
+    end
+
+    assert card.reload.last_burst_at.present?
+  end
+
+  test "comments from only one person do not make a burst" do
+    card = boards(:writebook).cards.create!(title: "Not bursty card", creator: users(:david), status: :published)
+
+    travel_to 3.days.ago do
+      card.comments.create!(body: "First", creator: users(:david))
+    end
+
+    travel_to 2.days.ago do
+      card.comments.create!(body: "Second", creator: users(:david))
+    end
+
+    travel_to 1.day.ago do
+      card.comments.create!(body: "Third", creator: users(:david))
+    end
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "comments spread beyond the burst window do not make a burst" do
+    card = boards(:writebook).cards.create!(title: "Slow card", creator: users(:david), status: :published)
+
+    travel_to 40.days.ago do
+      card.comments.create!(body: "Old first", creator: users(:david))
+    end
+
+    travel_to 35.days.ago do
+      card.comments.create!(body: "Old second", creator: users(:kevin))
+    end
+
+    travel_to 1.day.ago do
+      card.comments.create!(body: "Recent third", creator: users(:david))
+    end
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "assignment makes a burst" do
+    card = cards(:layout)
+
+    card.toggle_assignment(users(:kevin))
+
+    assert card.reload.last_burst_at.present?
+  end
+
+  test "reopening makes a burst" do
+    card = cards(:shipping)
+
+    card.reopen
+
+    assert card.reload.last_burst_at.present?
+  end
+
+  test "a card is stalled after two weeks without activity when it had a burst" do
+    card = cards(:logo)
+    card.update_columns(last_burst_at: 15.days.ago, last_active_at: 15.days.ago)
+
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "a card without a burst is not stalled" do
+    card = cards(:logo)
+    card.update_columns(last_burst_at: nil, last_active_at: 15.days.ago)
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "activity resets a stalled card" do
+    card = cards(:logo)
+    card.update_columns(last_burst_at: 15.days.ago, last_active_at: 15.days.ago)
+
+    card.comments.create!(body: "Some renewed activity", creator: users(:kevin))
+
+    assert_not card.reload.stalled?
+  end
+end
