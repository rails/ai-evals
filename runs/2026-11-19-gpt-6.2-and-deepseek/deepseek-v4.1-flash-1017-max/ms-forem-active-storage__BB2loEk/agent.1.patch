diff --git a/lib/active_storage/service/fog_service.rb b/lib/active_storage/service/fog_service.rb
new file mode 100644
index 0000000..9c191db
--- /dev/null
+++ b/lib/active_storage/service/fog_service.rb
@@ -0,0 +1,137 @@
+require "fog/aws"
+
+module ActiveStorage
+  # Active Storage adapter backed by the Fog storage client that Forem
+  # already uses for CarrierWave. This keeps production profile-image
+  # uploads on the same S3 infrastructure without adding a second AWS SDK
+  # dependency.
+  class Service::FogService < Service # rubocop:disable Style/ClassAndModuleChildren
+    CHUNK_SIZE = 5.megabytes
+
+    attr_reader :bucket, :directory
+
+    def initialize(bucket:, credentials: {}, public: false, **)
+      super()
+      @bucket = bucket
+      @public = public
+      fog_credentials = credentials.deep_symbolize_keys.reject do |key, value|
+        value.blank? && key != :use_iam_profile
+      end
+      @connection = Fog::Storage.new(fog_credentials)
+      @directory = @connection.directories.get(bucket) ||
+        @connection.directories.create(key: bucket, public: public)
+    end
+
+    def upload(key, io, checksum: nil, content_type: nil, disposition: nil, filename: nil, **)
+      io.rewind if io.respond_to?(:rewind)
+
+      options = {
+        key: key,
+        body: io,
+        public: public?
+      }
+      options[:content_type] = content_type if content_type
+      if disposition && filename
+        options[:content_disposition] = content_disposition_with(type: disposition, filename: filename)
+      end
+
+      instrument :upload, key: key, checksum: checksum do
+        directory.files.create(options)
+      end
+    end
+
+    def download(key, &block)
+      if block
+        instrument :streaming_download, key: key do
+          stream(key, &block)
+        end
+      else
+        instrument :download, key: key do
+          file_body(key)
+        end
+      end
+    end
+
+    def download_chunk(key, range)
+      instrument :download_chunk, key: key, range: range do
+        body = file_body(key)
+        body.byteslice(range.begin, range.size)
+      end
+    end
+
+    def delete(key)
+      instrument :delete, key: key do
+        file_for(key)&.destroy
+      end
+    end
+
+    def delete_prefixed(prefix)
+      instrument :delete_prefixed, prefix: prefix do
+        directory.files.each do |file|
+          file.destroy if file.key.start_with?(prefix)
+        end
+      end
+    end
+
+    def exist?(key)
+      instrument :exist, key: key do |payload|
+        exists = !file_for(key).nil?
+        payload[:exist] = exists
+        exists
+      end
+    end
+
+    def url(key, expires_in: 5.minutes, filename: nil, disposition: nil, content_type: nil, **)
+      instrument :url, key: key do |payload|
+        file = file_for(key)
+        raise ActiveStorage::FileNotFoundError unless file
+
+        generated_url = if public?
+                          file.public_url
+                        else
+                          options = {}
+                          if disposition && filename
+                            options[:response_content_disposition] =
+                              content_disposition_with(type: disposition, filename: filename)
+                          end
+                          options[:response_content_type] = content_type if content_type
+                          file.url(Time.current + expires_in, options)
+                        end
+
+        payload[:url] = generated_url
+        generated_url
+      end
+    end
+
+    def url_for_direct_upload(_key, expires_in:, content_type:, content_length:, checksum:, custom_metadata: {})
+      raise NotImplementedError, "Direct uploads are not supported by the Fog Active Storage adapter"
+    end
+
+    def headers_for_direct_upload(_key, content_type:, **)
+      { "Content-Type" => content_type }
+    end
+
+    private
+
+    def file_for(key)
+      directory.files.head(key)
+    end
+
+    def file_body(key)
+      file = file_for(key)
+      raise ActiveStorage::FileNotFoundError unless file
+
+      body = file.body
+      body.is_a?(String) ? body.b : body.read.b
+    end
+
+    def stream(key)
+      body = file_body(key)
+      offset = 0
+      while offset < body.bytesize
+        yield body.byteslice(offset, CHUNK_SIZE)
+        offset += CHUNK_SIZE
+      end
+    end
+  end
+end
diff --git a/spec/models/profile_image_attachable_spec.rb b/spec/models/profile_image_attachable_spec.rb
new file mode 100644
index 0000000..b23eba8
--- /dev/null
+++ b/spec/models/profile_image_attachable_spec.rb
@@ -0,0 +1,119 @@
+require "rails_helper"
+
+RSpec.describe ProfileImageAttachable do
+  def profile_upload
+    Rack::Test::UploadedFile.new(Rails.root.join("spec/support/fixtures/images/image1.jpeg"), "image/jpeg")
+  end
+
+  describe "new uploads" do
+    it "stores new user profile images in Active Storage" do
+      user = create(:user, profile_image: profile_upload)
+
+      expect(user.profile_image).to respond_to(:attached?)
+      expect(user.profile_image.attached?).to be(true)
+      expect(ActiveStorage::Attachment.where(record: user, name: "profile_image")).to exist
+      expect(user.profile_image_url).to include("/rails/active_storage/")
+    end
+
+    it "stores new organization profile images in Active Storage" do
+      organization = create(:organization, profile_image: profile_upload)
+
+      expect(organization.profile_image).to respond_to(:attached?)
+      expect(organization.profile_image.attached?).to be(true)
+      expect(organization.profile_image_url).to include("/rails/active_storage/")
+    end
+
+    it "serializes unsaved records without generating an Active Storage URL" do
+      user = build(:user)
+
+      expect(user.profile_image_url).to be_nil
+      expect { user.as_json }.not_to raise_error
+    end
+  end
+
+  describe "legacy CarrierWave images" do
+    it "still resolves a legacy user profile image" do
+      user = create(:user)
+      user.profile_image.detach
+      user.update_column(:profile_image, "legacy-user-image.png")
+
+      expect(user.reload.profile_image_url)
+        .to include("/uploads/user/profile_image/#{user.id}/legacy-user-image.png")
+    end
+
+    it "still resolves a legacy organization profile image" do
+      organization = create(:organization)
+      organization.profile_image.detach
+      organization.update_column(:profile_image, "legacy-org-image.png")
+
+      expect(organization.reload.profile_image_url)
+        .to include("/uploads/organization/profile_image/#{organization.id}/legacy-org-image.png")
+    end
+
+    it "accepts an old CarrierWave filename on user and organization" do
+      user = create(:user, profile_image: nil)
+      user.update!(profile_image: "old-user.png")
+      expect(user.reload.profile_image_url)
+        .to include("/uploads/user/profile_image/#{user.id}/old-user.png")
+
+      organization = create(:organization, profile_image: "old-org.png")
+      expect(organization.profile_image_url)
+        .to include("/uploads/organization/profile_image/#{organization.id}/old-org.png")
+    end
+  end
+
+  describe "remote uploads" do
+    it "downloads and attaches a remote image for a user and organization" do
+      url = "https://example.com/remote-profile.jpg"
+      body = Rails.root.join("spec/support/fixtures/images/image1.jpeg").binread
+      stub_request(:get, url).to_return(body: body, headers: { "Content-Type" => "image/jpeg" })
+
+      user = create(:user, profile_image: nil)
+      user.update!(remote_profile_image_url: url)
+      expect(user.reload.profile_image).to be_attached
+      expect(user.profile_image_url).to include("/rails/active_storage/")
+
+      organization = create(:organization, profile_image: nil, remote_profile_image_url: url)
+      expect(organization.reload.profile_image).to be_attached
+      expect(organization.profile_image_url).to include("/rails/active_storage/")
+    end
+
+    it "infers an extension from the remote content type" do
+      url = "https://example.com/remote-profile"
+      body = Rails.root.join("spec/support/fixtures/images/image1.jpeg").binread
+      stub_request(:get, url).to_return(body: body, headers: { "Content-Type" => "image/jpeg" })
+
+      user = create(:user, profile_image: nil)
+      user.update!(remote_profile_image_url: url)
+
+      expect(user.reload.profile_image).to be_attached
+      expect(user.profile_image.filename.to_s).to end_with(".jpeg")
+    end
+  end
+
+  describe "other CarrierWave uploads" do
+    it "leaves organization cover images on CarrierWave" do
+      expect(Organization.uploaders).to include(:cover_image)
+      expect(Organization.uploaders).not_to include(:profile_image)
+    end
+  end
+
+  describe "validation" do
+    it "rejects unsupported extensions" do
+      user = build(:user, profile_image: fixture_file_upload("800x600.pdf", "application/pdf"))
+      expect(user).not_to be_valid
+      expect(user.errors[:profile_image]).to include("must be a supported image type")
+    end
+
+    it "rejects files larger than 8 MB" do
+      file = Tempfile.new(["large-profile", ".jpg"])
+      file.write("0" * (8.megabytes + 1))
+      file.rewind
+      user = build(:user, profile_image: Rack::Test::UploadedFile.new(file.path, "image/jpeg"))
+      expect(user).not_to be_valid
+      expect(user.errors[:profile_image]).to include("File size should be less than 8 MB")
+    ensure
+      file&.close!
+    end
+  end
+end
