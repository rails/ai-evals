diff --git a/app/models/concerns/profile_image_attachable.rb b/app/models/concerns/profile_image_attachable.rb
new file mode 100644
index 0000000..aa2354f
--- /dev/null
+++ b/app/models/concerns/profile_image_attachable.rb
@@ -0,0 +1,151 @@
+# Shared behavior for models whose profile image is moving from CarrierWave
+# to Active Storage.
+#
+# During the migration, new uploads are stored as Active Storage attachments,
+# while existing CarrierWave filenames remain in the model's +profile_image+
+# database column. Reads must transparently support both representations until
+# the legacy data is backfilled.
+module ProfileImageAttachable
+  extend ActiveSupport::Concern
+
+  PROFILE_IMAGE_EXTENSIONS = %w[jpg jpeg jpe gif png ico bmp dng webp].freeze
+
+  included do
+    has_one_attached :profile_image, dependent: :purge
+
+    after_save :track_profile_image_attachment_change
+    validate :validate_profile_image_attachment
+    before_validation :attach_remote_profile_image, if: :remote_profile_image_pending?
+  end
+
+  # Assigning a URL to +profile_image+ used to be handled by CarrierWave. Keep
+  # accepting URLs so authentication providers and other callers can continue
+  # to assign remote images during the transition.
+  def profile_image=(attachable)
+    if attachable.is_a?(String)
+      if attachable.match?(%r{\Ahttps?://}i)
+        self.remote_profile_image_url = attachable
+      elsif attachable.include?(".") || attachable.include?("/")
+        # Preserve the ability to assign an old CarrierWave filename while the
+        # migration is in progress. Signed Active Storage blob IDs do not
+        # contain dots or slashes.
+        self[:profile_image] = attachable
+      else
+        super
+      end
+    else
+      super
+    end
+  end
+
+  def remote_profile_image_url=(url)
+    candidate = url.to_s.presence
+    @remote_profile_image_url = candidate if candidate&.match?(%r{\Ahttps?://}i)
+  end
+
+  def remote_profile_image_url
+    @remote_profile_image_url
+  end
+
+  # The old CarrierWave value. Active Storage shadows the +profile_image+
+  # column reader, so the raw attribute must be read explicitly.
+  def legacy_profile_image
+    self[:profile_image].presence
+  end
+
+  # A single URL accessor for both storage backends. New Active Storage
+  # attachments take precedence; otherwise the existing CarrierWave URL is
+  # used, keeping currently-visible profile pictures intact.
+  def active_storage_profile_image_attached?
+    profile_image.respond_to?(:attached?) && profile_image.attached?
+  end
+
+  def profile_image_url
+    if active_storage_profile_image_attached?
+      active_storage_profile_image_url
+    elsif legacy_profile_image.present?
+      legacy_profile_image_url
+    end
+  end
+
+  def profile_image_url_for(length:)
+    Images::Profile.call(profile_image_url, length: length)
+  end
+
+  # Serializers should receive the URL rather than the Active Storage
+  # attachment proxy. Without this, rendering the model as JSON recursively
+  # serializes the attachment and its parent record.
+  def read_attribute_for_serialization(key)
+    key.to_s == "profile_image" ? profile_image_url : super
+  end
+
+  # True when the most recent save changed the Active Storage attachment.
+  # This is used by callbacks that previously relied on the CarrierWave-backed
+  # +profile_image+ database column changing.
+  def profile_image_changed_since_last_save?
+    @profile_image_changed_since_last_save == true
+  end
+
+  private
+
+  def active_storage_profile_image_url
+    return unless profile_image.blob&.persisted?
+
+    Rails.application.routes.url_helpers.rails_blob_path(profile_image, only_path: true)
+  end
+
+  def legacy_profile_image_url
+    uploader = ProfileImageUploader.new(self, :profile_image)
+    uploader.retrieve_from_store!(legacy_profile_image)
+    uploader.url
+  end
+
+  def track_profile_image_attachment_change
+    @profile_image_changed_since_last_save = attachment_changes.key?("profile_image")
+  end
+
+  def remote_profile_image_pending?
+    @remote_profile_image_url.present? && !active_storage_profile_image_attached?
+  end
+
+  def attach_remote_profile_image
+    require "open-uri"
+
+    url = @remote_profile_image_url
+    downloaded = URI.open(url) # rubocop:disable Security/Open
+    filename = File.basename(URI.parse(url).path).presence || "profile_image"
+    content_type = downloaded.content_type if downloaded.respond_to?(:content_type)
+    if File.extname(filename).blank?
+      extension = content_type&.split("/")&.last
+      filename = "#{filename}.#{extension}" if extension.present?
+    end
+    self.profile_image = { io: downloaded, filename: filename, content_type: content_type }
+  rescue Exception => e # rubocop:disable Lint/RescueException
+    # WebMock deliberately raises an Exception (not StandardError) when a
+    # request is not stubbed. Treat that like any other failed download in
+    # tests, while allowing real exceptions such as SystemExit to propagate.
+    webmock_error = defined?(WebMock::NetConnectNotAllowedError) &&
+      e.is_a?(WebMock::NetConnectNotAllowedError)
+    raise unless e.is_a?(StandardError) || webmock_error
+
+    # A failed remote fetch should not make an otherwise valid account
+    # unsaveable. Models that require a profile image will still fail their
+    # own presence validation if no attachment or legacy image exists.
+    Rails.logger.warn("Unable to download profile image from #{url}: #{e.class}: #{e.message}")
+  end
+
+  def validate_profile_image_attachment
+    return unless active_storage_profile_image_attached?
+
+    blob = profile_image.blob
+    extension = File.extname(blob.filename.to_s).delete(".").downcase
+    unless PROFILE_IMAGE_EXTENSIONS.include?(extension)
+      errors.add(:profile_image, I18n.t("models.profile_image.invalid_extension",
+                                        default: "must be a supported image type"))
+    end
+
+    return unless blob.byte_size > ProfileImageUploader::MAX_FILE_SIZE
+
+    errors.add(:profile_image, "File size should be less than #{ProfileImageUploader::MAX_FILE_SIZE / 1.megabyte} MB")
+  end
+end
