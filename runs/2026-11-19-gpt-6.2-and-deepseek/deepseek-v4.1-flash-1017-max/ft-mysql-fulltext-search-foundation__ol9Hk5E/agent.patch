+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.squish
+    @cards = Current.user.accessible_cards
+      .published
+      .search(@query)
+      .reverse_chronologically
+      .preloaded
+      .includes(comments: [ :creator, :rich_text_body ])
+  end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..17128a0
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,38 @@
+module SearchHelper
+  def search_highlight(text, query)
+    highlight(text.to_s, search_terms(query), highlighter: '<mark>\1</mark>')
+  end
+
+  def search_excerpt(text, query, length: 240)
+    plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    plain_text = plain_text.squish
+
+    if plain_text.present?
+      if match = first_search_match(plain_text, query)
+        start = [ match.begin(0) - 80, 0 ].max
+        excerpt = plain_text[start, length].to_s
+        excerpt = "…#{excerpt}" if start.positive?
+        excerpt += "…" if start + length < plain_text.length
+        excerpt
+      else
+        plain_text.truncate(length)
+      end
+    end
+  end
+
+  def search_text_matches?(text, query)
+    plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    search_terms(query).any? { |term| plain_text.downcase.include?(term.downcase) }
+  end
+
+  private
+    def first_search_match(text, query)
+      search_terms(query)
+        .filter_map { |term| text.match(/#{Regexp.escape(term)}/i) }
+        .min_by { |match| match.begin(0) }
+    end
+
+    def search_terms(query)
+      query.to_s.squish.split
+    end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..bd76954 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -47,6 +47,33 @@ class Card < ApplicationRecord
     end
   end
 
+  scope :search, ->(query) do
+    terms = query.to_s.squish.split
+
+    if terms.any?
+      conditions = terms.map do |term|
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(term)}%"
+
+        [
+          "(cards.title LIKE ? OR " \
+            "EXISTS (SELECT 1 FROM action_text_rich_texts card_rich_texts " \
+              "WHERE card_rich_texts.record_type = 'Card' AND card_rich_texts.record_id = cards.id " \
+              "AND card_rich_texts.name = 'description' AND card_rich_texts.body LIKE ?) OR " \
+            "EXISTS (SELECT 1 FROM comments search_comments " \
+              "INNER JOIN action_text_rich_texts comment_rich_texts " \
+                "ON comment_rich_texts.record_type = 'Comment' AND comment_rich_texts.record_id = search_comments.id " \
+              "WHERE search_comments.card_id = cards.id AND comment_rich_texts.name = 'body' " \
+              "AND comment_rich_texts.body LIKE ?))",
+          pattern, pattern, pattern
+        ]
+      end
+
+      where(conditions.map(&:first).join(" AND "), *conditions.flat_map { |condition| condition.drop(1) })
+    else
+      none
+    end
+  end
+
   def card
     self
   end
