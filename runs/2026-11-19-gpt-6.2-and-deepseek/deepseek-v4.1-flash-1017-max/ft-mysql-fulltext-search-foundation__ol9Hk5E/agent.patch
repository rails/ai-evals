diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..311d26a
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,24 @@
+<article class="card" id="<%= dom_id(card, :search_result) %>">
+  <div class="card__body">
+    <div class="card__content">
+      <h2 class="card__title">
+        <%= link_to search_highlight(card.title, query), card_path(card), class: "card__link" %>
+      </h2>
+
+      <p class="txt-small txt-subtle margin-none">
+        In <%= link_to card.board.name, card.board %> · added by <%= card.creator.name %>
+      </p>
+
+      <% if card.description.present? && search_text_matches?(card.description, query) %>
+        <p class="search-result__excerpt"><%= search_highlight(search_excerpt(card.description, query), query) %></p>
+      <% end %>
+
+      <% card.comments.select { |comment| search_text_matches?(comment.body, query) }.each do |comment| %>
+        <p class="search-result__excerpt">
+          <strong><%= comment.creator.name %>:</strong>
+          <%= search_highlight(search_excerpt(comment.body, query), query) %>
+        </p>
+      <% end %>
+    </div>
+  </div>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..fc51216
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,22 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide shadow center flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half", role: "search" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", class: "input full-width", autofocus: true, autocomplete: "off", autocorrect: "off" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <div class="flex flex-column gap" data-testid="search-results">
+        <%= render partial: "searches/result", collection: @cards, as: :card, locals: { query: @query } %>
+      </div>
+    <% else %>
+      <p class="txt-subtle">No cards match “<%= @query %>”.</p>
+    <% end %>
+  <% end %>
+</section>
