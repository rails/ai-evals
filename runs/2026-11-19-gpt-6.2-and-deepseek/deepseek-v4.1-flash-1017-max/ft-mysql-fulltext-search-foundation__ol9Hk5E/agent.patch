diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..d262f2e
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "search page is available" do
+    get search_path(q: "logo")
+    assert_response :success
+  end
+
+  test "finds cards by title, description, or comment body" do
+    by_title = create_card(title: "Searchable title needle")
+    by_description = create_card(title: "Description card")
+    by_description.update!(description: "A description with a needle inside")
+
+    by_comment = create_card(title: "Comment card")
+    by_comment.comments.create!(creator: users(:kevin), body: "A comment with a needle inside")
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(by_title)
+    assert_select "a[href=?]", card_path(by_description)
+    assert_select "a[href=?]", card_path(by_comment)
+    assert_select "mark", text: /needle/i
+  end
+
+test "highlights a match that only appears in a comment" do
+  card = create_card(title: "Unrelated title")
+  card.comments.create!(creator: users(:kevin), body: "The comment contains a needle")
+
+  get search_path(q: "needle")
+
+  assert_response :success
+  assert_select "article#search_result_card_#{card.id} mark", text: "needle"
+end
+
+test "blank queries return no results" do
+  card = create_card(title: "Needle")
+
+  get search_path(q: "   ")
+
+  assert_response :success
+  assert_select "a[href=?]", card_path(card), count: 0
+end
+
+test "search treats wildcard characters literally" do
+  card = create_card(title: "No wildcard here")
+
+  get search_path(q: "%")
+
+  assert_response :success
+  assert_select "a[href=?]", card_path(card), count: 0
+end
+
+  test "returns newest matching cards first" do
+    older = create_card(title: "Needle older", created_at: 2.days.ago)
+    newer = create_card(title: "Needle newer", created_at: 1.day.ago)
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_operator response.body.index(card_path(newer)), :<, response.body.index(card_path(older))
+  end
+
+  test "does not return draft cards or their comments" do
+    draft = create_card(title: "Draft needle")
+    draft.comments.create!(creator: users(:kevin), body: "Draft comment needle")
+    draft.update!(status: :drafted)
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(draft), count: 0
+  end
+
+  test "does not return cards from boards the user cannot access" do
+    private_card = create_card(board: boards(:private), title: "Private needle")
+
+    logout_and_sign_in_as :jz
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(private_card), count: 0
+  end
+
+  test "only searches within the current account" do
+    get search_path(q: "radio")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:radio)), count: 0
+  end
+
+  private
+    def create_card(board: boards(:writebook), title:, created_at: Time.current)
+      Current.set(user: users(:kevin), account: accounts("37s")) do
+        board.cards.create!(creator: users(:kevin), title: title, status: :published, created_at: created_at)
+      end
+    end
+end
