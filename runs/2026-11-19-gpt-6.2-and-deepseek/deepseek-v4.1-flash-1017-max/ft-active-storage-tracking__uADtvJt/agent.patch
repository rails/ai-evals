diff --git a/app/models/concerns/storage_usage_trackable.rb b/app/models/concerns/storage_usage_trackable.rb
new file mode 100644
index 0000000..a301f45
--- /dev/null
+++ b/app/models/concerns/storage_usage_trackable.rb
@@ -0,0 +1,33 @@
+module StorageUsageTrackable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :mark_storage_usage_dirty_on_create
+    before_destroy :remember_storage_usage_context
+    after_destroy_commit :mark_storage_usage_dirty_on_destroy
+  end
+
+  def delete
+    context = StorageUsage.context_for_attachment(self)
+    super.tap { StorageUsage.mark_dirty(**context) if context }
+  end
+
+  private
+    def mark_storage_usage_dirty_on_create
+      if context = StorageUsage.context_for_attachment(self)
+        StorageUsage.mark_dirty(**context)
+      end
+    end
+
+    def remember_storage_usage_context
+      @storage_usage_context = StorageUsage.context_for_attachment(self)
+    end
+
+    def mark_storage_usage_dirty_on_destroy
+      if @storage_usage_context
+        StorageUsage.mark_dirty(**@storage_usage_context)
+      end
+    ensure
+      @storage_usage_context = nil
+    end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..868cbf3
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,135 @@
+class StorageUsage
+  class << self
+    def bytes_used_for(record)
+      case record
+      when Account then bytes_used_for_account(record)
+      when Board then bytes_used_for_board(record)
+      else raise ArgumentError, "Unsupported storage usage record: #{record.class}"
+      end
+    end
+
+    def mark_dirty(account_id:, board_id: nil, account: true)
+      account_updated = account && account_id && Account.where(id: account_id).update_counters(storage_usage_version: 1).positive?
+      board_updated = board_id && Board.where(id: board_id).update_counters(storage_usage_version: 1).positive?
+
+      if account_updated || board_updated
+        RecalculateJob.perform_later(account_id:, board_id:)
+      end
+    end
+
+    def context_for_attachment(attachment)
+      board = board_for_attachment(attachment)
+      return unless board || counted_attachment?(attachment)
+
+      { account_id: attachment.account_id || board&.account_id, board_id: board&.id }
+    end
+
+    private
+      def bytes_used_for_account(account)
+        card_image_attachments = counted_attachments.where(
+          account_id: account.id,
+          record_type: "Card",
+          name: "image",
+          record_id: Card.where(account_id: account.id).select(:id)
+        )
+
+        rich_text_attachments = counted_attachments.where(
+          account_id: account.id,
+          record_type: "ActionText::RichText",
+          name: "embeds",
+          record_id: counted_rich_texts_for_account(account).select(:id)
+        )
+
+        card_image_attachments.or(rich_text_attachments).sum("active_storage_blobs.byte_size").to_i
+      end
+
+      def bytes_used_for_board(board)
+        card_image_attachments = counted_attachments.where(
+          account_id: board.account_id,
+          record_type: "Card",
+          name: "image",
+          record_id: Card.where(board_id: board.id).select(:id)
+        )
+
+        rich_text_attachments = counted_attachments.where(
+          account_id: board.account_id,
+          record_type: "ActionText::RichText",
+          name: "embeds",
+          record_id: counted_rich_texts_for_board(board).select(:id)
+        )
+
+        card_image_attachments.or(rich_text_attachments).sum("active_storage_blobs.byte_size").to_i
+      end
+
+      def counted_attachments
+        ActiveStorage::Attachment.joins(:blob)
+      end
+
+      def counted_rich_texts_for_account(account)
+        ActionText::RichText.where(account_id: account.id).where(
+          "(record_type = 'Board' AND name = 'public_description') OR " \
+          "(record_type = 'Card' AND name = 'description') OR " \
+          "(record_type = 'Comment' AND name = 'body')"
+        )
+      end
+
+      def counted_rich_texts_for_board(board)
+        board_rich_texts = ActionText::RichText.where(
+          record_type: "Board", record_id: board.id, name: "public_description"
+        )
+
+        card_rich_texts = ActionText::RichText.where(
+          record_type: "Card",
+          name: "description",
+          record_id: Card.where(board_id: board.id).select(:id)
+        )
+
+        comment_rich_texts = ActionText::RichText.where(
+          record_type: "Comment",
+          name: "body",
+          record_id: Comment.joins(:card).where(cards: { board_id: board.id }).select(:id)
+        )
+
+        board_rich_texts.or(card_rich_texts).or(comment_rich_texts)
+      end
+
+      def counted_attachment?(attachment)
+        case attachment.record_type
+        when "Card"
+          attachment.name == "image"
+        when "ActionText::RichText"
+          attachment.name == "embeds" && counted_rich_text?(attachment.record)
+        else
+          false
+        end
+      end
+
+      def counted_rich_text?(rich_text)
+        case rich_text&.record_type
+        when "Board" then rich_text.name == "public_description"
+        when "Card" then rich_text.name == "description"
+        when "Comment" then rich_text.name == "body"
+        else false
+        end
+      end
+
+      def board_for_attachment(attachment)
+        return unless counted_attachment?(attachment)
+
+        case attachment.record_type
+        when "Card"
+          attachment.record&.board
+        when "ActionText::RichText"
+          board_for_rich_text(attachment.record)
+        end
+      end
+
+      def board_for_rich_text(rich_text)
+        case rich_text&.record_type
+        when "Board" then rich_text.record
+        when "Card" then rich_text.record&.board
+        when "Comment" then rich_text.record&.card&.board
+        end
+      end
+  end
+end
diff --git a/config/initializers/storage_usage.rb b/config/initializers/storage_usage.rb
new file mode 100644
index 0000000..abfb40d
--- /dev/null
+++ b/config/initializers/storage_usage.rb
@@ -0,0 +1,17 @@
+ActiveSupport.on_load(:active_storage_attachment) do
+  include StorageUsageTrackable
+end
+
+module StorageUsageDetachManyTracking
+  def detach
+    contexts = attachments.filter_map { |attachment| ::StorageUsage.context_for_attachment(attachment) }
+
+    super
+
+    contexts.each { |context| ::StorageUsage.mark_dirty(**context) }
+  end
+end
+
+Rails.application.config.to_prepare do
+  ActiveStorage::Attached::Changes::DetachMany.prepend(StorageUsageDetachManyTracking)
+end
