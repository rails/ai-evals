+++ b/app/jobs/storage_usage/recalculate_job.rb
@@ -0,0 +1,24 @@
+class StorageUsage::RecalculateJob < ApplicationJob
+  queue_as :backend
+
+  def perform(account_id:, board_id: nil)
+    recalculate Account, account_id if account_id
+    recalculate Board, board_id if board_id
+  end
+
+  private
+    def recalculate(model, id)
+      record = model.find_by(id: id)
+      return unless record
+      return if record.storage_usage_calculated_version == record.storage_usage_version
+
+      record.with_lock do
+        next if record.storage_usage_calculated_version == record.storage_usage_version
+
+        record.update_columns(
+          bytes_used: StorageUsage.bytes_used_for(record),
+          storage_usage_calculated_version: record.storage_usage_version
+        )
+      end
+    end
+end
