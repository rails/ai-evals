diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..50be9fe
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,307 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "card image is counted for board and account" do
+    card = cards(:logo)
+    blob = create_blob
+
+    assert_enqueued_jobs 1, only: StorageUsage::RecalculateJob do
+      card.image.attach(blob)
+    end
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal blob.byte_size, card.board.bytes_used
+    assert_equal blob.byte_size, card.account.bytes_used
+  end
+
+  test "board public description embeds are counted" do
+    board = boards(:writebook)
+    blob = create_blob
+
+    assert_enqueued_jobs 1, only: StorageUsage::RecalculateJob do
+      board.update!(public_description: ActionText::Content.new("<p>Board docs</p>").append_attachables(blob))
+    end
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal blob.byte_size, board.bytes_used
+    assert_equal blob.byte_size, board.account.bytes_used
+  end
+
+  test "card description embeds are counted" do
+    card = cards(:logo)
+    blob = create_blob
+
+    assert_enqueued_jobs 1, only: StorageUsage::RecalculateJob do
+      card.update!(description: ActionText::Content.new("<p>Card docs</p>").append_attachables(blob))
+    end
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal blob.byte_size, card.board.bytes_used
+    assert_equal blob.byte_size, card.account.bytes_used
+  end
+
+  test "comment body embeds are counted" do
+    card = cards(:logo)
+    blob = create_blob
+
+    assert_enqueued_jobs 1, only: StorageUsage::RecalculateJob do
+      card.comments.create!(body: ActionText::Content.new("<p>Comment docs</p>").append_attachables(blob))
+    end
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal blob.byte_size, card.board.bytes_used
+    assert_equal blob.byte_size, card.account.bytes_used
+  end
+
+  test "unrelated attachments are not counted" do
+    user = users(:david)
+    blob = create_blob
+
+    user.avatar.attach(blob)
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal 0, user.account.bytes_used
+  end
+
+  test "account usage includes all boards" do
+    first_card = cards(:logo)
+    second_board = boards(:private)
+    second_card = second_board.cards.create!(creator: users(:kevin), title: "Another card")
+    first_blob = create_blob
+    second_blob = create_blob
+
+    first_card.image.attach(first_blob)
+    second_card.image.attach(second_blob)
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal first_blob.byte_size + second_blob.byte_size, first_card.account.bytes_used
+  end
+
+test "detaching a card image updates usage" do
+  card = cards(:logo)
+  blob = create_blob
+  card.image.attach(blob)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+  assert_equal blob.byte_size, card.board.bytes_used
+
+  card.image.detach
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal 0, card.board.bytes_used
+  assert_equal 0, card.account.bytes_used
+end
+
+test "deleting a card removes its usage" do
+  card = cards(:logo)
+  blob = create_blob
+  card.image.attach(blob)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+  assert_equal blob.byte_size, card.board.bytes_used
+
+  card.destroy!
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal 0, card.board.bytes_used
+  assert_equal 0, card.account.bytes_used
+end
+
+test "replacing a rich text body removes its usage" do
+  card = cards(:logo)
+  blob = create_blob
+  card.update!(description: ActionText::Content.new("<p>Card docs</p>").append_attachables(blob))
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+  assert_equal blob.byte_size, card.board.bytes_used
+
+  card.update!(description: "No attachment anymore")
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal 0, card.board.bytes_used
+  assert_equal 0, card.account.bytes_used
+end
+
+test "moving a card transfers usage between boards" do
+  card = cards(:logo)
+  old_board = card.board
+  new_board = boards(:writebook).account.boards.create!(creator: users(:david), name: "Destination")
+  blob = create_blob
+  card.image.attach(blob)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+  assert_equal blob.byte_size, old_board.bytes_used
+
+  card.update!(board: new_board)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal 0, old_board.bytes_used
+  assert_equal blob.byte_size, new_board.bytes_used
+  assert_equal blob.byte_size, card.account.bytes_used
+end
+
+test "usage includes all counted sources on a board and account" do
+  board = boards(:writebook)
+  card = cards(:logo)
+  blobs = 4.times.map { create_blob }
+
+  board.update!(public_description: ActionText::Content.new("<p>Board docs</p>").append_attachables(blobs[0]))
+  card.update!(description: ActionText::Content.new("<p>Card docs</p>").append_attachables(blobs[1]))
+  card.image.attach(blobs[2])
+  card.comments.create!(body: ActionText::Content.new("<p>Comment docs</p>").append_attachables(blobs[3]))
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  expected = blobs.sum(&:byte_size)
+  assert_equal expected, board.bytes_used
+  assert_equal expected, board.account.bytes_used
+end
+
+test "deleting a comment removes its usage" do
+  card = cards(:logo)
+  blob = create_blob
+  comment = card.comments.create!(body: ActionText::Content.new("<p>Comment docs</p>").append_attachables(blob))
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+  assert_equal blob.byte_size, card.board.bytes_used
+
+  comment.destroy!
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal 0, card.board.bytes_used
+  assert_equal 0, card.account.bytes_used
+end
+
+test "deleting a board removes its usage from the account" do
+  board = boards(:writebook)
+  card = cards(:logo)
+  blob = create_blob
+  card.image.attach(blob)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+  assert_equal blob.byte_size, board.account.bytes_used
+
+  board.destroy!
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal 0, board.account.bytes_used
+end
+
+test "replacing a card image through model assignment updates usage" do
+  card = cards(:logo)
+  first_blob = create_blob
+  second_blob = create_blob
+  card.image.attach(first_blob)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+  assert_equal first_blob.byte_size, card.board.bytes_used
+
+  card.update!(image: second_blob)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal second_blob.byte_size, card.board.bytes_used
+  assert_equal second_blob.byte_size, card.account.bytes_used
+end
+
+test "recalculation corrects a stale cached value" do
+  card = cards(:logo)
+  blob = create_blob
+  card.image.attach(blob)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+  card.account.update_columns(bytes_used: 0)
+  card.board.update_columns(bytes_used: 0)
+
+  StorageUsage.mark_dirty(account_id: card.account_id, board_id: card.board_id)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal blob.byte_size, card.board.bytes_used
+  assert_equal blob.byte_size, card.account.bytes_used
+end
+
+test "clearing a card image through model assignment updates usage" do
+  card = cards(:logo)
+  blob = create_blob
+  card.image.attach(blob)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+  assert_equal blob.byte_size, card.board.bytes_used
+
+  card.update!(image: nil)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal 0, card.board.bytes_used
+  assert_equal 0, card.account.bytes_used
+end
+
+test "detaching rich text embeds updates usage" do
+  card = cards(:logo)
+  blob = create_blob
+  comment = card.comments.create!(body: ActionText::Content.new("<p>Comment docs</p>").append_attachables(blob))
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+  assert_equal blob.byte_size, card.board.bytes_used
+
+  comment.body.embeds.detach
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal 0, card.board.bytes_used
+  assert_equal 0, card.account.bytes_used
+end
+
+test "purging a card image updates usage" do
+  card = cards(:logo)
+  blob = create_blob
+  card.image.attach(blob)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+  assert_equal blob.byte_size, card.board.bytes_used
+
+  card.image.purge
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal 0, card.board.bytes_used
+  assert_equal 0, card.account.bytes_used
+end
+
+test "moving a card transfers description and comment usage" do
+  card = cards(:logo)
+  old_board = card.board
+  new_board = boards(:writebook).account.boards.create!(creator: users(:david), name: "Another destination")
+  description_blob = create_blob
+  comment_blob = create_blob
+  card.update!(description: ActionText::Content.new("<p>Card docs</p>").append_attachables(description_blob))
+  card.comments.create!(body: ActionText::Content.new("<p>Comment docs</p>").append_attachables(comment_blob))
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  expected = description_blob.byte_size + comment_blob.byte_size
+  assert_equal expected, old_board.bytes_used
+
+  card.update!(board: new_board)
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal 0, old_board.bytes_used
+  assert_equal expected, new_board.bytes_used
+  assert_equal expected, card.account.bytes_used
+end
+
+test "card image attached from io is counted once" do
+  card = cards(:logo)
+
+  assert_enqueued_jobs 1, only: StorageUsage::RecalculateJob do
+    card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+  end
+
+  perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+  assert_equal card.image.blob.byte_size, card.board.bytes_used
+  assert_equal card.image.blob.byte_size, card.account.bytes_used
+end
+
+  private
+    def create_blob
+      ActiveStorage::Blob.create_and_upload!(
+        io: File.open(file_fixture("moon.jpg")),
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+    end
+end
