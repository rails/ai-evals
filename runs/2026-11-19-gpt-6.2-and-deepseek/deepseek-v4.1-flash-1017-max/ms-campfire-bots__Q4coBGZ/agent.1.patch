+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+    sign_in :jz
+  end
+
+  test "account settings links to the bots page" do
+    get edit_account_url
+
+    assert_response :success
+    assert_select "a[aria-label='Set up chat bots']"
+  end
+
+  test "lists only bots created by the current member" do
+    own_bot = Bot.create!(name: "Own Bot", creator: users(:jz))
+    other_bot = Bot.create!(name: "Other Bot", creator: users(:david))
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li", text: /#{own_bot.name}/
+    assert_select "li", text: /#{other_bot.name}/, count: 0
+    assert_select "li##{dom_id(own_bot)}" do
+      assert_select "label", text: "Bot code"
+      assert_select "input[readonly][aria-label='Bot code'][value=?]", own_bot.bot_code
+    end
+  end
+
+  test "administrators see all bots" do
+    sign_in :david
+    own_bot = Bot.create!(name: "Own Bot", creator: users(:david))
+    other_bot = Bot.create!(name: "Other Bot", creator: users(:jz))
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li", text: /#{own_bot.name}/
+    assert_select "li", text: /#{other_bot.name}/
+  end
+
+  test "new bot form uses the expected labels" do
+    get new_bot_url
+
+    assert_response :success
+    assert_select "label", text: "Name the bot"
+    assert_select "button", text: "Save changes"
+  end
+
+  test "creating a bot joins all open rooms" do
+    assert_difference -> { Bot.count }, +1 do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+
+    bot = Bot.last
+    assert_redirected_to bots_url
+    assert_equal users(:jz), bot.creator
+    assert_equal Rooms::Open.count, bot.rooms.opens.count
+  end
+
+  test "creating a bot can attach an avatar" do
+    post bots_url, params: {
+      bot: { name: "Deploy Bot", avatar: fixture_file_upload("earth.png", "image/png") }
+    }
+
+    assert_redirected_to bots_url
+    assert Bot.last.avatar.attached?
+  end
+
+test "bots can be added to closed rooms like people" do
+  sign_in :david
+  bot = Bot.create!(name: "Deploy Bot", creator: users(:jz))
+  room = rooms(:designers)
+
+  put rooms_closed_url(room), params: {
+    room: { name: room.name }, user_ids: room.users.pluck(:id) + [ bot.id ]
+  }
+
+  assert_redirected_to room_url(room)
+  assert room.reload.users.include?(bot)
+end
+
+test "edit page offers a native confirmation before deleting" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:jz))
+
+    get edit_bot_url(bot)
+
+    assert_response :success
+    assert_select "[data-turbo-confirm]", text: "Delete this chat bot"
+  end
+
+  test "editing a bot changes its name and preserves its code" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:jz))
+    bot_code = bot.bot_code
+
+    patch bot_url(bot), params: { bot: { name: "Release Bot" } }
+
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+    assert_equal bot_code, bot.bot_code
+  end
+
+  test "deleting a bot removes it" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:jz))
+
+    assert_difference -> { Bot.count }, -1 do
+      delete bot_url(bot)
+    end
+
+    assert_redirected_to bots_url
+  end
+
+  test "members cannot manage another member's bot" do
+    bot = Bot.create!(name: "Other Bot", creator: users(:david))
+
+    get edit_bot_url(bot)
+    assert_response :not_found
+
+    delete bot_url(bot)
+    assert_response :not_found
+  end
+end
