diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..2f984a4
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,23 @@
+class Bots::MessagesController < ApplicationController
+  allow_unauthenticated_access only: :create
+  skip_forgery_protection only: :create
+
+  def create
+    @room = Room.find(params[:room_id])
+    @bot = Bot.find_by(bot_code: params[:bot_code])
+
+    return head :unauthorized unless @bot
+    return head :not_found unless @room.memberships.exists?(user_id: @bot.id)
+
+    body = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+    @message = @room.messages.create_with_attachment!(body: body, creator: @bot)
+    @message.broadcast_create
+
+    response.set_header "Location", message_path(@message)
+    head :created
+  rescue ActiveRecord::RecordNotFound
+    head :not_found
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_content
+  end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..e1656a7
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,51 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = manageable_bots.ordered
+  end
+
+  def new
+    @bot = Current.user.bots.build
+  end
+
+  def create
+    @bot = Current.user.bots.build(bot_params)
+
+    if @bot.save
+      redirect_to bots_path, notice: "✓"
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_path, notice: "✓"
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.destroy
+    redirect_to bots_path, notice: "✓"
+  end
+
+  private
+    def set_bot
+      @bot = manageable_bots.find_by(id: params[:id])
+      head :not_found unless @bot
+    end
+
+    def manageable_bots
+      Current.user.administrator? ? Bot.all : Current.user.bots
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..9f80de5
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,17 @@
+class Bot < User
+  has_secure_token :bot_code
+
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  validates :name, presence: true
+  validates :bot_code, uniqueness: true
+
+  before_validation :set_random_password, on: :create
+
+  private
+    # Bots authenticate with their bot code, never with a password. A random
+    # password digest still satisfies the users table without allowing sign-in.
+    def set_random_password
+      self.password = SecureRandom.base58(32) if password_digest.blank?
+    end
+end
