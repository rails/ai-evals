diff --git a/config/initializers/account_owned_models.rb b/config/initializers/account_owned_models.rb
new file mode 100644
index 0000000..c264166
--- /dev/null
+++ b/config/initializers/account_owned_models.rb
@@ -0,0 +1,18 @@
+# Framework-owned polymorphic records need the same tenant scoping as our
+# application records. The account is inferred from the owning record whenever
+# possible, falling back to the current request/job context.
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob.try(:account) || Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob&.account || Current.account }
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record.try(:account) || Current.account }
+end
