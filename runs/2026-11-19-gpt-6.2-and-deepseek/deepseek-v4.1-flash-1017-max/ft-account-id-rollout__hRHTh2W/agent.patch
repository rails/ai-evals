+class FinishAccountIdRollout < ActiveRecord::Migration[8.2]
+  # Tables that hold account-owned data. Every one of these must have a
+  # required, indexed account_id.
+  ACCOUNT_TABLES = %i[
+    accesses
+    account_imports
+    account_join_codes
+    action_text_rich_texts
+    active_storage_attachments
+    active_storage_blobs
+    active_storage_variant_records
+    assignments
+    board_publications
+    boards
+    card_activity_spikes
+    card_goldnesses
+    card_not_nows
+    cards
+    closures
+    columns
+    comments
+    entropies
+    events
+    filters
+    mentions
+    notification_bundles
+    notifications
+    pins
+    push_subscriptions
+    reactions
+    search_queries
+    steps
+    storage_totals
+    tags
+    taggings
+    user_settings
+    users
+    watches
+    webhook_delinquency_trackers
+    webhook_deliveries
+    webhooks
+  ].freeze
+
+  # These already had account_id and a supporting index before this rollout.
+  ALREADY_INDEXED_TABLES = %i[
+    account_cancellations
+    account_imports
+    exports
+    storage_entries
+  ].freeze
+
+  # These already had account_id, but it was nullable.
+  PREEXISTING_NULLABLE_TABLES = %i[
+    account_imports
+    account_join_codes
+    boards
+    cards
+    columns
+    comments
+    events
+    filters
+    notification_bundles
+    notifications
+    push_subscriptions
+    steps
+    tags
+    users
+    webhooks
+  ].freeze
+
+  ALL_ACCOUNT_TABLES = (ACCOUNT_TABLES + %i[account_cancellations exports storage_entries]).freeze
+  NEW_ACCOUNT_TABLES = (ACCOUNT_TABLES - PREEXISTING_NULLABLE_TABLES).freeze
+
+  def up
+    ACCOUNT_TABLES.each do |table|
+      add_column table, :account_id, :uuid unless column_exists?(table, :account_id)
+    end
+
+    backfill_account_ids
+    drop_orphans
+
+    ALL_ACCOUNT_TABLES.each do |table|
+      change_column_null table, :account_id, false
+      add_index table, :account_id unless index_exists?(table, :account_id)
+    end
+
+    # Tag titles are unique within an account, not globally.
+    remove_index :tags, :title if index_exists?(:tags, :title, unique: true)
+    add_index :tags, [ :account_id, :title ], unique: true unless index_exists?(:tags, [ :account_id, :title ], unique: true)
+  end
+
+  def down
+    (ACCOUNT_TABLES - ALREADY_INDEXED_TABLES).each do |table|
+      remove_index table, :account_id if index_exists?(table, :account_id)
+    end
+
+    PREEXISTING_NULLABLE_TABLES.each do |table|
+      change_column_null table, :account_id, true
+    end
+
+    NEW_ACCOUNT_TABLES.each do |table|
+      remove_column table, :account_id if column_exists?(table, :account_id)
+    end
+  end
+
+  private
+    def backfill_account_ids
+      # Core records first: child tables can derive their account from them.
+      execute "UPDATE boards SET account_id = (SELECT users.account_id FROM users WHERE users.id = boards.creator_id) WHERE account_id IS NULL"
+      execute "UPDATE cards SET account_id = (SELECT boards.account_id FROM boards WHERE boards.id = cards.board_id) WHERE account_id IS NULL"
+      execute "UPDATE columns SET account_id = (SELECT boards.account_id FROM boards WHERE boards.id = columns.board_id) WHERE account_id IS NULL"
+      execute "UPDATE comments SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = comments.card_id) WHERE account_id IS NULL"
+      execute "UPDATE events SET account_id = (SELECT boards.account_id FROM boards WHERE boards.id = events.board_id) WHERE account_id IS NULL"
+      execute "UPDATE steps SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = steps.card_id) WHERE account_id IS NULL"
+      execute "UPDATE filters SET account_id = (SELECT users.account_id FROM users WHERE users.id = filters.creator_id) WHERE account_id IS NULL"
+      execute "UPDATE webhooks SET account_id = (SELECT boards.account_id FROM boards WHERE boards.id = webhooks.board_id) WHERE account_id IS NULL"
+      execute "UPDATE notifications SET account_id = (SELECT users.account_id FROM users WHERE users.id = notifications.user_id) WHERE account_id IS NULL"
+      execute "UPDATE notification_bundles SET account_id = (SELECT users.account_id FROM users WHERE users.id = notification_bundles.user_id) WHERE account_id IS NULL"
+      execute "UPDATE push_subscriptions SET account_id = (SELECT users.account_id FROM users WHERE users.id = push_subscriptions.user_id) WHERE account_id IS NULL"
+
+      # Tags only know their account through their card taggings. A tag with no
+      # remaining tenant-owned card cannot be assigned to an account.
+      execute <<~SQL
+        UPDATE tags
+        SET account_id = COALESCE(
+          (
+            SELECT cards.account_id
+            FROM taggings
+            INNER JOIN cards ON cards.id = taggings.card_id
+            WHERE taggings.tag_id = tags.id AND cards.account_id IS NOT NULL
+            LIMIT 1
+          ),
+          (
+            SELECT filters.account_id
+            FROM filters_tags
+            INNER JOIN filters ON filters.id = filters_tags.filter_id
+            WHERE filters_tags.tag_id = tags.id AND filters.account_id IS NOT NULL
+            LIMIT 1
+          )
+        )
+        WHERE account_id IS NULL
+      SQL
+
+      execute "UPDATE accesses SET account_id = (SELECT boards.account_id FROM boards WHERE boards.id = accesses.board_id) WHERE account_id IS NULL"
+      execute "UPDATE board_publications SET account_id = (SELECT boards.account_id FROM boards WHERE boards.id = board_publications.board_id) WHERE account_id IS NULL"
+      execute "UPDATE card_activity_spikes SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = card_activity_spikes.card_id) WHERE account_id IS NULL"
+      execute "UPDATE card_goldnesses SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = card_goldnesses.card_id) WHERE account_id IS NULL"
+      execute "UPDATE card_not_nows SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = card_not_nows.card_id) WHERE account_id IS NULL"
+      execute "UPDATE assignments SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = assignments.card_id) WHERE account_id IS NULL"
+      execute "UPDATE closures SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = closures.card_id) WHERE account_id IS NULL"
+      execute "UPDATE pins SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = pins.card_id) WHERE account_id IS NULL"
+      execute "UPDATE taggings SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = taggings.card_id) WHERE account_id IS NULL"
+      execute "UPDATE watches SET account_id = (SELECT cards.account_id FROM cards WHERE cards.id = watches.card_id) WHERE account_id IS NULL"
+      execute "UPDATE user_settings SET account_id = (SELECT users.account_id FROM users WHERE users.id = user_settings.user_id) WHERE account_id IS NULL"
+      execute "UPDATE search_queries SET account_id = (SELECT users.account_id FROM users WHERE users.id = search_queries.user_id) WHERE account_id IS NULL"
+
+      execute <<~SQL
+        UPDATE entropies
+        SET account_id = CASE container_type
+          WHEN 'Account' THEN container_id
+          WHEN 'Board' THEN (SELECT boards.account_id FROM boards WHERE boards.id = entropies.container_id)
+        END
+        WHERE account_id IS NULL
+      SQL
+
+      execute <<~SQL
+        UPDATE mentions
+        SET account_id = CASE source_type
+          WHEN 'Card' THEN (SELECT cards.account_id FROM cards WHERE cards.id = mentions.source_id)
+          WHEN 'Comment' THEN (SELECT comments.account_id FROM comments WHERE comments.id = mentions.source_id)
+        END
+        WHERE account_id IS NULL
+      SQL
+
+      execute <<~SQL
+        UPDATE reactions
+        SET account_id = CASE reactable_type
+          WHEN 'Card' THEN (SELECT cards.account_id FROM cards WHERE cards.id = reactions.reactable_id)
+          WHEN 'Comment' THEN (SELECT comments.account_id FROM comments WHERE comments.id = reactions.reactable_id)
+        END
+        WHERE account_id IS NULL
+      SQL
+
+      execute <<~SQL
+        UPDATE storage_totals
+        SET account_id = CASE owner_type
+          WHEN 'Account' THEN owner_id
+          WHEN 'Board' THEN (SELECT boards.account_id FROM boards WHERE boards.id = storage_totals.owner_id)
+          WHEN 'User' THEN (SELECT users.account_id FROM users WHERE users.id = storage_totals.owner_id)
+        END
+        WHERE account_id IS NULL
+      SQL
+
+      execute <<~SQL
+        UPDATE webhook_delinquency_trackers
+        SET account_id = (SELECT webhooks.account_id FROM webhooks WHERE webhooks.id = webhook_delinquency_trackers.webhook_id)
+        WHERE account_id IS NULL
+      SQL
+      execute <<~SQL
+        UPDATE webhook_deliveries
+        SET account_id = (SELECT webhooks.account_id FROM webhooks WHERE webhooks.id = webhook_deliveries.webhook_id)
+        WHERE account_id IS NULL
+      SQL
+
+      # Polymorphic rich text records need their owner's account.
+      execute <<~SQL
+        UPDATE action_text_rich_texts
+        SET account_id = CASE record_type
+          WHEN 'Card' THEN (SELECT cards.account_id FROM cards WHERE cards.id = action_text_rich_texts.record_id)
+          WHEN 'Comment' THEN (SELECT comments.account_id FROM comments WHERE comments.id = action_text_rich_texts.record_id)
+          WHEN 'Board' THEN (SELECT boards.account_id FROM boards WHERE boards.id = action_text_rich_texts.record_id)
+        END
+        WHERE account_id IS NULL
+      SQL
+
+      # Attachments derive their account from their owning record. Global
+      # records such as Identity deliberately don't resolve to an account.
+      execute <<~SQL
+        UPDATE active_storage_attachments
+        SET account_id = CASE record_type
+          WHEN 'Card' THEN (SELECT cards.account_id FROM cards WHERE cards.id = active_storage_attachments.record_id)
+          WHEN 'Comment' THEN (SELECT comments.account_id FROM comments WHERE comments.id = active_storage_attachments.record_id)
+          WHEN 'Board' THEN (SELECT boards.account_id FROM boards WHERE boards.id = active_storage_attachments.record_id)
+          WHEN 'User' THEN (SELECT users.account_id FROM users WHERE users.id = active_storage_attachments.record_id)
+          WHEN 'ActionText::RichText' THEN (SELECT action_text_rich_texts.account_id FROM action_text_rich_texts WHERE action_text_rich_texts.id = active_storage_attachments.record_id)
+          WHEN 'Export' THEN (SELECT exports.account_id FROM exports WHERE exports.id = active_storage_attachments.record_id)
+          WHEN 'Account::Export' THEN (SELECT exports.account_id FROM exports WHERE exports.id = active_storage_attachments.record_id)
+          WHEN 'User::DataExport' THEN (SELECT exports.account_id FROM exports WHERE exports.id = active_storage_attachments.record_id)
+          WHEN 'Account::Import' THEN (SELECT account_imports.account_id FROM account_imports WHERE account_imports.id = active_storage_attachments.record_id)
+        END
+        WHERE account_id IS NULL
+      SQL
+
+      # Blobs are owned through their attachment. Variant records inherit from
+      # the blob they belong to.
+      execute <<~SQL
+        UPDATE active_storage_blobs
+        SET account_id = (
+          SELECT active_storage_attachments.account_id
+          FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND active_storage_attachments.account_id IS NOT NULL
+          LIMIT 1
+        )
+        WHERE account_id IS NULL
+      SQL
+      execute <<~SQL
+        UPDATE active_storage_variant_records
+        SET account_id = (SELECT active_storage_blobs.account_id FROM active_storage_blobs WHERE active_storage_blobs.id = active_storage_variant_records.blob_id)
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    def drop_orphans
+      ALL_ACCOUNT_TABLES.each do |table|
+        execute <<~SQL
+          DELETE FROM #{connection.quote_table_name(table)}
+          WHERE account_id IS NULL
+             OR account_id NOT IN (SELECT id FROM accounts)
+        SQL
+      end
+    end
+end
