 class TitleCleanupJob < ApplicationJob
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    Leaf.where(title_cleaned_at: nil).find_each(order: :asc) do |leaf|
+      # Commit the title and its completion marker together so an interrupted
+      # run can retry at most the leaf whose update never committed.
+      leaf.update!(
+        title: cleaned(leaf.title),
+        title_cleaned_at: Time.current
+      )
     end
   end
 
   private
     def cleaned(title)
-      title.delete_prefix('"').delete_suffix('"')
+      if title.start_with?('"') && title.end_with?('"')
+        title.delete_prefix('"').delete_suffix('"')
+      else
+        title
+      end
     end
 end
