@@ -0,0 +1,20 @@
+class AddTitleCleanedAtToLeaves < ActiveRecord::Migration[8.0]
+  def up
+    add_column :leaves, :title_cleaned_at, :datetime
+    add_index :leaves, :title_cleaned_at
+
+    # The legacy exporter wrapped every title in quotes. A title without both
+    # wrapper quotes has already been cleaned by a prior run, so mark it done
+    # instead of applying the non-idempotent cleanup to it again.
+    execute <<~SQL
+      UPDATE leaves
+      SET title_cleaned_at = CURRENT_TIMESTAMP
+      WHERE NOT (title LIKE '"%' AND title LIKE '%"')
+    SQL
+  end
+
+  def down
+    remove_index :leaves, :title_cleaned_at
+    remove_column :leaves, :title_cleaned_at
+  end
+end
