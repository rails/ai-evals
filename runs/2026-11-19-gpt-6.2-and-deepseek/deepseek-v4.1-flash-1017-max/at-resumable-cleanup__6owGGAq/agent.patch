diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..675eb0c
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  class InterruptingTitleCleanupJob < TitleCleanupJob
+    def initialize(interrupt_on_call:)
+      @cleaned_count = 0
+      @interrupt_on_call = interrupt_on_call
+    end
+
+    private
+      def cleaned(title)
+        @cleaned_count += 1
+        raise "interrupted" if @cleaned_count == @interrupt_on_call
+
+        super
+      end
+  end
+
+  setup do
+    Leaf.find_each do |leaf|
+      leaf.update_columns(title: '""Fully quoted title""')
+    end
+  end
+
+  test "resumes after an interruption without cleaning a title twice" do
+    assert_raises(RuntimeError) do
+      InterruptingTitleCleanupJob.new(interrupt_on_call: 3).perform_now
+    end
+
+    assert_equal 2, Leaf.where(title: '"Fully quoted title"').count
+
+    TitleCleanupJob.perform_now
+
+    assert_equal [ '"Fully quoted title"' ], Leaf.distinct.pluck(:title)
+    assert_equal Leaf.count, Leaf.where.not(title_cleaned_at: nil).count
+  end
+
+  test "preserves inner quotes in a title that opens with a quoted phrase" do
+    leaf = leaves(:welcome_page)
+    leaf.update_columns(title: '""Quoted" phrase"')
+
+    TitleCleanupJob.perform_now
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Quoted" phrase', leaf.reload.title
+  end
+end
