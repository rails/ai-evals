diff --git a/test/controllers/public_boards_controller_test.rb b/test/controllers/public_boards_controller_test.rb
new file mode 100644
index 0000000..1157a0d
--- /dev/null
+++ b/test/controllers/public_boards_controller_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class PublicBoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "board JSON includes a nil public_url by default" do
+    get board_path(boards(:writebook)), as: :json
+
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "admins can publish a board" do
+    board = boards(:writebook)
+
+    post board_publication_path(board), as: :json
+
+    assert_response :created
+    assert board.reload.published?
+    assert board.public_url.present?
+    assert_equal public_board_url(board.public_key, script_name: nil), @response.parsed_body["public_url"]
+  end
+
+  test "admins can unpublish a board" do
+    board = boards(:writebook)
+    board.publish
+
+    delete board_publication_path(board), as: :json
+
+    assert_response :no_content
+    assert_not board.reload.published?
+    assert_nil board.public_url
+  end
+
+  test "non-admins cannot publish a board" do
+    logout_and_sign_in_as :jz
+    board = boards(:writebook)
+
+    post board_publication_path(board), as: :json
+
+    assert_response :forbidden
+    assert_not board.reload.published?
+  end
+
+  test "anyone with the public URL can view a published board" do
+    board = boards(:writebook)
+    board.publish
+
+    untenanted do
+      get public_board_path(board.public_key)
+    end
+
+    assert_response :success
+    assert_in_body board.name
+  end
+
+  test "an unpublished board cannot be viewed publicly" do
+    board = boards(:writebook)
+    board.publish
+    board.unpublish
+
+    untenanted do
+      get public_board_path(board.public_key)
+    end
+
+    assert_response :not_found
+  end
+
+  test "published columns and cards can be opened directly" do
+    board = boards(:writebook)
+    board.publish
+    column = columns(:writebook_triage)
+    card = cards(:logo)
+
+    untenanted do
+      get public_board_column_path(board.public_key, column)
+      assert_response :success
+      assert_in_body column.name
+      assert_select "a", text: card.title
+
+      get public_board_card_path(board.public_key, card.number)
+      assert_response :success
+      assert_select "h1", text: card.title
+    end
+  end
+
+  test "drafted cards cannot be opened publicly" do
+    board = boards(:miltons_wish_list)
+    board.publish
+    drafted_card = cards(:unfinished_thoughts)
+
+    untenanted do
+      get public_board_card_path(board.public_key, drafted_card.number)
+    end
+
+    assert_response :not_found
+  end
+end
