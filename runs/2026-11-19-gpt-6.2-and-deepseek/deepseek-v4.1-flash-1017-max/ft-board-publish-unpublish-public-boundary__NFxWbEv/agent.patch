diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..9074518
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,53 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_secure_token :public_key
+
+    before_save :ensure_public_key, if: :published?
+
+    scope :published, -> { where.not(published_at: nil) }
+    scope :unpublished, -> { where(published_at: nil) }
+  end
+
+  def publish
+    update!(published_at: Time.current)
+  end
+
+  def unpublish
+    update!(published_at: nil)
+  end
+
+  def published?
+    published_at.present?
+  end
+
+  def public_url
+    if published?
+      Rails.application.routes.url_helpers.public_board_url(public_key, **url_options, script_name: nil)
+    end
+  end
+
+  private
+    def ensure_public_key
+      self.public_key = self.class.generate_unique_secure_token if public_key.blank?
+    end
+
+    def url_options
+      default_url_options.merge(request_url_options)
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+
+    def request_url_options
+      if request = Current.request
+        { host: request.host, protocol: request.protocol, port: request.optional_port }
+      else
+        {}
+      end
+    end
+end
