+<% @page_title = @board.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @board.name %></h1>
+<% end %>
+
+<section class="panel flex flex-column gap">
+  <div class="card-columns hide-scrollbar">
+    <% @columns.each do |column| %>
+      <section class="card-column" id="<%= dom_id(column) %>">
+        <header class="cards__header">
+          <h2 class="txt-medium"><%= link_to column.name, public_board_column_path(@board.public_key, column) %></h2>
+        </header>
+
+        <ul class="cards__list">
+          <% (@cards_by_column[column.id] || []).each do |card| %>
+            <li class="card">
+              <%= link_to card.title, public_board_card_path(@board.public_key, card.number), class: "card__link" %>
+            </li>
+          <% end %>
+        </ul>
+      </section>
+    <% end %>
+  </div>
+
+  <% if @unassigned_cards.any? %>
+    <section>
+      <h2 class="txt-medium">Unassigned</h2>
+      <ul class="cards__list">
+        <% @unassigned_cards.each do |card| %>
+          <li class="card">
+            <%= link_to card.title, public_board_card_path(@board.public_key, card.number), class: "card__link" %>
+          </li>
+        <% end %>
+      </ul>
+    </section>
+  <% end %>
+</section>
