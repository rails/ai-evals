diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..261288c
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds cards by title and highlights matching words" do
+    with_current_user(:kevin) { cards(:logo).update!(title: "Searchable logo title") }
+
+    get search_path(q: "searchable")
+
+    assert_response :success
+    assert_select "mark", text: "Searchable"
+    assert_select "a", text: /Searchable logo title/
+  end
+
+  test "finds cards by description and highlights matching words" do
+    with_current_user(:kevin) { cards(:logo).update!(description: "A particularly searchable description") }
+
+    get search_path(q: "searchable")
+
+    assert_response :success
+    assert_select "mark", text: "searchable"
+    assert_match "A particularly", response.body
+    assert_match "description", response.body
+  end
+
+  test "finds cards by comment body and highlights matching words" do
+    with_current_user(:kevin) { cards(:logo).comments.create!(creator: users(:kevin), body: "A searchable comment body") }
+
+    get search_path(q: "searchable")
+
+    assert_response :success
+    assert_select "mark", text: "searchable"
+    assert_match "A", response.body
+    assert_match "comment body", response.body
+  end
+
+  test "returns results newest first" do
+    older = newer = nil
+    with_current_user(:kevin) do
+      older = boards(:writebook).cards.create!(creator: users(:kevin), status: :published,
+        title: "Needle older", created_at: 2.days.ago, last_active_at: 2.days.ago)
+      newer = boards(:writebook).cards.create!(creator: users(:kevin), status: :published,
+        title: "Needle newer", created_at: 1.day.ago, last_active_at: 1.day.ago)
+    end
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select "li.search-result h2 a" do |links|
+      assert_equal [ "Needle newer", "Needle older" ], links.map { |link| link.text.squish }
+    end
+  end
+
+  test "does not return cards from inaccessible boards" do
+    with_current_user(:kevin) { cards(:logo).update!(title: "Searchable private card") }
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    get search_path(q: "searchable")
+
+    assert_response :success
+    assert_no_match "Searchable private card", response.body
+  end
+
+  test "does not return draft cards or comments on draft cards" do
+    draft = nil
+    with_current_user(:kevin) do
+      draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :published, title: "Searchable draft")
+      draft.comments.create!(creator: users(:kevin), body: "Searchable draft comment")
+      draft.update_columns(status: "drafted")
+    end
+
+    get search_path(q: "searchable")
+
+    assert_response :success
+    assert_no_match "Searchable draft", response.body
+    assert_no_match "Searchable draft comment", response.body
+  end
+
+  test "blank query returns no results" do
+    get search_path
+
+    assert_response :success
+    assert_no_match cards(:logo).title, response.body
+  end
+
+  test "matches case-insensitively across multiple query words" do
+    with_current_user(:kevin) { cards(:logo).update!(title: "Alpha", description: "Beta") }
+
+    get search_path(q: "ALPHA beta")
+
+    assert_response :success
+    assert_select "li.search-result", count: 1
+    assert_select "mark", text: "Alpha"
+    assert_select "mark", text: "Beta"
+  end
+
+  test "returns a card only once when multiple comments match" do
+    with_current_user(:kevin) do
+      cards(:logo).comments.create!(creator: users(:kevin), body: "Needle first comment")
+      cards(:logo).comments.create!(creator: users(:kevin), body: "Needle second comment")
+    end
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select "li.search-result", count: 1
+    assert_select "mark", text: "Needle", count: 2
+  end
+
+  test "does not leak comments from inaccessible boards" do
+    with_current_user(:kevin) do
+      card = boards(:private).cards.create!(creator: users(:kevin), status: :published, title: "Private card")
+      card.comments.create!(creator: users(:kevin), body: "Hiddenneedle comment")
+    end
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path(q: "hiddenneedle")
+
+    assert_response :success
+    assert_no_match "Hiddenneedle", response.body
+  end
+
+  test "escapes HTML in highlighted content" do
+    with_current_user(:kevin) { cards(:logo).update!(title: "<img src=x onerror=alert(1)> Searchable") }
+
+    get search_path(q: "searchable")
+
+    assert_response :success
+    assert_select "mark", text: "Searchable"
+    assert_select "li.search-result img[onerror]", count: 0
+  end
+end
