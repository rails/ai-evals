@@ -0,0 +1,32 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    @terms = @query.split
+
+    @cards = if @query.present?
+      Current.user.accessible_cards.published.search(@query).reverse_chronologically.preloaded
+    else
+      Current.user.accessible_cards.none
+    end
+
+    @matching_comments = matching_comments_by_card
+  end
+
+  private
+    def matching_comments_by_card
+      if @query.blank?
+        {}
+      else
+        Comment.where(card_id: @cards.select(:id))
+          .includes(:rich_text_body)
+          .order(created_at: :desc)
+          .group_by(&:card_id)
+          .transform_values { |comments| comments.select { |comment| search_text_matches?(comment.body.to_plain_text) } }
+      end
+    end
+
+    def search_text_matches?(text)
+      normalized_text = text.to_s.downcase
+      @terms.any? { |term| normalized_text.include?(term.downcase) }
+    end
+end
