--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,21 @@
+module SearchHelper
+  def highlighted_search_text(text, terms)
+    highlight(text.to_s, terms)
+  end
+
+  def highlighted_search_excerpt(text, terms)
+    text = text.to_s
+    matching_term = terms.find { |term| text.downcase.include?(term.downcase) }
+
+    if matching_term
+      highlight(excerpt(text, matching_term, radius: 160), terms)
+    else
+      highlight(text.truncate(320), terms)
+    end
+  end
+
+  def search_text_matches?(text, terms)
+    normalized_text = text.to_s.downcase
+    terms.any? { |term| normalized_text.include?(term.downcase) }
+  end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..4115191 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -38,6 +38,40 @@ class Card < ApplicationRecord
     end
   end
 
+  scope :search, ->(query) do
+    terms = query.to_s.split
+
+    if terms.empty?
+      none
+    else
+      terms.reduce(self) do |cards, term|
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(term)}%"
+
+        cards.where(<<~SQL.squish, pattern: pattern)
+          cards.title LIKE :pattern
+          OR EXISTS (
+            SELECT 1
+            FROM action_text_rich_texts
+            WHERE action_text_rich_texts.record_type = 'Card'
+              AND action_text_rich_texts.record_id = cards.id
+              AND action_text_rich_texts.name = 'description'
+              AND action_text_rich_texts.body LIKE :pattern
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM comments
+            INNER JOIN action_text_rich_texts
+              ON action_text_rich_texts.record_id = comments.id
+              AND action_text_rich_texts.record_type = 'Comment'
+              AND action_text_rich_texts.name = 'body'
+            WHERE comments.card_id = cards.id
+              AND action_text_rich_texts.body LIKE :pattern
+          )
+        SQL
+      end
+    end
+  end
+
   scope :sorted_by, ->(sort) do
     case sort
     when "newest" then reverse_chronologically
diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..b87b360
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,47 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="panel borderless center margin pad">
+  <h1>Search cards</h1>
+
+  <%= form_with url: search_path, method: :get, class: "flex gap margin-block" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true,
+          class: "input full-width", aria: { label: "Search cards" } %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <p class="txt-small txt-tinted"><%= pluralize(@cards.size, "card") %> found for "<%= @query %>"</p>
+
+    <ul class="txt-align-start">
+      <% @cards.each do |card| %>
+        <li class="search-result pad" style="border-block-end: 1px solid var(--color-ink-lighter)">
+          <h2 class="search-result__title txt-large margin-none">
+            <%= link_to highlighted_search_text(card.title, @terms), card_path(card) %>
+          </h2>
+
+          <div class="txt-small txt-tinted">
+            in <%= link_to card.board.name, board_path(card.board) %>
+          </div>
+
+          <% if (description = card.description.to_plain_text).present? && search_text_matches?(description, @terms) %>
+            <p class="txt-medium"><%= highlighted_search_excerpt(description, @terms) %></p>
+          <% end %>
+
+          <% @matching_comments.fetch(card.id, []).each do |comment| %>
+            <p class="txt-medium"><%= highlighted_search_excerpt(comment.body.to_plain_text, @terms) %></p>
+          <% end %>
+        </li>
+      <% end %>
+    </ul>
+
+    <% if @cards.none? %>
+      <div class="blank-slate">No cards match your search</div>
+    <% end %>
+  <% end %>
+</section>
