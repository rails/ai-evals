+module HasBytesUsed
+  def bytes_used
+    self[:bytes_used] || 0
+  end
+
+  def recalculate_bytes_used
+    with_lock do
+      update_column :bytes_used, StorageUsage.for(self)
+    end
+  end
+end
diff --git a/app/models/concerns/storage_usage_trackable.rb b/app/models/concerns/storage_usage_trackable.rb
new file mode 100644
index 0000000..82fef32
--- /dev/null
+++ b/app/models/concerns/storage_usage_trackable.rb
@@ -0,0 +1,24 @@
+module StorageUsageTrackable
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :enqueue_storage_usage_recalculation
+    before_destroy :remember_storage_usage_owners
+  end
+
+  private
+    def enqueue_storage_usage_recalculation
+      if StorageUsage.tracked_attachment?(self)
+        board = @storage_usage_board || StorageUsage.board_for_attachment(self)
+        account = @storage_usage_account || board&.account || StorageUsage.account_for_attachment(self)
+
+        Board::BytesUsedJob.perform_later(board) if board
+        Account::BytesUsedJob.perform_later(account) if account
+      end
+    end
+
+    def remember_storage_usage_owners
+      @storage_usage_board = StorageUsage.board_for_attachment(self)
+      @storage_usage_account = @storage_usage_board&.account || StorageUsage.account_for_attachment(self)
+    end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..675c7dd
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,95 @@
+class StorageUsage
+  TRACKED_ATTACHMENT_TYPES = {
+    "Card" => "image",
+    "ActionText::RichText" => "embeds"
+  }.freeze
+
+  class << self
+    def for(record)
+      case record
+      when Account then for_account(record)
+      when Board then for_board(record)
+      else raise ArgumentError, "Unsupported storage usage record: #{record.class}"
+      end
+    end
+
+    def tracked_attachment?(attachment)
+      TRACKED_ATTACHMENT_TYPES[attachment.record_type] == attachment.name
+    end
+
+    def board_for_attachment(attachment)
+      case attachment.record_type
+      when "Card"
+        Card.find_by(id: attachment.record_id)&.board
+      when "ActionText::RichText"
+        board_for_rich_text(ActionText::RichText.find_by(id: attachment.record_id))
+      end
+    end
+
+    def account_for_attachment(attachment)
+      attachment.account || Account.find_by(id: attachment.account_id)
+    end
+
+    private
+      def for_account(account)
+        card_image_blob_ids = ActiveStorage::Attachment
+          .where(account_id: account.id, record_type: "Card", name: "image")
+          .select(:blob_id)
+
+        rich_text_blob_ids = ActiveStorage::Attachment
+          .where(account_id: account.id, record_type: "ActionText::RichText", name: "embeds", record_id: account_rich_text_ids(account))
+          .select(:blob_id)
+
+        byte_size_of_blobs(card_image_blob_ids, rich_text_blob_ids)
+      end
+
+      def for_board(board)
+        card_ids = board.cards.select(:id)
+
+        card_image_blob_ids = ActiveStorage::Attachment
+          .where(record_type: "Card", name: "image", record_id: card_ids)
+          .select(:blob_id)
+
+        rich_text_blob_ids = ActiveStorage::Attachment
+          .where(record_type: "ActionText::RichText", name: "embeds", record_id: board_rich_text_ids(board))
+          .select(:blob_id)
+
+        byte_size_of_blobs(card_image_blob_ids, rich_text_blob_ids)
+      end
+
+      def account_rich_text_ids(account)
+        ActionText::RichText
+          .where(account_id: account.id)
+          .where("(record_type = 'Board' AND name = 'public_description') OR " \
+                 "(record_type = 'Card' AND name = 'description') OR " \
+                 "(record_type = 'Comment' AND name = 'body')")
+          .select(:id)
+      end
+
+      def board_rich_text_ids(board)
+        card_ids = board.cards.select(:id)
+        comment_ids = Comment.where(card_id: card_ids).select(:id)
+
+        ActionText::RichText.where(record_type: "Board", record_id: board.id, name: "public_description")
+          .or(ActionText::RichText.where(record_type: "Card", record_id: card_ids, name: "description"))
+          .or(ActionText::RichText.where(record_type: "Comment", record_id: comment_ids, name: "body"))
+          .select(:id)
+      end
+
+      def byte_size_of_blobs(*blob_id_relations)
+        blob_relations = blob_id_relations.map { |blob_ids| ActiveStorage::Blob.where(id: blob_ids) }
+        blob_relations.reduce { |blobs, more_blobs| blobs.or(more_blobs) }.sum(:byte_size)
+      end
+
+      def board_for_rich_text(rich_text)
+        case rich_text&.record_type
+        when "Board"
+          Board.find_by(id: rich_text.record_id)
+        when "Card"
+          Card.find_by(id: rich_text.record_id)&.board
+        when "Comment"
+          Comment.find_by(id: rich_text.record_id)&.card&.board
+        end
+      end
+  end
+end
