diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..af2faf7
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,227 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "counts card images for the card's board and account" do
+    card = cards(:logo)
+    blob = upload_blob("card-image.jpg")
+
+    perform_enqueued_jobs do
+      card.image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, card.board.reload.bytes_used
+    assert_equal blob.byte_size, card.account.reload.bytes_used
+  end
+
+  test "counts files embedded in board descriptions" do
+    board = boards(:writebook)
+    blob = upload_blob("board-description.txt", content_type: "text/plain")
+
+    perform_enqueued_jobs do
+      board.update!(public_description: attachment_html(blob))
+    end
+
+    assert_equal blob.byte_size, board.reload.bytes_used
+    assert_equal blob.byte_size, board.account.reload.bytes_used
+  end
+
+  test "counts files embedded in card descriptions and comments" do
+    card = cards(:logo)
+    description_blob = upload_blob("card-description.txt", content_type: "text/plain")
+    comment = card.comments.create!(body: "Comment")
+    comment_blob = upload_blob("comment.txt", content_type: "text/plain")
+
+    perform_enqueued_jobs do
+      card.update!(description: attachment_html(description_blob))
+      comment.update!(body: attachment_html(comment_blob))
+    end
+
+    expected = description_blob.byte_size + comment_blob.byte_size
+    assert_equal expected, card.board.reload.bytes_used
+    assert_equal expected, card.account.reload.bytes_used
+  end
+
+  test "account usage includes attachments across all of its boards" do
+    writebook = boards(:writebook)
+    private_board = boards(:private)
+    writebook_blob = upload_blob("writebook.txt", content_type: "text/plain")
+    private_blob = upload_blob("private.txt", content_type: "text/plain")
+
+    perform_enqueued_jobs do
+      writebook.update!(public_description: attachment_html(writebook_blob))
+      private_board.update!(public_description: attachment_html(private_blob))
+    end
+
+    assert_equal writebook_blob.byte_size, writebook.reload.bytes_used
+    assert_equal private_blob.byte_size, private_board.reload.bytes_used
+    assert_equal writebook_blob.byte_size + private_blob.byte_size, writebook.account.reload.bytes_used
+  end
+
+  test "removing an attachment recalculates usage" do
+    board = boards(:writebook)
+    blob = upload_blob("removed.txt", content_type: "text/plain")
+
+    perform_enqueued_jobs do
+      board.update!(public_description: attachment_html(blob))
+    end
+
+    perform_enqueued_jobs do
+      board.public_description = "No more attachment"
+      board.save!
+    end
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, board.account.reload.bytes_used
+  end
+
+  test "moving a card moves its image usage between boards" do
+    card = cards(:logo)
+    old_board = card.board
+    new_board = boards(:private)
+    blob = upload_blob("moved.jpg")
+
+    perform_enqueued_jobs do
+      card.image.attach(blob)
+    end
+
+    perform_enqueued_jobs do
+      card.update!(board: new_board)
+    end
+
+    assert_equal 0, old_board.reload.bytes_used
+    assert_equal blob.byte_size, new_board.reload.bytes_used
+    assert_equal blob.byte_size, card.account.reload.bytes_used
+  end
+
+  test "sums multiple tracked attachments" do
+    board = boards(:writebook)
+    first_blob = upload_blob("first.txt")
+    second_blob = upload_blob("second.txt")
+    card_blob = upload_blob("card.txt")
+
+    perform_enqueued_jobs do
+      board.update!(public_description: attachment_html(first_blob) + attachment_html(second_blob))
+      cards(:logo).image.attach(card_blob)
+    end
+
+    expected = first_blob.byte_size + second_blob.byte_size + card_blob.byte_size
+    assert_equal expected, board.reload.bytes_used
+    assert_equal expected, board.account.reload.bytes_used
+  end
+
+  test "does not count attachments outside cards, board descriptions, card descriptions, and comments" do
+    account = accounts("37s")
+    avatar_blob = upload_blob("avatar.png")
+
+    perform_enqueued_jobs do
+      users(:david).avatar.attach(avatar_blob)
+    end
+
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "does not count attachments from another account" do
+    initech_card = cards(:radio)
+    blob = upload_blob("initech.txt")
+
+    perform_enqueued_jobs do
+      initech_card.image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, initech_card.board.reload.bytes_used
+    assert_equal blob.byte_size, initech_card.account.reload.bytes_used
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "destroying a comment removes its embedded file usage" do
+    card = cards(:logo)
+    comment = card.comments.create!(body: "Comment")
+    blob = upload_blob("comment-delete.txt")
+
+    perform_enqueued_jobs do
+      comment.update!(body: attachment_html(blob))
+    end
+
+    assert_equal blob.byte_size, card.board.reload.bytes_used
+
+    perform_enqueued_jobs do
+      comment.destroy!
+    end
+
+    assert_equal 0, card.board.reload.bytes_used
+    assert_equal 0, card.account.reload.bytes_used
+  end
+
+  test "destroying a card removes its image usage" do
+    card = cards(:logo)
+    board = card.board
+    blob = upload_blob("card-delete.txt")
+
+    perform_enqueued_jobs do
+      card.image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, board.reload.bytes_used
+
+    perform_enqueued_jobs do
+      card.destroy!
+    end
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, board.account.reload.bytes_used
+  end
+
+  test "destroying a card removes its description file usage" do
+    card = cards(:logo)
+    board = card.board
+    blob = upload_blob("card-description-delete.txt")
+
+    perform_enqueued_jobs do
+      card.update!(description: attachment_html(blob))
+    end
+
+    assert_equal blob.byte_size, board.reload.bytes_used
+
+    perform_enqueued_jobs do
+      card.destroy!
+    end
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, board.account.reload.bytes_used
+  end
+
+  test "destroying a board removes its description usage from the account" do
+    board = boards(:private)
+    account = board.account
+    blob = upload_blob("board-description-delete.txt")
+
+    perform_enqueued_jobs do
+      board.update!(public_description: attachment_html(blob))
+    end
+
+    assert_equal blob.byte_size, account.reload.bytes_used
+
+    perform_enqueued_jobs do
+      board.destroy!
+    end
+
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  private
+def upload_blob(filename, content_type: "text/plain")
+  ActiveStorage::Blob.create_and_upload!(
+    io: StringIO.new("contents of #{filename}"),
+    filename: filename,
+    content_type: content_type
+  )
+end
+
+    def attachment_html(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+end
