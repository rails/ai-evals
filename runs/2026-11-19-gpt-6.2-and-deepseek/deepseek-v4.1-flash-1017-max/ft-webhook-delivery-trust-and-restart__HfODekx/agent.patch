new file mode 100644
index 0000000..da6cc31
--- /dev/null
+++ b/app/models/event/webhookable.rb
@@ -0,0 +1,33 @@
+module Event::Webhookable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    deliveries = create_webhook_deliveries.select(&:previously_new_record?)
+
+    if deliveries.any?
+      Event::RelayJob.perform_later(self)
+      deliveries.each(&:deliver_later)
+    end
+  end
+  alias_method :relay_to_webhooks_later, :relay_later
+
+  def relay_now
+    create_webhook_deliveries.each do |delivery|
+      delivery.deliver if delivery.pending?
+    end
+  end
+  alias_method :relay_to_webhooks_now, :relay_now
+
+  private
+    def create_webhook_deliveries
+      board.webhooks.active.filter_map do |webhook|
+        if webhook.subscribed_to?(action)
+          webhook.deliveries.create_or_find_by!(event: self)
+        end
+      end
+    end
+end
