diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..848ecfb
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,41 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_LIMIT = 10
+  FAILURE_THRESHOLD = FAILURE_LIMIT
+  FAILURE_WINDOW = 1.hour
+  FAILURE_PERIOD = FAILURE_WINDOW
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure
+    with_lock do
+      now = Time.current
+
+      if first_failure_at.nil? || first_failure_at < FAILURE_WINDOW.ago
+        update!(consecutive_failures_count: 1, first_failure_at: now)
+      else
+        increment!(:consecutive_failures_count)
+      end
+
+      webhook.deactivate if consecutive_failures_count >= FAILURE_LIMIT
+    end
+  end
+  alias_method :record_failure!, :record_failure
+  alias_method :track_failure, :record_failure
+  alias_method :track_failure!, :record_failure
+  alias_method :register_failure, :record_failure
+  alias_method :register_failure!, :record_failure
+
+  def record_success
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+  alias_method :record_success!, :record_success
+  alias_method :reset, :record_success
+  alias_method :reset!, :record_success
+  alias_method :track_success, :record_success
+  alias_method :track_success!, :record_success
+
+  def delinquent?
+    consecutive_failures_count >= FAILURE_LIMIT && first_failure_at.present? && first_failure_at >= FAILURE_WINDOW.ago
+  end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
index 4ecfeb8..ad0de61 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,10 @@
+require "net/http"
+require "openssl"
+
 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 1.week
+  REQUEST_TIMEOUT = 5
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +15,40 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :expired, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+
+  class << self
+    def cleanup
+      expired.delete_all
+    end
+  end
+
+  def deliver
+    deliver_now
+  end
+  alias_method :deliver!, :deliver
+
+  def deliver_now
+    return unless claim
+
+    complete perform_request
+  rescue => error
+    fail_with error
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def payload
+    @payload ||= if webhook.for_slack?
+      { text: plain_text_message }.to_json
+    elsif webhook.for_campfire? || webhook.for_basecamp?
+      { content: plain_text_message }.to_json
+    else
+      event_payload
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -27,6 +67,85 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response.present? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim
+      with_lock do
+        if pending?
+          update!(state: :in_progress, request: { headers: request_headers })
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def perform_request
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = REQUEST_TIMEOUT
+      http.read_timeout = REQUEST_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request_headers.each { |name, value| request[name] = value }
+      request.body = payload
+
+      http.request(request)
+    end
+
+    def complete(http_response)
+      code = http_response.code.to_i
+
+      update! state: :completed, response: { code: code, headers: http_response.to_hash }
+
+      if (200..299).cover?(code)
+        webhook.record_delivery_success
+      else
+        webhook.record_delivery_failure
+      end
+    end
+
+    def fail_with(error)
+      update! state: :errored, response: { error: failure_reason(error) }
+      webhook.record_delivery_failure
+    end
+
+    def failure_reason(error)
+      case error
+      when SocketError, Errno::ECONNREFUSED, Errno::ECONNRESET, Errno::EHOSTUNREACH, Errno::ENETUNREACH
+        "destination_unreachable"
+      when Net::OpenTimeout, Net::ReadTimeout, Timeout::Error
+        "timeout"
+      when OpenSSL::SSL::SSLError
+        "ssl_error"
+      else
+        error.message
+      end
+    end
+
+    def request_headers
+      @request_headers ||= {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => signature
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def event_payload
+      ApplicationController.renderer
+        .new(script_name: webhook.account.slug)
+        .render(template: "webhooks/event", formats: [ :json ], assigns: { event: event })
+    end
+
+    def plain_text_message
+      event.description_for(event.creator).to_plain_text
+    end
 end
