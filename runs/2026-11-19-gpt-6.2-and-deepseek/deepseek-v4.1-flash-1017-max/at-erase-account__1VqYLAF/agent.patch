@@ -24,11 +27,67 @@ class User < ApplicationRecord
     end
   end
 
+  def erase!
+    destroy!
+  end
+
   private
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
 
+    def erase_associated_data
+      email_addresses = sign_in_event_email_addresses
+
+      sessions.delete_all
+      accesses.delete_all
+      reading_marks.delete_all
+      SignInEvent.where(email_address: email_addresses).delete_all
+
+      created_books.find_each do |book|
+        if book.everyone_access?
+          book.update_columns(creator_id: nil, author: DELETED_AUTHOR_BYLINE, updated_at: Time.current)
+        else
+          erase_book(book)
+        end
+      end
+    end
+
+    def erase_book(book)
+      leaf_ids = book.leaves.pluck(:id)
+
+      purge_book_attachments(book)
+      book.destroy!
+      remove_search_index_entries(leaf_ids)
+    end
+
+    def purge_book_attachments(book)
+      book.cover.purge if book.cover.attached?
+
+      book.leaves.with_leafables.find_each do |leaf|
+        leafable = leaf.leafable
+        leafable.image.purge if leafable.respond_to?(:image) && leafable.image.attached?
+      end
+    end
+
+    def remove_search_index_entries(leaf_ids)
+      return if leaf_ids.empty?
+
+      Leaf.connection.execute(
+        Leaf.sanitize_sql([ "delete from leaf_search_index where rowid in (?)", leaf_ids ])
+      )
+    end
+
+    def sign_in_event_email_addresses
+      addresses = [ email_address ]
+
+      if match = email_address.to_s.match(/\A(.+)-deactivated-[^@]+(@.+)\z/)
+        addresses << "#{match[1]}#{match[2]}"
+      end
+
+      addresses.compact.uniq
+    end
+
     def grant_access_to_everyone_books
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
