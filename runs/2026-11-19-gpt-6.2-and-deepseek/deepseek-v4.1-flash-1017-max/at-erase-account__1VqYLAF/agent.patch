index 0000000..a0243f4
--- /dev/null
+++ b/test/integration/user_erasure_attachments_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class UserErasureAttachmentsTest < ActionDispatch::IntegrationTest
+  test "erasing a user purges private book and page attachments and records" do
+    user = users(:kevin)
+    sign_in :david
+
+    book = Book.create!(title: "Attachment Book", creator: user, everyone_access: false)
+    book.cover.attach(io: File.open(file_fixture("pixel.bmp")), filename: "cover.bmp")
+    cover_attachment_id = book.cover.attachment.id
+    cover_blob_id = book.cover.blob.id
+
+    page = Page.create!(body: "Private attachment page body")
+    leaf = book.press(page, title: "Attachment Page")
+    markdown_id = page.markdown_body.id
+    edit = Edit.create!(leaf: leaf, leafable: page, action: :revision)
+
+    picture = Picture.create!(caption: "Private attachment picture")
+    picture.image.attach(io: File.open(file_fixture("white-rabbit.webp")), filename: "private.webp")
+    picture_attachment_id = picture.image.attachment.id
+    picture_blob_id = picture.image.blob.id
+    book.press(picture, title: "Attachment Picture")
+
+    delete user_path(user)
+
+    assert_nil Page.find_by(id: page.id)
+    assert_nil ActionText::Markdown.find_by(id: markdown_id)
+    assert_nil Edit.find_by(id: edit.id)
+    assert_nil Picture.find_by(id: picture.id)
+    assert_nil ActiveStorage::Attachment.find_by(id: cover_attachment_id)
+    assert_nil ActiveStorage::Blob.find_by(id: cover_blob_id)
+    assert_nil ActiveStorage::Attachment.find_by(id: picture_attachment_id)
+    assert_nil ActiveStorage::Blob.find_by(id: picture_blob_id)
+  end
+end
diff --git a/test/integration/user_erasure_test.rb b/test/integration/user_erasure_test.rb
new file mode 100644
index 0000000..af4bb5f
--- /dev/null
+++ b/test/integration/user_erasure_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class UserErasureTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "removing a user erases their data but keeps everyone-access books" do
+    user = users(:kevin)
+    shared_book = Book.create!(title: "Shared Book", author: user.name, creator: user, everyone_access: true)
+    shared_leaf = shared_book.press(Page.new, title: "Shared Page")
+    shared_leaf.update!(title: "Shared Erasure Search Term")
+    shared_leaf.reindex
+
+    private_book = Book.create!(title: "Private Book", author: user.name, creator: user, everyone_access: false)
+    private_leaf = private_book.press(Page.new, title: "Private Erasure Search Term")
+    private_leaf.reindex
+
+    Access.create!(user: users(:jason), book: shared_book, level: :reader)
+    ReadingMark.create!(user: user, leaf: shared_leaf, last_read_at: Time.current)
+    sign_in_event = SignInEvent.create!(action: :signed_in, email_address: user.email_address)
+    user_session = user.sessions.start!(user_agent: "test", ip_address: "127.0.0.1")
+
+    assert_difference -> { User.count }, -1 do
+      delete user_path(user)
+    end
+
+    assert_redirected_to users_path
+    assert_nil User.find_by(id: user.id)
+    assert_nil Session.find_by(id: user_session.id)
+    assert_nil Access.find_by(user_id: user.id)
+    assert_nil ReadingMark.find_by(user_id: user.id)
+    assert_nil SignInEvent.find_by(id: sign_in_event.id)
+
+    assert_nil Book.find_by(id: private_book.id)
+    assert_nil Leaf.find_by(id: private_leaf.id)
+    assert_nil Leaf.search("Private Erasure Search Term").first
+    assert_equal 0, Leaf.connection.select_value(
+      Leaf.sanitize_sql([ "select count(*) from leaf_search_index where rowid = ?", private_leaf.id ])
+    )
+
+    assert shared_book.reload
+    assert_nil shared_book.creator
+    assert_equal User::DELETED_AUTHOR_BYLINE, shared_book.author
+    assert shared_book.accessable?(user: users(:jason))
+    assert_includes Leaf.search("Shared Erasure Search Term"), shared_leaf
+  end
+
+  test "removing a previously deactivated user erases the address they signed in with" do
+    user = users(:kevin)
+    original_email_address = user.email_address
+    sign_in_event = SignInEvent.create!(action: :signed_in, email_address: original_email_address)
+
+    user.deactivate
+    user.reload
+    assert_not_equal original_email_address, user.email_address
+    deactivated_event = SignInEvent.create!(action: :signed_out, email_address: user.email_address)
+    other_users_event = SignInEvent.create!(action: :signed_in, email_address: users(:jason).email_address)
+
+    assert_difference -> { User.count }, -1 do
+      delete user_path(user)
+    end
+
+    assert_redirected_to users_path
+    assert_nil User.find_by(id: user.id)
+    assert_nil SignInEvent.find_by(id: sign_in_event.id)
+    assert_nil SignInEvent.find_by(id: deactivated_event.id)
+    assert SignInEvent.exists?(other_users_event.id)
+  end
+end
+
+class DeactivatedUserListTest < ActionDispatch::IntegrationTest
+  test "deactivated users remain available to erase from the user list" do
+    user = users(:kevin)
+    user.deactivate
+
+    sign_in :david
+    get users_path
+
+    assert_response :success
+    assert_in_body user.name
+    assert_select "form[action='#{user_path(user)}'] input[value='delete']", count: 1
+  end
+end
