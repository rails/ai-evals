+    config.after_initialize do
+      Rails.application.routes.default_url_options = { host: app_host, protocol: "https" }
+    end
+  end
+
+  # Deliver mail through the SMTP server configured by the operator. SMTP_HOST
+  # is accepted as an alias for SMTP_ADDRESS for compatibility with common
