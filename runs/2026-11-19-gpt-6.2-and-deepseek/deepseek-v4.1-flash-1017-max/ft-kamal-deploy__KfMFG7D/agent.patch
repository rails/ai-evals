+# Secrets defined here are available to config/deploy.yml. This file is safe to
+# commit as long as it only references environment variables or secret managers;
+# never put raw credentials in it.
+#
+# Generate a SECRET_KEY_BASE once and keep it stable across deploys:
+#
+#   bin/rails secret
+#
+# Then export it (or fetch it from your password manager) before running Kamal:
+#
+#   export SECRET_KEY_BASE="..."
+#   export SMTP_PASSWORD="..."
+#   export VAPID_PUBLIC_KEY="..."
+#   export VAPID_PRIVATE_KEY="..."
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Optional: only needed if you use Rails encrypted credentials. Fizzy itself
+# boots from SECRET_KEY_BASE above.
+RAILS_MASTER_KEY=$RAILS_MASTER_KEY
+
+SMTP_PASSWORD=$SMTP_PASSWORD
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
