new file mode 100644
index 0000000..f81c480
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,56 @@
+# Deploy Fizzy to a single Linux server with Docker.
+#
+# Replace the placeholder server address and hostname below, then fill in the
+# SMTP settings and secrets. See docs/deployment.md for the complete walkthrough.
+service: fizzy
+image: fizzy
+
+# Replace 192.0.2.1 with the IP address or hostname of your server.
+servers:
+  web:
+    - 192.0.2.1
+
+# kamal-proxy terminates TLS and obtains a Let's Encrypt certificate for the
+# hostname. DNS for this hostname must point at the server above, and ports 80
+# and 443 must be reachable.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Run a local registry on the deploy machine and tunnel it to the server, so a
+# one-box install doesn't need a separate hosted container registry.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64
+
+env:
+  clear:
+    # Must match proxy.host above.
+    APP_HOST: fizzy.example.com
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+
+    # Solid Queue runs inside Puma, so background jobs live in the same
+    # container as the web process.
+    SOLID_QUEUE_IN_PUMA: "true"
+
+    # Replace these with the SMTP details for your mail server.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_USERNAME: fizzy@example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - RAILS_MASTER_KEY
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# All SQLite databases, uploaded files, and other application state live under
+# /rails/storage. Keeping this as a named volume makes data survive redeploys.
+volumes:
+  - fizzy:/rails/storage
