diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..6d6eb20
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,179 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns account activity as JSON" do
+    get activities_path(format: :json)
+
+    assert_response :success
+
+    events = @response.parsed_body
+    assert_kind_of Array, events
+    assert_equal Event.where(board: users(:kevin).boards, action: ActivitiesController::ACTIVITY_ACTIONS).count, events.size
+
+    event = events.find { |item| item["id"] == events(:layout_assignment_jz).id }
+    expected = events(:layout_assignment_jz)
+
+    assert_equal "card_assigned", event["action"]
+    assert_equal expected.created_at.utc.as_json, event["created_at"]
+    assert_equal expected.description_for(users(:kevin)).to_plain_text, event["description"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, event["particulars"])
+    assert_equal card_url(cards(:layout)), event["url"]
+    assert_equal "Card", event["eventable_type"]
+    assert_equal cards(:layout).id, event["eventable"]["id"]
+    assert_equal cards(:layout).title, event["eventable"]["title"]
+    assert_equal boards(:writebook).id, event["board"]["id"]
+    assert_equal users(:david).id, event["creator"]["id"]
+  end
+
+  test "comment events link to the comment on the card" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |item| item["id"] == events(:layout_commented).id }
+    comment = comments(:layout_overflowing_david)
+
+    assert_equal "comment_created", event["action"]
+    assert_equal "Comment", event["eventable_type"]
+    assert_equal comment.id, event["eventable"]["id"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), event["url"]
+    assert_equal({}, event["particulars"])
+  end
+
+  test "filters by creator and board" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+    assert_equal [ users(:kevin).id ], @response.parsed_body.pluck("creator").pluck("id").uniq
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "excludes collection changes and includes title changes" do
+    board = boards(:writebook)
+    card = cards(:text)
+
+    collection_event = board.events.create! action: "card_collection_changed", creator: users(:kevin), eventable: card
+    title_event = board.events.create! action: "card_title_changed", creator: users(:kevin), eventable: card,
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+
+    get activities_path(format: :json)
+    ids = @response.parsed_body.pluck("id")
+
+    assert_not_includes ids, collection_event.id
+    assert_includes ids, title_event.id
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" },
+      @response.parsed_body.find { |item| item["id"] == title_event.id }["particulars"])
+  end
+
+  test "returns event-specific particulars and empty values for missing details" do
+    board = boards(:writebook)
+    card = cards(:text)
+
+    board_event = board.events.create! action: "card_board_changed", creator: users(:kevin), eventable: card,
+      particulars: { "particulars" => { "old_board" => "Old board", "new_board" => "New board" } }
+    missing_board_event = board.events.create! action: "card_board_changed", creator: users(:kevin), eventable: card
+    triage_event = board.events.create! action: "card_triaged", creator: users(:kevin), eventable: card,
+      particulars: { "particulars" => { "column" => "In progress" } }
+    missing_triage_event = board.events.create! action: "card_triaged", creator: users(:kevin), eventable: card
+    missing_title_event = board.events.create! action: "card_title_changed", creator: users(:kevin), eventable: card
+
+    get activities_path(format: :json)
+    events = @response.parsed_body.index_by { |item| item["id"] }
+
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, events[board_event.id]["particulars"])
+    assert_equal({ "old_board" => "", "new_board" => "" }, events[missing_board_event.id]["particulars"])
+    assert_equal({ "column" => "In progress" }, events[triage_event.id]["particulars"])
+    assert_equal({ "column" => "" }, events[missing_triage_event.id]["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, events[missing_title_event.id]["particulars"])
+  end
+
+  test "only returns activity from accessible boards" do
+    board = boards(:private)
+    event = board.events.create! action: "card_published", creator: users(:kevin), eventable: cards(:logo)
+
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), event.id
+
+    get activities_path(format: :json), params: { board_ids: [ board.id ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "includes board changes created by moving a card" do
+    card = cards(:logo)
+    with_current_user(users(:kevin)) { card.move_to(boards(:private)) }
+
+    get activities_path(format: :json)
+    event = @response.parsed_body.find { |item| item["action"] == "card_board_changed" && item["eventable"]["id"] == card.id }
+
+    assert event.present?
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, event["particulars"])
+    assert_equal boards(:private).id, event["board"]["id"]
+  end
+
+  test "includes triage events created by triaging a card" do
+    card = cards(:buy_domain)
+    with_current_user(users(:kevin)) { card.triage_into(columns(:writebook_in_progress)) }
+
+    get activities_path(format: :json)
+    event = @response.parsed_body.find { |item| item["action"] == "card_triaged" && item["eventable"]["id"] == card.id }
+
+    assert event.present?
+    assert_equal({ "column" => columns(:writebook_in_progress).name }, event["particulars"])
+  end
+
+  test "authenticates with a bearer token" do
+    cookies.delete :session_token
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+  end
+
+  test "includes title changes created by updating a card" do
+    card = cards(:text)
+    with_current_user(users(:kevin)) { card.update! title: "Make the text larger" }
+
+    get activities_path(format: :json)
+    event = @response.parsed_body.find { |item| item["action"] == "card_title_changed" && item["eventable"]["id"] == card.id }
+
+    assert event.present?
+    assert_equal({ "old_title" => "The text is too small", "new_title" => "Make the text larger" }, event["particulars"])
+    assert_includes event["description"], "Make the text larger"
+  end
+
+  test "paginates newest first" do
+    20.times do
+      boards(:writebook).events.create! action: "card_published", creator: users(:kevin), eventable: cards(:text)
+    end
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    first_page = @response.parsed_body
+    assert_equal 15, first_page.size
+    assert @response.headers["Link"].present?
+    assert_equal 31, @response.headers["X-Total-Count"].to_i
+
+    timestamps = first_page.pluck("created_at").map { |timestamp| Time.zone.parse(timestamp) }
+    assert_equal timestamps.sort.reverse, timestamps
+
+    get next_page_from_link_header(@response.headers["Link"])
+    assert_response :success
+    assert_operator @response.parsed_body.size, :>, 0
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
