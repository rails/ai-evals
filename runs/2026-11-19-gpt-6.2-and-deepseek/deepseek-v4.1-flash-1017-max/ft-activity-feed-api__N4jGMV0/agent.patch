@@ -0,0 +1,44 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ]
+
+  def index
+    set_page_and_extract_portion_from activity
+  end
+
+  private
+    def activity
+      events = accessible_events
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+      events
+    end
+
+    def accessible_events
+      Event
+        .preloaded
+        .where(board: Current.user.boards)
+        .where(action: ACTIVITY_ACTIONS)
+        .order(created_at: :desc, id: :desc)
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
diff --git a/app/helpers/activities_helper.rb b/app/helpers/activities_helper.rb
new file mode 100644
index 0000000..908abff
--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,32 @@
+module ActivitiesHelper
+  def activity_description(event)
+    event.description_for(Current.user).to_plain_text
+  end
+
+  def activity_particulars(event)
+    details = event.particulars || {}
+    details = details["particulars"] if details["particulars"].is_a?(Hash)
+    details = details.with_indifferent_access
+
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(details[:assignee_ids]) }
+    when "card_board_changed"
+      { old_board: details[:old_board].to_s, new_board: details[:new_board].to_s }
+    when "card_title_changed"
+      { old_title: details[:old_title].to_s, new_title: details[:new_title].to_s }
+    when "card_triaged"
+      { column: details[:column].to_s }
+    else
+      {}
+    end
+  end
+
+  def activity_url(event)
+    if event.action.comment_created?
+      card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable))
+    else
+      card_url(event.card)
+    end
+  end
+end
