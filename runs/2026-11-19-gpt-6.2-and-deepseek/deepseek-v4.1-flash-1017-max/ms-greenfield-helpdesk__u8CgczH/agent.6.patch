--- /dev/null
+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,70 @@
+module Api
+  module V1
+    class GroupMembershipsController < ApplicationController
+      before_action :authenticate_user!
+      before_action :ensure_account_active!
+      before_action :require_staff!, only: %i[index show]
+      before_action :require_admin!, only: %i[create destroy make_default]
+      before_action :set_group_membership, only: %i[show destroy make_default]
+
+      def index
+        scope = current_account.group_memberships.includes(:group, :user).order(id: :asc)
+        scope = filter_by_group_id(scope) if params[:group_id].present?
+        scope = filter_by_user_id(scope) if params[:user_id].present?
+
+        records, meta = paginate(scope)
+        render json: {
+          group_memberships: records.map { |membership| GroupMembershipSerializer.render(membership) }
+        }.merge(meta), status: :ok
+      end
+
+      def show
+        render json: { group_membership: GroupMembershipSerializer.render(@group_membership) }, status: :ok
+      end
+
+      def create
+        group_membership = current_account.group_memberships.create!(group_membership_payload)
+        render json: { group_membership: GroupMembershipSerializer.render(group_membership) }, status: :created
+      end
+
+      def destroy
+        @group_membership.destroy!
+        head :no_content
+      end
+
+      def make_default
+        @group_membership.update!(default: true)
+        render json: { group_membership: GroupMembershipSerializer.render(@group_membership) }, status: :ok
+      end
+
+      private
+
+      def set_group_membership
+        @group_membership = current_account.group_memberships.find(params[:id])
+      end
+
+      def group_membership_payload
+        params.require(:group_membership).permit(:group_id, :user_id, :default)
+      end
+
+      def filter_by_group_id(scope)
+        id = integer_id(params[:group_id])
+        return scope.none if id.nil?
+
+        scope.where(group_id: id)
+      end
+
+      def filter_by_user_id(scope)
+        id = integer_id(params[:user_id])
+        return scope.none if id.nil?
+
+        scope.where(user_id: id)
+      end
+
+      def integer_id(value)
+        id = Integer(value.to_s, 10, exception: false)
+        id if id&.positive?
+      end
+    end
+  end
+end
