@@ -0,0 +1,73 @@
+class GroupMembership < ApplicationRecord
+  belongs_to :account
+  belongs_to :group
+  belongs_to :user
+
+  before_validation :set_account_from_group
+  validate :group_must_belong_to_account
+  validate :user_must_belong_to_account
+  validate :user_must_be_staff
+  validates :user_id, uniqueness: { scope: :group_id }
+  before_validation :retain_default_when_only_membership, if: -> { persisted? && default_changed? && !default? }
+
+  before_save :clear_other_defaults, if: :default?
+  before_create :ensure_default_membership
+
+  after_destroy :promote_remaining_default
+  after_destroy :clear_invalid_ticket_assignments
+
+  private
+
+  def set_account_from_group
+    self.account_id ||= group&.account_id
+  end
+
+  def group_must_belong_to_account
+    return if group.nil? || account_id.nil?
+    return if group.account_id == account_id
+
+    errors.add(:group, "must belong to this account")
+  end
+
+  def user_must_belong_to_account
+    return if user.nil? || account_id.nil?
+    return if user.account_id == account_id
+
+    errors.add(:user, "must belong to this account")
+  end
+
+  def user_must_be_staff
+    return if user.nil?
+    return if user.staff?
+
+    errors.add(:user, "must be a staff member")
+  end
+
+  def retain_default_when_only_membership
+    return if self.class.where(user_id: user_id, default: true).where.not(id: id).exists?
+
+    self.default = true
+  end
+
+  def clear_other_defaults
+    self.class.where(user_id: user_id).where.not(id: id).update_all(default: false)
+  end
+
+  def ensure_default_membership
+    return if default?
+    return if self.class.where(user_id: user_id, default: true).exists?
+
+    self.default = true
+  end
+
+  def promote_remaining_default
+    return unless default?
+
+    replacement = self.class.where(user_id: user_id).order(id: :asc).first
+    replacement&.update_columns(default: true)
+  end
+
+  def clear_invalid_ticket_assignments
+    Ticket.where(group_id: group_id, assignee_id: user_id).update_all(assignee_id: nil)
+  end
+end
