diff --git a/config/initializers/action_mailbox_test_routing.rb b/config/initializers/action_mailbox_test_routing.rb
new file mode 100644
index 0000000..ae38c23
--- /dev/null
+++ b/config/initializers/action_mailbox_test_routing.rb
@@ -0,0 +1,34 @@
+# Action Mailbox normally routes inbound email from an +after_create_commit+
+# callback. Transactional integration tests never commit the surrounding test
+# transaction, so relayed mail would remain pending unless it is routed while
+# the request is still active. Route it synchronously for relay requests only;
+# the Message-ID delivery ledger makes any later commit callback a no-op.
+if Rails.env.test?
+  Rails.application.config.after_initialize do
+    ActionMailbox::InboundEmail.class_eval do
+      after_create :route_synchronously_during_test_relay, if: :pending?
+
+      private
+
+      def route_synchronously_during_test_relay
+        return unless Thread.current[:action_mailbox_relay_request]
+
+        ActionMailbox::RoutingJob.perform_now(self)
+      end
+    end
+
+    ActionMailbox::Ingresses::Relay::InboundEmailsController.class_eval do
+      around_action :mark_action_mailbox_relay_request
+
+      private
+
+      def mark_action_mailbox_relay_request
+        previous = Thread.current[:action_mailbox_relay_request]
+        Thread.current[:action_mailbox_relay_request] = true
+        yield
+      ensure
+        Thread.current[:action_mailbox_relay_request] = previous
+      end
+    end
+  end
+end
