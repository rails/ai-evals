@@ -0,0 +1,36 @@
+require "cgi"
+
+class UserMailer < ApplicationMailer
+  def verification_email(user, token)
+    url = frontend_url("/verify-email", account: user.account.subdomain, token: token)
+    mail(
+      to: user.email,
+      from: mail_from,
+      subject: "Verify your email address",
+      body: "Hello #{user.name},\n\nVerify your email address by visiting:\n#{url}\n\n" \
+            "If you did not create this account, you can ignore this email.\n"
+    )
+  end
+
+  def password_reset_email(user, token)
+    url = frontend_url("/reset-password", account: user.account.subdomain, token: token)
+    mail(
+      to: user.email,
+      from: mail_from,
+      subject: "Reset your password",
+      body: "Hello #{user.name},\n\nReset your password by visiting:\n#{url}\n\n" \
+            "If you did not request a password reset, you can ignore this email.\n"
+    )
+  end
+
+  private
+
+  def mail_from
+    ENV["HELPDESK_MAIL_FROM"].presence || "support@example.test"
+  end
+
+  def frontend_url(path, account:, token:)
+    base = (ENV["HELPDESK_FRONTEND_URL"].presence || "http://localhost:3001").to_s.sub(%r{/+\z}, "")
+    "#{base}#{path}?account=#{CGI.escape(account.to_s)}&token=#{CGI.escape(token.to_s)}"
+  end
+end
diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..2f0f881
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,42 @@
+class Account < ApplicationRecord
+  CANCELLATION_GRACE_PERIOD = 90.days
+
+  has_many :users, dependent: :destroy
+  has_many :user_sessions, dependent: :destroy
+
+  before_validation :normalize_subdomain
+
+  validates :name, presence: true
+  validates :subdomain, presence: true, uniqueness: { case_sensitive: false },
+                        format: { with: /\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z/, message: "may only contain lowercase letters, numbers, and hyphens" }
+
+  scope :active, -> { where(cancelled_at: nil) }
+  scope :cancelled, -> { where.not(cancelled_at: nil) }
+  scope :cancelled_before, ->(time) { where("cancelled_at <= ?", time) }
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def active?
+    !cancelled?
+  end
+
+  def reactivation_deadline
+    cancelled_at && cancelled_at + CANCELLATION_GRACE_PERIOD
+  end
+
+  def reactivatable?
+    cancelled? && Time.current <= reactivation_deadline
+  end
+
+  def purge_eligible?
+    cancelled? && cancelled_at <= CANCELLATION_GRACE_PERIOD.ago
+  end
+
+  private
+
+  def normalize_subdomain
+    self.subdomain = subdomain.to_s.strip.downcase
+  end
+end
