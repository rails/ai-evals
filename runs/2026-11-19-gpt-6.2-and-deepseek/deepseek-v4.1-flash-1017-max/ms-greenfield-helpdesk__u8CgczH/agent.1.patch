diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..c467e43
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,60 @@
+module Api
+  module V1
+    class AccountsController < ApplicationController
+      before_action :authenticate_user!, only: %i[show cancel reactivate]
+      before_action :ensure_account_active!, only: %i[show cancel]
+      before_action :require_owner!, only: %i[cancel reactivate]
+
+      def create
+        account_payload = params.require(:account)
+        admin_payload = account_payload.require(:admin).permit(:name, :email, :password)
+
+        account = nil
+        user = nil
+
+        ActiveRecord::Base.transaction do
+          account = Account.create!(account_payload.permit(:name, :subdomain))
+          user = account.users.create!(
+            admin_payload.merge(role: "admin", verified: false)
+          )
+        end
+
+        token = user.issue_email_verification_token!
+        UserMailer.verification_email(user, token).deliver_now
+
+        render json: {
+          account: AccountSerializer.render(account),
+          user: UserSerializer.render(user)
+        }, status: :created
+      end
+
+      def show
+        render json: { account: AccountSerializer.render(current_account) }, status: :ok
+      end
+
+      def cancel
+        if current_account.cancelled?
+          return render_error("Account is already cancelled", :unprocessable_entity)
+        end
+
+        current_account.update!(cancelled_at: Time.current)
+        current_account.user_sessions.destroy_all
+
+        render json: { account: AccountSerializer.render(current_account) }, status: :ok
+      end
+
+      def reactivate
+        unless current_account.cancelled?
+          return render_error("Account is not cancelled", :unprocessable_entity)
+        end
+
+        unless current_account.reactivatable?
+          return render_error("The reactivation period has expired", :unprocessable_entity)
+        end
+
+        current_account.update!(cancelled_at: nil)
+        render json: { account: AccountSerializer.render(current_account) }, status: :ok
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..a15c2b7
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,69 @@
+module Api
+  module V1
+    class EmailVerificationsController < ApplicationController
+      def create
+        payload = params.require(:email_verification)
+        email = payload.require(:email).to_s.strip.downcase
+        account = resolve_account_for_email(email)
+        return if performed?
+
+        if account.nil?
+          return render json: { message: "If an account exists, a verification link has been sent" }, status: :ok
+        end
+
+        user = account.users.find_by(email: email)
+        if user && !user.verified?
+          token = user.issue_email_verification_token!
+          UserMailer.verification_email(user, token).deliver_now
+        end
+
+        render json: { message: "If an account exists, a verification link has been sent" }, status: :ok
+      end
+
+      def confirm
+        payload = params.require(:email_verification).permit(:token)
+        account = scoped_account_for_token_confirmation
+        return if performed?
+
+        user = User.find_by_email_verification_token(payload[:token].to_s, account: account)
+        unless user
+          return render_error("Invalid or expired verification token", :unprocessable_entity)
+        end
+
+        user.mark_verified!
+        render json: { user: UserSerializer.render(user) }, status: :ok
+      end
+
+      private
+
+      def resolve_account_for_email(email)
+        if request.headers["X-Helpdesk-Account"].present?
+          account = account_from_header
+          return nil if account.nil?
+          return account
+        end
+
+        accounts = Account.joins(:users)
+                          .where("LOWER(users.email) = ?", email)
+                          .distinct
+                          .to_a
+        return nil if accounts.empty?
+        return accounts.first if accounts.one?
+
+        render_error("X-Helpdesk-Account header is required for this email", :unprocessable_entity)
+        nil
+      end
+
+      def scoped_account_for_token_confirmation
+        return nil if request.headers["X-Helpdesk-Account"].blank?
+
+        account = account_from_header
+        if account.nil?
+          render_error("Account not found", :not_found)
+          return nil
+        end
+        account
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/me_controller.rb b/app/controllers/api/v1/me_controller.rb
new file mode 100644
index 0000000..1a102ce
--- /dev/null
+++ b/app/controllers/api/v1/me_controller.rb
@@ -0,0 +1,31 @@
+module Api
+  module V1
+    class MeController < ApplicationController
+      before_action :authenticate_user!
+      before_action :ensure_account_active!
+
+      def show
+        render json: { user: UserSerializer.render(current_user) }, status: :ok
+      end
+
+      def update
+        user_payload = params.require(:user).permit(:name)
+        current_user.update!(user_payload)
+        render json: { user: UserSerializer.render(current_user) }, status: :ok
+      end
+
+      def password
+        payload = params.require(:password_change).permit(:current_password, :password)
+
+        unless current_user.authenticate(payload[:current_password].to_s)
+          return render_error("Current password is incorrect", :unprocessable_entity)
+        end
+
+        current_user.update!(password: payload[:password])
+        current_user.user_sessions.destroy_all
+
+        render json: { message: "Password changed successfully" }, status: :ok
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/password_resets_controller.rb b/app/controllers/api/v1/password_resets_controller.rb
new file mode 100644
index 0000000..4c32b47
--- /dev/null
+++ b/app/controllers/api/v1/password_resets_controller.rb
@@ -0,0 +1,71 @@
+module Api
+  module V1
+    class PasswordResetsController < ApplicationController
+      def create
+        payload = params.require(:password_reset)
+        email = payload.require(:email).to_s.strip.downcase
+        account = resolve_account_for_email(email)
+        return if performed?
+
+        if account
+          user = account.users.find_by(email: email)
+          if user
+            token = user.issue_password_reset_token!
+            UserMailer.password_reset_email(user, token).deliver_now
+          end
+        end
+
+        render json: { message: "If an account exists, a password reset link has been sent" }, status: :ok
+      end
+
+      def confirm
+        payload = params.require(:password_reset).permit(:token, :password)
+        account = scoped_account_for_token_confirmation
+        return if performed?
+
+        user = User.find_by_password_reset_token(payload[:token].to_s, account: account)
+        unless user
+          return render_error("Invalid or expired password reset token", :unprocessable_entity)
+        end
+
+        user.update!(
+          password: payload[:password],
+          password_reset_token_digest: nil,
+          password_reset_sent_at: nil
+        )
+        user.user_sessions.destroy_all
+
+        render json: { user: UserSerializer.render(user) }, status: :ok
+      end
+
+      private
+
+      def resolve_account_for_email(email)
+        if request.headers["X-Helpdesk-Account"].present?
+          return account_from_header
+        end
+
+        accounts = Account.joins(:users)
+                          .where("LOWER(users.email) = ?", email)
+                          .distinct
+                          .to_a
+        return nil if accounts.empty?
+        return accounts.first if accounts.one?
+
+        render_error("X-Helpdesk-Account header is required for this email", :unprocessable_entity)
+        nil
+      end
+
+      def scoped_account_for_token_confirmation
+        return nil if request.headers["X-Helpdesk-Account"].blank?
+
+        account = account_from_header
+        if account.nil?
+          render_error("Account not found", :not_found)
+          return nil
+        end
+        account
+      end
+    end
+  end
+end
