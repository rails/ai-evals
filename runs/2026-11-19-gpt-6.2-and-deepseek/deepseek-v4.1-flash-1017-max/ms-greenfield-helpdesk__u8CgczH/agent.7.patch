+      def merge
+        merge_payload = params.require(:merge).permit(
+          :target_id,
+          source_comment: %i[body public],
+          target_comment: %i[body public]
+        )
+        target_id = merge_payload[:target_id].presence
+
+        return render_error("Target ticket is required", :unprocessable_entity) if target_id.blank?
+
+        target = current_account.tickets.includes(:requester, :assignee, :group).find_by(id: target_id)
+        return render_error("Target ticket not found", :not_found) if target.nil?
+
+        if target.id == @ticket.id
+          return render_error("A ticket cannot be merged into itself", :unprocessable_entity)
+        end
+
+        if @ticket.closed? || @ticket.merged?
+          return render_error("Only open tickets can be merged", :unprocessable_entity)
+        end
+
+        if target.closed? || target.merged?
+          return render_error("Target ticket is not open for merges", :unprocessable_entity)
+        end
+
+        unless @ticket.requester_id == target.requester_id
+          return render_error("Target ticket must belong to the same customer", :unprocessable_entity)
+        end
+
+        Ticket.transaction do
+          @ticket.update!(status: "closed", merged_into_id: target.id)
+
+          create_merge_comment(
+            @ticket,
+            merge_payload[:source_comment],
+            default_body: "This ticket has been merged into ticket ##{target.id}."
+          )
+          create_merge_comment(
+            target,
+            merge_payload[:target_comment],
+            default_body: "Ticket ##{@ticket.id} has been merged into this ticket."
+          )
+        end
+
+        @ticket.reload
+        target.reload
+        render json: {
+          source: TicketSerializer.render_ticket(@ticket),
+          target: TicketSerializer.render_ticket(target)
+        }, status: :ok
+      end
+
