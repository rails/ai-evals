+# frozen_string_literal: true
+
+# Rails 7 introduced #to_fs and stopped supporting Time#to_s(:format).
+# Redmine must remain runnable on Rails 6.1 during the rolling upgrade, so
+# provide the same API while the older framework is still supported.
+if Rails::VERSION::MAJOR < 7
+  [Time, Date, DateTime, ActiveSupport::TimeWithZone].each do |klass|
+    klass.alias_method :to_fs, :to_formatted_s
+  end
+end
