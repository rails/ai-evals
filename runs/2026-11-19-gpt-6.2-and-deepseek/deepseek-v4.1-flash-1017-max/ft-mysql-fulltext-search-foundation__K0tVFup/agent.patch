@@ -47,6 +47,22 @@ class Card < ApplicationRecord
     end
   end
 
+  scope :search, ->(query) do
+    if term = query.to_s.strip.presence
+      pattern = "%#{sanitize_sql_like(term)}%"
+      matching_rich_text = ActionText::RichText.where("action_text_rich_texts.body LIKE ?", pattern)
+      matching_description_ids = matching_rich_text.where(record_type: "Card", name: "description").select(:record_id)
+      matching_comment_ids = matching_rich_text.where(record_type: "Comment", name: "body").select(:record_id)
+      matching_comment_card_ids = Comment.where(id: matching_comment_ids).select(:card_id)
+
+      where("cards.title LIKE ?", pattern)
+        .or(where(id: matching_description_ids))
+        .or(where(id: matching_comment_card_ids))
+    else
+      none
+    end
+  end
+
   def card
