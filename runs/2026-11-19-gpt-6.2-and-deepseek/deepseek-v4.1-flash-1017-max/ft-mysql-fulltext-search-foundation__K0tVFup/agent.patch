   end
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..a2adae4
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,54 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel panel--wide shadow center txt-align-start flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "flex gap" do %>
+    <%= search_field_tag :q, @query,
+          placeholder: "Search cards…",
+          class: "input full-width",
+          autofocus: true,
+          autocorrect: "off",
+          autocomplete: "off" %>
+    <%= submit_tag "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <p class="txt-small txt-subtle margin-none">
+      Results for <strong><%= @query %></strong>
+    </p>
+
+    <% if @cards.any? %>
+      <ul class="unpad flex flex-column gap">
+        <% @cards.each do |card| %>
+          <% matching_comments = @matching_comments.fetch(card.id, []).first(3) %>
+          <li class="search-result pad border-radius" style="border: var(--border)">
+            <div class="flex align-baseline gap-half">
+              <%= link_to highlight_search_matches(card.title, @query), card_path(card), class: "search-result__title txt-medium" %>
+              <span class="txt-small txt-subtle"><%= card.board.name %></span>
+            </div>
+
+            <% if card.description.present? %>
+              <p class="search-result__snippet txt-small margin-none">
+                <%= highlight_search_matches(search_excerpt(card.description, @query), @query) %>
+              </p>
+            <% end %>
+
+            <% matching_comments.each do |comment| %>
+              <p class="search-result__snippet txt-small margin-none">
+                <span class="txt-subtle"><%= comment.creator.familiar_name %>:</span>
+                <%= highlight_search_matches(search_excerpt(comment.body, @query), @query) %>
+              </p>
+            <% end %>
+          </li>
+        <% end %>
+      </ul>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @query %>”</div>
+    <% end %>
+  <% else %>
+    <div class="blank-slate">Search cards by title, description, or comments.</div>
+  <% end %>
+</section>
