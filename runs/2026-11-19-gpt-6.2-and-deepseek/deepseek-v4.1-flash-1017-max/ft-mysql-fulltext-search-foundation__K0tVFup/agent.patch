@@ -0,0 +1,26 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = Current.user.accessible_cards.published.search(@query).reverse_chronologically.preload(:board, :creator, :rich_text_description)
+    @matching_comments = matching_comments
+  end
+
+  private
+    def matching_comments
+      if @query.present? && @cards.any?
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(@query)}%"
+        matching_comment_ids = ActionText::RichText
+          .where(record_type: "Comment", name: "body")
+          .where("action_text_rich_texts.body LIKE ?", pattern)
+          .select(:record_id)
+
+        Comment
+          .where(card_id: @cards.select(:id), id: matching_comment_ids)
+          .preload(:creator, :rich_text_body)
+          .order(created_at: :desc)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..66419d6
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,35 @@
+module SearchHelper
+  def highlight_search_matches(content, query)
+    text = h(search_plain_text(content))
+
+    if query.blank?
+      text
+    else
+      highlight(text, search_terms(query), sanitize: false)
+    end
+  end
+
+  def search_excerpt(content, query, length: 200)
+    text = search_plain_text(content).squish
+    return "" if text.blank?
+
+    if first_match = search_terms(query).filter_map { |term| text.downcase.index(term.downcase) }.min
+      start = [ first_match - (length / 3), 0 ].max
+      excerpt = text[start, length]
+      excerpt = "…#{excerpt}" if start.positive?
+      excerpt += "…" if start + length < text.length
+      excerpt
+    else
+      text.truncate(length)
+    end
+  end
+
+  private
+    def search_plain_text(content)
+      content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    end
+
+    def search_terms(query)
+      query.to_s.split
+    end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
