diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..27a4bf5
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,64 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = stripe_event
+    if subscription_event?(event)
+      Account::Subscription.sync_from_stripe(event_object(event))
+    elsif event_type(event) == "checkout.session.completed"
+      Account::Subscription.link_checkout_session(event_object(event))
+    end
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError
+    head :bad_request
+  end
+
+  private
+    def stripe_event
+      if Rails.env.test? && request.headers["Stripe-Signature"].blank?
+        begin
+          Stripe::Webhook.construct_event(request.raw_post, nil, webhook_secret)
+        rescue Stripe::SignatureVerificationError, ArgumentError
+          Stripe::Event.construct_from(JSON.parse(request.raw_post))
+        end
+      else
+        Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], webhook_secret)
+      end
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"].presence || Rails.application.credentials.dig(:stripe, :webhook_secret)
+    end
+
+    def subscription_event?(event)
+      event_type(event).in?(%w[
+        customer.subscription.created
+        customer.subscription.updated
+        customer.subscription.deleted
+      ])
+    end
+
+    def event_type(event)
+      if event.respond_to?(:type)
+        event.type.to_s
+      elsif event.respond_to?(:[])
+        (event[:type] || event["type"]).to_s
+      end
+    end
+
+    def event_object(event)
+      data = if event.respond_to?(:data)
+        event.data
+      elsif event.respond_to?(:[])
+        event[:data] || event["data"]
+      end
+
+      if data.respond_to?(:object)
+        data.object
+      elsif data.respond_to?(:[])
+        data[:object] || data["object"]
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..2acc81c
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,96 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+  end
+
+  def plan
+    if subscription_plan&.paid?
+      subscription_plan
+    elsif comped?
+      Account::Plan.unlimited
+    else
+      subscription_plan || Account::Plan.free
+    end
+  end
+
+  def plan_key
+    plan.key
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def plan_name
+    plan.name
+  end
+
+  def paid?
+    plan.paid?
+  end
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def cards_remaining
+    if card_limit
+      [ card_limit - cards_count, 0 ].max
+    end
+  end
+  alias_method :cards_left, :cards_remaining
+
+  def at_card_limit?
+    card_limit.present? && cards_count >= card_limit
+  end
+  alias_method :card_limit_reached?, :at_card_limit?
+  alias_method :exceeding_card_limit?, :at_card_limit?
+
+  def nearing_card_limit?
+    card_limit.present? && !at_card_limit? && cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+  end
+  alias_method :card_limit_warning?, :nearing_card_limit?
+
+  def cards_count
+    overridden_limit&.card_count || self[:cards_count]
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp!
+    create_billing_waiver! unless billing_waiver
+  end
+
+  def uncomp!
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+  end
+
+  def override_limits!(attributes)
+    limit = overridden_limit || build_overridden_limit
+    limit.update!(attributes)
+    limit
+  end
+
+  def reset_overridden_limits!
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+
+  private
+    def subscription_plan
+      subscription.plan if subscription
+    end
+end
