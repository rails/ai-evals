     get "stats", to: "stats#show"
+
+    patch "accounts/:account_id/comp", to: "comps#create", as: :patch_admin_account_comp
+    put "accounts/:account_id/comp", to: "comps#create", as: :put_admin_account_comp
+    patch "accounts/:account_id/override", to: "overrides#create", as: :patch_admin_account_override
+    put "accounts/:account_id/override", to: "overrides#create", as: :put_admin_account_override
+    resources :accounts, only: [ :index, :show ] do
+      resource :comp, only: [ :create, :destroy ], controller: "comps"
+      resource :override, only: [ :create, :destroy ], controller: "overrides"
+
+      member do
+        post :uncomp, to: "comps#destroy"
+        delete :uncomp, to: "comps#destroy"
+        post :override, to: "overrides#create"
+        delete :reset, to: "overrides#destroy"
+      end
+    end
   end
 end
