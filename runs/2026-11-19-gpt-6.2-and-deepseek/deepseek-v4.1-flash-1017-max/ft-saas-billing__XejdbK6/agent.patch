diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..6e196d9
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,196 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  ACTIVE_STATUSES = %w[active trialing past_due].freeze
+  INACTIVE_STATUSES = %w[canceled unpaid incomplete_expired].freeze
+
+  validates :plan_key, presence: true
+
+  def plan
+    if active?
+      Account::Plan.find(plan_key) || Account::Plan.free
+    else
+      Account::Plan.free
+    end
+  end
+
+  def active?
+    status.blank? || status.to_s.in?(ACTIVE_STATUSES)
+  end
+
+  def plan_name
+    plan.name
+  end
+
+  def sync_from_stripe(stripe_subscription)
+    attributes = StripeSubscriptionAttributes.new(stripe_subscription)
+
+    self.stripe_subscription_id = attributes.id || stripe_subscription_id
+    self.stripe_customer_id = attributes.customer_id || stripe_customer_id
+    self.status = attributes.status || status
+    self.current_period_end = attributes.current_period_end || current_period_end
+    self.cancel_at = attributes.cancel_at || cancel_at
+    self.next_amount_due_in_cents = attributes.next_amount_due_in_cents || next_amount_due_in_cents
+    self.plan_key = attributes.plan_key
+
+    save!
+    self
+  end
+
+  class << self
+    def sync_from_stripe(stripe_subscription)
+      attributes = StripeSubscriptionAttributes.new(stripe_subscription)
+      subscription = find_existing(attributes) || build_from_stripe(attributes)
+      subscription&.sync_from_stripe(stripe_subscription)
+    end
+
+    def link_checkout_session(checkout_session)
+      customer_id = checkout_session_value(checkout_session, :customer)
+      customer_id = customer_id.id if customer_id.respond_to?(:id)
+      subscription_id = checkout_session_value(checkout_session, :subscription)
+      subscription_id = subscription_id.id if subscription_id.respond_to?(:id)
+      metadata = checkout_session_value(checkout_session, :metadata) || {}
+      account_id = metadata[:account_id] || metadata["account_id"] || checkout_session_value(checkout_session, :client_reference_id)
+
+      subscription = find_by(stripe_customer_id: customer_id) if customer_id.present?
+      account = (Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id)) if account_id.present?
+      subscription ||= find_by(account: account) if account
+      subscription ||= new(account: account, plan_key: Account::Plan::FREE_KEY) if account
+      return unless subscription
+
+      subscription.update!(
+        stripe_customer_id: customer_id.presence || subscription.stripe_customer_id,
+        stripe_subscription_id: subscription_id.presence || subscription.stripe_subscription_id
+      )
+    end
+
+    private
+      def find_existing(attributes)
+        subscription = find_by(stripe_subscription_id: attributes.id) if attributes.id.present?
+        subscription ||= find_by(stripe_customer_id: attributes.customer_id) if attributes.customer_id.present?
+        subscription ||= find_by(account: attributes.account) if attributes.account
+        subscription
+      end
+
+      def build_from_stripe(attributes)
+        new(account: attributes.account) if attributes.account
+      end
+
+      def checkout_session_value(checkout_session, key)
+        if checkout_session.respond_to?(key)
+          checkout_session.public_send(key)
+        elsif checkout_session.respond_to?(:[])
+          checkout_session[key] || checkout_session[key.to_s]
+        end
+      end
+  end
+
+  class StripeSubscriptionAttributes
+    def initialize(stripe_subscription)
+      @stripe_subscription = stripe_subscription
+    end
+
+    def id
+      value_for(:id)
+    end
+
+    def customer_id
+      customer = value_for(:customer)
+      if customer.respond_to?(:id)
+        customer.id
+      elsif customer.respond_to?(:[]) && !customer.is_a?(String)
+        customer[:id] || customer["id"]
+      else
+        customer
+      end
+    end
+
+    def status
+      value_for(:status)
+    end
+
+    def current_period_end
+      time_for(value_for(:current_period_end) || item_value(:current_period_end))
+    end
+
+    def cancel_at
+      time_for(value_for(:cancel_at))
+    end
+
+    def next_amount_due_in_cents
+      value_for_object(value_for_object(item, :price), :unit_amount)
+    end
+
+    def plan_key
+      if status.to_s.in?(INACTIVE_STATUSES)
+        Account::Plan::FREE_KEY
+      elsif plan = Account::Plan.from_stripe_price(price_id)
+        plan.key
+      elsif metadata_plan_key.present?
+        Account::Plan.find(metadata_plan_key)&.key || metadata_plan_key
+      else
+        Account::Plan::FREE_KEY
+      end
+    end
+
+    def account
+      account_id = metadata[:account_id] || metadata["account_id"] || metadata[:queenbee_id] || metadata["queenbee_id"]
+      (Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id)) if account_id.present?
+    end
+
+    private
+      def metadata
+        value_for(:metadata) || {}
+      end
+
+      def metadata_plan_key
+        metadata[:plan_key] || metadata["plan_key"] || value_for(:plan_key)
+      end
+
+      def price_id
+        price = value_for_object(item, :price)
+        value_for_object(price, :id) || (price if price.is_a?(String)) || id_for(value_for(:plan))
+      end
+
+      def item
+        items = value_for(:items)
+        if items.respond_to?(:data)
+          items.data.first
+        elsif items.respond_to?(:first)
+          items.first
+        end
+      end
+
+      def item_value(key)
+        value_for_object(item, key)
+      end
+
+      def time_for(value)
+        if value.present?
+          value.is_a?(Time) ? value : Time.zone.at(value)
+        end
+      end
+
+      def id_for(object)
+        if object.respond_to?(:id)
+          object.id
+        elsif object.respond_to?(:[]) && !object.is_a?(String)
+          object[:id] || object["id"]
+        else
+          object
+        end
+      end
+
+      def value_for(key)
+        value_for_object(@stripe_subscription, key)
+      end
+
+      def value_for_object(object, key)
+        if object.respond_to?(key) && !object.is_a?(String)
+          object.public_send(key)
+        elsif object.respond_to?(:[]) && !object.is_a?(String) && !object.is_a?(Array)
+          object[key] || object[key.to_s]
+        end
+      end
+  end
+end
