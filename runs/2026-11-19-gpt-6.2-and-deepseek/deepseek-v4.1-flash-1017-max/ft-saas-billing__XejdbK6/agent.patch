diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..3073469
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,132 @@
+class Account::Plan < String
+  FREE_KEY = "free"
+  UNLIMITED_KEY = "unlimited"
+  UNLIMITED_PLUS_KEY = "unlimited_plus"
+
+  FREE_CARD_LIMIT = 1_000
+  UNLIMITED_PRICE_CENTS = 2_000
+  UNLIMITED_PLUS_PRICE_CENTS = 2_500
+
+  attr_reader :key, :name, :price_cents, :card_limit, :storage_limit
+
+  def initialize(key:, name:, price_cents:, card_limit:, storage_limit:)
+    super(name)
+    @key = key
+    @name = name
+    @price_cents = price_cents
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+  end
+
+  def free?
+    key == FREE_KEY
+  end
+
+  def paid?
+    !free?
+  end
+
+  def price
+    "$#{price_cents / 100}/month"
+  end
+
+  def price_in_dollars
+    price_cents / 100
+  end
+  alias_method :monthly_price, :price_in_dollars
+
+  def stripe_price_id
+    stripe_price_ids.first
+  end
+
+  def stripe_price_ids
+    case key
+    when UNLIMITED_KEY
+      price_ids_from(ENV.values_at("STRIPE_UNLIMITED_PRICE_ID", "STRIPE_PRICE_UNLIMITED", "STRIPE_PRICE_ID_UNLIMITED", "STRIPE_UNLIMITED_MONTHLY_PRICE_ID", "STRIPE_PRICE_UNLIMITED_MONTHLY"), :unlimited_price_id)
+    when UNLIMITED_PLUS_KEY
+      price_ids_from(ENV.values_at("STRIPE_UNLIMITED_PLUS_PRICE_ID", "STRIPE_PRICE_UNLIMITED_PLUS", "STRIPE_PRICE_ID_UNLIMITED_PLUS", "STRIPE_UNLIMITED_PLUS_MONTHLY_PRICE_ID", "STRIPE_PRICE_UNLIMITED_PLUS_MONTHLY"), :unlimited_plus_price_id)
+    else
+      []
+    end
+  end
+
+  class << self
+    def free
+      FREE
+    end
+
+    def unlimited
+      UNLIMITED
+    end
+
+    def unlimited_plus
+      UNLIMITED_PLUS
+    end
+
+    def all
+      [ FREE, UNLIMITED, UNLIMITED_PLUS ]
+    end
+
+    def paid
+      [ UNLIMITED, UNLIMITED_PLUS ]
+    end
+
+    def [](key)
+      find(key)
+    end
+
+    def for(key)
+      find(key)
+    end
+
+    def find(key)
+      return key if key.is_a?(self)
+
+      case key.to_s.downcase.delete(" _-")
+      when "free", "freev1", "freeplan"
+        FREE
+      when "unlimited", "unlimitedv1", "unlimitedplan"
+        UNLIMITED
+      when "unlimited+", "unlimitedplus", "unlimitedplusv1", "unlimitedplusplan"
+        UNLIMITED_PLUS
+      end
+    end
+
+    def from_stripe_price(price_id)
+      return if price_id.blank?
+
+      price_id = price_id.id if price_id.respond_to?(:id)
+      all.find { |plan| plan.stripe_price_ids.include?(price_id.to_s) }
+    end
+  end
+
+  private
+    def price_ids_from(environment_values, credential_key)
+      credentials = Rails.application.credentials.dig(:stripe, credential_key) if Rails.application.respond_to?(:credentials)
+      (environment_values + [ credentials ]).compact_blank.map(&:to_s).uniq
+    end
+
+  FREE = new(
+    key: FREE_KEY,
+    name: "Free",
+    price_cents: 0,
+    card_limit: FREE_CARD_LIMIT,
+    storage_limit: 1.gigabyte
+  )
+
+  UNLIMITED = new(
+    key: UNLIMITED_KEY,
+    name: "Unlimited",
+    price_cents: UNLIMITED_PRICE_CENTS,
+    card_limit: nil,
+    storage_limit: 5.gigabytes
+  )
+
+  UNLIMITED_PLUS = new(
+    key: UNLIMITED_PLUS_KEY,
+    name: "Unlimited+",
+    price_cents: UNLIMITED_PLUS_PRICE_CENTS,
+    card_limit: nil,
+    storage_limit: 500.gigabytes
+  )
+end
