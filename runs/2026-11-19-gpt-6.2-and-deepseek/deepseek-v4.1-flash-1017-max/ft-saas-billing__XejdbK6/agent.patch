@@ -0,0 +1,52 @@
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_plan
+
+  def create
+    if @plan.paid?
+      session = Stripe::Checkout::Session.create(checkout_session_attributes)
+      redirect_to session.url, allow_other_host: true
+    else
+      redirect_to saas_billing_path, alert: "Choose a paid plan to continue."
+    end
+  end
+
+  private
+    def saas_billing_path
+      Fizzy::Saas::Engine.routes.url_helpers.billing_path(script_name: request.script_name)
+    end
+
+    def set_plan
+      @plan = Account::Plan.find(params[:plan].presence || params[:plan_key].presence || Account::Plan::UNLIMITED_KEY)
+      redirect_to saas_billing_path, alert: "That plan is not available." unless @plan
+    end
+
+    def checkout_session_attributes
+      {
+        mode: "subscription",
+        customer: stripe_customer_id,
+        line_items: [ { price: @plan.stripe_price_id, quantity: 1 } ],
+        success_url: main_app.account_settings_url(script_name: request.script_name),
+        cancel_url: Fizzy::Saas::Engine.routes.url_helpers.billing_url(host: request.base_url, script_name: request.script_name),
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id, plan_key: @plan.key },
+        subscription_data: { metadata: { account_id: Current.account.id, plan_key: @plan.key } }
+      }
+    end
+
+    def stripe_customer_id
+      Current.account.subscription&.stripe_customer_id.presence || create_stripe_customer
+    end
+
+    def create_stripe_customer
+      customer = Stripe::Customer.create(
+        email: Current.identity.email_address,
+        name: Current.account.name,
+        metadata: { account_id: Current.account.id }
+      )
+
+      subscription = Current.account.subscription || Current.account.build_subscription(plan_key: Account::Plan::FREE_KEY)
+      subscription.update!(stripe_customer_id: customer.id)
+      customer.id
+    end
+end
