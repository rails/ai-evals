diff --git a/saas/test/integration/billing_test.rb b/saas/test/integration/billing_test.rb
new file mode 100644
index 0000000..e58677c
--- /dev/null
+++ b/saas/test/integration/billing_test.rb
@@ -0,0 +1,243 @@
+require "test_helper"
+
+class HostedBillingIntegrationTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @account.subscription&.destroy!
+    @account.create_subscription!(plan_key: Account::Plan::FREE_KEY, stripe_customer_id: "cus_test", status: "active")
+  end
+
+  test "free plan has approved card and storage limits" do
+    assert_equal "Free", @account.plan.name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "paid plans bring their own storage allowance" do
+    @account.subscription.update!(plan_key: Account::Plan::UNLIMITED_KEY, status: "active")
+    assert_equal "Unlimited", @account.plan.name
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_nil @account.card_limit
+
+    @account.subscription.update!(plan_key: Account::Plan::UNLIMITED_PLUS_KEY, status: "active")
+    assert_equal "Unlimited+", @account.plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "free accounts nearing and at the card limit" do
+    @account.update_column(:cards_count, 950)
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+    assert_not @account.at_card_limit?
+
+    @account.update_column(:cards_count, 1_000)
+    assert @account.at_card_limit?
+    assert_equal 0, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "board shows a card count warning and an upgrade pitch at the limit" do
+    sign_in_as :mike
+    board = boards(:miltons_wish_list)
+    accounts(:initech).update_column(:cards_count, 950)
+
+    get board_path(board, script_name: accounts(:initech).slug)
+    assert_response :success
+    assert_includes response.body, "50 cards left"
+
+    accounts(:initech).update_column(:cards_count, 1_000)
+    get board_path(board, script_name: accounts(:initech).slug)
+    assert_response :success
+    assert_select "a[href=?]", "#{accounts(:initech).slug}/billing", text: "Upgrade"
+    assert_not_includes response.body, "Add a card"
+  end
+
+  test "API creation and publishing are refused at the card limit, but drafts are allowed" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    board = boards(:miltons_wish_list)
+    account.update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(board, script_name: accounts(:initech).slug), params: { card: { title: "Blocked" } }, as: :json
+    end
+    assert_response :forbidden
+
+    assert_no_changes -> { cards(:unfinished_thoughts).reload.status } do
+      post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+    end
+    assert_response :forbidden
+
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(board, script_name: accounts(:initech).slug)
+    end
+    assert_response :redirect
+    assert Card.order(:created_at).last.drafted?
+  end
+
+  test "admins see plan and upgrade in settings" do
+    sign_in_as :kevin
+    get account_settings_path
+
+    assert_response :success
+    assert_includes response.body, "Free"
+    assert_includes response.body, "Upgrade"
+    assert_select "a[href=?]", "#{accounts(:"37s").slug}/billing", text: "Upgrade"
+  end
+
+  test "admin can comp and uncomp an account" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_comp_path(account)
+    end
+    assert_redirected_to Fizzy::Saas::Engine.routes.url_helpers.admin_account_path(account)
+    assert account.reload.comped?
+
+    untenanted do
+      delete saas.admin_account_comp_path(account)
+    end
+    assert_not account.reload.comped?
+  end
+
+  test "admin can override card count and bytes used, then reset the override" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_override_path(account), params: {
+        account_overridden_limit: { card_count: 12, bytes_used: 34 }
+      }
+    end
+    assert_redirected_to Fizzy::Saas::Engine.routes.url_helpers.admin_account_path(account)
+    assert_equal 12, account.reload.cards_count
+    assert_equal 34, account.bytes_used
+
+    untenanted do
+      delete saas.admin_account_override_path(account)
+    end
+    assert_nil account.reload.overridden_limit
+  end
+
+test "billing page lists plans" do
+  sign_in_as :kevin
+  get saas.billing_path
+  assert_response :success
+  assert_includes response.body, "Unlimited"
+  assert_includes response.body, "Unlimited+"
+end
+
+test "admin accounts index and show render" do
+  sign_in_as :david
+  account = accounts(:initech)
+
+  untenanted do
+    get saas.admin_accounts_path
+  end
+  assert_response :success
+  assert_select "a[href=?]", saas.admin_account_path(account, script_name: nil), text: account.name
+
+  untenanted do
+    get "/admin/accounts/#{account.id}"
+  end
+  assert_response :success
+  assert_includes response.body, "Comp"
+  assert_includes response.body, "Card count"
+  assert_includes response.body, "Bytes used"
+  assert_includes response.body, "Override"
+end
+
+test "checkout redirects to Stripe" do
+    sign_in_as :kevin
+    session = stub(url: "https://checkout.stripe.com/test")
+    Stripe::Checkout::Session.expects(:create).once.returns(session)
+
+    post saas.billing_checkout_path(plan: Account::Plan::UNLIMITED_KEY)
+
+    assert_redirected_to "https://checkout.stripe.com/test"
+  end
+
+test "checkout creates a Stripe customer when needed" do
+  sign_in_as :kevin
+  @account.subscription.destroy!
+  customer = stub(id: "cus_new")
+  session = stub(url: "https://checkout.stripe.com/new")
+  Stripe::Customer.expects(:create).once.returns(customer)
+  Stripe::Checkout::Session.expects(:create).once.returns(session)
+
+  post saas.billing_checkout_path(plan: Account::Plan::UNLIMITED_KEY)
+
+  assert_redirected_to "https://checkout.stripe.com/new"
+  assert_equal "cus_new", @account.reload.subscription.stripe_customer_id
+end
+
+  test "customer portal redirects to Stripe" do
+    sign_in_as :kevin
+    session = stub(url: "https://billing.stripe.com/test")
+    Stripe::BillingPortal::Session.expects(:create).once.returns(session)
+
+    post saas.billing_portal_path
+
+    assert_redirected_to "https://billing.stripe.com/test"
+  end
+
+  test "stripe webhook updates the account subscription" do
+    payload = {
+      id: "evt_test",
+      object: "event",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_test",
+          object: "subscription",
+          customer: "cus_test",
+          status: "active",
+          current_period_end: 1.hour.from_now.to_i,
+          cancel_at: nil,
+          metadata: { account_id: @account.id, plan_key: Account::Plan::UNLIMITED_PLUS_KEY },
+          items: { object: "list", data: [] }
+        }
+      }
+    }
+
+    untenanted do
+      post Fizzy::Saas::Engine.routes.url_helpers.stripe_webhooks_path, params: payload.to_json, headers: { "Content-Type" => "application/json" }
+    end
+
+    assert_response :success
+    assert_equal Account::Plan::UNLIMITED_PLUS_KEY, @account.subscription.reload.plan_key
+    assert_equal "Unlimited+", @account.reload.plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+test "stripe webhook maps a configured price to its plan" do
+  previous_price_id = ENV["STRIPE_UNLIMITED_PRICE_ID"]
+  ENV["STRIPE_UNLIMITED_PRICE_ID"] = "price_unlimited_test"
+
+  payload = {
+    id: "evt_price_test",
+    object: "event",
+    type: "customer.subscription.updated",
+    data: {
+      object: {
+        id: "sub_price_test",
+        object: "subscription",
+        customer: "cus_test",
+        status: "active",
+        metadata: { account_id: @account.id },
+        items: { object: "list", data: [ { price: { id: "price_unlimited_test" } } ] }
+      }
+    }
+  }
+
+  untenanted do
+    post Fizzy::Saas::Engine.routes.url_helpers.stripe_webhooks_path, params: payload.to_json, headers: { "Content-Type" => "application/json" }
+  end
+
+  assert_response :success
+  assert_equal Account::Plan::UNLIMITED_KEY, @account.subscription.reload.plan_key
+ensure
+  ENV["STRIPE_UNLIMITED_PRICE_ID"] = previous_price_id
+end
+end
