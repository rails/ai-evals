--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,39 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  belongs_to :account, default: -> { user&.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true
+
+  def deliver(payload)
+    if vapid_configured?
+      WebPush.payload_send(
+        message: payload.is_a?(String) ? payload : payload.to_json,
+        endpoint: endpoint,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: vapid_options
+      )
+    else
+      Rails.logger.warn("Skipping push notification: VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY are not configured")
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    destroy
+  end
+
+  private
+    def vapid_configured?
+      ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+
+    def vapid_options
+      {
+        public_key: ENV["VAPID_PUBLIC_KEY"],
+        private_key: ENV["VAPID_PRIVATE_KEY"]
+      }.tap do |options|
+        options[:subject] = ENV["VAPID_SUBJECT"] if ENV["VAPID_SUBJECT"].present?
+      end
+    end
+end
