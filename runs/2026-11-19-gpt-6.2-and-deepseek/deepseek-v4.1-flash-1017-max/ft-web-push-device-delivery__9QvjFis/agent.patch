@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/123",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+
+test "is invalid without a user" do
+  assert_not Push::Subscription.new.valid?
+end
+
+  test "requires subscription keys and endpoint" do
+    subscription = Push::Subscription.new(user: @user, account: @user.account)
+
+    assert_not subscription.valid?
+    assert subscription.errors[:endpoint].any?
+    assert subscription.errors[:p256dh_key].any?
+    assert subscription.errors[:auth_key].any?
+  end
+
+  test "does not allow duplicate endpoints for a user" do
+    duplicate = @user.push_subscriptions.build(
+      endpoint: @subscription.endpoint,
+      p256dh_key: "other-key",
+      auth_key: "other-auth"
+    )
+
+    assert_not duplicate.valid?
+  end
+
+  test "delivers a web push message with the configured VAPID keys" do
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with(
+        message: { title: "Hello", body: "World" }.to_json,
+        endpoint: @subscription.endpoint,
+        p256dh: @subscription.p256dh_key,
+        auth: @subscription.auth_key,
+        vapid: {
+          public_key: "public-key",
+          private_key: "private-key"
+        }
+      )
+
+      @subscription.deliver(title: "Hello", body: "World")
+    end
+  end
+
+
+test "removes expired subscriptions" do
+  with_vapid_keys do
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(Struct.new(:body).new("gone"), "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver(title: "Hello")
+    end
+  end
+end
+
+test "skips delivery when VAPID keys are not configured" do
+  WebPush.expects(:payload_send).never
+
+  @subscription.deliver(title: "Hello")
+end
+
+  private
+    def with_vapid_keys
+      old_public_key, old_private_key = ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"] = "public-key"
+      ENV["VAPID_PRIVATE_KEY"] = "private-key"
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = old_public_key
+      ENV["VAPID_PRIVATE_KEY"] = old_private_key
+    end
+end
