@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    @subscription_params = {
+      push_subscription: {
+        endpoint: "https://push.example.com/subscriptions/123",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      }
+    }
+
+    sign_in_as @user
+  end
+
+  test "creates a push subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: @subscription_params, as: :json
+    end
+
+    assert_response :created
+    assert_equal @user.push_subscriptions.last.id, @response.parsed_body["id"]
+    assert_equal "https://push.example.com/subscriptions/123", @user.push_subscriptions.last.endpoint
+  end
+
+  test "updates an existing push subscription for the same endpoint" do
+    @user.push_subscriptions.create!(@subscription_params[:push_subscription])
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: @subscription_params[:push_subscription].merge(p256dh_key: "updated-key")
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "updated-key", @user.push_subscriptions.last.p256dh_key
+  end
+
+
+test "creates a push subscription from flat JSON params" do
+  assert_difference -> { @user.push_subscriptions.count }, 1 do
+    post user_push_subscriptions_path(@user), params: {
+      endpoint: "https://push.example.com/subscriptions/flat",
+      p256dh_key: "flat-p256dh-key",
+      auth_key: "flat-auth-key"
+    }, as: :json
+  end
+
+  assert_response :created
+end
+
+
+test "does not create an invalid push subscription" do
+  assert_no_difference -> { @user.push_subscriptions.count } do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: { endpoint: "", p256dh_key: "", auth_key: "" }
+    }, as: :json
+  end
+
+  assert_response :unprocessable_entity
+end
+
+  test "does not let a user create a subscription for another user" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:jz)), params: @subscription_params, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroys a push subscription for the current user" do
+    subscription = @user.push_subscriptions.create!(@subscription_params[:push_subscription])
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+end
