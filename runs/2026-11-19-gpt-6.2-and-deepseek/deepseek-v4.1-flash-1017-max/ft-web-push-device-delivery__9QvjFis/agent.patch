diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..cf5d0bd
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,187 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "details", "enableButton", "disableButton", "message" ]
+  static values = { vapidPublicKey: String, subscriptionUrl: String }
+
+  #subscriptionId = null
+
+  connect() {
+    this.#hideHelp()
+    this.#refresh()
+  }
+
+  async enable() {
+    if (!this.#supported) {
+      this.#setMessage("Push notifications are not supported by this browser.")
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+
+    if (permission !== "granted") {
+      this.#setOn(false)
+      this.#showHelp()
+      this.#setMessage("Notifications are blocked. Follow the instructions below to allow them for this site.")
+      return
+    }
+
+    try {
+      const registration = await this.#serviceWorkerRegistration()
+      const subscription = await registration.pushManager.getSubscription() ||
+        await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+
+      await this.#saveSubscription(subscription)
+      this.#setOn(true)
+      this.#hideHelp()
+    } catch (error) {
+      console.error("Could not enable push notifications", error)
+      this.#setOn(false)
+      this.#showHelp()
+      this.#setMessage("Could not turn on push notifications for this device.")
+    }
+  }
+
+  async disable() {
+    try {
+      const registration = await this.#serviceWorkerRegistration()
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        if (!this.#subscriptionId) await this.#saveSubscription(subscription)
+        await this.#deleteSubscription()
+        await subscription.unsubscribe()
+      }
+
+      this.#setOn(false)
+      this.#setMessage("Push notifications are off for this device.")
+    } catch (error) {
+      console.error("Could not disable push notifications", error)
+      this.#setMessage("Could not turn off push notifications for this device.")
+    }
+  }
+
+  #refresh() {
+    if (!this.#supported) {
+      this.enableButtonTarget.disabled = true
+      this.#setMessage("Push notifications are not supported by this browser.")
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#setOn(false)
+      this.#showHelp()
+      this.#setMessage("Notifications are blocked. Follow the instructions below to allow them for this site.")
+      return
+    }
+
+    if (Notification.permission === "granted") {
+      this.#syncExistingSubscription()
+    } else {
+      this.#setOn(false)
+    }
+  }
+
+  async #syncExistingSubscription() {
+    try {
+      const registration = await this.#serviceWorkerRegistration()
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        await this.#saveSubscription(subscription)
+        this.#setOn(true)
+        this.#hideHelp()
+      } else {
+        this.#setOn(false)
+      }
+    } catch (error) {
+      console.error("Could not load push subscription", error)
+      this.#setOn(false)
+    }
+  }
+
+  async #serviceWorkerRegistration() {
+    if ("serviceWorker" in navigator) {
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    }
+
+    return navigator.serviceWorker.ready
+  }
+
+  async #saveSubscription(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await fetch(this.subscriptionUrlValue, {
+      method: "POST",
+      headers: {
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+        "X-CSRF-Token": this.#csrfToken
+      },
+      body: JSON.stringify({
+        push_subscription: {
+          endpoint,
+          p256dh_key: keys.p256dh,
+          auth_key: keys.auth
+        }
+      })
+    })
+
+    if (!response.ok) throw new Error(`Push subscription request failed with ${response.status}`)
+
+    const data = await response.json()
+    this.#subscriptionId = data.id
+  }
+
+  async #deleteSubscription() {
+    if (!this.#subscriptionId) return
+
+    const response = await fetch(`${this.subscriptionUrlValue}/${this.#subscriptionId}`, {
+      method: "DELETE",
+      headers: {
+        "Accept": "application/json",
+        "X-CSRF-Token": this.#csrfToken
+      }
+    })
+
+    if (!response.ok) throw new Error(`Push subscription deletion failed with ${response.status}`)
+
+    this.#subscriptionId = null
+  }
+
+  #setOn(on) {
+    this.element.classList.toggle("notifications--on", on)
+    this.enableButtonTarget.hidden = on
+    this.disableButtonTarget.hidden = !on
+  }
+
+  #setMessage(message) {
+    this.messageTarget.textContent = message
+  }
+
+  #showHelp() {
+    this.detailsTargets.forEach(details => details.hidden = false)
+  }
+
+  #hideHelp() {
+    this.detailsTargets.forEach(details => details.hidden = true)
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window && this.vapidPublicKeyValue?.length > 0
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = atob(base64)
+
+    return Uint8Array.from(rawData, character => character.charCodeAt(0))
+  }
+
+  get #csrfToken() {
+    return document.querySelector('meta[name="csrf-token"]')?.content
+  }
+}
