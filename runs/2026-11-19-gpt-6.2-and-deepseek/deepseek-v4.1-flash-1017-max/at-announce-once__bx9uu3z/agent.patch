diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..5807034 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,26 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_save :remember_published_transition, if: :saved_change_to_published?
+    after_commit :announce_publication, on: %i[ create update ], if: :publication_announcement_pending?
+    after_rollback :forget_publication_announcement
   end
 
   private
+    def remember_published_transition
+      @publication_announcement_pending = saved_change_to_published?(from: false, to: true)
+    end
+
+    def publication_announcement_pending?
+      @publication_announcement_pending && persisted? && published?
+    end
+
     def announce_publication
+      forget_publication_announcement
       AnnouncePublicationJob.perform_later self
     end
+
+    def forget_publication_announcement
+      @publication_announcement_pending = false
+    end
 end
diff --git a/test/controllers/books/publications_controller_test.rb b/test/controllers/books/publications_controller_test.rb
index 8761ea8..0bf74d1 100644
--- a/test/controllers/books/publications_controller_test.rb
+++ b/test/controllers/books/publications_controller_test.rb
@@ -29,4 +29,52 @@ class Books::PublicationsTest < ActionDispatch::IntegrationTest
     assert_redirected_to book_slug_url(@book)
     assert_equal "new-slug", @book.slug
   end
+
+  test "publishing a book with another change in the same sitting announces exactly once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: {
+        book: { published: "1" },
+        added_pages: [ "A New Page" ]
+      }
+    end
+
+    assert @book.reload.published?
+    assert_equal "A New Page", @book.leaves.last.title
+  end
+
+  test "unpublishing a book does not announce" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "0" } }
+    end
+
+    assert_not @book.reload.published?
+    assert_empty @book.leaves
+  end
+
+  test "saving an already published book does not announce again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { slug: "changed-slug" } }
+    end
+
+    assert @book.reload.published?
+    assert_equal "changed-slug", @book.slug
+  end
+
+  test "a failed sitting leaves a draft and does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: {
+        book: { published: "1" },
+        added_pages: [ "Rolled Back Page" ],
+        trashed_page_ids: [ 0 ]
+      }
+    end
+
+    assert_response :not_found
+    assert_not @book.reload.published?
+    assert_empty @book.leaves
+  end
 end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..29f056e
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+  setup do
+    @book = books(:manual)
+  end
+
+  test "announces a book when it is published" do
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ] do
+      @book.update! published: true
+    end
+  end
+
+  test "announces once when a book is published and changed in the same transaction" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "A New Page"
+      end
+    end
+  end
+
+  test "does not announce when a published book is saved again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Renamed"
+    end
+  end
+
+  test "does not announce when a book is unpublished" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "does not announce when a transaction rolls back after publishing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+end
