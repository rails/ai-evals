diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..1060526 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,46 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  if (!event.data) return
+
+  let payload
+  try {
+    payload = event.data.json()
+  } catch {
+    payload = { title: "Fizzy", body: event.data.text() }
+  }
+
+  const url = payload.url || payload.card?.url
+  const options = {
+    body: payload.body,
+    data: { url },
+    icon: "/app-icon-192.png",
+    badge: "/app-icon-192.png"
+  }
+
+  event.waitUntil(self.registration.showNotification(payload.title || "Fizzy", options))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const url = event.notification.data?.url
+  if (!url) return
+
+  event.waitUntil((async () => {
+    const targetUrl = new URL(url, self.location.origin).href
+    const clients = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+    const client = clients.find((client) => client.url === targetUrl)
+
+    if (client) return client.focus()
+
+    if (clients.length > 0) {
+      await clients[0].focus()
+      return clients[0].navigate(targetUrl)
+    }
+
+    return self.clients.openWindow(targetUrl)
+  })())
+})
