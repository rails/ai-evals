+++ b/test/jobs/push/delivery_job_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class Push::DeliveryJobTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "perform delivers the notification to every subscription for the user" do
+    @user.push_subscriptions.create!(subscription_params("one"))
+    @user.push_subscriptions.create!(subscription_params("two"))
+
+    Push::Subscription.any_instance.expects(:deliver).with(@notification).twice
+
+    Push::DeliveryJob.perform_now(@notification)
+  end
+
+test "perform can deliver to a single provided subscription" do
+  subscription = @user.push_subscriptions.create!(subscription_params("single"))
+  subscription.expects(:deliver).with(@notification).once
+
+  Push::DeliveryJob.perform_now(@notification, subscription)
+end
+
+  private
+    def subscription_params(suffix)
+      {
+        endpoint: "https://push.example.test/#{suffix}",
+        p256dh_key: "p256dh-#{suffix}",
+        auth_key: "auth-#{suffix}"
+      }
+    end
+end
