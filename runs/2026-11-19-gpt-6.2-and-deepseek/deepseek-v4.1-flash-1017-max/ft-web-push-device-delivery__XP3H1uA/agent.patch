+    assert_match "clients.openWindow", response.body
+  end
+
   private
     def switch_env(key, value)
       old, ENV[key] = ENV[key], value
diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..ab75fd8
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    @user.push_subscriptions.destroy_all
+
+    sign_in_as @user
+  end
+
+  test "create stores the browser subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: { push_subscription: subscription_params },
+        headers: { "User-Agent" => "Test Browser" },
+        as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.reload.last
+    assert_equal "https://push.example.test/subscription", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal "Test Browser", subscription.user_agent
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create updates an existing subscription with the same endpoint" do
+    @user.push_subscriptions.create!(subscription_params.merge(user_agent: "Old Browser"))
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user),
+        params: { push_subscription: subscription_params.merge(p256dh_key: "new-p256dh-key") },
+        headers: { "User-Agent" => "New Browser" },
+        as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.reload.last
+    assert_equal "new-p256dh-key", subscription.p256dh_key
+    assert_equal "New Browser", subscription.user_agent
+  end
+
+  test "create returns unprocessable entity for an incomplete subscription" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user),
+        params: { push_subscription: subscription_params.except(:auth_key) },
+        as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create is forbidden for another user" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)),
+        params: { push_subscription: subscription_params },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+test "create returns created without an explicit format" do
+  assert_difference -> { @user.push_subscriptions.count }, 1 do
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }
+  end
+
+  assert_response :created
+end
+
+  private
+    def subscription_params
+      {
+        endpoint: "https://push.example.test/subscription",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      }
+    end
+end
diff --git a/test/jobs/push/delivery_job_test.rb b/test/jobs/push/delivery_job_test.rb
