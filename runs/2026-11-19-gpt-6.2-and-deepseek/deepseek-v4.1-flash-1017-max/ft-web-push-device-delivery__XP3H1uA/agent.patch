new file mode 100644
index 0000000..11a666e
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,28 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @subscription.assign_attributes(push_subscription_params.merge(user_agent: request.user_agent))
+
+    if @subscription.save
+      head :created
+    else
+      render json: { errors: @subscription.errors.full_messages }, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..ec1b0c7
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,94 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "blockedMessage", "details", "enableButton" ]
+  static values = { vapidPublicKey: String, subscriptionUrl: String }
+
+  connect() {
+    if (!this.#supported) {
+      this.#showHelp("Push notifications aren't supported in this browser.")
+    } else if (Notification.permission === "granted") {
+      this.#subscribe()
+    } else if (Notification.permission === "denied") {
+      this.#showHelp("Notifications are blocked for this site. Follow the instructions below to allow them.")
+    }
+  }
+
+  async enable() {
+    if (!this.#supported) {
+      this.#showHelp("Push notifications aren't supported in this browser.")
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+    if (permission === "granted") {
+      await this.#subscribe()
+    } else {
+      this.#showHelp("Notifications are blocked for this site. Follow the instructions below to allow them.")
+    }
+  }
+
+  async #subscribe() {
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription() || await this.#createSubscription(registration)
+
+      await this.#saveSubscription(subscription)
+
+      this.element.classList.add("notifications--on")
+      this.blockedMessageTarget.hidden = true
+      this.detailsTargets.forEach(details => details.hidden = true)
+    } catch (error) {
+      console.error("Failed to subscribe to push notifications", error)
+      this.#showHelp("Notifications couldn't be enabled for this device. Check your browser settings and try again.")
+    }
+  }
+
+  #createSubscription(registration) {
+    return registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+  }
+
+  async #saveSubscription(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+    const response = await post(this.subscriptionUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint,
+          p256dh_key: p256dh,
+          auth_key: auth
+        }
+      },
+      responseKind: "json"
+    })
+
+    if (!response.ok) {
+      throw new Error(`Push subscription request failed with ${response.statusCode}`)
+    }
+  }
+
+  #showHelp(message) {
+    this.blockedMessageTarget.textContent = message
+    this.blockedMessageTarget.hidden = false
+    this.detailsTargets.forEach(details => details.hidden = false)
+    this.enableButtonTarget.hidden = false
+  }
+
+  get #supported() {
+    return "Notification" in window &&
+      "serviceWorker" in navigator &&
+      "PushManager" in window &&
+      this.vapidPublicKeyValue.length > 0
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+
+    return Uint8Array.from([ ...rawData ], character => character.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/push/delivery_job.rb b/app/jobs/push/delivery_job.rb
new file mode 100644
index 0000000..2b5eff3
--- /dev/null
+++ b/app/jobs/push/delivery_job.rb
@@ -0,0 +1,17 @@
+class Push::DeliveryJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(notification, subscription = nil)
+    if subscription.is_a?(Push::Subscription)
+      subscription.deliver(notification)
+    elsif notification.is_a?(Push::Subscription)
+      notification.deliver(subscription)
+    else
+      notification.user.push_subscriptions.find_each do |push_subscription|
+        push_subscription.deliver(notification)
+      end
+    end
+  end
+end
