+          WHEN 'Account' THEN (
+            SELECT accounts.id FROM accounts WHERE accounts.id = storage_totals.owner_id
+          )
+          WHEN 'Board' THEN (
+            SELECT boards.account_id FROM boards WHERE boards.id = storage_totals.owner_id
+          )
+        END
+        WHERE account_id IS NULL
+      SQL
+
+      backfill "storage_entries", "boards", "storage_entries.board_id", "boards.id"
+      backfill "storage_entries", "users", "storage_entries.user_id", "users.id"
+      backfill "taggings", "cards", "taggings.card_id", "cards.id"
+      backfill "user_settings", "users", "user_settings.user_id", "users.id"
+      backfill "watches", "cards", "watches.card_id", "cards.id"
+      backfill "webhook_delinquency_trackers", "webhooks", "webhook_delinquency_trackers.webhook_id", "webhooks.id"
+      backfill "webhook_deliveries", "webhooks", "webhook_deliveries.webhook_id", "webhooks.id"
+      backfill "webhook_deliveries", "events", "webhook_deliveries.event_id", "events.id"
+
+      backfill_active_storage
+      backfill_search_records
+    end
+
+    def backfill(table, parent_table, child_key, parent_key, joins: nil, where: nil)
+      sql = <<~SQL.squish
+        UPDATE #{table}
+        SET account_id = (
+          SELECT #{parent_table}.account_id
+          FROM #{parent_table}
+          #{joins}
+          WHERE #{child_key} = #{parent_key}
+          LIMIT 1
+        )
+        WHERE account_id IS NULL
+      SQL
+      sql = "#{sql} AND (#{where})" if where
+      execute sql
+    end
+
+    def backfill_active_storage
+      {
+        "Card" => "cards",
+        "Comment" => "comments",
+        "Board" => "boards",
+        "User" => "users",
+        "Export" => "exports",
+        "Account::Import" => "account_imports",
+        "ActionText::RichText" => "action_text_rich_texts"
+      }.each do |record_type, table|
+        backfill "active_storage_attachments", table,
+          "active_storage_attachments.record_id", "#{table}.id",
+          where: "active_storage_attachments.record_type = #{connection.quote(record_type)}"
+      end
+
+      backfill "active_storage_attachments", "active_storage_blobs",
+        "active_storage_attachments.blob_id", "active_storage_blobs.id"
+
+      backfill "active_storage_blobs", "active_storage_attachments",
+        "active_storage_blobs.id", "active_storage_attachments.blob_id"
+
+      backfill "active_storage_variant_records", "active_storage_blobs",
+        "active_storage_variant_records.blob_id", "active_storage_blobs.id"
+    end
+
+    def backfill_search_records
+      search_record_tables.each do |table|
+        backfill table, "cards", "#{table}.card_id", "cards.id"
+        backfill table, "boards", "#{table}.board_id", "boards.id"
+      end
+    end
+
+    def delete_orphaned_rows
+      tenant_tables.each do |table|
+        execute <<~SQL
+          DELETE FROM #{table}
+          WHERE account_id IS NULL
+             OR account_id NOT IN (SELECT id FROM accounts)
+        SQL
+      end
+    end
+
+    def add_account_index(table)
+      account_index = connection.indexes(table).any? { |index| index.columns == [ "account_id" ] }
+      add_index table, :account_id unless account_index
+    end
+end
