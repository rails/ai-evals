diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..fd03189
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,73 @@
+# One-box Fizzy deployment.
+#
+# Replace the placeholders below before running `bin/kamal setup`:
+#   - image and registry username (where you can push a container image)
+#   - servers.web IP address or DNS name of the box
+#   - proxy.host and APP_HOST hostname (keep both values in sync)
+#   - SMTP_* settings and MAILER_FROM_ADDRESS
+#
+# Secrets are read from .kamal/secrets and are intentionally not stored here.
+service: fizzy
+
+# This image must be pushed to a registry the server can pull from.
+# The repository's publish-image workflow uses GHCR; update both this and the
+# registry username if you publish from a different GitHub account or registry.
+image: your-github-username/fizzy
+
+servers:
+  web:
+    - 192.0.2.1
+
+# Kamal's proxy obtains and terminates SSL certificates with Let's Encrypt.
+# Point DNS at the server and allow inbound ports 80 and 443 before setup.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  healthcheck:
+    path: /up
+
+registry:
+  server: ghcr.io
+  username: your-github-username
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+env:
+  clear:
+    # The public hostname used in emails and generated URLs.
+    APP_HOST: fizzy.example.com
+    APP_PROTOCOL: https
+
+    # Keep the whole application on the box. SQLite and Solid Queue are both
+    # stored under /rails/storage, which is mounted as a persistent volume.
+    DATABASE_ADAPTER: sqlite3
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Replace with the SMTP server details for your mail provider.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_USERNAME: fizzy@example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+  secret:
+    - SECRET_KEY_BASE
+    - RAILS_MASTER_KEY
+    - SMTP_PASSWORD
+
+# SQLite databases, the Solid Queue/Cache/Cable data, and Active Storage files
+# all live under /rails/storage. A named volume keeps them across deploys.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+builder:
+  arch: amd64
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "sh"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
