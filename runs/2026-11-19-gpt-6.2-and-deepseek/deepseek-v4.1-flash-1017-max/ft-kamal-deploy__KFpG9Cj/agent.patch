+++ b/.kamal/secrets
@@ -0,0 +1,19 @@
+# Secrets are read from your environment when you run a Kamal command.
+# This file is safe to commit because it contains no credential values.
+#
+# Set these variables in your shell (or source a private file) before running
+# `bin/kamal setup` / `bin/kamal deploy`:
+#
+#   export SECRET_KEY_BASE="$(bin/rails secret)"
+#   export KAMAL_REGISTRY_PASSWORD="<GitHub token with write:packages>"
+#   export SMTP_PASSWORD="<SMTP password>"
+#
+# RAILS_MASTER_KEY is optional and only needed if you use Rails encrypted
+# credentials:
+#   export RAILS_MASTER_KEY="$(cat config/master.key)"
+#
+# Do not paste raw secrets into this file.
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+RAILS_MASTER_KEY=$RAILS_MASTER_KEY
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+SMTP_PASSWORD=$SMTP_PASSWORD
