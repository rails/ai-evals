new file mode 100644
index 0000000..84c7d6e
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,42 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_COUNT = 3
+  BURST_COMMENTER_COUNT = 2
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { where.not(burst_at: nil).where(last_active_at: ..2.weeks.ago) }
+  end
+
+  alias_attribute :last_burst_at, :burst_at
+
+  def stalled?
+    stalled_at.present? && stalled_at <= Time.current
+  end
+
+  def stalled_at
+    last_active_at + STALLED_AFTER if burst?
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def detect_burst
+    if recent_comments_burst?
+      record_burst
+    end
+  end
+
+  def record_burst
+    update!(burst_at: Time.current, last_active_at: Time.current)
+  end
+
+  private
+    def recent_comments_burst?
+      creators = comments.by_user.where(created_at: (auto_postpone_period / 3).seconds.ago..).pluck(:creator_id)
+
+      creators.size >= BURST_COMMENT_COUNT && creators.uniq.size >= BURST_COMMENTER_COUNT
+    end
+end
