+++ b/test/controllers/cards_stalled_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class CardsStalledTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "shows stalled status on card and in JSON" do
+    card = cards(:logo)
+    card.update!(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    get card_path(card)
+    assert_response :success
+    assert_select ".card--stalled"
+    assert_match "Stalled", response.body
+
+    get card_path(card), as: :json
+    assert_response :success
+    assert_equal true, @response.parsed_body["stalled"]
+  end
+
+  test "index can list stalled cards" do
+    card = cards(:logo)
+    card.update!(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_equal [ card.number ], @response.parsed_body.pluck("number")
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..5b95742
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three user comments from two people within a third of the auto-close period create a burst" do
+    card = cards(:logo)
+
+    assert_not card.burst?
+    card.comments.create!(creator: users(:david), body: "A third voice")
+    assert card.reload.burst?
+  end
+
+test "three comments from one person do not create a burst" do
+  card = cards(:layout)
+  card.comments.delete_all
+
+  3.times do |index|
+    card.comments.create!(creator: users(:david), body: "Comment %d" % index)
+  end
+
+  assert_not card.reload.burst?
+end
+
+test "comments outside a third of the auto-close period do not create a burst" do
+    card = cards(:layout)
+    card.comments.delete_all
+
+    travel_to 31.days.ago do
+      card.comments.create!(creator: users(:david), body: "Old comment")
+      card.comments.create!(creator: users(:jz), body: "Old comment")
+    end
+    card.comments.create!(creator: users(:kevin), body: "Recent comment")
+
+    assert_not card.reload.burst?
+  end
+
+  test "assignment creates a burst" do
+    card = cards(:layout)
+
+    with_current_user(:david) do
+      card.toggle_assignment(users(:kevin))
+    end
+
+    assert card.reload.burst?
+  end
+
+  test "reopening creates a burst" do
+    card = cards(:shipping)
+
+    card.reopen
+
+    assert card.reload.burst?
+  end
+
+  test "a burst goes stalled after two weeks without activity" do
+    card = cards(:logo)
+    card.update!(burst_at: 2.weeks.ago, last_active_at: 2.weeks.ago)
+
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "activity resets stalled status" do
+    card = cards(:logo)
+    card.update!(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    assert card.stalled?
+
+    card.touch_last_active_at
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "stalled filter returns stalled cards" do
+    card = cards(:logo)
+    card.update!(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    filter = users(:david).filters.new(indexed_by: "stalled")
+
+    assert_includes filter.cards, card
+  end
+end
