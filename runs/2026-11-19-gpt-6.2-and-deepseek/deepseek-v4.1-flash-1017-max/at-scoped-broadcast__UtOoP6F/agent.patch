diff --git a/test/controllers/presence_broadcast_test.rb b/test/controllers/presence_broadcast_test.rb
new file mode 100644
index 0000000..a2f630f
--- /dev/null
+++ b/test/controllers/presence_broadcast_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class PresenceBroadcastTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "editor page subscribes to the current user's being edited stream" do
+    leaf = leaves(:welcome_page)
+
+    get edit_leafable_path(leaf)
+
+    assert_response :success
+    assert_in_body Turbo::StreamsChannel.signed_stream_name([ leaf, users(:kevin), :being_edited ])
+    assert_not_in_body Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited ])
+  end
+
+  test "being edited broadcasts only go to users who can currently edit the book" do
+    leaf = leaves(:welcome_page)
+    book = leaf.book
+    removed_user = users(:jz)
+
+    book.access_for(user: removed_user).update!(level: :editor)
+    removed_stream = stream_name_for(leaf, removed_user)
+    book.access_for(user: removed_user).destroy!
+
+    patch book_page_path(book, leaf, format: :turbo_stream), params: { page: { body: "Updated body" } }
+
+    streams = enqueued_broadcast_streams
+
+    assert_includes streams, stream_name_for(leaf, users(:kevin)),
+      "expected the current editor to receive the being edited indicator"
+    assert_includes streams, stream_name_for(leaf, users(:jason)),
+      "expected other editors to receive the being edited indicator"
+    assert_not_includes streams, removed_stream,
+      "removed collaborator must not receive being edited payloads on their old stream"
+    assert_not_includes streams, stream_name_for(leaf),
+      "being edited payload must not use the shared leaf stream"
+  end
+
+  private
+    def enqueued_broadcast_streams
+      enqueued_jobs.filter_map do |job|
+        job["arguments"].first if job["job_class"] == "Turbo::Streams::BroadcastJob"
+      end
+    end
+
+    def stream_name_for(leaf, user = nil)
+      Turbo::StreamsChannel.send(:stream_name_from, [ leaf, user, :being_edited ].compact)
+    end
+end
