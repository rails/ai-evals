+module Webhook::Triggerable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :triggered_by, ->(event) do
+      active.where(account_id: event.account_id, board_id: event.board_id).subscribed_to(event.action)
+    end
+
+    scope :subscribed_to, ->(action) do
+      where("subscribed_actions LIKE ?", "%\"#{action}\"%")
+    end
+  end
+end
