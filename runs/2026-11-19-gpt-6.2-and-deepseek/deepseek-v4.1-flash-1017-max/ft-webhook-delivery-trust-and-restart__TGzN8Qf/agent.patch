+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    Webhook.triggered_by(self).find_each do |webhook|
+      webhook.deliver(self)
+    end
+  end
+end
