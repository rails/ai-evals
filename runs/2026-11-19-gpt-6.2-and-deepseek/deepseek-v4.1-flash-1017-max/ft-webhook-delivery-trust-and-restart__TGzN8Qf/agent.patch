diff --git a/test/models/webhook/delivery_flow_test.rb b/test/models/webhook/delivery_flow_test.rb
new file mode 100644
index 0000000..1dab7ef
--- /dev/null
+++ b/test/models/webhook/delivery_flow_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Webhook::DeliveryFlowTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @event = Event.create!(
+      board: @webhook.board,
+      creator: users(:david),
+      eventable: cards(:logo),
+      action: "card_published"
+    )
+  end
+
+  test "relays an event once and records the delivery" do
+    stub = stub_request(:post, @webhook.url)
+      .with(headers: {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => @event.created_at.utc.iso8601
+      })
+      .to_return(status: 200, body: "ok")
+
+    assert_difference -> { Webhook::Delivery.count }, 1 do
+      perform_enqueued_jobs only: Event::RelayJob
+    end
+
+    delivery = Webhook::Delivery.where(event: @event).sole
+    assert delivery.pending?
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+    delivery.reload
+
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_equal "application/json", delivery.request[:headers]["Content-Type"]
+    assert_not delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+    assert_requested stub, times: 1
+
+    signature = OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, delivery_body(delivery))
+    assert_equal signature, delivery.request[:headers]["X-Webhook-Signature"]
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      @event.relay_now
+      perform_enqueued_jobs only: Webhook::DeliveryJob
+    end
+    assert_requested stub, times: 1
+  end
+
+  test "deactivates after ten consecutive failures within an hour" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    10.times do
+      Event.create!(
+        board: @webhook.board,
+        creator: users(:david),
+        eventable: cards(:logo),
+        action: "card_published"
+      )
+
+      perform_enqueued_jobs only: Event::RelayJob
+      perform_enqueued_jobs only: Webhook::DeliveryJob
+    end
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "cleanup removes deliveries older than a week" do
+    old = webhook_deliveries(:successfully_completed)
+    recent = webhook_deliveries(:pending)
+    old.update_columns(created_at: 8.days.ago)
+    recent.update_columns(created_at: 1.day.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old.id)
+    assert Webhook::Delivery.exists?(recent.id)
+  end
+
+  private
+    def delivery_body(delivery)
+      ApplicationController.renderer.render(template: "webhooks/event", formats: :json, assigns: { event: delivery.event })
+    end
+end
