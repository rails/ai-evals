diff --git a/app/controllers/cards/columns_controller.rb b/app/controllers/cards/columns_controller.rb
index 54a69f0..bde959c 100644
--- a/app/controllers/cards/columns_controller.rb
+++ b/app/controllers/cards/columns_controller.rb
@@ -1,8 +1,55 @@
 class Cards::ColumnsController < ApplicationController
+  include CardScoped
+
   def edit
-    @card = Current.user.accessible_cards.find_by!(number: params[:card_id])
     @columns = @card.board.columns.sorted
 
     fresh_when etag: [ @card, @columns ]
   end
+
+  def update
+    if destination.present?
+      move_card_to_destination
+
+      respond_to do |format|
+        format.html { redirect_to @card.board }
+        format.turbo_stream { head :no_content }
+        format.json { head :no_content }
+      end
+    else
+      head :bad_request
+    end
+  end
+
+  private
+    def move_card_to_destination
+      case destination
+      when "maybe"
+        @card.send_back_to_triage unless @card.awaiting_triage?
+      when "not_now"
+        @card.postpone unless @card.postponed?
+      when "closed"
+        @card.close unless @card.closed?
+      else
+        column = @card.board.columns.find(destination)
+        @card.triage_into(column) unless @card.column == column && @card.open? && !@card.postponed?
+      end
+    end
+
+    def destination
+      value = params[:column_id].presence ||
+        params[:target_column_id].presence ||
+        params.dig(:card, :column_id).presence ||
+        params[:destination].presence ||
+        params.dig(:card, :destination).presence ||
+        params[:target].presence ||
+        params[:status].presence ||
+        params.dig(:card, :status).presence
+
+      case value
+      when "not-now" then "not_now"
+      when "closed-cards", "done" then "closed"
+      else value&.delete_prefix("column_")
+      end
+    end
 end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..e4387c6
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,205 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+const CARD_TARGET = '[data-drag-and-drop-target~="card"]'
+const COLUMN_TARGET = '[data-drag-and-drop-target~="column"]'
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "card", "column" ]
+
+  cardTargetConnected(card) {
+    card.draggable = true
+  }
+
+  dragStart(event) {
+    const target = event.target instanceof Element ? event.target : event.target?.parentElement
+    const card = target?.closest(CARD_TARGET)
+    const column = card?.closest(COLUMN_TARGET)
+
+    if (!card || !column || !this.cardTargets.includes(card) || !this.columnTargets.includes(column)) return
+
+    this.draggedCard = card
+    this.sourceColumn = column
+
+    card.classList.add(DRAGGED_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragOver(event) {
+    const column = this.#columnFor(event.target)
+    if (!this.draggedCard || !column) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    this.#highlight(column)
+  }
+
+  dragLeave(event) {
+    const column = this.#columnFor(event.target)
+    if (column && !column.contains(event.relatedTarget)) {
+      column.classList.remove(HOVER_CLASS)
+    }
+  }
+
+  drop(event) {
+    const card = this.draggedCard
+    const targetColumn = this.#columnFor(event.target)
+    if (!card || !targetColumn) return
+
+    event.preventDefault()
+    this.#clearHighlight()
+
+    if (targetColumn !== this.sourceColumn) {
+      this.#moveCard(card, targetColumn)
+    }
+
+    card.classList.remove(DRAGGED_CLASS)
+  }
+
+  dragEnd() {
+    this.#clearDragState()
+  }
+
+  #columnFor(element) {
+    const target = element instanceof Element ? element : element?.parentElement
+    const column = target?.closest(COLUMN_TARGET)
+    return this.columnTargets.includes(column) ? column : null
+  }
+
+  #highlight(column) {
+    this.columnTargets.forEach(target => target.classList.toggle(HOVER_CLASS, target === column))
+  }
+
+  #clearHighlight() {
+    this.columnTargets.forEach(target => target.classList.remove(HOVER_CLASS))
+  }
+
+  #clearDragState() {
+    this.draggedCard?.classList.remove(DRAGGED_CLASS)
+    this.#clearHighlight()
+    this.draggedCard = null
+    this.sourceColumn = null
+  }
+
+  #moveCard(card, targetColumn) {
+    const targetList = targetColumn.querySelector(".cards__list")
+    const sourceColumn = this.sourceColumn
+
+    if (!targetList || !sourceColumn || !card.isConnected) return
+
+    const originalParent = card.parentElement
+    const originalNextSibling = card.nextSibling
+
+    this.#insertCard(card, targetColumn, targetList)
+    this.#updateCount(sourceColumn, -1)
+    this.#updateCount(targetColumn, 1)
+    this.#updateCurrentColumn(card, targetColumn)
+
+    this.#save(card, targetColumn).catch(() => {
+      this.#revert(card, originalParent, originalNextSibling, sourceColumn, targetColumn)
+    })
+  }
+
+  #insertCard(card, targetColumn, targetList) {
+    if (card.classList.contains("golden-effect")) {
+      targetList.prepend(card)
+    } else {
+      const existingCards = Array.from(targetColumn.querySelectorAll(CARD_TARGET))
+      const firstNonGoldenCard = existingCards.find(existingCard => !existingCard.classList.contains("golden-effect"))
+
+      if (firstNonGoldenCard) {
+        firstNonGoldenCard.before(card)
+      } else if (existingCards.length > 0) {
+        existingCards.at(-1).after(card)
+      } else {
+        targetList.prepend(card)
+      }
+    }
+  }
+
+  async #save(card, targetColumn) {
+    const url = card.dataset.dragAndDropUrl
+    if (!url) throw new Error("Missing drag-and-drop URL")
+
+    const request = new FetchRequest("PATCH", url, {
+      body: JSON.stringify({ column_id: this.#destinationFor(targetColumn) }),
+      responseKind: "json"
+    })
+
+    const response = await request.perform()
+    if (!response.ok) throw new Error(`Failed to move card (${response.statusCode})`)
+  }
+
+  #revert(card, originalParent, originalNextSibling, sourceColumn, targetColumn) {
+    if (!card.isConnected) return
+
+    card.remove()
+    this.#updateCount(sourceColumn, 1)
+    this.#updateCount(targetColumn, -1)
+    this.#updateCurrentColumn(card, sourceColumn)
+
+    if (originalParent?.isConnected) {
+      const nextSibling = originalNextSibling?.parentElement === originalParent ? originalNextSibling : null
+      originalParent.insertBefore(card, nextSibling)
+    } else {
+      sourceColumn.querySelector(".cards__list")?.append(card)
+    }
+  }
+
+  #destinationFor(column) {
+    if (column.dataset.dragAndDropDestination === "column") {
+      return column.dataset.dragAndDropColumnId
+    } else {
+      return column.dataset.dragAndDropDestination
+    }
+  }
+
+  #updateCount(column, delta) {
+    const counter = column.querySelector(".cards__expander-count")
+    if (!counter) return
+
+    const count = Math.max(0, parseInt(counter.textContent, 10) + delta)
+    counter.textContent = count > 99 ? "99+" : count
+  }
+
+  #updateCurrentColumn(card, column) {
+    const targetId = column.dataset.dragAndDropDestination === "column" ? column.dataset.dragAndDropColumnId : null
+    const targetStage = targetId ? card.querySelector(`[data-drag-and-drop-column-id="${CSS.escape(targetId)}"]`) : null
+
+    card.querySelectorAll("[data-drag-and-drop-column-id]").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", stage === targetStage)
+    })
+
+    this.#updateHeaderCurrentColumn(card, targetStage)
+  }
+
+  #updateHeaderCurrentColumn(card, targetStage) {
+    const header = card.querySelector(".card__header")
+    if (!header) return
+
+    let currentColumn = header.querySelector(".card__column-name--current")
+
+    if (targetStage) {
+      if (!currentColumn) {
+        currentColumn = document.createElement("span")
+        currentColumn.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+
+        const label = document.createElement("span")
+        label.className = "overflow-ellipsis"
+        currentColumn.append(label)
+        header.append(currentColumn)
+      }
+
+      const label = currentColumn.querySelector(".overflow-ellipsis")
+      if (label) label.textContent = targetStage.textContent.trim()
+    } else {
+      currentColumn?.remove()
+    }
+  }
+}
