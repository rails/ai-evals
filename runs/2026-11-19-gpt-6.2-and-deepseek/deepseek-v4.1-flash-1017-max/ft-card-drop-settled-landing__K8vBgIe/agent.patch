diff --git a/test/controllers/cards/columns_controller_test.rb b/test/controllers/cards/columns_controller_test.rb
new file mode 100644
index 0000000..c879187
--- /dev/null
+++ b/test/controllers/cards/columns_controller_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Cards::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "update moves a card to another column" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    patch card_column_path(card), params: { column_id: column.id }, as: :json
+
+    assert_response :no_content
+    assert_equal column, card.reload.column
+  end
+
+  test "update moves a card to maybe" do
+    card = cards(:text)
+
+    patch card_column_path(card), params: { column_id: "maybe" }, as: :json
+
+    assert_response :no_content
+    assert_nil card.reload.column
+  end
+
+  test "update moves a card to not now" do
+    card = cards(:logo)
+
+    patch card_column_path(card), params: { column_id: "not_now" }, as: :json
+
+    assert_response :no_content
+    assert card.reload.postponed?
+  end
+
+  test "update moves a card to done" do
+    card = cards(:logo)
+
+    patch card_column_path(card), params: { column_id: "closed" }, as: :json
+
+    assert_response :no_content
+    assert card.reload.closed?
+  end
+
+  test "update reopens a done card in a column" do
+    card = cards(:shipping)
+    column = columns(:writebook_review)
+
+    patch card_column_path(card), params: { column_id: column.id }, as: :json
+
+    assert_response :no_content
+    assert_not card.reload.closed?
+    assert_equal column, card.column
+  end
+
+  test "update does not reorder a card within its current column" do
+    card = cards(:logo)
+    column = card.column
+
+    assert_no_difference -> { Event.count } do
+      patch card_column_path(card), params: { column_id: column.id }, as: :json
+    end
+
+    assert_response :no_content
+    assert_equal column, card.reload.column
+  end
+
+  test "update accepts status aliases" do
+    card = cards(:logo)
+
+    patch card_column_path(card), params: { column_id: "not-now" }, as: :json
+
+    assert_response :no_content
+    assert card.reload.postponed?
+  end
+end
diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..16c4551
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,74 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  test "dragging a card to another column moves it there" do
+    sign_in_as users(:david)
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    visit board_path(boards(:writebook))
+
+    source = find(".card", text: card.title)
+    target = find("section[data-drag-and-drop-column-id='#{column.id}']")
+
+    source.drag_to(target)
+
+    within target do
+      assert_selector ".card", text: card.title, visible: :all
+    end
+    assert_equal column, card.reload.column
+  end
+
+  test "dragging a card to maybe sends it back to triage" do
+    sign_in_as users(:david)
+    card = cards(:logo)
+    column = columns(:writebook_triage)
+
+    visit board_path(boards(:writebook))
+
+    find("section[data-drag-and-drop-column-id='#{column.id}'] .cards__expander").click
+    source = find(".card", text: card.title)
+    target = find("section#maybe")
+
+    source.drag_to(target)
+
+    within target do
+      assert_selector ".card", text: card.title
+    end
+    assert_nil card.reload.column
+  end
+
+  test "dragging a card to not now postpones it" do
+    sign_in_as users(:david)
+    card = cards(:buy_domain)
+
+    visit board_path(boards(:writebook))
+
+    source = find(".card", text: card.title)
+    target = find("section#not-now")
+
+    source.drag_to(target)
+
+    within target do
+      assert_selector ".card", text: card.title, visible: :all
+    end
+    assert card.reload.postponed?
+  end
+
+  test "dragging a card to done closes it" do
+    sign_in_as users(:david)
+    card = cards(:buy_domain)
+
+    visit board_path(boards(:writebook))
+
+    source = find(".card", text: card.title)
+    target = find("section#closed-cards")
+
+    source.drag_to(target)
+
+    within target do
+      assert_selector ".card", text: card.title, visible: :all
+    end
+    assert card.reload.closed?
+  end
+end
