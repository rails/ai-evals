@@ -0,0 +1,18 @@
+class SearchRateLimiter
+  LIMIT = 30
+  WINDOW = 1.minute
+
+  class << self
+    def store
+      @store ||= if Rails.cache.is_a?(ActiveSupport::Cache::NullStore)
+        ActiveSupport::Cache::MemoryStore.new
+      else
+        Rails.cache
+      end
+    end
+
+    def reset!
+      store.clear
+    end
+  end
+end
