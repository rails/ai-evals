diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..a79bb9b
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,60 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <div class="flex flex-column gap margin-block-half">
+      <div class="flex align-center gap">
+        <div class="flex-item-grow">
+          <div class="txt-x-small txt-ink-medium">Plan</div>
+          <strong><%= @account.plan.name %></strong>
+          <% if @account.comped? %>
+            <span class="txt-x-small">(comped)</span>
+          <% end %>
+        </div>
+
+        <% if @account.comped? %>
+          <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+        <% else %>
+          <%= button_to "Comp", saas.admin_account_comp_path(@account), method: :post, class: "btn" %>
+        <% end %>
+      </div>
+
+      <div class="flex gap">
+        <div class="flex-item-grow">
+          <div class="txt-x-small txt-ink-medium">Card count</div>
+          <strong><%= number_with_delimiter(@account.cards_count) %></strong>
+        </div>
+        <div class="flex-item-grow">
+          <div class="txt-x-small txt-ink-medium">Bytes used</div>
+          <strong><%= number_to_human_size(@account.bytes_used) %></strong>
+        </div>
+      </div>
+
+      <div class="divider"></div>
+
+      <h2 class="txt-medium margin-block-none">Override limits</h2>
+
+      <%= form_with url: saas.admin_account_override_path(@account), scope: :override, method: :post, class: "flex flex-column gap-half" do |form| %>
+        <label class="flex flex-column gap-quarter">
+          <span class="txt-small">Card count</span>
+          <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, min: 0, class: "input" %>
+        </label>
+
+        <label class="flex flex-column gap-quarter">
+          <span class="txt-small">Bytes used</span>
+          <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0, class: "input" %>
+        </label>
+
+        <div class="flex gap-half">
+          <%= form.submit "Override", class: "btn" %>
+        </div>
+      <% end %>
+
+      <%= button_to "Reset", saas.admin_account_override_path(@account), method: :delete, class: "btn btn--reversed", disabled: @account.overridden_limit.nil? %>
+    </div>
+  </div>
+</section>
