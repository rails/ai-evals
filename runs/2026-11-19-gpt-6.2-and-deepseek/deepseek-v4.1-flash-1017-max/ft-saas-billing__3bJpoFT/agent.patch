+class Account::BillingPortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    if Current.account.stripe_customer_id.present?
+      portal_session = Stripe::BillingPortal::Session.create(
+        customer: Current.account.stripe_customer_id,
+        return_url: account_settings_url
+      )
+      redirect_to portal_session.url, allow_other_host: true
+    else
+      redirect_to account_settings_path, alert: "There isn't a Stripe customer for this account yet."
+    end
+  rescue Stripe::StripeError => error
+    redirect_to account_settings_path, alert: error.message
+  end
+end
diff --git a/saas/app/controllers/account/subscriptions_controller.rb b/saas/app/controllers/account/subscriptions_controller.rb
new file mode 100644
index 0000000..7476cf8
