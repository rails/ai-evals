diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..962cbe6
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,156 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = parse_event
+    process_event(event)
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError
+    head :bad_request
+  end
+
+  private
+    def parse_event
+      payload = request.body.read
+      secret = ENV["STRIPE_WEBHOOK_SECRET"]
+
+      if secret.present?
+        Stripe::Webhook.construct_event(payload, request.headers["Stripe-Signature"], secret)
+      elsif Rails.env.test?
+        JSON.parse(payload)
+      else
+        raise Stripe::SignatureVerificationError.new("Missing webhook secret", request.headers["Stripe-Signature"])
+      end
+    end
+
+    def process_event(event)
+      type = event_value(event, :type)
+      object = event_value(event_value(event, :data), :object)
+
+      case type
+      when "checkout.session.completed"
+        process_checkout_session(object)
+      when "customer.subscription.created", "customer.subscription.updated"
+        process_subscription(object)
+      when "customer.subscription.deleted"
+        process_subscription_deleted(object)
+      when "invoice.payment_failed"
+        process_failed_payment(object)
+      end
+    end
+
+    def process_checkout_session(session)
+      account = account_from(session)
+      return unless account
+
+      subscription = AccountSubscription.find_or_initialize_by(account: account)
+      subscription.stripe_customer_id = event_value(session, :customer)
+      subscription.stripe_subscription_id = event_value(session, :subscription)
+      subscription.plan_key = plan_from_metadata(session).key
+      subscription.status = "active"
+      subscription.save!
+    end
+
+    def process_subscription(stripe_subscription)
+      account = account_from(stripe_subscription)
+      return unless account
+
+      subscription = find_subscription(stripe_subscription, account)
+      subscription.account = account
+      subscription.stripe_customer_id = event_value(stripe_subscription, :customer)
+      subscription.stripe_subscription_id = event_value(stripe_subscription, :id)
+      subscription.status = event_value(stripe_subscription, :status)
+      subscription.plan_key = subscription.status == "canceled" ? "free" : plan_for(stripe_subscription).key
+      subscription.current_period_end = timestamp(event_value(stripe_subscription, :current_period_end))
+      subscription.cancel_at = timestamp(event_value(stripe_subscription, :cancel_at))
+      subscription.next_amount_due_in_cents = amount_due(stripe_subscription)
+      subscription.save!
+    end
+
+    def process_subscription_deleted(stripe_subscription)
+      subscription = find_subscription_by_reference(stripe_subscription)
+      subscription ||= AccountSubscription.new(account: account_from(stripe_subscription))
+      return unless subscription.account
+
+      subscription.update!(status: "canceled", plan_key: "free", cancel_at: Time.current)
+    end
+
+    def process_failed_payment(invoice)
+      subscription = find_subscription_by_reference(invoice)
+      subscription&.update!(status: "past_due")
+    end
+
+    def account_from(object)
+      account_id = metadata_value(object, "account_id") || event_value(object, :client_reference_id)
+
+      if account_id.present?
+        Account.find_by(id: account_id)
+      else
+        subscription = find_subscription_by_reference(object)
+        subscription&.account
+      end
+    end
+
+    def find_subscription(object, account)
+      find_subscription_by_reference(object) || AccountSubscription.new(account: account)
+    end
+
+    def find_subscription_by_reference(object)
+      subscription_id = event_value(object, :subscription) || event_value(object, :id)
+      customer_id = event_value(object, :customer)
+
+      if subscription_id.present? && (subscription = AccountSubscription.find_by(stripe_subscription_id: subscription_id))
+        subscription
+      elsif customer_id.present?
+        AccountSubscription.find_by(stripe_customer_id: customer_id)
+      end
+    end
+
+    def plan_for(stripe_subscription)
+      metadata_plan = plan_from_metadata(stripe_subscription)
+
+      if metadata_plan.present? && !metadata_plan.free?
+        metadata_plan
+      else
+        Billing::Plan.from_stripe_price_ids(price_ids(stripe_subscription))
+      end
+    end
+
+    def plan_from_metadata(object)
+      Billing::Plan.fetch(metadata_value(object, "plan_key"))
+    end
+
+    def price_ids(stripe_subscription)
+      items = event_value(stripe_subscription, :items)
+      data = event_value(items, :data)
+
+      Array(data).map do |item|
+        event_value(event_value(item, :price), :id)
+      end
+    end
+
+    def amount_due(stripe_subscription)
+      invoice = event_value(stripe_subscription, :latest_invoice)
+      event_value(invoice, :amount_due)
+    end
+
+    def timestamp(value)
+      Time.zone.at(value) if value.present?
+    end
+
+    def metadata_value(object, key)
+      metadata = event_value(object, :metadata)
+      event_value(metadata, key)
+    end
+
+    def event_value(object, key)
+      if object.respond_to?(:key?)
+        candidate = [ key, key.to_s, key.to_sym ].uniq.find { |candidate_key| object.key?(candidate_key) }
+        object[candidate] unless candidate.nil?
+      elsif object.respond_to?(key)
+        object.public_send(key)
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
