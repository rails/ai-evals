+++ b/saas/app/controllers/account/subscriptions_controller.rb
@@ -0,0 +1,50 @@
+class Account::SubscriptionsController < ApplicationController
+  before_action :ensure_admin
+
+  def new
+    @plans = Billing::Plan.paid
+  end
+
+  def create
+    plan = Billing::Plan.fetch(params[:plan])
+
+    if plan.paid?
+      checkout_session = Stripe::Checkout::Session.create(checkout_session_params(plan))
+      redirect_to checkout_session.url, allow_other_host: true
+    else
+      redirect_to account_settings_path, alert: "Choose a paid plan to continue."
+    end
+  rescue Stripe::StripeError => error
+    redirect_to account_settings_path, alert: error.message
+  end
+
+  private
+    def checkout_session_params(plan)
+      {
+        mode: "subscription",
+        line_items: checkout_line_items(plan),
+        success_url: account_settings_url,
+        cancel_url: saas.new_account_subscription_url,
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id, plan_key: plan.key },
+        subscription_data: { metadata: { account_id: Current.account.id, plan_key: plan.key } }
+      }.tap do |params|
+        if Current.account.stripe_customer_id.present?
+          params[:customer] = Current.account.stripe_customer_id
+        else
+          params[:customer_email] = Current.identity.email_address
+        end
+      end
+    end
+
+    def checkout_line_items(plan)
+      price_ids = case plan.key
+      when "unlimited_plus"
+        [ ENV["STRIPE_MONTHLY_V1_PRICE_ID"], ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] ]
+      else
+        [ ENV["STRIPE_MONTHLY_V1_PRICE_ID"] ]
+      end
+
+      price_ids.compact.map { |price_id| { price: price_id, quantity: 1 } }
+    end
+end
