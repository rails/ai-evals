index 0000000..e8665a2
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,113 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  FREE_CARD_LIMIT = 1_000
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "AccountSubscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "AccountOverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "AccountBillingWaiver", dependent: :destroy
+  end
+
+  def plan
+    if comped?
+      Billing::Plan::UNLIMITED_PLUS
+    elsif subscription && (subscription.status.blank? || subscription.active?)
+      subscription.plan
+    else
+      Billing::Plan::FREE
+    end
+  end
+
+  def plan_name
+    plan.name
+  end
+
+  def plan_key
+    plan.key
+  end
+
+  def free_plan?
+    plan.free?
+  end
+
+  def paid_plan?
+    plan.paid?
+  end
+
+  alias free? free_plan?
+  alias paid? paid_plan?
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def cards_remaining
+    if card_limit
+      [ card_limit - cards_count, 0 ].max
+    end
+  end
+
+  def at_card_limit?
+    card_limit.present? && cards_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && !at_card_limit? && cards_count >= card_limit - CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp!
+    self.comped = true
+  end
+
+  def uncomp!
+    self.comped = false
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      create_billing_waiver! unless comped?
+    else
+      billing_waiver&.destroy!
+    end
+  end
+
+  def override_limits!(card_count:, bytes_used:)
+    limit = overridden_limit || build_overridden_limit
+    limit.update!(card_count: card_count.presence, bytes_used: bytes_used.presence)
+  end
+
+  def reset_limits!
+    overridden_limit&.destroy!
+  end
+
+  alias reset_overrides! reset_limits!
+
+  def active_subscription
+    subscription if subscription && (subscription.status.blank? || subscription.active?)
+  end
+
+  def stripe_customer_id
+    subscription&.stripe_customer_id
+  end
+
+  def account_subscription
+    subscription
+  end
+
+  def cards_count
+    overridden_limit&.card_count || super
+  end
+
+  alias cards_left cards_remaining
+  alias comp? comped?
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+end
