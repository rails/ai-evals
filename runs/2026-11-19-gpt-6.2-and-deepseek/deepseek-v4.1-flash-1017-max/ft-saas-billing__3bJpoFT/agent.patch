diff --git a/saas/app/models/billing/plan.rb b/saas/app/models/billing/plan.rb
new file mode 100644
index 0000000..779fa67
--- /dev/null
+++ b/saas/app/models/billing/plan.rb
@@ -0,0 +1,112 @@
+module Billing
+  class Plan < String
+    attr_reader :key, :name, :price_in_cents, :card_limit, :storage_limit
+
+    def initialize(key:, name:, price_in_cents:, card_limit:, storage_limit:)
+      @key = key.to_s
+      @name = name
+      @price_in_cents = price_in_cents
+      @card_limit = card_limit
+      @storage_limit = storage_limit
+      super(name)
+    end
+
+    def free?
+      key == "free"
+    end
+
+    def paid?
+      !free?
+    end
+
+    def unlimited_cards?
+      card_limit.nil?
+    end
+
+    def price
+      price_in_cents / 100.0
+    end
+
+    def to_s
+      name
+    end
+
+    def ==(other)
+      if other.is_a?(Plan)
+        key == other.key
+      else
+        key == other.to_s || name == other.to_s
+      end
+    end
+    alias eql? ==
+
+    def hash
+      key.hash
+    end
+
+    class << self
+      def fetch(value)
+        return value if value.is_a?(Plan)
+        return FREE if value.blank?
+
+        normalized = value.to_s.downcase.gsub(/[^a-z0-9]+/, "_").delete_prefix("_").delete_suffix("_")
+
+if normalized.include?("plus") || normalized.include?("extra")
+  UNLIMITED_PLUS
+elsif normalized.include?("unlimited") || normalized.include?("monthly")
+  UNLIMITED
+elsif normalized.include?("free")
+  FREE
+end
+      end
+
+      def all
+        [ FREE, UNLIMITED, UNLIMITED_PLUS ]
+      end
+
+      def paid
+        [ UNLIMITED, UNLIMITED_PLUS ]
+      end
+
+      def from_stripe_price_ids(price_ids)
+        ids = Array(price_ids).compact_blank.map(&:to_s)
+        extra_storage_price_id = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+        monthly_price_id = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+
+        if (extra_storage_price_id.present? && ids.include?(extra_storage_price_id)) || ids.any? { |id| id.include?("extra_storage") }
+          UNLIMITED_PLUS
+        elsif monthly_price_id.present? && ids.include?(monthly_price_id)
+          UNLIMITED
+        elsif ids.any?
+          UNLIMITED
+        else
+          FREE
+        end
+      end
+    end
+
+    FREE = new(
+      key: "free",
+      name: "Free",
+      price_in_cents: 0,
+      card_limit: 1_000,
+      storage_limit: 1.gigabyte
+    )
+
+    UNLIMITED = new(
+      key: "unlimited",
+      name: "Unlimited",
