diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..bf5df7b
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,208 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "card", "column" ]
+
+  connect() {
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.hoveredColumn = null
+    this.saveQueues = new Map()
+  }
+
+  cardTargetConnected(card) {
+    card.draggable = true
+  }
+
+  dragStart(event) {
+    const card = event.target.closest("[data-drag-and-drop-target~='card']")
+    const column = card?.closest("[data-drag-and-drop-target~='column']")
+
+    if (!card || !column) return
+
+    this.draggedCard = card
+    this.sourceColumn = column
+
+    card.classList.add(DRAGGED_ITEM_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragEnter(event) {
+    this.#highlightColumnUnderPointer(event)
+  }
+
+  dragOver(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnUnderPointer(event)
+    if (!column) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    this.#highlight(column)
+  }
+
+  dragLeave(event) {
+    const column = this.#columnUnderPointer(event)
+
+    const relatedTarget = event.relatedTarget
+    const stillInsideColumn = relatedTarget instanceof Node && column?.contains(relatedTarget)
+
+    if (column && column === this.hoveredColumn && !stillInsideColumn) {
+      this.#unhighlight(column)
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnUnderPointer(event)
+    if (!column) return
+
+    event.preventDefault()
+
+    const card = this.draggedCard
+    const sourceColumn = this.sourceColumn
+
+    this.#finishDragging()
+
+    if (column !== sourceColumn && this.#moveCard(card, column)) {
+      this.#saveCard(card, column)
+    }
+  }
+
+  dragEnd() {
+    this.#finishDragging()
+  }
+
+  #highlightColumnUnderPointer(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnUnderPointer(event)
+    if (column) {
+      event.preventDefault()
+      this.#highlight(column)
+    }
+  }
+
+  #highlight(column) {
+    if (column === this.hoveredColumn) return
+
+    this.#unhighlight(this.hoveredColumn)
+    this.hoveredColumn = column
+    column.classList.add(HOVER_CONTAINER_CLASS)
+  }
+
+  #unhighlight(column) {
+    if (!column) return
+
+    column.classList.remove(HOVER_CONTAINER_CLASS)
+    if (column === this.hoveredColumn) this.hoveredColumn = null
+  }
+
+  #finishDragging() {
+    this.#unhighlight(this.hoveredColumn)
+    this.draggedCard?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.draggedCard = null
+    this.sourceColumn = null
+  }
+
+  #columnUnderPointer(event) {
+    return event.target.closest?.("[data-drag-and-drop-target~='column']")
+  }
+
+  #moveCard(card, column) {
+    let list = column.querySelector(".cards__list")
+
+    if (!list) {
+      const frame = column.querySelector("turbo-frame")
+      if (!frame) return false
+
+      list = document.createElement("div")
+      list.className = "cards__list hide-scrollbar"
+      frame.append(list)
+      this.#restoreCardAfterFrameLoad(frame, card, column)
+    }
+
+    list.prepend(card)
+    this.#updateCardAppearance(card, column)
+    return true
+  }
+
+  #restoreCardAfterFrameLoad(frame, card, column) {
+    frame.addEventListener("turbo:frame-load", () => {
+      const list = frame.querySelector(".cards__list")
+      const currentColumn = card.closest("[data-drag-and-drop-target~='column']")
+
+      if (!list || (currentColumn && currentColumn !== column)) return
+      if (list.querySelector(`#${CSS.escape(card.id)}`)) return
+
+      list.prepend(card)
+      this.#updateCardAppearance(card, column)
+    }, { once: true })
+  }
+
+  #updateCardAppearance(card, column) {
+    const destination = column.dataset.dragAndDropDestination
+    const columnId = column.dataset.dragAndDropColumnId
+    const isInColumn = destination === "column"
+    const header = card.querySelector(".card__header")
+    let headerLabel = header?.querySelector(".card__column-name--current")
+
+    card.querySelectorAll(".card__stages .card__column-name").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", isInColumn && stage.dataset.columnId === columnId)
+    })
+
+    if (isInColumn) {
+      if (!headerLabel) {
+        headerLabel = document.createElement("span")
+        headerLabel.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+        headerLabel.append(document.createElement("span"))
+        header?.append(headerLabel)
+      }
+
+      (headerLabel.querySelector("span") || headerLabel).textContent = column.dataset.dragAndDropColumnName
+    } else {
+      headerLabel?.remove()
+    }
+
+    card.classList.toggle("card--postponed", destination === "not_now")
+    card.classList.toggle("card--active", destination === "maybe" || isInColumn)
+  }
+
+  #saveCard(card, column) {
+    const previousSave = this.saveQueues.get(card.id) || Promise.resolve()
+    const save = previousSave.catch(() => {}).then(() => this.#performSave(card, column))
+
+    this.saveQueues.set(card.id, save)
+    save.catch(error => console.error("Failed to save card move", error)).finally(() => {
+      if (this.saveQueues.get(card.id) === save) this.saveQueues.delete(card.id)
+    })
+  }
+
+  async #performSave(card, column) {
+    const destination = column.dataset.dragAndDropDestination
+    const options = { responseKind: "json" }
+
+    if (destination === "maybe") {
+      await destroy(card.dataset.cardTriageUrl, options)
+    } else if (destination === "not_now") {
+      await post(card.dataset.cardNotNowUrl, options)
+    } else if (destination === "closed") {
+      await post(card.dataset.cardClosureUrl, options)
+    } else if (destination === "column") {
+      await post(card.dataset.cardTriageUrl, {
+        ...options,
+        query: { column_id: column.dataset.dragAndDropColumnId }
+      })
+    }
+  }
+}
