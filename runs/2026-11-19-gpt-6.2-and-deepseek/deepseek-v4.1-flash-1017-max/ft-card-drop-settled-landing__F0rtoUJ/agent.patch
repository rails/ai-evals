diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..5c5d6d2
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,103 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "dragging a card to another column moves it immediately and saves in the background" do
+    card = cards(:logo)
+    target_column = columns(:writebook_in_progress)
+
+    visit board_url(boards(:writebook))
+
+    drag_card_to(card, dom_id(columns(:writebook_triage)), "##{dom_id(target_column)}")
+
+    assert_selector "##{dom_id(target_column)} .card", text: card.title, visible: :all
+    assert_no_selector "##{dom_id(columns(:writebook_triage))} .card", text: card.title, visible: :all
+    wait_for { card.reload.column == target_column }
+
+    sleep 0.5
+    assert_selector "##{dom_id(target_column)} .card", text: card.title, count: 1, visible: :all
+    assert_no_selector "##{dom_id(columns(:writebook_triage))} .card", text: card.title, visible: :all
+  end
+
+  test "dragging a card to Maybe clears its column" do
+    card = cards(:logo)
+
+    visit board_url(boards(:writebook))
+
+    drag_card_to(card, dom_id(columns(:writebook_triage)), "#maybe")
+
+    assert_selector "#maybe .card", text: card.title
+    wait_for { card.reload.awaiting_triage? }
+  end
+
+  test "dragging a card to Not Now postpones it" do
+    card = cards(:logo)
+
+    visit board_url(boards(:writebook))
+
+    drag_card_to(card, dom_id(columns(:writebook_triage)), "#not-now")
+
+    assert_selector "#not-now .card", text: card.title, visible: :all
+    wait_for { card.reload.postponed? }
+  end
+
+  test "dragging a card to Done closes it" do
+    card = cards(:logo)
+
+    visit board_url(boards(:writebook))
+
+    drag_card_to(card, dom_id(columns(:writebook_triage)), "#closed-cards")
+
+    assert_selector "#closed-cards .card", text: card.title, visible: :all
+    wait_for { card.reload.closed? }
+  end
+
+  test "dragging a closed card back to a column reopens it" do
+    card = cards(:shipping)
+    target_column = columns(:writebook_in_progress)
+
+    visit board_url(boards(:writebook))
+
+    drag_card_to(card, "closed-cards", "##{dom_id(target_column)}")
+
+    assert_selector "##{dom_id(target_column)} .card", text: card.title, visible: :all
+    wait_for { card.reload.open? && card.column == target_column }
+  end
+
+  private
+    def drag_card_to(card, source_column_id, target_selector)
+      card_element = find("##{source_column_id} .card", text: card.title, visible: :all)
+      assert_selector "#{target_selector} .cards__list", visible: :all
+      target = find(target_selector)
+
+      page.execute_script <<~JS, card_element, target
+        const [ card, column ] = arguments
+        const dataTransfer = new DataTransfer()
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("dragenter", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+
+        if (!card.classList.contains("drag-and-drop__dragged-item")) throw new Error("card was not marked as dragged")
+        if (!card.dataset.cardTriageUrl) throw new Error("card has no triage URL: " + card.outerHTML.slice(0, 300))
+        if (!column.classList.contains("drag-and-drop__hover-container")) throw new Error("column was not highlighted")
+
+        column.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer }))
+
+        if (card.classList.contains("drag-and-drop__dragged-item")) throw new Error("card remained marked as dragged")
+        if (column.classList.contains("drag-and-drop__hover-container")) throw new Error("column remained highlighted")
+      JS
+    end
+
+    def wait_for(&block)
+      Timeout.timeout(5) do
+        sleep 0.05 until block.call
+      end
+    end
+end
