@@ -0,0 +1,36 @@
+ja:
+  account_seeder:
+    playground_name: "プレイグラウンド"
+    orientation:
+      title: "最後に、Fizzy の紹介動画を見てみましょう"
+      description_html: "<p>Fizzy ではもっと多くのことができます。以下の動画では、37signals の創業者兼 CEO、Jason Fried が17分で基本を説明します。</p><action-text-attachment url=\"https://videos.37signals.com/fizzy/assets/videos/fizzyorientation-4k.mp4\" caption=\"Fizzy の紹介\" content-type=\"video/mp4\" filename=\"fizzyorientation-4k.mp4\"></action-text-attachment>"
+    passkey:
+      title: "次に、パスキーを設定しましょう"
+      description_html: "<p>パスキーを使うと、パスワードやメールのコードなしで安全にサインインできます。設定するには、Fizzy メニューを開き、「<b><strong>プロフィール > パスキーを管理</b></strong>」に進みます。パスキーの利用は任意ですが、おすすめです。</p><action-text-attachment url=\"https://videos.37signals.com/fizzy/assets/videos/creating_a_passkey.mp4\" alt=\"パスキー追加のデモ\" caption=\"パスワードやメールのコードなしでサインインするためのパスキーを作成\" content-type=\"video/mp4\" filename=\"creating_a_passkey.mp4\"></action-text-attachment>"
+    invite:
+      title: "では、招待リンクを取得して他の人を招待しましょう"
+      description_html: "<p>Fizzy メニューを開き、「<b><strong>+ メンバーを追加</b></strong>」を選んでから、招待リンクをコピーします。このリンクを他の人に渡すと、その人があなたのアカウントにログインできるようになります。</p><action-text-attachment url=\"https://videos.37signals.com/fizzy/assets/images/invite-link.gif\" alt=\"招待リンクをコピーするデモ\" caption=\"同僚を招待するリンクを取得\" content-type=\"image/*\" filename=\"invite-link.gif\" presentation=\"gallery\"></action-text-attachment>"
+    home:
+      title: "次に、ホームに戻ってアクティビティを確認しましょう"
+      description_html: "<p>「1」キーを押すか、Fizzy メニューを引き下げて「ホーム」を選びます。</p><action-text-attachment url=\"https://videos.37signals.com/fizzy/assets/images/back-to-home.gif\" alt=\"ホームへ移動するデモ\" caption=\"ホームに戻って最新のアクティビティを確認\" content-type=\"image/*\" filename=\"back-to-home.gif\" presentation=\"gallery\"></action-text-attachment>"
+    assigned:
+      title: "次に、自分に割り当てられたカードを確認しましょう"
