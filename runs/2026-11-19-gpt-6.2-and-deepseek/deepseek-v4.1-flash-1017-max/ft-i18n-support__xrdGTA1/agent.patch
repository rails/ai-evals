diff --git a/app/controllers/concerns/localizable.rb b/app/controllers/concerns/localizable.rb
new file mode 100644
index 0000000..9cfcf90
--- /dev/null
+++ b/app/controllers/concerns/localizable.rb
@@ -0,0 +1,54 @@
+module Localizable
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :switch_locale
+    after_action :persist_locale
+    helper_method :current_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def switch_locale(&action)
+      requested_locale = supported_locale(params[:locale])
+
+      if requested_locale
+        session[:locale] = requested_locale
+      else
+        session[:locale] ||= supported_locale(identity_from_session&.locale)
+      end
+
+      persist_locale_for(identity_from_session) if session[:locale].present?
+
+      I18n.with_locale(current_locale, &action)
+    end
+
+    def current_locale
+      supported_locale(params[:locale]) ||
+        supported_locale(session[:locale]) ||
+        supported_locale(identity_from_session&.locale) ||
+        I18n.default_locale
+    end
+
+    def supported_locale(value)
+      value = value.to_s
+      value if value.present? && I18n.available_locales.map(&:to_s).include?(value)
+    end
+
+    def identity_from_session
+      Current.identity || find_session_by_cookie&.identity
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+
+    def persist_locale
+      persist_locale_for(Current.identity)
+    end
+
+    def persist_locale_for(identity)
+      locale = supported_locale(session[:locale])
+      if identity && locale && identity.locale != locale
+        identity.update_column(:locale, locale)
+      end
+    end
+end
