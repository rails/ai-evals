+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  test "magic link email uses the recipient locale" do
+    identity = identities(:kevin)
+    identity.update_column(:locale, "ja")
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzy のコードは #{magic_link.code} です", email.subject
+    assert_match "Fizzy 認証コード", email.html_part.decoded
+    assert_match "このコードは15分有効です。", email.text_part.decoded
+  end
+
+  test "email change confirmation uses the recipient locale" do
+    user = users(:kevin)
+    user.identity.update_column(:locale, "ja")
+
+    email = UserMailer.email_change_confirmation(email_address: "new@example.com", token: "token", user: user)
+
+    assert_equal "新しいメールアドレスを確認してください", email.subject
+    assert_match "メールアドレスの変更を確認", email.body.decoded
+  end
+
+  test "cancellation email localizes subject, body, and relative dates" do
+    account = accounts(:"37s")
+    user = users(:david)
+    user.identity.update_column(:locale, "ja")
+    account.cancel(initiated_by: user)
+
+    email = AccountMailer.cancellation(account.cancellation)
+
+    assert_equal "Fizzy アカウントがキャンセルされました", email.subject
+    assert_match "アカウント内のすべてのデータは約1か月後に削除されます", email.text_part.decoded
+  end
+
+  test "notification bundle email localizes its subject and body" do
+    user = users(:david)
+    user.notifications.destroy_all
+    user.identity.update_column(:locale, "ja")
+    bundle = Notification::Bundle.create!(user: user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    Notification.create!(user: user, creator: user, source: events(:logo_published), created_at: 30.minutes.ago)
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_equal "Fizzy：新しい通知", email.subject
+    assert_match "以降の通知", email.html_part.decoded
+    assert_match "新しい通知が1件", email.html_part.decoded
+    assert_match "通知の頻度を変更", email.html_part.decoded
+    assert_match "すべてのメール通知の配信を停止", email.html_part.decoded
+  end
+
+test "export email localizes subject and body" do
+  user = users(:david)
+  user.identity.update_column(:locale, "ja")
+  export = Account::Export.create!(account: Current.account, user: user)
+
+  email = ExportMailer.completed(export)
+
+  assert_equal "Fizzy データのエクスポートをダウンロードできます", email.subject
+  assert_match "Fizzy データをダウンロード", email.html_part.decoded
+  assert_match "エクスポート処理が完了", email.text_part.decoded
+end
+
+test "import emails localize subject and body" do
+  identity = identities(:david)
+  identity.update_column(:locale, "ja")
+  account = accounts(:"37s")
+
+  completed = ImportMailer.completed(identity, account)
+  assert_equal "Fizzy アカウントのインポートが完了しました", completed.subject
+  assert_match "のインポートが完了しました", completed.html_part.decoded
+
+  import = Account::Import.create!(account: account, identity: identity, status: :failed)
+  failed = ImportMailer.failed(import)
+  assert_equal "Fizzy アカウントのインポートに失敗しました", failed.subject
+  assert_match "Fizzy アカウントをインポートできませんでした", failed.html_part.decoded
+end
+end
