diff --git a/test/integration/localization_pages_test.rb b/test/integration/localization_pages_test.rb
new file mode 100644
index 0000000..f25cff5
--- /dev/null
+++ b/test/integration/localization_pages_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class LocalizationPagesTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+    @card = cards(:layout)
+    @user = users(:kevin)
+  end
+
+  test "authenticated screens render in Japanese" do
+    paths = [
+      root_path,
+      cards_path,
+      board_path(@board),
+      edit_board_path(@board),
+      card_path(@card),
+      edit_card_path(@card),
+      new_board_path,
+      user_path(@user),
+      edit_user_path(@user),
+      notifications_path,
+      notifications_settings_path,
+      search_path(q: "logo"),
+      account_settings_path,
+      account_join_code_path,
+      edit_account_join_code_path,
+      my_access_tokens_path,
+      new_my_access_token_path,
+      my_passkeys_path,
+      my_pins_path,
+      board_webhooks_path(@board),
+      new_board_webhook_path(@board),
+      board_webhook_path(@board, webhooks(:active)),
+      edit_board_webhook_path(@board, webhooks(:active)),
+      user_events_path(@user),
+      events_day_timeline_column_path(day: Date.current, id: "added")
+    ]
+
+    paths.each do |path|
+      get path, params: { locale: :ja }
+      assert_response :success, "Expected #{path} to render, got #{response.status}"
+      assert_select "html[lang='ja']", message: "Expected #{path} to render in Japanese"
+    end
+  end
+
+test "authenticated screens keep rendering in English" do
+  [ root_path, cards_path, notifications_settings_path, account_settings_path, user_path(@user) ].each do |path|
+    get path, params: { locale: :en }
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_no_match(/[ぁ-んァ-ヶ]/, response.body, "Expected #{path} to contain no Japanese text")
+  end
+end
+end
+
+class PublicLocalizationPagesTest < ActionDispatch::IntegrationTest
+  test "public screens render in Japanese" do
+    board = boards(:writebook)
+    board.publish
+    card = cards(:layout)
+
+    [ public_board_path(board.publication.key), public_board_card_path(board.publication.key, card) ].each do |path|
+      get path, params: { locale: :ja }
+      assert_response :success, "Expected #{path} to render, got #{response.status}"
+      assert_select "html[lang='ja']", message: "Expected #{path} to render in Japanese"
+      assert_no_match "No cards here", response.body
+      assert_no_match "Maximize column", response.body
+
+      get path
+      assert_select "html[lang='ja']"
+    end
+  end
+end
diff --git a/test/integration/localization_test.rb b/test/integration/localization_test.rb
new file mode 100644
index 0000000..9767da3
--- /dev/null
+++ b/test/integration/localization_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "locale query parameter switches and persists in the session" do
+    sign_in_as :kevin
+
+    get events_path(locale: :ja)
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_match "アクティビティ", response.body
+
+    get events_path
+    assert_response :success
+    assert_select "html[lang='ja']"
+  end
+
+  test "unsupported locale is ignored" do
+    sign_in_as :kevin
+
+    get events_path(locale: :xx)
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_no_match(/[ぁ-んァ-ヶ]/, response.body)
+  end
+
+  test "identity locale is used after a clean sign in" do
+    identities(:kevin).update_column(:locale, "ja")
+
+    sign_in_as :kevin
+
+    get events_path
+    assert_response :success
+    assert_select "html[lang='ja']"
+  end
+
+  test "locale chosen before sign in is saved to the identity" do
+    untenanted do
+      get new_session_path(locale: :ja)
+    end
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_match "メールアドレス", response.body
+
+    sign_in_as :kevin
+
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+end
+
+class LocalizationSignInTest < ActionDispatch::IntegrationTest
+  test "locale selected on the sign-in page is persisted before sending the magic link" do
+    identity = identities(:kevin)
+
+    untenanted do
+      get new_session_path(locale: :ja)
+      assert_response :success
+
+      post session_path, params: { email_address: identity.email_address }
+    end
+
+    assert_redirected_to session_magic_link_path(script_name: nil)
+    assert_equal "ja", identity.reload.locale
+  end
+end
+
+class LocalizationSignupTest < ActionDispatch::IntegrationTest
+  test "locale selected on the signup page is persisted on the new identity" do
+    email = "ja-signup-#{SecureRandom.hex(6)}@example.com"
+
+    untenanted do
+      get new_signup_path(locale: :ja)
+      assert_response :success
+
+      post signup_path, params: { signup: { email_address: email } }
+    end
+
+    assert_redirected_to session_magic_link_path(script_name: nil)
+    assert_equal "ja", Identity.find_by!(email_address: email).locale
+  end
+end
+
