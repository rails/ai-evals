@@ -26,6 +26,45 @@ class SessionsController < ApplicationController
       redirect_to first_run_url if User.none?
     end
 
+    def safe_return_to
+      return_to = params[:return_to]
+      return post_authenticating_url unless return_to.is_a?(String) && return_to.valid_encoding?
+
+      return_to = return_to.strip
+      return post_authenticating_url if return_to.blank? || return_to.match?(/[\x00-\x20\\\x7f]/)
+
+      uri = URI.parse(return_to)
+
+      if uri.host.nil? && uri.scheme.nil?
+        return return_to if return_to.start_with?("/") && !return_to.start_with?("//")
+      end
+
+      if same_origin?(uri) && (local_path = local_path_for(uri))
+        return local_path
+      end
+
+      post_authenticating_url
+    rescue URI::Error, ArgumentError
+      post_authenticating_url
+    end
+
+    def same_origin?(uri)
+      uri.scheme.in?(%w[ http https ]) &&
+        uri.host.present? &&
+        uri.host.casecmp?(request.host) &&
+        uri.port == request.port &&
+        uri.scheme == request.scheme
+    end
+
+    def local_path_for(uri)
+      path = uri.path.presence || "/"
+      return unless path.start_with?("/") && !path.start_with?("//")
+
+      path += "?#{uri.query}" if uri.query.present?
+      path += "##{uri.fragment}" if uri.fragment.present?
+      path
+    end
+
     def render_rejection(status)
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
