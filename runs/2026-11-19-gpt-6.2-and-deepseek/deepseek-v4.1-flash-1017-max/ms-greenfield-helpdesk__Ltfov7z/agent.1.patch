diff --git a/app/controllers/api/v1/sessions_controller.rb b/app/controllers/api/v1/sessions_controller.rb
new file mode 100644
index 0000000..8cd61bf
--- /dev/null
+++ b/app/controllers/api/v1/sessions_controller.rb
@@ -0,0 +1,41 @@
+module Api
+  module V1
+    class SessionsController < BaseController
+      before_action :require_account!, only: [:create]
+      before_action -> { authenticate_user!(allow_cancelled: true) }, only: [:destroy]
+
+      def create
+        session_attributes = params.require(:session).permit(:email, :password)
+        email = session_attributes[:email].to_s.strip.downcase
+        user = account.users.find_by(email: email)
+
+        unless user&.authenticate(session_attributes[:password].to_s)
+          render_error("Invalid email or password", :unauthorized)
+          return
+        end
+
+        unless user.verified?
+          render_error("Email not verified", :forbidden)
+          return
+        end
+
+        if account.cancelled? && !account.reactivation_window_open?
+          render_error("Reactivation window has expired", :forbidden)
+          return
+        end
+
+        _session, token = Session.create_for(user)
+        render json: {
+          user: UserSerializer.render(user),
+          account: AccountSerializer.render(account),
+          session: { token: token }
+        }, status: :ok
+      end
+
+      def destroy
+        current_session.destroy!
+        render json: { message: "Signed out" }, status: :ok
+      end
+    end
+  end
+end
