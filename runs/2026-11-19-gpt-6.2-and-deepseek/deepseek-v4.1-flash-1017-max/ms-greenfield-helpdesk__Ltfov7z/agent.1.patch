diff --git a/app/mailers/email_verification_mailer.rb b/app/mailers/email_verification_mailer.rb
new file mode 100644
index 0000000..36aec39
--- /dev/null
+++ b/app/mailers/email_verification_mailer.rb
@@ -0,0 +1,9 @@
+class EmailVerificationMailer < ApplicationMailer
+  def verification_email
+    @user = params.fetch(:user)
+    @token = params.fetch(:token)
+    @verification_url = "#{frontend_base_url}/verify-email?account=#{ERB::Util.url_encode(@user.account.subdomain)}&token=#{ERB::Util.url_encode(@token)}"
+
+    mail(to: @user.email, subject: "Verify your email address")
+  end
+end
