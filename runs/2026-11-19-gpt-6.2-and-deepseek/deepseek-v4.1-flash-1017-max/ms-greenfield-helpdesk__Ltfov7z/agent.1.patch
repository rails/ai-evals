new file mode 100644
index 0000000..196003c
--- /dev/null
+++ b/app/models/session.rb
@@ -0,0 +1,25 @@
+class Session < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  def self.digest_token(token)
+    Digest::SHA256.hexdigest(token.to_s)
+  end
+
+  def self.create_for(user)
+    token = SecureRandom.urlsafe_base64(32)
+    session = create!(
+      account: user.account,
+      user: user,
+      token_digest: digest_token(token),
+      last_used_at: Time.current
+    )
+    [session, token]
+  end
+
+  def self.find_by_token(token)
+    return if token.blank?
+
+    find_by(token_digest: digest_token(token))
+  end
+end
diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..bbad7e7
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,55 @@
+class User < ApplicationRecord
+  ROLES = %w[admin member].freeze
+
+  belongs_to :account
+  has_many :sessions, dependent: :destroy
+
+  has_secure_password
+
+  normalizes :email, with: ->(email) { email.to_s.strip.downcase }
+
+  validates :name, presence: true
+  validates :email,
+            presence: true,
+            format: { with: URI::MailTo::EMAIL_REGEXP },
+            uniqueness: { scope: :account_id, case_sensitive: false }
+  validates :role, presence: true, inclusion: { in: ROLES }
+
+  def self.digest_token(token)
+    Digest::SHA256.hexdigest(token.to_s)
+  end
+
+  def admin?
+    role == "admin"
+  end
+
+  def issue_verification_token!
+    token = SecureRandom.urlsafe_base64(32)
+    update_columns(
+      verification_token_digest: self.class.digest_token(token),
+      verification_token_sent_at: Time.current
+    )
+    token
+  end
+
+  def issue_password_reset_token!
+    token = SecureRandom.urlsafe_base64(32)
+    update_columns(
+      password_reset_token_digest: self.class.digest_token(token),
+      password_reset_token_sent_at: Time.current
+    )
+    token
+  end
+
+  def confirm_email!
+    update!(
+      verified: true,
+      verification_token_digest: nil,
+      verification_token_sent_at: nil
+    )
+  end
+
+  def revoke_sessions!
+    sessions.destroy_all
+  end
+end
