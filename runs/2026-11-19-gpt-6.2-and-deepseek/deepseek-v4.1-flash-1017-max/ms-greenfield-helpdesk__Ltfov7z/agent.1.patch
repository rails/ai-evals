+class PasswordResetMailer < ApplicationMailer
+  def password_reset_email
+    @user = params.fetch(:user)
+    @token = params.fetch(:token)
+    @reset_url = "#{frontend_base_url}/reset-password?account=#{ERB::Util.url_encode(@user.account.subdomain)}&token=#{ERB::Util.url_encode(@token)}"
+
+    mail(to: @user.email, subject: "Reset your password")
+  end
+end
diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..9b974c1
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,42 @@
+class Account < ApplicationRecord
+  REACTIVATION_WINDOW = 90.days
+
+  has_many :users, dependent: :destroy
+  has_many :sessions, dependent: :destroy
+
+  normalizes :subdomain, with: ->(subdomain) { subdomain.to_s.strip.downcase }
+
+  validates :name, presence: true
+  validates :subdomain,
+            presence: true,
+            uniqueness: { case_sensitive: false },
+            format: { with: /\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z/,
+                      message: "may only contain lowercase letters, numbers, and hyphens" }
+
+  scope :cancelled_before, ->(time) { where("cancelled_at < ?", time) }
+
+  def cancelled?
+    cancelled_at.present?
+  end
+
+  def active?
+    !cancelled?
+  end
+
+  def reactivation_window_open?
+    cancelled? && cancelled_at >= REACTIVATION_WINDOW.ago
+  end
+
+  def revoke_sessions!
+    sessions.destroy_all
+  end
+
+  def cancel!
+    update!(cancelled_at: Time.current)
+    revoke_sessions!
+  end
+
+  def reactivate!
+    update!(cancelled_at: nil)
+  end
+end
