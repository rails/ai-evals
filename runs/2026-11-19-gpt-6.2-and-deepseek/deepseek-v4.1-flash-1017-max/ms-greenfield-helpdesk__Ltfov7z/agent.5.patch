index 0000000..9a9a78d
--- /dev/null
+++ b/app/mailers/ticket_reply_mailer.rb
@@ -0,0 +1,14 @@
+class TicketReplyMailer < ApplicationMailer
+  def ticket_reply_email
+    @ticket = params.fetch(:ticket)
+    @comment = params.fetch(:comment)
+    @reply_address = @ticket.reply_address
+
+    mail(
+      to: @ticket.requester.email,
+      reply_to: @reply_address,
+      subject: "Re: #{@ticket.subject}",
+      headers: { "X-Helpdesk-Ticket-ID" => @ticket.id.to_s }
+    )
+  end
+end
