+require "test_helper"
+
+class CursorPaginationTest < ActionDispatch::IntegrationTest
+  def setup
+    ActionMailer::Base.deliveries.clear
+    @account = Account.create!(name: "Acme", subdomain: "acme")
+    @admin = create_user("Admin", "admin@acme.test", "admin")
+    @agent = create_user("Agent", "agent@acme.test", "agent")
+    @customer = create_user("Customer", "customer@acme.test", "customer")
+    _session, @admin_token = Session.create_for(@admin)
+    _session, @agent_token = Session.create_for(@agent)
+    _session, @customer_token = Session.create_for(@customer)
+
+    base_time = Time.zone.parse("2026-01-01 12:00:00")
+    @tickets = 5.times.map do |index|
+      ticket = @account.tickets.create!(
+        requester: @customer,
+        subject: "Ticket #{index + 1}",
+        status: "open"
+      )
+      ticket.update_columns(
+        created_at: base_time + index.minutes,
+        updated_at: base_time + index.minutes
+      )
+      ticket
+    end
+
+    @comment_ticket = @tickets.last
+    2.times do |index|
+      @comment_ticket.comments.create!(
+        author: @customer,
+        body: "Public comment #{index + 1}",
+        public: true,
+        created_at: base_time + index.minutes,
+        updated_at: base_time + index.minutes
+      )
+    end
+    @comment_ticket.comments.create!(
+      author: @agent,
+      body: "Private note",
+      public: false,
+      created_at: base_time + 3.minutes,
+      updated_at: base_time + 3.minutes
+    )
+
+    # Public comments touch their ticket's updated_at, so restore the fixture
+    # ordering after creating the comment collections.
+    @tickets.each_with_index do |ticket, index|
+      ticket.update_columns(
+        created_at: base_time + index.minutes,
+        updated_at: base_time + index.minutes
+      )
+    end
+
+    @billing = @account.groups.create!(name: "Billing")
+    @support = @account.groups.create!(name: "Support")
+    GroupMembership.create!(group: @billing, user: @agent)
+    GroupMembership.create!(group: @support, user: @agent)
+    @account.invitations.create!(email: "first@example.test", role: "agent")
+    @account.invitations.create!(email: "second@example.test", role: "agent")
+  end
+
+  def create_user(name, email, role)
+    @account.users.create!(
+      name: name,
+      email: email,
+      password: "password123",
+      role: role,
+      verified: true
+    )
+  end
+
+  def headers_for(token)
+    {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{token}"
+    }
+  end
+
+  def json
+    JSON.parse(response.body)
+  end
+
+  def get_json(path, token, params = {})
+    get path, params: params, headers: headers_for(token)
+    assert_response :ok
+    JSON.parse(response.body)
+  end
+
+  def assert_cursor_response(payload, collection_key)
+    assert payload.key?(collection_key)
+    assert_equal %w[has_more after_cursor before_cursor], payload.fetch("meta").keys
+    assert_equal %w[next prev], payload.fetch("links").keys
+    assert_includes [true, false], payload["meta"]["has_more"]
+  end
+
+  test "cursor navigation moves forward and backward without offset drift" do
+    first = get_json(
+      "/api/v1/tickets",
+      @agent_token,
+      page: { size: 2 },
+      status: "open"
+    )
+    assert_cursor_response(first, "tickets")
+    assert_equal [@tickets[4].id, @tickets[3].id], first["tickets"].map { |ticket| ticket["id"] }
+    assert_equal true, first["meta"]["has_more"]
+    assert first["meta"]["after_cursor"].present?
+    assert first["meta"]["before_cursor"].present?
+    assert first["links"]["next"].present?
+    assert_nil first["links"]["prev"]
+    assert_includes first["links"]["next"], "status=open"
+
+    second = get_json(first["links"]["next"], @agent_token)
+    assert_cursor_response(second, "tickets")
+    assert_equal [@tickets[2].id, @tickets[1].id], second["tickets"].map { |ticket| ticket["id"] }
+    assert_equal true, second["meta"]["has_more"]
+    assert second["links"]["next"].present?
+    assert second["links"]["prev"].present?
+
+    previous = get_json(second["links"]["prev"], @agent_token)
+    assert_cursor_response(previous, "tickets")
+    assert_equal first["tickets"].map { |ticket| ticket["id"] }, previous["tickets"].map { |ticket| ticket["id"] }
+    assert_equal false, previous["meta"]["has_more"]
+    assert_nil previous["links"]["prev"]
+    assert previous["links"]["next"].present?
+
+    third = get_json(second["links"]["next"], @agent_token)
+    assert_cursor_response(third, "tickets")
+    assert_equal [@tickets[0].id], third["tickets"].map { |ticket| ticket["id"] }
+    assert_equal false, third["meta"]["has_more"]
+    assert_nil third["links"]["next"]
+    assert third["links"]["prev"].present?
+
+    middle = get_json(third["links"]["prev"], @agent_token)
+    assert_cursor_response(middle, "tickets")
+    assert_equal second["tickets"].map { |ticket| ticket["id"] }, middle["tickets"].map { |ticket| ticket["id"] }
+    assert_equal true, middle["meta"]["has_more"]
+    assert middle["links"]["next"].present?
+    assert middle["links"]["prev"].present?
+  end
+
+  test "cursor navigation is stable when records are inserted or deleted between pages" do
+    first = get_json("/api/v1/tickets", @agent_token, page: { size: 2 }, status: "open")
+
+    newer_ticket = @account.tickets.create!(
+      requester: @customer,
+      subject: "Newly created",
+      status: "open"
+    )
+    newer_ticket.update_columns(
+      created_at: Time.zone.parse("2026-01-01 13:00:00"),
+      updated_at: Time.zone.parse("2026-01-01 13:00:00")
+    )
+
+    # Deleting the record used for the boundary cursor must not break the next page.
+    @tickets[3].destroy!
+
+    second = get_json(first["links"]["next"], @agent_token)
+    assert_equal [@tickets[2].id, @tickets[1].id], second["tickets"].map { |ticket| ticket["id"] }
+  end
+
+  test "cursors are supported on every existing collection" do
+    collections = [
+      ["/api/v1/tickets", "tickets", @agent_token],
+      ["/api/v1/requests", "requests", @customer_token],
+      ["/api/v1/tickets/#{@comment_ticket.id}/comments", "comments", @agent_token],
+      ["/api/v1/requests/#{@comment_ticket.id}/comments", "comments", @customer_token],
+      ["/api/v1/users", "users", @admin_token],
+      ["/api/v1/groups", "groups", @agent_token],
+      ["/api/v1/group_memberships", "group_memberships", @agent_token],
+      ["/api/v1/invitations", "invitations", @admin_token],
+      ["/api/v1/staff", "staff", @agent_token]
+    ]
+
+    collections.each do |path, collection_key, token|
+      first = get_json(path, token, page: { size: 1 })
+      assert_cursor_response(first, collection_key)
+      assert first[collection_key].any?, "expected #{path} to return a record"
+      assert first["meta"]["after_cursor"].present?, "expected #{path} to expose an after cursor"
+      assert first["meta"]["before_cursor"].present?, "expected #{path} to expose a before cursor"
+      assert first["links"]["next"].present?, "expected #{path} to have a next link"
+
+      second = get_json(first["links"]["next"], token)
+      assert_cursor_response(second, collection_key)
+      assert second[collection_key].any?, "expected the second page for #{path} to return a record"
+      assert second["links"]["prev"].present?, "expected #{path} to have a prev link"
+      refute_equal(
+        first[collection_key].map { |record| record["id"] },
+        second[collection_key].map { |record| record["id"] }
+      )
+    end
+  end
+
+  test "empty cursor pages use the documented response shape" do
+    payload = get_json(
+      "/api/v1/tickets",
+      @agent_token,
+      page: { size: 25 },
+      status: "closed"
+    )
+
+    assert_equal(
+      {
+        "tickets" => [],
+        "meta" => {
+          "has_more" => false,
+          "after_cursor" => nil,
+          "before_cursor" => nil
+        },
+        "links" => { "next" => nil, "prev" => nil }
+      },
+      payload
+    )
+  end
+
+  test "records sharing a sort timestamp are paginated deterministically" do
+    tied_time = Time.zone.parse("2026-02-01 10:00:00.123456")
+    tied_tickets = 4.times.map do |index|
+      ticket = @account.tickets.create!(
+        requester: @customer,
+        subject: "Tied #{index + 1}",
+        status: "open"
+      )
+      ticket.update_columns(created_at: tied_time, updated_at: tied_time)
+      ticket
+    end
+
+    first = get_json(
+      "/api/v1/tickets",
+      @agent_token,
+      page: { size: 2 },
+      status: "open",
+      q: "Tied"
+    )
+    assert_equal tied_tickets.reverse.first(2).map(&:id), first["tickets"].map { |ticket| ticket["id"] }
+
+    second = get_json(first["links"]["next"], @agent_token)
+    assert_equal tied_tickets.reverse.last(2).map(&:id), second["tickets"].map { |ticket| ticket["id"] }
+    assert_equal false, second["meta"]["has_more"]
+  end
+
+  test "invalid or mismatched cursors are rejected" do
+    get "/api/v1/tickets",
+        params: { page: { size: 2, after: "not-a-cursor" } },
+        headers: headers_for(@agent_token)
+    assert_response :bad_request
+    assert_equal "Invalid cursor", json["error"]
+
+    get "/api/v1/tickets",
+        params: { page: { size: 2, after: "one", before: "two" } },
+        headers: headers_for(@agent_token)
+    assert_response :bad_request
+
+    get "/api/v1/tickets",
+        params: { page: { size: 2, after: "" } },
+        headers: headers_for(@agent_token)
+    assert_response :bad_request
+    assert_equal "Invalid cursor", json["error"]
+
+    users = get_json("/api/v1/users", @admin_token, page: { size: 1 })
+    get "/api/v1/tickets",
+        params: { page: { size: 1, after: users["meta"]["after_cursor"] } },
+        headers: headers_for(@agent_token)
+    assert_response :bad_request
+    assert_equal "Invalid cursor", json["error"]
+  end
+end
