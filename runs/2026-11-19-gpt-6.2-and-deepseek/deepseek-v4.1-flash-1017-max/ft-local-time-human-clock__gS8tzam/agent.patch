diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..4899444
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders a raw UTC timestamp for the browser to format" do
+    time = Time.utc(2026, 11, 19, 21, 42)
+    html = local_time_tag(time)
+    node = Nokogiri::HTML::DocumentFragment.parse(html).at_css("time")
+
+    assert_equal "2026-11-19T21:42:00Z", node["datetime"]
+    assert_equal "2026-11-19T21:42:00Z", node.text
+    assert_equal "local-time", node["data-controller"]
+    assert_equal "relative", node["data-local-time-format-value"]
+    assert_equal "false", node["data-local-time-date-only-value"]
+    assert_no_match(/1:42 PM|November 19/, html)
+  end
+
+  test "marks dates as date-only so the browser does not shift them across timezones" do
+    html = local_time_tag(Date.new(2026, 11, 19), format: :weekday_date)
+    node = Nokogiri::HTML::DocumentFragment.parse(html).at_css("time")
+
+    assert_equal "2026-11-19", node["datetime"]
+    assert_equal "true", node["data-local-time-date-only-value"]
+    assert_equal "weekday_date", node["data-local-time-format-value"]
+  end
+
+  test "passes through custom attributes and data" do
+    html = local_time_tag(Time.utc(2026, 11, 19), format: :future, class: "timestamp", data: { turbo: false })
+    node = Nokogiri::HTML::DocumentFragment.parse(html).at_css("time")
+
+    assert_includes node["class"].split, "local-time-value"
+    assert_includes node["class"].split, "timestamp"
+    assert_equal "false", node["data-turbo"]
+    assert_equal "future", node["data-local-time-format-value"]
+  end
+end
