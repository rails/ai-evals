diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..a5547c7
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,27 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = {
+    format: { type: String, default: "relative" },
+    dateOnly: { type: Boolean, default: false }
+  }
+
+  connect() {
+    this.boundRender = this.render.bind(this)
+    this.element.addEventListener("turbo:morph-element", this.boundRender)
+    this.render()
+  }
+
+  disconnect() {
+    this.element.removeEventListener("turbo:morph-element", this.boundRender)
+  }
+
+  render() {
+    const date = new Date(this.element.dateTime)
+
+    if (!Number.isNaN(date.getTime())) {
+      this.element.textContent = formatTimestamp(date, this.formatValue, { dateOnly: this.dateOnlyValue })
+    }
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..6b229ae 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -42,3 +42,71 @@ function buildDateFormatter(timezone) {
     return new Intl.DateTimeFormat("en-US", options)
   }
 }
+
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000
+const relativeTimeFormatter = new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+const timestampFormatterCache = new Map()
+
+export function formatTimestamp(date, format = "relative", { dateOnly = false, now = new Date() } = {}) {
+  switch (format) {
+    case "relative":
+      return formatRelativeDate(date, { now })
+    case "future":
+      return formatRelativeDate(date, { now, future: true })
+    case "date":
+      return formatDate(date, { dateOnly })
+    case "full_date":
+      return formatDate(date, { dateOnly, includeYear: true })
+    case "weekday_date":
+      return formatWithOptions(date, { weekday: "long", month: "long", day: "numeric" }, dateOnly)
+    case "time":
+      return formatWithOptions(date, { hour: "numeric", minute: "2-digit" }, dateOnly)
+    case "datetime":
+      return formatWithOptions(date, { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }, dateOnly)
+    case "numeric_datetime":
+      return formatWithOptions(date, { month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit" }, dateOnly)
+    default:
+      return formatRelativeDate(date, { now })
+  }
+}
+
+export function formatRelativeDate(date, { now = new Date(), future = false } = {}) {
+  const dayDifference = localDayDifference(now, date)
+
+  if (dayDifference === 0) {
+    const time = formatWithOptions(date, { hour: "numeric", minute: "2-digit" })
+    return future ? `at ${time}` : time
+  }
+
+  if (Math.abs(dayDifference) <= 6) {
+    return relativeTimeFormatter.format(dayDifference, "day")
+  }
+
+  const dateText = formatDate(date)
+  return future ? `on ${dateText}` : dateText
+}
+
+function formatDate(date, { dateOnly = false, includeYear = false } = {}) {
+  const options = { month: "short", day: "numeric" }
+  if (includeYear) options.year = "numeric"
+  return formatWithOptions(date, options, dateOnly)
+}
+
+function formatWithOptions(date, options, dateOnly = false) {
+  const timeZone = dateOnly ? "UTC" : undefined
+  const cacheKey = JSON.stringify({ options, timeZone })
+  let formatter = timestampFormatterCache.get(cacheKey)
+
+  if (!formatter) {
+    formatter = new Intl.DateTimeFormat("en-US", { ...options, timeZone })
+    timestampFormatterCache.set(cacheKey, formatter)
+  }
+
+  return formatter.format(date)
+}
+
+function localDayDifference(fromDate, toDate) {
+  const fromDay = Date.UTC(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate())
+  const toDay = Date.UTC(toDate.getFullYear(), toDate.getMonth(), toDate.getDate())
+  return Math.round((toDay - fromDay) / DAY_IN_MILLISECONDS)
+}
