index 0000000..49c5870
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,46 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns the current user's account activity as a paginated, flat array ordered newest first. Only activity from boards the current user can access is included.
+
+__Query parameters:__
+
+| Parameter | Type | Description |
+|-----------|------|-------------|
+| `creator_ids[]` | array | Return activity created by these users. |
+| `board_ids[]` | array | Return activity from these boards. |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5v9zkft4hj9qq0lsn9ohde",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.401Z",
+    "description": "David assigned JZ to \"Fix the login page\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a7"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/42",
+    "eventable_type": "Card",
+    "eventable": {},
+    "board": {},
+    "creator": {}
+  }
+]
+```
+
+`eventable`, `board`, and `creator` use the same representations as the cards, comments, boards, and users API endpoints.
+
+Comment events link to the card containing the comment and include the comment anchor in `url`.
+
+`particulars` contains event-specific details:
+
+- Assignment changes: `assignee_ids`
+- Board changes: `old_board` and `new_board`
+- Title changes: `old_title` and `new_title`
+- Triage events: `column`
+
+Missing board, title, or column values are returned as empty strings. Other events return an empty object.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..3ec65c2
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,143 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns activities with API representations and required fields" do
+    get activities_path(format: :json)
+
+    assert_response :success
+
+    event = events(:logo_published)
+    activity = find_activity(event)
+
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url], activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal event.eventable.id, activity.dig("eventable", "id")
+    assert_equal event.eventable.title, activity.dig("eventable", "title")
+    assert_equal event.board.id, activity.dig("board", "id")
+    assert_equal event.creator.id, activity.dig("creator", "id")
+  end
+
+  test "comment activities link to the card with a comment anchor" do
+    get activities_path(format: :json)
+
+    assert_response :success
+
+    event = events(:layout_commented)
+    comment = event.eventable
+    activity = find_activity(event)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal card_comment_url(comment.card, comment), activity.dig("eventable", "url")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+  end
+
+  test "particulars expose details for supported events and default to empty values" do
+    events(:logo_published).update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Old board", "new_board" => "New board" } })
+    events(:layout_published).update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } })
+    events(:text_published).update_columns(action: "card_triaged", particulars: { "particulars" => { "column" => "In progress" } })
+    events(:shipping_published).update_columns(action: "card_title_changed", particulars: {})
+    events(:shipping_closed).update_columns(action: "card_board_changed", particulars: {})
+
+    get activities_path(format: :json)
+
+    assert_response :success
+
+    assert_equal [ users(:jz).id ], find_activity(events(:logo_assignment_jz))["particulars"]["assignee_ids"]
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, find_activity(events(:logo_published))["particulars"])
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, find_activity(events(:layout_published))["particulars"])
+    assert_equal({ "column" => "In progress" }, find_activity(events(:text_published))["particulars"])
+    assert_equal({ "column" => "" }, find_activity(events(:buy_domain_sent_back_to_triage))["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, find_activity(events(:shipping_published))["particulars"])
+    assert_equal({ "old_board" => "", "new_board" => "" }, find_activity(events(:shipping_closed))["particulars"])
+    assert_equal({}, find_activity(events(:layout_commented))["particulars"])
+  end
+
+  test "includes title changes and omits collection changes" do
+    title_event = events(:logo_published)
+    collection_event = events(:layout_published)
+    title_event.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } })
+    collection_event.update_columns(action: "card_collection_changed", particulars: {})
+
+    get activities_path(format: :json)
+
+    assert_response :success
+
+    activity_ids = @response.parsed_body.pluck("id")
+    assert_includes activity_ids, title_event.id
+    assert_not_includes activity_ids, collection_event.id
+  end
+
+  test "filters by creator and board" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ] }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id ] }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "only returns activity from boards accessible to the current user" do
+    private_event = Event.create!(board: boards(:private), creator: users(:kevin), eventable: cards(:logo), action: "card_published")
+
+    logout_and_sign_in_as :jz
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+  end
+
+  test "paginates newest activity first" do
+    25.times do |index|
+      Event.create!(
+        board: boards(:writebook),
+        creator: users(:david),
+        eventable: cards(:logo),
+        action: "card_published",
+        created_at: Time.current + index.seconds
+      )
+    end
+
+    expected_ids = Event.where(board: users(:kevin).boards, action: ActivitiesController::ACTIVITY_ACTIONS)
+      .order(created_at: :desc, id: :desc)
+      .pluck(:id)
+
+    actual_ids = []
+    next_page = activities_path(format: :json)
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator actual_ids.size, :>, 20
+  end
+
+  private
+    def find_activity(event)
+      @response.parsed_body.find { |activity| activity["id"] == event.id }
+    end
+
+    def next_page_from_link_header(link_header)
+      link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+    end
+end
