+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,40 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    set_page_and_extract_portion_from filtered_events
+    fresh_when etag: [ Current.user, @page.records, creator_ids, board_ids ]
+  end
+
+  private
+    def filtered_events
+      events = Event.preloaded
+        .where(board: Current.user.boards, action: ACTIVITY_ACTIONS)
+        .order(created_at: :desc, id: :desc)
+
+      events = events.where(creator_id: creator_ids) if creator_ids.any?
+      events = events.where(board_id: board_ids) if board_ids.any?
+      events
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
diff --git a/app/models/event.rb b/app/models/event.rb
index bbbf2a6..a18da4c 100644
--- a/app/models/event.rb
+++ b/app/models/event.rb
@@ -37,7 +37,35 @@ class Event < ApplicationRecord
     Event::Description.new(self, user)
   end
 
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: activity_assignee_ids }
+    when "card_board_changed"
+      { old_board: activity_particular("old_board"), new_board: activity_particular("new_board") }
+    when "card_title_changed"
+      { old_title: activity_particular("old_title"), new_title: activity_particular("new_title") }
+    when "card_triaged", "card_sent_back_to_triage"
+      { column: activity_particular("column") }
+    else
+      {}
+    end
+  end
+
   private
+    def activity_assignee_ids
+      ids = Array(assignee_ids).compact_blank
+      ids = Array(activity_particular("assignee_ids")).compact_blank if ids.empty?
+      ids
+    end
+
+    def activity_particular(key)
+      details = particulars || {}
+      nested_particulars = details["particulars"]
+      value = nested_particulars[key] if nested_particulars.is_a?(Hash)
+      value.presence || details[key].presence || ""
+    end
+
     def dispatch_webhooks
       Event::WebhookDispatchJob.perform_later(self)
     end
diff --git a/app/views/activities/index.json.jbuilder b/app/views/activities/index.json.jbuilder
new file mode 100644
index 0000000..10bc7e8
--- /dev/null
+++ b/app/views/activities/index.json.jbuilder
@@ -0,0 +1,25 @@
+json.array! @page.records do |event|
+  json.(event, :id, :action)
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text
+  json.particulars event.activity_particulars
+
+  if event.action.comment_created?
+    json.url card_url(event.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable))
+  else
+    json.url card_url(event.card)
+  end
+
+  json.eventable_type event.eventable_type
+  json.eventable do
+    case event.eventable
+    when Card
+      json.partial! "cards/card", card: event.eventable
+    when Comment
+      json.partial! "cards/comments/comment", comment: event.eventable
+    end
+  end
+
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
