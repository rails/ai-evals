@@ -0,0 +1,18 @@
+# Kamal reads these values when deploying. This file is safe to commit because
+# it only reads from your environment (or from an ignored local file).
+#
+# Generate a secret key base once and keep it in your password manager:
+#
+#   export SECRET_KEY_BASE="$(bin/rails secret)"
+#
+# Set the password for the SMTP account configured in config/deploy.yml:
+#
+#   export SMTP_PASSWORD="your-smtp-password"
+#
+# If you use Rails encrypted credentials, also uncomment the line below and
+# add RAILS_MASTER_KEY to env.secret in config/deploy.yml.
+#
+# RAILS_MASTER_KEY=$(cat config/master.key)
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+SMTP_PASSWORD=$SMTP_PASSWORD
