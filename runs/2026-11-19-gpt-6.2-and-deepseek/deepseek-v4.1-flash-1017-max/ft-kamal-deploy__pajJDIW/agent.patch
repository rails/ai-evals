diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..0cddada
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,67 @@
+# Single-server deployment for Fizzy.
+#
+# Before running `bin/kamal setup`, replace:
+#   * 192.0.2.1 with your server's SSH host or IP address
+#   * fizzy.example.com (both occurrences) with your hostname
+#   * the SMTP settings with those for your mail server
+#
+# Keep SECRET_KEY_BASE and SMTP_PASSWORD out of this file. They are supplied
+# through .kamal/secrets.
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - 192.0.2.1
+
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  healthcheck:
+    path: /up
+
+# Kamal starts a registry locally and forwards it to the server, so this
+# single-box deployment does not need a separate registry account.
+registry:
+  server: localhost:5555
+
+# Change this to arm64 if your server is ARM-based.
+builder:
+  arch: amd64
+
+env:
+  clear:
+    RAILS_ENV: production
+    APP_HOST: fizzy.example.com
+
+    # Run the Solid Queue supervisor and workers inside the same container as
+    # the web server. These limits keep the footprint appropriate for one box.
+    SOLID_QUEUE_IN_PUMA: true
+    WEB_CONCURRENCY: "1"
+    JOB_CONCURRENCY: "1"
+
+    # Outbound email settings. Fizzy uses email for magic-link sign-in.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_USERNAME: user@example.com
+    MAILER_FROM_ADDRESS: "Fizzy <noreply@example.com>"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+
+# SQLite databases and uploaded files all live under /rails/storage. The named
+# volume keeps them across container replacements and future deployments.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Keep the old and new fingerprinted assets available during a deploy.
+asset_path: /rails/public/assets
+
+# Allow time for the first boot to create and migrate the SQLite databases.
+deploy_timeout: 120
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
