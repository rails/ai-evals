diff --git a/app/controllers/cards/columns_controller.rb b/app/controllers/cards/columns_controller.rb
index 54a69f0..78dc4ef 100644
--- a/app/controllers/cards/columns_controller.rb
+++ b/app/controllers/cards/columns_controller.rb
@@ -1,8 +1,49 @@
 class Cards::ColumnsController < ApplicationController
+  before_action :set_card, only: :update
+
   def edit
     @card = Current.user.accessible_cards.find_by!(number: params[:card_id])
     @columns = @card.board.columns.sorted
 
     fresh_when etag: [ @card, @columns ]
   end
+
+  def update
+    move_card_to_target
+
+    respond_to do |format|
+      format.html { redirect_back_or_to @card }
+      format.json { head :no_content }
+      format.turbo_stream { head :no_content }
+    end
+  end
+
+  private
+    def set_card
+      @card = Current.user.accessible_cards.find_by!(number: params[:card_id])
+    end
+
+    def move_card_to_target
+      case target
+      when "maybe", "stream"
+        @card.send_back_to_triage
+      when "not_now", "not-now", "postponed"
+        @card.postpone
+      when "done", "closed", "closed-cards"
+        @card.close
+      when nil, ""
+        @card.send_back_to_triage
+      else
+        @card.triage_into(@card.board.columns.find(target))
+      end
+    end
+
+    def target
+      params[:column_id].presence ||
+        params.dig(:card, :column_id).presence ||
+        params[:status].presence ||
+        params.dig(:card, :status).presence ||
+        params[:location].presence ||
+        params[:destination].presence
+    end
 end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..1145228
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,197 @@
+import { Controller } from "@hotwired/stimulus"
+import { patch } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+const COLUMN_SELECTOR = "[data-drag-and-drop-target='column']"
+const CARD_SELECTOR = "[data-drag-and-drop-target='card']"
+const MOBILE_MEDIA_QUERY = "(max-width: 639px)"
+
+export default class extends Controller {
+  static targets = [ "card", "column" ]
+
+  connect() {
+    this.draggedCard = null
+    this.hoveredColumn = null
+    this.origin = null
+  }
+
+  dragStart(event) {
+    const card = event.target.closest(CARD_SELECTOR)
+
+    if (!card || this.#isMobile) {
+      event.preventDefault()
+      return
+    }
+
+    this.draggedCard = card
+    this.origin = {
+      parent: card.parentElement,
+      nextSibling: card.nextElementSibling
+    }
+
+    card.classList.add(DRAGGED_ITEM_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragEnter(event) {
+    this.dragOver(event)
+  }
+
+  dragOver(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFrom(event)
+
+    if (!column) {
+      this.#clearHighlight()
+      return
+    }
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    this.#highlight(column)
+    this.#autoScroll(event)
+  }
+
+  dragLeave(event) {
+    const column = this.#columnFrom(event)
+
+    if (column === this.hoveredColumn && !column.contains(event.relatedTarget)) {
+      this.#clearHighlight()
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFrom(event)
+    if (!column) return
+
+    event.preventDefault()
+
+    const card = this.draggedCard
+    const origin = this.origin
+    const sourceColumn = this.#columnFor(card)
+
+    this.#clearHighlight()
+
+    if (column === sourceColumn) return
+
+    if (!this.#moveToColumn(card, column)) return
+
+    this.#adjustCount(sourceColumn, -1)
+    this.#adjustCount(column, 1)
+    this.#persistMove(card, column, origin, sourceColumn)
+  }
+
+  dragEnd() {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove(DRAGGED_ITEM_CLASS)
+    }
+
+    this.#clearHighlight()
+    this.draggedCard = null
+    this.origin = null
+  }
+
+  #columnFrom(event) {
+    return event.target.closest(COLUMN_SELECTOR)
+  }
+
+  #columnFor(card) {
+    return card.closest(COLUMN_SELECTOR)
+  }
+
+  #moveToColumn(card, column) {
+    const list = column.querySelector(".cards__list")
+    if (!list) return false
+
+    list.prepend(card)
+    return true
+  }
+
+  async #persistMove(card, column, origin, sourceColumn) {
+    const url = card.dataset.dragAndDropMoveUrl
+    const columnId = column.dataset.dragAndDropColumnId || column.dataset.dragAndDropStatus
+
+    if (!url || !columnId) {
+      this.#restore(card, origin, sourceColumn, column)
+      return
+    }
+
+    card.setAttribute("aria-busy", "true")
+
+    try {
+      const response = await patch(url, { responseKind: "json", query: { column_id: columnId } })
+
+      if (response.statusCode >= 400) {
+        this.#restore(card, origin, sourceColumn, column)
+      }
+    } catch (error) {
+      this.#restore(card, origin, sourceColumn, column)
+      console.error("Failed to move card", error)
+    } finally {
+      card.removeAttribute("aria-busy")
+    }
+  }
+
+  #restore(card, origin, sourceColumn, destinationColumn) {
+    this.#adjustCount(sourceColumn, 1)
+    this.#adjustCount(destinationColumn, -1)
+
+    if (!origin?.parent?.isConnected) return
+
+    if (origin.nextSibling?.parentElement === origin.parent) {
+      origin.parent.insertBefore(card, origin.nextSibling)
+    } else {
+      origin.parent.append(card)
+    }
+  }
+
+  #adjustCount(column, amount) {
+    const counter = column?.querySelector(".cards__expander-count")
+    if (!counter || counter.textContent.trim().endsWith("+")) return
+
+    const currentCount = Number.parseInt(counter.textContent, 10)
+    if (Number.isNaN(currentCount)) return
+
+    const nextCount = Math.max(0, currentCount + amount)
+    counter.textContent = nextCount > 99 ? "99+" : String(nextCount)
+  }
+
+  #highlight(column) {
+    if (column === this.hoveredColumn) return
+
+    this.#clearHighlight()
+    column.classList.add(HOVER_CONTAINER_CLASS)
+    this.hoveredColumn = column
+  }
+
+  #clearHighlight() {
+    this.hoveredColumn?.classList.remove(HOVER_CONTAINER_CLASS)
+    this.hoveredColumn = null
+  }
+
+  #autoScroll(event) {
+    if (event.clientX <= 0) return
+
+    const bounds = this.element.getBoundingClientRect()
+    const edge = 60
+
+    if (event.clientX < bounds.left + edge) {
+      this.element.scrollBy({ left: -20 })
+    } else if (event.clientX > bounds.right - edge) {
+      this.element.scrollBy({ left: 20 })
+    }
+  }
+
+  get #isMobile() {
+    return window.matchMedia(MOBILE_MEDIA_QUERY).matches
+  }
+}
