+
+  test "destroying a page purges its uploaded files after background jobs run" do
+    page = pages(:welcome)
+
+    post action_text_markdown_uploads_url, params: {
+      record_gid: page.to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+
+    assert_response :success
+
+    upload = page.reload.body.uploads.attachments.last
+    blob = upload.blob
+    file_path = blob.service.path_for(blob.key)
+
+    assert File.exist?(file_path)
+
+    perform_enqueued_jobs do
+      page.leaf.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(upload.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(file_path)
