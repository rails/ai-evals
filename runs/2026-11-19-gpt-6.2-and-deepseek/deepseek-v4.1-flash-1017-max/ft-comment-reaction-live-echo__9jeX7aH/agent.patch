+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "create as turbo stream" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal "👍", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal @comment.reactions.last.id, @response.parsed_body["id"]
+    assert_equal "Great", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create with flat JSON params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "Nice" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Nice", @comment.reactions.last.content
+  end
+
+  test "create with content over 16 characters is rejected" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "x" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "index as JSON" do
+    @comment.reactions.create!(reacter: users(:david), content: "🎉")
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal 1, @response.parsed_body.size
+    assert_equal "🎉", @response.parsed_body.first["content"]
+  end
+
+  test "destroy own reaction" do
+    reaction = @comment.reactions.create!(reacter: users(:kevin), content: "Done")
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "cannot destroy another user's reaction" do
+    reaction = @comment.reactions.create!(reacter: users(:jz), content: "Done")
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..05943cb
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    @comment = comments(:logo_agreement_jz)
+    @reacter = users(:kevin)
+  end
+
+  test "valid with 16 characters" do
+    reaction = @comment.reactions.build(reacter: @reacter, content: "x" * 16)
+
+    assert reaction.valid?
+  end
+
+  test "invalid without content" do
+    reaction = @comment.reactions.build(reacter: @reacter, content: "")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "invalid with more than 16 characters" do
+    reaction = @comment.reactions.build(reacter: @reacter, content: "x" * 17)
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "belongs to a comment and a reacter" do
+    reaction = @comment.reactions.create!(reacter: @reacter, content: "👍")
+
+    assert_equal @comment, reaction.comment
+    assert_equal @reacter, reaction.reacter
+  end
+end
