diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..9dc6b2f
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,62 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_creatorship, only: :destroy
+  before_action :ensure_card_is_commentable, only: :create
+
+  def index
+    @reactions = @comment.reactions.chronologically.preload(:reacter)
+  end
+
+  def show
+  end
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params.merge(reacter: Current.user))
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { head :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..7c8afd3
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,66 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "reaction" ]
+
+  showForm(event) {
+    event?.preventDefault()
+
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+
+    this.formTarget.reset()
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  pickEmoji(event) {
+    const emoji = event.currentTarget.dataset.emoji
+    const nextValue = `${this.inputTarget.value}${emoji}`
+
+    if (nextValue.length <= this.inputTarget.maxLength) {
+      this.inputTarget.value = nextValue
+    }
+
+    this.inputTarget.focus()
+    this.inputTarget.dispatchEvent(new Event("input", { bubbles: true }))
+  }
+
+  toggleDelete(event) {
+    if (event.target.closest(".reaction__delete")) return
+
+    const reaction = event.currentTarget
+
+    if (this.#isOwn(reaction)) {
+      const expanded = reaction.classList.toggle("expanded")
+      const deleteControl = reaction.querySelector(".reaction__delete")
+
+      reaction.setAttribute("aria-expanded", expanded)
+      if (expanded) {
+        deleteControl.style.display = "grid"
+      } else {
+        deleteControl.style.removeProperty("display")
+      }
+    }
+  }
+
+  reactionTargetConnected(reaction) {
+    if (this.#isOwn(reaction)) {
+      reaction.setAttribute("role", "button")
+      reaction.setAttribute("tabindex", "0")
+      reaction.setAttribute("aria-expanded", "false")
+    }
+  }
+
+  #isOwn(reaction) {
+    return reaction.dataset.creatorId === window.Current?.user?.id
+  }
+}
