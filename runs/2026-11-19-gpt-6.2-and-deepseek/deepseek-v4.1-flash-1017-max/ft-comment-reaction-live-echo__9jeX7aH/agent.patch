+
+  setup do
+    sign_in_as users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "adding and removing a reaction" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "👍"
+      click_on "Add reaction"
+
+      assert_selector ".reaction", text: "👍"
+      assert_selector ".reactions__trigger:not([hidden])"
+    end
+
+    within "##{dom_id(@comment)}" do
+      find(".reaction", text: "👍").click
+      click_on "Remove your reaction"
+    end
+
+    within "##{dom_id(@comment)}" do
+      assert_no_selector ".reaction", text: "👍"
+    end
+  end
+
+  test "canceling the form and picking an emoji" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      click_on "Add a reaction"
+      click_on "Cancel reaction"
+      assert_no_selector ".reaction__form:not([hidden])"
+
+      click_on "Add a reaction"
+      click_on "Choose an emoji"
+      click_on "🎉"
+
+      assert_equal "🎉", find(".reaction__input").value
+    end
+  end
+
+  test "reactions broadcast to other viewers" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    @comment.reactions.create!(reacter: users(:jz), content: "Live")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within "##{dom_id(@comment)}" do
+      assert_selector ".reaction", text: "Live", wait: 5
+    end
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
