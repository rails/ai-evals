diff --git a/test/models/webhook/flow_test.rb b/test/models/webhook/flow_test.rb
new file mode 100644
index 0000000..5ff7b18
--- /dev/null
+++ b/test/models/webhook/flow_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Webhook::FlowTest < ActiveJob::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @board = @webhook.board
+    @card = cards(:logo)
+    @creator = users(:david)
+  end
+
+  test "event relays a single signed POST and records the delivery" do
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "")
+
+    event = nil
+    perform_enqueued_jobs do
+      event = @board.events.create!(action: "card_published", creator: @creator, eventable: @card)
+    end
+
+    assert_performed_with(job: Event::RelayJob, args: [ event ])
+    delivery = @webhook.deliveries.find_by!(event: event)
+    assert delivery.completed?, delivery.attributes.inspect
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+
+    assert_requested(:post, @webhook.url, times: 1) do |request|
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal "fizzy/1.0.0 Webhook", request.headers["User-Agent"]
+      assert_equal event.created_at.utc.iso8601, request.headers["X-Webhook-Timestamp"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body),
+        request.headers["X-Webhook-Signature"]
+
+      payload = JSON.parse(request.body)
+      assert_equal event.id, payload["id"]
+      assert_equal "card_published", payload["action"]
+    end
+  end
+
+  test "delivering the same delivery twice only sends one POST" do
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "")
+    event = @board.events.create!(action: "card_published", creator: @creator, eventable: @card)
+    delivery = @webhook.deliver(event)
+
+    Webhook::DeliveryJob.perform_now(delivery)
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert_requested :post, @webhook.url, times: 1
+  end
+
+  test "ten failures within an hour deactivate the webhook" do
+    stub_request(:post, @webhook.url).to_return(status: 500, body: "")
+
+    10.times do
+      event = @board.events.create!(action: "card_published", creator: @creator, eventable: @card)
+      Webhook::DeliveryJob.perform_now(@webhook.deliver(event))
+    end
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "a successful delivery resets consecutive failures" do
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "")
+    tracker = @webhook.ensure_delinquency_tracker
+
+    9.times do
+      event = @board.events.create!(action: "card_published", creator: @creator, eventable: @card)
+      Webhook::DeliveryJob.perform_now(@webhook.deliver(event))
+    end
+    assert @webhook.reload.active?
+
+    event = @board.events.create!(action: "card_published", creator: @creator, eventable: @card)
+    Webhook::DeliveryJob.perform_now(@webhook.deliver(event))
+
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "failures outside the one hour window do not accumulate" do
+    tracker = @webhook.ensure_delinquency_tracker
+    tracker.update!(consecutive_failures_count: 9, first_failure_at: 2.hours.ago)
+
+    tracker.record_failure
+
+    assert_equal 1, tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "connection errors are logged and count as failures" do
+    stub_request(:post, @webhook.url).to_raise(SocketError)
+    event = @board.events.create!(action: "card_published", creator: @creator, eventable: @card)
+    delivery = @webhook.deliver(event)
+
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_equal 1, @webhook.ensure_delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "cleanup keeps one week of deliveries" do
+    recent = webhook_deliveries(:pending)
+    recent.update_columns(created_at: 6.days.ago)
+    old = webhook_deliveries(:successfully_completed)
+    old.update_columns(created_at: 8.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert Webhook::Delivery.exists?(recent.id)
+    assert_not Webhook::Delivery.exists?(old.id)
+  end
+end
