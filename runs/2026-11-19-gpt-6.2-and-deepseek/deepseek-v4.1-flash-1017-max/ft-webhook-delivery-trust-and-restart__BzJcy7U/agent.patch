diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..346f282
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,44 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure
+    with_lock do
+      if first_failure_at.nil? || first_failure_at < FAILURE_WINDOW.ago
+        update!(consecutive_failures_count: 1, first_failure_at: Time.current)
+      else
+        increment!(:consecutive_failures_count)
+      end
+
+      webhook.deactivate if consecutive_failures_count >= FAILURE_THRESHOLD
+    end
+  end
+
+  def record_success
+    with_lock do
+      update!(consecutive_failures_count: 0, first_failure_at: nil) unless reset?
+    end
+  end
+
+  def reset
+    with_lock do
+      update!(consecutive_failures_count: 0, first_failure_at: nil) unless reset?
+    end
+  end
+
+  alias_method :record_failure!, :record_failure
+  alias_method :record_success!, :record_success
+  alias_method :track_failure, :record_failure
+  alias_method :track_success, :record_success
+  alias_method :failure!, :record_failure
+  alias_method :success!, :record_success
+  alias_method :reset!, :reset
+
+  private
+    def reset?
+      consecutive_failures_count.zero? && first_failure_at.nil?
+    end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
index 4ecfeb8..58c6f66 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -9,6 +9,31 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where(created_at: ...1.week.ago) }
+
+  class << self
+    def cleanup
+      stale.delete_all
+    end
+  end
+
+  def deliver
+    payload = payload_for_event
+    headers = request_headers(payload)
+
+    with_lock do
+      return unless pending?
+
+      update!(state: :in_progress, request: { headers: headers })
+    end
+
+    response = post(payload, headers)
+    complete(response.code.to_i)
+  rescue => error
+    fail_with(error)
+  end
+
+  alias_method :deliver_now, :deliver
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -27,6 +52,62 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response.present? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def payload_for_event
+      ApplicationController.renderer.render(template: "webhooks/event", assigns: { event: event }, formats: :json)
+    end
+
+    def request_headers(payload)
+      {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+      }
+    end
+
+    def post(payload, headers)
+      uri = URI.parse(webhook.url)
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = payload
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = 5
+      http.read_timeout = 5
+      http.start { |connection| connection.request(request) }
+    end
+
+    def complete(code)
+      update!(state: :completed, response: { code: code, error: nil })
+
+      if code.between?(200, 299)
+        delinquency_tracker.record_success
+      else
+        delinquency_tracker.record_failure
+      end
+    end
+
+    def fail_with(error)
+      update!(state: :errored, response: { error: error_code_for(error) })
+
+      delinquency_tracker.record_failure
+    end
+
+    def delinquency_tracker
+      webhook.ensure_delinquency_tracker
+    end
+
+    def error_code_for(error)
+      case error
+      when SocketError, Timeout::Error, Errno::ECONNREFUSED, Errno::ECONNRESET, Errno::EHOSTUNREACH,
+           Errno::ENETUNREACH, OpenSSL::SSL::SSLError, Net::OpenTimeout, Net::ReadTimeout
+        "destination_unreachable"
+      else
+        error.class.name
+      end
+    end
 end
