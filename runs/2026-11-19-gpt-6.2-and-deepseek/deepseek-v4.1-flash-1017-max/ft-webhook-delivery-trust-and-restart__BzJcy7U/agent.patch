+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    board.webhooks.active.select { |webhook| webhook.subscribed_actions.include?(action.to_s) }.each do |webhook|
+      webhook.deliver_later(self)
+    end
+  end
+end
