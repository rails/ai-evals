index 0000000..35ad579
--- /dev/null
+++ b/test/controllers/cards/stalled_controller_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Cards::StalledControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "lists stalled cards" do
+    stalled_card = cards(:logo)
+    stalled_card.update_columns burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago
+
+    get cards_path(indexed_by: "stalled")
+
+    assert_response :success
+    assert_select "##{dom_id(stalled_card, :article)}"
+    assert_select "##{dom_id(cards(:text), :article)}", count: 0
+  end
+
+  test "renders the stalled bubble" do
+    card = cards(:logo)
+    card.update_columns burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago
+
+    get cards_path(indexed_by: "stalled")
+
+    assert_select "##{dom_id(card, "bubble")}[data-bubble-entropy-value*='stalledAt']", text: /Stalled/
+  end
+
+  test "includes stalled in the JSON representation" do
+    card = cards(:logo)
+    card.update_columns burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago
+
+    get cards_path(format: :json, indexed_by: "stalled")
+
+    assert_response :success
+    assert @response.parsed_body.any? { |json| json["id"] == card.id && json["stalled"] }
+  end
+end
diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..98043ef
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "bursts when three comments from two people land within a third of the auto-close period" do
+    freeze_time
+    card = create_card
+
+    card.comments.create! body: "First", creator: users(:david)
+    card.comments.create! body: "Second", creator: users(:kevin)
+    card.comments.create! body: "Third", creator: users(:david)
+
+    assert_predicate card.reload, :burst?
+  end
+
+  test "does not burst when all comments are from the same person" do
+    freeze_time
+    card = create_card
+
+    3.times { card.comments.create! body: "Same person", creator: users(:david) }
+
+    assert_not_predicate card.reload, :burst?
+  end
+
+  test "does not burst when comments fall outside the burst window" do
+    freeze_time
+    card = create_card
+
+    3.times do |index|
+      card.comments.create! body: "Old #{index}", creator: index.even? ? users(:david) : users(:kevin), created_at: 31.days.ago
+    end
+
+    assert_not_predicate card.reload, :burst?
+  end
+
+  test "bursts when assigned" do
+    card = cards(:text)
+
+    card.toggle_assignment users(:david)
+
+    assert_predicate card.reload, :burst?
+  end
+
+  test "bursts when reopened" do
+    card = cards(:shipping)
+
+    card.reopen
+
+    assert_predicate card.reload, :burst?
+  end
+
+  test "is stalled after two weeks without activity following a burst" do
+    freeze_time
+    card = create_bursting_card
+
+    travel 2.weeks
+    card.reload
+
+    assert_predicate card, :stalled?
+    assert_includes Card.stalled, card
+    assert_includes Card.indexed_by("stalled"), card
+  end
+
+  test "activity resets the stall clock" do
+    freeze_time
+    card = create_bursting_card
+
+    travel 10.days
+    card.comments.create! body: "Still paying attention", creator: users(:kevin)
+    card.reload
+
+    travel 13.days
+    assert_not_predicate card.reload, :stalled?
+
+    travel 1.day
+    assert_predicate card.reload, :stalled?
+  end
+
+  private
+    def create_card
+      boards(:writebook).cards.create! title: "Bursting card", creator: users(:david), status: :published
+    end
+
+    def create_bursting_card
+      create_card.tap do |card|
+        card.comments.create! body: "First", creator: users(:david)
+        card.comments.create! body: "Second", creator: users(:kevin)
+        card.comments.create! body: "Third", creator: users(:david)
+        assert_predicate card.reload, :burst?
+      end
+    end
+end
