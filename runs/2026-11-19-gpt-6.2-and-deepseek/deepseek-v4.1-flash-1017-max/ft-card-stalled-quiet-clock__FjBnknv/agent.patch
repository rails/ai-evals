diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..c0b84b4
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,42 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  BURST_WINDOW_DIVISOR = 3
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> { where.not(burst_at: nil).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def stalled?
+    burst? && last_active_at <= STALL_PERIOD.ago
+  end
+
+  def stalled_at
+    last_active_at + STALL_PERIOD if burst?
+  end
+
+  def burst!
+    update! burst_at: Time.current
+  end
+
+  def detect_burst!
+    if !burst? && comment_burst?
+      burst!
+    end
+  end
+
+  private
+    def comment_burst?
+      recent_comments = comments.by_user.where(created_at: (Time.current - burst_window)..)
+      recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+    end
+
+    def burst_window
+      board.auto_postpone_period / BURST_WINDOW_DIVISOR
+    end
+end
