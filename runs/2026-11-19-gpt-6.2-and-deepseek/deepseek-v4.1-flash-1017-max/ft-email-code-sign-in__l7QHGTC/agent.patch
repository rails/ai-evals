+require "test_helper"
+
+class EmailSignInFlowTest < ActionDispatch::IntegrationTest
+  test "signs in with an emailed code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      request_code { post session_path, params: { email_address: identity.email_address } }
+
+      assert_redirected_to new_session_magic_link_path(script_name: nil)
+      code = emailed_code
+
+      assert_difference -> { identity.sessions.count }, 1 do
+        post session_magic_link_path(script_name: nil), params: { code: code }
+      end
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "renders a code entry form that posts code" do
+    untenanted do
+      get new_session_magic_link_path(script_name: nil)
+
+      assert_response :success
+      assert_in_body "name=\"code\""
+    end
+  end
+
+test "rejects invalid email addresses without sending code" do
+  untenanted do
+    assert_no_emails do
+      post session_path, params: { email_address: "not-an-email" }
+    end
+
+    assert_response :unprocessable_entity
+  end
+end
+
+  test "supports the JSON API" do
+    identity = identities(:kevin)
+
+    untenanted do
+      request_code { post session_path(format: :json), params: { email_address: identity.email_address } }
+
+      assert_response :created
+      token = @response.parsed_body["pending_authentication_token"]
+      assert token.present?
+
+      post session_magic_link_path(format: :json, script_name: nil),
+        params: { code: emailed_code, pending_authentication_token: token }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "a code can only be used once" do
+    identity = identities(:kevin)
+
+    untenanted do
+      request_code { post session_path, params: { email_address: identity.email_address } }
+      token = cookies[:pending_authentication_token]
+      code = emailed_code
+
+      post session_magic_link_path(script_name: nil), params: { code: code }
+      assert cookies[:session_token].present?
+
+      reset!
+      post session_magic_link_path(script_name: nil),
+        params: { code: code, pending_authentication_token: token }
+
+      assert_redirected_to new_session_magic_link_path(script_name: nil)
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "signs up with an emailed code" do
+    email_address = "new-signup@example.com"
+
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        request_code { post signup_path, params: { signup: { email_address: email_address } } }
+      end
+
+      assert_redirected_to new_session_magic_link_path(script_name: nil)
+      code = emailed_code
+
+      post session_magic_link_path(script_name: nil), params: { code: code }
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+      assert Identity.exists?(email_address: email_address)
+    end
+  end
+
+  test "completes signup after entering the code" do
+    email_address = "new-signup-complete@example.com"
+
+    untenanted do
+      request_code { post signup_path, params: { signup: { email_address: email_address } } }
+      post session_magic_link_path(script_name: nil), params: { code: emailed_code }
+
+      assert_redirected_to new_signup_completion_path
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path(script_name: nil), params: { signup: { full_name: "New Person" } }
+      end
+
+      identity = Identity.find_by!(email_address: email_address)
+      account = identity.accounts.last
+      assert_redirected_to landing_url(script_name: account.slug)
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "joins an account with an emailed code" do
+    account = accounts("37s")
+    join_code = account_join_codes("37s")
+    email_address = "new-joiner@example.com"
+
+    assert_difference -> { Identity.count }, 1 do
+      request_code { post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address } }
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+    code = emailed_code
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        post session_magic_link_path(script_name: nil), params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_users_join_url(script_name: account.slug)
+    user = User.find_by!(account: account, identity: Identity.find_by!(email_address: email_address))
+    assert user.verified?
+    assert_equal 1, join_code.reload.usage_count
+  end
+
+  test "rejects expired codes" do
+    identity = identities(:kevin)
+
+    untenanted do
+      request_code { post session_path, params: { email_address: identity.email_address } }
+      code = emailed_code
+
+      travel 16.minutes do
+        post session_magic_link_path(script_name: nil), params: { code: code }
+      end
+
+      assert_redirected_to new_session_magic_link_path(script_name: nil)
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "rejects invalid codes" do
+    identity = identities(:kevin)
+
+    untenanted do
+      request_code { post session_path, params: { email_address: identity.email_address } }
+      post session_magic_link_path(script_name: nil), params: { code: "BADCODE" }
+
+      assert_redirected_to new_session_magic_link_path(script_name: nil)
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  private
+    def request_code(&)
+      assert_emails 1 do
+        perform_enqueued_jobs(&)
+      end
+    end
+
+    def emailed_code
+      ActionMailer::Base.deliveries.last.subject[/([A-Z0-9]{6})\b/, 1]
+    end
+end
