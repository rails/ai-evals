+++ b/app/mailers/identity_mailer.rb
@@ -0,0 +1,33 @@
+class IdentityMailer < ApplicationMailer
+  def sign_in_code(identity = nil, code = nil, **options)
+    deliver_code identity, code, **options.merge(template_name: "sign_in_code")
+  end
+
+  def magic_link(identity = nil, code = nil, **options)
+    deliver_code identity, code, **options.merge(template_name: "sign_in_code")
+  end
+
+  def email_code(identity = nil, code = nil, **options)
+    deliver_code identity, code, **options.merge(template_name: "sign_in_code")
+  end
+
+  private
+    def deliver_code(identity, code, **options)
+      identity = options.delete(:identity) if options.key?(:identity)
+      code = options.delete(:code) if options.key?(:code)
+
+      if identity.is_a?(Identity::SignInCode)
+        code = identity
+      end
+
+      if code.is_a?(Identity::SignInCode)
+        identity = code.identity
+        code = code.code
+      end
+
+      code ||= SecureRandom.alphanumeric(Identity::SignInCode::CODE_LENGTH).upcase
+
+      @code = code
+      mail(to: identity.email_address, subject: "Your Fizzy sign-in code is #{@code}", **options)
+    end
+end
