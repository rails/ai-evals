new file mode 100644
index 0000000..3a049ff
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,118 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if sign_in_code = pending_sign_in_code
+      if sign_in_code.identity && sign_in_code.verify(params[:code])
+        complete_authentication sign_in_code
+      else
+        invalid_code
+      end
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def pending_sign_in_code
+      if token = pending_authentication_token
+        Identity::SignInCode.find_signed(token, purpose: :pending_authentication)
+      end
+    end
+
+    def complete_authentication(sign_in_code)
+      identity = sign_in_code.identity
+
+      clear_pending_authentication_token
+      start_new_session_for identity
+      verify_identity identity
+
+      case sign_in_code.purpose
+      when "sign_up"
+        redirect_to_signup_completion
+      when "join"
+        complete_join sign_in_code
+      else
+        redirect_after_sign_in
+      end
+    end
+
+    def verify_identity(identity)
+      identity.users.find_each(&:verify)
+    end
+
+    def redirect_to_signup_completion
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def complete_join(sign_in_code)
+      if join_code = sign_in_code.join_code
+        account = join_code.account
+        join_code.redeem_if { |account| sign_in_code.identity.join(account) }
+
+        if user = User.active.find_by(account: account, identity: sign_in_code.identity)
+          user.verify
+          redirect_to_join_completion account, user
+        else
+          redirect_to_join_error
+        end
+      else
+        redirect_to_join_error
+      end
+    end
+
+    def redirect_to_join_completion(account, user)
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: account.slug)
+          else
+            redirect_to new_users_join_url(script_name: account.slug)
+          end
+        end
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def redirect_to_join_error
+      respond_to do |format|
+        format.html { redirect_to session_menu_path(script_name: nil), alert: "That join code is no longer available." }
+        format.json { render json: { message: "That join code is no longer available." }, status: :unprocessable_entity }
+      end
+    end
+
+    def redirect_after_sign_in
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
