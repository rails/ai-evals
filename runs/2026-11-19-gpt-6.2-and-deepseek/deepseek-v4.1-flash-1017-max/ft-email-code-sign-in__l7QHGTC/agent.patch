diff --git a/app/models/identity/sign_in_code.rb b/app/models/identity/sign_in_code.rb
new file mode 100644
index 0000000..47ee6d1
--- /dev/null
+++ b/app/models/identity/sign_in_code.rb
@@ -0,0 +1,62 @@
+class Identity::SignInCode < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_EXPIRATION = 15.minutes
+  EXPIRATION = CODE_EXPIRATION
+
+  belongs_to :identity
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  attribute :purpose, :string, default: "sign_in"
+
+  enum :purpose, { sign_in: "sign_in", sign_up: "sign_up", join: "join" }, prefix: true
+
+  scope :active, -> { where(used_at: nil).where("expires_at > ?", Time.current) }
+
+  before_create :generate_code
+  before_create :set_expires_at
+
+  def sign_in?
+    purpose == "sign_in"
+  end
+
+  def sign_up?
+    purpose == "sign_up"
+  end
+
+  def join?
+    purpose == "join"
+  end
+
+  def active?
+    used_at.nil? && expires_at.present? && expires_at.future?
+  end
+
+  def expired?
+    expires_at.present? && expires_at <= Time.current
+  end
+
+  def verify(candidate)
+    if active? && secure_compare(candidate)
+      update!(used_at: Time.current)
+    else
+      false
+    end
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def set_expires_at
+      self.expires_at ||= CODE_EXPIRATION.from_now
+    end
+
+    def secure_compare(candidate)
+      candidate = candidate.to_s.strip.upcase
+      candidate.bytesize == code.bytesize && ActiveSupport::SecurityUtils.secure_compare(code, candidate)
+    end
+end
