diff --git a/test/controllers/leafables_being_edited_broadcast_test.rb b/test/controllers/leafables_being_edited_broadcast_test.rb
new file mode 100644
index 0000000..80205bc
--- /dev/null
+++ b/test/controllers/leafables_being_edited_broadcast_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class LeafablesBeingEditedBroadcastTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:handbook)
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "being edited indicator is not broadcast to a collaborator who was removed from the book" do
+    removed_user = users(:jz)
+    @book.access_for(user: removed_user).update!(level: :editor)
+
+    sign_in removed_user
+    get edit_book_page_path(@book, @leaf)
+    assert_response :success
+    removed_user_stream = stream_name_from(response)
+
+    @book.access_for(user: removed_user).destroy!
+
+    sign_in :jason
+    get edit_book_page_path(@book, @leaf)
+    assert_response :success
+    other_editor_stream = stream_name_from(response)
+
+    sign_in :kevin
+    get edit_book_page_path(@book, @leaf)
+    assert_response :success
+    editor_stream = stream_name_from(response)
+
+    assert_broadcasts(editor_stream, 1) do
+      assert_broadcasts(other_editor_stream, 1) do
+        assert_no_broadcasts(removed_user_stream) do
+          perform_enqueued_jobs do
+            patch book_page_path(@book, @leaf, format: :turbo_stream),
+              params: { page: { body: "An update" }, leaf: { title: @leaf.title } }
+          end
+        end
+      end
+    end
+  end
+
+  private
+    def stream_name_from(response)
+      signed_stream_name = css_select("turbo-cable-stream-source").first["signed-stream-name"]
+      Turbo.signed_stream_verifier.verified(signed_stream_name)
+    end
+end
