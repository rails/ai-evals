diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..7103f10
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:initech)
+    @account.cancel(initiated_by: users(:mike))
+    @account.cancellation.update_column(:created_at, 31.days.ago)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    user_ids = @account.users.ids
+    board_ids = @account.boards.ids
+    card_ids = @account.cards.ids
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_empty User.where(id: user_ids)
+    assert_empty Board.where(id: board_ids)
+    assert_empty Card.where(id: card_ids)
+    assert_not Account::Cancellation.exists?(account_id: @account.id)
+  end
+
+  test "incinerates all account data including attachments" do
+    card = @account.cards.first
+    Current.with_account(@account) do
+      card.image.attach(io: StringIO.new("test image data"), filename: "image.png", content_type: "image/png")
+    end
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@account.id)
+    assert_empty ActiveStorage::Attachment.where(account_id: @account.id)
+    assert_empty ActiveStorage::Blob.where(account_id: @account.id)
+    assert_empty account_scoped_rows(@account.id)
+  end
+
+  test "keeps accounts cancelled 30 days ago or less" do
+    @account.cancellation.update_column(:created_at, 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "keeps active accounts" do
+    @account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  private
+    def account_scoped_rows(account_id)
+      ActiveRecord::Base.connection.tables.filter_map do |table|
+        next unless ActiveRecord::Base.connection.columns(table).any? { |column| column.name == "account_id" }
+
+        model = Class.new(ActiveRecord::Base) do
+          self.table_name = table
+          self.inheritance_column = nil
+        end
+        count = model.where(account_id: account_id).count
+        [ table, count ] if count.positive?
+      end
+    end
+end
