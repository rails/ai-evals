diff --git a/app/controllers/application_controller.rb b/app/controllers/application_controller.rb
index 87c3ab8..dd31433 100644
--- a/app/controllers/application_controller.rb
+++ b/app/controllers/application_controller.rb
@@ -6,8 +6,45 @@ class ApplicationController < ActionController::Base
   include RequestForgeryProtection
   include TurboFlash, ViewTransitions
   include RoutingHeaders
+  include TranslationHelper
 
-  etag { "v1" }
+  before_action :set_locale
+
+  etag { "v1-#{I18n.locale}" }
   stale_when_importmap_changes
   allow_browser versions: :modern
+
+  private
+    def set_locale
+      requested_locale = params[:locale].to_s
+
+      if offered_locale?(requested_locale)
+        session[:locale] = requested_locale
+        Current.identity.update_column(:locale, requested_locale) if Current.identity
+      end
+
+      if Current.identity
+        if offered_locale?(Current.identity.locale.to_s)
+          session[:locale] = Current.identity.locale
+        elsif offered_locale?(session[:locale].to_s)
+          Current.identity.update_column(:locale, session[:locale])
+        end
+      end
+
+      I18n.locale = locale_from_session || locale_from_identity || I18n.default_locale
+    end
+
+    def locale_from_session
+      locale = session[:locale].to_s
+      locale if offered_locale?(locale)
+    end
+
+    def locale_from_identity
+      locale = Current.identity&.locale.to_s
+      locale if offered_locale?(locale)
+    end
+
+    def offered_locale?(locale)
+      locale.in?(I18n.available_locales.map(&:to_s))
+    end
 end
