diff --git a/app/helpers/translation_helper.rb b/app/helpers/translation_helper.rb
new file mode 100644
index 0000000..959beb4
--- /dev/null
+++ b/app/helpers/translation_helper.rb
@@ -0,0 +1,46 @@
+module TranslationHelper
+  DYNAMIC_TRANSLATIONS = [
+    [ /\ADownload (.+)\z/, '\1をダウンロード' ],
+    [ /\AJoin (.+) in Fizzy\z/, 'Fizzyの\1に参加' ],
+    [ /\AProfile avatar for (.+)\z/, '\1のプロフィールアバター' ],
+    [ /\AWhich cards are assigned to (.+)\?\z/, '\1に割り当てられたカード' ],
+    [ /\AWhich cards were added by (.+)\?\z/, '\1が追加したカード' ],
+    [ /\AColumn: (.+)\z/, 'カラム: \1' ],
+    [ /\A(.+) reacted (.+)\z/, '\1が\2でリアクションしました' ],
+    [ /\ASave changes \((.+)\)\z/, '変更を保存（\1）' ],
+    [ /\ACancel \((.+)\)\z/, 'キャンセル（\1）' ],
+    [ /\ACreate card \((.+)\)\z/, 'カードを作成（\1）' ],
+    [ /\ACreate and add another \((.+)\)\z/, '作成してもう1枚追加（\1）' ],
+    [ /\APost this comment \((.+)\)\z/, 'このコメントを投稿（\1）' ]
+  ].freeze
+
+  def translate(text, **options)
+    unless I18n.locale.to_s == "ja"
+      return options.any? ? I18n.interpolate(text, options) : text
+    end
+
+    translation = translations[text] || translations[text.to_sym]
+
+    if translation.nil?
+      DYNAMIC_TRANSLATIONS.each do |pattern, replacement|
+        if text.match?(pattern)
+          translation = text.sub(pattern, replacement)
+          break
+        end
+      end
+    end
+
+    if translation
+      options.any? ? I18n.interpolate(translation, options) : translation
+    elsif options.any?
+      I18n.interpolate(text, options)
+    else
+      text
+    end
+  end
+
+  private
+    def translations
+      @translations ||= I18n.t("app", locale: :ja, default: {})
+    end
+end
