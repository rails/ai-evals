+    end
+
+    post "accounts/:account_id/uncomp", to: "comps#destroy", as: :account_uncomp
+    delete "accounts/:account_id/uncomp", to: "comps#destroy"
+    post "accounts/:account_id/reset", to: "overrides#destroy", as: :account_reset
+    delete "accounts/:account_id/reset", to: "overrides#destroy"
   end
 end
