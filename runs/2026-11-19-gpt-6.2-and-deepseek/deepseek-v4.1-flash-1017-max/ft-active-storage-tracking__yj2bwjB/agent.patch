+++ b/app/jobs/storage_usage_job.rb
@@ -0,0 +1,32 @@
+class StorageUsageJob < ApplicationJob
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account_id: nil, board_id: nil, bytes: nil)
+    if bytes
+      adjust(account_id:, board_id:, bytes:)
+    else
+      recalculate(account_id:, board_id:)
+    end
+  end
+
+  private
+    def adjust(account_id:, board_id:, bytes:)
+      Account.transaction do
+        Account.where(id: account_id).update_counters(bytes_used: bytes)
+        Board.where(id: board_id).update_counters(bytes_used: bytes) if board_id.present?
+      end
+    end
+
+    def recalculate(account_id:, board_id:)
+      if account_id
+        if account = Account.find_by(id: account_id)
+          account.update_column(:bytes_used, StorageUsage.bytes_for_account(account))
+        end
+      elsif board_id
+        if board = Board.find_by(id: board_id)
+          board.update_column(:bytes_used, StorageUsage.bytes_for_board(board))
+        end
+      end
+    end
+end
