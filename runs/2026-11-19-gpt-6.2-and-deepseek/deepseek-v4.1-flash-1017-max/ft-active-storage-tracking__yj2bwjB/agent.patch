diff --git a/app/models/concerns/storage_usage_trackable.rb b/app/models/concerns/storage_usage_trackable.rb
new file mode 100644
index 0000000..a3a2648
--- /dev/null
+++ b/app/models/concerns/storage_usage_trackable.rb
@@ -0,0 +1,80 @@
+module StorageUsageTrackable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :track_storage_usage_addition
+    before_destroy :capture_storage_usage_removal
+    after_destroy_commit :track_storage_usage_removal
+  end
+
+  def delete
+    usage = storage_usage_snapshot
+    super.tap do |deleted|
+      track_storage_usage(usage, bytes: -usage[:bytes]) if deleted && usage
+    end
+  end
+
+  private
+    def track_storage_usage_addition
+      if usage = storage_usage_snapshot
+        track_storage_usage(usage, bytes: usage[:bytes])
+      end
+    end
+
+    def capture_storage_usage_removal
+      @storage_usage_removal = storage_usage_snapshot
+    end
+
+    def track_storage_usage_removal
+      if usage = @storage_usage_removal
+        track_storage_usage(usage, bytes: -usage[:bytes])
+        @storage_usage_removal = nil
+      end
+    end
+
+    def storage_usage_snapshot
+      if owner = storage_usage_owner
+        { **owner, bytes: blob&.byte_size.to_i }
+      end
+    end
+
+    def storage_usage_owner
+      case record_type
+      when "Card"
+        if name == "image"
+          storage_usage_owner_for_card(Card.find_by(id: record_id))
+        end
+      when "ActionText::RichText"
+        if name == "embeds"
+          storage_usage_owner_for_rich_text(ActionText::RichText.find_by(id: record_id))
+        end
+      end
+    end
+
+    def storage_usage_owner_for_rich_text(rich_text)
+      case rich_text&.record_type
+      when "Board"
+        if rich_text.name == "public_description" && board = Board.find_by(id: rich_text.record_id)
+          { account_id: board.account_id, board_id: board.id }
+        end
+      when "Card"
+        if rich_text.name == "description"
+          storage_usage_owner_for_card(Card.find_by(id: rich_text.record_id))
+        end
+      when "Comment"
+        if rich_text.name == "body" && comment = Comment.find_by(id: rich_text.record_id)
+          storage_usage_owner_for_card(comment.card)
+        end
+      end
+    end
+
+    def storage_usage_owner_for_card(card)
+      if card
+        { account_id: card.account_id, board_id: card.board_id }
+      end
+    end
+
+    def track_storage_usage(usage, bytes:)
+      StorageUsageJob.perform_later(account_id: usage[:account_id], board_id: usage[:board_id], bytes:)
+    end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..0e3c129
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,37 @@
+class StorageUsage
+  class << self
+    def bytes_for_board(board)
+      attachments_for_board(board).joins(:blob).sum("active_storage_blobs.byte_size")
+    end
+
+    def bytes_for_account(account)
+      attachments_for_account(account).joins(:blob).sum("active_storage_blobs.byte_size")
+    end
+
+    private
+      def attachments_for_board(board)
+        card_ids = board.cards.select(:id)
+        rich_text_ids = ActionText::RichText.where(record_type: "Board", record_id: board.id, name: "public_description").select(:id)
+          .or(ActionText::RichText.where(record_type: "Card", record_id: card_ids, name: "description").select(:id))
+          .or(ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card_id: card_ids).select(:id), name: "body").select(:id))
+
+        attachments_for(card_ids:, rich_text_ids:)
+      end
+
+      def attachments_for_account(account)
+        card_ids = account.cards.select(:id)
+        rich_text_ids = ActionText::RichText.where(account_id: account.id, record_type: "Board", name: "public_description").select(:id)
+          .or(ActionText::RichText.where(account_id: account.id, record_type: "Card", name: "description").select(:id))
+          .or(ActionText::RichText.where(account_id: account.id, record_type: "Comment", name: "body").select(:id))
+
+        attachments_for(card_ids:, rich_text_ids:)
+      end
+
+      def attachments_for(card_ids:, rich_text_ids:)
+        card_images = ActiveStorage::Attachment.where(record_type: "Card", name: "image", record_id: card_ids)
+        rich_text_embeds = ActiveStorage::Attachment.where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+
+        card_images.or(rich_text_embeds)
+      end
+  end
+end
