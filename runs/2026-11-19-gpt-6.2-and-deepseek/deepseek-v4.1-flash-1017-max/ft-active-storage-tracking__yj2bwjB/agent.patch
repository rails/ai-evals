+class AddBytesUsedToAccountsAndBoards < ActiveRecord::Migration[8.2]
+  def up
+    add_column :accounts, :bytes_used, :bigint, default: 0, null: false
+    add_column :boards, :bytes_used, :bigint, default: 0, null: false
+
+    backfill_bytes_used
+  end
+
+  def down
+    remove_column :accounts, :bytes_used
+    remove_column :boards, :bytes_used
+  end
+
+  private
+    def backfill_bytes_used
+      Board.reset_column_information
+      Account.reset_column_information
+
+      Board.find_each do |board|
+        board.update_column(:bytes_used, StorageUsage.bytes_for_board(board))
+      end
+
+      Account.find_each do |account|
+        account.update_column(:bytes_used, StorageUsage.bytes_for_account(account))
+      end
+    end
+end
