diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..9b645af
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  test "accounts and boards count card images and rich text embeds" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    sizes = []
+    Current.with(account: account, session: sessions(:david)) do
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "card.jpg", content_type: "image/jpeg")
+      sizes << card.image.blob.byte_size
+
+      sizes << attach_blob(board, :public_description).byte_size
+      sizes << attach_blob(card, :description).byte_size
+      sizes << attach_blob(comment, :body).byte_size
+    end
+    perform_enqueued_jobs only: StorageUsageJob
+
+    assert_equal sizes.sum, board.bytes_used
+    assert_equal sizes.sum, account.bytes_used
+  end
+
+  test "moving a card moves its storage usage between boards" do
+    account = accounts("37s")
+    old_board = boards(:writebook)
+    new_board = boards(:private)
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    Current.with(account: account, session: sessions(:david)) do
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "card.jpg", content_type: "image/jpeg")
+      attach_blob(card, :description)
+      attach_blob(comment, :body)
+    end
+    perform_enqueued_jobs only: StorageUsageJob
+    bytes_used = old_board.bytes_used
+    assert_operator bytes_used, :>, 0
+
+    Current.with(account: account, session: sessions(:david)) do
+      card.update!(board: new_board)
+    end
+    perform_enqueued_jobs only: StorageUsageJob
+
+    assert_equal 0, old_board.bytes_used
+    assert_equal bytes_used, new_board.bytes_used
+    assert_equal bytes_used, account.bytes_used
+  end
+
+  test "ignores attachments that are not card images or supported rich text embeds" do
+    account = accounts("37s")
+    board = boards(:writebook)
+
+    Current.with(account: account, session: sessions(:david)) do
+      users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg")
+    end
+    perform_enqueued_jobs only: StorageUsageJob
+
+    assert_equal 0, board.bytes_used
+    assert_equal 0, account.bytes_used
+  end
+
+  test "removing attachments reduces usage" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    Current.with(account: account, session: sessions(:david)) do
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "card.jpg", content_type: "image/jpeg")
+      attach_blob(card, :description)
+    end
+    perform_enqueued_jobs only: StorageUsageJob
+    assert_operator board.bytes_used, :>, 0
+
+    Current.with(account: account, session: sessions(:david)) do
+      card.image.purge_later
+      card.update!(description: "<p>No attachments</p>")
+    end
+    perform_enqueued_jobs only: StorageUsageJob
+
+    assert_equal 0, board.bytes_used
+    assert_equal 0, account.bytes_used
+  end
+
+  private
+    def attach_blob(record, attribute)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "embed-#{SecureRandom.hex(4)}.jpg",
+        content_type: "image/jpeg"
+      )
+      attachment = ActionText::Attachment.from_attachable(blob).to_html
+      record.update!(attribute => "<p>#{attachment}</p>")
+      blob.reload
+    end
+end
