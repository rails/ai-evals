--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class PicturesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -38,4 +40,38 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "uploaded picture is derived once and served without reprocessing" do
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:reading_picture)), params: {
+        leaf: { title: "New picture" },
+        picture: {
+          image: fixture_file_upload("white-rabbit.webp", "image/webp")
+        } }
+    end
+
+    assert_response :no_content
+
+    picture = leaves(:reading_picture).reload.leafable
+    variant_records = picture.image.blob.variant_records
+    assert_equal 1, variant_records.count
+
+    processed = false
+    notification = ->(*) { processed = true }
+
+    assert_no_difference -> { variant_records.count } do
+      ActiveSupport::Notifications.subscribed(notification, "transform.active_storage") do
+        get leafable_slug_path(leaves(:reading_picture))
+        assert_response :success
+
+        image = css_select("figure.page--picture img[src*='active_storage']").first
+        assert image, "Expected the picture page to render a variant image"
+
+        get image["src"]
+        assert_response :redirect
+      end
+    end
+
+    assert_not processed, "Expected the derived picture to be served without processing it again"
+  end
 end
