+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to public_board_path(@board.publication_key), class: "btn btn--back btn--circle-mobile" do %>
+      <span>Back to <%= @board.name %></span>
+    <% end %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<article class="card-perma">
+  <div class="card-perma__bg">
+    <div class="card">
+      <header class="card__header">
+        <span class="card__id">#<%= @card.number %></span>
+        <span class="card__board-name"><%= @board.name %></span>
+      </header>
+
+      <div class="card__body">
+        <div class="card__content">
+          <h2 class="card__title"><%= @card.title %></h2>
+
+          <% unless @card.description.blank? %>
+            <div class="card__description lexxy-content">
+              <%= @card.description %>
+            </div>
+          <% end %>
+        </div>
+      </div>
+
+      <footer class="card__footer">
+        <% if @card.column %>
+          <%= link_to @card.column.name, public_board_column_path(@board.publication_key, @card.column.id), class: "btn" %>
+        <% end %>
+
+        <span>Added by <strong><%= @card.creator.name %></strong></span>
+
+        <% if @card.tags.any? %>
+          <span><%= @card.tags.map(&:title).sort.join(", ") %></span>
+        <% end %>
+      </footer>
+    </div>
+  </div>
+</article>
