diff --git a/test/controllers/public_boards_controller_test.rb b/test/controllers/public_boards_controller_test.rb
new file mode 100644
index 0000000..d74970e
--- /dev/null
+++ b/test/controllers/public_boards_controller_test.rb
@@ -0,0 +1,186 @@
+require "test_helper"
+
+class PublicBoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "published boards are publicly visible" do
+    @board.publish
+
+    get public_board_path(@board.publication_key)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a", text: cards(:logo).title
+    assert_select "a", text: columns(:writebook_triage).name
+  end
+
+  test "unpublished boards are not publicly visible" do
+    get public_board_path("missing")
+
+    assert_response :not_found
+  end
+
+  test "unpublishing a board makes it private again" do
+    @board.publish
+    @board.unpublish
+
+    get public_board_path(@board.publication_key || "missing")
+
+    assert_response :not_found
+  end
+
+  test "public columns only show published cards" do
+    @board.publish
+    drafted = @board.cards.create!(title: "A draft", status: "drafted", creator: users(:david), column: columns(:writebook_triage))
+
+    get public_board_column_path(@board.publication_key, columns(:writebook_triage))
+
+    assert_response :success
+    assert_select "a", text: cards(:logo).title
+    assert_select "a", text: drafted.title, count: 0
+  end
+
+  test "public cards can be opened by number" do
+    @board.publish
+
+    get public_board_card_path(@board.publication_key, cards(:logo).number)
+
+    assert_response :success
+    assert_select "h1", text: cards(:logo).title
+  end
+
+  test "drafted cards cannot be opened publicly" do
+    @board.publish
+    drafted = @board.cards.create!(title: "A secret draft", status: "drafted", creator: users(:david), column: columns(:writebook_triage))
+
+    get public_board_card_path(@board.publication_key, drafted.number)
+
+    assert_response :not_found
+  end
+
+  test "board JSON has a nil public_url by default" do
+    sign_in_as :kevin
+
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "board JSON includes the public URL after publication" do
+    sign_in_as :kevin
+    @board.publish
+
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert_equal public_board_url(@board.publication_key, script_name: nil), @response.parsed_body["public_url"]
+  end
+end
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admins can publish a board" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "admins can unpublish a board" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "non-admins cannot publish a board" do
+    logout_and_sign_in_as :jz
+
+    assert_no_changes -> { @board.reload.published? } do
+      post board_publication_path(@board)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "non-admins cannot unpublish a board" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    assert_no_changes -> { @board.reload.published? } do
+      delete board_publication_path(@board)
+    end
+
+    assert_response :forbidden
+  end
+end
+
+class Boards::PublicationsJSONControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "publishing as JSON returns the board with a public URL" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert_equal public_board_url(@board.reload.publication_key, script_name: nil), @response.parsed_body["public_url"]
+  end
+
+  test "unpublishing as JSON returns no content" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+end
+
+class PublicBoardsWithoutTenantControllerTest < ActionDispatch::IntegrationTest
+  test "public board pages work without an account prefix" do
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_path(board.publication_key, script_name: nil)
+
+    assert_response :success
+    assert_select "h1", text: board.name
+
+    get public_board_column_path(board.publication_key, columns(:writebook_triage), script_name: nil)
+    assert_response :success
+
+    get public_board_card_path(board.publication_key, cards(:logo).number, script_name: nil)
+    assert_response :success
+  end
+end
+
+class BoardEditPublicationTest < ActionDispatch::IntegrationTest
+  test "admins see publication controls in board settings" do
+    sign_in_as :kevin
+    board = boards(:writebook)
+
+    get edit_board_path(board)
+    assert_response :success
+    assert_select "form[action='#{board_publication_path(board)}']", count: 1
+    assert_select "button", text: "Publish board"
+
+    board.publish
+    get edit_board_path(board)
+    assert_response :success
+    assert_select "input[readonly][value='#{public_board_url(board.publication_key, script_name: nil)}']"
+    assert_select "button", text: "Unpublish board"
+  end
+end
