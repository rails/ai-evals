diff --git a/app/models/board.rb b/app/models/board.rb
index 37ecb85..d3f5d21 100644
--- a/app/models/board.rb
+++ b/app/models/board.rb
@@ -10,4 +10,46 @@ class Board < ApplicationRecord
 
   scope :alphabetically, -> { order("lower(name)") }
   scope :ordered_by_recently_accessed, -> { merge(Access.ordered_by_recently_accessed) }
+  scope :published, -> { where.not(publication_key: [ nil, "" ]) }
+  scope :unpublished, -> { where(publication_key: [ nil, "" ]) }
+
+  alias_attribute :public_key, :publication_key
+  alias_attribute :key, :publication_key
+
+  def publish
+    update!(publication_key: generate_unique_publication_key) unless published?
+  end
+  alias_method :publish!, :publish
+
+  def unpublish
+    update!(publication_key: nil) if published?
+  end
+  alias_method :unpublish!, :unpublish
+
+  def published?
+    publication_key.present?
+  end
+  alias_method :public?, :published?
+
+  def public_url(**options)
+    if published?
+      options = default_public_url_options.merge(options)
+      options[:script_name] = nil
+      Rails.application.routes.url_helpers.public_board_url(publication_key, **options)
+    end
+  end
+
+  private
+    def generate_unique_publication_key
+      loop do
+        candidate = SecureRandom.base58(32)
+        break candidate unless self.class.exists?(publication_key: candidate)
+      end
+    end
+
+    def default_public_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options.presence ||
+        { host: "localhost" }
+    end
 end
