diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..d5100ae
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,24 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public board</h2>
+
+    <% if board.published? %>
+      <p class="margin-none-block-start">Anyone with the secret link can view this board, its columns, and its published cards.</p>
+
+      <label class="flex flex-column gap-half margin-block-half">
+        <span class="txt-small txt-subtle">Secret link</span>
+        <input class="input full-width" type="text" value="<%= public_board_url(board.publication_key, script_name: nil) %>" readonly>
+      </label>
+
+      <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative borderless", data: { turbo_frame: "_top" } do %>
+        <span>Unpublish board</span>
+      <% end %>
+    <% else %>
+      <p class="margin-none-block-start">Publish this board to share a secret link to it. Anyone with the link can view its columns and published cards.</p>
+
+      <%= button_to board_publication_path(board), method: :post, class: "btn btn--link", data: { turbo_frame: "_top" } do %>
+        <span>Publish board</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
diff --git a/app/views/public/boards/show.html.erb b/app/views/public/boards/show.html.erb
new file mode 100644
index 0000000..ece6b64
--- /dev/null
+++ b/app/views/public/boards/show.html.erb
@@ -0,0 +1,43 @@
+<% @page_title = @board.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<section class="cards cards--grid">
+  <div class="cards__list hide-scrollbar">
+    <% @columns.each do |column| %>
+      <% cards = @cards_by_column.fetch(column.id, []) %>
+
+      <section class="cards" id="<%= dom_id(column) %>">
+        <header class="cards__header">
+          <h2 class="cards__title">
+            <%= link_to column.name, public_board_column_path(@board.publication_key, column.id) %>
+          </h2>
+        </header>
+
+        <div class="cards__list">
+          <% if cards.any? %>
+            <%= render partial: "public/cards/card", collection: cards, as: :card, locals: { board: @board } %>
+          <% else %>
+            <p class="blank-slate">No cards</p>
+          <% end %>
+        </div>
+      </section>
+    <% end %>
+
+    <% if @untriaged_cards.any? %>
+      <section class="cards">
+        <header class="cards__header">
+          <h2 class="cards__title">Maybe?</h2>
+        </header>
+
+        <div class="cards__list">
+          <%= render partial: "public/cards/card", collection: @untriaged_cards, as: :card, locals: { board: @board } %>
+        </div>
+      </section>
+    <% end %>
+  </div>
+</section>
