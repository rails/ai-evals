diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..88d3782
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,80 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  belongs_to :account, default: -> { reactable.account }
+  belongs_to :reactable, polymorphic: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  after_create_commit -> { touch_reactable; broadcast_reactions_update }
+  after_destroy_commit -> { touch_reactable; broadcast_reactions_update }
+
+  def comment
+    reactable if reactable_type == "Comment"
+  end
+
+  def comment=(comment)
+    self.reactable = comment
+  end
+
+  def comment_id
+    reactable_id if reactable_type == "Comment"
+  end
+
+  def comment_id=(id)
+    self.reactable_id = id
+    self.reactable_type = "Comment"
+  end
+
+  def card
+    reactable.card
+  end
+
+  def card=(card)
+    self.reactable = card
+  end
+
+  def card_id
+    reactable_id if reactable_type == "Card"
+  end
+
+  def card_id=(id)
+    self.reactable_id = id
+    self.reactable_type = "Card"
+  end
+
+  alias_method :reactionable, :reactable
+  alias_method :reactionable=, :reactable=
+
+  private
+    def touch_reactable
+      reactable.update_column(:updated_at, Time.current) if reactable&.persisted?
+    end
+
+    def broadcast_reactions_update
+      if reactable.is_a?(Comment) && reactable.persisted?
+        broadcast_reactions_list_to reactable.card,
+          target: ActionView::RecordIdentifier.dom_id(reactable, :reactions_list),
+          partial: "cards/comments/reactions/list",
+          locals: { comment: reactable }
+      elsif reactable.is_a?(Card) && reactable.persisted?
+        broadcast_reactions_list_to reactable,
+          target: ActionView::RecordIdentifier.dom_id(reactable, :reactions_list),
+          partial: "cards/reactions/list",
+          locals: { card: reactable }
+      end
+    rescue ActiveRecord::RecordNotFound
+      # The reaction target may have been destroyed along with this reaction.
+    end
+
+    def broadcast_reactions_list_to(stream, target:, partial:, locals:)
+      if destroyed?
+        broadcast_replace_to stream, target: target, partial: partial, locals: locals
+      else
+        broadcast_replace_later_to stream, target: target, partial: partial, locals: locals
+      end
+    end
+end
