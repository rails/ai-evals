diff --git a/app/views/cards/comments/reactions/_form.html.erb b/app/views/cards/comments/reactions/_form.html.erb
new file mode 100644
index 0000000..c30e41d
--- /dev/null
+++ b/app/views/cards/comments/reactions/_form.html.erb
@@ -0,0 +1,52 @@
+<% reaction = local_assigns.fetch(:reaction, Reaction.new) %>
+<% show_form = reaction.errors.any? %>
+<div id="<%= dom_id(comment, :reaction_form) %>" class="flex align-center">
+  <button type="button" class="reactions__trigger btn btn--circle" data-reaction-target="trigger"
+          data-action="reaction#open" aria-label="Add a reaction" title="Add a reaction" <%= "hidden" if show_form %>>
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+  </button>
+
+  <%= form_with model: reaction, url: card_comment_reactions_path(comment.card, comment, script_name: comment.card.account.slug),
+        html: { hidden: !show_form },
+        class: "reaction__form flex align-center gap-half",
+        data: { reaction_target: "form", action: "keydown.esc->reaction#close:stop" } do |form| %>
+    <label class="reaction__form-label flex align-center">
+      <span class="reaction__avatar">
+        <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+      </span>
+
+      <%= form.text_field :content, class: "input reaction__input", placeholder: "React…",
+            maxlength: Reaction::MAX_CONTENT_LENGTH, required: true, autocomplete: "off",
+            aria: { label: "Reaction" }, data: { reaction_target: "input" } %>
+    </label>
+
+    <% if reaction.errors[:content].any? %>
+      <span class="txt-negative txt-small"><%= reaction.errors[:content].first %></span>
+    <% end %>
+
+    <details class="reaction__menu">
+      <summary class="reaction__menu-btn btn btn--circle borderless" aria-label="Choose an emoji" title="Choose an emoji">
+        <%= icon_tag "reaction" %>
+      </summary>
+
+      <div class="reaction__popup popup panel flex-column gap-half fill-white shadow txt-small">
+        <div class="reaction__emoji-list">
+          <% ReactionsHelper::EMOJIS.each do |emoji| %>
+            <button type="button" class="btn" data-action="reaction#selectEmoji"
+                    data-reaction-emoji-param="<%= emoji %>" aria-label="React with <%= emoji %>"><%= emoji %></button>
+          <% end %>
+        </div>
+      </div>
+    </details>
+
+    <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle borderless", title: "Confirm reaction" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm reaction</span>
+    <% end %>
+
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reaction#close"
+            title="Cancel reaction" aria-label="Cancel reaction">
+      <%= icon_tag "close" %>
+    </button>
+  <% end %>
+</div>
