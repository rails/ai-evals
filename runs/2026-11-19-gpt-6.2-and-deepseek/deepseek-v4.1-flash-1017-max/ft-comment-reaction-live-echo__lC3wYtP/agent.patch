+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,61 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.chronologically.preload(:reacter)
+  end
+
+  def create
+    @reaction = @comment.reactions.new(reaction_params)
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream do
+          render turbo_stream: turbo_stream.replace(
+            ActionView::RecordIdentifier.dom_id(@comment, :reaction_form),
+            partial: "cards/comments/reactions/form",
+            locals: { comment: @comment, reaction: @reaction }
+          ), status: :unprocessable_entity
+        end
+        format.json { render json: { errors: @reaction.errors.to_hash }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reactership
+      head :forbidden unless Current.user == @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
