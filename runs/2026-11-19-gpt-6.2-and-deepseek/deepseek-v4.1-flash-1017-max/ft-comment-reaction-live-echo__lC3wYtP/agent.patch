diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..b4526e6
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "index as JSON" do
+    @comment.reactions.create!(content: "👍", reacter: users(:jz))
+    @comment.reactions.create!(content: "Nice", reacter: users(:kevin))
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal 2, @response.parsed_body.size
+    assert_equal [ "👍", "Nice" ], @response.parsed_body.pluck("content")
+    assert_equal users(:jz).id, @response.parsed_body.first.dig("reacter", "id")
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    reaction = Reaction.last
+
+    assert_response :created
+    assert_equal "Great 👍", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal card_comment_reaction_path(@card, @comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "Great 👍", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "Flat reaction" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Flat reaction", Reaction.last.content
+  end
+
+  test "create rejects reactions longer than 16 characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create as turbo stream" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions_list)
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reaction_form)
+  end
+
+  test "destroy as JSON is forbidden for non-reacters" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    logout_and_sign_in_as :david
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :forbidden
+    assert Reaction.exists?(reaction.id)
+  end
+
+  test "destroy as JSON" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy as turbo stream" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions_list)
+  end
+test "renders the reaction strip on the card" do
+  @comment.reactions.create!(content: "👍", reacter: users(:jz))
+
+  get card_path(@card)
+
+  assert_response :success
+  assert_select ".reactions" do
+    assert_select ".reactions__trigger img[src*=boost-color]"
+    assert_select ".reactions__list .reaction .reaction__avatar"
+    assert_select ".reaction", text: /👍/
+    assert_select "form[action=?]", card_comment_reactions_path(@card, @comment, script_name: Current.account.slug)
+    assert_select ".reaction__input[maxlength=?]", Reaction::MAX_CONTENT_LENGTH
+    assert_select ".reaction__submit-btn"
+    assert_select ".reaction__cancel-btn"
+  end
+end
+
+test "comment JSON includes the reactions URL" do
+  get card_comment_path(@card, @comment), as: :json
+
+  assert_response :success
+  assert_equal card_comment_reactions_url(@card, @comment), @response.parsed_body["reactions_url"]
+end
+end
