diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..1905bdd
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,51 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "trigger" ]
+
+  open(event) {
+    event.preventDefault()
+
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  close(event) {
+    event?.preventDefault()
+
+    this.formTarget.reset()
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.#closeEmojiMenus()
+    this.triggerTarget.focus()
+  }
+
+  selectEmoji(event) {
+    const { emoji } = event.params
+
+    this.inputTarget.value = emoji
+    this.inputTarget.dispatchEvent(new Event("input", { bubbles: true }))
+    this.inputTarget.focus()
+    event.currentTarget.closest("details")?.removeAttribute("open")
+  }
+
+  toggleExpanded(event) {
+    if (event.target.closest("button, a, form, input, summary")) return
+
+    const reaction = event.currentTarget
+    if (reaction.dataset.creatorId !== this.#currentUserId) return
+
+    reaction.classList.toggle("expanded")
+  }
+
+  #closeEmojiMenus() {
+    this.element.querySelectorAll("details[open]").forEach(details => details.removeAttribute("open"))
+  }
+
+  get #currentUserId() {
+    return document.head.querySelector('meta[name="current-user-id"]')?.content
+  }
+}
