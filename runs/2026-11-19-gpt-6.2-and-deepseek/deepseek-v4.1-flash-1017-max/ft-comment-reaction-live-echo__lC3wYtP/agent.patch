diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..b4e20cb
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "defaults the reacter to the current user" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal @comment, reaction.reactable
+    assert_equal @comment, reaction.comment
+  end
+
+  test "accepts at most 16 characters" do
+    reaction = @comment.reactions.build(content: "a" * 16)
+
+    assert reaction.valid?
+
+    reaction.content = "a" * 17
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "requires content" do
+    reaction = @comment.reactions.build(content: " ")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "broadcasts the updated reaction list when created" do
+    assert_turbo_stream_broadcasts([ @comment.card ], count: 1) do
+      perform_enqueued_jobs do
+        @comment.reactions.create!(content: "👍")
+      end
+    end
+  end
+
+  test "broadcasts the updated reaction list when destroyed" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_turbo_stream_broadcasts([ @comment.card ], count: 1) do
+      perform_enqueued_jobs do
+        reaction.destroy!
+      end
+    end
+  end
+test "can be created with explicit comment and card attributes" do
+  comment_reaction = Reaction.create!(comment: @comment, reacter: users(:kevin), content: "Comment")
+  card_reaction = Reaction.create!(card: @comment.card, reacter: users(:kevin), content: "Card")
+
+  assert_equal @comment, comment_reaction.comment
+  assert_equal @comment.id, comment_reaction.comment_id
+  assert_equal @comment.card, card_reaction.card
+  assert_equal @comment.card.id, card_reaction.card_id
+end
+
+  test "broadcast includes the reaction and account-scoped route" do
+    broadcasts = capture_turbo_stream_broadcasts([ @comment.card ]) do
+      perform_enqueued_jobs do
+        @comment.reactions.create!(content: "🎉", reacter: users(:jz))
+      end
+    end
+
+    html = broadcasts.last.to_s
+    assert_includes html, "🎉"
+    assert_includes html, "reactions_list_comment_#{@comment.id}"
+    assert_includes html, "#{Current.account.slug}/cards/#{@comment.card.number}/comments/#{@comment.id}/reactions/"
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..790cfba
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,62 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:kevin)
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding and removing a comment reaction" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("🎉")
+      find(".reaction__submit-btn").click
+
+      reaction = find(".reaction", text: "🎉")
+      assert_selector ".reaction__form[hidden]", visible: :all
+
+      reaction.click
+      assert_selector ".reaction.expanded .reaction__delete"
+
+      find(".reaction.expanded .reaction__delete").click
+      assert_no_selector ".reaction", text: "🎉"
+    end
+  end
+
+  test "a reaction created elsewhere appears without reloading" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    @comment.reactions.create!(content: "🚀", reacter: users(:jz))
+    perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+
+    within "##{dom_id(@comment)}" do
+      assert_selector ".reaction", text: "🚀", wait: 5
+    end
+  end
+
+  test "canceling the reaction form restores the trigger" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      find(".reactions__trigger").click
+      assert_selector ".reaction__form:not([hidden])"
+
+      find(".reaction__cancel-btn").click
+
+      assert_selector ".reaction__form[hidden]", visible: :all
+      assert_selector ".reactions__trigger:not([hidden])"
+    end
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
