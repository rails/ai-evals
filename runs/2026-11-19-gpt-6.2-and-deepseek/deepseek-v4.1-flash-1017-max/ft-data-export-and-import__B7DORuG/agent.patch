diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..5d576c2
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,62 @@
+require "tempfile"
+
+class ZipFile::Reader
+  CHUNK_SIZE = 1.megabyte
+
+  attr_reader :entries
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+    @entries_by_path = @entries.index_by(&:filename)
+  end
+
+  def glob(pattern)
+    @entries_by_path.keys.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def exists?(path)
+    @entries_by_path.key?(path)
+  end
+
+  def read(path)
+    extract(path) do |extractor|
+      data = +"".b
+      until extractor.eof?
+        chunk = extractor.extract(CHUNK_SIZE)
+        break if chunk.nil?
+        data << chunk
+      end
+      data
+    end
+  end
+
+  def open(path)
+    raise ArgumentError, "No block given" unless block_given?
+
+    tempfile = Tempfile.new([ "zip-entry", File.extname(path) ])
+    tempfile.binmode
+
+    extract(path) do |extractor|
+      until extractor.eof?
+        chunk = extractor.extract(CHUNK_SIZE)
+        break if chunk.nil?
+        tempfile.write(chunk)
+      end
+    end
+
+    tempfile.rewind
+    yield tempfile
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  private
+    def extract(path)
+      entry = @entries_by_path[path]
+      raise ArgumentError, "No ZIP entry named #{path.inspect}" unless entry
+
+      yield entry.extractor_from(@io)
