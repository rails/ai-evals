@@ -0,0 +1,32 @@
+<% @page_title = "Import account data" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="panel shadow center" style="--panel-size: 52ch;">
+  <div class="flex flex-column gap">
+    <p class="margin-none">Choose a Fizzy account export ZIP file. We’ll create a new account with its boards, cards, comments, files, and people.</p>
+
+    <%= form_with model: @import, url: account_imports_path, multipart: true, class: "flex flex-column gap" do |form| %>
+      <label class="input flex align-center gap">
+        <%= form.file_field :file, accept: "application/zip,.zip", required: true, class: "input full-width" %>
+      </label>
+
+      <% if @import.errors.any? %>
+        <div class="txt-negative txt-small">
+          <p class="margin-block-none font-weight-bold">We couldn’t start the import:</p>
+          <ul class="margin-block-none">
+            <% @import.errors.full_messages.each do |message| %>
+              <li><%= message %></li>
+            <% end %>
+          </ul>
+        </div>
+      <% end %>
+
+      <%= form.button "Import account", class: "btn btn--reversed center" %>
+    <% end %>
+
+    <p class="txt-small txt-tinted margin-none">The import is all-or-nothing. If it can’t be completed, no account will be left behind.</p>
+  </div>
+</div>
