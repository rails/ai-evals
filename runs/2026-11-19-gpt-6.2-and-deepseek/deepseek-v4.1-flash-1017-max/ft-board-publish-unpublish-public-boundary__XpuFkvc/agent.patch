+class Public::BoardsController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+
+  layout "public"
+
+  before_action :set_board
+
+  def show
+    @columns = @board.columns.sorted
+    @cards_without_column = @board.cards.published.where(column_id: nil).latest
+  end
+
+  private
+    def set_board
+      @board = Board.find_by!(public_key: params[:key])
+      Current.account = @board.account
+    end
+end
diff --git a/app/models/board.rb b/app/models/board.rb
index 37ecb85..002fcb8 100644
--- a/app/models/board.rb
+++ b/app/models/board.rb
@@ -10,4 +10,32 @@ class Board < ApplicationRecord
 
   scope :alphabetically, -> { order("lower(name)") }
   scope :ordered_by_recently_accessed, -> { merge(Access.ordered_by_recently_accessed) }
+
+  def publish
+    update!(public_key: generate_public_key) unless published?
+  end
+
+  def unpublish
+    update!(public_key: nil)
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def public_url
+    Rails.application.routes.url_helpers.public_board_path(public_key, script_name: nil) if published?
+  end
+
+  alias_method :publish!, :publish
+  alias_method :unpublish!, :unpublish
+  alias_method :public?, :published?
+
+  private
+    def generate_public_key
+      loop do
+        candidate = SecureRandom.base58(24)
+        break candidate unless self.class.exists?(public_key: candidate)
+      end
+    end
 end
