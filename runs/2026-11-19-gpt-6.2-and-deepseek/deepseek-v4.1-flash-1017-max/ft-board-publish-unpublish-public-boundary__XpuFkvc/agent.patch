diff --git a/test/controllers/boards_publication_test.rb b/test/controllers/boards_publication_test.rb
new file mode 100644
index 0000000..ddf1fdb
--- /dev/null
+++ b/test/controllers/boards_publication_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+
+class BoardsPublicationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "public_url is nil by default in board JSON" do
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "admin can publish a board" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+    assert @board.public_key.present?
+    assert_equal public_board_url(@board.public_key, script_name: nil), @response.parsed_body["public_url"]
+  end
+
+  test "admin can publish a board from the settings page" do
+    post board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+  end
+
+  test "admin can unpublish a board from the settings page" do
+    @board.publish
+
+    delete board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "published board settings show the public URL" do
+    @board.publish
+
+    get edit_board_path(@board)
+
+    assert_response :success
+    assert_select "a[href=?]", public_board_path(@board.public_key, script_name: nil)
+  end
+
+  test "non-admin cannot publish a board" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "admin can unpublish a board" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "anyone can view a published board at its secret URL" do
+    @board.publish
+
+    untenanted do
+      get public_board_path(@board.public_key)
+    end
+
+    assert_response :success
+    assert_includes response.body, @board.name
+    assert_select "a", text: /The logo isn.t big enough/
+  end
+
+  test "signed-out visitors can view a published board" do
+    @board.publish
+    sign_out
+
+    untenanted do
+      get public_board_path(@board.public_key)
+    end
+
+    assert_response :success
+  end
+
+  test "published board URLs also work when generated with an account prefix" do
+    @board.publish
+
+    get public_board_path(@board.public_key)
+
+    assert_response :success
+  end
+
+  test "anyone can view a column on a published board" do
+    @board.publish
+    column = columns(:writebook_in_progress)
+
+    untenanted do
+      get public_board_column_path(@board.public_key, column)
+    end
+
+    assert_response :success
+    assert_includes response.body, column.name
+    assert_includes response.body, cards(:text).title
+  end
+
+  test "anyone can view a published card on a published board" do
+    @board.publish
+    card = cards(:text)
+
+    untenanted do
+      get public_board_card_path(@board.public_key, card.number)
+    end
+
+    assert_response :success
+    assert_includes response.body, card.title
+  end
+
+  test "published card content is rendered" do
+    @board.publish
+    card = cards(:text)
+    card.update!(description: "A detailed public description")
+
+    untenanted do
+      get public_board_card_path(@board.public_key, card.number)
+    end
+
+    assert_response :success
+    assert_includes response.body, "A detailed public description"
+  end
+
+  test "drafted cards are not visible on a published board" do
+    @board.publish
+    card = cards(:text)
+    card.drafted!
+
+    untenanted do
+      get public_board_card_path(@board.public_key, card.number)
+    end
+
+    assert_response :not_found
+  end
+
+  test "unpublishing revokes access to the public URL" do
+    @board.publish
+    public_key = @board.public_key
+    @board.unpublish
+
+    untenanted do
+      get public_board_path(public_key)
+    end
+
+    assert_response :not_found
+  end
+end
