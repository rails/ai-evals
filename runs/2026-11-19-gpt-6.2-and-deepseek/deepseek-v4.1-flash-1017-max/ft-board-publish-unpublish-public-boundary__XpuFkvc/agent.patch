@@ -0,0 +1,35 @@
+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <%= link_to @board.name, public_board_path(@board.public_key), class: "header__title" %>
+<% end %>
+
+<article class="public-card" id="<%= dom_id(@card) %>">
+  <header>
+    <p class="txt-small">
+      #<%= @card.number %>
+      <% if @card.column %>
+        in <%= link_to @card.column.name, public_board_column_path(@board.public_key, @card.column) %>
+      <% end %>
+    </p>
+    <h1><%= @card.title %></h1>
+  </header>
+
+  <% unless @card.description.blank? %>
+    <div class="public-card__description">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <% if @card.tags.any? %>
+    <p class="txt-small"><%= @card.tags.pluck(:title).sort.join(", ") %></p>
+  <% end %>
+
+  <% if @card.steps.any? %>
+    <ol class="public-card__steps">
+      <% @card.steps.each do |step| %>
+        <li><%= step.completed? ? "✓" : "○" %> <%= step.content %></li>
+      <% end %>
+    </ol>
+  <% end %>
+</article>
