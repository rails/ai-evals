index 0000000..0ac8899
--- /dev/null
+++ b/app/models/account/data_transfer/card_record_set.rb
@@ -0,0 +1,70 @@
+class Account::DataTransfer::CardRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account, records: nil)
+    super(account: account, model: Card, records: records)
+  end
+
+  protected
+    def records
+      @records || Card.where(account: account)
+    end
+
+    def export_attributes(record)
+      files = attachments_for(record)
+
+      super.merge(
+        "description" => record.description&.body&.to_html,
+        "comments" => comments_for(record),
+        "attachments" => files,
+        "files" => files,
+        "image" => image_for(record)
+      )
+    end
+
+  private
+    def comments_for(card)
+      card.comments.chronologically.map do |comment|
+        {
+          "id" => comment.id,
+          "creator_id" => comment.creator_id,
+          "body" => comment.body&.body&.to_html,
+          "created_at" => comment.created_at,
+          "updated_at" => comment.updated_at,
+          "attachments" => attachments_for(comment)
+        }
+      end
+    end
+
+    def image_for(record)
+      return unless record.respond_to?(:image) && record.image.attached?
+
+      attachment_attributes(record.image.blob)
+    end
+
+    def attachments_for(record)
+      blobs = []
+
+      if record.respond_to?(:image) && record.image.attached?
+        blobs << record.image.blob
+      end
+
+      if record.respond_to?(:rich_text_description) && record.rich_text_description
+        blobs.concat(record.rich_text_description.embeds.map(&:blob))
+      end
+
+      if record.respond_to?(:rich_text_body) && record.rich_text_body
+        blobs.concat(record.rich_text_body.embeds.map(&:blob))
+      end
+
+      blobs.uniq(&:id).map { |blob| attachment_attributes(blob) }
+    end
+
+    def attachment_attributes(blob)
+      {
+        "id" => blob.id,
+        "filename" => blob.filename.to_s,
+        "content_type" => blob.content_type,
+        "byte_size" => blob.byte_size,
+        "path" => "files/#{blob.id}/#{File.basename(blob.filename.to_s)}"
+      }
+    end
+end
