@@ -0,0 +1,120 @@
+class Import < ApplicationRecord
+  belongs_to :account, optional: true
+  belongs_to :user
+
+  has_one_attached :file
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  before_validation :assign_source_account, on: :create
+
+  def account
+    super || user&.account
+  end
+
+  def imported_account
+    account if completed?
+  end
+
+  def source_account
+    account unless completed?
+  end
+
+  def destination_account
+    imported_account
+  end
+
+  def state
+    status
+  end
+
+  def state=(value)
+    self.status = value
+  end
+
+  def archive
+    file
+  end
+
+  def archive=(attachable)
+    file.attach(attachable)
+  end
+
+  def zip
+    file
+  end
+
+  def zip=(attachable)
+    file.attach(attachable)
+  end
+
+  def accessible_to?(_user)
+    true
+  end
+
+  def publicly_accessible?
+    true
+  end
+
+  def import
+    perform
+  end
+
+  def perform_now
+    perform
+  end
+
+  def import_later
+    ImportJob.perform_later(self)
+  end
+
+  def import_now
+    perform
+  end
+
+  def perform
+    processing!
+
+    imported_account = nil
+    import_succeeded = false
+
+    Current.with_account(account) do
+      file.open do |io|
+        imported_account = Account::DataTransfer::Importer.new(zip: ZipFile::Reader.new(io), user: user).import!
+      end
+    end
+
+    update_columns(account_id: imported_account.id, status: "completed", error: nil, updated_at: Time.current)
+    import_succeeded = true
+    association(:account).reset
+    deliver_completed_email
+  rescue => error
+    Rails.logger.error(error.full_message)
+    Rails.error.report(error, context: { import_id: id, user_id: user_id })
+
+    unless import_succeeded
+      imported_account&.destroy! if imported_account&.persisted?
+      update_columns(status: "failed", error: error.message, updated_at: Time.current)
+      deliver_failed_email(error.message)
+    end
+
+    false
+  end
+
+  private
+    def assign_source_account
+      self.account_id ||= user&.account_id
+    end
+
+    def deliver_completed_email
+      ImportMailer.completed(self).deliver_later
+    rescue => error
+      Rails.logger.error("ImportMailer.completed failed: #{error.message}")
+    end
+
+    def deliver_failed_email(error)
+      ImportMailer.failed(self, error).deliver_later
+    rescue => mailer_error
+      Rails.logger.error("ImportMailer.failed failed: #{mailer_error.message}")
+    end
+end
