+      elsif zip.exists?("manifest.json")
+        manifest = JSON.parse(zip.read("manifest.json"))
+        account = manifest["account"] || { "id" => manifest["account_id"], "name" => manifest["account_name"] }
+        raise ArgumentError, "The file is not a valid Fizzy account export" unless account.is_a?(Hash)
+        account
+      else
+        raise ArgumentError, "The file is not a valid Fizzy account export"
+      end
+    end
+
+    def parse_account_record(json)
+      record = JSON.parse(json)
+      raise ArgumentError, "The file is not a valid Fizzy account export" unless record.is_a?(Hash)
+      record
+    rescue JSON::ParserError
+      raise ArgumentError, "The account record is not valid JSON"
+    end
+
+    def import_records_into(account)
+      source_account = Account.new(id: account_attributes["id"], name: account_attributes["name"])
+      manifest = Account::DataTransfer::Manifest.new(source_account, user: user)
+
+      manifest.each_record_set do |record_set|
+        next if record_set.model == Account
+
+        record_set.import_from(
+          zip,
+          account: account,
+          id_map: id_map,
+          uploaded_blob_keys: uploaded_blob_keys
+        )
+      end
+    end
+
+    def ensure_importing_user_has_access(account)
+      return if user.nil? || user.identity.nil?
+
+      imported_user = account.users.find_by(identity_id: user.identity_id)
+
+      if imported_user
+        imported_user.update_columns(role: "owner", active: true, verified_at: imported_user.verified_at || Time.current)
+      else
+        User.insert_all!([ {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account.id,
+          identity_id: user.identity_id,
+          name: user.name,
+          role: "owner",
+          active: true,
+          verified_at: Time.current,
+          created_at: Time.current,
+          updated_at: Time.current
+        } ])
+      end
+    end
+
+    def cleanup_uploaded_blobs
+      uploaded_blob_keys.each do |key|
+        ActiveStorage::Blob.service.delete(key)
+      rescue StandardError
+      end
+    end
+end
