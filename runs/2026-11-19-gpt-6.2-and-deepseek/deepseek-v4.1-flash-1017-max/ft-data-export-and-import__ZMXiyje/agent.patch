+class Account::ImportsController < ApplicationController
+  def new
+    @import = Import.new
+  end
+
+  def create
+    @import = Import.new(import_params.merge(user: Current.user, account: Current.account))
+
+    if @import.file.attached?
+      @import.save!
+      ImportJob.perform_later(@import)
+
+      respond_to do |format|
+        format.html { redirect_to account_settings_path, notice: "Your import is being processed. We'll email you when it's done." }
+        format.json { head :created }
+      end
+    else
+      @import.errors.add(:file, "must be a Fizzy account export ZIP file")
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def show
+    @import = Import.where(user: Current.user).find(params[:id])
+  end
+
+  private
+    def import_params
+      params.fetch(:import, {}).permit(:file).presence || params.permit(:file)
+    end
+end
