diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..027840d
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,83 @@
+class ZipFile::Reader
+  attr_reader :entries
+
+  class << self
+    def open(io)
+      reader = new(io)
+
+      if block_given?
+        begin
+          yield reader
+        ensure
+          reader.close
+        end
+      else
+        reader
+      end
+    end
+  end
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+  end
+
+  def glob(pattern)
+    entries
+      .map(&:filename)
+      .select { |filename| File.fnmatch(pattern, filename) }
+      .sort
+  end
+
+  def exists?(path)
+    entry(path).present?
+  end
+
+  def read(path)
+    extract(path)
+  end
+  alias read_file read
+
+  def each(path)
+    extractor = extractor_for(path)
+
+    while (chunk = extractor.extract(64.kilobytes))
+      break if chunk.empty? && extractor.eof?
+      yield chunk
+    end
+  end
+  alias each_file each
+
+  def open(path)
+    raise ArgumentError, "No block given" unless block_given?
+
+    yield StringIO.new(read(path))
+  end
+
+  def close
+    @io.close if @io.respond_to?(:close) && !@io.closed?
+  end
+
+  private
+    def extract(path)
+      extractor = extractor_for(path)
+      chunks = []
+
+      while (chunk = extractor.extract(64.kilobytes))
+        break if chunk.empty? && extractor.eof?
+        chunks << chunk
+      end
+
+      chunks.join
+    end
+
+    def extractor_for(path)
+      found = entry(path)
+      raise Errno::ENOENT, path unless found
+      found.extractor_from(@io)
+    end
+
+    def entry(path)
+      entries.find { |candidate| candidate.filename == path }
+    end
+end
