+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create
+
+  def create
+    export = Export.create!(
+      account: Current.account,
+      user: Current.user,
+      scope: "account"
+    )
+
+    ExportJob.perform_later(export)
+
+    respond_to do |format|
+      format.html { redirect_to account_settings_path, notice: "Your export is being prepared. We'll email you when it's ready." }
+      format.json { head :created }
+    end
+  end
+
+  def show
+    export = Export.find_signed(params[:id], purpose: :export_download) || Export.find_by(id: params[:id], account: Current.account)
+
+    if export&.downloadable? && export.account == Current.account
+      redirect_to rails_blob_url(export.file, disposition: :attachment, filename: export.file.filename.to_s, script_name: export.effective_account&.slug)
+    else
+      head :not_found
+    end
+  end
+end
