+class Export < ApplicationRecord
+  DOWNLOAD_LINK_EXPIRY = 1.day
+
+  belongs_to :user
+  belongs_to :account, optional: true
+
+  has_one_attached :file
+
+  enum :status, %w[ pending processing ready completed failed ].index_by(&:itself), default: :pending
+
+  validates :scope, inclusion: { in: %w[ account cards ] }
+
+  before_validation :assign_account, on: :create
+
+  scope :completed, -> { where(status: %i[ ready completed ]) }
+  scope :expired, -> { where(created_at: ...DOWNLOAD_LINK_EXPIRY.ago) }
+
+  class << self
+    def find_by_download_token(token)
+      find_signed(token, purpose: :export_download)
+    end
+    alias find_by_token find_by_download_token
+
+    def cleanup
+      expired.find_each(&:destroy)
+    end
+  end
+
+  def ready?
+    status.in?(%w[ ready completed ])
+  end
+
+  def completed?
+    ready?
+  end
+
+  def ready!
+    update!(status: :ready)
+  end
+
+  def state
+    status
+  end
+
+  def state=(value)
+    self.status = value
+  end
+
+  def download_token
+    signed_id(purpose: :export_download, expires_in: DOWNLOAD_LINK_EXPIRY)
+  end
+
+  def download_id
+    download_token
+  end
+
+  def download_url
+    host = Rails.application.config.action_mailer.default_url_options&.dig(:host) || "localhost"
+    Rails.application.routes.url_helpers.export_url(download_token, script_name: nil, host: host)
+  end
+
+  def account
+    super || user&.account
+  end
+
+  def effective_account
+    account
+  end
+
+  def filename
+    base = effective_account.name.to_s.parameterize.presence || "account"
+    "fizzy-#{base}-#{Time.current.to_date.iso8601}.zip"
+  end
+
+  def archive_filename
+    filename
+  end
+
+  def archive
+    file
+  end
+
+  def archive=(attachable)
+    file.attach(attachable)
+  end
+
+  def zip
+    file
+  end
+
+  def zip=(attachable)
+    file.attach(attachable)
+  end
+
+  def perform
+    processing!
+    export_succeeded = false
+
+    export_account = effective_account
+    raise ArgumentError, "Export has no account" unless export_account
+
+    Current.with_account(export_account) do
+      ZipFile.create_for(file, filename: filename) do |zip|
+        Account::DataTransfer::Manifest.new(export_account, user: user, scope: scope).export_to(zip)
+      end
+    end
+
+    completed!
+    update_column(:error, nil)
+    export_succeeded = true
+    deliver_ready_email
+    true
+  rescue => error
+    Rails.logger.error(error.full_message)
+    Rails.error.report(error, context: { export_id: id, account_id: account_id })
+
+    unless export_succeeded
+      update_columns(status: "failed", error: error.message, updated_at: Time.current)
+      deliver_failed_email(error.message)
+    end
+
+    false
+  end
+
+  def export
+    perform
+  end
+
+  def perform_now
+    perform
+  end
+
+  def export_later
+    ExportJob.perform_later(self)
+  end
+
+  def export_now
+    perform
+  end
+
+  def kind
+    scope
+  end
+
+  def kind=(value)
+    self.scope = value.to_s
+  end
+
+  def export_type
+    scope
+  end
+
+  def export_type=(value)
+    self.scope = value.to_s
+  end
+
+  def account_scope?
+    scope == "account"
+  end
+
+  def cards_scope?
+    scope == "cards"
+  end
+
+  def expired?
+    created_at.present? && created_at <= DOWNLOAD_LINK_EXPIRY.ago
+  end
+
+  def downloadable?
+    completed? && file.attached?
+  end
+
+  def accessible_to?(_user)
+    true
+  end
+
+  def publicly_accessible?
+    true
+  end
+
+  private
+    def assign_account
+      self.account_id ||= user&.account_id
+    end
+
+    def deliver_ready_email
+      ExportMailer.ready(self).deliver_later
+    rescue => error
+      Rails.logger.error("ExportMailer.ready failed: #{error.message}")
+    end
+
+    def deliver_failed_email(error)
+      ExportMailer.failed(self, error).deliver_later
+    rescue => mailer_error
+      Rails.logger.error("ExportMailer.failed failed: #{mailer_error.message}")
+    end
+end
