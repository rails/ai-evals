+<% @page_title = "Import account" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Import an account</h1>
+
+  <p>Choose a Fizzy account export ZIP file. We’ll create a new account with its boards, cards, comments, files, and people.</p>
+
+  <%= form_with model: @import, url: account_imports_path, method: :post, multipart: true, class: "flex flex-column gap", data: { controller: "form", turbo: false } do |form| %>
+    <% if @import.errors.any? %>
+      <div class="margin-block-half txt-negative txt-small">
+        <ul class="margin-block-none">
+          <% @import.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <label class="input input--actor">
+      <%= form.file_field :file, accept: "application/zip,.zip", required: true, class: "full-width" %>
+    </label>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Import account</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small">You’ll get an email when the import finishes or if it fails.</p>
+</div>
