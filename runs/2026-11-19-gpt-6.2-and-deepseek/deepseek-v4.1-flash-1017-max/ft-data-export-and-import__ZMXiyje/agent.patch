+class Account::DataTransfer::Exporter
+  attr_reader :account, :user, :scope
+
+  def initialize(account:, user: nil, scope: :account)
+    @account = account
+    @user = user
+    @scope = scope
+  end
+
+  def export_to(zip)
+    manifest.export_to(zip)
+  end
+
+  def export(io)
+    writer = ZipFile::Writer.new(io)
+    export_to(writer)
+    writer.close
+    writer
+  end
+
+  def perform(io)
+    export(io)
+  end
+
+  private
+    def manifest
+      @manifest ||= Account::DataTransfer::Manifest.new(account, user: user, scope: scope)
+    end
+end
