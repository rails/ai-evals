diff --git a/test/controllers/data_transfer_smoke_test.rb b/test/controllers/data_transfer_smoke_test.rb
new file mode 100644
index 0000000..cd1f082
--- /dev/null
+++ b/test/controllers/data_transfer_smoke_test.rb
@@ -0,0 +1,163 @@
+require "test_helper"
+
+class DataTransferSmokeTest < ActionDispatch::IntegrationTest
+  test "account export completes and emails a link" do
+    sign_in_as :jason
+
+    assert_difference -> { Export.count }, 1 do
+      post account_export_path
+    end
+
+    export = Export.last
+    assert_redirected_to account_settings_path
+
+    perform_enqueued_jobs { export.perform }
+
+    export.reload
+    assert export.completed?, export.error
+    assert export.file.attached?
+
+    email = ActionMailer::Base.deliveries.last
+    assert email, "expected an email"
+    assert_equal [ users(:jason).identity.email_address ], email.to
+    assert_match %r{/exports/}, email.body.encoded
+  end
+
+  test "export download link works without signing in" do
+    export = Export.create!(account: accounts("37s"), user: users(:jason), scope: "account", status: :completed)
+    export.file.attach(io: StringIO.new("zip"), filename: "export.zip", content_type: "application/zip")
+
+    untenanted do
+      get export_path(export.download_token)
+    end
+
+    assert_response :redirect
+    assert_match %r{rails/active_storage}, response.location
+
+    follow_redirect!
+    assert_response :redirect
+
+    follow_redirect!
+    assert_response :success
+  end
+
+test "export download link expires after one day" do
+  export = Export.create!(account: accounts("37s"), user: users(:jason), scope: "account", status: :completed)
+  export.file.attach(io: StringIO.new("zip"), filename: "export.zip", content_type: "application/zip")
+  token = export.download_token
+
+  travel 25.hours do
+    untenanted do
+      get export_path(token)
+    end
+  end
+
+  assert_response :not_found
+end
+
+test "profile card export can be requested" do
+    sign_in_as :david
+
+    assert_difference -> { Export.count }, 1 do
+      post user_export_path(users(:david))
+    end
+
+    assert_equal "cards", Export.last.scope
+  end
+
+  test "import form renders" do
+    sign_in_as :david
+    get new_account_import_path
+    assert_response :success
+  end
+
+  test "import creates a new account from an export" do
+    source_account = accounts("37s")
+    owner = users(:jason)
+    export = Export.create!(account: source_account, user: owner, scope: "account")
+    perform_enqueued_jobs { export.perform }
+    assert export.completed?, export.error
+
+    import = Import.create!(user: owner, account: source_account)
+    import.file.attach(io: StringIO.new(export.file.download), filename: "account.zip", content_type: "application/zip")
+
+    assert_difference -> { Account.count }, 1 do
+      perform_enqueued_jobs { import.perform }
+    end
+
+    import.reload
+    assert import.completed?, import.error
+    assert_equal source_account.name, import.account.name
+    assert_operator import.account.cards.count, :>, 0
+    assert import.account.users.exists?(identity_id: owner.identity_id)
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ owner.identity.email_address ], email.to
+    assert_match "complete", email.subject
+  end
+
+  test "failed import leaves no account behind" do
+    source_account = accounts("37s")
+    import = Import.create!(user: users(:jason), account: source_account)
+    import.file.attach(io: StringIO.new("not a zip"), filename: "bad.zip", content_type: "application/zip")
+
+    assert_no_difference -> { Account.count } do
+      perform_enqueued_jobs { import.perform }
+    end
+
+    import.reload
+    assert import.failed?
+    assert import.error.present?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_match "failed", email.subject
+  end
+  test "a malformed import leaves no partial account behind" do
+    tempfile = Tempfile.new([ "bad-import", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("account.json", JSON.generate(id: "source-account", name: "Partial Import"))
+    writer.add_file("users/not-json.json", "{ definitely not json")
+    writer.close
+    tempfile.rewind
+
+    import = Import.create!(user: users(:jason), account: accounts("37s"))
+    import.file.attach(io: tempfile, filename: "partial.zip", content_type: "application/zip")
+
+    assert_no_difference -> { Account.count } do
+      perform_enqueued_jobs { import.perform }
+    end
+
+    import.reload
+    assert import.failed?
+    assert import.error.present?
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+  test "can start an import through the web form" do
+    source_account = accounts("37s")
+    owner = users(:jason)
+    export = Export.create!(account: source_account, user: owner, scope: "account")
+    perform_enqueued_jobs { export.perform }
+
+    tempfile = Tempfile.new([ "web-import", ".zip" ])
+    tempfile.binmode
+    tempfile.write(export.file.download)
+    tempfile.rewind
+
+    sign_in_as :jason
+
+    assert_difference -> { Import.count }, 1 do
+      post account_imports_path, params: {
+        import: { file: Rack::Test::UploadedFile.new(tempfile.path, "application/zip") }
+      }
+    end
+
+    assert_redirected_to account_settings_path
+    assert Import.last.file.attached?
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
