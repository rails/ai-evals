 class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransfer::RecordSet
-  def initialize(account)
-    super(account: account, model: ::ActionText::RichText)
+  def initialize(account, records: nil)
+    super(account: account, model: ::ActionText::RichText, records: records)
   end
 
-  private
+  protected
     def records
-      ::ActionText::RichText.where(account: account)
+      @records || ::ActionText::RichText.where(account: account)
+    end
+
+    def export_attributes(record)
+      super.merge("body" => portable_body(record.body&.to_html.to_s))
+    end
+
+    def import_attributes(attributes, account:, id_map:, uploaded_blob_keys:)
+      attributes = super
+      attributes["body"] = restore_body(attributes["body"].to_s, id_map)
+      attributes
+    end
+
+  private
+    def portable_body(body)
+      return body if body.blank? || !body.include?("action-text-attachment")
+
+      fragment = Nokogiri::HTML.fragment(body)
+      fragment.css("action-text-attachment[sgid]").each do |node|
+        if attachable = locate_attachable(node["sgid"])
+          node["sgid"] = "export://#{attachable.class.name}/#{attachable.id}"
+        end
+      end
+      fragment.to_html
     end
 
+    def restore_body(body, id_map)
+      return body if body.blank? || !body.include?("action-text-attachment")
+
+      fragment = Nokogiri::HTML.fragment(body)
+      fragment.css("action-text-attachment[sgid]").each do |node|
+        sgid = node["sgid"]
+
+        if sgid.start_with?("export://")
+          type, old_id = sgid.delete_prefix("export://").split("/", 2)
+          new_id = id_map[old_id]
+          attachable = type.safe_constantize&.find_by(id: new_id) if new_id
+        elsif (source_attachable = locate_attachable(sgid))
+          attachable = source_attachable.class.find_by(id: id_map[source_attachable.id])
+        end
+
+        if attachable.respond_to?(:attachable_sgid)
+          node["sgid"] = attachable.attachable_sgid
+        elsif sgid.start_with?("export://")
+          node.remove_attribute("sgid")
+        end
+      end
+      fragment.to_html
+    end
+
+    def locate_attachable(sgid)
+      ActionText::Attachable.from_attachable_sgid(sgid)
+    rescue ActiveRecord::RecordNotFound, ActiveSupport::MessageVerifier::InvalidSignature
+      locate_unsigned_attachable(sgid)
+    end
+
+    def locate_unsigned_attachable(sgid)
+      gid = GlobalID.parse(sgid)
+      GlobalID::Locator.locate(gid) if gid
+    rescue StandardError
+      nil
+    end
 end
