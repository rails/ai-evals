+require "test_helper"
+
+class BookMaintenanceTest < ActiveSupport::TestCase
+  test "compact_positions preserves hand-arranged order and makes scores dense" do
+    book = books(:handbook)
+    arranged = [
+      leaves(:summary_page),
+      leaves(:welcome_section),
+      leaves(:reading_picture),
+      leaves(:welcome_page)
+    ]
+    arranged.each_with_index { |leaf, index| leaf.update_column(:position_score, (index + 1) * 10) }
+
+    book.compact_positions!
+
+    assert_equal arranged, book.leaves.positioned.reload
+    assert_equal [ 1, 2, 3, 4 ], arranged.map { |leaf| leaf.reload.position_score }
+  end
+
+  test "compact_positions preserves a trashed leaf's place for restoration" do
+    book = books(:handbook)
+    arranged = [
+      leaves(:summary_page),
+      leaves(:welcome_section),
+      leaves(:reading_picture),
+      leaves(:welcome_page)
+    ]
+    arranged.each_with_index { |leaf, index| leaf.update_column(:position_score, (index + 1) * 10) }
+
+    trashed_leaf = leaves(:welcome_section)
+    trashed_leaf.trashed!
+
+    book.compact_positions!
+
+    assert_equal [ leaves(:summary_page), leaves(:reading_picture), leaves(:welcome_page) ],
+      book.leaves.active.positioned.reload
+    assert_equal 3, book.live_leaf_count
+
+    trashed_leaf.active!
+
+    assert_equal arranged, book.leaves.positioned.reload
+    assert_equal 4, book.live_leaf_count
+  end
+end
