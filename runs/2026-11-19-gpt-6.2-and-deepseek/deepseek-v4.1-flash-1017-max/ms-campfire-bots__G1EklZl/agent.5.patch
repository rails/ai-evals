+++ b/test/jobs/bot/webhook_safety_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Bot::WebhookSafetyTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://bot.example.com/webhook")
+    @room = rooms(:pets)
+    @room.memberships.grant_to(@bot)
+    @message = @room.messages.create!(creator: users(:david), body: "<div>#{mention_for(@bot)} run it</div>")
+    clear_enqueued_jobs
+  end
+
+  test "webhook replies count toward the message rate limit" do
+    stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: "Reply", headers: { "Content-Type" => "text/plain" })
+
+    9.times { @room.messages.create!(creator: @bot, body: "Bot message") }
+
+    Bot::WebhookJob.perform_now(@message, @bot)
+
+    assert_equal 10, @bot.messages.where(created_at: 10.seconds.ago..).count
+    assert_equal :rate_limited, @bot.reload.message_posting_status
+  end
+
+  test "does not post a webhook reply during a cooldown" do
+    10.times { @room.messages.create!(creator: @bot, body: "Bot message") }
+    assert_equal :rate_limited, @bot.message_posting_status
+
+    stub_request(:post, @bot.webhook_url)
+      .to_return(status: 200, body: "Reply", headers: { "Content-Type" => "text/plain" })
+
+    assert_no_difference -> { @bot.messages.count } do
+      Bot::WebhookJob.perform_now(@message, @bot)
+    end
+
+    assert_equal 1, @bot.reload.rate_limit_attempts
+  end
+
+  test "suspends after ten consecutive failed deliveries and resets on success" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 500)
+
+    9.times { Bot::WebhookJob.perform_now(@message, @bot) }
+    assert_not @bot.reload.suspended?
+    assert_equal 9, @bot.consecutive_webhook_failures
+
+    stub_request(:post, @bot.webhook_url).to_return(status: 204)
+    Bot::WebhookJob.perform_now(@message, @bot)
+
+    assert_equal 0, @bot.reload.consecutive_webhook_failures
+    assert_not @bot.suspended?
+
+    stub_request(:post, @bot.webhook_url).to_return(status: 500)
+    10.times { Bot::WebhookJob.perform_now(@message, @bot) }
+
+    assert @bot.reload.suspended?
