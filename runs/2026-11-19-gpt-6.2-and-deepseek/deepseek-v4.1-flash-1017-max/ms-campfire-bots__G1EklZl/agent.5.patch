@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Bots::RateLimitingTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+    @room = rooms(:pets)
+    @room.memberships.grant_to(@bot)
+  end
+
+  test "rejects the eleventh message in ten seconds and starts a cooldown" do
+    10.times do
+      post_bot_message
+      assert_response :created
+    end
+
+    assert_no_difference -> { Message.count } do
+      post_bot_message
+    end
+
+    assert_response :too_many_requests
+    assert_operator response.headers["Retry-After"].to_i, :>, 0
+    assert_operator response.headers["Retry-After"].to_i, :<=, 30
+  end
+
+  test "five attempts during the same cooldown suspend the bot" do
+    10.times { post_bot_message }
+    post_bot_message
+    assert_response :too_many_requests
+
+    Bot::COOLDOWN_ATTEMPT_SUSPENSION_LIMIT.times do
+      assert_no_difference -> { Message.count } do
+        post_bot_message
+      end
+
+      assert_response :too_many_requests
+    end
+
+    assert @bot.reload.suspended?
+    assert_match(/cooldown/i, @bot.suspension_reason)
+
+    post_bot_message
+    assert_response :forbidden
+  end
+
+  test "allows posting again after the cooldown expires" do
+    10.times { post_bot_message }
+    post_bot_message
+    assert_response :too_many_requests
+
+    travel_to 31.seconds.from_now do
+      post_bot_message
+      assert_response :created
+    end
+  end
+
+  private
+    def post_bot_message
+      post bot_room_messages_url(@room, @bot.bot_code), params: "Hello", headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+end
