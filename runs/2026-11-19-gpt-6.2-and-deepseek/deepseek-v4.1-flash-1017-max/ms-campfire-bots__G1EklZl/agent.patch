diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..20b45a8
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,54 @@
+class Bots::MessagesController < ApplicationController
+  allow_unauthenticated_access only: :create
+  skip_forgery_protection only: :create
+
+  before_action :set_bot, :set_room
+
+  def create
+    case @bot.message_posting_status
+    when :suspended
+      head :forbidden
+    when :rate_limited
+      response.headers["Retry-After"] = @bot.retry_after_seconds.to_s
+      head :too_many_requests
+    else
+      body = message_body
+      attachment = params[:attachment]
+
+      if body.blank? && attachment.blank?
+        head :unprocessable_content
+      else
+        @message = @room.messages.create_with_attachment!(creator: @bot, body: body, attachment: attachment)
+        @message.broadcast_create
+
+        head :created, location: message_path(@message)
+      end
+    end
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_content
+  end
+
+  private
+    def message_body
+      if request.media_type == "multipart/form-data"
+        params[:body].to_s
+      else
+        request.raw_post.dup.force_encoding(Encoding::UTF_8)
+      end
+    end
+
+    def set_bot
+      @bot = Bot.find_by(bot_code: params[:bot_code])
+
+      if @bot.nil? || !@bot.active?
+        head :unauthorized
+      elsif @bot.suspended?
+        head :forbidden
+      end
+    end
+
+    def set_room
+      @room = @bot&.rooms&.find_by(id: params[:room_id])
+      head :not_found unless @room
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..1e69440
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,75 @@
+class BotsController < ApplicationController
+  rescue_from ActiveRecord::RecordNotFound, with: :not_found
+
+  before_action :ensure_administrator, only: :reactivate
+  before_action :set_bot, only: %i[ edit update destroy reactivate ]
+  before_action :ensure_bot_limit_not_reached, only: %i[ new create ]
+
+  def index
+    @bots = bots_scope.ordered
+    @bot_limit = Current.user.bot_limit
+    @bot_limit_reached = Current.user.bot_limit_reached?
+  end
+
+  def new
+    @bot = Current.user.bots.new
+  end
+
+  def create
+    @bot = Current.user.bots.new(bot_params)
+
+    if @bot.save
+      redirect_to bots_path
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_path
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def reactivate
+    @bot.reactivate!
+    redirect_to bots_path, notice: "#{@bot.name} has been reactivated."
+  end
+
+  def destroy
+    @bot.destroy!
+    redirect_to bots_path
+  end
+
+  private
+    def set_bot
+      @bot = bots_scope.find(params[:id])
+    end
+
+    def bots_scope
+      Current.user.administrator? ? Bot.all : Current.user.bots
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar, :webhook_url, :add_to_all_open_rooms)
+    end
+
+    def ensure_bot_limit_not_reached
+      if Current.user.bot_limit_reached?
+        redirect_to bots_path, alert: "You've reached the limit of #{Current.user.bot_limit} chat bots."
+      end
+    end
+
+    def ensure_administrator
+      head :forbidden unless Current.user.administrator?
+    end
+
+    def not_found
+      head :not_found
+    end
+end
