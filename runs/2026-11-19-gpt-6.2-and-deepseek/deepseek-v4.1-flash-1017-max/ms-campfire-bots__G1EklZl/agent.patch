@@ -0,0 +1,120 @@
+require "test_helper"
+
+class BotsLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    @member = users(:kevin)
+    sign_in :kevin
+  end
+
+  test "bots per member setting defaults to 5 and can be updated by administrators" do
+    assert_equal 5, accounts(:signal).settings.bots_per_member
+
+    sign_in :david
+    get edit_account_url
+
+    assert_response :success
+    assert_select "label", text: "Bots per member"
+    assert_select "input[type='number'][name='account[settings][bots_per_member]'][value='5']"
+
+    put account_url, params: { account: { settings: { bots_per_member: "2" } } }
+
+    assert_redirected_to edit_account_url
+    assert_equal 2, accounts(:signal).reload.settings.bots_per_member
+  end
+
+  test "only administrators can see the bots per member setting" do
+    get edit_account_url
+
+    assert_response :success
+    assert_select "label", text: "Bots per member", count: 0
+    assert_select "input[name='account[settings][bots_per_member]']", count: 0
+  end
+
+  test "members can create up to the limit but not beyond it" do
+    set_bot_limit 1
+
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "First Bot" } }
+    end
+    assert_redirected_to bots_url
+
+    get bots_url
+
+    assert_response :success
+    assert_select "a", text: "Add a chat bot", count: 0
+    assert_select "p", text: /reached the limit/
+
+    get new_bot_url
+
+    assert_redirected_to bots_url
+    assert_includes flash[:alert], "reached the limit"
+
+    assert_no_difference -> { Bot.count } do
+      post bots_url, params: { bot: { name: "Second Bot" } }
+    end
+
+    assert_redirected_to bots_url
+    assert_includes flash[:alert], "reached the limit"
+  end
+
+  test "the model refuses direct bot creation at the limit" do
+    set_bot_limit 1
+    create_bot(@member, "First Bot")
+
+    bot = Bot.new(name: "Second Bot", creator: @member)
+
+    assert_not bot.save
+    assert_includes bot.errors.full_messages.join, "reached the limit"
+  end
+
+  test "deleted bots free up capacity" do
+    set_bot_limit 1
+    bot = create_bot(@member, "First Bot")
+
+    bot.destroy!
+
+    get bots_url
+
+    assert_select "a", text: "Add a chat bot"
+  end
+
+  test "lowering the limit does not remove existing bots or allow more" do
+    account = Account.first
+    account.settings.bots_per_member = 5
+    account.save!
+    3.times { |i| create_bot(@member, "Existing Bot #{i}") }
+
+    sign_in :david
+    put account_url, params: { account: { settings: { bots_per_member: "1" } } }
+
+    assert_redirected_to edit_account_url
+    assert_equal 1, account.reload.settings.bots_per_member
+    assert_equal 3, @member.bots.count
+
+    sign_in :kevin
+    get bots_url
+
+    assert_select "a", text: "Add a chat bot", count: 0
+  end
+
+  test "administrators are not limited" do
+    sign_in :david
+    set_bot_limit 1
+    6.times { |i| create_bot(users(:david), "Admin Bot #{i}") }
+
+    get bots_url
+
+    assert_select "a", text: "Add a chat bot"
+  end
+
+  private
+    def set_bot_limit(limit)
+      account = Account.first
+      account.settings.bots_per_member = limit
+      account.save!
+    end
+
+    def create_bot(creator, name)
+      Bot.create!(name: name, creator: creator)
+    end
+end
diff --git a/test/jobs/bot/webhook_job_test.rb b/test/jobs/bot/webhook_job_test.rb
new file mode 100644
index 0000000..712ebd9
--- /dev/null
+++ b/test/jobs/bot/webhook_job_test.rb
@@ -0,0 +1,143 @@
+require "test_helper"
+
+class Bot::WebhookJobTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://bot.example.com/webhook")
+    @room = rooms(:pets)
+    @room.memberships.grant_to(@bot)
+    clear_enqueued_jobs
+    @url = "https://bot.example.com/webhook"
+  end
+
+  test "posts mention payload and creates a message from a text response" do
+    request_body = nil
+    stub_request(:post, @url)
+      .with(headers: { "Content-Type" => "application/json" }) do |request|
+        request_body = JSON.parse(request.body)
+      end
+      .to_return(status: 200, body: "Build restarted", headers: { "Content-Type" => "text/plain" })
+
+    message = @room.messages.create!(creator: users(:david), body: "<div>#{mention_for(@bot)} restart the build please</div>")
+
+    assert_enqueued_jobs 1, only: Bot::WebhookJob
+    assert_difference -> { Message.count }, 1 do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+
+    assert_equal "mention", request_body["event"]
+    assert_equal({ "id" => users(:david).id, "name" => "David" }, request_body["author"])
+    assert_equal @room.id, request_body["room"]["id"]
+    assert_equal @room.name, request_body["room"]["name"]
+    assert_equal "/rooms/#{@room.id}/#{@bot.bot_code}/messages", request_body["room"]["reply_to"]
+    assert_equal message.id, request_body["message"]["id"]
+    assert_equal "restart the build please", request_body["message"]["body"]["text"]
+    assert_includes request_body["message"]["body"]["html"], "restart the build please"
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", request_body["message"]["link"]
+
+    reply = Message.last
+    assert_equal @bot, reply.creator
+    assert_equal "Build restarted", reply.body.to_plain_text
+  end
+
+  test "does not create a message for a 204 response" do
+    stub_request(:post, @url).to_return(status: 204)
+
+    @room.messages.create!(creator: users(:david), body: "<div>#{mention_for(@bot)} ping</div>")
+
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+  test "does not enqueue a webhook job when the bot has no webhook URL" do
+    @bot.update!(webhook_url: nil)
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      @room.messages.create!(creator: users(:david), body: "<div>#{mention_for(@bot)} ping</div>")
+    end
+  end
+
+  test "posts an HTML response body as the bot message" do
+    stub_request(:post, @url)
+      .to_return(status: 200, body: "<strong>Build restarted</strong>", headers: { "Content-Type" => "text/html" })
+
+    @room.messages.create!(creator: users(:david), body: "<div>#{mention_for(@bot)} restart</div>")
+    perform_enqueued_jobs only: Bot::WebhookJob
+
+    assert_equal @bot, Message.last.creator
+    assert_includes Message.last.body.to_s, "<strong>Build restarted</strong>"
+  end
+
+  test "does not post a response with an unsupported content type" do
+    stub_request(:post, @url)
+      .to_return(status: 200, body: '{"ok":true}', headers: { "Content-Type" => "application/json" })
+
+    @room.messages.create!(creator: users(:david), body: "<div>#{mention_for(@bot)} status</div>")
+
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+test "posts a joined payload exactly once per room and creates a reply" do
+  room = rooms(:designers)
+  request_body = nil
+  stub_request(:post, @url)
+    .with(headers: { "Content-Type" => "application/json" }) do |request|
+      request_body = JSON.parse(request.body)
+    end
+    .to_return(status: 200, body: "Hello from the bot", headers: { "Content-Type" => "text/plain" })
+
+  assert_enqueued_jobs 1, only: Bot::WebhookJob do
+    room.memberships.grant_to(@bot)
+  end
+
+  perform_enqueued_jobs only: Bot::WebhookJob
+
+  assert_equal({
+    "event" => "joined",
+    "room" => {
+      "id" => room.id,
+      "name" => room.name,
+      "reply_to" => "/rooms/#{room.id}/#{@bot.bot_code}/messages"
+    }
+  }, request_body)
+
+  reply = Message.last
+  assert_equal @bot, reply.creator
+  assert_equal room, reply.room
+  assert_equal "Hello from the bot", reply.plain_text_body
+
+  assert_no_enqueued_jobs only: Bot::WebhookJob do
+    room.memberships.grant_to(@bot)
+  end
+end
+
+test "does not enqueue joined events for direct rooms" do
+  assert_no_enqueued_jobs only: Bot::WebhookJob do
+    rooms(:david_and_jason).memberships.grant_to(@bot)
+  end
+end
+
+test "opting a bot into all open rooms emits one joined event per room" do
