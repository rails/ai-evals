+require "test_helper"
+
+class Bots::SuspensionManagementTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+    @room = rooms(:pets)
+    @room.memberships.grant_to(@bot)
+    @room.messages.create!(creator: @bot, body: "Still here")
+    @bot.update!(suspended_at: Time.current, suspension_reason: "10 consecutive webhook delivery failures.")
+  end
+
+  test "administrators see the suspended state, reason, and reactivate button" do
+    sign_in :david
+
+    get bots_url
+
+    assert_response :success
+    assert_select "li##{dom_id(@bot)}", text: /Suspended/
+    assert_select "li##{dom_id(@bot)}", text: /10 consecutive webhook delivery failures/
+    assert_select "button", text: "Reactivate"
+    assert_select "button[data-turbo-confirm]"
+  end
+
+  test "administrators can reactivate a suspended bot" do
+    sign_in :david
+
+    patch reactivate_bot_url(@bot)
+
+    assert_redirected_to bots_url
+    assert_not @bot.reload.suspended?
+    assert_nil @bot.suspension_reason
+    assert_equal [ @room ], @bot.rooms
+    assert_equal 1, @bot.messages.count
+  end
+
+  test "members cannot reactivate even their own suspended bots" do
+    member_bot = Bot.create!(name: "Member Bot", creator: users(:kevin))
+    member_bot.update!(suspended_at: Time.current, suspension_reason: "Too many attempts")
+
+    sign_in :kevin
+    get bots_url
+    assert_select "button", text: "Reactivate", count: 0
+
+    patch reactivate_bot_url(member_bot)
+
+    assert_response :forbidden
+    assert member_bot.reload.suspended?
+  end
+
+  private
+    def dom_id(bot)
+      ActionView::RecordIdentifier.dom_id(bot)
+    end
+end
