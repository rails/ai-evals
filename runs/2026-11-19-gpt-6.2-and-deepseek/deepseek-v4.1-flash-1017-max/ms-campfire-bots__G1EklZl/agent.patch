+<% @page_title = "Chat bots" %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to edit_account_path %>
+  </div>
+
+  <div class="flex align-center gap flex-item-justify-end">
+    <% unless @bot_limit_reached %>
+      <%= link_to new_bot_path, class: "btn" do %>
+        <%= image_tag "add.svg", aria: { hidden: "true" }, size: 20, class: "colorize--black" %>
+        <span>Add a chat bot</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
+
+<section class="panel flex flex-column gap">
+  <h1 class="txt-x-large">Chat bots</h1>
+
+  <% if @bot_limit_reached %>
+    <p class="txt-subtle">You've reached the limit of <%= @bot_limit %> chat bots. Delete a bot to free up space.</p>
+  <% end %>
+
+  <% if @bots.any? %>
+    <menu class="flex flex-column gap margin-none pad full-width">
+      <% @bots.each do |bot| %>
+        <li id="<%= dom_id(bot) %>" class="flex align-center gap margin-none pad-block border-radius fill-shade">
+          <figure class="avatar flex-item-no-shrink" style="--avatar-size: 3.75ch;">
+            <%= image_tag fresh_user_avatar_path(bot), alt: "", loading: :lazy, size: 48 %>
+          </figure>
+
+          <div class="flex-item-grow min-width flex flex-column gap" style="--row-gap: 0.25em">
+            <div class="flex align-center gap">
+              <strong><%= bot.name %></strong>
+              <% if bot.suspended? %>
+                <span class="txt-small">Suspended</span>
+              <% end %>
+            </div>
+
+            <% if bot.suspended? %>
+              <p class="txt-small txt-subtle">Reason: <%= bot.suspension_reason %></p>
+            <% end %>
+
+            <label for="<%= dom_id(bot, :bot_code) %>" class="txt-small">Bot code</label>
+            <input id="<%= dom_id(bot, :bot_code) %>" type="text" class="input txt-small" value="<%= bot.bot_code %>" readonly>
+          </div>
+
+          <div class="flex align-center gap flex-item-no-shrink">
+            <% if bot.suspended? && Current.user.administrator? %>
+              <%= button_to "Reactivate", reactivate_bot_path(bot), method: :patch, class: "btn txt-small",
+                    data: { turbo_confirm: "Are you sure you want to reactivate this bot?" } %>
+            <% end %>
+
+            <%= link_to "Edit #{bot.name}", edit_bot_path(bot), class: "btn txt-small" %>
+          </div>
+        </li>
+      <% end %>
+    </menu>
+  <% else %>
+    <p class="txt-subtle">You haven't set up any chat bots yet.</p>
+  <% end %>
+</section>
