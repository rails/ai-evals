@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Bots::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "new and edit forms have a webhook URL field" do
+    bot = create_bot(webhook_url: "https://bot.example.com/webhook")
+
+    get new_bot_url
+    assert_response :success
+    assert_select "label", text: "Webhook URL"
+    assert_select "input[type='url'][name='bot[webhook_url]'][placeholder='Webhook URL']"
+
+    get edit_bot_url(bot)
+    assert_response :success
+    assert_select "input[type='url'][name='bot[webhook_url]'][value='https://bot.example.com/webhook']"
+  end
+
+  test "update saves a webhook URL" do
+    bot = create_bot
+
+    patch bot_url(bot), params: { bot: { name: bot.name, webhook_url: "https://bot.example.com/webhook" } }
+
+    assert_redirected_to bots_url
+    assert_equal "https://bot.example.com/webhook", bot.reload.webhook_url
+  end
+
+  test "update with a blank webhook URL removes it" do
+    bot = create_bot(webhook_url: "https://bot.example.com/webhook")
+
+    patch bot_url(bot), params: { bot: { name: bot.name, webhook_url: "" } }
+
+    assert_redirected_to bots_url
+    assert_nil bot.reload.webhook_url
+  end
+
+  private
+    def create_bot(webhook_url: nil)
+      Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: webhook_url)
+    end
+end
diff --git a/test/jobs/bot/webhook_job_test.rb b/test/jobs/bot/webhook_job_test.rb
new file mode 100644
index 0000000..6db88aa
--- /dev/null
+++ b/test/jobs/bot/webhook_job_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class Bot::WebhookJobTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://bot.example.com/webhook")
+    @room = rooms(:pets)
+    @url = "https://bot.example.com/webhook"
+  end
+
+  test "posts mention payload and creates a message from a text response" do
+    request_body = nil
+    stub_request(:post, @url)
+      .with(headers: { "Content-Type" => "application/json" }) do |request|
+        request_body = JSON.parse(request.body)
+      end
+      .to_return(status: 200, body: "Build restarted", headers: { "Content-Type" => "text/plain" })
+
+    message = @room.messages.create!(creator: users(:david), body: "<div>#{mention_for(@bot)} restart the build please</div>")
+
+    assert_enqueued_jobs 1, only: Bot::WebhookJob
+    assert_difference -> { Message.count }, 1 do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+
+    assert_equal "mention", request_body["event"]
+    assert_equal({ "id" => users(:david).id, "name" => "David" }, request_body["author"])
+    assert_equal @room.id, request_body["room"]["id"]
+    assert_equal @room.name, request_body["room"]["name"]
+    assert_equal "/rooms/#{@room.id}/#{@bot.bot_code}/messages", request_body["room"]["reply_to"]
+    assert_equal message.id, request_body["message"]["id"]
+    assert_equal "restart the build please", request_body["message"]["body"]["text"]
+    assert_includes request_body["message"]["body"]["html"], "restart the build please"
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", request_body["message"]["link"]
+
+    reply = Message.last
+    assert_equal @bot, reply.creator
+    assert_equal "Build restarted", reply.body.to_plain_text
+  end
+
+  test "does not create a message for a 204 response" do
+    stub_request(:post, @url).to_return(status: 204)
+
+    @room.messages.create!(creator: users(:david), body: "<div>#{mention_for(@bot)} ping</div>")
+
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+  test "does not enqueue a webhook job when the bot has no webhook URL" do
+    @bot.update!(webhook_url: nil)
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      @room.messages.create!(creator: users(:david), body: "<div>#{mention_for(@bot)} ping</div>")
+    end
+  end
+
+  test "posts an HTML response body as the bot message" do
+    stub_request(:post, @url)
+      .to_return(status: 200, body: "<strong>Build restarted</strong>", headers: { "Content-Type" => "text/html" })
+
+    @room.messages.create!(creator: users(:david), body: "<div>#{mention_for(@bot)} restart</div>")
+    perform_enqueued_jobs only: Bot::WebhookJob
+
+    assert_equal @bot, Message.last.creator
+    assert_includes Message.last.body.to_s, "<strong>Build restarted</strong>"
+  end
+
+  test "does not post a response with an unsupported content type" do
+    stub_request(:post, @url)
+      .to_return(status: 200, body: '{"ok":true}', headers: { "Content-Type" => "application/json" })
+
+    @room.messages.create!(creator: users(:david), body: "<div>#{mention_for(@bot)} status</div>")
+
+    assert_no_difference -> { Message.count } do
+      perform_enqueued_jobs only: Bot::WebhookJob
+    end
+  end
+
+  private
+    def mention_for(user)
+      attachment_body = ApplicationController.render partial: "users/mention", locals: { user: user }
+      "<action-text-attachment sgid=\"#{user.attachable_sgid}\" content-type=\"application/vnd.campfire.mention\" content=\"#{attachment_body.gsub('"', '&quot;')}\"></action-text-attachment>"
+    end
+end
