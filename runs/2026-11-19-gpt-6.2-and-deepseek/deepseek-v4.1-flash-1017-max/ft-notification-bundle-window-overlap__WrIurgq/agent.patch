diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..b649c6b
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,142 @@
+class Notification::Bundle < ApplicationRecord
+  FREQUENCIES = %w[ every_few_hours daily weekly ].freeze
+  FREQUENCY_DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, class_name: "Notification", foreign_key: :bundle_id,
+    inverse_of: :bundle, dependent: :nullify
+
+  enum :frequency, FREQUENCIES.index_by(&:itself)
+
+  alias_attribute :start_at, :starts_at
+  alias_attribute :started_at, :starts_at
+  alias_attribute :end_at, :ends_at
+  alias_attribute :finished_at, :ends_at
+  alias_attribute :deliver_at, :ends_at
+  alias_attribute :sent_at, :delivered_at
+
+  before_validation :set_frequency, on: :create
+  validate :window_does_not_overlap, on: :create
+
+  scope :open, -> { where(open: true) }
+  scope :pending, -> { open }
+  scope :undelivered, -> { open }
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :due, -> { open.where(ends_at: ..Time.current) }
+
+  after_create_commit :schedule_delivery
+
+  class << self
+    def bundle(notification)
+      user = notification.user
+
+      if user.settings&.bundle_emails?
+        user.settings.with_lock do
+          open_bundle = open.find_by(user: user)
+
+          if open_bundle
+            notification.update_column(:bundle_id, open_bundle.id)
+            open_bundle
+          else
+            create_bundle_for(notification)
+          end
+        end
+      end
+    rescue ActiveRecord::RecordNotUnique
+      retry
+    end
+
+    def open_for(user)
+      open.find_by(user: user)
+    end
+    alias current_for open_for
+
+    def for(user)
+      open_for(user)
+    end
+
+    private
+      def create_bundle_for(notification)
+        user = notification.user
+        settings = user.settings
+        notification_time = notification.previously_new_record? ? (notification.created_at || Time.current) : Time.current
+        starts_at = [ notification_time, where(user: user).maximum(:ends_at) ].compact.max
+        frequency = settings.bundle_email_frequency
+
+        create!(
+          user: user,
+          account: user.account,
+          frequency: frequency,
+          starts_at: starts_at,
+          ends_at: starts_at + settings.bundle_email_frequency_duration
+        ).tap do |bundle|
+          notification.update_column(:bundle_id, bundle.id)
+        end
+      end
+  end
+
+  def deliver
+    user.settings.with_lock do
+      with_lock do
+        return if delivered?
+
+        if deliverable?
+          NotificationMailer.bundle(self).deliver_now
+        end
+
+        update_columns(delivered_at: Time.current, open: nil, updated_at: Time.current)
+      end
+    end
+  end
+  alias deliver_now deliver
+
+  def deliver_later
+    Notification::Bundle::DeliverJob.perform_later(self)
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def due?
+    !delivered? && ends_at <= Time.current
+  end
+
+  def duration
+    ends_at - starts_at
+  end
+
+  def overlaps?(other)
+    starts_at < other.ends_at && other.starts_at < ends_at
+  end
+
+  private
+    def set_frequency
+      setting = user&.settings&.bundle_email_frequency
+      self.frequency ||= setting if FREQUENCIES.include?(setting)
+    end
+
+    def window_does_not_overlap
+      if user && starts_at && ends_at
+        overlapping = self.class.where(user_id: user_id).where.not(id: id)
+          .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+
+        if overlapping.exists?
+          errors.add(:base, "window overlaps an existing notification window")
+        end
+      end
+    end
+
+    def schedule_delivery
+      Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+    end
+
+    def deliverable?
+      notifications.exists? && user.active? && account.active? && user.identity&.email_address.present?
+    end
+end
