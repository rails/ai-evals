diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..d70162b
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,33 @@
+class NotificationMailer < ApplicationMailer
+  def bundle(bundle)
+    prepare_bundle(bundle)
+    mail to: @user.identity.email_address, subject: subject
+  end
+
+  def digest(bundle)
+    prepare_bundle(bundle)
+    mail to: @user.identity.email_address, subject: subject, template_name: "bundle"
+  end
+  alias notifications_digest digest
+
+  private
+    def prepare_bundle(bundle)
+      if bundle.is_a?(Notification::Bundle)
+        @bundle = bundle
+        @notifications = bundle.notifications.preloaded.to_a
+      else
+        @notifications = Array(bundle)
+        @bundle = @notifications.first.bundle
+      end
+
+      @user = @bundle.user
+    end
+
+    def subject
+      if @notifications.one?
+        "1 new notification in Fizzy"
+      else
+        "#{@notifications.size} new notifications in Fizzy"
+      end
+    end
+end
