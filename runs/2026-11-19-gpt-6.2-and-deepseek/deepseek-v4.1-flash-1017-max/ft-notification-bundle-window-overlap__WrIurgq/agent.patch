+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  teardown { travel_back }
+
+  setup do
+    @user = users(:kevin)
+    @settings = @user.settings
+    @user.notifications.destroy_all
+    Notification::Bundle.delete_all
+  end
+
+  test "does not bundle notifications when email frequency is never" do
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification(events(:logo_published))
+    end
+  end
+
+  test "opens a window when the first notification arrives" do
+    @settings.update!(bundle_email_frequency: "daily")
+    now = Time.zone.parse("2026-07-10 12:00:00")
+
+    travel_to now do
+      notification = create_notification(events(:logo_published))
+      bundle = notification.bundle
+
+      assert_predicate bundle, :open?
+      assert_equal now, bundle.starts_at
+      assert_equal now + 1.day, bundle.ends_at
+      assert_equal "daily", bundle.frequency
+      assert_equal bundle, Notification::Bundle.open_for(@user)
+    end
+  end
+
+test "schedules delivery at the end of the first window" do
+  @settings.update!(bundle_email_frequency: "every_few_hours")
+  now = Time.zone.parse("2026-07-10 12:00:00")
+
+  travel_to now do
+    assert_enqueued_with(job: Notification::Bundle::DeliverJob, at: now + 4.hours) do
+      create_notification(events(:logo_published))
+    end
+  end
+end
+
+  test "subsequent and late notifications join the already opened window" do
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+    start = Time.zone.parse("2026-07-10 12:00:00")
+
+    travel_to start
+    first = create_notification(events(:logo_published))
+    bundle = first.bundle
+
+    travel_to start + 5.hours
+    second = create_notification(events(:layout_commented))
+
+    assert_equal bundle, second.bundle
+    assert_equal 1, Notification::Bundle.count
+    assert_equal [ first, second ], bundle.notifications.order(:created_at).to_a
+  end
+
+  test "delivery sends one email for all notifications in the window and closes it" do
+    @settings.update!(bundle_email_frequency: "daily")
+
+    travel_to Time.zone.parse("2026-07-10 12:00:00") do
+      create_notification(events(:logo_published))
+      create_notification(events(:layout_commented))
+    end
+
+    bundle = Notification::Bundle.open_for(@user)
+
+    assert_emails 1 do
+      bundle.deliver
+    end
+
+    assert_predicate bundle.reload, :delivered?
+    assert_nil Notification::Bundle.open_for(@user)
+    assert_equal [ @user.identity.email_address ], ActionMailer::Base.deliveries.last.to
+  end
+
+  test "a new window opens after the previous one is delivered" do
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+    first_bundle = nil
+
+    travel_to Time.zone.parse("2026-07-10 12:00:00")
+    first = create_notification(events(:logo_published))
+    first_bundle = first.bundle
+    first_bundle.deliver
+
+    travel_to Time.zone.parse("2026-07-10 17:00:00")
+    second = create_notification(events(:layout_commented))
+
+    assert_not_equal first_bundle, second.bundle
+    assert_predicate second.bundle, :open?
+  end
+
+test "does not open a window that overlaps an existing window" do
+  @settings.update!(bundle_email_frequency: "every_few_hours")
+
+  travel_to Time.zone.parse("2026-07-10 12:00:00") do
+    bundle = create_notification(events(:logo_published)).bundle
+    assert_equal Time.zone.parse("2026-07-10 16:00:00"), bundle.ends_at
+
+    bundle.deliver
+
+    travel_to Time.zone.parse("2026-07-10 14:00:00")
+    next_bundle = create_notification(events(:layout_commented)).bundle
+
+    assert_equal Time.zone.parse("2026-07-10 16:00:00"), next_bundle.starts_at
+    assert_not bundle.overlaps?(next_bundle)
+  end
+end
+
+test "turning email notifications off closes the open window without sending" do
+  @settings.update!(bundle_email_frequency: "daily")
+  bundle = create_notification(events(:logo_published)).bundle
+
+  assert_no_emails do
+    @settings.update!(bundle_email_frequency: "never")
+    bundle.deliver
+  end
+
+  assert_predicate bundle.reload, :delivered?
+end
