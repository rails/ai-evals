index 0000000..2edd111
--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @notification = Notification.create!(
+      user: @user, source: events(:logo_published), creator: events(:logo_published).creator, unread_count: 1
+    )
+    @bundle = @notification.bundle
+  end
+
+  test "bundle is addressed to the notification recipient" do
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match @notification.payload.title, email.text_part.body.to_s
+    assert_match @notification.payload.url, email.text_part.body.to_s
+    assert email.html_part.present?
+    assert email.text_part.present?
+  end
+
+  test "digest renders the same bundle email" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match @notification.payload.title, email.text_part.body.to_s
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
