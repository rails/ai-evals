+++ b/docs/api/sections/activities.md
@@ -0,0 +1,61 @@
+# Activities
+
+Activities are the events shown in the account's activity timeline, such as cards being published, assigned, moved, closed, or commented on.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity the current user can access, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by activity creator ID(s) |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5v9zkft4hj9qq0lsn9ohde",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.401Z",
+    "description": "David assigned Kevin to \"First!\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a7"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq2",
+      "number": 1,
+      "title": "First!",
+      "status": "published"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson"
+    }
+  }
+]
+```
+
+The `eventable`, `board`, and `creator` objects use the same representations as their respective API endpoints.
+
+`particulars` contains action-specific details:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Other actions return an empty `particulars` object. Missing board, title, or column values are returned as empty strings.
+
+For card events, `url` opens the card. For comment events, `url` opens the card where the comment was posted and jumps to that comment.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..6d7567f
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,206 @@
+require "test_helper"
+
+class ActivitiesEndpointTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns a flat, newest-first activity list" do
+    events(:logo_published).update_columns(action: "card_collection_changed")
+    events(:shipping_closed).update_columns(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } },
+      created_at: 1.minute.ago
+    )
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    actions = @response.parsed_body.map { |event| event["action"] }
+    assert_not_includes actions, "card_collection_changed"
+    assert_includes actions, "card_title_changed"
+
+    created_at = @response.parsed_body.map { |event| event["created_at"] }
+    assert_equal created_at.sort.reverse, created_at
+  end
+
+  test "index includes the expected event representation" do
+    get activities_path, as: :json
+
+    event = events(:logo_published)
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url], activity.keys.sort
+    assert_equal "card_published", activity["action"]
+    assert_equal event.created_at.utc.as_json, activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(event.card), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal event.card.id, activity.dig("eventable", "id")
+    assert_equal event.board.id, activity.dig("board", "id")
+    assert_equal event.creator.id, activity.dig("creator", "id")
+  end
+
+  test "comment events link to the comment on its card" do
+    get activities_path, as: :json
+
+    event = events(:layout_commented)
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal event.eventable.id, activity.dig("eventable", "id")
+    assert_equal card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable)), activity["url"]
+  end
+
+  test "exposes event-specific particulars" do
+    events(:logo_assignment_jz).update_columns(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Old board", "new_board" => "New board" } }
+    )
+    events(:shipping_closed).update_columns(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+    )
+    events(:text_published).update_columns(
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In Progress" } }
+    )
+
+    get activities_path, as: :json
+
+    assert_equal({ "assignee_ids" => [ users(:kevin).id ] }, @response.parsed_body.find { |item| item["id"] == events(:logo_assignment_km).id }["particulars"])
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, @response.parsed_body.find { |item| item["id"] == events(:logo_assignment_jz).id }["particulars"])
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, @response.parsed_body.find { |item| item["id"] == events(:shipping_closed).id }["particulars"])
+    assert_equal({ "column" => "In Progress" }, @response.parsed_body.find { |item| item["id"] == events(:text_published).id }["particulars"])
+  end
+
+  test "filters by creator and board" do
+    get activities_path, params: { creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ] }, as: :json
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    @response.parsed_body.each do |activity|
+      assert_equal users(:david).id, activity.dig("creator", "id")
+      assert_equal boards(:writebook).id, activity.dig("board", "id")
+    end
+  end
+
+  test "only returns activity from boards the current user can access" do
+    private_event = Event.create!(
+      account: accounts("37s"),
+      board: boards(:private),
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_published"
+    )
+
+    get activities_path, as: :json
+    assert_includes @response.parsed_body.map { |activity| activity["id"] }, private_event.id
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+
+    assert_not_includes @response.parsed_body.map { |activity| activity["id"] }, private_event.id
+  end
+end
+
+class ActivitiesEndpointPaginationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "paginates activities and provides a next page link" do
+    20.times do |index|
+      Event.create!(
+        account: accounts("37s"),
+        board: boards(:writebook),
+        creator: users(:kevin),
+        eventable: cards(:logo),
+        action: "card_published",
+        created_at: (index + 1).minutes.ago
+      )
+    end
+
+    get activities_path, as: :json
+    assert_response :success
+    first_page_ids = @response.parsed_body.map { |activity| activity["id"] }
+    next_page = @response.headers["Link"].match(/<([^>]+)>; rel="next"/).captures.first
+
+    get URI.parse(next_page).request_uri, as: :json
+    assert_response :success
+    second_page_ids = @response.parsed_body.map { |activity| activity["id"] }
+
+    assert_equal 15, first_page_ids.size
+    assert_equal 16, second_page_ids.size
+    assert_empty first_page_ids & second_page_ids
+  end
+end
+
+
+class ActivitiesEndpointParticularsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "uses empty strings for missing values" do
+    events(:logo_assignment_jz).update_columns(action: "card_board_changed", particulars: {})
+    events(:shipping_closed).update_columns(action: "card_title_changed", particulars: {})
+    events(:text_published).update_columns(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, find_activity(events(:logo_assignment_jz))["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, find_activity(events(:shipping_closed))["particulars"])
+    assert_equal({ "column" => "" }, find_activity(events(:text_published))["particulars"])
+  end
+
+  private
+    def find_activity(event)
+      @response.parsed_body.find { |activity| activity["id"] == event.id }
+    end
+end
+
+class ActivitiesEndpointSentBackToTriageTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "sent-back-to-triage events have empty particulars" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |item| item["id"] == events(:buy_domain_sent_back_to_triage).id }
+    assert_equal({}, activity["particulars"])
+  end
+end
+
+class ActivitiesEndpointRouteTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "serves activities at the account-scoped JSON path" do
+    get "/#{accounts("37s").external_account_id}/activities.json"
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+end
+
+class ActivitiesEndpointDescriptionTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "descriptions use the current user's perspective" do
+    get activities_path, as: :json
+
+    event = events(:logo_assignment_km)
+    activity = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_includes activity["description"], "will handle"
+  end
+end
