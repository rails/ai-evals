@@ -0,0 +1,39 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events.preloaded
+        .where(account: Current.account, action: ACTIVITY_ACTIONS)
+        .order(created_at: :desc, id: :desc)
+
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+      events
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
diff --git a/app/helpers/activities_helper.rb b/app/helpers/activities_helper.rb
new file mode 100644
index 0000000..a0d2174
--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,35 @@
+module ActivitiesHelper
+  def activity_particulars(event)
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: event.assignee_ids || [] }
+    when "card_board_changed"
+      {
+        old_board: particular_value(event, "old_board"),
+        new_board: particular_value(event, "new_board")
+      }
+    when "card_title_changed"
+      {
+        old_title: particular_value(event, "old_title"),
+        new_title: particular_value(event, "new_title")
+      }
+    when "card_triaged"
+      { column: particular_value(event, "column") }
+    else
+      {}
+    end
+  end
+
+  def activity_url(event)
+    if event.action.comment_created?
+      card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable))
+    else
+      card_url(event.card)
+    end
+  end
+
+  private
+    def particular_value(event, key)
+      event.particulars&.dig("particulars", key).to_s
+    end
+end
