diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..95c3579
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:kevin)
+    sign_in_as @user
+  end
+
+  test "create registers a push subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.test/subscriptions/123",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.test/subscriptions/123", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+  end
+
+  test "create updates an existing subscription with the same endpoint" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/123",
+      p256dh_key: "old-p256dh",
+      auth_key: "old-auth"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: "new-p256dh",
+          auth_key: "new-auth"
+        }
+      }
+    end
+
+    assert_response :created
+    assert_equal "new-p256dh", subscription.reload.p256dh_key
+    assert_equal "new-auth", subscription.auth_key
+  end
+
+test "create accepts JSON parameters" do
+  assert_difference -> { @user.push_subscriptions.count } do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: {
+        endpoint: "https://push.example.test/subscriptions/json",
+        p256dh_key: "json-p256dh",
+        auth_key: "json-auth"
+      }
+    }, as: :json
+  end
+
+  assert_response :created
+  assert_equal "json-p256dh", @user.push_subscriptions.last.p256dh_key
+end
+
+  test "create is forbidden for another user" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.test/subscriptions/123",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/jobs/push/delivery_job_test.rb b/test/jobs/push/delivery_job_test.rb
new file mode 100644
index 0000000..c5af020
--- /dev/null
+++ b/test/jobs/push/delivery_job_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Push::DeliveryJobTest < ActiveJob::TestCase
+  setup do
+    @user = users(:kevin)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/123",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "delivers the notification to every push subscription" do
+    delivered_payload = nil
+
+    WebPush.expects(:payload_send).with do |options|
+      delivered_payload = JSON.parse(options[:message])
+      options[:endpoint] == @subscription.endpoint &&
+        options[:p256dh] == @subscription.p256dh_key &&
+        options[:auth] == @subscription.auth_key
+    end.once
+
+    Push::DeliveryJob.perform_now(@notification)
+
+    assert_equal @notification.push_payload.stringify_keys, delivered_payload
+  end
+
+  test "removes expired subscriptions" do
+    response = Struct.new(:body) { def inspect = "HTTP 410 Gone" }.new("")
+    error = WebPush::ExpiredSubscription.new(response, "push.example.test")
+    WebPush.stubs(:payload_send).raises(error)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      Push::DeliveryJob.perform_now(@notification)
+    end
+  end
+end
