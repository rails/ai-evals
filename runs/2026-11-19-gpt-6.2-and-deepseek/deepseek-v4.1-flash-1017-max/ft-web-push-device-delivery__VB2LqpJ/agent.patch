diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..bbdb793
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,42 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  normalizes :endpoint, :p256dh_key, :auth_key, with: ->(value) { value.to_s.strip }
+
+  def deliver(notification)
+    WebPush.payload_send(
+      message: notification.push_payload.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: self.class.vapid,
+      ttl: 1.week.to_i
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::Error, ArgumentError => error
+    Rails.error.report(error, context: { push_subscription_id: id, endpoint: endpoint })
+  end
+
+  alias_method :notify, :deliver
+  alias_method :push, :deliver
+
+  class << self
+    def vapid
+      {
+        subject: ENV.fetch("VAPID_SUBJECT", "mailto:notifications@fizzy.do"),
+        public_key: ENV["VAPID_PUBLIC_KEY"],
+        private_key: ENV["VAPID_PRIVATE_KEY"]
+      }
+    end
+
+    def configured?
+      ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+  end
+end
