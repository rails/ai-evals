diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..e4937ed
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,40 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint].to_s.strip)
+    @subscription.assign_attributes(
+      push_subscription_params.merge(account: Current.account, user_agent: request.user_agent)
+    )
+
+    if @subscription.save
+      head :created
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @subscription = @user.push_subscriptions.find_by(id: params[:id]) ||
+      @user.push_subscriptions.find_by(endpoint: params[:endpoint])
+
+    @subscription&.destroy
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..ca125c1
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,154 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "details" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionUrl: String
+  }
+
+  connect() {
+    this.refresh()
+  }
+
+  async refresh() {
+    if (!this.supported) {
+      this.showDetails()
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.showDetails()
+      return
+    }
+
+    if (Notification.permission !== "granted") {
+      this.setEnabled(false)
+      this.hideDetails()
+      return
+    }
+
+    const subscription = await this.getSubscription()
+
+    if (subscription) {
+      this.setEnabled(true)
+      this.hideDetails()
+      this.save(subscription).catch((error) => console.error("Could not refresh push subscription", error))
+    } else {
+      this.setEnabled(false)
+      this.hideDetails()
+    }
+  }
+
+  async enable() {
+    if (!this.supported) {
+      this.showDetails()
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+
+    if (permission !== "granted") {
+      this.showDetails()
+      return
+    }
+
+    try {
+      const registration = await this.serviceWorkerRegistration()
+      let subscription = await registration.pushManager.getSubscription()
+
+      if (!subscription) {
+        subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.applicationServerKey()
+        })
+      }
+
+      await this.save(subscription)
+      this.setEnabled(true)
+      this.hideDetails()
+    } catch (error) {
+      console.error("Could not enable push notifications", error)
+      this.showDetails()
+    }
+  }
+
+  async disable() {
+    try {
+      const subscription = await this.getSubscription()
+
+      if (subscription) {
+        await subscription.unsubscribe()
+      }
+    } catch (error) {
+      console.error("Could not disable push notifications", error)
+    }
+
+    this.setEnabled(false)
+    this.hideDetails()
+  }
+
+  async getSubscription() {
+    const registration = await this.serviceWorkerRegistration()
+    return registration.pushManager.getSubscription()
+  }
+
+  async serviceWorkerRegistration() {
+    if (!navigator.serviceWorker.controller) {
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    }
+
+    return navigator.serviceWorker.ready
+  }
+
+  async save(subscription) {
+    const keys = subscription.toJSON().keys
+    const body = new URLSearchParams({
+      "push_subscription[endpoint]": subscription.endpoint,
+      "push_subscription[p256dh_key]": keys.p256dh,
+      "push_subscription[auth_key]": keys.auth
+    })
+
+    const response = await fetch(this.subscriptionUrlValue, {
+      method: "POST",
+      body,
+      headers: {
+        "Accept": "application/json",
+        "X-CSRF-Token": this.csrfToken
+      }
+    })
+
+    if (!response.ok) {
+      throw new Error(`Push subscription request failed with ${response.status}`)
+    }
+  }
+
+  applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+
+    return Uint8Array.from(rawData, (character) => character.charCodeAt(0))
+  }
+
+  setEnabled(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+  }
+
+  showDetails() {
+    this.setEnabled(false)
+    this.detailsTargets.forEach((details) => details.hidden = false)
+  }
+
+  hideDetails() {
+    this.detailsTargets.forEach((details) => details.hidden = true)
+  }
+
+  get supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get csrfToken() {
+    return document.querySelector('meta[name="csrf-token"]')?.content
+  }
+}
