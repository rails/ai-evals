@@ -0,0 +1,14 @@
+class Push::DeliveryJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(notification, subscription = nil)
+    notification, subscription = subscription, notification if notification.is_a?(Push::Subscription)
+
+    subscriptions = subscription ? [ subscription ] : notification.user.push_subscriptions
+    subscriptions.each do |push_subscription|
+      push_subscription.deliver(notification)
+    end
+  end
+end
