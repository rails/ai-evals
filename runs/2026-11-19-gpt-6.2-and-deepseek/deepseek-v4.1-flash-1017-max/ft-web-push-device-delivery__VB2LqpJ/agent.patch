@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:jz)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/123",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "is account scoped to its user" do
+    assert_equal @user.account, @subscription.account
+  end
+
+  test "creating a notification enqueues a push delivery" do
+    assert_enqueued_with(job: Push::DeliveryJob) do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "updating a notification with a new source enqueues a push delivery" do
+    notification = Notification.create!(user: @user, source: events(:logo_published), creator: users(:david))
+    clear_enqueued_jobs
+
+    assert_enqueued_with(job: Push::DeliveryJob, args: [ notification ]) do
+      notification.update!(source: events(:layout_commented))
+    end
+  end
+end
