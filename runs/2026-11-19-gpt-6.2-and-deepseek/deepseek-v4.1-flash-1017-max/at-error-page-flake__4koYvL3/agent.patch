diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..7066530 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -2,6 +2,39 @@ ENV["RAILS_ENV"] ||= "test"
 require_relative "../config/environment"
 require "rails/test_help"
 
+module RaisedExceptionTestSupport
+  SHOW_EXCEPTIONS_KEY = :raised_exception_test_support_show_exceptions
+
+  def self.show_exceptions
+    Thread.current[SHOW_EXCEPTIONS_KEY]
+  end
+
+  def self.within
+    previous = show_exceptions
+    Thread.current[SHOW_EXCEPTIONS_KEY] = :none
+    yield
+  ensure
+    Thread.current[SHOW_EXCEPTIONS_KEY] = previous
+  end
+
+  # Rails memoizes the application's env_config. Override the exception mode
+  # when each request environment is built so the setting is scoped to the
+  # current test thread instead of mutating that shared configuration.
+  module EnvConfig
+    def env_config
+      config = super
+
+      if (show_exceptions = RaisedExceptionTestSupport.show_exceptions)
+        config.merge("action_dispatch.show_exceptions" => show_exceptions)
+      else
+        config
+      end
+    end
+  end
+end
+
+Rails.application.singleton_class.prepend(RaisedExceptionTestSupport::EnvConfig)
+
 module ActiveSupport
   class TestCase
     # Run tests in parallel with specified workers
@@ -12,12 +45,8 @@ module ActiveSupport
 
     include SessionTestHelper
 
-    def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
-      yield
-    ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+    def with_raised_exceptions(&block)
+      RaisedExceptionTestSupport.within(&block)
     end
   end
 end
