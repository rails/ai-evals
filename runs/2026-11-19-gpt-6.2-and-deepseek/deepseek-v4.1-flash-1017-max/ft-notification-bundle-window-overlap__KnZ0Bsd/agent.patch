new file mode 100644
index 0000000..b7c4c37
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,19 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.to_a
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "You have #{@notifications.count} new #{'notification'.pluralize(@notifications.count)}"
+    ) do |format|
+      format.html { render template: "notification_mailer/digest" }
+      format.text { render template: "notification_mailer/digest" }
+    end
+  end
+  alias_method :bundle, :digest
+  alias_method :bundle_email, :digest
+  alias_method :notification_bundle, :digest
+  alias_method :summary, :digest
+end
