+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:jason)
+    @user.create_settings! unless @user.settings
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @notification = Notification.create!(user: @user, source: events(:logo_published), creator: users(:david))
+    @bundle = @notification.reload.bundle
+  end
+
+  test "digest sends to the user" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "new notification", email.subject
+  end
+
+  test "digest includes each notification" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_match "The logo isn&#39;t big enough", email.html_part.body.to_s
+    assert_match "The logo isn't big enough", email.text_part.body.to_s
+  end
+
+  test "digest has both HTML and text parts" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert email.html_part.present?
+    assert email.text_part.present?
+  end
+end
+
+class NotificationBundleMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:jason)
+    @user.create_settings! unless @user.settings
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @notification = Notification.create!(user: @user, source: events(:logo_published), creator: users(:david))
+    @bundle = @notification.reload.bundle
+  end
+
+  test "bundle mailer alias renders the digest" do
+    email = Notification::BundleMailer.bundle(@bundle)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert email.html_part.present?
+    assert email.text_part.present?
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..c7db763
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,201 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:jason)
+    @user.create_settings! unless @user.settings
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @creator = users(:david)
+  end
+
+  test "opens a window when the first notification arrives" do
+    now = Time.current.change(usec: 0)
+    notification = nil
+
+    travel_to now do
+      assert_difference -> { Notification::Bundle.count }, 1 do
+        notification = Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+      end
+    end
+
+    bundle = Notification::Bundle.last
+    assert_equal now, bundle.starts_at
+    assert_equal now + 1.day, bundle.ends_at
+    assert_equal bundle, notification.reload.bundle
+    assert_equal [ notification ], bundle.notifications.to_a
+  end
+
+  test "notifications arriving during an open window join that window" do
+    first = Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    bundle = first.reload.bundle
+    second = nil
+
+    travel_to 1.hour.from_now do
+      assert_no_difference -> { Notification::Bundle.count } do
+        second = Notification.create!(user: @user, source: events(:layout_published), creator: @creator)
+      end
+    end
+
+    assert_equal bundle, second.reload.bundle
+    assert_equal [ first, second ].map(&:id).sort, bundle.notifications.reload.map(&:id).sort
+  end
+
+  test "delivering a bundle sends one email and closes the window" do
+    first = Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    second = Notification.create!(user: @user, source: events(:layout_published), creator: @creator)
+    bundle = first.reload.bundle
+
+    assert_difference -> { ActionMailer::Base.deliveries.count }, 1 do
+      assert bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+    assert_nil bundle.open_key
+    assert_equal [ first, second ].map(&:id).sort, bundle.notifications.map(&:id).sort
+  end
+
+  test "delivering the same bundle twice only sends one email" do
+    notification = Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    bundle = notification.reload.bundle
+
+    assert_difference -> { ActionMailer::Base.deliveries.count }, 1 do
+      bundle.deliver
+      bundle.deliver
+    end
+  end
+
+  test "a new window opens after the previous one is delivered" do
+    first = Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    first.reload.bundle.deliver
+
+    second = nil
+    assert_difference -> { Notification::Bundle.count }, 1 do
+      second = Notification.create!(user: @user, source: events(:layout_published), creator: @creator)
+    end
+
+    assert_not_equal first.reload.bundle, second.reload.bundle
+  end
+
+  test "does not open a window when email bundles are off" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification.create!(user: @user, source: events(:logo_published), creator: @creator)
+    end
+  end
+end
+
+class Notification::BundleSchedulingTest < ActiveSupport::TestCase
+  test "schedules delivery for the end of the window" do
+    user = users(:jason)
+    user.create_settings! unless user.settings
+    user.settings.update!(bundle_email_frequency: "daily")
+
+    assert_enqueued_with(job: Notification::BundleJob) do
+      Notification.create!(user: user, source: events(:logo_published), creator: users(:david))
+    end
+  end
+end
+
+class Notification::BundleLateArrivalTest < ActiveSupport::TestCase
+  test "a notification with an older timestamp still joins the open window" do
+    user = users(:jason)
+    user.create_settings! unless user.settings
+    user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    first = Notification.create!(user: user, source: events(:logo_published), creator: users(:david))
+    bundle = first.reload.bundle
+
+    late = travel_to(1.hour.from_now) do
+      Notification.create!(
+        user: user,
+        source: events(:layout_published),
+        creator: users(:david),
+        created_at: 2.hours.ago
+      )
+    end
+
+    assert_equal bundle, late.reload.bundle
+    assert_equal bundle, Notification::Bundle.open_for(user)
+    assert_equal 1, user.notification_bundles.undelivered.count
+  end
+end
+
+class Notification::BundleOverlapTest < ActiveSupport::TestCase
+  test "a user cannot have two open windows" do
+    user = users(:jason)
+    first = Notification::Bundle.create!(
+      user: user,
+      account: user.account,
+      starts_at: Time.current,
+      ends_at: 1.day.from_now
+    )
+
+    second = Notification::Bundle.new(
+      user: user,
+      account: user.account,
+      starts_at: Time.current,
+      ends_at: 2.days.from_now
+    )
+
+    assert_not second.valid?
+    assert_includes second.errors.full_messages, "user already has an open notification window"
+    assert first.reload.open?
+  end
+end
+
+class Notification::BundleRepeatActivityTest < ActiveSupport::TestCase
+  test "a new window after delivery starts when the later notification lands" do
+    user = users(:jason)
+    user.create_settings! unless user.settings
+    user.settings.update!(bundle_email_frequency: "daily")
+
+    notification = Notification.create!(
+      user: user,
+      source: events(:logo_published),
+      creator: users(:david),
+      created_at: 2.days.ago
+    )
+    first_bundle = notification.reload.bundle
+    assert_equal notification.created_at, first_bundle.starts_at
+    first_bundle.deliver
+
+    lands_at = Time.current.change(usec: 0)
+    travel_to lands_at do
+      notification.update!(source: events(:logo_assignment_km), creator: users(:david), read_at: nil, unread_count: 2)
+    end
+
+    second_bundle = user.notification_bundles.undelivered.last
+    assert_not_equal first_bundle, second_bundle
+    assert_equal lands_at, second_bundle.starts_at
+  end
+end
+
+class Notification::BundleInMemoryAssociationTest < ActiveSupport::TestCase
+  test "notification exposes its bundle immediately after creation" do
+    user = users(:jason)
+    user.create_settings! unless user.settings
+    user.settings.update!(bundle_email_frequency: "daily")
+
+    notification = Notification.create!(user: user, source: events(:logo_published), creator: users(:david))
+
+    assert_equal user.notification_bundles.undelivered.last, notification.bundle
+  end
+end
+
+class Notification::BundleDisabledTest < ActiveSupport::TestCase
+  test "turning email bundles off closes the open window without sending" do
+    user = users(:jason)
+    user.create_settings! unless user.settings
+    user.settings.update!(bundle_email_frequency: "daily")
+    notification = Notification.create!(user: user, source: events(:logo_published), creator: users(:david))
+    bundle = notification.reload.bundle
+
+    assert_no_difference -> { ActionMailer::Base.deliveries.count } do
+      user.settings.update!(bundle_email_frequency: "never")
+    end
+
+    assert bundle.reload.delivered?
+    assert_nil Notification::Bundle.open_for(user)
+  end
+end
