+require "test_helper"
+
+class Notification::BundleJobTest < ActiveJob::TestCase
+  setup do
+    @user = users(:jason)
+    @user.create_settings! unless @user.settings
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @notification = Notification.create!(user: @user, source: events(:logo_published), creator: users(:david))
+    @bundle = @notification.reload.bundle
+  end
+
+  test "does not deliver before the window ends" do
+    assert_no_difference -> { ActionMailer::Base.deliveries.count } do
+      Notification::BundleJob.perform_now(@bundle)
+    end
+  end
+
+  test "delivers when the window has ended" do
+    travel_to @bundle.ends_at + 1.second do
+      assert_difference -> { ActionMailer::Base.deliveries.count }, 1 do
+        Notification::BundleJob.perform_now(@bundle)
+      end
+    end
+
+    assert @bundle.reload.delivered?
+  end
+end
+
+class Notification::BundleJobEnqueueTest < ActiveJob::TestCase
+  test "the scheduled job delivers at the end of the window" do
+    user = users(:jason)
+    user.create_settings! unless user.settings
+    user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    notification = Notification.create!(user: user, source: events(:logo_published), creator: users(:david))
+    bundle = notification.reload.bundle
+
+    travel_to bundle.ends_at + 1.second do
+      assert_difference -> { ActionMailer::Base.deliveries.count }, 1 do
+        perform_enqueued_jobs only: Notification::BundleJob
+      end
+    end
+
+    assert bundle.reload.delivered?
+  end
+end
