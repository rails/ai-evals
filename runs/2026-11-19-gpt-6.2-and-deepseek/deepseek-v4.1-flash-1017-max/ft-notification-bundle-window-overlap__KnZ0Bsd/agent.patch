diff --git a/app/jobs/notification/bundle_job.rb b/app/jobs/notification/bundle_job.rb
new file mode 100644
index 0000000..e8428e3
--- /dev/null
+++ b/app/jobs/notification/bundle_job.rb
@@ -0,0 +1,15 @@
+class Notification::BundleJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bundle)
+    bundle = bundle.bundle if bundle.is_a?(Notification)
+
+    if bundle
+      if bundle.ends_at > Time.current
+        self.class.set(wait_until: bundle.ends_at).perform_later(bundle)
+      else
+        bundle.deliver
+      end
+    end
+  end
+end
