diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..c42f124
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,179 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, class_name: "Notification", foreign_key: :bundle_id,
+    inverse_of: :bundle, dependent: :nullify
+
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_after_starts
+  validate :only_one_open_bundle, on: :create
+
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :pending, -> { undelivered }
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :due, -> { undelivered.where(ends_at: ..Time.current) }
+  scope :for_user, ->(user) { where(user: user) }
+
+  before_validation :set_times, :set_open_key
+  after_create_commit :schedule_delivery
+
+  class << self
+    # Attaches the notification to the user's currently open bundle, opening a
+    # new window when needed. Notifications that arrive after a window opened
+    # join that window instead of opening a second, overlapping one.
+    def bundle(notification, starts_at: nil)
+      settings = notification.user&.settings
+
+      if deliverable?(notification) && settings&.bundle_email_interval
+        attach(notification, settings.bundle_email_interval, starts_at: starts_at)
+      end
+    end
+    alias_method :bundle_notification, :bundle
+
+    def open_for(user)
+      undelivered.find_by(user: user)
+    end
+
+    def deliver_due
+      due.find_each(&:deliver)
+    end
+
+    private
+      def attach(notification, interval, starts_at:)
+        user = notification.user
+        bundle = nil
+
+        user.with_lock do
+          bundle = open_for(user) || create_for(notification, user, interval, starts_at)
+
+          if notification.bundle_id != bundle.id
+            notification.update_columns(bundle_id: bundle.id, updated_at: notification.updated_at)
+          end
+        end
+
+        bundle
+      rescue ActiveRecord::RecordNotUnique
+        # A concurrent notification opened the window first. Retry so this one
+        # joins it rather than failing or creating a second window.
+        attach(notification, interval, starts_at: starts_at)
+      end
+
+      def deliverable?(notification)
+        notification.user.active? && notification.account.active? && notification.user.identity&.email_address.present?
+      end
+
+      def create_for(notification, user, interval, starts_at)
+        starts_at ||= notification.created_at || Time.current
+
+        create!(
+          account: notification.account,
+          user: user,
+          starts_at: starts_at,
+          ends_at: starts_at + interval,
+          open_key: user.id
+        )
+      end
+  end
+
+  def deliver
+    user.with_lock do
+      lock!
+
+      if delivered?
+        false
+      else
+        deliverable_notifications = notifications.preloaded.to_a
+        NotificationMailer.digest(self).deliver_now if deliverable_notifications.any? && deliverable?
+
+        update!(delivered_at: Time.current, open_key: nil)
+        true
+      end
+    end
+  end
+
+  alias_method :deliver!, :deliver
+
+  def overlaps?(other)
+    starts_at < other.ends_at && other.starts_at < ends_at
+  end
+
+  def cancel
+    user.with_lock do
+      lock!
+      update!(delivered_at: Time.current, open_key: nil) unless delivered?
+    end
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def open?
+    !delivered?
+  end
+
+  def pending?
+    open?
+  end
+
+  def deliver_at
+    ends_at
+  end
+
+  def deliver_at=(value)
+    self.ends_at = value
+  end
+
+  def scheduled_at
+    ends_at
+  end
+
+  def scheduled_at=(value)
+    self.ends_at = value
+  end
+
+  def sent_at
+    delivered_at
+  end
+
+  def sent_at=(value)
+    self.delivered_at = value
+  end
+
+  def sent?
+    delivered?
+  end
+
+  private
+    def set_times
+      self.starts_at ||= created_at || Time.current
+
+      if ends_at.blank? && user&.settings&.bundle_email_interval
+        self.ends_at = starts_at + user.settings.bundle_email_interval
+      end
+    end
+
+    def set_open_key
+      self.open_key = delivered_at.nil? ? user_id : nil
+    end
+
+    def deliverable?
+      user.active? && account.active? && user.identity&.email_address.present?
+    end
+
+    def ends_after_starts
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+
+    def only_one_open_bundle
+      if delivered_at.nil? && user_id.present? && self.class.undelivered.where(user_id: user_id).exists?
+        errors.add(:base, "user already has an open notification window")
+      end
+    end
+
+    def schedule_delivery
+      Notification::BundleJob.set(wait_until: ends_at).perform_later(self)
+    end
+end
