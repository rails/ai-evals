diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..276bd20
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,58 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_before_action :remember_requested_locale
+    around_action :use_locale
+
+    helper_method :current_locale
+  end
+
+  private
+    def remember_requested_locale
+      if locale = requested_locale
+        session[:locale] = locale
+      end
+    end
+
+    def use_locale(&)
+      locale = resolved_locale
+      persist_locale(locale)
+
+      I18n.with_locale(locale, &)
+    end
+
+    def resolved_locale
+      requested_locale || session_locale || identity_locale || I18n.default_locale
+    end
+
+    def persist_locale(locale)
+      if Current.identity && session[:locale].present? && Current.identity.locale != locale
+        Current.identity.update_column(:locale, locale)
+      end
+    end
+
+    def requested_locale
+      offered_locale(params[:locale])
+    end
+
+    def session_locale
+      offered_locale(session[:locale])
+    end
+
+    def identity_locale
+      offered_locale(Current.identity&.locale)
+    end
+
+    def offered_locale(locale)
+      locale = locale.to_s
+
+      if I18n.available_locales.map(&:to_s).include?(locale)
+        locale
+      end
+    end
+
+    def current_locale
+      I18n.locale.to_s
+    end
+end
