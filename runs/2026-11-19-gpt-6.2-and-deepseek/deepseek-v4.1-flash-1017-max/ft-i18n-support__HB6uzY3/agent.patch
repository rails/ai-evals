index 0000000..6072f95
--- /dev/null
+++ b/test/controllers/japanese_translation_coverage_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class JapaneseTranslationCoverageTest < ActionDispatch::IntegrationTest
+  setup do
+    @modern_user_agent = "just some random nonsense text"
+  end
+
+  test "representative signed-in screens have no missing Japanese translations" do
+    sign_in_as :kevin
+
+    paths = [
+      root_path,
+      board_path(boards(:writebook)),
+      edit_board_path(boards(:writebook)),
+      new_board_path,
+      cards_path,
+      card_path(cards(:logo)),
+      edit_card_path(cards(:logo)),
+      new_card_tagging_path(cards(:logo)),
+      new_card_assignment_path(cards(:logo)),
+      card_pin_path(cards(:logo)),
+      account_settings_path,
+      account_join_code_path,
+      notifications_path,
+      notifications_settings_path,
+      my_access_tokens_path,
+      new_my_access_token_path,
+      my_passkeys_path,
+      user_path(users(:kevin)),
+      edit_user_path(users(:kevin)),
+      user_events_path(users(:kevin)),
+      new_user_email_address_path(user_id: users(:kevin)),
+      board_webhooks_path(boards(:writebook)),
+      new_board_webhook_path(boards(:writebook)),
+      search_path
+    ]
+
+    paths.each do |path|
+      get path, params: { locale: "ja" }, headers: { "User-Agent" => @modern_user_agent }
+      puts "PATH: #{path} STATUS: #{response.status} MESSAGE: #{response.body[/<div class="message">(.*?)<\/div>/m, 1]}" unless response.successful?
+      assert_response :success, "Expected #{path} to render, got #{response.status}"
+      assert_no_match(/translation missing/i, response.body, "Missing translation on #{path}")
+    end
+  end
+
+  test "signed-out Japanese screens have no missing translations" do
+    untenanted do
+      [ new_session_path, new_signup_path ].each do |path|
+        get path, params: { locale: "ja" }, headers: { "User-Agent" => @modern_user_agent }
+        assert_response :success, "Expected #{path} to render, got #{response.status}"
+        assert_no_match(/translation missing/i, response.body, "Missing translation on #{path}")
+      end
+    end
+  end
+end
