@@ -0,0 +1,84 @@
+require "test_helper"
+
+class JapaneseMailersTest < ActionMailer::TestCase
+  setup do
+    identities(:kevin).update_column(:locale, "ja")
+    Current.account = accounts(:"37s")
+  end
+
+  test "magic link is in Japanese" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzy のコードは #{magic_link.code} です", email.subject
+    assert_japanese_body(email, "Fizzy の確認コード")
+  end
+
+  test "account cancellation is in Japanese" do
+    user = users(:david)
+    user.identity.update_column(:locale, "ja")
+    account = accounts(:"37s")
+    account.cancel(initiated_by: user)
+
+    email = AccountMailer.cancellation(account.cancellation)
+    assert_equal "Fizzy アカウントがキャンセルされました", email.subject
+    assert_japanese_body(email, "キャンセルされました")
+  end
+
+  test "data export is in Japanese" do
+    user = users(:david)
+    user.identity.update_column(:locale, "ja")
+    export = User::DataExport.create!(account: Current.account, user: user)
+
+    email = ExportMailer.completed(export)
+    assert_equal "Fizzy データのエクスポートをダウンロードできます", email.subject
+    assert_japanese_body(email, "データをダウンロード")
+  end
+
+  test "import mailers are in Japanese" do
+    identity = identities(:kevin)
+    email = ImportMailer.completed(identity, accounts(:"37s"))
+    assert_equal "Fizzy アカウントのインポートが完了しました", email.subject
+    assert_japanese_body(email, "インポートが完了しました")
+
+    import = Account::Import.create!(account: Current.account, identity: identity, status: :failed, failure_reason: :conflict)
+    email = ImportMailer.failed(import)
+    assert_equal "Fizzy アカウントのインポートに失敗しました", email.subject
+    assert_japanese_body(email, "すでに存在するようです")
+  end
+
+  test "email change confirmation is in Japanese" do
+    user = users(:kevin)
+    email = UserMailer.email_change_confirmation(email_address: "new@example.com", token: "token", user: user)
+
+    assert_equal "新しいメールアドレスを確認", email.subject
+    assert_japanese_body(email, "メールアドレスの変更を確認")
+  end
+
+  test "notification bundle is in Japanese" do
+    user = users(:david)
+    user.identity.update_column(:locale, "ja")
+    user.notifications.destroy_all
+    bundle = Notification::Bundle.create!(user: user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    Notification.create!(user: user, creator: user, source: events(:logo_published), created_at: 30.minutes.ago)
+
+    email = Notification::BundleMailer.notification(bundle)
+    assert_match "新しい通知", email.subject
+    assert_japanese_body(email, "新しい通知")
+  end
+
+  private
+    def assert_japanese_body(email, text)
+      bodies = [ email.body.decoded ]
+      bodies << email.html_part.body.decoded if email.html_part
+      bodies << email.text_part.body.decoded if email.text_part
+
+      assert bodies.any? { |body| body.include?(text) }, "Expected #{text.inspect} in email body"
+
+      if body = bodies.find { |body| body.match?(/translation missing/i) }
+        puts "MISSING TRANSLATION: #{body[/translation missing[^<\n]*/i]}"
+      end
+
+      assert bodies.none? { |body| body.match?(/translation missing/i) }, "Expected no missing translations"
+    end
+end
