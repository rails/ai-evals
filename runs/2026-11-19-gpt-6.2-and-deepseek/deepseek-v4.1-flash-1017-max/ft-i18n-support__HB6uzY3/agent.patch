+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "locale query switches to Japanese for the rest of the session" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_includes response.body, 'lang="ja"'
+      assert_includes response.body, "Fizzy にサインイン"
+      assert_not_includes response.body, "Get into Fizzy"
+
+      get new_session_path
+      assert_includes response.body, 'lang="ja"'
+      assert_includes response.body, "Fizzy にサインイン"
+
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_includes response.body, 'lang="ja"'
+      assert_includes response.body, "Fizzy にサインイン"
+    end
+  end
+
+  test "default stays English" do
+    untenanted do
+      get new_session_path
+      assert_includes response.body, 'lang="en"'
+      assert_includes response.body, "Get into Fizzy"
+    end
+  end
+
+  test "signed in locale persists across a new session" do
+    sign_in_as :kevin
+
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    sign_out
+    sign_in_as :kevin
+
+    get root_path
+    assert_includes response.body, 'lang="ja"'
+  end
+end
