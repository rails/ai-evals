diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..0f91977
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,160 @@
+class Notification::Bundle < ApplicationRecord
+  FREQUENCIES = %w[ every_few_hours daily weekly ].freeze
+  DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, inverse_of: :bundle, dependent: :nullify
+
+  enum :frequency, FREQUENCIES.index_by(&:itself)
+
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :open, -> { undelivered }
+  scope :pending, -> { undelivered }
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :deliverable, -> { undelivered.where(ends_at: ..Time.current) }
+  scope :due, -> { deliverable }
+
+  alias_attribute :deliver_at, :ends_at
+  alias_attribute :start_at, :starts_at
+  alias_attribute :end_at, :ends_at
+  alias_attribute :sent_at, :delivered_at
+  alias_attribute :bundle_email_frequency, :frequency
+
+  before_validation :set_frequency, if: -> { frequency.blank? }
+  before_validation :set_starts_at, if: -> { starts_at.blank? }
+  before_validation :set_ends_at, if: -> { ends_at.blank? && starts_at.present? && frequency.present? }
+
+  validates :frequency, :starts_at, :ends_at, presence: true
+  validate :ends_at_is_after_starts_at
+  validate :windows_do_not_overlap
+
+  after_create_commit :schedule_delivery
+
+  class << self
+    def bundle(notification)
+      frequency = notification.user.settings&.bundle_email_frequency
+      return if frequency.blank? || frequency == "never"
+
+      notification.user.with_lock do
+        bundle = undelivered.where(user_id: notification.user_id).order(:starts_at).first
+
+        if bundle.nil?
+          starts_at = next_window_start_for(notification)
+          bundle = create!(
+            account: notification.account,
+            user: notification.user,
+            frequency: frequency,
+            starts_at: starts_at,
+            ends_at: starts_at + duration_for(frequency)
+          )
+        end
+
+        notification.update_columns(bundle_id: bundle.id) unless notification.bundle_id == bundle.id
+        bundle
+      end
+    end
+    alias_method :bundle_notification, :bundle
+
+    def deliver_due
+      deliverable.find_each(&:deliver)
+    end
+
+    def duration_for(frequency)
+      DURATIONS.fetch(frequency.to_s)
+    end
+
+    def next_window_start_for(notification)
+      previous_ends_at = where(user_id: notification.user_id).maximum(:ends_at)
+
+      if previous_ends_at.present? && notification.created_at <= previous_ends_at
+        [ Time.current, previous_ends_at ].max
+      else
+        notification.created_at
+      end
+    end
+  end
+
+  def deliver
+    user.with_lock do
+      reload
+
+      if delivered_at.nil?
+        NotificationMailer.bundle(self).deliver_now if deliverable_email?
+        update!(delivered_at: Time.current)
+      end
+    end
+  end
+  alias_method :deliver_now, :deliver
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.perform_later(self)
+  end
+
+  def open?
+    delivered_at.nil?
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def due?
+    open? && ends_at <= Time.current
+  end
+
+  private
+    def schedule_delivery
+      Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+    end
+
+    def deliverable_email?
+      notifications.exists? &&
+        user.active? &&
+        account.active? &&
+        user.identity&.email_address.present? &&
+        email_frequency_enabled?
+    end
+
+    def email_frequency_enabled?
+      frequency = user.settings&.bundle_email_frequency
+      frequency.present? && frequency != "never"
+    end
+
+    def set_frequency
+      setting = user&.settings&.bundle_email_frequency
+      self.frequency = setting if setting.present? && setting != "never"
+    end
+
+    def set_starts_at
+      self.starts_at = Time.current
+    end
+
+    def set_ends_at
+      self.ends_at = starts_at + self.class.duration_for(frequency)
+    end
+
+    def ends_at_is_after_starts_at
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+
+    def windows_do_not_overlap
+      return if starts_at.blank? || ends_at.blank?
+
+      overlapping = self.class
+        .where(user_id: user_id)
+        .where.not(id: id)
+        .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+        .exists?
+
+      if overlapping
+        errors.add(:base, "overlaps another notification bundle")
+      end
+    end
+end
