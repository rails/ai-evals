new file mode 100644
index 0000000..6ff2eff
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,21 @@
+class NotificationMailer < ApplicationMailer
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.to_a
+
+    mail to: @user.identity.email_address, subject: subject_for(@notifications), template_name: "bundle"
+  end
+
+  alias_method :digest, :bundle
+  alias_method :email_digest, :bundle
+
+  private
+    def subject_for(notifications)
+      case notifications.size
+      when 0 then "Your Fizzy notifications"
+      when 1 then "You have a new notification in Fizzy"
+      else "You have #{notifications.size} new notifications in Fizzy"
+      end
+    end
+end
