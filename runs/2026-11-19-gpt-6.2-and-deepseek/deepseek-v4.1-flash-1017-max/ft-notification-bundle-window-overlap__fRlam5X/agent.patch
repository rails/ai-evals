+  <% payload = notification.payload %>
+  <div class="notification">
+    <p class="notification__board"><%= link_to notification.card.board.name, payload.url %></p>
+    <p class="notification__details"><%= link_to payload.title, payload.url %></p>
+    <p class="notification__author"><%= payload.body %></p>
+  </div>
+<% end %>
+
+<p class="footer">
+  You’re receiving this because you asked for email digests.
+  <%= link_to "Manage your notification settings", notifications_settings_url(script_name: @bundle.account.slug) %>
+</p>
