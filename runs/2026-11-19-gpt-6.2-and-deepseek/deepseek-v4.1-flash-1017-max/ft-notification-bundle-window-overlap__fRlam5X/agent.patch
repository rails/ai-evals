+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:jz)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "settings default to never" do
+    assert_equal "never", users(:david).settings.bundle_email_frequency
+    assert users(:david).settings.never?
+  end
+
+  test "does not create a bundle when email digests are off" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification(events(:logo_published))
+    end
+  end
+
+  test "starts a window with the first notification and adds later notifications" do
+    freeze_time do
+      notification = create_notification(events(:logo_published))
+      bundle = notification.reload.bundle
+
+      assert_equal notification.created_at, bundle.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+      assert_equal "every_few_hours", bundle.frequency
+
+      second_notification = create_notification(events(:layout_published))
+
+      assert_equal bundle, second_notification.reload.bundle
+      assert_equal 2, bundle.reload.notifications.count
+      assert_equal 1, @user.notification_bundles.count
+    end
+  end
+
+  test "late notifications join the window that is already open" do
+    freeze_time do
+      bundle = create_notification(events(:logo_published)).reload.bundle
+      late_notification = create_notification(events(:layout_published), created_at: 30.minutes.ago)
+
+      assert_equal bundle, late_notification.reload.bundle
+      assert_equal bundle.starts_at, late_notification.bundle.starts_at
+    end
+  end
+
+  test "schedules delivery at the end of the window" do
+    freeze_time do
+      assert_enqueued_with(job: Notification::Bundle::DeliveryJob, at: 4.hours.from_now) do
+        create_notification(events(:logo_published))
+      end
+    end
+  end
+
+  test "delivers one email for all notifications in a bundle and only once" do
+    bundle = create_notification(events(:logo_published)).reload.bundle
+    create_notification(events(:layout_published))
+
+    assert_difference -> { ActionMailer::Base.deliveries.count }, 1 do
+      bundle.deliver
+    end
+    assert bundle.reload.delivered_at.present?
+
+    assert_no_difference -> { ActionMailer::Base.deliveries.count } do
+      bundle.deliver
+    end
+  end
+
+  test "starts a new non-overlapping window after the previous window is delivered" do
+    first_bundle = create_notification(events(:logo_published)).reload.bundle
+    first_bundle.deliver
+
+    second_bundle = create_notification(events(:layout_published)).reload.bundle
+
+    assert_not_equal first_bundle, second_bundle
+    assert_operator second_bundle.starts_at, :>=, first_bundle.ends_at
+    assert_equal 1, @user.notification_bundles.undelivered.count
+  end
+
+  test "delivery job sends the digest" do
+    assert_difference -> { ActionMailer::Base.deliveries.count }, 1 do
+      perform_enqueued_jobs do
+        create_notification(events(:logo_published))
+      end
+    end
+  end
+
+  test "uses the configured frequency for the window duration" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+
+    freeze_time do
+      bundle = create_notification(events(:logo_published)).reload.bundle
+      assert_equal 1.day.from_now, bundle.ends_at
+      bundle.deliver
+    end
+
+    @user.settings.update!(bundle_email_frequency: "weekly")
+
+    freeze_time do
+      bundle = create_notification(events(:layout_published)).reload.bundle
+      assert_equal 1.week, bundle.ends_at - bundle.starts_at
+    end
+  end
+
+  test "does not send a pending bundle after digests are turned off" do
+    bundle = create_notification(events(:logo_published)).reload.bundle
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { ActionMailer::Base.deliveries.count } do
+      bundle.deliver
+    end
+    assert bundle.reload.delivered?
+  end
+
+  test "late notification after a delivered window starts a non-overlapping window" do
+    first_bundle = create_notification(events(:logo_published)).reload.bundle
+    first_bundle.deliver
+
+    late_notification = create_notification(events(:layout_published), created_at: 1.hour.ago)
+    second_bundle = late_notification.reload.bundle
+
+    assert_not_equal first_bundle, second_bundle
+    assert_operator second_bundle.starts_at, :>=, first_bundle.ends_at
+  end
+
+  test "rejects overlapping windows for the same user" do
+    freeze_time do
+      bundle = create_notification(events(:logo_published)).reload.bundle
+
+      assert_raises ActiveRecord::RecordInvalid do
+        Notification::Bundle.create!(
+          user: @user,
+          frequency: "daily",
+          starts_at: bundle.starts_at + 1.hour,
+          ends_at: bundle.ends_at + 1.hour
+        )
+      end
+    end
+  end
+
+  private
+    def create_notification(source, **attributes)
+      @user.notifications.create!(
+        source: source,
+        creator: users(:david),
+        **attributes
+      )
+    end
+end
