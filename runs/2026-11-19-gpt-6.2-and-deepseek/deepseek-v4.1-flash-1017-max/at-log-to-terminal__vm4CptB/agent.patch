@@ -19,6 +19,20 @@ module Writebook
     # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
     config.log_level = ENV.fetch("LOG_LEVEL", "debug")
 
+    # Runner commands do not get the console logging that `rails server` adds.
+    # Broadcast report-level output to the terminal while keeping the
+    # environment's log file as the durable record.
+    config.after_initialize do
+      if defined?(Rails::Command::RunnerCommand)
+        unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout)
+          console_logger = ActiveSupport::Logger.new($stdout)
+          console_logger.formatter = Rails.logger.formatter
+          console_logger.level = Logger::INFO
+          Rails.logger.broadcast_to(console_logger)
+        end
+      end
+    end
+
