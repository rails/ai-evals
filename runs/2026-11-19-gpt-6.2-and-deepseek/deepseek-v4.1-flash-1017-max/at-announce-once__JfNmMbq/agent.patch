diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..712930e 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,31 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_save :remember_publication_status
+    after_commit :announce_publication
+    after_rollback :forget_publication_status
   end
 
   private
+    # Later saves in the same transaction (such as a page touch) can clear
+    # saved_changes, so remember the status before the first publication change.
+    def remember_publication_status
+      if new_record?
+        @published_before_save = false if published?
+      elsif will_save_change_to_published? && !defined?(@published_before_save)
+        @published_before_save = published_in_database
+      end
+    end
+
     def announce_publication
-      AnnouncePublicationJob.perform_later self
+      if defined?(@published_before_save) && !@published_before_save && persisted? && self.class.exists?(id: id, published: true)
+        AnnouncePublicationJob.perform_later self
+      end
+    ensure
+      forget_publication_status
+    end
+
+    def forget_publication_status
+      remove_instance_variable(:@published_before_save) if defined?(@published_before_save)
     end
 end
