diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..7514c88
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "publishing a book enqueues an announcement once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "publishing and adding a page in one transaction enqueues an announcement once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "Added page"
+      end
+    end
+  end
+
+  test "publishing and adding a page in one failed transaction enqueues no announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises ActiveRecord::RecordInvalid do
+        Book.transaction do
+          @book.update! published: true
+          @book.press Page.new(body: ""), title: "Added page"
+          raise ActiveRecord::RecordInvalid.new(Page.new)
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "unpublishing a book enqueues no announcement" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "saving an already published book enqueues no announcement" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Renamed"
+    end
+  end
+
+  test "saving a draft without publishing enqueues no announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Renamed draft"
+    end
+  end
+
+  test "adding a page to an already published book enqueues no announcement" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.press Page.new(body: ""), title: "Added page"
+    end
+  end
+
+  test "publishing and unpublishing in one transaction enqueues no announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+      end
+    end
+  end
+
+  test "unpublishing and republishing an already published book enqueues no announcement" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "publishing and destroying in one transaction enqueues no announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.destroy!
+      end
+    end
+  end
+end
