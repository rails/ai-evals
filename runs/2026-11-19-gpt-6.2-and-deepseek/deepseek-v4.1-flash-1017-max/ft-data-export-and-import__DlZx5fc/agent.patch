diff --git a/test/controllers/data_transfer_controller_test.rb b/test/controllers/data_transfer_controller_test.rb
new file mode 100644
index 0000000..d320ad8
--- /dev/null
+++ b/test/controllers/data_transfer_controller_test.rb
@@ -0,0 +1,186 @@
+require "test_helper"
+
+class DataTransferControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+  end
+
+  test "admin can start an account export and receives a download email" do
+    sign_in_as :jason
+    clear_enqueued_jobs
+
+    assert_enqueued_with(job: Export::GenerateJob) do
+      post account_exports_path
+    end
+
+    assert_redirected_to account_settings_path
+
+    perform_enqueued_jobs only: Export::GenerateJob
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+
+    export = Export.where(account: @account).order(:created_at).last
+    assert export.completed?, export.error
+    assert export.file.attached?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal users(:jason).identity.email_address, email.to.first
+    assert_match(/exports\/#{export.id}\/download/, email.text_part.body.to_s)
+    assert_match(/24 hours/, email.text_part.body.to_s)
+  end
+
+  test "non-admin cannot start an account export" do
+    sign_in_as :jz
+
+    assert_no_enqueued_jobs only: Export::GenerateJob do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "a user can start an export of their own cards" do
+    sign_in_as :jz
+
+    assert_enqueued_with(job: Export::GenerateJob) do
+      post user_exports_path(users(:jz))
+    end
+
+    assert_redirected_to user_path(users(:jz))
+  end
+
+  test "a user cannot export another user's cards" do
+    sign_in_as :jz
+
+    assert_no_enqueued_jobs only: Export::GenerateJob do
+      post user_exports_path(users(:kevin))
+    end
+
+    assert_response :forbidden
+  end
+
+  test "signed in user can open the import form" do
+    sign_in_as :jz
+
+    get new_account_import_path
+    assert_response :success
+    assert_select "form[action='#{account_imports_path}']"
+  end
+end
+
+class ExportDownloadControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :jason
+    clear_enqueued_jobs
+    @export = Export.create!(account: accounts("37s"), user: users(:jason), kind: "account")
+    @export.generate_now
+  end
+
+  test "downloads a ready export with a valid token" do
+    get download_export_path(@export, token: @export.download_token)
+    assert_response :redirect
+    assert_match(/active_storage/, response.location)
+
+    follow_redirect!
+    follow_redirect!
+    assert_response :success
+    assert_equal @export.file.download, response.body
+  end
+
+  test "rejects an invalid download token" do
+    get download_export_path(@export, token: "invalid")
+    assert_response :not_found
+  end
+
+  test "rejects an expired download token" do
+    token = @export.download_token
+    travel 25.hours do
+      get download_export_path(@export, token: token)
+      assert_response :not_found
+    end
+  end
+end
+
+class ImportControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :jason
+    clear_enqueued_jobs
+    @account = accounts("37s")
+  end
+
+  test "imports an account through the upload form and emails when done" do
+    export = Export.create!(account: @account, user: users(:jason), kind: "account")
+    export.generate_now
+    assert export.completed?, export.error
+
+    upload = uploaded_zip(export.file.download)
+
+    assert_enqueued_with(job: Import::ProcessJob) do
+      post account_imports_path, params: { import: { file: upload } }
+    end
+    assert_redirected_to account_settings_path
+
+    import = Import.order(:created_at).last
+    perform_enqueued_jobs only: Import::ProcessJob
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+
+    assert import.reload.completed?, import.error
+    assert import.imported_account.present?
+    assert_equal import.imported_account.boards.count, @account.boards.count
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal users(:jason).identity.email_address, email.to.first
+    assert_match(/import is ready/, email.subject.downcase)
+  end
+
+test "requires an import file" do
+  assert_no_difference -> { Import.count } do
+    post account_imports_path, params: { import: {} }
+  end
+
+  assert_response :unprocessable_entity
+  assert_select "form[action='#{account_imports_path}']"
+end
+
+  test "emails the failure reason and leaves no account behind for a broken archive" do
+    upload = uploaded_zip("not a zip")
+
+    assert_enqueued_with(job: Import::ProcessJob) do
+      post account_imports_path, params: { import: { file: upload } }
+    end
+
+    import = Import.order(:created_at).last
+
+    assert_no_difference -> { Account.count } do
+      perform_enqueued_jobs only: Import::ProcessJob
+    end
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+
+    assert import.reload.failed?
+    assert import.error.present?
+    assert_nil import.imported_account
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal users(:jason).identity.email_address, email.to.first
+    assert_match(/import couldn't be completed/i, email.subject)
+    assert_match(/Nothing from the archive was kept/, email.text_part.body.to_s)
+  end
+
+  private
+    def uploaded_zip(content)
+      file = Tempfile.new([ "export", ".zip" ])
+      file.binmode
+      file.write(content)
+      file.rewind
+      Rack::Test::UploadedFile.new(file.path, "application/zip", false, original_filename: "export.zip")
+    end
+end
+
+class ExportAuthorizationControllerTest < ActionDispatch::IntegrationTest
+  test "a member cannot view another user's export" do
+    sign_in_as :jz
+    export = Export.create!(account: accounts("37s"), user: users(:jason), kind: "account")
+
+    get export_path(export)
+    assert_response :forbidden
+  end
+end
