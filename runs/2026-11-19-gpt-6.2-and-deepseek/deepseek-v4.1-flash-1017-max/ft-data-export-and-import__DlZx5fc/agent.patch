--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,105 @@
+class Export < ApplicationRecord
+  DOWNLOAD_PURPOSE = :export_download
+  DOWNLOAD_EXPIRY = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, { account: "account", cards: "cards" }, default: :account, prefix: :kind, scopes: false
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending, validate: true
+
+  scope :for_account, -> { where(kind: "account") }
+  scope :for_cards, -> { where(kind: "cards") }
+
+  def account?
+    kind_account?
+  end
+
+  def cards?
+    kind_cards?
+  end
+
+  def failure_reason
+    error
+  end
+
+  def zip
+    file
+  end
+
+  def ready?
+    completed? && file.attached?
+  end
+
+  def accessible_to?(user)
+    user.present? && user.account_id == account_id
+  end
+
+  def publicly_accessible?
+    false
+  end
+
+  def download_token
+    signed_id(expires_in: DOWNLOAD_EXPIRY, purpose: DOWNLOAD_PURPOSE)
+  end
+
+  def valid_download_token?(token)
+    signed = find_signed(token, purpose: DOWNLOAD_PURPOSE) || find_signed(token)
+    signed == self
+  end
+
+  def generate_later
+    Export::GenerateJob.perform_later(self)
+  end
+
+  def generate_now
+    return if completed? || processing?
+
+    update!(status: :processing, error: nil)
+
+    ZipFile.create_for(file, filename: filename) do |zip|
+      zip.add_file("manifest.json", JSON.generate(manifest))
+      Account::DataTransfer::Manifest.new(account, user: kind_cards? ? user : nil).each_record_set do |record_set|
+        record_set.export_to(zip)
+      end
+    end
+
+    update!(status: :completed, completed_at: Time.current)
+    deliver_notification { ExportMailer.ready(self).deliver_later }
+  rescue => error
+    file.purge_later if file.attached?
+    update!(status: :failed, error: error.message)
+    deliver_notification { ExportMailer.failed(self).deliver_later }
+  end
+
+  private
+    def deliver_notification
+      yield
+    rescue => error
+      Rails.logger.error("Export notification failed: #{error.class}: #{error.message}")
+    end
+
+    def find_signed(token, purpose: nil)
+      self.class.find_signed(token, purpose: purpose)
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+
+    def filename
+      scope = kind_cards? ? user.name.parameterize : account.name.parameterize
+      "fizzy-#{scope}-export-#{Time.current.to_fs(:number)}.zip"
+    end
+
+    def manifest
+      {
+        format: "fizzy-account-export",
+        version: 1,
+        kind: kind,
+        account_id: account.id,
+        user_id: user.id,
+        exported_at: Time.current.iso8601
+      }
+    end
+end
