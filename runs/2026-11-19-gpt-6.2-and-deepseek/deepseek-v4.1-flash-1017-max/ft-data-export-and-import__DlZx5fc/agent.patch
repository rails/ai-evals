new file mode 100644
index 0000000..aaa66a0
--- /dev/null
+++ b/app/models/account/data_transfer/join_record_set.rb
@@ -0,0 +1,33 @@
+class Account::DataTransfer::JoinRecordSet
+  UUID_TYPE = ActiveRecord::Type.lookup(:uuid)
+
+  attr_reader :table_name, :columns
+
+  def initialize(table_name:, columns:, rows:)
+    @table_name = table_name
+    @columns = columns
+    @rows = rows
+  end
+
+  def export_to(zip)
+    normalized_rows.each_with_index do |row, index|
+      zip.add_file("#{table_name}/#{index}.json", JSON.generate(row))
+    end
+  end
+  alias_method :export, :export_to
+
+  private
+    def normalized_rows
+      @rows.map do |row|
+        row.transform_values { |value| normalize_uuid(value) }
+      end
+    end
+
+    def normalize_uuid(value)
+      if value.is_a?(String) && value.bytesize == 16
+        UUID_TYPE.deserialize(value)
+      else
+        value
+      end
+    end
+end
