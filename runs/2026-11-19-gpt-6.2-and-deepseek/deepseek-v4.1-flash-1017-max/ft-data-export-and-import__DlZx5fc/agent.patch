diff --git a/app/models/account/data_transfer/card_record_set.rb b/app/models/account/data_transfer/card_record_set.rb
new file mode 100644
index 0000000..5578cd6
--- /dev/null
+++ b/app/models/account/data_transfer/card_record_set.rb
@@ -0,0 +1,49 @@
+class Account::DataTransfer::CardRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account, scope: nil)
+    super(account: account, model: Card, scope: scope)
+  end
+
+  private
+    def records
+      scope || Card.where(account: account)
+    end
+
+    def export_attributes(record)
+      super.merge(
+        "comments" => record.comments.chronologically.map { |comment| comment_attributes(comment) },
+        "files" => files_for(record)
+      )
+    end
+
+    def comment_attributes(comment)
+      comment.attributes.merge(
+        "body" => comment.body.to_s,
+        "creator_name" => comment.creator.name,
+        "files" => files_for(comment)
+      )
+    end
+
+    def files_for(record)
+      attachments = []
+      attachments << record.image.attachment if record.respond_to?(:image) && record.image.attached?
+
+      if record.respond_to?(:description) && record.description.present?
+        attachments.concat(record.description.embeds)
+      end
+
+      if record.respond_to?(:body) && record.body.present?
+        attachments.concat(record.body.embeds)
+      end
+
+      attachments.compact.map do |attachment|
+        blob = attachment.blob
+        {
+          "blob_id" => blob.id,
+          "filename" => blob.filename.to_s,
+          "content_type" => blob.content_type,
+          "byte_size" => blob.byte_size,
+          "path" => Account::DataTransfer::ActiveStorage::FileRecordSet.path_for(blob)
+        }
+      end
+    end
+end
