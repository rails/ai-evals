@@ -0,0 +1,35 @@
+class Account::ImportsController < ApplicationController
+  wrap_parameters :import, include: [ :file ]
+
+  def new
+    @import = Current.account.imports.new
+  end
+
+  def create
+    @import = Current.account.imports.new(creator: Current.user)
+
+    if file = import_file
+      @import.file.attach(file)
+    end
+
+    if @import.save
+      @import.process_later
+
+      respond_to do |format|
+        format.html { redirect_to account_settings_path, notice: "We'll email you when your import is done." }
+        format.json { render json: { id: @import.id, status: @import.status }, status: :accepted }
+      end
+    else
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: @import.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  private
+    def import_file
+      params.dig(:import, :file) || params.dig(:import, :zip) || params.dig(:import, :archive) ||
+        params[:file] || params[:zip] || params[:archive]
+    end
+end
diff --git a/app/controllers/exports_controller.rb b/app/controllers/exports_controller.rb
new file mode 100644
index 0000000..f0c3961
--- /dev/null
+++ b/app/controllers/exports_controller.rb
@@ -0,0 +1,87 @@
+class ExportsController < ApplicationController
+  before_action :set_export, only: :show
+
+  def create
+    kind = params.dig(:export, :kind).presence || params[:kind].presence || "account"
+
+    if kind == "cards"
+      create_cards_export(Current.user)
+    else
+      ensure_admin
+      return if performed?
+
+      create_account_export
+    end
+  end
+
+  def show
+    respond_to do |format|
+      format.html do
+        if @export.ready?
+          redirect_to download_export_path(@export, token: @export.download_token)
+        else
+          render :show
+        end
+      end
+      format.json { render json: export_json(@export) }
+    end
+  end
+
+  def download
+    @export = export_from_params
+    @export = nil unless @export&.account == Current.account
+
+    if @export.nil? || !@export.valid_download_token?(params[:token]) || !@export.ready?
+      head :not_found
+    else
+      redirect_to rails_blob_url(@export.file, disposition: :attachment), allow_other_host: true
+    end
+  end
+
+  private
+    def create_account_export
+      create_export(kind: "account", user: Current.user, redirect_to: account_settings_path)
+    end
+
+    def create_cards_export(user)
+      create_export(kind: "cards", user: user, redirect_to: user_path(user))
+    end
+
+    def create_export(kind:, user:, redirect_to:)
+      @export = Current.account.exports.create!(user: user, kind: kind)
+      @export.generate_later
+
+      respond_to do |format|
+        format.html { redirect_to redirect_to, notice: "We'll email you when your export is ready." }
+        format.json { render json: export_json(@export), status: :accepted }
+      end
+    end
+
+    def set_export
+      @export = Current.account.exports.find(params[:id])
+
+      unless @export.user == Current.user || Current.user.admin?
+        head :forbidden
+      end
+    end
+
+    def export_from_params
+      if params[:id].present?
+        Current.account.exports.find_by(id: params[:id])
+      else
+        Export.find_signed(params[:token], purpose: Export::DOWNLOAD_PURPOSE)
+      end
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+
+    def export_json(export)
+      {
+        id: export.id,
+        kind: export.kind,
+        status: export.status,
+        error: export.error,
+        download_url: export.ready? ? download_export_url(export, token: export.download_token) : nil
+      }
+    end
+end
