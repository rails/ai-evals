+class Account::DataTransfer::Importer
+  class InvalidArchive < StandardError; end
+
+  MODEL_TABLES = [
+    User,
+    User::Settings,
+    Tag,
+    Board,
+    Column,
+    Entropy,
+    Board::Publication,
+    Webhook,
+    Access,
+    Card,
+    Comment,
+    Step,
+    Assignment,
+    Tagging,
+    Closure,
+    Card::Goldness,
+    Card::NotNow,
+    Card::ActivitySpike,
+    Watch,
+    Pin,
+    Reaction,
+    Mention,
+    Filter,
+    Webhook::DelinquencyTracker,
+    Event,
+    Notification,
+    Notification::Bundle,
+    Webhook::Delivery,
+    ActionText::RichText,
+    ActiveStorage::VariantRecord,
+    ActiveStorage::Attachment
+  ].freeze
+
+  MODELS_BY_TABLE = MODEL_TABLES.index_by(&:table_name).freeze
+
+  JOIN_TABLES = {
+    "filters_tags" => %w[ filter_id tag_id ],
+    "boards_filters" => %w[ filter_id board_id ],
+    "assignees_filters" => %w[ filter_id assignee_id ],
+    "assigners_filters" => %w[ filter_id assigner_id ],
+    "closers_filters" => %w[ filter_id closer_id ],
+    "creators_filters" => %w[ filter_id creator_id ]
+  }.freeze
+
+  JOIN_FOREIGN_KEY_MODELS = {
+    "filter_id" => Filter,
+    "tag_id" => Tag,
+    "board_id" => Board,
+    "assignee_id" => User,
+    "assigner_id" => User,
+    "closer_id" => User,
+    "creator_id" => User
+  }.freeze
+
+  FOREIGN_KEY_MODELS = {
+    "user_id" => User,
+    "creator_id" => User,
+    "assignee_id" => User,
+    "assigner_id" => User,
+    "mentionee_id" => User,
+    "mentioner_id" => User,
+    "reacter_id" => User,
+    "closer_id" => User,
+    "board_id" => Board,
+    "column_id" => Column,
+    "card_id" => Card,
+    "tag_id" => Tag,
+    "event_id" => Event,
+    "webhook_id" => Webhook,
+    "filter_id" => Filter,
+    "blob_id" => ActiveStorage::Blob
+  }.freeze
+
+  POLYMORPHIC_KEYS = {
+    "record_id" => "record_type",
+    "source_id" => "source_type",
+    "eventable_id" => "eventable_type",
+    "reactable_id" => "reactable_type",
+    "container_id" => "container_type",
+    "owner_id" => "owner_type"
+  }.freeze
+
+  attr_reader :import, :account
+
+  def initialize(import)
+    @import = import
+    @source_records = Hash.new { |hash, key| hash[key] = [] }
+    @maps = Hash.new { |hash, key| hash[key] = {} }
+    @blobs_by_source_id = {}
+    @uploaded_blobs = []
+    @uploaded_source_blob_ids = []
+    @source_attachments_by_rich_text = Hash.new { |hash, key| hash[key] = [] }
+  end
+
+  def import
+    @import.file.open do |io|
+      archive = ZipFile::Reader.new(io)
+
+      ActiveRecord::Base.transaction do
+        load_archive(archive)
+        create_account
+        create_blobs
+        create_records
+        create_join_records
+        ensure_importer_is_owner
+        update_account_cards_count
+        upload_files(archive)
+        account
+      end
+    end
+  rescue
+    cleanup_uploaded_files
+    raise
+  end
+
+  private
+    attr_reader :source_records, :maps, :blobs_by_source_id, :source_attachments_by_rich_text
+
+    def load_archive(archive)
+      validate_manifest(archive)
+
+      MODEL_TABLES.each do |model|
+        source_records[model.table_name] = archive.glob("#{model.table_name}/*.json").map do |entry|
+          JSON.parse(archive.read(entry.filename))
+        end
+      end
+
+      source_records["accounts"] = archive.glob("accounts/*.json").map do |entry|
+        JSON.parse(archive.read(entry.filename))
+      end
+
+      source_records["active_storage_blobs"] = archive.glob("active_storage_blobs/*.json").map do |entry|
+        JSON.parse(archive.read(entry.filename))
+      end
+
+      JOIN_TABLES.each_key do |table_name|
+        source_records[table_name] = archive.glob("#{table_name}/*.json").map do |entry|
+          JSON.parse(archive.read(entry.filename))
+        end
+      end
+
+      if source_records["accounts"].empty?
+        raise InvalidArchive, "The archive doesn't contain an account."
+      end
+
+      index_source_attachments
+    end
+
+    def validate_manifest(archive)
+      if archive.exists?("manifest.json")
+        manifest = JSON.parse(archive.read("manifest.json"))
+
+        if manifest["format"] && manifest["format"] != "fizzy-account-export"
+          raise InvalidArchive, "The archive isn't a Fizzy account export."
+        end
+      end
+    end
+
+    def index_source_attachments
+      source_records["active_storage_attachments"].each do |attachment|
+        if attachment["record_type"] == "ActionText::RichText"
+          source_attachments_by_rich_text[attachment["record_id"]] << attachment["blob_id"]
+        end
+      end
+    end
+
+    def create_account
+      source = source_records["accounts"].first
+
+      @account = Account.create!(
+        name: source["name"].presence || "Imported account",
+        cards_count: source["cards_count"].to_i
+      )
+
+      @account.update_columns(
+        created_at: source["created_at"] || Time.current,
+        updated_at: source["updated_at"] || Time.current
+      )
+
+      maps["Account"][source["id"]] = account.id
+    end
+
+    def create_blobs
+      source_records["active_storage_blobs"].each do |source|
+        new_id = generate_uuid
+        attributes = source.slice(*ActiveStorage::Blob.column_names).except("id", "account_id", "service_name", "key")
+        attributes.merge!(
+          "id" => new_id,
+          "account_id" => account.id,
+          "key" => SecureRandom.base58(24),
+          "service_name" => ActiveStorage::Blob.service.name.to_s
+        )
+
+        ActiveStorage::Blob.insert_all!([ attributes ])
+        maps["ActiveStorage::Blob"][source["id"]] = new_id
+        blobs_by_source_id[source["id"]] = ActiveStorage::Blob.find(new_id)
+      end
+    end
+
+    def create_records
+      MODEL_TABLES.each do |model|
+        source_records[model.table_name].each do |source|
+          create_record(model, source)
+        end
+
+        create_embedded_comments if model == Comment
+      end
+    end
+
+    def create_embedded_comments
+      return if source_records["comments"].any?
+
+      fallback_creator_id = maps["User"].values.first
+
+      source_records["cards"].each do |card_source|
+        Array(card_source["comments"]).each do |comment_source|
+          create_embedded_comment(card_source, comment_source, fallback_creator_id)
+        end
+      end
+    end
+
+    def create_embedded_comment(card_source, source, fallback_creator_id)
+      now = Time.current
+      comment_id = generate_uuid
+      attributes = source.slice(*Comment.column_names).except("id", "account_id")
+      attributes["id"] = comment_id
+      attributes["account_id"] = account.id
+      attributes["card_id"] = maps["Card"][source["card_id"] || card_source["id"]]
+      attributes["creator_id"] = maps["User"][source["creator_id"]] || fallback_creator_id
+      attributes["created_at"] ||= now
+      attributes["updated_at"] ||= now
+
+      raise InvalidArchive, "The archive contains a comment without a card." unless attributes["card_id"]
+      raise InvalidArchive, "The archive contains a comment without a creator." unless attributes["creator_id"]
+
+      Comment.insert_all!([ attributes ])
+      maps["Comment"][source["id"]] = comment_id if source["id"]
+      maps["comments"][source["id"]] = comment_id if source["id"]
+
+      if source["body"].present?
+        ActionText::RichText.insert_all!([ {
+          id: generate_uuid,
+          account_id: account.id,
+          record_type: "Comment",
+          record_id: comment_id,
+          name: "body",
+          body: rewrite_rich_text_body(source, source["body"]),
+          created_at: attributes["created_at"],
+          updated_at: attributes["updated_at"]
+        } ])
+      end
+    end
+
+    def create_join_records
+      JOIN_TABLES.each do |table_name, columns|
+        source_records[table_name].each do |source|
+          attributes = source.slice(*columns)
+
+          attributes.each do |key, value|
+            target_model = JOIN_FOREIGN_KEY_MODELS.fetch(key)
+            mapped = maps[target_model.name][value] || maps[target_model.table_name][value]
+
+            if mapped.nil?
+              raise InvalidArchive, "The archive references a missing #{target_model.name} record."
+            end
+
+            attributes[key] = mapped
+          end
+
+          join_model_for(table_name).insert_all!([ attributes ])
+        end
+      end
+    end
+
+    def join_model_for(table_name)
+      @join_models ||= {}
+      @join_models[table_name] ||= Class.new(ApplicationRecord) do
+        self.table_name = table_name
+      end
+    end
+
+    def create_record(model, source)
+      source_id = source["id"]
+      new_id = generate_uuid
+      attributes = source.slice(*model.column_names).except("id", "account_id", "identity_id")
+      attributes.merge!(remap_foreign_keys(model, source))
+      attributes["id"] = new_id
+      attributes["account_id"] = account.id if model.column_names.include?("account_id")
+
+      if model == User
+        attributes["identity_id"] = identity_for(source)&.id
+      elsif model == ActionText::RichText
+        attributes["body"] = rewrite_rich_text_body(source, attributes["body"])
+      elsif model == Board::Publication
+        attributes["key"] = SecureRandom.base58(24)
+      elsif model == Entropy && attributes["container_type"] == "Account"
+        account_entropy = account.entropy
+        account_entropy.update_columns(
+          auto_postpone_period: attributes["auto_postpone_period"],
+          created_at: attributes["created_at"],
+          updated_at: attributes["updated_at"]
+        )
+        maps[model.name][source_id] = account_entropy.id
+        maps[model.table_name][source_id] = account_entropy.id
+        return
+      end
+
+      model.insert_all!([ attributes ])
+      maps[model.name][source_id] = new_id
+      maps[model.table_name][source_id] = new_id
+    end
+
+    def remap_foreign_keys(model, source)
+      attributes = {}
+
+      model.column_names.grep(/_id\z/).each do |key|
+        next if key == "account_id" || key == "identity_id"
+
+        value = source[key]
+        next if value.nil?
+
+        target_model = target_model_for(key, source)
+        if target_model
+          mapped = maps[target_model.name][value] || maps[target_model.table_name][value]
+          if mapped.nil? && model.column_names.include?(key)
+            raise InvalidArchive, "The archive references a missing #{target_model.name} record."
+          end
+
+          attributes[key] = mapped
+        end
+      end
+
+      attributes
+    end
+
+    def target_model_for(key, source)
+      if (type_key = POLYMORPHIC_KEYS[key])
+        source[type_key]&.safe_constantize
+      else
+        FOREIGN_KEY_MODELS[key]
+      end
+    end
+
+    def identity_for(source)
+      email_address = source["identity_email_address"].presence
+      Identity.find_or_create_by!(email_address: email_address) if email_address
+    end
+
+    def rewrite_rich_text_body(source, body)
+      return body if body.blank?
+
+      document = Nokogiri::HTML.fragment(body)
+      attachments = source_attachments_by_rich_text[source["id"]]
+
+      document.css("action-text-attachment").each_with_index do |node, index|
+        sgid = parsed_sgid(node["sgid"])
+        attachable = attachable_from(sgid)
+
+        if attachable
+          node["sgid"] = attachable.attachable_sgid
+          update_blob_url(node, attachable) if attachable.is_a?(ActiveStorage::Blob)
+        else
+          old_blob_id = sgid&.model_id if sgid&.model_name == "ActiveStorage::Blob"
+          old_blob_id ||= attachments[index]
+          new_blob_id = maps["ActiveStorage::Blob"][old_blob_id]
+
+          if new_blob_id
+            new_blob = ActiveStorage::Blob.find(new_blob_id)
+            node["sgid"] = new_blob.attachable_sgid
+            update_blob_url(node, new_blob)
+          end
+        end
+      end
+
+      document.to_html
+    end
+
+    def parsed_sgid(value)
+      return if value.blank?
+
+      SignedGlobalID.parse(value, for: ActionText::Attachable::LOCATOR_NAME)
+    rescue StandardError
+      nil
+    end
+
+    def attachable_from(sgid)
+      return unless sgid
+
+      model = sgid.model_name.safe_constantize
+      return unless model&.respond_to?(:table_name)
+
+      new_id = maps[model.name][sgid.model_id] || maps[model.table_name][sgid.model_id]
+      model.find_by(id: new_id) if new_id
+    end
+
+    def update_blob_url(node, blob)
+      node["url"] = Rails.application.routes.url_helpers.rails_blob_path(
+        blob, only_path: true, script_name: account.slug
+      )
+    end
+
+    def ensure_importer_is_owner
+      identity = @import.creator.identity
+      return unless identity
+
+      user = User.find_by(account: account, identity: identity)
+
+      if user
+        User.where(id: user.id).update_all(role: "owner", active: true, verified_at: Time.current, updated_at: Time.current)
+      else
+        now = Time.current
+        user_id = generate_uuid
+        User.insert_all!([ {
+          id: user_id,
+          account_id: account.id,
+          identity_id: identity.id,
+          name: @import.creator.name.presence || identity.email_address,
+          role: "owner",
+          active: true,
+          verified_at: now,
+          created_at: now,
+          updated_at: now
+        } ])
+        User::Settings.insert_all!([ {
+          id: generate_uuid,
+          account_id: account.id,
+          user_id: user_id,
+          bundle_email_frequency: 0,
+          created_at: now,
+          updated_at: now
+        } ])
+        user = User.find(user_id)
+        grant_owner_access_to_boards(user)
+      end
+    end
+
+    def grant_owner_access_to_boards(user)
+      board_ids = Board.where(account: account).where.not(id: Access.where(user_id: user.id).select(:board_id)).select(:id)
+      now = Time.current
+
+      Access.insert_all!(
+        board_ids.map do |board|
+          {
+            id: generate_uuid,
+            account_id: account.id,
+            board_id: board.id,
+            user_id: user.id,
+            involvement: "access_only",
+            created_at: now,
+            updated_at: now
+          }
+        end
+      )
+    end
+
+    def update_account_cards_count
+      account.update_column(:cards_count, Card.where(account: account).maximum(:number).to_i)
+    end
+
+    def upload_files(archive)
+      file_entries(archive).each do |entry|
+        source_blob_id = entry.filename.split("/")[1]
+        blob = blobs_by_source_id[source_blob_id]
+
+        raise InvalidArchive, "The archive contains a file for an unknown blob." unless blob
+
+        upload_file(archive, entry, blob)
+        @uploaded_source_blob_ids << source_blob_id
+      end
+
+      missing_blob_ids = blobs_by_source_id.keys - @uploaded_source_blob_ids
+      if missing_blob_ids.any?
+        raise InvalidArchive, "The archive is missing files for attached content."
+      end
+    end
+
+    def file_entries(archive)
+      archive.glob("active_storage_blobs/*/*") + archive.glob("files/*/*")
+    end
+
+    def upload_file(archive, entry, blob)
+      tempfile = Tempfile.new([ "import", ".bin" ])
+      tempfile.binmode
+
+      archive.open(entry.filename) do |reader|
+        until reader.eof?
+          chunk = reader.extract(1.megabyte)
+          break if chunk.nil?
+
+          tempfile.write(chunk)
+        end
+      end
+
+      tempfile.rewind
+      @uploaded_blobs << [ blob.service, blob.key ]
+      blob.service.upload(blob.key, tempfile)
+    ensure
+      tempfile&.close
+      tempfile&.unlink
+    end
+
+    def cleanup_uploaded_files
+      @uploaded_blobs.each do |service, key|
+        service.delete(key)
+      rescue
+        # The import failure is the error worth surfacing; storage cleanup is best effort.
+      end
+    end
+
+    def generate_uuid
+      ActiveRecord::Type::Uuid.generate
+    end
+end
