+++ b/test/data_transfer_smoke_test.rb
@@ -0,0 +1,244 @@
+require "test_helper"
+
+class DataTransferSmokeTest < ActiveSupport::TestCase
+  setup do
+    Current.account = accounts("37s")
+    Current.user = users(:jason)
+  end
+
+  test "exports an account and imports it into a new account" do
+    card = cards(:logo)
+    card.update_column(:title, "Café ☕")
+    card.image.attach(io: File.open(file_fixture("avatar.png")), filename: "avatar.png", content_type: "image/png")
+
+    export = Export.create!(account: Current.account, user: Current.user, kind: "account")
+    export.generate_now
+
+    assert export.reload.completed?, export.error
+    assert export.file.attached?
+
+    zip_bytes = export.file.download
+    archive = ZipFile::Reader.new(StringIO.new(zip_bytes))
+    card_entry = archive.glob("cards/*.json").find do |entry|
+      JSON.parse(archive.read(entry.filename))["title"] == card.title
+    end
+    assert card_entry, "expected exported card JSON"
+    card_json = JSON.parse(archive.read(card_entry.filename))
+    assert card_json["comments"].any?
+    assert archive.glob("active_storage_blobs/*/*").any?
+
+    import = Import.new(account: Current.account, creator: Current.user)
+    import.file.attach(io: StringIO.new(zip_bytes), filename: "export.zip", content_type: "application/zip")
+    import.save!
+    import.process_now
+
+    assert import.reload.completed?, import.error
+    imported_account = import.imported_account
+    assert_not_equal Current.account, imported_account
+    assert_equal Current.account.name, imported_account.name
+    assert_equal Current.account.boards.count, imported_account.boards.count
+    assert_equal Current.account.cards.count, imported_account.cards.count
+    assert_equal Comment.where(account: Current.account).count, Comment.where(account: imported_account).count
+    assert_equal Access.where(account: Current.account).count, Access.where(account: imported_account).count
+Account::DataTransfer::Importer::MODEL_TABLES.each do |model|
+  next if model.in?([ ActiveStorage::Attachment, ActiveStorage::VariantRecord ])
+
+  assert_equal model.where(account: Current.account).count, model.where(account: imported_account).count, model.name
+end
+
+source_attachments = ActiveStorage::Attachment.where(account: Current.account, record_type: Account::DataTransfer::RecordSet::TRANSFERABLE_RECORD_TYPES)
+imported_attachments = ActiveStorage::Attachment.where(account: imported_account, record_type: Account::DataTransfer::RecordSet::TRANSFERABLE_RECORD_TYPES)
+assert_equal source_attachments.count, imported_attachments.count
+assert_equal ActiveStorage::Blob.where(id: source_attachments.select(:blob_id)).count, ActiveStorage::Blob.where(id: imported_attachments.select(:blob_id)).count
+    assert imported_account.users.exists?(identity: Current.identity)
+    imported_card = imported_account.cards.find_by(title: card.title)
+    assert imported_card.image.attached?
+    assert_equal card.image.download, imported_card.image.download
+    imported_filter = Filter.where(account: imported_account).find_by(params_digest: filters(:jz_assignments).params_digest)
+    assert imported_filter
+    assert_equal filters(:jz_assignments).tags.map(&:title), imported_filter.tags.map(&:title)
+    assert_equal filters(:jz_assignments).assignees.map(&:name), imported_filter.assignees.map(&:name)
+  end
+end
+
+class DataTransferScopedSmokeTest < ActiveSupport::TestCase
+  setup do
+    Current.account = accounts("37s")
+    Current.user = users(:jz)
+  end
+
+  test "exports only cards a user can see" do
+    private_board = boards(:private)
+    private_card = private_board.cards.create!(creator: users(:kevin), title: "Top secret", status: "published")
+
+    export = Export.create!(account: Current.account, user: Current.user, kind: "cards")
+    export.generate_now
+
+    assert export.reload.completed?, export.error
+    archive = ZipFile::Reader.new(StringIO.new(export.file.download))
+    card_titles = archive.glob("cards/*.json").map { |entry| JSON.parse(archive.read(entry.filename))["title"] }
+
+    assert_includes card_titles, cards(:logo).title
+    assert_not_includes card_titles, private_card.title
+    assert_not archive.exists?("boards/#{private_board.id}.json")
+  end
+
+  test "failed imports leave no account behind" do
+    import = Import.new(account: Current.account, creator: Current.user)
+    import.file.attach(io: StringIO.new("not a zip"), filename: "broken.zip", content_type: "application/zip")
+    import.save!
+
+    assert_no_difference -> { Account.count } do
+      import.process_now
+    end
+
+    assert import.reload.failed?
+    assert import.error.present?
+    assert_nil import.imported_account
+  end
+end
+
+class ExportTokenSmokeTest < ActiveSupport::TestCase
+  test "download tokens expire after one day" do
+    export = Export.create!(account: accounts("37s"), user: users(:jason), kind: "account")
+    token = export.download_token
+
+    assert export.valid_download_token?(token)
+    assert export.valid_download_token?(export.signed_id(expires_in: 1.day))
+
+    travel 25.hours do
+      assert_not export.valid_download_token?(token)
+    end
+  end
+end
+
+class DataTransferRichTextSmokeTest < ActiveSupport::TestCase
+  setup do
+    Current.account = accounts("37s")
+    Current.user = users(:jason)
+  end
+
+  test "imports files embedded in comment rich text" do
+    comment = comments(:logo_agreement_jz)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    comment.body.body = ActionText::Content.new(comment.body.body.to_html).append_attachables(blob)
+    comment.save!
+
+    export = Export.create!(account: Current.account, user: Current.user, kind: "account")
+    export.generate_now
+    assert export.completed?, export.error
+
+    import = Import.new(account: Current.account, creator: Current.user)
+    import.file.attach(io: StringIO.new(export.file.download), filename: "export.zip", content_type: "application/zip")
+    import.save!
+    import.process_now
+
+    assert import.reload.completed?, import.error
+    imported_comment = Comment.where(account: import.imported_account).find do |candidate|
+      candidate.body.to_plain_text.include?("I agree")
+    end
+
+    assert imported_comment
+    embed = imported_comment.body.embeds.sole
+    assert_equal blob.download, embed.blob.download
+    attachment_node = Nokogiri::HTML.fragment(imported_comment.body.to_s).at_css("action-text-attachment")
+    assert_equal embed.blob.attachable_sgid, attachment_node["sgid"]
+  end
+end
+
+class DataTransferRepeatImportSmokeTest < ActiveSupport::TestCase
+  setup do
+    Current.account = accounts("37s")
+    Current.user = users(:jason)
+  end
+
+  test "the same archive can be imported more than once" do
+    publication = Board::Publication.create!(board: boards(:writebook))
+
+    export = Export.create!(account: Current.account, user: Current.user, kind: "account")
+    export.generate_now
+    assert export.completed?, export.error
+    zip = export.file.download
+
+    imported_accounts = 2.times.map do
+      import = Import.new(account: Current.account, creator: Current.user)
+      import.file.attach(io: StringIO.new(zip), filename: "export.zip", content_type: "application/zip")
+      import.save!
+      import.process_now
+
+      assert import.reload.completed?, import.error
+      import.imported_account
+    end
+
+    keys = imported_accounts.map { |account| Board::Publication.where(board: account.boards).sole.key }
+    assert_equal 2, keys.uniq.size
+    assert_not_includes keys, publication.key
+  end
+end
+
