new file mode 100644
index 0000000..08ba52a
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,49 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+  end
+
+  def glob(pattern)
+    entries
+      .select { |entry| File.fnmatch(pattern, entry.filename) }
+      .sort_by(&:filename)
+  end
+
+  def exists?(path)
+    entries.any? { |entry| entry.filename == path }
+  end
+  alias_method :exist?, :exists?
+
+  def read(path)
+    entry = find(path)
+    return unless entry
+
+    reader = entry.extractor_from(@io)
+    content = +""
+
+    until reader.eof?
+      chunk = reader.extract(64.kilobytes)
+      break if chunk.nil?
+
+      content << chunk
+    end
+
+    content
+  end
+
+  def open(path)
+    entry = find(path)
+    return unless entry
+
+    reader = entry.extractor_from(@io)
+    yield reader
+  end
+
+  private
+    attr_reader :io, :entries
+
+    def find(path)
+      entries.find { |entry| entry.filename == path }
+    end
+end
