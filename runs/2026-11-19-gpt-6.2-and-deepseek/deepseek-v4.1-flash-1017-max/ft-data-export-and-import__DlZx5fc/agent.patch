+
+  def zip
+    file
+  end
+
+  def failure_reason
+    error
+  end
+
+  def accessible_to?(user)
+    user.present? && user.account_id == account_id
+  end
+
+  def publicly_accessible?
+    false
+  end
+
+  def process_later
+    Import::ProcessJob.perform_later(self)
+  end
+
+  def process_now
+    return if completed? || processing?
+
+    update!(status: :processing, error: nil)
+
+    account = Account::DataTransfer::Importer.new(self).import
+
+    update!(status: :completed, imported_account: account)
+    deliver_notification { ImportMailer.completed(self).deliver_later }
+  rescue => error
