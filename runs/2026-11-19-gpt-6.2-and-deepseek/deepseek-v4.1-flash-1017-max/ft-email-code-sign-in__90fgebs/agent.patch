@@ -0,0 +1,25 @@
+class IdentityMailer < ApplicationMailer
+  def sign_in_code(*args, **options)
+    pending_authentication = options[:pending_authentication] || args.find { |arg| arg.is_a?(PendingAuthentication) }
+    identity = options[:identity] || args.find { |arg| arg.is_a?(Identity) }
+    code = options[:code]
+    email_address = options[:email_address]
+
+    if args.any?
+      recipient = args.first
+      code ||= args.second
+
+      if recipient.is_a?(Identity)
+        identity ||= recipient
+      elsif !recipient.is_a?(PendingAuthentication)
+        email_address ||= recipient
+      end
+    end
+
+    @pending_authentication = pending_authentication
+    @code = code || pending_authentication&.code
+    @email_address = email_address || identity&.email_address || pending_authentication&.email_address
+
+    mail to: @email_address, subject: "Your Fizzy sign-in code: #{@code}"
+  end
+end
