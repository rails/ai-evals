diff --git a/app/models/pending_authentication.rb b/app/models/pending_authentication.rb
new file mode 100644
index 0000000..3e46266
--- /dev/null
+++ b/app/models/pending_authentication.rb
@@ -0,0 +1,64 @@
+class PendingAuthentication < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_EXPIRATION = 15.minutes
+  PURPOSES = %w[ sign_in sign_up join ]
+
+  attribute :purpose, :string, default: "sign_in"
+
+  belongs_to :identity, optional: true
+  belongs_to :account, optional: true
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  before_validation :generate_code, on: :create
+  before_validation :set_expiration, on: :create
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, length: { is: CODE_LENGTH }
+  validates :expires_at, presence: true
+  validates :purpose, inclusion: { in: PURPOSES }
+
+  def self.issue!(email_address:, purpose:, **attributes)
+    create!(email_address: email_address, purpose: purpose, **attributes).tap do |pending_authentication|
+      IdentityMailer.sign_in_code(pending_authentication).deliver_later
+    end
+  end
+
+  def sign_in?
+    purpose == "sign_in"
+  end
+
+  def sign_up?
+    purpose == "sign_up"
+  end
+
+  def join?
+    purpose == "join"
+  end
+
+  def matches_code?(candidate)
+    candidate.present? && ActiveSupport::SecurityUtils.secure_compare(code, candidate.to_s.strip.upcase)
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  def usable?
+    consumed_at.nil? && !expired?
+  end
+
+  def consume!
+    update!(consumed_at: Time.current)
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(CODE_LENGTH).upcase if code.blank?
+    end
+
+    def set_expiration
+      self.expires_at ||= CODE_EXPIRATION.from_now
+    end
+end
