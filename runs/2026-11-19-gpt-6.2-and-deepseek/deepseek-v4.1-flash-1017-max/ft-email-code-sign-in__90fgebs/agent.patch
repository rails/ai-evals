--- /dev/null
+++ b/test/controllers/email_authentication_test.rb
@@ -0,0 +1,224 @@
+require "test_helper"
+
+class EmailAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "sign in with an emailed code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+
+      get new_session_magic_link_path(script_name: nil)
+      assert_response :success
+      assert_select "input[name=code]"
+
+      post session_magic_link_path(script_name: nil), params: { code: code_from_last_email }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "sign up with an emailed code" do
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        assert_emails 1 do
+          post signup_path, params: { signup: { email_address: "new-person@example.com" } }
+        end
+      end
+
+      assert_redirected_to new_session_magic_link_path
+
+      post session_magic_link_path(script_name: nil), params: { code: code_from_last_email }
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "signup completes after authenticating with an emailed code" do
+    untenanted do
+      assert_emails 1 do
+        post signup_path, params: { signup: { email_address: "completing-person@example.com" } }
+      end
+
+      post session_magic_link_path(script_name: nil), params: { code: code_from_last_email }
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "Completing Person" } }
+      end
+
+      assert_response :redirect
+    end
+  end
+
+  test "join an account with an emailed code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    email_address = "joiner@example.com"
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_emails 1 do
+        post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+      end
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+
+    assert_difference -> { User.count }, 1 do
+      assert_difference -> { join_code.reload.usage_count }, 1 do
+        post session_magic_link_path(script_name: nil), params: { code: code_from_last_email }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    user = Identity.find_by!(email_address: email_address).users.find_by!(account: account)
+
+    get new_users_verification_path(script_name: account.slug)
+    assert_response :success
+
+    post users_verifications_path(script_name: account.slug)
+    assert_redirected_to new_users_join_path
+
+    post users_joins_path(script_name: account.slug), params: { user: { name: "Joiner" } }
+    assert_redirected_to landing_path
+    assert_equal "Joiner", user.reload.name
+  end
+
+  test "codes expire after fifteen minutes" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      code = code_from_last_email
+
+      travel 16.minutes do
+        post session_magic_link_path(script_name: nil), params: { code: code }
+      end
+
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+
+test "sign in normalizes the email address" do
+  identity = identities(:kevin)
+
+  untenanted do
+    assert_emails 1 do
+      post session_path, params: { email_address: identity.email_address.upcase }
+    end
+
+    assert_equal [ identity.email_address ], ActionMailer::Base.deliveries.last.to
+    post session_magic_link_path(script_name: nil), params: { code: code_from_last_email }
+
+    assert cookies[:session_token].present?
+  end
+end
+  test "the code is included in the email subject" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_match(/\b[A-Z0-9]{6}\b/, email.subject)
+  end
+
+  test "sign in via JSON with a pending authentication token" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path(format: :json), params: { email_address: identity.email_address }
+      end
+
+      assert_response :created
+      pending_authentication_token = @response.parsed_body["pending_authentication_token"]
+      assert pending_authentication_token.present?
+      assert_equal pending_authentication_token, cookies[:pending_authentication_token]
+
+      cookies.delete :pending_authentication_token
+      cookies[:pending_authentication_token] = pending_authentication_token
+
+      post session_magic_link_path(script_name: nil, format: :json), params: { code: code_from_last_email }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+
+test "sign in via JSON by submitting the pending token as a parameter" do
+  identity = identities(:kevin)
+
+  untenanted do
+    assert_emails 1 do
+      post session_path(format: :json), params: { email_address: identity.email_address }
+    end
+
+    pending_authentication_token = @response.parsed_body["pending_authentication_token"]
+    code = code_from_last_email
+
+    cookies.delete :pending_authentication_token
+    post session_magic_link_path(script_name: nil, format: :json),
+      params: { code: code, pending_authentication_token: pending_authentication_token }
+
+    assert_response :success
+    assert @response.parsed_body["session_token"].present?
+  end
+end
+  test "an invalid code returns unauthorized via JSON" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path(format: :json), params: { email_address: identity.email_address }
+      end
+
+      post session_magic_link_path(script_name: nil, format: :json), params: { code: "BAD123" }
+
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "a code can only be used once" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      code = code_from_last_email
+      post session_magic_link_path(script_name: nil), params: { code: code }
+      assert cookies[:session_token].present?
+
+      delete session_path
+      post session_magic_link_path(script_name: nil), params: { code: code }
+
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  private
+    def code_from_last_email
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
