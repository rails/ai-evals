diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..28844ae
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,129 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  skip_before_action :redirect_tenanted_request
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    if pending_authentication&.usable?
+      @email_address = pending_authentication.email_address
+    else
+      clear_pending_authentication_cookie
+      redirect_to new_session_path, alert: "Enter your email to get a new code."
+    end
+  end
+
+  def create
+    if pending_authentication&.usable? && pending_authentication.matches_code?(params[:code])
+      pending_authentication.consume!
+      authenticate
+    else
+      code_rejected
+    end
+  end
+
+  private
+    def pending_authentication
+      @pending_authentication ||= find_pending_authentication
+    end
+
+    def find_pending_authentication
+      if token = cookies.signed[:pending_authentication_token].presence
+        PendingAuthentication.find_signed(token)
+      elsif token = params[:pending_authentication_token].presence
+        PendingAuthentication.find_signed(token) || pending_authentication_from_signed_cookie(token)
+      end
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+
+    def pending_authentication_from_signed_cookie(token)
+      cookie_jar = ActionDispatch::Cookies::CookieJar.build(request, { "pending_authentication_token" => token })
+
+      if signed_token = cookie_jar.signed[:pending_authentication_token]
+        PendingAuthentication.find_signed(signed_token)
+      end
+    end
+
+    def authenticate
+      if pending_authentication.join?
+        join_account or return
+      end
+
+      identity = @joined_identity || pending_authentication.identity || Identity.find_or_create_by!(email_address: pending_authentication.email_address)
+
+      terminate_session if Current.session
+      start_new_session_for identity
+      clear_pending_authentication_cookie
+
+      respond_to do |format|
+        format.html { redirect_to destination_for(identity) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def join_account
+      account = pending_authentication.account
+      join_code = pending_authentication.join_code
+
+      if account && join_code&.active?
+        identity = pending_authentication.identity || Identity.find_or_create_by!(email_address: pending_authentication.email_address)
+
+        Current.with_account(account) do
+          join_code.redeem_if { |account| identity.join(account) }
+          user = User.active.find_by!(account: account, identity: identity)
+          @join_redirect_url = user.setup? ? landing_url(script_name: account.slug) : new_users_verification_url(script_name: account.slug)
+        end
+
+        @joined_identity = identity
+        true
+      else
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "That join code is no longer active." }
+          format.json { render json: { message: "That join code is no longer active." }, status: :gone }
+        end
+
+        false
+      end
+    end
+
+    def destination_for(identity)
+      if pending_authentication.join?
+        @join_redirect_url
+      elsif pending_authentication.sign_up?
+        new_signup_completion_path(script_name: nil)
+      elsif identity.users_with_active_accounts.any?
+        after_authentication_url
+      else
+        session_menu_path(script_name: nil)
+      end
+    end
+
+    def code_rejected
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html do
+          if pending_authentication&.usable?
+            redirect_to new_session_magic_link_path(script_name: nil), alert: message
+          else
+            clear_pending_authentication_cookie
+            redirect_to new_session_path, alert: "Enter your email to get a new code."
+          end
+        end
+
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
