+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  test "adding and removing a reaction" do
+    sign_in_as users(:david)
+    comment = comments(:logo_agreement_kevin)
+    comment_selector = "##{dom_id(comment)}"
+
+    visit card_url(comment.card)
+    page.execute_script("document.querySelector('#{comment_selector}').scrollIntoView({ block: 'center' })")
+
+    find("#{comment_selector} .reactions__trigger").click
+    find("#{comment_selector} .reaction__input").set("👍")
+    find("#{comment_selector} .reaction__submit-btn").click
+
+    assert_selector "#{comment_selector} .reaction .txt-small", text: "👍"
+    assert_selector "#{comment_selector} .reactions__trigger", visible: true
+    assert_no_selector "#{comment_selector} .reaction__form", visible: true
+    sleep 1
+
+    page.execute_script("document.querySelector('#{comment_selector}').scrollIntoView({ block: 'center' })")
+    find("#{comment_selector} .reaction", text: "👍").click
+    assert_selector "#{comment_selector} .reaction.expanded"
+    find("#{comment_selector} .reaction__delete").click
+
+    assert_no_selector "#{comment_selector} .reaction .txt-small", text: "👍"
+    assert_selector "#{comment_selector} .reactions__trigger", visible: true
+  end
+end
+
+class CommentReactionEmojiTest < ApplicationSystemTestCase
+  test "choosing an emoji fills the reaction input" do
+    sign_in_as users(:david)
+    comment = comments(:logo_agreement_kevin)
+    comment_selector = "##{dom_id(comment)}"
+
+    visit card_url(comment.card)
+    page.execute_script("document.querySelector('#{comment_selector}').scrollIntoView({ block: 'center' })")
+
+    find("#{comment_selector} .reactions__trigger").click
+    find("#{comment_selector} .reaction__menu-btn").click
+    assert_selector "#{comment_selector} .reaction__popup[open]"
+
+    find("#{comment_selector} .reaction__emoji-list .btn", text: "👍").click
+    assert_no_selector "#{comment_selector} .reaction__popup[open]"
+    assert_equal "👍", find("#{comment_selector} .reaction__input").value
+  end
+end
+
+class OtherUsersReactionTest < ApplicationSystemTestCase
+  test "another user's reaction cannot be removed" do
+    sign_in_as users(:david)
+    comment = comments(:logo_agreement_kevin)
+    comment.reactions.create!(reacter: users(:kevin), content: "🎉")
+    comment_selector = "##{dom_id(comment)}"
+
+    visit card_url(comment.card)
+    page.execute_script("document.querySelector('#{comment_selector}').scrollIntoView({ block: 'center' })")
+
+    find("#{comment_selector} .reaction", text: "🎉").click
+    assert_selector "#{comment_selector} .reaction.expanded"
+    assert_no_selector "#{comment_selector} .reaction__delete", visible: true
+  end
+end
+
+class CancelReactionTest < ApplicationSystemTestCase
+  test "cancelling closes the reaction form without adding a reaction" do
+    sign_in_as users(:david)
+    comment = comments(:logo_agreement_kevin)
+    comment_selector = "##{dom_id(comment)}"
+
+    visit card_url(comment.card)
+    page.execute_script("document.querySelector('#{comment_selector}').scrollIntoView({ block: 'center' })")
+
+    find("#{comment_selector} .reactions__trigger").click
+    find("#{comment_selector} .reaction__input").set("👍")
+    find("#{comment_selector} .reaction__cancel-btn").click
+
+    assert_no_selector "#{comment_selector} .reaction__form", visible: true
+    assert_selector "#{comment_selector} .reactions__trigger", visible: true
+    assert_no_selector "#{comment_selector} .reaction"
+  end
+end
