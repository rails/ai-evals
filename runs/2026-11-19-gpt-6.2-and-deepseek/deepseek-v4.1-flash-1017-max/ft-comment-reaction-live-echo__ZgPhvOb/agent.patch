diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..3365aa7
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,120 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "create as turbo stream" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions)
+    assert_equal "👍", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    reaction = @comment.reactions.last
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "Great 👍", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, reaction), @response.parsed_body["url"]
+  end
+
+  test "create with flat params as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "Nice" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Nice", @comment.reactions.last.content
+  end
+
+  test "create rejects content over 16 characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy own reaction as turbo stream" do
+    reaction = @comment.reactions.create!(reacter: users(:kevin), content: "👍")
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions)
+  end
+
+  test "destroy own reaction as JSON" do
+    reaction = @comment.reactions.create!(reacter: users(:kevin), content: "👍")
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "cannot destroy another user's reaction" do
+    reaction = @comment.reactions.create!(reacter: users(:david), content: "👍")
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "index as JSON" do
+    @comment.reactions.create!(reacter: users(:david), content: "👍")
+    @comment.reactions.create!(reacter: users(:kevin), content: "🎉")
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal 2, @response.parsed_body.size
+    assert_equal [ "👍", "🎉" ], @response.parsed_body.map { it["content"] }
+  end
+end
+
+class Cards::Comments::ReactionsRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "comments render a reactions strip with the add control" do
+    @comment.reactions.create!(reacter: users(:david), content: "👍")
+
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)}.reactions" do
+      assert_select ".reaction", 1
+      assert_select ".reaction .txt-small", text: "👍"
+      assert_select ".reaction", text: /David reacted with/
+      assert_select "form.reaction__form input[name=?]", "authenticity_token", count: 0
+      assert_select "form.reaction__form[hidden]"
+      assert_select ".reactions__trigger img[src*='boost-color']"
+      assert_select "form.reaction__form[action=?]", card_comment_reactions_path(@card, @comment)
+      assert_select "form.reaction__form .reaction__input[maxlength='16']"
+      assert_select ".reaction__submit-btn"
+      assert_select ".reaction__cancel-btn"
+    end
+  end
+end
