+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    @comment = comments(:logo_agreement_kevin)
+    @reacter = users(:david)
+  end
+
+  test "requires content" do
+    reaction = @comment.reactions.build(reacter: @reacter, content: "")
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "limits content to 16 characters" do
+    reaction = @comment.reactions.build(reacter: @reacter, content: "a" * 17)
+    assert_not reaction.valid?
+    assert reaction.errors[:content].any?
+  end
+
+  test "defaults account from comment" do
+    reaction = @comment.reactions.create!(reacter: @reacter, content: "👍")
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "registers card activity" do
+    assert_changes -> { @comment.card.reload.last_active_at } do
+      @comment.reactions.create!(reacter: @reacter, content: "👍")
+    end
+  end
+end
+
+class ReactionBroadcastTest < ActiveSupport::TestCase
+  include Turbo::Broadcastable::TestHelper
+
+  setup do
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "broadcasts card refresh when a reaction is created" do
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts @comment.card, count: 1 do
+        @comment.reactions.create!(reacter: users(:david), content: "👍")
+      end
+    end
+  end
+
+  test "broadcasts card refresh when a reaction is destroyed" do
+    reaction = @comment.reactions.create!(reacter: users(:david), content: "👍")
+
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts @comment.card, count: 1 do
+        reaction.destroy!
+      end
+    end
+  end
+end
