--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -1,6 +1,8 @@
 class User < ApplicationRecord
   include Authoring, Role, Transferable
 
+  DELETED_AUTHOR = "Deleted author"
+
   has_many :sessions, dependent: :destroy
   has_secure_password validations: false
 
@@ -8,6 +10,9 @@ class User < ApplicationRecord
   has_many :books, through: :accesses
   has_many :leaves, through: :books
 
+  # Run before dependent associations so shared books can be preserved.
+  before_destroy :erase_personal_data, prepend: true
+
   after_create :grant_access_to_everyone_books
 
   scope :active, -> { where(active: true) }
@@ -17,6 +22,10 @@ class User < ApplicationRecord
     self == Current.user
   end
 
+  def erase!
+    destroy!
+  end
+
   def deactivate
     transaction do
       sessions.delete_all
@@ -29,6 +38,56 @@ class User < ApplicationRecord
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
 
+    def erase_personal_data
+      Session.where(user_id: id).delete_all
+      association(:sessions).reset
+
+      SignInEvent.where(email_address: sign_in_email_addresses).delete_all
+
+      ReadingMark.where(user_id: id).delete_all
+      association(:reading_marks).reset
+
+      Access.where(user_id: id).delete_all
+      association(:accesses).reset
+
+      erase_created_books
+    end
+
+    def sign_in_email_addresses
+      addresses = [ email_address ]
+      while (previous_address = previous_deactivated_email_address(addresses.last))
+        addresses << previous_address
+      end
+      addresses.compact.uniq
+    end
+
+    def previous_deactivated_email_address(address)
+      return unless address
+
+      previous = address.sub(/-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@/i, "@")
+      previous if previous != address
+    end
+
+    def erase_created_books
+      Book.where(creator_id: id, everyone_access: true)
+        .update_all(author: DELETED_AUTHOR, creator_id: nil, updated_at: Time.current)
+      association(:created_books).reset
+
+      leaf_ids = Leaf.joins(:book)
+        .where(books: { creator_id: id })
+        .distinct
+        .pluck(:id)
+      remove_search_index_entries(leaf_ids)
+    end
+
+    def remove_search_index_entries(leaf_ids)
+      return if leaf_ids.empty?
+
+      Leaf.connection.execute(
+        Leaf.sanitize_sql([ "DELETE FROM leaf_search_index WHERE rowid IN (?)", leaf_ids ])
+      )
+    end
+
     def grant_access_to_everyone_books
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
