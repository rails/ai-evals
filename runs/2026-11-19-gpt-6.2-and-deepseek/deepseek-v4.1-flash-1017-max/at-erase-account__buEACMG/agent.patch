diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..cc2bdaf 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,58 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "erasing a user removes their data and preserves books shared with everyone" do
+    user = users(:kevin)
+    private_book = books(:manual)
+    shared_book = books(:handbook)
+    private_book.update!(creator: user, everyone_access: false, author: user.name)
+    shared_book.update!(creator: user, everyone_access: true, author: user.name)
+
+    private_leaf = private_book.press(Page.new(body: "uniqueerasureprivateword"), title: "Private erasure page")
+    private_leaf.reindex
+    shared_leaf = leaves(:welcome_page)
+    shared_leaf.reindex
+
+    user.sessions.create!
+    SignInEvent.create!(action: :signed_in, email_address: user.email_address)
+    unrelated_event = SignInEvent.create!(action: :signed_in, email_address: "unrelated@example.com")
+    ReadingMark.create!(user: user, leaf: shared_leaf, last_read_at: Time.current)
+
+    user.erase!
+
+    assert_not User.exists?(user.id)
+    assert_equal 0, Access.where(user_id: user.id).count
+    assert_equal 0, Session.where(user_id: user.id).count
+    assert_equal 0, ReadingMark.where(user_id: user.id).count
+    assert_equal 0, SignInEvent.where(email_address: user.email_address).count
+    assert SignInEvent.exists?(unrelated_event.id)
+
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_empty Leaf.search("uniqueerasureprivateword").to_a
+
+    assert Book.exists?(shared_book.id)
+    assert_equal "Deleted author", shared_book.reload.author
+    assert_nil shared_book.creator_id
+    assert Leaf.exists?(shared_leaf.id)
+    assert_includes Leaf.search("handbook").to_a, shared_leaf
+  end
+
+  test "erasing a deactivated user removes sign in events under their original address" do
+    user = users(:kevin)
+    original_address = user.email_address
+    SignInEvent.create!(action: :signed_in, email_address: original_address)
+    SignInEvent.create!(action: :signed_out, email_address: original_address)
+
+    user.deactivate
+    scrambled_address = user.reload.email_address
+    assert_not_equal original_address, scrambled_address
+    SignInEvent.create!(action: :signed_in, email_address: scrambled_address)
+
+    user.erase!
+
+    assert_not User.exists?(user.id)
+    assert_equal 0, SignInEvent.where(email_address: [ original_address, scrambled_address ]).count
+  end
 end
