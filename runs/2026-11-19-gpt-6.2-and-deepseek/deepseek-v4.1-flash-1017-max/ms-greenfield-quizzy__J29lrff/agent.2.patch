+    <div class="errors" role="alert">
+      <ul>
+        <% @import_errors.each do |message| %>
+          <li><%= message %></li>
+        <% end %>
+      </ul>
+    </div>
+  <% end %>
+
+  <div class="field">
+    <%= form.label :quiz_json, "Quiz JSON" %>
+    <%= form.text_area :quiz_json, value: @quiz_json, rows: 18, class: "input input--code" %>
+  </div>
+
+  <div class="buttons">
+    <%= form.submit "Import", class: "btn btn--pink" %>
+    <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+  </div>
+<% end %>
