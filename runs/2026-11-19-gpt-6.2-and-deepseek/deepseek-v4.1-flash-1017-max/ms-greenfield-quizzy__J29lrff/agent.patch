diff --git a/app/views/moderate/quizzes/show.html.erb b/app/views/moderate/quizzes/show.html.erb
new file mode 100644
index 0000000..68b0a4b
--- /dev/null
+++ b/app/views/moderate/quizzes/show.html.erb
@@ -0,0 +1,95 @@
+<% content_for :title, @quiz.title %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+
+<div class="page-head">
+  <div>
+    <h1><%= @quiz.title %></h1>
+    <div class="meta mt-2">
+      <%= pluralize(@quiz.active_questions.count, "active question") %> of <%= pluralize(@quiz.questions.count, "question") %>
+      · Number of winners: <%= @quiz.number_of_winners %>
+      · <%= @quiz.timer_enabled? ? "Timer: #{format_countdown(@quiz.timer_duration_seconds)} per question" : "No timer" %>
+    </div>
+  </div>
+  <div class="buttons">
+    <%= button_to "Start a game",
+                  moderate_quiz_games_path(@quiz),
+                  method: :post,
+                  class: "btn btn--pink",
+                  form: { data: { turbo: false } } %>
+    <%= link_to "Settings", edit_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+    <%= link_to "Export", export_moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+    <%= link_to "Preview", moderate_quiz_preview_path(@quiz, start: 1), class: "btn btn--ghost" %>
+  </div>
+</div>
+
+<section class="section mt-0">
+  <div class="section-head">
+    <h2>Questions</h2>
+    <%= link_to "Add question", new_moderate_quiz_question_path(@quiz), class: "btn" %>
+  </div>
+
+  <% if @quiz.questions.any? %>
+    <% active_number = 0 %>
+    <ul class="question-list">
+      <% @quiz.questions.each_with_index do |question, question_index| %>
+        <% active_number += 1 if question.active? %>
+        <li>
+          <article class="card question-item <%= "question-item--inactive" unless question.active? %>">
+            <div class="question-item__num"><%= question.active? ? active_number : "—" %></div>
+
+            <div>
+              <div class="question-item__body"><%= question.body %></div>
+              <ul class="question-item__options">
+                <% question.options.each_with_index do |option, option_index| %>
+                  <li class="<%= "is-correct" if option.correct? %>">
+                    <%= option_letter(option_index) %>. <%= option.body %>
+                  </li>
+                <% end %>
+              </ul>
+            </div>
+
+            <div class="question-item__actions">
+              <div class="buttons">
+                <%= button_to "Move up",
+                              move_moderate_quiz_question_path(@quiz, question, direction: "up"),
+                              method: :patch,
+                              class: "btn btn--ghost btn--sm",
+                              disabled: question_index.zero?,
+                              form: { data: { turbo: false } } %>
+                <%= button_to "Move down",
+                              move_moderate_quiz_question_path(@quiz, question, direction: "down"),
+                              method: :patch,
+                              class: "btn btn--ghost btn--sm",
+                              disabled: question_index == @quiz.questions.length - 1,
+                              form: { data: { turbo: false } } %>
+              </div>
+
+              <%= form_with url: moderate_quiz_question_path(@quiz, question),
+                            method: :patch,
+                            class: "inline-form",
+                            data: { turbo: false } do |active_form| %>
+                <%= hidden_field_tag "question[active]", "0", id: nil %>
+                <%= check_box_tag "question[active]", "1", question.active?,
+                                  id: "question_#{question.id}_active",
+                                  onchange: "this.form.requestSubmit()" %>
+                <%= label_tag "question_#{question.id}_active", "Active" %>
+              <% end %>
+
+              <div class="buttons">
+                <%= link_to "Edit", edit_moderate_quiz_question_path(@quiz, question), class: "btn btn--sm" %>
+                <%= button_to "Delete",
+                              moderate_quiz_question_path(@quiz, question),
+                              method: :delete,
+                              class: "btn btn--sm btn--danger",
+                              form: { onsubmit: "return confirm('Delete this question?');", data: { turbo: false } } %>
+              </div>
+            </div>
+          </article>
+        </li>
+      <% end %>
+    </ul>
+  <% else %>
+    <div class="empty">No questions yet. Add your first question.</div>
+  <% end %>
+</section>
diff --git a/app/views/play/_live.html.erb b/app/views/play/_live.html.erb
new file mode 100644
index 0000000..46999c0
--- /dev/null
+++ b/app/views/play/_live.html.erb
@@ -0,0 +1,121 @@
+<% if @game.ended? %>
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <% if @player %>
+      <span>Hi, <%= @player.name %>!</span>
+    <% end %>
+  </div>
+  <% if @player %>
+    <div class="play__body">
+      <div class="result-card">
+        <div class="result-card__place"><%= @place %></div>
+        <div class="result-card__label">Place <%= @place %> of <%= @total_players %></div>
+        <div class="result-card__score"><%= pluralize(@points, "point") %></div>
+        <% if @winner %>
+          <div class="winner-banner">You won!</div>
+        <% end %>
+      </div>
+    </div>
+  <% else %>
+    <div class="play__body waiting">
+      <h1 class="play-title">The quiz is over</h1>
+    </div>
+  <% end %>
+<% elsif @player.nil? %>
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+  </div>
+  <div class="play__body play__body--top">
+    <h1 class="play-title"><%= @game.quiz.title %></h1>
+    <p class="play-lead">Join the quiz</p>
+
+    <% if @join_errors.present? %>
+      <div class="errors">
+        <ul>
+          <% @join_errors.each do |error| %>
+            <li><%= error %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <%= form_with url: join_play_game_path(@game.code),
+                  method: :post,
+                  class: "join-form",
+                  data: { turbo: false } do %>
+      <div class="field">
+        <%= label_tag "name", "Your name" %>
+        <%= text_field_tag "name",
+                           @join_name,
+                           id: "name",
+                           class: "input",
+                           placeholder: "Your name",
+                           autocomplete: "name",
+                           required: true %>
+      </div>
+      <%= submit_tag "Join", class: "btn btn--pink" %>
+    <% end %>
+  </div>
+<% elsif @game.waiting? %>
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+  </div>
+  <div class="play__body waiting">
+    <div class="waiting__gem">?</div>
+    <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+    <p class="play-lead">Waiting for the quiz to start…</p>
+  </div>
+<% elsif @game.question? && @current_question %>
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span>Hi, <%= @player.name %>!</span>
+  </div>
+  <div class="play__body play__body--top">
+    <div class="play-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+    <div class="play-question__body"><%= @current_question.body %></div>
+
+    <div class="play-options">
+      <% @current_question.options.each_with_index do |option, index| %>
+        <% selected = option.id == @selected_option_id %>
+        <%= button_to answer_play_game_path(@game.code),
+                      method: :post,
+                      params: { option_id: option.id },
+                      class: "play-option #{ "is-picked" if selected }",
+                      form: { class: "play-answer-form",
+                              data: { live_answer_form: true, option_id: option.id } } do %>
+          <span class="play-option__letter"><%= option_letter(index) %></span>
+          <span class="play-option__title"><%= option.body %></span>
+          <% if selected %>
+            <span class="play-option__mark">Your answer</span>
+          <% end %>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+<% elsif @game.results? && @current_question %>
+  <% result_text = if @answer.nil? || @answer.option.nil?
+                     "No answer"
+                   elsif @answer.option.correct?
+                     "Correct!"
+                   else
+                     "Wrong!"
+                   end %>
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span>Hi, <%= @player.name %>!</span>
+  </div>
+  <div class="play__body">
+    <div class="play-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+    <div class="play-question__body"><%= @current_question.body %></div>
+    <div class="play-status <%= result_text == "Correct!" ? "play-status--right" : (result_text == "Wrong!" ? "play-status--wrong" : "play-status--neutral") %>">
+      <%= result_text %>
+    </div>
+  </div>
+<% else %>
+  <div class="play__top">
+    <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+  </div>
+  <div class="play__body waiting">
+    <h1 class="play-title">The quiz is over</h1>
+  </div>
+<% end %>
