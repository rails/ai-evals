diff --git a/app/models/quiz.rb b/app/models/quiz.rb
new file mode 100644
index 0000000..4c10c63
--- /dev/null
+++ b/app/models/quiz.rb
@@ -0,0 +1,57 @@
+class Quiz < ApplicationRecord
+  has_many :questions, -> { order(:position, :id) }, dependent: :destroy, inverse_of: :quiz
+  has_many :games, dependent: :destroy, inverse_of: :quiz
+
+  validates :title, presence: true
+  validates :number_of_winners,
+            numericality: { only_integer: true, greater_than_or_equal_to: 1 }
+  validates :timer_minutes,
+            numericality: { only_integer: true, greater_than_or_equal_to: 0 }
+  validates :timer_seconds,
+            numericality: { only_integer: true, greater_than_or_equal_to: 0 }
+
+  before_validation :normalize_timer_values
+
+  def active_questions
+    questions.where(active: true)
+  end
+
+  # The timer is a Quizzy setting and is deliberately not part of the portable
+  # quiz export format.
+  def timer_duration_seconds
+    (timer_minutes.to_i * 60) + timer_seconds.to_i
+  end
+
+  def timer_enabled?
+    timer_duration_seconds.positive?
+  end
+
+  # The portable quiz format intentionally contains only the data needed to
+  # move quiz contents between Quizzy instances. Database ids and timestamps
+  # must never be included.
+  def export_payload
+    {
+      title: title,
+      number_of_winners: number_of_winners,
+      questions: questions.map do |question|
+        {
+          text: question.body,
+          active: question.active?,
+          options: question.options.map do |option|
+            {
+              text: option.body,
+              correct: option.correct?
+            }
+          end
+        }
+      end
+    }
+  end
+
+  private
+
+  def normalize_timer_values
+    self.timer_minutes = 0 if timer_minutes.blank?
+    self.timer_seconds = 0 if timer_seconds.blank?
+  end
+end
diff --git a/app/services/quiz_importer.rb b/app/services/quiz_importer.rb
new file mode 100644
index 0000000..8d00715
--- /dev/null
+++ b/app/services/quiz_importer.rb
@@ -0,0 +1,153 @@
+# Parses and validates the quiz transfer format before creating any records.
+# The whole import runs in a transaction, so a validation or persistence
+# failure cannot leave a partially imported quiz behind.
+class QuizImporter
+  class Error < StandardError
+    attr_reader :messages
+
+    def initialize(messages)
+      @messages = Array(messages)
+      super(@messages.join(" "))
+    end
+  end
+
+  def initialize(raw_json)
+    @raw_json = raw_json.to_s
+  end
+
+  def import
+    data = parse_json
+    normalized = normalize_and_validate(data)
+    quiz = build_quiz(normalized)
+
+    Quiz.transaction do
+      quiz.save!
+    end
+
+    quiz
+  rescue ActiveRecord::RecordInvalid => e
+    raise Error.new(e.record.errors.full_messages)
+  end
+
+  private
+
+  def parse_json
+    if @raw_json.strip.empty?
+      raise Error, "Quiz JSON can't be blank."
+    end
+
+    data = JSON.parse(@raw_json)
+    raise Error, "Quiz JSON must contain an object." unless data.is_a?(Hash)
+
+    data
+  rescue JSON::ParserError
+    raise Error, "Quiz JSON is invalid."
+  end
+
+  def normalize_and_validate(data)
+    errors = []
+
+    title = data["title"]
+    unless title.is_a?(String) && title.present?
+      errors << "Quiz title can't be blank."
+    end
+
+    number_of_winners = data.key?("number_of_winners") ? data["number_of_winners"] : 3
+    unless number_of_winners.is_a?(Integer) && number_of_winners >= 1
+      errors << "Number of winners must be a whole number of at least 1."
+    end
+
+    raw_questions = data["questions"]
+    unless raw_questions.is_a?(Array)
+      errors << "Questions must be an array."
+      raw_questions = []
+    end
+
+    questions = raw_questions.each_with_index.filter_map do |raw_question, question_index|
+      question_number = question_index + 1
+
+      unless raw_question.is_a?(Hash)
+        errors << "Question #{question_number} must be an object."
+        next
+      end
+
+      text = raw_question["text"]
+      unless text.is_a?(String) && text.present?
+        errors << "Question #{question_number} text can't be blank."
+      end
+
+      active = raw_question.key?("active") ? raw_question["active"] : true
+      unless [true, false].include?(active)
+        errors << "Question #{question_number} active must be true or false."
+      end
+
+      raw_options = raw_question["options"]
+      unless raw_options.is_a?(Array)
+        errors << "Question #{question_number} options must be an array."
+        next
+      end
+
+      options = raw_options.each_with_index.filter_map do |raw_option, option_index|
+        option_number = option_index + 1
+
+        unless raw_option.is_a?(Hash)
+          errors << "Question #{question_number} option #{option_number} must be an object."
+          next
+        end
+
+        option_text = raw_option["text"]
+        unless option_text.is_a?(String)
+          errors << "Question #{question_number} option #{option_number} text can't be blank."
+          next
+        end
+
+        # Match the question form: empty option rows are skipped.
+        next if option_text.blank?
+
+        correct = raw_option.key?("correct") ? raw_option["correct"] : false
+        unless [true, false].include?(correct)
+          errors << "Question #{question_number} option #{option_number} correct must be true or false."
+          next
+        end
+
+        { text: option_text, correct: correct }
+      end
+
+      if options.length < 2
+        errors << "Question #{question_number} must have at least two options."
+      end
+
+      unless options.any? { |option| option[:correct] }
+        errors << "Question #{question_number} must have at least one correct option."
+      end
+
+      { text: text, active: active, options: options }
+    end
+
+    raise Error.new(errors) if errors.any?
+
+    { title: title, number_of_winners: number_of_winners, questions: questions }
+  end
+
+  def build_quiz(normalized)
+    quiz = Quiz.new(title: normalized[:title], number_of_winners: normalized[:number_of_winners])
+
+    normalized[:questions].each_with_index do |question_attributes, question_index|
+      question = quiz.questions.build(
+        body: question_attributes[:text],
+        active: question_attributes[:active],
+        position: question_index
+      )
+
+      question_attributes[:options].each_with_index do |option_attributes, option_index|
+        question.options.build(
+          body: option_attributes[:text],
+          correct: option_attributes[:correct],
+          position: option_index
+        )
+      end
+    end
+
+    quiz
+  end
+end
diff --git a/app/views/layouts/application.html.erb b/app/views/layouts/application.html.erb
new file mode 100644
index 0000000..46ace4c
--- /dev/null
+++ b/app/views/layouts/application.html.erb
@@ -0,0 +1,36 @@
+<!DOCTYPE html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <title><%= content_for(:title) || "Quizzy" %></title>
+    <meta name="viewport" content="width=device-width,initial-scale=1">
+    <meta name="apple-mobile-web-app-capable" content="yes">
+    <meta name="application-name" content="Quizzy">
+    <meta name="mobile-web-app-capable" content="yes">
+    <%= csrf_meta_tags %>
+    <%= csp_meta_tag %>
+    <%= yield :head %>
+    <link rel="icon" href="/icon.png" type="image/png">
+    <link rel="icon" href="/icon.svg" type="image/svg+xml">
+    <link rel="apple-touch-icon" href="/icon.png">
+    <%= stylesheet_link_tag "quizzy", "data-turbo-track": "reload" %>
+    <%= javascript_importmap_tags %>
+  </head>
+
+  <body>
+    <header class="admin-header">
+      <%= link_to moderate_root_path, class: "logo admin-header__logo" do %>
+        <span class="logo__mark">?</span>Quizzy
+      <% end %>
+      <span class="admin-header__tag">Moderator</span>
