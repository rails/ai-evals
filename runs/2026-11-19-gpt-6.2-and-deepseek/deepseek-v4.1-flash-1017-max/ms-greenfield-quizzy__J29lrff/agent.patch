diff --git a/app/views/moderate/games/_live.html.erb b/app/views/moderate/games/_live.html.erb
new file mode 100644
index 0000000..172f630
--- /dev/null
+++ b/app/views/moderate/games/_live.html.erb
@@ -0,0 +1,145 @@
+<% if @game.waiting? %>
+  <div class="lobby">
+    <div>
+      <div class="screen__kicker">Join this quiz</div>
+      <h1 class="lobby__title"><%= @game.quiz.title %></h1>
+      <div class="lobby__join">Join at</div>
+      <div class="lobby__url"><%= @join_url %></div>
+      <div class="counter-pill">Players: <strong data-live-players><%= @players_count %></strong></div>
+    </div>
+
+    <div class="qr" role="img" aria-label="QR code for <%= @join_url %>">
+      <%= qr_code_svg(@join_url) %>
+    </div>
+  </div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <span>Waiting for players to join</span>
+    </div>
+    <div class="buttons">
+      <%= button_to "Start",
+                    start_moderate_game_path(@game),
+                    class: "btn btn--pink btn--lg",
+                    form: { data: { turbo: false, live_command: true } } %>
+    </div>
+  </div>
+<% elsif @game.question? && @current_question %>
+  <div>
+    <div class="stage-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+    <% if @timer_deadline %>
+      <div class="stage-timer">
+        <span class="stage-timer__label">Time left</span>
+        <span class="stage-timer__value"
+              role="timer"
+              aria-label="Time left"
+              data-quiz-timer
+              data-timer-deadline="<%= @timer_deadline.iso8601(3) %>"
+              data-timer-finish-url="<%= finish_moderate_game_path(@game) %>"><%= format_countdown(@timer_remaining_seconds) %></span>
+      </div>
+    <% end %>
+    <div class="stage-question__body"><%= @current_question.body %></div>
+
+    <ul class="stage-options">
+      <% @current_question.options.each_with_index do |option, index| %>
+        <li class="stage-option">
+          <span class="stage-option__letter"><%= option_letter(index) %></span>
+          <span class="stage-option__title"><%= option.body %></span>
+        </li>
+      <% end %>
+    </ul>
+  </div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <span class="answers-counter">Answers: <span data-live-answers><%= @answered_count %></span> / <span data-live-players><%= @players_count %></span></span>
+    </div>
+    <div class="buttons">
+      <%= button_to "Finish",
+                    finish_moderate_game_path(@game),
+                    class: "btn btn--pink btn--lg",
+                    form: { data: { turbo: false, live_command: true } } %>
+    </div>
+  </div>
+<% elsif @game.results? && @current_question %>
+  <div>
+    <div class="stage-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+    <div class="stage-question__body"><%= @current_question.body %></div>
+
+    <ul class="stage-options stage-options--results">
+      <% @current_question.options.each_with_index do |option, index| %>
+        <% answer_count = @option_answer_counts.fetch(option.id, 0) %>
+        <li class="stage-option <%= "is-correct" if option.correct? %>">
+          <span class="stage-option__letter"><%= option_letter(index) %></span>
+          <span class="stage-option__title"><%= option.body %></span>
+          <span class="stage-option__count"><%= answer_count %></span>
+          <% if option.correct? %>
+            <span class="stage-option__mark">Correct</span>
+          <% end %>
+        </li>
+      <% end %>
+    </ul>
+  </div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <span>Question closed</span>
+    </div>
+    <div class="buttons">
+      <% if @next_question %>
+        <%= button_to "Next",
+                      advance_moderate_game_path(@game),
+                      class: "btn btn--pink btn--lg",
+                      form: { data: { turbo: false, live_command: true } } %>
+      <% else %>
+        <%= button_to "End quiz",
+                      advance_moderate_game_path(@game),
+                      class: "btn btn--pink btn--lg",
+                      form: { data: { turbo: false, live_command: true } } %>
+      <% end %>
+    </div>
+  </div>
+<% else %>
+  <div class="leaderboard-layout">
+    <div>
+      <div class="screen__kicker">Final results</div>
+      <h1 class="leaderboard-layout__title">Leaderboard</h1>
+      <% if @leaderboard.empty? %>
+        <p>No players joined this game.</p>
+      <% end %>
+    </div>
+
+    <div>
+      <ol class="leaderboard">
+        <% @leaderboard.each do |entry| %>
+          <% player = entry[:player] %>
+          <li class="leader <%= "is-winner" if player.winner? %>">
+            <span class="leader__place" aria-label="Place <%= entry[:place] %>"><%= entry[:place] %></span>
+            <span class="leader__name">
+              <%= player.name %>
+              <% if player.winner? %>
+                <span class="leader__badge mark mark--winner">Winner</span>
+              <% end %>
+            </span>
+            <span class="leader__score"><%= pluralize(entry[:points], "point") %></span>
+          </li>
+        <% end %>
+      </ol>
+
+      <div class="buttons mt-2">
+        <%= button_to "Top #{@game.quiz.number_of_winners}",
+                      top_winners_moderate_game_path(@game),
+                      class: "btn btn--pink",
+                      form: { data: { turbo: false, live_command: true } } %>
+        <%= button_to "Draw",
+                      draw_winners_moderate_game_path(@game),
+                      class: "btn",
+                      form: { data: { turbo: false, live_command: true } } %>
+        <%= button_to "Reset winners",
+                      reset_winners_moderate_game_path(@game),
+                      class: "btn btn--ghost",
+                      form: { data: { turbo: false, live_command: true } } %>
+      </div>
+    </div>
+  </div>
+<% end %>
