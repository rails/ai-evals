diff --git a/app/views/moderate/previews/show.html.erb b/app/views/moderate/previews/show.html.erb
new file mode 100644
index 0000000..a16083b
--- /dev/null
+++ b/app/views/moderate/previews/show.html.erb
@@ -0,0 +1,83 @@
+<% content_for :title, "Preview · #{@quiz.title}" %>
+
+<div class="preview-head">
+  <%= link_to "← #{@quiz.title}", moderate_quiz_path(@quiz), class: "meta" %>
+  <span class="admin-header__tag">Preview</span>
+</div>
+
+<% if @active_questions.empty? %>
+  <div class="card result-card">
+    <h1>Preview</h1>
+    <p>There are no active questions to preview.</p>
+    <div class="buttons" style="justify-content: center">
+      <%= link_to "Back to quiz", moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+    </div>
+  </div>
+<% elsif @finished %>
+  <div class="card result-card">
+    <div class="result-card__label">Preview complete</div>
+    <div class="result-card__score">Score: <%= @score %>/<%= @total %></div>
+    <div class="buttons mt-2" style="justify-content: center">
+      <%= button_to "Start over",
+                    restart_moderate_quiz_preview_path(@quiz),
+                    method: :post,
+                    class: "btn btn--pink",
+                    form: { data: { turbo: false } } %>
+    </div>
+  </div>
+<% else %>
+  <% selected_option = @question.options.find { |option| option.id == @selected_option_id } %>
+  <% answered = selected_option.present? %>
+
+  <div class="play-question__num">Question <%= @current_index + 1 %> of <%= @active_questions.length %></div>
+  <div class="play-question__body"><%= @question.body %></div>
+
+  <div class="play-options <%= "is-locked is-revealed" if answered %>">
+    <% @question.options.each_with_index do |option, option_index| %>
+      <% if answered %>
+        <button type="button"
+                class="play-option <%= "is-picked" if option.id == selected_option.id %> <%= "is-correct" if option.correct? %>"
+                data-letter="<%= option_letter(option_index) %>"
+                aria-label="<%= option.body %>"
+                disabled>
+          <span class="play-option__title"><%= option.body %></span>
+          <% if option.correct? %>
+            <span class="play-option__mark">Correct</span>
+          <% end %>
+        </button>
+      <% else %>
+        <%= button_to answer_moderate_quiz_preview_path(@quiz),
+                      method: :post,
+                      params: { option_id: option.id },
+                      class: "play-option",
+                      data: { letter: option_letter(option_index) },
+                      aria: { label: option.body },
+                      form: { data: { turbo: false } } do %>
+          <span class="play-option__title"><%= option.body %></span>
+        <% end %>
+      <% end %>
+    <% end %>
+  </div>
+
+  <% if answered %>
+    <div class="play-status <%= selected_option.correct? ? "play-status--right" : "play-status--wrong" %>">
+      <%= selected_option.correct? ? "Correct!" : "Wrong!" %>
+    </div>
+
+    <div class="buttons mt-2">
+      <% if @current_index + 1 < @active_questions.length %>
+        <%= button_to "Next question",
+                      next_question_moderate_quiz_preview_path(@quiz),
+                      method: :post,
+                      class: "btn btn--pink",
+                      form: { data: { turbo: false } } %>
+      <% else %>
+        <%= button_to "See score",
+                      next_question_moderate_quiz_preview_path(@quiz),
+                      method: :post,
+                      class: "btn btn--pink",
+                      form: { data: { turbo: false } } %>
+      <% end %>
+    </div>
+  <% end %>
+<% end %>
diff --git a/app/views/moderate/questions/_form.html.erb b/app/views/moderate/questions/_form.html.erb
new file mode 100644
index 0000000..33b13b3
--- /dev/null
+++ b/app/views/moderate/questions/_form.html.erb
@@ -0,0 +1,81 @@
+<%= form_with model: [:moderate, @quiz, @question], class: "card", data: { turbo: false } do |form| %>
+  <% if @form_errors.any? %>
+    <div class="errors">
+      <ul>
+        <% @form_errors.each do |message| %>
+          <li><%= message %></li>
+        <% end %>
+      </ul>
+    </div>
+  <% end %>
+
+  <div class="field">
+    <%= form.label :body, "Question" %>
+    <%= form.text_area :body, rows: 3, class: "input", required: true %>
+  </div>
+
+  <div class="field">
+    <span class="field-label">Options</span>
+    <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
+  </div>
+
+  <div class="option-rows" data-option-rows>
+    <% @option_rows.each_with_index do |row, index| %>
+      <div class="option-row" data-option-row>
+        <div class="option-row__text">
+          <%= label_tag "question_options_attributes_#{index}_body", "Option #{index + 1}", class: "field-label", data: { option_label: true } %>
+          <%= text_field_tag "question[options_attributes][#{index}][body]",
+                             row[:body],
+                             id: "question_options_attributes_#{index}_body",
+                             class: "input",
+                             placeholder: "Option text",
+                             data: { option_body: true } %>
+        </div>
+
+        <label class="checkbox" for="<%= "question_options_attributes_#{index}_correct" %>" data-option-correct-container>
+          <%= hidden_field_tag "question[options_attributes][#{index}][correct]", "0", id: nil, data: { option_correct_hidden: true } %>
+          <%= check_box_tag "question[options_attributes][#{index}][correct]",
+                            "1",
+                            row[:correct],
+                            id: "question_options_attributes_#{index}_correct",
+                            data: { option_correct: true } %>
+          <span data-option-correct-label>Option <%= index + 1 %> is correct</span>
+        </label>
+
+        <button type="button" class="btn btn--danger btn--sm" data-remove-option>Remove</button>
+      </div>
+    <% end %>
+  </div>
+
+  <div class="buttons" style="margin-bottom: 28px">
+    <button type="button" class="btn btn--ghost btn--sm" data-add-option>Add option</button>
+  </div>
+
+  <div class="field">
+    <label class="checkbox" for="question_active">
+      <%= form.check_box :active, id: "question_active" %>
+      <span>Active</span>
+    </label>
+    <span class="field-hint">Only active questions are played.</span>
+  </div>
+
+  <div class="buttons">
+    <%= form.submit "Save question", class: "btn btn--pink" %>
+    <%= link_to "Cancel", moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+  </div>
+
+  <template data-option-template>
+    <div class="option-row" data-option-row>
+      <div class="option-row__text">
+        <label class="field-label" data-option-label></label>
+        <input type="text" class="input" placeholder="Option text" data-option-body>
+      </div>
+      <label class="checkbox" data-option-correct-container>
+        <input type="hidden" value="0" data-option-correct-hidden>
+        <input type="checkbox" value="1" data-option-correct>
+        <span data-option-correct-label></span>
+      </label>
+      <button type="button" class="btn btn--danger btn--sm" data-remove-option>Remove</button>
+    </div>
+  </template>
+<% end %>
