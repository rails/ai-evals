diff --git a/app/models/game.rb b/app/models/game.rb
index 06fa611..0457e4d 100644
--- a/app/models/game.rb
+++ b/app/models/game.rb
@@ -68,6 +68,42 @@ class Game < ApplicationRecord
     true
   end
 
+  # The countdown is anchored to the server-side moment the question opened,
+  # so reloading or reconnecting never resets it. A nil deadline means this
+  # quiz has no timer (or no question is currently open).
+  def timer_deadline
+    return nil unless question? && question_opened_at && quiz.timer_enabled?
+
+    question_opened_at + quiz.timer_duration_seconds
+  end
+
+  def timer_remaining_seconds(now = Time.current)
+    deadline = timer_deadline
+    return nil unless deadline
+
+    [(deadline - now).ceil, 0].max
+  end
+
+  def timer_expired?
+    deadline = timer_deadline
+    deadline.present? && Time.current >= deadline
+  end
+
+  # Called from live-state requests. The row lock makes simultaneous polls or
+  # a manual Finish at the deadline settle on exactly one transition.
+  def finish_if_timer_expired!
+    return false unless timer_expired?
+
+    finished = false
+    with_lock do
+      if timer_expired?
+        finish!
+        finished = true
+      end
+    end
+    finished
+  end
+
   def advance!
     return false unless results?
 
