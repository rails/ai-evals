+++ b/public/assets/application-d03b4cae.js
@@ -0,0 +1,271 @@
+import "@hotwired/turbo-rails"
+import { createConsumer } from "@rails/actioncable"
+import "controllers"
+
+function renumberOptionRows(container) {
+  const rows = Array.from(container.querySelectorAll("[data-option-row]"));
+
+  rows.forEach((row, index) => {
+    const number = index + 1;
+    const bodyLabel = row.querySelector("[data-option-label]");
+    const bodyInput = row.querySelector("[data-option-body]");
+    const correctHidden = row.querySelector("[data-option-correct-hidden]");
+    const correctCheckbox = row.querySelector("[data-option-correct]");
+    const correctLabel = row.querySelector("[data-option-correct-label]");
+    const correctContainer = row.querySelector("[data-option-correct-container]");
+
+    const bodyId = `question_options_attributes_${index}_body`;
+    const correctId = `question_options_attributes_${index}_correct`;
+
+    if (bodyLabel) {
+      bodyLabel.htmlFor = bodyId;
+      bodyLabel.textContent = `Option ${number}`;
+    }
+
+    if (bodyInput) {
+      bodyInput.id = bodyId;
+      bodyInput.name = `question[options_attributes][${index}][body]`;
+    }
+
+    if (correctHidden) {
+      correctHidden.name = `question[options_attributes][${index}][correct]`;
+    }
+
+    if (correctCheckbox) {
+      correctCheckbox.id = correctId;
+      correctCheckbox.name = `question[options_attributes][${index}][correct]`;
+    }
+
+    if (correctLabel) {
+      correctLabel.textContent = `Option ${number} is correct`;
+    }
+
+    if (correctContainer) {
+      correctContainer.htmlFor = correctId;
+    }
+  });
+}
+
+document.addEventListener("click", (event) => {
+  const addButton = event.target.closest("[data-add-option]");
+  if (addButton) {
+    const form = addButton.closest("form");
+    const container = form?.querySelector("[data-option-rows]");
+    const template = form?.querySelector("[data-option-template]");
+
+    if (container && template) {
+      const row = template.content.firstElementChild.cloneNode(true);
+      container.appendChild(row);
+      renumberOptionRows(container);
+      row.querySelector("[data-option-body]")?.focus();
+    }
+    return;
+  }
+
+  const removeButton = event.target.closest("[data-remove-option]");
+  if (removeButton) {
+    const row = removeButton.closest("[data-option-row]");
+    const container = row?.closest("[data-option-rows]");
+
+    if (row && container && container.querySelectorAll("[data-option-row]").length > 1) {
+      row.remove();
+      renumberOptionRows(container);
+    }
+  }
+});
+
+// Live game screens poll a small JSON endpoint and replace only the live
+// region when the game state changes. Player answers are posted with fetch so
+// phones never need a page reload while a question is open.
+function quizzyCsrfToken() {
+  const meta = document.querySelector('meta[name="csrf-token"]');
+  return meta ? meta.content : "";
+}
+
+function applyLiveState(container, data) {
+  if (!container || !data) return;
+
+  if (data.signature && container.dataset.signature !== data.signature) {
+    container.innerHTML = data.content || "";
+    container.dataset.signature = data.signature;
+  }
+
+  if (typeof data.players_count !== "undefined") {
+    container.querySelectorAll("[data-live-players]").forEach((element) => {
+      element.textContent = data.players_count;
+    });
+  }
+
+  if (typeof data.answers_count !== "undefined") {
+    container.querySelectorAll("[data-live-answers]").forEach((element) => {
+      element.textContent = data.answers_count;
+    });
+  }
+}
+
+async function refreshLiveState(container) {
+  if (!container || !document.body.contains(container)) return;
+
+  try {
+    const response = await fetch(container.dataset.liveStateUrl, {
+      headers: {
+        "Accept": "application/json",
+        "X-CSRF-Token": quizzyCsrfToken()
+      },
+      credentials: "same-origin",
+      cache: "no-store"
+    });
+
+    if (response.ok) {
+      applyLiveState(container, await response.json());
+    }
+  } catch (_error) {
+    // A later poll will retry; a transient conference Wi-Fi drop should not
+    // interrupt the game screen.
+  }
+}
+
+function formatQuizzyCountdown(seconds) {
+  const remaining = Math.max(0, Number(seconds) || 0);
+  const minutes = Math.floor(remaining / 60);
+  const secs = remaining % 60;
+  return `${minutes}:${String(secs).padStart(2, "0")}`;
+}
+
+async function finishQuestionForTimer(timer) {
+  const container = document.querySelector("[data-live-state-url]");
+  const finishUrl = timer?.dataset.timerFinishUrl;
+  if (!container || !finishUrl) return;
+
+  try {
+    const response = await fetch(finishUrl, {
+      method: "POST",
+      headers: {
+        "Accept": "application/json",
+        "X-CSRF-Token": quizzyCsrfToken()
+      },
+      body: new FormData(),
+      credentials: "same-origin"
+    });
+
+    const contentType = response.headers.get("content-type") || "";
+    if (response.ok && contentType.includes("application/json")) {
+      applyLiveState(container, await response.json());
+    } else {
+      window.location.reload();
+    }
+  } catch (_error) {
+    // The regular live-state polling also asks the server to close expired
+    // questions, so a failed fetch still resolves on the next poll.
+  }
+}
+
+function updateQuizTimers() {
+  document.querySelectorAll("[data-quiz-timer]").forEach((timer) => {
+    const deadline = Date.parse(timer.dataset.timerDeadline);
+    if (Number.isNaN(deadline)) return;
+
+    const remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
+    timer.textContent = formatQuizzyCountdown(remaining);
+
+    if (remaining === 0 && timer.dataset.finishRequested !== "true") {
+      timer.dataset.finishRequested = "true";
+      finishQuestionForTimer(timer);
+    }
+  });
+}
+
+let quizzyTimerTicker = null;
+
+function startQuizTimerTicker() {
+  if (quizzyTimerTicker) return;
+
+  updateQuizTimers();
+  quizzyTimerTicker = window.setInterval(updateQuizTimers, 250);
+}
+
+function startLivePolling(container) {
+  if (!container || container.dataset.livePolling === "true") return;
+  container.dataset.livePolling = "true";
+
+  const poll = async () => {
+    await refreshLiveState(container);
+
+    if (document.body.contains(container)) {
+      window.setTimeout(poll, 300);
+    }
+  };
+
+  window.setTimeout(poll, 150);
+}
+
+let quizzyCableConsumer = null;
+
+function subscribeToGameUpdates(container) {
+  if (!container || !container.dataset.liveGameId) return;
+  if (container.dataset.liveSubscribed === "true") return;
+  container.dataset.liveSubscribed = "true";
+
+  quizzyCableConsumer ||= createConsumer();
+  container.quizzyCableSubscription = quizzyCableConsumer.subscriptions.create(
+    { channel: "GameChannel", game_id: container.dataset.liveGameId },
+    {
+      received(data) {
+        if (data && data.refresh) refreshLiveState(container);
+      }
+    }
+  );
+}
+
+function initializeLiveRegions() {
+  startQuizTimerTicker();
+
+  document.querySelectorAll("[data-live-state-url]").forEach((container) => {
+    startLivePolling(container);
+    subscribeToGameUpdates(container);
+  });
+}
+
+document.addEventListener("DOMContentLoaded", initializeLiveRegions);
+document.addEventListener("turbo:load", initializeLiveRegions);
+
+document.addEventListener("submit", (event) => {
+  const commandForm = event.target.closest("[data-live-command]");
+  const answerForm = event.target.closest("[data-live-answer-form]");
+  const form = commandForm || answerForm;
+  if (!form) return;
+
+  event.preventDefault();
+  event.stopImmediatePropagation();
+
+  const container = document.querySelector("[data-live-state-url]");
+  const submit = form.querySelector('button[type="submit"], input[type="submit"]');
+  if (submit) submit.disabled = true;
+
+  fetch(form.action, {
+    method: "POST",
+    headers: {
+      "Accept": "application/json",
+      "X-CSRF-Token": quizzyCsrfToken()
+    },
+    body: new FormData(form),
+    credentials: "same-origin"
+  })
+    .then(async (response) => {
+      const contentType = response.headers.get("content-type") || "";
+      if (response.ok && contentType.includes("application/json")) {
+        applyLiveState(container, await response.json());
+      } else {
+        window.location.reload();
+      }
+    })
+    .catch(() => {
+      // Fall back to a normal form submission if the fetch itself fails.
+      form.removeAttribute("data-live-command");
+      form.removeAttribute("data-live-answer-form");
+      form.submit();
+    })
+    .finally(() => {
+      if (submit && document.body.contains(submit)) submit.disabled = false;
+    });
+});
