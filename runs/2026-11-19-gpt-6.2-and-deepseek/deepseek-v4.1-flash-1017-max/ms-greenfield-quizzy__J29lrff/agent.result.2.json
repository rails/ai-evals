ust have at least two options.\"\n      end\n\n      unless options.any? { |option| option[:correct] }\n        errors << \"Question #{question_number} must have at least one correct option.\"\n      end\n\n      { text: text, active: active, options: options }\n    end\n\n    raise Error.new(errors) if errors.any?\n\n    { title: title, questions: questions }\n  end\n\n  def build_quiz(normalized)\n    quiz = Quiz.new(title: normalized[:title])\n\n    normalized[:questions].each_with_index do |question_attributes, question_index|\n      question = quiz.questions.build(\n        body: question_attributes[:text],\n        active: question_attributes[:active],\n        position: question_index\n      )\n\n      question_attributes[:options].each_with_index do |option_attributes, option_index|\n        question.options.build(\n          body: option_attributes[:text],\n          correct: option_attributes[:correct],\n          position: option_index\n        )\n      end\n    end\n\n    quiz\n  end\nend\nRUBY\nruby - <<'RUBY'\nfrom = 'app/views/moderate/quizzes/index.html.erb'\ns = File.read(from)\nold = <<~ERB\n  <div class=\"page-head\">\n  <div>\n    <h1>Quizzes</h1>\n    <div class=\"meta\">Prepare quizzes for your next talk.</div>\n  </div>\n  <%= link_to \"New quiz\", new_moderate_quiz_path, class: \"btn btn--pink\" %>\n</div>\nERB\nnew = <<~ERB\n  <div class=\"page-head\">\n  <div>\n    <h1>Quizzes</h1>\n    <div class=\"meta\">Prepare quizzes for your next talk.</div>\n  </div>\n  <div class=\"buttons\">\n    <%= link_to \"Import quiz\", new_quiz_import_path, class: \"btn btn--ghost\" %>\n    <%= link_to \"New quiz\", new_moderate_quiz_path, class: \"btn btn--pink\" %>\n  </div>\n</div>\nERB\nabort 'index header block not found' unless s.include?(old)\nFile.write(from, s.sub(old, new))\n\nfrom = 'app/views/moderate/quizzes/show.html.erb'\ns = File.read(from)\nold = <<~ERB\n    <%= link_to \"Settings\", edit_moderate_quiz_path(@quiz), class: \"btn btn--ghost\" %