diff --git a/test/models/user_erasure_test.rb b/test/models/user_erasure_test.rb
new file mode 100644
index 0000000..6ee9b6c
--- /dev/null
+++ b/test/models/user_erasure_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class UserErasureTest < ActiveSupport::TestCase
+  setup do
+    @user = User.create!(
+      name: "Alice Erasure",
+      email_address: "alice.erasure@example.com",
+      password: "secret123456"
+    )
+
+    @private_book = Book.create!(title: "Alice's private book", everyone_access: false, creator: @user, author: @user.name)
+    @private_leaf = @private_book.press Section.new(body: "private needle"), title: "Private needle"
+    @private_page = @private_book.press Page.new(body: "private page needle"), title: "Private page"
+    @private_markdown_id = @private_page.page.markdown_body.id
+
+    @private_picture = @private_book.press Picture.new(caption: "private picture"), title: "Private picture"
+    @private_book.cover.attach(io: file_fixture("reading.webp").open, filename: "cover.webp", content_type: "image/webp")
+    @private_picture.picture.image.attach(io: file_fixture("reading.webp").open, filename: "picture.webp", content_type: "image/webp")
+    @private_page.page.markdown_body.uploads.attach(io: file_fixture("reading.webp").open, filename: "upload.webp", content_type: "image/webp")
+
+    @shared_book = Book.create!(title: "Alice's shared book", everyone_access: true, creator: @user, author: @user.name)
+    @shared_leaf = @shared_book.press Section.new(body: "shared needle"), title: "Shared needle"
+    @shared_book.cover.attach(io: file_fixture("reading.webp").open, filename: "shared-cover.webp", content_type: "image/webp")
+
+    @user.sessions.start!(user_agent: "test", ip_address: "127.0.0.1")
+    SignInEvent.create!(action: :signed_in, email_address: @user.email_address)
+    ReadingMark.remember(@private_leaf, user: @user)
+  end
+
+  test "destroying a user erases their data and keeps their shared books" do
+    private_leaf_id = @private_leaf.id
+    private_picture_id = @private_picture.id
+    private_book_cover_blob_id = @private_book.cover.blob.id
+    private_picture_blob_id = @private_picture.picture.image.blob.id
+    private_upload_blob_id = @private_page.page.markdown_body.uploads.blobs.first.id
+    private_page_id = @private_page.id
+    private_markdown_id = @private_markdown_id
+    shared_leaf_id = @shared_leaf.id
+    shared_book_cover_blob_id = @shared_book.cover.blob.id
+    user_id = @user.id
+    email_address = @user.email_address
+
+    assert_difference -> { User.count }, -1 do
+      @user.destroy!
+    end
+
+    assert_nil User.find_by(id: user_id)
+    assert_equal 0, Access.where(user_id: user_id).count
+    assert_equal 0, Session.where(user_id: user_id).count
+    assert_equal 0, ReadingMark.where(user_id: user_id).count
+    assert_equal 0, SignInEvent.where(email_address: email_address).count
+
+    assert_nil Book.find_by(id: @private_book.id)
+    assert_nil Leaf.find_by(id: private_leaf_id)
+    assert_nil Leaf.find_by(id: private_page_id)
+    assert_nil ActionText::Markdown.find_by(id: private_markdown_id)
+    assert_equal 0, search_index_count(private_leaf_id)
+    assert_equal 0, search_index_count(private_page_id)
+    assert_nil Leaf.find_by(id: private_picture_id)
+    assert_nil ActiveStorage::Blob.find_by(id: private_book_cover_blob_id)
+    assert_nil ActiveStorage::Blob.find_by(id: private_picture_blob_id)
+    assert_nil ActiveStorage::Blob.find_by(id: private_upload_blob_id)
+
+    assert_equal "Deleted author", @shared_book.reload.author
+    assert_nil @shared_book.creator_id
+    assert @shared_book.cover.attached?
+    assert ActiveStorage::Blob.exists?(id: shared_book_cover_blob_id)
+    assert_equal 1, search_index_count(shared_leaf_id)
+    assert_includes Leaf.search("shared needle"), @shared_leaf
+  end
+
+  test "destroying a deactivated legacy user erases sign-in events under their original address" do
+    original_email_address = @user.email_address
+    @user.update_columns(active: false, email_address: original_email_address.sub("@", "-deactivated-#{SecureRandom.uuid}@"))
+    SignInEvent.create!(action: :signed_in, email_address: original_email_address)
+    @user.destroy!
+
+    assert_equal 0, SignInEvent.where(email_address: original_email_address).count
+  end
+
+  private
+    def search_index_count(leaf_id)
+      User.connection.select_value("select count(*) from leaf_search_index where rowid = #{leaf_id}").to_i
+    end
+end
