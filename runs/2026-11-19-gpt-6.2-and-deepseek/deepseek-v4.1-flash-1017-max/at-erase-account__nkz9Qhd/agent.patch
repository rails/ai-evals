+    def erase_or_detach_created_books
+      created_books.find_each do |book|
+        if book.everyone_access?
+          book.update!(creator: nil, author: DELETED_AUTHOR)
+        else
+          purge_attachments_for(book)
+          book.destroy!
+        end
+      end
+    end
+
+    def purge_attachments_for(book)
+      records = attachment_records_for(book)
+      attachment_ids = records.flat_map { |record| ActiveStorage::Attachment.where(record: record).ids }.uniq
+      return if attachment_ids.empty?
+
+      attachments = ActiveStorage::Attachment.where(id: attachment_ids).includes(:blob).to_a
+      blobs = attachments.map(&:blob).uniq
+
+      attachments.each(&:delete)
+
+      blobs.each do |blob|
+        blob.purge if blob.attachments.reload.none?
+      end
+    end
+
+    def attachment_records_for(book)
+      records = [ book ]
+
+      book.leaves.includes(:leafable, edits: :leafable).find_each do |leaf|
+        records << leaf.leafable
+        leaf.edits.each { |edit| records << edit.leafable }
+      end
+
+      records.compact.flat_map do |record|
+        [ record, (record.markdown_body if record.respond_to?(:markdown_body)) ]
+      end.compact.uniq
+    end
+
+    def erase_sign_in_events
+      SignInEvent.where(email_address: sign_in_event_email_addresses).delete_all
+    end
+
+    def sign_in_event_email_addresses
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    # Deactivated users had their address rewritten as
+    # local-deactivated-uuid@domain. Sign-in events still use the original
+    # address, so recover it before deleting the audit trail.
+    def original_email_address
+      email_address&.sub(/-deactivated-[^@]+(?=@)/, "")
     end
 
