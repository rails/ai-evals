diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..e3fd3c5 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,77 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  ACCOUNT_SCOPED_MODELS = [
+    Access,
+    Account::Cancellation,
+    Account::Import,
+    Account::JoinCode,
+    ActionText::RichText,
+    Assignment,
+    Board,
+    Board::Publication,
+    Card,
+    Card::ActivitySpike,
+    Card::Goldness,
+    Card::NotNow,
+    Closure,
+    Column,
+    Comment,
+    Entropy,
+    Event,
+    Export,
+    Filter,
+    Mention,
+    Notification,
+    Notification::Bundle,
+    Pin,
+    Push::Subscription,
+    Reaction,
+    Search::Query,
+    Step,
+    Storage::Entry,
+    Tag,
+    Tagging,
+    User,
+    User::Settings,
+    Watch,
+    Webhook,
+    Webhook::DelinquencyTracker,
+    Webhook::Delivery
+  ].freeze
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+    scope :incineratable, -> { due_for_incineration }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    board_ids = boards.ids
+
+    delete_attachments
+    destroy!
+    delete_remaining_data(board_ids)
+  end
+
+  private
+    def delete_attachments
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+      ActiveStorage::VariantRecord.where(account_id: id).delete_all
+      ActiveStorage::Blob.where(account_id: id).delete_all
+    end
+
+    def delete_remaining_data(board_ids)
+      Search::Record.for(id).where(account_id: id).destroy_all
+      ACCOUNT_SCOPED_MODELS.each { |model| model.where(account_id: id).delete_all }
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: board_ids).delete_all if board_ids.any?
+    end
 end
