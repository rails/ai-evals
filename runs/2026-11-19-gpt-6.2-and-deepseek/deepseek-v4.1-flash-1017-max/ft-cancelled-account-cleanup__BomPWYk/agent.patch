diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..cbd0b1d
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+  end
+
+  test "incinerates accounts canceled more than 30 days ago and removes their data" do
+    cancel_account_at 31.days.ago
+    storage_entry = Storage::Entry.record(account: @account, delta: 1024, operation: "attach")
+    search_query = Search::Query.create!(account: @account, user: @user, terms: "incinerate")
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not Account::Cancellation.where(account_id: @account.id).exists?
+    assert_not User.where(account_id: @account.id).exists?
+    assert_not Board.where(account_id: @account.id).exists?
+    assert_not Card.where(account_id: @account.id).exists?
+    assert_not Comment.where(account_id: @account.id).exists?
+    assert_not Event.where(account_id: @account.id).exists?
+    assert_not Notification.where(account_id: @account.id).exists?
+    assert_not Storage::Entry.exists?(storage_entry.id)
+    assert_not Search::Query.exists?(search_query.id)
+  end
+
+  test "incinerates attached files, search records, and storage entries" do
+    cancel_account_at 31.days.ago
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    card.image.attach(blob)
+    card.reindex
+    storage_entry = Storage::Entry.record(account: @account, board: card.board, recordable: card, delta: blob.byte_size, operation: "attach")
+
+    assert_nothing_raised do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not ActiveStorage::Attachment.where(account_id: @account.id).exists?
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not Storage::Entry.exists?(storage_entry.id)
+    assert_not Search::Record.for(@account.id).where(account_id: @account.id).exists?
+  end
+
+  test "does not incinerate accounts canceled less than 30 days ago" do
+    cancel_account_at 29.days.ago
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate accounts at exactly the grace period boundary" do
+    travel_to Time.zone.now do
+      cancel_account_at 30.days.ago
+
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  private
+    def cancel_account_at(time)
+      cancellation = Account::Cancellation.create!(account: @account, initiated_by: @user)
+      cancellation.update_column(:created_at, time)
+    end
+end
