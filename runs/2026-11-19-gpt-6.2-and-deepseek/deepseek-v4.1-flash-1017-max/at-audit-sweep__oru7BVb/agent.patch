diff --git a/test/controllers/security_regression_test.rb b/test/controllers/security_regression_test.rb
new file mode 100644
index 0000000..6a83c31
--- /dev/null
+++ b/test/controllers/security_regression_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class SecurityRegressionTest < ActionDispatch::IntegrationTest
+  test "members cannot assign themselves a role through their profile" do
+    sign_in :kevin
+
+    patch user_profile_path(users(:kevin)), params: { user: { name: "Kevin", role: "administrator" } }
+
+    assert_not users(:kevin).reload.administrator?
+  end
+
+  test "readers cannot destroy books they can only read" do
+    sign_in :jz
+
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:handbook))
+    end
+
+    assert_response :forbidden
+  end
+
+  test "global search treats injected SQL as data and stays within readable books" do
+    sign_in :kevin
+    books(:manual).press Page.new(body: "Private manual content"), title: "Private Manual Page"
+
+    get library_search_path, params: { q: "' OR 1=1 --" }
+
+    assert_response :success
+    assert_not_in_body "Private Manual Page"
+  end
+
+  test "global search handles apostrophes" do
+    sign_in :kevin
+    books(:handbook).press Page.new(body: "Owned by Kevin"), title: "Kevin's Page"
+
+    get library_search_path, params: { q: "Kevin's" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Kevin's Page/
+  end
+
+  test "editors can still destroy books they can edit" do
+    sign_in :kevin
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+
+    assert_redirected_to root_url
+  end
+
+  test "global search treats percent and underscore as literal characters" do
+    sign_in :kevin
+    books(:handbook).press Page.new(body: "A discount"), title: "Save 50% off"
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_select "a.search__result", text: /Save 50% off/
+
+    get library_search_path, params: { q: "50% off" }
+    assert_response :success
+    assert_select "a.search__result", text: /Save 50% off/
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_select "a.search__result", text: /Save 50% off/
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_select "p.search__no_matches"
+  end
+
+  test "global search finds titles containing an underscore when searching for one" do
+    sign_in :kevin
+    books(:handbook).press Page.new(body: "An underscore"), title: "Under_score"
+
+    get library_search_path, params: { q: "_" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_select "a.search__result", text: /Under_score/
+  end
+
+  test "leafable show only resolves leaves belonging to the book in the URL" do
+    sign_in :kevin
+    secret_leaf = books(:manual).press Page.new(body: "Manual secret body"), title: "Manual Secret"
+
+    get "/#{books(:handbook).id}/#{books(:handbook).slug}/#{secret_leaf.id}/#{secret_leaf.slug}"
+
+    assert_response :not_found
+  end
+
+  test "published pages remain readable while signed out" do
+    books(:handbook).update!(published: true)
+    sign_out
+
+    get leafable_slug_path(leaves(:welcome_page))
+
+    assert_response :success
+    assert_select "p", text: "This is such a great handbook."
+  end
+end
