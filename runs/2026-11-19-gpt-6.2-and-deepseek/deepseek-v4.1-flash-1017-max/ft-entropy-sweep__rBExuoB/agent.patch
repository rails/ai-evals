diff --git a/test/jobs/card/auto_postpone_due_job_test.rb b/test/jobs/card/auto_postpone_due_job_test.rb
new file mode 100644
index 0000000..bb62355
--- /dev/null
+++ b/test/jobs/card/auto_postpone_due_job_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Card::AutoPostponeDueJobTest < ActiveJob::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "auto postpone all due later enqueues the dispatcher" do
+    assert_enqueued_with(job: Card::AutoPostponeDueJob) do
+      Card.auto_postpone_all_due_later
+    end
+  end
+
+  test "auto postpone all due enqueues a job for each due card" do
+    card = cards(:logo)
+    card.update!(last_active_at: 1.year.ago)
+
+    assert_enqueued_with(job: Card::AutoPostponeJob, args: [ card ]) do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "dispatcher enqueues a job for each due card" do
+    card = cards(:logo)
+    card.update!(last_active_at: 1.year.ago)
+
+    assert_enqueued_with(job: Card::AutoPostponeJob, args: [ card ]) do
+      Card::AutoPostponeDueJob.perform_now
+    end
+  end
+
+  test "postpones due cards when the enqueued jobs run" do
+    due_card = cards(:logo)
+    not_due_card = cards(:shipping)
+    due_card.update!(last_active_at: 1.year.ago)
+    not_due_card.update!(last_active_at: Time.current)
+
+    perform_enqueued_jobs do
+      Card.auto_postpone_all_due_later
+    end
+
+    assert due_card.reload.postponed?
+    assert_equal accounts("37s").system_user, due_card.postponed_by
+    assert_not not_due_card.reload.postponed?
+  end
+
+  test "per-card job does nothing if the card is no longer due" do
+    card = cards(:logo)
+    card.update!(last_active_at: 1.year.ago)
+    Card::AutoPostponeJob.perform_now(card)
+
+    assert_no_difference -> { card.events.count } do
+      Card::AutoPostponeJob.perform_now(card)
+    end
+  end
+end
