diff --git a/app/jobs/card/auto_postpone_job.rb b/app/jobs/card/auto_postpone_job.rb
new file mode 100644
index 0000000..19ead6a
--- /dev/null
+++ b/app/jobs/card/auto_postpone_job.rb
@@ -0,0 +1,15 @@
+class Card::AutoPostponeJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(card)
+    Current.with_account(card.account) do
+      if card.due_to_be_postponed?
+        card.auto_postpone(user: card.account.system_user)
+      end
+    end
+  rescue ActiveRecord::RecordNotUnique
+    # Another sweep already auto-postponed this card.
+  end
+end
diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..89b7cea 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -24,7 +24,19 @@ module Card::Entropic
   end
 
   class_methods do
+    # Enqueues the card work so the recurring sweep returns before processing the backlog.
     def auto_postpone_all_due
+      due_to_be_postponed.in_batches do |cards|
+        ActiveJob.perform_all_later(cards.map { |card| Card::AutoPostponeJob.new(card) })
+      end
+    end
+
+    # Enqueues the dispatcher so SolidQueue::RecurringJob doesn't perform the sweep inline.
+    def auto_postpone_all_due_later
+      Card::AutoPostponeDueJob.perform_later
+    end
+
+    def auto_postpone_all_due_now
       due_to_be_postponed.find_each do |card|
         card.auto_postpone(user: card.account.system_user)
       end
@@ -38,4 +50,8 @@ module Card::Entropic
   def entropic?
     entropy.present?
   end
+
+  def due_to_be_postponed?
+    active? && entropy.auto_clean_at <= Time.current
+  end
 end
