+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,13 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest formats the last edited date" do
+    book = books(:handbook)
+    book.update!(published: true)
+
+    mail = ReportDigestMailer.weekly(users(:david))
+
+    assert_equal [ "david@example.com" ], mail.to
+    assert_includes mail.body.to_s, "last edited #{book.updated_at.to_date.to_formatted_s(:short)}"
+  end
+end
