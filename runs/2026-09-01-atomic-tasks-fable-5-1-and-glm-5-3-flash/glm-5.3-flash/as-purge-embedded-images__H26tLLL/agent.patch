diff --git a/test/controllers/action_text/markdown/uploads_controller_test.rb b/test/controllers/action_text/markdown/uploads_controller_test.rb
index 48141c1..e4d67c6 100644
--- a/test/controllers/action_text/markdown/uploads_controller_test.rb
+++ b/test/controllers/action_text/markdown/uploads_controller_test.rb
@@ -31,4 +31,43 @@ class ActionText::Markdown::UploadsControllerTest < ActionDispatch::IntegrationT
     assert_response :redirect
     assert_match /\/rails\/active_storage\/.*\/reading\.webp/, @response.redirect_url
   end
+
+  test "view attached file after fetching its url" do
+    markdown = pages(:welcome).body.tap(&:save!)
+    markdown.content = "![Reading](/u/reading-abc123.webp)"
+    markdown.save!
+    markdown.uploads.attach fixture_file_upload("reading.webp", "image/webp")
+
+    upload = markdown.uploads.attachments.last
+    markdown.reload
+
+    get "/u/#{upload.slug}"
+
+    assert_response :redirect
+
+    follow_redirect!
+    assert_response :success
+  end
+
+  test "purge an uploaded file when the page it was dropped into is destroyed" do
+    markdown = pages(:welcome).body.tap(&:save!)
+    markdown.content = "![Reading](/u/reading-abc123.webp)"
+    markdown.save!
+    markdown.uploads.attach fixture_file_upload("reading.webp", "image/webp")
+
+    upload = markdown.uploads.attachments.last
+
+    get "/u/#{upload.slug}"
+    assert_response :redirect
+
+    perform_enqueued_jobs { pages(:welcome).destroy }
+
+    assert_not ActionText::Markdown.exists?(markdown.id)
+    assert_not ActiveStorage::Attachment.exists?(upload.id)
+    assert_not ActiveStorage::Blob.exists?(upload.blob.id)
+    assert_not upload.blob.service.exist?(upload.blob.key)
+
+    get "/u/#{upload.slug}"
+    assert_response :not_found
+  end
 end
diff --git a/test/models/page_uploads_test.rb b/test/models/page_uploads_test.rb
new file mode 100644
index 0000000..7d34cba
--- /dev/null
+++ b/test/models/page_uploads_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class PageUploadsTest < ActiveSupport::TestCase
+  setup do
+    @leaf = books(:handbook).press Page.new(body: ""), title: "A Page With An Image"
+    @page = @leaf.page
+
+    markdown = @page.body
+    markdown.content = "![An image](/u/an-image-abc123.webp)"
+    markdown.save!
+    markdown.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    markdown.save!
+
+    @attachment = markdown.uploads.attachments.last
+    @blob = @attachment.blob
+  end
+
+  test "destroying a page purges its embedded images" do
+    assert ActionText::Markdown.exists?(record_type: "Page", record_id: @page.id)
+    assert @blob.service.exist?(@blob.key), "the uploaded image is stored before destruction"
+
+    perform_enqueued_jobs { @page.destroy }
+
+    assert_not ActionText::Markdown.exists?(record_type: "Page", record_id: @page.id)
+    assert_not ActiveStorage::Attachment.exists?(@attachment.id), "the attachment tracking the image is gone"
+    assert_not ActiveStorage::Blob.exists?(@blob.id), "the blob tracking the image is gone"
+    assert_not @blob.service.exist?(@blob.key), "the image file is gone from storage"
+  end
+
+  test "destroying a leaf purges its page's embedded images" do
+    perform_enqueued_jobs { @leaf.destroy }
+
+    assert_not ActiveStorage::Attachment.exists?(@attachment.id)
+    assert_not ActiveStorage::Blob.exists?(@blob.id)
+    assert_not @blob.service.exist?(@blob.key)
+  end
+end
