@@ -0,0 +1,58 @@
+require "test_helper"
+
+class ActionText::MarkdownTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    ActiveJob::Base.queue_adapter.enqueued_jobs.clear
+  end
+
+  test "destroying a page purges its embedded images once background work has run" do
+    page = leaves(:welcome_page).leafable
+
+    upload_image_into page.body
+
+    attachment = page.body.uploads.attachments.last
+    path = ActiveStorage::Blob.service.path_for(attachment.blob.key)
+
+    assert File.exist?(path), "Expected the uploaded image to exist on disk"
+
+    page.destroy!
+    perform_enqueued_jobs
+
+    assert_not File.exist?(path), "Expected the image file to be deleted from disk"
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(attachment.blob_id)
+    assert_not ActionText::Markdown.exists?(record_type: "Page", record_id: page.id)
+  end
+
+  test "destroying a book purges all of its pages' embedded images" do
+    pages = books(:handbook).leaves.pages.map(&:leafable)
+
+    paths = pages.map do |page|
+      upload_image_into page.body
+
+      ActiveStorage::Blob.service.path_for(page.body.uploads.attachments.last.blob.key)
+    end
+
+    assert paths.all? { |path| File.exist?(path) }, "Expected each uploaded image to exist on disk"
+
+    books(:handbook).destroy!
+    perform_enqueued_jobs
+
+    paths.each do |path|
+      assert_not File.exist?(path), "Expected #{path} to be deleted from disk"
+    end
+
+    assert_equal [], ActiveStorage::Attachment.where(record_type: "ActionText::Markdown").pluck(:id)
+    assert_not ActionText::Markdown.exists?(record_type: "Page")
+  end
+
+  private
+    def upload_image_into(markdown)
+      markdown.uploads.attach io: file_fixture("reading.webp").open,
+        filename: "reading.webp", content_type: "image/webp"
+      markdown.save!
+      markdown.reload
+    end
+end
