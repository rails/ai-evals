+
+class ActionText::Markdown::UploadsControllerTest::Purging < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+    @page = leaves(:welcome_page).leafable
+  end
+
+  test "upload, serve, then destroy the page leaves no trace of the uploaded file" do
+    assert_changes -> { ActiveStorage::Attachment.count }, 1 do
+      post action_text_markdown_uploads_url, params: {
+        record_gid: @page.to_signed_global_id.to_s,
+        attribute_name: "body",
+        file: fixture_file_upload("reading.webp", "image/webp")
+      }, as: :xhr
+    end
+
+    attachment = @page.body.uploads.attachments.last
+    key = attachment.blob.key
+    path = Rails.root.join("tmp/storage", key[0..1], key[2..3], key)
+    assert File.exist?(path)
+
+    get action_text_markdown_upload_url(slug: attachment.slug)
+    assert_response :redirect
+
+    leaves(:welcome_page).destroy!
+    perform_enqueued_jobs
+
+    assert_not File.exist?(path)
+    assert_empty ActiveStorage::Blob.where(id: attachment.blob_id)
+    assert_empty ActiveStorage::Attachment.where(id: attachment.id)
+  end
+end
