index 0000000..b187d47
--- /dev/null
+++ b/test/controllers/books/imports_controller_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Books::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :david
+    @book = books(:handbook)
+  end
+
+  test "an imported batch is applied all or nothing" do
+    assert_enqueued_jobs 1, only: Books::ImportFailureJob do
+      post books_import_path, params: { books: {
+        @book.id => { title: "Handbook, second edition" },
+        "-1" => { title: "No such book" }
+      } }
+    end
+
+    assert_equal "Handbook", @book.reload.title
+    assert_enqueued_jobs 0, only: Book::SearchIndexJob
+    assert_enqueued_jobs 0, only: Book::CoverProcessingJob
+  end
+
+  test "the operator hears about an abandoned import" do
+    post books_import_path, params: { books: {
+      @book.id => { title: "Handbook, second edition" },
+      "-1" => { title: "No such book" }
+    } }
+
+    assert_enqueued_jobs 1, only: Books::ImportFailureJob
+    assert_equal [ users(:david).id ],
+      ActiveJob::Base.queue_adapter.enqueued_jobs
+        .select { _1[:job] == Books::ImportFailureJob }
+        .map { _1[:args].first }
+  end
+
+  test "a successful import applies the batch and hands off its work" do
+    perform_enqueued_jobs do
+      post books_import_path, params: { books: {
+        @book.id => { title: "Handbook, second edition" },
+        books(:manual).id => { subtitle: "Field guide" }
+      } }
+    end
+
+    assert_response :redirect
+    assert_equal "Handbook, second edition", @book.reload.title
+    assert_enqueued_jobs 0
+    assert_performed_jobs 2, only: Book::SearchIndexJob
+  end
+end
diff --git a/test/models/book/editing_test.rb b/test/models/book/editing_test.rb
new file mode 100644
index 0000000..1f3a0b1
--- /dev/null
+++ b/test/models/book/editing_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Book::EditingTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "an edit hands off its background work" do
+    books(:handbook).apply_edit(title: "Handbook, second edition")
+
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+    assert_enqueued_jobs 0, only: Book::CoverProcessingJob
+  end
+
+  test "a new cover hands off the cover processing as well" do
+    books(:handbook).apply_edit title: "Handbook, second edition", cover: uploaded_cover
+
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+    assert_enqueued_jobs 1, only: Book::CoverProcessingJob
+  end
+
+  test "background work is handed off only after the edit has committed" do
+    Book.transaction do
+      books(:handbook).apply_edit title: "Handbook, second edition", cover: uploaded_cover
+
+      assert_no_enqueued_jobs
+    end
+
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+    assert_enqueued_jobs 1, only: Book::CoverProcessingJob
+  end
+
+  test "an abandoned edit never hands off any work" do
+    Book.transaction do
+      books(:handbook).apply_edit title: "Handbook, second edition", cover: uploaded_cover
+      raise ActiveRecord::Rollback
+    end
+
+    assert_enqueued_jobs 0, only: Book::SearchIndexJob
+    assert_enqueued_jobs 0, only: Book::CoverProcessingJob
+    assert_equal "Handbook", books(:handbook).reload.title
+  end
+
+  test "a committed edit stamps the cover fingerprint and refreshes the search entry" do
+    perform_enqueued_jobs do
+      books(:handbook).apply_edit title: "Handbook, second edition", cover: uploaded_cover
+    end
+
+    blob = books(:handbook).cover.blob.reload
+    assert_equal Digest::SHA256.hexdigest(blob.download), blob.metadata["sha256"]
+  end
+
+  private
+    def uploaded_cover
+      ActiveStorage::Blob.create_and_upload!(
+        io: File.open(Rails.root.join("test/fixtures/files/reading.webp").to_s),
+        filename: "reading.webp",
+        content_type: "image/webp")
+    end
+end
