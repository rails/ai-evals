diff --git a/test/lib/tasks/positions_rake_test.rb b/test/lib/tasks/positions_rake_test.rb
new file mode 100644
index 0000000..e33e9eb
--- /dev/null
+++ b/test/lib/tasks/positions_rake_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+require "rake"
+
+class PositionsRakeTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+    # Newest created page sorts first, oldest last.
+    leaves(:welcome_section).update! position_score: 40
+    leaves(:welcome_page).update! position_score: 30
+    leaves(:summary_page).update! position_score: 20
+    leaves(:reading_picture).update! position_score: 10
+
+    Rake.application.rake_require "tasks/positions", [ "#{Rails.root}/lib" ]
+
+    # The task depends on the `environment` task, which the test runtime already provides.
+    Rake::Task.define_task :environment unless Rake::Task.task_defined?(:environment)
+
+    @task = Rake::Task["maintenance:compact_positions"]
+  end
+
+  teardown do
+    @task.reenable
+    Rake.application.tasks.each(&:reenable)
+  end
+
+  test "the maintenance run tidies scores into a dense sequence" do
+    @task.invoke
+
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.order(:position_score).pluck(:position_score)
+  end
+
+  test "the maintenance run keeps every book's arrangement" do
+    ordered_titles = [ "Reading", "Summary", "Welcome to The Handbook!", "The Welcome Section" ]
+
+    @task.invoke
+
+    assert_equal ordered_titles, @book.leaves.active.positioned.map(&:title)
+  end
+end
diff --git a/test/models/book/maintenance_test.rb b/test/models/book/maintenance_test.rb
new file mode 100644
index 0000000..9f18151
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "live_leaf_count counts pages that are not in the trash" do
+    assert_equal 4, @book.live_leaf_count
+
+    leaves(:welcome_page).trashed!
+
+    assert_equal 3, @book.live_leaf_count
+  end
+
+  test "live_leaf_count returns zero for a book without leaves" do
+    assert_equal 0, books(:manual).live_leaf_count
+  end
+
+  test "compacting scores a book's leaves as a dense sequence" do
+    @book.compact_positions!
+
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.order(:position_score).pluck(:position_score)
+  end
+
+  test "compacting preserves the arrangement instead of falling back to creation order" do
+    # Created in one sequence, arranged afterwards so the newest leaf sorts first.
+    welcome_section = leaves(:welcome_section)
+    welcome_section.update! position_score: 40
+    leaves(:welcome_page).update! position_score: 30
+    leaves(:summary_page).update! position_score: 20
+    leaves(:reading_picture).update! position_score: 10
+
+    @book.compact_positions!
+
+    assert_equal [ leaves(:reading_picture).id, leaves(:summary_page).id,
+                   leaves(:welcome_page).id, welcome_section.id ],
+      @book.leaves.order(:position_score, :id).pluck(:id)
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.order(:position_score).pluck(:position_score)
+  end
+
+  test "compacting leaves trashed pages in place so restoring them lands back where they were" do
+    # Arrange: picture first, section last; then move the summary page to the trash.
+    leaves(:welcome_section).update! position_score: 30
+    leaves(:welcome_page).update! position_score: 20
+    leaves(:summary_page).update! position_score: 10
+    leaves(:reading_picture).update! position_score: 0
+
+    summary_page = leaves(:summary_page)
+    summary_page.trashed!
+    before_compaction = @book.leaves.order(:position_score).map(&:title)
+
+    @book.compact_positions!
+
+    summary_page.active!
+
+    assert_equal [ leaves(:reading_picture), summary_page, leaves(:welcome_page), leaves(:welcome_section) ].map(&:title),
+      @book.leaves.order(:position_score, :id).map(&:title)
+
+    # A restored page must sit exactly where it did before the run.
+    assert_includes [ before_compaction ], @book.leaves.order(:position_score, :id).map(&:title)
+  end
+
+  test "compacting can be repeated" do
+    @book.compact_positions!
+    titles_and_scores = @book.leaves.order(:position_score, :id).pluck(:title, :position_score)
+
+    @book.compact_positions!
+
+    assert_equal titles_and_scores, @book.leaves.order(:position_score, :id).pluck(:title, :position_score)
+  end
+
+  test "compacting a book without leaves raises nothing" do
+    books(:manual).compact_positions!
+
+    assert_equal [], books(:manual).leaves
+  end
+end
