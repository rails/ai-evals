@@ -1,11 +1,29 @@
 class TitleCleanupJob < ApplicationJob
+  BATCH_SIZE = 1_000
+
+  # The legacy exporter wrapped every leaf title in a pair of stray quotes.
+  #
+  # Stripping them is not reversible: a title that legitimately starts and ends with
+  # a quoted phrase keeps those quotes once they have been unwrapped, so running the
+  # cleanup over such a title again would eat real quoting. The job therefore records
+  # its progress on each leaf as it goes (`title_cleaned_at`), which makes it
+  # resumable — an interrupted run picks up where the last one left off rather than
+  # starting over from the first leaf.
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    leaves_left_to_clean.find_each(batch_size: BATCH_SIZE) do |leaf|
+      leaf.with_lock do
+        next if leaf.title_cleaned_at?
+
+        leaf.update!(title: cleaned(leaf.title), title_cleaned_at: Time.current)
+      end
     end
   end
 
   private
+    def leaves_left_to_clean
+      Leaf.where(title_cleaned_at: nil)
+    end
+
     def cleaned(title)
       title.delete_prefix('"').delete_suffix('"')
     end
