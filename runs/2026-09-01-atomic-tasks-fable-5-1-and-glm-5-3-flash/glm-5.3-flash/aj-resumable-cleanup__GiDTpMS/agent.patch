+class AddTitleCleanedAtToLeaves < ActiveRecord::Migration[8.0]
+  def change
+    # Records which titles have already had their legacy wrapping quotes stripped so a
+    # restarted TitleCleanupJob never has to start over.
+    add_column :leaves, :title_cleaned_at, :datetime
+  end
+end
