@@ -1,8 +1,18 @@
 class Picture < ApplicationRecord
   include Leafable
 
+  # The large variant of an uploaded image is processed by a background job
+  # shortly after the upload. Readers, however, reach that derivative through its
+  # signed representation URL, and the transformations embedded in such URLs don't
+  # survive Active Storage's round trip unchanged: symbols come back as strings.
+  #
+  # Variations are identified by a digest of their transformations, so those two
+  # otherwise identical descriptions must hash to the same value, or every reader
+  # would run the conversion again and store a second copy next to the first one.
+  # Declaring the format as a string keeps both paths on the same side of that
+  # round trip and thus pointing at one derived file.
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
diff --git a/test/integration/picture_variant_test.rb b/test/integration/picture_variant_test.rb
new file mode 100644
index 0000000..b0619e4
--- /dev/null
+++ b/test/integration/picture_variant_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class PictureVariantTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+
+    put leafable_path(leaves(:reading_picture)), params: {
+      picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+    }
+    assert_response :no_content
+
+    @picture = leaves(:reading_picture).reload.picture
+    assert @picture.image.attached?
+  end
+
+  test "the derived copy created by the background job is what readers link to" do
+    variant = @picture.large_image
+
+    assert_equal variant.variation.digest, verified_variation_digest(variant.variation.key),
+      "The transformation named in the model and the one signed into its URL should be variations of the same thing"
+  end
+
+  test "an upload is derived once and readers never process it" do
+    run_background_work
+
+    assert_equal [ @picture.large_image.variation.digest ], derived_variants(@picture)
+
+    assert_no_active_storage_uploads do
+      get_linked_picture
+
+      # Another reader opens the same book page and follows its link.
+      get_linked_picture
+    end
+
+    assert_equal "image/webp", response.media_type
+    assert_equal content_of_transformed_image(@picture, @picture.large_image.variation), response.body
+    assert_equal [ @picture.large_image.variation.digest ], derived_variants(@picture)
+  end
+
+  test "a reader opening an upload before its background job ran keeps one derived copy" do
+    get_linked_picture
+
+    assert_response :ok
+    assert_equal "image/webp", response.media_type
+    assert_equal content_of_transformed_image(@picture, @picture.large_image.variation), response.body
+
+    run_background_work
+
+    assert_equal [ @picture.large_image.variation.digest ], derived_variants(@picture)
+  end
+
+  private
+    def get_linked_picture
+      get leafable_path(@picture.leaf)
+      assert_response :ok
+
+      sources = response.body.scan(/src="([^"]*)"/).flatten.select { |source| source.include?("/rails/active_storage/") }.uniq
+      assert_not_empty sources, "The book page does not link to the uploaded picture"
+
+      sources.each do |source|
+        get source
+        follow_redirect!
+        assert_response :ok
+      end
+    end
+
+    def assert_no_active_storage_uploads(&block)
+      uploads = []
+      subscriber = ActiveSupport::Notifications.subscribe("service.upload.active_storage") do |event|
+        uploads << event.payload[:key]
+      end
+
+      begin
+        block.call
+      ensure
+        ActiveSupport::Notifications.unsubscribe(subscriber)
+      end
+
+      assert_empty uploads,
+        "Expected already derived pictures to be served without image processing, " \
+          "but a copy was uploaded to #{uploads.to_sentence}"
+    end
+
+    def run_background_work
+      perform_enqueued_jobs while enqueued_jobs.present?
+    end
+
+    def derived_variants(picture)
+      picture.image.blob.reload.variant_records.order(:id).map(&:variation_digest)
+    end
+
+    def verified_variation_digest(signed_variation_key)
+      transformations = ActiveStorage.verifier.verify(signed_variation_key, purpose: :variation)
+
+      @picture.image.blob.variant(transformations).variation.digest
+    end
+
+    def content_of_transformed_image(picture, variation)
+      content = +""
+
+      picture.image.blob.open do |input|
+        variation.transform(input) { |output| content << output.read }
+      end
+
+      content
+    end
+end
