diff --git a/test/integration/book_absence_test.rb b/test/integration/book_absence_test.rb
index b9c20ac..01b9f47 100644
--- a/test/integration/book_absence_test.rb
+++ b/test/integration/book_absence_test.rb
@@ -8,4 +8,34 @@ class BookAbsenceTest < ActionDispatch::IntegrationTest
       end
     end
   end
+
+  test "an unpublished book reads as missing again once exceptions are rescued" do
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "the promise holds even when the block itself raises" do
+    raised = false
+
+    begin
+      with_raised_exceptions { raise "boom" }
+    rescue => error
+      raised = true
+      assert_equal "boom", error.message
+    end
+
+    assert raised
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
 end
diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..4cfe41f 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,33 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Rails copies config.action_dispatch.show_exceptions into the application's
+    # memoized env_config the first time it is built, then merges that hash into the
+    # env of every request (Rails::Engine#build_request). ActionDispatch::ShowExceptions
+    # reads the value from the request env, not from the config, so changing only the
+    # config has no effect once any request ran before -- and leaves whatever value was
+    # cached behind for every later test in the same process.
+    #
+    # Set both places so requests inside this block raise their exceptions, and restore
+    # both so error pages render normally afterwards, no matter which tests ran before
+    # or run after in the same worker process.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
-      yield
-    ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      previous_config_value =
+        Rails.application.config.action_dispatch.show_exceptions
+      previous_request_value =
+        Rails.application.env_config["action_dispatch.show_exceptions"]
+
+      begin
+        Rails.application.config.action_dispatch.show_exceptions = :none
+        Rails.application.env_config["action_dispatch.show_exceptions"] = :none
+
+        yield
+      ensure
+        Rails.application.config.action_dispatch.show_exceptions =
+          previous_config_value
+        Rails.application.env_config["action_dispatch.show_exceptions"] =
+          previous_request_value
+      end
     end
   end
 end
