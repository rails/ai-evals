--- a/test/controllers/sessions_controller_test.rb
+++ b/test/controllers/sessions_controller_test.rb
@@ -43,6 +43,53 @@ class SessionsControllerTest < ActionDispatch::IntegrationTest
     assert_nil parsed_cookies.signed[:session_token]
   end
 
+  test "create follows a return_to that stays inside the app" do
+    post session_url, params: { email_address: "david@example.com", password: "secret123456", return_to: leafable_path(leaves(:welcome_page)) }
+
+    assert_redirected_to leafable_path(leaves(:welcome_page))
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create follows a same-origin absolute return_to" do
+    url = edit_book_url(books(:handbook))
+
+    post session_url, params: { email_address: "david@example.com", password: "secret123456", return_to: url }
+
+    assert_redirected_to url
+  end
+
+  test "create ignores a foreign return_to" do
+    post session_url, params: { email_address: "david@example.com", password: "secret123456",
+                                return_to: "https://evil.example.com/sign-in-again" }
+
+    assert_redirected_to root_url
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create never leaves the app no matter what is in return_to" do
+    # Protocol-relative, lookalike hosts, other schemes and user info tricks.
+    [
+      "//evil.example.com/phish",
+      "HTTPS://EVIL.EXAMPLE.COM/phish",
+      "https://subdomain.evil.example.com/phish",
+      "https://www.example.com@evil.example.com/",
+      "javascript:alert(1)",
+      "data:text/html,<script>alert(1)</script>",
+      "ftp://www.example.com/uploads/thing"
+    ].each do |return_to|
+      post session_url, params: { email_address: "david@example.com", password: "secret123456", return_to: return_to }
+
+      assert_redirected_to root_url, "#{return_to.inspect} should not be followed off-site"
+    end
+  end
+
+  test "new does not carry a foreign return_to into its form" do
+    get new_session_path(return_to: "https://evil.example.com/sign-in-again")
+
+    assert_response :success
+    assert_not_in_body "evil.example.com"
+  end
+
