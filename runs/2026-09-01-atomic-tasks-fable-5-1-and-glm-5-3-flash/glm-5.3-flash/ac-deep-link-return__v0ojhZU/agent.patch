@@ -4,7 +4,7 @@ module Authentication
 
   included do
     before_action :require_authentication
-    helper_method :signed_in?
+    helper_method :signed_in?, :safe_return_to
 
     protect_from_forgery with: :exception, unless: -> { authenticated_by.bot_key? }
   end
@@ -71,6 +71,35 @@ module Authentication
       session.delete(:return_to_after_authenticating) || root_url
     end
 
+    # Links into the app carry the page they point at along as `return_to`, which
+    # we send readers to once they've signed in. Anyone can put anything there,
+    # though, so only ever follow it when it stays inside this application.
+    # Otherwise we'd be handing people over to somebody else's site, looking like
+    # this one, the moment they typed their password.
+    def safe_return_to(value = params[:return_to])
+      location = value.presence&.to_s
+      location if safe_to_return_to?(location)
+    end
+
+    def safe_to_return_to?(location)
+      return false if location.blank?
+      return false if location.match?(%r{[\r\n\0]}) # no header smuggling either
+
+      uri = URI.parse(location)
+
+      if uri.scheme || uri.host
+        # Absolute and protocol-relative locations must name this very origin.
+        return false unless uri.host && uri.host.casecmp(request.host).zero?
+
+        %w[ http https ].include?(uri.scheme)
+      else
+        # Relative locations stay inside the app.
+        uri.path.start_with?("/")
+      end
+    rescue URI::Error, TypeError
+      false
+    end
+
     def set_authentication_cookie(session)
       cookies.signed.permanent[:session_token] = { value: session.token, httponly: true, same_site: :lax }
     end
