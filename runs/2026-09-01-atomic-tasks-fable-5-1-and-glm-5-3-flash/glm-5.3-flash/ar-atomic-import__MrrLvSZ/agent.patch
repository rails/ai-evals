--- a/app/models/book/import.rb
+++ b/app/models/book/import.rb
@@ -1,18 +1,44 @@
 module Book::Import
   extend ActiveSupport::Concern
 
+  # Signals that the import refuses an entry, so none of the manifest may land.
+  # Raised from inside the batch — it is what makes the batch undo itself — and
+  # caught straight outside of it by import_manifest, which turns it back into
+  # a falsy result for the caller. Subclassing StandardError rather than
+  # ActiveRecord::Rollback keeps it visible: a Rollback raised at batch level is
+  # swallowed by Active Record before import_manifest ever hears about it.
+  class Rejected < StandardError
+    attr_reader :entry, :reason
+
+    def initialize(entry, reason = nil)
+      @entry = entry
+      @reason = reason
+      message = +"import rejected at #{entry.inspect}"
+      message << ": #{reason}" if reason
+      super(message)
+    end
+  end
+
   # Imports a manifest — an array of { title:, body: } entries — into the
   # book as sections, in manifest order. Imports are all-or-nothing: a book
-  # must never be left holding part of a manifest.
+  # must never be left holding part of a manifest, no matter which entry in the
+  # manifest gives it reason to stop. Returns truthy for a fully imported
+  # manifest, falsy otherwise.
   def import_manifest(entries)
     as_one_batch do
       entries.each do |entry|
-        return rejected(entry) unless entry_valid?(entry)
+        unless entry_valid?(entry)
+          raise Rejected.new(entry)
+        end
 
         press(Section.new(body: entry[:body]), title: entry[:title])
+      rescue ActiveRecord::ActiveRecordError => error
+        raise Rejected.new(entry, "#{error.class.name}: #{error.message}")
       end
     end
     true
+  rescue Rejected => error
+    rejected(error.entry, error.reason)
   end
 
   private
@@ -20,8 +46,10 @@ module Book::Import
       entry[:title].present? && entry[:body].present?
     end
 
-    def rejected(entry)
-      Rails.logger.warn "import rejected at #{entry.inspect}"
+    def rejected(entry, reason = nil)
+      message = +"import rejected at #{entry.inspect}"
+      message << ": #{reason}" if reason
+      Rails.logger.warn message
       false
     end
 end
diff --git a/app/models/concerns/batched.rb b/app/models/concerns/batched.rb
index 55a53e7..42ddf69 100644
--- a/app/models/concerns/batched.rb
+++ b/app/models/concerns/batched.rb
@@ -4,9 +4,15 @@ module Batched
   private
     # Runs a batch of writes as a single unit of work: either the whole batch
     # lands or none of it does. The manifest importer goes through here so
-    # that a rejected manifest leaves the book exactly as it was before the
+    # that a rejected batch leaves the book exactly as it was before the
     # attempt.
+    #
+    # Batches claim their own savepoint (+requires_new+) instead of joining
+    # whatever transaction is already open around them. Otherwise a batch
+    # abandoned partway through would take the enclosing transaction down with
+    # it — say, the nightly importer's other manifests — or, worse, leave its
+    # own half behind while pretending to have been undone.
     def as_one_batch(&block)
-      self.class.transaction(&block)
+      self.class.transaction(requires_new: true, &block)
     end
 end
diff --git a/test/models/book/import_test.rb b/test/models/book/import_test.rb
new file mode 100644
index 0000000..303b978
--- /dev/null
+++ b/test/models/book/import_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class BookImportManifestTest < ActiveSupport::TestCase
+  def imported_titles(book)
+    book.reload.leaves.order(:position_score).pluck(:title)
+  end
+
+  test "imports every entry of a valid manifest as sections in order" do
+    entries = [
+      { title: "One", body: "first" },
+      { title: "Two", body: "second" },
+      { title: "Three", body: "third" }
+    ]
+
+    assert books(:manual).import_manifest(entries)
+
+    assert_equal %w[ One Two Three ], imported_titles(books(:manual))
+  end
+
+  test "imports each entry exactly once as sections" do
+    entries = [ { title: "A section", body: "body" } ]
+
+    books(:manual).import_manifest(entries)
+
+    leaves = books(:manual).reload.leaves
+    assert_equal 1, leaves.count
+    assert_instance_of Section, leaves.first.leafable
+  end
+
+  test "a manifest with an invalid entry at the end imports nothing" do
+    book = books(:manual)
+    assert_not book.import_manifest([
+      { title: "One", body: "first" },
+      { title: "", body: "second" }
+    ])
+
+    assert_empty book.reload.leaves
+  end
+
+  test "a manifest with an invalid entry partway through imports nothing" do
+    book = books(:manual)
+    assert_not book.import_manifest([
+      { title: "One", body: "first" },
+      { title: "Two", body: "" },
+      { title: "Three", body: "third" }
+    ])
+
+    assert_equal [], imported_titles(book)
+  end
+
+  test "a manifest whose first entry is missing a body imports nothing" do
+    book = books(:manual)
+    assert_not book.import_manifest([
+      { title: nil, body: nil },
+      { title: "Three", body: "third" }
+    ])
+
+    assert_equal [], imported_titles(book)
+  end
+
+  test "an entry duplicating an existing title is rejected without crashing" do
+    book = books(:handbook)
+    count_before = book.leaves.count
+
+    assert_not book.import_manifest([
+      { title: "New Section", body: "body" },
+      { title: "The Welcome Section", body: "duplicate title" }
+    ])
+
+    assert_equal count_before, book.reload.leaves.count
+  end
+
+  test "two entries in one manifest may not share a title" do
+    book = books(:manual)
+
+    assert_not book.import_manifest([
+      { title: "Repeat", body: "first body" },
+      { title: "Repeat", body: "second body" }
+    ])
+
+    assert_empty book.reload.leaves
+  end
+
+  test "rejected manifest inside a larger transaction rolls back only itself" do
+    Book.transaction do
+      books(:handbook).leaves.create!(title: "Other work", leafable: Section.new(body: "other"))
+      books(:manual).import_manifest([ { title: "Bad", body: "bad" }, { title: "", body: "nope" } ])
+      books(:handbook).leaves.create!(title: "Later work", leafable: Section.new(body: "later"))
+    end
+
+    assert_includes imported_titles(books(:handbook)), "Other work"
+    assert_includes imported_titles(books(:handbook)), "Later work"
+    assert_empty books(:manual).reload.leaves
+  end
+
+  test "bulk importer keeps its other manifests when one is rejected" do
+    result = nil
+    good_books = []
+
+    Book.transaction do
+      BulkImport.new({
+        books(:handbook) => [ { title: "Handbook chapter", body: "hb body" }, { title: "Another", body: "ab" } ],
+        books(:manual) => [ { title: "Manual chapter", body: "mn body" }, { title: "", body: "nope" } ]
+      }).tap do |importer|
+        result = importer.run
+        good_books << books(:handbook)
+      end
+    end
+
+    assert_equal good_books, result.imported
+    assert_equal [ books(:manual) ], result.rejected
+    assert_includes imported_titles(books(:handbook)), "Handbook chapter"
+    assert_includes imported_titles(books(:handbook)), "Another"
+    assert_empty books(:manual).reload.leaves.where(title: "Manual chapter")
+  end
+
+  test "same book takes later manifests after an earlier rejection" do
+    result = nil
+
+    Book.transaction do
+      result = BulkImport.new({
+        books(:manual) => [ { title: "", body: "nope" } ]
+      }).run
+      books(:manual).import_manifest([ { title: "After the reject", body: "body" } ])
+    end
+
+    assert_equal [ books(:manual) ], result.rejected
+    assert_equal [ "After the reject" ], imported_titles(books(:manual))
+  end
+  test "same book keeps earlier manifests after a later rejection" do
+    result = nil
+
+    Book.transaction do
+      books(:manual).import_manifest([ { title: "Before the reject", body: "body" } ])
+      result = BulkImport.new({
+        books(:manual) => [ { title: "Rejected later", body: "" } ]
+      }).run
+    end
+
+    assert_equal [ books(:manual) ], result.rejected
+    assert_equal [ "Before the reject" ], imported_titles(books(:manual))
+  end
+
+  test "rejected manifest returns nil rather than raising" do
+    assert_not books(:manual).import_manifest([ { title: "", body: "" } ])
+  end
+end
