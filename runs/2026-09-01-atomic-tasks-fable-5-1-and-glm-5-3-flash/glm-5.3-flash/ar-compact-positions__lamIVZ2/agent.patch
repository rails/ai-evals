diff --git a/app/models/book/maintenance.rb b/app/models/book/maintenance.rb
index ae0e083..e7b5a73 100644
--- a/app/models/book/maintenance.rb
+++ b/app/models/book/maintenance.rb
@@ -1,12 +1,14 @@
 module Book::Maintenance
   extend ActiveSupport::Concern
 
+  # Pulls every leaf of this book back onto a dense sequence of scores, keeping
+  # their current relative order intact.
   def compact_positions!
     self.class.connection.execute(<<~SQL)
       UPDATE leaves
-      SET position_score = ranked.rank
+      SET position_score = ranked.dense_score
       FROM (
-        SELECT id, ROW_NUMBER() OVER (ORDER BY "position_socre", id) AS rank
+        SELECT id, ROW_NUMBER() OVER (ORDER BY position_score, id) AS dense_score
         FROM leaves WHERE book_id = #{id.to_i}
       ) AS ranked
       WHERE leaves.id = ranked.id AND leaves.book_id = #{id.to_i}
@@ -16,7 +18,7 @@ module Book::Maintenance
   def live_leaf_count
     self.class.connection.select_value(<<~SQL).to_i
       SELECT COUNT(*) FROM leaves
-      WHERE book_id = #{id.to_i} AND status = "active"
+      WHERE book_id = #{id.to_i} AND status != 'trashed'
     SQL
   end
 end
diff --git a/test/models/book/maintenance_test.rb b/test/models/book/maintenance_test.rb
new file mode 100644
index 0000000..7a13ca5
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,142 @@
+require "rake"
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  TITLES = %w[ Alpha Beta Gamma Delta ]
+
+  setup do
+    @book = books(:manual)
+    @leaves = TITLES.map do |title|
+      @book.press Page.new(body: "#{title} body"), title: title
+    end
+  end
+
+  test "compacting keeps the arranged order" do
+    arrange_as [ "Delta", "Beta", "Alpha", "Gamma" ]
+
+    @book.compact_positions!
+
+    assert_equal [ "Delta", "Beta", "Alpha", "Gamma" ], ordered_titles
+  end
+
+  test "compacting densifies scores into 1..n" do
+    arrange_as [ "Delta", "Beta", "Alpha", "Gamma" ]
+
+    @book.compact_positions!
+
+    assert_equal [ 1, 2, 3, 4 ], ordered_scores
+  end
+
+  test "compacting closes gaps left behind deletions" do
+    { "Alpha" => 1, "Beta" => 1000, "Gamma" => 2500, "Delta" => 9000 }.each do |title, score|
+      leaf(title).update!(position_score: score)
+    end
+
+    assert_equal [ 1, 1000, 2500, 9000 ], ordered_scores
+    assert_equal TITLES, ordered_titles
+
+    @book.compact_positions!
+
+    assert_equal [ 1, 2, 3, 4 ], ordered_scores
+    assert_equal TITLES, ordered_titles
+  end
+
+  test "compacting breaks ties the same way positioning does" do
+    @leaves.each { |leaf| leaf.update!(position_score: 1) }
+
+    @book.compact_positions!
+
+    assert_equal [ 1, 2, 3, 4 ], ordered_scores
+    assert_equal TITLES, ordered_titles
+  end
+
+  test "compacting reserves the slot of a trashed page" do
+    arrange_as [ "Alpha", "Gamma", "Delta", "Beta" ]
+    leaf("Gamma").trashed!
+
+    @book.compact_positions!
+
+    # Every leaf, trashed ones included, keeps its place on a dense 1..n scale.
+    all_leaves_in_score_order = @book.leaves.order(:position_score, :id).reload
+
+    assert_equal [ "Alpha", "Gamma", "Delta", "Beta" ], all_leaves_in_score_order.map(&:title)
+    assert_equal [ 1, 2, 3, 4 ], all_leaves_in_score_order.map(&:position_score)
+    assert_equal [ "Alpha", "Delta", "Beta" ], ordered_titles
+  end
+
+  test "a page restored from the trash comes back where it was" do
+    arrange_as [ "Alpha", "Gamma", "Delta", "Beta" ]
+    leaf("Gamma").trashed!
+    @book.compact_positions!
+
+    leaf("Gamma").update!(status: "active")
+
+    assert_equal [ "Alpha", "Gamma", "Delta", "Beta" ], ordered_titles
+    assert_equal [ 1, 2, 3, 4 ], ordered_scores
+  end
+
+  test "compacting is scoped to one book" do
+    other = books(:handbook)
+    before = other.leaves.order(:id).pluck(:position_score)
+    arrange_as [ "Delta", "Beta", "Alpha", "Gamma" ]
+
+    @book.compact_positions!
+
+    assert_equal before, other.leaves.order(:id).pluck(:position_score)
+    assert_equal books(:handbook).leaves.active.count, other.live_leaf_count
+  end
+
+  test "compacting a book without leaves does nothing" do
+    assert_nothing_raised { Book.create!(title: "Empty").compact_positions! }
+  end
+
+  test "live leaf count excludes trashed pages" do
+    assert_equal 4, @book.live_leaf_count
+
+    leaf("Gamma").trashed!
+    leaf("Delta").trashed!
+
+    assert_equal 2, @book.live_leaf_count
+  end
+
+  test "live leaf count is per book" do
+    assert_equal 4, books(:handbook).live_leaf_count
+    assert_equal 4, @book.live_leaf_count
+  end
+
+  test "maintenance task compacts every book" do
+    arrange_as [ "Delta", "Beta", "Alpha", "Gamma" ]
+    leaves(:welcome_page).update!(position_score: 50)
+
+    compact_all_books
+
+    assert_equal [ 1, 2, 3, 4 ], ordered_scores
+    assert_equal [ "Delta", "Beta", "Alpha", "Gamma" ], ordered_titles
+    assert_equal [ 1, 2, 3, 4 ], books(:handbook).leaves.active.positioned.reload.map(&:position_score)
+  end
+
+  private
+    def compact_all_books
+      Rails.application.load_tasks unless Rake::Task.task_defined?("maintenance:compact_positions")
+      task = Rake::Task["maintenance:compact_positions"]
+      task.reenable
+      task.invoke
+    end
+
+    def leaf(title)
+      Leaf.find_by!(title: title, book: @book)
+    end
+
+    def arrange_as(titles)
+      titles.each_with_index { |title, index| leaf(title).move_to_position(index) }
+      assert_equal titles, ordered_titles
+    end
+
+    def ordered_titles
+      @book.leaves.active.positioned.reload.map(&:title)
+    end
+
+    def ordered_scores
+      @book.leaves.active.positioned.reload.map(&:position_score)
+    end
+end
