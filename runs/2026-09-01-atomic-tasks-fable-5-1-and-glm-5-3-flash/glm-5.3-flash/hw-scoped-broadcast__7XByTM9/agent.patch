diff --git a/app/models/book/accessable.rb b/app/models/book/accessable.rb
index aa3dcf1..76987c5 100644
--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -20,6 +20,20 @@ module Book::Accessable
     end
   end
 
+  # People who can edit this book right now, i.e. those who may have a leaf
+  # editor open and should see who else is editing. Live editing indicators are
+  # addressed to each of them individually rather than published on a stream
+  # shared by everyone with an editor open. Access is reevaluated on every save,
+  # so someone removed from the book stops receiving indicators immediately.
+  def editing_recipients
+    editors.or(User.active.administrator).ordered
+  end
+
+  # People granted editor access to this book.
+  def editors
+    User.active.where(id: accesses.editor.select(:user_id))
+  end
+
   def accessable?(user: Current.user)
     accesses.exists?(user: user)
   end
