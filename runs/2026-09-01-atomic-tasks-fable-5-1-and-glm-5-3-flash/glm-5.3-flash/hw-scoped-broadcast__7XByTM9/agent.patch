diff --git a/test/integration/being_edited_indicator_test.rb b/test/integration/being_edited_indicator_test.rb
new file mode 100644
index 0000000..fe6e1d2
--- /dev/null
+++ b/test/integration/being_edited_indicator_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+require "turbo/broadcastable/test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  include Turbo::Broadcastable::TestHelper
+
+  setup do
+    @book = books(:handbook)
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "who-is-editing is addressed to everyone who can edit the book" do
+    sign_in :jason
+
+    save_page
+
+    [ users(:david), users(:kevin) ].each do |recipient|
+      streams = who_is_editing_broadcasts_to(presence_stream(recipient))
+      assert_equal 1, streams.size, "Expected #{recipient.name} to see who is editing"
+      assert_includes streams.first.to_html, "Jason"
+    end
+  end
+
+  test "who-is-editing is addressed to nobody else" do
+    sign_in :jason
+
+    save_page
+
+    assert_empty who_is_editing_broadcasts_to(presence_stream(users(:jz))),
+      "Expected not to send who-is-editing to someone without edit access"
+
+    assert_empty who_is_editing_broadcasts_to([ @leaf, :being_edited ]),
+      "Expected not to send who-is-editing on a stream shared by everyone with an editor open"
+  end
+
+  test "who-is-editing stops being addressed to collaborators removed from the book" do
+    sign_in :jason
+
+    save_page
+    assert_not_empty who_is_editing_broadcasts_to(presence_stream(users(:kevin))),
+      "Kevin should see who is editing while he is an editor"
+
+    @book.accesses.find_by!(user: users(:kevin)).destroy!
+
+    save_page
+    assert_empty who_is_editing_broadcasts_to(presence_stream(users(:kevin))),
+      "Expected nobody to send who-is-editing to someone removed from the book"
+  end
+
+  test "editing indicator subscribes on a stream addressed to the current user" do
+    sign_in :kevin
+
+    get edit_book_page_path(@book, @leaf)
+
+    assert_response :success
+
+    sources = css_select "turbo-cable-stream-source"
+
+    assert_not_empty sources
+    assert_equal [ "Turbo::StreamsChannel" ], sources.collect { |source| source["channel"] }
+    assert_equal [ stream_name(@leaf, users(:kevin), :being_edited) ],
+      sources.collect { |source| Turbo.signed_stream_verifier.verified(source["signed-stream-name"]) }
+  end
+
+  private
+    # Saves the page and returns only what that save broadcast.
+    def save_page
+      ActionCable.server.pubsub.clear
+      perform_enqueued_jobs { patch book_page_path(@book, @leaf), params: { page: { body: "Still here." } } }
+      assert_response :no_content
+    end
+
+    def who_is_editing_broadcasts_to(streamables)
+      capture_turbo_stream_broadcasts Array.wrap(streamables)
+    end
+
+    # The stream a given person listens on for who-is-editing payloads.
+    def presence_stream(user)
+      stream_name(@leaf, user, :being_edited)
+    end
+
+    def stream_name(*streamables)
+      Turbo::StreamsChannel.send :stream_name_from, streamables.flatten
+    end
+end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..afd50d8 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,28 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors are the people granted editor access" do
+    assert_equal %w[ David Jason Kevin ], books(:handbook).editors.collect(&:name).sort
+  end
+
+  test "editing_recipients includes administrators, who can edit any book" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+
+    assert_includes book.editing_recipients.collect(&:name), users(:david).name
+  end
+
+  test "editing_recipients leaves out readers" do
+    assert_not_includes books(:handbook).editing_recipients, users(:jz)
+  end
+
+  test "editing_recipients leaves out deactivated collaborators" do
+    book = books(:handbook)
+
+    assert_includes book.editing_recipients, users(:jason)
+
+    users(:jason).deactivate
+
+    assert_not_includes book.editing_recipients.collect(&:name), users(:jason).name
+  end
 end
