diff --git a/test/integration/tenant_isolation_coverage_test.rb b/test/integration/tenant_isolation_coverage_test.rb
new file mode 100644
index 0000000..7c717fb
--- /dev/null
+++ b/test/integration/tenant_isolation_coverage_test.rb
@@ -0,0 +1,228 @@
+require "test_helper"
+
+# Behaviour when one install hosts several customers side by side.
+module TenantIsolationCoverage
+  class CustomerBooksBetweenTwoTenants < ActionDispatch::IntegrationTest
+    setup do
+      @customer_a = Tenant.create!(name: "Customer A")
+      @customer_b = Tenant.create!(name: "Customer B")
+
+      users(:kevin).update!(tenant: @customer_a)
+      users(:jason).update!(tenant: @customer_b)
+
+      books(:handbook).update!(tenant: @customer_a)
+      books(:manual).update!(tenant: @customer_b)
+
+      @customers_secret = books(:manual).press Page.new(body: "<p>Customer B secrets</p>"), title: "Secrets"
+      @handbook_page = leaves(:welcome_page)
+    end
+
+    test "a book lands in the tenant of the user who creates it" do
+      sign_in :kevin
+
+      post books_url, params: { book: { title: "Tenant A Book", everyone_access: false } }
+
+      assert_redirected_to book_slug_url(Book.last)
+      assert_equal @customer_a.id, Book.last.tenant_id
+    end
+
+    test "another tenant's books are gone from their library, published or not" do
+      # Sharing with everyone sprays reader rows across the whole install.
+      Access.create!(user: users(:kevin), book: books(:manual), level: :reader)
+      sign_in :kevin
+
+      get root_url
+      assert_response :success
+      assert_in_body "Handbook"
+      assert_not_in_body "Manual"
+
+      books(:manual).update!(published: true)
+
+      get root_url
+      assert_response :success
+      assert_not_in_body "Manual"
+    end
+
+    test "another tenant's book answers with the same nothing as an unknown one" do
+      sign_in :kevin
+
+      get book_slug_url(books(:manual))
+      assert_response :not_found
+
+      get book_slug_path(books(:manual), format: :md)
+      assert_response :not_found
+
+      get edit_book_publication_url(books(:manual))
+      assert_response :not_found
+    end
+
+    test "another tenant's pages and edit histories answer with a not found" do
+      # Even holding an access row for the book buys no way in.
+      Access.create!(user: users(:kevin), book: books(:manual), level: :reader)
+      @customers_secret.edit leafable_params: { body: "Even more secrets" }
+
+      sign_in :kevin
+
+      get leafable_path(@customers_secret)
+      assert_response :not_found
+
+      get edit_leafable_path(@customers_secret)
+      assert_response :not_found
+
+      get slugged_leafable_path(books(:manual), books(:manual).slug, @customers_secret, @customers_secret.slug)
+      assert_response :not_found
+
+      get page_edit_url(@customers_secret, @customers_secret.edits.last)
+      assert_response :not_found
+
+      get page_edit_url(@customers_secret, "latest")
+      assert_response :not_found
+
+      get book_pages_path(books(:manual))
+      assert_response :not_found
+    end
+
+    test "inside their own tenant nothing changes" do
+      @handbook_page.edit leafable_params: { body: "Customer A content" }
+      sign_in :kevin
+
+      get root_url
+      assert_response :success
+      assert_in_body "Handbook"
+      assert_not_in_body "Manual"
+
+      get book_slug_path(books(:handbook))
+      assert_response :success
+
+      get leafable_path(@handbook_page)
+      assert_response :success
+      assert_in_body "Customer A content"
+
+      get page_edit_url(@handbook_page, @handbook_page.edits.last)
+      assert_response :success
+      assert_in_body "Customer A content"
+    end
+
+    test "signed out visitors still see every published book, whatever tenant it belongs to" do
+      books(:handbook).update!(published: true)
+      books(:manual).update!(published: true)
+
+      get root_url
+      assert_response :success
+      assert_in_body "Handbook"
+      assert_in_body "Manual"
+
+      get book_slug_url(books(:manual))
+      assert_response :success
+
+      get leafable_path(@customers_secret)
+      assert_response :success
+    end
+
+    test "signed out visitors are asked to sign in when nothing is published" do
+      get root_url
+      assert_redirected_to new_session_url
+    end
+
+    test "/users still names everyone on the install" do
+      sign_in :kevin
+
+      get users_url
+      assert_response :success
+      assert_in_body "Kevin"
+      assert_in_body "Jason"
+    end
+
+    test "sharing with everyone stays inside the tenant" do
+      sign_in :jason
+
+      post books_url, params: { book: { title: "Shared in B" } }
+
+      book = Book.last
+      assert book.everyone_access?
+      assert book.accessable?(user: users(:jason))
+      assert_not book.accessable?(user: users(:kevin))
+      assert_not users(:david).accesses.exists?(book_id: book.id)
+    end
+
+    test "a new user only gets what they could reach anyway" do
+      unscoped_book = Book.create!(title: "Unscoped", everyone_access: true)
+      tenants_book = Book.create!(title: "Tenant A", everyone_access: true, tenant: @customer_a)
+
+      bob = User.create!(name: "Bob", email_address: "bob@example.com", password: "secret123456")
+
+      assert unscoped_book.accessable?(user: bob)
+      assert_not tenants_book.accessable?(user: bob)
+    end
+  end
+
+  class EverythingElseAroundTenants < ActionDispatch::IntegrationTest
+    setup do
+      @customer_a = Tenant.create!(name: "Customer A")
+      @customer_b = Tenant.create!(name: "Customer B")
+
+      users(:kevin).update!(tenant: @customer_a)
+      users(:jason).update!(tenant: @customer_b)
+
+      books(:handbook).update!(tenant: @customer_a)
+      books(:manual).update!(tenant: @customer_b)
+      books(:manual).update!(published: true)
+    end
+
+    test "sections, pictures, bookmarks and search answer with a not found elsewhere" do
+      other_tenants_section = books(:manual).press Section.new(body: "Secrets"), title: "B Section"
+
+      sign_in :kevin
+
+      get leafable_path(other_tenants_section)
+      assert_response :not_found
+
+      get edit_leafable_path(other_tenants_section)
+      assert_response :not_found
+
+      put leafable_path(other_tenants_section), params: { section: { body: "Hacked" } }
+      assert_response :not_found
+
+      delete leafable_path(other_tenants_section), params: { format: :turbo_stream }
+      assert_response :not_found
+
+      post book_sections_path(books(:manual), format: :turbo_stream), params: { section: { body: "Nope" } }
+      assert_response :not_found
+
+      get book_bookmark_path(books(:manual))
+      assert_response :not_found
+
+      Leaf.reindex_all
+      post book_search_url(books(:manual)), params: { search: "Secrets" }
+      assert_response :not_found
+    end
+
+    test "searching inside an own book keeps working" do
+      Leaf.reindex_all
+      sign_in :kevin
+
+      post book_search_url(books(:handbook)), params: { search: "Thanks" }
+
+      assert_response :success
+      assert_select "a", text: /Thanks for reading/i
+    end
+
+    test "an administrator of one tenant stays locked out of another tenant" do
+      sign_in :jason
+
+      get book_slug_url(books(:handbook))
+      assert_response :not_found
+
+      delete book_url(books(:handbook))
+      assert_response :not_found
+    end
+
+    test "a user without any tenant sees neither tenant's books" do
+      sign_in :jz
+
+      get root_url
+      assert_not_in_body "Handbook"
+      assert_not_in_body "Manual"
+    end
+  end
+end
