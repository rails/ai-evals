diff --git a/db/migrate/20250116120000_create_tenants.rb b/db/migrate/20250116120000_create_tenants.rb
new file mode 100644
index 0000000..f5c1bb7
--- /dev/null
+++ b/db/migrate/20250116120000_create_tenants.rb
@@ -0,0 +1,39 @@
+# Tenants let several customers live side by side on one install. Everyone and
+# everything already living here gets swept into a single tenant, so upgrades
+# happen in place without any admin action.
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name
+      t.timestamps null: false
+    end
+
+    change_table :users do |t|
+      t.references :tenant
+    end
+
+    change_table :books do |t|
+      t.references :tenant
+    end
+
+    add_foreign_key :users, :tenants
+    add_foreign_key :books, :tenants
+
+    reversible do |dir|
+      dir.up { sweep_existing_records_into_one_tenant }
+    end
+  end
+
+  private
+    def sweep_existing_records_into_one_tenant
+      return unless Account.exists? || User.exists? || Book.exists?
+
+      tenant = Tenant.create!(name: tenant_name)
+      User.update_all tenant_id: tenant.id
+      Book.update_all tenant_id: tenant.id
+    end
+
+    def tenant_name
+      Account.order(:created_at).first&.name.presence || "Writebook"
+    end
+end
