diff --git a/app/models/concerns/tenantable.rb b/app/models/concerns/tenantable.rb
new file mode 100644
index 0000000..6658876
--- /dev/null
+++ b/app/models/concerns/tenantable.rb
@@ -0,0 +1,42 @@
+# Shared behaviour for records that belong to one customer of this install: they
+# carry a tenant, or nothing at all when they were recorded before tenants
+# existed.
+module Tenantable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    scope :without_a_tenant, -> { where(tenant_id: nil) }
+  end
+
+  class_methods do
+    # Records reachable from inside someone's tenant: their own ones together
+    # with every record carrying no tenant, which were always shared across the
+    # whole install and keep working as they always did.
+    def shareable_across_tenants_with(record)
+      if record.tenant_id.present?
+        where(tenant_id: [ record.tenant_id, nil ])
+      else
+        without_a_tenant
+      end
+    end
+
+    # Records allowed alongside something that belongs to a tenant: its own ones,
+    # or everybody at all when nothing is scoped by tenants yet.
+    def inside_the_tenant_of(record)
+      if record.tenant_id.present?
+        where(tenant_id: record.tenant_id)
+      else
+        all
+      end
+    end
+  end
+
+  # Whether this record can be reached together with another one. Records scoped
+  # by a tenant are confined to their own customer, everything else behaves as it
+  # always has.
+  def shareable_across_tenants_with?(record)
+    tenant_id.blank? || record.blank? || tenant_id == record.tenant_id
+  end
+end
