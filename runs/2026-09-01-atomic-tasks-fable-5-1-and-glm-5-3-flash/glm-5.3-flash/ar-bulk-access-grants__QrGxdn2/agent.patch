+# Grants access to a book for a whole roster at once.
+#
+# The sheet stands or falls as one: every row is checked before anything is
+# written, so a bad row turns down the sheet without telling anybody about
+# access they never got. The rows that are accepted are written in one round
+# trip, whatever the size of the sheet.
 class Book::AccessImport
   Result = Struct.new(:accesses, :duplicate_index)
 
@@ -6,20 +12,72 @@ class Book::AccessImport
   end
 
   def import
-    accesses = []
-    duplicate_index = nil
+    return Result.new([], duplicate_index) if duplicate_index
+
+    accesses = grant_accesses
+    Result.new(accesses, nil)
+  rescue ActiveRecord::RecordNotUnique
+    # Outraced by another grant between checking the sheet and writing it.
+    index = duplicate_index
+    raise if index.nil?
+
+    Result.new([], index)
+  end
+
+  private
+    # Index of the first row the book can't take: a level nobody has heard of,
+    # or somebody who already has access to the book or earlier in the sheet.
+    def duplicate_index
+      levels = @grants.map { |grant| Access.levels[grant[:level].to_s] }
+      existing = @book.accesses.where(user_id: user_ids.uniq).index_by(&:user_id)
+      granted = {}
 
-    Access.transaction do
       @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
+        user_id = grant[:user_id]
+        return index unless levels[index]
+
+        return index if existing.key?(user_id)
+        return index if granted.key?(user_id)
+
+        granted[user_id] = true
       end
+
+      nil
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
-  end
+    # Writes every row of the sheet in one statement, reads the granted records
+    # back in sheet order, then lets each person know.
+    def grant_accesses
+      return [] if @grants.empty?
+
+      accesses = Access.transaction do
+        @book.accesses.insert_all!(rows)
+        @book.accesses.reset
+        granted_accesses
+      end
+
+      notify(accesses)
+      accesses
+    end
+
+    def rows
+      @grants.map { |grant| { book_id: @book.id, user_id: grant[:user_id], level: level_for(grant) } }
+    end
+
+    def granted_accesses
+      granted = @book.accesses.where(user_id: user_ids.uniq).index_by(&:user_id)
+      user_ids.filter_map { |user_id| granted[user_id] }
+    end
+
+    def notify(accesses)
+      accesses.each { Book::AccessNotificationJob.perform_later(it) }
+    end
+
+    def level_for(grant)
+      Access.levels.fetch(grant[:level].to_s)
+    end
+
+    def user_ids
+      @grants.map { it[:user_id] }
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..98a43ea
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,158 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  setup do
+    @book = Book.create!(title: "Rostered book", everyone_access: false)
+    @notifications_before = enqueued_notification_count
+
+    # A roster big enough for the cost of importing it to show.
+    @roster = Array.new(16) { |index|
+      User.create! name: "roster #{index}", email_address: "roster#{index}@example.com",
+        password_digest: BCrypt::Password.create("secret123456"), role: :member
+    }
+  end
+
+  test "grants access at every level on the sheet" do
+    result = import(grant(:david, "editor"), grant(:jason), grant(:jz))
+
+    assert_nil result.duplicate_index
+    assert_equal %w[ editor reader reader ], result.accesses.map(&:level)
+    assert result.accesses.all?(&:persisted?)
+
+    assert @book.editable?(user: users(:david))
+    assert_not @book.editable?(user: users(:jz))
+    assert @book.accessable?(user: users(:jz))
+  end
+
+  test "lets everybody know about the access they got" do
+    import(grant(:david, "editor"), grant(:jason))
+
+    notified = notifications_since_setup
+    assert_equal [ users(:david).id, users(:jason).id ], notified.map(&:user_id)
+    assert_equal %w[ editor reader ], notified.map(&:level)
+  end
+
+  test "sixteen names cost what four names do" do
+    four_grants = [ grant(:david), grant(:jason), grant(:jz), grant(:kevin) ]
+    four = count_statements { import(*four_grants) }
+
+    Access.delete_all
+    sixteen = count_statements { import(*sheet(@roster)) }
+
+    puts "importing four names costs #{four} statements, importing sixteen costs #{sixteen}"
+    assert_operator sixteen, :<=, four
+    assert_equal 16, @book.accesses.count
+  end
+
+  test "a roster that collides with existing access notifies nobody" do
+    taken = Access.create!(book: @book, user: users(:kevin), level: :reader)
+
+    colliding_sheet = sheet(@roster.first(4)).insert(2, { user_id: taken.user_id, level: "editor" })
+    result = import(*colliding_sheet)
+
+    assert_equal 2, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal [ taken ], Access.where(book_id: @book).order(:id)
+    assert_no_new_notifications
+  end
+
+  test "two rows naming the same person turn the sheet down" do
+    result = import(grant(:david), grant(:jason), grant(:jason))
+
+    assert_equal 2, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal 0, Access.where(book_id: @book).count
+    assert_no_new_notifications
+  end
+
+  test "an unknown level is turned down like any other bad row" do
+    bad_row_index = 1
+    sheet_with_a_bad_level = sheet(@roster.first(3)).insert(bad_row_index, { user_id: nil, level: "overlord" })
+
+    result = import(*sheet_with_a_bad_level)
+
+    assert_equal bad_row_index, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal 0, Access.where(book_id: @book).count
+    assert_no_new_notifications
+  end
+
+
+  test "an empty roster grants nobody anything" do
+    result = Book::AccessImport.new(@book, []).import
+
+    assert_nil result.duplicate_index
+    assert_empty result.accesses
+    assert_no_new_notifications
+  end
+
+  test "levels are taken as named, symbols included" do
+    result = Book::AccessImport.new(@book, [ { user_id: users(:david).id, level: :editor } ]).import
+
+    assert_nil result.duplicate_index
+    assert_equal %w[ editor ], result.accesses.map(&:level)
+  end
+
+  test "a bad row ahead of a duplicate is what gets reported" do
+    bad_row_index = 0
+
+    result = Book::AccessImport.new(@book, [ { user_id: users(:david).id, level: "chief" }, { user_id: users(:david).id, level: "reader" } ]).import
+
+    assert_equal bad_row_index, result.duplicate_index
+  end
+
+  test "a duplicate row ahead of a bad level is what gets reported" do
+    colliding_sheet = [
+      { user_id: users(:david).id, level: "reader" },
+      { user_id: users(:david).id, level: "overlord" }
+    ]
+
+    result = Book::AccessImport.new(@book, colliding_sheet).import
+
+    assert_equal 1, result.duplicate_index
+  end
+  private
+    # Who, and at what level.
+    def sheet(roster, level = "reader")
+      roster.map { |user| { user_id: user.id, level: level } }
+    end
+
+    def grant(name, level = "reader")
+      { user_id: users(name).id, level: level }
+    end
+
+    def import(*grants)
+      Book::AccessImport.new(@book, grants.flatten(1)).import
+    end
+
+    def notifications_since_setup
+      Book::AccessNotificationJob.queue_adapter.enqueued_jobs
+        .drop(@notifications_before)
+        .filter_map do |job|
+          next unless job[:job] == Book::AccessNotificationJob
+          GlobalID::Locator.locate(job.dig(:args, 0, "_aj_globalid"))
+        end
+    end
+
+    def assert_no_new_notifications
+      assert_empty notifications_since_setup
+    end
+
+    def enqueued_notification_count
+      Book::AccessNotificationJob.queue_adapter.enqueued_jobs.size
+    end
+
+    def count_statements(&block)
+      statements = []
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |event|
+        payload = event.payload
+        next if %i[ SCHEMA TRANSACTION PRAGMA ].include?(payload[:name])
+        next if payload[:sql].blank? || payload[:cached]
+        statements << payload[:sql]
+      end
+      block.call
+      statements.size
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+    end
+end
