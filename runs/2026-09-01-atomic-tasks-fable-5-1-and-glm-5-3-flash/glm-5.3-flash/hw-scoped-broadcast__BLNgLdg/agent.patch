diff --git a/test/integration/being_edited_indicator_test.rb b/test/integration/being_edited_indicator_test.rb
new file mode 100644
index 0000000..a58bc6a
--- /dev/null
+++ b/test/integration/being_edited_indicator_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  setup do
+    @leaf = leaves(:welcome_page)
+    sign_in :kevin
+  end
+
+  test "edit page subscribes to a stream addressed to the signed in editor" do
+    get edit_book_page_path(books(:handbook), @leaf)
+
+    assert_response :success
+    assert_select 'turbo-cable-stream-source[channel="Turbo::StreamsChannel"]' do |sources|
+      assert_equal being_edited_stream(users(:kevin), @leaf),
+        Turbo.signed_stream_verifier.verified(sources.first["signed-stream-name"])
+    end
+  end
+
+  test "saving pushes who is editing to every editor of the book" do
+    save_page
+
+    [ users(:david), users(:jason), users(:kevin) ].each do |editor|
+      broadcasts_for_editor = broadcasts(being_edited_stream(editor, @leaf))
+
+      assert broadcasts_for_editor.one?, "expected the indicator to be pushed to #{editor.name}"
+      assert_includes broadcasts_for_editor.first, users(:kevin).name
+      assert_includes broadcasts_for_editor.first, dom_id(@leaf, :being_edited)
+    end
+
+    assert_empty broadcasts(being_edited_stream(users(:jz), @leaf)),
+      "readers must not be pushed who else is editing"
+  end
+
+  test "saving does not push who is editing to collaborators downgraded to readers" do
+    sign_in :david
+    books(:handbook).access_for(user: users(:kevin)).update! level: :reader
+
+    save_page
+
+    assert_empty broadcasts(being_edited_stream(users(:kevin), @leaf)),
+      "a downgraded collaborator with their editor left open must not be told who else is editing"
+    refute_empty broadcasts(being_edited_stream(users(:david), @leaf))
+  end
+
+  test "saving does not push who is editing to collaborators removed from the book" do
+    sign_in :david
+    books(:handbook).accesses.where(user_id: users(:kevin).id).delete_all
+
+    save_page
+
+    assert_empty broadcasts(being_edited_stream(users(:kevin), @leaf)),
+      "a removed collaborator with their editor left open must not be told who else is editing"
+    refute_empty broadcasts(being_edited_stream(users(:david), @leaf))
+  end
+
+  test "saving does not push who is editing onto the stream for the leaf itself" do
+    save_page
+
+    # Collaborators whose editor stays open after they lost access keep listening to the stream
+    # name they originally subscribed to, which is why nothing may ever be published onto it.
+    assert_empty broadcasts("#{@leaf.to_gid_param}:being_edited")
+  end
+
+  private
+    def save_page
+      perform_enqueued_jobs do
+        put book_page_path(books(:handbook), @leaf), params: { leaf: { title: "Renamed page" } }
+      end
+
+      assert_response :success
+    end
+
+    def being_edited_stream(user, leaf)
+      "#{user.to_gid_param}:#{leaf.to_gid_param}:being_edited"
+    end
+end
diff --git a/test/models/book/editors_test.rb b/test/models/book/editors_test.rb
new file mode 100644
index 0000000..cb8419a
--- /dev/null
+++ b/test/models/book/editors_test.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+
+class Book::EditorsTest < ActiveSupport::TestCase
+  test "editors are the users granted editor level access plus administrators" do
+    assert_equal %w[ David Jason ], books(:manual).editors.order(:name).map(&:name)
+  end
+
+  test "editors excludes readers and collaborators without access" do
+    books(:handbook).accesses.update_all level: Access.levels[:reader]
+
+    assert_equal %w[ David Jason ], books(:handbook).editors.order(:name).map(&:name)
+  end
+
+  test "editors includes administrators that were never given access to the book" do
+    books(:handbook).accesses.where(level: Access.levels[:editor]).delete_all
+
+    assert_includes books(:handbook).editors, users(:jason)
+    assert_not_includes books(:handbook).editors, users(:jz)
+  end
+end
