diff --git a/app/models/book/accessable.rb b/app/models/book/accessable.rb
index aa3dcf1..6e5506b 100644
--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -28,6 +28,17 @@ module Book::Accessable
     access_for(user: user)&.editor? || user&.administrator?
   end
 
+  # Everyone who may edit this book, either by access level or by administration.
+  #
+  # Editor-only payloads, like the indicator showing who is editing a page, are addressed to these
+  # users individually, so that they are never pushed onto a stream someone removed from the book
+  # can still be listening on.
+  def editors
+    editor_accesses = accesses.where(level: :editor)
+
+    User.active.where(id: editor_accesses.select(:user_id)).or(User.active.where(role: :administrator))
+  end
+
   def access_for(user: Current.user)
     accesses.find_by(user: user)
   end
