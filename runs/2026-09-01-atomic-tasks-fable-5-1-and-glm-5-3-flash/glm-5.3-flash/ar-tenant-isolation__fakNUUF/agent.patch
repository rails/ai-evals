diff --git a/app/models/concerns/tenancy.rb b/app/models/concerns/tenancy.rb
new file mode 100644
index 0000000..d9f07bc
--- /dev/null
+++ b/app/models/concerns/tenancy.rb
@@ -0,0 +1,29 @@
+# Tenants carve one install up between several customers.
+#
+# A row that carries a tenant belongs exclusively to that tenant. Rows without
+# one predate tenants, and nothing about them changes: they keep behaving as if
+# there were no tenants at all.
+module Tenancy
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+  end
+
+  class_methods do
+    # The rows living together with +record+: its own tenant's rows, plus every
+    # row that carries no tenant at all.
+    #
+    #   Book.within_tenants_of(Current.user) # => their tenant's books
+    #   User.within_tenants_of(book)         # => the book's fellow tenant members
+    def within_tenants_of(record)
+      tenant_id = record&.tenant_id.presence
+
+      if tenant_id
+        where(tenant_id: [ tenant_id, nil ])
+      else
+        where(tenant_id: nil)
+      end
+    end
+  end
+end
