diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
index 153d542..0266300 100644
--- a/app/controllers/searches_controller.rb
+++ b/app/controllers/searches_controller.rb
@@ -3,6 +3,9 @@ class SearchesController < ApplicationController
 
   RESULT_LIMIT = 50
 
+  # Backslash escapes the wildcards below, see like_term.
+  LIKE_ESCAPE_CHARACTER = "\\"
+
   def show
     @query = params[:q].to_s.strip
     @leaves = @query.present? ? matching_leaves : Leaf.none
@@ -10,13 +13,23 @@ class SearchesController < ApplicationController
 
   private
     def matching_leaves
-      Leaf.active.joins(:book)
-        .where("books.id in (#{readable_book_ids.join(",")}) and leaves.title like '%#{@query}%'")
+      readable_leaves
+        .where("leaves.title like ? escape ?", like_term(@query), LIKE_ESCAPE_CHARACTER)
         .order("books.title", "leaves.position_score")
         .limit(RESULT_LIMIT)
     end
 
-    def readable_book_ids
-      Book.accessable_or_published.ids.presence || [ 0 ]
+    # Whatever is typed is data, never part of the query: results are limited to
+    # leaves of books the current visitor may read, and both the term and its
+    # wildcards are passed as bound parameters.
+    def readable_leaves
+      Leaf.active.joins(:book)
+        .where(book_id: Book.accessable_or_published.select(:id))
+    end
+
+    # Treat "%" and "_" as literal characters by escaping them, so a term keeps
+    # matching itself instead of matching everything else.
+    def like_term(term)
+      "%#{Leaf.sanitize_sql_like(term)}%"
     end
 end
