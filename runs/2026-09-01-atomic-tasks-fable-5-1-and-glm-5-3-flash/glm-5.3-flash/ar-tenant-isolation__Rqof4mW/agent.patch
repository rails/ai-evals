diff --git a/test/integration/tenancy_test.rb b/test/integration/tenancy_test.rb
new file mode 100644
index 0000000..5c71f8a
--- /dev/null
+++ b/test/integration/tenancy_test.rb
@@ -0,0 +1,152 @@
+require "test_helper"
+
+class TenancyTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme = Tenant.create!(name: "Acme")
+    @globex = Tenant.create!(name: "Globex")
+
+    @acme_user = User.create!(name: "Ada", email_address: "ada@acme.example.com", password: "secret123456", tenant: @acme)
+    @globex_user = User.create!(name: "Gus", email_address: "gus@globex.example.com", password: "secret123456", tenant: @globex)
+
+    @acme_book = books(:handbook).tap { it.update! tenant: @acme, everyone_access: false }
+    @acme_book.update_access editors: [ @acme_user.id ], readers: []
+
+    @globex_book = books(:manual).tap { it.update! tenant: @globex, everyone_access: false }
+    @globex_book.update_access editors: [ @globex_user.id ], readers: []
+
+    @globex_page = @globex_book.press Page.new(body: "Globex page"), title: "Globex Page"
+    @globex_page.edit leafable_params: { body: "Revised Globex page" }
+
+    @acme_page = @acme_book.press Page.new(body: "Acme page"), title: "Acme Page"
+  end
+
+  test "new books land in their creator's tenant" do
+    sign_in @acme_user
+    post books_url, params: { book: { title: "Fresh Book", everyone_access: false } }
+
+    assert_equal @acme.id, Book.last.tenant_id
+  end
+
+  test "library lists own tenant's books but not another tenant's" do
+    sign_in @acme_user
+    get root_url
+
+    assert_response :success
+    assert_in_body "Handbook"
+    assert_not_in_body "Manual"
+  end
+
+  test "library hides another tenant's book even when it is published" do
+    @globex_book.update! published: true
+
+    sign_in @acme_user
+    get root_url
+
+    assert_response :success
+    assert_not_in_body "Manual"
+  end
+
+  test "signed out visitors still see every published book" do
+    @globex_book.update! published: true
+    @acme_book.update! published: true
+
+    get root_url
+
+    assert_response :success
+    assert_in_body "Handbook"
+    assert_in_body "Manual"
+  end
+
+  test "another tenant's book answers 404 even while holding an access row" do
+    Access.create! user: @acme_user, book: @globex_book, level: :reader
+
+    sign_in @acme_user
+    assert_no_way_in_to @globex_book, leaf: @globex_page
+
+    get page_edit_path(@globex_page, @globex_page.edits.last)
+    assert_response :not_found
+
+    get page_edit_path(@globex_page, "latest")
+    assert_response :not_found
+  end
+
+  test "a published book from another tenant answers 404 too" do
+    @globex_book.update! published: true
+
+    sign_in @acme_user
+    assert_no_way_in_to @globex_book, leaf: @globex_page
+  end
+
+  test "stays signed in while poking around another tenant's books" do
+    sign_in @acme_user
+
+    get book_slug_path(@globex_book)
+    assert_response :not_found
+
+    assert cookies[:session_token].present?
+
+    get root_url
+    assert_response :success
+    assert_in_body "Handbook"
+  end
+
+  test "everything keeps working within a tenant" do
+    sign_in @acme_user
+
+    get book_slug_path(@acme_book)
+    assert_response :success
+    assert_in_body "Acme Page"
+
+    @acme_page.edit leafable_params: { body: "Revised Acme page" }
+
+    get page_edit_path(@acme_page, "latest")
+    assert_response :success
+    assert_in_body "Revised Acme page"
+
+    @acme_book.update! everyone_access: true
+    @acme_book.update_access editors: [], readers: []
+    assert @acme_book.accessable?(user: @acme_user)
+
+    newcomer = User.create!(name: "New", email_address: "new@acme.example.com", password: "secret123456", tenant: @acme)
+    assert @acme_book.accessable?(user: newcomer)
+    assert newcomer.accesses.exists?(book: @acme_book)
+  end
+
+  test "users page still names everyone on the install" do
+    sign_in @acme_user
+    get users_url
+
+    assert_response :success
+    assert_in_body "Ada"
+    assert_in_body "Gus"
+  end
+
+  private
+    def assert_no_way_in_to(book, leaf: nil)
+      get book_slug_path(book)
+      assert_response :not_found
+
+      get edit_book_path(book)
+      assert_response :not_found
+
+      get edit_book_publication_path(book)
+      assert_response :not_found
+
+      post book_search_path(book), params: { search: "page" }
+      assert_response :not_found
+
+      get book_bookmark_path(book)
+      assert_response :not_found
+
+      if leaf
+        get leafable_slug_path(leaf)
+        assert_response :not_found
+
+        get edit_book_page_path(book, leaf)
+        assert_response :not_found
+
+        delete book_page_path(book, leaf)
+        assert_response :not_found
+      end
+    end
+end
