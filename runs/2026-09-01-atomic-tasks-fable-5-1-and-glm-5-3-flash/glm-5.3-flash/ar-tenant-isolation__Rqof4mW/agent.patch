index 0000000..2da0f3b
--- /dev/null
+++ b/db/migrate/20250601120000_create_tenants.rb
@@ -0,0 +1,45 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants, force: :cascade do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_column :users, :tenant_id, :integer
+    add_column :books, :tenant_id, :integer
+    add_index :users, :tenant_id
+    add_index :books, :tenant_id
+
+    add_foreign_key :users, :tenants
+    add_foreign_key :books, :tenants
+
+    reversible do |direction|
+      direction.up do
+        sweep_existing_records_into_one_tenant
+      end
+    end
+  end
+
+  private
+    # Running installs upgrade in place: every user and book that exists before
+    # tenancy ends up together in a single tenant.
+    def sweep_existing_records_into_one_tenant
+      tenant_id = insert_swept_tenant
+
+      execute "UPDATE users SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+      execute "UPDATE books SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+    end
+
+    def insert_swept_tenant
+      execute <<~SQL.squish
+        INSERT INTO tenants (name, created_at, updated_at)
+        VALUES (#{quote(swept_tenant_name)}, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
+      SQL
+
+      select_value("SELECT id FROM tenants ORDER BY id DESC LIMIT 1").to_i
+    end
+
+    def swept_tenant_name
+      select_value("SELECT name FROM accounts ORDER BY id LIMIT 1").presence || "Writebook"
+    end
+end
