diff --git a/app/models/concerns/tenanted.rb b/app/models/concerns/tenanted.rb
new file mode 100644
index 0000000..8189b52
--- /dev/null
+++ b/app/models/concerns/tenanted.rb
@@ -0,0 +1,22 @@
+module Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+  end
+
+  class_methods do
+    # Records that a given tenant can reach: its own, plus records that aren't
+    # part of any tenant. Records without a tenant predate tenancy and stay
+    # shared with everyone, just like before tenancy existed.
+    def shared_with(tenant)
+      tenant ? where(tenant_id: [ tenant.id, nil ]) : all
+    end
+  end
+
+  # Whether this record lives within reach of the given one: tenants can only
+  # see each other when they're the same, or when either side has no tenant.
+  def shared_tenant_with?(other)
+    tenant.nil? || other.nil? || other.tenant.nil? || other.tenant == tenant
+  end
+end
