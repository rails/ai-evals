@@ -0,0 +1,59 @@
+require "test_helper"
+
+class TenantScopingTest < ActiveSupport::TestCase
+  setup do
+    @acme = Tenant.create!(name: "Acme")
+    @globex = Tenant.create!(name: "Globex")
+
+    @acme_user = User.create!(name: "Ada", email_address: "ada@acme.example.com", password: "secret123456", tenant: @acme)
+    @globex_user = User.create!(name: "Gus", email_address: "gus@globex.example.com", password: "secret123456", tenant: @globex)
+
+    @acme_book = Book.create!(title: "Acme Book", tenant: @acme, everyone_access: true)
+    @acme_book.update_access editors: [ @acme_user.id ], readers: []
+    @acme_leaf = @acme_book.press Page.new(body: "Public to us"), title: "Acme Page"
+
+    @globex_book = Book.create!(title: "Globex Book", tenant: @globex, published: true, everyone_access: false)
+    @globex_leaf = @globex_book.press Page.new(body: "Secret"), title: "Globex Page"
+
+    Access.create! user: @acme_user, book: @globex_book, level: :reader
+  end
+
+  test "records without a tenant behave as they did before tenancy" do
+    assert_nil users(:david).tenant
+    assert_nil books(:handbook).tenant
+    assert_includes Book.accessable_or_published_books(user: users(:kevin)), books(:handbook)
+  end
+
+  test "a tenant reaches its own books and pages, and nothing else" do
+    reach = Book.accessable_or_published_books(user: @acme_user)
+
+    assert_includes reach, @acme_book
+    assert_includes @acme_user.accessable_leaves, @acme_leaf
+
+    assert_not_includes reach, @globex_book
+    assert_not_includes @acme_user.accessable_leaves, @globex_leaf
+  end
+
+  test "an access row doesn't open another tenant's book" do
+    assert @acme_user.accesses.exists?(book: @globex_book)
+
+    assert_not @globex_book.accessable?(user: @acme_user)
+    assert_not @globex_book.editable?(user: @acme_user)
+  end
+
+  test "sharing with everyone only sprays rows inside the tenant" do
+    @acme_book.update_access editors: [], readers: []
+
+    assert @acme_book.accessable?(user: @acme_user)
+    assert_not @acme_book.editable?(user: @acme_user)
+
+    assert_empty @globex_user.accesses.where(book: @acme_book)
+    assert_not @acme_book.editable?(user: @globex_user)
+  end
+
+  test "new books land in their creator's tenant" do
+    Current.with(user: @acme_user) do
+      assert_equal @acme.id, Book.create!(title: "Acme New Book").tenant_id
+    end
+  end
+end
