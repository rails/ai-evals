diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..02bb247
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Imported", everyone_access: false)
+    @roster = 20.times.map { |index|
+      User.create!(name: "Roster #{index}", email_address: "roster-#{index}-#{SecureRandom.hex(4)}@example.com", password: "secret123456")
+    }
+  end
+
+  test "grants every person on the roster and lets each know" do
+    result = nil
+
+    assert_enqueued_jobs 4, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, sheet(0, 1, 2, 3)).import
+    end
+
+    assert_equal 4, result.accesses.size
+    assert_nil result.duplicate_index
+    assert_equal [ @roster[0].id, @roster[1].id, @roster[2].id, @roster[3].id ], result.accesses.map(&:user_id)
+    assert result.accesses.all?(&:persisted?)
+    assert result.accesses.all?(&:reader?)
+  end
+
+  test "a rejected roster notifies nobody" do
+    [ sheet(0, { user_id: nil, level: "reader" }, 1),
+      sheet(0, 1, { user_id: @roster[9].id, level: "unheard-of" }, 2),
+      sheet(0, { user_id: @roster[0].id }) ].each do |rows|
+      result = Book::AccessImport.new(@book, rows).import
+
+      assert_equal [], result.accesses
+      assert_no_enqueued_jobs
+    end
+    assert_empty @book.accesses.reload
+  end
+
+  test "points at the row that turned the roster down" do
+    @book.accesses.create!(user: @roster[4], level: :reader)
+
+    results = [ Book::AccessImport.new(@book, sheet(0, 1, 2, { user_id: @roster[4].id, level: "editor" })).import,
+                Book::AccessImport.new(@book, sheet(0, 1, 0)).import,
+                Book::AccessImport.new(@book, sheet(0, 1, { user_id: @roster[9].id, level: "owner" }, 2)).import,
+                Book::AccessImport.new(@book, sheet(0, { user_id: nil, level: "reader" }, 1)).import ]
+
+    assert_equal [ 3, 2, 2, 1 ], results.map(&:duplicate_index)
+  end
+
+  test "an empty roster is a no-op" do
+    result = Book::AccessImport.new(@book, []).import
+
+    assert_equal [], result.accesses
+    assert_nil result.duplicate_index
+  end
+
+  test "a long roster costs what a short one does, taken or turned down" do
+    taken_short_queries = import_queries { Book::AccessImport.new(@book, sheet(*(0..3))).import }
+    @book.accesses.delete_all
+    taken_long_queries = import_queries { Book::AccessImport.new(@book, sheet(*(0..15))).import }
+    @book.accesses.delete_all
+
+    rejected_short_queries = import_queries { Book::AccessImport.new(@book, sheet({ user_id: @roster[18].id, level: "unheard-of" })).import }
+    rejected_long_queries = import_queries { Book::AccessImport.new(@book, sheet(*((0..14).to_a), { user_id: @roster[19].id, level: "unheard-of" })).import }
+
+    assert_equal taken_short_queries, taken_long_queries
+    assert_equal rejected_short_queries, rejected_long_queries
+  end
+
+  private
+    def sheet(*rows)
+      rows.map do |row|
+        row.is_a?(Hash) ? row : { user_id: @roster[row].id, level: "reader" }
+      end
+    end
+
+    def import_queries(&block)
+      queries = []
+      record = ->(*, payload) {
+        sql = payload[:sql].downcase
+        queries << sql unless sql.start_with?("pragma") || sql.include?("sqlite_master")
+      }
+
+      ActiveSupport::Notifications.subscribed(record, "sql.active_record", &block)
+
+      queries.count("insert into") # reads may still scale, writes must not
+    end
+end
