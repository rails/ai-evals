--- /dev/null
+++ b/lib/tasks/writebook.rake
@@ -0,0 +1,6 @@
+namespace :writebook do
+  desc "Erase people left behind by versions that deactivated instead of erased them"
+  task erase_deactivated_people: :environment do
+    User.inactive.order(:id).each(&:erase)
+  end
+end
