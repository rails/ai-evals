diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..fbdb07e 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -1,12 +1,36 @@
 module Book::Announceable
   extend ActiveSupport::Concern
 
+  # A book going live is announced exactly once, whatever its sitting did besides.
+  #
+  # A sitting saves everything together within a single transaction: taking the
+  # book live can come along with pressing pages or moving them around. Those other
+  # writes reload the book and wipe its change history long before the commit
+  # callbacks run, so deciding about the announcement there misses publications.
+  # Instead we make up our minds at save time, while the changes are still known,
+  # and hold on to them until the sitting commits. Should it roll back instead,
+  # nothing gets announced and the book stays a draft.
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_save          :track_publication,    if: -> { published_previously_changed? }
+    after_update_commit :announce_publication, if: :publication_tracked?
+    after_rollback      :forget_publication
   end
 
   private
+    def track_publication
+      @publication_tracked = published? && !published_before_last_save
+    end
+
+    def publication_tracked?
+      @publication_tracked == true
+    end
+
+    def forget_publication
+      @publication_tracked = nil
+    end
+
     def announce_publication
+      forget_publication
       AnnouncePublicationJob.perform_later self
     end
 end
