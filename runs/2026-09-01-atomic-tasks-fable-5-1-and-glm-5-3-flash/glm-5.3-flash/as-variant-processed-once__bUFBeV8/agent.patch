diff --git a/lib/rails_ext/active_storage_variation.rb b/lib/rails_ext/active_storage_variation.rb
new file mode 100644
index 0000000..53284b3
--- /dev/null
+++ b/lib/rails_ext/active_storage_variation.rb
@@ -0,0 +1,45 @@
+# Variants identify themselves by hashing their transformations
+# (<tt>ActiveStorage::Variation#digest</tt>), so two variations that mean the same thing
+# count as two different variants. A named variant's transformations show up in two
+# different shapes:
+#
+#   * as declared, in the background work that processes an upload (+process: :later+), and
+#   * round-tripped through the signed representation URL of every request that fetches the
+#     image afterwards.
+#
+# Signed messages travel as JSON, and Symbols don't survive that. Once an upload had been
+# processed, every request for its derived image therefore hashed its variation
+# differently, converted the image again, and kept a second copy of it in storage next to
+# the first.
+#
+# Send variations through that very serialization when they are built, so background work
+# and requests see them as they see each other. Equal variations then hash into one
+# identity, and an upload gets derived once -- by whichever comes first. Sorting keys keeps
+# spellings that only differ in key order from splitting like this too.
+module ActiveStorage
+  module CanonicalVariations
+    def initialize(transformations)
+      super canonicalized(transformations)
+    end
+
+    private
+      def canonicalized(transformations)
+        return transformations unless transformations.is_a?(Hash)
+
+        as_signed_messages_will_send(transformations).deep_symbolize_keys
+          .sort_by { |key, _value| key.to_s }.to_h
+      rescue StandardError
+        # Transformations that can't survive JSON aren't carried by signed messages either,
+        # so their declared form already is the only form there is.
+        transformations.deep_symbolize_keys
+      end
+
+      def as_signed_messages_will_send(transformations)
+        ActiveSupport::JSON.decode ActiveSupport::JSON.encode(transformations)
+      end
+  end
+end
+
+ActiveSupport.on_load :active_storage_blob do
+  ActiveStorage::Variation.prepend ActiveStorage::CanonicalVariations
+end
diff --git a/test/integration/picture_derivation_test.rb b/test/integration/picture_derivation_test.rb
new file mode 100644
index 0000000..0f4670a
--- /dev/null
+++ b/test/integration/picture_derivation_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+require "active_job/test_helper"
+
+class PictureDerivationTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+    @picture = pictures(:reading)
+  end
+
+  test "an upload gets derived exactly once" do
+    store_uploaded_picture_with_background_work_running
+
+    assert_equal 1, derivatives.count
+
+    assert_no_changes -> { derivatives.map(&:variation_digest) } do
+      2.times { fetch_picture_from_book_page }
+    end
+  end
+
+  test "readers are served the derived copy" do
+    store_uploaded_picture_with_background_work_running
+
+    served = fetch_picture_from_book_page
+
+    assert_equal derivatives.first.image.blob.download.bytesize, served.bytesize
+    assert_operator served.bytesize, :<, @picture.image.blob.byte_size
+  end
+
+  test "a reader arriving before the background work does not leave a second copy" do
+    @picture.update! image: fixture_file_upload("white-rabbit.webp", "image/webp")
+
+    read_before_the_queue = fetch_picture_from_book_page
+
+    perform_enqueued_jobs # the background work catches up afterwards
+
+    assert_equal 1, derivatives.count
+    assert_equal read_before_the_queue, derivatives.first.image.blob.download
+  end
+
+  private
+    def store_uploaded_picture_with_background_work_running
+      perform_enqueued_jobs do
+        @picture.update! image: fixture_file_upload("white-rabbit.webp", "image/webp")
+      end
+    end
+
+    def derivatives
+      @picture.image.blob.reload.variant_records.includes(image_attachment: :blob).select do |record|
+        record.image.attached?
+      end
+    end
+
+    # Opens the book page the way a reader would and fetches the picture it links to.
+    def fetch_picture_from_book_page
+      get leafable_slug_path(leaves(:reading_picture))
+      assert_response :ok
+
+      source = response.body[/src="([^"]*representations\/redirect[^"]*)"/, 1]
+      assert_not_nil source, "expected the picture page to link to a representation of the image"
+
+      get source.sub("http://www.example.com", "")
+      while response.redirect?
+        get response.headers["Location"]
+      end
+      assert_response :ok
+
+      response.body
+    end
+end
diff --git a/test/lib/active_storage_variation_test.rb b/test/lib/active_storage_variation_test.rb
new file mode 100644
index 0000000..1952f0e
--- /dev/null
+++ b/test/lib/active_storage_variation_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class ActiveStorageVariationTest < ActiveSupport::TestCase
+  test "declared variations keep their identity on the way through a signed message" do
+    variation = ActiveStorage::Variation.new resize_to_limit: [ 1500, 1500 ], format: :webp
+
+    signed = ActiveStorage.verifier.generate variation.transformations, purpose: :variation
+    round_tripped = ActiveStorage::Variation.new ActiveStorage.verifier.verify(signed, purpose: :variation)
+
+    assert_equal variation.digest, round_tripped.digest
+  end
+
+  test "variations spelled differently mean the same thing" do
+    declared = ActiveStorage::Variation.new resize_to_limit: [ 1500, 1500 ], format: :webp
+    reordered = ActiveStorage::Variation.new format: "webp", resize_to_limit: [ 1500, 1500 ]
+
+    assert_equal declared.digest, reordered.digest
+    assert_equal [ 1500, 1500 ], declared.transformations[:resize_to_limit]
+    assert_equal "webp", declared.transformations[:format]
+  end
+end
