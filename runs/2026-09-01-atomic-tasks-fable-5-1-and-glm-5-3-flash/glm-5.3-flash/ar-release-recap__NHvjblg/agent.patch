@@ -1,7 +1,17 @@
 class ReleaseMarker
-  def self.for(book_id)
-    book = Book.drafts.find_by(id: book_id)
-    new(book) if book
+  # Accepts either a loaded Book or one of its ids.
+  #
+  # A loaded Book must be reused as-is instead of being looked up again:
+  # publishing through a second copy of the record would run that copy's
+  # callbacks against attributes read before the release changed them,
+  # e.g. caching a recap under its working title.
+  def self.for(book_or_id)
+    book = case book_or_id
+    when Book then book_or_id
+    else Book.drafts.find_by(id: book_or_id)
+    end
+
+    new(book) if book && !book.published?
   end
 
   def initialize(book)
