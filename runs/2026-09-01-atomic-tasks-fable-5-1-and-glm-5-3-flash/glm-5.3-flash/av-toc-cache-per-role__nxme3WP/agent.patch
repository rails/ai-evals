diff --git a/test/controllers/book_toc_caching_test.rb b/test/controllers/book_toc_caching_test.rb
new file mode 100644
index 0000000..4795a73
--- /dev/null
+++ b/test/controllers/book_toc_caching_test.rb
@@ -0,0 +1,148 @@
+require "test_helper"
+
+class BookTocCachingTest < ActionDispatch::IntegrationTest
+  # The table of contents and its entries are fragment cached in production, so these
+  # tests run with view caching enabled as well. Without it nobody would ever receive
+  # somebody else's cached table of contents.
+  setup do
+    enable_view_caching
+  end
+
+  teardown do
+    disable_view_caching
+  end
+
+  test "somebody who may only read a book never receives editor controls, whoever opened it before them" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_editor_controls
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_read_only_toc
+  end
+
+  test "somebody who may edit a book always receives editor controls, whoever opened it before them" do
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_read_only_toc
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_editor_controls
+  end
+
+  test "a reader turned into an editor picks up the editor controls" do
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_read_only_toc
+
+    books(:handbook).update_access(editors: [ users(:jz).id ], readers: [])
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_editor_controls
+  end
+
+  test "an editor stripped of their rights loses the editor controls" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_editor_controls
+
+    users(:kevin).accesses.find_by(book: books(:handbook)).update!(level: :reader)
+
+    get book_slug_path(books(:handbook))
+
+    assert_read_only_toc
+  end
+
+  test "an anonymous visitor never receives editor controls either" do
+    books(:handbook).update!(published: true)
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_editor_controls
+
+    sign_out
+    get book_slug_path(books(:handbook))
+
+    assert_read_only_toc
+  end
+
+  test "an entry renamed keeps showing its new title to whoever comes next" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    leaves(:summary_page).update! title: "Epilogue"
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_response :success
+    assert_select ".toc__leaf .toc__title", text: "Epilogue"
+  end
+
+  test "whether the current person may edit the book is resolved once, not once per entry" do
+    sign_in :kevin
+
+    accesses_queries = []
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |event|
+      if event.payload[:sql].match?(/FROM ["`]accesses["`]/)
+        accesses_queries << event.payload[:sql]
+      end
+    end
+
+    begin
+      get book_slug_path(books(:handbook))
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+
+    assert_response :success
+    assert_editor_controls
+    assert_equal 1, accesses_queries.length
+  end
+
+  private
+    def enable_view_caching(controller = BooksController)
+      @store = ActiveSupport::Cache::MemoryStore.new
+
+      @perform_caching = controller.perform_caching
+      @collection_cache = ActionView::PartialRenderer.collection_cache
+
+      controller.perform_caching = true
+      controller.cache_store = @store
+      ActionView::PartialRenderer.collection_cache = @store
+      @store.clear
+    end
+
+    def disable_view_caching(controller = BooksController)
+      controller.perform_caching = @perform_caching
+      controller.cache_store = ActiveSupport::Cache::NullStore.new
+      ActionView::PartialRenderer.collection_cache = @collection_cache
+    end
+
+    def assert_read_only_toc
+      assert_response :success
+
+      assert_select ".toc__leaf", minimum: 1
+      assert_select "a[href$='/edit']", count: 0
+      assert_select ".toc__blank-slate", count: 0
+    end
+
+    def assert_editor_controls
+      assert_response :success
+
+      assert_select "a[href$='/edit']", minimum: 1
+      assert_select ".toc__blank-slate"
+      assert_select "[data-arrangement-url-value]"
+    end
+end
