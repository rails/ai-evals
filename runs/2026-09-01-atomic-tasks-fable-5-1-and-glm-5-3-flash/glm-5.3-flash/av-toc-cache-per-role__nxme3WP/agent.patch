 module BooksHelper
+  # The table of contents renders differently depending on whether the current person
+  # may edit the book or not. That makes editability part of every fragment cache key
+  # of the table, so it is resolved once per book and person and reused by all entries:
+  # deriving it per entry would query access one time too many.
+  def toc_editable?(book)
+    (@toc_editabilities ||= {})[[ book.id, Current.user&.id ]] ||= book.editable?
+  end
+
+  # Shared key for all the fragments of a table of contents entry. The collection render
+  # and the entry partial have to agree on it, or a fragment cached for an editor would
+  # be served to somebody who may only read the book (and vice versa).
+  def toc_leaf_cache_key(leaf)
+    [ leaf, leaf.book, toc_editable?(leaf.book) ]
+  end
+
   def book_toc_tag(book, &)
     tag.ol class: "toc", tabindex: 0,
       data: {
