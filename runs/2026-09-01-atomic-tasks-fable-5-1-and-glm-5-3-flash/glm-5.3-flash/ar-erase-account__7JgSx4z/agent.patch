@@ -14,6 +14,15 @@ module Leaf::Searchable
       all.map &:reindex
     end
 
+    # Removes entries straight from the index, without touching the leaves they
+    # belong to. Handy when records are erased in bulk and we can't count on the
+    # destroy callbacks of each one of them having run.
+    def discard_from_search_index(rowids)
+      if rowids.present?
+        connection.execute sanitize_sql([ "delete from leaf_search_index where rowid in (?)", rowids ])
+      end
+    end
+
     def sanitize_query_syntax(terms)
       terms = terms.to_s
       terms = remove_invalid_search_characters(terms)
