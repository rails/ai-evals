@@ -1,6 +1,9 @@
 class User < ApplicationRecord
   include Authoring, Role, Transferable
 
+  DEACTIVATED_EMAIL_ADDRESS_PATTERN = /-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@/i
+  DELETED_AUTHOR_BYLINE = "Deleted author"
+
   has_many :sessions, dependent: :destroy
   has_secure_password validations: false
 
@@ -11,26 +14,94 @@ class User < ApplicationRecord
   after_create :grant_access_to_everyone_books
 
   scope :active, -> { where(active: true) }
+  scope :inactive, -> { where(active: false) }
   scope :ordered, -> { order(:name) }
 
   def current?
     self == Current.user
   end
 
-  def deactivate
+  # Erases the person and everything we hold on to for them: their account,
+  # their accesses, their reading marks and their sign-in log. Nothing is left.
+  #
+  # One exception: books they created that are shared with everyone stay up,
+  # since people are reading those. They're kept without any trace of who made
+  # them, bylined as being written by a deleted author.
+  def erase
     transaction do
-      sessions.delete_all
-      update! active: false, email_address: deactived_email_address
+      erase_books_they_created_exclusively
+      take_name_off_books_shared_with_everyone
+      sessions.destroy_all    # logs their final sign out
+      accesses.delete_all
+      ReadingMark.where(user_id: id).delete_all
+      erase_sign_in_events    # after the sessions, so the final sign out counts too
+      destroy!
     end
+
+    self
   end
 
-  private
-    def deactived_email_address
-      email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
-    end
+  # Removing someone used to merely deactivate them, which is not what Remove
+  # promises. Whatever calls this today wants a real erasure.
+  def deactivate
+    erase
+  end
 
+  private
     def grant_access_to_everyone_books
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
     end
+
+    def erase_books_they_created_exclusively
+      leaf_ids = Leaf.where(book_id: book_ids_created_privately).ids
+
+      Book.where(id: book_ids_created_privately).destroy_all
+      Leaf.discard_from_search_index(leaf_ids)     # don't leave stale hits behind
+    end
+
+    def book_ids_created_privately
+      created_books.where.not(everyone_access: true).ids
+    end
+
+    def take_name_off_books_shared_with_everyone
+      created_books.with_everyone_access.each do |book|
+        # A plain `update!` would hand these books straight back to whoever
+        # happens to be signed in, since books fall back to being owned by the
+        # person editing them. Clear the creator out without touching that.
+        book.creator_id = nil
+        book.author     = DELETED_AUTHOR_BYLINE
+        book.save!(validate: false)
+      end
+    end
+
+    def erase_sign_in_events
+      SignInEvent.where(email_address: email_addresses_signed_in_with).delete_all
+    end
+
+    # Sign-in events were only recorded against the address used to sign in,
+    # which for someone deactivated the old way is the address their rewritten
+    # one was derived from.
+    def email_addresses_signed_in_with
+      [ email_address, original_email_address ].compact_blank.uniq.flat_map { |address|
+        [ address, *deactivated_sign_in_addresses_for(address) ]
+      }.uniq
+    end
+
+    def original_email_address
+      return if email_address.blank?
+
+      email_address.gsub(DEACTIVATED_EMAIL_ADDRESS_PATTERN, "@")
+    end
+
+    def deactivated_sign_in_addresses_for(address)
+      local_part, separator, domain = address.rpartition("@")
+      return [] unless separator.present? && local_part.present? && domain.present?
+
+      pattern = /\A#{Regexp.escape(local_part)}-deactivated-\h{8}-\h{4}-\h{4}-\h{4}-\h{12}@#{Regexp.escape(domain)}\z/i
+
+      SignInEvent.select(:email_address).distinct.filter_map do |event|
+        event.email_address if event.email_address.match?(pattern)
+      end
+    end
 end
