diff --git a/test/integration/page_upload_lifecycle_test.rb b/test/integration/page_upload_lifecycle_test.rb
new file mode 100644
index 0000000..4e19607
--- /dev/null
+++ b/test/integration/page_upload_lifecycle_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class PageUploadLifecycleTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+    @page = pages(:welcome)
+  end
+
+  test "uploading, serving, then destroying leaves nothing behind" do
+    post action_text_markdown_uploads_url, params: {
+      record_gid: @page.to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+
+    assert_response :created
+
+    file_url = JSON.parse(response.body)["fileUrl"]
+    assert_not_empty file_url
+
+    get file_url
+    assert_response :redirect
+
+    attachment = ActiveStorage::Attachment.find_by!(slug: file_url.sub("/u/", ""))
+    blob = attachment.blob
+    key = blob.key
+    assert File.exist?(ActiveStorage::Blob.service.path_for(key))
+
+    # The content page renders the uploaded image inline.
+    @page.update!(body: "#{@page.body.content}\n\n![Reading](#{file_url})")
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_in_body file_url
+
+    @page.destroy!
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(ActiveStorage::Blob.service.path_for(key))
+
+    get action_text_markdown_upload_path(slug: attachment.slug)
+    assert_response :not_found
+  end
+end
diff --git a/test/models/page_uploads_test.rb b/test/models/page_uploads_test.rb
new file mode 100644
index 0000000..55337cb
--- /dev/null
+++ b/test/models/page_uploads_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class PageUploadsTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @page = pages(:welcome)
+    @page.body.uploads.attach io: file_fixture("reading.webp").open,
+      filename: "reading.webp", content_type: "image/webp"
+    @attachment = @page.body.uploads.attachments.last
+    @blob = @attachment.blob
+  end
+
+  test "destroying a page purges its embedded image uploads" do
+    key = @blob.key
+    assert File.exist?(ActiveStorage::Blob.service.path_for(key))
+    assert ActiveStorage::Attachment.exists?(@attachment.id)
+
+    @page.destroy!
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Attachment.exists?(@attachment.id), "attachment record survived"
+    assert_not ActiveStorage::Blob.exists?(@blob.id), "blob record survived"
+    assert_not File.exist?(ActiveStorage::Blob.service.path_for(key)), "file on disk survived"
+  end
+
+  test "destroying a leaf purges its embedded image uploads" do
+    key = @blob.key
+
+    leaves(:welcome_page).destroy!
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Blob.exists?(@blob.id), "blob record survived"
+    assert_not File.exist?(ActiveStorage::Blob.service.path_for(key)), "file on disk survived"
+  end
+
+  test "destroying one page keeps images embedded in another page's markdown" do
+    other = books(:handbook).press Page.new(body: "Another page"), title: "Another"
+    other_page = other.page
+    other_page.body.uploads.attach io: file_fixture("white-rabbit.webp").open,
+      filename: "white-rabbit.webp", content_type: "image/webp"
+    other_attachment = other_page.body.uploads.attachments.last
+    other_blob_id = other_attachment.blob_id
+
+    @page.destroy!
+    perform_enqueued_jobs
+
+    assert ActiveStorage::Blob.exists?(other_blob_id)
+    assert_equal other_attachment.slug, ActiveStorage::Attachment.find(other_attachment.id).slug
+  end
+end
