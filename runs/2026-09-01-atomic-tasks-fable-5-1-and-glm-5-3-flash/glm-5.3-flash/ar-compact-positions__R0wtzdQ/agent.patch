+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+    # Note that the creation order of these leaves differs from their arranged
+    # order, so a compaction that regresses to creation order is detectable.
+    @leaves = [ leaves(:welcome_section), leaves(:welcome_page), leaves(:summary_page), leaves(:reading_picture) ]
+  end
+
+  test "compacting keeps pages in their arranged order" do
+    spread_out_scores
+
+    @book.compact_positions!
+
+    assert_equal @leaves, @book.leaves.reload.positioned
+    assert_equal [ 1, 2, 3, 4 ], score_of(@leaves)
+  end
+
+  test "compacting pulls the scores back into a dense sequence" do
+    leaves(:welcome_section).update_column :position_score, -12.75
+    leaves(:summary_page).update_column :position_score, 2 ** 20
+
+    @book.compact_positions!
+
+    assert_equal [ 1, 4 ], score_of([ leaves(:welcome_section), leaves(:summary_page) ])
+  end
+
+  test "trashed pages are left out of nothing and don't get reordered" do
+    spread_out_scores
+    leaves(:summary_page).trashed!
+
+    @book.compact_positions!
+
+    assert_equal 3, @book.live_leaf_count
+    assert_equal leaves(:reading_picture), @book.leaves.reload.positioned.last
+  end
+
+  test "a page restored from the trash comes back in its place" do
+    spread_out_scores
+    leaves(:summary_page).trashed!
+    @book.compact_positions!
+
+    leaves(:summary_page).update! status: :active
+
+    assert_equal @leaves, @book.leaves.reload.positioned
+  end
+
+  test "live leaf count only counts pages not in the trash" do
+    assert_equal 4, @book.live_leaf_count
+
+    leaves(:summary_page).trashed!
+
+    assert_equal 3, @book.live_leaf_count
+  end
+
+  private
+    def spread_out_scores
+      @leaves.each.with_index { |leaf, index| leaf.update_column :position_score, (index + 1) * 100.0 + index }
+    end
+
+    def score_of(leaves)
+      leaves.map(&:reload).map(&:position_score)
+    end
+end
