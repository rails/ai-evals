--- a/app/models/picture.rb
+++ b/app/models/picture.rb
@@ -2,7 +2,11 @@ class Picture < ApplicationRecord
   include Leafable
 
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    # The format is given as a String on purpose. Transformations travel in signed URLs
+    # (JSON) where Symbols don't survive, so a Symbol here would make the copy created by
+    # the background job differ from the one readers request -- deriving the picture twice
+    # and keeping both copies in storage.
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
diff --git a/test/integration/picture_derivation_test.rb b/test/integration/picture_derivation_test.rb
new file mode 100644
index 0000000..f95dd80
--- /dev/null
+++ b/test/integration/picture_derivation_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class PictureDerivationTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+
+    @picture = Picture.new caption: "A photograph"
+    books(:handbook).press @picture, title: "Photograph"
+
+    @picture.image.attach io: file_fixture("reading.webp").open,
+                          filename: "editor-upload.webp", content_type: "image/webp"
+    @blob = @picture.image.blob.reload
+  end
+
+  test "the background work derives an upload once" do
+    assert_equal 1, stored_copies.count # only the original so far
+
+    run_background_work
+
+    assert_equal 2, stored_copies.count # the original and a single derived copy
+    assert_equal 1, @blob.variant_records.count
+  end
+
+  test "opening the book page serves the derived copy without deriving the picture again" do
+    run_background_work
+
+    source = linked_source_from_the_book_page
+    bytes_of_the_derived_copy = serve(source)
+
+    transformations = observe_transformations do
+      get leafable_slug_path(@picture.leaf)
+      assert_response :success
+
+      serve source
+      serve linked_source_from_the_book_page
+
+      assert_equal "image/webp", response.headers["Content-Type"]
+      assert_equal bytes_of_the_derived_copy, response.body
+    end
+
+    assert_empty transformations, "opening the book page should not process any pictures"
+
+    assert_equal 1, @blob.variant_records.reload.count
+    assert_equal 2, stored_copies.count
+  end
+
+  test "a reader that arrives before the background work does not leave behind a second copy" do
+    bytes_read_while_processing = serve(linked_source_from_the_book_page)
+
+    run_background_work
+
+    serve linked_source_from_the_book_page
+
+    assert_equal 1, @blob.variant_records.reload.count
+    assert_equal 2, stored_copies.count
+    assert_equal bytes_read_while_processing, response.body
+  end
+
+  private
+    def run_background_work
+      perform_enqueued_jobs while queue_adapter.enqueued_jobs.any?
+    end
+
+    def stored_copies
+      ActiveStorage::Blob.where(
+        id: [ @blob.id ] + @blob.variant_records.reload.filter_map { |record| record.image&.blob_id }
+      )
+    end
+
+    def linked_source_from_the_book_page
+      get leafable_slug_path(@picture.leaf.reload)
+      assert_response :success
+
+      css_select("img").map { |img| img[:src] }.find { |src| src.end_with?("editor-upload.webp") }.tap do |source|
+        assert source.present?, "Expected the book page to link to the picture"
+        assert_not source.include?("active_storage/blobs"), "Expected a link to a representation of the picture"
+      end
+    end
+
+    def serve(source)
+      get source
+      follow_redirect! while response.redirect?
+
+      assert_response :success
+      response.body
+    end
+
+    def observe_transformations
+      performed = []
+      subscription = ActiveSupport::Notifications.subscribe(/transform\.active_storage/) do |name, _start, _finish, _id, _payload|
+        performed << name
+      end
+
+      yield
+      performed
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscription)
+    end
+end
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..6bf313a 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -23,4 +23,14 @@ class PictureTest < ActiveSupport::TestCase
 
     assert_equal picture.image, picture.large_image
   end
+
+  test "the named variant survives being carried in a signed representation URL" do
+    picture = pictures(:reading)
+    variation = picture.large_image.variation
+
+    # Readers pass the transformations through a signed URL, which turns Symbols into Strings.
+    # Both have to name the same derivation, or the picture gets derived twice.
+    served_again = ActiveStorage::Variation.decode(variation.key).default_to({})
+    assert_equal variation.digest, served_again.digest
+  end
 end
