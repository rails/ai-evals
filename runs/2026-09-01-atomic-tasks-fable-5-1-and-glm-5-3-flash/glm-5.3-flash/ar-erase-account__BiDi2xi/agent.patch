diff --git a/app/models/leaf/searchable.rb b/app/models/leaf/searchable.rb
index d90c5c9..dc447e9 100644
--- a/app/models/leaf/searchable.rb
+++ b/app/models/leaf/searchable.rb
@@ -14,6 +14,20 @@ module Leaf::Searchable
       all.map &:reindex
     end
 
+    # Removes search index entries for all the leaves of the given books straight away instead of
+    # relying on the destroy callbacks, which only run once a transaction commits. Nothing may be
+    # left findable, not even transiently.
+    def remove_books_from_search_index(*books)
+      book_ids = books.flatten.compact.map { |book| book.respond_to?(:id) ? book.id : book }
+      return false if book_ids.empty?
+
+      quoted_ids = book_ids.map { |id| connection.quote(id) }.join(", ")
+      connection.execute \
+        "delete from leaf_search_index where rowid in (select id from leaves where book_id in (#{quoted_ids}))"
+
+      true
+    end
+
     def sanitize_query_syntax(terms)
       terms = terms.to_s
       terms = remove_invalid_search_characters(terms)
