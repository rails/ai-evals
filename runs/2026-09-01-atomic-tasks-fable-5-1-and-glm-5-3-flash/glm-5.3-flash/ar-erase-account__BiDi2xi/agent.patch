diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..a5d541a
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,167 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  setup do
+    @alice = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+
+    @everyone_book = Book.create!(title: "Alice's shared book", author: "Alice", creator: @alice,
+      everyone_access: true, published: true)
+    press_leaf @everyone_book, "Everyone can read this page"
+
+    @restricted_book = Book.create!(title: "Alice's restricted book", author: "Alice", creator: @alice,
+      everyone_access: false)
+    press_leaf @restricted_book, "Restricted musings nobody else may read"
+  end
+
+  test "erasing removes everything about the person" do
+    SignInEvent.create!(email_address: @alice.email_address, action: :signed_in)
+    @alice.sessions.create!
+    ReadingMark.create!(user: @alice, leaf: leaves(:welcome_page), last_read_at: Time.now)
+
+    assert_difference -> { User.count }, -1 do
+      @alice.erase
+    end
+
+    assert_not Book.exists?(@restricted_book.id), "their restricted books survive"
+    assert_equal 0, Leaf.where(book_id: @restricted_book.id).count, "their pages survive"
+    assert_equal 0, Session.where(user_id: @alice.id).count
+    assert_equal 0, Access.where(user_id: @alice.id).count
+    assert_equal 0, ReadingMark.where(user_id: @alice.id).count
+    assert_equal 0, SignInEvent.where(email_address: @alice.email_address).count
+  end
+
+  test "erasing removes any trace from the search index" do
+    erased_leaf_ids = @restricted_book.leaves.ids
+
+    assert_difference -> { search_index_rows }, -(erased_leaf_ids.size) do
+      @alice.erase
+    end
+
+    erased_leaf_ids.each do |id|
+      assert_equal [], Leaf.connection.execute("select rowid from leaf_search_index where rowid = #{id}"),
+        "a search index entry was left behind for leaf #{id}"
+    end
+
+    assert_empty Leaf.search("Restricted").to_a
+    assert_empty Leaf.search("musings").to_a
+  end
+
+  test "erasing keeps everyone books searchable" do
+    @alice.erase
+
+    assert_not_empty Leaf.search("Everyone").to_a
+  end
+
+  test "books created for everyone stay up, but without them as the author" do
+    assert_difference -> { Book.count }, -1 do
+      @alice.erase
+    end
+
+    assert_nothing_raised { @everyone_book.reload }
+    assert_equal "Deleted author", @everyone_book.author
+    assert_nil @everyone_book.creator_id
+    assert_not_includes @everyone_book.author, @alice.name
+  end
+
+  test "people left on the account keep reading books shared with everyone" do
+    reader = User.create!(name: "Ruth", email_address: "ruth@example.com", password: "secret123456")
+    Access.where(user: reader, book: @everyone_book).delete_all
+
+    @alice.erase
+
+    assert @everyone_book.reload.accessable?(user: User.find(reader.id))
+    assert_not_empty Access.where(book_id: @everyone_book.id, level: :reader)
+  end
+
+  test "books created by someone else are untouched" do
+    Access.create!(user: @alice, book: restricted_handbook, level: :reader)
+
+    @alice.erase
+
+    assert_nothing_raised { restricted_handbook.reload }
+    assert Book.where(id: [ books(:handbook).id, books(:manual).id ]).count == 2
+  end
+
+  test "accesses to other people's books are dropped" do
+    Access.create!(user: @alice, book: restricted_handbook, level: :editor)
+
+    @alice.erase
+
+    assert_equal 0, Access.where(user_id: @alice.id).count
+    assert_not_any_accesses_left_on reloaded_book
+  end
+
+  test "erasing an already deactivated account works" do
+    original_email = @alice.email_address
+    scrambled = original_email.sub("@", "-deactivated-#{SecureRandom.uuid}@")
+    deactivate_the_old_way(@alice, scrambled)
+
+    assert_difference -> { User.count }, -1 do
+      User.find(@alice.id).erase
+    end
+
+    assert_not Book.exists?(@restricted_book.id)
+    assert_equal "Deleted author", Book.find(@everyone_book.id).author
+    assert_equal 0, Session.where(user_id: @alice.id).count
+  end
+
+  test "sign in events recorded before deactivation are erased too" do
+    original_email = @alice.email_address
+    scrambled = original_email.sub("@", "-deactivated-#{SecureRandom.uuid}@")
+    deactivate_the_old_way(@alice, scrambled)
+
+    SignInEvent.create!(email_address: original_email, action: :signed_in)
+    SignInEvent.create!(email_address: original_email.upcase, action: :signed_out)
+    SignInEvent.create!(email_address: scrambled, action: :signed_in)
+
+    user = User.find(@alice.id)
+    assert_equal [ scrambled, original_email ], user.sign_in_email_addresses
+
+    user.erase
+
+    assert_equal 0, SignInEvent.where(email_address: [ original_email, original_email.upcase, scrambled ]).count
+  end
+
+  test "sign in events of other people survive" do
+    SignInEvent.create!(email_address: users(:kevin).email_address, action: :signed_in)
+    SignInEvent.create!(email_address: "alison@example.com", action: :signed_in)
+
+    @alice.erase
+
+    assert SignInEvent.exists?(email_address: users(:kevin).email_address)
+    assert SignInEvent.exists?(email_address: "alison@example.com")
+  end
+
+  private
+    def press_leaf(book, content)
+      page = Page.create!(body: "#{content} #{SecureRandom.uuid}")
+      leaf = book.press page, title: "#{book.title} page", status: :active
+      leaf.reindex # indexing normally happens on commit, which tests never reach
+    end
+
+    def restricted_handbook
+      @restricted_handbook ||= begin
+        other_author = users(:kevin)
+        Book.create!(title: "Kevin's book", creator: other_author, everyone_access: false).tap do |book|
+          Access.find_by(book: book, user: other_author)&.update(level: :editor) ||
+            Access.create!(user: other_author, book: book, level: :editor)
+        end
+      end
+    end
+
+    def reloaded_book
+      Book.find(restricted_handbook.id)
+    end
+
+    def assert_not_any_accesses_left_on(book)
+      assert_equal 0, Access.where(book_id: book.id, user_id: @alice.id).count
+    end
+
+    def search_index_rows
+      Leaf.connection.execute("select rowid from leaf_search_index").count
+    end
+
+    def deactivate_the_old_way(user, scrambled_address)
+      user.update_columns active: false, email_address: scrambled_address
+    end
+end
