 class User < ApplicationRecord
   include Authoring, Role, Transferable
 
+  # The byline given to books an erased person created that stay up for their readers.
+  ERASED_AUTHOR_BYLINE = "Deleted author"
+
+  # What removing somebody used to leave behind: alice@example.com became
+  # alice-deactivated-<uuid>@example.com
+  DEACTIVATED_EMAIL_ADDRESS_PATTERN =
+    /\A(?<local>.*)-deactivated-(?:\h{8}(?:-\h{4}){3}-\h{12})?(?<domain>@.*)\z/
+
   has_many :sessions, dependent: :destroy
   has_secure_password validations: false
 
@@ -17,16 +25,92 @@ class User < ApplicationRecord
     self == Current.user
   end
 
-  def deactivate
+  # Erases everything there is about this person from the account: their row, their sessions,
+  # accesses, reading marks and sign in events, along with every book they created that isn't
+  # shared with everyone. Books they created that are shared with everyone stay up, since people
+  # are reading those, just without them as the author.
+  #
+  # Works for accounts that were already removed the old way, deactivated with a rewritten address.
+  def erase
     transaction do
-      sessions.delete_all
-      update! active: false, email_address: deactived_email_address
+      # Bulk deletes rather than record destroys: no sign out events get recorded for somebody we're
+      # erasing, and no foreign keys get attempted to be nullified.
+      Session.where(user_id: id).delete_all
+      Access.where(user_id: id).delete_all
+      ReadingMark.where(user_id: id).delete_all
+
+      forget_sign_in_events
+      dispose_of_created_books
+      destroy!
+    end
+
+    self
+  end
+
+  alias_method :deactivate, :erase
+
+  # Every address this person could have signed in with. An account removed the old way only kept a
+  # scrambled address around, so that gets unwound until we're back at the one they actually used.
+  def sign_in_email_addresses
+    addresses = []
+    candidate = email_address.presence
+
+    while candidate && addresses.exclude?(candidate)
+      addresses << candidate
+
+      if match = DEACTIVATED_EMAIL_ADDRESS_PATTERN.match(candidate)
+        candidate = match[:local] + match[:domain]
+      else
+        break
+      end
     end
+
+    addresses
   end
 
   private
-    def deactived_email_address
-      email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
+    def forget_sign_in_events
+      SignInEvent.where("lower(email_address) IN (?)", sign_in_email_addresses.map(&:downcase)).delete_all
+    end
+
+    def dispose_of_created_books
+      books_kept_for_readers_ids = books_kept_for_readers.ids
+
+      # Shared with everyone means other people are reading these, so they stay up without them.
+      # Bulk updated because assigning an author would otherwise fall back on the current one.
+      Book.where(id: books_kept_for_readers_ids).update_all \
+        author: ERASED_AUTHOR_BYLINE, creator_id: nil, updated_at: Time.current
+
+      hand_out_reader_access_to_the_people_left_over(books_kept_for_readers_ids)
+
+      books_to_take_down.each do |book|
+        Leaf.remove_books_from_search_index(book)
+        book.destroy!
+      end
+    end
+
+    def books_kept_for_readers
+      Book.where(creator_id: id, everyone_access: true)
+    end
+
+    def books_to_take_down
+      Book.where(creator_id: id).where.not(everyone_access: true)
+    end
+
+    # Books shared with everyone are open to everybody on the account, so whoever is left over keeps
+    # reading them too.
+    def hand_out_reader_access_to_the_people_left_over(book_ids)
+      people_left_over = User.active.excluding(self)
+      return if book_ids.empty? || people_left_over.empty?
+
+      readers_covered = Access.where(book_id: book_ids, user_id: people_left_over).pluck(:book_id, :user_id)
+      readers_missing = book_ids.product(people_left_over.ids) - readers_covered
+      return if readers_missing.empty?
+
+      Access.insert_all(
+        readers_missing.collect { |book_id, user_id|
+          { book_id: book_id, user_id: user_id, level: Access.levels[:reader] }
+        })
     end
 
     def grant_access_to_everyone_books
