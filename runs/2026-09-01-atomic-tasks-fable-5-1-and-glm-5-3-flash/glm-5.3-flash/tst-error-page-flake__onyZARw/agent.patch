new file mode 100644
index 0000000..cd1c1d5
--- /dev/null
+++ b/lib/testing/raised_exceptions_middleware.rb
@@ -0,0 +1,30 @@
+# frozen_string_literal: true
+
+# Test-only middleware, wired up in config/environments/test.rb.
+#
+# Makes the app raise controller exceptions for the requests issued inside
+# `with_raised_exceptions`, by marking the request env rather than by mutating
+# configuration that every other request in the process reads.
+#
+# `Rails.application.config.action_dispatch.show_exceptions` is snapshotted into
+# the memoized `Rails.application.env_config` the first time a request is made,
+# so changing the config from a helper is order dependent: too early and it
+# leaks into every later test, too late and it changes nothing at all. Reading
+# this flag off the current thread keeps the behaviour local to whichever test
+# asked for it, no matter how tests are ordered or executed.
+module TestSupport
+  class RaisedExceptionsMiddleware
+    SHOW_EXCEPTIONS = "action_dispatch.show_exceptions"
+
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      return @app.call(env) unless ActiveSupport::TestCase.raising_exceptions_for_current_thread?
+
+      env[SHOW_EXCEPTIONS] = :none
+      @app.call(env)
+    end
+  end
+end
diff --git a/test/integration/with_raised_exceptions_test.rb b/test/integration/with_raised_exceptions_test.rb
new file mode 100644
index 0000000..6d226cf
--- /dev/null
+++ b/test/integration/with_raised_exceptions_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class WithRaisedExceptionsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "raises controller errors inside its block and renders error pages outside of it" do
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    # Blocks must be repeatable, whatever happened inside them or around them.
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "keeps rendering error pages for requests made after its block" do
+    get root_path
+    assert_response :success
+
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    get root_path
+    assert_response :success
+
+    # The next tests in this process keep seeing rendered error pages.
+    assert_not_equal :none, Rails.application.config.action_dispatch.show_exceptions
+  end
+end
