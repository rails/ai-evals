diff --git a/test/models/book/archive_access_test.rb b/test/models/book/archive_access_test.rb
new file mode 100644
index 0000000..42b5157
--- /dev/null
+++ b/test/models/book/archive_access_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Book::ArchiveAccessTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "deleting a book archives one row per person who had access" do
+    expected_people = @book.accesses.includes(:user).map { |access| [ access.user.name, access.level ] }.sort
+
+    assert_difference -> { AccessArchive.count }, expected_people.size do
+      @book.destroy!
+    end
+
+    archived = AccessArchive.where(book_id: @book.id)
+
+    assert_equal expected_people, archived.map { |row| [ row.user_name, row.level ] }.sort
+    assert_equal %w[ Handbook ], archived.pluck(:book_title).uniq
+    assert_not_includes archived.map(&:created_at), nil
+  end
+
+  test "archived rows record the level each person had when the book was deleted" do
+    book = books(:manual)
+    accesses(:jason_manual).update!(level: "reader")
+
+    book.destroy!
+
+    assert_equal "reader", AccessArchive.find_by(book_id: book.id, user_id: users(:jason).id).level
+    assert_equal "editor", AccessArchive.find_by(book_id: book.id, user_id: users(:david).id).level
+  end
+
+  test "people whose access was revoked before the deletion are not archived" do
+    book = books(:manual)
+
+    book.accesses.find_by!(user: users(:jz)).destroy
+    book.reload
+
+    assert_difference -> { AccessArchive.count }, 2 do
+      book.destroy!
+    end
+
+    assert_equal %w[ David Jason ].sort, AccessArchive.where(book_id: book.id).pluck(:user_name).sort
+  end
+
+  test "records the grant list exactly as it stands right before the deletion" do
+    book = Book.create!(title: "Partly shared", everyone_access: false)
+    book.update_access(editors: [ users(:jason).id ], readers: [ users(:jz).id ])
+    book.accesses.to_a # load the association before anything else touches it
+    book.update_access(editors: [ users(:jz).id ], readers: []) # takes Jason's grant away
+
+    book.destroy!
+
+    archived = AccessArchive.where(book_id: book.id)
+
+    assert_equal %w[ JZ ], archived.map(&:user_name)
+    assert_equal "editor", AccessArchive.find_by(book_id: book.id, user_id: users(:jz).id).level
+  end
+
+  test "a book nobody had access to is deleted without any archive rows" do
+    book = Book.create!(title: "Unshared")
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+  end
+
+  test "the archive is written after the book and its grants are gone, not before" do
+    sql_events = []
+
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |event|
+      statement = event.payload[:sql].to_s
+
+      if statement.include?("DELETE FROM \"books\"")
+        sql_events << :delete_book
+      elsif statement.include?("DELETE FROM \"accesses\"")
+        sql_events << :delete_accesses
+      elsif statement.include?("INSERT INTO \"access_archives\"")
+        sql_events << :insert_archives
+      end
+    end
+
+    @book.destroy!
+
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+
+    assert_includes sql_events, :insert_archives
+    assert_operator sql_events.index(:insert_archives), :>, sql_events.index(:delete_book)
+    assert_operator sql_events.index(:insert_archives), :>, sql_events.index(:delete_accesses)
+  end
+
+  test "nothing is archived when the deletion is aborted" do
+    aborting_book_class = Class.new(Book) { before_destroy { throw :abort } }
+    book = aborting_book_class.find(@book.id)
+
+    assert_no_difference -> { AccessArchive.count } do
+      assert_not book.destroy
+    end
+
+    assert Book.exists?(book.id)
+  end
+
+  test "nothing is archived when the deletion fails part way through" do
+    exploding_book_class = Class.new(Book) { after_destroy { raise "boom" } }
+    book = exploding_book_class.find(@book.id)
+
+    assert_raises(RuntimeError) { book.destroy! }
+
+    assert Book.exists?(book.id)
+    assert_empty AccessArchive.where(book_id: book.id)
+  end
+end
