diff --git a/test/integration/toc_caching_test.rb b/test/integration/toc_caching_test.rb
new file mode 100644
index 0000000..78d71d5
--- /dev/null
+++ b/test/integration/toc_caching_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class TocCachingTest < ActionDispatch::IntegrationTest
+  # The table of contents is cached twice over: as one fragment per book, and
+  # again entry by entry through `render ..., collection:, cached:`. That
+  # second layer keeps whatever whoever rendered last, so both of them have to
+  # be keyed by whether this visitor may edit the book.
+  setup do
+    ActionController::Base.perform_caching = true
+    ActionController::Base.cache_store = @fragment_cache = ActiveSupport::Cache::MemoryStore.new
+    ActionView::PartialRenderer.collection_cache = @entry_cache = ActiveSupport::Cache::MemoryStore.new
+
+    Rails.cache.clear if Rails.cache.respond_to?(:clear)
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = false
+
+    @fragment_cache.clear
+    @entry_cache.clear
+  end
+
+  test "readers never see an editor's table of contents, whoever opened the book first" do
+    sign_in :kevin # editor of handbook
+    get book_slug_path(books(:handbook))
+
+    assert_response :success
+    assert_edit_controls
+
+    sign_out
+    sign_in :jz # reader of handbook
+    get book_slug_path(books(:handbook))
+
+    assert_response :success
+    assert_no_edit_controls
+  end
+
+  test "editors never lose their controls, whoever opened the book first" do
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_response :success
+    assert_no_edit_controls
+
+    sign_out
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_response :success
+    assert_edit_controls
+  end
+
+  test "a change in someone's level shows up without anything else touching the book" do
+    accesses(:jz_handbook).update!(level: :editor)
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_response :success
+    assert_edit_controls
+
+    accesses(:jz_handbook).update!(level: :reader)
+
+    get book_slug_path(books(:handbook))
+
+    assert_response :success
+    assert_no_edit_controls
+  end
+
+  test "an entry's new title reaches the next person in" do
+    leaf = leaves(:welcome_page)
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+
+    leaf.update! title: "Freshly Renamed"
+
+    sign_out
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_response :success
+    assert_in_body "Freshly Renamed"
+    assert_no_edit_controls
+  end
+
+  test "entries stay cached once rendered, so nobody pays to render them again" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    get book_slug_path(books(:handbook)) # everything is cached by now
+
+    before = cache_sizes
+
+    get book_slug_path(books(:handbook))
+
+    after = cache_sizes
+    assert_equal before, after
+    assert_edit_controls
+  end
+
+  private
+    def cache_sizes
+      { fragments: @fragment_cache.instance_variable_get(:@data).size,
+        entries: @entry_cache.instance_variable_get(:@data).size }
+    end
+
+    def assert_edit_controls
+      leaf_edit_url = edit_book_page_path(books(:handbook), leaves(:welcome_page))
+
+      assert_select ".toc__leaf a[href='#{leaf_edit_url}']"
+      assert_in_body "Add a new text page"
+      assert_in_body "Publish this book"
+    end
+
+    def assert_no_edit_controls
+      leaf_edit_url = edit_book_page_path(books(:handbook), leaves(:welcome_page))
+
+      assert_select ".toc__leaf a[href='#{leaf_edit_url}']", count: 0
+      assert_not_in_body "Add a new text page"
+      assert_not_in_body "Publish this book"
+    end
+end
