diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
index 153d542..5d60bf1 100644
--- a/app/controllers/searches_controller.rb
+++ b/app/controllers/searches_controller.rb
@@ -3,6 +3,9 @@ class SearchesController < ApplicationController
 
   RESULT_LIMIT = 50
 
+  # The character used to neutralize LIKE wildcards in search terms.
+  ESCAPE_CHARACTER = "\\"
+
   def show
     @query = params[:q].to_s.strip
     @leaves = @query.present? ? matching_leaves : Leaf.none
@@ -11,12 +14,24 @@ class SearchesController < ApplicationController
   private
     def matching_leaves
       Leaf.active.joins(:book)
-        .where("books.id in (#{readable_book_ids.join(",")}) and leaves.title like '%#{@query}%'")
+        .where(book_id: readable_books)
+        .where(Leaf.arel_table[:title].matches(title_pattern, ESCAPE_CHARACTER))
         .order("books.title", "leaves.position_score")
         .limit(RESULT_LIMIT)
     end
 
-    def readable_book_ids
-      Book.accessable_or_published.ids.presence || [ 0 ]
+    # Whatever is typed is treated as data, never as a pattern or as SQL. The
+    # LIKE wildcards (`%` and `_`) are escaped so they only match themselves.
+    def title_pattern
+      "%#{escape_wildcards(@query)}%"
+    end
+
+    def escape_wildcards(terms)
+      terms.gsub(/[\\%_]/) { |character| "#{ESCAPE_CHARACTER}#{character}" }
+    end
+
+    # Books the searcher may open, published ones included, nothing else.
+    def readable_books
+      Book.accessable_or_published
     end
 end
