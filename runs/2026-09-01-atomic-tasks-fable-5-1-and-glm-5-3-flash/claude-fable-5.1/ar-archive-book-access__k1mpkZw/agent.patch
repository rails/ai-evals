@@ -114,4 +114,15 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy archives the access list" do
+    book = books(:handbook)
+    user_ids = book.accesses.pluck(:user_id).sort
+
+    delete book_url(book)
+
+    assert_redirected_to root_url
+    assert_not Book.exists?(book.id)
+    assert_equal user_ids, AccessArchive.where(book_id: book.id).pluck(:user_id).sort
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..e93657b 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,35 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives everyone who had access at that moment" do
+    book = books(:manual)
+    expected = book.accesses.includes(:user).map { [ it.user_id, it.user.name, it.level ] }.sort
+
+    assert_changes -> { AccessArchive.where(book_id: book.id).count }, from: 0, to: expected.size do
+      book.destroy!
+    end
+
+    assert_equal expected, AccessArchive.where(book_id: book.id).map { [ it.user_id, it.user_name, it.level ] }.sort
+    assert AccessArchive.where(book_id: book.id).all? { it.book_title == book.title }
+    assert_empty Access.where(book_id: book.id)
+  end
+
+  test "destroying a book does not archive users whose access was revoked earlier" do
+    book = books(:manual)
+    book.accesses.find_by(user: users(:jz)).destroy!
+
+    book.destroy!
+
+    assert_not AccessArchive.exists?(book_id: book.id, user_id: users(:jz).id)
+    assert_equal 2, AccessArchive.where(book_id: book.id).count
+  end
+
+  test "destroying a book nobody has access to writes no archive rows" do
+    book = Book.create!(title: "Nobody's book", everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+  end
 end
