diff --git a/app/controllers/books/searches_controller.rb b/app/controllers/books/searches_controller.rb
index 5268c55..20b6255 100644
--- a/app/controllers/books/searches_controller.rb
+++ b/app/controllers/books/searches_controller.rb
@@ -1,9 +1,21 @@
 class Books::SearchesController < ApplicationController
   allow_unauthenticated_access
 
+  # Searching a published book needs no sign-in, so it's the one place an anonymous
+  # address can make us run full-text queries at will. Cap each address to a burst
+  # per minute and refuse the rest outright, before we even look up the book. The
+  # counter expires with the window, so a quieted address is served again by itself.
+  rate_limit to: 30, within: 1.minute, only: :create, store: RateLimitStore, with: :refuse_search
+
   include BookScoped
 
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    def refuse_search
+      response.headers["Retry-After"] = 1.minute.to_i.to_s
+      render :too_many_requests, status: :too_many_requests
+    end
 end
