diff --git a/app/models/concerns/tenanted.rb b/app/models/concerns/tenanted.rb
new file mode 100644
index 0000000..aa2ce04
--- /dev/null
+++ b/app/models/concerns/tenanted.rb
@@ -0,0 +1,15 @@
+# Users and books can belong to a tenant. Rows in different tenants never see each other,
+# whatever access rows say. Rows without a tenant are unscoped and behave as they always have.
+module Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    scope :within_tenant, ->(tenant) { tenant.present? ? where(tenant_id: [ nil, tenant.id ]) : all }
+  end
+
+  def shares_tenant_with?(other)
+    tenant_id.nil? || other.nil? || other.tenant_id.nil? || tenant_id == other.tenant_id
+  end
+end
