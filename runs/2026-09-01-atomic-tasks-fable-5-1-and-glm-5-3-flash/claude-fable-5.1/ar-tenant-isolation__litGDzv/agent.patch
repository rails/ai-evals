new file mode 100644
index 0000000..eea0b44
--- /dev/null
+++ b/db/migrate/20250301000000_create_tenants.rb
@@ -0,0 +1,39 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    sweep_existing_rows_into_one_tenant
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+
+    drop_table :tenants
+  end
+
+  private
+    # Running installs upgrade in place: everything that already exists belongs to a single tenant.
+    def sweep_existing_rows_into_one_tenant
+      return unless select_value("SELECT 1 FROM users LIMIT 1") || select_value("SELECT 1 FROM books LIMIT 1")
+
+      tenant_id = insert <<~SQL.squish
+        INSERT INTO tenants (name, created_at, updated_at)
+        VALUES (#{quote(existing_tenant_name)}, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
+      SQL
+
+      update "UPDATE users SET tenant_id = #{tenant_id.to_i} WHERE tenant_id IS NULL"
+      update "UPDATE books SET tenant_id = #{tenant_id.to_i} WHERE tenant_id IS NULL"
+    end
+
+    def existing_tenant_name
+      select_value("SELECT name FROM accounts ORDER BY id LIMIT 1").presence || "Writebook"
+    end
+end
