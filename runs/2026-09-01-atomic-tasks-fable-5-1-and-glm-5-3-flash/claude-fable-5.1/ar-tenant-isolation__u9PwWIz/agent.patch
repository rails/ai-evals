diff --git a/test/integration/tenancy_test.rb b/test/integration/tenancy_test.rb
new file mode 100644
index 0000000..c95112e
--- /dev/null
+++ b/test/integration/tenancy_test.rb
@@ -0,0 +1,120 @@
+require "test_helper"
+
+class TenancyTest < ActionDispatch::IntegrationTest
+  setup do
+    @customer_a = Tenant.create!(name: "Customer A")
+    @customer_b = Tenant.create!(name: "Customer B")
+
+    users(:kevin).update!(tenant: @customer_a)
+    users(:jason).update!(tenant: @customer_b)
+    books(:handbook).update!(tenant: @customer_a)
+    books(:manual).update!(tenant: @customer_b, published: true)
+    @manual_page = books(:manual).press Page.new(body: "Manual page"), title: "Manual Page"
+
+    # Sharing with everyone sprayed a reader row for the other tenant's book across to kevin
+    books(:manual).update_access(editors: [], readers: [])
+    assert books(:manual).accessable?(user: users(:kevin))
+
+    sign_in :kevin
+  end
+
+  test "library lists only the tenant's books" do
+    get root_path
+
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual", count: 0
+  end
+
+  test "another tenant's book is not found, even when published and with an access row" do
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    get edit_book_path(books(:manual))
+    assert_response :not_found
+
+    get book_publication_path(books(:manual))
+    assert_response :not_found
+
+    get book_bookmark_path(books(:manual))
+    assert_response :not_found
+
+    post book_search_path(books(:manual)), params: { search: "manual" }
+    assert_response :not_found
+
+    assert cookies[:session_token].present?
+  end
+
+  test "pages inside another tenant's book are not found" do
+    leaf = @manual_page
+
+    get leafable_slug_path(leaf)
+    assert_response :not_found
+
+    get book_page_path(books(:manual), leaf)
+    assert_response :not_found
+
+    get edit_book_page_path(books(:manual), leaf)
+    assert_response :not_found
+
+    patch book_page_path(books(:manual), leaf), params: { page: { body: "Sneaky" } }
+    assert_response :not_found
+
+    assert cookies[:session_token].present?
+  end
+
+  test "edit history of a page inside another tenant's book is not found" do
+    leaf = @manual_page
+    leaf.edit leafable_params: { body: "Updated" }
+
+    get page_edit_path(leaf, leaf.edits.last)
+    assert_response :not_found
+
+    get page_edit_path(leaf, "latest")
+    assert_response :not_found
+
+    assert cookies[:session_token].present?
+  end
+
+  test "own books and page histories keep working" do
+    leaf = leaves(:welcome_page)
+    leaf.edit leafable_params: { body: "Updated" }
+
+    get book_slug_path(books(:handbook))
+    assert_response :success
+
+    get leafable_slug_path(leaf)
+    assert_response :success
+
+    get page_edit_path(leaf, "latest")
+    assert_response :success
+  end
+
+  test "new books land in their creator's tenant" do
+    post books_path, params: { book: { title: "New Book" } }
+
+    assert_equal @customer_a, Book.last.tenant
+    assert_redirected_to book_slug_url(Book.last)
+  end
+
+  test "signed-out visitors see every published book, whatever tenant it belongs to" do
+    books(:handbook).update!(published: true)
+    sign_out
+
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual"
+
+    get book_slug_path(books(:manual))
+    assert_response :success
+  end
+
+  test "users page still names everyone on the install" do
+    get users_path
+
+    assert_response :success
+    assert_match "Kevin", response.body
+    assert_match "Jason", response.body
+  end
+end
