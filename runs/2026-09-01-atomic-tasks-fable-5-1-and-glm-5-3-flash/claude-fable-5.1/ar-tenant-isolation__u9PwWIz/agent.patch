diff --git a/app/models/book/tenanted.rb b/app/models/book/tenanted.rb
new file mode 100644
index 0000000..de01a51
--- /dev/null
+++ b/app/models/book/tenanted.rb
@@ -0,0 +1,10 @@
+module Book::Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    # Books without a tenant belong with users without a tenant, so a nil tenant behaves as one install did.
+    scope :in_tenant_of, ->(user) { where(tenant_id: user.tenant_id) }
+  end
+end
