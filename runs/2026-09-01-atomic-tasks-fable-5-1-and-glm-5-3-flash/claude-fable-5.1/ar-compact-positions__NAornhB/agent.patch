index 0000000..55c392d
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+    # Hand-arrange the handbook out of creation order, leaving gaps.
+    leaves(:reading_picture).update_columns(position_score: 1.5)
+    leaves(:summary_page).update_columns(position_score: 3.25)
+    leaves(:welcome_page).update_columns(position_score: 7)
+    leaves(:welcome_section).update_columns(position_score: 20)
+  end
+
+  test "compact_positions! produces a dense 1..n sequence" do
+    @book.compact_positions!
+
+    assert_equal [ 1.0, 2.0, 3.0, 4.0 ], @book.leaves.pluck(:position_score).sort
+  end
+
+  test "compact_positions! preserves the hand-arranged ordering" do
+    expected = @book.leaves.positioned.pluck(:id)
+
+    @book.compact_positions!
+
+    assert_equal expected, @book.leaves.positioned.pluck(:id)
+    assert_equal %w[ reading_picture summary_page welcome_page welcome_section ].map { leaves(it).id },
+      @book.leaves.positioned.pluck(:id)
+  end
+
+  test "compact_positions! keeps a trashed leaf's slot so it restores in place" do
+    leaves(:summary_page).trashed!
+
+    @book.compact_positions!
+    leaves(:summary_page).reload.active!
+
+    assert_equal [ leaves(:reading_picture), leaves(:summary_page), leaves(:welcome_page), leaves(:welcome_section) ].map(&:id),
+      @book.leaves.active.positioned.pluck(:id)
+  end
+
+  test "compact_positions! leaves other books alone" do
+    other = books(:manual).press(Page.new(body: "Other"), title: "Other")
+    other.update_columns(position_score: 42.5)
+
+    @book.compact_positions!
+
+    assert_equal 42.5, other.reload.position_score
+  end
+
+  test "compact_positions! is a no-op for a book without leaves" do
+    assert_nothing_raised { books(:manual).compact_positions! }
+  end
+
+  test "live_leaf_count counts leaves not in the trash" do
+    assert_equal 4, @book.live_leaf_count
+
+    leaves(:summary_page).trashed!
+    assert_equal 3, @book.live_leaf_count
+
+    assert_equal 0, books(:manual).live_leaf_count
+  end
+end
