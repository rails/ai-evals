diff --git a/test/integration/pentest_findings_test.rb b/test/integration/pentest_findings_test.rb
new file mode 100644
index 0000000..40bca10
--- /dev/null
+++ b/test/integration/pentest_findings_test.rb
@@ -0,0 +1,226 @@
+require "test_helper"
+
+# Reproduction of the external assessment findings PT-01 .. PT-05.
+class PentestFindingsTest < ActionDispatch::IntegrationTest
+  # PT-01 -------------------------------------------------------------------
+  test "PT-01: a member cannot grant themselves a role via their own profile" do
+    sign_in :kevin
+
+    put user_profile_path(users(:kevin)), params: { user: { name: "Kev", role: "administrator" } }
+
+    assert_equal "member", users(:kevin).reload.role
+    assert_equal "Kev", users(:kevin).name
+  end
+
+  test "PT-01: a member cannot change anyone's role via the users endpoint" do
+    sign_in :kevin
+
+    patch user_path(users(:jz)), params: { user: { role: "administrator" } }
+    assert_response :forbidden
+    assert_equal "member", users(:jz).reload.role
+
+    patch user_path(users(:kevin)), params: { user: { role: "administrator" } }
+    assert_response :forbidden
+    assert_equal "member", users(:kevin).reload.role
+  end
+
+  test "PT-01: administrators still change roles; everyone still edits own name/email/password" do
+    sign_in :david
+    patch user_path(users(:kevin)), params: { user: { role: "administrator" } }
+    assert_equal "administrator", users(:kevin).reload.role
+
+    sign_in :jz
+    put user_profile_path(users(:jz)), params: { user: { name: "Jay Zee", email_address: "jayzee@example.com", password: "newsecret12345" } }
+    assert_redirected_to users_url
+    jz = users(:jz).reload
+    assert_equal "Jay Zee", jz.name
+    assert_equal "jayzee@example.com", jz.email_address
+    assert jz.authenticate("newsecret12345")
+    assert_equal "member", jz.role
+  end
+
+  # PT-02 -------------------------------------------------------------------
+  test "PT-02: a reader cannot destroy a book" do
+    sign_in :jz # reader of handbook
+
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:handbook))
+    end
+    assert_response :forbidden
+  end
+
+  test "PT-02: a signed-in user with no access cannot destroy a published book" do
+    books(:manual).update!(published: true)
+    sign_in :kevin # no access to manual
+
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:manual))
+    end
+    assert_response :forbidden
+  end
+
+  test "PT-02: a reader cannot update a book" do
+    sign_in :jz
+
+    patch book_path(books(:handbook)), params: { book: { title: "Hijacked" } }
+    assert_response :forbidden
+    assert_equal "Handbook", books(:handbook).reload.title
+  end
+
+  test "PT-02: an editor can still update and destroy a book" do
+    sign_in :kevin # editor of handbook
+
+    patch book_path(books(:handbook)), params: { book: { title: "Renamed" } }
+    assert_redirected_to book_slug_url(books(:handbook).reload)
+    assert_equal "Renamed", books(:handbook).title
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+    assert_redirected_to root_url
+  end
+
+  # PT-03 -------------------------------------------------------------------
+  test "PT-03: library search with an apostrophe returns results, not an error" do
+    sign_in :kevin
+    books(:handbook).press Page.new(body: "x"), title: "Kevin's Corner"
+
+    get library_search_path, params: { q: "Kevin's" }
+
+    assert_response :success
+    assert_in_body "Kevin&#39;s Corner"
+  end
+
+  test "PT-03: library search cannot be coerced into returning unreadable books" do
+    sign_in :kevin # no access to manual
+    books(:manual).press Page.new(body: "x"), title: "Secret Manual Page"
+
+    # Classic tautology injection attempting to bypass the readable-book filter
+    get library_search_path, params: { q: "' or 1=1 or leaves.title like '" }
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+
+    get library_search_path, params: { q: "%' or books.id in (#{books(:manual).id}) or leaves.title like '%" }
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+
+    get library_search_path, params: { q: "Secret" }
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+  end
+
+  test "PT-03: ordinary library searches still find what they found" do
+    sign_in :kevin
+
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Summary"
+
+    get library_search_path, params: { q: "summ" }
+    assert_response :success
+    assert_in_body "Summary"
+  end
+
+  test "PT-03: signed-out search only reaches published books" do
+    books(:manual).update!(published: true)
+    books(:manual).press Page.new(body: "x"), title: "Public Manual Page"
+    books(:handbook).press Page.new(body: "x"), title: "Private Handbook Page"
+
+    get library_search_path, params: { q: "Page" }
+    assert_response :success
+    assert_in_body "Public Manual Page"
+    assert_not_in_body "Private Handbook Page"
+  end
+
+  # PT-04 -------------------------------------------------------------------
+  test "PT-04: percent and underscore are literal in library search" do
+    sign_in :kevin
+    books(:handbook).press Page.new(body: "x"), title: "Save 50% off"
+    books(:handbook).press Page.new(body: "x"), title: "snake_case"
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_not_in_body "snake_case"
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_in_body "snake_case"
+    assert_not_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: "S_mmary" }
+    assert_response :success
+    assert_not_in_body "Summary"
+
+    get library_search_path, params: { q: "Wel%book" }
+    assert_response :success
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "PT-04: a backslash in the term is literal too" do
+    sign_in :kevin
+    books(:handbook).press Page.new(body: "x"), title: "C:\\Windows"
+
+    get library_search_path, params: { q: "C:\\Win" }
+    assert_response :success
+    assert_in_body "C:\\Windows"
+
+    get library_search_path, params: { q: "\\" }
+    assert_response :success
+    assert_in_body "C:\\Windows"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  # PT-05 -------------------------------------------------------------------
+  test "PT-05: a leaf of an unreadable book cannot be fetched under a readable book's id" do
+    sign_in :kevin # editor of handbook, no access to manual
+    secret = books(:manual).press Page.new(body: "Top secret manual body"), title: "Secret Page"
+
+    get slugged_leafable_path(books(:handbook), books(:handbook).slug, secret, secret.slug)
+    assert_response :not_found
+    assert_select ".page--page", count: 0
+
+    get book_page_path(books(:handbook), secret)
+    assert_response :not_found
+
+    get edit_book_page_path(books(:handbook), secret)
+    assert_response :not_found
+
+    patch book_page_path(books(:handbook), secret), params: { page: { body: "defaced" } }
+    assert_response :not_found
+    assert_equal "Top secret manual body", secret.leafable.reload.markable
+
+    delete book_page_path(books(:handbook), secret)
+    assert_response :not_found
+    assert secret.reload.active?
+  end
+
+  test "PT-05: a leaf of an unreadable book cannot be fetched under a published book's id when signed out" do
+    books(:manual).update!(published: true)
+    secret = books(:handbook).press Page.new(body: "Top secret handbook body"), title: "Secret Page"
+
+    get slugged_leafable_path(books(:manual), books(:manual).slug, secret, secret.slug)
+    assert_response :not_found
+    assert_select ".page--page", count: 0
+  end
+
+  test "PT-05: readable pages stay readable, signed out included" do
+    sign_in :kevin
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+    assert_select "p", "This is such a great handbook."
+
+    sign_out
+    books(:handbook).update!(published: true)
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+    assert_select "p", "This is such a great handbook."
+  end
+end
