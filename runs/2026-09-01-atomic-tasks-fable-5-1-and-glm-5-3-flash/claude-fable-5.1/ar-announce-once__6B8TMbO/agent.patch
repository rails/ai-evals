diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..e9e3a64 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -1,11 +1,40 @@
 module Book::Announceable
   extend ActiveSupport::Concern
 
+  # Announce a book exactly once: when the sitting that took it live commits.
+  #
+  # The verdict can't be read from `saved_changes` at commit time. Leaves touch
+  # their book, so a sitting that publishes a book and then adds a page saves the
+  # book twice, and only the last save's changes (just `updated_at`) survive to
+  # `after_commit`. Instead, the first save that flips `published` remembers what
+  # it was before the sitting began, and the announcement goes out at commit only
+  # if the book started as a draft and ended up live. A rollback forgets it, so a
+  # failed sitting leaves a draft and announces nothing.
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_save :remember_publication_before_sitting, if: :saved_change_to_published?
+    after_commit :announce_publication_if_went_live
+    after_rollback :forget_publication_before_sitting
   end
 
   private
+    def remember_publication_before_sitting
+      @published_before_sitting = published_before_last_save if @published_before_sitting.nil?
+    end
+
+    def forget_publication_before_sitting
+      @published_before_sitting = nil
+    end
+
+    def went_live?
+      @published_before_sitting == false && published?
+    end
+
+    def announce_publication_if_went_live
+      announce_publication if went_live?
+    ensure
+      forget_publication_before_sitting
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
diff --git a/test/controllers/books/publications_announce_test.rb b/test/controllers/books/publications_announce_test.rb
new file mode 100644
index 0000000..638b0dc
--- /dev/null
+++ b/test/controllers/books/publications_announce_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Books::PublicationsAnnounceTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+    sign_in :david
+  end
+
+  test "publishing announces once" do
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ @book ]) do
+      patch book_publication_url(@book), params: { book: { published: "1" } }
+    end
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob
+  end
+
+  test "publishing and adding a page in the same sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "1" }, added_pages: [ "Foreword", "Afterword" ] }
+    end
+    assert @book.reload.published?
+    assert_equal %w[ Afterword Foreword ], @book.leaves.pluck(:title).sort
+  end
+
+  test "publishing while trashing and renaming pages announces once" do
+    @book = books(:handbook)
+    welcome, summary = leaves(:welcome_page), leaves(:summary_page)
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: {
+        book: { published: "1" },
+        trashed_page_ids: [ summary.id ],
+        renamed_pages: { welcome.id => "Hello" },
+        added_pages: [ "New" ]
+      }
+    end
+    assert @book.reload.published?
+    assert summary.reload.trashed?
+    assert_equal "Hello", welcome.reload.title
+  end
+
+  test "unpublishing announces nothing" do
+    @book.update! published: true
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "0" } }
+    end
+    assert_not @book.reload.published?
+  end
+
+  test "saving an already-live book again announces nothing" do
+    @book.update! published: true
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "1", slug: "new-slug" }, added_pages: [ "Foreword" ] }
+    end
+    assert_equal "new-slug", @book.reload.slug
+  end
+
+  test "a save that doesn't take the book live announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "0" }, added_pages: [ "Foreword" ] }
+    end
+    assert_not @book.reload.published?
+    assert_equal [ "Foreword" ], @book.leaves.pluck(:title)
+  end
+
+  test "a sitting that fails after going live leaves a draft and announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "1" }, added_pages: [ "Foreword" ], trashed_page_ids: [ 0 ] }
+      assert_response :not_found
+    end
+    assert_not @book.reload.published?
+    assert_empty @book.leaves
+  end
+end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..b82a59a
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup { @book = books(:manual) }
+
+  test "going live alone announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "going live and adding a page in one sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), { title: "New page" }
+      end
+    end
+  end
+
+  test "taking a live book down announces nothing" do
+    @book.update! published: true
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "saving an already-live book again announces nothing" do
+    @book.update! published: true
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Renamed"
+      @book.transaction do
+        @book.update! published: true, slug: "other"
+        @book.press Page.new(body: ""), { title: "New page" }
+      end
+    end
+  end
+
+  test "a save that doesn't take the book live announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Renamed"
+      @book.press Page.new(body: ""), { title: "New page" }
+    end
+  end
+
+  test "a failed sitting after going live leaves a draft and no announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises(ActiveRecord::ActiveRecordError) do
+        @book.transaction do
+          @book.update! published: true
+          @book.leaves.create!(title: nil, leafable: Page.new(body: ""))
+        end
+      end
+    end
+    assert_not @book.reload.published?
+  end
+end
+
+class Book::AnnounceableEdgeTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup { @book = books(:manual) }
+
+  test "going live then back down in one sitting announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), { title: "New page" }
+        @book.update! published: false
+      end
+    end
+    assert_not @book.reload.published?
+  end
+
+  test "live book taken down and back up in one sitting announces nothing" do
+    @book.update! published: true
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "a failed sitting does not leak into the next sitting" do
+    assert_raises(ActiveRecord::ActiveRecordError) do
+      @book.transaction do
+        @book.update! published: true
+        @book.leaves.create!(title: nil, leafable: Page.new(body: ""))
+      end
+    end
+    assert_not @book.reload.published?
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Renamed"
+    end
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "going live in consecutive sittings announces only once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+      @book.update! published: true
+      @book.press Page.new(body: ""), { title: "New page" }
+    end
+  end
+
+  test "book created live is announced once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.create! title: "Live from birth", published: true
+    end
+  end
+
+  test "book created as draft is not announced" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.create! title: "Draft"
+    end
+  end
+end
