diff --git a/test/jobs/leaf/being_edited_broadcast_job_test.rb b/test/jobs/leaf/being_edited_broadcast_job_test.rb
new file mode 100644
index 0000000..2dcff23
--- /dev/null
+++ b/test/jobs/leaf/being_edited_broadcast_job_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Leaf::BeingEditedBroadcastJobTest < ActiveJob::TestCase
+  include ActionCable::TestHelper
+
+  setup do
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "broadcasts to the other editors on their own streams" do
+    Leaf::BeingEditedBroadcastJob.perform_now @leaf, users(:kevin)
+
+    assert_equal 1, broadcasts(being_edited_stream_for(users(:david))).size
+    assert_equal 1, broadcasts(being_edited_stream_for(users(:jason))).size
+    assert_equal 0, broadcasts(being_edited_stream_for(users(:kevin))).size, "not to the editor themselves"
+    assert_equal 0, broadcasts(being_edited_stream_for(users(:jz))).size, "not to readers"
+
+    payload = JSON.parse(broadcasts(being_edited_stream_for(users(:david))).first)
+    assert_match "Kevin", payload
+    assert_match dom_id(@leaf, :being_edited), payload
+  end
+
+  test "does not broadcast to a collaborator removed from the book" do
+    accesses(:kevin_handbook).destroy!
+
+    Leaf::BeingEditedBroadcastJob.perform_now @leaf, users(:david)
+
+    assert_equal 0, broadcasts(being_edited_stream_for(users(:kevin))).size
+    assert_equal 1, broadcasts(being_edited_stream_for(users(:jason))).size
+  end
+
+  test "does not broadcast on the shared stream" do
+    Leaf::BeingEditedBroadcastJob.perform_now @leaf, users(:david)
+
+    assert_equal 0, broadcasts(Turbo::StreamsChannel.send(:stream_name_from, [ @leaf, :being_edited ])).size
+  end
+
+  private
+    def being_edited_stream_for(user)
+      Turbo::StreamsChannel.send(:stream_name_from, [ @leaf, :being_edited, user ])
+    end
+end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..cc8e140 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -34,3 +34,25 @@ class Book::AccessableTest < ActiveSupport::TestCase
     assert_equal 1, book.accesses.size
   end
 end
+
+class Book::AccessableEditorsTest < ActiveSupport::TestCase
+  test "editors are the active users who can currently open and edit the book" do
+    book = books(:handbook)
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].sort, book.editors.sort
+
+    accesses(:kevin_handbook).destroy!
+    assert_not_includes book.editors, users(:kevin)
+
+    accesses(:jason_handbook).update!(level: :reader)
+    assert_includes book.editors, users(:jason), "administrators with access can edit"
+
+    accesses(:david_handbook).destroy!
+    assert_not_includes book.editors, users(:david), "administrators without access can't reach an unpublished book"
+
+    book.update!(published: true)
+    assert_includes book.editors, users(:david), "administrators can edit any published book"
+
+    users(:david).deactivate
+    assert_not_includes book.editors, users(:david)
+  end
+end
