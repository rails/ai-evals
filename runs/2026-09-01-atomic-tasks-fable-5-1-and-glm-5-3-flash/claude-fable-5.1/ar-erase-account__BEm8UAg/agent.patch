diff --git a/lib/tasks/users.rake b/lib/tasks/users.rake
new file mode 100644
index 0000000..b70dfab
--- /dev/null
+++ b/lib/tasks/users.rake
@@ -0,0 +1,12 @@
+namespace :users do
+  desc "Erase a user and everything of theirs (GDPR). Accepts the address they signed up with, even if they were deactivated since. Usage: bin/rails users:erase[alice@example.com]"
+  task :erase, [ :email_address ] => :environment do |_, args|
+    abort "Usage: bin/rails users:erase[email_address]" if args.email_address.blank?
+
+    user = User.find_by_original_email_address(args.email_address)
+    abort "No user found for #{args.email_address}" unless user
+
+    user.erase
+    puts "Erased #{args.email_address} (user ##{user.id})"
+  end
+end
