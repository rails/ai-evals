diff --git a/app/models/concerns/tenanted.rb b/app/models/concerns/tenanted.rb
new file mode 100644
index 0000000..2ade004
--- /dev/null
+++ b/app/models/concerns/tenanted.rb
@@ -0,0 +1,16 @@
+# Rows belong to a tenant, and only ever see rows of the same tenant. Rows without a tenant
+# (as in our fixtures) simply match other rows without one, so they behave as they always did.
+module Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    scope :in_tenant, ->(tenant) { where(tenant: tenant) }
+    scope :in_tenant_of, ->(record) { in_tenant(record&.tenant_id) }
+  end
+
+  def same_tenant?(record)
+    record.present? && record.tenant_id == tenant_id
+  end
+end
