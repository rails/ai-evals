 module User::Authoring
   extend ActiveSupport::Concern
 
+  DELETED_AUTHOR = "Deleted author"
+
   included do
-    has_many :created_books, class_name: "Book", foreign_key: :creator_id,
-      inverse_of: :creator, dependent: :destroy
+    has_many :created_books, class_name: "Book", foreign_key: :creator_id, inverse_of: :creator
+    has_many :reading_marks, dependent: :delete_all
 
-    has_many :reading_marks
+    before_destroy :release_or_destroy_created_books
   end
+
+  private
+    # Books shared with everyone stay available to their readers, bylined "Deleted author".
+    # Anything else the person created goes with them.
+    def release_or_destroy_created_books
+      # update_all rather than update!, since Book's creator defaults back to Current.user on save,
+      # which would hand the book to whoever is doing the erasing.
+      created_books.with_everyone_access.update_all creator_id: nil, author: DELETED_AUTHOR, updated_at: Time.current
+
+      created_books.reset.each(&:destroy!)
+    end
 end
diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..eddf5db
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,43 @@
+# Removing someone from the account must leave nothing of theirs behind: not their record, not their
+# sessions, accesses, reading marks, sign-in log entries, nor the books only they owned. Books they
+# created but shared with everyone are kept for the people still reading them, with the author's name
+# taken off (see User::Authoring).
+#
+# Before erasure existed, people were "removed" by deactivating them: the account was kept with
+# `active: false` and the email address scrambled to `alice-deactivated-<uuid>@example.com`.
+# Erasure has to work for those people too, so it also cleans up under the address they actually
+# signed in with.
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  DEACTIVATED_EMAIL_ADDRESS_MARKER = /-deactivated-\h{8}-\h{4}-\h{4}-\h{4}-\h{12}(?=@)/
+
+  included do
+    after_destroy :erase_sign_in_events
+  end
+
+  def erase
+    destroy!
+  end
+
+  def deactivate
+    transaction do
+      sessions.delete_all
+      update! active: false, email_address: deactivated_email_address
+    end
+  end
+
+  # The address before deactivation scrambled it, or the current one if it was never deactivated.
+  def original_email_address
+    email_address&.sub(DEACTIVATED_EMAIL_ADDRESS_MARKER, "")
+  end
+
+  private
+    def deactivated_email_address
+      email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
+    end
+
+    def erase_sign_in_events
+      SignInEvent.for_address([ email_address, original_email_address ].compact.uniq).delete_all
+    end
+end
diff --git a/test/controllers/users_controller_test.rb b/test/controllers/users_controller_test.rb
index e0ca8db..8d53135 100644
--- a/test/controllers/users_controller_test.rb
+++ b/test/controllers/users_controller_test.rb
@@ -79,3 +79,54 @@ class UsersControllerTest < ActionDispatch::IntegrationTest
     assert_response :forbidden
   end
 end
+
+class UsersControllerErasureTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "destroy erases the person rather than deactivating them" do
+    kevin = users(:kevin)
+    sign_in :kevin
+    sign_in :david
+
+    assert_difference -> { User.count }, -1 do
+      delete user_path(kevin)
+    end
+
+    assert_redirected_to users_path
+    assert_not User.exists?(kevin.id)
+    assert_empty Session.where(user_id: kevin.id)
+    assert_empty Access.where(user_id: kevin.id)
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "destroy erases people who were deactivated before erasure existed" do
+    kevin = users(:kevin)
+    sign_in :kevin
+    sign_in :david
+    kevin.deactivate
+
+    assert SignInEvent.for_address("kevin@example.com").exists?
+
+    delete user_path(kevin)
+
+    assert_redirected_to users_path
+    assert_not User.exists?(kevin.id)
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "destroy keeps books shared with everyone under a deleted author byline" do
+    Current.user = users(:kevin)
+    book = Book.create!(title: "Kevin's shared book", author: "Kevin", everyone_access: true)
+    book.update_access editors: [ users(:kevin).id ], readers: []
+    Current.user = nil
+
+    delete user_path(users(:kevin))
+
+    book.reload
+    assert_nil book.creator
+    assert_equal "Deleted author", book.author
+    assert book.accessable?(user: users(:david))
+  end
+end
diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..0f6df17
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  setup do
+    Leaf.reindex_all
+    @kevin = users(:kevin)
+    @signed_in_with = @kevin.email_address
+
+    Current.user = @kevin
+    @kevin.sessions.create!(user_agent: "Test", ip_address: "127.0.0.1")
+    @shared = Book.create!(title: "Kevin's shared book", author: "Kevin", everyone_access: true)
+    @shared.update_access editors: [ @kevin.id ], readers: []
+    @shared_leaf = @shared.press Page.new(body: "Shared thoughts on giraffes"), title: "Giraffes"
+    @secret = Book.create!(title: "Kevin's private book", author: "Kevin", everyone_access: false)
+    @secret_leaf = @secret.press Page.new(body: "Private thoughts on zebras"), title: "Zebras"
+    @secret_leaf.edit leafable_params: { body: "Revised private thoughts on zebras" }
+    @revision_page_ids = @secret_leaf.edits.pluck(:leafable_id)
+    ReadingMark.remember leaves(:welcome_page), user: @kevin
+  ensure
+    Current.user = nil
+  end
+
+  test "erasing removes every trace of the person" do
+    @kevin.erase
+
+    assert_not User.exists?(@kevin.id)
+    assert_empty Session.where(user_id: @kevin.id)
+    assert_empty Access.where(user_id: @kevin.id)
+    assert_empty ReadingMark.where(user_id: @kevin.id)
+    assert_empty SignInEvent.for_address(@signed_in_with)
+  end
+
+  test "erasing destroys books only the person owned, including their revisions and search hits" do
+    assert_includes Leaf.search("zebras"), @secret_leaf
+
+    @kevin.erase
+
+    assert_not Book.exists?(@secret.id)
+    assert_not Leaf.exists?(@secret_leaf.id)
+    assert_empty Page.where(id: @revision_page_ids)
+    assert_empty ActionText::Markdown.where(record_type: "Page", record_id: @revision_page_ids)
+    assert_empty Leaf.search("zebras")
+  end
+
+  test "erasing keeps books shared with everyone, bylined as a deleted author" do
+    @kevin.erase
+
+    @shared.reload
+    assert_nil @shared.creator
+    assert_equal "Deleted author", @shared.author
+    assert_equal [ @shared_leaf ], @shared.leaves.to_a
+    assert_includes Leaf.search("giraffes"), @shared_leaf
+    assert @shared.accessable?(user: users(:david))
+  end
+
+  test "erasing a shared book's creator does not hand the book to whoever is erasing" do
+    Current.user = users(:david)
+    @kevin.erase
+
+    assert_nil @shared.reload.creator
+  ensure
+    Current.user = nil
+  end
+
+  test "erasing works for people deactivated the old way, including their sign-in log" do
+    @kevin.deactivate
+    assert_match(/kevin-deactivated-\h{8}-\h{4}-\h{4}-\h{4}-\h{12}@example\.com/, @kevin.email_address)
+    assert_equal @signed_in_with, @kevin.original_email_address
+    assert SignInEvent.for_address(@signed_in_with).exists?
+
+    User.find(@kevin.id).erase
+
+    assert_not User.exists?(@kevin.id)
+    assert_empty SignInEvent.for_address(@signed_in_with)
+    assert_empty SignInEvent.where("email_address like ?", "kevin%")
+    assert_not Book.exists?(@secret.id)
+    assert_equal "Deleted author", @shared.reload.author
+  end
+
+  test "erasing does not touch other people's sign-in log" do
+    users(:david).sessions.create!(user_agent: "Test", ip_address: "127.0.0.1")
+
+    assert_no_difference -> { SignInEvent.for_address(users(:david).email_address).count } do
+      @kevin.erase
+    end
+  end
+
+  test "original email address is the current one for people never deactivated" do
+    assert_equal "kevin@example.com", @kevin.original_email_address
+  end
+end
