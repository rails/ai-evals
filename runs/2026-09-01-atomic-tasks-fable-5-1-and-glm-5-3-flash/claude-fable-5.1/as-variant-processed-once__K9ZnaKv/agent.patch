@@ -1,8 +1,12 @@
 class Picture < ApplicationRecord
   include Leafable
 
+  # The format is declared as a String rather than a Symbol on purpose: the variant's transformations
+  # travel through a JSON-serialized signed key in the image URL, where a Symbol becomes a String. The
+  # variation digest is computed from the transformations, so a Symbol here would make the background
+  # job and the reader's request derive (and store) two different copies of the same picture.
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
