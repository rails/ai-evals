   end
 end
+
+class PicturesControllerVariantTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "reading a picture after the background job has run does not process it again" do
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:reading_picture)), params: {
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") } }
+    end
+
+    blob = leaves(:reading_picture).reload.leafable.image.blob
+    assert_equal 1, blob.variant_records.count
+
+    transformations = []
+    ActiveSupport::Notifications.subscribed(->(*) { transformations << true }, "transform.active_storage") do
+      get leafable_slug_path(leaves(:reading_picture))
+      assert_response :success
+
+      image_url = css_select("figure img").first["src"]
+      get image_url
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+    end
+
+    assert_empty transformations, "Expected no image processing while serving an already derived picture"
+    assert_equal 1, blob.variant_records.count
+    assert_equal 1, ActiveStorage::Attachment.where(record: blob.variant_records).count
+  end
+end
