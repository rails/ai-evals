diff --git a/app/models/book/access_import.rb b/app/models/book/access_import.rb
index 4d920cf..a3ae616 100644
--- a/app/models/book/access_import.rb
+++ b/app/models/book/access_import.rb
@@ -5,21 +5,59 @@ class Book::AccessImport
     @book, @grants = book, grants
   end
 
+  # Grants every row of the roster in a single write, then notifies the grantees. If any
+  # row is bad (a duplicate of an existing grant, a repeat within the roster, an unknown
+  # user, or an unknown level) nothing is granted, nobody is notified, and the index of
+  # the first bad row is returned instead.
   def import
-    accesses = []
-    duplicate_index = nil
-
-    Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
+    if (index = rejected_index)
+      Result.new([], index)
+    else
+      accesses = Access.transaction { grant_all }
+      notify accesses
+      Result.new(accesses, nil)
+    end
+  rescue ActiveRecord::RecordNotUnique
+    # Somebody was granted access between our check and our insert; check again to name the row.
+    index = rejected_index or raise
+    Result.new([], index)
+  end
+
+  private
+    def rejected_index
+      granted = @book.accesses.where(user_id: user_ids).pluck(:user_id).to_set
+      known = User.where(id: user_ids).pluck(:id).to_set
+      seen = Set.new
+
+      @grants.each_index.find do |index|
+        user_id, level = user_ids[index], @grants[index][:level]
+
+        !valid_level?(level) || !known.include?(user_id) || granted.include?(user_id) || !seen.add?(user_id)
       end
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
-  end
+    def grant_all
+      return [] if @grants.empty?
+
+      @book.accesses.insert_all!(rows)
+      @book.accesses.where(user_id: user_ids).index_by(&:user_id).values_at(*user_ids)
+    end
+
+    def rows
+      @grants.each_index.map do |index|
+        { user_id: user_ids[index], level: Access.levels.fetch(@grants[index][:level].to_s) }
+      end
+    end
+
+    def user_ids
+      @user_ids ||= @grants.map { Access.type_for_attribute(:user_id).cast(it[:user_id]) }
+    end
+
+    def valid_level?(level)
+      Access.levels.key?(level.to_s)
+    end
+
+    def notify(accesses)
+      ActiveJob.perform_all_later(accesses.map { Book::AccessNotificationJob.new(it) })
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..7ffeb23
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Roster", everyone_access: false)
+  end
+
+  test "import grants every row and notifies each person" do
+    grants = [ { user_id: users(:kevin).id, level: "reader" }, { user_id: users(:jz).id, level: :editor } ]
+
+    result = nil
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal [ users(:kevin).id, users(:jz).id ], result.accesses.map(&:user_id)
+    assert_equal %w[ reader editor ], result.accesses.map(&:level)
+    assert result.accesses.all?(&:persisted?)
+    result.accesses.each { assert_enqueued_with(job: Book::AccessNotificationJob, args: [ it ]) }
+
+    assert @book.editable?(user: users(:jz))
+    assert @book.accessable?(user: users(:kevin))
+    assert_not @book.editable?(user: users(:kevin))
+  end
+
+  test "import of an empty roster grants and notifies nobody" do
+    result = nil
+    assert_no_enqueued_jobs { result = Book::AccessImport.new(@book, []).import }
+
+    assert_equal [], result.accesses
+    assert_nil result.duplicate_index
+  end
+
+  test "import writes a fixed number of times however long the roster is" do
+    short = User.all.first(2).map { { user_id: it.id, level: "reader" } }
+    long = User.all.map { { user_id: it.id, level: "reader" } }
+    assert_operator long.size, :>, short.size
+
+    short_writes = count_writes { Book::AccessImport.new(@book, short).import }
+    @book.accesses.delete_all
+    long_writes = count_writes { Book::AccessImport.new(@book, long).import }
+
+    assert_equal short_writes, long_writes
+  end
+
+  test "import of a rejected roster writes a fixed number of times however long the roster is" do
+    @book.accesses.create!(user: users(:david), level: "reader")
+    short = User.all.first(2).map { { user_id: it.id, level: "reader" } }
+    long = User.all.map { { user_id: it.id, level: "reader" } }
+
+    short_writes = count_writes { assert_not_nil Book::AccessImport.new(@book, short).import.duplicate_index }
+    long_writes = count_writes { assert_not_nil Book::AccessImport.new(@book, long).import.duplicate_index }
+
+    assert_equal short_writes, long_writes
+  end
+
+  test "import turns down a roster repeating someone already granted access" do
+    @book.accesses.create!(user: users(:jz), level: "reader")
+    grants = [ { user_id: users(:kevin).id, level: "reader" }, { user_id: users(:jz).id, level: "editor" } ]
+
+    result = nil
+    assert_no_enqueued_jobs { result = Book::AccessImport.new(@book, grants).import }
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_equal [ users(:jz).id ], @book.accesses.pluck(:user_id)
+  end
+
+  test "import turns down a roster naming someone twice" do
+    grants = [ { user_id: users(:kevin).id, level: "reader" }, { user_id: users(:jz).id, level: "reader" }, { user_id: users(:kevin).id, level: "editor" } ]
+
+    result = nil
+    assert_no_enqueued_jobs { result = Book::AccessImport.new(@book, grants).import }
+
+    assert_equal [], result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "import turns down a roster naming an unknown level" do
+    grants = [ { user_id: users(:kevin).id, level: "reader" }, { user_id: users(:jz).id, level: "overlord" } ]
+
+    result = nil
+    assert_nothing_raised do
+      assert_no_enqueued_jobs { result = Book::AccessImport.new(@book, grants).import }
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "import turns down a roster naming an unknown user" do
+    grants = [ { user_id: users(:kevin).id, level: "reader" }, { user_id: -1, level: "reader" } ]
+
+    result = nil
+    assert_no_enqueued_jobs { result = Book::AccessImport.new(@book, grants).import }
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  private
+    def count_writes
+      writes = 0
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+        writes += 1 if payload[:sql].match?(/\A\s*(INSERT|UPDATE|DELETE)/i)
+      end
+      yield
+      writes
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+end
