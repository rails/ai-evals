+  test "create with valid credentials follows a return_to on this host" do
+    post session_url, params: { email_address: "david@example.com", password: "secret123456", return_to: "http://www.example.com/books/1/slug" }
+
+    assert_redirected_to "http://www.example.com/books/1/slug"
+  end
+
+  test "create with valid credentials follows a relative return_to" do
+    post session_url, params: { email_address: "david@example.com", password: "secret123456", return_to: "/books/1/slug?page=2" }
+
+    assert_redirected_to "/books/1/slug?page=2"
+  end
+
+  test "create with valid credentials ignores a return_to pointing elsewhere" do
+    [ "https://evil.example/phish", "//evil.example/phish", "/\evil.example", "http://www.example.com@evil.example/",
+      "javascript:alert(1)", "http://[::1" ].each do |return_to|
+      post session_url, params: { email_address: "david@example.com", password: "secret123456", return_to: return_to }
+
+      assert_redirected_to root_url, "expected #{return_to.inspect} to be ignored"
+      assert parsed_cookies.signed[:session_token]
+    end
+  end
+
