diff --git a/test/integration/pentest_findings_test.rb b/test/integration/pentest_findings_test.rb
new file mode 100644
index 0000000..7d0551f
--- /dev/null
+++ b/test/integration/pentest_findings_test.rb
@@ -0,0 +1,245 @@
+require "test_helper"
+
+# Regression tests for the external penetration test findings PT-01..PT-05.
+class PentestFindingsTest < ActionDispatch::IntegrationTest
+  # ---------------------------------------------------------------- PT-01
+  test "PT-01: a member cannot grant themselves a role via their profile" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: { user: { name: "Kev", role: "administrator" } }
+
+    assert_equal "member", users(:kevin).reload.role
+    assert_equal "Kev", users(:kevin).name
+  end
+
+  test "PT-01: a member cannot change anybody's role via the users endpoint" do
+    sign_in :kevin
+
+    patch user_url(users(:jz)), params: { user: { role: "administrator" } }
+    assert_response :forbidden
+    assert_equal "member", users(:jz).reload.role
+
+    patch user_url(users(:kevin)), params: { user: { role: "administrator" } }
+    assert_response :forbidden
+    assert_equal "member", users(:kevin).reload.role
+  end
+
+  test "PT-01: administrators still change roles" do
+    sign_in :david
+
+    patch user_url(users(:kevin)), params: { user: { role: "administrator" } }
+    assert_redirected_to users_url
+    assert_equal "administrator", users(:kevin).reload.role
+  end
+
+  test "PT-01: everybody still changes their own name, email address and password" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: { user: { name: "Bob", email_address: "bob@example.com", password: "newsecret12345" } }
+    assert_redirected_to users_url
+
+    kevin = users(:kevin).reload
+    assert_equal "Bob", kevin.name
+    assert_equal "bob@example.com", kevin.email_address
+    assert kevin.authenticate("newsecret12345")
+    assert_equal "member", kevin.role
+  end
+
+  # ---------------------------------------------------------------- PT-02
+  test "PT-02: a reader cannot destroy a book" do
+    sign_in :jz # reader on handbook
+
+    assert_no_difference -> { Book.count } do
+      delete book_url(books(:handbook))
+    end
+    assert_response :forbidden
+  end
+
+  test "PT-02: a reader cannot update a book" do
+    sign_in :jz
+
+    patch book_url(books(:handbook)), params: { book: { title: "Pwned" } }
+    assert_response :forbidden
+    assert_equal "Handbook", books(:handbook).reload.title
+  end
+
+  test "PT-02: anybody signed in cannot destroy a published book they only read" do
+    books(:manual).update!(published: true)
+    sign_in :kevin # no access to manual, but it is published
+
+    assert_no_difference -> { Book.count } do
+      delete book_url(books(:manual))
+    end
+    assert_response :forbidden
+  end
+
+  test "PT-02: signed out cannot destroy a published book" do
+    books(:manual).update!(published: true)
+
+    assert_no_difference -> { Book.count } do
+      delete book_url(books(:manual))
+    end
+    assert_redirected_to new_session_url
+  end
+
+  test "PT-02: an editor still changes and deletes a book" do
+    sign_in :kevin # editor on handbook
+
+    patch book_url(books(:handbook)), params: { book: { title: "Renamed" } }
+    assert_redirected_to book_slug_url(books(:handbook))
+    assert_equal "Renamed", books(:handbook).reload.title
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_url(books(:handbook))
+    end
+    assert_redirected_to root_url
+  end
+
+  # ---------------------------------------------------------------- PT-03
+  test "PT-03: search with an apostrophe returns results rather than a server error" do
+    sign_in :kevin
+
+    get library_search_url(q: "Welcome'")
+    assert_response :success
+
+    get library_search_url(q: "'")
+    assert_response :success
+  end
+
+  test "PT-03: search cannot be manipulated to reveal pages from unreadable books" do
+    books(:manual).press Page.new(body: "secret"), title: "Manual Secret Page"
+    sign_in :kevin # no access to manual
+
+    injections = [
+      "%' or 1=1 --",
+      "%' or 1=1 or '",
+      "x' OR books.id = #{books(:manual).id} OR '",
+      "') or ('1'='1"
+    ]
+
+    injections.each do |q|
+      get library_search_url(q: q)
+      assert_response :success, "query #{q.inspect} errored"
+      assert_not_in_body "Manual Secret Page"
+    end
+  end
+
+  test "PT-03: ordinary searches still find what they found" do
+    sign_in :kevin
+
+    get library_search_url(q: "Welcome")
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_in_body "The Welcome Section"
+    assert_not_in_body "Summary"
+
+    get library_search_url(q: "welcome") # case-insensitive like before
+    assert_in_body "Welcome to The Handbook!"
+  end
+
+  test "PT-03: results only come from books the searcher may read" do
+    books(:manual).press Page.new(body: "x"), title: "Welcome to the Manual"
+    sign_in :kevin
+
+    get library_search_url(q: "Welcome")
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Welcome to the Manual"
+
+    # Published books are readable by everyone, signed out included
+    books(:manual).update!(published: true)
+    sign_out
+    get library_search_url(q: "Welcome")
+    assert_response :success
+    assert_in_body "Welcome to the Manual"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  # ---------------------------------------------------------------- PT-04
+  test "PT-04: per cent and underscore are not wildcards, but remain searchable" do
+    books(:handbook).press Page.new(body: "sale"), title: "Save 50% off"
+    books(:handbook).press Page.new(body: "x"), title: "snake_case"
+    sign_in :kevin
+
+    get library_search_url(q: "Save 50% off")
+    assert_response :success
+    assert_in_body "Save 50% off"
+
+    get library_search_url(q: "%")
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_not_in_body "snake_case"
+
+    get library_search_url(q: "_")
+    assert_response :success
+    assert_in_body "snake_case"
+    assert_not_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_url(q: "Save 50_ off")
+    assert_not_in_body "Save 50% off"
+
+    get library_search_url(q: "Welc%")
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  # ---------------------------------------------------------------- PT-05
+  test "PT-05: a page of an unreadable book cannot be rendered under a readable book's id" do
+    manual_leaf = books(:manual).press Page.new(body: "Manual Secret Body"), title: "Manual Secret Page"
+    sign_in :kevin # reads handbook, not manual
+
+    get book_page_url(books(:handbook), manual_leaf)
+    assert_response :not_found
+
+    get slugged_leafable_url(books(:handbook), books(:handbook).slug, manual_leaf, manual_leaf.slug)
+    assert_response :not_found
+
+    get book_page_url(books(:handbook), manual_leaf, format: :md)
+    assert_response :not_found
+
+    get edit_book_page_url(books(:handbook), manual_leaf)
+    assert_response :not_found
+  end
+
+  test "PT-05: an editor of one book cannot edit or delete pages of another via its ids" do
+    manual_leaf = books(:manual).press Page.new(body: "Manual Secret Body"), title: "Manual Secret Page"
+    sign_in :kevin # editor on handbook, nothing on manual
+
+    patch book_page_url(books(:handbook), manual_leaf), params: { page: { body: "Overwritten" } }
+    assert_response :not_found
+    assert_equal "Manual Secret Body", manual_leaf.leafable.reload.body.content
+
+    delete book_page_url(books(:handbook), manual_leaf)
+    assert_response :not_found
+    assert manual_leaf.reload.active?
+  end
+
+  test "PT-05: a page of an unreadable book cannot be rendered signed out under a published book's id" do
+    books(:handbook).update!(published: true)
+    manual_leaf = books(:manual).press Page.new(body: "Manual Secret Body"), title: "Manual Secret Page"
+
+    get book_page_url(books(:handbook), manual_leaf)
+    assert_response :not_found
+
+    get slugged_leafable_url(books(:handbook), books(:handbook).slug, manual_leaf, manual_leaf.slug)
+    assert_response :not_found
+  end
+
+  test "PT-05: pages one may read stay readable, signed out included" do
+    sign_in :kevin
+    get book_page_url(books(:handbook), leaves(:welcome_page))
+    assert_response :success
+    get slugged_leafable_url(books(:handbook), books(:handbook).slug, leaves(:welcome_page), leaves(:welcome_page).slug)
+    assert_response :success
+
+    books(:handbook).update!(published: true)
+    sign_out
+    get book_page_url(books(:handbook), leaves(:welcome_page))
+    assert_response :success
+    get slugged_leafable_url(books(:handbook), books(:handbook).slug, leaves(:welcome_page), leaves(:welcome_page).slug)
+    assert_response :success
+    get book_page_url(books(:handbook), leaves(:welcome_page), format: :md)
+    assert_response :success
+  end
+end
