diff --git a/lib/tasks/users.rake b/lib/tasks/users.rake
new file mode 100644
index 0000000..987929d
--- /dev/null
+++ b/lib/tasks/users.rake
@@ -0,0 +1,12 @@
+namespace :users do
+  desc "Permanently erase a user and everything of theirs (GDPR erasure). Usage: bin/rails users:erase[alice@example.com]"
+  task :erase, [ :email_address ] => :environment do |_, args|
+    email_address = args[:email_address].presence or abort "Usage: bin/rails users:erase[alice@example.com]"
+
+    # Also finds people removed the old way, whose address was rewritten to alice-deactivated-<uuid>@...
+    user = User.find_by_original_email_address(email_address) or abort "No user found for #{email_address}"
+
+    user.erase
+    puts "Erased #{user.name} <#{user.original_email_address}>"
+  end
+end
