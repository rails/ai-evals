diff --git a/app/jobs/application_job.rb b/app/jobs/application_job.rb
index d394c3d..1551c3a 100644
--- a/app/jobs/application_job.rb
+++ b/app/jobs/application_job.rb
@@ -1,4 +1,13 @@
 class ApplicationJob < ActiveJob::Base
+  # Jobs enqueued from inside a database transaction are handed off only once
+  # that transaction has committed, and dropped if it's rolled back. Otherwise a
+  # worker can pick up the job before the records it needs are visible (or for
+  # records that never end up existing at all).
+  #
+  # Jobs that must be enqueued regardless of the surrounding transaction's fate
+  # (e.g. failure notifications) opt out with `self.enqueue_after_transaction_commit = false`.
+  self.enqueue_after_transaction_commit = true
+
   # Automatically retry jobs that encountered a deadlock
   # retry_on ActiveRecord::Deadlocked
 
diff --git a/app/jobs/books/import_failure_job.rb b/app/jobs/books/import_failure_job.rb
index 0bfd478..48cbdb4 100644
--- a/app/jobs/books/import_failure_job.rb
+++ b/app/jobs/books/import_failure_job.rb
@@ -1,4 +1,9 @@
 class Books::ImportFailureJob < ApplicationJob
+  # This job reports that an import was rolled back, so it's enqueued from inside
+  # the very transaction that is about to be abandoned. It must be handed off
+  # immediately rather than deferred to a commit that will never happen.
+  self.enqueue_after_transaction_commit = false
+
   def perform(user_id, message)
     Rails.cache.write("import_failure/#{user_id}", message)
   end
diff --git a/app/models/book/editing.rb b/app/models/book/editing.rb
index d99f523..ab5414f 100644
--- a/app/models/book/editing.rb
+++ b/app/models/book/editing.rb
@@ -1,6 +1,9 @@
 module Book::Editing
   extend ActiveSupport::Concern
 
+  # The jobs are handed off only after the enclosing transaction commits (see
+  # ApplicationJob), so a worker never sees a cover that hasn't been committed
+  # yet, and nothing is enqueued for an edit that ends up rolled back.
   def apply_edit(attributes)
     transaction do
       update!(attributes)
