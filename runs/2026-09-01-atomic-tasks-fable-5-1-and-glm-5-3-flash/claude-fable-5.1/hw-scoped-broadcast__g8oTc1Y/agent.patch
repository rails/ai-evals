diff --git a/test/controllers/being_edited_indicator_test.rb b/test/controllers/being_edited_indicator_test.rb
new file mode 100644
index 0000000..1ddbd2b
--- /dev/null
+++ b/test/controllers/being_edited_indicator_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+
+  setup do
+    @leaf = leaves(:welcome_page)
+    @book = @leaf.book
+  end
+
+  test "editor page subscribes to a stream that is private to the current user" do
+    sign_in :kevin
+    get edit_leafable_path(@leaf)
+
+    assert_response :ok
+    assert_select "turbo-cable-stream-source[signed-stream-name=?]", signed_stream_name(users(:kevin), @leaf, :being_edited)
+    assert_select "turbo-cable-stream-source[signed-stream-name=?]", signed_stream_name(@leaf, :being_edited), count: 0
+  end
+
+  test "saving tells the other current editors who is editing" do
+    sign_in :kevin
+
+    perform_enqueued_jobs do
+      assert_broadcasts stream_name(users(:david), @leaf, :being_edited), 1 do
+        assert_broadcasts stream_name(users(:jason), @leaf, :being_edited), 1 do
+          put leafable_path(@leaf), params: { leaf: { title: "Better welcome" }, page: { body: "Hello" } }
+        end
+      end
+    end
+    assert_response :no_content
+
+    payload = broadcasts(stream_name(users(:david), @leaf, :being_edited)).last
+    assert_includes payload, "Kevin"
+    assert_includes payload, "being_edited_by_user_#{users(:kevin).id}"
+  end
+
+  test "saving does not push presence to readers" do
+    sign_in :kevin
+
+    perform_enqueued_jobs do
+      assert_no_broadcasts stream_name(users(:jz), @leaf, :being_edited) do
+        put leafable_path(@leaf), params: { leaf: { title: "Better welcome" }, page: { body: "Hello" } }
+      end
+    end
+  end
+
+  test "saving does not push presence to a collaborator removed from the book" do
+    # Jason had the editor open while he still had access...
+    sign_in :jason
+    get edit_leafable_path(@leaf)
+    assert_response :ok
+    sign_out
+
+    # ...then he was removed from the book.
+    @book.accesses.find_by(user: users(:jason)).destroy!
+
+    sign_in :kevin
+    perform_enqueued_jobs do
+      assert_no_broadcasts stream_name(users(:jason), @leaf, :being_edited) do
+        assert_no_broadcasts stream_name(@leaf, :being_edited) do
+          assert_broadcasts stream_name(users(:david), @leaf, :being_edited), 1 do
+            put leafable_path(@leaf), params: { leaf: { title: "Better welcome" }, page: { body: "Hello" } }
+          end
+        end
+      end
+    end
+    assert_response :no_content
+  end
+
+  test "saving does not push presence to a collaborator demoted to reader" do
+    @book.access_for(user: users(:kevin)).update! level: :reader
+
+    sign_in :david
+    perform_enqueued_jobs do
+      assert_no_broadcasts stream_name(users(:kevin), @leaf, :being_edited) do
+        assert_broadcasts stream_name(users(:jason), @leaf, :being_edited), 1 do
+          put leafable_path(@leaf), params: { leaf: { title: "Better welcome" }, page: { body: "Hello" } }
+        end
+      end
+    end
+  end
+
+  test "saving does not push presence to the person saving" do
+    sign_in :kevin
+
+    perform_enqueued_jobs do
+      assert_no_broadcasts stream_name(users(:kevin), @leaf, :being_edited) do
+        put leafable_path(@leaf), params: { leaf: { title: "Better welcome" }, page: { body: "Hello" } }
+      end
+    end
+  end
+
+  test "saving does not push presence to deactivated users" do
+    users(:jason).deactivate
+
+    sign_in :kevin
+    perform_enqueued_jobs do
+      assert_no_broadcasts stream_name(users(:jason), @leaf, :being_edited) do
+        put leafable_path(@leaf), params: { leaf: { title: "Better welcome" }, page: { body: "Hello" } }
+      end
+    end
+  end
+
+  test "nothing is broadcast on a stream shared by everyone" do
+    sign_in :kevin
+
+    perform_enqueued_jobs do
+      assert_no_broadcasts stream_name(@leaf, :being_edited) do
+        put leafable_path(@leaf), params: { leaf: { title: "Better welcome" }, page: { body: "Hello" } }
+      end
+    end
+  end
+
+  private
+    def stream_name(*streamables)
+      Turbo::StreamsChannel.send(:stream_name_from, streamables)
+    end
+
+    def signed_stream_name(*streamables)
+      Turbo::StreamsChannel.signed_stream_name(streamables)
+    end
+end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..28aeb3a 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,36 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors are the users who can currently edit the book" do
+    book = books(:handbook)
+
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].sort, book.editors.sort
+  end
+
+  test "editors no longer includes a collaborator removed from the book" do
+    book = books(:handbook)
+
+    book.accesses.find_by(user: users(:kevin)).destroy!
+    assert_not_includes book.editors, users(:kevin)
+
+    book.access_for(user: users(:jason)).update! level: :reader
+    assert_includes book.editors, users(:jason), "administrators with access can still edit"
+  end
+
+  test "editors includes administrators without access only when the book is published" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+
+    assert_equal [ users(:kevin) ], book.editors
+
+    book.update! published: true
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].sort, book.editors.sort
+  end
+
+  test "editors excludes deactivated users" do
+    users(:kevin).deactivate
+
+    assert_not_includes books(:handbook).editors, users(:kevin)
+  end
 end
