@@ -19,6 +19,20 @@ module Writebook
     # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
     config.log_level = ENV.fetch("LOG_LEVEL", "debug")
 
+    # Scripts run through `bin/rails runner` (see script/) report through Rails.logger.
+    # Mirror those lines to the terminal so the operator can read them as they happen,
+    # while still writing every one of them to the environment's log file. Environments
+    # whose logger already writes to the terminal (e.g. production) are left alone.
+    runner do
+      terminal = ActiveSupport::Logger.new(STDOUT)
+      terminal.formatter = Rails.logger.formatter
+      terminal.level = Rails.logger.level
+
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR)
+        Rails.logger.broadcast_to(terminal)
+      end
+    end
+
