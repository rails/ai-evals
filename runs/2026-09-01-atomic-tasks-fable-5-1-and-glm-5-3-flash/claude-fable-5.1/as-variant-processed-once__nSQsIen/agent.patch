diff --git a/app/models/picture.rb b/app/models/picture.rb
index 9bcf18f..36185ac 100644
--- a/app/models/picture.rb
+++ b/app/models/picture.rb
@@ -2,7 +2,10 @@ class Picture < ApplicationRecord
   include Leafable
 
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    # The variation travels inside the picture URL as a JSON-serialized signed key, so its values must
+    # survive that round trip unchanged: a Symbol format would come back as a String and digest to a
+    # different variant record than the one processed in the background, causing a duplicate conversion.
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..8845d98 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class PicturesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -38,4 +40,39 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "an uploaded picture is derived once and served without reprocessing" do
+    leaf = leaves(:reading_picture)
+
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") } }
+      assert_response :no_content
+    end
+
+    blob = leaf.reload.leafable.image.blob
+    derived = blob.variant_records.sole.image
+
+    assert_no_difference [ "ActiveStorage::VariantRecord.count", "ActiveStorage::Blob.count" ] do
+      assert_no_transformations do
+        get book_slug_path(leaf.book)
+        assert_response :ok
+
+        get css_select("img[src*='white-rabbit']").first["src"]
+        assert_response :redirect
+
+        get response.location
+        assert_response :ok
+      end
+    end
+
+    assert_equal derived.download, response.body
+  end
+
+  private
+    def assert_no_transformations
+      transformations = 0
+      ActiveSupport::Notifications.subscribed(->(*) { transformations += 1 }, "transform.active_storage") { yield }
+
+      assert_equal 0, transformations, "Expected no image transformations, but #{transformations} happened"
+    end
 end
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..562b6b1 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -23,4 +23,16 @@ class PictureTest < ActiveSupport::TestCase
 
     assert_equal picture.image, picture.large_image
   end
+
+  test "large_image processed in the background is found again when resolved from its URL key" do
+    picture = pictures(:reading)
+    processed = picture.large_image.processed
+
+    assert_no_difference "ActiveStorage::VariantRecord.count" do
+      resolved = picture.image.blob.representation(processed.variation.key)
+
+      assert_predicate resolved, :processed?
+      assert_equal processed.key, resolved.processed.key
+    end
+  end
 end
