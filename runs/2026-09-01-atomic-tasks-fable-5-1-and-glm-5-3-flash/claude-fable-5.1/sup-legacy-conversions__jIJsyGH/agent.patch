index 0000000..651b21f
--- /dev/null
+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,13 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest lists published books with a short last edited date" do
+    book = books(:handbook)
+    book.update_columns published: true, updated_at: Time.utc(2024, 3, 5, 14, 7, 9)
+
+    mail = ReportDigestMailer.weekly(users(:david))
+
+    assert_equal [ "david@example.com" ], mail.to
+    assert_includes mail.body.encoded, "* Handbook, last edited 05 Mar"
+  end
+end
