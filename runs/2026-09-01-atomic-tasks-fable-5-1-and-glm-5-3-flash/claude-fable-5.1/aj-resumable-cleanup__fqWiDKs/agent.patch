diff --git a/config/initializers/resque.rb b/config/initializers/resque.rb
new file mode 100644
index 0000000..43f2aee
--- /dev/null
+++ b/config/initializers/resque.rb
@@ -0,0 +1,11 @@
+# Tell Active Job when a Resque worker has been asked to shut down (TERM/QUIT),
+# so continuable jobs can checkpoint, requeue themselves, and resume where they
+# left off after a deploy rather than being killed mid-run.
+module ResqueWorkerStopping
+  def shutdown
+    super
+    ActiveJob::Base.queue_adapter.stopping = true if ActiveJob::Base.queue_adapter.respond_to?(:stopping=)
+  end
+end
+
+Resque::Worker.prepend ResqueWorkerStopping
diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
