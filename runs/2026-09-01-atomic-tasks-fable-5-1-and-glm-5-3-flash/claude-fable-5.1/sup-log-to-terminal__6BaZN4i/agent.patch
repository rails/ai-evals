@@ -19,6 +19,22 @@ module Writebook
     # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
     config.log_level = ENV.fetch("LOG_LEVEL", "debug")
 
+    # Scripts run through `bin/rails runner` (e.g. script/library_report.rb) report
+    # through Rails.logger, which normally writes only to the environment's log
+    # file. Mirror those lines to the terminal, as `bin/rails server` does in
+    # development, so the person running the script can actually see them. The
+    # log file keeps receiving everything, and environments whose logger already
+    # writes to the terminal (production) are left alone to avoid duplicate lines.
+    runner do
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR)
+        console = ActiveSupport::Logger.new(STDOUT)
+        console.formatter = Rails.logger.formatter
+        console.level = Rails.logger.level
+
+        Rails.logger.broadcast_to(console)
+      end
+    end
+
