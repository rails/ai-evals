@@ -0,0 +1,38 @@
+require "test_helper"
+
+class PageUploadsTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges its markdown uploads" do
+    page = pages(:welcome)
+    markdown = page.body.tap(&:save!)
+    markdown.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = markdown.uploads.attachments.last
+    blob = attachment.blob
+    page.update!(body: "![reading](#{attachment.slug_path})")
+
+    assert blob.service.exist?(blob.key), "file should exist before destroy"
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id), "attachment record should be gone"
+    assert_not ActiveStorage::Blob.exists?(blob.id), "blob record should be gone"
+    assert_not blob.service.exist?(blob.key), "file should be gone from disk"
+  end
+
+  test "destroying a leaf purges the page's markdown uploads" do
+    page = pages(:welcome)
+    markdown = page.body.tap(&:save!)
+    markdown.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    blob = markdown.uploads.attachments.last.blob
+
+    perform_enqueued_jobs do
+      page.leaf.destroy!
+    end
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+end
