@@ -11,12 +11,19 @@ class SearchesController < ApplicationController
   private
     def matching_leaves
       Leaf.active.joins(:book)
-        .where("books.id in (#{readable_book_ids.join(",")}) and leaves.title like '%#{@query}%'")
+        .where(book_id: readable_book_ids)
+        .where("leaves.title like ? escape '\\'", "%#{escape_like_wildcards(@query)}%")
         .order("books.title", "leaves.position_score")
         .limit(RESULT_LIMIT)
     end
 
+    # The search term is data, never a pattern: the LIKE wildcards are escaped
+    # so that "%" and "_" only match themselves.
+    def escape_like_wildcards(term)
+      term.gsub(/[\\%_]/) { |character| "\\#{character}" }
+    end
+
     def readable_book_ids
-      Book.accessable_or_published.ids.presence || [ 0 ]
+      Book.accessable_or_published.select(:id)
     end
 end
