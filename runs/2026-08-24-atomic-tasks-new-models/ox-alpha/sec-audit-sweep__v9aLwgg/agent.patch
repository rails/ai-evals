diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..7d41909 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -115,3 +115,58 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
 end
+
+class BooksControllerAuthorizationTest < ActionDispatch::IntegrationTest
+  test "destroy requires editor access" do
+    sign_in :jz
+    assert books(:handbook).accessable?(user: users(:jz))
+    assert_not books(:handbook).editable?(user: users(:jz))
+
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:handbook))
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy is not allowed by anybody signed in on a published book they can only read" do
+    sign_in :kevin
+    books(:manual).update!(published: true)
+
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:manual))
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy is not allowed when signed out, even on a published book" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:handbook))
+    end
+
+    assert_redirected_to new_session_url
+  end
+
+  test "destroy still works for an editor" do
+    sign_in :kevin
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+
+    assert_redirected_to root_url
+  end
+
+  test "update still works for an editor of a published book they can only read otherwise" do
+    sign_in :kevin
+
+    patch book_path(books(:handbook)), params: { book: { title: "Renamed Handbook" } }
+
+    assert_redirected_to book_slug_path(books(:handbook))
+    assert_equal "Renamed Handbook", books(:handbook).reload.title
+  end
+end
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..d29f76f 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -118,3 +118,66 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
     assert_response :forbidden
   end
 end
+
+class LeafablesControllerDirectObjectReferenceTest < ActionDispatch::IntegrationTest
+  setup do
+    @secret_leaf = books(:manual).press(Page.new(body: "Manual secret"), title: "Manual Secret")
+  end
+
+  test "show does not render a leaf of another book by tampering with the book id" do
+    sign_in :kevin
+
+    get slugged_leafable_path(book_id: books(:handbook).id, book_slug: books(:handbook).slug, id: @secret_leaf.id, slug: @secret_leaf.slug)
+
+    assert_response :not_found
+  end
+
+  test "edit does not expose a leaf of another book" do
+    sign_in :kevin
+
+    get edit_book_page_path(books(:handbook), @secret_leaf.id)
+
+    assert_response :not_found
+  end
+
+  test "update does not change a leaf of another book" do
+    sign_in :kevin
+
+    patch book_page_path(books(:handbook), @secret_leaf.id), params: { leaf: { title: "Hijacked" } }
+
+    assert_response :not_found
+    assert_equal "Manual Secret", @secret_leaf.reload.title
+  end
+
+  test "destroy does not trash a leaf of another book" do
+    sign_in :kevin
+
+    assert_no_changes -> { @secret_leaf.reload.status } do
+      delete book_page_path(books(:handbook), @secret_leaf.id)
+    end
+
+    assert_response :not_found
+  end
+
+  test "leaves of an accessible book are still reachable under their own ids" do
+    sign_in :jz
+
+    get slugged_leafable_path(book_id: books(:manual).id, book_slug: books(:manual).slug, id: @secret_leaf.id, slug: @secret_leaf.slug)
+
+    assert_response :success
+    assert_in_body "Manual secret"
+  end
+end
+
+class LeafablesControllerDirectObjectReferenceSignedOutTest < ActionDispatch::IntegrationTest
+  test "show does not render a leaf of an unpublished book under a published book's id" do
+    books(:handbook).update!(published: true)
+    secret_leaf = books(:manual).press(Page.new(body: "Manual secret"), title: "Manual Secret")
+    sign_out
+
+    get slugged_leafable_path(book_id: books(:handbook).id, book_slug: books(:handbook).slug,
+      id: secret_leaf.id, slug: secret_leaf.slug)
+
+    assert_response :not_found
+  end
+end
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..07883f9
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  test "show without a query returns no results" do
+    sign_in :kevin
+
+    get library_search_path
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show finds pages by title in books the current user can read" do
+    sign_in :kevin
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_in_body leaves(:welcome_page).title
+    assert_not_in_body "No matches"
+  end
+
+  test "show does not find pages in books the current user cannot read" do
+    sign_in :kevin
+    secret_leaf = books(:manual).press(Page.new(body: "hidden"), title: "Undisclosed Secret Page")
+
+    get library_search_path, params: { q: "Undisclosed Secret Page" }
+
+    assert_response :success
+    assert_select "p", text: /no matches/i
+    assert_select "a[href='#{leafable_slug_path(secret_leaf)}']", count: 0
+  end
+
+  test "show does not let a search term change which books are searched" do
+    sign_in :kevin
+    secret_leaf = books(:manual).press(Page.new(body: "hidden"), title: "Undisclosed Secret Page")
+
+    get library_search_path, params: { q: "' or book_id = #{books(:manual).id} --" }
+
+    assert_response :success
+    assert_select "p", text: /no matches/i
+    assert_select "a[href='#{leafable_slug_path(secret_leaf)}']", count: 0
+  end
+
+  test "show does not let a search term match every page" do
+    sign_in :kevin
+    books(:manual).press(Page.new(body: "hidden"), title: "Undisclosed Secret Page")
+
+    get library_search_path, params: { q: "' or 1 = 1 --" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show treats punctuation as data instead of failing" do
+    sign_in :david
+
+    get library_search_path, params: { q: "O'Brien" }
+    assert_response :success
+
+    get library_search_path, params: { q: "\"%;-- \\" }
+    assert_response :success
+  end
+
+  test "show searches published books when signed out" do
+    books(:handbook).update!(published: true)
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_in_body leaves(:welcome_page).title
+  end
+
+  test "show does not search unpublished books when signed out" do
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select "p", text: /no matches/i
+  end
+
+  test "show matches the percent sign literally" do
+    sign_in :kevin
+    leaves(:welcome_page).update! title: "Save 50% off"
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_in_body "Save 50% off"
+
+    get library_search_path, params: { q: "%" }
+    assert_in_body leaves(:welcome_page).reload.title
+    assert_select "a[href='#{leafable_slug_path(leaves(:summary_page))}']", count: 0
+
+    get library_search_path, params: { q: "50%" }
+    assert_in_body "Save 50% off"
+  end
+
+  test "show matches the underscore literally" do
+    sign_in :kevin
+    leaves(:summary_page).update! title: "snake_case_title"
+
+    get library_search_path, params: { q: "snake_case_title" }
+    assert_in_body "snake_case_title"
+
+    get library_search_path, params: { q: "_" }
+    assert_in_body leaves(:summary_page).reload.title
+    assert_select "a[href='#{leafable_slug_path(leaves(:welcome_page))}']", count: 0
+
+    get library_search_path, params: { q: "snakeXcase" }
+    assert_select "a[href='#{leafable_slug_path(leaves(:summary_page))}']", count: 0
+  end
+end
