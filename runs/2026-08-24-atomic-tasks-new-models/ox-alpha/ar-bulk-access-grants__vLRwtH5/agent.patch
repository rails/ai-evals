   def import
-    accesses = []
-    duplicate_index = nil
+    grants, rejected_index = acceptable_grants
+    return reject(rejected_index) if rejected_index
+
+    accesses = grant_access(grants)
+    return reject(conflicting_index) unless accesses
+
+    accesses.each { |access| Book::AccessNotificationJob.perform_later(access) }
+
+    Result.new(accesses, nil)
+  end
+
+  private
+    # Reads scale with the sheet, and that is what keeps every bad row away from
+    # the database: by the time anything is written, the whole roster is known good.
+    def acceptable_grants
+      taken_user_ids = Set.new(@book.accesses.where(user_id: granted_user_ids).pluck(:user_id))
+      acceptable = []
 
-    Access.transaction do
       @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
+        return [ nil, index ] unless Access.levels.key?(grant[:level].to_s)
+        return [ nil, index ] unless taken_user_ids.add?(user_id_of(grant))
+
+        acceptable << { user_id: user_id_of(grant), level: grant[:level].to_s }
       end
+
+      [ acceptable, nil ]
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
-  end
+    # One round trip for the whole roster, however long it is. Returns nothing
+    # when the database turns down a name we had just seen as free.
+    def grant_access(grants)
+      @book.accesses.insert_all!(grants)
+      granted_accesses(grants)
+    rescue ActiveRecord::RecordNotUnique
+      nil
+    end
+
+    def granted_accesses(grants)
+      granted = @book.accesses.where(user_id: granted_user_ids).index_by(&:user_id)
+      grants.filter_map { |grant| granted[grant[:user_id]] }
+    end
+
+    def conflicting_index
+      @grants.index { |grant| @book.accesses.exists?(user_id: grant[:user_id]) }
+    end
+
+    def granted_user_ids
+      @grants.collect { |grant| user_id_of(grant) }
+    end
+
+    def user_id_of(grant)
+      Access.type_for_attribute(:user_id).cast(grant[:user_id])
+    end
+
+    def reject(index)
+      Result.new([], index)
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..950924b
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+  setup do
+    @book = Book.create!(title: "Import target", everyone_access: false)
+    @users = [ users(:david), users(:jason), users(:jz), users(:kevin) ]
+  end
+
+  test "grants every name on the sheet and lets each person know" do
+    grants = [ { user_id: users(:david).id, level: "reader" },
+               { user_id: users(:jz).id, level: "editor" } ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_nil result.duplicate_index
+    assert_equal [ users(:david).id, users(:jz).id ], result.accesses.map(&:user_id)
+    assert_equal %w[ reader editor ], result.accesses.map(&:level)
+    assert result.accesses.all?(&:persisted?)
+    assert_equal 2, @book.accesses.count
+
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob
+  end
+
+  test "a sheet with a name already on the book is turned down" do
+    @book.accesses.create!(user: users(:kevin), level: "editor")
+    grants = [ { user_id: users(:david).id, level: "reader" },
+               { user_id: users(:kevin).id, level: "reader" },
+               { user_id: users(:jz).id, level: "reader" } ]
+
+    assert_no_enqueued_jobs do
+      result = Book::AccessImport.new(@book, grants).import
+
+      assert_empty result.accesses
+      assert_equal 1, result.duplicate_index
+      assert_equal 1, @book.accesses.count
+    end
+  end
+
+  test "a name repeated on the same sheet is turned down" do
+    grants = [ { user_id: users(:david).id, level: "reader" },
+               { user_id: users(:david).id, level: "editor" } ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_empty result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_empty @book.accesses
+    assert_no_enqueued_jobs
+  end
+
+  test "a sheet naming an unknown level is turned down like any other bad row" do
+    grants = [ { user_id: users(:david).id, level: "reader" },
+               { user_id: users(:jz).id, level: "owner" } ]
+
+    result = assert_nothing_raised do
+      Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_empty result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_empty @book.accesses.reload
+    assert_no_enqueued_jobs
+  end
+
+  test "an empty sheet is taken without granting anything" do
+    result = Book::AccessImport.new(@book, []).import
+
+    assert_nil result.duplicate_index
+    assert_empty result.accesses
+    assert_no_enqueued_jobs
+  end
+
+  test "sixteen names cost what four do, taken or turned down" do
+    roster = (4..15).map { |i| User.create!(name: "Roster #{i}", email_address: "roster#{i}@example.com", password_digest: BCrypt::Password.create("secret123456")) }
+    everyone = @users + roster
+
+    taken_in_fours = queries_made { Book::AccessImport.new(@book, grants_for(everyone.first(4))).import }
+    @book.accesses.delete_all
+    taken_in_sixteens = queries_made { Book::AccessImport.new(@book, grants_for(everyone)).import }
+    @book.accesses.delete_all
+
+    turned_down_in_fours = queries_made {
+      Book::AccessImport.new(@book, grants_for(everyone.first(4)) + [ { user_id: users(:kevin).id, level: "reader" } ]).import
+    }
+    turned_down_in_sixteens = queries_made {
+      Book::AccessImport.new(@book, grants_for(everyone) + [ { user_id: users(:kevin).id, level: "reader" } ]).import
+    }
+
+    assert_equal taken_in_fours, taken_in_sixteens
+    assert_equal turned_down_in_fours, turned_down_in_sixteens
+  end
+
+  private
+    def grants_for(users, level: "reader")
+      users.collect { |user| { user_id: user.id, level: level } }
+    end
+
+    def queries_made
+      queries = []
+      collector = ->(*, payload) { queries << payload[:sql] unless payload[:name] == "SCHEMA" }
+      ActiveSupport::Notifications.subscribed(collector, "sql.active_record") { yield }
+      queries.size
+    end
+end
