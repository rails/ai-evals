@@ -22,6 +24,31 @@ class SessionsController < ApplicationController
   end
 
   private
+    # Shared and emailed links carry the page they point at as ?return_to=, which anyone
+    # can tamper with. Only destinations inside this site are honored, so a crafted link
+    # can't land readers on somebody else's copy of our sign-in page.
+    def safe_return_to_url
+      candidate = params[:return_to].to_s.tr("\\", "/").strip
+      return if candidate.empty?
+
+      uri = URI.parse(candidate)
+      return unless points_within_this_site?(uri)
+
+      uri.to_s
+    rescue URI::Error, ArgumentError
+      nil
+    end
+
+    def points_within_this_site?(uri)
+      return false unless uri.scheme.nil? || uri.scheme.casecmp("http").zero? || uri.scheme.casecmp("https").zero?
+
+      if uri.host.nil?
+        uri.path.start_with?("/")
+      else
+        uri.host.casecmp(request.host).zero?
+      end
+    end
+
     def ensure_user_exists
       redirect_to first_run_url if User.none?
     end
