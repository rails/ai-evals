diff --git a/test/integration/book_toc_caching_test.rb b/test/integration/book_toc_caching_test.rb
new file mode 100644
index 0000000..ac00e5d
--- /dev/null
+++ b/test/integration/book_toc_caching_test.rb
@@ -0,0 +1,177 @@
+require "test_helper"
+
+class BookTocCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    cache_fragments
+  end
+
+  teardown do
+    restore_cache_config
+  end
+
+  test "a reader never sees editor controls, whoever opened the book before them" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_in_body "Edit Welcome to The Handbook!"
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_not_in_body "Edit Welcome to The Handbook!"
+    assert_in_body "Open Welcome to The Handbook!"
+  end
+
+  test "an editor always sees editor controls, whoever opened the book before them" do
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_not_in_body "Edit Welcome to The Handbook!"
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_in_body "Edit Welcome to The Handbook!"
+  end
+
+  test "a visitor never sees editor controls, whoever opened the book before them" do
+    books(:handbook).update! published: true
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_in_body "Edit Welcome to The Handbook!"
+
+    sign_out
+    get book_slug_path(books(:handbook))
+
+    assert_not_in_body "Edit Welcome to The Handbook!"
+    assert_in_body "Open Welcome to The Handbook!"
+  end
+
+  test "an entry renamed still shows its new title to the next person in" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    leaves(:welcome_page).update! title: "Renamed Page"
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_in_body "Open Renamed Page"
+  end
+
+  test "an entry renamed by an editor shows its new title to the next person in" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_in_body "Welcome to The Handbook!"
+
+    put leafable_path(leaves(:welcome_page)),
+      params: { leaf: { title: "Better welcome" }, page: { body: "With even more interesting words." } },
+      as: :turbo_stream
+
+    assert_response :success
+    assert_in_body "Better welcome"
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_in_body "Open Better welcome"
+    assert_not_in_body "Edit Better welcome"
+  end
+
+  test "an entry pressed by an editor is in the table of contents the next person loads" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_not_in_body "Another page"
+
+    post book_pages_path(books(:handbook)),
+      params: { leaf: { title: "Another page" }, page: { body: "Words." } }, as: :turbo_stream
+
+    assert_response :success
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_in_body "Open Another page"
+    assert_not_in_body "Edit Another page"
+  end
+
+  test "somebody promoted to editor gets the controls nobody had shown before" do
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_not_in_body "Edit Welcome to The Handbook!"
+
+    accesses(:jz_handbook).update! level: :editor
+
+    get book_slug_path(books(:handbook))
+
+    assert_in_body "Edit Welcome to The Handbook!"
+  end
+
+  test "somebody demoted to reader loses the controls they used to have" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_in_body "Edit Welcome to The Handbook!"
+
+    accesses(:kevin_handbook).update! level: :reader
+
+    get book_slug_path(books(:handbook))
+
+    assert_not_in_body "Edit Welcome to The Handbook!"
+    assert_in_body "Open Welcome to The Handbook!"
+  end
+
+  test "somebody without access never sees controls on a published book, an administrator always does" do
+    books(:handbook).update! published: true
+    newcomer = User.create! name: "Newcomer", email_address: "newcomer@example.com",
+      password: "secret123456", role: :member
+
+    sign_in newcomer
+    get book_slug_path(books(:handbook))
+
+    assert_not_in_body "Edit Welcome to The Handbook!"
+    assert_in_body "Open Welcome to The Handbook!"
+
+    sign_in users(:david)
+    get book_slug_path(books(:handbook))
+
+    assert_in_body "Edit Welcome to The Handbook!"
+  end
+
+  private
+    # Caching is off in the test environment, so turn it on with a throw-away store for
+    # the duration of each test. Without it none of this would reproduce.
+    def cache_fragments
+      @cache_config = [ ActionController::Base.perform_caching, ActionController::Base.cache_store,
+        ActionView::PartialRenderer.collection_cache ]
+
+      store = ActiveSupport::Cache::MemoryStore.new
+      ActionController::Base.perform_caching = true
+      ActionController::Base.cache_store = store
+      ActionView::PartialRenderer.collection_cache = store
+    end
+
+    def restore_cache_config
+      ActionController::Base.perform_caching, ActionController::Base.cache_store,
+        ActionView::PartialRenderer.collection_cache = @cache_config
+    end
+
+    # Signing in through the app counts against its rate limit, which these tests reach
+    # quickly once fragments are cached for real. Give every login its own address.
+    def sign_in(user)
+      user = users(user) unless user.is_a? User
+      @sign_ins = (@sign_ins || 0) + 1
+
+      post session_url, params: { email_address: user.email_address, password: "secret123456" },
+        env: { "REMOTE_ADDR" => "10.0.0.#{@sign_ins}" }
+
+      assert cookies[:session_token].present?
+    end
+end
