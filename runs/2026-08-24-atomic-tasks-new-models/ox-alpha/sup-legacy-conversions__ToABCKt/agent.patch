diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..3298000
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    @book = books(:handbook)
+  end
+
+  test "show renders the shelf report" do
+    get book_report_path(@book)
+
+    assert_response :success
+    assert_in_body @book.title
+    assert_in_body @book.report_summary
+  end
+
+  test "show renders when the book was last updated" do
+    get book_report_path(@book)
+
+    assert_in_body "Last updated #{@book.updated_at.to_date.to_fs(:long)}"
+  end
+
+  test "show downloads the report card as text" do
+    get book_report_path(@book, format: :text)
+
+    assert_response :success
+    assert_equal Publishing::ReportCard.new(@book).to_text, response.body
+
+    disposition = response.headers["Content-Disposition"]
+    assert_includes disposition, "attachment"
+    assert_includes disposition, "filename=\"shelf-report-#{@book.updated_at.to_fs(:number)}.txt\""
+  end
+end
