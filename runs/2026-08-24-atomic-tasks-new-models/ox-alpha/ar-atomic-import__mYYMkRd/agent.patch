--- a/app/models/book/import.rb
+++ b/app/models/book/import.rb
@@ -1,27 +1,42 @@
 module Book::Import
   extend ActiveSupport::Concern
 
+  # Raised mid-batch to abandon one: unwinding through the batch's
+  # transaction is what keeps a rejected manifest from landing in pieces.
+  class Rejected < StandardError; end
+
   # Imports a manifest — an array of { title:, body: } entries — into the
   # book as sections, in manifest order. Imports are all-or-nothing: a book
-  # must never be left holding part of a manifest.
+  # must never be left holding part of a manifest, so an entry that doesn't
+  # go through abandons every entry before it as well.
   def import_manifest(entries)
     as_one_batch do
       entries.each do |entry|
-        return rejected(entry) unless entry_valid?(entry)
-
-        press(Section.new(body: entry[:body]), title: entry[:title])
+        raise Rejected, rejected(entry) unless entry_accepted?(entry)
       end
     end
     true
+  rescue Rejected => rejection
+    Rails.logger.warn rejection.message
+    false
   end
 
   private
+    # Presses one entry as a section, answering whether the book took it.
+    def entry_accepted?(entry)
+      return false unless entry_valid?(entry)
+
+      press(Section.new(body: entry[:body]), title: entry[:title])
+      true
+    rescue ActiveRecord::RecordInvalid, ActiveRecord::RecordNotSaved
+      false # The book turned this entry away, e.g. a title it already holds.
+    end
+
     def entry_valid?(entry)
       entry[:title].present? && entry[:body].present?
     end
 
     def rejected(entry)
-      Rails.logger.warn "import rejected at #{entry.inspect}"
-      false
+      "import rejected at #{entry.inspect}"
     end
 end
diff --git a/app/models/concerns/batched.rb b/app/models/concerns/batched.rb
index 55a53e7..b34abdb 100644
--- a/app/models/concerns/batched.rb
+++ b/app/models/concerns/batched.rb
@@ -4,9 +4,11 @@ module Batched
   private
     # Runs a batch of writes as a single unit of work: either the whole batch
     # lands or none of it does. The manifest importer goes through here so
-    # that a rejected manifest leaves the book exactly as it was before the
-    # attempt.
+    # that a rejected batch leaves the book exactly as it was before the
+    # attempt — including when the batch runs inside a bigger transaction,
+    # which is why the batch takes its own savepoint rather than joining
+    # whatever is already open.
     def as_one_batch(&block)
-      self.class.transaction(&block)
+      self.class.transaction(requires_new: true, &block)
     end
 end
diff --git a/test/models/book/import_test.rb b/test/models/book/import_test.rb
new file mode 100644
index 0000000..2bd352d
--- /dev/null
+++ b/test/models/book/import_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Book::ImportTest < ActiveSupport::TestCase
+  test "valid manifest imports every entry as a section, in order" do
+    book = books(:manual)
+
+    assert book.import_manifest([
+      { title: "First", body: "First words" },
+      { title: "Second", body: "Second words" }
+    ])
+
+    titles = book.leaves.reload.order(:position_score).pluck(:title)
+    assert_equal %w[ First Second ], titles
+    assert book.leaves.all? { |leaf| leaf.section? }
+  end
+
+  test "empty manifest imports nothing and succeeds" do
+    book = books(:manual)
+
+    assert book.import_manifest([])
+
+    assert_empty book.leaves.reload
+  end
+
+  test "a manifest with a bad entry imports nothing at all" do
+    book = books(:manual)
+    before = book.leaves.count
+
+    assert_not book.import_manifest([
+      { title: "Kept Out", body: "Should never land" },
+      { title: nil, body: "Missing title" }
+    ])
+
+    assert_equal before, book.leaves.reload.count
+    assert_not_includes book.leaves.pluck(:title), "Kept Out"
+  end
+
+  test "a bad entry at the end of a manifest imports nothing at all" do
+    book = books(:manual)
+    before = book.leaves.count
+
+    assert_not book.import_manifest([
+      { title: "One", body: "First" },
+      { title: "Two", body: "Second" },
+      { title: "Three", body: nil }
+    ])
+
+    assert_equal before, book.leaves.reload.count
+  end
+
+  test "an entry the book turns away is a rejection rather than a crash" do
+    book = books(:handbook)
+    before = book.leaves.count
+
+    assert_not book.import_manifest([
+      { title: "Fresh", body: "Fresh words" },
+      { title: leaves(:welcome_section).title, body: "Already taken" }
+    ])
+
+    assert_equal before, book.leaves.reload.count
+    assert_not_includes book.leaves.pluck(:title), "Fresh"
+  end
+
+  test "a duplicate title inside one manifest is a rejection too" do
+    book = books(:manual)
+    before = book.leaves.count
+
+    assert_not book.import_manifest([
+      { title: "Same", body: "First" },
+      { title: "Same", body: "Second" }
+    ])
+
+    assert_equal before, book.leaves.reload.count
+  end
+end
diff --git a/test/models/bulk_import_test.rb b/test/models/bulk_import_test.rb
new file mode 100644
index 0000000..c42c017
--- /dev/null
+++ b/test/models/bulk_import_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class BulkImportTest < ActiveSupport::TestCase
+  test "imports every manifest it accepts" do
+    result = BulkImport.new(
+      books(:manual) => [ { title: "One", body: "First" } ],
+      books(:handbook) => [ { title: "Another", body: "Second" } ]
+    ).run
+
+    assert_equal [ books(:manual), books(:handbook) ].sort_by(&:title), result.imported.sort_by(&:title)
+    assert_equal [ "One" ], books(:manual).leaves.reload.pluck(:title)
+    assert_includes books(:handbook).leaves.reload.pluck(:title), "Another"
+  end
+
+  test "a rejected manifest leaves nothing of itself behind" do
+    before = books(:handbook).leaves.count
+
+    result = BulkImport.new(
+      books(:handbook) => [ { title: "Kept Out", body: "Never lands" }, { title: nil, body: "Bad" } ]
+    ).run
+
+    assert_includes result.rejected, books(:handbook)
+    assert_equal before, books(:handbook).leaves.reload.count
+    assert_not_includes books(:handbook).leaves.pluck(:title), "Kept Out"
+  end
+
+  test "a rejected manifest doesn't cost the importer's other work" do
+    result = BulkImport.new(
+      books(:handbook) => [ { title: "Kept Out", body: "Never lands" }, { title: nil, body: "Bad" } ],
+      books(:manual) => [ { title: "Survivor", body: "Lands" } ]
+    ).run
+
+    assert_equal [ books(:manual) ], result.imported
+    assert_equal [ "Survivor" ], books(:manual).leaves.reload.pluck(:title)
+    assert_empty books(:handbook).leaves.reload.where(title: "Kept Out")
+  end
+end
