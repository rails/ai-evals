new file mode 100644
index 0000000..8b7baf2
--- /dev/null
+++ b/test/models/job_state_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class JobStateTest < ActiveSupport::TestCase
+  test "reads back what was written" do
+    assert_nil JobState.read("title_cleanup_job.last_leaf_id")
+
+    JobState.write("title_cleanup_job.last_leaf_id", 42)
+
+    assert_equal "42", JobState.read("title_cleanup_job.last_leaf_id")
+  end
+
+  test "overwrites instead of duplicating a key" do
+    JobState.write("title_cleanup_job.last_leaf_id", 42)
+    JobState.write("title_cleanup_job.last_leaf_id", 43)
+
+    assert_equal 1, JobState.where(key: "title_cleanup_job.last_leaf_id").count
+    assert_equal "43", JobState.read("title_cleanup_job.last_leaf_id")
+  end
+
+  test "clear forgets about a key" do
+    JobState.write("title_cleanup_job.last_leaf_id", 42)
+
+    JobState.clear("title_cleanup_job.last_leaf_id")
+
+    assert_nil JobState.read("title_cleanup_job.last_leaf_id")
+  end
+end
