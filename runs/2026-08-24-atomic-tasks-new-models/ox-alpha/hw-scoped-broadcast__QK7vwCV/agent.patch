diff --git a/test/controllers/being_edited_indicator_test.rb b/test/controllers/being_edited_indicator_test.rb
new file mode 100644
index 0000000..5cb9aef
--- /dev/null
+++ b/test/controllers/being_edited_indicator_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    @book = books(:handbook)
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "update broadcasts being edited indicator on a stream per editor" do
+    patch book_page_path(@book, @leaf), params: { leaf: { title: "New title" }, page: { body: "New body" } }
+
+    assert_response :no_content
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].map { it.id }.sort, broadcast_recipient_ids.sort
+    assert_equal [ users(:kevin).id ], broadcast_editor_ids.uniq
+  end
+
+  test "update does not broadcast being edited indicator to a collaborator removed from the book" do
+    @book.accesses.find_by(user: users(:jason)).destroy!
+
+    patch book_page_path(@book, @leaf), params: { leaf: { title: "New title" }, page: { body: "New body" } }
+
+    assert_response :no_content
+    assert_not_includes broadcast_recipient_ids, users(:jason).id
+    assert_includes broadcast_recipient_ids, users(:kevin).id
+  end
+
+  test "update does not broadcast being edited indicator to a collaborator demoted to reader" do
+    @book.accesses.find_by(user: users(:jason)).update! level: :reader
+
+    patch book_page_path(@book, @leaf), params: { leaf: { title: "New title" }, page: { body: "New body" } }
+
+    assert_response :no_content
+    assert_not_includes broadcast_recipient_ids, users(:jason).id
+  end
+
+  test "update does not broadcast being edited indicator to readers" do
+    patch book_page_path(@book, @leaf), params: { leaf: { title: "New title" }, page: { body: "New body" } }
+
+    assert_response :no_content
+    assert_not_includes broadcast_recipient_ids, users(:jz).id
+  end
+
+  test "edit subscribes the current user to their own being edited stream" do
+    get edit_book_page_path(@book, @leaf)
+
+    assert_response :success
+    assert_equal [ "#{@leaf.to_gid_param}:being_edited:#{users(:kevin).to_gid_param}" ], subscribed_streams
+  end
+
+  private
+    def broadcast_jobs
+      ActiveJob::Base.queue_adapter.enqueued_jobs.select { |job| job[:job] == Turbo::Streams::BroadcastJob }
+    end
+
+    # The collaborators each being edited indicator is pushed to.
+    def broadcast_recipient_ids
+      broadcast_jobs.map { |job| GlobalID.parse(job[:args].first.split(":").last).model_id.to_i }
+    end
+
+    # The users named in the payloads as editing the leaf.
+    def broadcast_editor_ids
+      broadcast_jobs.filter_map { |job|
+        editor = job.dig(:args, 1, "locals", "user")
+        GlobalID.parse(editor.is_a?(Hash) ? editor["_aj_globalid"] : editor)&.model_id&.to_i
+      }
+    end
+
+    def subscribed_streams
+      Nokogiri::HTML5.parse(response.body)
+        .css("turbo-cable-stream-source")
+        .filter_map { |it| Turbo.signed_stream_verifier.verified(it["signed-stream-name"]) }
+    end
+end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..86d7838 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,32 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors are the collaborators with editor access" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+
+    book.update_access editors: [ users(:kevin).id ], readers: [ users(:jz).id ]
+
+    assert_includes book.editors, users(:kevin)
+    assert_not_includes book.editors, users(:jz)
+    assert_not_includes book.editors, users(:david) # administrators without access are not collaborators
+  end
+
+  test "editors excludes collaborators removed from the book" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+
+    book.update_access editors: [ users(:kevin).id ], readers: []
+    book.accesses.delete_all
+
+    assert_empty book.editors
+  end
+
+  test "editors excludes deactivated collaborators" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+
+    book.update_access editors: [ users(:kevin).id ], readers: []
+    users(:kevin).deactivate
+
+    assert_not_includes book.editors, users(:kevin)
+  end
 end
