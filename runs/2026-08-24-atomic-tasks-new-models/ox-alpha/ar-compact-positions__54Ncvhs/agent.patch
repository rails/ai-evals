+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "live_leaf_count counts only leaves that are not in the trash" do
+    assert_equal 4, books(:handbook).live_leaf_count
+
+    leaves(:summary_page).trashed!
+
+    assert_equal 3, books(:handbook).live_leaf_count
+  end
+
+  test "compact_positions! pulls scores back into a dense sequence" do
+    leaves(:welcome_section).update_column :position_score, 7
+    leaves(:welcome_page).update_column :position_score, 42
+
+    books(:handbook).compact_positions!
+
+    assert_equal [ 1, 2, 3, 4 ], books(:handbook).leaves.positioned.reload.pluck(:position_score).map(&:to_i)
+  end
+
+  test "compact_positions! preserves the arranged order of leaves" do
+    leaves(:welcome_page).move_to_position 3
+    leaves(:summary_page).update_column :position_score, 99
+
+    books(:handbook).compact_positions!
+
+    assert_equal [ leaves(:welcome_section), leaves(:reading_picture), leaves(:welcome_page), leaves(:summary_page) ],
+      books(:handbook).leaves.reload.positioned
+  end
+
+  test "compact_positions! closes the gaps left by deleted leaves" do
+    leaves(:summary_page).trashed!
+
+    books(:handbook).compact_positions!
+
+    assert_equal [ leaves(:welcome_section), leaves(:welcome_page), leaves(:reading_picture) ],
+      books(:handbook).leaves.active.positioned
+    assert_equal [ 1, 2, 4 ], books(:handbook).leaves.active.positioned.pluck(:position_score).map(&:to_i)
+  end
+
+  test "a leaf restored from the trash comes back where it was" do
+    leaves(:welcome_page).move_to_position 3
+    leaves(:summary_page).trashed!
+    books(:handbook).compact_positions!
+
+    leaves(:summary_page).update!(status: :active)
+
+    assert_equal [ leaves(:welcome_section), leaves(:summary_page), leaves(:reading_picture), leaves(:welcome_page) ],
+      books(:handbook).leaves.reload.positioned
+  end
+
+  test "compact_positions! only touches the book being compacted" do
+    leaf = books(:manual).press Page.new(body: "Manual body"), title: "Manual page"
+
+    books(:handbook).compact_positions!
+
+    assert_equal leaf.position_score, leaf.reload.position_score
+  end
+end
