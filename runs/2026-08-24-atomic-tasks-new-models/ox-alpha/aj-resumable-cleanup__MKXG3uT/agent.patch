--- a/app/jobs/title_cleanup_job.rb
+++ b/app/jobs/title_cleanup_job.rb
@@ -1,12 +1,43 @@
 class TitleCleanupJob < ApplicationJob
+  BATCH_SIZE = 1_000
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    Leaf.find_each(start: resume_from_leaf_id, batch_size: BATCH_SIZE) do |leaf|
+      Leaf.transaction do
+        cleaned_title = cleaned(leaf.title)
+        leaf.update!(title: cleaned_title) unless leaf.title == cleaned_title
+
+        TitleCleanupCheckpoint.record(leaf.id)
+      end
     end
+
+    TitleCleanupCheckpoint.discard
   end
 
   private
+    # Leaves are processed in ascending id order and every processed leaf is
+    # checkpointed along with its new title, so an interrupted run picks up at
+    # the leaf it was on rather than starting over from the first one.
+    def resume_from_leaf_id
+      TitleCleanupCheckpoint.leaf_id
+    end
+
+    # The legacy exporter wrapped every title in a pair of double quotes. Strip
+    # exactly that one pair and leave any quotes inside the title alone, so
+    # titles that legitimately open (or close) with a quoted phrase survive.
     def cleaned(title)
-      title.delete_prefix('"').delete_suffix('"')
+      return title unless export_wrapped?(title)
+
+      title[1..-2]
+    end
+
+    def export_wrapped?(title)
+      return false unless title.is_a?(String) && title.length >= 2
+      return false unless title.start_with?('"') && title.end_with?('"')
+
+      # Quotes inside a title come in pairs. If removing the outer pair would
+      # leave one behind, these quotes are part of the title itself and not the
+      # legacy wrapper around it.
+      title[1..-2].count('"').even?
     end
 end
diff --git a/app/models/title_cleanup_checkpoint.rb b/app/models/title_cleanup_checkpoint.rb
new file mode 100644
index 0000000..12b4690
--- /dev/null
+++ b/app/models/title_cleanup_checkpoint.rb
@@ -0,0 +1,24 @@
+# Remembers how far TitleCleanupJob got, so a run that was interrupted by a
+# deploy (or anything else) resumes where it left off instead of starting over.
+#
+# The checkpoint is written in the same transaction as the leaf it follows, so
+# an interrupted run can never skip a leaf and never has to redo more than the
+# one it was on.
+class TitleCleanupCheckpoint < ApplicationRecord
+  # The id of the last leaf that was fully processed, or nil when there is
+  # nothing to resume from.
+  def self.leaf_id
+    first&.leaf_id
+  end
+
+  def self.record(leaf_id)
+    transaction do
+      checkpoint = first || new
+      checkpoint.update!(leaf_id: leaf_id)
+    end
+  end
+
+  def self.discard
+    delete_all
+  end
+end
