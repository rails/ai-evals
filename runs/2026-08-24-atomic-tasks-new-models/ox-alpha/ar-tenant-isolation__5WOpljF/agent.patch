diff --git a/test/integration/tenant_isolation_test.rb b/test/integration/tenant_isolation_test.rb
new file mode 100644
index 0000000..8283dd5
--- /dev/null
+++ b/test/integration/tenant_isolation_test.rb
@@ -0,0 +1,165 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    @user_a = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456", tenant: @tenant_a)
+    @user_b = User.create!(name: "Bob", email_address: "bob@example.com", password: "secret123456", tenant: @tenant_b)
+
+    @book_a = Book.create!(title: "Tenant A Book", everyone_access: false, tenant: @tenant_a)
+    @book_a.update_access editors: [ @user_a.id ], readers: []
+
+    @book_b = Book.create!(title: "Tenant B Book", everyone_access: false, tenant: @tenant_b)
+    @book_b.update_access editors: [], readers: [ @user_b.id ]
+    # Sharing with everyone sprays reader rows across the whole install.
+    @book_b.accesses.create!(user: @user_a, level: :reader)
+
+    @page_b = @book_b.press Page.new(body: "Secret page"), title: "Secret Page"
+    @page_a = @book_a.press Page.new(body: "Shared page"), title: "Shared Page"
+  end
+
+  test "library hides other tenants' books, published or not" do
+    sign_in @user_a
+
+    get root_path
+    assert_response :success
+    assert_in_body "Handbook"
+    assert_not_in_body "Tenant B Book"
+
+    @book_b.update! published: true
+    get root_path
+    assert_not_in_body "Tenant B Book"
+  end
+
+  test "other tenants' books are not found" do
+    sign_in @user_a
+
+    get book_slug_url(@book_b)
+    assert_response :not_found
+  end
+
+  test "published other tenants' books are not found either" do
+    @book_b.update! published: true
+
+    sign_in @user_a
+    get book_slug_url(@book_b)
+    assert_response :not_found
+  end
+
+  test "other tenants' pages are not found" do
+    sign_in @user_a
+
+    get leafable_slug_url(@page_b)
+    assert_response :not_found
+  end
+
+  test "other tenants' edit histories are not found" do
+    @page_b.edit leafable_params: { body: "Edited secret" }
+
+    sign_in @user_a
+    get page_edit_url(@page_b, "latest")
+    assert_response :not_found
+
+    get page_edit_url(@page_b, @page_b.edits.last)
+    assert_response :not_found
+  end
+
+  test "signed out visitors still see every published book, whatever its tenant" do
+    @book_a.update! published: true
+    @book_b.update! published: true
+
+    sign_out
+    get root_path
+
+    assert_response :success
+    assert_in_body "Tenant A Book"
+    assert_in_body "Tenant B Book"
+
+    get leafable_slug_url(@page_b)
+    assert_response :success
+  end
+
+  test "users without a tenant keep seeing everything as before" do
+    sign_in users(:kevin)
+
+    get root_path
+    assert_response :success
+    assert_in_body "Handbook"
+
+    get book_slug_url(books(:handbook))
+    assert_response :success
+  end
+
+  test "new books land in their creator's tenant" do
+    sign_in @user_a
+    post books_url, params: { book: { title: "Fresh Book" } }
+
+    assert_equal @tenant_a, Book.find_by(title: "Fresh Book").tenant
+  end
+
+  test "everything within a tenant keeps working" do
+    @page_a.edit leafable_params: { body: "Edited page" }
+
+    sign_in @user_a
+    get book_slug_url(@book_a)
+    assert_response :success
+
+    get leafable_slug_url(@page_a)
+    assert_response :success
+
+    get page_edit_url(@page_a, "latest")
+    assert_response :success
+    assert_in_body "Edited page"
+
+    assert_difference -> { @book_a.leaves.count }, +1 do
+      post book_pages_path(@book_a, format: :turbo_stream), params: {
+        leaf: { title: "Another page" }, page: { body: "With interesting words." }
+      }
+    end
+  end
+
+test "administrators are not exempt from other tenants' walls" do
+  admin = User.create!(name: "Carol", email_address: "carol@example.com", password: "secret123456", role: :administrator, tenant: @tenant_a)
+
+  sign_in admin
+  get book_slug_url(@book_b)
+  assert_response :not_found
+
+  get root_path
+  assert_not_in_body "Tenant B Book"
+end
+
+test "sharing with everyone does not cross the tenant line" do
+  @book_b.update! everyone_access: true
+  @book_b.update_access editors: [], readers: User.active.ids
+
+  sign_in @user_a
+  get root_path
+  assert_not_in_body "Tenant B Book"
+
+  get leafable_slug_url(@page_b)
+  assert_response :not_found
+end
+
+test "signed out visitors still get a 404 for unpublished books" do
+  sign_out
+
+  get leafable_slug_url(@page_a)
+  assert_response :not_found
+
+  get book_slug_url(@book_a)
+  assert_response :not_found
+end
+
+  test "users page still names everyone on the install" do
+    sign_in @user_a
+
+    get users_path
+    assert_response :success
+    assert_in_body "Alice"
+    assert_in_body "Bob"
+    assert_in_body "David"
+  end
+end
