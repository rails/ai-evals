diff --git a/db/migrate/20260821151515_create_tenants.rb b/db/migrate/20260821151515_create_tenants.rb
new file mode 100644
index 0000000..7912e9f
--- /dev/null
+++ b/db/migrate/20260821151515_create_tenants.rb
@@ -0,0 +1,36 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  DEFAULT_TENANT_NAME = "Writebook"
+
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+
+      t.timestamps
+    end
+
+    add_column :users, :tenant_id, :integer
+    add_column :books, :tenant_id, :integer
+    add_index :users, :tenant_id
+    add_index :books, :tenant_id
+
+    reversible do |direction|
+      direction.up { sweep_existing_records_into_one_tenant }
+    end
+  end
+
+  private
+    # Running installs are upgraded in place: everything that predates tenants
+    # is swept into the single tenant standing in for the whole install.
+    def sweep_existing_records_into_one_tenant
+      return unless User.exists? || Book.exists?
+
+      tenant = Tenant.create!(name: existing_name)
+
+      User.where(tenant_id: nil).update_all(tenant_id: tenant.id)
+      Book.where(tenant_id: nil).update_all(tenant_id: tenant.id)
+    end
+
+    def existing_name
+      Account.order(:id).pick(:name) || DEFAULT_TENANT_NAME
+    end
+end
