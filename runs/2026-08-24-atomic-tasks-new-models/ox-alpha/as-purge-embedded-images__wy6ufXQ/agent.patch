diff --git a/test/models/page_markdown_upload_purge_test.rb b/test/models/page_markdown_upload_purge_test.rb
new file mode 100644
index 0000000..828fa70
--- /dev/null
+++ b/test/models/page_markdown_upload_purge_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class PageMarkdownUploadPurgeTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges its embedded image" do
+    page = pages(:welcome)
+    page.body.uploads.attach file_fixture("reading.webp").open
+    page.save!
+
+    attachment = page.body.uploads.attachments.last
+    markdown = attachment.record
+    blob = attachment.blob
+    path = blob.service.path_for(blob.key)
+    assert File.exist?(path), "Expected the uploaded file to be stored"
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not Page.exists?(page.id), "Expected the page to be gone"
+    assert_not ActionText::Markdown.exists?(markdown.id), "Expected the markdown record to be gone"
+    assert_not ActiveStorage::Attachment.exists?(attachment.id), "Expected the attachment record to be gone"
+    assert_not ActiveStorage::Blob.exists?(blob.id), "Expected the blob record to be gone"
+    assert_not File.exist?(path), "Expected the uploaded file to be purged"
+  end
+
+  test "destroying the leaf of a page purges its embedded image" do
+    page = pages(:summary)
+    page.body.uploads.attach file_fixture("white-rabbit.webp").open
+    page.save!
+
+    blob = page.body.uploads.blobs.last
+    path = blob.service.path_for(blob.key)
+    assert File.exist?(path), "Expected the uploaded file to be stored"
+
+    perform_enqueued_jobs do
+      page.leaf.destroy!
+    end
+
+    assert_not Page.exists?(page.id), "Expected the page to be gone"
+    assert_empty ActiveStorage::Blob.where(id: blob.id), "Expected the blob record to be gone"
+    assert_not File.exist?(path), "Expected the uploaded file to be purged"
+  end
+
+  test "embedded images are purged by the background work triggered by the deletion" do
+    page = pages(:welcome)
+    page.body.uploads.attach file_fixture("reading.webp").open
+    page.save!
+
+    blob = page.body.uploads.blobs.last
+    path = blob.service.path_for(blob.key)
+
+    assert_enqueued_with job: ActiveStorage::PurgeJob do
+      page.destroy!
+    end
+
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Blob.exists?(blob.id), "Expected the blob record to be gone"
+    assert_not File.exist?(path), "Expected the uploaded file to be purged"
+  end
+end
