@@ -0,0 +1,5 @@
+# Rate limit counters outlive a single request and are shared by every test in
+# the process, so drop them before each test to keep the tests independent.
+if Rails.env.test?
+  ActiveSupport::TestCase.setup { RateLimits.reset! }
+end
diff --git a/lib/rate_limits.rb b/lib/rate_limits.rb
new file mode 100644
index 0000000..b5ac146
--- /dev/null
+++ b/lib/rate_limits.rb
@@ -0,0 +1,24 @@
+# The store backing the rate limits declared by controllers.
+#
+# Counters need a cache that can count. Where caching is switched off --
+# development without caching enabled, and every test run -- Rails hands us a
+# NullStore whose increments are thrown away, so those counters are kept in
+# process memory instead. Everywhere else (Redis in production) the counters are
+# shared by every worker serving requests.
+module RateLimits
+  class << self
+    def store
+      Rails.cache.is_a?(ActiveSupport::Cache::NullStore) ? memory_store : Rails.cache
+    end
+
+    # Empties the in-memory counters, so tests start from a clean slate.
+    def reset!
+      memory_store.clear
+    end
+
+    private
+      def memory_store
+        @memory_store ||= ActiveSupport::Cache::MemoryStore.new
+      end
+  end
+end
