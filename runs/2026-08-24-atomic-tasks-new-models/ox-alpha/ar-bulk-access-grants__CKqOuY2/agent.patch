diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..475d03b
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  setup do
+    @book = Book.create!(title: "Import target", everyone_access: false)
+  end
+
+  test "imports a roster of grants and notifies each person once" do
+    roster = new_users(3)
+
+    result, notifications = observe { Book::AccessImport.new(@book, grants_for(roster, level: :reader)).import }
+
+    assert_nil result.duplicate_index
+    assert_equal roster.map(&:id), result.accesses.map(&:user_id)
+    assert result.accesses.all?(&:persisted?)
+    assert_equal roster.map(&:id).sort, @book.accesses.reader.order(:user_id).pluck(:user_id)
+    assert_equal roster.size, notifications
+  end
+
+  test "a taken sheet costs the same whether it names four people or sixteen" do
+    assert_equal statement_count(4), statement_count(16)
+  end
+
+  test "a turned down sheet costs the same whether it names four people or sixteen" do
+    assert_equal rejected_statement_count(4), rejected_statement_count(16)
+  end
+
+  test "does not notify anyone about a sheet that is turned down" do
+    already_on_book = new_users(1).first
+    @book.accesses.create!(user: already_on_book, level: :reader)
+    roster = new_users(2)
+    grants = [ { user_id: already_on_book.id, level: :editor } ] + grants_for(roster, level: :reader)
+
+    result, notifications = observe { Book::AccessImport.new(@book, grants).import }
+
+    assert_empty result.accesses
+    assert_equal 0, result.duplicate_index
+    assert_equal 0, notifications
+    assert_not @book.accessable?(user: roster.first)
+  end
+
+  test "turns down a sheet naming an unknown level instead of blowing up halfway through" do
+    roster = new_users(2)
+    grants = grants_for(roster, level: :reader) + [ { user_id: new_users(1).first.id, level: "boss" } ]
+
+    result, notifications = assert_nothing_raised do
+      observe { Book::AccessImport.new(@book, grants).import }
+    end
+
+    assert_empty result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_equal 0, notifications
+    assert_empty @book.accesses
+  end
+
+  test "turns down a sheet naming the same person twice" do
+    roster = new_users(2)
+
+    result = Book::AccessImport.new(@book, grants_for(roster, level: :reader) + grants_for([ roster.first ], level: :editor)).import
+
+    assert_empty result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_empty @book.accesses
+  end
+
+  test "imports an empty roster" do
+    result = Book::AccessImport.new(@book, []).import
+
+    assert_empty result.accesses
+    assert_nil result.duplicate_index
+  end
+
+  private
+    def new_users(count)
+      Array.new(count) do |index|
+        User.create!(name: "Imported #{index} #{SecureRandom.uuid}",
+          email_address: "imported-#{SecureRandom.uuid}@example.com", password: "secret123456")
+      end
+    end
+
+    def grants_for(users, level:)
+      users.collect { |user| { user_id: user.id, level: level } }
+    end
+
+    def count_statements
+      count = 0
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |event|
+        count += 1 unless event.payload[:name].in?([ "TRANSACTION", "SCHEMA" ])
+      end
+      yield
+      count
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+      count
+    end
+
+    def statement_count(count)
+      book = Book.create!(title: "Statement counting #{count}", everyone_access: false)
+      roster = new_users(count)
+
+      count_statements { Book::AccessImport.new(book, grants_for(roster, level: :reader)).import }
+    end
+
+    def rejected_statement_count(count)
+      book = Book.create!(title: "Rejected statement counting #{count}", everyone_access: false)
+      already_on_book = new_users(1).first
+      book.accesses.create!(user: already_on_book, level: :reader)
+
+      count_statements { Book::AccessImport.new(book, [ { user_id: already_on_book.id, level: :editor } ]).import }
+    end
+
+    def observe
+      notifications = 0
+      subscriber = ActiveSupport::Notifications.subscribe(/enqueue.*\.active_job/) do |event|
+        notifications += 1 if event.payload[:job].is_a?(Book::AccessNotificationJob)
+      end
+      result = yield
+      [ result, notifications ]
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+end
