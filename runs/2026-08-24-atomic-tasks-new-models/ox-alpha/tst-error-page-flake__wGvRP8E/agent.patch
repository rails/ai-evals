diff --git a/test/integration/book_absence_test.rb b/test/integration/book_absence_test.rb
index b9c20ac..6e112d7 100644
--- a/test/integration/book_absence_test.rb
+++ b/test/integration/book_absence_test.rb
@@ -8,4 +8,18 @@ class BookAbsenceTest < ActionDispatch::IntegrationTest
       end
     end
   end
+
+  test "raising exceptions works regardless of what ran before and renders error pages again after" do
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_url(books(:manual))
+      end
+    end
+
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+  end
 end
diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..7ec5a3d 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,30 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Makes controller errors surface as raised exceptions for the duration of the
+    # block, while leaving error page rendering untouched everywhere else.
+    #
+    # Rails snapshots `config.action_dispatch.show_exceptions` into
+    # `Rails.application.env_config` the first time that hash is built, and every
+    # request reads it back from there (`Rails::Engine#build_request`). Tweaking the
+    # config alone therefore only takes effect when no request has been made yet in
+    # this process, so tests would pass or fail depending on which order they happen
+    # to run in within each parallel worker. Write through to both places, then put
+    # both back, so the block is order independent.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      action_dispatch_config = Rails.application.config.action_dispatch
+      env_config = Rails.application.env_config
+
+      show_exceptions_was = action_dispatch_config.show_exceptions
+      env_show_exceptions_was = env_config["action_dispatch.show_exceptions"]
+
+      action_dispatch_config.show_exceptions = :none
+      env_config["action_dispatch.show_exceptions"] = :none
+
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      action_dispatch_config.show_exceptions = show_exceptions_was
+      env_config["action_dispatch.show_exceptions"] = env_show_exceptions_was
     end
   end
 end
