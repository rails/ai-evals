--- a/app/models/book/editing.rb
+++ b/app/models/book/editing.rb
@@ -2,6 +2,8 @@ module Book::Editing
   extend ActiveSupport::Concern
 
   def apply_edit(attributes)
+    # Jobs are handed off once this transaction commits, never while the edit
+    # is still open, so they only ever see committed state.
     transaction do
       update!(attributes)
       Book::SearchIndexJob.perform_later(self)
diff --git a/test/controllers/books/imports_controller_test.rb b/test/controllers/books/imports_controller_test.rb
new file mode 100644
index 0000000..3a435db
--- /dev/null
+++ b/test/controllers/books/imports_controller_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Books::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :david
+  end
+
+  test "a committed import hands off work for every book in the batch" do
+    assert_enqueued_jobs 2, only: Book::SearchIndexJob do
+      post books_import_url, params: { books: {
+        books(:handbook).id.to_s => { title: "Renamed Handbook" },
+        books(:manual).id.to_s => { title: "Renamed Manual" }
+      } }
+    end
+
+    assert_redirected_to root_url
+    assert_equal "Renamed Handbook", books(:handbook).reload.title
+    assert_equal "Renamed Manual", books(:manual).reload.title
+  end
+
+  test "an abandoned import batch notifies its operator but hands off no edit" do
+    assert_enqueued_jobs 1, only: Books::ImportFailureJob do
+      post books_import_url, params: { books: {
+        books(:handbook).id.to_s => { title: "Renamed Handbook" },
+        "-1" => { title: "Missing Book" }
+      } }
+    end
+
+    assert_response :not_found
+    assert_equal "Handbook", books(:handbook).reload.title
+  end
+end
diff --git a/test/models/book/editing_test.rb b/test/models/book/editing_test.rb
new file mode 100644
index 0000000..6ed8e76
--- /dev/null
+++ b/test/models/book/editing_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Book::EditingTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+  include ActionDispatch::TestProcess::FixtureFile
+
+  test "background work is handed off only once the edit has committed" do
+    book = books(:handbook)
+
+    Book.transaction do
+      book.apply_edit title: "New Title"
+
+      assert_no_enqueued_jobs
+    end
+
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+    assert_enqueued_with job: Book::SearchIndexJob, args: [ book ]
+  end
+
+  test "cover processing is handed off only once the edit has committed" do
+    book = books(:handbook)
+
+    Book.transaction do
+      assert_no_enqueued_jobs do
+        book.apply_edit title: "New Title", cover: fixture_file_upload("white-rabbit.webp", "image/webp")
+      end
+    end
+
+    assert_enqueued_with job: Book::CoverProcessingJob, args: [ book ]
+
+    perform_enqueued_jobs
+
+    assert_equal Digest::SHA256.hexdigest(book.cover.blob.download), book.cover.blob.reload.metadata["sha256"]
+  end
+
+  test "abandoned edit hands off nothing" do
+    book = books(:handbook)
+    original_title = book.title
+
+    assert_no_enqueued_jobs do
+      Book.transaction do
+        book.apply_edit title: "New Title", cover: fixture_file_upload("white-rabbit.webp", "image/webp")
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_equal original_title, book.reload.title
+  end
+
+  test "an abandoned import batch hands off nothing but still notifies its operator" do
+    book = books(:handbook)
+
+    assert_no_enqueued_jobs except: Books::ImportFailureJob do
+      Book.transaction do
+        begin
+          book.apply_edit title: "New Title", cover: fixture_file_upload("white-rabbit.webp", "image/webp")
+          raise "boom"
+        rescue StandardError => error
+          Books::ImportFailureJob.perform_later(1, error.message)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert_equal [ Books::ImportFailureJob ], ActiveJob::Base.queue_adapter.enqueued_jobs.map { it[:job] }.uniq
+  end
+end
