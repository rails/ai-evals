diff --git a/test/models/access_archive_test.rb b/test/models/access_archive_test.rb
new file mode 100644
index 0000000..5bddf19
--- /dev/null
+++ b/test/models/access_archive_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class AccessArchiveTest < ActiveSupport::TestCase
+  test "destroying a book archives one entry per person with access" do
+    book = Book.create!(title: "Doomed book", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+
+    assert_difference -> { AccessArchive.count }, 2 do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal({ "Kevin" => "editor", "JZ" => "reader" }, archives.index_by(&:user_name).transform_values(&:level))
+
+    kevin = archives.detect { it.user_name == "Kevin" }
+    assert_equal users(:kevin).id, kevin.user_id
+    assert_equal "Kevin", kevin.user_name
+    assert_equal book.title, kevin.book_title
+
+    jz = archives.detect { it.user_name == "JZ" }
+    assert_equal users(:jz).id, jz.user_id
+    assert_equal "JZ", jz.user_name
+    assert_equal book.title, jz.book_title
+  end
+
+  test "destroying a book does not archive revoked accesses" do
+    book = Book.create!(title: "Doomed book", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id, users(:jz).id ], readers: [])
+    book.update_access(editors: [ users(:jz).id ], readers: [])
+
+    assert_difference -> { AccessArchive.count }, 1 do
+      book.destroy!
+    end
+
+    assert_equal [ users(:jz).name ], AccessArchive.where(book_id: book.id).map(&:user_name)
+  end
+
+  test "destroying a book without accesses archives nothing" do
+    book = Book.create!(title: "Unshared book", everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_empty book.accesses
+  end
+
+  test "nothing is archived when the deletion is rolled back" do
+    book = Book.create!(title: "Rolled back book", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+
+    book.transaction do
+      book.destroy!
+      raise ActiveRecord::Rollback
+    end
+
+    assert Book.exists?(book.id), "expected the book to survive"
+    assert_predicate book.accesses.reload, :any?
+    assert_empty AccessArchive.where(book_id: book.id)
+  end
+end
