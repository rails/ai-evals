-      yield
-    ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+    # Makes requests made inside the block raise their exceptions instead of
+    # rendering error pages. Scoped to the current execution context, so it
+    # never leaks into tests running before, after, or in parallel.
+    def with_raised_exceptions(&block)
+      TestSupport::RaiseExceptions.during(&block)
     end
   end
 end
