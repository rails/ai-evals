diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..a493ef1 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,10 +2,34 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_save :note_live_state_at_start_of_sitting
+    after_commit :announce_publication, on: :update, if: :went_live?
+    after_commit :forget_live_state_at_start_of_sitting
+    after_rollback :forget_live_state_at_start_of_sitting
   end
 
   private
+    # A sitting saves everything together, all or nothing. What matters is
+    # whether the book ends up live compared to how it started out, so remember
+    # the state it was in before anything was saved.
+    def note_live_state_at_start_of_sitting
+      @live_state_at_start_of_sitting = live_in_database? if @live_state_at_start_of_sitting.nil?
+    end
+
+    # Dirty tracking can't answer this at commit time: other changes in the same
+    # sitting (pressing a leaf touches the book) clear it along the way.
+    def went_live?
+      @live_state_at_start_of_sitting == false && published?
+    end
+
+    def live_in_database?
+      ActiveRecord::Type::Boolean.new.cast(published_in_database)
+    end
+
+    def forget_live_state_at_start_of_sitting
+      @live_state_at_start_of_sitting = nil
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
diff --git a/test/controllers/books/publications_controller_test.rb b/test/controllers/books/publications_controller_test.rb
index 8761ea8..5bd0f48 100644
--- a/test/controllers/books/publications_controller_test.rb
+++ b/test/controllers/books/publications_controller_test.rb
@@ -30,3 +30,55 @@ class Books::PublicationsTest < ActionDispatch::IntegrationTest
     assert_equal "new-slug", @book.slug
   end
 end
+
+class Books::PublicationsSittingTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+
+    sign_in :david
+  end
+
+  test "going live and adding a page in the same sitting announces the book exactly once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_path(@book),
+        params: { book: { published: "1" }, added_pages: [ "Added while going live" ] }
+    end
+
+    assert_redirected_to book_slug_url(@book)
+    assert @book.reload.published?
+    assert_equal [ "Added while going live" ], @book.leaves.pluck(:title)
+  end
+
+  test "taking a live book back down announces nothing" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "0" } }
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "saving an already live book announces nothing" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { slug: "still-live" } }
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "a sitting that fails after going live leaves a draft and announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book),
+        params: { book: { published: "1" }, trashed_page_ids: [ "missing" ] }
+    end
+
+    assert_response :not_found
+    assert_not @book.reload.published?
+    assert_empty @book.leaves
+  end
+end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..08b6af1
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+    @book.update! published: false
+  end
+
+  test "a book that ends up live is announced" do
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ] do
+      @book.update! published: true
+    end
+  end
+
+  test "a book that ends up live is announced once, whatever else the sitting did" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: "Fresh words"), title: "Fresh page"
+      end
+    end
+
+    assert @book.reload.published?
+    assert_equal 1, @book.leaves.active.count
+  end
+
+  test "an already live book saved again is not announced again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Renamed while live"
+    end
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "an already live book pressed another leaf is not announced again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.press Page.new(body: ""), title: "Another page"
+        @book.update! slug: "renamed-while-live"
+      end
+    end
+  end
+
+  test "a save that takes a live book down announces nothing" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "a save that leaves a draft book alone announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Still a draft"
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "a sitting that publishes and then takes the book back down announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "a sitting that fails after marking the book live leaves a draft and announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises RuntimeError do
+        @book.transaction do
+          @book.update! published: true
+          raise "the rest of the sitting blew up"
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "a book can still be announced after a failed sitting" do
+    begin
+      @book.transaction do
+        @book.update! published: true
+        raise "boom"
+      end
+    rescue RuntimeError
+    end
+
+    assert_not @book.reload.published?
+
+    assert_enqueued_with job: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+end
