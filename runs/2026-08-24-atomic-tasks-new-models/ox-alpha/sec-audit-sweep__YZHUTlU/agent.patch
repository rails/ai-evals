diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..1f52420
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    Leaf.reindex_all
+  end
+
+  test "show finds leaves in books the user can read" do
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Welcome to The Handbook!/
+  end
+
+  test "show only finds leaves in readable books" do
+    books(:manual).leaves.create! leafable: Section.create!(body: "hidden"), title: "Manual Summary"
+    assert_not books(:manual).accessable?(user: users(:kevin))
+
+    get library_search_path, params: { q: "Manual Summary" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show finds leaves in published books when signed out" do
+    books(:handbook).update!(published: true)
+    sign_out
+
+    get library_search_path, params: { q: "Summary" }
+
+    assert_response :success
+    assert_in_body "Summary"
+  end
+
+  test "show does not find leaves in unpublished books when signed out" do
+    sign_out
+
+    get library_search_path, params: { q: "Summary" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show treats the query as data and not as SQL" do
+    get library_search_path, params: { q: "x%' or books.id not in (#{books(:handbook).id}) --" }
+
+    assert_response :success
+    assert_select "p.search__no_matches"
+  end
+
+  test "show returns results for terms containing punctuation" do
+    get library_search_path, params: { q: "O'Brien" }
+    assert_response :success
+
+    get library_search_path, params: { q: "' or 1=1 --" }
+    assert_response :success
+  end
+
+  test "show matches percent signs literally" do
+    books(:handbook).leaves.create! leafable: Section.create!(body: "discount"), title: "Save 50% off"
+    books(:handbook).leaves.create! leafable: Section.create!(body: "plain"), title: "plain page"
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "Save 50% off"
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "Save 50% off"
+  end
+
+  test "show matches underscores literally" do
+    books(:handbook).leaves.create! leafable: Section.create!(body: "snake"), title: "snake_case_page"
+    books(:handbook).leaves.create! leafable: Section.create!(body: "plain"), title: "plain page"
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "snake_case_page"
+
+    get library_search_path, params: { q: "_case_" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+  end
+end
