diff --git a/test/integration/security_findings_test.rb b/test/integration/security_findings_test.rb
new file mode 100644
index 0000000..71cc752
--- /dev/null
+++ b/test/integration/security_findings_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class SecurityFindingsTest < ActionDispatch::IntegrationTest
+  test "PT-01 no privilege escalation via any request" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: { user: { name: "K", email_address: "k@example.com", password: "secret987654", role: "administrator" } }
+    assert_not users(:kevin).reload.administrator?
+
+    put user_profile_url(users(:jz)), params: { user: { role: "administrator" } }
+    assert_response :forbidden
+    assert_not users(:jz).reload.administrator?
+
+    put user_url(users(:kevin)), params: { user: { role: "administrator" } }
+    assert_response :forbidden
+    assert_not users(:kevin).reload.administrator?
+
+    post join_url(accounts(:signal).join_code), params: { user: { name: "E", email_address: "e@example.com", password: "secret123456", role: "administrator" } }
+    assert_redirected_to root_url
+    assert_not User.last.administrator?
+  end
+
+  test "PT-02 books are only changed or deleted by editors" do
+    sign_in :jz
+    %w[ patch delete ].each do |verb|
+      send verb, book_url(books(:handbook)), params: { book: { title: "X" } }
+      assert_response :forbidden
+    end
+    assert_equal "Handbook", books(:handbook).reload.title
+    assert Book.exists?(books(:handbook).id)
+
+    patch book_publication_url(books(:handbook)), params: { book: { published: "1" } }
+    assert_response :forbidden
+    assert_not books(:handbook).reload.published?
+
+    post book_leaves_moves_url(books(:handbook)), params: { id: leaves(:welcome_page).id, position: 1 }
+    assert_response :forbidden
+
+    delete book_page_url(books(:handbook), leaves(:summary_page))
+    assert_response :forbidden
+  end
+
+  test "PT-02 editors can still edit and destroy" do
+    sign_in :kevin
+    put book_url(books(:handbook)), params: { book: { title: "Renamed Handbook" } }
+    assert_redirected_to book_slug_url(books(:handbook))
+    delete book_url(books(:handbook))
+    assert_redirected_to root_url
+    assert_not Book.exists?(books(:handbook).id)
+  end
+
+  test "PT-03 and PT-04 library search" do
+    sign_in :kevin
+    books(:manual).leaves.create! leafable: Section.create!(body: "x"), title: "Secret Underscore_title"
+    books(:handbook).leaves.create! leafable: Section.create!(body: "y"), title: "Save 50% off"
+    Leaf.reindex_all
+
+    injections = [
+      "' or 1=1 --",
+      "x%' or books.id not in (#{books(:handbook).id}) --",
+      "%' union select * from leaves --",
+      "\"); drop table leaves;--",
+      "'; delete from books; --"
+    ]
+    injections.each do |payload|
+      get library_search_path, params: { q: payload }
+      assert_response :success
+      assert_select "a.search__result", count: 0
+    end
+    assert Book.exists?(books(:manual).id), "database was tampered with"
+
+    get library_search_path, params: { q: "%" }
+    assert_select "a.search__result", count: 1
+    assert_in_body "Save 50% off"
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_select "a.search__result", count: 0, reason: "underscore alone should not match pages without it"
+
+    get library_search_path, params: { q: "50%" }
+    assert_select "a.search__result", count: 1
+    assert_in_body "Save 50% off"
+
+    get library_search_path, params: { q: "Underscore_title" }
+    assert_select "a.search__result", count: 0
+  end
+
+  test "PT-05 leaf ids from another book are rejected everywhere" do
+    sign_in :kevin
+
+    get book_page_path(books(:manual), leaves(:welcome_page))
+    assert_response :not_found
+    get book_section_path(books(:manual), leaves(:welcome_section))
+    assert_response :not_found
+    get book_picture_path(books(:manual), leaves(:reading_picture))
+    assert_response :not_found
+
+    get slugged_leafable_path(books(:manual), books(:manual).slug, leaves(:welcome_page), leaves(:welcome_page).slug)
+    assert_response :not_found
+
+    get book_page_path(books(:manual), leaves(:welcome_page), format: :md)
+    assert_response :not_found
+  end
+
+  test "PT-05 page edits are not reachable without access to the book" do
+    sign_in :jz
+    users(:jz).accesses.delete_all
+
+    get page_edit_path(leaves(:welcome_page), "latest")
+    assert_response :not_found
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :not_found
+  end
+end
