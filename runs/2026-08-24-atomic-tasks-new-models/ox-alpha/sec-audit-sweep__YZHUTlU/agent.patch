@@ -3,6 +3,10 @@ class SearchesController < ApplicationController
 
   RESULT_LIMIT = 50
 
+  # Character used to escape SQL LIKE wildcards in the search term.
+  WILDCARD_ESCAPE_CHARACTER = "\\"
+  WILDCARDS = /[#{Regexp.escape(WILDCARD_ESCAPE_CHARACTER)}%_]/
+
   def show
     @query = params[:q].to_s.strip
     @leaves = @query.present? ? matching_leaves : Leaf.none
@@ -11,11 +15,22 @@ class SearchesController < ApplicationController
   private
     def matching_leaves
       Leaf.active.joins(:book)
-        .where("books.id in (#{readable_book_ids.join(",")}) and leaves.title like '%#{@query}%'")
+        .where(books: { id: readable_book_ids })
+        .where("leaves.title like ? escape ?", like_pattern, WILDCARD_ESCAPE_CHARACTER)
         .order("books.title", "leaves.position_score")
         .limit(RESULT_LIMIT)
     end
 
+    # The term is data, never part of the statement: wildcards are escaped so that
+    # "%", "_" and "\" match themselves instead of acting as patterns.
+    def like_pattern
+      "%#{escape_wildcards(@query)}%"
+    end
+
+    def escape_wildcards(terms)
+      terms.gsub(WILDCARDS) { |character| "#{WILDCARD_ESCAPE_CHARACTER}#{character}" }
+    end
+
     def readable_book_ids
       Book.accessable_or_published.ids.presence || [ 0 ]
     end
