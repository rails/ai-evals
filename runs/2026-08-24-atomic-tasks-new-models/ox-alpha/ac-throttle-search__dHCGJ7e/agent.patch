--- a/app/controllers/books/searches_controller.rb
+++ b/app/controllers/books/searches_controller.rb
@@ -1,9 +1,25 @@
 class Books::SearchesController < ApplicationController
+  # Searching is open to everybody and each search runs a full-text query, which
+  # makes it a cheap way to hammer every published book. Refuse addresses that
+  # ask for more than this many searches in a minute and let go once they stop.
+  RATE_LIMIT = 30
+  RATE_LIMIT_WINDOW = 1.minute
+
   allow_unauthenticated_access
 
+  rate_limit to: RATE_LIMIT, within: RATE_LIMIT_WINDOW, only: :create,
+    store: RateLimit.store, with: :refuse_search
+
   include BookScoped
 
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    def refuse_search
+      response.set_header "Retry-After", RATE_LIMIT_WINDOW.to_i.to_s
+
+      render :too_many_requests, status: :too_many_requests
+    end
 end
diff --git a/app/models/rate_limit.rb b/app/models/rate_limit.rb
new file mode 100644
index 0000000..f5fad68
--- /dev/null
+++ b/app/models/rate_limit.rb
@@ -0,0 +1,15 @@
+# Keeps the counters backing request rate limits.
+#
+# Limits are counted per address in the cache, which is shared by every
+# application server in production. A store that keeps nothing around would
+# turn the protection off without anybody noticing, so those get an in-process
+# replacement instead.
+class RateLimit
+  def self.store
+    Rails.cache.is_a?(ActiveSupport::Cache::NullStore) ? memory_store : Rails.cache
+  end
+
+  def self.memory_store
+    @memory_store ||= ActiveSupport::Cache::MemoryStore.new
+  end
+end
