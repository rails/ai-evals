diff --git a/test/controllers/books/searches_rate_limit_test.rb b/test/controllers/books/searches_rate_limit_test.rb
new file mode 100644
index 0000000..672f21a
--- /dev/null
+++ b/test/controllers/books/searches_rate_limit_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Books::SearchesRateLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    books(:handbook).update! published: true
+    Leaf.reindex_all
+
+    sign_out
+  end
+
+  test "create serves an address up to the limit within a minute" do
+    Books::SearchesController::RATE_LIMIT.times { search_as(address) }
+
+    assert_response :success
+    assert_select "a.search__result"
+  end
+
+  test "create refuses an address searching more than the limit within a minute" do
+    exhaust(address)
+
+    search_as(address)
+
+    assert_response :too_many_requests
+    assert_in_body "Too many requests"
+    assert_equal Books::SearchesController::RATE_LIMIT_WINDOW.to_i.to_s, response.headers["Retry-After"]
+    assert_not response.redirect?
+  end
+
+  test "refusing an address leaves every other address alone" do
+    exhaust(address)
+
+    search_as(address("reader"))
+
+    assert_response :success
+    assert_select "a.search__result"
+  end
+
+  test "a refused address can still read the book" do
+    exhaust(address)
+
+    get book_slug_path(books(:handbook)), headers: { REMOTE_ADDR: address }
+
+    assert_response :success
+    assert_in_body books(:handbook).title
+  end
+
+  test "a refused address is served again once its burst has stopped" do
+    exhaust(address)
+
+    travel_to Books::SearchesController::RATE_LIMIT_WINDOW.from_now + 1.second do
+      search_as(address)
+      assert_response :success
+      assert_select "a.search__result"
+    end
+  end
+
+  test "the limit follows an address from one book to the next" do
+    exhaust(address)
+
+    search_as(address, books(:manual))
+
+    assert_response :too_many_requests
+  end
+
+  private
+    def address(name = "address")
+      @addresses ||= {}
+      @addresses[name] ||= "203.0.113.#{10 + @addresses.size}"
+    end
+
+    def search_as(ip, book = books(:handbook))
+      post book_search_url(book), params: { search: "Thanks" }, headers: { REMOTE_ADDR: ip }
+    end
+
+    def exhaust(ip)
+      Books::SearchesController::RATE_LIMIT.times { search_as(ip) }
+      assert_response :success
+    end
+end
