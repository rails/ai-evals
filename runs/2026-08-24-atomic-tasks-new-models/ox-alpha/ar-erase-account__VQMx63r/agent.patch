diff --git a/test/integration/erasure_test.rb b/test/integration/erasure_test.rb
new file mode 100644
index 0000000..e4b46b1
--- /dev/null
+++ b/test/integration/erasure_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class ErasureTest < ActionDispatch::IntegrationTest
+  test "removing someone erases them, but leaves the books everyone is reading" do
+    sign_in users(:david)
+
+    # joins the account
+    erased = User.create!(name: "Erased Author", email_address: "erased@example.com", password: "secret123456")
+
+    shared_book = Book.create!(title: "Everyone reads this", author: "Erased Author", creator: erased)
+    shared_book.leaves.create!(leafable: Page.create!(body: "still worth reading"), title: "Still here", status: :active)
+
+    private_book = Book.create!(title: "Nobody else reads this", author: "Erased Author",
+      everyone_access: false, creator: erased)
+    private_book.leaves.create!(leafable: Page.create!(body: "gone without a trace"), title: "Gone", status: :active)
+
+    # they use the account, leaving entries in the sign-in log
+    sign_out
+    sign_in erased
+    sign_in_event = SignInEvent.find_by!(email_address: erased.email_address)
+    sign_out
+
+    sign_in users(:david)
+    delete user_url(erased)
+
+    assert_redirected_to users_url
+
+    # not a row of theirs anywhere
+    assert_not User.exists?(erased.id)
+    assert_empty Session.where(user_id: erased.id)
+    assert_empty Access.where(user_id: erased.id)
+    assert_empty ReadingMark.where(user_id: erased.id)
+    assert_empty SignInEvent.where(email_address: [ erased.email_address, "erased@example.com" ])
+
+    # and not a stale search hit either
+    assert_empty Leaf.search("trace")
+
+    # while what everyone is reading is still searchable
+    assert_equal [ "Still here" ], Leaf.search("reading").map(&:title)
+
+    # except for the book everyone shares, which now goes without their name
+    assert_equal "Deleted author", shared_book.reload.author
+    assert_nil shared_book.creator
+    get book_slug_path(shared_book)
+    assert_response :success
+    assert_in_body "Deleted author"
+    assert_not_in_body "Erased Author"
+
+    assert_not Book.exists?(private_book.id)
+
+    # the same goes for people somebody removed the old way
+    old_way = User.create!(name: "Old Way", email_address: "oldway@example.com", password: "secret123456")
+    old_way.update_columns active: false,
+      email_address: old_way.email_address.sub("@", "-deactivated-#{SecureRandom.uuid}@")
+    SignInEvent.create!(email_address: "oldway@example.com", action: :signed_in)
+
+    delete user_url(old_way.reload)
+
+    assert_redirected_to users_url
+    assert_not User.exists?(old_way.id)
+    assert_empty SignInEvent.where(email_address: "oldway@example.com")
+  end
+end
diff --git a/test/models/user_erase_test.rb b/test/models/user_erase_test.rb
new file mode 100644
index 0000000..c79670c
--- /dev/null
+++ b/test/models/user_erase_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class User::EraseTest < ActiveSupport::TestCase
+  setup do
+    @user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    @other = users(:kevin)
+
+    Session.create!(user: @user, token: "alice-token", ip_address: "1.2.3.4",
+      user_agent: "agent", last_active_at: Time.now)
+    ReadingMark.create!(user: @user, leaf: leaves(:welcome_page), last_read_at: Time.now)
+    @sign_in_event = SignInEvent.create!(email_address: @user.email_address, action: :signed_in, ip_address: "1.2.3.4")
+    @other_sign_in_event = SignInEvent.create!(email_address: @other.email_address, action: :signed_in)
+
+    @shared_book = Book.create!(title: "Alice's shared book", slug: "alice-shared", author: "Alice",
+      everyone_access: true, creator: @user)
+    @shared_book.leaves.create!(leafable: Page.create!(body: "read by everyone"), title: "Shared page", status: :active)
+
+    @private_book = Book.create!(title: "Alice's private book", slug: "alice-private", author: "Alice",
+      everyone_access: false, creator: @user)
+    @private_book.leaves.create!(leafable: Page.create!(body: "only alice's words"), title: "Private page", status: :active)
+  end
+
+  test "nothing of theirs is left anywhere" do
+    @user.erase
+
+    assert_not User.exists?(@user.id)
+    assert_empty Session.where(user_id: @user.id)
+    assert_empty Access.where(user_id: @user.id)
+    assert_empty ReadingMark.where(user_id: @user.id)
+    assert_empty SignInEvent.where(email_address: @sign_in_event.email_address)
+    # their sessions go without logging them out
+    assert_empty SignInEvent.where(action: :signed_out)
+  end
+
+  test "books they made that aren't shared with everyone are gone, search hits included" do
+    @user.erase
+
+    assert_not Book.exists?(@private_book.id)
+    assert_empty Leaf.where(book_id: @private_book.id)
+    assert_empty Leaf.search("words")
+  end
+
+  test "books they made that are shared with everyone stay, without their name on them" do
+    reader = User.create!(name: "Reader", email_address: "reader@example.com", password: "secret123456")
+
+    @user.erase
+
+    assert_equal Book::DELETED_AUTHOR, @shared_book.reload.author
+    assert_nil @shared_book.creator
+    assert_equal [ "Shared page" ], Leaf.search("everyone").map(&:title)
+    assert @shared_book.accessable?(user: reader)
+  end
+
+  test "destroying their record outright scrubs them too" do
+    @user.destroy
+
+    assert_not User.exists?(@user.id)
+    assert_equal Book::DELETED_AUTHOR, @shared_book.reload.author
+    assert_not Book.exists?(@private_book.id)
+    assert_empty SignInEvent.where(email_address: @sign_in_event.email_address)
+  end
+
+  test "nothing of anyone else is touched" do
+    assert_no_difference -> { User.where.not(id: @user.id).count } do
+      assert_difference -> { Book.count }, -1 do
+        @user.erase
+      end
+    end
+
+    assert User.exists?(@other.id)
+    assert Book.exists?(books(:handbook).id)
+    assert Book.exists?(books(:manual).id)
+    assert_equal @other_sign_in_event, SignInEvent.find(@other_sign_in_event.id)
+  end
+
+  test "a person removed the old way can be erased too, sign-in log included" do
+    deactivate_the_old_way(@user)
+
+    @user.reload.erase
+
+    assert_not User.exists?(@user.id)
+    assert_empty SignInEvent.where(email_address: @sign_in_event.email_address)
+  end
+
+test "a scrambled address is undone from the back, so their own log is always found" do
+  fan = User.create!(name: "Deactivated Fan", email_address: "deactivated-fan@example.com", password: "secret123456")
+  event = SignInEvent.create!(email_address: fan.email_address, action: :signed_in)
+
+  deactivate_the_old_way(fan)
+  fan.reload.erase
+
+  assert_not User.exists?(fan.id)
+  assert_empty SignInEvent.where(email_address: event.email_address)
+end
+
+  test "the sign-in log of someone who now uses their old address survives" do
+    deactivate_the_old_way(@user)
+
+    someone_new = User.create!(name: "Alice II", email_address: @sign_in_event.email_address, password: "secret123456")
+    event = SignInEvent.create!(email_address: someone_new.email_address, action: :signed_in)
+
+    @user.reload.erase
+
+    assert SignInEvent.exists?(event.id)
+  end
+
+  private
+    # How people were taken off the account before erasure was a thing.
+    def deactivate_the_old_way(user, local_part: user.name.parameterize)
+      address = "#{local_part}@example.com"
+      user.update_columns active: false,
+        email_address: address.sub("@", "-deactivated-#{SecureRandom.uuid}@")
+
+      SignInEvent.where(email_address: address).delete_all
+      SignInEvent.create!(email_address: address, action: :signed_in)
+    end
+end
