 class User < ApplicationRecord
   include Authoring, Role, Transferable
 
-  has_many :sessions, dependent: :destroy
+  # Deactivated accounts had their address rewritten so they can't sign in anymore,
+  # e.g. "alice-deactivated-b1c7d9f4-...@example.com".
+  DEACTIVATED_EMAIL_MARKER = "-deactivated-"
+
+  has_many :sessions, dependent: :delete_all
   has_secure_password validations: false
 
-  has_many :accesses, dependent: :destroy
+  has_many :accesses, dependent: :delete_all
   has_many :books, through: :accesses
   has_many :leaves, through: :books
 
+  before_destroy :scrub_traces, prepend: true
+
   after_create :grant_access_to_everyone_books
 
   scope :active, -> { where(active: true) }
+  scope :inactive, -> { where.not(active: true) }
   scope :ordered, -> { order(:name) }
 
   def current?
     self == Current.user
   end
 
-  def deactivate
-    transaction do
-      sessions.delete_all
-      update! active: false, email_address: deactived_email_address
-    end
+  # Erase every trace of this person: their account, their sessions, their accesses,
+  # their reading activity and their sign-in log. Books they created that are shared
+  # with everyone stay online for the people reading them, but without their name.
+  def erase
+    transaction { destroy! }
   end
 
+  # Removing someone from the account means erasing them.
+  alias_method :deactivate, :erase
+
   private
-    def deactived_email_address
-      email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
+    # Runs ahead of destroying anything this person created, so that books shared with
+    # everyone are kept instead of being taken down along with them.
+    def scrub_traces
+      SignInEvent.where(email_address: email_addresses_signed_in_with).delete_all
+      retire_created_books
+    end
+
+    # Addresses this person may appear under in the sign-in log. Whatever they signed
+    # in with counts as theirs, unless somebody has since taken that address over.
+    def email_addresses_signed_in_with
+      [ email_address, original_email_address ].compact.uniq.reject { |address|
+        address != email_address && User.where.not(id: id).exists?(email_address: address)
+      }
+    end
+
+    # The address they signed in with, before it was rewritten on deactivation.
+    def original_email_address
+      local_part, separator, domain = email_address.to_s.rpartition("@")
+
+      if cut_at = local_part.rindex(DEACTIVATED_EMAIL_MARKER)
+        [ local_part[0, cut_at], separator, domain ].join
+      else
+        email_address
+      end
+    end
+
+    def retire_created_books
+      created_books.find_each do |book|
+        book.everyone_access? ? book.anonymize! : book.destroy!
+      end
     end
 
     def grant_access_to_everyone_books
