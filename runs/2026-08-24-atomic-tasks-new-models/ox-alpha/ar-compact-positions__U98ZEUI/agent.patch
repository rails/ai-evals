@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compact_positions! keeps the hand-arranged order of leaves" do
+    book = books(:handbook)
+
+    leaves(:welcome_page).update!(position_score: 2.5)
+    leaves(:summary_page).update!(position_score: 100)
+    leaves(:reading_picture).update!(position_score: 0.5)
+
+    book.compact_positions!
+
+    assert_equal \
+      [ "Reading", "The Welcome Section", "Welcome to The Handbook!", "Summary" ],
+      book.leaves.positioned.map(&:title)
+  end
+
+  test "compact_positions! pulls positions back into a dense sequence" do
+    book = books(:handbook)
+    leaves(:welcome_page).update!(position_score: 42.5)
+    leaves(:reading_picture).update!(position_score: 1e-7)
+
+    book.compact_positions!
+
+    assert_equal [ 1, 2, 3, 4 ], book.leaves.positioned.map(&:position_score).map(&:to_i)
+  end
+
+  test "compact_positions! ranks by position rather than by creation order" do
+    book = books(:handbook)
+    leaves(:reading_picture).update!(position_score: 0.5)
+
+    book.compact_positions!
+
+    assert_equal leaves(:reading_picture), book.leaves.positioned.first
+    assert_equal [ 1, 2, 3, 4 ], book.leaves.positioned.map(&:position_score).map(&:to_i)
+  end
+
+  test "a leaf restored from the trash lands back where it was after compaction" do
+    book = books(:handbook)
+    leaves(:reading_picture).update!(position_score: 42.5)
+    leaves(:summary_page).trashed!
+
+    book.compact_positions!
+    leaves(:summary_page).update!(status: "active")
+
+    assert_equal \
+      [ "The Welcome Section", "Welcome to The Handbook!", "Summary", "Reading" ],
+      book.leaves.active.positioned.map(&:title)
+  end
+
+  test "compact_positions! does not touch other books" do
+    other = books(:manual).press Page.new(body: "Other page"), title: "Other page"
+    other.update!(position_score: 37.5)
+
+    books(:handbook).compact_positions!
+
+    assert_equal 37.5, other.reload.position_score
+  end
+
+  test "live_leaf_count counts leaves that are not trashed" do
+    assert_equal 4, books(:handbook).live_leaf_count
+
+    leaves(:summary_page).trashed!
+
+    assert_equal 3, books(:handbook).live_leaf_count
+  end
+
+  test "live_leaf_count counts an empty book as zero" do
+    assert_equal 0, books(:manual).live_leaf_count
+  end
+end
