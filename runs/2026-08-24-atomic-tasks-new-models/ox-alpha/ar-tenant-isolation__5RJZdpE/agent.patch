diff --git a/test/integration/tenants_test.rb b/test/integration/tenants_test.rb
new file mode 100644
index 0000000..36ad0ad
--- /dev/null
+++ b/test/integration/tenants_test.rb
@@ -0,0 +1,168 @@
+require "test_helper"
+
+class TenantsTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    users(:david).update! tenant: @tenant_a
+    books(:handbook).update! tenant: @tenant_a
+
+    users(:jason).update! tenant: @tenant_b
+    books(:manual).update! tenant: @tenant_b
+
+    # Sharing with everyone sprays reader rows across the whole install, so a
+    # customer A user ends up holding an access row for a customer B book:
+    # fixtures(:david_manual) gives David reader access to the Manual.
+
+    @foreign_leaf = books(:manual).press Page.new(body: "Customer B secrets"), title: "Secrets"
+    @foreign_leaf.edit leafable_params: { body: "Customer B edited secrets" }
+  end
+
+  test "index hides other tenants' books, published or not" do
+    sign_in :david
+    books(:manual).update!(published: true)
+
+    get root_url
+
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual", count: 0
+  end
+
+  test "other tenants' books are not found, even when published" do
+    sign_in :david
+    books(:manual).update!(published: true)
+
+    get book_slug_url(books(:manual))
+
+    assert_response :not_found
+  end
+
+  test "an access row for another tenant's book buys no way in" do
+    sign_in :david
+
+    get book_slug_url(books(:manual))
+
+    assert_response :not_found
+  end
+
+  test "pages inside another tenant's book are not found" do
+    sign_in :david
+
+    get leafable_slug_url(@foreign_leaf)
+    assert_response :not_found
+
+    get book_page_url(books(:manual), @foreign_leaf)
+    assert_response :not_found
+  end
+
+  test "edit histories inside another tenant's book are not found" do
+    sign_in :david
+
+    get page_edit_url(@foreign_leaf, "latest")
+    assert_response :not_found
+
+    get page_edit_url(@foreign_leaf, @foreign_leaf.edits.last)
+    assert_response :not_found
+  end
+
+  test "probing another tenant's book keeps the user signed in" do
+    sign_in :david
+
+    get book_slug_url(books(:manual))
+    get leafable_slug_url(@foreign_leaf)
+    get page_edit_url(@foreign_leaf, "latest")
+
+    assert parsed_cookies.signed[:session_token].present?
+
+    get book_slug_url(books(:handbook))
+    assert_response :success
+  end
+
+  test "users see everything inside their own tenant" do
+    sign_in :jason
+
+    get root_url
+    assert_select "h2", text: "Manual"
+    assert_select "h2", text: "Handbook", count: 0
+
+    get book_slug_url(books(:manual))
+    assert_response :success
+
+    get leafable_slug_url(@foreign_leaf)
+    assert_response :success
+
+    get page_edit_url(@foreign_leaf, "latest")
+    assert_response :success
+  end
+
+  test "signed out visitors see every published book, whatever tenant it belongs to" do
+    books(:handbook).update!(published: true)
+    books(:manual).update!(published: true)
+    sign_out
+
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual"
+
+    get leafable_slug_url(@foreign_leaf)
+    assert_response :success
+  end
+
+  test "/users still names everyone on the install" do
+    sign_in :david
+
+    get users_url
+
+    assert_response :success
+    User.active.each { |user| assert_in_body user.name }
+  end
+
+  test "new books land in their creator's tenant" do
+    sign_in :jason
+
+    assert_difference -> { Book.count }, +1 do
+      post books_url, params: { book: { title: "Tenant B Book", everyone_access: false } }
+    end
+
+    assert_equal @tenant_b.id, Book.last.tenant_id
+  end
+
+  test "new users only get reader access to everyone books of their own tenant" do
+    books(:handbook).update!(everyone_access: true)
+
+    bob = User.create! name: "Bob", email_address: "bob@example.com", password: "secret123456", tenant: @tenant_b
+
+    assert books(:manual).accessable?(user: bob)
+    assert_not books(:handbook).accessable?(user: bob)
+  end
+
+  test "rows without a tenant behave as they always have" do
+    untenant_book = Book.create! title: "Untenanted"
+    untenant_book.update_access editors: [], readers: []
+    untenant_user = User.create! name: "Carol", email_address: "carol@example.com", password: "secret123456"
+
+    assert_nil users(:kevin).reload.tenant_id
+    assert_nil untenant_book.tenant_id
+
+    assert untenant_book.accessable?(user: users(:kevin))
+    assert untenant_book.accessable?(user: untenant_user)
+    assert untenant_book.accessable?(user: users(:david))
+
+    untenant_leaf = untenant_book.press Page.new(body: "Shared words"), title: "Shared"
+
+    sign_in untenant_user
+    get book_slug_url(untenant_book)
+    assert_response :success
+
+    untenant_leaf.edit leafable_params: { body: "Shared edited words" }
+
+    get leafable_slug_url(untenant_leaf)
+    assert_response :success
+
+    get page_edit_url(untenant_leaf, "latest")
+    assert_response :success
+  end
+end
