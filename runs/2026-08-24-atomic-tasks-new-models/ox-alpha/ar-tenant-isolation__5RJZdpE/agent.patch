diff --git a/app/models/concerns/tenant_scoped.rb b/app/models/concerns/tenant_scoped.rb
new file mode 100644
index 0000000..09605f3
--- /dev/null
+++ b/app/models/concerns/tenant_scoped.rb
@@ -0,0 +1,24 @@
+module TenantScoped extend ActiveSupport::Concern
+  class_methods do
+    # Limits records to the ones sharing a tenant with the given record. A
+    # record without a tenant is shared with every tenant, so rows that predate
+    # tenancy keep behaving as they always have.
+    def in_tenant_of(record)
+      tenant_id = record.respond_to?(:tenant_id) ? record.tenant_id : record
+
+      if tenant_id.present?
+        where(tenant_id: [ nil, tenant_id ])
+      else
+        all
+      end
+    end
+  end
+
+  # Whether the record may be seen alongside the given record, i.e. when
+  # neither of them belongs to another tenant.
+  def in_same_tenant_as?(record)
+    other_tenant_id = record.respond_to?(:tenant_id) ? record.tenant_id : record
+
+    tenant_id.blank? || other_tenant_id.blank? || tenant_id == other_tenant_id
+  end
+end
