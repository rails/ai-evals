diff --git a/db/migrate/20241014120000_create_tenants.rb b/db/migrate/20241014120000_create_tenants.rb
new file mode 100644
index 0000000..082df09
--- /dev/null
+++ b/db/migrate/20241014120000_create_tenants.rb
@@ -0,0 +1,23 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |direction|
+      direction.up do
+        # Existing installs hold a single set of customers: sweep them all into
+        # one tenant so they upgrade in place without anyone losing their books.
+        tenant = Tenant.create!(name: "Writebook")
+
+        User.update_all tenant_id: tenant.id
+        Book.update_all tenant_id: tenant.id
+      end
+    end
+  end
+end
