diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..64ca888
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Roster book", everyone_access: false)
+    @users = 3.times.map { |i| User.create!(name: "Roster #{i}", email_address: "roster#{i}@example.com", password: "secret12345") }
+    @serial = 0
+  end
+
+  test "grants everyone on the roster their level" do
+    grants = [ { user_id: @users[0].id, level: "reader" }, { user_id: @users[1].id, level: "editor" } ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_nil result.duplicate_index
+    assert_equal [ @users[0].id, @users[1].id ], result.accesses.map(&:user_id)
+    assert result.accesses.all?(&:persisted?)
+    assert result.accesses.first.reader?
+    assert result.accesses.last.editor?
+
+    assert @book.accessable?(user: @users[0])
+    assert @book.editable?(user: @users[1])
+  end
+
+  test "lets each person on an accepted roster know" do
+    Book::AccessImport.new(@book, roster_grants(3)).import
+
+    assert_enqueued_jobs 3, only: Book::AccessNotificationJob
+  end
+
+  test "lets nobody know about a roster that was turned down" do
+    Book::AccessImport.new(@book, [ { user_id: @users[0].id, level: "editor" } ]).import
+
+    latecomer = @users[1]
+    grants = [ { user_id: latecomer.id, level: "reader" }, { user_id: @users[0].id, level: "reader" } ]
+
+    assert_no_enqueued_jobs do
+      result = Book::AccessImport.new(@book, grants).import
+
+      assert_equal 1, result.duplicate_index
+      assert_empty result.accesses
+    end
+
+    assert_not @book.accessable?(user: latecomer)
+    assert_equal 1, @book.accesses.count
+  end
+
+  test "rejects a sheet naming the same person twice" do
+    grants = [
+      { user_id: @users[0].id, level: "reader" },
+      { user_id: @users[1].id, level: "reader" },
+      { user_id: @users[1].id, level: "editor" }
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal 2, result.duplicate_index
+    assert_empty result.accesses
+    assert_empty @book.accesses
+  end
+
+  test "turns down a sheet naming a level nobody has heard of" do
+    grants = [ { user_id: @users[0].id, level: "reader" }, { user_id: @users[1].id, level: "owner" } ]
+
+    assert_no_enqueued_jobs do
+      result = Book::AccessImport.new(@book, grants).import
+
+      assert_equal 1, result.duplicate_index
+      assert_empty result.accesses
+    end
+
+    assert_empty @book.accesses
+  end
+
+  test "a long roster costs no more than a short one, whether taken or turned down" do
+    costs = {
+      accepted_4: cost_of(roster_grants(4)),
+      accepted_16: cost_of(roster_grants(16)),
+      rejected_4: cost_of(rejected_roster_grants(4), duplicate_at: 3),
+      rejected_16: cost_of(rejected_roster_grants(16), duplicate_at: 15)
+    }
+
+    assert_equal costs[:accepted_4], costs[:accepted_16]
+    assert_equal costs[:rejected_4], costs[:rejected_16]
+  end
+
+  private
+    def roster_grants(size)
+      (0...size).map { |i|
+        { user_id: new_user("sheet#{size}#{next_serial}").id, level: i.even? ? "reader" : "editor" }
+      }
+    end
+
+    # A roster whose final row is already on the book, so it gets turned down.
+    def rejected_roster_grants(size)
+      taken = { user_id: new_user("taken#{size}").id, level: "reader" }
+      Book::AccessImport.new(@book, [ taken ]).import
+      roster_grants(size - 1) << taken
+    end
+
+    def new_user(name)
+      User.create!(name: name, email_address: "#{name}@example.com", password: "secret12345")
+    end
+
+    def next_serial
+      @serial += 1
+    end
+
+    def cost_of(grants, duplicate_at: nil)
+      statements = 0
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") { |*_, payload|
+        unless payload[:name].nil? || payload[:sql] =~ /\A(BEGIN|COMMIT|SAVEPOINT|RELEASE)/i
+          statements += 1
+        end
+      }
+      result = Book::AccessImport.new(@book, grants).import
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+
+      duplicate_at.nil? ? assert_nil(result.duplicate_index) : assert_equal(duplicate_at, result.duplicate_index)
+      if duplicate_at.nil?
+        assert_equal grants.size, result.accesses.size
+        perform_enqueued_jobs
+      else
+        assert_empty result.accesses
+      end
+
+      statements
+    end
+end
