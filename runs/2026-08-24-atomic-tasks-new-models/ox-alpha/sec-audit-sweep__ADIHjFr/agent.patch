diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..65b6d86
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @offers = Book.create! title: "Offers", slug: "offers", published: true
+    @offers.press Page.new(body: "Half price for everyone"), title: "Save 50% off"
+
+    @files = Book.create! title: "Files", slug: "files"
+    @files.press Page.new(body: "Table of contents"), title: "file_name.txt"
+    users(:david).accesses.create! book: @files, level: :editor
+  end
+
+  test "show finds matching titles" do
+    sign_in :david
+
+    get library_search_path, params: { q: "handbook" }
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Save 50% off"
+  end
+
+  test "show only finds leaves of books the signed in user can read" do
+    sign_in :jz
+
+    get library_search_path, params: { q: "_" }
+
+    assert_response :success
+    assert_not_in_body "file_name.txt"
+  end
+
+  test "show only finds leaves of published books when not signed in" do
+    sign_out
+
+    get library_search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "file_name.txt"
+  end
+
+  test "show treats the term as data" do
+    sign_in :david
+
+    get library_search_path, params: { q: "no matches' --" }
+
+    assert_response :success
+    assert_in_body "No matches."
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show does not error on punctuation" do
+    sign_in :david
+
+    get library_search_path, params: { q: "50%" }
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+  end
+
+  test "show matches pattern characters literally" do
+    sign_in :david
+
+    get library_search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "file_name.txt"
+    assert_not_in_body "The Welcome Section"
+
+    get library_search_path, params: { q: "_" }
+
+    assert_response :success
+    assert_in_body "file_name.txt"
+    assert_not_in_body "Save 50% off"
+    assert_not_in_body "The Welcome Section"
+
+    get library_search_path, params: { q: "Save 50% off" }
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+  end
+
+  test "show renders without results for an empty term" do
+    get library_search_path
+
+    assert_response :success
+    assert_select "p.search__no_matches", count: 0
+  end
+end
diff --git a/test/controllers/users/profiles_controller_test.rb b/test/controllers/users/profiles_controller_test.rb
index 7564f7d..f9bd7fc 100644
--- a/test/controllers/users/profiles_controller_test.rb
+++ b/test/controllers/users/profiles_controller_test.rb
@@ -38,4 +38,44 @@ class Users::ProfilesControllerTest < ActionDispatch::IntegrationTest
     assert_response :forbidden
     assert_equal "Kevin", users(:kevin).reload.name
   end
+
+  test "update does not change the role" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: { user: { name: "Kevin", role: "administrator" } }
+
+    assert_redirected_to users_url
+    assert_equal "member", users(:kevin).reload.role
+  end
+
+  test "update does not change the role of another user" do
+    sign_in :kevin
+
+    put user_profile_url(users(:jz)), params: { user: { role: "administrator" } }
+
+    assert_response :forbidden
+    assert_equal "member", users(:jz).reload.role
+  end
+
+  test "update changes name, email address and password" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: {
+      user: { name: "Kev", email_address: "kev@example.com", password: "newsecret123456" }
+    }
+
+    assert_redirected_to users_url
+    assert_equal "Kev", users(:kevin).reload.name
+    assert_equal "kev@example.com", users(:kevin).email_address
+    assert users(:kevin).authenticate("newsecret123456")
+  end
+
+  test "administrator can still change a member's role" do
+    sign_in :david
+
+    put user_url(users(:jz)), params: { user: { role: "administrator" } }
+
+    assert_redirected_to users_url
+    assert_equal "administrator", users(:jz).reload.role
+  end
 end
