@@ -26,4 +28,26 @@ class PageTest < ActiveSupport::TestCase
     assert_includes page.searchable_content, "5 &lt; 10 &amp; 10 &gt; 5"
     assert page.searchable_content.html_safe?
   end
+
+  test "destroying a page purges its embedded image uploads" do
+    leaf = books(:handbook).press Page.new(body: "A picture page"), title: "With picture"
+    page = leaf.page
+
+    File.open(Rails.root.join("test/fixtures/files/white-rabbit.webp")) do |file|
+      page.body.uploads.attach io: file, filename: "white-rabbit.webp", content_type: "image/webp"
+    end
+
+    attachment = page.body.uploads.attachments.last
+    blob = attachment.blob
+
+    page.update! body: "![White rabbit](#{attachment.slug_path})"
+    assert ActiveStorage::Blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs { page.destroy! }
+
+    assert_not ActionText::Markdown.exists?(page.markdown_body.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(blob.key)
+  end
 end
