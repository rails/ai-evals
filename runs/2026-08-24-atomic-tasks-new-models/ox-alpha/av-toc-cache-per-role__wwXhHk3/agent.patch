 module BooksHelper
+  # Whether the current user may edit the book. Memoized per request so that
+  # permission-aware cache keys do not cost a lookup for every entry of the
+  # table of contents.
+  def book_editable?(book)
+    @editable_books ||= {}
+    @editable_books[book.id] ||= book.editable?
+  end
