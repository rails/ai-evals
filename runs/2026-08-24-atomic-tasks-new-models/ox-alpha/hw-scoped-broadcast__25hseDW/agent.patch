diff --git a/app/controllers/leafables_controller.rb b/app/controllers/leafables_controller.rb
index c1aa391..0da32bb 100644
--- a/app/controllers/leafables_controller.rb
+++ b/app/controllers/leafables_controller.rb
@@ -67,7 +67,12 @@ class LeafablesController < ApplicationController
     end
 
     def broadcast_being_edited_indicator
-      Turbo::StreamsChannel.broadcast_render_later_to @leaf, :being_edited,
-        partial: "leaves/being_edited_by", locals: { leaf: @leaf, user: Current.user }
+      # Who is editing is only ever sent to those who can currently edit the book, on a stream of
+      # their own. That way someone removed from the book, but left with an open editor, no longer
+      # receives it.
+      @book.editors.each do |editor|
+        Turbo::StreamsChannel.broadcast_render_later_to editor, @leaf, :being_edited,
+          partial: "leaves/being_edited_by", locals: { leaf: @leaf, user: Current.user }
+      end
     end
 end
diff --git a/app/models/book/accessable.rb b/app/models/book/accessable.rb
index aa3dcf1..02a47c5 100644
--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -32,6 +32,13 @@ module Book::Accessable
     accesses.find_by(user: user)
   end
 
+  # Everyone who can edit this book right now: those with editor access plus administrators.
+  def editors
+    editors_with_access = accesses.where(level: :editor).select(:user_id)
+
+    User.active.where(id: editors_with_access).or(User.active.administrator)
+  end
+
   def update_access(editors:, readers:)
     editors = Set.new(editors)
     readers = Set.new(everyone_access? ? User.active.ids : readers)
