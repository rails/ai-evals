diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..f43a4e5 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -118,3 +118,74 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
     assert_response :forbidden
   end
 end
+
+class LeafablesControllerBeingEditedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+
+    @book = books(:handbook)
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "update broadcasts the being-edited indicator to editors of the book" do
+    perform_enqueued_jobs do
+      patch leafable_path(@leaf), params: { page: { body: "Edited by Kevin." } }
+
+      assert_turbo_stream_broadcasts [ users(:kevin), @leaf, :being_edited ], count: 1
+      assert_turbo_stream_broadcasts [ users(:david), @leaf, :being_edited ], count: 1
+    end
+  end
+
+  test "update does not broadcast the being-edited indicator to a collaborator removed from the book" do
+    sign_in :david
+
+    @book.access_for(user: users(:kevin)).destroy!
+
+    perform_enqueued_jobs do
+      patch leafable_path(@leaf), params: { page: { body: "Edited by David." } }
+
+      assert_no_turbo_stream_broadcasts [ users(:kevin), @leaf, :being_edited ]
+      assert_turbo_stream_broadcasts [ users(:david), @leaf, :being_edited ], count: 1
+    end
+  end
+
+  test "update does not broadcast the being-edited indicator to a collaborator demoted to reader" do
+    sign_in :david
+
+    @book.access_for(user: users(:kevin)).update! level: :reader
+
+    perform_enqueued_jobs do
+      patch leafable_path(@leaf), params: { page: { body: "Edited by David." } }
+
+      assert_no_turbo_stream_broadcasts [ users(:kevin), @leaf, :being_edited ]
+    end
+  end
+
+  test "update does not broadcast the being-edited indicator on a channel anyone removed from the book can listen on" do
+    perform_enqueued_jobs do
+      patch leafable_path(@leaf), params: { page: { body: "Edited by Kevin." } }
+
+      assert_no_turbo_stream_broadcasts [ @leaf, :being_edited ]
+    end
+  end
+
+  test "edit subscribes the current user to their own being-edited stream" do
+    get edit_book_page_path(@book, @leaf)
+
+    assert_response :success
+
+    assert_select "turbo-cable-stream-source[signed-stream-name]" do |sources|
+      signed_stream_names = sources.pluck("signed-stream-name")
+
+      assert_equal [ Turbo::StreamsChannel.signed_stream_name([ users(:kevin), @leaf, :being_edited ]) ], signed_stream_names
+    end
+  end
+
+  test "edit does not subscribe other users to the being-edited stream" do
+    get edit_book_page_path(@book, @leaf)
+
+    assert_response :success
+
+    assert_not_in_body Turbo::StreamsChannel.signed_stream_name([ users(:jason), @leaf, :being_edited ])
+  end
+end
