+++ b/test/scripts/library_report_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  test "report is shown on the terminal and recorded in the environment log file" do
+    log_path = Rails.root.join("log", "#{Rails.env}.log")
+    offset = File.exist?(log_path) ? File.size(log_path) : 0
+
+    output, status = Open3.capture2("bin/rails", "runner", "-e", Rails.env,
+      "script/library_report.rb", chdir: Rails.root)
+
+    assert_predicate status, :success?
+
+    # The report reaches the terminal, and nothing else does.
+    reported = output.lines.map(&:chomp)
+    assert_not_empty reported
+    assert_includes reported, "Library report: #{Book.count} books"
+    assert_equal "Library report: done", reported.last
+
+    # ...and the exact same lines land in the environment's log file.
+    appended = File.exist?(log_path) ? File.read(log_path).byteslice(offset..).to_s : ""
+    assert_equal reported, appended.lines.map(&:chomp).grep(/\ALibrary report: /)
+  end
+end
