@@ -0,0 +1,43 @@
+require "test_helper"
+
+class UsersErasureControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @alice = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    @shared_book = Book.create!(title: "Shared book", author: "Alice", creator: @alice, everyone_access: true)
+  end
+
+  test "removing someone erases them" do
+    sign_in :david
+
+    assert_difference -> { User.count }, -1 do
+      delete user_url(@alice)
+    end
+
+    assert_redirected_to users_url
+    assert_not User.exists?(@alice.id)
+    assert_equal "Deleted author", @shared_book.reload.author
+    assert_nil @shared_book.reload.creator
+  end
+
+  test "removing works for people already removed the old way" do
+    @alice.update_columns active: false, email_address: "alice-deactivated-#{SecureRandom.uuid}@example.com"
+    sign_in :david
+
+    assert_difference -> { User.count }, -1 do
+      delete user_url(@alice)
+    end
+
+    assert_redirected_to users_url
+    assert_not User.exists?(@alice.id)
+  end
+
+  test "removing is not allowed for non-admins" do
+    sign_in :kevin
+
+    assert_no_difference -> { User.count } do
+      delete user_url(@alice)
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/user_erasure_test.rb b/test/models/user_erasure_test.rb
new file mode 100644
index 0000000..b6d3fd5
--- /dev/null
+++ b/test/models/user_erasure_test.rb
@@ -0,0 +1,152 @@
+require "test_helper"
+
+class UserErasureTest < ActiveSupport::TestCase
+  setup do
+    @alice = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+
+    @shared_book = Book.create!(title: "Shared book", author: "Alice", creator: @alice, everyone_access: true)
+    @shared_book.press Page.new(body: "Words by Alice worth keeping"), title: "Kept page"
+    @shared_book.reload
+
+    @private_book = Book.create!(title: "Private book", author: "Alice", creator: @alice, everyone_access: false)
+    @private_leaf = @private_book.press Page.new(body: "Secret words from Alice"), title: "Secret page"
+
+    @collab_book = Book.create!(title: "Collaboration", creator: users(:jason), everyone_access: false)
+    Access.create!(user: @alice, book: @collab_book, level: :editor)
+
+    ReadingMark.create!(user: @alice, leaf: leaves(:welcome_page), last_read_at: Time.now)
+    Session.create!(user: @alice, ip_address: "127.0.0.1", user_agent: "test")
+  end
+
+  test "erase leaves nothing of the person behind" do
+    SignInEvent.create!(email_address: @alice.email_address, action: "signed_in")
+
+    assert_difference -> { User.count }, -1 do
+      @alice.erase
+    end
+
+    assert_not User.exists?(@alice.id)
+    assert_empty Session.where(user_id: @alice.id)
+    assert_empty Access.where(user_id: @alice.id)
+    assert_empty ReadingMark.where(user_id: @alice.id)
+    assert_empty SignInEvent.where(email_address: "alice@example.com")
+
+    assert_empty Access.where(book_id: @collab_book.id)
+    assert Book.exists?(@collab_book.id)
+  end
+
+  test "erase keeps books shared with everyone but takes the author's name off" do
+    @alice.erase
+
+    kept = Book.find(@shared_book.id)
+    assert_equal "Deleted author", kept.author
+    assert_nil kept.creator
+    assert_equal "Kept page", kept.leaves.active.first.title
+    assert Leaf.with_search_results_for("keeping").exists?(id: kept.leaves.first.id)
+  end
+
+  test "erase removes their other books together with their search hits" do
+    @alice.erase
+
+    assert_not Book.exists?(@private_book.id)
+    assert_empty Leaf.where(book_id: @private_book.id)
+    assert_empty Leaf.connection.select_rows("select rowid from leaf_search_index where rowid = #{@private_leaf.id}")
+  end
+
+  test "erase works for people removed the old way" do
+    scrambled = "alice-deactivated-#{SecureRandom.uuid}@example.com"
+    @alice.update_columns active: false, email_address: scrambled
+    SignInEvent.create!(email_address: "alice@example.com", action: "signed_in")
+    SignInEvent.create!(email_address: scrambled, action: "signed_out")
+
+    @alice.erase
+
+    assert_not User.exists?(@alice.id)
+    assert_empty SignInEvent.where(email_address: [ "alice@example.com", scrambled ])
+    assert_equal "Deleted author", Book.find(@shared_book.id).author
+    assert_not Book.exists?(@private_book.id)
+    assert_empty Session.where(user_id: @alice.id)
+  end
+
+test "erase clears the sign-in log however the old address was scrambled" do
+  alina = User.create!(name: "Alina", email_address: "alina-deactivated-1234@example.com",
+    password: "secret123456", active: false)
+  SignInEvent.create!(email_address: "alina@example.com", action: "signed_in")
+  SignInEvent.create!(email_address: alina.email_address, action: "signed_out")
+
+  assert_equal [ alina.email_address, "alina@example.com" ].sort, alina.known_email_addresses.sort
+
+  alina.erase
+
+  assert_not SignInEvent.where("email_address like ?", "alina%@example.com").exists?
+end
+
+  test "erase logs no sign-out for people whose sessions are already loaded" do
+    book = Book.create!(title: "Shared", creator: @alice, everyone_access: true)
+    Session.create!(user: @alice, ip_address: "127.0.0.1", user_agent: "test") # logs a signed_in event
+    @alice.sessions.to_a
+
+    @alice.erase
+
+    assert_empty SignInEvent.where(action: "signed_out")
+    assert Book.exists?(book.id)
+    assert_empty Session.where(user_id: @alice.id)
+  end
+
+  test "erasing yourself does not hand your books back to you" do
+    Current.user = @alice
+
+    @alice.erase
+
+    assert_nil @shared_book.reload.creator
+    assert_equal "Deleted author", @shared_book.author
+  ensure
+    Current.user = nil
+  end
+
+  test "erasing someone with no books and no history works" do
+    newcomer = User.create!(name: "Newcomer", email_address: "newcomer@example.com", password: "secret123456")
+
+    newcomer.erase
+
+    assert_not User.exists?(newcomer.id)
+  end
+
+  test "a plain destroy erases as well" do
+    assert_difference -> { User.count }, -1 do
+      @alice.destroy
+    end
+
+    assert_not User.exists?(@alice.id)
+    assert_equal "Deleted author", Book.find(@shared_book.id).author
+    assert_nil Book.find(@shared_book.id).creator
+    assert_not Book.exists?(@private_book.id)
+    assert_empty Leaf.connection.select_rows("select rowid from leaf_search_index where rowid = #{@private_leaf.id}")
+  end
+
+  test "erasing keeps the pictures of books shared with everyone" do
+    picture_book = Book.create!(title: "Pictured", author: "Alice", creator: @alice, everyone_access: true)
+    leaf = picture_book.press Picture.new, title: "Reading"
+    leaf.leafable.image.attach io: Rails.root.join("test/fixtures/files/reading.webp").open, filename: "reading.webp"
+
+    @alice.erase
+
+    kept = Book.find(picture_book.id)
+    assert_equal "Deleted author", kept.author
+    assert kept.leaves.first.leafable.image.attached?
+  end
+
+  test "erasing keeps other people's access to books shared with everyone" do
+    Access.create!(user: users(:jz), book: @shared_book, level: :editor)
+
+    @alice.erase
+
+    assert Access.exists?(user: users(:jz), book: @shared_book)
+  end
+
+  test "erasing an unsaved person is a no-op" do
+    assert_no_difference -> { User.count } do
+      User.new(name: "Nobody", email_address: "nobody@example.com").erase
+    end
+  end
+end
