+  # Erasure is the only way a person leaves the account, so it happens no
+  # matter which destruction path got us here.
+  before_destroy :erase_traces, prepend: true
+
   scope :active, -> { where(active: true) }
+  scope :inactive, -> { where.not(active: true) }
   scope :ordered, -> { order(:name) }
 
   def current?
     self == Current.user
   end
 
-  def deactivate
-    transaction do
-      sessions.delete_all
-      update! active: false, email_address: deactived_email_address
-    end
+  # Erases every trace of this person: their row, their sessions, accesses,
+  # reading marks and sign-in log entries, plus every book they created that
+  # isn't shared with everyone.
+  def erase
+    transaction { destroy! }
+  end
+
+  # Removing someone now means erasing them, so the old name is kept as a
+  # synonym for anything still calling it.
+  alias_method :deactivate, :erase
+
+  # The addresses this person can be traced back to: whatever address they
+  # carry now -- deactivation rewrote theirs -- and the one they actually
+  # signed in with.
+  def known_email_addresses
+    [ email_address, pre_deactivation_email_address ].compact_blank.uniq
+  end
+
+  def pre_deactivation_email_address
+    email_address.to_s.gsub(DEACTIVATED_EMAIL_ADDRESS, "@").presence
   end
 
   private
-    def deactived_email_address
-      email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
+    def erase_traces
+      return unless persisted?
+
+      strip_authorship
+      ReadingMark.where(user_id: id).delete_all
+      Access.where(user_id: id).delete_all
+      Session.where(user_id: id).delete_all
+      erase_sign_in_events
+    ensure
+      # Forget the associations held in memory as well, so their own removal
+      # callbacks can't resurrect anything we just erased.
+      created_books.reset
+      sessions.reset
+      accesses.reset
+    end
+
+    # Books shared with everyone stay up for the people reading them, they're
+    # just bylined "Deleted author" instead of naming someone who's gone.
+    # Everything else they created goes away, search index included.
+    def strip_authorship
+      authored_books = Book.where(creator_id: id)
+
+      authored_books.with_everyone_access.find_each do |book|
+        book.update_columns author: Book::DELETED_AUTHOR, creator_id: nil, updated_at: Time.current
+      end
+
+      authored_books.where.not(everyone_access: true).destroy_all
+    end
+
+    # Sign-in events are logged under the address used at the time, so people
+    # removed the old way have them under their original address.
+    def erase_sign_in_events
+      addresses = known_email_addresses
+      SignInEvent.where(email_address: addresses).delete_all if addresses.any?
     end
 
     def grant_access_to_everyone_books
