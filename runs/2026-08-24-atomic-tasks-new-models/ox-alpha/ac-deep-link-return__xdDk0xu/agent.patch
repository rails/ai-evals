diff --git a/app/controllers/concerns/authentication.rb b/app/controllers/concerns/authentication.rb
index 0040b33..0bf7796 100644
--- a/app/controllers/concerns/authentication.rb
+++ b/app/controllers/concerns/authentication.rb
@@ -71,6 +71,40 @@ module Authentication
       session.delete(:return_to_after_authenticating) || root_url
     end
 
+    # Where to send someone who has just authenticated. A requested +return_to+
+    # target is only honored when it addresses this very application, so links
+    # can carry readers to the page they asked for, but never off site.
+    def post_authenticating_return_to_url(fallback = post_authenticating_url)
+      local_path_from(params[:return_to]).presence || fallback
+    end
+
+    # Reduces a requested target to a path on this application, or returns nil
+    # when it points anywhere else: other hosts, other schemes, opaque URIs.
+    def local_path_from(value)
+      uri = parse_target(value)
+
+      return nil unless uri
+      return nil if uri.host.present? && uri.host.downcase != request.host.to_s.downcase
+      return nil unless uri.path.start_with?("/")
+
+      "#{uri.path}#{uri.query ? "?#{uri.query}" : nil}#{uri.fragment ? "##{uri.fragment}" : nil}"
+    end
+
+    def parse_target(value)
+      # Drop control characters and whitespace, and treat "\" as "/" the way
+      # browsers do, so targets can't smuggle an authority past the checks above.
+      candidate = value.to_s.delete("\u0000-\u0020").tr("\\", "/")
+      return nil if candidate.blank?
+
+      uri = URI.parse(candidate)
+      return nil unless uri.is_a?(URI::Generic)
+      return nil if uri.scheme.present? && %w[ http https ].exclude?(uri.scheme.downcase)
+
+      uri
+    rescue URI::Error
+      nil
+    end
+
     def set_authentication_cookie(session)
       cookies.signed.permanent[:session_token] = { value: session.token, httponly: true, same_site: :lax }
     end
