diff --git a/test/integration/tenant_scoping_test.rb b/test/integration/tenant_scoping_test.rb
new file mode 100644
index 0000000..301c990
--- /dev/null
+++ b/test/integration/tenant_scoping_test.rb
@@ -0,0 +1,145 @@
+require "test_helper"
+
+class TenantScopingTest < ActionDispatch::IntegrationTest
+  setup do
+    @customer_a = Tenant.create!(name: "Customer A")
+    @customer_b = Tenant.create!(name: "Customer B")
+
+    @alice = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456", tenant: @customer_a)
+    @bob = User.create!(name: "Bob", email_address: "bob@example.com", password: "secret123456", role: :administrator, tenant: @customer_b)
+
+    @a_book = tenanted_book("Customer A Handbook", tenant: @customer_a, published: false)
+    @a_book.update_access editors: [ @alice.id ], readers: []
+
+    @b_book = tenanted_book("Customer B Handbook", tenant: @customer_b, published: true)
+    @b_book.update_access editors: [ @bob.id ], readers: []
+  end
+
+  test "library hides other tenants' books, published or not" do
+    sign_in @alice
+
+    get root_path
+
+    assert_response :success
+    assert_in_body @a_book.title
+    assert_not_in_body @b_book.title
+  end
+
+  test "other tenants' books answer 404" do
+    sign_in @alice
+
+    get book_slug_path(@b_book)
+
+    assert_response :not_found
+  end
+
+  test "pages inside other tenants' books answer 404" do
+    b_page = press_page(@b_book, "Customer B Page")
+    sign_in @alice
+
+    get slugged_leafable_path(b_page.book, b_page.book.slug, b_page, b_page.slug)
+    assert_response :not_found
+
+    get book_page_path(book_id: b_page.book_id, id: b_page.id)
+    assert_response :not_found
+  end
+
+  test "edit histories inside other tenants' books answer 404" do
+    b_page = press_page(@b_book, "Customer B Page")
+    b_page.edit leafable_params: { body: "Revised" }
+    sign_in @alice
+
+    get page_edit_path(b_page, b_page.edits.last)
+    assert_response :not_found
+
+    get page_edit_path(b_page, "latest")
+    assert_response :not_found
+  end
+
+  test "an access row left behind by another tenant buys no way in" do
+    Access.create! user: @alice, book: @b_book, level: :editor
+    sign_in @alice
+
+    get root_path
+    assert_not_in_body @b_book.title
+
+    get book_slug_path(@b_book)
+    assert_response :not_found
+  end
+
+  test "even an administrator from another tenant gets a 404" do
+    sign_in @bob
+
+    get slugged_book_path(@a_book, @a_book.slug)
+
+    assert_response :not_found
+  end
+
+  test "nothing can be written into another tenant's book" do
+    sign_in @alice
+
+    post book_pages_path(@b_book, params: { page: { body: "Injected" }, leaf: { title: "Injected" }, position: 1 })
+
+    assert_response :not_found
+    assert_empty @b_book.reload.leaves
+  end
+
+  test "signed out visitors see every published book, whatever tenant it belongs to" do
+    get root_path
+
+    assert_response :success
+    assert_in_body @b_book.title
+    assert_not_in_body @a_book.title
+  end
+
+  test "everything inside a tenant keeps working" do
+    a_page = press_page(@a_book, "Customer A Page")
+    a_page.edit leafable_params: { body: "Second draft" }
+    sign_in @alice
+
+    get slugged_leafable_path(a_page.book, a_page.book.slug, a_page, a_page.slug)
+    assert_response :success
+
+    get page_edit_path(a_page, a_page.edits.last)
+    assert_response :success
+
+    get users_path
+    assert_response :success
+    assert_in_body @bob.name
+  end
+
+  test "sharing with everyone stays within the tenant" do
+    @a_book.update! everyone_access: true
+    @a_book.update_access editors: [], readers: []
+
+    assert_empty @a_book.accesses.where(user: @bob)
+    assert_not_empty @a_book.accesses.where(user: @alice)
+    assert_equal (User.active.ids - [ @bob.id ]).sort, @a_book.reload.accesses.pluck(:user_id).sort
+  end
+
+  test "new users only pick up everyone-books from their own tenant" do
+    @a_book.update! everyone_access: true
+
+    carol = User.create!(name: "Carol", email_address: "carol@example.com", password: "secret123456", tenant: @customer_b)
+
+    assert_not_includes carol.books.map(&:id), @a_book.id
+  end
+
+  test "new books land in their creator's tenant" do
+    sign_in @alice
+
+    post books_path, params: { book: { title: "Fresh book", everyone_access: false } }
+
+    assert_redirected_to book_slug_url(Book.last)
+    assert_equal @customer_a.id, Book.last.tenant_id
+  end
+
+  private
+    def tenanted_book(title, tenant:, published:)
+      Book.create!(title: title, slug: title.parameterize, tenant: tenant, published: published)
+    end
+
+    def press_page(book, title)
+      book.press Page.new(body: "# #{title}"), title: title
+    end
+end
