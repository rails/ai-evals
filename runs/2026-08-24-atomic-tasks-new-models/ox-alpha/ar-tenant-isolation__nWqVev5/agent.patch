diff --git a/db/migrate/20260821152022_create_tenants.rb b/db/migrate/20260821152022_create_tenants.rb
new file mode 100644
index 0000000..e5eeac1
--- /dev/null
+++ b/db/migrate/20260821152022_create_tenants.rb
@@ -0,0 +1,40 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table "tenants", force: :cascade do |t|
+      t.string "name", null: false
+      t.datetime "created_at", null: false
+      t.datetime "updated_at", null: false
+    end
+
+    add_column "users", "tenant_id", :integer
+    add_index "users", "tenant_id"
+
+    add_column "books", "tenant_id", :integer
+    add_index "books", "tenant_id"
+
+    reversible do |direction|
+      direction.up do
+        # Existing installs are swept into a single tenant so they upgrade in
+        # place without losing access to anything.
+        tenant_id = find_or_create_tenant
+
+        update "UPDATE users SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+        update "UPDATE books SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+      end
+    end
+  end
+
+  private
+    def find_or_create_tenant
+      if existing_tenant_id = select_value("SELECT id FROM tenants ORDER BY id LIMIT 1")
+        existing_tenant_id
+      else
+        timestamp = quote(Time.current)
+        execute <<~SQL
+          INSERT INTO tenants (name, created_at, updated_at)
+          VALUES (#{quote("Writebook")}, #{timestamp}, #{timestamp})
+        SQL
+        select_value("SELECT id FROM tenants ORDER BY id DESC LIMIT 1")
+      end
+    end
+end
