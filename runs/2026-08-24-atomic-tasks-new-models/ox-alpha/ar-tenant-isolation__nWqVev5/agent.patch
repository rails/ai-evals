diff --git a/app/models/concerns/tenanted.rb b/app/models/concerns/tenanted.rb
new file mode 100644
index 0000000..0b5b96f
--- /dev/null
+++ b/app/models/concerns/tenanted.rb
@@ -0,0 +1,21 @@
+# Records may be filed under a tenant to keep an install serving several
+# customers apart from one another. Rows without a tenant predate tenants (or
+# were created outside of one) and are shared across the whole install, so they
+# keep behaving exactly as they did before.
+module Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    # Restrict the relation to rows that belong to the given record's tenant,
+    # plus the ones that don't belong to any tenant at all.
+    scope :in_tenant_of, ->(owner) {
+      if owner&.tenant
+        where(tenant_id: [ owner.tenant_id, nil ])
+      else
+        all
+      end
+    }
+  end
+end
