diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..f286c3f
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,24 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "show stamps the report with when the book was last updated" do
+    get book_report_path(books(:handbook))
+
+    assert_response :success
+    assert_in_body "Last updated #{books(:handbook).updated_at.to_date.to_fs(:long)}"
+    assert_in_body "#{books(:handbook).markable.length.to_fs(:delimited)} characters"
+  end
+
+  test "show downloads the card, named after when the book was last updated" do
+    get book_report_path(books(:handbook), format: :text)
+
+    assert_response :success
+    assert_match /filename="shelf-report-#{books(:handbook).updated_at.to_fs(:number)}\.txt"/,
+      response.headers["Content-Disposition"]
+    assert_in_body "Book: #{books(:handbook).title}"
+  end
+end
