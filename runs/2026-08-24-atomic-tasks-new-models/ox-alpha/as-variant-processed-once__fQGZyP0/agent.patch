diff --git a/lib/rails_ext/active_storage_variation.rb b/lib/rails_ext/active_storage_variation.rb
new file mode 100644
index 0000000..d165a27
--- /dev/null
+++ b/lib/rails_ext/active_storage_variation.rb
@@ -0,0 +1,43 @@
+# A derived image (a variant) is stored once and tracked in the database by a digest of its
+# transformations. Whoever asks for the variant afterwards -- the background job that derives it
+# after an upload (`Picture.image.variant :large, process: :later`) or the first reader to open
+# the book page -- has to compute that same digest, or the copy gets written twice.
+#
+# They didn't agree, because the transformations reach Active Storage in different shapes:
+#
+#   * A reader carries them in the signed key of the image URL, where they travelled as JSON,
+#     so `format: :webp` arrives back as `"webp"`.
+#   * The background job receives them straight from the named variant declared on the model,
+#     still holding the `:webp` symbol.
+#
+# Marshalled as they arrived, those hashes digested differently: the job wrote its copy under one
+# digest, while every first read looked the variant up under another, converted the picture again
+# and kept both copies next to each other for good.
+#
+# So digest the transformations the way a reader receives them -- read back from their signed key,
+# then ordered by key. That shape doesn't depend on how the transformations got here: one set of
+# transformations, one derivative.
+module ActiveStorageCanonicalVariantDigest
+  def digest
+    OpenSSL::Digest::SHA1.base64digest Marshal.dump(canonicalize(requested_transformations))
+  end
+
+  private
+    def requested_transformations
+      self.class.wrap(key).transformations
+    end
+
+    def canonicalize(value)
+      case value
+      when Hash then value.sort_by { |key, _key| key.to_s }.to_h { |key, item| [ key, canonicalize(item) ] }
+      when Array then value.map { |item| canonicalize(item) }
+      else value
+      end
+    end
+end
+
+Rails.application.config.to_prepare do
+  unless ActiveStorage::Variation.include?(ActiveStorageCanonicalVariantDigest)
+    ActiveStorage::Variation.prepend ActiveStorageCanonicalVariantDigest
+  end
+end
diff --git a/test/bytes_check_test.rb b/test/bytes_check_test.rb
new file mode 100644
index 0000000..66e7c9f
--- /dev/null
+++ b/test/bytes_check_test.rb
@@ -0,0 +1,15 @@
+require "test_helper"
+class BytesCheckTest < ActionDispatch::IntegrationTest
+  test "served derivative matches the documented transformation" do
+    picture = pictures(:reading)
+    expected = ImageProcessing::Vips.source(StringIO.new(picture.image.download))
+      .resize_to_limit(1500, 1500).convert("webp").call.read
+
+    get leafable_slug_path(picture.leaf.reload)
+    assert_response :success
+    get css_select("figure img").first["src"]
+    follow_redirect!
+
+    assert_equal expected, response.body
+  end
+end
diff --git a/test/models/picture_derivation_test.rb b/test/models/picture_derivation_test.rb
new file mode 100644
index 0000000..ebe773b
--- /dev/null
+++ b/test/models/picture_derivation_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class PictureDerivationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    books(:handbook).update! published: true
+
+    @conversions = 0
+    @subscriber = ActiveSupport::Notifications.subscribe "transform.active_storage" do
+      @conversions += 1
+    end
+  end
+
+  teardown do
+    ActiveSupport::Notifications.unsubscribe @subscriber
+  end
+
+  test "an uploaded picture gets derived once" do
+    post book_pictures_path(books(:handbook), format: :turbo_stream), params: {
+      leaf: { title: "White rabbit" },
+      picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+    }
+
+    assert_response :success
+    assert_equal 0, @conversions
+
+    run_background_jobs
+
+    picture = Picture.last
+    assert picture.image.variant(:large).processed?
+    assert_equal 1, @conversions
+    assert_equal 1, picture.image.blob.variant_records.count
+    assert_not_equal picture.image.variant(:large).image.blob.key, picture.image.blob.key
+  end
+
+  test "opening the book page serves the derived copy without deriving it again" do
+    post book_pictures_path(books(:handbook), format: :turbo_stream), params: {
+      leaf: { title: "White rabbit" },
+      picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+    }
+    assert_response :success
+
+    run_background_jobs
+    picture = Picture.last
+    derived = picture.image.variant(:large).image.download
+
+    sign_out
+
+    get leafable_slug_path(picture.leaf.reload)
+    assert_response :success
+
+    assert_no_changes -> { ActiveStorage::Blob.count } do
+      get css_select("figure img").first["src"]
+      follow_redirect!
+
+      assert_response :success
+      assert_equal derived, response.body
+    end
+
+    assert_equal 1, @conversions
+    assert_equal 1, picture.image.blob.reload.variant_records.count
+
+    get leafable_slug_path(picture.leaf.reload)
+    assert_no_changes -> { ActiveStorage::Blob.count } do
+      get css_select("figure img").last["src"]
+      follow_redirect!
+
+      assert_response :success
+      assert_equal derived, response.body
+    end
+
+    assert_equal 1, @conversions
+  end
+
+  test "the background job and a reader resolve the same derivative" do
+    picture = pictures(:reading)
+
+    # A reader: transformations read back from the signed key of the image URL.
+    reader = ActiveStorage::Variation.wrap(picture.large_image.variation.key).digest
+
+    # The background job: the named variant's transformations straight from the model.
+    job = picture.image.blob.variant(resize_to_limit: [ 1500, 1500 ], format: :webp).variation.digest
+
+    assert_equal reader, job
+  end
+
+  private
+    def run_background_jobs
+      perform_enqueued_jobs until enqueued_jobs.empty?
+    end
+end
