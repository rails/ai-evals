diff --git a/app/jobs/title_cleanup_job.rb b/app/jobs/title_cleanup_job.rb
index 13721ed..3adec6f 100644
--- a/app/jobs/title_cleanup_job.rb
+++ b/app/jobs/title_cleanup_job.rb
@@ -1,7 +1,19 @@
 class TitleCleanupJob < ApplicationJob
+  # The legacy exporter wrapped every leaf title in stray double quotes. This
+  # job strips them off. Because the job can run for hours across a large
+  # collection, deploys or other restarts can interrupt it mid-way.
+  #
+  # To make that safe, each leaf's cleaned title and its "already cleaned"
+  # marker are written together in a single update, so a leaf is only ever
+  # left half-processed if the process died before that update committed —
+  # in which case its title is still untouched and cleaning it again is
+  # perfectly safe. Once a leaf is marked clean, later runs skip it, so a
+  # restart resumes from wherever it left off instead of starting over, and
+  # no title is ever cleaned (and its legitimate inner quotes stripped)
+  # more than once.
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    Leaf.with_uncleaned_title.find_each(order: :asc) do |leaf|
+      leaf.update!(title: cleaned(leaf.title), title_cleaned_at: Time.current)
     end
   end
 
diff --git a/app/models/leaf.rb b/app/models/leaf.rb
index fb7e68b..7156b0e 100644
--- a/app/models/leaf.rb
+++ b/app/models/leaf.rb
@@ -9,7 +9,14 @@ class Leaf < ApplicationRecord
 
   enum :status, %w[ active trashed ].index_by(&:itself), default: :active
 
+  # Leaves created after the legacy exporter's stray-quote cleanup shipped
+  # never carry that artifact, so there's nothing for TitleCleanupJob to do.
+  # Marking them clean up front keeps a rerun of the job from ever touching
+  # (and mangling) a legitimately quoted title on new content.
+  before_create -> { self.title_cleaned_at ||= Time.current }
+
   scope :with_leafables, -> { includes(:leafable) }
+  scope :with_uncleaned_title, -> { where(title_cleaned_at: nil) }
 
   def slug
     title.parameterize.presence || "-"
