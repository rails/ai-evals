diff --git a/test/controllers/books/imports_controller_test.rb b/test/controllers/books/imports_controller_test.rb
new file mode 100644
index 0000000..32581ad
--- /dev/null
+++ b/test/controllers/books/imports_controller_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Books::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "a successful batch import commits the edits and hands off work for every book" do
+    book = books(:handbook)
+
+    assert_enqueued_with(job: Book::SearchIndexJob, args: [ book ]) do
+      post books_import_url, params: { books: { book.id => { title: "Imported Title" } } }
+    end
+
+    assert_redirected_to root_url
+    assert_equal "Imported Title", book.reload.title
+  end
+
+  test "an abandoned batch import never hands off the per book work" do
+    book = books(:handbook)
+    original_title = book.title
+
+    assert_no_enqueued_jobs only: Book::SearchIndexJob do
+      post books_import_url, params: { books: {
+        book.id => { title: "Should not stick" },
+        "not-a-real-id" => { title: "Boom" }
+      } }
+    end
+
+    assert_equal original_title, book.reload.title
+  end
+
+  test "an abandoned batch import still notifies the operator that it failed" do
+    assert_enqueued_with(job: Books::ImportFailureJob) do
+      post books_import_url, params: { books: {
+        books(:handbook).id => { title: "Should not stick" },
+        "not-a-real-id" => { title: "Boom" }
+      } }
+    end
+  end
+end
diff --git a/test/models/book/editing_test.rb b/test/models/book/editing_test.rb
new file mode 100644
index 0000000..5bad6ce
--- /dev/null
+++ b/test/models/book/editing_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Book::EditingTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+  include ActionDispatch::TestProcess::FixtureFile
+
+  test "apply_edit enqueues the search index job only after the edit commits" do
+    book = books(:handbook)
+
+    assert_enqueued_with(job: Book::SearchIndexJob, args: [ book ]) do
+      book.apply_edit(title: "Updated Title")
+    end
+  end
+
+  test "apply_edit enqueues the cover processing job only after the edit commits" do
+    book = books(:handbook)
+
+    assert_enqueued_with(job: Book::CoverProcessingJob, args: [ book ]) do
+      book.apply_edit(cover: fixture_file_upload("white-rabbit.webp", "image/webp"))
+    end
+  end
+
+  test "apply_edit never hands off work while the edit is still open" do
+    book = books(:handbook)
+
+    Book.transaction do
+      book.apply_edit(title: "Mid transaction title", cover: fixture_file_upload("white-rabbit.webp", "image/webp"))
+
+      assert_no_enqueued_jobs
+    end
+  end
+
+  test "apply_edit never hands off work when the edit is rolled back" do
+    book = books(:handbook)
+
+    assert_no_enqueued_jobs do
+      Book.transaction do
+        book.apply_edit(title: "Rolled back title", cover: fixture_file_upload("white-rabbit.webp", "image/webp"))
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+
+  test "a successful edit still runs the cover processing job and stamps the fingerprint" do
+    book = books(:handbook)
+
+    perform_enqueued_jobs only: Book::CoverProcessingJob do
+      book.apply_edit(cover: fixture_file_upload("white-rabbit.webp", "image/webp"))
+    end
+
+    assert book.cover.blob.reload.metadata["sha256"].present?
+  end
+
+  test "a successful edit still refreshes the search index" do
+    book = books(:handbook)
+    written = nil
+    Rails.cache.define_singleton_method(:write) { |key, value, *| written = [ key, value ] }
+
+    perform_enqueued_jobs only: Book::SearchIndexJob do
+      book.apply_edit(title: "Refreshed Title")
+    end
+
+    assert_equal [ "search_index/book/#{book.id}", "Refreshed Title" ], written
+  end
+end
