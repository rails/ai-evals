diff --git a/config/environments/development.rb b/config/environments/development.rb
index e1c3d90..b7f602e 100644
--- a/config/environments/development.rb
+++ b/config/environments/development.rb
@@ -71,4 +71,18 @@ Rails.application.configure do
 
   # Apply autocorrection by RuboCop to files generated by `bin/rails generate`.
   config.generators.apply_rubocop_autocorrect_after_generate!
+
+  # `bin/rails runner` scripts (e.g. the import runbook's
+  # script/library_report.rb) only send their output to Rails.logger, which
+  # in this environment writes to log/development.log. That makes the report
+  # invisible on the terminal, so the on-call has nothing to sign the import
+  # off against. Broadcast the logger to STDOUT for runner invocations so the
+  # report still shows up on screen, while every line keeps landing in
+  # log/development.log for the log tooling to read.
+  runner do
+    stdout_logger = ActiveSupport::Logger.new($stdout)
+    stdout_logger.level = Rails.logger.level
+    stdout_logger.formatter = Rails.logger.formatter
+    Rails.logger.broadcast_to(stdout_logger)
+  end
 end
