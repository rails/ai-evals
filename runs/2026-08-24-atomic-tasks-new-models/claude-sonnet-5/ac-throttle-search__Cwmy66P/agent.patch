index 0000000..de754d8
--- /dev/null
+++ b/test/controllers/books/searches_rate_limit_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Books::SearchesRateLimitTest < ActionDispatch::IntegrationTest
+  RATE_LIMITED_IP = "203.0.113.5"
+  OTHER_IP = "198.51.100.9"
+
+  setup do
+    sign_out
+
+    @book = books(:handbook)
+    @book.update! published: true
+
+    Books::SearchesController::RATE_LIMIT_STORE.clear
+  end
+
+  teardown do
+    Books::SearchesController::RATE_LIMIT_STORE.clear
+  end
+
+  test "refuses requests once an address goes over the limit within a minute" do
+    30.times do
+      post book_search_url(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => RATE_LIMITED_IP }
+      assert_response :success
+    end
+
+    post book_search_url(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => RATE_LIMITED_IP }
+    assert_response :too_many_requests
+  end
+
+  test "does not refuse a different address searching the same book" do
+    31.times do
+      post book_search_url(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => RATE_LIMITED_IP }
+    end
+    assert_response :too_many_requests
+
+    post book_search_url(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => OTHER_IP }
+    assert_response :success
+  end
+
+  test "a rate limited address can still open the book's pages without signing in" do
+    31.times do
+      post book_search_url(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => RATE_LIMITED_IP }
+    end
+    assert_response :too_many_requests
+
+    get book_slug_url(@book), headers: { "REMOTE_ADDR" => RATE_LIMITED_IP }
+    assert_response :success
+  end
+
+  test "the rate limit lets go on its own after the window passes" do
+    31.times do
+      post book_search_url(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => RATE_LIMITED_IP }
+    end
+    assert_response :too_many_requests
+
+    travel 5.minutes + 1.second
+
+    post book_search_url(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => RATE_LIMITED_IP }
+    assert_response :success
+  end
+end
