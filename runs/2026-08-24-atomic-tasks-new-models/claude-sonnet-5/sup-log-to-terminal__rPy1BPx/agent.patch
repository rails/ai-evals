diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..3ffb08f 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -29,5 +29,17 @@ module Writebook
 
     # Opt in to 8.0 timezone behavior
     config.active_support.to_time_preserves_timezone = :zone
+
+    # `bin/rails runner` only writes to the environment log file, so
+    # runbook scripts (like script/library_report.rb) produce no visible
+    # output even though they ran and completed successfully. Mirror
+    # everything the runner logs to STDOUT as well, using the same
+    # formatter as the log file, so the report shows up on the terminal
+    # while every line is still recorded in log/<environment>.log.
+    runner do |app|
+      Rails.logger.broadcast_to(
+        ActiveSupport::Logger.new($stdout).tap { |logger| logger.formatter = app.config.log_formatter }
+      )
+    end
   end
 end
