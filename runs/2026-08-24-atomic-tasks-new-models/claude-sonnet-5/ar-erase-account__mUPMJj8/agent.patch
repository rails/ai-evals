diff --git a/test/models/user/erase_test.rb b/test/models/user/erase_test.rb
new file mode 100644
index 0000000..4c87e6c
--- /dev/null
+++ b/test/models/user/erase_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class User::EraseTest < ActiveSupport::TestCase
+  setup do
+    @alice = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+  end
+
+  test "erase deletes the user row" do
+    id = @alice.id
+    @alice.erase
+
+    assert_nil User.find_by(id: id)
+  end
+
+  test "erase deletes sessions, accesses, and reading marks" do
+    session = @alice.sessions.start!(user_agent: "rspec", ip_address: "127.0.0.1")
+    access = books(:handbook).access_for(user: @alice)
+    mark = ReadingMark.remember(leaves(:welcome_page), user: @alice)
+
+    @alice.erase
+
+    assert_nil Session.find_by(id: session.id)
+    assert_nil Access.find_by(id: access.id)
+    assert_nil ReadingMark.find_by(id: mark.id)
+  end
+
+  test "erase deletes sign-in events logged under the user's current address" do
+    @alice.sessions.start!(user_agent: "rspec", ip_address: "127.0.0.1")
+    assert SignInEvent.for_address("alice@example.com").exists?
+
+    @alice.erase
+
+    assert_not SignInEvent.for_address("alice@example.com").exists?
+  end
+
+  test "erase recovers the pre-deactivation email to purge sign-in events" do
+    @alice.sessions.start!(user_agent: "rspec", ip_address: "127.0.0.1")
+    assert SignInEvent.for_address("alice@example.com").exists?
+
+    # Simulate someone having already "removed" alice the old way: the
+    # session is gone, but the sign-in events are still sitting under the
+    # address she actually signed in with.
+    @alice.sessions.delete_all
+    @alice.update! active: false,
+      email_address: @alice.email_address.gsub("@", "-deactivated-#{SecureRandom.uuid}@")
+
+    @alice.reload.erase
+
+    assert_not SignInEvent.for_address("alice@example.com").exists?
+  end
+
+  test "erase destroys private books the user created" do
+    book = Book.create!(title: "Private", everyone_access: false, creator: @alice)
+
+    @alice.erase
+
+    assert_nil Book.find_by(id: book.id)
+  end
+
+  test "erase keeps everyone-access books but scrubs the creator and byline" do
+    book = Book.create!(title: "Shared", everyone_access: true, creator: @alice, author: "Alice")
+    leaf = book.press Page.new(body: "hello world"), title: "Welcome"
+
+    @alice.erase
+
+    book.reload
+    assert_nil book.creator_id
+    assert_equal "Deleted author", book.author
+    assert Leaf.exists?(leaf.id)
+  end
+
+  test "erase does not leave stale search index rows for destroyed books' leaves" do
+    private_book = Book.create!(title: "Private", everyone_access: false, creator: @alice)
+    leaf = private_book.press Page.new(body: "super secret unique content"), title: "Secret"
+
+    assert Leaf.search("secret").exists?
+
+    @alice.erase
+
+    assert_not Leaf.search("secret").exists?
+    assert_not Leaf.exists?(leaf.id)
+  end
+end
