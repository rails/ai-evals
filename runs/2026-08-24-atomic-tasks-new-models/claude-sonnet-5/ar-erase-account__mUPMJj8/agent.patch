diff --git a/app/models/user/authoring.rb b/app/models/user/authoring.rb
index bc70db7..1cc1e7f 100644
--- a/app/models/user/authoring.rb
+++ b/app/models/user/authoring.rb
@@ -1,10 +1,32 @@
 module User::Authoring
   extend ActiveSupport::Concern
 
+  DELETED_AUTHOR_BYLINE = "Deleted author"
+
   included do
     has_many :created_books, class_name: "Book", foreign_key: :creator_id,
-      inverse_of: :creator, dependent: :destroy
+      inverse_of: :creator
 
-    has_many :reading_marks
+    has_many :reading_marks, dependent: :destroy
   end
+
+  private
+    # Books that are shared with everyone stay published under a scrubbed
+    # byline, since other people are relying on being able to read them.
+    # Anything else the user authored is erased along with them.
+    #
+    # Uses update_columns (not update!) to clear the creator: Book's
+    # belongs_to :creator has a `default: -> { Current.user }`, which
+    # reasserts itself before validation whenever the association is blank
+    # — so a normal save would quietly re-attribute the book to whoever is
+    # performing the erasure.
+    def erase_created_books
+      created_books.find_each do |book|
+        if book.everyone_access?
+          book.update_columns creator_id: nil, author: DELETED_AUTHOR_BYLINE
+        else
+          book.destroy
+        end
+      end
+    end
 end
