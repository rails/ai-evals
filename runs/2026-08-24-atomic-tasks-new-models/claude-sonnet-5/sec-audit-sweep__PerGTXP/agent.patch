     assert_response :forbidden
   end
+
+  test "show prevents accessing a page under a different book's id" do
+    other_page = books(:manual).press Page.new(body: "Secret content"), title: "Secret Page"
+
+    get slugged_leafable_path(book_id: books(:handbook).id, book_slug: books(:handbook).slug, id: other_page.id, slug: other_page.slug)
+
