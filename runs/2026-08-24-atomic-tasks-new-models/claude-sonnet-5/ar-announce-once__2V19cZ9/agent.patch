diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..1fece02 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,26 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_save :remember_going_live
+    after_update_commit :announce_publication, if: :going_live?
   end
 
   private
+    # Captured at save time (rather than derived from saved_change_to_published?
+    # after the transaction commits) because other saves in the same sitting —
+    # touching this record via belongs_to touch:, for instance — reset dirty
+    # tracking and would otherwise erase the fact that this save took the book
+    # live.
+    def remember_going_live
+      @going_live = will_save_change_to_published? && published?
+    end
+
+    def going_live?
+      @going_live
+    end
+
     def announce_publication
+      @going_live = false
       AnnouncePublicationJob.perform_later self
     end
 end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..47823a4
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "publishing a draft announces exactly once" do
+    book = books(:manual)
+    assert_not book.published?
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.update! published: true
+    end
+  end
+
+  test "publishing while also adding a page in the same sitting still announces" do
+    book = books(:manual)
+    assert_not book.published?
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        book.update! published: true
+        book.press Page.new(body: ""), title: "New page"
+      end
+    end
+  end
+
+  test "resaving an already-live book does not announce again" do
+    book = books(:manual)
+    book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update! title: "Manual, revised"
+    end
+  end
+
+  test "unpublishing a live book does not announce" do
+    book = books(:manual)
+    book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update! published: false
+    end
+  end
+
+  test "a save that doesn't touch published announces nothing" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update! title: "Renamed manual"
+    end
+  end
+
+  test "a failed sitting after marking live leaves a draft and announces nothing" do
+    book = books(:manual)
+    assert_not book.published?
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises(ActiveRecord::NotNullViolation) do
+        Book.transaction do
+          book.update! published: true
+          book.leaves.create!(title: nil, leafable: Page.new(body: ""))
+        end
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+end
