diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..dec5e89 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,40 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # `Rails::Application#env_config` (and, transitively,
+    # `Rails::Engine#build_request`, `ActionController::TestCase`, and
+    # `ActionDispatch::TestRequest`) memoizes the request env it builds from
+    # `config.action_dispatch.show_exceptions` the *first* time a request is
+    # made in this process, and reuses that memoized hash for every request
+    # made afterwards — it never looks at the config again. That means
+    # flipping `config.action_dispatch.show_exceptions` at runtime, like we
+    # do here, silently does nothing once a single request has already been
+    # made in this test process: whichever value was in effect for the very
+    # first request "wins" for the rest of the process's life, no matter
+    # what individual tests set it to later. Depending on test order (which
+    # varies every run under parallel workers) that either leaves later
+    # `with_raised_exceptions` blocks unable to force exceptions to raise,
+    # or leaves error pages permanently raising instead of rendering for
+    # every other test in that worker.
+    #
+    # To keep the promise made by `with_raised_exceptions` — exceptions
+    # raised inside the block, rendered as normal outside it, regardless of
+    # what ran before — we have to bust that memoized cache ourselves
+    # whenever we change the setting, both on the way in and on the way
+    # back out.
     def with_raised_exceptions
       previous = Rails.application.config.action_dispatch.show_exceptions
       Rails.application.config.action_dispatch.show_exceptions = :none
+      reset_memoized_show_exceptions_env_config!
       yield
     ensure
       Rails.application.config.action_dispatch.show_exceptions = previous
+      reset_memoized_show_exceptions_env_config!
     end
+
+    private
+      def reset_memoized_show_exceptions_env_config!
+        Rails.application.instance_variable_set(:@app_env_config, nil)
+      end
   end
 end
