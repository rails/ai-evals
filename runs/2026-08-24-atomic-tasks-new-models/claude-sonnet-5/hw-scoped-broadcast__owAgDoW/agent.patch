diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..2bf45b6 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,65 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "update broadcasts the being edited indicator only to current editors" do
+    page = leaves(:welcome_page)
+    editors = books(:handbook).editors.excluding(users(:kevin)).to_a
+    assert_not_empty editors
+
+    editors.each do |editor|
+      assert_turbo_stream_broadcasts [ page, :being_edited, editor ] do
+        perform_enqueued_jobs do
+          patch book_page_path(books(:handbook), page, format: :turbo_stream), params: {
+            page: { body: "Updated body." }
+          }
+        end
+      end
+    end
+  end
+
+  test "update broadcasts the being edited indicator to a collaborator while they still have editor access" do
+    page = leaves(:welcome_page)
+    collaborator = users(:jz)
+    books(:handbook).access_for(user: collaborator).update! level: :editor
+
+    assert_turbo_stream_broadcasts [ page, :being_edited, collaborator ] do
+      perform_enqueued_jobs do
+        patch book_page_path(books(:handbook), page, format: :turbo_stream), params: {
+          page: { body: "Updated while still a collaborator." }
+        }
+      end
+    end
+  end
+
+  test "update does not broadcast the being edited indicator to a removed collaborator" do
+    page = leaves(:welcome_page)
+    collaborator = users(:jz)
+    books(:handbook).access_for(user: collaborator).update! level: :editor
+    books(:handbook).access_for(user: collaborator).destroy!
+
+    assert_no_turbo_stream_broadcasts [ page, :being_edited, collaborator ] do
+      perform_enqueued_jobs do
+        patch book_page_path(books(:handbook), page, format: :turbo_stream), params: {
+          page: { body: "Updated body once more." }
+        }
+      end
+    end
+  end
+
+  test "update does not broadcast the being edited indicator to a collaborator downgraded to reader" do
+    page = leaves(:welcome_page)
+    collaborator = users(:jz)
+    books(:handbook).access_for(user: collaborator).update! level: :editor
+
+    books(:handbook).access_for(user: collaborator).update! level: :reader
+
+    assert_no_turbo_stream_broadcasts [ page, :being_edited, collaborator ] do
+      perform_enqueued_jobs do
+        patch book_page_path(books(:handbook), page, format: :turbo_stream), params: {
+          page: { body: "Yet another update." }
+        }
+      end
+    end
+  end
 end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..3eb7449 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,43 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors includes users with explicit editor access and administrators" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+
+    assert_includes book.editors, users(:kevin)
+    assert_not_includes book.editors, users(:jz)
+    assert_includes book.editors, users(:david)
+    assert_includes book.editors, users(:jason)
+  end
+
+  test "editors excludes a collaborator once their access is revoked" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+    assert_includes book.editors, users(:kevin)
+
+    book.access_for(user: users(:kevin)).destroy!
+
+    assert_not_includes book.editors, users(:kevin)
+  end
+
+  test "editors excludes a collaborator once downgraded to reader" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+    assert_includes book.editors, users(:kevin)
+
+    book.access_for(user: users(:kevin)).update! level: :reader
+
+    assert_not_includes book.editors, users(:kevin)
+  end
+
+  test "editors excludes inactive users" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+
+    users(:kevin).deactivate
+
+    assert_not_includes book.editors, users(:kevin)
+  end
 end
