diff --git a/test/test_helpers/fragment_caching_test_helper.rb b/test/test_helpers/fragment_caching_test_helper.rb
new file mode 100644
index 0000000..434bbe7
--- /dev/null
+++ b/test/test_helpers/fragment_caching_test_helper.rb
@@ -0,0 +1,22 @@
+module FragmentCachingTestHelper
+  # Fragment caching (including collection/partial caching) is disabled by
+  # default in the test environment. Some behavior -- like making sure a
+  # cached table of contents entry is never served across a permission
+  # boundary -- can only be exercised with caching turned on, so tests that
+  # care about that can opt in with this helper.
+  def with_fragment_caching
+    previous_perform_caching = ApplicationController.perform_caching
+    previous_cache_store = Rails.cache
+    previous_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    ApplicationController.perform_caching = true
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    ActionView::PartialRenderer.collection_cache = Rails.cache
+
+    yield
+  ensure
+    ApplicationController.perform_caching = previous_perform_caching
+    Rails.cache = previous_cache_store
+    ActionView::PartialRenderer.collection_cache = previous_collection_cache
+  end
+end
