diff --git a/test/controllers/books/toc_fragment_caching_test.rb b/test/controllers/books/toc_fragment_caching_test.rb
new file mode 100644
index 0000000..3796357
--- /dev/null
+++ b/test/controllers/books/toc_fragment_caching_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class TocFragmentCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    @prev_cache_store = Rails.cache
+    @prev_collection_cache = ActionView::PartialRenderer.collection_cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    ActionView::PartialRenderer.collection_cache = Rails.cache
+    ApplicationController.perform_caching = true
+  end
+
+  teardown do
+    Rails.cache = @prev_cache_store
+    ActionView::PartialRenderer.collection_cache = @prev_collection_cache
+    ApplicationController.perform_caching = false
+  end
+
+  test "reader never sees editor controls even if editor viewed first" do
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "a[href=?]", edit_leafable_path(leaves(:welcome_page))
+
+    sign_out
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "a[href=?]", edit_leafable_path(leaves(:welcome_page)), count: 0
+  end
+
+  test "editor always sees editor controls even if reader viewed first" do
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "a[href=?]", edit_leafable_path(leaves(:welcome_page)), count: 0
+
+    sign_out
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "a[href=?]", edit_leafable_path(leaves(:welcome_page))
+  end
+
+  test "renamed entry shows new title to next viewer" do
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "span.overflow-ellipsis", text: leaves(:welcome_page).title
+
+    leaves(:welcome_page).update!(title: "Brand new title")
+
+    sign_out
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "span.overflow-ellipsis", text: "Brand new title"
+  end
+
+  test "access checks for the toc do not scale with the number of leaves" do
+    sign_in :kevin
+
+    book = books(:handbook)
+    50.times { |i| book.press Page.new(body: "Body #{i}"), title: "Page #{i}" }
+
+    access_queries = 0
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+      access_queries += 1 if payload[:sql] =~ /FROM "accesses"/i
+    end
+
+    get book_slug_url(book)
+
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+    assert_response :success
+    assert_operator access_queries, :<, 10, "access checks should not scale with the number of leaves (#{access_queries} queries for 54 leaves)"
+  end
+end
