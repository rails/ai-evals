diff --git a/app/models/book/accessable.rb b/app/models/book/accessable.rb
index aa3dcf1..4728c01 100644
--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -25,7 +25,12 @@ module Book::Accessable
   end
 
   def editable?(user: Current.user)
-    access_for(user: user)&.editor? || user&.administrator?
+    # Memoized per user: a book's table of contents checks this once per
+    # entry, and the answer can't change mid-render, so there's no reason
+    # to look it up again for every entry.
+    editable_by_user_id.fetch(user&.id) {
+      editable_by_user_id[user&.id] = !!(access_for(user: user)&.editor? || user&.administrator?)
+    }
   end
 
   def access_for(user: Current.user)
@@ -43,5 +48,12 @@ module Book::Accessable
 
     accesses.upsert_all(all_accesses, unique_by: [ :book_id, :user_id ])
     accesses.where.not(user_id: all).delete_all
+
+    editable_by_user_id.clear
   end
+
+  private
+    def editable_by_user_id
+      @editable_by_user_id ||= {}
+    end
 end
