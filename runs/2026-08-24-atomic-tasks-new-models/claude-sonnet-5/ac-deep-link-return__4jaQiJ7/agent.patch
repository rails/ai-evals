+    # Only follow the ?return_to= parameter when it points back at this
+    # application. Reject absolute URLs (and protocol-relative ones like
+    # "//evil.example.com/...") that resolve to a different host, so a
+    # crafted link can't send a signed-in reader off to someone else's
+    # site right after they authenticate.
+    def safe_return_to_url
+      return_to = params[:return_to].presence
+      return nil unless return_to
+
+      begin
+        uri = URI.parse(return_to)
+      rescue URI::InvalidURIError
+        return nil
+      end
+
+      return nil unless uri.scheme.nil? || %w[http https].include?(uri.scheme)
+      return nil unless uri.host.nil? || uri.host == request.host
+
+      return_to
+    end
+
     def render_rejection(status)
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
