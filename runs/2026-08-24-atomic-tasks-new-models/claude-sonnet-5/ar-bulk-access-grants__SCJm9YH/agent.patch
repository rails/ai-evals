diff --git a/app/models/book/access_import.rb b/app/models/book/access_import.rb
index 4d920cf..9b670df 100644
--- a/app/models/book/access_import.rb
+++ b/app/models/book/access_import.rb
@@ -6,20 +6,43 @@ class Book::AccessImport
   end
 
   def import
+    invalid_index = rejected_index
+    return Result.new([], invalid_index) if invalid_index
+
     accesses = []
-    duplicate_index = nil
 
     Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
+      inserted = @book.accesses.insert_all!(insertable_attributes, returning: %w[ id user_id level ])
+
+      accesses = inserted.map do |row|
+        Access.new(id: row["id"], book_id: @book.id, user_id: row["user_id"], level: row["level"])
       end
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    accesses.each { |access| Book::AccessNotificationJob.perform_later(access) }
+
+    Result.new(accesses, nil)
   end
+
+  private
+    # Finds the index of the first grant that can't be imported: one naming an unknown
+    # access level, or one that duplicates another grant in the sheet or an access the
+    # book already has. Runs as a couple of constant round trips, not one per grant.
+    def rejected_index
+      existing_user_ids = @book.accesses.where(user_id: @grants.map { |grant| grant[:user_id] }).pluck(:user_id).to_set
+      seen_user_ids = Set.new
+
+      @grants.each_with_index do |grant, index|
+        return index unless Access.levels.key?(grant[:level].to_s)
+        return index if existing_user_ids.include?(grant[:user_id]) || seen_user_ids.include?(grant[:user_id])
+
+        seen_user_ids << grant[:user_id]
+      end
+
+      nil
+    end
+
+    def insertable_attributes
+      @grants.map { |grant| { user_id: grant[:user_id], level: grant[:level] } }
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..9ddabcc
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "New book", everyone_access: false)
+    @users = 5.times.map { |i| User.create!(name: "Recruit #{i}#{SecureRandom.hex(4)}", email_address: "recruit#{i}#{SecureRandom.hex(4)}@example.com", password: "secret123456") }
+  end
+
+  test "imports every grant and notifies each grantee" do
+    grants = @users.map { |user| { user_id: user.id, level: "reader" } }
+
+    result = nil
+    assert_enqueued_jobs @users.size, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal @users.size, result.accesses.size
+    assert_equal @users.size, @book.accesses.count
+  end
+
+  test "rejects a grant that duplicates an existing access without notifying anyone" do
+    Access.create!(book: @book, user: @users.first, level: "reader")
+
+    grants = @users.map { |user| { user_id: user.id, level: "reader" } }
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 0, result.duplicate_index
+    assert_equal 1, @book.accesses.count
+  end
+
+  test "rejects a grant that repeats a user already in the sheet" do
+    grants = [
+      { user_id: @users[0].id, level: "reader" },
+      { user_id: @users[1].id, level: "reader" },
+      { user_id: @users[0].id, level: "editor" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "rejects a grant naming an unknown level instead of raising" do
+    grants = [
+      { user_id: @users[0].id, level: "reader" },
+      { user_id: @users[1].id, level: "owner" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      assert_nothing_raised do
+        result = Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "cost of importing does not grow with the size of the roster" do
+    small_grants = @users.first(2).map { |user| { user_id: user.id, level: "reader" } }
+
+    big_users = 8.times.map { |i| User.create!(name: "Big #{i}#{SecureRandom.hex(4)}", email_address: "big#{i}#{SecureRandom.hex(4)}@example.com", password: "secret123456") }
+    big_grants = big_users.map { |user| { user_id: user.id, level: "reader" } }
+
+    small_book = Book.create!(title: "Small book", everyone_access: false)
+    big_book = Book.create!(title: "Big book", everyone_access: false)
+
+    small_queries = count_queries { Book::AccessImport.new(small_book, small_grants).import }
+    big_queries = count_queries { Book::AccessImport.new(big_book, big_grants).import }
+
+    assert_equal small_queries, big_queries
+  end
+
+  test "cost of rejecting a roster does not grow with its size either" do
+    Access.create!(book: @book, user: @users.first, level: "reader")
+
+    small_grants = @users.first(2).map { |user| { user_id: user.id, level: "reader" } }
+
+    big_users = 8.times.map { |i| User.create!(name: "Big #{i}#{SecureRandom.hex(4)}", email_address: "big#{i}#{SecureRandom.hex(4)}@example.com", password: "secret123456") }
+    big_grants = [ { user_id: @users.first.id, level: "reader" } ] + big_users.map { |user| { user_id: user.id, level: "reader" } }
+
+    small_queries = count_queries { Book::AccessImport.new(@book, small_grants).import }
+    big_queries = count_queries { Book::AccessImport.new(@book, big_grants).import }
+
+    assert_equal small_queries, big_queries
+  end
+
+  private
+    def count_queries(&block)
+      count = 0
+      counter = ->(*, payload) { count += 1 unless payload[:name].to_s =~ /SCHEMA|TRANSACTION/ }
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record", &block)
+      count
+    end
+end
