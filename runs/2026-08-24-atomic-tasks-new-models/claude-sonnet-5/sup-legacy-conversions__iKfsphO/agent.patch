+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly lists the last edited date the short way" do
+    books(:handbook).update!(published: true)
+
+    email = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_includes email.body.to_s, books(:handbook).updated_at.to_date.to_fs(:short)
+  end
+end
