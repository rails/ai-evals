diff --git a/app/jobs/books/import_failure_job.rb b/app/jobs/books/import_failure_job.rb
index 0bfd478..4c34d6e 100644
--- a/app/jobs/books/import_failure_job.rb
+++ b/app/jobs/books/import_failure_job.rb
@@ -1,4 +1,10 @@
 class Books::ImportFailureJob < ApplicationJob
+  # This is enqueued from inside the importer's all-or-nothing transaction,
+  # right before it's rolled back. It must not wait for (or be dropped by)
+  # that rollback — the operator still needs to hear that their import
+  # failed — so it always enqueues immediately, transaction or not.
+  self.enqueue_after_transaction_commit = false
+
   def perform(user_id, message)
     Rails.cache.write("import_failure/#{user_id}", message)
   end
diff --git a/config/application.rb b/config/application.rb
index 8cbd4c6..dbc6aa0 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -26,5 +26,15 @@ module Writebook
 
     # Opt in to 8.0 timezone behavior
     config.active_support.to_time_preserves_timezone = :zone
+
+    # Defer enqueuing jobs until the enclosing database transaction commits,
+    # and drop the enqueue entirely if that transaction is rolled back. This
+    # keeps background work (like Book::CoverProcessingJob and
+    # Book::SearchIndexJob, kicked off from Book#apply_edit) from ever being
+    # handed off for an edit that's still open, or for one that never
+    # commits. Jobs that must survive an abandoned edit (like
+    # Books::ImportFailureJob) opt out per-job via
+    # `self.enqueue_after_transaction_commit = false`.
+    config.active_job.enqueue_after_transaction_commit = true
   end
 end
