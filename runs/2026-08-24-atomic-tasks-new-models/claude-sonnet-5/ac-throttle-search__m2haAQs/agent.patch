--- /dev/null
+++ b/test/controllers/books/searches_rate_limit_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Books::SearchesRateLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+
+    sign_out
+    books(:handbook).update!(published: true)
+  end
+
+  teardown do
+    Rails.cache = @previous_cache
+    books(:handbook).update!(published: false)
+  end
+
+  test "allows up to 30 searches per minute from the same address" do
+    30.times do
+      search_as "1.2.3.4"
+      assert_response :success
+    end
+  end
+
+  test "refuses the 31st search within a minute from the same address with 429" do
+    30.times { search_as "1.2.3.4" }
+
+    search_as "1.2.3.4"
+
+    assert_response :too_many_requests
+  end
+
+  test "does not throttle other addresses" do
+    30.times { search_as "1.2.3.4" }
+    search_as "1.2.3.4"
+    assert_response :too_many_requests
+
+    search_as "5.6.7.8"
+
+    assert_response :success
+  end
+
+  test "throttled address can still view the book" do
+    30.times { search_as "1.2.3.4" }
+    search_as "1.2.3.4"
+    assert_response :too_many_requests
+
+    get book_slug_url(books(:handbook)), headers: { "REMOTE_ADDR" => "1.2.3.4" }
+
+    assert_response :success
+  end
+
+  test "throttled address is served again after five minutes" do
+    30.times { search_as "1.2.3.4" }
+    search_as "1.2.3.4"
+    assert_response :too_many_requests
+
+    travel 5.minutes + 1.second do
+      search_as "1.2.3.4"
+      assert_response :success
+    end
+  end
+
+  private
+    def search_as(ip)
+      post book_search_url(books(:handbook)), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => ip }
+    end
+end
