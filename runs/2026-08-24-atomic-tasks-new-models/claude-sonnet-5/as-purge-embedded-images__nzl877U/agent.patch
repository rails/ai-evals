@@ -26,4 +28,26 @@ class PageTest < ActiveSupport::TestCase
     assert_includes page.searchable_content, "5 &lt; 10 &amp; 10 &gt; 5"
     assert page.searchable_content.html_safe?
   end
+
+  test "destroying a page purges its embedded image blob and file once background jobs complete" do
+    page = Page.new(body: "hello")
+    page.body.save!
+    page.body.uploads.attach(
+      io: File.open(file_fixture("reading.webp")),
+      filename: "reading.webp",
+      content_type: "image/webp"
+    )
+    page.save!
+
+    blob = page.body.uploads.last.blob
+    disk_path = ActiveStorage::Blob.service.path_for(blob.key)
+    assert File.exist?(disk_path), "expected uploaded file to exist on disk before destroy"
+
+    perform_enqueued_jobs do
+      page.destroy
+    end
+
+    assert_not ActiveStorage::Blob.exists?(blob.id), "expected blob record to be gone after background jobs run"
+    assert_not File.exist?(disk_path), "expected uploaded file to be gone from disk after background jobs run"
+  end
 end
