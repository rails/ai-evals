@@ -0,0 +1,12 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly renders a formatted last-edited date for each published book" do
+    book = books(:handbook)
+    book.update!(published: true)
+
+    email = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_match(/last edited \d{1,2} \w{3}\b/, email.body.to_s)
+  end
+end
