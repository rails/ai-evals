+++ b/test/models/page_deletion_test.rb
@@ -0,0 +1,28 @@
+require "test_helper"
+
+class PageDeletionTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+  include ActionDispatch::TestProcess::FixtureFile
+
+  test "destroying a page removes embedded image blobs and files once background jobs finish" do
+    page = pages(:welcome)
+    markdown = page.body
+    markdown.save!
+    markdown.uploads.attach fixture_file_upload("reading.webp", "image/webp")
+    markdown.save!
+
+    attachment = markdown.uploads.attachments.last
+    blob = attachment.blob
+    disk_path = ActiveStorage::Blob.service.path_for(blob.key)
+
+    assert File.exist?(disk_path), "expected uploaded file to exist on disk before deletion"
+
+    perform_enqueued_jobs do
+      page.leaf.destroy
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id), "attachment record should no longer exist"
+    assert_not ActiveStorage::Blob.exists?(blob.id), "blob record should no longer exist"
+    assert_not File.exist?(disk_path), "uploaded file should no longer exist on disk"
+  end
+end
