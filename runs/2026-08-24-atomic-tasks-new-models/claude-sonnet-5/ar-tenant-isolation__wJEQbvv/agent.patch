diff --git a/db/migrate/20241010000000_add_tenants.rb b/db/migrate/20241010000000_add_tenants.rb
new file mode 100644
index 0000000..135aee0
--- /dev/null
+++ b/db/migrate/20241010000000_add_tenants.rb
@@ -0,0 +1,26 @@
+class AddTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |dir|
+      dir.up do
+        # Every existing install predates tenants, so it's really just one
+        # tenant. Sweep all current users and books into it so upgrades
+        # happen in place, with no extra steps for existing installs.
+        if User.exists? || Book.exists?
+          tenant_id = Tenant.create!(name: "Default").id
+
+          User.update_all(tenant_id: tenant_id)
+          Book.update_all(tenant_id: tenant_id)
+        end
+      end
+    end
+  end
+end
