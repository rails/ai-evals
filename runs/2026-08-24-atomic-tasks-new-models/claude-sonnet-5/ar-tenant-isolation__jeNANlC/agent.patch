@@ -114,4 +114,109 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "index excludes another tenant's books, published or not" do
+    acme = Tenant.create!(name: "Acme")
+    globex = Tenant.create!(name: "Globex")
+
+    globex_owner = User.create!(email_address: "globex-owner-index@example.com", name: "Globex Owner", password: "secret123456", tenant: globex)
+
+    unpublished_book = Book.create!(title: "Globex Unpublished Book", published: false, everyone_access: false, tenant: globex)
+    unpublished_book.update_access(editors: [ globex_owner.id ], readers: [])
+
+    published_book = Book.create!(title: "Globex Published Book", published: true, everyone_access: false, tenant: globex)
+    published_book.update_access(editors: [ globex_owner.id ], readers: [])
+
+    acme_user = User.create!(email_address: "acme-index@example.com", name: "Acme Index", password: "secret123456", tenant: acme)
+
+    sign_out
+    sign_in acme_user
+
+    get root_url
+
+    assert_response :success
+    assert_select "h2", text: "Globex Unpublished Book", count: 0
+    assert_select "h2", text: "Globex Published Book", count: 0
+  end
+
+  test "show 404s for another tenant's book even when published" do
+    acme = Tenant.create!(name: "Acme")
+    globex = Tenant.create!(name: "Globex")
+
+    globex_owner = User.create!(email_address: "globex-owner-show@example.com", name: "Globex Owner", password: "secret123456", tenant: globex)
+
+    globex_book = Book.create!(title: "Globex Published Book", published: true, everyone_access: false, tenant: globex)
+    globex_book.update_access(editors: [ globex_owner.id ], readers: [])
+
+    acme_user = User.create!(email_address: "acme-show@example.com", name: "Acme Show", password: "secret123456", tenant: acme)
+
+    sign_out
+    sign_in acme_user
+
+    get book_slug_url(globex_book)
+
+    assert_response :not_found
+  end
+
+  test "show 404s for another tenant's unpublished book the same way as a missing book" do
+    acme = Tenant.create!(name: "Acme")
+    globex = Tenant.create!(name: "Globex")
+
+    globex_owner = User.create!(email_address: "globex-owner-missing@example.com", name: "Globex Owner", password: "secret123456", tenant: globex)
+
+    globex_book = Book.create!(title: "Globex Private Book", published: false, everyone_access: false, tenant: globex)
+    globex_book.update_access(editors: [ globex_owner.id ], readers: [])
+
+    acme_user = User.create!(email_address: "acme-missing@example.com", name: "Acme Missing", password: "secret123456", tenant: acme)
+
+    sign_out
+    sign_in acme_user
+
+    get book_slug_url(globex_book)
+    assert_response :not_found
+
+    get slugged_book_url(id: 0, slug: "does-not-exist")
+    assert_response :not_found
+  end
+
+  test "signed out visitors still see published books from every tenant" do
+    acme = Tenant.create!(name: "Acme")
+    book = Book.create!(title: "Acme Published Book", published: true, tenant: acme)
+
+    sign_out
+
+    get book_slug_url(book)
+
+    assert_response :success
+  end
+
+  test "create lands the new book in the creator's tenant" do
+    acme = Tenant.create!(name: "Acme")
+    acme_user = User.create!(email_address: "acme-create@example.com", name: "Acme Create", password: "secret123456", tenant: acme)
+
+    sign_out
+    sign_in acme_user
+
+    post books_url, params: { book: { title: "Acme New Book", everyone_access: false } }
+
+    book = Book.last
+    assert_equal acme.id, book.tenant_id
+  end
+
+  test "sharing form only lists users from the same tenant" do
+    acme = Tenant.create!(name: "Acme")
+    globex = Tenant.create!(name: "Globex")
+
+    acme_user = User.create!(email_address: "acme-share@example.com", name: "Acme Sharer", password: "secret123456", tenant: acme)
+    User.create!(email_address: "globex-share@example.com", name: "Globex Stranger", password: "secret123456", tenant: globex)
+
+    sign_out
+    sign_in acme_user
+
+    get new_book_url
+
+    assert_response :success
+    assert_in_body "Acme Sharer"
+    assert_not_in_body "Globex Stranger"
+  end
 end
