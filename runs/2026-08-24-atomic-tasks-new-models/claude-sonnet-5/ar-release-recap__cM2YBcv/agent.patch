@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Book::ReleaseTest < ActiveSupport::TestCase
+  setup do
+    @previous_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @previous_cache
+  end
+
+  test "finalize_release writes a recap with the new title and published state" do
+    book = Book.create!(title: "Working Title", published: false)
+
+    assert Book.finalize_release(book.id, title: "Final Title")
+
+    recap = book.reload.cached_recap
+    assert_equal "Final Title", recap[:title]
+    assert_equal true, recap[:published]
+  end
+
+  test "finalize_release returns false for an already published book" do
+    book = Book.create!(title: "Already Out", published: true)
+
+    assert_equal false, Book.finalize_release(book.id, title: "New Title")
+  end
+
+  test "saving one book's recap does not affect another's" do
+    a = Book.create!(title: "Book A")
+    b = Book.create!(title: "Book B")
+
+    a.update!(title: "Book A Updated")
+
+    assert_equal "Book A Updated", a.cached_recap[:title]
+    assert_nil b.cached_recap
+  end
+end
