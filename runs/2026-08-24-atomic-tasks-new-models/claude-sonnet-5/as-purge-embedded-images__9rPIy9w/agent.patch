diff --git a/test/models/action_text/markdown_test.rb b/test/models/action_text/markdown_test.rb
new file mode 100644
index 0000000..14a8762
--- /dev/null
+++ b/test/models/action_text/markdown_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class ActionText::MarkdownTest < ActiveSupport::TestCase
+  include ActionDispatch::TestProcess::FixtureFile
+  include ActiveJob::TestHelper
+
+  test "destroying the owning record purges attached upload blobs once background jobs run" do
+    page = Page.create!(body: "Hello")
+    markdown = page.body
+    markdown.uploads.attach fixture_file_upload("reading.webp", "image/webp")
+    markdown.save!
+
+    attachment = markdown.uploads.last
+    blob = attachment.blob
+    disk_path = ActiveStorage::Blob.service.path_for(blob.key)
+
+    assert File.exist?(disk_path)
+
+    perform_enqueued_jobs do
+      page.destroy
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(disk_path)
+  end
+end
