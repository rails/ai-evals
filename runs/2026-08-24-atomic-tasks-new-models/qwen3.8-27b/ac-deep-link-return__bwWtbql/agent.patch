@@ -26,6 +26,25 @@ class SessionsController < ApplicationController
       redirect_to first_run_url if User.none?
     end
 
+    # return_to is attacker-controllable (shared links, signed-in-elsewhere
+    # phishing, hand-typed URLs), so only honor it if it stays within this
+    # application: a relative path, or an absolute URL for this app's own
+    # host and port. Anything else would turn signing in into an open
+    # redirect, so it is discarded in favor of the default destination.
+    def safe_return_to_url
+      return_to = params[:return_to]
+      return unless return_to.is_a?(String) && return_to.present?
+
+      uri = URI.parse(return_to)
+      if uri.relative? && uri.host.nil?
+        return_to
+      elsif uri.userinfo.nil? && uri.host.present? && uri.host == request.host && uri.port == request.port
+        return_to
+      end
+    rescue URI::Error
+      nil
+    end
+
     def render_rejection(status)
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
