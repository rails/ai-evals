diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..5aea640 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -1,6 +1,8 @@
 class User < ApplicationRecord
   include Authoring, Role, Transferable
 
+  DELETED_AUTHOR_BYLINE = "Deleted author"
+
   has_many :sessions, dependent: :destroy
   has_secure_password validations: false
 
@@ -17,6 +19,9 @@ class User < ApplicationRecord
     self == Current.user
   end
 
+  # Legacy "removal": flips the user off and scrambles their email address.
+  # People removed this way still owe a GDPR erasure, so `erase!` has to
+  # handle the state this method leaves behind.
   def deactivate
     transaction do
       sessions.delete_all
@@ -24,11 +29,56 @@ class User < ApplicationRecord
     end
   end
 
+  # GDPR erasure. Nothing of the person is left anywhere — not a row, not a
+  # stale search hit. The one exception: books they created that are shared
+  # with everyone keep working, minus their name — bylined "Deleted author".
+  def erase!
+    email_addresses = erasable_email_addresses
+
+    transaction do
+      created_books.with_everyone_access.find_each do |book|
+        book.update!(creator: nil, author: DELETED_AUTHOR_BYLINE)
+      end
+
+      private_books = created_books.where(everyone_access: false)
+
+      # Their books' leaves must not linger in the search index. The
+      # destroy callbacks only run on commit, so pull the entries down
+      # now, within this transaction.
+      Leaf.where(book_id: private_books.select(:id)).find_each(&:remove_from_search_index)
+
+      private_books.find_each(&:destroy)
+
+      destroy!
+
+      # The sign-in log is keyed by email address, not user id, and it is
+      # erased after the destroy on purpose: tearing down the sessions
+      # writes a final "signed out" entry we want gone as well.
+      SignInEvent.where(email_address: email_addresses).delete_all
+    end
+  end
+
   private
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
 
+    # Every address the person's sign-in log can sit under.
+    def erasable_email_addresses
+      [ email_address, pre_deactivation_email_address ].compact.uniq
+    end
+
+    # Legacy-removed users were deactivated with their email rewritten to
+    # "kevin-deactivated-<uuid>@example.com", but their sign-in log entries
+    # sit under the address they actually signed in with — so both forms
+    # have to be swept.
+    def pre_deactivation_email_address
+      email_address&.sub(
+        /\A(.+)-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@/,
+        '\1@'
+      )
+    end
+
     def grant_access_to_everyone_books
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
