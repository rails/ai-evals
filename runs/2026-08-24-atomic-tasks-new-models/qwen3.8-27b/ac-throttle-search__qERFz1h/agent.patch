 class Books::SearchesController < ApplicationController
   allow_unauthenticated_access
 
+  before_action :throttle_searches, only: :create
+
   include BookScoped
 
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+
+    def throttle_searches
+      return if SearchRateLimiter.allow_request(request.remote_ip)
+
+      response.headers["Retry-After"] = SearchRateLimiter::WINDOW.to_s
+      render plain: "You have searched too many times. Please wait a minute and try again.",
+             status: :too_many_requests
+    end
 end
diff --git a/lib/search_rate_limiter.rb b/lib/search_rate_limiter.rb
new file mode 100644
index 0000000..ebbbf31
--- /dev/null
+++ b/lib/search_rate_limiter.rb
@@ -0,0 +1,54 @@
+# Keeps a sliding-window tally of recent requests per key (an address) in
+# process memory, so it needs no database and lets go by itself: once an
+# address stops, its window drains within a minute and it is served again
+# with nobody to unblock it.
+class SearchRateLimiter
+  MAX_REQUESTS = 30
+  WINDOW = 60 # seconds
+  PRUNE_THRESHOLD = 1024
+
+  class << self
+    # Records the request and returns true while the key is still within
+    # its allowance of MAX_REQUESTS requests in any sliding WINDOW.
+    # Returns false -- without recording -- once the allowance is used up,
+    # so refused requests do not keep an address throttled for longer than
+    # it keeps hammering.
+    def allow_request(key)
+      now = clock.call
+      @mutex.synchronize do
+        prune(now) if @requests.size >= PRUNE_THRESHOLD
+
+        timestamps = (@requests[key] || []).reject { |t| now - t >= WINDOW }
+        if timestamps.size < MAX_REQUESTS
+          @requests[key] = timestamps.push(now)
+          true
+        else
+          false
+        end
+      end
+    end
+
+    # Wipes all recorded activity. Intended for tests.
+    def reset!
+      @mutex.synchronize { @requests = {} }
+    end
+
+    # Defaults to the monotonic clock; intended to be replaced in tests.
+    def clock
+      @clock ||= -> { Process.clock_gettime(Process::CLOCK_MONOTONIC) }
+    end
+
+    def clock=(clock)
+      @clock = clock
+    end
+
+    private
+
+      def prune(now)
+        @requests.reject! { |_, timestamps| now - timestamps.last >= WINDOW }
+      end
+  end
+
+  @requests = {}
+  @mutex = Mutex.new
+end
diff --git a/test/integration/search_rate_limiting_test.rb b/test/integration/search_rate_limiting_test.rb
new file mode 100644
index 0000000..780eb87
--- /dev/null
+++ b/test/integration/search_rate_limiting_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class SearchRateLimitingTest < ActionDispatch::IntegrationTest
+  setup do
+    books(:handbook).update!(published: true)
+    Leaf.reindex_all
+
+    @now = 1_000_000.0
+    @previous_clock = SearchRateLimiter.clock
+    SearchRateLimiter.clock = -> { @now }
+  end
+
+  teardown do
+    SearchRateLimiter.clock = @previous_clock
+  end
+
+  test "an address gets 30 searches a minute, then 429 Too Many Requests" do
+    SearchRateLimiter::MAX_REQUESTS.times do |i|
+      post_search
+      assert_response :success, "search #{i + 1} should still be allowed"
+    end
+
+    post_search
+    assert_response :too_many_requests
+    assert_includes response.body, "too many times"
+    assert_equal "60", response.headers["Retry-After"]
+    assert_match %r{^text/plain}, response.media_type
+  end
+
+  test "other addresses and the book's pages are not affected by a throttled address" do
+    abuser = "203.0.113.2"
+    SearchRateLimiter::MAX_REQUESTS.times { post_search ip: abuser }
+    post_search ip: abuser
+    assert_response :too_many_requests
+
+    # A reader at a different address searching the same book is served,
+    # without signing in.
+    post_search ip: "203.0.113.3"
+    assert_response :success
+    assert_select "a.search__result", minimum: 1
+
+    # The throttled address can still open the book's pages.
+    get book_slug_path(books(:handbook)), env: { "REMOTE_ADDR" => abuser }
+    assert_response :success
+  end
+
+  test "a throttled address is served again once its minute has passed" do
+    abuser = "203.0.113.4"
+    SearchRateLimiter::MAX_REQUESTS.times { post_search ip: abuser }
+    post_search ip: abuser
+    assert_response :too_many_requests
+
+    @now += SearchRateLimiter::WINDOW + 1
+
+    post_search ip: abuser
+    assert_response :success
+    assert_select "a.search__result", minimum: 1
+  end
+
+  private
+
+    def post_search(ip: "203.0.113.1")
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => ip }
+    end
+end
