index 9bcf18f..21f5bc7 100644
--- a/app/models/picture.rb
+++ b/app/models/picture.rb
@@ -2,7 +2,14 @@ class Picture < ApplicationRecord
   include Leafable
 
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    # The :format value must round-trip through the signed variation URL
+    # unchanged. Variations are stored in URLs as JSON, where the symbol
+    # :webp becomes the string "webp", and the digest used to look up
+    # already-processed variants (Marshal-based) treats those as different.
+    # Declaring a string here keeps the background job and the on-demand
+    # reader path deriving from the identical variation, so the derived
+    # image is written exactly once.
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
