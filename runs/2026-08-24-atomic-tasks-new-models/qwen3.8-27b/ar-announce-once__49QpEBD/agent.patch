     @book.reload
@@ -20,13 +22,66 @@ class Books::PublicationsTest < ActionDispatch::IntegrationTest
   test "edit book slug" do
     @book.update! published: true
 
-    get edit_book_publication_url(@book)
+    get edit_book_publication_path(@book)
     assert_response :success
 
-    patch book_publication_url(@book), params: { book: { slug: "new-slug" } }
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { slug: "new-slug" } }
