diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..3e4e039 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,10 +2,25 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :remember_went_live
+    after_update_commit :announce_publication, if: :went_live?
   end
 
   private
+    def remember_went_live
+      # A sitting commits everything at once, so this callback's condition is
+      # not evaluated until then. By that point the book instance may have
+      # been reloaded or saved again (adding a page locks and reloads the
+      # book), wiping its saved changes. Remember the transition here, while
+      # it still reflects this save, so a book that ends up live is announced
+      # exactly once, whatever else the sitting did.
+      @went_live = saved_change_to_published?(to: true)
+    end
+
+    def went_live?
+      @went_live
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
