@@ -1,11 +1,40 @@
 class TitleCleanupJob < ApplicationJob
+  CHECKPOINT_NAME = "title_cleanup"
+
+  # Cleans up the stray quotes the legacy exporter wrapped around leaf titles.
+  #
+  # The run can take hours and deploys interrupt it, so progress is recorded
+  # in a JobCheckpoint after every leaf and the run resumes where it left
+  # off. Each leaf is claimed and cleaned in a single transaction, so an
+  # interruption either leaves a leaf untouched (to be redone) or has moved
+  # the checkpoint past it (never to be touched again): every title is
+  # cleaned exactly once and titles that legitimately contain quotes come
+  # through with their inner quotes intact.
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    after = cleaned_up_to
+    logger.info "Cleaning leaf titles after leaf #{after}"
+
+    Leaf.where("id > ?", after).order(:id).find_each do |leaf|
+      clean_leaf(leaf)
     end
   end
 
   private
+    def cleaned_up_to
+      JobCheckpoint.find_or_create_by!(name: CHECKPOINT_NAME).last_leaf_id
+    end
+
+    def clean_leaf(leaf)
+      Leaf.transaction do
+        claimed = JobCheckpoint.where(name: CHECKPOINT_NAME)
+                                .where("last_leaf_id < ?", leaf.id)
+                                .update_all(last_leaf_id: leaf.id)
+        raise ActiveRecord::Rollback if claimed.zero?
+
+        leaf.update!(title: cleaned(leaf.title))
+      end
+    end
+
     def cleaned(title)
       title.delete_prefix('"').delete_suffix('"')
     end
