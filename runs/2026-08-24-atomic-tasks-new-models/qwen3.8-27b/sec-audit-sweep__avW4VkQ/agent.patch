diff --git a/test/integration/security_findings_test.rb b/test/integration/security_findings_test.rb
new file mode 100644
index 0000000..df60a60
--- /dev/null
+++ b/test/integration/security_findings_test.rb
@@ -0,0 +1,217 @@
+require "test_helper"
+
+# Regression tests for the security firm's findings PT-01 .. PT-05.
+class SecurityFindingsTest < ActionDispatch::IntegrationTest
+  # PT-01: member self-service role escalation via their own profile.
+  test "PT-01 member cannot set their own role through profile update" do
+    sign_in :kevin
+    assert_not users(:kevin).administrator?
+
+    put user_profile_path(users(:kevin)), params: { user: { role: "administrator" } }
+
+    assert_equal "member", users(:kevin).reload.role
+  end
+
+  test "PT-01 profile update still allows name, email and password" do
+    sign_in :kevin
+
+    put user_profile_path(users(:kevin)), params: {
+      user: { name: "Kev", email_address: "kev@example.com", password: "newpassword123" }
+    }
+
+    kevin = users(:kevin).reload
+    assert_equal "Kev", kevin.name
+    assert_equal "kev@example.com", kevin.email_address
+    assert kevin.authenticate("newpassword123")
+  end
+
+  test "PT-01 admin can still change a role through the user admin" do
+    sign_in :david
+
+    put user_path(users(:kevin)), params: { user: { role: "administrator" } }
+
+    assert users(:kevin).reload.administrator?
+  end
+
+  # PT-02: reader destroys a book they may only read.
+  test "PT-02 reader cannot destroy a book they only read" do
+    sign_in :jz
+
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:handbook))
+    end
+
+    assert_response :forbidden
+  end
+
+  test "PT-02 signed-in user without access cannot destroy a published book" do
+    books(:manual).update!(published: true)
+    sign_in :kevin
+
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:manual))
+    end
+
+    assert_response :forbidden
+  end
+
+  test "PT-02 editor can still destroy a book they edit" do
+    sign_in :kevin
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+  end
+
+  test "PT-02 editor can still update a book they edit" do
+    sign_in :kevin
+
+    patch book_path(books(:handbook)), params: { book: { title: "Handbook Renamed" } }
+
+    assert_equal "Handbook Renamed", books(:handbook).reload.title
+  end
+
+  # PT-03: SQL injection in library search.
+  test "PT-03 search term with an apostrophe does not error" do
+    sign_in :kevin
+
+    get library_search_path(q: "it's")
+
+    assert_response :success
+  end
+
+  test "PT-03 injection payload cannot pull pages from unreadable books" do
+    books(:manual).press Page.new, title: "Confidential Terms"
+    sign_in :kevin # may read handbook only
+
+    get library_search_path(q: "' or 1=1 --")
+
+    assert_response :success
+    assert_in_body "No matches."
+    assert_not_in_body "Confidential Terms"
+    assert_not_in_body "Manual"
+  end
+
+  test "PT-03 results only ever come from books the searcher may read" do
+    books(:manual).press Page.new, title: "Needle and haystack"
+    books(:handbook).press Page.new, title: "Needles in a haystack"
+    sign_in :kevin # may read handbook only
+
+    get library_search_path(q: "needle")
+
+    assert_response :success
+    assert_in_body "Needles in a haystack"
+    assert_not_in_body "Needle and haystack"
+  end
+
+  test "PT-03 ordinary search still finds pages" do
+    sign_in :kevin
+
+    get library_search_path(q: "Summary")
+
+    assert_response :success
+    assert_in_body "Summary"
+  end
+
+  # PT-04: % and _ treated as LIKE wildcards.
+  test "PT-04 percent in title stays findable and matches literally" do
+    sign_in :kevin
+
+    books(:handbook).press Page.new, title: "Save 50% off"
+    books(:handbook).press Page.new, title: "Save fifty off"
+
+    get library_search_path(q: "Save 50% off")
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save fifty off"
+
+    get library_search_path(q: "%")
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save fifty off"
+
+    get library_search_path(q: "50%")
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save fifty off"
+  end
+
+  test "PT-04 underscore matches literally" do
+    sign_in :kevin
+
+    books(:handbook).press Page.new, title: "snake_case page"
+    books(:handbook).press Page.new, title: "snake case page"
+
+    get library_search_path(q: "snake_case")
+    assert_in_body "snake_case page"
+    assert_not_in_body "snake case page"
+
+    get library_search_path(q: "snake_")
+    assert_in_body "snake_case page"
+    assert_not_in_body "snake case page"
+  end
+
+  test "PT-04 backslash in search term matches literally" do
+    sign_in :kevin
+
+    books(:handbook).press Page.new, title: "C: drive notes"
+    books(:handbook).press Page.new, title: "C:back\\slash notes"
+
+    get library_search_path(q: "C:back\\slash")
+    assert_response :success
+    assert_in_body "C:back\\slash notes"
+    assert_not_in_body "C: drive notes"
+  end
+
+  # PT-05: page rendered under a different book's id in the URL.
+  # Secret strings are assembled at runtime so the 404 debug page (which
+  # quotes backtrace source) can never satisfy an absence assertion.
+  test "PT-05 signed-out user cannot read a private page under a public book's id" do
+    secret = books(:manual).press Page.new, title: "Top Secret Page"
+    secret.leafable.update!(body: ["Do ", "not ", "read."].join)
+    books(:handbook).update!(published: true)
+
+    path = "/#{books(:handbook).id}/#{books(:handbook).slug}/#{secret.id}/#{secret.slug}"
+    get path
+
+    assert_response :not_found
+    assert_not_in_body ["Do ", "not ", "read."].join
+  end
+
+  test "PT-05 reader cannot read another book's page under an id they can access" do
+    secret = books(:manual).press Page.new, title: "Manual Secret"
+    secret.leafable.update!(body: ["Restr", "icted."].join)
+    sign_in :kevin # editor of handbook only
+
+    path = "/#{books(:handbook).id}/#{books(:handbook).slug}/#{secret.id}/#{secret.slug}"
+    get path
+
+    assert_response :not_found
+    assert_not_in_body ["Restr", "icted."].join
+  end
+
+  test "PT-05 readable pages stay readable, signed out included" do
+    books(:handbook).update!(published: true)
+
+    get leafable_slug_path(leaves(:welcome_page))
+
+    assert_response :success
+    assert_in_body "great handbook"
+  end
+
+  test "signed-out search sees only published books' pages" do
+    books(:handbook).update!(published: true)
+    books(:manual).press Page.new, title: "Hidden Draft"
+    books(:handbook).press Page.new, title: "Public Draft"
+
+    get library_search_path(q: "Draft")
+
+    assert_response :success
+    assert_in_body "Public Draft"
+    assert_not_in_body "Hidden Draft"
+  end
+
+  test "signed-out search with nothing published returns no results, no error" do
+    get library_search_path(q: "whatever' or 1=1 -- %_")
+
+    assert_response :success
+    assert_in_body "No matches."
+  end
+end
