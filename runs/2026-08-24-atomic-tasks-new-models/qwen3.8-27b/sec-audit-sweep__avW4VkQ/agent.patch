+
+    # Turn the search term into a literal LIKE pattern: backslash, percent and
+    # underscore are escaped so they match themselves instead of acting as
+    # pattern syntax.
+    def escape_like_pattern(term)
+      term.gsub(/[\\%_]/) { |character| "\\#{character}" }
+    end
 end
