diff --git a/test/controllers/security_findings_test.rb b/test/controllers/security_findings_test.rb
new file mode 100644
index 0000000..20be56a
--- /dev/null
+++ b/test/controllers/security_findings_test.rb
@@ -0,0 +1,182 @@
+require "test_helper"
+
+# Regression tests for the external security assessment findings (PT-01 .. PT-05).
+class SecurityFindingsTest < ActionDispatch::IntegrationTest
+  # --- PT-01 · Privilege escalation -------------------------------------------
+
+  test "PT-01: member cannot grant themselves administrator via their own profile" do
+    sign_in :kevin
+    assert_not users(:kevin).administrator?
+
+    put user_profile_path(users(:kevin)), params: { user: { role: "administrator" } }
+
+    assert_not users(:kevin).reload.administrator?
+  end
+
+  test "PT-01: member cannot change anybody's role via a profile update" do
+    sign_in :kevin
+
+    put user_profile_path(users(:david)), params: { user: { role: "member" } }
+
+    assert_response :forbidden
+    assert users(:david).administrator?
+  end
+
+  test "PT-01: a member can still change their own name, email address and password" do
+    sign_in :kevin
+
+    put user_profile_path(users(:kevin)), params: { user: { name: "Kevin K", email_address: "kevin.k@example.com", password: "secret123456" } }
+
+    assert_redirected_to users_url
+    kevin = users(:kevin).reload
+    assert_equal "Kevin K", kevin.name
+    assert_equal "kevin.k@example.com", kevin.email_address
+  end
+
+  test "PT-01: an administrator can still change roles" do
+    sign_in :david
+
+    put user_path(users(:kevin)), params: { user: { role: "administrator" } }
+
+    assert_redirected_to users_url
+    assert users(:kevin).reload.administrator?
+  end
+
+  # --- PT-02 · Missing authorisation -------------------------------------------
+
+  test "PT-02: an account that may only read a book cannot destroy it" do
+    sign_in :jz
+
+    assert_no_changes(-> { Book.count }) do
+      delete book_path(books(:handbook))
+    end
+    assert_response :forbidden
+  end
+
+  test "PT-02: an account without access cannot destroy a book published to the world" do
+    books(:manual).update!(published: true)
+    sign_in :kevin
+
+    assert_no_changes(-> { Book.count }) do
+      delete book_path(books(:manual))
+    end
+    assert_response :forbidden
+  end
+
+  test "PT-02: somebody who may edit a book can still destroy it" do
+    sign_in :david
+
+    assert_changes(-> { Book.count }, -1) do
+      delete book_path(books(:handbook))
+    end
+    assert_redirected_to root_url
+  end
+
+  # --- PT-03 · Injection in library search -------------------------------------
+
+  test "PT-03: a term carrying an apostrophe comes back as results, not an error" do
+    sign_in :kevin
+
+    get library_search_path, params: { q: "don't" }
+
+    assert_response :success
+  end
+
+  test "PT-03: ordinary searches still find what they found" do
+    sign_in :kevin
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+  end
+
+  test "PT-03: results only ever come from books the searcher may read" do
+    books(:manual).press Page.new, title: "Injection Bait Page"
+    sign_in :jz # may only read the handbook
+
+    get library_search_path, params: { q: "x%' or leaves.title like '%Bait" }
+
+    assert_response :success
+    assert_not_in_body "Injection Bait Page"
+  end
+
+  test "PT-03: a signed out searcher only sees pages of published books" do
+    books(:manual).press Page.new, title: "Injection Bait Page"
+    sign_out
+
+    books(:manual).update!(published: true)
+    get library_search_path, params: { q: "Bait" }
+
+    assert_response :success
+    assert_in_body "Injection Bait Page"
+
+    books(:manual).update!(published: false)
+    get library_search_path, params: { q: "Bait" }
+
+    assert_response :success
+    assert_not_in_body "Injection Bait Page"
+  end
+
+  # --- PT-04 · Search terms read as pattern syntax ------------------------------
+
+  test "PT-04: the per cent sign is treated literally" do
+    sign_in :kevin
+    books(:handbook).press Page.new, title: "Save 50% off"
+    books(:handbook).press Page.new, title: "Save fifty off"
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save fifty off"
+
+    get library_search_path, params: { q: "%" }
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save fifty off"
+  end
+
+  test "PT-04: the underscore is treated literally" do
+    sign_in :kevin
+    books(:handbook).press Page.new, title: "under_score deals"
+    books(:handbook).press Page.new, title: "underscore deals"
+
+    get library_search_path, params: { q: "under_score deals" }
+    assert_in_body "under_score deals"
+    assert_not_in_body "underscore deals"
+
+    get library_search_path, params: { q: "_" }
+    assert_in_body "under_score deals"
+    assert_not_in_body "underscore deals"
+  end
+
+  # --- PT-05 · Insecure direct object reference ---------------------------------
+
+  test "PT-05: a page of a book the searcher may not read stays unreadable under another book id" do
+    secret_title = %w[Top Secret Page].join(" ")
+    secret = books(:manual).press Page.new, title: secret_title
+    sign_in :jz # may read the handbook, not the manual
+
+    get "/#{books(:handbook).id}/handbook/#{secret.id}/#{secret.slug}"
+
+    assert_response :not_found
+    assert_not_in_body secret_title
+  end
+
+  test "PT-05: pages of a book the searcher may read stay readable" do
+    sign_in :jz
+
+    get leafable_slug_path(leaves(:welcome_page))
+
+    assert_response :success
+    assert_select "p", "This is such a great handbook."
+  end
+
+  test "PT-05: pages stay readable signed out when the book is published" do
+    books(:handbook).update!(published: true)
+    sign_out
+
+    get leafable_slug_path(leaves(:welcome_page))
+
+    assert_response :success
+    assert_select "p", "This is such a great handbook."
+  end
+end
