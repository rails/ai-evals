+
+    # Treat a typed term as data: bind it as a query parameter instead of
+    # interpolating it into SQL, and neutralise the LIKE wildcards so that
+    # percent signs and underscores match themselves rather than any string.
+    def escape_like_wildcards(term)
+      term.gsub(/[\\%_]/) { |char| "\\#{char}" }
+    end
 end
