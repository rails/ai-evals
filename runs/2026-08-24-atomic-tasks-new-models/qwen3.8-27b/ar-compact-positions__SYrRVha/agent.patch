@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compact_positions! keeps the hand-arranged order and densifies active leaves" do
+    book = books(:handbook)
+    leaves(:reading_picture).move_to_position 1 # section, picture, page, summary
+
+    book.compact_positions!
+
+    assert_equal [ leaves(:welcome_section), leaves(:reading_picture), leaves(:welcome_page), leaves(:summary_page) ],
+                 book.leaves.active.positioned.to_a
+    assert_equal [ 1.0, 2.0, 3.0, 4.0 ], book.leaves.active.reload.pluck(:position_score).sort
+  end
+
+  test "compact_positions! leaves trashed leaves' scores alone" do
+    book = books(:handbook)
+    trashed = leaves(:welcome_page)
+    trashed.trashed!
+
+    book.compact_positions!
+
+    assert_equal [ 1.0, 2.0, 3.0 ], book.leaves.active.pluck(:position_score).sort
+    assert_equal 2.0, trashed.reload.position_score
+  end
+
+  test "a page restored from the trash comes back where it was" do
+    book = books(:handbook)
+    trashed = leaves(:welcome_page)
+    trashed.trashed!
+
+    book.compact_positions!
+    trashed.active!
+
+    assert_equal [ leaves(:welcome_section), leaves(:welcome_page), leaves(:summary_page), leaves(:reading_picture) ],
+                 book.leaves.positioned.to_a
+  end
+
+  test "live_leaf_count only counts leaves that are not in the trash" do
+    book = books(:handbook)
+
+    assert_equal 4, book.live_leaf_count
+
+    leaves(:welcome_page).trashed!
+
+    assert_equal 3, book.live_leaf_count
+  end
+end
