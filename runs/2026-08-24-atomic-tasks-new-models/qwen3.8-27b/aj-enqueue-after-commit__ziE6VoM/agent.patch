diff --git a/app/jobs/application_job.rb b/app/jobs/application_job.rb
index d394c3d..a122a29 100644
--- a/app/jobs/application_job.rb
+++ b/app/jobs/application_job.rb
@@ -1,4 +1,10 @@
 class ApplicationJob < ActiveJob::Base
+  # Background work kicked off from inside a database transaction is handed
+  # off to the queue only after that transaction commits, and is never
+  # handed off if it rolls back. This keeps workers from ever seeing rows
+  # (or files) that have not been committed yet.
+  self.enqueue_after_transaction_commit = true
+
   # Automatically retry jobs that encountered a deadlock
   # retry_on ActiveRecord::Deadlocked
 
diff --git a/app/jobs/books/import_failure_job.rb b/app/jobs/books/import_failure_job.rb
index 0bfd478..aac8bb0 100644
--- a/app/jobs/books/import_failure_job.rb
+++ b/app/jobs/books/import_failure_job.rb
@@ -1,4 +1,10 @@
 class Books::ImportFailureJob < ApplicationJob
+  # Unlike other jobs, this one must reach the operator even when the
+  # import is abandoned: it is enqueued from inside a transaction that is
+  # about to roll back, so it is handed off immediately instead of waiting
+  # for a commit that will never come.
+  self.enqueue_after_transaction_commit = false
+
   def perform(user_id, message)
     Rails.cache.write("import_failure/#{user_id}", message)
   end
diff --git a/app/models/book/editing.rb b/app/models/book/editing.rb
index d99f523..6f558d9 100644
--- a/app/models/book/editing.rb
+++ b/app/models/book/editing.rb
@@ -4,6 +4,9 @@ module Book::Editing
   def apply_edit(attributes)
     transaction do
       update!(attributes)
+      # Handed off only once this transaction commits (see
+      # ApplicationJob#enqueue_after_transaction_commit): while the edit is
+      # open nothing is queued, and if it is abandoned nothing is ever queued.
       Book::SearchIndexJob.perform_later(self)
       Book::CoverProcessingJob.set(wait: 5.seconds).perform_later(self) if attributes[:cover].present?
     end
