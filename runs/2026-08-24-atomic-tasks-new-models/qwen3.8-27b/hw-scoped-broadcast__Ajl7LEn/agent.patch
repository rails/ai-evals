diff --git a/test/controllers/being_edited_indicator_test.rb b/test/controllers/being_edited_indicator_test.rb
new file mode 100644
index 0000000..ae364fa
--- /dev/null
+++ b/test/controllers/being_edited_indicator_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  test "collaborator with the page open sees who is editing" do
+    leaf = leaves(:welcome_page)
+
+    kevin_stream = edit_page_stream_name_for :kevin
+
+    save_page_as_jason leaf
+
+    payloads = ActionCable.server.pubsub.broadcasts(kevin_stream)
+
+    assert payloads.any?, "expected a being-edited broadcast to reach #{kevin_stream}"
+    assert_includes payloads.first, users(:jason).name
+  end
+
+  test "every collaborator with the page open sees who is editing" do
+    leaf = leaves(:welcome_page)
+
+    kevin_stream = edit_page_stream_name_for :kevin
+    david_stream = edit_page_stream_name_for :david
+
+    save_page_as_jason leaf
+
+    assert ActionCable.server.pubsub.broadcasts(kevin_stream).any?
+    assert ActionCable.server.pubsub.broadcasts(david_stream).any?
+  end
+
+  test "removed collaborator no longer receives being-edited broadcasts" do
+    leaf = leaves(:welcome_page)
+
+    kevin_stream = edit_page_stream_name_for :kevin
+
+    books(:handbook).accesses.where(user: users(:kevin)).delete_all
+
+    save_page_as_jason leaf
+
+    assert ActionCable.server.pubsub.broadcasts(kevin_stream).empty?,
+      "presence payload leaked to a removed collaborator on #{kevin_stream}"
+  end
+
+  test "collaborator removed through the book settings no longer receives being-edited broadcasts" do
+    leaf = leaves(:welcome_page)
+
+    kevin_stream = edit_page_stream_name_for :kevin
+
+    sign_in :jason
+    patch book_path(books(:handbook)), params: {
+      book: { title: "Handbook", everyone_access: false,
+               editor_ids: [ users(:jason).id ], reader_ids: [ users(:jz).id ] }
+    }
+    assert_response :redirect
+    assert_not books(:handbook).accessable?(user: users(:kevin))
+
+    save_page_as_jason leaf
+
+    assert ActionCable.server.pubsub.broadcasts(kevin_stream).empty?,
+      "presence payload leaked to a removed collaborator on #{kevin_stream}"
+  end
+
+  test "reader does not receive being-edited broadcasts" do
+    leaf = leaves(:welcome_page)
+
+    save_page_as_jason leaf
+
+    jz_stream = "#{leaf.to_gid_param}:being_edited:#{users(:jz).id}"
+
+    assert ActionCable.server.pubsub.broadcasts(jz_stream).empty?,
+      "presence payload leaked to a reader on #{jz_stream}"
+  end
+
+  test "newly added collaborator receives being-edited broadcasts" do
+    leaf = leaves(:welcome_page)
+
+    books(:handbook).access_for(user: users(:jz)).update! level: :editor
+    jz_stream = edit_page_stream_name_for :jz
+
+    save_page_as_jason leaf
+
+    payloads = ActionCable.server.pubsub.broadcasts(jz_stream)
+
+    assert payloads.any?, "expected a being-edited broadcast to reach #{jz_stream}"
+    assert_includes payloads.first, users(:jason).name
+  end
+
+  test "administrator with reader access still receives being-edited broadcasts" do
+    leaf = leaves(:welcome_page)
+
+    books(:handbook).access_for(user: users(:david)).update! level: :reader
+    david_stream = edit_page_stream_name_for :david
+
+    save_page_as_jason leaf
+
+    assert ActionCable.server.pubsub.broadcasts(david_stream).any?,
+      "expected a being-edited broadcast to reach #{david_stream}"
+  end
+
+  private
+    def edit_page_stream_name_for(user)
+      sign_in user
+      get edit_book_page_path(books(:handbook), leaves(:welcome_page))
+      assert_response :success
+
+      signed = response.body[/<turbo-cable-stream-source[^>]*signed-stream-name="([^"]*)"/, 1]
+      assert signed, "expected the edit page to render a stream source"
+      stream = Turbo.signed_stream_verifier.verified(signed)
+
+      sign_out
+      stream
+    end
+
+    def save_page_as_jason(leaf)
+      sign_in :jason
+      perform_enqueued_jobs do
+        patch book_page_path(books(:handbook), leaf, format: :turbo_stream), params: {
+          leaf: { title: leaf.title }, page: { body: "Updated body." }
+        }
+      end
+      assert_response :success
+    end
+end
