diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..75586db 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,10 +2,36 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_save :note_launch
+    after_save_commit :announce_publication, if: :should_announce_launch?
+    after_rollback :forget_launch
   end
 
   private
+    # A sitting may save the book more than once (adding a page touches it),
+    # which wipes saved_changes before the commit-time announcement checks run,
+    # so note the launch when the save happens and announce at commit time.
+    def note_launch
+      if new_record?
+        @launch_announcement_pending = published?
+      elsif will_save_change_to_published?(from: false, to: true)
+        @launch_announcement_pending = true
+      end
+    end
+
+    # Consuming the note in the condition keeps the book announced at most
+    # once per sitting, whatever else that sitting saved.
+    def should_announce_launch?
+      pending = @launch_announcement_pending
+      @launch_announcement_pending = nil
+      pending
+    end
+
+    # A failed sitting rolls the launch back with everything else.
+    def forget_launch
+      @launch_announcement_pending = nil
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
