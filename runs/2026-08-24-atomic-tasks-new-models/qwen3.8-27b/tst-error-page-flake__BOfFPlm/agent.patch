diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..d3ae95f 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,30 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Runs the block as if the app were configured with
+    # config.action_dispatch.show_exceptions = :none: errors raised by
+    # controllers (e.g. ActiveRecord::RecordNotFound) propagate out of the
+    # request as raised exceptions, so tests can assert on them directly.
+    # Outside the block, error pages render as configured, whatever tests ran
+    # before or after this one in the same process.
+    #
+    # In this Rails version the middleware does not read the live config for
+    # this decision: every request's env is seeded from
+    # Rails.application.env_config, which is memoized once per process and
+    # snapshots config.action_dispatch.show_exceptions on first use. So we
+    # must flip that memoized value too, restoring both when the block ends.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      config = Rails.application.config
+      env_config = Rails.application.env_config
+      previous_config_value = config.action_dispatch.show_exceptions
+      previous_env_value = env_config["action_dispatch.show_exceptions"]
+
+      config.action_dispatch.show_exceptions = :none
+      env_config["action_dispatch.show_exceptions"] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      config.action_dispatch.show_exceptions = previous_config_value
+      env_config["action_dispatch.show_exceptions"] = previous_env_value
     end
   end
 end
