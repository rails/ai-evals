@@ -0,0 +1,9 @@
+class JobCheckpoint < ApplicationRecord
+  def self.fetch(key)
+    find_by(key: key)&.value
+  end
+
+  def self.record!(key, value)
+    upsert({ key: key, value: value }, unique_by: :key)
+  end
+end
