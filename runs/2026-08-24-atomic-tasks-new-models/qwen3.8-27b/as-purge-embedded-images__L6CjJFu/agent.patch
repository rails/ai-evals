diff --git a/test/models/page_test.rb b/test/models/page_test.rb
index b4bb79b..b2ffcc9 100644
--- a/test/models/page_test.rb
+++ b/test/models/page_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class PageTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
   test "html preview" do
     page = Page.new(body: "# Hello\n\nWorld!")
 
@@ -26,4 +28,73 @@ class PageTest < ActiveSupport::TestCase
     assert_includes page.searchable_content, "5 &lt; 10 &amp; 10 &gt; 5"
     assert page.searchable_content.html_safe?
   end
+
+  test "destroying a page removes the images embedded in its markdown" do
+    leaf = leaves(:welcome_page)
+    blob = attach_image_to leaf.page
+
+    assert_performed_jobs 1, only: [ ActiveStorage::PurgeJob ] do
+      leaf.destroy!
+    end
+
+    assert_image_gone blob
+  end
+
+  test "destroying a page with revisions removes the images embedded in its markdown" do
+    leaf = leaves(:welcome_page)
+    blob = attach_image_to leaf.page
+
+    # Editing the body records a revision, moving the leaf to a new copy of the page
+    leaf.edit leafable_params: { body: "Hello\n\n![alt] /u/#{ leaf.page.body.uploads.last.slug }\n" }
+
+    assert_performed_jobs 1, only: [ ActiveStorage::PurgeJob ] do
+      leaf.destroy!
+    end
+
+    assert_image_gone blob
+  end
+
+  test "destroying a trashed page removes the images embedded in its markdown" do
+    leaf = leaves(:welcome_page)
+    blob = attach_image_to leaf.page
+
+    leaf.trashed!
+
+    assert_performed_jobs 1, only: [ ActiveStorage::PurgeJob ] do
+      leaf.destroy!
+    end
+
+    assert_image_gone blob
+  end
+
+  test "trashing a page keeps the images embedded in its markdown" do
+    leaf = leaves(:welcome_page)
+    blob = attach_image_to leaf.page
+
+    assert_no_performed_jobs do
+      leaf.trashed!
+    end
+
+    assert_image_present blob
+  end
+
+  private
+    def attach_image_to(page)
+      markdown = page.safe_markdown_attribute("body")
+      markdown.uploads.attach File.open(Rails.root.join("test/fixtures/files/reading.webp"))
+      markdown.save!
+
+      markdown.uploads.blobs.first
+    end
+
+    def assert_image_gone(blob)
+      assert_nil ActiveStorage::Blob.find_by(id: blob.id)
+      assert_nil ActiveStorage::Attachment.find_by(blob_id: blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+
+    def assert_image_present(blob)
+      assert_equal 1, ActiveStorage::Attachment.where(blob_id: blob.id).count
+      assert blob.service.exist?(blob.key)
+    end
 end
