@@ -30,4 +30,30 @@ class SessionsController < ApplicationController
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
     end
+
+    # Shared links carry the page the reader was sent to, but the parameter
+    # is attacker-controllable. Only send the reader back when the address
+    # stays on this host; anything else (another site, a // address, a
+    # javascript: snippet, ...) is dropped so they land on the root instead.
+    def return_to_url
+      return_to = params[:return_to]
+      return unless return_to.is_a?(String) && return_to.present?
+
+      return_to if return_to_is_internal?(return_to)
+    end
+
+    def return_to_is_internal?(url)
+      uri = URI.parse(url)
+
+      if uri.relative?
+        url.start_with?("/") && !url.start_with?("//")
+      else
+        %w[ http https ].include?(uri.scheme) &&
+          uri.userinfo.nil? &&
+          uri.host == request.host &&
+          uri.port == request.port
+      end
+    rescue URI::InvalidURIError
+      false
+    end
 end
