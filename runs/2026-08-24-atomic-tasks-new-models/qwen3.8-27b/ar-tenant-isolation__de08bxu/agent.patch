diff --git a/db/migrate/20250617000000_add_tenants.rb b/db/migrate/20250617000000_add_tenants.rb
new file mode 100644
index 0000000..6950471
--- /dev/null
+++ b/db/migrate/20250617000000_add_tenants.rb
@@ -0,0 +1,20 @@
+class AddTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    Tenant.reset_column_information
+
+    # Sweep every existing user and book into a single tenant so that
+    # running installs upgrade in place, keeping working exactly as before.
+    tenant = Tenant.first_or_create!(name: "Default")
+
+    User.update_all(tenant_id: tenant.id)
+    Book.update_all(tenant_id: tenant.id)
+  end
+end
