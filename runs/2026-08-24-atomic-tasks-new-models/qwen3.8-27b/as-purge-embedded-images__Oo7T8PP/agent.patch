diff --git a/test/integration/page_image_purge_test.rb b/test/integration/page_image_purge_test.rb
new file mode 100644
index 0000000..f0fa864
--- /dev/null
+++ b/test/integration/page_image_purge_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class PageImagePurgeTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "destroying a page with an embedded image purges the image file and its records" do
+    (page, upload_url) = create_page_with_upload
+    blob = page.body.uploads.last.blob
+    assert blob
+
+    # The image must still be fetchable from the URL the app hands out for it
+    get upload_url
+    assert_response :redirect
+    get @response.redirect_url
+    assert_response :success
+
+    leaf = page.leaf
+    perform_enqueued_jobs { leaf.destroy! }
+
+    assert_image_is_gone blob
+  end
+
+  test "destroying a page directly purges its embedded image" do
+    (page, _upload_url) = create_page_with_upload
+    blob = page.body.uploads.last.blob
+
+    perform_enqueued_jobs { page.destroy! }
+
+    assert_image_is_gone blob
+  end
+
+  test "destroying a page whose body was re-saved purges its embedded image" do
+    (page, _upload_url) = create_page_with_upload
+    blob = page.body.uploads.last.blob
+    leaf = page.leaf
+
+    # Re-save the body with the image inline; this records a revision
+    put leafable_path(leaf), params: {
+      leaf: { title: leaf.title }, page: { body: "hello\n![reading](#{page.body.uploads.last.slug_path})" }
+    }
+    assert_response :success
+    assert leaf.reload.edits.any?(&:revision?)
+
+    perform_enqueued_jobs { leaf.destroy! }
+
+    assert_image_is_gone blob
+  end
+
+  test "trashing a page and then destroying it purges its embedded image" do
+    (page, _upload_url) = create_page_with_upload
+    blob = page.body.uploads.last.blob
+    leaf = page.leaf
+
+    leaf.trashed!
+    assert leaf.reload.edits.last.trash?
+
+    perform_enqueued_jobs { leaf.destroy! }
+
+    assert_image_is_gone blob
+  end
+
+  test "destroying a book purges embedded page images, including trashed pages'" do
+    book = books(:manual)
+    leaf = book.press(Page.new(body: "hi"), title: "P")
+    page = leaf.leafable
+
+    page.body.uploads.attach fixture_file_upload("reading.webp", "image/webp")
+    blob = page.body.uploads.last.blob
+
+    leaf.trashed!
+
+    leaf_search_index_ids = Leaf.connection.select_values("select rowid from leaf_search_index")
+    perform_enqueued_jobs { book.destroy! }
+
+    assert_image_is_gone blob
+    assert_not leaf_search_index_ids.include?(leaf.id.to_s)
+  end
+
+  test "shared blobs are kept while any other upload still references them" do
+    (page, _upload_url) = create_page_with_upload
+    blob = page.body.uploads.last.blob
+
+    other = books(:handbook).press(Page.new(body: "hi"), title: "Other").leafable
+    other.body.uploads.attach blob
+
+    perform_enqueued_jobs { page.leaf.destroy! }
+
+    assert ActiveStorage::Blob.exists?(blob.id), "Blob should survive while still attached elsewhere"
+    assert ActiveStorage::Blob.service.exist?(blob.key), "File should survive while still attached elsewhere"
+
+    perform_enqueued_jobs { other.leaf.destroy! }
+
+    assert_image_is_gone blob
+  end
+
+  private
+    def create_page_with_upload
+      post book_pages_path(books(:handbook), format: :turbo_stream), params: {
+        leaf: { title: "With an image" }, page: { body: "hello" }
+      }
+      assert_response :success
+
+      page = Page.joins(:leaf).where(leaves: { title: "With an image" }).last
+
+      # Drop an image straight into the page's markdown body
+      assert_difference -> { ActiveStorage::Attachment.count }, 1 do
+        post action_text_markdown_uploads_url, params: {
+          record_gid: page.to_signed_global_id.to_s,
+          attribute_name: "body",
+          file: fixture_file_upload("reading.webp", "image/webp")
+        }, as: :xhr
+      end
+      assert_response :success
+
+      upload_url = JSON.parse(response.body)["fileUrl"]
+      [ page, upload_url ]
+    end
+
+    def assert_image_is_gone(blob)
+      assert_not ActiveStorage::Blob.exists?(blob.id), "Blob record survived page destruction"
+      assert_not blob.attachments.exists?, "Attachment records survived page destruction"
+      assert_not ActiveStorage::Blob.service.exist?(blob.key), "Image file survived on disk: #{blob.key}"
+    end
+end
