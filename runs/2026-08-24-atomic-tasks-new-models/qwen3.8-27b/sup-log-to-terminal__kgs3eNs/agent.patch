diff --git a/config/environments/development.rb b/config/environments/development.rb
index e1c3d90..7692414 100644
--- a/config/environments/development.rb
+++ b/config/environments/development.rb
@@ -71,4 +71,17 @@ Rails.application.configure do
 
   # Apply autocorrection by RuboCop to files generated by `bin/rails generate`.
   config.generators.apply_rubocop_autocorrect_after_generate!
+
+  # Mirror the application log to the terminal in addition to
+  # log/development.log. Runbook scripts such as script/library_report.rb must
+  # be readable on screen by on-call, while the log file keeps the record our
+  # log tooling reads, so the terminal leg formats and filters identically.
+  config.after_initialize do
+    terminal_logger = ActiveSupport::Logger.new($stdout)
+    terminal_logger.formatter = Rails.application.config.log_formatter
+    terminal_logger.level = ActiveSupport::Logger.const_get(
+      Rails.application.config.log_level.to_s.upcase
+    )
+    Rails.logger.broadcast_to(terminal_logger)
+  end
 end
