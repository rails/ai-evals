diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..1b62f4e 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,30 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Run the block with controller errors raised into the test instead of
+    # rendered as error pages, and restore the previous behaviour afterwards.
+    #
+    # Requests never consult the live config.action_dispatch.show_exceptions
+    # setting: ActionDispatch::ShowExceptions reads the
+    # "action_dispatch.show_exceptions" entry of the request env, which test
+    # requests inherit from the memoized Rails.application.env_config hash.
+    # Flip both, then restore both: the env_config entry is what decides
+    # raise vs. render for every request made inside the block, and the
+    # live setting stays in sync in case the env config is ever
+    # re-derived. Restoring both in ensure means requests made before or
+    # after the block in this process behave exactly as before the block.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      dispatch_config = Rails.application.config.action_dispatch
+      env_config = Rails.application.env_config # materialized while the setting is pristine
+
+      previous = [ dispatch_config.show_exceptions, env_config["action_dispatch.show_exceptions"] ]
+
+      dispatch_config.show_exceptions = :none
+      env_config["action_dispatch.show_exceptions"] = :none
+
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      dispatch_config.show_exceptions, env_config["action_dispatch.show_exceptions"] = previous
     end
   end
 end
