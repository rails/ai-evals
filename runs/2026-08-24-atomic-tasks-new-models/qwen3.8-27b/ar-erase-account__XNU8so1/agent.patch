diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..d91c39f 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -1,6 +1,9 @@
 class User < ApplicationRecord
   include Authoring, Role, Transferable
 
+  DELETED_AUTHOR_BYLINE = "Deleted author"
+  DEACTIVATED_EMAIL_PATTERN = /-deactivated-[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}(?=@)/
+
   has_many :sessions, dependent: :destroy
   has_secure_password validations: false
 
@@ -17,16 +20,42 @@ class User < ApplicationRecord
     self == Current.user
   end
 
-  def deactivate
+  # Erases the user and everything of theirs from the system.
+  #
+  # The one exception is books the user created that are shared with
+  # everyone: people are still reading those, so they keep working —
+  # the user's name is taken off and the byline replaced.
+  def erase
     transaction do
+      SignInEvent.where(email_address: erasable_email_addresses).delete_all
+
+      # delete_all skips callbacks, so destroying the user's sessions does
+      # not record fresh "signed out" events for the person being erased.
       sessions.delete_all
-      update! active: false, email_address: deactived_email_address
+
+      keep_books_shared_with_everyone!
+      destroy!
     end
   end
 
   private
-    def deactived_email_address
-      email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
+    def keep_books_shared_with_everyone!
+      created_books.with_everyone_access.find_each do |book|
+        # update_columns skips validation callbacks, which would re-default
+        # creator to the current user (the administrator doing the erasing).
+        book.update_columns(creator_id: nil, author: DELETED_AUTHOR_BYLINE)
+      end
+    end
+
+    # Sign in events are kept under the address the person actually signed
+    # in with. A user removed the old way carries a deactivated address, so
+    # their events sit under the original one — erase covers both.
+    def erasable_email_addresses
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    def original_email_address
+      email_address&.sub(DEACTIVATED_EMAIL_PATTERN, "")
     end
 
     def grant_access_to_everyone_books
