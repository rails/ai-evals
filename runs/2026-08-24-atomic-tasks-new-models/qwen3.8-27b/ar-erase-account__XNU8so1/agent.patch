diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..cccc921 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,75 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "erase removes the user and everything of theirs" do
+    alice = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+
+    shared_book = Book.create!(title: "Shared Book", author: "Alice", creator: alice, everyone_access: true)
+    shared_book.press(Section.new(body: "readable by everyone"), title: "Shared leaf")
+
+    private_book = Book.create!(title: "Private Book", creator: alice, everyone_access: false)
+    private_book.press(Section.new(body: "zzqalice private journal"), title: "Private leaf")
+
+    borrowed_book = Book.create!(title: "Borrowed Book", everyone_access: false)
+    Access.create!(user: alice, book: borrowed_book, level: :editor)
+
+    ReadingMark.remember(leaves(:welcome_page), user: alice)
+    alice.sessions.create!(user_agent: "UA", ip_address: "1.2.3.4")
+    SignInEvent.create!(action: :signed_in, email_address: alice.email_address, ip_address: "1.2.3.4")
+
+    alice.erase
+
+    assert_nil User.find_by(id: alice.id)
+    assert_empty Session.where(user_id: alice.id)
+    assert_empty Access.where(user_id: alice.id)
+    assert_empty ReadingMark.where(user_id: alice.id)
+    assert_empty SignInEvent.for_address("alice@example.com")
+
+    assert_nil Book.find_by(id: private_book.id)
+    assert_empty Leaf.where(book_id: private_book.id)
+    assert_empty Leaf.search("zzqalice")
+
+    assert Book.find_by(id: borrowed_book.id)
+
+    kept = Book.find_by(id: shared_book.id)
+    assert kept
+    assert_nil kept.creator_id
+    assert_equal "Deleted author", kept.author
+    assert_equal 1, Leaf.where(book_id: shared_book.id).count
+  end
+
+  test "erase works for a user removed the old way" do
+    bob = User.create!(name: "Bob", email_address: "bob@example.com", password: "secret123456")
+
+    private_book = Book.create!(title: "Bob Private", creator: bob, everyone_access: false)
+    borrowed_book = Book.create!(title: "Borrowed Book", everyone_access: false)
+    Access.create!(user: bob, book: borrowed_book, level: :editor)
+    ReadingMark.remember(leaves(:welcome_page), user: bob)
+    bob.sessions.create!(user_agent: "UA", ip_address: "1.2.3.4")
+    SignInEvent.create!(action: :signed_in, email_address: bob.email_address, ip_address: "1.2.3.4")
+
+    # The old "Remove" left the row behind, deactivated, with a scrambled email.
+    # The sign in events were recorded under the original address.
+    bob.sessions.delete_all
+    bob.update!(active: false, email_address: "bob-deactivated-#{SecureRandom.uuid}@example.com")
+
+    bob.erase
+
+    assert_nil User.find_by(id: bob.id)
+    assert_empty Access.where(user_id: bob.id)
+    assert_empty ReadingMark.where(user_id: bob.id)
+    assert_empty SignInEvent.for_address("bob@example.com")
+    assert_empty SignInEvent.for_address(bob.email_address)
+    assert_nil Book.find_by(id: private_book.id)
+  end
+
+  test "erase works for a user with no other data" do
+    carol = User.create!(name: "Carol", email_address: "carol@example.com", password: "secret123456")
+
+    carol.erase
+
+    assert_nil User.find_by(id: carol.id)
+    assert_empty Access.where(user_id: carol.id)
+  end
 end
