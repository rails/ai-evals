@@ -0,0 +1,106 @@
+require "test_helper"
+
+# Shared and emailed links carry the page they point at as ?return_to=, and
+# sign-in sends the reader there. The parameter is whoever shared the link's,
+# so these tests pin down that sign-in still works with a deep link, without
+# one, and no value of it ever sends the reader off our host.
+class SessionsControllerReturnToTest < ActionDispatch::IntegrationTest
+  test "create returns the reader to a relative page on our host" do
+    sign_in_with "/books/handbook"
+
+    assert_redirected_to "/books/handbook"
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create returns the reader to an absolute page on our host" do
+    target = book_slug_url(books(:handbook))
+
+    sign_in_with target
+
+    assert_redirected_to target
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create returns the reader to an explicit port on our host" do
+    sign_in_with "http://www.example.com:80/books/handbook"
+
+    assert_equal "www.example.com", URI.parse(response.headers["Location"]).host
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "deep linked sign in round trip" do
+    sign_out
+    get root_path
+    return_to = Rack::Utils.parse_query(URI.parse(response.headers["Location"]).query)["return_to"]
+
+    post session_url, params: { email_address: "kevin@example.com", password: "secret123456", return_to: }
+
+    assert_redirected_to return_to
+    follow_redirect!
+    assert_response :success
+  end
+
+  test "create without a return_to goes to root" do
+    sign_in_with nil
+
+    assert_redirected_to root_url
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create with a blank return_to goes to root" do
+    sign_in_with "   "
+
+    assert_redirected_to root_url
+  end
+
+  test "create with a non-string return_to goes to root" do
+    post session_url, params: {
+      email_address: "david@example.com",
+      password: "secret123456",
+      "return_to[]": "http://evil.example.com/phish"
+    }
+
+    assert_redirected_to root_url
+  end
+
+  test "create with an oversized return_to goes to root" do
+    sign_in_with "http://www.example.com/" + "a" * 10_000
+
+    assert_redirected_to root_url
+  end
+
+  {
+    "external https"        => "https://evil.example.com/phish",
+    "external http"         => "http://evil.example.com/phish",
+    "external port"         => "https://evil.example.com:8080/phish",
+    "lookalike subdomain"   => "https://evil.example.com.evil.net/",
+    "protocol-relative"     => "//evil.example.com/phish",
+    "backslash path"        => "/\\evil.example.com/phish",
+    "bare backslash"        => "\\\evil.example.com/phish",
+    "userinfo trick"        => "http://www.example.com@evil.example.com/phish",
+    "scheme-relative junk"  => "https:evil.example.com",
+    "javascript"            => "javascript:alert(document.cookie)",
+    "data"                  => "data:text/html,phish",
+    "path traversal"        => "../books/handbook",
+    "scheme downgrade"      => "https://www.example.com/phish",
+    "port switch"           => "http://www.example.com:443/phish",
+    "control character"     => "/books/handbook\nx",
+    "null byte"             => "/books/handbook\u0000.evil.com"
+  }.each do |label, return_to|
+    test "create with a #{label} return_to never leaves our host" do
+      sign_in_with return_to
+
+      assert_response :redirect
+      assert_equal "www.example.com", URI.parse(response.headers["Location"]).host
+      assert parsed_cookies.signed[:session_token]
+    end
+  end
+
+  private
+    def sign_in_with(return_to)
+      params = { email_address: "david@example.com", password: "secret123456" }
+      params[:return_to] = return_to unless return_to.nil?
+
+      post session_url, params:
+    end
+end
