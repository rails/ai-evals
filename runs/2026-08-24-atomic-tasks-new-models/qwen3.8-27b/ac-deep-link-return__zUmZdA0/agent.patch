@@ -26,6 +26,29 @@ class SessionsController < ApplicationController
       redirect_to first_run_url if User.none?
     end
 
+    # Shared links carry ?return_to= so readers land back on the page they
+    # were reaching for. That value is whoever shared the link's, though, so
+    # only redirect there when it stays on this exact host, scheme, and port.
+    # Anything else is dropped and the reader lands where they would have
+    # without a link.
+    def safe_return_to
+      return_to = params[:return_to]
+      return unless return_to.is_a?(String) && return_to.present?
+      return if return_to.length > 2_048
+      # Browsers treat a backslash as a slash in a few positions (a path
+      # starting with "/\" plus a hostname becomes a protocol-relative URL
+      # to that host), and control characters are never valid in a Location
+      # header.
+      return if return_to.match?(/[\p{Cntrl}\\]/)
+
+      uri = URI(return_to)
+      return if uri.scheme && (uri.scheme != request.scheme || uri.port != request.port)
+
+      url_from(return_to)
+    rescue URI::Error
+      nil
+    end
+
     def render_rejection(status)
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
