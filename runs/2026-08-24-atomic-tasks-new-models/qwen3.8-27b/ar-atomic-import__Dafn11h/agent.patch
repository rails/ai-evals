--- a/app/models/book/import.rb
+++ b/app/models/book/import.rb
@@ -1,27 +1,39 @@
 module Book::Import
   extend ActiveSupport::Concern
 
+  # Signals a rejection from inside the import's transaction. The exception
+  # is only ever raised, rolled back and rescued within #import_manifest.
+  class RejectedEntry < StandardError
+    attr_reader :entry
+
+    def initialize(entry)
+      @entry = entry
+      super
+    end
+  end
+
   # Imports a manifest — an array of { title:, body: } entries — into the
   # book as sections, in manifest order. Imports are all-or-nothing: a book
   # must never be left holding part of a manifest.
   def import_manifest(entries)
     as_one_batch do
       entries.each do |entry|
-        return rejected(entry) unless entry_valid?(entry)
+        raise RejectedEntry, entry unless entry_valid?(entry)
 
         press(Section.new(body: entry[:body]), title: entry[:title])
       end
     end
     true
+  rescue RejectedEntry => error
+    Rails.logger.warn "import rejected at #{error.entry.inspect}"
+    false
+  rescue ActiveRecord::RecordInvalid => error
+    Rails.logger.warn "import rejected: #{error.message}"
+    false
   end
 
   private
     def entry_valid?(entry)
       entry[:title].present? && entry[:body].present?
     end
-
-    def rejected(entry)
-      Rails.logger.warn "import rejected at #{entry.inspect}"
-      false
-    end
 end
diff --git a/app/models/concerns/batched.rb b/app/models/concerns/batched.rb
index 55a53e7..c602b96 100644
--- a/app/models/concerns/batched.rb
+++ b/app/models/concerns/batched.rb
@@ -3,10 +3,11 @@ module Batched
 
   private
     # Runs a batch of writes as a single unit of work: either the whole batch
-    # lands or none of it does. The manifest importer goes through here so
-    # that a rejected manifest leaves the book exactly as it was before the
-    # attempt.
+    # lands or none of it does. The batch takes a transaction of its own —
+    # a real one when it is standalone, a savepoint when it runs inside a
+    # bigger transaction — so a failure unwinds exactly the batch's own work
+    # and a surrounding transaction can carry on.
     def as_one_batch(&block)
-      self.class.transaction(&block)
+      self.class.transaction(requires_new: true, &block)
     end
 end
diff --git a/test/models/book/import_test.rb b/test/models/book/import_test.rb
new file mode 100644
index 0000000..499ce20
--- /dev/null
+++ b/test/models/book/import_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class BookImportTest < ActiveSupport::TestCase
+  test "imports a fully valid manifest as sections, in manifest order" do
+    book = books(:manual)
+
+    assert book.import_manifest [
+      { title: "One", body: "First" },
+      { title: "Two", body: "Second" },
+      { title: "Three", body: "Third" }
+    ]
+
+    assert_equal %w[One Two Three], book.leaves.active.positioned.map(&:title)
+    assert_equal %w[First Second Third], sections_of(book).map(&:body)
+  end
+
+  test "appends imported sections after the book's existing leaves" do
+    book = books(:handbook)
+
+    assert book.import_manifest [ { title: "New", body: "New body" } ]
+
+    assert_equal [ "The Welcome Section", "Welcome to The Handbook!", "Summary", "Reading", "New" ],
+                 book.leaves.active.positioned.map(&:title)
+  end
+
+  test "imports nothing when an entry lacks a title" do
+    book = books(:manual)
+
+    assert_not book.import_manifest [
+      { title: "One", body: "First" },
+      { title: nil, body: "Broken" },
+      { title: "Three", body: "Third" }
+    ]
+
+    assert_empty sections_of(book)
+  end
+
+  test "imports nothing when an entry lacks a body" do
+    book = books(:manual)
+
+    assert_not book.import_manifest [
+      { title: "One", body: "First" },
+      { title: "Two", body: nil }
+    ]
+
+    assert_empty sections_of(book)
+  end
+
+  test "imports nothing when the bad entry comes first" do
+    book = books(:manual)
+
+    assert_not book.import_manifest [
+      { title: nil, body: "Broken" },
+      { title: "Good", body: "Fine" }
+    ]
+
+    assert_empty sections_of(book)
+  end
+
+  test "imports nothing when the bad entry comes last" do
+    book = books(:manual)
+
+    assert_not book.import_manifest [
+      { title: "One", body: "First" },
+      { title: "Two", body: nil }
+    ]
+
+    assert_empty sections_of(book)
+  end
+
+  test "reports a duplicate title as a rejection, not a crash" do
+    book = books(:handbook)
+
+    assert_not book.import_manifest [
+      { title: "Fresh", body: "New" },
+      { title: "Summary", body: "Taken" }
+    ]
+
+    # The book is exactly as it was before the attempt.
+    assert_equal 1, sections_of(book).size
+    assert_equal "The Welcome Section", sections_of(book).first.title
+  end
+
+  test "a re-run of a fixed manifest after a rejected one imports the whole manifest once" do
+    book = books(:manual)
+
+    assert_not book.import_manifest [
+      { title: "One", body: "First" },
+      { title: nil, body: "Broken" }
+    ]
+
+    assert book.import_manifest [
+      { title: "One", body: "First" },
+      { title: "Two", body: "Second" }
+    ]
+
+    assert_equal %w[One Two], book.leaves.active.positioned.map(&:title)
+  end
+
+  private
+    def sections_of(book)
+      book.leaves.with_leafables.where(leafable_type: "Section").map(&:leafable)
+    end
+end
diff --git a/test/models/bulk_import_test.rb b/test/models/bulk_import_test.rb
new file mode 100644
index 0000000..0ed90ba
--- /dev/null
+++ b/test/models/bulk_import_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class BulkImportTest < ActiveSupport::TestCase
+  test "imports every valid manifest and reports the books" do
+    result = BulkImport.new(
+      books(:manual)   => [ { title: "A", body: "a" }, { title: "B", body: "b" } ],
+      books(:handbook) => [ { title: "C", body: "c" } ]
+    ).run
+
+    assert_equal [ books(:manual), books(:handbook) ], result.imported
+    assert_empty result.rejected
+    assert_equal %w[A B], section_titles(books(:manual))
+    assert_equal [ "The Welcome Section", "C" ], section_titles(books(:handbook))
+  end
+
+  test "a rejected manifest leaves nothing behind while the other imports land" do
+    result = BulkImport.new(
+      books(:manual)   => [ { title: "A", body: "a" }, { title: nil, body: "broken" } ],
+      books(:handbook) => [ { title: "C", body: "c" } ]
+    ).run
+
+    assert_equal [ books(:handbook) ], result.imported
+    assert_equal [ books(:manual) ], result.rejected
+    assert_empty section_titles(books(:manual))
+    assert_equal [ "The Welcome Section", "C" ], section_titles(books(:handbook))
+  end
+
+  test "a rejected manifest coming first still leaves nothing behind" do
+    result = BulkImport.new(
+      books(:manual)   => [ { title: nil, body: "broken" }, { title: "A", body: "a" } ],
+      books(:handbook) => [ { title: "C", body: "c" }, { title: "D", body: "d" } ]
+    ).run
+
+    assert_equal [ books(:manual) ], result.rejected
+    assert_equal [ books(:handbook) ], result.imported
+    assert_empty section_titles(books(:manual))
+    assert_equal [ "The Welcome Section", "C", "D" ], section_titles(books(:handbook))
+  end
+
+  test "a manifest the book turns down for a duplicate title is rejected without crashing" do
+    books(:handbook).press(Section.new(body: "existing"), title: "Clash")
+
+    result = BulkImport.new(
+      books(:handbook) => [ { title: "Fresh", body: "f" }, { title: "Clash", body: "again" } ],
+      books(:manual)   => [ { title: "A", body: "a" } ]
+    ).run
+
+    assert_equal [ books(:handbook) ], result.rejected
+    assert_equal [ books(:manual) ], result.imported
+    assert_equal %w[A], section_titles(books(:manual))
+    assert_equal [ "The Welcome Section", "Clash" ], section_titles(books(:handbook))
+  end
+
+  private
+    def section_titles(book)
+      book.leaves.active.positioned.where(leafable_type: "Section").pluck(:title)
+    end
+end
