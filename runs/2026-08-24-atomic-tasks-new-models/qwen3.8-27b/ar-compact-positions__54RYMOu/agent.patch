+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = Book.create!(title: "Maintenance book")
+  end
+
+  test "compact_positions! densifies scores without reordering active leaves" do
+    first = @book.press Page.new(body: "1"), title: "One"
+    @book.press Page.new(body: "2"), title: "Two"
+    third = @book.press Page.new(body: "3"), title: "Three"
+
+    third.move_to_position(0)
+    first.move_to_position(2)
+
+    @book.compact_positions!
+
+    assert_equal [ "Three", "Two", "One" ], @book.leaves.active.positioned.pluck(:title)
+    assert_equal [ 1, 2, 3 ], @book.leaves.active.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! only touches the book's own leaves" do
+    @book.press Page.new(body: "1"), title: "One"
+    @book.press Page.new(body: "2"), title: "Two"
+
+    before = books(:handbook).leaves.pluck(:position_score)
+
+    @book.compact_positions!
+
+    assert_equal before, books(:handbook).leaves.pluck(:position_score)
+  end
+
+  test "compact_positions! does not touch trashed leaves" do
+    first = @book.press Page.new(body: "1"), title: "One"
+    second = @book.press Page.new(body: "2"), title: "Two"
+    @book.press Page.new(body: "3"), title: "Three"
+
+    second.trashed!
+    first.move_to_position(2)
+
+    @book.compact_positions!
+
+    assert_equal 2, second.reload.position_score
+  end
+
+  test "a leaf restored from the trash lands where its untouched score puts it" do
+    first = @book.press Page.new(body: "1"), title: "One"
+    second = @book.press Page.new(body: "2"), title: "Two"
+    third = @book.press Page.new(body: "3"), title: "Three"
+    @book.press Page.new(body: "4"), title: "Four"
+
+    second.trashed!
+    third.move_to_position(0)
+
+    # Two was trashed from the end of the arrangement: [Three, One, Two]
+    second.active!
+    expected = @book.leaves.active.positioned.pluck(:title)
+    second.trashed!
+    assert_equal [ "Three", "One", "Two", "Four" ], expected
+
+    @book.compact_positions!
+    second.active!
+
+    assert_equal [ "Three", "One", "Two", "Four" ], @book.leaves.active.positioned.pluck(:title)
+  end
+
+  test "live_leaf_count only counts leaves that are not in the trash" do
+    @book.press Page.new(body: "1"), title: "One"
+    second = @book.press Page.new(body: "2"), title: "Two"
+    @book.press Page.new(body: "3"), title: "Three"
+
+    assert_equal 3, @book.live_leaf_count
+
+    second.trashed!
+
+    assert_equal 2, @book.live_leaf_count
+
+    second.active!
+
+    assert_equal 3, @book.live_leaf_count
+  end
+end
