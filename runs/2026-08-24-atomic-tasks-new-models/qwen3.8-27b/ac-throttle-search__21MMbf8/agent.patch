+# In-memory, per-address sliding window rate limiter.
+#
+# An address may go through at most +limit+ times in any rolling stretch of
+# +window+ seconds; further requests within the stretch are refused.
+#
+# Allowances are recorded the moment they are used, and each one expires on
+# its own, so an address is served again one window after its last allowed
+# request - nobody has to unblock anything.
+class SearchRateLimiter
+  DEFAULT_LIMIT = 30
+  DEFAULT_WINDOW = 60
+
+  def self.default
+    @default ||= new
+  end
+
+  def initialize(limit: DEFAULT_LIMIT, window: DEFAULT_WINDOW)
+    @limit = limit
+    @window = window
+    @allowed_at = {}
+    @lock = Mutex.new
+  end
+
+  # Record a request from +address+ made at +at+ (defaults to now), and
+  # return whether it fits the address' remaining allowance.
+  def allow?(address, at: Time.now)
+    @lock.synchronize do
+      now = at.to_f
+      forget_stale(now)
+      recent = (@allowed_at[address] || []).reject { |allowed_at| now - allowed_at >= @window }
+      if recent.length < @limit
+        recent << now
+        @allowed_at[address] = recent
+        true
+      else
+        false
+      end
+    end
+  end
+
+  def reset!
+    @lock.synchronize { @allowed_at.clear }
+  end
+
+  private
+    def forget_stale(now)
+      @allowed_at.delete_if do |_address, allowed_at|
+        now - allowed_at.max >= @window
+      end
+    end
+end
