 class Books::SearchesController < ApplicationController
   allow_unauthenticated_access
 
+  before_action :throttle_search_requests
+
   include BookScoped
 
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    # Refuses more than a few dozen full-text searches a minute per address
+    # with 429 Too Many Requests. The allowance is per address only, and
+    # expires on its own shortly after a burst stops; it never affects
+    # anything but this action, so a throttled address can keep reading.
+    def throttle_search_requests
+      head :too_many_requests unless SearchRateLimiter.default.allow?(request.remote_ip)
+    end
 end
