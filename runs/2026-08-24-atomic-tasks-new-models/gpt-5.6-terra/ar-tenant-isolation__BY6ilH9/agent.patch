+
+    tenant_id = insert_default_tenant
+    execute "UPDATE users SET tenant_id = #{tenant_id}"
+    execute "UPDATE books SET tenant_id = #{tenant_id}"
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+    drop_table :tenants
+  end
+
+  private
+    def insert_default_tenant
+      quoted_name = connection.quote("Default")
+      execute "INSERT INTO tenants (name, created_at, updated_at) VALUES (#{quoted_name}, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)"
+      select_value("SELECT id FROM tenants ORDER BY id DESC LIMIT 1").to_i
+    end
+end
