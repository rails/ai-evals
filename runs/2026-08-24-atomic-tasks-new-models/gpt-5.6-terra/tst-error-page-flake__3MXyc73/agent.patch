@@ -2,6 +2,19 @@ ENV["RAILS_ENV"] ||= "test"
 require_relative "../config/environment"
 require "rails/test_help"
 
+# Rails copies this environment into each Rack request immediately before it
+# enters the middleware stack. Return a per-thread copy while a test asks for
+# raised exceptions; never mutate the shared application configuration.
+module RaisedExceptionsRequestEnvironment
+  def env_config
+    config = super
+    return config unless Thread.current[:with_raised_exceptions]
+
+    config.merge("action_dispatch.show_exceptions" => :none)
+  end
+end
+
+Rails::Application.prepend(RaisedExceptionsRequestEnvironment)
