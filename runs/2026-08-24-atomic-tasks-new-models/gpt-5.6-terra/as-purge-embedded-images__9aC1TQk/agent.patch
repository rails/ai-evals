@@ -1,6 +1,35 @@
 require "test_helper"
 
 class PageTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges its markdown uploads" do
+    leaf = leaves(:welcome_page)
+    page = leaf.leafable
+
+    file_fixture("reading.webp").open do |file|
+      page.body.uploads.attach io: file, filename: "reading.webp", content_type: "image/webp"
+    end
+
+    attachment = page.body.uploads.attachments.sole
+    blob = attachment.blob
+    service = blob.service
+
+    assert service.exist?(blob.key)
+
+    assert_enqueued_with job: ActiveStorage::PurgeJob do
+      leaf.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert ActiveStorage::Blob.exists?(blob.id)
+
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not service.exist?(blob.key)
+  end
+
   test "html preview" do
     page = Page.new(body: "# Hello\n\nWorld!")
 
