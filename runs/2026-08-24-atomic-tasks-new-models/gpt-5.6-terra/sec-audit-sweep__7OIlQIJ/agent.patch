diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
index 153d542..c60b416 100644
--- a/app/controllers/searches_controller.rb
+++ b/app/controllers/searches_controller.rb
@@ -11,12 +11,15 @@ class SearchesController < ApplicationController
   private
     def matching_leaves
       Leaf.active.joins(:book)
-        .where("books.id in (#{readable_book_ids.join(",")}) and leaves.title like '%#{@query}%'")
+        .merge(Book.accessable_or_published)
+        .where("leaves.title LIKE ? ESCAPE '\\'", "%#{escaped_like_query}%")
         .order("books.title", "leaves.position_score")
         .limit(RESULT_LIMIT)
     end
 
-    def readable_book_ids
-      Book.accessable_or_published.ids.presence || [ 0 ]
+    # LIKE treats %, _, and its escape character as syntax. Escape each so every
+    # user-supplied character is matched literally while preserving it in search.
+    def escaped_like_query
+      @query.gsub(/[\\%_]/) { |character| "\\#{character}" }
     end
 end
