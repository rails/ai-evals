diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..e693e4d 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -79,6 +79,40 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
   end
 
+  test "show caches table of contents separately by edit permission and refreshes renamed leaves" do
+    original_cache = Rails.cache
+    original_caching = ActionController::Base.perform_caching
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.perform_caching = true
+
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+    edit_path = edit_leafable_path(leaf)
+
+    get book_slug_url(book)
+    assert_response :success
+    assert_select "a[href='#{edit_path}']", minimum: 1
+
+    sign_in :jz
+    get book_slug_url(book)
+    assert_response :success
+    assert_select "a[href='#{edit_path}']", count: 0
+
+    leaf.update!(title: "Renamed welcome")
+    get book_slug_url(book)
+    assert_response :success
+    assert_select ".overflow-ellipsis", text: "Renamed welcome", minimum: 1
+    assert_select "a[href='#{edit_path}']", count: 0
+
+    sign_in :kevin
+    get book_slug_url(book)
+    assert_response :success
+    assert_select "a[href='#{edit_path}']", minimum: 1
+  ensure
+    Rails.cache = original_cache
+    ActionController::Base.perform_caching = original_caching
+  end
+
   test "show includes OG metadata for public access" do
     get book_slug_url(books(:handbook))
     assert_response :success
