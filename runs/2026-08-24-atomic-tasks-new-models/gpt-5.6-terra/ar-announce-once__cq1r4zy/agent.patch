+
+class Books::PublicationAnnouncementsTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+    sign_in :david
+  end
+
+  test "announces once when publishing together with a new page" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      assert_enqueued_with(job: AnnouncePublicationJob, args: [ @book ]) do
+        patch book_publication_url(@book), params: {
+          book: { published: "1" },
+          added_pages: [ "Published at once" ]
+        }
+      end
+    end
+
+    assert @book.reload.published?
+    assert_equal [ "Published at once" ], @book.leaves.pluck(:title)
+  end
+
+  test "does not announce when taking a book down" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs do
+      patch book_publication_url(@book), params: { book: { published: "0" } }
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "does not announce an already-live book when saving it again" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs do
+      patch book_publication_url(@book), params: { book: { published: "1" }, added_pages: [ "Another page" ] }
+    end
+  end
+
+  test "does not announce a draft-only save" do
+    assert_no_enqueued_jobs do
+      patch book_publication_url(@book), params: { book: { slug: "still-a-draft" } }
+    end
+
+    assert_not @book.reload.published?
+  end
+end
+
+class Books::PublicationAnnouncementRollbackTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "does not announce or publish when the publication transaction rolls back" do
+    assert_no_enqueued_jobs do
+      assert_raises RuntimeError do
+        @book.transaction do
+          @book.update! published: true
+          raise "the rest of the sitting failed"
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+end
