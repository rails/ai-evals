diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..f7f5d06 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,30 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    # A leaf save touches its book. Capture the publication transition before a
+    # later touch replaces `saved_changes`, then wait for the encompassing
+    # transaction to commit before announcing it.
+    after_update :mark_publication_for_announcement, if: :saved_change_to_published?
+    after_commit :announce_publication, if: :publication_announcement_pending?
+    after_rollback :clear_publication_announcement
   end
 
   private
+    def mark_publication_for_announcement
+      @publication_announcement_pending = published?
+    end
+
+    def publication_announcement_pending?
+      @publication_announcement_pending
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
+    ensure
+      clear_publication_announcement
+    end
+
+    def clear_publication_announcement
+      @publication_announcement_pending = false
     end
 end
