 class TitleCleanupJob < ApplicationJob
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    Leaf.where(title_cleanup_completed_at: nil).find_each(order: :asc) do |leaf|
+      leaf.with_lock do
+        # The relation may have been loaded before another job completed this
+        # leaf. Recheck while holding the row lock so cleanup is applied once.
+        next if leaf.title_cleanup_completed_at?
+
+        leaf.update!(
+          title: cleaned(leaf.title),
+          title_cleanup_completed_at: Time.current
+        )
+      end
     end
   end
 
