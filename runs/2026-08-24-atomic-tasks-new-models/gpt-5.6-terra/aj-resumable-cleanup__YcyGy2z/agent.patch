--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  test "resumes without cleaning a completed leaf again" do
+    completed_leaf = leaves(:welcome_section)
+    remaining_leaf = leaves(:welcome_page)
+
+    # This is a legitimate title beginning with a quoted phrase. Its outer
+    # exporter quote was removed before the interruption.
+    completed_leaf.update!(
+      title: '"A quoted phrase" continues',
+      title_cleanup_completed_at: Time.current
+    )
+    remaining_leaf.update!(title: '"The tail"')
+
+    TitleCleanupJob.perform_now
+
+    assert_equal '"A quoted phrase" continues', completed_leaf.reload.title
+    assert_not_nil completed_leaf.title_cleanup_completed_at
+    assert_equal "The tail", remaining_leaf.reload.title
+    assert_not_nil remaining_leaf.title_cleanup_completed_at
+  end
+
+  test "does not strip an inner opening quote when run again" do
+    leaf = leaves(:summary_page)
+    leaf.update!(title: '""A quoted phrase" continues"')
+
+    TitleCleanupJob.perform_now
+    assert_equal '"A quoted phrase" continues', leaf.reload.title
+    assert_not_nil leaf.title_cleanup_completed_at
+
+    TitleCleanupJob.perform_now
+    assert_equal '"A quoted phrase" continues', leaf.reload.title
+  end
+end
