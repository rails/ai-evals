diff --git a/test/controllers/pages_controller_test.rb b/test/controllers/pages_controller_test.rb
index 0b0ccec..202b8f1 100644
--- a/test/controllers/pages_controller_test.rb
+++ b/test/controllers/pages_controller_test.rb
@@ -79,6 +79,25 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "update broadcasts the editing indicator only to current collaborators" do
+    leaf = leaves(:welcome_page)
+    removed_user = users(:jason)
+    books(:handbook).access_for(user: removed_user).destroy!
+    clear_enqueued_jobs
+    put leafable_path(leaf), params: { page: { body: "Updated while collaborating." } }
+
+    assert_response :no_content
+    broadcasts = enqueued_jobs.select { |job| job[:job] == Turbo::Streams::BroadcastJob }
+    stream_name = ->(user) { Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited, user ]) }
+
+    broadcast_stream_names = broadcasts.map { |job| job[:args].first }
+    current_stream_names = books(:handbook).accesses.includes(:user).map { |access| stream_name.call(access.user) }
+
+    assert_equal current_stream_names.sort, broadcast_stream_names.sort
+    assert_includes broadcast_stream_names, stream_name.call(users(:kevin))
+    assert_not_includes broadcast_stream_names, stream_name.call(removed_user)
+  end
+
   private
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
