+
+  test "large image uses the copy created in the background" do
+    picture = Picture.create!(caption: "A great picture")
+
+    perform_enqueued_jobs do
+      picture.image.attach io: file_fixture("reading.webp").open,
+        filename: "reading.webp", content_type: "image/webp"
+    end
+
+    blob = picture.image.blob
+    ActiveStorage::Current.url_options = { host: "example.com", protocol: "http" }
+
+    assert_equal 1, blob.variant_records.count
+    assert_no_changes -> { ActiveStorage::Blob.count } do
+      picture.large_image.url
+    end
+    assert_equal 1, blob.reload.variant_records.count
+  end
