diff --git a/script/reproduce_library_digest_cache_leak.rb b/script/reproduce_library_digest_cache_leak.rb
new file mode 100755
index 0000000..8be4665
--- /dev/null
+++ b/script/reproduce_library_digest_cache_leak.rb
@@ -0,0 +1,22 @@
+#!/usr/bin/env ruby
+# Demonstrates the cache isolation issue without persisting any records.
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+
+Rails.cache = ActiveSupport::Cache::MemoryStore.new
+
+ActiveRecord::Base.transaction do
+  owner = User.create!(name: "Digest Owner", email_address: "digest-owner@example.test", password: "secret123456")
+  colleague = User.create!(name: "Digest Colleague", email_address: "digest-colleague@example.test", password: "secret123456")
+  private_book = Book.create!(title: "Owner only", slug: "owner-only", everyone_access: false)
+  Access.create!(user: owner, book: private_book, level: :reader)
+
+  owner_digest = owner.library_digest
+  colleague_digest = colleague.library_digest
+
+  puts "Owner digest: #{owner_digest.inspect}"
+  puts "Colleague digest: #{colleague_digest.inspect}"
+  puts "Leaked private book? #{colleague_digest.any? { |entry| entry[:id] == private_book.id }}"
+
+  raise ActiveRecord::Rollback
+end
diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..29c3643 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -18,3 +18,33 @@ class UserTest < ActiveSupport::TestCase
     assert_not other_book.accessable?(user: bob)
   end
 end
+
+class UserLibraryDigestTest < ActiveSupport::TestCase
+  test "library digests are cached per user and expire after an hour" do
+    cache, original_cache = ActiveSupport::Cache::MemoryStore.new, Rails.cache
+    Rails.cache = cache
+
+    owner = users(:kevin)
+    colleague = users(:jz)
+    owner_book = books(:handbook)
+    newly_accessible_book = books(:manual)
+
+    # Populate a colleague's cache first; it has access to both books.
+    assert_equal [ owner_book.id, newly_accessible_book.id ].sort, colleague.library_digest.pluck(:id)
+
+    owner_digest = owner.library_digest
+    assert_equal [ owner_book.id ].sort, owner_digest.pluck(:id)
+    assert_equal [ :id, :leaf_count, :title ], owner_digest.first.keys.sort
+
+    Access.create!(user: owner, book: newly_accessible_book, level: :reader)
+
+    # A repeat read uses the owner's existing digest rather than rebuilding it.
+    assert_equal [ owner_book.id ].sort, owner.library_digest.pluck(:id)
+
+    travel 1.hour + 1.second do
+      assert_equal [ owner_book.id, newly_accessible_book.id ].sort, owner.library_digest.pluck(:id)
+    end
+  ensure
+    Rails.cache = original_cache
+  end
+end
