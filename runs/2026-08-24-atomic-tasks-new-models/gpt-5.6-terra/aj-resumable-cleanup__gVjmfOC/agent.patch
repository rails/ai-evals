 class TitleCleanupJob < ApplicationJob
+  PROGRESS_NAME = "leaf_titles".freeze
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    progress = TitleCleanupProgress.create_or_find_by!(name: PROGRESS_NAME)
+
+    while process_next_leaf(progress)
     end
   end
 
   private
+    def process_next_leaf(progress)
+      progress.with_lock do
+        leaf = Leaf.where("id > ?", progress.last_leaf_id || 0).order(:id).first
+        return false unless leaf
+
+        leaf.update!(title: cleaned(leaf.title))
+        progress.update!(last_leaf_id: leaf.id)
+      end
+    end
+
     def cleaned(title)
       title.delete_prefix('"').delete_suffix('"')
     end
