diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..ff2606d 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -41,3 +41,75 @@ class BookTest < ActiveSupport::TestCase
     assert_equal "", books(:manual).markable
   end
 end
+
+class BookManifestImportTest < ActiveSupport::TestCase
+  test "rejecting an invalid manifest rolls back entries before the invalid entry" do
+    book = Book.create!(title: "Manifest rollback")
+
+    assert_not book.import_manifest([
+      { title: "First", body: "First body" },
+      { title: "Missing body", body: nil },
+      { title: "Last", body: "Last body" }
+    ])
+
+    assert_empty book.leaves
+  end
+
+  test "rejecting an invalid first entry imports nothing" do
+    book = Book.create!(title: "Invalid first manifest")
+
+    assert_not book.import_manifest([ { title: nil, body: "Body" } ])
+
+    assert_empty book.leaves
+  end
+
+  test "rejecting an invalid final entry rolls back all earlier entries" do
+    book = Book.create!(title: "Invalid final manifest")
+
+    assert_not book.import_manifest([
+      { title: "First", body: "First body" },
+      { title: "Bad", body: nil }
+    ])
+
+    assert_empty book.leaves
+  end
+
+  test "a duplicate title is a rejected manifest and rolls back its other entries" do
+    book = Book.create!(title: "Duplicate title manifest")
+    book.press(Section.new(body: "Existing body"), title: "Existing")
+
+    assert_not book.import_manifest([
+      { title: "New", body: "New body" },
+      { title: "Existing", body: "Duplicate body" }
+    ])
+
+    assert_equal [ "Existing" ], book.leaves.positioned.pluck(:title)
+  end
+
+  test "a valid manifest imports every entry in manifest order" do
+    book = Book.create!(title: "Valid manifest")
+
+    assert book.import_manifest([
+      { title: "First", body: "First body" },
+      { title: "Second", body: "Second body" }
+    ])
+
+    assert_equal [ "First", "Second" ], book.leaves.positioned.pluck(:title)
+    assert_equal [ "First body", "Second body" ], book.leaves.positioned.map { it.leafable.body }
+  end
+
+  test "a rejected manifest rolls back only itself inside an outer transaction" do
+    accepted_book = Book.create!(title: "Accepted bulk manifest")
+    rejected_book = Book.create!(title: "Rejected bulk manifest")
+
+    result = BulkImport.new(
+      accepted_book => [ { title: "Accepted", body: "Accepted body" } ],
+      rejected_book => [ { title: "Before rejection", body: "Body" }, { title: "Bad", body: nil } ]
+    ).run
+
+    assert_equal [ accepted_book ], result.imported
+    assert_equal [ rejected_book ], result.rejected
+    assert_equal [ "Accepted" ], accepted_book.leaves.positioned.pluck(:title)
+    assert_empty rejected_book.leaves
+  end
+end
