diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..2665bfb 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -18,3 +18,44 @@ class UserTest < ActiveSupport::TestCase
     assert_not other_book.accessable?(user: bob)
   end
 end
+
+class UserErasureTest < ActiveSupport::TestCase
+  test "erasure removes personal records and keeps shared books anonymized" do
+    user = User.create!(email_address: "erase-me@example.com", name: "Erase Me", password: "secret123456")
+    private_book = Book.create!(title: "Private book", slug: "private-book", creator: user, everyone_access: false)
+    private_leaf = private_book.press(Section.new(body: "private-erasure-search-token"), title: "Private page")
+    shared_book = Book.create!(title: "Shared book", slug: "shared-book", creator: user, author: user.name, everyone_access: true)
+    other_book = Book.create!(title: "Other private book", slug: "other-private-book", everyone_access: false)
+
+    Session.create!(user: user)
+    Access.create!(user: user, book: other_book, level: :reader)
+    ReadingMark.create!(user: user, leaf: leaves(:welcome_page), last_read_at: Time.current)
+    SignInEvent.create!(email_address: user.email_address, action: :signed_in)
+
+    user.erase!
+
+    assert_not User.exists?(user.id)
+    assert_not Session.exists?(user_id: user.id)
+    assert_not Access.exists?(user_id: user.id)
+    assert_not ReadingMark.exists?(user_id: user.id)
+    assert_not SignInEvent.exists?(email_address: "erase-me@example.com")
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_empty Leaf.search("private-erasure-search-token")
+
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+  end
+
+  test "erasure removes audit events for a legacy deactivated email address" do
+    user = User.create!(email_address: "legacy@example.com", name: "Legacy User", password: "secret123456")
+    SignInEvent.create!(email_address: "legacy@example.com", action: :signed_in)
+    user.deactivate
+
+    user.erase!
+
+    assert_not User.exists?(user.id)
+    assert_not SignInEvent.exists?(email_address: "legacy@example.com")
+  end
+end
