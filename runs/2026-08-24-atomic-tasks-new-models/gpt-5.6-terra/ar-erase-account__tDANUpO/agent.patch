diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..069eb37 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -24,7 +24,30 @@ class User < ApplicationRecord
     end
   end
 
+  # Permanently removes all personal data for this user. Books shared with
+  # everyone remain available, but are detached from the erased user and
+  # attributed to a generic deleted author.
+  def erase!
+    transaction do
+      email_addresses = signed_in_email_addresses
+
+      created_books.where(everyone_access: true).update_all(creator_id: nil, author: "Deleted author")
+      created_books.where.not(everyone_access: true).find_each(&:destroy!)
+
+      sessions.delete_all
+      accesses.delete_all
+      reading_marks.delete_all
+      SignInEvent.where(email_address: email_addresses).delete_all
+
+      destroy!
+    end
+  end
+
   private
+    def signed_in_email_addresses
+      [ email_address, email_address&.sub(/-deactivated-[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}@/i, "@") ].compact.uniq
+    end
+
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
