diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..7a9ee9c 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,34 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :mark_publication_announcement, if: :published_change_to_live?
+    after_update_commit :announce_publication, if: :publication_announcement_pending?
+    after_rollback :clear_publication_announcement
   end
 
   private
+    def published_change_to_live?
+      published? && saved_change_to_published?
+    end
+
+    # A book can be touched by leaf changes later in the transaction. Keep the
+    # draft-to-live transition until the transaction commits, rather than asking
+    # the final touch which attributes changed.
+    def mark_publication_announcement
+      @publication_announcement_pending = true
+    end
+
+    def publication_announcement_pending?
+      @publication_announcement_pending
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
+    ensure
+      clear_publication_announcement
+    end
+
+    def clear_publication_announcement
+      @publication_announcement_pending = false
     end
 end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..26be079
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+    clear_enqueued_jobs
+  end
+
+  test "announces once when publishing with other changes in the same transaction" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "New page"
+      end
+    end
+  end
+
+  test "does not announce when saving an already live book" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! slug: "renamed-manual"
+    end
+  end
+
+  test "does not announce when taking a live book down" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "does not announce when a book remains a draft" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! slug: "renamed-manual"
+    end
+  end
+
+  test "does not announce or publish when its transaction rolls back" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises RuntimeError do
+        @book.transaction do
+          @book.update! published: true
+          @book.press Page.new(body: ""), title: "Uncommitted page"
+          raise "fail the sitting"
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+end
