diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..01d2793 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,47 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "editing presence is broadcast to each current editor's private stream" do
+    leaf = leaves(:welcome_page)
+    clear_enqueued_jobs
+
+    put leafable_path(leaf), params: { page: { body: "Updated" } }
+
+    assert_response :no_content
+    assert_equal books(:handbook).editing_users.map { |user|
+      Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited, user ])
+    }.sort, presence_broadcast_streams.sort
+  end
+
+  test "editing presence is not broadcast to a removed collaborator" do
+    leaf = leaves(:welcome_page)
+    removed_user = users(:jz)
+    books(:handbook).update_access(editors: [ users(:kevin).id ], readers: [])
+    clear_enqueued_jobs
+
+    put leafable_path(leaf), params: { page: { body: "Updated" } }
+
+    assert_response :no_content
+    assert_not_includes presence_broadcast_streams,
+      Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited, removed_user ])
+  end
+
+
+  test "edit subscribes to the current user's presence stream" do
+    leaf = leaves(:welcome_page)
+
+    get edit_leafable_path(leaf)
+
+    assert_response :success
+    assert_select "turbo-cable-stream-source[signed-stream-name=?]",
+      Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited, users(:kevin) ])
+  end
+
+  private
+    def presence_broadcast_streams
+      enqueued_jobs.filter_map { |job|
+        job[:args].first if job[:job] == Turbo::Streams::BroadcastJob
+      }
+    end
 end
