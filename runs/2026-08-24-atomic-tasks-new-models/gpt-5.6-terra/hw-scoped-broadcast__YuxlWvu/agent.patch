diff --git a/app/models/book/accessable.rb b/app/models/book/accessable.rb
index aa3dcf1..13f4be2 100644
--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -32,6 +32,12 @@ module Book::Accessable
     accesses.find_by(user: user)
   end
 
+  # Presence updates are sent to individual users so that an open Cable
+  # subscription cannot continue to receive them after access is revoked.
+  def editing_users
+    User.where(id: accesses.editor.select(:user_id)).or(User.administrator)
+  end
+
   def update_access(editors:, readers:)
     editors = Set.new(editors)
     readers = Set.new(everyone_access? ? User.active.ids : readers)
