index 4829eaf..89ef465 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -17,6 +17,28 @@ class User < ApplicationRecord
     self == Current.user
   end
 
+  # Permanently removes all personal data for this user. Books shared with
+  # everyone are retained, but no longer identify their creator.
+  def erase!
+    transaction do
+      # Destroying a session records a sign-out event. Do that before deleting
+      # audit records so its callback cannot leave a new personal-data row.
+      sessions.destroy_all
+
+      created_books.with_everyone_access.update_all(
+        creator_id: nil, author: "Deleted author", updated_at: Time.current
+      )
+      created_books.where(everyone_access: false).find_each(&:destroy!)
+
+      accesses.delete_all
+      reading_marks.delete_all
+      SignInEvent.where(email_address: email_addresses_for_erasure).delete_all
+
+      destroy!
+    end
+  end
+
+  # Retained for callers that deliberately need the old, reversible removal.
   def deactivate
     transaction do
       sessions.delete_all
@@ -25,6 +47,17 @@ class User < ApplicationRecord
   end
 
   private
+    # Legacy deactivation changed alice@example.com to
+    # alice-deactivated-<uuid>@example.com. Audit events retain the address
+    # used to sign in, so erase both versions.
+    def email_addresses_for_erasure
+      [ email_address, email_address&.sub(deactivated_email_suffix, "@") ].compact.uniq
+    end
+
+    def deactivated_email_suffix
+      /-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@/i
+    end
+
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
