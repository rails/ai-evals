 class Books::SearchesControllerTest < ActionDispatch::IntegrationTest
   setup do
+    Rails.cache.clear
     sign_in :kevin
 
     Leaf.reindex_all
   end
 
+  test "create limits searches to thirty requests per minute for each address" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    30.times { search_from "203.0.113.1" }
+    assert_response :success
+
+    search_from "203.0.113.1"
+    assert_response :too_many_requests
+
+    search_from "203.0.113.2"
+    assert_response :success
+
+    get book_slug_path(books(:handbook)), headers: { "REMOTE_ADDR" => "203.0.113.1" }
+    assert_response :success
+  end
+
+  test "create serves an address again after its rate-limit window expires" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    31.times { search_from "203.0.113.3" }
+    assert_response :too_many_requests
+
+    travel 5.minutes do
+      search_from "203.0.113.3"
+      assert_response :success
+    end
+  end
+
   test "create finds matching pages" do
     post book_search_url(books(:handbook)), params: { search: "Thanks" }
 
