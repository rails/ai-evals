diff --git a/app/models/picture.rb b/app/models/picture.rb
index 9bcf18f..6df23a7 100644
--- a/app/models/picture.rb
+++ b/app/models/picture.rb
@@ -6,7 +6,10 @@ class Picture < ApplicationRecord
   end
 
   def large_image
-    image.variable? ? image.variant(:large) : image
+    return image unless image.variable?
+
+    variant = image.variant(:large)
+    variant.processed? ? variant.image : variant
   end
 
   def markable
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..57e60bc 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -76,6 +76,24 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
     assert_in_body "title: \"Reading\""
   end
 
+  test "show links a background-processed picture directly to its stored copy" do
+    picture = leaves(:reading_picture).picture
+    transformations = Picture.reflect_on_attachment(:image).named_variants.fetch(:large).transformations
+    ActiveStorage::TransformJob.perform_now(picture.image.blob, transformations)
+
+    get leafable_slug_path(leaves(:reading_picture))
+
+    assert_response :success
+    assert_select "figure img[src*='/rails/active_storage/blobs/']"
+    assert_select "figure img[src*='/rails/active_storage/representations/']", count: 0
+
+    image_url = css_select("figure img").first["src"]
+    get image_url
+    follow_redirect!
+
+    assert_equal picture.image.variant(:large).image.download, response.body
+  end
+
   test "show a picture whose image cannot be resized" do
     leaves(:reading_picture).leafable.image.attach io: file_fixture("pixel.bmp").open,
       filename: "pixel.bmp", content_type: "image/bmp"
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..d88b371 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -17,6 +17,19 @@ class PictureTest < ActiveSupport::TestCase
     assert_kind_of ActiveStorage::VariantWithRecord, pictures(:reading).large_image
   end
 
+  test "large_image uses the copy created by background processing" do
+    picture = pictures(:reading)
+    transformations = Picture.reflect_on_attachment(:image).named_variants.fetch(:large).transformations
+
+    ActiveStorage::TransformJob.perform_now(picture.image.blob, transformations)
+
+    assert_equal 1, picture.image.blob.variant_records.count
+
+    stored_image = picture.image.variant(:large).image
+    assert_equal stored_image.blob, picture.large_image.blob
+    assert_equal stored_image.download, picture.large_image.download
+  end
+
   test "large_image is the original image when the image cannot be resized" do
     picture = pictures(:reading)
     picture.image.attach io: file_fixture("pixel.bmp").open, filename: "pixel.bmp", content_type: "image/bmp"
