diff --git a/test/models/user_erasure_test.rb b/test/models/user_erasure_test.rb
new file mode 100644
index 0000000..93570fe
--- /dev/null
+++ b/test/models/user_erasure_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class UserErasureTest < ActiveSupport::TestCase
+  test "erases an active user and preserves anonymized books shared with everyone" do
+    user = users(:kevin)
+    shared_book = create_book(user, everyone_access: true, title: "Shared book")
+    private_book = create_book(user, everyone_access: false, title: "Private book")
+    private_leaf = private_book.leaves.first
+    private_book.cover.attach io: StringIO.new("private cover"), filename: "private.txt", content_type: "text/plain"
+    private_cover_blob_id = private_book.cover.blob.id
+    user.sessions.create!(ip_address: "192.0.2.1", user_agent: "browser")
+    ReadingMark.remember(leaves(:welcome_page), user: user)
+    SignInEvent.create!(email_address: user.email_address, action: :signed_in)
+
+    user.erase!
+
+    assert_not User.exists?(user.id)
+    assert_not Session.where(user_id: user.id).exists?
+    assert_not Access.where(user_id: user.id).exists?
+    assert_not ReadingMark.where(user_id: user.id).exists?
+    assert_not SignInEvent.for_address("kevin@example.com").exists?
+
+    assert_equal "Deleted author", shared_book.reload.author
+    assert_nil shared_book.creator_id
+    assert Book.exists?(shared_book.id)
+
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_not ActiveStorage::Attachment.exists?(blob_id: private_cover_blob_id)
+    assert_not ActiveStorage::Blob.exists?(private_cover_blob_id)
+    assert_equal 0, Leaf.connection.select_value("select count(*) from leaf_search_index where rowid = #{private_leaf.id}").to_i
+  end
+
+  test "erases a legacy-deactivated user's sign-in events under their original address" do
+    user = users(:kevin)
+    original_email = user.email_address
+    user.deactivate
+    SignInEvent.create!(email_address: original_email, action: :signed_in)
+    SignInEvent.create!(email_address: user.email_address, action: :signed_out)
+
+    user.erase!
+
+    assert_not User.exists?(user.id)
+    assert_not SignInEvent.for_address(original_email).exists?
+    assert_not SignInEvent.for_address(user.email_address).exists?
+  end
+
+  private
+    def create_book(user, everyone_access:, title:)
+      Book.create!(title:, author: user.name, everyone_access:, creator: user).tap do |book|
+        book.press Section.create!(body: "unique searchable content"),
+          title: "#{title} leaf", position_score: 1
+      end
+    end
+end
