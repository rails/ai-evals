diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..d89ad95 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -17,6 +17,26 @@ class User < ApplicationRecord
     self == Current.user
   end
 
+  # Permanently remove all personal data while preserving books that are shared
+  # with everyone. The preserved books are no longer associated with this user.
+  def erase!
+    email_addresses = sign_in_email_addresses
+
+    transaction do
+      created_books.with_everyone_access.update_all(creator_id: nil, author: "Deleted author")
+      destroy_private_created_books
+
+      ReadingMark.where(user_id: id).delete_all
+      sessions.destroy_all
+      accesses.delete_all
+      destroy!
+
+      # Sessions record sign-out events as they are destroyed, so remove audit
+      # records only after all session callbacks have run.
+      SignInEvent.where(email_address: email_addresses).delete_all
+    end
+  end
+
   def deactivate
     transaction do
       sessions.delete_all
@@ -25,6 +45,38 @@ class User < ApplicationRecord
   end
 
   private
+    def destroy_private_created_books
+      books = created_books.where.not(everyone_access: true)
+      purge_attachments_for(books)
+      books.destroy_all
+    end
+
+    def purge_attachments_for(books)
+      attachments = ActiveStorage::Attachment.where(record_type: "Book", record_id: books.ids)
+      leafables = Leaf.where(book_id: books.ids).pluck(:leafable_type, :leafable_id).group_by(&:first)
+
+      leafables.each do |type, records|
+        record_ids = records.map(&:last)
+        attachments = attachments.or(ActiveStorage::Attachment.where(record_type: type, record_id: record_ids))
+
+        markdown_ids = ActionText::Markdown.where(record_type: type, record_id: record_ids).ids
+        attachments = attachments.or(ActiveStorage::Attachment.where(record_type: "ActionText::Markdown", record_id: markdown_ids))
+      end
+
+      attachments.find_each(&:purge)
+    end
+
+    def sign_in_email_addresses
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    # Before permanent erasure, the old Remove action replaced
+    # alice@example.com with alice-deactivated-<uuid>@example.com. Sign-in
+    # events retain the address that was used at sign-in, so recover it.
+    def original_email_address
+      email_address&.sub(/\A(.+)-deactivated-[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}@(.*)\z/i, "\\1@\\2")
+    end
+
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
