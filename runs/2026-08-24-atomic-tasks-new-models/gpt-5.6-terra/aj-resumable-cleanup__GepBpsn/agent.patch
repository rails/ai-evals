diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..5002420
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  setup do
+    TitleCleanupProgress.delete_all
+  end
+
+  test "resumes after an interruption without cleaning a completed title again" do
+    first, second = Leaf.order(:id).limit(2).to_a
+    first.update!(title: '""Quoted" phrase"')
+    second.update!(title: '"Tail"')
+
+    # Simulate a deploy after the first leaf transaction has committed.
+    assert TitleCleanupJob.new.send(:process_next_leaf)
+    assert_equal '"Quoted" phrase', first.reload.title
+
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Quoted" phrase', first.reload.title
+    assert_equal "Tail", second.reload.title
+    assert_equal Leaf.maximum(:id), TitleCleanupProgress.find_by!(key: TitleCleanupJob::PROGRESS_KEY).last_leaf_id
+  end
+end
