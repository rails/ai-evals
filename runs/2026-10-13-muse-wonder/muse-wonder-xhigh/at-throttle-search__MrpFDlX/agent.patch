diff --git a/app/controllers/books/searches_controller.rb b/app/controllers/books/searches_controller.rb
index 5268c55..d02c672 100644
--- a/app/controllers/books/searches_controller.rb
+++ b/app/controllers/books/searches_controller.rb
@@ -3,7 +3,68 @@ class Books::SearchesController < ApplicationController
 
   include BookScoped
 
+  # Unauthenticated full-text search is expensive, so cap how often a
+  # single address may use it. The limit is a sliding window: at most
+  # SEARCH_RATE_LIMIT requests in any SEARCH_RATE_WINDOW stretch.
+  # Only the timestamps of served requests are kept, and they expire
+  # with the window, so an address is served again automatically once
+  # its earlier requests age out -- no manual unblocking is needed.
+  SEARCH_RATE_LIMIT = 30
+  SEARCH_RATE_WINDOW = 1.minute
+
+  class << self
+    # Process-local fallback for environments whose cache is a null
+    # store (e.g. development without caching enabled), where
+    # Rails.cache would otherwise silently discard the timestamps.
+    def fallback_rate_limit_store
+      @fallback_rate_limit_store ||= ActiveSupport::Cache::MemoryStore.new
+    end
+
+    def rate_limit_lock
+      @rate_limit_lock ||= Mutex.new
+    end
+  end
+
+  # Prepended so an over-limit address is refused before any book
+  # lookup or full-text work happens, whatever book it asked for.
+  prepend_before_action :enforce_search_rate_limit, only: :create
+
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    def enforce_search_rate_limit
+      now = Time.current
+      store = search_rate_limit_store
+      cache_key = "books/searches/rate_limit/#{request.remote_ip.presence || "unknown"}"
+
+      retry_after = self.class.rate_limit_lock.synchronize do
+        timestamps = Array(store.read(cache_key)).map(&:to_f)
+        timestamps.reject! { |timestamp| timestamp <= (now - SEARCH_RATE_WINDOW).to_f }
+
+        if timestamps.size >= SEARCH_RATE_LIMIT
+          # Refuse without recording the attempt, so being refused does
+          # not extend the window beyond the served requests.
+          (timestamps.min + SEARCH_RATE_WINDOW - now.to_f).ceil.clamp(1, SEARCH_RATE_WINDOW.to_i)
+        else
+          timestamps << now.to_f
+          store.write(cache_key, timestamps, expires_in: SEARCH_RATE_WINDOW)
+          nil
+        end
+      end
+
+      if retry_after
+        response.set_header("Retry-After", retry_after.to_s)
+        head :too_many_requests
+      end
+    end
+
+    def search_rate_limit_store
+      if Rails.cache.is_a?(ActiveSupport::Cache::NullStore)
+        self.class.fallback_rate_limit_store
+      else
+        Rails.cache
+      end
+    end
 end
