+class ExportMailer < ApplicationMailer
+  def ready(export)
+    build_ready(export)
+  end
+
+  def download_ready(export)
+    build_ready(export)
+  end
+  alias export_ready download_ready
+
+  def failed(export)
+    build_failed(export)
+  end
+
+  def export_failed(export)
+    build_failed(export)
+  end
+
+  private
+    def build_ready(export)
+      @export = export
+      @account = export.account
+      @user = export.user
+      @download_url = export.download_url(expires_in: 1.day)
+
+      mail(to: @user.identity.email_address, subject: "Your Fizzy export is ready to download") do |format|
+        format.html { render "ready" }
+        format.text { render "ready" }
+      end
+    end
+
+    def build_failed(export)
+      @export = export
+      @account = export.account
+      @user = export.user
+      @failure_reason = export.failure_reason
+
+      mail(to: @user.identity.email_address, subject: "Your Fizzy export failed") do |format|
+        format.html { render "failed" }
+        format.text { render "failed" }
+      end
+    end
+end
diff --git a/app/mailers/import_mailer.rb b/app/mailers/import_mailer.rb
