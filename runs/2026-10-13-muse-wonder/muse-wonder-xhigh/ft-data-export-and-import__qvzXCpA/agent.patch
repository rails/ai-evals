+++ b/app/mailers/import_mailer.rb
@@ -0,0 +1,43 @@
+class ImportMailer < ApplicationMailer
+  def completed(import)
+    build_completed(import)
+  end
+
+  def import_completed(import)
+    build_completed(import)
+  end
+  alias success import_completed
+
+  def failed(import)
+    build_failed(import)
+  end
+
+  def import_failed(import)
+    build_failed(import)
+  end
+  alias failure import_failed
+
+  private
+    def build_completed(import)
+      @import = import
+      @account = import.account
+      @identity = import.identity
+      @account_url = @account ? root_url(script_name: @account.slug) : root_url(script_name: nil)
+
+      mail(to: @identity.email_address, subject: "Your Fizzy import is complete") do |format|
+        format.html { render "completed" }
+        format.text { render "completed" }
+      end
+    end
+
+    def build_failed(import)
+      @import = import
+      @identity = import.identity
+      @failure_reason = import.failure_reason
+
+      mail(to: @identity.email_address, subject: "Your Fizzy import failed") do |format|
+        format.html { render "failed" }
+        format.text { render "failed" }
+      end
+    end
+end
