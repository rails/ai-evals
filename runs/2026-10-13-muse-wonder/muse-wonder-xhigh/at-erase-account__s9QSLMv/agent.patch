diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..bef7a1b 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -10,6 +10,13 @@ class User < ApplicationRecord
 
   after_create :grant_access_to_everyone_books
 
+  # Erasure must run before the dependent: :destroy associations below it in
+  # the callback chain, so it can preserve/anonymize shared books, remove
+  # sessions without generating new audit events, and remember which search
+  # index entries belong to books that are about to be destroyed.
+  before_destroy :prepare_erasure, prepend: true
+  after_destroy :complete_erasure
+
   scope :active, -> { where(active: true) }
   scope :ordered, -> { order(:name) }
 
@@ -33,4 +40,66 @@ class User < ApplicationRecord
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
     end
+
+    # Full erasure, performed as part of #destroy:
+    #
+    # * Books shared with everyone are kept for their other readers, but
+    #   detached from this user and re-bylined. update_all is deliberate:
+    #   Book#creator has a `default: -> { Current.user }`, so assigning
+    #   `creator: nil` through the association would silently hand the book
+    #   to whoever is performing the erasure.
+    # * Every other created book is left in place here and removed by the
+    #   `dependent: :destroy` on created_books, which cascades to leaves,
+    #   leafables, edits, accesses and (via Leaf::Searchable) the FTS index.
+    # * Sessions are deleted with delete_all, not destroyed: Session::Auditable
+    #   records a "signed out" SignInEvent on destroy, which would recreate
+    #   the very personal data being erased.
+    # * Sign-in events are keyed only by email address, so they must be
+    #   removed explicitly -- for the address currently on the record and,
+    #   for users previously deactivated the old way, for the original
+    #   address recovered from the rewritten one.
+    def prepare_erasure
+      @erased_leaf_ids = created_books.where(everyone_access: false)
+                                      .joins(:leaves).pluck("leaves.id")
+
+      created_books.with_everyone_access.update_all(
+        creator_id: nil, author: "Deleted author", updated_at: Time.current
+      )
+
+      sessions.delete_all
+      reading_marks.delete_all
+      delete_sign_in_events
+    end
+
+    # Belt and braces: remove anything that destroying the remaining
+    # associated records may have (re)created, and drop any FTS rows for
+    # leaves of destroyed books in case the after_destroy_commit cleanup
+    # in Leaf::Searchable did not run (e.g. because the leafable, and thus
+    # its searchable content, was already gone by commit time).
+    def complete_erasure
+      delete_sign_in_events
+      delete_from_search_index(@erased_leaf_ids) if @erased_leaf_ids.present?
+    end
+
+    def delete_sign_in_events
+      SignInEvent.where(email_address: sign_in_email_addresses).delete_all
+    end
+
+    def sign_in_email_addresses
+      [ email_address, original_email_address ].compact_blank.uniq
+    end
+
+    # Users "removed" before erasure existed had their address rewritten to
+    # `alice-deactivated-<uuid>@example.com`, while their sign-in events
+    # remain filed under the address they actually signed in with. Recover
+    # that original address so those events can be removed too.
+    def original_email_address
+      match = email_address.to_s.match(/\A(.+?)(?:-deactivated-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})+(@.*)\z/)
+      match ? "#{match[1]}#{match[2]}" : email_address.to_s
+    end
+
+    def delete_from_search_index(leaf_ids)
+      ids = leaf_ids.map(&:to_i).join(", ")
+      Leaf.connection.execute("delete from leaf_search_index where rowid in (#{ids})")
+    end
 end
