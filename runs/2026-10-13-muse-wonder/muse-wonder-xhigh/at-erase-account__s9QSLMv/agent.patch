diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..5c0feca 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,52 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "destroying a user erases them and their private books but anonymizes everyone books" do
+    user = users(:kevin)
+    user.sessions.start!(user_agent: "Test Agent", ip_address: "127.0.0.1")
+    ReadingMark.remember(leaves(:welcome_page), user: user)
+
+    private_book = Book.create!(title: "Kevin Private", author: user.name, everyone_access: false, creator: user)
+    private_book.press(Section.new(body: "kevinsprivatewords"), title: "Private section")
+
+    everyone_book = Book.create!(title: "Kevin Shared", author: user.name, everyone_access: true, creator: user)
+    everyone_book.press(Section.new(body: "kevinssharedwords"), title: "Shared section")
+
+    private_leaf_id = private_book.leaves.first.id
+    assert_includes Leaf.search("kevinsprivatewords"), private_book.leaves.first
+
+    user.destroy!
+
+    assert_not User.exists?(user.id)
+    assert_not Session.where(user_id: user.id).exists?
+    assert_not Access.where(user_id: user.id).exists?
+    assert_not ReadingMark.where(user_id: user.id).exists?
+    assert_not SignInEvent.where(email_address: user.email_address).exists?
+
+    assert_not Book.exists?(private_book.id)
+    assert_empty Leaf.search("kevinsprivatewords")
+    assert_not_includes ActiveRecord::Base.connection.select_values("select rowid from leaf_search_index"), private_leaf_id
+
+    shared = Book.find(everyone_book.id)
+    assert_nil shared.creator_id
+    assert_equal "Deleted author", shared.author
+    assert_includes Leaf.search("kevinssharedwords"), shared.leaves.first
+  end
+
+  test "destroying a previously deactivated user erases sign-in events under their original email" do
+    user = users(:kevin)
+    original_email = user.email_address
+    user.sessions.start!(user_agent: "Test Agent", ip_address: "127.0.0.1")
+
+    user.deactivate
+    assert_not_equal original_email, user.reload.email_address
+    assert SignInEvent.where(email_address: original_email).exists?
+
+    user.destroy!
+
+    assert_not User.exists?(user.id)
+    assert_not SignInEvent.where(email_address: original_email).exists?
+    assert_not SignInEvent.where(email_address: user.email_address).exists?
+  end
 end
