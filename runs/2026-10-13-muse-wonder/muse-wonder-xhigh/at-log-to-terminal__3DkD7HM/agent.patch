diff --git a/script/library_report.rb b/script/library_report.rb
index 76294dc..982638d 100644
--- a/script/library_report.rb
+++ b/script/library_report.rb
@@ -1,3 +1,21 @@
+# Also show the report on the terminal, without losing the log record:
+# broadcast Rails.logger to $stdout (in addition to the environment's
+# log file), so each report line is written to both places, once, with
+# its original severity. The terminal sink is filtered to INFO and
+# above so development's DEBUG-level SQL noise stays only in the log.
+unless Rails.logger.respond_to?(:broadcasts) &&
+       Rails.logger.broadcasts.any? { |logger| logger.instance_variable_get(:@logdev)&.dev == $stdout }
+  terminal_logger = ActiveSupport::Logger.new($stdout)
+  terminal_logger.level = [ Rails.logger.level || Logger::DEBUG, Logger::INFO ].max
+  terminal_logger.formatter = ActiveSupport::Logger::SimpleFormatter.new
+
+  if Rails.logger.respond_to?(:broadcast_to)
+    Rails.logger.broadcast_to(terminal_logger)
+  else
+    Rails.logger = ActiveSupport::BroadcastLogger.new(Rails.logger, terminal_logger)
+  end
+end
+
 books = Book.order(:id).to_a
 
 Rails.logger.info "Library report: #{books.size} books"
