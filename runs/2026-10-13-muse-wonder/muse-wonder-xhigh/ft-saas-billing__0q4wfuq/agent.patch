@@ -0,0 +1,37 @@
+<% @page_title = "Billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Billing</h2>
+      </header>
+
+      <p>
+        Plan: <strong><%= @account.billing_plan.name %></strong>
+        <% if @account.billing_plan.price_cents.positive? %>
+          (<%= number_to_currency(@account.billing_plan.price) %>/month)
+        <% end %>
+      </p>
+
+      <p>
+        Free &mdash; 1,000 cards, 1 GB storage
