+require "test_helper"
+
+class Account::PaidStorageTest < ActiveSupport::TestCase
+  test "unlimited plan allows more than free storage" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited", stripe_customer_id: "cus_storage", stripe_subscription_id: "sub_storage", status: "active")
