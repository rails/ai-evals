@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can list accounts and open an account page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a", text: accounts(:initech).name
+
+      get saas.admin_account_path(accounts(:initech))
+      assert_response :success
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "button", text: "Override"
+      assert_select "button", text: "Reset"
+    end
+  end
+
+  test "non-staff cannot list accounts" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+    assert_response :forbidden
+  end
+
+  test "comp and uncomp an account" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.comp_admin_account_path(account)
+    end
+    assert_response :redirect
+    assert account.reload.comped?
+
+    untenanted do
+      post saas.uncomp_admin_account_path(account)
+    end
+    assert_response :redirect
+    assert_not account.reload.comped?
+  end
+
+  test "override and reset usage" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.override_admin_account_path(account), params: { overridden_limit: { card_count: 1000, bytes_used: 12345 } }
+    end
+    assert_response :redirect
+    assert_equal 1000, account.reload.card_count
+    assert_equal 12345, account.reload.bytes_used
+
+    untenanted do
+      delete saas.reset_admin_account_path(account)
+    end
+    assert_response :redirect
+    assert_nil account.reload.overridden_limit
+  end
+end
