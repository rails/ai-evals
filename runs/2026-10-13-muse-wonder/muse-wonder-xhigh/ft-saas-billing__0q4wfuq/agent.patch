@@ -0,0 +1,31 @@
+class Admin::Accounts::OverriddenLimitsController < AdminController
+  layout "public"
+
+  before_action :set_account
+
+  def create
+    update_override
+  end
+
+  def update
+    update_override
+  end
+
+  def destroy
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account), notice: "Override reset for #{@account.name}."
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:account_id]) || Account.find_by!(external_account_id: params[:account_id])
+    end
+
+    def update_override
+      source = params[:overridden_limit].presence || params[:override].presence || params[:account].presence || params
+      source = source.to_unsafe_h if source.respond_to?(:to_unsafe_h)
+      source = source.with_indifferent_access if source.is_a?(Hash)
+      @account.override_limits(card_count: source[:card_count], bytes_used: source[:bytes_used])
+      redirect_to saas.admin_account_path(@account), notice: "Limits overridden for #{@account.name}."
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
