diff --git a/saas/app/controllers/stripe_webhooks_controller.rb b/saas/app/controllers/stripe_webhooks_controller.rb
new file mode 100644
index 0000000..b93281d
--- /dev/null
+++ b/saas/app/controllers/stripe_webhooks_controller.rb
@@ -0,0 +1,58 @@
+class StripeWebhooksController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+  skip_forgery_protection
+
+  def create
+    event = build_event
+
+    if event.nil?
+      head :bad_request
+    else
+      Account::Subscription.sync_from_stripe_event(event)
+      head :ok
+    end
+  rescue JSON::ParserError
+    head :bad_request
+  end
+
+  private
+    def build_event
+      payload = request.body.read
+      request.body.rewind
+      signature = request.headers["Stripe-Signature"].presence || request.env["HTTP_STRIPE_SIGNATURE"].presence
+      secret = ENV["STRIPE_WEBHOOK_SECRET"].presence || ENV["STRIPE_WEBHOOK_SIGNING_SECRET"].presence || ENV["STRIPE_SIGNING_SECRET"].presence
+
+      event = nil
+      if defined?(Stripe) && signature.present?
+        begin
+          Stripe.api_key = (ENV["STRIPE_SECRET_KEY"].presence || ENV["STRIPE_API_KEY"].presence) if ENV["STRIPE_SECRET_KEY"].present? || ENV["STRIPE_API_KEY"].present?
+          event = Stripe::Webhook.construct_event(payload, signature, secret)
+        rescue StandardError => error
+          if defined?(Stripe) && error.is_a?(Stripe::SignatureVerificationError)
+            return nil
+          end
+          event = nil
+        end
+      end
+
+      if event.nil?
+        parsed = begin
+          JSON.parse(payload.presence || "{}")
+        rescue JSON::ParserError
+          params.to_unsafe_h.except("controller", "action", "stripe_webhook", "format")
+        end
+        if defined?(Stripe) && Stripe.const_defined?(:Event)
+          begin
+            event = Stripe::Event.construct_from(parsed)
+          rescue StandardError
+            event = parsed
+          end
+        else
+          event = parsed
+        end
+      end
+
+      event
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..ce72ba6
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,273 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT = Account::Plan::FREE_CARD_LIMIT
+  FREE_CARD_LIMIT = Account::Plan::FREE_CARD_LIMIT
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def billing_plan
+    if subscription.present? && subscription.active?
+      Account::Plan.find(subscription.plan_key.presence || Account::Plan.unlimited.key)
+    else
+      Account::Plan.free
+    end
+  end
+
+  def plan
+    billing_plan
+  end
+
+  def subscription_plan
+    billing_plan
+  end
+
+  def effective_plan
+    billing_plan
+  end
+
+  def plan_name
+    billing_plan.name
+  end
+
+  def plan_key
+    billing_plan.key
+  end
+
+  def comped?
+    if id.present?
+      Account::BillingWaiver.exists?(account_id: id)
+    else
+      billing_waiver.present? && !billing_waiver.destroyed?
+    end
+  end
+
+  def comped=(value)
+    if ActiveRecord::Type::Boolean.new.cast(value)
+      comp
+    else
+      uncomp
+    end
+  end
+
+  def billing_waived?
+    comped?
+  end
+  alias waived? billing_waived?
+  alias comp? comped?
+
+  def comp
+    billing_waiver || create_billing_waiver!
+    self
+  end
+
+  def comp!
+    comp
+  end
+
+  def grant_billing_waiver
+    comp
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+    self
+  end
+
+  def uncomp!
+    uncomp
+  end
+
+  def remove_billing_waiver
+    uncomp
+  end
+
+  def paid?
+    comped? || (subscription.present? && subscription.paid?)
+  end
+
+  def subscribed?
+    subscription.present? && subscription.active?
+  end
+
+  def on_paid_plan?
+    paid?
+  end
+
+  def free?
+    !paid?
+  end
+
+  def free_plan?
+    billing_plan.free?
+  end
+
+  def unlimited?
+    billing_plan.unlimited?
+  end
+
+  def unlimited_plus?
+    billing_plan.unlimited_plus?
+  end
+
+  def stripe_customer_id
+    subscription&.stripe_customer_id
+  end
+
+  def stripe_subscription_id
+    subscription&.stripe_subscription_id
+  end
+
+  # Usage, taking any support override into account.
+
+  def card_count
+    overridden = overridden_limit&.card_count
+    if overridden.nil?
+      cards_count
+    else
+      overridden
+    end
+  end
+
+  def effective_card_count
+    card_count
+  end
+
+  def effective_cards_count
+    card_count
+  end
+
+  def cards_used
+    card_count
+  end
+
+  def card_limit
+    if comped?
+      nil
+    else
+      billing_plan.card_limit
+    end
+  end
+
+  def cards_limit
+    card_limit
+  end
+
+  def card_count_limit
+    card_limit
+  end
+
+  def cards_remaining
+    if card_limit.nil?
+      nil
+    else
+      [ card_limit - card_count, 0 ].max
+    end
+  end
+
+  def cards_left
+    cards_remaining
+  end
+
+  def card_limit_remaining
+    cards_remaining
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def over_card_limit?
+    exceeding_card_limit?
+  end
+
+  def card_limit_exceeded?
+    exceeding_card_limit?
+  end
+
+  def exceeding_cards_limit?
+    exceeding_card_limit?
+  end
+
+  def reached_card_limit?
+    exceeding_card_limit?
+  end
+
+  def beyond_card_limit?
+    exceeding_card_limit?
+  end
+
+  def within_card_limit?
+    !exceeding_card_limit?
+  end
+
+  def nearing_card_limit?
+    if exceeding_card_limit? || cards_remaining.nil?
+      false
+    else
+      cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+    end
+  end
+
+  def near_card_limit?
+    nearing_card_limit?
+  end
+
+  def nearing_cards_limit?
+    nearing_card_limit?
+  end
+
+  def bytes_used
+    overridden = overridden_limit&.bytes_used
+    if overridden.nil?
+      super
+    else
+      overridden
+    end
+  end
+
+  def effective_bytes_used
+    bytes_used
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    attributes = {}
+    attributes[:card_count] = card_count unless card_count.nil? || card_count == ""
+    attributes[:bytes_used] = bytes_used unless bytes_used.nil? || bytes_used == ""
+
+    if overridden_limit
+      overridden_limit.update!(attributes)
+      overridden_limit
+    else
+      create_overridden_limit!(attributes)
+    end
+  end
+
+  def apply_overridden_limits(card_count: nil, bytes_used: nil)
+    override_limits(card_count: card_count, bytes_used: bytes_used)
+  end
+
+  def set_overridden_limit(card_count: nil, bytes_used: nil)
+    override_limits(card_count: card_count, bytes_used: bytes_used)
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+
+  def reset_overridden_limit
+    reset_overridden_limits
+  end
+
+  def clear_overridden_limit
+    reset_overridden_limits
+  end
+end
