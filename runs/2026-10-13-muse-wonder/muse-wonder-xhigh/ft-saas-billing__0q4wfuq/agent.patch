@@ -0,0 +1,48 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override_limits reset_override ]
+
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp
+    redirect_to saas.admin_account_path(@account), notice: "#{@account.name} is now comped."
+  end
+
+  def uncomp
+    @account.uncomp
+    redirect_to saas.admin_account_path(@account), notice: "#{@account.name} is no longer comped."
+  end
+
+  def override_limits
+    @account.override_limits(card_count: override_params[:card_count], bytes_used: override_params[:bytes_used])
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden for #{@account.name}."
+  end
+
+  def reset_override
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account), notice: "Override reset for #{@account.name}."
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:id]) || Account.find_by!(external_account_id: params[:id])
+    end
+
+    def override_params
+      source = params[:overridden_limit].presence || params[:override].presence || params[:account].presence || params
+      source = source.to_unsafe_h if source.respond_to?(:to_unsafe_h)
+      source = source.with_indifferent_access if source.is_a?(Hash)
+      result = {}
+      result[:card_count] = source[:card_count] if source.key?(:card_count) || source.key?("card_count")
+      result[:bytes_used] = source[:bytes_used] if source.key?(:bytes_used) || source.key?("bytes_used")
+      result[:card_count] = source[:cards_count] if result[:card_count].nil? && source[:cards_count].present?
+      result
+    end
+end
diff --git a/saas/app/controllers/billing_controller.rb b/saas/app/controllers/billing_controller.rb
new file mode 100644
index 0000000..3454049
--- /dev/null
+++ b/saas/app/controllers/billing_controller.rb
@@ -0,0 +1,117 @@
+class BillingController < ApplicationController
+  before_action :set_account
+
+  def show
+    @account = Current.account
+    @plan = @account.billing_plan
+  end
+
+  def checkout
+    plan = requested_plan
+    session = create_checkout_session(plan)
+    url = checkout_url_from(session)
+
+    if url.present?
+      redirect_to url, allow_other_host: true, status: :see_other
+    else
+      redirect_to account_settings_url, alert: "Could not start checkout. Please try again."
+    end
+  rescue StandardError => error
+    Rails.logger.warn "Stripe checkout failed: #{error.class}: #{error.message}"
+    redirect_to account_settings_url, alert: "Could not start checkout. Please try again."
+  end
+
+  def portal
+    session = create_portal_session
+    url = checkout_url_from(session)
+
+    if url.present?
+      redirect_to url, allow_other_host: true, status: :see_other
+    else
+      redirect_to account_settings_url, alert: "Could not open the customer portal. Please try again."
+    end
+  rescue StandardError => error
+    Rails.logger.warn "Stripe customer portal failed: #{error.class}: #{error.message}"
+    redirect_to account_settings_url, alert: "Could not open the customer portal. Please try again."
+  end
+
+  def success
+    redirect_to account_settings_url, notice: "Thank you! Your plan will be updated as soon as Stripe confirms your subscription."
+  end
+
+  def cancel
+    redirect_to account_settings_url, notice: "Checkout was cancelled."
+  end
+
+  private
+    def set_account
+      @account = Current.account
+    end
+
+    def requested_plan
+      identifier = params[:plan_key].presence || params[:plan].presence || params[:plan_id].presence || params[:price_id].presence || params[:price].presence
+      plan = Account::Plan.find(identifier.presence || "unlimited")
+      if plan.free?
+        Account::Plan.unlimited
+      else
+        plan
+      end
+    end
+
+    def create_checkout_session(plan)
+      configure_stripe
+
+      arguments = {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        success_url: account_settings_url,
+        cancel_url: account_settings_url,
+        client_reference_id: Current.account.external_account_id.to_s,
+        metadata: checkout_metadata(plan),
+        subscription_data: { metadata: checkout_metadata(plan) }
+      }
+      if Current.account.stripe_customer_id.present?
+        arguments[:customer] = Current.account.stripe_customer_id
+      elsif Current.account.respond_to?(:owner_email) && Current.account.owner_email.present?
+        arguments[:customer_email] = Current.account.owner_email
+      end
+
+      Stripe::Checkout::Session.create(arguments)
+    end
+
+    def create_portal_session
+      configure_stripe
+
+      Stripe::BillingPortal::Session.create(
+        customer: Current.account.stripe_customer_id,
+        return_url: account_settings_url
+      )
+    end
+
+    def checkout_metadata(plan)
+      {
+        account_id: Current.account.id,
+        external_account_id: Current.account.external_account_id.to_s,
+        plan_key: plan.key,
+        plan: plan.key
+      }
+    end
+
+    def configure_stripe
+      Stripe.api_key = (ENV["STRIPE_SECRET_KEY"].presence || ENV["STRIPE_API_KEY"].presence) if defined?(Stripe) && (ENV["STRIPE_SECRET_KEY"].present? || ENV["STRIPE_API_KEY"].present?)
+    end
+
+    def checkout_url_from(session)
+      if session.respond_to?(:url)
+        session.url
+      elsif session.is_a?(Hash)
+        session[:url] || session["url"]
+      elsif session.is_a?(String)
+        session
+      end
+    end
+
+    def account_settings_url
+      "#{request.base_url}#{Current.account.slug}/account/settings"
+    end
+end
