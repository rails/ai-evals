diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..7a41192
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  test "cannot publish cards when card limit reached" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "can still draft cards when card limit reached" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug)
+    end
+    assert_response :redirect
+  end
+
+  test "cannot create cards via JSON when card limit reached" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Blocked card" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "draft card shows upgrade pitch instead of create buttons when card limit reached" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+  end
+
+  test "draft card shows cards left warning within 100 cards of limit" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 950)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_match "50 cards left", response.body
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+end
diff --git a/saas/test/controllers/stripe_webhooks_controller_test.rb b/saas/test/controllers/stripe_webhooks_controller_test.rb
new file mode 100644
index 0000000..ebb121b
--- /dev/null
+++ b/saas/test/controllers/stripe_webhooks_controller_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "subscription created webhook puts account on unlimited plan" do
+    account = accounts(:initech)
+    payload = {
+      type: "customer.subscription.created",
+      data: {
+        object: {
+          id: "sub_123",
+          object: "subscription",
+          customer: "cus_123",
+          status: "active",
+          current_period_end: 1893456000,
+          metadata: { account_id: account.id, plan_key: "unlimited" },
+          items: { data: [ { price: { id: "price_unlimited" } } ] }
+        }
+      }
+    }
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, as: :json
+    end
+
+    assert_response :success
+    account.reload
+    assert_equal "unlimited", account.subscription.plan_key
+    assert_equal "cus_123", account.subscription.stripe_customer_id
+    assert account.paid?
+    assert_equal 5.gigabytes, account.storage_limit
+  end
+
+  test "subscription deleted webhook returns account to free plan" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited", stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", status: "active")
+
+    payload = {
+      type: "customer.subscription.deleted",
+      data: {
+        object: {
+          id: "sub_123",
+          object: "subscription",
+          customer: "cus_123",
+          status: "canceled",
+          items: { data: [ { price: { id: "price_unlimited" } } ] }
+        }
+      }
+    }
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, as: :json
+    end
+
+    assert_response :success
+    assert_equal "Free", account.reload.billing_plan.name
+    assert_not account.paid?
+  end
+
+  test "checkout completed webhook can identify account by client reference" do
+    account = accounts(:initech)
+    payload = {
+      type: "checkout.session.completed",
+      data: {
+        object: {
+          id: "cs_123",
+          object: "checkout.session",
+          customer: "cus_999",
+          subscription: "sub_999",
+          client_reference_id: account.external_account_id.to_s,
+          metadata: { plan_key: "unlimited_plus" }
+        }
+      }
+    }
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, as: :json
+    end
+
+    assert_response :success
+    assert_equal "Unlimited+", account.reload.billing_plan.name
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..460de64
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  test "free plan has 1000 card and 1 GB storage limits" do
+    account = accounts(:initech)
+
+    assert_equal "Free", account.billing_plan.name
+    assert_equal 1_000, account.card_limit
+    assert_equal 1.gigabyte, account.storage_limit
+    assert_equal 0, account.billing_plan.price
+  end
+
+  test "unlimited plan costs 20 dollars with 5 GB and no card limit" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited", stripe_customer_id: "cus_unlimited", stripe_subscription_id: "sub_unlimited", status: "active")
+
+    assert_equal "Unlimited", account.billing_plan.name
+    assert_equal 20, account.billing_plan.price
+    assert_nil account.card_limit
+    assert_equal 5.gigabytes, account.storage_limit
+    assert account.paid?
+  end
+
+  test "unlimited plus plan costs 25 dollars with 500 GB" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited_plus", stripe_customer_id: "cus_plus", stripe_subscription_id: "sub_plus", status: "active")
+
+    assert_equal "Unlimited+", account.billing_plan.name
+    assert_equal 25, account.billing_plan.price
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+
+  test "card limit is reached at 1000 cards and warning starts 100 out" do
+    account = accounts(:initech)
+    account.update_column(:cards_count, 899)
+    assert_not account.nearing_card_limit?
+
+    account.update_column(:cards_count, 950)
+    assert account.nearing_card_limit?
+    assert_equal 50, account.cards_remaining
+
+    account.update_column(:cards_count, 1_000)
+    assert account.exceeding_card_limit?
+  end
+
+  test "comped account has no card limit" do
+    account = accounts(:initech)
+    account.update_column(:cards_count, 1_000)
+    account.comp
+
+    assert account.comped?
+    assert_not account.exceeding_card_limit?
+
+    account.uncomp
+    assert_not account.comped?
+    assert account.exceeding_card_limit?
+  end
+
+  test "overridden limit replaces usage for limit calculations and reset drops it" do
+    account = accounts(:initech)
+    account.override_limits(card_count: 1_000, bytes_used: 2.gigabytes)
+
+    assert_equal 1_000, account.card_count
+    assert_equal 2.gigabytes, account.bytes_used
+    assert account.exceeding_card_limit?
+    assert account.exceeding_storage_limit?
+
+    account.reset_overridden_limits
+
+    assert_nil account.overridden_limit
+    assert_not account.exceeding_card_limit?
+  end
+end
