@@ -0,0 +1,78 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start"><%= @account.name %></h2>
+    </header>
+
+    <div class="flex flex-column gap margin-block-half">
+      <div>
+        <div class="txt-x-small">External account ID</div>
+        <div>#<%= @account.external_account_id %></div>
+      </div>
+
+      <% if @account.respond_to?(:billing_plan) %>
+        <div>
+          <div class="txt-x-small">Plan</div>
+          <div>
+            <strong><%= @account.billing_plan.name %></strong>
+            <% if @account.comped? %>
+              (Comped)
+            <% end %>
+          </div>
+        </div>
+
+        <div>
+          <div class="txt-x-small">Cards</div>
+          <div>
+            <%= number_with_delimiter(@account.card_count) %>
+            <% if @account.card_limit %>
+              of <%= number_with_delimiter(@account.card_limit) %> cards
+              (<%= pluralize(@account.cards_remaining, "card") %> left)
+            <% else %>
+              cards (unlimited)
+            <% end %>
+          </div>
+        </div>
+
+        <div>
+          <div class="txt-x-small">Storage</div>
+          <div>
+            <%= number_to_human_size(@account.bytes_used) %>
+            of <%= number_to_human_size(@account.storage_limit) %>
+          </div>
+        </div>
+      <% end %>
+
+      <div class="flex gap-half">
+        <%= button_to "Comp", saas.comp_admin_account_path(@account), method: :post, class: "btn" %>
+        <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), method: :post, class: "btn" %>
+      </div>
+
+      <div>
+        <h3 class="txt-medium">Override usage</h3>
+
+        <%= form_with scope: :overridden_limit, url: saas.override_admin_account_path(@account), method: :post, class: "flex flex-column gap-half" do |form| %>
+          <div>
+            <%= form.label :card_count, "Card count" %>
+            <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input" %>
+          </div>
+
+          <div>
+            <%= form.label :bytes_used, "Bytes used" %>
+            <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input" %>
+          </div>
+
+          <%= form.button "Override", type: :submit, class: "btn" %>
+        <% end %>
+
+        <%= button_to "Reset", saas.reset_admin_account_path(@account), method: :delete, class: "btn" %>
+      </div>
+    </div>
+  </div>
+</section>
