+  test "unlimited plus plan allows 500 GB" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited_plus", stripe_customer_id: "cus_storage_plus", stripe_subscription_id: "sub_storage_plus", status: "active")
