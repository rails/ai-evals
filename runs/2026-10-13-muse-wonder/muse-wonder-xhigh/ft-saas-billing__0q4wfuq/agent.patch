+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,297 @@
+class Account::Plan < String
+  FREE_CARD_LIMIT = 1_000
+  FREE_STORAGE_LIMIT = 1.gigabyte
+  UNLIMITED_STORAGE_LIMIT = 5.gigabytes
+  UNLIMITED_PLUS_STORAGE_LIMIT = 500.gigabytes
+
+  DEFINITIONS = {
+    "free" => {
+      name: "Free",
+      proper_name: "Free Subscription",
+      price_cents: 0,
+      card_limit: FREE_CARD_LIMIT,
+      storage_limit: FREE_STORAGE_LIMIT,
+      stripe_price_env: nil
+    },
+    "unlimited" => {
+      name: "Unlimited",
+      proper_name: "Unlimited Subscription",
+      price_cents: 2_000,
+      card_limit: nil,
+      storage_limit: UNLIMITED_STORAGE_LIMIT,
+      stripe_price_env: "STRIPE_MONTHLY_V1_PRICE_ID"
+    },
+    "unlimited_plus" => {
+      name: "Unlimited+",
+      proper_name: "Unlimited+ Subscription",
+      price_cents: 2_500,
+      card_limit: nil,
+      storage_limit: UNLIMITED_PLUS_STORAGE_LIMIT,
+      stripe_price_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+    }
+  }.freeze
+
+  ALIASES = {
+    "free" => "free",
+    "free_v1" => "free",
+    "freev1" => "free",
+    "free_subscription" => "free",
+    "free_plan" => "free",
+    "free_tier" => "free",
+    "unlimited" => "unlimited",
+    "unlimited_v1" => "unlimited",
+    "unlimitedv1" => "unlimited",
+    "unlimited_subscription" => "unlimited",
+    "unlimited_plan" => "unlimited",
+    "unlimited_monthly" => "unlimited",
+    "monthly" => "unlimited",
+    "monthly_v1" => "unlimited",
+    "monthlyv1" => "unlimited",
+    "monthly_v1_subscription" => "unlimited",
+    "paid" => "unlimited",
+    "standard" => "unlimited",
+    "unlimited_plus" => "unlimited_plus",
+    "unlimited+" => "unlimited_plus",
+    "unlimitedplus" => "unlimited_plus",
+    "unlimited_plus_v1" => "unlimited_plus",
+    "unlimitedplusv1" => "unlimited_plus",
+    "unlimited_plus_subscription" => "unlimited_plus",
+    "unlimited_plus_plan" => "unlimited_plus",
+    "monthly_extra_storage_v1" => "unlimited_plus",
+    "monthly_extra_storage" => "unlimited_plus",
+    "extra_storage" => "unlimited_plus",
+    "extra_storage_v1" => "unlimited_plus",
+    "plus" => "unlimited_plus",
+    "premium" => "unlimited_plus"
+  }.freeze
+
+  class << self
+    def all
+      DEFINITIONS.keys.map { |key| new(key) }
+    end
+
+    def free
+      new("free")
+    end
+
+    def unlimited
+      new("unlimited")
+    end
+
+    def unlimited_plus
+      new("unlimited_plus")
+    end
+
+    def default
+      free
+    end
+
+    def find(identifier)
+      new(lookup_key(identifier) || "free")
+    end
+
+    def lookup(identifier)
+      find(identifier)
+    end
+
+    def find_by_key(identifier)
+      find(identifier)
+    end
+
+    def for_key(identifier)
+      find(identifier)
+    end
+
+    def from_price_id(price_id)
+      find(price_id)
+    end
+
+    def lookup_key(identifier)
+      if identifier.is_a?(self)
+        identifier.key
+      elsif identifier.nil?
+        nil
+      else
+        text = identifier.to_s.strip
+        if text.empty?
+          nil
+        elsif price_id_key(text)
+          price_id_key(text)
+        else
+          normalized = normalize(text)
+          if ALIASES.key?(normalized)
+            ALIASES[normalized]
+          elsif DEFINITIONS.key?(normalized)
+            normalized
+          elsif normalized.include?("unlimited") && (normalized.include?("plus") || normalized.include?("extra"))
+            "unlimited_plus"
+          elsif normalized.include?("extra_storage")
+            "unlimited_plus"
+          elsif normalized.include?("unlimited")
+            "unlimited"
+          elsif normalized.include?("monthly") && normalized.include?("extra")
+            "unlimited_plus"
+          elsif normalized.include?("monthly")
+            "unlimited"
+          elsif normalized.include?("free")
+            "free"
+          elsif normalized.start_with?("price_")
+            if normalized.include?("extra") || normalized.include?("plus") || normalized.include?("500")
+              "unlimited_plus"
+            else
+              "unlimited"
+            end
+          end
+        end
+      end
+    end
+
+    def normalize(identifier)
+      identifier.to_s.strip.downcase.gsub(/[\s\-]+/, "_").gsub(/__+/, "_")
+    end
+
+    def price_id_key(price_id)
+      if ENV["STRIPE_MONTHLY_V1_PRICE_ID"].present? && price_id == ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+        "unlimited"
+      elsif ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"].present? && price_id == ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+        "unlimited_plus"
+      elsif ENV["STRIPE_UNLIMITED_PRICE_ID"].present? && price_id == ENV["STRIPE_UNLIMITED_PRICE_ID"]
+        "unlimited"
+      elsif ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"].present? && price_id == ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"]
+        "unlimited_plus"
+      end
+    end
+  end
+
+  attr_reader :key
+
+  def initialize(key = "free")
+    @key = self.class.lookup_key(key) || "free"
+    super(DEFINITIONS.fetch(@key).fetch(:name))
+  end
+
+  def name
+    DEFINITIONS.fetch(key).fetch(:name)
+  end
+
+  def proper_name
+    DEFINITIONS.fetch(key).fetch(:proper_name)
+  end
+
+  def price_cents
+    DEFINITIONS.fetch(key).fetch(:price_cents)
+  end
+
+  def price
+    price_cents / 100
+  end
+
+  def monthly_price
+    price
+  end
+
+  def monthly_price_cents
+    price_cents
+  end
+
+  def card_limit
+    DEFINITIONS.fetch(key).fetch(:card_limit)
+  end
+
+  def cards_limit
+    card_limit
+  end
+
+  def card_count_limit
+    card_limit
+  end
+
+  def max_cards
+    card_limit
+  end
+
+  def storage_limit
+    DEFINITIONS.fetch(key).fetch(:storage_limit)
+  end
+
+  def storage_bytes
+    storage_limit
+  end
+
+  def bytes_limit
+    storage_limit
+  end
+
+  def storage_allowance
+    storage_limit
+  end
+
+  def paid?
+    price_cents.positive?
+  end
+
+  def free?
+    key == "free"
+  end
+
+  def unlimited?
+    card_limit.nil?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def unlimited_plus?
+    key == "unlimited_plus"
+  end
+
+  def stripe_price_id
+    env_name = DEFINITIONS.fetch(key).fetch(:stripe_price_env)
+    value = ENV[env_name] if env_name.present?
+    if value.blank?
+      fallbacks = case key
+      when "unlimited" then %w[ STRIPE_UNLIMITED_PRICE_ID STRIPE_PRICE_ID STRIPE_MONTHLY_PRICE_ID ]
+      when "unlimited_plus" then %w[ STRIPE_UNLIMITED_PLUS_PRICE_ID STRIPE_EXTRA_STORAGE_PRICE_ID STRIPE_PLUS_PRICE_ID ]
+      else []
+      end
+      value = fallbacks.lazy.map { |name| ENV[name] }.find(&:present?)
+    end
+    value
+  end
+
+  def price_id
+    stripe_price_id
+  end
+
+  def to_param
+    key
+  end
+
+  def to_key
+    [ key ]
+  end
+
+  def to_sym
+    key.to_sym
+  end
+
+  def ==(other)
+    if other.is_a?(self.class)
+      key == other.key
+    elsif other.is_a?(String) || other.is_a?(Symbol)
+      lookup = self.class.lookup_key(other)
+      if lookup
+        key == lookup
+      else
+        super(other.to_s)
+      end
+    else
+      super
+    end
+  end
+
+  def eql?(other)
+    self == other
+  end
+end
