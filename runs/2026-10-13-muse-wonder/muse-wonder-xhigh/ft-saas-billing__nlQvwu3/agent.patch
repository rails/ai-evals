new file mode 100644
index 0000000..fa4d33b
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,194 @@
+class Account::Plan < String
+  Definition = Struct.new(:key, :name, :price_cents, :card_limit, :storage_limit, keyword_init: true)
+
+  DEFINITIONS = {
+    "free" => Definition.new(key: "free", name: "Free", price_cents: 0, card_limit: 1_000, storage_limit: 1.gigabyte),
+    "unlimited" => Definition.new(key: "unlimited", name: "Unlimited", price_cents: 2_000, card_limit: nil, storage_limit: 5.gigabytes),
+    "unlimited_plus" => Definition.new(key: "unlimited_plus", name: "Unlimited+", price_cents: 2_500, card_limit: nil, storage_limit: 500.gigabytes)
+  }.freeze
+
+  ALIASES = {
+    "free" => "free",
+    "free_v1" => "free",
+    "freev1" => "free",
+    "free_plan" => "free",
+    "monthly" => "unlimited",
+    "monthly_v1" => "unlimited",
+    "monthlyv1" => "unlimited",
+    "unlimited" => "unlimited",
+    "unlimited_v1" => "unlimited",
+    "monthly_extra_storage" => "unlimited_plus",
+    "monthly_extra_storage_v1" => "unlimited_plus",
+    "monthly_with_extra_storage" => "unlimited_plus",
+    "monthly_with_extra_storage_v1" => "unlimited_plus",
+    "extra_storage" => "unlimited_plus",
+    "extra_storage_v1" => "unlimited_plus",
+    "unlimited_plus" => "unlimited_plus",
+    "unlimited+" => "unlimited_plus",
+    "unlimitedplus" => "unlimited_plus",
+    "plus" => "unlimited_plus",
+    "paid" => "unlimited",
+    "pro" => "unlimited",
+    "standard" => "unlimited",
+    "premium" => "unlimited_plus",
+    "unlimited_plus_plan" => "unlimited_plus"
+  }.freeze
+
+  class << self
+    def all
+      DEFINITIONS.keys.map { |key| new(key) }
+    end
+
+    def free
+      new("free")
+    end
+
+    def unlimited
+      new("unlimited")
+    end
+
+    def unlimited_plus
+      new("unlimited_plus")
+    end
+
+    def for_key(key)
+      new(key)
+    end
+
+    def for(plan_or_key)
+      plan_or_key.is_a?(self) ? plan_or_key : new(plan_or_key)
+    end
+
+    def normalize_key(key)
+      normalized = key.to_s.strip.downcase.tr("-", "_").tr(" ", "_")
+      ALIASES[normalized] || ALIASES[normalized.delete("_")] || (DEFINITIONS.key?(normalized) ? normalized : nil)
+    end
+
+    def for_stripe_price_id(price_id, unit_amount: nil)
+      if price_id.present?
+        DEFINITIONS.each_value do |definition|
+          plan = new(definition.key)
+          return plan if plan.stripe_price_id.present? && plan.stripe_price_id == price_id.to_s
+        end
+
+        normalized = price_id.to_s.downcase
+        if normalized.include?("extra") || normalized.include?("plus") || normalized.include?("+") || normalized.include?("500")
+          return unlimited_plus
+        elsif normalized.include?("unlimited") || normalized.include?("monthly")
+          return unlimited
+        elsif normalized.include?("free")
+          return free
+        end
+      end
+
+      case unit_amount.to_i
+      when 2_500 then unlimited_plus
+      when 2_000 then unlimited
+      when 0 then nil
+      end
+    end
+  end
+
+  attr_reader :key
+
+  def initialize(key = "free")
+    @key = self.class.normalize_key(key) || "free"
+    super(definition.name)
+  end
+
+  def definition
+    DEFINITIONS.fetch(key)
+  end
+
+  def name
+    definition.name
+  end
+
+  def price
+    price_cents / 100
+  end
+  alias_method :monthly_price, :price
+
+  def price_cents
+    definition.price_cents
+  end
+  alias_method :monthly_price_cents, :price_cents
+
+  def card_limit
+    definition.card_limit
+  end
+  alias_method :cards_limit, :card_limit
+  alias_method :maximum_cards, :card_limit
+
+  def storage_limit
+    definition.storage_limit
+  end
+  alias_method :storage_bytes, :storage_limit
+  alias_method :bytes_limit, :storage_limit
+
+  def stripe_price_id
+    case key
+    when "unlimited"
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"].presence ||
+        ENV["STRIPE_UNLIMITED_PRICE_ID"].presence ||
+        ENV["STRIPE_UNLIMITED_PRICE"].presence ||
+        ENV["STRIPE_PRICE_UNLIMITED"].presence ||
+        ENV["STRIPE_MONTHLY_PRICE_ID"].presence ||
+        ENV["STRIPE_PRICE_ID"].presence
+    when "unlimited_plus"
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"].presence ||
+        ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"].presence ||
+        ENV["STRIPE_UNLIMITED_PLUS_PRICE"].presence ||
+        ENV["STRIPE_EXTRA_STORAGE_PRICE_ID"].presence ||
+        ENV["STRIPE_PRICE_UNLIMITED_PLUS"].presence ||
+        ENV["STRIPE_MONTHLY_EXTRA_STORAGE_PRICE_ID"].presence
+    end
+  end
+  alias_method :stripe_price, :stripe_price_id
+
+  def free?
+    key == "free"
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited?
+    key == "unlimited"
+  end
+
+  def unlimited_plus?
+    key == "unlimited_plus"
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def to_s
+    name
+  end
+
+  def to_sym
+    key.to_sym
+  end
+
+  def ==(other)
+    case other
+    when Account::Plan
+      key == other.key
+    when Symbol
+      key == self.class.normalize_key(other) || key == other.to_s
+    when String
+      super(other) || key == self.class.normalize_key(other)
+    else
+      super
+    end
+  end
+  alias_method :eql?, :==
+
+  def hash
+    key.hash
+  end
+end
