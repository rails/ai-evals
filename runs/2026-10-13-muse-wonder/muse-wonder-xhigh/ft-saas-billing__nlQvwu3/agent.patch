diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..ecc6b65
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,264 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  ACTIVE_STATUSES = %w[ active trialing past_due paid current subscribed live ].freeze
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+  scope :chronologically, -> { order(created_at: :asc) }
+
+  before_validation :normalize_plan_key
+
+  class << self
+    def sync_from_stripe(stripe_object, account_hint: nil)
+      object = deep_stringify(stripe_object)
+      return nil unless object.is_a?(Hash)
+
+      account = account_hint || find_account_for(object)
+      return nil unless account
+
+      subscription_id = extract_subscription_id(object)
+      customer_id = value(object, "customer")
+      customer_id = customer_id["id"] if customer_id.is_a?(Hash)
+
+      subscription = nil
+      if subscription_id.present?
+        subscription = find_by(stripe_subscription_id: subscription_id.to_s)
+      end
+      subscription ||= find_by(stripe_customer_id: customer_id.to_s) if customer_id.present?
+      subscription ||= account.subscriptions.build
+
+      subscription.account = account
+      subscription.stripe_subscription_id = subscription_id.to_s if subscription_id.present?
+      subscription.stripe_customer_id = customer_id.to_s if customer_id.present?
+
+      if (plan = plan_for(object))
+        subscription.plan_key = plan.key
+      elsif subscription.plan_key.blank?
+        subscription.plan_key = "unlimited"
+      end
+
+      if (status = value(object, "status").presence)
+        subscription.status = status.to_s
+      elsif subscription.status.blank?
+        subscription.status = "active"
+      end
+
+      if (period_end = timestamp_for(object, "current_period_end"))
+        subscription.current_period_end = period_end
+      end
+      if (cancel_at = timestamp_for(object, "cancel_at"))
+        subscription.cancel_at = cancel_at
+      end
+      if (amount = amount_due_for(object))
+        subscription.next_amount_due_in_cents = amount
+      end
+
+      subscription.save!
+      subscription
+    end
+
+    def find_account_for(object)
+      candidates = []
+
+      metadata = value(object, "metadata")
+      if metadata.is_a?(Hash)
+        candidates << value(metadata, "account_id")
+        candidates << value(metadata, "external_account_id")
+        candidates << value(metadata, "account_external_id")
+        candidates << value(metadata, "queenbee_id")
+      end
+      candidates << value(object, "client_reference_id")
+      candidates << value(object, "account_id")
+      candidates << value(object, "external_account_id")
+
+      candidates.compact_blank.each do |candidate|
+        if (account = Account.find_by(id: candidate.to_s))
+          return account
+        end
+        if candidate.to_s.match?(/\A\d+\z/) && (account = Account.find_by(external_account_id: candidate.to_i))
+          return account
+        end
+      end
+
+      if (subscription_id = extract_subscription_id(object)) && (existing = find_by(stripe_subscription_id: subscription_id.to_s))
+        return existing.account
+      end
+
+      customer_id = value(object, "customer")
+      customer_id = customer_id["id"] if customer_id.is_a?(Hash)
+      if customer_id.present? && (existing = find_by(stripe_customer_id: customer_id.to_s))
+        return existing.account
+      end
+
+      nil
+    end
+
+    def plan_for(object)
+      metadata = value(object, "metadata")
+      if metadata.is_a?(Hash)
+        %w[ plan_key plan plan_id billing_plan ].each do |key|
+          if (plan_key = Account::Plan.normalize_key(value(metadata, key)))
+            return Account::Plan.new(plan_key)
+          end
+        end
+      end
+
+      %w[ plan_key plan_id ].each do |key|
+        if (plan_key = Account::Plan.normalize_key(value(object, key)))
+          return Account::Plan.new(plan_key)
+        end
+      end
+
+      if (plan_value = value(object, "plan"))
+        if plan_value.is_a?(Hash)
+          if (plan = Account::Plan.for_stripe_price_id(value(plan_value, "id"), unit_amount: value(plan_value, "amount") || value(plan_value, "unit_amount")))
+            return plan
+          end
+        elsif (plan_key = Account::Plan.normalize_key(plan_value))
+          return Account::Plan.new(plan_key)
+        end
+      end
+
+      price = first_price(object)
+      if price.is_a?(Hash)
+        if (plan_key = Account::Plan.normalize_key(value(price, "lookup_key") || value(price, "nickname")))
+          return Account::Plan.new(plan_key)
+        end
+        if (plan = Account::Plan.for_stripe_price_id(value(price, "id"), unit_amount: value(price, "unit_amount")))
+          return plan
+        end
+      elsif price.present?
+        if (plan = Account::Plan.for_stripe_price_id(price))
+          return plan
+        end
+      end
+
+      nil
+    end
+
+    def first_price(object)
+      items = value(object, "items")
+      items = value(items, "data") if items.is_a?(Hash)
+      if items.is_a?(Array) && items.first.is_a?(Hash)
+        price = value(items.first, "price") || value(items.first, "plan")
+        return price if price.present?
+        if (period_end = value(items.first, "current_period_end"))
+          # keep price search below, but period end handled separately
+        end
+      end
+
+      line_items = value(object, "line_items") || value(object, "lines")
+      line_items = value(line_items, "data") if line_items.is_a?(Hash)
+      if line_items.is_a?(Array) && line_items.first.is_a?(Hash)
+        price = value(line_items.first, "price") || value(line_items.first, "plan")
+        return price if price.present?
+      end
+
+      value(object, "price") || value(object, "price_id")
+    end
+
+    def extract_subscription_id(object)
+      subscription = value(object, "subscription")
+      subscription = value(subscription, "id") if subscription.is_a?(Hash)
+      subscription ||= value(object, "stripe_subscription_id")
+      if subscription.blank? && value(object, "object") == "subscription"
+        subscription = value(object, "id")
+      end
+      # Subscription objects themselves have an id and object=subscription;
+      # checkout sessions have object=checkout.session, handled above.
+      subscription
+    end
+
+    def timestamp_for(object, key)
+      raw = value(object, key)
+      if raw.blank?
+        items = value(object, "items")
+        items = value(items, "data") if items.is_a?(Hash)
+        raw = value(items.first, key) if items.is_a?(Array) && items.first.is_a?(Hash)
+      end
+      parse_timestamp(raw)
+    end
+
+    def amount_due_for(object)
+      price = first_price(object)
+      if price.is_a?(Hash)
+        amount = value(price, "unit_amount") || value(price, "amount")
+        return amount.to_i if amount.present?
+      end
+      amount = value(object, "amount_due") || value(object, "next_amount_due_in_cents")
+      amount.present? ? amount.to_i : nil
+    end
+
+    def parse_timestamp(raw)
+      case raw
+      when Time, DateTime, Date
+        raw.to_time
+      when Numeric
+        Time.at(raw.to_i).utc
+      when String
+        Time.zone.parse(raw) rescue nil
+      end
+    end
+
+    def value(object, key)
+      return nil unless object
+      if object.is_a?(Hash)
+        object[key] || object[key.to_sym]
+      elsif object.respond_to?(key)
+        object.public_send(key)
+      elsif object.respond_to?(:[])
+        object[key]
+      end
+    rescue
+      nil
+    end
+
+    def deep_stringify(object)
+      case object
+      when Hash
+        object.each_with_object({}) { |(k, v), result| result[k.to_s] = deep_stringify(v) }
+      when Array
+        object.map { |item| deep_stringify(item) }
+      else
+        if object.respond_to?(:to_hash)
+          deep_stringify(object.to_hash)
+        elsif defined?(Stripe::StripeObject) && object.is_a?(Stripe::StripeObject)
+          deep_stringify(object.to_h)
+        else
+          object
+        end
+      end
+    end
+  end
+
+  def plan
+    Account::Plan.new(plan_key.presence || "free")
+  end
+
+  def plan=(plan_or_key)
+    self.plan_key = plan_or_key.is_a?(Account::Plan) ? plan_or_key.key : Account::Plan.normalize_key(plan_or_key) || plan_or_key.to_s
+  end
+
+  def active?
+    status.to_s.in?(ACTIVE_STATUSES)
+  end
+
+  def canceled?
+    status.to_s.in?(%w[ canceled cancelled incomplete_expired unpaid ])
+  end
+  alias_method :cancelled?, :canceled?
+
+  def free?
+    plan.free?
+  end
+
+  def paid?
+    !free?
+  end
+
+  private
+    def normalize_plan_key
+      self.plan_key = Account::Plan.normalize_key(plan_key) || plan_key.presence || "unlimited"
+      self.status = status.presence || "active" if respond_to?(:status)
+    end
+end
