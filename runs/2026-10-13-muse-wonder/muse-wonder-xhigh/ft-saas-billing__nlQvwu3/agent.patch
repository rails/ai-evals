@@ -0,0 +1,53 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override reset_overridden_limit ]
+
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.billing_waiver || @account.create_billing_waiver!
+    redirect_to saas.admin_account_path(@account)
+  end
+
+  def uncomp
+    @account.billing_waiver&.destroy!
+    redirect_to saas.admin_account_path(@account)
+  end
+
+  def override
+    record = @account.overridden_limit || @account.build_overridden_limit
+    record.update!(overridden_limit_params)
+    redirect_to saas.admin_account_path(@account)
+  end
+  alias_method :override_limits, :override
+
+  def reset_overridden_limit
+    @account.overridden_limit&.destroy!
+    redirect_to saas.admin_account_path(@account)
+  end
+  alias_method :reset, :reset_overridden_limit
+
+  private
+    def set_account
+      @account = Account.find(params[:id] || params[:account_id])
+    end
+
+    def overridden_limit_params
+      source = params[:overridden_limit] || params[:account_overridden_limit] || params[:override] || params
+      source = source.to_unsafe_h if source.respond_to?(:to_unsafe_h)
+      source = source.with_indifferent_access
+
+      {}.tap do |attributes|
+        attributes[:card_count] = source[:card_count].presence if source.key?(:card_count) || source.key?("card_count")
+        attributes[:bytes_used] = source[:bytes_used].presence if source.key?(:bytes_used) || source.key?("bytes_used")
+        attributes[:card_count] = attributes[:card_count].to_i if attributes[:card_count].present?
+        attributes[:bytes_used] = attributes[:bytes_used].to_i if attributes[:bytes_used].present?
+      end
+    end
+end
