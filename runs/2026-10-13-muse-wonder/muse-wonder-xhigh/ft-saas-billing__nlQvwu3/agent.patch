diff --git a/saas/app/controllers/account/billing_controller.rb b/saas/app/controllers/account/billing_controller.rb
new file mode 100644
index 0000000..9fb82f8
--- /dev/null
+++ b/saas/app/controllers/account/billing_controller.rb
@@ -0,0 +1,132 @@
+class Account::BillingController < ApplicationController
+  before_action :set_account
+  before_action :ensure_admin
+
+  def show
+    @plan = @account.billing_plan
+    @plans = Account::Plan.all
+  end
+
+  def checkout
+    plan = requested_plan
+    session = create_checkout_session(plan)
+
+    if (url = checkout_url(session))
+      redirect_to url, allow_other_host: true, status: :see_other
+    else
+      redirect_to billing_return_path, alert: "Unable to start checkout"
+    end
+  rescue => error
+    Rails.logger.error("[Billing] Checkout failed: #{error.class}: #{error.message}")
+    redirect_to billing_return_path, alert: "Unable to start checkout"
+  end
+
+  def portal
+    customer_id = @account.active_subscription&.stripe_customer_id || @account.subscription&.stripe_customer_id
+
+    if customer_id.blank?
+      redirect_to billing_return_path, alert: "No billing account found"
+      return
+    end
+
+    session = create_portal_session(customer_id)
+
+    if (url = checkout_url(session))
+      redirect_to url, allow_other_host: true, status: :see_other
+    else
+      redirect_to billing_return_path, alert: "Unable to open billing portal"
+    end
+  rescue => error
+    Rails.logger.error("[Billing] Portal failed: #{error.class}: #{error.message}")
+    redirect_to billing_return_path, alert: "Unable to open billing portal"
+  end
+
+  private
+    def set_account
+      @account = Current.account
+    end
+
+    def requested_plan
+      nested = params[:checkout] || params[:billing] || params[:subscription] || {}
+      nested = nested.to_unsafe_h.with_indifferent_access if nested.respond_to?(:to_unsafe_h)
+      key = params[:plan_key].presence || params[:plan].presence || params[:price_id].presence || nested[:plan_key] || nested[:plan] || nested[:price_id] || "unlimited"
+      if (plan = Account::Plan.for_stripe_price_id(key.to_s))
+        plan
+      elsif (normalized = Account::Plan.normalize_key(key))
+        Account::Plan.new(normalized)
+      else
+        Account::Plan.unlimited
+      end
+    end
+
+    def create_checkout_session(plan)
+      configure_stripe
+
+      attributes = {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id || plan.key, quantity: 1 } ],
+        success_url: billing_return_url,
+        cancel_url: billing_return_url,
+        client_reference_id: @account.id,
+        metadata: {
+          account_id: @account.id,
+          external_account_id: @account.external_account_id,
+          plan_key: plan.key
+        },
+        subscription_data: {
+          metadata: {
+            account_id: @account.id,
+            external_account_id: @account.external_account_id,
+            plan_key: plan.key
+          }
+        }
+      }
+
+      if (customer_id = @account.active_subscription&.stripe_customer_id || @account.subscription&.stripe_customer_id)
+        attributes[:customer] = customer_id
+      elsif @account.owner_email.present?
+        attributes[:customer_email] = @account.owner_email
+      end
+
+      Stripe::Checkout::Session.create(attributes)
+    end
+
+    def create_portal_session(customer_id)
+      configure_stripe
+
+      Stripe::BillingPortal::Session.create({ customer: customer_id, return_url: billing_return_url })
+    end
+
+    def checkout_url(session)
+      return nil unless session
+
+      if session.is_a?(Hash)
+        session[:url] || session["url"]
+      elsif session.respond_to?(:url)
+        session.url
+      elsif session.respond_to?(:[])
+        begin
+          session[:url]
+        rescue
+          nil
+        end
+      end
+    end
+
+    def configure_stripe
+      key = ENV["STRIPE_SECRET_KEY"].presence || ENV["STRIPE_API_KEY"].presence || (Rails.application.credentials.dig(:stripe, :secret_key) rescue nil)
+      Stripe.api_key = key if key.present?
+    end
+
+    def billing_return_url
+      main_app.account_settings_url
+    rescue
+      "#{request.base_url}#{Current.account&.slug}/account/settings"
+    end
+
+    def billing_return_path
+      main_app.account_settings_path
+    rescue
+      "/account/settings"
+    end
+end
