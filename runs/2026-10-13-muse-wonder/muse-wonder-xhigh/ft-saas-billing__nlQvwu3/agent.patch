+class Admin::Accounts::OverriddenLimitsController < AdminController
+  layout "public"
+
+  before_action :set_account
+
+  def create
+    record = @account.overridden_limit || @account.build_overridden_limit
+    record.update!(overridden_limit_params)
+    redirect_to saas.admin_account_path(@account)
+  end
+  alias_method :update, :create
+
+  def destroy
+    @account.overridden_limit&.destroy!
+    redirect_to saas.admin_account_path(@account)
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:account_id])
+    end
+
+    def overridden_limit_params
+      source = params[:overridden_limit] || params[:account_overridden_limit] || params[:override] || params
+      source = source.to_unsafe_h if source.respond_to?(:to_unsafe_h)
+      source = source.with_indifferent_access
+
+      {}.tap do |attributes|
+        if source.key?(:card_count)
+          attributes[:card_count] = source[:card_count].present? ? source[:card_count].to_i : nil
+        end
+        if source.key?(:bytes_used)
+          attributes[:bytes_used] = source[:bytes_used].present? ? source[:bytes_used].to_i : nil
+        end
+      end
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
