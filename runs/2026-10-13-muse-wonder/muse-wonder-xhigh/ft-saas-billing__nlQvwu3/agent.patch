+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,56 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <h2><%= @account.name %></h2>
+
+    <dl>
+      <dt>Plan</dt>
+      <dd><%= @account.billing_plan.name %></dd>
+
+      <% if @account.comped? %>
+        <dt>Status</dt>
+        <dd>Comped</dd>
+      <% end %>
+
+      <dt>Card count</dt>
+      <dd><%= number_with_delimiter(@account.effective_card_count) %></dd>
+
+      <dt>Bytes used</dt>
+      <dd><%= number_with_delimiter(@account.bytes_used) %></dd>
+
+      <% if @account.overridden_limit %>
+        <dt>Overridden card count</dt>
+        <dd><%= @account.overridden_limit.card_count %></dd>
+
+        <dt>Overridden bytes used</dt>
+        <dd><%= @account.overridden_limit.bytes_used %></dd>
+      <% end %>
+    </dl>
+
+    <div class="flex gap-half">
+      <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+      <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+    </div>
+
+    <%= form_with scope: :overridden_limit, url: saas.admin_account_overridden_limit_path(@account), method: :post do |form| %>
+      <div>
