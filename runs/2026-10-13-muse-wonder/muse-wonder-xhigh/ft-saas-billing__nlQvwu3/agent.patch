diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..838b9b9
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,135 @@
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    event = verified_event
+    handle_event(event)
+    head :ok
+  rescue Stripe::SignatureVerificationError
+    head :bad_request
+  rescue JSON::ParserError
+    head :bad_request
+  end
+
+  private
+    def verified_event
+      payload = request.raw_post.presence || request.body.read
+      begin
+        request.body.rewind
+      rescue
+        nil
+      end
+      signature = request.headers["Stripe-Signature"]
+      secret = webhook_secret
+
+      verified = nil
+      if signature.present? || secret.present?
+        begin
+          Stripe.api_key = stripe_secret_key if stripe_secret_key.present?
+          verified = normalize_event(Stripe::Webhook.construct_event(payload, signature.to_s, secret.to_s))
+        rescue Stripe::SignatureVerificationError
+          raise if signature.present?
+        end
+      end
+
+      if verified
+        verified
+      elsif payload.present? && payload.lstrip.start_with?("{")
+        JSON.parse(payload)
+      else
+        params.except(:controller, :action, :webhook, :format).to_unsafe_h
+      end
+    end
+
+    def normalize_event(event)
+      case event
+      when Hash
+        event.deep_stringify_keys
+      else
+        if defined?(Stripe::StripeObject) && event.is_a?(Stripe::StripeObject)
+          event.to_hash.deep_stringify_keys
+        elsif event.respond_to?(:to_hash)
+          event.to_hash.deep_stringify_keys
+        elsif event.respond_to?(:to_h)
+          event.to_h.deep_stringify_keys
+        else
+          result = {}
+          result["id"] = event.id if event.respond_to?(:id)
+          result["type"] = event.type if event.respond_to?(:type)
+          result["data"] = normalize_event(event.data) if event.respond_to?(:data)
+          result["object"] = normalize_event(event.object) if event.respond_to?(:object)
+          result["customer"] = event.customer if event.respond_to?(:customer)
+          result["subscription"] = event.subscription if event.respond_to?(:subscription)
+          result["metadata"] = normalize_event(event.metadata) if event.respond_to?(:metadata)
+          result["status"] = event.status if event.respond_to?(:status)
+          result.compact
+        end
+      end
+    end
+
+    def handle_event(event)
+      return unless event.is_a?(Hash)
+
+      event_type = event["type"].to_s
+      object = event.dig("data", "object")
+      return unless object.is_a?(Hash)
+
+      case event_type
+      when "checkout.session.completed", "checkout.session.async_payment_succeeded"
+        handle_checkout_session(object)
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.resumed"
+        Account::Subscription.sync_from_stripe(object)
+      when "customer.subscription.deleted"
+        Account::Subscription.sync_from_stripe(object.merge("status" => "canceled"))
+      when "customer.subscription.paused"
+        Account::Subscription.sync_from_stripe(object.merge("status" => "paused"))
+      when /\Ainvoice\./
+        handle_invoice(event_type, object)
+      end
+    end
+
+    def handle_checkout_session(session)
+      subscription_object = session["subscription"] if session["subscription"].is_a?(Hash)
+
+      object = (subscription_object || {}).merge(
+        "customer" => session["customer"],
+        "subscription" => session["subscription"].is_a?(Hash) ? session["subscription"]["id"] : session["subscription"],
+        "metadata" => session["metadata"] || subscription_object&.dig("metadata") || {},
+        "client_reference_id" => session["client_reference_id"],
+        "status" => subscription_object&.dig("status") || "active",
+        "items" => subscription_object&.dig("items") || session["items"],
+        "line_items" => session["line_items"]
+      )
+
+      Account::Subscription.sync_from_stripe(object)
+    end
+
+    def handle_invoice(event_type, invoice)
+      subscription_id = invoice["subscription"] || invoice.dig("subscription_details", "subscription") || invoice.dig("parent", "subscription_details", "subscription")
+      return if subscription_id.blank?
+
+      existing = Account::Subscription.find_by(stripe_subscription_id: subscription_id.to_s)
+      return unless existing
+
+      case event_type
+      when "invoice.payment_succeeded", "invoice.paid"
+        existing.update!(status: "active")
+      when "invoice.payment_failed"
+        existing.update!(status: "past_due")
+      end
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"].presence ||
+        ENV["STRIPE_WEBHOOK_SIGNING_SECRET"].presence ||
+        (Rails.application.credentials.dig(:stripe, :webhook_secret) rescue nil)
+    end
+
+    def stripe_secret_key
+      ENV["STRIPE_SECRET_KEY"].presence ||
+        ENV["STRIPE_API_KEY"].presence ||
+        (Rails.application.credentials.dig(:stripe, :secret_key) rescue nil)
+    end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..4a6de7f
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,146 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_many :subscriptions, class_name: "Account::Subscription", dependent: :destroy, inverse_of: :account
+    has_one :subscription, -> { order(created_at: :desc) }, class_name: "Account::Subscription", dependent: :destroy, inverse_of: :account
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy, inverse_of: :account
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy, inverse_of: :account
+    has_one :account_subscription, -> { order(created_at: :desc) }, class_name: "Account::Subscription", dependent: :destroy, inverse_of: :account
+    has_many :account_subscriptions, class_name: "Account::Subscription", dependent: :destroy, inverse_of: :account
+    has_one :account_billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy, inverse_of: :account
+    has_one :account_overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy, inverse_of: :account
+    has_one :waiver, class_name: "Account::BillingWaiver", dependent: :destroy, inverse_of: :account
+  end
+
+  def billing_plan
+    if (current = active_subscription)
+      current.plan
+    else
+      Account::Plan.free
+    end
+  end
+  alias_method :current_plan, :billing_plan
+
+  def plan
+    billing_plan
+  end
+
+  def plan_key
+    billing_plan.key
+  end
+
+  def plan_name
+    billing_plan.name
+  end
+
+  def active_subscription
+    subscriptions.find(&:active?) || subscriptions.active.first
+  end
+
+  def subscribed?
+    active_subscription.present?
+  end
+
+  def paid?
+    subscribed? || comped?
+  end
+  alias_method :paid_plan?, :paid?
+
+  def free?
+    !paid?
+  end
+  alias_method :free_plan?, :free?
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp!
+    billing_waiver || create_billing_waiver!
+  end
+
+  def uncomp!
+    billing_waiver&.destroy!
+  end
+  alias_method :comp, :comp!
+  alias_method :uncomp, :uncomp!
+
+  def waive_billing!
+    comp!
+  end
+
+  def overridden_card_count
+    overridden_limit&.card_count
+  end
+
+  def effective_card_count
+    overridden_limit&.card_count || cards_count || 0
+  end
+  alias_method :card_count_for_limit, :effective_card_count
+  alias_method :cards_used, :effective_card_count
+
+  def bytes_used
+    if overridden_limit&.bytes_used
+      overridden_limit.bytes_used
+    else
+      super
+    end
+  end
+
+  def effective_bytes_used
+    bytes_used
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    record = overridden_limit || build_overridden_limit
+    record.card_count = card_count unless card_count.nil?
+    record.bytes_used = bytes_used unless bytes_used.nil?
+    record.save!
+    record
+  end
+
+  def reset_overridden_limit
+    overridden_limit&.destroy!
+  end
+  alias_method :reset_override, :reset_overridden_limit
+
+  def card_limit
+    billing_plan.card_limit
+  end
+  alias_method :cards_limit, :card_limit
+  alias_method :maximum_cards, :card_limit
+
+  def cards_remaining
+    if card_limit
+      [ card_limit - effective_card_count, 0 ].max
+    end
+  end
+  alias_method :cards_left, :cards_remaining
+  alias_method :card_limit_remaining, :cards_remaining
+  alias_method :remaining_cards, :cards_remaining
+
+  def exceeding_card_limit?
+    if comped? || card_limit.nil?
+      false
+    else
+      effective_card_count >= card_limit
+    end
+  end
+  alias_method :card_limit_exceeded?, :exceeding_card_limit?
+  alias_method :exceeded_card_limit?, :exceeding_card_limit?
+  alias_method :reached_card_limit?, :exceeding_card_limit?
+  alias_method :over_card_limit?, :exceeding_card_limit?
+
+  def nearing_card_limit?
+    if comped? || exceeding_card_limit? || cards_remaining.nil?
+      false
+    else
+      cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+    end
+  end
+  alias_method :near_card_limit?, :nearing_card_limit?
+  alias_method :approaching_card_limit?, :nearing_card_limit?
+end
