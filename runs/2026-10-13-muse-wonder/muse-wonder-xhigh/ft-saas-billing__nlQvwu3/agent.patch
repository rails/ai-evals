+require "test_helper"
+
+class Account::BillingControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+  end
+
+  test "settings show the plan and upgrade for admins" do
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "Free"
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "checkout redirects to Stripe" do
+    session = Struct.new(:url).new("https://checkout.stripe.com/pay/123")
+    Stripe::Checkout::Session.stubs(:create).returns(session)
+
+    post saas.account_billing_checkout_path(plan: "unlimited", script_name: @account.slug)
+
+    assert_redirected_to "https://checkout.stripe.com/pay/123"
+  end
+
+  test "customer portal redirects to Stripe" do
+    @account.subscriptions.create!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_123")
+    session = Struct.new(:url).new("https://billing.stripe.com/portal/123")
+    Stripe::BillingPortal::Session.stubs(:create).returns(session)
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to "https://billing.stripe.com/portal/123"
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..d6d2809
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @account = accounts(:initech)
+  end
+
+  test "staff can list accounts and open an account" do
+    untenanted { get saas.admin_accounts_path }
+    assert_response :success
+    assert_select "a", text: @account.name
+
+    untenanted { get saas.admin_account_path(@account) }
+    assert_response :success
+    assert_select "button", text: "Comp"
+    assert_select "button", text: "Uncomp"
+    assert_select "button", text: "Reset"
+  end
+
+  test "non-staff cannot list accounts" do
+    logout_and_sign_in_as :jz
+
+    untenanted { get saas.admin_accounts_path }
+    assert_response :forbidden
+  end
+
+  test "comp and uncomp" do
+    untenanted { post saas.admin_account_billing_waiver_path(@account) }
+    assert @account.reload.comped?
+
+    untenanted { delete saas.admin_account_billing_waiver_path(@account) }
+    assert_not @account.reload.comped?
+  end
+
+  test "override and reset" do
+    untenanted do
+      post saas.admin_account_overridden_limit_path(@account),
+        params: { overridden_limit: { card_count: 123, bytes_used: 456 } }
+    end
+
+    assert_equal 123, @account.reload.overridden_limit.card_count
+    assert_equal 456, @account.overridden_limit.bytes_used
+
+    untenanted { delete saas.admin_account_overridden_limit_path(@account) }
+    assert_nil @account.reload.overridden_limit
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..cdd014b
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+  end
+
+  test "free account at the card limit can still draft but not publish or create via the API" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Blocked card" } }, as: :json
+    end
+    assert_response :forbidden
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+
+    post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug)
+    assert_response :redirect
+  end
+
+  test "draft shows an upgrade pitch instead of create buttons at the limit" do
+    @account.update_column(:cards_count, 1_000)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "draft warns when 50 cards are left" do
+    @account.update_column(:cards_count, 950)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select "div", text: /50 cards left/
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..7ff83be
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "subscription created webhook activates the paid plan" do
+    payload = {
+      type: "customer.subscription.created",
+      data: {
+        object: {
+          id: "sub_123",
+          customer: "cus_123",
+          status: "active",
+          metadata: { account_id: accounts(:initech).id },
+          items: { data: [ { price: { id: "price_123", unit_amount: 2_500 } } ] }
+        }
+      }
+    }.to_json
+
+    assert_difference -> { Account::Subscription.count }, 1 do
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: { "CONTENT_TYPE" => "application/json" }
+      end
+    end
+
+    assert_response :success
+    assert_equal "unlimited_plus", accounts(:initech).subscriptions.last.plan_key
+    assert_equal "Unlimited+", accounts(:initech).reload.plan.to_s
+  end
+
+test "checkout session completed webhook records the subscription" do
+  payload = {
+    type: "checkout.session.completed",
+    data: {
+      object: {
+        id: "cs_123",
+        customer: "cus_999",
+        subscription: "sub_999",
+        client_reference_id: accounts(:initech).id,
+        metadata: { account_id: accounts(:initech).id, plan_key: "unlimited" }
+      }
+    }
+  }.to_json
+
+  untenanted do
+    post "/stripe/webhooks", params: payload, headers: { "CONTENT_TYPE" => "application/json" }
+  end
+
+  assert_response :success
+  subscription = accounts(:initech).subscriptions.last
+  assert_equal "cus_999", subscription.stripe_customer_id
+  assert_equal "sub_999", subscription.stripe_subscription_id
+  assert_equal "unlimited", subscription.plan_key
+end
+
+  test "subscription deleted webhook returns the account to free" do
+    accounts(:initech).subscriptions.create!(
+      plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123"
+    )
+
+    payload = {
+      type: "customer.subscription.deleted",
+      data: { object: { id: "sub_123", customer: "cus_123", status: "canceled" } }
+    }.to_json
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: { "CONTENT_TYPE" => "application/json" }
+    end
+
+    assert_response :success
+    assert_equal "Free", accounts(:initech).reload.plan.to_s
+  end
+
+  test "invalid signature is rejected" do
+    payload = { type: "customer.subscription.created", data: { object: { id: "sub_bad" } } }.to_json
+
+    untenanted do
+      post "/stripe/webhooks", params: payload,
+        headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=1,v1=invalid" }
+    end
+
+    assert_response :bad_request
+  end
+end
