diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..de313f3
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "renders only the raw timestamp with the format for the browser" do
+    time = Time.utc(2026, 9, 12, 13, 42)
+    html = local_time_tag(time, format: :relative)
+
+    assert_select parse(html), "time[datetime='2026-09-12T13:42:00Z'][data-controller='local-time'][data-local-time-format-value='relative']", text: ""
+  end
+
+  test "renders date formats for the browser" do
+    time = Time.utc(2026, 9, 12, 13, 42)
+    html = local_time_tag(time, format: :date)
+
+    assert_select parse(html), "time[datetime='2026-09-12T13:42:00Z'][data-local-time-format-value='date'][data-format='%b %-d']", text: ""
+  end
+
+  test "accepts a strftime pattern and extra attributes" do
+    time = Time.utc(2026, 9, 12, 13, 42)
+    html = local_time_tag(time, "%b %-d", class: "timestamp")
+
+    assert_select parse(html), "time.timestamp[data-local-time-format-value='%b %-d']"
+  end
+
+  test "renders nothing without a time" do
+    assert_equal "", local_time_tag(nil, format: :date)
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..f4d86ef
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,46 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "comment times are rendered in the browser in the viewer's timezone" do
+    sign_in_as(users(:david))
+
+    visit card_url(cards(:logo))
+
+    assert_selector ".comment__permalink-title time[data-controller='local-time']"
+
+    texts = evaluated_time_texts(".comment__permalink-title time")
+    assert_includes texts, "yesterday"
+    assert_includes texts, "2 days ago"
+    assert texts.all? { |text| text.match?(/\A(\d{1,2}:\d{2} [AP]M|yesterday|\d+ days ago|[A-Z][a-z]{2} \d{1,2})\z/) }, texts.inspect
+  end
+
+  test "card times are rendered in the browser" do
+    sign_in_as(users(:david))
+
+    visit card_url(cards(:logo))
+
+    texts = evaluated_time_texts(".card__meta time")
+    assert texts.any?, "expected card meta times to be rendered"
+    assert texts.all?(&:present?), texts.inspect
+  end
+
+  test "a card auto-closing overnight reads tomorrow, further out in days" do
+    sign_in_as(users(:david))
+    card = cards(:logo)
+
+    card.update!(last_active_at: 89.days.ago)
+    visit card_url(card)
+    assert_selector "[id*=closure_notice]", text: /Moves to “Not Now” tomorrow/
+
+    card.update!(last_active_at: 87.days.ago)
+    visit card_url(card)
+    assert_selector "[id*=closure_notice]", text: /Moves to “Not Now” in 3 days/
+  end
+
+  private
+    def evaluated_time_texts(selector)
+      evaluate_script(<<~JS)
+        Array.from(document.querySelectorAll("#{selector}")).map((element) => element.textContent)
+      JS
+    end
+end
