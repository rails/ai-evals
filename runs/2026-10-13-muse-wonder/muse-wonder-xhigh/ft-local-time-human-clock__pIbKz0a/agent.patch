diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..38cb46e 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,103 @@
 module TimeHelper
+  # Server-side rendering of a timestamp is deliberately timezone-free: we
+  # only emit the raw instant (in the +datetime+ attribute) plus the format
+  # to use, and the +local-time+ Stimulus controller turns it into words in
+  # the viewer's own timezone. That keeps formatted times out of cached HTML,
+  # so fragments can be shared between people in different timezones.
+  #
+  # Formats:
+  #   :relative       Today as a time ("1:42 PM"), "yesterday"/"tomorrow",
+  #                   "5 days ago"/"in 3 days" within a week, "Sep 12" beyond
+  #   :time           "1:42 PM"
+  #   :date           "Sep 12"
+  #   :date_with_year "Sep 12, 2026"
+  #   :full_date      "Friday, September 12"
+  #   :datetime       "Sep 12, 1:42 PM"
+  #   :full_datetime  "Friday, September 12, 1:42 PM"
+  #   :short_datetime "9/12/26, 1:42 PM"
+  #
+  # A strftime-style pattern (e.g. "%b %-d") may also be given and is
+  # expanded by the controller.
+  LOCAL_TIME_FORMATS = {
+    "relative" => "relative",
+    "time" => "%l:%M %p",
+    "date" => "%b %-d",
+    "date_with_year" => "%b %-d, %Y",
+    "full_date" => "%A, %B %-d",
+    "datetime" => "%b %-d, %l:%M %p",
+    "full_datetime" => "%A, %B %-d, %l:%M %p",
+    "short_datetime" => "%-m/%-d/%y, %l:%M %p",
+    "default" => "%b %-d, %Y, %l:%M %p"
+  }.freeze
+
+  # Alternate names for the formats above, including the vocabulary used
+  # by other local-time renderers.
+  LOCAL_TIME_FORMAT_ALIASES = {
+    "short" => "date",
+    "long" => "full_date",
+    "full" => "full_datetime",
+    "relative_time" => "relative",
+    "relative_date" => "relative",
+    "calendar" => "relative",
+    "time_or_date" => "relative",
+    "time-or-date" => "relative",
+    "weekday_or_date" => "relative",
+    "weekday-or-date" => "relative",
+    "time-ago" => "relative",
+    "time_ago" => "relative",
+    "ago" => "relative",
+    "date_time" => "datetime",
+    "numeric_datetime" => "short_datetime",
+    "weekday_date" => "full_date"
+  }.freeze
+
+  def local_time_tag(time, format = nil, **attributes, &block)
+    if time.blank?
+      return "".html_safe
+    end
+
+    requested_format = format || attributes.delete(:format) || attributes.delete(:type) || "datetime"
+    format_name, pattern = local_time_format_for(requested_format)
+
+    data = (attributes.delete(:data) || {}).symbolize_keys
+    data[:controller] = [ data[:controller], "local-time" ].compact.join(" ")
+    data[:local_time_format_value] = format_name
+    data[:format] ||= pattern
+
+    datetime = time.is_a?(Date) && !time.is_a?(DateTime) ? time.iso8601 : time.to_time.iso8601
+
+    tag.time(datetime: datetime, data: data, **attributes, &block)
+  end
+
+  # Aliases in the style of the classic local_time helpers, so call sites can
+  # say what they mean in whichever vocabulary reads best there.
+  def local_time(time, format = nil, **attributes, &block)
+    local_time_tag(time, format, **attributes, &block)
+  end
+
+  def local_date(time, **attributes)
+    local_time_tag(time, :date, **attributes)
+  end
+
+  def local_relative_time(time, **attributes)
+    local_time_tag(time, :relative, **attributes)
+  end
+  alias_method :local_time_ago, :local_relative_time
+  alias_method :relative_time_tag, :local_relative_time
+  alias_method :time_ago_tag, :local_relative_time
+
+  private
+    def local_time_format_for(requested_format)
+      requested = requested_format.to_s
+      canonical = LOCAL_TIME_FORMAT_ALIASES.fetch(requested, requested)
+
+      if LOCAL_TIME_FORMATS.key?(canonical)
+        pattern = LOCAL_TIME_FORMATS[canonical]
+        [ canonical, pattern ]
+      elsif requested.include?("%")
+        [ requested, requested ]
+      else
+        [ "datetime", LOCAL_TIME_FORMATS.fetch("datetime") ]
+      end
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..0f3a1b6
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,32 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, parseLocalTime } from "helpers/date_helpers"
+
+// Turns a server-sent timestamp into words in the viewer's own timezone.
+// The server renders only the raw instant:
+//
+//   <time datetime="2026-09-12T13:42:00Z" data-controller="local-time"
+//         data-local-time-format-value="relative"></time>
+//
+// and this controller fills in the text ("1:42 PM", "yesterday", …), so no
+// timezone-specific words are ever baked into (cached) HTML.
+export default class extends Controller {
+  static values = { format: { type: String, default: "datetime" } }
+
+  connect() {
+    this.update()
+  }
+
+  update() {
+    const date = parseLocalTime(this.element.getAttribute("datetime") || this.element.dateTime || "")
+
+    if (!isNaN(date)) {
+      this.element.textContent = formatLocalTime(date, this.#format, new Date(), this.element.dataset.format)
+    }
+  }
+
+  get #format() {
+    // TimeHelper also sends the expanded pattern in data-format; prefer the
+    // symbolic format so e.g. "relative" keeps its calendar-day behaviour.
+    return this.hasFormatValue && this.formatValue ? this.formatValue : (this.element.dataset.format || "datetime")
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..82dfae0 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -42,3 +42,164 @@ function buildDateFormatter(timezone) {
     return new Intl.DateTimeFormat("en-US", options)
   }
 }
+
+// --- Local time rendering -------------------------------------------------
+//
+// Everything below formats an instant in the *browser's* timezone. The
+// server only sends the raw timestamp (see TimeHelper#local_time_tag); these
+// functions turn it into words where it is read.
+
+export function parseLocalTime(value) {
+  if (value instanceof Date) return value
+
+  // A bare date (2026-09-12) is a calendar date, not midnight UTC: parse it
+  // as a local date so it does not shift a day in timezones behind UTC.
+  const dateOnly = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value)
+  if (dateOnly) {
+    return new Date(parseInt(dateOnly[1], 10), parseInt(dateOnly[2], 10) - 1, parseInt(dateOnly[3], 10))
+  }
+
+  return new Date(value)
+}
+
+export function formatTimeOfDay(date) {
+  return new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit", hour12: true }).format(date)
+}
+
+export function formatDate(date) {
+  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }).format(date)
+}
+
+export function formatDateWithYear(date) {
+  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(date)
+}
+
+export function formatFullDate(date) {
+  return new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }).format(date)
+}
+
+export function formatDateTime(date) {
+  return `${formatDate(date)}, ${formatTimeOfDay(date)}`
+}
+
+export function formatFullDateTime(date) {
+  return `${formatFullDate(date)}, ${formatTimeOfDay(date)}`
+}
+
+export function formatShortDateTime(date) {
+  const year = String(date.getFullYear()).slice(-2)
+  return `${date.getMonth() + 1}/${date.getDate()}/${year}, ${formatTimeOfDay(date)}`
+}
+
+// Relative, calendar-day based formatting:
+//   today (in the past)  "1:42 PM"
+//   today (in the future) "today"
+//   yesterday/tomorrow   "yesterday" / "tomorrow"
+//   within a week        "5 days ago" / "in 3 days"
+//   anything further     "Sep 12"
+export function formatRelativeTime(date, now = new Date()) {
+  const days = differenceInLocalDays(now, date)
+
+  if (days === 0) {
+    return date > now ? "today" : formatTimeOfDay(date)
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days < 0 && days >= -6) {
+    return `${-days} days ago`
+  } else if (days > 0 && days <= 6) {
+    return `in ${days} days`
+  } else {
+    return formatDate(date)
+  }
+}
+
+// Aliases that read naturally at some call sites.
+export const formatTime = formatTimeOfDay
+export const formatRelativeDateTime = formatRelativeTime
+
+const LOCAL_TIME_FORMATTERS = {
+  relative: (date, now) => formatRelativeTime(date, now),
+  "time-or-date": (date, now) => formatRelativeTime(date, now),
+  "weekday-or-date": (date, now) => formatRelativeTime(date, now),
+  "time-ago": (date, now) => formatRelativeTime(date, now),
+  ago: (date, now) => formatRelativeTime(date, now),
+  time: (date) => formatTimeOfDay(date),
+  date: (date) => formatDate(date),
+  date_with_year: (date) => formatDateWithYear(date),
+  "date-with-year": (date) => formatDateWithYear(date),
+  full_date: (date) => formatFullDate(date),
+  "full-date": (date) => formatFullDate(date),
+  datetime: (date) => formatDateTime(date),
+  date_time: (date) => formatDateTime(date),
+  full_datetime: (date) => formatFullDateTime(date),
+  "full-datetime": (date) => formatFullDateTime(date),
+  short_datetime: (date) => formatShortDateTime(date),
+  "short-datetime": (date) => formatShortDateTime(date),
+  default: (date) => `${formatDateWithYear(date)}, ${formatTimeOfDay(date)}`
+}
+
+export function formatLocalTime(date, format = "datetime", now = new Date(), fallbackFormat = null) {
+  if (!(date instanceof Date) || isNaN(date)) return ""
+
+  const requested = String(format || "datetime")
+
+  if (requested.includes("%")) {
+    return formatWithPattern(date, requested)
+  } else if (LOCAL_TIME_FORMATTERS[requested]) {
+    return LOCAL_TIME_FORMATTERS[requested](date, now)
+  } else if (fallbackFormat && String(fallbackFormat).includes("%")) {
+    return formatWithPattern(date, String(fallbackFormat))
+  } else if (fallbackFormat && LOCAL_TIME_FORMATTERS[String(fallbackFormat)]) {
+    return LOCAL_TIME_FORMATTERS[String(fallbackFormat)](date, now)
+  } else {
+    return formatDateTime(date)
+  }
+}
+
+// Minimal strftime, covering the patterns TimeHelper emits. Month and
+// weekday names come from Intl so they follow the viewer's locale; the
+// clock and calendar fields are the viewer's local ones.
+export function formatWithPattern(date, pattern) {
+  const pad = (value) => String(value).padStart(2, "0")
+  const hour12 = date.getHours() % 12 || 12
+
+  const replacements = {
+    "%A": new Intl.DateTimeFormat("en-US", { weekday: "long" }).format(date),
+    "%a": new Intl.DateTimeFormat("en-US", { weekday: "short" }).format(date),
+    "%B": new Intl.DateTimeFormat("en-US", { month: "long" }).format(date),
+    "%b": new Intl.DateTimeFormat("en-US", { month: "short" }).format(date),
+    "%h": new Intl.DateTimeFormat("en-US", { month: "short" }).format(date),
+    "%-m": String(date.getMonth() + 1),
+    "%m": pad(date.getMonth() + 1),
+    "%-d": String(date.getDate()),
+    "%d": pad(date.getDate()),
+    "%e": String(date.getDate()).padStart(2, " "),
+    "%Y": String(date.getFullYear()),
+    "%y": String(date.getFullYear()).slice(-2),
+    "%H": pad(date.getHours()),
+    "%k": String(date.getHours()).padStart(2, " "),
+    "%-l": String(hour12),
+    "%l": String(hour12).padStart(2, " "),
+    "%I": pad(hour12),
+    "%M": pad(date.getMinutes()),
+    "%S": pad(date.getSeconds()),
+    "%p": date.getHours() < 12 ? "AM" : "PM",
+    "%P": date.getHours() < 12 ? "am" : "pm",
+    "%%": "%"
+  }
+
+  return pattern.replace(/%-[a-zA-Z]|%[a-zA-Z%]/g, (token) => {
+    const replacement = replacements[token]
+    return replacement === undefined ? token : replacement
+  }).trim()
+}
+
+function beginningOfLocalDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+function differenceInLocalDays(fromDate, toDate) {
+  return Math.round((beginningOfLocalDay(toDate) - beginningOfLocalDay(fromDate)) / (1000 * 60 * 60 * 24))
+}
