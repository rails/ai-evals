--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -32,6 +32,14 @@ module Book::Accessable
     accesses.find_by(user: user)
   end
 
+  # Everyone who may currently edit the book: users with editor access
+  # plus administrators (who can edit any book). Presence/being-edited
+  # broadcasts are fanned out to these users individually so that a
+  # collaborator who has been removed no longer receives them.
+  def editors
+    User.where(id: accesses.editor.select(:user_id)).or(User.administrator)
+  end
+
   def update_access(editors:, readers:)
     editors = Set.new(editors)
     readers = Set.new(everyone_access? ? User.active.ids : readers)
