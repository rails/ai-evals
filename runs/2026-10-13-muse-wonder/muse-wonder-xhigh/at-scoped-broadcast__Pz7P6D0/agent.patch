diff --git a/test/controllers/being_edited_indicator_test.rb b/test/controllers/being_edited_indicator_test.rb
new file mode 100644
index 0000000..31eeea4
--- /dev/null
+++ b/test/controllers/being_edited_indicator_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+
+  test "removed collaborator does not receive being edited broadcast but remaining editor does" do
+    leaf = leaves(:welcome_page)
+    removed_stream = captured_stream_name(:kevin)
+    remaining_stream = captured_stream_name(:jason)
+
+    books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [ users(:jz).id ])
+    assert_not books(:handbook).editable?(user: users(:kevin))
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put book_page_path(books(:handbook), leaf), params: { page: { body: "Updated by david" } }
+    end
+    assert_response :success
+
+    assert_empty broadcasts(removed_stream)
+    assert broadcasts(remaining_stream).any? { |broadcast| broadcast.include?("David") }
+  end
+
+  test "editor receives being edited broadcast" do
+    leaf = leaves(:welcome_page)
+    stream = captured_stream_name(:kevin)
+
+    sign_in :jason
+    perform_enqueued_jobs do
+      put book_page_path(books(:handbook), leaf), params: { page: { body: "Updated by jason" } }
+    end
+    assert_response :success
+
+    assert broadcasts(stream).any? { |broadcast| broadcast.include?("Jason") }
+  end
+
+  private
+    def captured_stream_name(user_fixture)
+      sign_in user_fixture
+      get edit_book_page_path(books(:handbook), leaves(:welcome_page))
+      assert_response :success
+
+      signed = response.body[/<turbo-cable-stream-source[^>]*signed-stream-name="([^"]+)"/, 1]
+      assert signed, "no stream source in edit page"
+      Turbo::StreamsChannel.verified_stream_name(CGI.unescapeHTML(signed))
+    ensure
+      sign_out
+    end
+end
