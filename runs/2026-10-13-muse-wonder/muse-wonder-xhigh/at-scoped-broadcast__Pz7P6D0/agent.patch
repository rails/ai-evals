@@ -67,7 +67,17 @@ class LeafablesController < ApplicationController
     end
 
     def broadcast_being_edited_indicator
-      Turbo::StreamsChannel.broadcast_render_later_to @leaf, :being_edited,
-        partial: "leaves/being_edited_by", locals: { leaf: @leaf, user: Current.user }
+      # Broadcast per current editor, on a stream scoped to that editor,
+      # rather than on a single leaf-wide stream. A collaborator removed
+      # from the book may still be subscribed to the stream they were
+      # given while they had access, so the payload (including the
+      # editor's name) must never be sent on a shared leaf stream or on
+      # the removed collaborator's own stream. Editors who still have
+      # access keep receiving it on their own stream, which does not
+      # change when someone else is removed.
+      @book.editors.each do |editor|
+        Turbo::StreamsChannel.broadcast_render_later_to editor, @leaf, :being_edited,
+          partial: "leaves/being_edited_by", locals: { leaf: @leaf, user: Current.user }
+      end
     end
 end
