diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..c1b4bd8
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches cards by title, newest first, with highlighting" do
+    older = new_card(title: "Quixotic older card", created_at: 2.days.ago)
+    newer = new_card(title: "Quixotic newer card", created_at: 1.day.ago)
+
+    get search_path, params: { q: "quixotic" }
+
+    assert_response :success
+    assert_select "mark", text: /quixotic/i, minimum: 2
+    assert_operator response.body.index("newer card"), :<, response.body.index("older card")
+  end
+
+  test "searches cards by description" do
+    card = new_card(title: "Plain title", description: "A zephyr description")
+
+    get search_path, params: { q: "zephyr" }
+
+    assert_response :success
+    assert_includes response.body, card_path(card)
+    assert_select "mark", text: /zephyr/i
+  end
+
+  test "searches cards by comment body" do
+    card = new_card(title: "Another plain title")
+    with_current_user(users(:kevin)) do
+      card.comments.create!(creator: users(:kevin), body: "A murmuration comment")
+    end
+
+    get search_path, params: { q: "murmuration" }
+
+    assert_response :success
+    assert_includes response.body, card_path(card)
+    assert_select "mark", text: /murmuration/i
+  end
+
+  test "does not return draft cards" do
+    draft = nil
+    with_current_user(users(:kevin)) do
+      draft = boards(:writebook).cards.create!(title: "Drafty quixotic card", status: :drafted, creator: users(:kevin))
+    end
+
+    get search_path, params: { q: "drafty" }
+    assert_response :success
+    assert_not_includes response.body, card_path(draft)
+  end
+
+  test "returns cards from private boards the user has access to" do
+    private_card = new_private_card
+
+    get search_path, params: { q: "quixotic" }
+    assert_response :success
+    assert_includes response.body, card_path(private_card)
+  end
+
+  test "does not return cards from boards the user does not have access to" do
+    private_card = new_private_card
+
+    logout_and_sign_in_as :david
+
+    get search_path, params: { q: "quixotic" }
+    assert_response :success
+    assert_not_includes response.body, card_path(private_card)
+  end
+
+  test "search without a query" do
+    get search_path
+    assert_response :success
+
+    get search_path, params: { q: "" }
+    assert_response :success
+  end
+
+  test "search is case-insensitive and matches comments on published cards only" do
+    card = new_card(title: "Case card")
+    with_current_user(users(:kevin)) do
+      card.comments.create!(creator: users(:kevin), body: "A Murmuration comment")
+      card.update!(status: :drafted)
+    end
+
+    get search_path, params: { q: "MURMURATION" }
+    assert_response :success
+    assert_not_includes response.body, card_path(card)
+
+    with_current_user(users(:kevin)) do
+      card.update!(status: :published)
+    end
+
+    get search_path, params: { q: "MURMURATION" }
+    assert_response :success
+    assert_includes response.body, card_path(card)
+    assert_select "mark", text: /murmuration/i
+  end
+
+  test "search treats percent signs literally" do
+    card = new_card(title: "100% quixotic coverage")
+
+    get search_path, params: { q: "100%" }
+
+    assert_response :success
+    assert_includes response.body, card_path(card)
+    assert_select "mark", text: "100%"
+  end
+
+  private
+    def new_card(board: boards(:writebook), **attributes)
+      card = nil
+      with_current_user(users(:kevin)) do
+        card = board.cards.create!(**attributes.reverse_merge(status: :published, creator: users(:kevin)))
+      end
+      card
+    end
+
+    def new_private_card
+      new_card(board: boards(:private), title: "Secret quixotic card")
+    end
+end
