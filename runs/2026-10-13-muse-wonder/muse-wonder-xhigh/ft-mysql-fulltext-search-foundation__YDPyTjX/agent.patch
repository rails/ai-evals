+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,48 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = @query.present? ? searched_cards : Card.none
+  end
+
+  private
+    def searched_cards
+      cards = Current.user.accessible_cards.published
+        .preload(:board, :rich_text_description, comments: :rich_text_body)
+
+      search_terms.each do |term|
+        pattern = search_pattern(term)
+
+        cards = cards.where(<<~SQL, pattern, pattern, pattern)
+          cards.title LIKE ? ESCAPE '!'
+          OR EXISTS (
+            SELECT 1
+            FROM action_text_rich_texts
+            WHERE action_text_rich_texts.record_type = 'Card'
+              AND action_text_rich_texts.name = 'description'
+              AND action_text_rich_texts.record_id = cards.id
+              AND action_text_rich_texts.body LIKE ? ESCAPE '!'
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM comments
+            INNER JOIN action_text_rich_texts AS comment_rich_texts
+              ON comment_rich_texts.record_type = 'Comment'
+              AND comment_rich_texts.name = 'body'
+              AND comment_rich_texts.record_id = comments.id
+            WHERE comments.card_id = cards.id
+              AND comment_rich_texts.body LIKE ? ESCAPE '!'
+          )
+        SQL
+      end
+
+      cards.reverse_chronologically
+    end
+
+    def search_terms
+      @search_terms ||= @query.split(/\s+/)
+    end
+
+    def search_pattern(term)
+      "%#{term.gsub(/[!%_]/) { |character| "!#{character}" }}%"
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..6c1acf3
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,39 @@
+module SearchHelper
+  def highlight_search_terms(text, query)
+    plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    terms = search_terms_for_highlight(query)
+
+    if terms.empty? || plain_text.blank?
+      ERB::Util.html_escape(plain_text)
+    else
+      pattern = /(#{terms.map { |term| Regexp.escape(term) }.join("|")})/i
+
+      plain_text.split(pattern).each_with_index.map do |part, index|
+        if index.odd?
+          tag.mark(ERB::Util.html_escape(part))
+        else
+          ERB::Util.html_escape(part)
+        end
+      end.join.html_safe
+    end
+  end
+
+  def search_text_matches?(text, query)
+    plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    terms = search_terms_for_highlight(query)
+
+    terms.any? { |term| plain_text.downcase.include?(term.downcase) }
+  end
+
+  def matching_search_comments(card, query)
+    card.comments.select { |comment| search_text_matches?(comment.body, query) }
+  end
+
+  private
+    def search_terms_for_highlight(query)
+      Array(query).flat_map { |value| [ value.to_s.strip, *value.to_s.split(/\s+/) ] }
+        .reject(&:blank?)
+        .uniq { |term| term.downcase }
+        .sort_by { |term| -term.length }
+    end
+end
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..5bd6bba
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,42 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">
+    <span>Search</span>
+  </h1>
+<% end %>
+
+<section class="panel borderless center margin pad">
+  <%= form_with url: search_path, method: :get, class: "flex gap", data: { controller: "form" } do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", class: "input full-width", autofocus: true, autocorrect: "off", autocomplete: "off" %>
+    <%= form.submit "Search", class: "btn btn--link" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <div class="search-results flex flex-column gap margin-block-start">
+        <% @cards.each do |card| %>
+          <article class="search-result">
+            <h2>
+              <%= link_to card_path(card) do %><%= highlight_search_terms(card.title, @query) %><% end %>
+            </h2>
+
+            <p class="txt-small translucent"><%= card.board.name %></p>
+
+            <% if card.description.present? && search_text_matches?(card.description, @query) %>
+              <p><%= highlight_search_terms(card.description, @query) %></p>
+            <% end %>
+
+            <% matching_search_comments(card, @query).each do |comment| %>
+              <blockquote>
+                <p><%= highlight_search_terms(comment.body, @query) %></p>
+              </blockquote>
+            <% end %>
+          </article>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="blank-slate margin-block-start">No cards found for “<%= @query %>”</p>
+    <% end %>
+  <% end %>
+</section>
