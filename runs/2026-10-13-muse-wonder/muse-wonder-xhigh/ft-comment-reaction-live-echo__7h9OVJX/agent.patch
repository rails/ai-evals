+<% reactions = (local_assigns[:reactions] || comment.reactions).to_a.sort_by { |reaction| [ reaction.created_at || Time.at(0), reaction.id.to_s ] } %>
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reactions">
