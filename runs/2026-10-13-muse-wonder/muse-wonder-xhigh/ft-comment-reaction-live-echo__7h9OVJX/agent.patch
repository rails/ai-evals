+<% own_reaction = Current.user.present? && reaction.reacter_id == Current.user.id %>
+<% comment = reaction.comment %>
+<div id="<%= dom_id(reaction) %>" class="<%= class_names("reaction", "reaction--deleteable": own_reaction) %>"
+     title="<%= reaction.reacter.name %>" data-reacter-id="<%= reaction.reacter_id %>"
+     <% if own_reaction %>data-controller="toggle-class" data-toggle-class-toggle-class="expanded"<% end %>>
+  <span class="reaction__avatar">
+    <%= avatar_tag reaction.reacter, hidden_for_screen_reader: true %>
+  </span>
+
+  <% if own_reaction %>
+    <button type="button" class="btn" data-action="click->toggle-class#toggle" title="Remove your reaction" aria-label="Remove your reaction">
+      <span class="<%= class_names("txt-small txt-medium": reaction.emoji_only?) %>"><%= reaction.content %></span>
+      <span class="for-screen-reader">by <%= reaction.reacter.name %></span>
+    </button>
+  <% else %>
+    <span class="<%= class_names("txt-small txt-medium": reaction.emoji_only?) %>"><%= reaction.content %></span>
+    <span class="for-screen-reader">by <%= reaction.reacter.name %></span>
+  <% end %>
+
+  <% if own_reaction %>
+    <span class="reaction__delete">
+      <%= button_to card_comment_reaction_path(comment.card, comment, reaction), method: :delete,
+            class: "btn reaction__delete-btn", title: "Remove reaction", aria: { label: "Remove reaction" } do %>
+        <%= icon_tag "trash" %>
+        <span>Delete</span>
+        <span class="for-screen-reader">Remove reaction</span>
+      <% end %>
+    </span>
+  <% end %>
+</div>
