+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding and removing a reaction to a comment" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      assert_no_selector ".reaction"
+
+      find(".reactions__trigger").click
+      find(".reaction__input").set("👍")
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "👍"
+      assert_no_selector ".reaction__input", visible: true
+      assert_selector ".reactions__trigger", visible: true
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Nice!")
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction", text: "Nice!"
+
+
+      first(".reaction").click
+      within first(".reaction") do
+        find(".reaction__delete").click
+      end
+
+      assert_selector ".reaction", text: "Nice!"
+      assert_no_selector ".reaction", text: "👍"
+
+      first(".reaction").click
+      within first(".reaction") do
+        find(".reaction__delete").click
+      end
+
+      assert_no_selector ".reaction"
+    end
+
+    assert_equal 0, @comment.reactions.reload.count
+  end
+
+  test "canceling adding a reaction" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("👍")
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector ".reaction"
+      assert_no_selector ".reaction__input", visible: true
+      assert_selector ".reactions__trigger", visible: true
+    end
+  end
+
+  test "seeing a reaction added elsewhere" do
+    visit card_url(@card)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+
+    @comment.reactions.create!(content: "🎉", reacter: users(:jz))
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within "##{dom_id(@comment)}" do
+      assert_selector ".reaction", text: "🎉", wait: 5
+    end
+  end
+end
