+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "creates a reaction on a comment" do
+    comment = comments(:logo_agreement_jz)
+
+    reaction = comment.reactions.create!(content: "👍")
+
+    assert_equal comment, reaction.comment
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal comment.account, reaction.account
+    assert_includes comment.reactions, reaction
+  end
+
+  test "requires content" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: "")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "limits content to 16 characters" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: "a" * 17)
+
+    assert_not reaction.valid?
+
+    reaction.content = "🎉" * 16
+    assert reaction.valid?
+  end
+
+  test "destroying a comment destroys its reactions" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "👍")
+
+    comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
