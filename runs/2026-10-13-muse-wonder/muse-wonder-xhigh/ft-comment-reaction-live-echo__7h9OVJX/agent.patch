+    <%= render partial: "cards/comments/reactions/reaction", collection: reactions, as: :reaction %>
+  </div>
+
+  <button type="button" class="btn reactions__trigger" title="Add a reaction" aria-label="Add a reaction"
+        data-reactions-target="trigger" data-action="click->reactions#showForm">
