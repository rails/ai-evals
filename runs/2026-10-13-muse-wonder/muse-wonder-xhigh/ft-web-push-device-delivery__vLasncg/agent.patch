diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..8d4eeeb
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { PushSubscription.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/1",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+
+    assert_response :created
+
+    push_subscription = PushSubscription.last
+    assert_equal @user, push_subscription.user
+    assert_equal @user.account, push_subscription.account
+    assert_equal "https://push.example.com/subscriptions/1", push_subscription.endpoint
+    assert_equal "p256dh-key", push_subscription.p256dh_key
+    assert_equal "auth-key", push_subscription.auth_key
+  end
+
+  test "create as JSON" do
+    assert_difference -> { PushSubscription.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/2",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "creating the same endpoint again updates the existing subscription" do
+    @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/1",
+      p256dh_key: "old-p256dh-key",
+      auth_key: "old-auth-key"
+    )
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/1",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+
+    assert_response :created
+    push_subscription = PushSubscription.find_by!(endpoint: "https://push.example.com/subscriptions/1")
+    assert_equal "p256dh-key", push_subscription.p256dh_key
+    assert_equal "auth-key", push_subscription.auth_key
+  end
+
+  test "cannot create a subscription for another user" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/1",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "notification settings offer push notifications for this device" do
+    get notifications_settings_path
+
+    assert_response :success
+    assert_select "[data-controller='notifications'][data-notifications-subscription-url-value='#{user_push_subscriptions_path(@user)}']"
+    assert_select "button[data-action='notifications#subscribe']", text: /Turn on push notifications/
+  end
+
+  test "destroy" do
+    push_subscription = @user.push_subscriptions.create!(
