+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+  end
+
+  test "delivers a message through WebPush with the VAPID keys from the environment" do
+    with_vapid_keys do
+      push_subscription = create_push_subscription
+
+      WebPush.expects(:payload_send).with(
+        message: "Hello",
+        endpoint: push_subscription.endpoint,
+        p256dh: push_subscription.p256dh_key,
+        auth: push_subscription.auth_key,
+        vapid: {
+          public_key: "vapid-public-key",
+          private_key: "vapid-private-key"
+        }
+      )
+
+      push_subscription.deliver("Hello")
+    end
+  end
+
+  test "vapid keys are read from the environment" do
+    with_vapid_keys do
+      assert_equal "vapid-public-key", PushSubscription.vapid_public_key
+      assert_equal "vapid-private-key", PushSubscription.vapid_private_key
+      assert PushSubscription.configured?
+    end
+  end
+
+  test "expired subscriptions are removed" do
+    push_subscription = create_push_subscription
+    response = Struct.new(:body).new("")
+    host = URI(push_subscription.endpoint).host
+
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, host))
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      push_subscription.deliver("Hello")
+    end
+  end
+
+  test "invalid subscriptions are removed" do
+    push_subscription = create_push_subscription
+    response = Struct.new(:body).new("")
+    host = URI(push_subscription.endpoint).host
+
+    WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(response, host))
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      push_subscription.deliver("Hello")
+    end
+  end
+
+  private
+    def create_push_subscription(endpoint: "https://push.example.com/subscriptions/1")
+      @user.push_subscriptions.create!(
+        endpoint: endpoint,
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      )
+    end
+
+    def with_vapid_keys
+      original_public_key = ENV["VAPID_PUBLIC_KEY"]
+      original_private_key = ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"] = "vapid-public-key"
+      ENV["VAPID_PRIVATE_KEY"] = "vapid-private-key"
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = original_public_key
+      ENV["VAPID_PRIVATE_KEY"] = original_private_key
+    end
+end
