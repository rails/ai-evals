diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..4ba56fe
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,37 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    push_subscription = PushSubscription.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    push_subscription.assign_attributes \
+      push_subscription_params.merge(user: @user, account: @user.account)
+    push_subscription.save!
+
+    head :created
+  end
+
+  def destroy
+    push_subscription = @user.push_subscriptions.find_by(id: params[:id]) ||
+      @user.push_subscriptions.find_by!(endpoint: params[:id])
+    push_subscription.destroy!
+
+    respond_to do |format|
+      format.html { head :no_content }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..e7b61a9
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,144 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "details", "button" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionUrl: String
+  }
+
+  connect() {
+    this.#hideDetails()
+    this.#refresh()
+  }
+
+  async subscribe() {
+    if (!this.#supported) {
+      this.#showDetails()
+      return
+    }
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission !== "granted") {
+        this.#showDetails()
+        this.#refresh()
+        return
+      }
+
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription() ||
+        await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+
+      await this.#saveSubscription(subscription)
+      this.#hideDetails()
+      this.#setOn(true)
+    } catch (error) {
+      console.error(error)
+      this.#showDetails()
+    }
+  }
+
+  async enable() {
+    return this.subscribe()
+  }
+
+  async toggle() {
+    return this.subscribe()
+  }
+
+  get #supported() {
+    return "Notification" in window && "PushManager" in window && "serviceWorker" in navigator
+  }
+
+  get #applicationServerKey() {
+    const key = this.vapidPublicKeyValue ||
+      document.head.querySelector("meta[name=\"vapid-public-key\"]")?.getAttribute("content")
+
+    if (!key) return undefined
+
+    const padding = "=".repeat((4 - (key.length % 4)) % 4)
+    const base64 = (key + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+
+    return outputArray
+  }
+
+  async #refresh() {
+    if (!this.#supported) return
+
+    if (Notification.permission === "denied") {
+      this.#showDetails()
+    }
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+      this.#setOn(Boolean(subscription) && Notification.permission === "granted")
+    } catch (error) {
+      this.#setOn(false)
+    }
+  }
+
+  async #saveSubscription(subscription) {
+    const subscriptionJson = subscription.toJSON()
+    const p256dh = subscriptionJson.keys?.p256dh || this.#keyAsBase64(subscription.getKey("p256dh"))
+    const auth = subscriptionJson.keys?.auth || this.#keyAsBase64(subscription.getKey("auth"))
+    const url = this.subscriptionUrlValue ||
+      `/users/${window.Current?.user?.id}/push_subscriptions`
+    const csrfToken = document.head.querySelector("meta[name=\"csrf-token\"]")?.getAttribute("content")
+
+    const response = await fetch(url, {
+      method: "POST",
+      credentials: "same-origin",
+      headers: {
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+        "X-CSRF-Token": csrfToken
+      },
+      body: JSON.stringify({
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: p256dh,
+          auth_key: auth
+        }
+      })
+    })
+
+    if (!response.ok) throw new Error(`Failed to save push subscription: ${response.status}`)
+  }
+
+  #keyAsBase64(key) {
+    if (!key) return null
+
+    return btoa(String.fromCharCode(...new Uint8Array(key)))
+      .replace(/\+/g, "-")
+      .replace(/\//g, "_")
+      .replace(/=+$/, "")
+  }
+
+  #setOn(on) {
+    this.element.classList.toggle("notifications--on", on)
+
+    if (this.hasButtonTarget) {
+      this.buttonTarget.hidden = on
+    }
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach((element) => { element.hidden = true })
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach((element) => { element.hidden = false })
+  }
+}
