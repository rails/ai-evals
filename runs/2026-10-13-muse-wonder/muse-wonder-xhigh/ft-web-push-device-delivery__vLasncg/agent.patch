+require "test_helper"
+
+class Notification::PushNotificationsTest < ActiveSupport::TestCase
+  test "creating a notification pushes to the user's subscriptions" do
+    kevin = users(:kevin)
+    kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    notifications(:layout_commented_kevin).destroy
+
+    payloads = []
+    WebPush.stubs(:payload_send).with { |**kwargs| payloads << kwargs; true }
+
+    notification = nil
+    perform_enqueued_jobs do
+      notification = Notification.create!(
+        user: kevin,
+        source: events(:layout_commented),
+        creator: users(:david)
+      )
+    end
+
+    assert_equal 1, payloads.size
+
+    payload = JSON.parse(payloads.first[:message])
+    assert_equal notification.push_title, payload["title"]
+    assert_equal notification.push_body, payload["body"]
+    assert_equal notification.push_url, payload["url"]
+    assert_includes payload["url"], "/cards/#{notification.card.number}"
+  end
+
+  test "push title and body match the tray for events" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_equal "RE: Layout is broken", notification.push_title
+    assert_equal "The text is overflowing the container.", notification.push_body
+  end
+
+  test "push title and body match the tray for mentions" do
+    notification = notifications(:logo_mentioned_david)
+
+    assert_equal "JZ @mentioned you", notification.push_title
+    assert_equal mentions(:logo_comment_david_mention_by_jz).source.mentionable_content.truncate(200), notification.push_body
+    assert_includes notification.push_url, "/cards/#{notification.card.number}"
+  end
+
+  test "updating a notification with a new source pushes again" do
+    kevin = users(:kevin)
+    kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    notification = notifications(:layout_commented_kevin)
+
+    payloads = []
+    WebPush.stubs(:payload_send).with { |**kwargs| payloads << kwargs; true }
+
+    perform_enqueued_jobs do
+      notification.update!(source: events(:layout_published), creator: users(:david), read_at: nil)
+    end
+
+    assert_equal 1, payloads.size
+  end
+
+  test "marking a notification as read does not push" do
+    kevin = users(:kevin)
+    kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    notification = notifications(:layout_commented_kevin)
+
+    WebPush.expects(:payload_send).never
+
+    perform_enqueued_jobs do
+      notification.read
+    end
+  end
+
+  test "notifications are not pushed when the user has no subscriptions" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(
+        user: users(:kevin),
+        source: events(:layout_commented),
+        creator: users(:david)
+      )
+    end
+  end
+end
