diff --git a/app/models/picture.rb b/app/models/picture.rb
index 9bcf18f..0fe7324 100644
--- a/app/models/picture.rb
+++ b/app/models/picture.rb
@@ -2,7 +2,12 @@ class Picture < ApplicationRecord
   include Leafable
 
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    # The format must be a String, not a Symbol: the variant processed by
+    # the background job must have the same variation digest as the one
+    # rebuilt from the signed representation URL when a reader requests
+    # it (which decodes format as "webp"). A Symbol would digest
+    # differently, causing the image to be processed and stored again.
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..599cae5 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class PicturesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -38,4 +40,39 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "reader fetch reuses the variant processed in the background" do
+    leaf = leaves(:reading_picture)
+
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: {
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+      }
+    end
+    assert_response :no_content
+
+    blob = leaf.reload.picture.image.blob
+    assert_equal 1, blob.variant_records.count
+    expected = blob.variant_records.first.image.blob.download
+
+    get book_slug_path(books(:handbook))
+    assert_response :success
+
+    picture_url = response.body.scan(/<img[^>]+src="([^"]+)"/).flatten
+      .find { |src| src.include?("representations") }
+    assert picture_url
+
+    transforms = 0
+    counter = ->(*args) { transforms += 1 }
+    ActiveSupport::Notifications.subscribed(counter, "transform.active_storage") do
+      get picture_url
+      assert_response :redirect
+      get response.headers["Location"]
+    end
+
+    assert_response :success
+    assert_equal 0, transforms
+    assert_equal 1, blob.variant_records.reload.count
+    assert_equal expected, response.body
+  end
 end
