@@ -0,0 +1,26 @@
+class AddTenants < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    if select_value("SELECT COUNT(*) FROM users").to_i.positive? || select_value("SELECT COUNT(*) FROM books").to_i.positive?
+      now = Time.current.utc.strftime("%Y-%m-%d %H:%M:%S")
+      execute ActiveRecord::Base.sanitize_sql_array([ "INSERT INTO tenants (name, created_at, updated_at) VALUES (?, ?, ?)", "Default", now, now ])
+      tenant_id = select_value("SELECT id FROM tenants ORDER BY id DESC LIMIT 1").to_i
+
+      execute "UPDATE users SET tenant_id = #{tenant_id}"
+      execute "UPDATE books SET tenant_id = #{tenant_id}"
+    end
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+    drop_table :tenants
+  end
+end
