index d9e383c..736083c 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -1,6 +1,7 @@
 require "test_helper"
 
 class LeafablesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
   setup do
     sign_in :kevin
   end
@@ -117,4 +118,42 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "being edited indicator is broadcast only to current editors on their own streams" do
+    leaf = leaves(:welcome_page)
+    book = leaf.book
+    removed_editor = users(:jason)
+
+    # The removed editor may still have an editor open, subscribed to the
+    # stream it was given while it still had access.
+    removed_stream = stream_name_for(leaf, removed_editor)
+    book.accesses.where(user: removed_editor).delete_all
+
+    put leafable_path(leaf), params: { leaf: { title: "Better welcome" }, page: { body: "With even more interesting words." } }
+    assert_response :no_content
+
+    streams = enqueued_jobs.select { |job| job[:job] == Turbo::Streams::BroadcastJob }.map { |job| job[:args].first }
+    assert_includes streams, stream_name_for(leaf, users(:kevin))
+    assert_includes streams, stream_name_for(leaf, users(:david))
+    assert_not_includes streams, removed_stream
+    assert_not_includes streams, stream_name_for(leaf, users(:jz))
+    assert_not_includes streams, Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited ])
+  end
+
+  test "edit page subscribes to the being edited stream for the current user only" do
+    leaf = leaves(:welcome_page)
+
+    get edit_leafable_path(leaf)
+    assert_response :success
+
+    signed_stream_name = response.body[/signed-stream-name="([^"]+)"/, 1]
+    assert signed_stream_name
+    decoded_stream_name = Turbo.signed_stream_verifier.verified(CGI.unescapeHTML(signed_stream_name))
+    assert_equal stream_name_for(leaf, users(:kevin)), decoded_stream_name
+  end
+
+  private
+    def stream_name_for(leaf, user)
+      Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited, user ])
+    end
 end
