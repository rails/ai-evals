diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..1aa82e1 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,36 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :remember_publication_change, if: :saved_change_to_published?
+    after_commit :announce_publication
+    after_rollback :forget_publication_change
   end
 
   private
+    # Record the transition as it happens: a later save in the same
+    # transaction (e.g. adding a page touches the book) overwrites
+    # saved_changes, so saved_change_to_published? can no longer be
+    # trusted by commit time. Announce only if the book was not live
+    # before this transaction and is live when the change is made.
+    def remember_publication_change
+      unless @publication_change_tracked
+        @publication_change_tracked = true
+        @published_before_change = published_before_last_save
+      end
+
+      @became_published = !@published_before_change && published?
+    end
+
     def announce_publication
-      AnnouncePublicationJob.perform_later self
+      became_published = !!@became_published
+      forget_publication_change
+
+      AnnouncePublicationJob.perform_later self if became_published
+    end
+
+    def forget_publication_change
+      @became_published = false
+      @publication_change_tracked = false
+      @published_before_change = nil
     end
 end
