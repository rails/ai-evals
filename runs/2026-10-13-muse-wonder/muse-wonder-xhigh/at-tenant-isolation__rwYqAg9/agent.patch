index 0000000..36c1313
--- /dev/null
+++ b/db/migrate/20261013140300_add_tenants.rb
@@ -0,0 +1,32 @@
+class AddTenants < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    # Sweep every pre-existing user and book into a single tenant so
+    # running installs upgrade in place.
+    tenant_id = nil
+    if table_exists?(:users) && table_exists?(:books)
+      # Use raw SQL so the migration does not depend on application models.
+      tenant_id = execute("SELECT id FROM tenants LIMIT 1").first&.dig("id")
+      unless tenant_id
+        now = Time.current.utc.strftime("%Y-%m-%d %H:%M:%S")
+        execute "INSERT INTO tenants (name, created_at, updated_at) VALUES ('Default', #{quote(now)}, #{quote(now)})"
+        tenant_id = execute("SELECT id FROM tenants ORDER BY id LIMIT 1").first&.dig("id")
+      end
+      execute "UPDATE users SET tenant_id = #{Integer(tenant_id)} WHERE tenant_id IS NULL"
+      execute "UPDATE books SET tenant_id = #{Integer(tenant_id)} WHERE tenant_id IS NULL"
+    end
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+    drop_table :tenants
+  end
+end
