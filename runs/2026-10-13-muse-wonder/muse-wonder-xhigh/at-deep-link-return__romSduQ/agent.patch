@@ -30,4 +30,44 @@ class SessionsController < ApplicationController
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
     end
+
+    # Only allow redirects back to this application. Absolute URLs are
+    # accepted only when they point at the current host, and they are
+    # reduced to a local path so the redirect can never leave the site.
+    # Anything else (external hosts, protocol-relative or backslash
+    # tricks, non-HTTP schemes, control characters, non-string values,
+    # malformed URLs, ...) falls back to the default post-auth URL.
+    def safe_return_to_url
+      return unless params[:return_to].is_a?(String)
+
+      candidate = params[:return_to].gsub(/\A[\x00-\x20\x7f]+|[\x00-\x20\x7f]+\z/, "")
+      return if candidate.empty?
+      return if candidate.match?(/[\x00-\x20\x7f\\]/)
+
+      uri = URI.parse(candidate)
+
+      if uri.host.present?
+        return unless uri.scheme.nil? || uri.scheme.match?(/\Ahttps?\z/i)
+        return unless request.host.present? && uri.host.downcase == request.host.downcase
+
+        path = uri.path.presence || "/"
+        return unless local_path?(path)
+
+        path = path.dup
+        path << "?#{uri.query}" if uri.query.present?
+        path << "##{uri.fragment}" if uri.fragment.present?
+        path
+      else
+        return if uri.scheme.present?
+        return unless local_path?(candidate)
+
+        candidate
+      end
+    rescue URI::InvalidURIError, URI::InvalidComponentError
+      nil
+    end
+
+    def local_path?(value)
+      value.start_with?("/") && !value.start_with?("//")
+    end
 end
