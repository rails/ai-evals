@@ -72,6 +72,52 @@ class UsersControllerTest < ActionDispatch::IntegrationTest
     assert_nil User.active.find_by(id: users(:kevin).id)
   end
 
+  test "destroy erases the user and their private content but preserves everyone-access books" do
+    sign_in :david
+    kevin = users(:kevin)
+
+    private_book = Book.create!(title: "Kevin Private", author: kevin.name, everyone_access: false, creator_id: kevin.id)
+    private_leaf = private_book.press(Page.new(body: "kevinprivateterm"), title: "Private page")
+    shared_book = Book.create!(title: "Kevin Shared", author: kevin.name, everyone_access: true, creator_id: kevin.id)
+    shared_leaf = shared_book.press(Page.new(body: "kevinsharedterm"), title: "Shared page")
+    ReadingMark.remember(private_leaf, user: kevin)
+    kevin.sessions.create!(user_agent: "Test", ip_address: "127.0.0.1")
+    Leaf.reindex_all
+
+    delete user_path(kevin)
+
+    assert_redirected_to users_url
+    assert_not User.exists?(kevin.id)
+    assert_not Session.exists?(user_id: kevin.id)
+    assert_not Access.exists?(user_id: kevin.id)
+    assert_not ReadingMark.exists?(user_id: kevin.id)
+    assert_not SignInEvent.exists?(email_address: kevin.email_address)
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_empty Leaf.search("kevinprivateterm").to_a
+
+    assert Book.exists?(shared_book.id)
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+    assert Leaf.exists?(shared_leaf.id)
+  end
+
+  test "destroy erases a previously deactivated user including sign-in events under their original email" do
+    sign_in :david
+    jz = users(:jz)
+    original_email = jz.email_address
+    SignInEvent.create!(action: :signed_in, email_address: original_email)
+    jz.deactivate
+
+    delete user_path(jz)
+
+    assert_redirected_to users_url
+    assert_not User.exists?(jz.id)
+    assert_not SignInEvent.exists?(email_address: original_email)
+    assert_not SignInEvent.exists?(email_address: jz.email_address)
+  end
+
