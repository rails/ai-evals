diff --git a/app/models/leaf/editable.rb b/app/models/leaf/editable.rb
index d00f2a6..3ef0311 100644
--- a/app/models/leaf/editable.rb
+++ b/app/models/leaf/editable.rb
@@ -4,6 +4,8 @@ module Leaf::Editable
   MINIMUM_TIME_BETWEEN_VERSIONS = 10.minutes
 
   included do
+    before_destroy :destroy_edit_history_leafables
+
     has_many :edits, dependent: :delete_all
 
     after_update :record_moved_to_trash, if: :was_trashed?
@@ -18,6 +20,19 @@ module Leaf::Editable
   end
 
   private
+    # Edits hold previous versions of the leafable. They are removed
+    # with delete_all (above), which would orphan those leafables --
+    # trashed edits point at the current leafable, so only destroy
+    # leafables that aren't the leaf's current one (that one is
+    # destroyed along with the leaf itself).
+    def destroy_edit_history_leafables
+      edits.find_each do |edit|
+        next if edit.leafable_type == leafable_type && edit.leafable_id == leafable_id
+
+        edit.leafable&.destroy!
+      end
+    end
+
     def record_new_edit?(leafable_params)
       will_change_leafable?(leafable_params) && last_edit_old?
     end
diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..96176bd 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -10,6 +10,13 @@ class User < ApplicationRecord
 
   after_create :grant_access_to_everyone_books
 
+  # Erasure must run before the dependent: :destroy associations above:
+  # everyone-access books are detached (not destroyed), private created
+  # books are destroyed, and sessions are removed without triggering the
+  # sign-in/out audit log (which would recreate personal data).
+  before_destroy :erase_created_books_and_sessions, prepend: true
+  after_destroy :erase_sign_in_events
+
   scope :active, -> { where(active: true) }
   scope :ordered, -> { order(:name) }
 
@@ -24,7 +31,61 @@ class User < ApplicationRecord
     end
   end
 
+  # GDPR erasure: removes the user and everything personally associated
+  # with them. See +erase_created_books_and_sessions+ and
+  # +erase_sign_in_events+ for the associated records. Books shared with
+  # everyone survive, anonymised as "Deleted author".
+  def erase!
+    destroy!
+  end
+
   private
+    def erase_created_books_and_sessions
+      # Sessions record a signed_out SignInEvent when destroyed via
+      # callbacks, so remove them without callbacks. Any events that do
+      # get recorded are removed in erase_sign_in_events (after_destroy).
+      sessions.delete_all
+
+      reading_marks.delete_all
+
+      created_books.find_each do |book|
+        if book.everyone_access?
+          book.update_columns(creator_id: nil, author: "Deleted author", updated_at: Time.current)
+        else
+          leaf_ids = book.leaves.ids
+          book.destroy!
+          remove_leaves_from_search_index(leaf_ids)
+        end
+      end
+    end
+
+    def erase_sign_in_events
+      SignInEvent.where(email_address: sign_in_email_addresses).delete_all
+    end
+
+    # Sign-in events are keyed only by email address. A user who was
+    # previously deactivated had their address rewritten to
+    # "alice-deactivated-<uuid>@example.com", while their sign-in events
+    # remain under the address they actually signed in with
+    # ("alice@example.com"). Reconstruct that original address so those
+    # events are erased too.
+    def sign_in_email_addresses
+      addresses = [ email_address ]
+      address = email_address
+      while address =~ /\A(.+)-deactivated-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}@(.+)\z/
+        address = "#{$1}@#{$2}"
+        addresses << address
+      end
+      addresses.compact_blank.uniq
+    end
+
+    def remove_leaves_from_search_index(leaf_ids)
+      return if leaf_ids.empty?
+
+      ids = leaf_ids.map(&:to_i).join(", ")
+      self.class.connection.execute("delete from leaf_search_index where rowid in (#{ids})")
+    end
+
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
