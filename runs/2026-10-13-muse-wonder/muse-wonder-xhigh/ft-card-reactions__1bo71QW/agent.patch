+module Reactable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :reactions, -> { order(:created_at) }, as: :reactable, dependent: :delete_all
+  end
+
+  def boosts
+    reactions
+  end
+
+  def boost_count
+    reactions.size
+  end
+  alias_method :boosts_count, :boost_count
+  alias_method :reactions_count, :boost_count
+end
