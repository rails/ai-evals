@@ -0,0 +1,37 @@
+class SearchesController < ApplicationController
+  def show
+    set_search_results
+  end
+
+  def index
+    set_search_results
+    render :show
+  end
+
+  private
+    def set_search_results
+      @query = search_query
+      @search_terms = Card.search_terms(@query)
+      @cards = matching_cards
+    end
+
+    def search_query
+      query = params[:q] || params[:query] || params[:term]
+      query = query.first if query.is_a?(Array)
+
+      query.to_s.strip
+    end
+
+    def matching_cards
+      if @search_terms.any?
+        Current.user.accessible_cards
+          .published
+          .search(@search_terms)
+          .reverse_chronologically
+          .preload(:board, :creator, :rich_text_description, comments: :rich_text_body)
+          .select { |card| card.matches_search_terms?(@search_terms) }
+      else
+        []
+      end
+    end
+end
