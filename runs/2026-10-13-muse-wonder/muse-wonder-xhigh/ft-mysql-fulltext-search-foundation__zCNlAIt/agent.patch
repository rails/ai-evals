+module SearchesHelper
+  def highlighted_search_text(text, terms)
+    text = text.to_s
+    phrases = Card.search_terms(terms).sort_by { |phrase| -phrase.length }
+
+    if phrases.any? && text.present?
+      highlighted = +""
+      downcased_text = text.downcase
+      offset = 0
+
+      while offset < text.length
+        match_index, match_phrase = next_search_match(downcased_text, phrases, offset)
+
+        break unless match_index
+
+        highlighted << ERB::Util.html_escape(text[offset...match_index])
+        highlighted << "<mark>"
+        highlighted << ERB::Util.html_escape(text[match_index, match_phrase.length])
+        highlighted << "</mark>"
+        offset = match_index + match_phrase.length
+      end
+      highlighted << ERB::Util.html_escape(text[offset..] || "")
+
+      highlighted.html_safe
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  private
+    def next_search_match(downcased_text, phrases, offset)
+      phrases
+        .filter_map do |phrase|
+          index = downcased_text.index(phrase.downcase, offset)
+          [ index, phrase ] if index
+        end
+        .min_by { |index, phrase| [ index, -phrase.length ] }
+    end
+end
