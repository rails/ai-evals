--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,111 @@
+# Single-server deployment for self-hosted Fizzy.
+#
+# This deploys everything to one Linux server running Docker:
+# one web container (background jobs run inside it via Solid Queue in
+# Puma), SQLite databases and uploaded files on a persistent volume,
+# and HTTPS via kamal-proxy's automatic Let's Encrypt certificates.
+#
+# To use it, replace every placeholder marked below, export the secrets
+# referenced by .kamal/secrets, then run:
+#
+#   bin/kamal setup
+#
+# See docs/deployment.md for the full walkthrough.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image. With the local registry below this does
+# not need to belong to any external registry account.
+image: fizzy
+
+# Deploy to these servers.
+#
+# Replace this with the IP address (or SSH hostname) of your server.
+# The public hostname below (proxy.host / APP_HOST) must resolve to it.
+servers:
+  web:
+    - 192.168.0.1
+
+# Enable SSL auto certification via Let's Encrypt.
+#
+# Replace this with the public hostname for your installation, e.g.
+# fizzy.your-domain.com. DNS for it must point at the server above and
+# ports 80 and 443 must be reachable from the internet.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Use a registry served from your own machine and tunnelled to the
+# server, so no Docker Hub / GHCR / other registry account is needed
+# for a single-box deployment. Kamal starts it during `kamal setup`.
+registry:
+  server: localhost:5555
+
+# Configure the builder. Change to arm64 if your server is ARM-based.
+builder:
+  arch: amd64
+
+# Bridge fingerprinted assets between versions to avoid 404s on
+# in-flight requests during a deploy.
+asset_path: /rails/public/assets
+
+# Give the app (and its first-boot database preparation) time to come up.
+deploy_timeout: 60
+
+# Inject ENV variables into the container. Secrets (see below) come
+# from .kamal/secrets; do not put real secret values in this file.
+env:
+  clear:
+    RAILS_ENV: production
+
+    # Public hostname of this installation. Must match proxy.host above:
+    # it is used for links in emails (including sign-in links), for the
+    # URLs the app generates outside a request, and as the default SMTP
+    # domain.
+    APP_HOST: fizzy.example.com
+
+    # Your mail server. Fizzy signs people in with emailed links, so a
+    # working SMTP server is required. Replace these with your provider's
+    # settings; see docs/deployment.md if yours needs different options.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: fizzy.example.com
+    SMTP_USERNAME: fizzy@example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+
+    # Data stays in SQLite on the volume below (this is also the app's
+    # default when not running the SaaS bundle), and background jobs --
+    # including recurring jobs -- run inside the web container via the
+    # Solid Queue Puma plugin, rather than in a second container that
+    # would contend for the same SQLite files.
+    DATABASE_ADAPTER: sqlite
+    SOLID_QUEUE_IN_PUMA: "true"
+  secret:
+    # Generated/exported as described in .kamal/secrets and
+    # docs/deployment.md. SMTP_PASSWORD is the password for
+    # SMTP_USERNAME; the VAPID pair enables web push notifications.
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Persistent storage: all SQLite databases (primary, cable, cache and
+# queue) live in /rails/storage, and local Active Storage files live in
+# /rails/storage/production/files, so this one volume is what makes
+# your data survive the next deploy. Do not remove it unless you want
+# to start over.
+volumes:
+  - "fizzy:/rails/storage"
+
+# The SSH user Kamal connects (and installs Docker) as. Change to your
+# server's sudo-capable user (e.g. ubuntu or debian) if it is not root.
+ssh:
+  user: root
+
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+  shell: app exec -i --reuse /bin/bash
+  logs: app logs -f
diff --git a/config/environments/production.rb b/config/environments/production.rb
