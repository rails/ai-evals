--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -76,6 +76,37 @@ Rails.application.configure do
 
   config.action_mailer.perform_caching = false
 
+  # Self-hosted deployments (see config/deploy.yml) configure their public
+  # host and mail server through the environment. The hosted SaaS sets
+  # neither of these, and overrides both in its own environment config.
+  app_host = ENV["APP_HOST"].presence || ENV["APP_FQDN"].presence
+  app_host = app_host&.sub(%r{\Ahttps?://}i, "")&.split("/")&.first
+
+  if app_host.present?
+    config.action_controller.default_url_options = { host: app_host, protocol: "https" }
+    config.action_mailer.default_url_options = { host: app_host, protocol: "https" }
+  end
+
+  smtp_address = ENV["SMTP_ADDRESS"].presence || ENV["SMTP_HOST"].presence
+
+  if smtp_address.present?
+    smtp_username = ENV["SMTP_USERNAME"].presence || ENV["SMTP_USER_NAME"].presence || ENV["SMTP_USER"].presence
+    smtp_authentication = ENV["SMTP_AUTHENTICATION"].presence
+    smtp_authentication ||= "plain" if smtp_username.present?
+    smtp_starttls = ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO") { ENV.fetch("SMTP_STARTTLS", "true") }
+
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: smtp_address,
+      port: Integer(ENV.fetch("SMTP_PORT", 587)),
+      domain: ENV["SMTP_DOMAIN"].presence || ENV["SMTP_HELO_DOMAIN"].presence || app_host,
+      user_name: smtp_username,
+      password: ENV["SMTP_PASSWORD"],
+      authentication: smtp_authentication&.to_sym,
+      enable_starttls_auto: smtp_starttls.to_s.match?(/\A(true|1|yes)\z/i)
+    }.compact
+  end
+
   # Ignore bad email addresses and do not raise email delivery errors.
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
