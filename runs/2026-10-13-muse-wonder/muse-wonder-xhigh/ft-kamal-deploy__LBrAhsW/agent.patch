@@ -0,0 +1,21 @@
+# Secrets for the single-server deployment in config/deploy.yml.
+#
+# Kamal reads the names listed under env.secret (and any registry or
+# builder secrets) from here. Every value below is pulled from your
+# local environment, so no real credential ever lives in this file and
+# it is safe to commit. Export the variables before running Kamal, e.g.:
+#
+#   export SECRET_KEY_BASE=$(bin/rails secret)
+#   export SMTP_PASSWORD='your-smtp-password'
+#   export VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=...   # see docs/deployment.md
+#   bin/kamal setup
+#
+# Alternatively, replace any line with a lookup in your password
+# manager using `kamal secrets fetch` / `kamal secrets extract`
+# (see `bin/kamal secrets --help`). Do not paste raw credentials here
+# and commit them.
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+SMTP_PASSWORD=$SMTP_PASSWORD
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
