diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..ffc588c 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,52 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "destroy erases the user and their personal records" do
+    user = users(:kevin)
+    user.sessions.start!(user_agent: "Test", ip_address: "127.0.0.1")
+    SignInEvent.create!(action: "signed_in", email_address: user.email_address)
+    ReadingMark.remember(leaves(:welcome_page), user: user)
+
+    user.destroy
+
+    assert_not User.exists?(user.id)
+    assert_equal 0, Session.where(user_id: user.id).count
+    assert_equal 0, Access.where(user_id: user.id).count
+    assert_equal 0, ReadingMark.where(user_id: user.id).count
+    assert_equal 0, SignInEvent.where(email_address: user.email_address).count
+  end
+
+  test "destroy preserves everyone books anonymised and destroys other created books" do
+    user = users(:kevin)
+    shared_book = Book.create!(title: "Shared", author: user.name, everyone_access: true, creator: user)
+    private_book = Book.create!(title: "Private", author: user.name, everyone_access: false, creator: user)
+    page = Page.new
+    page.body = "erasure search token"
+    leaf = private_book.press(page, title: "Private page")
+    Leaf.reindex_all
+
+    user.destroy
+
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(leaf.id)
+    assert_empty Leaf.search("erasure")
+  end
+
+  test "destroy erases sign-in events recorded under the original address of a deactivated user" do
+    user = users(:kevin)
+    original_address = user.email_address
+    SignInEvent.create!(action: "signed_in", email_address: original_address)
+    user.deactivate
+    SignInEvent.create!(action: "signed_in", email_address: user.email_address)
+
+    user.destroy
+
+    assert_not User.exists?(user.id)
+    assert_equal 0, SignInEvent.where(email_address: original_address).count
+    assert_equal 0, SignInEvent.where(email_address: user.email_address).count
+  end
 end
