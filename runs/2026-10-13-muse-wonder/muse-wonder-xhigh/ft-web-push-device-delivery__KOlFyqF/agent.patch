+require "test_helper"
+
+class Notifications::PushSettingsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as users(:david)
+  end
+
+  test "notification settings include push subscription controls" do
+    with_vapid_public_key do
+      get notifications_settings_path
+
+      assert_response :success
+      assert_select "[data-controller='notifications']"
+      assert_select "[data-notifications-vapid-public-key-value='#{ENV["VAPID_PUBLIC_KEY"]}']"
+      assert_match user_push_subscriptions_path(users(:david)), response.body
+      assert_match "notifications__on-message", response.body
+      assert_match "notifications__off-message", response.body
+      assert_match "Turn on notifications", response.body
+    end
+  end
+
+  private
+    def with_vapid_public_key
+      old = ENV["VAPID_PUBLIC_KEY"]
+      ENV["VAPID_PUBLIC_KEY"] = "test-public-key"
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = old
+    end
+end
