+self.addEventListener("push", (event) => {
+  let notification = {}
+
+  if (event.data) {
+    try {
+      notification = event.data.json()
+    } catch {
+      notification = { title: "Fizzy", body: event.data.text() }
+    }
+  }
+
+  const title = notification.title || "Fizzy"
