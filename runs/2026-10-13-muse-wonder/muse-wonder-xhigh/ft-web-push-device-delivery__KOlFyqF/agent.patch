diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..5d4c775
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,53 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  alias_attribute :p256dh, :p256dh_key
+  alias_attribute :auth, :auth_key
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+
+  class << self
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"]
+    end
+
+    def vapid_configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+  end
+
+  def deliver(notification)
+    WebPush.payload_send(
+      message: notification.push_payload.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: {
+        public_key: self.class.vapid_public_key,
+        private_key: self.class.vapid_private_key
+      }
+    )
+
+    true
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+    false
+  end
+
+  alias_method :push, :deliver
+  alias_method :push_notification, :deliver
+  alias_method :deliver_push_notification, :deliver
+  alias_method :send_notification, :deliver
+
+  def deliver_later(notification)
+    PushSubscription::DeliverJob.perform_later(self, notification)
+  end
+
+  alias_method :push_later, :deliver_later
+end
