diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..7de60e6
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/1",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "deliver sends the tray title and body and a link to the card via WebPush" do
+    with_vapid_keys do
+      captured = nil
+      WebPush.stubs(:payload_send).with { |**kwargs| captured = kwargs; true }
+
+      assert @subscription.deliver(@notification)
+
+      assert_equal @subscription.endpoint, captured[:endpoint]
+      assert_equal "p256dh-key", captured[:p256dh]
+      assert_equal "auth-key", captured[:auth]
+      assert_equal ENV["VAPID_PUBLIC_KEY"], captured[:vapid][:public_key]
+      assert_equal ENV["VAPID_PRIVATE_KEY"], captured[:vapid][:private_key]
+
+      payload = JSON.parse(captured[:message])
+      assert_equal @notification.title, payload["title"]
+      assert_equal @notification.body, payload["body"]
+      assert_equal @notification.url, payload["url"]
+      assert_includes payload["url"], "/cards/#{@notification.card.number}"
+    end
+  end
+
+  test "deliver removes subscriptions the push service reports as expired" do
+    response = stub(body: "Gone", inspect: "#<Net::HTTPGone 410>")
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.com"))
+
+    assert_no_difference -> { Notification.count } do
+      assert_not @subscription.deliver(@notification)
+    end
+    assert_not PushSubscription.exists?(@subscription.id)
+  end
+
+  test "creating a notification pushes to the user's subscriptions" do
+    @user.push_subscriptions.delete_all
+    @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/2",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    WebPush.expects(:payload_send).once
+
+    perform_enqueued_jobs do
+      @user.notifications.create!(source: events(:layout_published), creator: users(:jz))
+    end
+  end
+
+  test "updating a notification with a new source pushes again, reading it does not" do
+    notification = nil
+    WebPush.expects(:payload_send).once
+    perform_enqueued_jobs do
+      notification = @user.notifications.create!(source: events(:layout_published), creator: users(:jz))
+    end
+
+    WebPush.expects(:payload_send).once
+    perform_enqueued_jobs do
+      notification.update!(source: events(:layout_assignment_jz), creator: users(:jz), read_at: nil)
+    end
+
+    WebPush.expects(:payload_send).never
+    perform_enqueued_jobs do
+      notification.read
+    end
+  end
+
+  test "notifications created by the notifier push to the recipient's subscriptions" do
+    kevin = users(:kevin)
+    kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    notifications(:layout_commented_kevin).destroy
+
+    WebPush.expects(:payload_send).once
+
+    perform_enqueued_jobs do
+      Notifier.for(events(:layout_commented)).notify
+    end
+  end
+
+  private
+    def with_vapid_keys
+      old_public, old_private = ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"]
+      key = WebPush.generate_key
+      ENV["VAPID_PUBLIC_KEY"] = key.public_key
+      ENV["VAPID_PRIVATE_KEY"] = key.private_key
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = old_public
+      ENV["VAPID_PRIVATE_KEY"] = old_private
+    end
+end
