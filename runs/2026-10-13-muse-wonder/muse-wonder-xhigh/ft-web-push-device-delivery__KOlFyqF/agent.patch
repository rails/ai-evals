diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..9f927b7
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,66 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @push_subscription.assign_attributes(push_subscription_params)
+    @push_subscription.save!
+
+    respond_to do |format|
+      format.html { head :created }
+      format.json do
+        render json: {
+          id: @push_subscription.id,
+          endpoint: @push_subscription.endpoint,
+          p256dh_key: @push_subscription.p256dh_key,
+          auth_key: @push_subscription.auth_key,
+          created_at: @push_subscription.created_at&.utc,
+          updated_at: @push_subscription.updated_at&.utc
+        }, status: :created
+      end
+    end
+  end
+
+  def destroy
+    push_subscription.destroy! if push_subscription
+
+    respond_to do |format|
+      format.html { head :no_content }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription
+      @push_subscription ||= begin
+        if params[:id].present?
+          @user.push_subscriptions.find_by(id: params[:id]) || @user.push_subscriptions.find_by(endpoint: params[:id])
+        elsif push_subscription_endpoint.present?
+          @user.push_subscriptions.find_by(endpoint: push_subscription_endpoint)
+        end
+      end
+    end
+
+    def push_subscription_endpoint
+      if params[:push_subscription].is_a?(ActionController::Parameters) || params[:push_subscription].is_a?(Hash)
+        params.dig(:push_subscription, :endpoint)
+      else
+        params[:endpoint]
+      end
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..2b6ff82
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,185 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details" ]
+  static classes = [ "on" ]
+  static values = {
+    vapidPublicKey: String,
+    publicKey: String,
+    url: String,
+    createUrl: String,
+    subscriptionUrl: String
+  }
+
+  connect() {
+    this.refresh()
+  }
+
+  async subscribe() {
+    if (!this.supported) return
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission !== "granted") {
+        this.refresh()
+        return
+      }
+
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.applicationServerKey
+      })
+
+      await this.saveSubscription(subscription)
+      this.refresh()
+    } catch (error) {
+      console.error("Failed to subscribe to push notifications", error)
+      this.refresh()
+    }
+  }
+
+  async unsubscribe() {
+    if (!this.supported) return
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        await this.deleteSubscription(subscription)
+        await subscription.unsubscribe()
+      }
+    } catch (error) {
+      console.error("Failed to unsubscribe from push notifications", error)
+    }
+
+    this.refresh()
+  }
+
+  // Compatibility aliases for the enable/disable naming used in some views.
+  async enable() {
+    return this.subscribe()
+  }
+
+  async disable() {
+    return this.unsubscribe()
+  }
+
+  async toggle() {
+    const subscription = await this.currentSubscription()
+
+    if (subscription) {
+      return this.unsubscribe()
+    } else {
+      return this.subscribe()
+    }
+  }
+
+  async refresh() {
+    if (!this.supported) {
+      this.showDetails()
+      return
+    }
+
+    const subscription = await this.currentSubscription()
+    const enabled = Boolean(subscription) && Notification.permission === "granted"
+
+    if (enabled) {
+      try {
+        await this.saveSubscription(subscription)
+      } catch (error) {
+        console.error("Failed to save push subscription", error)
+      }
+    }
+
+    this.element.classList.toggle("notifications--on", enabled)
+    if (this.hasOnClass) this.element.classList.toggle(this.onClass, enabled)
+
+    if (Notification.permission === "denied") {
+      this.showDetails()
+    } else {
+      this.hideDetails()
+    }
+  }
+
+  async currentSubscription() {
+    if (!this.supported) return null
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      return await registration.pushManager.getSubscription()
+    } catch {
+      return null
+    }
+  }
+
+  async saveSubscription(subscription) {
+    const json = subscription.toJSON()
+    const body = JSON.stringify({
+      push_subscription: {
+        endpoint: json.endpoint,
+        p256dh_key: json.keys?.p256dh,
+        auth_key: json.keys?.auth
+      }
+    })
+
+    return post(this.subscriptionUrl, { body, contentType: "application/json", responseKind: "json" })
+  }
+
+  async deleteSubscription(subscription) {
+    const json = subscription.toJSON()
+    const body = JSON.stringify({
+      push_subscription: {
+        endpoint: json.endpoint,
+        p256dh_key: json.keys?.p256dh,
+        auth_key: json.keys?.auth
+      }
+    })
+
+    return destroy(this.subscriptionUrl, { body, contentType: "application/json", responseKind: "json" })
+  }
+
+  showDetails() {
+    this.detailsTargets.forEach((element) => element.removeAttribute("hidden"))
+  }
+
+  hideDetails() {
+    this.detailsTargets.forEach((element) => element.setAttribute("hidden", "hidden"))
+  }
+
+  get supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get subscriptionUrl() {
+    if (this.hasSubscriptionUrlValue && this.subscriptionUrlValue) return this.subscriptionUrlValue
+    if (this.hasCreateUrlValue && this.createUrlValue) return this.createUrlValue
+    if (this.hasUrlValue && this.urlValue) return this.urlValue
+    return `/users/${window.Current?.user?.id}/push_subscriptions`
+  }
+
+  get vapidKey() {
+    if (this.hasVapidPublicKeyValue && this.vapidPublicKeyValue) return this.vapidPublicKeyValue
+    if (this.hasPublicKeyValue && this.publicKeyValue) return this.publicKeyValue
+    return document.head.querySelector('meta[name="vapid-public-key"]')?.getAttribute("content")
+  }
+
+  get applicationServerKey() {
+    const key = this.vapidKey
+    if (!key) return undefined
+
+    const padding = "=".repeat((4 - (key.length % 4)) % 4)
+    const base64 = (key + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+
+    return outputArray
+  }
+}
