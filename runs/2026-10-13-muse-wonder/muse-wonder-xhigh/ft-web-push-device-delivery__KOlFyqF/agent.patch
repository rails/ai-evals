diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..b625790
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create stores a push subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/1",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/subscriptions/1", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create with flat JSON params" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        endpoint: "https://push.example.com/subscriptions/flat",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create is idempotent for the same endpoint" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/1",
+      p256dh_key: "old-key",
+      auth_key: "old-auth"
+    )
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: "new-key",
+          auth_key: "new-auth"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-key", subscription.reload.p256dh_key
+  end
+
+  test "cannot create a push subscription for another user" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/2",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes a push subscription by endpoint" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/1",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: subscription.endpoint }
+      }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy removes a push subscription by id" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/1",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+end
