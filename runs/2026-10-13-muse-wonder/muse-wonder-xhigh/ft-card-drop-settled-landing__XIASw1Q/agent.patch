diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..4381b21
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,343 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  initialize() {
+    this.boundMouseMove = this.#mouseMove.bind(this)
+    this.boundMouseUp = this.#mouseUp.bind(this)
+  }
+
+  connect() {
+    document.addEventListener("mousemove", this.boundMouseMove)
+    document.addEventListener("mouseup", this.boundMouseUp)
+    document.addEventListener("pointermove", this.boundMouseMove)
+    document.addEventListener("pointerup", this.boundMouseUp)
+  }
+
+  disconnect() {
+    document.removeEventListener("mousemove", this.boundMouseMove)
+    document.removeEventListener("mouseup", this.boundMouseUp)
+    document.removeEventListener("pointermove", this.boundMouseMove)
+    document.removeEventListener("pointerup", this.boundMouseUp)
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  itemTargetDisconnected(item) {
+    item.draggable = false
+  }
+
+  // Actions
+
+  dragStart(event) {
+    const item = this.#itemFrom(event)
+    if (!item) return
+
+    // A native drag is taking over from any mouse/pointer tracking.
+    this.mouseDrag = null
+    this.draggedItem = item
+    this.sourceContainer = this.#containerFor(item)
+
+    item.classList.add(this.#draggedItemClass)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      try {
+        event.dataTransfer.setData("text/plain", item.id || "")
+      } catch {
+        // Some drag simulations provide a read-only dataTransfer.
+      }
+    }
+  }
+
+  dragEnd(event) {
+    const item = this.#itemFrom(event) || this.draggedItem
+    item?.classList.remove(this.#draggedItemClass)
+    this.#clearHover()
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  dragOver(event) {
+    const container = this.#containerFrom(event)
+    if (!container || !this.draggedItem) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    this.#highlight(container)
+  }
+
+  dragLeave(event) {
+    const container = this.#containerFrom(event)
+    if (!container) return
+
+    if (!event.relatedTarget || !container.contains(event.relatedTarget)) {
+      container.classList.remove(this.#hoverContainerClass)
+      if (this.hoverContainer === container) this.hoverContainer = null
+    }
+  }
+
+  drop(event) {
+    const container = this.#containerFrom(event)
+    if (!container) return
+
+    event.preventDefault()
+
+    const item = this.draggedItem || this.#itemFromDataTransfer(event)
+    this.#clearHover()
+    if (!item) return
+
+    item.classList.remove(this.#draggedItemClass)
+    this.#moveItem(item, container)
+  }
+
+  // Mouse/pointer fallback, for drags that never become native drags.
+  // Native drags cancel this tracking in dragStart and never deliver
+  // mouse/pointer "up" events, so the two paths cannot both move a card;
+  // #moveItem also refuses to move a card into the place it is already in.
+
+  mouseDragStart(event) {
+    if (event.button !== undefined && event.button !== 0) return
+
+    const item = this.#itemFrom(event)
+    if (!item) return
+
+    this.mouseDrag = {
+      item,
+      sourceContainer: this.#containerFor(item),
+      startX: event.clientX || 0,
+      startY: event.clientY || 0,
+      active: false
+    }
+  }
+
+  // Private
+
+  #mouseMove(event) {
+    const drag = this.mouseDrag
+    if (!drag || this.draggedItem) return
+
+    const container = this.#containerFrom(event) || this.#containerAt(event)
+
+    if (!drag.active) {
+      const moved = Math.hypot((event.clientX || 0) - drag.startX, (event.clientY || 0) - drag.startY) > 4
+      const overAnotherContainer = container && container !== drag.sourceContainer
+      if (!moved && !overAnotherContainer) return
+
+      drag.active = true
+      drag.item.classList.add(this.#draggedItemClass)
+    }
+
+    event.preventDefault?.()
+    if (container) {
+      drag.hoverContainer = container
+      this.#highlight(container)
+    } else {
+      drag.hoverContainer = null
+      this.#clearHover()
+    }
+  }
+
+  #mouseUp(event) {
+    const drag = this.mouseDrag
+    this.mouseDrag = null
+    if (!drag?.active || this.draggedItem) return
+
+    const container = this.#containerFrom(event) || this.#containerAt(event) || drag.hoverContainer
+    drag.item.classList.remove(this.#draggedItemClass)
+    this.#clearHover()
+
+    if (container && this.#moveItem(drag.item, container, drag.sourceContainer)) {
+      this.#suppressNextClick()
+    }
+  }
+
+  #containerAt(event) {
+    if (!event.clientX && !event.clientY) return null
+    return document.elementFromPoint?.(event.clientX, event.clientY)
+      ?.closest?.('[data-drag-and-drop-target~="container"]') || null
+  }
+
+  #suppressNextClick() {
+    const suppress = clickEvent => {
+      clickEvent.preventDefault()
+      clickEvent.stopPropagation()
+    }
+    document.addEventListener("click", suppress, { capture: true, once: true })
+    setTimeout(() => document.removeEventListener("click", suppress, { capture: true }), 100)
+  }
+
+  #moveItem(item, container, knownSourceContainer = null) {
+    const sourceContainer = knownSourceContainer || this.sourceContainer || this.#containerFor(item)
+    if (!sourceContainer || sourceContainer === container) return false
+    if (this.#containerFor(item) === container) return false
+
+    const move = this.#moveFor(item, container)
+    if (!move?.url) return false
+    if (move.query && !move.query.column_id) return false
+
+    // Move the card straight away, in the position the destination keeps
+    // cards in, and only then ask the server to persist the move. The
+    // request asks for JSON so its (empty) response cannot re-render the
+    // board and shift the card from where it was just left.
+    this.#applyDestinationAppearance(item, container)
+    this.#insert(item, container)
+    this.#updateCounts(sourceContainer, container)
+
+    this.#persist(move).then(response => {
+      if (response && !response.ok) this.#insertBack(item, sourceContainer)
+    }).catch(() => this.#insertBack(item, sourceContainer))
+
+    return true
+  }
+
+  #persist(move) {
+    if (move.method === "delete") {
+      return destroy(move.url, { responseKind: "json" })
+    } else if (move.query) {
+      return post(move.url, { query: move.query, responseKind: "json" })
+    } else {
+      return post(move.url, { responseKind: "json" })
+    }
+  }
+
+  #moveFor(item, container) {
+    switch (container.dataset.dragAndDropDestination) {
+      case "column":
+        return {
+          method: "post",
+          url: item.dataset.dragAndDropTriageUrl,
+          query: { column_id: container.dataset.dragAndDropColumnId }
+        }
+      case "maybe":
+        return { method: "delete", url: item.dataset.dragAndDropTriageUrl }
+      case "not_now":
+        return { method: "post", url: item.dataset.dragAndDropNotNowUrl }
+      case "closed":
+        return { method: "post", url: item.dataset.dragAndDropClosureUrl }
+      default:
+        return null
+    }
+  }
+
+  #insert(item, container) {
+    const list = container.querySelector(".cards__list")
+    if (!list) return
+
+    const reference = this.#insertionReference(item, container, list)
+    if (reference) {
+      reference.before(item)
+    } else {
+      const lastCard = this.#cardsIn(list).at(-1)
+      if (lastCard) {
+        lastCard.after(item)
+      } else {
+        list.append(item)
+      }
+    }
+  }
+
+  #insertBack(item, sourceContainer) {
+    if (item && sourceContainer && this.#containerFor(item) !== sourceContainer) {
+      this.#updateCounts(this.#containerFor(item), sourceContainer)
+      this.#applyDestinationAppearance(item, sourceContainer)
+      this.#insert(item, sourceContainer)
+    }
+  }
+
+  #applyDestinationAppearance(item, container) {
+    const destination = container.dataset.dragAndDropDestination
+
+    item.classList.toggle("card--postponed", destination === "not_now")
+    item.classList.toggle("card--active", destination === "column" || destination === "maybe")
+
+    const color = destination === "maybe"
+      ? "var(--color-card-default)"
+      : container.style.getPropertyValue("--card-color").trim()
+    if (color) item.style.setProperty("--card-color", color)
+  }
+
+  // Columns order their cards themselves (golden cards first, then most
+  // recently active first) and a move makes a card the most recently
+  // active one, so a moved card belongs at the top of its new place --
+  // after any golden cards, unless it is golden itself.
+  #insertionReference(item, container, list) {
+    const cards = this.#cardsIn(list).filter(card => card !== item)
+    if (cards.length === 0) return null
+
+    const goldenFirst = container.dataset.dragAndDropDestination === "column" ||
+      container.dataset.dragAndDropDestination === "maybe"
+
+    if (!goldenFirst || item.classList.contains("golden-effect")) {
+      return cards[0]
+    } else {
+      return cards.find(card => !card.classList.contains("golden-effect")) || null
+    }
+  }
+
+  #cardsIn(list) {
+    return [ ...list.querySelectorAll(".card") ]
+  }
+
+  #updateCounts(sourceContainer, destinationContainer) {
+    this.#updateCount(sourceContainer, -1)
+    this.#updateCount(destinationContainer, 1)
+  }
+
+  #updateCount(container, delta) {
+    const counter = container?.querySelector(".cards__expander-count")
+    if (!counter) return
+
+    const count = parseInt(counter.textContent, 10)
+    if (!Number.isNaN(count)) counter.textContent = Math.max(count + delta, 0)
+  }
+
+  #itemFrom(event) {
+    return event.target.closest?.('[data-drag-and-drop-target~="item"]')
+  }
+
+  #itemFromDataTransfer(event) {
+    try {
+      const id = event.dataTransfer?.getData("text/plain")
+      const element = id && document.getElementById(id)
+      return element?.matches('[data-drag-and-drop-target~="item"]') ? element : null
+    } catch {
+      return null
+    }
+  }
+
+  #containerFrom(event) {
+    return event.target.closest?.('[data-drag-and-drop-target~="container"]')
+  }
+
+  #containerFor(item) {
+    return item?.closest('[data-drag-and-drop-target~="container"]')
+  }
+
+  #highlight(container) {
+    if (this.hoverContainer === container) return
+
+    this.#clearHover()
+    this.hoverContainer = container
+    container.classList.add(this.#hoverContainerClass)
+  }
+
+  #clearHover() {
+    this.containerTargets.forEach(container => container.classList.remove(this.#hoverContainerClass))
+    this.hoverContainer = null
+  }
+
+  get #draggedItemClass() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverContainerClass() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+}
