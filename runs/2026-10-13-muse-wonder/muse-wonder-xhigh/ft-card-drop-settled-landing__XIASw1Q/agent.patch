diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..8652dda
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,114 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  test "dragging a card to another column moves it there straight away" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    find("#maybe .card", text: card.title).drag_to(find("##{dom_id(column)}"))
+
+    within("##{dom_id(column)}", visible: :all) do
+      assert_selector ".card", text: card.title, visible: :all
+    end
+    wait_for { card.reload.column == column }
+
+    visit board_url(boards(:writebook))
+    within("##{dom_id(column)}") { find(".cards__expander").click }
+    assert_selector ".card", text: card.title
+    first_card_title = evaluate_script("document.querySelector('##{dom_id(column)} .card .card__title').textContent.trim()")
+    assert_equal card.title, first_card_title
+  end
+
+  test "dragging a card to Done, Not Now, and back to Maybe" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    card = cards(:logo)
+    column = columns(:writebook_triage)
+
+    within("##{dom_id(column)}") { find(".cards__expander").click }
+    find("##{dom_id(column)} .card", text: card.title).drag_to(find("#closed-cards"))
+    within("#closed-cards", visible: :all) do
+      assert_selector ".card", text: card.title, visible: :all
+    end
+    wait_for { card.reload.closed? }
+
+    within("#closed-cards") { find(".cards__expander").click }
+    find("#closed-cards .card", text: card.title, visible: :all).drag_to(find("#not-now"))
+    wait_for { card.reload.postponed? }
+
+    within("#not-now") { find(".cards__expander").click }
+    find("#not-now .card", text: card.title, visible: :all).drag_to(find("#maybe"))
+    within("#maybe") do
+      assert_selector ".card", text: card.title
+    end
+    wait_for { card.reload.column.nil? && card.reload.active? }
+  end
+
+  test "dragging a card within its own column does not move it" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    card = cards(:logo)
+    column = columns(:writebook_triage)
+    last_active_at = card.last_active_at
+
+    within("##{dom_id(column)}") { find(".cards__expander").click }
+    find("##{dom_id(column)} .card", text: card.title).drag_to(find("##{dom_id(column)}"))
+
+    assert_equal column, card.reload.column
+    assert_equal last_active_at.to_i, card.reload.last_active_at.to_i
+  end
+
+  test "dragging with HTML5 drag events highlights the column under the pointer" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    card = cards(:buy_domain)
+
+    execute_script(<<~JS, card.title)
+      const title = arguments[0]
+      const card = [ ...document.querySelectorAll("#maybe .card") ].find(element => element.textContent.includes(title))
+      const destination = document.getElementById("not-now")
+      const store = {}
+      const dataTransfer = {
+        setData(key, value) { store[key] = value },
+        getData(key) { return store[key] || "" },
+        effectAllowed: "",
+        dropEffect: "",
+        setDragImage() {}
+      }
+      const dragEvent = type => {
+        const event = new Event(type, { bubbles: true, cancelable: true })
+        Object.defineProperty(event, "dataTransfer", { value: dataTransfer })
+        return event
+      }
+
+      card.dispatchEvent(dragEvent("dragstart"))
+      window.draggedClass = card.className
+      destination.dispatchEvent(dragEvent("dragover"))
+      window.hoverClass = destination.className
+      destination.dispatchEvent(dragEvent("drop"))
+      card.dispatchEvent(dragEvent("dragend"))
+    JS
+
+    assert_includes evaluate_script("window.draggedClass"), "drag-and-drop__dragged-item"
+    assert_includes evaluate_script("window.hoverClass"), "drag-and-drop__hover-container"
+    within("#not-now", visible: :all) do
+      assert_selector ".card", text: card.title, visible: :all
+    end
+    wait_for { card.reload.postponed? }
+  end
+
+  private
+    def wait_for
+      20.times do
+        return if yield
+        sleep 0.25
+      end
+      flunk "Timed out waiting for the card to be saved"
+    end
+end
