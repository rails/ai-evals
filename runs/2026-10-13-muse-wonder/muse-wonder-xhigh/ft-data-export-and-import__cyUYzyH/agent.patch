+<% @page_title = "Import" %>
+
+<div class="panel shadow center" style="--panel-size: 55ch;">
+  <div class="flex flex-column gap txt-medium">
+    <% if @import.completed? %>
+      <p>Your import is complete.</p>
+      <% if @import.imported_account %>
+        <p>Your new account <strong><%= @import.imported_account.name %></strong> is ready.</p>
+        <%= link_to "Open your new account", root_path(script_name: @import.imported_account.slug), class: "btn btn--link" %>
+      <% end %>
+    <% elsif @import.failed? %>
+      <p>Your import failed.</p>
+      <% if @import.failure_reason %>
+        <p>Reason: <%= @import.failure_reason %></p>
+      <% end %>
+    <% else %>
+      <p>Your import is being processed. We'll email you when it's done.</p>
+    <% end %>
+  </div>
+</div>
