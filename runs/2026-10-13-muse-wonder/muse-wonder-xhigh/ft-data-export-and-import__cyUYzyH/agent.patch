+        post user_exports_path(users(:david))
+      end
+    end
+
+    assert_redirected_to user_path(users(:david))
+  end
+
+  test "you cannot request an export for someone else" do
+    assert_no_difference -> { Account::Export.count } do
+      post user_exports_path(users(:kevin))
+    end
+
+    assert_response :forbidden
+  end
+end
