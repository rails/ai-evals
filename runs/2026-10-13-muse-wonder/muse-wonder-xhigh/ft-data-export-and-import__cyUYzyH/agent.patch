+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  ASSOCIATIONS = {
+    "tag_ids" => [ :tags, ::Tag ],
+    "board_ids" => [ :boards, ::Board ],
+    "assignee_ids" => [ :assignees, ::User ],
+    "creator_ids" => [ :creators, ::User ],
+    "closer_ids" => [ :closers, ::User ]
+  }.freeze
