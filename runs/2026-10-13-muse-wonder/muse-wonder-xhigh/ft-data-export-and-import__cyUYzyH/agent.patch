diff --git a/app/models/account/data_transfer/transfer_context.rb b/app/models/account/data_transfer/transfer_context.rb
new file mode 100644
index 0000000..65a53c8
--- /dev/null
+++ b/app/models/account/data_transfer/transfer_context.rb
@@ -0,0 +1,88 @@
+class Account::DataTransfer::TransferContext
+  attr_reader :reader, :id_map, :global_id_map, :blob_keys_by_old_key, :blob_keys_by_old_id, :created_blob_keys
+  attr_accessor :account
+
+  def initialize(reader = nil, account: nil)
+    @reader = reader
+    @account = account
+    @id_map = Hash.new { |hash, key| hash[key] = {} }
+    @global_id_map = {}
+    @blob_keys_by_old_key = {}
+    @blob_keys_by_old_id = {}
+    @created_blob_keys = []
+    @created_blob_service = nil
+  end
+
+  # Returns the new id mapped for +old_id+, generating (and remembering) one
+  # when it has not been seen yet. Generating on demand makes forward
+  # references work: a record can point at another record that has not been
+  # imported yet, and that record will reuse the same new id when its turn
+  # comes.
+  def map_id(old_id, model_name = nil)
+    return nil if old_id.nil?
+
+    old_key = old_id.to_s
+    if model_name && @id_map[model_name.to_s].key?(old_key)
+      @id_map[model_name.to_s][old_key]
+    elsif @global_id_map.key?(old_key)
+      new_id = @global_id_map[old_key]
+      @id_map[model_name.to_s][old_key] = new_id if model_name
+      new_id
+    else
+      new_id = ActiveRecord::Type::Uuid.generate
+      @global_id_map[old_key] = new_id
+      @id_map[model_name.to_s][old_key] = new_id if model_name
+      new_id
+    end
+  end
+
+  def register_id(old_id, new_id, model_name = nil)
+    return new_id if old_id.nil?
+
+    old_key = old_id.to_s
+    @global_id_map[old_key] = new_id
+    @id_map[model_name.to_s][old_key] = new_id if model_name
+    new_id
+  end
+
+  def mapped_id(old_id, model_name = nil)
+    return nil if old_id.nil?
+
+    old_key = old_id.to_s
+    if model_name && @id_map[model_name.to_s].key?(old_key)
+      @id_map[model_name.to_s][old_key]
+    else
+      @global_id_map[old_key]
+    end
+  end
+
+  def register_blob(old_id:, old_key:, new_key:, service: nil)
+    @blob_keys_by_old_id[old_id.to_s] = new_key if old_id
+    @blob_keys_by_old_key[old_key.to_s] = new_key if old_key
+    @created_blob_keys << new_key
+    @created_blob_service = service if service
+  end
+
+  def new_key_for_blob(old_key: nil, old_id: nil)
+    if old_id && @blob_keys_by_old_id[old_id.to_s]
+      @blob_keys_by_old_id[old_id.to_s]
+    elsif old_key
+      @blob_keys_by_old_key[old_key.to_s]
+    end
+  end
+
+  # Files uploaded while importing live outside the database transaction,
+  # so a failed import has to remove them explicitly to leave nothing behind.
+  def cleanup_created_files
+    return if @created_blob_keys.empty?
+
+    service = @created_blob_service || ActiveStorage::Blob.service
+    @created_blob_keys.each do |key|
+      begin
+        service.delete(key)
+      rescue => _error
+        # Best effort cleanup.
+      end
+    end
+  end
+end
