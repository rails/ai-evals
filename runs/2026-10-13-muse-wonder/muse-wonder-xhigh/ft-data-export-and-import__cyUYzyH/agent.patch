+<% @page_title = "Import an account" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="panel shadow center" style="--panel-size: 55ch;">
+  <div class="flex flex-column gap txt-medium">
+    <p>Import a Fizzy account export (.zip) to create a new account with everything in it — boards, cards, comments, files and people.</p>
+
+    <%= form_with model: @import, url: account_imports_path, method: :post, multipart: true, class: "flex flex-column gap" do |form| %>
+      <label class="flex flex-column gap-half">
+        <span>Account export file</span>
+        <%= form.file_field :file, required: true, accept: ".zip,application/zip,application/x-zip-compressed" %>
+      </label>
+
+      <%= form.submit "Import account", class: "btn btn--link" %>
+    <% end %>
+  </div>
+</div>
