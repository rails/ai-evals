+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "new shows an upload form" do
+    get new_account_import_path
+
+    assert_response :success
+  end
+
+  test "create enqueues an import" do
+    file = fixture_file_upload("moon.jpg", "image/jpeg")
+
+    assert_difference -> { Account::Import.count }, 1 do
+      assert_enqueued_jobs 1, only: Account::ImportJob do
+        post account_imports_path, params: { account_import: { file: file } }
+      end
+    end
+  end
+end
