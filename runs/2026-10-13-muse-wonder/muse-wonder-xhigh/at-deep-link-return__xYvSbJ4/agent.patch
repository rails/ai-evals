@@ -30,4 +30,49 @@ class SessionsController < ApplicationController
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
     end
+
+    # `return_to` is user-supplied (it arrives via shared/emailed links), so
+    # it must never be trusted as a redirect target verbatim. Only local
+    # paths and absolute http(s) URLs on this very host are honoured, and
+    # the latter are reduced to their path so the redirect issued by Rails
+    # cannot be reinterpreted by a browser as pointing at another host.
+    # Anything else (external hosts, protocol-relative URLs, other schemes,
+    # backslash/control-character tricks, non-string values, ...) falls back
+    # to the default post-authenticating URL.
+    def validated_return_to_url
+      return_to = params[:return_to]
+      return unless return_to.is_a?(String)
+
+      return_to = return_to.strip
+      return if return_to.empty?
+      # Whitespace and control characters can smuggle a different URL past
+      # naive parsers than the one a browser eventually follows, and browsers
+      # treat backslashes like slashes: reject any value containing them.
+      return if return_to.match?(/[\x00-\x20\x7f\\]/)
+
+      if return_to.start_with?("/")
+        # A single leading slash is a local path. "//" (and "///" etc.) is
+        # protocol-relative and would take the reader to another host.
+        return_to unless return_to.start_with?("//")
+      else
+        validated_absolute_return_to_url(return_to)
+      end
+    rescue URI::Error, ArgumentError
+      nil
+    end
+
+    def validated_absolute_return_to_url(return_to)
+      uri = URI.parse(return_to)
+
+      return unless uri.is_a?(URI::HTTP) # URI::HTTPS is a subclass
+      return unless uri.host.present? && uri.host.downcase == request.host.to_s.downcase
+
+      # Redirect to the path only: even for our own host, dropping the
+      # scheme/authority/userinfo removes any ambiguity about the target.
+      path = uri.path.presence || "/"
+      path = "/#{path}" unless path.start_with?("/")
+      path = "#{path}?#{uri.query}" if uri.query.present?
+      path = "#{path}##{uri.fragment}" if uri.fragment.present?
+      path
+    end
 end
