diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..7cad21c
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,98 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+  end
+
+  test "dragging a card to another column moves it there" do
+    card = cards(:layout)
+    expand_column "Triage"
+
+    card_element = find(".card", text: "Layout is broken")
+    target = column_section("In progress")
+    card_element.drag_to(target)
+
+    within(target, visible: :all) do
+      assert_selector ".card", text: "Layout is broken", visible: :all
+    end
+    wait_until { card.reload.column == columns(:writebook_in_progress) }
+    assert_equal columns(:writebook_in_progress), card.reload.column
+
+    # The card is placed where the column's own ordering will keep it:
+    # most recently active first, so it is the first card in the list.
+    first_card_id = within(target, visible: :all) do
+      first("[data-drag-and-drop-target~='item']", visible: :all)["id"]
+    end
+    assert_equal card_element["id"], first_card_id
+  end
+
+  test "dragging a card to Done closes it" do
+    card = cards(:layout)
+    expand_column "Triage"
+
+    find(".card", text: "Layout is broken").drag_to(column_section("Done"))
+
+    within(column_section("Done"), visible: :all) do
+      assert_selector ".card", text: "Layout is broken", visible: :all
+    end
+    wait_until { card.reload.closed? }
+    assert card.reload.closed?
+  end
+
+  test "dragging a card to Not Now postpones it and dragging it to Maybe? brings it back" do
+    card = cards(:layout)
+    expand_column "Triage"
+
+    find(".card", text: "Layout is broken").drag_to(column_section("Not Now"))
+    wait_until { card.reload.postponed? }
+    assert card.reload.postponed?
+
+    expand_column "Not Now"
+    find(".card", text: "Layout is broken").drag_to(column_section("Maybe?"))
+
+    within(column_section("Maybe?"), visible: :all) do
+      assert_selector ".card", text: "Layout is broken", visible: :all
+    end
+    wait_until { card.reload.awaiting_triage? }
+    assert card.reload.awaiting_triage?
+  end
+
+  test "dragging a closed card to a column reopens it there" do
+    card = cards(:shipping)
+    assert card.closed?
+    expand_column "Done"
+
+    find(".card", text: "We need to ship the app").drag_to(column_section("On Hold"))
+
+    wait_until { card.reload.open? && card.reload.column == columns(:writebook_on_hold) }
+    assert card.reload.open?
+    assert_equal columns(:writebook_on_hold), card.reload.column
+  end
+
+  test "dropping a card back in its own column does not move it" do
+    card = cards(:layout)
+    last_active_at = card.last_active_at
+    expand_column "Triage"
+
+    find(".card", text: "Layout is broken").drag_to(column_section("Triage"))
+
+    assert_equal columns(:writebook_triage), card.reload.column
+    assert_equal last_active_at.to_i, card.reload.last_active_at.to_i
+  end
+
+  private
+    def column_section(name)
+      find("section.cards[data-column-name='#{name}']", visible: :all)
+    end
+
+    def expand_column(name)
+      within(column_section(name)) { find(".cards__expander").click }
+    end
+
+    def wait_until
+      deadline = Time.current + Capybara.default_max_wait_time.seconds
+      sleep 0.05 until yield || Time.current > deadline
+    end
+end
