diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..ccd1af3
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,316 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+
+  // Lifecycle
+
+  disconnect() {
+    this.#clearDragState()
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  // Actions
+
+  dragStart(event) {
+    this.lastDropEvent = null
+
+    const item = this.#itemFrom(event.target)
+    if (!item) return
+
+    this.draggedItem = item
+    this.sourceContainer = this.#containerFrom(item)
+    if (!this.sourceContainer) {
+      this.draggedItem = null
+      return
+    }
+
+    this.originalParent = item.parentNode
+    this.originalNextSibling = item.nextSibling
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+
+      // Firefox needs data on the transfer before it will start a drag.
+      try {
+        event.dataTransfer.setData("text/plain", item.id || "")
+      } catch {
+        // Some browsers only allow setting data for real drags; the
+        // dragged item is tracked on the controller either way.
+      }
+    }
+
+    // Defer the dimming so the browser doesn't use the dimmed
+    // rendering as the drag image.
+    requestAnimationFrame(() => {
+      if (this.draggedItem === item) item.classList.add(DRAGGED_ITEM_CLASS)
+    })
+  }
+
+  dragEnter(event) {
+    if (!this.#draggedItemFrom(event)) return
+
+    const container = this.#containerFrom(event.target)
+    if (!container) return
+
+    event.preventDefault()
+    this.#highlight(container)
+  }
+
+  dragOver(event) {
+    if (!this.#draggedItemFrom(event)) return
+
+    const container = this.#containerFrom(event.target)
+    if (!container) return
+
+    // Preventing the default is what makes the container a drop target.
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    this.#highlight(container)
+  }
+
+  dragLeave(event) {
+    const container = this.#containerFrom(event.target)
+    if (!container) return
+
+    if (!event.relatedTarget || !container.contains(event.relatedTarget)) {
+      container.classList.remove(HOVER_CONTAINER_CLASS)
+    }
+  }
+
+  drop(event) {
+    // The drop is handled both on the container and on the board
+    // element as the same event bubbles; only handle it once.
+    if (this.lastDropEvent === event) return
+    this.lastDropEvent = event
+
+    const item = this.#draggedItemFrom(event)
+    if (!item) return
+
+    const container = this.#containerFrom(event.target)
+    if (!container) return
+
+    event.preventDefault()
+    this.#clearHighlights()
+
+    const sourceContainer = this.sourceContainer || this.#containerFrom(item)
+
+    // Columns keep their own (server-determined) order: dropping a
+    // card back where it started, or anywhere within its own column,
+    // is not a move at all.
+    if (!sourceContainer || container === sourceContainer) return
+
+    // Optimistic move: the board looks the way the user left it
+    // before the save below has even started, let alone finished.
+    this.#moveItem(item, container)
+    this.#adjustCount(sourceContainer, -1)
+    this.#adjustCount(container, 1)
+    this.#updateCardForContainer(item, container)
+
+    // Snapshot the origin now: dragend clears the drag state long
+    // before the save settles, and a failed save needs to put the
+    // card back exactly where it was picked up from.
+    const origin = {
+      container: sourceContainer,
+      parent: this.originalParent,
+      nextSibling: this.originalNextSibling
+    }
+    this.#save(item, container, origin)
+  }
+
+  dragEnd() {
+    this.#clearDragState()
+  }
+
+  // Private
+
+  #itemFrom(target) {
+    const element = target instanceof Element ? target : target?.parentElement
+    return element?.closest('[data-drag-and-drop-target~="item"]') || null
+  }
+
+  #containerFrom(target) {
+    const element = target instanceof Element ? target : target?.parentElement
+    const container = element?.closest('[data-drag-and-drop-target~="container"]')
+    return container && this.element.contains(container) ? container : null
+  }
+
+  #draggedItemFrom(event) {
+    if (this.draggedItem) return this.draggedItem
+
+    // A drop can arrive without this controller having seen the
+    // dragstart (for example a synthetic drag), so fall back to the
+    // id stashed on the data transfer when there is one.
+    const id = event.dataTransfer?.getData?.("text/plain")
+    if (id) {
+      const item = document.getElementById(id)
+      if (item && this.element.contains(item)) {
+        this.draggedItem = item
+        this.sourceContainer = this.#containerFrom(item)
+        this.originalParent = item.parentNode
+        this.originalNextSibling = item.nextSibling
+      }
+    }
+
+    return this.draggedItem || null
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(candidate => {
+      candidate.classList.toggle(HOVER_CONTAINER_CLASS, candidate === container)
+    })
+  }
+
+  #clearHighlights() {
+    this.containerTargets.forEach(container => container.classList.remove(HOVER_CONTAINER_CLASS))
+  }
+
+  #clearDragState() {
+    this.#clearHighlights()
+    this.draggedItem?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.originalParent = null
+    this.originalNextSibling = null
+  }
+
+  #moveItem(item, container) {
+    const list = container.querySelector(".cards__list")
+    if (!list) return
+
+    const cards = [ ...list.querySelectorAll('[data-drag-and-drop-target~="item"]') ].filter(card => card !== item)
+    // Regular columns and the Maybe? stream put golden cards first,
+    // then the most recently active; Done and Not Now are purely
+    // most-recent first. Either way a just-moved card is the most
+    // recent, so it lands where the server will put it.
+    const goldenFirst = container.dataset.dragAndDropDestination === "column" || container.dataset.dragAndDropDestination === "stream"
+    const reference = !goldenFirst || item.classList.contains("golden-effect")
+      ? cards[0]
+      : cards.find(card => !card.classList.contains("golden-effect"))
+
+    if (reference) {
+      reference.before(item)
+    } else if (cards.length > 0) {
+      cards[cards.length - 1].after(item)
+    } else {
+      const frame = list.querySelector('turbo-frame[id*="pagination-contents"]') || list.querySelector("turbo-frame")
+      const link = frame?.querySelector(".pagination-link")
+      if (link) {
+        link.before(item)
+      } else if (frame) {
+        frame.append(item)
+      } else {
+        list.append(item)
+      }
+    }
+  }
+
+  #adjustCount(container, delta) {
+    const counter = container?.querySelector(".cards__expander-count")
+    if (!counter) return
+
+    if (counter.textContent.includes("+")) return
+
+    const count = parseInt(counter.textContent, 10)
+    if (Number.isNaN(count)) return
+
+    counter.textContent = Math.max(0, count + delta)
+  }
+
+  #updateCardForContainer(item, container) {
+    const destination = container.dataset.dragAndDropDestination
+    const columnName = container.dataset.columnName
+
+    item.classList.toggle("card--postponed", destination === "not_now")
+    item.classList.toggle("card--active", destination === "column" || destination === "stream")
+
+    item.querySelectorAll(".card__stages .card__column-name").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", destination === "column" && stage.textContent.trim() === columnName)
+    })
+
+    const headerBadge = item.querySelector(".card__header .card__column-name")
+
+    if (destination === "column") {
+      if (headerBadge) {
+        const label = headerBadge.querySelector(".overflow-ellipsis") || headerBadge
+        label.textContent = columnName
+      } else {
+        const header = item.querySelector(".card__header")
+        if (header) {
+          const badge = document.createElement("span")
+          badge.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+          const label = document.createElement("span")
+          label.className = "overflow-ellipsis"
+          label.textContent = columnName
+          badge.append(label)
+          header.append(badge)
+        }
+      }
+    } else {
+      headerBadge?.remove()
+    }
+  }
+
+  async #save(item, container, origin) {
+    let response
+
+    try {
+      response = await this.#requestFor(item, container)
+    } catch {
+      response = null
+    }
+
+    // The save is deliberately JSON: the response carries no markup,
+    // so nothing re-renders (and nothing shifts) once it lands. Only a
+    // failed save puts the card back where it came from.
+    if (!response?.ok) {
+      this.#restore(item, origin)
+    }
+  }
+
+  #requestFor(item, container) {
+    switch (container.dataset.dragAndDropDestination) {
+      case "column": {
+        const body = new FormData()
+        body.append("column_id", container.dataset.dragAndDropColumnId)
+        return post(item.dataset.cardTriageUrl, { body, responseKind: "json" })
+      }
+      case "stream":
+        return destroy(item.dataset.cardTriageUrl, { responseKind: "json" })
+      case "not_now":
+        return post(item.dataset.cardNotNowUrl, { responseKind: "json" })
+      case "closed":
+        return post(item.dataset.cardClosureUrl, { responseKind: "json" })
+      default:
+        return Promise.resolve(null)
+    }
+  }
+
+  #restore(item, origin) {
+    const sourceContainer = origin.container
+
+    if (origin.parent) {
+      if (origin.nextSibling?.parentNode === origin.parent) {
+        origin.parent.insertBefore(item, origin.nextSibling)
+      } else {
+        origin.parent.append(item)
+      }
+    }
+
+    if (sourceContainer) {
+      const currentContainer = this.#containerFrom(item)
+      if (currentContainer && currentContainer !== sourceContainer) {
+        this.#adjustCount(currentContainer, -1)
+        this.#adjustCount(sourceContainer, 1)
+      }
+      this.#updateCardForContainer(item, sourceContainer)
+    }
+  }
+}
