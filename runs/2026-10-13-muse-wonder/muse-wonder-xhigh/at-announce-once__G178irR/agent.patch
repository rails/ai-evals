diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..e5dd14f 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,39 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :track_publication_change
+    after_update_commit :announce_publication
+    after_rollback :forget_publication_change, on: :update
   end
 
   private
+    # `saved_change_to_published?` only reflects the most recent save, so a
+    # later save in the same transaction (e.g. adding a page touches the
+    # book) would erase the evidence that the book went live. Remember the
+    # published state from before the first publication change in the
+    # transaction, and decide at commit time based on where the book ends
+    # up. Clearing the tracking on rollback also keeps a failed save from
+    # leaking into the next save on the same instance.
+    def track_publication_change
+      return unless saved_change_to_published?
+      return if @tracking_publication_change
+
+      @tracking_publication_change = true
+      @published_before_publication_change = saved_change_to_published.first
+    end
+
     def announce_publication
-      AnnouncePublicationJob.perform_later self
+      should_announce = @tracking_publication_change &&
+        !@published_before_publication_change &&
+        published?
+
+      forget_publication_change
+
+      AnnouncePublicationJob.perform_later self if should_announce
+    end
+
+    def forget_publication_change
+      @tracking_publication_change = false
+      @published_before_publication_change = nil
     end
 end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..fe36ca4
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "publishing a book announces it once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      books(:manual).update!(published: true)
+    end
+  end
+
+  test "publishing a book and adding a page in the same transaction announces it once" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update!(published: true)
+        book.press Page.new(body: ""), title: "Introduction"
+      end
+    end
+  end
+
+  test "saving an already published book does not announce it again" do
+    book = books(:manual)
+    book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(title: "Manual, Revised")
+    end
+  end
+
+  test "unpublishing a book does not announce it" do
+    book = books(:manual)
+    book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update!(published: false)
+    end
+  end
+
+  test "saving a draft book does not announce it" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      books(:manual).update!(title: "Manual, Revised")
+    end
+  end
+
+  test "a failed transaction that published a book leaves a draft and announces nothing" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises(RuntimeError) do
+        book.transaction do
+          book.update!(published: true)
+          raise "something went wrong"
+        end
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+end
