diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..52cd4be
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,96 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { card&.account }
+  belongs_to :comment, touch: true, optional: true
+  belongs_to :card, touch: true, optional: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  # The reacter is the author of the reaction, so it can also be
+  # addressed as the user or creator, as with other authored records.
+  belongs_to :user, class_name: "User", foreign_key: "reacter_id", optional: true
+  belongs_to :creator, class_name: "User", foreign_key: "reacter_id", optional: true
+
+  normalizes :content, with: ->(content) { content.strip }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validate :belongs_to_comment_or_card
+
+  scope :chronologically, -> { order(created_at: :asc, id: :asc) }
+  scope :preloaded, -> { includes(reacter: [ :avatar_attachment, :account ]) }
+  scope :for_cards, -> { where.not(card_id: nil) }
+  scope :for_comments, -> { where.not(comment_id: nil) }
+
+  # Touching the comment touches its card, and the card broadcasts a
+  # refresh to everyone viewing it, so reactions appear live. Card
+  # reactions touch the card directly, with the same effect.
+
+  # For a comment reaction, this is the comment's card; for a card
+  # reaction (a boost), it is the card being reacted to.
+  def card
+    super || comment&.card
+  end
+
+  def boosted_card
+    association(:card).load_target
+  end
+
+  def boosted_card=(boosted_card)
+    self.card = boosted_card
+  end
+
+  def reactable
+    comment || boosted_card
+  end
+
+  def reactable=(reactable)
+    case reactable
+    when Comment
+      self.comment = reactable
+    when Card
+      self.card = reactable
+    else
+      self.comment = reactable
+    end
+  end
+
+  def reactable_type
+    if comment_id.present?
+      "Comment"
+    elsif card_id.present?
+      "Card"
+    end
+  end
+
+  def reactable_id
+    comment_id || card_id
+  end
+
+  def reactable_type=(type)
+    @pending_reactable_type = type
+    assign_pending_reactable
+  end
+
+  def reactable_id=(id)
+    @pending_reactable_id = id
+    assign_pending_reactable
+  end
+
+  def to_partial_path
+    "cards/comments/#{super}"
+  end
+
+  private
+    def assign_pending_reactable
+      if @pending_reactable_type.present? && @pending_reactable_id.present?
+        reactable_class = @pending_reactable_type == "Card" ? Card : Comment
+        self.reactable = reactable_class.find(@pending_reactable_id)
+      end
+    end
+
+    def belongs_to_comment_or_card
+      if comment_id.blank? && card_id.blank?
+        errors.add(:comment, "must belong to a comment or a card")
+      elsif comment_id.present? && card_id.present?
+        errors.add(:comment, "cannot belong to both a comment and a card")
+      end
+    end
+end
