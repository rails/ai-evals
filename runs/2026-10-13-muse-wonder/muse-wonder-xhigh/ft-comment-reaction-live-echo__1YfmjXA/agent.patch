+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+  end
+
+  test "index as JSON" do
+    @card.reactions.create!(content: "👍", reacter: users(:jz))
+
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal "👍", @response.parsed_body.first["content"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @card.reactions.count }, +1 do
+      post card_reactions_path(@card), params: { reaction: { content: "🔥" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "🔥", @response.parsed_body["content"]
+    assert_equal card_reaction_url(@card, @card.reactions.last), @response.parsed_body["url"]
+  end
+
+  test "destroy own reaction as JSON" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    delete card_reaction_path(@card, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:jz))
+
+    delete card_reaction_path(@card, reaction), as: :json
+
+    assert_response :forbidden
+    assert Reaction.exists?(reaction.id)
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..939cb21
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "creates a reaction on a comment" do
+    reaction = @comment.reactions.create!(content: "🔥", reacter: users(:david))
+
+    assert_equal @comment, reaction.comment
+    assert_equal users(:david), reaction.reacter
+    assert_equal cards(:logo), reaction.card
+  end
+
+  test "content is required and limited to 16 characters" do
+    assert_not @comment.reactions.build(content: "").valid?
+    assert_not @comment.reactions.build(content: "a" * 17).valid?
+    assert @comment.reactions.build(content: "a" * 16).valid?
+  end
+
+  test "broadcasts a refresh to the card when created and destroyed" do
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts cards(:logo) do
+        reaction = @comment.reactions.create!(content: "👍", reacter: users(:david))
+        reaction.destroy!
+      end
+    end
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..742fdad
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,57 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding and removing a reaction to a comment" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      find(".reactions__trigger").click
+      fill_in "Reaction", with: "oops"
+      find(".reaction__cancel-btn").click
+      assert_no_selector ".reaction__input", visible: true
+      assert_selector ".reactions__trigger", visible: true
+
+      find(".reactions__trigger").click
+      fill_in "Reaction", with: "🔥"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "🔥"
+      assert_no_selector ".reaction__input", visible: true
+      assert_selector ".reactions__trigger", visible: true
+
+      # The trigger is back, ready for another reaction
+      find(".reactions__trigger").click
+      fill_in "Reaction", with: "Nice!"
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction", text: "Nice!"
+
+      find(".reaction", text: "🔥").click
+      find(".reaction__delete", visible: true).click
+
+      assert_no_selector ".reaction", text: "🔥"
+      assert_selector ".reaction", text: "Nice!"
+    end
+  end
+
+  test "reactions from elsewhere appear without reloading" do
+    visit card_url(@card)
+
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+    assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+
+    @comment.reactions.create!(content: "🎉", reacter: users(:kevin))
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within "##{dom_id(@comment)}" do
+      assert_selector ".reaction", text: "🎉", wait: 5
+    end
+  end
+end
