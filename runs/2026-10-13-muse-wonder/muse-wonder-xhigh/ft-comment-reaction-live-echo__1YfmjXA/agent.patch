diff --git a/app/views/cards/comments/reactions/_reactions.html.erb b/app/views/cards/comments/reactions/_reactions.html.erb
new file mode 100644
index 0000000..c2cca6d
--- /dev/null
+++ b/app/views/cards/comments/reactions/_reactions.html.erb
@@ -0,0 +1,41 @@
+<% form_expanded = local_assigns.fetch(:reaction_form_expanded, false) %>
+
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reaction-form">
+  <div id="<%= dom_id(comment, :reactions_list) %>" class="reactions__list">
+    <%= render partial: "cards/comments/reactions/reaction", collection: comment.reactions.chronologically, as: :reaction %>
+  </div>
+
+  <% if Current.user %>
+    <button type="button" class="reactions__trigger btn btn--circle" aria-label="Add a reaction" title="Add a reaction" <%= "hidden" if form_expanded %>
+        data-reaction-form-target="trigger" data-action="reaction-form#show">
+      <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+      <span class="for-screen-reader">Add a reaction</span>
+    </button>
+
+    <%= form_with model: Reaction.new, url: card_comment_reactions_path(comment.card, comment),
+          html: { class: class_names("reaction reaction__form", "expanded": form_expanded), hidden: !form_expanded, data: { reaction_form_target: "form" } } do |form| %>
+      <span class="reaction__avatar" aria-hidden="true">
+        <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+      </span>
+
+      <label class="reaction__form-label">
+        <span class="for-screen-reader">Reaction</span>
+        <%= form.text_field :content, class: "input reaction__input", placeholder: "Add a reaction…",
+              required: true, maxlength: 16, autocomplete: "off", autofocus: form_expanded, aria: { label: "Reaction" },
+              data: { reaction_form_target: "input", "1p-ignore": true } %>
+      </label>
+
+      <%= form.button type: "submit", class: "btn btn--circle reaction__submit-btn",
+            aria: { label: "Add reaction" }, title: "Confirm reaction" do %>
+        <%= icon_tag "check" %>
+        <span class="for-screen-reader">Add reaction</span>
+      <% end %>
+
+      <button type="button" class="btn btn--circle reaction__cancel-btn"
+          aria-label="Cancel" title="Cancel reaction" data-action="reaction-form#hide">
+        <%= icon_tag "close" %>
+        <span class="for-screen-reader">Cancel</span>
+      </button>
+    <% end %>
+  <% end %>
+</div>
