diff --git a/app/views/cards/comments/reactions/_reaction.html.erb b/app/views/cards/comments/reactions/_reaction.html.erb
new file mode 100644
index 0000000..3c45650
--- /dev/null
+++ b/app/views/cards/comments/reactions/_reaction.html.erb
@@ -0,0 +1,27 @@
+<% own_reaction = Current.user && reaction.reacter_id == Current.user.id %>
+<% delete_url = if reaction.comment
+       card_comment_reaction_path(reaction.card, reaction.comment, reaction)
+     else
+       card_reaction_path(reaction.card, reaction)
+     end %>
+
+<div id="<%= dom_id(reaction) %>" class="<%= class_names("reaction", "reaction--deleteable": own_reaction) %>"
+    title="<%= reaction.reacter.name %>"
+    <% if own_reaction %>
+      data-controller="toggle-class" data-toggle-class-toggle-class="expanded" data-action="click->toggle-class#toggle"
+    <% end %>>
+  <span class="reaction__avatar">
+    <%= avatar_preview_tag reaction.reacter, hidden_for_screen_reader: true %>
+  </span>
+
+  <span class="txt-small txt-medium"><%= reaction.content %></span>
+  <span class="for-screen-reader">by <%= reaction.reacter.name %></span>
+
+  <% if own_reaction %>
+    <%= button_to delete_url, method: :delete,
+          class: "btn reaction__delete", title: "Delete reaction", form_class: "reaction__delete-form" do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Remove reaction</span>
+    <% end %>
+  <% end %>
+</div>
