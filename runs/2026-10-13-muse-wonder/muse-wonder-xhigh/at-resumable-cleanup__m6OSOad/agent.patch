@@ -0,0 +1,49 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  WRAPPED_AND_CLEANED = {
+    %q("Plain Title") => "Plain Title",
+    %q(""Quoted phrase" and more") => %q("Quoted phrase" and more),
+    %q(""Fully Quoted"") => %q("Fully Quoted"),
+    %q("Ends with "quote"") => %q(Ends with "quote")
+  }.freeze
+
+  setup do
+    @leaves = Leaf.order(:id).to_a
+    @leaves.zip(WRAPPED_AND_CLEANED.keys).each do |leaf, title|
+      leaf.update!(title: title)
+    end
+  end
+
+  test "strips only the outer quotes, preserving inner quotes" do
+    TitleCleanupJob.perform_now
+
+    assert_equal WRAPPED_AND_CLEANED.values, @leaves.map { |leaf| leaf.reload.title }
+  end
+
+  test "running again does not strip another pair of quotes" do
+    TitleCleanupJob.perform_now
+    TitleCleanupJob.perform_now
+
+    assert_equal WRAPPED_AND_CLEANED.values, @leaves.map { |leaf| leaf.reload.title }
+  end
+
+  test "resumes after interruption without re-cleaning earlier leaves" do
+    TitleCleanupJob.perform_later
+
+    # Interrupt when the cursor has advanced past the second leaf.
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: @leaves.second.id + 1) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal WRAPPED_AND_CLEANED.values.first(2), @leaves.first(2).map { |leaf| leaf.reload.title }
+    assert_equal WRAPPED_AND_CLEANED.keys.last(2), @leaves.last(2).map { |leaf| leaf.reload.title }
+
+    perform_enqueued_jobs
+
+    assert_equal WRAPPED_AND_CLEANED.values, @leaves.map { |leaf| leaf.reload.title }
+  end
+end
