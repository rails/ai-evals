--- a/app/jobs/title_cleanup_job.rb
+++ b/app/jobs/title_cleanup_job.rb
@@ -1,11 +1,27 @@
 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :clean_titles do |step|
+      Leaf.find_each(start: step.cursor) do |leaf|
+        clean_leaf(leaf)
+        step.advance! from: leaf.id
+      end
     end
   end
 
   private
+    def clean_leaf(leaf)
+      return if leaf.title_cleaned_at.present?
+
+      # Persist the cleaned title and the fact that it has been cleaned in a
+      # single update (hence a single transaction). If the job is killed
+      # after this commits but before the continuation cursor is persisted,
+      # a resumed run will revisit at most this leaf and -- seeing the marker --
+      # will not strip a second pair of quotes from it.
+      leaf.update!(title: cleaned(leaf.title), title_cleaned_at: Time.current)
+    end
+
     def cleaned(title)
       title.delete_prefix('"').delete_suffix('"')
     end
