diff --git a/test/controllers/removed_collaborator_broadcast_test.rb b/test/controllers/removed_collaborator_broadcast_test.rb
new file mode 100644
index 0000000..4457328
--- /dev/null
+++ b/test/controllers/removed_collaborator_broadcast_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+require "turbo/broadcastable/test_helper"
+
+class RemovedCollaboratorBroadcastTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+  include Turbo::Broadcastable::TestHelper
+
+  setup do
+    @book = books(:handbook)
+    @page = leaves(:welcome_page)
+    @david = users(:david)
+    @kevin = users(:kevin)
+    @jason = users(:jason)
+  end
+
+  test "removed collaborator does not receive being edited broadcast, remaining collaborator does" do
+    # David already has the editor open before Kevin is removed.
+    sign_in @david
+    get edit_book_page_path(@book, @page)
+    assert_response :success
+    david_stream = only_stream_name(response.body)
+
+    sign_in @kevin
+    get edit_book_page_path(@book, @page)
+    assert_response :success
+    kevin_stream = only_stream_name(response.body)
+
+    # Remove Kevin from the book while his editor is still open.
+    @book.access_for(user: @kevin).destroy
+    assert_not @book.accessable?(user: @kevin)
+
+    sign_in @jason
+    get edit_book_page_path(@book, @page)
+    assert_response :success
+    jason_stream = only_stream_name(response.body)
+
+    # Save the page as Jason and deliver the broadcast jobs.
+    perform_enqueued_jobs do
+      patch book_page_path(@book, @page), params: { page: { body: "Changed by Jason" } }, as: :turbo_stream
+    end
+    assert_response :success
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+    assert_turbo_stream_broadcasts david_stream
+    assert_turbo_stream_broadcasts jason_stream
+  end
+
+  test "collaborator downgraded to reader does not receive being edited broadcast" do
+    sign_in @kevin
+    get edit_book_page_path(@book, @page)
+    kevin_stream = only_stream_name(response.body)
+
+    @book.access_for(user: @kevin).update! level: :reader
+    assert_not @book.editable?(user: @kevin)
+
+    sign_in @jason
+    get edit_book_page_path(@book, @page)
+    jason_stream = only_stream_name(response.body)
+
+    perform_enqueued_jobs do
+      patch book_page_path(@book, @page), params: { page: { body: "Changed by Jason" } }, as: :turbo_stream
+    end
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+    assert_turbo_stream_broadcasts jason_stream
+  end
+
+  test "reader accesses do not receive being edited broadcast" do
+    reader_stream = stream_name_for(accesses(:jz_handbook))
+
+    sign_in @jason
+    get edit_book_page_path(@book, @page)
+    jason_stream = only_stream_name(response.body)
+
+    perform_enqueued_jobs do
+      patch book_page_path(@book, @page), params: { page: { body: "Changed by Jason" } }, as: :turbo_stream
+    end
+
+    assert_no_turbo_stream_broadcasts reader_stream
+    assert_turbo_stream_broadcasts jason_stream
+  end
+
+  private
+    def only_stream_name(body)
+      signed = body.scan(/signed-stream-name="([^"]+)"/).flatten
+      assert_equal 1, signed.size, "expected exactly one turbo stream source, got #{signed.inspect}"
+      Turbo.signed_stream_verifier.verified(signed.first)
+    end
+
+    def stream_name_for(streamable)
+      Turbo::StreamsChannel.signed_stream_name([ streamable, :being_edited ]).then { |signed| Turbo.signed_stream_verifier.verified(signed) }
+    end
+end
