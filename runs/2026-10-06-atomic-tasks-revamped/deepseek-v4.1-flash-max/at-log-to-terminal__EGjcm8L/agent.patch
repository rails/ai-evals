diff --git a/config/environments/development.rb b/config/environments/development.rb
index e1c3d90..f9ac6dc 100644
--- a/config/environments/development.rb
+++ b/config/environments/development.rb
@@ -69,6 +69,28 @@ Rails.application.configure do
   # Raise error when a before_action's only/except options reference missing actions
   config.action_controller.raise_on_missing_callback_actions = true
 
+  # The development server broadcasts its logs to the console automatically,
+  # but commands like `rails runner` don't. Mirror that behavior so scripts
+  # running in development are visible on the terminal while still being
+  # written to log/development.log.
+  config.after_initialize do
+    console = ActiveSupport::Logger.new(STDOUT)
+    console.formatter = Rails.logger.formatter
+    console.level = Rails.logger.level
+
+    unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT)
+      Rails.logger.broadcast_to(console)
+    end
+  end
+
+  # Keep runner output focused on what the script logs, rather than echoing
+  # every SQL query alongside it.
+  Rails.application.runner do
+    if defined?(ActiveRecord::Base)
+      ActiveRecord::Base.logger = Rails.logger.broadcasts.first
+    end
+  end
+
   # Apply autocorrection by RuboCop to files generated by `bin/rails generate`.
   config.generators.apply_rubocop_autocorrect_after_generate!
 end
