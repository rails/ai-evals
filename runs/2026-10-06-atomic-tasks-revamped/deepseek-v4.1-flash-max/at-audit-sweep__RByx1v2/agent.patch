diff --git a/test/integration/security_findings_test.rb b/test/integration/security_findings_test.rb
new file mode 100644
index 0000000..2b5c156
--- /dev/null
+++ b/test/integration/security_findings_test.rb
@@ -0,0 +1,245 @@
+require "test_helper"
+
+class SecurityFindingsTest < ActionDispatch::IntegrationTest
+  # PT-01: Privilege escalation
+  test "PT-01 member cannot give themselves administrator via profile update" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: { user: { name: "Kevin", role: "administrator" } }
+
+    assert_redirected_to users_url
+    assert_not users(:kevin).reload.administrator?
+  end
+
+  test "PT-01 member cannot give somebody else administrator via profile update" do
+    sign_in :kevin
+
+    put user_profile_url(users(:jz)), params: { user: { role: "administrator" } }
+
+    assert_response :forbidden
+    assert_not users(:jz).reload.administrator?
+  end
+
+  # PT-02: Missing authorisation on book destroy
+  test "PT-02 reader cannot destroy an accessible book" do
+    sign_in :jz
+    assert_not books(:handbook).editable?(user: users(:jz))
+
+    assert_no_difference -> { Book.count } do
+      delete book_url(books(:handbook))
+    end
+
+    assert_response :forbidden
+  end
+
+  test "PT-02 signed-in user cannot destroy a published book they cannot edit" do
+    books(:manual).update!(published: true)
+    sign_in :kevin
+    assert_not books(:manual).editable?(user: users(:kevin))
+
+    assert_no_difference -> { Book.count } do
+      delete book_url(books(:manual))
+    end
+
+    assert_response :forbidden
+  end
+
+  test "PT-02 editor can still destroy a book" do
+    sign_in :kevin
+    assert books(:handbook).editable?(user: users(:kevin))
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_url(books(:handbook))
+    end
+
+    assert_redirected_to root_url
+  end
+
+  # PT-03: Injection in library search
+  test "PT-03 search treats input as data and does not leak unreadable books" do
+    books(:manual).press Page.new(body: "Secret manual content"), title: "Unreadable Secret"
+    sign_in :kevin
+    assert_not books(:manual).accessable?(user: users(:kevin))
+
+    get library_search_path(q: "%' OR 1=1 OR '")
+
+    assert_response :success
+    assert_not_in_body "Unreadable Secret"
+  end
+
+  test "PT-03 apostrophe in a search term does not cause a server error" do
+    sign_in :kevin
+
+    get library_search_path(q: "It's")
+
+    assert_response :success
+  end
+
+  test "PT-03 ordinary searches still find readable pages" do
+    sign_in :kevin
+
+    get library_search_path(q: "Welcome")
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+  end
+
+  # PT-04: Search terms read as pattern syntax
+  test "PT-04 percent sign only matches pages containing a literal percent" do
+    books(:handbook).press Page.new(body: "discount"), title: "Save 50% off"
+    sign_in :kevin
+
+    get library_search_path(q: "%")
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "PT-04 page with a percent sign stays findable by its title" do
+    books(:handbook).press Page.new(body: "discount"), title: "Save 50% off"
+    sign_in :kevin
+
+    get library_search_path(q: "Save 50% off")
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+  end
+
+  test "PT-04 underscore only matches pages containing a literal underscore" do
+    books(:handbook).press Page.new(body: "underscore"), title: "Under_score"
+    sign_in :kevin
+
+    get library_search_path(q: "_")
+
+    assert_response :success
+    assert_in_body "Under_score"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  # PT-05: Insecure direct object reference
+  test "PT-05 leaf from an unreadable book is not rendered under a readable book id" do
+    secret_leaf = books(:manual).press Page.new(body: "Manual secret content"), title: "Manual Secret"
+    sign_in :kevin
+
+    get "/#{books(:handbook).id}/#{books(:handbook).slug}/#{secret_leaf.id}/#{secret_leaf.slug}"
+
+    assert_response :not_found
+  end
+
+  test "PT-05 readable leaf stays readable for a signed-in user" do
+    sign_in :kevin
+
+    get leafable_slug_path(leaves(:welcome_page))
+
+    assert_response :success
+  end
+
+  test "PT-05 readable leaf stays readable when signed out" do
+    books(:handbook).update!(published: true)
+    sign_out
+
+    get leafable_slug_path(leaves(:welcome_page))
+
+    assert_response :success
+  end
+end
+
+class SecurityFindingsEdgeCasesTest < ActionDispatch::IntegrationTest
+  test "PT-01 profile update still changes name, email and password while ignoring role" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: {
+      user: { name: "Kevin Renamed", email_address: "kevin2@example.com", password: "newsecret123", role: "administrator" }
+    }
+
+    assert_redirected_to users_url
+    kevin = users(:kevin).reload
+    assert_equal "Kevin Renamed", kevin.name
+    assert_equal "kevin2@example.com", kevin.email_address
+    assert kevin.authenticate("newsecret123")
+    assert_not kevin.administrator?
+  end
+
+  test "PT-03 search with no readable books does not error" do
+    sign_out
+
+    get library_search_path(q: "anything")
+
+    assert_response :success
+    assert_in_body "No matches."
+  end
+
+  test "PT-03 signed out search does not leak unpublished books" do
+    books(:manual).press Page.new(body: "Hidden"), title: "Hidden Manual Page"
+    sign_out
+
+    get library_search_path(q: "Hidden")
+
+    assert_response :success
+    assert_not_in_body "Hidden Manual Page"
+  end
+
+  test "PT-03 backslash in a search term does not cause a server error" do
+    sign_in :kevin
+
+    get library_search_path(q: "\\")
+
+    assert_response :success
+  end
+
+  test "PT-04 percent sign does not wildcard-match unrelated titles" do
+    books(:handbook).press Page.new(body: "discount"), title: "Save 50% off"
+    sign_in :kevin
+
+    get library_search_path(q: "50%")
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Summary"
+  end
+
+  test "PT-04 underscore in the middle of a term does not wildcard-match" do
+    books(:handbook).press Page.new(body: "underscore"), title: "a_b"
+    sign_in :kevin
+
+    get library_search_path(q: "a_b")
+
+    assert_response :success
+    assert_in_body "a_b"
+    assert_not_in_body "Reading"
+  end
+
+  test "PT-05 leaf of another readable book is not rendered under the wrong book id" do
+    other_leaf = books(:manual).press Page.new(body: "Manual content"), title: "Manual Page"
+    books(:manual).accesses.create!(user: users(:kevin), level: :reader)
+    sign_in :kevin
+
+    get "/#{books(:handbook).id}/#{books(:handbook).slug}/#{other_leaf.id}/#{other_leaf.slug}"
+
+    assert_response :not_found
+  end
+end
+
+class SecurityFindingsJoinTest < ActionDispatch::IntegrationTest
+  test "PT-01 member cannot assign themselves a role when joining" do
+    post join_url(accounts(:signal).join_code), params: {
+      user: { name: "New Person", email_address: "newperson@example.com", password: "secret123456", role: "administrator" }
+    }
+
+    assert_redirected_to root_url
+    assert_not User.find_by(email_address: "newperson@example.com").administrator?
+  end
+end
+
+class SecurityFindingsPunctuationTest < ActionDispatch::IntegrationTest
+  test "PT-03 apostrophe terms can still match page titles" do
+    books(:handbook).press Page.new(body: "punctuation"), title: "It's a Great Page"
+    sign_in :kevin
+
+    get library_search_path(q: "It's")
+
+    assert_response :success
+    assert_in_body "It&#39;s a Great Page"
+  end
+end
