diff --git a/test/models/book/access_import_fix_test.rb b/test/models/book/access_import_fix_test.rb
new file mode 100644
index 0000000..ea94c53
--- /dev/null
+++ b/test/models/book/access_import_fix_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class Book::AccessImportFixTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Import test #{SecureRandom.hex(4)}", everyone_access: false)
+    @users = 16.times.map do |i|
+      User.create!(name: "Import User #{i} #{SecureRandom.hex(4)}", email_address: "import-#{i}-#{SecureRandom.hex(4)}@example.com", password_digest: "x", role: :member)
+    end
+  end
+
+  teardown do
+    @book.destroy
+  end
+
+  test "imports all grants, persists accesses, and enqueues one notification each" do
+    grants = @users.first(16).map { |user| { user_id: user.id, level: "reader" } }
+
+    result = nil
+    assert_enqueued_jobs 16, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal 16, result.accesses.size
+    assert result.accesses.all?(&:persisted?)
+    assert_equal @users.first(16).map(&:id), result.accesses.map(&:user_id)
+    assert_equal [ "reader" ], result.accesses.map(&:level).uniq
+    assert_equal 16, @book.accesses.count
+  end
+
+  test "accepts symbol levels" do
+    grants = @users.first(2).map { |user| { user_id: user.id, level: :editor } }
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_nil result.duplicate_index
+    assert_equal [ "editor" ], result.accesses.map(&:level).uniq
+    assert_equal [ "editor" ], @book.accesses.pluck(:level).uniq
+  end
+
+  test "uses a single insert regardless of roster size and outcome" do
+    inserts_for = ->(size, duplicate: false) do
+      @book.accesses.delete_all
+      grants = @users.first(size).map { |user| { user_id: user.id, level: "reader" } }
+      grants << grants.first.dup if duplicate
+      count_sql(/INSERT INTO "accesses"/) { Book::AccessImport.new(@book, grants).import }
+    end
+
+    assert_equal 1, inserts_for.call(4)
+    assert_equal 1, inserts_for.call(16)
+    assert_equal 1, inserts_for.call(4, duplicate: true)
+    assert_equal 1, inserts_for.call(16, duplicate: true)
+  end
+
+  test "rejects duplicate existing access without persisting or notifying" do
+    @book.accesses.create!(user_id: @users.first.id, level: "reader")
+    grants = @users.first(4).map { |user| { user_id: user.id, level: "editor" } }
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      inserts = count_sql(/INSERT INTO "accesses"/) { result = Book::AccessImport.new(@book, grants).import }
+      assert_equal 1, inserts
+    end
+
+    assert_empty result.accesses
+    assert_equal 0, result.duplicate_index
+    assert_equal 1, @book.accesses.count
+  end
+
+  test "rejects duplicate within the roster without persisting or notifying" do
+    grants = [
+      { user_id: @users[0].id, level: "reader" },
+      { user_id: @users[1].id, level: "reader" },
+      { user_id: @users[1].id, level: "editor" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      inserts = count_sql(/INSERT INTO "accesses"/) { result = Book::AccessImport.new(@book, grants).import }
+      assert_equal 1, inserts
+    end
+
+    assert_empty result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "rejects unknown levels without raising, writing, or notifying" do
+    grants = [
+      { user_id: @users[0].id, level: "reader" },
+      { user_id: @users[1].id, level: "wizard" },
+      { user_id: @users[2].id, level: "reader" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      inserts = count_sql(/INSERT INTO "accesses"/) { result = Book::AccessImport.new(@book, grants).import }
+      assert_equal 0, inserts
+    end
+
+    assert_empty result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "returns an empty successful result for an empty roster" do
+    result = Book::AccessImport.new(@book, []).import
+
+    assert_empty result.accesses
+    assert_nil result.duplicate_index
+  end
+
+  private
+    def count_sql(pattern)
+      count = 0
+      callback = ->(_name, _start, _finish, _id, payload) { count += 1 if payload[:sql] =~ pattern }
+      ActiveSupport::Notifications.subscribed(callback, "sql.active_record") { yield }
+      count
+    end
+end
