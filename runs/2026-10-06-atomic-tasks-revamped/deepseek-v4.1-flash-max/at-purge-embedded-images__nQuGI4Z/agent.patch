@@ -0,0 +1,48 @@
+require "test_helper"
+
+class PageUploadPurgeTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges images embedded in its markdown" do
+    page = pages(:welcome)
+    attachment = attach_image(page)
+    blob = attachment.blob
+    file_path = ActiveStorage::Blob.service.path_for(blob.key)
+
+    assert File.exist?(file_path)
+
+    perform_enqueued_jobs do
+      leaves(:welcome_page).destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(file_path)
+  end
+
+  test "destroying a page purges images kept on its revisions" do
+    leaf = leaves(:welcome_page)
+    revision_page = leaf.leafable
+    attachment = attach_image(revision_page)
+    blob = attachment.blob
+    file_path = ActiveStorage::Blob.service.path_for(blob.key)
+
+    leaf.edit leafable_params: { body: "A new body" }
+    assert_not_equal revision_page, leaf.reload.leafable
+
+    perform_enqueued_jobs do
+      leaf.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(file_path)
+  end
+
+  private
+    def attach_image(page)
+      page.body.uploads.attach io: file_fixture("reading.webp").open,
+        filename: "reading.webp", content_type: "image/webp"
+      page.body.uploads.attachments.last
+    end
+end
