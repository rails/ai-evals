diff --git a/test/controllers/users_controller_test.rb b/test/controllers/users_controller_test.rb
index e0ca8db..5bfd702 100644
--- a/test/controllers/users_controller_test.rb
+++ b/test/controllers/users_controller_test.rb
@@ -78,4 +78,32 @@ class UsersControllerTest < ActionDispatch::IntegrationTest
     delete user_url(users(:david))
     assert_response :forbidden
   end
+
+  test "destroy erases a deactivated user and their sign in events" do
+    user = users(:kevin)
+    signed_in_email = user.email_address
+    user.deactivate
+    SignInEvent.create!(action: :signed_in, email_address: signed_in_email)
+
+    sign_in :david
+
+    assert_difference -> { User.count }, -1 do
+      delete user_url(user)
+    end
+
+    assert_redirected_to users_url
+    assert_not User.exists?(user.id)
+    assert_empty SignInEvent.for_address(signed_in_email)
+  end
+
+  test "index shows deactivated users so they can be removed" do
+    users(:kevin).deactivate
+    sign_in :david
+
+    get users_url
+
+    assert_response :success
+    assert_in_body "Kevin"
+    assert_in_body "Deactivated"
+  end
 end
diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..c20f305 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,60 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "erasing a user removes their sessions, accesses, reading marks, books, and sign in events" do
+    user = users(:kevin)
+    signed_in_email = user.email_address
+    book = Book.create!(title: "Private Book", everyone_access: false, creator: user)
+    leaf = book.press(Section.new(body: "Private content"), title: "Private Leaf")
+    user.accesses.create!(book: book, level: :editor)
+    ReadingMark.create!(user: user, leaf: leaf, last_read_at: Time.now)
+    user.sessions.start!(user_agent: "Test", ip_address: "127.0.0.1")
+    SignInEvent.create!(action: :signed_in, email_address: signed_in_email)
+
+    user.erase!
+
+    assert_not User.exists?(user.id)
+    assert_empty Session.where(user_id: user.id)
+    assert_empty Access.where(user_id: user.id)
+    assert_empty ReadingMark.where(user_id: user.id)
+    assert_empty SignInEvent.for_address(signed_in_email)
+    assert_not Book.exists?(book.id)
+  end
+
+  test "erasing a user keeps books shared with everyone and removes their byline" do
+    user = users(:kevin)
+    book = Book.create!(title: "Shared Book", author: "Kevin", everyone_access: true, creator: user)
+
+    user.erase!
+
+    assert Book.exists?(book.id)
+    assert_nil book.reload.creator_id
+    assert_equal "Deleted author", book.author
+  end
+
+  test "erasing a user removes search index entries for their private books" do
+    user = users(:kevin)
+    book = Book.create!(title: "Private Search Book", everyone_access: false, creator: user)
+    leaf = book.press(Section.new(body: "erased unique content"), title: "Erased Unique")
+    leaf.reindex
+
+    assert_includes Leaf.search("erased unique content"), leaf
+
+    user.erase!
+
+    assert_not_includes Leaf.search("erased unique content"), leaf
+  end
+
+  test "erasing a deactivated user removes sign in events under the address they signed in with" do
+    user = users(:kevin)
+    signed_in_email = user.email_address
+    user.deactivate
+    SignInEvent.create!(action: :signed_in, email_address: signed_in_email)
+
+    user.erase!
+
+    assert_not User.exists?(user.id)
+    assert_empty SignInEvent.for_address(signed_in_email)
+  end
 end
