   scope :active, -> { where(active: true) }
   scope :ordered, -> { order(:name) }
@@ -20,12 +25,27 @@ class User < ApplicationRecord
   def deactivate
     transaction do
       sessions.delete_all
-      update! active: false, email_address: deactived_email_address
+      update! active: false, email_address: deactivated_email_address
     end
   end
 
+  def erase
+    destroy
+  end
+
+  def erase!
+    destroy!
+  end
+
+  # Users removed the old way had their email address rewritten, so the
+  # address they actually signed in with has to be recovered from it.
+  def actual_email_address
+    email_address.to_s.sub(DEACTIVATED_EMAIL_ADDRESS_PATTERN, "")
+  end
+  alias_method :original_email_address, :actual_email_address
+
   private
-    def deactived_email_address
+    def deactivated_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
 
@@ -33,4 +53,23 @@ class User < ApplicationRecord
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
     end
+
+    def erase_created_books
+      Book.where(creator_id: id).find_each do |book|
+        if book.everyone_access?
+          book.update! creator: nil, author: DELETED_AUTHOR_NAME
+        else
+          book.destroy!
+        end
+      end
+
+      # The dependent-destroy callback for created_books runs after this one
+      # and works off the association's in-memory target. Drop any loaded
+      # copies so books we just anonymized or destroyed aren't destroyed again.
+      created_books.reset
+    end
+
+    def erase_sign_in_events
+      SignInEvent.where(email_address: [ email_address, actual_email_address ].uniq).delete_all
+    end
 end
