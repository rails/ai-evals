diff --git a/test/integration/toc_cache_repro_test.rb b/test/integration/toc_cache_repro_test.rb
new file mode 100644
index 0000000..f9e305c
--- /dev/null
+++ b/test/integration/toc_cache_repro_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class TocCacheReproTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_perform_caching = ActionController::Base.perform_caching
+    @previous_cache_store = ActionController::Base.cache_store
+    @previous_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    ActionController::Base.perform_caching = true
+    ActionController::Base.cache_store = ActiveSupport::Cache::MemoryStore.new
+    ActionView::PartialRenderer.collection_cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = @previous_perform_caching
+    ActionController::Base.cache_store = @previous_cache_store
+    ActionView::PartialRenderer.collection_cache = @previous_collection_cache
+  end
+
+  test "reader never receives editor controls, even when an editor loaded the page first" do
+    edit_path = edit_book_page_path(books(:handbook), leaves(:welcome_page))
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body edit_path
+
+    sign_out
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_not_in_body edit_path
+  end
+
+  test "editor always receives controls, even when a reader loaded the page first" do
+    edit_path = edit_book_page_path(books(:handbook), leaves(:welcome_page))
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_not_in_body edit_path
+
+    sign_out
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body edit_path
+  end
+
+  test "renamed leaf shows its new title to the next visitor" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_in_body "Welcome to The Handbook!"
+
+    leaves(:welcome_page).update!(title: "Renamed Page")
+    get book_slug_path(books(:handbook))
+
+    assert_in_body "Renamed Page"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "promoted reader sees controls on their next visit" do
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_not_in_body edit_book_page_path(books(:handbook), leaves(:welcome_page))
+
+    accesses(:jz_handbook).update!(level: :editor)
+    get book_slug_path(books(:handbook))
+
+    assert_in_body edit_book_page_path(books(:handbook), leaves(:welcome_page))
+  end
+
+  test "demoted editor loses controls on their next visit" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_in_body edit_book_page_path(books(:handbook), leaves(:welcome_page))
+
+    accesses(:kevin_handbook).update!(level: :reader)
+    get book_slug_path(books(:handbook))
+
+    assert_not_in_body edit_book_page_path(books(:handbook), leaves(:welcome_page))
+  end
+end
