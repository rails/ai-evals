diff --git a/test/integration/page_upload_lifecycle_test.rb b/test/integration/page_upload_lifecycle_test.rb
new file mode 100644
index 0000000..45eead6
--- /dev/null
+++ b/test/integration/page_upload_lifecycle_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class PageUploadLifecycleTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "uploaded image is fetchable via returned URL and purged after page destroy" do
+    post action_text_markdown_uploads_url, params: {
+      record_gid: pages(:welcome).to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+
+    assert_response :success
+    file_url = JSON.parse(response.body)["fileUrl"]
+    assert file_url.start_with?("/")
+
+    attachment = ActiveStorage::Attachment.order(:id).last
+    blob = attachment.blob
+    file_path = ActiveStorage::Blob.service.path_for(blob.key)
+
+    assert File.exist?(file_path), "uploaded file should exist on disk"
+
+    # Fetching the URL handed back by the app redirects to the stored file.
+    get file_url
+    assert_response :redirect
+    assert_match %r{/rails/active_storage/}, @response.redirect_url
+
+    page = pages(:welcome)
+    assert_enqueued_with(job: ActiveStorage::PurgeJob, args: [ blob ]) do
+      page.destroy!
+    end
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(file_path)
+
+    # The old URL no longer resolves.
+    get file_url
+    assert_response :not_found
+  end
+end
+
+class EditedPageUploadLifecycleTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "uploaded image survives a page edit and is purged when the page is destroyed" do
+    leaf = leaves(:welcome_page)
+
+    post action_text_markdown_uploads_url, params: {
+      record_gid: leaf.leafable.to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+
+    assert_response :success
+    file_url = JSON.parse(response.body)["fileUrl"]
+
+    attachment = ActiveStorage::Attachment.order(:id).last
+    blob = attachment.blob
+    file_path = ActiveStorage::Blob.service.path_for(blob.key)
+
+    leaf.edit leafable_params: { body: "Edited body that still references #{file_url}" }, leaf_params: {}
+
+    get file_url
+    assert_response :redirect
+
+    assert_enqueued_with(job: ActiveStorage::PurgeJob, args: [ blob ]) do
+      leaf.destroy!
+    end
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(file_path)
+
+    get file_url
+    assert_response :not_found
+  end
+end
diff --git a/test/models/leaf_destroy_cleanup_test.rb b/test/models/leaf_destroy_cleanup_test.rb
