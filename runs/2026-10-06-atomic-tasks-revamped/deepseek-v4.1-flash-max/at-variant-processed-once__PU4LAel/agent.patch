diff --git a/app/models/picture.rb b/app/models/picture.rb
index 9bcf18f..e838f41 100644
--- a/app/models/picture.rb
+++ b/app/models/picture.rb
@@ -2,7 +2,9 @@ class Picture < ApplicationRecord
   include Leafable
 
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    # A String format keeps the variant digest stable when the variation key is
+    # encoded into (and decoded from) the JSON representation used in its URL.
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..fd9f2b3 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -86,6 +86,39 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
     assert_select "figure img[src*=\"pixel.bmp\"]"
   end
 
+  test "show a picture does not process the image again after the background variant is stored" do
+    upload_picture
+    process_variant_jobs
+
+    picture = leaves(:reading_picture).reload.leafable
+    assert_equal 1, picture.image.blob.variant_records.count
+
+    assert_no_changes -> { picture.image.blob.variant_records.reload.count } do
+      get leafable_slug_path(leaves(:reading_picture))
+      assert_response :success
+      get css_select("figure img").first["src"]
+      assert_response :redirect
+    end
+
+    assert_no_enqueued_jobs only: ActiveStorage::TransformJob
+  end
+
+  test "show a picture before the background variant is stored still keeps one copy" do
+    upload_picture
+
+    get leafable_slug_path(leaves(:reading_picture))
+    assert_response :success
+    get css_select("figure img").first["src"]
+    assert_response :redirect
+
+    picture = leaves(:reading_picture).reload.leafable
+    assert_equal 1, picture.image.blob.variant_records.count
+
+    process_variant_jobs
+
+    assert_equal 1, picture.image.blob.variant_records.reload.count
+  end
+
   test "show with markdown format does not escape HTML entities" do
     leaves(:welcome_page).leafable.update!(body: "This has <a href='http://example.com'>a link</a>")
 
@@ -117,4 +150,17 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  private
+    def upload_picture
+      put leafable_path(leaves(:reading_picture)), params: {
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+      }
+      assert_response :no_content
+    end
+
+    def process_variant_jobs
+      perform_enqueued_jobs
+      perform_enqueued_jobs
+    end
 end
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..597664a 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -23,4 +23,11 @@ class PictureTest < ActiveSupport::TestCase
 
     assert_equal picture.image, picture.large_image
   end
+
+  test "large_image variation survives encoding into its URL key unchanged" do
+    variation = pictures(:reading).large_image.variation
+    decoded = ActiveStorage.verifier.verify(variation.key, purpose: :variation)
+
+    assert_equal variation.digest, ActiveStorage::Variation.new(decoded).digest
+  end
 end
