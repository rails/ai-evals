+require "test_helper"
+
+class BookPageDerivativeTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  test "book page and linked picture do not reprocess after background job" do
+    sign_in :kevin
+    upload_picture
+
+    blob = Picture.last.image.blob
+    assert_equal 1, blob.variant_records.count
+    derived_blob = blob.variant_records.first.image.blob
+
+    transform_events = 0
+    callback = ->(*) { transform_events += 1 }
+    ActiveSupport::Notifications.subscribed(callback, "transform.active_storage") do
+      get book_slug_path(books(:handbook))
+      assert_response :ok
+
+      get linked_picture_url
+      follow_redirect! if response.redirect?
+      assert_response :success
+      assert_equal derived_blob.download, response.body
+    end
+
+    assert_equal 1, blob.variant_records.reload.count
+    assert_equal 0, transform_events
+  end
+
+  test "background job does not duplicate a variant generated on demand" do
+    sign_in :kevin
+    upload_picture(perform_jobs: false)
+
+    blob = Picture.last.image.blob
+    assert_equal 0, blob.variant_records.count
+
+    get book_slug_path(books(:handbook))
+    get linked_picture_url
+    follow_redirect! if response.redirect?
+    assert_response :success
+    assert_equal 1, blob.variant_records.reload.count
+
+    perform_enqueued_jobs until ActiveJob::Base.queue_adapter.enqueued_jobs.empty?
+
+    assert_equal 1, blob.variant_records.reload.count
+  end
+
+  private
+    def upload_picture(perform_jobs: true)
+      if perform_jobs
+        perform_enqueued_jobs do
+          put leafable_path(leaves(:reading_picture)), params: picture_params
+        end
+      else
+        put leafable_path(leaves(:reading_picture)), params: picture_params
+      end
+      assert_response :no_content
+    end
+
+    def picture_params
+      { picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") } }
+    end
+
+    def linked_picture_url
+      response.body.scan(/<img[^>]+src="([^"]+)"/).flatten.find { |src| src.include?("active_storage") }
+    end
+end
