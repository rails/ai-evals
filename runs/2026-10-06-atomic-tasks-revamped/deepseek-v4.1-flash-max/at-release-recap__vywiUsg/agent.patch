@@ -0,0 +1,27 @@
+require "test_helper"
+
+class LibraryRecapTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    sign_in :kevin
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "library recents show the released title immediately after release" do
+    book = books(:handbook)
+    book.update! title: "Working Title"
+
+    patch book_release_path(book), params: { book: { title: "Final Title" } }
+
+    get root_path
+
+    assert_response :success
+    assert_select ".library__recents", text: /Final Title/
+    assert_select ".library__recents", text: /Published/
+    assert_select ".library__recents", text: /Working Title/, count: 0
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..3a1aa7b
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "updating a book writes a recap with its title and published state" do
+    book = books(:handbook)
+    book.update! title: "Updated Handbook"
+
+    assert_equal({ title: "Updated Handbook", published: false }, book.cached_recap)
+  end
+
+  test "recaps are kept per book" do
+    handbook, manual = books(:handbook), books(:manual)
+
+    handbook.update! title: "Updated Handbook"
+    manual.update! title: "Updated Manual"
+
+    assert_equal "Updated Handbook", handbook.cached_recap[:title]
+    assert_equal "Updated Manual", manual.cached_recap[:title]
+  end
+
+  test "releasing a book writes the released title and published state" do
+    book = books(:manual)
+
+    assert Book.finalize_release(book.id, title: "Released Manual", subtitle: "A subtitle")
+
+    assert_equal({ title: "Released Manual", published: true }, book.cached_recap)
+  end
+
+  test "recap reflects the committed state when a stale instance is saved in the same transaction" do
+    book = books(:handbook)
+    stale = Book.find(book.id)
+
+    Book.transaction do
+      book.update! title: "New Title"
+      stale.update! published: true
+    end
+
+    assert_equal({ title: "New Title", published: true }, book.cached_recap)
+  end
+
+  test "recaps expire on the configured schedule" do
+    book = books(:handbook)
+    book.update! title: "Updated Handbook"
+
+    travel_to Time.current + Rails.application.config.x.recap.expires_in + 1.minute do
+      assert_nil book.cached_recap
+    end
+  end
+end
