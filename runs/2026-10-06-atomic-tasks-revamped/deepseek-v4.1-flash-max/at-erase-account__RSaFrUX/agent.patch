diff --git a/test/models/user_erasure_test.rb b/test/models/user_erasure_test.rb
new file mode 100644
index 0000000..daa095e
--- /dev/null
+++ b/test/models/user_erasure_test.rb
@@ -0,0 +1,145 @@
+require "test_helper"
+
+class UserErasureTest < ActiveSupport::TestCase
+  test "erase removes the user and all of their personal data" do
+    user = User.create!(name: "Erasure Person", email_address: "erase@example.com", password: "secret123456")
+    other_user = User.create!(name: "Other Person", email_address: "other@example.com", password: "secret123456")
+
+    book = Book.create!(title: "Erase Private", author: user.name, everyone_access: false, creator: user)
+    leaf = book.press Page.new(body: "topsecretwords"), title: "Private Page"
+    page = leaf.page
+
+    session = user.sessions.start!(user_agent: "test", ip_address: "127.0.0.1")
+    reading_mark = ReadingMark.remember(leaf, user: user)
+    other_reading_mark = ReadingMark.remember(leaf, user: other_user)
+    other_event = SignInEvent.create!(action: :signed_in, email_address: "other@example.com", created_at: Time.current)
+
+    assert_not_empty SignInEvent.for_address("erase@example.com")
+
+    user.erase
+
+    assert_nil User.find_by(id: user.id)
+    assert_nil Session.find_by(id: session.id)
+    assert_nil Access.find_by(user_id: user.id)
+    assert_nil ReadingMark.find_by(id: reading_mark.id)
+    assert_nil ReadingMark.find_by(id: other_reading_mark.id)
+    assert_empty SignInEvent.for_address("erase@example.com")
+    assert SignInEvent.exists?(id: other_event.id)
+
+    assert_nil Book.find_by(id: book.id)
+    assert_nil Leaf.find_by(id: leaf.id)
+    assert_nil ActionText::Markdown.find_by(record: page)
+    assert_empty Leaf.search("topsecretwords")
+  end
+
+  test "erase keeps everyone books and bylines them Deleted author" do
+    user = User.create!(name: "Erasure Author", email_address: "author@example.com", password: "secret123456")
+    book = Book.create!(title: "Public Book", author: user.name, everyone_access: true, creator: user)
+    other_user = User.create!(name: "Reader Person", email_address: "reader@example.com", password: "secret123456")
+    leaf = book.press Page.new(body: "publicsharedwords"), title: "Public Page"
+
+    book.update_access(editors: [ user.id ], readers: [ other_user.id ])
+
+    user.erase
+
+    assert_nil User.find_by(id: user.id)
+    assert_equal "Deleted author", book.reload.author
+    assert_nil book.creator_id
+    assert_not book.accesses.exists?(user_id: user.id)
+    assert book.accesses.exists?(user_id: other_user.id)
+
+    assert_equal "Public Page", leaf.reload.title
+    assert_equal "publicsharedwords", leaf.page.body.content.to_s
+    assert_includes Leaf.search("publicsharedwords"), leaf
+  end
+
+  test "erase works for a previously deactivated user and removes sign in events under the original address" do
+    user = User.create!(name: "Deactivated Person", email_address: "alice@example.com", password: "secret123456")
+    other_user = User.create!(name: "Unrelated Person", email_address: "unrelated@example.com", password: "secret123456")
+    other_event = SignInEvent.create!(action: :signed_in, email_address: "unrelated@example.com", created_at: Time.current)
+
+    SignInEvent.create!(action: :signed_in, email_address: "alice@example.com", created_at: 1.day.ago)
+    user.deactivate
+    SignInEvent.create!(action: :signed_out, email_address: user.email_address, created_at: Time.current)
+
+    assert_not_empty SignInEvent.for_address("alice@example.com")
+    assert_not_empty SignInEvent.for_address(user.email_address)
+
+    user.erase
+
+    assert_nil User.find_by(id: user.id)
+    assert_empty SignInEvent.for_address("alice@example.com")
+    assert_empty SignInEvent.for_address(user.email_address)
+    assert SignInEvent.exists?(id: other_event.id)
+    assert User.exists?(id: other_user.id)
+  end
+
+  test "erase works for a deactivated user whose scrambled address has a non-uuid suffix" do
+    user = User.create!(name: "Legacy Person", email_address: "legacy@example.com", password: "secret123456")
+    SignInEvent.create!(action: :signed_in, email_address: "legacy@example.com", created_at: Time.current)
+
+    user.update! active: false, email_address: "legacy-deactivated-1234@example.com"
+
+    user.erase
+
+    assert_nil User.find_by(id: user.id)
+    assert_empty SignInEvent.for_address("legacy@example.com")
+  end
+
+  test "destroy erases the user just like erase" do
+    user = User.create!(name: "Destroy Person", email_address: "destroy@example.com", password: "secret123456")
+    book = Book.create!(title: "Destroy Shared", author: user.name, everyone_access: true, creator: user)
+
+    user.destroy
+
+    assert_nil User.find_by(id: user.id)
+    assert_equal "Deleted author", book.reload.author
+    assert_nil book.creator_id
+  end
+  test "erase removes historical leafables referenced by edits" do
+    user = User.create!(name: "History Person", email_address: "history@example.com", password: "secret123456")
+    book = Book.create!(title: "History Book", everyone_access: false, creator: user)
+    leaf = book.press Page.new(body: "current content"), title: "History Page"
+
+    old_page = Page.create!
+    ActionText::Markdown.create!(record: old_page, name: "body", content: "old secret content")
+    Edit.create!(leaf: leaf, leafable: old_page, action: :revision)
+
+    user.erase
+
+    assert_nil Book.find_by(id: book.id)
+    assert_nil Page.find_by(id: old_page.id)
+    assert_nil ActionText::Markdown.find_by(record: old_page)
+    assert_empty Edit.where(leaf_id: leaf.id)
+  end
+
+  test "erase removes every search index entry for a deleted book" do
+    user = User.create!(name: "Search Person", email_address: "search@example.com", password: "secret123456")
+    book = Book.create!(title: "Search Book", everyone_access: false, creator: user)
+    leaf_one = book.press Page.new(body: "firstunique term"), title: "First"
+    leaf_two = book.press Page.new(body: "secondunique term"), title: "Second"
+
+    user.erase
+
+    assert_empty Leaf.search("firstunique")
+    assert_empty Leaf.search("secondunique")
+    assert_nil Leaf.find_by(id: leaf_one.id)
+    assert_nil Leaf.find_by(id: leaf_two.id)
+  end
+
+  test "erase detaches everyone books even when Current.user is set" do
+    admin = User.create!(name: "Current Admin", email_address: "currentadmin@example.com", password: "secret123456")
+    user = User.create!(name: "Current Target", email_address: "currenttarget@example.com", password: "secret123456")
+    book = Book.create!(title: "Current Shared", author: user.name, everyone_access: true, creator: user)
+
+    Current.user = admin
+    user.erase
+
+    assert_nil book.reload.creator_id
+    assert_equal "Deleted author", book.author
+    book.update!(title: "Current Shared Updated")
+    assert_nil book.reload.creator_id
+  ensure
+    Current.user = nil
+  end
+end
