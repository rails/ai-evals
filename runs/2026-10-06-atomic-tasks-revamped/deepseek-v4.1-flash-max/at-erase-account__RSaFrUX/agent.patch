diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..d77bed6
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,72 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  # Matches the suffix generated by User#deactivate: "-deactivated-<uuid>".
+  DEACTIVATED_EMAIL_UUID_PATTERN = /-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i
+  DEACTIVATED_EMAIL_PATTERN = /-deactivated-.*\z/
+
+  # Permanently erases the user and all data belonging to them, except for
+  # books they created that are shared with everyone. Those keep working, but
+  # are detached from the user and bylined as "Deleted author".
+  def erase
+    transaction do
+      sessions.delete_all
+      reading_marks.delete_all
+      erase_created_books
+      accesses.delete_all
+      erase_sign_in_events
+      delete
+    end
+  end
+
+  # Allow a user to be destroyed directly, too.
+  def destroy
+    erase
+  end
+  alias_method :erase!, :erase
+
+  private
+    def erase_created_books
+      created_books.find_each do |book|
+        if book.everyone_access?
+          book.update_columns(creator_id: nil, author: "Deleted author", updated_at: Time.current)
+        else
+          erase_from_search_index book
+          book.destroy!
+        end
+      end
+    end
+
+    # Destroying leaves normally removes their search index rows via an
+    # after_destroy_commit callback. Do it explicitly as well so no stale
+    # search hits can survive the erasure, even if callbacks are bypassed.
+    def erase_from_search_index(book)
+      leaf_ids = book.leaves.ids
+      return if leaf_ids.empty?
+
+      self.class.connection.execute \
+        "delete from leaf_search_index where rowid in (#{leaf_ids.join(',')})"
+    end
+
+    def erase_sign_in_events
+      SignInEvent.where(email_address: sign_in_event_email_addresses).delete_all
+    end
+
+    # Sign-in events are keyed by the address the person actually signed in
+    # with. For people deactivated the old way, that's the original address,
+    # while their user row now has a rewritten "-deactivated-<uuid>" address.
+    def sign_in_event_email_addresses
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    def original_email_address
+      return unless email_address
+
+      local, domain = email_address.split("@", 2)
+      return email_address unless domain
+
+      original_local = local.gsub(DEACTIVATED_EMAIL_UUID_PATTERN, "")
+      original_local = local.gsub(DEACTIVATED_EMAIL_PATTERN, "") if original_local == local
+      "#{original_local}@#{domain}"
+    end
+end
