 class Books::SearchesController < ApplicationController
+  # Rate limit counters need a store that supports #increment. In production that
+  # is the shared Redis cache, so limits apply across server processes. Test and
+  # development environments sometimes use a null cache, so fall back to an
+  # in-process memory store there instead of silently disabling the limit.
+  class SearchRateLimitStore
+    def initialize(controller)
+      @controller = controller
+      @fallback_store = ActiveSupport::Cache::MemoryStore.new
+    end
+
+    def increment(name, amount = 1, **options)
+      store.increment(name, amount, **options)
+    end
+
+    private
+      def store
+        configured_store || @fallback_store
+      end
+
+      def configured_store
+        candidates = [ @controller.cache_store, ActionController::Base.cache_store, Rails.cache ]
+
+        candidates.find do |candidate|
+          candidate.respond_to?(:increment) && !candidate.is_a?(ActiveSupport::Cache::NullStore)
+        end
+      end
+  end
+
   allow_unauthenticated_access
 
+  rate_limit to: 30, within: 1.minute, only: :create,
+    store: SearchRateLimitStore.new(self),
+    with: -> { head :too_many_requests }
+
   include BookScoped
 
   def create
