diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..38d2af7 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -24,7 +24,41 @@ class User < ApplicationRecord
     end
   end
 
+  def erase
+    transaction do
+      sessions.delete_all
+      accesses.delete_all
+      reading_marks.delete_all
+
+      erase_created_books
+      erase_sign_in_events
+
+      delete
+    end
+  end
+
+  alias_method :destroy, :erase
+  alias_method :erase!, :erase
+  alias_method :purge, :erase
+
   private
+    def erase_created_books
+      created_books.where(everyone_access: false).find_each(&:destroy!)
+      created_books.where(everyone_access: true).update_all creator_id: nil, author: "Deleted author", updated_at: Time.current
+    end
+
+    def erase_sign_in_events
+      SignInEvent.where(email_address: erasure_email_addresses).delete_all
+    end
+
+    def erasure_email_addresses
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    def original_email_address
+      email_address&.gsub(/-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i, "")
+    end
+
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
