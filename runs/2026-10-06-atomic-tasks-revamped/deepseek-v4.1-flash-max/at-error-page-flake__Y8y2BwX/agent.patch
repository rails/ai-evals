diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..c65f3d1 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,24 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Requests read the per-request "action_dispatch.show_exceptions" header from
+    # Rails.application.env_config, which is memoized after first use. Toggling
+    # config.action_dispatch.show_exceptions after boot therefore does not affect
+    # requests and can leak stale values between tests in the same process.
+    # Toggle the memoized env_config value as well, restoring both afterwards.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      config = Rails.application.config
+      env_config = Rails.application.env_config
+      previous_config = config.action_dispatch.show_exceptions
+      previous_env_config = env_config["action_dispatch.show_exceptions"]
+
+      config.action_dispatch.show_exceptions = :none
+      env_config["action_dispatch.show_exceptions"] = :none
+
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config["action_dispatch.show_exceptions"] = previous_env_config
+      config.action_dispatch.show_exceptions = previous_config
     end
   end
 end
