diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..ef48eba 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -13,11 +13,26 @@ module ActiveSupport
     include SessionTestHelper
 
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      application = Rails.application
+
+      # `config.action_dispatch.show_exceptions` is baked into the application's
+      # memoized `env_config` when it is first requested. Changing the config
+      # after that has no effect on the env used for test requests, and changing
+      # it before the first request would freeze :none into `env_config` for the
+      # rest of the process. Read `env_config` first, then override the value
+      # for the duration of the block so every request inside (and only inside)
+      # the block raises controller exceptions.
+      env_config = application.env_config
+      previous_setting = application.config.action_dispatch.show_exceptions
+      previous_env_setting = env_config["action_dispatch.show_exceptions"]
+
+      application.config.action_dispatch.show_exceptions = :none
+      env_config["action_dispatch.show_exceptions"] = :none
+
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config["action_dispatch.show_exceptions"] = previous_env_setting
+      application.config.action_dispatch.show_exceptions = previous_setting
     end
   end
 end
