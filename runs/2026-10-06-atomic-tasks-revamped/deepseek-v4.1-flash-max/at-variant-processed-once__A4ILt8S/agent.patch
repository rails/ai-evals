--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class PicturesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -38,4 +40,41 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "derives the large image once and serves the stored copy to readers" do
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:reading_picture)), params: {
+        leaf: { title: "New picture" },
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+      }
+    end
+
+    assert_response :no_content
+
+    picture = Picture.last
+    blob = picture.image.blob
+    assert_equal 1, blob.variant_records.count
+    derived_image = blob.variant_records.first.image.download
+
+    transformations = []
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") do
+      transformations << true
+    end
+
+    begin
+      get leafable_slug_path(leaves(:reading_picture))
+      assert_response :success
+
+      image_url = css_select("figure img").first["src"]
+      get image_url
+      follow_redirect! if response.redirect?
+
+      assert_response :success
+      assert_equal derived_image, response.body
+      assert_empty transformations
+      assert_equal 1, blob.reload.variant_records.count
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+  end
 end
