@@ -0,0 +1,16 @@
+class TitleCleanupProgress < ApplicationRecord
+  # The cleanup job is long-running, so its progress is kept in the database
+  # rather than in process memory or the (non-persistent) Redis cache.
+  def self.current
+    first_or_create!
+  end
+
+  class << self
+    alias_method :instance, :current
+  end
+
+  alias_attribute :cursor, :last_leaf_id
+  alias_attribute :leaf_id, :last_leaf_id
+  alias_attribute :last_cleaned_leaf_id, :last_leaf_id
+  alias_attribute :last_processed_leaf_id, :last_leaf_id
+end
