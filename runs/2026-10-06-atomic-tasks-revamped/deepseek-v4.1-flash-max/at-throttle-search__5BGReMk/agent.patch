diff --git a/app/models/search_rate_limit_store.rb b/app/models/search_rate_limit_store.rb
new file mode 100644
index 0000000..d03af54
--- /dev/null
+++ b/app/models/search_rate_limit_store.rb
@@ -0,0 +1,80 @@
+# Cache store used to keep per-address rate limit counters for book searches.
+#
+# It resolves the store on every request so tests can swap in their own cache
+# store, while falling back to a small in-process store when no real cache
+# store is configured (for example when caching is disabled in development).
+class SearchRateLimitStore
+  KEY_PREFIX = "rate-limit:"
+
+  class << self
+    def register(instance)
+      instances << instance
+    end
+
+    def reset!
+      instances.each(&:reset!)
+      clear_store(ActionController::Base.cache_store)
+      clear_store(Rails.cache)
+    end
+
+    def clear_store(store)
+      store.delete_matched("#{KEY_PREFIX}*") if usable_store?(store)
+    rescue StandardError
+      # Some cache stores don't support deletion by pattern.
+    end
+
+    private
+      def instances
+        @instances ||= []
+      end
+
+      def usable_store?(store)
+        store && !store.is_a?(ActiveSupport::Cache::NullStore)
+      end
+  end
+
+  def initialize(controller_class)
+    @controller_class = controller_class
+    @initial_stores = current_stores
+    self.class.register(self)
+  end
+
+  def increment(key, amount = 1, **options)
+    cache_store.increment(key, amount, **options)
+  end
+
+  def reset!
+    @local_store&.clear
+    self.class.clear_store(@controller_class.cache_store)
+  end
+
+  private
+    def cache_store
+      changed_store || configured_store || local_store
+    end
+
+    # Prefer a store that has been swapped in since the controller was loaded,
+    # so per-test cache stores are honoured.
+    def changed_store
+      current_stores.zip(@initial_stores) do |store, initial|
+        return store if usable?(store) && store != initial
+      end
+      nil
+    end
+
+    def configured_store
+      current_stores.find { |store| usable?(store) }
+    end
+
+    def current_stores
+      [ @controller_class.cache_store, ActionController::Base.cache_store, Rails.cache ]
+    end
+
+    def usable?(store)
+      store && !store.is_a?(ActiveSupport::Cache::NullStore)
+    end
+
+    def local_store
+      @local_store ||= ActiveSupport::Cache::MemoryStore.new
+    end
+end
diff --git a/config/environments/test.rb b/config/environments/test.rb
index 75f22c6..02ef48f 100644
--- a/config/environments/test.rb
+++ b/config/environments/test.rb
@@ -20,10 +20,11 @@ Rails.application.configure do
   # Configure public file server for tests with Cache-Control for performance.
   config.public_file_server.headers = { "Cache-Control" => "public, max-age=#{1.hour.to_i}" }
 
-  # Show full error reports and disable caching.
+  # Show full error reports and disable fragment caching. A real cache
+  # store is needed so rate limits can be exercised in tests.
   config.consider_all_requests_local = true
   config.action_controller.perform_caching = false
-  config.cache_store = :null_store
+  config.cache_store = :memory_store
 
   # Render exception templates for rescuable exceptions and raise for other exceptions.
   config.action_dispatch.show_exceptions = :rescuable
@@ -62,3 +63,13 @@ Rails.application.configure do
   # Load test helpers
   config.autoload_paths += %w[ test/test_helpers ]
 end
+
+# Don't let rate limit counters from one test leak into another: tests share
+# the same default remote address, so each one should start with a clean slate.
+ActiveSupport.on_load(:action_dispatch_integration_test) do
+  setup { SearchRateLimitStore.reset! }
+end
+
+ActiveSupport.on_load(:action_controller_test_case) do
+  setup { SearchRateLimitStore.reset! }
+end
