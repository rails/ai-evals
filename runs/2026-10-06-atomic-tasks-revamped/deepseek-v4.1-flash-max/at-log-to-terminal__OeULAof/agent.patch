diff --git a/config/environments/development.rb b/config/environments/development.rb
index e1c3d90..14586a6 100644
--- a/config/environments/development.rb
+++ b/config/environments/development.rb
@@ -17,6 +17,23 @@ Rails.application.configure do
   # Enable server timing
   config.server_timing = true
 
+  # `rails runner` doesn't broadcast logs to STDOUT like `rails server` does in
+  # development. Broadcast to STDOUT in addition to log/development.log so
+  # command output (such as script/library_report.rb) is visible in the
+  # terminal, while the log file remains the authoritative record.
+  config.after_initialize do
+    unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDERR, STDOUT)
+      console = ActiveSupport::Logger.new(STDOUT)
+      console.formatter = Rails.logger.formatter
+
+      # Keep the terminal focused on the report: debug-level query logs still
+      # go to the log file, but don't clutter what the on-call sees.
+      console.level = [ Rails.logger.level, Logger::INFO ].max
+
+      Rails.logger.broadcast_to(console)
+    end
+  end
+
   # Enable/disable caching. By default caching is disabled.
   # Run rails dev:cache to toggle caching.
   if Rails.root.join("tmp/caching-dev.txt").exist?
