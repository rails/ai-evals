index 0000000..1b6f851
--- /dev/null
+++ b/config/initializers/resque.rb
@@ -0,0 +1,10 @@
+# Workers run in-process (FORK_PER_JOB=false), so continuations can observe
+# Resque's shutdown request and requeue at their next checkpoint.
+module ResqueWorkerShutdown
+  def shutdown
+    super
+    ActiveJob::Base.queue_adapter.stopping = true
+  end
+end
+
+Resque::Worker.prepend ResqueWorkerShutdown
diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
