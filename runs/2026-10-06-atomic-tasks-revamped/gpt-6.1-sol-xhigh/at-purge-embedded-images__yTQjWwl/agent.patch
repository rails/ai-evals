diff --git a/test/models/page_test.rb b/test/models/page_test.rb
index b4bb79b..1083a34 100644
--- a/test/models/page_test.rb
+++ b/test/models/page_test.rb
@@ -1,6 +1,88 @@
 require "test_helper"
 
 class PageTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges its embedded images" do
+    page = pages(:welcome)
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = page.body.uploads.last
+    blob = attachment.blob
+    page.update! body: "![Reading](#{attachment.slug_path})"
+
+    assert blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActionText::Markdown.exists?(record: page)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+
+  test "destroying a page purges all of its uploaded images" do
+    page = pages(:welcome)
+    %w[ reading.webp white-rabbit.webp ].each do |filename|
+      page.body.uploads.attach io: file_fixture(filename).open, filename: filename, content_type: "image/webp"
+    end
+    attachments = page.body.uploads.to_a
+    blobs = attachments.map(&:blob)
+    page.update! body: attachments.map { |attachment| "![Image](#{attachment.slug_path})" }.join("\n\n")
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    blobs.each do |blob|
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+  end
+
+  test "destroying a page preserves images still attached to another page" do
+    page = pages(:welcome)
+    other_page = pages(:summary)
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    blob = page.body.uploads.last.blob
+    other_page.body.uploads.attach blob
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert blob.service.exist?(blob.key)
+    assert_equal file_fixture("reading.webp").binread, other_page.body.uploads.last.download
+
+    perform_enqueued_jobs do
+      other_page.destroy!
+    end
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+
+  test "rolling back page destruction preserves uploaded images" do
+    page = pages(:welcome)
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = page.body.uploads.last
+    blob = attachment.blob
+
+    perform_enqueued_jobs do
+      Page.transaction(requires_new: true) do
+        page.destroy!
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert Page.exists?(page.id)
+    assert ActiveStorage::Attachment.exists?(attachment.id)
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert blob.service.exist?(blob.key)
+  end
+
   test "html preview" do
     page = Page.new(body: "# Hello\n\nWorld!")
 
