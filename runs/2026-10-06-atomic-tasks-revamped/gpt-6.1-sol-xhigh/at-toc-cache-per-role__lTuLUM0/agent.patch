diff --git a/test/controllers/books_toc_caching_test.rb b/test/controllers/books_toc_caching_test.rb
new file mode 100644
index 0000000..cdbaae6
--- /dev/null
+++ b/test/controllers/books_toc_caching_test.rb
@@ -0,0 +1,188 @@
+require "test_helper"
+
+class BooksTocCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    # Load the login rate limiter while the normal test cache store is still in use.
+    SessionsController.name
+
+    @previous_perform_caching = ActionController::Base.perform_caching
+    @previous_rails_cache = Rails.cache
+    @previous_controller_cache = ActionController::Base.cache_store
+    @previous_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    @cache = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.perform_caching = true
+    Rails.cache = ActionController::Base.cache_store = ActionView::PartialRenderer.collection_cache = @cache
+
+    @book = books(:handbook)
+    sign_in :kevin
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = @previous_perform_caching
+    Rails.cache = @previous_rails_cache
+    ActionController::Base.cache_store = @previous_controller_cache
+    ActionView::PartialRenderer.collection_cache = @previous_collection_cache
+  end
+
+  test "reader does not receive editor entries from a warm collection cache" do
+    get book_slug_path(@book)
+    assert_toc_controls editable: true
+
+    sign_in :jz
+    get book_slug_path(@book)
+    assert_toc_controls editable: false
+
+    sign_in :kevin
+    get book_slug_path(@book)
+    assert_toc_controls editable: true
+  end
+
+  test "editor receives editor entries after a reader warms the collection cache" do
+    sign_in :jz
+    get book_slug_path(@book)
+    assert_response :success
+    assert_not_in_body "Edit Summary"
+
+    sign_in :kevin
+    get book_slug_path(@book)
+    assert_toc_controls editable: true
+
+    sign_in :jz
+    get book_slug_path(@book)
+    assert_toc_controls editable: false
+  end
+
+  test "a fresh reader receives no move or delete controls" do
+    sign_in :jz
+    get book_slug_path(@book)
+    assert_toc_controls editable: false
+  end
+
+  test "anonymous readers do not receive cached editor controls" do
+    @book.update!(published: true)
+    get book_slug_path(@book)
+    assert_toc_controls editable: true
+
+    sign_out
+    get book_slug_path(@book)
+    assert_toc_controls editable: false
+  end
+
+  test "entry renames invalidate both permission variants" do
+    get book_slug_path(@book)
+    sign_in :jz
+    get book_slug_path(@book)
+
+    leaf = leaves(:summary_page)
+    leaf.update!(title: "Renamed summary")
+
+    get book_slug_path(@book)
+    assert_toc_controls editable: false
+    assert_in_body "Renamed summary"
+    assert_not_in_body "Open Summary"
+
+    sign_in :kevin
+    get book_slug_path(@book)
+    assert_toc_controls editable: true
+    assert_in_body "Edit Renamed summary"
+    assert_not_in_body "Edit Summary"
+  end
+
+  test "access changes select the current permission variant without touching the book" do
+    get book_slug_path(@book)
+    assert_toc_controls editable: true
+
+    accesses(:kevin_handbook).update!(level: :reader)
+    get book_slug_path(@book)
+    assert_toc_controls editable: false
+
+    accesses(:kevin_handbook).update!(level: :editor)
+    get book_slug_path(@book)
+    assert_toc_controls editable: true
+  end
+
+  test "single entry updates still render editor controls and invalidate the reader cache" do
+    sign_in :jz
+    get book_slug_path(@book)
+    assert_toc_controls editable: false
+
+    sign_in :kevin
+    leaf = leaves(:summary_page)
+    put leafable_path(leaf, format: :turbo_stream), params: { leaf: { title: "Updated summary" } }
+    assert_response :success
+    assert_in_body "Edit Updated summary"
+    assert_in_body "Delete Updated summary"
+
+    sign_in :jz
+    get book_slug_path(@book)
+    assert_toc_controls editable: false
+    assert_in_body "Updated summary"
+    assert_not_in_body "Open Summary"
+  end
+
+  test "collection cache uses one bulk read and reuses entries when the book fragment is cold" do
+    get book_slug_path(@book)
+    @book.touch
+
+    cache_reads = []
+    renders = []
+    cache_subscriber = ->(event) { cache_reads << event.payload }
+    render_subscriber = ->(event) { renders << event.payload if event.payload[:identifier].end_with?("leaves/_leaf.html.erb") }
+
+    ActiveSupport::Notifications.subscribed(cache_subscriber, "cache_read_multi.active_support") do
+      ActiveSupport::Notifications.subscribed(render_subscriber, "render_collection.action_view") do
+        get book_slug_path(@book)
+      end
+    end
+    assert_toc_controls editable: true
+    assert_equal 1, cache_reads.size
+    assert_equal @book.leaves.active.count, cache_reads.first[:key].size
+    assert_equal 0, renders.sole[:cache_hits]
+
+    # Warm the new book version, then evict only the enclosing book fragment.
+    @cache.delete_matched(/books\/show/)
+    cache_reads.clear
+    renders.clear
+    ActiveSupport::Notifications.subscribed(cache_subscriber, "cache_read_multi.active_support") do
+      ActiveSupport::Notifications.subscribed(render_subscriber, "render_collection.action_view") do
+        get book_slug_path(@book)
+      end
+    end
+
+    assert_toc_controls editable: true
+    assert_equal 1, cache_reads.size
+    assert_equal @book.leaves.active.count, renders.sole[:cache_hits]
+  end
+
+  test "collection rendering does not query access once per entry" do
+    queries = []
+    subscriber = ->(event) { queries << event.payload[:sql] }
+
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      get book_slug_path(@book)
+    end
+
+    assert_toc_controls editable: true
+    # The book view and its publication controls each check permission once.
+    access_queries = queries.grep(/SELECT.*FROM "accesses"/)
+    assert_operator access_queries.size, :<=, 2, "Permission queries should not scale with the number of entries: #{access_queries.inspect}"
+    assert_equal 1, queries.grep(/SELECT.*FROM "leaves"/).reject { |sql| sql.include?("LIMIT") }.size
+    assert_equal 1, queries.grep(/SELECT.*FROM "books"/).size
+  end
+
+  private
+    def assert_toc_controls(editable:)
+      assert_response :success
+
+      [ :welcome_section, :welcome_page, :summary_page, :reading_picture ].each do |name|
+        leaf = leaves(name).reload
+        assert_select "#leaf_#{leaf.id}" do
+          assert_select "a[href='#{edit_leafable_path(leaf)}']", count: editable ? 2 : 0
+          assert_select ".arrangement__handle", count: editable ? 1 : 0
+          assert_select "form.leaf__delete", count: editable ? 1 : 0
+          assert_select "a[href='#{leafable_slug_path(leaf)}']", count: 2
+        end
+      end
+    end
+end
