diff --git a/test/lib/sqlite_strings_test.rb b/test/lib/sqlite_strings_test.rb
new file mode 100644
index 0000000..eecab5f
--- /dev/null
+++ b/test/lib/sqlite_strings_test.rb
@@ -0,0 +1,16 @@
+require "test_helper"
+
+class SQLiteStringsTest < ActiveSupport::TestCase
+  test "unknown double quoted identifiers raise instead of becoming strings" do
+    error = assert_raises ActiveRecord::StatementInvalid do
+      ActiveRecord::Base.connection.execute('SELECT "position_socre" FROM leaves')
+    end
+    assert_match(/no such column.*position_socre/, error.message)
+  end
+
+  test "valid double quoted identifiers still work" do
+    assert_equal [ 1, 2, 3, 4 ], ActiveRecord::Base.connection.select_values(<<~SQL)
+      SELECT "position_score" FROM leaves ORDER BY "position_score", "id"
+    SQL
+  end
+end
diff --git a/test/models/book/maintenance_test.rb b/test/models/book/maintenance_test.rb
new file mode 100644
index 0000000..b75c604
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+    @ordered_leaves = @book.leaves.order(id: :desc).to_a
+    @ordered_leaves.each.with_index(1) { |leaf, index| leaf.update!(position_score: index * 10) }
+  end
+
+  test "compaction preserves score order while removing gaps" do
+    @book.compact_positions!
+
+    assert_equal @ordered_leaves, @book.leaves.positioned
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compaction preserves the position of trashed leaves when restored" do
+    trashed_leaf = leaves(:welcome_page)
+    trashed_leaf.trashed!
+
+    @book.compact_positions!
+
+    assert_equal @ordered_leaves, @book.leaves.positioned
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    assert_equal @ordered_leaves.excluding(trashed_leaf), @book.leaves.active.positioned
+    assert_equal 3, @book.live_leaf_count
+
+    trashed_leaf.active!
+
+    assert_equal @ordered_leaves, @book.leaves.active.positioned
+    assert_equal 4, @book.live_leaf_count
+  end
+
+  test "compaction breaks score ties by id and is idempotent" do
+    @book.leaves.update_all(position_score: 10)
+    expected_order = @book.leaves.order(:id).to_a
+
+    2.times do
+      @book.compact_positions!
+
+      assert_equal expected_order, @book.leaves.positioned
+      assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    end
+  end
+
+  test "compaction only updates leaves belonging to its book" do
+    other_leaf = @ordered_leaves.pop
+    other_leaf.update!(book: books(:manual))
+    original_score = other_leaf.position_score
+
+    @book.compact_positions!
+
+    assert_equal @ordered_leaves, @book.leaves.positioned
+    assert_equal [ 1, 2, 3 ], @book.leaves.positioned.pluck(:position_score)
+    assert_equal original_score, other_leaf.reload.position_score
+  end
+
+  test "compaction of a single leaf gives it the first score" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(book: books(:manual), position_score: 42)
+
+    books(:manual).compact_positions!
+
+    assert_equal [ leaf ], books(:manual).leaves.positioned
+    assert_equal 1, leaf.reload.position_score
+  end
+
+  test "compaction includes leaves in a fully trashed book" do
+    @book.leaves.update_all(status: :trashed)
+
+    @book.compact_positions!
+
+    assert_equal @ordered_leaves, @book.leaves.positioned
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    assert_equal 0, @book.live_leaf_count
+  end
+
+  test "compaction of an empty book leaves other books alone" do
+    original_scores = @book.leaves.positioned.pluck(:position_score)
+
+    books(:manual).compact_positions!
+
+    assert_empty books(:manual).leaves
+    assert_equal original_scores, @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "live leaf count only counts active leaves in this book" do
+    leaves(:welcome_page).trashed!
+    leaves(:summary_page).update!(book: books(:manual))
+
+    assert_equal 2, @book.live_leaf_count
+    assert_equal 1, books(:manual).live_leaf_count
+  end
+
+  test "live leaf count returns zero for empty and fully trashed books" do
+    assert_equal 0, books(:manual).live_leaf_count
+
+    @book.leaves.update_all(status: :trashed)
+
+    assert_equal 0, @book.live_leaf_count
+  end
+end
