+++ b/app/jobs/title_cleanup_job.rb
@@ -1,8 +1,28 @@
 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  # Resque doesn't support delayed retries without resque-scheduler.
+  self.resume_options = {}
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    checkpoint = TitleCleanupCheckpoint.find_or_create_by!(id: 1)
+
+    step :clean_titles do |step|
+      start = [ checkpoint.last_leaf_id + 1, step.cursor || 0 ].max
+      Leaf.find_each(start: start, order: :asc) do |leaf|
+        checkpoint.with_lock do
+          # Keep the title and durable cursor atomic, even if the worker is killed
+          # before it can serialize its continuation or after the title is saved.
+          if leaf.id > checkpoint.last_leaf_id
+            leaf.reload.update!(title: cleaned(leaf.title))
+            checkpoint.update!(last_leaf_id: leaf.id)
+          end
+        end
+        step.advance! from: leaf.id
+      end
     end
+  rescue Resque::TermException
+    interrupt!(reason: :stopping)
   end
 
   private
