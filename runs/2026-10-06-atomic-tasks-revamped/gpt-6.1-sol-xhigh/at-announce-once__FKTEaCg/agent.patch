diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..97b617a
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,212 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  self.use_transactional_tests = false
+
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "publishing announces the book once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ] do
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "publishing and adding a page announces only after the sitting commits" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: "New page"), title: "Introduction"
+
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "publishing and saving the book again announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! title: "New title"
+        @book.update! published: true
+        @book.touch
+
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+  end
+
+  test "saving an already published book does not announce again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true, title: "New title"
+        leaves(:welcome_page).update! title: "Renamed page"
+        @book.touch
+      end
+    end
+  end
+
+  test "unpublishing does not announce" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "saving a draft does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "New title"
+    end
+  end
+
+  test "a failed sitting leaves the book a draft and does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_no_difference -> { @book.leaves.count } do
+        assert_raises ActiveRecord::RecordNotFound do
+          Book.transaction do
+            @book.update! published: true
+            @book.press Page.new(body: "New page"), title: "Introduction"
+            @book.leaves.find(-1).update! status: :trashed
+          end
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "publishing with renamed and trashed pages announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        leaves(:welcome_page).update! title: "Renamed page"
+        leaves(:summary_page).update! status: :trashed
+
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "a sitting that ends with a draft does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+        @book.touch
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "multiple publication changes in a sitting announce once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "a sitting that starts and ends live does not announce again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "publication checks the persisted state rather than unsaved attributes" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.published = false
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "publishing again after a failed sitting announces once" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.reload.published?
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "a later sitting can announce a new publication" do
+    @book.update! published: true
+    @book.update! published: false
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "nested publication waits for the outer sitting to commit" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.transaction(requires_new: true) do
+          @book.update! published: true
+        end
+
+        @book.update! published: false
+        @book.update! published: true
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+  end
+
+  test "rolling back the outer sitting cancels a nested publication" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.transaction(requires_new: true) do
+          @book.update! published: true
+        end
+
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "rolling back nested page changes does not lose an outer publication" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+
+        Book.transaction(requires_new: true) do
+          @book.press Page.new(body: "New page"), title: "Introduction"
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert @book.reload.published?
+  end
+end
