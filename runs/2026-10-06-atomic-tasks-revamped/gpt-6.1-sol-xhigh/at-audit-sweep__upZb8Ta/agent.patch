diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..59fd29b 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,83 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "readers cannot change or delete books" do
+    sign_in :jz
+    book = books(:handbook)
+
+    get edit_book_path(book)
+    assert_response :forbidden
+
+    patch book_path(book), params: { book: { title: "Changed" }, editor_ids: [ users(:jz).id ] }
+    assert_response :forbidden
+    assert_equal "Handbook", book.reload.title
+    assert book.access_for(user: users(:jz)).reader?
+
+    assert_no_difference [ "Book.count", "Leaf.count" ] do
+      delete book_path(book)
+    end
+    assert_response :forbidden
+  end
+
+  test "publication does not let signed in users change or delete a book" do
+    book = books(:manual)
+    book.update!(published: true)
+
+    get edit_book_path(book)
+    assert_response :forbidden
+
+    patch book_path(book), params: { book: { title: "Changed" } }
+    assert_response :forbidden
+    assert_equal "Manual", book.reload.title
+
+    assert_no_difference [ "Book.count", "Leaf.count" ] do
+      delete book_path(book)
+    end
+    assert_response :forbidden
+  end
+
+  test "editors can change and delete books" do
+    book = books(:handbook)
+
+    get edit_book_path(book)
+    assert_response :success
+
+    patch book_path(book), params: { book: { title: "Updated handbook" } }
+    assert_redirected_to book_slug_path(book.reload)
+    assert_equal "Updated handbook", book.title
+
+    assert_difference "Book.count", -1 do
+      delete book_path(book)
+    end
+    assert_redirected_to root_path
+  end
+
+  test "administrators can change and delete readable books" do
+    sign_in :david
+    book = books(:manual)
+    book.access_for(user: users(:david)).update!(level: :reader)
+
+    patch book_path(book), params: { book: { title: "Updated manual" } }
+    assert_redirected_to book_slug_path(book.reload)
+    assert_equal "Updated manual", book.title
+
+    assert_difference "Book.count", -1 do
+      delete book_path(book)
+    end
+    assert_redirected_to root_path
+  end
+
+  test "inaccessible books cannot be changed or deleted" do
+    book = books(:manual)
+
+    patch book_path(book), params: { book: { title: "Changed" } }
+    assert_response :not_found
+    assert_equal "Manual", book.reload.title
+
+    assert_no_difference "Book.count" do
+      delete book_path(book)
+    end
+    assert_response :not_found
+  end
 end
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..dc5c4b4 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,68 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "a private page cannot be read under an accessible book's id" do
+    leaf = leaves(:summary_page)
+    leaf.update!(book: books(:manual))
+
+    [ nil, :md ].each do |format|
+      get leafable_slug_path(leaf, format: format)
+      assert_response :not_found
+
+      get slugged_leafable_path(books(:handbook), books(:handbook).slug, leaf, leaf.slug, format: format)
+      assert_response :not_found
+
+      get book_page_path(books(:handbook), leaf, format: format)
+      assert_response :not_found
+    end
+  end
+
+  test "a private page cannot be read under a published book's id while signed out" do
+    leaf = leaves(:summary_page)
+    leaf.update!(book: books(:manual))
+    books(:handbook).update!(published: true)
+    sign_out
+
+    [ nil, :md ].each do |format|
+      get leafable_slug_path(leaf, format: format)
+      assert_response :not_found
+
+      get slugged_leafable_path(books(:handbook), books(:handbook).slug, leaf, leaf.slug, format: format)
+      assert_response :not_found
+
+      get book_page_path(books(:handbook), leaf, format: format)
+      assert_response :not_found
+    end
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+    get book_page_path(books(:handbook), leaves(:welcome_page), format: :md)
+    assert_response :success
+  end
+
+  test "edit access to one book cannot change or trash a page from another" do
+    leaf = leaves(:summary_page)
+    leaf.update!(book: books(:manual))
+
+    get edit_book_page_path(books(:handbook), leaf)
+    assert_response :not_found
+
+    patch book_page_path(books(:handbook), leaf), params: { leaf: { title: "Changed" }, page: { body: "Changed" } }
+    assert_response :not_found
+    assert_equal "Summary", leaf.reload.title
+
+    delete book_page_path(books(:handbook), leaf)
+    assert_response :not_found
+    assert leaf.reload.active?
+  end
+
+  test "readers can read pages in their book" do
+    sign_in :jz
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+    get book_page_path(books(:handbook), leaves(:welcome_page), format: :md)
+    assert_response :success
+  end
 end
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..87cb40d
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    leaves(:summary_page).update!(book: books(:manual))
+  end
+
+  test "ordinary title search is case insensitive and finds partial matches" do
+    [ "Handbook", "hAnDbOoK", "book", "  Handbook  " ].each do |query|
+      get library_search_path, params: { q: query }
+      assert_results leaves(:welcome_page)
+    end
+  end
+
+  test "empty searches have no results" do
+    [ nil, "", "   " ].each do |query|
+      get library_search_path, params: { q: query }
+      assert_results
+    end
+  end
+
+  test "results only come from books the searcher may read" do
+    get library_search_path, params: { q: "Summary" }
+    assert_results
+
+    sign_in :jz
+    get library_search_path, params: { q: "Summary" }
+    assert_results leaves(:summary_page)
+  end
+
+  test "published books can be searched by members and signed out readers" do
+    books(:manual).update!(published: true)
+
+    get library_search_path, params: { q: "Summary" }
+    assert_results leaves(:summary_page)
+
+    sign_out
+    get library_search_path, params: { q: "Summary" }
+    assert_results leaves(:summary_page)
+    get library_search_path, params: { q: "Handbook" }
+    assert_results
+  end
+
+  test "SQL syntax in a term cannot bypass book access" do
+    [ "' OR 1=1 OR leaves.title LIKE '", "' OR 1=1 --", "%' OR 1=1 --", "' UNION SELECT * FROM leaves --" ].each do |query|
+      get library_search_path, params: { q: query }
+      assert_results
+    end
+  end
+
+  test "SQL syntax cannot expose private books to signed out readers" do
+    sign_out
+
+    get library_search_path, params: { q: "' OR 1=1 OR leaves.title LIKE '" }
+    assert_results
+  end
+
+  test "apostrophes are searched as data" do
+    leaves(:welcome_page).update!(title: "Reader's guide")
+
+    [ "Reader's guide", "'" ].each do |query|
+      get library_search_path, params: { q: query }
+      assert_results leaves(:welcome_page)
+    end
+  end
+
+  test "percent signs are literal without being removed" do
+    leaves(:welcome_page).update!(title: "Save 50% off")
+    leaves(:summary_page).update!(title: "Private 50% off")
+
+    [ "Save 50% off", "%", "50%" ].each do |query|
+      get library_search_path, params: { q: query }
+      assert_results leaves(:welcome_page)
+    end
+  end
+
+  test "underscores are literal without being removed" do
+    leaves(:welcome_page).update!(title: "snake_case")
+
+    [ "snake_case", "_" ].each do |query|
+      get library_search_path, params: { q: query }
+      assert_results leaves(:welcome_page)
+    end
+  end
+
+  test "backslashes and mixed punctuation are literal" do
+    leaves(:welcome_page).update!(title: "Reader's \\50%_off")
+    leaves(:welcome_section).update!(title: "Reader's 50 percent off")
+
+    [ "\\", "\\50%_", "Reader's \\50%_off", "%_" ].each do |query|
+      get library_search_path, params: { q: query }
+      assert_results leaves(:welcome_page)
+    end
+  end
+
+  test "trashed leaves do not appear in search results" do
+    leaves(:welcome_page).trashed!
+
+    get library_search_path, params: { q: "Handbook" }
+    assert_results
+  end
+
+  private
+    def assert_results(*leaves)
+      assert_response :success
+      assert_select "a.search__result", count: leaves.size
+      leaves.each do |leaf|
+        assert_select "a.search__result[href=?]", leafable_slug_path(leaf)
+      end
+    end
+end
diff --git a/test/controllers/users/profiles_controller_test.rb b/test/controllers/users/profiles_controller_test.rb
index 7564f7d..2804413 100644
--- a/test/controllers/users/profiles_controller_test.rb
+++ b/test/controllers/users/profiles_controller_test.rb
@@ -38,4 +38,46 @@ class Users::ProfilesControllerTest < ActionDispatch::IntegrationTest
     assert_response :forbidden
     assert_equal "Kevin", users(:kevin).reload.name
   end
+
+  test "members can change their profile but cannot grant themselves a role" do
+    sign_in :kevin
+
+    patch user_profile_path(users(:kevin)), params: { user: {
+      name: "Updated Kevin", email_address: "updated@example.com", password: "new-secret123456", role: "administrator"
+    } }
+
+    assert_redirected_to users_path
+    user = users(:kevin).reload
+    assert_equal "Updated Kevin", user.name
+    assert_equal "updated@example.com", user.email_address
+    assert user.authenticate("new-secret123456")
+    assert user.member?
+  end
+
+  test "profile updates do not change an administrator's role" do
+    sign_in :david
+
+    patch user_profile_path(users(:david)), params: { user: {
+      name: "Updated David", email_address: "updated@example.com", password: "new-secret123456", role: "member"
+    } }
+
+    assert_redirected_to users_path
+    user = users(:david).reload
+    assert_equal "Updated David", user.name
+    assert_equal "updated@example.com", user.email_address
+    assert user.authenticate("new-secret123456")
+    assert user.administrator?
+  end
+
+  test "members cannot change other users' profiles or roles" do
+    sign_in :kevin
+
+    [ users(:jz), users(:david) ].each do |user|
+      original = user.attributes
+      patch user_profile_path(user), params: { user: { name: "Changed", role: "administrator" } }
+
+      assert_response :forbidden
+      assert_equal original, user.reload.attributes
+    end
+  end
 end
