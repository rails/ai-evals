@@ -0,0 +1,26 @@
+module RaisedExceptionsTestHelper
+  CONTEXT_KEY = :writebook_test_raised_exceptions
+
+  def with_raised_exceptions
+    previous = Thread.current[CONTEXT_KEY]
+    Thread.current[CONTEXT_KEY] = true
+    yield
+  ensure
+    Thread.current[CONTEXT_KEY] = previous
+  end
+
+  module ApplicationEnvironment
+    def env_config
+      environment = super
+
+      # Rails caches this hash and merges it into every request. Override a copy,
+      # not the configuration or cache shared by other tests and requests.
+      # Thread#[] is fiber-local, so concurrent execution contexts stay isolated.
+      if Thread.current[CONTEXT_KEY]
+        environment.merge("action_dispatch.show_exceptions" => :none)
+      else
+        environment
+      end
+    end
+  end
+end
