diff --git a/test/integration/editing_presence_test.rb b/test/integration/editing_presence_test.rb
new file mode 100644
index 0000000..301a2e7
--- /dev/null
+++ b/test/integration/editing_presence_test.rb
@@ -0,0 +1,213 @@
+require "test_helper"
+
+class EditingPresenceTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+  include ActionCable::TestHelper
+
+  setup do
+    @leaf = leaves(:welcome_page)
+    @book = books(:handbook)
+    sign_in :kevin
+  end
+
+  test "saving still delivers the being edited indicator to another editor" do
+    stream = subscribed_stream
+    sign_in :jason
+
+    messages = capture_broadcasts(stream) { save_page }
+
+    assert_equal 1, messages.size
+    indicator = Nokogiri::HTML.fragment(messages.first)
+    assert_select indicator, "turbo-stream[action=append][target=being_edited_leaf_#{@leaf.id}]", count: 1
+    assert_select indicator, "[data-hide-from-user-id='#{users(:jason).id}'] strong", text: "Jason"
+    assert_select indicator, "[data-controller=autoremove]", count: 1
+  end
+
+  test "a removed collaborator's open editor receives no presence payload" do
+    removed_stream = subscribed_stream
+    @book.update! everyone_access: false
+    @book.update_access editors: [ users(:david).id, users(:jason).id ], readers: [ users(:jz).id ]
+    sign_in :jason
+    editor_stream = subscribed_stream
+
+    assert_no_broadcasts removed_stream do
+      assert_broadcasts(editor_stream, 1) { save_page }
+    end
+  end
+
+  test "access is checked when a queued presence update is delivered" do
+    removed_stream = subscribed_stream
+    sign_in :jason
+    editor_stream = subscribed_stream
+    put leafable_path(@leaf), params: { page: { body: "Updated by Jason" } }
+    assert_response :no_content
+
+    @book.update! everyone_access: false
+    @book.update_access editors: [ users(:david).id, users(:jason).id ], readers: []
+
+    assert_no_broadcasts removed_stream do
+      assert_broadcasts(editor_stream, 1) { perform_enqueued_jobs }
+    end
+  end
+
+  test "presence streams are scoped to both the viewer and the page" do
+    kevin_stream = subscribed_stream
+    assert_equal presence_stream(users(:kevin)), kevin_stream
+
+    sign_in :jason
+    jason_stream = subscribed_stream
+    assert_equal presence_stream(users(:jason)), jason_stream
+    assert_not_equal kevin_stream, jason_stream
+
+    @leaf = leaves(:summary_page)
+    assert_not_equal jason_stream, subscribed_stream
+  end
+
+  test "presence is never sent to the legacy shared stream or a reader's stream" do
+    shared_stream = stream_name(@leaf, :being_edited)
+
+    assert_no_broadcasts shared_stream do
+      assert_no_broadcasts presence_stream(users(:jz)) do
+        assert_broadcasts(presence_stream(users(:david)), 1) { save_page }
+      end
+    end
+  end
+
+  test "a collaborator downgraded to reader receives no presence even on a published book" do
+    reader_stream = subscribed_stream
+    @book.update! published: true
+    @book.update_access editors: [ users(:david).id, users(:jason).id ], readers: []
+    assert @book.accessable?(user: users(:kevin))
+    assert_not @book.editable?(user: users(:kevin))
+    sign_in :jason
+
+    assert_no_broadcasts reader_stream do
+      assert_broadcasts(presence_stream(users(:jason)), 1) { save_page }
+    end
+  end
+
+  test "queued presence respects a downgrade to reader" do
+    reader_stream = subscribed_stream
+    sign_in :jason
+    put leafable_path(@leaf), params: { page: { body: "Updated by Jason" } }
+    assert_response :no_content
+    accesses(:kevin_handbook).reader!
+
+    assert_no_broadcasts reader_stream do
+      assert_broadcasts(presence_stream(users(:jason)), 1) { perform_enqueued_jobs }
+    end
+  end
+
+  test "a deactivated collaborator's open editor receives no presence" do
+    inactive_stream = subscribed_stream
+    users(:kevin).deactivate
+    sign_in :jason
+
+    assert_no_broadcasts inactive_stream do
+      assert_broadcasts(presence_stream(users(:jason)), 1) { save_page }
+    end
+  end
+
+  test "administrators with reader access still receive the indicator" do
+    sign_in :david
+    administrator_stream = subscribed_stream
+    accesses(:david_handbook).reader!
+    sign_in :jason
+
+    assert_broadcasts(administrator_stream, 1) { save_page }
+  end
+
+  test "administrators can receive the indicator for a published book without an access" do
+    sign_in :david
+    administrator_stream = subscribed_stream
+    @book.update! published: true
+    accesses(:david_handbook).destroy!
+    sign_in :jason
+
+    assert_broadcasts(administrator_stream, 1) { save_page }
+  end
+
+  test "a removed administrator receives no presence for an unpublished book" do
+    sign_in :david
+    removed_stream = subscribed_stream
+    accesses(:david_handbook).destroy!
+    sign_in :jason
+
+    assert_no_broadcasts removed_stream do
+      assert_broadcasts(presence_stream(users(:jason)), 1) { save_page }
+    end
+  end
+
+  test "granting editor access allows the indicator to resume on an open editor" do
+    stream = subscribed_stream
+    sign_in :jason
+    accesses(:kevin_handbook).reader!
+    assert_no_broadcasts(stream) { save_page }
+
+    accesses(:kevin_handbook).editor!
+    assert_broadcasts(stream, 1) { save_page }
+  end
+
+  test "queued presence is discarded if the page is deleted" do
+    stream = subscribed_stream
+    put leafable_path(@leaf), params: { page: { body: "Updated by Kevin" } }
+    assert_response :no_content
+    @leaf.destroy!
+
+    assert_no_broadcasts(stream) { perform_enqueued_jobs }
+  end
+
+  test "queued presence is not sent if the saving user loses editor access" do
+    stream = presence_stream(users(:jason))
+    put leafable_path(@leaf), params: { page: { body: "Updated by Kevin" } }
+    assert_response :no_content
+    accesses(:kevin_handbook).reader!
+
+    assert_no_broadcasts(stream) { perform_enqueued_jobs }
+  end
+
+  test "queued presence is not sent if the saving user is deactivated" do
+    stream = presence_stream(users(:jason))
+    put leafable_path(@leaf), params: { page: { body: "Updated by Kevin" } }
+    assert_response :no_content
+    users(:kevin).deactivate
+
+    assert_no_broadcasts(stream) { perform_enqueued_jobs }
+  end
+
+  test "queued presence is not sent for a trashed page" do
+    stream = subscribed_stream
+    put leafable_path(@leaf), params: { page: { body: "Updated by Kevin" } }
+    assert_response :no_content
+    @leaf.trashed!
+
+    assert_no_broadcasts(stream) { perform_enqueued_jobs }
+  end
+
+  private
+    def presence_stream(user)
+      stream_name(user, @leaf, :being_edited)
+    end
+
+    def stream_name(*streamables)
+      Turbo::StreamsChannel.verified_stream_name(Turbo::StreamsChannel.signed_stream_name(streamables))
+    end
+
+    def subscribed_stream
+      get edit_leafable_path(@leaf)
+      assert_response :success
+
+      signed_stream = nil
+      assert_select "turbo-cable-stream-source[channel='Turbo::StreamsChannel']", count: 1 do |sources|
+        signed_stream = sources.first["signed-stream-name"]
+      end
+      Turbo::StreamsChannel.verified_stream_name(signed_stream)
+    end
+
+    def save_page
+      perform_enqueued_jobs do
+        put leafable_path(@leaf), params: { page: { body: "Updated by Jason" } }
+        assert_response :no_content
+      end
+    end
+end
