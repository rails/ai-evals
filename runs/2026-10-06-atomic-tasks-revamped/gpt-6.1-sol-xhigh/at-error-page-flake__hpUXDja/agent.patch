diff --git a/test/integration/raised_exceptions_test.rb b/test/integration/raised_exceptions_test.rb
new file mode 100644
index 0000000..78e4e22
--- /dev/null
+++ b/test/integration/raised_exceptions_test.rb
@@ -0,0 +1,176 @@
+require "test_helper"
+
+class RaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "errors raise only inside the block after an ordinary request" do
+    get absent_book_path
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_absent_book_raises
+      assert_absent_book_raises
+    end
+
+    get absent_book_path
+    assert_response :not_found
+
+    with_raised_exceptions { assert_absent_book_raises }
+
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "a first request in the block does not change application defaults" do
+    with_raised_exceptions do
+      assert_absent_book_raises
+      assert_equal :rescuable, Rails.application.config.action_dispatch.show_exceptions
+      assert_equal :rescuable, Rails.application.env_config["action_dispatch.show_exceptions"]
+    end
+
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "nested blocks preserve the outer scope and return the block value" do
+    result = with_raised_exceptions do
+      assert_absent_book_raises
+      assert_equal :inner, with_raised_exceptions {
+        assert_absent_book_raises
+        :inner
+      }
+      assert_absent_book_raises
+      :outer
+    end
+
+    assert_equal :outer, result
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "an exception escaping the block restores ordinary error rendering" do
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions { get absent_book_path }
+    end
+
+    get absent_book_path
+    assert_response :not_found
+
+    with_raised_exceptions { assert_absent_book_raises }
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "rescuing an inner block error leaves the outer block active" do
+    with_raised_exceptions do
+      assert_raises RuntimeError do
+        with_raised_exceptions { raise "inner block failed" }
+      end
+      assert_absent_book_raises
+    end
+
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "a nonlocal return restores ordinary error rendering" do
+    assert_equal :returned, return_from_exception_block
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "existing and new sessions and reset sessions obey the block scope" do
+    existing_session = open_session
+    existing_session.get absent_book_path
+    existing_session.assert_response :not_found
+
+    new_session = nil
+    with_raised_exceptions do
+      assert_absent_book_raises(existing_session)
+      new_session = open_session
+      assert_absent_book_raises(new_session)
+      reset!
+      assert_absent_book_raises
+    end
+
+    [ existing_session, new_session, self ].each do |session|
+      session.get absent_book_path
+      session.assert_response :not_found
+    end
+  end
+
+  test "request overrides win inside the block without mutating caller options" do
+    env = {
+      "action_dispatch.show_exceptions" => :all,
+      "raised_exceptions.marker" => "preserved"
+    }.freeze
+    headers = { "X-Exception-Scope" => "preserved" }.freeze
+
+    with_raised_exceptions do
+      get new_session_path, env: env, headers: headers, params: { probe: "present" }
+      assert_response :success
+      assert_equal :none, request.env["action_dispatch.show_exceptions"]
+      assert_equal "preserved", request.env["raised_exceptions.marker"]
+      assert_equal "preserved", request.headers["X-Exception-Scope"]
+      assert_equal "present", request.params["probe"]
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path, env: env }
+    end
+
+    assert_equal :all, env["action_dispatch.show_exceptions"]
+    get absent_book_path, env: env
+    assert_response :not_found
+    assert_equal :rescuable, request.env["action_dispatch.show_exceptions"]
+  end
+
+  test "overlapping blocks in different threads do not change other requests" do
+    # A missing route exercises the real exception middleware without sharing
+    # fixture database connections between threads.
+    path = "/__raised_exceptions_missing_route__"
+    get path
+    assert_response :not_found
+
+    entered = Queue.new
+    finish = Queue.new
+    worker = Thread.new do
+      session = ActionDispatch::Integration::Session.new(Rails.application)
+      with_raised_exceptions do
+        entered << true
+        finish.pop
+        assert_raises(ActionController::RoutingError) { session.get path }
+      end
+      session.get path
+      assert_equal 404, session.status
+    end
+
+    begin
+      entered.pop
+      get path
+      assert_response :not_found
+      with_raised_exceptions do
+        assert_raises(ActionController::RoutingError) { get path }
+      end
+      get path
+      assert_response :not_found
+    ensure
+      finish << true
+      worker.value
+    end
+
+    get path
+    assert_response :not_found
+  end
+
+  private
+    def absent_book_path
+      book_slug_path(books(:manual))
+    end
+
+    def return_from_exception_block
+      with_raised_exceptions do
+        assert_absent_book_raises
+        return :returned
+      end
+    end
+
+    def assert_absent_book_raises(session = self)
+      assert_raises(ActiveRecord::RecordNotFound) { session.get absent_book_path }
+    end
+end
