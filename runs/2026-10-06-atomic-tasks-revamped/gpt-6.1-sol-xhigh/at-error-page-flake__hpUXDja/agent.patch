@@ -0,0 +1,26 @@
+module RaisedExceptionsTestHelper
+  def with_raised_exceptions
+    # Scope all sessions used by this block, without affecting parallel tests.
+    previous = Thread.current[:writebook_raised_exceptions]
+    Thread.current[:writebook_raised_exceptions] = true
+    yield
+  ensure
+    Thread.current[:writebook_raised_exceptions] = previous
+  end
+
+  class Middleware
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      if Thread.current[:writebook_raised_exceptions]
+        # Rails copies its memoized env_config over incoming request values.
+        # Override after that copy, without changing config or cached defaults.
+        env["action_dispatch.show_exceptions"] = :none
+      end
+
+      @app.call(env)
+    end
+  end
+end
