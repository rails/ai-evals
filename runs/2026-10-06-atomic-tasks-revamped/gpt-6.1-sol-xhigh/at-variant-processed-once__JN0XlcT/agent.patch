diff --git a/test/integration/picture_processing_test.rb b/test/integration/picture_processing_test.rb
new file mode 100644
index 0000000..6a3f62e
--- /dev/null
+++ b/test/integration/picture_processing_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+require "tmpdir"
+
+class PictureProcessingTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+    @service = ActiveStorage::Blob.services.fetch(:test)
+    @original_storage_root = @service.root
+    @service.root = Dir.mktmpdir("picture-processing-")
+  end
+
+  teardown do
+    FileUtils.remove_entry @service.root
+    @service.root = @original_storage_root
+  end
+
+  test "background processing and readers share one derived WebP" do
+    assert_derived_once fixture_file_upload("white-rabbit.webp", "image/webp"), dimensions: [ 436, 600 ]
+  end
+
+  test "a large JPEG is resized once without changing the bytes served to readers" do
+    Tempfile.create([ "photograph", ".jpg" ]) do |file|
+      Vips::Image.new_from_file(file_fixture("reading.webp").to_s).resize(2).crop(0, 0, 2048, 1024).jpegsave(file.path)
+      upload = Rack::Test::UploadedFile.new(file.path, "image/jpeg")
+
+      assert_derived_once upload, dimensions: [ 1500, 750 ]
+    end
+  end
+
+  test "a reader arriving before the background job still produces only one derived copy" do
+    assert_derived_once fixture_file_upload("white-rabbit.webp", "image/webp"),
+      dimensions: [ 436, 600 ], background_first: false
+  end
+
+  test "a non-resizable upload is served unchanged without creating a derived copy" do
+    transform_count = 0
+    subscriber = ->(*) { transform_count += 1 }
+    ActiveSupport::Notifications.subscribed(subscriber, "transform.active_storage") do
+      assert_enqueued_jobs 0, only: ActiveStorage::CreateVariantsJob do
+        put leafable_path(leaves(:reading_picture)), params: {
+          picture: { image: fixture_file_upload("pixel.bmp", "image/bmp") }
+        }
+      end
+      assert_response :no_content
+      process_upload_jobs
+
+      get leafable_slug_path(leaves(:reading_picture))
+      assert_response :success
+      image_path = nil
+      assert_select "figure img", count: 1 do |images|
+        image_path = URI.parse(images.first["src"]).request_uri
+      end
+      get image_path
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+      assert_equal File.binread(file_fixture("pixel.bmp")), response.body.b
+      assert_equal 0, transform_count
+
+      blob = leaves(:reading_picture).reload.picture.image.blob
+      assert_equal 0, blob.variant_records.count
+      assert_equal [ blob.key ], stored_keys
+    end
+  end
+
+  private
+    def assert_derived_once(upload, dimensions:, background_first: true)
+      # This is the conversion the old reader URL requested, including its URL round trip.
+      legacy_variation = ActiveStorage::Variation.decode(ActiveStorage::Variation.new(
+        resize_to_limit: [ 1500, 1500 ], format: :webp).key)
+      expected_bytes = nil
+      legacy_variation.transform(upload.tempfile) { |output| expected_bytes = output.read }
+
+      transform_count = 0
+      subscriber = ->(*) { transform_count += 1 }
+      ActiveSupport::Notifications.subscribed(subscriber, "transform.active_storage") do
+        assert_enqueued_jobs 1, only: ActiveStorage::CreateVariantsJob do
+          put leafable_path(leaves(:reading_picture)), params: { picture: { image: upload } }
+        end
+        assert_response :no_content
+        assert_equal 0, transform_count, "Uploading should leave conversion to the background job"
+
+        create_variants_job = enqueued_jobs.find { |job| job[:job] == ActiveStorage::CreateVariantsJob }
+        blob = leaves(:reading_picture).reload.picture.image.blob
+        if background_first
+          process_upload_jobs
+          assert_equal 1, transform_count
+          assert_equal 1, blob.reload.variant_records.count
+        end
+
+        2.times do
+          before_rendering = transform_count
+          get book_slug_path(books(:handbook))
+          assert_response :success
+          get leafable_slug_path(leaves(:reading_picture))
+          assert_response :success
+          assert_equal before_rendering, transform_count, "Rendering should not process images"
+
+          image_path = nil
+          assert_select "figure img", count: 1 do |images|
+            image_path = URI.parse(images.first["src"]).request_uri
+          end
+          get image_path
+          assert_response :redirect
+          follow_redirect!
+          assert_response :success
+          assert_equal "image/webp", response.media_type
+          assert_equal expected_bytes, response.body.b
+          image = Vips::Image.new_from_buffer(response.body, "")
+          assert_equal dimensions, [ image.width, image.height ]
+          assert_equal 1, transform_count, "Readers should reuse the existing derived image"
+        end
+
+        # Both delayed work and a redelivered job must reuse the existing variant.
+        process_upload_jobs
+        ActiveJob::Base.deserialize(create_variants_job).perform_now
+        process_upload_jobs
+        assert_equal 1, transform_count
+        assert_equal 1, blob.reload.variant_records.count
+        derived = blob.variant_records.sole.image.blob
+        assert_equal expected_bytes, derived.download
+        assert_equal [ blob.key, derived.key ].sort, stored_keys
+      end
+    end
+
+    def process_upload_jobs
+      perform_enqueued_jobs only: ActiveStorage::CreateVariantsJob
+      perform_enqueued_jobs
+    end
+
+    def stored_keys
+      Dir.glob(File.join(@service.root, "**", "*")).select { |path| File.file?(path) }
+        .map { |path| File.basename(path) }.sort
+    end
+end
