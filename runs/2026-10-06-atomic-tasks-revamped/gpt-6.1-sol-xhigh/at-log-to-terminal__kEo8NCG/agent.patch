diff --git a/test/scripts/library_report_test.rb b/test/scripts/library_report_test.rb
new file mode 100644
index 0000000..fa9b123
--- /dev/null
+++ b/test/scripts/library_report_test.rb
@@ -0,0 +1,166 @@
+require "test_helper"
+require "tmpdir"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  setup do
+    @directory = Dir.mktmpdir("library-report")
+    @log_path = File.join(@directory, "test.log")
+    @original_log_paths = Rails.application.config.paths["log"].to_a
+    @original_logger = Rails.logger
+    Rails.application.config.paths["log"] = @log_path
+
+    @file_logger = ActiveSupport::Logger.new(@log_path)
+    @file_logger.formatter = ->(severity, time, progname, message) { "#{severity}: #{message}\n" }
+    Rails.logger = ActiveSupport::BroadcastLogger.new(@file_logger)
+  end
+
+  teardown do
+    Rails.logger = @original_logger
+    Rails.application.config.paths["log"] = @original_log_paths
+    @file_logger.close
+    FileUtils.remove_entry(@directory)
+  end
+
+  test "reports the same lines in order to stdout and the file with their severities" do
+    stdout, stderr = run_report
+
+    assert_equal expected_output, stdout
+    assert_empty stderr
+    assert_equal expected_file_output, report_file
+    assert_equal [ @file_logger ], Rails.logger.broadcasts
+  end
+
+  test "records every report line even when the configured log level is raised" do
+    [ Logger::WARN, Logger::ERROR ].each do |level|
+      File.truncate(@log_path, 0)
+      @file_logger.level = level
+
+      stdout, = run_report
+
+      assert_equal expected_output, stdout
+      assert_equal expected_file_output, report_file
+      assert_equal level, @file_logger.level
+      assert_nil @file_logger.local_level
+    end
+  end
+
+  test "reports an empty library" do
+    Access.delete_all
+    Edit.delete_all
+    Leaf.delete_all
+    Book.delete_all
+
+    stdout, = run_report
+
+    assert_equal "Library report: 0 books\nLibrary report: done\n", stdout
+    assert_equal "INFO: Library report: 0 books\nINFO: Library report: done\n", report_file
+  end
+
+  test "uses singular page wording for one leaf" do
+    books(:handbook).leaves.where.not(id: leaves(:welcome_page).id).destroy_all
+
+    stdout, = run_report
+
+    assert_equal expected_output.sub("4 pages", "1 page"), stdout
+    assert_equal expected_file_output.sub("4 pages", "1 page"), report_file
+  end
+
+  test "repeated runs do not accumulate terminal destinations" do
+    stdout, = capture_io do
+      2.times { load Rails.root.join("script/library_report.rb") }
+    end
+
+    assert_equal expected_output * 2, stdout
+    assert_equal expected_file_output * 2, report_file
+    assert_equal [ @file_logger ], Rails.logger.broadcasts
+  end
+
+  test "reuses an existing stdout destination and adds the missing environment file" do
+    original_logger = Rails.logger
+    stdout, = capture_io do
+      stdout_logger = ActiveSupport::Logger.new($stdout)
+      stdout_logger.level = Logger::ERROR
+      Rails.logger = ActiveSupport::BroadcastLogger.new(stdout_logger)
+
+      load Rails.root.join("script/library_report.rb")
+
+      assert_equal [ stdout_logger ], Rails.logger.broadcasts
+      assert_equal Logger::ERROR, stdout_logger.level
+      assert_nil stdout_logger.local_level
+      assert_not $stdout.closed?
+    ensure
+      Rails.logger = original_logger
+    end
+
+    assert_equal expected_output, stdout
+    assert_equal expected_output, report_file
+  end
+
+  test "does not duplicate lines when both destinations already exist" do
+    stdout, = capture_io do
+      stdout_logger = ActiveSupport::Logger.new($stdout)
+      Rails.logger.broadcast_to(stdout_logger)
+      original_destinations = Rails.logger.broadcasts.dup
+
+      load Rails.root.join("script/library_report.rb")
+
+      assert_equal original_destinations, Rails.logger.broadcasts
+      assert_not $stdout.closed?
+    ensure
+      Rails.logger.stop_broadcasting_to(stdout_logger)
+    end
+
+    assert_equal expected_output, stdout
+    assert_equal expected_file_output, report_file
+  end
+
+  test "restores distinct local levels and destinations if the report fails" do
+    other_logger = ActiveSupport::Logger.new(StringIO.new)
+    @file_logger.level = Logger::WARN
+    @file_logger.local_level = Logger::ERROR
+    other_logger.level = Logger::ERROR
+    other_logger.local_level = Logger::WARN
+    Rails.logger.broadcast_to(other_logger)
+    original_destinations = Rails.logger.broadcasts.dup
+
+    @file_logger.formatter = ->(*) { raise "log write failed" }
+
+    error = assert_raises(RuntimeError) do
+      run_report
+    end
+
+    assert_equal "log write failed", error.message
+    assert_equal original_destinations, Rails.logger.broadcasts
+    assert_equal Logger::ERROR, @file_logger.local_level
+    assert_equal Logger::WARN, other_logger.local_level
+    @file_logger.local_level = other_logger.local_level = nil
+    assert_equal Logger::WARN, @file_logger.level
+    assert_equal Logger::ERROR, other_logger.level
+  end
+
+  private
+    def run_report
+      capture_io { load Rails.root.join("script/library_report.rb") }
+    end
+
+    def expected_entries
+      [
+        [ "INFO", "Library report: 2 books" ],
+        [ "WARN", "Library report: Manual has no pages" ],
+        [ "INFO", "Library report: Handbook has 4 pages" ],
+        [ "INFO", "Library report: done" ]
+      ]
+    end
+
+    def expected_output
+      expected_entries.map { |severity, message| "#{message}\n" }.join
+    end
+
+    def expected_file_output
+      expected_entries.map { |severity, message| "#{severity}: #{message}\n" }.join
+    end
+
+    def report_file
+      File.readlines(@log_path).grep(/Library report:/).join
+    end
+end
