diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..45351f3 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,52 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "readers cannot change or delete a book" do
+    sign_in :jz
+    book = books(:handbook)
+
+    get edit_book_path(book)
+    assert_response :forbidden
+
+    patch book_path(book), params: { book: { title: "Changed" }, editor_ids: [ users(:jz).id ] }
+    assert_response :forbidden
+    assert_equal "Handbook", book.reload.title
+    assert_not book.editable?(user: users(:jz))
+
+    assert_no_difference [ "Book.count", "Leaf.count", "Access.count" ] do
+      delete book_path(book)
+    end
+    assert_response :forbidden
+  end
+
+  test "publication does not allow a signed in non-editor to change or delete a book" do
+    book = books(:manual)
+    book.update! published: true
+    assert_not book.accessable?(user: users(:kevin))
+
+    patch book_path(book), params: { book: { title: "Changed" } }
+    assert_response :forbidden
+    assert_equal "Manual", book.reload.title
+
+    assert_no_difference [ "Book.count", "Leaf.count", "Access.count" ] do
+      delete book_path(book)
+    end
+    assert_response :forbidden
+  end
+
+  test "editors can change and delete a book" do
+    book = books(:handbook)
+
+    patch book_path(book), params: { book: { title: "Updated handbook" } }
+    assert_redirected_to book_slug_path(book.reload)
+    assert_equal "Updated handbook", book.title
+    assert book.editable?(user: users(:kevin))
+
+    assert_difference "Book.count", -1 do
+      delete book_path(book)
+    end
+    assert_redirected_to root_path
+    assert_not Leaf.exists?(book_id: book.id)
+  end
 end
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..2e769ca 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,74 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "private leaves cannot be read under an accessible book id" do
+    leaf = leaves(:summary_page)
+    leaf.update! book: books(:manual)
+
+    [ nil, :md ].each do |format|
+      get leafable_slug_path(leaf, format: format)
+      assert_response :not_found
+
+      get slugged_leafable_path(books(:handbook), books(:handbook).slug, leaf, leaf.slug, format: format)
+      assert_response :not_found
+
+      get book_page_path(books(:handbook), leaf, format: format)
+      assert_response :not_found
+    end
+  end
+
+  test "signed out readers cannot read private leaves under a published book id" do
+    leaf = leaves(:summary_page)
+    leaf.update! book: books(:manual)
+    books(:handbook).update! published: true
+    sign_out
+
+    [ nil, :md ].each do |format|
+      get slugged_leafable_path(books(:handbook), books(:handbook).slug, leaf, leaf.slug, format: format)
+      assert_response :not_found
+
+      get book_page_path(books(:handbook), leaf, format: format)
+      assert_response :not_found
+    end
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+
+    get book_page_path(books(:handbook), leaves(:welcome_page), format: :md)
+    assert_response :success
+    assert_in_body "This is _such_ a great handbook."
+  end
+
+  test "forged book ids cannot be used to edit or delete another book's leaves" do
+    leaf = leaves(:summary_page)
+    leaf.update! book: books(:manual)
+    title = leaf.title
+
+    get edit_book_page_path(books(:handbook), leaf)
+    assert_response :not_found
+
+    assert_no_difference "Edit.count" do
+      patch book_page_path(books(:handbook), leaf), params: { leaf: { title: "Changed" }, page: { body: "Changed" } }
+    end
+    assert_response :not_found
+    assert_equal title, leaf.reload.title
+
+    assert_no_difference "Edit.count" do
+      delete book_page_path(books(:handbook), leaf)
+    end
+    assert_response :not_found
+    assert leaf.reload.active?
+  end
+
+  test "readable leaves remain readable by a reader" do
+    sign_in :jz
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+
+    get book_page_path(books(:handbook), leaves(:welcome_page), format: :md)
+    assert_response :success
+    assert_in_body "This is _such_ a great handbook."
+  end
 end
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..e272076
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    leaves(:welcome_page).update! title: "Visible needle"
+    leaves(:summary_page).update! book: books(:manual), title: "Restricted needle"
+  end
+
+  test "ordinary searches find only readable books" do
+    get library_search_path, params: { q: "  NeeDLe  " }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "Visible needle"
+    assert_not_in_body "Restricted needle"
+  end
+
+  test "published books are searchable without explicit access" do
+    books(:manual).update! published: true
+
+    get library_search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 2
+    assert_in_body "Restricted needle"
+  end
+
+  test "signed out searches include only published books" do
+    books(:manual).update! published: true
+    sign_out
+
+    get library_search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_in_body "Restricted needle"
+    assert_not_in_body "Visible needle"
+  end
+
+  test "search with no readable books returns no results" do
+    sign_out
+
+    get library_search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "blank queries and trashed leaves return no results" do
+    [ nil, "", "  " ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "a.search__result", count: 0
+    end
+
+    leaves(:welcome_page).trashed!
+    get library_search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "apostrophes are searchable data" do
+    leaves(:welcome_page).update! title: "Reader's guide"
+
+    [ "Reader's", "'" ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "a.search__result", count: 1
+      assert_select "a.search__result[href=?]", leafable_slug_path(leaves(:welcome_page))
+    end
+  end
+
+  test "SQL syntax cannot bypass book visibility" do
+    [ "x%' OR 1=1 OR leaves.title LIKE '%", "' OR 1=1 --", "%' OR 1=1 --", "') OR 1=1 --" ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "a.search__result", count: 0
+      assert_not_in_body "Restricted needle"
+    end
+  end
+
+  test "SQL-looking titles remain findable without revealing unreadable books" do
+    leaves(:welcome_page).update! title: "' OR 1=1 --"
+
+    get library_search_path, params: { q: "' OR 1=1 --" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_select "a.search__result[href=?]", leafable_slug_path(leaves(:welcome_page))
+    assert_not_in_body "Restricted needle"
+  end
+
+  test "percent signs and underscores are literal search characters" do
+    leaves(:welcome_page).update! title: "Save 50% off"
+    leaves(:welcome_section).update! title: "save_file"
+
+    [ "Save 50% off", "%", "50%" ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "a.search__result", count: 1
+      assert_select "a.search__result[href=?]", leafable_slug_path(leaves(:welcome_page))
+    end
+
+    [ "save_file", "_" ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "a.search__result", count: 1
+      assert_select "a.search__result[href=?]", leafable_slug_path(leaves(:welcome_section))
+    end
+  end
+
+  test "backslashes and combined wildcard characters remain literal" do
+    leaves(:welcome_page).update! title: 'Literal \\%_ punctuation'
+    leaves(:welcome_section).update! title: "Other punctuation"
+
+    [ "\\", '\\%_', "%_", 'Literal \\%_ punctuation' ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "a.search__result", count: 1
+      assert_select "a.search__result[href=?]", leafable_slug_path(leaves(:welcome_page))
+    end
+  end
+
+  test "signed out injection attempts cannot reveal private books" do
+    books(:handbook).update! published: true
+    sign_out
+
+    get library_search_path, params: { q: "x%' OR 1=1 OR leaves.title LIKE '%" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_not_in_body "Restricted needle"
+  end
+
+  test "signed in searches with no readable books remain empty" do
+    users(:kevin).accesses.delete_all
+
+    [ "needle", "x%' OR 1=1 OR leaves.title LIKE '%" ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "a.search__result", count: 0
+      assert_not_in_body "Restricted needle"
+      assert_not_in_body "Visible needle"
+    end
+  end
+end
diff --git a/test/controllers/users/profiles_controller_test.rb b/test/controllers/users/profiles_controller_test.rb
index 7564f7d..5b9d778 100644
--- a/test/controllers/users/profiles_controller_test.rb
+++ b/test/controllers/users/profiles_controller_test.rb
@@ -38,4 +38,51 @@ class Users::ProfilesControllerTest < ActionDispatch::IntegrationTest
     assert_response :forbidden
     assert_equal "Kevin", users(:kevin).reload.name
   end
+
+  test "member profile updates ignore roles while changing personal details" do
+    sign_in :kevin
+    roles = User.order(:id).pluck(:id, :role)
+
+    put user_profile_path(users(:kevin)), params: { user: {
+      name: "Updated Kevin", email_address: "updated@example.com", password: "new-secret123456", role: "administrator"
+    } }
+
+    assert_redirected_to users_path
+    assert_equal roles, User.order(:id).pluck(:id, :role)
+    assert_equal "Updated Kevin", users(:kevin).reload.name
+    assert_equal "updated@example.com", users(:kevin).email_address
+    assert users(:kevin).authenticate("new-secret123456")
+  end
+
+  test "members cannot change someone else's profile or role" do
+    sign_in :kevin
+    roles = User.order(:id).pluck(:id, :role)
+
+    [ :jz, :david ].each do |user|
+      patch user_profile_path(users(user)), params: { user: { name: "Changed", role: "administrator" } }
+
+      assert_response :forbidden
+      assert_not_equal "Changed", users(user).reload.name
+      assert_equal roles, User.order(:id).pluck(:id, :role)
+
+      patch user_path(users(user)), params: { user: { role: "administrator" } }
+
+      assert_response :forbidden
+      assert_equal roles, User.order(:id).pluck(:id, :role)
+    end
+  end
+
+  test "administrator profile updates do not change roles" do
+    sign_in :david
+
+    patch user_profile_path(users(:david)), params: { user: {
+      name: "Updated David", email_address: "updated-admin@example.com", password: "new-secret123456", role: "member"
+    } }
+
+    assert_redirected_to users_path
+    assert users(:david).reload.administrator?
+    assert_equal "Updated David", users(:david).name
+    assert_equal "updated-admin@example.com", users(:david).email_address
+    assert users(:david).authenticate("new-secret123456")
+  end
 end
