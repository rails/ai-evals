@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Books::ImportsControllerTest < ActionDispatch::IntegrationTest
+  self.use_transactional_tests = false
+
+  EDIT_JOBS = [ Book::SearchIndexJob, Book::CoverProcessingJob ].freeze
+
+  setup do
+    sign_in :jason
+  end
+
+  test "a successful batch waits for the outermost commit before handing off work" do
+    Book.transaction do
+      post books_import_path, params: { books: {
+        books(:handbook).id => { title: "Imported handbook" },
+        books(:manual).id => { title: "Imported manual" }
+      } }
+
+      assert_redirected_to root_path
+      assert_no_enqueued_jobs only: EDIT_JOBS
+    end
+
+    assert_equal "Imported handbook", books(:handbook).reload.title
+    assert_equal "Imported manual", books(:manual).reload.title
+    assert_enqueued_jobs 2, only: Book::SearchIndexJob
+    assert_no_enqueued_jobs only: Book::CoverProcessingJob
+    assert_no_enqueued_jobs only: Books::ImportFailureJob
+  end
+
+  test "a successful batch hands off cover jobs with both uploads available" do
+    post books_import_path, params: { books: {
+      books(:handbook).id => { cover: fixture_file_upload("pixel.bmp", "image/bmp") },
+      books(:manual).id => { cover: fixture_file_upload("pixel.bmp", "image/bmp") }
+    } }
+
+    assert_redirected_to root_path
+    assert_enqueued_jobs 2, only: Book::SearchIndexJob
+    assert_enqueued_jobs 2, only: Book::CoverProcessingJob
+    assert_no_enqueued_jobs only: Books::ImportFailureJob
+    assert_equal file_fixture("pixel.bmp").binread, books(:handbook).reload.cover.download
+    assert_equal file_fixture("pixel.bmp").binread, books(:manual).reload.cover.download
+  end
+
+  test "a failed batch rolls back earlier edits but still notifies the operator" do
+    post books_import_path, params: { books: {
+      books(:handbook).id => { title: "Abandoned handbook", cover: fixture_file_upload("pixel.bmp", "image/bmp") },
+      -1 => { title: "Missing book" }
+    } }
+
+    assert_response :not_found
+    assert_equal "Handbook", books(:handbook).reload.title
+    assert_not books(:handbook).cover.attached?
+    assert_no_enqueued_jobs only: EDIT_JOBS
+    assert_enqueued_jobs 1, only: Books::ImportFailureJob
+    assert_enqueued_with job: Books::ImportFailureJob, args: ->(args) {
+      args.first == users(:jason).id && args.last.include?("Couldn't find Book")
+    }
+  end
+end
diff --git a/test/jobs/transactional_enqueue_test.rb b/test/jobs/transactional_enqueue_test.rb
new file mode 100644
index 0000000..835883d
--- /dev/null
+++ b/test/jobs/transactional_enqueue_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class TransactionalEnqueueTest < ActiveJob::TestCase
+  self.use_transactional_tests = false
+
+  EDIT_JOBS = [ Book::SearchIndexJob, Book::CoverProcessingJob ].freeze
+
+  test "enqueuing a job instance also waits for commit" do
+    Book.transaction do
+      Book::SearchIndexJob.new(books(:handbook)).enqueue
+      assert_no_enqueued_jobs only: Book::SearchIndexJob
+    end
+
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+  end
+
+  test "an import failure notification survives rollback and can notify the operator" do
+    user_id = users(:jason).id
+    message = "Import did not go through"
+
+    Book.transaction do
+      Books::ImportFailureJob.perform_later(user_id, message)
+      assert_enqueued_with job: Books::ImportFailureJob, args: [ user_id, message ]
+      raise ActiveRecord::Rollback
+    end
+
+    assert_enqueued_jobs 1, only: Books::ImportFailureJob
+    original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    perform_enqueued_jobs only: Books::ImportFailureJob
+    assert_equal message, Rails.cache.read("import_failure/#{user_id}")
+  ensure
+    Rails.cache = original_cache if original_cache
+  end
+
+  test "bulk enqueue defers edit jobs but hands off failure notifications immediately" do
+    Book.transaction do
+      ActiveJob.perform_all_later(batch_jobs)
+      assert_no_enqueued_jobs only: EDIT_JOBS
+      assert_enqueued_jobs 1, only: Books::ImportFailureJob
+    end
+
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+    assert_enqueued_jobs 1, only: Book::CoverProcessingJob
+    assert_enqueued_jobs 1, only: Books::ImportFailureJob
+  end
+
+  test "bulk enqueue discards rolled back edit jobs without discarding the failure notification" do
+    Book.transaction do
+      ActiveJob.perform_all_later(batch_jobs)
+      assert_no_enqueued_jobs only: EDIT_JOBS
+      assert_enqueued_jobs 1, only: Books::ImportFailureJob
+      raise ActiveRecord::Rollback
+    end
+
+    assert_no_enqueued_jobs only: EDIT_JOBS
+    assert_enqueued_jobs 1, only: Books::ImportFailureJob
+  end
+
+  private
+    def batch_jobs
+      [ Book::SearchIndexJob.new(books(:handbook)),
+        Book::CoverProcessingJob.new(books(:handbook)).set(wait: 5.seconds),
+        Books::ImportFailureJob.new(users(:jason).id, "Import did not go through") ]
+    end
+end
diff --git a/test/models/book/editing_test.rb b/test/models/book/editing_test.rb
new file mode 100644
index 0000000..355b447
--- /dev/null
+++ b/test/models/book/editing_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class Book::EditingTest < ActiveJob::TestCase
+  # These tests need real commits, not the fixture transaction's eventual rollback.
+  self.use_transactional_tests = false
+
+  EDIT_JOBS = [ Book::SearchIndexJob, Book::CoverProcessingJob ].freeze
+
+  setup do
+    @book = books(:handbook)
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "edit jobs are handed off only after the outer transaction commits" do
+    freeze_time do
+      Book.transaction do
+        @book.apply_edit(title: "Updated handbook", cover: cover_attributes)
+
+        assert_no_enqueued_jobs only: EDIT_JOBS
+      end
+
+      assert_enqueued_jobs 1, only: Book::SearchIndexJob
+      assert_enqueued_with job: Book::SearchIndexJob, args: [ @book ]
+      assert_enqueued_jobs 1, only: Book::CoverProcessingJob
+      assert_enqueued_with job: Book::CoverProcessingJob, args: [ @book ], at: 5.seconds.from_now
+      assert_equal cover_bytes, @book.reload.cover.download
+    end
+  end
+
+  test "rolling back an edit discards its search and cover jobs" do
+    original_title = @book.title
+
+    Book.transaction do
+      @book.apply_edit(title: "Abandoned handbook", cover: cover_attributes)
+      assert_no_enqueued_jobs only: EDIT_JOBS
+      raise ActiveRecord::Rollback
+    end
+
+    assert_no_enqueued_jobs only: EDIT_JOBS
+    assert_equal original_title, @book.reload.title
+    assert_not @book.cover.attached?
+  end
+
+  test "committing a savepoint does not hand off jobs before the outer commit" do
+    Book.transaction do
+      Book.transaction(requires_new: true) do
+        @book.apply_edit(cover: cover_attributes)
+        assert_no_enqueued_jobs only: EDIT_JOBS
+      end
+
+      assert_no_enqueued_jobs only: EDIT_JOBS
+    end
+
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+    assert_enqueued_jobs 1, only: Book::CoverProcessingJob
+  end
+
+  test "rolling back a savepoint discards only that edit's jobs" do
+    manual = books(:manual)
+
+    Book.transaction do
+      Book.transaction(requires_new: true) do
+        @book.apply_edit(title: "Abandoned handbook", cover: cover_attributes)
+        raise ActiveRecord::Rollback
+      end
+
+      manual.apply_edit(title: "Updated manual")
+      assert_no_enqueued_jobs only: EDIT_JOBS
+    end
+
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+    assert_enqueued_with job: Book::SearchIndexJob, args: [ manual ]
+    assert_no_enqueued_jobs only: Book::CoverProcessingJob
+    assert_equal "Handbook", @book.reload.title
+    assert_not @book.cover.attached?
+  end
+
+  test "a worker can immediately process the committed cover and refresh search" do
+    perform_enqueued_jobs only: EDIT_JOBS do
+      Book.transaction do
+        @book.apply_edit(title: "Updated handbook", cover: cover_attributes)
+        assert_performed_jobs 0, only: EDIT_JOBS
+      end
+    end
+
+    assert_performed_jobs 1, only: Book::SearchIndexJob
+    assert_performed_jobs 1, only: Book::CoverProcessingJob
+    assert_equal "Updated handbook", Rails.cache.read("search_index/book/#{@book.id}")
+    assert_equal Digest::SHA256.hexdigest(cover_bytes), @book.reload.cover.blob.metadata["sha256"]
+    assert_equal "fixture", @book.cover.blob.metadata["source"]
+  end
+
+  test "an edit without a cover still refreshes search without processing a cover" do
+    @book.apply_edit(title: "Updated handbook")
+
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+    assert_no_enqueued_jobs only: Book::CoverProcessingJob
+  end
+
+  private
+    def cover_bytes
+      file_fixture("pixel.bmp").binread
+    end
+
+    def cover_attributes
+      { io: StringIO.new(cover_bytes), filename: "pixel.bmp", content_type: "image/bmp", metadata: { "source" => "fixture" } }
+    end
+end
