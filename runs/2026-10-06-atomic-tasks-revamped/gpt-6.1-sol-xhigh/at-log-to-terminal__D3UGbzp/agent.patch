@@ -19,6 +19,24 @@ module Writebook
     # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
     config.log_level = ENV.fetch("LOG_LEVEL", "debug")
 
+    # Runner reports belong on the terminal as well as in the environment log.
+    runner do |app|
+      logger = Rails.logger
+
+      unless ActiveSupport::Logger.logger_outputs_to?(logger, app.config.paths["log"].first)
+        file_logger = ActiveSupport::Logger.new(app.config.default_log_file)
+        file_logger.formatter = app.config.log_formatter
+        logger.broadcast_to ActiveSupport::TaggedLogging.new(file_logger)
+      end
+
+      unless ActiveSupport::Logger.logger_outputs_to?(logger, $stdout)
+        logger.broadcast_to ActiveSupport::Logger.new($stdout)
+      end
+
+      # Keep INFO report lines in every destination, even when LOG_LEVEL is raised.
+      logger.level = ActiveSupport::Logger::INFO
+    end
