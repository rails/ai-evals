+require "test_helper"
+require "tempfile"
+
+class RunnerLoggingTest < ActiveSupport::TestCase
+  setup do
+    @original_logger = Rails.logger
+    @log_file = Tempfile.new("runner-log")
+    @log_file.sync = true
+    @original_log_paths = Rails.application.config.paths["log"].to_a
+    Rails.application.config.paths.add "log", with: @log_file.path
+    @file_logger = ActiveSupport::Logger.new(@log_file)
+    @file_logger.formatter = ->(severity, time, progname, message) { "#{severity}: #{message}\n" }
+    @file_logger.level = Logger::ERROR
+    Rails.logger = ActiveSupport::BroadcastLogger.new(@file_logger)
+  end
+
+  teardown do
+    file_loggers = Rails.logger.broadcasts.select do |logger|
+      ActiveSupport::Logger.logger_outputs_to?(logger, @log_file.path)
+    end
+    (file_loggers + [ @file_logger ]).uniq.each(&:close)
+    Rails.logger = @original_logger
+    @log_file.close!
+    Rails.application.config.paths.add "log", with: @original_log_paths
+  end
+
+  test "ordinary application logging is unchanged until the runner hook is loaded" do
+    stdout, = capture_io { Rails.logger.info "Library report: done" }
+
+    assert_empty stdout
+    assert_empty File.read(@log_file.path)
+    assert_equal Logger::ERROR, @file_logger.level
+    assert_equal [ @file_logger ], Rails.logger.broadcasts
+  end
+
+  test "runner preserves the report wording order and severities in both destinations" do
+    logger = Rails.logger
+    stdout, = capture_io do
+      load_runner
+      load_report
+    end
+
+    assert_same logger, Rails.logger
+    assert_same @file_logger, Rails.logger.broadcasts.first
+    assert_report stdout, expected_report
+  end
+
+  test "runner preserves singular page wording" do
+    leaves(:summary_page).update! book: books(:manual)
+
+    stdout, = capture_io do
+      load_runner
+      load_report
+    end
+
+    assert_report stdout, expected_report(handbook_pages: 3, manual_pages: 1)
+  end
+
+  test "runner reports an empty library" do
+    Book.destroy_all
+
+    stdout, = capture_io do
+      load_runner
+      load_report
+    end
+
+    assert_report stdout, [ "INFO: Library report: 0 books", "INFO: Library report: done" ]
+  end
+
+  test "loading the runner hook repeatedly does not duplicate destinations" do
+    stdout, = capture_io do
+      2.times { load_runner }
+      load_report
+    end
+
+    assert_equal 2, Rails.logger.broadcasts.size
+    assert_report stdout, expected_report
+  end
+
+  test "an existing stdout logger is retained without duplicate output" do
+    stdout, = capture_io do
+      console_logger = ActiveSupport::Logger.new($stdout)
+      console_logger.level = Logger::ERROR
+      Rails.logger.broadcast_to console_logger
+      load_runner
+
+      assert_equal [ @file_logger, console_logger ], Rails.logger.broadcasts
+      assert_equal Logger::INFO, console_logger.level
+      load_report
+    end
+
+    assert_report stdout, expected_report
+  end
+
+  test "a stdout-only configuration also records the report in the environment log" do
+    stdout, = capture_io do
+      console_logger = ActiveSupport::Logger.new($stdout)
+      console_logger.level = Logger::ERROR
+      Rails.logger = ActiveSupport::BroadcastLogger.new(console_logger)
+      load_runner
+      load_runner
+
+      assert_equal 2, Rails.logger.broadcasts.size
+      assert_same console_logger, Rails.logger.broadcasts.first
+      load_report
+    end
+
+    expected_lines = expected_report.map { |line| line.sub(/\A\w+: /, "") }
+    assert_equal expected_lines, stdout.lines.map(&:chomp)
+    assert_equal expected_lines, File.readlines(@log_file.path, chomp: true)
+  end
+
+  private
+    def load_runner
+      Rails.application.load_runner
+    end
+
+    def load_report
+      load Rails.root.join("script/library_report.rb")
+    end
+
+    def expected_report(handbook_pages: 4, manual_pages: 0)
+      manual_line = if manual_pages.zero?
+        "WARN: Library report: Manual has no pages"
+      else
+        "INFO: Library report: Manual has 1 page"
+      end
+      book_lines = {
+        books(:handbook).id => "INFO: Library report: Handbook has #{handbook_pages} pages",
+        books(:manual).id => manual_line
+      }
+
+      [ "INFO: Library report: 2 books", *book_lines.sort.map(&:last), "INFO: Library report: done" ]
+    end
+
+    def assert_report(stdout, expected)
+      assert_equal expected.map { |line| line.sub(/\A\w+: /, "") }, stdout.lines.map(&:chomp)
+      assert_equal expected, File.readlines(@log_file.path, chomp: true)
+      assert_equal Logger::INFO, @file_logger.level
+    end
+end
