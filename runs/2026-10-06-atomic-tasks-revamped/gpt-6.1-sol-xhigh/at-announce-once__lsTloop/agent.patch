diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..0240855
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,225 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  # Exercise real commits and rollbacks, not the transaction wrapping each test.
+  self.use_transactional_tests = false
+
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "publishing announces once after commit" do
+    assert_publication_announced do
+      @book.transaction do
+        @book.update! published: true
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+  end
+
+  test "publishing and adding a page announces once" do
+    assert_publication_announced do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: "New content"), title: "New page"
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert @book.reload.published?
+    assert_equal "New page", @book.leaves.positioned.last.title
+  end
+
+  test "publishing and editing a page announces once" do
+    assert_publication_announced do
+      @book.transaction do
+        @book.update! published: true
+        leaves(:welcome_page).update! title: "New title"
+      end
+    end
+  end
+
+  test "publishing followed by more book saves announces once" do
+    assert_publication_announced do
+      @book.transaction do
+        @book.update! published: true
+        @book.update! slug: "new-slug"
+        @book.touch
+        @book.save!
+      end
+    end
+  end
+
+  test "another instance saving the book does not lose the announcement" do
+    assert_publication_announced do
+      @book.transaction do
+        @book.update! published: true
+        Book.find(@book.id).update! title: "New title"
+      end
+    end
+  end
+
+  test "saving an already published book does not announce again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: true, slug: "new-slug"
+      @book.touch
+    end
+  end
+
+  test "unpublishing does not announce" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "saving a draft without publishing does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! slug: "new-slug"
+      @book.touch
+    end
+  end
+
+  test "failure after publishing rolls back the book and pages without announcing" do
+    original_leaf_count = @book.leaves.count
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises RuntimeError do
+        @book.transaction do
+          @book.update! published: true
+          @book.press Page.new(body: "New content"), title: "New page"
+          raise "Page changes failed"
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+    assert_equal original_leaf_count, @book.leaves.count
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! slug: "after-rollback"
+    end
+  end
+
+  test "publishing successfully after a rollback announces once" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    @book.reload
+    assert_publication_announced { @book.update! published: true }
+  end
+
+  test "publishing and then returning to draft in one transaction does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "multiple publication changes ending live announce only once" do
+    assert_publication_announced do
+      @book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "an already live book ending live does not announce again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "publishing again after a committed unpublication announces again" do
+    @book.update! published: true
+    @book.update! published: false
+
+    assert_publication_announced { @book.update! published: true }
+  end
+
+  test "committing a savepoint waits for the outer commit and announces once" do
+    assert_publication_announced do
+      @book.transaction do
+        @book.transaction(requires_new: true) { @book.update! published: true }
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "a committed savepoint followed by an outer rollback does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.transaction(requires_new: true) { @book.update! published: true }
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "rolling back a savepoint does not discard an outer publication" do
+    assert_publication_announced do
+      @book.transaction do
+        @book.update! published: true
+        @book.transaction(requires_new: true) do
+          @book.update! published: false
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "rolling back a savepoint allows a later publication to announce" do
+    assert_publication_announced do
+      @book.transaction do
+        @book.transaction(requires_new: true) do
+          @book.update! published: true
+          raise ActiveRecord::Rollback
+        end
+        @book.reload.update! published: true
+      end
+    end
+  end
+
+  test "unsaved publication changes do not override the committed state" do
+    assert_publication_announced do
+      @book.transaction do
+        @book.update! published: true
+        @book.published = false
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  private
+    def assert_publication_announced(&block)
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ], &block
+      end
+    end
+end
