index 0000000..dd9fe6f
--- /dev/null
+++ b/test/lib/runner_logging_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+require "tmpdir"
+
+class RunnerLoggingTest < ActiveSupport::TestCase
+  setup do
+    @directory = Dir.mktmpdir("runner-logging")
+    @log_file = File.join(@directory, "#{Rails.env}.log")
+    @original_logger = Rails.logger
+    @original_log_paths = Rails.application.config.paths["log"].to_a
+    Rails.application.config.paths["log"] = @log_file
+  end
+
+  teardown do
+    Rails.logger = @original_logger
+    Rails.application.config.paths["log"] = @original_log_paths
+    FileUtils.remove_entry(@directory)
+  end
+
+  test "report retains its messages, order and severities in both destinations" do
+    file_logger = ActiveSupport::Logger.new(@log_file, level: Logger::ERROR)
+    file_logger.formatter = proc { |severity, time, progname, message| "#{severity}: #{message}\n" }
+    Rails.logger = ActiveSupport::BroadcastLogger.new(file_logger)
+    original_logger = Rails.logger
+
+    stdout, stderr = capture_io do
+      Rails.application.load_runner
+      load Rails.root.join("script/library_report.rb")
+    end
+
+    assert_same original_logger, Rails.logger
+    assert_includes Rails.logger.broadcasts, file_logger
+    assert_empty stderr
+    assert_equal report_lines.join("\n") + "\n", stdout
+    assert_equal [
+      "INFO: Library report: 2 books",
+      "WARN: Library report: Manual has no pages",
+      "INFO: Library report: Handbook has 4 pages",
+      "INFO: Library report: done"
+    ], File.readlines(@log_file, chomp: true).grep(/Library report:/)
+  end
+
+  test "report keeps singular page wording" do
+    books(:handbook).leaves.where.not(id: leaves(:welcome_page)).delete_all
+    Rails.logger = ActiveSupport::BroadcastLogger.new(ActiveSupport::Logger.new(@log_file))
+
+    stdout, = capture_io do
+      Rails.application.load_runner
+      load Rails.root.join("script/library_report.rb")
+    end
+
+    expected = report_lines.map { |line| line.sub("4 pages", "1 page") }
+    assert_equal expected, stdout.lines.map(&:chomp)
+    assert_equal expected, File.readlines(@log_file, chomp: true).grep(/Library report:/)
+  end
+
+  test "runner hook does not duplicate existing file or stdout destinations" do
+    stdout, = capture_io do
+      Rails.logger = ActiveSupport::BroadcastLogger.new(
+        ActiveSupport::Logger.new(@log_file), ActiveSupport::Logger.new($stdout)
+      )
+      Rails.application.load_runner
+      Rails.application.load_runner
+      assert_equal 2, Rails.logger.broadcasts.size
+      Rails.logger.info "Runbook check"
+    end
+
+    assert_equal "Runbook check\n", stdout
+    assert_equal [ "Runbook check" ], File.readlines(@log_file, chomp: true).grep(/Runbook check/)
+  end
+
+  test "runner adds a file destination when the environment only logs to stdout" do
+    stdout, = capture_io do
+      Rails.logger = ActiveSupport::BroadcastLogger.new(ActiveSupport::Logger.new($stdout, level: Logger::ERROR))
+      Rails.application.load_runner
+      Rails.logger.info "Runbook check"
+    end
+
+    assert_equal "Runbook check\n", stdout
+    assert_equal [ "Runbook check" ], File.readlines(@log_file, chomp: true).grep(/Runbook check/)
+  end
+
+  private
+    def report_lines
+      [
+        "Library report: 2 books",
+        "Library report: Manual has no pages",
+        "Library report: Handbook has 4 pages",
+        "Library report: done"
+      ]
+    end
+end
