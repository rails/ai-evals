+require "test_helper"
+
+class TenancyModelTest < ActiveSupport::TestCase
+  setup do
+    @tenant = Tenant.create!(name: "Customer A")
+    @other_tenant = Tenant.create!(name: "Customer B")
+    users(:kevin).update!(tenant: @tenant)
+    users(:jz).update!(tenant: @tenant)
+    users(:david).update!(tenant: @other_tenant)
+    users(:jason).update!(tenant: @other_tenant)
+    books(:handbook).update!(tenant: @tenant)
+    books(:manual).update!(tenant: @other_tenant)
+  end
+
+  test "foreign access rows and administrator privileges do not grant permissions" do
+    book = books(:manual)
+    book.accesses.create!(user: users(:kevin), level: :editor)
+
+    assert_not book.accessable?(user: users(:kevin))
+    assert_not book.editable?(user: users(:kevin))
+    assert_nil book.access_for(user: users(:kevin))
+
+    users(:kevin).administrator!
+    assert_not book.editable?(user: users(:kevin))
+  end
+
+  test "book lookup honors an explicit user rather than Current.user" do
+    books(:manual).update!(published: true)
+    books(:manual).accesses.create!(user: users(:kevin), level: :reader)
+
+    Current.set(user: users(:david)) do
+      assert_equal [ books(:handbook) ], Book.accessable_or_published(user: users(:kevin)).to_a
+      assert_equal [ books(:manual) ], Book.accessable_or_published.to_a
+      assert_equal [ books(:manual) ], Book.accessable_or_published(user: nil).to_a
+    end
+  end
+
+  test "sharing with everyone grants access only to active tenant users" do
+    books(:handbook).update_access(editors: [ users(:kevin).id, users(:david).id ], readers: [])
+
+    assert books(:handbook).editable?(user: users(:kevin))
+    assert books(:handbook).accessable?(user: users(:jz))
+    assert_equal [ users(:kevin).id, users(:jz).id ].sort, books(:handbook).accesses.pluck(:user_id).sort
+
+    users(:jz).deactivate
+    books(:handbook).update_access(editors: [ users(:kevin).id ], readers: [])
+    assert_equal [ users(:kevin).id ], books(:handbook).accesses.pluck(:user_id)
+  end
+
+  test "explicit sharing ignores foreign users and removes stale rows" do
+    books(:handbook).update!(everyone_access: false)
+    books(:handbook).update_access(editors: [ users(:kevin).id, users(:david).id ], readers: [ users(:jz).id, users(:jason).id ])
+
+    assert_equal [ users(:kevin).id, users(:jz).id ].sort, books(:handbook).accesses.pluck(:user_id).sort
+    assert books(:handbook).editable?(user: users(:kevin))
+    assert_not books(:handbook).editable?(user: users(:jz))
+  end
+
+  test "new users get everyone access only in their tenant" do
+    user = User.create!(tenant: @tenant, name: "New A User", email_address: "new-a@example.com", password: "secret123456")
+
+    assert books(:handbook).accessable?(user: user)
+    assert_not books(:handbook).editable?(user: user)
+    assert_not books(:manual).accesses.exists?(user: user)
+  end
+
+  test "tenantless records retain legacy book lookup and sharing" do
+    User.update_all(tenant_id: nil)
+    Book.update_all(tenant_id: nil)
+    users(:kevin).reload
+    books(:handbook).reload.update_access(editors: [ users(:kevin).id ], readers: [])
+    books(:manual).reload.update!(published: true)
+
+    assert_equal Book.count, Book.accessable_or_published(user: users(:kevin)).count
+    User.active.each { |user| assert books(:handbook).accessable?(user: user) }
+
+    user = User.create!(name: "Legacy User", email_address: "legacy@example.com", password: "secret123456")
+    assert books(:handbook).accessable?(user: user)
+    assert books(:manual).accessable?(user: user)
+  end
+
+  test "first run assigns the administrator and manual to one tenant" do
+    Book.destroy_all
+    User.destroy_all
+    Account.destroy_all
+
+    default_tenant = Tenant.first
+
+    user = FirstRun.create!(name: "First User", email_address: "first@example.com", password: "secret123456")
+
+    assert_equal default_tenant, user.tenant
+    assert_equal user.tenant, Book.first.tenant
+    assert Book.first.editable?(user: user)
+  end
+end
