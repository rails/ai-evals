@@ -0,0 +1,24 @@
+class AddTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |direction|
+      direction.up do
+        # Use SQL rather than application models so upgrades don't run callbacks
+        # or depend on future changes to tenant defaults and access rules.
+        execute <<~SQL
+          INSERT INTO tenants (name, created_at, updated_at)
+          VALUES ('Writebook', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
+        SQL
+        execute "UPDATE users SET tenant_id = (SELECT id FROM tenants LIMIT 1)"
+        execute "UPDATE books SET tenant_id = (SELECT id FROM tenants LIMIT 1)"
+      end
+    end
+  end
+end
