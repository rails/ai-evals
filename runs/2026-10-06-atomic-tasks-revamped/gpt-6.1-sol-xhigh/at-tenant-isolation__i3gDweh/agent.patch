+++ b/test/migrations/add_tenants_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+require_relative "../../db/migrate/20240617075643_initial_schema"
+require_relative "../../db/migrate/20240929000000_add_tenants"
+
+class AddTenantsTest < ActiveSupport::TestCase
+  class MigrationRecord < ActiveRecord::Base
+    self.abstract_class = true
+  end
+
+  setup do
+    # Test a populated, pre-tenancy install without altering the fixture database.
+    MigrationRecord.establish_connection(adapter: "sqlite3", database: ":memory:")
+    @connection = MigrationRecord.connection
+    capture_io { InitialSchema.new.exec_migration(@connection, :up) }
+
+    @connection.execute <<~SQL
+      INSERT INTO users (id, name, email_address, password_digest, role, active, created_at, updated_at)
+      VALUES (1, 'Active User', 'active@example.com', 'digest', 0, 1, '2024-01-01', '2024-01-01'),
+             (2, 'Inactive User', 'inactive@example.com', 'digest', 1, 0, '2024-01-01', '2024-01-01')
+    SQL
+    @connection.execute <<~SQL
+      INSERT INTO books (id, title, slug, published, created_at, updated_at)
+      VALUES (1, 'Private Book', 'private', 0, '2024-01-01', '2024-01-01'),
+             (2, 'Public Book', 'public', 1, '2024-01-01', '2024-01-01')
+    SQL
+    @connection.execute <<~SQL
+      INSERT INTO accesses (user_id, book_id, level, created_at, updated_at)
+      VALUES (1, 1, 'editor', '2024-01-01', '2024-01-01')
+    SQL
+    @original_users = @connection.select_all("SELECT * FROM users ORDER BY id").to_a
+    @original_books = @connection.select_all("SELECT * FROM books ORDER BY id").to_a
+    @original_accesses = @connection.select_all("SELECT * FROM accesses").to_a
+  end
+
+  teardown do
+    MigrationRecord.connection_pool.disconnect!
+  end
+
+  test "upgrade backfills every user and book into one named tenant without changing data" do
+    migrate(:up)
+
+    tenants = @connection.select_all("SELECT * FROM tenants").to_a
+    assert_equal 1, tenants.size
+    tenant = tenants.first
+    assert_equal "Writebook", tenant["name"]
+    assert tenant["created_at"].present?
+    assert tenant["updated_at"].present?
+
+    users = @connection.select_all("SELECT * FROM users ORDER BY id").to_a
+    books = @connection.select_all("SELECT * FROM books ORDER BY id").to_a
+    assert users.all? { |user| user["tenant_id"] == tenant["id"] }
+    assert books.all? { |book| book["tenant_id"] == tenant["id"] }
+    assert_equal @original_users, users.map { |user| user.except("tenant_id") }
+    assert_equal @original_books, books.map { |book| book.except("tenant_id") }
+    assert_equal @original_accesses, @connection.select_all("SELECT * FROM accesses").to_a
+
+    [ :users, :books ].each do |table|
+      assert @connection.index_exists?(table, :tenant_id)
+      assert @connection.foreign_key_exists?(table, :tenants)
+      assert @connection.columns(table).find { |column| column.name == "tenant_id" }.null
+    end
+  end
+
+  test "rollback preserves users books and accesses and can be upgraded again" do
+    migrate(:up)
+    migrate(:down)
+
+    assert_not @connection.table_exists?(:tenants)
+    assert_equal @original_users, @connection.select_all("SELECT * FROM users ORDER BY id").to_a
+    assert_equal @original_books, @connection.select_all("SELECT * FROM books ORDER BY id").to_a
+    assert_equal @original_accesses, @connection.select_all("SELECT * FROM accesses").to_a
+
+    migrate(:up)
+    assert_equal 1, @connection.select_value("SELECT COUNT(*) FROM tenants")
+    assert_equal 0, @connection.select_value("SELECT COUNT(*) FROM users WHERE tenant_id IS NULL")
+    assert_equal 0, @connection.select_value("SELECT COUNT(*) FROM books WHERE tenant_id IS NULL")
+  end
+
+  private
+    def migrate(direction)
+      capture_io { AddTenants.new.exec_migration(@connection, direction) }
+    end
+end
