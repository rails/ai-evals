diff --git a/test/models/page_test.rb b/test/models/page_test.rb
index b4bb79b..18d3b35 100644
--- a/test/models/page_test.rb
+++ b/test/models/page_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class PageTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
   test "html preview" do
     page = Page.new(body: "# Hello\n\nWorld!")
 
@@ -26,4 +28,68 @@ class PageTest < ActiveSupport::TestCase
     assert_includes page.searchable_content, "5 &lt; 10 &amp; 10 &gt; 5"
     assert page.searchable_content.html_safe?
   end
+
+  test "destroying a page purges its markdown uploads" do
+    page = pages(:welcome)
+    markdown = page.body
+    uploads = %w[ reading.webp white-rabbit.webp ].map { |filename| attach_image(page, filename) }
+    blobs = uploads.map(&:blob)
+    page.update! body: uploads.map { |upload| "![Image](#{upload.slug_path})" }.join("\n")
+
+    blobs.each { |blob| assert blob.service.exist?(blob.key) }
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActionText::Markdown.exists?(markdown.id)
+    uploads.each { |upload| assert_not ActiveStorage::Attachment.exists?(upload.id) }
+    blobs.each do |blob|
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+  end
+
+  test "destroying a page preserves an image still attached to another page" do
+    page = pages(:welcome)
+    other_page = pages(:summary)
+    upload = attach_image(page, "reading.webp")
+    blob = upload.blob
+    other_page.body.uploads.attach blob
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert blob.service.exist?(blob.key)
+    assert_equal blob, other_page.body.uploads.first.blob
+
+    perform_enqueued_jobs do
+      other_page.destroy!
+    end
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+
+  test "destroying a page without uploads" do
+    page = pages(:welcome)
+
+    perform_enqueued_jobs do
+      assert_difference -> { ActionText::Markdown.count }, -1 do
+        assert_no_difference [ -> { ActiveStorage::Attachment.count }, -> { ActiveStorage::Blob.count } ] do
+          page.destroy!
+        end
+      end
+    end
+  end
+
+  private
+    def attach_image(page, filename)
+      File.open(file_fixture(filename), "rb") do |file|
+        page.body.uploads.attach io: file, filename: filename, content_type: "image/webp"
+      end
+      page.body.uploads.attachments.last
+    end
 end
