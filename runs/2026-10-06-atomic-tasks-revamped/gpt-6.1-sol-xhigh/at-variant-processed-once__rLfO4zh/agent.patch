diff --git a/test/integration/picture_processing_test.rb b/test/integration/picture_processing_test.rb
new file mode 100644
index 0000000..cc26fd4
--- /dev/null
+++ b/test/integration/picture_processing_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+require "tmpdir"
+
+class PictureProcessingTest < ActionDispatch::IntegrationTest
+  setup do
+    @service = ActiveStorage::Blob.services.fetch("test")
+    @original_root = @service.root
+    @service.root = Dir.mktmpdir("picture-processing")
+    sign_in :kevin
+  end
+
+  teardown do
+    FileUtils.remove_entry @service.root
+    @service.root = @original_root
+  end
+
+  test "readers reuse the background variant and receive the same bytes" do
+    transformations = []
+    ActiveSupport::Notifications.subscribed(->(event) { transformations << event }, "transform.active_storage") do
+      perform_enqueued_jobs do
+        put leafable_path(leaves(:reading_picture)), params: {
+          picture: { image: fixture_file_upload("reading.webp", "image/webp") }
+        }
+      end
+    end
+    assert_response :no_content
+    assert_performed_with job: ActiveStorage::TransformJob
+    assert_equal 1, transformations.size
+
+    blob = leaves(:reading_picture).reload.picture.image.blob
+    assert_equal 1, blob.variant_records.count
+    derived_blob = blob.variant_records.sole.image.blob
+    assert_equal [ blob.key, derived_blob.key ].sort, stored_keys
+
+    # The old reader path decodes a signed variation containing a symbol-valued format.
+    legacy_variation = ActiveStorage::Variation.decode(ActiveStorage::Variation.new(
+      resize_to_limit: [ 1500, 1500 ], format: :webp
+    ).key)
+    expected_bytes = file_fixture("reading.webp").open do |original|
+      legacy_variation.transform(original) { |derived| derived.read }
+    end
+    assert_equal expected_bytes, derived_blob.download
+
+    books(:handbook).update!(published: true)
+    sign_out
+
+    reader_transformations = []
+    ActiveSupport::Notifications.subscribed(->(event) { reader_transformations << event }, "transform.active_storage") do
+      2.times do
+        get leafable_slug_path(leaves(:reading_picture))
+        assert_response :success
+        assert_select "figure img", count: 1
+
+        get css_select("figure img").sole["src"]
+        assert_response :redirect
+        follow_redirect!
+        assert_response :success
+        assert_equal "image/webp", response.media_type
+        assert_equal expected_bytes, response.body.b
+      end
+    end
+
+    assert_empty reader_transformations
+    assert_equal 1, blob.variant_records.count
+    assert_equal [ blob.key, derived_blob.key ].sort, stored_keys
+  end
+
+  test "a reader arriving before the background job still creates only one variant" do
+    put leafable_path(leaves(:reading_picture)), params: {
+      picture: { image: fixture_file_upload("reading.webp", "image/webp") }
+    }
+    assert_response :no_content
+    blob = leaves(:reading_picture).reload.picture.image.blob
+    assert_equal 0, blob.variant_records.count
+
+    transformations = []
+    ActiveSupport::Notifications.subscribed(->(event) { transformations << event }, "transform.active_storage") do
+      get leafable_slug_path(leaves(:reading_picture))
+      assert_response :success
+      get css_select("figure img").sole["src"]
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+
+      # The creation job schedules the transformation job.
+      perform_enqueued_jobs only: ActiveStorage::CreateVariantsJob
+      perform_enqueued_jobs only: ActiveStorage::TransformJob
+    end
+
+    assert_performed_with job: ActiveStorage::TransformJob
+    assert_equal 1, transformations.size
+    assert_equal 1, blob.variant_records.count
+    assert_equal [ blob.key, blob.variant_records.sole.image.blob.key ].sort, stored_keys
+  end
+
+  test "a non-resizable upload is served unchanged without creating a variant" do
+    transformations = []
+    ActiveSupport::Notifications.subscribed(->(event) { transformations << event }, "transform.active_storage") do
+      perform_enqueued_jobs do
+        put leafable_path(leaves(:reading_picture)), params: {
+          picture: { image: fixture_file_upload("pixel.bmp", "image/bmp") }
+        }
+      end
+      assert_response :no_content
+
+      get leafable_slug_path(leaves(:reading_picture))
+      assert_response :success
+      get css_select("figure img").sole["src"]
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+    end
+
+    blob = leaves(:reading_picture).reload.picture.image.blob
+    assert_equal file_fixture("pixel.bmp").binread, response.body.b
+    assert_empty transformations
+    assert_equal 0, blob.variant_records.count
+    assert_equal [ blob.key ], stored_keys
+  end
+
+  private
+    def stored_keys
+      Dir.glob(File.join(@service.root, "**", "*")).select { |path| File.file?(path) }.map { |path| File.basename(path) }.sort
+    end
+end
