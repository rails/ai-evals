diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..4b04114 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -1,6 +1,115 @@
 require "test_helper"
 
 class BookTest < ActiveSupport::TestCase
+  test "destroy archives each current grant after deleting the book" do
+    book = books(:handbook)
+    expected = book.accesses.includes(:user).map do |access|
+      [ book.id, book.title, access.user_id, access.user.name, access.level ]
+    end
+    statements = []
+    subscriber = ->(event) { statements << event.payload[:sql] }
+
+    assert_difference -> { AccessArchive.count }, expected.size do
+      ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+        book.destroy!
+      end
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+    actual = AccessArchive.where(book_id: book.id).pluck(:book_id, :book_title, :user_id, :user_name, :level)
+    assert_equal expected.sort, actual.sort
+    assert AccessArchive.where(book_id: book.id).all? { |archive| archive.created_at.present? }
+
+    deletion = statements.index { |sql| sql.match?(/DELETE FROM "books"/) }
+    inserts = statements.each_index.select { |index| statements[index].match?(/INSERT INTO "access_archives"/) }
+    assert_equal expected.size, inserts.size
+    assert inserts.all? { |index| index > deletion }, "Archive rows must be inserted after the book is deleted"
+  end
+
+  test "destroy snapshots current grants rather than a previously loaded access list" do
+    book = books(:handbook)
+    book.accesses.load.each(&:user)
+
+    assert_no_difference -> { AccessArchive.count } do
+      accesses(:jz_handbook).update!(level: :editor)
+      accesses(:kevin_handbook).update!(level: :reader)
+      accesses(:jason_handbook).destroy!
+      users(:jz).update!(name: "Updated name")
+      book.update!(title: "Updated title")
+    end
+
+    assert_difference -> { AccessArchive.count }, 3 do
+      book.destroy!
+    end
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal [
+      [ users(:david).id, "editor" ],
+      [ users(:jz).id, "editor" ],
+      [ users(:kevin).id, "reader" ]
+    ].sort, archives.pluck(:user_id, :level).sort
+    assert_equal "Updated name", archives.find_by!(user_id: users(:jz).id).user_name
+    assert_equal [ "Updated title" ], archives.distinct.pluck(:book_title)
+    assert_not Access.exists?(book_id: book.id)
+  end
+
+  test "destroy includes accesses granted after the association was loaded" do
+    book = books(:manual)
+    book.accesses.load
+
+    assert_no_difference -> { AccessArchive.count } do
+      Access.create!(book: book, user: users(:kevin), level: :reader)
+    end
+
+    assert_difference -> { AccessArchive.count }, 4 do
+      book.destroy!
+    end
+
+    assert_equal "reader", AccessArchive.find_by!(book_id: book.id, user_id: users(:kevin).id).level
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+  end
+
+  test "rolling back destruction also rolls back archives and access removals" do
+    book = books(:handbook)
+
+    assert_no_difference [ -> { AccessArchive.count }, -> { Book.count }, -> { Access.count } ] do
+      Book.transaction do
+        book.destroy!
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert Book.exists?(book.id)
+    assert Access.exists?(book_id: book.id)
+  end
+
+  test "destroy without accesses does not create archives" do
+    book = books(:manual)
+    book.accesses.delete_all
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+  end
+
+  test "destroy does not archive accesses revoked after the association was loaded" do
+    book = books(:manual)
+    book.accesses.load
+    Access.where(book: book).delete_all
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+  end
+
   test "slug is generated from title" do
     book = Book.create!(title: "Hello, World!")
     assert_equal "hello-world", book.slug
