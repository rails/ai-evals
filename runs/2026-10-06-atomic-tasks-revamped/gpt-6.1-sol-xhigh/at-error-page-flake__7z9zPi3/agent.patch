@@ -0,0 +1,63 @@
+require "test_helper"
+
+class RaisedExceptionsTestHelperTest < ActiveSupport::TestCase
+  class CachedApplication
+    prepend RaisedExceptionsTestHelper::RequestConfiguration
+
+    def initialize(show_exceptions = :rescuable)
+      @show_exceptions = show_exceptions
+    end
+
+    def env_config
+      @env_config ||= {
+        "action_dispatch.show_exceptions" => @show_exceptions,
+        "action_dispatch.show_detailed_exceptions" => true,
+        "unrelated.setting" => Object.new
+      }
+    end
+  end
+
+  test "a first lookup inside the scope does not poison the cached defaults" do
+    application = CachedApplication.new
+
+    scoped = with_raised_exceptions { application.env_config }
+    normal = application.env_config
+
+    assert_equal :none, scoped["action_dispatch.show_exceptions"]
+    assert_equal :rescuable, normal["action_dispatch.show_exceptions"]
+    assert_equal normal.except("action_dispatch.show_exceptions"), scoped.except("action_dispatch.show_exceptions")
+    assert_not_same normal, scoped
+    assert_same normal, application.env_config
+  end
+
+  test "warm cached settings are preserved exactly" do
+    [ :rescuable, :all, :none, nil, false ].each do |setting|
+      application = CachedApplication.new(setting)
+      cached = application.env_config
+      original = cached.dup
+
+      with_raised_exceptions do
+        assert_equal :none, application.env_config["action_dispatch.show_exceptions"]
+        assert_equal original, cached
+      end
+
+      assert_same cached, application.env_config
+      assert_equal original, application.env_config
+    end
+  end
+
+  test "a suspended fiber's scope does not affect its caller" do
+    application = CachedApplication.new
+    fiber = Fiber.new do
+      with_raised_exceptions do
+        Fiber.yield application.env_config
+        application.env_config
+      end
+    end
+
+    assert_equal :none, fiber.resume["action_dispatch.show_exceptions"]
+    assert_equal :rescuable, application.env_config["action_dispatch.show_exceptions"]
+    assert_equal :none, fiber.resume["action_dispatch.show_exceptions"]
+    assert_equal :rescuable, application.env_config["action_dispatch.show_exceptions"]
+  end
+end
diff --git a/test/integration/raised_exceptions_test.rb b/test/integration/raised_exceptions_test.rb
new file mode 100644
index 0000000..ebc046e
--- /dev/null
+++ b/test/integration/raised_exceptions_test.rb
@@ -0,0 +1,150 @@
+require "test_helper"
+require "timeout"
+
+class RaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "a warmed application raises only inside the scope" do
+    path = book_slug_path(books(:manual))
+    get path
+    assert_response :not_found
+    cached = Rails.application.env_config
+    original = cached.dup
+    configured = Rails.application.config.action_dispatch.show_exceptions
+
+    with_raised_exceptions do
+      2.times { assert_raises(ActiveRecord::RecordNotFound) { get path } }
+      assert_equal configured, Rails.application.config.action_dispatch.show_exceptions
+      assert_equal original, cached
+      get rails_health_check_path
+      assert_response :success
+    end
+
+    assert_same cached, Rails.application.env_config
+    assert_equal original, cached
+    get path
+    assert_response :not_found
+  end
+
+  test "nested scopes preserve the outer scope and the block return value" do
+    path = book_slug_path(books(:manual))
+
+    result = with_raised_exceptions do
+      assert_equal :inner, with_raised_exceptions {
+        assert_raises(ActiveRecord::RecordNotFound) { get path }
+        :inner
+      }
+
+      assert_raises(ActiveRecord::RecordNotFound) do
+        with_raised_exceptions { get path }
+      end
+      assert_raises(ActiveRecord::RecordNotFound) { get path }
+      :outer
+    end
+
+    assert_equal :outer, result
+    get path
+    assert_response :not_found
+  end
+
+  test "escaping exceptions restore normal error handling" do
+    path = book_slug_path(books(:manual))
+
+    assert_raises(ActiveRecord::RecordNotFound) do
+      with_raised_exceptions { get path }
+    end
+    get path
+    assert_response :not_found
+
+    assert_raises(RuntimeError) do
+      with_raised_exceptions { raise "block failure" }
+    end
+    get path
+    assert_response :not_found
+  end
+
+  test "a nonlocal block exit restores normal error handling" do
+    path = book_slug_path(books(:manual))
+
+    result = catch(:finished) do
+      with_raised_exceptions do
+        assert_raises(ActiveRecord::RecordNotFound) { get path }
+        throw :finished, :completed
+      end
+    end
+
+    assert_equal :completed, result
+    get path
+    assert_response :not_found
+  end
+
+  test "existing and newly opened sessions follow the scope" do
+    path = book_slug_path(books(:manual))
+    existing = open_session
+    existing.get path
+    assert_equal 404, existing.response.status
+    opened = nil
+
+    with_raised_exceptions do
+      assert_raises(ActiveRecord::RecordNotFound) { existing.get path }
+      opened = open_session
+      assert_raises(ActiveRecord::RecordNotFound) { opened.get path }
+    end
+
+    [ existing, opened ].each do |session|
+      session.get path
+      assert_equal 404, session.response.status
+    end
+  end
+
+  test "overlapping threads neither leak nor restore each other's scopes" do
+    # Exercise the real exception middleware without sharing database connections.
+    get "/_missing_exception_scope_route"
+    assert_response :not_found
+    first_active, second_active, first_finished = Queue.new, Queue.new, Queue.new
+
+    first = Thread.new do
+      Thread.current.report_on_exception = false
+      session = ActionDispatch::Integration::Session.new(Rails.application)
+      error = with_raised_exceptions do
+        first_active << true
+        second_active.pop
+        routing_error_from(session)
+      end
+      first_finished << true
+      session.get "/_missing_exception_scope_route"
+      [ error, session.response.status ]
+    end
+
+    second = Thread.new do
+      Thread.current.report_on_exception = false
+      first_active.pop
+      session = ActionDispatch::Integration::Session.new(Rails.application)
+      session.get "/_missing_exception_scope_route"
+      before = session.response.status
+      error = with_raised_exceptions do
+        second_active << true
+        first_finished.pop
+        routing_error_from(session)
+      end
+      session.get "/_missing_exception_scope_route"
+      [ before, error, session.response.status ]
+    end
+
+    Timeout.timeout(10) do
+      assert_equal [ ActionController::RoutingError, 404 ], first.value
+      assert_equal [ 404, ActionController::RoutingError, 404 ], second.value
+    end
+  ensure
+    [ first, second ].compact.each do |thread|
+      thread.kill
+      thread.join
+    end
+  end
+
+  private
+    def routing_error_from(session)
+      session.get "/_missing_exception_scope_route"
+      nil
+    rescue ActionController::RoutingError => error
+      error.class
+    end
+end
