diff --git a/test/test_helpers/raised_exceptions_test_helper.rb b/test/test_helpers/raised_exceptions_test_helper.rb
new file mode 100644
index 0000000..dd638c2
--- /dev/null
+++ b/test/test_helpers/raised_exceptions_test_helper.rb
@@ -0,0 +1,25 @@
+module RaisedExceptionsTestHelper
+  STATE_KEY = :writebook_raised_exceptions
+
+  # Rails memoizes env_config. Override a copy for this request's execution
+  # context, never the shared cache or the application configuration.
+  module RequestConfiguration
+    def env_config
+      config = super
+      if Thread.current[STATE_KEY]
+        config.merge("action_dispatch.show_exceptions" => :none)
+      else
+        config
+      end
+    end
+  end
+
+  # Thread#[] is fiber-local as well as isolated between test threads.
+  def with_raised_exceptions
+    previous = Thread.current[STATE_KEY]
+    Thread.current[STATE_KEY] = true
+    yield
+  ensure
+    Thread.current[STATE_KEY] = previous
+  end
+end
