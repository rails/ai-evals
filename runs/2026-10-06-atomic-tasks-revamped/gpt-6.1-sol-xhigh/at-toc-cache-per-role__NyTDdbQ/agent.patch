diff --git a/test/controllers/books/table_of_contents_test.rb b/test/controllers/books/table_of_contents_test.rb
new file mode 100644
index 0000000..2c37959
--- /dev/null
+++ b/test/controllers/books/table_of_contents_test.rb
@@ -0,0 +1,204 @@
+require "test_helper"
+
+class Books::TableOfContentsTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    @original_collection_cache = ActionView::PartialRenderer.collection_cache
+    @original_controller_settings = [ BooksController, LeafablesController ].to_h do |controller|
+      [ controller, [ controller.cache_store, controller.perform_caching ] ]
+    end
+
+    Rails.cache = ActionView::PartialRenderer.collection_cache = ActiveSupport::Cache::MemoryStore.new
+    @original_controller_settings.each_key do |controller|
+      controller.cache_store = Rails.cache
+      controller.perform_caching = true
+    end
+    @book = books(:handbook)
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+    ActionView::PartialRenderer.collection_cache = @original_collection_cache
+    @original_controller_settings.each do |controller, (cache_store, perform_caching)|
+      controller.cache_store = cache_store
+      controller.perform_caching = perform_caching
+    end
+  end
+
+  test "a reader never receives the previous editor's controls" do
+    sign_in :kevin
+    show_handbook
+    assert_editor_controls
+
+    sign_out
+    sign_in :jz
+    show_handbook
+    assert_reader_controls
+
+    show_handbook
+    assert_reader_controls
+  end
+
+  test "an editor receives controls after a reader warms the cache" do
+    sign_in :jz
+    show_handbook
+    assert_reader_controls
+
+    sign_out
+    sign_in :kevin
+    show_handbook
+    assert_editor_controls
+
+    show_handbook
+    assert_editor_controls
+  end
+
+  test "an anonymous reader of a published book never receives editor controls" do
+    @book.update!(published: true)
+    sign_in :kevin
+    show_handbook
+    assert_editor_controls
+
+    sign_out
+    show_handbook
+    assert_reader_controls
+  end
+
+  test "an administrator receives controls after a reader warms the cache" do
+    accesses(:david_handbook).update!(level: :reader)
+    sign_in :jz
+    show_handbook
+
+    sign_out
+    sign_in :david
+    show_handbook
+    assert_editor_controls
+  end
+
+  test "controls follow access changes without changing the book" do
+    sign_in :kevin
+    show_handbook
+    assert_editor_controls
+
+    accesses(:kevin_handbook).update!(level: :reader)
+    show_handbook
+    assert_reader_controls
+
+    accesses(:kevin_handbook).update!(level: :editor)
+    show_handbook
+    assert_editor_controls
+  end
+
+  test "a renamed entry is fresh in both cached permission variants" do
+    sign_in :kevin
+    show_handbook
+    sign_out
+    sign_in :jz
+    show_handbook
+
+    leaf = leaves(:welcome_page)
+    old_title = leaf.title
+    leaf.update!(title: "A newly named welcome")
+
+    show_handbook
+    assert_in_body leaf.title
+    assert_not_in_body old_title
+    assert_reader_controls
+
+    sign_out
+    sign_in :kevin
+    show_handbook
+    assert_in_body leaf.title
+    assert_not_in_body old_title
+    assert_editor_controls
+  end
+
+  test "collection caching does not look up book permissions for each entry" do
+    sign_in :kevin
+    # Exercise a realistically large collection, using duplicates of an existing fixture.
+    200.times { |index| @book.press sections(:welcome).dup, title: "Bulk section #{index}" }
+    leaf_count = @book.leaves.active.count
+
+    2.times do |render_number|
+      # Keep the leaf fragments warm while forcing the enclosing book fragment to render.
+      Rails.cache.delete_matched("views/books/show:*")
+      permission_queries = []
+      collection_queries = []
+      collection_reads = []
+      query_subscriber = ->(event) do
+        sql = event.payload[:sql]
+        permission_queries << sql if sql.match?(/SELECT .* FROM "(?:books|accesses)"/i)
+        collection_queries << sql if sql.match?(/SELECT .* FROM "leaves"/i) && !sql.match?(/LIMIT/i)
+      end
+      cache_subscriber = ->(event) { collection_reads << event.payload }
+
+      ActiveSupport::Notifications.subscribed(query_subscriber, "sql.active_record") do
+        ActiveSupport::Notifications.subscribed(cache_subscriber, "cache_read_multi.active_support") do
+          show_handbook
+        end
+      end
+
+      assert_operator permission_queries.size, :<=, 3, permission_queries.join("\n")
+      assert_equal 1, collection_queries.size, "The full list should be fetched in one query"
+      assert_equal 1, collection_reads.size, "Leaf fragments should be read in one cache operation"
+      assert_equal leaf_count, collection_reads.first[:key].size
+      assert_equal render_number.zero? ? 0 : leaf_count, collection_reads.first[:hits].size
+      assert_editor_controls
+    end
+  end
+
+  test "standalone Turbo Stream updates retain controls and refresh both permission variants" do
+    sign_in :jz
+    show_handbook
+    sign_out
+    sign_in :kevin
+    show_handbook
+
+    [ :welcome_page, :reading_picture, :welcome_section ].each do |name|
+      leaf = leaves(name)
+      title = "Renamed #{leaf.title}"
+      patch leafable_path(leaf, format: :turbo_stream), params: { leaf: { title: title } }
+
+      assert_response :success
+      assert_select "turbo-stream[action='replace'][target='leaf_#{leaf.id}']"
+      assert_in_body title
+      assert_editor_controls([ leaf.reload ])
+    end
+
+    sign_out
+    sign_in :jz
+    show_handbook
+    assert_reader_controls
+    [ :welcome_page, :reading_picture, :welcome_section ].each do |name|
+      assert_in_body leaves(name).reload.title
+    end
+  end
+
+  private
+    def show_handbook
+      get book_slug_path(@book)
+      assert_response :success
+    end
+
+    def assert_editor_controls(collection = @book.leaves.active)
+      collection.each do |leaf|
+        assert_select "#leaf_#{leaf.id}" do
+          assert_select "a[href='#{edit_leafable_path(leaf)}']", count: 2
+          assert_select ".arrangement__handle", count: 1
+          assert_select "form.leaf__delete[action='#{leafable_path(leaf)}']", count: 1
+          assert_select "a[href='#{leafable_slug_path(leaf)}']", count: 2
+        end
+      end
+    end
+
+    def assert_reader_controls
+      assert_select "#leaves .arrangement__handle", count: 0
+      assert_select "#leaves form.leaf__delete", count: 0
+      @book.leaves.active.each do |leaf|
+        assert_select "#leaf_#{leaf.id}" do
+          assert_select "a[href='#{edit_leafable_path(leaf)}']", count: 0
+          assert_select "a[href='#{leafable_slug_path(leaf)}']", count: 2
+        end
+      end
+    end
+end
