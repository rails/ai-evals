diff --git a/test/integration/picture_variants_test.rb b/test/integration/picture_variants_test.rb
new file mode 100644
index 0000000..1df839a
--- /dev/null
+++ b/test/integration/picture_variants_test.rb
@@ -0,0 +1,151 @@
+require "test_helper"
+
+class PictureVariantsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+
+    @service = ActiveStorage::Blob.service
+    @original_storage_root = @service.root
+    @storage_root = Dir.mktmpdir("picture-variants")
+    @service.root = @storage_root
+  end
+
+  teardown do
+    @service.root = @original_storage_root
+    FileUtils.remove_entry @storage_root
+  end
+
+  test "background processing creates the only derived copy served to readers" do
+    upload_picture fixture_file_upload("white-rabbit.webp", "image/webp")
+    picture = Picture.last
+
+    assert_enqueued_jobs 1, only: ActiveStorage::CreateVariantsJob
+    assert_difference -> { ActiveStorage::Blob.count }, 1 do
+      assert_difference -> { stored_files.size }, 1 do
+        assert_transformations 1 do
+          process_variants
+        end
+      end
+    end
+    assert_single_variant picture
+    derived_key = picture.large_image.key
+
+    expected_bytes = reader_bytes(file_fixture("white-rabbit.webp"))
+    picture.book.update!(published: true)
+    sign_out
+
+    assert_no_difference -> { ActiveStorage::Blob.count } do
+      assert_no_changes -> { stored_files } do
+        assert_transformations 0 do
+          get book_slug_path(picture.book)
+          assert_response :success
+
+          2.times do
+            fetch_picture picture
+            assert_equal "image/webp", response.media_type
+            assert_equal expected_bytes, response.body
+          end
+        end
+      end
+    end
+    assert_single_variant picture
+    assert_equal derived_key, picture.reload.large_image.key
+  end
+
+  test "a reader arriving before the background job still creates only one derived copy" do
+    upload_picture fixture_file_upload("white-rabbit.webp", "image/webp")
+    picture = Picture.last
+
+    assert_transformations 1 do
+      fetch_picture picture
+      process_variants
+    end
+    assert_single_variant picture
+  end
+
+  test "oversized JPEG uploads keep the reader's existing resize and WebP encoding" do
+    Tempfile.create([ "large-picture", ".jpg" ]) do |source|
+      Vips::Image.new_from_file(file_fixture("reading.webp").to_s)
+        .resize(2).crop(0, 0, 2048, 1536).write_to_file(source.path)
+      expected_bytes = reader_bytes(source)
+
+      assert_transformations 1 do
+        upload_picture Rack::Test::UploadedFile.new(source.path, "image/jpeg")
+        picture = Picture.last
+        process_variants
+        fetch_picture picture
+
+        assert_equal "image/webp", response.media_type
+        assert_equal expected_bytes, response.body
+        image = Vips::Image.new_from_buffer(response.body, "")
+        assert_equal [ 1500, 1125 ], [ image.width, image.height ]
+        assert_single_variant picture
+      end
+    end
+  end
+
+  test "non-resizable uploads are served unchanged without derived copies" do
+    assert_transformations 0 do
+      upload_picture fixture_file_upload("pixel.bmp", "image/bmp")
+      assert_enqueued_jobs 0, only: ActiveStorage::CreateVariantsJob
+
+      picture = Picture.last
+      process_variants
+      fetch_picture picture
+
+      assert_equal file_fixture("pixel.bmp").binread, response.body
+      assert_equal 0, picture.image.blob.variant_records.count
+      assert_equal [ @service.path_for(picture.image.key) ], stored_files
+    end
+  end
+
+  private
+    def upload_picture(file)
+      post book_pictures_path(books(:handbook), format: :turbo_stream), params: {
+        picture: { image: file }
+      }
+      assert_response :success
+    end
+
+    # Match the reader's existing Vips pipeline, independently of the named variant.
+    def reader_bytes(source)
+      image = ImageProcessing::Vips.source(source)
+        .loader(page: 0).convert("webp").resize_to_limit(1500, 1500).call
+      image.read
+    ensure
+      image&.close!
+    end
+
+    def process_variants
+      jobs = [ ActiveStorage::CreateVariantsJob, ActiveStorage::TransformJob ]
+      perform_enqueued_jobs(only: jobs) { perform_enqueued_jobs(only: jobs) }
+    end
+
+    def fetch_picture(picture)
+      get leafable_slug_path(picture.leaf)
+      assert_response :success
+      assert_select "figure img", count: 1
+
+      get URI(css_select("figure img").first["src"]).request_uri
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+    end
+
+    def assert_transformations(expected)
+      count = 0
+      subscriber = ->(*) { count += 1 }
+      ActiveSupport::Notifications.subscribed(subscriber, "transform.active_storage") { yield }
+      assert_equal expected, count, "unexpected number of image transformations"
+    end
+
+    def assert_single_variant(picture)
+      blob = picture.reload.image.blob
+      assert_equal 1, blob.variant_records.count
+      assert_equal [ @service.path_for(blob.key), @service.path_for(picture.large_image.key) ].sort, stored_files
+    end
+
+    def stored_files
+      Dir.glob(File.join(@service.root, "**", "*")).select { |path| File.file?(path) }.sort
+    end
+end
