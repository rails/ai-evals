diff --git a/app/models/concerns/tenanted.rb b/app/models/concerns/tenanted.rb
new file mode 100644
index 0000000..c5bf376
--- /dev/null
+++ b/app/models/concerns/tenanted.rb
@@ -0,0 +1,14 @@
+module Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    # Tenantless records retain the legacy, install-wide behavior.
+    scope :in_tenant, ->(tenant) { tenant ? where(tenant_id: [ tenant.id, nil ]) : all }
+  end
+
+  def same_tenant_as?(record)
+    tenant_id.nil? || record&.tenant_id.nil? || tenant_id == record.tenant_id
+  end
+end
