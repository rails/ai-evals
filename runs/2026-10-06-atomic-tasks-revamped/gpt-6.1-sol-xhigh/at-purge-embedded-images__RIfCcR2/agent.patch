diff --git a/test/models/page_test.rb b/test/models/page_test.rb
index b4bb79b..b757bab 100644
--- a/test/models/page_test.rb
+++ b/test/models/page_test.rb
@@ -1,6 +1,79 @@
 require "test_helper"
 
 class PageTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges its markdown uploads" do
+    page = pages(:welcome)
+    markdown = page.body
+    markdown.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    upload = markdown.uploads.sole
+    blob = upload.blob
+    page.update! body: "![Reading](#{upload.slug_path})"
+
+    assert blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActionText::Markdown.exists?(markdown.id)
+    assert_not ActiveStorage::Attachment.exists?(upload.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+
+  test "destroying a leaf purges all of its page's markdown uploads" do
+    leaf = leaves(:welcome_page)
+    page = leaf.leafable
+    2.times do
+      page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    end
+    uploads = page.body.uploads.to_a
+    blobs = uploads.map(&:blob)
+    page.update! body: uploads.map { |upload| "![Reading](#{upload.slug_path})" }.join("\n")
+
+    perform_enqueued_jobs do
+      leaf.destroy!
+    end
+
+    assert_not Page.exists?(page.id)
+    uploads.each { |upload| assert_not ActiveStorage::Attachment.exists?(upload.id) }
+    blobs.each do |blob|
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+  end
+
+  test "a shared markdown upload is purged only after its last page is destroyed" do
+    page = pages(:welcome)
+    other_page = pages(:summary)
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    upload = page.body.uploads.sole
+    blob = upload.blob
+    other_page.body.uploads.attach blob
+    other_upload = other_page.body.uploads.sole
+    page.update! body: "![Reading](#{upload.slug_path})"
+    other_page.update! body: "![Reading](#{other_upload.slug_path})"
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(upload.id)
+    assert ActiveStorage::Attachment.exists?(other_upload.id)
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs do
+      other_page.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(other_upload.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+
   test "html preview" do
     page = Page.new(body: "# Hello\n\nWorld!")
 
