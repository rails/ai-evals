diff --git a/config/initializers/resque.rb b/config/initializers/resque.rb
new file mode 100644
index 0000000..bad6dce
--- /dev/null
+++ b/config/initializers/resque.rb
@@ -0,0 +1,9 @@
+# Let continuable jobs checkpoint and requeue during graceful worker shutdown.
+module ResqueWorkerContinuations
+  def shutdown
+    super
+    ActiveJob::Base.queue_adapter.stopping = true
+  end
+end
+
+Resque::Worker.prepend ResqueWorkerContinuations
diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..434a5b8
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,170 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  setup do
+    @leaves = Leaf.order(:id).to_a
+    @titles = [ '"Opening words" in a title', 'A "quoted" middle', 'Ending with "quoted words"', '"' ]
+
+    @leaves.zip(@titles).each do |leaf, title|
+      leaf.update!(title: %Q("#{title}"))
+    end
+  end
+
+  teardown do
+    queue_adapter.stopping = false
+  end
+
+  test "removes only the outer quotes from every leaf, including trashed leaves" do
+    @leaves.last.update!(status: :trashed)
+
+    TitleCleanupJob.perform_now
+
+    assert_cleaned_through @leaves.size
+    assert_enqueued_jobs 0, only: TitleCleanupJob
+  end
+
+  test "resumes a serialized job after the last successfully cleaned leaf" do
+    queue_adapter.stopping = true
+
+    assert_enqueued_jobs 1, only: TitleCleanupJob do
+      TitleCleanupJob.perform_now
+    end
+
+    assert_cleaned_through 1
+    assert_equal [ "cleanup_titles", @leaves.first.id + 1 ], enqueued_jobs.last.fetch("continuation").fetch("current")
+
+    queue_adapter.stopping = false
+    resume_enqueued_job
+
+    assert_cleaned_through @leaves.size
+    assert_enqueued_jobs 0, only: TitleCleanupJob
+  end
+
+  test "Resque shutdown requeues the continuation without requiring a scheduler" do
+    adapter = ActiveJob::QueueAdapters::ResqueAdapter.new
+    payloads = []
+    adapter.define_singleton_method(:enqueue) { |job| payloads << job.serialize }
+    worker = Resque::Worker.new("default")
+    first_id = @leaves.first.id
+    shutdown = ->(leaf) { worker.shutdown if leaf.id == first_id }
+
+    with_queue_adapter adapter do
+      with_update_callback shutdown do
+        TitleCleanupJob.perform_now
+      end
+
+      assert worker.shutdown?
+      assert adapter.stopping?
+      assert_equal 1, payloads.size
+      assert_nil payloads.first.fetch("scheduled_at")
+      assert_cleaned_through 1
+
+      adapter.stopping = false
+      ActiveJob::Base.execute(JSON.parse(payloads.shift.to_json))
+    end
+
+    assert_cleaned_through @leaves.size
+    assert_empty payloads
+  end
+
+  test "makes progress across repeated interruptions without cleaning a title twice" do
+    queue_adapter.stopping = true
+    TitleCleanupJob.perform_now
+
+    1.upto(@leaves.size) do |count|
+      assert_cleaned_through count
+      assert_enqueued_jobs 1, only: TitleCleanupJob
+      resume_enqueued_job
+    end
+
+    assert_cleaned_through @leaves.size
+    assert_enqueued_jobs 0, only: TitleCleanupJob
+  end
+
+  test "retries a failed leaf without skipping it or revisiting successful leaves" do
+    failed_id = @leaves.second.id
+    failure = ->(leaf) { raise "Interrupted update" if leaf.id == failed_id }
+
+    with_update_callback failure do
+      assert_enqueued_jobs 1, only: TitleCleanupJob do
+        TitleCleanupJob.perform_now
+      end
+    end
+
+    assert_cleaned_through 1
+    resume_enqueued_job
+
+    assert_cleaned_through @leaves.size
+    assert_enqueued_jobs 0, only: TitleCleanupJob
+  end
+
+  test "does not skip a failure before any progress" do
+    failed_id = @leaves.first.id
+    failure = ->(leaf) { raise "Interrupted update" if leaf.id == failed_id }
+
+    with_update_callback failure do
+      assert_raises RuntimeError do
+        TitleCleanupJob.perform_now
+      end
+    end
+
+    assert_cleaned_through 0
+    assert_enqueued_jobs 0, only: TitleCleanupJob
+  end
+
+  test "a completed continuation does not clean titles again" do
+    job = TitleCleanupJob.new
+    job.perform_now
+
+    ActiveJob::Base.execute(JSON.parse(job.serialize.to_json))
+
+    assert_cleaned_through @leaves.size
+    assert_enqueued_jobs 0, only: TitleCleanupJob
+  end
+
+  test "handles titles with no quotes, one-sided quotes, and empty titles" do
+    originals = [ "Plain title", '"Leading quote', 'Trailing quote"', "" ]
+    expected = [ "Plain title", "Leading quote", "Trailing quote", "" ]
+    @leaves.zip(originals).each { |leaf, title| leaf.update!(title: title) }
+
+    TitleCleanupJob.perform_now
+
+    assert_equal expected, @leaves.map { |leaf| leaf.reload.title }
+  end
+
+  test "an empty collection completes without scheduling a resumption" do
+    Leaf.destroy_all
+
+    TitleCleanupJob.perform_now
+
+    assert_enqueued_jobs 0, only: TitleCleanupJob
+  end
+
+  private
+    def assert_cleaned_through(count)
+      @leaves.zip(@titles).each_with_index do |(leaf, title), index|
+        expected = index < count ? title : %Q("#{title}")
+        assert_equal expected, leaf.reload.title, "Unexpected title for leaf #{leaf.id}"
+      end
+    end
+
+    def resume_enqueued_job
+      payload = enqueued_jobs.shift.select { |key, _| key.is_a?(String) }
+      ActiveJob::Base.execute(JSON.parse(payload.to_json))
+    end
+
+    def with_queue_adapter(adapter)
+      previous_adapter = ActiveJob::Base.queue_adapter
+      ActiveJob::Base.enable_test_adapter adapter
+      yield
+    ensure
+      ActiveJob::Base.enable_test_adapter previous_adapter
+    end
+
+    def with_update_callback(callback)
+      Leaf.set_callback :update, :before, callback
+      yield
+    ensure
+      Leaf.skip_callback :update, :before, callback
+    end
+end
