+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,320 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  # Exercise real commits and rollbacks rather than the fixture transaction.
+  self.use_transactional_tests = false
+
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "publication is announced once after commit" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ]
+    assert @book.reload.published?
+  end
+
+  test "publication with added pages is announced once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "New page"
+        @book.press Page.new(body: ""), title: "Another page"
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ]
+    assert @book.reload.published?
+  end
+
+  test "publication with renamed and trashed pages is announced once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.leaves.find(leaves(:welcome_page).id).update! title: "Renamed page"
+        @book.leaves.find(leaves(:summary_page).id).update! status: :trashed
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ]
+    assert @book.reload.published?
+  end
+
+  test "publication survives later book saves in the same transaction" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.update! slug: "new-slug"
+        @book.save!
+        @book.touch
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+  end
+
+  test "saving or touching an already published book does not announce it again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true, title: "New title"
+        @book.save!
+        @book.press Page.new(body: ""), title: "New page"
+      end
+    end
+  end
+
+  test "saving a draft does not announce it" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: false, title: "New title"
+        @book.press Page.new(body: ""), title: "New page"
+      end
+    end
+  end
+
+  test "unpublishing a book does not announce it" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "a transaction ending in a draft does not announce it" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+        @book.touch
+      end
+    end
+
+    assert_not @book.reload.published?
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "multiple publication changes in one transaction announce the final publication once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+        @book.update! published: true
+        @book.touch
+      end
+    end
+  end
+
+  test "a book that was already live at the start of a transaction is not announced again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "failed page changes roll back publication without announcing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_no_difference -> { @book.leaves.count } do
+        assert_raises ActiveRecord::RecordNotFound do
+          @book.transaction do
+            @book.update! published: true
+            @book.press Page.new(body: ""), title: "Rolled back page"
+            @book.leaves.find(-1).update! title: "Missing page"
+          end
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Still a draft"
+      @book.touch
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "explicit rollback does not leave an announcement pending" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.reload.published?
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.save!
+    end
+  end
+
+  test "publication survives a later save through another book instance" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        Book.find(@book.id).update! slug: "another-instance"
+      end
+    end
+  end
+
+  test "announcement reflects committed publication rather than unsaved attributes" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.published = false
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "unpublication through another instance prevents an announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        Book.find(@book.id).update! published: false
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "a rolled back savepoint does not erase an outer publication" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.transaction(requires_new: true) do
+          @book.update! published: false
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "publication changes across instances are announced only once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        Book.find(@book.id).update! published: false
+        Book.find(@book.id).update! published: true
+      end
+    end
+  end
+
+  test "an already live book is not reannounced by changes across instances" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: false
+        Book.find(@book.id).update! published: true
+      end
+    end
+  end
+
+  test "a committed savepoint does not announce before the outer commit" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.transaction(requires_new: true) do
+          @book.update! published: true
+        end
+
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+        @book.update! slug: "outside-savepoint"
+      end
+    end
+  end
+
+  test "publication changes in committed savepoints announce only once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+        @book.transaction(requires_new: true) do
+          Book.find(@book.id).update! published: true
+        end
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+  end
+
+  test "publication in a savepoint is discarded when the outer transaction fails" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.transaction(requires_new: true) do
+          @book.update! published: true
+        end
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.reload.published?
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "a rolled back publication does not prevent publication later in the outer transaction" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.transaction(requires_new: true) do
+          @book.update! published: true
+          raise ActiveRecord::Rollback
+        end
+        @book.reload.update! published: true
+      end
+    end
+  end
+
+  test "books published in the same transaction each receive one announcement" do
+    other_book = books(:manual)
+
+    assert_enqueued_jobs 2, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        other_book.update! published: true
+        @book.touch
+        other_book.touch
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ]
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ other_book ]
+  end
+
+  test "a book deleted in the publication transaction is not announced" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.destroy!
+      end
+    end
+  end
+end
