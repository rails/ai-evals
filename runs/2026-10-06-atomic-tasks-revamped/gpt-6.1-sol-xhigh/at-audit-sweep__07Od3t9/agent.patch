--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,86 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "readers cannot edit update or destroy a book" do
+    sign_in :jz
+    book = books(:handbook)
+
+    get edit_book_path(book)
+    assert_response :forbidden
+
+    assert_no_changes -> { book.reload.title } do
+      patch book_path(book), params: { book: { title: "Forged" } }
+    end
+    assert_response :forbidden
+
+    assert_no_difference [ "Book.count", "Leaf.count", "Access.count" ] do
+      delete book_path(book)
+    end
+    assert_response :forbidden
+  end
+
+  test "publication does not allow a signed in non-editor to update or destroy a book" do
+    book = books(:manual)
+    book.update!(published: true)
+    assert_not book.accessable?(user: users(:kevin))
+
+    get edit_book_path(book)
+    assert_response :forbidden
+
+    assert_no_changes -> { book.reload.title } do
+      patch book_path(book), params: { book: { title: "Forged" } }
+    end
+    assert_response :forbidden
+
+    assert_no_difference [ "Book.count", "Access.count" ] do
+      delete book_path(book)
+    end
+    assert_response :forbidden
+  end
+
+  test "unreadable books cannot be updated or destroyed" do
+    book = books(:manual)
+
+    assert_no_changes -> { book.reload.title } do
+      patch book_path(book), params: { book: { title: "Forged" } }
+    end
+    assert_response :not_found
+
+    assert_no_difference "Book.count" do
+      delete book_path(book)
+    end
+    assert_response :not_found
+  end
+
+  test "editors can update a book" do
+    book = books(:handbook)
+
+    get edit_book_path(book)
+    assert_response :success
+
+    patch book_path(book), params: { book: { title: "Updated Handbook" } }
+
+    assert_redirected_to book_slug_path(book.reload)
+    assert_equal "Updated Handbook", book.title
+  end
+
+  test "editors can destroy a book" do
+    assert_difference "Book.count", -1 do
+      delete book_path(books(:handbook))
+    end
+
+    assert_redirected_to root_path
+  end
+
+  test "administrators can destroy a book without an editor access" do
+    sign_in :david
+    accesses(:david_handbook).update!(level: :reader)
+
+    assert_difference "Book.count", -1 do
+      delete book_path(books(:handbook))
+    end
+
+    assert_redirected_to root_path
+  end
 end
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..9506b88 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,76 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "pages of unreadable books cannot be read under a readable book id" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(book: books(:manual))
+
+    [ nil, :md ].each do |format|
+      get leafable_slug_path(leaf, format: format)
+      assert_response :not_found
+
+      get slugged_leafable_path(books(:handbook), books(:handbook).slug, leaf, leaf.slug, format: format)
+      assert_response :not_found
+
+      get book_page_path(books(:handbook), leaf, format: format)
+      assert_response :not_found
+    end
+  end
+
+  test "signed out readers cannot read private pages under a published book id" do
+    leaf = leaves(:welcome_page)
+    books(:manual).update!(published: true)
+    sign_out
+
+    [ nil, :md ].each do |format|
+      get slugged_leafable_path(books(:manual), books(:manual).slug, leaf, leaf.slug, format: format)
+      assert_response :not_found
+
+      get book_page_path(books(:manual), leaf, format: format)
+      assert_response :not_found
+    end
+  end
+
+  test "page ids must belong to the URL book even when both books are readable" do
+    sign_in :jz
+    leaf = leaves(:welcome_page)
+
+    get slugged_leafable_path(books(:manual), books(:manual).slug, leaf, leaf.slug)
+    assert_response :not_found
+
+    get leafable_slug_path(leaf)
+    assert_response :success
+  end
+
+  test "signed out readers can read published pages in HTML and Markdown" do
+    books(:handbook).update!(published: true)
+    sign_out
+
+    [ nil, :md ].each do |format|
+      get leafable_slug_path(leaves(:welcome_page), format: format)
+      assert_response :success
+
+      get leafable_path(leaves(:welcome_page), format: format)
+      assert_response :success
+    end
+  end
+
+  test "an editor of one book cannot edit or delete a page of another book" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(book: books(:manual))
