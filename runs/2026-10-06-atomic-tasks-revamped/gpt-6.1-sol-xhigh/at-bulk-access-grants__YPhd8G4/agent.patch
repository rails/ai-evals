diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..93359f4
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,321 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  # Notifications must be tested against real commits, not fixture transactions.
+  self.use_transactional_tests = false
+
+  setup do
+    @book = books(:manual)
+    clear_enqueued_jobs
+  end
+
+  test "imports persisted accesses in grant order and notifies each person" do
+    @book.accesses.delete_all
+    grants = [
+      { user_id: users(:kevin).id.to_s, level: :reader },
+      { user_id: users(:jz).id, level: "editor" }
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_nil result.duplicate_index
+    assert_equal [ users(:kevin).id, users(:jz).id ], result.accesses.map(&:user_id)
+    assert_equal [ "reader", "editor" ], result.accesses.map(&:level)
+    assert_equal 2, @book.accesses.count
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob
+    result.accesses.each do |access|
+      assert_predicate access, :persisted?
+      assert_equal @book.id, access.book_id
+      assert_equal access, Access.find(access.id)
+      assert_not_nil access.created_at
+      assert_not_nil access.updated_at
+      assert_enqueued_with job: Book::AccessNotificationJob, args: [ access ]
+    end
+  end
+
+  test "an empty roster succeeds without writing or notifying" do
+    result = nil
+    writes = capture_writes { result = Book::AccessImport.new(@book, []).import }
+
+    assert_nil result.duplicate_index
+    assert_empty result.accesses
+    assert_empty writes.grep(/\b(?:INSERT|UPDATE|DELETE)\b/i)
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "an existing access rejects the whole roster at its index" do
+    original = @book.accesses.order(:id).map(&:attributes)
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :editor }
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal original, @book.accesses.order(:id).map(&:attributes)
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "a duplicate in the first row reports index zero without changing its level" do
+    result = Book::AccessImport.new(@book, [ { user_id: users(:jz).id.to_s, level: :editor } ]).import
+
+    assert_equal 0, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal "reader", accesses(:jz_manual).reload.level
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "a duplicate within the roster uses type cast user IDs and reports the first repeated row" do
+    @book.accesses.delete_all
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :editor },
+      { user_id: users(:kevin).id.to_s, level: :editor },
+      { user_id: users(:jz).id, level: :reader }
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal 2, result.duplicate_index
+    assert_empty result.accesses
+    assert_empty @book.accesses.reload
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "an unknown level rejects the whole roster at its index" do
+    @book.accesses.delete_all
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: "owner" },
+      { user_id: users(:david).id, level: :editor }
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_empty @book.accesses.reload
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "an unknown level in the first row reports index zero" do
+    result = Book::AccessImport.new(@book, [ { user_id: users(:kevin).id, level: :owner } ]).import
+
+    assert_equal 0, result.duplicate_index
+    assert_empty result.accesses
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "the earliest bad row wins when a duplicate precedes an unknown level" do
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: users(:jz).id, level: :reader },
+      { user_id: users(:david).id, level: :owner }
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "access on another book is not a duplicate" do
+    result = Book::AccessImport.new(@book, [ { user_id: users(:kevin).id, level: :reader } ]).import
+
+    assert_nil result.duplicate_index
+    assert_equal 1, result.accesses.size
+    assert_equal "editor", accesses(:kevin_handbook).reload.level
+    assert_enqueued_jobs 1, only: Book::AccessNotificationJob
+  end
+
+  test "missing users retain the existing validation error without partial writes or notifications" do
+    @book.accesses.delete_all
+    grants = [
+      { user_id: users(:kevin).id, level: :reader },
+      { user_id: nil, level: :editor }
+    ]
+
+    assert_raises ActiveRecord::RecordInvalid do
+      Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_empty @book.accesses.reload
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "notifications wait for the enclosing transaction to commit" do
+    result = nil
+    Access.transaction do
+      result = Book::AccessImport.new(@book, [ { user_id: users(:kevin).id, level: :reader } ]).import
+
+      assert_nil result.duplicate_index
+      assert_predicate result.accesses.first, :persisted?
+      assert_no_enqueued_jobs only: Book::AccessNotificationJob
+    end
+
+    assert_enqueued_with job: Book::AccessNotificationJob, args: [ result.accesses.first ]
+  end
+
+  test "rolling back an enclosing transaction discards notifications" do
+    Access.transaction do
+      result = Book::AccessImport.new(@book, [ { user_id: users(:kevin).id, level: :reader } ]).import
+      assert_nil result.duplicate_index
+      raise ActiveRecord::Rollback
+    end
+
+    assert_not @book.accesses.exists?(user_id: users(:kevin).id)
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "rolling back a savepoint discards notifications even when the outer transaction commits" do
+    Access.transaction do
+      Access.transaction(requires_new: true) do
+        result = Book::AccessImport.new(@book, [ { user_id: users(:kevin).id, level: :reader } ]).import
+        assert_nil result.duplicate_index
+        assert_no_enqueued_jobs only: Book::AccessNotificationJob
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.accesses.exists?(user_id: users(:kevin).id)
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "successful rosters use a constant number of writes" do
+    user_ids = roster_user_ids(16)
+    writes = [ 4, 16 ].map do |size|
+      @book.accesses.delete_all
+      clear_enqueued_jobs
+      result = nil
+      statements = capture_writes do
+        result = Book::AccessImport.new(@book, grants_for(user_ids.first(size))).import
+      end
+      assert_nil result.duplicate_index
+      assert_equal size, result.accesses.size
+      assert_enqueued_jobs size, only: Book::AccessNotificationJob
+      statements
+    end
+
+    assert_equal writes.first.size, writes.last.size, writes.inspect
+    assert_equal 1, writes.last.grep(/\bINSERT\b/i).size
+  end
+
+  test "rejected rosters with a late existing duplicate use a constant number of writes" do
+    user_ids = roster_user_ids(16)
+    writes = [ 4, 16 ].map do |size|
+      @book.accesses.delete_all
+      @book.accesses.create!(user_id: user_ids[size - 1], level: :editor)
+      result = nil
+      statements = capture_writes do
+        result = Book::AccessImport.new(@book, grants_for(user_ids.first(size))).import
+      end
+      assert_equal size - 1, result.duplicate_index
+      assert_empty result.accesses
+      assert_equal 1, @book.accesses.count
+      assert_no_enqueued_jobs only: Book::AccessNotificationJob
+      statements
+    end
+
+    assert_equal writes.first.size, writes.last.size, writes.inspect
+  end
+
+  test "database uniqueness failures roll back the batch with constant writes and no notifications" do
+    user_ids = roster_user_ids(16)
+    writes = [ 4, 16 ].map do |size|
+      @book.accesses.delete_all
+      existing_access = @book.accesses.create!(user_id: user_ids[size - 1], level: :editor)
+      result = nil
+      checks = 0
+      existing_ids = @book.accesses.pluck(:user_id)
+      pluck = ->(*) { (checks += 1) == 1 ? [] : existing_ids }
+
+      # Hide the existing row from preflight to exercise the real unique index,
+      # as if another importer had inserted it after the initial check.
+      accesses = @book.accesses
+      accesses.define_singleton_method(:pluck, pluck)
+      begin
+        statements = capture_writes do
+          result = Book::AccessImport.new(@book, grants_for(user_ids.first(size))).import
+        end
+      ensure
+        accesses.singleton_class.remove_method(:pluck)
+      end
+
+      assert_equal size - 1, result.duplicate_index
+      assert_empty result.accesses
+      assert_equal [ existing_access.attributes ], @book.accesses.order(:id).map(&:attributes)
+      assert_no_enqueued_jobs only: Book::AccessNotificationJob
+      statements
+    end
+
+    assert_equal writes.first.size, writes.last.size, writes.inspect
+    assert_equal 1, writes.last.grep(/\bINSERT\b/i).size
+  end
+
+  test "rejected rosters with a late internal duplicate use a constant number of writes" do
+    user_ids = roster_user_ids(16)
+    writes = [ 4, 16 ].map do |size|
+      @book.accesses.delete_all
+      grants = grants_for(user_ids.first(size - 1) + [ user_ids.first ])
+      result = nil
+      statements = capture_writes { result = Book::AccessImport.new(@book, grants).import }
+      assert_equal size - 1, result.duplicate_index
+      assert_empty result.accesses
+      assert_empty @book.accesses.reload
+      assert_no_enqueued_jobs only: Book::AccessNotificationJob
+      statements
+    end
+
+    assert_equal writes.first.size, writes.last.size, writes.inspect
+  end
+
+  test "rejected rosters with a late unknown level use a constant number of writes" do
+    user_ids = roster_user_ids(16)
+    writes = [ 4, 16 ].map do |size|
+      @book.accesses.delete_all
+      grants = grants_for(user_ids.first(size))
+      grants.last[:level] = :owner
+      result = nil
+      statements = capture_writes { result = Book::AccessImport.new(@book, grants).import }
+      assert_equal size - 1, result.duplicate_index
+      assert_empty result.accesses
+      assert_empty @book.accesses.reload
+      assert_no_enqueued_jobs only: Book::AccessNotificationJob
+      statements
+    end
+
+    assert_equal writes.first.size, writes.last.size, writes.inspect
+  end
+
+  private
+    def grants_for(user_ids)
+      user_ids.map { |id| { user_id: id, level: :reader } }
+    end
+
+    def roster_user_ids(count)
+      # The four fixture users suffice for small rosters; clone fixture attributes
+      # only to supply the additional people needed for the scaling regression.
+      attributes = users(:kevin).attributes.slice("password_digest", "role", "active")
+      User.insert_all!(Array.new(count - User.count) do |index|
+        attributes.merge("name" => "Import user #{index}", "email_address" => "import-#{index}@example.com")
+      end)
+      User.order(:id).limit(count).ids
+    end
+
+    def capture_writes
+      statements = []
+      subscriber = ->(event) do
+        sql = event.payload[:sql]
+        if sql.match?(/\A\s*(?:INSERT|UPDATE|DELETE|BEGIN|COMMIT|ROLLBACK|SAVEPOINT|RELEASE)\b/i)
+          statements << sql
+        end
+      end
+      ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") { yield }
+      statements
+    end
+end
