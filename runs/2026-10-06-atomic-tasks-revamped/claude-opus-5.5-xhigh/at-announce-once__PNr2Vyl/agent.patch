 end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..cae599f
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,141 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "going live announces the book" do
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ] do
+      @book.update! published: true
+    end
+  end
+
+  test "going live is announced once however many times the book is saved in the sitting" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! title: "The Manual"
+        @book.press Page.new(body: "Words"), title: "Introduction"
+        @book.touch
+      end
+    end
+  end
+
+  test "going live is announced once when the sitting saves other instances of the book" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        Book.find(@book.id).update! title: "The Manual"
+      end
+    end
+  end
+
+  test "going live is announced once when it took several tries in the sitting" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "a book created live is announced" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.create! title: "Live from the start", published: true
+    end
+  end
+
+  test "a book created and taken live in the same sitting is announced" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.create!(title: "Brand new").update!(published: true)
+      end
+    end
+  end
+
+  test "an already-live book saved again is not announced again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: true, title: "The Manual"
+      @book.press Page.new(body: "Words"), title: "Introduction"
+    end
+  end
+
+  test "an already-live book taken down and back up in one sitting is not announced again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "taking a book down announces nothing" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "a save that leaves the book a draft announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "The Manual"
+
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+      end
+    end
+  end
+
+  test "a sitting that fails after the book went live leaves a draft and announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises ActiveRecord::RecordNotFound do
+        Book.transaction do
+          @book.update! published: true
+          @book.leaves.find(0)
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "a book is announced when it goes live after an earlier sitting failed" do
+    assert_raises ActiveRecord::RecordNotFound do
+      Book.transaction do
+        @book.update! published: true
+        @book.leaves.find(0)
+      end
+    end
+
+    @book.reload
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "only the part of a sitting that commits counts" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+
+        Book.transaction(requires_new: true) do
+          @book.update! published: false
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+
+    assert @book.reload.published?
+  end
+end
