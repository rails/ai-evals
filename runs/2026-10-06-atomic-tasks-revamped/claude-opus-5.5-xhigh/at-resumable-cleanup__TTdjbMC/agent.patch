--- /dev/null
+++ b/test/lib/rails_ext/resque_active_job_stopping_test.rb
@@ -0,0 +1,12 @@
+require "test_helper"
+
+class ResqueActiveJobStoppingTest < ActiveJob::TestCase
+  test "a Resque worker asked to shut down tells Active Job it's stopping" do
+    # The adapter is shared between tests, so put the flag back afterwards
+    queue_adapter.with(stopping: false) do
+      Resque::Worker.new("default").shutdown
+
+      assert queue_adapter.stopping?
+    end
+  end
+end
