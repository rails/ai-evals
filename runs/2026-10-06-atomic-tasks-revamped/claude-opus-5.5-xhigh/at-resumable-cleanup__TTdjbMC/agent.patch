+++ b/app/jobs/title_cleanup_job.rb
@@ -1,7 +1,18 @@
 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  # Stripping the quotes isn't idempotent, so when interrupted (e.g. by a deploy)
+  # the job re-enqueues itself with its cursor and carries on from the next leaf.
+  # It's re-enqueued right away: Resque can't schedule jobs without resque-scheduler,
+  # so the default resume delay would make the re-enqueue itself fail.
+  self.resume_options = {}
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :clean_titles do |step|
+      Leaf.find_each(start: step.cursor, order: :asc) do |leaf|
+        leaf.update!(title: cleaned(leaf.title))
+        step.advance! from: leaf.id
+      end
     end
   end
 
diff --git a/lib/rails_ext/resque_active_job_stopping.rb b/lib/rails_ext/resque_active_job_stopping.rb
new file mode 100644
index 0000000..740d19b
--- /dev/null
+++ b/lib/rails_ext/resque_active_job_stopping.rb
@@ -0,0 +1,20 @@
+# Resque doesn't tell Active Job when a worker has been asked to shut down, so
+# ActiveJob::Continuable jobs never hit an interrupting checkpoint: a deploy kills
+# them mid-run and their progress is lost. Flag the adapter as stopping as soon as
+# the worker is told to shut down, so those jobs checkpoint, re-enqueue themselves
+# with their progress, and let the worker exit.
+#
+# This works for workers that run jobs in-process (FORK_PER_JOB=false, see the
+# Procfile) and don't set TERM_CHILD, which makes Resque raise inside the running
+# job instead.
+module Resque::ActiveJobStopping
+  # Called from a signal trap, so only flag the adapter here.
+  def shutdown
+    ActiveJob::Base.queue_adapter.stopping = true
+    super
+  end
+end
+
+ActiveSupport.on_load :active_job do
+  Resque::Worker.prepend Resque::ActiveJobStopping
+end
diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..a5bbef8
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    @leaves = Leaf.order(:id).to_a
+
+    # Titles that legitimately open with a quoted phrase, both early and late in the run
+    @leaves.first.update!(title: %("Hello," she said))
+    @leaves.last.update!(title: %("Goodbye," he replied))
+    @cleaned_titles = titles
+
+    # The legacy exporter wrapped every title in quotes
+    @leaves.each { |leaf| leaf.update!(title: %("#{leaf.title}")) }
+  end
+
+  test "strips the quotes the legacy exporter wrapped around every title" do
+    TitleCleanupJob.perform_now
+
+    assert_equal @cleaned_titles, titles
+  end
+
+  test "picks up where it left off after an interruption" do
+    first, second, *rest = @leaves
+
+    TitleCleanupJob.perform_later
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: second.id + 1) { perform_enqueued_jobs }
+
+    assert_equal @cleaned_titles.values_at(first.id, second.id), titles.values_at(first.id, second.id)
+    assert_equal rest.map { |leaf| %("#{@cleaned_titles[leaf.id]}") }, titles.values_at(*rest.map(&:id))
+    assert_enqueued_jobs 1, only: TitleCleanupJob
+
+    perform_enqueued_jobs
+
+    assert_equal @cleaned_titles, titles
+    assert_no_enqueued_jobs
+  end
+
+  test "survives being interrupted after every leaf" do
+    TitleCleanupJob.perform_later
+
+    @leaves.size.times do
+      queue_adapter.with(stopping: true) { perform_enqueued_jobs }
+    end
+    perform_enqueued_jobs
+
+    assert_equal @cleaned_titles, titles
+    assert_no_enqueued_jobs
+  end
+
+  private
+    def titles
+      Leaf.order(:id).pluck(:id, :title).to_h
+    end
+end
