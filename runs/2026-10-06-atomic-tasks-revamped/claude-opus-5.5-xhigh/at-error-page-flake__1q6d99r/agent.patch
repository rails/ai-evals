diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..85fcbe7 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,26 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Lets controller errors raised inside the block propagate to the test
+    # instead of being rendered as error pages.
+    #
+    # Rails only reads config.action_dispatch.show_exceptions once, when
+    # Rails.application.env_config is first memoized (on the first request in
+    # the process), and merges that memoized hash into every request's env.
+    # Changing the config value therefore does nothing once a request has run,
+    # and changing it before the first request bakes the override in for every
+    # later test in that worker. So override the per-request setting the
+    # exception middleware actually reads, and always put it back.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
-      yield
-    ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config = Rails.application.env_config
+      previous = env_config["action_dispatch.show_exceptions"]
+      env_config["action_dispatch.show_exceptions"] = :none
+
+      begin
+        yield
+      ensure
+        env_config["action_dispatch.show_exceptions"] = previous
+      end
     end
   end
 end
