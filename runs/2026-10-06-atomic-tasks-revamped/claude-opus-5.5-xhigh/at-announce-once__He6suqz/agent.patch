diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..69862c5 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,10 +2,35 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_save :announce_publication_after_commit, if: :saved_change_to_published?
   end
 
   private
+    # A sitting can save the book many times before it commits (leaves touch it,
+    # positioning locks reload it, other instances of it get saved last), so by
+    # commit time saved_changes no longer says whether the book went live. Note
+    # what the book was when the sitting began, and decide once it has committed.
+    def announce_publication_after_commit
+      return if @publication_change_pending
+      @publication_change_pending = true
+
+      published_before_sitting = published_before_last_save
+      transaction = self.class.current_transaction
+
+      transaction.after_commit do
+        @publication_change_pending = false
+        announce_publication if !published_before_sitting && live?
+      end
+
+      transaction.after_rollback do
+        @publication_change_pending = false
+      end
+    end
+
+    def live?
+      self.class.published.exists?(id)
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
diff --git a/test/controllers/books/publications_controller_test.rb b/test/controllers/books/publications_controller_test.rb
index 8761ea8..a90c129 100644
--- a/test/controllers/books/publications_controller_test.rb
+++ b/test/controllers/books/publications_controller_test.rb
@@ -29,4 +29,75 @@ class Books::PublicationsTest < ActionDispatch::IntegrationTest
     assert_redirected_to book_slug_url(@book)
     assert_equal "new-slug", @book.slug
   end
+
+  test "publishing a book announces it once" do
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ] do
+      patch book_publication_path(@book), params: { book: { published: "1" } }
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob
+  end
+
+  test "publishing a book while adding a page announces it once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "1" }, added_pages: [ "Introduction" ] }
+    end
+
+    assert @book.reload.published?
+    assert_equal [ "Introduction" ], @book.leaves.pluck(:title)
+  end
+
+  test "publishing a book while trashing and renaming pages announces it once" do
+    book = books(:handbook)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_path(book), params: {
+        book: { published: "1" },
+        trashed_page_ids: [ leaves(:summary_page).id ],
+        renamed_pages: { leaves(:welcome_page).id => "Welcome" }
+      }
+    end
+
+    assert book.reload.published?
+    assert leaves(:summary_page).reload.trashed?
+    assert_equal "Welcome", leaves(:welcome_page).reload.title
+  end
+
+  test "unpublishing a book does not announce it" do
+    @book.update_columns published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "0" } }
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "saving an already published book does not announce it again" do
+    @book.update_columns published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "1", slug: "new-slug" }, added_pages: [ "Appendix" ] }
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "saving a draft without publishing it does not announce it" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { slug: "new-slug" }, added_pages: [ "Appendix" ] }
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "a failed sitting leaves the book a draft and does not announce it" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "1" }, added_pages: [ "Appendix" ], trashed_page_ids: [ "missing" ] }
+    end
+
+    assert_response :not_found
+    assert_not @book.reload.published?
+    assert_empty @book.leaves
+  end
 end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..0b2d119
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "publishing announces the book" do
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ] do
+      @book.update! published: true
+    end
+  end
+
+  test "saving a published book again does not announce it again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "The Manual"
+      @book.update! published: true
+    end
+  end
+
+  test "unpublishing does not announce" do
+    @book.update_columns published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "publishing alongside other changes to the book announces once" do
+    book = books(:handbook)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update! published: true
+        book.press Page.new(body: ""), title: "Appendix"
+        Leaf.find(leaves(:welcome_page).id).update! title: "Welcome"
+      end
+    end
+  end
+
+  test "a sitting that ends where it started does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+      end
+    end
+
+    @book.update_columns published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "a sitting that fails after publishing leaves a draft and does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises ActiveRecord::RecordNotFound do
+        @book.transaction do
+          @book.update! published: true
+          @book.press Page.new(body: ""), title: "Appendix"
+          @book.leaves.find(0)
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+    assert_empty @book.leaves
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "publishing in a nested transaction announces only once the outer one commits" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.transaction(requires_new: true) { @book.update! published: true }
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.reload.published?
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.transaction(requires_new: true) { @book.update! published: true }
+      end
+    end
+  end
+end
