diff --git a/app/models/leaf.rb b/app/models/leaf.rb
index fb7e68b..bf1b0be 100644
--- a/app/models/leaf.rb
+++ b/app/models/leaf.rb
@@ -1,6 +1,8 @@
 class Leaf < ApplicationRecord
   include Editable, Positionable, Searchable
 
+  LIKE_ESCAPE_CHARACTER = "\\"
+
   belongs_to :book, touch: true
   delegated_type :leafable, types: Leafable::TYPES, dependent: :destroy
   positioned_within :book, association: :leaves, filter: :active
@@ -11,6 +13,14 @@ class Leaf < ApplicationRecord
 
   scope :with_leafables, -> { includes(:leafable) }
 
+  # Case-insensitive substring match on the title. The text is always bound as data,
+  # and LIKE metacharacters in it (%, _ and the escape character itself) are escaped
+  # so that they only ever match themselves.
+  scope :titled_with, ->(text) {
+    pattern = "%#{sanitize_sql_like(text.to_s, LIKE_ESCAPE_CHARACTER)}%"
+    where("leaves.title LIKE ? ESCAPE ?", pattern, LIKE_ESCAPE_CHARACTER)
+  }
+
   def slug
     title.parameterize.presence || "-"
   end
