diff --git a/test/models/leaf_test.rb b/test/models/leaf_test.rb
index c38ed29..de47c75 100644
--- a/test/models/leaf_test.rb
+++ b/test/models/leaf_test.rb
@@ -10,4 +10,28 @@ class LeafTest < ActiveSupport::TestCase
     leaf = Leaf.new(title: "")
     assert_equal "-", leaf.slug
   end
+
+  test "titled_with matches part of a title regardless of case" do
+    assert_equal [ leaves(:welcome_section), leaves(:welcome_page) ].sort, Leaf.titled_with("WELCOME").sort
+  end
+
+  test "titled_with treats LIKE wildcards and the escape character literally" do
+    percent = books(:handbook).press Page.new, title: "Save 50% off"
+    underscore = books(:handbook).press Page.new, title: "read_me"
+    backslash = books(:handbook).press Page.new, title: "C:\\temp"
+
+    assert_equal [ percent ], Leaf.titled_with("%")
+    assert_equal [ percent ], Leaf.titled_with("50% off")
+    assert_equal [ underscore ], Leaf.titled_with("_")
+    assert_equal [ backslash ], Leaf.titled_with("\\")
+    assert_empty Leaf.titled_with("S%y")
+    assert_empty Leaf.titled_with("Summar_")
+  end
+
+  test "titled_with treats quotes as data" do
+    quoted = books(:handbook).press Page.new, title: "It's here"
+
+    assert_equal [ quoted ], Leaf.titled_with("it's")
+    assert_empty Leaf.titled_with("' or '1'='1")
+  end
 end
