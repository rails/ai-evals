diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..7fcb374
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "show finds matching page titles, ignoring case" do
+    get library_search_path, params: { q: "welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /The Welcome Section/
+    assert_select "a.search__result", text: /Welcome to The Handbook!/
+    assert_select "a.search__result", text: /Summary/, count: 0
+  end
+
+  test "show without a query lists nothing" do
+    get library_search_path
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_select ".search__no_matches", count: 0
+  end
+
+  test "show says when nothing matches" do
+    get library_search_path, params: { q: "the invisible man" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_select ".search__no_matches"
+  end
+
+  test "show does not find trashed pages" do
+    leaves(:summary_page).trashed!
+
+    get library_search_path, params: { q: "Summary" }
+
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show only finds pages in books the user may read" do
+    books(:manual).press Page.new(body: "Secret"), title: "Welcome to the Manual"
+
+    get library_search_path, params: { q: "welcome" }
+
+    assert_select "a.search__result", text: /Welcome to The Handbook!/
+    assert_not_in_body "Welcome to the Manual"
+  end
+
+  test "show includes pages from published books the user has no access to" do
+    books(:manual).press Page.new(body: "Public"), title: "Welcome to the Manual"
+    books(:manual).update!(published: true)
+
+    get library_search_path, params: { q: "welcome" }
+
+    assert_select "a.search__result", text: /Welcome to the Manual/
+  end
+
+  test "show when signed out only finds pages in published books" do
+    books(:manual).press Page.new(body: "Public"), title: "Welcome to the Manual"
+    books(:manual).update!(published: true)
+    sign_out
+
+    get library_search_path, params: { q: "welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Welcome to the Manual/
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show treats SQL in the query as data" do
+    books(:manual).press Page.new(body: "Secret"), title: "Top Secret"
+
+    [ "%' or 1=1 or '%", "') or ('1'='1", "x' union select * from leaves --" ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "a.search__result", count: 0
+      assert_not_in_body "Top Secret"
+    end
+  end
+
+  test "show handles punctuation as search text" do
+    books(:handbook).press Page.new(body: "Hello"), title: "Kevin's notes"
+
+    get library_search_path, params: { q: "kevin's" }
+    assert_response :success
+    assert_select "a.search__result", text: /Kevin's notes/, count: 1
+
+    %w[ ' " ; -- /* \\ ( ) [ ] ].each do |query|
+      get library_search_path, params: { q: query }
+      assert_response :success
+    end
+  end
+
+  test "show matches percent signs literally" do
+    books(:handbook).press Page.new(body: "Deal"), title: "Save 50% off"
+
+    [ "Save 50% off", "50%", "%" ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_select "a.search__result", count: 1, text: /Save 50% off/
+    end
+
+    get library_search_path, params: { q: "5%f" }
+    assert_select "a.search__result", count: 0
+  end
+
+  test "show matches underscores literally" do
+    books(:handbook).press Page.new(body: "Notes"), title: "read_me"
+
+    get library_search_path, params: { q: "_" }
+    assert_select "a.search__result", count: 1, text: /read_me/
+
+    get library_search_path, params: { q: "Summar_" }
+    assert_select "a.search__result", count: 0
+  end
+end
