diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..5e925d8
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    Current.user = users(:david)
+  end
+
+  test "destroying a user erases everything of theirs" do
+    @kevin.sessions.start!(user_agent: "Safari", ip_address: "1.2.3.4")
+    ReadingMark.remember leaves(:welcome_page), user: @kevin
+
+    @kevin.destroy!
+
+    assert_not User.exists?(@kevin.id)
+    assert_empty Session.where(user_id: @kevin.id)
+    assert_empty Access.where(user_id: @kevin.id)
+    assert_empty ReadingMark.where(user_id: @kevin.id)
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "other people's sign-in events are kept" do
+    users(:jz).sessions.start!(user_agent: "Safari", ip_address: "1.2.3.4")
+
+    assert_no_difference -> { SignInEvent.for_address("jz@example.com").count } do
+      @kevin.destroy!
+    end
+  end
+
+  test "books they created that are shared with everyone are kept, bylined as a deleted author" do
+    books(:handbook).update!(creator: @kevin, author: "Kevin")
+
+    @kevin.destroy!
+
+    books(:handbook).reload.tap do |book|
+      assert_nil book.creator
+      assert_equal "Deleted author", book.author
+      assert book.accessable?(user: users(:jz))
+      assert_equal 4, book.leaves.count
+    end
+  end
+
+  test "other books they created are destroyed, with everything in them" do
+    book, page, blob = books(:handbook), pages(:welcome), active_storage_blobs(:handbook_reading_image_blob)
+    book.update!(creator: @kevin, everyone_access: false)
+    Leaf.reindex_all
+    leaves(:welcome_page).edit leafable_params: { body: "A revised handbook" }
+
+    @kevin.destroy!
+
+    assert_not Book.exists?(book.id)
+    assert_empty Leaf.where(book_id: book.id)
+    assert_not Page.exists?(page.id)
+    assert_empty ActionText::Markdown.where("content LIKE ?", "%handbook%")
+    assert_empty Leaf.search("handbook")
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+  end
+
+  test "books created by other people are left alone" do
+    books(:handbook).update!(creator: users(:jason), author: "Jason", everyone_access: false)
+
+    @kevin.destroy!
+
+    assert_equal users(:jason), books(:handbook).reload.creator
+    assert_equal "Jason", books(:handbook).author
+  end
+
+  test "a deactivated user's sign-in events are erased from the address they signed in with" do
+    @kevin.sessions.start!(user_agent: "Safari", ip_address: "1.2.3.4")
+    @kevin.deactivate
+
+    @kevin.destroy!
+
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "someone who took a deactivated user's address keeps their own sign-in events" do
+    @kevin.sessions.start!(user_agent: "Safari", ip_address: "1.2.3.4")
+    @kevin.deactivate
+
+    travel 1.day
+    new_kevin = User.create!(name: "New Kevin", email_address: "kevin@example.com", password: "secret123456")
+    new_kevin.sessions.start!(user_agent: "Firefox", ip_address: "5.6.7.8")
+
+    @kevin.destroy!
+
+    assert_equal [ "Firefox" ], SignInEvent.for_address("kevin@example.com").pluck(:user_agent)
+  end
+
+  test "a deactivated user keeps their sign-in events when someone who later took their address is erased" do
+    @kevin.sessions.start!(user_agent: "Safari", ip_address: "1.2.3.4")
+    @kevin.deactivate
+
+    travel 1.day
+    new_kevin = User.create!(name: "New Kevin", email_address: "kevin@example.com", password: "secret123456")
+    new_kevin.sessions.start!(user_agent: "Firefox", ip_address: "5.6.7.8")
+
+    new_kevin.destroy!
+
+    assert_equal [ "Safari" ], SignInEvent.for_address("kevin@example.com").pluck(:user_agent)
+  end
+
+  test "original email address undoes deactivation" do
+    assert_equal "kevin@example.com", @kevin.original_email_address
+
+    @kevin.deactivate
+    assert_equal "kevin@example.com", @kevin.original_email_address
+
+    @kevin.deactivate
+    assert_equal "kevin@example.com", @kevin.original_email_address
+  end
+
+  test "known by email address includes people deactivated from that address" do
+    @kevin.deactivate
+    new_kevin = User.create!(name: "New Kevin", email_address: "kevin@example.com", password: "secret123456")
+    User.create!(name: "Kevin Bacon", email_address: "kevin-deactivated-bacon@example.com", password: "secret123456")
+
+    assert_equal [ @kevin, new_kevin ].sort_by(&:id), User.known_by_email_address("kevin@example.com").sort_by(&:id)
+    assert_equal [ @kevin ], User.known_by_email_address(@kevin.email_address)
+    assert_empty User.known_by_email_address("k_vin@example.com")
+  end
+end
