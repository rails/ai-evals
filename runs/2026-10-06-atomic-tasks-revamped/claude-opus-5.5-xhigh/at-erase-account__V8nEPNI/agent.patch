new file mode 100644
index 0000000..b25f28f
--- /dev/null
+++ b/app/models/book/files.rb
@@ -0,0 +1,27 @@
+module Book::Files
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :remember_files, prepend: true
+    after_destroy_commit :purge_remembered_files
+  end
+
+  private
+    # The cover, plus every picture and upload in the book's leaves (including
+    # their previous versions), and any variants generated from them.
+    def remember_files
+      leafables = [ leaves, Edit.where(leaf: leaves) ].flat_map { it.includes(:leafable).map(&:leafable) }.compact.uniq
+      attachments = ActiveStorage::Attachment.where(record: [ self, *leafables, *ActionText::Markdown.where(record: leafables) ])
+      variants = ActiveStorage::Attachment.where(record: ActiveStorage::VariantRecord.where(blob_id: attachments.select(:blob_id)))
+
+      @remembered_blob_ids = [ attachments.pluck(:blob_id), variants.pluck(:blob_id) ]
+    end
+
+    # Originals go first, since purging them is what releases their variants.
+    # Anything still attached elsewhere is left alone.
+    def purge_remembered_files
+      @remembered_blob_ids.each do |blob_ids|
+        ActiveStorage::Blob.where(id: blob_ids).unattached.find_each(&:purge)
+      end
+    end
+end
