diff --git a/script/admin/erase-user b/script/admin/erase-user
new file mode 100755
index 0000000..0311881
--- /dev/null
+++ b/script/admin/erase-user
@@ -0,0 +1,17 @@
+#!/usr/bin/env ruby
+require File.expand_path("../../config/environment", File.dirname(__FILE__))
+
+abort "Usage: #{$0} <email-address>" unless ARGV.length == 1
+
+email_address = ARGV.first
+users = User.known_by_email_address(email_address)
+
+if users.any?
+  users.each do |user|
+    user.destroy!
+    puts "Erased user #{user.id} (#{user.active? ? "active" : "deactivated"})"
+  end
+else
+  puts "User not found"
+  exit -1
+end
