diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..d4c800e
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,60 @@
+# Destroying a user erases them: nothing of theirs is left behind.
+#
+# The one exception is books they created that are shared with everyone, since
+# other people are reading them. Those stay, but no longer point back at them
+# and are bylined "Deleted author". Their other books are destroyed outright.
+#
+# People removed before this existed were only deactivated, and had their
+# address rewritten from alice@example.com to alice-deactivated-<uuid>@example.com.
+# Their sign-in history is still filed under the address they actually signed
+# in with, so that's where it's erased from.
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  DEACTIVATION_TAG = /(?:-deactivated-\h{8}-\h{4}-\h{4}-\h{4}-\h{12})+(?=@)/
+
+  included do
+    before_destroy :erase_created_books
+    after_destroy  :erase_sign_in_events
+  end
+
+  class_methods do
+    # Everyone who has this address, or had it before being deactivated.
+    def known_by_email_address(email_address)
+      local_part = email_address.to_s.split("@").first.to_s
+
+      where(email_address: email_address)
+        .or(where("email_address LIKE ? ESCAPE '\\'", "#{sanitize_sql_like(local_part)}-deactivated-%"))
+        .select { |user| email_address.in?([ user.email_address, user.original_email_address ]) }
+    end
+  end
+
+  def original_email_address
+    email_address.gsub(DEACTIVATION_TAG, "")
+  end
+
+  # Sign-in events are filed by address, not by user. If a deactivated user's
+  # address was later taken by someone else, each of them owns the events from
+  # when they held it.
+  def sign_in_events
+    holders = (self.class.known_by_email_address(original_email_address) | [ self ]).sort_by { [ it.created_at, it.id ] }
+    position = holders.index(self)
+    next_holder = holders[position + 1]
+
+    events = SignInEvent.for_address(original_email_address)
+    events = events.where(created_at: created_at..) if position > 0
+    events = events.where(created_at: ...next_holder.created_at) if next_holder
+    email_address == original_email_address ? events : events.or(SignInEvent.for_address(email_address))
+  end
+
+  private
+    def erase_created_books
+      created_books.find_each do |book|
+        book.everyone_access? ? book.credit_deleted_author : book.destroy!
+      end
+    end
+
+    def erase_sign_in_events
+      sign_in_events.delete_all
+    end
+end
