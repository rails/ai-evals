diff --git a/app/models/book/access_import.rb b/app/models/book/access_import.rb
index 4d920cf..d9017e3 100644
--- a/app/models/book/access_import.rb
+++ b/app/models/book/access_import.rb
@@ -6,20 +6,78 @@ class Book::AccessImport
   end
 
   def import
-    accesses = []
-    duplicate_index = nil
+    accesses, rejected_index = [], nil
 
     Access.transaction do
+      drafts, rejected_index = draft_accesses
+      accesses = insert(drafts) unless rejected_index
+    end
+
+    if rejected_index
+      Result.new([], rejected_index)
+    else
+      notify accesses
+      Result.new(accesses, nil)
+    end
+  end
+
+  private
+    # Builds an unsaved access for each row, in order, stopping at the first row that turns the
+    # roster down: one naming a level we don't know, or one giving access to someone who already
+    # has it (from before the import, or from an earlier row). Rows failing the access validations
+    # raise, as they always have. Users and existing accesses are loaded once up front, so checking
+    # a long sheet costs the same handful of queries as a short one.
+    def draft_accesses
+      granted_user_ids = @book.accesses.where(user_id: user_ids).pluck(:user_id).to_set
+      drafts = []
+
       @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
+        return [ [], index ] unless known_level?(grant[:level])
+
+        access = draft_access_for(grant)
+        access.validate!
+        return [ [], index ] unless granted_user_ids.add?(access.user_id)
+
+        drafts << access
       end
+
+      [ drafts, nil ]
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
-  end
+    def known_level?(level)
+      Access.levels.key?(level) || Access.levels.value?(level)
+    end
+
+    def draft_access_for(grant)
+      Access.new(book: @book, user_id: grant[:user_id], level: grant[:level]).tap do |access|
+        access.user = users_by_id[access.user_id] if users_by_id.key?(access.user_id)
+      end
+    end
+
+    def users_by_id
+      @users_by_id ||= User.where(id: user_ids).index_by(&:id)
+    end
+
+    def user_ids
+      @user_ids ||= @grants.map { |grant| grant[:user_id] }
+    end
+
+    # One INSERT for the whole roster, handing the accesses back in the order they were granted.
+    def insert(drafts)
+      return [] if drafts.empty?
+
+      rows = drafts.map { |access| access.attributes.slice("user_id", "level") }
+      inserted = @book.accesses.insert_all!(rows, returning: Access.column_names)
+        .map { |row| Access.instantiate(row).tap { |access| access.book = @book } }
+        .index_by(&:user_id)
+
+      inserted.values_at(*drafts.map(&:user_id))
+    end
+
+    # Only once the accesses are committed, so nobody hears about access that was rolled back.
+    def notify(accesses)
+      ActiveRecord.after_all_transactions_commit do
+        accesses.each { |access| Book::AccessNotificationJob.perform_later(access) }
+      end
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..37fc759
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,164 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+    @book.update!(everyone_access: false)
+  end
+
+  test "grants every row and notifies each person" do
+    grants = [ { user_id: users(:kevin).id, level: :editor } ]
+
+    result = nil
+    assert_difference -> { @book.accesses.count }, +1 do
+      assert_enqueued_jobs 1, only: Book::AccessNotificationJob do
+        result = Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal 1, result.accesses.size
+
+    access = result.accesses.first
+    assert access.persisted?
+    assert_equal access, @book.access_for(user: users(:kevin))
+    assert access.editor?
+    assert_enqueued_with job: Book::AccessNotificationJob, args: [ access ]
+  end
+
+  test "hands accesses back in roster order" do
+    users = create_users(5)
+    grants = users.reverse.each_with_index.map { |user, i| { user_id: user.id, level: i.even? ? "reader" : :editor } }
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal grants.pluck(:user_id), result.accesses.map(&:user_id)
+    assert_equal grants.map { it[:level].to_s }, result.accesses.map(&:level)
+    assert_equal @book.accesses.where(user: users).order(:id).to_a.sort_by(&:id), result.accesses.sort_by(&:id)
+    assert result.accesses.none?(&:changed?)
+  end
+
+  test "turns down a roster naming someone who already has access" do
+    grants = [ { user_id: users(:kevin).id, level: :reader }, { user_id: users(:jz).id, level: :editor } ]
+
+    assert_rejected grants, at: 1
+    assert @book.access_for(user: users(:jz)).reader?
+  end
+
+  test "turns down a roster naming someone twice" do
+    grants = [ { user_id: users(:kevin).id, level: :reader }, { user_id: users(:kevin).id, level: :editor } ]
+
+    assert_rejected grants, at: 1
+  end
+
+  test "turns down a roster naming an unknown level" do
+    users = create_users(3)
+    grants = users.map { { user_id: it.id, level: :reader } }
+    grants[1][:level] = "owner"
+
+    assert_rejected grants, at: 1
+  end
+
+  test "turns down a roster with a missing level" do
+    assert_rejected [ { user_id: users(:kevin).id, level: nil } ], at: 0
+    assert_rejected [ { user_id: users(:kevin).id, level: "" } ], at: 0
+  end
+
+  test "the first bad row is the one reported" do
+    kevin, jz = users(:kevin).id, users(:jz).id
+
+    assert_rejected [ { user_id: kevin, level: :reader }, { user_id: kevin, level: :admin }, { user_id: jz, level: :reader } ], at: 1
+    assert_rejected [ { user_id: kevin, level: :reader }, { user_id: jz, level: :reader }, { user_id: kevin, level: :admin } ], at: 1
+  end
+
+  test "rows that fail validation still raise without granting or notifying anything" do
+    grants = [ { user_id: users(:kevin).id, level: :reader }, { user_id: User.maximum(:id) + 1, level: :reader } ]
+
+    assert_no_difference -> { Access.count } do
+      assert_no_enqueued_jobs do
+        error = assert_raises(ActiveRecord::RecordInvalid) { Book::AccessImport.new(@book, grants).import }
+        assert_match "User must exist", error.message
+      end
+    end
+  end
+
+  test "notifications wait for the surrounding transaction to commit" do
+    grants = [ { user_id: users(:kevin).id, level: :reader } ]
+
+    assert_no_enqueued_jobs do
+      Access.transaction do
+        Book::AccessImport.new(@book, grants).import
+        raise ActiveRecord::Rollback
+      end
+    end
+    assert_nil @book.access_for(user: users(:kevin))
+
+    assert_enqueued_jobs 1, only: Book::AccessNotificationJob do
+      Access.transaction { Book::AccessImport.new(@book, grants).import }
+    end
+  end
+
+  test "an empty roster grants nothing" do
+    result = Book::AccessImport.new(@book, []).import
+
+    assert_equal [], result.accesses
+    assert_nil result.duplicate_index
+  end
+
+  test "a long roster writes no more than a short one when it is taken" do
+    short, long = create_users(4), create_users(16)
+
+    assert_equal \
+      writes_for(short.map { { user_id: it.id, level: :reader } }),
+      writes_for(long.map { { user_id: it.id, level: :reader } })
+  end
+
+  test "a long roster writes no more than a short one when it is turned down" do
+    short, long = create_users(4), create_users(16)
+    duplicate = { user_id: users(:jz).id, level: :reader }
+
+    assert_equal \
+      writes_for(short.map { { user_id: it.id, level: :reader } } + [ duplicate ]),
+      writes_for(long.map { { user_id: it.id, level: :reader } } + [ duplicate ])
+
+    assert_equal \
+      writes_for(short.map { { user_id: it.id, level: :reader } } + [ duplicate.merge(user_id: users(:kevin).id, level: :owner) ]),
+      writes_for(long.map { { user_id: it.id, level: :reader } } + [ duplicate.merge(user_id: users(:kevin).id, level: :owner) ])
+  end
+
+  private
+    def create_users(count)
+      count.times.map do |i|
+        User.create!(name: "Reader #{i} #{SecureRandom.hex(4)}", email_address: "reader-#{SecureRandom.hex(4)}@example.com", password: "secret123456")
+      end
+    end
+
+    def assert_rejected(grants, at:)
+      result = nil
+
+      assert_no_difference -> { Access.count } do
+        assert_no_enqueued_jobs do
+          result = Book::AccessImport.new(@book, grants).import
+        end
+      end
+
+      assert_equal [], result.accesses
+      assert_equal at, result.duplicate_index
+    end
+
+    def writes_for(grants)
+      writes = []
+      counter = ->(*, payload) { writes << payload[:sql] unless payload[:name] == "SCHEMA" || payload[:sql].match?(/\A\s*SELECT/i) }
+
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record") do
+        Access.transaction(requires_new: true) do
+          Book::AccessImport.new(@book, grants).import
+          raise ActiveRecord::Rollback
+        end
+      end
+
+      writes.size
+    end
+end
