diff --git a/app/models/user/sign_in_history.rb b/app/models/user/sign_in_history.rb
new file mode 100644
index 0000000..9fe59a8
--- /dev/null
+++ b/app/models/user/sign_in_history.rb
@@ -0,0 +1,50 @@
+module User::SignInHistory
+  extend ActiveSupport::Concern
+
+  # Back when Remove only deactivated people, it rewrote alice@example.com to
+  # alice-deactivated-<uuid>@example.com (see User#deactivate). Their sign-in events are
+  # still recorded under the address they actually signed in with.
+  DEACTIVATION_TAG = /(?:-deactivated-\h{8}-\h{4}-\h{4}-\h{4}-\h{12})+(?=@)/
+
+  included do
+    after_destroy :erase_sign_in_events
+  end
+
+  class_methods do
+    # Every account that signs in, or signed in until it was deactivated, as +email_address+.
+    def signing_in_as(email_address)
+      local_part, domain = email_address.to_s.split("@", 2)
+      deactivated = "#{sanitize_sql_like(local_part.to_s)}-deactivated-%@#{sanitize_sql_like(domain.to_s)}"
+
+      where(email_address: email_address).or(where("email_address LIKE ? ESCAPE '\\'", deactivated))
+        .select { |user| user.sign_in_email_address == email_address }
+    end
+  end
+
+  def sign_in_email_address
+    email_address.to_s.gsub(DEACTIVATION_TAG, "")
+  end
+
+  # From creation until deactivation, which is the last change made to a deactivated account.
+  def sign_in_period
+    created_at..(updated_at unless active?)
+  end
+
+  def sign_in_events
+    events = SignInEvent.for_address([ email_address, sign_in_email_address ].uniq)
+
+    # Deactivating freed the address up, so someone else may have signed in with it since, or before.
+    other_accounts_signing_in_as_same_address.inject(events) do |theirs, other|
+      theirs.where.not(email_address: sign_in_email_address, created_at: other.sign_in_period)
+    end
+  end
+
+  private
+    def other_accounts_signing_in_as_same_address
+      self.class.signing_in_as(sign_in_email_address).excluding(self)
+    end
+
+    def erase_sign_in_events
+      sign_in_events.delete_all
+    end
+end
