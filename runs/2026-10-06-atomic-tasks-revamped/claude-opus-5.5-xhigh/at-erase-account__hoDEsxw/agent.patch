diff --git a/lib/tasks/users.rake b/lib/tasks/users.rake
new file mode 100644
index 0000000..e1722b4
--- /dev/null
+++ b/lib/tasks/users.rake
@@ -0,0 +1,14 @@
+namespace :users do
+  desc "Erase the person signing in as EMAIL_ADDRESS, including accounts deactivated back when Remove only did that"
+  task :erase, [ :email_address ] => :environment do |task, args|
+    email_address = args[:email_address].presence || abort("Usage: bin/rails \"#{task.name}[alice@example.com]\"")
+    users = User.signing_in_as(email_address)
+
+    abort "No account signs in as #{email_address}" if users.none?
+
+    users.each do |user|
+      user.destroy!
+      puts "Erased #{user.name} (#{user.active? ? "active" : "deactivated"} account ##{user.id})"
+    end
+  end
+end
