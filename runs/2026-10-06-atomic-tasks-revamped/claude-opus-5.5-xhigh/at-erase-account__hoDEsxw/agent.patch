diff --git a/test/models/user/sign_in_history_test.rb b/test/models/user/sign_in_history_test.rb
new file mode 100644
index 0000000..c098501
--- /dev/null
+++ b/test/models/user/sign_in_history_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class User::SignInHistoryTest < ActiveSupport::TestCase
+  test "destroying a user erases their sign-in events, and only theirs" do
+    sign_in_and_out users(:kevin)
+    sign_in_and_out users(:jz)
+
+    assert_no_difference -> { SignInEvent.for_address("jz@example.com").count } do
+      users(:kevin).destroy!
+    end
+
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "destroying a user deactivated the old way erases events under the address they signed in with" do
+    sign_in_and_out users(:kevin)
+    travel 1.minute
+    users(:kevin).deactivate
+    assert_match(/\Akevin-deactivated-\h{8}-(\h{4}-){3}\h{12}@example\.com\z/, users(:kevin).email_address)
+
+    users(:kevin).destroy!
+
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "sign-in events of someone else who signed up with a deactivated address are kept" do
+    sign_in_and_out users(:kevin)
+    travel 1.minute
+    users(:kevin).deactivate
+    travel 1.minute
+    new_kevin = User.create!(name: "New Kevin", email_address: "kevin@example.com", password: "secret123456")
+    new_kevin.sessions.start! user_agent: "Firefox", ip_address: "5.6.7.8"
+
+    users(:kevin).destroy!
+    assert_equal [ "Firefox" ], SignInEvent.for_address("kevin@example.com").pluck(:user_agent)
+
+    new_kevin.destroy!
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "sign-in events of a deactivated account are kept when someone else with its old address is erased" do
+    sign_in_and_out users(:kevin)
+    travel 1.minute
+    users(:kevin).deactivate
+    travel 1.minute
+    new_kevin = User.create!(name: "New Kevin", email_address: "kevin@example.com", password: "secret123456")
+    new_kevin.sessions.start! user_agent: "Firefox", ip_address: "5.6.7.8"
+
+    new_kevin.destroy!
+
+    assert_equal [ "Safari" ] * 2, SignInEvent.for_address("kevin@example.com").pluck(:user_agent)
+  end
+
+  test "sign-in email address undoes deactivation" do
+    assert_equal "kevin@example.com", users(:kevin).sign_in_email_address
+
+    users(:kevin).deactivate
+    assert_equal "kevin@example.com", users(:kevin).sign_in_email_address
+
+    users(:kevin).update_column :email_address, "kevin-deactivated-#{SecureRandom.uuid}-deactivated-#{SecureRandom.uuid}@example.com"
+    assert_equal "kevin@example.com", users(:kevin).sign_in_email_address
+  end
+
+  test "signing in as finds deactivated accounts, but not lookalikes" do
+    users(:kevin).deactivate
+    lookalike = User.create!(name: "Kevin K", email_address: "kevin_k@example.com", password: "secret123456")
+    lookalike.deactivate
+
+    assert_equal [ users(:kevin) ], User.signing_in_as("kevin@example.com")
+    assert_equal [ lookalike ], User.signing_in_as("kevin_k@example.com")
+    assert_equal [ users(:jz) ], User.signing_in_as("jz@example.com")
+    assert_empty User.signing_in_as("KEVIN@example.com")
+    assert_empty User.signing_in_as("nobody@example.com")
+  end
+
+  private
+    def sign_in_and_out(user)
+      user.sessions.start!(user_agent: "Safari", ip_address: "1.2.3.4").destroy!
+    end
+end
