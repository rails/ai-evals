--- /dev/null
+++ b/test/lib/tasks/users_rake_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+require "rake"
+
+class UsersRakeTest < ActiveSupport::TestCase
+  setup do
+    Rails.application.load_tasks unless Rake::Task.task_defined?("users:erase")
+    Rake::Task["users:erase"].reenable
+  end
+
+  test "erase finds accounts deactivated the old way by the address they signed in with" do
+    users(:kevin).deactivate
+
+    assert_output(/Erased Kevin \(deactivated account/) { erase "kevin@example.com" }
+    assert_not User.exists?(users(:kevin).id)
+  end
+
+  test "erase stops when nobody signs in with the address" do
+    assert_no_difference -> { User.count } do
+      assert_raises(SystemExit) { capture_io { erase "nobody@example.com" } }
+    end
+  end
+
+  private
+    def erase(email_address)
+      Rake::Task["users:erase"].invoke(email_address)
+    end
+end
