+
+    picture = book.press Picture.new(image: file_fixture("reading.webp"), caption: "Me"), title: "Selfie"
+    picture.edit leafable_params: { caption: "Me again" }
+    picture.trashed!
+
+    ReadingMark.remember page, user: users(:jz)
+    assert_not_equal before, leftovers.call
+
+    perform_enqueued_jobs only: ActiveStorage::PurgeJob do
+      users(:kevin).destroy!
+    end
