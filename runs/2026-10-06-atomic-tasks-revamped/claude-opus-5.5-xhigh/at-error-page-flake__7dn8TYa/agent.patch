diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..e558601 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,25 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Inside the block, controller errors reach the test as raised exceptions
+    # instead of being rendered as error pages.
+    #
+    # Requests don't read config.action_dispatch.show_exceptions directly: Rails
+    # copies it into Rails.application.env_config, memoized on first use, and
+    # merges that into every request env. Toggling the config is therefore either
+    # a no-op (snapshot already taken) or leaks into every later test in the
+    # process (snapshot taken inside the block), so override the per-request value
+    # itself. The hash is per-process and tests within a worker run one at a time.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
-      yield
-    ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config = Rails.application.env_config
+      previous = env_config["action_dispatch.show_exceptions"]
+      env_config["action_dispatch.show_exceptions"] = :none
+
+      begin
+        yield
+      ensure
+        env_config["action_dispatch.show_exceptions"] = previous
+      end
     end
   end
 end
