diff --git a/app/models/book.rb b/app/models/book.rb
index 64a02da..dba6d6f 100644
--- a/app/models/book.rb
+++ b/app/models/book.rb
@@ -4,7 +4,11 @@ class Book < ApplicationRecord
   has_many :leaves, dependent: :destroy
   has_one_attached :cover, dependent: :purge_later
 
-  before_destroy :archive_access_list
+  # The access list must be captured before `has_many :accesses, dependent: :destroy`
+  # (declared in Accessable) removes the grants, hence prepend. It's only written to
+  # the archive once the book itself has been deleted, within the same transaction.
+  before_destroy :remember_access_list, prepend: true
+  after_destroy :archive_access_list
 
   scope :ordered, -> { order(:title) }
   scope :published, -> { where(published: true) }
@@ -20,15 +24,19 @@ class Book < ApplicationRecord
   end
 
   private
-    def archive_access_list
-      accesses.each do |access|
-        AccessArchive.create!(
-          book_id: id,
-          book_title: title,
-          user_id: access.user_id,
-          user_name: access.user.name,
-          level: access.level
-        )
+    def remember_access_list
+      # Read the grants as they stand in the database rather than from a possibly stale,
+      # previously loaded association, and make the dependent destroy do the same.
+      accesses.reset
+
+      @access_list = accesses.includes(:user).collect do |access|
+        { book_id: id, book_title: title_in_database, user_id: access.user_id, user_name: access.user.name, level: access.level }
       end
     end
+
+    def archive_access_list
+      AccessArchive.insert_all!(@access_list) if @access_list.present?
+    ensure
+      @access_list = nil
+    end
 end
diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..7cdd9f7 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,28 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy removes the book and archives who had access to it" do
+    book = books(:handbook)
+
+    assert_difference -> { AccessArchive.count }, +4 do
+      delete book_path(book)
+    end
+
+    assert_redirected_to root_path
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+    assert_equal [ [ users(:david).id, "editor" ], [ users(:jason).id, "editor" ], [ users(:jz).id, "reader" ], [ users(:kevin).id, "editor" ] ].sort,
+      AccessArchive.where(book_id: book.id).pluck(:user_id, :level).sort
+  end
+
+  test "destroy is forbidden to readers and archives nothing" do
+    sign_in :jz
+
+    assert_no_difference [ -> { AccessArchive.count }, -> { Book.count } ] do
+      delete book_path(books(:handbook))
+    end
+
+    assert_response :forbidden
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..01f43db 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,66 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives everyone who had access to it" do
+    book = books(:handbook)
+
+    assert_difference -> { AccessArchive.count }, +4 do
+      book.destroy
+    end
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal [ [ users(:david).id, "David", "editor" ], [ users(:jason).id, "Jason", "editor" ], [ users(:jz).id, "JZ", "reader" ], [ users(:kevin).id, "Kevin", "editor" ] ].sort,
+      archives.pluck(:user_id, :user_name, :level).sort
+    assert_equal [ "Handbook" ], archives.distinct.pluck(:book_title)
+    assert archives.all?(&:created_at)
+
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+  end
+
+  test "destroying a book archives accesses as they stand, not as previously loaded" do
+    book = books(:handbook)
+    book.accesses.load
+
+    accesses(:jason_handbook).destroy
+    accesses(:david_handbook).reader!
+
+    book.destroy
+
+    assert_equal [ [ users(:david).id, "reader" ], [ users(:jz).id, "reader" ], [ users(:kevin).id, "editor" ] ].sort,
+      AccessArchive.where(book_id: book.id).pluck(:user_id, :level).sort
+    assert_empty Access.where(book_id: book.id)
+  end
+
+  test "destroying a book nobody has access to archives nothing" do
+    book = books(:manual)
+    book.accesses.delete_all
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+
+    assert_not Book.exists?(book.id)
+  end
+
+  test "access is archived only once the book has been deleted" do
+    statements = []
+    track = ->(*, payload) { statements << $1 if payload[:sql] =~ /\A\s*(INSERT INTO "access_archives"|DELETE FROM "books")/ }
+
+    ActiveSupport::Notifications.subscribed(track, "sql.active_record") do
+      books(:handbook).destroy
+    end
+
+    assert_equal [ %(DELETE FROM "books"), %(INSERT INTO "access_archives") ], statements
+  end
+
+  test "nothing is archived when the deletion does not go through" do
+    assert_no_difference [ -> { AccessArchive.count }, -> { Access.count }, -> { Book.count } ] do
+      Book.transaction do
+        books(:handbook).destroy
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
 end
