diff --git a/app/models/book.rb b/app/models/book.rb
index 64a02da..48bfa19 100644
--- a/app/models/book.rb
+++ b/app/models/book.rb
@@ -4,7 +4,10 @@ class Book < ApplicationRecord
   has_many :leaves, dependent: :destroy
   has_one_attached :cover, dependent: :purge_later
 
-  before_destroy :archive_access_list
+  # The access list has to be captured before `has_many :accesses, dependent: :destroy`
+  # removes the grants, but the archive is only written once the book itself is deleted.
+  before_destroy :capture_access_list, prepend: true
+  after_destroy :archive_access_list
 
   scope :ordered, -> { order(:title) }
   scope :published, -> { where(published: true) }
@@ -20,15 +23,17 @@ class Book < ApplicationRecord
   end
 
   private
-    def archive_access_list
-      accesses.each do |access|
-        AccessArchive.create!(
-          book_id: id,
-          book_title: title,
-          user_id: access.user_id,
-          user_name: access.user.name,
-          level: access.level
-        )
+    # Read straight from the database rather than the `accesses` association,
+    # which may hold a stale copy of the grants.
+    def capture_access_list
+      @access_list = accesses.includes(:user).map do |access|
+        { book_id: id, book_title: title, user_id: access.user_id, user_name: access.user.name, level: access.level }
       end
     end
+
+    def archive_access_list
+      AccessArchive.create!(@access_list) if @access_list.present?
+    ensure
+      @access_list = nil
+    end
 end
