diff --git a/app/models/job_checkpoint.rb b/app/models/job_checkpoint.rb
new file mode 100644
index 0000000..8908675
--- /dev/null
+++ b/app/models/job_checkpoint.rb
@@ -0,0 +1,20 @@
+# Durably tracks how far a long-running job has worked through a table, in id order,
+# so an interrupted run can be resumed where it left off rather than started over.
+#
+# The range of ids is fixed by the first run: records from +cursor+ through +finish+.
+# Records created later are left alone, and once the cursor passes +finish+ there's
+# nothing left to do, so a finished job can be run again harmlessly.
+class JobCheckpoint < ApplicationRecord
+  def self.for(name, finish:)
+    create_or_find_by!(name: name) { it.finish = finish }
+  end
+
+  # Moves the cursor past +id+ and returns true, unless the cursor is already past
+  # it (e.g. a duplicate run of the job claimed it first), in which case it's false.
+  #
+  # Claim inside the same transaction as the work on the record, so a run that dies
+  # partway through a record rolls back both and the next run redoes that record.
+  def claim(id)
+    self.class.where(id: self.id, cursor: ..id).update_all(cursor: id.succ, updated_at: Time.current) == 1
+  end
+end
