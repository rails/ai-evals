diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..bebf3c3
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  # Stands in for the worker being killed by a deploy.
+  Killed = Class.new(Exception)
+
+  setup do
+    @leaves = Leaf.order(:id).to_a
+
+    # Titles that legitimately open with a quoted phrase are mangled if they're cleaned twice
+    @intended_titles = @leaves.to_h { |leaf| [ leaf.id, %("#{leaf.title}," she said) ] }
+    wrap_titles_like_the_legacy_exporter
+  end
+
+  test "strips the quotes wrapped around every title" do
+    TitleCleanupJob.perform_now
+
+    assert_equal @intended_titles, titles
+  end
+
+  test "resumes where it left off, redoing only the leaf it was killed on" do
+    killed_on = @leaves.third
+
+    assert_raises(Killed) do
+      killing_when_updating(killed_on) { TitleCleanupJob.perform_now }
+    end
+
+    assert_equal @intended_titles.values_at(*@leaves.first(2).map(&:id)), @leaves.first(2).map { it.reload.title }
+    assert_equal %("#{@intended_titles[killed_on.id]}"), killed_on.reload.title, "rolled back, still as exported"
+
+    TitleCleanupJob.perform_now
+
+    assert_equal @intended_titles, titles
+  end
+
+  test "every title is cleaned exactly once wherever the job is killed" do
+    kills = 0
+
+    while performed_but_killed_after_statement?(kills + 1)
+      kills += 1
+
+      TitleCleanupJob.perform_now
+      assert_equal @intended_titles, titles, "Killed after statement #{kills}"
+
+      wrap_titles_like_the_legacy_exporter
+    end
+
+    assert_operator kills, :>, @leaves.count
+  end
+
+  test "running again after it has finished changes nothing" do
+    TitleCleanupJob.perform_now
+    created_since = books(:handbook).press Section.new, title: %("Quoted" in the title)
+
+    TitleCleanupJob.perform_now
+
+    assert_equal @intended_titles.merge(created_since.id => %("Quoted" in the title)), titles
+  end
+
+  private
+    def wrap_titles_like_the_legacy_exporter
+      JobCheckpoint.delete_all
+      @leaves.each { |leaf| leaf.update_columns(title: %("#{@intended_titles[leaf.id]}")) }
+    end
+
+    def titles
+      Leaf.order(:id).pluck(:id, :title).to_h
+    end
+
+    # Kills the job right after the leaf's UPDATE has run, before it can commit
+    def killing_when_updating(leaf, &block)
+      killer = ->(event) do
+        sql, binds = event.payload.values_at(:sql, :binds)
+        raise Killed if sql.start_with?(%(UPDATE "leaves")) && binds.any? { it.value == leaf.id }
+      end
+
+      ActiveSupport::Notifications.subscribed(killer, "sql.active_record", &block)
+    end
+
+    # Kills the job right after its nth statement, ignoring transaction and schema
+    # statements since being killed after one of those is the same as being killed
+    # before the next statement. Returns whether the job was killed.
+    def performed_but_killed_after_statement?(n)
+      statements = 0
+      killer = ->(event) do
+        unless event.payload[:cached] || event.payload[:name].in?(%w[ TRANSACTION SCHEMA ])
+          raise Killed if (statements += 1) == n
+        end
+      end
+
+      ActiveSupport::Notifications.subscribed(killer, "sql.active_record") { TitleCleanupJob.perform_now }
+      false
+    rescue Killed
+      true
+    end
+end
diff --git a/test/models/job_checkpoint_test.rb b/test/models/job_checkpoint_test.rb
new file mode 100644
index 0000000..a3f37af
--- /dev/null
+++ b/test/models/job_checkpoint_test.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+
+class JobCheckpointTest < ActiveSupport::TestCase
+  test "the range is fixed by the first run" do
+    checkpoint = JobCheckpoint.for("SomeJob", finish: 10)
+
+    assert_equal checkpoint, JobCheckpoint.for("SomeJob", finish: 20)
+    assert_equal [ 0, 10 ], [ checkpoint.reload.cursor, checkpoint.finish ]
+  end
+
+  test "claiming moves the cursor past an id only once" do
+    checkpoint = JobCheckpoint.for("SomeJob", finish: 10)
+
+    assert checkpoint.claim(3)
+    assert_not checkpoint.claim(3), "already claimed"
+    assert_not checkpoint.claim(2), "cursor has already passed it"
+    assert checkpoint.claim(7)
+    assert_equal 8, checkpoint.reload.cursor
+  end
+end
