diff --git a/test/test_helpers/caching_test_helper.rb b/test/test_helpers/caching_test_helper.rb
new file mode 100644
index 0000000..6e4bf97
--- /dev/null
+++ b/test/test_helpers/caching_test_helper.rb
@@ -0,0 +1,15 @@
+module CachingTestHelper
+  # Caching is off in the test environment. Turn on fragment and collection
+  # caching for the duration of the block, backed by a fresh in-memory store.
+  def with_caching(store: ActiveSupport::Cache::MemoryStore.new)
+    previous = [ ActionController::Base.perform_caching, ActionController::Base.cache_store, ActionView::PartialRenderer.collection_cache ]
+
+    ActionController::Base.perform_caching = true
+    ActionController::Base.cache_store = store
+    ActionView::PartialRenderer.collection_cache = store
+
+    yield store
+  ensure
+    ActionController::Base.perform_caching, ActionController::Base.cache_store, ActionView::PartialRenderer.collection_cache = previous
+  end
+end
