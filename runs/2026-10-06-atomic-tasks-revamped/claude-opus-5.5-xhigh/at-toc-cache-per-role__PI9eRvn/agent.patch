diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..cb3f815 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class BooksControllerTest < ActionDispatch::IntegrationTest
+  include CachingTestHelper
+
   setup do
     sign_in :kevin
   end
@@ -114,4 +116,113 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "show never gives a reader editor controls, even when an editor opened the book first" do
+    with_caching do
+      get book_slug_path(books(:handbook))
+      assert_editor_table_of_contents
+
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_reader_table_of_contents
+    end
+  end
+
+  test "show always gives an editor editor controls, even when a reader opened the book first" do
+    with_caching do
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_reader_table_of_contents
+
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_editor_table_of_contents
+    end
+  end
+
+  test "show never gives an anonymous visitor editor controls, even when an editor opened the book first" do
+    books(:handbook).update!(published: true)
+
+    with_caching do
+      get book_slug_path(books(:handbook))
+      assert_editor_table_of_contents
+
+      sign_out
+      get book_slug_path(books(:handbook))
+      assert_reader_table_of_contents
+    end
+  end
+
+  test "show gives the next visitor a renamed entry with its new title" do
+    with_caching do
+      get book_slug_path(books(:handbook))
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+
+      leaves(:summary_page).update!(title: "Renamed summary")
+
+      get book_slug_path(books(:handbook))
+      assert_reader_table_of_contents
+      assert_select "#leaves .toc__title", text: "Renamed summary"
+      assert_select "#leaves .toc__title", text: "Summary", count: 0
+
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_editor_table_of_contents
+      assert_select "a.toc__title[href=?]", edit_leafable_path(leaves(:summary_page)), text: "Renamed summary"
+    end
+  end
+
+  test "show reads the table of contents from the cache in one go" do
+    with_caching do
+      assert_table_of_contents_read_in_one_go
+
+      books(:handbook).touch
+      assert_table_of_contents_read_in_one_go
+    end
+  end
+
+  test "show checks whether the book is editable once, not once per entry" do
+    sign_in :jz
+
+    with_caching do
+      lookups = 0
+      count_lookups = ->(*, payload) { lookups += 1 if payload[:sql].include?(%(FROM "accesses")) }
+      ActiveSupport::Notifications.subscribed(count_lookups, "sql.active_record") do
+        get book_slug_path(books(:handbook))
+      end
+
+      assert_reader_table_of_contents
+      assert_equal 1, lookups
+    end
+  end
+
+  private
+    def assert_editor_table_of_contents
+      assert_response :success
+      books(:handbook).leaves.active.each do |leaf|
+        assert_select "a[href=?]", edit_leafable_path(leaf), minimum: 1
+        assert_select "##{dom_id(leaf)} form.leaf__delete", count: 1
+      end
+    end
+
+    def assert_reader_table_of_contents
+      assert_response :success
+      books(:handbook).leaves.active.each do |leaf|
+        assert_select "a[href=?]", edit_leafable_path(leaf), count: 0
+        assert_select "a.toc__title[href=?]", leafable_slug_path(leaf), count: 1
+        assert_select "##{dom_id(leaf)} form.leaf__delete", count: 0
+      end
+    end
+    def assert_table_of_contents_read_in_one_go
+      reads = Hash.new(0)
+      count_reads = ->(name, *) { reads[name] += 1 }
+      ActiveSupport::Notifications.subscribed(count_reads, /\Acache_read(_multi)?\.active_support\z/) do
+        get book_slug_path(books(:handbook))
+      end
+
+      assert_response :success
+      assert_equal 1, reads["cache_read_multi.active_support"], "entries are fetched together"
+      assert_equal 1, reads["cache_read.active_support"], "only the page fragment is read on its own, never an entry"
+    end
 end
