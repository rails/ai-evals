+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly lists each published book with the day it was last edited" do
+    books(:handbook).update_columns published: true, updated_at: Time.utc(2025, 1, 2, 3, 4, 5)
+
+    email = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_equal [ users(:kevin).email_address ], email.to
+    assert_includes email.body.to_s, "* Handbook, last edited 02 Jan\n"
+  end
+end
