@@ -19,6 +19,18 @@ module Writebook
     # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
     config.log_level = ENV.fetch("LOG_LEVEL", "debug")
 
+    # `bin/rails server` echoes the log to the terminal but `bin/rails runner` doesn't, so a
+    # runner script that reports through Rails.logger (script/library_report.rb, the last step
+    # of the import runbook) printed nothing. Echo the log to STDOUT as well. The log file keeps
+    # the full record, and nothing is added when the logger already writes to the terminal
+    # (production logs to STDOUT).
+    runner do
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout, STDOUT, STDERR)
+        Rails.logger.broadcast_to \
+          TerminalLogger.new($stdout, level: Rails.logger.level, formatter: Rails.logger.formatter)
+      end
+    end
+
