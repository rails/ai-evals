diff --git a/lib/terminal_logger.rb b/lib/terminal_logger.rb
new file mode 100644
index 0000000..9cbeaa3
--- /dev/null
+++ b/lib/terminal_logger.rb
@@ -0,0 +1,11 @@
+# A log sink for someone watching a terminal, e.g. `bin/rails runner` (see config/application.rb).
+#
+# It shows what the application reports, info and above, and leaves debug chatter such as SQL
+# to the log file. The floor also holds while the level is lowered temporarily with +log_at+,
+# which would otherwise override the sink's own level. Raising the level (+silence+, a higher
+# LOG_LEVEL) still works as usual.
+class TerminalLogger < ActiveSupport::Logger
+  def level
+    [ super, INFO ].max
+  end
+end
