diff --git a/test/lib/terminal_logger_test.rb b/test/lib/terminal_logger_test.rb
new file mode 100644
index 0000000..86e66aa
--- /dev/null
+++ b/test/lib/terminal_logger_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class TerminalLoggerTest < ActiveSupport::TestCase
+  setup do
+    @terminal = StringIO.new
+    @logger = TerminalLogger.new(@terminal, level: :debug)
+  end
+
+  test "shows info and above but leaves debug to the log file" do
+    @logger.debug "debug"
+    @logger.info "info"
+    @logger.warn "warn"
+
+    assert_equal "info\nwarn\n", @terminal.string
+  end
+
+  test "keeps debug off the terminal while the level is lowered with log_at" do
+    @logger.log_at(:debug) do
+      @logger.debug "debug"
+      @logger.info "info"
+    end
+
+    assert_equal "info\n", @terminal.string
+  end
+
+  test "can still be quieted" do
+    @logger.silence(:error) { @logger.warn "silenced" }
+    @logger.level = :warn
+    @logger.info "below level"
+
+    assert_empty @terminal.string
+  end
+end
diff --git a/test/script/library_report_test.rb b/test/script/library_report_test.rb
new file mode 100644
index 0000000..5999303
--- /dev/null
+++ b/test/script/library_report_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+# script/library_report.rb is run with `bin/rails runner` as the last step of the import runbook.
+# These tests run it the way the runner does: the app's runner hooks first, then the script.
+class LibraryReportTest < ActiveSupport::TestCase
+  REPORT = [
+    "INFO Library report: 2 books",
+    "WARN Library report: Manual has no pages",
+    "INFO Library report: Handbook has 4 pages",
+    "INFO Library report: done"
+  ]
+
+  test "shows the report on the terminal and records every line in the log" do
+    terminal, log = run_report
+
+    assert_equal REPORT, terminal
+    assert_equal REPORT, log
+  end
+
+  test "records and shows the whole report even when LOG_LEVEL has been raised" do
+    terminal, log = run_report(log_level: :error)
+
+    assert_equal REPORT, terminal
+    assert_equal REPORT, log
+  end
+
+  test "prints each line once when the log already goes to the terminal" do
+    terminal, _ = run_report(log_to_terminal: true)
+
+    assert_equal REPORT, terminal
+  end
+
+  test "leaves the log level as it was" do
+    run_report(log_level: :warn) do
+      assert_equal Logger::WARN, Rails.logger.level
+    end
+  end
+
+  private
+    # Stands in for the app's logger (log/<env>.log), with severities in the output so they can
+    # be checked, and returns the report lines that reached the terminal and the log.
+    def run_report(log_level: :debug, log_to_terminal: false)
+      log, original_logger = StringIO.new, Rails.logger
+
+      terminal, _ = capture_io do
+        log = $stdout if log_to_terminal
+        Rails.logger = ActiveSupport::BroadcastLogger.new(
+          ActiveSupport::Logger.new(log, level: log_level, formatter: ->(severity, _, _, message) { "#{severity} #{message}\n" }))
+
+        Rails.application.load_runner
+        load Rails.root.join("script/library_report.rb").to_s
+        yield if block_given?
+      end
+
+      [ report_lines(terminal), report_lines(log.string) ]
+    ensure
+      Rails.logger = original_logger
+    end
+
+    def report_lines(output)
+      output.lines(chomp: true).grep(/Library report/)
+    end
+end
