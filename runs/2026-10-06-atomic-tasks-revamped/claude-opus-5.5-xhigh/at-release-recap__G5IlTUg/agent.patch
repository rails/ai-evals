index 64e5e28..e9ccfb7 100644
--- a/app/models/book/recap.rb
+++ b/app/models/book/recap.rb
@@ -15,8 +15,18 @@ module Book::Recap
 
   private
     def write_recap
-      Rails.cache.write recap_cache_key,
-        { title: title, published: published },
-        expires_in: Rails.application.config.x.recap.expires_in
+      if recap = committed_recap
+        Rails.cache.write recap_cache_key, recap,
+          expires_in: Rails.application.config.x.recap.expires_in
+      end
+    end
+
+    # When several in-memory copies of a book are saved in one transaction, Rails
+    # runs the commit callbacks on only one of them (the last one saved), and that
+    # copy can hold stale values for columns it didn't change itself. Build the
+    # recap from the committed row so it reflects what was actually saved.
+    def committed_recap
+      title, published = self.class.where(id: id).pick(:title, :published)
+      { title: title, published: published } unless title.nil?
     end
 end
