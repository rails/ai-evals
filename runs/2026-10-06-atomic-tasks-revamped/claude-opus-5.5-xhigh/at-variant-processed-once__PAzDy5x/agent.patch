+    perform_enqueued_jobs do
+      leaves(:reading_picture).leafable.image.attach io: file_fixture("white-rabbit.webp").open,
+        filename: "white-rabbit.webp", content_type: "image/webp"
+    end
+    derived = leaves(:reading_picture).leafable.image.blob.variant_records.sole.image
+
+    assert_no_notifications "transform.active_storage" do
+      assert_no_difference -> { ActiveStorage::VariantRecord.count } do
+        get leafable_slug_path(leaves(:reading_picture))
+        get css_select("figure img").first["src"]
+        follow_redirect!
+      end
+    end
+
+    assert_response :success
+    assert_equal derived.download, response.body
+  end
