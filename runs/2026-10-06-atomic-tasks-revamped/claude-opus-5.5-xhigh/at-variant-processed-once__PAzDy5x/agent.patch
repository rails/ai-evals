diff --git a/lib/rails_ext/active_storage_variation_digest.rb b/lib/rails_ext/active_storage_variation_digest.rb
new file mode 100644
index 0000000..8762aef
--- /dev/null
+++ b/lib/rails_ext/active_storage_variation_digest.rb
@@ -0,0 +1,18 @@
+# Variant records are found by their variation digest, and that digest is computed from transformations
+# arriving two ways: straight from a named variant (when it's derived in the background after upload) and
+# decoded from the signed variation key in a representation URL (when a reader fetches it). The key is
+# JSON-serialized, which turns Symbol values into Strings, so `format: :webp` comes back as `format: "webp"`.
+# A Marshal digest tells those apart, so readers missed the background copy, derived the picture again,
+# and stored a second copy next to the first.
+#
+# Digest the transformations as they come back from the variation key, so both ways agree. That's the
+# digest readers have always looked up, so the copies they're already served keep being served.
+module ActiveStorage::KeyStableVariationDigest
+  def digest
+    OpenSSL::Digest::SHA1.base64digest Marshal.dump(self.class.decode(key).transformations)
+  end
+end
+
+Rails.application.config.to_prepare do
+  ActiveStorage::Variation.prepend ActiveStorage::KeyStableVariationDigest
+end
