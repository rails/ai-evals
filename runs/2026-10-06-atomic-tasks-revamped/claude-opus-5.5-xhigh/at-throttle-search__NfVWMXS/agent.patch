   # Load test helpers
   config.autoload_paths += %w[ test/test_helpers ]
+
+  # Rate limits are kept in memory in test (see RateLimiter.store), so start
+  # every test without any, rather than inheriting them from earlier tests.
+  ActiveSupport.on_load(:active_support_test_case) do
+    setup { RateLimiter.reset }
+  end
 end
diff --git a/test/integration/book_search_rate_limit_test.rb b/test/integration/book_search_rate_limit_test.rb
new file mode 100644
index 0000000..87b65d4
--- /dev/null
+++ b/test/integration/book_search_rate_limit_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class BookSearchRateLimitTest < ActionDispatch::IntegrationTest
+  SCRAPER = "203.0.113.9"
+  READER  = "198.51.100.7"
+
+  setup do
+    Leaf.reindex_all
+    books(:handbook).update!(published: true)
+  end
+
+  test "an address gets thirty searches a minute and is refused the rest" do
+    30.times do
+      search from: SCRAPER
+      assert_response :success
+    end
+
+    search from: SCRAPER
+    assert_response :too_many_requests
+    assert response.headers["Retry-After"].to_i.between?(1, 60)
+    assert_in_body "Too many searches"
+  end
+
+  test "the limit covers searches of every book" do
+    books(:manual).update!(published: true)
+    30.times { search books(:handbook), from: SCRAPER }
+
+    search books(:manual), from: SCRAPER
+    assert_response :too_many_requests
+  end
+
+  test "the limit holds over any one-minute stretch" do
+    freeze_time
+    search from: SCRAPER
+    travel 50.seconds
+    29.times { search from: SCRAPER }
+
+    travel 15.seconds
+    search from: SCRAPER
+    assert_response :success, "the first search is over a minute old"
+
+    search from: SCRAPER
+    assert_response :too_many_requests, "the other 29 are still within the minute"
+  end
+
+  test "a refused address is served again after the burst stops" do
+    50.times { search from: SCRAPER }
+    assert_response :too_many_requests
+
+    travel 5.minutes
+    search from: SCRAPER
+    assert_response :success
+    assert_select "a.search__result", text: /Thanks/
+  end
+
+  test "other addresses can still search without signing in" do
+    31.times { search from: SCRAPER }
+    assert_response :too_many_requests
+
+    search from: READER
+    assert_response :success
+    assert_select "a.search__result", text: /Thanks/
+  end
+
+  test "a refused address can still read the book" do
+    31.times { search from: SCRAPER }
+    assert_response :too_many_requests
+
+    get book_slug_path(books(:handbook)), env: { "REMOTE_ADDR" => SCRAPER }
+    assert_response :success
+
+    get leafable_slug_path(leaves(:welcome_page)), env: { "REMOTE_ADDR" => SCRAPER }
+    assert_response :success
+  end
+
+  test "a refused search keeps the search form in the frame" do
+    30.times { search from: SCRAPER }
+
+    search from: SCRAPER, headers: { "Turbo-Frame" => "search" }
+    assert_response :too_many_requests
+    assert_select "turbo-frame#search form#search_form"
+  end
+
+  private
+    def search(book = books(:handbook), from:, headers: {})
+      post book_search_path(book), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => from }, headers: headers
+    end
+end
diff --git a/test/models/rate_limiter_test.rb b/test/models/rate_limiter_test.rb
new file mode 100644
index 0000000..f21bb36
--- /dev/null
+++ b/test/models/rate_limiter_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class RateLimiterTest < ActiveSupport::TestCase
+  setup do
+    @limiter = RateLimiter.new("test", limit: 3, period: 1.minute, store: ActiveSupport::Cache::MemoryStore.new)
+
+    freeze_time
+  end
+
+  test "admits up to the limit and refuses the rest" do
+    assert 3.times.all? { @limiter.admit?("203.0.113.1") }
+    assert_not @limiter.admit?("203.0.113.1")
+  end
+
+  test "each client has its own limit" do
+    3.times { @limiter.admit?("203.0.113.1") }
+
+    assert @limiter.admit?("198.51.100.1")
+  end
+
+  test "limits any period-long stretch rather than fixed windows" do
+    @limiter.admit?("203.0.113.1")
+    travel 50.seconds
+    2.times { assert @limiter.admit?("203.0.113.1") }
+    assert_not @limiter.admit?("203.0.113.1")
+
+    travel 10.seconds
+    assert @limiter.admit?("203.0.113.1"), "the first request is now a minute old"
+    assert_not @limiter.admit?("203.0.113.1"), "the other two are still within the minute"
+  end
+
+  test "refused requests don't count against the client" do
+    3.times { @limiter.admit?("203.0.113.1") }
+    travel 30.seconds
+    10.times { @limiter.admit?("203.0.113.1") }
+
+    travel 30.seconds
+    assert 3.times.all? { @limiter.admit?("203.0.113.1") }
+  end
+
+  test "retry_after is the time until the oldest admitted request leaves the window" do
+    assert_equal 0, @limiter.retry_after("203.0.113.1")
+
+    @limiter.admit?("203.0.113.1")
+    travel 20.seconds
+    2.times { @limiter.admit?("203.0.113.1") }
+
+    assert_equal 40, @limiter.retry_after("203.0.113.1")
+  end
+
+  test "concurrent requests can't share a slot" do
+    limiter = RateLimiter.new("test", limit: 30, period: 1.minute, store: ActiveSupport::Cache::MemoryStore.new)
+    admitted = Queue.new
+
+    8.times.map { Thread.new { 20.times { admitted << true if limiter.admit?("203.0.113.1") } } }.each(&:join)
+
+    assert_equal 30, admitted.size
+  end
+
+  test "lets requests through when the store is unavailable" do
+    limiter = RateLimiter.new("test", limit: 3, period: 1.minute, store: UnavailableStore.new)
+
+    assert 10.times.all? { limiter.admit?("203.0.113.1") }
+  end
+
+  test "keeps limits in memory when caching is switched off" do
+    assert_kind_of ActiveSupport::Cache::NullStore, Rails.cache
+    assert_kind_of ActiveSupport::Cache::MemoryStore, RateLimiter.store
+  end
+
+  private
+    # Behaves like RedisCacheStore does when Redis can't be reached.
+    class UnavailableStore
+      def read_multi(*) = {}
+      def write(*, **) = nil
+    end
+end
