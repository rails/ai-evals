+    leaves(:welcome_page).page.update!(body: "x" * 1_234_567)
+
+    assert_match(/\AHandbook — 1,234,\d{3} characters\z/, books(:handbook).report_summary)
+  end
+
+  test "report summary for a book without leaves" do
+    assert_equal "Manual — 0 characters", books(:manual).report_summary
+  end
+end
