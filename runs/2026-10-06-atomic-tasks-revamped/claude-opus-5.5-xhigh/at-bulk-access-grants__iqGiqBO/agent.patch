diff --git a/app/models/book/access_import.rb b/app/models/book/access_import.rb
index 4d920cf..4c0b791 100644
--- a/app/models/book/access_import.rb
+++ b/app/models/book/access_import.rb
@@ -6,20 +6,92 @@ class Book::AccessImport
   end
 
   def import
-    accesses = []
-    duplicate_index = nil
-
-    Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
+    accesses = Access.transaction(requires_new: true) { create_accesses }
+    notify accesses
+    Result.new(accesses, nil)
+  rescue Rejected => rejected
+    Result.new([], rejected.index)
+  end
+
+  private
+    class Rejected < StandardError
+      attr_reader :index
+
+      def initialize(index)
+        @index = index
+        super("Grant ##{index} was turned down")
       end
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
-  end
+    private_constant :Rejected
+
+    Row = Data.define(:user_id, :level, :level_name) do
+      def unknown_level?
+        level.nil? && level_name.present?
+      end
+    end
+
+    private_constant :Row
+
+    # The whole sheet costs the same number of queries however long it is:
+    # one read for the people, one for the access they already have, and a
+    # single insert. Every row is checked, in order, before anything is written.
+    def create_accesses
+      rows = @grants.map { row_for(it) }
+      return [] if rows.empty?
+
+      users = User.where(id: rows.map(&:user_id).compact.uniq).index_by(&:id)
+      check rows, users
+      insert rows, users
+    end
+
+    def row_for(grant)
+      level = Access.type_for_attribute(:level).cast(grant[:level])
+
+      Row.new \
+        user_id: Access.type_for_attribute(:user_id).cast(grant[:user_id]),
+        level: (level if Access.levels.key?(level)),
+        level_name: grant[:level]
+    end
+
+    def check(rows, users)
+      taken = @book.accesses.where(user_id: users.keys).pluck(:user_id).to_set
+
+      rows.each_with_index do |row, index|
+        reject index if row.unknown_level?
+        user_must_exist! row unless users.key?(row.user_id)
+        reject index if row.level.nil? || !taken.add?(row.user_id)
+      end
+    end
+
+    def insert(rows, users)
+      inserted = @book.accesses
+        .insert_all(rows.map { { user_id: it.user_id, level: it.level } }, returning: Access.column_names)
+        .map { Access.instantiate(it) }
+        .index_by(&:user_id)
+
+      rows.each_with_index.map do |row, index|
+        # Missing only if someone else granted this person access since the check
+        access = inserted[row.user_id] or reject(index)
+        access.association(:book).target = @book
+        access.association(:user).target = users[row.user_id]
+        access
+      end
+    end
+
+    def reject(index)
+      raise Rejected.new(index)
+    end
+
+    def user_must_exist!(row)
+      access = Access.new(book_id: @book.id, user_id: row.user_id, level: row.level)
+      access.errors.add(:user, :required)
+      raise ActiveRecord::RecordInvalid, access
+    end
+
+    def notify(accesses)
+      ActiveRecord.after_all_transactions_commit do
+        ActiveJob.perform_all_later accesses.map { Book::AccessNotificationJob.new(it) }
+      end
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..a3381a0
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Roster", everyone_access: false)
+  end
+
+  test "grants everyone on the sheet and lets each of them know" do
+    result = import @book, { user_id: users(:kevin).id, level: :editor }, { user_id: users(:jz).id.to_s, level: "reader" }
+
+    assert_nil result.duplicate_index
+    assert_equal [ users(:kevin), users(:jz) ], result.accesses.map(&:user)
+    assert result.accesses.all?(&:persisted?)
+    assert @book.editable?(user: users(:kevin))
+    assert @book.accessable?(user: users(:jz))
+    assert_not @book.editable?(user: users(:jz))
+
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob
+    result.accesses.each { assert_enqueued_with job: Book::AccessNotificationJob, args: [ it ] }
+  end
+
+  test "an empty sheet grants nothing" do
+    result = import @book
+
+    assert_equal [ [], nil ], [ result.accesses, result.duplicate_index ]
+    assert_no_enqueued_jobs
+  end
+
+  test "turns down a sheet naming someone who already has access, granting and notifying nobody" do
+    result = import books(:manual), { user_id: users(:kevin).id, level: :reader }, { user_id: users(:jz).id, level: :editor }
+
+    assert_equal [ [], 1 ], [ result.accesses, result.duplicate_index ]
+    assert_not books(:manual).accessable?(user: users(:kevin))
+    assert_no_enqueued_jobs
+  end
+
+  test "turns down a sheet naming someone twice, granting and notifying nobody" do
+    result = import @book, { user_id: users(:kevin).id, level: :reader }, { user_id: users(:jz).id, level: :reader }, { user_id: users(:kevin).id, level: :editor }
+
+    assert_equal [ [], 2 ], [ result.accesses, result.duplicate_index ]
+    assert_empty @book.accesses
+    assert_no_enqueued_jobs
+  end
+
+  test "turns down a sheet naming a level nobody has heard of" do
+    result = import @book, { user_id: users(:kevin).id, level: :editor }, { user_id: users(:jz).id, level: "owner" }
+
+    assert_equal [ [], 1 ], [ result.accesses, result.duplicate_index ]
+    assert_empty @book.accesses
+    assert_no_enqueued_jobs
+  end
+
+  test "turns down a sheet with a row missing its level" do
+    result = import @book, { user_id: users(:kevin).id, level: :editor }, { user_id: users(:jz).id, level: "" }
+
+    assert_equal [ [], 1 ], [ result.accesses, result.duplicate_index ]
+    assert_empty @book.accesses
+    assert_no_enqueued_jobs
+  end
+
+  test "the first bad row is the one reported" do
+    result = import books(:manual), { user_id: users(:kevin).id, level: "owner" }, { user_id: users(:david).id, level: :reader }
+    assert_equal 0, result.duplicate_index
+
+    result = import books(:manual), { user_id: users(:david).id, level: :reader }, { user_id: users(:kevin).id, level: "owner" }
+    assert_equal 0, result.duplicate_index
+  end
+
+  test "a sheet naming someone who doesn't exist is invalid, granting and notifying nobody" do
+    error = assert_raises ActiveRecord::RecordInvalid do
+      import @book, { user_id: users(:kevin).id, level: :editor }, { user_id: -1, level: :reader }
+    end
+
+    assert_equal "Validation failed: User must exist", error.message
+    assert_empty @book.accesses
+    assert_no_enqueued_jobs
+  end
+
+  test "nobody is notified when the surrounding transaction rolls back" do
+    Access.transaction do
+      assert_equal 1, import(@book, { user_id: users(:kevin).id, level: :reader }).accesses.size
+      raise ActiveRecord::Rollback
+    end
+
+    assert_empty @book.accesses
+    assert_no_enqueued_jobs
+  end
+
+  test "a bigger sheet costs no more round trips, whether taken or turned down" do
+    people = Array.new(16) { |i| User.create!(name: "Person #{i}", email_address: "person#{i}@example.com", password: "secret123456") }
+    sheet = ->(people) { people.map { { user_id: it.id, level: :reader } } }
+
+    assert_equal \
+      count_queries { assert_nil import(Book.create!(title: "Four"), *sheet[people.first(4)]).duplicate_index },
+      count_queries { assert_nil import(Book.create!(title: "Sixteen"), *sheet[people]).duplicate_index }
+
+    assert_equal \
+      count_queries { assert_equal 4, import(@book, *sheet[people.first(4) + people.first(1)]).duplicate_index },
+      count_queries { assert_equal 16, import(@book, *sheet[people + people.first(1)]).duplicate_index }
+  end
+
+  private
+    def import(book, *grants)
+      Book::AccessImport.new(book, grants).import
+    end
+
+    def count_queries(&block)
+      count = 0
+      counter = ->(*, payload) { count += 1 unless payload[:name] == "SCHEMA" || payload[:cached] }
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record") { block.call }
+      count
+    end
+end
