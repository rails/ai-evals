diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
index 153d542..81a5440 100644
--- a/app/controllers/searches_controller.rb
+++ b/app/controllers/searches_controller.rb
@@ -2,6 +2,7 @@ class SearchesController < ApplicationController
   allow_unauthenticated_access
 
   RESULT_LIMIT = 50
+  LIKE_ESCAPE_CHARACTER = "\\"
 
   def show
     @query = params[:q].to_s.strip
@@ -10,13 +11,31 @@ class SearchesController < ApplicationController
 
   private
     def matching_leaves
-      Leaf.active.joins(:book)
-        .where("books.id in (#{readable_book_ids.join(",")}) and leaves.title like '%#{@query}%'")
+      Leaf.active
+        .where(book_id: readable_book_ids)
+        .where(title_contains(@query))
+        .joins(:book).preload(:book)
         .order("books.title", "leaves.position_score")
         .limit(RESULT_LIMIT)
     end
 
     def readable_book_ids
-      Book.accessable_or_published.ids.presence || [ 0 ]
+      Book.accessable_or_published.select(:id)
+    end
+
+    # What was typed is only ever data: it is sent to the database as a bound
+    # parameter, never spliced into the SQL, and the LIKE wildcards it may
+    # contain (% and _) are escaped so they match only themselves.
+    def title_contains(query)
+      Leaf.arel_table[:title].matches(bound_title(like_pattern_containing(query)), LIKE_ESCAPE_CHARACTER)
+    end
+
+    def like_pattern_containing(text)
+      "%#{Leaf.sanitize_sql_like(text, LIKE_ESCAPE_CHARACTER)}%"
+    end
+
+    def bound_title(value)
+      Arel::Nodes::BindParam.new \
+        ActiveRecord::Relation::QueryAttribute.new("title", value, Leaf.type_for_attribute(:title))
     end
 end
