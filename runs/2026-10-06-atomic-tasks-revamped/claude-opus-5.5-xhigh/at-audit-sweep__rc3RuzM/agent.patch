diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..f424e06
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,141 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  test "show finds pages by title" do
+    sign_in :kevin
+
+    get library_search_path(q: "welcome")
+
+    assert_response :success
+    assert_select ".search__result", count: 2
+    assert_select ".search__result", text: /The Welcome Section/
+    assert_select ".search__result", text: /Welcome to The Handbook!/
+  end
+
+  test "show with a blank query lists nothing" do
+    sign_in :kevin
+
+    get library_search_path(q: "   ")
+
+    assert_response :success
+    assert_select ".search__result", count: 0
+    assert_select ".search__no_matches", count: 0
+  end
+
+  test "show does not find trashed pages" do
+    sign_in :kevin
+    leaves(:summary_page).trashed!
+
+    get library_search_path(q: "Summary")
+
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "show only finds pages in books the user can read" do
+    sign_in :kevin
+
+    get library_search_path(q: "Save 50% off")
+
+    assert_response :success
+    assert_select ".search__result", count: 0
+    assert_select ".search__no_matches"
+  end
+
+  test "show finds pages in books the user can read through their access" do
+    sign_in :jz
+
+    get library_search_path(q: "Save 50% off")
+
+    assert_response :success
+    assert_select ".search__result", text: /Catalog: Save 50% off/
+  end
+
+  test "show finds pages in published books the user has no access to" do
+    sign_in :kevin
+    books(:catalog).update!(published: true)
+
+    get library_search_path(q: "Save 50% off")
+
+    assert_response :success
+    assert_select ".search__result", text: /Catalog: Save 50% off/
+  end
+
+  test "show only finds pages in published books when signed out" do
+    books(:catalog).update!(published: true)
+
+    get library_search_path(q: "a")
+
+    assert_response :success
+    assert_select ".search__result", count: 1
+    assert_select ".search__result", text: /Catalog: Save 50% off/
+  end
+
+  test "show treats the query as data rather than SQL" do
+    sign_in :kevin
+
+    [ "%' or 1=1 or '", "') or 1=1 --", "' union select * from leaves --" ].each do |query|
+      get library_search_path(q: query)
+
+      assert_response :success
+      assert_not_in_body "Save 50% off"
+      assert_select ".search__result", count: 0
+    end
+  end
+
+  test "show treats punctuation as text to find" do
+    sign_in :kevin
+    leaves(:summary_page).update!(title: %q(Kevin's "quick" \ summary; -- notes))
+
+    [ "'", "Kevin's", %q("quick"), "\\", ";", "--" ].each do |query|
+      get library_search_path(q: query)
+
+      assert_response :success
+      assert_select ".search__result", count: 1
+      assert_select ".search__result", text: /Handbook: Kevin.s "quick" \\ summary; -- notes/
+    end
+
+    [ "\u0000", "a\u0000b", "(", ")" ].each do |query|
+      get library_search_path(q: query)
+
+      assert_response :success
+      assert_select ".search__result", count: 0
+    end
+  end
+
+  test "show matches the percent sign literally" do
+    sign_in :jz
+
+    [ "Save 50% off", "save 50% OFF", "50%", "%" ].each do |query|
+      get library_search_path(q: query)
+
+      assert_response :success
+      assert_select ".search__result", count: 1
+      assert_select ".search__result", text: /Catalog: Save 50% off/
+    end
+
+    get library_search_path(q: "Sa%off")
+
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "show matches the underscore literally" do
+    sign_in :jz
+
+    [ "_", "Save 50_ off", "S_ve" ].each do |query|
+      get library_search_path(q: query)
+
+      assert_response :success
+      assert_select ".search__result", count: 0
+    end
+
+    leaves(:summary_page).update!(title: "snake_case")
+
+    get library_search_path(q: "_")
+
+    assert_response :success
+    assert_select ".search__result", count: 1
+    assert_select ".search__result", text: /Handbook: snake_case/
+  end
+end
diff --git a/test/controllers/users/profiles_controller_test.rb b/test/controllers/users/profiles_controller_test.rb
index 7564f7d..22e1348 100644
--- a/test/controllers/users/profiles_controller_test.rb
+++ b/test/controllers/users/profiles_controller_test.rb
@@ -38,4 +38,59 @@ class Users::ProfilesControllerTest < ActionDispatch::IntegrationTest
     assert_response :forbidden
     assert_equal "Kevin", users(:kevin).reload.name
   end
+
+  test "update changes the current user's name, email address and password" do
+    sign_in :kevin
+
+    put user_profile_path(users(:kevin)), params: { user: { name: "Bob", email_address: "bob@example.com", password: "new-secret-123" } }
+
+    assert_redirected_to users_url
+    users(:kevin).reload.tap do |kevin|
+      assert_equal "Bob", kevin.name
+      assert_equal "bob@example.com", kevin.email_address
+      assert kevin.authenticate("new-secret-123")
+    end
+  end
+
+  test "update does not let a member make themselves an administrator" do
+    sign_in :kevin
+
+    put user_profile_path(users(:kevin)), params: { user: { name: "Bob", role: "administrator" } }
+
+    assert_redirected_to users_url
+    assert_equal "Bob", users(:kevin).reload.name
+    assert users(:kevin).member?
+  end
+
+  test "update does not change the role of an administrator either" do
+    sign_in :david
+
+    put user_profile_path(users(:david)), params: { user: { name: "Dave", role: "member" } }
+
+    assert_redirected_to users_url
+    assert_equal "Dave", users(:david).reload.name
+    assert users(:david).administrator?
+  end
+
+  test "update does not let a member change somebody else's role" do
+    sign_in :kevin
+
+    put user_profile_path(users(:jz)), params: { user: { role: "administrator" } }
+    assert_response :forbidden
+
+    put user_profile_path(users(:david)), params: { user: { role: "member" } }
+    assert_response :forbidden
+
+    assert users(:jz).reload.member?
+    assert users(:david).reload.administrator?
+  end
+
+  test "edit does not include the role in the form" do
+    sign_in :kevin
+
+    get edit_user_profile_path(users(:kevin))
+
+    assert_response :success
+    assert_select "input[name='user[role]']", count: 0
+  end
 end
