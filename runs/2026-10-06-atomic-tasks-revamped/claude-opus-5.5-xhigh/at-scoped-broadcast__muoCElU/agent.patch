diff --git a/test/controllers/pages_controller_test.rb b/test/controllers/pages_controller_test.rb
index 0b0ccec..9aad09b 100644
--- a/test/controllers/pages_controller_test.rb
+++ b/test/controllers/pages_controller_test.rb
@@ -79,7 +79,41 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "update shows who is editing to the other editors of the page" do
+    david_stream = being_edited_stream_on_editor_of leaves(:welcome_page), as: :david
+
+    sign_in :kevin
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Edited" } }
+    end
+
+    indicator = capture_turbo_stream_broadcasts(david_stream).sole
+    assert_equal "being_edited_leaf_#{leaves(:welcome_page).id}", indicator["target"]
+    assert_includes indicator.inner_html, users(:kevin).name
+  end
+
+  test "update does not show who is editing to a collaborator removed from the book" do
+    kevin_stream = being_edited_stream_on_editor_of leaves(:welcome_page), as: :kevin
+    books(:handbook).update! everyone_access: false
+    books(:handbook).update_access editors: [ users(:david).id, users(:jason).id ], readers: []
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Edited" } }
+    end
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+  end
+
   private
+    def being_edited_stream_on_editor_of(leaf, as:)
+      sign_in as
+      get edit_leafable_path(leaf)
+
+      signed_stream_name = css_select("turbo-cable-stream-source").sole["signed-stream-name"]
+      Turbo::StreamsChannel.verified_stream_name(signed_stream_name)
+    end
+
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
     end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
