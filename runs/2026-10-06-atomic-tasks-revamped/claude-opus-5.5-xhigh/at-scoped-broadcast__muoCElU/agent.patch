@@ -32,6 +32,14 @@ module Book::Accessable
     accesses.find_by(user: user)
   end
 
+  # Everyone who can currently open this book in the editor: active users with editor
+  # access, plus administrators who can reach the book (through any access, or because
+  # it is published).
+  def editors
+    reachable = published? ? User.active : User.active.where(id: accesses.select(:user_id))
+    reachable.where(id: accesses.editor.select(:user_id)).or(reachable.administrator)
+  end
+
   def update_access(editors:, readers:)
     editors = Set.new(editors)
     readers = Set.new(everyone_access? ? User.active.ids : readers)
