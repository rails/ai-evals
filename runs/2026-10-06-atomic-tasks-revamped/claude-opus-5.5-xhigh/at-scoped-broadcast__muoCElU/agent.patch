@@ -33,4 +33,30 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+  test "editors are the active users with editor access, plus administrators who can reach the book" do
+    book = books(:handbook)
+    book.update! everyone_access: false
+
+    assert_equal users(:david, :jason, :kevin).sort, book.editors.sort
+
+    book.update_access(editors: [ users(:david).id ], readers: [ users(:jz).id ])
+    assert_equal [ users(:david) ], book.editors.to_a
+
+    book.update_access(editors: [ users(:david).id ], readers: [ users(:jason).id, users(:kevin).id ])
+    assert_equal users(:david, :jason).sort, book.editors.sort, "administrators can edit any book they can reach"
+  end
+
+  test "editors include every active administrator of a published book" do
+    book = books(:handbook)
+    book.update! published: true, everyone_access: false
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+
+    assert_equal users(:jason, :kevin).sort, book.editors.where.not(id: users(:david)).sort
+  end
+
+  test "editors exclude deactivated users" do
+    users(:kevin).deactivate
+
+    assert_not_includes books(:handbook).editors, users(:kevin)
+  end
 end
diff --git a/test/models/leaf/presence_test.rb b/test/models/leaf/presence_test.rb
new file mode 100644
index 0000000..9c26b8b
--- /dev/null
+++ b/test/models/leaf/presence_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Leaf::PresenceTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "broadcast being edited to every editor of the book on their own stream" do
+    @leaf.broadcast_being_edited_by users(:kevin)
+
+    users(:david, :jason, :kevin).each do |editor|
+      streams = capture_turbo_stream_broadcasts @leaf.being_edited_stream_for(editor)
+
+      assert_equal 1, streams.size
+      assert_equal "append", streams.first["action"]
+      assert_equal "being_edited_leaf_#{@leaf.id}", streams.first["target"]
+      assert_includes streams.first.inner_html, "Kevin"
+    end
+  end
+
+  test "broadcast being edited never goes out on a stream shared by all editors" do
+    @leaf.broadcast_being_edited_by users(:kevin)
+
+    assert_no_turbo_stream_broadcasts [ @leaf, :being_edited ]
+  end
+
+  test "broadcast being edited skips people who can no longer edit the book" do
+    books(:handbook).access_for(user: users(:kevin)).destroy!
+
+    @leaf.broadcast_being_edited_by users(:david)
+
+    assert_no_turbo_stream_broadcasts @leaf.being_edited_stream_for(users(:kevin))
+    assert_no_turbo_stream_broadcasts @leaf.being_edited_stream_for(users(:jz))
+    assert_turbo_stream_broadcasts @leaf.being_edited_stream_for(users(:jason)), count: 1
+  end
+
+  test "broadcast being edited later checks who can edit when the broadcast goes out" do
+    @leaf.broadcast_being_edited_by_later users(:david)
+    books(:handbook).access_for(user: users(:kevin)).destroy!
+
+    perform_enqueued_jobs
+
+    assert_no_turbo_stream_broadcasts @leaf.being_edited_stream_for(users(:kevin))
+    assert_turbo_stream_broadcasts @leaf.being_edited_stream_for(users(:jason)), count: 1
+  end
+end
