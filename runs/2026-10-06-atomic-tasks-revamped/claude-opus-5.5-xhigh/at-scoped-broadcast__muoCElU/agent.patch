diff --git a/app/models/leaf/presence.rb b/app/models/leaf/presence.rb
new file mode 100644
index 0000000..694ab12
--- /dev/null
+++ b/app/models/leaf/presence.rb
@@ -0,0 +1,32 @@
+# The "being edited" indicator shown in a leaf's editor.
+#
+# Presence is never broadcast on a stream shared by everyone who has opened the editor:
+# signed stream names don't expire, so whoever subscribed while they had access could
+# keep listening after losing it. Instead, each editor listens on a stream of their own,
+# and presence is only pushed to the streams of the people who can edit the book at the
+# moment it's broadcast.
+module Leaf::Presence
+  extend ActiveSupport::Concern
+
+  def being_edited_stream_for(user)
+    [ self, user, :being_edited ]
+  end
+
+  def broadcast_being_edited_by_later(user)
+    Leaf::PresenceBroadcastJob.perform_later self, user
+  end
+
+  def broadcast_being_edited_by(user)
+    content = being_edited_by_turbo_stream(user)
+
+    book.editors.find_each do |editor|
+      Turbo::StreamsChannel.broadcast_stream_to being_edited_stream_for(editor), content: content
+    end
+  end
+
+  private
+    def being_edited_by_turbo_stream(user)
+      ApplicationController.render partial: "leaves/being_edited_by", formats: [ :turbo_stream ],
+        locals: { leaf: self, user: user }
+    end
+end
