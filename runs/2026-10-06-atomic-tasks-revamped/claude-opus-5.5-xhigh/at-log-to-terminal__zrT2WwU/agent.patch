@@ -0,0 +1,47 @@
+require "test_helper"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  REPORT = [
+    "INFO Library report: 2 books",
+    "WARN Library report: Manual has no pages",
+    "INFO Library report: Handbook has 4 pages",
+    "INFO Library report: done"
+  ]
+
+  test "prints the report and records each line in the log with its severity" do
+    log = StringIO.new
+    terminal = run_report(log: log)
+
+    assert_equal REPORT, log.string.lines(chomp: true)
+    assert_equal log.string, terminal
+  end
+
+  test "a raised log level doesn't drop report lines" do
+    log = StringIO.new
+    terminal = run_report(log: log, level: :error)
+
+    assert_equal REPORT, log.string.lines(chomp: true)
+    assert_equal log.string, terminal
+  end
+
+  test "doesn't print the report twice when the log already goes to the terminal" do
+    assert_equal REPORT, run_report(log: :terminal).lines(chomp: true)
+  end
+
+  private
+    def run_report(log:, level: :debug)
+      original_logger = Rails.logger
+
+      terminal, _ = capture_io do
+        device = log == :terminal ? $stdout : log
+        formatter = ->(severity, _time, _progname, message) { "#{severity} #{message}\n" }
+        Rails.logger = ActiveSupport::BroadcastLogger.new(ActiveSupport::Logger.new(device, level: level, formatter: formatter))
+
+        load Rails.root.join("script/library_report.rb").to_s
+      end
+
+      terminal
+    ensure
+      Rails.logger = original_logger
+    end
+end
