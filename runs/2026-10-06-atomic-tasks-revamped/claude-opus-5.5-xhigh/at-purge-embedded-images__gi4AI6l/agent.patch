     assert_includes page.searchable_content, "5 &lt; 10 &amp; 10 &gt; 5"
     assert page.searchable_content.html_safe?
   end
+
+  test "destroying a page purges the images uploaded into its body" do
+    page = pages(:welcome)
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    blob = page.body.uploads.blobs.last
+
+    perform_enqueued_jobs { page.destroy }
+
+    assert_not ActiveStorage::Attachment.exists?(blob_id: blob.id)
