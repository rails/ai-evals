diff --git a/app/models/picture.rb b/app/models/picture.rb
index 9bcf18f..b2f2697 100644
--- a/app/models/picture.rb
+++ b/app/models/picture.rb
@@ -1,8 +1,12 @@
 class Picture < ApplicationRecord
   include Leafable
 
+  # Variant options must survive a round trip through the variation key in the image URL, which is
+  # serialized as JSON. Symbols come back as strings, and the variant record is looked up by a digest
+  # of the options, so `format: :webp` would make readers miss the copy the background job already
+  # derived and process (and store) a second one. Keep these values JSON-native (strings, numbers).
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..9769b86 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -86,6 +86,26 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
     assert_select "figure img[src*=\"pixel.bmp\"]"
   end
 
+  test "show a picture derived in the background without processing it again" do
+    picture = leaves(:reading_picture).picture
+    perform_enqueued_jobs do
+      picture.image.attach io: file_fixture("white-rabbit.webp").open, filename: "white-rabbit.webp", content_type: "image/webp"
+    end
+
+    assert_no_difference -> { ActiveStorage::VariantRecord.count } do
+      assert_no_image_processing do
+        get leafable_slug_path(leaves(:reading_picture))
+        assert_response :success
+
+        get css_select("figure img").first["src"]
+        follow_redirect!
+        assert_response :success
+      end
+    end
+
+    assert_equal picture.large_image.download, response.body
+  end
+
   test "show with markdown format does not escape HTML entities" do
     leaves(:welcome_page).leafable.update!(body: "This has <a href='http://example.com'>a link</a>")
 
@@ -117,4 +137,12 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  private
+    def assert_no_image_processing(&block)
+      transforms = 0
+      counter = ->(*) { transforms += 1 }
+      ActiveSupport::Notifications.subscribed(counter, "transform.active_storage", &block)
+      assert_equal 0, transforms, "Expected no image processing"
+    end
 end
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..689219b 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -23,4 +23,12 @@ class PictureTest < ActiveSupport::TestCase
 
     assert_equal picture.image, picture.large_image
   end
+
+  test "large_image is the variant its URL resolves to" do
+    picture = pictures(:reading)
+    variation = picture.large_image.variation
+    resolved = picture.image.blob.representation(variation.key).variation
+
+    assert_equal variation.digest, resolved.digest
+  end
 end
