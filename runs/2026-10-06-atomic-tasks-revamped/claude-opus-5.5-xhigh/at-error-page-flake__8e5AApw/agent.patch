diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..411d7ea 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,26 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Inside the block, errors raised by controllers propagate to the test as
+    # exceptions instead of being rendered as error pages.
+    #
+    # Requests don't read config.action_dispatch.show_exceptions directly: Rails
+    # copies it into Rails.application.env_config, which is memoized when the
+    # first request in the process is made and merged into every request env
+    # from then on. Toggling the config at runtime is therefore either ignored
+    # (the cache was already built by an earlier test) or leaks into every
+    # later test in the same worker (the cache got built inside the block).
+    # Override the live value instead and always put it back.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
-      yield
-    ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config = Rails.application.env_config
+      previous = env_config.fetch("action_dispatch.show_exceptions")
+      env_config["action_dispatch.show_exceptions"] = :none
+
+      begin
+        yield
+      ensure
+        env_config["action_dispatch.show_exceptions"] = previous
+      end
     end
   end
 end
