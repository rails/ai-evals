@@ -2,6 +2,26 @@ ENV["RAILS_ENV"] ||= "test"
 require_relative "../config/environment"
 require "rails/test_help"
 
+# Rails caches env_config, so mutating application config for a single test can
+# either have no effect or affect every later request in the process. Override
+# exception handling only in the Rack env built on the current test thread.
+module TestRaisedExceptions
+  THREAD_KEY = :test_raised_exceptions
+
+  module ApplicationEnvConfig
+    def env_config
+      config = super
+      if Thread.current[TestRaisedExceptions::THREAD_KEY]
+        config.merge("action_dispatch.show_exceptions" => :none)
+      else
+        config
+      end
+    end
+  end
+end
+
+Rails.application.singleton_class.prepend(TestRaisedExceptions::ApplicationEnvConfig)
+
