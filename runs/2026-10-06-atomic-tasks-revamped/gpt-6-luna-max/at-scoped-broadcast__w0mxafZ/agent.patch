diff --git a/app/jobs/being_edited_broadcast_job.rb b/app/jobs/being_edited_broadcast_job.rb
new file mode 100644
index 0000000..0ca74c4
--- /dev/null
+++ b/app/jobs/being_edited_broadcast_job.rb
@@ -0,0 +1,11 @@
+class BeingEditedBroadcastJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(book, leaf, editor, recipient_ids)
+    # Permissions may change while this job is queued.
+    book.editable_users.where(id: recipient_ids).find_each do |recipient|
+      Turbo::StreamsChannel.broadcast_render_to leaf, :being_edited, recipient,
+        partial: "leaves/being_edited_by", locals: { leaf: leaf, user: editor }
+    end
+  end
+end
