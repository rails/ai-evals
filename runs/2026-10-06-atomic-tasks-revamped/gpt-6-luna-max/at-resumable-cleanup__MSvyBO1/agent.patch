+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  test "resumes after an interruption without stripping inner quotes" do
+    leaves = Leaf.order(:id).to_a
+    assert_operator leaves.length, :>=, 3
+
+    expected_titles = [
+      %("A quoted phrase" followed by "another phrase"),
+      "A normal title",
+      %(A title with "a quoted ending"),
+      *leaves.drop(3).map.with_index { |_leaf, index| "Another title #{index}" }
+    ]
+    wrapped_titles = expected_titles.map { |title| %("#{title}") }
+
+    leaves.zip(wrapped_titles).each do |leaf, title|
+      leaf.update!(title: title)
+    end
+
+    cleanup_calls = Hash.new(0)
+    interrupted_title = wrapped_titles.second
+    new_job = lambda do
+      job = TitleCleanupJob.new
+      original_cleaned = job.method(:cleaned)
+      job.define_singleton_method(:cleaned) do |title|
+        cleanup_calls[title] += 1
+        raise "simulated interruption" if title == interrupted_title && cleanup_calls[title] == 1
+
+        original_cleaned.call(title)
+      end
+      job
+    end
+
+    assert_raises(RuntimeError) { new_job.call.perform }
+    new_job.call.perform
+    new_job.call.perform
+
+    assert_equal expected_titles, leaves.map { |leaf| leaf.reload.title }
+    assert_equal 1, cleanup_calls[wrapped_titles.first]
+    assert_equal 0, cleanup_calls[expected_titles.first]
+    assert_equal 2, cleanup_calls[wrapped_titles.second]
+    wrapped_titles.drop(2).each do |title|
+      assert_equal 1, cleanup_calls[title]
+    end
+  end
+
+  test "rolls back the title with the checkpoint if saving progress fails" do
+    leaf = Leaf.order(:id).first
+    original_title = %("A quoted title")
+    wrapped_title = %("#{original_title}")
+    leaf.update!(title: wrapped_title)
+
+    cleanup_calls = Hash.new(0)
+    new_job = lambda do
+      job = TitleCleanupJob.new
+      original_cleaned = job.method(:cleaned)
+      job.define_singleton_method(:cleaned) do |title|
+        cleanup_calls[title] += 1
+        original_cleaned.call(title)
+      end
+      job
+    end
+
+    fail_checkpoint = proc do
+      raise "simulated interruption" if last_leaf_id.present?
+    end
+    TitleCleanupProgress.set_callback(:update, :before, fail_checkpoint)
+    begin
+      assert_raises(RuntimeError) do
+        ActiveRecord::Base.transaction(requires_new: true) { new_job.call.perform }
+      end
+    ensure
+      TitleCleanupProgress.skip_callback(:update, :before, fail_checkpoint)
+    end
+
+    assert_equal wrapped_title, leaf.reload.title
+    assert_nil TitleCleanupProgress.find_by(id: TitleCleanupJob::PROGRESS_RECORD_ID)
+
+    new_job.call.perform
+
+    assert_equal original_title, leaf.reload.title
+    assert_equal 2, cleanup_calls[wrapped_title]
+  end
+
+  test "only removes a matching outer quote pair" do
+    job = TitleCleanupJob.new
+    quote = 34.chr # ASCII double quote
+    quoted_phrase = quote + "A quoted phrase" + quote
+    trailing_quoted_phrase = "A title with " + quote + "a quoted ending" + quote
+
+    assert_equal "A title", job.send(:cleaned, quote + "A title" + quote)
+    assert_equal quoted_phrase + " continues", job.send(:cleaned, quote + quoted_phrase + " continues" + quote)
+    assert_equal quote + "Opening only", job.send(:cleaned, quote + "Opening only")
+    assert_equal "Closing only" + quote, job.send(:cleaned, "Closing only" + quote)
+    assert_equal trailing_quoted_phrase, job.send(:cleaned, trailing_quoted_phrase)
+    assert_equal "", job.send(:cleaned, quote * 2)
+    assert_equal quote, job.send(:cleaned, quote)
+  end
+end
