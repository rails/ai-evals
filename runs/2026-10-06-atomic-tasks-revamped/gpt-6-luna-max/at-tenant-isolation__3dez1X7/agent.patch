+class AddTenantToUsersAndBooks < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    execute <<~SQL.squish
+      INSERT INTO tenants (name, created_at, updated_at)
+      VALUES (#{connection.quote("Writebook")}, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
+    SQL
+
+    tenant_id = select_value("SELECT id FROM tenants ORDER BY id DESC LIMIT 1")
+    execute "UPDATE users SET tenant_id = #{connection.quote(tenant_id.to_i)}"
+    execute "UPDATE books SET tenant_id = #{connection.quote(tenant_id.to_i)}"
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+    drop_table :tenants
+  end
+end
