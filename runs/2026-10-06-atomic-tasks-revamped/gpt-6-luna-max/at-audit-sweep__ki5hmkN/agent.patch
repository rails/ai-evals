diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..1239429
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "search returns matching pages from books the current user can read only" do
+    books(:handbook).press Section.new(body: "Member content"), title: "Member Needle"
+    books(:manual).press Section.new(body: "Private content"), title: "Private Needle"
+
+    get library_search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Member Needle/
+    assert_select "a.search__result", text: /Private Needle/, count: 0
+  end
+
+  test "search injection cannot return pages from unreadable books" do
+    books(:manual).press Section.new(body: "Private content"), title: "Private Needle"
+
+    get library_search_path, params: { q: "needle' OR 1=1 OR leaves.title LIKE '" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Private Needle/, count: 0
+  end
+
+  test "anonymous search only returns published books" do
+    sign_out
+    books(:manual).update!(published: true)
+    books(:manual).press Section.new(body: "Published content"), title: "Published Needle"
+    books(:handbook).press Section.new(body: "Private content"), title: "Unpublished Needle"
+
+    get library_search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Published Needle/
+    assert_select "a.search__result", text: /Unpublished Needle/, count: 0
+  end
+
+  test "search terms with apostrophes are treated as data" do
+    books(:handbook).press Section.new(body: "Writer notes"), title: "Writer's Notes"
+
+    get library_search_path, params: { q: "Writer's" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Writer's Notes/
+  end
+
+  test "percent signs are literal search characters" do
+    books(:handbook).press Section.new(body: "Discount"), title: "Save 50% off"
+    books(:handbook).press Section.new(body: "Similar discount"), title: "Save 50x off"
+
+    get library_search_path, params: { q: "Save 50% off" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Save 50% off/
+    assert_select "a.search__result", text: /Save 50x off/, count: 0
+
+    get library_search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Save 50% off/
+    assert_select "a.search__result", text: /Save 50x off/, count: 0
+  end
+
+  test "underscores are literal search characters" do
+    books(:handbook).press Section.new(body: "File name"), title: "File_name"
+    books(:handbook).press Section.new(body: "File name"), title: "FileXname"
+
+    get library_search_path, params: { q: "_" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /File_name/
+    assert_select "a.search__result", text: /FileXname/, count: 0
+  end
+end
