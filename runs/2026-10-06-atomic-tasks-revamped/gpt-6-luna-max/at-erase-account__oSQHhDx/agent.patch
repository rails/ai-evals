+    def blob_ids_for_private_books
+      book_ids = created_books.where(everyone_access: false).pluck(:id)
+      return [] if book_ids.empty?
+
+      leaves = Leaf.where(book_id: book_ids)
+      leaf_ids = leaves.pluck(:id)
+      records_by_type = Hash.new { |records, type| records[type] = [] }
+
+      (leaves.pluck(:leafable_type, :leafable_id) +
+        Edit.where(leaf_id: leaf_ids).pluck(:leafable_type, :leafable_id)).each do |type, id|
+        records_by_type[type] << id
+      end
+
+      records_by_type["Book"].concat(book_ids)
+      page_ids = records_by_type["Page"].uniq
+      if page_ids.present?
+        records_by_type["ActionText::Markdown"].concat(
+          ActionText::Markdown.where(record_type: "Page", record_id: page_ids).pluck(:id))
+      end
+
+      records_by_type.flat_map do |type, ids|
+        ActiveStorage::Attachment.where(record_type: type, record_id: ids.uniq).distinct.pluck(:blob_id)
+      end.uniq
+    end
+
