diff --git a/test/models/user_erasure_test.rb b/test/models/user_erasure_test.rb
new file mode 100644
index 0000000..e15e132
--- /dev/null
+++ b/test/models/user_erasure_test.rb
@@ -0,0 +1,141 @@
+require "test_helper"
+
+class UserErasureTest < ActiveSupport::TestCase
+  test "destroy erases user data while retaining and anonymizing shared books" do
+    user = create_user
+    public_book = create_book(user, everyone_access: true)
+    private_book = create_book(user, everyone_access: false)
+    public_reader = users(:jz)
+    public_book.accesses.create!(user: public_reader, level: :reader)
+    user.accesses.create!(book: public_book, level: :editor)
+    user.accesses.create!(book: private_book, level: :editor)
+    assert user.accesses.exists?(book: books(:manual))
+
+    public_term = "publicerasure#{SecureRandom.hex(6)}"
+    private_term = "privateerasure#{SecureRandom.hex(6)}"
+    public_leaf = create_searchable_leaf(public_book, public_term)
+    private_leaf = create_searchable_leaf(private_book, private_term)
+    historical_section = Section.create!(body: "historical private data")
+    private_leaf.edits.revision.create!(leafable: historical_section)
+    historical_section_id = historical_section.id
+
+    historical_page = create_page_with_upload("historical private page")
+    historical_page_id = historical_page.id
+    historical_blob_id = historical_page.body.uploads.blobs.first.id
+    private_leaf.edits.revision.create!(leafable: historical_page)
+
+    public_book.cover.attach(create_blob)
+    public_cover_blob_id = public_book.cover.blob.id
+
+    picture = Picture.create!(caption: "private picture")
+    picture.image.attach(create_blob)
+    picture_blob_id = picture.image.blob.id
+    picture_id = picture.id
+    private_book.press(picture, title: "Private picture")
+    private_book.cover.attach(create_blob)
+    cover_blob_id = private_book.cover.blob.id
+    private_page_leaf = private_book.press(Page.new(body: "private markdown page"), title: "Private page")
+    private_markdown = private_page_leaf.leafable.body
+    private_markdown.uploads.attach(create_blob)
+    private_markdown.save!
+    markdown_blob_id = private_markdown.uploads.blobs.first.id
+
+    ReadingMark.create!(user: user, leaf: public_leaf, last_read_at: Time.current)
+    ReadingMark.create!(user: user, leaf: private_leaf, last_read_at: Time.current)
+    session = user.sessions.create!(user_agent: "test", ip_address: "127.0.0.1")
+    original_email = user.email_address
+    user_id = user.id
+    public_book_id = public_book.id
+    private_book_id = private_book.id
+    private_leaf_id = private_leaf.id
+
+    # Ensure the has-many association is already loaded when destroy runs.
+    user.created_books.load
+
+    assert_includes Leaf.search(private_term).ids, private_leaf.id
+    private_leaf.leafable.update!(body: nil)
+    assert_includes Leaf.search(private_term).ids, private_leaf.id
+    assert_difference -> { User.count }, -1 do
+      user.destroy!
+    end
+
+    assert_raises(ActiveRecord::RecordNotFound) { User.find(user_id) }
+    assert_equal "Deleted author", Book.find(public_book_id).author
+    assert_nil Book.find(public_book_id).creator_id
+    assert Book.find(public_book_id).accessable?(user: public_reader)
+    assert_includes Leaf.search(public_term).ids, public_leaf.id
+    assert_nil Book.find_by(id: private_book_id)
+    assert_nil Leaf.find_by(id: private_leaf_id)
+    assert_empty Edit.where(leaf_id: private_leaf_id)
+    assert_nil Section.find_by(id: historical_section_id)
+    assert_nil Page.find_by(id: historical_page_id)
+    assert_nil Picture.find_by(id: picture_id)
+    assert_nil ActiveStorage::Blob.find_by(id: historical_blob_id)
+    assert_nil ActiveStorage::Blob.find_by(id: cover_blob_id)
+    assert_nil ActiveStorage::Blob.find_by(id: markdown_blob_id)
+    assert_nil ActiveStorage::Blob.find_by(id: picture_blob_id)
+    assert ActiveStorage::Blob.exists?(id: public_cover_blob_id)
+    assert Book.find(public_book_id).cover.attached?
+    assert_empty Access.where(user_id: user_id)
+    assert_empty Session.where(user_id: user_id)
+    assert_empty ReadingMark.where(user_id: user_id)
+    assert_empty SignInEvent.where(email_address: original_email)
+    assert_empty Leaf.search(private_term)
+    assert session.destroyed?
+  end
+
+  test "destroy removes sign-in events for the original address of a legacy deactivated user" do
+    user = create_user
+    original_email = user.email_address
+    deactivated_email = original_email.sub("@", "-deactivated-#{SecureRandom.uuid}@")
+    user.update_columns(active: false, email_address: deactivated_email)
+    SignInEvent.create!(email_address: original_email, action: :signed_in)
+    SignInEvent.create!(email_address: deactivated_email, action: :signed_out)
+
+    user.destroy!
+
+    assert_empty SignInEvent.where(email_address: original_email)
+    assert_empty SignInEvent.where(email_address: deactivated_email)
+  end
+
+  private
+    def create_blob
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("private erasure attachment"),
+        filename: "private-#{SecureRandom.hex(6)}.txt",
+        content_type: "text/plain"
+      )
+    end
+
+    def create_page_with_upload(body)
+      page = Page.create!(body: body)
+      markdown = page.body
+      markdown.uploads.attach(create_blob)
+      markdown.save!
+      page
+    end
+
+    def create_user
+      token = SecureRandom.hex(8)
+      User.create!(
+        name: "Erasure #{token}",
+        email_address: "erasure-#{token}@example.com",
+        password: "secret123456"
+      )
+    end
+
+    def create_book(user, everyone_access:)
+      token = SecureRandom.hex(8)
+      Book.create!(
+        title: "Erasure book #{token}",
+        author: user.name,
+        creator: user,
+        everyone_access: everyone_access
+      )
+    end
+
+    def create_searchable_leaf(book, searchable_term)
+      section = Section.new(body: searchable_term)
+      book.press(section, title: "Title #{searchable_term}").tap(&:reindex)
+    end
+end
