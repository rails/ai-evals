+++ b/app/models/book/access_import.rb
@@ -1,25 +1,85 @@
 class Book::AccessImport
   Result = Struct.new(:accesses, :duplicate_index)
 
+  RETURNING_ATTRIBUTES = %w[ id user_id book_id level created_at updated_at ].freeze
+
   def initialize(book, grants)
     @book, @grants = book, grants
   end
 
   def import
-    accesses = []
-    duplicate_index = nil
+    grants, rejection_index = prepare_grants
+    return Result.new([], rejection_index) if rejection_index
 
-    Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
+    begin
+      accesses = nil
+
+      Access.transaction do
+        inserted_rows = @book.accesses.insert_all!(
+          grants.map { |grant| { user_id: grant.user_id, level: grant.level } },
+          returning: RETURNING_ATTRIBUTES
+        )
+        accesses = build_accesses(inserted_rows)
       end
+    rescue ActiveRecord::RecordNotUnique
+      return Result.new([], first_duplicate_index)
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    accesses.each { |access| Book::AccessNotificationJob.perform_later(access) }
+    Result.new(accesses, nil)
   end
+
+  private
+    def prepare_grants
+      user_id_type = Access.type_for_attribute("user_id")
+      user_ids = @grants.map { |grant| user_id_type.cast(grant[:user_id]) }
+      existing_user_ids = if user_ids.any?
+        @book.accesses.where(user_id: user_ids).pluck(:user_id).to_h { |id| [ id, true ] }
+      else
+        {}
+      end
+      seen_user_ids = {}
+      grants = []
+
+      @grants.each_with_index do |grant, index|
+        level = grant[:level]
+        return [ nil, index ] unless Access.levels.key?(level.to_s)
+
+        access = Access.new(user_id: grant[:user_id], level: level, book: @book)
+        access.validate!
+
+        user_id = user_id_type.cast(access.user_id)
+        return [ nil, index ] if existing_user_ids.key?(user_id) || seen_user_ids.key?(user_id)
+
+        seen_user_ids[user_id] = true
+        grants << access
+      end
+
+      [ grants, nil ]
+    end
+
+    def build_accesses(inserted_rows)
+      user_id_type = Access.type_for_attribute("user_id")
+      rows_by_user_id = inserted_rows.to_a.index_by do |attributes|
+        user_id_type.cast(attributes.fetch("user_id"))
+      end
+
+      @grants.map do |grant|
+        user_id = user_id_type.cast(grant[:user_id])
+        Access.instantiate(rows_by_user_id.fetch(user_id))
+      end
+    end
+
+    def first_duplicate_index
+      user_id_type = Access.type_for_attribute("user_id")
+      user_ids = @grants.map { |grant| user_id_type.cast(grant[:user_id]) }
+      existing_user_ids = @book.accesses.where(user_id: user_ids).pluck(:user_id).to_h { |id| [ id, true ] }
+      seen_user_ids = {}
+
+      user_ids.each_with_index do |user_id, index|
+        return index if existing_user_ids.key?(user_id) || seen_user_ids.key?(user_id)
+
+        seen_user_ids[user_id] = true
+      end
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..1fbb658
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "imports grants with a constant number of access insert statements" do
+    recipients = create_recipients(16)
+    small_book = create_book
+    large_book = create_book
+
+    small_inserts = access_inserts do
+      @small_result = Book::AccessImport.new(small_book, grants_for(recipients.first(4))).import
+    end
+    large_inserts = access_inserts do
+      @large_result = Book::AccessImport.new(large_book, grants_for(recipients)).import
+    end
+
+    assert_equal 4, @small_result.accesses.length
+    assert_equal 16, @large_result.accesses.length
+    assert_equal 1, small_inserts.length
+    assert_equal small_inserts.length, large_inserts.length
+    assert @large_result.accesses.all?(&:persisted?)
+  end
+
+  test "a duplicate rejects the whole batch without notifying anyone" do
+    book = create_book
+    book.accesses.create!(user: users(:david), level: :reader)
+    recipients = create_recipients(3)
+    grants = grants_for(recipients).insert(1, { user_id: users(:david).id, level: :editor })
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, grants).import
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal 1, book.accesses.count
+  end
+
+  test "a duplicate within the roster is rejected at its first repeated row" do
+    book = create_book
+    recipients = create_recipients(2)
+    grants = grants_for(recipients)
+    grants << grants.first.merge(level: :editor)
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, grants).import
+    end
+
+    assert_equal 2, result.duplicate_index
+    assert_empty result.accesses
+    assert_empty book.accesses
+  end
+
+  test "duplicate rejection also uses a constant number of access insert statements" do
+    recipients = create_recipients(20)
+    small_book = create_book
+    large_book = create_book
+    small_book.accesses.create!(user: users(:david), level: :reader)
+    large_book.accesses.create!(user: users(:david), level: :reader)
+
+    small_inserts = access_inserts do
+      Book::AccessImport.new(small_book, grants_for(recipients.first(4)) + [ { user_id: users(:david).id, level: :reader } ]).import
+    end
+    large_inserts = access_inserts do
+      Book::AccessImport.new(large_book, grants_for(recipients) + [ { user_id: users(:david).id, level: :reader } ]).import
+    end
+
+    assert_empty small_inserts
+    assert_equal small_inserts.length, large_inserts.length
+  end
+
+  test "an unknown level rejects the entire roster at its row without notifying anyone" do
+    book = create_book
+    recipients = create_recipients(3)
+    grants = grants_for(recipients)
+    grants[1] = grants[1].merge(level: "administrator")
+
+    result = nil
+    inserts = access_inserts do
+      assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+        result = Book::AccessImport.new(book, grants).import
+      end
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_empty book.accesses
+    assert_empty inserts
+  end
+
+  test "an invalid user still raises validation errors without sending notifications" do
+    book = create_book
+    recipients = create_recipients(2)
+    grants = grants_for(recipients)
+    grants[1] = grants[1].merge(user_id: -1)
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      assert_raises(ActiveRecord::RecordInvalid) do
+        Book::AccessImport.new(book, grants).import
+      end
+    end
+
+    assert_empty book.accesses
+  end
+
+  test "successful import notifies each recipient" do
+    book = create_book
+    recipients = create_recipients(3)
+    book.accesses.load
+
+    assert_enqueued_jobs 3, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, grants_for(recipients)).import
+      assert_equal recipients.map(&:id), result.accesses.map(&:user_id)
+    end
+    assert_equal recipients.map(&:id), book.accesses.map(&:user_id)
+  end
+
+  private
+    def create_book
+      Book.create!(title: "Import #{SecureRandom.hex(8)}", everyone_access: false)
+    end
+
+    def create_recipients(count)
+      Array.new(count) do
+        User.create!(
+          name: "Import recipient #{SecureRandom.hex(8)}",
+          email_address: "#{SecureRandom.hex(8)}@example.com",
+          password_digest: "unused"
+        )
+      end
+    end
+
+    def grants_for(recipients)
+      recipients.map.with_index do |recipient, index|
+        { user_id: recipient.id, level: index.even? ? :reader : :editor }
+      end
+    end
+
+    def access_inserts
+      statements = []
+      subscriber = lambda do |_name, _start, _finish, _id, payload|
+        sql = payload[:sql]
+        statements << sql if sql.match?(/\A\s*INSERT\b/i) && sql.match?(/\baccesses\b/i)
+      end
+
+      ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+        yield
+      end
+
+      statements
+    end
+end
