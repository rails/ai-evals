diff --git a/test/test_helpers/raise_exceptions_middleware.rb b/test/test_helpers/raise_exceptions_middleware.rb
new file mode 100644
index 0000000..c015fa9
--- /dev/null
+++ b/test/test_helpers/raise_exceptions_middleware.rb
@@ -0,0 +1,25 @@
+module RailsTestSupport
+  RAISE_EXCEPTIONS_KEY = :rails_test_support_raise_exceptions
+
+  def self.with_raised_exceptions
+    previous = Thread.current[RAISE_EXCEPTIONS_KEY]
+    Thread.current[RAISE_EXCEPTIONS_KEY] = true
+    yield
+  ensure
+    Thread.current[RAISE_EXCEPTIONS_KEY] = previous
+  end
+
+  class RaiseExceptionsMiddleware
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      if Thread.current[RAISE_EXCEPTIONS_KEY]
+        env["action_dispatch.show_exceptions"] = :none
+      end
+
+      @app.call(env)
+    end
+  end
+end
