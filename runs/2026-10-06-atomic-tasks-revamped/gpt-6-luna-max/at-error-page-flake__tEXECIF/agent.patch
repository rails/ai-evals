 require "rails/test_help"
 
+module TestExceptionHandling
+  # Rails caches env_config, so exception mode must be overlaid per execution context.
+  SHOW_EXCEPTIONS_OVERRIDE_KEY = :test_action_dispatch_show_exceptions
+
+  module ApplicationEnvConfig
+    def env_config
+      base_env_config = super
+      show_exceptions = ActiveSupport::IsolatedExecutionState[SHOW_EXCEPTIONS_OVERRIDE_KEY]
+
+      if show_exceptions
+        base_env_config.merge("action_dispatch.show_exceptions" => show_exceptions)
+      else
+        base_env_config
+      end
+    end
+  end
+end
+
+Rails.application.singleton_class.prepend(TestExceptionHandling::ApplicationEnvConfig)
+
