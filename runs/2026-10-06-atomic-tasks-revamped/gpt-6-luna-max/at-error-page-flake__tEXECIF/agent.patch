+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "raised exceptions are isolated to their execution context" do
+    entered = Queue.new
+    continue = Queue.new
+    session = ActionDispatch::Integration::Session.new(Rails.application)
+
+    request = Thread.new do
+      with_raised_exceptions do
+        entered << true
+        continue.pop
