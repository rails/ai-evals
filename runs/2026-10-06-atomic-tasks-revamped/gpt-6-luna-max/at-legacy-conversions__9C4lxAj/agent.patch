+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest formats the last edited date" do
+    book = books(:handbook)
+    book.update_columns(published: true, updated_at: Time.zone.local(2024, 4, 5, 6, 7, 8))
+
+    mail = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_includes mail.body.decoded, "Handbook, last edited 05 Apr"
+  end
+end
