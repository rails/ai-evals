 require "test_helper"
 
 class PageTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  uses_transaction :test_destroy_purges_markdown_uploads
+
+  test "destroy purges markdown uploads" do
+    page = pages(:welcome)
+    markdown = page.body
+    markdown.uploads.attach io: file_fixture("reading.webp").open,
+      filename: "reading.webp", content_type: "image/webp"
+
+    attachment = markdown.uploads.attachments.last
+    markdown.update!(content: "![Reading](#{attachment.slug_path})")
+
+    blob = attachment.blob
+    service = blob.service
+    key = blob.key
+
+    assert service.exist?(key), "the uploaded file should exist before page destruction"
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not service.exist?(key), "the uploaded file should be removed after purge jobs finish"
+  end
+
