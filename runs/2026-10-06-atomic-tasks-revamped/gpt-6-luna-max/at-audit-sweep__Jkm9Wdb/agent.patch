diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..87869fb
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "search cannot reach books the current user cannot read through SQL injection" do
+    hidden_book = books(:manual)
+    hidden_book.update!(everyone_access: false)
+    hidden_book.press Page.new(body: "Confidential content"), title: "Confidential page"
+
+    get library_search_path, params: { q: "%' OR 1=1 OR leaves.title LIKE '%" }
+
+    assert_response :success
+    assert_not_in_body "Confidential page"
+  end
+
+  test "ordinary searches include published pages for signed-in and signed-out readers" do
+    public_book = books(:manual)
+    public_book.update!(published: true, everyone_access: false)
+    public_book.press Page.new(body: ""), title: "Public search result"
+
+    get library_search_path, params: { q: "Public search result" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Public search result/
+
+    sign_out
+    get library_search_path, params: { q: "Public search result" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Public search result/
+  end
+
+  test "a search term containing an apostrophe is treated as data" do
+    books(:handbook).press Page.new(body: ""), title: "The reader's note"
+
+    get library_search_path, params: { q: "reader's" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /The reader's note/
+  end
+
+  test "percent signs in search terms are literal" do
+    books(:handbook).press Page.new(body: ""), title: "Save 50% off"
+    books(:handbook).press Page.new(body: ""), title: "Save 50X off"
+
+    get library_search_path, params: { q: "Save 50% off" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Save 50% off/
+    assert_select "a.search__result", text: /Save 50X off/, count: 0
+
+    get library_search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Save 50% off/
+    assert_select "a.search__result", text: /Save 50X off/, count: 0
+  end
+
+  test "underscores in search terms are literal" do
+    books(:handbook).press Page.new(body: ""), title: "Release_v2 guide"
+    books(:handbook).press Page.new(body: ""), title: "Release-v2 guide"
+
+    get library_search_path, params: { q: "Release_v2" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Release_v2 guide/
+    assert_select "a.search__result", text: /Release-v2 guide/, count: 0
+
+    get library_search_path, params: { q: "_" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Release_v2 guide/
+    assert_select "a.search__result", text: /Release-v2 guide/, count: 0
+  end
+end
