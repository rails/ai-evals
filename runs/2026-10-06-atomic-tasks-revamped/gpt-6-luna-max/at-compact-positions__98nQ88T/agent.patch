@@ -0,0 +1,28 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compacting positions preserves the order of trashed leaves when they are restored" do
+    book = books(:handbook)
+    arranged_leaves = book.leaves.order(id: :desc).to_a
+
+    arranged_leaves.each.with_index(1) do |leaf, index|
+      leaf.update_columns(position_score: index * 10)
+    end
+
+    trashed_leaf = arranged_leaves.second
+    trashed_leaf.trashed!
+
+    book.compact_positions!
+
+    assert_equal arranged_leaves.length - 1, book.live_leaf_count
+    assert_equal (1..arranged_leaves.length).to_a, book.leaves.positioned.pluck(:position_score)
+
+    trashed_leaf.active!
+
+    assert_equal arranged_leaves, book.leaves.positioned.to_a
+  end
+
+  test "live leaf count is zero for a book without leaves" do
+    assert_equal 0, books(:manual).live_leaf_count
+  end
+end
