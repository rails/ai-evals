diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..c1dd491
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "search treats apostrophes as data" do
+    books(:handbook).press Section.new(body: ""), title: "Reader's guide"
+
+    get library_search_path, params: { q: "Reader's" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Reader's guide/
+  end
+
+  test "search input cannot expose results from unreadable books" do
+    private_leaf = books(:manual).press Section.new(body: ""), title: "Private page"
+
+    get library_search_path, params: { q: "' OR 1=1 --" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Private page/, count: 0
+  end
+
+  test "search only returns books the current user may read" do
+    books(:manual).press Section.new(body: ""), title: "Unlisted manual page"
+
+    get library_search_path, params: { q: "Unlisted manual page" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Unlisted manual page/, count: 0
+  end
+
+  test "search treats percent signs and underscores literally" do
+    books(:handbook).press Section.new(body: ""), title: "Save 50% off"
+    books(:handbook).press Section.new(body: ""), title: "Save 50X off"
+    books(:handbook).press Section.new(body: ""), title: "Use_under_score"
+    books(:handbook).press Section.new(body: ""), title: "UseXunderXscore"
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_select "a.search__result", text: /Save 50% off/
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_select "a.search__result", text: /Save 50% off/
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_select "a.search__result", text: /Use_under_score/
+  end
+
+  test "signed-out search can find titles in published books" do
+    books(:manual).update!(published: true)
+    books(:manual).press Section.new(body: ""), title: "Public manual page"
+    sign_out
+
+    get library_search_path, params: { q: "Public manual page" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Public manual page/
+  end
+end
