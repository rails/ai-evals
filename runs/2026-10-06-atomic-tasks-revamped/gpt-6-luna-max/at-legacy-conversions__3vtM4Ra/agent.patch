@@ -0,0 +1,12 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest formats the last-edited date" do
+    book = books(:handbook)
+    book.update_columns(published: true, updated_at: Time.zone.local(2025, 1, 2, 3, 4, 5))
+
+    message = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_includes message.body.encoded, "* Handbook, last edited 02 Jan"
+  end
+end
