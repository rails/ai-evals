+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  test "resumes after interruption without stripping legitimate inner quotes twice" do
+    leaves = Leaf.order(:id).to_a
+    original_titles = leaves.each_with_index.to_h do |leaf, index|
+      original_title = index.zero? ? '"a quoted phrase"' : "Title #{index}"
+      leaf.update_column(:title, %("#{original_title}"))
+      [ leaf.id, original_title ]
+    end
+
+    interrupted_leaf = leaves.second
+    job = TitleCleanupJob.new
+    job.define_singleton_method(:cleaned) do |title|
+      raise "simulated interruption" if title == interrupted_leaf.title
+
+      title.delete_prefix('"').delete_suffix('"')
+    end
+
+    assert_raises(RuntimeError) { job.perform }
+
+    progress = TitleCleanupProgress.find(TitleCleanupProgress::SINGLETON_ID)
+    assert_equal leaves.first.id, progress.last_leaf_id
+    assert_equal original_titles.fetch(leaves.first.id), leaves.first.reload.title
+    assert_equal %("#{original_titles.fetch(interrupted_leaf.id)}"), interrupted_leaf.reload.title
+
+    TitleCleanupJob.perform_now
+
+    leaves.each do |leaf|
+      assert_equal original_titles.fetch(leaf.id), leaf.reload.title
+    end
+    assert_equal leaves.last.id, progress.reload.last_leaf_id
+
+    # A completed rerun must not remove the legitimate quotes a second time.
+    TitleCleanupJob.perform_now
+    assert_equal %q("a quoted phrase"), leaves.first.reload.title
+  end
+
+  test "rolls back the title update when interrupted before checkpointing" do
+    leaf = Leaf.order(:id).first
+    leaf.update_column(:title, %q(""a quoted phrase""))
+    progress = TitleCleanupProgress.create_or_find_by!(id: TitleCleanupProgress::SINGLETON_ID)
+    interrupt_after_update = proc do
+      raise "simulated interruption" if id == leaf.id
+    end
+
+    Leaf.set_callback(:update, :after, interrupt_after_update)
+    begin
+      assert_raises(RuntimeError) { TitleCleanupJob.new.perform }
+    ensure
+      Leaf.skip_callback(:update, :after, interrupt_after_update)
+    end
+
+    assert_equal %q(""a quoted phrase""), leaf.reload.title
+    assert_nil progress.reload.last_leaf_id
+
+    TitleCleanupJob.perform_now
+
+    assert_equal %q("a quoted phrase"), leaf.reload.title
+  end
+end
