diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..cae25cc
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,151 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @users = 16.times.map do |index|
+      User.create!(
+        name: "Roster user #{index}",
+        email_address: "roster-user-#{index}@example.com",
+        password: "secret123456"
+      )
+    end
+  end
+
+  test "imports a roster with one database write and notifies each person" do
+    book = new_book
+    grants = @users.first(16).map { |user| { user_id: user.id, level: :reader } }
+    result = nil
+
+    writes = count_database_writes do
+      result = Book::AccessImport.new(book, grants).import
+    end
+
+    assert_equal 1, writes
+    assert_nil result.duplicate_index
+    assert_equal @users.first(16).map(&:id), result.accesses.map(&:user_id)
+    assert_equal 16, enqueued_jobs.size
+  end
+
+  test "a rejected duplicate roster is atomic and sends no notifications" do
+    book = new_book
+    book.accesses.create!(user: @users[2], level: :reader)
+    grants = @users.first(4).map { |user| { user_id: user.id, level: :editor } }
+    result = nil
+
+    writes = count_database_writes do
+      result = Book::AccessImport.new(book, grants).import
+    end
+
+    assert_equal 0, writes
+    assert_equal 2, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal [ @users[2].id ], book.accesses.pluck(:user_id)
+    assert_empty enqueued_jobs
+  end
+
+  test "rejects an unknown level at its row without writing or notifying" do
+    book = new_book
+    grants = [
+      { user_id: @users[0].id, level: :reader },
+      { user_id: @users[1].id, level: "unfamiliar" },
+      { user_id: @users[2].id, level: :editor }
+    ]
+    result = nil
+
+    writes = count_database_writes do
+      result = Book::AccessImport.new(book, grants).import
+    end
+
+    assert_equal 0, writes
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_empty book.accesses
+    assert_empty enqueued_jobs
+  end
+
+  test "preserves the association validation for unknown users" do
+    book = new_book
+    grants = [
+      { user_id: @users.first.id, level: :reader },
+      { user_id: -1, level: :reader }
+    ]
+
+    assert_raises(ActiveRecord::RecordInvalid) do
+      Book::AccessImport.new(book, grants).import
+    end
+
+    assert_empty book.accesses
+    assert_empty enqueued_jobs
+  end
+
+  test "write count stays constant for accepted rosters of different sizes" do
+    four_name_result, four_name_writes = accepted_roster_write_count(4)
+    sixteen_name_result, sixteen_name_writes = accepted_roster_write_count(16)
+
+    assert_equal 1, four_name_writes
+    assert_equal four_name_writes, sixteen_name_writes
+    assert_equal 4, four_name_result.accesses.size
+    assert_equal 16, sixteen_name_result.accesses.size
+  end
+
+  test "write count stays constant for rejected rosters of different sizes" do
+    four_name_result, four_name_writes = rejected_roster_write_count(4)
+    sixteen_name_result, sixteen_name_writes = rejected_roster_write_count(16)
+
+    assert_equal 0, four_name_writes
+    assert_equal four_name_writes, sixteen_name_writes
+    assert_equal 0, four_name_result.duplicate_index
+    assert_equal 0, sixteen_name_result.duplicate_index
+  end
+
+  test "empty rosters keep the empty successful result" do
+    result = Book::AccessImport.new(new_book, []).import
+
+    assert_empty result.accesses
+    assert_nil result.duplicate_index
+  end
+
+  private
+    def new_book
+      Book.create!(title: "Roster #{SecureRandom.hex(5)}", everyone_access: false)
+    end
+
+    def accepted_roster_write_count(size)
+      book = new_book
+      grants = @users.first(size).map { |user| { user_id: user.id, level: :reader } }
+      result = nil
+
+      writes = count_database_writes do
+        result = Book::AccessImport.new(book, grants).import
+      end
+
+      [ result, writes ]
+    end
+
+    def rejected_roster_write_count(size)
+      book = new_book
+      book.accesses.create!(user: @users.first, level: :reader)
+      grants = @users.first(size).map { |user| { user_id: user.id, level: :reader } }
+      result = nil
+
+      writes = count_database_writes do
+        result = Book::AccessImport.new(book, grants).import
+      end
+
+      [ result, writes ]
+    end
+
+    def count_database_writes
+      count = 0
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |_event, _start, _finish, _id, payload|
+        count += 1 if payload[:sql].match?(/\A\s*(?:INSERT|UPDATE|DELETE|REPLACE)\b/i)
+      end
+
+      yield
+      count
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+    end
+end
