diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..32fbaa9 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class BooksControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -114,4 +116,42 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "show reuses the background-generated picture variant" do
+    book = books(:manual)
+    book.update!(published: true)
+    picture = Picture.new
+    book.press picture, title: "A photograph"
+
+    perform_enqueued_jobs do
+      picture.image.attach io: file_fixture("reading.webp").open,
+        filename: "reading.webp", content_type: "image/webp"
+    end
+
+    blob = picture.image.blob
+    assert_equal 1, blob.variant_records.count
+    variant_bytes = blob.variant_records.sole.image.blob.download
+
+    transform_count = 0
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") do
+      transform_count += 1
+    end
+
+    get book_slug_path(book)
+
+    assert_response :success
+    assert_select ".toc__thumbnail img[src*='/rails/active_storage/representations/']", count: 1
+    image_src = css_select(".toc__thumbnail img[src*='/rails/active_storage/representations/']").sole["src"]
+
+    get URI.parse(image_src).path
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+
+    assert_equal 0, transform_count
+    assert_equal 1, blob.variant_records.count
+    assert_equal variant_bytes, response.body.b
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+  end
 end
