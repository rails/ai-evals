diff --git a/test/controllers/users_controller_test.rb b/test/controllers/users_controller_test.rb
index e0ca8db..b2a3b4c 100644
--- a/test/controllers/users_controller_test.rb
+++ b/test/controllers/users_controller_test.rb
@@ -61,15 +61,80 @@ class UsersControllerTest < ActionDispatch::IntegrationTest
     assert_not users(:kevin).reload.administrator?
   end
 
+  test "index shows deactivated users to admins so they can erase them" do
+    sign_in :david
+    user = users(:kevin)
+    user.update!(active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com")
+
+    get users_url
+
+    assert_response :success
+    assert_in_body "Kevin"
+    assert_in_body "(deactivated)"
+  end
+
   test "destroy" do
     sign_in :david
+    user = users(:kevin)
+    session = user.sessions.create!(ip_address: "127.0.0.1", user_agent: "test")
 
-    assert_difference -> { User.active.count }, -1 do
-      delete user_url(users(:kevin))
+    assert_difference -> { User.count }, -1 do
+      delete user_url(user)
+    end
+
+    assert_redirected_to users_url
+    assert_nil User.find_by(id: user.id)
+    assert_not Session.exists?(id: session.id)
+    assert_not SignInEvent.exists?(email_address: user.email_address)
+  end
+
+  test "destroy erases deactivated users and their private books but keeps shared books" do
+    user = users(:kevin)
+    original_email = user.email_address
+    rewritten_email = original_email.sub("@", "-deactivated-#{SecureRandom.uuid}@")
+    public_book = Book.create!(title: "Public book to keep", author: user.name, creator: user, everyone_access: true)
+    public_book.update_access(editors: [], readers: [ user.id, users(:jz).id ])
+    public_leaf = public_book.press(Section.new(body: "publicerasureword"), title: "Public chapter")
+
+    private_book = Book.create!(title: "Private book to erase", creator: user, everyone_access: false)
+    private_section = Section.new(body: "privateerasureword")
+    private_leaf = private_book.press(private_section, title: "Private chapter")
+    private_leaf.reindex
+    private_leaf.leafable.update!(body: nil)
+    assert_includes Leaf.search("privateerasureword").map(&:id), private_leaf.id
+    historical_page = Page.create!(body: "privatehistoryword")
+    private_leaf.edits.revision.create!(leafable: historical_page)
+    private_leaf.trashed!
+
+    ReadingMark.create!(user: user, leaf: public_leaf, last_read_at: Time.current)
+    SignInEvent.create!(email_address: original_email, action: :signed_in)
+    user.update!(active: false, email_address: rewritten_email)
+    SignInEvent.create!(email_address: rewritten_email, action: :signed_out)
+    unrelated_event = SignInEvent.create!(email_address: "unrelated@example.com", action: :signed_in)
+
+    sign_in :david
+    assert_difference -> { User.count }, -1 do
+      delete user_url(user)
     end
 
     assert_redirected_to users_url
-    assert_nil User.active.find_by(id: users(:kevin).id)
+    assert_nil User.find_by(id: user.id)
+    assert_nil Book.find_by(id: private_book.id)
+    assert_nil Leaf.find_by(id: private_leaf.id)
+    assert_nil Page.find_by(id: historical_page.id)
+    assert_nil Section.find_by(id: private_section.id)
+    assert_nil ReadingMark.find_by(user_id: user.id)
+    assert_nil Access.find_by(user_id: user.id)
+    assert_empty SignInEvent.where(email_address: [ original_email, rewritten_email ])
+    assert SignInEvent.exists?(id: unrelated_event.id)
+
+    assert_equal "Deleted author", public_book.reload.author
+    assert_nil public_book.creator_id
+    assert public_book.everyone_access?
+    assert Access.exists?(user_id: users(:jz).id, book_id: public_book.id)
+    assert_includes Leaf.search("publicerasureword").map(&:id), public_leaf.id
+    assert_empty Leaf.search("privateerasureword")
+    assert_equal 0, Leaf.connection.select_value("SELECT COUNT(*) FROM leaf_search_index WHERE rowid = #{private_leaf.id}")
   end
 
