+  test "destroying a page purges its markdown uploads" do
+    page = Page.create!(body: "![reading.webp](/u/reading.webp)")
+    markdown = page.body
+
+    File.open(Rails.root.join("test/fixtures/files/reading.webp")) do |file|
+      markdown.uploads.attach(io: file, filename: "reading.webp", content_type: "image/webp")
+    end
+
+    attachment = markdown.uploads.attachments.last
+    blob = attachment.blob
+    storage_service = blob.service
+    storage_key = blob.key
+
+    markdown.update!(content: "![reading.webp](#{attachment.slug_path})")
+    assert storage_service.exist?(storage_key), "expected the uploaded file to exist before page deletion"
+
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) do
+      page.destroy!
+    end
+
+    assert_not ActionText::Markdown.exists?(markdown.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not storage_service.exist?(storage_key)
+  ensure
+    page&.destroy! if page&.persisted?
+    if blob&.persisted?
+      blob.attachments.each(&:destroy!)
+      blob.purge
+    end
+  end
+
