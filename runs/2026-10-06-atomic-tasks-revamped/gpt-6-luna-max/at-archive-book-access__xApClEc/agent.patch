diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..20b9bc1 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,24 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy archives the current accesses and removes the book and grants" do
+    book = books(:handbook)
+    book_id = book.id
+    accesses(:david_handbook).destroy!
+    accesses(:jason_handbook).update!(level: :reader)
+
+    expected_archives = book.accesses.includes(:user).map do |access|
+      [ access.user_id, access.user.name, access.level ]
+    end.sort
+
+    assert_difference -> { AccessArchive.count }, expected_archives.length do
+      delete book_path(book)
+    end
+
+    assert_redirected_to root_url
+    assert_not Book.exists?(book_id)
+    assert_empty Access.where(book_id: book_id)
+    assert_equal expected_archives, AccessArchive.where(book_id: book_id).pluck(:user_id, :user_name, :level).sort
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..da3d6a2 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,36 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroy archives accesses after deleting the book" do
+    book = books(:handbook)
+    statements = []
+    subscriber = ->(*arguments) do
+      sql = arguments.last[:sql]
+      statements << sql if sql.match?(/\A(?:DELETE FROM|INSERT INTO)/i)
+    end
+
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      book.destroy!
+    end
+
+    book_deletion = statements.index { |sql| sql.match?(/\ADELETE FROM ["`]?books["`]?/i) }
+    archive_insertion = statements.index { |sql| sql.match?(/\AINSERT INTO ["`]?access_archives["`]?/i) }
+
+    assert_not_nil book_deletion, statements.join("\n")
+    assert_not_nil archive_insertion, statements.join("\n")
+    assert_operator archive_insertion, :>, book_deletion
+  end
+
+  test "destroying a book with no accesses creates no access archives" do
+    book = Book.create!(title: "No access")
+    book_id = book.id
+
+    assert_no_difference -> { AccessArchive.where(book_id: book_id).count } do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book_id)
+    assert_empty Access.where(book_id: book_id)
+  end
 end
