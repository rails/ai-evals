diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..fee0ae2 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,17 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_update :schedule_publication_announcement, if: -> { will_save_change_to_published?(to: true) }
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    def schedule_publication_announcement
+      book_class = self.class
+      book_id = id
+
+      self.class.current_transaction.after_commit do
+        book = book_class.find_by(id: book_id)
+        AnnouncePublicationJob.perform_later book if book&.published?
+      end
     end
 end
diff --git a/test/controllers/books/publications_controller_test.rb b/test/controllers/books/publications_controller_test.rb
