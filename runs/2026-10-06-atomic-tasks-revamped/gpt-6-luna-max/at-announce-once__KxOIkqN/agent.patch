@@ -17,6 +17,63 @@ class Books::PublicationsTest < ActionDispatch::IntegrationTest
     assert_equal "manual", @book.slug
   end
 
+  test "publishing and adding a page announces exactly once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: {
+        book: { published: "1" },
+        added_pages: [ "An additional page" ]
+      }
+    end
+
+    assert @book.reload.published?
+    assert_equal [ "An additional page" ], @book.leaves.pluck(:title)
+  end
+
+  test "saving an already-live book does not announce again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: {
+        book: { published: "1" },
+        added_pages: [ "Another page" ]
+      }
+    end
+  end
+
+  test "saving a draft does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: {
+        book: { slug: "revised-manual" },
+        added_pages: [ "A draft page" ]
+      }
+    end
+  end
+
+  test "unpublishing a book does not announce" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "0" } }
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "a failed publication sitting rolls back without announcing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: {
+        book: { published: "1" },
+        added_pages: [ "A page that will be rolled back" ],
+        trashed_page_ids: [ "missing-leaf" ]
+      }
+      assert_response :not_found
+    end
+
+    @book.reload
+    assert_not @book.published?
+    assert_empty @book.leaves
+  end
+
