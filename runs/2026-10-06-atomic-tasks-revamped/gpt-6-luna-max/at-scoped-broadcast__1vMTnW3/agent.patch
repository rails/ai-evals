diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..7d8b399 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class LeafablesControllerTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+  include ActiveJob::TestHelper
   setup do
     sign_in :kevin
   end
@@ -117,4 +119,70 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "edit subscribes to the current user's being edited stream" do
+    leaf = leaves(:welcome_page)
+
+    get edit_book_page_path(books(:handbook), leaf)
+
+    assert_response :success
+    assert_select "turbo-cable-stream-source[signed-stream-name='#{signed_being_edited_stream(users(:kevin), leaf)}']"
+  end
+
+  test "update broadcasts the being edited indicator to current editors" do
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+    book.update_access(editors: [ users(:kevin).id, users(:jz).id ], readers: [])
+
+    perform_enqueued_jobs do
+      update_page(leaf)
+    end
+
+    assert_broadcasts being_edited_stream_name(users(:kevin), leaf), 1
+    assert_broadcasts being_edited_stream_name(users(:jz), leaf), 1
+    assert_broadcasts being_edited_stream_name(users(:david), leaf), 1
+    assert_broadcasts being_edited_stream_name(users(:jason), leaf), 1
+    assert_includes broadcasts(being_edited_stream_name(users(:jz), leaf)).first, "Kevin"
+  end
+
+  test "update stops broadcasting to an editor removed from the book" do
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+    removed_editor = users(:jz)
+    book.update_access(editors: [ users(:kevin).id, removed_editor.id ], readers: [])
+
+    sign_out
+    sign_in removed_editor
+    get edit_book_page_path(book, leaf)
+    assert_response :success
+    assert_select "turbo-cable-stream-source[signed-stream-name='#{signed_being_edited_stream(removed_editor, leaf)}']"
+
+    sign_out
+    sign_in :kevin
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+
+    perform_enqueued_jobs do
+      update_page(leaf)
+    end
+
+    assert_broadcasts being_edited_stream_name(users(:kevin), leaf), 1
+    assert_no_broadcasts being_edited_stream_name(removed_editor, leaf)
+    assert_no_broadcasts being_edited_stream_name(leaf)
+  end
+
+  private
+    def update_page(leaf)
+      patch book_page_path(leaf.book, leaf, format: :turbo_stream), params: {
+        leaf: { title: leaf.title }, page: { body: "Updated content" }
+      }
+      assert_response :success
+    end
+
+    def signed_being_edited_stream(*streamables)
+      Turbo::StreamsChannel.signed_stream_name([ *streamables, :being_edited ])
+    end
+
+    def being_edited_stream_name(*streamables)
+      Turbo.signed_stream_verifier.verified(signed_being_edited_stream(*streamables))
+    end
 end
