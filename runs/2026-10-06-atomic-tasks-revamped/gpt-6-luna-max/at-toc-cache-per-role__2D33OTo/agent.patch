diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..8c3e096 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -79,6 +79,65 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
   end
 
+  test "show does not reuse editor controls in the table of contents for readers" do
+    with_fragment_caching do
+      get book_slug_path(books(:handbook))
+      assert_edit_controls
+
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_read_only_controls
+    end
+  end
+
+  test "show does not reuse a reader's table of contents for editors" do
+    with_fragment_caching do
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_read_only_controls
+
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_edit_controls
+    end
+  end
+
+  test "show refreshes a renamed table of contents entry for the next visitor" do
+    with_fragment_caching do
+      get book_slug_path(books(:handbook))
+      assert_in_body "Welcome to The Handbook!"
+
+      travel 1.second do
+        leaves(:welcome_page).update!(title: "A Newly Named Page")
+      end
+
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+
+      assert_response :success
+      assert_in_body "A Newly Named Page"
+      assert_not_in_body "Welcome to The Handbook!"
+    end
+  end
+
+  test "show checks the current user's editing access once for the whole table of contents" do
+    with_fragment_caching do
+      access_queries = []
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |_name, _start, _finish, _id, payload|
+        access_queries << payload[:sql] if payload[:sql].match?(/FROM ["`]accesses["`]/i)
+      end
+
+      begin
+        get book_slug_path(books(:handbook))
+      ensure
+        ActiveSupport::Notifications.unsubscribe(subscriber)
+      end
+
+      assert_response :success
+      assert_equal 1, access_queries.length, access_queries.join("\n")
+    end
+  end
+
   test "show includes OG metadata for public access" do
     get book_slug_url(books(:handbook))
     assert_response :success
@@ -114,4 +173,36 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  private
+    def with_fragment_caching
+      cache_store = ActiveSupport::Cache::MemoryStore.new
+      original_perform_caching = BooksController.perform_caching
+      original_cache_store = BooksController.cache_store
+      original_collection_cache = ActionView::PartialRenderer.collection_cache
+
+      BooksController.perform_caching = true
+      BooksController.cache_store = cache_store
+      ActionView::PartialRenderer.collection_cache = cache_store
+
+      yield
+    ensure
+      BooksController.perform_caching = original_perform_caching
+      BooksController.cache_store = original_cache_store
+      ActionView::PartialRenderer.collection_cache = original_collection_cache
+    end
+
+    def assert_edit_controls
+      assert_response :success
+      assert_select ".toc__leaf a.hide_from_reading_mode[href*='/edit']", count: 8
+      assert_select ".toc__leaf form.leaf__delete", count: 4
+      assert_select ".toc__leaf .arrangement__handle", count: 4
+    end
+
+    def assert_read_only_controls
+      assert_response :success
+      assert_select ".toc__leaf a[href*='/edit']", count: 0
+      assert_select ".toc__leaf form.leaf__delete", count: 0
+      assert_select ".toc__leaf .arrangement__handle", count: 0
+    end
 end
