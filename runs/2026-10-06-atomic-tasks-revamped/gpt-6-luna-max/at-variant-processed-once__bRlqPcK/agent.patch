+  test "serves a preprocessed picture without processing it again" do
+    leaf = leaves(:reading_picture)
+    picture = leaf.leafable
+    transform_count = 0
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") do
+      transform_count += 1
+    end
+
+    perform_enqueued_jobs do
+      picture.image.attach io: file_fixture("white-rabbit.webp").open,
+        filename: "white-rabbit.webp", content_type: "image/webp"
+    end
+
+    source_blob = picture.image.blob
+    variant_records = source_blob.variant_records.includes(image_attachment: :blob)
+
+    assert_equal 1, transform_count
+    assert_equal 1, variant_records.length
+    derived_blob = variant_records.first.image.blob
+    derived_bytes = derived_blob.download
+
+    get leafable_slug_path(leaf)
+
+    assert_response :success
+    image_src = css_select("figure.page--picture img").first["src"]
+    assert_equal 1, transform_count, "rendering the page should not process the variant"
+
+    get URI.parse(image_src).request_uri
+    assert_response :redirect
+    get URI.parse(response.location).request_uri
+
+    assert_response :success
+    assert_equal derived_bytes, response.body
+    assert_equal 1, transform_count, "fetching the image should use the preprocessed variant"
+    assert_equal 1, source_blob.variant_records.reload.count
+    assert derived_blob.service.exist?(derived_blob.key), "the single derived image should be stored"
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+  end
+
