+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compacting positions preserves manual order including trashed leaves" do
+    book = books(:handbook)
+    leaves_by_id = book.leaves.order(:id).to_a
+
+    leaves_by_id.each_with_index do |leaf, index|
+      leaf.update_column(:position_score, leaves_by_id.length - index)
+    end
+
+    trashed_leaf = leaves_by_id.second
+    trashed_leaf.update_column(:status, "trashed")
+    expected_order = book.leaves.positioned.ids
+
+    book.compact_positions!
+
+    assert_equal expected_order, book.leaves.positioned.ids
+    assert_equal (1..leaves_by_id.length).to_a, book.leaves.positioned.pluck(:position_score)
+
+    trashed_leaf.active!
+
+    assert_equal expected_order, book.leaves.positioned.ids
+  end
+
+  test "live_leaf_count counts only leaves that are not in the trash" do
+    book = books(:handbook)
+    leaves(:welcome_page).update_column(:status, "trashed")
+
+    assert_equal 3, book.live_leaf_count
+  end
+end
