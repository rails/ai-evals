@@ -0,0 +1,12 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest formats last edited dates" do
+    book = books(:handbook)
+    book.update_columns(published: true, updated_at: Time.utc(2024, 5, 6, 7, 8, 9))
+
+    mail = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_includes mail.body.encoded, "* Handbook, last edited 06 May"
+  end
+end
