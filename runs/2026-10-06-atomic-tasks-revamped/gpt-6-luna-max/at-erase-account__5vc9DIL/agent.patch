diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..40eb68d 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,59 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "destroy erases user data and private books while anonymizing shared books" do
+    user = User.create!(name: "Former Author", email_address: "former-author@example.com", password: "secret123456")
+
+    shared_book = Book.create!(title: "Former Author's Shared Book", author: "Former Author", creator: user, everyone_access: true)
+    private_book = Book.create!(title: "Former Author's Private Book", author: "Former Author", creator: user, everyone_access: false)
+    shared_book.update_access(editors: [], readers: User.active.ids)
+    private_book.update_access(editors: [ user.id ], readers: [])
+    user.created_books.load
+
+    shared_section = Section.new(body: "sharederasuresearchtoken")
+    shared_leaf = shared_book.press(shared_section, title: "Shared erasure search token")
+    private_section = Section.new(body: "privateerasuresearchtoken")
+    private_leaf = private_book.press(private_section, title: "Private erasure search token")
+    old_revision = Section.create!(body: "oldprivateerasuresearchtoken")
+    private_leaf.edits.revision.create!(leafable: old_revision)
+
+    shared_leaf.reindex
+    private_leaf.reindex
+
+    ReadingMark.create!(user: user, leaf: shared_leaf, last_read_at: Time.current)
+    ReadingMark.create!(user: user, leaf: private_leaf, last_read_at: Time.current)
+    user.sessions.create!(ip_address: "192.0.2.1", user_agent: "erasure test")
+
+    other_event = SignInEvent.create!(email_address: users(:jason).email_address, action: :signed_in, created_at: Time.current)
+
+    user_id = user.id
+    user_email = user.email_address
+    private_book_id = private_book.id
+    private_leaf_id = private_leaf.id
+    private_section_id = private_section.id
+    old_revision_id = old_revision.id
+
+    user.destroy!
+
+    assert_nil User.find_by(id: user_id)
+    assert_nil Book.find_by(id: private_book_id)
+    assert_nil Leaf.find_by(id: private_leaf_id)
+    assert_nil Section.find_by(id: private_section_id)
+    assert_nil Section.find_by(id: old_revision_id), "revision content should not be orphaned"
+    assert_empty Edit.where(leaf_id: private_leaf_id)
+    assert_empty Session.where(user_id: user_id)
+    assert_empty Access.where(user_id: user_id)
+    assert_empty ReadingMark.where(user_id: user_id)
+    assert_empty SignInEvent.where(email_address: user_email)
+    assert_equal other_event, SignInEvent.find(other_event.id)
+
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+    assert shared_book.accessable?(user: users(:jason)), "other people should keep reading the shared book"
+    assert_equal "sharederasuresearchtoken", shared_leaf.reload.section.body
+    assert_includes Leaf.search("sharederasuresearchtoken"), shared_leaf
+    assert_empty Leaf.search("privateerasuresearchtoken")
+  end
 end
