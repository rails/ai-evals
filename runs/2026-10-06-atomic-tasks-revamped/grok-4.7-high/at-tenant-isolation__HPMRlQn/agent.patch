new file mode 100644
index 0000000..60ac169
--- /dev/null
+++ b/db/migrate/20261008003000_create_tenants.rb
@@ -0,0 +1,28 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true, type: :integer
+    add_reference :books, :tenant, foreign_key: true, type: :integer
+
+    reversible do |dir|
+      dir.up { sweep_existing_records_into_one_tenant }
+    end
+  end
+
+  private
+    def sweep_existing_records_into_one_tenant
+      now = Time.current
+      execute <<~SQL.squish
+        INSERT INTO tenants (name, created_at, updated_at)
+        VALUES (#{connection.quote("Writebook")}, #{connection.quote(now)}, #{connection.quote(now)})
+      SQL
+
+      tenant_id = select_value("SELECT id FROM tenants ORDER BY id DESC LIMIT 1").to_i
+      execute "UPDATE users SET tenant_id = #{tenant_id}"
+      execute "UPDATE books SET tenant_id = #{tenant_id}"
+    end
+end
