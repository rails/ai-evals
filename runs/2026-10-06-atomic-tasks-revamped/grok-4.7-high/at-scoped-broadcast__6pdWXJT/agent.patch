diff --git a/test/controllers/being_edited_indicator_test.rb b/test/controllers/being_edited_indicator_test.rb
new file mode 100644
index 0000000..682f87f
--- /dev/null
+++ b/test/controllers/being_edited_indicator_test.rb
@@ -0,0 +1,146 @@
+require "test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  setup do
+    @leaf = leaves(:welcome_page)
+    @book = books(:handbook)
+  end
+
+  test "open editors see who is editing, but a removed collaborator does not" do
+    kevin_stream = open_editor_stream(:kevin)
+    david_stream = open_editor_stream(:david)
+    jason_stream = open_editor_stream(:jason)
+
+    sign_in :david
+    perform_enqueued_jobs { update_page("David is editing") }
+
+    assert_presence kevin_stream, "David"
+    assert_presence david_stream, "David"
+    assert_presence jason_stream, "David"
+    clear_presence_broadcasts
+
+    @book.access_for(user: users(:kevin)).destroy!
+
+    sign_in :kevin
+    put leafable_path(@leaf), params: { page: { body: "Should be forbidden" } }
+    assert_response :not_found
+
+    sign_in :jason
+    perform_enqueued_jobs { update_page("Jason is editing") }
+
+    assert_no_presence kevin_stream
+    assert_presence david_stream, "Jason"
+    assert_presence jason_stream, "Jason"
+    assert_equal david_stream, open_editor_stream(:david)
+    assert_no_turbo_stream_broadcasts [ @leaf, :being_edited ]
+  end
+
+  test "demoted editor no longer receives presence on an editor left open" do
+    kevin_stream = open_editor_stream(:kevin)
+    david_stream = open_editor_stream(:david)
+
+    @book.access_for(user: users(:kevin)).update!(level: :reader)
+
+    sign_in :david
+    perform_enqueued_jobs { update_page("Still editing") }
+
+    assert_no_presence kevin_stream
+    assert_presence david_stream, "David"
+  end
+
+  test "administrators who can still edit receive presence even without editor access" do
+    @book.access_for(user: users(:jason)).update!(level: :reader)
+    jason_stream = open_editor_stream(:jason)
+
+    sign_in :david
+    perform_enqueued_jobs { update_page("Admin reader still editing") }
+
+    assert_presence jason_stream, "David"
+  end
+
+  test "removed administrator does not receive presence for an unpublished book" do
+    jason_stream = open_editor_stream(:jason)
+    @book.access_for(user: users(:jason)).destroy!
+
+    sign_in :david
+    perform_enqueued_jobs { update_page("After admin removal") }
+
+    assert_no_presence jason_stream
+    assert_no_turbo_stream_broadcasts [ @leaf, :being_edited, users(:jason) ]
+  end
+
+  test "administrator of a published book still receives presence without an access record" do
+    @book.update!(published: true)
+    @book.access_for(user: users(:jason)).destroy!
+    jason_stream = open_editor_stream(:jason)
+
+    sign_in :david
+    perform_enqueued_jobs { update_page("Published book") }
+
+    assert_presence jason_stream, "David"
+  end
+
+  test "readers never receive editor names" do
+    sign_in :david
+    perform_enqueued_jobs { update_page("Editors only") }
+
+    assert_no_presence stream_for(users(:jz))
+    assert_no_turbo_stream_broadcasts [ @leaf, :being_edited ]
+  end
+
+  test "non-admin removed from a published book does not receive presence" do
+    @book.update!(published: true)
+    kevin_stream = open_editor_stream(:kevin)
+    david_stream = open_editor_stream(:david)
+
+    @book.access_for(user: users(:kevin)).destroy!
+
+    sign_in :kevin
+    get leafable_slug_path(@leaf)
+    assert_response :ok
+    get edit_leafable_path(@leaf)
+    assert_response :forbidden
+
+    sign_in :david
+    perform_enqueued_jobs { update_page("Published, kevin removed") }
+
+    assert_no_presence kevin_stream
+    assert_presence david_stream, "David"
+  end
+
+  private
+    def open_editor_stream(user, leaf = @leaf)
+      sign_in user
+      get edit_leafable_path(leaf)
+      assert_response :ok
+
+      source = css_select("turbo-cable-stream-source").sole
+      Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    end
+
+    def update_page(body)
+      put leafable_path(@leaf), params: { page: { body: body } }
+      assert_response :no_content
+    end
+
+    def assert_presence(stream, name)
+      elements = capture_turbo_stream_broadcasts(stream)
+      assert_equal 1, elements.size, "expected one presence payload on #{stream}"
+      rendered = elements.map(&:to_html).join
+      assert_includes rendered, name
+      assert_includes rendered, "being-edited-by"
+    end
+
+    def stream_for(user, leaf = @leaf)
+  signed = Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited, user ])
+  Turbo.signed_stream_verifier.verified(signed)
+end
+
+    def assert_no_presence(stream)
+      assert_no_turbo_stream_broadcasts stream
+    end
+
+    def clear_presence_broadcasts
+      ActionCable.server.pubsub.clear
+    end
+end
