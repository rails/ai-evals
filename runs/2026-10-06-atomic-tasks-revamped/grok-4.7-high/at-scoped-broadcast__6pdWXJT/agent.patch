@@ -32,6 +32,13 @@ module Book::Accessable
     accesses.find_by(user: user)
   end
 
+  # People who can open the editor right now. Presence is delivered on a
+  # per-user stream so a collaborator removed while their editor is still
+  # open is not listening on a channel we continue to publish to.
+  def users_who_can_edit
+    User.where(id: user_ids_who_can_edit)
+  end
+
   def update_access(editors:, readers:)
     editors = Set.new(editors)
     readers = Set.new(everyone_access? ? User.active.ids : readers)
@@ -44,4 +51,15 @@ module Book::Accessable
     accesses.upsert_all(all_accesses, unique_by: [ :book_id, :user_id ])
     accesses.where.not(user_id: all).delete_all
   end
+
+  private
+    def user_ids_who_can_edit
+      accesses.editor.pluck(:user_id) | administrator_ids_who_can_access
+    end
+
+    def administrator_ids_who_can_access
+      administrators = User.administrator
+      administrators = administrators.where(id: accesses.select(:user_id)) unless published?
+      administrators.ids
+    end
 end
