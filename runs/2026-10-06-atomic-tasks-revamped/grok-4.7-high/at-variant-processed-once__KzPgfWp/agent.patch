+++ b/test/controllers/picture_derivatives_test.rb
@@ -0,0 +1,145 @@
+require "test_helper"
+
+class PictureDerivativesTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "upload is derived once and readers do not convert it again" do
+    leaf = leaves(:reading_picture)
+    put leafable_path(leaf), params: {
+      picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+    }
+    assert_response :no_content
+
+    leaf.reload
+    picture = leaf.picture
+    blob = picture.image.blob
+
+    assert_equal 0, blob.variant_records.count
+
+    transforms = 0
+    ActiveSupport::Notifications.subscribed(->(*) { transforms += 1 }, "transform.active_storage") do
+      drain_background_jobs
+    end
+    assert_equal 1, transforms, "background work should derive the upload once"
+    assert_equal 1, blob.variant_records.reload.count
+    assert_derived_file_exists blob
+
+    served = nil
+    ActiveSupport::Notifications.subscribed(->(*) { transforms += 1 }, "transform.active_storage") do
+      get leafable_slug_path(leaf)
+      assert_response :success
+
+      src = css_select("figure.page--picture img").first["src"]
+      served = fetch_image(src)
+
+      get book_slug_path(leaf.book)
+      assert_response :success
+      thumb = css_select("img[src*='representations']").first
+      assert_equal served, fetch_image(thumb["src"])
+    end
+
+    assert_equal 1, transforms, "opening the book and fetching the picture must not convert again"
+    assert_equal 1, blob.variant_records.reload.count
+    assert_equal expected_reader_bytes(blob), served
+  end
+
+  test "a reader who arrives before the background job still leaves a single derived copy" do
+    leaf = leaves(:reading_picture)
+    put leafable_path(leaf), params: {
+      picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+    }
+    assert_response :no_content
+    leaf.reload
+    blob = leaf.picture.image.blob
+
+    transforms = 0
+    served = nil
+    ActiveSupport::Notifications.subscribed(->(*) { transforms += 1 }, "transform.active_storage") do
+      get leafable_slug_path(leaf)
+      served = fetch_image(css_select("figure.page--picture img").first["src"])
+      drain_background_jobs
+      get leafable_slug_path(leaf)
+      assert_equal served, fetch_image(css_select("figure.page--picture img").first["src"])
+    end
+
+    assert_equal 1, transforms
+    assert_equal 1, blob.variant_records.reload.count
+    assert_equal expected_reader_bytes(blob), served
+    assert_derived_file_exists blob
+  end
+
+  test "a jpeg upload is derived once to the same webp readers already receive" do
+    jpeg = ImageProcessing::Vips.source(file_fixture("white-rabbit.webp")).convert("jpeg").call
+    leaf = leaves(:reading_picture)
+
+    put leafable_path(leaf), params: {
+      picture: { image: fixture_file_upload(jpeg, "image/jpeg") }
+    }
+    assert_response :no_content
+
+    leaf.reload
+    blob = leaf.picture.image.blob
+    assert_equal "image/jpeg", blob.content_type
+
+    transforms = 0
+    served = nil
+    ActiveSupport::Notifications.subscribed(->(*) { transforms += 1 }, "transform.active_storage") do
+      drain_background_jobs
+      get leafable_slug_path(leaf)
+      served = fetch_image(css_select("figure.page--picture img").first["src"])
+    end
+
+    assert_equal 1, transforms
+    assert_equal 1, blob.variant_records.reload.count
+    assert_equal expected_reader_bytes(blob), served
+    assert_derived_file_exists blob
+  end
+
+  test "pictures that cannot be resized are not derived" do
+    leaf = leaves(:reading_picture)
+    put leafable_path(leaf), params: {
+      picture: { image: fixture_file_upload("pixel.bmp", "image/bmp") }
+    }
+    assert_response :no_content
+
+    leaf.reload
+    blob = leaf.picture.image.blob
+    drain_background_jobs
+
+    assert_equal 0, blob.variant_records.count
+    assert_not blob.representable?
+
+    get leafable_slug_path(leaf)
+    assert_response :success
+    assert_select "figure img[src*='pixel.bmp']"
+  end
+
+  private
+    def drain_background_jobs
+      perform_enqueued_jobs while enqueued_jobs.any?
+    end
+
+    def fetch_image(src)
+      get src
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+      assert_equal "image/webp", response.media_type
+      response.body
+    end
+
+    def expected_reader_bytes(blob)
+      variation = ActiveStorage::Variation.new(format: "webp", resize_to_limit: [ 1500, 1500 ])
+      blob.open do |input|
+        variation.transform(input) { |output| output.read }
+      end
+    end
+
+    def assert_derived_file_exists(blob)
+      variant_blob = blob.variant_records.sole.image.blob
+      assert blob.service.exist?(variant_blob.key)
+      assert_not_equal blob.key, variant_blob.key
+    end
+end
