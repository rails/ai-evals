+
+      inserted = @book.accesses.insert_all!(
+        @grants.map { |grant| { user_id: grant[:user_id], level: grant[:level] } },
+        returning: %w[id user_id book_id level created_at updated_at]
+      )
+
+      inserted.map { |attributes| Access.instantiate(attributes) }
+    end
