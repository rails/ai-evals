-  end
+    def known_level?(level)
+      Access.levels.key?(level)
+    end
+
+    # First claim wins; a later grant for the same user is a duplicate row.
+    def claim(claimed, user_id)
+      key = user_id_key(user_id)
+      return false if claimed.include?(key)
+
+      claimed.add(key)
+      true
+    end
+
+    def user_id_key(user_id)
+      Integer(user_id)
+    rescue ArgumentError, TypeError
+      user_id
+    end
+
+    def existing_user_ids
