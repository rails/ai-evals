diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..cbdddbf
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,132 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  DELETED_AUTHOR = "Deleted author"
+  # Old Remove rewrote addresses to "local-deactivated-<uuid>@domain".
+  DEACTIVATED_EMAIL = /-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@/i
+
+  included do
+    before_destroy :prepare_erasure, prepend: true
+    after_destroy :purge_sign_in_events
+  end
+
+  def erase
+    destroy!
+  end
+
+  # Address they actually signed in with. Deactivated accounts keep sign-in
+  # events under the original address, not the rewritten one.
+  def signed_in_email_address
+    email = email_address.to_s
+    email = email.sub(DEACTIVATED_EMAIL, "@") while email.match?(DEACTIVATED_EMAIL)
+    email.presence
+  end
+
+  private
+    def prepare_erasure
+      @erasure_cutoff = updated_at
+      anonymize_shared_books
+      destroy_unshared_books
+      reading_marks.delete_all
+      sessions.delete_all
+    end
+
+    def anonymize_shared_books
+      created_books.with_everyone_access.update_all(
+        author: DELETED_AUTHOR,
+        creator_id: nil,
+        updated_at: Time.now
+      )
+    end
+
+    def destroy_unshared_books
+      created_books.where.not(everyone_access: true).find_each do |book|
+        erase_book(book)
+      end
+    end
+
+    def erase_book(book)
+      leaves = book.leaves.includes(edits: :leafable).to_a
+      blob_ids = blob_ids_for(book, leaves)
+
+      delete_search_hits(leaves)
+      ReadingMark.where(leaf_id: leaves.map(&:id)).delete_all
+      destroy_historical_leafables(leaves)
+      book.destroy!
+
+      purge_blobs(blob_ids)
+    end
+
+    def delete_search_hits(leaves)
+      leaves.each do |leaf|
+        Leaf.connection.execute(
+          Leaf.sanitize_sql([ "delete from leaf_search_index where rowid = ?", leaf.id ])
+        )
+      end
+    end
+
+    def destroy_historical_leafables(leaves)
+      leaves.each do |leaf|
+        leaf.edits.each do |edit|
+          next if edit.leafable_type == leaf.leafable_type && edit.leafable_id == leaf.leafable_id
+
+          edit.leafable&.destroy!
+        end
+      end
+    end
+
+    def blob_ids_for(book, leaves)
+      ids = []
+      ids << book.cover.blob.id if book.cover.attached?
+
+      leafables_for(leaves).each do |leafable|
+        ids.concat(blob_ids_for_leafable(leafable))
+      end
+
+      ids.compact.uniq
+    end
+
+    def leafables_for(leaves)
+      leaves.flat_map { |leaf| [ leaf.leafable, *leaf.edits.map(&:leafable) ] }.compact.uniq
+    end
+
+    def blob_ids_for_leafable(leafable)
+      ids = leafable.attachment_reflections.keys.flat_map do |name|
+        blob_ids_for_attachment(leafable.public_send(name))
+      end
+
+      markdown = leafable.try(:markdown_body)
+      ids.concat(markdown.uploads.blobs.ids) if markdown
+
+      ids
+    end
+
+    def blob_ids_for_attachment(attached)
+      if attached.respond_to?(:blobs)
+        attached.blobs.ids
+      elsif attached.respond_to?(:attached?) && attached.attached?
+        [ attached.blob.id ]
+      else
+        []
+      end
+    end
+
+    def purge_blobs(blob_ids)
+      return if blob_ids.empty?
+
+      ActiveStorage::Blob.where(id: blob_ids).find_each(&:purge)
+    end
+
+    def purge_sign_in_events
+      current = email_address
+      original = signed_in_email_address
+
+      SignInEvent.where(email_address: current).delete_all if current.present?
+      return if original.blank? || original == current
+
+      events = SignInEvent.where(email_address: original)
+      # The original address may have been reused after the old Remove freed it.
+      events = events.where(created_at: ..@erasure_cutoff) if User.exists?(email_address: original)
+      events.delete_all
+    end
+end
