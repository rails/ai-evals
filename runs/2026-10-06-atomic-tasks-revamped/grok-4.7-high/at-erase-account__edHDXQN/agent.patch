diff --git a/test/models/user_erasure_test.rb b/test/models/user_erasure_test.rb
new file mode 100644
index 0000000..c5c2ec7
--- /dev/null
+++ b/test/models/user_erasure_test.rb
@@ -0,0 +1,163 @@
+require "test_helper"
+
+class UserErasureTest < ActiveSupport::TestCase
+  setup do
+    @user = User.create!(name: "Alice Erasure", email_address: "alice.erasure@example.com", password: "secret123456")
+    @original_email = @user.email_address
+  end
+
+  test "erase deletes the user and personal rows" do
+    session = @user.sessions.start!(user_agent: "Agent", ip_address: "10.0.0.8")
+    other_book = books(:handbook)
+    ReadingMark.remember(leaves(:welcome_page), user: @user)
+    assert @user.accesses.exists?
+    assert SignInEvent.for_address(@original_email).exists?
+
+    @user.erase
+
+    assert_not User.exists?(@user.id)
+    assert_not Session.exists?(session.id)
+    assert_not Access.exists?(user_id: @user.id)
+    assert_not ReadingMark.exists?(user_id: @user.id)
+    assert_empty SignInEvent.for_address(@original_email)
+    assert Book.exists?(other_book.id)
+    assert_nowhere(@original_email)
+    assert_nowhere("Alice Erasure")
+    assert_nowhere("10.0.0.8")
+  end
+
+  test "erase keeps books shared with everyone and bylines them Deleted author" do
+    shared = Book.create!(title: "Shared Handbook", author: @user.name, everyone_access: true, creator: @user, published: true)
+    leaf = shared.press(Page.new(body: "shared-readable-phrase"), title: "Still Here")
+    other = users(:kevin)
+    assert shared.accessable?(user: other) || shared.published?
+
+    @user.erase
+
+    shared.reload
+    assert_equal "Deleted author", shared.author
+    assert_nil shared.creator_id
+    assert Book.exists?(shared.id)
+    assert Leaf.exists?(leaf.id)
+    assert_equal "shared-readable-phrase", leaf.reload.page.body.content.to_s
+    assert_includes Leaf.search("shared-readable-phrase"), leaf
+  end
+
+  test "erase destroys private books and their search hits, revisions, and files" do
+    private_book = Book.create!(title: "Alice Private", author: @user.name, everyone_access: false, creator: @user)
+    private_book.cover.attach(io: file_fixture("reading.webp").open, filename: "alice-private-cover.webp", content_type: "image/webp")
+    cover_blob_id = private_book.cover.blob.id
+
+    leaf = private_book.press(Page.new(body: "alice-secret-phrase original"), title: "Secret Page")
+    original_page = leaf.leafable
+    revised_page = Page.create!(body: "alice-secret-phrase revised")
+    leaf.edits.revision.create!(leafable: original_page)
+    leaf.update!(leafable: revised_page)
+
+    picture = private_book.press(Picture.new(caption: "alice-secret-caption"), title: "Secret Picture")
+    picture.picture.image.attach(io: file_fixture("pixel.bmp").open, filename: "alice-secret.bmp", content_type: "image/bmp")
+    image_blob_id = picture.picture.image.blob.id
+
+    assert_includes Leaf.search("alice-secret-phrase"), leaf
+    assert_operator search_index_count("alice-secret-phrase"), :>, 0
+
+    @user.erase
+
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(leaf.id)
+    assert_not Page.exists?(original_page.id)
+    assert_not Page.exists?(revised_page.id)
+    assert_not ActiveStorage::Blob.exists?(cover_blob_id)
+    assert_not ActiveStorage::Blob.exists?(image_blob_id)
+    assert_equal 0, search_index_count("alice-secret-phrase")
+    assert_equal 0, search_index_count("alice-secret-caption")
+    assert_nowhere("alice-secret-phrase")
+    assert_nowhere("alice-secret-caption")
+    assert_nowhere("alice-private-cover")
+    assert_nowhere("alice-secret.bmp")
+  end
+
+  test "erase works for accounts already removed the old way" do
+    @user.sessions.start!(user_agent: "OldAgent", ip_address: "192.0.2.9")
+    assert SignInEvent.for_address(@original_email).exists?
+
+    private_book = Book.create!(title: "Old Private", author: @user.name, everyone_access: false, creator: @user)
+    private_book.press(Page.new(body: "old-deactivated-secret"), title: "Old Secret")
+    shared = Book.create!(title: "Old Shared", author: @user.name, everyone_access: true, creator: @user)
+
+    @user.deactivate
+    scrambled = @user.reload.email_address
+    assert_not_equal @original_email, scrambled
+    assert_match(/-deactivated-/, scrambled)
+    assert_equal @original_email, @user.signed_in_email_address
+
+    @user.erase
+
+    assert_not User.exists?(@user.id)
+    assert_empty SignInEvent.for_address(@original_email)
+    assert_empty SignInEvent.for_address(scrambled)
+    assert_not Book.exists?(private_book.id)
+    assert_equal "Deleted author", shared.reload.author
+    assert_nil shared.creator_id
+    assert_equal 0, search_index_count("old-deactivated-secret")
+    assert_nowhere(@original_email)
+    assert_nowhere(scrambled)
+    assert_nowhere("192.0.2.9")
+  end
+
+  test "erasing a deactivated user does not delete sign-in events of a reused address" do
+    @user.sessions.start!(user_agent: "OldAgent", ip_address: "192.0.2.10")
+    old_event = SignInEvent.for_address(@original_email).first
+    @user.deactivate
+
+    travel 1.minute do
+      newbie = User.create!(name: "New Alice", email_address: @original_email, password: "secret123456")
+      newbie.sessions.start!(user_agent: "NewAgent", ip_address: "192.0.2.11")
+      new_event = SignInEvent.for_address(@original_email).order(:created_at).last
+
+      @user.erase
+
+      assert_not SignInEvent.exists?(old_event.id)
+      assert SignInEvent.exists?(new_event.id)
+      assert User.exists?(newbie.id)
+    end
+  end
+
+  test "erase leaves other people's books and sign-in events alone" do
+    other = users(:david)
+    other.sessions.start!(user_agent: "DavidAgent", ip_address: "198.51.100.4")
+    other_event = SignInEvent.for_address(other.email_address).first
+    their_book = Book.create!(title: "David Book", author: "David", everyone_access: false, creator: other)
+    their_leaf = their_book.press(Page.new(body: "david-only-phrase"), title: "David Page")
+
+    @user.erase
+
+    assert User.exists?(other.id)
+    assert SignInEvent.exists?(other_event.id)
+    assert Book.exists?(their_book.id)
+    assert_includes Leaf.search("david-only-phrase"), their_leaf
+  end
+
+
+  private
+    def assert_nowhere(value)
+      connection = ActiveRecord::Base.connection
+      connection.tables.each do |table|
+        next if table.start_with?("sqlite_")
+        next if table == "leaf_search_index"
+
+        columns = connection.columns(table).select { |column| [ :string, :text ].include?(column.type) }
+        columns.each do |column|
+          sql = "SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE #{connection.quote_column_name(column.name)} LIKE #{connection.quote("%#{value}%")}"
+          count = connection.select_value(sql).to_i
+          assert_equal 0, count, "found #{value.inspect} in #{table}.#{column.name}"
+        end
+      end
+    end
+
+    def search_index_count(terms)
+      match = terms.to_s.gsub(/[^\w]+/, " ").strip
+      quoted = ActiveRecord::Base.connection.quote(match)
+      ActiveRecord::Base.connection.select_value("select count(*) from leaf_search_index where leaf_search_index match #{quoted}").to_i
+    end
+end
