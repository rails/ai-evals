diff --git a/app/models/book/search_rate_limit.rb b/app/models/book/search_rate_limit.rb
new file mode 100644
index 0000000..4841b9b
--- /dev/null
+++ b/app/models/book/search_rate_limit.rb
@@ -0,0 +1,134 @@
+class Book::SearchRateLimit
+  LIMIT = 30
+  WINDOW = 1.minute
+  # A burst that stops is served again on its own, well within five minutes,
+  # without anyone having to unblock the address.
+  RETENTION = 5.minutes
+
+  def self.allow?(ip, now: Time.current)
+    backend.allow?(ip.to_s, now: now)
+  end
+
+  def self.reset!
+    backend.reset!
+  end
+
+  def self.backend
+    @backend ||= default_backend
+  end
+
+  def self.backend=(backend)
+    @backend = backend
+  end
+
+  def self.default_backend
+    Rails.env.production? ? RedisBackend.new : MemoryBackend.new
+  end
+  private_class_method :default_backend
+
+  # One-minute sliding window, kept in process. Enough for tests and for a
+  # single Puma process; production shares the same rules through Redis.
+  class MemoryBackend
+    def initialize
+      @hits = {}
+      @mutex = Mutex.new
+    end
+
+    def allow?(ip, now: Time.current)
+      now_f = now.to_f
+      cutoff = now_f - WINDOW
+
+      @mutex.synchronize do
+        prune(cutoff)
+        hits = (@hits[ip] ||= [])
+
+        if hits.size >= LIMIT
+          hits << now_f
+          hits.shift while hits.size > LIMIT
+          false
+        else
+          hits << now_f
+          true
+        end
+      end
+    end
+
+    def reset!
+      @mutex.synchronize { @hits.clear }
+    end
+
+    private
+      def prune(cutoff)
+        @hits.delete_if do |_ip, timestamps|
+          timestamps.reject! { |timestamp| timestamp <= cutoff }
+          timestamps.empty?
+        end
+      end
+  end
+
+  # Shared across Puma workers. Scores are request timestamps so any
+  # one-minute stretch is capped, and the key itself dies within RETENTION
+  # of the last request if a burst simply stops.
+  class RedisBackend
+    SCRIPT = <<~LUA.freeze
+      local key = KEYS[1]
+      local now = tonumber(ARGV[1])
+      local window = tonumber(ARGV[2])
+      local limit = tonumber(ARGV[3])
+      local member = ARGV[4]
+      local ttl = tonumber(ARGV[5])
+
+      redis.call("ZREMRANGEBYSCORE", key, "-inf", now - window)
+      local count = redis.call("ZCARD", key)
+      redis.call("ZADD", key, now, member)
+
+      if count >= limit then
+        redis.call("ZREMRANGEBYRANK", key, 0, -(limit + 1))
+        redis.call("EXPIRE", key, ttl)
+        return 0
+      end
+
+      redis.call("EXPIRE", key, ttl)
+      return 1
+    LUA
+
+    def initialize(url: ENV.fetch("REDIS_URL", "redis://localhost:6379/0"))
+      @url = url
+    end
+
+    def allow?(ip, now: Time.current)
+      now_f = now.to_f
+      member = "#{now_f}:#{SecureRandom.hex(4)}"
+      allowed = redis.eval(
+        SCRIPT,
+        keys: [ key(ip) ],
+        argv: [ now_f, WINDOW.to_f, LIMIT, member, RETENTION.to_i ]
+      )
+      allowed.to_i == 1
+    rescue Redis::BaseError => error
+      Rails.logger.error("Book search rate limit unavailable: #{error.class}: #{error.message}")
+      memory_fallback.allow?(ip, now: now)
+    end
+
+    def reset!
+      redis.scan_each(match: "#{KEY_PREFIX}*") { |key| redis.del(key) }
+    rescue Redis::BaseError
+      nil
+    end
+
+    private
+      KEY_PREFIX = "book_search_rate_limit:"
+
+      def key(ip)
+        "#{KEY_PREFIX}#{ip}"
+      end
+
+      def redis
+        @redis ||= Redis.new(url: @url, timeout: 1)
+      end
+
+      def memory_fallback
+        @memory_fallback ||= MemoryBackend.new
+      end
+  end
+end
