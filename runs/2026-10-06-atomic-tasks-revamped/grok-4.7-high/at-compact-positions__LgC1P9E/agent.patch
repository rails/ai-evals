+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+    @leaves = @book.leaves
+  end
+
+  test "compact_positions preserves hand-arranged order as a dense sequence" do
+    # Creation order is welcome_section, welcome_page, summary_page, reading_picture.
+    # Arrange them into a different sequence with gaps left by deletions.
+    @leaves.find(leaves(:reading_picture).id).update_column(:position_score, 1.5)
+    @leaves.find(leaves(:welcome_page).id).update_column(:position_score, 8.25)
+    @leaves.find(leaves(:welcome_section).id).update_column(:position_score, 20)
+    @leaves.find(leaves(:summary_page).id).update_column(:position_score, 40.5)
+
+    @book.compact_positions!
+
+    assert_equal [ leaves(:reading_picture), leaves(:welcome_page), leaves(:welcome_section), leaves(:summary_page) ],
+      @book.leaves.positioned
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions keeps a trashed page in its arranged place when restored" do
+    @leaves.find(leaves(:reading_picture).id).update_column(:position_score, 1.5)
+    @leaves.find(leaves(:welcome_page).id).update_column(:position_score, 8.25)
+    @leaves.find(leaves(:welcome_section).id).update_column(:position_score, 20)
+    @leaves.find(leaves(:summary_page).id).update_column(:position_score, 40.5)
+    leaves(:welcome_page).trashed!
+
+    @book.compact_positions!
+
+    assert_equal [ leaves(:reading_picture), leaves(:welcome_section), leaves(:summary_page) ],
+      @book.leaves.active.positioned
+
+    leaves(:welcome_page).active!
+
+    assert_equal [ leaves(:reading_picture), leaves(:welcome_page), leaves(:welcome_section), leaves(:summary_page) ],
+      @book.leaves.active.positioned
+  end
+
+  test "compact_positions does not renumber another book" do
+    other = books(:manual)
+    other_leaf = other.press Page.new(body: "Kept"), title: "Kept"
+    other_leaf.update_column(:position_score, 12.5)
+
+    @book.compact_positions!
+
+    assert_equal 12.5, other_leaf.reload.position_score
+  end
+
+  test "live_leaf_count counts pages that are not in the trash" do
+    assert_equal @book.leaves.active.count, @book.live_leaf_count
+
+    leaves(:summary_page).trashed!
+    leaves(:welcome_page).trashed!
+
+    assert_equal @book.leaves.active.count, @book.reload.live_leaf_count
+    assert_equal 2, @book.live_leaf_count
+  end
+end
