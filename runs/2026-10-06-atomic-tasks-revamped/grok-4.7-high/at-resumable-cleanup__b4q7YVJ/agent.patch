@@ -0,0 +1,200 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    @counts = Hash.new(0)
+    Thread.current[:title_update_counts] = @counts
+    Thread.current[:count_title_updates] = true
+    Leaf.destroy_all
+  end
+
+  teardown do
+    Thread.current[:count_title_updates] = false
+    Thread.current[:title_update_counts] = nil
+    Thread.current[:kill_title_update] = nil
+    queue_adapter.stopping = false if using_test_adapter?
+  end
+
+  test "strips one layer of exporter quotes and keeps inner quotes" do
+    leaves = build_leaves
+
+    TitleCleanupJob.perform_now
+
+    assert_cleaned_once leaves
+  end
+
+  test "resumes after an interruption without recleaning finished leaves" do
+    leaves = build_leaves
+    finished = leaves.first
+
+    TitleCleanupJob.perform_later
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: finished.id.succ) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal expected_title(finished), finished.reload.title
+    assert_equal 1, @counts[finished.id]
+    leaves.drop(1).each do |leaf|
+      assert_equal leaf.title, original_title(leaf)
+      assert_equal 0, @counts[leaf.id]
+    end
+
+    perform_enqueued_jobs
+
+    assert_cleaned_once leaves
+  end
+
+  test "multiple interruptions still clean every title exactly once" do
+    leaves = build_leaves
+    TitleCleanupJob.perform_later
+
+    leaves.each do |leaf|
+      interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: leaf.id.succ) do
+        perform_enqueued_jobs
+      end
+      assert_equal expected_title(leaf), leaf.reload.title
+      assert_equal 1, @counts[leaf.id]
+    end
+
+    perform_enqueued_jobs
+
+    assert_cleaned_once leaves
+  end
+
+  test "a shutdown already in progress finishes only the current leaf before resuming later" do
+    leaves = build_leaves
+
+    queue_adapter.perform_enqueued_jobs = true
+    queue_adapter.perform_enqueued_at_jobs = false
+    queue_adapter.stopping = -> { true }
+    TitleCleanupJob.perform_later
+
+    assert_equal expected_title(leaves.first), leaves.first.reload.title
+    assert_equal 1, @counts[leaves.first.id]
+    leaves.drop(1).each do |leaf|
+      assert_equal original_title(leaf), leaf.reload.title
+      assert_equal 0, @counts[leaf.id]
+    end
+
+    queue_adapter.stopping = false
+    queue_adapter.perform_enqueued_jobs = false
+    perform_enqueued_jobs
+
+    assert_cleaned_once leaves
+  end
+
+  test "redoes at most the leaf it was on when that update never commits" do
+    leaves = build_leaves
+    done, in_progress = leaves
+
+    TitleCleanupJob.perform_later
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: done.id.succ) do
+      perform_enqueued_jobs
+    end
+
+    payload = enqueued_jobs.first
+    assert payload, "expected a continuation to be enqueued"
+
+    Thread.current[:kill_title_update] = RuntimeError.new("killed mid-leaf")
+    assert_raises(RuntimeError) do
+      instantiate_job(payload, skip_deserialize_arguments: true).perform_now
+    end
+
+    assert_equal expected_title(done), done.reload.title
+    assert_equal original_title(in_progress), in_progress.reload.title
+    assert_equal 1, @counts[done.id]
+    assert_equal 0, @counts[in_progress.id]
+
+    clear_enqueued_jobs
+    instantiate_job(payload, skip_deserialize_arguments: true).perform_now
+
+    assert_cleaned_once leaves
+  end
+
+  test "resumes across id gaps and does not reclean earlier leaves" do
+    leaves = build_leaves
+    removed = leaves.delete_at(1)
+    removed.destroy!
+
+    TitleCleanupJob.perform_later
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: leaves.first.id.succ) do
+      perform_enqueued_jobs
+    end
+    perform_enqueued_jobs
+
+    assert_cleaned_once leaves
+    assert_not Leaf.exists?(removed.id)
+  end
+
+  test "completes when there are no leaves" do
+    assert_nothing_raised { TitleCleanupJob.perform_now }
+    assert_equal 0, Leaf.count
+  end
+
+  test "cleans a title that is only the exporter's wrapping quotes" do
+    leaf = books(:handbook).press(Section.new, title: '""')
+    remember leaf, "", '""'
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "", leaf.reload.title
+    assert_equal 1, @counts[leaf.id]
+  end
+
+  private
+    def build_leaves
+      [
+        [ '"Plain title"', "Plain title" ],
+        [ '""Quoted phrase" opens this title"', '"Quoted phrase" opens this title' ],
+        [ '"Ends with a "quoted phrase""', 'Ends with a "quoted phrase"' ],
+        [ '"Middle "quote" stays"', 'Middle "quote" stays' ],
+        [ '"Another plain title"', "Another plain title" ],
+        [ '"«déjà vu»"', "«déjà vu»" ]
+      ].map do |wrapped, expected|
+        leaf = books(:handbook).press(Section.new, title: wrapped)
+        remember leaf, expected, wrapped
+        leaf
+      end
+    end
+
+    def remember(leaf, expected, wrapped)
+      @expected ||= {}
+      @wrapped ||= {}
+      @expected[leaf.id] = expected
+      @wrapped[leaf.id] = wrapped
+    end
+
+    def expected_title(leaf)
+      @expected.fetch(leaf.id)
+    end
+
+    def original_title(leaf)
+      @wrapped.fetch(leaf.id)
+    end
+
+    def assert_cleaned_once(leaves)
+      leaves.each do |leaf|
+        assert_equal expected_title(leaf), leaf.reload.title, "leaf #{leaf.id} title"
+        assert_equal 1, @counts[leaf.id], "leaf #{leaf.id} was cleaned #{@counts[leaf.id]} times"
+      end
+    end
+end
+
+module TitleCleanupUpdateProbe
+  def update!(*args, **kwargs, &block)
+    attributes = args.first.is_a?(Hash) ? args.first : kwargs
+    if attributes.key?(:title) && (error = Thread.current[:kill_title_update])
+      Thread.current[:kill_title_update] = nil
+      raise error
+    end
+    if Thread.current[:count_title_updates] && attributes.key?(:title)
+      Thread.current[:title_update_counts][id] += 1
+    end
+    super(*args, **kwargs, &block)
+  end
+end
+
+Leaf.prepend(TitleCleanupUpdateProbe) unless Leaf.ancestors.include?(TitleCleanupUpdateProbe)
