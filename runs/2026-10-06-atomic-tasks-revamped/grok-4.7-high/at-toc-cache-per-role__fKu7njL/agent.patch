diff --git a/app/models/leaf.rb b/app/models/leaf.rb
index fb7e68b..bfa5385 100644
--- a/app/models/leaf.rb
+++ b/app/models/leaf.rb
@@ -14,4 +14,24 @@ class Leaf < ApplicationRecord
   def slug
     title.parameterize.presence || "-"
   end
+
+  # Collection rendering (`cached: true`) keys each fragment off #cache_key
+  # and never consults the `cache` call inside the partial. Edit controls in
+  # the table of contents depend on who is viewing, so the key has to as well
+  # — otherwise the first person to open a book stamps their controls onto
+  # everyone who follows. Permission is one lookup per book, not per entry.
+  def cache_key
+    "#{super}-#{edit_permission_cache_suffix}"
+  end
+
+  private
+    def edit_permission_cache_suffix
+      permissions = Current.edit_permission_for_book ||= {}
+      key = [ book_id, Current.user&.id ]
+      return permissions[key] if book_id && permissions.key?(key)
+
+      suffix = book&.editable? ? "editor" : "reader"
+      permissions[key] = suffix if book_id
+      suffix
+    end
 end
