@@ -1,9 +1,25 @@
 class Books::SearchesController < ApplicationController
   allow_unauthenticated_access
 
+  # The null store cannot count, so keep an in-process store in test and in
+  # development when caching is off. Production uses the shared cache (Redis)
+  # so every worker enforces the same per-address limit. The entry expires with
+  # the one-minute window, so a burst lets go by itself within five minutes.
+  RATE_LIMIT_STORE = Rails.cache.is_a?(ActiveSupport::Cache::NullStore) ? ActiveSupport::Cache::MemoryStore.new : Rails.cache
+
+  rate_limit to: 30, within: 1.minute, only: :create, store: RATE_LIMIT_STORE,
+    by: -> { request.remote_ip },
+    with: -> { head :too_many_requests }
+
   include BookScoped
 
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
 end
+
+if Rails.env.test?
+  ActiveSupport.on_load(:action_dispatch_integration_test) do
+    setup { Books::SearchesController::RATE_LIMIT_STORE.clear }
+  end
+end
diff --git a/script/reproduce_search_rate_limit.rb b/script/reproduce_search_rate_limit.rb
new file mode 100644
index 0000000..d18f68a
--- /dev/null
+++ b/script/reproduce_search_rate_limit.rb
@@ -0,0 +1,63 @@
+# Reproduces the published-book search flood and checks the per-address limit.
+# Run: ruby -Itest script/reproduce_search_rate_limit.rb
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../test/test_helper"
+
+class SearchRateLimitReproTest < ActionDispatch::IntegrationTest
+  setup do
+    @book = books(:handbook)
+    @book.update!(published: true)
+    Leaf.reindex_all
+    Books::SearchesController::RATE_LIMIT_STORE.clear
+  end
+
+  test "refuses a flooding address with 429 and leaves everyone else alone" do
+    attacker = "203.0.113.10"
+    reader = "203.0.113.11"
+
+    30.times do |i|
+      post book_search_path(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => attacker }
+      assert_response :success, "request #{i + 1} should be served, got #{response.status}"
+    end
+
+    post book_search_path(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => attacker }
+    assert_equal 429, response.status
+    assert_not response.redirect?, "429 must not be a redirect"
+    assert_not_equal 500, response.status
+
+    # Same address, another published book, still refused — the limit is per address, not per book.
+    books(:manual).update!(published: true)
+    post book_search_path(books(:manual)), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => attacker }
+    assert_equal 429, response.status
+
+    # A different address still searches that book, without signing in.
+    post book_search_path(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => reader }
+    assert_response :success
+
+    # The refused address can still open the book's pages.
+    get book_slug_path(@book), headers: { "REMOTE_ADDR" => attacker }
+    assert_response :success
+    get leafable_slug_path(leaves(:welcome_page)), headers: { "REMOTE_ADDR" => attacker }
+    assert_response :success
+
+    # Still refused inside the one-minute window.
+    travel 30.seconds
+    post book_search_path(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => attacker }
+    assert_equal 429, response.status
+
+    # Lets go by itself once that minute elapses — within five minutes, no unblock step.
+    travel 61.seconds
+    30.times do |i|
+      post book_search_path(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => attacker }
+      assert_response :success, "recovered request #{i + 1} got #{response.status}"
+    end
+    post book_search_path(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => attacker }
+    assert_equal 429, response.status
+
+    # Still releases within five minutes of the burst stopping.
+    travel_back
+    travel 5.minutes
+    post book_search_path(@book), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => attacker }
+    assert_response :success
+  end
+end
