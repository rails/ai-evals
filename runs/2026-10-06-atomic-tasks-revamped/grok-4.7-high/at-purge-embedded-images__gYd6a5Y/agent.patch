@@ -0,0 +1,43 @@
+require "test_helper"
+
+class PageImageCleanupTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges embedded images once background work finishes" do
+    page = books(:handbook).press(Page.new(body: "Hello"), title: "With image").page
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    page.body.save!
+
+    attachment = page.body.uploads.attachments.last
+    blob = attachment.blob
+    key = blob.key
+    service = blob.service
+    page.update!(body: "![reading](#{attachment.slug_path})")
+
+    assert service.exist?(key)
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not service.exist?(key)
+  end
+
+  test "destroying a page does not purge images embedded in another page" do
+    page = books(:handbook).press(Page.new(body: "Hello"), title: "With image").page
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    page.body.save!
+    blob = page.body.uploads.attachments.last.blob
+
+    other = books(:handbook).press(Page.new(body: "Other"), title: "Other").page
+
+    perform_enqueued_jobs do
+      other.destroy!
+    end
+
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert blob.service.exist?(blob.key)
+  end
+end
