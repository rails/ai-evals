diff --git a/db/migrate/20261008010000_create_tenants.rb b/db/migrate/20261008010000_create_tenants.rb
new file mode 100644
index 0000000..3038684
--- /dev/null
+++ b/db/migrate/20261008010000_create_tenants.rb
@@ -0,0 +1,33 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |dir|
+      dir.up { sweep_existing_records_into_one_tenant }
+    end
+  end
+
+  private
+    def sweep_existing_records_into_one_tenant
+      Tenant.reset_column_information
+      User.reset_column_information
+      Book.reset_column_information
+
+      return unless User.unscoped.exists? || Book.unscoped.exists?
+
+      tenant = Tenant.create!(name: default_tenant_name)
+      User.unscoped.update_all(tenant_id: tenant.id)
+      Book.unscoped.update_all(tenant_id: tenant.id)
+    end
+
+    def default_tenant_name
+      Account.order(:id).pick(:name).presence || "Writebook"
+    end
+end
