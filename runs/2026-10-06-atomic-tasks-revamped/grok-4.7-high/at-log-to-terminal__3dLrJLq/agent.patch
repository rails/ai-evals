diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..7ea1d4e 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -19,6 +19,23 @@ module Writebook
     # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
     config.log_level = ENV.fetch("LOG_LEVEL", "debug")
 
+    # `rails runner` writes Rails.logger only to log/<env>.log. The import
+    # sign-off reads the library report from the terminal, and log tooling
+    # still reads that file, so mirror the existing logger instead of
+    # replacing it. Server and console already do this themselves.
+    runner do
+      next if ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout, $stderr)
+
+      console = ActiveSupport::Logger.new($stdout)
+      console.formatter = Rails.logger.formatter
+      # Debug SQL is what made the runbook noisy. Keep that in the log file,
+      # but show the report (info/warn) on the terminal. Never print a line
+      # the file logger would drop.
+      console.level = [ Rails.logger.level, Logger::INFO ].max
+      $stdout.sync = true
+      Rails.logger.broadcast_to(console)
+    end
+
