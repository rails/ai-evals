new file mode 100644
index 0000000..3d018c6
--- /dev/null
+++ b/config/initializers/continuable_shutdown.rb
@@ -0,0 +1,21 @@
+# Deploys signal Resque to stop. Mark the Active Job adapter as stopping so a
+# continuable job checkpoints and requeues instead of dying mid-collection.
+module ContinuableShutdown
+  def shutdown(...)
+    mark_active_job_stopping
+    super
+  end
+
+  def shutdown!(...)
+    mark_active_job_stopping
+    super
+  end
+
+  private
+    def mark_active_job_stopping
+      adapter = ActiveJob::Base.queue_adapter
+      adapter.stopping = true if adapter.respond_to?(:stopping=)
+    end
+end
+
+Resque::Worker.prepend(ContinuableShutdown) if defined?(Resque::Worker)
