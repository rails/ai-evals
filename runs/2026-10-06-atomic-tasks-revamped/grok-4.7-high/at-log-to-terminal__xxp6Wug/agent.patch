diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..a2e6d13 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -29,5 +29,18 @@ module Writebook
 
     # Opt in to 8.0 timezone behavior
     config.active_support.to_time_preserves_timezone = :zone
+
+    # rails runner records logs in the environment log file but does not print
+    # them. The import runbook signs off on that output from the terminal, so
+    # mirror the same logger to stdout without dropping the file record.
+    runner do
+      console = ActiveSupport::Logger.new(STDOUT)
+      console.formatter = Rails.logger.formatter
+      console.level = Rails.logger.level
+
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDERR, STDOUT)
+        Rails.logger.broadcast_to(console)
+      end
+    end
   end
 end
