@@ -19,6 +19,19 @@ module Writebook
     # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
     config.log_level = ENV.fetch("LOG_LEVEL", "debug")
 
+    # `rails runner` otherwise records the import report only in log/<env>.log.
+    # Mirror it to the terminal so the runbook can be signed off, without dropping
+    # the file record the log tooling reads. Debug noise (SQL, etc.) stays in the file.
+    runner do
+      next if ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout, $stderr)
+
+      $stdout.sync = true
+      console = ActiveSupport::Logger.new($stdout)
+      console.formatter = Rails.logger.formatter
+      console.level = [ Rails.logger.level, Logger::INFO ].max
+      Rails.logger.broadcast_to(console)
+    end
+
