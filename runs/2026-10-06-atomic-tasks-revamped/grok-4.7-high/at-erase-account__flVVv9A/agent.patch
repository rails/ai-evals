+
+test "destroy erases the user instead of deactivating them" do
+  sign_in :david
+  kevin = users(:kevin)
+  email = kevin.email_address
+  SignInEvent.create!(email_address: email, action: "signed_in", ip_address: "203.0.113.10", user_agent: "K", created_at: Time.now)
