diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..497b386
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,88 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  DELETED_AUTHOR = "Deleted author"
+
+  # Old removals rewrote "alice@example.com" to "alice-deactivated-<uuid>@example.com".
+  # Sign-in events were recorded under the address they actually signed in with.
+  DEACTIVATED_EMAIL_TOKEN = /-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?=@|-deactivated-)/i
+
+  included do
+    before_destroy :prepare_erasure, prepend: true
+    after_destroy :purge_personal_traces
+  end
+
+  def erase
+    destroy!
+  end
+
+  # Address this person signed in with, even if Remove previously scrambled it.
+  def original_email_address
+    email_address.to_s.gsub(DEACTIVATED_EMAIL_TOKEN, "")
+  end
+
+  private
+    def prepare_erasure
+      relinquish_shared_books
+      obliterate_private_books
+    end
+
+    def relinquish_shared_books
+      created_books.with_everyone_access.update_all(
+        creator_id: nil,
+        author: DELETED_AUTHOR,
+        updated_at: Time.current
+      )
+      created_books.reset
+    end
+
+    def obliterate_private_books
+      created_books.where(everyone_access: false).find_each do |book|
+        obliterate_book(book)
+      end
+      created_books.reset
+    end
+
+    def obliterate_book(book)
+      Leaf.purge_search_index(book.leaf_ids)
+      book.leaves.find_each do |leaf|
+        leaf.edits.revision.find_each do |edit|
+          destroy_leafable(edit.leafable)
+        end
+        purge_stored_files(leaf.leafable)
+      end
+      purge_stored_files(book)
+      book.destroy!
+    end
+
+    def destroy_leafable(leafable)
+      return if leafable.nil?
+
+      purge_stored_files(leafable)
+      leafable.destroy!
+    end
+
+    def purge_stored_files(record)
+      return if record.nil?
+
+      if record.class.respond_to?(:reflect_on_all_attachments)
+        record.class.reflect_on_all_attachments.each do |reflection|
+          attached = record.public_send(reflection.name)
+          attached.purge if attached.attached?
+        end
+      end
+
+      if record.respond_to?(:body?) && record.body? && record.body.respond_to?(:uploads)
+        record.body.uploads.purge if record.body.uploads.attached?
+      end
+    end
+
+    def purge_personal_traces
+      SignInEvent.where(email_address: personal_email_addresses).delete_all
+      Leaf.purge_stale_search_hits
+    end
+
+    def personal_email_addresses
+      [ email_address, original_email_address ].compact_blank.uniq
+    end
+end
