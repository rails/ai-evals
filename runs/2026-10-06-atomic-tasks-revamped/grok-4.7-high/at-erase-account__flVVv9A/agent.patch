+  kevin = users(:kevin)
+  email = kevin.email_address
+  SignInEvent.create!(email_address: email, action: "signed_in", ip_address: "203.0.113.11", user_agent: "K", created_at: Time.now)
+  kevin.deactivate
+
+  sign_in :david
+
+  assert_difference -> { User.count }, -1 do
+    delete user_path(kevin)
+  end
+
+  assert_redirected_to users_url
+  assert_not User.exists?(kevin.id)
+  assert_empty SignInEvent.where(email_address: email)
+end
 end
diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..7308e5e
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  setup do
+    @user = User.create!(name: "Alice Erase", email_address: "alice-erase@example.com", password: "secret123456")
+    @other = users(:david)
+  end
+
+  test "erase deletes the person and every row that belongs to them" do
+    private_book = Book.create!(title: "Alice Diary", author: @user.name, everyone_access: false, creator: @user)
+    page = private_book.press(Page.new(body: "supersecret diary of alice-erase"), title: "Private page")
+    page.edit(leafable_params: { body: "revised supersecret diary of alice-erase" }, leaf_params: {})
+    picture = private_book.press(Picture.new(caption: "alice-erase snapshot"), title: "Private picture")
+    picture.leafable.image.attach io: file_fixture("pixel.bmp").open, filename: "alice-erase.bmp", content_type: "image/bmp"
+    @blob_id = picture.leafable.image.blob.id
+
+    shared = Book.create!(title: "Alice Public", subtitle: "Still readable", author: @user.name, everyone_access: true, creator: @user, published: true)
+    shared_leaf = shared.press(Page.new(body: "people are still reading this public page"), title: "Public page")
+
+    other_book = Book.create!(title: "David Notes", author: "David", everyone_access: false, creator: @other)
+    other_book.press(Page.new(body: "david private notes stay"), title: "David page")
+
+    ReadingMark.remember(shared_leaf, user: @user)
+    ReadingMark.remember(shared_leaf, user: @other)
+    @user.sessions.create!(user_agent: "TestAgent", ip_address: "203.0.113.8")
+    SignInEvent.create!(email_address: @user.email_address, action: "signed_in", ip_address: "203.0.113.8", user_agent: "TestAgent", created_at: Time.now)
+    SignInEvent.create!(email_address: @other.email_address, action: "signed_in", ip_address: "198.51.100.4", user_agent: "Other", created_at: Time.now)
+
+    assert_includes Leaf.search("supersecret"), page
+    assert_includes Leaf.search("public page"), shared_leaf
+
+    @user.erase
+
+    assert_not User.exists?(@user.id)
+    assert_not Session.exists?(user_id: @user.id)
+    assert_not Access.exists?(user_id: @user.id)
+    assert_not ReadingMark.exists?(user_id: @user.id)
+    assert_empty SignInEvent.where(email_address: "alice-erase@example.com")
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(page.id)
+    assert_not Picture.exists?(picture.leafable_id)
+    assert_no_personal_text "alice-erase@example.com"
+    assert_no_personal_text "supersecret diary"
+    assert_no_personal_text "203.0.113.8"
+    assert_no_personal_text "TestAgent"
+    assert_no_personal_text "alice-erase.bmp"
+    assert_not ActiveStorage::Blob.exists?(@blob_id)
+    assert_not ActiveStorage::Attachment.exists?(record_type: "Picture", record_id: picture.leafable_id)
+    assert_no_search_hit "supersecret"
+    assert_no_search_hit "alice-erase snapshot"
+
+    shared.reload
+    assert shared.everyone_access?
+    assert_nil shared.creator_id
+    assert_equal "Deleted author", shared.author
+    assert_equal "Still readable", shared.subtitle
+    assert Leaf.exists?(shared_leaf.id)
+    assert_includes Leaf.search("public page"), shared_leaf
+    assert Book.exists?(other_book.id)
+    assert_equal @other.id, other_book.reload.creator_id
+    assert ReadingMark.exists?(user: @other, leaf: shared_leaf)
+    assert SignInEvent.exists?(email_address: @other.email_address)
+  end
+
+  test "erase works for someone already removed the old way" do
+    signed_in_as = @user.email_address
+    SignInEvent.create!(email_address: signed_in_as, action: "signed_in", ip_address: "203.0.113.9", user_agent: "Old", created_at: 1.day.ago)
+    @user.sessions.create!(user_agent: "Old", ip_address: "203.0.113.9")
+
+    shared = Book.create!(title: "Kept Manual", author: @user.name, everyone_access: true, creator: @user)
+    private_book = Book.create!(title: "Old Private", author: @user.name, everyone_access: false, creator: @user)
+    private_book.press(Page.new(body: "deactivated-user-secret"), title: "Old secret")
+
+    @user.deactivate
+    assert_match(/-deactivated-[0-9a-f-]{36}@/i, @user.reload.email_address)
+    assert_equal signed_in_as, @user.original_email_address
+    assert SignInEvent.exists?(email_address: signed_in_as)
+
+    @user.erase
+
+    assert_not User.exists?(email_address: signed_in_as)
+    assert_not User.where("email_address LIKE ?", "%deactivated%#{signed_in_as.split('@').last}").where("name = ?", "Alice Erase").exists?
+    assert_empty SignInEvent.where(email_address: signed_in_as)
+    assert_empty SignInEvent.where("email_address LIKE ?", "%alice-erase%")
+    assert_not Book.exists?(private_book.id)
+    assert_no_search_hit "deactivated-user-secret"
+    assert_equal "Deleted author", shared.reload.author
+    assert_nil shared.creator_id
+    assert Book.exists?(shared.id)
+  end
+
+
+  test "erasure does not reassign shared books to the acting administrator" do
+  Current.user = @other
+  shared = Book.create!(title: "Still Shared", author: @user.name, everyone_access: true, creator: @user)
+
+  @user.erase
+
+  assert_nil shared.reload.creator_id
+  assert_equal "Deleted author", shared.author
+  assert_not_equal @other.id, shared.creator_id
+end
+
+  private
+    def assert_no_personal_text(fragment)
+      text_columns.each do |table, column|
+        hits = ActiveRecord::Base.connection.select_value(
+          "select count(*) from #{table} where #{column} like #{ActiveRecord::Base.connection.quote("%#{fragment}%")}"
+        )
+        assert_equal 0, hits.to_i, "found #{fragment.inspect} in #{table}.#{column}"
+      end
+    end
+
+    def assert_no_search_hit(terms)
+      assert_empty Leaf.search(terms), "search still returns #{terms.inspect}"
+      quoted = ActiveRecord::Base.connection.quote("%#{terms}%")
+      hits = ActiveRecord::Base.connection.select_value(
+        "select count(*) from leaf_search_index where title like #{quoted} or content like #{quoted}"
+      )
+      assert_equal 0, hits.to_i, "stale search hit for #{terms.inspect}"
+    end
+
+    def text_columns
+      ActiveRecord::Base.connection.tables.flat_map do |table|
+        next [] if table.start_with?("sqlite_")
+        ActiveRecord::Base.connection.columns(table).filter_map do |column|
+          [ table, column.name ] if column.type.in?([ :string, :text ])
+        end
+      end
+    end
+end
