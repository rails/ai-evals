--- a/app/models/book/recap.rb
+++ b/app/models/book/recap.rb
@@ -15,8 +15,14 @@ module Book::Recap
 
   private
     def write_recap
+      # The callback runs on whichever in-memory copy was saved last. A release
+      # updates the title on one copy and published on another, so that copy can
+      # still hold the working title. Cache the row that was actually committed.
+      committed = self.class.find_by(id: id)
+      return unless committed
+
       Rails.cache.write recap_cache_key,
-        { title: title, published: published },
+        { title: committed.title, published: committed.published },
         expires_in: Rails.application.config.x.recap.expires_in
     end
 end
