diff --git a/app/models/book/accessable.rb b/app/models/book/accessable.rb
index aa3dcf1..ac29bd7 100644
--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -28,6 +28,19 @@ module Book::Accessable
     access_for(user: user)&.editor? || user&.administrator?
   end
 
+  # People who can currently open an editor. Presence is delivered on a
+  # per-user stream so a collaborator removed while their editor is still
+  # open is not listening on the channel the payload is sent to.
+  def users_who_can_edit
+    ids = accesses.editor.pluck(:user_id)
+
+    administrators = User.administrator
+    administrators = administrators.where(id: accesses.select(:user_id)) unless published?
+    ids |= administrators.pluck(:id)
+
+    User.where(id: ids)
+  end
+
   def access_for(user: Current.user)
     accesses.find_by(user: user)
   end
