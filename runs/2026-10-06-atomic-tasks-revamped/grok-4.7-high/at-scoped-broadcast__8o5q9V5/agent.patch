diff --git a/test/controllers/being_edited_broadcast_test.rb b/test/controllers/being_edited_broadcast_test.rb
new file mode 100644
index 0000000..133fc5b
--- /dev/null
+++ b/test/controllers/being_edited_broadcast_test.rb
@@ -0,0 +1,139 @@
+require "test_helper"
+
+class BeingEditedBroadcastTest < ActionDispatch::IntegrationTest
+  setup do
+    @leaf = leaves(:welcome_page)
+    @book = books(:handbook)
+  end
+
+  test "removed collaborator does not receive being-edited presence on a channel they can still listen to" do
+    sign_in :kevin
+    removed_stream = signed_stream_name_for_open_editor
+
+    sign_in :jason
+    remaining_stream = signed_stream_name_for_open_editor
+    assert_not_equal removed_stream, remaining_stream
+
+    @book.accesses.where(user: users(:kevin)).delete_all
+    assert_not @book.editable?(user: users(:kevin))
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(@leaf), params: { leaf: { title: "Updated" }, page: { body: "Still editing." } }
+    end
+    assert_response :no_content
+
+    assert_empty turbo_stream_broadcasts(removed_stream)
+    assert_no_turbo_stream_broadcasts [ @leaf, :being_edited ]
+
+    remaining_payloads = turbo_stream_broadcasts(remaining_stream)
+    assert_equal 1, remaining_payloads.size
+    assert_includes remaining_payloads.join, users(:david).name
+    assert_includes remaining_payloads.join, "being-edited-by"
+  end
+
+  test "demoted editor does not keep receiving presence on their open editor" do
+    sign_in :kevin
+    demoted_stream = signed_stream_name_for_open_editor
+
+    @book.accesses.find_by!(user: users(:kevin)).update!(level: :reader)
+    assert_not @book.editable?(user: users(:kevin))
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(@leaf), params: { leaf: { title: "Updated" }, page: { body: "Still editing." } }
+    end
+
+    assert_empty turbo_stream_broadcasts(demoted_stream)
+  end
+
+  test "other member editors with the page open still see who is editing" do
+    @book.accesses.find_by!(user: users(:jz)).update!(level: :editor)
+
+    sign_in :jz
+    member_stream = signed_stream_name_for_open_editor
+
+    sign_in :kevin
+    removed_stream = signed_stream_name_for_open_editor
+    @book.accesses.where(user: users(:kevin)).delete_all
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(@leaf), params: { leaf: { title: "Updated" }, page: { body: "Still editing." } }
+    end
+
+    assert_empty turbo_stream_broadcasts(removed_stream)
+    assert_includes turbo_stream_broadcasts(member_stream).join, users(:david).name
+    assert_no_turbo_stream_broadcasts [ @leaf, :being_edited, users(:kevin) ]
+    assert_turbo_stream_broadcasts [ @leaf, :being_edited, users(:jz) ]
+  end
+
+  test "readers are not sent presence payloads" do
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(@leaf), params: { leaf: { title: "Updated" }, page: { body: "Still editing." } }
+    end
+
+    assert_no_turbo_stream_broadcasts [ @leaf, :being_edited, users(:jz) ]
+    assert_turbo_stream_broadcasts [ @leaf, :being_edited, users(:kevin) ]
+  end
+
+  test "administrator removed from an unpublished book is not sent presence" do
+    assert_not @book.published?
+
+    sign_in :jason
+    removed_admin_stream = signed_stream_name_for_open_editor
+    @book.accesses.where(user: users(:jason)).delete_all
+    assert_not @book.accessable?(user: users(:jason))
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(@leaf), params: { leaf: { title: "Updated" }, page: { body: "Still editing." } }
+    end
+
+    assert_empty turbo_stream_broadcasts(removed_admin_stream)
+    assert_no_turbo_stream_broadcasts [ @leaf, :being_edited, users(:jason) ]
+  end
+
+  test "administrator can still receive presence on a published book without an access record" do
+    @book.update!(published: true)
+    @book.accesses.where(user: users(:jason)).delete_all
+    assert @book.editable?(user: users(:jason))
+
+    sign_in :jason
+    admin_stream = signed_stream_name_for_open_editor
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(@leaf), params: { leaf: { title: "Updated" }, page: { body: "Still editing." } }
+    end
+
+    assert_includes turbo_stream_broadcasts(admin_stream).join, users(:david).name
+  end
+
+  test "presence for one page is not sent on another page's channel" do
+    sign_in :kevin
+    other_leaf = leaves(:summary_page)
+    get edit_leafable_path(other_leaf)
+    other_stream = css_select("turbo-cable-stream-source").sole["signed-stream-name"]
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(@leaf), params: { leaf: { title: "Updated" }, page: { body: "Still editing." } }
+    end
+
+    assert_empty turbo_stream_broadcasts(other_stream)
+  end
+
+  private
+    def signed_stream_name_for_open_editor
+      get edit_leafable_path(@leaf)
+      assert_response :ok
+      css_select("turbo-cable-stream-source").sole["signed-stream-name"]
+    end
+
+    def turbo_stream_broadcasts(signed_stream_name)
+      stream_name = Turbo.signed_stream_verifier.verified(signed_stream_name)
+      broadcasts(stream_name)
+    end
+end
diff --git a/test/models/book/users_who_can_edit_test.rb b/test/models/book/users_who_can_edit_test.rb
new file mode 100644
index 0000000..791a8b1
--- /dev/null
+++ b/test/models/book/users_who_can_edit_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Book::UsersWhoCanEditTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "includes editors and excludes readers on an unpublished book" do
+    users = @book.users_who_can_edit
+
+    assert_includes users, users(:kevin)
+    assert_includes users, users(:david)
+    assert_includes users, users(:jason)
+    assert_not_includes users, users(:jz)
+  end
+
+  test "excludes a removed collaborator and an administrator without access when unpublished" do
+    @book.accesses.where(user: [ users(:kevin), users(:jason) ]).delete_all
+
+    users = @book.users_who_can_edit
+
+    assert_not_includes users, users(:kevin)
+    assert_not_includes users, users(:jason)
+    assert_includes users, users(:david)
+  end
+
+  test "includes administrators of a published book even without an access record" do
+    @book.update!(published: true)
+    @book.accesses.where(user: users(:jason)).delete_all
+
+    assert_includes @book.users_who_can_edit, users(:jason)
+    assert_not_includes @book.users_who_can_edit, users(:jz)
+  end
+
+  test "includes an administrator who only has reader access" do
+    @book.accesses.find_by!(user: users(:jason)).update!(level: :reader)
+
+    assert_includes @book.users_who_can_edit, users(:jason)
+  end
+end
