+++ b/app/models/title_cleanup_cursor.rb
@@ -0,0 +1,14 @@
+class TitleCleanupCursor < ApplicationRecord
+  def self.checkpoint!(leaf_id)
+    record = find_or_initialize_by(id: 1)
+    return if record.last_leaf_id && record.last_leaf_id >= leaf_id
+
+    record.last_leaf_id = leaf_id
+    record.save!
+  end
+
+  # Id to resume from: the leaf after the last one fully cleaned.
+  def self.next_id
+    where(id: 1).pick(:last_leaf_id)&.succ
+  end
+end
