diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..e4728d1
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,175 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    TitleCleanupCursor.delete_all
+  end
+
+  test "strips one layer of exporter quotes and keeps inner quotes" do
+    plain = press('"' + "Plain title" + '"')
+    quoted = press('"' + '"Quoted phrase" and more' + '"')
+    middle = press("Say " + '"hello"' + " now")
+    suffix_only = press("Ends with quote" + '"')
+    already_bare = press("Already bare")
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "Plain title", plain.reload.title
+    assert_equal '"Quoted phrase" and more', quoted.reload.title
+    assert_equal 'Say "hello" now', middle.reload.title
+    assert_equal "Ends with quote", suffix_only.reload.title
+    assert_equal "Already bare", already_bare.reload.title
+  end
+
+  test "a restarted job does not clean titles a second time" do
+    quoted = press('"' + '"Quoted phrase" and more' + '"')
+    tail = press('"' + "Tail" + '"')
+
+    TitleCleanupJob.perform_now
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Quoted phrase" and more', quoted.reload.title
+    assert_equal "Tail", tail.reload.title
+  end
+
+  test "after an interruption a fresh run finishes the tail and keeps inner quotes" do
+    quoted = press('"' + '"Keep" these' + '"')
+    second = press('"' + "Second" + '"')
+    tail = press('"' + "Tail" + '"')
+
+    with_kill_after(quoted) do
+      assert_raises(Exception) { TitleCleanupJob.perform_now }
+    end
+
+    assert_equal '"Keep" these', quoted.reload.title
+    assert_equal '"' + "Second" + '"', second.reload.title
+    assert_equal '"' + "Tail" + '"', tail.reload.title
+
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Keep" these', quoted.reload.title
+    assert_equal "Second", second.reload.title
+    assert_equal "Tail", tail.reload.title
+  end
+
+  test "a kill before the leaf commits redoes that leaf exactly once" do
+    quoted = press('"' + '"Keep" these' + '"')
+    tail = press('"' + "Tail" + '"')
+
+    job = TitleCleanupJob.new
+    job.define_singleton_method(:clean) do |leaf|
+      raise Exception, "killed mid-leaf" if leaf.id == quoted.id
+
+      super(leaf)
+    end
+
+    assert_raises(Exception) { job.perform_now }
+    assert_equal '"' + '"Keep" these' + '"', quoted.reload.title
+
+    TitleCleanupJob.perform_now
+
+    assert_equal '"Keep" these', quoted.reload.title
+    assert_equal "Tail", tail.reload.title
+  end
+
+  test "continuation interrupt resumes without recleaning finished titles" do
+    quoted = press('"' + '"Keep" these' + '"')
+    tail = press('"' + "Tail" + '"')
+
+    TitleCleanupJob.perform_later
+    interrupt_job_during_step(TitleCleanupJob, :cleanup_titles, cursor: quoted.id.succ) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal '"Keep" these', quoted.reload.title
+    assert_equal '"' + "Tail" + '"', tail.reload.title
+
+    perform_enqueued_jobs
+
+    assert_equal '"Keep" these', quoted.reload.title
+    assert_equal "Tail", tail.reload.title
+  end
+
+  test "non-contiguous ids are not skipped or repeated" do
+    first = press('"' + '"First" quote' + '"')
+    skipped = press('"' + "Gone" + '"')
+    tail = press('"' + "Tail" + '"')
+    skipped.destroy!
+
+    TitleCleanupJob.perform_now
+
+    assert_equal '"First" quote', first.reload.title
+    assert_equal "Tail", tail.reload.title
+
+    TitleCleanupJob.perform_now
+    assert_equal '"First" quote', first.reload.title
+    assert_equal "Tail", tail.reload.title
+  end
+
+  test "quote-only and empty wrapped titles are cleaned once" do
+    empty_wrapped = press('""')
+    quote_only = press('"')
+    triple = press('"' + '""Hello""' + '"')
+
+    TitleCleanupJob.perform_now
+    assert_equal "", empty_wrapped.reload.title
+    assert_equal "", quote_only.reload.title
+    assert_equal '""Hello""', triple.reload.title
+
+    TitleCleanupJob.perform_now
+    assert_equal "", empty_wrapped.reload.title
+    assert_equal "", quote_only.reload.title
+    assert_equal '""Hello""', triple.reload.title
+  end
+
+  test "repeated deploys finish the tail exactly once" do
+    leaves = 4.times.map { |i| press('"' + "\"Phrase #{i}\"" + '"') }
+
+    leaves.each do |leaf|
+      with_kill_after(leaf) do
+        assert_raises(Exception) { TitleCleanupJob.perform_now }
+      end
+    end
+
+    leaves.each_with_index do |leaf, i|
+      assert_equal "\"Phrase #{i}\"", leaf.reload.title
+    end
+
+    TitleCleanupJob.perform_now
+
+    leaves.each_with_index do |leaf, i|
+      assert_equal "\"Phrase #{i}\"", leaf.reload.title
+    end
+  end
+
+  test "fixture titles without exporter quotes are unchanged" do
+    welcome = leaves(:welcome_page)
+    original = welcome.title
+
+    TitleCleanupJob.perform_now
+
+    assert_equal original, welcome.reload.title
+    assert_equal "Welcome to The Handbook!", welcome.title
+  end
+
+  private
+    def press(title)
+      books(:handbook).press(Page.new(body: "body"), title: title)
+    end
+
+    def with_kill_after(leaf)
+      job = TitleCleanupJob
+      original = job.instance_method(:clean)
+      job.define_method(:clean) do |current|
+        original.bind_call(self, current)
+        raise Exception, "deploy interrupted the worker" if current.id == leaf.id
+      end
+      yield
+    ensure
+      job.define_method(:clean, original)
+    end
+end
