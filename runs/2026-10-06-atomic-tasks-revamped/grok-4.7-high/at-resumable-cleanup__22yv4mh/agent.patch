@@ -1,12 +1,36 @@
 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  # Resque cannot schedule jobs. Re-enqueue immediately so a stopping worker
+  # can hand the continuation to the next process without resque-scheduler.
+  self.resume_options = {}
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :cleanup_titles do |step|
+      Leaf.find_each(order: :asc, start: resume_from(step)) do |leaf|
+        # Commit the cleaned title and the cursor together. A kill before
+        # commit redoes this leaf; a kill after it does not, so inner quotes
+        # are never stripped twice. advance! checkpoints outside the
+        # transaction — Interrupt rolls transactions back.
+        clean(leaf)
+        step.advance! from: leaf.id
+      end
     end
   end
 
   private
+    def clean(leaf)
+      TitleCleanupCursor.transaction do
+        leaf.update!(title: cleaned(leaf.title))
+        TitleCleanupCursor.checkpoint!(leaf.id)
+      end
+    end
+
     def cleaned(title)
       title.delete_prefix('"').delete_suffix('"')
     end
+
+    def resume_from(step)
+      [ step.cursor, TitleCleanupCursor.next_id ].compact.map { |id| Integer(id) }.max
+    end
 end
