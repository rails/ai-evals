@@ -30,4 +30,36 @@ class SessionsController < ApplicationController
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
     end
+
+    # Shared links pass the page they point at as return_to. Only follow it when
+    # it stays on this host; anything else still signs the reader in at home.
+    def safe_return_to_url
+      candidate = params[:return_to]
+      if candidate.is_a?(String) && return_to_stays_on_this_host?(candidate)
+        candidate
+      else
+        post_authenticating_url
+      end
+    end
+
+    def return_to_stays_on_this_host?(url)
+      return false unless url.valid_encoding?
+      return false if url.match?(/[\x00-\x1f\x7f\\]/)
+      return false unless url_from(url)
+      return true if url.start_with?("/") && !url.start_with?("//", "/\\")
+
+      absolute_return_to_on_this_host?(url)
+    end
+
+    def absolute_return_to_on_this_host?(url)
+      host = Regexp.escape(request.host)
+      port = Regexp.escape(request.port.to_s)
+      pattern = if request.port == request.standard_port
+        %r{\Ahttps?://#{host}(?::#{port})?(?:[/?#]|\z)}i
+      else
+        %r{\Ahttps?://#{host}:#{port}(?:[/?#]|\z)}i
+      end
+
+      url.match?(pattern)
+    end
 end
