+
+    # return_to comes from shared links and the sign-in form, so it is not
+    # trusted. Only follow it when the reader stays on this origin; anything
+    # else falls back so a crafted link cannot bounce them onto another site.
+    def redirect_after_authentication
+      redirect_to safe_return_to_url || post_authenticating_url
+    rescue ActionController::Redirecting::UnsafeRedirectError
+      redirect_to post_authenticating_url
+    end
+
+    def safe_return_to_url
+      raw = params[:return_to]
+      return unless raw.is_a?(String)
+      return if raw.blank? || raw.match?(/[[:cntrl:]\\]/)
+      return unless url_from(raw)
+
+      uri = URI.parse(raw)
+      return unless acceptable_return_to?(raw, uri)
+
+      path = uri.path.presence || "/"
+      path = "/#{path}" unless path.start_with?("/")
+      return if path.start_with?("//") || path.include?("\\")
+
+      location = +"#{path}"
+      location << "?#{uri.query}" if uri.query.present?
+      location << "##{uri.fragment}" if uri.fragment.present?
+      location
+    rescue URI::InvalidURIError, ArgumentError
+      nil
+    end
+
+    def acceptable_return_to?(raw, uri)
+      if uri.host.nil? && uri.scheme.nil?
+        raw.start_with?("/") && !raw.start_with?("//")
+      else
+        %w[http https].include?(uri.scheme&.downcase) && uri.host == request.host && uri.port == request.port
+      end
+    end
 end
