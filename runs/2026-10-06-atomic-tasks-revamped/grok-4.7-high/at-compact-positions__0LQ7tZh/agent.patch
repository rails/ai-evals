+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+    @other = books(:manual)
+  end
+
+  test "compact_positions! keeps hand-arranged order and writes a dense sequence" do
+    # Creation order is welcome_section, welcome_page, summary_page, reading_picture.
+    # Arrange them into a different sequence with gaps left by deletions/moves.
+    leaves(:reading_picture).update_columns(position_score: 0.25)
+    leaves(:summary_page).update_columns(position_score: 2.5)
+    leaves(:welcome_section).update_columns(position_score: 10)
+    leaves(:welcome_page).update_columns(position_score: 40)
+
+    expected = [
+      leaves(:reading_picture),
+      leaves(:summary_page),
+      leaves(:welcome_section),
+      leaves(:welcome_page)
+    ]
+
+    @book.compact_positions!
+
+    assert_equal expected, @book.leaves.positioned.reload
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! puts a restored page back where it was arranged" do
+    leaves(:welcome_section).update_columns(position_score: 1)
+    leaves(:welcome_page).update_columns(position_score: 2)
+    leaves(:summary_page).update_columns(position_score: 3)
+    leaves(:reading_picture).update_columns(position_score: 4)
+    leaves(:summary_page).update_columns(status: "trashed")
+
+    @book.compact_positions!
+
+    assert_equal [ leaves(:welcome_section), leaves(:welcome_page), leaves(:reading_picture) ], @book.leaves.active.positioned.reload
+    assert_equal [ 1, 2, 4 ], @book.leaves.active.positioned.pluck(:position_score)
+
+    leaves(:summary_page).update!(status: "active")
+
+    assert_equal [
+      leaves(:welcome_section),
+      leaves(:welcome_page),
+      leaves(:summary_page),
+      leaves(:reading_picture)
+    ], @book.leaves.active.positioned.reload
+  end
+
+  test "compact_positions! does not touch other books" do
+    other_leaf = @other.press(Page.new(body: "Keep me"), title: "Kept")
+    other_leaf.update_columns(position_score: 7.5)
+
+    @book.compact_positions!
+
+    assert_equal 7.5, other_leaf.reload.position_score
+  end
+
+  test "compact_positions! is stable when scores are tied" do
+    leaves(:welcome_section).update_columns(position_score: 5)
+    leaves(:welcome_page).update_columns(position_score: 5)
+    leaves(:summary_page).update_columns(position_score: 5)
+    leaves(:reading_picture).update_columns(position_score: 5)
+
+    expected = @book.leaves.positioned.to_a
+    @book.compact_positions!
+
+    assert_equal expected.map(&:id), @book.leaves.positioned.reload.map(&:id)
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! succeeds for a book with no leaves" do
+    assert_nothing_raised { @other.compact_positions! }
+    assert_equal 0, @other.live_leaf_count
+  end
+
+  test "live_leaf_count counts leaves that are not in the trash" do
+    assert_equal 4, @book.live_leaf_count
+
+    leaves(:welcome_page).trashed!
+    leaves(:summary_page).trashed!
+
+    assert_equal 2, @book.live_leaf_count
+    assert_equal 0, @other.live_leaf_count
+  end
+
+  test "compact_positions! does not change status or live_leaf_count" do
+    leaves(:welcome_page).update_columns(status: "trashed", position_score: 2.2)
+
+    assert_no_changes -> { @book.live_leaf_count } do
+      @book.compact_positions!
+    end
+
+    assert leaves(:welcome_page).reload.trashed?
+  end
+end
