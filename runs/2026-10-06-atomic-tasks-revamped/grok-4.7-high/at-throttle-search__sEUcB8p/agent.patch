diff --git a/app/controllers/books/searches_controller.rb b/app/controllers/books/searches_controller.rb
index 5268c55..4623e79 100644
--- a/app/controllers/books/searches_controller.rb
+++ b/app/controllers/books/searches_controller.rb
@@ -3,6 +3,20 @@ class Books::SearchesController < ApplicationController
 
   include BookScoped
 
+  # NullStore (development without caching, and test) cannot count requests.
+  # A process-local memory store keeps the limit real there; production uses
+  # the shared cache (Redis) so workers agree on one count per address.
+  class << self
+    def rate_limit_cache
+      @rate_limit_cache ||= Rails.cache.is_a?(ActiveSupport::Cache::NullStore) ? ActiveSupport::Cache::MemoryStore.new : Rails.cache
+    end
+  end
+
+  # Thirty searches per address in any one-minute window. The counter expires
+  # with that window, so a burst lets go by itself — well within five minutes
+  # of it stopping — and nobody has to unblock the address.
+  rate_limit to: 30, within: 1.minute, only: :create, by: -> { request.remote_ip }, with: -> { head :too_many_requests }, store: rate_limit_cache
+
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
