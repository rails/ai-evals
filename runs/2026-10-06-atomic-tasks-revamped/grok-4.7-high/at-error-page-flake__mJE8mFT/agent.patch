diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..5607b74 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,28 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # `config.action_dispatch.show_exceptions` is copied into the memoized
+    # `Rails.application.env_config` the first time a request is built. Later
+    # writes to the config object do not reach ShowExceptions, so toggling it
+    # leaks across tests in the same process (and races under parallel workers).
+    # The header on env_config is what each request actually consults.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      env_config = nil
+      config = nil
+      previous_env = nil
+      previous_config = nil
+
+      env_config = Rails.application.env_config
+      config = Rails.application.config.action_dispatch
+      previous_env = env_config["action_dispatch.show_exceptions"]
+      previous_config = config.show_exceptions
+
+      env_config["action_dispatch.show_exceptions"] = :none
+      config.show_exceptions = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config["action_dispatch.show_exceptions"] = previous_env if env_config
+      config.show_exceptions = previous_config if config
     end
   end
 end
