diff --git a/test/controllers/security_findings_test.rb b/test/controllers/security_findings_test.rb
new file mode 100644
index 0000000..942b90d
--- /dev/null
+++ b/test/controllers/security_findings_test.rb
@@ -0,0 +1,236 @@
+require "test_helper"
+
+class SecurityFindingsTest < ActionDispatch::IntegrationTest
+  test "PT-01 member cannot grant themselves a role" do
+    sign_in :kevin
+    assert_not users(:kevin).administrator?
+
+    put user_profile_path(users(:kevin)), params: { user: { name: "Kevin K", email_address: "kevin-k@example.com", password: "anothersecret", role: "administrator" } }
+
+    assert_redirected_to users_path
+    user = users(:kevin).reload
+    assert_equal "Kevin K", user.name
+    assert_equal "kevin-k@example.com", user.email_address
+    assert user.authenticate("anothersecret")
+    assert_not user.administrator?
+  end
+
+  test "PT-01 member cannot grant a role with an integer or to somebody else" do
+    sign_in :kevin
+
+    put user_profile_path(users(:kevin)), params: { user: { role: 1 } }
+    assert_not users(:kevin).reload.administrator?
+
+    put user_profile_path(users(:kevin)), params: { user: { role: "1" } }
+    assert_not users(:kevin).reload.administrator?
+
+    put user_path(users(:jz)), params: { user: { role: "administrator" } }
+    assert_response :forbidden
+    assert_not users(:jz).reload.administrator?
+
+    put user_profile_path(users(:jz)), params: { user: { role: "administrator", name: "Hacked" } }
+    assert_response :forbidden
+    assert_equal "JZ", users(:jz).reload.name
+    assert_not users(:jz).administrator?
+  end
+
+  test "PT-01 administrator can still change roles" do
+    sign_in :david
+
+    put user_path(users(:kevin)), params: { user: { role: "administrator" } }
+
+    assert_redirected_to users_path
+    assert users(:kevin).reload.administrator?
+
+    put user_path(users(:kevin)), params: { user: { role: "member" } }
+    assert_not users(:kevin).reload.administrator?
+  end
+
+  test "PT-02 reader cannot destroy or change a book they may only read" do
+    sign_in :jz
+    assert_not books(:handbook).editable?(user: users(:jz))
+
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:handbook))
+    end
+    assert_response :forbidden
+    assert Book.exists?(books(:handbook).id)
+
+    patch book_path(books(:handbook)), params: { book: { title: "Taken" } }
+    assert_response :forbidden
+    assert_equal "Handbook", books(:handbook).reload.title
+  end
+
+  test "PT-02 signed-in user cannot destroy a published book they cannot edit" do
+    books(:manual).update!(published: true)
+    sign_in :kevin
+    assert_not books(:manual).editable?(user: users(:kevin))
+
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:manual))
+    end
+
+    assert_response :forbidden
+    assert Book.exists?(books(:manual).id)
+    assert_equal "Manual", books(:manual).reload.title
+  end
+
+  test "PT-02 editor can still update and delete a book" do
+    sign_in :kevin
+    assert books(:handbook).editable?(user: users(:kevin))
+
+    patch book_path(books(:handbook)), params: { book: { title: "Handbook Revised" } }
+    assert_redirected_to book_slug_path(books(:handbook).reload)
+    assert_equal "Handbook Revised", books(:handbook).title
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+    assert_redirected_to root_path
+  end
+
+  test "PT-03 search treats punctuation as data and stays inside readable books" do
+    books(:manual).press(Page.new(body: "hidden"), title: "Secret O'Brien plans")
+    leaves(:welcome_page).update!(title: "Welcome O'Brien")
+
+    sign_in :kevin
+
+    get library_search_path, params: { q: "O'Brien" }
+    assert_response :success
+    assert_select "a.search__result", text: /Welcome O'Brien/
+    assert_select "a.search__result", text: /Secret/, count: 0
+
+    get library_search_path, params: { q: "'" }
+    assert_response :success
+    assert_select "a.search__result", text: /Secret/, count: 0
+
+    get library_search_path, params: { q: "' OR 1=1 --" }
+    assert_response :success
+    assert_select "a.search__result", text: /Secret/, count: 0
+    assert_not_in_body "Manual"
+
+    get library_search_path, params: { q: "\" UNION SELECT title FROM books --" }
+    assert_response :success
+    assert_not_in_body "Manual"
+  end
+
+  test "PT-03 ordinary and case-insensitive searches still find readable titles" do
+    sign_in :kevin
+
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: "welcome" }
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Manual"
+  end
+
+  test "PT-03 signed-out search only returns published books" do
+    books(:manual).update!(published: true)
+    books(:manual).press(Page.new(body: "public"), title: "Published Manual Page")
+
+    sign_out
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: "Published Manual" }
+    assert_response :success
+    assert_in_body "Published Manual Page"
+  end
+
+  test "PT-04 percent and underscore are literal search characters" do
+    books(:handbook).press(Page.new(body: "deal"), title: "Save 50% off")
+    books(:handbook).press(Page.new(body: "deal"), title: "under_score")
+    leaves(:summary_page).update!(title: "Ordinary summary")
+
+    sign_in :kevin
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Ordinary summary"
+    assert_not_in_body "under_score"
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Ordinary summary"
+    assert_not_in_body "under_score"
+    assert_not_in_body "Welcome"
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_in_body "under_score"
+    assert_not_in_body "Save 50% off"
+    assert_not_in_body "Ordinary summary"
+    assert_not_in_body "Welcome"
+
+    get library_search_path, params: { q: "50%" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Ordinary summary"
+  end
+
+  test "PT-04 backslash and mixed punctuation stay literal" do
+    books(:handbook).press(Page.new(body: "deal"), title: "100%_done\\path")
+    leaves(:summary_page).update!(title: "100Xdone")
+
+    sign_in :kevin
+
+    get library_search_path, params: { q: "100%_done\\path" }
+    assert_response :success
+    assert_in_body "100%_done\\path"
+    assert_not_in_body "100Xdone"
+
+    get library_search_path, params: { q: "\\" }
+    assert_response :success
+    assert_in_body "100%_done\\path"
+    assert_not_in_body "Ordinary"
+    assert_not_in_body "Welcome"
+  end
+
+  test "PT-05 page from an unreadable book cannot be opened under another book id" do
+    secret = books(:manual).press(Page.new(body: "classified body"), title: "Classified")
+    sign_in :kevin
+
+    get leafable_slug_path(secret)
+    assert_response :not_found
+
+    get slugged_leafable_path(books(:handbook), books(:handbook).slug, secret, secret.slug)
+    assert_response :not_found
+
+    get book_page_path(books(:handbook), secret)
+    assert_response :not_found
+
+    get book_page_path(books(:handbook), secret, format: :md)
+    assert_response :not_found
+  end
+
+  test "PT-05 editor cannot change a foreign page by swapping the book id" do
+    secret = books(:manual).press(Page.new(body: "classified body"), title: "Classified")
+    sign_in :kevin
+
+    patch book_page_path(books(:handbook), secret), params: { leaf: { title: "Hacked" }, page: { body: "pwned" } }
+    assert_response :not_found
+    assert_equal "Classified", secret.reload.title
+  end
+
+  test "PT-05 readable pages stay readable including when signed out" do
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :not_found
+
+    books(:handbook).update!(published: true)
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+    assert_select "p", "This is such a great handbook."
+
+    sign_in :kevin
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+    assert_select "p", "This is such a great handbook."
+  end
+end
