diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..6fff2c0
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,90 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  # Byline left on books that stay readable after the creator is erased.
+  DELETED_AUTHOR = "Deleted author"
+
+  # Old "Remove" rewrote alice@example.com to alice-deactivated-<uuid>@example.com.
+  # Sign-in events were recorded under the address they actually used.
+  DEACTIVATED_EMAIL_INFIX = /-deactivated-[^@]+(?=@)/i
+
+  def erase
+    transaction do
+      addresses = email_addresses_for_erasure
+
+      release_shared_books
+      destroy_private_books
+
+      # delete_all skips session callbacks so we don't write a fresh sign-in
+      # event while erasing the ones that already exist.
+      reading_marks.delete_all
+      sessions.delete_all
+      accesses.delete_all
+      Leaf.purge_stale_search_index
+
+      association(:created_books).reset
+      association(:sessions).reset
+      association(:accesses).reset
+      association(:reading_marks).reset
+
+      destroy!
+      SignInEvent.delete_for_addresses(addresses)
+    end
+  end
+
+  private
+    def email_addresses_for_erasure
+      current = email_address.to_s
+      original = current.gsub(DEACTIVATED_EMAIL_INFIX, "")
+      [ current, original ].compact_blank.uniq
+    end
+
+    def release_shared_books
+      created_books.with_everyone_access.find_each do |book|
+        book.update! creator: nil, author: DELETED_AUTHOR
+      end
+    end
+
+    def destroy_private_books
+      created_books.where(everyone_access: false).find_each do |book|
+        destroy_book_and_search_hits!(book)
+      end
+    end
+
+    def destroy_book_and_search_hits!(book)
+      leaf_ids = book.leaves.pluck(:id)
+      destroy_edit_history!(book)
+      book.leaves.each { |leaf| purge_leafable_attachments!(leaf.leafable) }
+      book.cover.purge if book.cover.attached?
+      book.destroy!
+      Leaf.purge_search_index(leaf_ids)
+    end
+
+    # Edits are delete_all'd with the leaf, which orphans previous versions
+    # (and their markdown / attachments). Destroy those rows explicitly.
+    # Trash edits point at the current leafable; that one is purged with the leaf.
+    def destroy_edit_history!(book)
+      book.leaves.includes(:edits).find_each do |leaf|
+        leaf.edits.each do |edit|
+          leafable = edit.leafable
+          next if leafable.nil? || leafable == leaf.leafable
+
+          purge_leafable_attachments!(leafable)
+          leafable.destroy!
+        end
+      end
+    end
+
+    def purge_leafable_attachments!(leafable)
+      return if leafable.nil?
+
+      if leafable.respond_to?(:image) && leafable.image.attached?
+        leafable.image.purge
+      end
+
+      markdown = leafable.try(:markdown_body)
+      return unless markdown&.respond_to?(:uploads)
+
+      markdown.uploads.attachments.each(&:purge)
+    end
+end
