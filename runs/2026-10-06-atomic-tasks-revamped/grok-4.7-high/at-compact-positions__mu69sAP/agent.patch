+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compact_positions densifies scores without destroying hand-arranged order" do
+    leaves(:reading_picture).move_to_position(0)
+    leaves(:summary_page).update_column(:position_score, 80)
+
+    expected = books(:handbook).leaves.positioned.pluck(:id)
+
+    books(:handbook).compact_positions!
+
+    assert_equal expected, books(:handbook).leaves.positioned.pluck(:id)
+    assert_equal (1..expected.size).to_a, books(:handbook).leaves.positioned.pluck(:position_score)
+    assert_equal leaves(:reading_picture), books(:handbook).leaves.positioned.first
+  end
+
+  test "a page restored from the trash returns to its arranged place after compaction" do
+    leaves(:summary_page).move_to_position(0)
+    leaves(:welcome_page).move_to_position(1)
+    leaves(:summary_page).trashed!
+
+    expected = books(:handbook).leaves.order(:position_score, :id).pluck(:id)
+
+    books(:handbook).compact_positions!
+    leaves(:summary_page).active!
+
+    assert_equal expected, books(:handbook).leaves.active.positioned.pluck(:id)
+    assert_equal leaves(:summary_page), books(:handbook).leaves.active.positioned.first
+  end
+
+  test "compaction does not renumber another book's leaves" do
+    other = books(:manual)
+    other.press Page.new(body: "Kept"), title: "Kept"
+    before = other.leaves.pluck(:id, :position_score)
+
+    books(:handbook).compact_positions!
+
+    assert_equal before, other.leaves.pluck(:id, :position_score)
+  end
+
+  test "live_leaf_count counts pages that are not in the trash" do
+    assert_equal books(:handbook).leaves.active.count, books(:handbook).live_leaf_count
+
+    leaves(:summary_page).trashed!
+    leaves(:welcome_page).trashed!
+
+    assert_equal books(:handbook).leaves.active.count, books(:handbook).reload.live_leaf_count
+    assert_equal 2, books(:handbook).live_leaf_count
+  end
+end
