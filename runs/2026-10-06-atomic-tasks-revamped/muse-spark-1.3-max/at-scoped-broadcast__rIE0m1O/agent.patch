diff --git a/app/models/book/accessable.rb b/app/models/book/accessable.rb
index aa3dcf1..6028f11 100644
--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -32,6 +32,16 @@ module Book::Accessable
     accesses.find_by(user: user)
   end
 
+  def editable_users
+    editors = User.active.where(id: accesses.where(level: :editor).select(:user_id))
+    if published?
+      editors.or(User.active.administrator).distinct
+    else
+      admins_with_access = User.active.administrator.where(id: accesses.select(:user_id))
+      editors.or(admins_with_access).distinct
+    end
+  end
+
   def update_access(editors:, readers:)
     editors = Set.new(editors)
     readers = Set.new(everyone_access? ? User.active.ids : readers)
