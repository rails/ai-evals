index 0000000..986bea7
--- /dev/null
+++ b/config/initializers/search_rate_limit_test_reset.rb
@@ -0,0 +1,14 @@
+# Ensure book search rate-limit state does not leak between tests.
+# The limiter is in-memory per process, so without this, search requests
+# from earlier tests would count toward later tests sharing the same IP.
+if Rails.env.test?
+  ActiveSupport.on_load(:active_support_test_case) do
+    setup do
+      begin
+        "Books::SearchesController".constantize.clear_search_rate_limit!
+      rescue NameError, LoadError
+        # Controller not loaded yet; nothing to clear.
+      end
+    end
+  end
+end
