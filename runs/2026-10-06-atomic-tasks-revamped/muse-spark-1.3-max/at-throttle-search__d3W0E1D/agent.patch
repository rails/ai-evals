diff --git a/app/controllers/books/searches_controller.rb b/app/controllers/books/searches_controller.rb
index 5268c55..19b44e9 100644
--- a/app/controllers/books/searches_controller.rb
+++ b/app/controllers/books/searches_controller.rb
@@ -3,7 +3,62 @@ class Books::SearchesController < ApplicationController
 
   include BookScoped
 
+  SEARCH_RATE_LIMIT = 30
+  SEARCH_RATE_WINDOW = 60 # seconds
+  SEARCH_RATE_MAX_TRACKED_IPS = 10_000
+
+  @search_rate_attempts = {}
+  @search_rate_mutex = Mutex.new
+  @search_rate_last_cleanup_at = Time.now.to_f
+
+  class << self
+    attr_accessor :search_rate_attempts, :search_rate_mutex, :search_rate_last_cleanup_at
+
+    def clear_search_rate_limit!
+      search_rate_mutex.synchronize do
+        search_rate_attempts.clear
+        self.search_rate_last_cleanup_at = Time.current.to_f
+      end
+    end
+  end
+
+  prepend_before_action :throttle_book_search, only: :create
+
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    def throttle_book_search
+      ip = request.remote_ip.presence || request.ip.presence || "unknown"
+      now = Time.current.to_f
+      cutoff = now - SEARCH_RATE_WINDOW
+
+      exceeded = self.class.search_rate_mutex.synchronize do
+        attempts = (self.class.search_rate_attempts[ip] ||= [])
+        attempts.reject! { |timestamp| timestamp <= cutoff }
+
+        if attempts.size >= SEARCH_RATE_LIMIT
+          true
+        else
+          attempts << now
+
+          # Opportunistic cleanup to prevent unbounded growth from many IPs.
+          # Runs when tracking too many IPs or at most once every 5 minutes.
+          last_cleanup = self.class.search_rate_last_cleanup_at
+          if self.class.search_rate_attempts.size > SEARCH_RATE_MAX_TRACKED_IPS ||
+             (now - last_cleanup > 300)
+            self.class.search_rate_attempts.delete_if do |_key, timestamps|
+              timestamps.reject! { |timestamp| timestamp <= cutoff }
+              timestamps.empty?
+            end
+            self.class.search_rate_last_cleanup_at = now
+          end
+
+          false
+        end
+      end
+
+      head :too_many_requests if exceeded
+    end
 end
diff --git a/config/initializers/search_rate_limit_test_reset.rb b/config/initializers/search_rate_limit_test_reset.rb
