@@ -18,6 +20,20 @@ module Leaf::Editable
   end
 
   private
+    # Revision edits point at superseded leafables that would otherwise be
+    # orphaned when edits are deleted via delete_all. Destroy them so no
+    # rows (or their attachments/markdown) survive leaf deletion.
+    # Trash edits share the leaf's current leafable, which is destroyed via
+    # the delegated_type dependency -- skip those to avoid double-destroy.
+    def destroy_orphaned_edit_leafables
+      edits.find_each do |edit|
+        next if edit.leafable_type == leafable_type && edit.leafable_id == leafable_id
+        edit.leafable&.destroy!
+      rescue ActiveRecord::RecordNotFound
+        next
+      end
+    end
+
     def record_new_edit?(leafable_params)
       will_change_leafable?(leafable_params) && last_edit_old?
     end
