@@ -29,6 +33,34 @@ class User < ApplicationRecord
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
 
+    def erase_sign_in_events
+      SignInEvent.where(email_address: email_addresses_for_erasure).delete_all
+    end
+
+    # Deactivated users have a rewritten address like
+    # "alice-deactivated-<uuid>@example.com", but their sign-in log entries
+    # sit under the address they actually signed in with ("alice@example.com").
+    # Erasure must cover both the current (possibly rewritten) address and
+    # the restored original.
+    def email_addresses_for_erasure
+      addresses = [ email_address ]
+      if email_address.present? && email_address.include?("-deactivated-")
+        original = email_address.sub(/-deactivated-[^@]*@/, "@")
+        addresses << original if original != email_address
+      end
+      addresses.compact.uniq
+    end
+
+    def purge_orphaned_blobs
+      # Attachments for deleted books/leaves are destroyed synchronously,
+      # but their blobs are scheduled via purge_later (background jobs).
+      # For GDPR erasure, purge unattached blobs immediately so no rows
+      # or files remain.
+      ActiveStorage::Blob.unattached.find_each(&:purge)
+    rescue => error
+      Rails.logger.warn("Failed to purge orphaned blobs during user erasure: #{error.message}")
+    end
+
     def grant_access_to_everyone_books
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
diff --git a/app/models/user/authoring.rb b/app/models/user/authoring.rb
index bc70db7..d0565de 100644
--- a/app/models/user/authoring.rb
+++ b/app/models/user/authoring.rb
@@ -3,8 +3,22 @@ module User::Authoring
 
   included do
     has_many :created_books, class_name: "Book", foreign_key: :creator_id,
-      inverse_of: :creator, dependent: :destroy
+      inverse_of: :creator
 
-    has_many :reading_marks
+    has_many :reading_marks, dependent: :delete_all
+
+    before_destroy :erase_created_books
   end
+
+  private
+    def erase_created_books
+      # Books shared with everyone must keep working for other readers.
+      # Strip the creator and re-attribute to a generic byline.
+      Book.where(creator_id: id, everyone_access: true)
+          .update_all(creator_id: nil, author: "Deleted author", updated_at: Time.current)
+
+      # Every other book they created is personal data: destroy it fully
+      # (leaves, edits, attachments, search index entries, accesses, etc.).
+      Book.where(creator_id: id, everyone_access: false).find_each(&:destroy!)
+    end
 end
