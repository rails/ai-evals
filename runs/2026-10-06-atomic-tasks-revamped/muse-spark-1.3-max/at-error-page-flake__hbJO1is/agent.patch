--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -2,6 +2,33 @@ ENV["RAILS_ENV"] ||= "test"
 require_relative "../config/environment"
 require "rails/test_help"
 
+# with_raised_exceptions must be order-independent and safe under parallel
+# tests. Rails memoizes `Rails.application.env_config`
+# ("action_dispatch.show_exceptions") on the first request, so toggling only
+# `Rails.application.config.action_dispatch.show_exceptions` either has no
+# effect (when changed after the first request) or leaks to every later
+# request in the same process (when changed before the first request).
+# Mutating the global `env_config` instead would fix the sequential case but
+# is still racy when tests run in parallel threads: one test's window of
+# `:none` would leak into another test's requests, and concurrent
+# save/restore pairs can restore the wrong value.
+#
+# Instead, track the intent per-thread and honor it per-request in
+# `ExceptionWrapper#show?`, which both ShowExceptions and DebugExceptions
+# consult. No global state is mutated, so requests inside the block raise
+# while requests outside the block (in this thread or any other thread,
+# before or after) render normally.
+module WithRaisedExceptionsPatch
+  def show?(request)
+    if Thread.current.thread_variable_get(:__writebook_with_raised_exceptions).to_i > 0
+      false
+    else
+      super
+    end
+  end
+end
+ActionDispatch::ExceptionWrapper.prepend(WithRaisedExceptionsPatch)
+
 module ActiveSupport
   class TestCase
     # Run tests in parallel with specified workers
@@ -13,11 +40,18 @@ module ActiveSupport
     include SessionTestHelper
 
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      Thread.current.thread_variable_set(
+        :__writebook_with_raised_exceptions,
+        Thread.current.thread_variable_get(:__writebook_with_raised_exceptions).to_i + 1
+      )
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      current = Thread.current.thread_variable_get(:__writebook_with_raised_exceptions).to_i - 1
+      if current <= 0
+        Thread.current.thread_variable_set(:__writebook_with_raised_exceptions, nil)
+      else
+        Thread.current.thread_variable_set(:__writebook_with_raised_exceptions, current)
+      end
     end
   end
 end
