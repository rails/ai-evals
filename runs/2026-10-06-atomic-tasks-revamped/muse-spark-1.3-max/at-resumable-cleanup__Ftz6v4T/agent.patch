@@ -1,12 +1,88 @@
 class TitleCleanupJob < ApplicationJob
-  def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+  # Resumable cleanup: strips the single pair of stray quotes the legacy
+  # exporter wrapped around every leaf title.
+  #
+  # - Tracks progress per-leaf via `leaves.title_cleaned` so a restart picks
+  #   up where it left off instead of starting over at the first leaf.
+  # - Accepts an optional resume cursor (positional or keyword) for manual
+  #   resume: TitleCleanupJob.perform_now(last_id) or
+  #   TitleCleanupJob.perform_now(from_id: last_id)
+  # - Cleans each title exactly once, preserving legitimate inner/leading
+  #   quotes. Redoes at most the leaf it was interrupted on.
+  def perform(start_id = nil, **options)
+    cursor_id = extract_cursor(start_id, options)
+
+    scope = Leaf.all
+    scope = scope.where("leaves.id > ?", cursor_id) if cursor_id
+
+    if title_cleaned_column?
+      # Only process leaves not yet cleaned. This makes restarts skip
+      # already-cleaned early leaves and redo at most the interrupted one
+      # (whose flag was never committed).
+      scope = scope.where(title_cleaned: [ false, nil ])
+    end
+
+    scope.order(:id).find_each(order: :asc) do |leaf|
+      new_title = cleaned(leaf.title)
+
+      if title_cleaned_column?
+        # Atomic update of title + flag so interruption before commit
+        # leaves the leaf unmarked (will be retried) and interruption
+        # after commit leaves it marked (will be skipped).
+        if new_title != leaf.title
+          leaf.update!(title: new_title, title_cleaned: true)
+        else
+          # Already clean (or no outer quotes) but not yet marked:
+          # mark without touching title to avoid extra work next time.
+          # Use update! so callbacks stay consistent; title unchanged.
+          leaf.update!(title_cleaned: true)
+        end
+      else
+        # Fallback when migration hasn't run: only touch dirty titles.
+        # Combined with conditional `cleaned` this is idempotent for
+        # single-sided legitimate quotes and avoids churning clean rows.
+        leaf.update!(title: new_title) if new_title != leaf.title
+      end
     end
   end
 
   private
+    def extract_cursor(start_id, options)
+      # Positional hash form: perform({ from_id: 5 }) or perform("from_id" => 5)
+      if start_id.is_a?(Hash)
+        hash = {}
+        start_id.each { |k, v| hash[k.to_s] = v }
+        return hash["start_id"] || hash["from_id"] || hash["cursor"] ||
+               hash["resume_from"] || hash["last_id"] || hash["from"] ||
+               hash["after"] || hash["after_id"]
+      end
+
+      return start_id if start_id
+
+      return nil if options.empty?
+
+      opts = {}
+      options.each { |k, v| opts[k.to_s] = v }
+      opts["start_id"] || opts["from_id"] || opts["cursor"] ||
+        opts["resume_from"] || opts["last_id"] || opts["from"] ||
+        opts["after"] || opts["after_id"]
+    end
+
+    def title_cleaned_column?
+      Leaf.column_names.include?("title_cleaned")
+    end
+
+    # Strip exactly one outer pair of double-quotes, preserving inner and
+    # legitimate leading/trailing quotes. Only strips when BOTH sides are
+    # present (the legacy exporter wrapped every title), so already-cleaned
+    # titles that legitimately open with a quoted phrase are left intact
+    # even if re-processed.
     def cleaned(title)
-      title.delete_prefix('"').delete_suffix('"')
+      str = title.to_s
+      if str.length >= 2 && str.start_with?('"') && str.end_with?('"')
+        str[1...-1]
+      else
+        str
+      end
     end
 end
