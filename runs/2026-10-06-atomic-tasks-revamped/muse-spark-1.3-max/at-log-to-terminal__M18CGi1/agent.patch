diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..89c54bc 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -29,5 +29,27 @@ module Writebook
 
     # Opt in to 8.0 timezone behavior
     config.active_support.to_time_preserves_timezone = :zone
+
+    # Ensure `bin/rails runner` (e.g. script/library_report.rb) writes to both
+    # STDOUT and the environment log file, so the report is visible on the
+    # terminal while remaining recorded for log tooling.
+    runner do
+      if Rails.logger.respond_to?(:broadcast_to)
+        unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR)
+          stdout_logger = ActiveSupport::Logger.new(STDOUT)
+          stdout_logger.formatter = Rails.logger.formatter
+          stdout_logger.level = Rails.logger.level
+          Rails.logger.broadcast_to(stdout_logger)
+        end
+
+        log_path = Rails.root.join("log", "#{Rails.env}.log").to_s
+        unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, log_path)
+          file_logger = ActiveSupport::Logger.new(log_path)
+          file_logger.formatter = Rails.logger.formatter
+          file_logger.level = Rails.logger.level
+          Rails.logger.broadcast_to(file_logger)
+        end
+      end
+    end
   end
 end
