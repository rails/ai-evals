+
+    # Returns a safe location to redirect to after sign-in, or nil to fall back.
+    # Only allows relative paths on this host (e.g. "/books/1") and absolute
+    # URLs whose host matches the current request host. Anything else —
+    # external hosts, protocol-relative URLs, non-http(s) schemes, backslashes,
+    # control characters — is rejected.
+    def safe_return_to
+      value = params[:return_to]
+      return nil unless value.is_a?(String)
+
+      value = value.strip
+      return nil if value.empty?
+      return nil if value.include?("\\")
+      return nil if value.match?(/[\r\n\0]/)
+
+      downcased = value.downcase
+      return nil if downcased.match?(/%0[0-9a-f]|%1[0-9a-f]/)
+
+      begin
+        uri = URI.parse(value)
+      rescue URI::InvalidURIError, ArgumentError
+        return nil
+      end
+
+      if uri.host.present?
+        # Absolute URL (or protocol-relative). Reject protocol-relative outright
+        # and only allow http(s) URLs on this host.
+        return nil if uri.scheme.nil?
+        return nil unless %w[http https].include?(uri.scheme.downcase)
+        return nil unless uri.host.downcase == request.host.downcase
+
+        path = uri.path.presence || "/"
+        return nil unless path.start_with?("/")
+        return nil if path.downcase.start_with?("/%")
+
+        result = path
+        result += "?#{uri.query}" if uri.query.present?
+        result += "##{uri.fragment}" if uri.fragment.present?
+        result
+      else
+        # Relative URL: must not have a scheme (e.g. javascript:) and must be
+        # a path starting with a single slash.
+        return nil if uri.scheme.present?
+        return nil unless value.start_with?("/") && !value.start_with?("//")
+
+        path = uri.path.to_s
+        return nil unless path.start_with?("/")
+        downcased_path = path.downcase
+        return nil if downcased_path.start_with?("/%")
+
+        value
+      end
+    end
 end
