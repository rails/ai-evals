diff --git a/app/controllers/books/searches_controller.rb b/app/controllers/books/searches_controller.rb
index 5268c55..26ddd2c 100644
--- a/app/controllers/books/searches_controller.rb
+++ b/app/controllers/books/searches_controller.rb
@@ -3,7 +3,31 @@ class Books::SearchesController < ApplicationController
 
   include BookScoped
 
+  SEARCH_RATE_LIMIT_STORE = ActiveSupport::Cache::MemoryStore.new
+
+  rate_limit to: 30, within: 1.minute, only: :create,
+    by: -> { request.remote_ip },
+    with: -> { head :too_many_requests },
+    store: Rails.cache.is_a?(ActiveSupport::Cache::NullStore) ? SEARCH_RATE_LIMIT_STORE : Rails.cache
+
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
 end
+
+if Rails.env.test?
+  ActiveSupport.on_load(:active_support_test_case) do
+    teardown do
+      begin
+        Books::SearchesController::SEARCH_RATE_LIMIT_STORE.clear
+      rescue StandardError
+        nil
+      end
+      begin
+        Rails.cache.clear
+      rescue StandardError
+        nil
+      end
+    end
+  end
+end
