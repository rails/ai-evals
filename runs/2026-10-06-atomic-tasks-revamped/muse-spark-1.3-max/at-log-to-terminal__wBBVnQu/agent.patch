diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..897593b 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -29,5 +29,35 @@ module Writebook
 
     # Opt in to 8.0 timezone behavior
     config.active_support.to_time_preserves_timezone = :zone
+
+    # The import runbook ends with `bin/rails runner script/library_report.rb`,
+    # which reports via Rails.logger. By default that goes only to the
+    # environment's log file, so the terminal shows nothing. Broadcast runner
+    # logs to both STDOUT and the log file, preserving the record while making
+    # the report visible. Same messages, severities and order — just two sinks.
+    runner do |app|
+      app ||= Rails.application
+      if Rails.logger.is_a?(ActiveSupport::BroadcastLogger)
+        unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR)
+          stdout_logger = ActiveSupport::Logger.new(STDOUT)
+          stdout_logger.formatter = Rails.logger.formatter
+          stdout_logger.level = Rails.logger.level
+          Rails.logger.broadcast_to(stdout_logger)
+        end
+
+        log_path = app.config.paths["log"].first
+        unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, log_path)
+          log_file = app.config.default_log_file
+          file_logger = if app.config.log_file_size
+            ActiveSupport::Logger.new(log_file, 1, app.config.log_file_size)
+          else
+            ActiveSupport::Logger.new(log_file)
+          end
+          file_logger.formatter = Rails.logger.formatter
+          file_logger.level = Rails.logger.level
+          Rails.logger.broadcast_to(file_logger)
+        end
+      end
+    end
   end
 end
