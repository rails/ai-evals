diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..393c11d 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -29,5 +29,28 @@ module Writebook
 
     # Opt in to 8.0 timezone behavior
     config.active_support.to_time_preserves_timezone = :zone
+
+    # Ensure logs go to both STDOUT and the environment log file, so
+    # `rails runner` output is visible on the terminal while still recorded.
+    config.after_initialize do
+      if Rails.logger.respond_to?(:broadcast_to)
+        unless Rails.env.test?
+          unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR)
+            console = ActiveSupport::Logger.new(STDOUT)
+            console.formatter = Rails.logger.formatter
+            console.level = Rails.logger.level
+            Rails.logger.broadcast_to(console)
+          end
+        end
+
+        log_file = Rails.root.join("log/#{Rails.env}.log").to_s
+        unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, log_file)
+          file_logger = ActiveSupport::Logger.new(log_file)
+          file_logger.formatter = Rails.logger.formatter
+          file_logger.level = Rails.logger.level
+          Rails.logger.broadcast_to(file_logger)
+        end
+      end
+    end
   end
 end
