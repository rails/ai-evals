diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..bda06f2 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -13,11 +13,23 @@ module ActiveSupport
     include SessionTestHelper
 
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      app = Rails.application
+      # NOTE: The effective value used at request time comes from
+      # `app.env_config["action_dispatch.show_exceptions"]`, which is memoized
+      # from `config.action_dispatch.show_exceptions` on first use (see
+      # Rails::Application#env_config). Toggling only `config` therefore has no
+      # effect once memoized, and — if toggled before first memoization — leaks
+      # `:none` into subsequently memoized env_config for the rest of the process.
+      # Toggle both so the block always raises and the process always restores,
+      # regardless of what ran before or runs after in the same worker.
+      previous_config = app.config.action_dispatch.show_exceptions
+      previous_env = app.env_config["action_dispatch.show_exceptions"]
+      app.config.action_dispatch.show_exceptions = :none
+      app.env_config["action_dispatch.show_exceptions"] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      app.config.action_dispatch.show_exceptions = previous_config
+      app.env_config["action_dispatch.show_exceptions"] = previous_env
     end
   end
 end
