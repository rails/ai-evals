diff --git a/test/jobs/leaf/being_edited_broadcast_job_test.rb b/test/jobs/leaf/being_edited_broadcast_job_test.rb
new file mode 100644
index 0000000..d7c55c6
--- /dev/null
+++ b/test/jobs/leaf/being_edited_broadcast_job_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Leaf::BeingEditedBroadcastJobTest < ActiveJob::TestCase
+  include ActionCable::TestHelper
+
+  setup do
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "broadcasts the indicator to every current editor" do
+    Leaf::BeingEditedBroadcastJob.perform_now @leaf, users(:david)
+
+    %i[ david jason kevin ].each do |name|
+      messages = broadcasts(stream_name_for(users(name)))
+      assert_equal 1, messages.size, "expected broadcast for #{name}"
+      assert_includes messages.first, "David"
+    end
+  end
+
+  test "does not broadcast to readers" do
+    Leaf::BeingEditedBroadcastJob.perform_now @leaf, users(:david)
+    assert_empty broadcasts(stream_name_for(users(:jz)))
+  end
+
+  test "does not broadcast to a collaborator removed from the book" do
+    book = @leaf.book
+    book.update_access editors: [ users(:david).id, users(:jason).id ], readers: []
+
+    Leaf::BeingEditedBroadcastJob.perform_now @leaf, users(:david)
+
+    assert_empty broadcasts(stream_name_for(users(:kevin)))
+    assert_empty broadcasts(Turbo::StreamsChannel.send(:stream_name_from, [ @leaf, :being_edited ]))
+  end
+
+  test "does not broadcast to a collaborator demoted to reader" do
+    @leaf.book.accesses.find_by(user: users(:kevin)).update! level: :reader
+
+    Leaf::BeingEditedBroadcastJob.perform_now @leaf, users(:david)
+
+    assert_empty broadcasts(stream_name_for(users(:kevin)))
+  end
+
+  private
+    def stream_name_for(user)
+      Turbo::StreamsChannel.send(:stream_name_from, [ @leaf, user, :being_edited ])
+    end
+end
