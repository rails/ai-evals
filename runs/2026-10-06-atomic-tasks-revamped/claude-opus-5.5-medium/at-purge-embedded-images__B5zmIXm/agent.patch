diff --git a/test/models/page/upload_cleanup_test.rb b/test/models/page/upload_cleanup_test.rb
new file mode 100644
index 0000000..0959de7
--- /dev/null
+++ b/test/models/page/upload_cleanup_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class Page::UploadCleanupTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges its markdown uploads" do
+    page = pages(:welcome)
+    page.body.tap(&:save!).uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = page.body.uploads.attachments.last
+    blob = attachment.blob
+    assert blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs do
+      Page.find(page.id).leaf.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+
+  test "destroying the page directly purges uploads" do
+    page = pages(:welcome)
+    page.body.tap(&:save!).uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    blob = page.body.uploads.blobs.last
+
+    perform_enqueued_jobs { Page.find(page.id).destroy! }
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+end
