@@ -0,0 +1,77 @@
+require "test_helper"
+
+class PageUploadsPurgeTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges images uploaded into its markdown" do
+    page = pages(:welcome)
+    page.body.save!
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = page.body.uploads.attachments.last
+    blob = attachment.blob
+    assert blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs { page.leaf.destroy! }
+
+    assert_not Page.exists?(page.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+
+  test "destroying a page directly purges its uploads" do
+    page = pages(:welcome)
+    page.body.save!
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    blob = page.body.uploads.last.blob
+
+    perform_enqueued_jobs { page.destroy! }
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+end
+
+class PageUploadsPurgeWithHistoryTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a leaf with edit history and trash purges uploads held by old revisions" do
+    leaf = leaves(:welcome_page)
+    page = leaf.page
+    page.body.save!
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    blob = page.body.uploads.last.blob
+
+    leaf.edits.destroy_all
+    leaf.edit leafable_params: { body: "![img](/u/#{page.body.uploads.last.slug})" }
+    assert_equal 1, leaf.edits.count
+    leaf.trashed!
+
+    perform_enqueued_jobs { leaf.reload.destroy! }
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+    assert_equal 0, Edit.where(leaf_id: leaf.id).count
+  end
+end
+
+class PictureRevisionSharedBlobTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying an old picture revision does not purge the blob still used by the current picture" do
+    leaf = leaves(:reading_picture)
+    leaf.picture.image.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    blob = leaf.picture.image.blob
+    leaf.edits.destroy_all
+    leaf.edit leafable_params: { caption: "New caption" }
+    leaf.reload
+    old = leaf.edits.last.leafable
+    assert_not_equal old, leaf.picture
+    assert_equal blob, leaf.picture.image.blob
+
+    perform_enqueued_jobs { old.destroy! }
+
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert blob.service.exist?(blob.key)
+  end
+end
