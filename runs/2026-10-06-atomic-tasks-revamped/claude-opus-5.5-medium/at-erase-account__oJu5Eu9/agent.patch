diff --git a/lib/tasks/users.rake b/lib/tasks/users.rake
new file mode 100644
index 0000000..4a69d18
--- /dev/null
+++ b/lib/tasks/users.rake
@@ -0,0 +1,23 @@
+namespace :users do
+  desc "Permanently erase a person (GDPR). Accepts a user id or the email address they signed up with, including people who were deactivated."
+  task :erase, [ :id_or_email ] => :environment do |_, args|
+    key = args[:id_or_email].to_s.strip
+    abort "Usage: bin/rails 'users:erase[alice@example.com]'" if key.empty?
+
+    users = if key.match?(/\A\d+\z/)
+      User.where(id: key)
+    else
+      User.all.select { it.sign_in_email_addresses.any? { |address| address.casecmp?(key) } }
+    end
+
+    abort "No user found for #{key}" if users.empty?
+    if users.many?
+      abort "Several users match #{key}: " + users.map { "##{it.id} (#{it.email_address})" }.join(", ") + ". Erase them one at a time by id."
+    end
+
+    users.each do |user|
+      user.erase
+      puts "Erased user ##{user.id}"
+    end
+  end
+end
