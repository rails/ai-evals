diff --git a/app/models/picture.rb b/app/models/picture.rb
index 9bcf18f..64f829d 100644
--- a/app/models/picture.rb
+++ b/app/models/picture.rb
@@ -1,8 +1,12 @@
 class Picture < ApplicationRecord
   include Leafable
 
+  # Transformations must be JSON-safe: readers request variants via a JSON-encoded
+  # variation key, where symbol values come back as strings. A symbol here would give
+  # the background-processed variant a different digest than the one readers request,
+  # and a duplicate variant would be generated and stored on first view.
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..1d3d5aa 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class PicturesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -38,4 +40,31 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "uploaded image is derived once and reused when read" do
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:reading_picture)), params: {
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") } }
+    end
+
+    picture = Picture.last
+    assert_equal 1, picture.image.blob.variant_records.count
+
+    transforms = 0
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transforms += 1 }
+
+    get book_slug_path(books(:handbook))
+    image_src = css_select("img").map { |img| img["src"] }.find { |src| src.include?("/representations/") }
+    assert image_src
+
+    get image_src
+    follow_redirect! while response.redirect?
+    assert_response :ok
+
+    assert_equal 0, transforms
+    assert_equal 1, picture.image.blob.variant_records.count
+    assert_equal picture.image.variant(:large).processed.download, response.body
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+  end
 end
