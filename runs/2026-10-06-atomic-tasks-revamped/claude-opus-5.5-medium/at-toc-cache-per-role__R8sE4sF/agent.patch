diff --git a/test/integration/toc_caching_test.rb b/test/integration/toc_caching_test.rb
new file mode 100644
index 0000000..1ed7d38
--- /dev/null
+++ b/test/integration/toc_caching_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class TocCachingTest < ActionDispatch::IntegrationTest
+  STORE = ActiveSupport::Cache::MemoryStore.new
+
+  setup do
+    @original_store = Rails.cache
+    @original_perform = ActionController::Base.perform_caching
+    STORE.clear
+    Rails.cache = STORE
+    ActionController::Base.cache_store = Rails.cache
+    @original_collection_cache = ActionView::PartialRenderer.collection_cache
+    ActionView::PartialRenderer.collection_cache = STORE
+    ActionController::Base.perform_caching = true
+  end
+
+  teardown do
+    Rails.cache = @original_store
+    ActionController::Base.cache_store = @original_store
+    ActionView::PartialRenderer.collection_cache = @original_collection_cache
+    ActionController::Base.perform_caching = @original_perform
+  end
+
+  test "reader never gets editor controls after an editor viewed the book" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']"
+    sign_out
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']", count: 0
+  end
+
+  test "editor gets editor controls after a reader viewed the book" do
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']", count: 0
+    sign_out
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']"
+  end
+
+  test "reader never gets editor controls after book changes" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    sign_out
+    books(:handbook).update!(subtitle: "Changed")
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']", count: 0
+  end
+
+  test "editor keeps controls after book changes" do
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    sign_out
+    books(:handbook).update!(subtitle: "Changed")
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']"
+  end
+  test "renamed leaf shows new title to next visitor" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    leaves(:welcome_page).update!(title: "Brand New Title")
+    sign_out
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_in_body "Brand New Title"
+  end
+
+  test "rendering the toc does not query per leaf" do
+    sign_in :kevin
+    baseline = count_queries { get book_slug_path(books(:handbook)) }
+
+    20.times { |i| books(:handbook).press Section.new(body: "Extra"), title: "Extra #{i}" }
+    STORE.clear
+    sign_in :kevin
+
+    assert_equal baseline, count_queries { get book_slug_path(books(:handbook)) }
+  end
+
+  private
+    def count_queries(&block)
+      count = 0
+      callback = ->(*, payload) { count += 1 unless payload[:name] == "SCHEMA" || payload[:cached] }
+      ActiveSupport::Notifications.subscribed(callback, "sql.active_record", &block)
+      count
+    end
+end
