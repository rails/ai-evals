diff --git a/app/controllers/concerns/search_rate_limited.rb b/app/controllers/concerns/search_rate_limited.rb
new file mode 100644
index 0000000..6038d21
--- /dev/null
+++ b/app/controllers/concerns/search_rate_limited.rb
@@ -0,0 +1,62 @@
+# Throttles full-text searches per client address with a sliding window.
+#
+# Each address may have at most LIMIT searches served in any WINDOW-long
+# stretch. Further requests are refused with 429 Too Many Requests, before any
+# authentication or database work happens. Refused requests are not counted, so
+# an address is served again as soon as its served requests age out of the
+# window — no manual unblocking is needed.
+#
+# Served requests are counted in one-second buckets. When checking, the window
+# also includes the oldest partial second, so the limit is never exceeded in any
+# real WINDOW-long stretch (at worst it is about one second stricter).
+module SearchRateLimited
+  extend ActiveSupport::Concern
+
+  LIMIT  = 30
+  WINDOW = 1.minute
+
+  included do
+    prepend_before_action :enforce_search_rate_limit, only: :create
+  end
+
+  class << self
+    def store
+      @store ||= Rails.cache.is_a?(ActiveSupport::Cache::NullStore) ? ActiveSupport::Cache::MemoryStore.new : Rails.cache
+    end
+
+    attr_writer :store
+
+    def reset
+      store.clear if store.is_a?(ActiveSupport::Cache::MemoryStore)
+    end
+
+    # Records a request from +address+ and returns true if it may be served.
+    def permit?(address, now: Time.now)
+      current = now.to_i
+      buckets = (current - WINDOW.to_i..current).map { |second| key_for(address, second) }
+      current_key = buckets.last
+
+      count = store.increment(current_key, 1, expires_in: WINDOW + 5.seconds)
+      return true if count.nil? # cache unavailable: fail open rather than break search
+
+      earlier = store.read_multi(*buckets[0...-1], raw: true).values.sum(&:to_i)
+
+      if earlier + count > LIMIT
+        store.decrement(current_key, 1, expires_in: WINDOW + 5.seconds)
+        false
+      else
+        true
+      end
+    end
+
+    private
+      def key_for(address, second)
+        "search-rate-limit:#{address}:#{second}"
+      end
+  end
+
+  private
+    def enforce_search_rate_limit
+      head :too_many_requests unless SearchRateLimited.permit?(request.remote_ip)
+    end
+end
diff --git a/config/initializers/search_rate_limit.rb b/config/initializers/search_rate_limit.rb
new file mode 100644
index 0000000..0ce737e
--- /dev/null
+++ b/config/initializers/search_rate_limit.rb
@@ -0,0 +1,7 @@
+# Give every test a clean search rate limit so requests in one test can't
+# cause 429s in another.
+if Rails.env.test?
+  ActiveSupport.on_load(:active_support_test_case) do
+    setup { SearchRateLimited.reset }
+  end
+end
diff --git a/test/controllers/books/search_rate_limit_test.rb b/test/controllers/books/search_rate_limit_test.rb
new file mode 100644
index 0000000..0febda0
--- /dev/null
+++ b/test/controllers/books/search_rate_limit_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Books::SearchRateLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    Leaf.reindex_all
+    books(:handbook).update!(published: true)
+  end
+
+  test "refuses an address after thirty searches in a minute, then lets go" do
+    30.times { search_from "1.2.3.4"; assert_response :success }
+
+    search_from "1.2.3.4"
+    assert_response :too_many_requests
+
+    travel 61.seconds
+    search_from "1.2.3.4"
+    assert_response :success
+  end
+
+  test "a refused address does not affect other readers or the book's pages" do
+    31.times { search_from "1.2.3.4" }
+    assert_response :too_many_requests
+
+    search_from "5.6.7.8"
+    assert_response :success
+    assert_select "a", text: /Thanks for reading/i
+
+    get book_slug_path(books(:handbook)), headers: { "REMOTE_ADDR" => "1.2.3.4" }
+    assert_response :success
+  end
+
+  test "the limit applies to any one-minute stretch" do
+    15.times { search_from "1.2.3.4" }
+    travel 50.seconds
+    15.times { search_from "1.2.3.4"; assert_response :success }
+
+    travel 5.seconds
+    search_from "1.2.3.4"
+    assert_response :too_many_requests
+  end
+
+  private
+    def search_from(ip)
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => ip }
+    end
+end
