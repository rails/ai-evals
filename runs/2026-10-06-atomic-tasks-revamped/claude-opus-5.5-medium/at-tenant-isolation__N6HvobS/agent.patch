diff --git a/app/models/user/tenanted.rb b/app/models/user/tenanted.rb
new file mode 100644
index 0000000..ad9fd65
--- /dev/null
+++ b/app/models/user/tenanted.rb
@@ -0,0 +1,16 @@
+module User::Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    # Users without a tenant (and users in no tenant) behave as before: no partitioning.
+    scope :sharing_tenant_with, ->(tenant_id) {
+      tenant_id.nil? ? all : where(tenant_id: [ tenant_id, nil ])
+    }
+  end
+
+  def shares_tenant_with?(record)
+    tenant_id.nil? || record.tenant_id.nil? || tenant_id == record.tenant_id
+  end
+end
