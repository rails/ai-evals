diff --git a/app/models/book/tenanted.rb b/app/models/book/tenanted.rb
new file mode 100644
index 0000000..e2b21d3
--- /dev/null
+++ b/app/models/book/tenanted.rb
@@ -0,0 +1,13 @@
+module Book::Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    # Books visible to a user given tenant partitioning. Rows without a tenant behave as before.
+    scope :within_tenant_of, ->(user) {
+      tenant_id = user&.tenant_id
+      tenant_id.nil? ? all : where(tenant_id: [ tenant_id, nil ])
+    }
+  end
+end
