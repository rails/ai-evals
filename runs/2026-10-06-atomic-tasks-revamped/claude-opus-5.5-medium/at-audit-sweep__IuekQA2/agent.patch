diff --git a/test/controllers/pentest_regression_test.rb b/test/controllers/pentest_regression_test.rb
new file mode 100644
index 0000000..4f5612b
--- /dev/null
+++ b/test/controllers/pentest_regression_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class PentestRegressionTest < ActionDispatch::IntegrationTest
+  test "PT-01 member cannot grant self role via profile" do
+    sign_in :kevin
+    put user_profile_path(users(:kevin)), params: { user: { name: "Kev", role: "administrator" } }
+    assert_equal "Kev", users(:kevin).reload.name
+    assert users(:kevin).member?
+  end
+
+  test "PT-02 reader cannot destroy book, even published" do
+    books(:manual).update!(published: true)
+    sign_in :kevin
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:manual))
+    end
+    assert_response :forbidden
+    sign_in :jz
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:handbook))
+    end
+    assert_response :forbidden
+  end
+
+  test "PT-02 editor can destroy" do
+    sign_in :kevin
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+  end
+
+  test "PT-03/04 search" do
+    sign_in :kevin
+    get library_search_path(q: "x') or 1=1 --")
+    assert_response :success
+    get library_search_path(q: "%' union select * from leaves --")
+    assert_response :success
+    get library_search_path(q: "Welcome")
+    assert_in_body "Welcome to The Handbook!"
+    books(:handbook).press Page.new(body: "x"), title: "Save 50% off"
+    get library_search_path(q: "%")
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+    get library_search_path(q: "50%")
+    assert_in_body "Save 50% off"
+    get library_search_path(q: "_")
+    assert_not_in_body "Welcome to The Handbook!"
+    get library_search_path(q: "Save 50% off")
+    assert_in_body "Save 50% off"
+  end
+
+  test "PT-05 idor" do
+    leaf = books(:manual).press Page.new(body: "secret"), title: "Secret manual page"
+    sign_in :kevin
+    get slugged_leafable_path(books(:handbook), "handbook", leaf, "x")
+    assert_response :not_found
+    get book_page_path(books(:handbook), leaf)
+    assert_response :not_found
+    get slugged_leafable_path(books(:handbook), "handbook", leaves(:welcome_page), "x")
+    assert_response :success
+  end
+
+  test "PT-05 signed out published" do
+    books(:handbook).update!(published: true)
+    get slugged_leafable_path(books(:handbook), "handbook", leaves(:welcome_page), "x")
+    assert_response :success
+  end
+end
