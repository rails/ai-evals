diff --git a/test/integration/book_toc_caching_test.rb b/test/integration/book_toc_caching_test.rb
new file mode 100644
index 0000000..c10ee26
--- /dev/null
+++ b/test/integration/book_toc_caching_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class BookTocCachingTest < ActionDispatch::IntegrationTest
+  CACHE = ActiveSupport::Cache::MemoryStore.new
+
+  setup do
+    CACHE.clear
+    @original_store = ActionController::Base.cache_store
+    @original_collection_cache = ActionView::PartialRenderer.collection_cache
+    @original_perform = ActionController::Base.perform_caching
+    ActionController::Base.cache_store = CACHE
+    ActionView::PartialRenderer.collection_cache = CACHE
+    ActionController::Base.perform_caching = true
+    @book = books(:handbook)
+    @leaf = leaves(:welcome_page)
+  end
+
+  teardown do
+    ActionController::Base.cache_store = @original_store
+    ActionView::PartialRenderer.collection_cache = @original_collection_cache
+    ActionController::Base.perform_caching = @original_perform
+  end
+
+  test "reader never gets editor controls after an editor warmed the cache" do
+    sign_in :kevin
+    get book_slug_path(@book)
+    assert_select "a[href='#{edit_leafable_path(@leaf)}']"
+
+    sign_out
+    sign_in :jz
+    get book_slug_path(@book)
+    assert_response :success
+    assert_select "a[href='#{edit_leafable_path(@leaf)}']", count: 0
+    assert_select "a[href='#{leafable_slug_path(@leaf)}']"
+  end
+
+  test "editor always gets editor controls after a reader warmed the cache" do
+    sign_in :jz
+    get book_slug_path(@book)
+    assert_select "a[href='#{edit_leafable_path(@leaf)}']", count: 0
+
+    sign_out
+    sign_in :kevin
+    get book_slug_path(@book)
+    assert_select "a[href='#{edit_leafable_path(@leaf)}']"
+  end
+
+  test "editor controls survive book touch with reader-cached leaves" do
+    sign_in :jz
+    get book_slug_path(@book)
+    sign_out
+
+    sign_in :kevin
+    get book_slug_path(@book)
+    assert_select "a[href='#{edit_leafable_path(@leaf)}']"
+    sign_out
+
+    @book.touch
+    sign_in :jz
+    get book_slug_path(@book)
+    assert_select "a[href='#{edit_leafable_path(@leaf)}']", count: 0
+  end
+
+  test "renamed entry shows its new title to the next visitor" do
+    sign_in :jz
+    get book_slug_path(@book)
+    assert_in_body "Welcome to The Handbook!"
+
+    @leaf.edit leaf_params: { title: "Renamed Welcome" }
+
+    sign_out
+    sign_in :kevin
+    get book_slug_path(@book)
+    assert_in_body "Renamed Welcome"
+    sign_out
+    sign_in :jz
+    get book_slug_path(@book)
+    assert_in_body "Renamed Welcome"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "rendering the toc does not query accesses per entry" do
+    sign_in :kevin
+    queries = []
+    callback = ->(*, payload) { queries << payload[:sql] if payload[:sql] =~ /FROM "accesses"/ }
+    ActiveSupport::Notifications.subscribed(callback, "sql.active_record") do
+      get book_slug_path(@book)
+    end
+    assert_response :success
+    assert_operator queries.size, :<=, 3, queries.join("\n")
+  end
+end
