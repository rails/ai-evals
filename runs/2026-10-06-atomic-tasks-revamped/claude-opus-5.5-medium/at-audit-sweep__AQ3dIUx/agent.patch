diff --git a/test/controllers/security_findings_test.rb b/test/controllers/security_findings_test.rb
new file mode 100644
index 0000000..5265b33
--- /dev/null
+++ b/test/controllers/security_findings_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class SecurityFindingsTest < ActionDispatch::IntegrationTest
+  test "PT-01 member cannot grant self a role via profile" do
+    sign_in :kevin
+    put user_profile_url(users(:kevin)), params: { user: { name: "K", role: "administrator" } }
+    assert_equal "K", users(:kevin).reload.name
+    assert users(:kevin).member?
+    put user_profile_url(users(:jz)), params: { user: { role: "administrator" } }
+    assert users(:jz).reload.member?
+  end
+
+  test "PT-02 reader cannot destroy, editor can" do
+    sign_in :jz
+    assert_no_difference -> { Book.count } do
+      delete book_url(books(:handbook))
+    end
+    assert_response :forbidden
+    books(:manual).update!(published: true)
+    sign_in :kevin
+    assert_no_difference -> { Book.count } do
+      delete book_url(books(:manual))
+    end
+    assert_response :forbidden
+    assert_difference -> { Book.count }, -1 do
+      delete book_url(books(:handbook))
+    end
+  end
+
+  test "PT-03/04 search" do
+    sign_in :kevin
+    secret = books(:manual).press(Page.new(body: "x"), title: "Secret stuff")
+    get library_search_url(q: "') or 1=1 or ('")
+    assert_response :success
+    get library_search_url(q: "Secret")
+    assert_no_match "Secret stuff", response.body
+    get library_search_url(q: "it's")
+    assert_response :success
+    books(:handbook).press(Page.new(body: "x"), title: "Save 50% off")
+    books(:handbook).press(Page.new(body: "x"), title: "Save 500 off")
+    get library_search_url(q: "%")
+    assert_match "Save 50% off", response.body
+    assert_no_match "Save 500 off", response.body
+    assert_no_match "Welcome", response.body
+    get library_search_url(q: "50% off")
+    assert_match "Save 50% off", response.body
+    get library_search_url(q: "_")
+    assert_no_match "Save", response.body
+    get library_search_url(q: "Welcome")
+    assert_match "Welcome to The Handbook", response.body
+  end
+
+  test "PT-05 leaf of unreadable book under other book id" do
+    sign_in :kevin
+    secret = books(:manual).press(Page.new(body: "topsecret"), title: "Secret")
+    get book_page_url(books(:handbook), secret)
+    assert_response :not_found
+    get slugged_leafable_url(books(:handbook).id, "handbook", secret.id, "secret")
+    assert_response :not_found
+    sign_out
+    books(:handbook).update!(published: true)
+    get slugged_leafable_url(books(:handbook).id, "handbook", secret.id, "secret")
+    assert_response :not_found
+    get slugged_leafable_url(books(:handbook).id, "handbook", leaves(:welcome_page).id, "x")
+    assert_response :success
+  end
+end
