diff --git a/test/integration/book_toc_caching_test.rb b/test/integration/book_toc_caching_test.rb
new file mode 100644
index 0000000..9571a61
--- /dev/null
+++ b/test/integration/book_toc_caching_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class BookTocCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_store = ActionController::Base.cache_store
+    @original_perform = ActionController::Base.perform_caching
+    @original_collection_cache = ActionView::PartialRenderer.collection_cache
+    store = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.cache_store = store
+    ActionView::PartialRenderer.collection_cache = store
+    ActionController::Base.perform_caching = true
+  end
+
+  teardown do
+    ActionController::Base.cache_store = @original_store
+    ActionController::Base.perform_caching = @original_perform
+    ActionView::PartialRenderer.collection_cache = @original_collection_cache
+  end
+
+  test "reader does not get editor controls after an editor viewed the book" do
+    leaf = leaves(:welcome_page)
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_select "a[href='#{edit_leafable_path(leaf)}']"
+    sign_out
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_select "a[href='#{edit_leafable_path(leaf)}']", count: 0
+    assert_select "a.toc__title[href='#{leafable_slug_path(leaf)}']"
+  end
+
+  test "editor gets editor controls after a reader viewed the book" do
+    leaf = leaves(:welcome_page)
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_select "a[href='#{edit_leafable_path(leaf)}']", count: 0
+    sign_out
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_select "a[href='#{edit_leafable_path(leaf)}']"
+  end
+
+  test "renamed leaf shows new title" do
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_in_body "Welcome to The Handbook!"
+
+    leaves(:welcome_page).update!(title: "Freshly Renamed")
+    get book_slug_path(books(:handbook))
+    assert_in_body "Freshly Renamed"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "access lookups do not scale with the number of leaves" do
+    sign_in :kevin
+    book = books(:handbook)
+
+    count_access_queries = -> do
+      count = 0
+      callback = ->(*, payload) { count += 1 if payload[:sql] =~ /FROM "accesses"/ }
+      ActiveSupport::Notifications.subscribed(callback, "sql.active_record") { get book_slug_path(book) }
+      count
+    end
+
+    cold = count_access_queries.call
+    warm = count_access_queries.call
+    assert_operator cold, :<=, 3
+    assert_operator warm, :<=, 3
+  end
+end
