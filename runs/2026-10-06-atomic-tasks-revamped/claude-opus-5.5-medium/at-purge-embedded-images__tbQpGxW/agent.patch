diff --git a/lib/rails_ext/action_text_markdown.rb b/lib/rails_ext/action_text_markdown.rb
index fa0a622..d62df00 100644
--- a/lib/rails_ext/action_text_markdown.rb
+++ b/lib/rails_ext/action_text_markdown.rb
@@ -29,14 +29,15 @@ module ActionText::Markdown::Uploads
   extend ActiveSupport::Concern
 
   included do
-    has_many_attached :uploads, dependent: :destroy
+    has_many_attached :uploads, dependent: :purge_later
   end
 end
 
-ActiveSupport.on_load :active_storage_attachment do
-  class ActionText::Markdown
-    include ActionText::Markdown::Uploads
-  end
+# Include once the app has booted (rather than waiting for ActiveStorage::Attachment to be
+# autoloaded) so the uploads association, and its purge-on-destroy behavior, is always
+# defined before any page can be destroyed.
+Rails.application.config.after_initialize do
+  ActionText::Markdown.include ActionText::Markdown::Uploads
 end
 
 ActiveSupport.run_load_hooks :action_text_markdown, ActionText::Markdown
diff --git a/test/models/page_upload_purge_test.rb b/test/models/page_upload_purge_test.rb
new file mode 100644
index 0000000..d25a49a
--- /dev/null
+++ b/test/models/page_upload_purge_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class PageUploadPurgeTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @page = pages(:welcome)
+    @page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    @page.body.save!
+    @attachment = @page.body.uploads.attachments.last
+    @blob = @attachment.blob
+    assert @blob.service.exist?(@blob.key)
+  end
+
+  test "destroying a page purges its embedded uploads" do
+    perform_enqueued_jobs { Page.find(@page.id).destroy! }
+    assert_purged
+  end
+
+  test "destroying a page's leaf purges its embedded uploads" do
+    perform_enqueued_jobs { @page.leaf.destroy! }
+    assert_purged
+  end
+
+  test "destroying a book purges its pages' embedded uploads" do
+    perform_enqueued_jobs { @page.leaf.book.destroy! }
+    assert_purged
+  end
+
+  private
+    def assert_purged
+      assert_not ActiveStorage::Attachment.exists?(@attachment.id)
+      assert_not ActiveStorage::Blob.exists?(@blob.id)
+      assert_not @blob.service.exist?(@blob.key)
+    end
+end
