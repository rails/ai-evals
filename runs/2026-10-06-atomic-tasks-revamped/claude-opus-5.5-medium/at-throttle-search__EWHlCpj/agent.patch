 class Books::SearchesController < ApplicationController
+  RATE_LIMITER = SlidingWindowRateLimiter.new("book-search", limit: 30, window: 1.minute)
+
   allow_unauthenticated_access
 
+  before_action :enforce_rate_limit
   include BookScoped
 
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    def enforce_rate_limit
+      unless RATE_LIMITER.allow?(request.remote_ip)
