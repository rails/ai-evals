@@ -0,0 +1,34 @@
+require "test_helper"
+
+class PictureVariantsTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "an uploaded picture is derived once by the background job and reused when read" do
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:reading_picture)), params: {
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") } }
+    end
+
+    blob = leaves(:reading_picture).reload.picture.image.blob
+    assert_equal 1, blob.variant_records.count
+
+    assert_no_difference -> { ActiveStorage::VariantRecord.count }, -> { ActiveStorage::Blob.count } do
+      transforms = 0
+      counter = ActiveSupport::Notifications.subscribe("transform.active_storage") { transforms += 1 }
+
+      get leafable_slug_path(leaves(:reading_picture))
+      get css_select("figure img").first["src"]
+      follow_redirect! while response.redirect?
+
+      ActiveSupport::Notifications.unsubscribe(counter)
+      assert_equal 0, transforms
+    end
+
+    assert_response :success
+    assert_equal blob.variant_records.sole.image.download, response.body
+  end
+end
