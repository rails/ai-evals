+# Post-import library report.
+#
+#   bin/rails runner -e development script/library_report.rb
+#
+# `rails runner` only wires Rails.logger to the environment's log file
+# (log/<env>.log), so logging alone prints nothing on the terminal. Every
+# report line is therefore sent both to Rails.logger (the record our log
+# tooling reads) and to the terminal.
+#
+# The report lines are written at INFO/WARN even if the logger's level was
+# raised (e.g. LOG_LEVEL=warn to quiet a noisy run), so the record is always
+# complete. Other log output keeps the configured level.
+
+report = ActiveSupport::BroadcastLogger.new(Rails.logger)
+
+unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR)
+  $stdout.sync = true
+  report.broadcast_to(ActiveSupport::Logger.new($stdout).tap { |l| l.level = Logger::DEBUG })
+end
+
+log = lambda do |severity, message|
+  previous = Rails.logger.local_level
+  Rails.logger.local_level = Logger::INFO if Rails.logger.level > Logger::INFO
+  report.public_send(severity, message)
+ensure
+  Rails.logger.local_level = previous
+end
+
 books = Book.order(:id).to_a
 
-Rails.logger.info "Library report: #{books.size} books"
+log.(:info, "Library report: #{books.size} books")
 
 books.each do |book|
   pages = book.leaves.count
 
   if pages.zero?
-    Rails.logger.warn "Library report: #{book.title} has no pages"
+    log.(:warn, "Library report: #{book.title} has no pages")
   else
-    Rails.logger.info "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}"
+    log.(:info, "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}")
   end
 end
 
-Rails.logger.info "Library report: done"
+log.(:info, "Library report: done")
