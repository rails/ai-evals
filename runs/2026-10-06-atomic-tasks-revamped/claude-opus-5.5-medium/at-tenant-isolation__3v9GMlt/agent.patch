diff --git a/app/models/concerns/tenanted.rb b/app/models/concerns/tenanted.rb
new file mode 100644
index 0000000..360762b
--- /dev/null
+++ b/app/models/concerns/tenanted.rb
@@ -0,0 +1,16 @@
+# Users and books may belong to a tenant. Rows without a tenant behave as they
+# did before tenants existed: an untenanted book is visible across the install,
+# and a user without a tenant only sees untenanted books.
+module Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    scope :in_tenant_of, ->(other) { where(tenant_id: [ nil, other&.tenant_id ].uniq) }
+  end
+
+  def same_tenant_as?(other)
+    tenant_id.nil? || other&.tenant_id == tenant_id
+  end
+end
