@@ -0,0 +1,49 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    @leaves = Leaf.order(:id).to_a
+    @leaves.each { |leaf| leaf.update_columns(title: %("#{leaf.title}")) }
+    @first, @second = @leaves.first(2)
+    @first.update_columns(title: %(""Quoted" opening phrase"))
+    @second.update_columns(title: %(""Another" quote at "the end""))
+  end
+
+  test "strips the wrapping quotes from every title" do
+    original = Leaf.order(:id).pluck(:title)
+
+    TitleCleanupJob.perform_now
+
+    assert_equal original.map { it[1..-2] }, Leaf.order(:id).pluck(:title)
+    assert_equal %("Quoted" opening phrase), @first.reload.title
+  end
+
+  test "resumes after an interruption without recleaning earlier leaves" do
+    original = Leaf.order(:id).pluck(:title)
+
+    TitleCleanupJob.perform_later
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: @first.id.succ) { perform_enqueued_jobs }
+    assert_equal %("Quoted" opening phrase), @first.reload.title
+    assert_equal original.drop(1), Leaf.where.not(id: @first.id).order(:id).pluck(:title)
+
+    perform_enqueued_jobs
+
+    assert_equal original.map { it[1..-2] }, Leaf.order(:id).pluck(:title)
+  end
+
+  test "survives repeated interruptions" do
+    original = Leaf.order(:id).pluck(:title)
+    TitleCleanupJob.perform_later
+
+    queue_adapter.stopping = true
+    @leaves.size.times { perform_enqueued_jobs only: TitleCleanupJob }
+    queue_adapter.stopping = false
+    perform_enqueued_jobs
+
+    assert_equal original.map { it[1..-2] }, Leaf.order(:id).pluck(:title)
+    assert_no_enqueued_jobs
+  end
+end
