 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  # Resume immediately: our Resque setup has no scheduler, so a delayed
+  # re-enqueue (the default `wait: 5.seconds`) can't be honoured.
+  self.resume_options = {}
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :clean_titles do |step|
+      Leaf.find_each(start: step.cursor, order: :asc) do |leaf|
+        leaf.update!(title: cleaned(leaf.title))
+
+        # Record progress past this leaf only once it has been cleaned, so an
+        # interruption resumes at the next leaf (or redoes at most this one).
+        step.advance! from: leaf.id
+      end
     end
   end
 
diff --git a/config/initializers/resque.rb b/config/initializers/resque.rb
new file mode 100644
index 0000000..e3343c0
--- /dev/null
+++ b/config/initializers/resque.rb
@@ -0,0 +1,26 @@
+# Let Active Job continuations know when a Resque worker has been asked to shut
+# down (e.g. QUIT/TERM during a deploy), so continuable jobs checkpoint and
+# re-enqueue themselves with their progress instead of being killed mid-run
+# and starting over.
+require "resque"
+require "active_job/queue_adapters/resque_adapter"
+
+module ResqueWorkerShutdownTracking
+  mattr_accessor :current_worker
+
+  module Worker
+    def startup
+      ResqueWorkerShutdownTracking.current_worker = self
+      super
+    end
+  end
+
+  module Adapter
+    def stopping?
+      super || !!ResqueWorkerShutdownTracking.current_worker&.shutdown?
+    end
+  end
+end
+
+Resque::Worker.prepend ResqueWorkerShutdownTracking::Worker
+ActiveJob::QueueAdapters::ResqueAdapter.prepend ResqueWorkerShutdownTracking::Adapter
