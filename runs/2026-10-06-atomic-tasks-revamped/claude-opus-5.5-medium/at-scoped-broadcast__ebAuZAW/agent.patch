diff --git a/test/channels/leaf_being_edited_channel_test.rb b/test/channels/leaf_being_edited_channel_test.rb
new file mode 100644
index 0000000..279ecf8
--- /dev/null
+++ b/test/channels/leaf_being_edited_channel_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class LeafBeingEditedChannelTest < ActionCable::Channel::TestCase
+  setup do
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "editors subscribe to the leaf's presence stream" do
+    stub_connection current_user: users(:kevin)
+    subscribe leaf_id: @leaf.id
+
+    assert subscription.confirmed?
+    assert_has_stream_for @leaf
+  end
+
+  test "readers are rejected" do
+    stub_connection current_user: users(:jz)
+    subscribe leaf_id: @leaf.id
+
+    assert subscription.rejected?
+  end
+
+  test "users without access are rejected" do
+    accesses(:kevin_handbook).destroy
+    stub_connection current_user: users(:kevin)
+    subscribe leaf_id: @leaf.id
+
+    assert subscription.rejected?
+  end
+
+  test "unknown leaves are rejected" do
+    stub_connection current_user: users(:kevin)
+    subscribe leaf_id: 0
+
+    assert subscription.rejected?
+  end
+
+  test "messages are relayed to editors" do
+    stub_connection current_user: users(:kevin)
+    subscribe leaf_id: @leaf.id
+
+    subscription.send(:relay, "<turbo-stream>Kevin</turbo-stream>")
+
+    assert_equal [ "<turbo-stream>Kevin</turbo-stream>" ], transmissions
+  end
+
+  test "messages stop once a collaborator is removed from the book" do
+    stub_connection current_user: users(:kevin)
+    subscribe leaf_id: @leaf.id
+    assert subscription.confirmed?
+
+    books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [])
+    subscription.send(:relay, "<turbo-stream>David</turbo-stream>")
+
+    assert_empty transmissions
+    assert_no_streams
+  end
+
+  test "messages stop once a collaborator is demoted to reader" do
+    stub_connection current_user: users(:kevin)
+    subscribe leaf_id: @leaf.id
+
+    accesses(:kevin_handbook).update!(level: :reader)
+    subscription.send(:relay, "<turbo-stream>David</turbo-stream>")
+
+    assert_empty transmissions
+  end
+
+  test "messages stop once a user is deactivated" do
+    stub_connection current_user: users(:kevin)
+    subscribe leaf_id: @leaf.id
+
+    users(:kevin).deactivate
+    subscription.send(:relay, "<turbo-stream>David</turbo-stream>")
+
+    assert_empty transmissions
+  end
+
+  test "presence is not broadcast on a Turbo::StreamsChannel-subscribable name" do
+    assert_not_equal Turbo::StreamsChannel.broadcasting_for([ @leaf, :being_edited ]),
+      LeafBeingEditedChannel.broadcasting_for(@leaf)
+  end
+end
