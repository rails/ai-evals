new file mode 100644
index 0000000..3e34cb9
--- /dev/null
+++ b/lib/tasks/users.rake
@@ -0,0 +1,15 @@
+namespace :users do
+  desc "Permanently erase every account (active, or deactivated the old way) for EMAIL"
+  task :erase, [ :email_address ] => :environment do |_, args|
+    email_address = args[:email_address].presence || ENV["EMAIL"].presence or
+      abort "Usage: bin/rails 'users:erase[alice@example.com]'"
+
+    users = User.claiming_email_address(email_address)
+    abort "No account found for #{email_address}" if users.empty?
+
+    users.each do |user|
+      user.erase
+      puts "Erased user ##{user.id} (#{user.email_address})"
+    end
+  end
+end
