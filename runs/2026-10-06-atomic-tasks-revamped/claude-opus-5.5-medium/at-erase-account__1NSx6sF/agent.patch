diff --git a/lib/tasks/users.rake b/lib/tasks/users.rake
new file mode 100644
index 0000000..676b48c
--- /dev/null
+++ b/lib/tasks/users.rake
@@ -0,0 +1,22 @@
+namespace :users do
+  desc "Permanently erase a user and their data (GDPR). Usage: bin/rails users:erase[ID_OR_EMAIL]"
+  task :erase, [ :id_or_email ] => :environment do |_, args|
+    key = args[:id_or_email].to_s
+    abort "Usage: bin/rails users:erase[ID_OR_EMAIL]" if key.blank?
+
+    user = User.find_by(id: key) || User.find_by(email_address: key) ||
+      User.deactivated.detect { |u| u.original_email_address == key }
+    abort "No user found for #{key.inspect}" unless user
+
+    user.erase
+    puts "Erased user ##{user.id}"
+  end
+
+  desc "Permanently erase all users previously deactivated by the old remove"
+  task erase_deactivated: :environment do
+    User.deactivated.find_each do |user|
+      user.erase
+      puts "Erased user ##{user.id}"
+    end
+  end
+end
