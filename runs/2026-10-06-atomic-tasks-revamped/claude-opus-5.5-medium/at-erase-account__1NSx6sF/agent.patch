diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..c9fb195
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+  end
+
+  test "erasing removes the user and everything attached to them" do
+    Current.session = @kevin.sessions.create!(user_agent: "UA", ip_address: "1.2.3.4")
+    ReadingMark.remember(leaves(:welcome_page), user: @kevin)
+
+    @kevin.erase
+
+    assert_not User.exists?(@kevin.id)
+    assert_equal 0, Session.where(user_id: @kevin.id).count
+    assert_equal 0, Access.where(user_id: @kevin.id).count
+    assert_equal 0, ReadingMark.where(user_id: @kevin.id).count
+    assert_equal 0, SignInEvent.where(email_address: "kevin@example.com").count
+  ensure
+    Current.reset
+  end
+
+  test "books shared with everyone survive without the author's name" do
+    book = Book.create!(title: "Kevin's Open Book", author: "Kevin", everyone_access: true, creator: @kevin)
+    book.update_access(editors: [ @kevin.id ], readers: [])
+    book.press Page.new(body: "Readable by all"), title: "Open page"
+
+    @kevin.erase
+
+    book.reload
+    assert_nil book.creator_id
+    assert_equal "Deleted author", book.author
+    assert_equal 1, book.leaves.count
+    assert book.accessable?(user: users(:jz))
+    assert_equal [ book.leaves.first ], book.leaves.search("Readable").to_a
+  end
+
+  test "other created books are erased completely, with no stale search hits" do
+    book = Book.create!(title: "Kevin's Diary", everyone_access: false, creator: @kevin)
+    book.update_access(editors: [ @kevin.id, users(:david).id ], readers: [])
+    leaf = book.press Page.new(body: "zanzibar secret"), title: "Private page"
+    leaf.edit leafable_params: { body: "zanzibar second version" }
+    picture_leaf = book.press Picture.new(image: { io: file_fixture("reading.webp").open, filename: "reading.webp" }), title: "Snapshot"
+    section_leaf = book.press Section.new(body: "quokka section"), title: "Section"
+    cleared_leaf = book.press Section.new(body: "wombat section"), title: "Cleared"
+    cleared_leaf.edit leafable_params: { body: nil }
+    leaf.page.body.uploads.attach(io: StringIO.new("upload"), filename: "note.txt")
+    leaf.page.body.save!
+    old_page_ids = leaf.edits.pluck(:leafable_id)
+
+    blob_ids = ActiveStorage::Attachment.where(record: [ picture_leaf.leafable, leaf.page.body ]).pluck(:blob_id)
+    assert_equal 2, blob_ids.size
+    assert_equal 1, Leaf.search("zanzibar").to_a.size
+
+    @kevin.erase
+
+    assert_not Book.exists?(book.id)
+    assert_equal 0, Leaf.where(book_id: book.id).count
+    assert_equal 0, Edit.where(leaf_id: [ leaf.id, picture_leaf.id, section_leaf.id ]).count
+    assert_equal 0, Page.where(id: [ leaf.leafable_id, *old_page_ids ]).count
+    assert_equal 0, ActionText::Markdown.where(record_type: "Page", record_id: [ leaf.leafable_id, *old_page_ids ]).count
+    assert_equal 0, Picture.where(id: picture_leaf.leafable_id).count
+    assert_equal 0, Section.where(id: section_leaf.leafable_id).count
+    assert_equal 0, ActiveStorage::Blob.where(id: blob_ids).count
+    assert_equal 0, Access.where(book_id: book.id).count
+
+    search_rows = ActiveRecord::Base.connection.select_value(
+      "select count(*) from leaf_search_index where rowid in (#{[ leaf.id, picture_leaf.id, section_leaf.id, cleared_leaf.id ].join(",")})")
+    assert_equal 0, search_rows
+    assert_equal 0, Leaf.search("zanzibar").to_a.size
+    assert_equal 0, Leaf.search("quokka").to_a.size
+    assert_equal 0, Leaf.search("wombat").to_a.size
+  end
+
+  test "books created by other people are untouched" do
+    @kevin.erase
+
+    assert Book.exists?(books(:handbook).id)
+    assert_equal 4, books(:handbook).leaves.count
+    assert_equal "reading.webp", leaves(:reading_picture).picture.image.filename.to_s
+  end
+
+  test "previously deactivated users are erased, including sign-in events under their real address" do
+    session = @kevin.sessions.create!(user_agent: "UA", ip_address: "1.2.3.4")
+    session.destroy
+    assert_equal 2, SignInEvent.for_address("kevin@example.com").count
+
+    @kevin.update!(active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com")
+    book = Book.create!(title: "Old Private", everyone_access: false, creator: @kevin)
+
+    assert_equal "kevin@example.com", @kevin.original_email_address
+
+    @kevin.erase
+
+    assert_not User.exists?(@kevin.id)
+    assert_not Book.exists?(book.id)
+    assert_equal 0, SignInEvent.for_address("kevin@example.com").count
+  end
+
+  test "sign-in events of someone who later took over the address are kept" do
+    SignInEvent.create!(email_address: "kevin@example.com", action: :signed_in, created_at: 2.days.ago)
+    @kevin.update!(active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com", created_at: 1.week.ago)
+
+    new_kevin = User.create!(name: "New Kevin", email_address: "kevin@example.com", password: "secret123456", created_at: 1.day.ago)
+    new_kevin.sessions.create!(user_agent: "UA", ip_address: "5.6.7.8")
+
+    @kevin.erase
+
+    assert_equal 1, SignInEvent.for_address("kevin@example.com").count
+    assert User.exists?(new_kevin.id)
+  end
+
+  test "users are not left in other users' book access lists" do
+    @kevin.erase
+    assert_not books(:handbook).accesses.exists?(user_id: @kevin.id)
+  end
+end
