@@ -26,6 +26,33 @@ class SessionsController < ApplicationController
       redirect_to first_run_url if User.none?
     end
 
+    # Only ever send the reader somewhere on this site: either a local path
+    # ("/books/1") or an absolute http(s) URL for this very host and port.
+    # Anything else (other hosts, protocol-relative "//evil", "javascript:",
+    # backslash tricks, malformed values) is ignored.
+    def safe_return_to_path
+      return_to = params[:return_to]
+      return unless return_to.is_a?(String) && return_to.present?
+      return if return_to.match?(/[[:cntrl:][:space:]\\]/)
+
+      uri = URI.parse(return_to)
+
+      if uri.scheme || uri.host
+        return unless %w[ http https ].include?(uri.scheme.to_s.downcase)
+        return unless uri.host.to_s.casecmp?(request.host) && uri.port == request.port
+      end
+
+      path = uri.path.to_s
+      path = "/" if path.empty? && uri.host
+      return unless path.start_with?("/") && !path.start_with?("//")
+
+      path += "?#{uri.query}" if uri.query
+      path += "##{uri.fragment}" if uri.fragment
+      path
+    rescue URI::Error
+      nil
+    end
+
     def render_rejection(status)
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
diff --git a/test/controllers/sessions/return_to_test.rb b/test/controllers/sessions/return_to_test.rb
