index 0000000..58ee9fe
--- /dev/null
+++ b/test/controllers/sessions/return_to_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Sessions::ReturnToTest < ActionDispatch::IntegrationTest
+  test "returns to a local path after signing in" do
+    sign_in_with_return_to "/books/1?page=2#top"
+    assert_redirected_to "http://www.example.com/books/1?page=2#top"
+  end
+
+  test "returns to an absolute URL on this host" do
+    sign_in_with_return_to "http://www.example.com/books/1"
+    assert_redirected_to "http://www.example.com/books/1"
+  end
+
+  test "goes to root without a return_to" do
+    sign_in_with_return_to nil
+    assert_redirected_to root_url
+  end
+
+  test "never redirects off site" do
+    [
+      "https://evil.example/login", "//evil.example", "///evil.example", "/\\evil.example", "\\\\evil.example",
+      "javascript:alert(1)", "http:evil.example", "http://www.example.com@evil.example/",
+      "http://www.example.com.evil.example/", "http://www.example.com:8080/", "/a\r\nLocation: http://evil.example",
+      " //evil.example", "%%%"
+    ].each do |return_to|
+      sign_in_with_return_to return_to
+      assert_equal "www.example.com", URI.parse(response.location).host, "return_to #{return_to.inspect} left the site"
+      assert_equal 80, URI.parse(response.location).port
+      delete session_path
+    end
+  end
+
+  test "ignores non-string return_to" do
+    sign_in_with_return_to [ "https://evil.example" ]
+    assert_redirected_to root_url
+  end
+
+  private
+    def sign_in_with_return_to(return_to)
+      post session_path, params: { email_address: "david@example.com", password: "secret123456", return_to: return_to }.compact
+    end
+end
