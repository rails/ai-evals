diff --git a/test/integration/pentest_test.rb b/test/integration/pentest_test.rb
new file mode 100644
index 0000000..ee591c7
--- /dev/null
+++ b/test/integration/pentest_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class PentestTest < ActionDispatch::IntegrationTest
+  test "PT-01 member cannot grant self role via profile" do
+    sign_in :kevin
+    put user_profile_path(users(:kevin)), params: { user: { name: "K", role: "administrator" } }
+    assert users(:kevin).reload.member?
+    assert_equal "K", users(:kevin).name
+    put user_path(users(:kevin)), params: { user: { role: "administrator" } }
+    assert users(:kevin).reload.member?
+    put user_path(users(:jz)), params: { user: { role: "administrator" } }
+    assert users(:jz).reload.member?
+  end
+
+  test "PT-01 admin can change role" do
+    sign_in :david
+    put user_path(users(:jz)), params: { user: { role: "administrator" } }
+    assert users(:jz).reload.administrator?
+  end
+
+  test "PT-02 reader cannot destroy" do
+    sign_in :jz
+    delete book_path(books(:handbook))
+    assert_response :forbidden
+    assert Book.exists?(books(:handbook).id)
+    books(:manual).update!(published: true)
+    sign_in :kevin
+    delete book_path(books(:manual))
+    assert_response :forbidden
+    delete book_path(books(:handbook))
+    assert_not Book.exists?(books(:handbook).id)
+  end
+
+  test "PT-03/04 search" do
+    books(:manual).accesses.where(user: users(:kevin)).delete_all
+    manual_leaf = books(:manual).press Page.new(body: "x"), title: "Secret Save 50% off"
+    handbook_leaf = books(:handbook).press Page.new(body: "x"), title: "Save 50% off"
+    sign_in :kevin
+    get library_search_path(q: "') or 1=1 --")
+    assert_response :success
+    get library_search_path(q: "Secret")
+    assert_not_in_body "Secret Save"
+    get library_search_path(q: "%")
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook"
+    get library_search_path(q: "_")
+    assert_not_in_body "Welcome to The Handbook"
+    get library_search_path(q: "Save 50% off")
+    assert_in_body "Save 50% off"
+    get library_search_path(q: "welcome")
+    assert_in_body "Welcome to The Handbook"
+  end
+
+  test "PT-05 idor" do
+    books(:manual).accesses.where(user: users(:kevin)).delete_all
+    leaf = books(:manual).press Page.new(body: "topsecret"), title: "Hidden"
+    sign_in :kevin
+    get slugged_leafable_path(books(:handbook).id, "handbook", leaf.id, "hidden")
+    assert_response :not_found
+    get book_page_path(books(:handbook), leaf)
+    assert_response :not_found
+  end
+end
+
+class PentestSignedOutTest < ActionDispatch::IntegrationTest
+  test "published pages readable signed out, unpublished not, cross-book not" do
+    books(:handbook).update!(published: true)
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+    secret = books(:manual).press Page.new(body: "x"), title: "Hidden"
+    get slugged_leafable_path(books(:handbook).id, "handbook", secret.id, "hidden")
+    assert_response :not_found
+    get leafable_slug_path(secret)
+    assert_response :not_found
+    books(:handbook).press Page.new(body: "x"), title: "Save 50% off"
+    get library_search_path(q: "50%")
+    assert_in_body "Save 50% off"
+    get library_search_path(q: "Hidden")
+    assert_in_body "No matches."
+  end
+end
