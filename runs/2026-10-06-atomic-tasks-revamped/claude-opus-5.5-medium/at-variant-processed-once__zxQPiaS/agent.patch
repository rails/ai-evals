@@ -0,0 +1,40 @@
+require "test_helper"
+
+class PictureDerivationTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "an uploaded picture is derived once, by the background job" do
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:reading_picture)), params: {
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") } }
+    end
+
+    blob = leaves(:reading_picture).reload.leafable.image.blob
+    assert_equal 1, blob.variant_records.count
+
+    transforms = 0
+    counter = ->(*) { transforms += 1 }
+
+    served = ActiveSupport::Notifications.subscribed(counter, "transform.active_storage") do
+      get leafable_path(leaves(:reading_picture))
+      assert_response :ok
+
+      get css_select("figure img").first["src"]
+      follow_redirect! while response.redirect?
+      assert_response :ok
+      response.body
+    end
+
+    assert_equal 0, transforms
+    assert_equal 1, blob.variant_records.count
+
+    expected = file_fixture("white-rabbit.webp").open do |file|
+      ActiveStorage::Variation.new(resize_to_limit: [ 1500, 1500 ], format: "webp").transform(file, &:read)
+    end
+    assert_equal expected.b, served.b
+  end
+end
