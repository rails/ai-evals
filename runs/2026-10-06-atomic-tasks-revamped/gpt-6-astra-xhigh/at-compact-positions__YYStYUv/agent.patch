diff --git a/test/lib/sqlite3_configuration_test.rb b/test/lib/sqlite3_configuration_test.rb
new file mode 100644
index 0000000..0649f8c
--- /dev/null
+++ b/test/lib/sqlite3_configuration_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class SQLite3ConfigurationTest < ActiveSupport::TestCase
+  test "unknown double quoted identifiers raise instead of becoming string literals" do
+    error = assert_raises(ActiveRecord::StatementInvalid) do
+      ActiveRecord::Base.connection.select_all(<<~SQL)
+        SELECT id FROM leaves ORDER BY "position_socre", id
+      SQL
+    end
+
+    assert_match(/no such column.*position_socre/, error.message)
+  end
+
+  test "unknown double quoted identifiers are also rejected in index definitions" do
+    assert_raises(ActiveRecord::StatementInvalid) do
+      ActiveRecord::Base.connection.execute(<<~SQL)
+        CREATE INDEX index_leaves_on_misspelled_score ON leaves ("position_socre")
+      SQL
+    end
+  end
+end
diff --git a/test/models/book/maintenance_test.rb b/test/models/book/maintenance_test.rb
new file mode 100644
index 0000000..be645c3
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "compaction preserves score order rather than id order and is idempotent" do
+    ordered = @book.leaves.order(id: :desc).to_a
+    ordered.zip([ -10.5, 2.25, 8.5, 42 ]).each do |leaf, score|
+      leaf.update_columns(position_score: score)
+    end
+
+    2.times do
+      @book.compact_positions!
+
+      assert_equal ordered.map(&:id), @book.leaves.positioned.ids
+      assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    end
+  end
+
+  test "compaction breaks score ties by id" do
+    ordered = @book.leaves.order(:id).to_a
+    ordered.zip([ 40, 10, 10, 20 ]).each do |leaf, score|
+      leaf.update_columns(position_score: score)
+    end
+
+    @book.compact_positions!
+
+    assert_equal ordered.values_at(1, 2, 3, 0).map(&:id), @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compaction includes trashed leaves so restoring them preserves their place" do
+    ordered = [ leaves(:reading_picture), leaves(:summary_page), leaves(:welcome_page), leaves(:welcome_section) ]
+    ordered.each.with_index(1) { |leaf, index| leaf.update_columns(position_score: index * 10) }
+    trashed = leaves(:summary_page)
+    trashed.trashed!
+
+    @book.compact_positions!
+
+    assert_equal ordered.map(&:id), @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    assert_predicate trashed.reload, :trashed?
+    assert_equal (ordered - [ trashed ]).map(&:id), @book.leaves.active.positioned.ids
+
+    trashed.active!
+
+    assert_equal ordered.map(&:id), @book.leaves.active.positioned.ids
+  end
+
+  test "compaction only changes leaves in the given book" do
+    other_leaf = leaves(:reading_picture)
+    other_leaf.update_columns(book_id: books(:manual).id, position_score: -20)
+
+    @book.compact_positions!
+
+    assert_equal(-20, other_leaf.reload.position_score)
+    assert_equal [ 1, 2, 3 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compaction handles a single leaf" do
+    leaf = leaves(:welcome_page)
+    leaf.update_columns(book_id: books(:manual).id, position_score: 100)
+
+    books(:manual).compact_positions!
+
+    assert_equal 1, leaf.reload.position_score
+  end
+
+  test "compaction of an empty book leaves other books untouched" do
+    assert_no_changes -> { Leaf.order(:id).pluck(:id, :position_score) } do
+      books(:manual).compact_positions!
+    end
+  end
+
+  test "live leaf count excludes trash and other books before and after compaction" do
+    leaves(:reading_picture).update_columns(book_id: books(:manual).id)
+    leaves(:summary_page).trashed!
+
+    assert_equal 2, @book.live_leaf_count
+    assert_equal 1, books(:manual).live_leaf_count
+
+    @book.compact_positions!
+    books(:manual).compact_positions!
+
+    assert_equal 2, @book.live_leaf_count
+    assert_equal 1, books(:manual).live_leaf_count
+  end
+
+  test "empty and entirely trashed books have no live leaves" do
+    assert_equal 0, books(:manual).live_leaf_count
+
+    @book.leaves.update_all(status: :trashed)
+    @book.compact_positions!
+
+    assert_equal 0, @book.live_leaf_count
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+end
