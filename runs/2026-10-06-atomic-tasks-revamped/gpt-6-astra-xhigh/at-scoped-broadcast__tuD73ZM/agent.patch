diff --git a/app/jobs/leaf/being_edited_broadcast_job.rb b/app/jobs/leaf/being_edited_broadcast_job.rb
new file mode 100644
index 0000000..84ea4e6
--- /dev/null
+++ b/app/jobs/leaf/being_edited_broadcast_job.rb
@@ -0,0 +1,11 @@
+class Leaf::BeingEditedBroadcastJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(leaf, user)
+    # Resolve recipients at delivery time so revoked editors' open subscriptions stay silent.
+    leaf.book.editors.find_each do |editor|
+      Turbo::StreamsChannel.broadcast_render_to editor, leaf, :being_edited,
+        partial: "leaves/being_edited_by", locals: { leaf: leaf, user: user }
+    end
+  end
+end
