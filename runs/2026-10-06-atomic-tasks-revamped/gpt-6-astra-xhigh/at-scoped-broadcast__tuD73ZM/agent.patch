diff --git a/test/integration/editing_presence_test.rb b/test/integration/editing_presence_test.rb
new file mode 100644
index 0000000..dfc89c9
--- /dev/null
+++ b/test/integration/editing_presence_test.rb
@@ -0,0 +1,201 @@
+require "test_helper"
+
+class EditingPresenceTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+  include ActionCable::TestHelper
+
+  setup do
+    @leaf = leaves(:welcome_page)
+    @book = @leaf.book
+    @book.update! everyone_access: false
+  end
+
+  test "editors subscribe to their own leaf presence stream" do
+    sign_in :kevin
+
+    assert_equal presence_stream(users(:kevin)), editor_stream
+    assert_select "div#being_edited_leaf_#{@leaf.id}.being-edited-indicator"
+  end
+
+  test "saving broadcasts the indicator only to current editors on user scoped streams" do
+    sign_in :david
+    @book.update! published: true, everyone_access: true
+    accesses(:jz_manual).editor!
+
+    save_page
+
+    [ :david, :jason, :kevin ].each do |recipient|
+      stream = presence_stream(users(recipient))
+      assert_broadcasts stream, 1
+      assert_presence_payload stream, users(:david)
+    end
+
+    assert_no_broadcasts presence_stream(users(:jz))
+    assert_no_broadcasts stream_name(@leaf, :being_edited)
+    assert_no_broadcasts stream_name(users(:kevin), leaves(:summary_page), :being_edited)
+  end
+
+  test "an open editor stops receiving presence after its collaborator is removed" do
+    sign_in :kevin
+    removed_stream = editor_stream
+
+    @book.update_access editors: [ users(:david).id, users(:jason).id ], readers: []
+    sign_out
+    sign_in :david
+    remaining_stream = editor_stream
+
+    assert_no_broadcasts removed_stream do
+      assert_broadcasts remaining_stream, 1 do
+        save_page
+      end
+    end
+  end
+
+  test "an open editor stops receiving presence when everyone access downgrades its collaborator to reader" do
+    sign_in :kevin
+    downgraded_stream = editor_stream
+
+    @book.update! everyone_access: true
+    @book.update_access editors: [ users(:david).id, users(:jason).id ], readers: []
+    assert @book.access_for(user: users(:kevin)).reader?
+    sign_out
+    sign_in :david
+
+    assert_no_broadcasts downgraded_stream do
+      assert_broadcasts presence_stream(users(:jason)), 1 do
+        save_page
+      end
+    end
+  end
+
+  test "queued presence excludes a collaborator removed before delivery" do
+    sign_in :kevin
+    removed_stream = editor_stream
+    sign_out
+    sign_in :david
+    update_page
+
+    @book.update_access editors: [ users(:david).id, users(:jason).id ], readers: []
+
+    assert_no_broadcasts removed_stream do
+      assert_broadcasts presence_stream(users(:jason)), 1 do
+        perform_enqueued_jobs
+      end
+    end
+    assert_no_broadcasts stream_name(@leaf, :being_edited)
+  end
+
+  test "queued presence excludes a collaborator downgraded before delivery" do
+    sign_in :david
+    update_page
+    accesses(:kevin_handbook).reader!
+
+    assert_no_broadcasts presence_stream(users(:kevin)) do
+      assert_broadcasts presence_stream(users(:jason)), 1 do
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "queued presence excludes deactivated editors and administrators" do
+    sign_in :david
+    update_page
+    users(:kevin).deactivate
+    users(:jason).deactivate
+
+    perform_enqueued_jobs
+
+    assert_broadcasts presence_stream(users(:david)), 1
+    assert_no_broadcasts presence_stream(users(:kevin))
+    assert_no_broadcasts presence_stream(users(:jason))
+  end
+
+  test "administrators receive presence without explicit editor access" do
+    sign_in :kevin
+    accesses(:david_handbook).reader!
+    accesses(:jason_handbook).destroy!
+
+    save_page
+
+    assert_broadcasts presence_stream(users(:david)), 1
+    assert_broadcasts presence_stream(users(:jason)), 1
+  end
+
+  test "queued presence uses current administrator roles" do
+    sign_in :kevin
+    accesses(:jason_handbook).reader!
+    update_page
+    users(:jason).member!
+
+    assert_no_broadcasts presence_stream(users(:jason)) do
+      assert_broadcasts presence_stream(users(:david)), 1 do
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "presence is discarded if the leaf is deleted before delivery" do
+    sign_in :david
+    update_page
+    @leaf.destroy!
+
+    perform_enqueued_jobs
+
+    [ :david, :jason, :jz, :kevin ].each do |recipient|
+      assert_no_broadcasts presence_stream(users(recipient))
+    end
+    assert_no_broadcasts stream_name(@leaf, :being_edited)
+  end
+
+  test "readers cannot subscribe through the editor or trigger presence" do
+    sign_in :jz
+    get edit_leafable_path(@leaf)
+    assert_response :forbidden
+    assert_select "turbo-cable-stream-source", count: 0
+
+    assert_no_enqueued_jobs do
+      put leafable_path(@leaf), params: { page: { body: "Not allowed" } }
+      assert_response :forbidden
+    end
+  end
+
+  private
+    def editor_stream
+      get edit_leafable_path(@leaf)
+      assert_response :success
+
+      sources = assert_select "turbo-cable-stream-source"
+      assert_equal 1, sources.size
+      Turbo::StreamsChannel.verified_stream_name(sources.first["signed-stream-name"])
+    end
+
+    def presence_stream(user)
+      stream_name(user, @leaf, :being_edited)
+    end
+
+    def stream_name(*streamables)
+      Turbo::StreamsChannel.verified_stream_name(Turbo::StreamsChannel.signed_stream_name(streamables))
+    end
+
+    def assert_presence_payload(stream, editor)
+      payload = Nokogiri::HTML.fragment(ActiveSupport::JSON.decode(broadcasts(stream).last))
+      action = payload.at_css("turbo-stream")
+      assert_equal "append", action["action"]
+      assert_equal "being_edited_leaf_#{@leaf.id}", action["target"]
+
+      indicator = action.at_css("#being_edited_by_user_#{editor.id}")
+      assert_equal editor.name, indicator.at_css("strong").text
+      assert_equal editor.id.to_s, indicator["data-hide-from-user-id"]
+      assert_equal "autoremove", indicator["data-controller"]
+      assert_equal "animationend->autoremove#remove", indicator["data-action"]
+    end
+
+    def save_page
+      perform_enqueued_jobs { update_page }
+    end
+
+    def update_page
+      put leafable_path(@leaf), params: { page: { body: "Another edit" } }
+      assert_response :no_content
+    end
+end
