diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..525d579 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,31 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :remember_publication_change, if: :saved_change_to_published?
   end
 
   private
+    def remember_publication_change
+      # Later saves and touches can replace saved_changes before we commit.
+      if @published_before_transaction.nil?
+        @published_before_transaction = published_before_last_save
+
+        transaction = self.class.current_transaction
+        transaction.after_commit { announce_publication }
+        transaction.after_rollback { forget_publication_change }
+      end
+    end
+
     def announce_publication
-      AnnouncePublicationJob.perform_later self
+      was_draft = @published_before_transaction == false
+      forget_publication_change
+
+      if was_draft && self.class.published.exists?(id: id)
+        AnnouncePublicationJob.perform_later self
+      end
+    end
+
+    def forget_publication_change
+      @published_before_transaction = nil
     end
 end
