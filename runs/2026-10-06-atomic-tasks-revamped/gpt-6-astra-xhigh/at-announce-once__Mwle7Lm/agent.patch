diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..98ade97
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,218 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  # Exercise real commits and rollbacks, not the test fixture transaction.
+  self.use_transactional_tests = false
+
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "publishing announces the book once after commit" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert @book.reload.published?
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ]
+  end
+
+  test "publishing and adding a page announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "New page"
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert @book.reload.published?
+    assert_equal "New page", @book.leaves.last.title
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ]
+  end
+
+  test "publishing and changing existing pages announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.leaves.find(leaves(:welcome_page).id).update! title: "New title"
+        @book.leaves.find(leaves(:summary_page).id).trashed!
+      end
+    end
+
+    assert @book.reload.published?
+    assert_equal "New title", leaves(:welcome_page).reload.title
+    assert leaves(:summary_page).reload.trashed?
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ]
+  end
+
+  test "later saves in the same transaction do not lose the announcement" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! slug: "new-slug"
+        @book.save!
+        @book.touch
+      end
+    end
+  end
+
+  test "saving an already published book does not announce again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true, slug: "new-slug"
+        @book.press Page.new(body: ""), title: "New page"
+      end
+      @book.save!
+    end
+  end
+
+  test "unpublishing does not announce" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "saving a draft without publishing does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: false, slug: "new-slug"
+        @book.press Page.new(body: ""), title: "New page"
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "failure after publishing rolls back the book and pages without announcing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_no_difference [ "Leaf.count", "Page.count" ] do
+        assert_raises ActiveRecord::RecordNotFound do
+          Book.transaction do
+            @book.update! published: true
+            @book.press Page.new(body: ""), title: "New page"
+            @book.leaves.find(-1).trashed!
+          end
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! slug: "still-a-draft"
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "a book left unpublished at commit is not announced" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "multiple publication changes in one transaction announce once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+        @book.update! published: true
+        @book.touch
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "a published book left published is not announced again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "each book published in a transaction is announced once" do
+    other_book = books(:manual)
+
+    assert_enqueued_jobs 2, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        other_book.update! published: true
+        @book.touch
+        other_book.touch
+      end
+    end
+
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ]
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ other_book ]
+  end
+
+  test "a rolled back savepoint does not forget an earlier publication" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+
+        Book.transaction(requires_new: true) do
+          @book.update! slug: "rolled-back"
+          raise ActiveRecord::Rollback
+        end
+
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert @book.reload.published?
+    assert_equal "handbook", @book.slug
+  end
+
+  test "publication in a rolled back savepoint does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.transaction(requires_new: true) do
+          @book.update! published: true
+          raise ActiveRecord::Rollback
+        end
+
+        @book.reload.update! slug: "still-a-draft"
+      end
+    end
+
+    assert_not @book.reload.published?
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "touching a separately loaded book does not lose the announcement" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        Book.find(@book.id).touch
+      end
+    end
+  end
+end
