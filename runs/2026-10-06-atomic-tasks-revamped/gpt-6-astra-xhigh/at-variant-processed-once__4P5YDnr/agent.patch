+require "test_helper"
+
+class PictureProcessingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    @uploaded_keys = []
+  end
+
+  teardown do
+    @uploaded_keys.each { |key| ActiveStorage::Blob.service.delete(key) }
+  end
+
+  test "readers reuse the background variant without changing the image bytes" do
+    assert_processed_once fixture_file_upload("white-rabbit.webp", "image/webp"), dimensions: [ 436, 600 ]
+  end
+
+  test "large photographs are still resized to fit within 1500 pixels" do
+    Tempfile.create([ "photograph", ".jpg" ]) do |file|
+      Vips::Image.new_from_file(file_fixture("reading.webp").to_s).resize(2, vscale: 1).jpegsave(file.path)
+
+      assert_processed_once Rack::Test::UploadedFile.new(file.path, "image/jpeg"), dimensions: [ 1500, 750 ]
+    end
+  end
+
+  private
+    def assert_processed_once(upload, dimensions:)
+      transformations = []
+      on_transform = ->(event) { transformations << event }
+      on_upload = ->(event) { @uploaded_keys << event.payload[:key] }
+
+      ActiveSupport::Notifications.subscribed(on_upload, "service_upload.active_storage") do
+        ActiveSupport::Notifications.subscribed(on_transform, "transform.active_storage") do
+          perform_enqueued_jobs do
+            put leafable_path(leaves(:reading_picture)), params: { picture: { image: upload } }
+            assert_response :no_content
+          end
+
+          blob = leaves(:reading_picture).reload.picture.image.blob
+          assert_equal 1, transformations.size
+          assert_equal 1, blob.variant_records.count
+          derived_blob = blob.variant_records.sole.image.blob
+          assert_equal [ blob.key, derived_blob.key ].sort, @uploaded_keys.sort
+          assert ActiveStorage::Blob.service.exist?(derived_blob.key)
+
+          2.times do
+            get leafable_slug_path(leaves(:reading_picture))
+            assert_response :success
+            image_path = css_select("figure img").sole["src"]
+
+            get image_path
+            assert_response :redirect
+            follow_redirect!
+            assert_response :success
+            assert_equal "image/webp", response.media_type
+            assert_equal derived_blob.download, response.body.b
+          end
+
+          assert_equal 1, transformations.size, "Reading the picture must not transform it again"
+          assert_equal 1, blob.variant_records.count
+          assert_equal [ blob.key, derived_blob.key ].sort, @uploaded_keys.sort
+        end
+      end
+
+      image = Vips::Image.new_from_buffer(response.body, "")
+      assert_equal dimensions, [ image.width, image.height ]
+      assert_equal legacy_reader_bytes(leaves(:reading_picture).reload.picture.image.blob), response.body.b
+    end
+
+    def legacy_reader_bytes(blob)
+      # Reproduce the original named variant's signed-URL round trip, independently
+      # of Picture's current variant definition, without storing another copy.
+      legacy_variant = blob.variant(resize_to_limit: [ 1500, 1500 ], format: :webp)
+      reader_variant = blob.variant(legacy_variant.variation.key)
+      blob.open do |input|
+        reader_variant.variation.transform(input) { |output| output.binmode.read }
+      end
+    end
+end
