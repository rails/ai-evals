--- /dev/null
+++ b/test/integration/raised_exceptions_test.rb
@@ -0,0 +1,143 @@
+require "test_helper"
+require "timeout"
+
+class RaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "raises without a preceding request and renders errors afterwards" do
+    with_raised_exceptions do
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+    end
+
+    get absent_book_path
+    assert_response :not_found
+    assert_in_body "ActiveRecord::RecordNotFound"
+  end
+
+  test "raises after a prior request without changing shared configuration" do
+    get absent_book_path
+    assert_response :not_found
+
+    config = Rails.application.config.action_dispatch.show_exceptions
+    env_config = Rails.application.env_config.dup
+
+    with_raised_exceptions do
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+      assert_equal config, Rails.application.config.action_dispatch.show_exceptions
+      assert_equal env_config, Rails.application.env_config
+    end
+
+    assert_equal config, Rails.application.config.action_dispatch.show_exceptions
+    assert_equal env_config, Rails.application.env_config
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "nested blocks restore the enclosing scope on normal and exceptional exits" do
+    with_raised_exceptions do
+      with_raised_exceptions do
+        assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+      end
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+
+      assert_raises ActiveRecord::RecordNotFound do
+        with_raised_exceptions { get absent_book_path }
+      end
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+    end
+
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "renders errors after a controller exception escapes the block" do
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions { get absent_book_path }
+    end
+
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "preserves the block result and restores rendering on non-local exits" do
+    assert_equal :result, with_raised_exceptions { :result }
+    assert_equal :result, catch(:finished) {
+      with_raised_exceptions { throw :finished, :result }
+    }
+
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "applies to existing and new sessions without persisting on those sessions" do
+    existing_session = open_session
+    new_session = nil
+
+    with_raised_exceptions do
+      assert_raises(ActiveRecord::RecordNotFound) { existing_session.get absent_book_path }
+      reset!
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+      new_session = open_session
+      assert_raises(ActiveRecord::RecordNotFound) { new_session.get absent_book_path }
+    end
+
+    [ self, existing_session, new_session ].each do |session|
+      session.get absent_book_path
+      session.assert_response :not_found
+    end
+  end
+
+  test "overlapping blocks in different threads do not affect each other or normal requests" do
+    path = absent_book_path
+    get path
+    assert_response :not_found
+
+    entered = Queue.new
+    releases = Array.new(2) { Queue.new }
+    threads = []
+
+    Timeout.timeout(30) do
+      releases.each do |release|
+        session = open_session
+        threads << Thread.new do
+          exception = nil
+          session.with_raised_exceptions do
+            entered << true
+            release.pop
+            begin
+              session.get path
+            rescue ActiveRecord::RecordNotFound => error
+              exception = error
+            end
+          end
+
+          session.get path
+          [ exception, session.response.status ]
+        end
+        entered.pop
+      end
+
+      get path
+      assert_response :not_found
+
+      # Exit the first scope while the second is still active, not in stack order.
+      threads.zip(releases).each do |thread, release|
+        release << true
+        exception, status = thread.value
+        assert_instance_of ActiveRecord::RecordNotFound, exception
+        assert_equal 404, status
+
+        get path
+        assert_response :not_found
+      end
+    end
+  ensure
+    threads&.each do |thread|
+      thread.kill
+      thread.join
+    end
+  end
+
+  private
+    def absent_book_path
+      book_slug_path(books(:manual))
+    end
+end
