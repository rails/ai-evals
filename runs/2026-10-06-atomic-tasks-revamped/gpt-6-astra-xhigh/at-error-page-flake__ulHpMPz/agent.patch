index 0000000..1ffbe34
--- /dev/null
+++ b/test/test_helpers/raised_exceptions_test_helper.rb
@@ -0,0 +1,24 @@
+module RaisedExceptionsTestHelper
+  # Integration requests run synchronously in the calling thread/fiber. Keep the
+  # scope local to it, and restore the previous value for nested blocks.
+  def with_raised_exceptions
+    previous = Thread.current[:raise_controller_exceptions]
+    Thread.current[:raise_controller_exceptions] = true
+    yield
+  ensure
+    Thread.current[:raise_controller_exceptions] = previous
+  end
+
+  # Rails merges its cached env_config into each request before calling middleware.
+  # Override only this request, without changing configuration shared by other tests.
+  class Middleware
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      env["action_dispatch.show_exceptions"] = :none if Thread.current[:raise_controller_exceptions]
+      @app.call(env)
+    end
+  end
+end
