diff --git a/app/models/book/access_import.rb b/app/models/book/access_import.rb
index 4d920cf..ae99e9c 100644
--- a/app/models/book/access_import.rb
+++ b/app/models/book/access_import.rb
@@ -6,20 +6,58 @@ class Book::AccessImport
   end
 
   def import
-    accesses = []
-    duplicate_index = nil
-
-    Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
+    result = import_accesses
+
+    unless result.duplicate_index
+      Access.current_transaction.after_commit do
+        result.accesses.each { |access| Book::AccessNotificationJob.perform_later(access) }
       end
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    result
   end
+
+  private
+    def import_accesses
+      return Result.new([], nil) if @grants.empty?
+      unless @book.persisted?
+        raise ActiveRecord::RecordNotSaved.new("You cannot call create unless the parent is saved", @book)
+      end
+
+      accesses = []
+      duplicate_index = nil
+
+      Access.transaction(requires_new: true) do
+        user_ids = existing_user_ids
+
+        @grants.each_with_index do |grant, index|
+          access = Access.new(book: @book, user_id: grant[:user_id], level: grant[:level])
+          access.validate!
+
+          unless user_ids.add?(access.user_id)
+            duplicate_index = index
+            raise ActiveRecord::Rollback
+          end
+
+          accesses << access
+        end
+
+        inserted = @book.accesses.insert_all!(accesses.map { |access| { user_id: access.user_id, level: access.level } })
+        saved_accesses = @book.accesses.where(id: inserted.rows.flatten).index_by(&:user_id)
+        accesses = accesses.map { |access| saved_accesses.fetch(access.user_id) }
+      end
+
+      duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    rescue ActiveRecord::RecordNotUnique
+      # A concurrent import may have granted access after the duplicate check.
+      user_ids = existing_user_ids
+      duplicate_index = accesses.index { |access| user_ids.include?(access.user_id) }
+      raise unless duplicate_index
+
+      Result.new([], duplicate_index)
+    end
+
+    def existing_user_ids
+      @book.accesses.where(user_id: @grants.pluck(:user_id)).pluck(:user_id).to_set
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..6cbf3d9
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,280 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+    @book.accesses.delete_all
+  end
+
+  test "imports persisted accesses in grant order and notifies each person" do
+    grants = [ grant(:kevin, :editor), grant(:jz, "reader"), grant(:david, :reader) ]
+
+    assert_enqueued_jobs grants.size, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+
+      assert_instance_of Book::AccessImport::Result, result
+      assert_nil result.duplicate_index
+      assert_equal grants.map { |grant| grant[:user_id] }, result.accesses.map(&:user_id)
+      assert_equal %w[ editor reader reader ], result.accesses.map(&:level)
+      result.accesses.each do |access|
+        assert access.persisted?
+        assert_equal @book, access.book
+        assert_equal access, Access.find(access.id)
+        assert_not_nil access.created_at
+        assert_not_nil access.updated_at
+        assert_enqueued_with job: Book::AccessNotificationJob, args: [ access ]
+      end
+    end
+  end
+
+  test "empty import returns an empty success without writes or notifications" do
+    assert_no_enqueued_jobs do
+      writes = record_writes do
+        result = Book::AccessImport.new(@book, []).import
+        assert_equal [], result.accesses
+        assert_nil result.duplicate_index
+      end
+      assert_empty writes
+    end
+  end
+
+  test "existing access rejects the entire roster at its first duplicate" do
+    existing = @book.accesses.create!(user: users(:jz), level: :reader)
+    grants = [ grant(:kevin), grant(:jz, :editor), grant(:david), grant(:jz) ]
+
+    assert_no_difference "Access.count" do
+      assert_no_enqueued_jobs do
+        result = Book::AccessImport.new(@book, grants).import
+        assert_equal [], result.accesses
+        assert_equal 1, result.duplicate_index
+      end
+    end
+    assert_equal "reader", existing.reload.level
+  end
+
+  test "repeated users in a roster reject the entire roster using type cast ids" do
+    grants = [ grant(:kevin), { user_id: users(:kevin).id.to_s, level: :editor }, grant(:david) ]
+
+    assert_no_difference "Access.count" do
+      assert_no_enqueued_jobs do
+        result = Book::AccessImport.new(@book, grants).import
+        assert_equal [], result.accesses
+        assert_equal 1, result.duplicate_index
+      end
+    end
+  end
+
+  test "duplicate detection uses persisted accesses rather than a cached association" do
+    @book.accesses.load
+    existing = Access.create!(book: @book, user: users(:jz), level: :reader)
+
+    assert_no_difference "Access.count" do
+      assert_no_enqueued_jobs do
+        result = Book::AccessImport.new(@book, [ grant(:kevin), grant(:jz, :editor) ]).import
+        assert_equal [], result.accesses
+        assert_equal 1, result.duplicate_index
+      end
+    end
+    assert_equal "reader", existing.reload.level
+  end
+
+  test "database uniqueness conflicts still reject atomically at the earliest duplicate" do
+    @book.accesses.create!(user: users(:david), level: :reader)
+    @book.accesses.create!(user: users(:jz), level: :reader)
+    importer = Book::AccessImport.new(@book, [ grant(:kevin), grant(:jz, :editor), grant(:david) ])
+    existing_user_ids = importer.method(:existing_user_ids)
+    checks = 0
+    # Simulate a grant arriving between the duplicate check and the bulk insert.
+    importer.define_singleton_method(:existing_user_ids) do
+      checks += 1
+      checks == 1 ? Set.new : existing_user_ids.call
+    end
+
+    assert_no_difference "Access.count" do
+      assert_no_enqueued_jobs do
+        result = importer.import
+        assert_equal [], result.accesses
+        assert_equal 1, result.duplicate_index
+      end
+    end
+    assert_equal 2, checks
+    assert_equal %w[ reader reader ], @book.accesses.pluck(:level)
+  end
+
+  test "unsaved books are rejected without saving the book or notifying anyone" do
+    book = Book.new(title: "Not yet saved")
+
+    assert_no_difference [ "Book.count", "Access.count" ] do
+      assert_no_enqueued_jobs do
+        error = assert_raises(ActiveRecord::RecordNotSaved) do
+          Book::AccessImport.new(book, [ grant(:kevin) ]).import
+        end
+        assert_equal book, error.record
+      end
+    end
+  end
+
+  test "duplicate at index zero is a rejection and stops processing later rows" do
+    @book.accesses.create!(user: users(:jz), level: :reader)
+
+    assert_no_enqueued_jobs do
+      result = Book::AccessImport.new(@book, [ grant(:jz), grant(:kevin, :unknown) ]).import
+      assert_equal [], result.accesses
+      assert_equal 0, result.duplicate_index
+    end
+  end
+
+  test "invalid users reject the entire roster without notifying anyone" do
+    [ nil, User.maximum(:id) + 1 ].each do |user_id|
+      assert_no_difference "Access.count" do
+        assert_no_enqueued_jobs do
+          error = assert_raises(ActiveRecord::RecordInvalid) do
+            Book::AccessImport.new(@book, [ grant(:kevin), { user_id: user_id, level: :reader } ]).import
+          end
+          assert error.record.errors.of_kind?(:user, :blank)
+        end
+      end
+    end
+  end
+
+  test "unknown and blank levels are validation failures without writes or notifications" do
+    [ :unknown, "unknown", nil, "" ].each do |level|
+      assert_no_difference "Access.count" do
+        assert_no_enqueued_jobs do
+          error = assert_raises(ActiveRecord::RecordInvalid) do
+            Book::AccessImport.new(@book, [ grant(:kevin), grant(:jz, level) ]).import
+          end
+          assert error.record.errors.of_kind?(:level, :inclusion)
+        end
+      end
+    end
+  end
+
+  test "validation failure before a duplicate is not reported as a duplicate" do
+    @book.accesses.create!(user: users(:jz), level: :reader)
+
+    assert_no_enqueued_jobs do
+      assert_raises(ActiveRecord::RecordInvalid) do
+        Book::AccessImport.new(@book, [ grant(:kevin, :unknown), grant(:jz) ]).import
+      end
+    end
+  end
+
+  test "notifications wait for the enclosing transaction to commit" do
+    result = nil
+    assert_enqueued_jobs 1, only: Book::AccessNotificationJob do
+      Access.transaction do
+        assert_no_enqueued_jobs do
+          result = Book::AccessImport.new(@book, [ grant(:kevin) ]).import
+        end
+      end
+    end
+    assert_enqueued_with job: Book::AccessNotificationJob, args: [ result.accesses.first ]
+  end
+
+  test "rolling back the enclosing transaction sends no notifications" do
+    assert_no_difference "Access.count" do
+      assert_no_enqueued_jobs do
+        Access.transaction do
+          Book::AccessImport.new(@book, [ grant(:kevin) ]).import
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "a rejected import does not leave partial grants in an enclosing transaction" do
+    @book.accesses.create!(user: users(:jz), level: :reader)
+
+    assert_no_difference "Access.count" do
+      assert_no_enqueued_jobs do
+        Access.transaction do
+          result = Book::AccessImport.new(@book, [ grant(:kevin), grant(:jz) ]).import
+          assert_equal 1, result.duplicate_index
+        end
+      end
+    end
+  end
+
+  test "successful roster write count does not grow with roster size" do
+    grants = roster
+    counts = [ 4, 16 ].map do |size|
+      @book.accesses.delete_all
+      writes = record_writes { Book::AccessImport.new(@book, grants.first(size)).import }
+      assert_equal 1, writes.grep(/\A\s*INSERT\b/i).size
+      writes.size
+    end
+    assert_equal counts.first, counts.last
+  end
+
+  test "duplicate rejection write count does not grow with roster size" do
+    grants = roster
+    counts = [ 4, 16 ].map do |size|
+      writes = record_writes do
+        result = Book::AccessImport.new(@book, grants.first(size - 1) + [ grants.first ]).import
+        assert_equal size - 1, result.duplicate_index
+        assert_empty result.accesses
+      end
+      assert_empty @book.accesses.reload
+      writes.size
+    end
+    assert_equal counts.first, counts.last
+  end
+
+  test "existing access rejection write count does not grow with roster size" do
+    grants = roster
+    existing = @book.accesses.create!(user: users(:jz), level: :reader)
+    counts = [ 4, 16 ].map do |size|
+      writes = record_writes do
+        result = Book::AccessImport.new(@book, grants.first(size - 1) + [ grant(:jz, :editor) ]).import
+        assert_equal size - 1, result.duplicate_index
+        assert_empty result.accesses
+      end
+      assert_equal [ existing ], @book.accesses.reload
+      writes.size
+    end
+    assert_equal "reader", existing.reload.level
+    assert_equal counts.first, counts.last
+  end
+
+  test "invalid roster write count does not grow with roster size" do
+    grants = roster
+    [ { user_id: nil, level: :reader }, grant(:jz, :unknown) ].each do |invalid_grant|
+      counts = [ 4, 16 ].map do |size|
+        writes = record_writes do
+          assert_raises(ActiveRecord::RecordInvalid) do
+            Book::AccessImport.new(@book, grants.first(size - 1) + [ invalid_grant ]).import
+          end
+        end
+        assert_empty @book.accesses.reload
+        writes.size
+      end
+      assert_equal counts.first, counts.last
+    end
+  end
+
+  private
+    def grant(user, level = :reader)
+      { user_id: users(user).id, level: level }
+    end
+
+    def roster
+      attributes = users(:kevin).attributes.except("id", "name", "email_address")
+      inserted = User.insert_all!(16.times.map do |index|
+        attributes.merge("name" => "Roster member #{index}", "email_address" => "roster#{index}@example.com")
+      end)
+      inserted.rows.flatten.map { |user_id| { user_id: user_id, level: :reader } }
+    end
+
+    def record_writes
+      writes = []
+      subscriber = ->(event) do
+        sql = event.payload[:sql]
+        writes << sql if sql.match?(/\A\s*(?:INSERT|UPDATE|DELETE|BEGIN|COMMIT|ROLLBACK|SAVEPOINT|RELEASE)\b/i)
+      end
+      ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") { yield }
+      writes
+    end
+end
