diff --git a/lib/book_search_rate_limiter.rb b/lib/book_search_rate_limiter.rb
new file mode 100644
index 0000000..1027f77
--- /dev/null
+++ b/lib/book_search_rate_limiter.rb
@@ -0,0 +1,67 @@
+# Keep a rolling minute of accepted searches, shared by all books. In production,
+# Redis checks and records each request atomically across all web workers.
+class BookSearchRateLimiter
+  LIMIT = 30
+  WINDOW = 1.minute
+
+  REDIS_SCRIPT = <<~LUA.freeze
+    local time = redis.call('TIME')
+    local now = time[1] * 1000 + math.floor(time[2] / 1000)
+    local window = tonumber(ARGV[1])
+
+    redis.call('ZREMRANGEBYSCORE', KEYS[1], '-inf', now - window)
+    if redis.call('ZCARD', KEYS[1]) >= tonumber(ARGV[2]) then
+      return 0
+    end
+
+    redis.call('ZADD', KEYS[1], now, ARGV[3])
+    redis.call('PEXPIRE', KEYS[1], window)
+    return 1
+  LUA
+
+  def initialize(cache: Rails.cache)
+    # Development and tests normally disable caching. Still enforce the limit
+    # locally there, without requiring a Redis server to run the test suite.
+    @cache = cache.is_a?(ActiveSupport::Cache::NullStore) ? ActiveSupport::Cache::MemoryStore.new : cache
+    @mutex = Mutex.new
+  end
+
+  def allowed?(address)
+    key = "rate-limit:books/searches:#{address}"
+
+    if @cache.is_a?(ActiveSupport::Cache::RedisCacheStore)
+      allow_with_redis?(key)
+    else
+      allow_locally?(key)
+    end
+  end
+
+  private
+    def allow_with_redis?(key)
+      namespace = @cache.options[:namespace]
+      namespace = namespace.call if namespace.respond_to?(:call)
+      key = "#{namespace}:#{key}" if namespace
+
+      @cache.redis.with do |redis|
+        redis.eval(REDIS_SCRIPT, keys: [ key ], argv: [ WINDOW.in_milliseconds, LIMIT, SecureRandom.uuid ]) == 1
+      end
+    rescue Redis::BaseError, ConnectionPool::TimeoutError => error
+      # Match the cache's fail-open behavior if Redis is unavailable.
+      Rails.error.report(error, handled: true)
+      true
+    end
+
+    def allow_locally?(key)
+      @mutex.synchronize do
+        now = Time.now.to_f
+        requests = (@cache.read(key) || []).reject { |timestamp| timestamp <= now - WINDOW }
+
+        if requests.size < LIMIT
+          @cache.write(key, requests << now, expires_in: WINDOW)
+          true
+        else
+          false
+        end
+      end
+    end
+end
