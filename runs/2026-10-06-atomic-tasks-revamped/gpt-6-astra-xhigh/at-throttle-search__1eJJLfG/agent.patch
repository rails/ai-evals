index 0000000..476e4b4
--- /dev/null
+++ b/test/lib/book_search_rate_limiter_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class BookSearchRateLimiterTest < ActiveSupport::TestCase
+  test "concurrent requests cannot exceed the address limit" do
+    limiter = BookSearchRateLimiter.new(cache: ActiveSupport::Cache::MemoryStore.new)
+
+    freeze_time do
+      results = 60.times.map do
+        Thread.new { limiter.allowed?("198.51.100.1") }
+      end.map(&:value)
+
+      assert_equal 30, results.count(true)
+      assert_equal 30, results.count(false)
+      assert limiter.allowed?("198.51.100.2")
+    end
+  end
+
+  test "rate limiting still works when application caching is disabled" do
+    limiter = BookSearchRateLimiter.new(cache: ActiveSupport::Cache::NullStore.new)
+
+    freeze_time do
+      30.times { assert limiter.allowed?("2001:db8::1") }
+      assert_not limiter.allowed?("2001:db8::1")
+
+      travel 1.minute
+      assert limiter.allowed?("2001:db8::1")
+    end
+  end
+  test "Redis checks and records requests in one atomic call using the cache connection pool" do
+    redis = RecordingRedis.new
+    cache = ActiveSupport::Cache::RedisCacheStore.new(redis: redis, namespace: -> { "writebook-test" })
+    limiter = BookSearchRateLimiter.new(cache: cache)
+
+    assert limiter.allowed?("198.51.100.1")
+    redis.result = 0
+    assert_not limiter.allowed?("198.51.100.1")
+
+    assert_equal 2, redis.calls.size
+    redis.calls.each do |call|
+      assert_equal BookSearchRateLimiter::REDIS_SCRIPT, call[:script]
+      assert_equal [ "writebook-test:rate-limit:books/searches:198.51.100.1" ], call[:keys]
+      assert_equal [ 60_000, 30 ], call[:argv].first(2)
+    end
+    assert_not_equal redis.calls.first[:argv].last, redis.calls.last[:argv].last,
+      "Simultaneous requests need distinct sorted-set members"
+  ensure
+    cache&.redis&.shutdown { }
+  end
+
+  test "a Redis outage does not turn public searches into server errors" do
+    redis = RecordingRedis.new
+    redis.error = Redis::CannotConnectError.new("Redis unavailable")
+    cache = ActiveSupport::Cache::RedisCacheStore.new(redis: redis, pool: false)
+    limiter = BookSearchRateLimiter.new(cache: cache)
+
+    assert limiter.allowed?("198.51.100.1")
+  end
+
+  private
+    class RecordingRedis
+      attr_accessor :result, :error
+      attr_reader :calls
+
+      def initialize
+        @calls = []
+        @result = 1
+      end
+
+      def with
+        yield self
+      end
+
+      def eval(script, keys:, argv:)
+        @calls << { script: script, keys: keys, argv: argv }
+        raise error if error
+        result
+      end
+    end
+end
