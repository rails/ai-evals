diff --git a/test/integration/raised_exceptions_test.rb b/test/integration/raised_exceptions_test.rb
new file mode 100644
index 0000000..2cb47ad
--- /dev/null
+++ b/test/integration/raised_exceptions_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+
+class RaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "raises only within the block after an ordinary request" do
+    get absent_book_path
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+    end
+
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "does not change application configuration or cached request defaults" do
+    configuration = Rails.application.config.action_dispatch.show_exceptions
+    defaults = Rails.application.env_config.dup
+
+    with_raised_exceptions do
+      assert_equal configuration, Rails.application.config.action_dispatch.show_exceptions
+      assert_equal defaults, Rails.application.env_config
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+    end
+
+    assert_equal configuration, Rails.application.config.action_dispatch.show_exceptions
+    assert_equal defaults, Rails.application.env_config
+  end
+
+  test "restores normal rendering when a controller exception escapes the block" do
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions { get absent_book_path }
+    end
+
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "nested blocks restore the outer scope on normal and exceptional exits" do
+    with_raised_exceptions do
+      with_raised_exceptions do
+        assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+      end
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+
+      assert_raises ActiveRecord::RecordNotFound do
+        with_raised_exceptions { get absent_book_path }
+      end
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+    end
+
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "returns the block value and restores normal rendering after a nonlocal exit" do
+    assert_equal :result, with_raised_exceptions { :result }
+    result = catch(:done) do
+      with_raised_exceptions { throw :done, :result }
+    end
+    assert_equal :result, result
+
+    get absent_book_path
+    assert_response :not_found
+  end
+
+  test "applies to existing new and reset integration sessions only inside the block" do
+    existing_session = open_session
+    existing_session.get absent_book_path
+    existing_session.assert_response :not_found
+    new_session = nil
+
+    with_raised_exceptions do
+      assert_raises(ActiveRecord::RecordNotFound) { existing_session.get absent_book_path }
+      new_session = open_session
+      assert_raises(ActiveRecord::RecordNotFound) { new_session.get absent_book_path }
+      reset!
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+    end
+
+    [ self, existing_session, new_session ].each do |session|
+      session.get absent_book_path
+      session.assert_response :not_found
+    end
+  end
+
+  test "does not affect requests on another thread" do
+    path = absent_book_path
+    session = open_session
+    entered = Queue.new
+    finish = Queue.new
+
+    worker = Thread.new do
+      with_raised_exceptions do
+        entered << true
+        finish.pop
+        assert_raises(ActiveRecord::RecordNotFound) { session.get path }
+      end
+      session.get path
+      session.assert_response :not_found
+    end
+
+    entered.pop
+    get path
+    assert_response :not_found
+  ensure
+    finish << true
+    worker&.value
+  end
+
+  test "overlapping blocks on different threads can exit in either order" do
+    path = absent_book_path
+    session = open_session
+    entered = Queue.new
+    finish = Queue.new
+
+    worker = Thread.new do
+      with_raised_exceptions do
+        entered << true
+        finish.pop
+      end
+      session.get path
+      session.assert_response :not_found
+    end
+
+    entered.pop
+    with_raised_exceptions do
+      finish << true
+      worker.value
+      assert_raises(ActiveRecord::RecordNotFound) { get path }
+    end
+
+    get path
+    assert_response :not_found
+  ensure
+    finish << true
+    worker&.value
+  end
+
+  private
+    def absent_book_path
+      book_slug_path(books(:manual))
+    end
+end
