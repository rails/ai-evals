diff --git a/test/test_helpers/raised_exceptions_test_helper.rb b/test/test_helpers/raised_exceptions_test_helper.rb
new file mode 100644
index 0000000..bb780cf
--- /dev/null
+++ b/test/test_helpers/raised_exceptions_test_helper.rb
@@ -0,0 +1,26 @@
+module RaisedExceptionsTestHelper
+  def with_raised_exceptions
+    # Thread#[] is fiber-local, keeping overlapping test scopes independent.
+    previous = Thread.current[:raised_exceptions_test_helper]
+    Thread.current[:raised_exceptions_test_helper] = true
+    yield
+  ensure
+    Thread.current[:raised_exceptions_test_helper] = previous
+  end
+
+  class Middleware
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      # Rails has already merged its cached env_config into this request. Change
+      # only the request, not the application defaults used by other tests.
+      if Thread.current[:raised_exceptions_test_helper]
+        env["action_dispatch.show_exceptions"] = :none
+      end
+
+      @app.call(env)
+    end
+  end
+end
