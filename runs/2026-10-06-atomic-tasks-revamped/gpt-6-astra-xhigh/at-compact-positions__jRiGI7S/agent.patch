@@ -0,0 +1,12 @@
+require "test_helper"
+
+class SQLiteStrictStringsTest < ActiveSupport::TestCase
+  test "unknown double quoted identifiers raise instead of becoming string literals" do
+    assert_raises ActiveRecord::StatementInvalid do
+      Leaf.connection.select_all(<<~SQL)
+        SELECT id, ROW_NUMBER() OVER (ORDER BY "position_socre", id) AS rank
+        FROM leaves
+      SQL
+    end
+  end
+end
diff --git a/test/models/book/maintenance_test.rb b/test/models/book/maintenance_test.rb
new file mode 100644
index 0000000..0037c00
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "compaction preserves score order rather than primary key order" do
+    ordered_leaves = @book.leaves.order(id: :desc).to_a
+    ordered_leaves.zip([ -10.5, 0, 20.25, 400 ]).each do |leaf, score|
+      leaf.update_columns(position_score: score)
+    end
+
+    @book.compact_positions!
+
+    assert_equal ordered_leaves.map(&:id), @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compaction breaks score ties by id" do
+    first, second, third, fourth = @book.leaves.order(:id).to_a
+    [ first, second, third, fourth ].zip([ 40.5, -7, -7, 2.75 ]).each do |leaf, score|
+      leaf.update_columns(position_score: score)
+    end
+
+    @book.compact_positions!
+
+    assert_equal [ second, third, fourth, first ].map(&:id), @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compaction includes trashed leaves so restoring preserves their place" do
+    @book.leaves.update_all("position_score = position_score * 10")
+    trashed_leaf = leaves(:welcome_page)
+    trashed_leaf.trashed!
+    expected_order = @book.leaves.positioned.ids
+    expected_live_order = @book.leaves.active.positioned.ids
+
+    @book.compact_positions!
+
+    assert_equal expected_order, @book.leaves.positioned.ids
+    assert_equal expected_live_order, @book.leaves.active.positioned.ids
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    assert_predicate trashed_leaf.reload, :trashed?
+
+    trashed_leaf.active!
+
+    assert_equal expected_order, @book.leaves.active.positioned.ids
+  end
+
+  test "compaction only ranks and updates the current book's leaves" do
+    other_leaf = leaves(:reading_picture)
+    other_leaf.update_columns(book_id: books(:manual).id, position_score: -100)
+    expected_order = @book.leaves.positioned.ids
+
+    @book.compact_positions!
+
+    assert_equal expected_order, @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3 ], @book.leaves.positioned.pluck(:position_score)
+    assert_equal(-100, other_leaf.reload.position_score)
+  end
+
+  test "compaction is idempotent" do
+    @book.compact_positions!
+    compacted_scores = @book.leaves.positioned.pluck(:id, :position_score)
+
+    @book.compact_positions!
+
+    assert_equal compacted_scores, @book.leaves.positioned.pluck(:id, :position_score)
+  end
+
+  test "compaction handles an empty book without affecting other books" do
+    scores = @book.leaves.positioned.pluck(:id, :position_score)
+
+    books(:manual).compact_positions!
+
+    assert_empty books(:manual).leaves
+    assert_equal scores, @book.leaves.positioned.pluck(:id, :position_score)
+  end
+
+  test "compaction handles a single trashed leaf" do
+    leaf = leaves(:welcome_page)
+    leaf.update_columns(book_id: books(:manual).id, status: "trashed", position_score: 50)
+
+    books(:manual).compact_positions!
+
+    assert_equal 1, leaf.reload.position_score
+    assert_predicate leaf, :trashed?
+  end
+
+  test "live leaf count excludes trash and other books and includes restored leaves" do
+    leaves(:reading_picture).update_columns(book_id: books(:manual).id)
+    leaves(:welcome_page).trashed!
+
+    assert_equal 2, @book.live_leaf_count
+    assert_equal 1, books(:manual).live_leaf_count
+
+    leaves(:welcome_page).active!
+
+    assert_equal 3, @book.live_leaf_count
+  end
+
+  test "live leaf count is zero for empty books and books with only trash" do
+    @book.leaves.update_all(status: "trashed")
+
+    assert_equal 0, @book.live_leaf_count
+    assert_equal 0, books(:manual).live_leaf_count
+  end
+end
