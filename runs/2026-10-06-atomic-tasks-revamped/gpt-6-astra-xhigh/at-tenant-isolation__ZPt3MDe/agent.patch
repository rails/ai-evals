+
+    # Keep existing installations together without invoking application callbacks.
+    execute <<~SQL
+      INSERT INTO tenants (name, created_at, updated_at)
+      VALUES ('Default', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
+    SQL
+    execute "UPDATE users SET tenant_id = (SELECT id FROM tenants LIMIT 1)"
+    execute "UPDATE books SET tenant_id = (SELECT id FROM tenants LIMIT 1)"
+  end
+
+  def down
