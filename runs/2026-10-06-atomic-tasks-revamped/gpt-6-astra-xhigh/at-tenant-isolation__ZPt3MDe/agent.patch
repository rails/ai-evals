new file mode 100644
index 0000000..2e4a479
--- /dev/null
+++ b/app/models/tenanted.rb
@@ -0,0 +1,14 @@
+module Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    # Tenantless records retain their legacy, install-wide behavior.
+    scope :in_tenant, ->(tenant_id) { where(tenant_id: [ nil, tenant_id ]) if tenant_id.present? }
+  end
+
+  def same_tenant?(other)
+    tenant_id.nil? || other&.tenant_id.nil? || tenant_id == other.tenant_id
+  end
+end
