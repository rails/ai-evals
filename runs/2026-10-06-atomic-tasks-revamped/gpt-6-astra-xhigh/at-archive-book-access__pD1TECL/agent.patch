diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..73e5317 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,45 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy archives everyone with access and removes the book and its grants" do
+    book = books(:handbook)
+    expected_archives = book.accesses.order(:user_id).map do |access|
+      [ book.id, book.title, access.user_id, access.user.name, access.level ]
+    end
+
+    assert_difference "Book.count" => -1, "Access.count" => -expected_archives.size, "AccessArchive.count" => expected_archives.size do
+      delete book_path(book)
+    end
+
+    assert_redirected_to root_path
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+    assert_not Leaf.exists?(book_id: book.id)
+    assert_equal expected_archives, AccessArchive.where(book_id: book.id).order(:user_id).pluck(:book_id, :book_title, :user_id, :user_name, :level)
+  end
+
+  test "destroy archives access levels after sharing changes and excludes revoked users" do
+    book = books(:handbook)
+
+    assert_no_difference "AccessArchive.count" do
+      patch book_path(book), params: {
+        book: { everyone_access: false },
+        editor_ids: [ users(:jz).id ],
+        reader_ids: [ users(:jason).id ]
+      }
+    end
+    assert_redirected_to book_slug_path(book)
+
+    assert_difference "AccessArchive.count", 3 do
+      delete book_path(book)
+    end
+
+    assert_redirected_to root_path
+    assert_equal [
+      [ users(:jz).id, "editor" ],
+      [ users(:jason).id, "reader" ],
+      [ users(:kevin).id, "editor" ]
+    ].sort, AccessArchive.where(book_id: book.id).order(:user_id).pluck(:user_id, :level)
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..246681e 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,81 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "access archives are written only after the book and its grants are deleted" do
+    book = books(:manual)
+    archive_count = 0
+    check_deletion = ->(event) do
+      if event.payload[:sql].start_with?('INSERT INTO "access_archives"')
+        archive_count += 1
+        assert_not Book.exists?(book.id)
+        assert_not Access.exists?(book_id: book.id)
+      end
+    end
+
+    ActiveSupport::Notifications.subscribed(check_deletion, "sql.active_record") do
+      book.destroy!
+    end
+
+    assert_equal 3, archive_count
+  end
+
+  test "destroy archives current grants rather than previously loaded access" do
+    book = books(:handbook)
+    book.accesses.load
+
+    assert_no_difference "AccessArchive.count" do
+      book.update!(everyone_access: false)
+      book.update_access(editors: [ users(:jz).id ], readers: [ users(:kevin).id ])
+    end
+
+    assert_difference "AccessArchive.count", 2 do
+      book.destroy!
+    end
+
+    assert_equal [
+      [ users(:jz).id, "editor" ],
+      [ users(:kevin).id, "reader" ]
+    ].sort, AccessArchive.where(book_id: book.id).order(:user_id).pluck(:user_id, :level)
+    assert_not Access.exists?(book_id: book.id)
+  end
+
+  test "destroying a book without access does not write archives" do
+    book = books(:manual)
+    book.accesses.load
+    Access.where(book_id: book.id).delete_all
+
+    assert_no_difference "AccessArchive.count" do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+  end
+
+  test "destroying a book again does not duplicate access archives" do
+    book = books(:manual)
+
+    assert_difference "AccessArchive.count", 3 do
+      book.destroy!
+    end
+
+    assert_no_difference "AccessArchive.count" do
+      book.destroy!
+    end
+  end
+
+  test "access archives roll back with book deletion" do
+    book = books(:manual)
+
+    assert_no_difference [ "Book.count", "Access.count", "AccessArchive.count" ] do
+      Book.transaction(requires_new: true) do
+        assert_difference "AccessArchive.count", 3 do
+          book.destroy!
+        end
+
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
 end
