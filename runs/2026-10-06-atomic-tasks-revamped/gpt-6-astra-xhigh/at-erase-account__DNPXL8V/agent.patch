new file mode 100644
index 0000000..beaad29
--- /dev/null
+++ b/app/models/book/erasure.rb
@@ -0,0 +1,33 @@
+module Book::Erasure
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :remember_erased_blobs, prepend: true
+    after_destroy_commit :purge_erased_blobs
+  end
+
+  private
+    def remember_erased_blobs
+      leafables = (leaves.map(&:leafable) + Edit.where(leaf_id: leaves.select(:id)).map(&:leafable)).compact.uniq
+      markdowns = ActionText::Markdown.where(record: leafables).to_a
+      records = [ self ] + leafables + markdowns
+
+      @erased_blobs = ActiveStorage::Attachment.where(record: records).includes(:blob).map(&:blob).uniq
+    end
+
+    def purge_erased_blobs
+      @erased_blobs.each { |blob| purge_unattached_blob(blob) }
+    end
+
+    # Files cannot be rolled back, so purge only after the deletion commits.
+    # Blobs shared with surviving books (and their variants) must remain intact.
+    def purge_unattached_blob(blob)
+      return if blob.attachments.exists?
+
+      representations = blob.variant_records.includes(image_attachment: :blob).filter_map { |variant| variant.image_attachment&.blob }
+      representations << blob.preview_image.blob if blob.preview_image.attached?
+
+      blob.purge
+      representations.each { |representation| purge_unattached_blob(representation) }
+    end
+end
