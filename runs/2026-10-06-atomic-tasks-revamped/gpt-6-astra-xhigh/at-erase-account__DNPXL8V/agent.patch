+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,252 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  setup do
+    @uploaded_blobs = []
+    # Erasure must not remove a fixture file used by other tests.
+    image = file_fixture("reading.webp").open do |file|
+      ActiveStorage::Blob.create_and_upload!(io: file, filename: "private.webp")
+    end
+    @uploaded_blobs << image
+    leaves(:reading_picture).picture.image.attach(image)
+    @user = users(:kevin)
+    @private_book = books(:handbook)
+    @private_book.update!(creator: @user, everyone_access: false, published: true, author: @user.name)
+    @shared_book = books(:manual)
+    @shared_book.update!(creator: @user, everyone_access: true, published: false, author: @user.name)
+  end
+
+  teardown do
+    @uploaded_blobs.each(&:delete)
+  end
+
+  test "erasure deletes personal data and private content but preserves everyone books" do
+    @user.sessions.start!(ip_address: "192.0.2.1", user_agent: "Private browser")
+    ReadingMark.remember(leaves(:welcome_page), user: @user)
+    ReadingMark.remember(leaves(:summary_page), user: users(:jason))
+    shared_leaf = @shared_book.press(Page.new(body: "Shared reading"), title: "Shared page")
+    shared_mark = ReadingMark.remember(shared_leaf, user: users(:jason))
+    ReadingMark.remember(shared_leaf, user: @user)
+    other_event = SignInEvent.create!(email_address: users(:jason).email_address, action: :signed_in)
+
+    leaves(:welcome_page).edit(leafable_params: { body: "Private revision" })
+    leaves(:welcome_page).trashed!
+    leaves(:reading_picture).edit(leafable_params: { caption: "Private picture revision" })
+    leaves(:welcome_section).edit(leafable_params: { body: "Private section revision" })
+    leaves(:welcome_section).trashed!
+    private_leaf_ids = @private_book.leaves.ids
+    private_leafables = (@private_book.leaves.map(&:leafable) + Edit.where(leaf_id: private_leaf_ids).map(&:leafable)).uniq
+    private_markdown_ids = ActionText::Markdown.where(record: private_leafables.grep(Page)).ids
+    Leaf.reindex_all
+    assert indexed?(leaves(:welcome_page).id)
+    assert indexed?(shared_leaf.id)
+
+    @user.destroy!
+
+    assert_not User.exists?(@user.id)
+    assert_not Session.exists?(user_id: @user.id)
+    assert_not Access.exists?(user_id: @user.id)
+    assert_not ReadingMark.exists?(user_id: @user.id)
+    assert_not SignInEvent.exists?(email_address: @user.email_address)
+    assert SignInEvent.exists?(other_event.id)
+    assert_not Book.exists?(@private_book.id)
+    assert_not Access.exists?(book_id: @private_book.id)
+    assert_not Leaf.exists?(id: private_leaf_ids)
+    assert_not Edit.exists?(leaf_id: private_leaf_ids)
+    assert_not ReadingMark.exists?(leaf_id: private_leaf_ids)
+    assert_not ActionText::Markdown.exists?(id: private_markdown_ids)
+    private_leafables.each { |leafable| assert_not leafable.class.exists?(leafable.id) }
+    private_leaf_ids.each { |id| assert_not indexed?(id) }
+
+    assert_nil @shared_book.reload.creator_id
+    assert_equal "Deleted author", @shared_book.author
+    assert_equal "Manual", @shared_book.title
+    assert_not @shared_book.published?
+    assert @shared_book.accessable?(user: users(:jason))
+    assert Leaf.exists?(shared_leaf.id)
+    assert ReadingMark.exists?(shared_mark.id)
+    assert indexed?(shared_leaf.id)
+  end
+
+  test "erasure removes audit events for exact original and rewritten legacy addresses" do
+    original_address = @user.email_address
+    deactivate_legacy_user
+    first_rewritten_address = @user.email_address
+    deactivate_legacy_user
+    addresses = [ original_address, first_rewritten_address, @user.email_address ]
+    addresses.each do |address|
+      SignInEvent.create!(email_address: address, action: :signed_in)
+      SignInEvent.create!(email_address: address, action: :signed_out)
+    end
+    unrelated = SignInEvent.create!(email_address: "other-#{original_address}", action: :signed_in)
+
+    @user.destroy!
+
+    assert_not User.exists?(@user.id)
+    assert_not SignInEvent.exists?(email_address: addresses)
+    assert SignInEvent.exists?(unrelated.id)
+  end
+
+  test "an active address with a deactivation suffix is not treated as legacy" do
+    original_address = @user.email_address
+    @user.update!(email_address: original_address.sub("@", "-deactivated-#{SecureRandom.uuid}@"))
+    unrelated = SignInEvent.create!(email_address: original_address, action: :signed_in)
+    SignInEvent.create!(email_address: @user.email_address, action: :signed_in)
+
+    @user.destroy!
+
+    assert SignInEvent.exists?(unrelated.id)
+    assert_not SignInEvent.exists?(email_address: @user.email_address)
+  end
+
+  test "erasure purges private files and variants but not shared blobs" do
+    cover = upload_blob("private cover")
+    upload = upload_blob("private markdown upload")
+    old_upload = upload_blob("private historical upload")
+    shared_blob = upload_blob("shared cover")
+    @private_book.cover.attach(cover)
+    leaves(:welcome_page).page.body.uploads.attach(old_upload)
+    leaves(:welcome_page).edit(leafable_params: { body: "New version" })
+    leaves(:welcome_page).page.body.uploads.attach(upload)
+    leaves(:summary_page).page.body.uploads.attach(shared_blob)
+    @shared_book.cover.attach(shared_blob)
+
+    # Use an actual stored image to exercise tracked variant files as well.
+    image = leaves(:reading_picture).picture.image.blob
+    leaves(:reading_picture).edit(leafable_params: { caption: "Another version" })
+    variant = image.variant(resize_to_limit: [ 10, 10 ]).processed
+    variant_blob = variant.image.blob
+    @uploaded_blobs << variant_blob
+    blobs = [ cover, upload, old_upload, image, variant_blob ]
+    blobs.each { |blob| assert blob.service.exist?(blob.key) }
+
+    @user.destroy!
+
+    blobs.each do |blob|
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not ActiveStorage::Attachment.exists?(blob_id: blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+    assert_not ActiveStorage::VariantRecord.exists?(blob_id: image.id)
+    assert ActiveStorage::Blob.exists?(shared_blob.id)
+    assert shared_blob.service.exist?(shared_blob.key)
+    assert_equal shared_blob, @shared_book.reload.cover.blob
+  end
+
+  test "preloaded created books do not cause everyone books to be destroyed" do
+    @user.created_books.load
+
+    @user.destroy!
+
+    assert_equal "Deleted author", @shared_book.reload.author
+    assert_nil @shared_book.creator_id
+    assert_not Book.exists?(@private_book.id)
+  end
+
+  test "deleting a leaf removes stale search rows even when it is no longer searchable" do
+    leaf = leaves(:welcome_section)
+    leaf.section.update!(body: "Secret indexed text")
+    leaf.reindex
+    leaf.section.update!(body: nil)
+    assert indexed?(leaf.id)
+
+    @user.destroy!
+
+    assert_not indexed?(leaf.id)
+  end
+
+  test "a failed erasure rolls back personal data content and search without purging files" do
+    blob = upload_blob("must survive rollback")
+    @private_book.cover.attach(blob)
+    session = @user.sessions.start!(ip_address: "192.0.2.1", user_agent: "Private browser")
+    mark = ReadingMark.remember(leaves(:welcome_page), user: @user)
+    Leaf.reindex_all
+
+    User.transaction do
+      @user.destroy!
+      assert_not User.exists?(@user.id)
+      assert_not indexed?(leaves(:welcome_page).id)
+      assert blob.service.exist?(blob.key)
+      raise ActiveRecord::Rollback
+    end
+
+    assert User.exists?(@user.id)
+    assert Session.exists?(session.id)
+    assert ReadingMark.exists?(mark.id)
+    assert SignInEvent.exists?(email_address: @user.email_address)
+    assert_equal @user.id, @shared_book.reload.creator_id
+    assert_equal @user.name, @shared_book.author
+    assert Book.exists?(@private_book.id)
+    assert indexed?(leaves(:welcome_page).id)
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert blob.service.exist?(blob.key)
+  end
+
+  test "erasure does not delete books the user can access but did not create" do
+    @private_book.update!(creator: users(:jason), author: "Other author")
+    @shared_book.update!(creator: nil, author: "Unowned book")
+    ReadingMark.remember(leaves(:welcome_page), user: @user)
+    other_mark = ReadingMark.remember(leaves(:welcome_page), user: users(:jason))
+    Leaf.reindex_all
+
+    @user.destroy!
+
+    assert_equal "Other author", @private_book.reload.author
+    assert_equal users(:jason), @private_book.creator
+    assert_equal "Unowned book", @shared_book.reload.author
+    assert ReadingMark.exists?(other_mark.id)
+    assert_not ReadingMark.exists?(user_id: @user.id)
+    assert Leaf.exists?(leaves(:welcome_page).id)
+    assert indexed?(leaves(:welcome_page).id)
+  end
+
+  test "inactive addresses with a non-UUID suffix are not broadened" do
+    original_address = @user.email_address
+    @user.update!(active: false, email_address: original_address.sub("@", "-deactivated-not-a-uuid@"))
+    unrelated = SignInEvent.create!(email_address: original_address, action: :signed_in)
+    SignInEvent.create!(email_address: @user.email_address, action: :signed_in)
+
+    @user.destroy!
+
+    assert SignInEvent.exists?(unrelated.id)
+    assert_not SignInEvent.exists?(email_address: @user.email_address)
+  end
+
+  test "a dependent deletion failure aborts the entire erasure" do
+    page_id = pages(:summary).id
+    refuse_deletion = -> { throw :abort if id == page_id }
+    Page.set_callback(:destroy, :before, refuse_deletion)
+    @user.sessions.start!(ip_address: "192.0.2.1", user_agent: "Private browser")
+    Leaf.reindex_all
+
+    assert_raises ActiveRecord::RecordNotDestroyed do
+      @user.destroy!
+    end
+
+    assert User.exists?(@user.id)
+    assert Session.exists?(user_id: @user.id)
+    assert SignInEvent.exists?(email_address: @user.email_address)
+    assert Book.exists?(@private_book.id)
+    assert_equal @user.id, @shared_book.reload.creator_id
+    assert_equal @user.name, @shared_book.author
+    assert Page.exists?(pages(:welcome).id)
+    assert indexed?(leaves(:welcome_page).id)
+  ensure
+    Page.skip_callback(:destroy, :before, refuse_deletion)
+  end
+
+  private
+    def deactivate_legacy_user
+      @user.update!(active: false, email_address: @user.email_address.sub("@", "-deactivated-#{SecureRandom.uuid}@"))
+    end
+
+    def upload_blob(content)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new(content), filename: "private.txt", content_type: "text/plain").tap do |blob|
+        @uploaded_blobs << blob
+      end
+    end
+
+    def indexed?(id)
+      Leaf.connection.select_value("SELECT count(*) FROM leaf_search_index WHERE rowid = #{Integer(id)}").positive?
+    end
+end
