--- /dev/null
+++ b/app/models/user/erasure.rb
@@ -0,0 +1,36 @@
+module User::Erasure
+  extend ActiveSupport::Concern
+
+  # Only recognize the exact suffix written by the former deactivation flow.
+  DEACTIVATED_EMAIL_SUFFIX = /-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?=@[^@]+\z)/i
+
+  included do
+    before_destroy :anonymize_shared_books, prepend: true
+    before_destroy :erase_sign_in_events
+  end
+
+  private
+    def anonymize_shared_books
+      created_books.with_everyone_access.update_all(creator_id: nil, author: "Deleted author", updated_at: Time.current)
+      # A previously loaded association must not destroy the books just retained.
+      created_books.reset
+    end
+
+    def erase_sign_in_events
+      SignInEvent.where(email_address: sign_in_email_addresses).delete_all
+    end
+
+    def sign_in_email_addresses
+      addresses = [ email_address ]
+
+      unless active?
+        address = email_address
+        while address.match?(DEACTIVATED_EMAIL_SUFFIX)
+          address = address.sub(DEACTIVATED_EMAIL_SUFFIX, "")
+          addresses << address
+        end
+      end
+
+      addresses
+    end
+end
