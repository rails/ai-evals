+    def snapshot_access_list
+      # Dependent accesses are destroyed before the book, so keep their current values in memory.
+      @access_list_to_archive = accesses.includes(:user).map do |access|
+        {
           book_id: id,
           book_title: title,
           user_id: access.user_id,
           user_name: access.user.name,
           level: access.level
-        )
+        }
+      end
+    end
+
+    def archive_access_list
+      @access_list_to_archive.each do |attributes|
+        AccessArchive.create!(attributes)
       end
     end
 end
diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..482b369 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,52 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy archives every person's access and removes the book and grants" do
+    book = books(:handbook)
+    expected_accesses = book.accesses.joins(:user).order(:user_id).pluck(:user_id, "users.name", :level)
+    assert_empty AccessArchive.where(book_id: book.id)
+
+    assert_difference -> { AccessArchive.count }, 4 do
+      assert_difference -> { Book.count }, -1 do
+        delete book_path(book)
+      end
+    end
+
+    assert_redirected_to root_path
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+    assert_not Leaf.exists?(book_id: book.id)
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal expected_accesses, archives.order(:user_id).pluck(:user_id, :user_name, :level)
+    assert_equal [ book.title ], archives.distinct.pluck(:book_title)
+  end
+
+  test "destroy archives changed access levels and excludes revoked users" do
+    book = books(:handbook)
+
+    assert_no_difference -> { AccessArchive.count } do
+      patch book_path(book), params: {
+        book: { title: "Updated handbook", everyone_access: false },
+        editor_ids: [ users(:jz).id ], reader_ids: [ users(:david).id ]
+      }
+    end
+    assert_redirected_to book_slug_path(book.reload)
+
+    assert_difference -> { AccessArchive.count }, 3 do
+      delete book_path(book)
+    end
+
+    assert_redirected_to root_path
+    expected_accesses = [
+      [ users(:kevin).id, "editor" ],
+      [ users(:jz).id, "editor" ],
+      [ users(:david).id, "reader" ]
+    ].sort
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal expected_accesses, archives.order(:user_id).pluck(:user_id, :level)
+    assert_equal [ "Updated handbook" ], archives.distinct.pluck(:book_title)
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..56010aa 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,88 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroy writes access archives only after deleting the book" do
+    book = books(:manual)
+    statements = []
+    subscriber = ->(event) { statements << event.payload[:sql] }
+
+    assert_difference -> { AccessArchive.count }, 3 do
+      ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+        book.destroy!
+      end
+    end
+
+    deletion = statements.index { |sql| sql.match?(/\ADELETE FROM "books"/) }
+    archive_insert = statements.index { |sql| sql.match?(/\AINSERT INTO "access_archives"/) }
+    assert_not_nil deletion
+    assert_not_nil archive_insert
+    assert_operator deletion, :<, archive_insert
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+  end
+
+  test "destroy snapshots current accesses rather than a previously loaded access list" do
+    book = books(:manual)
+    book.accesses.load
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.update!(everyone_access: false)
+      book.update_access(editors: [ users(:kevin).id ], readers: [ users(:david).id ])
+    end
+
+    assert_difference -> { AccessArchive.count }, 2 do
+      book.destroy!
+    end
+
+    assert_equal [ [ users(:david).id, "reader" ], [ users(:kevin).id, "editor" ] ].sort,
+      AccessArchive.where(book_id: book.id).order(:user_id).pluck(:user_id, :level)
+    assert_not Access.exists?(book_id: book.id)
+  end
+
+  test "destroying a book with no accesses does not archive previously revoked access" do
+    book = books(:manual)
+    book.accesses.load
+    Access.where(book: book).delete_all
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+  end
+
+  test "destroying a book that never had accesses creates no archives" do
+    book = Book.create!(title: "Unshared book", everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+  end
+
+  test "access archives roll back with the book deletion" do
+    book = books(:manual)
+
+    assert_no_difference [ -> { Book.count }, -> { Access.count }, -> { AccessArchive.count } ] do
+      Book.transaction(requires_new: true) do
+        book.destroy!
+        assert_equal 3, AccessArchive.where(book_id: book.id).count
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+
+  test "destroying the same book again does not duplicate access archives" do
+    book = books(:manual)
+    book.destroy!
+    assert_equal 3, AccessArchive.where(book_id: book.id).count
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+  end
 end
