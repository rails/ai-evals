+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    # Keep these nullable for legacy records and tenant-less fixtures.
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |dir|
+      dir.up do
+        # Use SQL so upgrading does not invoke application callbacks or access rules.
+        execute <<~SQL
+          INSERT INTO tenants (name, created_at, updated_at)
+          VALUES ('Writebook', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
+        SQL
+        execute "UPDATE users SET tenant_id = (SELECT id FROM tenants)"
+        execute "UPDATE books SET tenant_id = (SELECT id FROM tenants)"
+      end
+    end
+  end
+end
