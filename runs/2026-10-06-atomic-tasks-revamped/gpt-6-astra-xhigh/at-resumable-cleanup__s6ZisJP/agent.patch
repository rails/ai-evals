diff --git a/app/jobs/title_cleanup_job.rb b/app/jobs/title_cleanup_job.rb
index 13721ed..1c8b12e 100644
--- a/app/jobs/title_cleanup_job.rb
+++ b/app/jobs/title_cleanup_job.rb
@@ -1,7 +1,25 @@
 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  # Resque does not support delayed retries without resque-scheduler.
+  self.resume_options = { wait: nil }
+
+  rescue_from Resque::TermException do |error|
+    retry_job(**resume_options, error: error)
+  end
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :clean_titles do |step|
+      leaf_id, original_title = step.cursor
+
+      Leaf.find_each(start: leaf_id, order: :asc) do |leaf|
+        title = leaf.id == leaf_id ? original_title : leaf.title
+
+        # Retain the original title before writing: an interrupted update may have
+        # committed, so rereading and cleaning it on resume could strip inner quotes.
+        step.set! [ leaf.id, title ]
+        leaf.update!(title: cleaned(title))
+      end
     end
   end
 
diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..c50fcb7
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,186 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  setup do
+    @leaves = Leaf.order(:id).to_a
+    @titles = [ '"Quoted opening" and ending "phrase"', '"Another quoted phrase"', 'An inner "quote" here', "" ]
+    @leaves.zip(@titles).each do |leaf, title|
+      leaf.update!(title: %Q("#{title}"))
+    end
+  end
+
+  test "removes only the exporter quotes from every leaf" do
+    TitleCleanupJob.perform_now
+
+    assert_equal @titles, Leaf.order(:id).pluck(:title)
+    assert_no_enqueued_jobs
+  end
+
+  [ ActiveJob::Continuation::Interrupt, Resque::TermException ].each do |interruption|
+    test "resumes after a committed update interrupted by #{interruption}" do
+      updated_ids = []
+      interrupted_id = @leaves.second.id
+      interrupted = false
+      callback = ->(leaf) do
+        updated_ids << leaf.id
+        if leaf.id == interrupted_id && !interrupted
+          interrupted = true
+          raise interruption, "SIGTERM"
+        end
+      end
+
+      with_leaf_callback(:commit, :after, callback) do
+        assert_enqueued_jobs 1, only: TitleCleanupJob do
+          TitleCleanupJob.perform_now
+        end
+        assert_equal @leaves.first(2).map(&:id), updated_ids
+
+        resume_enqueued_job
+      end
+
+      assert_equal @leaves.first(2).map(&:id) + @leaves.drop(1).map(&:id), updated_ids
+      assert_equal @titles, Leaf.order(:id).pluck(:title)
+      assert_no_enqueued_jobs
+    end
+  end
+
+  test "checkpoints before writing and preserves the cursor through repeated stops" do
+    updated_ids = []
+    adapter = queue_adapter
+    callback = ->(leaf) do
+      updated_ids << leaf.id
+      adapter.stopping = true
+    end
+
+    with_leaf_callback(:commit, :after, callback) do
+      TitleCleanupJob.perform_now
+    end
+
+    assert_equal [ @leaves.first.id ], updated_ids
+    assert_equal @titles.first, @leaves.first.reload.title
+    assert_equal %Q("#{@titles.second}"), @leaves.second.reload.title
+
+    2.times do
+      assert_enqueued_jobs 1, only: TitleCleanupJob
+      assert_no_changes -> { Leaf.order(:id).pluck(:title) } do
+        resume_enqueued_job
+      end
+    end
+
+    adapter.stopping = false
+    with_leaf_callback(:commit, :after, ->(leaf) { updated_ids << leaf.id }) do
+      resume_enqueued_job
+    end
+
+    assert_equal @leaves.map(&:id), updated_ids
+    assert_equal @titles, Leaf.order(:id).pluck(:title)
+    assert_no_enqueued_jobs
+  ensure
+    adapter.stopping = false
+  end
+
+  test "resumes when an interrupted update rolls back" do
+    interrupted_id = @leaves.second.id
+    callback = ->(leaf) do
+      raise ActiveJob::Continuation::Interrupt if leaf.id == interrupted_id
+    end
+
+    with_leaf_callback(:update, :before, callback) do
+      assert_enqueued_jobs 1, only: TitleCleanupJob do
+        TitleCleanupJob.perform_now
+      end
+    end
+
+    assert_equal @titles.first, @leaves.first.reload.title
+    assert_equal %Q("#{@titles.second}"), @leaves.second.reload.title
+    resume_enqueued_job
+
+    assert_equal @titles, Leaf.order(:id).pluck(:title)
+    assert_no_enqueued_jobs
+  end
+
+  test "makes forward progress even when every leaf is interrupted after committing" do
+    interrupted_ids = @leaves.map(&:id)
+    updated_ids = []
+    callback = ->(leaf) do
+      updated_ids << leaf.id
+      if leaf.id == interrupted_ids.first
+        interrupted_ids.shift
+        raise ActiveJob::Continuation::Interrupt
+      end
+    end
+
+    with_leaf_callback(:commit, :after, callback) do
+      TitleCleanupJob.perform_now
+      @leaves.size.times do
+        assert_enqueued_jobs 1, only: TitleCleanupJob
+        resume_enqueued_job
+      end
+    end
+
+    assert_empty interrupted_ids
+    assert_equal @leaves.flat_map { |leaf| [ leaf.id, leaf.id ] }, updated_ids
+    assert_equal @titles, Leaf.order(:id).pluck(:title)
+    assert_no_enqueued_jobs
+  end
+
+  test "continues with the next leaf if the cursor leaf was deleted" do
+    interrupted_id = @leaves.second.id
+    callback = ->(leaf) do
+      raise ActiveJob::Continuation::Interrupt if leaf.id == interrupted_id
+    end
+
+    with_leaf_callback(:commit, :after, callback) do
+      TitleCleanupJob.perform_now
+    end
+    @leaves.second.destroy!
+    resume_enqueued_job
+
+    assert_equal [ @titles.first, *@titles.drop(2) ], Leaf.order(:id).pluck(:title)
+    assert_no_enqueued_jobs
+  end
+
+  test "does not repeat a completed cleanup" do
+    job = TitleCleanupJob.new
+    job.perform_now
+
+    with_leaf_callback(:commit, :after, ->(_) { flunk "A completed cleanup must not update any leaf" }) do
+      ActiveJob::Base.execute JSON.parse(job.serialize.to_json)
+    end
+
+    assert_equal @titles, Leaf.order(:id).pluck(:title)
+    assert_no_enqueued_jobs
+  end
+
+  test "handles an empty collection" do
+    Leaf.destroy_all
+
+    assert_no_enqueued_jobs only: TitleCleanupJob do
+      TitleCleanupJob.perform_now
+    end
+  end
+
+  test "preserves titles without wrapper quotes and removes single boundary quotes" do
+    titles = [ "Plain title", '"Leading quote', 'Trailing quote"', 'An inner "quote" here' ]
+    @leaves.zip(titles).each { |leaf, title| leaf.update!(title: title) }
+
+    TitleCleanupJob.perform_now
+
+    assert_equal [ "Plain title", "Leading quote", "Trailing quote", 'An inner "quote" here' ], Leaf.order(:id).pluck(:title)
+  end
+
+  private
+    def with_leaf_callback(name, kind, callback)
+      Leaf.set_callback name, kind, callback
+      yield
+    ensure
+      Leaf.skip_callback name, kind, callback
+    end
+
+    def resume_enqueued_job
+      # Round-trip through the queue's JSON payload, not the original job instance.
+      job_data = enqueued_jobs.shift.select { |key, _| key.is_a?(String) }
+      assert_nil job_data["scheduled_at"], "Resque requires an immediate retry"
+      ActiveJob::Base.execute JSON.parse(job_data.to_json)
+    end
+end
