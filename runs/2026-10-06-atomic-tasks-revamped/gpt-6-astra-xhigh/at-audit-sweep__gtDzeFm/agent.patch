diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..c0f2baf 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,59 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "readers cannot update or destroy books" do
+    books(:handbook).access_for(user: users(:kevin)).update!(level: :reader)
+
+    assert_no_changes -> { books(:handbook).reload.attributes } do
+      patch book_path(books(:handbook)), params: { book: { title: "Changed" }, editor_ids: [ users(:kevin).id ] }
+    end
+    assert_response :forbidden
+    assert_not books(:handbook).editable?(user: users(:kevin))
+
+    assert_no_changes -> { [ Book.count, Leaf.count, Access.count ] } do
+      delete book_path(books(:handbook))
+    end
+    assert_response :forbidden
+    assert Book.exists?(books(:handbook).id)
+  end
+
+  test "publication does not grant permission to update or destroy books" do
+    books(:manual).update!(published: true)
+
+    assert_no_changes -> { books(:manual).reload.attributes } do
+      patch book_path(books(:manual)), params: { book: { title: "Changed" }, editor_ids: [ users(:kevin).id ] }
+    end
+    assert_response :forbidden
+    assert_not books(:manual).editable?(user: users(:kevin))
+
+    assert_no_changes -> { [ Book.count, Leaf.count, Access.count ] } do
+      delete book_path(books(:manual))
+    end
+    assert_response :forbidden
+    assert Book.exists?(books(:manual).id)
+  end
+
+  test "editors can still update and destroy books" do
+    patch book_path(books(:handbook)), params: { book: { title: "Changed" } }
+
+    assert_redirected_to book_slug_path(books(:handbook).reload)
+    assert_equal "Changed", books(:handbook).title
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+    assert_redirected_to root_path
+    assert_not Book.exists?(books(:handbook).id)
+  end
+
+  test "administrators can destroy books without editor access" do
+    sign_in :david
+    books(:handbook).access_for(user: users(:david)).update!(level: :reader)
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+    assert_redirected_to root_path
+  end
 end
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..8d38b8b 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,84 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "private pages cannot be read through a different book by members or guests" do
+    leaf = leaves(:summary_page)
+    leaf.update!(book: books(:manual))
+    private_content = "Private page #{SecureRandom.hex(8)}"
+    leaf.page.update!(body: private_content)
+    books(:handbook).update!(published: true)
+
+    [ :member, :guest ].each do |reader|
+      sign_out if reader == :guest
+
+      [ books(:handbook), books(:manual) ].each do |book|
+        [ :html, :md ].each do |format|
+          page_paths(book, leaf, format: format).each do |path|
+            get path
+
+            assert_response :not_found
+            assert_not_in_body private_content
+          end
+        end
+      end
+    end
+  end
+
+  test "readable pages remain available through nested and slugged routes" do
+    books(:handbook).access_for(user: users(:kevin)).update!(level: :reader)
+
+    [ :member, :guest ].each do |reader|
+      if reader == :guest
+        books(:handbook).update!(published: true)
+        sign_out
+      end
+
+      [ :html, :md ].each do |format|
+        page_paths(books(:handbook), leaves(:welcome_page), format: format).each do |path|
+          get path
+
+          assert_response :success
+          assert_in_body "a great handbook."
+        end
+      end
+    end
+  end
+
+  test "a different book cannot be used to edit or delete a private page" do
+    leaf = leaves(:summary_page)
+    leaf.update!(book: books(:manual))
+    path = book_page_path(books(:handbook), leaf)
+
+    get edit_book_page_path(books(:handbook), leaf)
+    assert_response :not_found
+
+    assert_no_changes -> { [ leaf.reload.attributes, leaf.page.body.content ] } do
+      patch path, params: { leaf: { title: "Changed" }, page: { body: "Changed" } }
+    end
+    assert_response :not_found
+
+    assert_no_changes -> { leaf.reload.status } do
+      delete path
+    end
+    assert_response :not_found
+  end
+
+  test "trashed pages remain unreadable in their own book" do
+    leaf = leaves(:summary_page)
+    leaf.trashed!
+
+    page_paths(leaf.book, leaf, format: :html).each do |path|
+      get path
+      assert_response :not_found
+    end
+  end
+
+  private
+    def page_paths(book, leaf, format:)
+      [
+        book_page_path(book, leaf, format: format),
+        slugged_leafable_path(book_id: book.id, book_slug: book.slug, id: leaf.id, slug: leaf.slug, format: format)
+      ]
+    end
 end
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..fbd22ac
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    leaves(:summary_page).update!(book: books(:manual), title: "Welcome to the private manual")
+  end
+
+  test "ordinary searches find readable titles in book and page order" do
+    get library_search_path, params: { q: " wELCome " }
+
+    assert_response :success
+    assert_search_results leaves(:welcome_section), leaves(:welcome_page)
+  end
+
+  test "readers can search their books" do
+    sign_in :jz
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_search_results leaves(:welcome_section), leaves(:welcome_page), leaves(:summary_page)
+  end
+
+  test "published books are searchable without an explicit grant" do
+    books(:manual).update!(published: true)
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_search_results leaves(:welcome_section), leaves(:welcome_page), leaves(:summary_page)
+  end
+
+  test "guests can search only published books" do
+    sign_out
+
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_search_results
+
+    books(:handbook).update!(published: true)
+
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_search_results leaves(:welcome_section), leaves(:welcome_page)
+  end
+
+  test "blank and missing queries return no results" do
+    [ nil, "", "   " ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_search_results
+    end
+  end
+
+  test "trashed pages are not searched" do
+    leaves(:welcome_page).trashed!
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_search_results leaves(:welcome_section)
+  end
+
+  test "SQL syntax in a query is matched literally within readable books" do
+    [ "' OR 1=1 OR 'a'='", "' OR 1=1 --", "') OR 1=1 --", "' OR '1'='1" ].each do |query|
+      leaves(:welcome_page).update!(title: query)
+      leaves(:summary_page).update!(title: query)
+
+      get library_search_path, params: { q: query }
+
+      assert_response :success
+      assert_search_results leaves(:welcome_page)
+    end
+  end
+
+  test "SQL syntax cannot expose private pages to guests with no readable books" do
+    sign_out
+
+    get library_search_path, params: { q: "' OR 1=1 OR 'a'='" }
+
+    assert_response :success
+    assert_search_results
+  end
+
+  {
+    "apostrophes" => [ "Reader's guide", "'" ],
+    "percent signs" => [ "Save 50% off", "%" ],
+    "underscores" => [ "under_score", "_" ],
+    "backslashes" => [ 'C:\\book', "\\" ],
+    "escape characters" => [ "Look!", "!" ],
+    "escaped wildcards" => [ "Save !% off", "!%" ],
+    "escaped underscores" => [ "under!_score", "!_" ]
+  }.each do |name, (title, punctuation)|
+    test "search treats #{name} as literal text" do
+      leaves(:welcome_page).update!(title: title)
+      leaves(:summary_page).update!(title: title)
+      leaves(:welcome_section).update!(title: title.gsub(punctuation, "X"))
+
+      [ title, punctuation ].each do |query|
+        get library_search_path, params: { q: query }
+
+        assert_response :success
+        assert_search_results leaves(:welcome_page)
+      end
+    end
+  end
+
+  private
+    def assert_search_results(*leaves)
+      assert_equal leaves.map { |leaf| leafable_slug_path(leaf) },
+        css_select("a.search__result").map { |link| link["href"] }
+    end
+end
