     assert_response :forbidden
     assert_equal "Kevin", users(:kevin).reload.name
   end
+
+  test "members can update profile fields but cannot change their role" do
+    sign_in :kevin
+
+    assert_no_changes -> { User.order(:id).pluck(:role) } do
+      patch user_profile_path(users(:kevin)), params: { user: {
+        name: "Updated Kevin", email_address: "updated@example.com", password: "new-password", role: "administrator"
+      } }
+    end
+
+    assert_redirected_to users_path
+    assert_equal "Updated Kevin", users(:kevin).reload.name
+    assert_equal "updated@example.com", users(:kevin).email_address
+    assert users(:kevin).authenticate("new-password")
+  end
+
+  test "members cannot change other users profiles or roles" do
+    sign_in :kevin
+
+    [ users(:jz), users(:david) ].each do |user|
+      assert_no_changes -> { user.reload.attributes } do
+        patch user_profile_path(user), params: { user: { name: "Changed", role: "administrator" } }
+      end
+
+      assert_response :forbidden
+    end
+  end
+
+  test "administrators can still update their own profile fields" do
+    sign_in :david
+
+    patch user_profile_path(users(:david)), params: { user: {
+      name: "Updated David", email_address: "updated@example.com", password: "new-password"
+    } }
+
+    assert_redirected_to users_path
+    assert_equal "Updated David", users(:david).reload.name
+    assert_equal "updated@example.com", users(:david).email_address
+    assert users(:david).authenticate("new-password")
+    assert users(:david).administrator?
+  end
 end
