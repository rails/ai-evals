     # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
     config.log_level = ENV.fetch("LOG_LEVEL", "debug")
 
+    runner do |app|
+      # Keep a file record even in environments that normally log only to STDOUT.
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, app.config.paths["log"].first)
+        file_logger = ActiveSupport::Logger.new(app.config.default_log_file)
+        file_logger.formatter = app.config.log_formatter
+        Rails.logger.broadcast_to(ActiveSupport::TaggedLogging.new(file_logger))
+      end
+
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout)
+        Rails.logger.broadcast_to(ActiveSupport::Logger.new($stdout))
+      end
+
+      # Runner reports must reach both destinations, even when LOG_LEVEL is raised.
+      # INFO also keeps SQL debug logging out of the terminal report.
+      Rails.logger.level = ActiveSupport::Logger::INFO
+    end
