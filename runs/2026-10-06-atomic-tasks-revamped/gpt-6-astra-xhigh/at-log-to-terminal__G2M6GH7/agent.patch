@@ -0,0 +1,130 @@
+require "test_helper"
+require "tmpdir"
+require "open3"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  setup do
+    @directory = Dir.mktmpdir("library-report")
+    @log_path = File.join(@directory, "runner.log")
+    @original_log_paths = Rails.application.config.paths["log"].to_a
+    @original_logger, @original_stdout = Rails.logger, $stdout
+
+    Rails.application.config.paths["log"] = @log_path
+    @file_logger = ActiveSupport::TaggedLogging.new(ActiveSupport::Logger.new(@log_path))
+    Rails.logger = ActiveSupport::BroadcastLogger.new(@file_logger)
+    $stdout = StringIO.new
+  end
+
+  teardown do
+    Rails.logger.close
+    Rails.logger, $stdout = @original_logger, @original_stdout
+    Rails.application.config.paths["log"] = @original_log_paths
+    FileUtils.remove_entry(@directory)
+  end
+
+  %w[ debug info warn error fatal ].each do |level|
+    test "runner reports to the terminal and existing file logger with #{level} logging" do
+      @file_logger.level = level
+
+      Rails.application.load_runner
+
+      assert_same @file_logger, Rails.logger.broadcasts.first
+      assert_report expected_report
+    end
+  end
+
+  test "runner does not add duplicate destinations when loaded again" do
+    2.times { Rails.application.load_runner }
+
+    assert_equal 2, Rails.logger.broadcasts.size
+    assert_report expected_report
+  end
+
+  test "runner reuses an existing stdout logger" do
+    Rails.logger.broadcast_to(ActiveSupport::Logger.new($stdout, level: :error))
+
+    Rails.application.load_runner
+
+    assert_equal 2, Rails.logger.broadcasts.size
+    assert_report expected_report
+  end
+
+  test "runner adds an environment log file when only stdout is configured" do
+    @file_logger.close
+    Rails.logger = ActiveSupport::BroadcastLogger.new(ActiveSupport::Logger.new($stdout))
+
+    Rails.application.load_runner
+
+    assert_equal 2, Rails.logger.broadcasts.size
+    assert_report expected_report
+  end
+
+  test "report preserves singular and plural page wording" do
+    leaves(:welcome_page).update!(book: books(:manual))
+
+    Rails.application.load_runner
+
+    assert_report expected_report(handbook_pages: 3, manual_pages: 1)
+  end
+
+  test "report handles an empty library" do
+    ActiveRecord::Base.connection.disable_referential_integrity { Book.delete_all }
+
+    Rails.application.load_runner
+
+    assert_report [ "INFO: Library report: 0 books", "INFO: Library report: done" ]
+  end
+
+  test "the exact runbook command reports an empty library to stdout and development log" do
+    database_path = File.join(@directory, "library.sqlite3")
+    database = SQLite3::Database.new(database_path)
+    %w[ books leaves ].each do |table|
+      database.execute ActiveRecord::Base.connection.select_value("SELECT sql FROM sqlite_master WHERE name = '#{table}' AND type = 'table'")
+    end
+    database.close
+
+    log_path = Rails.root.join("log/development.log")
+    offset = File.size?(log_path) || 0
+    stdout, stderr, status = Open3.capture3(
+      { "DATABASE_URL" => "sqlite3:#{database_path}", "LOG_LEVEL" => "error" },
+      "bin/rails", "runner", "-e", "development", "script/library_report.rb", chdir: Rails.root
+    )
+
+    assert status.success?, stderr
+    expected = [ "Library report: 0 books", "Library report: done" ]
+    assert_equal expected, stdout.lines(chomp: true)
+    recorded = File.binread(log_path, File.size(log_path) - offset, offset)
+    assert_equal expected, recorded.lines(chomp: true).grep(/^Library report:/)
+  end
+
+  test "ordinary application boot leaves the configured logging unchanged" do
+    stdout, stderr, status = Open3.capture3(
+      { "RAILS_ENV" => "test", "LOG_LEVEL" => "error" },
+      RbConfig.ruby, "-r", "./config/environment", "-e", <<~RUBY_CODE, chdir: Rails.root
+        puts Rails.logger.level
+        puts ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout)
+      RUBY_CODE
+    )
+
+    assert status.success?, stderr
+    assert_equal "#{ActiveSupport::Logger::ERROR}\nfalse\n", stdout
+  end
+
+  private
+    def expected_report(handbook_pages: 4, manual_pages: 0)
+      entries = {
+        books(:handbook).id => "INFO: Library report: Handbook has #{handbook_pages} pages",
+        books(:manual).id => manual_pages.zero? ? "WARN: Library report: Manual has no pages" : "INFO: Library report: Manual has 1 page"
+      }
+      [ "INFO: Library report: 2 books", *entries.sort.map(&:last), "INFO: Library report: done" ]
+    end
+
+    def assert_report(expected)
+      Rails.logger.formatter = ->(severity, time, progname, message) { "#{severity}: #{message}\n" }
+
+      load Rails.root.join("script/library_report.rb")
+
+      assert_equal expected, $stdout.string.lines(chomp: true)
+      assert_equal expected, File.readlines(@log_path, chomp: true).grep(/^\w+: Library report:/)
+    end
+end
