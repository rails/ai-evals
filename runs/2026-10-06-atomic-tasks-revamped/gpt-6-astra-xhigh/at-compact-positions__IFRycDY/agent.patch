index 0000000..eab5217
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "compaction preserves positioned order rather than id order and is idempotent" do
+    ordered_leaves = @book.leaves.order(id: :desc).to_a
+    ordered_leaves.zip([ -12.5, 0.25, 9.75, 42 ]).each do |leaf, score|
+      leaf.update_columns(position_score: score)
+    end
+    expected_ids = ordered_leaves.map(&:id)
+
+    2.times do
+      @book.compact_positions!
+
+      assert_equal expected_ids, @book.leaves.positioned.ids
+      assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    end
+  end
+
+  test "compaction breaks score ties by id" do
+    by_id = @book.leaves.order(:id).to_a
+    by_id.zip([ 40.5, -10, -10, 9 ]).each do |leaf, score|
+      leaf.update_columns(position_score: score)
+    end
+
+    @book.compact_positions!
+
+    assert_equal [ by_id[1], by_id[2], by_id[3], by_id[0] ].map(&:id), @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compaction includes trashed leaves so restoring preserves their place" do
+    ordered_leaves = [ leaves(:reading_picture), leaves(:welcome_page), leaves(:welcome_section), leaves(:summary_page) ]
+    ordered_leaves.each.with_index(1) { |leaf, index| leaf.update_columns(position_score: index * 50) }
+    restored_leaf = leaves(:welcome_page)
+    restored_leaf.trashed!
+    expected_ids = ordered_leaves.map(&:id)
+
+    @book.compact_positions!
+
+    assert_equal expected_ids, @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    assert restored_leaf.reload.trashed?
+    assert_equal 3, @book.live_leaf_count
+
+    restored_leaf.active!
+
+    assert_equal expected_ids, @book.leaves.active.positioned.ids
+    assert_equal 4, @book.live_leaf_count
+  end
+
+  test "compaction is scoped to the book" do
+    other_leaf = leaves(:reading_picture)
+    other_leaf.update!(book: books(:manual), position_score: -123.5)
+    expected_ids = @book.leaves.positioned.ids
+
+    assert_no_changes -> { other_leaf.reload.attributes } do
+      @book.compact_positions!
+    end
+
+    assert_equal expected_ids, @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compaction handles a book with only trashed leaves" do
+    @book.leaves.update_all(status: :trashed)
+    expected_ids = @book.leaves.positioned.ids
+
+    @book.compact_positions!
+
+    assert_equal expected_ids, @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    assert_equal 0, @book.live_leaf_count
+  end
+
+  test "compaction handles empty and single leaf books" do
+    book = books(:manual)
+
+    book.compact_positions!
+
+    assert_empty book.leaves
+    assert_equal 0, book.live_leaf_count
+
+    leaf = leaves(:welcome_page)
+    leaf.update!(book: book, position_score: 73.5)
+    book.compact_positions!
+
+    assert_equal 1, leaf.reload.position_score
+    assert_equal 1, book.live_leaf_count
+  end
+
+  test "live leaf count excludes trash and other books" do
+    assert_equal 4, @book.live_leaf_count
+    assert_equal 0, books(:manual).live_leaf_count
+
+    leaves(:summary_page).trashed!
+    leaves(:reading_picture).update!(book: books(:manual))
+
+    assert_equal 2, @book.live_leaf_count
+    assert_equal 1, books(:manual).live_leaf_count
+
+    @book.leaves.update_all(status: :trashed)
+
+    assert_equal 0, @book.live_leaf_count
+    assert_equal 1, books(:manual).live_leaf_count
+  end
+
+  test "SQLite rejects misspelled double quoted identifiers" do
+    assert_raises ActiveRecord::StatementInvalid do
+      Book.connection.select_value('SELECT "position_socre" FROM leaves LIMIT 1')
+    end
+  end
+end
