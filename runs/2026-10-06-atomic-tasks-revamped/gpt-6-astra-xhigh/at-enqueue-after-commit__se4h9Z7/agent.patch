diff --git a/test/controllers/books/imports_controller_test.rb b/test/controllers/books/imports_controller_test.rb
new file mode 100644
index 0000000..b215525
--- /dev/null
+++ b/test/controllers/books/imports_controller_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Books::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  # The import must really commit or roll back for enqueue timing to be tested.
+  self.use_transactional_tests = false
+
+  EDIT_JOBS = [ Book::CoverProcessingJob, Book::SearchIndexJob ]
+
+  setup do
+    sign_in :jason
+    @books = [ books(:handbook), books(:manual) ]
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    @books.each do |book|
+      book.reload.cover.blob&.then { |blob| blob.service.delete(blob.key) }
+    end
+    Rails.cache = @original_cache
+  end
+
+  test "a successful batch commits before its jobs run" do
+    perform_enqueued_jobs(only: EDIT_JOBS) do
+      post books_import_path, params: { books: @books.to_h { |book| [ book.id, cover_edit(book) ] } }
+    end
+
+    assert_redirected_to root_path
+    assert_performed_jobs 2, only: Book::CoverProcessingJob
+    assert_performed_jobs 2, only: Book::SearchIndexJob
+    assert_no_enqueued_jobs only: Books::ImportFailureJob
+
+    @books.each do |book|
+      book.reload
+      assert_equal Digest::SHA256.hexdigest(file_fixture("reading.webp").binread), book.cover.blob.metadata["sha256"]
+      assert_equal book.title, Rails.cache.read("search_index/book/#{book.id}")
+    end
+  end
+
+  test "a failed batch discards edit jobs but still notifies the operator" do
+    book = books(:handbook)
+
+    assert_no_difference "ActiveStorage::Blob.count" do
+      post books_import_path, params: { books: {
+        book.id => cover_edit(book),
+        0 => { title: "Missing book" }
+      } }
+    end
+
+    assert_response :not_found
+    assert_equal "Handbook", book.reload.title
+    assert_not book.cover.attached?
+    assert_no_enqueued_jobs only: EDIT_JOBS
+    assert_enqueued_jobs 1, only: Books::ImportFailureJob
+    failure_job = assert_enqueued_with(job: Books::ImportFailureJob, args: ->(args) {
+      args.first == users(:jason).id && args.last.include?("Couldn't find Book")
+    })
+
+    perform_enqueued_jobs only: Books::ImportFailureJob
+
+    assert_equal failure_job.arguments.last, Rails.cache.read("import_failure/#{users(:jason).id}")
+  end
+
+  private
+    def cover_edit(book)
+      { title: "Revised #{book.title}", cover: fixture_file_upload("reading.webp", "image/webp") }
+    end
+end
diff --git a/test/models/book/editing_test.rb b/test/models/book/editing_test.rb
new file mode 100644
index 0000000..4c06be7
--- /dev/null
+++ b/test/models/book/editing_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Book::EditingTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  # Exercise real commits instead of the test fixture transaction.
+  self.use_transactional_tests = false
+
+  EDIT_JOBS = [ Book::CoverProcessingJob, Book::SearchIndexJob ]
+
+  setup do
+    @book = books(:handbook)
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    @book.reload.cover.blob&.then { |blob| blob.service.delete(blob.key) }
+    Rails.cache = @original_cache
+  end
+
+  test "edit jobs can run as soon as they are handed off" do
+    perform_enqueued_jobs(only: EDIT_JOBS) do
+      apply_cover_edit
+    end
+
+    assert_performed_jobs 1, only: Book::CoverProcessingJob
+    assert_performed_jobs 1, only: Book::SearchIndexJob
+    assert_equal Digest::SHA256.hexdigest(file_fixture("reading.webp").binread), @book.reload.cover.blob.metadata["sha256"]
+    assert_equal "Revised handbook", Rails.cache.read("search_index/book/#{@book.id}")
+  end
+
+  test "edit jobs wait for the surrounding transaction to commit" do
+    freeze_time do
+      Book.transaction do
+        apply_cover_edit
+        assert_no_enqueued_jobs only: EDIT_JOBS
+      end
+
+      assert_enqueued_jobs 2, only: EDIT_JOBS
+      assert_enqueued_with job: Book::SearchIndexJob, args: [ @book ]
+      assert_enqueued_with job: Book::CoverProcessingJob, args: [ @book ], at: 5.seconds.from_now
+    end
+  end
+
+  test "rolling back an edit discards its jobs" do
+    assert_no_difference "ActiveStorage::Blob.count" do
+      Book.transaction do
+        apply_cover_edit
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_no_enqueued_jobs only: EDIT_JOBS
+    assert_equal "Handbook", @book.reload.title
+    assert_not @book.cover.attached?
+  end
+
+  test "releasing a savepoint does not hand off edit jobs before the outer commit" do
+    Book.transaction do
+      Book.transaction(requires_new: true) do
+        apply_cover_edit
+        assert_no_enqueued_jobs only: EDIT_JOBS
+      end
+
+      assert_no_enqueued_jobs only: EDIT_JOBS
+    end
+
+    assert_enqueued_jobs 1, only: Book::CoverProcessingJob
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+  end
+
+  test "outer rollback discards edit jobs from a released savepoint" do
+    Book.transaction do
+      Book.transaction(requires_new: true) { apply_cover_edit }
+      raise ActiveRecord::Rollback
+    end
+
+    assert_no_enqueued_jobs only: EDIT_JOBS
+    assert_equal "Handbook", @book.reload.title
+    assert_not @book.cover.attached?
+  end
+
+  test "savepoint rollback discards edit jobs even if the outer transaction commits" do
+    Book.transaction do
+      Book.transaction(requires_new: true) do
+        apply_cover_edit
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_no_enqueued_jobs only: EDIT_JOBS
+    assert_equal "Handbook", @book.reload.title
+    assert_not @book.cover.attached?
+  end
+
+  test "an edit without a cover only refreshes the search entry" do
+    @book.apply_edit(title: "Revised handbook")
+
+    assert_enqueued_with job: Book::SearchIndexJob, args: [ @book ]
+    assert_no_enqueued_jobs only: Book::CoverProcessingJob
+  end
+
+  private
+    def apply_cover_edit
+      @book.apply_edit(title: "Revised handbook", cover: {
+        io: StringIO.new(file_fixture("reading.webp").binread),
+        filename: "reading.webp", content_type: "image/webp"
+      })
+    end
+end
