diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..9313cbe 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,104 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "private pages cannot be read through a different readable book" do
+    leaf = leaves(:summary_page)
+    leaf.update!(book: books(:manual))
+
+    [ :html, :md ].each do |format|
+      page_paths(books(:handbook), leaf, format: format).each do |path|
+        get path
+        assert_response :not_found
+      end
+
+      get leafable_slug_path(leaf, format: format)
+      assert_response :not_found
+    end
+  end
+
+  test "signed out users cannot read private pages through a published book" do
+    leaf = leaves(:summary_page)
+    leaf.update!(book: books(:manual))
+    books(:handbook).update!(published: true)
+    sign_out
+
+    [ :html, :md ].each do |format|
+      page_paths(books(:handbook), leaf, format: format).each do |path|
+        get path
+        assert_response :not_found
+      end
+    end
+  end
+
+  test "readable pages still require their own book id" do
+    books(:manual).update!(published: true)
+
+    page_paths(books(:manual), leaves(:welcome_page)).each do |path|
+      get path
+      assert_response :not_found
+    end
+  end
+
+  test "readers and signed out users can read pages of readable books in both formats" do
+    sign_in :jz
+    leaf = leaves(:welcome_page)
+    pages(:welcome).update!(body: "Readable page body.")
+
+    [ :html, :md ].each do |format|
+      page_paths(leaf.book, leaf, format: format).each do |path|
+        get path
+        assert_response :success
+        assert_in_body "Readable page body."
+      end
+    end
+
+    books(:handbook).update!(published: true)
+    sign_out
+
+    [ :html, :md ].each do |format|
+      page_paths(leaf.book, leaf, format: format).each do |path|
+        get path
+        assert_response :success
+        assert_in_body "Readable page body."
+      end
+    end
+  end
+
+  test "trashed pages remain unreadable" do
+    leaf = leaves(:welcome_page)
+    leaf.trashed!
+
+    page_paths(leaf.book, leaf).each do |path|
+      get path
+      assert_response :not_found
+    end
+  end
+
+  test "editing one book does not allow modifying pages of another book" do
+    leaf = leaves(:summary_page)
+    leaf.update!(book: books(:manual))
+    path = book_page_path(books(:handbook), leaf)
+
+    get edit_book_page_path(books(:handbook), leaf)
+    assert_response :not_found
+
+    assert_no_changes -> { leaf.reload.attributes } do
+      patch path, params: { leaf: { title: "Changed" } }
+    end
+    assert_response :not_found
+
+    assert_no_changes -> { leaf.reload.status } do
+      delete path
+    end
+    assert_response :not_found
+  end
+
+  private
+    def page_paths(book, leaf, format: :html)
+      [
+        slugged_leafable_path(book, book.slug, leaf, leaf.slug, format: format),
+        book_page_path(book, leaf, format: format)
+      ]
+    end
 end
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..6cad507
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    leaves(:summary_page).update!(book: books(:manual), title: "Private Handbook Summary")
+  end
+
+  test "search preserves case insensitive title substrings and ignores surrounding whitespace" do
+    get library_search_path, params: { q: "  hAnDbOoK  " }
+
+    assert_search_results leaves(:welcome_page)
+  end
+
+  test "search includes books the member may read but not edit" do
+    sign_in :jz
+
+    get library_search_path, params: { q: "handbook" }
+
+    assert_search_results leaves(:welcome_page), leaves(:summary_page)
+  end
+
+  test "search includes published books without explicit access" do
+    books(:manual).update!(published: true)
+
+    get library_search_path, params: { q: "Handbook" }
+
+    assert_search_results leaves(:welcome_page), leaves(:summary_page)
+  end
+
+  test "signed out search only includes published books" do
+    books(:manual).update!(published: true)
+    sign_out
+
+    get library_search_path, params: { q: "Handbook" }
+
+    assert_search_results leaves(:summary_page)
+  end
+
+  test "search does not include trashed pages" do
+    leaves(:welcome_page).trashed!
+
+    get library_search_path, params: { q: "Handbook" }
+
+    assert_search_results
+  end
+
+  test "empty and blank queries return no results" do
+    [ nil, "", "   " ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_search_results
+    end
+  end
+
+  test "apostrophes are searchable as data" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: "Editor's guide")
+
+    [ "Editor's guide", "'" ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_search_results leaf
+    end
+  end
+
+  test "SQL syntax is literal search text and cannot bypass book access" do
+    leaf = leaves(:welcome_page)
+    [ "' OR 1=1 OR leaves.title LIKE '", "' OR 1=1 --" ].each do |query|
+      leaf.update!(title: "An #{query} example")
+
+      get library_search_path, params: { q: query }
+
+      assert_search_results leaf
+      assert_not_in_body "Private Handbook Summary"
+    end
+  end
+
+  test "SQL syntax cannot expose pages when no books are readable" do
+    sign_out
+
+    [ "Handbook", "' OR 1=1 OR leaves.title LIKE '", "' OR 1=1 --", "%' OR 1=1 --" ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_search_results
+      assert_not_in_body "Private Handbook Summary"
+    end
+  end
+
+  test "percent signs are literal and remain searchable alone or in a title" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: "Save 50% off")
+    leaves(:welcome_section).update!(title: "Save 50 dollars off")
+
+    [ "Save 50% off", "%" ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_search_results leaf
+    end
+  end
+
+  test "underscores are literal and remain searchable alone or in a title" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: "release_notes")
+    leaves(:welcome_section).update!(title: "release notes")
+
+    [ "release_notes", "_" ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_search_results leaf
+    end
+  end
+
+  test "escape characters and adjacent wildcards are literal" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: 'Save! 50%_off\\today')
+    leaves(:welcome_section).update!(title: "Save! 500 off today")
+
+    [ 'Save! 50%_off\\today', "! 50%_", "%_", "\\", '\\today' ].each do |query|
+      get library_search_path, params: { q: query }
+
+      assert_search_results leaf
+    end
+
+    get library_search_path, params: { q: "!" }
+    assert_search_results leaves(:welcome_section), leaf
+  end
+
+  private
+    def assert_search_results(*leaves)
+      assert_response :success
+      assert_equal leaves.map { |leaf| leafable_slug_path(leaf) },
+        css_select("a.search__result").map { |link| link["href"] }
+    end
+end
