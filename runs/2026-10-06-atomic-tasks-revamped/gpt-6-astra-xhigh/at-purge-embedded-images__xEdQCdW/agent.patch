diff --git a/test/models/page_test.rb b/test/models/page_test.rb
index b4bb79b..7f1d0df 100644
--- a/test/models/page_test.rb
+++ b/test/models/page_test.rb
@@ -1,6 +1,90 @@
 require "test_helper"
 
 class PageTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges its embedded image" do
+    page = pages(:welcome)
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = page.body.uploads.last
+    blob = attachment.blob
+    markdown_id = page.body.id
+    page.update! body: "![Reading](#{attachment.slug_path})"
+
+    assert blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActionText::Markdown.exists?(markdown_id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  ensure
+    blob&.purge
+  end
+
+  test "destroying a page purges all of its uploads" do
+    page = pages(:welcome)
+    %w[ reading.webp white-rabbit.webp ].each do |filename|
+      page.body.uploads.attach io: file_fixture(filename).open, filename: filename, content_type: "image/webp"
+    end
+    blobs = page.body.uploads.blobs.to_a
+    page.update! body: page.body.uploads.map { |upload| "![Image](#{upload.slug_path})" }.join("\n\n")
+
+    blobs.each { |blob| assert blob.service.exist?(blob.key) }
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    blobs.each do |blob|
+      assert_not ActiveStorage::Attachment.exists?(blob_id: blob.id)
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+  ensure
+    blobs&.each(&:purge)
+  end
+
+  test "destroying a page without uploads" do
+    page = pages(:welcome)
+    markdown_id = page.body.id
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert page.destroyed?
+    assert_not ActionText::Markdown.exists?(markdown_id)
+  end
+
+  test "shared uploads are only purged after the last page is destroyed" do
+    page = pages(:welcome)
+    other_page = pages(:summary)
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    blob = page.body.uploads.last.blob
+    other_page.body.uploads.attach blob
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert blob.service.exist?(blob.key)
+    assert_equal blob, other_page.body.uploads.reload.last.blob
+
+    perform_enqueued_jobs do
+      other_page.destroy!
+    end
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  ensure
+    blob&.purge
+  end
+
   test "html preview" do
