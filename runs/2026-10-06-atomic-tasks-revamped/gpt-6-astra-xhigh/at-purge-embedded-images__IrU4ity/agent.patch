diff --git a/test/models/page_test.rb b/test/models/page_test.rb
index b4bb79b..02013bf 100644
--- a/test/models/page_test.rb
+++ b/test/models/page_test.rb
@@ -1,6 +1,66 @@
 require "test_helper"
 
 class PageTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges its embedded image" do
+    page = pages(:welcome)
+    markdown = page.body
+    markdown.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = markdown.uploads.last
+    blob = attachment.blob
+    page.update! body: "![Reading](#{attachment.slug_path})"
+
+    assert blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs do
+      page.reload.destroy!
+    end
+
+    assert_not ActionText::Markdown.exists?(markdown.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+
+  test "destroying a page purges all its uploads without affecting another page" do
+    page = pages(:welcome)
+    other_page = pages(:summary)
+
+    %w[ reading.webp white-rabbit.webp ].each do |filename|
+      page.body.uploads.attach io: file_fixture(filename).open, filename: filename, content_type: "image/webp"
+    end
+    page.update! body: page.body.uploads.map { |upload| "![Image](#{upload.slug_path})" }.join("\n")
+    blobs = page.body.uploads.map(&:blob)
+
+    other_page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    other_attachment = other_page.body.uploads.last
+    other_blob = other_attachment.blob
+
+    perform_enqueued_jobs do
+      page.reload.destroy!
+    end
+
+    blobs.each do |blob|
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+    assert ActiveStorage::Attachment.exists?(other_attachment.id)
+    assert ActiveStorage::Blob.exists?(other_blob.id)
+    assert other_blob.service.exist?(other_blob.key)
+  end
+
+  test "destroying a page without uploads destroys its markdown" do
+    page = pages(:welcome)
+    markdown = page.body
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActionText::Markdown.exists?(markdown.id)
+  end
+
   test "html preview" do
     page = Page.new(body: "# Hello\n\nWorld!")
 
