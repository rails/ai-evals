+require "test_helper"
+require "open3"
+require "tmpdir"
+
+class LibraryReportTest < ActiveSupport::TestCase
+  test "runner reports to both the terminal and the environment log" do
+    Dir.mktmpdir("library-report") do |directory|
+      environment = { "DATABASE_URL" => "sqlite3:#{directory}/library.sqlite3", "LOG_LEVEL" => nil }
+
+      run_runner environment, "-", stdin_data: <<~RUBY
+        ActiveRecord::Schema.verbose = false
+        load Rails.root.join("db/schema.rb")
+      RUBY
+
+      assert_report environment, [ "Library report: 0 books", "Library report: done" ]
+
+      run_runner environment, "-", stdin_data: <<~RUBY
+        ActiveRecord::FixtureSet.create_fixtures(Rails.root.join("test/fixtures"), %w[books leaves])
+      RUBY
+
+      book_lines = {
+        books(:manual).id => "Library report: Manual has no pages",
+        books(:handbook).id => "Library report: Handbook has 4 pages"
+      }
+      expected = [ "Library report: 2 books", *book_lines.sort.map(&:last), "Library report: done" ]
+
+      [ nil, "warn", "error" ].each do |level|
+        assert_report environment.merge("LOG_LEVEL" => level), expected
+      end
+
+      run_runner environment, "-", stdin_data: <<~RUBY
+        Leaf.where.not(id: #{leaves(:welcome_page).id}).delete_all
+      RUBY
+      assert_report environment, expected.map { |line| line.sub("4 pages", "1 page") }
+    end
+  end
+
+  test "runner preserves an existing stdout logger and adds the file without duplicates" do
+    original_logger = Rails.logger
+    original_log_path = Rails.application.config.paths["log"].first
+
+    Dir.mktmpdir("runner-logging") do |directory|
+      log_path = File.join(directory, "runner.log")
+      Rails.application.config.paths["log"] = log_path
+      file_logger = nil
+
+      stdout, = capture_io do
+        formatter = proc { |severity, time, progname, message| "#{severity}: #{message}\n" }
+        terminal_logger = ActiveSupport::Logger.new($stdout, level: :error, formatter: formatter)
+        logger = Rails.logger = ActiveSupport::BroadcastLogger.new(terminal_logger)
+
+        Rails.application.load_runner
+        assert_same logger, Rails.logger
+        assert_equal Logger::INFO, terminal_logger.level
+        assert_includes logger.broadcasts, terminal_logger
+
+        # An existing DEBUG sink must not hide a restrictive file sink's threshold.
+        terminal_logger.level = :debug
+        file_logger = logger.broadcasts.find { |sink| sink != terminal_logger }
+        file_logger.level = :error
+        Rails.application.load_runner
+        Rails.application.load_runner
+
+        assert_equal 2, logger.broadcasts.size
+        assert_equal Logger::DEBUG, terminal_logger.level
+        assert_equal Logger::INFO, file_logger.level
+
+        load Rails.root.join("script/library_report.rb")
+      end
+
+      book_lines = {
+        books(:manual).id => "WARN: Library report: Manual has no pages",
+        books(:handbook).id => "INFO: Library report: Handbook has 4 pages"
+      }
+      expected = [ "INFO: Library report: 2 books", *book_lines.sort.map(&:last), "INFO: Library report: done" ]
+      assert_equal expected, stdout.lines.map(&:chomp)
+      assert_equal stdout, File.read(log_path)
+    ensure
+      file_logger&.close
+    end
+  ensure
+    Rails.logger = original_logger
+    Rails.application.config.paths["log"] = original_log_path
+  end
+
+  test "ordinary application boot keeps its logging destinations and threshold" do
+    stdout, stderr, status = Open3.capture3({ "RAILS_ENV" => "development", "LOG_LEVEL" => "error" },
+      RbConfig.ruby, "-r", "./config/environment", "-e", <<~RUBY, chdir: Rails.root)
+        puts Rails.logger.level
+        puts ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout)
+        puts ActiveSupport::Logger.logger_outputs_to?(Rails.logger, Rails.application.config.paths["log"].first)
+      RUBY
+
+    assert status.success?, stderr
+    assert_equal "#{Logger::ERROR}\nfalse\ntrue\n", stdout
+  end
+
+  private
+    def run_runner(environment, script, **options)
+      stdout, stderr, status = Open3.capture3(environment, "bin/rails", "runner", "-e", "development", script,
+        chdir: Rails.root, **options)
+      assert status.success?, "Runner failed (#{status.exitstatus}):\n#{stdout}\n#{stderr}"
+      stdout
+    end
+
+    def assert_report(environment, expected)
+      log_path = Rails.root.join("log/development.log")
+      offset = log_path.exist? ? log_path.size : 0
+      stdout = run_runner(environment, "script/library_report.rb")
+      log = File.binread(log_path, nil, offset)
+
+      assert_equal expected, report_lines(stdout), "Terminal report with LOG_LEVEL=#{environment['LOG_LEVEL'].inspect}"
+      assert_equal expected, report_lines(log), "File report with LOG_LEVEL=#{environment['LOG_LEVEL'].inspect}"
+    end
+
+    def report_lines(output)
+      output.lines.filter_map { |line| line[/Library report:.*$/] }
+    end
+end
