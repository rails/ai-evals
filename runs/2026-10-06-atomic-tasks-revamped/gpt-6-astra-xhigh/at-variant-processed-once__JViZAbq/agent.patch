diff --git a/test/integration/picture_processing_test.rb b/test/integration/picture_processing_test.rb
new file mode 100644
index 0000000..cd3cf49
--- /dev/null
+++ b/test/integration/picture_processing_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class PictureProcessingTest < ActionDispatch::IntegrationTest
+  setup do
+    @storage = ActiveStorage::Blob.service
+    @original_storage_root = @storage.root
+    @storage.root = Dir.mktmpdir("picture-processing-")
+
+    sign_in :kevin
+  end
+
+  teardown do
+    FileUtils.remove_entry @storage.root
+    @storage.root = @original_storage_root
+  end
+
+  test "readers reuse the preprocessed picture without changing its bytes" do
+    leaf = leaves(:reading_picture)
+
+    assert_no_notifications("transform.active_storage") do
+      upload_picture(leaf)
+    end
+
+    picture = leaf.reload.leafable
+    original = picture.image.blob
+    assert_empty original.variant_records
+
+    assert_notifications_count("transform.active_storage", 1) do
+      perform_enqueued_jobs(only: ActiveStorage::CreateVariantsJob)
+      perform_enqueued_jobs(only: ActiveStorage::TransformJob)
+    end
+
+    derived = original.variant_records.reload.sole.image.blob
+    expected_bytes = legacy_reader_bytes
+    assert_equal expected_bytes, derived.download
+    assert_equal [ original.key, derived.key ].sort, stored_keys
+
+    books(:handbook).update!(published: true)
+    sign_out
+
+    assert_no_notifications(/transform\.active_storage|service_upload\.active_storage/) do
+      2.times do
+        fetch_picture(leaf)
+        assert_equal "image/webp", response.media_type
+        assert_equal expected_bytes, response.body.b
+      end
+    end
+
+    assert_equal [ derived.id ], original.variant_records.reload.map { |variant| variant.image.blob.id }
+    assert_equal [ original.key, derived.key ].sort, stored_keys
+  end
+
+  test "background work reuses a picture already derived by a reader" do
+    leaf = leaves(:reading_picture)
+    upload_picture(leaf)
+    original = leaf.reload.leafable.image.blob
+
+    assert_notifications_count("transform.active_storage", 1) do
+      fetch_picture(leaf)
+    end
+    derived = original.variant_records.reload.sole.image.blob
+    assert_equal legacy_reader_bytes, response.body.b
+
+    assert_no_notifications(/transform\.active_storage|service_upload\.active_storage/) do
+      perform_enqueued_jobs(only: ActiveStorage::CreateVariantsJob)
+      perform_enqueued_jobs(only: ActiveStorage::TransformJob)
+    end
+
+    assert_equal [ derived.id ], original.variant_records.reload.map { |variant| variant.image.blob.id }
+    assert_equal [ original.key, derived.key ].sort, stored_keys
+  end
+
+  private
+    def upload_picture(leaf)
+      put leafable_path(leaf), params: {
+        picture: { image: fixture_file_upload("reading.webp", "image/webp") }
+      }
+      assert_response :no_content
+    end
+
+    def fetch_picture(leaf)
+      get leafable_slug_path(leaf)
+      assert_response :success
+      image_path = css_select("figure img").sole["src"]
+
+      get image_path
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+    end
+
+    def legacy_reader_bytes
+      # These are the transformations decoded from the reader's URL before the fix.
+      variation = ActiveStorage::Variation.new(resize_to_limit: [ 1500, 1500 ], format: "webp")
+      file_fixture("reading.webp").open do |file|
+        variation.transform(file) { |output| File.binread(output.path) }
+      end
+    end
+
+    def stored_keys
+      Dir.glob("#{@storage.root}/**/*").select { |path| File.file?(path) }.map { |path| File.basename(path) }.sort
+    end
+end
