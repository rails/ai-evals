diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..fd2162e 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,27 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :track_publication, if: :saved_change_to_published?
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    def track_publication
+      return if @publication_change_tracked
+
+      @publication_change_tracked = true
+      was_published = published_before_last_save
+      transaction = self.class.current_transaction
+
+      # Later saves, reloads, and page touches can erase saved_changes. Keep the
+      # initial state until commit, and only announce a book that ends up live.
+      transaction.after_commit do
+        @publication_change_tracked = false
+
+        if !was_published && self.class.exists?(id: id, published: true)
+          AnnouncePublicationJob.perform_later self
+        end
+      end
+
+      transaction.after_rollback { @publication_change_tracked = false }
     end
 end
