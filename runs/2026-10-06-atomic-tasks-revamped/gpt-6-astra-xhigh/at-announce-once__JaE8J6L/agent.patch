diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..8b84988
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,219 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  # Exercise real commits and rollbacks instead of the fixture transaction.
+  self.use_transactional_tests = false
+
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "publishing announces the book only after commit" do
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ] do
+      Book.transaction do
+        @book.update! published: true
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+  end
+
+  test "publishing and adding a page announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "Launch day"
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert @book.reload.published?
+    assert @book.leaves.exists?(title: "Launch day")
+  end
+
+  test "publishing and editing pages announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.leaves.find(leaves(:welcome_page).id).update! title: "New welcome"
+        @book.leaves.find(leaves(:summary_page).id).trashed!
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+  end
+
+  test "later saves reloads and touches do not lose or duplicate the announcement" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! title: "Published handbook"
+        @book.reload
+        @book.save!
+        @book.touch
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+  end
+
+  test "saving an already published book does not announce again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: true
+      @book.update! title: "New title"
+      @book.touch
+    end
+  end
+
+  test "saving a draft does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+      @book.update! title: "Still a draft"
+      @book.press Page.new(body: ""), title: "Draft page"
+    end
+  end
+
+  test "unpublishing does not announce" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "a transaction ending in a draft does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "repeated publication changes in a transaction announce once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+        @book.update! published: true
+        @book.touch
+      end
+    end
+  end
+
+  test "a rollback leaves a draft without an announcement and permits a later publication" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_no_difference -> { @book.leaves.count } do
+        Book.transaction do
+          @book.update! published: true
+          @book.press Page.new(body: ""), title: "Rolled back page"
+          raise ActiveRecord::Rollback
+        end
+      end
+
+      assert_not @book.reload.published?
+      @book.update! title: "Still a draft"
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "a page touching a separately loaded book does not lose the announcement" do
+    leaf = leaves(:welcome_page)
+    leaf.book # Load another instance before publication.
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        leaf.update! title: "Updated welcome"
+      end
+    end
+  end
+
+  test "a live book remaining live across publication changes does not announce again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "a subsequent publication can announce after unpublishing in a separate transaction" do
+    @book.update! published: true
+    @book.update! published: false
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "announcing uses the persisted publication state rather than unsaved changes" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.published = false
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "a rolled back savepoint does not cancel an outer publication" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+
+        Book.transaction(requires_new: true) do
+          @book.update! published: false
+          raise ActiveRecord::Rollback
+        end
+
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "a publication in a savepoint waits for the outer commit" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.transaction(requires_new: true) do
+          @book.update! published: true
+        end
+
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.reload.published?
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "a publication rolled back to a savepoint can be retried in the same transaction" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        Book.transaction(requires_new: true) do
+          @book.update! published: true
+          raise ActiveRecord::Rollback
+        end
+
+        assert_not @book.reload.published?
+        @book.update! published: true
+        assert_no_enqueued_jobs only: AnnouncePublicationJob
+      end
+    end
+  end
+end
