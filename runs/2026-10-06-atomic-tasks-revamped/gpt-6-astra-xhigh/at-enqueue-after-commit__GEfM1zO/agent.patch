diff --git a/test/controllers/books/imports_controller_test.rb b/test/controllers/books/imports_controller_test.rb
new file mode 100644
index 0000000..25ee486
--- /dev/null
+++ b/test/controllers/books/imports_controller_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Books::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  # Exercise the import's actual commit and rollback boundaries.
+  self.use_transactional_tests = false
+
+  EDIT_JOBS = [ Book::CoverProcessingJob, Book::SearchIndexJob ]
+
+  setup do
+    sign_in :jason
+    @previous_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Book.find_each { |book| book.cover.blob&.delete }
+    Rails.cache = @previous_cache
+  end
+
+  test "a successful batch hands off all edit jobs only after the batch commits" do
+    batch = [ books(:handbook), books(:manual) ]
+    open_transactions_at_handoff = []
+    record_handoff = ->(event) do
+      if EDIT_JOBS.include?(event.payload[:job].class)
+        open_transactions_at_handoff << Book.current_transaction.open?
+      end
+    end
+
+    ActiveSupport::Notifications.subscribed(record_handoff, /enqueue(?:_at)?\.active_job/) do
+      post books_import_path, params: { books: batch.to_h { |book|
+        [ book.id, { title: "Imported #{book.title}", cover: fixture_file_upload("white-rabbit.webp", "image/webp") } ]
+      } }
+    end
+
+    assert_redirected_to root_path
+    assert_equal [ false, false, false, false ], open_transactions_at_handoff
+
+    assert_enqueued_jobs 2, only: Book::CoverProcessingJob
+    assert_enqueued_jobs 2, only: Book::SearchIndexJob
+    assert_no_enqueued_jobs only: Books::ImportFailureJob
+
+    perform_enqueued_jobs only: EDIT_JOBS
+
+    batch.each do |book|
+      book.reload
+      assert_equal Digest::SHA256.hexdigest(file_fixture("white-rabbit.webp").binread), book.cover.blob.metadata["sha256"]
+      assert_equal book.title, Rails.cache.read("search_index/book/#{book.id}")
+    end
+  end
+
+  test "a failed batch rolls back edits and their jobs but still notifies the operator" do
+    book = books(:handbook)
+    original_title = book.title
+    missing_id = Book.maximum(:id) + 1
+
+    post books_import_path, params: { books: {
+      book.id => { title: "Abandoned import", cover: fixture_file_upload("white-rabbit.webp", "image/webp") },
+      missing_id => { title: "Missing book" }
+    } }
+
+    assert_response :not_found
+    assert_equal original_title, book.reload.title
+    assert_not book.cover.attached?
+    assert_no_enqueued_jobs only: EDIT_JOBS
+    assert_enqueued_jobs 1, only: Books::ImportFailureJob
+    notification = assert_enqueued_with(job: Books::ImportFailureJob)
+    assert_equal users(:jason).id, notification.arguments.first
+    assert_match(/Couldn't find Book/, notification.arguments.last)
+
+    perform_enqueued_jobs only: Books::ImportFailureJob
+
+    assert_equal notification.arguments.last, Rails.cache.read("import_failure/#{users(:jason).id}")
+    assert_nil Rails.cache.read("search_index/book/#{book.id}")
+  end
+end
diff --git a/test/models/book/editing_test.rb b/test/models/book/editing_test.rb
new file mode 100644
index 0000000..596579c
--- /dev/null
+++ b/test/models/book/editing_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class Book::EditingTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  # These tests need real commits, not the test suite's wrapping transaction.
+  self.use_transactional_tests = false
+
+  EDIT_JOBS = [ Book::CoverProcessingJob, Book::SearchIndexJob ]
+
+  setup do
+    @blobs = []
+    @previous_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    @blobs.each(&:delete)
+    Rails.cache = @previous_cache
+  end
+
+  test "edit jobs wait for the outermost commit including a committed savepoint" do
+    book = books(:handbook)
+
+    freeze_time do
+      scheduled_at = 5.seconds.from_now
+
+      Book.transaction do
+        Book.transaction(requires_new: true) do
+          edit_with_cover(book, title: "Updated handbook")
+          assert_no_enqueued_jobs only: EDIT_JOBS
+        end
+
+        assert_no_enqueued_jobs only: EDIT_JOBS
+      end
+
+      assert_enqueued_jobs 1, only: Book::SearchIndexJob
+      assert_enqueued_with job: Book::SearchIndexJob, args: [ book ]
+      assert_enqueued_jobs 1, only: Book::CoverProcessingJob
+      assert_enqueued_with job: Book::CoverProcessingJob, args: [ book ], at: scheduled_at
+      assert_equal file_fixture("white-rabbit.webp").binread, book.cover.download
+    end
+  end
+
+  test "outer rollback discards edit jobs even after a savepoint commits" do
+    book = books(:handbook)
+    original_title = book.title
+
+    Book.transaction do
+      Book.transaction(requires_new: true) do
+        edit_with_cover(book, title: "Abandoned edit")
+      end
+
+      raise ActiveRecord::Rollback
+    end
+
+    assert_no_enqueued_jobs only: EDIT_JOBS
+    assert_equal original_title, book.reload.title
+    assert_not book.cover.attached?
+  end
+
+  test "rolling back a savepoint discards only its own edit jobs" do
+    book = books(:handbook)
+    other_book = books(:manual)
+    original_title = book.title
+
+    Book.transaction do
+      other_book.apply_edit(title: "Committed edit")
+
+      Book.transaction(requires_new: true) do
+        edit_with_cover(book, title: "Abandoned edit")
+        raise ActiveRecord::Rollback
+      end
+
+      assert_no_enqueued_jobs only: EDIT_JOBS
+    end
+
+    assert_no_enqueued_jobs only: Book::CoverProcessingJob
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+    assert_enqueued_with job: Book::SearchIndexJob, args: [ other_book ]
+    assert_equal "Committed edit", other_book.reload.title
+    assert_equal original_title, book.reload.title
+    assert_not book.cover.attached?
+  end
+
+  test "a worker can process a cover as soon as the edit jobs are handed off" do
+    book = books(:handbook)
+
+    perform_enqueued_jobs only: EDIT_JOBS do
+      edit_with_cover(book, title: "Updated handbook")
+    end
+
+    assert_performed_jobs 2, only: EDIT_JOBS
+    assert_equal Digest::SHA256.hexdigest(file_fixture("white-rabbit.webp").binread), book.cover.blob.reload.metadata["sha256"]
+    assert_equal "test", book.cover.blob.metadata["source"]
+    assert_equal "Updated handbook", Rails.cache.read("search_index/book/#{book.id}")
+  end
+
+  test "an edit without a cover still refreshes search without processing a cover" do
+    book = books(:handbook)
+
+    book.apply_edit(title: "Updated title")
+
+    assert_enqueued_jobs 1, only: Book::SearchIndexJob
+    assert_enqueued_with job: Book::SearchIndexJob, args: [ book ]
+    assert_no_enqueued_jobs only: Book::CoverProcessingJob
+  end
+
+  private
+    def edit_with_cover(book, **attributes)
+      book.apply_edit(attributes.merge(cover: {
+        io: StringIO.new(file_fixture("white-rabbit.webp").binread),
+        filename: "cover.webp",
+        content_type: "image/webp",
+        metadata: { "source" => "test" }
+      }))
+      @blobs << book.cover.blob
+    end
+end
