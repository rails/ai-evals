@@ -0,0 +1,11 @@
+module BookSearchRateLimitTestHelper
+  # Set this URL to exercise the production Redis implementation as well.
+  # Each test gets its own namespace, so cleanup never clears unrelated data.
+  def build_search_rate_limit_cache
+    if url = ENV["BOOK_SEARCH_RATE_LIMIT_REDIS_URL"].presence
+      ActiveSupport::Cache::RedisCacheStore.new(url: url, namespace: "book-search-test:#{SecureRandom.hex}")
+    else
+      ActiveSupport::Cache::MemoryStore.new
+    end
+  end
+end
