diff --git a/test/integration/picture_variants_test.rb b/test/integration/picture_variants_test.rb
new file mode 100644
index 0000000..380240d
--- /dev/null
+++ b/test/integration/picture_variants_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+require "tmpdir"
+
+class PictureVariantsTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    @storage_service = ActiveStorage::Blob.service
+    @original_storage_root = @storage_service.root
+    @storage_service.root = Dir.mktmpdir("picture-variants-")
+
+    sign_in :kevin
+  end
+
+  teardown do
+    FileUtils.remove_entry @storage_service.root
+    @storage_service.root = @original_storage_root
+  end
+
+  %w[ webp jpg png ].each do |format|
+    test "#{format} upload is processed once and readers get the same bytes" do
+      with_picture_upload(format) do |upload|
+        assert_notifications_count("transform.active_storage", 1) do
+          perform_enqueued_jobs { upload_picture(upload) }
+        end
+      end
+
+      assert_performed_jobs 1, only: ActiveStorage::TransformJob
+
+      leaf = leaves(:reading_picture).reload
+      blob = leaf.picture.image.blob
+      variant_record = blob.variant_records.sole
+      derived_blob = variant_record.image.blob
+      expected_bytes = legacy_reader_bytes(blob)
+      expected_files = [ blob, derived_blob ].map { |file| file.service.path_for(file.key) }.sort
+
+      assert_equal expected_bytes, derived_blob.download
+      assert_equal expected_files, stored_files
+
+      books(:handbook).update!(published: true)
+      sign_out
+
+      assert_no_notifications("transform.active_storage") do
+        2.times do
+          get book_slug_path(books(:handbook))
+          assert_response :success
+          thumbnail_path = css_select("#leaf_#{leaf.id} .toc__thumbnail img").sole["src"]
+
+          get leafable_slug_path(leaf)
+          assert_response :success
+          image_path = css_select("figure img").sole["src"]
+          assert_equal thumbnail_path, image_path
+
+          get image_path
+          assert_response :redirect
+          follow_redirect!
+          assert_response :success
+          assert_equal "image/webp", response.media_type
+          assert_equal expected_bytes, response.body.b
+        end
+      end
+
+      assert_equal [ variant_record.id ], blob.variant_records.reload.ids
+      assert_equal expected_files, stored_files
+    end
+  end
+
+  test "non-variable uploads are served unchanged without a derived copy" do
+    assert_no_notifications("transform.active_storage") do
+      perform_enqueued_jobs { upload_picture(fixture_file_upload("pixel.bmp", "image/bmp")) }
+
+      leaf = leaves(:reading_picture).reload
+      blob = leaf.picture.image.blob
+
+      get leafable_slug_path(leaf)
+      assert_response :success
+      get css_select("figure img").sole["src"]
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+
+      assert_equal file_fixture("pixel.bmp").binread, response.body.b
+      assert_empty blob.variant_records
+      assert_equal [ blob.service.path_for(blob.key) ], stored_files
+    end
+  end
+
+  private
+    def upload_picture(upload)
+      put leafable_path(leaves(:reading_picture)), params: { picture: { image: upload } }
+      assert_response :no_content
+    end
+
+    def with_picture_upload(format)
+      if format == "webp"
+        yield fixture_file_upload("white-rabbit.webp", "image/webp")
+      else
+        # Exercise resizing as well as format conversion, using an existing image fixture.
+        Tempfile.create([ "picture", ".#{format}" ]) do |file|
+          Vips::Image.new_from_file(file_fixture("white-rabbit.webp").to_s).resize(3).write_to_file(file.path)
+          yield fixture_file_upload(file.path, Marcel::MimeType.for(extension: format))
+        end
+      end
+    end
+
+    def legacy_reader_bytes(blob)
+      # Before the fix, the reader decoded this symbol-valued variant's signed URL.
+      variation = blob.variant(resize_to_limit: [ 1500, 1500 ], format: :webp).variation
+      blob.open do |file|
+        ActiveStorage::Variation.decode(variation.key).transform(file) { |output| output.read }
+      end
+    end
+
+    def stored_files
+      Dir.glob(File.join(@storage_service.root, "**", "*")).select { |path| File.file?(path) }.sort
+    end
+end
