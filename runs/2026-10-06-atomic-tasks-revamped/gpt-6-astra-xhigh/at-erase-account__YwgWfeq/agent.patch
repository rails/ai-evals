diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..de42b7d
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,219 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroy erases the account, sessions, audit events, grants and reading marks" do
+    user = users(:kevin)
+    user.sessions.create!(ip_address: "192.0.2.1", user_agent: "Private browser")
+    user.sessions.create!.destroy!
+    user.reading_marks.create!(leaf: leaves(:welcome_page), last_read_at: Time.current)
+    other_session = users(:jz).sessions.create!
+    other_mark = users(:jz).reading_marks.create!(leaf: leaves(:welcome_page), last_read_at: Time.current)
+    other_access_ids = Access.where.not(user: user).ids
+
+    user.destroy!
+
+    assert_not User.exists?(user.id)
+    assert_not Session.where(user_id: user.id).exists?
+    assert_not SignInEvent.for_address(user.email_address).exists?
+    assert_not Access.where(user_id: user.id).exists?
+    assert_not ReadingMark.where(user_id: user.id).exists?
+    assert Session.exists?(other_session.id)
+    assert ReadingMark.exists?(other_mark.id)
+    assert SignInEvent.for_address(users(:jz).email_address).exists?
+    assert_equal other_access_ids.sort, Access.ids.sort
+  end
+
+  test "shared books keep their content, readers and search results with an anonymous author" do
+    user = users(:kevin)
+    book = books(:handbook)
+    book.update!(creator: user, author: user.name, everyone_access: true, published: false)
+    leaf = leaves(:welcome_page)
+    leaf.edit leafable_params: { body: "Shared knowledge" }
+    leaf.reindex
+    other_mark = users(:jz).reading_marks.create!(leaf: leaf, last_read_at: Time.current)
+    access_ids = book.accesses.where.not(user: user).ids
+    leaf_ids = book.leaves.ids
+    edit_ids = leaf.edits.ids
+    image = pictures(:reading).image.blob
+    user.created_books.load # Cached associations must not cause shared books to be destroyed.
+
+    user.destroy!
+
+    assert_nil book.reload.creator_id
+    assert_equal "Deleted author", book.author
+    assert_not book.published?
+    assert_equal leaf_ids.sort, book.leaves.ids.sort
+    assert_equal edit_ids, leaf.edits.ids
+    assert_equal access_ids.sort, book.accesses.ids.sort
+    assert ReadingMark.exists?(other_mark.id)
+    assert ActiveStorage::Blob.exists?(image.id)
+    assert_includes Leaf.search("knowledge"), leaf
+  end
+
+  test "private books erase all content, revisions, trash, attachments and raw search rows" do
+    user = users(:kevin)
+    book = books(:handbook)
+    book.update!(creator: user, everyone_access: false, published: true)
+    pictures(:reading).image.attach io: file_fixture("reading.webp").open, filename: "private-picture.webp"
+    book.cover.attach io: file_fixture("white-rabbit.webp").open, filename: "private-cover.webp"
+    pages(:welcome).body.uploads.attach io: file_fixture("pixel.bmp").open, filename: "private-upload.bmp"
+    leaves(:welcome_page).edit leafable_params: { body: "Private revised body" }
+    leaves(:welcome_page).trashed!
+    leaves(:reading_picture).edit leafable_params: { caption: "Private caption" }
+    leaves(:reading_picture).trashed!
+    sections(:welcome).update!(body: "Private section")
+    Leaf.reindex_all
+    # An old index entry can outlive searchable content (e.g. a section cleared to nil).
+    sections(:welcome).update!(body: nil)
+    users(:jz).reading_marks.create!(leaf: leaves(:welcome_page), last_read_at: Time.current)
+    leaf_ids = book.leaves.ids
+    page_ids = Page.ids
+    picture_ids = Picture.ids
+    section_ids = Section.ids
+    markdown_ids = ActionText::Markdown.ids
+    blob_ids = ActiveStorage::Attachment.distinct.pluck(:blob_id)
+    pictures(:reading).image.variant(:large).processed
+    variant_ids = ActiveStorage::VariantRecord.ids
+    stored_files = ActiveStorage::Blob.where(id: blob_ids).to_a + ActiveStorage::VariantRecord.all.map { |variant| variant.image.blob }
+    assert stored_files.all? { |blob| blob.service.exist?(blob.key) }
+    other_book = books(:manual)
+    other_book.update!(creator: users(:david), author: "David")
+
+    perform_enqueued_jobs do
+      user.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_not Leaf.where(id: leaf_ids).exists?
+    assert_not Edit.where(leaf_id: leaf_ids).exists?
+    assert_not Page.where(id: page_ids).exists?
+    assert_not Picture.where(id: picture_ids).exists?
+    assert_not Section.where(id: section_ids).exists?
+    assert_not ActionText::Markdown.where(id: markdown_ids).exists?
+    assert_not Access.where(book_id: book.id).exists?
+    assert_not ReadingMark.where(leaf_id: leaf_ids).exists?
+    assert_empty ActiveStorage::Attachment.all
+    assert_not ActiveStorage::Blob.where(id: stored_files.map(&:id)).exists?
+    assert_not ActiveStorage::VariantRecord.where(id: variant_ids).exists?
+    assert stored_files.none? { |blob| blob.service.exist?(blob.key) }
+    assert_empty Leaf.connection.select_values("SELECT rowid FROM leaf_search_index WHERE rowid IN (#{leaf_ids.join(',')})")
+    assert_equal "David", other_book.reload.author
+    assert_equal users(:david), other_book.creator
+  end
+
+  test "legacy deactivated addresses erase original and rewritten audit events" do
+    user = users(:kevin)
+    addresses = [ user.email_address ]
+    2.times do
+      user.sessions.create!
+      user.deactivate
+      addresses << user.email_address
+    end
+    user.sessions.create!
+    unrelated_event = SignInEvent.create!(email_address: "other-kevin@example.com", action: :signed_in)
+
+    user.destroy!
+
+    assert_not SignInEvent.where(email_address: addresses).exists?
+    assert SignInEvent.exists?(unrelated_event.id)
+  end
+  test "a blob used by both private and retained content is not purged" do
+    user = users(:kevin)
+    books(:handbook).update!(creator: user, everyone_access: false)
+    books(:manual).update!(creator: user, everyone_access: true, published: true)
+    image = pictures(:reading).image.blob
+    books(:manual).cover.attach image
+
+    perform_enqueued_jobs do
+      user.destroy!
+    end
+
+    assert_not Book.exists?(books(:handbook).id)
+    assert_equal "Deleted author", books(:manual).reload.author
+    assert books(:manual).published?
+    assert_nil books(:manual).creator_id
+    assert_equal image, books(:manual).cover.blob
+    assert ActiveStorage::Blob.exists?(image.id)
+  end
+
+  test "a failed erasure rolls back account data, shared authorship and search rows without purging files" do
+    user = users(:kevin)
+    books(:handbook).update!(creator: user, everyone_access: false)
+    books(:manual).update!(creator: user, author: user.name, everyone_access: true)
+    user.sessions.create!
+    user.reading_marks.create!(leaf: leaves(:welcome_page), last_read_at: Time.current)
+    leaf = leaves(:welcome_page)
+    leaf.edit leafable_params: { body: "Private knowledge" }
+    leaf.reindex
+    counts = [ User, Book, Leaf, Edit, Page, Access, ReadingMark, Session, SignInEvent, ActiveStorage::Attachment ].map(&:count)
+    index_rows = Leaf.connection.select_rows("SELECT rowid, title, content FROM leaf_search_index ORDER BY rowid")
+
+    assert_no_enqueued_jobs only: ActiveStorage::PurgeJob do
+      User.transaction(requires_new: true) do
+        user.destroy!
+        assert_not User.exists?(user.id)
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_equal counts, [ User, Book, Leaf, Edit, Page, Access, ReadingMark, Session, SignInEvent, ActiveStorage::Attachment ].map(&:count)
+    assert_equal index_rows, Leaf.connection.select_rows("SELECT rowid, title, content FROM leaf_search_index ORDER BY rowid")
+    assert_equal user.name, books(:manual).reload.author
+    assert_equal user.id, books(:manual).creator_id
+    assert_includes Leaf.search("knowledge"), leaf
+  end
+
+  test "editing and erasing in the same transaction does not recreate search entries" do
+    user = users(:kevin)
+    book = books(:handbook)
+    book.update!(creator: user, everyone_access: false)
+    leaf_ids = book.leaves.ids
+    Leaf.reindex_all
+
+    User.transaction(requires_new: true) do
+      leaves(:welcome_page).edit leafable_params: { body: "Never retain this revision" }
+      user.destroy!
+    end
+
+    assert_empty Leaf.connection.select_values("SELECT rowid FROM leaf_search_index WHERE rowid IN (#{leaf_ids.join(',')})")
+  end
+
+  test "an active address resembling a legacy deactivation is not unwrapped" do
+    user = users(:kevin)
+    original_event = SignInEvent.create!(email_address: user.email_address, action: :signed_in)
+    user.update! email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com"
+    user.sessions.create!
+
+    user.destroy!
+
+    assert_not SignInEvent.for_address(user.email_address).exists?
+    assert SignInEvent.exists?(original_event.id)
+  end
+
+  test "deactivation recovery uses exact addresses including punctuation" do
+    user = users(:kevin)
+    user.update! email_address: "kevin_100%+notes@example.com"
+    user.sessions.create!
+    other_event = SignInEvent.create!(email_address: "kevinX100percent+notes@example.com", action: :signed_in)
+    user.deactivate
+
+    user.destroy!
+
+    assert_not SignInEvent.for_address("kevin_100%+notes@example.com").exists?
+    assert SignInEvent.exists?(other_event.id)
+  end
+
+  test "inactive addresses with non-UUID suffixes are not unwrapped" do
+    user = users(:kevin)
+    original_event = SignInEvent.create!(email_address: user.email_address, action: :signed_in)
+    user.update! email_address: "kevin-deactivated-not-a-uuid@example.com", active: false
+    user.sessions.create!
+
+    user.destroy!
+
+    assert_not SignInEvent.for_address(user.email_address).exists?
+    assert SignInEvent.exists?(original_event.id)
+  end
+end
