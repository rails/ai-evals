new file mode 100644
index 0000000..64996ab
--- /dev/null
+++ b/app/models/user/erasure.rb
@@ -0,0 +1,29 @@
+module User::Erasure
+  extend ActiveSupport::Concern
+
+  included do
+    # Session destruction records sign-outs, so remove audit events after the dependencies.
+    after_destroy :erase_sign_in_events
+  end
+
+  private
+    def erase_sign_in_events
+      SignInEvent.where(email_address: sign_in_event_addresses).delete_all
+    end
+
+    def sign_in_event_addresses
+      addresses = [ email_address ]
+
+      # The old removal flow appended a UUID to the local part. Recover each prior
+      # address, including accounts deactivated more than once, without a broad LIKE match.
+      unless active?
+        loop do
+          original = addresses.last.sub(/-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?=@[^@]+\z)/i, "")
+          break if original == addresses.last
+          addresses << original
+        end
+      end
+
+      addresses
+    end
+end
