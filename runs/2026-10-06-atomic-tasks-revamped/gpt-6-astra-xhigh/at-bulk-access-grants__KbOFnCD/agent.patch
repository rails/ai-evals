@@ -6,20 +6,52 @@ class Book::AccessImport
   end
 
   def import
-    accesses = []
-    duplicate_index = nil
-
-    Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
+    result = insert_accesses
+
+    unless result.accesses.empty?
+      ActiveRecord.after_all_transactions_commit do
+        result.accesses.each { |access| Book::AccessNotificationJob.perform_later(access) }
       end
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    result
   end
+
+  private
+    def insert_accesses
+      Access.transaction(requires_new: true) do
+        user_ids = existing_user_ids
+        rows = []
+
+        @grants.each_with_index do |grant, index|
+          return Result.new([], index) unless Access.levels.key?(grant[:level].to_s)
+
+          # Bulk inserts skip validations, so validate and type-cast before writing anything.
+          access = Access.new(book: @book, user_id: grant[:user_id], level: grant[:level])
+          access.validate!
+          return Result.new([], index) unless user_ids.add?(access.user_id)
+
+          rows << access.attributes.slice("user_id", "level")
+        end
+
+        @book.accesses.insert_all!(rows)
+        accesses_by_user = @book.accesses.where(user_id: rows.pluck("user_id")).index_by(&:user_id)
+        accesses = rows.map { |row| accesses_by_user.fetch(row["user_id"]) }
+        Result.new(accesses, nil)
+      end
+    rescue ActiveRecord::RecordNotUnique
+      # A concurrent import may have granted access after the preflight check.
+      user_ids = existing_user_ids
+      index = @grants.find_index do |grant|
+        user_id = Access.type_for_attribute("user_id").cast(grant[:user_id])
+        !user_ids.add?(user_id)
+      end
+      raise unless index
+
+      Result.new([], index)
+    end
+
+    def existing_user_ids
+      @book.accesses.scope.pluck(:user_id).to_set
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..d38eb0f
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,242 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+    @book.accesses.delete_all
+  end
+
+  test "imports persisted accesses in grant order and notifies each person" do
+    grants = [
+      { user_id: users(:kevin).id.to_s, level: :editor },
+      { user_id: users(:david).id, level: "reader" }
+    ]
+
+    result = nil
+    assert_difference -> { @book.accesses.count }, 2 do
+      assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+        result = Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_instance_of Book::AccessImport::Result, result
+    assert_nil result.duplicate_index
+    assert_equal [ users(:kevin).id, users(:david).id ], result.accesses.map(&:user_id)
+    assert_equal [ "editor", "reader" ], result.accesses.map(&:level)
+    result.accesses.each do |access|
+      assert access.persisted?
+      assert_equal @book.id, access.book_id
+      assert_not_nil access.created_at
+      assert_not_nil access.updated_at
+      assert_equal access.attributes, access.reload.attributes
+      assert_enqueued_with job: Book::AccessNotificationJob, args: [ access ]
+    end
+  end
+
+  test "an existing access rejects the entire roster without changing its level or notifying anyone" do
+    existing = @book.accesses.create!(user: users(:jz), level: :reader)
+    grants = [ grant_for(:kevin), grant_for(:david), grant_for(:jz, :editor) ]
+
+    assert_rejected grants, at: 2
+    assert_equal [ existing.id ], @book.accesses.ids
+    assert_equal "reader", existing.reload.level
+  end
+
+  test "a repeated user rejects the entire roster at the later occurrence" do
+    grants = [ grant_for(:kevin), grant_for(:david), grant_for(:kevin, :editor) ]
+    grants.last[:user_id] = grants.last[:user_id].to_s
+
+    assert_rejected grants, at: 2
+  end
+
+  test "reports the first conflict in input order" do
+    @book.accesses.create!(user: users(:jz), level: :reader)
+
+    assert_rejected [ grant_for(:kevin), grant_for(:kevin), grant_for(:jz) ], at: 1
+    assert_rejected [ grant_for(:jz), grant_for(:kevin), grant_for(:kevin) ], at: 0
+  end
+
+  test "unknown levels reject the entire roster without notifying anyone" do
+    [ "owner", :owner, 123 ].each do |level|
+      assert_rejected [ grant_for(:kevin), grant_for(:david, level), grant_for(:jz) ], at: 1
+    end
+  end
+
+  test "reports unknown levels and duplicates in input order" do
+    @book.accesses.create!(user: users(:jz), level: :reader)
+
+    assert_rejected [ grant_for(:kevin, :owner), grant_for(:jz) ], at: 0
+    assert_rejected [ grant_for(:jz), grant_for(:kevin, :owner) ], at: 0
+  end
+
+  test "duplicate checks use persisted accesses even when the association was loaded earlier" do
+    @book.accesses.load
+    Access.create!(book: @book, user: users(:jz), level: :reader)
+
+    assert_rejected [ grant_for(:jz), grant_for(:kevin, :owner) ], at: 0
+  end
+
+  test "successful imports refresh an already loaded association" do
+    @book.accesses.load
+    result = Book::AccessImport.new(@book, [ grant_for(:kevin) ]).import
+
+    assert_equal result.accesses, @book.accesses.to_a
+  end
+
+  test "database uniqueness conflicts reject the batch and leave the enclosing transaction usable" do
+    existing = @book.accesses.create!(user: users(:jz), level: :reader)
+    grants = [ grant_for(:kevin), grant_for(:david), grant_for(:jz, :editor) ]
+    importer = Book::AccessImport.new(@book, grants)
+    checks = 0
+    importer.define_singleton_method(:existing_user_ids) do
+      # Simulate a grant that was not visible during preflight, but conflicts at insertion.
+      checks += 1
+      checks == 1 ? Set.new : super()
+    end
+
+    assert_no_enqueued_jobs do
+      Access.transaction do
+        result = importer.import
+        assert_empty result.accesses
+        assert_equal 2, result.duplicate_index
+        assert_equal [ existing.id ], @book.accesses.ids
+        assert_equal "reader", existing.reload.level
+
+        @book.accesses.create!(user: users(:jason), level: :editor)
+      end
+    end
+    assert_equal 2, checks
+    assert_equal 2, @book.accesses.count
+  end
+
+  test "repeating a successful import rejects it without sending more notifications" do
+    importer = Book::AccessImport.new(@book, [ grant_for(:kevin), grant_for(:david) ])
+    first_result = importer.import
+
+    assert_no_enqueued_jobs do
+      result = importer.import
+      assert_empty result.accesses
+      assert_equal 0, result.duplicate_index
+    end
+    assert_equal first_result.accesses.map(&:id).sort, @book.accesses.ids.sort
+  end
+
+  test "empty rosters succeed without writes or notifications" do
+    statements = write_statements do
+      assert_no_enqueued_jobs do
+        result = Book::AccessImport.new(@book, []).import
+        assert_empty result.accesses
+        assert_nil result.duplicate_index
+      end
+    end
+
+    assert_empty statements.grep(/\A(?:INSERT|UPDATE|DELETE)\b/i)
+  end
+
+  test "missing users still fail validation without writes or notifications" do
+    assert_no_difference -> { @book.accesses.count } do
+      assert_no_enqueued_jobs do
+        error = assert_raises ActiveRecord::RecordInvalid do
+          Book::AccessImport.new(@book, [ grant_for(:kevin), { user_id: nil, level: :reader } ]).import
+        end
+        assert error.record.errors.added?(:user, :blank, message: :required)
+      end
+    end
+  end
+
+  test "notifications wait for the enclosing transaction to commit" do
+    result = nil
+
+    assert_enqueued_jobs 1, only: Book::AccessNotificationJob do
+      Access.transaction do
+        assert_no_enqueued_jobs do
+          result = Book::AccessImport.new(@book, [ grant_for(:kevin) ]).import
+          assert result.accesses.first.persisted?
+        end
+      end
+    end
+
+    assert_enqueued_with job: Book::AccessNotificationJob, args: [ result.accesses.first ]
+  end
+
+  test "rolling back the enclosing transaction discards notifications" do
+    assert_no_difference -> { @book.accesses.count } do
+      assert_no_enqueued_jobs do
+        Access.transaction do
+          Book::AccessImport.new(@book, [ grant_for(:kevin) ]).import
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "successful rosters use a constant number of writes and transaction statements" do
+    grants = large_roster
+    counts = [ 4, 16 ].map do |size|
+      @book.accesses.delete_all
+      statements = write_statements do
+        result = Book::AccessImport.new(@book, grants.first(size)).import
+        assert_nil result.duplicate_index
+        assert_equal size, result.accesses.size
+      end
+      statements.size
+    end
+
+    assert_equal counts.first, counts.last
+  end
+
+  [ :existing, :repeated, :unknown_level ].each do |failure|
+    test "rosters rejected for #{failure} use a constant number of writes and transaction statements" do
+      grants = large_roster
+      @book.accesses.create!(user: users(:david), level: :reader) if failure == :existing
+
+      counts = [ 4, 16 ].map do |size|
+        roster = grants.first(size)
+        roster[-1] = case failure
+        when :existing then grant_for(:david)
+        when :repeated then roster.first
+        when :unknown_level then roster.last.merge(level: :owner)
+        end
+
+        write_statements { assert_rejected roster, at: size - 1 }.size
+      end
+
+      assert_equal counts.first, counts.last
+    end
+  end
+
+  private
+    def grant_for(user, level = :reader)
+      { user_id: users(user).id, level: level }
+    end
+
+    def assert_rejected(grants, at:)
+      assert_no_difference -> { @book.accesses.count } do
+        assert_no_enqueued_jobs do
+          result = Book::AccessImport.new(@book, grants).import
+          assert_empty result.accesses
+          assert_equal at, result.duplicate_index
+        end
+      end
+    end
+
+    def large_roster
+      rows = 16.times.map do |index|
+        { name: "Import user #{index}", email_address: "import-#{index}@example.com",
+          password_digest: users(:kevin).password_digest, role: :member }
+      end
+      User.insert_all!(rows).rows.flatten.map { |id| { user_id: id, level: :reader } }
+    end
+
+    def write_statements
+      statements = []
+      subscriber = ->(event) do
+        sql = event.payload[:sql].strip
+        statements << sql if sql.match?(/\A(?:INSERT|UPDATE|DELETE|REPLACE|BEGIN|COMMIT|ROLLBACK|SAVEPOINT|RELEASE)\b/i)
+      end
+      ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") { yield }
+      statements
+    end
+end
