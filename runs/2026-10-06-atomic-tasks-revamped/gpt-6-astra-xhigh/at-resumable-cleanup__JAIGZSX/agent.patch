+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :clean_titles do |step|
+      Leaf.find_each(start: step.cursor&.first, order: :asc) do |leaf|
+        # A replay must clean the original title, not strip another layer of quotes.
+        original_title = step.cursor&.first == leaf.id ? step.cursor.last : leaf.title
+        step.set! [ leaf.id, original_title ]
+        leaf.update!(title: cleaned(original_title))
+      end
     end
   end
 
