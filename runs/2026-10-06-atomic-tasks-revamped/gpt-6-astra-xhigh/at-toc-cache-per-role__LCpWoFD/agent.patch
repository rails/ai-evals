diff --git a/test/controllers/books/contents_caching_test.rb b/test/controllers/books/contents_caching_test.rb
new file mode 100644
index 0000000..a39dec6
--- /dev/null
+++ b/test/controllers/books/contents_caching_test.rb
@@ -0,0 +1,212 @@
+require "test_helper"
+
+class Books::ContentsCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_cache = Rails.cache
+    @previous_controller_cache = ActionController::Base.cache_store
+    @previous_collection_cache = ActionView::CollectionRenderer.collection_cache
+    @previous_perform_caching = ActionController::Base.perform_caching
+
+    # Load the session rate limiter before replacing its default cache store.
+    sign_in :kevin
+
+    @cache = ActiveSupport::Cache::MemoryStore.new
+    Rails.cache = @cache
+    ActionController::Base.cache_store = @cache
+    ActionView::CollectionRenderer.collection_cache = @cache
+    ActionController::Base.perform_caching = true
+
+    @book = books(:handbook)
+    @leaves = @book.leaves.active.positioned.to_a
+  end
+
+  teardown do
+    Rails.cache = @previous_cache
+    ActionController::Base.cache_store = @previous_controller_cache
+    ActionView::CollectionRenderer.collection_cache = @previous_collection_cache
+    ActionController::Base.perform_caching = @previous_perform_caching
+  end
+
+  test "an editor warming the collection does not give a reader editor controls" do
+    get_contents
+
+    sign_in :jz
+    get_contents
+    assert_contents editable: false
+
+    sign_in :kevin
+    get_contents
+    assert_contents editable: true
+  end
+
+  test "a reader warming the collection does not remove an editor's controls" do
+    sign_in :jz
+    get_contents
+
+    sign_in :kevin
+    get_contents
+    assert_contents editable: true
+
+    sign_in :jz
+    get_contents
+    assert_contents editable: false
+  end
+
+  test "readers receive no editor controls even on a cold cache" do
+    sign_in :jz
+    get_contents
+    assert_contents editable: false
+  end
+
+  test "published books separate anonymous readers and editors in either warming order" do
+    @book.update! published: true
+    get_contents
+    sign_out
+    get_contents
+    assert_contents editable: false
+
+    @cache.clear
+    get_contents
+    sign_in :kevin
+    get_contents
+    assert_contents editable: true
+  end
+
+  test "changing access takes effect without changing the book" do
+    get_contents
+    assert_contents editable: true
+
+    accesses(:kevin_handbook).update! level: :reader
+    get_contents
+    assert_contents editable: false
+
+    accesses(:kevin_handbook).update! level: :editor
+    get_contents
+    assert_contents editable: true
+  end
+
+  test "administrators have editor controls even with reader access" do
+    accesses(:david_handbook).update! level: :reader
+    sign_in :jz
+    get_contents
+
+    sign_in :david
+    get_contents
+    assert_contents editable: true
+  end
+
+  test "renaming an entry invalidates both permission variants" do
+    get_contents
+    sign_in :jz
+    get_contents
+
+    leaf = leaves(:welcome_page)
+    old_title = leaf.title
+    travel 1.second do
+      leaf.update! title: "A newly named welcome"
+    end
+
+    [ :jz, :kevin ].each do |user|
+      sign_in user
+      get_contents
+      assert_in_body "A newly named welcome"
+      assert_not_in_body old_title
+      assert_select "#leaf_#{leaf.id} a[href=?]", leafable_slug_path(leaf), count: 2
+    end
+  end
+
+  test "changing the book slug invalidates cached entry links" do
+    get_contents
+    sign_in :jz
+    get_contents
+
+    travel 1.second do
+      @book.update! slug: "renamed-handbook"
+    end
+
+    [ :jz, :kevin ].each do |user|
+      sign_in user
+      get_contents
+      assert_contents editable: user == :kevin
+    end
+  end
+
+  test "individual Turbo updates retain editor controls for every entry type" do
+    sign_in :jz
+    get_contents
+    sign_in :kevin
+
+    [ :welcome_page, :welcome_section, :reading_picture ].each do |name|
+      leaf = leaves(name)
+      put leafable_path(leaf, format: :turbo_stream), params: { leaf: { title: "Updated #{name}" } }
+
+      assert_response :success
+      assert_in_body "Updated #{name}"
+      assert_select "turbo-stream[action=replace][target=?]", "leaf_#{leaf.id}" do
+        assert_select "a[href=?]", edit_leafable_path(leaf), count: 2
+        assert_select ".arrangement__handle", count: 1
+        assert_select "form.leaf__delete[action=?]", leafable_path(leaf), count: 1
+      end
+    end
+  end
+
+  test "large collections use batched cache reads and bounded permission queries" do
+    200.times do |index|
+      @book.press Section.new(body: "Section content"), title: "Section #{index}"
+    end
+    @leaves = @book.leaves.active.positioned.to_a
+
+    cold_queries = capture_notifications("sql.active_record") { get_contents }
+    assert_bounded_access_queries cold_queries
+
+    # Force the collection cache to be read instead of the enclosing book fragment.
+    @cache.delete_matched(/books\/show/)
+
+    batch_reads = single_reads = nil
+    queries = capture_notifications("sql.active_record") do
+      batch_reads = capture_notifications("cache_read_multi.active_support") do
+        single_reads = capture_notifications("cache_read.active_support") do
+          get_contents
+        end
+      end
+    end
+
+    assert_equal 1, batch_reads.size
+    assert_equal @leaves.size, batch_reads.first[:key].size
+    assert_equal @leaves.size, batch_reads.first[:hits].size
+    assert_empty single_reads.select { |payload| payload[:key].include?("leaves/_leaf") }
+    assert_bounded_access_queries queries
+    assert_contents editable: true
+  end
+
+  private
+    def get_contents
+      get book_slug_path(@book)
+      assert_response :success
+    end
+
+    def assert_contents(editable:)
+      assert_select "li.toc__leaf", count: @leaves.size
+      @leaves.each do |leaf|
+        assert_select "#leaf_#{leaf.id}" do
+          assert_select "a[href=?]", edit_leafable_path(leaf), count: editable ? 2 : 0
+          assert_select "a[href=?]", leafable_slug_path(leaf), count: 2
+          assert_select ".arrangement__handle", count: editable ? 1 : 0
+          assert_select "form.leaf__delete[action=?]", leafable_path(leaf), count: editable ? 1 : 0
+        end
+      end
+    end
+
+    def assert_bounded_access_queries(queries)
+      access_queries = queries.select { |payload| payload[:sql].match?(/FROM "accesses"/) }
+      book_queries = queries.select { |payload| payload[:sql].match?(/FROM "books"/) }
+      assert_operator access_queries.size, :<=, 2
+      assert_operator book_queries.size, :<=, 2
+    end
+
+    def capture_notifications(name)
+      payloads = []
+      ActiveSupport::Notifications.subscribed(->(event) { payloads << event.payload }, name) { yield }
+      payloads
+    end
+end
