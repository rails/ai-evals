diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..6c21296 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,88 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroy snapshots current accesses even when the association was already loaded" do
+    book = books(:manual)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.update!(everyone_access: false)
+      book.accesses.load
+      Book.find(book.id).update_access(editors: [ users(:jz).id, users(:kevin).id ], readers: [ users(:david).id ])
+    end
+    assert book.accesses.loaded?
+
+    assert_difference -> { AccessArchive.count }, 3 do
+      book.destroy!
+    end
+
+    assert_equal [
+      [ users(:david).id, users(:david).name, "reader" ],
+      [ users(:jz).id, users(:jz).name, "editor" ],
+      [ users(:kevin).id, users(:kevin).name, "editor" ]
+    ].sort, AccessArchive.where(book_id: book.id).pluck(:user_id, :user_name, :level).sort
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+  end
+
+  test "destroy without current accesses creates no archives even with a stale association" do
+    book = books(:manual)
+    book.accesses.load
+
+    assert_no_difference -> { AccessArchive.count } do
+      Access.where(book_id: book.id).delete_all
+
+      assert_difference -> { Book.count }, -1 do
+        book.destroy!
+      end
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+  end
+
+  test "archive rows are only written after the book is deleted" do
+    book = books(:manual)
+    queries = []
+    subscriber = ->(event) { queries << event.payload[:sql] }
+
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      book.destroy!
+    end
+
+    deletion = queries.index { |sql| sql.start_with?('DELETE FROM "books"') }
+    insertions = queries.each_index.select { |index| queries[index].start_with?('INSERT INTO "access_archives"') }
+
+    assert_not_nil deletion
+    assert_equal 3, insertions.size
+    assert insertions.all? { |index| index > deletion }
+  end
+
+  test "archive rows roll back with the deletion" do
+    book = books(:manual)
+
+    assert_no_difference [ -> { Book.count }, -> { Access.count }, -> { AccessArchive.count } ] do
+      Book.transaction(requires_new: true) do
+        book.destroy!
+        assert_equal 3, AccessArchive.where(book_id: book.id).count
+
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert Book.exists?(book.id)
+    assert_equal 3, Access.where(book_id: book.id).count
+  end
+
+  test "destroying the same book again does not duplicate archives" do
+    book = books(:manual)
+
+    assert_difference -> { AccessArchive.count }, 3 do
+      book.destroy!
+    end
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+  end
 end
