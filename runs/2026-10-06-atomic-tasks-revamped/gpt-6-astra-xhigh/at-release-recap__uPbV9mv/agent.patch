+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  self.use_transactional_tests = false
+
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    sign_in :david
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "the library recap shows the final title immediately after release" do
+    book = books(:manual)
+    book.update! title: "Working title"
+
+    patch book_release_path(book), params: { book: { title: "Released manual" } }
+
+    assert_redirected_to root_path
+    follow_redirect!
+    assert_response :success
+    assert_select ".library__recents" do
+      assert_select "strong", text: "Released manual"
+      assert_select "span", text: "Published"
+    end
+    assert_not_in_body "Working title"
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..6a30f0b
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  # Exercise callback selection across instances at a real transaction commit.
+  self.use_transactional_tests = false
+
+  setup do
+    @original_cache = Rails.cache
+    @original_expiry = Rails.application.config.x.recap.expires_in
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+    Rails.application.config.x.recap.expires_in = @original_expiry
+  end
+
+  test "ordinary renames refresh the recap" do
+    book = books(:manual)
+    book.update! title: "Renamed manual"
+
+    assert_equal({ title: "Renamed manual", published: false }, book.cached_recap)
+
+    book.update! title: "Renamed again"
+
+    assert_equal({ title: "Renamed again", published: false }, book.cached_recap)
+  end
+
+  test "release recaps use the committed title and publication status" do
+    book = books(:manual)
+    book.update! title: "Working title"
+
+    assert Book.finalize_release(book.id, title: "Released manual")
+    assert_equal "Released manual", book.reload.title
+    assert book.published?
+    assert_equal({ title: "Released manual", published: true }, book.cached_recap)
+  end
+
+  test "release recaps wait for the outer transaction to commit" do
+    book = books(:manual)
+    book.update! title: "Working title"
+    recap = book.cached_recap
+
+    Book.transaction do
+      Book.finalize_release(book.id, title: "Released manual")
+      assert_equal recap, book.cached_recap
+    end
+
+    assert_equal({ title: "Released manual", published: true }, book.cached_recap)
+  end
+
+  test "rolled back releases leave the recap unchanged" do
+    book = books(:manual)
+    book.update! title: "Working title"
+    recap = book.cached_recap
+
+    Book.transaction do
+      Book.finalize_release(book.id, title: "Released manual")
+      raise ActiveRecord::Rollback
+    end
+
+    assert_equal "Working title", book.reload.title
+    assert_not book.published?
+    assert_equal recap, book.cached_recap
+  end
+
+  test "updating one book never overwrites another book's recap" do
+    manual = books(:manual)
+    handbook = books(:handbook)
+    manual.update! title: "Working manual"
+    handbook.update! title: "Updated handbook"
+
+    assert_not_equal manual.recap_cache_key, handbook.recap_cache_key
+    assert_equal({ title: "Working manual", published: false }, manual.cached_recap)
+    assert_equal({ title: "Updated handbook", published: false }, handbook.cached_recap)
+
+    Book.finalize_release(manual.id, title: "Released manual")
+
+    assert_equal({ title: "Released manual", published: true }, manual.cached_recap)
+    assert_equal({ title: "Updated handbook", published: false }, handbook.cached_recap)
+  end
+
+  test "recaps expire on the configured schedule" do
+    Rails.application.config.x.recap.expires_in = 10.minutes
+    book = books(:manual)
+
+    freeze_time do
+      Book.finalize_release(book.id, title: "Released manual")
+
+      travel 10.minutes - 1.second
+      assert_not_nil book.cached_recap
+
+      travel 2.seconds
+      assert_nil book.cached_recap
+    end
+  end
+
+  test "saving refreshes only that book's recap expiry" do
+    Rails.application.config.x.recap.expires_in = 10.minutes
+    manual = books(:manual)
+    handbook = books(:handbook)
+
+    freeze_time do
+      manual.update! title: "Updated manual"
+      handbook.update! title: "Updated handbook"
+
+      travel 5.minutes
+      manual.update! title: "Updated again"
+
+      travel 5.minutes + 1.second
+      assert_equal({ title: "Updated again", published: false }, manual.cached_recap)
+      assert_nil handbook.cached_recap
+
+      travel 5.minutes
+      assert_nil manual.cached_recap
+    end
+  end
+end
