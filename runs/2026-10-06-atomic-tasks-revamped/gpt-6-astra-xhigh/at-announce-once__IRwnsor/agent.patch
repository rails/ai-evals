--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,27 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :announce_publication_after_commit, if: :saved_change_to_published?
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    def announce_publication_after_commit
+      return if @publication_announcement_pending
+
+      @publication_announcement_pending = true
+      previously_published = published_before_last_save
+
+      # Capture the transition before later saves or page touches overwrite saved_changes.
+      self.class.current_transaction.after_commit do
+        @publication_announcement_pending = false
+
+        if !previously_published && self.class.exists?(id: id, published: true)
+          AnnouncePublicationJob.perform_later self
+        end
+      end
+
+      self.class.current_transaction.after_rollback do
+        @publication_announcement_pending = false
+      end
     end
 end
