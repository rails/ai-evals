index 0000000..43d2797
--- /dev/null
+++ b/test/integration/raised_exceptions_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class RaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "raises on the first request and renders after returning the block result" do
+    result = with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+      :block_result
+    end
+
+    assert_equal :block_result, result
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "raises after a rendered request without changing shared application defaults" do
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+    env_config = Rails.application.env_config.dup
+    show_exceptions = Rails.application.config.action_dispatch.show_exceptions
+
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+      assert_equal env_config, Rails.application.env_config
+      assert_equal show_exceptions, Rails.application.config.action_dispatch.show_exceptions
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "renders after a controller exception escapes the block" do
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "nested blocks preserve the outer scope on normal and exceptional exits" do
+    with_raised_exceptions do
+      with_raised_exceptions do
+        assert_raises ActiveRecord::RecordNotFound do
+          get book_slug_path(books(:manual))
+        end
+      end
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+
+      assert_raises ActiveRecord::RecordNotFound do
+        with_raised_exceptions do
+          get book_slug_path(books(:manual))
+        end
+      end
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "reset and additional sessions obey the current block rather than their creation scope" do
+    existing_session = open_session
+    new_session = nil
+    path = book_slug_path(books(:manual))
+
+    with_raised_exceptions do
+      reset!
+      assert_raises(ActiveRecord::RecordNotFound) { get path }
+      assert_raises(ActiveRecord::RecordNotFound) { existing_session.get path }
+      new_session = open_session
+      assert_raises(ActiveRecord::RecordNotFound) { new_session.get path }
+    end
+
+    [ self, existing_session, new_session ].each do |session|
+      session.get path
+      session.assert_response :not_found
+    end
+  end
+
+  test "a concurrent caller does not change another test's exception handling" do
+    entered = Queue.new
+    release = Queue.new
+    caller = Thread.new do
+      with_raised_exceptions do
+        entered << true
+        release.pop
+      end
+    end
+
+    entered.pop
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  ensure
+    release << true
+    caller&.value
+  end
+end
