diff --git a/test/test_helpers/raised_exceptions_test_helper.rb b/test/test_helpers/raised_exceptions_test_helper.rb
new file mode 100644
index 0000000..34ec879
--- /dev/null
+++ b/test/test_helpers/raised_exceptions_test_helper.rb
@@ -0,0 +1,26 @@
+module RaisedExceptionsTestHelper
+  EXECUTION_KEY = :writebook_test_raised_exceptions
+
+  # Thread.current[] is fiber-local: concurrent callers are isolated, and the
+  # scope survives the executor's per-request reset of CurrentAttributes.
+  def with_raised_exceptions
+    previous = Thread.current[EXECUTION_KEY]
+    Thread.current[EXECUTION_KEY] = true
+    yield
+  ensure
+    Thread.current[EXECUTION_KEY] = previous
+  end
+
+  class Middleware
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      # Rails merges its memoized env_config before entering the middleware stack.
+      # Override only this request, never the defaults shared by other tests.
+      env["action_dispatch.show_exceptions"] = :none if Thread.current[EXECUTION_KEY]
+      @app.call(env)
+    end
+  end
+end
