diff --git a/db/migrate/20251007220000_create_tenants.rb b/db/migrate/20251007220000_create_tenants.rb
new file mode 100644
index 0000000..dc27bee
--- /dev/null
+++ b/db/migrate/20251007220000_create_tenants.rb
@@ -0,0 +1,30 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    # Sweep every existing user and book into a single tenant, so installs
+    # that are already running upgrade in place without losing access to
+    # anything they had before.
+    say_with_time "Sweeping existing users and books into one tenant" do
+      execute "INSERT INTO tenants (name, created_at, updated_at) VALUES ('Default', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)"
+      tenant_id = select_value("SELECT id FROM tenants ORDER BY id DESC LIMIT 1").to_i
+
+      execute "UPDATE users SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+      execute "UPDATE books SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+    end
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+
+    drop_table :tenants
+  end
+end
