diff --git a/test/integration/tenancy_test.rb b/test/integration/tenancy_test.rb
new file mode 100644
index 0000000..70a40c7
--- /dev/null
+++ b/test/integration/tenancy_test.rb
@@ -0,0 +1,193 @@
+require "test_helper"
+
+class TenancyTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    @alice = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456", tenant: @tenant_a)
+    @bob   = User.create!(name: "Bobby", email_address: "bobby@example.com", password: "secret123456", tenant: @tenant_b)
+
+    @book_a = Book.create!(title: "Customer A Handbook", tenant: @tenant_a)
+    @book_a.update_access(editors: [ @alice.id ], readers: [])
+
+    @book_b = Book.create!(title: "Customer B Handbook", everyone_access: false, tenant: @tenant_b)
+    @book_b.update_access(editors: [ @bob.id ], readers: [])
+
+    @leaf_b = @book_b.press(Page.new(body: "customer b secrets v1"), title: "Secret plans")
+    @leaf_b.edit leafable_params: { body: "customer b secrets v2" }
+  end
+
+  test "another tenant's books are gone from the library, published or not" do
+    sign_in @alice
+
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Customer A Handbook"
+    assert_select "h2", text: "Customer B Handbook", count: 0
+
+    @book_b.update!(published: true)
+
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Customer B Handbook", count: 0
+  end
+
+  test "another tenant's book answers 404 wherever it is asked for" do
+    sign_in @alice
+
+    get book_slug_url(@book_b)
+    assert_response :not_found
+
+    get edit_book_url(@book_b)
+    assert_response :not_found
+
+    patch book_url(@book_b), params: { book: { title: "Renamed by intruder" } }
+    assert_response :not_found
+
+    delete book_url(@book_b)
+    assert_response :not_found
+
+    get book_publication_url(@book_b)
+    assert_response :not_found
+
+    patch book_publication_url(@book_b), params: { book: { published: true } }
+    assert_response :not_found
+
+    get book_bookmark_url(@book_b)
+    assert_response :not_found
+
+    post book_search_url(@book_b), params: { search: "secrets" }
+    assert_response :not_found
+  end
+
+  test "pages inside another tenant's book answer 404" do
+    sign_in @alice
+
+    get leafable_slug_url(@leaf_b)
+    assert_response :not_found
+
+    get edit_book_page_url(@book_b, @leaf_b)
+    assert_response :not_found
+
+    patch book_page_url(@book_b, @leaf_b), params: { page: { body: "Defaced" } }
+    assert_response :not_found
+
+    delete book_page_url(@book_b, @leaf_b)
+    assert_response :not_found
+  end
+
+  test "edit histories inside another tenant's book answer 404, even holding an access row" do
+    # Sharing with everyone used to spray reader rows across the whole install.
+    Access.create!(user: @alice, book: @book_b, level: :reader)
+
+    sign_in @alice
+
+    get page_edit_url(@leaf_b, @leaf_b.edits.last)
+    assert_response :not_found
+
+    get page_edit_url(@leaf_b, "latest")
+    assert_response :not_found
+  end
+
+  test "a sprayed access row buys no way into another tenant's book and the session survives" do
+    Access.create!(user: @alice, book: @book_b, level: :reader)
+
+    sign_in @alice
+
+    get root_url
+    assert_select "h2", text: "Customer B Handbook", count: 0
+
+    get book_slug_url(@book_b)
+    assert_response :not_found
+
+    get leafable_slug_url(@leaf_b)
+    assert_response :not_found
+
+    # They stay signed in throughout, and their own tenant keeps working.
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Customer A Handbook"
+    assert cookies[:session_token].present?
+  end
+
+  test "inside a tenant everything keeps working" do
+    sign_in @bob
+
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Customer B Handbook"
+
+    get book_slug_url(@book_b)
+    assert_response :success
+
+    get leafable_slug_url(@leaf_b)
+    assert_response :success
+
+    get page_edit_url(@leaf_b, @leaf_b.edits.last)
+    assert_response :success
+    assert_match "customer b secrets v1", response.body
+  end
+
+  test "sharing with everyone only sprays reader rows inside the book's tenant" do
+    charlie = User.create!(name: "Charlie", email_address: "charlie@example.com", password: "secret123456", tenant: @tenant_b)
+
+    @book_b.update_access(editors: [ @bob.id ], readers: [])
+
+    assert_not @book_b.everyone_access?
+    @book_b.update!(everyone_access: true)
+    @book_b.update_access(editors: [ @bob.id ], readers: [])
+
+    assert @book_b.accessable?(user: charlie)
+    assert_not @book_b.accessable?(user: @alice)
+  end
+
+  test "new users only get reader rows for everyone-books they share a tenant with" do
+    carol = User.create!(name: "Carol", email_address: "carol@example.com", password: "secret123456", tenant: @tenant_b)
+
+    assert carol.books.include?(books(:handbook)), "tenantless books behave as they do today"
+    assert_not carol.books.include?(@book_b), "book B is not shared with everyone"
+
+    @book_b.update!(everyone_access: true)
+    dave = User.create!(name: "Dave", email_address: "dave@example.com", password: "secret123456", tenant: @tenant_b)
+
+    assert dave.books.include?(@book_b)
+    assert_not dave.books.include?(@book_a)
+  end
+
+  test "new books land in their creator's tenant" do
+    sign_in @alice
+
+    post books_url, params: { book: { title: "Alice's Field Guide" } }
+
+    assert_equal @tenant_a, Book.find_by!(title: "Alice's Field Guide").tenant
+  end
+
+  test "signed-out visitors see every published book, whatever tenant it belongs to" do
+    @book_a.update!(published: true)
+    @book_b.update!(published: true)
+
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Customer A Handbook"
+    assert_select "h2", text: "Customer B Handbook"
+
+    get book_slug_url(@book_b)
+    assert_response :success
+
+    get leafable_slug_url(@leaf_b)
+    assert_response :success
+
+    post book_search_url(@book_b), params: { search: "secrets" }
+    assert_response :success
+  end
+
+  test "users page still names everyone on the install" do
+    sign_in @alice
+
+    get users_url
+    assert_response :success
+    assert_match "Bobby", response.body
+    assert_match "Kevin", response.body
+  end
+end
