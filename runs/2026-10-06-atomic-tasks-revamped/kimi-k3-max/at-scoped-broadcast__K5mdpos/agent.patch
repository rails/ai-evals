diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..1cb34b4 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,28 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors are the users who can edit the book" do
+    book = books(:handbook)
+
+    # users with editor access
+    assert_includes book.editors, users(:kevin)
+
+    # administrators, even without an access of their own
+    book.accesses.find_by!(user: users(:david)).destroy!
+    assert_includes book.editors, users(:david)
+
+    # but not readers
+    assert_not_includes book.editors, users(:jz)
+
+    # nor collaborators removed from the book
+    book.accesses.find_by!(user: users(:kevin)).destroy!
+    assert_not_includes book.editors, users(:kevin)
+  end
+
+  test "editors does not include deactivated users" do
+    users(:kevin).deactivate
+
+    assert_not_includes books(:handbook).editors, users(:kevin)
+  end
 end
