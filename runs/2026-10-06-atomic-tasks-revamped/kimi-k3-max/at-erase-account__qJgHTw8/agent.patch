@@ -1,6 +1,13 @@
 class User < ApplicationRecord
   include Authoring, Role, Transferable
 
+  # Byline left on books shared with everyone whose creator has been erased.
+  DELETED_AUTHOR_BYLINE = "Deleted author"
+
+  # People "removed" the old way were deactivated and had their email scrambled:
+  # alice@example.com became alice-deactivated-<uuid>@example.com.
+  DEACTIVATED_EMAIL_PATTERN = /-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?=@)/
+
   has_many :sessions, dependent: :destroy
   has_secure_password validations: false
 
@@ -17,16 +24,45 @@ class User < ApplicationRecord
     self == Current.user
   end
 
-  def deactivate
+  # Erases every trace of the person: their user row, sessions, book accesses,
+  # reading marks, and sign-in history — including history recorded under the
+  # original email address of accounts deactivated the old way.
+  #
+  # Books they created that are shared with everyone keep working for the people
+  # reading them, but are anonymized: unlinked from the user and bylined
+  # "Deleted author". Their other books are destroyed outright, which also drops
+  # their leaves from the search index.
+  def erase
     transaction do
-      sessions.delete_all
-      update! active: false, email_address: deactived_email_address
+      anonymize_books_shared_with_everyone
+      sessions.destroy_all
+      erase_sign_in_events
+      destroy!
     end
   end
 
   private
-    def deactived_email_address
-      email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
+    def anonymize_books_shared_with_everyone
+      created_books.with_everyone_access.update_all \
+        creator_id: nil, author: DELETED_AUTHOR_BYLINE, updated_at: Time.current
+
+      # Drop any stale in-memory target so destroying the user only cascades
+      # to the books that still belong to them.
+      created_books.reset
+    end
+
+    def erase_sign_in_events
+      SignInEvent.where(email_address: sign_in_email_addresses).delete_all
+    end
+
+    # Sign-in events are keyed by email address, and the sign-ins of someone
+    # deactivated the old way sit under the address they actually signed in with.
+    def sign_in_email_addresses
+      [ email_address ].tap do |addresses|
+        while (unscrambled = addresses.last.sub(DEACTIVATED_EMAIL_PATTERN, "")) != addresses.last
+          addresses << unscrambled
+        end
+      end.uniq
     end
 
     def grant_access_to_everyone_books
