diff --git a/test/integration/user_erasure_test.rb b/test/integration/user_erasure_test.rb
new file mode 100644
index 0000000..4aefc73
--- /dev/null
+++ b/test/integration/user_erasure_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class UserErasureTest < ActionDispatch::IntegrationTest
+  test "book shared with everyone keeps rendering after its creator is erased" do
+    kevin = users(:kevin)
+    book = Book.create!(title: "Shared book", author: "Kevin", everyone_access: true, published: true, creator: kevin)
+    book.press(Page.new(body: "still readable content"), title: "Shared page")
+    Leaf.reindex_all
+
+    sign_in :david
+    delete user_path(kevin)
+    assert_redirected_to users_path
+
+    # Kevin is gone from the people page entirely
+    get users_path
+    assert_not_in_body "Kevin"
+
+    # Anonymous readers can still read the book, bylined "Deleted author"
+    sign_out
+    get book_slug_path(book)
+    assert_response :success
+    assert_in_body "Deleted author"
+    assert_not_in_body "Kevin"
+
+    # ... and still find its content through search
+    post book_search_path(book), params: { search: "readable content" }
+    assert_response :success
+    assert_in_body "Shared page"
+  end
+end
diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..39df04b
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+
+    @shared_book = Book.create!(title: "Kevin shared book", author: "Kevin", everyone_access: true, creator: @user)
+    @shared_book.press(Page.new(body: "kevin shared content"), title: "Kevin shared page")
+    @shared_book.update_access(editors: [ users(:david).id ], readers: [ users(:david).id ])
+
+    @private_book = Book.create!(title: "Kevin private book", author: "Kevin", everyone_access: false, creator: @user)
+    @private_book.press(Page.new(body: "kevin private content"), title: "Kevin private page")
+
+    @user.sessions.start!(user_agent: "test", ip_address: "1.2.3.4")
+    ReadingMark.remember(leaves(:welcome_page), user: @user)
+
+    Leaf.reindex_all
+  end
+
+  test "erase removes the user row entirely" do
+    assert_difference -> { User.count }, -1 do
+      @user.erase
+    end
+
+    assert_not User.exists?(@user.id)
+    assert_equal 0, User.where(name: "Kevin").count
+    assert_equal 0, User.where("email_address LIKE ?", "%kevin%").count
+  end
+
+  test "erase removes their sessions, accesses, and reading marks" do
+    @user.erase
+
+    assert_equal 0, Session.where(user_id: @user.id).count
+    assert_equal 0, Access.where(user_id: @user.id).count
+    assert_equal 0, ReadingMark.where(user_id: @user.id).count
+  end
+
+  test "erase removes their sign-in history" do
+    assert SignInEvent.for_address(@user.email_address).exists?
+
+    @user.erase
+
+    assert_equal 0, SignInEvent.for_address("kevin@example.com").count
+    assert_equal 0, SignInEvent.count
+  end
+
+  test "erase destroys books that are not shared with everyone, including search hits" do
+    assert_equal 1, Leaf.search("kevin private").size
+
+    @user.erase
+
+    assert_not Book.exists?(@private_book.id)
+    assert_equal 0, Leaf.search("kevin private").size
+  end
+
+  test "erase keeps books shared with everyone, anonymized and bylined Deleted author" do
+    @user.erase
+
+    assert @shared_book.reload
+    assert_nil @shared_book.creator_id
+    assert_equal User::DELETED_AUTHOR_BYLINE, @shared_book.author
+    assert_equal "Deleted author", @shared_book.author
+  end
+
+  test "books shared with everyone keep working for the people reading them" do
+    @user.erase
+
+    assert @shared_book.reload.accessable?(user: users(:david))
+    assert_equal 1, Leaf.search("kevin shared").size
+    assert_equal 1, @shared_book.leaves.count
+  end
+
+  test "erase works when created books were already loaded" do
+    @user.created_books.load
+
+    @user.erase
+
+    assert Book.exists?(@shared_book.id)
+    assert_not Book.exists?(@private_book.id)
+  end
+
+  test "erase works for people deactivated the old way and removes sign-in history under their original address" do
+    SignInEvent.create!(action: :signed_in, email_address: "kevin@example.com", ip_address: "4.3.2.1")
+    deactivate_the_old_way(@user)
+
+    assert_nothing_raised { @user.erase }
+
+    assert_not User.exists?(@user.id)
+    assert_equal 0, SignInEvent.for_address("kevin@example.com").count
+    assert_equal 0, SignInEvent.count
+  end
+
+  test "erase removes sign-in history for addresses deactivated more than once" do
+    SignInEvent.create!(action: :signed_in, email_address: "kevin@example.com", ip_address: "4.3.2.1")
+    deactivate_the_old_way(@user)
+    deactivate_the_old_way(@user)
+
+    @user.erase
+
+    assert_equal 0, SignInEvent.for_address("kevin@example.com").count
+    assert_equal 0, SignInEvent.count
+  end
+
+  private
+    def deactivate_the_old_way(user)
+      user.sessions.delete_all
+      user.update! active: false, email_address: user.email_address.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
+    end
+end
