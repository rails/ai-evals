diff --git a/app/models/book/accessable.rb b/app/models/book/accessable.rb
index aa3dcf1..a73a4f8 100644
--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -32,6 +32,13 @@ module Book::Accessable
     accesses.find_by(user: user)
   end
 
+  # Users who can currently edit this book, mirroring #editable?: those with
+  # editor-level access plus administrators. Presence broadcasts are addressed
+  # to these users individually so removed collaborators stop receiving them.
+  def editors
+    User.active.where(id: accesses.editor.select(:user_id)).or(User.active.administrator)
+  end
+
   def update_access(editors:, readers:)
     editors = Set.new(editors)
     readers = Set.new(everyone_access? ? User.active.ids : readers)
