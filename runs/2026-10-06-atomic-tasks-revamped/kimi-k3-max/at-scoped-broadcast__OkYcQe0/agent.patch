@@ -40,4 +40,31 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "editors includes users with editor access and administrators" do
+    editors = books(:handbook).editors
+
+    assert_includes editors, users(:kevin) # member with editor access
+    assert_includes editors, users(:david) # administrator with editor access
+    assert_includes editors, users(:jason) # administrator with editor access
