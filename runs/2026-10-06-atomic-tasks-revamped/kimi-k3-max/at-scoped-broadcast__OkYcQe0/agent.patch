diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..700ea4e 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -1,6 +1,9 @@
 require "test_helper"
 
 class LeafablesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+  include Turbo::Streams::StreamName
+
   setup do
     sign_in :kevin
   end
@@ -117,4 +120,87 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "edit subscribes to the being-edited stream for the current editor only" do
+    leaf = leaves(:welcome_page)
+
+    get edit_leafable_path(leaf)
+    assert_response :ok
+
+    own_stream = Turbo::StreamsChannel.signed_stream_name([ users(:kevin), leaf, :being_edited ])
+    assert_select %(turbo-cable-stream-source[signed-stream-name="#{own_stream}"]), count: 1
+
+    public_stream = Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited ])
+    assert_select %(turbo-cable-stream-source[signed-stream-name="#{public_stream}"]), count: 0
+  end
+
+  test "update broadcasts being-edited indicator to each current editor's own stream" do
+    leaf = leaves(:welcome_page)
+    clear_enqueued_jobs
+
+    put leafable_path(leaf), params: { page: { body: "With even more interesting words." } }
+    assert_response :no_content
+
+    stream_names = being_edited_broadcast_stream_names
+    assert_includes stream_names, stream_name_from([ users(:kevin), leaf, :being_edited ])
+    assert_includes stream_names, stream_name_from([ users(:david), leaf, :being_edited ])
+    assert_includes stream_names, stream_name_from([ users(:jason), leaf, :being_edited ])
+  end
+
+  test "update does not broadcast being-edited indicator on streams a removed collaborator can listen on" do
+    leaf = leaves(:welcome_page)
+    clear_enqueued_jobs
+
+    put leafable_path(leaf), params: { page: { body: "With even more interesting words." } }
+    assert_response :no_content
+
+    stream_names = being_edited_broadcast_stream_names
+
+    # Never on the public per-leaf stream, which removed collaborators remain subscribed to
+    assert_not_includes stream_names, stream_name_from([ leaf, :being_edited ])
+
+    # Nor on the stream of a user who cannot edit the book
+    assert_not_includes stream_names, stream_name_from([ users(:jz), leaf, :being_edited ])
+  end
+
+  test "collaborator removed from the book stops receiving being-edited broadcasts" do
+    leaf = leaves(:welcome_page)
+    books(:handbook).accesses.where(user: users(:kevin)).delete_all
+
+    sign_out
+    sign_in :david
+    clear_enqueued_jobs
+
+    put leafable_path(leaf), params: { page: { body: "Edited after Kevin was removed." } }
+    assert_response :no_content
+
+    stream_names = being_edited_broadcast_stream_names
+    assert_not_includes stream_names, stream_name_from([ users(:kevin), leaf, :being_edited ])
+    assert_includes stream_names, stream_name_from([ users(:david), leaf, :being_edited ])
+  end
+
+  test "editor demoted to reader through book access update stops receiving being-edited broadcasts" do
+    leaf = leaves(:welcome_page)
+
+    # This is how the book settings form updates access; with everyone access,
+    # Kevin is demoted to reader rather than removed outright.
+    books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [])
+
+    sign_out
+    sign_in :david
+    clear_enqueued_jobs
+
+    put leafable_path(leaf), params: { page: { body: "Edited after Kevin was demoted." } }
+    assert_response :no_content
+
+    stream_names = being_edited_broadcast_stream_names
+    assert_equal :reader, books(:handbook).access_for(user: users(:kevin)).level.to_sym
+    assert_not_includes stream_names, stream_name_from([ users(:kevin), leaf, :being_edited ])
+    assert_includes stream_names, stream_name_from([ users(:jason), leaf, :being_edited ])
+  end
+
+  private
+    def being_edited_broadcast_stream_names
+      enqueued_jobs.select { _1[:job] == Turbo::Streams::BroadcastJob }.map { _1[:args].first }
+    end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
