+  test "editors includes administrators without explicit access" do
+    books(:handbook).accesses.where(user: users(:david)).delete_all
+
+    assert_includes books(:handbook).editors, users(:david)
+  end
+
+  test "editors excludes collaborators removed from the book" do
+    books(:handbook).accesses.where(user: users(:kevin)).delete_all
+
+    assert_not_includes books(:handbook).editors, users(:kevin)
+  end
+
+  test "editors excludes deactivated users" do
+    users(:kevin).deactivate
+
+    assert_not_includes books(:handbook).editors, users(:kevin)
+  end
 end
