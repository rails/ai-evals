diff --git a/config/environments/development.rb b/config/environments/development.rb
index e1c3d90..ffc783c 100644
--- a/config/environments/development.rb
+++ b/config/environments/development.rb
@@ -42,6 +42,14 @@ Rails.application.configure do
   # Print deprecation notices to the Rails logger.
   config.active_support.deprecation = :log
 
+  # Show logs on the terminal as well as in log/development.log, so runbook
+  # commands like `bin/rails runner script/library_report.rb` print their
+  # output while the log tooling still reads every line from the log file.
+  config.logger = ActiveSupport::BroadcastLogger.new(
+    ActiveSupport::Logger.new(config.default_log_file),
+    ActiveSupport::Logger.new(STDOUT)
+  ).tap { |logger| logger.formatter = config.log_formatter }
+
   # Raise exceptions for disallowed deprecations.
   config.active_support.disallowed_deprecation = :raise
 
