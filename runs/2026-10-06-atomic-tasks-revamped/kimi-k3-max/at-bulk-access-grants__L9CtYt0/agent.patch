diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..5ef2ec7
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,133 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    clear_enqueued_jobs
+    clear_performed_jobs
+    @book = Book.create!(title: "Import target", everyone_access: false)
+    @users = (1..20).map { |i| User.create!(name: "Import User #{i}", email_address: "import#{i}@example.com", password: "secret123456") }
+  end
+
+  test "import grants access to each user and notifies them" do
+    grants = grants_for(@users.first(4))
+
+    result = nil
+    assert_enqueued_jobs 4, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal 4, result.accesses.size
+    assert_equal @users.first(4).map(&:id), result.accesses.map(&:user_id)
+    assert result.accesses.all? { |access| access.reader? && access.persisted? }
+  end
+
+  test "write round trips do not grow with roster size" do
+    small = count_statements { Book::AccessImport.new(@book, grants_for(@users.first(4))).import }
+    large = count_statements { Book::AccessImport.new(@book, grants_for(@users.last(16))).import }
+
+    assert_equal small, large, "4 grants took #{small} writes, 16 grants took #{large} writes"
+  end
+
+  test "write round trips do not grow with roster size when the roster is rejected" do
+    @book.accesses.create!(user: @users.last, level: :reader)
+
+    small = count_statements do
+      Book::AccessImport.new(@book, grants_for(@users.first(2)) + [ { user_id: @users.last.id, level: "reader" } ]).import
+    end
+    large = count_statements do
+      Book::AccessImport.new(@book, grants_for(@users.first(14)) + [ { user_id: @users.last.id, level: "reader" } ]).import
+    end
+
+    assert_equal small, large, "3 grants took #{small} writes, 15 grants took #{large} writes"
+  end
+
+  test "duplicate grant rejects the whole roster and notifies no one" do
+    @book.accesses.create!(user: @users.first, level: :reader)
+    grants = grants_for(@users[1..3]) + [ { user_id: @users.first.id, level: "editor" } ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 3, result.duplicate_index
+    assert_equal [ @users.first.id ], @book.accesses.pluck(:user_id)
+  end
+
+  test "grant repeated within the roster rejects the whole roster" do
+    grants = grants_for(@users.first(2)) + [ { user_id: @users.first.id, level: "editor" } ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal [], result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "unknown level rejects the roster instead of blowing up" do
+    grants = grants_for(@users.first(2)) + [ { user_id: @users[2].id, level: "overlord" } ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "string user ids are honoured like integer ids" do
+    @book.accesses.create!(user: @users.first, level: :reader)
+
+    result = Book::AccessImport.new(@book, [ { user_id: @users.first.id.to_s, level: "editor" } ]).import
+
+    assert_equal [], result.accesses
+    assert_equal 0, result.duplicate_index
+
+    result = Book::AccessImport.new(@book, [ { user_id: @users[1].id.to_s, level: "editor" } ]).import
+
+    assert_nil result.duplicate_index
+    assert_equal [ @users[1].id ], result.accesses.map(&:user_id)
+    assert result.accesses.first.editor?
+  end
+
+  test "conflict raised while inserting is reported as a rejection" do
+    book, racing_user = @book, @users.first
+    racing_accesses = @book.accesses
+    racing_accesses.define_singleton_method(:insert_all!) do |*|
+      Access.create!(user: racing_user, book: book, level: :reader)
+      raise ActiveRecord::RecordNotUnique
+    end
+    @book.define_singleton_method(:accesses) { racing_accesses }
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants_for(@users.first(2))).import
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 0, result.duplicate_index
+    assert_equal [ @users.first.id ], @book.reload.accesses.pluck(:user_id)
+  end
+
+  private
+    def grants_for(users, level: "reader")
+      users.map { |user| { user_id: user.id, level: level } }
+    end
+
+    def count_statements
+      statements = 0
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+        statements += 1 if payload[:sql] =~ /\A\s*(INSERT|UPDATE|DELETE)/i && payload[:name] != "SCHEMA"
+      end
+      yield
+      statements
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+end
