diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..452ca81
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,146 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    clear_enqueued_jobs
+    clear_performed_jobs
+  end
+
+  test "grants access and notifies each person on the roster" do
+    book = fresh_book
+    readers = create_users(2)
+    editors = create_users(1)
+
+    result = Book::AccessImport.new(book, grants_for(readers, :reader) + grants_for(editors, :editor)).import
+
+    assert_nil result.duplicate_index
+    assert_equal (readers + editors).map(&:id), result.accesses.map(&:user_id)
+    assert_equal %w[ reader reader editor ], result.accesses.map(&:level)
+    assert result.accesses.all?(&:persisted?)
+    assert_enqueued_jobs 3, only: Book::AccessNotificationJob
+  end
+
+  test "sixteen names cost what four do" do
+    small_book, small_roster = fresh_book, grants_for(create_users(4), :reader)
+    large_book, large_roster = fresh_book, grants_for(create_users(16), :reader)
+
+    small = count_queries { Book::AccessImport.new(small_book, small_roster).import }
+    large = count_queries { Book::AccessImport.new(large_book, large_roster).import }
+
+    assert_equal small, large
+  end
+
+  test "sixteen names cost what four do when the sheet is turned down" do
+    book = fresh_book
+    stowaway = create_user
+    book.accesses.create!(user: stowaway, level: :reader)
+
+    small_roster = grants_for(create_users(3), :reader) + [ { user_id: stowaway.id, level: "reader" } ]
+    large_roster = grants_for(create_users(15), :reader) + [ { user_id: stowaway.id, level: "reader" } ]
+
+    small = count_queries { Book::AccessImport.new(book, small_roster).import }
+    large = count_queries { Book::AccessImport.new(book, large_roster).import }
+
+    assert_equal small, large
+  end
+
+  test "duplicate roster is turned down without granting or notifying" do
+    book = fresh_book
+    book.accesses.create!(user: users(:kevin), level: :editor)
+    newcomer = create_user
+
+    result = Book::AccessImport.new(book, [
+      { user_id: newcomer.id, level: "reader" },
+      { user_id: users(:kevin).id, level: "reader" }
+    ]).import
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_not book.accessable?(user: newcomer)
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "roster duplicating itself is turned down without notifying" do
+    book = fresh_book
+    user = create_user
+
+    result = Book::AccessImport.new(book, [
+      { user_id: user.id, level: "reader" },
+      { user_id: user.id, level: "editor" }
+    ]).import
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_not book.accessable?(user: user)
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "roster naming an unknown level is turned down instead of blowing up" do
+    book = fresh_book
+    user = create_user
+
+    result = Book::AccessImport.new(book, [ { user_id: user.id, level: "owner" } ]).import
+
+    assert_equal [], result.accesses
+    assert_equal 0, result.duplicate_index
+    assert_not book.accessable?(user: user)
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "unknown level partway through turns down the whole sheet" do
+    book = fresh_book
+    good = create_user
+    bad = create_user
+
+    result = Book::AccessImport.new(book, [
+      { user_id: good.id, level: "editor" },
+      { user_id: bad.id, level: "boss" }
+    ]).import
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_not book.accessable?(user: good)
+    assert_not book.accessable?(user: bad)
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob
+  end
+
+  test "empty roster" do
+    result = Book::AccessImport.new(fresh_book, []).import
+
+    assert_equal [], result.accesses
+    assert_nil result.duplicate_index
+  end
+
+  private
+    def fresh_book
+      Book.create!(title: "Fresh #{SecureRandom.hex(4)}", everyone_access: false)
+    end
+
+    def create_user
+      User.create!(
+        name: "Importee #{SecureRandom.hex(4)}",
+        email_address: "#{SecureRandom.hex(8)}@example.com",
+        password: "secret123456")
+    end
+
+    def create_users(count)
+      Array.new(count) { create_user }
+    end
+
+    def grants_for(users, level)
+      users.map { |user| { user_id: user.id, level: level } }
+    end
+
+    def count_queries(&block)
+      queries = 0
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+        queries += 1 unless payload[:cached] || payload[:name] =~ /\A(SCHEMA|TRANSACTION)/
+      end
+      block.call
+      queries
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+end
