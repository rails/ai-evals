@@ -0,0 +1,52 @@
+require "test_helper"
+
+class PageUploadLifecycleTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "upload, fetch, destroy page, image fully purged" do
+    # 1. Upload an image into the page's markdown, like an editor dropping it in
+    assert_changes -> { ActiveStorage::Attachment.count }, 1 do
+      post action_text_markdown_uploads_path, params: {
+        record_gid: pages(:welcome).to_signed_global_id.to_s,
+        attribute_name: "body",
+        file: fixture_file_upload("reading.webp", "image/webp")
+      }, as: :xhr
+    end
+    assert_response :created
+
+    file_url = JSON.parse(response.body)["fileUrl"]
+    assert file_url.start_with?("/"), "expected a relative URL for the upload"
+
+    attachment = ActiveStorage::Attachment.order(:id).last
+    blob = attachment.blob
+    file_path = blob.service.path_for(blob.key)
+    assert File.exist?(file_path), "expected the uploaded file on disk"
+
+    # 2. Fetch the image back from the URL the app handed us
+    get file_url
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal blob.download, response.body, "expected to get the uploaded image bytes back"
+
+    # 3. Destroy the page and run any background work the destruction enqueues
+    pages(:welcome).destroy
+    perform_enqueued_jobs
+
+    # 4. Neither the file nor the record tracking it may survive
+    assert_not ActiveStorage::Attachment.exists?(attachment.id), "attachment record should be gone"
+    assert_not ActiveStorage::Blob.exists?(blob.id), "blob record should be gone"
+    assert_not File.exist?(file_path), "uploaded file should be gone from disk"
+  end
+
+  test "destroying a page without uploads still works and enqueues no purge" do
+    assert_no_difference -> { ActiveStorage::Blob.count } do
+      pages(:welcome).destroy
+      perform_enqueued_jobs
+    end
+  end
+end
