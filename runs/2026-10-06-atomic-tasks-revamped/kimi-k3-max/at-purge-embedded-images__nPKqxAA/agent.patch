@@ -0,0 +1,47 @@
+require "test_helper"
+
+class PageUploadPurgeTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a page purges its markdown uploads after background jobs run" do
+    page = pages(:welcome)
+    markdown = page.body
+    markdown.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    markdown.save!
+
+    attachment = markdown.uploads.attachments.last
+    blob = attachment.blob
+    file_path = blob.service.path_for(blob.key)
+
+    assert File.exist?(file_path), "expected uploaded file to exist on disk"
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert ActiveStorage::Attachment.exists?(attachment.id)
+
+    page.destroy
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id), "attachment record should be gone"
+    assert_not ActiveStorage::Blob.exists?(blob.id), "blob record should be gone"
+    assert_not File.exist?(file_path), "uploaded file should be gone from disk"
+  end
+
+  test "destroying a book purges uploads of its pages after background jobs run" do
+    page = pages(:welcome)
+    markdown = page.body
+    markdown.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    markdown.save!
+
+    attachment = markdown.uploads.attachments.last
+    blob = attachment.blob
+    file_path = blob.service.path_for(blob.key)
+
+    assert File.exist?(file_path)
+
+    books(:handbook).destroy
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id), "attachment record should be gone"
+    assert_not ActiveStorage::Blob.exists?(blob.id), "blob record should be gone"
+    assert_not File.exist?(file_path), "uploaded file should be gone from disk"
+  end
+end
