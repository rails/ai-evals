@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @book = books(:manual)
+
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+
+    sign_in :david
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "releasing a book lists it under its final title in recently updated" do
+    patch book_release_path(@book), params: { book: { title: "The Finer Points of Sailing", subtitle: "A Field Guide" } }
+
+    assert_redirected_to root_path
+
+    @book.reload
+    assert @book.published?
+    assert_equal "The Finer Points of Sailing", @book.title
+
+    follow_redirect!
+    assert_includes response.body, "Recently updated"
+    assert_includes response.body, "The Finer Points of Sailing"
+    assert_includes response.body, "Published"
+  end
+
+  test "releasing an already published book redirects back to the book" do
+    @book.update! published: true
+
+    patch book_release_path(@book), params: { book: { title: "Too Late" } }
+
+    assert_redirected_to book_slug_path(@book)
+    assert_equal "Manual", @book.reload.title
+  end
+end
diff --git a/test/models/book/release_test.rb b/test/models/book/release_test.rb
new file mode 100644
index 0000000..65c1fad
--- /dev/null
+++ b/test/models/book/release_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Book::ReleaseTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "finalizing a release recaps the final title and published state" do
+    book = books(:manual)
+
+    assert Book.finalize_release(book.id, title: "The Finer Points of Sailing", subtitle: "A Field Guide")
+
+    book.reload
+    assert_equal "The Finer Points of Sailing", book.title
+    assert_equal "A Field Guide", book.subtitle
+    assert book.published?
+
+    recap = book.cached_recap
+    assert_equal "The Finer Points of Sailing", recap[:title]
+    assert_equal true, recap[:published]
+  end
+
+  test "finalizing a release keeps the existing subtitle when none is given" do
+    book = books(:manual)
+    book.update! subtitle: "Existing subtitle"
+
+    assert Book.finalize_release(book.id, title: "Renamed Manual")
+
+    assert_equal "Existing subtitle", book.reload.subtitle
+  end
+
+  test "finalizing a release for an already published book does nothing" do
+    book = books(:manual)
+    book.update! published: true
+
+    assert_not Book.finalize_release(book.id, title: "Too Late")
+
+    assert_equal "Manual", book.reload.title
+  end
+
+  test "recaps are stored per book" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    handbook.update! title: "Handbook, Revised"
+
+    assert_equal "Handbook, Revised", handbook.cached_recap[:title]
+    assert_nil manual.cached_recap
+
+    manual.update! title: "Manual, Revised"
+
+    assert_equal "Handbook, Revised", handbook.cached_recap[:title]
+    assert_equal "Manual, Revised", manual.cached_recap[:title]
+  end
+
+  test "recaps expire on the configured schedule" do
+    book = books(:manual)
+    book.update! title: "Manual, Revised"
+
+    assert_not_nil book.cached_recap
+
+    travel Rails.application.config.x.recap.expires_in + 1.minute do
+      assert_nil book.cached_recap
+    end
+  end
+end
