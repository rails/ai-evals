diff --git a/test/integration/show_exceptions_control_test.rb b/test/integration/show_exceptions_control_test.rb
new file mode 100644
index 0000000..85f9d5b
--- /dev/null
+++ b/test/integration/show_exceptions_control_test.rb
@@ -0,0 +1,28 @@
+require "test_helper"
+
+class ShowExceptionsControlTest < ActionDispatch::IntegrationTest
+  test "with_raised_exceptions raises inside the block and renders outside it, regardless of what ran before" do
+    # First request of the test happens inside the block: the controller error
+    # must reach the test as the raised exception...
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_url(books(:manual))
+      end
+    end
+
+    # ...and right after the block, error pages must render like normal.
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+
+    # Raising must work again even after requests rendered in between.
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_url(books(:manual))
+      end
+    end
+
+    # And rendering must still work after that.
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+  end
+end
diff --git a/test/support/show_exceptions_control.rb b/test/support/show_exceptions_control.rb
new file mode 100644
index 0000000..d5b40cd
--- /dev/null
+++ b/test/support/show_exceptions_control.rb
@@ -0,0 +1,41 @@
+# Controls, per request, whether controller exceptions are raised to the caller
+# or rendered as error pages.
+#
+# The test environment renders rescuable exceptions (404s, etc.) by default
+# via `config.action_dispatch.show_exceptions = :rescuable`. That setting is
+# copied into `Rails.application.env_config`, which is memoized the first time
+# a process serves a request and then merged into every request's env by
+# `Rails::Engine#call`. Toggling the global config from a test helper is
+# therefore unreliable: the change either never takes effect (env_config was
+# already memoized) or leaks into every later request in the process (env_config
+# got memoized while the override was active).
+#
+# Instead of touching global state, `with_raised_exceptions` flags the current
+# thread, and this middleware — registered only in the test environment —
+# applies the override to the env of requests made while the flag is set.
+# Integration tests dispatch requests synchronously on the calling thread, so
+# the override applies exactly to requests issued inside the block, no matter
+# what ran before or runs after in the same process.
+class ShowExceptionsControl
+  ENV_KEY = "action_dispatch.show_exceptions"
+  THREAD_KEY = :show_exceptions_control_override
+
+  def self.with_raised_exceptions
+    Thread.current.thread_variable_set(THREAD_KEY, :none)
+    yield
+  ensure
+    Thread.current.thread_variable_set(THREAD_KEY, nil)
+  end
+
+  def initialize(app)
+    @app = app
+  end
+
+  def call(env)
+    if override = Thread.current.thread_variable_get(THREAD_KEY)
+      env[ENV_KEY] = override
+    end
+
+    @app.call(env)
+  end
+end
