diff --git a/test/controllers/books_toc_caching_test.rb b/test/controllers/books_toc_caching_test.rb
new file mode 100644
index 0000000..e514c92
--- /dev/null
+++ b/test/controllers/books_toc_caching_test.rb
@@ -0,0 +1,120 @@
+require "test_helper"
+
+class BooksTocCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    # Load before swapping cache stores so its rate limiter keeps the null store.
+    SessionsController
+
+    @was_perform_caching = ActionController::Base.perform_caching
+    @old_cache_store = ActionController::Base.cache_store
+    @old_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    cache_store = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.perform_caching = true
+    ActionController::Base.cache_store = cache_store
+    ActionView::PartialRenderer.collection_cache = cache_store
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = @was_perform_caching
+    ActionController::Base.cache_store = @old_cache_store
+    ActionView::PartialRenderer.collection_cache = @old_collection_cache
+  end
+
+  test "reader never sees editor controls, even after an editor viewed the book" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "Edit Welcome to The Handbook!"
+
+    sign_out
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_not_in_body "Edit Welcome to The Handbook!"
+    assert_not_in_body "Add a new text page"
+    assert_not_in_body "Rearrange"
+  end
+
+  test "editor always sees editor controls, even after a reader viewed the book" do
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_not_in_body "Edit Welcome to The Handbook!"
+
+    sign_out
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "Edit Welcome to The Handbook!"
+    assert_in_body "Add a new text page"
+    assert_in_body "Rearrange"
+  end
+
+  test "renamed entry shows its new title to the next person in" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+
+    leaves(:welcome_page).update!(title: "A Whole New Welcome")
+
+    sign_out
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "A Whole New Welcome"
+    assert_not_in_body "Edit Welcome to The Handbook!"
+
+    sign_out
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "A Whole New Welcome"
+    assert_in_body "Edit A Whole New Welcome"
+  end
+
+  test "entry renamed through the editor shows its new title to readers, never editor controls" do
+    sign_in :kevin
+    put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Renamed In Place" }, page: { body: "Fresh words." } }, as: :turbo_stream
+    assert_response :success
+    assert_in_body "Renamed In Place"
+
+    sign_out
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "Renamed In Place"
+    assert_not_in_body "Edit Renamed In Place"
+  end
+
+  test "anonymous visitor of a published book never sees editor controls, even after an editor viewed it" do
+    books(:handbook).update!(published: true)
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "Edit Welcome to The Handbook!"
+
+    sign_out
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Edit Welcome to The Handbook!"
+    assert_not_in_body "Add a new text page"
+  end
+
+  test "administrator without explicit access gets editor controls, even after a reader viewed the book" do
+    books(:handbook).update!(published: true)
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_not_in_body "Edit Welcome to The Handbook!"
+
+    sign_out
+    sign_in :david
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "Edit Welcome to The Handbook!"
+  end
+end
