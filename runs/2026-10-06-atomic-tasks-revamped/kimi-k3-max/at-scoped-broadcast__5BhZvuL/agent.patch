diff --git a/test/controllers/being_edited_indicator_test.rb b/test/controllers/being_edited_indicator_test.rb
new file mode 100644
index 0000000..d910ad1
--- /dev/null
+++ b/test/controllers/being_edited_indicator_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+  include ActionCable::TestHelper
+
+  setup do
+    @book = books(:handbook)
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "update broadcasts the being edited indicator to every editor on their own stream" do
+    sign_in :david
+
+    # david, jason and kevin can all edit the handbook
+    %i[ david jason kevin ].each do |editor|
+      stream = being_edited_stream_for(users(editor), @leaf)
+
+      messages = capture_broadcasts(stream) do
+        perform_enqueued_jobs { update_page }
+      end
+
+      assert messages.any? { |message| message.to_s.include?("David") },
+        "expected #{editor}'s own stream to receive the indicator naming David, got: #{messages.inspect}"
+    end
+  end
+
+  test "update does not broadcast the indicator on a removed collaborator's stream" do
+    removed = users(:kevin)
+    @book.access_for(user: removed).destroy!
+
+    # Kevin's browser still has the editor open from when he had access, so it
+    # is still subscribed to his being-edited stream for this leaf.
+    sign_in :david
+
+    assert_no_broadcasts being_edited_stream_for(removed, @leaf) do
+      perform_enqueued_jobs { update_page }
+    end
+  end
+
+  test "update does not broadcast the indicator on the old shared leaf stream" do
+    sign_in :david
+
+    assert_no_broadcasts Turbo::StreamsChannel.send(:stream_name_from, [ @leaf, :being_edited ]) do
+      perform_enqueued_jobs { update_page }
+    end
+  end
+
+  test "update does not broadcast the indicator to readers" do
+    sign_in :david
+
+    assert_no_broadcasts being_edited_stream_for(users(:jz), @leaf) do
+      perform_enqueued_jobs { update_page }
+    end
+  end
+
+  test "edit subscribes to the current user's own being edited stream" do
+    sign_in :kevin
+
+    get edit_leafable_path(@leaf)
+
+    assert_response :ok
+    assert_select "turbo-cable-stream-source[signed-stream-name=?]",
+      Turbo::StreamsChannel.signed_stream_name([ users(:kevin), @leaf, :being_edited ])
+  end
+
+  private
+    def update_page
+      put leafable_path(@leaf), params: { leaf: { title: "Changed" }, page: { body: "New body." } }
+      assert_response :no_content
+    end
+
+    def being_edited_stream_for(user, leaf)
+      Turbo::StreamsChannel.send(:stream_name_from, [ user, leaf, :being_edited ])
+    end
+end
