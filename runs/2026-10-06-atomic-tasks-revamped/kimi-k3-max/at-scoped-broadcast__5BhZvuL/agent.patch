-        partial: "leaves/being_edited_by", locals: { leaf: @leaf, user: Current.user }
+      # Broadcast to each editor's own stream instead of a stream scoped to
+      # the leaf alone, so collaborators removed from the book stop receiving
+      # these pushes while an editor they opened earlier is still subscribed.
+      @book.editors.each do |editor|
+        Turbo::StreamsChannel.broadcast_render_later_to editor, @leaf, :being_edited,
+          partial: "leaves/being_edited_by", locals: { leaf: @leaf, user: Current.user }
+      end
     end
 end
