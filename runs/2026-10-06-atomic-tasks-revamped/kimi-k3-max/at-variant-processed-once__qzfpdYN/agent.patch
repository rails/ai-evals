--- /dev/null
+++ b/test/integration/picture_derivation_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class PictureDerivationTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  test "picture is derived once when the background job runs before the first read" do
+    picture = upload_picture("reading.webp", "image/webp")
+
+    drain_background_jobs
+    assert_equal 1, derived_state(picture)[:records]
+
+    transforms, served_bytes = open_page_and_fetch_picture(picture.leaf)
+
+    assert_equal 0, transforms, "fetching the picture triggered image processing again"
+    assert_equal 1, derived_state(picture)[:records], "a second variant record was created"
+    assert_equal 1, derived_state(picture)[:files].size, "expected exactly one derived copy in storage"
+    assert_equal stored_derived_bytes(picture), served_bytes, "reader was not served the derived copy"
+  end
+
+  test "picture is derived once when the first read beats the background job" do
+    picture = upload_picture("reading.webp", "image/webp")
+
+    # The reader arrives before the background job had a chance to run. Their
+    # request derives the copy on demand...
+    _, served_bytes = open_page_and_fetch_picture(picture.leaf)
+    assert_equal 1, derived_state(picture)[:records]
+
+    # ...so when the job finally runs, there is nothing left to derive.
+    transforms = count_transforms { drain_background_jobs }
+
+    assert_equal 0, transforms, "background job re-derived the picture"
+    assert_equal 1, derived_state(picture)[:records], "a second variant record was created"
+    assert_equal 1, derived_state(picture)[:files].size, "expected exactly one derived copy in storage"
+    assert_equal stored_derived_bytes(picture), served_bytes, "reader was not served the derived copy"
+  end
+
+  test "picture is derived once whatever the source format" do
+    picture = upload_picture(Rails.root.join("app/assets/images/demo/writebook-manual.jpg"), "image/jpeg", filename: "manual.jpg")
+
+    drain_background_jobs
+    transforms, served_bytes = open_page_and_fetch_picture(picture.leaf)
+
+    assert_equal 0, transforms, "fetching the picture triggered image processing again"
+    assert_equal 1, derived_state(picture)[:records]
+    assert_equal 1, derived_state(picture)[:files].size
+    assert_equal "image/webp", response.media_type
+    assert_equal stored_derived_bytes(picture), served_bytes
+  end
+
+  private
+    def upload_picture(file, content_type, filename: File.basename(file.to_s))
+      sign_in :kevin
+
+      post book_pictures_path(books(:handbook)), params: {
+        picture: { image: fixture_file_upload(file, content_type), caption: "A lovely photo" }
+      }
+
+      books(:handbook).leaves.order(:id).last.leafable.tap do |picture|
+        assert_kind_of Picture, picture
+        assert picture.image.attached?
+      end
+    end
+
+    def drain_background_jobs
+      perform_enqueued_jobs while enqueued_jobs.any?
+    end
+
+    def open_page_and_fetch_picture(leaf)
+      get leafable_slug_path(leaf)
+      assert_response :success
+
+      image_url = Nokogiri::HTML(response.body).at_css("figure.page--picture img").attr("src")
+      assert image_url.present?, "expected the page to link to a picture"
+
+      transforms = count_transforms do
+        get image_url
+        follow_redirect! while response.redirect?
+        assert_response :success
+      end
+
+      [ transforms, response.body ]
+    end
+
+    def count_transforms(&block)
+      transforms = 0
+      subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transforms += 1 }
+      block.call
+      transforms
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+
+    def derived_state(picture)
+      records = ActiveStorage::VariantRecord.where(blob_id: picture.image.blob.id).to_a
+      files = records.filter_map { |record| record.image_attachment&.blob }
+        .map { |blob| ActiveStorage::Blob.service.path_for(blob.key) }
+        .select { |path| File.exist?(path) }
+
+      { records: records.size, files: files }
+    end
+
+    def stored_derived_bytes(picture)
+      record = ActiveStorage::VariantRecord.where(blob_id: picture.image.blob.id).sole
+      record.image.blob.download
+    end
+end
