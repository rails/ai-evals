diff --git a/test/controllers/books/releases_controller_test.rb b/test/controllers/books/releases_controller_test.rb
new file mode 100644
index 0000000..d804f7a
--- /dev/null
+++ b/test/controllers/books/releases_controller_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "releasing a book recaps it with the released title and published state" do
+    book = books(:handbook)
+    assert_not book.published?
+
+    patch book_release_path(book), params: { book: { title: "The Employee Handbook", subtitle: "How we work" } }
+
+    assert_redirected_to root_path
+    assert_equal({ title: "The Employee Handbook", published: true }, book.reload.cached_recap)
+  end
+
+  test "releasing an already published book leaves it alone" do
+    book = books(:handbook)
+    book.update! published: true
+
+    patch book_release_path(book), params: { book: { title: "A New Title" } }
+
+    assert_redirected_to book_slug_path(book)
+    assert_equal "Handbook", book.reload.title
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..feb8c12
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "recaps are kept per book" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    handbook.update! title: "The Employee Handbook"
+
+    assert_equal({ title: "The Employee Handbook", published: false }, handbook.reload.cached_recap)
+    assert_nil manual.reload.cached_recap
+
+    manual.update! title: "The Operations Manual"
+
+    assert_equal({ title: "The Employee Handbook", published: false }, handbook.reload.cached_recap)
+    assert_equal({ title: "The Operations Manual", published: false }, manual.reload.cached_recap)
+  end
+
+  test "recaps expire on the configured schedule" do
+    handbook = books(:handbook)
+    handbook.update! title: "The Employee Handbook"
+
+    assert_not_nil handbook.reload.cached_recap
+
+    travel Rails.application.config.x.recap.expires_in + 1.minute do
+      assert_nil handbook.reload.cached_recap
+    end
+  end
+end
