diff --git a/test/integration/with_raised_exceptions_test.rb b/test/integration/with_raised_exceptions_test.rb
new file mode 100644
index 0000000..2cb8285
--- /dev/null
+++ b/test/integration/with_raised_exceptions_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+# with_raised_exceptions must keep its promise no matter what ran before or
+# runs after in the same process: inside the block a controller error reaches
+# the test as the raised exception, and outside the block error pages render
+# like normal. (The "show exceptions" decision is memoized per process, so a
+# naive override either never applies or leaks into later tests.)
+class WithRaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "raises inside the block and renders error pages before and after" do
+    sign_in :kevin
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "renders error pages normally when the block made the first request" do
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    sign_in :kevin
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..b705905 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,36 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Lets a test see controller exceptions raised instead of the error pages
+    # that would normally be rendered for them:
+    #
+    #   with_raised_exceptions do
+    #     assert_raises ActiveRecord::RecordNotFound do
+    #       get book_slug_path(books(:manual))
+    #     end
+    #   end
+    #
+    # Whether exceptions are shown as error pages is decided per request from
+    # the "action_dispatch.show_exceptions" entry of the request env, which
+    # Rails::Engine#build_request fills in from Rails.application.env_config.
+    # That hash is memoized the first time a request is built in the process,
+    # so writing config.action_dispatch.show_exceptions alone has no effect on
+    # requests built before or after this block. Change the live env_config
+    # entry (and the config, to keep them consistent) and restore both, so the
+    # override applies to exactly the requests made inside the block -- no
+    # matter what ran before or runs after in the same process.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
+      env_config = Rails.application.env_config
+      previous_config = Rails.application.config.action_dispatch.show_exceptions
+      previous_env = env_config["action_dispatch.show_exceptions"]
+
       Rails.application.config.action_dispatch.show_exceptions = :none
+      env_config["action_dispatch.show_exceptions"] = :none
+
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config["action_dispatch.show_exceptions"] = previous_env
+      Rails.application.config.action_dispatch.show_exceptions = previous_config
     end
   end
 end
