diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..8fa6b84 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,55 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy removes the book for editors" do
+    assert books(:handbook).editable?(user: users(:kevin))
+
+    delete book_path(books(:handbook))
+
+    assert_redirected_to root_url
+    assert_not Book.exists?(books(:handbook).id)
+  end
+
+  test "destroy is forbidden for readers" do
+    sign_in :jz
+    assert books(:handbook).accessable?(user: users(:jz))
+    assert_not books(:handbook).editable?(user: users(:jz))
+
+    delete book_path(books(:handbook))
+
+    assert_response :forbidden
+    assert Book.exists?(books(:handbook).id)
+  end
+
+  test "destroy is forbidden on a published book the user cannot edit" do
+    books(:manual).update!(published: true)
+    assert_not books(:manual).editable?(user: users(:kevin))
+
+    delete book_path(books(:manual))
+
+    assert_response :forbidden
+    assert Book.exists?(books(:manual).id)
+  end
+
+  test "destroy allows an administrator whose access is read-only" do
+    sign_in :jason
+    books(:manual).access_for(user: users(:jason)).update!(level: :reader)
+    assert books(:manual).editable?(user: users(:jason)) # via administrator role
+
+    delete book_path(books(:manual))
+
+    assert_redirected_to root_url
+    assert_not Book.exists?(books(:manual).id)
+  end
+
+  test "destroy requires authentication" do
+    sign_out
+    books(:manual).update!(published: true)
+
+    delete book_path(books(:manual))
+
+    assert_redirected_to new_session_url
+    assert Book.exists?(books(:manual).id)
+  end
 end
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..c031c5a 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,51 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "show does not render a leaf under another book's id" do
+    sign_in :david
+
+    get book_page_path(books(:handbook), leaves(:welcome_page))
+    assert_response :success
+
+    get book_page_path(books(:manual), leaves(:welcome_page))
+    assert_response :not_found
+  end
+
+  test "show does not render an inaccessible book's leaf under an accessible book's id" do
+    secret_leaf = books(:manual).press Page.new(body: "top secret"), title: "Secret Manual Page"
+    assert_not books(:manual).accessable?(user: users(:kevin))
+
+    get book_page_path(books(:handbook), secret_leaf)
+    assert_response :not_found
+  end
+
+  test "show via slugged route does not render a leaf under another book's id" do
+    sign_in :david
+    manual_leaf = books(:manual).press Page.new(body: "manual body"), title: "Manual Page"
+
+    get "/#{books(:handbook).id}/handbook/#{manual_leaf.id}/manual-page"
+
+    assert_response :not_found
+  end
+
+  test "update does not touch a leaf from another book" do
+    sign_in :david
+    manual_leaf = books(:manual).press Page.new(body: "manual body"), title: "Manual Page"
+
+    patch book_page_path(books(:handbook), manual_leaf), params: { page: { body: "defaced" } }
+
+    assert_response :not_found
+    assert_not_equal "defaced", manual_leaf.reload.leafable.body.to_s
+  end
+
+  test "destroy does not trash a leaf from another book" do
+    sign_in :david
+    manual_leaf = books(:manual).press Page.new(body: "manual body"), title: "Manual Page"
+
+    delete book_page_path(books(:handbook), manual_leaf)
+
+    assert_response :not_found
+    assert manual_leaf.reload.active?
+  end
 end
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..9eaf57a
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "show finds pages by title in books the user can read" do
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+  end
+
+  test "show only returns results from books the user can read" do
+    books(:manual).press Page.new(body: "unreadable body"), title: "Secret Manual Page"
+
+    get library_search_path, params: { q: "Secret" }
+
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+  end
+
+  test "show treats terms with punctuation as data" do
+    books(:handbook).press Page.new(body: "possessive"), title: "The Reader's Digest"
+
+    get library_search_path, params: { q: "it's" }
+    assert_response :success
+
+    get library_search_path, params: { q: "Reader's" }
+    assert_response :success
+    assert_in_body "The Reader&#39;s Digest"
+  end
+
+  test "show does not expose unreadable books to crafted terms" do
+    books(:manual).press Page.new(body: "unreadable body"), title: "Secret Manual Page"
+
+    get library_search_path, params: { q: "' or 1=1 --" }
+
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+  end
+
+  test "show matches percent signs literally" do
+    books(:handbook).press Page.new(body: "promo"), title: "Save 50% off"
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show matches underscores literally" do
+    books(:handbook).press Page.new(body: "snake"), title: "under_score page"
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_in_body "under_score page"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show matches backslashes literally" do
+    books(:handbook).press Page.new(body: "paths"), title: 'C:\Users\docs'
+
+    get library_search_path, params: { q: "\\" }
+    assert_response :success
+    assert_in_body "C:\\Users\\docs"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: 'C:\Users' }
+    assert_response :success
+    assert_in_body "C:\\Users\\docs"
+  end
+
+  test "show does not let wildcards widen a partial match" do
+    books(:handbook).press Page.new(body: "promo"), title: "Save 50% off"
+
+    get library_search_path, params: { q: "Save 5_% off" }
+    assert_response :success
+    assert_not_in_body "Save 50% off"
+
+    get library_search_path, params: { q: "Save 5X% off" }
+    assert_response :success
+    assert_not_in_body "Save 50% off"
+  end
+
+  test "show treats quotes as data" do
+    books(:handbook).press Page.new(body: "quoted"), title: 'He said "hi"'
+
+    get library_search_path, params: { q: '" OR "x"="x' }
+    assert_response :success
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: 'He said "hi"' }
+    assert_response :success
+    assert_in_body "He said"
+  end
+
+  test "show searches published books when signed out" do
+    books(:handbook).update!(published: true)
+    sign_out
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+  end
+
+  test "show does not search unpublished books when signed out" do
+    sign_out
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+end
diff --git a/test/controllers/users/profiles_controller_test.rb b/test/controllers/users/profiles_controller_test.rb
index 7564f7d..fe062fb 100644
--- a/test/controllers/users/profiles_controller_test.rb
+++ b/test/controllers/users/profiles_controller_test.rb
@@ -38,4 +38,35 @@ class Users::ProfilesControllerTest < ActionDispatch::IntegrationTest
     assert_response :forbidden
     assert_equal "Kevin", users(:kevin).reload.name
   end
+
+  test "update does not allow granting a role through the profile" do
+    sign_in :kevin
+    assert_not users(:kevin).administrator?
+
+    put user_profile_path(users(:kevin)), params: { user: { name: "Kevin", role: "administrator" } }
+
+    assert_redirected_to users_url
+    assert_equal "Kevin", users(:kevin).reload.name
+    assert_not users(:kevin).administrator?
+  end
+
+  test "update still changes name, email address and password" do
+    sign_in :kevin
+
+    put user_profile_path(users(:kevin)), params: { user: { name: "Kev", email_address: "kev@example.com", password: "newsecret123456" } }
+
+    assert_redirected_to users_url
+    kevin = users(:kevin).reload
+    assert_equal "Kev", kevin.name
+    assert_equal "kev@example.com", kevin.email_address
+    assert kevin.authenticate("newsecret123456")
+  end
+
+  test "update does not demote an administrator either" do
+    sign_in :david
+
+    put user_profile_path(users(:david)), params: { user: { name: "David", role: "member" } }
+
+    assert users(:david).reload.administrator?
+  end
 end
