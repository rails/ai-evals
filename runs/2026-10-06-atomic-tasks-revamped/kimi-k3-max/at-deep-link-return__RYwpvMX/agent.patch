index 0000000..56c7eb0
--- /dev/null
+++ b/test/controllers/sessions_return_to_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class SessionsReturnToTest < ActionDispatch::IntegrationTest
+  CREDENTIALS = { email_address: "david@example.com", password: "secret123456" }
+
+  test "create without return_to redirects to root" do
+    post session_url, params: CREDENTIALS
+
+    assert_redirected_to root_url
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create with blank return_to redirects to root" do
+    post session_url, params: CREDENTIALS.merge(return_to: "")
+
+    assert_redirected_to root_url
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create with a same-host deep link redirects back to it" do
+    post session_url, params: CREDENTIALS.merge(return_to: "http://www.example.com/1/my-book/2/a-page")
+
+    assert_redirected_to "http://www.example.com/1/my-book/2/a-page"
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create with a relative deep link redirects back to it" do
+    post session_url, params: CREDENTIALS.merge(return_to: "/books/1")
+
+    assert_redirected_to "/books/1"
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create with an external return_to redirects to root instead" do
+    post session_url, params: CREDENTIALS.merge(return_to: "https://evil.example.com/phishing")
+
+    assert_redirected_to root_url
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create with a protocol-relative return_to redirects to root instead" do
+    post session_url, params: CREDENTIALS.merge(return_to: "//evil.example.com/phishing")
+
+    assert_redirected_to root_url
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create with a javascript return_to redirects to root instead" do
+    post session_url, params: CREDENTIALS.merge(return_to: "javascript:alert(document.cookie)")
+
+    assert_redirected_to root_url
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create with a malformed return_to redirects to root instead of raising" do
+    post session_url, params: CREDENTIALS.merge(return_to: "not a url at all %%%")
+
+    assert_redirected_to root_url
+    assert parsed_cookies.signed[:session_token]
+  end
+end
