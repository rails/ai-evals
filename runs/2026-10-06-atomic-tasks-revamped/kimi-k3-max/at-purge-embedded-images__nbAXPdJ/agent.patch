diff --git a/test/controllers/action_text/markdown/uploads_controller_test.rb b/test/controllers/action_text/markdown/uploads_controller_test.rb
index 48141c1..9ddf8fe 100644
--- a/test/controllers/action_text/markdown/uploads_controller_test.rb
+++ b/test/controllers/action_text/markdown/uploads_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class ActionText::Markdown::UploadsControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -31,4 +33,32 @@ class ActionText::Markdown::UploadsControllerTest < ActionDispatch::IntegrationT
     assert_response :redirect
     assert_match /\/rails\/active_storage\/.*\/reading\.webp/, @response.redirect_url
   end
+
+  test "uploads are purged when the record's page is destroyed" do
+    post action_text_markdown_uploads_path, params: {
+      record_gid: pages(:welcome).to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+
+    assert_response :success
+
+    attachment = ActiveStorage::Attachment.last
+    blob = attachment.blob
+
+    # The upload is served back from the URL handed out for it
+    get action_text_markdown_upload_path(slug: attachment.slug)
+    assert_response :redirect
+    assert blob.service.exist?(blob.key)
+
+    leaves(:welcome_page).destroy
+
+    assert_enqueued_with job: ActiveStorage::PurgeJob
+
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
 end
