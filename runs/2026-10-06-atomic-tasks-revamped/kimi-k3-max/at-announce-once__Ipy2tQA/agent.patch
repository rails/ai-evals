diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..afd8a68
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "going live announces the book" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      books(:manual).update! published: true
+    end
+  end
+
+  test "going live announces exactly once no matter what else the sitting saves" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update! published: true
+        book.press Page.new(body: ""), title: "New page"
+        book.leaves.last.update! status: :trashed
+      end
+    end
+  end
+
+  test "saving an already live book announces nothing" do
+    book = books(:manual)
+    book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update! title: "Renamed"
+    end
+  end
+
+  test "saving a draft announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      books(:manual).update! title: "Renamed draft"
+    end
+  end
+
+  test "taking a live book back down announces nothing" do
+    book = books(:manual)
+    book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update! published: false
+    end
+  end
+
+  test "a sitting that ends as a draft announces nothing" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update! published: true
+        book.update! published: false
+      end
+    end
+  end
+
+  test "a sitting that fails after going live leaves a draft and no announcement" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises(RuntimeError) do
+        book.transaction do
+          book.update! published: true
+          book.press Page.new(body: ""), title: "Doomed page"
+          raise "boom"
+        end
+      end
+    end
+
+    assert_not book.reload.published?
+    assert_not book.leaves.exists?(title: "Doomed page")
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update! title: "Aftermath"
+    end
+  end
+end
