   include Leafable
 
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    # +format+ must be a string, not a symbol. The background job derives the
+    # variant with these transformations as-is, while a request for the variant
+    # URL decodes them from a signed key that only round-trips strings. A symbol
+    # would digest differently on each side, so the first read would derive --
+    # and permanently store -- a second, duplicate copy of the variant.
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
diff --git a/test/integration/picture_variants_test.rb b/test/integration/picture_variants_test.rb
new file mode 100644
index 0000000..6f639b8
--- /dev/null
+++ b/test/integration/picture_variants_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class PictureVariantsTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+
+    @transforms = 0
+    @subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { @transforms += 1 }
+  end
+
+  teardown do
+    ActiveSupport::Notifications.unsubscribe(@subscriber)
+  end
+
+  test "an upload is derived exactly once" do
+    upload_picture "white-rabbit.webp", "image/webp"
+
+    # The background job writes the derived copy
+    drain_jobs
+    assert_equal 1, @transforms
+
+    blob_count_after_job   = ActiveStorage::Blob.count
+    record_count_after_job = ActiveStorage::VariantRecord.count
+    file_count_after_job   = storage_file_count
+    derived_bytes          = ActiveStorage::VariantRecord.order(:id).last.image.download
+
+    # The first reader opens the book page and fetches the picture it links to
+    reader_bytes = fetch_picture_as_reader
+
+    # No image processing, and exactly one derived copy remains in storage
+    assert_equal 1, @transforms, "reader request should not transform the image"
+    assert_equal blob_count_after_job, ActiveStorage::Blob.count
+    assert_equal record_count_after_job, ActiveStorage::VariantRecord.count
+    assert_equal file_count_after_job, storage_file_count
+
+    # The reader is served the same picture, byte for byte
+    assert_equal derived_bytes, reader_bytes
+  end
+
+  test "a reader arriving before the background job still yields exactly one derived copy" do
+    upload_picture "white-rabbit.webp", "image/webp"
+
+    # The page is read before the job runs, so the read derives the copy on demand
+    reader_bytes = fetch_picture_as_reader
+    assert_equal 1, @transforms
+
+    # The job then finds the derived copy instead of converting again
+    drain_jobs
+    assert_equal 1, @transforms
+    assert_equal 1, ActiveStorage::VariantRecord.count
+    assert_equal reader_bytes, ActiveStorage::VariantRecord.order(:id).last.image.download
+  end
+
+  test "replacing the picture leaves exactly one derived copy" do
+    upload_picture "reading.webp", "image/webp"
+    drain_jobs
+
+    upload_picture "white-rabbit.webp", "image/webp"
+    drain_jobs
+
+    assert_equal 1, ActiveStorage::VariantRecord.count
+    assert_equal fetch_picture_as_reader, ActiveStorage::VariantRecord.order(:id).last.image.download
+    assert_equal 0, ActiveStorage::Blob.where.not(id: ActiveStorage::Attachment.select(:blob_id)).count, "no orphaned blobs"
+  end
+
+  test "an image that cannot be resized is served as-is" do
+    upload_picture "pixel.bmp", "image/bmp"
+    drain_jobs
+
+    assert_equal 0, @transforms
+    assert_equal 0, ActiveStorage::VariantRecord.count
+
+    get leafable_slug_path(leaves(:reading_picture))
+    assert_response :success
+    assert_includes css_select("figure.page--picture img").first["src"], "/rails/active_storage/blobs/"
+  end
+
+  private
+    def upload_picture(filename, content_type)
+      put leafable_path(leaves(:reading_picture)), params: {
+        picture: { image: fixture_file_upload(filename, content_type) }
+      }
+      assert_response :no_content
+    end
+
+    def fetch_picture_as_reader
+      get leafable_slug_path(leaves(:reading_picture))
+      assert_response :success
+
+      get css_select("figure.page--picture img").first["src"]
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+
+      response.body
+    end
+
+    def drain_jobs
+      perform_enqueued_jobs until enqueued_jobs.empty?
+    end
+
+    def storage_file_count
+      Dir.glob(Rails.root.join("tmp/storage/**/*")).count { |path| File.file?(path) }
+    end
+end
