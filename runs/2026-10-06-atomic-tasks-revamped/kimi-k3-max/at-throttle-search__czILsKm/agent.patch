@@ -1,6 +1,17 @@
 class Books::SearchesController < ApplicationController
   allow_unauthenticated_access
 
+  # Kept in-process so search limiting works in every environment — the test
+  # environment's Rails.cache is a null store — and so counters expire on their
+  # own with nothing external to run or unblock.
+  RATE_LIMIT_STORE = ActiveSupport::Cache::MemoryStore.new
+
+  # Refuse an address that fires off more than 30 searches in a minute. The
+  # counter expires with the window, so a stopped burst is served again within
+  # a minute without anyone lifting a block.
+  rate_limit to: 30, within: 1.minute, only: :create,
+    store: RATE_LIMIT_STORE, with: -> { head :too_many_requests }
+
   include BookScoped
 
   def create
