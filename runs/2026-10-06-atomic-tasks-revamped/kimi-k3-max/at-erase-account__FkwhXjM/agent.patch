diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..a3764d5
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,52 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  # Byline used for books that outlive their creator.
+  ANONYMIZED_AUTHOR_NAME = "Deleted author"
+
+  # The old removal behavior scrambled email addresses by inserting
+  # "-deactivated-<uuid>" in front of the @ (see the former User#deactivate).
+  DEACTIVATED_EMAIL_INFIX = /-deactivated-[0-9a-f-]{36}(?=@)/
+
+  # Permanently erases this person and everything of theirs: the user row,
+  # sessions, accesses, reading marks, sign-in events, and any books they
+  # created that aren't shared with everyone -- including their leaves,
+  # revision history, attachments, and search index entries.
+  #
+  # Books they created that are shared with everyone are kept so readers
+  # aren't affected, but they're disowned and bylined "Deleted author".
+  def erase
+    transaction do
+      anonymize_shared_books
+      destroy_unshared_books
+
+      destroy!
+      erase_sign_in_events
+    end
+  end
+
+  private
+    def anonymize_shared_books
+      created_books.with_everyone_access.update_all \
+        creator_id: nil, author: ANONYMIZED_AUTHOR_NAME, updated_at: Time.now
+    end
+
+    def destroy_unshared_books
+      created_books.where(everyone_access: false).find_each(&:destroy!)
+    end
+
+    # Sign-in events are logged under the address the person actually signed
+    # in with. People "removed" the old way had their address scrambled, so
+    # recover their original address to find their events too.
+    def erase_sign_in_events
+      SignInEvent.where(email_address: known_email_addresses).delete_all
+    end
+
+    def known_email_addresses
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    def original_email_address
+      email_address&.sub(DEACTIVATED_EMAIL_INFIX, "")
+    end
+end
