diff --git a/test/models/leaf/editable_test.rb b/test/models/leaf/editable_test.rb
index b654642..13ed410 100644
--- a/test/models/leaf/editable_test.rb
+++ b/test/models/leaf/editable_test.rb
@@ -63,4 +63,28 @@ class Leaf::EditableTest < ActiveSupport::TestCase
     assert leaves(:welcome_page).edits.last.trash?
     assert_equal "This is _such_ a great handbook.", leaves(:welcome_page).edits.last.page.body.content
   end
+
+  test "destroying a leaf destroys its edits and their versions" do
+    leaves(:welcome_page).edit leafable_params: { body: "New body" }
+
+    leaf = leaves(:welcome_page)
+    page_ids = [ leaf.page.id, *leaf.edits.map { it.page.id } ]
+
+    leaf.destroy
+
+    assert_not Edit.where(leaf_id: leaf.id).exists?
+    page_ids.each { assert_not Page.exists?(it) }
+  end
+
+  test "destroying a trashed leaf destroys the leafable shared with its trash edit" do
+    leaf = leaves(:welcome_page)
+    leaf.trashed!
+
+    page_id = leaf.page.id
+
+    leaf.destroy
+
+    assert_not Edit.where(leaf_id: leaf.id).exists?
+    assert_not Page.exists?(page_id)
+  end
 end
diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..8124c8f 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,57 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "erase removes the person and everything of theirs" do
+    user = User.create!(name: "Erika", email_address: "erika@example.com", password: "secret123456")
+    book = Book.create!(title: "Erika's book", everyone_access: false, creator: user)
+    book.press Page.new(body: "erika's secret words"), title: "Secret page"
+    user.sessions.start!(user_agent: "test", ip_address: "127.0.0.1")
+    ReadingMark.remember book.leaves.first, user: user
+
+    user.erase
+
+    assert_not User.exists?(user.id)
+    assert_not Session.where(user_id: user.id).exists?
+    assert_not Access.where(user_id: user.id).exists?
+    assert_not ReadingMark.where(user_id: user.id).exists?
+    assert_not SignInEvent.for_address("erika@example.com").exists?
+    assert_not Book.exists?(book.id)
+    assert_empty Leaf.search("secret")
+  end
+
+  test "erase keeps books shared with everyone but bylines them as a deleted author" do
+    user = User.create!(name: "Erika", email_address: "erika@example.com", password: "secret123456")
+    shared_book = Book.create!(title: "Erika's shared book", author: "Erika", everyone_access: true, creator: user)
+    shared_book.press Page.new(body: "erika's shared words"), title: "Shared page"
+    shared_book.update_access(editors: [ user.id ], readers: [ users(:david).id ])
+    private_book = Book.create!(title: "Erika's private book", author: "Erika", everyone_access: false, creator: user)
+
+    user.erase
+
+    assert shared_book.reload.persisted?
+    assert_nil shared_book.creator
+    assert_equal "Deleted author", shared_book.author
+    assert shared_book.accessable?(user: users(:david))
+    assert_equal 1, Leaf.search("shared").length
+
+    assert_not Book.exists?(private_book.id)
+  end
+
+  test "erase works for people deactivated the old way" do
+    user = User.create!(name: "Erika", email_address: "erika@example.com", password: "secret123456")
+    user.sessions.start!(user_agent: "test", ip_address: "127.0.0.1")
+
+    # Simulates the old removal behavior: deactivated with a scrambled address,
+    # while sign-in events remain under the address they signed in with.
+    user.sessions.delete_all
+    scrambled_address = "erika-deactivated-#{SecureRandom.uuid}@example.com"
+    user.update! active: false, email_address: scrambled_address
+    SignInEvent.create! action: :signed_out, email_address: scrambled_address
+
+    user.erase
+
+    assert_not User.exists?(user.id)
+    assert_empty SignInEvent.where("email_address LIKE ?", "%erika%")
+  end
 end
