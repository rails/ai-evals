diff --git a/test/test_helpers/exception_test_helper.rb b/test/test_helpers/exception_test_helper.rb
new file mode 100644
index 0000000..5075b5e
--- /dev/null
+++ b/test/test_helpers/exception_test_helper.rb
@@ -0,0 +1,25 @@
+module ExceptionTestHelper
+  def with_raised_exceptions
+    previous = Thread.current[:writebook_raise_test_exceptions]
+    Thread.current[:writebook_raise_test_exceptions] = true
+    yield
+  ensure
+    Thread.current[:writebook_raise_test_exceptions] = previous
+  end
+
+  module RequestExceptions
+    def env_config
+      defaults = super
+
+      # Rails memoizes these defaults, then merges them over each request's env.
+      # Return a scoped copy rather than modifying the config or its cached hash.
+      # Execution-local scope also covers new/reset sessions without affecting
+      # parallel tests; the helper restores it for nested blocks and errors.
+      if Thread.current[:writebook_raise_test_exceptions]
+        defaults.merge("action_dispatch.show_exceptions" => :none)
+      else
+        defaults
+      end
+    end
+  end
+end
