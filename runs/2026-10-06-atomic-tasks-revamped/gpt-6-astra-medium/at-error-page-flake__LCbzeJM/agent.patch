+++ b/test/integration/exception_handling_test.rb
@@ -0,0 +1,162 @@
+require "test_helper"
+
+class ExceptionHandlingTest < ActionDispatch::IntegrationTest
+  test "exceptions raise only inside the block after earlier requests" do
+    assert_missing_book_renders
+
+    with_raised_exceptions do
+      assert_missing_book_raises
+      assert_missing_book_raises
+    end
+
+    assert_missing_book_renders
+    with_raised_exceptions { assert_missing_book_raises }
+    assert_missing_book_renders
+  end
+
+  test "exceptions render after the block even when its request is first" do
+    with_raised_exceptions { assert_missing_book_raises }
+    assert_missing_book_renders
+  end
+
+  test "nested blocks restore the enclosing scope and return the block value" do
+    result = with_raised_exceptions do
+      assert_missing_book_raises
+      inner_result = with_raised_exceptions do
+        assert_missing_book_raises
+        :inner
+      end
+      assert_equal :inner, inner_result
+      assert_missing_book_raises
+      :outer
+    end
+
+    assert_equal :outer, result
+    assert_missing_book_renders
+  end
+
+  test "a controller exception escaping the block restores normal rendering" do
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions { get missing_book_path }
+    end
+
+    assert_missing_book_renders
+  end
+
+  test "an exception escaping a nested block restores the enclosing scope" do
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        with_raised_exceptions { get missing_book_path }
+      end
+      assert_missing_book_raises
+    end
+
+    assert_missing_book_renders
+  end
+
+  test "new and reset integration sessions respect the current scope" do
+    existing_session = open_session
+
+    new_session = with_raised_exceptions do
+      assert_missing_book_raises(existing_session)
+      new_session = open_session
+      assert_missing_book_raises(new_session)
+      new_session.reset!
+      assert_missing_book_raises(new_session)
+      reset!
+      assert_missing_book_raises
+      new_session
+    end
+
+    assert_missing_book_renders(new_session)
+    assert_missing_book_renders(existing_session)
+    assert_missing_book_renders
+  end
+
+  test "request options are preserved without mutating caller owned hashes" do
+    env = { "action_dispatch.show_exceptions" => :all, "test.marker" => "kept" }.freeze
+    headers = { "X-Test-Marker" => "kept" }.freeze
+
+    with_raised_exceptions do
+      get root_path, params: { marker: "kept" }, env: env, headers: headers
+      assert_equal "kept", request.env["test.marker"]
+      assert_equal "kept", request.headers["X-Test-Marker"]
+      assert_equal "kept", request.query_parameters["marker"]
+
+      assert_raises ActiveRecord::RecordNotFound do
+        get missing_book_path, env: env, headers: headers
+      end
+    end
+
+    assert_equal :all, env["action_dispatch.show_exceptions"]
+    get missing_book_path, env: env, headers: headers
+    assert_response :not_found
+  end
+
+  test "application exception defaults remain unchanged throughout the block" do
+    config = Rails.application.config.action_dispatch.show_exceptions
+    defaults = Rails.application.env_config
+    env_config = defaults.dup
+
+    with_raised_exceptions do
+      assert_missing_book_raises
+      assert_equal config, Rails.application.config.action_dispatch.show_exceptions
+      assert_equal env_config, defaults
+    end
+
+    assert_equal config, Rails.application.config.action_dispatch.show_exceptions
+    assert_equal env_config, Rails.application.env_config
+  end
+
+  test "overlapping scopes in separate threads do not affect each other" do
+    # A missing route exercises exception middleware without sharing fixture
+    # transactions or an integration session between threads.
+    path = "/__exception_helper_missing_route__"
+    get path
+    assert_response :not_found
+    entered = Queue.new
+    release = Queue.new
+
+    worker = Thread.new do
+      session = ActionDispatch::Integration::Session.new(Rails.application)
+      with_raised_exceptions do
+        entered << true
+        release.pop
+        assert_raises(ActionController::RoutingError) { session.get path }
+      end
+      session.get path
+      assert_equal 404, session.response.status
+    end
+
+    begin
+      assert entered.pop(timeout: 10), "worker did not enter its exception scope"
+      get path
+      assert_response :not_found
+      with_raised_exceptions do
+        assert_raises(ActionController::RoutingError) { get path }
+      end
+      get path
+      assert_response :not_found
+      release << true
+      assert worker.join(10), "worker did not finish its requests"
+      worker.value
+    ensure
+      worker.kill
+      worker.join
+    end
+  end
+
+  private
+    def missing_book_path
+      book_slug_path(books(:manual))
+    end
+
+    def assert_missing_book_raises(session = self)
+      assert_raises(ActiveRecord::RecordNotFound) { session.get missing_book_path }
+    end
+
+    def assert_missing_book_renders(session = self)
+      session.get missing_book_path
+      session.assert_response :not_found
+    end
+end
