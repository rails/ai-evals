diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..2060e3d
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    @book = books(:handbook)
+    @book.update_columns(created_at: Time.utc(2024, 1, 2, 3, 4, 5), updated_at: Time.utc(2024, 6, 7, 8, 9, 10))
+  end
+
+  test "shelf report displays the long date and delimited character count" do
+    get book_report_path(@book)
+
+    assert_response :success
+    assert_in_body "Last updated June 07, 2024"
+    assert_in_body ERB::Util.html_escape("Handbook — #{@book.markable.length.to_fs(:delimited)} characters")
+  end
+
+  test "download preserves the filename and card formats" do
+    get book_report_path(@book, format: :text)
+
+    assert_response :success
+    assert_includes response.headers["Content-Disposition"], 'filename="shelf-report-20240607080910.txt"'
+    covers = [ :welcome_section, :welcome_page, :summary_page, :reading_picture ].map { |name| leaves(name).id }.join(",")
+    assert_equal <<~TEXT, response.body
+      Book: Handbook
+      Leaves: 4
+      Started: January 02, 2024 03:04
+      Updated: 07 Jun 08:09
+      Covers: #{covers}
+    TEXT
+  end
+end
diff --git a/test/jobs/report_archive_job_test.rb b/test/jobs/report_archive_job_test.rb
new file mode 100644
index 0000000..76d9a22
--- /dev/null
+++ b/test/jobs/report_archive_job_test.rb
@@ -0,0 +1,28 @@
+require "test_helper"
+require "tmpdir"
+
+class ReportArchiveJobTest < ActiveJob::TestCase
+  test "archive preserves the default timestamp including its offset" do
+    book = books(:handbook)
+    leaves(:welcome_page).update_column(:updated_at, Time.utc(2024, 6, 7, 8, 9, 10))
+    book.leaves.where.not(id: leaves(:welcome_page).id).update_all(updated_at: Time.utc(2024, 1, 2))
+
+    Time.use_zone("America/New_York") do
+      assert_archive book, "# archived 2024-06-07 04:09:10 -0400\n\n#{book.markable}"
+    end
+  end
+
+  test "archive permits books with no last edited timestamp" do
+    assert_archive books(:manual), "# archived \n\n"
+  end
+
+  private
+    def assert_archive(book, expected)
+      Dir.mktmpdir do |directory|
+        stub_const(ReportArchiveJob, :ARCHIVE_DIR, directory) do
+          ReportArchiveJob.perform_now(book)
+          assert_equal expected, File.read(File.join(directory, "book-#{book.id}.txt"))
+        end
+      end
+    end
+end
diff --git a/test/lib/publishing/report_card_test.rb b/test/lib/publishing/report_card_test.rb
new file mode 100644
index 0000000..5c4d608
--- /dev/null
+++ b/test/lib/publishing/report_card_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class Publishing::ReportCardTest < ActiveSupport::TestCase
+  test "covers only lists active leaves" do
+    book = books(:handbook)
+    book.leaves.where.not(id: leaves(:welcome_page).id).update_all(status: "trashed")
+
+    assert_equal "Covers: #{leaves(:welcome_page).id}\n", Publishing::ReportCard.new(book).to_text.lines.last
+  end
+
+  test "empty books retain ordinary string conversions and the empty database list" do
+    book = books(:manual)
+    book.update_columns(created_at: Time.utc(2024, 1, 2, 3, 4, 5), updated_at: Time.utc(2024, 6, 7, 8, 9, 10))
+
+    assert_equal <<~TEXT, Publishing::ReportCard.new(book).to_text
+      Book: Manual
+      Leaves: 0
+      Started: January 02, 2024 03:04
+      Updated: 07 Jun 08:09
+      Covers: null
+    TEXT
+  end
+end
