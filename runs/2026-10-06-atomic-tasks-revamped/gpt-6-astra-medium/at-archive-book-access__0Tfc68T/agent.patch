diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..935d16f 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -6,6 +6,55 @@ class BookTest < ActiveSupport::TestCase
     assert_equal "hello-world", book.slug
   end
 
+  test "destroy archives fresh access data even when the association was loaded earlier" do
+    book = books(:manual)
+    book.accesses.load
+    accesses(:jz_manual).destroy!
+    accesses(:david_manual).reader!
+
+    assert_difference -> { AccessArchive.count }, 2 do
+      book.destroy!
+    end
+
+    assert book.destroyed?
+    assert_not Access.exists?(book_id: book.id)
+    assert_equal [
+      [ users(:david).id, "reader" ],
+      [ users(:jason).id, "editor" ]
+    ].sort, AccessArchive.where(book_id: book.id).pluck(:user_id, :level).sort
+  end
+
+  test "destroy directly without access grants creates no archives" do
+    book = books(:manual)
+    book.accesses.load
+    Access.where(book: book).delete_all
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+
+    assert book.destroyed?
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+  end
+
+  test "rolling back destruction also rolls back archives" do
+    book = books(:manual)
+    access_count = book.accesses.count
+
+    assert_no_difference -> { AccessArchive.count } do
+      Book.transaction(requires_new: true) do
+        assert_difference -> { AccessArchive.count }, access_count do
+          book.destroy!
+        end
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert Book.exists?(book.id)
+    assert_equal access_count, Access.where(book_id: book.id).count
+  end
+
