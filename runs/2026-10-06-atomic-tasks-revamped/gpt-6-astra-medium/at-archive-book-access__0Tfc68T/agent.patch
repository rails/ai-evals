+    def snapshot_access_list
+      # Read current grants before dependent destruction, not a cached association.
+      @access_list_for_archive = accesses.includes(:user).map do |access|
+        {
           book_id: id,
           book_title: title,
           user_id: access.user_id,
           user_name: access.user.name,
           level: access.level
-        )
