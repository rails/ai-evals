diff --git a/app/jobs/being_edited_broadcast_job.rb b/app/jobs/being_edited_broadcast_job.rb
new file mode 100644
index 0000000..8a3a4da
--- /dev/null
+++ b/app/jobs/being_edited_broadcast_job.rb
@@ -0,0 +1,13 @@
+class BeingEditedBroadcastJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(leaf, user)
+    # Resolve recipients at delivery time: an open editor may have lost access
+    # since the save was queued. Never broadcast presence to a shared leaf stream.
+    editors = User.active.where(id: leaf.book.accesses.editor.select(:user_id))
+    editors.or(User.active.administrator).find_each do |recipient|
+      Turbo::StreamsChannel.broadcast_render_to leaf, :being_edited, recipient,
+        partial: "leaves/being_edited_by", locals: { leaf: leaf, user: user }
+    end
+  end
+end
