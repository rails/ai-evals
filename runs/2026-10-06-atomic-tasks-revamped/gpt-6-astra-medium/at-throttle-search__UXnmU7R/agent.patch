+require "test_helper"
+
+class BookSearchRateLimitingTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    books(:handbook).update!(published: true)
+    books(:manual).update!(published: true)
+    Leaf.reindex_all
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "anonymous searches allow thirty requests then refuse without querying" do
+    30.times do
+      search_from "192.0.2.1"
+      assert_response :success
+      assert_in_body "<mark>Thanks</mark> for reading"
+    end
+
+    queries = []
+    subscriber = ->(event) { queries << event.payload[:sql] }
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      search_from "192.0.2.1"
+      assert_response :too_many_requests
+      assert_nil response.headers["Location"]
+    end
+    assert queries.none? { |sql| sql.match?(/\bMATCH\b/i) }, "Refused searches must not run full-text queries"
+
+    search_from "192.0.2.1"
+    assert_response :too_many_requests
+
+    search_from "192.0.2.2"
+    assert_response :success
+    assert_in_body "<mark>Thanks</mark> for reading"
+
+    get book_slug_path(books(:handbook)), headers: address("192.0.2.1")
+    assert_response :success
+    get leafable_slug_path(leaves(:welcome_page)), headers: address("192.0.2.1")
+    assert_response :success
+    assert_in_body "This is <em>such</em> a great handbook."
+  end
+
+  test "the allowance is shared across books and search terms" do
+    30.times do |index|
+      search_from "192.0.2.1", book: books(index.even? ? :handbook : :manual), term: "query #{index}"
+      assert_response :success
+    end
+
+    search_from "192.0.2.1", book: books(:manual), term: "different"
+    assert_response :too_many_requests
+    search_from "192.0.2.1"
+    assert_response :too_many_requests
+  end
+
+  test "slots expire individually so a window boundary cannot permit another burst" do
+    freeze_time do
+      search_from "192.0.2.1"
+      assert_response :success
+
+      travel 50.seconds
+      29.times do
+        search_from "192.0.2.1"
+        assert_response :success
+      end
+      search_from "192.0.2.1"
+      assert_response :too_many_requests
+
+      travel 11.seconds
+      search_from "192.0.2.1"
+      assert_response :success
+      search_from "192.0.2.1"
+      assert_response :too_many_requests
+
+      travel 1.minute
+      30.times do
+        search_from "192.0.2.1"
+        assert_response :success
+      end
+    end
+  end
+
+  test "an address is served again within five minutes without intervention" do
+    freeze_time do
+      31.times { search_from "192.0.2.1" }
+      assert_response :too_many_requests
+
+      travel 5.minutes
+      search_from "192.0.2.1"
+      assert_response :success
+      assert_in_body "<mark>Thanks</mark> for reading"
+    end
+  end
+
+  private
+    def search_from(ip, book: books(:handbook), term: "Thanks")
+      post book_search_path(book), params: { search: term }, headers: address(ip)
+    end
+
+    def address(ip)
+      { "REMOTE_ADDR" => ip }
+    end
+end
diff --git a/test/lib/book_search_rate_limiter_test.rb b/test/lib/book_search_rate_limiter_test.rb
new file mode 100644
index 0000000..88eddaa
--- /dev/null
+++ b/test/lib/book_search_rate_limiter_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class BookSearchRateLimiterTest < ActiveSupport::TestCase
+  test "simultaneous requests cannot reserve the same slot" do
+    store = ActiveSupport::Cache::MemoryStore.new
+    reads = Queue.new
+    writes = Queue.new
+
+    # Make every request see empty slots before any request can reserve one.
+    store.define_singleton_method(:read_multi) do |*keys|
+      super(*keys).tap do
+        reads << true
+        writes.pop
+      end
+    end
+
+    requests = Array.new(40) do
+      Thread.new { BookSearchRateLimiter.allow?("192.0.2.1", store: store) }
+    end
+    40.times { reads.pop }
+    40.times { writes << true }
+
+    assert_equal 30, requests.map(&:value).count(true)
+  end
+end
