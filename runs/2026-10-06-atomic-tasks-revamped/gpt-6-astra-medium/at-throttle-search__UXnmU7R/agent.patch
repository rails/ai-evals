diff --git a/lib/book_search_rate_limiter.rb b/lib/book_search_rate_limiter.rb
new file mode 100644
index 0000000..46e954a
--- /dev/null
+++ b/lib/book_search_rate_limiter.rb
@@ -0,0 +1,17 @@
+# Each accepted search occupies one slot for a minute. Unlike a fixed-window
+# counter, independently expiring slots enforce the limit across window boundaries.
+class BookSearchRateLimiter
+  LIMIT = 30
+  WINDOW = 1.minute
+
+  def self.allow?(address, store: Rails.cache)
+    keys = Array.new(LIMIT) { |slot| "rate-limit:book-search:#{address}:#{slot}" }
+    occupied = store.read_multi(*keys)
+
+    # read_multi avoids a round trip per occupied slot. The conditional write is
+    # still essential: Redis reserves a slot atomically across threads/workers.
+    (keys - occupied.keys).any? do |key|
+      store.write(key, true, expires_in: WINDOW, unless_exist: true)
+    end
+  end
+end
