@@ -0,0 +1,148 @@
+require "test_helper"
+
+class RaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "requests raise only inside the block after defaults have been cached" do
+    assert_absent
+    cached_defaults = Rails.application.env_config
+    defaults = cached_defaults.dup
+    configuration = Rails.application.config.action_dispatch.show_exceptions
+
+    result = with_raised_exceptions do
+      assert_missing_raises
+      assert_missing_raises
+      :block_result
+    end
+
+    assert_equal :block_result, result
+    assert_absent
+    assert_equal defaults, Rails.application.env_config
+    assert_same cached_defaults, Rails.application.env_config
+    assert_equal configuration, Rails.application.config.action_dispatch.show_exceptions
+  end
+
+  test "initializing application defaults inside the block does not poison the cache" do
+    # Isolate the cold cache without resetting shared state in the running app.
+    app = Rails.application.clone
+    app.remove_instance_variable(:@app_env_config) if app.instance_variable_defined?(:@app_env_config)
+    session = ActionDispatch::Integration::Session.new(app)
+
+    with_raised_exceptions do
+      assert_raises(ActiveRecord::RecordNotFound) { session.get absent_book_path }
+    end
+
+    session.get absent_book_path
+    assert_equal 404, session.response.status
+    assert_equal :rescuable, app.env_config["action_dispatch.show_exceptions"]
+    assert_absent
+  end
+
+  test "an exception escaping nested blocks restores normal rendering" do
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions do
+        with_raised_exceptions { get absent_book_path }
+      end
+    end
+
+    assert_absent
+  end
+
+  test "nested blocks restore the outer override even when the inner block raises" do
+    with_raised_exceptions do
+      with_raised_exceptions { assert_missing_raises }
+      assert_missing_raises
+      assert_raises RuntimeError do
+        with_raised_exceptions { raise "block failed" }
+      end
+      assert_missing_raises
+    end
+
+    assert_absent
+  end
+
+  test "the override follows the block across new and reset sessions" do
+    other_session = open_session
+    with_raised_exceptions do
+      assert_raises(ActiveRecord::RecordNotFound) { other_session.get absent_book_path }
+      reset!
+      assert_missing_raises
+      open_session do |session|
+        assert_raises(ActiveRecord::RecordNotFound) { session.get absent_book_path }
+      end
+    end
+
+    other_session.get absent_book_path
+    assert_equal 404, other_session.response.status
+    assert_absent
+  end
+
+  test "request options are preserved without mutating the caller's environment" do
+    environment = { "action_dispatch.show_exceptions" => :rescuable, "test.marker" => "kept" }.freeze
+    with_raised_exceptions do
+      get root_path, env: environment
+      assert_equal "kept", request.env["test.marker"]
+      assert_equal :none, request.env["action_dispatch.show_exceptions"]
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path, env: environment }
+    end
+
+    assert_equal :rescuable, environment["action_dispatch.show_exceptions"]
+    assert_absent
+  end
+
+  # A database-free controller lets threads exercise real exception middleware
+  # without sharing fixture transactions or integration session state.
+  class MissingController < ActionController::Metal
+    def index
+      raise ActiveRecord::RecordNotFound, "missing"
+    end
+  end
+
+  test "overlapping blocks and ordinary requests in other threads stay independent" do
+    middleware = ActionDispatch::ShowExceptions.new(
+      MissingController.action(:index), ActionDispatch::PublicExceptions.new(Rails.public_path))
+    app = ->(env) { middleware.call(env.merge(Rails.application.env_config)) }
+    session = ActionDispatch::Integration::Session.new(app)
+    ready, continue = Queue.new, Queue.new
+    worker = nil
+
+    with_raised_exceptions do
+      worker = Thread.new do
+        other = ActionDispatch::Integration::Session.new(app)
+        other.get "/missing"
+        assert_equal 404, other.response.status
+        with_raised_exceptions do
+          assert_raises(ActiveRecord::RecordNotFound) { other.get "/missing" }
+          ready << true
+          raise "timed out waiting for outer block" unless continue.pop(timeout: 10)
+          assert_raises(ActiveRecord::RecordNotFound) { other.get "/missing" }
+        end
+        other.get "/missing"
+        assert_equal 404, other.response.status
+      end
+      assert ready.pop(timeout: 10), "worker did not enter its block"
+      assert_raises(ActiveRecord::RecordNotFound) { session.get "/missing" }
+    end
+
+    session.get "/missing"
+    assert_equal 404, session.response.status
+    continue << true
+    worker.value
+    assert_absent
+  ensure
+    worker&.kill
+    worker&.join
+  end
+
+  private
+    def absent_book_path
+      book_slug_path(books(:manual))
+    end
+
+    def assert_absent
+      get absent_book_path
+      assert_response :not_found
+    end
+
+    def assert_missing_raises
+      assert_raises(ActiveRecord::RecordNotFound) { get absent_book_path }
+    end
+end
