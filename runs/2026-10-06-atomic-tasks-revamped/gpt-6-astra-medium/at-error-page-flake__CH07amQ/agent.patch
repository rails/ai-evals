@@ -0,0 +1,31 @@
+module RaisedExceptionsTestHelper
+  STATE_KEY = :writebook_test_raised_exceptions
+
+  def with_raised_exceptions
+    previous = ActiveSupport::IsolatedExecutionState[STATE_KEY]
+    ActiveSupport::IsolatedExecutionState[STATE_KEY] = true
+    yield
+  ensure
+    if previous.nil?
+      ActiveSupport::IsolatedExecutionState.delete(STATE_KEY)
+    else
+      ActiveSupport::IsolatedExecutionState[STATE_KEY] = previous
+    end
+  end
+
+  # Rails merges env_config over the request env, so an integration request's
+  # env: option cannot override this setting. Return a per-request copy instead
+  # of changing either the configuration or its memoized application defaults.
+  module RequestEnvironment
+    def env_config
+      defaults = super
+      if ActiveSupport::IsolatedExecutionState[STATE_KEY]
+        defaults.merge("action_dispatch.show_exceptions" => :none)
+      else
+        defaults
+      end
+    end
+  end
+end
+
+Rails.application.singleton_class.prepend(RaisedExceptionsTestHelper::RequestEnvironment)
