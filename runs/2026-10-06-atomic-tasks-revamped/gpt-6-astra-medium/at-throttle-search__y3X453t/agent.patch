diff --git a/app/models/book_search_rate_limiter.rb b/app/models/book_search_rate_limiter.rb
new file mode 100644
index 0000000..46d1039
--- /dev/null
+++ b/app/models/book_search_rate_limiter.rb
@@ -0,0 +1,46 @@
+# Search budgets are shared across books, but never across client addresses.
+class BookSearchRateLimiter
+  LIMIT = 30
+  WINDOW = 1.minute.to_i
+
+  # Prune, check and record atomically so concurrent web workers cannot exceed
+  # the budget. Only accepted requests are recorded; refusals never extend it.
+  REDIS_SCRIPT = <<~LUA
+    redis.call('ZREMRANGEBYSCORE', KEYS[1], '-inf', ARGV[1] - ARGV[2])
+    if redis.call('ZCARD', KEYS[1]) >= tonumber(ARGV[3]) then
+      return 0
+    end
+    redis.call('ZADD', KEYS[1], ARGV[1], ARGV[4])
+    redis.call('PEXPIRE', KEYS[1], ARGV[2])
+    return 1
+  LUA
+
+  def initialize(store: Rails.cache)
+    # Development/test may disable page caching. Search protection still needs
+    # a real store. Production uses the existing shared Redis cache.
+    @store = store.is_a?(ActiveSupport::Cache::NullStore) ? ActiveSupport::Cache::MemoryStore.new : store
+    @mutex = Mutex.new
+  end
+
+  def allow?(address)
+    key = "writebook:#{Rails.env}:book-search:v1:#{Digest::SHA256.hexdigest(address)}"
+    now = Time.current.to_f
+
+    if @store.is_a?(ActiveSupport::Cache::RedisCacheStore)
+      @store.redis.then do |redis|
+        redis.eval(REDIS_SCRIPT, keys: [ key ], argv: [ now * 1000, WINDOW * 1000, LIMIT, SecureRandom.uuid ]) == 1
+      end
+    else
+      # MemoryStore is used only within a single process (development/tests).
+      @mutex.synchronize do
+        requests = (@store.read(key) || []).select { |time| time > now - WINDOW }
+        if requests.size < LIMIT
+          @store.write(key, requests << now, expires_in: WINDOW)
+          true
+        else
+          false
+        end
+      end
+    end
+  end
+end
diff --git a/test/controllers/books/search_rate_limit_test.rb b/test/controllers/books/search_rate_limit_test.rb
new file mode 100644
index 0000000..8853b68
--- /dev/null
+++ b/test/controllers/books/search_rate_limit_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Books::SearchRateLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_limiter = Books::SearchesController.search_rate_limiter
+    Books::SearchesController.search_rate_limiter = BookSearchRateLimiter.new(store: ActiveSupport::Cache::MemoryStore.new)
+    books(:handbook).update!(published: true)
+    books(:manual).update!(published: true)
+    Leaf.reindex_all
+  end
+
+  teardown do
+    Books::SearchesController.search_rate_limiter = @original_limiter
+  end
+
+  test "an anonymous address gets thirty searches across books then a plain 429" do
+    30.times do |index|
+      search_from "198.51.100.1", book: index.even? ? books(:handbook) : books(:manual)
+      assert_response :success
+    end
+
+    search_from "198.51.100.1"
+    assert_response :too_many_requests
+    assert_nil response.headers["Location"]
+    assert_empty response.body
+  end
+
+  test "a refused address does not affect another anonymous reader or page access" do
+    30.times { search_from "198.51.100.1" }
+    search_from "198.51.100.1"
+    assert_response :too_many_requests
+
+    search_from "198.51.100.2"
+    assert_response :success
+    assert_select "a", text: /Thanks for reading/i
+    assert cookies[:session_token].blank?
+
+    get book_slug_path(books(:handbook)), env: { "REMOTE_ADDR" => "198.51.100.1" }
+    assert_response :success
+    get leafable_slug_path(leaves(:welcome_page)), env: { "REMOTE_ADDR" => "198.51.100.1" }
+    assert_response :success
+
+    search_from "198.51.100.1"
+    assert_response :too_many_requests
+  end
+
+  test "refused requests never execute a full text query" do
+    30.times { search_from "198.51.100.1" }
+    queries = []
+    subscriber = ->(event) { queries << event.payload[:sql] }
+
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      search_from "198.51.100.1"
+    end
+
+    assert_response :too_many_requests
+    assert_empty queries.grep(/MATCH/i)
+  end
+
+  test "the budget recovers automatically without refusals extending it" do
+    freeze_time do
+      30.times { search_from "198.51.100.1" }
+      search_from "198.51.100.1"
+      assert_response :too_many_requests
+
+      travel 59.seconds
+      search_from "198.51.100.1"
+      assert_response :too_many_requests
+
+      travel 2.seconds
+      search_from "198.51.100.1"
+      assert_response :success
+      assert_select "a", text: /Thanks for reading/i
+    end
+  end
+
+  test "the minute is rolling rather than a resetting counter" do
+    freeze_time do
+      search_from "198.51.100.1"
+      assert_response :success
+      travel 59.seconds
+      29.times do
+        search_from "198.51.100.1"
+        assert_response :success
+      end
+
+      travel 2.seconds
+      search_from "198.51.100.1"
+      assert_response :success
+      search_from "198.51.100.1"
+      assert_response :too_many_requests
+    end
+  end
+
+  private
+    def search_from(address, book: books(:handbook))
+      post book_search_path(book), params: { search: "Thanks" }, env: { "REMOTE_ADDR" => address }
+    end
+end
diff --git a/test/models/book_search_rate_limiter_test.rb b/test/models/book_search_rate_limiter_test.rb
new file mode 100644
index 0000000..f276660
--- /dev/null
+++ b/test/models/book_search_rate_limiter_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class BookSearchRateLimiterTest < ActiveSupport::TestCase
+  test "disabling page caching does not disable search limits" do
+    limiter = BookSearchRateLimiter.new(store: ActiveSupport::Cache::NullStore.new)
+
+    freeze_time do
+      30.times { assert limiter.allow?("198.51.100.1") }
+      assert_not limiter.allow?("198.51.100.1")
+      assert limiter.allow?("198.51.100.2")
+
+      travel 1.minute
+      assert limiter.allow?("198.51.100.1")
+    end
+  end
+
+  test "Redis receives serializable arguments and its atomic result decides admission" do
+    calls = []
+    results = [ 1, 0 ]
+    redis = Object.new
+    redis.define_singleton_method(:eval) do |script, keys:, argv:|
+      calls << [ script, keys, argv ]
+      results.shift
+    end
+    limiter = BookSearchRateLimiter.new(store: ActiveSupport::Cache::RedisCacheStore.new(redis: redis, pool: false))
+
+    assert limiter.allow?("198.51.100.1")
+    assert_not limiter.allow?("198.51.100.1")
+    assert_equal calls.first[1], calls.last[1]
+    assert_not_equal calls.first[2].last, calls.last[2].last
+    calls.each do |script, keys, argv|
+      assert_equal BookSearchRateLimiter::REDIS_SCRIPT, script
+      assert_equal 1, keys.size
+      assert_instance_of Float, argv[0]
+      assert_instance_of Integer, argv[1]
+      assert_equal [ 60_000, 30 ], argv[1..2]
+    end
+  end
+
+  test "concurrent requests cannot exceed the budget" do
+    limiter = BookSearchRateLimiter.new(store: ActiveSupport::Cache::MemoryStore.new)
+    threads = 10.times.map do
+      Thread.new { 10.times.count { limiter.allow?("198.51.100.1") } }
+    end
+
+    assert_equal 30, threads.sum(&:value)
+  end
+end
