index 0000000..6d3b749
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+    @ordered_leaves = @book.leaves.order(id: :desc).to_a
+    @ordered_leaves.zip([ -4.5, 2.25, 18, 90 ]).each do |leaf, score|
+      leaf.update_columns(position_score: score)
+    end
+  end
+
+  test "compaction preserves score order and is idempotent" do
+    2.times do
+      @book.compact_positions!
+
+      assert_equal @ordered_leaves.map(&:id), @book.leaves.positioned.ids
+      assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    end
+  end
+
+  test "equal scores are ordered by id" do
+    @ordered_leaves.first(2).each { |leaf| leaf.update_columns(position_score: -4.5) }
+    expected_ids = @ordered_leaves.first(2).map(&:id).sort + @ordered_leaves.drop(2).map(&:id)
+
+    @book.compact_positions!
+
+    assert_equal expected_ids, @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compaction preserves a trashed leaf's place when restored" do
+    trashed_leaf = @ordered_leaves.second
+    trashed_leaf.trashed!
+
+    @book.compact_positions!
+
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+    assert trashed_leaf.reload.trashed?
+    assert_equal @ordered_leaves.map(&:id) - [ trashed_leaf.id ], @book.leaves.active.positioned.ids
+
+    trashed_leaf.active!
+
+    assert_equal @ordered_leaves.map(&:id), @book.leaves.active.positioned.ids
+  end
+
+  test "compaction only changes leaves in the requested book" do
+    other_leaf = @ordered_leaves.pop
+    other_leaf.update_columns(book_id: books(:manual).id)
+
+    @book.compact_positions!
+
+    assert_equal 90, other_leaf.reload.position_score
+    assert_equal @ordered_leaves.map(&:id), @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compacting an empty book leaves other books unchanged" do
+    original_scores = @book.leaves.order(:id).pluck(:position_score)
+
+    books(:manual).compact_positions!
+
+    assert_empty books(:manual).leaves
+    assert_equal original_scores, @book.leaves.order(:id).pluck(:position_score)
+  end
+
+  test "live leaf count excludes trash and other books" do
+    @ordered_leaves.first.trashed!
+    @ordered_leaves.last.update_columns(book_id: books(:manual).id)
+
+    @book.compact_positions!
+
+    assert_equal 2, @book.live_leaf_count
+    assert_equal 1, books(:manual).live_leaf_count
+  end
+
+  test "live leaf count is zero for empty books and books with only trash" do
+    assert_equal 0, books(:manual).live_leaf_count
+
+    @book.leaves.update_all(status: :trashed)
+    @book.compact_positions!
+
+    assert_equal 0, @book.live_leaf_count
+    assert_equal @ordered_leaves.map(&:id), @book.leaves.positioned.ids
+  end
+
+  test "SQLite rejects unknown double quoted identifiers" do
+    assert_raises ActiveRecord::StatementInvalid do
+      Book.connection.select_value('SELECT "position_socre" FROM leaves LIMIT 1')
+    end
+  end
+end
