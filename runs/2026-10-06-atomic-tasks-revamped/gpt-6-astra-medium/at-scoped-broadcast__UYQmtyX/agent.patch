diff --git a/test/controllers/editor_presence_test.rb b/test/controllers/editor_presence_test.rb
new file mode 100644
index 0000000..fabc364
--- /dev/null
+++ b/test/controllers/editor_presence_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class EditorPresenceTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+  include ActionCable::TestHelper
+
+  setup do
+    @leaf = leaves(:welcome_page)
+    @book = books(:handbook)
+    sign_in :kevin
+  end
+
+  test "an open editor stops receiving presence after access is removed" do
+    stale_stream = editor_stream
+    @book.update_access(editors: [ users(:david).id ], readers: [])
+    sign_in :david
+
+    assert_no_broadcasts stale_stream do
+      save_page
+    end
+  end
+
+  test "authorized editors receive the unchanged indicator on their own stream" do
+    stream = editor_stream
+    assert_equal presence_stream(users(:kevin)), stream
+    sign_in :david
+
+    messages = capture_broadcasts(stream) { save_page }
+    assert_equal 1, messages.size
+    assert_includes messages.sole, %(action="append")
+    assert_includes messages.sole, %(target="being_edited_leaf_#{@leaf.id}")
+    assert_includes messages.sole, users(:david).name
+    assert_includes messages.sole, %(data-hide-from-user-id="#{users(:david).id}")
+    assert_includes messages.sole, %(data-controller="autoremove")
+  end
+
+  test "presence is never sent on the legacy shared stream or another page stream" do
+    shared_stream = [ @leaf.to_gid_param, :being_edited ].join(":")
+    other_page_stream = presence_stream(users(:kevin), leaves(:summary_page))
+
+    assert_no_broadcasts shared_stream do
+      assert_no_broadcasts other_page_stream do
+        save_page
+      end
+    end
+  end
+
+  test "queued presence uses current permissions after an editor is downgraded" do
+    stale_stream = editor_stream
+    sign_in :david
+    put leafable_path(@leaf), params: { page: { body: "A queued update" } }
+    assert_response :no_content
+
+    @book.update_access(editors: [ users(:david).id ], readers: [ users(:kevin).id ])
+
+    assert_no_broadcasts stale_stream do
+      assert_broadcasts presence_stream(users(:david)), 1 do
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "deactivated editors do not receive presence on an open stream" do
+    stale_stream = editor_stream
+    users(:kevin).deactivate
+    sign_in :david
+
+    assert_no_broadcasts stale_stream do
+      save_page
+    end
+  end
+
+  test "readers and unrelated users do not receive presence even for published books" do
+    @book.update! published: true, everyone_access: true
+    @book.update_access(editors: [ users(:kevin).id ], readers: [])
+
+    assert_no_broadcasts presence_stream(users(:jz)) do
+      save_page
+    end
+
+    accesses(:jz_handbook).destroy!
+    assert_no_broadcasts presence_stream(users(:jz)) do
+      save_page
+    end
+  end
+
+  test "administrators retain presence without explicit editor access" do
+    accesses(:david_handbook).update! level: :reader
+    sign_in :david
+    stream = editor_stream
+    sign_in :kevin
+
+    assert_broadcasts stream, 1 do
+      save_page
+    end
+  end
+
+  test "an unauthorized update does not enqueue presence" do
+    accesses(:kevin_handbook).update! level: :reader
+
+    assert_no_enqueued_jobs do
+      put leafable_path(@leaf), params: { page: { body: "Not allowed" } }
+      assert_response :forbidden
+    end
+  end
+
+  private
+    def presence_stream(user, leaf = @leaf)
+      [ leaf.to_gid_param, :being_edited, user.to_gid_param ].join(":")
+    end
+
+
+    def editor_stream
+      get edit_leafable_path(@leaf)
+      assert_response :success
+      source = css_select("turbo-cable-stream-source").sole
+      Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    end
+
+    def save_page
+      perform_enqueued_jobs do
+        put leafable_path(@leaf), params: { page: { body: "An updated page" } }
+        assert_response :no_content
+      end
+    end
+end
