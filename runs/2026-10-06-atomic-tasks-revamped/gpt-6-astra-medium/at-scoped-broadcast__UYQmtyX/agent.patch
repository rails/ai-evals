diff --git a/app/jobs/leaf_presence_job.rb b/app/jobs/leaf_presence_job.rb
new file mode 100644
index 0000000..24a105f
--- /dev/null
+++ b/app/jobs/leaf_presence_job.rb
@@ -0,0 +1,12 @@
+class LeafPresenceJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(leaf, user)
+    # Resolve recipients at delivery time: revoked editors may still be subscribed.
+    editors = User.active.where(id: leaf.book.accesses.editor.select(:user_id))
+    editors.or(User.active.administrator).find_each do |recipient|
+      Turbo::StreamsChannel.broadcast_render_to leaf, :being_edited, recipient,
+        partial: "leaves/being_edited_by", locals: { leaf: leaf, user: user }
+    end
+  end
+end
