diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..a173c77 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,25 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :remember_publication, if: -> { saved_change_to_published?(to: true) }
+    after_commit :announce_publication
+    after_rollback :forget_publication
   end
 
   private
+    def remember_publication
+      # Later saves and leaf touches replace dirty tracking before the commit.
+      @publication_pending = true
+    end
+
     def announce_publication
-      AnnouncePublicationJob.perform_later self
+      pending = @publication_pending
+      forget_publication
+
+      AnnouncePublicationJob.perform_later self if pending && self.class.published.exists?(id)
+    end
+
+    def forget_publication
+      @publication_pending = false
     end
 end
