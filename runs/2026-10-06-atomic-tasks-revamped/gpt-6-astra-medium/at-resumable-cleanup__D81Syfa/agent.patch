 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  # Resque does not support delayed retries without resque-scheduler.
+  self.resume_options = {}
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :clean_titles do |step|
+      Leaf.find_each(start: step.cursor, order: :asc) do |leaf|
+        leaf.update!(title: cleaned(leaf.title))
+        # find_each's start is inclusive, so resume at the next possible ID.
+        step.advance! from: leaf.id
+      end
     end
   end
 
diff --git a/lib/rails_ext/resque_active_job_continuations.rb b/lib/rails_ext/resque_active_job_continuations.rb
new file mode 100644
index 0000000..5609d80
--- /dev/null
+++ b/lib/rails_ext/resque_active_job_continuations.rb
@@ -0,0 +1,13 @@
+require "resque"
+
+# Workers run with FORK_PER_JOB=false (see Procfile), so the shutdown signal
+# and Active Job checkpoints share a process. Let continuable jobs requeue
+# their progress instead of holding up shutdown until the entire job finishes.
+module ResqueActiveJobContinuations
+  def shutdown
+    ActiveJob::Base.queue_adapter.stopping = true
+    super
+  end
+end
+
+Resque::Worker.prepend ResqueActiveJobContinuations
diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..6050941
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  setup do
+    @leaves = Leaf.order(:id).to_a
+    @titles = [ '"Welcome" to the handbook', 'A "quoted" phrase', '"Summary"', "Reading" ]
+    @leaves.zip(@titles).each do |leaf, title|
+      leaf.update!(title: %("#{title}"))
+    end
+  end
+
+  teardown do
+    queue_adapter.stopping = false
+  end
+
+  test "cleans only the outer quotes" do
+    TitleCleanupJob.perform_now
+
+    assert_equal @titles, @leaves.map { |leaf| leaf.reload.title }
+  end
+
+  test "resumes after the last cleaned leaf without stripping inner quotes" do
+    queue_adapter.stopping = true
+
+    assert_enqueued_jobs 1, only: TitleCleanupJob do
+      TitleCleanupJob.perform_now
+    end
+
+    assert_equal @titles.first, @leaves.first.reload.title
+    @leaves.drop(1).zip(@titles.drop(1)).each do |leaf, title|
+      assert_equal %("#{title}"), leaf.reload.title
+    end
+
+    queue_adapter.stopping = false
+    perform_enqueued_jobs
+
+    assert_equal @titles, @leaves.map { |leaf| leaf.reload.title }
+  end
+
+  test "resumes across repeated interruptions with sparse IDs" do
+    queue_adapter.stopping = true
+    TitleCleanupJob.perform_now
+
+    @leaves.each_with_index do |leaf, index|
+      assert_equal @titles[index], leaf.reload.title
+      assert_equal 1, enqueued_jobs.size
+      continuation = enqueued_jobs.first.fetch("continuation")
+      assert_equal [ "clean_titles", leaf.id + 1 ], continuation.fetch("current")
+      assert_nil enqueued_jobs.first["scheduled_at"]
+
+      # Round trip the payload, just as a new worker would after a deploy.
+      payload = enqueued_jobs.shift.select { |key, _| key.is_a?(String) }
+      ActiveJob::Base.execute(JSON.parse(payload.to_json))
+    end
+
+    assert_empty enqueued_jobs
+    assert_equal @titles, @leaves.map { |leaf| leaf.reload.title }
+  end
+
+  test "a failed update is retried without redoing earlier leaves" do
+    failing_leaf = @leaves.third
+    fail_update = ->(leaf) { raise "interrupted update" if leaf.id == failing_leaf.id }
+
+    with_leaf_update_callback(fail_update) do
+      assert_enqueued_jobs 1, only: TitleCleanupJob do
+        TitleCleanupJob.perform_now
+      end
+    end
+
+    assert_equal [ "clean_titles", @leaves.second.id + 1 ], enqueued_jobs.first.fetch("continuation").fetch("current")
+    assert_equal %("#{@titles.third}"), failing_leaf.reload.title
+
+    perform_enqueued_jobs
+
+    assert_equal @titles, @leaves.map { |leaf| leaf.reload.title }
+  end
+
+  test "an interruption during an update rolls back and retries that leaf" do
+    interrupted_leaf = @leaves.second
+    interrupt_update = ->(leaf) do
+      raise ActiveJob::Continuation::Interrupt if leaf.id == interrupted_leaf.id
+    end
+
+    with_leaf_update_callback(interrupt_update, timing: :after) do
+      assert_enqueued_jobs 1, only: TitleCleanupJob do
+        TitleCleanupJob.perform_now
+      end
+    end
+
+    assert_equal @titles.first, @leaves.first.reload.title
+    assert_equal %("#{@titles.second}"), interrupted_leaf.reload.title
+
+    perform_enqueued_jobs
+
+    assert_equal @titles, @leaves.map { |leaf| leaf.reload.title }
+  end
+
+  test "a completed continuation does not clean titles again" do
+    job = TitleCleanupJob.new
+    job.perform_now
+    ActiveJob::Base.execute(JSON.parse(job.serialize.to_json))
+
+    assert_equal @titles, @leaves.map { |leaf| leaf.reload.title }
+    assert_empty enqueued_jobs
+  end
+
+  test "an empty collection completes without requeueing" do
+    Leaf.destroy_all
+
+    assert_no_enqueued_jobs do
+      TitleCleanupJob.perform_now
+    end
+  end
+
+  test "Resque shutdown stops cleanup at the next leaf checkpoint" do
+    worker = Resque::Worker.new("default")
+    worker.shutdown
+
+    assert worker.shutdown?
+    assert queue_adapter.stopping?
+    assert_enqueued_jobs 1, only: TitleCleanupJob do
+      TitleCleanupJob.perform_now
+    end
+    assert_equal @titles.first, @leaves.first.reload.title
+    assert_equal %("#{@titles.second}"), @leaves.second.reload.title
+  end
+
+  private
+    def with_leaf_update_callback(callback, timing: :before)
+      Leaf.set_callback(:update, timing, callback)
+      yield
+    ensure
+      Leaf.skip_callback(:update, timing, callback)
+    end
+end
