+require "test_helper"
+
+class PictureProcessingTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+  include ActiveSupport::Testing::NotificationAssertions
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "readers reuse the background variant of a WebP upload" do
+    assert_background_variant_reused file_fixture("white-rabbit.webp"), "image/webp"
+  end
+
+  %w[ jpeg png ].each do |format|
+    test "readers reuse the background variant of an oversized #{format} upload" do
+      Tempfile.create([ "photograph", ".#{format}" ]) do |source|
+        image = Vips::Image.xyz(1800, 900).cast("uchar").bandjoin(128)
+        image = image.bandjoin(128) if format == "png" # Exercise transparency as well.
+        image.write_to_file(source.path)
+
+        assert_background_variant_reused source.path, "image/#{format}"
+      end
+    end
+  end
+
+  private
+    def assert_background_variant_reused(source, content_type)
+      expected_bytes = reader_bytes_before_fix(source)
+
+      assert_notifications_count "transform.active_storage", 1 do
+        # Only the original upload and its one derived copy should reach storage.
+        assert_notifications_count "service_upload.active_storage", 2 do
+          perform_enqueued_jobs do
+            put leafable_path(leaves(:reading_picture)), params: {
+              picture: { image: fixture_file_upload(source, content_type) }
+            }
+            assert_response :no_content
+          end
+        end
+      end
+
+      blob = leaves(:reading_picture).reload.picture.image.blob
+      assert_equal 1, blob.variant_records.count
+      derived = blob.variant_records.sole.image.blob
+      assert blob.service.exist?(derived.key)
+      assert_equal expected_bytes, derived.download
+
+      books(:handbook).update!(published: true)
+      sign_out
+
+      assert_no_notifications "transform.active_storage" do
+        assert_no_notifications "service_upload.active_storage" do
+          assert_no_difference [ "ActiveStorage::VariantRecord.count", "ActiveStorage::Blob.count" ] do
+            # Retried jobs must also find the same stored copy.
+            perform_enqueued_jobs do
+              ActiveStorage::TransformJob.perform_later(blob, Picture.attachment_reflections["image"].named_variants[:large].transformations)
+            end
+
+            2.times do
+              get leafable_slug_path(leaves(:reading_picture))
+              assert_response :success
+              image_path = css_select("figure.page--picture img").sole["src"]
+
+              get image_path
+              assert_response :redirect
+              follow_redirect!
+              assert_response :success
+              assert_equal "image/webp", response.media_type
+              assert_equal expected_bytes, response.body.b
+            end
+          end
+        end
+      end
+
+      assert_equal [ derived.id ], blob.variant_records.reload.map { |variant| variant.image.blob_id }
+    end
+
+    def reader_bytes_before_fix(source)
+      # Readers decode the signed URL, which turns the original :webp into "webp".
+      legacy = ActiveStorage::Variation.new(resize_to_limit: [ 1500, 1500 ], format: :webp)
+      variation = ActiveStorage::Variation.decode(legacy.key)
+      File.open(source, "rb") do |input|
+        variation.transform(input) { |output| output.read }
+      end
+    end
+end
