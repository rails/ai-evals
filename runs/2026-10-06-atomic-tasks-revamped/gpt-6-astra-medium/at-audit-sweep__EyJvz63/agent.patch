diff --git a/test/integration/security_regressions_test.rb b/test/integration/security_regressions_test.rb
new file mode 100644
index 0000000..c55d063
--- /dev/null
+++ b/test/integration/security_regressions_test.rb
@@ -0,0 +1,199 @@
+require "test_helper"
+
+class SecurityRegressionsTest < ActionDispatch::IntegrationTest
+  test "profile edits cannot grant roles but still update personal details" do
+    sign_in :kevin
+
+    patch user_profile_path(users(:kevin)), params: { user: {
+      name: "Updated Member", email_address: "updated@example.com",
+      password: "new-secret123456", role: "administrator"
+    } }
+
+    assert_redirected_to users_path
+    user = users(:kevin).reload
+    assert user.member?
+    assert_equal "Updated Member", user.name
+    assert_equal "updated@example.com", user.email_address
+    assert user.authenticate("new-secret123456")
+  end
+
+  test "administrators can still edit their personal details" do
+    sign_in :david
+    patch user_profile_path(users(:david)), params: { user: {
+      name: "Updated Admin", email_address: "admin@example.com", password: "new-secret123456"
+    } }
+
+    assert_redirected_to users_path
+    user = users(:david).reload
+    assert user.administrator?
+    assert_equal "Updated Admin", user.name
+    assert_equal "admin@example.com", user.email_address
+    assert user.authenticate("new-secret123456")
+  end
+
+  test "members cannot change anyone's role through either update endpoint" do
+    sign_in :kevin
+    original_roles = User.order(:id).pluck(:role)
+
+    [ :kevin, :jz, :david ].each do |target|
+      patch user_path(users(target)), params: { user: { role: "administrator" } }
+      assert_response :forbidden
+
+      unless target == :kevin
+        patch user_profile_path(users(target)), params: { user: { role: "administrator" } }
+        assert_response :forbidden
+      end
+      assert_equal original_roles, User.order(:id).pluck(:role)
+    end
+  end
+
+  test "administrators can grant and revoke roles" do
+    sign_in :david
+    %w[ administrator member ].each do |role|
+      patch user_path(users(:kevin)), params: { user: { role: role } }
+      assert_redirected_to users_path
+      assert_equal role, users(:kevin).reload.role
+    end
+  end
+
+  test "joining cannot grant an administrator role" do
+    post join_path(accounts(:signal).join_code), params: { user: {
+      name: "New Member", email_address: "new@example.com", password: "secret123456", role: "administrator"
+    } }
+    assert_redirected_to root_path
+    assert User.find_by!(email_address: "new@example.com").member?
+  end
+
+  [ :reader, :public_reader ].each do |access|
+    test "#{access} cannot change or delete a book" do
+      if access == :reader
+        sign_in :jz
+      else
+        sign_in :kevin
+        books(:manual).update!(published: true)
+      end
+      book = books(:manual)
+      original_accesses = book.accesses.order(:id).pluck(:user_id, :level)
+
+      patch book_path(book), params: { book: { title: "Taken over" }, editor_ids: [ users(:kevin).id ] }
+      assert_response :forbidden
+      assert_equal "Manual", book.reload.title
+      assert_equal original_accesses, book.accesses.order(:id).pluck(:user_id, :level)
+
+      assert_no_difference -> { Book.count } do
+        delete book_path(book)
+      end
+      assert_response :forbidden
+    end
+  end
+
+  test "editors can change and delete books" do
+    sign_in :kevin
+    book = books(:handbook)
+    patch book_path(book), params: { book: { title: "Updated Handbook" } }
+    assert_redirected_to book_slug_path(book.reload)
+    assert_equal "Updated Handbook", book.title
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(book)
+    end
+    assert_redirected_to root_path
+  end
+
+  test "ordinary search returns only active leaves in readable books" do
+    sign_in :kevin
+    leaves(:summary_page).update!(book: books(:manual), title: "Welcome Secret")
+    leaves(:welcome_section).trashed!
+
+    get library_search_path, params: { q: "  welcome  " }
+    assert_response :success
+    assert_search_results leaves(:welcome_page)
+
+    books(:manual).update!(published: true)
+    get library_search_path, params: { q: "welcome" }
+    assert_response :success
+    assert_search_results leaves(:welcome_page), leaves(:summary_page)
+  end
+
+  test "anonymous search only returns published books and handles no readable books" do
+    leaves(:summary_page).update!(book: books(:manual), title: "Welcome Secret")
+    get library_search_path, params: { q: "welcome" }
+    assert_response :success
+    assert_search_results
+
+    books(:handbook).update!(published: true)
+    get library_search_path, params: { q: "welcome" }
+    assert_response :success
+    assert_search_results leaves(:welcome_page), leaves(:welcome_section)
+  end
+
+  test "search with no query or only whitespace returns no results" do
+    sign_in :kevin
+    [ nil, "", "   " ].each do |query|
+      get library_search_path, params: { q: query }
+      assert_response :success
+      assert_search_results
+    end
+  end
+
+  [ "Reader's guide", "' OR 1=1 --", "') OR 1=1 OR leaves.title LIKE ('", "%", "_", "Save 50% off", "file_name", "!", "\\", "!%_\\" ].each do |term|
+    test "search treats #{term.inspect} as literal data" do
+      sign_in :kevin
+      leaves(:welcome_page).update!(title: "Literal #{term} title")
+      leaves(:summary_page).update!(book: books(:manual), title: "Private #{term} title")
+
+      get library_search_path, params: { q: term }
+      assert_response :success
+      assert_search_results leaves(:welcome_page)
+    end
+  end
+
+  [ true, false ].each do |signed_in|
+    [ :html, :md ].each do |format|
+      test "pages cannot be borrowed from another book when signed_in=#{signed_in} in #{format}" do
+        sign_in :kevin if signed_in
+        books(:handbook).update!(published: true)
+        leaf = leaves(:summary_page)
+        leaf.update!(book: books(:manual))
+
+        get slugged_leafable_path(books(:handbook), books(:handbook).slug, leaf, leaf.slug, format: format)
+        assert_response :not_found
+
+        get book_page_path(books(:handbook), leaf, format: format)
+        assert_response :not_found
+
+        get leafable_slug_path(leaf, format: format)
+        assert_response :not_found
+
+        books(:manual).update!(published: true)
+        get leafable_slug_path(leaf, format: format)
+        assert_response :success
+
+        get book_page_path(books(:manual), leaf, format: format)
+        assert_response :success
+      end
+    end
+  end
+
+  test "cross-book leaf updates and deletions are rejected" do
+    sign_in :kevin
+    leaf = leaves(:summary_page)
+    leaf.update!(book: books(:manual))
+
+    patch book_page_path(books(:handbook), leaf), params: { leaf: { title: "Taken over" } }
+    assert_response :not_found
+    assert_equal "Summary", leaf.reload.title
+
+    delete book_page_path(books(:handbook), leaf)
+    assert_response :not_found
+    assert leaf.reload.active?
+  end
+
+  private
+    def assert_search_results(*leaves)
+      assert_select "a.search__result", count: leaves.size
+      leaves.each do |leaf|
+        assert_select "a.search__result[href=?]", leafable_slug_path(leaf), count: 1
+      end
+    end
+end
