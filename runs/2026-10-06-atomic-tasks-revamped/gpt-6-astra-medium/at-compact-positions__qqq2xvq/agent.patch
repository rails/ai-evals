index 0000000..0daef98
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+    # Deliberately disagree with ID order, with gaps and tied scores.
+    @ordered_leaves = @book.leaves.order(id: :desc).to_a
+    @ordered_leaves.each_with_index do |leaf, index|
+      leaf.update_columns(position_score: [ -10, 5.5, 5.5, 100 ][index])
+    end
+    @expected_ids = @book.leaves.positioned.ids
+  end
+
+  test "compaction preserves score and ID order while making scores dense" do
+    @book.compact_positions!
+
+    assert_equal @expected_ids, @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+
+    @book.compact_positions!
+
+    assert_equal @expected_ids, @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compaction preserves the place of a trashed leaf when restored" do
+    trashed_leaf = @book.leaves.positioned.second
+    trashed_leaf.trashed!
+
+    @book.compact_positions!
+
+    assert trashed_leaf.reload.trashed?
+    assert_equal @expected_ids - [ trashed_leaf.id ], @book.leaves.active.positioned.ids
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+
+    trashed_leaf.active!
+
+    assert_equal @expected_ids, @book.leaves.active.positioned.ids
+  end
+
+  test "compaction is scoped to the book" do
+    other_leaf = @ordered_leaves.first
+    other_leaf.update_columns(book_id: books(:manual).id, position_score: 99)
+
+    @book.compact_positions!
+
+    assert_equal 99, other_leaf.reload.position_score
+    assert_equal @expected_ids - [ other_leaf.id ], @book.leaves.positioned.ids
+    assert_equal [ 1, 2, 3 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compaction handles an empty book" do
+    books(:manual).compact_positions!
+
+    assert_empty books(:manual).leaves
+    assert_equal @expected_ids, @book.leaves.positioned.ids
+  end
+
+  test "live leaf count excludes trash and other books" do
+    @ordered_leaves.first.trashed!
+    @ordered_leaves.last.update_columns(book_id: books(:manual).id)
+
+    assert_equal 2, @book.live_leaf_count
+    assert_equal 1, books(:manual).live_leaf_count
+
+    @book.compact_positions!
+
+    assert_equal 2, @book.live_leaf_count
+    @book.leaves.update_all(status: :trashed)
+    assert_equal 0, @book.live_leaf_count
+  end
+
+  test "unknown double quoted identifiers raise instead of becoming string literals" do
+    assert_raises ActiveRecord::StatementInvalid do
+      Book.connection.select_all('SELECT "position_socre" FROM leaves')
+    end
+  end
+end
