diff --git a/app/jobs/leaf/being_edited_job.rb b/app/jobs/leaf/being_edited_job.rb
new file mode 100644
index 0000000..e200d66
--- /dev/null
+++ b/app/jobs/leaf/being_edited_job.rb
@@ -0,0 +1,14 @@
+class Leaf::BeingEditedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(leaf, user)
+    content = ApplicationController.render partial: "leaves/being_edited_by",
+      formats: [ :turbo_stream ], locals: { leaf: leaf, user: user }
+
+    # Resolve recipients at delivery time, not when the save enqueues this job.
+    # Revoked editors may still be subscribed, so never broadcast to a shared stream.
+    leaf.book.editors.find_each do |editor|
+      Turbo::StreamsChannel.broadcast_stream_to leaf, editor, :being_edited, content: content
+    end
+  end
+end
