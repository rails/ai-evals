diff --git a/test/controllers/being_edited_indicator_test.rb b/test/controllers/being_edited_indicator_test.rb
new file mode 100644
index 0000000..290926e
--- /dev/null
+++ b/test/controllers/being_edited_indicator_test.rb
@@ -0,0 +1,133 @@
+require "test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+  include ActiveJob::TestHelper
+
+  setup do
+    @leaf = leaves(:welcome_page)
+    @book = @leaf.book
+    @book.update! everyone_access: false
+    sign_in :kevin
+    @kevin_stream = editor_stream
+    sign_in :david
+    @david_stream = editor_stream
+  end
+
+  test "each editor subscribes to a separate presence stream" do
+    assert_not_equal @kevin_stream, @david_stream
+  end
+
+  test "saving delivers the existing indicator to current editors but not the shared stream" do
+    shared_stream = Turbo::StreamsChannel.send(:stream_name_from, [ @leaf, :being_edited ])
+
+    assert_no_broadcasts shared_stream do
+      assert_broadcasts @kevin_stream, 1 do
+        assert_broadcasts @david_stream, 1 do
+          perform_enqueued_jobs { save_page }
+        end
+      end
+    end
+
+    payload = JSON.parse(broadcasts(@kevin_stream).last)
+    assert_includes payload, 'action="append"'
+    assert_includes payload, "being_edited_leaf_#{@leaf.id}"
+    assert_includes payload, users(:david).name
+    assert_includes payload, "data-hide-from-user-id=\"#{users(:david).id}\""
+    assert_includes payload, "animationend-&gt;autoremove#remove"
+  end
+
+  test "removed collaborators receive nothing on their already open editor stream" do
+    @book.update_access editors: [ users(:david).id ], readers: []
+
+    assert_no_broadcasts @kevin_stream do
+      assert_broadcasts @david_stream, 1 do
+        perform_enqueued_jobs { save_page }
+      end
+    end
+  end
+
+  test "downgraded readers receive nothing on their already open editor stream" do
+    @book.update_access editors: [ users(:david).id ], readers: [ users(:kevin).id ]
+
+    assert_no_broadcasts @kevin_stream do
+      perform_enqueued_jobs { save_page }
+    end
+  end
+
+  test "access is checked when queued presence is delivered" do
+    save_page
+    @book.update_access editors: [ users(:david).id ], readers: []
+
+    assert_no_broadcasts @kevin_stream do
+      assert_broadcasts @david_stream, 1 do
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "inactive editors receive nothing on their already open editor stream" do
+    users(:kevin).deactivate
+
+    assert_no_broadcasts @kevin_stream do
+      assert_broadcasts @david_stream, 1 do
+        perform_enqueued_jobs { save_page }
+      end
+    end
+  end
+
+  test "administrators receive presence without an editor access" do
+    accesses(:david_handbook).reader!
+    accesses(:jason_handbook).destroy!
+    jason_stream = presence_stream(@leaf, users(:jason))
+
+    assert_broadcasts @david_stream, 1 do
+      assert_broadcasts jason_stream, 1 do
+        perform_enqueued_jobs { save_page }
+      end
+    end
+  end
+
+  test "inactive administrators receive no presence" do
+    users(:jason).deactivate
+
+    assert_no_broadcasts presence_stream(@leaf, users(:jason)) do
+      perform_enqueued_jobs { save_page }
+    end
+  end
+
+  test "presence does not reach readers or other pages" do
+    assert_no_broadcasts presence_stream(@leaf, users(:jz)) do
+      assert_no_broadcasts presence_stream(leaves(:summary_page), users(:kevin)) do
+        perform_enqueued_jobs { save_page }
+      end
+    end
+  end
+
+  test "unauthorized saves do not enqueue presence" do
+    accesses(:kevin_handbook).reader!
+    sign_in :kevin
+
+    assert_no_enqueued_jobs do
+      put leafable_path(@leaf), params: { page: { body: "Not allowed" } }
+      assert_response :forbidden
+    end
+  end
+
+  private
+    def presence_stream(leaf, user)
+      Turbo::StreamsChannel.send(:stream_name_from, [ leaf, user, :being_edited ])
+    end
+
+    def editor_stream
+      get edit_leafable_path(@leaf)
+      assert_response :ok
+      source = css_select("turbo-cable-stream-source").sole
+      Turbo::StreamsChannel.verified_stream_name(source["signed-stream-name"])
+    end
+
+    def save_page
+      put leafable_path(@leaf), params: { leaf: { title: "Updated welcome" }, page: { body: "Updated content" } }
+      assert_response :no_content
+    end
+end
