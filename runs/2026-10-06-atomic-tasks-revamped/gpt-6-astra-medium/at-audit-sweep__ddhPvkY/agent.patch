diff --git a/test/integration/security_findings_test.rb b/test/integration/security_findings_test.rb
new file mode 100644
index 0000000..49f9b90
--- /dev/null
+++ b/test/integration/security_findings_test.rb
@@ -0,0 +1,214 @@
+require "test_helper"
+
+class SecurityFindingsTest < ActionDispatch::IntegrationTest
+  test "members can update their profile but cannot assign themselves a role" do
+    sign_in :kevin
+
+    patch user_profile_path(users(:kevin)), params: { user: {
+      name: "Updated Kevin", email_address: "updated@example.com", password: "new-password", role: "administrator"
+    } }
+
+    assert_redirected_to users_path
+    user = users(:kevin).reload
+    assert user.member?
+    assert_equal "Updated Kevin", user.name
+    assert_equal "updated@example.com", user.email_address
+    assert user.authenticate("new-password")
+  end
+
+  test "members cannot change anyone's role through user or profile endpoints" do
+    sign_in :kevin
+    roles = User.order(:id).pluck(:role)
+
+    [ :kevin, :jz, :david ].each do |target|
+      patch user_path(users(target)), params: { user: { role: "administrator" } }
+      assert_response :forbidden
+      assert_equal roles, User.order(:id).pluck(:role)
+    end
+
+    [ :jz, :david ].each do |target|
+      patch user_profile_path(users(target)), params: { user: { role: "administrator" } }
+      assert_response :forbidden
+      assert_equal roles, User.order(:id).pluck(:role)
+    end
+  end
+
+  test "joining cannot assign an administrator role" do
+    post join_path(accounts(:signal).join_code), params: { user: {
+      name: "New Member", email_address: "new-member@example.com", password: "secret123456", role: "administrator"
+    } }
+
+    assert_redirected_to root_path
+    assert User.find_by!(email_address: "new-member@example.com").member?
+  end
+
+  test "administrators can still grant and revoke roles and update their profile" do
+    sign_in :david
+    %w[ administrator member ].each do |role|
+      patch user_path(users(:kevin)), params: { user: { role: role } }
+      assert_redirected_to users_path
+      assert_equal role, users(:kevin).reload.role
+    end
+
+    patch user_profile_path(users(:david)), params: { user: {
+      name: "Updated David", email_address: "updated-admin@example.com", password: "new-password"
+    } }
+    assert_redirected_to users_path
+    user = users(:david).reload
+    assert user.administrator?
+    assert_equal "Updated David", user.name
+    assert_equal "updated-admin@example.com", user.email_address
+    assert user.authenticate("new-password")
+  end
+
+  test "readers cannot change or destroy a book" do
+    sign_in :jz
+    assert_book_read_only books(:handbook)
+  end
+
+  test "publication does not grant signed in strangers edit or delete permission" do
+    books(:manual).update!(published: true)
+    sign_in :kevin
+    assert_book_read_only books(:manual)
+  end
+
+  test "member editors can still update and destroy books" do
+    sign_in :kevin
+    patch book_path(books(:handbook)), params: { book: { title: "Updated handbook" } }
+    assert_redirected_to book_slug_path(books(:handbook).reload)
+    assert_equal "Updated handbook", books(:handbook).title
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+    assert_redirected_to root_path
+  end
+
+  test "library search only returns readable active leaves" do
+    leaves(:summary_page).update!(book: books(:manual), title: "Welcome private")
+    leaves(:reading_picture).trashed!
+    sign_in :kevin
+
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_select "a.search__result", count: 2
+    assert_not_in_body "Welcome private"
+
+    get library_search_path, params: { q: "Reading" }
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+
+  test "SQL syntax in a library search is data and cannot bypass book permissions" do
+    leaves(:summary_page).update!(book: books(:manual), title: "Private sentinel")
+    sign_in :kevin
+
+    [ "' OR 1=1 OR leaves.title LIKE '", "' OR 1=1 --", "' UNION SELECT * FROM leaves --", "%' OR books.id > 0 --" ].each do |term|
+      get library_search_path, params: { q: term }
+      assert_response :success
+      assert_select "a.search__result", count: 0
+      assert_not_in_body "Private sentinel"
+    end
+  end
+
+  test "apostrophes and LIKE metacharacters are searched literally" do
+    leaves(:welcome_page).update!(title: "Welcome")
+    sign_in :kevin
+
+    {
+      "Reader's guide" => [ "Reader's", "'" ],
+      "Save 50% off" => [ "Save 50% off", "%" ],
+      "snake_case" => [ "snake_case", "_" ],
+      "100%_done!" => [ "%_", "!" ],
+      'path\\file' => [ "path\\", "\\" ]
+    }.each do |title, terms|
+      leaves(:summary_page).update!(title: title)
+      terms.each do |term|
+        get library_search_path, params: { q: term }
+        assert_response :success
+        assert_select "a.search__result", count: 1
+        assert_select "a.search__result[href=?]", leafable_slug_path(leaves(:summary_page))
+      end
+    end
+  end
+
+  test "signed out search only returns published books and blank searches are empty" do
+    leaves(:summary_page).update!(book: books(:manual), title: "Welcome public")
+
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_select "a.search__result", count: 0
+
+    books(:manual).update!(published: true)
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_select "a.search__result", count: 1
+    assert_select "a.search__result[href=?]", leafable_slug_path(leaves(:summary_page))
+
+    [ nil, "", "   " ].each do |term|
+      get library_search_path, params: { q: term }
+      assert_response :success
+      assert_select "a.search__result", count: 0
+    end
+  end
+
+  test "private pages cannot be read under a readable book id" do
+    leaves(:summary_page).update!(book: books(:manual))
+    sign_in :kevin
+
+    assert_page_is_hidden leaves(:summary_page), under: books(:handbook)
+    get leafable_slug_path(leaves(:summary_page))
+    assert_response :not_found
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+  end
+
+  test "signed out readers cannot disguise private pages as published pages" do
+    books(:handbook).update!(published: true)
+    leaves(:summary_page).update!(book: books(:manual))
+
+    assert_page_is_hidden leaves(:summary_page), under: books(:handbook)
+    get leafable_slug_path(leaves(:summary_page))
+    assert_response :not_found
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+    get book_page_path(books(:handbook), leaves(:welcome_page))
+    assert_response :success
+  end
+
+  test "an editor cannot modify a private page by supplying an editable book id" do
+    leaf = leaves(:summary_page)
+    leaf.update!(book: books(:manual))
+    sign_in :kevin
+
+    patch book_page_path(books(:handbook), leaf), params: { leaf: { title: "Unauthorized" } }
+    assert_response :not_found
+    assert_equal "Summary", leaf.reload.title
+
+    delete book_page_path(books(:handbook), leaf)
+    assert_response :not_found
+    assert leaf.reload.active?
+  end
+
+  private
+    def assert_book_read_only(book)
+      title = book.title
+      patch book_path(book), params: { book: { title: "Unauthorized" } }
+      assert_response :forbidden
+      assert_equal title, book.reload.title
+
+      assert_no_difference -> { Book.count } do
+        delete book_path(book)
+      end
+      assert_response :forbidden
+    end
+
+    def assert_page_is_hidden(leaf, under:)
+      [ book_page_path(under, leaf), slugged_leafable_path(under, under.slug, leaf, leaf.slug) ].each do |path|
+        [ :html, :md ].each do |format|
+          get "#{path}.#{format}"
+          assert_response :not_found
+        end
+      end
+    end
+end
