diff --git a/test/integration/picture_processing_test.rb b/test/integration/picture_processing_test.rb
new file mode 100644
index 0000000..510d223
--- /dev/null
+++ b/test/integration/picture_processing_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class PictureProcessingTest < ActionDispatch::IntegrationTest
+  test "a small WebP is processed once without upscaling" do
+    assert_processed_once fixture_file_upload("white-rabbit.webp", "image/webp"), dimensions: [ 436, 600 ]
+  end
+
+  test "a large JPEG is processed once and resized" do
+    Tempfile.create([ "picture", ".jpg" ]) do |file|
+      Vips::Image.new_from_file(file_fixture("white-rabbit.webp").to_s).resize(4).write_to_file(file.path)
+      assert_processed_once fixture_file_upload(file.path, "image/jpeg"), dimensions: [ 1090, 1500 ]
+    end
+  end
+
+  private
+    def assert_processed_once(upload, dimensions:)
+      sign_in :kevin
+      transformations = []
+      uploads = []
+      transform_subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") do |event|
+        transformations << event
+      end
+      upload_subscriber = ActiveSupport::Notifications.subscribe("service_upload.active_storage") do |event|
+        uploads << event.payload[:key]
+      end
+
+      perform_enqueued_jobs(only: [ ActiveStorage::CreateVariantsJob, ActiveStorage::TransformJob ]) do
+        put leafable_path(leaves(:reading_picture)), params: {
+          picture: { image: upload }
+        }
+        assert_response :no_content
+      end
+
+      blob = leaves(:reading_picture).reload.picture.image.blob
+      assert_equal 1, transformations.size, "The upload should be transformed in the background"
+      assert_equal 1, blob.variant_records.count
+      derived_blob = blob.variant_records.sole.image.blob
+      assert blob.service.exist?(derived_blob.key)
+      assert_equal [ blob.key, derived_blob.key ].sort, uploads.sort
+
+      # Render the old URL-decoded recipe independently, without storing a variant.
+      # Comparing downloads alone would miss a change to the output of both paths.
+      legacy_variant = blob.variant(resize_to_limit: [ 1500, 1500 ], format: :webp)
+      legacy_variation = ActiveStorage::Variation.decode(legacy_variant.variation.key)
+      expected_bytes = blob.open do |input|
+        legacy_variation.transform(input) { |output| output.read }
+      end
+
+      books(:handbook).update!(published: true)
+      sign_out
+      transformations.clear
+      uploads.clear
+
+      # A retried background job must also reuse the stored variant.
+      perform_enqueued_jobs(only: ActiveStorage::TransformJob) do
+        ActiveStorage::TransformJob.perform_later(blob, leaves(:reading_picture).picture.large_image.variation.transformations)
+      end
+
+      2.times do
+        get leafable_slug_path(leaves(:reading_picture))
+        assert_response :success
+        image_path = css_select(".page--picture img").sole["src"]
+        get URI(image_path).request_uri
+        follow_redirect! while response.redirect?
+        assert_response :success
+        assert_equal "image/webp", response.media_type
+        assert_equal expected_bytes, response.body.b
+        assert_equal derived_blob.download, response.body.b
+        image = Vips::Image.new_from_buffer(response.body, "")
+        assert_equal dimensions, [ image.width, image.height ]
+      end
+
+      assert_empty transformations, "Reading the picture must not transform it again"
+      assert_empty uploads, "Reading the picture must not store another copy"
+      assert_equal 1, blob.variant_records.count
+    ensure
+      ActiveSupport::Notifications.unsubscribe(transform_subscriber) if transform_subscriber
+      ActiveSupport::Notifications.unsubscribe(upload_subscriber) if upload_subscriber
+      perform_enqueued_jobs(only: ActiveStorage::PurgeJob) { blob&.purge }
+    end
+end
