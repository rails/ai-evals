--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  class Interrupted < Exception; end
+
+  setup do
+    @leaves = Leaf.order(:id).to_a
+    @titles = [ '"Quoted opening" and more', 'An inner "quote"', '"Entirely quoted"', "Plain title" ]
+    @leaves.zip(@titles).each do |leaf, title|
+      leaf.update!(title: %Q("#{title}"))
+    end
+  end
+
+  test "restart after a committed update does not clean completed leaves again" do
+    updated_ids = []
+    interrupted_id = @leaves.second.id
+    interrupted = false
+    callback = -> {
+      updated_ids << id
+      if id == interrupted_id && !interrupted
+        interrupted = true
+        raise Interrupted
+      end
+    }
+
+    with_commit_callback(callback) do
+      assert_raises(Interrupted) { TitleCleanupJob.perform_now }
+      assert_equal @titles.first(2), @leaves.first(2).map { |leaf| leaf.reload.title }
+      assert_equal %Q("#{@titles.third}"), @leaves.third.reload.title
+
+      TitleCleanupJob.perform_now
+    end
+
+    assert_equal @titles, @leaves.map { |leaf| leaf.reload.title }
+    assert_equal @leaves.map(&:id), updated_ids
+  end
+
+  test "interruption before commit rolls back both the title and progress" do
+    interrupted_id = @leaves.second.id
+    callback = -> { raise Interrupted if id == interrupted_id }
+
+    with_update_callback(callback) do
+      assert_raises(Interrupted) { TitleCleanupJob.perform_now }
+    end
+
+    assert_equal @titles.first, @leaves.first.reload.title
+    assert_predicate @leaves.first, :legacy_title_cleaned_at?
+    assert_equal %Q("#{@titles.second}"), @leaves.second.reload.title
+    assert_nil @leaves.second.legacy_title_cleaned_at
+
+    TitleCleanupJob.perform_now
+
+    assert_equal @titles, @leaves.map { |leaf| leaf.reload.title }
+    assert @leaves.all?(&:legacy_title_cleaned_at?)
+  end
+
+  test "repeated interruptions continue forward one leaf at a time" do
+    callback = -> { raise Interrupted }
+
+    with_commit_callback(callback) do
+      @leaves.each_with_index do |leaf, index|
+        assert_raises(Interrupted) { TitleCleanupJob.perform_now }
+        assert_equal index + 1, Leaf.where.not(legacy_title_cleaned_at: nil).count
+        assert_equal @titles[index], leaf.reload.title
+      end
+    end
+
+    assert_no_changes -> { Leaf.order(:id).pluck(:title, :updated_at, :legacy_title_cleaned_at) } do
+      TitleCleanupJob.perform_now
+    end
+  end
+
+  test "a stale batch skips leaves completed by another run" do
+    updated_ids = []
+    first_id = @leaves.first.id
+    callback = -> {
+      updated_ids << id
+      TitleCleanupJob.perform_now if id == first_id
+    }
+
+    with_commit_callback(callback) { TitleCleanupJob.perform_now }
+
+    assert_equal @titles, @leaves.map { |leaf| leaf.reload.title }
+    assert_equal @leaves.map(&:id), updated_ids
+  end
+
+  test "empty titles and trashed leaves are completed too" do
+    @leaves.first.update!(title: '""')
+    @leaves.second.update!(title: "")
+    @leaves.last.update!(status: :trashed)
+
+    TitleCleanupJob.perform_now
+
+    assert_equal [ "", "", *@titles.last(2) ], @leaves.map { |leaf| leaf.reload.title }
+    assert @leaves.all?(&:legacy_title_cleaned_at?)
+  end
+
+  test "an empty collection needs no work" do
+    Leaf.delete_all
+
+    assert_nothing_raised { TitleCleanupJob.perform_now }
+  end
+
+  private
+    def with_update_callback(callback)
+      Leaf.after_update callback
+      yield
+    ensure
+      Leaf.skip_callback(:update, :after, callback)
+    end
+
+
+    def with_commit_callback(callback)
+      Leaf.after_update_commit callback
+      yield
+    ensure
+      Leaf.skip_callback(:commit, :after, callback)
+    end
+end
