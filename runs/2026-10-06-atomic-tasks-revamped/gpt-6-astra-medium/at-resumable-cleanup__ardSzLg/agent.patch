 class TitleCleanupJob < ApplicationJob
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    Leaf.where(legacy_title_cleaned_at: nil).find_each(order: :asc) do |leaf|
+      leaf.with_lock do
+        # Another run may have cleaned this leaf since the batch was loaded.
+        next if leaf.legacy_title_cleaned_at?
+
+        # Commit the title and progress together: stripping quotes is not idempotent.
+        leaf.update!(title: cleaned(leaf.title), legacy_title_cleaned_at: Time.current)
+      end
     end
   end
 
