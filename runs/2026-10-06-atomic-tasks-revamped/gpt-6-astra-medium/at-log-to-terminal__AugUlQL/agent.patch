+require "test_helper"
+require "tempfile"
+
+class RunnerLoggingTest < ActiveSupport::TestCase
+  setup do
+    @original_logger = Rails.logger
+    @log_file = Tempfile.new("runner-logging")
+    @log_file.sync = true
+    @file_logger = ActiveSupport::Logger.new(@log_file)
+    @file_logger.formatter = ->(severity, time, progname, message) { "#{severity}: #{message}\n" }
+    @file_logger = ActiveSupport::TaggedLogging.new(@file_logger)
+    Rails.logger = ActiveSupport::BroadcastLogger.new(@file_logger)
+  end
+
+  teardown do
+    Rails.logger = @original_logger
+    @log_file.close!
+  end
+
+  test "runner broadcasts the report to stdout and keeps the file logger" do
+    assert_report_in_both_destinations expected_report(pages: 4)
+    assert_includes Rails.logger.broadcasts, @file_logger
+  end
+
+  test "report preserves singular page wording" do
+    books(:handbook).leaves.where.not(id: leaves(:welcome_page).id).delete_all
+
+    assert_report_in_both_destinations expected_report(pages: 1)
+  end
+
+  test "empty library still reports its count and completion" do
+    Book.destroy_all
+    @log_file.truncate(0)
+    @log_file.rewind
+
+    assert_report_in_both_destinations "INFO: Library report: 0 books\nINFO: Library report: done\n"
+  end
+
+  test "stdout respects the configured severity threshold" do
+    Rails.logger.level = Logger::WARN
+
+    assert_report_in_both_destinations "WARN: Library report: Manual has no pages\n"
+    assert_equal Logger::WARN, Rails.logger.level
+  end
+
+  test "loading runner hooks again does not duplicate output" do
+    assert_report_in_both_destinations expected_report(pages: 4), hook_runs: 2
+    assert_equal 2, Rails.logger.broadcasts.size
+  end
+
+  test "an existing stdout logger is not duplicated" do
+    stdout, stderr = capture_io do
+      console = ActiveSupport::Logger.new($stdout)
+      console.formatter = @file_logger.formatter
+      Rails.logger.broadcast_to(console)
+      Rails.application.load_runner
+      Kernel.load Rails.root.join("script/library_report.rb").to_s
+    end
+
+    assert_equal expected_report(pages: 4), stdout
+    assert_empty stderr
+    assert_equal stdout, File.read(@log_file.path)
+    assert_equal 2, Rails.logger.broadcasts.size
+  end
+
+  private
+    def assert_report_in_both_destinations(expected, hook_runs: 1)
+      stdout, stderr = capture_io do
+        hook_runs.times { Rails.application.load_runner }
+        Kernel.load Rails.root.join("script/library_report.rb").to_s
+      end
+
+      assert_equal expected, stdout
+      assert_empty stderr
+      assert_equal expected, File.read(@log_file.path)
+    end
+
+    def expected_report(pages:)
+      entries = [
+        [ books(:handbook).id, "INFO: Library report: Handbook has #{pages} #{pages == 1 ? 'page' : 'pages'}" ],
+        [ books(:manual).id, "WARN: Library report: Manual has no pages" ]
+      ].sort_by(&:first).map(&:last)
+
+      ([ "INFO: Library report: 2 books" ] + entries + [ "INFO: Library report: done" ]).join("\n") + "\n"
+    end
+end
