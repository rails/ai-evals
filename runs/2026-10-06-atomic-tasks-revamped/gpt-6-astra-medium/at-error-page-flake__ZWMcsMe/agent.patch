+++ b/test/integration/raised_exceptions_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class RaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "raising on the first request does not change subsequent error pages" do
+    with_raised_exceptions do
+      assert_book_absent
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "raising works after a rendered error page without changing application defaults" do
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+    defaults = Rails.application.env_config.dup
+    configured = Rails.application.config.action_dispatch.show_exceptions
+
+    result = with_raised_exceptions do
+      assert_book_absent
+      assert_equal defaults, Rails.application.env_config
+      assert_equal configured, Rails.application.config.action_dispatch.show_exceptions
+      :block_result
+    end
+
+    assert_equal :block_result, result
+    assert_equal defaults, Rails.application.env_config
+    assert_equal configured, Rails.application.config.action_dispatch.show_exceptions
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "nested blocks restore the outer scope even when a controller exception escapes" do
+    with_raised_exceptions do
+      with_raised_exceptions { assert_book_absent }
+      assert_book_absent
+
+      assert_raises ActiveRecord::RecordNotFound do
+        with_raised_exceptions { get book_slug_path(books(:manual)) }
+      end
+      assert_book_absent
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "an escaping controller exception restores normal rendering" do
+    assert_raises ActiveRecord::RecordNotFound do
+      with_raised_exceptions { get book_slug_path(books(:manual)) }
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "an exception in the block before a request restores normal rendering" do
+    error = Class.new(StandardError)
+    assert_raises(error) { with_raised_exceptions { raise error } }
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "the scope covers existing and new sessions without mutating caller request options" do
+    existing = open_session
+    env = { "action_dispatch.show_exceptions" => :rescuable, "test.marker" => "preserved" }.freeze
+    headers = { "Accept" => "text/html" }.freeze
+
+    with_raised_exceptions do
+      [ existing, open_session ].each do |session|
+        assert_raises ActiveRecord::RecordNotFound do
+          session.get book_slug_path(books(:manual)), env: env, headers: headers
+        end
+      end
+    end
+
+    existing.get book_slug_path(books(:manual)), env: env, headers: headers
+    assert_equal 404, existing.response.status
+    assert_equal "preserved", existing.request.env["test.marker"]
+    assert_equal :rescuable, env["action_dispatch.show_exceptions"]
+  end
+
+  test "overlapping scopes and normal requests in other threads remain independent" do
+    path = book_slug_path(books(:manual))
+    ready, proceed = Queue.new, Queue.new
+    other = Thread.new do
+      session = ActionDispatch::Integration::Session.new(Rails.application)
+      with_raised_exceptions do
+        ready << true
+        proceed.pop
+        assert_raises(ActiveRecord::RecordNotFound) { session.get path }
+      end
+      session.get path
+      session.response.status
+    end
+
+    begin
+      assert ready.pop(timeout: 10), "the other request context did not start"
+      get path
+      assert_response :not_found
+      with_raised_exceptions { assert_book_absent }
+      get path
+      assert_response :not_found
+    ensure
+      proceed << true
+      assert_equal 404, other.value
+    end
+  end
+
+  private
+    def assert_book_absent
+      assert_raises(ActiveRecord::RecordNotFound) { get book_slug_path(books(:manual)) }
+    end
+end
