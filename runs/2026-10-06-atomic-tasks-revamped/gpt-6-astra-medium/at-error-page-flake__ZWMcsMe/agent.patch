index 0000000..1e63ae6
--- /dev/null
+++ b/test/test_helpers/raised_exceptions_test_helper.rb
@@ -0,0 +1,24 @@
+module RaisedExceptionsTestHelper
+  def with_raised_exceptions
+    previous = Thread.current[:writebook_raise_test_exceptions]
+    Thread.current[:writebook_raise_test_exceptions] = true
+    yield
+  ensure
+    Thread.current[:writebook_raise_test_exceptions] = previous
+  end
+
+  # Integration requests run synchronously in the caller's execution context.
+  # Keep the override local to that context, including across separate sessions.
+  class Middleware
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      if Thread.current[:writebook_raise_test_exceptions]
+        env["action_dispatch.show_exceptions"] = :none
+      end
+      @app.call(env)
+    end
+  end
+end
