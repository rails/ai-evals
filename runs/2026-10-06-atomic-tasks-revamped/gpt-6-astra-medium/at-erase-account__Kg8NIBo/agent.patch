diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..a20dbf4
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,198 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+  end
+
+  test "erases identity sessions accesses reading marks and audit events" do
+    session = @user.sessions.start!(user_agent: "Private browser", ip_address: "192.0.2.1")
+    mark = ReadingMark.remember(leaves(:welcome_page), user: @user)
+    other_event = SignInEvent.create!(email_address: users(:david).email_address, action: :signed_in)
+    @user.sessions.load
+
+    @user.erase
+
+    assert_not User.exists?(@user.id)
+    assert_not Session.exists?(session.id)
+    assert_not Access.exists?(user_id: @user.id)
+    assert_not ReadingMark.exists?(mark.id)
+    assert_not SignInEvent.exists?(email_address: @user.email_address)
+    assert SignInEvent.exists?(other_event.id)
+    assert Book.exists?(books(:handbook).id)
+  end
+
+  test "retains everyone books and their content but removes attribution" do
+    book = books(:handbook)
+    book.update! creator: @user, author: @user.name, published: true
+    @user.created_books.load
+    other_access = book.accesses.where.not(user_id: @user.id).first
+    mark = ReadingMark.remember(leaves(:welcome_page), user: users(:david))
+    Leaf.reindex_all
+
+    @user.erase
+
+    assert_nil book.reload.creator_id
+    assert_equal "Deleted author", book.author
+    assert book.published?
+    assert book.everyone_access?
+    assert Access.exists?(other_access.id)
+    assert ReadingMark.exists?(mark.id)
+    assert_includes Leaf.search("great handbook"), leaves(:welcome_page)
+    assert leaves(:reading_picture).picture.image.attached?
+  end
+
+  test "erases private books including published ones revisions trash markdown and raw search rows" do
+    pictures(:reading).image.attach upload("private.webp")
+    book = books(:handbook)
+    book.update! creator: @user, everyone_access: false, published: true
+    page = leaves(:welcome_page)
+    page.edit leafable_params: { body: "A private revision" }
+    page.trashed!
+    picture = leaves(:reading_picture)
+    picture.edit leafable_params: { caption: "New caption" }
+    picture.trashed!
+    Leaf.reindex_all
+    # An obsolete entry must be removed even if the leaf isn't searchable now.
+    Leaf.connection.execute("INSERT INTO leaf_search_index(rowid, title, content) VALUES (#{picture.id}, 'stale', 'private')")
+    leaf_ids = book.leaves.ids
+    page_ids = Page.ids
+    markdown_ids = ActionText::Markdown.where(record_type: "Page", record_id: page_ids).ids
+    picture_ids = Picture.ids
+    section_ids = Section.ids
+    ReadingMark.remember(page, user: users(:david))
+
+    @user.erase
+
+    assert_not Book.exists?(book.id)
+    assert_not Leaf.exists?(id: leaf_ids)
+    assert_not Edit.exists?(leaf_id: leaf_ids)
+    assert_not ReadingMark.exists?(leaf_id: leaf_ids)
+    assert_not Access.exists?(book_id: book.id)
+    assert_not Page.exists?(id: page_ids)
+    assert_not Picture.exists?(id: picture_ids)
+    assert_not Section.exists?(id: section_ids)
+    assert_not ActionText::Markdown.exists?(id: markdown_ids)
+    assert_empty Leaf.connection.select_values("SELECT rowid FROM leaf_search_index WHERE rowid IN (#{leaf_ids.join(',')})")
+    assert Book.exists?(books(:manual).id)
+  end
+
+  test "purges private attachments and files without purging shared blobs" do
+    book = books(:handbook)
+    book.update! creator: @user, everyone_access: false
+    book.cover.attach upload("cover.webp")
+    pages(:welcome).body.uploads.attach upload("upload.webp")
+    pages(:welcome).save!
+    # This upload will belong to a historical page after editing.
+    blobs = [ book.cover.blob, pages(:welcome).body.uploads.blobs.first ]
+    leaves(:welcome_page).edit leafable_params: { body: "Replacement" }
+    pictures(:reading).image.attach upload("shared.webp")
+    shared_blob = pictures(:reading).image.blob
+    books(:manual).cover.attach shared_blob
+
+    @user.erase
+
+    blobs.each do |blob|
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+    assert ActiveStorage::Blob.exists?(shared_blob.id)
+    assert shared_blob.service.exist?(shared_blob.key)
+    assert books(:manual).reload.cover.attached?
+    assert_equal [ books(:manual).cover.attachment.id ], ActiveStorage::Attachment.ids
+  end
+
+  test "purges images no longer referenced by a retained book" do
+    pictures(:reading).image.attach upload("private.webp")
+    books(:handbook).update! creator: @user, everyone_access: false
+    blob = pictures(:reading).image.blob
+    leaves(:reading_picture).edit leafable_params: { caption: "New caption" }
+    leaves(:reading_picture).trashed!
+
+    @user.erase
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Attachment.exists?(blob_id: blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+
+  test "erases cached private content but leaves non-view cache entries alone" do
+    original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    Rails.cache.write("views/books/private", "Private book contents")
+    Rails.cache.write("views/books/index", @user.name)
+    Rails.cache.write("unrelated", "Keep")
+
+    @user.erase
+
+    assert_nil Rails.cache.read("views/books/private")
+    assert_nil Rails.cache.read("views/books/index")
+    assert_equal "Keep", Rails.cache.read("unrelated")
+  ensure
+    Rails.cache = original_cache
+  end
+
+  test "legacy removal erases original and rewritten audit addresses exactly" do
+    original = @user.email_address
+    rewritten = original.sub("@", "-deactivated-#{SecureRandom.uuid}@")
+    @user.update! active: false, email_address: rewritten
+    addresses = [ original, rewritten ]
+    addresses.each { |address| SignInEvent.create!(email_address: address, action: :signed_in) }
+    other_event = SignInEvent.create!(email_address: "other-#{original}", action: :signed_in)
+
+    @user.erase
+
+    assert_not SignInEvent.exists?(email_address: addresses)
+    assert SignInEvent.exists?(other_event.id)
+  end
+
+  test "does not decode an inactive address without the exact legacy suffix" do
+    @user.update! active: false, email_address: "kevin-deactivated-not-a-uuid@example.com"
+    event = SignInEvent.create!(email_address: "kevin@example.com", action: :signed_in)
+
+    @user.erase
+
+    assert SignInEvent.exists?(event.id)
+  end
+
+  test "does not decode legacy-looking email addresses of active users" do
+    original = @user.email_address
+    @user.update! email_address: original.sub("@", "-deactivated-#{SecureRandom.uuid}@")
+    event = SignInEvent.create!(email_address: original, action: :signed_in)
+
+    @user.erase
+
+    assert SignInEvent.exists?(event.id)
+  end
+
+  test "database erasure rolls back if deletion fails" do
+    books(:handbook).cover.attach upload("retained-on-rollback.webp")
+    blob = books(:handbook).cover.blob
+    books(:manual).update! creator: @user, author: @user.name
+    books(:handbook).update! creator: @user, everyone_access: false
+    Leaf.reindex_all
+    session = @user.sessions.start!(user_agent: "Browser", ip_address: "192.0.2.1")
+    @user.define_singleton_method(:destroy!) do
+      super()
+      raise "Deletion failed"
+    end
+
+    assert_raises(RuntimeError) { @user.erase }
+
+    assert User.exists?(@user.id)
+    assert Session.exists?(session.id)
+    assert SignInEvent.exists?(email_address: @user.email_address)
+    assert_equal @user.id, books(:manual).reload.creator_id
+    assert_equal @user.name, books(:manual).author
+    assert Book.exists?(books(:handbook).id)
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert ActiveStorage::Attachment.exists?(blob_id: blob.id)
+    assert blob.service.exist?(blob.key)
+    assert_includes Leaf.search("great handbook"), leaves(:welcome_page)
+  end
+
+  private
+    def upload(filename)
+      { io: file_fixture("reading.webp").open, filename: filename, content_type: "image/webp" }
+    end
+end
