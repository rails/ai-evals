diff --git a/app/models/user/erasure.rb b/app/models/user/erasure.rb
new file mode 100644
index 0000000..5e62f9f
--- /dev/null
+++ b/app/models/user/erasure.rb
@@ -0,0 +1,68 @@
+module User::Erasure
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :finish_erasure, if: -> { @erased_blobs }
+  end
+
+  def erase
+    with_lock do
+      @erased_blobs = blobs_to_erase
+      created_books.with_everyone_access.update_all creator_id: nil, author: "Deleted author", updated_at: Time.current
+      created_books.reset
+
+      # Do not generate new sign-out audit records while erasing this identity.
+      sessions.delete_all
+      sessions.reset
+      SignInEvent.where(email_address: erased_email_addresses).delete_all
+
+      destroy!
+    end
+  end
+
+  private
+    def blobs_to_erase
+      private_books = created_books.where(everyone_access: false)
+      leaves = Leaf.where(book: private_books)
+      edits = Edit.where(leaf: leaves)
+      attachments = ActiveStorage::Attachment.where(record: private_books)
+
+      Leafable::TYPES.each do |type|
+        records = type.constantize.where(id: leaves.where(leafable_type: type).select(:leafable_id))
+          .or(type.constantize.where(id: edits.where(leafable_type: type).select(:leafable_id)))
+        attachments = attachments.or(ActiveStorage::Attachment.where(record: records))
+
+        if type == "Page"
+          markdowns = ActionText::Markdown.where(record: records)
+          attachments = attachments.or(ActiveStorage::Attachment.where(record: markdowns))
+        end
+      end
+
+      ActiveStorage::Blob.where(id: attachments.select(:blob_id)).to_a
+    end
+
+    def finish_erasure
+      # Standard destruction also schedules purges, but do not wait for a worker
+      # to erase files. Blob#purge preserves blobs with surviving attachments.
+      @erased_blobs.each(&:purge)
+
+      # Book lists and leaf fragments can contain private content and attribution.
+      # Their composite keys cannot all be reconstructed after deleting the records.
+      Rails.cache.delete_matched("views/*")
+    end
+
+    def erased_email_addresses
+      addresses = [ email_address ]
+
+      # The old Remove action appended a UUID before the @. Only undo that
+      # precise format for inactive users, not similar-looking real addresses.
+      unless active?
+        suffix = /-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?=@)/i
+        while (original = addresses.last.sub(suffix, "")) != addresses.last
+          addresses << original
+        end
+      end
+
+      addresses
+    end
+end
