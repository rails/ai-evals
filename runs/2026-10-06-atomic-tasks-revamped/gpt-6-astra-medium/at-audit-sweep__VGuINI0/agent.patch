diff --git a/test/integration/security_regressions_test.rb b/test/integration/security_regressions_test.rb
new file mode 100644
index 0000000..3ac628a
--- /dev/null
+++ b/test/integration/security_regressions_test.rb
@@ -0,0 +1,228 @@
+require "test_helper"
+
+class SecurityRegressionsTest < ActionDispatch::IntegrationTest
+  test "members can update their profile but cannot assign themselves a role" do
+    sign_in :kevin
+
+    assert_no_changes -> { User.order(:id).pluck(:role) } do
+      patch user_profile_path(users(:kevin)), params: { user: {
+        name: "Updated Kevin", email_address: "updated@example.com", password: "new-password",
+        role: "administrator"
+      } }
+    end
+
+    assert_redirected_to users_path
+    user = users(:kevin).reload
+    assert_equal "Updated Kevin", user.name
+    assert_equal "updated@example.com", user.email_address
+    assert user.authenticate("new-password")
+  end
+
+  test "members cannot change anyone's role through account or other profile updates" do
+    sign_in :kevin
+
+    [ :kevin, :jz, :david ].each do |name|
+      assert_no_changes -> { User.order(:id).pluck(:role) } do
+        patch user_path(users(name)), params: { user: { role: "administrator" } }
+      end
+      assert_response :forbidden
+    end
+
+    [ :jz, :david ].each do |name|
+      assert_no_changes -> { User.order(:id).pluck(:role) } do
+        patch user_profile_path(users(name)), params: { user: { role: "member", name: "Changed" } }
+      end
+      assert_response :forbidden
+    end
+  end
+
+  test "registration cannot assign an administrator role" do
+    post join_path(accounts(:signal).join_code), params: { user: {
+      name: "New Member", email_address: "new-member@example.com", password: "secret123456",
+      role: "administrator"
+    } }
+
+    assert_redirected_to root_path
+    assert User.find_by!(email_address: "new-member@example.com").member?
+  end
+
+  test "administrators can change roles and their own profile" do
+    sign_in :david
+    patch user_path(users(:kevin)), params: { user: { role: "administrator" } }
+    assert_redirected_to users_path
+    assert users(:kevin).reload.administrator?
+
+    patch user_path(users(:kevin)), params: { user: { role: "member" } }
+    assert_redirected_to users_path
+    assert users(:kevin).reload.member?
+
+    patch user_profile_path(users(:david)), params: { user: {
+      name: "Updated David", email_address: "updated-admin@example.com", password: "new-password"
+    } }
+    assert_redirected_to users_path
+    assert_equal "Updated David", users(:david).reload.name
+    assert_equal "updated-admin@example.com", users(:david).email_address
+    assert users(:david).authenticate("new-password")
+  end
+
+  test "book readers cannot update or delete books" do
+    sign_in :jz
+    assert_book_changes_forbidden books(:handbook)
+  end
+
+  test "publication does not allow a signed in non-editor to change or delete a book" do
+    sign_in :kevin
+    books(:manual).update!(published: true)
+    assert_book_changes_forbidden books(:manual)
+  end
+
+  test "editors can update and delete their books" do
+    sign_in :kevin
+    patch book_path(books(:handbook)), params: { book: { title: "Edited title" } }
+    assert_redirected_to book_slug_path(books(:handbook).reload)
+    assert_equal "Edited title", books(:handbook).title
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+    assert_redirected_to root_path
+  end
+
+  test "library search includes only readable active leaves" do
+    sign_in :kevin
+    leaves(:summary_page).update!(book: books(:manual), title: "Welcome secret")
+    leaves(:reading_picture).trashed!
+
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_search_result leaves(:welcome_page)
+    assert_no_search_result leaves(:summary_page)
+
+    get library_search_path, params: { q: "Reading" }
+    assert_response :success
+    assert_no_search_result leaves(:reading_picture)
+
+    books(:manual).update!(published: true)
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_search_result leaves(:welcome_page)
+    assert_search_result leaves(:summary_page)
+
+    sign_out
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_search_result leaves(:summary_page)
+    assert_no_search_result leaves(:welcome_page)
+  end
+
+  test "SQL syntax in library search is literal and cannot expose private leaves" do
+    sign_in :kevin
+    leaves(:summary_page).update!(book: books(:manual))
+
+    books(:handbook).update!(published: true)
+    2.times do
+      [ "' OR 1=1 OR leaves.title LIKE '", "' OR 1=1 --", "%' OR 1=1 --" ].each do |query|
+        get library_search_path, params: { q: query }
+        assert_response :success
+        assert_select "a.search__result", count: 0
+      end
+      sign_out
+    end
+  end
+
+  test "apostrophes are searchable literals" do
+    sign_in :kevin
+    leaves(:welcome_page).update!(title: "Reader's guide")
+    get library_search_path, params: { q: "Reader's" }
+    assert_response :success
+    assert_search_result leaves(:welcome_page)
+    assert_select "a.search__result", count: 1
+  end
+
+  test "LIKE metacharacters are searchable literals" do
+    sign_in :kevin
+
+    [ [ "Save 50% off", "Save 50% off" ],
+      [ "Save 50% off", "%" ], [ "under_score", "_" ],
+      [ 'back\\slash', "\\" ], [ "Important!", "!" ], [ "!%_", "!%_" ] ].each do |title, query|
+      leaves(:welcome_page).update!(title: title)
+      get library_search_path, params: { q: query }
+      assert_response :success
+      assert_search_result leaves(:welcome_page)
+      assert_select "a.search__result", count: 1
+    end
+  end
+
+  test "empty searches and searches without readable books return no results" do
+    [ nil, "", "   ", "Welcome", "%", "' OR 1=1 --" ].each do |query|
+      get library_search_path, params: { q: query }
+      assert_response :success
+      assert_select "a.search__result", count: 0
+    end
+  end
+
+  test "private pages cannot be read under a readable book id" do
+    sign_in :kevin
+    leaves(:summary_page).update!(book: books(:manual))
+
+    [ nil, :md ].each do |format|
+      get leafable_slug_path(leaves(:summary_page), format: format)
+      assert_response :not_found
+      get slugged_leafable_path(books(:handbook), books(:handbook).slug,
+        leaves(:summary_page), leaves(:summary_page).slug, format: format)
+      assert_response :not_found
+      get book_page_path(books(:handbook), leaves(:summary_page), format: format)
+      assert_response :not_found
+      get leafable_slug_path(leaves(:welcome_page), format: format)
+      assert_response :success
+    end
+
+    books(:handbook).update!(published: true)
+    sign_out
+    get slugged_leafable_path(books(:handbook), books(:handbook).slug,
+      leaves(:summary_page), leaves(:summary_page).slug)
+    assert_response :not_found
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+    get leafable_slug_path(leaves(:welcome_page), format: :md)
+    assert_response :success
+  end
+
+  test "a page cannot be changed or deleted through another book's editor access" do
+    sign_in :kevin
+    leaf = leaves(:summary_page)
+    leaf.update!(book: books(:manual))
+
+    assert_no_changes -> { leaf.reload.attributes } do
+      patch book_page_path(books(:handbook), leaf), params: { leaf: { title: "Changed" } }
+    end
+    assert_response :not_found
+
+    assert_no_changes -> { leaf.reload.status } do
+      delete book_page_path(books(:handbook), leaf)
+    end
+    assert_response :not_found
+  end
+
+  private
+
+    def assert_book_changes_forbidden(book)
+      assert_no_changes -> { book.reload.attributes } do
+        patch book_path(book), params: { book: { title: "Unauthorized change" } }
+      end
+      assert_response :forbidden
+
+      assert_no_difference -> { Book.count } do
+        delete book_path(book)
+      end
+      assert_response :forbidden
+    end
+
+    def assert_search_result(leaf)
+      assert_select "a.search__result[href=?]", leafable_slug_path(leaf), count: 1
+    end
+
+    def assert_no_search_result(leaf)
+      assert_select "a.search__result[href=?]", leafable_slug_path(leaf), count: 0
+    end
+end
