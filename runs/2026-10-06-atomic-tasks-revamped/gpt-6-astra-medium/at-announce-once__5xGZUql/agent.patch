diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..1c0b4f4
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  # Exercise actual commits and rollbacks rather than the fixture transaction.
+  self.use_transactional_tests = false
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "publication announces the book once after commit" do
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ] do
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        Book.transaction do
+          @book.update! published: true
+          assert_no_enqueued_jobs only: AnnouncePublicationJob
+        end
+      end
+    end
+  end
+
+  test "publication survives adding a page and further saves in the same transaction" do
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ @book ] do
+      assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+        Book.transaction do
+          @book.update! published: true
+          @book.press Page.new(body: ""), title: "Introduction"
+          @book.update! title: "Published manual"
+          @book.save!
+          assert_no_enqueued_jobs only: AnnouncePublicationJob
+        end
+      end
+    end
+
+    assert_predicate @book.reload, :published?
+  end
+
+  test "saving an already published book does not announce again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: true
+      @book.update! title: "New title"
+      @book.touch
+    end
+  end
+
+  test "unpublishing does not announce" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "saving a draft does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "New title"
+      @book.save!
+      @book.touch
+    end
+  end
+
+  test "a transaction ending in draft does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+      end
+    end
+
+    assert_not_predicate @book.reload, :published?
+  end
+
+  test "multiple publication changes ending live announce only once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+        @book.update! published: true
+        @book.touch
+      end
+    end
+  end
+
+  test "failure after publication rolls back the book and does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises ActiveRecord::RecordNotFound do
+        Book.transaction do
+          @book.update! published: true
+          @book.press Page.new(body: ""), title: "Introduction"
+          @book.leaves.find(-1)
+        end
+      end
+    end
+
+    assert_not_predicate @book.reload, :published?
+    assert_empty @book.leaves
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Still a draft"
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+end
