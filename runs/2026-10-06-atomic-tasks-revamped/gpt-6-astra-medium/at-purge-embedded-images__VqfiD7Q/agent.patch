diff --git a/test/models/page_test.rb b/test/models/page_test.rb
index b4bb79b..ca24fe3 100644
--- a/test/models/page_test.rb
+++ b/test/models/page_test.rb
@@ -1,6 +1,37 @@
 require "test_helper"
 
 class PageTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  [ 0, 1, 2 ].each do |image_count|
+    test "destroying a page with #{image_count} embedded images purges its uploads" do
+      page = pages(:welcome)
+      markdown = page.body
+      image_count.times do
+        markdown.uploads.attach io: file_fixture("reading.webp").open,
+          filename: "reading.webp", content_type: "image/webp"
+      end
+      attachments = markdown.uploads.to_a
+      blobs = attachments.map(&:blob)
+      page.update! body: attachments.map { |attachment| "![Reading](#{attachment.slug_path})" }.join("\n")
+
+      blobs.each { |blob| assert blob.service.exist?(blob.key) }
+
+      perform_enqueued_jobs do
+        page.destroy!
+      end
+
+      assert_not ActionText::Markdown.exists?(markdown.id)
+      attachments.each { |attachment| assert_not ActiveStorage::Attachment.exists?(attachment.id) }
+      blobs.each do |blob|
+        assert_not ActiveStorage::Blob.exists?(blob.id)
+        assert_not blob.service.exist?(blob.key)
+      end
+    ensure
+      blobs&.each(&:purge)
+    end
+  end
+
   test "html preview" do
     page = Page.new(body: "# Hello\n\nWorld!")
 
