diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..0a8d25e
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,35 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :anonymize_everyone_books, prepend: true
+    after_destroy :erase_sign_in_events
+  end
+
+  private
+    def anonymize_everyone_books
+      created_books.with_everyone_access.update_all(creator_id: nil, author: "Deleted author", updated_at: Time.current)
+      # The dependent destroy must not use a previously loaded list of books.
+      created_books.reset
+    end
+
+    def erase_sign_in_events
+      # Session destruction records a sign-out, so erase events afterwards.
+      SignInEvent.where(email_address: sign_in_email_addresses).delete_all
+    end
+
+    def sign_in_email_addresses
+      addresses = [ email_address ]
+
+      unless active?
+        # Older removals appended a UUID immediately before the @. Include each
+        # prior address, including accounts that were deactivated more than once.
+        suffix = /-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?=@[^@]+\z)/i
+        while (original = addresses.last.sub(suffix, "")) != addresses.last
+          addresses << original
+        end
+      end
+
+      addresses
+    end
+end
