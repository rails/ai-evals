diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..c2e04e5
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,178 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "erasure removes the user, sessions, accesses, reading marks and sign in events" do
+    user = users(:kevin)
+    user.sessions.create!(ip_address: "192.0.2.1", user_agent: "Private browser")
+    ReadingMark.remember(leaves(:welcome_page), user: user)
+    other_event = users(:david).sessions.create!.then { SignInEvent.last }
+
+    user.destroy!
+
+    assert_not User.exists?(user.id)
+    assert_not Session.exists?(user_id: user.id)
+    assert_not Access.exists?(user_id: user.id)
+    assert_not ReadingMark.exists?(user_id: user.id)
+    assert_not SignInEvent.exists?(email_address: user.email_address)
+    assert SignInEvent.exists?(other_event.id)
+  end
+
+  test "everyone books retain their content and readers but not their author" do
+    user = users(:kevin)
+    book = books(:handbook)
+    book.update!(creator: user, author: user.name, everyone_access: true)
+    reader_access = book.accesses.find_by!(user: users(:jz))
+    leaf_ids = book.leaves.ids
+    user.created_books.load
+    Leaf.reindex_all
+
+    user.destroy!
+
+    assert_nil book.reload.creator_id
+    assert_equal "Deleted author", book.author
+    assert_equal leaf_ids.sort, book.leaves.ids.sort
+    assert Access.exists?(reader_access.id)
+    assert_includes Leaf.search("great handbook"), leaves(:welcome_page)
+  end
+
+  test "private books including published ones erase current and historical content and search entries" do
+    user = users(:kevin)
+    book = books(:handbook)
+    book.update!(creator: user, everyone_access: false, published: true)
+    leaf = leaves(:welcome_page)
+    leaf.edit(leafable_params: { body: "Private replacement" })
+    leaf.trashed!
+    leaves(:welcome_section).edit(leafable_params: { body: "Private section" })
+    leaves(:reading_picture).edit(leafable_params: { caption: "Private caption" })
+    ReadingMark.remember(leaf, user: users(:jz))
+    leaf_ids = book.leaves.ids
+    page_ids = Page.ids
+    section_ids = Section.ids
+    picture_ids = Picture.ids
+    Leaf.reindex_all
+    # A stale row must be removed even when the leaf no longer has searchable content.
+    Leaf.connection.execute("INSERT INTO leaf_search_index(rowid, title, content) VALUES (#{leaves(:reading_picture).id}, 'stale', 'private')")
+
+    perform_enqueued_jobs do
+      user.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert Book.exists?(books(:manual).id)
+    assert_not Access.exists?(book_id: book.id)
+    assert_not ReadingMark.exists?(leaf_id: leaf_ids)
+    assert_not Leaf.exists?(id: leaf_ids)
+    assert_not Edit.exists?(leaf_id: leaf_ids)
+    assert_not Page.exists?(id: page_ids)
+    assert_not Section.exists?(id: section_ids)
+    assert_not Picture.exists?(id: picture_ids)
+    assert_not ActionText::Markdown.exists?(record_type: "Page", record_id: page_ids)
+    assert_equal 0, Leaf.connection.select_value("SELECT COUNT(*) FROM leaf_search_index WHERE rowid IN (#{leaf_ids.join(',')})")
+  end
+
+  test "legacy deactivation erases events under both original and rewritten email" do
+    user = users(:kevin)
+    original_email = user.email_address
+    user.sessions.create!
+    user.deactivate
+    user.sessions.create!
+    unrelated = SignInEvent.create!(email_address: "other-#{original_email}", action: :signed_in)
+
+    user.destroy!
+
+    assert_not SignInEvent.exists?(email_address: [ original_email, user.email_address ])
+    assert SignInEvent.exists?(unrelated.id)
+  end
+
+  test "erasure purges covers, pictures and markdown uploads including historical versions" do
+    user = users(:kevin)
+    book = books(:handbook)
+    book.update!(creator: user, everyone_access: false)
+    book.cover.attach(io: file_fixture("white-rabbit.webp").open, filename: "cover.webp")
+    pages(:welcome).body.uploads.attach(io: StringIO.new("private upload"), filename: "private.txt")
+    leaves(:welcome_page).edit(leafable_params: { body: "New private version" })
+    leaves(:welcome_page).page.body.uploads.attach(io: StringIO.new("current upload"), filename: "current.txt")
+    leaves(:reading_picture).edit(leafable_params: { caption: "New picture version" })
+    blobs = ActiveStorage::Blob.all.to_a
+    attachment_ids = ActiveStorage::Attachment.ids
+
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) do
+      user.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(id: attachment_ids)
+    assert_not ActiveStorage::Blob.exists?(id: blobs.map(&:id))
+    blobs.each { |blob| assert_not blob.service.exist?(blob.key) }
+  end
+
+  test "blobs used by retained books are not purged" do
+    user = users(:kevin)
+    private_book = books(:handbook)
+    private_book.update!(creator: user, everyone_access: false)
+    retained_book = books(:manual)
+    retained_book.update!(creator: user, everyone_access: true)
+    blob = pictures(:reading).image.blob
+    retained_book.cover.attach(blob)
+
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) do
+      user.destroy!
+    end
+
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert_equal blob, retained_book.reload.cover.blob
+    assert_equal "Deleted author", retained_book.author
+  end
+
+  test "database erasure including the search index rolls back on failure" do
+    user = users(:kevin)
+    books(:handbook).update!(creator: user, everyone_access: false)
+    books(:manual).update!(creator: user, author: user.name)
+    user.sessions.create!
+    Leaf.reindex_all
+    user.define_singleton_method(:erase_sign_in_events) do
+      super()
+      raise "Erasure failed"
+    end
+
+    assert_raises(RuntimeError) { user.destroy! }
+
+    assert User.exists?(user.id)
+    assert Book.exists?(books(:handbook).id)
+    assert_equal user.id, books(:manual).reload.creator_id
+    assert_equal user.name, books(:manual).author
+    assert Session.exists?(user_id: user.id)
+    assert SignInEvent.exists?(email_address: user.email_address)
+    assert_includes Leaf.search("great handbook"), leaves(:welcome_page)
+  end
+
+  test "legacy email recovery handles repeated removals without fuzzy matching" do
+    user = users(:kevin)
+    original_email = user.email_address
+    user.sessions.create!
+    user.deactivate
+    first_rewritten_email = user.email_address
+    user.sessions.create!
+    user.deactivate
+    unrelated = SignInEvent.create!(email_address: "kevin-deactivated-not-a-uuid@example.com", action: :signed_in)
+
+    user.destroy!
+
+    assert_not SignInEvent.exists?(email_address: [ original_email, first_rewritten_email, user.email_address ])
+    assert SignInEvent.exists?(unrelated.id)
+  end
+
+  test "active users with deactivation-like emails do not erase another address" do
+    user = users(:kevin)
+    original_email = user.email_address
+    event = SignInEvent.create!(email_address: original_email, action: :signed_in)
+    user.update!(email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com")
+    user.sessions.create!
+
+    user.destroy!
+
+    assert SignInEvent.exists?(event.id)
+    assert_not SignInEvent.exists?(email_address: user.email_address)
+  end
+end
