diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..ee196b8 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -22,6 +22,58 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "white-rabbit.webp", updated_picture.image.filename.to_s
   end
 
+  test "uploaded picture is processed once and reused by readers" do
+    # Pin the recipe used by reader URLs before sharing it with the background job.
+    expected_bytes = file_fixture("white-rabbit.webp").open do |original|
+      ActiveStorage::Variation.new(resize_to_limit: [ 1500, 1500 ], format: "webp").transform(original) do |output|
+        output.read
+      end
+    end
+
+    transformations = []
+    uploads = []
+    ActiveSupport::Notifications.subscribed(->(event) { transformations << event }, "transform.active_storage") do
+      ActiveSupport::Notifications.subscribed(->(event) { uploads << event.payload[:key] }, "service_upload.active_storage") do
+        assert_difference -> { transformations.size }, 1 do
+          perform_enqueued_jobs do
+            put leafable_path(leaves(:reading_picture)), params: {
+              picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+            }
+            assert_response :no_content
+          end
+        end
+
+        blob = leaves(:reading_picture).reload.picture.image.blob
+        assert_equal 1, blob.variant_records.count
+        derived = blob.variant_records.sole.image.blob
+        assert_equal expected_bytes, derived.download
+
+        books(:handbook).update!(published: true)
+        sign_out
+
+        assert_no_changes -> { transformations.size } do
+          2.times do
+            get leafable_slug_path(leaves(:reading_picture))
+            assert_response :success
+            image_path = css_select("figure img").sole["src"]
+
+            get image_path
+            assert_response :redirect
+            follow_redirect!
+            assert_response :success
+            assert_equal "image/webp", response.media_type
+            assert_equal expected_bytes, response.body.b
+          end
+        end
+
+        assert_equal 1, blob.variant_records.reload.count
+        assert_equal [ blob.key, derived.key ].sort, uploads.sort
+        assert blob.service.exist?(blob.key)
+        assert derived.service.exist?(derived.key)
+      end
+    end
+  end
+
   test "update caption" do
     get edit_leafable_path(leaves(:reading_picture))
     assert_response :ok
