+    def snapshot_access_list
+      # Read fresh grants before dependent destruction clears the association.
+      @access_list_to_archive = accesses.includes(:user).map do |access|
+        {
           book_id: id,
           book_title: title,
           user_id: access.user_id,
           user_name: access.user.name,
           level: access.level
-        )
+        }
+      end
+    end
+
+    def archive_access_list
+      @access_list_to_archive.each do |attributes|
+        AccessArchive.create!(attributes)
       end
     end
 end
diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..7e5c601 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,32 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy archives everyone with access at deletion" do
+    book = books(:handbook)
+
+    assert_no_difference -> { AccessArchive.count } do
+      accesses(:jason_handbook).destroy!
+      accesses(:david_handbook).update!(level: :reader)
+      accesses(:jz_handbook).update!(level: :editor)
+    end
+
+    expected = book.accesses.includes(:user).map do |access|
+      [ book.id, book.title, access.user_id, access.user.name, access.level ]
+    end
+
+    assert_difference -> { AccessArchive.count }, expected.size do
+      assert_difference -> { Book.count }, -1 do
+        assert_difference -> { Access.count }, -expected.size do
+          delete book_path(book)
+        end
+      end
+    end
+
+    assert_redirected_to root_path
+    assert_equal expected.sort, AccessArchive.where(book_id: book.id)
+      .pluck(:book_id, :book_title, :user_id, :user_name, :level).sort
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..27dd51e 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,63 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroy archives current access after deleting the book and grants" do
+    book = books(:manual)
+    expected = book.accesses.includes(:user).map do |access|
+      [ book.id, book.title, access.user_id, access.user.name, access.level ]
+    end
+    archive_writes = []
+    subscriber = ->(event) do
+      if event.payload[:sql].match?(/INSERT INTO "access_archives"/)
+        archive_writes << [ Book.exists?(book.id), Access.exists?(book_id: book.id) ]
+      end
+    end
+
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      assert_difference -> { AccessArchive.count }, expected.size do
+        book.destroy!
+      end
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+    assert_equal expected.sort, AccessArchive.where(book_id: book.id)
+      .pluck(:book_id, :book_title, :user_id, :user_name, :level).sort
+    assert_not_empty archive_writes
+    assert archive_writes.all? { |book_exists, access_exists| !book_exists && !access_exists }
+  end
+
+  test "destroy archives persisted access rather than previously loaded grants" do
+    book = books(:manual)
+    book.accesses.load
+
+    assert_no_difference -> { AccessArchive.count } do
+      accesses(:jason_manual).destroy!
+      accesses(:david_manual).update!(level: :reader)
+      accesses(:jz_manual).update!(level: :editor)
+      book.update!(title: "Updated manual")
+    end
+
+    assert_difference -> { AccessArchive.count }, 2 do
+      book.destroy!
+    end
+
+    assert_equal [ [ users(:david).id, "reader" ], [ users(:jz).id, "editor" ] ].sort,
+      AccessArchive.where(book_id: book.id).pluck(:user_id, :level).sort
+    assert_equal [ "Updated manual" ], AccessArchive.where(book_id: book.id).distinct.pluck(:book_title)
+  end
+
+  test "destroy with no access grants creates no archives" do
+    book = books(:manual)
+    book.accesses.load
+    Access.where(book: book).delete_all
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+  end
 end
