@@ -0,0 +1,76 @@
+require "test_helper"
+
+class MarkdownUploadPurgeTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "an upload can be fetched back from the URL the app hands out" do
+    _page, attachment = page_with_uploaded_image
+
+    get action_text_markdown_upload_path(slug: attachment.slug)
+
+    assert_response :redirect
+    assert_match /\/rails\/active_storage\/.*\/reading\.webp/, @response.redirect_url
+
+    get @response.redirect_url
+
+    assert_response :ok
+    assert_equal "image/webp", response.headers["Content-Type"]
+  end
+
+  test "destroying a page purges its embedded image" do
+    page, attachment = page_with_uploaded_image
+    blob = attachment.blob
+    key = blob.key
+
+    assert_enqueued_with job: ActiveStorage::PurgeJob do
+      page.destroy!
+    end
+
+    perform_enqueued_jobs
+
+    assert_not ActionText::Markdown.exists?(attachment.record_id), "the markdown record should be gone"
+    assert_not ActiveStorage::Attachment.exists?(attachment.id), "the attachment record should be gone"
+    assert_not ActiveStorage::Blob.exists?(blob.id), "the blob record should be gone"
+    assert_not ActiveStorage::Blob.service.exist?(key), "the image file should be gone from the storage service"
+
+    get action_text_markdown_upload_path(slug: attachment.slug)
+
+    assert_response :not_found
+  end
+
+  test "destroying a book purges the images embedded in its pages" do
+    page, attachment = page_with_uploaded_image
+    blob = attachment.blob
+    key = blob.key
+
+    assert_enqueued_with job: ActiveStorage::PurgeJob do
+      page.leaf.book.destroy!
+    end
+
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Blob.exists?(blob.id), "the blob record should be gone"
+    assert_not ActiveStorage::Blob.service.exist?(key), "the image file should be gone from the storage service"
+  end
+
+  private
+    def page_with_uploaded_image
+      leaf = books(:handbook).press Page.new(body: "Look at this:"), title: "With image"
+
+      post action_text_markdown_uploads_path, params: {
+        record_gid: leaf.leafable.to_signed_global_id.to_s,
+        attribute_name: "body",
+        file: fixture_file_upload("reading.webp", "image/webp")
+      }, as: :xhr
+
+      assert_response :success
+
+      page = leaf.reload.leafable
+      attachment = page.markdown_body.uploads.reload.last
+      assert_not_nil attachment, "expected an image attached to the page body"
+
+      [ page, attachment ]
+    end
+end
