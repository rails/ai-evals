diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..307c593 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,57 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "update is not allowed to readers" do
+    sign_in :jz
+
+    patch book_path(books(:handbook)), params: { book: { title: "Renamed" } }
+
+    assert_response :forbidden
+    assert_equal "Handbook", books(:handbook).reload.title
+  end
+
+  test "destroy is not allowed to readers" do
+    sign_in :jz
+
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:handbook))
+    end
+
+    assert_response :forbidden
+    assert Book.exists?(books(:handbook).id)
+  end
+
+  test "destroy is not allowed to people who can only read a published book" do
+    books(:manual).update! published: true
+    sign_in :kevin
+
+    assert_no_difference -> { Book.count } do
+      delete book_path(books(:manual))
+    end
+
+    assert_response :forbidden
+    assert Book.exists?(books(:manual).id)
+  end
+
+  test "destroy is allowed to editors" do
+    sign_in :kevin
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:handbook))
+    end
+
+    assert_redirected_to root_url
+  end
+
+  test "destroy is allowed to administrators" do
+    sign_in :david
+    books(:manual).update! published: true
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_path(books(:manual))
+    end
+
+    assert_redirected_to root_url
+  end
 end
