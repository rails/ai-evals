@@ -30,4 +32,14 @@ class SessionsController < ApplicationController
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
     end
+
+    # The page a reader should land on once they've signed in, as carried by links
+    # to the sign-in page. Only destinations on this very site are honored: an
+    # absolute URL for our own host or a path relative to it. Anything else --
+    # another host, a protocol-relative URL, a bogus scheme, garbage -- is dropped,
+    # so a crafted sign-in link can't send readers to a look-alike page that asks
+    # for their password again.
+    def return_to_after_authenticating
+      url_from(params[:return_to])
+    end
 end
