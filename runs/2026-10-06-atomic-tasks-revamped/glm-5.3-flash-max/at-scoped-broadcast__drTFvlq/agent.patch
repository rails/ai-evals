--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -28,6 +28,14 @@ module Book::Accessable
     access_for(user: user)&.editor? || user&.administrator?
   end
 
+  # The users who currently have edit access to this book. They are the only ones who can have
+  # this book's pages open for editing, and so the only ones who may see who else is editing.
+  def editors
+    accesses.includes(:user).collect(&:user).select do |user|
+      user.active? && editable?(user: user)
+    end
+  end
+
   def access_for(user: Current.user)
     accesses.find_by(user: user)
   end
