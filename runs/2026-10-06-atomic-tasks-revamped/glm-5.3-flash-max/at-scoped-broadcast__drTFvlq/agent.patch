diff --git a/test/controllers/being_edited_indicator_test.rb b/test/controllers/being_edited_indicator_test.rb
new file mode 100644
index 0000000..72000be
--- /dev/null
+++ b/test/controllers/being_edited_indicator_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+  include ActionCable::TestHelper
+
+  setup do
+    @book = books(:handbook)
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "edit page subscribes the current user to their own being edited stream" do
+    sign_in :kevin
+
+    assert_equal [ @leaf.to_gid_param, users(:kevin).to_gid_param, "being_edited" ].join(":"),
+      subscribed_stream_name(as: :kevin)
+  end
+
+  test "saving a page broadcasts the being edited indicator to those who can edit the book" do
+    sign_in :kevin
+
+    assert_broadcasts indicator_stream_for(users(:david)), 1 do
+      assert_broadcasts indicator_stream_for(users(:kevin)), 1 do
+        update_leaf
+      end
+    end
+
+    assert_includes indicator_broadcast_for(users(:david)), users(:kevin).name
+    assert_includes indicator_broadcast_for(users(:david)), dom_id(@leaf, :being_edited)
+  end
+
+  test "saving a page does not broadcast the being edited indicator on the leaf's shared stream" do
+    sign_in :kevin
+
+    assert_no_broadcasts shared_indicator_stream do
+      update_leaf
+    end
+  end
+
+  test "saving a page does not broadcast the being edited indicator to a collaborator removed from the book" do
+    # Jason has the editor open while he still has access, then is removed from the book.
+    stale_stream = subscribed_stream_name(as: :jason)
+
+    @book.accesses.where(user: users(:jason)).delete_all
+
+    sign_in :kevin
+    assert_no_broadcasts stale_stream do
+      assert_broadcasts indicator_stream_for(users(:david)), 1 do
+        update_leaf
+      end
+    end
+  end
+
+  test "saving a page does not broadcast the being edited indicator to readers" do
+    sign_in :kevin
+
+    assert_no_broadcasts indicator_stream_for(users(:jz)) do
+      update_leaf
+    end
+  end
+
+  private
+    def update_leaf
+      perform_enqueued_jobs do
+        put book_page_path(@book, @leaf), params: { leaf: { title: @leaf.title }, page: { body: "Updated body" } }
+      end
+      assert_response :success
+    end
+
+    # Opens the editor and returns the signed stream name its presence indicator subscribes to.
+    def subscribed_stream_name(as:)
+      sign_in as
+      get edit_book_page_path(@book, @leaf)
+      assert_response :success
+
+      signed_stream_name = response.body[/signed-stream-name="([^"]+)"/, 1]
+      Turbo.signed_stream_verifier.verified(signed_stream_name).tap { sign_out }
+    end
+
+    def shared_indicator_stream
+      Turbo::StreamsChannel.send :stream_name_from, [ @leaf, :being_edited ]
+    end
+
+    def indicator_stream_for(user)
+      Turbo::StreamsChannel.send :stream_name_from, [ @leaf, user, :being_edited ]
+    end
+
+    def indicator_broadcast_for(user)
+      broadcasts(indicator_stream_for(user)).join
+    end
+end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..4981a82 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,28 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors are the users who currently have edit access" do
+    book = books(:handbook)
+
+    assert_includes book.editors, users(:kevin)
+    assert_not_includes book.editors, users(:jz) # reader
+
+    book.accesses.where(user: users(:kevin)).delete_all
+    assert_not_includes book.editors, users(:kevin)
+  end
+
+  test "editors include administrators, who can edit regardless of their access level" do
+    book = books(:handbook)
+    book.access_for(user: users(:david)).update! level: :reader
+
+    assert_includes book.editors, users(:david)
+  end
+
+  test "editors exclude deactivated users" do
+    book = books(:handbook)
+    users(:kevin).update! active: false
+
+    assert_not_includes book.editors, users(:kevin)
+  end
 end
