diff --git a/test/integration/book_absence_test.rb b/test/integration/book_absence_test.rb
index b9c20ac..3454465 100644
--- a/test/integration/book_absence_test.rb
+++ b/test/integration/book_absence_test.rb
@@ -8,4 +8,24 @@ class BookAbsenceTest < ActionDispatch::IntegrationTest
       end
     end
   end
+
+  test "an unpublished book is rendered as a missing page, not as forbidden" do
+    get book_slug_url(books(:manual))
+
+    assert_response :not_found
+  end
+
+  test "with_raised_exceptions only applies to requests made inside its block" do
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_url(books(:manual))
+      end
+    end
+
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+  end
 end
diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..c471d1a 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,31 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Requests made inside the block let errors from the application reach the
+    # test as the raised exception, requests made outside of it render error
+    # pages like they always do.
+    #
+    # The setting has to be applied per request. `Rails::Application#env_config`
+    # is merged into the env of every request (see `Rails::Engine#build_request`)
+    # and it snapshots `config.action_dispatch.show_exceptions` the first time it
+    # is built. Changing the config alone therefore does nothing for requests
+    # made after that snapshot, and would let whatever value happened to be in
+    # effect during the first request of a worker process stick around for the
+    # rest of that process -- which is what made the suite order dependent.
     def with_raised_exceptions
       previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      set_show_exceptions :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      set_show_exceptions previous
+    end
+
+  private
+    # Keep the config and the per-request env value in sync, so requests can't
+    # pick up a stale snapshot of the config.
+    def set_show_exceptions(value)
+      Rails.application.config.action_dispatch.show_exceptions = value
+      Rails.application.env_config["action_dispatch.show_exceptions"] = value
     end
   end
 end
