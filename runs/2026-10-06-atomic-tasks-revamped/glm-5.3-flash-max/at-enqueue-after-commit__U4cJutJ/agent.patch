@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Books::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "import hands off work for every book in the batch" do
+    post books_import_url, params: { books: {
+      books(:handbook).id.to_s => { title: "Imported Handbook" },
+      books(:manual).id.to_s => { title: "Imported Manual" } } }
+
+    assert_redirected_to root_url
+    assert_enqueued_with job: Book::SearchIndexJob, args: [ books(:handbook) ]
+    assert_enqueued_with job: Book::SearchIndexJob, args: [ books(:manual) ]
+  end
+
+  test "import of a whole batch is all or nothing" do
+    post books_import_url, params: { books: {
+      books(:handbook).id.to_s => { title: "Imported Handbook" },
+      "99999999" => { title: "Missing Book" } } }
+
+    assert_enqueued_jobs 0, only: [ Book::SearchIndexJob, Book::CoverProcessingJob ]
+  end
+
+  test "abandoned batch still notifies the operator" do
+    post books_import_url, params: { books: { "99999999" => { title: "Missing Book" } } }
+
+    assert_equal users(:david).id, enqueued_jobs.select { it[:job] == Books::ImportFailureJob }.first[:args].first
+  end
+end
diff --git a/test/models/book/editing_test.rb b/test/models/book/editing_test.rb
new file mode 100644
index 0000000..d30a179
--- /dev/null
+++ b/test/models/book/editing_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class BookEditingTest < ActiveSupport::TestCase
+  setup do
+    ActiveJob::Base.queue_adapter.enqueued_jobs.clear
+  end
+
+  test "apply_edit hands off work after the edit commits" do
+    book = books(:handbook)
+    book.apply_edit title: "Renamed", cover: cover
+
+    assert_equal [ Book::SearchIndexJob, Book::CoverProcessingJob ], enqueued_jobs.map { it[:job] }
+    assert_equal [ "gid://writebook/Book/#{book.id}" ] * 2, enqueued_jobs.map { it[:args].first["_aj_globalid"] }
+  end
+
+  test "apply_edit hands off nothing while the edit is still open" do
+    book = books(:handbook)
+
+    Book.transaction do
+      book.apply_edit title: "Renamed in a transaction"
+
+      assert_empty enqueued_jobs
+      raise ActiveRecord::Rollback
+    end
+
+    assert_empty enqueued_jobs
+    assert_equal "Handbook", book.reload.title
+  end
+
+  test "abandoned edit hands off nothing" do
+    book = books(:handbook)
+
+    assert_raise do
+      Book.transaction do
+        book.apply_edit title: "Renamed", cover: cover
+        raise "abandoned"
+      end
+    end
+
+    assert_empty enqueued_jobs
+    assert_equal "Handbook", book.reload.title
+  end
+
+  private
+    def enqueued_jobs
+      ActiveJob::Base.queue_adapter.enqueued_jobs
+    end
+
+    def cover
+      Rack::Test::UploadedFile.new(Rails.root.join("test/fixtures/files/reading.webp"), "image/webp")
+    end
+end
