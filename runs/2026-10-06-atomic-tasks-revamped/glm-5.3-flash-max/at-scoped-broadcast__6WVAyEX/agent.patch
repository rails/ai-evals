diff --git a/test/controllers/being_edited_broadcast_test.rb b/test/controllers/being_edited_broadcast_test.rb
new file mode 100644
index 0000000..74140e9
--- /dev/null
+++ b/test/controllers/being_edited_broadcast_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class BeingEditedBroadcastTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:handbook)
+    @leaf = leaves(:welcome_page)
+  end
+
+  test "update broadcasts the being edited indicator to editors of the book" do
+    sign_in :jason
+
+    perform_enqueued_jobs do
+      patch book_page_path(@book, @leaf), params: { page: { body: "New body" } }
+    end
+
+    assert_response :success
+
+    @book.editors.each do |editor|
+      assert_broadcasts stream_name_for(editor, @leaf, :being_edited), 1
+    end
+
+    # the indicator still shows who is editing
+    content = broadcasts(stream_name_for(users(:kevin), @leaf, :being_edited)).sole
+    assert_includes content, "Jason"
+    assert_includes content, dom_id(@leaf, :being_edited)
+  end
+
+  test "update does not broadcast the being edited indicator to a collaborator removed from the book" do
+    sign_in :jason
+    removed = users(:kevin)
+    @book.access_for(user: removed).destroy!
+
+    perform_enqueued_jobs do
+      patch book_page_path(@book, @leaf), params: { page: { body: "New body" } }
+    end
+
+    assert_response :success
+    assert_no_broadcasts stream_name_for(removed, @leaf, :being_edited)
+    assert_no_broadcasts stream_name_for(@leaf, :being_edited)
+  end
+
+  test "update does not broadcast the being edited indicator to a reader" do
+    sign_in :jason
+
+    perform_enqueued_jobs do
+      patch book_page_path(@book, @leaf), params: { page: { body: "New body" } }
+    end
+
+    assert_response :success
+    assert_no_broadcasts stream_name_for(users(:jz), @leaf, :being_edited)
+  end
+
+  test "edit page subscribes to the stream of the current user" do
+    sign_in :kevin
+
+    get edit_book_page_path(@book, @leaf)
+
+    assert_response :success
+    assert_select "turbo-cable-stream-source[channel='Turbo::StreamsChannel']" do |elements|
+      signed_stream_name = elements.first["signed-stream-name"]
+      assert_equal stream_name_for(users(:kevin), @leaf, :being_edited),
+        Turbo::StreamsChannel.verified_stream_name(signed_stream_name)
+    end
+  end
+
+  private
+    def stream_name_for(*streamables)
+      Turbo::StreamsChannel.verified_stream_name Turbo::StreamsChannel.signed_stream_name(streamables)
+    end
+end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..94cbeb3 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,25 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors returns users that can edit the book" do
+    book = books(:handbook)
+
+    assert_equal [ users(:david), users(:jason), users(:kevin) ].map(&:name).sort, book.editors.map(&:name).sort
+    assert_not_includes book.editors, users(:jz)
+  end
+
+  test "editors includes administrators without access to the book" do
+    book = Book.create!(title: "Secret book", everyone_access: false)
+
+    assert_includes book.editors, users(:david)
+    assert_not_includes book.editors, users(:kevin)
+  end
+
+  test "editors excludes users removed from the book" do
+    book = books(:handbook)
+    book.access_for(user: users(:kevin)).destroy!
+
+    assert_not_includes book.editors, users(:kevin)
+  end
 end
