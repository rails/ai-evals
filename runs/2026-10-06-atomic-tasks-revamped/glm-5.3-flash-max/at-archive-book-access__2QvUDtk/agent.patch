diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..0b14d41 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,59 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives everyone who had access to it" do
+    book = books(:handbook)
+
+    assert_difference -> { AccessArchive.count }, +4 do
+      book.destroy
+    end
+
+    archived = AccessArchive.where(book_id: book.id).index_by(&:user_name)
+    assert_equal %w[ David JZ Jason Kevin ], archived.keys.sort
+    assert_equal "reader", archived["JZ"].level
+    assert_equal "editor", archived["David"].level
+    assert_equal "editor", archived["Jason"].level
+    assert_equal "editor", archived["Kevin"].level
+    assert_equal book.title, archived["JZ"].book_title
+    assert_not Book.exists?(book.id)
+  end
+
+  test "destroying a book does not archive access that was revoked earlier" do
+    book = books(:handbook)
+    book.accesses.find_by(user: users(:jz)).destroy!
+
+    book.destroy
+
+    assert_not_includes AccessArchive.where(book_id: book.id).collect(&:user_name), "JZ"
+    assert_equal 3, AccessArchive.where(book_id: book.id).count
+  end
+
+  test "destroying a book nobody has access to archives nothing" do
+    book = Book.create!(title: "Unshared")
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+
+    assert_not Book.exists?(book.id)
+  end
+
+  test "nothing is archived until the book is deleted" do
+    statements = []
+    subscriber = ActiveSupport::Notifications.subscribe "sql.active_record" do |event|
+      statements << event.payload[:sql].to_s.upcase
+    end
+
+    books(:handbook).destroy
+  ensure
+    ActiveSupport::Notifications.unsubscribe subscriber
+
+    deleted = statements.index { |statement| statement.include?(%(DELETE FROM "BOOKS")) }
+    archived = statements.index { |statement| statement.include?(%(INSERT INTO "ACCESS_ARCHIVES")) }
+
+    assert_not_nil deleted
+    assert_not_nil archived
+    assert_operator deleted, :<, archived
+  end
 end
