diff --git a/test/models/book/reportable_test.rb b/test/models/book/reportable_test.rb
new file mode 100644
index 0000000..b3dedd8
--- /dev/null
+++ b/test/models/book/reportable_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Book::ReportableTest < ActiveSupport::TestCase
+  test "report_summary spells out the book title and character count" do
+    assert_equal "Handbook — 57 characters", books(:handbook).report_summary
+  end
+
+  test "report_summary groups the character count in thousands" do
+    leaves(:welcome_page).leafable.update!(body: "a" * 500)
+    leaves(:summary_page).leafable.update!(body: "a" * 500)
+
+    book = books(:handbook)
+
+    assert_equal "Handbook — #{book.markable.length.to_fs(:delimited)} characters", book.report_summary
+    assert_match(/\d{1,3},\d{3} characters/, book.report_summary)
+  end
+
+  test "leaf_count only counts active leaves" do
+    leaves(:summary_page).trashed!
+
+    assert_equal books(:handbook).leaves.active.count, books(:handbook).leaf_count
+  end
+
+  test "last_edited_at is the newest active leaf update" do
+    leaves(:welcome_page).touch
+
+    assert_equal leaves(:welcome_page).updated_at, books(:handbook).last_edited_at
+  end
+end
