--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    @book = books(:handbook)
+  end
+
+  test "show reports when the book was last updated" do
+    get book_report_path(@book)
+
+    assert_response :success
+    assert_in_body "Last updated #{@book.updated_at.to_date.to_fs(:long)}"
+    assert_in_body @book.report_summary
+  end
+
+  test "show downloads the card as text" do
+    get book_report_path(@book, format: :text)
+
+    assert_response :success
+    assert_equal "text/plain", @response.media_type
+    assert_includes @response.headers["Content-Disposition"], "shelf-report-#{@book.updated_at.to_fs(:number)}.txt"
+    assert_in_body Publishing::ReportCard.new(@book).to_text
+  end
+end
