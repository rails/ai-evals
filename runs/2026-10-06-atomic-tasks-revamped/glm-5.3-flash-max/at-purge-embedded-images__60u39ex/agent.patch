diff --git a/lib/rails_ext/action_text_markdown.rb b/lib/rails_ext/action_text_markdown.rb
index fa0a622..2eca6e4 100644
--- a/lib/rails_ext/action_text_markdown.rb
+++ b/lib/rails_ext/action_text_markdown.rb
@@ -29,7 +29,10 @@ module ActionText::Markdown::Uploads
   extend ActiveSupport::Concern
 
   included do
-    has_many_attached :uploads, dependent: :destroy
+    # Files uploaded into the markdown are only referenced from the content, so they
+    # have to go away with the record they're attached to. Destroying the attachments
+    # alone would leave both their blob records and their files behind.
+    has_many_attached :uploads, dependent: :purge_later
   end
 end
 
diff --git a/test/integration/markdown_upload_flow_test.rb b/test/integration/markdown_upload_flow_test.rb
new file mode 100644
index 0000000..b8e0e17
--- /dev/null
+++ b/test/integration/markdown_upload_flow_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class MarkdownUploadFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "upload an image into a page's markdown and fetch it back" do
+    page = pages(:welcome)
+
+    post action_text_markdown_uploads_url, params: {
+      record_gid: page.to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+
+    assert_response :created
+    file_url = JSON.parse(response.body)["fileUrl"]
+    assert file_url.start_with?("/")
+
+    get file_url
+    assert_response :redirect
+    assert_match %r{/rails/active_storage/.*reading\.webp}, @response.redirect_url
+
+    get @response.redirect_url.delete_prefix("http://www.example.com")
+    assert_response :ok
+  end
+
+  test "destroying a page removes the embedded image and its file" do
+    page = pages(:welcome)
+    markdown = page.body
+    markdown.uploads.attach fixture_file_upload("reading.webp", "image/webp")
+    page.save!
+    markdown.reload
+
+    attachment = markdown.uploads.attachments.last
+    blob = attachment.blob
+
+    get action_text_markdown_upload_url(slug: attachment.slug)
+    assert_response :redirect
+
+    perform_enqueued_jobs { leaves(:welcome_page).destroy! }
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+
+    get action_text_markdown_upload_url(slug: attachment.slug)
+    assert_response :not_found
+  end
+end
diff --git a/test/models/demo_purge_test.rb b/test/models/demo_purge_test.rb
new file mode 100644
index 0000000..ef154f2
--- /dev/null
+++ b/test/models/demo_purge_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+require "active_job/test_helper"
+
+class DemoPurgeTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "destroying a book loaded with demo content purges its uploaded images" do
+    DemoContent.create_manual users(:david)
+    book = Book.find_by!(title: "The Writebook Manual")
+
+    blobs = book.leaves.pages.flat_map { |leaf| leaf.page.body.uploads.blobs }
+    assert blobs.many?, "expected demo content to embed uploaded images"
+
+    perform_enqueued_jobs { book.destroy! }
+
+    blobs.each do |blob|
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+  end
+end
diff --git a/test/models/page_upload_purge_test.rb b/test/models/page_upload_purge_test.rb
new file mode 100644
