--- /dev/null
+++ b/test/models/page_upload_purge_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+require "active_job/test_helper"
+
+class PageUploadPurgeTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @page = pages(:welcome)
+    @markdown = @page.body
+    @markdown.uploads.attach Rack::Test::UploadedFile.new(Rails.root.join("test/fixtures/files/reading.webp"), "image/webp")
+    @page.save!
+    @markdown.reload
+    @attachment = @markdown.uploads.attachments.last
+    @blob = @attachment.blob
+  end
+
+  test "destroying a page purges the embedded image's blob and file" do
+    assert ActiveStorage::Attachment.exists?(@attachment.id)
+    assert ActiveStorage::Blob.exists?(@blob.id)
+    assert @blob.service.exist?(@blob.key)
+
+    assert_difference -> { ActiveStorage::Blob.count }, -1 do
+      perform_enqueued_jobs { @page.destroy! }
+    end
+
+    assert_not ActionText::Markdown.exists?(@markdown.id)
+    assert_not ActiveStorage::Attachment.exists?(@attachment.id)
+    assert_not ActiveStorage::Blob.exists?(@blob.id)
+    assert_not @blob.service.exist?(@blob.key)
+  end
+
+  test "destroying a book purges embedded images" do
+    perform_enqueued_jobs { @page.book.destroy! }
+
+    assert_not ActiveStorage::Blob.exists?(@blob.id)
+    assert_not @blob.service.exist?(@blob.key)
+  end
+
+  test "destroying a page purges all of its embedded images" do
+    @markdown.uploads.attach Rack::Test::UploadedFile.new(Rails.root.join("test/fixtures/files/white-rabbit.webp"), "image/webp")
+    @page.save!
+    @markdown.reload
+
+    blobs = @markdown.uploads.blobs.to_a
+    assert blobs.many?
+
+    perform_enqueued_jobs { @page.destroy! }
+
+    blobs.each do |blob|
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+  end
+
+  test "destroying a picture still purges its image" do
+    picture = pictures(:reading)
+    blob = picture.image.blob
+
+    assert_difference -> { ActiveStorage::Blob.count }, -1 do
+      perform_enqueued_jobs { picture.leaf.destroy! }
+    end
+
+    assert_not blob.service.exist?(blob.key)
+  end
+
+  test "a failed destroy leaves the embedded image intact" do
+    Page.transaction do
+      @page.destroy!
+      raise ActiveRecord::Rollback
+    end
+
+    assert ActiveStorage::Blob.exists?(@blob.id)
+    assert @blob.service.exist?(@blob.key)
+  end
+end
