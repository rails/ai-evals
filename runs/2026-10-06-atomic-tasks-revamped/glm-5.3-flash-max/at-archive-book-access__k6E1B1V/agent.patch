diff --git a/test/models/access_archive_test.rb b/test/models/access_archive_test.rb
new file mode 100644
index 0000000..7f411a2
--- /dev/null
+++ b/test/models/access_archive_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class AccessArchiveTest < ActiveSupport::TestCase
+  test "destroying a book archives one row per access" do
+    book = books(:handbook)
+
+    assert_difference -> { AccessArchive.count }, +4 do
+      book.destroy
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_empty Access.where(book_id: book.id)
+
+    archived = AccessArchive.where(book_id: book.id).index_by(&:user_id)
+    assert_equal %w[ David JZ Jason Kevin ], archived.values.pluck(:user_name).sort
+    assert_equal [ "Handbook" ], archived.values.pluck(:book_title).uniq
+
+    assert_equal "editor", archived.fetch(users(:david).id).level
+    assert_equal "editor", archived.fetch(users(:kevin).id).level
+    assert_equal "reader", archived.fetch(users(:jz).id).level
+  end
+
+  test "destroying a book nobody had access to archives nothing" do
+    book = Book.create!(title: "Lonely")
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+
+    assert_not Book.exists?(book.id)
+  end
+
+  test "access revoked before the destroy is not archived" do
+    book = books(:manual)
+    book.accesses.find_by(user: users(:jz)).destroy!
+
+    assert_difference -> { AccessArchive.count }, +2 do
+      book.destroy
+    end
+
+    archived = AccessArchive.where(book_id: book.id)
+    assert_equal %w[ David Jason ], archived.pluck(:user_name).sort
+  end
+
+  test "accesses deleted after they were loaded are not archived" do
+    book = books(:manual)
+    book.accesses.to_a
+    book.accesses.where(user: users(:jz)).delete_all
+
+    assert_difference -> { AccessArchive.count }, +2 do
+      book.destroy
+    end
+
+    archived = AccessArchive.where(book_id: book.id)
+    assert_equal %w[ David Jason ], archived.pluck(:user_name).sort
+  end
+end
