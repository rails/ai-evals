diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..647f49a 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,47 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    # Publication is noted when the book is saved, not in the commit callback,
+    # because anything else a sitting saves (e.g. a leaf touching its book) wipes
+    # the saved change record before the commit callbacks run. And it's noted
+    # against the book's id rather than on the instance, because the commit
+    # callbacks can be run on another instance of the same book, the one a leaf
+    # touched last in the sitting.
+    #
+    # So a book that ends up live is announced exactly once, whatever else the
+    # sitting did; an already live book saved again isn't announced again; a save
+    # that doesn't take the book live announces nothing; and a sitting that fails
+    # after the book was marked live leaves a draft and announces nothing.
+    after_save :note_publication, if: :saved_change_to_published?
+    after_save_commit :announce_publication, if: :publication_noted?
+    after_rollback :forget_publication
   end
 
   private
+    def note_publication
+      published? ? note_for_announcement : forget_publication
+    end
+
+    def note_for_announcement
+      publications_to_announce[id] = true
+    end
+
+    def publication_noted?
+      publications_to_announce.key?(id)
+    end
+
+    def forget_publication
+      publications_to_announce.delete(id)
+    end
+
     def announce_publication
+      forget_publication
       AnnouncePublicationJob.perform_later self
     end
+
+    # Noted publications of the current execution, so that they survive the rest
+    # of the sitting and aren't seen by any other.
+    def publications_to_announce
+      ActiveSupport::IsolatedExecutionState[:"#{self.class.name}.publications_to_announce"] ||= {}
+    end
 end
