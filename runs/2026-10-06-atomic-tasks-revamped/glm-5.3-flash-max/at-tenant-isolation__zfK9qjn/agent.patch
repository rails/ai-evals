diff --git a/db/migrate/20241001000000_create_tenants.rb b/db/migrate/20241001000000_create_tenants.rb
new file mode 100644
index 0000000..3d5c909
--- /dev/null
+++ b/db/migrate/20241001000000_create_tenants.rb
@@ -0,0 +1,33 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |direction|
+      direction.up { sweep_existing_records_into_one_tenant }
+    end
+  end
+
+  private
+    # Running installs upgrade in place: everything that exists today becomes
+    # a single tenant, so nothing changes for the people already using it.
+    def sweep_existing_records_into_one_tenant
+      tenant_id = insert <<-SQL.squish
+        INSERT INTO tenants (name, created_at, updated_at)
+        VALUES (#{quote(tenant_name)}, #{quote(Time.current)}, #{quote(Time.current)})
+      SQL
+
+      execute "UPDATE users SET tenant_id = #{tenant_id}"
+      execute "UPDATE books SET tenant_id = #{tenant_id}"
+    end
+
+    def tenant_name
+      connection.select_value("SELECT name FROM accounts ORDER BY id LIMIT 1").presence || "Writebook"
+    end
+end
