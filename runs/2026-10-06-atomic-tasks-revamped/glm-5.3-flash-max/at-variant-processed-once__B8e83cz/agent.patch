@@ -2,7 +2,12 @@ class Picture < ApplicationRecord
   include Leafable
 
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    # Variants are preprocessed on upload (process: :later), then looked up again when a
+    # reader fetches the picture. That lookup is keyed on a digest of the transformations,
+    # which Active Storage sends along inside the representation URL and gets back as JSON.
+    # JSON turns :webp into "webp", so the format must be a String here: otherwise the
+    # digest doesn't match and readers derive and store the picture a second time.
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
diff --git a/test/integration/picture_derivation_test.rb b/test/integration/picture_derivation_test.rb
new file mode 100644
index 0000000..cbe5391
--- /dev/null
+++ b/test/integration/picture_derivation_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class PictureDerivationTest < ActionDispatch::IntegrationTest
+  test "an upload is derived once and reading it does no further processing" do
+    sign_in :kevin
+
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:reading_picture)), params: {
+        leaf: { title: "Reading" },
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+      }
+    end
+
+    picture = Picture.order(:id).last
+    derived = picture.large_image
+    assert derived.processed?, "the upload should have been derived by the background job"
+
+    assert_no_difference [ "ActiveStorage::Blob.count", "ActiveStorage::VariantRecord.count" ] do
+      fetch_large_image
+      assert_equal derived.download, response.body, "readers should be served the derived copy"
+
+      fetch_large_image
+      assert_equal derived.download, response.body
+    end
+  end
+
+  test "a reader that gets there before the background job leaves only one derived copy" do
+    sign_in :kevin
+
+    put leafable_path(leaves(:reading_picture)), params: {
+      leaf: { title: "Reading" },
+      picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+    }
+
+    get leafable_slug_path(leaves(:reading_picture))
+    assert_response :success
+    fetch_large_image
+    served = response.body
+
+    perform_enqueued_jobs
+
+    picture = Picture.order(:id).last
+    assert_equal 1, picture.image.blob.variant_records.count,
+      "the background job should not derive the picture a second time"
+
+    fetch_large_image
+    assert_equal served, response.body
+  end
+
+  private
+    # Open the picture page and follow its large image link like a reader would.
+    def fetch_large_image
+      get leafable_slug_path(leaves(:reading_picture))
+      assert_response :success
+
+      get large_image_url
+      assert_response :redirect
+
+      get response.headers["Location"]
+      assert_response :success
+    end
+
+    def large_image_url
+      response.body[/src="([^"]*rails\/active_storage\/representations[^"]*)"/, 1] ||
+        raise("no large image link on the page")
+    end
+end
