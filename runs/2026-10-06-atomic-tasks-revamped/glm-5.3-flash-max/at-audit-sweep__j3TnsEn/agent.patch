diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
index 153d542..d3b952f 100644
--- a/app/controllers/searches_controller.rb
+++ b/app/controllers/searches_controller.rb
@@ -3,6 +3,11 @@ class SearchesController < ApplicationController
 
   RESULT_LIMIT = 50
 
+  # LIKE treats "%" and "_" as wildcards. The term is escaped with this character
+  # so that both are matched literally, and so the escape character itself can
+  # never be smuggled into the pattern unescaped.
+  LIKE_ESCAPE_CHARACTER = "\\"
+
   def show
     @query = params[:q].to_s.strip
     @leaves = @query.present? ? matching_leaves : Leaf.none
@@ -11,7 +16,8 @@ class SearchesController < ApplicationController
   private
     def matching_leaves
       Leaf.active.joins(:book)
-        .where("books.id in (#{readable_book_ids.join(",")}) and leaves.title like '%#{@query}%'")
+        .where(books: { id: readable_book_ids })
+        .where("leaves.title LIKE ? ESCAPE '\\'", "%#{escape_like_wildcards(@query)}%")
         .order("books.title", "leaves.position_score")
         .limit(RESULT_LIMIT)
     end
@@ -19,4 +25,10 @@ class SearchesController < ApplicationController
     def readable_book_ids
       Book.accessable_or_published.ids.presence || [ 0 ]
     end
+
+    # Whatever was typed is data: it is bound as a parameter and its own
+    # wildcards are escaped, so it can never reach the pattern or the SQL around it.
+    def escape_like_wildcards(term)
+      Leaf.sanitize_sql_like term, LIKE_ESCAPE_CHARACTER
+    end
 end
