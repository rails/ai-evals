diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..1b16f7e
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,167 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @manual_page = books(:manual).press Page.new(body: "Manual only content"), title: "Manual page"
+    @percent_page = books(:handbook).press Page.new(body: "Half price"), title: "Save 50% off"
+    @underscore_page = books(:handbook).press Page.new(body: "Snake case"), title: "snake_case_title"
+    @backslash_page = books(:handbook).press Page.new(body: "Escaped"), title: "back\\slash page"
+  end
+
+  test "show without a query shows no results" do
+    sign_in :jz
+
+    get library_search_path
+
+    assert_response :success
+    assert_no_results
+  end
+
+  test "show finds leaves by title" do
+    sign_in :jz
+
+    get library_search_path(q: "Save 50")
+
+    assert_response :success
+    assert_result "Save 50% off"
+  end
+
+  test "show finds leaves of published books for a signed out visitor" do
+    sign_out
+    books(:handbook).update! published: true
+
+    get library_search_path(q: "Welcome")
+
+    assert_response :success
+    assert_result "Welcome to The Handbook!"
+    assert_no_result "Manual page"
+  end
+
+  test "show does not find leaves of books the searcher may not read" do
+    sign_in :kevin
+
+    get library_search_path(q: "Manual page")
+
+    assert_response :success
+    assert_no_results
+  end
+
+  test "show treats the query as data, not as SQL" do
+    sign_in :kevin
+
+    get library_search_path(q: "%' or 1=1 --")
+
+    assert_response :success
+    assert_no_results
+  end
+
+  test "show does not error on punctuation" do
+    sign_in :jz
+
+    get library_search_path(q: "O'Brien")
+    assert_response :success
+
+    get library_search_path(q: "\"; drop table leaves; --")
+    assert_response :success
+
+    get library_search_path(q: "!!")
+    assert_response :success
+  end
+
+  test "show finds a title containing a per cent sign" do
+    sign_in :jz
+
+    get library_search_path(q: "Save 50% off")
+
+    assert_response :success
+    assert_result "Save 50% off"
+  end
+
+  test "show finds a title by a per cent sign alone" do
+    sign_in :jz
+
+    get library_search_path(q: "%")
+
+    assert_response :success
+    assert_result "Save 50% off"
+  end
+
+  test "show does not match titles without a per cent sign" do
+    sign_in :jz
+
+    get library_search_path(q: "%")
+
+    assert_response :success
+    assert_no_result "Welcome to The Handbook!"
+  end
+
+  test "show finds a title containing an underscore" do
+    sign_in :jz
+
+    get library_search_path(q: "snake_case")
+
+    assert_response :success
+    assert_result "snake_case_title"
+  end
+
+  test "show finds a title by an underscore alone" do
+    sign_in :jz
+
+    get library_search_path(q: "_")
+
+    assert_response :success
+    assert_result "snake_case_title"
+  end
+
+  test "show does not match titles without an underscore" do
+    sign_in :jz
+
+    get library_search_path(q: "_")
+
+    assert_response :success
+    assert_no_result "Welcome to The Handbook!"
+  end
+
+  test "show matches a backslash in the query literally" do
+    sign_in :jz
+
+    get library_search_path(q: "back\\slash")
+
+    assert_response :success
+    assert_result "back\\slash page"
+  end
+
+  test "show matches a lone backslash only in titles containing one" do
+    sign_in :jz
+
+    get library_search_path(q: "\\")
+
+    assert_response :success
+    assert_result "back\\slash page"
+    assert_no_result "Welcome to The Handbook!"
+  end
+
+  test "show finds a title containing an apostrophe" do
+    books(:handbook).press Page.new(body: "Someone's content"), title: "Tom's page"
+
+    sign_in :jz
+
+    get library_search_path(q: "Tom's")
+
+    assert_response :success
+    assert_result "Tom's page"
+  end
+
+  private
+    def assert_result(title)
+      assert_select "a.search__result", text: /#{Regexp.escape(title)}/
+    end
+
+    def assert_no_result(title)
+      assert_select "a.search__result", text: /#{Regexp.escape(title)}/, count: 0
+    end
+
+    def assert_no_results
+      assert_select "a.search__result", count: 0
+    end
+end
