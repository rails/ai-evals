index 0000000..0d2ad25
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "show reports when the book was last updated" do
+    get book_report_path(books(:handbook))
+
+    assert_response :success
+    assert_in_body "Last updated #{books(:handbook).updated_at.to_date.to_fs(:long)}"
+    assert_in_body books(:handbook).report_summary
+  end
+
+  test "show downloads the card as text" do
+    get book_report_path(books(:handbook), format: :text)
+
+    assert_response :success
+    assert_in_body "Book: #{books(:handbook).title}"
+  end
+
+  test "show names the download after the book's last update" do
+    get book_report_path(books(:handbook), format: :text)
+
+    assert_response :success
+    assert_match /shelf-report-#{books(:handbook).updated_at.to_fs(:number)}\.txt/, response.headers["Content-Disposition"]
+  end
+end
