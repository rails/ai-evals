index 0000000..ea3bb40
--- /dev/null
+++ b/db/migrate/20250115000000_create_tenants.rb
@@ -0,0 +1,34 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  DEFAULT_TENANT_NAME = "Writebook"
+
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    sweep_existing_records_into_one_tenant
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+
+    drop_table :tenants
+  end
+
+  private
+    # Installs that predate tenants upgrade in place: everything already on the
+    # install is swept into a single tenant instead of being left homeless.
+    def sweep_existing_records_into_one_tenant
+      tenant = Tenant.create!(name: DEFAULT_TENANT_NAME)
+
+      say_with_time "Sweeping existing users and books into the #{tenant.name} tenant" do
+        User.unscoped.where(tenant_id: nil).update_all(tenant_id: tenant.id)
+        Book.unscoped.where(tenant_id: nil).update_all(tenant_id: tenant.id)
+      end
+    end
+end
