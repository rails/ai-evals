diff --git a/test/integration/tenant_isolation_test.rb b/test/integration/tenant_isolation_test.rb
new file mode 100644
index 0000000..79ae683
--- /dev/null
+++ b/test/integration/tenant_isolation_test.rb
@@ -0,0 +1,194 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    @book_a = books(:handbook).tap { it.update!(tenant: @tenant_a) }
+    @book_b = books(:manual).tap { it.update!(tenant: @tenant_b) }
+
+    @page_a = leaves(:welcome_page)
+    @page_b = @book_b.press Page.new(body: "Only tenant B should read this"), title: "Tenant B page"
+
+    @david = users(:david).tap { it.update!(tenant: @tenant_a) }
+    @jason = users(:jason).tap { it.update!(tenant: @tenant_b) }
+    @jz = users(:jz).tap { it.update!(tenant: @tenant_a) }
+  end
+
+  test "a tenant's library omits other tenants' books, published or not" do
+    @book_b.update!(published: true)
+
+    sign_in @jz
+    get root_path
+
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual", count: 0
+  end
+
+  test "another tenant's book is not found, published or not" do
+    sign_in @jz
+    get book_slug_path(@book_b)
+    assert_response :not_found
+
+    @book_b.update!(published: true)
+    get book_slug_path(@book_b)
+    assert_response :not_found
+  end
+
+  test "another tenant's book is not found even when the user holds an access row" do
+    assert @book_b.accesses.exists?(user: @jz)
+
+    sign_in @jz
+    get book_slug_path(@book_b)
+
+    assert_response :not_found
+  end
+
+  test "another tenant's book is not found for an administrator either" do
+    assert @book_b.accesses.exists?(user: @david)
+
+    sign_in @david
+    get book_slug_path(@book_b)
+
+    assert_response :not_found
+  end
+
+  test "another tenant's page is not found" do
+    sign_in @jz
+    get leafable_slug_path(@page_b)
+
+    assert_response :not_found
+  end
+
+  test "another tenant's page edit history is not found" do
+    @page_b.edit leafable_params: { body: "Rewritten in tenant B" }
+
+    sign_in @jz
+    get page_edit_path(@page_b, @page_b.edits.last)
+
+    assert_response :not_found
+  end
+
+  test "a 404 from another tenant's book doesn't sign the user out" do
+    sign_in @jz
+
+    get book_slug_path(@book_b)
+    assert_response :not_found
+
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+  end
+
+  test "signed-out visitors see every published book, whatever tenant it belongs to" do
+    @book_a.update!(published: true)
+    @book_b.update!(published: true)
+
+    get root_path
+
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual"
+  end
+
+  test "new books land in their creator's tenant" do
+    sign_in @jz
+
+    assert_difference -> { Book.count }, +1 do
+      post books_path, params: { book: { title: "Another tenant A book", everyone_access: false } }
+    end
+
+    assert_equal @tenant_a, Book.last.tenant
+  end
+
+  test "everything inside a tenant works as before" do
+    users(:kevin).update!(tenant: @tenant_a)
+    @page_a.edit leafable_params: { body: "Rewritten in tenant A" }
+
+    sign_in users(:kevin)
+
+    get root_path
+    assert_select "h2", text: "Handbook"
+
+    get leafable_slug_path(@page_a)
+    assert_response :success
+
+    get page_edit_path(@page_a, @page_a.edits.last)
+    assert_response :success
+    assert_in_body "Rewritten in tenant A"
+  end
+
+  test "sharing with everyone doesn't reach into other tenants" do
+    newcomer = User.create!(name: "Newcomer", email_address: "newcomer@example.com", password: "secret123456", tenant: @tenant_b)
+
+    assert newcomer.accesses.exists?(book: @book_b)
+    assert_not newcomer.accesses.exists?(book: @book_a)
+  end
+
+  test "records without a tenant behave as they did before" do
+    book = Book.create!(title: "Book without a tenant", everyone_access: false)
+    user = User.create!(name: "Untenant", email_address: "untarget@example.com", password: "secret123456")
+
+    assert_nil book.tenant
+    assert_not book.accessable?(user: user)
+
+    book.update_access(editors: [], readers: [ user.id ])
+
+    assert book.accessable?(user: user)
+
+    sign_in user
+
+    get root_path
+    assert_select "h2", text: "Book without a tenant"
+
+    get book_slug_path(book)
+    assert_response :success
+  end
+
+  test "a book without a tenant isn't hidden from a tenant" do
+    book = Book.create!(title: "Book without a tenant", everyone_access: false)
+    book.update_access(editors: [], readers: [ users(:kevin).id ])
+
+    users(:kevin).update!(tenant: @tenant_a)
+
+    assert book.accessable?(user: users(:kevin))
+    assert Book.accessable_or_published(user: users(:kevin)).include?(book)
+  end
+
+test "another tenant's book answers 404 like a book that was never there" do
+  sign_in @jz
+
+  get slugged_book_path(id: @book_b.id, slug: @book_b.slug)
+  assert_response :not_found
+
+  get slugged_book_path(id: Book.maximum(:id) + 1, slug: "ghost")
+  assert_response :not_found
+end
+
+test "another tenant's book can't be changed" do
+  sign_in @david
+
+  patch book_publication_path(@book_b), params: { book: { published: "1" } }
+  assert_response :not_found
+  assert_not @book_b.reload.published?
+
+  patch book_path(@book_b), params: { book: { title: "Hijacked" } }
+  assert_response :not_found
+  assert_equal "Manual", @book_b.reload.title
+
+  delete book_path(@book_b)
+  assert_response :not_found
+end
+
+  test "users page still names everyone on the install" do
+    sign_in @david
+    get users_path
+
+    assert_response :success
+    assert_in_body "Jason"
+    assert_in_body "Kevin"
+    assert_in_body "JZ"
+  end
+end
