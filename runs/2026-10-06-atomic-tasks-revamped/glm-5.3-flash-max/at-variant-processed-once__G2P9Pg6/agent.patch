diff --git a/test/integration/picture_derivation_test.rb b/test/integration/picture_derivation_test.rb
new file mode 100644
index 0000000..56c965f
--- /dev/null
+++ b/test/integration/picture_derivation_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class PictureDerivationTest < ActionDispatch::IntegrationTest
+  setup do
+    pictures(:reading).image.attach io: file_fixture("white-rabbit.webp").open,
+      filename: "white-rabbit.webp", content_type: "image/webp"
+  end
+
+  test "an upload is derived once by the background job and a reader gets that copy" do
+    derive_in_background
+
+    picture = pictures(:reading)
+    derived = picture.large_image.image
+
+    assert_not_nil derived, "expected the background job to have derived the picture"
+    assert_equal 1, ActiveStorage::VariantRecord.count
+    blobs_after_deriving = ActiveStorage::Blob.count
+
+    open_book_page_and_fetch_picture picture do |transforms|
+      assert_empty transforms, "the picture was transformed again for a reader"
+      assert_equal blobs_after_deriving, ActiveStorage::Blob.count, "a second derived copy was kept"
+      assert_equal 1, ActiveStorage::VariantRecord.count
+      assert_equal derived.download, response.body
+    end
+  end
+
+  test "a picture served before the background job ran is not derived twice" do
+    open_book_page_and_fetch_picture pictures(:reading) do |transforms|
+      assert_not_empty transforms, "expected the first reader to derive the picture"
+    end
+
+    derive_in_background
+
+    assert_equal 1, ActiveStorage::VariantRecord.count
+    assert_equal 2, ActiveStorage::Blob.count
+  end
+
+  private
+    # Runs the work an upload enqueued, including anything it queues itself.
+    def derive_in_background
+      10.times do
+        break if enqueued_jobs.empty?
+        perform_enqueued_jobs
+      end
+    end
+
+    # Reads the picture page as a reader does and fetches the derived picture it links to.
+    # Yields the list of transformations that were applied while doing so.
+    def open_book_page_and_fetch_picture(picture)
+      sign_out
+      books(:handbook).update! published: true
+
+      transforms = []
+      subscriber = ActiveSupport::Notifications.subscribe(/^transform\.active_storage$/) { transforms << 1 }
+
+      get leafable_slug_path(picture.leaf)
+      assert_response :success
+
+      assert_select "figure img" do |images|
+        get images.first["src"].delete_prefix("http://www.example.com")
+        assert_response :redirect
+        follow_redirect!
+        assert_response :success
+      end
+
+      yield transforms
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+    end
+end
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..3d55fb4 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -23,4 +23,14 @@ class PictureTest < ActiveSupport::TestCase
 
     assert_equal picture.image, picture.large_image
   end
+
+  test "the variant a reader requests is the one the background job derives" do
+    large_image = pictures(:reading).large_image
+
+    # A reader's transformations arrive in a URL, where they only survive as strings, while the
+    # background job transforms the record directly. They have to hash to the same variant.
+    reader = ActiveStorage::Variation.decode large_image.variation.key
+
+    assert_equal large_image.variation.digest, reader.digest
+  end
 end
