diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..8035b2d
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  setup do
+    Leaf.reindex_all
+  end
+
+  test "erasing a user leaves nothing of theirs behind" do
+    user = User.create!(name: "Erase Me", email_address: "erase-me@example.com", password: "secret123456")
+    user.sessions.start!(user_agent: "Test Agent", ip_address: "127.0.0.1")
+    user.reading_marks.create!(leaf: leaves(:welcome_page), last_read_at: Time.now)
+    SignInEvent.create!(email_address: user.email_address, action: :signed_in, ip_address: "127.0.0.1")
+
+    assert_difference -> { User.count }, -1 do
+      user.erase
+    end
+
+    assert_nil User.find_by(id: user.id)
+    assert_empty Session.where(user_id: user.id)
+    assert_empty Access.where(user_id: user.id)
+    assert_empty ReadingMark.where(user_id: user.id)
+    assert_empty SignInEvent.where(email_address: user.email_address)
+  end
+
+  test "erasing keeps the books they created that are shared with everyone" do
+    book = Book.create!(title: "Everyone book", author: "Kevin", everyone_access: true, creator: users(:kevin))
+
+    users(:kevin).erase
+
+    assert Book.exists?(book.id)
+    assert_nil book.reload.creator_id
+    assert_equal "Deleted author", book.reload.author
+  end
+
+  test "erasing removes the books they created that are not shared with everyone" do
+    book = Book.create!(title: "Secret book", everyone_access: false, creator: users(:kevin))
+    book.press(Page.new(body: "Kevin's private notes about wombats"), title: "Kevin's private page")
+    Leaf.reindex_all
+
+    assert Leaf.search("wombats").exists?, "the page is searchable before erasure"
+
+    users(:kevin).erase
+
+    assert_not Book.exists?(book.id)
+    assert_empty Leaf.where(book_id: book.id)
+    assert_not Leaf.search("wombats").exists?, "no stale search hits"
+  end
+
+  test "erasing a user that was deactivated the old way removes their sign in events" do
+    user = users(:kevin)
+    SignInEvent.create!(email_address: "kevin@example.com", action: :signed_in, ip_address: "127.0.0.1")
+
+    user.deactivate
+    deactivated_email_address = user.reload.email_address
+    assert_match(/kevin-deactivated-.+@example\.com/, deactivated_email_address)
+
+    user.erase
+
+    assert_nil User.find_by(id: user.id)
+    assert_empty SignInEvent.for_address("kevin@example.com")
+    assert_empty SignInEvent.for_address(deactivated_email_address)
+  end
+
+  test "erasing removes every kind of leaf in the books they kept private" do
+    user = users(:kevin)
+    book = Book.create!(title: "Kevins private book", everyone_access: false, creator: user)
+    page_leaf = book.press(Page.new(body: "wombats in a page"), title: "Wombat page")
+    section_leaf = book.press(Section.new(body: "wombats in a section"), title: "Wombat section")
+    picture_leaf = book.press(Picture.new(caption: "wombats in a picture"), title: "Wombat picture")
+    picture_leaf.leafable.image.attach io: File.open("test/fixtures/files/white-rabbit.webp"),
+      filename: "white-rabbit.webp"
+    page_leaf.trashed!
+
+    Leaf.reindex_all
+    assert_equal [ page_leaf.id, section_leaf.id ].sort, Leaf.search("wombats").map(&:id).sort
+
+    user.erase
+
+    assert_not Book.exists?(book.id)
+    assert_empty Leaf.where(book_id: book.id)
+    assert_empty Page.where(id: page_leaf.leafable_id)
+    assert_empty Section.where(id: section_leaf.leafable_id)
+    assert_empty Picture.where(id: picture_leaf.leafable_id)
+    assert_empty Leaf.search("wombats"), "no stale search hits left behind"
+  end
+
+  test "erasing keeps the shared books they created searchable" do
+    book = Book.create!(title: "Kevins shared book", everyone_access: true, creator: users(:kevin))
+    book.press(Page.new(body: "public wombats for everyone"), title: "Wombat page")
+    Leaf.reindex_all
+
+    users(:kevin).erase
+
+    assert Book.exists?(book.id)
+    assert_equal "Deleted author", book.reload.author
+    assert_not_empty book.leaves.reload
+    assert_not_empty Leaf.search("wombats")
+  end
+
+  test "erasing does not touch other peoples books" do
+    book = Book.create!(title: "Davids book", everyone_access: false, creator: users(:david))
+
+    users(:kevin).erase
+
+    assert_equal users(:david).id, book.reload.creator_id
+  end
+
+  test "erasing someone deactivated more than once still finds their original address" do
+    user = users(:kevin)
+    user.update! active: false,
+      email_address: "kevin-deactivated-11111111-1111-1111-1111-111111111111-deactivated-22222222-2222-2222-2222-222222222222@example.com"
+
+    assert_includes user.email_addresses_signed_in_with, "kevin@example.com"
+  end
+end
