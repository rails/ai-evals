diff --git a/app/models/leaf/searchable.rb b/app/models/leaf/searchable.rb
index d90c5c9..226d624 100644
--- a/app/models/leaf/searchable.rb
+++ b/app/models/leaf/searchable.rb
@@ -37,6 +37,17 @@ module Leaf::Searchable
       joins("join leaf_search_index on leaves.id = leaf_search_index.rowid")
         .where("leaf_search_index match ?", terms)
     end
+
+    # Removes leaves from the search index right away, instead of waiting for the
+    # after_destroy_commit callback. Anything that destroys leaves in bulk, or
+    # inside a transaction that has to leave a clean index behind when it runs,
+    # needs the rows gone immediately.
+    def remove_from_search_index(leaves)
+      ids = Array(leaves).collect { it.is_a?(Leaf) ? it.id : it }.compact
+      return if ids.empty?
+
+      connection.execute sanitize_sql([ "delete from leaf_search_index where rowid in (?)", ids ])
+    end
   end
 
   def reindex
diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..592d583 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -1,6 +1,17 @@
 class User < ApplicationRecord
   include Authoring, Role, Transferable
 
+  # The byline left on the books an erased person created and that are shared
+  # with everyone. Their name is taken off, but people are still reading them.
+  DELETED_AUTHOR_BYLINE = "Deleted author"
+
+  # What `deactivate` used to rewrite someone's email address into. It could
+  # happen more than once to someone that was deactivated over and over.
+  DEACTIVATED_EMAIL_ADDRESS_PATTERN = /
+    (?: -deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12} )+
+    @
+  /ix
+
   has_many :sessions, dependent: :destroy
   has_secure_password validations: false
 
@@ -11,24 +22,81 @@ class User < ApplicationRecord
   after_create :grant_access_to_everyone_books
 
   scope :active, -> { where(active: true) }
+  scope :removed, -> { where(active: false) }
   scope :ordered, -> { order(:name) }
 
   def current?
     self == Current.user
   end
 
+  # How someone used to be taken off the account: their sign in was disabled and
+  # their email address was made unusable, but everything else about them stayed.
+  # Accounts that went out this way still have to be erasable.
   def deactivate
     transaction do
       sessions.delete_all
-      update! active: false, email_address: deactived_email_address
+      update! active: false, email_address: deactivated_email_address
+    end
+  end
+
+  # Permanently erases someone, as asked for by a GDPR erasure request: no row of
+  # theirs is left anywhere, and none of their content either. The one exception
+  # is the books they created that are shared with everyone, which keep working
+  # for the people still reading them, bylined "Deleted author".
+  def erase
+    transaction do
+      hand_over_books_shared_with_everyone
+      destroy_books_kept_private
+
+      # Bulk deletes: no callbacks run, so nothing gets nullified and no sign out
+      # events get recorded on the way out.
+      Session.where(user: self).delete_all
+      Access.where(user: self).delete_all
+      ReadingMark.where(user: self).delete_all
+      forget_sign_in_events
+
+      created_books.reset
+      destroy!
     end
   end
 
+  # Every address this person signed in with. Someone that was deactivated the old
+  # way signed in with their original address, which since got rewritten.
+  def email_addresses_signed_in_with
+    [ email_address, email_address_before_deactivation ].compact.uniq
+  end
+
   private
-    def deactived_email_address
+    def deactivated_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
 
+    def email_address_before_deactivation
+      if email_address&.match?(DEACTIVATED_EMAIL_ADDRESS_PATTERN)
+        email_address.gsub(DEACTIVATED_EMAIL_ADDRESS_PATTERN, "@")
+      end
+    end
+
+    def hand_over_books_shared_with_everyone
+      # `update_all` because assigning a nil creator through the association would
+      # fall back to its default and point the book at whoever is signed in.
+      created_books.with_everyone_access.update_all \
+        author: DELETED_AUTHOR_BYLINE, creator_id: nil, updated_at: Time.now
+    end
+
+    def destroy_books_kept_private
+      private_books = created_books.excluding(created_books.with_everyone_access)
+
+      Leaf.remove_from_search_index Leaf.where(book_id: private_books.ids).ids
+      private_books.find_each(&:destroy!)
+    end
+
+    # Sign in events are only tied to their account through the address they
+    # signed in with, so there is nothing else to look them up by.
+    def forget_sign_in_events
+      SignInEvent.where(email_address: email_addresses_signed_in_with).delete_all
+    end
+
     def grant_access_to_everyone_books
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
