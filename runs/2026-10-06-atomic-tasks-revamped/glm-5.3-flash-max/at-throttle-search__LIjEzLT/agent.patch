+++ b/test/controllers/books/searches_controller_test.rb
@@ -1,7 +1,12 @@
 require "test_helper"
 
 class Books::SearchesControllerTest < ActionDispatch::IntegrationTest
+  HAMMERING_ADDRESS = "203.0.113.10"
+  READER_ADDRESS = "203.0.113.11"
+
   setup do
+    Rails.cache.clear
+
     sign_in :kevin
 
     Leaf.reindex_all
@@ -241,4 +246,56 @@ class Books::SearchesControllerTest < ActionDispatch::IntegrationTest
       end
     end
   end
+
+  test "create refuses more than thirty searches in a minute from one address" do
+    books(:handbook).update! published: true
+
+    30.times do
+      search_from HAMMERING_ADDRESS
+      assert_response :success
+    end
+
+    search_from HAMMERING_ADDRESS
+    assert_response :too_many_requests
+  end
+
+  test "create keeps serving searches from other addresses while one is refused" do
+    books(:handbook).update! published: true
+
+    31.times { search_from HAMMERING_ADDRESS }
+    assert_response :too_many_requests
+
+    sign_out
+
+    search_from READER_ADDRESS
+    assert_response :success
+    assert_select "a", text: /Thanks for reading/i
+  end
+
+  test "create serves an address again after it stops hammering" do
+    books(:handbook).update! published: true
+
+    31.times { search_from HAMMERING_ADDRESS }
+    assert_response :too_many_requests
+
+    travel 2.minutes do
+      search_from HAMMERING_ADDRESS
+      assert_response :success
+    end
+  end
+
+  test "create keeps serving the book itself while one address is refused" do
+    books(:handbook).update! published: true
+
+    31.times { search_from HAMMERING_ADDRESS }
+    assert_response :too_many_requests
+
+    get book_slug_path(books(:handbook)), headers: { "REMOTE_ADDR" => HAMMERING_ADDRESS }
+    assert_response :success
+  end
+
+  private
+    def search_from(address)
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { "REMOTE_ADDR" => address }
+    end
 end
