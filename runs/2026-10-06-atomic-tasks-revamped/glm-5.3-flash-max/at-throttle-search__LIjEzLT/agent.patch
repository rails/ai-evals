 class Books::SearchesController < ApplicationController
   allow_unauthenticated_access
 
+  include RateLimited
   include BookScoped
 
+  # Search is open to everyone, which makes it an easy target for scripted
+  # crawling of every published book. Refuse bursts of queries from one address.
+  limit_requests_per_address to: 30, within: 1.minute, only: :create
+
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
diff --git a/app/controllers/concerns/rate_limited.rb b/app/controllers/concerns/rate_limited.rb
new file mode 100644
index 0000000..9fd1136
--- /dev/null
+++ b/app/controllers/concerns/rate_limited.rb
@@ -0,0 +1,36 @@
+# Refuses requests that exceed a budget of requests from a single address
+# within a window of time.
+#
+# Counts are kept in the cache store, so the budget holds no matter how many app
+# servers are serving requests. Counts expire on their own, so an address is
+# served again as soon as it stops hammering us. Nothing to unblock.
+module RateLimited
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def limit_requests_per_address(to:, within:, **options)
+      prepend_before_action(**options) do
+        count = rate_limit_store.increment(rate_limit_key, 1, expires_in: within)
+
+        if count && count > to
+          logger.info { "Refused #{rate_limit_key}, #{count} requests within #{within.inspect}" }
+          raise ActionController::TooManyRequests
+        end
+      end
+    end
+  end
+
+  private
+    def rate_limit_key
+      [ "rate-limit", controller_path, request.remote_ip ].join(":")
+    end
+
+    # Counts belong in the shared cache store. Fall back to a store local to this
+    # process when the app runs without one (caching turned off in development)
+    # rather than letting the budget lapse.
+    def rate_limit_store
+      Rails.cache.is_a?(ActiveSupport::Cache::NullStore) ? FALLBACK_STORE : Rails.cache
+    end
+
+    FALLBACK_STORE = ActiveSupport::Cache::MemoryStore.new
+end
