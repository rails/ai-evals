@@ -1,9 +1,23 @@
 class Books::SearchesController < ApplicationController
   allow_unauthenticated_access
 
+  # Anyone can search a published book, so nothing stops an address from running
+  # searches as fast as it can. Count them per address and refuse the rest, before
+  # any book is loaded or searched on the address's behalf.
+  before_action :refuse_excessive_searching, only: :create
+
   include BookScoped
 
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    def refuse_excessive_searching
+      if (wait = RateLimiter.record(request.remote_ip))
+        response.set_header "Retry-After", wait.to_s
+        logger.warn "Refused search from #{request.remote_ip}, over the rate limit"
+        head :too_many_requests
+      end
+    end
 end
diff --git a/app/models/rate_limiter.rb b/app/models/rate_limiter.rb
new file mode 100644
index 0000000..31d7581
--- /dev/null
+++ b/app/models/rate_limiter.rb
@@ -0,0 +1,51 @@
+# Keeps count of the requests an address has made recently.
+#
+# Counts are held in memory, one window per process: they cost nothing to
+# record, need no schema, and they lapse by themselves. An address that stops
+# hammering is served again as soon as its window drains, so nothing ever has
+class RateLimiter
+  # Requests an address may make within the window before the rest are refused.
+  LIMIT = 30
+
+  # How far back requests are counted. An address is refused while more than
+  # LIMIT of its requests fall inside this window, and served again once they don't.
+  WINDOW = 1.minute
+
+  # How many addresses to keep track of before dropping drained windows.
+  MAX_ADDRESSES = 1_000
+
+  # Requests are served concurrently, so the windows are guarded while they change.
+  GUARD = Mutex.new
+
+  private_constant :GUARD
+
+  class << self
+    # Records a request made by +address+ and returns how long the address has to
+    # wait before it may make another one, or nil when it may proceed right away.
+    def record(address, limit: LIMIT, window: WINDOW)
+      now = Time.current.to_i
+
+      GUARD.synchronize do
+        requests = windows[address.to_s] ||= []
+        requests.reject! { |at| at <= now - window }
+        requests << now
+        forget_drained_windows(now - window) if windows.size > MAX_ADDRESSES
+
+        next nil if requests.size <= limit
+
+        requests.first + window - now
+      end
+    end
+
+    private
+      # A window per address, holding the seconds its recent requests were made in.
+      def windows
+        @windows ||= {}
+      end
+
+      # A window is drained once its newest request has left it.
+      def forget_drained_windows(cutoff)
+        windows.delete_if { |_address, requests| requests.last.to_i <= cutoff }
+      end
+  end
+end
diff --git a/test/integration/search_rate_limit_test.rb b/test/integration/search_rate_limit_test.rb
new file mode 100644
index 0000000..ccdfcb8
--- /dev/null
+++ b/test/integration/search_rate_limit_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class SearchRateLimitTest < ActionDispatch::IntegrationTest
+  LIMIT = RateLimiter::LIMIT
+
+  setup do
+    sign_out
+
+    books(:handbook).update! published: true
+    Leaf.reindex_all
+  end
+
+  test "searching within the limit is served without signing in" do
+    LIMIT.times do
+      search as: "203.0.113.1"
+
+      assert_response :success
+      assert_select "a", text: /Thanks for reading/i
+    end
+  end
+
+  test "searching past the limit is refused with too many requests" do
+    LIMIT.times { search as: "203.0.113.2" }
+
+    search as: "203.0.113.2"
+
+    assert_response :too_many_requests
+    assert_empty response.body
+  end
+
+  test "other addresses are still served while one is refused" do
+    refuse_all_searches_from "203.0.113.3"
+
+    search as: "198.51.100.3"
+
+    assert_response :success
+    assert_select "a", text: /Thanks for reading/i
+  end
+
+  test "a refused address can still read the book" do
+    refuse_all_searches_from "203.0.113.4"
+
+    get book_slug_path(books(:handbook))
+
+    assert_response :success
+    assert_in_body "Thanks for reading"
+  end
+
+  test "an address is served again once its burst has passed" do
+    refuse_all_searches_from "203.0.113.5"
+
+    travel RateLimiter::WINDOW do
+      search as: "203.0.113.5"
+
+      assert_response :success
+      assert_select "a", text: /Thanks for reading/i
+    end
+  end
+
+  private
+    def search(as:)
+      post book_search_url(books(:handbook)), params: { search: "Thanks" }, headers: { REMOTE_ADDR: as }
+    end
+
+    def refuse_all_searches_from(address)
+      LIMIT.times { search as: address }
+      search as: address
+
+      assert_response :too_many_requests
+    end
+end
diff --git a/test/models/rate_limiter_test.rb b/test/models/rate_limiter_test.rb
new file mode 100644
index 0000000..8751045
--- /dev/null
+++ b/test/models/rate_limiter_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class RateLimiterTest < ActiveSupport::TestCase
+  test "serves requests while an address is within the limit" do
+    (RateLimiter::LIMIT - 1).times do
+      assert_nil RateLimiter.record("192.0.2.1")
+    end
+  end
+
+  test "reports how long an address has to wait once it is over the limit" do
+    RateLimiter::LIMIT.times { RateLimiter.record("192.0.2.2") }
+
+    assert_operator RateLimiter.record("192.0.2.2"), :<=, RateLimiter::WINDOW
+    assert_operator RateLimiter.record("192.0.2.2"), :>, 0
+  end
+
+  test "keeps count of addresses apart" do
+    RateLimiter::LIMIT.times { RateLimiter.record("192.0.2.3") }
+
+    assert_nil RateLimiter.record("192.0.2.4")
+  end
+
+  test "counts requests made within the window" do
+    RateLimiter::LIMIT.times { RateLimiter.record("192.0.2.5") }
+
+    travel RateLimiter::WINDOW / 2 do
+      assert_predicate RateLimiter.record("192.0.2.5"), :positive?
+    end
+  end
+
+  test "serves an address again once its requests have left the window" do
+    RateLimiter::LIMIT.times { RateLimiter.record("192.0.2.6") }
+    assert_predicate RateLimiter.record("192.0.2.6"), :positive?
+
+    travel RateLimiter::WINDOW do
+      assert_nil RateLimiter.record("192.0.2.6")
+    end
+  end
+
+  test "forgets addresses once their windows have drained" do
+    RateLimiter::LIMIT.times { RateLimiter.record("192.0.2.7") }
+    assert RateLimiter.send(:windows).key?("192.0.2.7")
+
+    travel RateLimiter::WINDOW do
+      stub_const RateLimiter, :MAX_ADDRESSES, 1 do
+        RateLimiter.record("192.0.2.8")
+      end
+    end
+
+    assert_not RateLimiter.send(:windows).key?("192.0.2.7")
+  end
+end
