diff --git a/lib/rate_limiter.rb b/lib/rate_limiter.rb
new file mode 100644
index 0000000..f105b2e
--- /dev/null
+++ b/lib/rate_limiter.rb
@@ -0,0 +1,43 @@
+# Counts the requests made by an identity and tells when it has had enough.
+#
+# The count is kept in the cache store, so it is shared by every process serving
+# requests. It also expires by itself: an identity that has exhausted its limit
+# is served again as soon as the count runs out, so there is nothing to unblock.
+class RateLimiter
+  class << self
+    # Counting needs a store that can hold counters. The null store used when
+    # caching is disabled can't, so fall back to a local memory store.
+    def store
+      if Rails.cache.is_a?(ActiveSupport::Cache::NullStore)
+        @memory_store ||= ActiveSupport::Cache::MemoryStore.new(size: 32.megabytes)
+      else
+        Rails.cache
+      end
+    end
+
+    def reset
+      store.clear
+    end
+  end
+
+  attr_reader :identity, :scope, :limit, :within
+
+  def initialize(identity:, scope:, limit:, within:, store: RateLimiter.store)
+    @identity = identity
+    @scope = scope
+    @limit = limit
+    @within = within
+    @store = store
+  end
+
+  # Records the request and reports whether it may go through.
+  def allow?
+    count = @store.increment(count_key, 1, expires_in: within)
+    count.nil? || count <= limit
+  end
+
+  private
+    def count_key
+      [ "rate-limit", scope, identity ].join(":")
+    end
+end
diff --git a/test/integration/book_search_rate_limit_test.rb b/test/integration/book_search_rate_limit_test.rb
new file mode 100644
index 0000000..ed4ebfd
--- /dev/null
+++ b/test/integration/book_search_rate_limit_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class BookSearchRateLimitTest < ActionDispatch::IntegrationTest
+  setup do
+    books(:handbook).update!(published: true)
+    Leaf.reindex_all
+  end
+
+  test "serves the first thirty searches from an address, then refuses the rest" do
+    30.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { REMOTE_ADDR: "203.0.113.10" }
+      assert_response :success
+    end
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { REMOTE_ADDR: "203.0.113.10" }
+
+    assert_response :too_many_requests
+    assert_not_in_body "for reading!"
+  end
+
+  test "keeps serving other addresses while one is refused" do
+    refuse "203.0.113.11"
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { REMOTE_ADDR: "203.0.113.12" }
+
+    assert_response :success
+    assert_in_body "for reading!"
+  end
+
+  test "keeps serving the book's pages to a refused address" do
+    refuse "203.0.113.13"
+
+    get book_slug_path(books(:handbook)), headers: { REMOTE_ADDR: "203.0.113.13" }
+
+    assert_response :success
+    assert_in_body "Handbook"
+  end
+
+  test "serves an address again once its burst has spent itself" do
+    refuse "203.0.113.14"
+
+    travel 30.seconds do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { REMOTE_ADDR: "203.0.113.14" }
+      assert_response :too_many_requests
+    end
+
+    travel 5.minutes do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { REMOTE_ADDR: "203.0.113.14" }
+      assert_response :success
+      assert_in_body "for reading!"
+    end
+  end
+
+  private
+    def refuse(address)
+      31.times do
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }, headers: { REMOTE_ADDR: address }
+      end
+
+      assert_response :too_many_requests
+    end
+end
diff --git a/test/lib/rate_limiter_test.rb b/test/lib/rate_limiter_test.rb
new file mode 100644
index 0000000..bce0208
--- /dev/null
+++ b/test/lib/rate_limiter_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class RateLimiterTest < ActiveSupport::TestCase
+  setup do
+    RateLimiter.reset
+
+    @limiter = RateLimiter.new(identity: "203.0.113.20", scope: "books/searches", limit: 2, within: 1.minute)
+  end
+
+  test "serves requests up to the limit, then refuses" do
+    assert @limiter.allow?
+    assert @limiter.allow?
+    assert_not @limiter.allow?
+  end
+
+  test "counts identities apart" do
+    assert @limiter.allow?
+    assert @limiter.allow?
+
+    other = RateLimiter.new(identity: "203.0.113.21", scope: "books/searches", limit: 2, within: 1.minute)
+    assert other.allow?
+  end
+
+  test "counts scopes apart" do
+    assert @limiter.allow?
+    assert @limiter.allow?
+
+    elsewhere = RateLimiter.new(identity: "203.0.113.20", scope: "books/pages", limit: 2, within: 1.minute)
+    assert elsewhere.allow?
+  end
+
+  test "lets the count expire by itself" do
+    assert @limiter.allow?
+    assert @limiter.allow?
+    assert_not @limiter.allow?
+
+    travel 2.minutes do
+      assert @limiter.allow?
+    end
+  end
+
+  test "serves requests when the store can't count" do
+    limiter = RateLimiter.new(
+      identity: "203.0.113.20",
+      scope: "books/searches",
+      limit: 2,
+      within: 1.minute,
+      store: ActiveSupport::Cache::NullStore.new
+    )
+
+    assert limiter.allow?
+    assert limiter.allow?
+    assert limiter.allow?
+  end
+end
