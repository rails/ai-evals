diff --git a/app/controllers/concerns/rate_limited.rb b/app/controllers/concerns/rate_limited.rb
new file mode 100644
index 0000000..e98b245
--- /dev/null
+++ b/app/controllers/concerns/rate_limited.rb
@@ -0,0 +1,29 @@
+# Refuses requests from an address that sends too many in a short stretch.
+#
+# Refusals are keyed by the address a request came from, so only that address is
+# refused: everyone else is served as usual.
+module RateLimited
+  extend ActiveSupport::Concern
+
+  class_methods do
+    # Refuses an address once it has made +to:+ requests within +within:+.
+    def rate_limit_by_address(to:, within:, **options)
+      before_action -> { refuse_address_that_sent_too_many(to: to, within: within) }, **options
+    end
+  end
+
+  private
+    def refuse_address_that_sent_too_many(to:, within:)
+      limiter = RateLimiter.new(identity: request.remote_ip, scope: rate_limit_scope, limit: to, within: within)
+
+      render_too_many_requests unless limiter.allow?
+    end
+
+    def rate_limit_scope
+      controller_path
+    end
+
+    def render_too_many_requests
+      render html: "Too many requests", status: :too_many_requests
+    end
+end
