diff --git a/test/integration/table_of_contents_caching_test.rb b/test/integration/table_of_contents_caching_test.rb
new file mode 100644
index 0000000..88338b2
--- /dev/null
+++ b/test/integration/table_of_contents_caching_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class TableOfContentsCachingTest < ActionDispatch::IntegrationTest
+  EDIT_CONTROLS = %r{href="/books/\d+/(?:pages|sections|pictures)/\d+/edit}
+
+  setup do
+    @cache = ActiveSupport::Cache::MemoryStore.new
+    @perform_caching_was, ActionController::Base.perform_caching = ActionController::Base.perform_caching, true
+    @cache_store_was, ActionController::Base.cache_store = ActionController::Base.cache_store, @cache
+    @collection_cache_was, ActionView::PartialRenderer.collection_cache =
+      ActionView::PartialRenderer.collection_cache, @cache
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = @perform_caching_was
+    ActionController::Base.cache_store = @cache_store_was
+    ActionView::PartialRenderer.collection_cache = @collection_cache_was
+    @cache.clear
+  end
+
+  test "a reader is never shown an editor's table of contents" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_not_empty edit_controls
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_not_in_body "Edit Welcome to The Handbook!"
+    assert_empty edit_controls
+  end
+
+  test "an editor always sees their controls, whoever opened the book before them" do
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_empty edit_controls
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_in_body "Edit Welcome to The Handbook!"
+    assert_not_empty edit_controls
+  end
+
+  test "an anonymous reader is never shown an editor's table of contents" do
+    books(:handbook).update! published: true
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_not_empty edit_controls
+
+    sign_out
+    get book_slug_path(books(:handbook))
+    assert_empty edit_controls
+  end
+
+  test "an entry that was renamed shows its new title to the next person in" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    leaves(:welcome_page).update! title: "A Fresh Start"
+
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_in_body "A Fresh Start"
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_empty edit_controls
+  end
+
+  test "entries are not looked up one by one to build their cache key" do
+    sign_in :kevin
+    accesses = queries_matching(/FROM "accesses"/) { get book_slug_path(books(:handbook)) }
+
+    assert_operator accesses, :<=, books(:handbook).leaves.active.count
+  end
+
+  private
+    def edit_controls
+      response.body.scan(EDIT_CONTROLS)
+    end
+
+    def queries_matching(pattern)
+      matched = 0
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |event|
+        matched += 1 if event.payload[:sql]&.match?(pattern)
+      end
+
+      yield
+      matched
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+end
