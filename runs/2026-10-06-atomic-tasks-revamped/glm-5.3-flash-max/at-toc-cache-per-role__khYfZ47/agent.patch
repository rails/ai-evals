@@ -43,5 +43,14 @@ module Book::Accessable
 
     accesses.upsert_all(all_accesses, unique_by: [ :book_id, :user_id ])
     accesses.where.not(user_id: all).delete_all
+    @accesses_by_user = nil
   end
+
+  private
+    # Looked up once per book, so that asking repeatedly for the access of the same
+    # book -- for every entry of a table of contents, say -- doesn't turn into a
+    # query per ask.
+    def accesses_by_user
+      @accesses_by_user ||= accesses.index_by(&:user_id)
+    end
 end
