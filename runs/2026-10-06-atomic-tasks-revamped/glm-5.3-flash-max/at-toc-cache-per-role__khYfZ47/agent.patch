--- a/app/helpers/leaves_helper.rb
+++ b/app/helpers/leaves_helper.rb
@@ -1,4 +1,12 @@
 module LeavesHelper
+  # What a table of contents entry shows depends on the leaf itself, on the book it
+  # belongs to and on whether the current user may edit that book. All three therefore
+  # belong in its cache key. It's used for caching a single entry as well as for the
+  # collection that entries are rendered in, so both always agree on what's cached.
+  def leaf_cache_key(leaf)
+    [ leaf, leaf.book, leaf.book.editable? ]
+  end
+
   def leaf_item_tag(leaf, **, &)
     tag.li class: "arrangement__item toc__leaf toc__leaf--#{leaf.leafable_name}",
       id: dom_id(leaf),
