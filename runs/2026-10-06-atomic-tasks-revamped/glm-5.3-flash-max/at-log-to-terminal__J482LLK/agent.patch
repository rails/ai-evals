diff --git a/script/library_report.rb b/script/library_report.rb
index 76294dc..8a3666b 100644
--- a/script/library_report.rb
+++ b/script/library_report.rb
@@ -1,3 +1,21 @@
+# `bin/rails runner` wires `Rails.logger` up to the environment's log file only
+# (log/development.log, log/production.log, ...), which means report lines
+# written with `Rails.logger` never reach the terminal. Broadcast the logger to
+# the terminal as well so the report is readable while it runs. The log file
+# keeps receiving every line, so log tooling is unaffected.
+unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout)
+  console = ActiveSupport::Logger.new($stdout)
+  console.formatter = Rails.logger.formatter
+  # Debug noise (e.g. query logs) belongs in the log file, not on the terminal.
+  console.level = [ Rails.logger.level, ActiveSupport::Logger::INFO ].max
+
+  if Rails.logger.respond_to?(:broadcast_to)
+    Rails.logger.broadcast_to(console)
+  else
+    Rails.logger = ActiveSupport::BroadcastLogger.new(Rails.logger, console)
+  end
+end
+
 books = Book.order(:id).to_a
 
 Rails.logger.info "Library report: #{books.size} books"
