+
   test "html preview" do
     page = Page.new(body: "# Hello\n\nWorld!")
 
@@ -26,4 +28,43 @@ class PageTest < ActiveSupport::TestCase
     assert_includes page.searchable_content, "5 &lt; 10 &amp; 10 &gt; 5"
     assert page.searchable_content.html_safe?
   end
+
+  test "destroying a page purges its uploaded images" do
+    leaf = leaves(:welcome_page)
+    markdown = leaf.leafable.body
+    markdown.uploads.attach upload
+    attachment = markdown.uploads.attachments.last
+    blob = attachment.blob
+
+    assert blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs do
+      leaf.destroy
+    end
+
+    assert_not ActionText::Markdown.exists?(markdown.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+
+  test "destroying a page keeps an image that is still attached elsewhere" do
+    leaf = leaves(:welcome_page)
+    blob = upload
+    leaf.leafable.body.uploads.attach blob
+    pages(:summary).body.uploads.attach blob
+
+    perform_enqueued_jobs do
+      leaf.destroy
+    end
+
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert blob.service.exist?(blob.key)
+  end
+
+  private
+    def upload
+      ActiveStorage::Blob.create_and_upload! io: Rails.root.join("test/fixtures/files/reading.webp").open,
+        filename: "reading.webp", content_type: "image/webp"
+    end
 end
