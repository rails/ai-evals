diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..badfd15 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -1,6 +1,11 @@
 class User < ApplicationRecord
   include Authoring, Role, Transferable
 
+  # `deactivate` used to rewrite the email address to `alice-deactivated-<uuid>@...`
+  # before removal meant erasure. People removed that way still owe us an erasure,
+  # so we recognize the pattern to recover the address they actually signed in with.
+  DEACTIVATED_EMAIL_ADDRESS = /-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@/
+
   has_many :sessions, dependent: :destroy
   has_secure_password validations: false
 
@@ -24,11 +29,52 @@ class User < ApplicationRecord
     end
   end
 
+  # Permanently erases the person: nothing of theirs is left anywhere, except for
+  # the books they created that are shared with everyone, which people are reading.
+  def erase
+    transaction do
+      erase_unshared_books_they_created
+      anonymize_books_they_created
+      accesses.delete_all
+      reading_marks.delete_all
+      sessions.delete_all
+      erase_sign_in_events
+      destroy!
+    end
+
+    Leaf.remove_stale_search_index_entries
+  end
+
   private
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
 
+    # The address the person actually signed in with. People removed the old way
+    # had theirs rewritten, but their sign in events were recorded under the original.
+    def original_email_address
+      email_address.to_s.sub(DEACTIVATED_EMAIL_ADDRESS, "@")
+    end
+
+    def signed_in_email_addresses
+      [ email_address, original_email_address ].uniq
+    end
+
+    def erase_sign_in_events
+      SignInEvent.for_address(signed_in_email_addresses).delete_all
+    end
+
+    def erase_unshared_books_they_created
+      created_books.where.not(everyone_access: true).destroy_all
+    end
+
+    # Books they created that are shared with everyone keep working, so their name
+    # comes off and the byline reads "Deleted author".
+    def anonymize_books_they_created
+      created_books.with_everyone_access.update_all \
+        author: Book::DELETED_AUTHOR, creator_id: nil, updated_at: Time.current
+    end
+
     def grant_access_to_everyone_books
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
