diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..9bd4440 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,62 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "erase removes the person, their data and their unshared books" do
+    user = users(:kevin)
+    book = Book.create!(title: "Kevin's notebook", author: "Kevin", everyone_access: false, creator: user)
+    leaf = book.press Page.new(body: "kerfuffle and wobble"), title: "Kerfuffle"
+    user.reading_marks.create!(leaf: leaves(:welcome_page), last_read_at: Time.now)
+    user.sessions.create!(user_agent: "agent", ip_address: "127.0.0.1")
+
+    user.erase
+
+    assert_not User.exists?(user.id)
+    assert_not Book.exists?(book.id)
+    assert_not Leaf.exists?(leaf.id)
+    assert_empty Session.where(user_id: user.id)
+    assert_empty Access.where(user_id: user.id)
+    assert_empty ReadingMark.where(user_id: user.id)
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "erase leaves no stale search hits behind" do
+    user = users(:kevin)
+    book = Book.create!(title: "Kevin's notebook", everyone_access: false, creator: user)
+    book.press Page.new(body: "kerfuffle and wobble"), title: "Kerfuffle"
+
+    user.erase
+
+    assert_empty Leaf.search("kerfuffle").to_a
+  end
+
+  test "erase keeps books they created that are shared with everyone, but takes their name off" do
+    user = users(:kevin)
+    book = Book.create!(title: "The Shared Book", author: user.name, everyone_access: true, creator: user)
+    leaf = book.press Page.new(body: "read by everyone"), title: "Everyone Reads This"
+
+    user.erase
+
+    assert Book.exists?(book.id)
+    assert Leaf.exists?(leaf.id)
+    assert_nil book.reload.creator
+    assert_equal Book::DELETED_AUTHOR, book.reload.author
+    assert_not_equal user.name, book.reload.author
+  end
+
+  test "erase works for people removed the old way" do
+    user = users(:jz)
+    user.sessions.create!(user_agent: "agent", ip_address: "127.0.0.1")
+    user.deactivate
+
+    deactivated = user.reload
+    assert_not deactivated.active?
+    assert_match(/-deactivated-/, deactivated.email_address)
+
+    deactivated.erase
+
+    assert_not User.exists?(user.id)
+    assert_empty SignInEvent.for_address("jz@example.com")
+    assert_empty SignInEvent.for_address(deactivated.email_address)
+  end
 end
