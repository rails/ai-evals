diff --git a/app/models/book.rb b/app/models/book.rb
index 64a02da..595e05e 100644
--- a/app/models/book.rb
+++ b/app/models/book.rb
@@ -4,7 +4,11 @@ class Book < ApplicationRecord
   has_many :leaves, dependent: :destroy
   has_one_attached :cover, dependent: :purge_later
 
-  before_destroy :archive_access_list
+  # The accesses are destroyed by their own +before_destroy+ callback (because of
+  # +dependent: :destroy+), which is registered when the Accessable concern is
+  # included, so it would run before this one and empty the association first.
+  # Prepending makes sure the access list is archived while it's still there.
+  before_destroy :archive_access_list, prepend: true
 
   scope :ordered, -> { order(:title) }
   scope :published, -> { where(published: true) }
diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..5d02740 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,20 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy archives the access list and removes the book" do
+    book = books(:handbook)
+    expected = book.accesses.collect { |access| [ access.user_id, access.level ] }.sort
+
+    assert_difference -> { AccessArchive.count }, expected.size do
+      delete book_url(book)
+    end
+
+    assert_redirected_to root_url
+    assert_not Book.exists?(book.id)
+    assert_not Access.exists?(book_id: book.id)
+
+    archived = AccessArchive.where(book_id: book.id).collect { |archive| [ archive.user_id, archive.level ] }.sort
+    assert_equal expected, archived
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..541aaca 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,74 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives one row per person who had access" do
+    book = books(:handbook)
+    expected = book.accesses.collect { |access| [ access.user_id, access.level ] }.sort
+
+    assert_difference -> { AccessArchive.count }, expected.size do
+      book.destroy
+    end
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal expected, archives.collect { |archive| [ archive.user_id, archive.level ] }.sort
+    assert archives.all? { |archive| archive.book_id == book.id && archive.book_title == book.title }
+  end
+
+  test "archived access levels are recorded as they stood" do
+    book = books(:handbook)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+    book.destroy
+
+    archives = AccessArchive.where(book_id: book.id).index_by(&:user_id)
+    assert_equal "editor", archives[users(:kevin).id].level
+    assert_equal "reader", archives[users(:jz).id].level
+    assert_equal users(:kevin).name, archives[users(:kevin).id].user_name
+    assert_equal book.title, archives[users(:jz).id].book_title
+  end
+
+  test "destroying a book nobody has access to archives nothing" do
+    book = Book.create!(title: "Unshared")
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+  end
+
+  test "access revoked earlier is not archived" do
+    book = books(:handbook)
+    book.accesses.find_by(user: users(:kevin)).destroy!
+    remaining = book.accesses.size
+
+    assert_difference -> { AccessArchive.count }, remaining do
+      book.destroy!
+    end
+
+    assert_not_includes AccessArchive.where(book_id: book.id).collect(&:user_id), users(:kevin).id
+  end
+
+  test "nothing is archived before the deletion happens" do
+    book = books(:handbook)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.update!(title: "Renamed Handbook")
+      book.update_access(editors: [], readers: [ users(:kevin).id ])
+      book.update_access(editors: [], readers: [])
+    end
+  end
+
+  test "destroying a book removes the book and its access grants" do
+    book = books(:handbook)
+    accesses_count = book.accesses.size
+
+    assert_difference -> { Book.count }, -1 do
+      assert_difference -> { Access.count }, -accesses_count do
+        book.destroy
+      end
+    end
+
+    assert book.destroyed?
+    assert_not Access.exists?(book_id: book.id)
+  end
 end
