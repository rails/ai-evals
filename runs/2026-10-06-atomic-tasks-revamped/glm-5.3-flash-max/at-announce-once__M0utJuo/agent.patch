diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..6f21368 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,29 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :remember_publication, if: :saved_change_to_published?
+    after_update_commit :announce_publication, if: :publication_to_announce?
+    after_rollback :forget_publication
   end
 
   private
+    # Whether the book went live is decided while the save happens, since the change is
+    # long gone by the time the commit callbacks run and anything else saved in the same
+    # sitting may have clobbered it. It's only announced once the sitting is committed.
+    def remember_publication
+      @publication_to_announce = published?
+    end
+
+    def publication_to_announce?
+      @publication_to_announce == true
+    end
+
     def announce_publication
+      forget_publication
       AnnouncePublicationJob.perform_later self
     end
+
+    def forget_publication
+      @publication_to_announce = nil
+    end
 end
