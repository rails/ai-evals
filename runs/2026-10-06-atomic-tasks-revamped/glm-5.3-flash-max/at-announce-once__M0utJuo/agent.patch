diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..49f5764
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "announces a book that goes live" do
+    assert_enqueued_with job: AnnouncePublicationJob, args: [ books(:manual) ] do
+      books(:manual).update! published: true
+    end
+  end
+
+  test "announces a book that goes live exactly once, whatever else the sitting did" do
+    book = books(:manual)
+
+    book.transaction do
+      book.press Page.new(body: "Words"), title: "Preface"
+      book.update! published: true
+      book.leaves.active.first.update! title: "Renamed"
+      book.leaves.active.last.update! status: :trashed
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob
+  end
+
+  test "announces a book that ends the sitting live exactly once" do
+    book = books(:manual)
+
+    book.transaction do
+      book.update! published: true
+      book.update! subtitle: "Second edition"
+      book.update! published: true
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob
+  end
+
+  test "announces every book that goes live in a sitting" do
+    one, two = books(:manual), books(:handbook)
+
+    Book.transaction do
+      one.update! published: true
+      two.update! published: true
+    end
+
+    assert_enqueued_jobs 2, only: AnnouncePublicationJob
+  end
+
+  test "does not announce a book taken back down" do
+    books(:handbook).update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      books(:handbook).update! published: false
+    end
+  end
+
+  test "does not announce a live book saved again" do
+    books(:handbook).update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      books(:handbook).update! published: true, subtitle: "Second edition"
+    end
+  end
+
+  test "does not announce a save that changes nothing about publication" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      books(:manual).update! slug: "renamed"
+    end
+  end
+
+  test "does not announce a book that ends the sitting not live" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update! published: true
+        book.update! published: false
+      end
+    end
+  end
+
+  test "does not announce a sitting that fails after the book was marked live" do
+    book = books(:manual)
+
+    assert_raises RuntimeError do
+      book.transaction do
+        book.update! published: true
+        book.press Page.new(body: "Words"), title: "Afterword"
+        raise "Something went wrong"
+      end
+    end
+
+    assert_not book.reload.published?
+    assert_no_enqueued_jobs only: AnnouncePublicationJob
+  end
+end
