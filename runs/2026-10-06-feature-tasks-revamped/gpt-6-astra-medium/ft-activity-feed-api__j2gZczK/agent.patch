+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns account activity as a flat JSON array, newest first. Only activity on boards accessible to the current user is included. Results use the API's standard [pagination](../README.md#pagination); follow the `Link` header with `rel="next"` to retrieve subsequent pages.
+
+### Filters
+
+| Parameter | Type | Description |
+|-----------|------|-------------|
+| `creator_ids[]` | Array of user IDs | Only events created by these users |
+| `board_ids[]` | Array of board IDs | Only events on these boards |
+
+Filters can be combined. They never grant access to otherwise inaccessible activity. If nothing matches, the response is `[]`.
+
+### Events
+
+Each event contains:
+
+| Field | Description |
+|-------|-------------|
+| `id` | Event ID |
+| `action` | Event action (listed below) |
+| `created_at` | UTC timestamp in ISO 8601 format |
+| `description` | The event's plain-text description |
+| `particulars` | Event-specific details (listed below) |
+| `url` | Card URL; for comments, the card URL with an anchor pointing to the comment |
+| `eventable_type` | `Card` or `Comment` |
+| `eventable` | The existing [card](cards.md) or [comment](comments.md) API representation |
+| `board` | The existing [board](boards.md) API representation |
+| `creator` | The existing [user](users.md) API representation of the event's creator |
+
+The feed includes these actions:
+
+- `card_assigned`
+- `card_unassigned`
+- `card_published`
+- `card_closed`
+- `card_reopened`
+- `card_board_changed`
+- `card_title_changed`
+- `card_postponed`
+- `card_auto_postponed`
+- `card_triaged`
+- `card_sent_back_to_triage`
+- `comment_created`
+
+These mirror the HTML timeline, except that deprecated `card_collection_changed` events are omitted and `card_title_changed` events are included.
+
+### Particulars
+
+| Action | `particulars` fields |
+|--------|---------------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids`: array of user IDs |
+| `card_board_changed` | `old_board`, `new_board`: board names |
+| `card_title_changed` | `old_title`, `new_title`: card titles |
+| `card_triaged` | `column`: column name |
+| All other actions | Empty object (`{}`) |
+
+Missing board names, titles, and column names are returned as empty strings, not `null`. Details are returned directly inside `particulars`, without any additional nesting. For example:
+
+```json
+{
+  "old_title": "Original title",
+  "new_title": "Updated title"
+}
+```
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..6572791
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,214 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+    assert_equal users(:kevin).accessible_events.order(created_at: :desc, id: :desc).ids, response.parsed_body.pluck("id")
+
+    event = events(:layout_published)
+    activity = response.parsed_body.find { |activity| activity["id"] == event.id }
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at, Time.iso8601(activity["created_at"])
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+
+    get card_path(event.eventable), as: :json
+    assert_equal response.parsed_body.except("steps"), activity["eventable"]
+    assert_equal response.parsed_body["board"], activity["board"]
+    assert_equal response.parsed_body["creator"], activity["creator"]
+  end
+
+  test "comment activity uses the comment representation and links to the comment on its card" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path, as: :json
+    assert_response :success
+    activity = response.parsed_body.find { |activity| activity["id"] == event.id }
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(comment.card, comment), as: :json
+    assert_equal response.parsed_body, activity["eventable"]
+  end
+
+  test "includes timeline actions and title changes but not deprecated or unrelated actions" do
+    actions = %w[
+      card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_title_changed card_postponed card_auto_postponed
+      card_triaged card_sent_back_to_triage comment_created
+    ]
+    actions.each do |action|
+      eventable = action == "comment_created" ? comments(:layout_overflowing_david) : cards(:logo)
+      create_activity(action, eventable: eventable, particulars: { assignee_ids: [ users(:david).id ] })
+    end
+    %w[ card_collection_changed card_resumed card_unknown ].each { |action| create_activity(action) }
+
+    get activities_path(creator_ids: [ users(:jz).id ]), as: :json
+
+    assert_response :success
+    assert_equal actions.sort, response.parsed_body.pluck("action").sort
+  end
+
+  test "assignment particulars expose only assignee ids" do
+    %w[ card_assigned card_unassigned ].each do |action|
+      ids = users(:kevin, :david).pluck(:id)
+      event = create_activity(action, particulars: { assignee_ids: ids, ignored: "private detail" })
+
+      assert_equal({ "assignee_ids" => ids }, activity_for(event)["particulars"])
+    end
+  end
+
+  test "board title and triage particulars are flattened" do
+    {
+      "card_board_changed" => { "old_board" => "Old board", "new_board" => "New board" },
+      "card_title_changed" => { "old_title" => "Old title", "new_title" => "New title" },
+      "card_triaged" => { "column" => "In progress" }
+    }.each do |action, particulars|
+      event = create_activity(action, particulars: { particulars: particulars.merge("ignored" => "private detail") })
+
+      assert_equal particulars, activity_for(event)["particulars"]
+    end
+  end
+
+  test "missing and null board title and column values become empty strings" do
+    {
+      "card_board_changed" => %w[ old_board new_board ],
+      "card_title_changed" => %w[ old_title new_title ],
+      "card_triaged" => %w[ column ]
+    }.each do |action, keys|
+      [ {}, { particulars: keys.index_with(nil) } ].each do |particulars|
+        event = create_activity(action, particulars: particulars)
+
+        assert_equal keys.index_with(""), activity_for(event)["particulars"]
+      end
+    end
+  end
+
+  test "other actions do not expose stored particulars" do
+    event = create_activity("card_sent_back_to_triage", particulars: { particulars: { column: "Old column" }, ignored: true })
+
+    assert_equal({}, activity_for(event)["particulars"])
+  end
+
+  test "filters by creators and boards together" do
+    matching = create_activity("card_published")
+    create_activity("card_published", creator: users(:kevin))
+    create_activity("card_published", eventable: private_card)
+
+    get activities_path(creator_ids: [ users(:jz).id ], board_ids: [ boards(:writebook).id ]), as: :json
+
+    assert_response :success
+    assert_equal [ matching.id ], response.parsed_body.pluck("id")
+  end
+
+  test "creator filters accept multiple ids" do
+    first = create_activity("card_published")
+    second = create_activity("card_published", creator: users(:kevin))
+
+    get activities_path(creator_ids: users(:jz, :kevin).pluck(:id)), as: :json
+
+    assert_response :success
+    assert_includes response.parsed_body.pluck("id"), first.id
+    assert_includes response.parsed_body.pluck("id"), second.id
+    assert_equal users(:jz, :kevin).pluck(:id).sort, response.parsed_body.map { |activity| activity["creator"]["id"] }.uniq.sort
+  end
+
+  test "only returns accessible activity even when inaccessible boards are requested" do
+    private_event = create_activity("card_published", eventable: private_card)
+    foreign_event = create_activity("card_published", eventable: cards(:radio), creator: users(:mike))
+    accesses(:private_kevin).destroy!
+
+    [ {}, { board_ids: boards(:private, :miltons_wish_list, :writebook).pluck(:id) } ].each do |filters|
+      get activities_path(filters), as: :json
+
+      assert_response :success
+      assert_not_empty response.parsed_body
+      assert_not_includes response.parsed_body.pluck("id"), private_event.id
+      assert_not_includes response.parsed_body.pluck("id"), foreign_event.id
+      assert_equal [ boards(:writebook).id ], response.parsed_body.map { |activity| activity["board"]["id"] }.uniq
+    end
+  end
+
+  test "nonmatching filters return an empty array" do
+    [ { creator_ids: [ users(:mike).id ] }, { board_ids: [ boards(:miltons_wish_list).id ] }, { board_ids: [ "missing" ] } ].each do |filters|
+      get activities_path(filters), as: :json
+
+      assert_response :success
+      assert_equal [], response.parsed_body
+    end
+  end
+
+  test "paginates newest first with stable ties and preserves filters" do
+    now = Time.current
+    matching = 35.times.map do |index|
+      create_activity("card_published", created_at: now - (index / 2).minutes)
+    end
+    create_activity("card_published", creator: users(:kevin))
+    create_activity("card_published", eventable: private_card)
+
+    expected_ids = matching.sort_by { |event| [ event.created_at, event.id ] }.reverse.map(&:id)
+    actual_ids = []
+    next_page = activities_path(format: :json, creator_ids: [ users(:jz).id ], board_ids: [ boards(:writebook).id ])
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+      page_count += 1
+      actual_ids.concat(response.parsed_body.pluck("id"))
+      url = response.headers["Link"]&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      next_page = url && URI.parse(url).request_uri
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get activities_path, as: :json
+
+    assert_redirected_to new_session_url(script_name: nil)
+  end
+
+  test "accepts a read-only bearer token" do
+    token = identities(:kevin).access_tokens.create!(description: "Activity client", permission: :read)
+    sign_out
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{token.token}" }
+
+    assert_response :success
+    assert_not_empty response.parsed_body
+  end
+
+  private
+    def private_card
+      @private_card ||= with_current_user(:kevin) do
+        boards(:private).cards.create!(title: "Private card", creator: users(:kevin), status: :published)
+      end
+    end
+
+    def create_activity(action, eventable: cards(:logo), creator: users(:jz), **attributes)
+      Event.create!(action: action, eventable: eventable, board: eventable.board, creator: creator, **attributes)
+    end
+
+    def activity_for(event)
+      get activities_path, as: :json
+      assert_response :success
+      response.parsed_body.find { |activity| activity["id"] == event.id }
+    end
+end
