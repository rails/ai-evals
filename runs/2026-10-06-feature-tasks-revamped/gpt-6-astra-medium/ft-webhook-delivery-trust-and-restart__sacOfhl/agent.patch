+require "test_helper"
+
+class Webhook::DeliveryExecutionTest < ActiveSupport::TestCase
+  setup do
+    @delivery = webhook_deliveries(:pending)
+    @webhook = @delivery.webhook
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "posts a signed event and records the result exactly once across repeated jobs" do
+    request = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34") do |request|
+      body = JSON.parse(request.body)
+      assert_equal @delivery.event.id, body["id"]
+      assert_equal @delivery.event.action, body["action"]
+      assert_equal @delivery.event.board_id, body.dig("board", "id")
+      assert_includes body.dig("eventable", "url"), @delivery.account.slug
+      assert_equal @delivery.id, request.headers["X-Webhook-Delivery"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+      true
+    end.to_return(status: 204)
+
+    2.times { Webhook::DeliveryJob.perform_now(@delivery.reload) }
+
+    assert_requested request, times: 1
+    assert @delivery.reload.succeeded?
+    assert_equal 204, @delivery.response[:code]
+    assert_equal "application/json", @delivery.request.dig("headers", "Content-Type")
+  end
+
+  test "non-success responses are completed failures and are not retried" do
+    request = stub_request(:post, @webhook.url).to_return(status: 503)
+    2.times { @delivery.reload.deliver }
+    assert_requested request, times: 1
+    assert @delivery.reload.completed?
+    assert @delivery.failed?
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "network errors are logged without retrying" do
+    request = stub_request(:post, @webhook.url).to_timeout
+    2.times { @delivery.reload.deliver }
+    assert_requested request, times: 1
+    assert @delivery.reload.errored?
+    assert @delivery.failed?
+    assert @delivery.response[:error].present?
+  end
+
+  test "an overlapping job cannot claim the same pending delivery" do
+    rival = Webhook::Delivery.find(@delivery.id)
+    request = stub_request(:post, @webhook.url).to_return do
+      rival.deliver
+      { status: 200 }
+    end
+
+    @delivery.deliver
+
+    assert_requested request, times: 1
+    assert @delivery.reload.succeeded?
+  end
+
+  test "delivery outcomes disable a delinquent receiver and do not count duplicate jobs" do
+    @webhook.create_delinquency_tracker! consecutive_failures_count: 9, first_failure_at: 1.hour.ago
+    request = stub_request(:post, @webhook.url).to_return(status: 500)
+
+    2.times { @delivery.reload.deliver }
+
+    assert_requested request, times: 1
+    assert_not @webhook.reload.active?
+    assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "does not resend claimed deliveries" do
+    @delivery.update! state: :in_progress
+    @delivery.deliver
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "does not send queued deliveries for inactive receivers" do
+    @webhook.deactivate
+    @delivery.deliver
+    assert_not_requested :post, @webhook.url
+    assert_equal "webhook_inactive", @delivery.reload.response[:error]
+  end
+
+  test "does not follow redirects" do
+    stub_request(:post, @webhook.url).to_return(status: 302, headers: { "Location" => "http://127.0.0.1/secret" })
+    @delivery.deliver
+    assert @delivery.reload.failed?
+    assert_equal 302, @delivery.response[:code]
+    assert_not_requested :post, "http://127.0.0.1/secret"
+  end
+
+  test "blocks private destinations" do
+    stub_dns_resolution("127.0.0.1", "169.254.169.254")
+    @delivery.deliver
+    assert_not_requested :post, @webhook.url
+    assert @delivery.reload.errored?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+  end
+
+  test "blocks literal private IPv4 and IPv6 addresses without DNS resolution" do
+    [ "http://127.0.0.1/secret", "http://[::1]/secret", "http://169.254.169.254/secret" ].each do |url|
+      @webhook.update! url: url
+      @delivery.update! state: :pending
+      SsrfProtection.expects(:resolve_public_ip).never
+
+      @delivery.deliver
+
+      assert_equal "destination_unreachable", @delivery.reload.response[:error]
+      assert_not_requested :post, url
+    end
+  end
+
+  test "supports literal public IP addresses" do
+    @webhook.update! url: "https://93.184.216.34/webhook"
+    SsrfProtection.expects(:resolve_public_ip).never
+    request = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    @delivery.deliver
+
+    assert_requested request, times: 1
+    assert @delivery.reload.succeeded?
+  end
+
+  test "a failed TLS connection is recorded as an error" do
+    request = stub_request(:post, @webhook.url).to_raise(OpenSSL::SSL::SSLError)
+    @delivery.deliver
+    assert_requested request, times: 1
+    assert @delivery.reload.errored?
+  end
+
+  test "one delivery per event and webhook is enforced by the database" do
+    assert_raises ActiveRecord::RecordNotUnique do
+      Webhook::Delivery.create!(@delivery.attributes.except("id"))
+    end
+  end
+
+  test "cleanup keeps the last week of logs" do
+    freeze_time do
+      @delivery.update! created_at: 1.week.ago - 1.second
+      boundary = webhook_deliveries(:in_progress)
+      boundary.update! created_at: 1.week.ago
+      recent = webhook_deliveries(:successfully_completed)
+      recent.update! created_at: 1.day.ago
+
+      Webhook::Delivery.cleanup
+
+      assert_not Webhook::Delivery.exists?(@delivery.id)
+      assert Webhook::Delivery.exists?(boundary.id)
+      assert Webhook::Delivery.exists?(recent.id)
+    end
+  end
+end
