diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..50b043c
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,62 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  TIMEOUT = 10
+
+  attr_reader :delivery, :body, :headers
+
+  def initialize(delivery)
+    @delivery = delivery
+    @body = Webhook::Payload.new(delivery.webhook, delivery.event).to_json
+    @headers = {
+      "Content-Type" => "application/json",
+      "User-Agent" => "Fizzy Webhook",
+      "X-Webhook-Delivery" => delivery.id,
+      "X-Webhook-Timestamp" => Time.current.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", delivery.webhook.signing_secret, body)
+    }
+  end
+
+  def perform
+    uri = URI.parse(delivery.webhook.url)
+    if Webhook::PERMITTED_SCHEMES.exclude?(uri.scheme) || uri.hostname.blank? || uri.userinfo.present?
+      return { error: "invalid_url" }
+    end
+
+    if ip = destination_ip(uri.hostname)
+      # Pin the validated IP while retaining the hostname for TLS and Host.
+      # Disable environment proxies, redirects, and implicit retries.
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+      http.max_retries = 0
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+      result = nil
+      http.request(request) do |response|
+        result = { code: response.code.to_i, headers: response.to_hash }
+        # Discard the body in chunks rather than retaining unbounded receiver output.
+        response.read_body { |_chunk| }
+      end
+      result
+    else
+      { error: "destination_unreachable" }
+    end
+  rescue URI::InvalidURIError
+    { error: "invalid_url" }
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::ProtocolError, Resolv::ResolvError
+    { error: "destination_unreachable" }
+  end
+
+  private
+    def destination_ip(hostname)
+      address = IPAddr.new(hostname)
+      address.to_s unless SsrfProtection.blocked_address?(address)
+    rescue IPAddr::InvalidAddressError
+      SsrfProtection.resolve_public_ip(hostname)
+    end
+end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
