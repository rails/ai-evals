   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
+  after_create_commit :deliver_later
+
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).in_batches.delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later self
+  end
+
+  def deliver
+    # Commit the claim before doing IO. Retried/concurrent jobs must never send
+    # an already claimed delivery, even if the worker died awaiting a response.
+    if self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+      reload
+      if webhook.reload.active?
+        outgoing_request = Request.new(self)
+        update! request: { headers: outgoing_request.headers, body: outgoing_request.body }
+        record_result outgoing_request.perform
+      else
+        update! state: :errored, response: { error: "webhook_inactive" }
+      end
+    end
+  end
+
