+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveJob::TestCase
+  test "restores the tenant context when delivering in a job" do
+    delivery = webhook_deliveries(:pending)
+    stub_dns_resolution("93.184.216.34")
+    request = stub_request(:post, delivery.webhook.url).with do
+      assert_equal delivery.account, Current.account
+      true
+    end.to_return(status: 200)
+
+    delivery.deliver_later
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_requested request, times: 1
+    assert delivery.reload.succeeded?
+  end
+
+  test "discards queued deliveries whose webhook has been deleted" do
+    delivery = webhook_deliveries(:pending)
+    delivery.deliver_later
+    delivery.webhook.destroy!
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_not_requested :post, "https://api.example.com/webhooks"
+  end
+end
