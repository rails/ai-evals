+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:layout_commented)
+  end
+
+  test "comment payload includes its card and creator" do
+    payload = JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+    assert_equal @event.id, payload["id"]
+    assert_equal @event.eventable_id, payload.dig("eventable", "id")
+    assert_equal @event.creator_id, payload.dig("creator", "id")
+  end
+
+  test "payload links preserve the configured scheme, port, and account" do
+    options = { host: "fizzy.example.com", protocol: "https", port: 8443 }
+    Rails.application.routes.stubs(:default_url_options).returns(options)
+
+    payload = JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+
+    assert_equal "https://fizzy.example.com:8443#{@event.account.slug}/cards/#{@event.card.number}", payload.dig("eventable", "card", "url")
+  end
+
+  test "chat integrations use their native message formats" do
+    {
+      "https://hooks.slack.com/services/T123/B123/token" => "text",
+      "https://chat.example.com/rooms/123/456-token/messages" => "body",
+      "https://3.basecamp.com/123/integrations/token/buckets/456/chats/789/lines" => "content"
+    }.each do |url, key|
+      @webhook.url = url
+      payload = JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+      assert_includes payload.fetch(key), "commented on"
+      assert_includes payload.fetch(key), @event.account.slug
+    end
+  end
+end
