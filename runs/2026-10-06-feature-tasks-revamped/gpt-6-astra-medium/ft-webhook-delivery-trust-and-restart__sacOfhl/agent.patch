@@ -0,0 +1,37 @@
+class Webhook::Payload
+  attr_reader :webhook, :event
+
+  def initialize(webhook, event)
+    @webhook, @event = webhook, event
+  end
+
+  def to_json
+    if webhook.for_slack?
+      { text: "#{event.description_for(nil).to_plain_text}\n#{event_url}" }.to_json
+    elsif webhook.for_campfire?
+      { body: render(:html) }.to_json
+    elsif webhook.for_basecamp?
+      { content: render(:html) }.to_json
+    else
+      render(:json)
+    end
+  end
+
+  private
+    def event_url
+      Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options)
+    end
+
+    def render(format)
+      host = [ url_options[:host], url_options[:port] ].compact.join(":")
+      ApplicationController.renderer.new(
+        http_host: host, https: url_options[:protocol] == "https", script_name: event.account.slug
+      ).render(template: "webhooks/event", formats: [ format ], layout: false, assigns: { event: event })
+    end
+
+    def url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+      base_options.merge(script_name: event.account.slug)
+    end
+end
