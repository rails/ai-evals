+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  test "creates and enqueues deliveries only for active subscribers on the event board" do
+    webhook = webhooks(:active)
+    webhook.update! subscribed_actions: [ "comment_created" ]
+    webhook.board.webhooks.create! name: "Unsubscribed", url: "https://example.com/other"
+    webhook.board.webhooks.create! name: "Inactive", url: "https://example.com/inactive", active: false, subscribed_actions: [ "comment_created" ]
+    boards(:private).webhooks.create! name: "Other board", url: "https://example.com/private", subscribed_actions: [ "comment_created" ]
+
+    assert_difference "Webhook::Delivery.count", 1 do
+      assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+        event = Event.new(events(:layout_commented).attributes.except("id"))
+        event.save!
+        assert_equal [ webhook ], event.webhook_deliveries.map(&:webhook)
+        assert_equal event.account, event.webhook_deliveries.first.account
+      end
+    end
+  end
+
+  test "rolled back events do not deliver" do
+    assert_no_difference "Webhook::Delivery.count" do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        Event.transaction do
+          Event.create!(events(:logo_published).attributes.except("id"))
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..a004a1b
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.create_delinquency_tracker!
+    @failure = webhook_deliveries(:unsuccessfully_completed)
+    @success = webhook_deliveries(:successfully_completed)
+  end
+
+  test "ten consecutive failures spanning an hour deactivate the webhook" do
+    freeze_time do
+      @tracker.record(@failure)
+      assert_equal Time.current, @tracker.first_failure_at
+      assert_equal @webhook.account, @tracker.account
+
+      travel 1.hour
+      8.times { @tracker.record(@failure) }
+      assert @webhook.reload.active?, "nine failures must not disable a receiver"
+
+      @tracker.record(@failure)
+      assert_not @webhook.reload.active?
+      assert_equal 10, @tracker.reload.consecutive_failures_count
+    end
+  end
+
+  test "ten failures in less than an hour do not deactivate the webhook" do
+    freeze_time do
+      10.times { @tracker.record(@failure) }
+      travel 1.hour - 1.second
+      @tracker.record(@failure)
+      assert @webhook.reload.active?
+
+      travel 1.second
+      @tracker.record(@failure)
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "a success resets both the counter and the start of the failure streak" do
+    @tracker.update! consecutive_failures_count: 9, first_failure_at: 2.hours.ago
+    @tracker.record(@success)
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+
+    freeze_time do
+      @tracker.record(@failure)
+      assert_equal 1, @tracker.reload.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "reactivation starts a fresh failure streak" do
+    @tracker.update! consecutive_failures_count: 10, first_failure_at: 2.hours.ago
+    @webhook.deactivate
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+    @tracker.record(@failure)
+    assert @webhook.reload.active?
+  end
+
+  test "destroying a webhook removes its tracker" do
+    @webhook.destroy!
+    assert_not Webhook::DelinquencyTracker.exists?(@tracker.id)
+  end
+end
