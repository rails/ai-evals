@@ -0,0 +1,59 @@
+# Single-server deployment. See docs/deployment.md before running kamal setup.
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    # Point this hostname at your server. Used for SSH, HTTPS, and email links.
+    - &hostname fizzy.example.com
+
+proxy:
+  ssl: true
+  host: *hostname
+  # The image runs Thruster on port 80 in front of Puma.
+  app_port: 80
+
+# Kamal runs a local registry and forwards it to the server over SSH.
+# No external registry account is required.
+registry:
+  server: localhost:5555
+
+builder:
+  # Change to arm64 for an ARM server.
+  arch: amd64
+
+# SSH defaults to root. For another user with Docker access, uncomment:
+# ssh:
+#   user: deploy
+
+env:
+  clear:
+    APP_FQDN: *hostname
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    # Conservative defaults for a small server; increase as needed.
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_AUTHENTICATION: plain
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    # Optional browser push notifications (see docs/deployment.md):
+    # - VAPID_PUBLIC_KEY
+    # - VAPID_PRIVATE_KEY
+
+# All SQLite databases and local uploads live here. Do not remove this volume.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
