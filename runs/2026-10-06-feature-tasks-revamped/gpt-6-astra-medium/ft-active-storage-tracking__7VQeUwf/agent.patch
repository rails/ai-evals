new file mode 100644
index 0000000..21943c2
--- /dev/null
+++ b/app/jobs/storage/backfill_job.rb
@@ -0,0 +1,22 @@
+class Storage::BackfillJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::LockWaitTimeout, ActiveRecord::StatementTimeout
+
+  def perform(account_id, after: nil)
+    if account = Account.find_by(id: account_id)
+      attachments = ActiveStorage::Attachment.where(account_id: account.id, record_type: [ "Card", "ActionText::RichText" ])
+      attachments = attachments.where(ActiveStorage::Attachment.arel_table[:id].gt(after)) if after
+      batch = attachments.order(:id).limit(Storage::Entry::BATCH_SIZE).to_a
+
+      batch.each do |attachment|
+        # Serialize with deletion so a backfill cannot resurrect a removed entry.
+        attachment.with_lock { attachment.track_storage }
+      rescue ActiveRecord::RecordNotFound
+        # The attachment was deleted since the batch was loaded.
+      end
+
+      Storage::ReconcileJob.perform_later(account.id)
+      self.class.perform_later(account.id, after: batch.last.id) if batch.size == Storage::Entry::BATCH_SIZE
+    end
+  end
+end
