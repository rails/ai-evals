diff --git a/test/models/storage/concurrency_test.rb b/test/models/storage/concurrency_test.rb
new file mode 100644
index 0000000..23a26a3
--- /dev/null
+++ b/test/models/storage/concurrency_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Storage::ConcurrencyTest < ActiveSupport::TestCase
+  # Workers need independent connections to committed data.
+  self.use_transactional_tests = false
+
+  setup do
+    @account = Account.create_with_owner(account: { name: "Storage concurrency" }, owner: { name: "Storage tester" })
+    Current.account = @account
+    Current.user = @account.users.find_by!(role: :owner)
+    @board = @account.boards.create!(name: "Storage", creator: Current.user)
+    @board.update!(public_description: "Files")
+    @blob_ids = []
+  end
+
+  teardown do
+    @account.destroy!
+    ActiveStorage::Blob.where(id: @blob_ids).delete_all
+  end
+
+  test "concurrent workers and removals neither lose nor duplicate usage" do
+    105.times do
+      blob = ActiveStorage::Blob.create_before_direct_upload!(filename: "test.txt", byte_size: 4096, checksum: "unused", content_type: "text/plain")
+      @blob_ids << blob.id
+      ActiveStorage::Attachment.create!(record: @board.public_description, name: "embeds", blob: blob)
+    end
+
+    3.times.map { worker { reconcile } }.each(&:value)
+    assert_equal 105 * 4096, @account.bytes_used
+    assert_equal @account.bytes_used, @board.bytes_used
+
+    ids = ActiveStorage::Attachment.where(blob_id: @blob_ids).limit(55).pluck(:id)
+    remover = worker { ids.each { |id| ActiveStorage::Attachment.find(id).delete } }
+    aggregator = worker { reconcile }
+    [ remover, aggregator ].each(&:value)
+    reconcile
+
+    assert_equal 50 * 4096, @account.bytes_used
+    assert_equal @account.bytes_used, @board.bytes_used
+    assert_not Storage::Entry.dirty.where(account_id: @account.id).exists?
+  end
+
+  private
+    def worker(&block)
+      Thread.new do
+        ActiveRecord::Base.connection_pool.with_connection do
+          Current.with_account(@account, &block)
+        end
+      end
+    end
+
+    def reconcile
+      retries = 0
+      begin
+        while Storage::Entry.reconcile(Account.find(@account.id))
+        end
+      rescue ActiveRecord::StatementTimeout, ActiveRecord::Deadlocked, ActiveRecord::LockWaitTimeout
+        # The jobs retry these too. SQLite serializes writers at database level.
+        raise if (retries += 1) > 10
+        sleep 0.01
+        retry
+      end
+    end
+end
