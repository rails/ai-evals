@@ -0,0 +1,11 @@
+# Bulk detach deliberately bypasses Active Record callbacks.
+module Storage::DetachMany
+  def detach
+    ActiveStorage::Attachment.transaction do
+      if attachments.respond_to?(:select)
+        Storage::Entry.where(attachment_id: attachments.select(:id)).update_all(byte_size: 0, dirty: true)
+      end
+      super
+    end
+  end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..5104800
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,60 @@
+# One entry per counted attachment (not per blob). Pending changes are written in
+# the same transaction as the attachment, then folded into totals in the background.
+class Storage::Entry < ApplicationRecord
+  BATCH_SIZE = 100
+
+  scope :dirty, -> { where(dirty: true) }
+
+  class << self
+    def reconcile_later
+      Account.where(id: dirty.select(:account_id)).find_each do |account|
+        Current.with_account(account) { Storage::ReconcileJob.perform_later(account.id) }
+      end
+    end
+
+    def reconcile(account)
+      total = Storage::Total.create_or_find_by!(owner: account)
+
+      # Only background workers lock the total. Foreground changes lock individual
+      # entries, never an account-wide or board-wide counter.
+      total.with_lock do
+        entries = dirty.where(account_id: account.id).order(:id).limit(BATCH_SIZE).lock.to_a
+        reconcile_entries(account, total, entries)
+      end
+
+      dirty.where(account_id: account.id).exists?
+    end
+
+    private
+      def reconcile_entries(account, total, entries)
+        card_boards = account.cards.where(id: entries.filter_map(&:card_id)).pluck(:id, :board_id).to_h
+        board_ids = entries.map { |entry| entry.card_id ? card_boards[entry.card_id] : entry.board_id }
+        existing_boards = account.boards.where(id: board_ids + entries.filter_map(&:accounted_board_id)).pluck(:id).to_set
+        deltas = Hash.new(0)
+
+        entries.each do |entry|
+          board_id = entry.card_id ? card_boards[entry.card_id] : entry.board_id
+          byte_size = existing_boards.include?(board_id) ? entry.byte_size : 0
+
+          deltas[entry.accounted_board_id] -= entry.accounted_byte_size if entry.accounted_board_id
+          deltas[board_id] += byte_size if board_id
+
+          entry.assign_attributes(accounted_board_id: board_id, accounted_byte_size: byte_size, dirty: false)
+        end
+
+        deltas.sort_by { |board_id, _| board_id }.each do |board_id, delta|
+          if delta.nonzero? && existing_boards.include?(board_id)
+            board_total = Storage::Total.create_or_find_by!(owner_type: "Board", owner_id: board_id)
+            board_total.increment!(:bytes_used, delta)
+          end
+        end
+
+        removed, retained = entries.partition { |entry| entry.byte_size.zero? }
+        where(id: removed.map(&:id)).delete_all if removed.any?
+        upsert_all(retained.map(&:attributes), update_only: %i[ accounted_board_id accounted_byte_size dirty ]) if retained.any?
+
+        delta = deltas.values.sum
+        total.increment!(:bytes_used, delta) if delta.nonzero?
+      end
+  end
+end
