+  test "accounts and boards start with no storage usage" do
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "counts only card images and embeds in board descriptions card descriptions and comments" do
+    @card.image.attach(blob(11))
+    embed(@board, :public_description, blob(13))
+    embed(@card, :description, blob(17))
+    embed(comments(:logo_1), :body, blob(19))
+    users(:david).avatar.attach(blob(23))
+    blob(29) # An unattached/direct-upload blob is not usage.
+
+    assert_equal 0, @board.bytes_used, "aggregation must happen in the background"
+    reconcile
+
+    assert_equal 60, @board.bytes_used
+    assert_equal 60, @account.bytes_used
+    assert_equal 0, boards(:private).bytes_used
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+
+  test "sums boards and isolates accounts" do
+    @card.image.attach(blob(11))
+    embed(boards(:private), :public_description, blob(13))
+    Current.with_account(accounts(:initech)) { cards(:radio).image.attach(blob(17)) }
+    reconcile
+
+    assert_equal 11, @board.bytes_used
+    assert_equal 13, boards(:private).bytes_used
+    assert_equal 24, @account.bytes_used
+    assert_equal 17, accounts(:initech).bytes_used
+  end
+
+  test "shared blobs count once per attachment and jobs can be repeated" do
+    shared = blob(11)
+    @card.image.attach(shared)
+    embed(@card, :description, shared)
+    reconcile
+    2.times { Storage::ReconcileJob.perform_now(@account.id) }
+    assert_equal 22, @account.bytes_used
+
+    @card.image.detach
+    reconcile
+    assert_equal 11, @account.bytes_used
+  end
+
+  test "replacing and removing attachments updates already loaded owners" do
+    @card.image.attach(blob(11))
+    embed(@card, :description, blob(13))
+    reconcile
+    assert_equal 24, @board.bytes_used
+
+    @card.image.attach(blob(17))
+    @card.update!(description: "No files now")
+    reconcile
+    assert_equal 17, @board.bytes_used
+    assert_equal 17, @account.bytes_used
+
+    @card.image.purge_later
+    reconcile
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "bulk detach and synchronous purge remove usage without needing the blob" do
+    embed(@card, :description, blob(13))
+    @card.image.attach(blob(17))
+    reconcile
+    @card.description.embeds.detach
+    @card.image.purge
+    reconcile
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+
+  test "attachments added and removed before aggregation never contribute usage" do
+    @card.image.attach(blob(11))
+    @card.image.detach
+    reconcile
+    assert_equal 0, @account.bytes_used
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+
+  test "moving a card transfers its image description and comment embeds" do
+    @card.image.attach(blob(11))
+    embed(@card, :description, blob(13))
+    embed(comments(:logo_1), :body, blob(17))
+    embed(@board, :public_description, blob(19))
+    reconcile
+
+    @card.move_to(boards(:private))
+    reconcile
+    assert_equal 19, @board.bytes_used
+    assert_equal 41, boards(:private).bytes_used
+    assert_equal 60, @account.bytes_used
+  end
+
+  test "moves before initial aggregation and repeated moves use the latest board" do
+    @card.image.attach(blob(11))
+    @card.move_to(boards(:private))
+    @card.reload.move_to(@board)
+    @card.reload.move_to(boards(:private))
+    reconcile
+    assert_equal 0, @board.bytes_used
+    assert_equal 11, boards(:private).bytes_used
+    assert_equal 11, @account.bytes_used
+  end
+
+  test "deleting comments cards and boards subtracts their usage" do
+    @card.image.attach(blob(11))
+    embed(comments(:logo_1), :body, blob(13))
+    embed(@board, :public_description, blob(17))
+    reconcile
+
+    comments(:logo_1).destroy!
+    reconcile
+    assert_equal 28, @account.bytes_used
+
+    @card.destroy!
+    reconcile
+    assert_equal 17, @account.bytes_used
+
+    @board.destroy!
+    reconcile
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "attachment changes roll back with their transaction" do
+    @card.image.attach(blob(11))
+    reconcile
+    ActiveStorage::Attachment.transaction do
+      @card.image.attachment.destroy!
+      raise ActiveRecord::Rollback
+    end
+    reconcile
+    assert_equal 11, @account.bytes_used
+
+    ActiveStorage::Attachment.transaction do
+      cards(:layout).image.attach(blob(13))
+      raise ActiveRecord::Rollback
+    end
+    reconcile
+    assert_equal 11, @account.bytes_used
+  end
+
+  test "failed aggregation rolls back both the ledger and totals" do
+    @card.image.attach(blob(11))
+    Storage::Total.any_instance.stubs(:increment!).raises("interrupted")
+    assert_raises(RuntimeError) { Storage::Entry.reconcile(@account) }
+    assert_equal 0, @account.bytes_used
+    assert Storage::Entry.dirty.exists?
+
+    Storage::Total.any_instance.unstub(:increment!)
+    reconcile
+    assert_equal 11, @account.bytes_used
+    assert_equal 11, @board.bytes_used
+  end
+
+  test "backfill handles existing attachments and is safe to repeat" do
+    @card.image.attach(blob(11))
+    embed(comments(:logo_1), :body, blob(13))
+    Storage::Entry.delete_all # Simulate attachments that predate storage accounting.
+
+    stub_const(Storage::Entry, :BATCH_SIZE, 1) do
+      2.times do
+        perform_enqueued_jobs(only: [ Storage::BackfillJob, Storage::ReconcileJob ]) do
+          Storage::BackfillJob.perform_later(@account.id)
+        end
+      end
+    end
+    assert_equal 24, @account.bytes_used
+    assert_equal 24, @board.bytes_used
+  end
+
+  test "large files use bigint totals and aggregation is bounded" do
+    # Blob metadata is enough: storage accounting never downloads the file.
+    large = blob(1)
+    large.update!(byte_size: 5.gigabytes)
+    @card.image.attach(large)
+    embed(@card, :description, blob(13))
+
+    stub_const(Storage::Entry, :BATCH_SIZE, 1) do
+      assert Storage::Entry.reconcile(@account), "one batch must leave pending work"
+      assert_equal 1, Storage::Entry.dirty.count
+      reconcile
+    end
+    assert_equal 5.gigabytes + 13, @account.bytes_used
+  end
+
+  test "draft and closed cards count and deleting a board before aggregation is harmless" do
+    cards(:shipping).image.attach(blob(11))
+    draft = @board.cards.create!(status: :drafted, creator: users(:david))
+    draft.image.attach(blob(13))
+    reconcile
+    assert_equal 24, @board.bytes_used
+
+    embed(@board, :public_description, blob(17))
+    @board.destroy!
+    reconcile
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "exports previews variants and unrelated rich text do not count" do
+    exports(:pending_account_export).file.attach(blob(11))
+    source = blob(13)
+    source.preview_image.attach(blob(17))
+    variant = ActiveStorage::VariantRecord.create!(blob: source, variation_digest: "storage-test")
+    variant.image.attach(blob(19))
+    ActionText::RichText.create!(record: @card, name: "unrelated", body: ActionText::Attachment.from_attachable(blob(23)).to_html)
+    reconcile
+    assert_equal 0, @account.bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "dispatcher recovers pending work without an attachment callback enqueue" do
+    @card.image.attach(blob(11))
+    clear_enqueued_jobs
+    reconcile
+    assert_equal 11, @account.bytes_used
+  end
+
+  test "destroying an account cleans up its derived records and queued jobs are harmless" do
+    @card.image.attach(blob(11))
+    reconcile
+    @account.destroy!
+    Storage::ReconcileJob.perform_now(@account.id)
+    assert_empty Storage::Entry.where(account_id: @account.id)
+    assert_empty Storage::Total.where(owner_type: "Account", owner_id: @account.id)
+    assert_empty Storage::Total.where(owner_type: "Board", owner_id: @board.id)
+  end
+
+  private
+    def blob(size)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * size), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def embed(record, attribute, blob)
+      record.update!(attribute => ActionText::Attachment.from_attachable(blob).to_html)
+    end
+
+    def reconcile
+      perform_enqueued_jobs(only: Storage::ReconcileJob) { Storage::Entry.reconcile_later }
+    end
+end
