@@ -0,0 +1,45 @@
+module Storage::Attachment
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :track_storage
+    after_destroy :remove_tracked_storage
+  end
+
+  # Active Storage's purge/purge_later and detach use delete, not destroy.
+  def delete
+    transaction do
+      super.tap { remove_tracked_storage }
+    end
+  end
+
+  def track_storage
+    if owner = storage_owner
+      card = owner.is_a?(Comment) ? owner.card : owner
+      board = card.is_a?(Board) ? card : card.board
+
+      Storage::Entry.create_or_find_by!(attachment_id: id) do |entry|
+        entry.account_id = account_id
+        entry.card_id = card.id if card.is_a?(Card)
+        entry.board_id = board.id
+        entry.byte_size = blob.byte_size
+      end
+    end
+  end
+
+  private
+    def storage_owner
+      if record_type == "Card" && name == "image"
+        record
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        rich_text = record
+        if { "Board" => "public_description", "Card" => "description", "Comment" => "body" }[rich_text.record_type] == rich_text.name
+          rich_text.record
+        end
+      end
+    end
+
+    def remove_tracked_storage
+      Storage::Entry.where(attachment_id: id).update_all(byte_size: 0, dirty: true)
+    end
+end
