@@ -0,0 +1,54 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/device", p256dh_key: "p256dh", auth_key: "auth")
+    ENV.stubs(:[]).with("VAPID_PUBLIC_KEY").returns("public")
+    ENV.stubs(:[]).with("VAPID_PRIVATE_KEY").returns("private")
+    ENV.stubs(:fetch).with("VAPID_PUBLIC_KEY").returns("public")
+    ENV.stubs(:fetch).with("VAPID_PRIVATE_KEY").returns("private")
+    ENV.stubs(:fetch).with("MAILER_FROM_ADDRESS", "support@fizzy.do").returns("Fizzy <admin@example.com>")
+  end
+
+  test "send encrypted push with VAPID credentials" do
+    PushSubscription::Request.expects(:new).with(has_entries(
+      subscription: { endpoint: @subscription.endpoint, keys: { p256dh: "p256dh", auth: "auth" } },
+      message: { title: "A notification" }.to_json,
+      vapid: { public_key: "public", private_key: "private", subject: "mailto:admin@example.com" }
+    )).returns(mock(perform: true))
+    @subscription.push(title: "A notification")
+  end
+
+  test "expired subscriptions are removed" do
+    [ WebPush::ExpiredSubscription, WebPush::InvalidSubscription ].each do |error_class|
+      subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/#{error_class.name.demodulize}", p256dh_key: "key", auth_key: "auth")
+      PushSubscription::Request.expects(:new).raises(error_class.new(stub(body: "gone"), "push.example.com"))
+
+      assert_difference "PushSubscription.count", -1 do
+        subscription.push(title: "A notification")
+      end
+    end
+  end
+
+  test "transient failures retain subscriptions" do
+    PushSubscription::Request.expects(:new).raises(WebPush::PushServiceError.new(stub(body: "unavailable"), "push.example.com"))
+
+    assert_no_difference "PushSubscription.count" do
+      assert_raises(WebPush::PushServiceError) { @subscription.push(title: "A notification") }
+    end
+  end
+
+  test "no delivery when unconfigured or user inactive" do
+    PushSubscription::Request.expects(:new).never
+    PushSubscription.stubs(:configured?).returns(false)
+    @subscription.push(title: "A notification")
+
+    PushSubscription.stubs(:configured?).returns(true)
+    @subscription.user.update!(active: false)
+    @subscription.push(title: "A notification")
+  end
+
+  test "subscription belongs to user's account" do
+    assert_equal @subscription.user.account, @subscription.account
+  end
+end
