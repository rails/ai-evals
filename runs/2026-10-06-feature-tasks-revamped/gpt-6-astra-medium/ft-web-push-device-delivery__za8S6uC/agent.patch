new file mode 100644
index 0000000..e286917
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,31 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: :push_source_changed?
+  end
+
+  def push_later
+    if PushSubscription.configured?
+      user.push_subscriptions.find_each do |subscription|
+        Notification::PushJob.perform_later(self, subscription, push_payload)
+      end
+    end
+  end
+
+  def push_payload
+    helpers = ApplicationController.helpers
+
+    {
+      title: helpers.notification_title(self),
+      body: helpers.notification_body(self),
+      tag: "notification_#{id}",
+      data: { url: Rails.application.routes.url_helpers.polymorphic_path(notifiable_target, script_name: account.slug, only_path: true) }
+    }
+  end
+
+  private
+    def push_source_changed?
+      source_id_previously_changed? || source_type_previously_changed?
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..1f66131
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,37 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint
+  before_validation -> { self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s) }
+
+  def self.configured?
+    ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+  end
+
+  def push(payload)
+    if self.class.configured? && user.active?
+      Request.new(
+        subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        message: payload.to_json,
+        vapid: {
+          public_key: ENV.fetch("VAPID_PUBLIC_KEY"), private_key: ENV.fetch("VAPID_PRIVATE_KEY"),
+          subject: "mailto:#{Mail::Address.new(ENV.fetch("MAILER_FROM_ADDRESS", "support@fizzy.do")).address}"
+        }
+      ).perform
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy!
+  end
+
+  private
+    def validate_endpoint
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil? && uri.fragment.nil?
+        errors.add :endpoint, "must be an HTTPS URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "must be an HTTPS URL"
+    end
+end
diff --git a/app/models/push_subscription/request.rb b/app/models/push_subscription/request.rb
new file mode 100644
index 0000000..4a37825
--- /dev/null
+++ b/app/models/push_subscription/request.rb
@@ -0,0 +1,22 @@
+class PushSubscription::Request < WebPush::Request
+  class UnsafeEndpoint < StandardError; end
+
+  def perform
+    address = SsrfProtection.resolve_public_ip(uri.host)
+    raise UnsafeEndpoint unless address
+
+    # Pin the validated address while retaining the hostname for TLS and VAPID.
+    # Disable environment proxies so they cannot resolve a different address.
+    http = Net::HTTP.new(uri.host, uri.port, nil)
+    http.ipaddr = address
+    http.use_ssl = true
+    http.open_timeout = 5
+    http.read_timeout = 5
+
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+    response = http.request(request)
+    verify_response(response)
+    response
+  end
+end
