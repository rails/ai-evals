--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @notification = notifications(:logo_assignment_kevin)
+    @user = @notification.user
+    @subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.com/phone", p256dh_key: "key", auth_key: "auth")
+  end
+
+  test "new tray notification schedules a push for every device" do
+    @user.push_subscriptions.create!(endpoint: "https://push.example.com/desktop", p256dh_key: "key", auth_key: "auth")
+    users(:david).push_subscriptions.create!(endpoint: "https://push.example.com/another-user", p256dh_key: "key", auth_key: "auth")
+
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      @user.notifications.create!(source: events(:layout_published), creator: users(:david))
+    end
+  end
+
+  test "updating the tray source schedules another push but read state changes do not" do
+    assert_enqueued_jobs 1, only: Notification::PushJob do
+      @notification.update!(source: events(:logo_published))
+    end
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.read
+      @notification.unread
+    end
+  end
+
+  test "no push jobs without configured keys" do
+    PushSubscription.stubs(:configured?).returns(false)
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "event and mention payloads match the tray and link to their account's card" do
+    [ @notification, notifications(:layout_commented_kevin), notifications(:logo_mentioned_david) ].each do |notification|
+      payload = notification.push_payload
+      assert_equal ApplicationController.helpers.notification_title(notification), payload[:title]
+      assert_equal ApplicationController.helpers.notification_body(notification), payload[:body]
+      assert_includes payload[:data][:url], "#{notification.account.slug}/cards/#{notification.card.to_param}"
+    end
+    assert_includes notifications(:layout_commented_kevin).push_payload[:data][:url], "#comment_"
+    assert_equal "JZ @mentioned you", notifications(:logo_mentioned_david).push_payload[:title]
+  end
+
+  test "job delivers the captured payload" do
+    payload = @notification.push_payload
+    @subscription.expects(:push).with(payload)
+    Notification::PushJob.perform_now(@notification, @subscription, payload)
+  end
+
+  test "queued payloads preserve the tray message at enqueue time" do
+    original = @notification.push_payload
+    @notification.push_later
+    @notification.update!(source: events(:logo_published))
+
+    payloads = enqueued_jobs.select { |job| job[:job] == Notification::PushJob }.map { |job| job[:args].last }
+    assert_equal original[:body], payloads.first["body"]
+    assert_equal @notification.push_payload[:body], payloads.last["body"]
+  end
+
+  test "deleted notifications discard pending jobs" do
+    @notification.push_later
+    @notification.destroy!
+
+    PushSubscription::Request.expects(:new).never
+    assert_nothing_raised { perform_enqueued_jobs(only: Notification::PushJob) }
+  end
+
+  test "deleted subscriptions discard pending jobs" do
+    @notification.push_later
+    @subscription.destroy!
+
+    assert_nothing_raised { perform_enqueued_jobs(only: Notification::PushJob) }
+  end
+end
