+require "test_helper"
+
+class PushSubscription::RequestTest < ActiveSupport::TestCase
+  setup do
+    key = WebPush.generate_key
+    @request = PushSubscription::Request.new(
+      message: { title: "Hello", body: "A tray notification" }.to_json,
+      subscription: {
+        endpoint: "https://push.example.com/device",
+        keys: { p256dh: WebPush.generate_key.public_key, auth: Base64.urlsafe_encode64(SecureRandom.random_bytes(16)) }
+      },
+      vapid: { public_key: key.public_key, private_key: key.private_key, subject: "mailto:admin@example.com" }
+    )
+    SsrfProtection.stubs(:resolve_public_ip).with("push.example.com").returns("93.184.216.34")
+  end
+
+  test "sends an encrypted request with VAPID authentication" do
+    request = stub_request(:post, "https://push.example.com/device").with do |request|
+      assert_equal "aes128gcm", request.headers["Content-Encoding"]
+      assert_match /vapid t=/, request.headers["Authorization"]
+      refute_includes request.body, "A tray notification"
+      true
+    end.to_return(status: 201)
+
+    @request.perform
+    assert_requested request
+  end
+
+  test "rejects endpoints that do not resolve to a public address" do
+    SsrfProtection.stubs(:resolve_public_ip).returns(nil)
+    Net::HTTP.expects(:new).never
+
+    assert_raises(PushSubscription::Request::UnsafeEndpoint) { @request.perform }
+  end
+
+  test "pins the public address and disables proxies" do
+    response = Net::HTTPCreated.new("1.1", "201", "Created")
+    http = mock
+    Net::HTTP.expects(:new).with("push.example.com", 443, nil).returns(http)
+    http.expects(:ipaddr=).with("93.184.216.34")
+    http.expects(:use_ssl=).with(true)
+    http.expects(:open_timeout=).with(5)
+    http.expects(:read_timeout=).with(5)
+    http.expects(:request).returns(response)
+
+    assert_equal response, @request.perform
+  end
+
+  test "recognizes expired and invalid subscriptions" do
+    [ [ 404, WebPush::InvalidSubscription ], [ 410, WebPush::ExpiredSubscription ] ].each do |status, error|
+      stub_request(:post, "https://push.example.com/device").to_return(status: status, body: "Gone")
+      assert_raises(error) { @request.perform }
+    end
+  end
+end
