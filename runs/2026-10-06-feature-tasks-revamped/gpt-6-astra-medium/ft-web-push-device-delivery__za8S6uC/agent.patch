diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..b1c14b7
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,96 @@
+import { Controller } from "@hotwired/stimulus"
+import { get, post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "status", "help" ]
+  static values = { url: String, publicKey: String }
+
+  async connect() {
+    this.buttonTarget.disabled = true
+    if (!this.#supported) {
+      this.statusTarget.textContent = "This browser cannot receive push notifications."
+      this.helpTarget.hidden = false
+      return
+    }
+
+    try {
+      this.registration = await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+      this.registration = await navigator.serviceWorker.ready
+      const subscription = await this.registration.pushManager.getSubscription()
+      const response = await get(this.urlValue, { responseKind: "json" })
+      if (!response.ok) throw new Error("Could not load notification settings")
+
+      const subscriptions = await response.json
+      this.subscriptionId = subscriptions.find(record => record.endpoint === subscription?.endpoint)?.id
+      this.#render()
+    } catch {
+      this.statusTarget.textContent = "Could not load notification settings. Please reload and try again."
+    }
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+    this.statusTarget.textContent = ""
+
+    try {
+      if (this.subscriptionId) {
+        await this.#disable()
+      } else {
+        await this.#enable()
+      }
+    } catch {
+      this.statusTarget.textContent = "Could not update notification settings. Please try again."
+    } finally {
+      this.#render()
+    }
+  }
+
+  async #enable() {
+    // Ask in direct response to a click, as required by Safari and Firefox.
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") return
+
+    const subscription = await this.registration.pushManager.getSubscription() ||
+      await this.registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.urlValue, {
+      responseKind: "json",
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } }
+    })
+    if (!response.ok) throw new Error("Could not save subscription")
+
+    this.subscriptionId = (await response.json).id
+  }
+
+  async #disable() {
+    const response = await destroy(`${this.urlValue}/${this.subscriptionId}`)
+    if (!response.ok && response.statusCode !== 404) throw new Error("Could not remove subscription")
+
+    // The browser subscription can also serve other accounts on this origin.
+    // Remove only this user's registration, not the shared browser subscription.
+    this.subscriptionId = null
+  }
+
+  #render() {
+    const enabled = !!this.subscriptionId && Notification.permission === "granted"
+    this.element.classList.toggle("notifications--on", enabled)
+    this.buttonTarget.disabled = Notification.permission === "denied"
+    this.helpTarget.hidden = Notification.permission !== "denied"
+    if (Notification.permission === "denied") {
+      this.statusTarget.textContent = "Notifications are blocked. Follow the instructions below to allow them."
+    }
+  }
+
+  get #supported() {
+    return "Notification" in window && "PushManager" in window && "serviceWorker" in navigator
+  }
+
+  get #applicationServerKey() {
+    const key = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const paddedKey = key.padEnd(Math.ceil(key.length / 4) * 4, "=")
+    return Uint8Array.from(atob(paddedKey), character => character.charCodeAt(0))
+  }
+}
