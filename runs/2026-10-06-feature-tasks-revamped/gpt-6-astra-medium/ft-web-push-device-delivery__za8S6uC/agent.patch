--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,34 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def index
+    render json: @user.push_subscriptions.select(:id, :endpoint).as_json(only: [ :id, :endpoint ])
+  end
+
+  def create
+    attributes = params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    subscription = @user.push_subscriptions.create_or_find_by!(endpoint: attributes[:endpoint]) do |subscription|
+      subscription.assign_attributes(attributes)
+    end
+    subscription.update!(attributes)
+
+    render json: { id: subscription.id }, status: :created
+  rescue ActiveRecord::RecordInvalid => error
+    render json: { errors: error.record.errors.full_messages }, status: :unprocessable_entity
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+end
