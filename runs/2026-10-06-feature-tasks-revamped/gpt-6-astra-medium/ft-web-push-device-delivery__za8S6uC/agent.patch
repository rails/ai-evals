@@ -0,0 +1,8 @@
+class Notification::PushJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::PushServiceError, WebPush::TooManyRequests, Net::OpenTimeout, Net::ReadTimeout, wait: :polynomially_longer, attempts: 3
+
+  def perform(notification, subscription, payload)
+    subscription.push(payload) if subscription.user == notification.user
+  end
+end
