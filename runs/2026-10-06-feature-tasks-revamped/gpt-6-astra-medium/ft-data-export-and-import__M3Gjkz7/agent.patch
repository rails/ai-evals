+class DataTransferMailer < ApplicationMailer
+  def export_completed(export)
+    @export = export
+    @download_url = account_export_url(export.download_token, script_name: export.account.slug)
+    mail to: export.user.identity.email_address, subject: "Your Fizzy export is ready"
+  end
+
+  def import_completed(import)
+    @import = import
+    mail to: import.identity.email_address,
+      subject: import.status == "completed" ? "Your Fizzy account has been imported" : "Your Fizzy account import failed"
+  end
+end
