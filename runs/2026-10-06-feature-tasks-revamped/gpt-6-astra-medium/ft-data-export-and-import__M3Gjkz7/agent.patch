+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  def new
+  end
+
+  def create
+    file = params.expect(import: [ :file ])[:file]
+    if file.is_a?(ActionDispatch::Http::UploadedFile) && file.size.positive?
+      Current.without_account do
+        Account::Import.new(identity: Current.identity).upload(file)
+      end
+      redirect_to new_account_import_path(script_name: nil), notice: "Your account is being imported. We'll email you when it's finished."
+    else
+      flash.now[:alert] = "Choose a Fizzy account ZIP file to import."
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
