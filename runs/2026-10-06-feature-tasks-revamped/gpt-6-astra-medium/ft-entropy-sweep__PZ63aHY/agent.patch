diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..d98ecfd 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,80 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "due scope includes the cutoff but excludes more recent activity" do
+    freeze_time
+    board = boards(:writebook)
+    cutoff = board.auto_postpone_period.seconds.ago
+    cards(:logo).update!(last_active_at: cutoff)
+    cards(:layout).update!(last_active_at: cutoff + Rational(1, 1_000_000))
+    cards(:text).update!(last_active_at: cutoff - Rational(1, 1_000_000))
+
+    assert_equal cards(:logo, :text).to_set, board.cards.due_to_be_postponed(board.auto_postpone_period).to_set
+  end
+
+  test "auto postpone ignores closed postponed and drafted cards" do
+    closed, postponed, drafted = cards(:shipping, :layout, :unfinished_thoughts)
+    postponed.postpone
+    Card.update_all(last_active_at: 400.days.ago)
+    original_postponement = postponed.reload.not_now
+
+    Card.auto_postpone_all_due
+
+    assert closed.reload.closed?
+    assert_nil closed.not_now
+    assert_equal original_postponement, postponed.reload.not_now
+    assert drafted.reload.drafted?
+    assert_nil drafted.not_now
+  end
+
+  test "board periods override both shorter and longer account periods" do
+    entropies("37s_account").update!(auto_postpone_period: 30.days)
+    entropies(:writebook_board).update!(auto_postpone_period: 90.days)
+    entropies(:private_board).update!(auto_postpone_period: 7.days)
+    cards(:logo).update!(last_active_at: 31.days.ago)
+    cards(:layout).update!(board: boards(:private))
+    cards(:layout).update!(last_active_at: 8.days.ago)
+
+    Card.auto_postpone_all_due
+
+    assert_not cards(:logo).reload.postponed?
+    assert cards(:layout).reload.postponed?
+  end
+
+  test "account fallback works across accounts and repeated sweeps do not repeat events" do
+    Card.update_all(last_active_at: Time.current)
+    entropies(:writebook_board, :miltons_wish_list_board).each(&:destroy!)
+    entropies("37s_account").update!(auto_postpone_period: 7.days)
+    entropies(:initech_account).update!(auto_postpone_period: 30.days)
+    cards(:logo, :radio).each { |card| card.update!(last_active_at: 8.days.ago) }
+
+    assert_difference -> { Event.where(action: "card_auto_postponed").count }, 1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert_equal accounts("37s").system_user, cards(:logo).postponed_by
+    assert_not cards(:radio).reload.postponed?
+
+    cards(:radio).update!(last_active_at: 31.days.ago)
+    Card.auto_postpone_all_due
+    assert_equal accounts(:initech).system_user, cards(:radio).reload.postponed_by
+
+    assert_no_difference -> { Event.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postpone processes more than one batch of due cards" do
+    template = cards(:logo)
+    attributes = template.attributes.except("id")
+    Card.insert_all! 1001.times.map { |number|
+      attributes.merge("id" => ActiveRecord::Type::Uuid.generate, "number" => 10_000 + number, "last_active_at" => 400.days.ago)
+    }
+
+    Card.any_instance.expects(:auto_postpone).with(user: accounts("37s").system_user).times(1001)
+
+    Card.auto_postpone_all_due
+  end
 end
