+++ b/test/models/storage/usage_test.rb
@@ -0,0 +1,316 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+    @card = cards(:logo)
+    @board = @card.board
+    @account = @board.account
+  end
+
+  test "card images contribute to board and account usage in the background" do
+    attach_image
+    assert_equal 0, @board.bytes_used
+    drain_usage
+
+    assert_equal 14, @board.bytes_used
+    assert_equal 14, @account.bytes_used
+  end
+
+  test "counts only images and embeds in board descriptions card descriptions and comments" do
+    attach_image
+    embed(@board, :public_description, "board")
+    embed(@card, :description, "description")
+    embed(comments(:logo_1), :body, "comment")
+    users(:david).avatar.attach(blob("avatar"))
+    blob("unattached direct upload")
+    other_card = cards(:radio)
+    Current.set(account: other_card.account, user: other_card.creator) do
+      embed(other_card, :description, "other account")
+    end
+    drain_usage
+
+    assert_equal 14 + 5 + 11 + 7, @board.bytes_used
+    assert_equal @board.bytes_used, @account.bytes_used
+    assert_equal 13, other_card.board.bytes_used
+    assert_equal 13, other_card.account.bytes_used
+  end
+
+  test "generated previews and variants do not contribute usage" do
+    attach_image
+    file = @card.image.blob
+    file.preview_image.attach(blob("preview"))
+    variant = file.variant_records.create!(variation_digest: "variant-digest")
+    variant.image.attach(blob("variant"))
+    drain_usage
+    assert_equal 14, @board.bytes_used
+    assert_equal 14, @account.bytes_used
+    assert_equal 1, Storage::Usage.count
+  end
+
+  test "replacement and removal of rich text embeds" do
+    embed(@card, :description, "original")
+    drain_usage
+    assert_equal 8, @board.bytes_used
+
+    embed(@card, :description, "new")
+    drain_usage
+    assert_equal 3, @board.bytes_used
+
+    @card.update!(description: "no files")
+    drain_usage
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "replacing an image and purging it later releases its bytes" do
+    attach_image
+    drain_usage
+    @card.image.attach(blob("replacement"))
+    drain_usage
+    assert_equal 11, @board.bytes_used
+
+    @card.image.purge_later
+    drain_usage
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "purging synchronously releases bytes" do
+    attach_image
+    drain_usage
+    @card.image.purge
+    drain_usage
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "detaching before reconciliation does not produce negative usage" do
+    attach_image
+    @card.image.detach
+    drain_usage
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, Storage::Usage.count
+  end
+
+  test "card moves include images description and comments even with pending adjustments" do
+    attach_image
+    embed(@card, :description, "description")
+    embed(comments(:logo_1), :body, "comment")
+    embed(@board, :public_description, "board")
+    drain_usage
+    embed(comments(:logo_3), :body, "pending")
