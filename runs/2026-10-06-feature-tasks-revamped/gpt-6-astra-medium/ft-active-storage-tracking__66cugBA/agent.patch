diff --git a/app/jobs/storage/backfill_job.rb b/app/jobs/storage/backfill_job.rb
new file mode 100644
index 0000000..6d9379a
--- /dev/null
+++ b/app/jobs/storage/backfill_job.rb
@@ -0,0 +1,12 @@
+# Run once after deploying storage accounting, and after bulk imports which
+# bypass Active Record callbacks. A cursor keeps every job bounded in size.
+class Storage::BackfillJob < ApplicationJob
+  retry_on ActiveRecord::Deadlocked
+  retry_on ActiveRecord::LockWaitTimeout
+  retry_on ActiveRecord::StatementTimeout
+
+  def perform(after_id = nil, account_id: nil)
+    next_id = Storage::Usage.backfill(after_id: after_id, account_id: account_id)
+    self.class.perform_later(next_id, account_id: account_id) if next_id
+  end
+end
