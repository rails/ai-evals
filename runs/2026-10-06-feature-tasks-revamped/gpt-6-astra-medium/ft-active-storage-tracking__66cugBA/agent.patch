+  test "imports rebuild rather than copy cached storage counters" do
+    attach_image
+    embed(@board, :public_description, "board")
+    embed(@card, :description, "description")
+    embed(comments(:logo_1), :body, "comment")
+    drain_usage
+    expected_bytes = @account.bytes_used
+    identity = Current.user.identity
+
+    export = Account::Export.create!(account: @account, user: Current.user)
+    export.build
+    export.file.open do |file|
+      archive = File.binread(file.path)
+      @account.destroy!
+      ActiveStorage::Blob.where(account: @account).find_each(&:purge)
+      assert_empty Storage::Usage.all
+      target = Account.create_with_owner(account: { name: "Imported" }, owner: { identity: identity, name: "Owner" })
+      Current.set(account: target, user: target.users.find_by!(identity: identity)) do
+        import = Account::Import.create!(account: target, identity: identity)
+        import.file.attach(io: StringIO.new(archive), filename: "export.zip", content_type: "application/zip")
+        import.check
+        assert_enqueued_with(job: Storage::BackfillJob, args: [ { account_id: target.id } ]) { import.process }
+        assert_equal 0, target.bytes_used
+        perform_enqueued_jobs(only: Storage::BackfillJob)
+        drain_usage
+        assert_equal expected_bytes, target.bytes_used
+      end
+    end
+  end
+
+  test "usage readers only query cached counters" do
+    attach_image
+    drain_usage
+    ActiveStorage::Attachment.stubs(:all).raises("must not scan attachments")
+    ActiveStorage::Blob.stubs(:all).raises("must not scan blobs")
+    assert_equal 14, @board.bytes_used
+    assert_equal 14, @account.bytes_used
+  end
+
+  private
+    def attach_image
+      @card.image.attach(blob("image contents"))
+    end
+
+    def blob(contents)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new(contents), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def embed(record, name, contents)
+      record.update!(name => ActionText::Content.new(ActionText::Attachment.from_attachable(blob(contents)).to_html))
+    end
+
+    def drain_usage
+      Storage::ReconcileJob.perform_now(Storage::Usage.pending.pluck(:id))
+    end
+end
