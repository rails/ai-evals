+  test "dispatcher splits large queues into bounded jobs" do
+    file = blob("shared")
+    (Storage::Usage::BATCH_SIZE + 1).times do |index|
+      Storage::Usage.create!(attachment_id: ActiveRecord::Type::Uuid.generate, owner: @card, bytes: file.byte_size)
+    end
+
+    assert_enqueued_jobs 2, only: Storage::ReconcileJob do
+      Storage::Usage.dispatch_pending
+    end
+    jobs = enqueued_jobs.select { |job| job[:job] == Storage::ReconcileJob }
+    assert jobs.all? { |job| job[:args].first.size <= Storage::Usage::BATCH_SIZE }
+    perform_enqueued_jobs(only: Storage::ReconcileJob)
+    assert_equal (Storage::Usage::BATCH_SIZE + 1) * file.byte_size, @board.bytes_used
+  end
