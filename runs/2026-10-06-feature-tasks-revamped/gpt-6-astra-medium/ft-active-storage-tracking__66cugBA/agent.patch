--- /dev/null
+++ b/app/models/storage/attachment_tracking.rb
@@ -0,0 +1,32 @@
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    # These writes belong to the attachment transaction, not after_commit: a
+    # crash or rollback must not lose an adjustment. No jobs run in the request.
+    after_create :track_storage_usage
+    before_destroy :release_storage_usage
+  end
+
+  # Active Storage's purge methods call delete rather than destroy.
+  def delete
+    transaction do
+      release_storage_usage
+      super
+    end
+  end
+
+  private
+    def track_storage_usage
+      Storage::Usage.track(self)
+    end
+
+    def release_storage_usage
+      # Match the backfill's lock order, including attachments not tracked yet.
+      self.class.lock.find_by(id: id)
+
+      if usage = Storage::Usage.lock.find_by(attachment_id: id)
+        usage.update!(bytes: nil, pending: true)
+      end
+    end
+end
