@@ -0,0 +1,11 @@
+class Storage::ReconcileJob < ApplicationJob
+  retry_on ActiveRecord::Deadlocked
+  retry_on ActiveRecord::LockWaitTimeout
+  retry_on ActiveRecord::StatementTimeout
+
+  def perform(usage_ids)
+    usage_ids.each do |id|
+      Storage::Usage.find_by(id: id)&.reconcile
+    end
+  end
+end
