diff --git a/app/models/storage/usage.rb b/app/models/storage/usage.rb
new file mode 100644
index 0000000..21bdb90
--- /dev/null
+++ b/app/models/storage/usage.rb
@@ -0,0 +1,81 @@
+# A durable, idempotent work item for an attachment. Keep the last accounted size
+# so that retries and backfills can never apply the same bytes twice. A nil
+# desired size marks a removed attachment; zero is a legitimate file size.
+class Storage::Usage < ApplicationRecord
+  BATCH_SIZE = 100
+
+  belongs_to :owner, polymorphic: true
+
+  scope :pending, -> { where(pending: true) }
+
+  class << self
+    def dispatch_pending
+      pending.in_batches(of: BATCH_SIZE) do |batch|
+        Storage::ReconcileJob.perform_later(batch.pluck(:id))
+      end
+    end
+
+    def backfill(after_id: nil, account_id: nil)
+      attachments = ActiveStorage::Attachment.order(:id)
+      attachments = attachments.where(account_id: account_id) if account_id
+      attachments = attachments.where(attachments.arel_table[:id].gt(after_id)) if after_id
+      ids = attachments.limit(BATCH_SIZE).pluck(:id)
+
+      ids.each do |id|
+        ActiveStorage::Attachment.transaction do
+          # Serialize with deletion so backfill cannot resurrect a removed file.
+          if attachment = ActiveStorage::Attachment.lock.find_by(id: id)
+            track(attachment)
+          end
+        end
+      end
+
+      ids.last if ids.size == BATCH_SIZE
+    end
+
+    def track(attachment)
+      if owner = owner_for(attachment)
+        create_or_find_by!(attachment_id: attachment.id) do |usage|
+          usage.owner = owner
+          usage.bytes = attachment.blob.byte_size
+        end
+      end
+    end
+
+    def owner_for(attachment)
+      case record = attachment.record
+      when Card
+        record if attachment.name == "image"
+      when ActionText::RichText
+        if attachment.name == "embeds"
+          case parent = record.record
+          when Board
+            parent if record.name == "public_description"
+          when Card
+            parent if record.name == "description"
+          when Comment
+            parent.card if record.name == "body"
+          end
+        end
+      end
+    end
+  end
+
+  def reconcile
+    with_lock do
+      if pending?
+        # Atomic increments only contend with work on the same card (or board
+        # description), never with every upload in the account.
+        owner_type.constantize.where(id: owner_id).update_counters(storage_bytes: bytes.to_i - accounted_bytes)
+
+        if bytes.nil?
+          destroy!
+        else
+          update!(accounted_bytes: bytes, pending: false)
+        end
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    # Another worker or the owner's destruction already removed this work item.
+  end
+end
