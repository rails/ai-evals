--- /dev/null
+++ b/app/controllers/sessions/email_codes_controller.rb
@@ -0,0 +1,92 @@
+class Sessions::EmailCodesController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+  before_action :set_email_code
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if identity = @email_code.consume(params.expect(:code))
+      session.delete(:email_authentication)
+      start_new_session_for identity
+      destination = authentication_destination(identity)
+
+      unless performed?
+        respond_to do |format|
+          format.html { redirect_to destination }
+          format.json { render json: { session_token: session_token } }
+        end
+      end
+    else
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = "That code didn’t work. Try again or request a new code."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: "That code didn’t work." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def set_email_code
+      @authentication = session[:email_authentication]
+      @email_code = EmailCode.find_by(id: @authentication&.dig("email_code_id"))
+
+      if @email_code
+        @start_over_url = start_over_url
+      else
+        redirect_to new_session_url, alert: "Enter your email to get a new code."
+      end
+    end
+
+    def start_over_url
+      case @authentication["purpose"]
+      when "sign_up"
+        new_signup_url
+      when "join"
+        account = Account.find_by(id: @authentication["account_id"])
+        join_url(code: @authentication["join_code"], script_name: account&.slug)
+      else
+        new_session_url
+      end
+    end
+
+    def authentication_destination(identity)
+      case @authentication["purpose"]
+      when "sign_up"
+        new_signup_completion_url
+      when "join"
+        complete_join(identity)
+      else
+        after_authentication_url
+      end
+    end
+
+    def complete_join(identity)
+      @join_code = Account::JoinCode.find_by(code: @authentication["join_code"], account_id: @authentication["account_id"])
+
+      if @join_code
+        @join_code.with_lock do
+          if @join_code.active?
+            @join_code.redeem_if { |account| identity.join(account) }
+            user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+            if user.setup?
+              landing_url(script_name: @join_code.account.slug)
+            else
+              new_users_verification_url(script_name: @join_code.account.slug)
+            end
+          else
+            render "join_codes/inactive", status: :gone
+          end
+        end
+      else
+        head :not_found
+      end
+    end
+end
