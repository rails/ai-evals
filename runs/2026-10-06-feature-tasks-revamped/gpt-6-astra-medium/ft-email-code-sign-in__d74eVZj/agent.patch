diff --git a/test/integration/email_code_authentication_test.rb b/test/integration/email_code_authentication_test.rb
new file mode 100644
index 0000000..98ed590
--- /dev/null
+++ b/test/integration/email_code_authentication_test.rb
@@ -0,0 +1,307 @@
+require "test_helper"
+
+class EmailCodeAuthenticationTest < ActionDispatch::IntegrationTest
+  test "sign in with the code from the email subject" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+
+      assert_not cookies[:session_token].present?
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code][autocomplete=one-time-code]"
+
+      assert_difference -> { identities(:kevin).sessions.count }, 1 do
+        post session_email_code_path, params: { code: code }
+      end
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "signing up verifies the email before completing an account" do
+    Account.any_instance.expects(:setup_customer_template).once
+
+    untenanted do
+      assert_no_difference -> { Account.count } do
+        @code = request_code { post signup_path, params: { signup: { email_address: "new@example.com" } } }
+      end
+      assert_not cookies[:session_token].present?
+      follow_redirect!
+      assert_select "a[href=?]", new_signup_url, text: "Start over"
+
+      post session_email_code_path, params: { code: @code }
+      assert_redirected_to new_signup_completion_url
+      follow_redirect!
+      assert_response :success
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+      identity = Identity.find_by!(email_address: "new@example.com")
+      assert_equal "New Person", identity.users.sole.name
+      assert_redirected_to landing_url(script_name: identity.accounts.sole.slug)
+    end
+  end
+
+  test "signing up with an existing email does not duplicate the identity" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        code = request_code { post signup_path, params: { signup: { email_address: identities(:kevin).email_address } } }
+        post session_email_code_path, params: { code: code }
+        assert_redirected_to new_signup_completion_url
+      end
+    end
+  end
+
+  test "joining creates membership only after email verification" do
+    join_code = account_join_codes(:"37s")
+    assert_no_difference -> { User.count } do
+      @code = request_code do
+        post join_path(code: join_code.code), params: { email_address: "joiner@example.com" }
+      end
+    end
+    assert_equal 0, join_code.reload.usage_count
+    assert_not cookies[:session_token].present?
+
+    untenanted do
+      follow_redirect!
+      assert_response :success
+      assert_select "a[href=?]", join_url(code: join_code.code, script_name: join_code.account.slug), text: "Start over"
+
+      assert_difference -> { User.count }, 1 do
+        post session_email_code_path, params: { code: @code }
+      end
+      assert_redirected_to new_users_verification_url(script_name: join_code.account.slug)
+    end
+    assert_equal 1, join_code.reload.usage_count
+
+    follow_redirect!
+    assert_response :success
+    post users_verifications_path
+    assert_redirected_to new_users_join_path
+    post users_joins_path, params: { user: { name: "New Joiner" } }
+    assert_redirected_to landing_path
+    assert_equal "New Joiner", Identity.find_by!(email_address: "joiner@example.com").users.sole.name
+  end
+
+  test "joining as an existing member signs in without using the join code again" do
+    join_code = account_join_codes(:"37s")
+    code = request_code do
+      post join_path(code: join_code.code), params: { email_address: identities(:jz).email_address }
+    end
+
+    untenanted do
+      assert_no_difference [ -> { User.count }, -> { join_code.reload.usage_count } ] do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to landing_url(script_name: join_code.account.slug)
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "an exhausted join code cannot grant membership after email verification" do
+    join_code = account_join_codes(:"37s")
+    code = request_code { post join_path(code: join_code.code), params: { email_address: "late@example.com" } }
+    join_code.update!(usage_count: join_code.usage_limit)
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_response :gone
+    end
+  end
+
+  test "a reset join code cannot grant membership after email verification" do
+    join_code = account_join_codes(:"37s")
+    code = request_code { post join_path(code: join_code.code), params: { email_address: "late@example.com" } }
+    join_code.reset
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_response :not_found
+    end
+  end
+
+  test "a wrong code allows retrying with the right code" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "WRONG!" }
+      end
+      assert_response :unprocessable_entity
+      assert_select "input[name=code]"
+
+      post session_email_code_path, params: { code: " #{code.downcase} " }
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "codes expire after fifteen minutes" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      travel_to EmailCode.last.expires_at, with_usec: true do
+        assert_no_difference -> { Session.count } do
+          post session_email_code_path, params: { code: code }
+        end
+        assert_response :unprocessable_entity
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "codes are single use" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      pending_session = cookies.to_hash
+      post session_email_code_path, params: { code: code }
+      assert cookies[:session_token].present?
+
+      cookies.to_hash.each_key { |name| cookies.delete(name) }
+      pending_session.each { |name, value| cookies[name] = value }
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to new_session_url
+    end
+  end
+
+  test "a code cannot be used from another browser" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      open_session do |other_browser|
+        other_browser.post session_email_code_path, params: { code: code }
+        other_browser.assert_redirected_to new_session_url
+        assert_not other_browser.cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "requesting another code replaces the pending code" do
+    untenanted do
+      old_code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      new_code = request_code { post session_path, params: { email_address: identities(:jz).email_address } }
+      post session_email_code_path, params: { code: old_code }
+      assert_response :unprocessable_entity
+
+      assert_difference -> { identities(:jz).sessions.count }, 1 do
+        post session_email_code_path, params: { code: new_code }
+      end
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "sign in accepts normalized email addresses and returns a JSON session token" do
+    untenanted do
+      code = request_code do
+        post session_path, params: { email_address: " #{identities(:kevin).email_address.upcase} " }, as: :json
+      end
+      assert_response :created
+
+      post session_email_code_path, params: { code: "WRONG!" }, as: :json
+      assert_response :unauthorized
+      post session_email_code_path, params: { code: code }, as: :json
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body["session_token"]
+    end
+  end
+
+  test "joining via JSON creates membership after verification" do
+    join_code = account_join_codes(:"37s")
+    code = request_code do
+      post join_path(code: join_code.code), params: { email_address: "json@example.com" }, as: :json
+    end
+    assert_response :created
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        post session_email_code_path, params: { code: code }, as: :json
+      end
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "sign in returns to the originally requested page" do
+    destination = cards_url
+    get destination
+
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      post session_email_code_path, params: { code: code }
+      assert_redirected_to destination
+    end
+  end
+
+  test "unknown email addresses do not create identities during sign in" do
+    untenanted do
+      assert_no_difference [ -> { Identity.count }, -> { EmailCode.count } ] do
+        post session_path, params: { email_address: "unknown@example.com" }
+      end
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "verification is rate limited" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      Rails.cache.stubs(:increment).returns(11)
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_response :too_many_requests
+    end
+  end
+
+  test "verification cannot substitute another identity" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+
+      assert_no_difference -> { identities(:jz).sessions.count } do
+        assert_difference -> { identities(:kevin).sessions.count }, 1 do
+          post session_email_code_path, params: { code: code, email_address: identities(:jz).email_address }
+        end
+      end
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "join codes cannot be redeemed under another account" do
+    join_code = account_join_codes(:"37s")
+    other_account = Account.where.not(id: join_code.account_id).first!
+
+    assert_no_difference [ -> { Identity.count }, -> { EmailCode.count }, -> { User.count } ] do
+      post join_path(code: join_code.code, script_name: other_account.slug), params: { email_address: "other@example.com" }
+    end
+    assert_response :not_found
+  end
+
+  test "verification requires a pending code request" do
+    untenanted do
+      get new_session_email_code_path
+      assert_redirected_to new_session_url
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "ABC123" }
+      end
+      assert_redirected_to new_session_url
+    end
+  end
+
+  private
+
+
+    def request_code
+      assert_emails 1 do
+        perform_enqueued_jobs(only: ActionMailer::MailDeliveryJob) { yield }
+      end
+
+      ActionMailer::Base.deliveries.last.subject.match(/\b[A-Z0-9]{6}\b/).to_s.tap do |code|
+        assert_equal 6, code.length, "The email subject should contain a six-character code"
+      end
+    end
+end
