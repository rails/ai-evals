diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..15cb5a7
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @code = "A1B2C3"
+    @email_code = EmailCode.create!(identity: identities(:kevin),
+      code_digest: Digest::SHA256.hexdigest(@code), expires_at: 15.minutes.from_now)
+  end
+
+  test "delivers a six-character code and stores only its digest" do
+    freeze_time do
+      assert_enqueued_email_with EmailCodeMailer, :sign_in, args: ->(args) {
+        args.first == identities(:kevin) && args.last.match?(/\A[A-Z0-9]{6}\z/)
+      } do
+        email_code = EmailCode.deliver_to(identities(:kevin))
+        assert_equal 15.minutes.from_now, email_code.expires_at
+        assert_equal 64, email_code.code_digest.length
+      end
+    end
+  end
+
+  test "consuming a valid code returns its identity and deletes the code" do
+    assert_equal identities(:kevin), @email_code.consume(@code)
+    assert_not EmailCode.exists?(@email_code.id)
+    assert_nil @email_code.consume(@code)
+  end
+
+  test "codes work immediately before expiry" do
+    travel_to @email_code.expires_at - 1.second, with_usec: true do
+      assert_equal identities(:kevin), @email_code.consume(@code)
+    end
+  end
+
+  test "codes stop working at exactly fifteen minutes" do
+    travel_to @email_code.expires_at, with_usec: true do
+      assert_nil @email_code.consume(@code)
+    end
+  end
+
+  test "expired codes do not authenticate" do
+    travel 16.minutes do
+      assert_nil @email_code.consume(@code)
+    end
+  end
+
+  test "codes tolerate surrounding whitespace and lowercase letters" do
+    assert_equal identities(:kevin), @email_code.consume(" a1b2c3 ")
+  end
+
+  test "incorrect and blank codes do not authenticate" do
+    [ "", nil, "ABC123", "A1B2C3extra" ].each do |code|
+      assert_nil @email_code.consume(code)
+    end
+    assert_equal 4, @email_code.reload.attempts
+    assert_equal identities(:kevin), @email_code.consume(@code)
+  end
+
+  test "ten incorrect attempts invalidate the code" do
+    10.times { assert_nil @email_code.consume("WRONG!") }
+    assert_nil @email_code.consume(@code)
+    assert_equal 10, @email_code.reload.attempts
+  end
+
+  test "destroying an identity destroys its email codes" do
+    @email_code.identity.destroy!
+    assert_not EmailCode.exists?(@email_code.id)
+  end
+end
