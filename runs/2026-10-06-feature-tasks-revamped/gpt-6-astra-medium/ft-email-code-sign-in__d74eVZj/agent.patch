+module Authentication::ByEmail
+  private
+
+  def request_email_code(identity, purpose: :sign_in, join_code: nil)
+    EmailCode.find_by(id: session.dig(:email_authentication, "email_code_id"))&.destroy!
+    email_code = EmailCode.deliver_to(identity)
+
+    session[:email_authentication] = {
+      email_code_id: email_code.id,
+      purpose: purpose,
+      join_code: join_code&.code,
+      account_id: join_code&.account_id
+    }
+
+    respond_to do |format|
+      format.html { redirect_to new_session_email_code_url(script_name: nil) }
+      format.json { head :created }
+    end
+  end
+end
