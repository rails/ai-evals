diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..c58a207
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,32 @@
+class EmailCode < ApplicationRecord
+  EXPIRATION = 15.minutes
+  MAX_ATTEMPTS = 10
+
+  belongs_to :identity
+
+  def self.deliver_to(identity)
+    code = SecureRandom.alphanumeric(6).upcase
+
+    create!(identity: identity, code_digest: Digest::SHA256.hexdigest(code), expires_at: EXPIRATION.from_now).tap do
+      EmailCodeMailer.sign_in(identity, code).deliver_later
+    end
+  end
+
+  def consume(code)
+    return unless persisted?
+
+    with_lock do
+      if expires_at > Time.current && attempts < MAX_ATTEMPTS
+        if ActiveSupport::SecurityUtils.secure_compare(code_digest, Digest::SHA256.hexdigest(code.to_s.strip.upcase))
+          destroy!
+          identity
+        else
+          increment! :attempts
+          nil
+        end
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    nil
+  end
+end
