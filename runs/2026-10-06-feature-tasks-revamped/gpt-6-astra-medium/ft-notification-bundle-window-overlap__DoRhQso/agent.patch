@@ -0,0 +1,20 @@
+module Notification::Bundlable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :bundle_items, class_name: "Notification::Bundle::Item", dependent: :delete_all
+    has_many :bundles, through: :bundle_items
+
+    after_save_commit :bundle_later, if: :source_id_previously_changed?
+  end
+
+  def bundle_later
+    if user.settings&.bundle_email_interval
+      Notification::BundleJob.perform_later(self, updated_at)
+    end
+  end
+
+  def bundle(at: updated_at)
+    Notification::Bundle.add(self, at: at)
+  end
+end
diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..69a5434
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,63 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :items, class_name: "Notification::Bundle::Item", dependent: :delete_all
+  has_many :notifications, through: :items
+
+  scope :pending, -> { where(delivered_at: nil) }
+  scope :chronologically, -> { order(:starts_at) }
+
+  validates :starts_at, :ends_at, presence: true
+  validates :ends_at, comparison: { greater_than: :starts_at }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add(notification, at: notification.updated_at)
+      user = notification.user
+
+      # Lock the user, not the bundle: there may not be a bundle to lock yet.
+      user.with_lock do
+        if user.active? && user.account.active? && !notification.creator.system? && (interval = user.settings&.reload&.bundle_email_interval)
+          bundles = user.notification_bundles
+
+          # No lower bound: out-of-order arrivals also belong to an opened window.
+          bundle = bundles.pending.where("ends_at > ?", at).chronologically.first
+          bundle ||= open_window(bundles, at, interval)
+          bundle.items.find_or_create_by!(notification: notification)
+          bundle
+        end
+      end
+    end
+
+    private
+      def open_window(bundles, at, interval)
+        if previous = bundles.chronologically.last
+          # Never backfill a window that could overlap an existing one. When an
+          # old arrival's window has already been mailed, start a fresh one now.
+          at = [ at, Time.current ].max if previous.delivered_at? && at < previous.ends_at
+          at = [ at, previous.ends_at ].max
+        end
+
+        bundles.create!(starts_at: at, ends_at: at + interval)
+      end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver
+    user.with_lock do
+      reload
+
+      if delivered_at.nil? && ends_at <= Time.current
+        if user.active? && account.active? && user.identity && user.settings&.reload&.bundle_email_interval && notifications.exists?
+          NotificationMailer.bundle(self).deliver_now
+        end
+
+        update!(delivered_at: Time.current)
+      end
+    end
+  end
+end
