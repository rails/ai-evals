+
+  setup do
+    freeze_time
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    @notification = notifications(:logo_assignment_kevin)
+    @bundle = Notification::Bundle.add(@notification, at: Time.current)
+    Notification::Bundle.add(notifications(:layout_commented_kevin), at: @bundle.starts_at)
+  end
+
+  test "one email contains all the notifications and account-scoped links" do
+    travel_to @bundle.ends_at do
+      assert_emails 1 do
+        perform_enqueued_jobs(only: Notification::Bundle::DeliverJob)
+      end
+
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ @user.identity.email_address ], email.to
+      assert_includes email.html_part.decoded, ERB::Util.html_escape(@notification.payload.title)
+      assert_includes email.text_part.decoded, notifications(:layout_commented_kevin).payload.title
+      assert_includes email.html_part.decoded, @notification.payload.url
+      assert_includes email.html_part.decoded, "#{@user.account.slug}/notifications/settings"
+      assert @bundle.reload.delivered_at?
+
+      assert_no_emails { @bundle.deliver }
+    end
+  end
+
+  test "a window is not delivered early" do
+    assert_no_emails { @bundle.deliver }
+    assert_nil @bundle.reload.delivered_at
+  end
+
+  test "off suppresses already queued digests" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    travel_to @bundle.ends_at do
+      assert_no_emails { @bundle.deliver }
+      assert @bundle.reload.delivered_at?
+    end
+  end
+
+  test "inactive users do not receive digests" do
+    @user.deactivate
+
+    travel_to @bundle.ends_at do
+      assert_no_emails { @bundle.deliver }
+    end
+  end
+
+  test "empty bundles do not send mail" do
+    @bundle.notifications.destroy_all
+
+    travel_to @bundle.ends_at do
+      assert_no_emails { @bundle.deliver }
+    end
+  end
+
+  test "delivery failures leave the bundle pending" do
+    message = mock
+    NotificationMailer.expects(:bundle).with(@bundle).returns(message)
+    message.expects(:deliver_now).raises(IOError)
+
+    travel_to @bundle.ends_at do
+      assert_raises(IOError) { @bundle.deliver }
+      assert_nil @bundle.reload.delivered_at
+    end
+  end
+
+  test "a late arrival after delivery cannot overlap the delivered window" do
+    travel_to @bundle.ends_at + 1.hour do
+      @bundle.deliver
+      next_bundle = Notification::Bundle.add(@notification, at: @bundle.starts_at - 1.hour)
+
+      assert_not_equal @bundle, next_bundle
+      assert_equal Time.current, next_bundle.starts_at
+      assert_operator next_bundle.starts_at, :>=, @bundle.ends_at
+    end
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..6ecb267
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    @user = @notification.user
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "off does not create a bundle" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_nil Notification::Bundle.add(@notification)
+    end
+  end
+
+  test "the first notification anchors a window for each frequency" do
+    { every_few_hours: 4.hours, daily: 24.hours, weekly: 7.days }.each do |frequency, duration|
+      @user.notification_bundles.destroy_all
+      @user.settings.update!(bundle_email_frequency: frequency)
+      time = Time.utc(2026, 1, 1, 10, 17)
+
+      bundle = Notification::Bundle.add(@notification, at: time)
+
+      assert_equal time, bundle.starts_at
+      assert_equal time + duration, bundle.ends_at
+      assert_equal [ @notification ], bundle.notifications
+    end
+  end
+
+  test "notifications within a window share one bundle and one delivery job" do
+    freeze_time do
+      assert_enqueued_jobs 1, only: Notification::Bundle::DeliverJob do
+        bundle = Notification::Bundle.add(@notification, at: Time.current)
+        other = notifications(:layout_commented_kevin)
+
+        assert_equal bundle, Notification::Bundle.add(other, at: 3.hours.from_now)
+        assert_equal bundle, Notification::Bundle.add(@notification, at: Time.current)
+        assert_equal 2, bundle.notifications.count
+      end
+    end
+  end
+
+  test "the deadline belongs to the next non-overlapping window" do
+    first = Notification::Bundle.add(@notification)
+    second = Notification::Bundle.add(@notification, at: first.ends_at)
+
+    assert_not_equal first, second
+    assert_equal first.ends_at, second.starts_at
+  end
+
+  test "late notifications join an already opened window even before its start" do
+    freeze_time do
+      first = Notification::Bundle.add(@notification, at: Time.current)
+      second = Notification::Bundle.add(@notification, at: first.ends_at + 1.hour)
+
+      assert_equal first, Notification::Bundle.add(@notification, at: 2.hours.ago)
+      assert_equal second, Notification::Bundle.add(@notification, at: first.ends_at + 30.minutes)
+      assert_equal 2, @user.notification_bundles.count
+    end
+  end
+
+  test "changing frequency does not resize an existing window" do
+    first = Notification::Bundle.add(@notification)
+    @user.settings.update!(bundle_email_frequency: "weekly")
+
+    assert_equal first, Notification::Bundle.add(@notification, at: first.starts_at + 1.hour)
+    second = Notification::Bundle.add(@notification, at: first.ends_at)
+
+    assert_equal 4.hours, first.ends_at - first.starts_at
+    assert_equal 7.days, second.ends_at - second.starts_at
+  end
+
+  test "windows belong to individual users" do
+    other = notifications(:logo_mentioned_david)
+    other.user.settings.update!(bundle_email_frequency: "daily")
+    first = Notification::Bundle.add(@notification)
+    second = Notification::Bundle.add(other, at: first.starts_at)
+
+    assert_not_equal first, second
+    assert_equal other.user, second.user
+  end
+  test "a gap before a later window does not create an overlapping backfill" do
+    freeze_time do
+      first = Notification::Bundle.add(@notification, at: Time.current)
+      second = Notification::Bundle.add(@notification, at: first.ends_at + 2.hours)
+      third = Notification::Bundle.add(@notification, at: second.ends_at + 1.hour)
+
+      [ first.starts_at - 1.day, first.ends_at, second.starts_at - 1.second,
+        second.ends_at, third.starts_at - 1.hour ].each do |at|
+        assert_no_difference "Notification::Bundle.count" do
+          Notification::Bundle.add(@notification, at: at)
+        end
+      end
+
+      @user.notification_bundles.chronologically.each_cons(2) do |earlier, later|
+        assert_operator earlier.ends_at, :<=, later.starts_at
+      end
+    end
+  end
+
+  test "late notifications bypass a delivered window and join the pending one" do
+    freeze_time do
+      first = Notification::Bundle.add(@notification, at: Time.current)
+      second = Notification::Bundle.add(@notification, at: first.ends_at)
+      first.update!(delivered_at: first.ends_at)
+
+      assert_no_difference "Notification::Bundle.count" do
+        assert_equal second, Notification::Bundle.add(@notification, at: first.starts_at - 1.hour)
+      end
+    end
+  end
+end
