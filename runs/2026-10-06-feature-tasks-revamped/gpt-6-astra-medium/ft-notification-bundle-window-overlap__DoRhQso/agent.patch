index 0000000..14ebc29
--- /dev/null
+++ b/test/models/notification/bundlable_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Notification::BundlableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "creating a notification enqueues bundling with its arrival time" do
+    freeze_time do
+      assert_enqueued_with(job: Notification::BundleJob, args: ->(args) { args.last == Time.current }) do
+        @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+      end
+    end
+  end
+
+  test "new activity on an existing notification is bundled" do
+    assert_enqueued_with(job: Notification::BundleJob) do
+      @notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "reading and unreading do not enqueue emails" do
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      @notification.read
+      @notification.unread
+    end
+  end
+
+  test "off does not enqueue bundling" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      @notification.bundle_later
+    end
+  end
+
+  test "bundling job preserves the arrival time despite processing delay" do
+    freeze_time do
+      at = Time.current
+      @notification.bundle_later
+
+      travel 2.hours
+      Notification::BundleJob.perform_now(@notification, at)
+      assert_equal at, @user.notification_bundles.sole.starts_at
+    end
+  end
+  test "off is checked again when a queued job runs" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference "Notification::Bundle.count" do
+      Notification::BundleJob.perform_now(@notification, Time.current)
+    end
+  end
+end
diff --git a/test/models/notification/bundle_concurrency_test.rb b/test/models/notification/bundle_concurrency_test.rb
new file mode 100644
index 0000000..605d212
--- /dev/null
+++ b/test/models/notification/bundle_concurrency_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  setup do
+    @user = users(:kevin).account.users.create!(name: "Digest concurrency test")
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @notifications = [ events(:layout_commented), events(:logo_published) ].map do |source|
+      @user.notifications.create!(source: source, creator: users(:david))
+    end
+  end
+
+  teardown do
+    @user&.destroy!
+  end
+
+  test "simultaneous first arrivals create one window" do
+    ready = Queue.new
+    start = Queue.new
+    at = Time.current
+    notification_ids = @notifications.map(&:id)
+
+    threads = notification_ids.map do |notification_id|
+      Thread.new do
+        ActiveRecord::Base.connection_pool.with_connection do
+          notification = Notification.find(notification_id)
+          notification.user
+          ready << true
+          start.pop
+          Current.with_account(notification.account) do
+            Notification::Bundle.add(notification, at: at).id
+          end
+        end
+      end
+    end
+
+    2.times { ready.pop }
+    2.times { start << true }
+
+    assert_equal 1, threads.map(&:value).uniq.size
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 2, @user.notification_bundles.sole.items.count
+  ensure
+    threads&.each(&:join)
+  end
+end
