diff --git a/script/benchmark_entropy_sweep.rb b/script/benchmark_entropy_sweep.rb
new file mode 100644
index 0000000..62bdb74
--- /dev/null
+++ b/script/benchmark_entropy_sweep.rb
@@ -0,0 +1,45 @@
+# Run bin/rails test test/models/card/entropic_test.rb to load test fixtures, then:
+# RAILS_ENV=test bin/rails runner script/benchmark_entropy_sweep.rb
+# Override CARDS to change the dataset size. All inserted rows are rolled back.
+require "benchmark"
+require "active_support/testing/time_helpers"
+extend ActiveSupport::Testing::TimeHelpers
+
+connection = ActiveRecord::Base.connection
+raise "SQLite test database required" unless Rails.env.test? && connection.adapter_name == "SQLite"
+
+ActiveRecord::Base.transaction do
+  board = Card.first!.board
+  template = board.cards.first!.attributes.except("id", "number")
+  now = Time.current.change(usec: 0)
+  count = Integer(ENV.fetch("CARDS", 120_000))
+  first_number = Card.maximum(:number) + 1
+
+  count.times.each_slice(2_000) do |batch|
+    Card.insert_all! batch.map { |i|
+      template.merge("id" => ActiveRecord::Type::Uuid.generate, "number" => first_number + i,
+        "status" => "published", "last_active_at" => (i % 1000 == 0 ? now - 400.days : now))
+    }
+  end
+
+  # Measure selection, not the per-card postponement writes and callbacks.
+  old_ids, ids = [], []
+  Card.prepend(Module.new do
+    define_method(:auto_postpone) { |**| ids << id }
+  end)
+
+  travel_to now do
+    old_elapsed = Benchmark.realtime { Card.due_to_be_postponed.find_each { |card| old_ids << card.id } }
+    elapsed = Benchmark.realtime { Card.auto_postpone_all_due }
+    raise "Different results" unless old_ids.sort == ids.sort
+
+    puts "#{count} added cards, #{ids.size} matching cards"
+    puts "Global joined selection: #{old_elapsed.round(4)}s"
+    puts "Board-local sweep: #{elapsed.round(4)}s"
+
+    sql = board.cards.active.where(last_active_at: ..(now - board.auto_postpone_period)).order(:id).limit(1000).to_sql
+    puts connection.execute("EXPLAIN QUERY PLAN #{sql}").map { |row| row["detail"] }
+  end
+
+  raise ActiveRecord::Rollback
+end
