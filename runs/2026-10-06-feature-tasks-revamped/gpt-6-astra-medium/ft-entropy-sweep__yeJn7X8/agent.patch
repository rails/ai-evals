+  test "auto postpone includes the cutoff but not more recently active cards" do
+    travel_to Time.current.change(usec: 123456), with_usec: true
+    cutoff = Time.current - boards(:writebook).auto_postpone_period
+    cards(:logo).update! last_active_at: cutoff
+    cards(:layout).update! last_active_at: cutoff - Rational(1, 1_000_000)
+    cards(:shipping).update! last_active_at: cutoff + Rational(1, 1_000_000)
+
+    assert_difference -> { Card.postponed.count }, 2 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:layout).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "auto postpone skips closed postponed and draft cards" do
+    cards(:logo).close
+    cards(:shipping).postpone
+    cards(:layout).drafted!
+    cards(:logo, :shipping, :layout).each { |card| card.update! last_active_at: 400.days.ago }
+    original_not_now = cards(:shipping).not_now
+
+    assert_no_difference [ "Card::NotNow.count", "Event.count" ] do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.closed?
+    assert_equal original_not_now, cards(:shipping).reload.not_now
+    assert cards(:layout).reload.drafted?
+  end
+
+  test "auto postpone resolves overrides and account defaults independently for each board" do
+    entropies(:private_board, :miltons_wish_list_board).each(&:destroy!)
+    entropies("37s_account").update! auto_postpone_period: 7.days
+    entropies(:initech_account).update! auto_postpone_period: 90.days
+    cards(:buy_domain).update! board: boards(:private)
+    cards(:logo, :buy_domain, :radio).each { |card| card.update! last_active_at: 30.days.ago }
+
+    assert_difference -> { Card.postponed.count }, 1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:buy_domain).reload.postponed?
+    assert_not cards(:logo).reload.postponed?
+    assert_not cards(:radio).reload.postponed?
+  end
+
+  test "auto postpone selects cards by board and cutoff without joining entropy settings" do
+    assert_no_queries_match(/JOIN ["`]?entropies/i) do
+      assert_queries_match(/WHERE .*cards["`]?\.["`]?board_id["`]? = .*cards["`]?\.["`]?last_active_at["`]? <=/i) do
+        Card.auto_postpone_all_due
+      end
+    end
+  end
+
+  test "auto postpone processes more than one batch of due cards" do
+    template = cards(:logo).attributes.except("id", "number")
+    first_number = Card.maximum(:number) + 1
+    rows = 1005.times.map do |i|
+      template.merge("id" => ActiveRecord::Type::Uuid.generate, "number" => first_number + i, "last_active_at" => 400.days.ago)
+    end
+    Card.insert_all! rows
+
+    Card.any_instance.expects(:auto_postpone).with(user: accounts("37s").system_user).times(rows.size)
+
+    Card.auto_postpone_all_due
+  end
