diff --git a/test/integration/email_sign_in_test.rb b/test/integration/email_sign_in_test.rb
new file mode 100644
index 0000000..576c6b1
--- /dev/null
+++ b/test/integration/email_sign_in_test.rb
@@ -0,0 +1,270 @@
+require "test_helper"
+
+class EmailSignInTest < ActionDispatch::IntegrationTest
+  test "sign in by email code" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code][autocomplete=one-time-code]"
+
+      assert_difference -> { Session.count }, 1 do
+        post session_email_code_path(script_name: nil), params: { code: code }
+      end
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "sign up by email code and complete signup" do
+    untenanted do
+      code = request_code { post signup_path, params: { signup: { email_address: "new@example.com" } } }
+      assert_no_difference -> { Account.count } do
+        post session_email_code_path(script_name: nil), params: { code: code }
+      end
+      assert_redirected_to new_signup_completion_path
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+      assert Identity.find_by!(email_address: "new@example.com").accounts.exists?
+    end
+  end
+
+  test "join by email code only creates membership after verification" do
+    account = accounts(:"37s")
+    join_code = account_join_codes(:"37s")
+    code = nil
+
+    assert_no_difference -> { User.count } do
+      code = request_code do
+        post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "joining@example.com" }
+      end
+    end
+
+    follow_redirect!
+    assert_response :success
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        post session_email_code_path(script_name: nil), params: { code: code }
+      end
+      assert_redirected_to new_users_verification_path(script_name: account.slug)
+    end
+    identity = Identity.find_by!(email_address: "joining@example.com")
+    assert identity.accounts.exists?(id: account.id)
+    assert_equal 1, join_code.reload.usage_count
+
+    post users_verifications_path(script_name: account.slug)
+    assert_redirected_to new_users_join_path(script_name: account.slug)
+    post users_joins_path(script_name: account.slug), params: { user: { name: "New Member" } }
+    assert_redirected_to landing_path(script_name: account.slug)
+    assert_equal "New Member", identity.users.find_by!(account: account).name
+  end
+
+  test "invalid code can be retried without signing in" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "WRONG!" }
+      end
+      assert_response :unprocessable_entity
+      assert_not cookies[:session_token].present?
+      assert_select "input[name=code]"
+
+      post session_email_code_path, params: { code: code.downcase }
+      assert_redirected_to landing_path
+    end
+  end
+
+  test "expired code does not sign in" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      travel 15.minutes, with_usec: true do
+        assert_no_difference -> { Session.count } do
+          post session_email_code_path, params: { code: code }
+        end
+        assert_response :unprocessable_entity
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "used code cannot sign in again" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      post session_email_code_path, params: { code: code }
+      delete session_path
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "requesting another code invalidates the previous challenge" do
+    untenanted do
+      request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      previous = EmailCode.last
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      assert_not EmailCode.exists?(previous.id)
+
+      post session_email_code_path, params: { code: code }
+      assert_redirected_to landing_path
+    end
+  end
+
+  test "codes are bound to the requesting browser" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      open_session do |other_browser|
+        assert_no_difference -> { Session.count } do
+          other_browser.post session_email_code_path, params: { code: code }
+        end
+        assert_equal 422, other_browser.response.status
+      end
+
+      post session_email_code_path, params: { code: code }
+      assert_redirected_to landing_path
+    end
+  end
+
+  test "unknown email does not create an identity or disclose whether it exists" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        assert_no_enqueued_emails do
+          post session_path, params: { email_address: "unknown@example.com" }
+        end
+      end
+      assert_redirected_to new_session_email_code_path
+      follow_redirect!
+      assert_response :success
+    end
+  end
+
+  test "email addresses are normalized for sign in" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: "  #{identities(:kevin).email_address.upcase}  " } }
+      post session_email_code_path, params: { code: code }
+      assert_equal identities(:kevin), Session.last.identity
+    end
+  end
+
+  test "sign in returns to the originally requested page" do
+    destination = root_url(script_name: accounts(:"37s").slug)
+    get destination
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      post session_email_code_path(script_name: nil), params: { code: code }
+      assert_redirected_to destination
+    end
+  end
+
+  test "exhausted invitation cannot create a membership after email verification" do
+    join_code = account_join_codes(:"37s")
+    code = request_code do
+      post join_path(code: join_code.code, script_name: join_code.account.slug), params: { email_address: "joining@example.com" }
+    end
+    join_code.update!(usage_count: join_code.usage_limit)
+
+    assert_no_difference -> { User.count } do
+      post session_email_code_path(script_name: nil), params: { code: code }
+    end
+    assert_response :gone
+  end
+
+  test "reset invitation cannot create a membership after email verification" do
+    join_code = account_join_codes(:"37s")
+    code = request_code do
+      post join_path(code: join_code.code, script_name: join_code.account.slug), params: { email_address: "joining@example.com" }
+    end
+    join_code.reset
+
+    assert_no_difference -> { User.count } do
+      post session_email_code_path(script_name: nil), params: { code: code }
+    end
+    assert_response :not_found
+  end
+
+  test "existing members sign in through a join link without consuming another use" do
+    join_code = account_join_codes(:"37s")
+    code = request_code do
+      post join_path(code: join_code.code, script_name: join_code.account.slug), params: { email_address: identities(:kevin).email_address }
+    end
+
+    assert_no_difference [ -> { User.count }, -> { join_code.reload.usage_count } ] do
+      post session_email_code_path(script_name: nil), params: { code: code }
+    end
+    assert_redirected_to landing_path(script_name: join_code.account.slug)
+  end
+
+  test "verification is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+    untenanted do
+      post session_email_code_path, params: { code: "AB12CD" }
+      assert_response :too_many_requests
+    end
+  end
+
+  test "JSON sign in returns a session token after code verification" do
+    untenanted do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          post session_path(format: :json), params: { email_address: identities(:kevin).email_address }
+        end
+      end
+      assert_response :accepted
+      code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+
+      post session_email_code_path(format: :json), params: { code: "WRONG!" }
+      assert_response :unauthorized
+
+      post session_email_code_path(format: :json), params: { code: code }
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "requesting a new signup code returns to signup" do
+    untenanted do
+      request_code { post signup_path, params: { signup: { email_address: "new@example.com" } } }
+      follow_redirect!
+      assert_select "a[href=?]", new_signup_path, text: "Request a new code"
+    end
+  end
+
+  test "requesting a new join code keeps the original invitation" do
+    join_code = account_join_codes(:"37s")
+    invitation_path = join_path(code: join_code.code, script_name: join_code.account.slug)
+    request_code { post invitation_path, params: { email_address: "joining@example.com" } }
+    follow_redirect!
+    assert_select "a[href=?]", invitation_path, text: "Request a new code"
+  end
+
+  test "signup with an existing email verifies that identity without duplicating it" do
+    untenanted do
+      code = nil
+      assert_no_difference -> { Identity.count } do
+        code = request_code { post signup_path, params: { signup: { email_address: identities(:kevin).email_address } } }
+      end
+      post session_email_code_path, params: { code: code }
+      assert_redirected_to new_signup_completion_path
+      assert_equal identities(:kevin), Session.last.identity
+    end
+  end
+
+  private
+
+
+    def request_code
+      assert_emails 1 do
+        perform_enqueued_jobs { yield }
+      end
+      assert_redirected_to new_session_email_code_path(script_name: nil)
+      assert_not cookies[:session_token].present?
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/].tap do |code|
+        assert code, "Expected a six-character code in the subject"
+      end
+    end
+end
