diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..535f19d
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,32 @@
+class EmailCode < ApplicationRecord
+  EXPIRATION = 15.minutes
+  MAX_ATTEMPTS = 10
+
+  belongs_to :identity
+
+  def self.deliver_to(identity)
+    code = SecureRandom.alphanumeric(6).upcase
+    create!(identity: identity, code_digest: digest(code), expires_at: EXPIRATION.from_now).tap do
+      IdentityMailer.sign_in_code(identity, code).deliver_later
+    end
+  end
+
+  def self.cleanup
+    where(expires_at: ..Time.current).delete_all
+  end
+
+  def self.digest(code)
+    Digest::SHA256.hexdigest(code.to_s.strip.upcase)
+  end
+
+  def consume(code)
+    available = self.class.where(id: id).where("expires_at > ? AND attempts < ?", Time.current, MAX_ATTEMPTS)
+
+    if available.where(code_digest: self.class.digest(code)).delete_all == 1
+      identity
+    else
+      available.update_all("attempts = attempts + 1")
+      nil
+    end
+  end
+end
