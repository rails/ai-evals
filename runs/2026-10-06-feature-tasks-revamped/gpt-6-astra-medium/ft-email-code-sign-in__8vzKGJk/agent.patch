+module EmailCodeAuthentication
+  private
+
+  def send_email_code(identity, return_to: nil, join_code: nil, restart_path: new_session_path(script_name: nil))
+    EmailCode.where(id: session.delete(:email_code_id)).delete_all
+    session[:email_code_id] = EmailCode.deliver_to(identity).id if identity
+    session[:email_code_restart_path] = restart_path
+    session[:email_code_return_to] = return_to
+    session[:email_code_join_code] = join_code&.slice("id", "code")
+
+    respond_to do |format|
+      format.html { redirect_to new_session_email_code_path(script_name: nil) }
+      format.json { head :accepted }
+    end
+  end
+end
