+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p>Enter the six-character code from your email. The code is valid for fifteen minutes.</p>
+
+  <%= form_with url: session_email_code_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <%= form.label :code, "Sign-in code" %>
+    <%= form.text_field :code, required: true, minlength: 6, maxlength: 6, autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, class: "input txt-large full-width" %>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p><%= link_to "Request a new code", session[:email_code_restart_path] || new_session_path %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
