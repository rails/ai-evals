diff --git a/app/controllers/sessions/email_codes_controller.rb b/app/controllers/sessions/email_codes_controller.rb
new file mode 100644
index 0000000..2dc234a
--- /dev/null
+++ b/app/controllers/sessions/email_codes_controller.rb
@@ -0,0 +1,54 @@
+class Sessions::EmailCodesController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    email_code = EmailCode.find_by(id: session[:email_code_id])
+
+    if identity = email_code&.consume(params.expect(:code))
+      session.delete(:email_code_id)
+      session.delete(:email_code_restart_path)
+      start_new_session_for identity
+      return_to = session.delete(:email_code_return_to)
+
+      if join_code = session.delete(:email_code_join_code)
+        complete_join(identity, join_code)
+      else
+        respond_to do |format|
+          format.html { redirect_to return_to || after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      end
+    else
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = "That code is invalid or expired. Please try again or request a new code."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: "That code is invalid or expired." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def complete_join(identity, attributes)
+      if join_code = Account::JoinCode.find_by(attributes)
+        join_code.redeem_if { |account| identity.join(account) }
+        user = User.active.find_by(account: join_code.account, identity: identity)
+
+        if user
+          redirect_to user.setup? ? landing_url(script_name: join_code.account.slug) : new_users_verification_url(script_name: join_code.account.slug)
+        else
+          head :gone
+        end
+      else
+        head :not_found
+      end
+    end
+end
