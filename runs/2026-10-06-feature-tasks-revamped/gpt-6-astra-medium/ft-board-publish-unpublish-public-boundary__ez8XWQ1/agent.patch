index 0000000..2797ae6
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "board JSON includes a null public URL by default" do
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert response.parsed_body.key?("public_url")
+    assert_nil response.parsed_body["public_url"]
+  end
+
+  test "admins can publish and unpublish a board" do
+    post board_publication_path(@board), as: :json
+    assert_response :success
+
+    get board_path(@board), as: :json
+    public_url = response.parsed_body.fetch("public_url")
+    assert_match %r{/public/boards/[^/]+$}, public_url
+
+    sign_out
+    get public_url
+    assert_response :success
+    assert_select "h1", @board.name
+
+    sign_in_as :kevin
+    delete board_publication_path(@board), as: :json
+    assert_response :success
+
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body["public_url"]
+
+    sign_out
+    get public_url
+    assert_response :not_found
+  end
+
+  test "owners can publish with HTML and revoke publication" do
+    @board.accesses.grant_to users(:jason)
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "anonymous visitors cannot publish or unpublish" do
+    sign_out
+
+    post board_publication_path(@board), as: :json
+    assert_response :redirect
+    assert_not @board.reload.published?
+
+    @board.publish
+    delete board_publication_path(@board), as: :json
+    assert_response :redirect
+    assert @board.reload.published?
+  end
+
+  test "admins cannot publish a board from another account" do
+    post board_publication_path(boards(:miltons_wish_list)), as: :json
+    assert_response :not_found
+    assert_not boards(:miltons_wish_list).reload.published?
+  end
+
+  test "board creators who are not admins cannot publish or unpublish" do
+    logout_and_sign_in_as :david
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+
+    @board.publish
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
