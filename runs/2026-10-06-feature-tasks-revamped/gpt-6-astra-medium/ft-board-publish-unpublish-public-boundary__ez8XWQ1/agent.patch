+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication_key
+    @card = cards(:logo)
+    @column = columns(:writebook_triage)
+  end
+
+  test "anyone can see a published board and navigate its columns and cards" do
+    get public_board_path(@key)
+
+    assert_response :success
+    assert_select "h1", @board.name
+    assert_select "a[href=?]", public_board_column_path(@key, @column), text: @column.name
+    assert_select "a[href=?]", public_board_card_path(@key, @card), text: @card.title
+    assert_equal "none", response.headers["X-Robots-Tag"]
+    assert_equal "no-referrer", response.headers["Referrer-Policy"]
+    assert_includes response.headers["Cache-Control"], "no-store"
+  end
+
+  test "board pagination is available without authentication" do
+    get public_board_path(@key, page: 2)
+
+    assert_response :success
+    assert_select "turbo-frame#public_cards-pagination-contents-2"
+  end
+
+  test "public endpoints do not allow writes" do
+    post public_board_path(@key)
+    assert_response :not_found
+
+    delete public_board_card_path(@key, @card)
+    assert_response :not_found
+    assert @card.reload.published?
+  end
+
+  test "anyone can open a column directly" do
+    get public_board_column_path(@key, @column)
+
+    assert_response :success
+    assert_select "h1", @column.name
+    assert_select "a[href=?]", public_board_card_path(@key, @card), text: @card.title
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:text)), count: 0
+  end
+
+  test "anyone can open a published card by number" do
+    @card.update! description: "Details for public readers"
+
+    get public_board_card_path(@key, @card)
+
+    assert_response :success
+    assert_select "h1", @card.title
+    assert_select ".lexxy-content", text: /Details for public readers/
+    assert_select "form", count: 0
+  end
+
+  test "draft cards are neither listed nor accessible" do
+    @card.update! status: :drafted
+
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, @card), count: 0
+
+    get public_board_column_path(@key, @column)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, @card), count: 0
+
+    get public_board_card_path(@key, @card)
+    assert_response :not_found
+  end
+
+  test "columns and cards must belong to the published board" do
+    other_board = boards(:private)
+    other_board.publish
+
+    get public_board_column_path(other_board.publication_key, @column)
+    assert_response :not_found
+
+    get public_board_card_path(other_board.publication_key, @card)
+    assert_response :not_found
+  end
+
+  test "the publication must belong to the current account" do
+    other_board = boards(:miltons_wish_list)
+    other_board.publish
+
+    get public_board_path(other_board.publication_key)
+    assert_response :not_found
+  end
+
+  test "invalid keys and board IDs do not grant access" do
+    [ "unknown", @board.id ].each do |key|
+      get public_board_path(key)
+      assert_response :not_found
+    end
+  end
+
+  test "unpublishing revokes all public endpoints even after republishing" do
+    @board.unpublish
+    @board.publish
+
+    get public_board_path(@key)
+    assert_response :not_found
+
+    get public_board_column_path(@key, @column)
+    assert_response :not_found
+
+    get public_board_card_path(@key, @card)
+    assert_response :not_found
+  end
+
+  test "a private board is readable when published" do
+    board = boards(:private)
+    board.publish
+
+    get public_board_path(board.publication_key)
+    assert_response :success
+    assert_select "h1", board.name
+  end
+
+  test "signed in visitors from another account can read the public board" do
+    sign_in_as :mike
+
+    get public_board_path(@key)
+    assert_response :success
+
+    get public_board_column_path(@key, @column)
+    assert_response :success
+
+    get public_board_card_path(@key, @card)
+    assert_response :success
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
