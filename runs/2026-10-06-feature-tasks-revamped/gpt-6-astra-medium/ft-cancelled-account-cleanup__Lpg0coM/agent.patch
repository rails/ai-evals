diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..40ac9c7
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates all data for accounts cancelled more than 30 days ago" do
+    account = accounts(:"37s")
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("image"), filename: "image.png", content_type: "image/png")
+    card.image.blob.variant_records.create!(variation_digest: "test-variant")
+    unattached_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("unattached"), filename: "upload.txt")
+    blob_keys = [ card.image.blob.key, unattached_blob.key ]
+    card.reindex
+    account.materialize_storage
+    card.board.materialize_storage
+    storage_total_ids = [ account.storage_total.id, card.board.storage_total.id ]
+
+    Current.with_account(accounts(:initech)) do
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("keep"), filename: "keep.txt")
+    end
+
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 31.days.ago)
+
+    other_account_counts = account_record_counts(accounts(:initech))
+    identity_ids = Identity.pluck(:id)
+
+    Current.without_account do
+      Account::IncinerateDueJob.perform_now
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_equal identity_ids.sort, Identity.pluck(:id).sort
+    assert_equal other_account_counts, account_record_counts(accounts(:initech))
+    assert_empty account_record_counts(account).reject { |table, count| count.zero? }
+    assert_not Storage::Total.exists?(id: storage_total_ids)
+    blob_keys.each { |key| assert_not ActiveStorage::Blob.service.exist?(key) }
+  end
+
+  test "preserves active, recently cancelled, and reactivated accounts" do
+    recent = accounts(:"37s")
+    recent.cancel(initiated_by: users(:david))
+    recent.cancellation.update!(created_at: 29.days.ago)
+
+    reactivated = accounts(:initech)
+    reactivated.create_cancellation!(initiated_by: reactivated.users.first, created_at: 31.days.ago)
+    reactivated.reactivate
+
+    assert_no_difference "Account.count" do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+  end
+
+  test "incineration grace period is strictly more than 30 days" do
+    freeze_time do
+      account = accounts(:"37s")
+      account.cancel(initiated_by: users(:david))
+      account.cancellation.update!(created_at: 30.days.ago)
+
+      assert_no_difference "Account.count" do
+        Current.without_account { Account::IncinerateDueJob.perform_now }
+      end
+
+      travel 1.second
+
+      assert_difference "Account.count", -1 do
+        Current.without_account { Account::IncinerateDueJob.perform_now }
+      end
+    end
+  end
+
+  test "incinerates multiple due accounts in their own account context" do
+    [ accounts(:"37s"), accounts(:initech) ].each do |account|
+      account.create_cancellation!(initiated_by: account.users.first, created_at: 31.days.ago)
+    end
+
+    assert_difference "Account.count", -2 do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  test "rechecks cancellation before incinerating a selected account" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 31.days.ago)
+    selected_account = Account.due_for_incineration.find(account.id)
+
+    account.reactivate
+
+    assert_no_difference "Account.count" do
+      selected_account.incinerate
+    end
+  end
+
+  private
+    def account_record_counts(account)
+      connection = ApplicationRecord.connection
+      connection.tables.filter_map do |table|
+        if connection.columns(table).any? { |column| column.name == "account_id" }
+          count = connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{connection.quote(account.id)}")
+          [ table, count ]
+        end
+      end.to_h
+    end
+end
