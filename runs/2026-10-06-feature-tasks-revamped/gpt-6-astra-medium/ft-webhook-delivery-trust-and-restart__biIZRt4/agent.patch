@@ -0,0 +1,165 @@
+require "test_helper"
+
+class Webhook::DeliveryExecutionTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @delivery = webhook_deliveries(:pending)
+    stub_dns_resolution "93.184.216.34"
+  end
+
+  test "posts a signed event once and records the result" do
+    endpoint = stub_request(:post, @webhook.url).with do |request|
+      payload = JSON.parse(request.body)
+      assert_equal @delivery.event_id, payload["id"]
+      assert_equal @delivery.id, request.headers["X-Webhook-Delivery"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+      assert_includes payload["board"]["url"], @webhook.account.slug
+      true
+    end.to_return(status: 201)
+
+    @delivery.deliver_now
+    Webhook::Delivery.find(@delivery.id).deliver_now
+
+    assert_requested endpoint, times: 1
+    assert @delivery.reload.succeeded?
+    assert_equal 201, @delivery.response[:code]
+  end
+
+  test "timeouts are logged and not retried" do
+    endpoint = stub_request(:post, @webhook.url).to_timeout
+
+    2.times { @delivery.deliver_now }
+
+    assert_requested endpoint, times: 1
+    assert @delivery.reload.errored?
+    assert @delivery.failed?
+    assert @delivery.response[:error].present?
+  end
+
+  test "inactive receivers are not contacted" do
+    @webhook.deactivate
+    @delivery.deliver_now
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "private destinations are logged without sending a request" do
+    stub_dns_resolution "127.0.0.1"
+    @delivery.deliver_now
+
+    assert_not_requested :post, @webhook.url
+    assert @delivery.reload.failed?
+  end
+
+  test "a duplicate worker cannot send while a request is in progress" do
+    other_worker = Webhook::Delivery.find(@delivery.id)
+    endpoint = stub_request(:post, @webhook.url).to_return do
+      other_worker.deliver_now
+      { status: 204 }
+    end
+
+    @delivery.deliver_now
+
+    assert_requested endpoint, times: 1
+    assert @delivery.reload.succeeded?
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "HTTP errors count as failures without retrying or following redirects" do
+    endpoint = stub_request(:post, @webhook.url).to_return(status: 302, headers: { "Location" => "http://127.0.0.1/" })
+
+    2.times { @delivery.deliver_now }
+
+    assert_requested endpoint, times: 1
+    assert_not_requested :get, "http://127.0.0.1/"
+    assert @delivery.reload.completed?
+    assert @delivery.failed?
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "job restores account context and tolerates deleted deliveries" do
+    endpoint = stub_request(:post, @webhook.url).to_return(status: 200)
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @delivery.deliver_later
+    end
+    assert_requested endpoint, times: 1
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @delivery.deliver_later
+        @delivery.destroy!
+      end
+    end
+  end
+
+  test "a failed POST at the threshold disables the receiver" do
+    @webhook.create_delinquency_tracker! consecutive_failures_count: 9, first_failure_at: 1.hour.ago
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    @delivery.deliver_now
+
+    assert @delivery.reload.failed?
+    assert_equal 500, @delivery.response[:code]
+    assert_not @webhook.reload.active?
+  end
+
+  test "a successful POST resets failures" do
+    @webhook.create_delinquency_tracker! consecutive_failures_count: 9, first_failure_at: 2.hours.ago
+    stub_request(:post, @webhook.url).to_return(status: 204)
+
+    @delivery.deliver_now
+
+    assert @delivery.reload.succeeded?
+    assert @webhook.reload.active?
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "comment events are rendered with their card" do
+    @delivery.update! event: events(:layout_commented)
+    endpoint = stub_request(:post, @webhook.url).with do |request|
+      payload = JSON.parse(request.body)
+      assert_equal "comment_created", payload["action"]
+      assert_equal @delivery.event.eventable.card_id, payload["eventable"]["card"]["id"]
+      true
+    end.to_return(status: 200)
+
+    @delivery.deliver_now
+
+    assert_requested endpoint
+  end
+
+  test "recognized chat receivers get message payloads" do
+    {
+      "https://hooks.slack.com/services/T123/B123/token" => "text",
+      "https://chat.example.com/rooms/123/456-token/messages" => "content",
+      "https://3.basecampapi.com/123/integrations/token/buckets/456/chats/789/lines" => "content"
+    }.each do |url, key|
+      webhook = Webhook.create! name: "Chat", board: @webhook.board, url: url
+      delivery = webhook.deliveries.create! event: @delivery.event
+      endpoint = stub_request(:post, url).with do |request|
+        payload = JSON.parse(request.body)
+        assert_equal [ key ], payload.keys
+        assert_includes payload[key], @delivery.event.card.title
+        true
+      end.to_return(status: 200)
+
+      delivery.deliver_now
+
+      assert_requested endpoint
+      assert delivery.reload.succeeded?
+    end
+  end
+
+  test "cleanup keeps a week" do
+    travel_to Time.current.change(usec: 0) do
+      old = webhook_deliveries(:errored)
+      old.update! created_at: 1.week.ago - 1.second
+      @delivery.update! created_at: 1.week.ago
+
+      Webhook::Delivery.cleanup
+
+      assert_not Webhook::Delivery.exists?(old.id)
+      assert Webhook::Delivery.exists?(@delivery.id)
+    end
+  end
+end
