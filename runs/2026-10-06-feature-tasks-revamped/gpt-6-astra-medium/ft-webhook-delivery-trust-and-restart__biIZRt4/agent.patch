@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Event::WebhookDispatchingTest < ActiveSupport::TestCase
+  test "events enqueue one delivery for each active subscribed webhook on their board" do
+    webhook = webhooks(:active)
+    second = Webhook.new(webhook.attributes.except("id"))
+    second.save!
+    inactive = Webhook.new(webhook.attributes.except("id"))
+    inactive.update! active: false
+    unsubscribed = Webhook.new(webhook.attributes.except("id"))
+    unsubscribed.update! subscribed_actions: [ "comment_created" ]
+    other_board = Webhook.new(webhook.attributes.except("id"))
+    other_board.update! board: boards(:private)
+
+    assert_enqueued_jobs 2, only: Webhook::DeliveryJob do
+      event = Event.new(events(:logo_published).attributes.except("id"))
+      event.save!
+      assert_equal [ webhook.id, second.id ].sort, event.webhook_deliveries.pluck(:webhook_id).sort
+      assert_equal [ event.account_id ], event.webhook_deliveries.distinct.pluck(:account_id)
+    end
+  end
+
+  test "rolling back an event also rolls back deliveries and does not enqueue jobs" do
+    assert_no_difference "Webhook::Delivery.count" do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        Event.transaction(requires_new: true) do
+          Event.new(events(:logo_published).attributes.except("id")).save!
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "database rejects duplicate webhook and event pairs" do
+    delivery = webhook_deliveries(:pending)
+    assert_raises ActiveRecord::RecordNotUnique do
+      Webhook::Delivery.create!(delivery.attributes.except("id"))
+    end
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..b1350e6
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    @webhook = webhooks(:active)
+  end
+
+  test "ten consecutive failures spanning an hour deactivate the webhook" do
+    9.times { @webhook.record_delivery_result(webhook_deliveries(:errored)) }
+    assert @webhook.reload.active?
+
+    travel 1.hour do
+      @webhook.record_delivery_result(webhook_deliveries(:errored))
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "fewer than ten failures do not deactivate the webhook even after an hour" do
+    @webhook.record_delivery_result(webhook_deliveries(:errored))
+    travel 2.hours do
+      8.times { @webhook.record_delivery_result(webhook_deliveries(:errored)) }
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "ten failures within an hour do not deactivate the webhook" do
+    10.times { @webhook.record_delivery_result(webhook_deliveries(:errored)) }
+    assert @webhook.reload.active?
+  end
+
+  test "success and reactivation reset the failure streak" do
+    9.times { @webhook.record_delivery_result(webhook_deliveries(:errored)) }
+    @webhook.record_delivery_result(webhook_deliveries(:successfully_completed))
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+
+    @webhook.record_delivery_result(webhook_deliveries(:errored))
+    @webhook.deactivate
+    @webhook.activate
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+end
