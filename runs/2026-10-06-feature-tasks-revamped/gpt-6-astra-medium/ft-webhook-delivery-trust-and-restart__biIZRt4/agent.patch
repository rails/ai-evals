diff --git a/app/models/webhook/request.rb b/app/models/webhook/request.rb
new file mode 100644
index 0000000..ea766da
--- /dev/null
+++ b/app/models/webhook/request.rb
@@ -0,0 +1,69 @@
+require "net/http"
+
+class Webhook::Request
+  TIMEOUT = 10
+
+  class UnsafeDestination < StandardError; end
+
+  attr_reader :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def headers
+    @headers ||= {
+      "Content-Type" => "application/json",
+      "User-Agent" => "Fizzy Webhook",
+      "X-Webhook-Delivery" => delivery.id,
+      "X-Webhook-Timestamp" => Time.current.iso8601,
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", delivery.webhook.signing_secret, body)
+    }
+  end
+
+  def body
+    @body ||= if delivery.webhook.for_slack?
+      { text: render_event(:html) }.to_json
+    elsif delivery.webhook.for_campfire? || delivery.webhook.for_basecamp?
+      { content: render_event(:html) }.to_json
+    else
+      render_event(:json)
+    end
+  end
+
+  def perform
+    uri = URI.parse(delivery.webhook.url)
+    unless uri.is_a?(URI::HTTP) && uri.hostname.present?
+      raise UnsafeDestination, "Invalid HTTP destination"
+    end
+
+    ip = SsrfProtection.resolve_public_ip(uri.hostname)
+    raise UnsafeDestination, "Destination does not resolve to a public IP address" unless ip
+
+    # Pin the checked IP to prevent DNS rebinding. Disable proxy lookup, redirects,
+    # and automatic retries: a delivery must never make a second POST attempt.
+    http = Net::HTTP.new(uri.hostname, uri.port, nil)
+    http.ipaddr = ip
+    http.use_ssl = uri.scheme == "https"
+    http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+    http.max_retries = 0
+
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+    http.start do
+      http.request(request) do |response|
+        # Only retain status and headers, not an arbitrarily large response body.
+        return { code: response.code.to_i, headers: response.to_hash }
+      end
+    end
+  end
+
+  private
+    def render_event(format)
+      Current.with_account(delivery.account) do
+        ApplicationController.renderer.new(script_name: delivery.account.slug).render(
+          template: "webhooks/event", formats: [ format ], layout: false, assigns: { event: delivery.event }
+        )
+      end
+    end
+end
