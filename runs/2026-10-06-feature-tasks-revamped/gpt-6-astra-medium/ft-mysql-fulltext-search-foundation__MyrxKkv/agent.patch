diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..257c467
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "searches existing rich text" do
+    assert_equal [ cards(:layout) ], Current.user.accessible_cards.search("overflowing").to_a
+  end
+
+  test "description edits and clearing are immediately searchable" do
+    card = cards(:logo)
+    card.update!(description: "<p>Searchneedle &amp; haystack</p>")
+    assert_equal "Searchneedle & haystack", card.rich_text_description.reload.plain_text_body
+    assert_equal [ card ], Current.user.accessible_cards.search("searchneedle").to_a
+
+    card.update!(description: "Something different")
+    assert_empty Current.user.accessible_cards.search("searchneedle")
+
+    card.update!(description: nil)
+    assert_empty Current.user.accessible_cards.search("different")
+  end
+
+  test "direct rich text edits update searchable content" do
+    rich_text = comments(:logo_agreement_kevin).rich_text_body
+    rich_text.update!(body: "A searchneedle comment")
+    assert_equal [ cards(:logo) ], Current.user.accessible_cards.search("searchneedle").to_a
+
+    rich_text.update!(body: "No longer matching")
+    assert_empty Current.user.accessible_cards.search("searchneedle")
+  end
+
+  test "cards with identical creation timestamps have stable newest first ordering" do
+    cards(:logo).update!(description: "Searchneedle", created_at: Time.current)
+    cards(:layout).update!(description: "Searchneedle", created_at: cards(:logo).created_at)
+
+    assert_equal [ cards(:logo), cards(:layout) ].sort_by(&:id).reverse,
+      Current.user.accessible_cards.search("searchneedle").to_a
+  end
+end
