diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..4730c2e
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,172 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "search finds titles descriptions and comments once each newest first" do
+    cards(:logo).update!(title: "Searchneedle title", created_at: 3.days.ago)
+    cards(:layout).update!(description: "A SEARCHNEEDLE description", created_at: 2.days.ago)
+    cards(:text).update!(created_at: 1.day.ago)
+    2.times { cards(:text).comments.create!(body: "A searchneedle comment", creator: users(:kevin)) }
+
+    get search_path, params: { q: "searchneedle" }
+
+    assert_response :success
+    assert_equal [ cards(:text), cards(:layout), cards(:logo) ].map { |card| card_path(card) },
+      css_select(".search-result h2 a").map { |link| link["href"] }
+    assert_select ".search-result mark", text: /searchneedle/i, minimum: 3
+  end
+
+  test "search only includes boards the current user can access" do
+    private_card = boards(:private).cards.create!(title: "Searchneedle private", creator: users(:kevin), status: :published)
+    cards(:radio).update!(title: "Searchneedle other account")
+
+    get search_path, params: { q: "searchneedle" }
+    assert_select ".search-result h2 a", text: private_card.title, count: 1
+    assert_select ".search-result", count: 1
+
+    boards(:private).accesses.revoke_from(users(:kevin))
+
+    get search_path, params: { q: "searchneedle" }
+    assert_select ".search-result", count: 0
+
+    boards(:private).accesses.grant_to(users(:kevin))
+
+    get search_path, params: { q: "searchneedle" }
+    assert_select ".search-result", count: 1
+  end
+
+  test "draft titles descriptions and comments never appear" do
+    cards(:logo).update!(title: "Searchneedle title", status: :drafted)
+    cards(:layout).update!(description: "Searchneedle description", status: :drafted)
+    cards(:text).comments.create!(body: "Searchneedle comment", creator: users(:kevin))
+    cards(:text).drafted!
+
+    get search_path, params: { q: "searchneedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_select "p", text: "No cards found."
+  end
+
+  test "blank queries show the form without returning cards" do
+    [ nil, "", "  \t " ].each do |query|
+      get search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "form[method=get][action=?]", search_path
+      assert_select "input[name=q]"
+      assert_select ".search-result", count: 0
+    end
+  end
+
+  test "each word can match a different field and is highlighted case insensitively" do
+    cards(:logo).update!(title: "Searchneedle", description: "Another HAYSTACK")
+    cards(:layout).update!(title: "Searchneedle only")
+
+    get search_path, params: { q: "  searchneedle   haystack  " }
+
+    assert_select ".search-result", count: 1
+    assert_select ".search-result mark", text: "Searchneedle"
+    assert_select ".search-result mark", text: "HAYSTACK"
+  end
+
+  test "search treats SQL wildcards and regex characters literally" do
+    cards(:logo).update!(title: "100%_done [ready]!")
+    cards(:layout).update!(title: "100percent done ready")
+
+    [ "100%_done", "[ready]!", "%", "_" ].each do |query|
+      get search_path, params: { q: query }
+
+      assert_select ".search-result", count: 1
+      assert_select ".search-result mark", text: query
+    end
+
+    get search_path, params: { q: "' OR 1=1 --" }
+    assert_select ".search-result", count: 0
+  end
+
+  test "highlights text without rendering stored markup" do
+    cards(:logo).update!(title: '<script>alert("searchneedle")</script>', description: "<p>A <strong>searchneedle</strong> description</p>")
+    cards(:logo).comments.create!(body: "<p>A <em>searchneedle</em> comment</p>", creator: users(:kevin))
+
+    get search_path, params: { q: "searchneedle" }
+
+    assert_select ".search-result h2 mark", count: 1
+    assert_select ".search-result > p mark", count: 1
+    assert_select ".search-result blockquote", text: "A searchneedle comment"
+    assert_select ".search-result script, .search-result strong, .search-result em", count: 0
+    assert_select ".search-result h2", text: '<script>alert("searchneedle")</script>'
+  end
+
+  test "search reflects edits and comment deletion" do
+    comment = cards(:logo).comments.create!(body: "Searchneedle comment", creator: users(:kevin))
+
+    get search_path, params: { q: "searchneedle" }
+    assert_select ".search-result", count: 1
+
+    comment.update!(body: "An updated comment")
+    get search_path, params: { q: "searchneedle" }
+    assert_select ".search-result", count: 0
+
+    comment.update!(body: "Searchneedle again")
+    comment.destroy!
+    get search_path, params: { q: "searchneedle" }
+    assert_select ".search-result", count: 0
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path, params: { q: "logo" }
+    assert_response :redirect
+  end
+
+  test "searches rich text content rather than markup" do
+    cards(:logo).update!(description: '<p data-searchneedle="hidden">R&amp;D search<strong>needle</strong></p>')
+    cards(:layout).comments.create!(body: "<p>R&amp;D search<strong>needle</strong></p>", creator: users(:kevin))
+
+    get search_path, params: { q: "R&D searchneedle" }
+    assert_select ".search-result", count: 2
+    assert_select ".search-result mark", text: "R&D", count: 2
+    assert_select ".search-result mark", text: "searchneedle", count: 2
+
+    get search_path, params: { q: "data-searchneedle" }
+    assert_select ".search-result", count: 0
+  end
+
+  test "moving a matching card to an inaccessible board removes it from results" do
+    boards(:private).accesses.revoke_from(users(:kevin))
+    cards(:logo).comments.create!(body: "Searchneedle comment", creator: users(:kevin))
+
+    get search_path, params: { q: "searchneedle" }
+    assert_select ".search-result", count: 1
+
+    Current.user = users(:kevin)
+    cards(:logo).assignees.clear
+    cards(:logo).move_to(boards(:private))
+
+    get search_path, params: { q: "searchneedle" }
+    assert_select ".search-result", count: 0
+  end
+
+  test "pagination preserves the query and does not repeat results" do
+    60.times do |index|
+      boards(:writebook).cards.create!(title: "Searchneedle #{index}", creator: users(:kevin), status: :published)
+    end
+
+    get search_path, params: { q: "searchneedle" }
+    first_page_links = css_select(".search-result h2 a").map { |link| link["href"] }
+    next_page_link = css_select("a[aria-label='Load page 2']").first
+    assert next_page_link
+    assert_includes next_page_link["href"], "q=searchneedle"
+
+    get next_page_link["href"]
+    assert_response :success
+    second_page_links = css_select(".search-result h2 a").map { |link| link["href"] }
+    assert second_page_links.any?
+    assert_empty first_page_links & second_page_links
+  end
+end
