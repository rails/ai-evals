+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,19 @@
+module SearchesHelper
+  def highlight_search_match(text, terms)
+    if terms.any?
+      pattern = Regexp.new("(#{Regexp.union(terms).source})", Regexp::IGNORECASE)
+      safe_join(text.to_s.split(pattern).each_with_index.map do |part, index|
+        index.odd? ? tag.mark(part) : part
+      end)
+    else
+      ERB::Util.html_escape(text.to_s)
+    end
+  end
+
+  def search_result_comments(card, terms)
+    card.comments.select do |comment|
+      body = comment.body.to_plain_text.to_s.downcase
+      terms.any? { |term| body.include?(term.downcase) }
+    end
+  end
+end
