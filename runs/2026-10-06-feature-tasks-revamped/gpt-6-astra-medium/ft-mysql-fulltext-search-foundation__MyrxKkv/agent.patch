diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..b365049
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,28 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def search(query)
+      terms = search_terms(query)
+
+      if terms.any?
+        terms.reduce(published) do |cards, term|
+          pattern = "%#{sanitize_sql_like(term.downcase, "!")}%"
+          rich_texts = ActionText::RichText.where("LOWER(plain_text_body) LIKE ? ESCAPE '!'", pattern)
+          descriptions = rich_texts.where(record_type: "Card", name: "description").select(:record_id)
+          comments = Comment.where(id: rich_texts.where(record_type: "Comment", name: "body").select(:record_id))
+
+          cards.where("LOWER(cards.title) LIKE ? ESCAPE '!'", pattern)
+            .or(cards.where(id: descriptions))
+            .or(cards.where(id: comments.select(:card_id)))
+        end.reverse_chronologically
+      else
+        none
+      end
+    end
+
+    def search_terms(query)
+      query.to_s.split.uniq
+    end
+  end
+end
