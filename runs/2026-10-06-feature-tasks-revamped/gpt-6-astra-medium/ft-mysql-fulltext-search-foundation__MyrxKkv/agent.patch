@@ -0,0 +1,35 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title">Search</h1>
+<% end %>
+
+<section class="panel panel--wide center-block">
+  <%= form_with url: search_path, method: :get, class: "flex gap align-center" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards", class: "input", autofocus: true %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @terms.empty? %>
+    <p>Search card titles, descriptions, and comments.</p>
+  <% elsif @page.records.empty? %>
+    <p>No cards found.</p>
+  <% else %>
+    <%= with_manual_pagination :search_results, @page do %>
+      <% @page.records.each do |card| %>
+        <article class="search-result margin-block">
+          <h2><%= link_to highlight_search_match(card.title, @terms), card_path(card) %></h2>
+          <p class="txt-small"><%= card.board.name %> &middot; <%= local_datetime_tag card.created_at %></p>
+          <% if card.description.present? %>
+            <p><%= highlight_search_match(card.description.to_plain_text, @terms) %></p>
+          <% end %>
+          <% search_result_comments(card, @terms).each do |comment| %>
+            <blockquote><%= highlight_search_match(comment.body.to_plain_text, @terms) %></blockquote>
+          <% end %>
+        </article>
+      <% end %>
+    <% end %>
+  <% end %>
+</section>
