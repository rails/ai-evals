+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,105 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "add, cancel, add again, and remove a reaction on someone else's comment" do
+    visit card_url(@comment.card)
+
+    within "##{dom_id(@comment)} .reactions" do
+      assert_no_field "Your reaction"
+      click_button "Add a reaction"
+      fill_in "Your reaction", with: "Not saved"
+      click_button "Cancel reaction"
+      assert_no_field "Your reaction"
+      assert_no_text "Not saved"
+
+      click_button "Add a reaction"
+      assert_field "Your reaction", with: ""
+      fill_in "Your reaction", with: "🎉"
+      click_button "Confirm reaction"
+      assert_selector ".reaction", text: "🎉", count: 1
+      assert_no_field "Your reaction"
+      assert_button "Add a reaction"
+      assert_no_button "Remove reaction"
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+      assert_selector ".reaction", text: "🎉", count: 1
+
+
+      click_button "Add a reaction"
+      fill_in "Your reaction", with: "Well done!"
+      click_button "Confirm reaction"
+      assert_selector ".reaction", text: "Well done!"
+      assert_no_field "Your reaction"
+
+      find(".reaction", text: "🎉").find("button[data-reaction-target=toggle]").click
+      click_button "Remove reaction"
+      assert_no_selector ".reaction", text: "🎉"
+    end
+
+    visit card_url(@comment.card)
+    within "##{dom_id(@comment)} .reactions" do
+      assert_selector ".reaction", text: "Well done!"
+      assert_no_selector ".reaction", text: "🎉"
+    end
+  end
+
+  test "receive additions and removals live while composing a reaction" do
+    visit card_url(@comment.card)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+    assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+
+    within "##{dom_id(@comment)} .reactions" do
+      click_button "Add a reaction"
+      fill_in "Your reaction", with: "My draft"
+    end
+
+    reaction = nil
+    perform_enqueued_jobs do
+      reaction = @comment.reactions.create!(content: "From elsewhere", creator: users(:jz))
+    end
+
+    within "##{dom_id(@comment)} .reactions" do
+      assert_selector ".reaction", text: "From elsewhere"
+      assert_field "Your reaction", with: "My draft"
+      assert_no_button "Remove reaction"
+      assert_no_selector ".reaction [data-reaction-target=toggle]"
+    end
+
+    reaction.destroy!
+
+    within "##{dom_id(@comment)} .reactions" do
+      assert_no_selector ".reaction", text: "From elsewhere"
+      assert_field "Your reaction", with: "My draft"
+      find_field("Your reaction").send_keys :escape
+      assert_button "Add a reaction"
+    end
+  end
+  test "validate length and retain the input after a failed save" do
+    visit card_url(@comment.card)
+
+    within "##{dom_id(@comment)} .reactions" do
+      click_button "Add a reaction"
