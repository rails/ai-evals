--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,24 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "toggle", "content", "delete" ]
+  static values = { creatorId: String }
+
+  connect() {
+    this.toggleTarget.hidden = !this.#owned
+    this.contentTarget.hidden = this.#owned
+    this.element.classList.toggle("reaction--deleteable", this.#owned)
+  }
+
+  toggle() {
+    if (this.#owned) {
+      const expanded = this.element.classList.toggle("expanded")
+      this.toggleTarget.setAttribute("aria-expanded", expanded)
+      this.deleteTarget.hidden = !expanded
+    }
+  }
+
+  get #owned() {
+    return this.creatorIdValue === Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..7aa02de
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,33 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "composer", "form", "input", "errors" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.composerTarget.classList.add("reaction")
+    this.composerTarget.hidden = false
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.formTarget.reset()
+    this.inputTarget.setCustomValidity("")
+    this.errorsTarget.textContent = ""
+    this.composerTarget.hidden = true
+    this.composerTarget.classList.remove("reaction")
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  validate() {
+    // HTML maxlength counts UTF-16 units; count Unicode characters like the server.
+    const tooLong = Array.from(this.inputTarget.value).length > 16
+    this.inputTarget.setCustomValidity(tooLong ? "Reactions can have at most 16 characters." : "")
+  }
+
+  submitted(event) {
+    if (event.detail.success) this.cancel()
+  }
+}
