--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "defaults to the current user and comment account" do
+    reaction = @comment.reactions.create!(content: "🎉")
+    assert_equal Current.user, reaction.creator
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "requires content of at most sixteen characters" do
+    [ nil, "", "   ", "a" * 17, "🎉" * 17 ].each do |content|
+      assert_not @comment.reactions.new(content: content).valid?, "Accepted #{content.inspect}"
+    end
+
+    [ "Nice!", "a" * 16, "🎉" * 16 ].each do |content|
+      assert @comment.reactions.new(content: content).valid?, "Rejected #{content.inspect}"
+    end
+  end
+
+  test "broadcasts creation and removal to card viewers" do
+    reaction = nil
+    assert_turbo_stream_broadcasts @comment.card do
+      perform_enqueued_jobs do
+        reaction = @comment.reactions.create!(content: "Great!")
+      end
+    end
+
+    assert_turbo_stream_broadcasts @comment.card do
+      reaction.destroy!
+    end
+  end
+
+  test "invalidates the cached comment when adding and removing reactions" do
+    travel 1.minute do
+      assert_changes -> { @comment.reload.cache_key_with_version } do
+        @reaction = @comment.reactions.create!(content: "👍")
+      end
+    end
+
+    travel 2.minutes do
+      assert_changes -> { @comment.reload.cache_key_with_version } do
+        @reaction.destroy!
+      end
+    end
+  end
+
+  test "deleting a comment removes its reactions" do
+    reaction = @comment.reactions.create!(content: "👍")
+    @comment.destroy!
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
