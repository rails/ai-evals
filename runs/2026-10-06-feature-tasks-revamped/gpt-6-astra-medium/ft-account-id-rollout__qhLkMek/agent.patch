diff --git a/test/migrations/complete_account_id_rollout_test.rb b/test/migrations/complete_account_id_rollout_test.rb
new file mode 100644
index 0000000..8c2cf82
--- /dev/null
+++ b/test/migrations/complete_account_id_rollout_test.rb
@@ -0,0 +1,201 @@
+require "test_helper"
+require Rails.root.join("db/migrate/20260710120000_complete_account_id_rollout")
+
+class CompleteAccountIdRolloutTest < Minitest::Test
+  class Database < ActiveRecord::Base
+    self.abstract_class = true
+  end
+
+  def setup
+    Database.establish_connection(adapter: "sqlite3", database: ":memory:")
+    @connection = Database.connection
+    @migration = CompleteAccountIdRollout.new
+    @ids = Hash.new { |ids, key| ids[key] = ActiveRecord::Type::Uuid.generate }
+    create_legacy_schema
+  end
+
+  def teardown
+    Database.connection_pool.disconnect!
+  end
+
+  def test_backfills_every_ownership_path_and_drops_orphans
+    %w[first second].each do |tenant|
+      insert(:accounts, tenant)
+      CompleteAccountIdRollout::EXISTING_TABLES.each do |table, parent|
+        attributes = parent ? { parent.last => id("#{parent.first}_#{tenant}") } : { account_id: id(tenant) }
+        insert(table, "#{table}_#{tenant}", **attributes)
+      end
+
+      CompleteAccountIdRollout::DEPENDENT_TABLES.each do |table, (parent, foreign_key)|
+        insert(table, "#{table}_#{tenant}", foreign_key => id("#{parent}_#{tenant}"))
+      end
+
+      CompleteAccountIdRollout::POLYMORPHIC_TABLES.each do |table, (association, types)|
+        types.each do |type, parent|
+          owner = parent == :accounts ? tenant : "#{parent}_#{tenant}"
+          insert(table, "#{table}_#{type}_#{tenant}", "#{association}_type" => type, "#{association}_id" => id(owner))
+        end
+      end
+    end
+
+    CompleteAccountIdRollout::EXISTING_TABLES.each_key do |table|
+      insert(table, "orphan", account_id: id("missing_account"))
+      insert(table, "null_account")
+    end
+    CompleteAccountIdRollout::DEPENDENT_TABLES.each do |table, (_, foreign_key)|
+      insert(table, "orphan", foreign_key => id("missing_parent"))
+    end
+    CompleteAccountIdRollout::POLYMORPHIC_TABLES.each do |table, (association, types)|
+      insert(table, "orphan", "#{association}_type" => types.keys.first, "#{association}_id" => id("missing_parent"))
+      insert(table, "unknown_type", "#{association}_type" => "RemovedModel", "#{association}_id" => id("first"))
+    end
+
+    migrate
+
+    tenant_tables.each do |table|
+      rows = @connection.select_all("SELECT label, account_id FROM #{table}").to_a
+      expected_count = CompleteAccountIdRollout::POLYMORPHIC_TABLES[table]&.last&.size || 1
+      assert_equal expected_count * 2, rows.size, table.to_s
+      rows.each do |row|
+        tenant = row["label"].end_with?("first") ? "first" : "second"
+        assert_equal binary_id(tenant), row["account_id"], "#{table}: #{row['label']}"
+      end
+      refute rows.any? { |row| %w[orphan null_account unknown_type].include?(row["label"]) }, table.to_s
+      assert_required_and_indexed(table)
+    end
+
+    assert_raises(ActiveRecord::IrreversibleMigration) { @migration.down }
+  end
+
+  def test_storage_ownership_propagates_through_previews_and_variants
+    insert(:accounts, "first")
+    insert(:users, "user", account_id: id("first"))
+    insert(:boards, "board", creator_id: id("user"))
+    insert(:cards, "card", board_id: id("board"))
+    insert(:action_text_rich_texts, "text", record_type: "Card", record_id: id("card"))
+
+    insert(:active_storage_blobs, "original")
+    insert(:active_storage_attachments, "embed", record_type: "ActionText::RichText", record_id: id("text"), blob_id: id("original"))
+    insert(:active_storage_blobs, "preview")
+    insert(:active_storage_attachments, "preview_image", record_type: "ActiveStorage::Blob", record_id: id("original"), blob_id: id("preview"))
+    insert(:active_storage_variant_records, "variant", blob_id: id("preview"))
+    insert(:active_storage_blobs, "thumbnail")
+    insert(:active_storage_attachments, "variant_image", record_type: "ActiveStorage::VariantRecord", record_id: id("variant"), blob_id: id("thumbnail"))
+
+    insert(:active_storage_blobs, "unattached")
+    insert(:active_storage_variant_records, "orphan", blob_id: id("unattached"))
+    insert(:active_storage_attachments, "orphan", record_type: "Card", record_id: id("missing"), blob_id: id("unattached"))
+
+    migrate
+
+    { active_storage_blobs: 3, active_storage_attachments: 3, active_storage_variant_records: 1 }.each do |table, count|
+      rows = @connection.select_all("SELECT account_id FROM #{table}").to_a
+      assert_equal count, rows.size
+      assert rows.all? { |row| row["account_id"] == binary_id("first") }
+      assert_required_and_indexed(table)
+    end
+  end
+
+  def test_preserves_existing_ownership_and_removes_unresolvable_chains
+    insert(:accounts, "first")
+    insert(:accounts, "second")
+    insert(:users, "creator", account_id: id("first"))
+    insert(:boards, "owned", creator_id: id("creator"), account_id: id("second"))
+    insert(:cards, "card", board_id: id("owned"))
+    insert(:boards, "orphan_board", creator_id: id("missing_user"))
+    insert(:cards, "orphan_card", board_id: id("orphan_board"))
+    insert(:watches, "orphan_watch", card_id: id("orphan_card"))
+
+    migrate
+
+    assert_equal binary_id("second"), @connection.select_value("SELECT account_id FROM boards")
+    assert_equal binary_id("second"), @connection.select_value("SELECT account_id FROM cards")
+    assert_equal 1, @connection.select_value("SELECT COUNT(*) FROM boards")
+    assert_equal 1, @connection.select_value("SELECT COUNT(*) FROM cards")
+    assert_equal 0, @connection.select_value("SELECT COUNT(*) FROM watches")
+  end
+
+  def test_schema_dumps_require_indexed_account_ids_on_all_tenant_tables
+    global_tables = %w[ accounts account_external_id_sequences identities identity_access_tokens magic_links sessions action_pack_passkeys ]
+
+    %w[ schema.rb schema_sqlite.rb ].each do |schema|
+      Rails.root.join("db", schema).read.scan(/create_table "(.*?)"(.*?)\n  end/m).each do |table, definition|
+        unless global_tables.include?(table)
+          assert_match(/t.uuid "account_id", null: false/, definition, "#{schema}: #{table}")
+          assert_includes definition, 't.index ["account_id"', "#{schema}: #{table}"
+        end
+      end
+    end
+  end
+
+  private
+    def create_legacy_schema
+      @connection.create_table(:accounts, id: :uuid) { |t| t.string :label }
+      CompleteAccountIdRollout::EXISTING_TABLES.each do |table, parent|
+        @connection.create_table(table, id: :uuid) do |t|
+          t.string :label
+          t.uuid :account_id
+          t.uuid parent.last if parent
+        end
+      end
+      # Exercise tables whose account index already exists.
+      @connection.add_index :users, :account_id
+      CompleteAccountIdRollout::DEPENDENT_TABLES.each do |table, (_, foreign_key)|
+        @connection.create_table(table, id: table.to_s.include?("filters") ? false : :uuid) do |t|
+          t.string :label
+          t.uuid foreign_key
+        end
+      end
+      CompleteAccountIdRollout::POLYMORPHIC_TABLES.each do |table, (association, _)|
+        @connection.create_table(table, id: :uuid) do |t|
+          t.string :label
+          t.uuid "#{association}_id"
+          t.string "#{association}_type"
+        end
+      end
+      @connection.create_table(:active_storage_blobs, id: :uuid) { |t| t.string :label }
+      @connection.create_table(:active_storage_attachments, id: :uuid) do |t|
+        t.string :label
+        t.uuid :record_id
+        t.string :record_type
+        t.uuid :blob_id
+      end
+      @connection.create_table(:active_storage_variant_records, id: :uuid) do |t|
+        t.string :label
+        t.uuid :blob_id
+      end
+    end
+
+    def tenant_tables
+      CompleteAccountIdRollout::EXISTING_TABLES.keys + CompleteAccountIdRollout::DEPENDENT_TABLES.keys + CompleteAccountIdRollout::POLYMORPHIC_TABLES.keys
+    end
+
+    def insert(table, label, **attributes)
+      attributes = { label: label }.merge(attributes)
+      # Labels used for parent references already include the table name.
+      attributes[:id] = id(label) if @connection.primary_key(table)
+      values = attributes.map do |column, value|
+        value = ActiveRecord::Type::Uuid.new.serialize(value) if column.to_s.end_with?("_id") || column.to_s == "id"
+        @connection.quote(value)
+      end
+      @connection.execute("INSERT INTO #{table} (#{attributes.keys.join(', ')}) VALUES (#{values.join(', ')})")
+    end
+
+    def id(label)
+      @ids[label]
+    end
+
+    def binary_id(label)
+      ActiveRecord::Type::Uuid.new.serialize(id(label))
+    end
+
+    def migrate
+      @migration.suppress_messages { @migration.exec_migration(@connection, :up) }
+    end
+
+    def assert_required_and_indexed(table)
+      refute @connection.columns(table).find { |column| column.name == "account_id" }.null, table.to_s
+      assert @connection.indexes(table).any? { |index| index.columns.first == "account_id" }, table.to_s
+      assert_raises(ActiveRecord::NotNullViolation) { @connection.execute("INSERT INTO #{table} (account_id) VALUES (NULL)") }
+    end
+end
