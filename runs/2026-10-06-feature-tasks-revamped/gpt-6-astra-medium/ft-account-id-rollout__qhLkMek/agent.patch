@@ -0,0 +1,70 @@
+require "test_helper"
+
+class AccountOwnershipTest < ActiveSupport::TestCase
+  test "dependent rows belong to their owner rather than the current account" do
+    Current.with_account(accounts(:initech)) do
+      publication = boards(:writebook).create_publication!
+      total = boards(:writebook).create_storage_total!
+      query = users(:david).search_queries.create!(terms: "tenant ownership")
+
+      [ publication, total, query ].each do |record|
+        assert_equal accounts("37s"), record.reload.account
+      end
+    end
+  end
+
+  test "bulk access grants populate account IDs" do
+    account = accounts("37s")
+    user = account.users.create!(name: "New tenant member")
+    assert user.accesses.any?
+    assert user.accesses.all? { |access| access.account == account }
+
+    boards(:private).accesses.grant_to(user)
+    assert_equal account, boards(:private).accesses.find_by!(user: user).account
+  end
+
+  test "filter memberships populate account IDs in both directions" do
+    filter = users(:david).filters.create!(
+      tags: [ tags(:mobile) ], boards: [ boards(:writebook) ],
+      assignees: [ users(:jz) ], creators: [ users(:kevin) ], closers: [ users(:david) ]
+    )
+
+    %i[ tag board assignee creator closer ].each do |resource|
+      membership = filter.public_send("#{resource}_memberships").sole
+      assert_equal filter.account, membership.account
+    end
+
+    tag = accounts("37s").tags.create!(title: "tenant-join-test")
+    tag.filters << filter
+    assert_equal filter.account, tag.filter_memberships.sole.account
+  end
+
+  test "rich text and attached blobs derive their account without request context" do
+    Current.without_account do
+      card = cards(:logo)
+      card.update!(description: "Account-owned content")
+      card.image.attach(io: StringIO.new("tenant data"), filename: "tenant.txt", content_type: "text/plain")
+
+      assert_equal card.account, card.description.account
+      assert_equal card.account, card.image.attachment.account
+      assert_equal card.account, card.image.blob.account
+
+      variant = card.image.blob.variant_records.create!(variation_digest: "tenant-variant")
+      variant.image.attach(io: StringIO.new("variant data"), filename: "variant.txt", content_type: "text/plain")
+      assert_equal card.account, variant.account
+      assert_equal card.account, variant.image.attachment.account
+      assert_equal card.account, variant.image.blob.account
+    end
+  end
+
+  test "direct uploads belong to the current account" do
+    Current.with_account(accounts(:initech)) do
+      blob = ActiveStorage::Blob.create_before_direct_upload!(filename: "upload.txt", byte_size: 4, checksum: "checksum")
+      assert_equal accounts(:initech), blob.account
+    end
+  end
+
+  test "unsaved search queries can be validated without a user" do
+    assert Search::Query.wrap("search terms").valid?
+  end
+end
