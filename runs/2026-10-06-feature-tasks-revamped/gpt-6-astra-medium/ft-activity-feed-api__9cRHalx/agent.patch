@@ -0,0 +1,61 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat array of account activity accessible to the current user, newest
+first. Results follow the standard [API pagination conventions](../README.md#pagination);
+follow the `Link` response header to retrieve the next page.
+
+The feed includes these actions:
+
+- `card_assigned`
+- `card_unassigned`
+- `card_published`
+- `card_closed`
+- `card_reopened`
+- `card_board_changed`
+- `card_title_changed`
+- `card_postponed`
+- `card_auto_postponed`
+- `card_triaged`
+- `card_sent_back_to_triage`
+- `comment_created`
+
+Deprecated `card_collection_changed` events are not included.
+
+### Filters
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Only events created by these users |
+| `board_ids[]` | Only events from these boards |
+
+Each filter accepts multiple IDs. When both filters are supplied, events must
+match both. Filters never grant access to otherwise inaccessible activity.
+
+### Event fields
+
+| Field | Description |
+|-------|-------------|
+| `id` | Event ID |
+| `action` | One of the actions listed above |
+| `created_at` | Event timestamp in UTC |
+| `description` | The event's plain-text description |
+| `particulars` | Event-specific details, described below |
+| `url` | URL that opens the card, with a comment anchor for comment events |
+| `eventable_type` | `Card` or `Comment` |
+| `eventable` | The standard [card](cards.md) or [comment](comments.md) API representation |
+| `board` | The standard [board](boards.md) API representation |
+| `creator` | The standard [user](users.md) API representation |
+
+### Particulars
+
+| Action | Fields |
+|--------|--------|
+| `card_assigned`, `card_unassigned` | `assignee_ids`: array of user IDs |
+| `card_board_changed` | `old_board`, `new_board`: board names |
+| `card_title_changed` | `old_title`, `new_title`: card titles |
+| `card_triaged` | `column`: column name |
+
+Missing board names, titles, or column names are returned as empty strings.
+All other actions return an empty object (`{}`).
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..6d18bcb
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,227 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "authenticates with a read-only bearer token" do
+    sign_out
+    token = identities(:kevin).access_tokens.create!(description: "Activity reader", permission: "read")
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{token.token}" }
+
+    assert_response :success
+    assert_not_empty response.parsed_body
+  end
+
+  test "index as JSON returns a flat array newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+    assert_equal users(:kevin).accessible_events.order(created_at: :desc, id: :desc).ids, response.parsed_body.pluck("id")
+  end
+
+  test "card events use the existing API representations and plain text descriptions" do
+    event = events(:layout_published)
+
+    get activities_path(format: :json)
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at, Time.iso8601(activity["created_at"])
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal({}, activity["particulars"])
+
+    get card_path(event.eventable, format: :json)
+    assert_equal response.parsed_body.except("steps"), activity["eventable"]
+
+    get board_path(event.board, format: :json)
+    assert_equal response.parsed_body, activity["board"]
+
+    get user_path(event.creator, format: :json)
+    assert_equal response.parsed_body, activity["creator"]
+  end
+
+  test "comment events link to the comment on its card" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path(format: :json)
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(comment.card, comment, format: :json)
+    assert_equal response.parsed_body, activity["eventable"]
+  end
+
+  test "includes timeline actions and title changes but not deprecated or unrelated actions" do
+    actions = %w[
+      card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_title_changed card_postponed card_auto_postponed
+      card_triaged card_sent_back_to_triage comment_created
+    ]
+    actions.each do |action|
+      eventable = action == "comment_created" ? comments(:layout_overflowing_david) : cards(:layout)
+      record_event action, eventable: eventable
+    end
+    record_event "card_collection_changed"
+    record_event "card_resumed"
+    record_event "card_unknown"
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal actions.sort, response.parsed_body.pluck("action").uniq.sort
+  end
+
+  test "assignment particulars contain only assignee ids" do
+    %w[ card_assigned card_unassigned ].each do |action|
+      event = record_event action, particulars: { assignee_ids: [ users(:jz).id ], other: "private" }
+
+      assert_particulars event, "assignee_ids" => [ users(:jz).id ]
+    end
+  end
+
+  test "board title and triage particulars expose event details" do
+    {
+      "card_board_changed" => { "old_board" => "Original board", "new_board" => "New board" },
+      "card_title_changed" => { "old_title" => "Original title", "new_title" => "New title" },
+      "card_triaged" => { "column" => "In progress" }
+    }.each do |action, details|
+      event = record_event action, particulars: { particulars: details.merge("other" => "private") }
+
+      assert_particulars event, details
+    end
+  end
+
+  test "missing board title and column particulars are empty strings" do
+    {
+      "card_board_changed" => { "old_board" => "", "new_board" => "" },
+      "card_title_changed" => { "old_title" => "", "new_title" => "" },
+      "card_triaged" => { "column" => "" }
+    }.each do |action, details|
+      event = record_event action
+      assert_particulars event, details
+
+      event.update!(particulars: { particulars: details.transform_values { nil } })
+      assert_particulars event, details
+    end
+  end
+
+  test "other actions do not expose stored particulars" do
+    event = record_event "card_published", particulars: { assignee_ids: [ users(:jz).id ], particulars: { column: "Hidden" } }
+
+    assert_particulars event, {}
+  end
+
+  test "filters by creators and boards together" do
+    private_card = boards(:private).cards.create!(title: "Private card", creator: users(:kevin))
+    private_event = record_event "card_published", eventable: private_card
+    record_event "card_published", eventable: private_card, creator: users(:david)
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:private).id ] }
+
+    assert_response :success
+    assert_equal [ private_event.id ], response.parsed_body.pluck("id")
+  end
+
+  test "filters by multiple creators and boards" do
+    private_card = boards(:private).cards.create!(title: "Private card", creator: users(:kevin))
+    record_event "card_published", eventable: private_card
+    record_event "card_published", creator: users(:jz)
+
+    get activities_path(format: :json), params: {
+      creator_ids: [ users(:kevin).id, users(:david).id ],
+      board_ids: [ boards(:writebook).id, boards(:private).id ]
+    }
+
+    assert_response :success
+    assert_equal [ users(:kevin).id, users(:david).id ].sort, response.parsed_body.map { |item| item.dig("creator", "id") }.uniq.sort
+    assert_equal [ boards(:writebook).id, boards(:private).id ].sort, response.parsed_body.map { |item| item.dig("board", "id") }.uniq.sort
+  end
+
+  test "unknown filters return no events" do
+    [ { creator_ids: [ "unknown" ] }, { board_ids: [ "unknown" ] } ].each do |filters|
+      get activities_path(format: :json), params: filters
+
+      assert_response :success
+      assert_equal [], response.parsed_body
+    end
+  end
+
+  test "only returns accessible activity even when filtering for inaccessible boards" do
+    logout_and_sign_in_as :david
+    private_card = boards(:private).cards.create!(title: "Private card", creator: users(:kevin))
+    private_event = record_event "card_published", eventable: private_card
+    other_account_event = record_event "card_published", eventable: cards(:radio), creator: users(:mike)
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), private_event.id
+    assert_not_includes response.parsed_body.pluck("id"), other_account_event.id
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:miltons_wish_list).id ] }
+    assert_response :success
+    assert_equal [], response.parsed_body
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id, boards(:private).id ] }
+    assert_response :success
+    assert_not_empty response.parsed_body
+    assert_equal [ boards(:writebook).id ], response.parsed_body.map { |item| item.dig("board", "id") }.uniq
+  end
+
+  test "moving a card to an inaccessible board hides its card and comment activity" do
+    logout_and_sign_in_as :david
+    with_current_user(:kevin) { cards(:layout).move_to(boards(:private)) }
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), events(:layout_published).id
+    assert_not_includes response.parsed_body.pluck("id"), events(:layout_commented).id
+  end
+
+  test "paginates in descending order and preserves filters" do
+    timestamp = Time.current.change(usec: 0)
+    60.times { record_event "card_published", created_at: timestamp }
+    record_event "card_published", creator: users(:david), created_at: timestamp + 1.hour
+
+    expected_ids = users(:kevin).accessible_events.where(creator: users(:kevin), board: boards(:writebook)).order(created_at: :desc, id: :desc).ids
+    actual_ids = []
+    page_count = 0
+    next_page = activities_path(format: :json, creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id ])
+
+    while next_page
+      get next_page
+      assert_response :success
+
+      actual_ids.concat(response.parsed_body.pluck("id"))
+      page_count += 1
+      next_page = response.headers["Link"]&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+    end
+
+    assert_operator page_count, :>, 1
+    assert_equal expected_ids, actual_ids
+  end
+
+  private
+    def record_event(action, eventable: cards(:layout), **attributes)
+      Event.create! action: action, eventable: eventable, board: eventable.board, creator: users(:kevin), **attributes
+    end
+
+    def assert_particulars(event, expected)
+      get activities_path(format: :json)
+      assert_response :success
+      activity = response.parsed_body.find { |item| item["id"] == event.id }
+      assert_equal expected, activity["particulars"]
+    end
+end
