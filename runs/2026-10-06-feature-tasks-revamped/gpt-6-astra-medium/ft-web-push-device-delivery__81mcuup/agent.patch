index 0000000..190013a
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    @subscription = { endpoint: "https://push.example.test/device", p256dh_key: "public-key", auth_key: "auth-key" }
+  end
+
+  test "registers a device and refreshes its keys without duplicates" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+      assert_response :created
+    end
+
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.merge(auth_key: "new-key") }, as: :json
+      assert_response :created
+    end
+    assert_equal "new-key", @user.push_subscriptions.sole.auth_key
+  end
+
+  test "cannot register for another user" do
+    post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @subscription }, as: :json
+    assert_response :forbidden
+  end
+
+  test "requires subscription keys" do
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.except(:auth_key) }, as: :json
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "lists only this user's endpoints without keys" do
+    @user.push_subscriptions.create!(@subscription)
+    users(:kevin).push_subscriptions.create!(@subscription.merge(endpoint: "https://push.example.test/other"))
+
+    get user_push_subscriptions_path(@user), as: :json
+    assert_response :success
+    assert_equal [ @subscription[:endpoint] ], response.parsed_body
+    assert_equal "no-store", response.headers["Cache-Control"]
+  end
+
+  test "disables only the current user's selected device" do
+    phone = @user.push_subscriptions.create!(@subscription)
+    desktop = @user.push_subscriptions.create!(@subscription.merge(endpoint: "https://push.example.test/desktop"))
+    other_user = users(:kevin).push_subscriptions.create!(@subscription)
+
+    assert_difference "PushSubscription.count", -1 do
+      delete user_push_subscriptions_path(@user), params: { endpoint: phone.endpoint }, as: :json
+      assert_response :no_content
+    end
+    assert desktop.reload
+    assert other_user.reload
+  end
+
+  test "cannot list or delete another user's devices" do
+    other = users(:kevin)
+    other.push_subscriptions.create!(@subscription)
+    get user_push_subscriptions_path(other), as: :json
+    assert_response :forbidden
+
+    assert_no_difference "PushSubscription.count" do
+      delete user_push_subscriptions_path(other), params: { endpoint: @subscription[:endpoint] }, as: :json
+      assert_response :forbidden
+    end
+  end
+
+  test "cannot register a device in another account" do
+    post user_push_subscriptions_path(users(:mike)), params: { push_subscription: @subscription }, as: :json
+    assert_response :not_found
+  end
+end
diff --git a/test/jobs/notification/push_job_test.rb b/test/jobs/notification/push_job_test.rb
new file mode 100644
index 0000000..99e9e20
--- /dev/null
+++ b/test/jobs/notification/push_job_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Notification::PushJobTest < ActiveJob::TestCase
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @notification.user.push_subscriptions.create!(endpoint: "https://push.example.test/device", p256dh_key: "key", auth_key: "auth")
+  end
+
+  test "delivers the queued payload" do
+    @subscription.expects(:deliver).with("payload")
+    Notification::PushJob.perform_now(@notification, @subscription, "payload")
+  end
+
+  test "does not deliver after board access is revoked" do
+    @notification.user.accesses.where(board: @notification.card.board).delete_all
+    @subscription.expects(:deliver).never
+    Notification::PushJob.perform_now(@notification, @subscription, "payload")
+  end
+
+  test "does not deliver to an inactive user" do
+    @notification.user.update!(active: false)
+    @subscription.expects(:deliver).never
+    Notification::PushJob.perform_now(@notification, @subscription, "payload")
+  end
+
+  test "deleted subscriptions are discarded" do
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification::PushJob.perform_later(@notification, @subscription, "payload")
+    end
+    @subscription.destroy!
+    PushSubscription.any_instance.expects(:deliver).never
+    perform_enqueued_jobs
+  end
+
+  test "retries temporary push service failures" do
+    @subscription.expects(:deliver).raises(WebPush::PushServiceError.new(stub(body: "unavailable"), "push.example.test"))
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification::PushJob.perform_now(@notification, @subscription, "payload")
+    end
+    assert @subscription.reload
+  end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..cce7644
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @notification = notifications(:logo_assignment_kevin)
+    @user = @notification.user
+    @subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.test/phone", p256dh_key: "key", auth_key: "auth")
+  end
+
+  test "creation queues the tray text and account scoped card URL for every device" do
+    desktop = @user.push_subscriptions.create!(endpoint: "https://push.example.test/desktop", p256dh_key: "key", auth_key: "auth")
+    users(:david).push_subscriptions.create!(endpoint: "https://push.example.test/other-user", p256dh_key: "key", auth_key: "auth")
+    @notification.destroy!
+
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      @notification = Notification.create!(user: @user, source: events(:logo_assignment_km), creator: users(:david))
+    end
+
+    jobs = enqueued_jobs.select { |job| job[:job] == Notification::PushJob }
+    assert_equal [ @subscription, desktop ], jobs.map { |job| ActiveJob::Arguments.deserialize(job[:args])[1] }
+    payload = JSON.parse(ActiveJob::Arguments.deserialize(jobs.first[:args]).last)
+    assert_equal ApplicationController.helpers.event_notification_title(@notification.source), payload["title"]
+    assert_equal ApplicationController.helpers.event_notification_body(@notification.source), payload["body"]
+    assert_equal Rails.application.routes.url_helpers.card_path(@notification.card, script_name: @user.account.slug), payload.dig("data", "url")
+  end
+
+  test "subsequent activity pushes but read state changes do not" do
+    assert_enqueued_jobs 1, only: Notification::PushJob do
+      @notification.update!(source: events(:logo_assignment_jz))
+    end
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.read
+      @notification.unread
+      @notification.touch
+    end
+  end
+
+  test "mentions use the tray text" do
+    mention = mentions(:logo_comment_david_mention_by_jz)
+    @notification.update!(source: mention)
+    job = enqueued_jobs.find { |job| job[:job] == Notification::PushJob }
+    payload = JSON.parse(ActiveJob::Arguments.deserialize(job[:args]).last)
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", payload["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), payload["body"]
+  end
+
+  test "no VAPID configuration means no push jobs" do
+    PushSubscription.stubs(:configured?).returns(false)
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.update!(source: events(:logo_assignment_jz))
+    end
+  end
+end
diff --git a/test/models/push_subscription/request_test.rb b/test/models/push_subscription/request_test.rb
new file mode 100644
index 0000000..0c9a871
--- /dev/null
+++ b/test/models/push_subscription/request_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class PushSubscription::RequestTest < ActiveSupport::TestCase
+  setup do
+    @endpoint = "https://push.example.test/device"
+    device_key = WebPush.generate_key
+    vapid_key = WebPush.generate_key
+    @request = PushSubscription::Request.new(
+      message: { title: "New activity", body: "A comment" }.to_json,
+      subscription: { endpoint: @endpoint, keys: { p256dh: device_key.public_key, auth: Base64.urlsafe_encode64(SecureRandom.random_bytes(16)) } },
+      vapid: { public_key: vapid_key.public_key, private_key: vapid_key.private_key }
+    )
+  end
+
+  test "sends an encrypted and VAPID authenticated request" do
+    SsrfProtection.expects(:resolve_public_ip).with("push.example.test").returns("8.8.8.8")
+    request = stub_request(:post, @endpoint).with(ipaddr: "8.8.8.8").with { |request|
+      request.headers["Authorization"].start_with?("vapid ") &&
+        request.headers["Content-Encoding"] == "aes128gcm" &&
+        !request.body.include?("New activity")
+    }.to_return(status: 201)
+    @request.perform
+    assert_requested request
+  end
+
+  test "refuses endpoints that do not resolve to a public address" do
+    SsrfProtection.expects(:resolve_public_ip).with("push.example.test").returns(nil)
+    assert_raises(WebPush::Error) { @request.perform }
+    assert_not_requested :post, @endpoint
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..a3e7dfa
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.test/device", p256dh_key: "key", auth_key: "auth")
+    PushSubscription.stubs(:configured?).returns(true)
+    ENV.stubs(:fetch).with("VAPID_PUBLIC_KEY").returns("public")
+    ENV.stubs(:fetch).with("VAPID_PRIVATE_KEY").returns("private")
+  end
+
+  test "delivers using the device keys and configured VAPID keys" do
+    request = mock
+    PushSubscription::Request.expects(:new).with(
+      message: "payload",
+      subscription: { endpoint: @subscription.endpoint, keys: { p256dh: "key", auth: "auth" } },
+      vapid: { public_key: "public", private_key: "private" }
+    ).returns(request)
+    request.expects(:perform)
+    @subscription.deliver("payload")
+  end
+
+  test "expired and invalid subscriptions are removed" do
+    [ WebPush::ExpiredSubscription, WebPush::InvalidSubscription ].each do |error|
+      subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.test/#{error.name}", p256dh_key: "key", auth_key: "auth")
+      request = mock
+      PushSubscription::Request.stubs(:new).returns(request)
+      request.expects(:perform).raises(error.new(stub(body: "expired"), "push.example.test"))
+      assert_difference "PushSubscription.count", -1 do
+        subscription.deliver("payload")
+      end
+    end
+  end
+
+  test "temporary push service failures do not delete the subscription" do
+    request = mock
+    PushSubscription::Request.stubs(:new).returns(request)
+    request.expects(:perform).raises(WebPush::PushServiceError.new(stub(body: "unavailable"), "push.example.test"))
+    assert_no_difference "PushSubscription.count" do
+      assert_raises(WebPush::PushServiceError) { @subscription.deliver("payload") }
+    end
+  end
+
+  test "requires an HTTPS endpoint without credentials" do
+    [ "http://push.example.test/device", "https://user:pass@push.example.test/device", "not a URL", "https:///device" ].each do |endpoint|
+      @subscription.endpoint = endpoint
+      assert_not @subscription.valid?
+      assert @subscription.errors[:endpoint].present?
+    end
+  end
+
+  test "destroying a user removes their device subscriptions" do
+    assert_difference "PushSubscription.count", -1 do
+      @subscription.user.destroy!
+    end
+  end
+end
