new file mode 100644
index 0000000..9b37871
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,35 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def index
+    response.headers["Cache-Control"] = "no-store"
+    render json: @user.push_subscriptions.pluck(:endpoint)
+  end
+
+  def create
+    attributes = params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    subscription = @user.push_subscriptions.create_or_find_by!(endpoint_digest: Digest::SHA256.hexdigest(attributes[:endpoint].to_s)) do |record|
+      record.assign_attributes(attributes)
+    end
+    subscription.update!(attributes)
+
+    head :created
+  rescue ActiveRecord::RecordInvalid => error
+    render json: { errors: error.record.errors.full_messages }, status: :unprocessable_entity
+  end
+
+  def destroy
+    @user.push_subscriptions.find_by!(endpoint_digest: Digest::SHA256.hexdigest(params.require(:endpoint))).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..76440c1
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,96 @@
+import { Controller } from "@hotwired/stimulus"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static targets = [ "button", "status", "help" ]
+  static values = { url: String, publicKey: String }
+
+  async connect() {
+    this.enabled = false
+
+    if (!this.publicKeyValue) {
+      this.statusTarget.textContent = "Push notifications are not configured."
+    } else if (!this.#supported) {
+      this.statusTarget.textContent = "This browser does not support push notifications."
+      this.helpTarget.hidden = false
+    } else {
+      try {
+        await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+        this.registration = await navigator.serviceWorker.ready
+        this.subscription = await this.registration.pushManager.getSubscription()
+        const endpoints = await this.#request("GET")
+        this.enabled = Notification.permission === "granted" && endpoints.includes(this.subscription?.endpoint)
+        this.#render()
+      } catch {
+        this.statusTarget.textContent = "Could not load notification settings. Please reload to try again."
+      }
+    }
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+    this.statusTarget.textContent = ""
+
+    try {
+      if (this.enabled) {
+        // Keep the browser subscription: another account may still use this device.
+        await this.#request("DELETE", { endpoint: this.subscription.endpoint })
+        this.enabled = false
+      } else {
+        const permission = await Notification.requestPermission()
+        if (permission === "granted") {
+          this.subscription = await this.registration.pushManager.getSubscription() ||
+            await this.registration.pushManager.subscribe({
+              userVisibleOnly: true,
+              applicationServerKey: this.#applicationServerKey
+            })
+
+          const { endpoint, keys } = this.subscription.toJSON()
+          await this.#request("POST", {
+            push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth }
+          })
+          this.enabled = true
+        }
+      }
+    } catch {
+      this.statusTarget.textContent = "Could not update notifications. Please try again."
+    } finally {
+      this.#render()
+    }
+  }
+
+  #render() {
+    this.element.classList.toggle("notifications--on", this.enabled)
+    this.buttonTarget.textContent = this.enabled ? "Turn off notifications" : "Turn on notifications"
+    this.buttonTarget.disabled = Notification.permission === "denied"
+    this.helpTarget.hidden = Notification.permission !== "denied"
+    if (Notification.permission === "denied") {
+      this.statusTarget.textContent = "Notifications are blocked. Follow the instructions below to allow them."
+    }
+  }
+
+  get #supported() {
+    return window.isSecureContext && "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64 + "=".repeat((4 - base64.length % 4) % 4)
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+
+  async #request(method, body) {
+    const response = await fetch(this.urlValue, {
+      method,
+      cache: "no-store",
+      headers: {
+        "Content-Type": "application/json",
+        "Accept": "application/json",
+        "X-CSRF-Token": getMetaContent("csrf-token")
+      },
+      body: body ? JSON.stringify(body) : undefined
+    })
+    if (!response.ok) throw new Error("Notification request failed")
+    if (method === "GET") return response.json()
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
new file mode 100644
index 0000000..c8f52f2
--- /dev/null
+++ b/app/jobs/notification/push_job.rb
@@ -0,0 +1,11 @@
+class Notification::PushJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::PushServiceError, WebPush::TooManyRequests, Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout,
+    wait: :polynomially_longer, attempts: 5
+
+  def perform(notification, subscription, payload)
+    if subscription.user == notification.user && notification.user.active? && notification.account.active? && notification.user.accessible_cards.exists?(notification.card_id)
+      subscription.deliver(payload)
+    end
+  end
+end
