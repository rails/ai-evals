index 0000000..514cdb1
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  test "rechecks eligibility before incinerating a previously selected account" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 31.days.ago)
+    selected_account = Account.due_for_incineration.find(account.id)
+
+    account.reactivate
+
+    assert_no_difference "Account.count" do
+      selected_account.incinerate
+    end
+  end
+
+  test "uses the current cancellation after an account is reactivated and cancelled again" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 31.days.ago)
+    selected_account = Account.due_for_incineration.find(account.id)
+
+    account.reactivate
+    account.reload.cancel(initiated_by: users(:david))
+
+    assert_no_difference "Account.count" do
+      selected_account.incinerate
+    end
+  end
+end
