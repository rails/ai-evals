diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..649696c
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago and their data" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 31.days.ago)
+
+    card = cards(:logo)
+    card.image.attach io: StringIO.new("image"), filename: "image.png", content_type: "image/png"
+    ActiveStorage::Blob.create_and_upload!(io: StringIO.new("unused"), filename: "unused.txt")
+    account.materialize_storage
+    card.board.materialize_storage
+    owner_ids = [ account.id, *account.boards.ids ]
+    other_account = accounts(:initech)
+    other_account_counts = account_record_counts(other_account)
+    identity_ids = Identity.ids
+
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_not Storage::Total.where(owner_id: owner_ids).exists?
+    assert Account.exists?(other_account.id)
+    assert_equal other_account_counts, account_record_counts(other_account)
+    assert_equal identity_ids.sort, Identity.ids.sort
+
+    account_record_counts(account).each do |table, count|
+      assert_equal 0, count, "Account data remains in #{table}"
+    end
+
+    assert_no_difference "Account.count" do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+  end
+
+  test "preserves active accounts and cancellations within the retention period" do
+    freeze_time do
+      account = accounts(:"37s")
+      account.cancel(initiated_by: users(:david))
+      account.cancellation.update!(created_at: 30.days.ago)
+
+      assert_no_difference "Account.count" do
+        Current.without_account { Account::IncinerateDueJob.perform_now }
+      end
+
+      travel 1.second
+
+      assert_difference "Account.count", -1 do
+        Current.without_account { Account::IncinerateDueJob.perform_now }
+      end
+    end
+  end
+
+  test "preserves recently cancelled and reactivated accounts" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+
+    assert_no_difference "Account.count" do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+
+    account.cancellation.update!(created_at: 31.days.ago)
+    account.reactivate
+
+    assert_no_difference "Account.count" do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+  end
+
+  test "incinerates all due accounts" do
+    [ accounts(:"37s"), accounts(:initech) ].each do |account|
+      account.cancel(initiated_by: account.users.first)
+      account.cancellation.update!(created_at: 31.days.ago)
+    end
+
+    assert_difference "Account.count", -2 do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+  end
+
+  private
+    def account_record_counts(account)
+      connection = ApplicationRecord.connection
+
+      connection.tables.filter_map do |table|
+        if connection.columns(table).any? { |column| column.name == "account_id" }
+          count = connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{connection.quote(account.id)}")
+          [ table, count ]
+        end
+      end.to_h
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
