diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..adec730
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,239 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:layout)
+    @column = columns(:writebook_in_progress)
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@card, :article)}", visible: :all
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+  end
+
+  test "dropping moves immediately and saving does not move the card again" do
+    hold_requests
+    drag_card_to dom_id(@column)
+
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_equal columns(:writebook_triage), @card.reload.column
+
+    release_requests
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+    assert_equal @column, @card.reload.column
+    assert_equal dom_id(@card, :article), card_ids_in(dom_id(@column)).first
+
+    refresh
+    assert_equal dom_id(@card, :article), card_ids_in(dom_id(@column)).first
+  end
+
+  test "native dragging moves a card" do
+    find("##{dom_id(@card.column)} .cards__expander").click
+    find("##{dom_id(@card, :article)}").drag_to(find("##{dom_id(@column)} .cards__expander"))
+
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+    assert_equal @column, @card.reload.column
+    assert_no_selector ".drag-and-drop__hover-container, .drag-and-drop__dragged-item", visible: :all
+  end
+
+  test "golden cards stay first regardless of where the pointer drops" do
+    Current.user = users(:david)
+    golden_card = cards(:logo)
+    golden_card.triage_into(@column)
+    refresh
+    assert_selector "##{dom_id(@column)} ##{dom_id(golden_card, :article)}", visible: :all
+
+    hold_requests
+    drag_card_to dom_id(@column)
+    assert_equal [ golden_card, @card, cards(:text) ].map { |card| dom_id(card, :article) }, card_ids_in(dom_id(@column))
+    release_requests
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+    refresh
+    assert_equal [ golden_card, @card, cards(:text) ].map { |card| dom_id(card, :article) }, card_ids_in(dom_id(@column))
+  end
+
+  test "cards can move through every status and into an empty column" do
+    [ "closed-cards", "not-now", "maybe", dom_id(columns(:writebook_on_hold)), "closed-cards", "maybe" ].each do |destination|
+      assert_selector "##{destination} .cards__list", visible: :all
+      hold_requests
+      drag_card_to destination
+      assert_selector "##{destination} ##{dom_id(@card, :article)}", visible: :all
+      assert_equal dom_id(@card, :article), card_ids_in(destination).first
+      release_requests
+      assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+
+      case destination
+      when "closed-cards" then assert @card.reload.closed?
+      when "not-now" then assert @card.reload.postponed?
+      when "maybe" then assert @card.reload.awaiting_triage?
+      else assert_equal columns(:writebook_on_hold), @card.reload.column
+      end
+    end
+  end
+
+  test "dropping in the same column or outside the board does nothing" do
+    source = dom_id(@card.column)
+    original_order = card_ids_in(source)
+    hold_requests
+    drag_card_to source
+    drag_card_to "cards_container"
+
+    assert_equal original_order, card_ids_in(source)
+    assert_equal 0, page.evaluate_script("window.heldRequests.length")
+    assert_no_selector ".drag-and-drop__hover-container, .drag-and-drop__dragged-item", visible: :all
+  end
+
+  test "a failed save restores the original position appearance and counts" do
+    source = dom_id(@card.column)
+    original_order = card_ids_in(source)
+    source_count = find("##{source} [data-card-count]")["data-card-count"]
+    destination_count = find("##{dom_id(@column)} [data-card-count]")["data-card-count"]
+    original_style = find("##{dom_id(@card, :article)}", visible: :all)[:style]
+    page.execute_script <<~JS
+      window.originalFetch = window.fetch
+      window.fetch = (...args) => args[1]?.method === "POST" ? Promise.resolve(new Response("", { status: 422 })) : window.originalFetch(...args)
+    JS
+
+    accept_alert("This card could not be moved. Please try again.") { drag_card_to dom_id(@column) }
+    assert_equal original_order, card_ids_in(source)
+    assert_equal source_count, find("##{source} [data-card-count]")["data-card-count"]
+    assert_equal destination_count, find("##{dom_id(@column)} [data-card-count]")["data-card-count"]
+    assert_equal original_style, find("##{dom_id(@card, :article)}", visible: :all)[:style]
+    assert_no_selector ".drag-and-drop__hover-container, .drag-and-drop__dragged-item, article[aria-busy]", visible: :all
+  end
+
+test "golden cards go first in active columns but status columns use recency" do
+  Current.user = users(:david)
+  @card.gild
+  cards(:logo).triage_into(@column)
+  refresh
+  assert_selector "##{dom_id(@card, :article)}.golden-effect", visible: :all
+
+  [ dom_id(@column), "not-now", "closed-cards" ].each do |destination|
+    hold_requests
+    drag_card_to destination
+    assert_equal dom_id(@card, :article), card_ids_in(destination).first
+    release_requests
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+  end
+
+  # A non-golden card belongs above the golden card in Done.
+  @card = cards(:text)
+  hold_requests
+  drag_card_to "closed-cards"
+  assert_equal dom_id(@card, :article), card_ids_in("closed-cards").first
+  release_requests
+  assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+  refresh
+  assert_equal dom_id(@card, :article), card_ids_in("closed-cards").first
+end
+
+test "a network failure rolls back and allows a retry" do
+  source = dom_id(@card.column)
+  page.execute_script <<~JS
+    window.originalFetch = window.fetch
+    window.fetch = (...args) => args[1]?.method === "POST" ? Promise.reject(new TypeError("Network error")) : window.originalFetch(...args)
+  JS
+  accept_alert("This card could not be moved. Please try again.") { drag_card_to dom_id(@column) }
+  assert_selector "##{source} ##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+
+  page.execute_script "window.fetch = window.originalFetch"
+  drag_card_to dom_id(@column)
+  assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+  assert_equal @column, @card.reload.column
+end
+
+  test "drag feedback follows the pointer and cancellation clears it" do
+    source = dom_id(@card.column)
+    original_order = card_ids_in(source)
+    page.execute_script <<~JS, dom_id(@card, :article), dom_id(@column)
+      window.draggedCard = document.getElementById(arguments[0])
+      window.dropColumn = document.getElementById(arguments[1])
+      window.dragData = new DataTransfer()
+      window.draggedCard.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer: window.dragData }))
+      window.dropColumn.querySelector("h2").dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: window.dragData }))
+    JS
+    assert_selector "##{dom_id(@card, :article)}.drag-and-drop__dragged-item", visible: :all
+    assert_selector "##{dom_id(@column)}.drag-and-drop__hover-container", visible: :all
+
+    page.execute_script <<~JS
+      window.dropColumn.dispatchEvent(new DragEvent("dragleave", { bubbles: true }))
+      window.draggedCard.dispatchEvent(new DragEvent("dragend", { bubbles: true }))
+    JS
+    assert_no_selector ".drag-and-drop__hover-container, .drag-and-drop__dragged-item", visible: :all
+    assert_equal original_order, card_ids_in(source)
+  end
+
+  test "pending cards cannot start another move" do
+    hold_requests
+    drag_card_to dom_id(@column)
+    drag_card_to "maybe"
+
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_equal 1, page.evaluate_script("window.heldRequests.length")
+    release_requests
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+    assert_equal @column, @card.reload.column
+  end
+
+  test "the originating refresh broadcast does not reload the board" do
+    hold_requests
+    drag_card_to dom_id(@column)
+    release_requests
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+    assert page.evaluate_script("Boolean(window.moveRequestId)")
+
+    requests = page.evaluate_async_script <<~JS
+      const done = arguments[arguments.length - 1]
+      let requests = 0
+      const listener = () => requests++
+      document.addEventListener("turbo:before-fetch-request", listener)
+      window.Turbo.renderStreamMessage(`<turbo-stream action="refresh" request-id="${window.moveRequestId}"></turbo-stream>`)
+      setTimeout(() => {
+        document.removeEventListener("turbo:before-fetch-request", listener)
+        done(requests)
+      }, 500)
+    JS
+    assert_equal 0, requests
+    assert_equal dom_id(@card, :article), card_ids_in(dom_id(@column)).first
+  end
+
+  private
+    def hold_requests
+      page.execute_script <<~JS
+        window.originalFetch = window.fetch
+        window.heldRequests = []
+        window.fetch = (...args) => {
+          if (["POST", "DELETE"].includes(args[1]?.method?.toUpperCase())) {
+            window.moveRequestId = new Headers(args[1].headers).get("X-Turbo-Request-Id")
+            return new Promise((resolve, reject) => {
+              window.heldRequests.push(() => window.originalFetch(...args).then(resolve, reject))
+            })
+          }
+          return window.originalFetch(...args)
+        }
+      JS
+    end
+
+    def release_requests
+      page.execute_script "window.fetch = window.originalFetch; window.heldRequests.forEach(request => request())"
+    end
+
+    def drag_card_to(column_id)
+      page.execute_script <<~JS, dom_id(@card, :article), column_id
+        const card = document.getElementById(arguments[0])
+        const column = document.getElementById(arguments[1])
+        const dataTransfer = new DataTransfer()
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+      JS
+    end
+
+    def card_ids_in(column_id)
+      all("##{column_id} article.card", visible: :all).map { |card| card[:id] }
+    end
+end
