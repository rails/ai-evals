diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..8b192e3
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,189 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "container", "item", "stamp" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  connect() {
+    this.pending = new Set()
+  }
+
+  disconnect() {
+    this.end()
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  itemTargetDisconnected(item) {
+    item.draggable = false
+  }
+
+  start(event) {
+    const item = event.target.closest('[data-drag-and-drop-target~="item"]')
+    if (!item || this.pending.has(item) || !this.#containerFor(item)) {
+      event.preventDefault()
+      return
+    }
+
+    this.draggedItem = item
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+    item.classList.add(this.draggedItemClass)
+  }
+
+  over(event) {
+    const container = this.#destinationFor(event)
+    this.#highlight(container)
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (!this.hoverContainer?.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const container = this.#destinationFor(event)
+    if (container) {
+      event.preventDefault()
+      const item = this.draggedItem
+      this.end()
+      this.#move(item, container)
+    }
+  }
+
+  end() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.draggedItem = null
+    this.#highlight(null)
+  }
+
+  #containerFor(element) {
+    const container = element.closest('[data-drag-and-drop-target~="container"]')
+    return this.containerTargets.includes(container) ? container : null
+  }
+
+  #destinationFor(event) {
+    const container = this.#containerFor(event.target)
+    if (this.draggedItem && container && container !== this.#containerFor(this.draggedItem) && container.querySelector(".cards__list")) {
+      return container
+    }
+  }
+
+  #highlight(container) {
+    this.hoverContainer?.classList.remove(this.hoverContainerClass)
+    this.hoverContainer = container
+    this.hoverContainer?.classList.add(this.hoverContainerClass)
+  }
+
+  async #move(item, destination) {
+    const source = this.#containerFor(item)
+    const original = item.cloneNode(true)
+    const placeholder = document.createComment("card position")
+    item.before(placeholder)
+    this.pending.add(item)
+    item.setAttribute("aria-busy", "true")
+
+    this.#insert(item, destination)
+    this.#updateAppearance(item, destination)
+    this.#changeCount(source, -1)
+    this.#changeCount(destination, 1)
+
+    try {
+      const response = await this.#save(item, destination)
+      if (!response.ok || response.redirected) throw new Error("Unable to move card")
+    } catch {
+      item.remove()
+      placeholder.replaceWith(original)
+      this.#changeCount(source, 1)
+      this.#changeCount(destination, -1)
+      window.alert("This card could not be moved. Please try again.")
+    } finally {
+      placeholder.remove()
+      item.removeAttribute("aria-busy")
+      this.pending.delete(item)
+    }
+  }
+
+  #insert(item, container) {
+    const kind = container.dataset.dragAndDropKind
+    const goldenFirst = kind === "column" || kind === "stream"
+    const cards = Array.from(container.querySelectorAll("article.card"))
+    // Moving updates last activity. Preserve the destination's golden-first ordering.
+    const next = cards.find(card => !goldenFirst || item.classList.contains("golden-effect") || !card.classList.contains("golden-effect"))
+    if (next) {
+      next.before(item)
+    } else if (cards.length) {
+      cards.at(-1).after(item)
+    } else {
+      container.querySelector(".cards__list").prepend(item)
+    }
+  }
+
+  #updateAppearance(item, container) {
+    const kind = container.dataset.dragAndDropKind
+    const active = kind === "column" || kind === "stream"
+    const columnId = kind === "closed" ? item.dataset.dragAndDropColumnId : container.dataset.dragAndDropColumnId || ""
+    item.dataset.dragAndDropColumnId = columnId
+    item.classList.toggle("card--active", active)
+    item.classList.toggle("card--postponed", kind === "not-now")
+    item.querySelectorAll(".card__closed, .bubble").forEach(element => element.remove())
+
+    if (kind !== "closed") {
+      item.style.setProperty("--card-color", container.style.getPropertyValue("--card-color") || "var(--color-card-default)")
+    }
+    item.querySelectorAll(".card__stages [data-column-id]").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", stage.dataset.columnId === columnId)
+    })
+
+    if (!active) {
+      const stamp = this.stampTarget.content.firstElementChild.cloneNode(true)
+      const title = kind === "closed" ? "Done" : "Not Now"
+      const titleElement = stamp.querySelector(".card__closed-title")
+      titleElement.textContent = title
+      titleElement.dataset.text = title
+      stamp.querySelector(".card__closed-date").textContent = new Date().toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" })
+      item.querySelector(".card__body").append(stamp)
+    }
+
+    if (kind === "closed") {
+      delete item.dataset.cardClosureUrl
+      delete item.dataset.cardNotNowUrl
+    } else {
+      item.dataset.cardAssignToSelfUrl = item.dataset.dragAndDropAssignToSelfUrl
+      item.dataset.action = "mouseenter->navigable-list#hoverSelect"
+      item.dataset.cardClosureUrl = item.dataset.dragAndDropClosureUrl
+      item.dataset.cardNotNowUrl = item.dataset.dragAndDropNotNowUrl
+    }
+  }
+
+  #changeCount(container, change) {
+    const counter = container.querySelector("[data-card-count]")
+    const count = Number(counter.dataset.cardCount) + change
+    counter.dataset.cardCount = count
+    counter.querySelector(".cards__expander-count").textContent = count > 99 ? "99+" : count
+    counter.style.setProperty("--card-count", Math.min(container.querySelectorAll("article.card").length, 15))
+  }
+
+  #save(item, container) {
+    // request.js uses Turbo.fetch, which suppresses refresh broadcasts from our own save.
+    const options = { responseKind: "json" }
+    switch (container.dataset.dragAndDropKind) {
+      case "column":
+        return post(item.dataset.dragAndDropTriageUrl, { ...options, body: { column_id: container.dataset.dragAndDropColumnId } })
+      case "stream":
+        return destroy(item.dataset.dragAndDropTriageUrl, options)
+      case "not-now":
+        return post(item.dataset.dragAndDropNotNowUrl, options)
+      case "closed":
+        return post(item.dataset.dragAndDropClosureUrl, options)
+    }
+  }
+}
