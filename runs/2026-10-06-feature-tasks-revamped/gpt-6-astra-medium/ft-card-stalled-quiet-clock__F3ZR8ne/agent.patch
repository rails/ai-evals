diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..4d57b27
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,196 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    freeze_time
+    @card = boards(:writebook).cards.create!(title: "Burst of attention", status: :published)
+  end
+
+  test "a burst followed by two weeks of inactivity stalls a card" do
+    comment_by :david
+    comment_by :kevin
+    assert_not @card.reload.stalled?
+
+    comment_by :david
+    assert_equal Time.current, @card.reload.last_burst_at
+    assert_not @card.stalled?
+
+    travel 2.weeks - 1.second
+    assert_not @card.stalled?
+    travel 1.second
+    assert @card.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    comment_by :kevin
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "quiet cards without a burst do not stall" do
+    travel 3.weeks
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "three comments from one person are not a burst" do
+    3.times { comment_by :david }
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not count towards a burst" do
+    comment_by :david
+    comment_by :kevin
+    @card.comments.create!(body: "System comment", creator: @card.account.system_user)
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments at the edge of a third of the board period form a burst" do
+    @card.board.update! auto_postpone_period: 3.days
+    comment_by :david
+    travel 1.day
+    comment_by :kevin
+    comment_by :david
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "comments outside the burst window do not count" do
+    @card.board.update! auto_postpone_period: 3.days
+    comment_by :david
+    travel 1.day + 1.second
+    comment_by :kevin
+    comment_by :david
+    assert_nil @card.reload.last_burst_at
+
+    comment_by :kevin
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "burst window falls back to the account period" do
+    @card.board.entropy.destroy!
+    @card.board.reload
+    comment_by :david
+    travel @card.account.entropy.auto_postpone_period / 3 + 1.second
+    comment_by :kevin
+    comment_by :david
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "assignment creates a burst but unassignment does not" do
+    @card.toggle_assignment(users(:kevin))
+    burst_at = @card.reload.last_burst_at
+    assert_equal Time.current, burst_at
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+    @card.toggle_assignment(users(:kevin))
+    assert_equal burst_at, @card.reload.last_burst_at
+    assert_not @card.stalled?
+  end
+
+  test "reopening creates a burst but closing does not" do
+    @card.close
+    assert_nil @card.reload.last_burst_at
+    @card.reopen
+    assert_equal Time.current, @card.reload.last_burst_at
+    travel 2.weeks
+    assert @card.stalled?
+  end
+
+  test "closed postponed and drafted cards are not stalled" do
+    @card.register_burst
+    @card.close
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reopen
+    @card.postpone
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.update! status: :drafted
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "editing the card resets the inactivity period" do
+    @card.register_burst
+    travel 2.weeks
+    assert @card.reload.stalled?
+    @card.update! description: "Updated description"
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "checklist changes and reactions reset inactivity" do
+    @card.register_burst
+    travel 2.weeks
+    assert @card.reload.stalled?
+    step = @card.steps.create!(content: "Do something")
+    assert_not @card.reload.stalled?
+    travel 2.weeks
+    assert @card.reload.stalled?
+    step.update!(completed: true)
+    assert_not @card.reload.stalled?
+    travel 2.weeks
+    @card.reactions.create!(content: "👍", reacter: users(:david))
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "editing and deleting comments resets inactivity" do
+    comment = comment_by :david
+    @card.register_burst
+    travel 2.weeks
+    assert @card.reload.stalled?
+    comment.update!(body: "Updated comment")
+    assert_not @card.reload.stalled?
+    travel 2.weeks
+    assert @card.reload.stalled?
+    comment.destroy!
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "tagging and removing reactions reset inactivity" do
+    @card.register_burst
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+    travel 2.weeks
+    assert @card.reload.stalled?
+    reaction.destroy!
+    assert_not @card.reload.stalled?
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+    @card.toggle_tag_with("important")
+    assert_not @card.reload.stalled?
+  end
+
+  test "changing board settings does not count as card activity" do
+    @card.register_burst
+    travel 2.weeks
+    assert @card.reload.stalled?
+    @card.board.update! auto_postpone_period: 365.days
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "comment bursts are isolated to each card" do
+    other_card = boards(:writebook).cards.create!(title: "Another card", status: :published)
+    comment_by :david
+    comment_by :kevin
+    other_card.comments.create!(body: "Unrelated", creator: users(:kevin))
+    assert_nil @card.reload.last_burst_at
+    assert_nil other_card.reload.last_burst_at
+  end
+
+  private
+    def comment_by(user)
+      @card.comments.create!(body: "A comment", creator: users(user))
+    end
+end
