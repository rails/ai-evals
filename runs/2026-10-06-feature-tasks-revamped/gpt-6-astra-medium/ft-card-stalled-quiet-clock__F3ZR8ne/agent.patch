diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..e7f9f69
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,28 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> do
+      cutoff = STALL_PERIOD.ago
+      active.where.not(last_burst_at: nil).where(last_active_at: ..cutoff)
+    end
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at.present? && last_active_at <= STALL_PERIOD.ago && active?
+  end
+
+  def register_burst
+    update! last_burst_at: Time.current
+  end
+
+  def register_comment_burst
+    recent_comments = comments.by_user.where(created_at: (Time.current - auto_postpone_period / 3.0)..Time.current)
+
+    if recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+      register_burst
+    end
+  end
+end
