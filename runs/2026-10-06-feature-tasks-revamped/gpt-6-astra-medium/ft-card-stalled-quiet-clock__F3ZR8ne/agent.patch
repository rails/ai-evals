@@ -10,6 +10,57 @@ class CardsControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
   end
 
+  test "index can list only accessible stalled cards" do
+    cards(:logo).update_columns(last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+    cards(:layout).update_columns(last_burst_at: 3.weeks.ago, last_active_at: 1.day.ago)
+    cards(:radio).update_columns(last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_equal [ cards(:logo).id ], response.parsed_body.pluck("id")
+    assert_equal true, response.parsed_body.first["stalled"]
+
+    get cards_path, params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled", count: 1
+  end
+
+  test "stalled cards are marked on the full card and clear after activity" do
+    card = cards(:logo)
+    card.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+
+    get card_path(card)
+    assert_response :success
+    assert_select ".card--stalled .card__stalled", text: "Stalled"
+
+    card.comments.create!(body: "Still working on it", creator: users(:kevin))
+    get card_path(card)
+    assert_select ".card__stalled", count: 0
+  end
+
+  test "cached card displays become stalled after two weeks without a write" do
+    freeze_time
+    card = cards(:logo)
+    card.update_columns(last_burst_at: Time.current, last_active_at: Time.current)
+
+    with_view_caching do
+      get card_path(card)
+      assert_select ".card__stalled", count: 0
+      get cards_path
