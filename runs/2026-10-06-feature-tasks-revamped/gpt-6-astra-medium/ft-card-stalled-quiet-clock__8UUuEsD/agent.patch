diff --git a/test/integration/stalled_cards_test.rb b/test/integration/stalled_cards_test.rb
new file mode 100644
index 0000000..4f51e10
--- /dev/null
+++ b/test/integration/stalled_cards_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class StalledCardsTest < ActionDispatch::IntegrationTest
+  setup do
+    freeze_time
+    sign_in_as :kevin
+    @card = cards(:layout)
+    Current.set(user: users(:kevin)) { @card.toggle_assignment(users(:kevin)) }
+  end
+
+  test "stalled index returns only accessible stalled cards in HTML and JSON" do
+    cards(:radio).update_columns(last_burst_at: Time.current)
+    travel 2.weeks
+
+    get cards_path(indexed_by: :stalled)
+    assert_response :success
+    assert_select ".card__stalled", count: 1
+    assert_select "##{dom_id(@card, :article)} .card__stalled"
+
+    get cards_path(indexed_by: :stalled, format: :json)
+    assert_response :success
+    assert_equal [ @card.number ], response.parsed_body.pluck("number")
+    assert_equal true, response.parsed_body.first["stalled"]
+
+    get cards_path(indexed_by: :stalled, board_ids: [ boards(:private).id ], format: :json)
+    assert_response :success
+    assert_empty response.parsed_body
+  end
+
+  test "cached previews and card details change as time passes and activity resumes" do
+    with_actionview_partial_caching do
+      [ cards_path, card_path(@card) ].each do |path|
+        get path
+        assert_response :success
+        assert_select ".card__stalled", count: 0
+      end
+
+      get card_path(@card, format: :json)
+      assert_response :success
+      assert_equal false, response.parsed_body["stalled"]
+
+      travel 2.weeks
+      get card_path(@card, format: :json)
+      assert_response :success
+      assert_equal true, response.parsed_body["stalled"]
+
+      [ cards_path, card_path(@card) ].each do |path|
+        get path
+        assert_response :success
+        assert_select ".card__stalled", count: 1
+      end
+
+      @card.update!(description: "Back to work")
+      [ cards_path, card_path(@card) ].each do |path|
+        get path
+        assert_response :success
+        assert_select ".card__stalled", count: 0
+      end
+    end
+  end
+
+  test "column etag changes when a card becomes stalled" do
+    path = board_column_path(@card.board, @card.column)
+    get path
+    assert_response :success
+    etag = response.headers["ETag"]
+
+    travel 2.weeks
+    get path, headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_select ".card__stalled", count: 1
+  end
+
+  test "stalled status appears on public cards and board previews" do
+    @card.board.publish
+    travel 2.weeks
+    sign_out
+
+    get public_board_card_path(@card.board.publication.key, @card)
+    assert_response :success
+    assert_select ".card__stalled", count: 1
+
+    get public_board_column_path(@card.board.publication.key, @card.column)
+    assert_response :success
+    assert_select ".card__stalled", count: 1
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..bd2b801
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,154 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create!(title: "Burst then quiet", status: :published)
+  end
+
+  test "a comment burst stalls after two weeks without activity" do
+    freeze_time
+    @card.comments.create!(body: "First", creator: users(:david))
+    @card.comments.create!(body: "Second", creator: users(:kevin))
+    @card.comments.create!(body: "Third", creator: users(:david))
+
+    assert_not @card.reload.stalled?
+    travel 2.weeks - 1.second
+    assert_not @card.stalled?
+    travel 1.second
+    assert @card.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.comments.create!(body: "Still working", creator: users(:kevin))
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+  end
+  test "quiet cards without a burst do not stall" do
+    travel 3.weeks
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "a burst requires three comments from at least two people" do
+    3.times { @card.comments.create!(body: "Thinking", creator: users(:david)) }
+    assert_nil @card.reload.last_burst_at
+
+    @card.comments.create!(body: "Agreed", creator: users(:kevin))
+    assert_not_nil @card.reload.last_burst_at
+  end
+
+  test "two comments from different people are not a burst" do
+    @card.comments.create!(body: "First", creator: users(:david))
+    @card.comments.create!(body: "Second", creator: users(:kevin))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    @card.comments.create!(body: "First", creator: users(:david))
+    @card.comments.create!(body: "Second", creator: users(:david))
+    @card.comments.create!(body: "Automatic", creator: @card.account.system_user)
+    @card.comments.create!(body: "Third", creator: users(:david))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments outside a third of the board period do not count" do
+    freeze_time
+    @card.board.update!(auto_postpone_period: 3.days)
+    @card.comments.create!(body: "First", creator: users(:david))
+    travel 1.day + 1.second
+    @card.comments.create!(body: "Second", creator: users(:kevin))
+    @card.comments.create!(body: "Third", creator: users(:david))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments exactly a third of the board period apart count" do
+    freeze_time
+    @card.board.update!(auto_postpone_period: 3.days)
+    @card.comments.create!(body: "First", creator: users(:david))
+    travel 1.day
+    @card.comments.create!(body: "Second", creator: users(:kevin))
+    @card.comments.create!(body: "Third", creator: users(:david))
+    assert_not_nil @card.reload.last_burst_at
+  end
+
+  test "comment bursts use the account period when the board has no override" do
+    @card.board.entropy.destroy!
+    @card.board.reload
+    @card.account.entropy.update!(auto_postpone_period: 90.days)
+    @card.comments.create!(body: "First", creator: users(:david))
+    travel 20.days
+    @card.comments.create!(body: "Second", creator: users(:kevin))
+    @card.comments.create!(body: "Third", creator: users(:david))
+    assert_not_nil @card.reload.last_burst_at
+  end
+
+  test "assignment and reopening each create a burst" do
+    freeze_time
+    @card.toggle_assignment(users(:kevin))
+    assert_equal Time.current, @card.reload.last_burst_at
+
+    @card.close
+    travel 1.day
+    @card.reopen
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "unassignment does not create another burst" do
+    freeze_time
+    @card.toggle_assignment(users(:kevin))
+    burst_at = @card.reload.last_burst_at
+    travel 1.day
+    @card.toggle_assignment(users(:kevin))
+    assert_equal burst_at, @card.reload.last_burst_at
+    assert_equal Time.current, @card.last_active_at
+  end
+
+  test "closed postponed and drafted cards do not stall" do
+    @card.toggle_assignment(users(:kevin))
+    @card.close
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reopen
+    @card.postpone
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.drafted!
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "all content activity restarts the inactivity clock without forgetting the burst" do
+    freeze_time
+    @card.toggle_assignment(users(:kevin))
+    burst_at = @card.reload.last_burst_at
+    comment = @card.comments.create!(body: "Initial comment", creator: users(:kevin))
+
+    activities = [
+      -> { @card.update!(title: "Updated title") },
+      -> { @card.update!(description: "Updated description") },
+      -> { @card.steps.create!(content: "Next step") },
+      -> { @card.steps.last.update!(completed: true) },
+      -> { @card.steps.last.destroy! },
+      -> { comment.update!(body: "Updated comment") },
+      -> { comment.destroy! },
+      -> { @card.toggle_tag_with("Important") },
+      -> { @card.gild },
+      -> { @card.reactions.create!(content: "👍") },
+      -> { @card.reactions.last.destroy! }
+    ]
+
+    activities.each do |activity|
+      travel 2.weeks
+      assert @card.reload.stalled?
+      activity.call
+      assert_not @card.reload.stalled?
+      assert_equal Time.current, @card.last_active_at
+      assert_equal burst_at, @card.last_burst_at
+    end
+  end
+end
