diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..d750e6a
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,25 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at.present? && last_active_at <= STALLED_AFTER.ago && active?
+  end
+
+  def register_burst(event)
+    if event.action.in?(%w[ card_assigned card_reopened ]) || (event.action == "comment_created" && comment_burst?)
+      update! last_burst_at: Time.current
+    end
+  end
+
+  private
+    def comment_burst?
+      recent_comments = comments.by_user.where(created_at: (auto_postpone_period / 3.0).seconds.ago..Time.current)
+      recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+    end
+end
