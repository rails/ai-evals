+<%= tag.article id: dom_id(card, :search), class: "search-result margin-block" do %>
+  <h2><%= link_to highlight_search_text(card.title, @terms), card_path(card) %></h2>
+  <p class="txt-small txt-subtle"><%= card.board.name %> · <%= local_datetime_tag card.created_at, style: :date %></p>
+
+  <% if card.description.present? %>
+    <p><%= search_excerpt(card.description.to_plain_text, @terms) %></p>
+  <% end %>
+
+  <% matching_search_comments(card, @terms).each do |comment| %>
+    <blockquote>
+      <%= link_to card_path(card, anchor: dom_id(comment)) do %>
+        <%= search_excerpt(comment.body.to_plain_text, @terms) %>
+      <% end %>
+    </blockquote>
+  <% end %>
+<% end %>
