diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..9982c24
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,199 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "search finds titles and highlights matching text" do
+    get search_path, params: { q: "LOGO" }
+
+    assert_response :success
+    assert_results cards(:logo)
+    assert_select "#search_results a[href=?] mark", card_path(cards(:logo)), text: "logo"
+    assert_select "form[method=get][action=?] input[name=q][value=LOGO]", search_path
+  end
+
+  test "search finds descriptions and any comment body once per card newest first" do
+    older = create_card(title: "Needle in the title", created_at: 3.days.ago)
+    middle = create_card(description: "<p>A <strong>needle</strong> in the description</p>", created_at: 2.days.ago)
+    newer = create_card(created_at: 1.day.ago)
+    2.times { newer.comments.create!(body: "A NEEDLE in a comment", creator: users(:kevin)) }
+    older.comments.create!(body: "Another needle", creator: users(:kevin))
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_results newer, middle, older
+    assert_select "#search_card_#{middle.id} p mark", text: "needle"
+    assert_select "#search_card_#{newer.id} blockquote mark", text: "NEEDLE", count: 2
+  end
+
+  test "each word can match a different field" do
+    card = create_card(title: "Release notes", description: "A special milestone")
+    card.comments.create!(body: "Ready to deploy", creator: users(:kevin))
+
+    get search_path, params: { q: " release   milestone DEPLOY " }
+    assert_results card
+    assert_select "#search_results mark", count: 3
+
+    get search_path, params: { q: "release missingword" }
+    assert_results
+  end
+
+  test "only currently accessible boards are searched" do
+    visible = create_card(title: "Needle")
+    private_card = create_card(title: "Needle", board: boards(:private))
+    cards(:radio).update_column(:title, "Needle in another account")
+
+    get search_path, params: { q: "needle" }
+    assert_results private_card, visible
+
+    boards(:private).accesses.revoke_from(users(:kevin))
+    get search_path, params: { q: "needle" }
+    assert_results visible
+
+    boards(:private).accesses.grant_to(users(:kevin))
+    get search_path, params: { q: "needle" }
+    assert_results private_card, visible
+  end
+
+  test "moving a matching comment's card to an inaccessible board hides it" do
+    card = create_card
+    card.comments.create!(body: "Needle", creator: users(:kevin))
+    boards(:private).accesses.revoke_from(users(:kevin))
+
+    get search_path, params: { q: "needle" }
+    assert_results card
+
+    with_current_user(:kevin) { card.move_to(boards(:private)) }
+    get search_path, params: { q: "needle" }
+    assert_results
+  end
+
+  test "draft cards and their comments never appear" do
+    title_match = create_card(title: "Needle", status: :drafted)
+    description_match = create_card(description: "Needle", status: :drafted)
+    comment_match = create_card
+    comment_match.comments.create!(body: "Needle", creator: users(:kevin))
+    comment_match.drafted!
+
+    get search_path, params: { q: "needle" }
+    assert_results
+
+    with_current_user(:kevin) { comment_match.publish }
+    get search_path, params: { q: "needle" }
+    assert_results comment_match
+    assert_not_includes response.body, "search_card_#{title_match.id}"
+    assert_not_includes response.body, "search_card_#{description_match.id}"
+  end
+
+  test "search uses visible rich text rather than HTML markup" do
+    card = create_card(description: '<p class="hiddenneedle">A&amp;B and <strong>visible</strong> text</p>')
+    comment = card.comments.create!(body: "<p>com<strong>bine</strong></p>", creator: users(:kevin))
+
+    [ "A&B", "visible", "combine" ].each do |query|
+      get search_path, params: { q: query }
+      assert_results card
+      assert_select "#search_results mark", text: query
+    end
+
+    [ "hiddenneedle", "strong" ].each do |query|
+      get search_path, params: { q: query }
+      assert_results
+    end
+
+    card.update!(description: "Changed description")
+    comment.update!(body: "Changed comment")
+    get search_path, params: { q: "A&B" }
+    assert_results
+    get search_path, params: { q: "combine" }
+    assert_results
+    get search_path, params: { q: "changed" }
+    assert_results card
+
+    comment.destroy!
+    card.update!(description: "")
+    get search_path, params: { q: "changed" }
+    assert_results
+  end
+
+  test "blank or malformed queries show no results" do
+    [ nil, "", " \t\n ", [ "logo" ], { term: "logo" } ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_results
+      assert_select "#search_results", text: "Search card titles, descriptions, and comments."
+      assert_select "mark", count: 0
+    end
+  end
+
+  test "no matches" do
+    get search_path, params: { q: "nonexistentword" }
+    assert_response :success
+    assert_results
+    assert_select "#search_results", text: "No cards found for “nonexistentword”."
+  end
+
+  test "SQL wildcards and regular expression characters are literal" do
+    [ "100%", "under_score", "a.b", "a!b", 'a\\b', "O'Reilly", "[brackets]" ].each do |query|
+      card = create_card(title: query)
+      create_card(title: query.gsub(/[^[:alnum:]]/, "x"))
+
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_results card
+      assert_select "#search_results h2 mark", text: query
+    end
+
+    get search_path, params: { q: "' OR 1=1 --" }
+    assert_results
+  end
+
+  test "titles and query text cannot inject HTML" do
+    query = '<script>alert("needle")</script>'
+    card = create_card(title: query)
+
+    get search_path, params: { q: query }
+    assert_response :success
+    assert_results card
+    assert_select "#search_results script", count: 0
+    assert_select "#search_results mark", text: query
+
+    get search_path, params: { q: "<img src=x onerror=alert(1)>" }
+    assert_select "#search_results img", count: 0
+  end
+
+  test "pagination retains the query and newest first order" do
+    cards = 17.times.map { |index| create_card(title: "Paginated needle", created_at: index.minutes.ago) }
+
+    get search_path, params: { q: "paginated needle" }
+    assert_response :success
+    assert_results(*cards.first(15))
+    next_page = css_select("#search_results a.pagination-link").first["href"]
+    assert_includes next_page, "q=paginated+needle"
+
+    get next_page
+    assert_response :success
+    assert_results(*cards.drop(15))
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path, params: { q: "logo" }
+    assert_response :redirect
+    assert_select "#search_results", count: 0
+  end
+
+  private
+    def create_card(**attributes)
+      with_current_user(:kevin) do
+        Card.create!({ board: boards(:writebook), title: "A card", status: :published, creator: users(:kevin) }.merge(attributes))
+      end
+    end
+
+    def assert_results(*cards)
+      assert_equal cards.map { |card| "search_card_#{card.id}" }, css_select("#search_results article").map { |article| article["id"] }
+    end
+end
