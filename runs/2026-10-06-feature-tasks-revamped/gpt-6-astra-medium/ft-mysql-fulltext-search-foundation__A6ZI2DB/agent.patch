+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].is_a?(String) ? params[:q].strip : ""
+    @terms = @query.split.uniq
+
+    set_page_and_extract_portion_from Current.user.accessible_cards.search(@query)
+      .preload(:board, :rich_text_description, comments: :rich_text_body)
+  end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..28fb786
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,27 @@
+module SearchesHelper
+  def highlight_search_text(text, terms)
+    if terms.any?
+      parts = text.to_s.split(/(#{search_pattern(terms)})/).each_with_index.map do |part, index|
+        index.odd? ? tag.mark(part) : ERB::Util.html_escape(part)
+      end
+      safe_join(parts)
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  def search_excerpt(text, terms)
+    text = excerpt(text.to_s, search_pattern(terms), radius: 150) || truncate(text.to_s, length: 300)
+    highlight_search_text(text, terms)
+  end
+
+  def matching_search_comments(card, terms)
+    pattern = search_pattern(terms)
+    card.comments.select { |comment| comment.body.to_plain_text.match?(pattern) }
+  end
+
+  private
+    def search_pattern(terms)
+      Regexp.new(Regexp.union(terms.sort_by { |term| -term.length }).source, Regexp::IGNORECASE)
+    end
+end
