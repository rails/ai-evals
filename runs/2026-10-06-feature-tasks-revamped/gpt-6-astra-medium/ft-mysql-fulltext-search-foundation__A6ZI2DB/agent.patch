diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..1d40a74
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlights literal matches case insensitively" do
+    assert_equal "<mark>Logo</mark> and <mark>LOGO</mark>", highlight_search_text("Logo and LOGO", [ "logo" ])
+    assert_equal "<mark>a.b</mark> axb", highlight_search_text("a.b axb", [ "a.b" ])
+  end
+
+  test "escapes text and matches without corrupting HTML entities" do
+    assert_equal "&lt;script&gt;<mark>needle</mark>&lt;/script&gt;", highlight_search_text("<script>needle</script>", [ "needle" ])
+    assert_equal "<mark>A&amp;B</mark>", highlight_search_text("A&B", [ "A&B" ])
+    assert_equal "&amp; <mark>amp</mark>", highlight_search_text("& amp", [ "amp" ])
+    assert_equal "&lt;mark&gt;", highlight_search_text("<mark>", [])
+  end
+
+  test "excerpts include a match beyond the start of the text" do
+    result = search_excerpt("Before " * 100 + "NEEDLE " + "After " * 100, [ "needle" ])
+
+    assert_includes result, "<mark>NEEDLE</mark>"
+    assert_operator result.length, :<, 350
+  end
+
+  test "overlapping words are highlighted once" do
+    assert_equal "<mark>needles</mark>", highlight_search_text("needles", [ "need", "needles" ])
+  end
+end
