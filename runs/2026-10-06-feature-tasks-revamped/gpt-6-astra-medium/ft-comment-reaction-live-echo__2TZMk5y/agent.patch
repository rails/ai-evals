--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,28 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { creatorId: String }
+  static targets = [ "delete" ]
+
+  connect() {
+    if (this.#ownedByCurrentUser) {
+      this.element.classList.add("reaction--deleteable")
+      this.element.setAttribute("role", "button")
+      this.element.setAttribute("tabindex", "0")
+      this.element.setAttribute("aria-expanded", "false")
+      this.deleteTarget.hidden = false
+    }
+  }
+
+  toggle(event) {
+    if (this.#ownedByCurrentUser && !event.target.closest("a, button, form")) {
+      event.preventDefault()
+      const expanded = this.element.classList.toggle("expanded")
+      this.element.setAttribute("aria-expanded", expanded)
+    }
+  }
+
+  get #ownedByCurrentUser() {
+    return this.creatorIdValue === window.Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..e918398
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,33 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "errors" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.classList.add("reaction", "expanded")
+    this.formTarget.hidden = false
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.inputTarget.value = ""
+    this.inputTarget.setCustomValidity("")
+    this.errorsTarget.textContent = ""
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  validate() {
+    // Count Unicode code points, like the server, rather than UTF-16 code units.
+    const content = this.inputTarget.value
+    const valid = content.trim().length > 0 && Array.from(content).length <= 16
+    this.inputTarget.setCustomValidity(valid ? "" : "Enter a reaction of 1 to 16 characters.")
+  }
+
+  submitted(event) {
+    if (event.detail.success) this.cancel()
+  }
+}
