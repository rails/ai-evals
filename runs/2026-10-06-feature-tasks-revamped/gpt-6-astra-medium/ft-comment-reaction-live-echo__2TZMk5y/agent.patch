index 0000000..4b8225a
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create appends a reaction with the authenticated creator" do
+    assert_difference -> { @comment.reactions.count }, 1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: {
+        reaction: { content: "🎉", creator_id: users(:jz).id, account_id: accounts(:initech).id }
+      }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+    assert_select "turbo-stream[action=append][target='#{dom_id(@comment, :reactions)}']"
+    assert_select ".reaction", text: /🎉/
+  end
+
+  test "invalid content is not saved" do
+    [ "", "  ", "a" * 17 ].each do |content|
+      assert_no_difference "Reaction.count" do
+        post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "destroy your own reaction" do
+    reaction = @comment.reactions.create!(content: "Nice!", creator: users(:kevin))
+
+    assert_difference "Reaction.count", -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action=remove][target='#{dom_id(reaction)}']"
+  end
+
+  test "cannot destroy another person's reaction" do
+    reaction = @comment.reactions.create!(content: "Nice!", creator: users(:jz))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+    assert_response :forbidden
+  end
+
+  test "comment must belong to the card" do
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(cards(:layout), @comment), params: { reaction: { content: "Hi" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "reaction must belong to the comment" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "Hi", creator: users(:kevin))
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+  test "cannot react to a card on an inaccessible board" do
+    reaction = @comment.reactions.create!(content: "Hi", creator: users(:kevin))
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "Hi" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "comments from another account cannot be used" do
+    comment = cards(:radio).comments.create!(body: "Hello", creator: users(:mike))
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@comment.card, comment), params: { reaction: { content: "Hi" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "reaction text is escaped" do
+    post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "<b>Hi</b>" } }, as: :turbo_stream
+
+    assert_response :success
+    assert_select ".reaction span.txt-small", text: "<b>Hi</b>"
+    assert_select ".reaction b", count: 0
+  end
+
+  test "cached comments show current reactions on subsequent visits" do
+    with_actionview_partial_caching do
+      get card_path(@comment.card)
+      assert_response :success
+
+      reaction = @comment.reactions.create!(content: "Wonderful", creator: users(:kevin))
+      get card_path(@comment.card)
+      assert_select "##{dom_id(reaction)}", text: /Wonderful/
+
+      reaction.destroy!
+      get card_path(@comment.card)
+      assert_select "##{dom_id(reaction)}", count: 0
+    end
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..6942c82
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "requires content of at most 16 characters" do
+    [ nil, "", "   ", "a" * 17 ].each do |content|
+      assert_not @comment.reactions.build(content: content).valid?
+    end
+
+    [ "👍", "Thanks!", "a" * 16, "👍" * 16 ].each do |content|
+      assert @comment.reactions.build(content: content).valid?
+    end
+  end
+
+  test "defaults to the current creator and comment account" do
+    reaction = @comment.reactions.create!(content: "🎉")
+
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "broadcasts additions and removals to the card activity stream" do
+    reaction = nil
+    assert_turbo_stream_broadcasts [ @comment.card, :activity ] do
+      reaction = @comment.reactions.create!(content: "Nice!")
+    end
+    assert_turbo_stream_broadcasts [ @comment.card, :activity ] do
+      reaction.destroy!
+    end
+  end
+
+  test "deleting a comment deletes its reactions" do
+    reaction = @comment.reactions.create!(content: "Thanks")
+    @comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+  test "reactions do not touch the card or trigger a card refresh" do
+    assert_no_changes -> { @comment.card.reload.updated_at } do
+      reaction = @comment.reactions.create!(content: "Nice!")
+      reaction.destroy!
+    end
+  end
+end
