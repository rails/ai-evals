diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..5c050ee
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,35 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel center-block">
+  <%= form_with url: search_path, method: :get, role: "search" do |form| %>
+    <%= form.label :q, "Search cards" %>
+    <%= form.search_field :q, value: @query, class: "input", placeholder: "Titles, descriptions, and comments", autofocus: true %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.blank? %>
+    <p>Enter a term to search cards.</p>
+  <% elsif @page.records.empty? %>
+    <p>No cards found.</p>
+  <% else %>
+    <%= with_manual_pagination :search_results, @page do %>
+      <% @page.records.each do |card| %>
+        <article class="search-result margin-block" data-card-id="<%= card.id %>">
+          <h2><%= link_to highlight_search_matches(card.title, @query), card_path(card) %></h2>
+          <p class="txt-small"><%= card.board.name %> · <%= local_datetime_tag card.created_at, style: :date %></p>
+          <% if card.description.present? %>
+            <p><%= highlight_search_matches(search_excerpt(card.description.to_plain_text, @query), @query) %></p>
+          <% end %>
+          <% matching_search_comments(card, @query).each do |comment| %>
+            <blockquote><%= highlight_search_matches(search_excerpt(comment.body.to_plain_text, @query), @query) %></blockquote>
+          <% end %>
+        </article>
+      <% end %>
+    <% end %>
+  <% end %>
+</section>
