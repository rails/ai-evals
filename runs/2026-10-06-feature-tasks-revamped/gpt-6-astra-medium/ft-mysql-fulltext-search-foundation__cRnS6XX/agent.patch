diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..c1358af
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,167 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "searches titles descriptions and comments newest first without duplicate cards" do
+    cards(:logo).update!(title: "Nebula title", created_at: 3.days.ago)
+    cards(:layout).update!(description: "<div>A NEBULA description</div>", created_at: 2.days.ago)
+    cards(:text).update!(created_at: 1.day.ago)
+    2.times { cards(:text).comments.create!(body: "A nebula comment", creator: users(:kevin)) }
+
+    get search_path, params: { q: "nebula" }
+
+    assert_response :success
+    assert_select ".search-result" do |results|
+      assert_equal [ cards(:text), cards(:layout), cards(:logo) ].map(&:id), results.map { |result| result["data-card-id"] }
+    end
+    assert_select ".search-result mark", text: /nebula/i, minimum: 3
+  end
+
+  test "draft cards and their comments are excluded" do
+    card = cards(:logo)
+    card.update!(title: "Secret draft", description: "Draft description")
+    card.comments.create!(body: "Hidden comment", creator: users(:kevin))
+    card.drafted!
+
+    [ "Secret", "Draft description", "Hidden comment" ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_select ".search-result", count: 0
+    end
+  end
+
+  test "blank queries and unmatched queries show no results" do
+    [ nil, "", "   ", "unfindable-search-term" ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_select ".search-result", count: 0
+    end
+  end
+
+  test "only boards with current access appear including after access is revoked" do
+    card = cards(:logo)
+    card.update!(title: "Restricted nebula", board: boards(:private))
+    cards(:radio).update!(title: "Other account nebula")
+
+    get search_path, params: { q: "nebula" }
+    assert_select ".search-result", count: 1
+    assert_select ".search-result[data-card-id=?]", card.id
+
+    boards(:private).accesses.revoke_from(users(:kevin))
+    get search_path, params: { q: "nebula" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "comment matches on inaccessible boards do not appear" do
+    cards(:logo).comments.create!(body: "Hidden nebula", creator: users(:kevin))
+    cards(:logo).update!(board: boards(:private))
+    boards(:private).accesses.revoke_from(users(:kevin))
+
+    get search_path, params: { q: "nebula" }
+    assert_select ".search-result", count: 0
+  end
+
+  test "search terms are literal and highlighted safely" do
+    cards(:logo).update!(title: %q{<img src=x onerror=alert(1)> 100% foo_bar [nebula]})
+
+    [ "100%", "foo_bar", "[nebula]", "<img" ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_select ".search-result", count: 1
+      assert_select ".search-result mark", text: query
+      assert_select ".search-result img", count: 0
+      assert_select ".search-result script", count: 0
+    end
+
+    [ "100_", "foo%bar", "' OR 1=1 --" ].each do |query|
+      get search_path, params: { q: query }
+      assert_select ".search-result", count: 0
+    end
+  end
+
+  test "matches multiple words across card content" do
+    cards(:logo).update!(title: "Nebula", description: "Distant galaxy")
+    cards(:layout).update!(title: "Nebula")
+
+    get search_path, params: { q: "  nebula   galaxy  " }
+    assert_select ".search-result", count: 1
+    assert_select ".search-result mark", text: "Nebula"
+    assert_select ".search-result mark", text: "galaxy"
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path, params: { q: "logo" }
+    assert_response :redirect
+  end
+
+  test "search follows comment edits and deletion" do
+    comment = cards(:logo).comments.create!(body: "Original nebula", creator: users(:kevin))
+    get search_path, params: { q: "nebula" }
+    assert_select ".search-result", count: 1
+
+    comment.update!(body: "Replacement galaxy")
+    get search_path, params: { q: "nebula" }
+    assert_select ".search-result", count: 0
+    get search_path, params: { q: "galaxy" }
+    assert_select ".search-result", count: 1
+
+    comment.destroy!
+    get search_path, params: { q: "galaxy" }
+    assert_select ".search-result", count: 0
+  end
+
+  test "moving a card to an inaccessible board removes its comment matches" do
+    cards(:logo).assignments.delete_all
+    cards(:logo).comments.create!(body: "Movable nebula", creator: users(:kevin))
+    boards(:private).accesses.revoke_from(users(:kevin))
+    get search_path, params: { q: "nebula" }
+    assert_select ".search-result", count: 1
+
+    with_current_user(:kevin) { cards(:logo).move_to(boards(:private)) }
+    get search_path, params: { q: "nebula" }
+    assert_select ".search-result", count: 0
+  end
+
+  test "paginates newest first and keeps the query" do
+    created = 21.times.map do |index|
+      boards(:writebook).cards.create!(title: "Nebula #{index}", status: :published, creator: users(:kevin), created_at: index.minutes.ago)
+    end
+
+    get search_path, params: { q: "nebula" }
+    assert_select ".search-result" do |results|
+      assert_equal created.first(20).map(&:id), results.map { |result| result["data-card-id"] }
+    end
+    assert_select "a.pagination-link[href=?]", search_path(page: 2, q: "nebula")
+
+    get search_path, params: { q: "nebula", page: 2 }
+    assert_select ".search-result", count: 1
+    assert_select ".search-result[data-card-id=?]", created.last.id
+  end
+
+  test "searches visible rich text rather than HTML markup" do
+    cards(:logo).update!(description: '<div class="invisible-token">Ne<strong>bu</strong>la &amp; galaxy</div>')
+    cards(:text).comments.create!(body: "<div>Ne<em>bu</em>la</div>", creator: users(:kevin))
+
+    get search_path, params: { q: "nebula" }
+    assert_select ".search-result", count: 2
+    assert_select ".search-result mark", text: "Nebula", count: 2
+
+    [ "div", "invisible-token", "amp;" ].each do |query|
+      get search_path, params: { q: query }
+      assert_select ".search-result", count: 0
+    end
+  end
+
+  test "searches existing comment bodies" do
+    get search_path, params: { q: "overflowing" }
+    assert_select ".search-result", count: 1
+    assert_select ".search-result[data-card-id=?]", cards(:layout).id
+    assert_select ".search-result mark", text: "overflowing"
+  end
+end
