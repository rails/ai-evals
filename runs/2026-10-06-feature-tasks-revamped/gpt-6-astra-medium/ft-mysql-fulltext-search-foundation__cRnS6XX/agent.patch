@@ -0,0 +1,21 @@
+module SearchesHelper
+  def highlight_search_matches(text, query)
+    if query.present?
+      pattern = Regexp.new("(#{Regexp.union(query.split).source})", Regexp::IGNORECASE)
+      parts = text.to_s.split(pattern)
+      safe_join(parts.each_with_index.map { |part, index| index.odd? ? tag.mark(part) : part })
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  def search_excerpt(text, query)
+    pattern = Regexp.new(Regexp.union(query.split).source, Regexp::IGNORECASE)
+    excerpt(text, pattern, radius: 100) || truncate(text, length: 200)
+  end
+
+  def matching_search_comments(card, query)
+    pattern = Regexp.new(Regexp.union(query.split).source, Regexp::IGNORECASE)
+    card.comments.select { |comment| comment.body.to_plain_text.match?(pattern) }
+  end
+end
