diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..dceac24
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlights literal case insensitive words" do
+    assert_equal "<mark>Nebula</mark> and <mark>galaxy</mark>", highlight_search_matches("Nebula and galaxy", "nebula galaxy")
+    assert_equal "<mark>[a.*]</mark>", highlight_search_matches("[a.*]", "[a.*]")
+  end
+
+  test "escapes content including inside marks" do
+    assert_equal "<mark>&lt;script&gt;</mark>alert(1)&lt;/script&gt;", highlight_search_matches("<script>alert(1)</script>", "<script>")
+    assert_equal "<mark>&amp;</mark> test", highlight_search_matches("& test", "&")
+    assert_equal "&lt;script&gt;", highlight_search_matches("<script>", "")
+  end
+
+  test "excerpt includes a match near the end of a long body" do
+    text = "Unrelated content. " * 100 + "A distant NEBULA."
+    snippet = search_excerpt(text, "nebula")
+
+    assert_includes snippet, "NEBULA"
+    assert_operator snippet.length, :<, 220
+    assert_includes highlight_search_matches(snippet, "nebula"), "<mark>NEBULA</mark>"
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..ef6f163
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  test "description edits and clearing are reflected in search" do
+    card = cards(:logo)
+    card.update!(description: "Nebula")
+    assert_includes Card.matching("nebula"), card
+
+    card.rich_text_description.update!(body: "Galaxy")
+    assert_not_includes Card.matching("nebula"), card
+    assert_includes Card.matching("galaxy"), card
+
+    card.update!(description: "")
+    assert_not_includes Card.matching("galaxy"), card
+  end
+
+  test "a published draft and its comments become searchable" do
+    card = cards(:logo)
+    card.comments.create!(body: "Nebula", creator: users(:kevin))
+    card.drafted!
+    assert_not_includes Card.matching("nebula"), card
+
+    with_current_user(:kevin) { card.publish }
+    assert_includes Card.matching("nebula"), card
+  end
+
+  test "matching retains the caller's board scope" do
+    cards(:logo).update!(description: "Nebula")
+    assert_includes boards(:writebook).cards.matching("nebula"), cards(:logo)
+    assert_empty boards(:private).cards.matching("nebula")
+  end
+end
