+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    cards = Current.user.accessible_cards.matching(@query).reverse_chronologically
+      .includes(:board, :rich_text_description, comments: :rich_text_body)
+    set_page_and_extract_portion_from cards, per_page: 20
+  end
+end
