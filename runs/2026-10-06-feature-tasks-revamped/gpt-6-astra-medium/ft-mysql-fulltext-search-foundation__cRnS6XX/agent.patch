diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..74a7f9b
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,26 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def matching(query)
+      terms = query.to_s.split
+
+      if terms.any?
+        terms.reduce(published) do |cards, term|
+          pattern = "%#{sanitize_sql_like(term.downcase, "!")}%"
+          descriptions = ActionText::RichText.where(record_type: "Card", name: "description")
+            .where("LOWER(plain_text_body) LIKE ? ESCAPE '!'", pattern).select(:record_id)
+          comment_bodies = ActionText::RichText.where(record_type: "Comment", name: "body")
+            .where("LOWER(plain_text_body) LIKE ? ESCAPE '!'", pattern).select(:record_id)
+          comments = Comment.where(id: comment_bodies).select(:card_id)
+
+          cards.where("LOWER(cards.title) LIKE ? ESCAPE '!'", pattern)
+            .or(cards.where(id: descriptions))
+            .or(cards.where(id: comments))
+        end
+      else
+        none
+      end
+    end
+  end
+end
