@@ -25,8 +25,18 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+
+      # Resolve each board's cutoff before querying cards so the activity index can be used.
+      Board.preload(:entropy, account: :entropy).find_each do |board|
+        if period = board.entropy&.auto_postpone_period
+          cutoff = now - period
+          system_user = nil
+
+          board.cards.active.where(last_active_at: ..cutoff).find_each do |card|
+            card.auto_postpone(user: system_user ||= board.account.system_user)
+          end
+        end
       end
     end
   end
