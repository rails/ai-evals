diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..00d42f0 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -59,6 +59,100 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "auto postpone includes the cutoff but not more recently active cards" do
+    freeze_time
+    cutoff = Time.current - boards(:writebook).auto_postpone_period
+    cards(:logo).update! last_active_at: cutoff
+    cards(:layout).update! last_active_at: cutoff + 1.second
+    cards(:text).update! last_active_at: cutoff - 1.second
+
+    assert_difference -> { Card.postponed.count }, 2 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:text).reload.postponed?
+    assert_not cards(:layout).reload.postponed?
+  end
+
+  test "auto postpone excludes closed drafted and already postponed cards" do
+    cards(:logo).postpone(user: users(:kevin))
+    cards(:layout).drafted!
+    cards(:logo, :layout, :shipping, :text).each do |card|
+      card.update! last_active_at: 1.year.ago
+    end
+
+    assert_difference -> { Event.where(action: "card_auto_postponed").count }, 1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:text).reload.postponed?
+    assert cards(:shipping).reload.closed?
+    assert_not cards(:layout).reload.postponed?
+    assert_equal users(:kevin), cards(:logo).reload.postponed_by
+
+    assert_no_difference -> { Event.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postpone uses shorter board overrides and changed account defaults" do
+    freeze_time
+    entropies(:writebook_board).update! auto_postpone_period: 3.days
+    entropies(:miltons_wish_list_board).destroy!
+    entropies(:initech_account).update! auto_postpone_period: 365.days
+    Card.update_all last_active_at: Time.current
+    cards(:logo, :radio).each { |card| card.update! last_active_at: 4.days.ago }
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:radio).reload.postponed?
+
+    entropies(:initech_account).update! auto_postpone_period: 3.days
+    Card.auto_postpone_all_due
+
+    assert cards(:radio).reload.postponed?
+    assert_equal accounts(:initech).system_user, cards(:radio).postponed_by
+  end
+
+  test "auto postpone skips boards without an entropy period" do
+    entropies(:miltons_wish_list_board).destroy!
+    entropies(:initech_account).destroy!
+    cards(:logo, :radio).each { |card| card.update! last_active_at: 1.year.ago }
+
+    assert_difference -> { Card.postponed.count }, 1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:radio).reload.postponed?
+  end
+
+  test "auto postpone batches cards with board scoped activity cutoffs instead of entropy joins" do
+    template = cards(:logo)
+    Card.insert_all! 1001.times.map { |i|
+      template.attributes.merge("id" => ActiveRecord::Type::Uuid.generate,
+        "number" => 1000 + i, "last_active_at" => 1.year.ago)
+    }
+    Card.any_instance.expects(:auto_postpone).with(user: accounts("37s").system_user).times(1001)
+
+    queries = []
+    subscriber = ->(event) { queries << event.payload[:sql] }
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      Card.auto_postpone_all_due
+    end
+
+    card_queries = queries.grep(/SELECT .*FROM ["`]cards["`]/)
+    assert_operator card_queries.size, :>=, 2
+    card_queries.each do |sql|
+      assert_match(/cards["`]\.["`]board_id["`] = /, sql)
+      assert_match(/cards["`]\.["`]last_active_at["`] <= /, sql)
+      assert_no_match(/JOIN ["`]?(?:boards|accounts|entropies)/i, sql)
+      assert_match(/LIMIT/i, sql)
+    end
+  end
+
   test "postponing soon scope" do
     cards(:logo, :shipping).each(&:published!)
 
