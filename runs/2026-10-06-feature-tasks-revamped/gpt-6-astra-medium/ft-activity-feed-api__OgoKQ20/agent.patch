@@ -0,0 +1,61 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat array of account activity, newest first. Only events on boards the
+current user can access are returned. Read-only access tokens are supported.
+
+The endpoint includes the same kinds of events as the HTML timeline, except that
+it omits deprecated `card_collection_changed` events and includes
+`card_title_changed` events:
+
+- `card_assigned`, `card_unassigned`
+- `card_published`, `card_closed`, `card_reopened`
+- `card_board_changed`, `card_title_changed`
+- `card_postponed`, `card_auto_postponed`
+- `card_triaged`, `card_sent_back_to_triage`
+- `comment_created`
+
+### Filtering and pagination
+
+Pass `creator_ids[]` and/or `board_ids[]` to filter activity. Multiple IDs within a
+filter are combined with OR; creator and board filters are combined with AND.
+Filters never grant access to additional boards.
+
+For example:
+
+```
+GET /1234567/activities.json?creator_ids[]=USER_ID&board_ids[]=BOARD_ID
+```
+
+As with other list endpoints, follow the `Link` response header's `rel="next"`
+URL to fetch the next page. The `X-Total-Count` header contains the total number
+of matching events. The response body is always an array, including when empty.
+
+### Event fields
+
+| Field | Description |
+|-------|-------------|
+| `id` | Event ID |
+| `action` | Event action from the list above |
+| `created_at` | Event timestamp in UTC |
+| `description` | The event's plain-text description |
+| `particulars` | Event-specific details (see below) |
+| `url` | Card URL; for comments, the card URL with an anchor to the comment |
+| `eventable_type` | `Card` or `Comment` |
+| `eventable` | The existing [card](cards.md) or [comment](comments.md) API representation |
+| `board` | The existing [board](boards.md) API representation |
+| `creator` | The existing [user](users.md) API representation |
+
+### Particulars
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `{ "assignee_ids": ["USER_ID"] }` |
+| `card_board_changed` | `{ "old_board": "Old board name", "new_board": "New board name" }` |
+| `card_title_changed` | `{ "old_title": "Old title", "new_title": "New title" }` |
+| `card_triaged` | `{ "column": "Column name" }` |
+| All other actions | `{}` |
+
+Board, title, and column values are names/text recorded with the event, not IDs.
+Missing board, title, or column values are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..2280e69
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,196 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns a flat array of activities newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+    assert_equal users(:kevin).accessible_events.order(created_at: :desc, id: :desc).ids, response.parsed_body.pluck("id")
+  end
+
+  test "index accepts a read-only bearer token" do
+    sign_out
+    token = identities(:kevin).access_tokens.create!(description: "Activity reader", permission: "read")
+
+    get activities_path(format: :json), headers: { "HTTP_AUTHORIZATION" => "Bearer #{token.token}" }
+
+    assert_response :success
+    assert_includes response.parsed_body.pluck("id"), events(:logo_published).id
+  end
+
+  test "card activity uses the existing API representations and plain text description" do
+    event = events(:logo_published)
+    activity = activity_for(event)
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at, Time.iso8601(activity["created_at"])
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_no_match(/<span/, activity["description"])
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal({}, activity["particulars"])
+
+    get card_path(event.eventable, format: :json)
+    assert_equal response.parsed_body.except("steps"), activity["eventable"]
+    get board_path(event.board, format: :json)
+    assert_equal response.parsed_body, activity["board"]
+    get user_path(event.creator, format: :json)
+    assert_equal response.parsed_body, activity["creator"]
+  end
+
+  test "comment activity links to the comment on its card" do
+    event = events(:layout_commented)
+    comment = event.eventable
+    activity = activity_for(event)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(comment.card, comment, format: :json)
+    assert_equal response.parsed_body, activity["eventable"]
+  end
+
+  %w[ card_assigned card_unassigned ].each do |action|
+    test "#{action} exposes assignee IDs" do
+      event = events(:logo_assignment_jz)
+      event.update_columns(action: action)
+
+      assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity_for(event)["particulars"])
+    end
+  end
+
+  {
+    "card_board_changed" => { "old_board" => "Old board", "new_board" => "New board" },
+    "card_title_changed" => { "old_title" => "Old title", "new_title" => "New title" },
+    "card_triaged" => { "column" => "In progress" }
+  }.each do |action, particulars|
+    test "#{action} exposes event-specific particulars" do
+      event = events(:logo_published)
+      event.update_columns(action: action, particulars: { "particulars" => particulars.merge("internal" => "hidden") })
+
+      assert_equal particulars, activity_for(event)["particulars"]
+    end
+
+    test "#{action} uses empty strings for missing particulars" do
+      event = events(:logo_published)
+      event.update_columns(action: action, particulars: {})
+
+      assert_equal particulars.transform_values { "" }, activity_for(event)["particulars"]
+
+      event.update_columns(particulars: { "particulars" => particulars.transform_values { nil } })
+      assert_equal particulars.transform_values { "" }, activity_for(event)["particulars"]
+    end
+  end
+
+  %w[ card_published card_closed card_reopened card_postponed card_auto_postponed card_sent_back_to_triage ].each do |action|
+    test "#{action} is included with empty particulars" do
+      event = events(:logo_published)
+      event.update_columns(action: action, particulars: { "internal" => "hidden" })
+
+      assert_equal({}, activity_for(event)["particulars"])
+    end
+  end
+
+  test "deprecated and non-timeline events are omitted" do
+    events(:logo_published).update_columns(action: "card_collection_changed")
+    events(:layout_published).update_columns(action: "card_resumed")
+    events(:text_published).update_columns(action: "card_gilded")
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_empty response.parsed_body.pluck("action") & %w[ card_collection_changed card_resumed card_gilded ]
+  end
+
+  test "filters by creators" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.where(creator: users(:kevin)).ids.sort, response.parsed_body.pluck("id").sort
+  end
+
+  test "filters by boards and combines filters" do
+    private_event = create_event(board: boards(:private), creator: users(:kevin))
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_equal [ private_event.id ], response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ], creator_ids: [ users(:david).id ] }
+    assert_equal [], response.parsed_body
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:writebook).id ], creator_ids: [ users(:kevin).id, users(:david).id ] }
+    assert_equal users(:kevin).accessible_events.ids.sort, response.parsed_body.pluck("id").sort
+  end
+
+  test "inaccessible boards and other accounts are excluded even when explicitly requested" do
+    private_event = create_event(board: boards(:private), creator: users(:kevin))
+    other_account_event = create_event(board: boards(:miltons_wish_list), creator: users(:mike))
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), private_event.id
+    assert_not_includes response.parsed_body.pluck("id"), other_account_event.id
+
+    get activities_path(format: :json), params: { board_ids: [ private_event.board_id, other_account_event.board_id ] }
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+
+  test "unknown filter IDs return no activity" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:mike).id ] }
+    assert_equal [], response.parsed_body
+
+    get activities_path(format: :json), params: { board_ids: [ ActiveRecord::Type::Uuid.generate ] }
+    assert_equal [], response.parsed_body
+  end
+
+  test "paginates using API headers and preserves filters" do
+    20.times do |index|
+      events(:logo_published).dup.tap do |event|
+        event.id = ActiveRecord::Type::Uuid.generate
+        event.created_at = index.minutes.ago
+        event.save!
+      end
+    end
+    expected_ids = users(:kevin).accessible_events.where(creator: users(:david)).order(created_at: :desc, id: :desc).ids
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ] }
+
+    assert_response :success
+    assert_equal expected_ids.size.to_s, response.headers["X-Total-Count"]
+    first_page_ids = response.parsed_body.pluck("id")
+    assert_equal expected_ids.first(first_page_ids.size), first_page_ids
+    assert_match(/rel="next"/, response.headers["Link"])
+
+    get response.headers["Link"][/<([^>]+)>/, 1]
+
+    assert_response :success
+    assert_equal expected_ids, first_page_ids + response.parsed_body.pluck("id")
+    assert_nil response.headers["Link"]
+  end
+
+  private
+    def activity_for(event)
+      get activities_path(format: :json)
+      assert_response :success
+      response.parsed_body.find { |activity| activity["id"] == event.id }.tap do |activity|
+        assert_not_nil activity, "Expected activity for #{event.action}"
+      end
+    end
+
+    def create_event(board:, creator:)
+      Current.set(account: board.account, user: creator) do
+        card = board.cards.create!(title: "Activity test", creator: creator, status: :published, number: board.account.cards.maximum(:number).to_i + 1)
+        card.events.find_by!(action: "card_published")
+      end
+    end
+end
