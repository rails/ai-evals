diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..e3b2f44
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,22 @@
+<% @page_title = @account.name %>
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+<section class="settings panel shadow">
+  <%= link_to "Accounts", saas.admin_accounts_path %>
+  <h2><%= @account.billing_plan.name %><%= " (Comped)" if @account.comped? %></h2>
+  <p>Card count: <%= number_with_delimiter(@account.card_count) %></p>
+  <p>Bytes used: <%= number_with_delimiter(@account.bytes_used) %></p>
+  <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), class: "btn" %>
+  <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+
+  <% if @overridden_limits.errors.any? %>
+    <p role="alert"><%= @overridden_limits.errors.full_messages.to_sentence %></p>
+  <% end %>
+  <%= form_with model: @overridden_limits, url: saas.admin_account_overridden_limits_path(@account), method: :patch do |form| %>
+    <p><%= form.label :card_count, "Card count" %> <%= form.number_field :card_count, min: 0, step: 1 %></p>
+    <p><%= form.label :bytes_used, "Bytes used" %> <%= form.number_field :bytes_used, min: 0, step: 1 %></p>
+    <%= form.submit "Override", class: "btn" %>
+  <% end %>
+  <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn" %>
+</section>
