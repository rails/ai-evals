+<% @page_title = "Plan & billing" %>
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+<section class="settings panel shadow">
+  <h2>Current plan: <%= Current.account.billing_plan.name %></h2>
+  <p><%= number_with_delimiter(Current.account.card_count) %> cards · <%= number_to_human_size(Current.account.bytes_used) %> used of <%= number_to_human_size(Current.account.storage_limit) %></p>
+  <p>Free includes 1,000 cards and 1 GB of storage.</p>
+  <% if Current.account.subscription %>
+    <%= button_to "Manage billing", saas.account_billing_portal_path(script_name: Current.account.slug), class: "btn", data: { turbo: false } %>
+  <% end %>
+  <% Plan::PAID.each do |plan| %>
+    <h3><%= plan.name %> — $<%= plan.price %>/month</h3>
+    <p>Unlimited cards and <%= number_to_human_size(plan.storage_limit) %> of storage.</p>
+    <% unless Current.account.subscription&.active? || Current.account.comped? %>
+      <%= button_to "Upgrade to #{plan.name}", saas.account_billing_checkout_path(script_name: Current.account.slug, plan_key: plan.key), class: "btn", data: { turbo: false } %>
+    <% end %>
+  <% end %>
+  <%= link_to "Account settings", main_app.account_settings_path %>
+</section>
