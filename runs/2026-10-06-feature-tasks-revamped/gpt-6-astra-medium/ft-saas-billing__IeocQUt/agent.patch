@@ -0,0 +1,24 @@
+module Card::CardLimited
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :enforce_card_limit, only: :create
+  end
+
+  private
+    def enforce_card_limit
+      if is_a?(Cards::PublishesController) || request.format.json?
+        # Serialize the check and publication so concurrent requests cannot spend
+        # the last free card twice. HTML creation still produces a draft.
+        Current.account.with_lock do
+          if Current.account.card_limit_reached?
+            head :forbidden
+          else
+            yield
+          end
+        end
+      else
+        yield
+      end
+    end
+end
diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..1ed27ec
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,19 @@
+class Stripe::WebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"],
+      ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+
+    if event.type.in?(%w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ])
+      subscription = Account::Subscription.find_by!(stripe_customer_id: event.data.object.customer)
+      subscription.apply_event(event)
+    end
+
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  rescue ActiveRecord::RecordNotFound
+    head :not_found
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..6d081bc
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,52 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limits, dependent: :destroy
+  end
+
+  def billing_plan
+    if subscription&.active?
+      Plan.find(subscription.plan_key) || Plan::FREE
+    elsif comped?
+      Plan::UNLIMITED
+    else
+      Plan::FREE
+    end
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def card_count
+    overridden_limits&.card_count || cards.published.count
+  end
+
+  def bytes_used
+    overridden_limits&.bytes_used || super
+  end
+
+  def cards_remaining
+    [ billing_plan.card_limit - card_count, 0 ].max if billing_plan.card_limit
+  end
+
+  def card_limit_reached?
+    cards_remaining == 0
+  end
+
+  def nearing_card_limit?
+    cards_remaining&.between?(1, 100) || false
+  end
+end
