diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..87f3851
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,42 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const FORMATS = {
+  time: { hour: "numeric", minute: "2-digit" },
+  date: { month: "short", day: "numeric" },
+  fullDate: { month: "short", day: "numeric", year: "numeric" },
+  weekday: { weekday: "long", month: "long", day: "numeric" },
+  datetime: { year: "numeric", month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }
+}
+
+export function formatLocalTime(value, format = "relative", now = new Date()) {
+  const date = parseDate(value)
+  if (Number.isNaN(date.getTime())) return ""
+
+  if (format === "relative") {
+    return relativeTime(date, now)
+  } else {
+    return new Intl.DateTimeFormat("en-US", FORMATS[format] || FORMATS.datetime).format(date)
+  }
+}
+
+function parseDate(value) {
+  // Calendar dates aren't UTC instants: keep them on the same local day.
+  if (typeof value === "string" && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    const [ year, month, day ] = value.split("-").map(Number)
+    return new Date(year, month - 1, day)
+  } else {
+    return new Date(value)
+  }
+}
+
+function relativeTime(date, now) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (days === 0) {
+    return formatLocalTime(date, "time")
+  } else if (days >= -6) {
+    return new Intl.RelativeTimeFormat("en", { numeric: "auto" }).format(days, "day")
+  } else {
+    return formatLocalTime(date, date.getFullYear() === now.getFullYear() ? "date" : "fullDate")
+  }
+}
