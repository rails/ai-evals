diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..40baf27
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "timestamps contain raw ISO data rather than server formatted words" do
+    time = Time.utc(2025, 9, 17, 20, 42)
+    html = local_time_tag(time, class: "timestamp", data: { test: "kept" })
+    element = Nokogiri::HTML.fragment(html).at_css("time")
+
+    assert_equal time.iso8601, element["datetime"]
+    assert_equal time.iso8601, element.text
+    assert_equal "local-time", element["data-controller"]
+    assert_equal "relative", element["data-local-time-format-value"]
+    assert_equal "timestamp", element["class"]
+    assert_equal "kept", element["data-test"]
+  end
+
+  test "formatting can be requested without rendering it on the server" do
+    html = local_time_tag(Time.utc(2025, 9, 17), format: :date)
+    assert_includes html, 'data-local-time-format-value="date"'
+    assert_not_includes html, "Sep"
+  end
+
+  test "date-only values remain calendar dates" do
+    element = Nokogiri::HTML.fragment(local_time_tag(Date.new(2025, 9, 17), format: :weekday)).at_css("time")
+
+    assert_equal "2025-09-17", element["datetime"]
+    assert_equal "2025-09-17", element.text
+  end
+
+  test "preserves other controllers without mutating the timestamp or options" do
+    time = Time.new(2025, 9, 17, 13, 42, 0, "-07:00")
+    data = { controller: "other", test: "kept" }
+    element = Nokogiri::HTML.fragment(local_time_tag(time, data: data)).at_css("time")
+
+    assert_equal "other local-time", element["data-controller"]
+    assert_equal "2025-09-17T20:42:00Z", element["datetime"]
+    assert_equal(-7.hours, time.utc_offset)
+    assert_equal({ controller: "other", test: "kept" }, data)
+  end
+
+  test "markup does not vary with the server clock or timezone" do
+    time = Time.utc(2025, 9, 17, 20, 42)
+    first = travel_to(Time.utc(2025, 9, 17)) { local_time_tag(time) }
+    second = travel_to(Time.utc(2026, 1, 1)) do
+      Time.use_zone("Tokyo") { local_time_tag(time.in_time_zone) }
+    end
+
+    assert_equal first, second
+  end
+end
