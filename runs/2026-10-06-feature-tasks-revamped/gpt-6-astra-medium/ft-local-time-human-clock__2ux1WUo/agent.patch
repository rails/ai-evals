new file mode 100644
index 0000000..e057333
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,27 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/local_time_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #timer
+
+  connect() {
+    this.render()
+    this.#timer = setInterval(() => this.render(), 60_000)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  render() {
+    const timestamp = this.element.dateTime
+    const text = formatLocalTime(timestamp, this.formatValue)
+
+    if (text) {
+      this.element.textContent = text
+      this.element.title = formatLocalTime(timestamp, "datetime")
+    }
+  }
+}
