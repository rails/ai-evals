@@ -0,0 +1,135 @@
+# Run with: bundle exec ruby test/javascript/local_time_test.rb
+require "bundler/setup"
+require "minitest/autorun"
+require "selenium-webdriver"
+require "base64"
+require "json"
+
+class LocalTimeTest < Minitest::Test
+  ROOT = File.expand_path("../..", __dir__)
+
+  def setup
+    options = Selenium::WebDriver::Chrome::Options.new
+    %w[--headless --no-sandbox --disable-dev-shm-usage].each { options.add_argument(it) }
+    @browser = Selenium::WebDriver.for(:chrome, options: options)
+    timezone "America/Los_Angeles"
+
+    stimulus = File.join(Gem::Specification.find_by_name("stimulus-rails").full_gem_path, "app/assets/javascripts/stimulus.min.js")
+    imports = {
+      "@hotwired/stimulus" => module_url(stimulus),
+      "helpers/date_helpers" => module_url("#{ROOT}/app/javascript/helpers/date_helpers.js"),
+      "helpers/local_time_helpers" => module_url("#{ROOT}/app/javascript/helpers/local_time_helpers.js"),
+      "local-time-controller" => module_url("#{ROOT}/app/javascript/controllers/local_time_controller.js")
+    }
+    html = <<~HTML
+      <meta name="timezone" content="UTC">
+      <script type="importmap">#{ { imports: imports }.to_json }</script>
+      <script type="module">
+        import { Application } from "@hotwired/stimulus"
+        import { formatLocalTime } from "helpers/local_time_helpers"
+        import { signedDifferenceInDays } from "helpers/date_helpers"
+        import LocalTimeController from "local-time-controller"
+        window.formatLocalTime = formatLocalTime
+        window.signedDifferenceInDays = signedDifferenceInDays
+        window.app = Application.start()
+        window.app.register("local-time", LocalTimeController)
+      </script>
+    HTML
+    @browser.navigate.to("data:text/html;base64,#{Base64.strict_encode64(html)}")
+    wait { @browser.execute_script("return !!window.app") }
+  end
+
+  def teardown
+    @browser&.quit
+  end
+
+  def test_relative_labels_use_local_calendar_days
+    now = "2025-09-17T22:42:00Z"
+    assert_equal "1:42 PM", format("2025-09-17T20:42:00Z", now: now)
+    assert_equal "yesterday", format("2025-09-17T06:59:00Z", now: now)
+    assert_equal "5 days ago", format("2025-09-12T20:42:00Z", now: now)
+    assert_equal "Sep 10", format("2025-09-10T20:42:00Z", now: now)
+    assert_equal "Sep 10, 2024", format("2024-09-10T20:42:00Z", now: now)
+    assert_equal "tomorrow", format("2025-09-18T07:01:00Z", now: now)
+    assert_equal "in 3 days", format("2025-09-20T20:42:00Z", now: now)
+  end
+
+  def test_identical_timestamps_render_in_the_viewers_timezone
+    timestamp = "2025-09-17T06:42:00Z"
+    assert_equal "11:42 PM", format(timestamp, type: "time")
+    assert_equal "Sep 16", format(timestamp, type: "date")
+    timezone "Asia/Tokyo"
+    assert_equal "3:42 PM", format(timestamp, type: "time")
+    assert_equal "Sep 17", format(timestamp, type: "date")
+  end
+
+  def test_dst_transitions_do_not_change_calendar_day_counts
+    assert_equal "tomorrow", format("2025-03-10T07:01:00Z", now: "2025-03-09T08:01:00Z")
+    assert_equal "yesterday", format("2025-03-09T08:01:00Z", now: "2025-03-10T07:01:00Z")
+    assert_equal "tomorrow", format("2025-11-03T08:01:00Z", now: "2025-11-02T07:01:00Z")
+    assert_equal "yesterday", format("2025-11-02T07:01:00Z", now: "2025-11-03T08:01:00Z")
+  end
+
+  def test_status_bubbles_count_browser_days_not_server_days
+    assert_equal 1, @browser.execute_script(<<~JS)
+      return signedDifferenceInDays(new Date("2025-09-17T06:59:00Z"), new Date("2025-09-17T07:01:00Z"))
+    JS
+    timezone "Asia/Tokyo"
+    assert_equal 0, @browser.execute_script(<<~JS)
+      return signedDifferenceInDays(new Date("2025-09-17T06:59:00Z"), new Date("2025-09-17T07:01:00Z"))
+    JS
+  end
+
+  def test_month_year_and_leap_day_boundaries
+    assert_equal "yesterday", format("2024-12-31T20:00:00Z", now: "2025-01-01T20:00:00Z")
+    assert_equal "tomorrow", format("2025-01-01T20:00:00Z", now: "2024-12-31T20:00:00Z")
+    assert_equal "2 days ago", format("2024-02-28T20:00:00Z", now: "2024-03-01T20:00:00Z")
+  end
+
+  def test_explicit_formats_and_date_only_values
+    assert_equal "Wednesday, September 17", format("2025-09-17", type: "weekday")
+    assert_equal "Sep 17, 2025", format("2025-09-17T20:42:00Z", type: "fullDate")
+    assert_equal "Sep 17, 2025, 1:42 PM", format("2025-09-17T20:42:00Z", type: "datetime")
+    assert_equal "", format("invalid")
+  end
+
+  def test_stimulus_renders_inserted_content_and_cleans_up_its_refresh_timer
+    @browser.execute_script(<<~JS)
+      window.refreshes = new Map()
+      window.setInterval = (callback, delay) => { refreshes.set(123, callback); return 123 }
+      window.clearInterval = id => refreshes.delete(id)
+      document.body.insertAdjacentHTML("beforeend", '<time datetime="2025-09-17T20:42:00Z" data-controller="local-time" data-local-time-format-value="time">raw</time>')
+    JS
+    wait { @browser.find_element(:tag_name, "time").text == "1:42 PM" }
+    assert_equal "Sep 17, 2025, 1:42 PM", @browser.find_element(:tag_name, "time").attribute("title")
+
+    @browser.execute_script(<<~JS)
+      document.querySelector("time").dateTime = "2025-09-17T21:42:00Z"
+      refreshes.get(123)()
+    JS
+    assert_equal "2:42 PM", @browser.find_element(:tag_name, "time").text
+    @browser.execute_script('document.querySelector("time").remove()')
+    wait { @browser.execute_script("return refreshes.size === 0") }
+
+    @browser.execute_script('document.body.insertAdjacentHTML("beforeend", \'<time datetime="invalid" data-controller="local-time">fallback</time>\')')
+    wait { @browser.execute_script('return !!app.getControllerForElementAndIdentifier(document.querySelector("time"), "local-time")') }
+    assert_equal "fallback", @browser.find_element(:tag_name, "time").text
+  end
+
+  private
+    def module_url(path)
+      "data:text/javascript;base64,#{Base64.strict_encode64(File.read(path))}"
+    end
+
+    def timezone(name)
+      @browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: name)
+    end
+
+    def format(timestamp, type: "relative", now: "2025-09-17T22:42:00Z")
+      @browser.execute_script("return formatLocalTime(arguments[0], arguments[1], new Date(arguments[2]))", timestamp, type, now)
+    end
+
+    def wait(&block)
+      Selenium::WebDriver::Wait.new(timeout: 5).until(&block)
+    end
+end
