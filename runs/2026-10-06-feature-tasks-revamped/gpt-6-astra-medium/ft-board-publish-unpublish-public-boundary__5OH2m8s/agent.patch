+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards start unpublished" do
+    assert_not @board.published?
+  end
+
+  test "publishing is idempotent and generates a secret key" do
+    @board.publish
+    key = @board.publication.key
+    assert_operator key.length, :>=, 24
+    assert @board.published?
+
+    assert_no_difference "Board::Publication.count" do
+      @board.publish
+    end
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "unpublishing revokes the key and republishing generates a new one" do
+    @board.publish
+    key = @board.publication.key
+    @board.unpublish
+    assert_not @board.reload.published?
+    assert_nil Board::Publication.find_by(key: key)
+    @board.unpublish
+
+    @board.publish
+    assert_not_equal key, @board.publication.key
+  end
+
+  test "destroying a board destroys its publication" do
+    @board.publish
+    assert_difference "Board::Publication.count", -1 do
+      @board.destroy!
+    end
+  end
+end
