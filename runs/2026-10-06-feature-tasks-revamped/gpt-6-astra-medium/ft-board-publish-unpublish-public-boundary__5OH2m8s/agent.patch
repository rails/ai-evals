new file mode 100644
index 0000000..13794b9
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,24 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy
+  end
+
+  def publish
+    with_lock do
+      publication || create_publication!
+    end
+  end
+
+  def unpublish
+    with_lock do
+      publication&.destroy!
+      reload_publication
+    end
+  end
+
+  def published?
+    publication.present?
+  end
+end
