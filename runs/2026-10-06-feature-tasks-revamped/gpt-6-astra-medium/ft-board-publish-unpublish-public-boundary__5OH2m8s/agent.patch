index 0000000..c3797f6
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+  end
+
+  test "anonymous visitors can navigate boards columns and published cards" do
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a[href=?]", public_board_column_path(@key, columns(:writebook_triage))
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:logo))
+
+    get public_board_column_path(@key, columns(:writebook_triage))
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:logo))
+
+    get public_board_card_path(@key, cards(:logo))
+    assert_response :success
+    assert_select "h1", text: cards(:logo).title
+    assert_select "form", count: 0
+  end
+
+  test "signed in visitors from another account can read public boards" do
+    sign_in_as :mike
+    get public_board_path(@key)
+    assert_response :success
+  end
+
+  test "drafts are neither listed nor directly accessible" do
+    draft = @board.cards.create!(title: "Secret draft", creator: users(:david), column: columns(:writebook_triage), status: :drafted)
+
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, draft), count: 0
+
+    get public_board_column_path(@key, draft.column)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, draft), count: 0
+
+    get public_board_card_path(@key, draft)
+    assert_response :not_found
+  end
+
+  test "cards and columns from other boards are not accessible" do
+    other_column = boards(:private).columns.create!(name: "Secret")
+    other_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Secret", creator: users(:kevin), status: :published)
+    end
+
+    get public_board_column_path(@key, other_column)
+    assert_response :not_found
+    get public_board_card_path(@key, other_card)
+    assert_response :not_found
+  end
+
+  test "invalid and revoked keys cannot access any public pages" do
+    @board.unpublish
+    [ @key, "invalid" ].each do |key|
+      get public_board_path(key)
+      assert_response :not_found
+      get public_board_column_path(key, columns(:writebook_triage))
+      assert_response :not_found
+      get public_board_card_path(key, cards(:logo))
+      assert_response :not_found
+    end
+  end
+
+  test "private boards can be explicitly shared without changing membership" do
+    board = boards(:private)
+    board.publish
+    get public_board_path(board.publication.key)
+    assert_response :success
+    assert_select "h1", text: board.name
+    assert_not board.reload.all_access?
+  end
+
+  test "public responses prevent caching and leaking the secret via referrers" do
+    get public_board_path(@key)
+    assert_response :success
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_equal "no-referrer", response.headers["Referrer-Policy"]
+    assert_select 'meta[name="turbo-cache-control"][content="no-cache"]'
+  end
+
+  test "republishing does not revive the old key" do
+    @board.unpublish
+    @board.publish
+    get public_board_path(@key)
+    assert_response :not_found
+    get public_board_path(@board.publication.key)
+    assert_response :success
+  end
+
+  test "a key cannot be used in another account" do
+    get public_board_path(@key, script_name: accounts(:initech).slug)
+    assert_response :not_found
+  end
+end
