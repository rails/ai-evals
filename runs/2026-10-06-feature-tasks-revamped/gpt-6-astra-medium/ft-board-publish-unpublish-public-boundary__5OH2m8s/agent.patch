+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "publish and unpublish a board" do
+    post "#{board_path(@board)}/publication", as: :json
+    assert_response :success
+
+    @board.reload
+    assert @board.published?
+    get board_path(@board), as: :json
+    assert_equal public_board_url(@board.publication.key), response.parsed_body["public_url"]
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert_not @board.reload.published?
+
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body["public_url"]
+  end
+
+  test "unpublished boards include a null public URL" do
+    get board_path(@board), as: :json
+    assert_response :success
+    assert response.parsed_body.key?("public_url")
+    assert_nil response.parsed_body["public_url"]
+  end
+
+  test "owners can publish boards" do
+    @board.accesses.grant_to users(:jason)
+    logout_and_sign_in_as :jason
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    assert @board.reload.published?
+  end
+
+  test "publication changes invalidate board JSON" do
+    get board_path(@board), as: :json
+    etag = response.headers["ETag"]
+
+    travel 1.second do
+      post board_publication_path(@board), as: :json
+    end
+
+    get board_path(@board), as: :json, headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert response.parsed_body["public_url"].present?
+    etag = response.headers["ETag"]
+
+    travel 2.seconds do
+      delete board_publication_path(@board), as: :json
+    end
+
+    get board_path(@board), as: :json, headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_nil response.parsed_body["public_url"]
+  end
+
+  test "members cannot publish even boards they created" do
+    logout_and_sign_in_as :david
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "members cannot unpublish" do
+    @board.publish
+    logout_and_sign_in_as :david
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "admins cannot publish inaccessible boards" do
+    post board_publication_path(boards(:miltons_wish_list)), as: :json
+    assert_response :not_found
+  end
+
+  test "anonymous visitors cannot publish or unpublish" do
+    sign_out
+    post board_publication_path(@board)
+    assert_response :redirect
+    assert_not @board.reload.published?
+
+    @board.publish
+    delete board_publication_path(@board)
+    assert_response :redirect
+    assert @board.reload.published?
+  end
+
+  test "HTML publication changes redirect to board settings" do
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+  end
+end
