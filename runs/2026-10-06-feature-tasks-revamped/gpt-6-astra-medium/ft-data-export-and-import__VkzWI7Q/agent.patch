@@ -0,0 +1,26 @@
+require "test_helper"
+
+class DataTransferMailerTest < ActionMailer::TestCase
+  test "export email links to the expiring download" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: "cards", status: "completed", completed_at: Time.current)
+    mail = DataTransferMailer.export_ready(export)
+    assert_equal [ users(:jason).identity.email_address ], mail.to
+    assert_match "/exports/", mail.body.to_s
+    assert_match "one day", mail.body.to_s
+  end
+
+  test "successful import email links to the new account" do
+    import = Import.create!(identity: identities(:mike), account: accounts(:"37s"), status: "completed")
+    mail = DataTransferMailer.import_finished(import)
+    assert_equal [ identities(:mike).email_address ], mail.to
+    assert_match import.account.slug, mail.body.to_s
+  end
+
+  test "failed import email explains why" do
+    import = Import.create!(identity: identities(:mike), status: "failed", failure_reason: "Corrupt ZIP entry")
+    mail = DataTransferMailer.import_finished(import)
+    assert_equal [ identities(:mike).email_address ], mail.to
+    assert_match "Corrupt ZIP entry", mail.body.to_s
+    assert_match "No new account was kept", mail.body.to_s
+  end
+end
diff --git a/test/models/data_transfer_test.rb b/test/models/data_transfer_test.rb
new file mode 100644
index 0000000..bbae12e
--- /dev/null
+++ b/test/models/data_transfer_test.rb
@@ -0,0 +1,186 @@
+require "test_helper"
+
+class DataTransferTest < ActiveSupport::TestCase
+  test "account archive restores into a separate account" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: "account")
+    export.generate
+    assert export.available?
+
+    import = Import.create!(identity: identities(:mike))
+    export.archive.blob.open { |file| import.upload(file) }
+    assert_difference "Account.count" do
+      import.process
+      assert_equal "completed", import.reload.status, import.failure_reason
+    end
+    destination = import.account
+    assert_not_equal export.account, destination
+    assert_equal export.account.boards.count, destination.boards.count
+    assert_equal export.account.cards.count, destination.cards.count
+    assert_equal Comment.where(account: export.account).count, Comment.where(account: destination).count
+    assert destination.users.find_by!(identity: identities(:mike)).owner?
+    assert_equal cards(:logo).description.to_plain_text, destination.cards.find_by!(number: cards(:logo).number).description.to_plain_text
+  end
+
