+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    @url = export_url(export.download_token, script_name: nil)
+    mail to: export.user.identity.email_address, subject: "Your Fizzy export is ready"
+  end
+
+  def import_finished(import)
+    @import = import
+    @url = root_url(script_name: import.account.slug) if import.status == "completed"
+    mail to: import.identity.email_address, subject: "Your Fizzy import #{import.status == 'completed' ? 'is complete' : 'failed'}"
+  end
+end
