diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..ec2cf27
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,83 @@
+# Reads ranges from either Disk or S3 without downloading the archive first.
+class ZipFile::Reader
+  MAX_JSON_SIZE = 32.megabytes
+
+  def initialize(service:, key:, byte_size:)
+    @io = RangeIO.new(service, key, byte_size)
+    entries = ZipKit::FileReader.read_zip_structure(io: @io, read_local_headers: false)
+    @entries = entries.index_by(&:filename)
+    raise ArgumentError, "Duplicate archive entries" unless entries.size == @entries.size
+    raise ArgumentError, "Invalid archive paths" if @entries.keys.any? { |path| path.start_with?("/") || path.split("/").include?("..") }
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def json(path)
+    raise ArgumentError, "JSON entry too large" if @entries.fetch(path).uncompressed_size > MAX_JSON_SIZE
+    content = +""
+    extract(path) { |chunk| content << chunk }
+    JSON.parse(content)
+  end
+
+  def extract(path)
+    entry = @entries.fetch(path)
+    unless entry.known_offset?
+      entry.compressed_data_offset = ZipKit::FileReader.new.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+    end
+    raise ArgumentError, "Invalid ZIP entry bounds" if entry.compressed_data_offset + entry.compressed_size > @io.size
+    extractor = entry.extractor_from(@io)
+
+    size = crc = 0
+    until extractor.eof?
+      chunk = extractor.extract(16.kilobytes)
+      raise ArgumentError, "Truncated ZIP entry" if chunk.blank?
+      size += chunk.bytesize
+      raise ArgumentError, "Invalid ZIP entry size" if size > entry.uncompressed_size
+      crc = Zlib.crc32(chunk, crc)
+      yield chunk
+    end
+    raise ArgumentError, "Corrupt ZIP entry" unless size == entry.uncompressed_size && crc == entry.crc32
+  end
+
+  class RangeIO
+    attr_reader :size, :pos
+    alias tell pos
+
+    def initialize(service, key, size)
+      @service, @key, @size, @pos = service, key, size, 0
+    end
+
+    def seek(offset, whence = IO::SEEK_SET)
+      position = case whence
+      when IO::SEEK_SET then offset
+      when IO::SEEK_CUR then pos + offset
+      when IO::SEEK_END then size + offset
+      end
+      raise ArgumentError, "Invalid ZIP offset" unless position&.between?(0, size)
+      @pos = position
+      0
+    end
+
+    def read(length = nil)
+      length ||= size - pos
+      raise ArgumentError, "ZIP directory too large" if length > 64.megabytes || length.negative?
+      length = [ length, size - pos ].min
+      return "" if length.zero?
+      if length <= 4.megabytes
+        unless @buffer && pos >= @buffer_start && pos + length <= @buffer_start + @buffer.bytesize
+          @buffer_start = pos
+          @buffer = @service.download_chunk(@key, pos...[ pos + 4.megabytes, size ].min)
+        end
+        data = @buffer.byteslice(pos - @buffer_start, length)
+      else
+        data = @service.download_chunk(@key, pos...(pos + length))
+      end
+      raise ArgumentError, "Truncated archive" unless data && data.bytesize == length
+
+      @pos += data.bytesize
+      data
+    end
+  end
+end
