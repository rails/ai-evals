diff --git a/docs/data-transfers.md b/docs/data-transfers.md
new file mode 100644
index 0000000..45d69c8
--- /dev/null
+++ b/docs/data-transfers.md
@@ -0,0 +1,49 @@
+# Account transfers
+
+Admins can request an account ZIP from Account Settings. Everyone can request a
+ZIP of their accessible cards from their own profile. Generation happens in a
+background job; the email contains a signed download link that expires 24 hours
+after generation. A scheduled job purges the archive after that period.
+
+A signed-in person can upload an account ZIP at `/account/imports/new` (without
+an account URL prefix). It always creates a separate account. The importing
+identity becomes an owner with access to every imported board. Other people's
+memberships are matched by email address; login credentials and sessions are
+never imported. Success and failure are reported by email.
+
+## Archive format (version 1)
+
+* `manifest.json` identifies the format version and `account` or `cards` kind.
+* `cards/<id>.json` contains a card, its description, comments, and attachment
+  paths. Personal exports contain only cards available to the requesting user.
+* `files/` contains original attachment bytes, including inline rich-text files.
+* Account archives additionally contain `records/<table>/<id>.json`. Only the
+  models listed in `Account::DataTransfer::Manifest` can be restored. Personal
+  exports cannot be used as account imports.
+
+Imports allocate fresh IDs, storage keys, publication keys, and an account join
+code. Rich-text file and mention identifiers are rewritten for the destination
+installation. Imported webhooks are disabled until explicitly enabled. Search
+indexes and storage accounting are rebuilt from the imported records.
+
+Database writes are transactional. An invalid reference, missing/corrupt file,
+unsupported format, or other failure rolls back the new account, memberships,
+and records, and removes newly uploaded storage objects. The import status and
+failure reason remain for the completion email.
+
+## Storage and jobs
+
+Both Disk and S3 services are supported. ZIP generation streams attachment bytes;
+S3 uses multipart uploads. Import reads archive ranges rather than downloading
+the entire ZIP, and S3 attachment restoration also uses multipart uploads. Disk
+exports need temporary space for the ZIP; Disk imports need temporary space for
+the largest individual file. JSON entries are limited to 32 MiB and the ZIP
+central directory to 64 MiB when reading untrusted archives.
+
+Background workers and outgoing email must be configured. Regression checks:
+
+```
+bin/rails test test/models/data_transfer_test.rb test/models/zip_file_test.rb \
+  test/controllers/data_transfers_controller_test.rb \
+  test/mailers/data_transfer_mailer_test.rb
+```
diff --git a/test/controllers/data_transfers_controller_test.rb b/test/controllers/data_transfers_controller_test.rb
new file mode 100644
index 0000000..ae05401
--- /dev/null
+++ b/test/controllers/data_transfers_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class DataTransfersControllerTest < ActionDispatch::IntegrationTest
+  test "admins may request a whole-account export" do
+    sign_in_as :kevin
+    assert_enqueued_with(job: ExportJob) do
+      post account_exports_path
+    end
+    assert_redirected_to account_settings_path
+    assert_equal "account", Export.last.kind
+    assert_equal users(:kevin), Export.last.user
+  end
+
+  test "members may only request their own visible cards" do
+    sign_in_as :david
+    assert_no_difference "Export.count" do
+      post account_exports_path
+      assert_response :forbidden
+    end
+    post my_exports_path, params: { user_id: users(:kevin).id, kind: "account" }
+    assert_redirected_to user_path(users(:david))
+    assert_equal "cards", Export.last.kind
+    assert_equal users(:david), Export.last.user
+  end
+
+  test "signed in people can import without belonging to an account" do
+    sign_in_as :mike
+    untenanted do
+      get new_account_import_path
+      assert_response :success
+      post account_imports_path
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "an uploaded archive is queued for the signed in identity" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: "account")
+    export.generate
+    sign_in_as :mike
+    untenanted do
+      export.archive.blob.open do |file|
+        assert_enqueued_with(job: ImportJob) do
+          post account_imports_path, params: { archive: Rack::Test::UploadedFile.new(file.path, "application/zip") }
+        end
+      end
+      assert_redirected_to new_account_import_path
+      assert_equal identities(:mike), Import.last.identity
+      ImportJob.perform_now(Import.last)
+      assert_equal "completed", Import.last.status
+    end
+  end
+
+  test "imports require authentication" do
+    untenanted do
+      get new_account_import_path
+      assert_response :redirect
+      assert_no_difference "Import.count" do
+        post account_imports_path
+      end
+    end
+  end
+
+  test "download links are signed and expire" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: "cards")
+    export.generate
+    token = export.download_token
+    untenanted do
+      get export_path(token)
+      assert_response :redirect
+      get export_path("invalid")
+      assert_response :not_found
+      travel 1.day + 1.second do
+        get export_path(token)
+        assert_response :not_found
+      end
+    end
+  end
+end
