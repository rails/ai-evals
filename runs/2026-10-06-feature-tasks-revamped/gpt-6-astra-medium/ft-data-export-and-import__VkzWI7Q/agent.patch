diff --git a/app/models/account/data_transfer/restorer.rb b/app/models/account/data_transfer/restorer.rb
new file mode 100644
index 0000000..e2746be
--- /dev/null
+++ b/app/models/account/data_transfer/restorer.rb
@@ -0,0 +1,195 @@
+# Only models in our manifest may be restored. IDs (including polymorphic
+# references) always resolve within the archive, never against the destination.
+class Account::DataTransfer::Restorer
+  def initialize(zip, identity)
+    @zip, @identity = zip, identity
+    @ids, @types, @uploads = {}, {}, []
+    @models = []
+    Account::DataTransfer::Manifest.new(nil).each_record_set do |set|
+      @models << set.model unless @models.include?(set.model)
+    end
+  end
+
+  def restore
+    raise ArgumentError, "Not a supported Fizzy account archive" unless @zip.json("manifest.json") == { "version" => 1, "kind" => "account" }
+    index_records
+    account_paths = paths(Account)
+    raise ArgumentError, "An archive must contain exactly one account" unless account_paths.one?
+    source = @zip.json(account_paths.first)
+
+    Account.transaction(requires_new: true) do
+      @account = Account.create!(name: source.fetch("name"), cards_count: source.fetch("cards_count"))
+      @account.entropies.delete_all
+      @ids[source.fetch("id")] = @account.id
+      Current.with_account(@account) do
+        @models.excluding(Account, ::ActiveStorage::Blob, ::ActionText::RichText).each do |model|
+          restore_records(model)
+        end
+        restore_records(::ActiveStorage::Blob)
+        restore_records(::ActionText::RichText)
+        ensure_owner
+        @account.boards.find_each(&:reconcile_storage)
+        @account.cards.includes(:rich_text_description).find_each(&:reindex)
+        Comment.where(account: @account).includes(:rich_text_body, :card).find_each(&:reindex)
+      end
+      @account
+    end
+  rescue StandardError
+    # Storage isn't transactional. Delete every newly allocated object, even
+    # when upload or a subsequent record fails.
+    @uploads.each { |service, key| service.delete(key) }
+    raise
+  end
+
+  private
+    def paths(model)
+      @zip.glob("records/#{model.table_name}/*.json")
+    end
+
+    def index_records
+      known_paths = []
+      @models.each do |model|
+        paths(model).each do |path|
+          row = @zip.json(path)
+          id = row.fetch("id")
+          raise ArgumentError, "Invalid or duplicate record ID" unless id.is_a?(String) && id.match?(/\A[a-z0-9]{25}\z/) && !@ids.key?(id)
+          raise ArgumentError, "Record path does not match ID" unless path == "records/#{model.table_name}/#{id}.json"
+          @ids[id] = ActiveRecord::Type::Uuid.generate
+          @types[id] = model
+          known_paths << path
+        end
+      end
+      raise ArgumentError, "Unknown record types" unless (@zip.glob("records/*/*.json") - known_paths).empty?
+    end
+
+    def restore_records(model)
+      paths(model).each do |path|
+        row = @zip.json(path)
+        old_id = row.fetch("id")
+        associations = row.delete("associations") if model == Filter
+        email = row.delete("email_address") if model == User
+        raise ArgumentError, "Unknown attributes for #{model.name}" unless (row.keys - model.column_names).empty?
+
+        row.each do |key, value|
+          if key == "id"
+            row[key] = @ids.fetch(value)
+          elsif key == "account_id"
+            raise ArgumentError, "Cross-account reference" unless @types[value] == Account
+            row[key] = @account.id
+          elsif key == "identity_id" && model == User
+            row[key] = email.present? ? Identity.find_or_create_by!(email_address: email).id : nil
+          elsif value.is_a?(Hash) || value.is_a?(Array)
+            row[key] = remap_nested_ids(value)
+          elsif key.end_with?("_id") && value.present?
+            validate_reference(model, row, key, value)
+            row[key] = @ids.fetch(value) { raise ArgumentError, "Missing reference: #{model.name}.#{key}" }
+          end
+        end
+
+        if model == ::ActiveStorage::Blob
+          restore_blob(row, old_id)
+        else
+          row["body"] = restore_body(row["body"]) if model == ::ActionText::RichText
+          # Imported webhooks must be explicitly enabled on the new instance.
+          row["active"] = false if model == Webhook
+          row["key"] = SecureRandom.base58(24) if model == Board::Publication
+          model.insert_all!([ row ])
+          restore_filter(row.fetch("id"), associations) if model == Filter
+        end
+      end
+    end
+
+    def remap_nested_ids(value)
+      case value
+      when Hash then value.transform_values { |nested| remap_nested_ids(nested) }
+      when Array then value.map { |nested| remap_nested_ids(nested) }
+      when String then @ids.fetch(value, value)
+      else value
+      end
+    end
+
+    def restore_filter(id, associations)
+      filter = Filter.find(id)
+      associations.to_h.each do |name, ids|
+        raise ArgumentError, "Unknown filter association" unless name.in?(%w[tags boards assignees creators closers])
+        expected = Filter.reflect_on_association(name).klass
+        mapped_ids = ids.map do |old_id|
+          raise ArgumentError, "Invalid filter reference" unless @types[old_id] == expected
+          @ids.fetch(old_id)
+        end
+        filter.public_send("#{name.singularize}_ids=", mapped_ids)
+      end
+      filter.save!
+    end
+
+    def validate_reference(model, row, key, value)
+      association = model.reflect_on_all_associations(:belongs_to).find { |reflection| reflection.foreign_key == key }
+      if association
+        expected = association.polymorphic? ? row.fetch(association.foreign_type) : association.klass.name
+        raise ArgumentError, "Invalid reference: #{model.name}.#{key}" unless @types[value]&.name == expected
+      end
+    end
+
+    def restore_blob(row, old_id)
+      blob = ::ActiveStorage::Blob.new(row.except("key", "service_name"))
+      blob.key = SecureRandom.base58(32)
+      blob.service_name = ::ActiveStorage::Blob.service.name
+      @uploads << [ blob.service, blob.key ]
+      if defined?(::ActiveStorage::Service::S3Service) && blob.service.is_a?(::ActiveStorage::Service::S3Service)
+        blob.service.send(:upload_stream, key: blob.key, content_type: blob.content_type, part_size: 100.megabytes) do |stream|
+          extract_blob(old_id, blob, stream)
+        end
+      else
+        Tempfile.create("fizzy-import", binmode: true) do |file|
+          extract_blob(old_id, blob, file)
+          file.rewind
+          blob.service.upload(blob.key, file, checksum: blob.checksum)
+        end
+      end
+      blob.save!
+    end
+
+    def extract_blob(old_id, blob, destination)
+      digest = Digest::MD5.new
+      size = 0
+      @zip.extract("files/#{old_id}") do |chunk|
+        size += chunk.bytesize
+        raise ArgumentError, "Attachment size mismatch" if size > blob.byte_size
+        digest.update(chunk)
+        destination.write(chunk)
+      end
+      unless size == blob.byte_size && Base64.strict_encode64(digest.digest) == blob.checksum
+        raise ArgumentError, "Attachment checksum or size mismatch"
+      end
+    end
+
+    def restore_body(body)
+      fragment = Nokogiri::HTML::DocumentFragment.parse(body.to_s)
+      fragment.css("action-text-attachment[sgid]").each do |node|
+        if match = node["sgid"].match(/\Afizzy:(ActiveStorage::Blob|User):([a-z0-9]{25})\z/)
+          model = @types.fetch(match[2])
+          raise ArgumentError, "Invalid rich text reference" unless model.name == match[1]
+          attachable = model.find(@ids.fetch(match[2]))
+          node["sgid"] = attachable.attachable_sgid
+          if attachable.is_a?(::ActiveStorage::Blob)
+            node["url"] = Rails.application.routes.url_helpers.rails_blob_path(attachable, only_path: true, script_name: @account.slug)
+          end
+        else
+          # Signed identifiers from another installation must never resolve here.
+          node.remove_attribute("sgid")
+        end
+      end
+      fragment.to_html
+    end
+
+    def ensure_owner
+      owner = @account.users.find_by(identity: @identity)
+      if owner
+        owner.update!(role: :owner, active: true, verified_at: Time.current)
+      else
+        owner = @account.users.create!(identity: @identity, name: @identity.email_address, role: :owner, verified_at: Time.current)
+      end
+      @account.boards.find_each { |board| board.accesses.grant_to(owner) unless board.accessible_to?(owner) }
+      raise ArgumentError, "Missing system user" unless @account.users.exists?(role: :system)
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..5c97714
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,71 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :archive
+
+  validates :kind, inclusion: { in: %w[account cards] }
+
+  def generate
+    with_lock do
+      unless status == "completed"
+        raise ActiveRecord::RecordNotFound unless account.active? && user.account_id == account.id && user.active? && (kind == "cards" || user.admin?)
+
+        ZipFile.create_for(archive, filename: "fizzy-#{kind}-#{id}.zip") do |zip|
+          zip.add_file("manifest.json", { version: 1, kind: kind }.to_json)
+          if kind == "account"
+            Account::DataTransfer::Manifest.new(account).each_record_set { |set| set.export_to(zip) }
+          end
+          export_cards(zip)
+        end
+        update!(status: "completed", completed_at: Time.current)
+      end
+    end
+    DataTransferMailer.export_ready(self).deliver_later
+    Export::CleanupJob.set(wait: 1.day).perform_later(self)
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_at: completed_at + 1.day)
+  end
+
+  def available?
+    status == "completed" && completed_at > 1.day.ago && archive.attached?
+  end
+
+  private
+    def export_cards(zip)
+      cards = kind == "account" ? account.cards : user.accessible_cards
+      cards.find_each do |card|
+        comments = card.comments.includes(:rich_text_body).map do |comment|
+          comment.attributes.merge("body" => comment.body.body&.to_html.to_s)
+        end
+        attachments = attachments_for(card).includes(:blob).to_a
+        data = card.attributes.merge("description" => card.description.body&.to_html.to_s, "comments" => comments)
+        data["attachments"] = attachments.map do |attachment|
+          blob = attachment.blob
+          { "record_type" => attachment.record_type, "record_id" => attachment.record_id,
+            "filename" => blob.filename.to_s, "content_type" => blob.content_type, "path" => file_path(blob) }
+        end
+        zip.add_file("cards/#{card.id}.json", data.to_json)
+        if kind == "cards"
+          attachments.each do |attachment|
+            blob = attachment.blob
+            unless zip.exists?(file_path(blob))
+              zip.add_file(file_path(blob), compress: false) { |sink| blob.download { |chunk| sink.write(chunk) } }
+            end
+          end
+        end
+      end
+    end
+
+    def attachments_for(card)
+      texts = ActionText::RichText.where(record: card).or(ActionText::RichText.where(record: card.comments))
+      ActiveStorage::Attachment.where(record: card)
+        .or(ActiveStorage::Attachment.where(record: card.comments))
+        .or(ActiveStorage::Attachment.where(record: texts))
+    end
+
+    def file_path(blob)
+      kind == "account" ? "files/#{blob.id}" : "files/#{blob.id}/#{blob.filename}"
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..fe3147b
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,36 @@
+class Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  def upload(file)
+    update!(archive_key: SecureRandom.base58(32), service_name: ActiveStorage::Blob.service.name, byte_size: file.size)
+    service.upload(archive_key, file)
+  rescue
+    service.delete(archive_key) if archive_key
+    raise
+  end
+
+  def process
+    with_lock do
+      if status == "pending"
+        begin
+          transaction(requires_new: true) do
+            reader = ZipFile::Reader.new(service: service, key: archive_key, byte_size: byte_size)
+            imported_account = Account::DataTransfer::Restorer.new(reader, identity).restore
+            update!(account: imported_account, status: "completed")
+          end
+        rescue StandardError => error
+          Rails.error.report(error)
+          update!(status: "failed", failure_reason: "#{error.class}: #{error.message}".truncate(1000))
+        end
+      end
+    end
+    service.delete(archive_key)
+    DataTransferMailer.import_finished(self).deliver_later
+  end
+
+  private
+    def service
+      ActiveStorage::Blob.services.fetch(service_name)
+    end
+end
