diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..7f4b6ee
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,64 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  TIMEOUT = 15.seconds
+
+  def initialize(delivery)
+    @delivery = delivery
+    @webhook = delivery.webhook
+  end
+
+  def perform
+    body = ApplicationController.renderer.new(script_name: @delivery.account.slug).render(
+      template: "webhooks/event", formats: [ :json ], assigns: { event: @delivery.event })
+    headers = {
+      "Content-Type" => "application/json",
+      "User-Agent" => "Fizzy Webhook",
+      "X-Webhook-Id" => @delivery.id,
+      "X-Webhook-Timestamp" => Time.current.iso8601,
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, body)
+    }
+    @delivery.update! request: { headers: headers }
+
+    post(body, headers)
+  rescue Timeout::Error, SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Resolv::ResolvError => error
+    { error: error.class.name }
+  end
+
+  private
+    def post(body, headers)
+      uri = URI.parse(@webhook.url)
+      ip = public_ip(uri.hostname)
+      return { error: "destination_unreachable" } unless ip
+
+      # Pin the checked address while retaining the hostname for TLS and Host.
+      # Disable proxies, redirects and automatic HTTP retries.
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+      http.max_retries = 0
+
+      Timeout.timeout(TIMEOUT) do
+        request = Net::HTTP::Post.new(uri.request_uri, headers)
+        request.body = body
+        http.start do
+          response = http.request(request) do |response|
+            # Do not retain an unbounded, untrusted response body in memory or logs.
+            response.read_body { |_chunk| }
+          end
+          { code: response.code.to_i }
+        end
+      end
+    end
+
+    def public_ip(hostname)
+      address = begin
+        IPAddr.new(hostname).to_s
+      rescue IPAddr::InvalidAddressError
+        SsrfProtection.resolve_public_ip(hostname)
+      end
+
+      address unless address.nil? || SsrfProtection.blocked_address?(address)
+    end
+end
