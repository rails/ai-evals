diff --git a/docs/webhooks.md b/docs/webhooks.md
new file mode 100644
index 0000000..e6cf6c7
--- /dev/null
+++ b/docs/webhooks.md
@@ -0,0 +1,54 @@
+# Board webhooks
+
+Board administrators can configure receivers under the existing board webhook
+settings and select the events each receiver subscribes to. Only active webhooks
+on the event's board receive matching events. An empty subscription sends nothing.
+
+## Requests and delivery logs
+
+Each matching event creates a delivery in the same database transaction. After
+commit, a background job sends a JSON POST containing the event ID, action,
+creation time, eventable (card or comment), board, and creator. URLs in the payload
+include the account's URL prefix.
+
+Requests include:
+
+- `Content-Type: application/json`
+- `X-Webhook-Id`: the stable delivery ID
+- `X-Webhook-Timestamp`: the request time in ISO 8601 format
+- `X-Webhook-Signature`: the hexadecimal HMAC-SHA256 of the exact request body,
+  using the signing secret shown in the webhook settings
+
+Receivers should compare signatures in constant time. The signature covers the
+body, not the timestamp. Use the event/delivery IDs for receiver-side deduplication.
+
+The delivery log records the request headers and HTTP status or transport error.
+Signatures are excluded from the logs API. Any 2xx response is successful; other
+status codes and network errors are failures. Redirects are not followed. Requests
+are time-limited, and private/internal destinations are blocked, with the checked
+IP pinned to prevent DNS rebinding.
+
+## Single-attempt semantics
+
+A unique database key prevents duplicate deliveries for the same webhook/event.
+An atomic, durable claim prevents concurrent or replayed jobs from POSTing the
+same delivery again. There are no automatic retries, including on timeout.
+
+This provides **at-most-once sending**, not a guarantee of exactly-once receipt:
+HTTP cannot distinguish a lost response from a receiver that never processed the
+request. A worker crash after claiming can also leave a delivery in progress with
+an unknown outcome. We intentionally do not resend such deliveries. True
+exactly-once processing requires cooperation from the receiver (durable
+idempotency) and a retry protocol.
+
+## Automatic shutoff and retention
+
+A receiver is deactivated after at least ten consecutive failures whose streak
+spans at least one hour. A successful delivery resets both the count and the first
+failure time. Manually reactivating a receiver also resets its streak. Queued jobs
+check whether the receiver is still active before sending.
+
+Delivery logs are deleted after one week by the existing cleanup task, which runs
+every 15 minutes. Failure counters are retained independently of the logs. Events
+older than a week cannot be dispatched again after their deduplication records
+have expired.
diff --git a/test/models/event/webhookable_test.rb b/test/models/event/webhookable_test.rb
new file mode 100644
index 0000000..663054b
--- /dev/null
+++ b/test/models/event/webhookable_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  test "only active subscriptions on the event board receive a delivery" do
+    matching = webhooks(:active)
+    inactive = copy_webhook(active: false)
+    unsubscribed = copy_webhook(subscribed_actions: [])
+    other_board = copy_webhook(board: boards(:private))
+
+    assert_difference "Webhook::Delivery.count", 1 do
+      assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+        event = create_event
+        assert_equal [ matching.id ], event.webhook_deliveries.pluck(:webhook_id)
+      end
+    end
+    [ inactive, unsubscribed, other_board ].each { |webhook| assert_empty webhook.deliveries }
+  end
+
+  test "each matching receiver gets its own delivery" do
+    copy_webhook
+    assert_difference "Webhook::Delivery.count", 2 do
+      create_event
+    end
+  end
+
+  test "repeated dispatch and database inserts cannot duplicate a delivery" do
+    event = create_event
+    assert_no_difference "Webhook::Delivery.count" do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        event.dispatch_webhooks
+      end
+    end
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      webhooks(:active).deliveries.create!(event: event)
+    end
+  end
+
+  test "rolling back an event neither retains nor enqueues a delivery" do
+    assert_no_difference "Webhook::Delivery.count" do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        Event.transaction do
+          create_event
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "expired events cannot be replayed after log cleanup" do
+    event = create_event
+    travel 1.week + 1.second do
+      Webhook::Delivery.cleanup
+      assert_no_difference "Webhook::Delivery.count" do
+        event.dispatch_webhooks
+      end
+    end
+  end
+
+  test "event creation through delivery job posts the event" do
+    SsrfProtection.stubs(:resolve_public_ip).returns("93.184.216.34")
+    post = stub_request(:post, webhooks(:active).url).to_return(status: 200)
+    event = nil
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      event = create_event
+    end
+    assert_requested post, times: 1
+    assert event.webhook_deliveries.sole.succeeded?
+  end
+
+  private
+    def copy_webhook(**attributes)
+      Webhook.create!(webhooks(:active).attributes.except("id").merge(attributes.stringify_keys))
+    end
+
+    def create_event
+      boards(:writebook).events.create!(action: "card_closed", creator: users(:david), eventable: cards(:logo))
+    end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..3ee7edb
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.create_delinquency_tracker!
+    @failure = Webhook::Delivery.new(state: :completed, response: { code: 503 })
+    @success = Webhook::Delivery.new(state: :completed, response: { code: 204 })
+  end
+
+  test "ten consecutive failures spanning an hour deactivate the webhook" do
+    freeze_time
+    9.times { @tracker.record(@failure) }
+    assert @webhook.reload.active?
+    travel 1.hour
+    @tracker.record(@failure)
+    assert_not @webhook.reload.active?
+    assert_equal 10, @tracker.reload.consecutive_failures_count
+  end
+
+  test "ten failures in less than an hour do not deactivate the webhook" do
+    freeze_time
+    10.times { @tracker.record(@failure) }
+    assert @webhook.reload.active?
+    travel 1.hour - 1.second
+    @tracker.record(@failure)
+    assert @webhook.reload.active?
+  end
+
+  test "an hour of failures with fewer than ten attempts does not deactivate" do
+    @tracker.record(@failure)
+    travel 2.hours do
+      8.times { @tracker.record(@failure) }
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "a success resets the entire streak" do
+    9.times { @tracker.record(@failure) }
+    travel 2.hours do
+      @tracker.record(@success)
+      assert_nil @tracker.reload.first_failure_at
+      assert_equal 0, @tracker.consecutive_failures_count
+      @tracker.record(@failure)
+      assert_equal 1, @tracker.reload.consecutive_failures_count
+      assert @webhook.reload.active?
+      assert_in_delta Time.current, @tracker.first_failure_at, 1.second
+    end
+  end
+
+  test "manual reactivation clears the failure streak" do
+    @tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+    @webhook.activate
+    assert @webhook.reload.active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+end
