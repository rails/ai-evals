diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..0d23653
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,60 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :entries, dependent: :delete_all
+  has_many :notifications, through: :entries
+
+  scope :pending, -> { where(processed_at: nil) }
+
+  validates :starts_at, :ends_at, presence: true
+  validates :ends_at, comparison: { greater_than: :starts_at }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add(notification, at: notification.updated_at)
+      # Lock the recipient, since there may not be a window to lock yet.
+      notification.user.with_lock do
+        user = notification.user
+
+        if duration = user.settings&.bundle_email_interval
+          bundles = user.notification_bundles
+          # No lower bound: out-of-order notifications belong to an already opened window.
+          bundle = bundles.pending.where("ends_at > ?", at).order(:starts_at).first
+
+          unless bundle
+            # Even a late arrival after delivery must not reopen or overlap a closed window.
+            starts_at = [ at, bundles.maximum(:ends_at) ].compact.max
+            bundle = bundles.create!(starts_at: starts_at, ends_at: starts_at + duration)
+          end
+
+          bundle.entries.find_or_create_by!(notification: notification)
+          bundle
+        end
+      end
+    end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver
+    user.with_lock do
+      reload
+
+      if processed_at.nil? && ends_at <= Time.current
+        if deliverable? && notifications.exists?
+          NotificationMailer.digest(self).deliver_now
+        end
+
+        update!(processed_at: Time.current)
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      user.active? && account.active? && user.identity.present? && user.settings&.bundle_email_interval.present?
+    end
+end
