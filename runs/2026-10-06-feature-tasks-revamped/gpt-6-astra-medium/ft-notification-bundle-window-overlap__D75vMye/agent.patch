diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..6452a84
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,258 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    freeze_time
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "first notification starts a window for the selected frequency" do
+    { every_few_hours: 4.hours, daily: 24.hours, weekly: 168.hours }.each do |frequency, duration|
+      clear_enqueued_jobs
+      @user.notification_bundles.reload.destroy_all
+      @user.settings.update!(bundle_email_frequency: frequency)
+
+      freeze_time do
+        bundle = Notification::Bundle.add(@notification, at: Time.current)
+
+        assert_equal Time.current, bundle.starts_at
+        assert_equal Time.current + duration, bundle.ends_at
+        assert_equal [ @notification ], bundle.notifications
+        assert_enqueued_with job: Notification::Bundle::DeliverJob, args: [ bundle ], at: bundle.ends_at
+      end
+    end
+  end
+
+  test "never does not open a window" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_nil Notification::Bundle.add(@notification)
+    end
+  end
+
+  test "notifications share a window without extending it" do
+    freeze_time do
+      bundle = Notification::Bundle.add(@notification, at: Time.current)
+      other = notifications(:layout_commented_kevin)
+
+      assert_no_difference "Notification::Bundle.count" do
+        assert_equal bundle, Notification::Bundle.add(other, at: 3.hours.from_now)
+        assert_equal bundle, Notification::Bundle.add(@notification, at: 2.hours.from_now)
+      end
+
+      assert_equal 4.hours.from_now, bundle.reload.ends_at
+      assert_equal [ @notification.id, other.id ].sort, bundle.notifications.pluck(:id).sort
+    end
+  end
+
+  test "late notifications join the already opened window" do
+    freeze_time do
+      bundle = Notification::Bundle.add(@notification, at: Time.current)
+
+      assert_no_difference "Notification::Bundle.count" do
+        assert_equal bundle, Notification::Bundle.add(notifications(:layout_commented_kevin), at: 2.hours.ago)
+      end
+
+      assert_equal Time.current, bundle.reload.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+    end
+  end
+
+  test "the end of a window starts a new non-overlapping window" do
+    freeze_time do
+      first = Notification::Bundle.add(@notification, at: Time.current)
+      second = Notification::Bundle.add(notifications(:layout_commented_kevin), at: first.ends_at)
+
+      assert_not_equal first, second
+      assert_equal first.ends_at, second.starts_at
+      assert_equal first.ends_at + 4.hours, second.ends_at
+    end
+  end
+
+  test "frequency changes do not overlap an existing window" do
+    freeze_time do
+      first = Notification::Bundle.add(@notification, at: Time.current)
+      @user.settings.update!(bundle_email_frequency: :weekly)
+
+      assert_equal first, Notification::Bundle.add(@notification, at: 1.hour.from_now)
+      second = Notification::Bundle.add(@notification, at: first.ends_at)
+      assert_equal first.ends_at, second.starts_at
+      assert_equal second.starts_at + 168.hours, second.ends_at
+    end
+  end
+
+  test "users have independent windows and frequencies" do
+    users(:david).settings.update!(bundle_email_frequency: :daily)
+
+    freeze_time do
+      first = Notification::Bundle.add(@notification, at: Time.current)
+      second = Notification::Bundle.add(notifications(:logo_mentioned_david), at: 1.hour.from_now)
+
+      assert_equal @user, first.user
+      assert_equal users(:david), second.user
+      assert_equal 25.hours.from_now, second.ends_at
+    end
+  end
+  test "a gap starts the next window with its first notification" do
+    freeze_time do
+      first = Notification::Bundle.add(@notification, at: Time.current)
+      second = Notification::Bundle.add(@notification, at: 2.days.from_now)
+
+      assert_equal 2.days.from_now, second.starts_at
+      assert_operator first.ends_at, :<, second.starts_at
+      assert_equal second, Notification::Bundle.add(notifications(:layout_commented_kevin), at: 1.day.from_now)
+    end
+  end
+
+  test "late arrivals cannot overlap a processed window" do
+    freeze_time do
+      first = Notification::Bundle.add(@notification, at: Time.current)
+      first.update!(processed_at: first.ends_at)
+      second = Notification::Bundle.add(notifications(:layout_commented_kevin), at: 1.hour.ago)
+
+      assert_equal first.ends_at, second.starts_at
+      assert_equal second.starts_at + 4.hours, second.ends_at
+    end
+  end
+
+  test "the scheduled job sends one email for the whole window" do
+    bundle = Notification::Bundle.add(@notification, at: Time.current)
+    Notification::Bundle.add(notifications(:layout_commented_kevin), at: 1.hour.from_now)
+
+    assert_no_emails { bundle.deliver }
+    assert_nil bundle.reload.processed_at
+
+    travel_to bundle.ends_at
+    assert_emails 1 do
+      perform_enqueued_jobs only: Notification::Bundle::DeliverJob
+      bundle.deliver
+    end
+    assert_equal Time.current, bundle.reload.processed_at
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_includes email.html_part.body.to_s, ERB::Util.html_escape(cards(:logo).title)
+    assert_includes email.html_part.body.to_s, cards(:layout).title
+    assert_includes email.html_part.body.to_s, "#{@user.account.slug}/cards/"
+    assert_includes email.text_part.body.to_s, "Change email frequency"
+  end
+
+  test "turning email off suppresses pending digests" do
+    bundle = Notification::Bundle.add(@notification, at: Time.current)
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    travel_to bundle.ends_at do
+      assert_no_emails { bundle.deliver }
+      assert_not_nil bundle.reload.processed_at
+    end
+  end
+
+  test "inactive recipients do not receive pending digests" do
+    bundle = Notification::Bundle.add(@notification, at: Time.current)
+    @user.deactivate
+
+    travel_to bundle.ends_at do
+      assert_no_emails { bundle.deliver }
+      assert_not_nil bundle.reload.processed_at
+    end
+  end
+
+  test "deleted notifications do not leave empty emails" do
+    bundle = Notification::Bundle.add(@notification, at: Time.current)
+    @notification.destroy!
+
+    travel_to bundle.ends_at do
+      assert_no_emails { bundle.deliver }
+      assert_not_nil bundle.reload.processed_at
+      assert_empty bundle.entries
+    end
+  end
+
+  test "a failed delivery can be retried" do
+    bundle = Notification::Bundle.add(@notification, at: Time.current)
+
+    travel_to bundle.ends_at do
+      NotificationMailer.expects(:digest).with(bundle).raises(IOError).once
+      assert_raises(IOError) { bundle.deliver }
+      assert_nil bundle.reload.processed_at
+
+      NotificationMailer.unstub(:digest)
+      assert_emails(1) { bundle.deliver }
+      assert_not_nil bundle.reload.processed_at
+    end
+  end
+
+  test "new notifications are bundled automatically" do
+    notifications(:layout_commented_kevin).destroy!
+
+    freeze_time do
+      assert_difference "Notification::Bundle.count", 1 do
+        notification = Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+        bundle = @user.notification_bundles.last
+
+        assert_equal Time.current, bundle.starts_at
+        assert_equal [ notification ], bundle.notifications
+      end
+    end
+  end
+
+  test "new activity on an existing notification is bundled but reading it is not" do
+    @notification.update!(source: events(:logo_published))
+    bundle = @user.notification_bundles.last
+    assert_equal [ @notification ], bundle.notifications
+
+    assert_no_difference "Notification::Bundle::Entry.count" do
+      assert_no_difference "Notification::Bundle.count" do
+        @notification.read
+        @notification.unread
+      end
+    end
+  end
+  test "concurrent arrivals share one window" do
+    at = Time.current
+    notification_id = @notification.id
+    bundle_ids = 8.times.map do
+      Thread.new do
+        ActiveRecord::Base.connection_pool.with_connection do
+          Notification::Bundle.add(Notification.find(notification_id), at: at).id
+        end
+      end
+    end.map(&:value)
+
+    assert_equal 1, bundle_ids.uniq.size
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 1, Notification::Bundle.find(bundle_ids.first).entries.count
+  end
+
+  test "late notifications choose the earliest pending window that can contain them" do
+    first = Notification::Bundle.add(@notification, at: Time.current)
+    second = Notification::Bundle.add(@notification, at: first.ends_at)
+
+    assert_equal first, Notification::Bundle.add(notifications(:layout_commented_kevin), at: 1.hour.from_now)
+    assert_equal second, Notification::Bundle.add(notifications(:buy_domain_sent_back_to_triage_kevin), at: second.starts_at)
+    assert_equal 2, @user.notification_bundles.count
+  end
+
+  test "the same notification can participate in subsequent windows" do
+    first = Notification::Bundle.add(@notification, at: Time.current)
+    second = Notification::Bundle.add(@notification, at: first.ends_at)
+
+    assert_equal [ @notification ], first.notifications
+    assert_equal [ @notification ], second.notifications
+  end
+
+  test "deleted users remove their bundles and their scheduled jobs are discarded" do
+    Notification::Bundle.add(@notification, at: Time.current)
+    @user.destroy!
+
+    assert_empty Notification::Bundle.where(user_id: @user.id)
+    assert_no_emails do
+      perform_enqueued_jobs only: Notification::Bundle::DeliverJob
+    end
+  end
+end
