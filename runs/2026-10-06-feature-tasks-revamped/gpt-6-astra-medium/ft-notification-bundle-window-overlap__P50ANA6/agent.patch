diff --git a/test/models/notification/bundle_concurrency_test.rb b/test/models/notification/bundle_concurrency_test.rb
new file mode 100644
index 0000000..49b4c71
--- /dev/null
+++ b/test/models/notification/bundle_concurrency_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  setup do
+    @user = users(:kevin)
+    @user.notification_bundles.reload.destroy_all
+    @user.settings.update!(bundle_email_frequency: :daily)
+  end
+
+  teardown do
+    @user.notification_bundles.reload.destroy_all
+    @user.settings.update!(bundle_email_frequency: :never)
+  end
+
+  test "concurrent first arrivals create a single non-overlapping window" do
+    notification_id = notifications(:logo_assignment_kevin).id
+    start = Time.current
+    ready = Queue.new
+    release = Queue.new
+
+    threads = 3.times.map do |index|
+      Thread.new do
+        ActiveRecord::Base.connection_pool.with_connection do
+          notification = Notification.find(notification_id)
+          notification.updated_at = start + index.seconds
+          ready << true
+          release.pop
+          Current.with_account(notification.account) do
+            Notification::Bundle.add(notification).id
+          end
+        end
+      end
+    end
+
+    3.times { ready.pop }
+    3.times { release << true }
+    bundle_ids = threads.map(&:value)
+
+    assert_equal 1, bundle_ids.uniq.size
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 1, @user.notification_bundles.reload.sole.entries.count
+  ensure
+    threads&.each(&:join)
+  end
+  test "concurrent delivery workers send a window only once" do
+    bundle = Notification::Bundle.add(notifications(:logo_assignment_kevin))
+    bundle_id = bundle.id
+    ready = Queue.new
+    release = Queue.new
+
+    travel_to bundle.ends_at do
+      assert_difference "ActionMailer::Base.deliveries.size", 1 do
+        threads = 3.times.map do
+          Thread.new do
+            ActiveRecord::Base.connection_pool.with_connection do
+              copy = Notification::Bundle.find(bundle_id)
+              ready << true
+              release.pop
+              Current.with_account(copy.account) { copy.deliver }
+            end
+          end
+        end
+
+        3.times { ready.pop }
+        3.times { release << true }
+        threads.each(&:value)
+      ensure
+        threads&.each(&:join)
+      end
+    end
+
+    assert bundle.reload.processed_at
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..8574b3d
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,216 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @start = Time.current.change(usec: 0)
+  end
+
+  test "off does not create a bundle" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_nil bundle_at(@start)
+    end
+  end
+
+  test "each frequency starts its clock with the first notification" do
+    { every_few_hours: 4.hours, daily: 1.day, weekly: 1.week }.each do |frequency, duration|
+      @user.settings.update!(bundle_email_frequency: frequency)
+      bundle = bundle_at(@start)
+
+      assert_equal @start, bundle.starts_at
+      assert_equal @start + duration, bundle.ends_at
+      @start = bundle.ends_at + 1.hour
+    end
+  end
+
+  test "notifications in the window share a bundle including late arrivals" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    first = bundle_at(@start)
+
+    assert_equal first, bundle_at(@start + 1.hour)
+    assert_equal first, bundle_at(@start - 1.hour)
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "the end of a window belongs to the next window" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    first = bundle_at(@start)
+    second = bundle_at(first.ends_at)
+
+    assert_not_equal first, second
+    assert_equal first.ends_at, second.starts_at
+  end
+
+  test "frequency changes do not resize or overlap an existing window" do
+    @user.settings.update!(bundle_email_frequency: :weekly)
+    first = bundle_at(@start)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    assert_equal first, bundle_at(@start + 1.day)
+    second = bundle_at(first.ends_at)
+    assert_equal first.ends_at, second.starts_at
+    assert_equal 4.hours, second.ends_at - second.starts_at
+  end
+
+  test "different recipients have independent windows" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    first = bundle_at(@start)
+    other = notifications(:logo_mentioned_david)
+    other.user.settings.update!(bundle_email_frequency: :weekly)
+    other.update_columns(updated_at: @start + 1.hour)
+    second = Notification::Bundle.add(other)
+
+    assert_not_equal first, second
+    assert_equal other.user, second.user
+    assert_equal @start + 1.hour, second.starts_at
+    assert_equal second.starts_at + 1.week, second.ends_at
+  end
+
+  test "multiple notifications schedule only one delivery at the end of the window" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    assert_enqueued_with(job: Notification::Bundle::DeliverJob, at: @start + 1.day) do
+      bundle_at(@start)
+    end
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+      @notification = notifications(:layout_commented_kevin)
+      bundle_at(@start + 1.hour)
+    end
+
+    assert_equal 2, @user.notification_bundles.sole.entries.count
+  end
+
+  test "delivery sends one email for all unread entries and is idempotent" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    bundle = bundle_at(@start)
+    @notification = notifications(:layout_commented_kevin)
+    bundle_at(@start + 1.hour)
+
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      bundle.deliver
+    end
+    travel_to bundle.ends_at do
+      assert_difference "ActionMailer::Base.deliveries.size", 1 do
+        Notification::Bundle::DeliverJob.perform_now(bundle)
+        Notification::Bundle::DeliverJob.perform_now(bundle)
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    bundle.entries.each do |entry|
+      assert_includes email.text_part.body.decoded, entry.payload.fetch("title")
+      assert_includes email.text_part.body.decoded, entry.payload.fetch("url")
+    end
+    assert bundle.reload.processed_at
+  end
+
+  test "read and deleted notifications are omitted" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    bundle = bundle_at(@start)
+    @notification.read
+    @notification = notifications(:layout_commented_kevin)
+    bundle_at(@start + 1.hour)
+    @notification.destroy!
+
+    travel_to bundle.ends_at do
+      assert_no_difference "ActionMailer::Base.deliveries.size" do
+        bundle.deliver
+      end
+    end
+    assert bundle.reload.processed_at
+  end
+
+  test "turning emails off suppresses an already scheduled digest" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    bundle = bundle_at(@start)
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    travel_to bundle.ends_at do
+      assert_no_difference "ActionMailer::Base.deliveries.size" do
+        bundle.deliver
+      end
+    end
+    assert bundle.reload.processed_at
+  end
+
+  test "a deactivated user does not receive a pending digest" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    bundle = bundle_at(@start)
+    @user.deactivate
+
+    travel_to bundle.ends_at do
+      assert_no_difference "ActionMailer::Base.deliveries.size" do
+        bundle.deliver
+      end
+    end
+  end
+
+  test "late notifications after delivery cannot overlap the processed window" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    first = bundle_at(@start)
+    travel_to first.ends_at do
+      first.deliver
+      second = bundle_at(@start - 1.hour)
+
+      assert_not_equal first, second
+      assert_equal first.ends_at, second.starts_at
+      assert_equal first.starts_at, first.reload.starts_at
+    end
+  end
+
+  test "later activity does not rewrite a previous window's message" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    first = bundle_at(@start)
+    original_payload = first.entries.sole.payload
+
+    travel_to first.ends_at do
+      @notification.update!(source: events(:logo_published))
+    end
+
+    assert_equal 2, @user.notification_bundles.count
+    assert_equal original_payload, first.entries.reload.sole.payload
+    assert_not_equal original_payload, @user.notification_bundles.order(:starts_at).last.entries.sole.payload
+  end
+
+  test "failed delivery leaves the bundle pending for retry" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    bundle = bundle_at(@start)
+    delivery = mock("delivery")
+    NotificationMailer.expects(:bundle).with(bundle).returns(delivery)
+    delivery.expects(:deliver_now).raises(IOError)
+
+    travel_to bundle.ends_at do
+      assert_raises(IOError) { bundle.deliver }
+    end
+    assert_nil bundle.reload.processed_at
+  end
+
+  test "repeated arrivals for the same card only produce one entry per window" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    first = bundle_at(@start)
+    bundle_at(@start + 1.hour)
+
+    assert_equal 1, first.entries.count
+  end
+
+  test "cancelled accounts do not open windows" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    @user.account.cancel(initiated_by: @user)
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_nil bundle_at(@start)
+    end
+  end
+
+  private
+
+
+    def bundle_at(time)
+      @notification.update_columns(updated_at: time)
+      Notification::Bundle.add(@notification)
+    end
+end
