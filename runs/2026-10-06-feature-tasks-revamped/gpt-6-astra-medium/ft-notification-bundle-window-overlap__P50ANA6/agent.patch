+require "test_helper"
+
+class Notification::BundleableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "new notifications open a window" do
+    notifications(:layout_commented_kevin).destroy!
+    travel_to Time.current.change(usec: 0) do
+      notification = @user.notifications.create!(source: events(:layout_published), creator: users(:david))
+
+      assert_equal notification.updated_at, @user.notification_bundles.sole.starts_at
+      assert_equal notification, @user.notification_bundles.sole.entries.sole.notification
+    end
+  end
+
+  test "source changes are bundled but read state changes are not" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_difference "Notification::Bundle.count", 1 do
+      notification.update!(source: events(:logo_published))
+    end
+    assert_no_difference "Notification::Bundle::Entry.count" do
+      notification.read
+      notification.unread
+    end
+  end
+end
