diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..c06e5e1
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,56 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :entries, dependent: :destroy
+
+  scope :pending, -> { where(processed_at: nil) }
+
+  after_create_commit :deliver_later
+
+  def self.add(notification)
+    user = notification.user
+
+    # Lock the recipient, not the window: there may not be a window to lock yet.
+    # All window creation and delivery for this person uses this same lock.
+    user.with_lock do
+      if user.active? && user.account.active? && user.identity && !notification.creator.system? &&
+          (interval = user.settings&.reload&.bundle_email_interval)
+        time = notification.updated_at
+        bundles = user.notification_bundles
+
+        # Delayed notifications can predate the start of an already-open window.
+        bundle = bundles.pending.where("ends_at > ?", time).order(:ends_at).first
+        unless bundle
+          # A processed window cannot be reopened, even for a backdated arrival.
+          starts_at = [ time, bundles.maximum(:ends_at) ].compact.max
+          bundle = bundles.create!(starts_at: starts_at, ends_at: starts_at + interval)
+        end
+
+        entry = bundle.entries.find_or_initialize_by(notification: notification)
+        entry.update!(payload: notification.payload.to_h)
+        bundle
+      end
+    end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver
+    user.with_lock do
+      reload
+      if processed_at.nil? && ends_at <= Time.current
+        if user.active? && account.active? && user.identity &&
+            user.settings&.reload&.bundle_email_interval && unread_entries.exists?
+          NotificationMailer.bundle(self).deliver_now
+        end
+        update!(processed_at: Time.current)
+      end
+    end
+  end
+
+  def unread_entries
+    entries.joins(:notification).merge(Notification.unread)
+  end
+end
