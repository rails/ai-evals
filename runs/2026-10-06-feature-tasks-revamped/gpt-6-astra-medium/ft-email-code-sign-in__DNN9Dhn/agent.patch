+require "test_helper"
+
+class EmailCodeMailerTest < ActionMailer::TestCase
+  test "includes the code in the subject and both message parts" do
+    email = EmailCodeMailer.sign_in(email_address: "person@example.com", code: "AB12CD")
+
+    assert_equal [ "person@example.com" ], email.to
+    assert_match "AB12CD", email.subject
+    assert_match "AB12CD", email.html_part.body.to_s
+    assert_match "AB12CD", email.text_part.body.to_s
+    assert_match "15 minutes", email.html_part.body.to_s
+    assert_match "15 minutes", email.text_part.body.to_s
+  end
+end
