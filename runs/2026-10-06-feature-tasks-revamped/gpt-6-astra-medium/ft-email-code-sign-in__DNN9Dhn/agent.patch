diff --git a/test/integration/email_authentication_test.rb b/test/integration/email_authentication_test.rb
new file mode 100644
index 0000000..db0e5a1
--- /dev/null
+++ b/test/integration/email_authentication_test.rb
@@ -0,0 +1,291 @@
+require "test_helper"
+
+class EmailAuthenticationTest < ActionDispatch::IntegrationTest
+  test "sign in with an emailed code" do
+    untenanted do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs do
+          post session_path, params: { email_address: identities(:kevin).email_address }
+        end
+      end
+
+      assert_redirected_to new_session_email_code_path
+      follow_redirect!
+      assert_select "input[name=code][autocomplete=one-time-code]"
+
+      email = ActionMailer::Base.deliveries.last
+      code = email.subject[/\b[A-Z0-9]{6}\b/]
+      assert code, "The six-character code should appear in the subject"
+      assert_equal [ identities(:kevin).email_address ], email.to
+
+      assert_difference -> { Session.count }, 1 do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+  test "sign up verifies email before creating an account" do
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        assert_no_difference -> { Account.count } do
+          request_code signup_path, signup: { email_address: "new@example.com" }
+        end
+      end
+      assert_not cookies[:session_token].present?
+
+      post session_email_code_path, params: { code: delivered_code }
+      assert_redirected_to new_signup_completion_url
+      follow_redirect!
+      assert_response :success
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+      user = Identity.find_by!(email_address: "new@example.com").users.sole
+      assert_equal "New Person", user.name
+      assert user.owner?
+      assert_redirected_to landing_url(script_name: user.account.slug)
+    end
+  end
+
+  test "sign up with an existing identity does not duplicate it" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        request_code signup_path, signup: { email_address: identities(:kevin).email_address }
+      end
+      post session_email_code_path, params: { code: delivered_code }
+      assert_redirected_to new_signup_completion_url
+    end
+  end
+
+  test "join verifies email before redeeming the invitation and completes onboarding" do
+    join_code = account_join_codes(:"37s")
+    usage_count = join_code.usage_count
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_no_difference -> { User.count } do
+        request_code join_path(code: join_code.code), email_address: "joiner@example.com"
+      end
+    end
+    assert_equal usage_count, join_code.reload.usage_count
+    assert_redirected_to new_session_email_code_url(script_name: nil)
+
+    untenanted do
+      follow_redirect!
+      assert_response :success
+      assert_difference -> { User.count }, 1 do
+        post session_email_code_path, params: { code: delivered_code }
+      end
+    end
+
+    assert_equal usage_count + 1, join_code.reload.usage_count
+    assert_redirected_to new_users_verification_url(script_name: join_code.account.slug)
+    follow_redirect!
+    assert_response :success
+    post users_verifications_path
+    assert_redirected_to new_users_join_path
+    post users_joins_path, params: { user: { name: "New Member" } }
+    assert_redirected_to landing_path
+    user = Identity.find_by!(email_address: "joiner@example.com").users.sole
+    assert_equal join_code.account, user.account
+    assert user.verified?
+    assert user.setup?
+  end
+
+  test "joining as an existing member does not consume another invitation use" do
+    join_code = account_join_codes(:"37s")
+    request_code join_path(code: join_code.code), email_address: identities(:jz).email_address
+
+    untenanted do
+      assert_no_difference [ -> { User.count }, -> { join_code.reload.usage_count } ] do
+        post session_email_code_path, params: { code: delivered_code }
+      end
+      assert_redirected_to landing_url(script_name: join_code.account.slug)
+    end
+  end
+
+  test "joining can switch to the identity whose email was verified" do
+    sign_in_as :kevin
+    join_code = account_join_codes(:"37s")
+    request_code join_path(code: join_code.code), email_address: identities(:mike).email_address
+
+    untenanted do
+      post session_email_code_path, params: { code: delivered_code }
+      assert_equal identities(:mike), Session.find_signed!(parsed_cookies.signed[:session_token]).identity
+    end
+  end
+
+  test "an invitation exhausted while verifying cannot be redeemed" do
+    join_code = account_join_codes(:"37s")
+    request_code join_path(code: join_code.code), email_address: "joiner@example.com"
+    join_code.update!(usage_count: join_code.usage_limit)
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        post session_email_code_path, params: { code: delivered_code }
+      end
+      assert_redirected_to session_menu_url
+      assert_match /no longer available/, flash[:alert]
+    end
+  end
+
+  test "a reset invitation cannot be redeemed with a pending email code" do
+    join_code = account_join_codes(:"37s")
+    request_code join_path(code: join_code.code), email_address: "joiner@example.com"
+    join_code.reset
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        post session_email_code_path, params: { code: delivered_code }
+      end
+      assert_redirected_to session_menu_url
+    end
+  end
+
+  test "incorrect codes can be corrected and successful codes cannot be replayed" do
+    untenanted do
+      request_code session_path, email_address: identities(:kevin).email_address
+      code = delivered_code
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "WRONG!" }
+      end
+      assert_response :unprocessable_entity
+      assert_select "input[name=code]"
+
+      post session_email_code_path, params: { code: " #{code.downcase} " }
+      assert_redirected_to landing_url
+      delete session_path
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "expired codes do not sign in" do
+    freeze_time
+    untenanted do
+      request_code session_path, email_address: identities(:kevin).email_address
+      code = delivered_code
+
+      travel 15.minutes do
+        assert_no_difference -> { Session.count } do
+          post session_email_code_path, params: { code: code }
+        end
+        assert_response :unprocessable_entity
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "requesting a new code replaces the pending code" do
+    untenanted do
+      request_code session_path, email_address: identities(:kevin).email_address
+      old_record = EmailCode.last
+      request_code session_path, email_address: identities(:kevin).email_address
+      assert_not EmailCode.exists?(old_record.id)
+
+      post session_email_code_path, params: { code: delivered_code }
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "code verification requires the browser that requested it" do
+    untenanted do
+      request_code session_path, email_address: identities(:kevin).email_address
+      code = delivered_code
+      another_browser = open_session
+
+      assert_no_difference -> { Session.count } do
+        another_browser.post session_email_code_path, params: { code: code }
+      end
+      another_browser.assert_redirected_to new_session_path
+
+      post session_email_code_path, params: { code: code }
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "unknown email addresses do not create identities or reveal account existence" do
+    untenanted do
+      assert_no_difference [ -> { Identity.count }, -> { EmailCode.count } ] do
+        post session_path, params: { email_address: "unknown@example.com" }
+      end
+      assert_redirected_to new_session_email_code_path
+      follow_redirect!
+      assert_response :success
+
+      post session_email_code_path, params: { code: "ABC123" }
+      assert_response :unprocessable_entity
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "sign in normalizes the email address" do
+    untenanted do
+      request_code session_path, email_address: " #{identities(:kevin).email_address.upcase} "
+      post session_email_code_path, params: { code: delivered_code }
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "invalid email addresses do not create codes" do
+    untenanted do
+      assert_no_difference -> { EmailCode.count } do
+        post session_path, params: { email_address: "not-an-email" }
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "code entry without a pending request starts over" do
+    untenanted do
+      get new_session_email_code_path
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "verification is rate limited" do
+    untenanted do
+      request_code session_path, email_address: identities(:kevin).email_address
+      Rails.cache.stubs(:increment).returns(11)
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: delivered_code }
+      end
+      assert_redirected_to new_session_email_code_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+
+  test "sign in via JSON" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:kevin).email_address }, as: :json
+      end
+      assert_response :created
+      code = delivered_code
+
+      post session_email_code_path, params: { code: "WRONG!" }, as: :json
+      assert_response :unauthorized
+
+      post session_email_code_path, params: { code: code }, as: :json
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  private
+    def request_code(path, **params)
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs { post path, params: params }
+      end
+    end
+
+    def delivered_code
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
