@@ -0,0 +1,39 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  setup do
+    @email_code = identities(:kevin).email_codes.create!
+    @code = @email_code.code
+  end
+
+  test "generates six characters and stores only a digest" do
+    assert_match /\A[A-Z0-9]{6}\z/, @code
+    assert_not_equal @code, @email_code.code_digest
+    assert_nil EmailCode.find(@email_code.id).code
+  end
+
+  test "valid just before fifteen minutes" do
+    travel_to @email_code.created_at + 15.minutes - 1.second do
+      assert_equal identities(:kevin), @email_code.consume(@code)
+    end
+  end
+
+  test "expired at fifteen minutes" do
+    travel_to @email_code.expires_at, with_usec: true do
+      assert_nil @email_code.consume(@code)
+    end
+  end
+
+  test "incorrect codes do not consume the code" do
+    assert_nil @email_code.consume("WRONG!")
+    assert_nil @email_code.consume(nil)
+    assert_equal identities(:kevin), @email_code.consume(@code.downcase)
+  end
+
+  test "a code can only be consumed once" do
+    second_copy = EmailCode.find(@email_code.id)
+    assert_equal identities(:kevin), @email_code.consume(@code)
+    assert_not EmailCode.exists?(@email_code.id)
+    assert_nil second_copy.consume(@code)
+  end
+end
