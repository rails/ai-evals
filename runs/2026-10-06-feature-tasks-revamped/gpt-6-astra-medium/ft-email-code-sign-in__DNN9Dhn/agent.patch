diff --git a/app/controllers/sessions/email_codes_controller.rb b/app/controllers/sessions/email_codes_controller.rb
new file mode 100644
index 0000000..f4d12ff
--- /dev/null
+++ b/app/controllers/sessions/email_codes_controller.rb
@@ -0,0 +1,68 @@
+class Sessions::EmailCodesController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+  rate_limit to: 10, within: EmailCode::EXPIRATION, only: :create,
+    by: -> { session.dig(:pending_email_authentication, "email_code_id") || request.remote_ip },
+    name: "email_code", with: :rate_limit_exceeded
+  before_action :require_pending_authentication
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    email_code = EmailCode.find_by(id: @pending_authentication["email_code_id"])
+
+    if identity = email_code&.consume(params.expect(:code))
+      session.delete(:pending_email_authentication)
+      start_new_session_for identity
+
+      if @pending_authentication["join_code"].present?
+        complete_join(identity)
+      else
+        respond_to do |format|
+          format.html { redirect_to @pending_authentication["return_to"] || after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      end
+    else
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = "That code didn't work or has expired. Try again or request a new code."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: "That code didn't work or has expired." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def require_pending_authentication
+      @pending_authentication = session[:pending_email_authentication]
+      redirect_to new_session_path unless @pending_authentication
+    end
+
+    def complete_join(identity)
+      join_code = Account::JoinCode.find_by(
+        code: @pending_authentication["join_code"], account_id: @pending_authentication["account_id"])
+
+      if user = join_code&.redeem_for(identity)
+        if user.setup?
+          redirect_to landing_url(script_name: join_code.account.slug)
+        else
+          redirect_to new_users_verification_url(script_name: join_code.account.slug)
+        end
+      else
+        redirect_to session_menu_url, alert: "That join code is no longer available. Ask for a new invitation."
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path, alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
