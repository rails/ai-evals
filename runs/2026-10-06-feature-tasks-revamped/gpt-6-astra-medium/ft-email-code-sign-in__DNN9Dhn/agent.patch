diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..d5150df
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,26 @@
+class EmailCode < ApplicationRecord
+  EXPIRATION = 15.minutes
+
+  belongs_to :identity
+
+  has_secure_password :code, validations: false
+
+  before_create :generate_code
+
+  def consume(code)
+    with_lock do
+      if expires_at > Time.current && authenticate_code(code.to_s.strip.upcase)
+        destroy!
+        identity
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    nil
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(6).upcase
+      self.expires_at = EXPIRATION.from_now
+    end
+end
