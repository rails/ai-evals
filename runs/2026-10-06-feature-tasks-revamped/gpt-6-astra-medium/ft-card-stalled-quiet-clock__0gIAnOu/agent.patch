diff --git a/test/controllers/cards/stalled_test.rb b/test/controllers/cards/stalled_test.rb
new file mode 100644
index 0000000..e252d24
--- /dev/null
+++ b/test/controllers/cards/stalled_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Cards::StalledTest < ActionDispatch::IntegrationTest
+  setup do
+    freeze_time
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @card.update!(last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+  end
+
+  test "stalled index returns only accessible stalled cards" do
+    cards(:radio).update!(last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_equal [ @card.number ], response.parsed_body.pluck("number")
+    assert response.parsed_body.first["stalled"]
+
+    @card.touch_last_active_at
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_empty response.parsed_body
+  end
+
+  test "stalled index composes with board filters" do
+    get cards_path(format: :json), params: { indexed_by: "stalled", board_ids: [ boards(:writebook).id ] }
+    assert_response :success
+    assert_equal [ @card.number ], response.parsed_body.pluck("number")
+
+    get cards_path(format: :json), params: { indexed_by: "stalled", board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_empty response.parsed_body
+  end
+
+  test "stalled cards are marked on the index and card detail" do
+    get cards_path, params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled", count: 1
+
+    get card_path(@card)
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled", count: 1
+  end
+
+  test "stalled status appears on public cards and previews" do
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_card_path(board.publication.key, @card)
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled", count: 1
+
+    get public_board_column_path(board.publication.key, @card.column)
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled", count: 1
+  end
+
+  test "cached previews become stalled without a card update" do
+    @card.update!(last_active_at: 2.weeks.ago + 1.second)
+
+    with_actionview_partial_caching do
+      get cards_path
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+
+      travel 1.second
+      get cards_path
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled", count: 1
+
+      @card.touch_last_active_at
+      get cards_path
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+    end
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..9e05e78
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,193 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    Current.session = sessions(:david)
+    @card = cards(:logo)
+  end
+
+  test "an assigned card stalls after two quiet weeks and activity resets the clock" do
+    freeze_time
+    @card.toggle_assignment(users(:david))
+
+    assert_not @card.stalled?
+    travel 2.weeks - 1.second
+    assert_not @card.stalled?
+    travel 1.second
+    assert @card.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.reactions.create!(content: "👍", reacter: users(:david))
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+  end
+  test "quiet cards without a burst are not stalled" do
+    @card.update!(last_active_at: 1.month.ago)
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "three comments from two people create a burst" do
+    fresh_card
+    comment_by(:david)
+    comment_by(:jz)
+    assert_nil @card.reload.last_burst_at
+
+    comment_by(:david)
+    assert_not_nil @card.reload.last_burst_at
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "comments by one person and system comments do not create a burst" do
+    fresh_card
+    3.times { comment_by(:david) }
+    @card.comments.create!(creator: @card.account.system_user, body: "System update")
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comment window is one third of the board period and includes its boundary" do
+    freeze_time
+    fresh_card
+    @card.board.auto_postpone_period = 3.days
+    comment_by(:david)
+    travel 1.day
+    comment_by(:jz)
+    comment_by(:david)
+    assert_not_nil @card.reload.last_burst_at
+  end
+
+  test "comments outside the board window do not count" do
+    fresh_card
+    @card.board.auto_postpone_period = 3.days
+    comment_by(:david)
+    travel 1.day + 1.second
+    comment_by(:jz)
+    comment_by(:david)
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comment window falls back to the account period" do
+    fresh_card
+    @card.board.entropy.destroy!
+    @card.board.reload
+    @card.account.entropy.update!(auto_postpone_period: 90.days)
+    comment_by(:david)
+    travel 20.days
+    comment_by(:jz)
+    comment_by(:david)
+    assert_not_nil @card.reload.last_burst_at
+  end
+
+  test "reopening creates a burst" do
+    @card.close
+    assert_nil @card.last_burst_at
+    @card.reopen
+    assert_not_nil @card.reload.last_burst_at
+    travel 2.weeks
+    assert @card.stalled?
+  end
+
+  test "unassignment does not create a burst" do
+    @card.toggle_assignment(users(:jz))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "closed postponed and drafted cards are not stalled" do
+    @card.close
+    @card.update!(last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.postpone
+    @card.update!(last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.resume
+    @card.update!(status: :drafted, last_active_at: 2.weeks.ago)
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "card content edits reset stalled status" do
+    [ { title: "New title" }, { description: "Updated description" } ].each do |attributes|
+      make_stalled
+      @card.update!(attributes)
+      assert_not @card.reload.stalled?, attributes.inspect
+    end
+  end
+
+  test "comments and reactions on comments reset stalled status" do
+    make_stalled
+    comment = comment_by(:david)
+    assert_not @card.reload.stalled?
+
+    make_stalled
+    comment.update!(body: "An edit")
+    assert_not @card.reload.stalled?
+
+    make_stalled
