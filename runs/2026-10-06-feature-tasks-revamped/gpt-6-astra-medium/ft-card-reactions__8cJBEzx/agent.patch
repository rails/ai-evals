+require "test_helper"
+
+class Cards::ReactionsTest < ActionView::TestCase
+  test "previews show only nonzero card boost counts" do
+    card = cards(:logo)
+    comments(:logo_1).reactions.create!(content: "Nice!", reacter: users(:david))
+
+    render "cards/display/preview/reactions", card: card
+    assert_select ".card__reactions", count: 0
+
+    card.reactions.create!(content: "👍", reacter: users(:david))
+    card.reactions.create!(content: "Nice!", reacter: users(:kevin))
+
+    render "cards/display/preview/reactions", card: card.reload
+    assert_select ".card__reactions[aria-label='2 boosts']", text: /2/
+  end
+end
