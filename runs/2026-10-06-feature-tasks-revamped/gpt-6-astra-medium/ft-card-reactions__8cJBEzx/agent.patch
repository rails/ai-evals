diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..1a24189
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+  end
+
+  test "create" do
+    assert_difference -> { Reaction.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+
+    assert_equal @card, Reaction.last.reactable
+    assert_equal users(:david), Reaction.last.reacter
+    assert_equal @card.account, Reaction.last.account
+  end
+
+  test "card detail offers reactions" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@card, :reacting)}" do
+      assert_select "a[href=?]", new_card_reaction_path(@card)
+    end
+  end
+
+  test "index and new" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+    get card_reactions_path(@card)
+    assert_response :success
+    assert_select "form[action=?]", card_reaction_path(@card, reaction)
+
+    get new_card_reaction_path(@card)
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@card, :new_reaction)}" do
+      assert_select "form[action=?]", card_reactions_path(@card) do
+        assert_select "input[name='reaction[content]'][maxlength='16']"
+      end
+      assert_select "a[href=?]", card_reactions_path(@card), text: /Cancel/
+    end
+  end
+
+  test "index as JSON includes only card reactions in order" do
+    first = @card.reactions.create!(content: "👍", reacter: users(:david), created_at: 1.day.ago)
+    second = @card.reactions.create!(content: "Nice!", reacter: users(:kevin))
+    @card.comments.first.reactions.create!(content: "Comment boost", reacter: users(:david))
+
+    get card_reactions_path(@card), as: :json
+    assert_response :success
+    assert_equal [ first.id, second.id ], response.parsed_body.pluck("id")
+    assert_equal card_reaction_url(@card, first), response.parsed_body.first["url"]
+  end
+
+  test "create as JSON ignores supplied ownership and target" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: {
+        content: "👍", reacter_id: users(:kevin).id, account_id: accounts(:initech).id,
+        reactable_type: "Comment", reactable_id: comments(:logo_1).id
+      } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", response.parsed_body["content"]
+    assert_equal users(:david), @card.reactions.last.reacter
+    assert_equal @card.account, @card.reactions.last.account
+    assert_equal card_reaction_url(@card, @card.reactions.last), response.parsed_body["url"]
+  end
+
+  test "destroy" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction), as: :turbo_stream
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "destroy as JSON" do
+    reaction = @card.reactions.create!(content: "Nice!", reacter: users(:david))
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction), as: :json
+      assert_response :no_content
+    end
+  end
+
+  test "non-owner cannot destroy reaction" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_reaction_path(@card, reaction), as: :turbo_stream
+      assert_response :forbidden
+    end
+  end
+
+  test "cannot destroy a reaction on another card or a comment" do
+    reactions = [
+      cards(:layout).reactions.create!(content: "👍", reacter: users(:david)),
+      comments(:logo_1).reactions.create!(content: "👍", reacter: users(:david))
+    ]
+
+    reactions.each do |reaction|
+      assert_no_difference -> { Reaction.count } do
+        delete card_reaction_path(@card, reaction), as: :json
+        assert_response :not_found
+      end
+    end
+  end
+
+  test "cannot react to an inaccessible card" do
+    @card.update_columns(board_id: boards(:private).id)
+
+    assert_no_difference -> { Reaction.count } do
+      get card_reactions_path(@card)
+      assert_response :not_found
+      get new_card_reaction_path(@card)
+      assert_response :not_found
+      post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+      assert_response :not_found
+    end
+  end
+end
