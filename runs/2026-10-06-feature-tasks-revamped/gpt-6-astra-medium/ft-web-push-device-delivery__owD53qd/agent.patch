--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @user = users(:kevin)
+    @subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.com/phone", p256dh_key: "public", auth_key: "auth")
+  end
+
+  test "new tray notifications enqueue a push for every device of the recipient" do
+    @user.push_subscriptions.create!(endpoint: "https://push.example.com/desktop", p256dh_key: "public", auth_key: "auth")
+    users(:david).push_subscriptions.create!(endpoint: "https://push.example.com/other-user", p256dh_key: "public", auth_key: "auth")
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_jobs 2, only: PushSubscription::DeliveryJob do
+      notification = Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+      assert_enqueued_with(job: PushSubscription::DeliveryJob, args: [ @subscription, notification, notification.push_payload ])
+    end
+  end
+
+  test "updating the source of an existing tray entry enqueues another push" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_jobs 1, only: PushSubscription::DeliveryJob do
+      notification.update!(source: events(:logo_assignment_jz), unread_count: notification.unread_count + 1)
+    end
+  end
+
+  test "reading and unreading do not push" do
+    assert_no_enqueued_jobs only: PushSubscription::DeliveryJob do
+      notification = notifications(:logo_assignment_kevin)
+      notification.read
+      notification.unread
+      notification.touch
+    end
+  end
+
+  test "event payload matches the tray and links to the card in its account" do
+    notification = notifications(:logo_assignment_kevin)
+    payload = JSON.parse(notification.push_payload)
+
+    assert_equal ApplicationController.helpers.event_notification_title(notification.source), payload["title"]
+    assert_equal ApplicationController.helpers.event_notification_body(notification.source), payload["body"]
+    assert_equal Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug), payload.dig("data", "url")
+    assert_equal "notification_#{notification.id}", payload["tag"]
+  end
+
+  test "comments use the same text and title as the tray" do
+    notification = notifications(:layout_commented_kevin)
+    payload = JSON.parse(notification.push_payload)
+
+    assert_equal ApplicationController.helpers.event_notification_title(notification.source), payload["title"]
+    assert_equal ApplicationController.helpers.event_notification_body(notification.source), payload["body"]
+  end
+
+  test "mention payload matches the tray" do
+    notification = notifications(:logo_mentioned_david)
+    mention = notification.source
+    payload = JSON.parse(notification.push_payload)
+
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", payload["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), payload["body"]
+  end
+
+  test "no push jobs without VAPID configuration" do
+    PushSubscription.stubs(:configured?).returns(false)
+
+    assert_no_enqueued_jobs only: PushSubscription::DeliveryJob do
+      notifications(:logo_assignment_kevin).push_later
+    end
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..018540e
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @original_vapid_keys = ENV.to_h.slice("VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY")
+    ENV["VAPID_PUBLIC_KEY"] = "vapid-public"
+    ENV["VAPID_PRIVATE_KEY"] = "vapid-private"
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @notification.user.push_subscriptions.create!(endpoint: "https://push.example.com/device", p256dh_key: "device-public", auth_key: "device-auth")
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+    ENV.update(@original_vapid_keys)
+  end
+
+  test "delivers with the device keys and VAPID credentials" do
+    payload = @notification.push_payload
+    WebPush.expects(:payload_send).with(
+      endpoint: @subscription.endpoint, p256dh: "device-public", auth: "device-auth", message: payload,
+      vapid: { public_key: "vapid-public", private_key: "vapid-private", subject: ENV.fetch("BASE_URL", "https://fizzy.do") },
+      open_timeout: 10, read_timeout: 10
+    )
+
+    @subscription.deliver(@notification, payload)
+  end
+
+  test "expired and invalid subscriptions are removed" do
+    [ WebPush::ExpiredSubscription, WebPush::InvalidSubscription ].each do |error_class|
+      subscription = @notification.user.push_subscriptions.create!(endpoint: "https://push.example.com/#{error_class.name.demodulize}", p256dh_key: "public", auth_key: "auth")
+      WebPush.expects(:payload_send).raises(error_class.new(stub(body: "gone"), "push.example.com"))
+
+      assert_difference "PushSubscription.count", -1 do
+        subscription.deliver(@notification, @notification.push_payload)
+      end
+    end
+  end
+
+  test "temporary errors preserve the subscription for retry" do
+    WebPush.expects(:payload_send).raises(WebPush::PushServiceError.new(stub(body: "unavailable"), "push.example.com"))
+
+    assert_no_difference "PushSubscription.count" do
+      assert_raises WebPush::PushServiceError do
+        @subscription.deliver(@notification, @notification.push_payload)
+      end
+    end
+  end
+
+  test "does not deliver after the user loses access to the card" do
+    @notification.user.accesses.where(board: @notification.card.board).delete_all
+    WebPush.expects(:payload_send).never
+    @subscription.deliver(@notification, @notification.push_payload)
+  end
+
+  test "does not deliver for inactive users or to a different recipient" do
+    WebPush.expects(:payload_send).never
+    @subscription.deliver(notifications(:logo_mentioned_david), "{}")
+    @subscription.user.update!(active: false)
+    @subscription.deliver(@notification, "{}")
+  end
+
+  test "a device can be independently registered in another account" do
+    other_user = accounts(:initech).users.create!(name: "Kevin", identity: @subscription.user.identity)
+    other_subscription = other_user.push_subscriptions.create!(@subscription.attributes.slice("endpoint", "p256dh_key", "auth_key"))
+
+    assert_equal other_user.account, other_subscription.account
+    assert_not_equal @subscription.user_id, other_subscription.user_id
+    @subscription.destroy!
+    assert other_subscription.reload
+  end
+
+  test "does not deliver for a cancelled account" do
+    @subscription.account.create_cancellation!(initiated_by: @subscription.user)
+    WebPush.expects(:payload_send).never
+    @subscription.deliver(@notification, "{}")
+  end
+
+  test "does not deliver without VAPID configuration" do
+    ENV.delete("VAPID_PRIVATE_KEY")
+    WebPush.expects(:payload_send).never
+    @subscription.deliver(@notification, "{}")
+  end
+end
