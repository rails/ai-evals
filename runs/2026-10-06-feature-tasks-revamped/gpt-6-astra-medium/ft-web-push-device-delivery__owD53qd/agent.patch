--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,33 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :ensure_current_user
+  before_action :no_store
+
+  def index
+    subscription = Current.user.push_subscriptions.find_by(endpoint: params[:endpoint])
+    render json: { id: subscription&.id }
+  end
+
+  def create
+    attributes = params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    Current.user.with_lock do
+      subscription = Current.user.push_subscriptions.find_or_initialize_by(endpoint: attributes[:endpoint])
+      subscription.assign_attributes(attributes)
+
+      if subscription.save
+        render json: { id: subscription.id }, status: :created
+      else
+        render json: { errors: subscription.errors.full_messages }, status: :unprocessable_entity
+      end
+    end
+  end
+
+  def destroy
+    Current.user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def ensure_current_user
+      head :forbidden unless Current.user.id == params[:user_id]
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..fedf862
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,114 @@
+import { Controller } from "@hotwired/stimulus"
+import { get, post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = ["button", "status", "help", "details"]
+  static values = { url: String, publicKey: String }
+
+  #registration
+  #subscriptionId
+  #busy = false
+
+  connect() {
+    this.refresh()
+  }
+
+  async refresh() {
+    if (this.#busy) return
+
+    this.#busy = true
+    this.buttonTarget.disabled = true
+
+    try {
+      if (this.#supported && this.hasPublicKeyValue) {
+        await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+        this.#registration = await navigator.serviceWorker.ready
+        const subscription = await this.#registration.pushManager.getSubscription()
+        this.#subscriptionId = null
+
+        if (subscription) {
+          const url = new URL(this.urlValue, window.location.origin)
+          url.searchParams.set("endpoint", subscription.endpoint)
+          const response = await get(url.toString(), { responseKind: "json" })
+          if (!response.ok) throw new Error("Could not check notification settings.")
+          this.#subscriptionId = (await response.json).id
+        }
+      }
+
+      this.#render()
+    } catch (error) {
+      this.statusTarget.textContent = "Could not check notification settings. Please try again."
+    } finally {
+      this.#busy = false
+    }
+  }
+
+  async toggle() {
+    if (this.#busy) return
+
+    this.#busy = true
+    this.buttonTarget.disabled = true
+
+    try {
+      if (this.#subscriptionId) {
+        const response = await destroy(`${this.urlValue}/${this.#subscriptionId}`)
+        if (!response.ok) throw new Error("Could not turn off notifications.")
+
+        // Keep the browser subscription: other accounts may still use this device.
+        this.#subscriptionId = null
+      } else {
+        // Request permission directly from the click, before any other async work.
+        const permission = await Notification.requestPermission()
+        if (permission === "granted") {
+          const subscription = await this.#registration.pushManager.getSubscription() ||
+            await this.#registration.pushManager.subscribe({
+              userVisibleOnly: true,
+              applicationServerKey: this.#applicationServerKey
+            })
+          const { endpoint, keys } = subscription.toJSON()
+          const response = await post(this.urlValue, {
+            responseKind: "json",
+            body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } }
+          })
+          if (!response.ok) throw new Error("Could not save notification settings.")
+          this.#subscriptionId = (await response.json).id
+        }
+      }
+
+      this.#render()
+    } catch (error) {
+      this.#render()
+      this.statusTarget.textContent = "Could not update notification settings. Please try again."
+    } finally {
+      this.#busy = false
+    }
+  }
+
+  get #supported() {
+    return window.isSecureContext && "Notification" in window && "PushManager" in window && "serviceWorker" in navigator
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+
+  #render() {
+    const denied = this.#supported && Notification.permission === "denied"
+    const enabled = this.#supported && Notification.permission === "granted" && !!this.#subscriptionId
+
+    this.element.classList.toggle("notifications--on", enabled)
+    this.buttonTarget.disabled = !this.#supported || !this.hasPublicKeyValue || denied
+    this.helpTarget.hidden = enabled
+
+    if (!this.hasPublicKeyValue) {
+      this.statusTarget.textContent = "Push notifications are not configured on this server."
+    } else if (!this.#supported) {
+      this.statusTarget.textContent = "This browser does not support push notifications. See the instructions below."
+    } else if (denied) {
+      this.statusTarget.textContent = "Notifications are blocked. Follow the instructions below to allow them."
+    } else {
+      this.statusTarget.textContent = enabled ? "Notifications are on for this device." : "Notifications are off for this device."
+    }
+  }
+}
