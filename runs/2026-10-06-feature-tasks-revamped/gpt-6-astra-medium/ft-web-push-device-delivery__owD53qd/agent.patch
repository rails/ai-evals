@@ -0,0 +1,39 @@
+require "test_helper"
+
+class PushSubscription::DeliveryJobTest < ActiveJob::TestCase
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @notification.user.push_subscriptions.create!(endpoint: "https://push.example.com/device", p256dh_key: "public", auth_key: "auth")
+  end
+
+  test "delegates delivery with the captured payload" do
+    payload = @notification.push_payload
+    @subscription.expects(:deliver).with(@notification, payload)
+    PushSubscription::DeliveryJob.perform_now(@subscription, @notification, payload)
+  end
+
+  test "retries temporary push service failures" do
+    @subscription.expects(:deliver).raises(WebPush::TooManyRequests.new(stub(body: "try later"), "push.example.com"))
+
+    assert_enqueued_with job: PushSubscription::DeliveryJob do
+      PushSubscription::DeliveryJob.perform_now(@subscription, @notification, "{}")
+    end
+    assert @subscription.reload
+  end
+
+  test "discards jobs for deleted subscriptions" do
+    PushSubscription::DeliveryJob.perform_later(@subscription, @notification, "{}")
+    @subscription.destroy!
+    WebPush.expects(:payload_send).never
+
+    assert_nothing_raised { perform_enqueued_jobs only: PushSubscription::DeliveryJob }
+  end
+
+  test "discards jobs for removed tray entries" do
+    PushSubscription::DeliveryJob.perform_later(@subscription, @notification, "{}")
+    @notification.destroy!
+    WebPush.expects(:payload_send).never
+
+    assert_nothing_raised { perform_enqueued_jobs only: PushSubscription::DeliveryJob }
+  end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
