+require "test_helper"
+require "selenium-webdriver"
+
+class PushNotificationsJavaScriptTest < ActiveSupport::TestCase
+  test "device settings and service worker behavior" do
+    options = Selenium::WebDriver::Chrome::Options.new
+    options.add_argument("--headless")
+    options.add_argument("--no-sandbox") if Process.uid.zero?
+    options.add_argument("--disable-dev-shm-usage")
+    browser = Selenium::WebDriver.for(:chrome, options: options)
+    browser.manage.timeouts.script_timeout = 20
+
+    controller = Rails.root.join("app/javascript/controllers/notifications_controller.js").read
+      .gsub(/^import .*\n/, "").sub("export default class", "return class")
+    worker = Rails.root.join("app/views/pwa/service_worker.js.erb").read.gsub(/<%.*?%>/m, "")
+    tests = Rails.root.join("test/javascript/push_notifications_test.js").read
+
+    results = browser.execute_async_script(tests, controller, worker)
+    assert_not_empty results
+    results.each { |result| assert result["passed"], "#{result['name']}: #{result['error']}" }
+  ensure
+    browser&.quit
+  end
+end
