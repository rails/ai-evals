@@ -0,0 +1,23 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: -> { source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def push_later
+    if PushSubscription.configured?
+      payload = nil
+      user.push_subscriptions.find_each do |subscription|
+        payload ||= push_payload
+        PushSubscription::DeliveryJob.perform_later(subscription, self, payload)
+      end
+    end
+  end
+
+  def push_payload
+    ApplicationController.renderer.new(script_name: account.slug).render(
+      template: "notifications/push", formats: [ :json ], locals: { notification: self }
+    )
+  end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..3103cc7
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,42 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, length: { maximum: 512 }, uniqueness: { scope: :user_id }
+  validate :endpoint_is_https
+
+  def self.configured?
+    ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+  end
+
+  def deliver(notification, payload)
+    if self.class.configured? && deliverable?(notification)
+      WebPush.payload_send(
+        endpoint: endpoint, p256dh: p256dh_key, auth: auth_key, message: payload,
+        vapid: {
+          public_key: ENV.fetch("VAPID_PUBLIC_KEY"),
+          private_key: ENV.fetch("VAPID_PRIVATE_KEY"),
+          subject: ENV.fetch("BASE_URL", "https://fizzy.do")
+        },
+        open_timeout: 10, read_timeout: 10
+      )
+    end
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription
+    destroy!
+  end
+
+  private
+    def deliverable?(notification)
+      user_id == notification.user_id && user.active? && account.active? && user.accessible_cards.exists?(notification.card_id)
+    end
+
+    def endpoint_is_https
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil? && uri.fragment.nil?
+        errors.add :endpoint, "must be an HTTPS URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "must be an HTTPS URL"
+    end
+end
