diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..7c47ec0 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,68 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    with_lock do
+      if self.class.due_for_incineration.exists?(id)
+        Current.with_account(self) do
+          incinerate_filters
+          incinerate_search_records
+          incinerate_storage_totals
+          incinerate_account_records
+          delete
+        end
+      end
+    end
+  end
+
+  private
+    def incinerate_filters
+      filters = Filter.where(account_id: id)
+
+      # These join tables have no account_id, including the legacy assigners join.
+      self.class.with_connection do |connection|
+        %w[assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags].each do |table|
+          connection.delete "DELETE FROM #{connection.quote_table_name(table)} WHERE filter_id IN (#{filters.select(:id).to_sql})"
+        end
+      end
+
+      filters.delete_all
+    end
+
+    def incinerate_search_records
+      # Use the account's shard on MySQL and remove the FTS entries on SQLite.
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy!)
+    end
+
+    def incinerate_storage_totals
+      ::Storage::Total.where(owner: self).or(::Storage::Total.where(owner: boards)).delete_all
+    end
+
+    def incinerate_account_records
+      # Skip callbacks: they can enqueue jobs or recreate data for the deleted account.
+      # Identities and their authentication records are shared across accounts and stay intact.
+      [
+        ActiveStorage::Attachment, ActiveStorage::VariantRecord, ActiveStorage::Blob, ActionText::RichText,
+        Access, Account::Cancellation, Account::Import, Account::JoinCode,
+        Assignment, Board::Publication, Card::ActivitySpike, Card::Goldness, Card::NotNow,
+        Closure, Column, Comment, Entropy, Event, Export, Mention,
+        Notification, Notification::Bundle, Pin, Push::Subscription, Reaction, Search::Query,
+        Step, ::Storage::Entry, Tagging, Tag, User::Settings, Watch,
+        Webhook::DelinquencyTracker, Webhook::Delivery, Webhook, Card, Board, User
+      ].each do |model|
+        model.where(account_id: id).delete_all
+      end
+    end
 end
