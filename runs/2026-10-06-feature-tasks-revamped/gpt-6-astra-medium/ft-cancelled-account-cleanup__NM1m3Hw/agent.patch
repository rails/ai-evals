diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..fba311e
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveSupport::TestCase
+  test "incinerates all account data without affecting other accounts or shared identities" do
+    account = accounts(:"37s")
+    other_account = accounts(:initech)
+    shared_user = other_account.users.create!(name: "David", identity: identities(:david))
+    filter = filters(:jz_assignments)
+    filter.board_ids = [ boards(:writebook).id ]
+    filter.assignees << users(:david)
+    filter.creators << users(:david)
+    filter.closers << users(:david)
+    filter.tags << tags(:mobile)
+    ApplicationRecord.with_connection do |connection|
+      filter_id = connection.quote(Filter.type_for_attribute("id").serialize(filter.id))
+      user_id = connection.quote(User.type_for_attribute("id").serialize(users(:david).id))
+      connection.execute "INSERT INTO assigners_filters (filter_id, assigner_id) VALUES (#{filter_id}, #{user_id})"
+    end
+
+    Current.with_account(account) do
+      cards(:logo).image.attach io: StringIO.new("image"), filename: "test.png", content_type: "image/png"
+      ActiveStorage::Blob.create_and_upload! io: StringIO.new("unattached"), filename: "unattached.txt"
+      account.materialize_storage
+      boards(:writebook).materialize_storage
+      cards(:logo).reindex
+    end
+    cards(:radio).reindex
+    other_account.materialize_storage
+    account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    other_account_data = account_data_counts(other_account)
+    storage_total_ids = Storage::Total.where(owner: account).or(Storage::Total.where(owner: account.boards)).ids
+
+    assert_no_enqueued_jobs do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+
+    assert_not Account.exists?(account.id)
+    assert Account.exists?(other_account.id)
+    assert User.exists?(shared_user.id)
+    assert Identity.exists?(identities(:david).id)
+    assert Session.exists?(sessions(:david).id)
+    assert_equal other_account_data, account_data_counts(other_account)
+    assert_not Storage::Total.exists?(id: storage_total_ids)
+    assert Storage::Total.exists?(owner: other_account)
+
+    account_data_counts(account).each do |table, count|
+      assert_equal 0, count, "Account data remains in #{table}"
+    end
+
+    Filter.reflect_on_all_associations(:has_and_belongs_to_many).each do |association|
+      assert_equal 0, rows_for(association.join_table, "filter_id", filter.id)
+    end
+
+    assert_equal 0, rows_for("assigners_filters", "filter_id", filter.id)
+
+    if Fizzy.db_adapter.sqlite?
+      assert_equal 1, Search::Record::SQLite::Fts.count
+      assert_equal cards(:radio).title, Search::Record::SQLite::Fts.first.title
+    end
+  end
+
+  test "processes multiple due accounts and can run again safely" do
+    accounts(:"37s").create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    accounts(:initech).create_cancellation!(initiated_by: users(:mike), created_at: 32.days.ago)
+
+    assert_difference "Account.count", -2 do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+
+    assert_no_difference "Account.count" do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+  end
+
+  test "leaves active and recently cancelled accounts alone" do
+    freeze_time do
+      accounts(:"37s").create_cancellation!(initiated_by: users(:david), created_at: 30.days.ago)
+      accounts(:initech).create_cancellation!(initiated_by: users(:mike), created_at: 29.days.ago)
+
+      assert_no_difference "Account.count" do
+        Current.without_account { Account::IncinerateDueJob.perform_now }
+      end
+    end
+  end
+
+  private
+    def account_data_counts(account)
+      ApplicationRecord.with_connection do |connection|
+        connection.tables.filter_map do |table|
+          if connection.columns(table).any? { |column| column.name == "account_id" }
+            [ table, rows_for(table, "account_id", account.id) ]
+          end
+        end.to_h
+      end
+    end
+
+    def rows_for(table, column, id)
+      ApplicationRecord.with_connection do |connection|
+        quoted_id = connection.quote(Account.type_for_attribute("id").serialize(id))
+        connection.select_value "SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE #{connection.quote_column_name(column)} = #{quoted_id}"
+      end
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..5a623b2
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    freeze_time
+  end
+
+  test "accounts are due only after the full grace period" do
+    cancellation = @account.create_cancellation!(initiated_by: users(:david))
+
+    [ 29.days.ago, 30.days.ago ].each do |created_at|
+      cancellation.update!(created_at: created_at)
+
+      assert_not_includes Account.due_for_incineration, @account
+      assert_no_difference "Account.count" do
+        @account.incinerate
+      end
+    end
+
+    cancellation.update!(created_at: 30.days.ago - 1.second)
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "active accounts cannot be incinerated" do
+    assert_no_difference "Account.count" do
+      @account.incinerate
+    end
+  end
+
+  test "reactivated accounts are preserved even if already selected for incineration" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    selected_account = Account.due_for_incineration.find(@account.id)
+    @account.reactivate
+
+    assert_no_difference "Account.count" do
+      selected_account.incinerate
+    end
+  end
+
+  test "cancelling again starts a new grace period" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    @account.reactivate
+    @account.cancel(initiated_by: users(:david))
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "incineration rolls back if deleting account records fails" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    cards(:logo).reindex
+    filter = filters(:jz_assignments)
+    filter.assignees << users(:david)
+    assignee_ids = filter.assignee_ids
+    search_record_count = Search::Record.for(@account.id).count
+    @account.stubs(:delete).raises(ActiveRecord::StatementInvalid)
+
+    assert_no_difference [ "Account.count", "User.count", "Card.count", "Filter.count", "Account::Cancellation.count" ] do
+      assert_raises ActiveRecord::StatementInvalid do
+        @account.incinerate
+      end
+    end
+
+    assert_equal assignee_ids, filter.reload.assignee_ids
+    assert_equal search_record_count, Search::Record.for(@account.id).count
+    if Fizzy.db_adapter.sqlite?
+      assert_equal 1, Search::Record::SQLite::Fts.count
+    end
+  end
+end
