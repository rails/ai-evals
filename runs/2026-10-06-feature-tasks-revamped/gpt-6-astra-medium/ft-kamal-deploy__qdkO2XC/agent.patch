+++ b/test/deployment/configuration_test.rb
@@ -0,0 +1,45 @@
+# Run without booting Rails or contacting a server:
+# bundle exec ruby test/deployment/configuration_test.rb
+require "minitest/autorun"
+require "kamal"
+
+class DeploymentConfigurationTest < Minitest::Test
+  def setup
+    @config = Kamal::Configuration.create_from(config_file: Pathname.new("config/deploy.yml"))
+  end
+
+  def test_single_box_with_proxy_tls
+    assert_equal [ "web" ], @config.raw_config.servers.keys.map(&:to_s)
+    assert_equal 1, @config.raw_config.servers["web"].size
+    assert_equal true, @config.raw_config.proxy["ssl"]
+    assert_equal 80, @config.raw_config.proxy["app_port"]
+    assert_equal "/up", @config.raw_config.proxy.dig("healthcheck", "path")
+    assert_empty @config.accessories
+  end
+
+  def test_local_services_and_persistent_storage
+    env = @config.raw_config.env["clear"]
+    assert_equal "false", env["SAAS"]
+    assert_equal "sqlite", env["DATABASE_ADAPTER"]
+    assert_equal "local", env["ACTIVE_STORAGE_SERVICE"]
+    assert_equal "true", env["SOLID_QUEUE_IN_PUMA"]
+    assert_equal @config.raw_config.proxy["host"], env["APP_HOST"]
+    assert_includes @config.raw_config.volumes, "fizzy_storage:/rails/storage"
+
+    databases = YAML.load_file("config/database.sqlite.yml", aliases: true)["production"]
+    assert_equal %w[ cable cache primary queue ], databases.keys.sort
+    databases.each_value { |database| assert_match %r{\Astorage/}, database["database"] }
+  end
+
+  def test_secrets_are_resolved_from_environment
+    keys = %w[ KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE SMTP_USERNAME SMTP_PASSWORD ]
+    previous = ENV.to_h.slice(*keys)
+    keys.each { |key| ENV[key] = "test-#{key}" }
+
+    keys.each { |key| assert_equal "test-#{key}", @config.secrets[key] }
+    assert_equal %w[ SECRET_KEY_BASE SMTP_PASSWORD SMTP_USERNAME ], @config.raw_config.env["secret"].sort
+    keys.each { |key| refute @config.raw_config.env["clear"].key?(key) }
+  ensure
+    keys.each { |key| ENV[key] = previous[key] }
+  end
+end
