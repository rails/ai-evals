@@ -0,0 +1,53 @@
+# Single-server, self-hosted Fizzy. See docs/deployment.md before running kamal setup.
+service: fizzy
+image: your-dockerhub-user/fizzy
+
+servers:
+  web:
+    - fizzy.example.com
+
+# Kamal Proxy terminates TLS; Thruster listens on HTTP inside the container.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  app_port: 80
+  healthcheck:
+    path: /up
+
+registry:
+  username: your-dockerhub-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64
+
+# All four SQLite databases and Active Storage uploads live here.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    SAAS: "false"
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    JOB_CONCURRENCY: 1
+    APP_HOST: fizzy.example.com
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
