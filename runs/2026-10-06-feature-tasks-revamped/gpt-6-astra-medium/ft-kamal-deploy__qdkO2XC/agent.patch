+# bundle exec ruby test/deployment/runtime_test.rb
+require "minitest/autorun"
+require "open3"
+require "json"
+
+class DeploymentRuntimeTest < Minitest::Test
+  def test_production_settings_for_single_server
+    settings = production_settings("APP_HOST" => "boards.example.org", "SMTP_ADDRESS" => "smtp.example.org",
+      "SMTP_DOMAIN" => "example.org", "SMTP_USERNAME" => "sender", "SMTP_PASSWORD" => "secret")
+
+    assert_equal "smtp", settings["delivery_method"]
+    assert_equal "smtp.example.org", settings.dig("smtp", "address")
+    assert_equal 587, settings.dig("smtp", "port")
+    assert_equal "example.org", settings.dig("smtp", "domain")
+    assert_equal "sender", settings.dig("smtp", "user_name")
+    assert_equal "secret", settings.dig("smtp", "password")
+    assert_equal "plain", settings.dig("smtp", "authentication")
+    assert_equal true, settings.dig("smtp", "enable_starttls_auto")
+    assert_equal false, settings.dig("smtp", "ssl")
+    assert_equal({ "host" => "boards.example.org", "protocol" => "https" }, settings["mail_urls"])
+    assert_equal settings["mail_urls"], settings["routes"]
+    assert_equal settings["mail_urls"], settings["controller_urls"]
+    assert_equal "local", settings["storage"]
+    assert_equal File.expand_path("storage/production/files"), settings["upload_root"]
+    assert_equal %w[ cable cache primary queue ], settings["databases"].keys.sort
+    settings["databases"].each_value do |path|
+      assert File.expand_path(path).start_with?(File.expand_path("storage") + "/"), path
+    end
+    assert_equal "solid_queue", settings["jobs"]
+    assert_equal true, settings["assume_ssl"]
+    assert_equal true, settings["force_ssl"]
+    assert_equal 200, settings["health_status"]
+  end
+
+  def test_implicit_tls_and_unauthenticated_relay
+    settings = production_settings("SMTP_ADDRESS" => "smtp.example.org", "SMTP_PORT" => "465",
+      "SMTP_SSL" => "true", "SMTP_ENABLE_STARTTLS_AUTO" => "false", "SMTP_AUTHENTICATION" => "")
+
+    assert_equal "localhost", settings.dig("smtp", "domain")
+    assert_equal 465, settings.dig("smtp", "port")
+    assert_equal true, settings.dig("smtp", "ssl")
+    assert_equal false, settings.dig("smtp", "enable_starttls_auto")
+    assert_nil settings.dig("smtp", "authentication")
+    assert_nil settings.dig("smtp", "user_name")
+    assert_nil settings.dig("smtp", "password")
+  end
+
+  def test_unconfigured_mail_retains_rails_defaults
+    settings = production_settings
+
+    assert_equal "localhost", settings.dig("smtp", "address")
+    assert_equal 25, settings.dig("smtp", "port")
+    refute settings["routes"].key?("host")
+  end
+
+  private
+    def production_settings(overrides = {})
+      environment = %w[ APP_HOST SMTP_ADDRESS SMTP_PORT SMTP_DOMAIN SMTP_USERNAME SMTP_PASSWORD
+        SMTP_AUTHENTICATION SMTP_ENABLE_STARTTLS_AUTO SMTP_SSL DISABLE_SSL ASSUME_SSL FORCE_SSL ].to_h { |key| [ key, nil ] }
+      environment.merge!("RAILS_ENV" => "production", "SAAS" => "false", "DATABASE_ADAPTER" => "sqlite",
+        "ACTIVE_STORAGE_SERVICE" => "local", "SECRET_KEY_BASE" => "deployment-test-only")
+      script = <<~RUBY
+        require "json"
+        require "rack/mock"
+        puts JSON.generate(
+          delivery_method: ActionMailer::Base.delivery_method,
+          smtp: ActionMailer::Base.smtp_settings,
+          mail_urls: ActionMailer::Base.default_url_options,
+          controller_urls: ActionController::Base.default_url_options,
+          routes: Rails.application.routes.default_url_options,
+          storage: Rails.application.config.active_storage.service,
+          upload_root: ActiveStorage::Blob.service.root,
+          databases: ActiveRecord::Base.configurations.configs_for(env_name: "production").to_h { |db| [ db.name, db.database ] },
+          jobs: Rails.application.config.active_job.queue_adapter,
+          assume_ssl: Rails.application.config.assume_ssl,
+          force_ssl: Rails.application.config.force_ssl,
+          health_status: Rack::MockRequest.new(Rails.application).get("/up").status
+        )
+      RUBY
+      output, error, status = Open3.capture3(environment.merge(overrides), "bin/rails", "runner", "-", stdin_data: script)
+      assert status.success?, "Production boot failed:\n#{output}\n#{error}"
+      JSON.parse(output.lines.last)
+    end
+end
