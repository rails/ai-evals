diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..4ac5085
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,207 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:layout)
+    @column = columns(:writebook_in_progress)
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@card, :article)}", visible: :all
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+  end
+
+  test "moving a card is immediate and preserves the saved column order" do
+    page.execute_script <<~JS
+      const originalFetch = window.fetch
+      window.fetch = (...args) => {
+        if (args[0].toString().includes('/triage')) {
+          return new Promise(resolve => window.finishMove = () => resolve(originalFetch(...args)))
+        }
+        return originalFetch(...args)
+      }
+    JS
+
+    drag_card_to dom_id(@column)
+
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_equal columns(:writebook_triage), @card.reload.column
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+    order = column_order(@column)
+
+    page.execute_script "window.droppedCard = document.getElementById(#{dom_id(@card, :article).to_json}); window.finishMove()"
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+    assert_equal @column, @card.reload.column
+    assert page.evaluate_script("window.droppedCard === document.getElementById(#{dom_id(@card, :article).to_json})")
+    assert_equal order, column_order(@column)
+
+    refresh
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_equal order, column_order(@column)
+  end
+
+  test "ordinary cards stay behind golden cards and golden cards move to the top" do
+    source = columns(:writebook_triage)
+    @card = cards(:text)
+    drag_card_to dom_id(source)
+    wait_for_save
+    assert_equal [ cards(:logo), @card ].map { |card| dom_id(card, :article) }, column_order(source).first(2)
+    order = column_order(source)
+    refresh
+    assert_selector "##{dom_id(source)} ##{dom_id(@card, :article)}", visible: :all
+    assert_equal order, column_order(source)
+
+    @card = cards(:logo)
+    drag_card_to dom_id(@column)
+    wait_for_save
+    assert_equal dom_id(@card, :article), column_order(@column).first
+  end
+
+  test "cards can move through every status and into an empty column" do
+    [ "closed-cards", "not-now", "maybe", dom_id(columns(:writebook_review)) ].each do |destination|
+      assert_selector "##{destination} .cards__list", visible: :all
+      drag_card_to destination
+      wait_for_save
+      assert_selector "##{destination} ##{dom_id(@card, :article)}", visible: :all
+      @card.reload
+
+      case destination
+      when "closed-cards" then assert @card.closed?
+      when "not-now" then assert @card.postponed?
+      when "maybe" then assert @card.awaiting_triage?
+      else assert_equal columns(:writebook_review), @card.column
+      end
+    end
+
+    assert_selector "##{dom_id(columns(:writebook_review))} .blank-slate[hidden]", count: 2, visible: :all
+  end
+
+  test "same-column and external drops do not move cards" do
+    source = @card.column
+    order = column_order(source)
+    activity = @card.last_active_at
+    drag_card_to dom_id(source)
+    assert_equal order, column_order(source)
+    assert_equal activity, @card.reload.last_active_at
+
+    page.execute_script <<~JS
+      const column = document.getElementById(#{dom_id(@column).to_json})
+      column.dispatchEvent(new DragEvent('drop', { bubbles: true, dataTransfer: new DataTransfer() }))
+    JS
+    assert_equal order, column_order(source)
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+  end
+
+  test "canceled drags clean up feedback without saving" do
+    source = @card.column
+    page.execute_script <<~JS
+      const card = document.getElementById(#{dom_id(@card, :article).to_json})
+      const column = document.getElementById(#{dom_id(@column).to_json})
+      const dataTransfer = new DataTransfer()
+      card.dispatchEvent(new DragEvent('dragstart', { bubbles: true, dataTransfer }))
+      column.dispatchEvent(new DragEvent('dragover', { bubbles: true, cancelable: true, dataTransfer }))
+    JS
+    assert_selector "##{dom_id(@card, :article)}.drag-and-drop__dragged-item", visible: :all
+    assert_selector "##{dom_id(@column)}.drag-and-drop__hover-container", visible: :all
+    page.execute_script <<~JS
+      document.getElementById(#{dom_id(@card, :article).to_json}).dispatchEvent(new DragEvent('dragend', { bubbles: true }))
+    JS
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+    assert_equal source, @card.reload.column
+  end
+
+  test "failed saves restore the original position and counts" do
+    source = @card.column
+    order = column_order(source)
+    counts = all("[data-card-count]", visible: :all).map { |element| element["data-card-count"] }
+    page.execute_script <<~JS
+      const originalFetch = window.fetch
+      window.fetch = (...args) => args[0].toString().includes('/triage') ?
+        Promise.resolve(new Response('', { status: 422 })) : originalFetch(...args)
+    JS
+
+    accept_alert("This card could not be moved. Please try again.") do
+      drag_card_to dom_id(@column)
+    end
+
+    assert_equal order, column_order(source)
+    assert_equal counts, all("[data-card-count]", visible: :all).map { |element| element["data-card-count"] }
+    assert_equal source, @card.reload.column
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container, .card[aria-busy]", visible: :all
+  end
+
+  test "a native browser drag moves the card" do
+    within "##{dom_id(@card.column)}" do
+      find(".cards__expander").click
+    end
+    find("##{dom_id(@card, :article)}").drag_to(find("##{dom_id(@column)} .cards__expander"))
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    wait_for_save
+    assert_equal @column, @card.reload.column
+  end
+
+  test "rapid moves are saved in drop order without moving again" do
+    page.execute_script <<~JS
+      const originalFetch = window.fetch
+      window.fetch = (...args) => {
+        if (args[0].toString().includes('/triage') && !window.finishMove) {
+          return new Promise(resolve => window.finishMove = () => resolve(originalFetch(...args)))
+        }
+        return originalFetch(...args)
+      }
+    JS
+    first_card = @card
+    drag_card_to dom_id(@column)
+    @card = cards(:shipping)
+    drag_card_to dom_id(@column)
+    order = column_order(@column)
+    assert_equal [ @card, first_card ].map { |card| dom_id(card, :article) }, order.first(2)
+    assert_equal columns(:writebook_triage), @card.reload.column
+
+    page.execute_script "window.finishMove()"
+    wait_for_save
+    assert_equal @column, @card.reload.column
+    assert_equal order, column_order(@column)
+    refresh
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_equal order, column_order(@column)
+  end
+
+  test "a network failure restores the card" do
+    source = @card.column
+    order = column_order(source)
+    page.execute_script <<~JS
+      const originalFetch = window.fetch
+      window.fetch = (...args) => args[0].toString().includes('/triage') ?
+        Promise.reject(new TypeError('Failed to fetch')) : originalFetch(...args)
+    JS
+    accept_alert("This card could not be moved. Please try again.") do
+      drag_card_to dom_id(@column)
+    end
+    assert_equal order, column_order(source)
+    assert_no_selector ".card[aria-busy]", visible: :all
+  end
+
+  private
+
+
+    def wait_for_save
+      assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+    end
+
+
+    def drag_card_to(column_id)
+      page.execute_script <<~JS
+        const card = document.getElementById(#{dom_id(@card, :article).to_json})
+        const column = document.getElementById(#{column_id.to_json})
+        const dataTransfer = new DataTransfer()
+        card.dispatchEvent(new DragEvent('dragstart', { bubbles: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent('dragover', { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent('drop', { bubbles: true, cancelable: true, dataTransfer }))
+        card.dispatchEvent(new DragEvent('dragend', { bubbles: true, dataTransfer }))
+      JS
+    end
+
