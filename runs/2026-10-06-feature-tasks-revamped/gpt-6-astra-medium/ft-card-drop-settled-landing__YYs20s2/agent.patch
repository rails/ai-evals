diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..f1f2dee
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,219 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "card", "column" ]
+  static classes = [ "dragged", "hover" ]
+  static values = { userName: String }
+
+  #saveQueue = Promise.resolve()
+
+  cardTargetConnected(card) {
+    card.draggable = true
+  }
+
+  disconnect() {
+    this.end()
+    this.cardTargets.forEach(card => card.removeAttribute("draggable"))
+  }
+
+  start(event) {
+    const card = event.target.closest('[data-drag-and-drop-target="card"]')
+    if (!this.cardTargets.includes(card) || card.hasAttribute("aria-busy")) {
+      event.preventDefault()
+      return
+    }
+
+    this.card = card
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+    card.classList.add(this.draggedClass)
+  }
+
+  over(event) {
+    const column = this.#destination(event.target)
+    this.#highlight(column)
+
+    if (column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (this.hoveredColumn && !this.hoveredColumn.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  async drop(event) {
+    const column = this.#destination(event.target)
+    const card = this.card
+    this.end()
+    if (card) event.preventDefault()
+
+    if (column) {
+      await this.#move(card, column)
+    }
+  }
+
+  end() {
+    this.card?.classList.remove(this.draggedClass)
+    this.card = null
+    this.#highlight(null)
+  }
+
+  // Private
+
+  #destination(target) {
+    const column = target.closest('[data-drag-and-drop-target="column"]')
+    if (this.card && this.columnTargets.includes(column) && !column.contains(this.card) && column.querySelector(".cards__list")) {
+      return column
+    }
+  }
+
+  #highlight(column) {
+    if (column !== this.hoveredColumn) {
+      this.hoveredColumn?.classList.remove(this.hoverClass)
+      column?.classList.add(this.hoverClass)
+      this.hoveredColumn = column
+    }
+  }
+
+  async #move(card, column) {
+    const source = card.closest('[data-drag-and-drop-target="column"]')
+    const original = card.cloneNode(true)
+    const position = document.createComment("card position")
+    card.before(position)
+
+    card.setAttribute("aria-busy", "true")
+    this.#insert(card, column)
+    this.#updateAppearance(card, column)
+    this.#updateCount(source, -1)
+    this.#updateCount(column, 1)
+
+    try {
+      // Persist in drop order, even when several cards are moved quickly.
+      // Otherwise network timing could give them a different activity order.
+      const request = this.#request(card, column)
+      const save = this.#saveQueue.then(() => request.perform())
+      this.#saveQueue = save.catch(() => {})
+      const response = await save
+      if (!response.ok) throw new Error("Card move failed")
+    } catch (error) {
+      card.remove()
+      position.replaceWith(original)
+      this.#updateCount(source, 1)
+      this.#updateCount(column, -1)
+      window.alert("This card could not be moved. Please try again.")
+    } finally {
+      card.removeAttribute("aria-busy")
+      position.remove()
+    }
+  }
+
+  #insert(card, column) {
+    const cards = Array.from(column.querySelectorAll('[data-drag-and-drop-target="card"]'))
+    const goldenFirst = [ "column", "maybe" ].includes(column.dataset.dragAndDropStatus)
+    const nextCard = goldenFirst && !card.classList.contains("golden-effect") ?
+      cards.find(candidate => !candidate.classList.contains("golden-effect")) : cards[0]
+
+    // Moves record fresh activity. Active columns keep golden cards ahead of
+    // ordinary cards; Not Now and Done put the newly moved card first.
+    if (nextCard) {
+      nextCard.before(card)
+    } else if (cards.length) {
+      cards.at(-1).after(card)
+    } else {
+      column.querySelector(".cards__list").prepend(card)
+    }
+  }
+
+  #updateAppearance(card, column) {
+    const status = column.dataset.dragAndDropStatus
+    const active = [ "column", "maybe" ].includes(status)
+    card.classList.toggle("card--active", active)
+    card.classList.toggle("card--postponed", status === "not-now")
+    card.style.setProperty("--card-color", column.style.getPropertyValue("--card-color") || "var(--color-card-default)")
+    card.querySelectorAll(".card__closed, .bubble").forEach(element => element.remove())
+
+    const time = card.querySelector(".card__meta-text--updated time")
+    if (time) {
+      const updatedTime = time.cloneNode(true)
+      updatedTime.setAttribute("datetime", Math.floor(Date.now() / 1000))
+      time.replaceWith(updatedTime)
+    }
+
+    this.#updateColumnLabel(card, column)
+    if (!active) this.#addStamp(card, status === "closed" ? "Done" : "Not Now")
+
+    if (status === "closed") {
+      delete card.dataset.cardNotNowUrl
+      delete card.dataset.cardClosureUrl
+    } else {
+      card.dataset.cardNotNowUrl = card.dataset.dragAndDropNotNowUrl
+      card.dataset.cardClosureUrl = card.dataset.dragAndDropClosureUrl
+    }
+  }
+
+  #updateColumnLabel(card, column) {
+    const columnId = column.dataset.dragAndDropColumnId
+    card.querySelectorAll(".card__stages [data-column-id]").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", stage.dataset.columnId === columnId)
+    })
+
+    let label = card.querySelector(".card__header .card__column-name--current")
+    if (columnId) {
+      if (!label) {
+        label = document.createElement("span")
+        label.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+        card.querySelector(".card__header").append(label)
+      }
+      const name = document.createElement("span")
+      name.className = "overflow-ellipsis"
+      name.textContent = column.dataset.columnName
+      label.replaceChildren(name)
+    } else {
+      label?.remove()
+    }
+  }
+
+  #addStamp(card, title) {
+    const stamp = document.createElement("div")
+    stamp.className = "card__closed"
+    const date = new Intl.DateTimeFormat("en-US", { month: "short", day: "2-digit", year: "numeric" }).format(new Date())
+
+    for (const [ className, text ] of [ [ "card__closed-title", title ], [ "card__closed-date", date ], [ "card__closed-by", this.userNameValue ] ]) {
+      const element = document.createElement("span")
+      element.className = className
+      element.textContent = text
+      stamp.append(element)
+    }
+    card.querySelector(".card__body").append(stamp)
+  }
+
+  #updateCount(column, change) {
+    const counter = column.querySelector("[data-card-count]")
+    const count = Number(counter.dataset.cardCount) + change
+    counter.closest(".cards__expander").style.setProperty("--card-count", Math.min(column.querySelectorAll(".card").length, 15))
+    counter.dataset.cardCount = count
+    counter.textContent = count > 99 ? "99+" : count
+    column.querySelectorAll(".blank-slate").forEach(element => element.hidden = count > 0)
+  }
+
+  #request(card, column) {
+    const options = { responseKind: "json" }
+
+    switch (column.dataset.dragAndDropStatus) {
+      case "column":
+        options.body = { column_id: column.dataset.dragAndDropColumnId }
+        return new FetchRequest("post", card.dataset.dragAndDropTriageUrl, options)
+      case "maybe":
+        return new FetchRequest("delete", card.dataset.dragAndDropTriageUrl, options)
+      case "not-now":
+        return new FetchRequest("post", card.dataset.dragAndDropNotNowUrl, options)
+      case "closed":
+        return new FetchRequest("post", card.dataset.dragAndDropClosureUrl, options)
+    }
+  }
+}
