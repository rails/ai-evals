@@ -0,0 +1,86 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+    visit card_url(@comment.card)
+  end
+
+  test "add, cancel, add again, and remove a reaction" do
+    within "##{dom_id(@comment)} .reactions" do
+      click_on "Add a reaction"
+      assert_no_button "Add a reaction"
+      fill_in "Your reaction (16 characters maximum)", with: "Never mind"
+      click_on "Cancel reaction"
+      assert_button "Add a reaction"
+      assert_no_field "Your reaction (16 characters maximum)"
+      assert_no_text "Never mind"
+
+      [ "👍", "Great work!" ].each do |content|
+        click_on "Add a reaction"
+        fill_in "Your reaction (16 characters maximum)", with: content
+        click_on "Confirm reaction"
+        assert_button "Add a reaction"
+        assert_no_field "Your reaction (16 characters maximum)"
+        assert_text content
+      end
+
+      perform_enqueued_jobs only: [ Turbo::Streams::ActionBroadcastJob, Turbo::Streams::BroadcastStreamJob ]
+      assert_selector ".reactions__list .reaction", count: 2
+      assert_no_button "Remove reaction"
+      find("[role=button][aria-label='Kevin: 👍']").send_keys(:enter)
+      click_on "Remove reaction"
+      assert_no_text "👍"
+      assert_text "Great work!"
+    end
+
+    assert_equal [ "Great work!" ], @comment.reactions.pluck(:content)
+    page.refresh
+    within "##{dom_id(@comment)} .reactions" do
