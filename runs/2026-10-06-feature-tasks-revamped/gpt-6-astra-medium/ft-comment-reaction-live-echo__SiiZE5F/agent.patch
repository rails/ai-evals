--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,37 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.build(params.expect(reaction: [ :content ]))
+
+    if @reaction.save
+      render turbo_stream: turbo_stream.append([ @comment, :reactions ],
+        partial: "cards/comments/reactions/reaction", locals: { reaction: @reaction })
+    else
+      render turbo_stream: turbo_stream.update([ @comment, :reaction_errors ], @reaction.errors.full_messages.to_sentence),
+        status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+    render turbo_stream: turbo_stream.remove(@reaction)
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden unless @reaction.creator == Current.user
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..23012ab
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,36 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "toggle", "removal" ]
+  static values = { creatorId: String }
+
+  connect() {
+    if (this.#ownReaction) {
+      this.element.classList.add("reaction--deleteable")
+      this.toggleTarget.setAttribute("role", "button")
+      this.toggleTarget.setAttribute("tabindex", "0")
+      this.collapse()
+    }
+  }
+
+  toggle(event) {
+    if (this.#ownReaction) {
+      event.preventDefault()
+      const expanded = this.element.classList.toggle("expanded")
+      this.toggleTarget.setAttribute("aria-expanded", expanded)
+      this.removalTarget.hidden = !expanded
+    }
+  }
+
+  collapse() {
+    if (this.#ownReaction) {
+      this.element.classList.remove("expanded")
+      this.toggleTarget.setAttribute("aria-expanded", "false")
+      this.removalTarget.hidden = true
+    }
+  }
+
+  get #ownReaction() {
+    return this.creatorIdValue === window.Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..359a9c4
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,38 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "editor", "form", "input", "errors" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.editorTarget.hidden = false
+    this.editorTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.formTarget.reset()
+    this.inputTarget.setCustomValidity("")
+    this.errorsTarget.textContent = ""
+    this.editorTarget.hidden = true
+    this.editorTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  validate(event) {
+    const content = this.inputTarget.value
+    const valid = content.trim().length > 0 && Array.from(content).length <= 16
+    this.inputTarget.setCustomValidity(valid ? "" : "Enter a reaction of 1 to 16 characters.")
+
+    if (!valid && event.type === "submit") {
+      event.preventDefault()
+      this.inputTarget.reportValidity()
+    }
+  }
+
+  submitted(event) {
+    if (event.detail.success) this.cancel()
+  }
+}
