--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "text and emoji may contain up to 16 characters" do
+    [ "a" * 16, "👍" * 16, "Great work!" ].each do |content|
+      assert @comment.reactions.build(content: content).valid?
+    end
+
+    [ nil, "", " \n ", "a" * 17, "👍" * 17 ].each do |content|
+      assert_not @comment.reactions.build(content: content).valid?
+    end
+  end
+
+  test "one person can leave multiple reactions" do
+    assert_difference -> { @comment.reactions.count }, 2 do
+      2.times { @comment.reactions.create!(content: "👍") }
+    end
+  end
+
+  test "creating and removing a reaction broadcasts to the card" do
+    reaction = nil
+    perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+      assert_turbo_stream_broadcasts @comment.card do
+        reaction = @comment.reactions.create!(content: "👍")
+      end
+    end
+
+    assert_turbo_stream_broadcasts @comment.card do
+      reaction.destroy!
+    end
+  end
+
+  test "changes invalidate the cached comment" do
+    original_key = @comment.cache_key_with_version
+    reaction = @comment.reactions.create!(content: "👍")
+    assert_not_equal original_key, @comment.reload.cache_key_with_version
+
+    updated_key = @comment.cache_key_with_version
+    reaction.destroy!
+    assert_not_equal updated_key, @comment.reload.cache_key_with_version
+  end
+
+  test "destroying a comment destroys its reactions" do
+    reaction = @comment.reactions.create!(content: "👍")
+    @comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
