diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..ff2dd4c
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,41 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :archive
+
+  enum :kind, %w[ account cards ].index_by(&:itself), suffix: true
+  validates :kind, presence: true
+
+  after_create_commit :build_later
+
+  def build_archive
+    with_lock do
+      unless completed_at?
+        raise ArgumentError, "Export access has been revoked" unless user.active? && user.account == account && (!account_kind? || user.admin?)
+        Current.with(account: account, user: user) do
+          ZipFile.create_for(archive, filename: "fizzy-#{kind}-#{id}.zip") do |zip|
+            records = {}
+            if account_kind?
+              Account::DataTransfer::Manifest.new(account).each_record_set do |set|
+                set.export_to(zip)
+                records[set.model.table_name] = zip.glob("#{set.model.table_name}/*.json").size
+              end
+            end
+            Account::DataTransfer::CardExport.new(account_kind? ? account.cards : user.accessible_cards).write_to(zip)
+            zip.add_file("manifest.json", { version: 1, kind: kind, account_id: account.id, records: records }.to_json)
+          end
+          update!(completed_at: Time.current)
+        end
+      end
+    end
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_at: completed_at + 1.day)
+  end
+
+  private
+    def build_later
+      ExportJob.perform_later(self)
+    end
+end
