diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..25becea
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,91 @@
+# Reads ranges through Active Storage, so S3 archives need not fit on local disk.
+# Entry names are never used as filesystem paths.
+class ZipFile::Reader
+  JSON_LIMIT = 32.megabytes
+
+  def initialize(blob)
+    @io = BlobIO.new(blob)
+    @reader = ZipKit::FileReader.new
+    entries = @reader.read_zip_structure(io: @io, read_local_headers: false)
+    @entries = entries.index_by(&:filename)
+    raise ArgumentError, "Duplicate ZIP entries" unless entries.size == @entries.size
+    entries.each do |entry|
+      raise ArgumentError, "Unsafe ZIP entry" if entry.filename.start_with?("/", "\\") || entry.filename.split(/[\\\/]/).include?("..")
+      raise ArgumentError, "Unsupported ZIP entry" unless [ 0, 8 ].include?(entry.storage_mode) && entry.gp_flags & 1 == 0
+    end
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def read_json(path)
+    content = +""
+    each_chunk(path, limit: JSON_LIMIT) { |chunk| content << chunk }
+    JSON.parse(content)
+  end
+
+  def open(path)
+    Tempfile.create("fizzy-import", binmode: true) do |file|
+      each_chunk(path) { |chunk| file.write(chunk) }
+      file.rewind
+      yield file
+    end
+  end
+
+  def each_chunk(path, limit: nil)
+    entry = @entries.fetch(path) { raise ArgumentError, "Missing archive entry: #{path}" }
+    raise ArgumentError, "Archive entry is too large" if limit && entry.uncompressed_size > limit
+    entry.compressed_data_offset = @reader.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+    @io.seek(entry.compressed_data_offset)
+    remaining = entry.compressed_size
+    crc = size = 0
+    inflater = Zlib::Inflate.new(-Zlib::MAX_WBITS) if entry.storage_mode == 8
+    consume = ->(chunk) do
+      size += chunk.bytesize
+      raise ArgumentError, "Invalid archive entry size" if size > entry.uncompressed_size || (limit && size > limit)
+      crc = Zlib.crc32(chunk, crc)
+      yield chunk
+    end
+    while remaining > 0
+      chunk = @io.read([ remaining, 64.kilobytes ].min)
+      raise ArgumentError, "Truncated ZIP entry" if chunk.empty?
+      remaining -= chunk.bytesize
+      if inflater
+        inflater.inflate(chunk, &consume)
+      else
+        consume.call(chunk)
+      end
+    end
+    raise ArgumentError, "Incomplete ZIP entry" if inflater && !inflater.finished?
+    raise ArgumentError, "Corrupt ZIP entry" unless size == entry.uncompressed_size && crc == entry.crc32
+  ensure
+    inflater&.close
+  end
+
+  private
+    class BlobIO
+      attr_reader :size, :tell
+
+      def initialize(blob)
+        @blob, @size, @tell = blob, blob.byte_size, 0
+      end
+
+      def seek(offset, mode = IO::SEEK_SET)
+        raise ArgumentError, "Invalid ZIP offset" unless mode == IO::SEEK_SET && offset.between?(0, size)
+        @tell = offset
+      end
+
+      def read(length = nil)
+        length ||= size - tell
+        # Bounds malicious central directory offsets without limiting archive size.
+        raise ArgumentError, "Invalid ZIP read" unless length.between?(0, 256.megabytes)
+        length = [ length, size - tell ].min
+        return "" if length.zero?
+        @blob.download_chunk(tell...(tell + length)).tap do |data|
+          raise ArgumentError, "Truncated ZIP" unless data.bytesize == length
+          @tell += length
+        end
+      end
+    end
+end
