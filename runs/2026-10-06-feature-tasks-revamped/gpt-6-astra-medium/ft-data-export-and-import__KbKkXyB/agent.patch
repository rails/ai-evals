+require "test_helper"
+
+class DataTransfersTest < ActionDispatch::IntegrationTest
+  test "only admins can export an account" do
+    sign_in_as :david
+    assert_no_difference "Export.count" do
+      post account_exports_path
+    end
+    assert_response :forbidden
+
+    logout_and_sign_in_as :jason
+    assert_enqueued_with(job: ExportJob) do
+      post account_exports_path
+    end
+    assert_response :redirect
+    assert Export.last.account_kind?
+  end
+
+  test "members can export only their own accessible cards" do
+    sign_in_as :david
+    assert_enqueued_with(job: ExportJob) do
+      post user_exports_path(users(:david))
+    end
+    assert Export.last.cards_kind?
+    assert_no_difference "Export.count" do
+      post user_exports_path(users(:jason))
+    end
+    assert_response :forbidden
+  end
+
+  test "download links work without signing in and expire in a day" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: :account)
+    export.build_archive
+    token = export.download_token
+    untenanted do
+      get export_download_path(token)
+      assert_response :redirect
+      assert_match /disk/, response.location
+      travel 1.day + 1.second do
+        get export_download_path(token)
+        assert_response :not_found
+      end
+    end
+  end
+
+  test "signed in people can upload an account without a current account" do
+    logout_and_sign_in_as :jason
+    untenanted do
+      get new_account_import_path
+      assert_response :success
+      assert_enqueued_with(job: ImportJob) do
+        post account_imports_path, params: { import: { archive: fixture_file_upload("moon.jpg", "application/zip") } }
+      end
+      assert_response :redirect
+      assert Import.last.archive.attached?
+    end
+  end
+
+  test "import requires authentication" do
+    untenanted do
+      get new_account_import_path
+      assert_response :redirect
+      assert_no_difference "Import.count" do
+        post account_imports_path
+      end
+    end
+  end
+end
