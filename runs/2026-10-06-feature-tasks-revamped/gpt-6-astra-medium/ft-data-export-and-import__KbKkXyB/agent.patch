+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+  layout "public"
+
+  def new
+    @import = Import.new
+  end
+
+  def create
+    @import = Import.new(identity: Current.identity)
+    if params.dig(:import, :archive).present?
+      @import.archive.attach(params.expect(import: [ :archive ])[:archive])
+      @import.save!
+      @import.restore_later
+      redirect_to new_account_import_path, notice: "We’ll email you when your account import is finished."
+    else
+      @import.errors.add(:archive, "must be selected")
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
diff --git a/app/controllers/exports/downloads_controller.rb b/app/controllers/exports/downloads_controller.rb
new file mode 100644
index 0000000..a1fd300
--- /dev/null
+++ b/app/controllers/exports/downloads_controller.rb
@@ -0,0 +1,19 @@
+class Exports::DownloadsController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+
+  def show
+    export = Export.find_signed!(params[:export_id], purpose: :download)
+    if export.completed_at? && export.completed_at > 1.day.ago && export.archive.attached?
+      # Never expose the permanent Active Storage blob URL. The service URL expires
+      # no later than the original one-day download window.
+      expires_in = [ 5.minutes, export.completed_at + 1.day - Time.current ].min
+      ActiveStorage::Current.url_options = { protocol: request.protocol, host: request.host, port: request.port }
+      redirect_to export.archive.url(expires_in: expires_in, disposition: :attachment), allow_other_host: true
+    else
+      head :gone
+    end
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+    head :not_found
+  end
+end
