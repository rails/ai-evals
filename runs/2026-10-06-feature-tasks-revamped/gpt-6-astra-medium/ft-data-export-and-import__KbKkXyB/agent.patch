diff --git a/app/models/account/data_transfer/restorer.rb b/app/models/account/data_transfer/restorer.rb
new file mode 100644
index 0000000..a065237
--- /dev/null
+++ b/app/models/account/data_transfer/restorer.rb
@@ -0,0 +1,183 @@
+class Account::DataTransfer::Restorer
+  def initialize(blob, identity:)
+    @zip = ZipFile::Reader.new(blob)
+    @identity = identity
+    @ids = {}
+    @uploaded_blobs = []
+    @sets = Account::DataTransfer::Manifest.new(nil).enum_for(:each_record_set).to_a
+      .reject { |set| set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet) }
+    @models = @sets.map(&:model).index_by(&:name)
+  end
+
+  def restore
+    ApplicationRecord.transaction(requires_new: true) do
+      read_manifest
+      allocate_ids
+      create_account
+      Current.with(account: @account, user: nil) do
+        @sets.each do |set|
+          next if set.model == Account
+          paths_for(set.model).each { |path| restore_record(set.model, @zip.read_json(path)) }
+        end
+        ensure_owner
+        @account.update_columns(cards_count: [ @original_cards_count, @account.cards.maximum(:number) || 0 ].max)
+        @account.boards.find_each(&:reconcile_storage)
+        @account.reconcile_storage
+        @account.cards.find_each(&:reindex)
+        Comment.where(account: @account).find_each(&:reindex)
+        yield @account if block_given?
+        @account
+      end
+    end
+  rescue Exception
+    # Object storage is outside the database transaction. Keys are unique to this attempt.
+    @uploaded_blobs.each { |blob| blob.service.delete(blob.key) }
+    raise
+  end
+
+  private
+    def read_manifest
+      manifest = @zip.read_json("manifest.json")
+      unless manifest["version"] == 1 && manifest["kind"] == "account"
+        raise ArgumentError, "Please choose a supported Fizzy account export, not a personal card export."
+      end
+      @source_account_id = manifest.fetch("account_id")
+      @record_counts = manifest.fetch("records")
+    end
+
+    def allocate_ids
+      @sets.each do |set|
+        paths = paths_for(set.model)
+        raise ArgumentError, "Incomplete #{set.model.table_name} records" unless @record_counts[set.model.table_name] == paths.size
+        paths.each do |path|
+          old_id = File.basename(path, ".json")
+          raise ArgumentError, "Invalid record ID" unless old_id.match?(/\A[a-z0-9]{25}\z/)
+          @ids[[ set.model.name, old_id ]] = ActiveRecord::Type::Uuid.generate
+        end
+      end
+      raise ArgumentError, "Archive must contain exactly one account" unless paths_for(Account) == [ "accounts/#{@source_account_id}.json" ]
+    end
+
+    def paths_for(model)
+      @zip.glob("#{model.table_name}/*.json")
+    end
+
+    def create_account
+      attributes = @zip.read_json(paths_for(Account).sole)
+      @original_cards_count = attributes.fetch("cards_count", 0)
+      @account = Account.create!(**attributes.slice("name", "created_at", "updated_at"), id: mapped_id("Account", @source_account_id))
+      @account.entropy.destroy!
+    end
+
+    def restore_record(model, source)
+      old_id = source.fetch("id")
+      raise ArgumentError, "Record belongs to another account" unless source["account_id"] == @source_account_id
+      attrs = source.slice(*model.column_names)
+      attrs["id"] = mapped_id(model.name, old_id)
+      attrs["account_id"] = @account.id
+      remap_references(model, attrs)
+
+      case model.name
+      when "User"
+        attrs["identity_id"] = identity_for(source)&.id
+        attrs["role"] = "admin" if attrs["role"] == "owner"
+      when "ActiveStorage::Blob"
+        attrs["key"] = ActiveStorage::Blob.generate_unique_secure_token
+        attrs["service_name"] = ActiveStorage::Blob.service.name
+      when "ActionText::RichText"
+        attrs["body"] = Account::DataTransfer::RichText.restore(attrs["body"]) do |type, id|
+          @models.fetch(type).find(mapped_id(type, id))
+        end
+      when "Event"
+        if attrs.dig("particulars", "assignee_ids")
+          attrs["particulars"]["assignee_ids"] = attrs["particulars"]["assignee_ids"].map { |id| mapped_id("User", id) }
+        end
+      when "Filter"
+        attrs["fields"] = attrs.fetch("fields").dup
+        { "card_ids" => "Card", "column_ids" => "Column" }.each do |key, type|
+          if attrs["fields"][key]
+            attrs["fields"][key] = attrs["fields"][key].map { |id| mapped_id(type, id) }
+          end
+        end
+      when "Board::Publication"
+        attrs["key"] = SecureRandom.base58(24)
+      when "Webhook"
+        # A restored account must not start sending data to an imported endpoint.
+        attrs["active"] = false
+        attrs["signing_secret"] = SecureRandom.hex(32)
+      end
+
+      model.insert_all!([ attrs ])
+      upload_file(model.find(attrs["id"]), old_id) if model == ActiveStorage::Blob
+      restore_filter_resources(model.find(attrs["id"]), source) if model == Filter
+    end
+
+    def restore_filter_resources(filter, source)
+      Filter.reflect_on_all_associations(:has_and_belongs_to_many).each do |association|
+        ids = source.fetch("resources", {}).fetch(association.name.to_s, [])
+        filter.public_send("#{association.name.to_s.singularize}_ids=", ids.map { |id| mapped_id(association.klass.name, id) })
+      end
+      filter.save!
+    end
+
+    def remap_references(model, attrs)
+      model.reflect_on_all_associations(:belongs_to).each do |association|
+        key = association.foreign_key
+        next if key == "account_id" || (model == User && key == "identity_id") || attrs[key].nil?
+        type = association.polymorphic? ? attrs.fetch(association.foreign_type) : association.klass.name
+        attrs[key] = mapped_id(type, attrs[key])
+      end
+    end
+
+    def mapped_id(type, id)
+      @ids.fetch([ type, id ]) { raise ArgumentError, "Missing #{type} reference in archive" }
+    end
+
+    def identity_for(source)
+      if source["email_address"].present? && source["active"] && source["role"] != "system"
+        Identity.find_or_create_by!(email_address: source["email_address"])
+      end
+    end
+
+    def upload_file(blob, old_id)
+      @uploaded_blobs << blob
+      if defined?(ActiveStorage::Service::S3Service) && blob.service.is_a?(ActiveStorage::Service::S3Service)
+        upload_to_s3(blob, old_id)
+      else
+        @zip.open("files/#{old_id}") do |file|
+          raise ArgumentError, "Attached file size does not match" unless file.size == blob.byte_size
+          raise ActiveStorage::IntegrityError unless Digest::MD5.file(file.path).base64digest == blob.checksum
+          blob.service.upload(blob.key, file, checksum: blob.checksum)
+        end
+      end
+    end
+
+    def upload_to_s3(blob, old_id)
+      # Do not spool potentially enormous file entries onto the worker's disk.
+      part_size = [ 100.megabytes, blob.byte_size.fdiv(10_000).ceil ].max
+      blob.service.send(:upload_stream, key: blob.key, content_type: blob.content_type, part_size: part_size) do |sink|
+        digest = Digest::MD5.new
+        byte_size = 0
+        @zip.each_chunk("files/#{old_id}") do |chunk|
+          sink.write(chunk)
+          digest.update(chunk)
+          byte_size += chunk.bytesize
+        end
+        raise ActiveStorage::IntegrityError unless digest.base64digest == blob.checksum && byte_size == blob.byte_size
+      end
+    end
+
+    def ensure_owner
+      owner = @account.users.find_by(identity: @identity)
+      if owner
+        owner.update!(role: :owner, active: true, verified_at: Time.current)
+      else
+        owner = @account.users.create!(identity: @identity, name: @identity.email_address, role: :owner, verified_at: Time.current)
+      end
+      raise ArgumentError, "Archive must have one system user" unless @account.users.where(role: :system).count == 1
+      # The importing owner can administer the restored account, including private boards.
+      @account.boards.where.not(id: owner.accesses.select(:board_id)).find_each do |board|
+        Access.insert_all!([ { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, board_id: board.id, user_id: owner.id } ])
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/rich_text.rb b/app/models/account/data_transfer/rich_text.rb
new file mode 100644
index 0000000..7e1aa17
--- /dev/null
+++ b/app/models/account/data_transfer/rich_text.rb
@@ -0,0 +1,30 @@
+# Signed global IDs and blob URLs are instance-specific. Store portable references instead.
+class Account::DataTransfer::RichText
+  def self.export(body)
+    fragment = Nokogiri::HTML5.fragment(body.to_s)
+    fragment.css("action-text-attachment[sgid]").each do |node|
+      if attachable = GlobalID::Locator.locate_signed(node["sgid"], for: "attachable")
+        node["sgid"] = "fizzy:#{attachable.class.name}:#{attachable.id}"
+        node.remove_attribute("url")
+        node.remove_attribute("href")
+      end
+    end
+    fragment.to_html
+  end
+
+  def self.restore(body, &resolve)
+    fragment = Nokogiri::HTML5.fragment(body.to_s)
+    fragment.css("action-text-attachment[sgid]").each do |node|
+      match = /\Afizzy:(User|ActiveStorage::Blob):([a-z0-9]+)\z/.match(node["sgid"])
+      raise ArgumentError, "Invalid rich text attachment" unless match
+      attachable = resolve.call(match[1], match[2])
+      node["sgid"] = attachable.attachable_sgid
+      node.remove_attribute("url")
+      node.remove_attribute("href")
+      if attachable.is_a?(ActiveStorage::Blob)
+        node["url"] = Rails.application.routes.url_helpers.rails_blob_path(attachable, only_path: true, script_name: attachable.account.slug)
+      end
+    end
+    fragment.to_html
+  end
+end
