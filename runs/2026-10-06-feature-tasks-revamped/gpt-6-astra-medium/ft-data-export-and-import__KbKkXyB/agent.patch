new file mode 100644
index 0000000..274aee3
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,43 @@
+class Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+  has_one_attached :archive
+
+  enum :status, %w[ pending completed failed ].index_by(&:itself)
+
+  def restore_later
+    ImportJob.perform_later(self)
+  end
+
+  def restore
+    with_lock do
+      if pending?
+        begin
+          Account::DataTransfer::Restorer.new(archive.blob, identity: identity).restore do |restored_account|
+            update!(account: restored_account, status: :completed)
+          end
+        rescue StandardError => exception
+          Rails.error.report(exception)
+          reload.update!(status: :failed, error: failure_reason(exception))
+        end
+      end
+    end
+  end
+
+  private
+    def failure_reason(exception)
+      if exception.is_a?(ArgumentError) || exception.is_a?(JSON::ParserError)
+        exception.message.truncate(1000)
+      elsif exception.is_a?(ZipKit::FileReader::ReadError) || exception.is_a?(ZipKit::FileReader::MissingEOCD) || exception.is_a?(ZipKit::FileReader::UnsupportedFeature) || exception.is_a?(Zlib::Error)
+        "The ZIP archive is damaged or uses an unsupported ZIP format. Please export the account again."
+      elsif exception.is_a?(KeyError)
+        "The account archive is missing required data. Please export the whole account again."
+      elsif exception.is_a?(ActiveRecord::RecordInvalid)
+        "The archive contains invalid data: #{exception.record.errors.full_messages.to_sentence}"
+      elsif exception.is_a?(ActiveStorage::IntegrityError)
+        "An attached file failed its integrity check. Please export the account again."
+      else
+        "The archive could not be restored (#{exception.class.name}). Please check that it is a complete Fizzy account export."
+      end
+    end
+end
