@@ -0,0 +1,54 @@
+require "test_helper"
+
+class DataTransferJobsTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "export job emails a one-day link and schedules cleanup" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: :account)
+    assert_enqueued_email_with(DataTransferMailer, :export_ready, args: [ export ]) do
+      assert_enqueued_with(job: ExportCleanupJob, args: [ export ]) do
+        ExportJob.perform_now(export)
+      end
+    end
+    mail = DataTransferMailer.export_ready(export).message
+    assert_equal [ identities(:jason).email_address ], mail.to
+    assert_includes mail.text_part.body.to_s, export.download_token
+    assert_includes mail.text_part.body.to_s, "one day"
+    ExportCleanupJob.perform_now(export)
+    assert Export.exists?(export.id)
+    travel 1.day + 1.second do
+      ExportCleanupJob.perform_now(export)
+      assert_not Export.exists?(export.id)
+    end
+  end
+
+  test "successful imports email the new account link and remove the source upload" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: :account)
+    export.build_archive
+    import = Import.create!(identity: identities(:jason))
+    import.archive.attach(export.archive.blob)
+    assert_enqueued_email_with(DataTransferMailer, :import_finished, args: [ import ]) do
+      ImportJob.perform_now(import)
+    end
+    assert import.completed?, import.error
+    assert_not import.archive.attached?
+    mail = DataTransferMailer.import_finished(import).message
+    assert_includes mail.text_part.body.to_s, import.account.slug
+    assert_includes mail.subject, "complete"
+  end
+
+  test "failed imports email the reason and do not leave an account or upload" do
+    import = Import.create!(identity: identities(:jason))
+    import.archive.attach(io: StringIO.new("not a ZIP"), filename: "broken.zip")
+    assert_no_difference "Account.count" do
+      assert_enqueued_email_with(DataTransferMailer, :import_finished, args: [ import ]) do
+        ImportJob.perform_now(import)
+      end
+    end
+    assert import.failed?
+    assert_not import.archive.attached?
+    mail = DataTransferMailer.import_finished(import).message
+    assert_includes mail.text_part.body.to_s, import.error
+    assert_includes mail.subject, "failed"
+  end
+end
diff --git a/test/models/data_transfer_s3_test.rb b/test/models/data_transfer_s3_test.rb
new file mode 100644
index 0000000..d61f5ad
--- /dev/null
+++ b/test/models/data_transfer_s3_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+require "active_storage/service/s3_service"
+
+class DataTransferS3Test < ActiveSupport::TestCase
+  class MemoryS3Service < ActiveStorage::Service::S3Service
+    attr_reader :objects
+
+    def initialize
+      super(bucket: "transfers", region: "us-east-1", access_key_id: "test", secret_access_key: "test", stub_responses: true)
+      self.name = "transfer_test"
+      @objects = {}
+    end
+
+    def upload_stream(key:, **options)
+      io = StringIO.new("".b)
+      yield io
+      @objects[key] = io.string
+    end
+
+    def download_chunk(key, range)
+      @objects.fetch(key)[range]
+    end
+
+    def download(key)
+      if block_given?
+        yield @objects.fetch(key)
+      else
+        @objects.fetch(key)
+      end
+    end
+
+    def delete(key)
+      @objects.delete(key)
+    end
+  end
+
+  test "S3 exports and imports stream valid archives and files" do
+    previous_service = ActiveStorage::Blob.service
+    service = MemoryS3Service.new
+    ActiveStorage::Blob.service = service
+    ActiveStorage::Blob.services.stubs(:fetch).returns(service)
+    blob = ActiveStorage::Blob.create_before_direct_upload!(filename: "notes.txt", byte_size: 12, checksum: Digest::MD5.base64digest("file content"), content_type: "text/plain")
+    service.objects[blob.key] = "file content"
+    cards(:logo).image.attach(blob)
+
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: :account)
+    export.build_archive
+    bytes = service.objects.fetch(export.archive.key)
+    assert_equal bytes.bytesize, export.archive.byte_size
+    assert_equal Digest::MD5.base64digest(bytes), export.archive.checksum
+
+    import = Import.create!(identity: identities(:jason))
+    import.archive.attach(export.archive.blob)
+    ZipFile::Reader.any_instance.expects(:open).never
+    import.restore
+    assert import.completed?, import.error
+    restored_blob = import.account.cards.find_by!(number: cards(:logo).number).image.blob
+    assert_equal "file content", service.objects.fetch(restored_blob.key)
+    assert_not_equal blob.key, restored_blob.key
+  ensure
+    ActiveStorage::Blob.service = previous_service
+  end
+  test "failed S3 exports remove the temporary blob and object" do
+    previous_service = ActiveStorage::Blob.service
+    service = MemoryS3Service.new
+    ActiveStorage::Blob.service = service
+    ActiveStorage::Blob.services.stubs(:fetch).returns(service)
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: :account)
+    Account::DataTransfer::Manifest.any_instance.stubs(:each_record_set).raises(IOError, "storage failure")
+    assert_no_difference [ "ActiveStorage::Blob.count", "ActiveStorage::Attachment.count" ] do
+      assert_raises(IOError) { export.build_archive }
+    end
+    assert_empty service.objects
+    assert_not export.reload.archive.attached?
+    assert_nil export.completed_at
+  ensure
+    ActiveStorage::Blob.service = previous_service
+  end
+end
diff --git a/test/models/data_transfer_test.rb b/test/models/data_transfer_test.rb
