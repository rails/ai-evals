index 0000000..f8061c4
--- /dev/null
+++ b/app/models/account/data_transfer/card_export.rb
@@ -0,0 +1,34 @@
+# Human-readable cards, alongside the lossless account records when exporting an account.
+class Account::DataTransfer::CardExport
+  def initialize(cards)
+    @cards = cards
+  end
+
+  def write_to(zip)
+    @cards.find_each do |card|
+      attachments = card.image_attachment ? [ card.image_attachment ] : []
+      attachments.concat(card.attachments.to_a)
+      comments = card.comments.chronologically.map do |comment|
+        attachments.concat(comment.attachments.to_a)
+        comment.attributes.merge("body" => comment.body.to_s, "creator" => comment.creator.name, "file_ids" => comment.attachments.map(&:blob_id), "reactions" => comment.reactions.map(&:attributes))
+      end
+      files = attachments.map(&:blob).uniq(&:id).map do |blob|
+        path = "files/#{blob.id}"
+        unless zip.exists?(path)
+          zip.add_file(path, compress: false) { |sink| blob.download { |chunk| sink.write(chunk) } }
+        end
+        { id: blob.id, path: path, filename: blob.filename.to_s, content_type: blob.content_type }
+      end
+      zip.add_file("card_exports/#{card.number}.json", card.attributes.merge(
+        "description" => card.description.to_s, "creator" => card.creator.name,
+        "board" => card.board.name, "column" => card.column&.name,
+        "assignees" => card.assignees.map { |user| user.attributes.slice("id", "name") },
+        "tags" => card.tags.map(&:attributes), "steps" => card.steps.map(&:attributes),
+        "closure" => card.closure&.attributes, "goldness" => card.goldness&.attributes,
+        "not_now" => card.not_now&.attributes, "reactions" => card.reactions.map(&:attributes),
+        "image_id" => card.image_attachment&.blob_id,
+        "comments" => comments, "files" => files
+      ).to_json)
+    end
+  end
+end
