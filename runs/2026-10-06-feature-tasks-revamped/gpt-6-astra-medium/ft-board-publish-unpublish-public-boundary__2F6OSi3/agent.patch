+## Board Publication
+
+Only account admins (including owners) with access to the board can publish or unpublish it. Being the board's creator alone does not grant publication permission. Publishing does not change the board's account-level access settings.
+
+### `POST /:account_slug/boards/:board_id/publication`
+
+Publishes the board. No request body is required.
+
+Returns `200 OK` with the board JSON, including its `public_url`. Repeating this request preserves the existing URL.
+
+### `DELETE /:account_slug/boards/:board_id/publication`
+
+Unpublishes the board and immediately revokes its public board, column, and card URLs. Returns `204 No Content`. The board's `public_url` becomes `null`.
+
+Publishing again creates a new secret URL; the previous URL remains invalid.
+
+### Public pages
+
+Anyone with the secret key can open these read-only HTML pages without authentication:
+
+- `GET /:account_slug/public/boards/:key`
+- `GET /:account_slug/public/boards/:key/columns/:id`
+- `GET /:account_slug/public/boards/:key/cards/:number`
+
+Only published cards are exposed; drafts are never listed or accessible. Columns and cards must belong to the published board. Invalid or revoked keys return `404 Not Found`.
+
+Treat public URLs as secrets: anyone you share one with can view the board's published content.
+
 ## Board Accesses
 
 Board accesses let you see who has access to a board and their involvement level (watching or access only). Any board member can view this information.
diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..ddf5439
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admins can publish and unpublish with JSON" do
+    get board_path(@board), as: :json
+    assert response.parsed_body.key?("public_url")
+    assert_nil response.parsed_body["public_url"]
+
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    assert @board.reload.published?
+    assert_equal public_board_url(@board.publication.key), response.parsed_body["public_url"]
+
+    get boards_path, as: :json
+    assert_equal public_board_url(@board.publication.key), response.parsed_body.find { |board| board["id"] == @board.id }["public_url"]
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert_not @board.reload.published?
+
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body["public_url"]
+  end
+
+  test "HTML publication actions redirect back to settings" do
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "repeated publication requests preserve the URL and repeated revocation is safe" do
+    post board_publication_path(@board), as: :json
+    url = response.parsed_body["public_url"]
+
+    assert_no_difference "Board::Publication.count" do
+      post board_publication_path(@board), as: :json
+      assert_response :success
+      assert_equal url, response.parsed_body["public_url"]
+    end
+
+    2.times do
+      delete board_publication_path(@board), as: :json
+      assert_response :no_content
+    end
+  end
+
+  test "owners can publish boards" do
+    @board.accesses.grant_to(users(:jason))
+    logout_and_sign_in_as :jason
+    post board_publication_path(@board), as: :json
+    assert_response :success
+  end
+
+  test "publication invalidates cached board JSON" do
+    with_actionview_partial_caching do
+      get board_path(@board), as: :json
+      assert_nil response.parsed_body["public_url"]
+
+      post board_publication_path(@board), as: :json
+      assert response.parsed_body["public_url"].present?
+
+      delete board_publication_path(@board), as: :json
+      get board_path(@board), as: :json
+      assert_nil response.parsed_body["public_url"]
+    end
+  end
+
+  test "members cannot publish even when they created the board" do
+    logout_and_sign_in_as :david
+    assert_equal users(:david), @board.creator
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published?
+
+    @board.publish
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "admins cannot publish another account's board" do
+    post board_publication_path(boards(:miltons_wish_list)), as: :json
+    assert_response :not_found
+  end
+
+  test "publication requires authentication" do
+    sign_out
+    post board_publication_path(@board)
+    assert_response :redirect
+    assert_not @board.reload.published?
+  end
+
+  test "only admins see publication controls" do
+    get edit_board_path(@board)
+    assert_select "button", text: "Publish board"
+
+    logout_and_sign_in_as :david
+    get edit_board_path(@board)
+    assert_select "button", text: "Publish board", count: 0
+  end
+end
