+    end
+    get public_board_card_path(@key, @card)
+    assert_response :not_found
+
+    @column.update!(board: boards(:private))
+    get public_board_column_path(@key, @column)
+    assert_response :not_found
+  end
+
+  test "a publication key is scoped to its account" do
+    board = boards(:miltons_wish_list)
+    board.publish
+
+    get public_board_path(board.publication.key)
+    assert_response :not_found
+  end
+
+  test "invalid keys and private board IDs cannot be used as publication keys" do
