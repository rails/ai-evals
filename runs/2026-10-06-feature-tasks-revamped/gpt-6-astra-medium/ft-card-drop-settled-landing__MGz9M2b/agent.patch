diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..77b52ab
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,333 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:layout)
+    @source = columns(:writebook_triage)
+    @destination = columns(:writebook_in_progress)
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@card, :article)}", visible: :all
+    assert_selector "##{dom_id(@destination)} .cards__list", visible: :all
+  end
+
+  test "a drop moves immediately and stays in place after saving" do
+    hold_saves
+    drag_to(dom_id(@destination))
+
+    assert_card_in dom_id(@destination)
+    assert_selector "##{dom_id(@card, :article)} .card__header .card__column-name", text: @destination.name, visible: :all
+    assert_selector "##{dom_id(@card, :article)} .card__meta-text--updated", text: "today", visible: :all
+    assert_equal @source, @card.reload.column
+    assert_equal dom_id(@card, :article), card_ids(dom_id(@destination)).first
+
+    release_save
+    assert_saved_column @destination
+    assert_card_in dom_id(@destination)
+    before_reload = card_ids(dom_id(@destination))
+    page.refresh
+    assert_card_in dom_id(@destination)
+    assert_equal before_reload, card_ids(dom_id(@destination))
+  end
+
+  test "dropping in the same column does not reorder or save" do
+    hold_saves
+    original_order = card_ids(dom_id(@source))
+    drag_to(dom_id(@source))
+
+    assert_equal original_order, card_ids(dom_id(@source))
+    assert_equal 0, page.evaluate_script("window.pendingSaves.length")
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+  end
+
+  test "ordinary cards stay below golden cards and golden cards move to the front" do
+    Current.user = users(:david)
+    cards(:text).gild
+    page.refresh
+    assert_card_in dom_id(@source)
+    hold_saves
+
+    drag_to(dom_id(@destination))
+    assert_equal [ dom_id(cards(:text), :article), dom_id(@card, :article) ], card_ids(dom_id(@destination))
+    release_save
+    assert_saved_column @destination
+    page.refresh
+    assert_card_in dom_id(@destination)
+    assert_equal [ dom_id(cards(:text), :article), dom_id(@card, :article) ], card_ids(dom_id(@destination))
+
+    @card = cards(:logo)
+    hold_saves
+    drag_to(dom_id(@destination))
+    assert_equal dom_id(@card, :article), card_ids(dom_id(@destination)).first
+    release_save
+    assert_saved_column @destination
+    page.refresh
+    assert_card_in dom_id(@destination)
+    assert_equal dom_id(@card, :article), card_ids(dom_id(@destination)).first
+  end
+
+  test "cards move between every status and can reopen into a custom column" do
+    hold_saves
+    [ "closed-cards", "not-now", "maybe", "closed-cards", dom_id(@destination) ].each do |destination|
+      assert_selector "##{destination} .cards__list", visible: :all
+      drag_to(destination)
+      assert_card_in destination
+      assert_equal dom_id(@card, :article), card_ids(destination).first
+      release_save
+      assert_no_selector "##{dom_id(@card, :article)}[draggable=false]", visible: :all
+
+      case destination
+      when "closed-cards"
+        assert @card.reload.closed?
+        assert_selector "##{dom_id(@card, :article)} .card__closed-title", text: "Done", visible: :all
+      when "not-now"
+        assert @card.reload.postponed?
+        assert_selector "##{dom_id(@card, :article)}.card--postponed", visible: :all
+      when "maybe"
+        assert @card.reload.awaiting_triage?
+        assert_selector "##{dom_id(@card, :article)}.card--active", visible: :all
+        assert_no_selector "##{dom_id(@card, :article)} .card__closed", visible: :all
+      else
+        assert @card.reload.triaged?
+        assert_equal @destination, @card.column
+        assert_no_selector "##{dom_id(@card, :article)} .card__closed", visible: :all
+      end
+    end
+
+    page.refresh
+    assert_card_in dom_id(@destination)
+  end
+
+  test "empty columns accept cards and update counts and placeholders immediately" do
+    destination = columns(:writebook_on_hold)
+    destination_id = dom_id(destination)
+    source_count = count_in(dom_id(@source))
+    hold_saves
+    drag_to(destination_id)
+
+    assert_card_in destination_id
+    assert_equal 1, count_in(destination_id)
+    assert_equal source_count - 1, count_in(dom_id(@source))
+    assert_selector "##{destination_id} .blank-slate[hidden]", count: 2, visible: :all
+    release_save
+    assert_saved_column destination
+
+    drag_to("maybe")
+    assert_card_in "maybe"
+    assert_equal 0, count_in(destination_id)
+    assert_selector "##{destination_id} .blank-slate:not([hidden])", count: 2, visible: :all
+    release_save
+    assert_saved_column nil
+  end
+
+  test "failed saves restore the exact position, appearance, and counts" do
+    original_order = card_ids(dom_id(@source))
+    original_count = count_in(dom_id(@source))
+    original_class = find("##{dom_id(@card, :article)}", visible: :all)[:class]
+    hold_saves
+    drag_to("closed-cards")
+    assert_card_in "closed-cards"
+    page.execute_script "window.pendingSaves.shift().fail()"
+
+    assert_card_in dom_id(@source)
+    assert_equal original_order, card_ids(dom_id(@source))
+    assert_equal original_count, count_in(dom_id(@source))
+    assert_equal original_class, find("##{dom_id(@card, :article)}", visible: :all)[:class]
+    assert_selector "[role=alert]", text: "The card could not be moved"
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+    assert_equal @source, @card.reload.column
+  end
+
+  test "drag feedback follows the pointer and is cleared on cancellation" do
+    page.execute_script <<~JS, dom_id(@card, :article), dom_id(@destination)
+      window.draggedCard = document.getElementById(arguments[0])
+      window.draggedOverColumn = document.getElementById(arguments[1])
+      window.dragTransfer = new DataTransfer()
+      draggedCard.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer: dragTransfer }))
+      draggedOverColumn.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: dragTransfer }))
+    JS
+    assert_selector "##{dom_id(@card, :article)}.drag-and-drop__dragged-item", visible: :all
+    assert_selector "##{dom_id(@destination)}.drag-and-drop__hover-container", visible: :all
+
+    page.execute_script <<~JS
+      draggedOverColumn.dispatchEvent(new DragEvent("dragleave", { bubbles: true, relatedTarget: draggedOverColumn.querySelector("header") }))
+    JS
+    assert_selector "##{dom_id(@destination)}.drag-and-drop__hover-container", visible: :all
+
+    page.execute_script <<~JS
+      draggedOverColumn.dispatchEvent(new DragEvent("dragleave", { bubbles: true, relatedTarget: document.body }))
+      draggedCard.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer: dragTransfer }))
+    JS
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+    assert_card_in dom_id(@source)
+  end
+
+  test "external drags are ignored" do
+    hold_saves
+    page.execute_script <<~JS, dom_id(@destination)
+      const destination = document.getElementById(arguments[0])
+      const dataTransfer = new DataTransfer()
+      dataTransfer.setData("text/plain", "Not a board card")
+      destination.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+      destination.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+    JS
+    assert_equal 0, page.evaluate_script("window.pendingSaves.length")
+    assert_no_selector ".drag-and-drop__hover-container", visible: :all
+    assert_card_in dom_id(@source)
+  end
+
+  test "a card can be dragged with the mouse into a collapsed column" do
+    find("##{dom_id(@source)} .cards__expander").click
+    card = find("##{dom_id(@card, :article)}[draggable=true]")
+    card.drag_to(find("##{dom_id(@destination)} .cards__expander"))
+
+    assert_card_in dom_id(@destination)
+    assert_saved_column @destination
+  end
+
+  test "network errors restore the card and allow retrying" do
+    hold_saves
+    drag_to(dom_id(@destination))
+    assert_card_in dom_id(@destination)
+    page.execute_script "window.pendingSaves.shift().disconnect()"
+
+    assert_card_in dom_id(@source)
+    assert_selector "[role=alert]", text: "The card could not be moved"
+    drag_to(dom_id(@destination))
+    assert_card_in dom_id(@destination)
+    release_save
+    assert_saved_column @destination
+  end
+
+  test "a pending card cannot start a second move" do
+    hold_saves
+    drag_to(dom_id(@destination))
+    assert_card_in dom_id(@destination)
+    page.execute_script <<~JS, dom_id(@card, :article)
+      const card = document.getElementById(arguments[0])
+      const dataTransfer = new DataTransfer()
+      card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+      document.getElementById("maybe").dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+    JS
+
+    assert_card_in dom_id(@destination)
+    assert_equal 1, page.evaluate_script("window.pendingSaves.length")
+    release_save
+    assert_saved_column @destination
+  end
+
+  test "saving does not replace the optimistically moved card" do
+    assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    hold_saves
+    drag_to(dom_id(@destination))
+    assert_card_in dom_id(@destination)
+    page.execute_script "window.movedCard = document.getElementById(arguments[0])", dom_id(@card, :article)
+    release_save
+    assert_saved_column @destination
+    assert_no_selector "##{dom_id(@card, :article)}[draggable=false]", visible: :all
+
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    assert_card_in dom_id(@destination)
+    assert page.evaluate_script("window.movedCard === document.getElementById(arguments[0])", dom_id(@card, :article))
+    assert_equal dom_id(@card, :article), card_ids(dom_id(@destination)).first
+  end
+
+  test "cards remain draggable after a Turbo morph" do
+    assert_selector "##{dom_id(@card, :article)}[draggable=true]", visible: :all
+    page.execute_script <<~JS, dom_id(@card, :article)
+      const card = document.getElementById(arguments[0])
+      const contents = card.parentElement.cloneNode(true)
+      contents.querySelectorAll("[draggable]").forEach(element => element.removeAttribute("draggable"))
+      Turbo.morphChildren(card.parentElement, contents)
+    JS
+    assert_selector "##{dom_id(@card, :article)}[draggable=true]", visible: :all
+    hold_saves
+    drag_to(dom_id(@destination))
+    assert_card_in dom_id(@destination)
+    release_save
+    assert_saved_column @destination
+  end
+
+  test "successive drops appear immediately and save in drop order" do
+    hold_saves
+    first_card = @card
+    drag_to(dom_id(@destination))
+    assert_card_in dom_id(@destination)
+
+    @card = cards(:shipping)
+    drag_to(dom_id(@destination))
+    assert_card_in dom_id(@destination)
+    assert_equal [ dom_id(@card, :article), dom_id(first_card, :article) ], card_ids(dom_id(@destination)).first(2)
+    assert_equal 1, page.evaluate_script("window.pendingSaves.length")
+
+    release_save
+    assert_no_selector "##{dom_id(first_card, :article)}[draggable=false]", visible: :all
+    release_save
+    assert_saved_column @destination
+    page.refresh
+    assert_card_in dom_id(@destination)
+    assert_equal [ dom_id(@card, :article), dom_id(first_card, :article) ], card_ids(dom_id(@destination)).first(2)
+  end
+
+  private
+
+
+
+    def count_in(column_id)
+      find("##{column_id} [data-drag-and-drop-count]", visible: :all)["data-drag-and-drop-count"].to_i
+    end
+
+
+    def hold_saves
+      page.execute_script <<~JS
+        window.pendingSaves = []
+        const originalFetch = window.fetch
+        window.fetch = (url, options) => {
+          if (options && ["POST", "DELETE"].includes(options.method) && url.toString().includes("/cards/")) {
+            return new Promise((resolve, reject) => {
+              window.pendingSaves.push({
+                release: () => originalFetch(url, options).then(resolve, reject),
+                fail: () => resolve(new Response(null, { status: 422 })),
+                disconnect: () => reject(new TypeError("Network error"))
+              })
+            })
+          }
+          return originalFetch(url, options)
+        }
+      JS
+    end
+
+    def drag_to(column_id)
+      assert_selector "##{column_id} .cards__list", visible: :all
+      assert_selector "##{dom_id(@card, :article)}[draggable=true]", visible: :all
+      page.execute_script <<~JS, dom_id(@card, :article), column_id
+        const card = document.getElementById(arguments[0])
+        const column = document.getElementById(arguments[1])
+        const dataTransfer = new DataTransfer()
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+      JS
+    end
+
+    def assert_card_in(column_id)
+      assert_selector "##{column_id} ##{dom_id(@card, :article)}", visible: :all
+    end
+
+    def card_ids(column_id)
+      page.all("##{column_id} [data-drag-and-drop-target~=card]", visible: :all).map { |card| card[:id] }
+    end
+
+    def release_save
+      page.execute_script "window.pendingSaves.shift().release()"
+    end
+
+    def assert_saved_column(column)
+      Timeout.timeout(Capybara.default_max_wait_time) do
+        sleep 0.01 until @card.reload.column == column
+      end
+    end
+end
