diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..3cb7de7
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,227 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "card", "container", "empty", "stamp", "error" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  initialize() {
+    this.pendingCards = new Set()
+    this.saveQueue = Promise.resolve()
+  }
+
+  disconnect() {
+    this.end()
+  }
+
+  cardTargetConnected(card) {
+    card.draggable = !this.pendingCards.has(card.id)
+  }
+
+  preserveDraggable(event) {
+    if (event.detail.attributeName === "draggable" && this.cardTargets.includes(event.target)) {
+      event.preventDefault()
+    }
+  }
+
+  start(event) {
+    const card = event.target.closest('[data-drag-and-drop-target~="card"]')
+    if (!card || !this.cardTargets.includes(card) || this.pendingCards.has(card.id)) {
+      event.preventDefault()
+      return
+    }
+
+    this.draggedCard = card
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+    card.classList.add(this.draggedItemClass)
+    this.errorTarget.hidden = true
+  }
+
+  over(event) {
+    const container = this.#destination(event.target)
+    this.#highlight(container)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (this.hoveredContainer && !this.hoveredContainer.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  async drop(event) {
+    const destination = this.#destination(event.target)
+    const card = this.draggedCard
+    this.end()
+    if (!destination || !card) return
+
+    event.preventDefault()
+    const source = this.#containerFor(card)
+    const original = card.cloneNode(true)
+    const parent = card.parentNode
+    const nextSibling = card.nextSibling
+
+    this.pendingCards.add(card.id)
+    card.draggable = false
+    this.#insert(card, destination)
+    this.#updateCard(card, destination)
+    this.#updateContainer(source, -1)
+    this.#updateContainer(destination, 1)
+
+    try {
+      const response = await this.#save(card, destination)
+      if (!response.ok) throw new Error("Unable to move card")
+    } catch {
+      if (this.element.isConnected && card.isConnected) {
+        card.remove()
+        parent.insertBefore(original, nextSibling?.parentNode === parent ? nextSibling : null)
+        this.#updateContainer(source, 1)
+        this.#updateContainer(destination, -1)
+        this.errorTarget.querySelector(".flash__inner").textContent = "The card could not be moved. Please try again."
+        this.errorTarget.hidden = false
+      }
+    } finally {
+      this.pendingCards.delete(card.id)
+      card.draggable = true
+      original.draggable = true
+    }
+  }
+
+  end() {
+    this.draggedCard?.classList.remove(this.draggedItemClass)
+    this.draggedCard = null
+    this.#highlight(null)
+  }
+
+  #destination(target) {
+    if (!this.draggedCard) return null
+
+    const container = this.#containerFor(target)
+    if (container && container !== this.#containerFor(this.draggedCard) && container.querySelector(".cards__list")) {
+      return container
+    }
+  }
+
+  #containerFor(element) {
+    const container = element.closest('[data-drag-and-drop-target~="container"]')
+    return this.containerTargets.includes(container) ? container : null
+  }
+
+  #highlight(container) {
+    this.hoveredContainer?.classList.remove(this.hoverContainerClass)
+    this.hoveredContainer = container
+    this.hoveredContainer?.classList.add(this.hoverContainerClass)
+  }
+
+  #insert(card, container) {
+    const list = container.querySelector(".cards__list")
+    const cards = Array.from(list.querySelectorAll('[data-drag-and-drop-target~="card"]'))
+    const goldenFirst = [ "column", "maybe" ].includes(container.dataset.dragAndDropStatus)
+
+    // Moving records activity: the card becomes newest in its priority group.
+    // The pointer position never changes a column's own ordering.
+    const nextCard = goldenFirst && !card.classList.contains("golden-effect") ?
+      cards.find(candidate => !candidate.classList.contains("golden-effect")) : cards[0]
+
+    if (nextCard) {
+      nextCard.before(card)
+    } else if (cards.length) {
+      cards[cards.length - 1].after(card)
+    } else {
+      const page = list.querySelector('turbo-frame[role="presentation"]') || list
+      page.prepend(card)
+    }
+  }
+
+  #updateCard(card, container) {
+    const status = container.dataset.dragAndDropStatus
+    const active = [ "column", "maybe" ].includes(status)
+    card.classList.toggle("card--active", active)
+    card.classList.toggle("card--postponed", status === "not-now")
+    card.querySelector(".card__closed")?.remove()
+    card.querySelector(".card__header > .card__column-name")?.remove()
+    card.querySelector(".bubble")?.remove()
+    card.querySelector(".card__meta-text--updated time")?.setAttribute("datetime", Math.floor(Date.now() / 1000))
+
+    if (status !== "closed") {
+      card.style.setProperty("--card-color", container.dataset.dragAndDropColor || "var(--color-card-default)")
+      card.querySelectorAll(".card__stages [data-column-id]").forEach(stage => {
+        stage.classList.toggle("card__column-name--current", stage.dataset.columnId === container.dataset.dragAndDropColumnId)
+      })
+    }
+
+    if (status === "column") {
+      const label = document.createElement("span")
+      label.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+      const name = document.createElement("span")
+      name.className = "overflow-ellipsis"
+      name.textContent = container.dataset.columnName
+      label.append(name)
+      card.querySelector(".card__header").append(label)
+    } else if (!active) {
+      const stamp = this.stampTarget.content.firstElementChild.cloneNode(true)
+      const title = stamp.querySelector(".card__closed-title")
+      title.textContent = container.dataset.columnName
+      title.dataset.text = title.textContent
+      card.querySelector(".card__body").append(stamp)
+    }
+
+    if (status === "closed") {
+      delete card.dataset.cardNotNowUrl
+      delete card.dataset.cardClosureUrl
+      delete card.dataset.action
+    } else {
+      card.dataset.cardNotNowUrl = card.dataset.dragAndDropNotNowUrl
+      card.dataset.cardClosureUrl = card.dataset.dragAndDropClosureUrl
+      card.dataset.action = "mouseenter->navigable-list#hoverSelect"
+    }
+  }
+
+  #updateContainer(container, delta) {
+    const counter = container.querySelector("[data-drag-and-drop-count]")
+    const count = Math.max(0, Number(counter.dataset.dragAndDropCount) + delta)
+    counter.dataset.dragAndDropCount = count
+    counter.textContent = count > 99 ? "99+" : count
+
+    const list = container.querySelector(".cards__list")
+    const cards = list.querySelectorAll('[data-drag-and-drop-target~="card"]')
+    container.querySelector(".cards__expander").style.setProperty("--card-count", Math.min(cards.length, 15))
+    const empty = cards.length === 0
+    if (empty && !list.querySelector(".blank-slate")) {
+      list.append(this.emptyTarget.content.cloneNode(true))
+    }
+    list.querySelectorAll(".blank-slate").forEach(placeholder => placeholder.hidden = !empty)
+  }
+
+  #save(card, container) {
+    const status = container.dataset.dragAndDropStatus
+    const options = { responseKind: "json" }
+    let method = "post"
+    let url
+
+    if (status === "closed") {
+      url = card.dataset.dragAndDropClosureUrl
+    } else if (status === "not-now") {
+      url = card.dataset.dragAndDropNotNowUrl
+    } else {
+      url = card.dataset.dragAndDropTriageUrl
+      if (status === "maybe") {
+        method = "delete"
+      } else {
+        options.body = { column_id: container.dataset.dragAndDropColumnId }
+      }
+    }
+
+    // request.js uses Turbo.fetch, which suppresses our own broadcast refresh.
+    const request = new FetchRequest(method, url, options)
+    // Preserve drop order even when several cards are moved before a save finishes.
+    const response = this.saveQueue.then(() => request.perform())
+    this.saveQueue = response.catch(() => {})
+    return response
+  }
+}
