diff --git a/app/javascript/initializers/locale.js b/app/javascript/initializers/locale.js
new file mode 100644
index 0000000..6000e33
--- /dev/null
+++ b/app/javascript/initializers/locale.js
@@ -0,0 +1,12 @@
+import { Turbo } from "@hotwired/turbo-rails"
+import { locale } from "helpers/i18n"
+
+let previousLocale = locale()
+
+// Turbo retains the document element and can otherwise restore old-language snapshots.
+document.addEventListener("turbo:load", () => {
+  const currentLocale = locale()
+  if (currentLocale !== previousLocale) Turbo.cache.clear()
+  document.documentElement.lang = currentLocale
+  previousLocale = currentLocale
+})
