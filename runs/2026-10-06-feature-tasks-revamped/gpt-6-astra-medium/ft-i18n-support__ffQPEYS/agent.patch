diff --git a/app/javascript/helpers/i18n.js b/app/javascript/helpers/i18n.js
new file mode 100644
index 0000000..8a3ad59
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,19 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+export function locale() {
+  return getMetaContent("locale") || "en"
+}
+
+export function dateLocale() {
+  return locale() === "en" ? "en-US" : locale()
+}
+
+export function translate(key, values = {}) {
+  const messages = JSON.parse(getMetaContent("translations") || "{}")
+  let message = key.split(".").reduce((value, part) => value?.[part], messages)
+  if (typeof message === "object") {
+    message = message[values.count === 1 ? "one" : "other"] || message.other
+  }
+  if (typeof message !== "string") throw new Error(`Missing translation: ${key}`)
+  return message.replace(/%\{(\w+)\}/g, (_, name) => String(values[name]))
+}
