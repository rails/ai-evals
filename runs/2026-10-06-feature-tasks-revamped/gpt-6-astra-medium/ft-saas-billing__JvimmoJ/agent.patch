diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..e5ec7d8
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,17 @@
+class Stripe::WebhooksController < ActionController::Base
+  # Stripe authenticates requests with its signature, not a browser session.
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+
+    if event.type.in?(%w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ])
+      subscription = Account::Subscription.find_by!(stripe_customer_id: event.data.object.customer)
+      subscription.apply_stripe_event(event)
+    end
+
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..3ba8603
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,57 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :overridden_limit, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+  end
+
+  def billing_plan
+    if subscription&.active?
+      Account::Plan.find(subscription.plan_key) || Account::Plan.new("free")
+    elsif comped?
+      Account::Plan.new("unlimited")
+    else
+      Account::Plan.new("free")
+    end
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def comped=(value)
+    ActiveModel::Type::Boolean.new.cast(value) ? comp : uncomp
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards.published.count
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def cards_remaining
+    [ billing_plan.card_limit - card_count, 0 ].max if billing_plan.card_limit
+  end
+
+  def exceeding_card_limit?
+    !comped? && cards_remaining == 0
+  end
+
+  def nearing_card_limit?
+    remaining = cards_remaining
+    !comped? && remaining.present? && remaining.between?(1, 100)
+  end
+end
