diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..19ec630
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,40 @@
+class Account::Plan
+  PLANS = {
+    "free" => { name: "Free", price: 0, card_limit: 1000, storage_limit: 1.gigabyte },
+    "unlimited" => { name: "Unlimited", price: 20, card_limit: nil, storage_limit: 5.gigabytes,
+      price_variable: "STRIPE_MONTHLY_V1_PRICE_ID" },
+    "unlimited_plus" => { name: "Unlimited+", price: 25, card_limit: nil, storage_limit: 500.gigabytes,
+      price_variable: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" }
+  }.freeze
+
+  attr_reader :key
+
+  def self.find(key)
+    new(key) if PLANS.key?(key)
+  end
+
+  def self.paid
+    [ new("unlimited"), new("unlimited_plus") ]
+  end
+
+  def self.for_price(price_id)
+    paid.find { |plan| ENV[plan.attributes[:price_variable]].present? && ENV[plan.attributes[:price_variable]] == price_id }
+  end
+
+  def initialize(key)
+    @key = key
+  end
+
+  def attributes
+    PLANS.fetch(key)
+  end
+
+  def name = attributes[:name]
+  def price = attributes[:price]
+  def card_limit = attributes[:card_limit]
+  def storage_limit = attributes[:storage_limit]
+
+  def stripe_price_id
+    ENV.fetch(attributes.fetch(:price_variable))
+  end
+end
