@@ -0,0 +1,16 @@
+module Card::CardLimited
+  extend ActiveSupport::Concern
+
+  private
+    def within_card_limit
+      # Serialize publishing and API creation so concurrent requests cannot take
+      # the last free card twice. Draft creation remains unrestricted.
+      Current.account.with_lock do
+        if Current.account.exceeding_card_limit?
+          head :forbidden
+        else
+          yield
+        end
+      end
+    end
+end
