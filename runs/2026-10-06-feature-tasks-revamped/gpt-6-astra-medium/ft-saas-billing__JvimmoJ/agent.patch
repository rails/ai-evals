+require "test_helper"
+
+class CardLimitsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @account = accounts(:"37s")
+    @override = @account.create_overridden_limit!(card_count: 1000)
+  end
+
+  test "drafting is allowed at the limit but API creation and publishing are forbidden" do
+    assert_difference -> { Card.drafted.count }, 1 do
+      post board_cards_path(boards(:writebook))
+      assert_response :redirect
+    end
+    draft = Card.last
+
+    assert_no_difference -> { Card.published.count } do
+      post card_publish_path(draft)
+      assert_response :forbidden
+      post board_cards_path(boards(:writebook)), params: { card: { title: "Over quota" } }, as: :json
+      assert_response :forbidden
+    end
+    assert draft.reload.drafted?
+
+    get card_draft_path(draft)
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select "button span", text: "Create card", count: 0
+  end
+
+  test "warning counts down from 100 cards and disappears on paid plans" do
+    draft = boards(:writebook).cards.create!(status: :drafted, creator: users(:kevin))
+    @override.update!(card_count: 950)
+    get card_draft_path(draft)
+    assert_response :success
+    assert_select "[role=status]", text: "50 cards left"
+
+    @account.create_subscription!(stripe_customer_id: "cus_paid", plan_key: "unlimited", status: "active")
+    get card_draft_path(draft)
+    assert_select "[role=status]", text: /cards left/, count: 0
+    post card_publish_path(draft)
+    assert_response :redirect
+    assert draft.reload.published?
+  end
+
+  test "account settings show admins their plan and upgrade" do
+    get account_settings_path
+    assert_response :success
+    assert_select "h2", text: "Your plan: Free"
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "members see an upgrade explanation but cannot manage billing" do
+    logout_and_sign_in_as :jz
+    get account_settings_path
+    assert_response :success
+    assert_select "h2", text: "Your plan: Free", count: 0
+    get root_path
+    assert_response :success
+    assert_match "Ask an account admin", response.body
+  end
+
+  test "the last free card can be published but not the next one" do
+    @override.destroy!
+    template = cards(:logo).attributes.except("id", "number")
+    Card.insert_all! Array.new(999 - @account.cards.published.count) { |index|
+      template.merge("id" => ActiveRecord::Type::Uuid.generate, "number" => 100 + index)
+    }
+    @account.update!(cards_count: 2000)
+
+    post board_cards_path(boards(:writebook)), params: { card: { title: "Last free card" } }, as: :json
+    assert_response :created
+    assert_equal 1000, @account.reload.card_count
+    post board_cards_path(boards(:writebook)), params: { card: { title: "One too many" } }, as: :json
+    assert_response :forbidden
+    assert_equal 1000, @account.reload.card_count
+  end
+
+  test "other accounts are not affected" do
+    logout_and_sign_in_as :mike
+    accounts(:initech).update!(cards_count: 100)
+    post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug), params: { card: { title: "Allowed" } }, as: :json
+    assert_response :created
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..2d644ce
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  teardown do
+    WebMock.allow_net_connect!
+  end
+
+  setup do
+    WebMock.disable_net_connect!
+    Stripe::WebhooksController.stubs(:allow_forgery_protection).returns(true)
+    @subscription = accounts(:"37s").create_subscription!(stripe_customer_id: "cus_webhook")
+    ENV.stubs(:fetch).with("STRIPE_WEBHOOK_SECRET").returns("whsec_offline")
+    Account::Plan.stubs(:for_price).with("price_unlimited").returns(Account::Plan.new("unlimited"))
+    Account::Plan.stubs(:for_price).with("price_plus").returns(Account::Plan.new("unlimited_plus"))
+  end
+
+  test "signed events activate, change and cancel a subscription without logging in" do
+    deliver_event("evt_create", 10, "customer.subscription.created")
+    assert_response :success
+    assert_equal "unlimited", @subscription.reload.plan_key
+    assert_equal 5.gigabytes, @subscription.account.storage_limit
+    deliver_event("evt_update", 20, "customer.subscription.updated", price: "price_plus")
+    assert_response :success
+    assert_equal "unlimited_plus", @subscription.reload.plan_key
+    assert_equal 500.gigabytes, @subscription.account.reload.storage_limit
+    deliver_event("evt_delete", 30, "customer.subscription.deleted")
+    assert_response :success
+    assert_equal "canceled", @subscription.reload.status
+    assert_equal 1.gigabyte, @subscription.account.reload.storage_limit
+  end
+
+  test "duplicates and stale events cannot undo a newer change" do
+    deliver_event("evt_update", 20, "customer.subscription.updated", price: "price_plus")
+    deliver_event("evt_update", 20, "customer.subscription.updated", price: "price_plus")
+    deliver_event("evt_old", 10, "customer.subscription.updated")
+    assert_equal "unlimited_plus", @subscription.reload.plan_key
+  end
+
+  test "a replay from the same second cannot undo a later delivered update" do
+    deliver_event("evt_first", 20, "customer.subscription.updated")
+    deliver_event("evt_second", 20, "customer.subscription.updated", price: "price_plus")
+    deliver_event("evt_first", 20, "customer.subscription.updated")
+    assert_equal "unlimited_plus", @subscription.reload.plan_key
+    assert_equal 2, @subscription.events.count
+  end
+
+  test "a delayed cancellation of the previous subscription does not cancel its replacement" do
+    deliver_event("evt_new", 20, "customer.subscription.created", subscription_id: "sub_new")
+    deliver_event("evt_delete_old", 30, "customer.subscription.deleted", subscription_id: "sub_old")
+    assert_equal "sub_new", @subscription.reload.stripe_subscription_id
+    assert @subscription.active?
+  end
+
+  test "unrelated events are acknowledged without changing billing" do
+    deliver_event("evt_invoice", 10, "invoice.paid")
+    assert_response :success
+    assert_nil @subscription.reload.plan_key
+  end
+
+  test "bad signatures do not change billing" do
+    untenanted do
+      post saas.stripe_webhooks_path, params: "{}", headers: { "Stripe-Signature" => "invalid", "Content-Type" => "application/json" }
+    end
+    assert_response :bad_request
+    assert_nil @subscription.reload.plan_key
+  end
+
+  private
+    def deliver_event(id, created, type, price: "price_unlimited", subscription_id: "sub_test")
+      payload = { id: id, created: created, type: type, data: { object: {
+        id: subscription_id, customer: "cus_webhook", status: "active", cancel_at: nil,
+        items: { data: [ { price: { id: price }, current_period_end: 2_000_000_000 } ] }
+      } } }.to_json
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, "whsec_offline")
+      header = Stripe::Webhook::Signature.generate_header(timestamp, signature)
+      untenanted do
+        post saas.stripe_webhooks_path, params: payload, headers: { "Stripe-Signature" => header, "Content-Type" => "application/json" }
+      end
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..e9c34d0
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan and warning boundaries" do
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+    override = @account.create_overridden_limit!(card_count: 899)
+    assert_not @account.nearing_card_limit?
+    override.update!(card_count: 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+    override.update!(card_count: 950)
+    assert_equal 50, @account.cards_remaining
+    override.update!(card_count: 1000)
+    assert @account.exceeding_card_limit?
+    override.update!(card_count: 1001)
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "drafts do not consume cards" do
+    with_current_user :mike do
+      assert_no_difference -> { @account.card_count } do
+        @account.boards.first.cards.create!(status: :drafted, number: 9999, creator: users(:mike))
+      end
+    end
+  end
+
+  test "paid plans bring storage and unlimited cards" do
+    @account.create_overridden_limit!(card_count: 2000)
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_test", plan_key: "unlimited", status: "active")
+    assert_not @account.exceeding_card_limit?
+    assert_equal 5.gigabytes, @account.storage_limit
+    subscription.update!(plan_key: "unlimited_plus")
+    assert_equal 500.gigabytes, @account.storage_limit
+    subscription.update!(status: "canceled")
+    assert @account.exceeding_card_limit?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "zero usage overrides are honored and blank values fall back to actual usage" do
+    override = @account.create_overridden_limit!(card_count: 0, bytes_used: 0)
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+    override.update!(card_count: "", bytes_used: "")
+    assert_equal @account.cards.published.count, @account.card_count
+    assert_equal @account.storage_total&.bytes_stored || 0, @account.bytes_used
+  end
+
+  test "comp and usage overrides can be removed without altering usage" do
+    actual = @account.bytes_used
+    @account.create_overridden_limit!(card_count: 1000, bytes_used: 2.gigabytes)
+    assert @account.exceeding_storage_limit?
+    @account.comp
+    assert_not @account.exceeding_card_limit?
+    @account.uncomp
+    assert @account.exceeding_card_limit?
+    @account.overridden_limit.destroy!
+    @account.reload
+    assert_equal actual, @account.bytes_used
+    assert_not @account.exceeding_storage_limit?
+  end
+end
