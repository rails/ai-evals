diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..99e7701
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,68 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+  has_many :events, class_name: "Account::SubscriptionEvent", dependent: :delete_all
+
+  def active?
+    status.in?(%w[ active trialing past_due ])
+  end
+
+  def checkout_url(plan, success_url:, cancel_url:)
+    with_lock do
+      ensure_stripe_customer
+      if stripe_subscription_id.present? && !status.in?(%w[ canceled incomplete_expired ])
+        portal_url(return_url: cancel_url)
+      else
+        Stripe::Checkout::Session.create({
+          mode: "subscription", customer: stripe_customer_id,
+          line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+          success_url: success_url, cancel_url: cancel_url,
+          client_reference_id: account_id,
+          subscription_data: { metadata: { account_id: account_id } }
+        }, stripe_options).url
+      end
+    end
+  end
+
+  def portal_url(return_url:)
+    Stripe::BillingPortal::Session.create({ customer: stripe_customer_id, return_url: return_url }, stripe_options).url
+  end
+
+  def apply_stripe_event(event)
+    with_lock do
+      if event.created >= last_event_created && !events.exists?(stripe_event_id: event.id)
+        object = event.data.object
+        # A delayed deletion of an old subscription must not cancel its replacement.
+        if event.type == "customer.subscription.deleted" && stripe_subscription_id.present? && stripe_subscription_id != object.id
+          return
+        end
+
+        item = object.items.data.first
+        plan = Account::Plan.for_price(item&.price&.id)
+        update! stripe_subscription_id: object.id,
+          status: event.type == "customer.subscription.deleted" ? "canceled" : object.status,
+          plan_key: plan&.key,
+          current_period_end: timestamp(object[:current_period_end] || item&.[](:current_period_end)),
+          cancel_at: timestamp(object[:cancel_at]),
+          last_event_created: event.created
+        events.create! stripe_event_id: event.id
+      end
+    end
+  end
+
+  private
+    def ensure_stripe_customer
+      if stripe_customer_id.blank?
+        customer = Stripe::Customer.create({ email: account.owner_email, name: account.name,
+          metadata: { account_id: account_id } }, stripe_options.merge(idempotency_key: "fizzy-account-#{account_id}"))
+        update! stripe_customer_id: customer.id
+      end
+    end
+
+    def stripe_options
+      { api_key: ENV.fetch("STRIPE_SECRET_KEY") }
+    end
+
+    def timestamp(value)
+      Time.at(value) if value
+    end
+end
