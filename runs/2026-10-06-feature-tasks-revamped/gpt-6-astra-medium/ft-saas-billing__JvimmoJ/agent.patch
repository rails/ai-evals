diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..3f1d6b2
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  test "only entitled statuses grant paid allowances" do
+    subscription = accounts(:initech).create_subscription!(stripe_customer_id: "cus_status", plan_key: "unlimited_plus")
+    %w[ active trialing past_due ].each do |status|
+      subscription.update!(status: status)
+      assert_equal 500.gigabytes, subscription.account.storage_limit
+    end
+    %w[ canceled unpaid paused incomplete incomplete_expired ].each do |status|
+      subscription.update!(status: status)
+      assert_equal 1.gigabyte, subscription.account.storage_limit
+    end
+  end
+
+  test "scheduled cancellation retains paid allowance until Stripe cancels it" do
+    subscription = accounts(:initech).create_subscription!(stripe_customer_id: "cus_cancel", plan_key: "unlimited", status: "active", cancel_at: 1.day.from_now)
+    assert_equal 5.gigabytes, subscription.account.storage_limit
+  end
+
+  test "price lookup recognizes only configured paid prices" do
+    ENV.stubs(:[]).with("STRIPE_MONTHLY_V1_PRICE_ID").returns("price_unlimited")
+    ENV.stubs(:[]).with("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID").returns("price_plus")
+    assert_equal "unlimited", Account::Plan.for_price("price_unlimited").key
+    assert_equal "unlimited_plus", Account::Plan.for_price("price_plus").key
+    assert_nil Account::Plan.for_price("price_unknown")
+    assert_nil Account::Plan.for_price(nil)
+  end
+end
