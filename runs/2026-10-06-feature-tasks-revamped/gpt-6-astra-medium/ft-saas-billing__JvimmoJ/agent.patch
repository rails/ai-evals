+class Admin::Accounts::OverriddenLimitsController < AdminController
+  def create
+    account = Account.find(params[:account_id])
+    override = account.overridden_limit || account.build_overridden_limit
+    if override.update(params.expect(overridden_limit: [ :card_count, :bytes_used ]))
+      redirect_to saas.admin_account_path(account)
+    else
+      render plain: override.errors.full_messages.to_sentence, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    account = Account.find(params[:account_id])
+    account.overridden_limit&.destroy!
+    redirect_to saas.admin_account_path(account)
+  end
+end
