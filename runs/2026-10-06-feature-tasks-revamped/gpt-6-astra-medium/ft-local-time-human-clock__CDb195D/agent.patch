+++ b/test/helpers/bridge_helper_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class BridgeHelperTest < ActionView::TestCase
+  test "card share buttons send raw timestamps for the browser to format" do
+    card = cards(:logo)
+    button = Nokogiri::HTML.fragment(bridged_share_url_button(card: card)).at_css("button")
+    data = JSON.parse(button["data-bridge-share-card"])
+
+    assert_equal card.created_at.iso8601, data["created_at"]
+    assert_equal card.last_active_at.iso8601, data["updated_at"]
+    assert_equal card.creator.familiar_name, data["author"]
+    assert_nil button["data-bridge-share-description"]
+  end
+
+  test "board share descriptions are preserved" do
+    button = Nokogiri::HTML.fragment(bridged_share_url_button("3 open cards")).at_css("button")
+
+    assert_equal "3 open cards", button["data-bridge-share-description"]
+    assert_nil button["data-bridge-share-card"]
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..9d4af3c
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "timestamps contain raw ISO data instead of server formatted text" do
+    time = Time.utc(2025, 9, 12, 20, 42)
+
+    assert_dom_equal %(<time datetime="2025-09-12T20:42:00Z" data-controller="local-time" data-local-time-format-value="relative">2025-09-12T20:42:00Z</time>), local_time_tag(time)
+  end
+
+  test "format and HTML options are preserved" do
+    html = local_time_tag(Time.utc(2025, 9, 12), format: :date, class: "timestamp")
+
+    assert_dom_equal %(<time datetime="2025-09-12T00:00:00Z" class="timestamp" data-controller="local-time" data-local-time-format-value="date">2025-09-12T00:00:00Z</time>), html
+  end
+
+  test "existing data attributes are preserved without mutating the options" do
+    data = { controller: "another-controller", custom: "value" }
+    html = Nokogiri::HTML.fragment(local_time_tag(Time.utc(2025), data: data)).at_css("time")
+
+    assert_equal "another-controller local-time", html["data-controller"]
+    assert_equal "value", html["data-custom"]
+    assert_equal({ controller: "another-controller", custom: "value" }, data)
+  end
+
+  test "relative markup is independent of the current date" do
+    time = Time.utc(2025, 9, 12, 20, 42)
+    original = local_time_tag(time)
+
+    travel_to time + 3.days do
+      assert_equal original, local_time_tag(time)
+    end
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..6c075be
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,109 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    visit new_session_path(script_name: nil)
+  end
+
+  test "relative times use the viewer's calendar day" do
+    now = "2025-09-17T22:42:00Z"
+
+    assert_equal "1:42 PM", format_date("2025-09-17T20:42:00Z", now: now)
+    assert_equal "yesterday", format_date("2025-09-17T06:00:00Z", now: now)
+    assert_equal "5 days ago", format_date("2025-09-12T20:42:00Z", now: now)
+    assert_equal "Sep 10", format_date("2025-09-10T20:42:00Z", now: now)
+    assert_equal "Sep 10, 2024", format_date("2024-09-10T20:42:00Z", now: now)
+    assert_equal "tomorrow", format_date("2025-09-18T08:00:00Z", now: now)
+    assert_equal "in 3 days", format_date("2025-09-20T20:42:00Z", now: now)
+    assert_equal "today", format_date(now, format: "relative-date", now: now)
+  end
+
+  test "the same cached timestamp renders differently in different timezones" do
+    timestamp = "2025-09-17T01:42:00Z"
+
+    assert_equal "6:42 PM", format_date(timestamp, format: "time")
+    assert_equal "Sep 16, 2025", format_date(timestamp, format: "date-with-year")
+
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "Asia/Tokyo")
+
+    assert_equal "10:42 AM", format_date(timestamp, format: "time")
+    assert_equal "Sep 17, 2025", format_date(timestamp, format: "date-with-year")
+  end
+
+  test "relative days cross DST, month, and year boundaries" do
+    assert_equal "yesterday", format_date("2025-03-09T08:30:00Z", now: "2025-03-10T07:15:00Z")
+    assert_equal "yesterday", format_date("2025-11-02T07:30:00Z", now: "2025-11-03T08:15:00Z")
+    assert_equal "tomorrow", format_date("2026-01-01T08:30:00Z", now: "2026-01-01T07:30:00Z")
+    assert_equal "in 3 days", format_date("2025-03-11T07:30:00Z", now: "2025-03-08T08:30:00Z")
+    assert_equal "Sep 12, 2025", format_date("2025-09-12", format: "date-with-year")
+  end
+
+  test "Stimulus renders new and reconnected timestamps with a local tooltip" do
+    page.execute_script <<~JS
+      document.body.insertAdjacentHTML("beforeend", '<time id="local-timestamp" datetime="2025-09-17T01:42:00Z" data-controller="local-time" data-local-time-format-value="time">2025-09-17T01:42:00Z</time>')
+    JS
+
+    assert_selector "#local-timestamp", text: "6:42 PM"
+    assert_equal "September 16, 2025 at 6:42 PM", find("#local-timestamp")[:title]
+
+    page.execute_script "window.timestamp = document.querySelector('#local-timestamp'); window.timestamp.remove()"
+    assert_no_selector "#local-timestamp"
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "Asia/Tokyo")
+    page.execute_script "document.body.append(window.timestamp)"
+
+    assert_selector "#local-timestamp", text: "10:42 AM"
+  end
+
+  test "relative labels refresh at midnight and timers are cleared on disconnect" do
+    page.execute_script <<~JS
+      const OriginalDate = window.Date
+      window.testNow = "2025-09-18T06:59:00Z"
+      window.Date = class extends OriginalDate {
+        constructor(...args) { super(...(args.length ? args : [window.testNow])) }
+        static now() { return new OriginalDate(window.testNow).getTime() }
+      }
+      const originalSetInterval = window.setInterval
+      const originalClearInterval = window.clearInterval
+      window.setInterval = (callback, delay) => {
+        const timer = originalSetInterval(callback, delay)
+        if (delay === 60_000) {
+          window.refreshTimestamp = callback
+          window.timestampTimer = timer
+        }
+        return timer
+      }
+      window.clearInterval = (timer) => {
+        if (timer === window.timestampTimer) window.timestampTimerCleared = true
+        originalClearInterval(timer)
+      }
+      document.body.insertAdjacentHTML("beforeend", '<time id="refreshing-timestamp" datetime="2025-09-17T20:42:00Z" data-controller="local-time">2025-09-17T20:42:00Z</time>')
+    JS
+
+    assert_selector "#refreshing-timestamp", text: "1:42 PM"
+    page.execute_script 'window.testNow = "2025-09-18T07:01:00Z"; window.refreshTimestamp()'
+    assert_selector "#refreshing-timestamp", text: "yesterday"
+
+    page.execute_script "document.querySelector('#refreshing-timestamp').remove()"
+    assert_no_selector "#refreshing-timestamp"
+    assert page.evaluate_script("window.timestampTimerCleared")
+  end
+
+  test "invalid timestamps retain their fallback text" do
+    page.execute_script <<~JS
+      document.body.insertAdjacentHTML("beforeend", '<time id="invalid-timestamp" datetime="invalid" data-controller="local-time">Unknown</time>')
+    JS
+
+    assert_selector "#invalid-timestamp", text: "Unknown"
+  end
+
+  private
+    def format_date(timestamp, format: "relative", now: "2025-09-17T22:42:00Z")
+      page.evaluate_async_script <<~JS, timestamp, format, now
+        const [timestamp, format, now, done] = arguments
+        import("helpers/date_helpers").then(({ formatDate, parseDate }) => {
+          done(formatDate(parseDate(timestamp), format, new Date(now)))
+        })
+      JS
+    end
+end
