+
+<div class="panel center">
+  <h2>Upgrade Fizzy</h2>
+  <% Plan::ALL.each_value do |plan| %>
+    <section>
+      <h3><%= plan.name %> — <%= plan.price.zero? ? "Free" : "$#{plan.price}/month" %></h3>
+      <p><%= plan.card_limit ? number_with_delimiter(plan.card_limit) : "Unlimited" %> cards · <%= number_to_human_size plan.storage_limit %> storage</p>
+      <% if plan.price.positive? %>
+        <%= button_to "Upgrade to #{plan.name}", saas.account_billing_path(plan_key: plan.key, script_name: Current.account.slug), class: "btn", data: { turbo: false } %>
+      <% end %>
+    </section>
+  <% end %>
+  <% if Current.account.subscription %>
+    <%= button_to "Manage billing", saas.account_billing_path(script_name: Current.account.slug), method: :patch, class: "btn", data: { turbo: false } %>
+  <% end %>
+</div>
