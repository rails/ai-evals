diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..844a837
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,55 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  def active?
+    status.in?(%w[ active trialing past_due ]) && Plan::ALL.key?(plan_key) && plan_key != "free"
+  end
+
+  def ongoing?
+    active? || (stripe_subscription_id.present? && !status.in?(%w[ canceled incomplete_expired ]))
+  end
+
+  def checkout_url(plan, success_url:, cancel_url:)
+    Stripe::Checkout::Session.create({
+      mode: "subscription", customer: stripe_customer_id,
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      success_url: success_url, cancel_url: cancel_url
+    }, stripe_options).url
+  end
+
+  def portal_url(return_url:)
+    Stripe::BillingPortal::Session.create({ customer: stripe_customer_id, return_url: return_url }, stripe_options).url
+  end
+
+  def apply_event(event)
+    object = event.data.object.to_hash.deep_stringify_keys
+
+    with_lock do
+      return if last_event_id == event.id || (last_event_created && event.created < last_event_created)
+      # Stripe cannot reactivate a canceled subscription, even if its events arrive out of order.
+      return if status == "canceled" && stripe_subscription_id == object.fetch("id")
+      # A deletion of a superseded subscription must not cancel its replacement.
+      return if event.type == "customer.subscription.deleted" && stripe_subscription_id.present? && stripe_subscription_id != object.fetch("id")
+
+      price_id = object.dig("items", "data", 0, "price", "id")
+      plan = Plan.for_stripe_price(price_id)
+      update!(
+        stripe_subscription_id: object.fetch("id"),
+        plan_key: plan&.key,
+        status: event.type == "customer.subscription.deleted" ? "canceled" : object.fetch("status"),
+        current_period_end: timestamp(object["current_period_end"] || object.dig("items", "data", 0, "current_period_end")),
+        cancel_at: timestamp(object["cancel_at"]),
+        last_event_created: event.created, last_event_id: event.id
+      )
+    end
+  end
+
+  private
+    def stripe_options
+      { api_key: ENV.fetch("STRIPE_SECRET_KEY") }
+    end
+
+    def timestamp(value)
+      Time.at(value) if value
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..d0444d9
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,29 @@
+class Plan
+  attr_reader :key, :name, :price, :card_limit, :storage_limit
+
+  def initialize(key, name:, price:, card_limit: nil, storage_limit:)
+    @key = key
+    @name = name
+    @price = price
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+  end
+
+  def stripe_price_id
+    ENV.fetch("STRIPE_#{key.upcase}_PRICE_ID")
+  end
+
+  def self.find(key)
+    ALL.fetch(key)
+  end
+
+  def self.for_stripe_price(id)
+    ALL.values.find { |plan| plan.price.positive? && ENV["STRIPE_#{plan.key.upcase}_PRICE_ID"].present? && plan.stripe_price_id == id }
+  end
+
+  ALL = {
+    "free" => new("free", name: "Free", price: 0, card_limit: 1_000, storage_limit: 1.gigabyte),
+    "unlimited" => new("unlimited", name: "Unlimited", price: 20, storage_limit: 5.gigabytes),
+    "unlimited_plus" => new("unlimited_plus", name: "Unlimited+", price: 25, storage_limit: 500.gigabytes)
+  }.freeze
+end
