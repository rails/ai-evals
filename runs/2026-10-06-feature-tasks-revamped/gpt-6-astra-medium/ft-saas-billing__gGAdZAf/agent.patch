+class Admin::Accounts::OverriddenLimitsController < AdminController
+  before_action :set_account
+
+  def update
+    override = @account.overridden_limits || @account.build_overridden_limits
+    if override.update(params.expect(overridden_limits: [ :card_count, :bytes_used ]))
+      redirect_to saas.admin_account_path(@account)
+    else
+      redirect_to saas.admin_account_path(@account), alert: override.errors.full_messages.to_sentence
+    end
+  end
