diff --git a/saas/test/controllers/account/billings_controller_test.rb b/saas/test/controllers/account/billings_controller_test.rb
new file mode 100644
index 0000000..9146a9c
--- /dev/null
+++ b/saas/test/controllers/account/billings_controller_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Account::BillingsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    integration_session.default_url_options[:script_name] = @account.slug
+    @account.update_column(:cards_count, 100)
+    ENV["STRIPE_SECRET_KEY"] = "sk_test_local"
+    ENV["STRIPE_UNLIMITED_PRICE_ID"] = "price_unlimited"
+  end
+
+  teardown do
+    ENV.delete("STRIPE_SECRET_KEY")
+    ENV.delete("STRIPE_UNLIMITED_PRICE_ID")
+  end
+
+  test "admins see pricing and can open hosted checkout" do
+    get saas.account_billing_path
+    assert_response :success
+    assert_select "h3", text: "Unlimited — $20/month"
+    assert_select "h3", text: "Unlimited+ — $25/month"
+
+    Stripe::Customer.expects(:create).with(
+      { name: @account.name, metadata: { account_id: @account.id } },
+      { api_key: "sk_test_local", idempotency_key: "account-customer-#{@account.id}" }
+    ).returns(Stripe::Customer.construct_from(id: "cus_checkout"))
+    Stripe::Checkout::Session.expects(:create).with do |params, options|
+      params[:mode] == "subscription" && params[:customer] == "cus_checkout" &&
+        params[:line_items] == [ { price: "price_unlimited", quantity: 1 } ] &&
+        params[:success_url].include?(@account.slug) && options[:api_key] == "sk_test_local"
+    end.returns(Stripe::Checkout::Session.construct_from(url: "https://checkout.stripe.com/local"))
+    post saas.account_billing_path, params: { plan_key: "unlimited" }
+    assert_redirected_to "https://checkout.stripe.com/local"
+    assert_equal "Free", @account.reload.plan.name
+  end
+
+  test "paid accounts use the portal instead of a second subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_paid", plan_key: "unlimited", status: "active")
+    Stripe::Checkout::Session.expects(:create).never
+    Stripe::BillingPortal::Session.expects(:create).with do |params, _|
+      params[:customer] == "cus_paid" && params[:return_url].include?(@account.slug)
+    end.returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/local"))
+    post saas.account_billing_path, params: { plan_key: "unlimited_plus" }
+    assert_redirected_to "https://billing.stripe.com/local"
+  end
+
+  test "invalid plans are refused without contacting Stripe" do
+    Stripe::Customer.expects(:create).never
+    post saas.account_billing_path, params: { plan_key: "arbitrary_price" }
+    assert_response :unprocessable_entity
+  end
+
+  test "members cannot access billing" do
+    logout_and_sign_in_as :jz
+    integration_session.default_url_options[:script_name] = accounts(:"37s").slug
+    get saas.account_billing_path
+    assert_response :forbidden
+    post saas.account_billing_path, params: { plan_key: "unlimited" }
+    assert_response :forbidden
+    patch saas.account_billing_path
+    assert_response :forbidden
+  end
+
+  test "unpaid subscriptions go to the portal rather than opening a second subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_unpaid", stripe_subscription_id: "sub_unpaid", plan_key: "unlimited", status: "unpaid")
+    Stripe::Checkout::Session.expects(:create).never
+    Stripe::BillingPortal::Session.expects(:create).returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/local"))
+    post saas.account_billing_path, params: { plan_key: "unlimited" }
+    assert_redirected_to "https://billing.stripe.com/local"
+  end
+
+  test "Stripe failures leave the account free and offer a retry" do
+    Stripe::Customer.expects(:create).raises(Stripe::APIConnectionError.new("Unavailable"))
+    post saas.account_billing_path, params: { plan_key: "unlimited" }
+    assert_redirected_to saas.account_billing_path
+    assert_equal "Free", @account.reload.plan.name
+    assert_nil @account.subscription
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..6587190
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @account = accounts(:initech)
+  end
+
+  test "staff can list accounts and use comp override and reset tools" do
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href=?]", saas.admin_account_path(@account), text: @account.name
+      get saas.admin_account_path(@account)
+      assert_response :success
+      %w[ Comp Uncomp Reset ].each { |label| assert_select "button", text: label }
+      assert_select "input[type=submit][value=Override]"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_response :redirect
+      assert @account.reload.comped?
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_response :redirect
+      assert_not @account.reload.comped?
+
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: 1050, bytes_used: 2.gigabytes } }
+      assert_response :redirect
+      assert_equal 1050, @account.reload.card_count
+      assert_equal 2.gigabytes, @account.bytes_used
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_response :redirect
+      assert_nil @account.reload.overridden_limits
+      assert_equal @account.cards.published.count, @account.card_count
+    end
+  end
+
+  test "non staff cannot access any support tools" do
+    logout_and_sign_in_as :jz
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+      get saas.admin_account_path(@account)
+      assert_response :forbidden
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: 0 } }
+      assert_response :forbidden
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_response :forbidden
+    end
+  end
+
+  test "invalid usage does not save an override" do
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: -10 } }
+    end
+    assert_nil @account.reload.overridden_limits
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..93d9971
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    integration_session.default_url_options[:script_name] = @account.slug
+    @account.update_column(:cards_count, 100)
+    @override = @account.create_overridden_limits!(card_count: 1000)
+  end
+
+  test "API creation and draft publishing are refused at the free limit" do
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list)), params: { card: { title: "Over limit" } }, as: :json
+    end
+    assert_response :forbidden
+    post card_publish_path(cards(:unfinished_thoughts)), as: :json
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "draft creation and editing remain available" do
+    post board_cards_path(boards(:miltons_wish_list))
+    assert_response :redirect
+    patch card_path(cards(:unfinished_thoughts)), params: { card: { title: "Still drafting" } }, as: :json
+    assert_response :success
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "last free card and paid cards can be published" do
+    @override.update!(card_count: 999)
+    post card_publish_path(cards(:unfinished_thoughts)), as: :json
+    assert_response :created
+    @override.update!(card_count: 1001)
+    @account.comp
+    post board_cards_path(boards(:miltons_wish_list)), params: { card: { title: "Comped" } }, as: :json
+    assert_response :created
+  end
+
+  test "countdown and upgrade pitch replace create buttons" do
+    @override.update!(card_count: 950)
+    get card_draft_path(cards(:unfinished_thoughts))
+    assert_response :success
+    assert_match "50 cards left", response.body
+    assert_select "button span", text: "Create card"
+
+    @override.update!(card_count: 1000)
+    get card_draft_path(cards(:unfinished_thoughts))
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select "button span", text: "Create card", count: 0
+  end
+
+  test "publishing the thousandth card exhausts the real quota" do
+    @override.destroy!
+    template = @account.cards.published.first.attributes.except("id")
+    missing = 999 - @account.cards.published.count
+    Card.insert_all! missing.times.map { |i| template.merge("id" => SecureRandom.uuid, "number" => 1000 + i) }
+    @account.update_column(:cards_count, 3000)
+
+    post card_publish_path(cards(:unfinished_thoughts)), as: :json
+    assert_response :created
+    assert_equal 1000, @account.cards.published.count
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list)), params: { card: { title: "One too many" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "board and event creation buttons become upgrade links" do
+    get board_path(boards(:miltons_wish_list))
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select "form[action=?]", board_cards_path(boards(:miltons_wish_list)), count: 0
+    get root_path
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select "button span", text: "Add a card", count: 0
+  end
+
+  test "account settings show the current plan and an upgrade link" do
+    get account_settings_path
+    assert_response :success
+    assert_select "h2", text: "Your plan: Free"
+    assert_select "a[href=?]", saas.account_billing_path, text: "Upgrade"
+    @account.comp
+    get account_settings_path
+    assert_select "h2", text: "Your plan: Unlimited"
+  end
+end
