index 0000000..9418f6c
--- /dev/null
+++ b/saas/app/controllers/account/billings_controller.rb
@@ -0,0 +1,33 @@
+class Account::BillingsController < ApplicationController
+  before_action :ensure_admin
+
+  rescue_from Stripe::StripeError do
+    redirect_to saas.account_billing_path(script_name: Current.account.slug), alert: "Billing is temporarily unavailable. Please try again."
+  end
+
+  def show
+  end
+
+  def create
+    plan = Plan::ALL[params[:plan_key]]
+    if plan && plan.price.positive?
+      subscription = Current.account.billing_subscription
+      url = if subscription.ongoing?
+        subscription.portal_url(return_url: saas.account_billing_url(script_name: Current.account.slug))
+      else
+        subscription.checkout_url(plan, success_url: saas.account_billing_url(script_name: Current.account.slug), cancel_url: saas.account_billing_url(script_name: Current.account.slug))
+      end
+      redirect_to url, allow_other_host: true, status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def update
+    if subscription = Current.account.subscription
+      redirect_to subscription.portal_url(return_url: saas.account_billing_url(script_name: Current.account.slug)), allow_other_host: true, status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  end
+end
