+require "test_helper"
+
+class MagicLink::CodeTest < ActiveSupport::TestCase
+  test "generate" do
+    code = MagicLink::Code.generate(6)
+
+    assert_equal 6, code.length
+    assert code.chars.all? { |char| char.in?(MagicLink::Code::ALPHABET) }
+  end
+
+  test "the alphabet leaves out characters that are easily misread" do
+    assert_empty %w[ I L O U ] & MagicLink::Code::ALPHABET
+  end
+
+  test "sanitize" do
+    assert_equal "ABC123", MagicLink::Code.sanitize("abc123")
+    assert_equal "ABC123", MagicLink::Code.sanitize(" ABC-123\n")
+    assert_equal "0110", MagicLink::Code.sanitize("OIlo")
+    assert_nil MagicLink::Code.sanitize(nil)
+    assert_nil MagicLink::Code.sanitize("")
+  end
+end
diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..b8565c8
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "create generates a code that expires in fifteen minutes" do
+    freeze_time do
+      magic_link = MagicLink.create!(identity: @identity)
+
+      assert_equal MagicLink::CODE_LENGTH, magic_link.code.length
+      assert_match(/\A[#{MagicLink::Code::ALPHABET.join}]{6}\z/, magic_link.code)
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert magic_link.for_sign_in?
+    end
+  end
+
+  test "codes are unique" do
+    first = MagicLink.create!(identity: @identity)
+    MagicLink::Code.stubs(:generate).returns(first.code).then.returns("ZZZZZZ")
+
+    assert_equal "ZZZZZZ", MagicLink.create!(identity: @identity).code
+  end
+
+  test "consume" do
+    magic_link = MagicLink.create!(identity: @identity)
+
+    assert_equal magic_link, MagicLink.consume(magic_link.code)
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "a code only works once" do
+    magic_link = MagicLink.create!(identity: @identity)
+
+    assert MagicLink.consume(magic_link.code)
+    assert_nil MagicLink.consume(magic_link.code)
+  end
+
+  test "consume forgives case, separators and look-alike characters" do
+    magic_link = MagicLink.create!(identity: @identity, code: "0A1B2C")
+
+    assert_equal magic_link, MagicLink.consume(" oa-ib 2c ")
+  end
+
+  test "consume ignores unknown and blank codes" do
+    MagicLink.create!(identity: @identity)
+
+    assert_nil MagicLink.consume("NOPE00")
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume(nil)
+    assert_nil MagicLink.consume("-- --")
+  end
+
+  test "a code works for fifteen minutes" do
+    magic_link = MagicLink.create!(identity: @identity)
+
+    travel 15.minutes + 1.second do
+      assert_nil MagicLink.consume(magic_link.code)
+    end
+
+    travel 15.minutes - 1.second do
+      assert_equal magic_link, MagicLink.consume(magic_link.code)
+    end
+  end
+
+  test "consume loses a race for the same code" do
+    magic_link = MagicLink.create!(identity: @identity)
+    competitor = MagicLink.find(magic_link.id)
+
+    assert competitor.consume
+    assert_nil magic_link.consume
+  end
+
+  test "cleanup deletes expired links" do
+    active = MagicLink.create!(identity: @identity)
+    stale = MagicLink.create!(identity: @identity, expires_at: 1.minute.ago)
+
+    MagicLink.cleanup
+
+    assert MagicLink.exists?(active.id)
+    assert_not MagicLink.exists?(stale.id)
+  end
+end
