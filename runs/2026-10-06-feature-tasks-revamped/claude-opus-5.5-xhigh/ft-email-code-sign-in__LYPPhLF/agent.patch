diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..87b86a2
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,45 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  enum :purpose, %w[ sign_in sign_up ].index_by(&:itself), prefix: :for, default: :sign_in
+
+  scope :active, -> { where(expires_at: Time.current..) }
+  scope :stale, -> { where(expires_at: ...Time.current) }
+
+  before_validation :generate_code, :set_expiration, on: :create
+
+  validates :code, presence: true, uniqueness: true
+
+  class << self
+    def consume(code)
+      if sanitized_code = Code.sanitize(code).presence
+        active.find_by(code: sanitized_code)&.consume
+      end
+    end
+
+    def cleanup
+      stale.delete_all
+    end
+  end
+
+  # Codes work once. Deleting the row is what claims a code, so when two requests race to use
+  # the same one, only one of them gets it.
+  def consume
+    self if self.class.where(id: id).delete_all.positive?
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = Code.generate(CODE_LENGTH)
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def set_expiration
+      self.expires_at ||= EXPIRATION_TIME.from_now
+    end
+end
diff --git a/app/models/magic_link/code.rb b/app/models/magic_link/code.rb
new file mode 100644
index 0000000..290d254
--- /dev/null
+++ b/app/models/magic_link/code.rb
@@ -0,0 +1,19 @@
+# Codes use Crockford's Base32 alphabet. It leaves out I, L and O, which are easily mistaken for
+# 1 and 0, and U, so that codes don't spell words. When a code is typed in, I, L and O are read as
+# the digits they look like, case doesn't matter, and spaces, dashes and the like are ignored.
+module MagicLink::Code
+  ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ".chars.freeze
+  SUBSTITUTIONS = { "O" => "0", "I" => "1", "L" => "1" }.freeze
+
+  class << self
+    def generate(length)
+      Array.new(length) { ALPHABET.sample(random: SecureRandom) }.join
+    end
+
+    def sanitize(code)
+      if code.present?
+        code.to_s.upcase.gsub(/[#{SUBSTITUTIONS.keys.join}]/, SUBSTITUTIONS).gsub(/[^#{ALPHABET.join}]/, "")
+      end
+    end
+  end
+end
