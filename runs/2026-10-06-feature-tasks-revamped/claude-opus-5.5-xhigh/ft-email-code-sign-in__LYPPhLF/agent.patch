--- /dev/null
+++ b/app/mailers/magic_link_mailer.rb
@@ -0,0 +1,18 @@
+class MagicLinkMailer < ApplicationMailer
+  # When the email can't go out, such as on a self-hosted install without SMTP set up, log the code
+  # so that people can still get in.
+  rescue_from StandardError, with: :log_undelivered_code
+
+  def sign_in_instructions(magic_link)
+    @magic_link = magic_link
+    @identity = magic_link.identity
+
+    mail to: @identity.email_address, subject: "Your Fizzy code is #{@magic_link.code}"
+  end
+
+  private
+    def log_undelivered_code(error)
+      logger&.warn "Couldn't email a code to #{@identity&.email_address} (#{error.class}). The code is #{@magic_link&.code}."
+      raise error
+    end
+end
