new file mode 100644
index 0000000..a191ea6
--- /dev/null
+++ b/app/controllers/concerns/authentication/via_magic_link.rb
@@ -0,0 +1,55 @@
+module Authentication::ViaMagicLink
+  extend ActiveSupport::Concern
+
+  included do
+    helper_method :email_address_pending_authentication
+  end
+
+  private
+    def redirect_to_session_magic_link(magic_link, return_to: nil)
+      serve_development_magic_link magic_link
+      redirect_to_pending_authentication magic_link.identity.email_address, return_to: return_to
+    end
+
+    # Looks just like a code went out, so that trying an email address doesn't reveal whether
+    # it belongs to anyone.
+    def redirect_to_fake_session_magic_link(email_address)
+      redirect_to_pending_authentication Identity.normalize_value_for(:email_address, email_address)
+    end
+
+    def redirect_to_pending_authentication(email_address, return_to: nil)
+      set_pending_authentication_token email_address
+      session[:return_to_after_authenticating] = return_to if return_to
+
+      respond_to do |format|
+        format.html { redirect_to main_app.session_magic_link_url(script_name: nil) }
+        format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+      end
+    end
+
+    # A code only signs in the person who asked for it, in the browser (or app) they asked from.
+    def email_address_pending_authentication
+      cookies.signed[:pending_authentication_token]
+    end
+
+    def set_pending_authentication_token(email_address)
+      cookies.signed[:pending_authentication_token] = {
+        value: email_address, expires: MagicLink::EXPIRATION_TIME.from_now, httponly: true, same_site: :lax
+      }
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def clear_pending_authentication_token
+      cookies.delete :pending_authentication_token
+    end
+
+    def serve_development_magic_link(magic_link)
+      if Rails.env.development?
+        flash[:magic_link_code] = magic_link.code
+        response.set_header "X-Magic-Link-Code", magic_link.code
+      end
+    end
+end
