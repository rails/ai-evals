diff --git a/test/mailers/magic_link_mailer_test.rb b/test/mailers/magic_link_mailer_test.rb
new file mode 100644
index 0000000..052088d
--- /dev/null
+++ b/test/mailers/magic_link_mailer_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  setup do
+    @magic_link = MagicLink.create!(identity: identities(:kevin))
+  end
+
+  test "sign_in_instructions" do
+    email = MagicLinkMailer.sign_in_instructions(@magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_match @magic_link.code, email.html_part.body.to_s
+    assert_match @magic_link.code, email.text_part.body.to_s
+    assert_match "15 minutes", email.text_part.body.to_s
+    assert_match "sign in to Fizzy", email.text_part.body.to_s
+  end
+
+  test "the code is in the subject so it shows in notifications" do
+    email = MagicLinkMailer.sign_in_instructions(@magic_link)
+
+    assert_equal "Your Fizzy code is #{@magic_link.code}", email.subject
+  end
+
+  test "sign_in_instructions for signing up" do
+    @magic_link.update!(purpose: :sign_up)
+
+    email = MagicLinkMailer.sign_in_instructions(@magic_link)
+
+    assert_match "finish signing up for Fizzy", email.text_part.body.to_s
+  end
+
+  test "the code is logged when it can't be emailed" do
+    Mail::TestMailer.any_instance.stubs(:deliver!).raises(Errno::ECONNREFUSED)
+    log = StringIO.new
+
+    with_logger(ActiveSupport::Logger.new(log)) do
+      assert_raises(Errno::ECONNREFUSED) do
+        MagicLinkMailer.sign_in_instructions(@magic_link).deliver_now
+      end
+    end
+
+    assert_match "kevin@37signals.com", log.string
+    assert_match @magic_link.code, log.string
+  end
+
+  test "the code isn't logged when it's emailed" do
+    log = StringIO.new
+
+    with_logger(ActiveSupport::Logger.new(log)) do
+      MagicLinkMailer.sign_in_instructions(@magic_link).deliver_now
+    end
+
+    assert_no_match @magic_link.code, log.string
+  end
+
+  private
+    def with_logger(logger)
+      original, MagicLinkMailer.logger = MagicLinkMailer.logger, logger
+      yield
+    ensure
+      MagicLinkMailer.logger = original
+    end
+end
