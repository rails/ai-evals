+class Notification::BundleMailer < ApplicationMailer
+  helper NotificationsHelper
+
+  def notification(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.unread.ordered.preloaded.to_a
+
+    if @notifications.any? && @bundle.deliverable?
+      @user.in_time_zone do
+        mail to: @user.identity.email_address, subject: "#{@notifications.size} new #{"notification".pluralize(@notifications.size)} in #{@bundle.account.name}"
+      end
+    end
+  end
+end
