+class Notification::BundleMailerPreview < ActionMailer::Preview
+  def notification
+    user = Notification.unread.where(user: User.active).sample.user
+    bundle = Notification::Bundle.new(user: user, account: user.account, starts_at: 4.hours.ago, ends_at: Time.current)
+    Current.account = user.account
+
+    # Preview everything the person has unread, regardless of their actual email settings
+    bundle.define_singleton_method(:notifications) { user.notifications }
+    bundle.define_singleton_method(:deliverable?) { true }
+
+    Notification::BundleMailer.notification(bundle)
+  end
+end
