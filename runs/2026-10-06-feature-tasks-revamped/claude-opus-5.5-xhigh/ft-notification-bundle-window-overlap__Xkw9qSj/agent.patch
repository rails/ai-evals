+require "test_helper"
+
+class Notification::Bundle::DeliverJobTest < ActiveJob::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.bundle_email_every_few_hours!
+    @bundle = @user.notification_bundles.create!(starts_at: 5.hours.ago)
+    notifications(:logo_assignment_kevin).update_column(:bundle_id, @bundle.id)
+  end
+
+  test "the recurring sweep delivers due bundles in their account" do
+    perform_enqueued_jobs do
+      Notification::Bundle::DeliverAllJob.perform_later
+    end
+
+    assert @bundle.reload.delivered?
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    assert_includes ActionMailer::Base.deliveries.last.html_part.body.to_s, "#{@user.account.slug}/cards/"
+  end
+
+  test "bundles discarded before delivery are skipped" do
+    Notification::Bundle::DeliverJob.perform_later(@bundle)
+    @bundle.destroy
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Notification::Bundle::DeliverJob
+    end
+  end
+end
diff --git a/test/mailers/notification/bundle_mailer_test.rb b/test/mailers/notification/bundle_mailer_test.rb
new file mode 100644
index 0000000..7d1e9e2
--- /dev/null
+++ b/test/mailers/notification/bundle_mailer_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Notification::BundleMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.bundle_email_daily!
+    @bundle = @user.notification_bundles.create!(starts_at: 1.day.ago)
+
+    @assignment = notifications(:logo_assignment_kevin)
+    @comment = notifications(:layout_commented_kevin)
+    [ @assignment, @comment ].each { it.update_column(:bundle_id, @bundle.id) }
+  end
+
+  test "notification summarizes the bundled unread notifications" do
+    email = Notification::BundleMailer.notification(@bundle)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "2 new notifications in 37signals", email.subject
+
+    html = email.html_part.body.to_s
+    assert_includes html, "Writebook"
+    assert_includes html, "The logo isn&#39;t big enough"
+    assert_includes html, "Layout is broken"
+    assert_includes html, "2 updates", "shows when a card had more than one update"
+    assert_includes html, "summary of your unread notifications once a day"
+    assert_includes html, "#{@user.account.slug}/cards/", "links are account-scoped"
+    assert_includes html, "#{@user.account.slug}/notifications/settings"
+
+    text = email.text_part.body.to_s
+    assert_includes text, "The logo isn't big enough"
+    assert_includes text, "Layout is broken"
+    assert_includes text, "#{@user.account.slug}/notifications/settings"
+  end
+
+  test "notification includes mentions" do
+    mention = notifications(:logo_mentioned_david)
+    david = users(:david)
+    david.settings.bundle_email_daily!
+    bundle = david.notification_bundles.create!(starts_at: 1.day.ago)
+    mention.update_column(:bundle_id, bundle.id)
+
+    html = Notification::BundleMailer.notification(bundle).html_part.body.to_s
+
+    assert_includes html, "mentioned you"
+  end
+
+  test "notification skips notifications read since they were bundled" do
+    @comment.read
+
+    email = Notification::BundleMailer.notification(@bundle)
+
+    assert_equal "1 new notification in 37signals", email.subject
+    assert_not_includes email.html_part.body.to_s, "Layout is broken"
+  end
+
+  test "notification isn't sent when everything has been read" do
+    [ @assignment, @comment ].each(&:read)
+
+    assert_no_emails do
+      Notification::BundleMailer.notification(@bundle).deliver_now
+    end
+  end
+
+  test "notification isn't sent to people who turned emails off" do
+    @user.settings.update_column(:bundle_email_frequency, "never")
+
+    assert_no_emails do
+      Notification::BundleMailer.notification(@bundle).deliver_now
+    end
+  end
+
+  test "times are shown in the person's time zone" do
+    @user.settings.update!(timezone_name: "Tokyo")
+    @comment.read
+    @assignment.update_column(:updated_at, Time.utc(2026, 1, 1, 12, 0))
+
+    html = Notification::BundleMailer.notification(@bundle).html_part.body.to_s
+
+    assert_includes html, "Jan 1 at 9:00pm"
+  end
+end
