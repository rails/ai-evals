+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:kevin).settings
+  end
+
+  test "bundle emails are off by default" do
+    assert User.create!(account: accounts("37s"), name: "New person").settings.bundle_email_never?
+  end
+
+  test "bundle email frequency is one of the supported choices" do
+    assert_equal %w[ never every_few_hours daily weekly ], User::Settings.bundle_email_frequencies.keys
+
+    @settings.bundle_email_frequency = "hourly"
+    assert_not @settings.valid?
+  end
+
+  test "bundle aggregation period follows the frequency" do
+    assert_nil @settings.tap(&:bundle_email_never!).bundle_aggregation_period
+    assert_equal 4.hours, @settings.tap(&:bundle_email_every_few_hours!).bundle_aggregation_period
+    assert_equal 1.day, @settings.tap(&:bundle_email_daily!).bundle_aggregation_period
+    assert_equal 1.week, @settings.tap(&:bundle_email_weekly!).bundle_aggregation_period
+  end
+
+  test "bundling emails needs a frequency and someone who can receive email" do
+    assert_not @settings.bundling_emails?
+
+    @settings.bundle_email_daily!
+    assert @settings.bundling_emails?
+
+    @settings.user.update!(verified_at: nil)
+    assert_not @settings.bundling_emails?
+  end
+
+  test "system users never bundle emails" do
+    settings = users(:system).settings
+    settings.bundle_email_daily!
+
+    assert_not settings.bundling_emails?
+  end
+end
