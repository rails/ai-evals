--- a/app/models/user/timelined.rb
+++ b/app/models/user/timelined.rb
@@ -1,6 +1,23 @@
 module User::Timelined
   extend ActiveSupport::Concern
 
+  # Mirrors the actions shown in the day timeline, minus the deprecated
+  # card_collection_changed and plus card_title_changed.
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_title_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+  ]
+
   included do
     has_many :accessible_events, through: :boards, source: :events
   end
@@ -8,4 +25,11 @@ module User::Timelined
   def timeline_for(day, filter:)
     User::DayTimeline.new(self, day, filter)
   end
+
+  def activity_for(filter:)
+    events = accessible_events.where(action: ACTIVITY_ACTIONS)
+    events = events.where(board_id: filter.boards.ids) if filter.boards.present?
+    events = events.where(creator_id: filter.creators.ids) if filter.creators.present?
+    events.preloaded.reverse_chronologically
+  end
 end
