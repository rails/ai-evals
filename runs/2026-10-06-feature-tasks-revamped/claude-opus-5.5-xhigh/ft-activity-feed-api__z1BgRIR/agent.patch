+require "test_helper"
+
+class User::TimelinedTest < ActiveSupport::TestCase
+  test "activity includes events from accessible boards, newest first" do
+    activity = users(:kevin).activity_for(filter: users(:kevin).filters.new)
+
+    assert_equal Event.where(board: boards(:writebook)).count, activity.count
+    assert_equal events(:layout_assignment_jz), activity.first
+    assert_equal activity.map(&:created_at).sort.reverse, activity.map(&:created_at)
+  end
+
+  test "activity excludes events from inaccessible boards" do
+    event = track(private_card, "card_closed")
+
+    assert_includes users(:kevin).activity_for(filter: users(:kevin).filters.new), event
+    assert_not_includes users(:david).activity_for(filter: users(:david).filters.new), event
+    assert_not_includes users(:david).activity_for(filter: users(:david).filters.new(board_ids: [ boards(:private).id ])), event
+  end
+
+  test "activity includes title changes but not deprecated collection changes" do
+    title_change = track(cards(:logo), "card_title_changed", particulars: { old_title: "Old", new_title: "New" })
+    collection_change = track(cards(:logo), "card_collection_changed", particulars: { old_collection: "Old", new_collection: "New" })
+
+    activity = users(:kevin).activity_for(filter: users(:kevin).filters.new)
+
+    assert_includes activity, title_change
+    assert_not_includes activity, collection_change
+  end
+
+  test "activity filtered by creators" do
+    activity = users(:kevin).activity_for(filter: users(:kevin).filters.new(creator_ids: [ users(:kevin).id ]))
+
+    assert_equal events(:text_published, :shipping_published, :shipping_closed).sort_by(&:id), activity.sort_by(&:id)
+  end
+
+  test "activity filtered by boards" do
+    event = track(private_card, "card_closed")
+
+    activity = users(:kevin).activity_for(filter: users(:kevin).filters.new(board_ids: [ boards(:private).id ]))
+
+    assert_includes activity, event
+    assert activity.all? { it.board == boards(:private) }
+  end
+
+  private
+    def track(card, action, **particulars)
+      card.board.events.create!(action: action, creator: users(:kevin), eventable: card, particulars: particulars)
+    end
+
+    def private_card
+      @private_card ||= Current.set(user: users(:kevin)) do
+        boards(:private).cards.create!(title: "Secret plans", status: "published")
+      end
+    end
+end
