+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,291 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    event = events(:layout_assignment_jz)
+    activity = find_activity(event)
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ], activity.keys
+    assert_equal "card_assigned", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:layout).id, activity.dig("eventable", "id")
+    assert_equal cards(:layout).number, activity.dig("eventable", "number")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+  end
+
+  test "index returns activity newest first" do
+    get activities_path(format: :json)
+
+    timestamps = @response.parsed_body.map { Time.iso8601(it["created_at"]) }
+    assert timestamps.many?
+    assert_equal timestamps.sort.reverse, timestamps
+    assert_equal events(:layout_assignment_jz).id, @response.parsed_body.first["id"]
+  end
+
+  test "index returns descriptions in plain text relative to the current user" do
+    get activities_path(format: :json)
+
+    assert_equal events(:logo_assignment_km).description_for(users(:kevin)).to_plain_text, find_activity(events(:logo_assignment_km))["description"]
+    assert_match "David will handle", find_activity(events(:logo_assignment_km))["description"]
+    assert_match "David assigned JZ to", find_activity(events(:layout_assignment_jz))["description"]
+    assert_match "David commented on", find_activity(events(:layout_commented))["description"]
+    assert_no_match(/<span/, find_activity(events(:layout_commented))["description"])
+  end
+
+  test "card events link to the card" do
+    get activities_path(format: :json)
+
+    assert_equal card_url(cards(:layout)), find_activity(events(:layout_published))["url"]
+  end
+
+  test "comment events link to the comment on its card" do
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path(format: :json)
+
+    activity = find_activity(events(:layout_commented))
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(cards(:layout), anchor: "comment_#{comment.id}"), activity["url"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal comment.body.to_plain_text, activity.dig("eventable", "body", "plain_text")
+    assert_equal cards(:layout).id, activity.dig("eventable", "card", "id")
+  end
+
+  test "assignment events include assignee ids" do
+    unassignment = track(cards(:logo), "card_unassigned", assignee_ids: [ users(:jz).id ])
+
+    get activities_path(format: :json)
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, find_activity(events(:logo_assignment_jz))["particulars"])
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, find_activity(unassignment)["particulars"])
+  end
+
+  test "board change events include the old and new board" do
+    event = track(cards(:logo), "card_board_changed", particulars: { old_board: "Old", new_board: "New" })
+
+    get activities_path(format: :json)
+
+    assert_equal({ "old_board" => "Old", "new_board" => "New" }, find_activity(event)["particulars"])
+  end
+
+  test "title change events are included with the old and new title" do
+    event = track(cards(:logo), "card_title_changed", particulars: { old_title: "Old title", new_title: "New title" })
+
+    get activities_path(format: :json)
+
+    activity = find_activity(event)
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activity["particulars"])
+    assert_match "renamed", activity["description"]
+  end
+
+  test "triage events include the column" do
+    event = track(cards(:logo), "card_triaged", particulars: { column: "In progress" })
+
+    get activities_path(format: :json)
+
+    assert_equal({ "column" => "In progress" }, find_activity(event)["particulars"])
+  end
+
+  test "missing particulars values are returned as empty strings" do
+    board_change = track(cards(:logo), "card_board_changed", particulars: { new_board: "New" })
+    title_change = track(cards(:logo), "card_title_changed")
+    triage = track(cards(:logo), "card_triaged")
+
+    get activities_path(format: :json)
+
+    assert_equal({ "old_board" => "", "new_board" => "New" }, find_activity(board_change)["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, find_activity(title_change)["particulars"])
+    assert_equal({ "column" => "" }, find_activity(triage)["particulars"])
+  end
+
+  test "other events have empty particulars" do
+    get activities_path(format: :json)
+
+    [ :logo_published, :shipping_closed, :buy_domain_sent_back_to_triage, :layout_commented ].each do |name|
+      assert_equal({}, find_activity(events(name))["particulars"], "Expected #{name} to have empty particulars")
+    end
+  end
+
+  test "real card changes show up in activity" do
+    Current.set(user: users(:kevin)) do
+      cards(:logo).update!(title: "A bigger logo")
+      cards(:logo).triage_into(columns(:writebook_in_progress))
+    end
+
+    get activities_path(format: :json)
+
+    title_change = @response.parsed_body.find { it["action"] == "card_title_changed" }
+    assert_equal({ "old_title" => "The logo isn't big enough", "new_title" => "A bigger logo" }, title_change["particulars"])
+
+    triage = @response.parsed_body.find { it["action"] == "card_triaged" }
+    assert_equal({ "column" => "In progress" }, triage["particulars"])
+    assert_equal cards(:logo).id, triage.dig("eventable", "id")
+  end
+
+  test "deprecated collection change events are omitted" do
+    event = track(cards(:logo), "card_collection_changed", particulars: { old_collection: "Old", new_collection: "New" })
+
+    get activities_path(format: :json)
+
+    assert_nil find_activity(event)
+  end
+
+  test "events not shown in the timeline are omitted" do
+    event = track(cards(:logo), "card_resumed")
+
+    get activities_path(format: :json)
+
+    assert_nil find_activity(event)
+  end
+
+  test "filter by creator" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ])
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { it.dig("creator", "id") == users(:kevin).id }
+    assert_equal events(:text_published, :shipping_published, :shipping_closed).map(&:id).sort, @response.parsed_body.pluck("id").sort
+  end
+
+  test "filter by multiple creators" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id, users(:david).id ])
+
+    assert_equal Event.where(board: boards(:writebook)).count, @response.parsed_body.count
+  end
+
+  test "filter by board" do
+    private_event = track(private_card, "card_closed")
+
+    get activities_path(format: :json, board_ids: [ boards(:private).id ])
+
+    assert_response :success
+    assert_includes @response.parsed_body.pluck("id"), private_event.id
+    assert @response.parsed_body.all? { it.dig("board", "id") == boards(:private).id }
+
+    get activities_path(format: :json, board_ids: [ boards(:writebook).id ])
+
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+    assert @response.parsed_body.all? { it.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "filter by board and creator" do
+    track(private_card, "card_closed", creator: users(:kevin))
+
+    get activities_path(format: :json, board_ids: [ boards(:writebook).id ], creator_ids: [ users(:kevin).id ])
+
+    assert_equal events(:text_published, :shipping_published, :shipping_closed).map(&:id).sort, @response.parsed_body.pluck("id").sort
+  end
+
+  test "only returns activity from accessible boards" do
+    private_event = track(private_card, "card_closed")
+
+    get activities_path(format: :json)
+    assert_includes @response.parsed_body.pluck("id"), private_event.id
+
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+
+    get activities_path(format: :json, board_ids: [ boards(:private).id ])
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+  end
+
+  test "does not return activity from other accounts" do
+    get activities_path(format: :json)
+
+    assert_not_includes @response.parsed_body.pluck("board").pluck("id"), boards(:miltons_wish_list).id
+  end
+
+  test "index is paginated" do
+    20.times { |index| track(cards(:logo), "card_triaged", particulars: { column: "Column #{index}" }) }
+    total = Event.where(board: boards(:writebook)).count
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    first_page = @response.parsed_body
+    assert_operator first_page.size, :<, total
+    assert_equal total.to_s, @response.headers["X-Total-Count"]
+    assert_match(/<(.+)>; rel="next"/, @response.headers["Link"])
+
+    next_url = @response.headers["Link"][/<(.+)>/, 1]
+    assert_includes next_url, "page=2"
+
+    get next_url
+
+    assert_response :success
+    second_page = @response.parsed_body
+    assert_equal total, first_page.size + second_page.size
+    assert_empty first_page.pluck("id") & second_page.pluck("id")
+    assert_operator Time.iso8601(first_page.last["created_at"]), :>=, Time.iso8601(second_page.first["created_at"])
+    assert_nil @response.headers["Link"]
+  end
+
+  test "pagination preserves filters" do
+    20.times { track(cards(:logo), "card_triaged", creator: users(:kevin)) }
+
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ])
+
+    next_url = @response.headers["Link"][/<(.+)>/, 1]
+    assert_includes CGI.unescape(next_url), "creator_ids[]=#{users(:kevin).id}"
+
+    get next_url
+
+    assert_response :success
+    assert @response.parsed_body.all? { it.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "index requires JSON" do
