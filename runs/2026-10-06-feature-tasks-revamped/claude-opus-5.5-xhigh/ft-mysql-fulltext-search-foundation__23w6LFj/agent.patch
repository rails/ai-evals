+class AddPlainTextBodyToActionTextRichTexts < ActiveRecord::Migration[8.2]
+  def change
+    add_column :action_text_rich_texts, :plain_text_body, :text, limit: 4_294_967_295 # LONGTEXT, like body
+
+    reversible do |dir|
+      dir.up { backfill_plain_text_bodies }
+    end
+  end
+
+  private
+    def backfill_plain_text_bodies
+      ActionText::RichText.reset_column_information
+
+      ActionText::RichText.find_each do |rich_text|
+        rich_text.update_column :plain_text_body, rich_text.body&.to_plain_text
+      end
+    end
+end
