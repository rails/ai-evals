diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..2c419c8
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,29 @@
+<% @page_title = @search.query.present? ? "Search: #{@search.query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel panel--wide center borderless unpad flex flex-column gap-half margin-block-start">
+  <%= form_with url: search_path, method: :get, role: "search" do |form| %>
+    <%= form.label :q, "Search cards and comments", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards and comments…", class: "input full-width",
+          autofocus: @search.query.blank?, autocomplete: "off", autocorrect: "off", data: { "1p-ignore": "true" } %>
+  <% end %>
+
+  <% if @search.terms.any? %>
+    <div class="flex flex-column gap-half">
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { terms: @search.terms, matching_comments: @matching_comments } %>
+      <% end %>
+    </div>
+
+    <% if @page.empty? %>
+      <div class="blank-slate align-self-center">No cards match “<%= @search.query %>”</div>
+    <% end %>
+  <% end %>
+</section>
