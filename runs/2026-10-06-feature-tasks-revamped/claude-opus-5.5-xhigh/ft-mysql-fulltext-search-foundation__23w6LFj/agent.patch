new file mode 100644
index 0000000..f7ea5b6
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "search by title, description, and comments" do
+    cards(:text).update!(description: "Use a bigger typeface")
+
+    assert_equal [ cards(:logo) ], Card.search([ "LOGO" ]).to_a
+    assert_equal [ cards(:text) ], Card.search([ "typeface" ]).to_a
+    assert_equal [ cards(:layout) ], Card.search([ "container" ]).to_a
+  end
+
+  test "search requires every term, wherever it appears on the card" do
+    assert_equal [ cards(:logo) ], Card.search([ "logo", "agree" ]).to_a
+    assert_empty Card.search([ "logo", "container" ])
+  end
+
+  test "search only finds published cards" do
+    cards(:logo).update!(status: :drafted)
+
+    assert_empty Card.search([ "logo" ])
+    assert_empty Card.search([ "agree" ])
+  end
+
+  test "search treats LIKE wildcards literally" do
+    cards(:text).update!(title: "Discount 100% of_it")
+
+    assert_equal [ cards(:text) ], Card.search([ "100%" ]).to_a
+    assert_equal [ cards(:text) ], Card.search([ "of_it" ]).to_a
+    assert_empty Card.search([ "%" ]).where.not(id: cards(:text))
+    assert_empty Card.search([ "_" ]).where.not(id: cards(:text))
+  end
+
+  test "search matches the plain text of rich text, not its markup" do
+    cards(:text).update!(description: %(<p>Research &amp; development by <action-text-attachment sgid="#{users(:jz).attachable_sgid}" content-type="application/vnd.actiontext.mention"></action-text-attachment></p>))
+
+    assert_equal [ cards(:text) ], Card.search([ "Research & development" ]).to_a
+    assert_equal [ cards(:text) ], Card.search([ "@jz" ]).to_a
+    assert_empty Card.search([ "amp" ])
+    assert_empty Card.search([ "mention" ])
+    assert_empty Card.search([ "attachment" ])
+  end
+
+  test "search falls back to the raw body for rich texts without a plain text copy" do
+    ActionText::RichText.insert_all!([ { id: ActiveRecord::Type::Uuid.generate, account_id: cards(:text).account_id, record_type: "Card", record_id: cards(:text).id, name: "description", body: "Imported description" } ])
+
+    assert_equal [ cards(:text) ], Card.search([ "imported" ]).to_a
+  end
+
+  test "plain text copy is kept in sync with the body" do
+    comment = cards(:logo).comments.create!(body: "<p>First <em>draft</em></p>")
+    assert_equal "First draft", comment.body.reload.plain_text_body
+
+    comment.update!(body: "<p>Second take</p>")
+    assert_equal "Second take", comment.body.reload.plain_text_body
+    assert_equal [ cards(:logo) ], Card.search([ "second take" ]).to_a
+    assert_empty Card.search([ "first draft" ])
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..a794a30
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "terms are words or quoted phrases" do
+    assert_equal [ "logo", "big enough", "now" ], Search.new(users(:kevin), %(  logo "big enough"   now )).terms
+  end
+
+  test "terms ignore stray quotes, blanks, and repeats" do
+    assert_equal [ "logo", "big" ], Search.new(users(:kevin), %(logo "" LOGO "big)).terms
+    assert_empty Search.new(users(:kevin), "   ").terms
+    assert_empty Search.new(users(:kevin), nil).terms
+  end
+
+  test "terms are capped" do
+    query = (1..20).map { "term#{it}" }.join(" ")
+
+    assert_equal Search::MAX_TERMS, Search.new(users(:kevin), query).terms.size
+  end
+
+  test "cards are limited to the boards the user can access" do
+    secret = boards(:private).cards.create!(title: "Logo secrets", status: :published, creator: users(:kevin))
+
+    assert_includes Search.new(users(:kevin), "logo").cards, secret
+    assert_not_includes Search.new(users(:david), "logo").cards, secret
+    assert_includes Search.new(users(:david), "logo").cards, cards(:logo)
+  end
+
+  test "no cards without terms" do
+    assert_empty Search.new(users(:kevin), "").cards
+  end
+
+  test "matching comments are the newest comment matching any term on each card" do
+    newest = cards(:logo).comments.create!(body: "Agreed, it is overflowing", created_at: 1.minute.ago)
+    cards(:logo).comments.create!(body: "Unrelated", created_at: Time.current)
+
+    search = Search.new(users(:kevin), "agree overflowing")
+    comments = search.matching_comments_for([ cards(:logo), cards(:layout), cards(:text) ])
+
+    assert_equal newest, comments[cards(:logo).id]
+    assert_equal comments(:layout_overflowing_david), comments[cards(:layout).id]
+    assert_not comments.key?(cards(:text).id)
+  end
+end
