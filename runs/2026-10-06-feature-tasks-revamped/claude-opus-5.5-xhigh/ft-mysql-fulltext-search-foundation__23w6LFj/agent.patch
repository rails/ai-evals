diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..f686c7e
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,145 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+
+    assert_response :success
+    assert_select "input[type=search][name=q]"
+    assert_select ".search__result", count: 0
+    assert_select ".search .blank-slate", count: 0
+  end
+
+  test "find cards by title" do
+    get search_path(q: "LOGO")
+
+    assert_response :success
+    assert_select "a.search__result[href=?]", card_path(cards(:logo)) do
+      assert_select ".card__title mark", text: "logo"
+    end
+    assert_select ".search__result", count: 1
+  end
+
+  test "find cards by description" do
+    with_current_user(:kevin) { cards(:text).update!(description: "<p>Bump the <strong>font size</strong> to 16px</p>") }
+
+    get search_path(q: "font")
+
+    assert_select "a.search__result[href=?]", card_path(cards(:text)) do
+      assert_select ".search__excerpt mark", text: "font"
+    end
+  end
+
+  test "find cards by comment body" do
+    get search_path(q: "overflowing")
+
+    assert_select "a.search__result[href=?]", card_path(cards(:layout)) do
+      assert_select ".search__excerpt", text: /David:/
+      assert_select ".search__excerpt mark", text: "overflowing"
+    end
+  end
+
+  test "every term must appear somewhere on the card" do
+    get search_path(q: "logo agree")
+    assert_select "a.search__result[href=?]", card_path(cards(:logo))
+
+    get search_path(q: "logo overflowing")
+    assert_select ".search__result", count: 0
+  end
+
+  test "results are newest first" do
+    older = create_card("Zeppelin older", created_at: 2.days.ago)
+    newer = create_card("Zeppelin newer", created_at: 1.day.ago)
+    commented = cards(:shipping).tap { it.update_column :created_at, 3.days.ago }
+    create_comment(commented, "Ship it on the zeppelin")
+
+    get search_path(q: "zeppelin")
+
+    assert_equal [ newer, older, commented ].map { card_path(it) }, css_select(".search__result").map { it["href"] }
+  end
+
+  test "only cards on boards the user can access" do
+    secret = create_card("Secret plans", board: boards(:private))
+    create_comment(secret, "Very secret indeed")
+
+    get search_path(q: "secret")
+    assert_select "a.search__result[href=?]", card_path(secret)
+
+    logout_and_sign_in_as :david
+    get search_path(q: "secret")
+    assert_select ".search__result", count: 0
+  end
+
+  test "access revoked after the fact hides results" do
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.revoke_from(users(:kevin))
+
+    get search_path(q: "logo")
+
+    assert_select ".search__result", count: 0
+  end
+
+  test "cards from other accounts never turn up" do
+    get search_path(q: "radio")
+
+    assert_select ".search__result", count: 0
+  end
+
+  test "draft cards and their comments never turn up" do
+    create_card("Quixotic draft", description: "Quixotic description", status: :drafted)
+
+    unpublished = create_card("Another card")
+    create_comment(unpublished, "Quixotic comment")
+    unpublished.update!(status: :drafted)
+
+    get search_path(q: "quixotic")
+
+    assert_select ".search__result", count: 0
+    assert_select ".search .blank-slate", text: /No cards match/
+  end
+
+  test "markup in rich text is not searchable" do
+    with_current_user(:kevin) { cards(:text).update!(description: "<p>Make it <strong>bigger</strong></p>") }
+
+    get search_path(q: "strong")
+
+    assert_select ".search__result", count: 0
+  end
+
+  test "query and content are escaped" do
+    card = create_card("Use <script> tags & co")
+
+    get search_path(q: "<script>")
+
+    assert_select "a.search__result[href=?]", card_path(card) do
+      assert_select ".card__title mark", text: "<script>"
+    end
+    assert_select "main script", count: 0
+    assert_includes response.body, "Use <mark>&lt;script&gt;</mark> tags &amp; co"
+  end
+
+  test "long comments show an excerpt around the match" do
+    create_comment(cards(:shipping), "#{"Lorem ipsum " * 50} needle #{"dolor sit " * 50}")
+
+    get search_path(q: "needle")
+
+    assert_select ".search__excerpt", text: /\A\s*Kevin:\s+…(ipsum Lorem |Lorem ipsum )+needle( dolor sit| sit dolor)+…\s*\z/
+  end
+
+  private
+    def create_card(title, board: boards(:writebook), **attributes)
+      with_current_user(:kevin) do
+        board.cards.create!(title: title, status: :published, creator: users(:kevin), **attributes)
+      end
+    end
+
+    def create_comment(card, body)
+      with_current_user(:kevin) do
+        card.comments.create!(body: body, creator: users(:kevin))
+      end
+    end
+end
