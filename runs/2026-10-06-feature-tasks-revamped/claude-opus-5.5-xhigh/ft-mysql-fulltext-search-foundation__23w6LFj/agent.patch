new file mode 100644
index 0000000..831add2
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,18 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    # Published cards where every term appears in the title, the description, or any comment.
+    scope :search, ->(terms) do
+      Array(terms).inject(published) { |cards, term| cards.containing(term) }
+    end
+
+    scope :containing, ->(term) do
+      in_title = arel_table[:title].matches("%#{sanitize_sql_like(term)}%", "\\")
+      in_description = ActionText::RichText.where(record_type: "Card", name: "description").where("action_text_rich_texts.record_id = cards.id").containing(term)
+      in_comments = Comment.joins(:rich_text_body).where("comments.card_id = cards.id").merge(ActionText::RichText.containing(term))
+
+      where in_title.or(in_description.arel.exists).or(in_comments.arel.exists)
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..587fbbf
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,45 @@
+class Search
+  MAX_TERMS = 10
+
+  attr_reader :query, :terms
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.squish
+    @terms = terms_from(@query)
+  end
+
+  def cards
+    if terms.any?
+      user.accessible_cards.search(terms).reverse_chronologically
+    else
+      Card.none
+    end
+  end
+
+  # The newest comment on each of the cards that contains any of the terms, keyed by card id.
+  def matching_comments_for(cards)
+    newest_ids = comments_containing_any_term.where(card_id: cards.map(&:id)).order(created_at: :desc, id: :desc).pluck(:card_id, :id).uniq(&:first).map(&:last)
+    Comment.where(id: newest_ids).with_rich_text_body.preload(:creator).index_by(&:card_id)
+  end
+
+  private
+    attr_reader :user
+
+    # Words, or "quoted phrases" that must appear together.
+    def terms_from(query)
+      query.scan(/"([^"]+)"|(\S+)/)
+        .map { |phrase, word| (phrase || word).delete('"').strip }
+        .compact_blank
+        .uniq(&:downcase)
+        .first(MAX_TERMS)
+    end
+
+    def comments_containing_any_term
+      if terms.any?
+        Comment.joins(:rich_text_body).merge(terms.map { ActionText::RichText.containing(it) }.inject(:or))
+      else
+        Comment.none
+      end
+    end
+end
