diff --git a/app/models/account/storage.rb b/app/models/account/storage.rb
new file mode 100644
index 0000000..cb33862
--- /dev/null
+++ b/app/models/account/storage.rb
@@ -0,0 +1,32 @@
+module Account::Storage
+  extend ActiveSupport::Concern
+
+  include ::Storage::Totaled
+
+  included do
+    # Storage only drifts when it changes, so there's no need to reconcile every
+    # account periodically, just those that changed since they were reconciled,
+    # plus those never reconciled, like the ones that existed before storage was
+    # tracked.
+    scope :due_for_storage_reconciliation, -> do
+      where(id: ::Storage::Total.changed_since_reconciled.select(:account_id))
+        .or(where.not(id: ::Storage::Total.where(owner_type: "Account").select(:owner_id)))
+    end
+  end
+
+  class_methods do
+    def reconcile_due_storage_later
+      due_for_storage_reconciliation.find_each(&:reconcile_storage_later)
+    end
+  end
+
+  def reconcile_storage
+    super
+    boards.find_each(&:reconcile_storage)
+  end
+
+  private
+    def storage_tracked_records
+      [ boards, cards, Comment.where(account: self) ]
+    end
+end
