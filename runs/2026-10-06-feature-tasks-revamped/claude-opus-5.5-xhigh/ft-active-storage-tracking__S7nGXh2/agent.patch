diff --git a/test/models/storage/reconciliation_test.rb b/test/models/storage/reconciliation_test.rb
new file mode 100644
index 0000000..1da32ec
--- /dev/null
+++ b/test/models/storage/reconciliation_test.rb
@@ -0,0 +1,152 @@
+require "test_helper"
+
+class Storage::ReconciliationTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "reconciling counts attachments whose changes weren't tracked" do
+    attach_without_tracking blob_of_size(100), to: @card, name: "image"
+    attach_without_tracking blob_of_size(20), to: rich_text_of(@card.comments.create!(body: "Untracked"))
+    attach_without_tracking blob_of_size(3), to: rich_text_of(@board.tap { it.update!(public_description: "Untracked") }, name: "public_description")
+
+    @account.reconcile_storage
+
+    assert_equal 123, @account.bytes_used
+    assert_equal 123, @board.bytes_used
+    assert_equal 0, boards(:private).bytes_used
+  end
+
+  test "reconciling corrects drift" do
+    @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+    perform_storage_jobs
+    Storage::Total.where(owner: [ @account, @board ]).update_all(bytes: 12345)
+
+    @account.reconcile_storage
+
+    assert_equal 100, @account.bytes_used
+    assert_equal 100, @board.bytes_used
+  end
+
+  test "reconciling doesn't count pending changes twice" do
+    @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+    assert Storage::Entry.where(owner: @board).exists?
+
+    @board.reconcile_storage
+    assert_equal 100, @board.bytes_used
+
+    perform_storage_jobs
+    assert_equal 100, @board.bytes_used
+  end
+
+  test "reconciling an account without any storage" do
+    accounts(:initech).reconcile_storage
+
+    assert_equal 0, accounts(:initech).bytes_used
+    assert Storage::Total.exists?(owner: accounts(:initech))
+  end
+
+  test "reconciling in the background" do
+    assert_enqueued_with job: Storage::ReconcileJob, args: [ @account ] do
+      @account.reconcile_storage_later
+    end
+
+    attach_without_tracking blob_of_size(100), to: @card, name: "image"
+    perform_storage_jobs
+
+    assert_equal 100, @account.bytes_used
+    assert_equal 100, @board.bytes_used
+  end
+
+  test "totals start out reconciled, so attachments from before storage was tracked count" do
+    attach_without_tracking blob_of_size(100), to: @card, name: "image"
+    @card.comments.create! body: attachment_html(blob_of_size(20))
+    perform_storage_jobs
+
+    assert_equal 120, @account.bytes_used
+    assert_equal 120, @board.bytes_used
+  end
+
+  test "removing attachments from before storage was tracked" do
+    attach_without_tracking blob_of_size(100), to: @card, name: "image"
+
+    @card.image.purge
+    perform_storage_jobs
+
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "concurrent reconciliations only correct a discrepancy once" do
+    attach_without_tracking blob_of_size(100), to: @card, name: "image"
+
+    # Another reconciliation completes after this one counts the bytes, but before it applies its correction
+    interleaved = false
+    interleave = ->(*, payload) do
+      if !interleaved && payload[:sql].include?("SUM(active_storage_blobs.byte_size)")
+        interleaved = true
+        Board.find(@board.id).reconcile_storage
+      end
+    end
+
+    ActiveSupport::Notifications.subscribed(interleave, "sql.active_record") do
+      @board.reconcile_storage
+    end
+
+    assert interleaved
+    assert_equal 100, @board.bytes_used
+  end
+
+  test "periodically reconciling accounts never reconciled before" do
+    Account.where.not(id: @account.id).find_each(&:reconcile_storage)
+
+    assert_enqueued_jobs 1, only: Storage::ReconcileJob do
+      Account.reconcile_due_storage_later
+    end
+    assert_enqueued_with job: Storage::ReconcileJob, args: [ @account ]
+  end
+
+  test "periodically reconciling accounts whose storage changed since they were reconciled" do
+    @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+    Account.find_each(&:reconcile_storage)
+
+    assert_no_enqueued_jobs only: Storage::ReconcileJob do
+      Account.reconcile_due_storage_later
+    end
+
+    @card.move_to boards(:private)
+    perform_storage_jobs
+
+    assert_enqueued_jobs 1, only: Storage::ReconcileJob do
+      Account.reconcile_due_storage_later
+    end
+    assert_enqueued_with job: Storage::ReconcileJob, args: [ @account ]
+  end
+
+  private
+    def perform_storage_jobs
+      perform_enqueued_jobs only: [ Storage::MaterializeJob, Storage::ReconcileJob ]
+    end
+
+    def blob_of_size(bytes)
+      ActiveStorage::Blob.create_and_upload! io: StringIO.new("x" * bytes), filename: "#{bytes}.txt", content_type: "text/plain"
+    end
+
+    def attachment_html(*blobs)
+      blobs.map { %(<action-text-attachment sgid="#{it.attachable_sgid}"></action-text-attachment>) }.join
+    end
+
+    def rich_text_of(record, name: "body")
+      ActionText::RichText.find_by!(record: record, name: name)
+    end
+
+    # Bypasses callbacks, like importing does
+    def attach_without_tracking(blob, to:, name: "embeds")
+      ActiveStorage::Attachment.insert_all [ { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, blob_id: blob.id,
+        record_type: to.class.name, record_id: to.id, name: name, created_at: Time.current } ]
+    end
+end
diff --git a/test/models/storage/tracking_test.rb b/test/models/storage/tracking_test.rb
new file mode 100644
index 0000000..0d63f7c
--- /dev/null
+++ b/test/models/storage/tracking_test.rb
@@ -0,0 +1,257 @@
+require "test_helper"
+
+class Storage::TrackingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+  end
+
+  test "nothing is used to begin with" do
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "card images are counted towards their board and account in the background" do
+    @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+
+    perform_enqueued_jobs
+
+    assert_equal 100, @account.bytes_used
+    assert_equal 100, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+  end
+
+  test "files embedded in card descriptions are counted" do
+    @card.update! description: attachment_html(blob_of_size(150))
+    perform_storage_jobs
+
+    assert_equal 150, @account.bytes_used
+    assert_equal 150, @board.bytes_used
+  end
+
+  test "files embedded in comments are counted" do
+    @card.comments.create! body: attachment_html(blob_of_size(120), blob_of_size(30))
+    perform_storage_jobs
+
+    assert_equal 150, @account.bytes_used
+    assert_equal 150, @board.bytes_used
+  end
+
+  test "files embedded in board descriptions are counted" do
+    @board.update! public_description: attachment_html(blob_of_size(80))
+    perform_storage_jobs
+
+    assert_equal 80, @account.bytes_used
+    assert_equal 80, @board.bytes_used
+  end
+
+  test "real images embedded in rich text are counted by their original size" do
+    blob = ActiveStorage::Blob.create_and_upload! io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    @card.comments.create! body: attachment_html(blob)
+    perform_storage_jobs
+
+    assert_equal file_fixture("moon.jpg").size, @board.bytes_used
+  end
+
+  test "accounts add up all their boards" do
+    @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+    @other_board.cards.create!(title: "Elsewhere", status: :published).comments.create! body: attachment_html(blob_of_size(50))
+    perform_storage_jobs
+
+    assert_equal 100, @board.bytes_used
+    assert_equal 50, @other_board.bytes_used
+    assert_equal 150, @account.bytes_used
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+
+  test "purging a card image" do
+    @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+    perform_storage_jobs
+
+    @card.image.purge_later
+    perform_storage_jobs
+
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "detaching a card image" do
+    @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+    @card.image.detach
+    perform_storage_jobs
+
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "replacing a card image" do
+    @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+    @card.image.attach io: StringIO.new("b" * 40), filename: "b.txt", content_type: "text/plain"
+    perform_storage_jobs
+
+    assert_equal 40, @account.bytes_used
+    assert_equal 40, @board.bytes_used
+  end
+
+  test "removing files from rich text" do
+    kept, removed = blob_of_size(10), blob_of_size(90)
+    @card.update! description: attachment_html(kept, removed)
+    perform_storage_jobs
+    assert_equal 100, @board.bytes_used
+
+    @card.update! description: attachment_html(kept)
+    perform_storage_jobs
+    assert_equal 10, @board.bytes_used
+
+    @card.update! description: "No more files"
+    perform_storage_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "destroying a comment" do
+    comment = @card.comments.create! body: attachment_html(blob_of_size(70))
+    perform_storage_jobs
+
+    comment.destroy!
+    perform_storage_jobs
+
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "destroying a card" do
+    @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+    @card.update! description: attachment_html(blob_of_size(20))
+    @card.comments.create! body: attachment_html(blob_of_size(3))
+    cards(:layout).comments.create! body: attachment_html(blob_of_size(5))
+    perform_storage_jobs
+    assert_equal 128, @board.bytes_used
+
+    @card.destroy!
+    perform_storage_jobs
+
+    assert_equal 5, @account.bytes_used
+    assert_equal 5, @board.bytes_used
+  end
+
+  test "destroying a board" do
+    @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+    @board.update! public_description: attachment_html(blob_of_size(10))
+    @other_board.update! public_description: attachment_html(blob_of_size(1))
+    perform_storage_jobs
+    assert_equal 111, @account.bytes_used
+
+    @board.destroy!
+    perform_storage_jobs
+
+    assert_equal 1, @account.bytes_used
+    assert_empty Storage::Entry.where(owner: @board)
+    assert_empty Storage::Total.where(owner: @board)
+  end
+
+  test "moving a card to another board moves its bytes, including its comments" do
+    @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+    @card.update! description: attachment_html(blob_of_size(20))
+    @card.comments.create! body: attachment_html(blob_of_size(3))
+    cards(:layout).comments.create! body: attachment_html(blob_of_size(5))
+    perform_storage_jobs
+
+    @card.move_to(@other_board)
+    perform_storage_jobs
+
+    assert_equal 5, @board.bytes_used
+    assert_equal 123, @other_board.bytes_used
+    assert_equal 128, @account.bytes_used
+  end
+
+  test "changing files while moving a card counts them towards the new board" do
+    @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+    @card.update! description: attachment_html(blob_of_size(20))
+    perform_storage_jobs
+
+    @card.update! board: @other_board, description: attachment_html(blob_of_size(7)),
+      image: ActiveStorage::Blob.create_and_upload!(io: StringIO.new("b" * 40), filename: "b.txt", content_type: "text/plain")
+    perform_storage_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 47, @other_board.bytes_used
+    assert_equal 47, @account.bytes_used
+  end
+
+  test "changes rolled back are not counted" do
+    Card.transaction do
+      @card.image.attach io: StringIO.new("a" * 100), filename: "a.txt", content_type: "text/plain"
+      raise ActiveRecord::Rollback
+    end
+    perform_storage_jobs
+
+    assert_equal 0, @account.bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "attachments that aren't on cards, comments, or boards are not counted" do
+    users(:david).avatar.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    Account::Export.create!(account: @account, user: users(:david)).file.attach io: StringIO.new("export"), filename: "export.zip"
+    perform_storage_jobs
+
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "a single materialization per owner is enqueued for each transaction" do
+    assert_enqueued_jobs 2, only: Storage::MaterializeJob do
+      @card.comments.create! body: attachment_html(blob_of_size(1), blob_of_size(2), blob_of_size(3))
+    end
+
+    assert_enqueued_with job: Storage::MaterializeJob, args: [ @account ]
+    assert_enqueued_with job: Storage::MaterializeJob, args: [ @board ]
+  end
+
+  test "entries are added up and deleted when materialized" do
+    @card.update! description: attachment_html(blob_of_size(1), blob_of_size(2))
+    assert_equal 4, Storage::Entry.count
+
+    perform_storage_jobs
+
+    assert_empty Storage::Entry.all
+    assert_equal 3, @board.bytes_used
+  end
+
+  test "materializing more entries than fit in a batch" do
+    @board.reconcile_storage
+    Storage::Entry.insert_all Array.new(Storage::Total::MATERIALIZATION_BATCH_SIZE * 2 + 1) {
+      { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, owner_type: "Board", owner_id: @board.id, delta: 2, created_at: Time.current }
+    }
+
+    @board.materialize_storage
+
+    assert_equal (Storage::Total::MATERIALIZATION_BATCH_SIZE * 2 + 1) * 2, @board.bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "materializing jobs for deleted owners are discarded" do
+    @board.update! public_description: attachment_html(blob_of_size(10))
+    @board.destroy!
+
+    assert_nothing_raised { perform_storage_jobs }
+  end
+
+  private
+    def perform_storage_jobs
+      perform_enqueued_jobs only: [ Storage::MaterializeJob, Storage::ReconcileJob ]
+    end
+
+    def blob_of_size(bytes)
+      ActiveStorage::Blob.create_and_upload! io: StringIO.new("x" * bytes), filename: "#{bytes}.txt", content_type: "text/plain"
+    end
+
+    def attachment_html(*blobs)
+      blobs.map { %(<action-text-attachment sgid="#{it.attachable_sgid}"></action-text-attachment>) }.join
+    end
+end
