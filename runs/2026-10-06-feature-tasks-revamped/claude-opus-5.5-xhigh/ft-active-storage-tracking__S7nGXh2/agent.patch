+module Card::Storage
+  extend ActiveSupport::Concern
+
+  include ::Storage::Tracked
+
+  included do
+    # Runs before the description and image are saved, so any changes to them
+    # get tracked against the new board afterwards.
+    after_update :transfer_storage, if: :saved_change_to_board_id?
+  end
+
+  private
+    def transfer_storage
+      if previous_board = account.boards.find_by(id: board_id_before_last_save)
+        bytes = Card.where(id: id).storage_bytes + comments.storage_bytes
+
+        previous_board.record_storage_change(-bytes)
+        board.record_storage_change(bytes)
+      end
+    end
+end
