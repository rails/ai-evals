diff --git a/app/models/concerns/storage/attachment_tracking.rb b/app/models/concerns/storage/attachment_tracking.rb
new file mode 100644
index 0000000..9d30ba8
--- /dev/null
+++ b/app/models/concerns/storage/attachment_tracking.rb
@@ -0,0 +1,49 @@
+# Records storage changes as attachments are created and removed for Storage::Tracked records,
+# either directly or through their rich text embeds.
+#
+# Included in ActiveStorage::Attachment from config/initializers/active_storage.rb.
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :record_storage_addition
+    before_destroy :record_storage_removal
+  end
+
+  # Purging and detaching delete attachments without running callbacks.
+  def delete
+    if persisted? && storage_tracked_record
+      transaction do
+        record_storage_removal
+        super
+      end
+    else
+      super
+    end
+  end
+
+  private
+    def record_storage_addition
+      storage_tracked_record&.record_storage_change(+blob_byte_size)
+    end
+
+    def record_storage_removal
+      if (tracked = storage_tracked_record) && still_stored?
+        tracked.record_storage_change(-blob_byte_size)
+      end
+    end
+
+    def storage_tracked_record
+      tracked = record.is_a?(ActionText::RichText) ? record.record : record
+      tracked if tracked.is_a?(Storage::Tracked)
+    end
+
+    # Locks the attachment, so that removing it more than once at the same time only counts once.
+    def still_stored?
+      self.class.lock.exists?(id)
+    end
+
+    def blob_byte_size
+      blob&.byte_size || 0
+    end
+end
diff --git a/app/models/concerns/storage/totaled.rb b/app/models/concerns/storage/totaled.rb
new file mode 100644
index 0000000..e457931
--- /dev/null
+++ b/app/models/concerns/storage/totaled.rb
@@ -0,0 +1,15 @@
+# Records that keep a total of the bytes used by their files, materialized in the background from
+# Storage::Entry records (see Account::Storage). Models also implement +calculate_bytes_used+, which
+# calculates the exact bytes used from the database: always right, but slower the more files there are.
+module Storage::Totaled
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_total, as: :owner, class_name: "Storage::Total", dependent: :delete
+  end
+
+  # Always read fresh, as totals change in the background.
+  def bytes_used
+    reload_storage_total&.bytes_stored || 0
+  end
+end
diff --git a/app/models/concerns/storage/tracked.rb b/app/models/concerns/storage/tracked.rb
new file mode 100644
index 0000000..292022d
--- /dev/null
+++ b/app/models/concerns/storage/tracked.rb
@@ -0,0 +1,33 @@
+# Records whose files count towards the storage used by their board and account: files attached
+# directly to them (like card images) and files embedded in their rich text (like descriptions and comments).
+#
+# Changes are recorded by Storage::AttachmentTracking as attachments come and go.
+module Storage::Tracked
+  extend ActiveSupport::Concern
+
+  class_methods do
+    # Exact bytes used by the files of the records in scope, calculated from the database.
+    def storage_bytes
+      bytes_attached_to(all) + bytes_attached_to(ActionText::RichText.where(record: all))
+    end
+
+    private
+      # Each attachment counts, even if it shares its blob with another one.
+      def bytes_attached_to(records)
+        ActiveStorage::Attachment.where(record: records).joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+  end
+
+  def storage_bytes
+    self.class.where(id: id).storage_bytes
+  end
+
+  def record_storage_change(delta, board: storage_board)
+    Storage::Entry.record account: account, board: board, delta: delta
+  end
+
+  private
+    def storage_board
+      board
+    end
+end
