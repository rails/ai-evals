--- /dev/null
+++ b/test/models/storage/entry_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Storage::EntryTest < ActiveSupport::TestCase
+  test "record changes" do
+    assert_difference -> { Storage::Entry.count }, +1 do
+      Storage::Entry.record account: accounts("37s"), board: boards(:writebook), delta: -20
+    end
+
+    assert_equal -20, Storage::Entry.last.delta
+  end
+
+  test "skip changes that change nothing" do
+    assert_no_difference -> { Storage::Entry.count } do
+      Storage::Entry.record account: accounts("37s"), board: boards(:writebook), delta: 0
+    end
+  end
+
+  test "materialize later once per account and transaction" do
+    assert_enqueued_jobs 2, only: Storage::MaterializeJob do
+      Storage::Entry.transaction do
+        3.times { Storage::Entry.record account: accounts("37s"), board: boards(:writebook), delta: 10 }
+        Storage::Entry.record account: accounts(:initech), board: boards(:miltons_wish_list), delta: 10
+      end
+    end
+
+    assert_enqueued_jobs 1, only: Storage::MaterializeJob do
+      Storage::Entry.record account: accounts("37s"), board: boards(:writebook), delta: 10
+    end
+  end
+end
