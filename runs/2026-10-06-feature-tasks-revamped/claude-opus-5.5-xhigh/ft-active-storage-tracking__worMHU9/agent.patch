@@ -0,0 +1,28 @@
+require "test_helper"
+
+class Storage::MaterializeJobTest < ActiveJob::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "materializes the account storage" do
+    cards(:logo).image.attach create_blob(bytes: 20)
+
+    Storage::MaterializeJob.perform_now(accounts("37s"))
+
+    assert_equal 20, accounts("37s").bytes_used
+    assert_equal 20, boards(:writebook).bytes_used
+  end
+
+  test "one job at a time per account" do
+    assert_equal Storage::MaterializeJob.new(accounts("37s")).concurrency_key, Storage::ReconcileJob.new(accounts("37s")).concurrency_key
+    assert_not_equal Storage::MaterializeJob.new(accounts("37s")).concurrency_key, Storage::MaterializeJob.new(accounts(:initech)).concurrency_key
+  end
+
+  test "discarded when the account is gone" do
+    accounts("37s").materialize_storage_later
+    accounts("37s").destroy!
+
+    assert_nothing_raised { perform_enqueued_jobs only: Storage::MaterializeJob }
+  end
+end
