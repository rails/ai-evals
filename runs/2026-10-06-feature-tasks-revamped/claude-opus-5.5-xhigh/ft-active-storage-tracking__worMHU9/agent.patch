diff --git a/app/models/account/storage.rb b/app/models/account/storage.rb
new file mode 100644
index 0000000..7e04364
--- /dev/null
+++ b/app/models/account/storage.rb
@@ -0,0 +1,120 @@
+# Accounts and their boards keep a running total of the bytes used by their files, materialized in the
+# background from the entries recorded as attachments come and go (see Storage::Entry).
+#
+# Materializing only reads the entries recorded since the last time, so it costs the same for accounts with
+# a handful of files as for those with millions. All the totals of an account are updated while holding a
+# lock on its own total, which keeps concurrent jobs from counting the same entry twice.
+module Account::Storage
+  extend ActiveSupport::Concern
+  include ::Storage::Totaled
+
+  MATERIALIZATION_BATCH_SIZE = 1000
+
+  included do
+    has_many :storage_entries, class_name: "Storage::Entry", dependent: :delete_all
+    has_many :storage_totals, class_name: "Storage::Total", dependent: :delete_all
+
+    around_destroy :suppress_storage_entries
+  end
+
+  def materialize_storage_later
+    Current.with_account(self) { ::Storage::MaterializeJob.perform_later(self) }
+  end
+
+  # Totals start from a full calculation, which picks up the files stored before tracking began.
+  def materialize_storage
+    if ::Storage::Total.exists?(owner: self)
+      materialize_storage_entries
+    else
+      reconcile_storage
+    end
+  end
+
+  def reconcile_storage_later
+    Current.with_account(self) { ::Storage::ReconcileJob.perform_later(self) }
+  end
+
+  # Recalculates every total from scratch, like after importing files in bulk. Boards are calculated
+  # one at a time, to keep transactions short for large accounts.
+  def reconcile_storage
+    boards.find_each { reconcile_board_storage(it) }
+    reconcile_account_storage
+    materialize_storage_entries
+  end
+
+  def calculate_bytes_used
+    boards.find_each.sum(&:calculate_bytes_used)
+  end
+
+  private
+    # Everything goes away along with the account, so there's nothing left to count.
+    def suppress_storage_entries(&)
+      ::Storage::Entry.suppress(&)
+    end
+
+    def materialize_storage_entries
+      loop do
+        entries = with_storage_lock { |total| materialize_storage_entries_batch(into: total) }
+        break if entries.size < MATERIALIZATION_BATCH_SIZE
+      end
+    end
+
+    def materialize_storage_entries_batch(into:)
+      entries = storage_entries.limit(MATERIALIZATION_BATCH_SIZE).to_a
+
+      if entries.any?
+        increment_board_storage_totals(entries)
+        into.increment! :bytes_stored, entries.sum(&:delta), touch: true
+        storage_entries.where(id: entries).delete_all
+      end
+
+      entries
+    end
+
+    # Entries for boards that no longer exist only count towards the account.
+    def increment_board_storage_totals(entries)
+      entries.group_by(&:board_id).each do |board_id, board_entries|
+        if board = boards.find_by(id: board_id)
+          storage_total_for(board).increment! :bytes_stored, board_entries.sum(&:delta), touch: true
+        end
+      end
+    end
+
+    # Boards created since the account was reconciled start from their exact usage too.
+    def storage_total_for(board)
+      board.storage_total || board.create_storage_total!(account: self, bytes_stored: board.calculate_bytes_used - pending_storage_bytes(board))
+    end
+
+    def reconcile_board_storage(board)
+      with_storage_lock do
+        total = board.storage_total || board.build_storage_total(account: self)
+        total.update! bytes_stored: board.calculate_bytes_used - pending_storage_bytes(board)
+      end
+    end
+
+    # With every board reconciled, the account total follows from theirs.
+    def reconcile_account_storage
+      with_storage_lock do |total|
+        boards_bytes = storage_totals.where(owner: boards).sum(:bytes_stored)
+        removed_boards_pending_bytes = storage_entries.where.not(board: boards).sum(:delta)
+
+        total.update! bytes_stored: boards_bytes - removed_boards_pending_bytes
+        storage_totals.where(owner_type: "Board").where.not(owner: boards).delete_all
+      end
+    end
+
+    def pending_storage_bytes(board)
+      storage_entries.where(board: board).sum(:delta)
+    end
+
+    # The total is locked before reading anything else in the transaction, so that every read
+    # sees the work of whoever held the lock before.
+    def with_storage_lock
+      total = ::Storage::Total.find_by(owner: self) || ::Storage::Total.create_or_find_by!(owner: self, account: self)
+
+      transaction do
+        total.lock!
+        yield total
+      end
+    end
+end
