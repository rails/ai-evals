+module StorageTestHelper
+  def create_blob(bytes: 1.kilobyte, filename: "file.txt")
+    ActiveStorage::Blob.create_and_upload! io: StringIO.new("x" * bytes), filename: filename
+  end
+
+  def embed(*blobs)
+    blobs.map { ActionText::Attachment.from_attachable(it).to_html }.join
+  end
+
+  def perform_storage_jobs
+    perform_enqueued_jobs only: [ Storage::MaterializeJob, Storage::ReconcileJob ]
+  end
+end
