+class Storage::MaterializeJob < ApplicationJob
+  queue_as :backend
+
+  # Shared with reconciliation: one storage job at a time per account
+  limits_concurrency key: ->(account) { account }, group: "Storage"
+
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::LockWaitTimeout
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account)
+    account.materialize_storage
+  end
+end
