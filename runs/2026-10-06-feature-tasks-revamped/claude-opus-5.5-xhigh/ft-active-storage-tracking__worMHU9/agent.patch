@@ -0,0 +1,23 @@
+# A board counts the files embedded in its description, plus everything counted on its cards.
+module Board::Storage
+  extend ActiveSupport::Concern
+  include ::Storage::Tracked, ::Storage::Totaled
+
+  CALCULATION_BATCH_SIZE = 1000
+
+  def calculate_bytes_used
+    storage_bytes + calculate_cards_bytes_used
+  end
+
+  private
+    def storage_board
+      self
+    end
+
+    # Batches over a fresh relation, as batches of an already loaded +cards+ association aren't scoped.
+    def calculate_cards_bytes_used
+      Card.where(board: self).in_batches(of: CALCULATION_BATCH_SIZE).sum do |cards|
+        cards.storage_bytes + Comment.where(card: cards).storage_bytes
+      end
+    end
+end
