diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..68e86e1
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,30 @@
+# A pending change to the bytes used by an account and one of its boards.
+#
+# Entries are recorded in the same transaction as the attachment changes they reflect, so recording them
+# never contends for a shared row, no matter how many people are uploading files at once. They're folded
+# into the account and board totals in the background, and deleted once they've been counted.
+class Storage::Entry < ApplicationRecord
+  # A single transaction can record lots of entries, like when destroying a board with many attachments,
+  # but one materialization per account is all it takes to count all of them.
+  MATERIALIZATIONS_BY_TRANSACTION = ObjectSpace::WeakKeyMap.new
+
+  belongs_to :account
+  belongs_to :board
+
+  after_create :materialize_later
+
+  def self.record(account:, board:, delta:)
+    create!(account: account, board: board, delta: delta) unless delta.zero?
+  end
+
+  private
+    def materialize_later
+      if materializations_in_current_transaction.add?(account_id)
+        account.materialize_storage_later
+      end
+    end
+
+    def materializations_in_current_transaction
+      MATERIALIZATIONS_BY_TRANSACTION[self.class.current_transaction] ||= Set.new
+    end
+end
