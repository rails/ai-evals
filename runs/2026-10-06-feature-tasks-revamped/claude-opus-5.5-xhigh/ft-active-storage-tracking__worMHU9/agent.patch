diff --git a/test/models/account/storage_test.rb b/test/models/account/storage_test.rb
new file mode 100644
index 0000000..936d788
--- /dev/null
+++ b/test/models/account/storage_test.rb
@@ -0,0 +1,176 @@
+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @account = accounts("37s")
+    @board = boards(:writebook)
+  end
+
+  test "nothing is used until something is stored" do
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "counts everything counted across its boards" do
+    @board.update! public_description: embed(create_blob(bytes: 1))
+    cards(:logo).image.attach create_blob(bytes: 20)
+    cards(:layout).comments.create! body: embed(create_blob(bytes: 300))
+    boards(:private).update! public_description: embed(create_blob(bytes: 4000))
+    perform_storage_jobs
+
+    assert_equal 4321, @account.bytes_used
+    assert_equal 4321, @account.boards.sum(&:bytes_used)
+  end
+
+  test "doesn't count other accounts" do
+    cards(:logo).image.attach create_blob(bytes: 20)
+    Current.with(account: accounts(:initech)) { cards(:radio).image.attach create_blob(bytes: 300) }
+    perform_storage_jobs
+
+    assert_equal 20, @account.bytes_used
+    assert_equal 300, accounts(:initech).bytes_used
+  end
+
+  test "stays up to date without reloading" do
+    assert_equal 0, @account.bytes_used
+
+    cards(:logo).image.attach create_blob(bytes: 20)
+    perform_storage_jobs
+
+    assert_equal 20, @account.bytes_used
+  end
+
+  test "destroying a board frees its storage" do
+    cards(:logo).image.attach create_blob(bytes: 20)
+    boards(:private).update! public_description: embed(create_blob(bytes: 300))
+    perform_storage_jobs
+
+    @board.destroy!
+    perform_storage_jobs
+
+    assert_equal 300, @account.bytes_used
+    assert_not Storage::Total.exists?(owner: @board)
+    assert_empty Storage::Entry.where(board: @board)
+  end
+
+  test "starts from the files stored before tracking began" do
+    Storage::Entry.suppress do
+      cards(:logo).image.attach create_blob(bytes: 20)
+      boards(:private).update! public_description: embed(create_blob(bytes: 300))
+    end
+
+    cards(:layout).image.attach create_blob(bytes: 4000)
+    perform_storage_jobs
+
+    assert_equal 4320, @account.bytes_used
+    assert_equal 4020, @board.bytes_used
+    assert_equal 300, boards(:private).bytes_used
+  end
+
+  test "new boards start from their exact usage" do
+    cards(:logo).image.attach create_blob(bytes: 20)
+    perform_storage_jobs
+
+    board = @account.boards.create!(name: "New board", creator: users(:david))
+    Storage::Entry.suppress { board.update! public_description: embed(create_blob(bytes: 300)) }
+    board.cards.create!(title: "New card").image.attach create_blob(bytes: 4000)
+    perform_storage_jobs
+
+    assert_equal 4300, board.bytes_used
+  end
+
+  test "reconcile recalculates every total" do
+    cards(:logo).image.attach create_blob(bytes: 20)
+    boards(:private).update! public_description: embed(create_blob(bytes: 300))
+    perform_storage_jobs
+
+    Storage::Total.update_all bytes_stored: 1.gigabyte
+    gone = @account.boards.create!(name: "Gone", creator: users(:david))
+    orphan = gone.create_storage_total!(account: @account)
+    gone.delete
+    Storage::Entry.suppress { cards(:layout).image.attach create_blob(bytes: 4000) }
+
+    @account.reconcile_storage_later
+    perform_storage_jobs
+
+    assert_equal 4320, @account.bytes_used
+    assert_equal 4020, @board.bytes_used
+    assert_equal 300, boards(:private).bytes_used
+    assert_not Storage::Total.exists?(orphan.id)
+  end
+
+  test "reconcile keeps changes that are still pending" do
+    cards(:logo).image.attach create_blob(bytes: 20)
+    perform_storage_jobs
+
+    cards(:layout).image.attach create_blob(bytes: 300)
+    @board.destroy!
+    boards(:private).update! public_description: embed(create_blob(bytes: 4000))
+    assert_equal 4, @account.storage_entries.count
+
+    @account.reconcile_storage
+
+    assert_equal 4000, @account.bytes_used
+    assert_equal 4000, boards(:private).bytes_used
+    assert_empty @account.storage_entries
+  end
+
+  test "calculate bytes used from the database" do
+    cards(:logo).image.attach create_blob(bytes: 20)
+    boards(:private).update! public_description: embed(create_blob(bytes: 300))
+    Current.with(account: accounts(:initech)) { cards(:radio).image.attach create_blob(bytes: 4000) }
+
+    assert_equal 320, @account.calculate_bytes_used
+  end
+
+  test "materializes pending changes in batches" do
+    stub_const(Account::Storage, :MATERIALIZATION_BATCH_SIZE, 2) do
+      @board.cards.each_with_index { |card, index| card.image.attach create_blob(bytes: 10**index) }
+      perform_storage_jobs
+
+      assert_equal 11111, @account.bytes_used
+      assert_equal 11111, @board.bytes_used
+      assert_empty @account.storage_entries
+    end
+  end
+
+  test "materializes once per transaction" do
+    card = cards(:logo)
+    card.update! description: embed(*3.times.map { create_blob(bytes: 10) })
+    card.comments.create! body: embed(*3.times.map { create_blob(bytes: 100) })
+    perform_storage_jobs
+
+    assert_enqueued_jobs 1, only: Storage::MaterializeJob do
+      card.destroy!
+    end
+
+    perform_storage_jobs
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "doesn't materialize changes that were rolled back" do
+    assert_no_enqueued_jobs only: Storage::MaterializeJob do
+      Card.transaction do
+        cards(:logo).image.attach create_blob(bytes: 20)
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_empty @account.storage_entries
+  end
+
+  test "destroying the account leaves nothing behind" do
+    cards(:logo).image.attach create_blob(bytes: 20)
+    perform_storage_jobs
+    cards(:layout).image.attach create_blob(bytes: 300)
+
+    assert_no_enqueued_jobs only: Storage::MaterializeJob do
+      @account.destroy!
+    end
+    perform_storage_jobs
+
+    assert_empty Storage::Entry.where(account: @account)
+    assert_empty Storage::Total.where(account: @account)
+  end
+end
diff --git a/test/models/board/storage_test.rb b/test/models/board/storage_test.rb
new file mode 100644
index 0000000..0a0a105
--- /dev/null
+++ b/test/models/board/storage_test.rb
@@ -0,0 +1,184 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "nothing is used until something is stored" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, Board.new.bytes_used
+  end
+
+  test "counts card images" do
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+    perform_storage_jobs
+
+    assert_equal file_fixture("moon.jpg").size, @board.bytes_used
+  end
+
+  test "counts files embedded in the board description, card descriptions, and comments" do
+    @board.update! public_description: embed(create_blob(bytes: 100))
+    @card.update! description: embed(create_blob(bytes: 20), create_blob(bytes: 3))
+    @card.comments.create! body: embed(create_blob(bytes: 4000))
+    perform_storage_jobs
+
+    assert_equal 4123, @board.bytes_used
+  end
+
+  test "counts each board on its own" do
+    @card.image.attach create_blob(bytes: 10)
+    cards(:radio).image.attach create_blob(bytes: 20)
+    boards(:private).update! public_description: embed(create_blob(bytes: 30))
+    perform_storage_jobs
+
+    assert_equal 10, @board.bytes_used
+    assert_equal 20, boards(:miltons_wish_list).bytes_used
+    assert_equal 30, boards(:private).bytes_used
+  end
+
+  test "doesn't count files attached elsewhere" do
+    users(:david).avatar.attach io: file_fixture("avatar.png").open, filename: "avatar.png"
+    Account::Export.create!(account: @board.account, user: users(:david)).file.attach create_blob(bytes: 500)
+    perform_storage_jobs
+
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "counts original files, not their variants" do
+    image = ActiveStorage::Blob.create_and_upload! io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+    @card.comments.create! body: embed(image)
+    perform_enqueued_jobs only: ActiveStorage::TransformJob
+    perform_storage_jobs
+
+    assert ActiveStorage::VariantRecord.exists?(blob: image)
+    assert_equal file_fixture("moon.jpg").size, @board.bytes_used
+  end
+
+  test "stays up to date as files come and go" do
+    @card.image.attach create_blob(bytes: 100)
+    comment = @card.comments.create!(body: embed(create_blob(bytes: 20)))
+    perform_storage_jobs
+    assert_equal 120, @board.bytes_used
+
+    @card.image.attach create_blob(bytes: 300)
+    perform_storage_jobs
+    assert_equal 320, @board.bytes_used
+
+    @card.image.purge_later
+    perform_storage_jobs
+    assert_equal 20, @board.bytes_used
+
+    comment.update! body: embed(create_blob(bytes: 7), create_blob(bytes: 8))
+    perform_storage_jobs
+    assert_equal 15, @board.bytes_used
+
+    comment.destroy!
+    perform_storage_jobs
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "detaching and purging files directly" do
+    @card.image.attach create_blob(bytes: 100)
+    @card.update! description: embed(create_blob(bytes: 20))
+    perform_storage_jobs
+    assert_equal 120, @board.bytes_used
+
+    @card.image.detach
+    @card.description.embeds.first.purge
+    perform_storage_jobs
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "removing the same file twice only counts once" do
+    @card.image.attach create_blob(bytes: 100)
+    comment = @card.comments.create!(body: embed(create_blob(bytes: 20)))
+    cards(:layout).image.attach create_blob(bytes: 3)
+    perform_storage_jobs
+
+    image, stale_image = @card.image.attachment, ActiveStorage::Attachment.find(@card.image.attachment.id)
+    embed, stale_embed = comment.body.embeds.first, ActiveStorage::Attachment.find(comment.body.embeds.first.id)
+
+    image.purge_later
+    stale_image.purge_later
+    embed.destroy!
+    stale_embed.destroy!
+    perform_storage_jobs
+
+    assert_equal 3, @board.bytes_used
+  end
+
+  test "destroying cards frees their storage" do
+    @card.image.attach create_blob(bytes: 100)
+    @card.update! description: embed(create_blob(bytes: 20))
+    @card.comments.create! body: embed(create_blob(bytes: 3))
+    cards(:layout).image.attach create_blob(bytes: 4000)
+    perform_storage_jobs
+    assert_equal 4123, @board.bytes_used
+
+    @card.destroy!
+    perform_storage_jobs
+    assert_equal 4000, @board.bytes_used
+  end
+
+  test "counts drafts too" do
+    draft = @board.cards.create!(title: "Draft", status: :drafted)
+    draft.image.attach create_blob(bytes: 42)
+    perform_storage_jobs
+
+    assert_equal 42, @board.bytes_used
+  end
+
+  test "moving a card moves its storage along" do
+    other_board = boards(:private)
+    @card.image.attach create_blob(bytes: 100)
+    @card.update! description: embed(create_blob(bytes: 20))
+    @card.comments.create! body: embed(create_blob(bytes: 3))
+    cards(:layout).image.attach create_blob(bytes: 4000)
+    perform_storage_jobs
+
+    @card.move_to(other_board)
+    perform_storage_jobs
+
+    assert_equal 4000, @board.bytes_used
+    assert_equal 123, other_board.bytes_used
+    assert_equal 4123, @board.account.bytes_used
+
+    @card.comments.create! body: embed(create_blob(bytes: 5000))
+    perform_storage_jobs
+    assert_equal 4000, @board.bytes_used
+    assert_equal 5123, other_board.bytes_used
+  end
+
+  test "moving a card while changing its files" do
+    other_board = boards(:private)
+    @card.image.attach create_blob(bytes: 100)
+    perform_storage_jobs
+
+    @card.update! board: other_board, image: create_blob(bytes: 7), description: embed(create_blob(bytes: 20))
+    perform_storage_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 27, other_board.bytes_used
+  end
+
+  test "calculate bytes used from the database" do
+    @board.update! public_description: embed(create_blob(bytes: 100))
+    @card.image.attach create_blob(bytes: 20)
+    cards(:layout).comments.create! body: embed(create_blob(bytes: 3))
+    cards(:radio).image.attach create_blob(bytes: 4000)
+
+    assert_equal 123, @board.calculate_bytes_used
+  end
+
+  test "calculate bytes used in batches" do
+    stub_const(Board::Storage, :CALCULATION_BATCH_SIZE, 2) do
+      @board.cards.each_with_index { |card, index| card.image.attach create_blob(bytes: 10**index) }
+
+      assert_equal 11111, @board.calculate_bytes_used
+    end
+  end
+end
diff --git a/test/models/storage/entry_test.rb b/test/models/storage/entry_test.rb
