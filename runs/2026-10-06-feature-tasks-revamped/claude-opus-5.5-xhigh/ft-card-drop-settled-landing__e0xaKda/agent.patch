diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..ec3629b
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,288 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+
+    visit board_url(boards(:writebook))
+    assert_selector "##{dom_id(columns(:writebook_triage))} .card", visible: :all # Columns load their cards lazily
+    count_saved_drops
+  end
+
+  test "a card dropped into a column is there right away, behind the column's golden cards" do
+    holding_saves do
+      drag cards(:buy_domain), to: columns(:writebook_triage)
+
+      assert_cards_in columns(:writebook_triage), :logo, :buy_domain, :layout
+      assert_no_cards_in "maybe"
+      assert_count columns(:writebook_triage), 3
+      assert_count "maybe", 0
+      assert_nil cards(:buy_domain).reload.column, "The board shouldn't wait for the save"
+    end
+
+    wait_for_saved_drops 1
+    assert_equal columns(:writebook_triage), cards(:buy_domain).reload.column
+    assert_cards_in columns(:writebook_triage), :logo, :buy_domain, :layout
+    assert_count columns(:writebook_triage), 3
+    assert_board_unchanged_by_reloading
+  end
+
+  test "a golden card goes first" do
+    expand columns(:writebook_triage)
+    drag cards(:logo), to: columns(:writebook_in_progress)
+
+    assert_cards_in columns(:writebook_in_progress), :logo, :text
+    assert_cards_in columns(:writebook_triage), :layout
+
+    wait_for_saved_drops 1
+    assert_equal columns(:writebook_in_progress), cards(:logo).reload.column
+    assert_cards_in columns(:writebook_in_progress), :logo, :text
+    assert_board_unchanged_by_reloading
+  end
+
+  test "dropping a card on Done closes it, newest first even ahead of golden cards" do
+    cards(:shipping).gild
+    visit board_url(boards(:writebook))
+    count_saved_drops
+
+    expand columns(:writebook_triage)
+    drag cards(:layout), to: "closed-cards"
+
+    assert_cards_in "closed-cards", :layout, :shipping
+    assert_count "closed-cards", 2
+    assert_count columns(:writebook_triage), 1
+
+    wait_for_saved_drops 1
+    assert cards(:layout).reload.closed?
+    assert_cards_in "closed-cards", :layout, :shipping
+    assert_board_unchanged_by_reloading
+  end
+
+  test "dropping a card on Not Now postpones it" do
+    expand columns(:writebook_in_progress)
+    drag cards(:text), to: "not-now"
+
+    assert_cards_in "not-now", :text
+    assert_no_cards_in columns(:writebook_in_progress)
+    assert_count "not-now", 1
+
+    wait_for_saved_drops 1
+    assert cards(:text).reload.postponed?
+    assert_cards_in "not-now", :text
+    assert_board_unchanged_by_reloading
+  end
+
+  test "a card dragged out of Done looks back in play right away" do
+    expand "closed-cards"
+
+    holding_saves do
+      drag cards(:shipping), to: "maybe"
+
+      assert_cards_in "maybe", :shipping, :buy_domain
+      assert_looks_in_play cards(:shipping)
+    end
+
+    wait_for_saved_drops 1
+    assert cards(:shipping).reload.awaiting_triage?
+    assert_cards_in "maybe", :shipping, :buy_domain
+    assert_looks_in_play cards(:shipping)
+    assert_board_unchanged_by_reloading
+  end
+
+  test "a card dragged out of Not Now looks back in play right away" do
+    Current.set(user: users(:david)) { cards(:text).postpone }
+    visit board_url(boards(:writebook))
+    count_saved_drops
+
+    expand "not-now"
+
+    holding_saves do
+      drag cards(:text), to: "maybe"
+
+      assert_cards_in "maybe", :text, :buy_domain
+      assert_looks_in_play cards(:text)
+    end
+
+    wait_for_saved_drops 1
+    assert cards(:text).reload.awaiting_triage?
+    assert_looks_in_play cards(:text)
+    assert_board_unchanged_by_reloading
+  end
+
+  test "dropping a card back on its own column does nothing" do
+    drag cards(:buy_domain), to: "maybe"
+
+    assert_cards_in "maybe", :buy_domain
+    assert_count "maybe", 1
+    assert_no_selector ".drag-and-drop__hover-container, .drag-and-drop__dragged-item"
+  end
+
+  test "the column under a dragged card lights up and the card dims" do
+    card = find("##{dom_id(cards(:buy_domain), :article)}")
+
+    start_dragging card
+    assert_not drag_over(find("#maybe")), "Can't drop a card on its own column"
+    assert drag_over(find("##{dom_id(columns(:writebook_triage))}"))
+
+    assert_selector "##{dom_id(columns(:writebook_triage))}.drag-and-drop__hover-container"
+    assert_selector ".drag-and-drop__hover-container", count: 1
+    assert_selector "##{dom_id(cards(:buy_domain), :article)}.drag-and-drop__dragged-item"
+
+    stop_dragging card
+    assert_no_selector ".drag-and-drop__hover-container, .drag-and-drop__dragged-item"
+    assert_cards_in "maybe", :buy_domain
+  end
+
+  test "counts past 99" do
+    set_count "maybe", 100
+    set_count columns(:writebook_triage), 99
+
+    drag cards(:buy_domain), to: columns(:writebook_triage)
+
+    assert_count "maybe", 99
+    assert_count columns(:writebook_triage), "99+"
+  end
+
+  test "a card dragged twice before saving ends up where it was dropped last" do
+    expand columns(:writebook_triage)
+
+    holding_saves do
+      drag cards(:buy_domain), to: columns(:writebook_triage)
+      drag cards(:buy_domain), to: "closed-cards"
+    end
+
+    wait_for_saved_drops 2
+    assert cards(:buy_domain).reload.closed?
+    assert_cards_in "closed-cards", :buy_domain, :shipping
+    assert_cards_in columns(:writebook_triage), :logo, :layout
+    assert_board_unchanged_by_reloading
+  end
+
+  test "a card that can't be moved is shown as it really is" do
+    cards(:buy_domain).destroy
+
+    drag cards(:buy_domain), to: columns(:writebook_triage)
+
+    assert_no_selector "##{dom_id(cards(:buy_domain), :article)}", visible: :all
+    assert_count columns(:writebook_triage), 2
+  end
+
+  test "a card dropped after being signed out isn't shown as moved" do
+    Session.delete_all
+
+    drag cards(:buy_domain), to: columns(:writebook_triage)
+
+    assert_no_selector ".card-columns"
+    assert_nil cards(:buy_domain).reload.column
+  end
+
+  private
+    # What's on the board after dropping is what the server shows once it's saved
+    def assert_board_unchanged_by_reloading
+      board = board_as_shown
+      visit board_url(boards(:writebook))
+      assert_equal board, board_as_shown
+    end
+
+    def board_as_shown
+      assert_no_selector ".card-columns turbo-frame[src]:not([complete])", visible: :all
+
+      all("[data-drag-and-drop-target~='container']", visible: :all).to_h do |column|
+        cards = column.all("[data-drag-and-drop-target~='item']", visible: :all, wait: 0).map { it[:id] }
+        count = column.find(".cards__expander-count", visible: :all).text(:all)
+        [ column[:id], { cards:, count: } ]
+      end
+    end
+
+    def drag(card, to:)
+      find("##{dom_id(card, :article)}").drag_to find(column_selector(to))
+    end
+
+    def expand(column)
+      within(column_selector(column)) { find(".cards__expander").click }
+      assert_selector "#{column_selector(column)}.is-expanded"
+    end
+
+    def column_selector(column)
+      "#" + (column.is_a?(Column) ? dom_id(column) : column)
+    end
+
+    def assert_cards_in(column, *names)
+      cards = all("#{column_selector(column)} [data-drag-and-drop-target~='item']", visible: :all)
+      assert_equal names.map { dom_id(cards(it), :article) }, cards.map { it[:id] }
+    end
+
+    def assert_no_cards_in(column)
+      assert_no_selector "#{column_selector(column)} [data-drag-and-drop-target~='item']", visible: :all
+    end
+
+    def assert_looks_in_play(card)
+      article = "##{dom_id(card, :article)}"
+      assert_no_selector "#{article}.card--postponed, #{article} .card__closed", visible: :all
+    end
+
+    def assert_count(column, count)
+      assert_selector "#{column_selector(column)} .cards__expander-count", exact_text: count.to_s, visible: :all
+    end
+
+    def set_count(column, count)
+      execute_script <<~JS, find("#{column_selector(column)} .cards__expander-count", visible: :all), count
+        const [ counter, count ] = arguments
+        counter.dataset.count = count
+        counter.textContent = count > 99 ? "99+" : count
+      JS
+    end
+
+    def start_dragging(card)
+      execute_script <<~JS, card
+        window.dragged = new DataTransfer()
+        arguments[0].dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: dragged }))
+      JS
+    end
+
+    def drag_over(element)
+      evaluate_script <<~JS, element
+        (element => {
+          const event = new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: dragged })
+          element.dispatchEvent(event)
+          return event.defaultPrevented
+        })(arguments[0])
+      JS
+    end
+
+    def stop_dragging(card)
+      execute_script 'arguments[0].dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer: dragged }))', card
+    end
+
+    # Holds drops at the server, so we can see the board before they're saved
+    def holding_saves
+      saving = Concurrent::Event.new
+      subscriber = ActiveSupport::Notifications.subscribe("start_processing.action_controller") do |event|
+        saving.wait(10) if event.payload[:controller].start_with?("Columns::Cards::Drops::")
+      end
+
+      yield
+    ensure
+      saving.set
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+
+    def count_saved_drops
+      execute_script <<~JS
+        document.body.dataset.savedDrops = 0
+        document.addEventListener("turbo:before-stream-render", ({ detail }) => {
+          const render = detail.render
+          detail.render = async (stream) => {
+            await render(stream)
+            document.body.dataset.savedDrops++
+          }
+        })
+      JS
+    end
+
+    def wait_for_saved_drops(count)
+      assert_selector "body[data-saved-drops='#{count}']"
+    end
+end
