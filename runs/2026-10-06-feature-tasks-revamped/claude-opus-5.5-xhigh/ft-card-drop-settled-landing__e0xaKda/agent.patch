+require "test_helper"
+
+class Columns::Cards::Drops::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    card, column = cards(:buy_domain), columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.column }, from: nil, to: column do
+      post columns_card_drops_column_path(card, column_id: column), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(card, :article)
+  end
+
+  test "create reopens a closed card" do
+    card, column = cards(:shipping), columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.closed? }, from: true, to: false do
+      post columns_card_drops_column_path(card, column_id: column), as: :turbo_stream
+    end
+
+    assert_equal column, card.column
+  end
+
+  test "create only drops into columns on the card's board" do
+    card, column = cards(:buy_domain), boards(:private).columns.create!(name: "Elsewhere")
+
+    assert_no_changes -> { card.reload.column } do
+      post columns_card_drops_column_path(card, column_id: column), as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "create on a card without access" do
+    board = boards(:private)
+    column = board.columns.create!(name: "Secret")
+    card = Current.set(user: users(:kevin)) { board.cards.create!(title: "Secret", status: :published) }
+
+    logout_and_sign_in_as :david
+
+    assert_no_changes -> { card.reload.column } do
+      post columns_card_drops_column_path(card, column_id: column), as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+end
