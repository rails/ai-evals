diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..bd57c5b
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,169 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { post } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+// Moves cards between columns by dragging them around the board.
+//
+// Dropping is instant: the card lands in its new column, counts and all, and saving happens in the
+// background. Columns keep their own order, so a card lands where its new column sorts it rather than
+// under the pointer, and the board has nothing left to rearrange once the save comes back.
+export default class extends Controller {
+  static targets = [ "item", "container", "list", "counter" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #item
+  #source
+  #saves = Promise.resolve()
+
+  // Actions
+
+  async dragStart(event) {
+    const item = this.#item = this.#itemContaining(event.target)
+    if (!item) return
+
+    this.#source = this.#containerContaining(item)
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/x-card", item.dataset.dragAndDropId) // Firefox won't drag without data
+
+    // Dim the card once the browser has taken its picture to drag around
+    await nextFrame()
+    if (this.#item === item) item.classList.add(this.draggedItemClass)
+  }
+
+  dragOver(event) {
+    if (!this.#item) return
+
+    const container = this.#destinationFor(event.target)
+    this.#highlight(container)
+
+    if (container) event.preventDefault()
+  }
+
+  dragLeave(event) {
+    if (this.#item && !this.#destinationFor(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const container = this.#destinationFor(event.target)
+
+    if (this.#item && container) {
+      event.preventDefault()
+
+      this.#move(this.#item, container)
+      this.#save(this.#item, container)
+      this.dragEnd()
+    }
+  }
+
+  dragEnd() {
+    this.#item?.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+    this.#item = this.#source = null
+  }
+
+  // Private
+
+  #itemContaining(element) {
+    return this.itemTargets.find(item => item.contains(element))
+  }
+
+  #containerContaining(element) {
+    return this.containerTargets.find(container => container.contains(element))
+  }
+
+  // Cards move between columns, never within one
+  #destinationFor(element) {
+    const container = this.#containerContaining(element)
+    return container === this.#source ? null : container
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(each => each.classList.toggle(this.hoverContainerClass, each === container))
+  }
+
+  #move(item, container) {
+    this.#adjustCount(this.#source, -1)
+    this.#adjustCount(container, +1)
+    this.#insert(item, container)
+    this.#freshen(item, container)
+  }
+
+  #adjustCount(container, change) {
+    const counter = this.counterTargets.find(counter => container?.contains(counter))
+
+    if (counter) {
+      const count = Math.max(0, Number(counter.dataset.count) + change)
+      counter.dataset.count = count
+      counter.textContent = count > 99 ? "99+" : count
+    }
+  }
+
+  // Moving makes a card the most recently active in its new column, so it goes first. Columns that keep
+  // golden cards first (Card.with_golden_first) get it right after their golden cards instead, unless
+  // the card is golden too.
+  #insert(item, container) {
+    const items = this.#itemsIn(container)
+    const itemsAhead = this.#keepsGoldenFirst(container) && !this.#isGolden(item) ? items.filter(each => this.#isGolden(each)) : []
+    const list = this.#listIn(container)
+
+    if (itemsAhead.length) {
+      itemsAhead.at(-1).after(item)
+    } else if (items.length) {
+      items[0].before(item)
+    } else if (list) {
+      list.prepend(item)
+    } else {
+      item.remove() // The column is still loading, and will include the card once it has
+    }
+  }
+
+  #itemsIn(container) {
+    return this.itemTargets.filter(item => container.contains(item))
+  }
+
+  #listIn(container) {
+    return this.listTargets.find(list => container.contains(list))
+  }
+
+  #keepsGoldenFirst(container) {
+    return container.dataset.dragAndDropGoldenFirst === "true"
+  }
+
+  #isGolden(item) {
+    return item.dataset.dragAndDropGolden === "true"
+  }
+
+  // Make the card look as it will once saved and re-rendered: in its new column's color, and freshly
+  // active, with no Not Now or Done styling and no bubble counting down to its postponement.
+  #freshen(item, container) {
+    item.style.setProperty("--card-color", container.dataset.dragAndDropCardColor)
+    item.classList.remove("card--postponed")
+    item.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+    item.querySelectorAll(".bubble").forEach(bubble => { bubble.hidden = true })
+  }
+
+  // Saves run one after another, so a card dragged twice in a row ends up where it was dropped last
+  #save(item, container) {
+    const url = container.dataset.dragAndDropUrl.replace("__id__", item.dataset.dragAndDropId)
+    this.#saves = this.#saves.then(() => this.#submit(url))
+  }
+
+  // Anything but the re-rendered card coming back (the card's gone, we've been signed out, we're offline)
+  // means the move didn't stick, so show the board as it really is.
+  async #submit(url) {
+    try {
+      const response = await post(url, { responseKind: "turbo-stream" })
+      if (!response.ok || !response.isTurboStream) this.#reloadBoard()
+    } catch {
+      this.#reloadBoard()
+    }
+  }
+
+  #reloadBoard() {
+    if (this.element.isConnected) Turbo.visit(window.location.href, { action: "replace" })
+  }
+}
