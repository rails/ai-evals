diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..051abe2
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,55 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+// Our JavaScript carries its own English. Pages in other locales include a
+// `translations` meta tag with the strings from config/locales/*/javascript.yml.
+
+const DEFAULT_LOCALE = "en"
+const DEFAULT_INTL_LOCALE = "en-US"
+
+let cachedSource
+let cachedTranslations = {}
+
+export function currentLocale() {
+  return document.documentElement.lang || DEFAULT_LOCALE
+}
+
+// The locale to hand to Intl formatters. English keeps the US formats we always used.
+export function intlLocale() {
+  const locale = currentLocale()
+  return locale === DEFAULT_LOCALE ? DEFAULT_INTL_LOCALE : locale
+}
+
+// translate("bubble.days", { one: "day", other: "days" }, { count: 3 })
+export function translate(key, englishText, interpolations = {}) {
+  let text = lookup(key) ?? englishText
+
+  if (typeof text === "object") {
+    text = pluralize(text, interpolations.count)
+  }
+
+  return interpolate(text, interpolations)
+}
+
+function lookup(key) {
+  return key.split(".").reduce((scope, part) => scope?.[part], translations())
+}
+
+function translations() {
+  const source = getMetaContent("translations")
+
+  if (source !== cachedSource) {
+    cachedSource = source
+    cachedTranslations = source ? JSON.parse(source) : {}
+  }
+
+  return cachedTranslations
+}
+
+function pluralize(forms, count) {
+  const category = new Intl.PluralRules(intlLocale()).select(count ?? 0)
+  return forms[category] ?? forms.other
+}
+
+function interpolate(text, interpolations) {
+  return String(text).replace(/%\{(\w+)\}/g, (match, name) => name in interpolations ? interpolations[name] : match)
+}
