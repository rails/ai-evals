diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..29e0915
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class LocalizationTest < ActionMailer::TestCase
+  test "emails are written in the language their recipient chose" do
+    identities(:kevin).update!(locale: "ja")
+    magic_link = identities(:kevin).magic_links.create!
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzyの確認コードは #{magic_link.code} です", email.subject
+    assert_match "このコードの有効期限は15分です。", email.text_part.body.to_s
+    assert_match "Fizzyの確認コード", email.html_part.body.to_s
+  end
+
+  test "emails keep the language of the request that sent them when the recipient never chose one" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    email = I18n.with_locale(:ja) { MagicLinkMailer.sign_in_instructions(magic_link).message }
+
+    assert_equal "Fizzyの確認コードは #{magic_link.code} です", email.subject
+  end
+
+  test "emails stay in English for people who never chose a language" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+    assert_match "This code will work for 15 minutes.", email.text_part.body.to_s
+  end
+
+  test "notification bundles are written in the recipient's language, regardless of the current one" do
+    kevin, david = users(:kevin), users(:david)
+    identities(:kevin).update!(locale: "ja")
+
+    kevin_email = Notification::BundleMailer.notification(bundle_for(kevin))
+    david_email = I18n.with_locale(:ja) { Notification::BundleMailer.notification(bundle_for(david)).message }
+
+    assert_equal "Fizzy：新しい通知", kevin_email.subject
+    assert_match "以降の通知", kevin_email.text_part.body.to_s
+    assert_equal "Fizzy: New notifications", david_email.subject
+    assert_match "Notifications since", david_email.text_part.body.to_s
+  end
+
+  test "dates in emails are localized" do
+    identities(:kevin).update!(locale: "ja")
+    bundle = bundle_for(users(:kevin), starts_at: Time.utc(2025, 3, 3, 15))
+
+    email = users(:kevin).in_time_zone { Notification::BundleMailer.notification(bundle).message }
+
+    assert_match "3月3日（月）15時以降の通知", email.text_part.body.to_s
+  end
+
+  private
+    def bundle_for(user, starts_at: 1.day.ago)
+      user.notifications.update_all(read_at: nil, updated_at: 1.hour.ago)
+      Notification::Bundle.create!(user: user, starts_at: starts_at, ends_at: 1.minute.from_now)
+    end
+end
