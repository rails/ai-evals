+require "test_helper"
+
+class Notification::LocalizationTest < ActiveSupport::TestCase
+  setup do
+    identities(:david).update!(locale: "ja")
+    Notification.where(user: [ users(:david), users(:kevin) ]).delete_all
+  end
+
+  test "notifications are broadcast in the language of their recipient" do
+    I18n.with_locale(:en) do
+      users(:david).notifications.create!(source: events(:logo_published), creator: users(:kevin))
+    end
+
+    job = enqueued_jobs.find { it[:job] == Turbo::Streams::ActionBroadcastJob }
+    assert_equal "ja", job["locale"]
+  end
+
+  test "notifications for people who never chose a language are broadcast in the default one" do
+    I18n.with_locale(:ja) do
+      users(:kevin).notifications.create!(source: events(:logo_published), creator: users(:david))
+    end
+
+    job = enqueued_jobs.find { it[:job] == Turbo::Streams::ActionBroadcastJob }
+    assert_equal "en", job["locale"]
+  end
+
+  test "push notifications are written in the language of their recipient" do
+    notification = users(:david).notifications.create!(source: mentions(:logo_card_david_mention_by_jz), creator: users(:jz))
+    payloads = []
+    target = Object.new
+    target.define_singleton_method(:process) { |notification| payloads << notification.payload.to_h }
+
+    original_targets = Notification.push_targets
+    Notification.push_targets = [ target ]
+
+    I18n.with_locale(:en) { notification.push }
+
+    assert_match "メンションしました", payloads.sole[:title]
+  ensure
+    Notification.push_targets = original_targets
+  end
+end
