--- /dev/null
+++ b/app/models/identity/localizable.rb
@@ -0,0 +1,13 @@
+module Identity::Localizable
+  extend ActiveSupport::Concern
+
+  included do
+    validates :locale, inclusion: { in: -> { I18n.available_locales.map(&:to_s) } }, allow_nil: true
+  end
+
+  # Runs the block in the language this person chose. When they haven't chosen one,
+  # it falls back to +default+, which is the default locale unless told otherwise.
+  def in_locale(default: I18n.default_locale, &)
+    I18n.with_locale(locale.presence_in(I18n.available_locales.map(&:to_s)) || default, &)
+  end
+end
