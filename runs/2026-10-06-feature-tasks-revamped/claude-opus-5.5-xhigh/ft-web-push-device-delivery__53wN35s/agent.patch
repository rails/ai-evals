new file mode 100644
index 0000000..0cf3f6e
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,33 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    # A notification lands in the tray when it's created, and lands again whenever
+    # new activity on its card takes over as its source.
+    after_commit :push_later, on: %i[ create update ], if: :source_id_previously_changed?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self) if user.push_subscriptions.exists?
+  end
+
+  def push
+    if pushable?
+      message = push_message
+
+      user.push_subscriptions.each do |subscription|
+        subscription.deliver(message)
+      end
+    end
+  end
+
+  private
+    def pushable?
+      Push.enabled? && !read? && user.active? && account.active?
+    end
+
+    def push_message
+      ApplicationController.renderer.new(script_name: account.slug)
+        .render(template: "notifications/push", formats: :json, assigns: { notification: self })
+    end
+end
