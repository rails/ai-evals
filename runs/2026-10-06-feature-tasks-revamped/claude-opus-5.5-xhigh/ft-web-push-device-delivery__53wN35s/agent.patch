diff --git a/test/test_helpers/web_push_test_helper.rb b/test/test_helpers/web_push_test_helper.rb
new file mode 100644
index 0000000..5488de9
--- /dev/null
+++ b/test/test_helpers/web_push_test_helper.rb
@@ -0,0 +1,53 @@
+# Plays the browser's side of web push: hands out subscription keys the way a
+# browser would, and decrypts what the server pushed with them (RFC 8291).
+module WebPushTestHelper
+  PUSH_SERVICE_IP = "142.250.185.106"
+
+  private
+
+  def browser_push_subscription(endpoint: "https://fcm.googleapis.com/fcm/send/#{SecureRandom.hex(16)}")
+    browser_key = OpenSSL::PKey::EC.generate("prime256v1")
+    auth_secret = Random.bytes(16)
+
+    { endpoint: endpoint,
+      p256dh_key: Base64.urlsafe_encode64(browser_key.public_key.to_bn.to_s(2), padding: false),
+      auth_key: Base64.urlsafe_encode64(auth_secret, padding: false) }.tap do |subscription|
+      browser_push_keys[subscription[:endpoint]] = [ browser_key, auth_secret ]
+    end
+  end
+
+  # Stands in for the push service behind an endpoint, collecting what's posted to it.
+  def stub_push(endpoint, status: 201)
+    stub_dns_resolution(PUSH_SERVICE_IP)
+
+    [].tap do |pushes|
+      stub_request(:post, endpoint).with(ipaddr: PUSH_SERVICE_IP).to_return { |request| pushes << request; { status: status } }
+    end
+  end
+
+  def browser_push_keys
+    @browser_push_keys ||= {}
+  end
+
+  def decrypt_push(request)
+    browser_key, auth_secret = browser_push_keys.fetch(request.uri.normalize.to_s)
+    body = request.body.b
+
+    salt, key_length = body.byteslice(0, 16), body.getbyte(20)
+    server_public_key = body.byteslice(21, key_length)
+    ciphertext = body.byteslice(21 + key_length..)
+
+    group = OpenSSL::PKey::EC::Group.new("prime256v1")
+    shared_secret = browser_key.dh_compute_key(OpenSSL::PKey::EC::Point.new(group, OpenSSL::BN.new(server_public_key, 2)))
+    info = "WebPush: info\0" + browser_key.public_key.to_bn.to_s(2) + server_public_key
+    prk = OpenSSL::KDF.hkdf(shared_secret, salt: auth_secret, info: info, hash: "SHA256", length: 32)
+
+    cipher = OpenSSL::Cipher.new("aes-128-gcm").decrypt
+    cipher.key = OpenSSL::KDF.hkdf(prk, salt: salt, info: "Content-Encoding: aes128gcm\0", hash: "SHA256", length: 16)
+    cipher.iv = OpenSSL::KDF.hkdf(prk, salt: salt, info: "Content-Encoding: nonce\0", hash: "SHA256", length: 12)
+    cipher.auth_tag = ciphertext.byteslice(-16..)
+
+    plaintext = cipher.update(ciphertext.byteslice(0...-16)) + cipher.final
+    JSON.parse(plaintext.sub(/\x02\x00*\z/n, "").force_encoding("UTF-8"))
+  end
+end
