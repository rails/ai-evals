@@ -0,0 +1,38 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user, :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.register(**push_subscription_params, session: Current.session, user_agent: request.user_agent)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.any { head :ok }
+    end
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ]).to_h.symbolize_keys
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..b802a0e
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,117 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "explainer", "details" ]
+  static classes = [ "on" ]
+  static values = { subscriptionsUrl: String, vapidPublicKey: String, endpoint: String }
+
+  connect() {
+    if (this.#supported) {
+      if (Notification.permission === "denied") this.#explainBlocked()
+      if (this.endpointValue) this.#verify()
+    } else {
+      this.buttonTarget.hidden = true
+      this.#explainUnsupported()
+    }
+  }
+
+  async subscribe() {
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission === "granted") {
+        await this.#register(await this.#subscription())
+      } else if (permission === "denied") {
+        this.#explainBlocked()
+      }
+    } catch (error) {
+      console.error(error)
+      this.#explainBlocked()
+    }
+  }
+
+  // The server has push turned on for this device. Check that the browser agrees,
+  // and keep the server current if the browser has since moved to a new subscription.
+  async #verify() {
+    try {
+      const registration = await this.#serviceWorkerRegistration()
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (Notification.permission !== "granted" || !subscription) {
+        this.element.classList.remove(this.onClass)
+      } else if (subscription.endpoint !== this.endpointValue || !this.#signedWithCurrentKey(subscription)) {
+        await this.#register(await this.#subscription())
+      }
+    } catch (error) {
+      console.error(error)
+      this.element.classList.remove(this.onClass)
+    }
+  }
+
+  // Every account on this device shares the browser's subscription, so reuse it
+  // unless it was made for a different server key.
+  async #subscription() {
+    const registration = await this.#serviceWorkerRegistration()
+    const subscription = await registration.pushManager.getSubscription()
+
+    if (subscription && this.#signedWithCurrentKey(subscription)) {
+      return subscription
+    } else {
+      await subscription?.unsubscribe()
+      return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+    }
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: p256dh, auth_key: auth } },
+      responseKind: "turbo-stream"
+    })
+
+    if (!response.ok) throw new Error(`Couldn't save the push subscription (${response.statusCode})`)
+  }
+
+  #explainBlocked() {
+    this.explainerTarget.hidden = false
+    this.detailsTargets.forEach(details => details.hidden = false)
+  }
+
+  #explainUnsupported() {
+    this.explainerTarget.hidden = false
+    this.detailsTargets.forEach(details => details.hidden = true)
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  // Turbo registers the service worker on every page. Registering again would check
+  // for an update over the network, so only do it if that somehow didn't happen.
+  async #serviceWorkerRegistration() {
+    if (!await navigator.serviceWorker.getRegistration()) {
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    }
+
+    return navigator.serviceWorker.ready
+  }
+
+  #signedWithCurrentKey(subscription) {
+    const key = subscription.options?.applicationServerKey
+    return !key || this.#sameBytes(new Uint8Array(key), this.#applicationServerKey)
+  }
+
+  // The key arrives Base64 URL-safe encoded, but the push manager wants raw bytes
+  get #applicationServerKey() {
+    const base64 = this.vapidPublicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, "=")
+
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+
+  #sameBytes(a, b) {
+    return a.length === b.length && a.every((byte, index) => byte === b[index])
+  }
+}
