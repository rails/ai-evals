+  end
+
+  test "accepts endpoints on browser push services" do
+    %w[
+      https://fcm.googleapis.com/fcm/send/abc123
+      https://updates.push.services.mozilla.com/wpush/v2/abc123
+      https://web.push.apple.com/abc123
+      https://wns2-par02p.notify.windows.com/w/?token=abc123
+    ].each do |endpoint|
+      assert build_subscription(endpoint: endpoint).valid?, "#{endpoint} should be accepted"
+    end
+  end
+
+  test "rejects endpoints anywhere else" do
+    %w[
+      http://fcm.googleapis.com/fcm/send/abc123
+      https://fcm.googleapis.com:8443/fcm/send/abc123
+      https://user@fcm.googleapis.com/fcm/send/abc123
+      https://fcm.googleapis.com.example.com/fcm/send/abc123
+      https://evilfcm.googleapis.com/fcm/send/abc123
+      https://example.com/push
+      https://169.254.169.254/latest/meta-data
+      https://localhost/push
+      ftp://fcm.googleapis.com/abc123
+      not\ a\ url
+    ].each do |endpoint|
+      subscription = build_subscription(endpoint: endpoint)
+
+      assert_not subscription.valid?, "#{endpoint} should be rejected"
+      assert subscription.errors[:endpoint].any?
+    end
+  end
+
+  test "requires keys that look like the browser's" do
+    assert_not build_subscription(p256dh_key: "").valid?
+    assert_not build_subscription(auth_key: "").valid?
+    assert_not build_subscription(p256dh_key: "<script>alert(1)</script>").valid?
+    assert_not build_subscription(auth_key: "a" * 256).valid?
+  end
+
+  test "belongs to the user's account" do
+    subscription = @user.push_subscriptions.create!(browser_push_subscription)
+
+    assert_equal @user.account, subscription.account
+  end
+
+  test "register creates a subscription" do
+    session = sessions(:kevin)
+
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      @user.push_subscriptions.register(**browser_push_subscription, session: session, user_agent: "Chrome")
+    end
+
+    assert_equal session, @user.push_subscriptions.last.session
+    assert_equal "Chrome", @user.push_subscriptions.last.user_agent
+  end
+
+  test "register refreshes the subscription for an endpoint it already knows" do
+    attributes = browser_push_subscription
+    subscription = @user.push_subscriptions.register(**attributes)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      assert_equal subscription, @user.push_subscriptions.register(**attributes.merge(auth_key: "fresh-auth-key"))
+    end
+
+    assert_equal "fresh-auth-key", subscription.reload.auth_key
+  end
+
+  test "register replaces whatever the same browser session registered before" do
+    session = Session.create!(identity: @user.identity)
+    other_session = Session.create!(identity: @user.identity)
+
+    stale = @user.push_subscriptions.register(**browser_push_subscription, session: session)
+    other_device = @user.push_subscriptions.register(**browser_push_subscription, session: other_session)
+    current = @user.push_subscriptions.register(**browser_push_subscription, session: session)
+
+    assert_not Push::Subscription.exists?(stale.id)
+    assert Push::Subscription.exists?(other_device.id)
+    assert_equal [ current ], session.push_subscriptions
+  end
+
+  test "register keeps subscriptions apart per user" do
+    attributes = browser_push_subscription
+
+    @user.push_subscriptions.register(**attributes)
+    users(:david).push_subscriptions.register(**attributes)
+
+    assert_equal 1, @user.push_subscriptions.count
+    assert_equal 1, users(:david).push_subscriptions.count
+  end
+
+  test "register refuses endpoints off the push services" do
+    assert_raises ActiveRecord::RecordInvalid do
+      @user.push_subscriptions.register(**browser_push_subscription(endpoint: "https://example.com/push"))
+    end
+  end
+
+  test "signing out stops pushes to that browser" do
+    session = Session.create!(identity: @user.identity)
+    @user.push_subscriptions.register(**browser_push_subscription, session: session)
+    users(:mike).push_subscriptions.register(**browser_push_subscription, session: Session.create!(identity: users(:mike).identity))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      session.destroy
+    end
+  end
+
+  test "deliver posts the encrypted message to the endpoint's vetted IP address" do
+    subscription = @user.push_subscriptions.create!(browser_push_subscription)
+    pushes = stub_push(subscription.endpoint)
+
+    subscription.deliver({ title: "Hello" }.to_json)
+
+    assert_equal 1, pushes.size
+    assert_match(/\Avapid t=.+,k=.+\z/, pushes.first.headers["Authorization"])
+    assert_equal "aes128gcm", pushes.first.headers["Content-Encoding"]
+    assert_equal 1.day.to_i.to_s, pushes.first.headers["Ttl"]
+    assert_equal({ "title" => "Hello" }, decrypt_push(pushes.first))
+  end
+
+  test "deliver skips endpoints that resolve to private addresses" do
+    subscription = @user.push_subscriptions.create!(browser_push_subscription)
+    stub_dns_resolution("10.0.0.1", "169.254.169.254")
+
+    subscription.deliver({ title: "Hello" }.to_json)
+
+    assert_not_requested :post, subscription.endpoint
+    assert Push::Subscription.exists?(subscription.id)
+  end
+
+  test "deliver forgets subscriptions the push service no longer knows" do
+    stub_dns_resolution(PUSH_SERVICE_IP)
+
+    [ 404, 410 ].each do |status|
+      subscription = @user.push_subscriptions.create!(browser_push_subscription)
+      stub_request(:post, subscription.endpoint).to_return(status: status)
+
+      subscription.deliver({ title: "Hello" }.to_json)
+
+      assert_not Push::Subscription.exists?(subscription.id), "#{status} should remove the subscription"
+    end
+  end
+
+  test "deliver keeps subscriptions through temporary trouble" do
+    stub_dns_resolution(PUSH_SERVICE_IP)
+    subscription = @user.push_subscriptions.create!(browser_push_subscription)
+
+    [ 400, 403, 413, 429, 500, 503 ].each do |status|
+      stub_request(:post, subscription.endpoint).to_return(status: status)
+      assert_nothing_raised { subscription.deliver({ title: "Hello" }.to_json) }
+    end
+
+    [ Net::OpenTimeout, Net::ReadTimeout, Errno::ECONNREFUSED, OpenSSL::SSL::SSLError, SocketError ].each do |error|
+      stub_request(:post, subscription.endpoint).to_raise(error)
+      assert_nothing_raised { subscription.deliver({ title: "Hello" }.to_json) }
+    end
+
+    assert Push::Subscription.exists?(subscription.id)
+  end
+
+  test "deliver copes with keys that can't encrypt" do
+    stub_dns_resolution(PUSH_SERVICE_IP)
+    subscription = @user.push_subscriptions.create!(browser_push_subscription.merge(p256dh_key: "not-a-real-key", auth_key: "nope"))
+
+    assert_nothing_raised { subscription.deliver({ title: "Hello" }.to_json) }
+    assert_not_requested :post, subscription.endpoint
+  end
+
+  private
+    def build_subscription(**attributes)
+      @user.push_subscriptions.build(browser_push_subscription.merge(attributes))
+    end
+end
diff --git a/test/system/push_notifications_test.rb b/test/system/push_notifications_test.rb
new file mode 100644
index 0000000..0b8201f
--- /dev/null
+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,160 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    sign_in_as(@user)
+  end
+
+  teardown do
+    page.driver.browser.execute_cdp "Browser.resetPermissions"
+    page.driver.browser.execute_cdp "Page.removeScriptToEvaluateOnNewDocument", identifier: @push_service_stand_in if @push_service_stand_in
+  end
+
+  test "explain how to unblock notifications when the browser blocks them" do
+    visit notifications_settings_url
+
+    assert_text "Push notifications are off for this device."
+    assert_no_text "Turn on notifications for this website."
+
+    click_on "Turn on"
+
+    assert_text "Turn on notifications for this website."
+    assert_no_text "Push notifications are on for this device."
+  end
+
+  test "turn push on and off for this device" do
+    allow_notifications
+    stand_in_for_push_service
+    visit notifications_settings_url
+
+    click_on "Turn on"
+
+    assert_text "Push notifications are on for this device."
+    assert_equal "https://fcm.googleapis.com/fcm/send/system-test", @user.push_subscriptions.sole.endpoint
+
+    click_on "Turn off"
+
+    assert_text "Push notifications are off for this device."
+    assert_empty @user.push_subscriptions.reload
+  end
+
+  test "stay off when the server won't take this browser's push service" do
+    allow_notifications
+    stand_in_for_push_service endpoint: "https://push.example.com/system-test"
+    visit notifications_settings_url
+
+    click_on "Turn on"
+
+    assert_text "Turn on notifications for this website."
+    assert_text "Push notifications are off for this device."
+    assert_empty @user.push_subscriptions
+  end
+
+  test "show push as off when this browser no longer has the subscription" do
+    allow_notifications
+    stand_in_for_push_service
+    visit notifications_settings_url
+    click_on "Turn on"
+    assert_text "Push notifications are on for this device."
+
+    visit notifications_settings_url # The stand-in starts over without a subscription
+
+    assert_text "Push notifications are off for this device."
+    assert_button "Turn on"
+  end
+
+  test "resubscribe when the server's key changed since this device subscribed" do
+    allow_notifications
+    stand_in_for_push_service
+    visit notifications_settings_url
+    click_on "Turn on"
+    assert_text "Push notifications are on for this device."
+
+    page.execute_script "window.pushServiceStandIn.subscription.options.applicationServerKey = new Uint8Array(65).buffer"
+    turbo_visit notifications_path
+    assert_selector "h1", exact_text: "Notifications"
+    turbo_visit notifications_settings_path
+
+    assert_selector "[data-notifications-endpoint-value='https://fcm.googleapis.com/fcm/send/system-test-2']"
+    assert_text "Push notifications are on for this device."
+    assert_equal "https://fcm.googleapis.com/fcm/send/system-test-2", @user.push_subscriptions.reload.sole.endpoint
+  end
+
+  test "a push shows what landed in the tray" do
+    allow_notifications
+    visit notifications_settings_url
+
+    subscription = @user.push_subscriptions.create!(browser_push_subscription)
+    pushes = stub_push(subscription.endpoint)
+    notifications(:logo_mentioned_david).push
+    deliver_to_service_worker decrypt_push(pushes.sole)
+
+    assert_equal [ {
+      "title" => "JZ @mentioned you",
+      "body" => "I agree.",
+      "tag" => "notification_#{notifications(:logo_mentioned_david).id}",
+      "path" => "#{accounts("37s").slug}/cards/#{cards(:logo).number}#comment_#{comments(:logo_agreement_jz).id}"
+    } ], shown_notifications
+  end
+
+  private
+    def allow_notifications
+      page.driver.browser.execute_cdp "Browser.grantPermissions", origin: origin, permissions: [ "notifications" ]
+    end
+
+    def origin
+      URI(current_url).then { |uri| "#{uri.scheme}://#{uri.host}:#{uri.port}" }
+    end
+
+    # Headless Chrome can't reach a real push service, so every page loaded from
+    # here on hands out subscriptions the way the browser would.
+    def stand_in_for_push_service(endpoint: "https://fcm.googleapis.com/fcm/send/system-test")
+      keys = browser_push_subscription
+
+      @push_service_stand_in = page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: <<~JS)["identifier"]
+        const standIn = window.pushServiceStandIn = { subscription: null, count: 0 }
+
+        PushManager.prototype.getSubscription = async () => standIn.subscription
+        PushManager.prototype.subscribe = async ({ applicationServerKey }) => {
+          standIn.count++
+          standIn.subscription = {
+            endpoint: `#{endpoint}${standIn.count > 1 ? `-${standIn.count}` : ""}`,
+            options: { applicationServerKey: applicationServerKey.buffer },
+            toJSON() { return { endpoint: this.endpoint, keys: { p256dh: "#{keys[:p256dh_key]}", auth: "#{keys[:auth_key]}" } } },
+            unsubscribe: async () => { standIn.subscription = null; return true }
+          }
+          return standIn.subscription
+        }
+      JS
+    end
+
+    # Navigate without reloading, so the page keeps its stand-in subscription
+    def turbo_visit(path)
+      page.execute_script "Turbo.visit(#{path.to_json})"
+    end
+
+    # Hands the message to the service worker as if it came from the push service.
+    # Chrome quietly ignores registrations that don't exist, and numbers them as
+    # they're made, so offer it to every registration this browser could have made.
+    def deliver_to_service_worker(message)
+      page.evaluate_async_script "navigator.serviceWorker.ready.then(() => arguments[0]())"
+      page.driver.browser.execute_cdp "ServiceWorker.enable"
+
+      0.upto(100) do |id|
+        page.driver.browser.execute_cdp "ServiceWorker.deliverPushMessage", origin: origin, registrationId: id.to_s, data: message.to_json
+      end
+    end
+
+    def shown_notifications
+      page.document.synchronize do
+        notifications = page.evaluate_async_script <<~JS
+          navigator.serviceWorker.ready
+            .then(registration => registration.getNotifications())
+            .then(notifications => arguments[0](notifications.map(({ title, body, tag, data }) => ({ title, body, tag, path: data.path }))))
+        JS
+
+        notifications.presence or raise Capybara::ExpectationNotMet, "No notifications shown"
+      end
+    end
+end
