+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @subscription = @kevin.push_subscriptions.create!(browser_push_subscription)
+  end
+
+  test "push when a notification lands in the tray" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with job: Notification::PushJob do
+      Notifier.for(events(:layout_commented)).notify
+    end
+  end
+
+  test "push again when new activity on the card lands it in the tray again" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_with job: Notification::PushJob, args: [ notification ] do
+      notification.update!(source: events(:logo_published), read_at: nil, unread_count: 3)
+    end
+  end
+
+  test "don't push when someone reads or unreads a notification" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "don't push for people who haven't turned push on" do
+    @subscription.destroy
+    notifications(:layout_commented_kevin).destroy
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notifier.for(events(:layout_commented)).notify
+    end
+  end
+
+  test "push says what the tray says and opens the card it's about" do
+    notification = notifications(:layout_commented_kevin)
+    pushes = stub_push(@subscription.endpoint)
+
+    notification.push
+
+    assert_equal 1, pushes.size
+    assert_equal({
+      "title" => "RE: Layout is broken",
+      "body" => "The text is overflowing the container.",
+      "path" => "#{@kevin.account.slug}/cards/#{cards(:layout).number}#comment_#{comments(:layout_overflowing_david).id}",
+      "tag" => "notification_#{notification.id}",
+      "badge" => @kevin.notifications.unread.count
+    }, decrypt_push(pushes.first))
+  end
+
+  test "push says what the tray says for mentions" do
+    david = users(:david)
+    subscription = david.push_subscriptions.create!(browser_push_subscription)
+    pushes = stub_push(subscription.endpoint)
+
+    notifications(:logo_mentioned_david).push
+
+    message = decrypt_push(pushes.first)
+    assert_equal "JZ @mentioned you", message["title"]
+    assert_equal comments(:logo_agreement_jz).body.to_plain_text, message["body"]
+    assert_equal "#{david.account.slug}/cards/#{cards(:logo).number}#comment_#{comments(:logo_agreement_jz).id}", message["path"]
+  end
+
+  test "push goes to every device the person turned it on for" do
+    phone = @kevin.push_subscriptions.create!(browser_push_subscription(endpoint: "https://web.push.apple.com/#{SecureRandom.hex}"))
+    laptop_pushes, phone_pushes = stub_push(@subscription.endpoint), stub_push(phone.endpoint)
+
+    notifications(:layout_commented_kevin).push
+
+    assert_equal 1, laptop_pushes.size
+    assert_equal 1, phone_pushes.size
+  end
+
+  test "push keeps long text short enough to fit" do
+    cards(:logo).update_column :title, "🍕" * 255
+    pushes = stub_push(@subscription.endpoint)
+
+    notifications(:logo_assignment_kevin).push
+
+    message = decrypt_push(pushes.first)
+    assert_operator message["title"].length, :<=, 250
+    assert message["title"].end_with?("...")
+  end
+
+  test "don't push notifications that were read in the meantime" do
+    notification = notifications(:layout_commented_kevin)
+    notification.read
+    pushes = stub_push(@subscription.endpoint)
+
+    notification.push
+
+    assert_empty pushes
+  end
+
+  test "don't push to people who've left the account" do
+    notification = notifications(:layout_commented_kevin)
+    @kevin.update!(active: false)
+    pushes = stub_push(@subscription.endpoint)
+
+    notification.push
+
+    assert_empty pushes
+  end
+
+  test "don't push for cancelled accounts" do
+    notification = notifications(:layout_commented_kevin)
+    @kevin.account.cancel(initiated_by: users(:jason))
+    assert @kevin.account.reload.cancelled?
+    pushes = stub_push(@subscription.endpoint)
+
+    notification.push
+
+    assert_empty pushes
+  end
+
+  test "don't push until ops provide VAPID keys" do
+    notification = notifications(:layout_commented_kevin)
+    Rails.configuration.x.vapid.stubs(:public_key).returns(nil)
+    pushes = stub_push(@subscription.endpoint)
+
+    notification.push
+
+    assert_empty pushes
+  end
+
+  test "deactivating a user forgets their devices" do
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @kevin.deactivate
+    end
+  end
+end
