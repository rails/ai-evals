@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Notification::PushJobTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @laptop = @kevin.push_subscriptions.create!(browser_push_subscription)
+    @phone = @kevin.push_subscriptions.create!(browser_push_subscription(endpoint: "https://web.push.apple.com/#{SecureRandom.hex}"))
+  end
+
+  test "what lands in someone's tray reaches each of their devices" do
+    laptop_pushes, phone_pushes = stub_push(@laptop.endpoint), stub_push(@phone.endpoint)
+
+    with_current_user(:david) { cards(:layout).comments.create!(body: "Shipping this today") }
+    perform_enqueued_jobs_until_done
+
+    notification = @kevin.notifications.find_by!(card: cards(:layout))
+    comment = cards(:layout).comments.last
+
+    [ laptop_pushes, phone_pushes ].each do |pushes|
+      assert_equal 1, pushes.size
+      assert_equal({
+        "title" => "RE: Layout is broken",
+        "body" => "Shipping this today",
+        "path" => "#{@kevin.account.slug}/cards/#{cards(:layout).number}#comment_#{comment.id}",
+        "tag" => "notification_#{notification.id}",
+        "badge" => @kevin.notifications.unread.count
+      }, decrypt_push(pushes.first))
+    end
+  end
+
+  test "discard pushes for notifications that are gone" do
+    notification = notifications(:layout_commented_kevin)
+    Notification::PushJob.perform_later(notification)
+    notification.destroy
+
+    assert_nothing_raised { perform_enqueued_jobs only: Notification::PushJob }
+  end
+
+  private
+    def perform_enqueued_jobs_until_done
+      perform_enqueued_jobs while enqueued_jobs.any?
+    end
+end
