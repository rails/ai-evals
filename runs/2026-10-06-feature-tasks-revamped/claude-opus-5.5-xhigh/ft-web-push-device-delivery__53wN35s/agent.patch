@@ -0,0 +1,129 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @user = users(:david)
+  end
+
+  test "create subscribes this device" do
+    subscription = browser_push_subscription
+
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription }, headers: { "User-Agent" => "Chrome/140" }
+    end
+
+    assert_response :ok
+
+    push_subscription = @user.push_subscriptions.last
+    assert_equal subscription.stringify_keys, push_subscription.attributes.slice("endpoint", "p256dh_key", "auth_key")
+    assert_equal @user.account, push_subscription.account
+    assert_equal "Chrome/140", push_subscription.user_agent
+    assert_not_nil push_subscription.session
+  end
+
+  test "create refreshes a subscription it already has" do
+    subscription = browser_push_subscription
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription }
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription }
+    end
+
+    assert_response :ok
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: browser_push_subscription }, as: :json
+    end
+
+    assert_response :ok
+  end
+
+  test "create from the settings page turns push on in place" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: browser_push_subscription }, as: :turbo_stream
+
+    assert_response :ok
+    assert_turbo_stream action: :replace, target: "push_notifications" do
+      assert_select "section.notifications--on"
+      assert_select "form[action=?]", user_push_subscription_path(@user, @user.push_subscriptions.last)
+    end
+  end
+
+  test "create refuses endpoints that aren't browser push services" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: browser_push_subscription(endpoint: "https://169.254.169.254/latest") }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create requires the whole subscription" do
+    post user_push_subscriptions_path(@user)
+    assert_response :bad_request
+
+    post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: browser_push_subscription[:endpoint] } }
+    assert_response :unprocessable_entity
+
+    assert_empty @user.push_subscriptions
+  end
+
+  test "signing out turns push off for this device" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: browser_push_subscription }
+    other_device = @user.push_subscriptions.create!(browser_push_subscription.merge(session: sessions(:david)))
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      sign_out
+    end
+
+    assert_equal [ other_device ], @user.push_subscriptions.reload
+  end
+
+  test "can't subscribe someone else's notifications" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: browser_push_subscription }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can't subscribe to users in other accounts" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:mike)), params: { push_subscription: browser_push_subscription }
+    end
+
+    assert_response :not_found
+  end
+
+  test "destroy turns push off" do
+    push_subscription = @user.push_subscriptions.create!(browser_push_subscription)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, push_subscription)
+    end
+
+    assert_redirected_to notifications_settings_path
+  end
+
+  test "destroy as JSON" do
+    push_subscription = @user.push_subscriptions.create!(browser_push_subscription)
+
+    delete user_push_subscription_path(@user, push_subscription), as: :json
+
+    assert_response :no_content
+    assert_not Push::Subscription.exists?(push_subscription.id)
+  end
+
+  test "can't turn off someone else's push" do
+    push_subscription = users(:kevin).push_subscriptions.create!(browser_push_subscription)
+
+    delete user_push_subscription_path(users(:kevin), push_subscription)
+    assert_response :forbidden
+
+    delete user_push_subscription_path(@user, push_subscription)
+    assert_response :not_found
+
+    assert Push::Subscription.exists?(push_subscription.id)
+  end
+end
