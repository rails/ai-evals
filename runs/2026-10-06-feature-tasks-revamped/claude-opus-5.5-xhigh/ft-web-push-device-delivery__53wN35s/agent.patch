diff --git a/config/initializers/vapid.rb b/config/initializers/vapid.rb
new file mode 100644
index 0000000..6cabb2b
--- /dev/null
+++ b/config/initializers/vapid.rb
@@ -0,0 +1,25 @@
+# Browser push services only accept pushes signed with the VAPID key pair a
+# subscription was created with. Ops provide the pair through VAPID_PUBLIC_KEY and
+# VAPID_PRIVATE_KEY; push notifications stay off until both are set. Generate one with:
+#
+#   bin/rails runner 'key = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{key.public_key}", "VAPID_PRIVATE_KEY=#{key.private_key}"'
+Rails.application.configure do
+  config.x.vapid.public_key = ENV["VAPID_PUBLIC_KEY"].presence
+  config.x.vapid.private_key = ENV["VAPID_PRIVATE_KEY"].presence
+
+  # Development and test fall back to a local key pair so push works out of the box.
+  # Development keeps its pair in tmp/ so browser subscriptions survive restarts.
+  if Rails.env.local? && config.x.vapid.public_key.nil? && config.x.vapid.private_key.nil?
+    if Rails.env.development?
+      pem = Rails.root.join("tmp/development_vapid_key.pem")
+      pem.dirname.mkpath
+      pem.write(WebPush.generate_key.to_pem) unless pem.exist?
+      key = WebPush::VapidKey.from_pem(pem.read)
+    else
+      key = WebPush.generate_key
+    end
+
+    config.x.vapid.public_key = key.public_key
+    config.x.vapid.private_key = key.private_key
+  end
+end
