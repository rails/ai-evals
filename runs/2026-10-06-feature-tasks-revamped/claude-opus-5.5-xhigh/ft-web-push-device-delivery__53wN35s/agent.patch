diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..2722655 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,49 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+// Push notifications
+// Show what landed in the tray, and open the card it's about when clicked.
+// Browsers expect every push to show a notification, even one we can't read.
+self.addEventListener("push", (event) => {
+  const { title, body, path, tag, badge } = readPush(event)
+
+  event.waitUntil(Promise.all([
+    self.registration.showNotification(title, { body, tag, renotify: Boolean(tag), icon: "/app-icon-192.png", data: { path } }),
+    updateAppBadge(badge)
+  ]))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openPath(event.notification.data?.path))
+})
+
+function readPush(event) {
+  try {
+    return { title: "Fizzy", ...event.data?.json() }
+  } catch {
+    return { title: "Fizzy" }
+  }
+}
+
+function updateAppBadge(count) {
+  if ("setAppBadge" in self.navigator && Number.isInteger(count)) {
+    return count > 0 ? self.navigator.setAppBadge(count) : self.navigator.clearAppBadge()
+  }
+}
+
+async function openPath(path) {
+  const url = new URL(path || "/", self.location.origin)
+  const href = url.origin === self.location.origin ? url.href : self.location.origin
+  const windows = await self.clients.matchAll({ type: "window" })
+  const client = windows.find(({ focused }) => focused) || windows[0]
+
+  if (client) {
+    await client.focus()
+    return client.navigate(href)
+  } else {
+    return self.clients.openWindow(href)
+  }
+}
+
 TurboOffline.start()
