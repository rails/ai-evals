+module Push
+  class << self
+    def table_name_prefix
+      "push_"
+    end
+
+    def enabled?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      Rails.configuration.x.vapid.public_key
+    end
+
+    def vapid
+      { subject: vapid_subject, public_key: vapid_public_key, private_key: vapid_private_key }
+    end
+
+    private
+      def vapid_private_key
+        Rails.configuration.x.vapid.private_key
+      end
+
+      # Push services want a way to reach whoever runs the server, so point them at
+      # the address our email comes from.
+      def vapid_subject
+        "mailto:#{Mail::Address.new(ApplicationMailer.default[:from]).address}"
+      end
+  end
+end
diff --git a/app/models/push/request.rb b/app/models/push/request.rb
new file mode 100644
index 0000000..d425137
--- /dev/null
+++ b/app/models/push/request.rb
@@ -0,0 +1,39 @@
+# Sends a push the way WebPush::Request does, but connects to an IP address that
+# SsrfProtection already vetted, so the endpoint's host can't be re-resolved to an
+# internal address between the check and the request.
+class Push::Request < WebPush::Request
+  class EncryptionError < WebPush::Error; end
+
+  TIMEOUT = 7.seconds
+
+  def initialize(ip:, **)
+    @ip = ip
+    super(**)
+  end
+
+  def perform
+    http.request(post).tap { |response| verify_response(response) }
+  end
+
+  private
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = @ip
+        http.use_ssl = true
+        http.open_timeout = TIMEOUT
+        http.read_timeout = TIMEOUT
+        http.write_timeout = TIMEOUT
+      end
+    end
+
+    def post
+      Net::HTTP::Post.new(uri.request_uri, headers).tap { |request| request.body = body }
+    end
+
+    # The keys come from the browser, so they may not make for a usable cipher.
+    def encrypt_payload(...)
+      super
+    rescue ArgumentError, OpenSSL::OpenSSLError => error
+      raise EncryptionError, error.message
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..e9caa09
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,79 @@
+class Push::Subscription < ApplicationRecord
+  # Browsers hand out endpoints on their vendor's push service. Only ever post to
+  # those, so a subscription can't aim the server at any other host.
+  PERMITTED_ENDPOINT_HOSTS = %w[
+    fcm.googleapis.com
+    jmt17.google.com
+    updates.push.services.mozilla.com
+    push.apple.com
+    notify.windows.com
+  ].freeze
+
+  KEY_FORMAT = %r{\A[A-Za-z0-9+/\-_]+={0,2}\z} # Base64, as browsers encode the keys
+
+  TTL = 1.day
+
+  DELIVERY_ERRORS = [
+    WebPush::Error,
+    Resolv::ResolvError, Resolv::ResolvTimeout, SocketError,
+    Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout, Errno::ETIMEDOUT,
+    Errno::ECONNREFUSED, Errno::EHOSTUNREACH, Errno::ECONNRESET, Errno::EPERM, EOFError,
+    OpenSSL::SSL::SSLError
+  ].freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  belongs_to :session, optional: true
+
+  validates :endpoint, presence: true, length: { maximum: 2.kilobytes }
+  validates :p256dh_key, :auth_key, presence: true, length: { maximum: 255 }, format: { with: KEY_FORMAT, allow_blank: true }
+  validate :validate_endpoint, if: -> { endpoint.present? }
+
+  # A browser session holds one subscription at a time, so whatever it registers
+  # replaces anything it registered before.
+  def self.register(endpoint:, session: nil, **attributes)
+    transaction do
+      where(session: session).where.not(endpoint: endpoint).delete_all if session
+
+      find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+        subscription.update!(session: session, **attributes)
+      end
+    end
+  end
+
+  def deliver(message)
+    if ip = SsrfProtection.resolve_public_ip(endpoint_uri.host)
+      Push::Request.new(message: message, subscription: web_push_subscription, vapid: Push.vapid, ttl: TTL.to_i, ip: ip).perform
+    else
+      logger.warn "Skipped push to #{endpoint_uri.host}: it doesn't resolve to a public IP address"
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue *DELIVERY_ERRORS => error
+    logger.warn "Failed push to #{endpoint_uri.host}: #{error.class}"
+  end
+
+  private
+    def validate_endpoint
+      uri = endpoint_uri
+
+      unless uri.is_a?(URI::HTTPS) && uri.userinfo.nil? && uri.port == uri.default_port && permitted_endpoint_host?(uri.host)
+        errors.add :endpoint, "must be on a browser push service"
+      end
+    end
+
+    def endpoint_uri
+      URI.parse(endpoint)
+    rescue URI::InvalidURIError
+      nil
+    end
+
+    def permitted_endpoint_host?(host)
+      host = host.to_s.downcase
+      PERMITTED_ENDPOINT_HOSTS.any? { |permitted| host == permitted || host.end_with?(".#{permitted}") }
+    end
+
+    def web_push_subscription
+      { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } }
+    end
+end
