+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  include PushTestHelper
+
+  setup do
+    @user = users(:david)
+  end
+
+  test "accepts endpoints from the browsers' push services" do
+    %w[
+      https://fcm.googleapis.com/fcm/send/abc
+      https://updates.push.services.mozilla.com/wpush/v2/abc
+      https://web.push.apple.com/abc
+      https://wns2-par02p.notify.windows.com/w/?token=abc
+      https://FCM.googleapis.com/fcm/send/abc
+    ].each do |endpoint|
+      assert build_subscription(endpoint: endpoint).valid?, "Expected #{endpoint} to be accepted"
+    end
+  end
+
+  test "rejects endpoints that aren't a push service over HTTPS" do
+    [
+      "http://fcm.googleapis.com/fcm/send/abc",
+      "https://example.com/push",
+      "https://fcm.googleapis.com.example.com/push",
+      "https://evilnotify.windows.com/push",
+      "https://example.com/#.fcm.googleapis.com",
+      "https://169.254.169.254/latest/meta-data",
+      "https://localhost/push",
+      "fcm.googleapis.com/fcm/send/abc",
+      "https://exa mple.com",
+      "javascript:alert(1)"
+    ].each do |endpoint|
+      subscription = build_subscription(endpoint: endpoint)
+
+      assert_not subscription.valid?, "Expected #{endpoint} to be rejected"
+      assert_includes subscription.errors[:endpoint], "must be a push service URL"
+    end
+  end
+
+  test "requires the endpoint and keys" do
+    subscription = @user.push_subscriptions.new
+
+    assert_not subscription.valid?
+    assert subscription.errors.of_kind?(:endpoint, :blank)
+    assert subscription.errors.of_kind?(:p256dh_key, :blank)
+    assert subscription.errors.of_kind?(:auth_key, :blank)
+  end
+
+  test "belongs to the user's account" do
+    assert_equal @user.account, subscribe_to_push(@user).account
+  end
+
+  test "register creates a subscription for a new endpoint" do
+    keys = browser_push_keys
+
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      @user.push_subscriptions.register(endpoint: PUSH_ENDPOINT, **keys, user_agent: "Firefox", session: sessions(:david))
+    end
+
+    subscription = @user.push_subscriptions.last
+    assert_equal PUSH_ENDPOINT, subscription.endpoint
+    assert_equal keys[:p256dh_key], subscription.p256dh_key
+    assert_equal keys[:auth_key], subscription.auth_key
+    assert_equal "Firefox", subscription.user_agent
+    assert_equal sessions(:david), subscription.session
+  end
+
+  test "register refreshes an existing subscription for the same endpoint" do
+    subscription = subscribe_to_push(@user)
+    subscription.update_columns(updated_at: 1.week.ago)
+    keys = browser_push_keys
+
+    assert_no_difference -> { Push::Subscription.count } do
+      @user.push_subscriptions.register(endpoint: PUSH_ENDPOINT, **keys, session: sessions(:david))
+    end
+
+    subscription.reload
+    assert_equal keys[:p256dh_key], subscription.p256dh_key
+    assert_equal sessions(:david), subscription.session
+    assert_in_delta Time.current, subscription.updated_at, 1.second
+  end
+
+  test "register keeps the same endpoint separate per user" do
+    subscribe_to_push(users(:kevin))
+
+    assert_difference -> { Push::Subscription.count }, +1 do
+      @user.push_subscriptions.register(endpoint: PUSH_ENDPOINT, **browser_push_keys)
+    end
+  end
+
+  test "register raises for an invalid subscription" do
+    assert_raises ActiveRecord::RecordInvalid do
+      @user.push_subscriptions.register(endpoint: "https://example.com/push", **browser_push_keys)
+    end
+  end
+
+  test "deliver posts the payload encrypted for the browser and signed with our VAPID key" do
+    subscription = subscribe_to_push(@user)
+    request = stub_request(:post, PUSH_ENDPOINT).to_return(status: 201)
+
+    subscription.deliver_now({ title: "Hello" }.to_json)
+
+    assert_requested request
+    assert_requested :post, PUSH_ENDPOINT do |req|
+      req.headers["Content-Encoding"] == "aes128gcm" &&
+        req.headers["Authorization"].start_with?("vapid t=") &&
+        req.headers["Authorization"].include?("k=#{Push.vapid_public_key.delete("=")}") &&
+        req.headers["Ttl"] == Push::Subscription::TIME_TO_LIVE.to_i.to_s &&
+        req.headers["Urgency"] == "high" &&
+        !req.body.include?("Hello")
+    end
+    assert subscription.reload
+  end
+
+  test "deliver removes subscriptions the push service no longer knows" do
+    [ 404, 410 ].each do |status|
+      subscription = subscribe_to_push(@user)
+      stub_request(:post, PUSH_ENDPOINT).to_return(status: status)
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        subscription.deliver_now("{}")
+      end
+    end
+  end
+
+  test "deliver removes subscriptions whose keys can't be used to encrypt" do
+    [ { p256dh_key: "not-a-key" }, { p256dh_key: Base64.urlsafe_encode64("x" * 65) } ].each do |keys|
+      subscription = subscribe_to_push(@user)
+      subscription.update_columns(keys)
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        subscription.deliver_now("{}")
+      end
+    end
+
+    assert_not_requested :post, PUSH_ENDPOINT
+  end
+
+  test "deliver raises on other push service errors so they can be retried" do
+    subscription = subscribe_to_push(@user)
+    stub_request(:post, PUSH_ENDPOINT).to_return(status: 429).then.to_return(status: 503)
+
+    assert_raises(WebPush::TooManyRequests) { subscription.deliver_now("{}") }
+    assert_raises(WebPush::PushServiceError) { subscription.deliver_now("{}") }
+    assert subscription.reload
+  end
+
+  test "signing out of a session removes its subscriptions" do
+    subscription = subscribe_to_push(@user, session: sessions(:david))
+    other_device = subscribe_to_push(@user, endpoint: "https://web.push.apple.com/other-device")
+
+    sessions(:david).destroy
+
+    assert_not Push::Subscription.exists?(subscription.id)
+    assert Push::Subscription.exists?(other_device.id)
+  end
+
+  test "deactivating a user removes their subscriptions" do
+    subscribe_to_push(@user)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @user.deactivate
+    end
+  end
+
+  private
+    def build_subscription(endpoint:)
+      @user.push_subscriptions.new(endpoint: endpoint, **browser_push_keys)
+    end
+end
