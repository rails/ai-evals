diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..c27876a
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,50 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  # Web Push payloads are capped at around 4KB.
+  TITLE_LIMIT = 150
+  BODY_LIMIT = 300
+
+  included do
+    after_save_commit :push_later, if: :landed_in_tray?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self)
+  end
+
+  def push_now
+    if pushable?
+      payload = push_payload
+      user.push_subscriptions.each { it.deliver_later(payload) }
+    end
+  end
+
+  private
+    # New, or bumped back to the top of the tray by new activity on its card.
+    def landed_in_tray?
+      source_id_previously_changed? && pushable?
+    end
+
+    def pushable?
+      Push.enabled? && !read? && user.active? && user.push_subscriptions.exists? && account.active?
+    end
+
+    # Says what the tray says and opens what the tray item opens.
+    def push_payload
+      tray_text = render_tray_text
+
+      {
+        title: tray_text["title"].to_s.truncate(TITLE_LIMIT),
+        body: tray_text["body"].to_s.truncate(BODY_LIMIT),
+        path: Rails.application.routes.url_helpers.polymorphic_url(self, script_name: account.slug, only_path: true),
+        tag: id,
+        unread_count: user.notifications.unread.count
+      }.to_json
+    end
+
+    def render_tray_text
+      JSON.parse ApplicationController.renderer.new(script_name: account.slug).render(
+        partial: "notifications/notification/#{source_type.underscore}/body", formats: :json, locals: { notification: self })
+    end
+end
