diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..ee1e8c0
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  include PushTestHelper
+
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create subscribes the device to push notifications" do
+    params = { endpoint: PUSH_ENDPOINT, **browser_push_keys }
+
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: params }, headers: { "User-Agent" => "Mozilla/5.0 Firefox/140.0" }
+    end
+
+    assert_response :ok
+
+    subscription = @user.push_subscriptions.last
+    assert_equal params.stringify_keys, subscription.attributes.slice("endpoint", "p256dh_key", "auth_key")
+    assert_equal "Mozilla/5.0 Firefox/140.0", subscription.user_agent
+    assert_equal @user.account, subscription.account
+    assert_equal @user.identity.sessions.last, subscription.session
+  end
+
+  test "create as JSON, the way the browser sends it" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: PUSH_ENDPOINT, **browser_push_keys } }, as: :json
+    end
+
+    assert_response :ok
+  end
+
+  test "create refreshes an existing subscription instead of duplicating it" do
+    subscription = subscribe_to_push(@user)
+    subscription.update_columns(updated_at: 1.day.ago)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription.attributes.slice("endpoint", "p256dh_key", "auth_key") }
+    end
+
+    assert_response :ok
+    assert_in_delta Time.current, subscription.reload.updated_at, 1.second
+  end
+
+  test "create rejects endpoints that aren't a push service" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "https://169.254.169.254/latest", **browser_push_keys } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+    assert_equal [ "must be a push service URL" ], response.parsed_body["endpoint"]
+  end
+
+  test "create requires the subscription" do
+    post user_push_subscriptions_path(@user), params: { endpoint: PUSH_ENDPOINT }
+    assert_response :bad_request
+
+    post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: PUSH_ENDPOINT, p256dh_key: "", auth_key: "" } }, as: :json
+    assert_response :unprocessable_entity
+  end
+
+  test "create only subscribes yourself" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: { endpoint: PUSH_ENDPOINT, **browser_push_keys } }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create doesn't reach users in other accounts" do
+    post user_push_subscriptions_path(users(:mike)), params: { push_subscription: { endpoint: PUSH_ENDPOINT, **browser_push_keys } }
+
+    assert_response :not_found
+  end
+
+  test "signing out stops pushes to the device" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: PUSH_ENDPOINT, **browser_push_keys } }
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      sign_out
+    end
+  end
+end
diff --git a/test/jobs/push/subscription/delivery_job_test.rb b/test/jobs/push/subscription/delivery_job_test.rb
new file mode 100644
index 0000000..325ca55
--- /dev/null
+++ b/test/jobs/push/subscription/delivery_job_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Push::Subscription::DeliveryJobTest < ActiveJob::TestCase
+  include PushTestHelper
+
+  setup do
+    @subscription = subscribe_to_push(users(:kevin))
+  end
+
+  test "delivers the payload to the subscription" do
+    push = stub_request(:post, PUSH_ENDPOINT).to_return(status: 201)
+
+    Push::Subscription::DeliveryJob.perform_now(@subscription, "{}")
+
+    assert_requested push
+  end
+
+  test "retries when the push service is busy or down" do
+    stub_request(:post, PUSH_ENDPOINT).to_return(status: 429).then.to_return(status: 503).then.to_return(status: 201)
+
+    perform_enqueued_jobs do
+      Push::Subscription::DeliveryJob.perform_later(@subscription, "{}")
+    end
+
+    assert_requested :post, PUSH_ENDPOINT, times: 3
+  end
+
+  test "retries when the push service can't be reached" do
+    stub_request(:post, PUSH_ENDPOINT).to_timeout.then.to_return(status: 201)
+
+    perform_enqueued_jobs do
+      Push::Subscription::DeliveryJob.perform_later(@subscription, "{}")
+    end
+
+    assert_requested :post, PUSH_ENDPOINT, times: 2
+  end
+
+  test "discards deliveries to subscriptions that are gone" do
+    Push::Subscription::DeliveryJob.perform_later(@subscription, "{}")
+    @subscription.destroy
+
+    assert_nothing_raised { perform_enqueued_jobs }
+    assert_not_requested :post, PUSH_ENDPOINT
+  end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..dbd8a7e
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,159 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  include PushTestHelper
+
+  setup do
+    @kevin = users(:kevin)
+    @notification = notifications(:layout_commented_kevin)
+  end
+
+  test "pushes a new notification to a user with push subscriptions" do
+    subscribe_to_push(@kevin)
+    @kevin.notifications.where(card: cards(:logo)).delete_all
+
+    assert_enqueued_with job: Notification::PushJob do
+      notify @kevin, about: events(:logo_published)
+    end
+  end
+
+  test "pushes again when new activity on the card brings the notification back to the tray" do
+    subscribe_to_push(@kevin)
+    @notification.read
+    with_current_user(:david) { cards(:layout).comments.create!(body: "Another one") }
+
+    assert_enqueued_with job: Notification::PushJob, args: [ @notification ] do
+      perform_enqueued_jobs only: NotifyRecipientsJob
+    end
+    assert_not @notification.reload.read?
+  end
+
+  test "doesn't push when a notification is read or marked unread" do
+    subscribe_to_push(@kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.read
+      @notification.unread
+    end
+  end
+
+  test "doesn't push to users without push subscriptions" do
+    @kevin.notifications.where(card: cards(:logo)).delete_all
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notify @kevin, about: events(:logo_published)
+    end
+  end
+
+  test "push delivers to each of the user's subscriptions" do
+    phone = subscribe_to_push(@kevin)
+    laptop = subscribe_to_push(@kevin, endpoint: "https://web.push.apple.com/laptop")
+    subscribe_to_push(users(:david))
+
+    assert_enqueued_jobs 2, only: Push::Subscription::DeliveryJob do
+      @notification.push_now
+    end
+
+    delivered_to = enqueued_jobs.select { it["job_class"] == "Push::Subscription::DeliveryJob" }.map { GlobalID::Locator.locate(it["arguments"].first["_aj_globalid"]) }
+    assert_equal [ phone, laptop ].sort_by(&:id), delivered_to.sort_by(&:id)
+  end
+
+  test "push says what the tray says and opens the card it's about" do
+    subscribe_to_push(@kevin)
+    tray = render_tray_json(@notification)
+
+    payload = pushed_payload_for(@notification)
+
+    assert_equal "RE: Layout is broken", payload["title"]
+    assert_equal tray["title"], payload["title"]
+    assert_equal tray["body"], payload["body"]
+    assert_equal "#{accounts("37s").slug}/cards/#{cards(:layout).number}#comment_#{comments(:layout_overflowing_david).id}", payload["path"]
+    assert_equal @notification.id, payload["tag"]
+    assert_equal @kevin.notifications.unread.count, payload["unread_count"]
+  end
+
+  test "push for a mention says who mentioned you" do
+    david = users(:david)
+    subscribe_to_push(david)
+    notification = notifications(:logo_mentioned_david)
+    notification.unread
+
+    payload = pushed_payload_for(notification)
+
+    assert_equal render_tray_json(notification)["title"], payload["title"]
+    assert_match "@mentioned you", payload["title"]
+    assert_match %r{\A#{accounts("37s").slug}/cards/#{cards(:logo).number}}, payload["path"]
+  end
+
+  test "push keeps long titles and bodies within the push payload limit" do
+    subscribe_to_push(@kevin)
+    notification = notifications(:logo_assignment_kevin)
+    cards(:logo).update_columns(title: "T" * 255)
+    users(:kevin).update_columns(name: "K" * 255)
+    users(:jz).update_columns(name: "J" * 255)
+    events(:logo_assignment_km).update!(assignee_ids: [ users(:kevin).id, users(:jz).id ])
+
+    payload = pushed_payload_for(notification)
+
+    assert_equal Notification::Pushable::TITLE_LIMIT, payload["title"].length
+    assert_equal Notification::Pushable::BODY_LIMIT, payload["body"].length
+  end
+
+  test "push skips notifications that were read before the push went out" do
+    subscribe_to_push(@kevin)
+    @notification.read
+
+    assert_no_enqueued_jobs(only: Push::Subscription::DeliveryJob) { @notification.push_now }
+  end
+
+  test "push skips deactivated users and cancelled accounts" do
+    subscribe_to_push(@kevin)
+    @notification.unread
+    @kevin.update_columns(active: false)
+    assert_no_enqueued_jobs(only: Push::Subscription::DeliveryJob) { @notification.reload.push_now }
+
+    @kevin.update_columns(active: true)
+    accounts("37s").cancel(initiated_by: users(:jason))
+    assert_no_enqueued_jobs(only: Push::Subscription::DeliveryJob) { @notification.reload.push_now }
+  end
+
+  test "push does nothing without VAPID keys" do
+    subscribe_to_push(@kevin)
+    @notification.unread
+    Push.stubs(:vapid_private_key).returns(nil)
+
+    assert_not Push.enabled?
+    assert_no_enqueued_jobs(only: Push::Subscription::DeliveryJob) { @notification.push_now }
+  end
+
+  test "a new comment reaches the watcher's device" do
+    subscribe_to_push(@kevin)
+    push = stub_request(:post, PUSH_ENDPOINT).to_return(status: 201)
+
+    with_current_user(:david) { cards(:layout).comments.create!(body: "Pushed!") }
+
+    perform_enqueued_jobs only: NotifyRecipientsJob
+    perform_enqueued_jobs only: Notification::PushJob
+    perform_enqueued_jobs only: Push::Subscription::DeliveryJob
+
+    assert_requested push, times: 1
+  end
+
+  private
+    def notify(user, about:)
+      Notifier.for(about).notify
+      assert user.notifications.exists?(source: about), "Expected #{user.name} to be notified"
+    end
+
+    def pushed_payload_for(notification)
+      @notification_payload = nil
+      Push::Subscription.any_instance.expects(:deliver_later).with { |payload| @notification_payload = JSON.parse(payload) }.at_least_once
+      notification.push_now
+      @notification_payload
+    end
+
+    def render_tray_json(notification)
+      JSON.parse ApplicationController.renderer.render(
+        partial: "notifications/notification/#{notification.source_type.underscore}/body", formats: :json, locals: { notification: notification })
+    end
+end
