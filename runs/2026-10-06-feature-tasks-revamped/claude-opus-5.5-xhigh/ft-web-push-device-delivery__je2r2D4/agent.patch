new file mode 100644
index 0000000..22844b7
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,24 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @user.push_subscriptions.register(**push_subscription_params, user_agent: request.user_agent, session: Current.session)
+    head :ok
+  rescue ActiveRecord::RecordInvalid => error
+    render json: error.record.errors, status: :unprocessable_entity
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ]).to_h.symbolize_keys
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..6d0986c
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,115 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "explainer", "details" ]
+  static classes = [ "enabled" ]
+  static values = { subscriptionsUrl: String, vapidPublicKey: String }
+
+  async connect() {
+    if (!this.#supported) {
+      this.#revealHelp({ blocked: false })
+    } else if (Notification.permission === "denied") {
+      this.#revealHelp({ blocked: true })
+    } else if (Notification.permission === "granted") {
+      await this.#registerExistingSubscription()
+    }
+  }
+
+  async subscribe() {
+    if (!this.#supported) {
+      this.#revealHelp({ blocked: false })
+      return
+    }
+
+    // Ask before anything else: some browsers only prompt in direct response to a click.
+    const permission = await Notification.requestPermission()
+
+    if (permission === "granted") {
+      await this.#subscribeAndRegister()
+    } else if (permission === "denied") {
+      this.#revealHelp({ blocked: true })
+    }
+  }
+
+  async #subscribeAndRegister() {
+    try {
+      if (!await this.#register(await this.#subscribe())) {
+        this.#revealHelp({ blocked: false })
+      }
+    } catch (error) {
+      console.error("Couldn't subscribe to push notifications", error)
+      this.#revealHelp({ blocked: false })
+    }
+  }
+
+  async #registerExistingSubscription() {
+    const registration = await this.#serviceWorkerRegistration()
+    const subscription = await registration.pushManager.getSubscription()
+
+    if (subscription && this.#subscribedWithCurrentKey(subscription)) {
+      await this.#register(subscription)
+    }
+  }
+
+  async #subscribe() {
+    const registration = await this.#serviceWorkerRegistration()
+    const existing = await registration.pushManager.getSubscription()
+
+    if (existing && this.#subscribedWithCurrentKey(existing)) {
+      return existing
+    } else {
+      await existing?.unsubscribe()
+      return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#vapidPublicKey })
+    }
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: p256dh, auth_key: auth } },
+      responseKind: "json"
+    })
+
+    this.element.classList.toggle(this.enabledClass, response.ok)
+    return response.ok
+  }
+
+  async #serviceWorkerRegistration() {
+    if (!await navigator.serviceWorker.getRegistration()) {
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    }
+
+    return navigator.serviceWorker.ready
+  }
+
+  #revealHelp({ blocked }) {
+    this.buttonTarget.hidden = true
+    this.explainerTarget.hidden = false
+    this.detailsTargets.forEach(target => target.hidden = !blocked)
+  }
+
+  // Subscriptions made with a previous key pair can't receive our pushes anymore.
+  #subscribedWithCurrentKey(subscription) {
+    const key = subscription.options?.applicationServerKey
+
+    if (key) {
+      const subscribedKey = new Uint8Array(key)
+      const currentKey = this.#vapidPublicKey
+      return subscribedKey.length === currentKey.length && subscribedKey.every((byte, index) => byte === currentKey[index])
+    } else {
+      return true
+    }
+  }
+
+  get #vapidPublicKey() {
+    const base64 = this.vapidPublicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, "=")
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+}
