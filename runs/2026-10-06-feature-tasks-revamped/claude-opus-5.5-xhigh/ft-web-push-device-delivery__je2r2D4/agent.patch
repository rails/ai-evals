@@ -0,0 +1,18 @@
+module PushTestHelper
+  PUSH_ENDPOINT = "https://fcm.googleapis.com/fcm/send/dGVzdC1lbmRwb2ludA"
+
+  private
+    # The keys a browser generates for a push subscription: an ECDH P-256 public key and an auth secret.
+    def browser_push_keys
+      key = OpenSSL::PKey::EC.generate("prime256v1")
+
+      {
+        p256dh_key: Base64.urlsafe_encode64(key.public_key.to_bn.to_s(2), padding: false),
+        auth_key: Base64.urlsafe_encode64(Random.bytes(16), padding: false)
+      }
+    end
+
+    def subscribe_to_push(user, endpoint: PUSH_ENDPOINT, **attributes)
+      user.push_subscriptions.create!(endpoint: endpoint, **browser_push_keys, **attributes)
+    end
+end
