diff --git a/config/initializers/web_push.rb b/config/initializers/web_push.rb
new file mode 100644
index 0000000..d8fda65
--- /dev/null
+++ b/config/initializers/web_push.rb
@@ -0,0 +1,22 @@
+# Web Push signs every push with a VAPID key pair (RFC 8292). In production, ops
+# provides it through VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY; without both, web
+# push stays off. In development and test we fall back to a key pair generated
+# once and kept in tmp/, like Rails' local secret, so push works out of the box.
+Rails.application.configure do
+  vapid_keys =
+    if ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+      ENV.values_at("VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY")
+    elsif Rails.env.local?
+      path = Rails.root.join("tmp/local_vapid_keys.json")
+
+      unless path.exist?
+        key = WebPush.generate_key
+        path.dirname.mkpath
+        path.write JSON.generate([ key.public_key, key.private_key ])
+      end
+
+      JSON.parse(path.read)
+    end
+
+  config.x.web_push.vapid_public_key, config.x.web_push.vapid_private_key = vapid_keys
+end
