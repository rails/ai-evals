+class Push::Subscription::DeliveryJob < ApplicationJob
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError,
+    Timeout::Error, SocketError, SystemCallError, OpenSSL::SSL::SSLError,
+    wait: :polynomially_longer, attempts: 3
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(subscription, payload)
+    subscription.deliver_now(payload)
+  end
+end
