+module Push
+  def self.table_name_prefix
+    "push_"
+  end
+
+  def self.enabled?
+    vapid_public_key.present? && vapid_private_key.present?
+  end
+
+  def self.vapid_public_key
+    Rails.configuration.x.web_push.vapid_public_key
+  end
+
+  def self.vapid_private_key
+    Rails.configuration.x.web_push.vapid_private_key
+  end
+
+  def self.vapid
+    { subject: vapid_subject, public_key: vapid_public_key, private_key: vapid_private_key }
+  end
+
+  # Push services may use this to get in touch about the pushes we send.
+  def self.vapid_subject
+    "mailto:#{Mail::Address.new(ApplicationMailer.default[:from]).address}"
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..5f8970c
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,70 @@
+class Push::Subscription < ApplicationRecord
+  # Browsers subscribe through their vendor's push service. Endpoints are supplied
+  # by the client, so we only accept (and ever post to) those services' hosts.
+  PUSH_SERVICE_HOSTS = %w[
+    fcm.googleapis.com
+    jmt17.google.com
+    push.services.mozilla.com
+    push.apple.com
+    notify.windows.com
+  ].freeze
+
+  TIME_TO_LIVE = 1.day
+  TIMEOUT = 5.seconds
+
+  class UnusableKeys < StandardError; end
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  belongs_to :session, optional: true
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint_belongs_to_a_push_service, if: :endpoint?
+
+  def self.register(endpoint:, **attributes)
+    create_or_find_by!(endpoint: endpoint) { it.assign_attributes(attributes) }.tap do |subscription|
+      subscription.update!(**attributes, updated_at: Time.current) unless subscription.previously_new_record?
+    end
+  end
+
+  def deliver_later(payload)
+    DeliveryJob.perform_later(self, payload)
+  end
+
+  def deliver_now(payload)
+    request_for(payload).perform
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, UnusableKeys
+    destroy
+  end
+
+  private
+    def validate_endpoint_belongs_to_a_push_service
+      uri = URI.parse(endpoint)
+
+      unless uri.is_a?(URI::HTTPS) && push_service_host?(uri.host)
+        errors.add :endpoint, "must be a push service URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "must be a push service URL"
+    end
+
+    def push_service_host?(host)
+      host = host.to_s.downcase
+      PUSH_SERVICE_HOSTS.any? { |service_host| host == service_host || host.end_with?(".#{service_host}") }
+    end
+
+    # The payload is encrypted for the browser's keys as the request is built.
+    def request_for(payload)
+      WebPush::Request.new \
+        message: payload,
+        subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        vapid: Push.vapid,
+        ttl: TIME_TO_LIVE.to_i,
+        urgency: "high",
+        open_timeout: TIMEOUT.to_i,
+        read_timeout: TIMEOUT.to_i,
+        ssl_timeout: TIMEOUT.to_i
+    rescue ArgumentError, OpenSSL::OpenSSLError => error
+      raise UnusableKeys, error.message
+    end
+end
