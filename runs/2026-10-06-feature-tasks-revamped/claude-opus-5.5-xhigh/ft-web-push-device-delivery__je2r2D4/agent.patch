diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..8d197bf 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -60,6 +60,72 @@ TurboOffline.addRule({
   })
 })
 
+// Push notifications
+self.addEventListener("push", (event) => {
+  event.waitUntil(showPushNotification(event.data))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openPushNotification(event.notification))
+})
+
+async function showPushNotification(data) {
+  const { title, body, path, tag, unread_count } = readPushData(data)
+
+  await Promise.all([
+    self.registration.showNotification(title || "Fizzy", {
+      body,
+      tag,
+      renotify: Boolean(tag),
+      icon: "/app-icon-192.png",
+      data: { path }
+    }),
+    updateAppBadge(unread_count)
+  ])
+}
+
+function readPushData(data) {
+  try {
+    return data?.json() ?? {}
+  } catch {
+    return {}
+  }
+}
+
+async function updateAppBadge(count) {
+  if ("setAppBadge" in self.navigator && Number.isInteger(count)) {
+    if (count > 0) {
+      await self.navigator.setAppBadge(count)
+    } else {
+      await self.navigator.clearAppBadge()
+    }
+  }
+}
+
+// Opens what the notification is about, reusing a Fizzy window if there is one
+async function openPushNotification(notification) {
+  const url = sameOriginURL(notification.data?.path)
+  const windowClients = await self.clients.matchAll({ type: "window" })
+  const windowClient = windowClients.find((client) => client.focused) ?? windowClients[0]
+
+  try {
+    if (windowClient) {
+      await windowClient.focus()
+      await windowClient.navigate(url)
+    } else {
+      await self.clients.openWindow(url)
+    }
+  } catch {
+    await self.clients.openWindow(url)
+  }
+}
+
+function sameOriginURL(path) {
+  const url = new URL(path || "/", self.location.origin)
+  return url.origin === self.location.origin ? url.href : self.location.origin
+}
+
 self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
