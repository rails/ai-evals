index 0000000..be49bfd
--- /dev/null
+++ b/test/controllers/columns/cards/drops/closures_controller_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Columns::Cards::Drops::ClosuresControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "create" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.closed? }, from: false, to: true do
+      post columns_card_drops_closure_path(card)
+    end
+
+    assert_response :no_content
+    assert_equal users(:david), card.closed_by
+  end
+
+  test "create closes a postponed card" do
+    card = cards(:logo)
+    Current.set(user: users(:kevin)) { card.postpone }
+
+    post columns_card_drops_closure_path(card)
+
+    assert_response :no_content
+    assert card.reload.closed?
+    assert_not card.postponed?
+  end
+
+  test "create for an inaccessible card" do
+    card = Current.set(user: users(:kevin)) { boards(:private).cards.create!(title: "Secret", status: :published) }
+
+    post columns_card_drops_closure_path(card)
+
+    assert_response :not_found
+    assert_not card.reload.closed?
+  end
+end
diff --git a/test/controllers/columns/cards/drops/columns_controller_test.rb b/test/controllers/columns/cards/drops/columns_controller_test.rb
new file mode 100644
index 0000000..3a093f0
--- /dev/null
+++ b/test/controllers/columns/cards/drops/columns_controller_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Columns::Cards::Drops::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "create" do
+    card, column = cards(:buy_domain), columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.column }, from: nil, to: column do
+      post columns_card_drops_column_path(card, column_id: column.id)
+    end
+
+    assert_response :no_content
+    assert_equal "card_triaged", card.events.last.action
+  end
+
+  test "create reopens a closed card" do
+    card, column = cards(:shipping), columns(:writebook_in_progress)
+
+    post columns_card_drops_column_path(card, column_id: column.id)
+
+    assert_response :no_content
+    assert card.reload.open?
+    assert_equal column, card.column
+  end
+
+  test "create resumes a postponed card" do
+    card, column = cards(:buy_domain), columns(:writebook_review)
+    Current.set(user: users(:kevin)) { card.postpone }
+
+    post columns_card_drops_column_path(card, column_id: column.id)
+
+    assert_response :no_content
