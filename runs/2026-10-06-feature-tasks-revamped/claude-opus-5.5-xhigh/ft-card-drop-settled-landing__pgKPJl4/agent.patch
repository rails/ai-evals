diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..86b5fc4
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,338 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  teardown do
+    wait_for_saves
+  end
+
+  test "a dropped card is in place before it's saved, and nothing shifts once it is" do
+    triage = columns(:writebook_triage)
+
+    visit_board
+    holding_saves { drag cards(:buy_domain), to: triage }
+
+    assert_cards_in triage, :logo, :buy_domain, :layout # Golden cards stay first
+    assert_count_of "maybe", 0
+    assert_count_of triage, 3
+    assert_nil cards(:buy_domain).reload.column, "The save should still be held"
+
+    dropped = board_state
+    release_saves
+
+    assert_eventually { cards(:buy_domain).reload.column == triage }
+    assert_equal dropped, board_state
+
+    refresh_board
+    assert_equal dropped, board_state, "The board should match what the server renders"
+    assert_selector "article[draggable=true]", count: 5, visible: :all
+  end
+
+  test "the save doesn't refresh the board it was dropped on" do
+    visit_board
+    wait_for_cable_subscriptions
+    drag cards(:buy_domain), to: columns(:writebook_triage)
+    wait_for_saves
+
+    mark_lists_stale
+    deliver_board_refreshes
+    sleep 1 # Turbo debounces refreshes, so give one the chance to happen
+
+    assert_selector "[data-drag-and-drop-target~=list][data-stale]", count: 7, visible: :all
+  end
+
+  test "dropping into Not Now and Done, and back out again" do
+    in_progress = columns(:writebook_in_progress)
+
+    visit_board
+    drag cards(:buy_domain), to: "not-now"
+    assert_cards_in "not-now", :buy_domain
+    assert_selector "#not-now #{card_selector(:buy_domain)}.card--postponed:not(.card--active)", visible: :all
+
+    drag cards(:layout), to: "closed-cards", from: columns(:writebook_triage)
+    assert_cards_in "closed-cards", :layout, :shipping
+
+    drag cards(:shipping), to: in_progress, from: "closed-cards"
+    assert_cards_in in_progress, :shipping, :text
+    assert_no_selector "#{card_selector(:shipping)} .card__closed", visible: :all
+
+    drag cards(:buy_domain), to: "maybe", from: "not-now"
+    assert_cards_in "maybe", :buy_domain
+    assert_selector "#maybe #{card_selector(:buy_domain)}.card--active:not(.card--postponed)"
+
+    assert_count_of "maybe", 1
+    assert_count_of "not-now", 0
+    assert_count_of columns(:writebook_triage), 1
+    assert_count_of in_progress, 2
+    assert_count_of "closed-cards", 1
+
+    assert_eventually { cards(:buy_domain).reload.awaiting_triage? && cards(:shipping).reload.column == in_progress && cards(:shipping).open? }
+    assert cards(:layout).reload.closed?
+    assert_not cards(:buy_domain).postponed?
+
+    dropped = board_state
+    refresh_board
+    assert_equal dropped, board_state
+  end
+
+  test "dropped cards go where their column sorts them" do
+    in_progress = columns(:writebook_in_progress)
+    cards(:text).gild
+
+    visit_board
+    drag cards(:buy_domain), to: in_progress
+    assert_cards_in in_progress, :text, :buy_domain
+
+    drag cards(:logo), to: in_progress, from: columns(:writebook_triage)
+    assert_cards_in in_progress, :logo, :text, :buy_domain
+
+    drag cards(:logo), to: "closed-cards", from: in_progress
+    assert_cards_in "closed-cards", :logo, :shipping # Done keeps most recently closed first, golden or not
+
+    assert_eventually { cards(:logo).reload.closed? }
+
+    dropped = board_state
+    refresh_board
+    assert_equal dropped, board_state
+  end
+
+  test "a card can't be dropped back into its own column" do
+    visit_board
+
+    holding_saves do
+      dispatch_drag_event "dragstart", on: card_selector(:buy_domain)
+      assert_not dispatch_drag_event("dragover", on: "#maybe"), "The browser should be told there's no drop here"
+      dispatch_drag_event "drop", on: "#maybe"
+      dispatch_drag_event "dragend", on: card_selector(:buy_domain)
+    end
+
+    assert_cards_in "maybe", :buy_domain
+    assert_count_of "maybe", 1
+    assert_equal 0, evaluate_script("heldSaves.length")
+  end
+
+  test "the column under the pointer lights up and the dragged card dims" do
+    triage = columns(:writebook_triage)
+
+    visit_board
+    dispatch_drag_event "dragstart", on: card_selector(:buy_domain)
+    assert dispatch_drag_event("dragover", on: "##{dom_id(triage)}"), "Another column should accept the drop"
+
+    assert_selector "##{dom_id(triage)}.drag-and-drop__hover-container"
+    assert_selector "#{card_selector(:buy_domain)}.drag-and-drop__dragged-item"
+
+    dispatch_drag_event "dragover", on: "#maybe"
+    assert_no_selector ".drag-and-drop__hover-container", visible: :all
+
+    dispatch_drag_event "dragend", on: card_selector(:buy_domain)
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+  end
+
+  test "a dropped card was just touched, so its entropy bubble goes" do
+    triage = columns(:writebook_triage)
+    cards(:buy_domain).update_columns last_active_at: 80.days.ago, updated_at: Time.current
+
+    visit_board
+    assert_selector "#{card_selector(:buy_domain)} .bubble:not([hidden])", visible: :all
+
+    expand triage
+    drag cards(:buy_domain), to: triage
+
+    within(container_selector(triage)) do
+      assert_no_selector "#{card_selector(:buy_domain)} .bubble:not([hidden])", visible: :all
+      assert_selector "#{card_selector(:buy_domain)} .card__meta-text--updated", text: "TODAY"
+    end
+
+    assert_eventually { cards(:buy_domain).reload.column == triage }
+
+    dropped = board_state
+    refresh_board
+    assert_equal dropped, board_state
+  end
+
+  test "emptying a column shows its placeholder" do
+    in_progress, review = columns(:writebook_in_progress), columns(:writebook_review)
+
+    visit_board
+    drag cards(:text), to: review, from: in_progress
+    within(container_selector(in_progress)) { assert_text "Drag cards here" }
+
+    expand review
+    within(container_selector(review)) do
+      assert_selector card_selector(:text)
+      assert_no_text "Drag cards here"
+    end
+
+    assert_eventually { cards(:text).reload.column == review }
+
+    dropped = board_state
+    refresh_board
+    assert_equal dropped, board_state
+  end
+
+  test "a failed save shows the board as it really is" do
+    gone = columns(:writebook_review)
+
+    visit_board
+    gone.destroy!
+    drag cards(:buy_domain), to: gone
+
+    assert_no_selector "##{dom_id(gone)}", visible: :all
+    assert_cards_in "maybe", :buy_domain
+    assert_count_of "maybe", 1
+  end
+
+  test "dragging from something inside a card drags the whole card" do
+    visit_board
+    dispatch_drag_event "dragstart", on: "#{card_selector(:buy_domain)} .card__meta-avatars--author a"
+
+    assert dispatch_drag_event("dragover", on: container_selector(columns(:writebook_triage)))
+    assert_selector "#{card_selector(:buy_domain)}.drag-and-drop__dragged-item"
+  end
+
+  test "cards can only be dragged on wide screens" do
+    visit_board
+    assert_selector "article[draggable=true]", count: 5, visible: :all
+
+    page.current_window.resize_to 500, 900
+    assert_no_selector "article[draggable=true]", visible: :all
+
+    dispatch_drag_event "dragstart", on: "#{card_selector(:buy_domain)} .card__meta-avatars--author a"
+    assert_not dispatch_drag_event("dragover", on: container_selector(columns(:writebook_triage)))
+  ensure
+    page.current_window.resize_to 1200, 1000
+  end
+
+  private
+    def visit_board
+      visit board_url(boards(:writebook))
+      assert_selector "[data-drag-and-drop-target~=list]", count: 7, visible: :all
+      track_saves
+    end
+
+    def track_saves
+      execute_script <<~JS
+        const fetch = window.fetch
+        window.savesInFlight = 0
+        window.fetch = (url, options = {}) => {
+          if (options.method != "POST") return fetch(url, options)
+
+          savesInFlight++
+          const save = window.heldSaves ? new Promise(resolve => heldSaves.push(resolve)) : Promise.resolve()
+          return save.then(() => fetch(url, options)).finally(() => savesInFlight--)
+        }
+      JS
+    end
+
+    def drag(card, to:, from: nil)
+      expand from if from
+      find(card_selector(card)).drag_to find(container_selector(to), visible: :all)
+    end
+
+    def expand(container)
+      find("#{container_selector(container)} .cards__expander").click unless find(container_selector(container)).matches_css?(".is-expanded")
+      assert_selector "#{container_selector(container)}.is-expanded"
+    end
+
+    def card_selector(card)
+      card = cards(card) if card.is_a?(Symbol)
+      "##{dom_id(card, :article)}"
+    end
+
+    def container_selector(container)
+      "##{container.is_a?(Column) ? dom_id(container) : container}"
+    end
+
+    def assert_cards_in(container, *names)
+      expected = names.map { |name| dom_id(cards(name), :article) }
+      assert_equal expected, evaluate_script(<<~JS, find(container_selector(container), visible: :all))
+        [ ...arguments[0].querySelectorAll("[data-drag-and-drop-target~=item]") ].map(card => card.id)
+      JS
+    end
+
+    def assert_count_of(container, count)
+      assert_selector "#{container_selector(container)} .cards__expander-count", text: count.to_s, visible: :all
+    end
+
+    def holding_saves
+      execute_script "window.heldSaves = []"
+      yield
+    end
+
+    def release_saves
+      execute_script "const saves = heldSaves; window.heldSaves = null; saves.forEach(release => release())"
+    end
+
+    # A save still in flight when a test ends would land in the next one
+    def wait_for_saves
+      if evaluate_script("typeof savesInFlight == 'number'")
+        execute_script "window.heldSaves?.forEach(release => release()); window.heldSaves = null"
+        assert_eventually { evaluate_script("savesInFlight") == 0 }
+      end
+    end
+
+    # Returns whether the event was canceled, which for dragover is how a drop target accepts the drop
+    def dispatch_drag_event(type, on:)
+      evaluate_script <<~JS, find(on, visible: :all), type
+        (function(element, type) {
+          window.dragData ||= new DataTransfer()
+          return !element.dispatchEvent(new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer: dragData }))
+        })(...arguments)
+      JS
+    end
+
+    # Everything a person sees on the board: which cards each column holds, in which order, how they look, and the counts
+    def board_state
+      evaluate_script <<~JS
+        Object.fromEntries([ ...document.querySelectorAll("[data-drag-and-drop-target~=container]") ].map(column => [ column.id, {
+          count: column.querySelector(".cards__expander-count").textContent.trim(),
+          placeholder: [ ...column.querySelectorAll(".blank-slate") ].some(slate => slate.checkVisibility()),
+          cards: [ ...column.querySelectorAll("[data-drag-and-drop-target~=item]") ].map(card => ({
+            id: card.id,
+            color: getComputedStyle(card).getPropertyValue("--card-color").trim(),
+            classes: [ ...card.classList ].filter(name => !name.startsWith("drag-and-drop")).sort().join(" "),
+            stamp: [ ...card.querySelectorAll(".card__closed") ].some(stamp => getComputedStyle(stamp).display != "none"),
+            bubble: [ ...card.querySelectorAll(".bubble") ].some(bubble => !bubble.hidden && getComputedStyle(bubble).display != "none"),
+            updated: card.querySelector(".card__meta-text--updated").textContent.trim()
+          }))
+        } ]))
+      JS
+    end
+
+    # A Turbo page refresh, like the ones broadcast when someone else changes the board
+    def refresh_board
+      mark_lists_stale
+      execute_script "Turbo.visit(location.href, { action: 'replace' })"
+      assert_no_selector "[data-drag-and-drop-target~=list][data-stale]", visible: :all, wait: 5
+    end
+
+    # Refreshing re-renders every list, which drops the mark
+    def mark_lists_stale
+      execute_script "document.querySelectorAll('[data-drag-and-drop-target~=list]').forEach(list => list.dataset.stale = true)"
+    end
+
+    # Refreshes are broadcast from a background thread after a short debounce, so wait until the board's is on its way
+    def deliver_board_refreshes
+      assert_eventually { enqueued_jobs.any? { |job| job["arguments"].first == boards(:writebook).to_gid_param } }
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def assert_eventually(timeout: Capybara.default_max_wait_time)
+      deadline = timeout.seconds.from_now
+      until yield
+        flunk "Timed out waiting for the condition" if Time.current > deadline
+        sleep 0.05
+      end
+    end
+end
