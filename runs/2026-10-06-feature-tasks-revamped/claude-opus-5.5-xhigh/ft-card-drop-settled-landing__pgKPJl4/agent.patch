diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..c78fdcb
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,208 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { post } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+// Moves cards between columns by dragging. Columns keep their own order, so a dropped card goes where its
+// new column sorts it, not where it was let go. The board changes the moment the card is dropped and the
+// save happens in the background, with nothing re-rendered when it finishes.
+export default class extends Controller {
+  static targets = [ "container", "list", "item", "count" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = { desktopBreakpoint: { type: String, default: "(min-width: 640px)" } }
+
+  #saves = Promise.resolve()
+  #pendingSaves = 0
+  #failedSave = false
+
+  initialize() {
+    this.mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+  }
+
+  connect() {
+    this.mediaQuery.addEventListener("change", this.#toggleDragging)
+  }
+
+  disconnect() {
+    this.mediaQuery.removeEventListener("change", this.#toggleDragging)
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = this.mediaQuery.matches
+  }
+
+  // Actions
+
+  dragStart(event) {
+    const item = this.#itemContaining(event.target)
+    if (!item?.draggable) return
+
+    this.dragItem = item
+    this.sourceContainer = this.#containerContaining(item)
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("application/x-drag-and-drop-item", item.dataset.dragAndDropId) // Firefox won't drag without data
+    if (event.target !== item) this.#dragWholeItem(event, item)
+
+    this.#dim(item)
+  }
+
+  dragOver(event) {
+    if (!this.dragItem) return
+
+    const container = this.#dropContainerFor(event.target)
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#highlight(container)
+  }
+
+  dragLeave(event) {
+    if (this.dragItem && !this.element.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const container = this.dragItem && this.#dropContainerFor(event.target)
+
+    if (container) {
+      event.preventDefault()
+      this.#move(this.dragItem, this.sourceContainer, container)
+    }
+  }
+
+  dragEnd() {
+    this.dragItem?.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+    this.dragItem = this.sourceContainer = null
+  }
+
+  keepDraggable(event) {
+    // Cards are made draggable here rather than by the server, so morphs shouldn't take it away
+    if (event.detail.attributeName === "draggable") event.preventDefault()
+  }
+
+  // Private
+
+  #toggleDragging = () => {
+    this.itemTargets.forEach(item => this.itemTargetConnected(item))
+  }
+
+  #itemContaining(element) {
+    return this.itemTargets.find(item => item.contains(element))
+  }
+
+  #containerContaining(element) {
+    return this.containerTargets.find(container => container.contains(element))
+  }
+
+  #listIn(container) {
+    return this.listTargets.find(list => container.contains(list))
+  }
+
+  #dragWholeItem(event, item) {
+    // Drags that start on something inside a card, like an avatar, still drag the whole card
+    const { left, top } = item.getBoundingClientRect()
+    event.dataTransfer.setDragImage(item, event.clientX - left, event.clientY - top)
+  }
+
+  async #dim(item) {
+    // Let the browser take its drag image first, so only the card left behind dims
+    await nextFrame()
+    if (this.dragItem === item) item.classList.add(this.draggedItemClass)
+  }
+
+  #dropContainerFor(element) {
+    const container = this.#containerContaining(element)
+
+    // Cards move between columns, never within one, and only into columns whose cards have loaded
+    if (container && container !== this.sourceContainer && this.#listIn(container)) {
+      return container
+    }
+  }
+
+  #highlight(hoveredContainer) {
+    this.containerTargets.forEach(container => {
+      container.classList.toggle(this.hoverContainerClass, container === hoveredContainer)
+    })
+  }
+
+  #move(item, source, container) {
+    this.#restyle(item, source, container)
+    this.#insert(item, container)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(container, +1)
+    this.#save(item, container)
+  }
+
+  // Show the card as its new column renders it: in that column's color and status, and just touched
+  #restyle(item, source, container) {
+    item.style.setProperty("--card-color", container.dataset.dragAndDropCardColor)
+    item.classList.remove(...this.#cardClassesFor(source))
+    item.classList.add(...this.#cardClassesFor(container))
+
+    // Stamps and entropy bubbles describe the card's old status and idle time, which moving it resets.
+    // Its last-updated time re-renders once the card is placed.
+    item.querySelectorAll(".card__closed, .bubble").forEach(element => element.remove())
+    item.querySelector(".card__meta-text--updated time")?.setAttribute("datetime", Math.floor(Date.now() / 1000))
+  }
+
+  #cardClassesFor(container) {
+    return container.dataset.dragAndDropCardClass?.split(" ") ?? []
+  }
+
+  // Moving a card touches it, so it leads its new column, behind any golden cards in columns that put those first
+  #insert(item, container) {
+    const list = this.#listIn(container)
+    const cards = this.itemTargets.filter(card => list.contains(card))
+    const goldenCards = cards.filter(card => this.#isGolden(card))
+
+    if (this.#keepsGoldenFirst(container) && !this.#isGolden(item) && goldenCards.length) {
+      goldenCards.at(-1).after(item)
+    } else if (cards.length) {
+      cards[0].before(item)
+    } else {
+      list.prepend(item)
+    }
+  }
+
+  #isGolden(item) {
+    return item.hasAttribute("data-drag-and-drop-golden")
+  }
+
+  #keepsGoldenFirst(container) {
+    return container.hasAttribute("data-drag-and-drop-golden-first")
+  }
+
+  #adjustCount(container, change) {
+    const counter = this.countTargets.find(counter => container.contains(counter))
+
+    if (counter) {
+      const count = Number(counter.dataset.dragAndDropCount) + change
+      counter.dataset.dragAndDropCount = count
+      counter.textContent = count > 99 ? "99+" : count
+    }
+  }
+
+  // Saves go out one at a time, in the order cards were dropped, so the server ends up where the board shows
+  #save(item, container) {
+    const url = container.dataset.dragAndDropUrl.replace("__id__", item.dataset.dragAndDropId)
+
+    this.#pendingSaves++
+    this.#saves = this.#saves.then(() => this.#submit(url))
+  }
+
+  async #submit(url) {
+    const saved = await post(url, { keepalive: true }).then(response => response.ok, () => false)
+    this.#failedSave ||= !saved
+
+    if (--this.#pendingSaves === 0 && this.#failedSave) {
+      // The board shows a move the server didn't make, so show the board as it really is
+      this.#failedSave = false
+      Turbo.visit(window.location.href, { action: "replace" })
+    }
+  }
+}
