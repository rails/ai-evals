+    assert_nil card.reload.column
+  end
+
+  test "create for an inaccessible card" do
+    card = Current.set(user: users(:kevin)) { boards(:private).cards.create!(title: "Secret", status: :published) }
+    column = boards(:private).columns.create!(name: "Doing")
+
+    post columns_card_drops_column_path(card, column_id: column.id)
