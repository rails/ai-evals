+module SearchesHelper
+  def search_highlight(text, search)
+    safe_join text.to_s.split(search.pattern).each_with_index.collect { |part, index| index.odd? ? tag.mark(part) : part }
+  end
+
+  def search_excerpt(text, search, radius: 20)
+    text = text.to_s.squish
+    search_highlight excerpt(text, search.pattern, radius: radius, separator: " ") || text.truncate_words(radius * 2), search
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..114d014
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,92 @@
+# Finds the published cards a user can access whose title, description, or comments contain
+# every term in a query.
+#
+# Candidates are matched in SQL against the stored rich text HTML, and then confirmed against
+# its plain text with #results_for, so that markup (tag names, attachment attributes, etc.)
+# never counts as a match.
+class Search
+  MAX_TERMS = 10
+
+  # Rich text is stored as HTML, where these characters are entity-encoded.
+  HTML_ESCAPES = { "&" => "&amp;", "<" => "&lt;", ">" => "&gt;" }
+
+  attr_reader :user, :query, :terms
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.squish
+    @terms = @query.split.uniq(&:downcase).first(MAX_TERMS)
+  end
+
+  def cards
+    if terms.any?
+      terms
+        .inject(user.accessible_cards.published) { |cards, term| cards.where(containing(term)) }
+        .reverse_chronologically
+        .preload(:board)
+        .with_rich_text_description
+    else
+      Card.none
+    end
+  end
+
+  def results_for(cards)
+    comments = comments_matching_any_term_on(cards).group_by(&:card_id)
+
+    cards
+      .collect { |card| Result.new(self, card, comments.fetch(card.id, [])) }
+      .select(&:match?)
+  end
+
+  def pattern
+    @pattern ||= /(#{Regexp.union(terms.sort_by(&:length).reverse).source})/i
+  end
+
+  def matches_all_terms?(text)
+    terms.all? { |term| text.match?(/#{Regexp.escape(term)}/i) }
+  end
+
+  def matches_any_term?(text)
+    text.match?(pattern)
+  end
+
+  private
+    def containing(term)
+      Card.arel_table[:title].matches(like_pattern(term), "\\")
+        .or(descriptions_containing(term).arel.exists)
+        .or(comments_containing(term).arel.exists)
+    end
+
+    def descriptions_containing(term)
+      ActionText::RichText
+        .where(record_type: "Card", name: "description")
+        .where(ActionText::RichText.arel_table[:record_id].eq(Card.arel_table[:id]))
+        .where(rich_text_body_containing(term))
+    end
+
+    def comments_containing(term)
+      Comment
+        .joins(:rich_text_body)
+        .where(Comment.arel_table[:card_id].eq(Card.arel_table[:id]))
+        .where(rich_text_body_containing(term))
+    end
+
+    def comments_matching_any_term_on(cards)
+      Comment
+        .where(card_id: cards.collect(&:id))
+        .joins(:rich_text_body)
+        .where(terms.collect { rich_text_body_containing(it) }.inject(:or))
+        .preload(:creator, :rich_text_body)
+        .order(created_at: :desc, id: :desc)
+    end
+
+    def rich_text_body_containing(term)
+      [ term, term.gsub(/[&<>]/, HTML_ESCAPES) ].uniq
+        .collect { ActionText::RichText.arel_table[:body].matches(like_pattern(it), "\\") }
+        .inject(:or)
+    end
+
+    def like_pattern(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term)}%"
+    end
+end
diff --git a/app/models/search/result.rb b/app/models/search/result.rb
new file mode 100644
index 0000000..ddf83fe
--- /dev/null
+++ b/app/models/search/result.rb
@@ -0,0 +1,35 @@
+class Search::Result
+  attr_reader :card
+
+  def initialize(search, card, comments)
+    @search = search
+    @card = card
+    @comments = comments
+  end
+
+  def match?
+    search.matches_all_terms? [ card.title, description, *comment_bodies.values ].join("\n")
+  end
+
+  # The newest matching comment, when the description itself doesn't match.
+  def comment
+    unless search.matches_any_term?(description)
+      comments.find { |comment| search.matches_any_term?(comment_bodies[comment]) }
+    end
+  end
+
+  def excerpt
+    comment ? comment_bodies[comment] : description
+  end
+
+  private
+    attr_reader :search, :comments
+
+    def description
+      @description ||= card.description.to_plain_text
+    end
+
+    def comment_bodies
+      @comment_bodies ||= comments.index_with { it.body.to_plain_text }
+    end
+end
diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..ea7bd4e
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,22 @@
+<% card, comment = result.card, result.comment %>
+
+<article class="search-result" id="<%= dom_id(card, :search_result) %>">
+  <%= link_to card_path(card, anchor: (dom_id(comment) if comment)), class: "search-result__link", data: { turbo_frame: "_top" } do %>
+    <div class="search-result__meta txt-x-small translucent">
+      <span class="overflow-ellipsis"><%= card.board.name %></span>
+      <span>#<%= card.number %></span>
+      <span>Added <%= local_datetime_tag card.created_at, style: :daysago %></span>
+    </div>
+
+    <h2 class="search-result__title txt-medium"><%= search_highlight card.title, search %></h2>
+
+    <% if result.excerpt.present? %>
+      <p class="search-result__excerpt txt-small">
+        <% if comment %>
+          <strong><%= comment.creator.name %> commented:</strong>
+        <% end %>
+        <%= search_excerpt result.excerpt, search %>
+      </p>
+    <% end %>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..eeebd48
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,27 @@
+<% @page_title = @search.query.present? ? "Search for “#{@search.query}”" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<div class="search panel panel--wide center borderless unpad flex flex-column gap margin-block-start">
+  <%= form_with url: search_path, method: :get, role: "search", class: "flex align-center gap-half" do |form| %>
+    <%= form.search_field :q, value: @search.query, class: "input full-width", placeholder: "Search cards and comments…",
+          autofocus: @search.query.blank?, autocomplete: "off", aria: { label: "Search cards and comments" }, data: { "1p-ignore": "true" } %>
+    <%= form.button "Search", class: "btn", name: nil %>
+  <% end %>
+
+  <% if @search.terms.any? %>
+    <div class="search__results flex flex-column gap-half">
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render partial: "searches/result", collection: @search.results_for(@page.records), locals: { search: @search } %>
+      <% end %>
+    </div>
+
+    <div class="search__blank-slate blank-slate center">No cards match “<%= @search.query %>”</div>
+  <% end %>
+</div>
