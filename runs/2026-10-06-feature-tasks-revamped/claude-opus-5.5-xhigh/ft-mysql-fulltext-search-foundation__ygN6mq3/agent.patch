+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show highlights matched words in titles and in excerpts of comments" do
+    get search_path(q: "broken overflowing")
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title mark", text: "broken"
+    assert_select ".search-result__excerpt mark", text: "overflowing"
+    assert_select ".search-result__excerpt", text: /David commented/
+    assert_select ".search-result a[href=?]", card_path(cards(:layout), anchor: dom_id(comments(:layout_overflowing_david)))
+  end
+
+  test "show highlights matched words in descriptions" do
+    with_current_user(:kevin) { create_card title: "Checkout", description: "<p>The <em>payment</em> step fails</p>" }
+
+    get search_path(q: "payment")
+
+    assert_select ".search-result__excerpt mark", text: "payment"
+    assert_select ".search-result__excerpt", text: /The payment step fails/
+  end
+
+  test "show escapes card content" do
+    with_current_user(:kevin) { create_card title: "<img src=x onerror=alert(1)> alert" }
+
+    get search_path(q: "alert")
+
+    assert_select ".search-result__title mark", text: "alert", count: 2
+    assert_select ".search-result__title img", count: 0
+    assert_includes response.body, "&lt;img src=x onerror="
+  end
+
+  test "show lists the newest cards first" do
+    older, newer = with_current_user(:kevin) do
+      [ create_card(title: "Quarterly report"), create_card(title: "Quarterly planning") ]
+    end
+
+    get search_path(q: "quarterly")
+
+    assert_equal [ newer, older ].collect { dom_id(it, :search_result) }, css_select(".search-result").collect { it["id"] }
+  end
+
+  test "show only includes published cards from boards the user can access" do
+    with_current_user(:kevin) do
+      create_card title: "Confidential memo"
+      create_card title: "Confidential roadmap", board: boards(:private)
+      create_card title: "Confidential draft", status: :drafted
+    end
+
+    get search_path(q: "confidential")
+
+    assert_equal [ "Confidential roadmap", "Confidential memo" ], css_select(".search-result__title").collect(&:text)
+
+    logout_and_sign_in_as :david
+    get search_path(q: "confidential")
+
+    assert_equal [ "Confidential memo" ], css_select(".search-result__title").collect(&:text)
+  end
+
+  test "show without a query" do
+    get search_path
+
+    assert_response :success
+    assert_select "input[name=q][autofocus]"
+    assert_select ".search-result", count: 0
+    assert_select ".search__blank-slate", count: 0
+  end
+
+  test "show without matches" do
+    get search_path(q: "xylophone")
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_select ".search__blank-slate", text: "No cards match “xylophone”"
+  end
+
+  test "show requires authentication" do
+    sign_out
+
+    get search_path(q: "broken")
+
+    assert_response :redirect
+  end
+
+  private
+    def create_card(board: boards(:writebook), status: :published, **attributes)
+      board.cards.create!(status: status, **attributes)
+    end
+end
diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..b978915
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "search_highlight marks every term regardless of case and escapes everything else" do
+    search = Search.new(users(:kevin), "fizz BUZZ")
+
+    assert_equal "<mark>Fizz</mark> &amp; <mark>buzz</mark> &lt;script&gt;", search_highlight("Fizz & buzz <script>", search)
+  end
+
+  test "search_highlight prefers the longest of overlapping terms" do
+    search = Search.new(users(:kevin), "log login")
+
+    assert_equal "<mark>login</mark> and <mark>log</mark>", search_highlight("login and log", search)
+  end
+
+  test "search_highlight never marks inside escaped characters" do
+    search = Search.new(users(:kevin), "amp")
+
+    assert_equal "R&amp;D", search_highlight("R&D", search)
+  end
+
+  test "search_highlight with nothing to mark" do
+    assert_equal "", search_highlight(nil, Search.new(users(:kevin), "fizz"))
+    assert_equal "Fizz", search_highlight("Fizz", Search.new(users(:kevin), ""))
+  end
+
+  test "search_excerpt shows the words around the first match" do
+    search = Search.new(users(:kevin), "needle")
+    text = [ *[ "hay" ] * 30, "needle", *[ "straw" ] * 30 ].join(" ")
+
+    assert_equal "...hay hay <mark>needle</mark> straw straw...", search_excerpt(text, search, radius: 2)
+  end
+
+  test "search_excerpt shows the start of the text when nothing matches" do
+    search = Search.new(users(:kevin), "needle")
+
+    assert_equal "one two three four...", search_excerpt("one two three four five six", search, radius: 2)
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..ba734ef
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "finds cards by title, description, or the body of any comment, newest first" do
+    titled = create_card title: "Login page is slow"
+    described = create_card title: "Performance", description: "The login form takes ages"
+    commented = create_card title: "Feedback"
+    commented.comments.create!(body: "Customers keep complaining about login")
+
+    assert_equal [ commented, described, titled ], search("login")
+  end
+
+  test "matching is case-insensitive" do
+    card = create_card title: "Login page is slow"
+
+    assert_equal [ card ], search("LOGIN")
+  end
+
+  test "every term must appear somewhere on the card" do
+    card = create_card title: "Login page is slow"
+    card.comments.create!(body: "Only on Safari")
+
+    assert_equal [ card ], search("login safari")
+    assert_empty search("login firefox")
+  end
+
+  test "only finds cards on boards the user currently has access to" do
+    card = create_card title: "Secret roadmap", board: boards(:private)
+
+    assert_equal [ card ], search("roadmap", user: users(:kevin))
+    assert_empty search("roadmap", user: users(:david))
+
+    boards(:private).accesses.revoke_from users(:kevin)
+    assert_empty search("roadmap", user: users(:kevin))
+  end
+
+  test "cards moved to a board the user can't access stop turning up" do
+    card = create_card title: "Secret roadmap"
+    card.comments.create!(body: "Launch plans")
+    assert_equal [ card ], search("launch", user: users(:david))
+
+    card.move_to boards(:private)
+    assert_empty search("launch", user: users(:david))
+  end
+
+  test "never finds cards from other accounts" do
+    assert_empty search("radio", user: users(:kevin))
+    assert_equal [ cards(:radio) ], search("radio", user: users(:mike))
+  end
+
+  test "never finds draft cards or their comments" do
+    create_card title: "Unannounced feature", description: "Secret sauce", status: :drafted
+
+    card = create_card title: "Was published"
+    card.comments.create!(body: "Keep this quiet")
+    card.update_column :status, "drafted"
+
+    assert_empty search("unannounced")
+    assert_empty search("sauce")
+    assert_empty search("quiet")
+    assert_empty search("unfinished", user: users(:mike))
+  end
+
+  test "drafts that get published turn up" do
+    card = create_card title: "Unannounced feature", status: :drafted
+    assert_empty search("unannounced")
+
+    card.publish
+    assert_equal [ card ], search("unannounced")
+  end
+
+  test "matches the text of rich content, not its markup" do
+    mention = ActionText::Attachment.from_attachable(users(:david)).to_html
+    card = create_card title: "Formatting", description: "<p>Use <strong>bold</strong> for R&amp;D when a&lt;b</p>#{mention}"
+
+    assert_equal [ card ], search("bold")
+    assert_equal [ card ], search("R&D")
+    assert_equal [ card ], search("a<b")
+    assert_empty search("strong")
+    assert_empty search("formatting strong")
+    assert_empty search("attachment")
+  end
+
+  test "wildcard characters are matched literally" do
+    card = create_card title: "Discount 50% off"
+
+    assert_equal [ card ], Search.new(users(:kevin), "%").cards
+    assert_empty Search.new(users(:kevin), "5_").cards
+  end
+
+  test "a blank query finds nothing" do
+    assert_empty Search.new(users(:kevin), "   ").cards
+  end
+
+  test "repeated terms are ignored regardless of case" do
+    assert_equal %w[ login safari ], Search.new(users(:kevin), "  login LOGIN  safari ").terms
+  end
+
+  test "terms are capped" do
+    assert_equal Search::MAX_TERMS, Search.new(users(:kevin), (1..50).to_a.join(" ")).terms.size
+  end
+
+  test "results excerpt the description, or else the newest matching comment" do
+    card = create_card title: "Release", description: "Ship it on Friday"
+    card.comments.create!(body: "Friday works for me", created_at: 1.hour.ago)
+    newest = card.comments.create!(body: "Friday is fine")
+    card.comments.create!(body: "Unrelated")
+
+    result = results("friday").sole
+    assert_nil result.comment
+    assert_equal "Ship it on Friday", result.excerpt
+
+    card.update! description: "Ship it soon"
+
+    result = results("friday").sole
+    assert_equal newest, result.comment
+    assert_equal "Friday is fine", result.excerpt
+  end
+
+  private
+    def create_card(board: boards(:writebook), status: :published, **attributes)
+      board.cards.create!(status: status, **attributes)
+    end
+
+    def search(query, user: users(:kevin))
+      results(query, user: user).collect(&:card)
+    end
+
+    def results(query, user: users(:kevin))
+      search = Search.new(user, query)
+      search.results_for(search.cards)
+    end
+end
