diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..0b81173
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,43 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+// Translations come from the "js" scope of config/locales, rendered into the
+// "i18n" meta tag for the locale of the current page.
+//
+//   t("local_time.days_ago", { count: 3 })
+//
+// A hash with "one" and "other" keys is pluralized with the "count" interpolation.
+export function t(key, interpolations = {}) {
+  let value = key.split(".").reduce((scope, part) => scope?.[part], translations())
+
+  if (value && typeof value === "object" && "count" in interpolations) {
+    value = (interpolations.count === 1 && "one" in value) ? value.one : value.other
+  }
+
+  if (typeof value !== "string") return key
+
+  return value.replace(/%\{(\w+)\}/g, (match, name) => name in interpolations ? interpolations[name] : match)
+}
+
+// The locale to use with Intl formatters, like "en-US" or "ja-JP".
+export function intlLocale() {
+  return translations().intl_locale || "en-US"
+}
+
+let cachedSource
+let cachedTranslations = {}
+
+function translations() {
+  const source = getMetaContent("i18n")
+
+  if (source !== cachedSource) {
+    cachedSource = source
+
+    try {
+      cachedTranslations = JSON.parse(source || "{}")
+    } catch {
+      cachedTranslations = {}
+    }
+  }
+
+  return cachedTranslations
+}
