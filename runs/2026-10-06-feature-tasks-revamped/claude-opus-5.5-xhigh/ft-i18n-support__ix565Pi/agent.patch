--- /dev/null
+++ b/config/locales/rails.ja.rb
@@ -0,0 +1,11 @@
+# Ordinals for Japanese, like ActiveSupport's for English: 2.ordinalize # => "2番目"
+{
+  ja: {
+    number: {
+      nth: {
+        ordinals: ->(_key, _options) { "番目" },
+        ordinalized: ->(_key, options) { "#{options[:number]}番目" }
+      }
+    }
+  }
+}
