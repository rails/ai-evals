new file mode 100644
index 0000000..710db24
--- /dev/null
+++ b/app/models/identity/localized.rb
@@ -0,0 +1,19 @@
+module Identity::Localized
+  extend ActiveSupport::Concern
+
+  included do
+    validates :locale, inclusion: { in: ->(_) { I18n.available_locales.map(&:to_s) } }, allow_nil: true
+  end
+
+  def prefer_locale(locale)
+    update!(locale: locale.to_s) unless locale.to_s == self.locale
+  end
+
+  def preferred_locale
+    locale.presence&.to_sym || I18n.default_locale
+  end
+
+  def in_locale(&)
+    I18n.with_locale(preferred_locale, &)
+  end
+end
