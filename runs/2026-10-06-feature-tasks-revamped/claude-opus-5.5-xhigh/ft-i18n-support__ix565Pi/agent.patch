+++ b/test/system/japanese_test.rb
@@ -0,0 +1,24 @@
+require "application_system_test_case"
+
+class JapaneseTest < ApplicationSystemTestCase
+  test "dates and times rendered in the browser follow the chosen locale" do
+    sign_in_as(users(:david))
+
+    visit card_url(cards(:logo), locale: "ja")
+
+    assert_selector "html[lang=ja]"
+    assert_selector ".card__meta-text--added", text: /追加: (今日|昨日|\d+日前)/
+    assert_selector ".comment__permalink-title", text: /(今日|昨日|\d+月\d+日.曜日), \d+:\d+/
+    assert_no_selector ".card__meta-text--added", text: /ago|today|yesterday/i
+  end
+
+  test "English stays English" do
+    sign_in_as(users(:david))
+
+    visit card_url(cards(:logo))
+
+    assert_selector "html[lang=en]"
+    assert_selector ".card__meta-text--added", text: /Added (today|yesterday|\d+ days ago)/i
+    assert_selector ".comment__permalink-title", text: /(today|yesterday|\w+day, \w+ \d+), \d+:\d+ (AM|PM)/i
+  end
+end
