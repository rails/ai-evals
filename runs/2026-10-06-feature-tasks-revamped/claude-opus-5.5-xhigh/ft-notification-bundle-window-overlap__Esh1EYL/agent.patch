@@ -10,8 +21,22 @@ class User::Settings < ApplicationRecord
     end
   end
 
+  # How long a notification email bundle stays open, counting from its first notification.
+  # Falls back to daily for "never" so that a bundle always has a well-defined window.
+  def bundle_aggregation_period
+    BUNDLE_EMAIL_PERIODS.fetch(bundle_email_frequency, BUNDLE_EMAIL_PERIODS["daily"])
+  end
+
+  def bundling_emails?
+    !bundle_email_never? && user.notification_emails_deliverable?
+  end
+
