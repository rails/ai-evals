+require "application_system_test_case"
+
+class NotificationSettingsTest < ApplicationSystemTestCase
+  test "choosing how often to get notification emails" do
+    sign_in_as(users(:david))
+
+    visit notifications_settings_url
+    select "Daily", from: "Email me a bundle of notifications"
+
+    assert_text "Settings updated"
+    assert users(:david).settings.reload.bundle_email_daily?
+    assert_select "Email me a bundle of notifications", selected: "Daily"
+  end
+end
