+<tr>
+  <td>
+    <h1 class="title">You have <%= pluralize @notifications.size, "new notification" %></h1>
+    <p class="subtitle margin-block-end-double">Here’s what you missed in <%= @account.name %>.</p>
+
+    <% @notifications.group_by { it.card.board }.each_with_index do |(board, notifications), index| %>
+      <% if index > 0 %>
+        <hr class="notification__board-separator">
+      <% end %>
+
+      <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+      <% notifications.each do |notification| %>
+        <% payload = notification.payload %>
+
+        <table class="notification">
+          <tr>
+            <td class="avatar__container"><%= mail_avatar_tag notification.creator, size: 40 %></td>
+            <td>
+              <h3 class="card__title"><%= link_to bundled_notification_card_title(notification), payload.url %></h3>
+
+              <p class="notification__details">
+                <% if notification.source_type == "Mention" %>
+                  <mark class="notificaton__mention"><%= payload.title %></mark>
+                <% end %>
+                <%= payload.body %>
+              </p>
+
+              <p class="notification__author">
+                <%= notification.creator.name %> · <%= bundled_notification_time(notification) %>
+                <% if notification.unread_count > 1 %>
+                  · <%= pluralize notification.unread_count, "update" %>
+                <% end %>
+              </p>
+            </td>
+          </tr>
+        </table>
+      <% end %>
+    <% end %>
+
+    <p class="footer">
+      You’re getting this email because you asked for a bundle of your Fizzy notifications <%= bundle_email_frequency_phrase(@user.settings) %>.
+      <%= link_to "Change how often you get these emails", notifications_settings_url %>.
+    </p>
+  </td>
+</tr>
