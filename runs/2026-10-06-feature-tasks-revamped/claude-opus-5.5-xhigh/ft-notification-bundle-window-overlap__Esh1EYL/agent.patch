diff --git a/app/mailers/notification/bundle_mailer.rb b/app/mailers/notification/bundle_mailer.rb
new file mode 100644
index 0000000..8fefe5d
--- /dev/null
+++ b/app/mailers/notification/bundle_mailer.rb
@@ -0,0 +1,19 @@
+class Notification::BundleMailer < ApplicationMailer
+  helper NotificationBundlesHelper
+
+  def notification(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.preloaded.order(updated_at: :desc).to_a
+
+    if @notifications.any?
+      mail to: @user.identity.email_address, subject: subject_for(@notifications)
+    end
+  end
+
+  private
+    def subject_for(notifications)
+      "#{notifications.size} new #{"notification".pluralize(notifications.size)} in #{@account.name}"
+    end
+end
