index 0000000..77717dd
--- /dev/null
+++ b/app/helpers/notification_bundles_helper.rb
@@ -0,0 +1,30 @@
+module NotificationBundlesHelper
+  BUNDLE_EMAIL_FREQUENCY_LABELS = {
+    "never" => "Never",
+    "every_few_hours" => "Every 4 hours",
+    "daily" => "Daily",
+    "weekly" => "Weekly"
+  }.freeze
+
+  BUNDLE_EMAIL_FREQUENCY_PHRASES = {
+    "every_few_hours" => "every 4 hours",
+    "daily" => "once a day",
+    "weekly" => "once a week"
+  }.freeze
+
+  def bundle_email_frequency_options
+    User::Settings.bundle_email_frequencies.keys.map { |frequency| [ BUNDLE_EMAIL_FREQUENCY_LABELS.fetch(frequency), frequency ] }
+  end
+
+  def bundle_email_frequency_phrase(settings)
+    BUNDLE_EMAIL_FREQUENCY_PHRASES[settings.bundle_email_frequency]
+  end
+
+  def bundled_notification_card_title(notification)
+    notification.card.title.presence || "Card #{notification.card.number}"
+  end
+
+  def bundled_notification_time(notification)
+    notification.updated_at.strftime("%b %-d at %-l:%M%P")
+  end
+end
