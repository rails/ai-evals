+<% @page_title = @account.name %>
+<% plan = @account.plan %>
+<% subscription = @account.subscription %>
+<% overridden_limits = @account.overridden_limits %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to "All accounts", saas.admin_accounts_path, class: "btn" %>
+  </div>
+
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Account</h2>
+      </header>
+
+      <dl class="txt-small" style="text-align: left">
+        <dt class="txt-ink-medium">Account ID</dt>
+        <dd>#<%= @account.external_account_id %> (<%= link_to "open", main_app.root_url(script_name: @account.slug) %>)</dd>
+        <dt class="txt-ink-medium">Owner</dt>
+        <dd><%= @account.owner_name || "None" %> <%= @account.owner_email %></dd>
+        <dt class="txt-ink-medium">Created</dt>
+        <dd><%= @account.created_at.to_date.to_fs(:long) %> (<%= time_ago_in_words(@account.created_at) %> ago)</dd>
+        <dt class="txt-ink-medium">Status</dt>
+        <dd><%= @account.cancelled? ? "Cancelled" : "Active" %></dd>
+      </dl>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Billing</h2>
+        <div>On the <strong><%= plan.name %></strong> plan<%= " (comped)" if @account.comped? %>.</div>
+      </header>
+
+      <% if subscription %>
+        <dl class="txt-small" style="text-align: left">
+          <dt class="txt-ink-medium">Subscription</dt>
+          <dd><%= subscription.plan&.name || subscription.plan_key || "No plan" %>, <%= subscription.status || "never started" %></dd>
+          <% if subscription.current_period_end %>
+            <dt class="txt-ink-medium">Current period ends</dt>
+            <dd><%= subscription.current_period_end.to_date.to_fs(:long) %></dd>
+          <% end %>
+          <% if subscription.cancel_at %>
+            <dt class="txt-ink-medium">Cancels</dt>
+            <dd><%= subscription.cancel_at.to_date.to_fs(:long) %></dd>
+          <% end %>
+          <dt class="txt-ink-medium">Stripe customer</dt>
+          <dd><%= link_to subscription.stripe_customer_id, "https://dashboard.stripe.com/customers/#{subscription.stripe_customer_id}", target: "_blank" %></dd>
+        </dl>
+      <% else %>
+        <p class="txt-small txt-ink-medium">Has never subscribed.</p>
+      <% end %>
+
+      <% if @account.comped? %>
+        <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn btn--negative" %>
+      <% else %>
+        <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+      <% end %>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Limits</h2>
+      </header>
+
+      <dl class="txt-small" style="text-align: left">
+        <dt class="txt-ink-medium">Cards</dt>
+        <dd>
+          <%= number_with_delimiter(@account.billed_cards_count) %> of <%= plan.limits_cards? ? number_with_delimiter(plan.card_limit) : "unlimited" %>
+          <% if overridden_limits&.card_count %>
+            (overridden, <%= number_with_delimiter(@account.cards_count) %> actual)
+          <% end %>
+          <%= "• Out of cards" if @account.exceeding_card_limit? %>
+        </dd>
+        <dt class="txt-ink-medium">Storage</dt>
+        <dd>
+          <%= number_to_human_size(@account.billed_bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %>
+          <% if overridden_limits&.bytes_used %>
+            (overridden, <%= number_to_human_size(@account.bytes_used) %> actual)
+          <% end %>
+          <%= "• Out of storage" if @account.exceeding_storage_limit? %>
+        </dd>
+      </dl>
+
+      <%= form_with model: overridden_limits || Account::OverriddenLimits.new, scope: :overridden_limits, url: saas.admin_account_overridden_limits_path(@account), method: :put, class: "flex flex-column gap-half" do |form| %>
+        <div class="flex gap-half align-center">
+          <%= form.label :card_count, "Card count", class: "flex-item-grow txt-small", style: "text-align: left" %>
+          <%= form.number_field :card_count, min: 0, step: 1, class: "input", placeholder: @account.cards_count %>
+        </div>
+
+        <div class="flex gap-half align-center">
+          <%= form.label :bytes_used, "Bytes used", class: "flex-item-grow txt-small", style: "text-align: left" %>
+          <%= form.number_field :bytes_used, min: 0, step: 1, class: "input", placeholder: @account.bytes_used %>
+        </div>
+
+        <%= form.button "Override", class: "btn center", name: nil %>
+      <% end %>
+
+      <% if overridden_limits %>
+        <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn center margin-block-start-half" %>
+      <% end %>
+    </section>
+  </div>
+</section>
