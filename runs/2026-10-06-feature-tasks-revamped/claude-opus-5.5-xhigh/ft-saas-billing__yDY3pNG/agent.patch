+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <%= form_with url: saas.admin_accounts_path, method: :get, class: "flex gap-half margin-block-half" do |form| %>
+      <%= form.search_field :query, value: params[:query], class: "input full-width", placeholder: "Account name, account ID, or email address…", aria: { label: "Search accounts" } %>
+      <%= form.button "Search", class: "btn", name: nil %>
+    <% end %>
+
+    <% if @page.used? %>
+      <ul class="margin-block-half">
+        <% @page.records.each do |account| %>
+          <li class="flex align-start gap-half margin-block-start-half">
+            <div class="flex-item-grow min-width overflow-ellipsis" style="text-align: left">
+              <strong><%= link_to account.name, saas.admin_account_path(account) %></strong>
+              <br>
+              <span class="txt-x-small txt-ink-medium">
+                #<%= account.external_account_id %> •
+                <%= account.plan.name %><%= " (comped)" if account.comped? %> •
+                <%= pluralize(number_with_delimiter(account.cards_count), "card") %>
+                <%= "• Cancelled" if account.cancelled? %>
+              </span>
+            </div>
+
+            <div class="txt-small txt-ink-medium" style="text-align: right">
+              <%= time_ago_in_words(account.created_at) %> ago
+            </div>
+          </li>
+        <% end %>
+      </ul>
+    <% else %>
+      <p class="txt-ink-medium">No accounts found.</p>
+    <% end %>
+
+    <% unless @page.last? %>
+      <%= link_to "Next page", saas.admin_accounts_path(page: @page.next_param, query: params[:query].presence), class: "btn" %>
+    <% end %>
+  </div>
+</section>
diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
