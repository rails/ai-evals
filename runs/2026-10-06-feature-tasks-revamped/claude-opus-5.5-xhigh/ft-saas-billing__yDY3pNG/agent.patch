+module BillingHelper
+  def plan_allowances(plan)
+    cards = plan.limits_cards? ? pluralize(number_with_delimiter(plan.card_limit), "card") : "unlimited cards"
+    "#{cards} and #{number_to_human_size(plan.storage_limit)} of storage"
+  end
+
+  def plan_price(plan)
+    plan.free? ? "free" : "$#{plan.price}/month"
+  end
+
+  def upgrade_suggested_for(account)
+    account.plan.upgrades.find { |plan| plan.storage_limit > account.billed_bytes_used } || account.plan.upgrades.last
+  end
+end
