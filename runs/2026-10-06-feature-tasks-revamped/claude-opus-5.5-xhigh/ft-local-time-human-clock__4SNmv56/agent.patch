diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..40c79d6
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,97 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTimeToParts, formatLocalTimeTitle } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+// Fills in the <time> elements from TimeHelper#local_datetime_tag, in the viewer's
+// own timezone. Each target name is a style; see local_time_helpers.js.
+export default class extends Controller {
+  static targets = [ "time", "date", "shortdate", "datetime", "day", "ago", "indays", "timeordate" ]
+
+  #timer
+
+  connect() {
+    this.#timer = setInterval(() => this.#refreshRelativeTimes(), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  // Morphing resets a <time> to the server's empty one without reconnecting it
+  refreshTarget({ currentTarget }) {
+    this.#render(currentTarget)
+  }
+
+  timeTargetConnected(target) {
+    this.#render(target)
+  }
+
+  dateTargetConnected(target) {
+    this.#render(target)
+  }
+
+  shortdateTargetConnected(target) {
+    this.#render(target)
+  }
+
+  datetimeTargetConnected(target) {
+    this.#render(target)
+  }
+
+  dayTargetConnected(target) {
+    this.#render(target)
+  }
+
+  agoTargetConnected(target) {
+    this.#render(target)
+  }
+
+  indaysTargetConnected(target) {
+    this.#render(target)
+  }
+
+  timeordateTargetConnected(target) {
+    this.#render(target)
+  }
+
+  #refreshRelativeTimes() {
+    [ ...this.agoTargets, ...this.indaysTargets, ...this.timeordateTargets ].forEach(target => this.#render(target))
+  }
+
+  #render(target) {
+    const datetime = target.getAttribute("datetime")
+    const parts = formatLocalTimeToParts(datetime, target.getAttribute(`data-${this.identifier}-target`))
+
+    if (parts) {
+      this.#renderParts(target, parts)
+      this.#renderTitle(target, formatLocalTimeTitle(datetime))
+    }
+  }
+
+  // Only touch the DOM on changes, as relative times re-render every minute
+  #renderParts(target, parts) {
+    const text = parts.map(part => part.value).join("")
+
+    if (target.textContent !== text) {
+      target.replaceChildren(...parts.map(part => this.#partNode(part)))
+    }
+  }
+
+  #renderTitle(target, title) {
+    if (target.title !== title) {
+      target.title = title
+    }
+  }
+
+  #partNode({ type, value }) {
+    if (type === "value") {
+      const span = document.createElement("span")
+      span.className = "local-time-value"
+      span.textContent = value
+      return span
+    } else {
+      return document.createTextNode(value)
+    }
+  }
+}
