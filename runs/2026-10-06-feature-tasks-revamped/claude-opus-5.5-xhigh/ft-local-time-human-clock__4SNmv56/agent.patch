diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..bdfc375 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,32 @@
 module TimeHelper
+  # Renders an empty <time> that the browser fills in, in the viewer's own timezone
+  # (see local_time_controller.js). Keeping both the timezone and the current time
+  # out of the HTML means it reads right for everyone and can be cached and shared.
+  #
+  # Styles:
+  #
+  #   :time        1:42 PM
+  #   :date        Sep 12, 2025
+  #   :shortdate   Sep 12 (Sep 12, 2024 when it's not this year)
+  #   :datetime    9/12/25, 1:42 PM
+  #   :day         Friday, September 12
+  #   :ago         just now, 5 minutes ago, yesterday, 5 days ago, 1 month ago…
+  #   :indays      today, tomorrow, in 3 days
+  #   :timeordate  1:42 PM, yesterday, 5 days ago, Sep 12
+  #
+  # Pass a Date rather than a time for calendar days the server has already settled
+  # on, like the days in the activity timeline, so no timezone can shift them.
+  def local_datetime_tag(datetime, style: :time, data: {}, **attributes)
+    tag.time **attributes, datetime: local_datetime_attribute(datetime),
+      data: { local_time_target: style, action: "turbo:morph-element->local-time#refreshTarget", **data }
+  end
+
+  private
+    def local_datetime_attribute(datetime)
+      if datetime.acts_like?(:time)
+        datetime.utc.iso8601
+      else
+        datetime.to_date.iso8601
+      end
+    end
 end
