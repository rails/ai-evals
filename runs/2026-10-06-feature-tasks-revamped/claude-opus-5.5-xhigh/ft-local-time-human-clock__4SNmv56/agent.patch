diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..8ff64ee
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_datetime_tag leaves the time for the browser to render" do
+    tag = local_datetime_tag Time.utc(2025, 9, 12, 13, 42), style: :timeordate
+
+    assert_dom_equal <<~HTML.squish, tag
+      <time datetime="2025-09-12T13:42:00Z" data-local-time-target="timeordate"
+        data-action="turbo:morph-element->local-time#refreshTarget"></time>
+    HTML
+  end
+
+  test "local_datetime_tag renders the same moment whatever the server's timezone" do
+    tokyo = Time.use_zone("Asia/Tokyo") { local_datetime_tag Time.zone.local(2025, 9, 12, 22, 42) }
+    new_york = Time.use_zone("America/New_York") { local_datetime_tag Time.zone.local(2025, 9, 12, 9, 42) }
+
+    assert_equal tokyo, new_york
+    assert_includes tokyo, %(datetime="2025-09-12T13:42:00Z")
+  end
+
+  test "local_datetime_tag renders dates as calendar days" do
+    assert_includes local_datetime_tag(Date.new(2025, 9, 15), style: :day), %(datetime="2025-09-15")
+  end
+
+  test "local_datetime_tag defaults to the time style" do
+    assert_includes local_datetime_tag(Time.current), %(data-local-time-target="time")
+  end
+
+  test "local_datetime_tag accepts other attributes and data" do
+    tag = local_datetime_tag Time.utc(2025, 9, 12), style: :date, class: "stamp", data: { bridge__stamp_target: "date" }
+
+    assert_dom_equal <<~HTML.squish, tag
+      <time class="stamp" datetime="2025-09-12T00:00:00Z" data-local-time-target="date"
+        data-action="turbo:morph-element->local-time#refreshTarget" data-bridge--stamp-target="date"></time>
+    HTML
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..3fb54aa
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,169 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  # Wednesday, September 17, 2025 at 3:42 PM in Los Angeles
+  NOW = Time.utc(2025, 9, 17, 22, 42)
+
+  setup do
+    @card = cards(:logo)
+
+    comments(:logo_agreement_kevin).update_columns(created_at: NOW - 2.hours)      # 1:42 PM
+    comments(:logo_agreement_jz).update_columns(created_at: NOW - 17.hours)        # 10:42 PM, Tuesday
+    comments(:logo_3).update_columns(created_at: NOW - 5.days)
+    comments(:logo_1).update_columns(created_at: Time.utc(2025, 9, 7, 18), creator_id: users(:david).id)
+    comments(:logo_5).update_columns(created_at: Time.utc(2025, 9, 7, 19))
+  end
+
+  teardown do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+    page.driver.browser.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: @clock_script) if @clock_script
+  end
+
+  test "comments read in the viewer's timezone, relative to their day" do
+    browse_from "America/Los_Angeles"
+    visit card_url(@card)
+
+    assert_comment_time :logo_agreement_kevin, "1:42 PM"
+    assert_comment_time :logo_agreement_jz, "yesterday"
+    assert_comment_time :logo_3, "5 days ago"
+    assert_comment_time :logo_1, "Sep 7"
+  end
+
+  test "the same page reads differently on the other side of the world" do
+    browse_from "Asia/Tokyo"
+    visit card_url(@card)
+
+    assert_comment_time :logo_agreement_kevin, "5:42 AM"
+    assert_comment_time :logo_agreement_jz, "yesterday"
+    assert_equal "Thursday, September 18, 2025 at 5:42 AM", comment_time(:logo_agreement_kevin)[:title]
+  end
+
+  test "auto-closing reads in days" do
+    browse_from "America/Los_Angeles"
+
+    @card.update_columns(last_active_at: Time.utc(2025, 9, 18, 9) - @card.auto_postpone_period) # 2 AM tomorrow
+    visit card_url(@card)
+    assert_selector "##{dom_id(@card, :closure_notice)}", text: "Moves to “Not Now” tomorrow if there’s no activity."
+
+    @card.update_columns(last_active_at: Time.utc(2025, 9, 20, 18) - @card.auto_postpone_period)
+    visit card_url(@card)
+    assert_selector "##{dom_id(@card, :closure_notice)}", text: "Moves to “Not Now” in 3 days if there’s no activity."
+  end
+
+  test "the bubble and the notice agree on the viewer's day" do
+    browse_from "America/Los_Angeles"
+
+    @card.update_columns(last_active_at: Time.utc(2025, 9, 18, 6) - @card.auto_postpone_period) # 11 PM tonight, tomorrow in UTC
+    visit card_url(@card)
+
+    assert_selector "##{dom_id(@card, :closure_notice)}", text: "Moves to “Not Now” today if there’s no activity."
+    within "##{dom_id(@card, :card_container)} ##{dom_id(@card, :bubble)}" do
+      assert_selector "[data-bubble-target=center]", text: "!"
+      assert_selector "[data-bubble-target=bottom]", text: "Today", visible: :all
+    end
+  end
+
+  test "card metadata reads relative to now" do
+    browse_from "America/Los_Angeles"
+    @card.update_columns(created_at: NOW - 3.days, last_active_at: NOW - 5.minutes)
+
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :card_container)} ##{dom_id(@card, :meta)}" do
+      assert_selector ".card__meta-text--added time", text: /\A3 days ago\z/i
+      assert_selector ".card__meta-text--updated time .local-time-value", text: "5"
+      assert_selector ".card__meta-text--updated time", text: /\A5 minutes ago\z/i
+    end
+  end
+
+  test "the shared description reads in the viewer's timezone" do
+    browse_from "Asia/Tokyo"
+    @card.update_columns(created_at: Time.utc(2025, 9, 11, 16), last_active_at: Time.utc(2025, 9, 16, 16)) # Sep 12 and Sep 17 in Tokyo
+
+    visit card_url(@card)
+
+    description = find("[data-bridge--share-target=description]", visible: :all)
+    assert_match /\AAdded Sep 12 by .+\. Updated Sep 17\z/, description["textContent"]
+  end
+
+  test "times survive the page morphing" do
+    browse_from "America/Los_Angeles"
+    visit card_url(@card)
+    assert_comment_time :logo_agreement_kevin, "1:42 PM"
+
+    wait_for_cable_subscriptions
+    Current.user = users(:kevin)
+    @card.update!(title: "Retitled elsewhere")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_selector "h1", text: "Retitled elsewhere", wait: 5
+    assert_comment_time :logo_agreement_kevin, "1:42 PM"
+    assert_equal "Wednesday, September 17, 2025 at 1:42 PM", comment_time(:logo_agreement_kevin)[:title]
+  end
+
+  test "calendar days don't shift west of Greenwich" do
+    browse_from "America/Los_Angeles"
+    visit card_url(@card)
+
+    assert_equal "Monday, September 15", format_in_browser("2025-09-15", "day")
+    assert_equal "Monday, September 15, 2025", evaluate_helper("formatLocalTimeTitle(arguments[0])", "2025-09-15")
+  end
+
+  test "counting days across a DST change" do
+    browse_from "America/Los_Angeles"
+    visit card_url(@card)
+
+    # Clocks fall back on Sunday, November 2, 2025 in Los Angeles
+    assert_equal "in 2 days", format_in_browser("2025-11-03T19:00:00Z", "indays", now: "2025-11-01T19:00:00Z")
+    # From 11:30 PM Saturday (PDT) to 11:30 PM Sunday (PST): 25 hours, but one day
+    assert_equal "yesterday", format_in_browser("2025-11-02T06:30:00Z", "timeordate", now: "2025-11-03T07:30:00Z")
+  end
+
+  private
+    # Emulates a browser in `timezone` whose clock reads NOW (and keeps ticking from there)
+    def browse_from(timezone, now: NOW)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+      @clock_script = page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: <<~JS)["identifier"]
+        (() => {
+          const RealDate = Date
+          const offset = #{(now.to_f * 1000).to_i} - RealDate.now()
+
+          window.Date = class extends RealDate {
+            constructor(...args) { args.length ? super(...args) : super(RealDate.now() + offset) }
+            static now() { return RealDate.now() + offset }
+          }
+        })()
+      JS
+
+      sign_in_as users(:kevin)
+    end
+
+    def assert_comment_time(comment, text)
+      assert_selector "##{dom_id(comments(comment))} .comment__permalink-title time", text: /\A#{Regexp.escape(text)}\z/i
+    end
+
+    def comment_time(comment)
+      find("##{dom_id(comments(comment))} .comment__permalink-title time")
+    end
+
+    def format_in_browser(datetime, style, now: NOW.iso8601)
+      evaluate_helper("formatLocalTime(arguments[0], arguments[1], new Date(arguments[2]))", datetime, style, now)
+    end
+
+    def evaluate_helper(expression, *arguments)
+      page.evaluate_async_script(<<~JS, *arguments).then { it.gsub(/\u202F/, " ") }
+        const done = arguments[arguments.length - 1]
+        import("helpers/local_time_helpers").then(({ formatLocalTime, formatLocalTimeTitle }) => {
+          done((function() { return #{expression} }).apply(null, arguments))
+        })
+      JS
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
