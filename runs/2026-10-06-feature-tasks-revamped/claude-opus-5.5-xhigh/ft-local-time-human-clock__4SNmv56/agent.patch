diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..c98d421
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,140 @@
+import { isCalendarDay, parseDateTime, signedDifferenceInDays } from "helpers/date_helpers"
+
+// Formats the times from TimeHelper#local_datetime_tag, in the browser's timezone.
+// Uses the page's language so the words match the text around them.
+
+const MILLISECONDS_IN_A_MINUTE = 1000 * 60
+const DAYS_IN_A_MONTH = 365 / 12
+
+const locale = document.documentElement.lang || undefined
+
+const formatters = {
+  time: new Intl.DateTimeFormat(locale, { timeStyle: "short" }),
+  date: new Intl.DateTimeFormat(locale, { dateStyle: "medium" }),
+  shortdate: new Intl.DateTimeFormat(locale, { month: "short", day: "numeric" }),
+  shortdateWithYear: new Intl.DateTimeFormat(locale, { month: "short", day: "numeric", year: "numeric" }),
+  datetime: new Intl.DateTimeFormat(locale, { dateStyle: "short", timeStyle: "short" }),
+  day: new Intl.DateTimeFormat(locale, { weekday: "long", month: "long", day: "numeric" }),
+  dayWithYear: new Intl.DateTimeFormat(locale, { weekday: "long", month: "long", day: "numeric", year: "numeric" }),
+  fullDay: new Intl.DateTimeFormat(locale, { dateStyle: "full" }),
+  fullDatetime: new Intl.DateTimeFormat(locale, { dateStyle: "full", timeStyle: "short" }),
+  relative: new Intl.RelativeTimeFormat(locale),
+  relativeDay: new Intl.RelativeTimeFormat(locale, { numeric: "auto" })
+}
+
+const styles = {
+  time: date => [ literal(formatters.time.format(date)) ],
+  date: date => [ literal(formatters.date.format(date)) ],
+  shortdate: (date, now) => [ literal(shortdate(date, now)) ],
+  datetime: date => [ literal(formatters.datetime.format(date)) ],
+  day: (date, now) => [ literal(day(date, now)) ],
+  ago,
+  indays: inDays,
+  timeordate: timeOrDate
+}
+
+export function formatLocalTime(datetime, style, now = new Date()) {
+  return formatLocalTimeToParts(datetime, style, now)?.map(part => part.value).join("")
+}
+
+// Like Intl's formatToParts: "value" parts are the bits worth emphasizing, like the
+// 5 in "5 days ago" or the whole of "yesterday". Returns null for unknown styles or
+// unparseable times.
+export function formatLocalTimeToParts(datetime, style, now = new Date()) {
+  const date = parseDateTime(datetime)
+
+  if (Object.hasOwn(styles, style) && isValid(date)) {
+    return styles[style](date, now)
+  } else {
+    return null
+  }
+}
+
+// The full date and time, for tooltips
+export function formatLocalTimeTitle(datetime) {
+  const date = parseDateTime(datetime)
+
+  if (isValid(date)) {
+    return isCalendarDay(datetime) ? formatters.fullDay.format(date) : formatters.fullDatetime.format(date)
+  } else {
+    return null
+  }
+}
+
+// 1:42 PM, yesterday, 5 days ago, Sep 12
+function timeOrDate(date, now) {
+  const days = signedDifferenceInDays(date, now)
+
+  if (days < 1) {
+    return [ literal(formatters.time.format(date)) ]
+  } else if (days < 7) {
+    return relative(-days, "day")
+  } else {
+    return [ literal(shortdate(date, now)) ]
+  }
+}
+
+// just now, 5 minutes ago, 2 hours ago, yesterday, 5 days ago, 1 week ago, 3 months ago…
+function ago(date, now) {
+  const minutes = Math.floor((now - date) / MILLISECONDS_IN_A_MINUTE)
+  const hours = Math.floor(minutes / 60)
+  const days = signedDifferenceInDays(date, now)
+
+  if (minutes < 1) {
+    return [ value("just now") ]
+  } else if (hours < 1) {
+    return relative(-minutes, "minute")
+  } else if (hours < 24) {
+    return relative(-hours, "hour")
+  } else if (days < 7) {
+    return relative(-days, "day")
+  } else if (days < 30) {
+    return relative(-Math.floor(days / 7), "week")
+  } else if (days < 365) {
+    return relative(-Math.max(Math.floor(days / DAYS_IN_A_MONTH), 1), "month")
+  } else {
+    return relative(-Math.floor(days / 365), "year")
+  }
+}
+
+// today, tomorrow, in 3 days. Anything overdue is still "today".
+function inDays(date, now) {
+  return relative(Math.max(signedDifferenceInDays(now, date), 0), "day")
+}
+
+function shortdate(date, now) {
+  return isSameYear(date, now) ? formatters.shortdate.format(date) : formatters.shortdateWithYear.format(date)
+}
+
+function day(date, now) {
+  return isSameYear(date, now) ? formatters.day.format(date) : formatters.dayWithYear.format(date)
+}
+
+// Only days get words like "yesterday", since we count calendar days. "Last week" or
+// "last month" would suggest calendar weeks and months, which we don't count.
+function relative(quantity, unit) {
+  const formatter = unit === "day" ? formatters.relativeDay : formatters.relative
+  const parts = formatter.formatToParts(quantity, unit)
+
+  if (parts.some(part => part.type !== "literal")) {
+    return parts.map(part => part.type === "literal" ? literal(part.value) : value(part.value))
+  } else {
+    return [ value(parts.map(part => part.value).join("")) ]
+  }
+}
+
+function isSameYear(date, otherDate) {
+  return date.getFullYear() === otherDate.getFullYear()
+}
+
+function isValid(date) {
+  return !isNaN(date)
+}
+
+function literal(text) {
+  return { type: "literal", value: text }
+}
+
+function value(text) {
+  return { type: "value", value: text }
+}
