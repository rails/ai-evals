diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..ff7beba
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,249 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_includes activity_ids, events(:layout_assignment_jz).id
+    assert_includes activity_ids, events(:layout_commented).id
+  end
+
+  test "index as JSON returns newest activity first" do
+    get activities_path, as: :json
+
+    timestamps = @response.parsed_body.map { Time.iso8601(it["created_at"]) }
+    assert_equal timestamps.sort.reverse, timestamps
+    assert_equal events(:layout_assignment_jz).id, activity_ids.first
+  end
+
+  test "index as JSON includes event attributes" do
+    event = events(:layout_assignment_jz)
+
+    get activities_path, as: :json
+
+    activity = activity_for(event)
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ], activity.keys
+    assert_equal "card_assigned", activity["action"]
+    assert_equal event.created_at.utc.as_json, activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal card_url(cards(:layout)), activity["url"]
+
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:layout).id, activity.dig("eventable", "id")
+    assert_equal cards(:layout).number, activity.dig("eventable", "number")
+    assert_equal cards(:layout).title, activity.dig("eventable", "title")
+
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal boards(:writebook).name, activity.dig("board", "name")
+
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_equal users(:david).name, activity.dig("creator", "name")
+  end
+
+  test "index as JSON describes events from the perspective of the current user" do
+    get activities_path, as: :json
+
+    assert_match "David will handle", activity_for(events(:logo_assignment_km))["description"]
+    assert_match "David assigned JZ to", activity_for(events(:logo_assignment_jz))["description"]
+  end
+
+  test "index as JSON links comment events to the comment on its card" do
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path, as: :json
+
+    activity = activity_for(events(:layout_commented))
+    assert_equal "comment_created", activity["action"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal comment.body.to_plain_text, activity.dig("eventable", "body", "plain_text")
+    assert_equal comment.card.id, activity.dig("eventable", "card", "id")
+  end
+
+  test "index as JSON includes assignee ids for assignment changes" do
+    with_current_user(:kevin) { cards(:text).toggle_assignment(users(:jz)) }
+    with_current_user(:kevin) { cards(:text).toggle_assignment(users(:jz)) }
+
+    get activities_path, as: :json
+
+    assert_equal({ "assignee_ids" => [ users(:david).id ] }, activity_for(events(:logo_assignment_david))["particulars"])
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, latest_activity("card_assigned")["particulars"])
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, latest_activity("card_unassigned")["particulars"])
+  end
+
+  test "index as JSON includes old and new board for board changes" do
+    with_current_user(:kevin) { cards(:text).move_to(boards(:private)) }
+
+    get activities_path, as: :json
+
+    activity = latest_activity("card_board_changed")
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, activity["particulars"])
+    assert_equal boards(:private).id, activity.dig("board", "id")
+  end
+
+  test "index as JSON includes old and new title for title changes" do
+    with_current_user(:kevin) { cards(:text).update!(title: "The text is way too small") }
+
+    get activities_path, as: :json
+
+    activity = latest_activity("card_title_changed")
+    assert_equal({ "old_title" => "The text is too small", "new_title" => "The text is way too small" }, activity["particulars"])
+    assert_equal cards(:text).id, activity.dig("eventable", "id")
+  end
+
+  test "index as JSON includes the column for triage events" do
+    with_current_user(:kevin) { cards(:buy_domain).triage_into(columns(:writebook_in_progress)) }
+
+    get activities_path, as: :json
+
+    assert_equal({ "column" => "In progress" }, latest_activity("card_triaged")["particulars"])
+  end
+
+  test "index as JSON returns empty strings for missing particulars" do
+    events(:logo_published).update_columns(action: "card_board_changed", particulars: {})
+    events(:layout_published).update_columns(action: "card_title_changed", particulars: { "particulars" => { "new_title" => "Layout is broken" } })
+    events(:text_published).update_columns(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, activity_for(events(:logo_published))["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "Layout is broken" }, activity_for(events(:layout_published))["particulars"])
+    assert_equal({ "column" => "" }, activity_for(events(:text_published))["particulars"])
+  end
+
+  test "index as JSON returns empty particulars for other events" do
+    get activities_path, as: :json
+
+    assert_equal({}, activity_for(events(:logo_published))["particulars"])
+    assert_equal({}, activity_for(events(:shipping_closed))["particulars"])
+    assert_equal({}, activity_for(events(:buy_domain_sent_back_to_triage))["particulars"])
+    assert_equal({}, activity_for(events(:layout_commented))["particulars"])
+  end
+
+  test "index as JSON omits deprecated collection change events" do
+    events(:logo_published).update_columns(action: "card_collection_changed", particulars: { "particulars" => { "old_collection" => "Old", "new_collection" => "New" } })
+
+    get activities_path, as: :json
+
+    assert_not_includes activity_ids, events(:logo_published).id
+    assert_not_includes @response.parsed_body.pluck("action"), "card_collection_changed"
+  end
+
+  test "index as JSON omits events that are not part of the timeline" do
+    events(:logo_published).update_columns(action: "card_resumed")
+
+    get activities_path, as: :json
+
+    assert_not_includes activity_ids, events(:logo_published).id
+  end
+
+  test "index as JSON filtered by creator" do
+    get activities_path(creator_ids: [ users(:kevin).id ]), as: :json
+
+    assert_response :success
+    assert_includes activity_ids, events(:shipping_closed).id
+    assert_equal [ users(:kevin).id ], @response.parsed_body.map { it.dig("creator", "id") }.uniq
+  end
+
+  test "index as JSON filtered by board" do
+    with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret plans", status: "published") }
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+
+    assert_response :success
+    assert_equal [ "Secret plans" ], @response.parsed_body.map { it.dig("eventable", "title") }
+    assert_equal [ boards(:private).id ], @response.parsed_body.map { it.dig("board", "id") }.uniq
+
+    get activities_path(board_ids: [ boards(:writebook).id ]), as: :json
+
+    assert_response :success
+    assert_includes activity_ids, events(:logo_published).id
+    assert_equal [ boards(:writebook).id ], @response.parsed_body.map { it.dig("board", "id") }.uniq
+  end
+
+  test "index as JSON filtered by creator and board" do
+    with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret plans", status: "published") }
+
+    get activities_path(creator_ids: [ users(:david).id ], board_ids: [ boards(:private).id ]), as: :json
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "index as JSON only includes activity from accessible boards" do
+    with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret plans", status: "published") }
+    secret_event = Event.find_by!(action: "card_published", eventable: boards(:private).cards.last)
+
+    get activities_path, as: :json
+    assert_includes activity_ids, secret_event.id
+
+    logout_and_sign_in_as :david
+
+    get activities_path, as: :json
+    assert_response :success
+    assert_not_includes activity_ids, secret_event.id
+    assert_equal [ boards(:writebook).id ], @response.parsed_body.map { it.dig("board", "id") }.uniq
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+    assert_response :success
+    assert_not_includes activity_ids, secret_event.id
+  end
+
+  test "index as JSON is paginated" do
+    with_current_user(:kevin) do
+      20.times do |index|
+        cards(:text).update!(title: "Renamed #{index}")
+        travel 1.second
+      end
+    end
+
+    expected_ids = users(:kevin).activity_for(filter: users(:kevin).filters.new).map(&:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat activity_ids
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "index as JSON with an access token" do
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+    assert_includes activity_ids, events(:logo_published).id
+  end
+
+  private
+    def activity_ids
+      @response.parsed_body.pluck("id")
+    end
+
+    def activity_for(event)
+      @response.parsed_body.find { it["id"] == event.id } or flunk "Expected activity for event #{event.id}"
+    end
+
+    def latest_activity(action)
+      @response.parsed_body.find { it["action"] == action } or flunk "Expected activity for #{action}"
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
