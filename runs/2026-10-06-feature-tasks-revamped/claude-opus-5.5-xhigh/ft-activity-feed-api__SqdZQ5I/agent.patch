+require "test_helper"
+
+class User::TimelinedTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+  end
+
+  test "activity includes timeline events from accessible boards, newest first" do
+    activity = @kevin.activity_for(filter: @kevin.filters.new).to_a
+
+    assert_includes activity, events(:logo_published)
+    assert_includes activity, events(:layout_commented)
+    assert_equal events(:layout_assignment_jz), activity.first
+    assert_equal activity.sort_by(&:created_at).reverse.map(&:created_at), activity.map(&:created_at)
+  end
+
+  test "activity includes title changes but not deprecated collection changes" do
+    events(:logo_published).update_columns(action: "card_title_changed")
+    events(:layout_published).update_columns(action: "card_collection_changed")
+
+    activity = @kevin.activity_for(filter: @kevin.filters.new)
+
+    assert_includes activity, events(:logo_published)
+    assert_not_includes activity, events(:layout_published)
+  end
+
+  test "activity excludes boards the user can't access" do
+    with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret plans", status: "published") }
+    secret_event = boards(:private).events.sole
+
+    assert_includes @kevin.activity_for(filter: @kevin.filters.new), secret_event
+    assert_not_includes users(:david).activity_for(filter: users(:david).filters.new), secret_event
+    assert_not_includes users(:david).activity_for(filter: users(:david).filters.new(board_ids: [ boards(:private).id ])), secret_event
+  end
+
+  test "activity filtered by creators and boards" do
+    with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret plans", status: "published") }
+
+    by_kevin = @kevin.activity_for(filter: @kevin.filters.new(creator_ids: [ @kevin.id ]))
+    assert by_kevin.any?
+    assert by_kevin.all? { it.creator == @kevin }
+
+    on_private = @kevin.activity_for(filter: @kevin.filters.new(board_ids: [ boards(:private).id ]))
+    assert_equal [ boards(:private) ], on_private.map(&:board).uniq
+
+    assert_empty @kevin.activity_for(filter: @kevin.filters.new(creator_ids: [ users(:david).id ], board_ids: [ boards(:private).id ]))
+  end
+end
