diff --git a/app/helpers/events_helper.rb b/app/helpers/events_helper.rb
index acc78da..6a0b1be 100644
--- a/app/helpers/events_helper.rb
+++ b/app/helpers/events_helper.rb
@@ -19,4 +19,24 @@ module EventsHelper
   def events_at_hour_container(column, hour, &block)
     tag.div class: "events__time-block", style: "grid-area: #{25 - hour}/#{column.index}", &block
   end
+
+  def event_particulars(event)
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(event.assignee_ids) }
+    when "card_board_changed"
+      event_particulars_from(event, :old_board, :new_board)
+    when "card_title_changed"
+      event_particulars_from(event, :old_title, :new_title)
+    when "card_triaged"
+      event_particulars_from(event, :column)
+    else
+      {}
+    end
+  end
+
+  private
+    def event_particulars_from(event, *names)
+      names.index_with { |name| event.particulars.to_h.dig("particulars", name.to_s).to_s }
+    end
 end
