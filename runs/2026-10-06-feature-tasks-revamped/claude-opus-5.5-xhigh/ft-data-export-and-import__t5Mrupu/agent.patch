+<% @page_title = "Import an account" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if @import.errors.any? %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <p class="margin-none-block-start">Upload an account export from Fizzy (the .zip file admins can download from Account Settings). You’ll get a new account with everything in it: boards, cards, comments, files and people.</p>
+
+  <%= form_with model: @import, url: account_imports_path, scope: :account_import, class: "flex flex-column gap", data: { controller: "form", turbo: false } do |form| %>
+    <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input", data: { action: "change->form#disableSubmitWhenInvalid" } %>
+
+    <% if @import.errors.any? %>
+      <div class="margin-block-half txt-negative txt-small" style="text-align: left;">
+        <p class="margin-block-none font-weight-bold">We couldn’t start the import:</p>
+        <ul class="margin-block-none">
+          <% @import.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <p class="txt-small margin-none">We’ll email you when the import is done. Big accounts can take a while.</p>
+
+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>Start import</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
diff --git a/app/views/account/imports/show.html.erb b/app/views/account/imports/show.html.erb
