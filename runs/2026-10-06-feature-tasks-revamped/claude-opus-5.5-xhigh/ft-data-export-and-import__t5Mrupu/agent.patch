+class Account::DataTransfer::BoardPublicationRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account)
+    super(account: account, model: Board::Publication)
+  end
+
+  private
+    # Public links are unique across the instance. When the original board is still
+    # published here, the imported one gets a new link.
+    def insert_all(rows)
+      taken_keys = Board::Publication.where(key: rows.pluck("key").compact).where.not(id: rows.pluck("id")).pluck(:key).to_set
+
+      rows.each do |row|
+        if row["key"].blank? || taken_keys.include?(row["key"])
+          row["key"] = Board::Publication.generate_unique_secure_token
+        end
+      end
+
+      super
+    end
+end
