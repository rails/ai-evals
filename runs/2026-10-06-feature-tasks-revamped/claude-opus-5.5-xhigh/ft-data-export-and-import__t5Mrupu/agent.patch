+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+  end
+
+  test "new" do
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :success
+    assert_select "input[type=file][name=?]", "account_import[file]"
+  end
+
+  test "new requires signing in" do
+    sign_out
+
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :redirect
+  end
+
+  test "create starts importing the file into a new account" do
+    untenanted do
+      assert_difference -> { Account.count }, +1 do
+        assert_enqueued_with job: ImportAccountDataJob do
+          post account_imports_path, params: { account_import: { file: export_file } }
+        end
+      end
+    end
+
+    import = Account::Import.last
+    untenanted { assert_redirected_to account_import_path(import) }
+    assert_equal identities(:mike), import.identity
+    assert import.file.attached?
+    assert import.account.users.find_by!(identity: identities(:mike)).owner?
+  end
+
+  test "create rejects files that aren't zips" do
+    untenanted do
+      assert_no_difference -> { Account.count } do
+        post account_imports_path, params: { account_import: { file: fixture_file_upload("avatar.png", "image/png") } }
+      end
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create without a file" do
+    untenanted do
+      assert_no_difference -> { Account.count } do
+        post account_imports_path
+      end
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "importing from start to finish" do
+    untenanted do
+      perform_enqueued_jobs only: ImportAccountDataJob do
+        post account_imports_path, params: { account_import: { file: export_file } }
+      end
+    end
+
+    import = Account::Import.last
+    assert import.reload.completed?
+
+    untenanted do
+      get account_import_path(import)
+    end
+
+    assert_response :success
+    assert_select "a[href=?]", landing_path(script_name: import.account.slug)
+  end
+
+  test "show explains why an import failed" do
+    import = Account::Import.create!(identity: identities(:mike), status: :failed, failure_reason: "The file isn't a Fizzy account export.", file: zip_file, account: accounts("37s"))
+
+    untenanted do
+      get account_import_path(import)
+    end
+
+    assert_response :success
+    assert_select "p", text: "The file isn't a Fizzy account export."
+  end
+
+  test "show for an imported account that was deleted since" do
+    import = Account::Import.create!(identity: identities(:mike), status: :completed, file: zip_file, account: accounts("37s"))
+    import.update!(account: nil)
+
+    untenanted do
+      get account_import_path(import)
+    end
+
+    assert_response :success
+    assert_select "h1", "This account was deleted"
+  end
+
+  test "show is only for whoever started the import" do
+    import = Account::Import.create!(identity: identities(:david), file: zip_file, account: accounts("37s"))
+
+    untenanted do
+      get account_import_path(import)
+    end
+
+    assert_response :not_found
+  end
+
+  private
+    def zip_file
+      io = StringIO.new(String.new(encoding: Encoding::BINARY))
+      ZipFile::Writer.new(io).tap { |zip| zip.add_file("hello.txt", "Hello") }.close
+      { io: StringIO.new(io.string), filename: "export.zip", content_type: "application/zip" }
+    end
+
+    def export_file
+      export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+      export.build
+
+      tempfile = Tempfile.new([ "export", ".zip" ], binmode: true)
+      tempfile.write(export.file.download)
+      tempfile.rewind
+
+      Rack::Test::UploadedFile.new(tempfile.path, "application/zip", true, original_filename: "export.zip")
+    end
+end
