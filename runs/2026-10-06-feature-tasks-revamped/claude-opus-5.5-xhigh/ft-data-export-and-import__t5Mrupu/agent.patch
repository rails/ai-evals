--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -1,6 +1,11 @@
 require "test_helper"
 
 class ZipFileTest < ActiveSupport::TestCase
+  setup do
+    @export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    @large = Random.bytes(3.megabytes + 17)
+  end
+
   test "writer adds files with content" do
     tempfile = Tempfile.new([ "test", ".zip" ])
     tempfile.binmode
@@ -37,4 +42,108 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "docs/guide.txt", "docs/readme.txt" ], writer.glob("docs/*.txt")
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
+
+  test "writer globs reader-style patterns" do
+    writer = ZipFile::Writer.new(StringIO.new)
+    writer.add_file("data/cards/1.json", "{}")
+    writer.add_file("data/cards/2/attachments.json", "{}")
+    writer.close
+
+    assert_equal [ "data/cards/1.json" ], writer.glob("data/cards/*.json")
+  end
+
+  test "create_for streams an archive into storage and attaches it" do
+    create_archive
+
+    assert @export.file.attached?
+    assert_equal "archive.zip", @export.file.filename.to_s
+    assert_equal @export.file.byte_size, @export.file.download.bytesize
+    assert_equal Digest::MD5.base64digest(@export.file.download), @export.file.checksum
+  end
+
+  test "create_for removes the partial archive when it fails" do
+    assert_no_difference -> { ActiveStorage::Blob.count } do
+      assert_raises(RuntimeError) do
+        ZipFile.create_for(@export.file, filename: "archive.zip") { raise "Boom" }
+      end
+    end
+  end
+
+  test "read_from reads entries back" do
+    create_archive
+
+    ZipFile.read_from(@export.file.blob) do |zip|
+      assert_reads_archive zip
+    end
+  end
+
+  test "reads archives through ranged requests" do
+    create_archive
+
+    zip = ZipFile::Reader.new(ZipFile::BlobIO.new(@export.file.blob))
+    assert_reads_archive zip
+  end
+
+  test "detects damaged entries" do
+    data = archive_data
+    offset = data.index(@large.byteslice(0, 64))
+    data[offset + 1000, 4] = "XXXX"
+
+    zip = ZipFile::Reader.new(StringIO.new(data))
+    assert_raises(ZipFile::Reader::CorruptEntry) { zip.read("storage/large") }
+    assert_equal({ "number" => 1 }, JSON.parse(zip.read("data/cards/1.json")))
+  end
+
+  test "rejects files that aren't archives" do
+    assert_raises(ZipFile::Reader::InvalidArchive) { ZipFile::Reader.new(StringIO.new("Hello" * 100)) }
+    assert_raises(ZipFile::Reader::InvalidArchive) { ZipFile::Reader.new(StringIO.new(archive_data.byteslice(0, 1000))) }
+  end
+
+  test "refuses to read entries over a size limit" do
+    zip = ZipFile::Reader.new(StringIO.new(archive_data))
+
+    assert_raises(ZipFile::Reader::EntryTooLarge) { zip.read("storage/large", limit: 1.megabyte) }
+    assert_raises(ZipFile::Reader::EntryNotFound) { zip.read("missing.json") }
+  end
+
+  private
+    def create_archive
+      ZipFile.create_for(@export.file, filename: "archive.zip") do |zip|
+        write_entries zip
+      end
+    end
+
+    def archive_data
+      StringIO.new(String.new(encoding: Encoding::BINARY)).tap do |io|
+        zip = ZipFile::Writer.new(io)
+        write_entries zip
+        zip.close
+      end.string
+    end
+
+    def write_entries(zip)
+      zip.add_file "data/cards/1.json", { number: 1 }.to_json
+      zip.add_file "data/cards/2.json", { number: 2 }.to_json
+      zip.add_file "data/comments/3.json", "{}"
+      zip.add_file "empty.txt", ""
+      zip.add_file("storage/large", compress: false) { |file| file.write(@large) }
+    end
+
+    def assert_reads_archive(zip)
+      assert_equal [ "data/cards/1.json", "data/cards/2.json" ], zip.glob("data/cards/*.json")
+      assert_equal 3, zip.glob("data/*/*.json").size
+      assert_equal({ "number" => 2 }, JSON.parse(zip.read("data/cards/2.json")))
+      assert_equal "", zip.read("empty.txt")
+      assert_equal @large.bytesize, zip.size_of("storage/large")
+      assert zip.exists?("storage/large")
+      assert_not zip.exists?("storage/missing")
+
+      streamed = String.new(encoding: Encoding::BINARY)
+      zip.open("storage/large") do |file|
+        while chunk = file.read(16.kilobytes)
+          streamed << chunk
+        end
+      end
+      assert_equal @large, streamed
+    end
 end
