@@ -0,0 +1,86 @@
+# A downloadable .zip of account data, built in the background. Its owner gets an
+# email with a link once it's ready, and the download expires a day later.
+class Export < ApplicationRecord
+  EXPIRATION = 1.day
+  ABANDONED_AFTER = 1.week
+  DAILY_LIMIT = 10
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  scope :recent, -> { where(created_at: EXPIRATION.ago..) }
+  # Downloads expire a day after they're ready. Exports that never got ready (failed, or
+  # stuck) are cleaned up much later, so that building huge exports can take long.
+  scope :expired, -> { where(completed_at: ...EXPIRATION.ago).or(where(completed_at: nil, created_at: ...ABANDONED_AFTER.ago)) }
+  scope :in_progress, -> { where(status: %i[ pending processing ]) }
+
+  class << self
+    def cleanup
+      expired.find_each(&:destroy)
+    end
+  end
+
+  def build_later
+    DataExportJob.perform_later(self)
+  end
+
+  def build
+    unless completed?
+      processing!
+
+      Current.with_account(account) do
+        ZipFile.create_for(file, filename: filename) do |zip|
+          populate_zip(zip)
+        end
+
+        update!(status: :completed, completed_at: Time.current)
+        ExportMailer.completed(self).deliver_later
+      end
+    end
+  rescue => error
+    failed!
+    raise error
+  end
+
+  def in_progress?
+    pending? || processing?
+  end
+
+  def expires_at
+    completed_at + EXPIRATION if completed_at
+  end
+
+  def expired?
+    expires_at.present? && expires_at.past?
+  end
+
+  def downloadable?
+    completed? && file.attached? && !expired?
+  end
+
+  # Only whoever requested an export can download it, and only until it expires.
+  def accessible_to?(user)
+    user.present? && user == self.user && !expired?
+  end
+
+  def publicly_accessible?
+    false
+  end
+
+  private
+    def filename
+      [ "fizzy", *filename_parts, created_at.utc.strftime("%Y-%m-%d") ].join("-") + ".zip"
+    end
+
+    def filename_parts
+      [ account.name.parameterize.presence || "account" ]
+    end
+
+    def populate_zip(zip)
+      raise NotImplementedError, "Subclasses must implement populate_zip"
+    end
+end
