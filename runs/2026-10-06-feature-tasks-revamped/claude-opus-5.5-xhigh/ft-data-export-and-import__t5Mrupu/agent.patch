+require "test_helper"
+
+class Account::DataTransfer::ManifestTest < ActiveSupport::TestCase
+  # Account data that's deliberately left out of exports, and why.
+  NOT_EXPORTED = {
+    "Account::Cancellation" => "imported accounts start active",
+    "Account::Import" => "imports aren't account data",
+    "Account::JoinCode" => "imported accounts get their own invite link",
+    "Export" => "exports aren't account data",
+    "Push::Subscription" => "tied to devices",
+    "Search::Query" => "recent searches are ephemeral",
+    "Search::Record" => "rebuilt on import",
+    "Storage::Entry" => "storage usage is recalculated on import"
+  }
+
+  test "every model with account data is exported, or deliberately left out" do
+    Rails.application.eager_load!
+
+    exported = []
+    Account::DataTransfer::Manifest.new(accounts("37s")).each_record_set { |record_set| exported << record_set.model.base_class.name }
+
+    models_with_account_data = ActiveRecord::Base.descendants
+      .reject(&:abstract_class?)
+      .select { |model| model.table_exists? && model.column_names.include?("account_id") }
+      .map { |model| model.base_class.name }.uniq
+
+    assert_empty models_with_account_data - exported - NOT_EXPORTED.keys,
+      "Add these models to Account::DataTransfer::Manifest so they're exported and imported"
+  end
+
+  test "record sets have unique names" do
+    names = []
+    Account::DataTransfer::Manifest.new(accounts("37s")).each_record_set { |record_set| names << record_set.name }
+
+    assert_equal names.uniq, names
+  end
+
+  test "each_record_set starts from the named record set, or from the beginning if it's unknown" do
+    manifest = Account::DataTransfer::Manifest.new(accounts("37s"))
+
+    names = []
+    manifest.each_record_set(start: "comments") { |record_set| names << record_set.name }
+    assert_equal "comments", names.first
+    assert_equal "storage", names.last
+
+    all_names = []
+    manifest.each_record_set(start: "unknown") { |record_set| all_names << record_set.name }
+    assert_equal "accounts", all_names.first
+  end
+end
diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
new file mode 100644
index 0000000..0bdbc5d
--- /dev/null
+++ b/test/models/account/export_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+  end
+
+  test "exports every record in the account" do
+    read_export do |zip|
+      manifest = JSON.parse(zip.read("manifest.json"))
+      assert_equal "fizzy-account", manifest["format"]
+      assert_equal @account.name, manifest.dig("account", "name")
+
+      assert_equal @account.id, JSON.parse(zip.read("data/account.json"))["id"]
+      assert_equal @account.cards.ids.sort, ids_in(zip, "cards")
+      assert_equal @account.users.ids.sort, ids_in(zip, "users")
+      assert_equal Comment.where(account: @account).ids.sort, ids_in(zip, "comments")
+      assert_equal Event.where(account: @account).ids.sort, ids_in(zip, "events")
+
+      user = JSON.parse(zip.read("data/users/#{users(:david).id}.json"))
+      assert_equal "david@37signals.com", user["email_address"]
+    end
+  end
+
+  test "doesn't export data from other accounts" do
+    read_export do |zip|
+      exported_ids = zip.glob("data/*/*.json").map { |path| File.basename(path, ".json") }
+
+      assert_not_includes exported_ids, users(:mike).id
+      assert_not_includes exported_ids, cards(:radio).id
+    end
+  end
+
+  test "exports stored files" do
+    read_export do |zip|
+      blob = cards(:logo).image.blob
+
+      assert_equal file_fixture("moon.jpg").binread, zip.read("storage/#{blob.key}")
+      assert_equal blob.id, JSON.parse(zip.read("data/active_storage_blobs/#{blob.id}.json"))["id"]
+    end
+  end
+
+  test "doesn't export other exports" do
+    previous = Account::Export.create!(account: @account, user: users(:kevin))
+    previous.build
+
+    read_export do |zip|
+      assert_not zip.exists?("storage/#{previous.file.key}")
+      assert_not zip.exists?("data/active_storage_blobs/#{previous.file.blob.id}.json")
+      assert_not zip.exists?("data/active_storage_attachments/#{previous.file.attachment.id}.json")
+    end
+  end
+
+  test "includes a readable copy of each card with its comments" do
+    read_export do |zip|
+      card = JSON.parse(zip.read("cards/#{cards(:logo).number}.json"))
+
+      assert_equal cards(:logo).title, card["title"]
+      assert_equal "Writebook", card["board"]
+      assert_includes card["comments"].map { |comment| comment.dig("body", "plain_text") }, "I agree."
+      assert_equal "storage/#{cards(:logo).image.blob.key}", card.dig("image", "path")
+      assert_equal cards(:logo).created_at.as_json, card["created_at"]
+    end
+  end
+
+  test "exported timestamps keep their full precision" do
+    cards(:logo).update_column :last_active_at, Time.utc(2025, 1, 2, 3, 4, 5.123456r)
+
+    read_export do |zip|
+      card = JSON.parse(zip.read("data/cards/#{cards(:logo).id}.json"))
+      assert_equal "2025-01-02T03:04:05.123456Z", card["last_active_at"]
+    end
+  end
+
+  test "files missing from storage are skipped" do
+    blob = cards(:logo).image.blob
+    blob.service.delete(blob.key)
+
+    read_export do |zip|
+      assert_not zip.exists?("storage/#{blob.key}")
+      assert zip.exists?("data/active_storage_blobs/#{blob.id}.json")
+    end
+  end
+
+  private
+    def read_export
+      export = Account::Export.create!(account: @account, user: users(:kevin))
+      export.build
+
+      ZipFile.read_from(export.file.blob) { |zip| yield zip }
+    end
+
+    def ids_in(zip, table)
+      zip.glob("data/#{table}/*.json").map { |path| File.basename(path, ".json") }.sort
+    end
+end
