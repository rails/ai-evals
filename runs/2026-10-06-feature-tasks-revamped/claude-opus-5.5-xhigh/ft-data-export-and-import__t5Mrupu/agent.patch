@@ -0,0 +1,37 @@
+<% @page_title = "Import an account" %>
+
+<% if @import.in_progress? %>
+  <% content_for :head do %>
+    <meta http-equiv="refresh" content="10">
+  <% end %>
+<% end %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <% if @import.completed? && @import.account.nil? %>
+    <h1 class="txt-x-large font-weight-black margin-none">This account was deleted</h1>
+    <p class="margin-none-block-start">The account you imported has since been deleted.</p>
+  <% elsif @import.completed? %>
+    <h1 class="txt-x-large font-weight-black margin-none">Your account is ready</h1>
+    <p class="margin-none-block-start">Everything from your export is now in <strong><%= @import.account.name %></strong>.</p>
+
+    <%= link_to landing_path(script_name: @import.account.slug), class: "btn btn--link center" do %>
+      <span>Go to <%= @import.account.name %></span>
+      <%= icon_tag "arrow-right" %>
+    <% end %>
+  <% elsif @import.failed? %>
+    <h1 class="txt-x-large font-weight-black margin-none">The import didn’t work</h1>
+    <p class="margin-none-block-start"><%= @import.failure_reason %></p>
+    <p class="margin-none-block-start">Nothing was left behind: no account was created, and the file you uploaded has been deleted.</p>
+
+    <%= link_to new_account_import_path, class: "btn center" do %>
+      <span>Try again</span>
+    <% end %>
+  <% else %>
+    <h1 class="txt-x-large font-weight-black margin-none">Importing your account…</h1>
+    <p class="margin-none-block-start">This can take a while for big accounts. We’ll email you at <strong><%= @import.identity.email_address %></strong> when it’s done, so you don’t need to keep this page open.</p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
