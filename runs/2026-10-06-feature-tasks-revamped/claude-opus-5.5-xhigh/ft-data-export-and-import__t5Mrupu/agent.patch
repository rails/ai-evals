+## `POST /:account_slug/users/:user_id/data_exports`
+
+Starts exporting the cards you can see as a .zip file, with their comments and every picture and file attached to them. You can only export your own data.
+
+The export is built in the background, and you get an email with a download link when it's ready. You can start up to 10 exports a day; past that, this returns `429 Too Many Requests`.
+
+__Response:__
+
+Returns `202 Accepted` with the export, and its URL in the `Location` header:
+
+```json
+{
+  "id": "03f5vbfqtxwdkr0zxkvsfrshd",
+  "status": "pending",
+  "created_at": "2025-12-05T19:36:35.401Z",
+  "completed_at": null,
+  "expires_at": null,
+  "download_url": null
+}
+```
+
+## `GET /:account_slug/users/:user_id/data_exports/:export_id`
+
+Returns one of your data exports. Once `completed`, `download_url` points to the .zip file until `expires_at`, a day after it completes. The .zip has one `<number>.json` file per card, with its comments, and a `<number>/` folder with the files attached to it.
+
+__Response:__
+
+```json
+{
+  "id": "03f5vbfqtxwdkr0zxkvsfrshd",
+  "status": "completed",
+  "created_at": "2025-12-05T19:36:35.401Z",
+  "completed_at": "2025-12-05T19:36:41.022Z",
+  "expires_at": "2025-12-06T19:36:41.022Z",
+  "download_url": "http://app.fizzy.localhost:3006/897362094/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsi.../fizzy-37signals-david-2025-12-05.zip?disposition=attachment"
+}
+```
diff --git a/lib/tasks/accounts.rake b/lib/tasks/accounts.rake
new file mode 100644
index 0000000..06c0080
--- /dev/null
+++ b/lib/tasks/accounts.rake
@@ -0,0 +1,17 @@
+namespace :accounts do
+  desc "Import an account export from a file, owned by the given email address. For exports too big to upload through the browser."
+  task :import, [ :path, :email_address ] => :environment do |_task, args|
+    path = args.fetch(:path) { abort "Usage: bin/rails \"accounts:import[path/to/export.zip,owner@example.com]\"" }
+    email_address = args.fetch(:email_address) { abort "Usage: bin/rails \"accounts:import[path/to/export.zip,owner@example.com]\"" }
+
+    identity = Identity.find_or_create_by!(email_address: email_address)
+    import = identity.account_imports.new
+    import.file.attach(io: File.open(path, "rb"), filename: File.basename(path), content_type: "application/zip")
+
+    if import.start
+      puts "Importing #{path} into a new account (import #{import.id}). #{identity.email_address} will get an email when it's done."
+    else
+      abort "Couldn't start the import: #{import.errors.full_messages.to_sentence}"
+    end
+  end
+end
diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..d0f9418
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,161 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admins can export the account" do
+    assert_difference -> { Account::Export.count }, +1 do
+      assert_enqueued_with job: DataExportJob do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    assert_match "We’re preparing your export", flash[:notice]
+
+    export = Account::Export.last
+    assert_equal users(:kevin), export.user
+    assert_equal accounts("37s"), export.account
+    assert export.pending?
+  end
+
+  test "exporting while an export is being prepared doesn't start another one" do
+    Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+
+    assert_redirected_to account_settings_path
+  end
+
+  test "exports are limited per day" do
+    Export::DAILY_LIMIT.times { Account::Export.create!(account: accounts("37s"), user: users(:kevin), status: :completed) }
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :too_many_requests
+  end
+
+  test "members can't export the account" do
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "show offers to download a completed export" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    get account_export_path(export)
+
+    assert_response :success
+    assert_select "a#download-link[href=?]", rails_blob_path(export.file, disposition: "attachment")
+  end
+
+  test "the download works for whoever made the export" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    get rails_blob_path(export.file, disposition: "attachment")
+    assert_response :redirect
+
+    logout_and_sign_in_as :jason
+    get rails_blob_path(export.file, disposition: "attachment")
+    assert_response :forbidden
+  end
+
+  test "the download stops working after a day" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    travel Export::EXPIRATION + 1.minute do
+      get rails_blob_path(export.file, disposition: "attachment")
+    end
+
+    assert_response :forbidden
+  end
+
+  test "show says when an export has expired" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    travel Export::EXPIRATION + 1.minute do
+      get account_export_path(export)
+    end
+
+    assert_response :success
+    assert_select "h2", "Download expired"
+    assert_select "a#download-link", count: 0
+  end
+
+  test "show doesn't reveal other people's exports" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:jason))
+    export.build
+
+    get account_export_path(export)
+
+    assert_response :success
+    assert_select "a#download-link", count: 0
+  end
+
+  test "account settings offer exporting to admins" do
+    get account_settings_path
+    assert_select "form[action=?]", account_exports_path
+
+    logout_and_sign_in_as :david
+    get account_settings_path
+    assert_select "form[action=?]", account_exports_path, count: 0
+  end
+  test "create as JSON" do
+    post account_exports_path, as: :json
+
+    export = Account::Export.last
+    assert_response :accepted
+    assert_equal account_export_url(export), response.location
+    assert_equal export.id, response.parsed_body["id"]
+    assert_equal "pending", response.parsed_body["status"]
+    assert_nil response.parsed_body["download_url"]
+  end
+
+  test "show as JSON includes the download URL once the export is ready" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    get account_export_path(export), as: :json
+
+    assert_response :success
+    assert_equal "completed", response.parsed_body["status"]
+    assert_equal rails_blob_url(export.file, disposition: "attachment"), response.parsed_body["download_url"]
+  end
+
+  test "show as JSON for a missing export" do
+    get account_export_path("missing"), as: :json
+
+    assert_response :not_found
+  end
+  test "exporting with an access token" do
+    sign_out
+    token = identities(:kevin).access_tokens.create!(description: "Backups", permission: "write").token
+
