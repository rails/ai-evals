+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @source = accounts("37s")
+    @importer = identities(:mike)
+
+    @blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    cards(:logo).image.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    cards(:logo).update!(description: <<~HTML)
+      <p>Look at this, #{mention_of(users(:jz))}</p>
+      <action-text-attachment sgid="#{@blob.attachable_sgid}"></action-text-attachment>
+    HTML
+  end
+
+  test "importing an account export creates a new account with everything in it" do
+    import = import_of(export_of(@source))
+    import.process
+    target = import.reload.account
+
+    assert import.completed?
+    assert_not_equal @source, target
+    assert_equal @source.name, target.name
+    assert_equal digest_of(@source), digest_of(target)
+  end
+
+  test "stored files come along" do
+    target = imported_account
+
+    card = target.cards.find_by!(number: cards(:logo).number)
+    assert_equal file_fixture("avatar.png").binread, card.image.download
+
+    embed = card.description.embeds.sole
+    assert_equal file_fixture("moon.jpg").binread, embed.download
+    assert_equal target, embed.blob.account
+    assert_not_equal @blob.key, embed.blob.key
+  end
+
+  test "attachments in rich text point to the imported records" do
+    card = imported_account.cards.find_by!(number: cards(:logo).number)
+
+    attachables = card.description.body.attachables
+    assert_equal [ "JZ" ], attachables.grep(User).map(&:name)
+    assert_equal card.account, attachables.grep(User).sole.account
+    assert_equal card.description.embeds.sole.blob, attachables.grep(ActiveStorage::Blob).sole
+    assert_includes card.description.to_plain_text, "@jz"
+  end
+
+  test "people are linked to their identities and the importer owns the account" do
+    target = imported_account
+
+    assert_equal users(:david).identity, target.users.find_by!(name: "David").identity
+    assert_equal "owner", target.users.find_by!(identity: @importer).role
+    assert target.system_user.system?
+    assert_includes @importer.reload.accounts, target
+    assert_includes identities(:david).reload.accounts, target
+  end
+
+  test "importing someone's own export merges their exported user into theirs" do
+    import = import_of(export_of(@source), identity: identities(:kevin))
+    import.process
+    target = import.reload.account
+
+    kevin = target.users.find_by!(identity: identities(:kevin))
+    assert_equal "Kevin", kevin.name
+    assert kevin.owner?
+    assert_equal 1, target.users.where(name: "Kevin").count
+    assert_equal users(:kevin).assigned_cards.map(&:number).sort, kevin.assigned_cards.map(&:number).sort
+    assert_equal 1, User::Settings.where(user: kevin).count
+  end
+
+  test "IDs are kept when they don't exist in this instance yet" do
+    export = export_of(@source)
+    card_ids = @source.cards.ids.sort
+    Account.find(@source.id).incinerate
+    ActiveStorage::Blob.where(account_id: @source.id).find_each(&:purge) # Including orphaned variants
+
+    import = import_of(export)
+    import.process
+
+    assert import.reload.completed?
+    assert_not import.remap_ids?
+    assert_equal card_ids, import.account.cards.ids.sort
+  end
+
+  test "IDs are remapped when the records still exist in this instance" do
+    import = import_of(export_of(@source))
+    import.process
+
+    assert import.reload.remap_ids?
+    assert_empty import.account.cards.ids & @source.cards.ids
+  end
+
+  test "imported records are searchable and card numbers continue after the imported ones" do
+    target = imported_account
+
+    searchable = target.cards.published.count + Comment.where(account: target).joins(:card).merge(Card.published).count
+    assert_equal searchable, Search::Record.for(target.id).where(account_id: target.id).count
+
+    Current.with_account(target) do
+      card = target.boards.first.cards.create!(creator: target.system_user, title: "New")
+      assert_equal target.cards.maximum(:number), card.number
+      assert_operator card.number, :>, @source.cards.maximum(:number)
+    end
+  end
+
+  test "saved filters keep their boards, tags and people" do
+    filter = users(:kevin).filters.remember(board_ids: [ boards(:writebook).id ], tag_ids: [ tags(:web).id ], assignee_ids: [ users(:jz).id ], indexed_by: "closed")
+    target = imported_account
+
+    imported = target.users.find_by!(name: "Kevin").filters.find_by!(params_digest: Filter.digest_params(
+      board_ids: [ target.boards.find_by!(name: "Writebook").id ],
+      tag_ids: [ target.tags.find_by!(title: "web").id ],
+      assignee_ids: [ target.users.find_by!(name: "JZ").id ],
+      indexed_by: "closed"))
+
+    assert_equal filter.fields, imported.fields
+    assert_equal [ "Writebook" ], imported.boards.map(&:name)
+  end
+
+  test "past notification bundles are never delivered again" do
+    Notification::Bundle.create!(user: users(:kevin), starts_at: 2.days.ago, ends_at: 1.day.ago)
+
+    target = imported_account
+
+    assert Notification::Bundle.where(account: target).all?(&:delivered?)
+    assert_empty Notification::Bundle.where(account: target).due
+  end
+
+  test "completing an import emails the importer and deletes the uploaded file" do
+    import = import_of(export_of(@source))
+
+    assert_enqueued_email_with ImportMailer, :completed, args: [ import ] do
+      import.process
+    end
+
+    perform_enqueued_jobs only: ActiveStorage::PurgeJob
+    assert_not import.reload.file.attached?
+  end
+
+  test "importing a file that isn't an export fails and leaves nothing behind" do
+    import = import_of(zip_with("hello.txt" => "Hello!"))
+
+    assert_import_fails_without_leftovers import, /isn't a Fizzy account export/
+  end
+
+  test "importing a file that isn't a zip fails and leaves nothing behind" do
+    import = import_of(StringIO.new("Not a zip at all" * 100))
+
+    assert_import_fails_without_leftovers import, /isn't a valid \.zip/
+  end
+
+  test "importing an export from a newer version of Fizzy fails" do
+    import = import_of(zip_with("manifest.json" => { format: "fizzy-account", version: 999 }.to_json))
+
+    assert_import_fails_without_leftovers import, /newer version of Fizzy/
+  end
+
+  test "importing a damaged export fails before importing anything" do
+    export = rewrite_zip(export_of(@source)) do |path, data|
+      path.start_with?("data/comments/") ? data.sub(/"card_id":"[^"]*",/, "") : data
+    end
+
+    import = import_of(export)
+    assert_import_fails_without_leftovers import, /damaged or incomplete: data\/comments\/.*card_id/
+  end
+
+  test "importing an export with invalid values fails before importing anything" do
+    export = rewrite_zip(export_of(@source)) do |path, data|
+      path == "data/users/#{users(:david).id}.json" ? data.sub('"role":"member"', '"role":"overlord"') : data
+    end
+
+    import = import_of(export)
+    assert_import_fails_without_leftovers import, /damaged or incomplete: data\/users\/.* has an invalid role/
+  end
+
+  test "an import that fails midway leaves nothing behind" do
+    import = import_of(export_of(@source))
+    Account::DataTransfer::ActionText::RichTextRecordSet.any_instance.stubs(:import).raises(RuntimeError, "Boom")
+
+    assert_import_fails_without_leftovers import, /Something went wrong/
+  end
+
+  test "an import that fails after storing files deletes them from storage" do
+    import = import_of(export_of(@source))
+    stored_keys = [ import.file.key ]
+    Account::DataTransfer::Manifest.any_instance.stubs(:finalize).raises(RuntimeError, "Boom")
+
+    ActiveSupport::Notifications.subscribed(->(event) { stored_keys << event.payload[:key] }, "service_upload.active_storage") do
+      assert_import_fails_without_leftovers import, /Something went wrong/
+    end
+
+    assert_operator stored_keys.size, :>, 2
+    assert stored_keys.none? { |key| ActiveStorage::Blob.service.exist?(key) }
+  end
+
+  test "failing emails the importer why" do
+    import = import_of(zip_with("hello.txt" => "Hello!"))
+
+    assert_enqueued_email_with ImportMailer, :failed, args: [ import ] do
+      import.process
+    end
+  end
+
+  test "an interrupted import resumes where it left off" do
+    import = import_of(export_of(@source))
+    cursors = []
+
+    assert_raises(ActiveJob::Continuation::Interrupt) do
+      import.process do |cursor|
+        cursors << cursor
+        raise ActiveJob::Continuation::Interrupt if cursor == [ "import", "comments", 500 ]
+      end
+    end
+
+    assert import.reload.processing?
+    assert_equal [ "import", "comments", 500 ], cursors.last
+    assert Card.where(account: import.account).exists?
+    assert_not Event.where(account: import.account).exists?
+
+    import.process(start: cursors.last)
+
+    assert import.reload.completed?
+    assert_equal digest_of(@source), digest_of(import.account)
+  end
+
+  test "importing into an account created some other way" do
+    export = export_of(@source)
+    account = Account.create!(name: "Imported")
+    import = Current.with_account(account) do
+      Account::Import.create!(identity: @importer, account: account).tap do |import|
+        import.file.attach(io: export, filename: "export.zip", content_type: "application/zip")
+      end
+    end
+
+    import.process
+
+    assert import.reload.completed?, import.failure_reason
+    assert_equal @source.name, account.reload.name
+    assert account.users.find_by!(identity: @importer).owner?
+    assert_equal 1, account.users.where(role: :system).count
+    assert_equal @source.cards.count, account.cards.count
+  end
+
+  test "start requires a zip file" do
+    import = Account::Import.new(identity: @importer)
+    import.file.attach(io: StringIO.new("text"), filename: "notes.txt", content_type: "text/plain")
+
+    assert_no_difference -> { Account.count } do
+      assert_not import.start
+    end
+
+    assert_includes import.errors[:file], "must be a .zip file"
+  end
+
+  test "start creates the account and enqueues processing" do
+    import = Account::Import.new(identity: @importer)
+    import.file.attach(io: export_of(@source), filename: "export.zip", content_type: "application/zip")
+
+    assert_difference -> { Account.count }, +1 do
+      assert_enqueued_with job: ImportAccountDataJob do
+        assert import.start
+      end
+    end
+
+    assert import.account.users.find_by(identity: @importer).owner?
+    assert_equal import.account, import.file.blob.account
+  end
+
+  private
+    def mention_of(user)
+      %(<action-text-attachment sgid="#{user.attachable_sgid}" content-type="application/vnd.actiontext.mention"></action-text-attachment>)
+    end
+
+    def export_of(account)
+      export = Account::Export.create!(account: account, user: account.users.admin.first)
+      export.build
+      StringIO.new(export.file.download)
+    end
+
+    def import_of(io, identity: @importer)
+      Current.without_account do
+        Account::Import.new(identity: identity).tap do |import|
+          import.file.attach(io: io, filename: "export.zip", content_type: "application/zip")
+          assert import.start, import.errors.full_messages.to_sentence
+        end
+      end
+    end
+
+    def imported_account
+      import_of(export_of(@source)).tap(&:process).reload.account
+    end
+
+    def zip_with(files)
+      StringIO.new(String.new(encoding: Encoding::BINARY)).tap do |io|
+        writer = ZipFile::Writer.new(io)
+        files.each { |path, data| writer.add_file(path, data) }
+        writer.close
+        io.rewind
+      end
+    end
+
+    def rewrite_zip(io)
+      tempfile = Tempfile.new([ "export", ".zip" ], binmode: true)
+      tempfile.write(io.read)
+      tempfile.flush
+
+      File.open(tempfile.path, "rb") do |file|
+        reader = ZipFile::Reader.new(file)
+        zip_with(reader.glob("**/*").index_with { |path| yield path, reader.read(path) })
+      end
+    ensure
+      tempfile&.close!
+    end
+
+    def assert_import_fails_without_leftovers(import, reason)
+      Rails.application.eager_load!
+      account = import.account
+      identities_before = Identity.count
+
+      import.process
+      import.reload
+
+      assert import.failed?
+      assert_match reason, import.failure_reason
+      assert_nil import.account
+      assert_not Account.exists?(account.id)
+      assert_equal identities_before, Identity.count
+
+      leftovers = ApplicationRecord.descendants.select { |model| !model.abstract_class? && model.table_exists? && model.column_names.include?("account_id") }
+        .to_h { |model| [ model.name, model.where(account_id: account.id).count ] }.select { |_, count| count.positive? }
+      leftovers.merge!(ActiveStorage::Blob.where(account_id: account.id).group(:id).count.transform_keys { "ActiveStorage::Blob" })
+      leftovers.merge!(ActiveStorage::Attachment.where(account_id: account.id).group(:id).count.transform_keys { "ActiveStorage::Attachment" })
+      leftovers.merge!(ActionText::RichText.where(account_id: account.id).group(:id).count.transform_keys { "ActionText::RichText" })
+
+      assert_empty leftovers, "Expected nothing left behind for the import"
+      assert_not import.file.attached?
+    end
+
+    def digest_of(account)
+      cards = account.cards.includes(:board, :column, :creator, :tags, :assignees, :steps, :closure, :goldness, comments: [ :creator, :reactions ]).sort_by(&:number).map do |card|
+        [
+          card.number, card.title, card.status, card.board.name, card.column&.name, card.creator.name,
+          card.assignees.map(&:name).sort, card.tags.map(&:title).sort, card.steps.map { [ _1.content, _1.completed ] }.sort,
+          card.closed?, card.golden?, card.postponed?, card.due_on, card.created_at, card.last_active_at,
+          card.description.to_plain_text, card.image.attached? && card.image.checksum,
+          card.comments.map { [ _1.created_at, _1.creator.name, _1.body.to_plain_text, _1.reactions.map(&:content).sort ] }.sort_by(&:to_s),
+          card.reactions.map { [ _1.content, _1.reacter.name ] }.sort,
+          card.watches.map { [ _1.user.name, _1.watching ] }.sort,
+          card.pins.map { _1.user.name }.sort
+        ]
+      end
+
+      boards = account.boards.includes(:creator, :columns, :entropy, accesses: :user).sort_by(&:name).map do |board|
+        [ board.name, board.all_access, board.creator.name, board.columns.sort_by(&:position).map { [ _1.name, _1.color.to_s, _1.position ] },
+          board.accesses.reject { _1.user.identity == @importer }.map { [ _1.user.name, _1.involvement ] }.sort, board.entropy&.auto_postpone_period, board.published?, board.webhooks.map(&:name).sort ]
+      end
+
+      events = Event.where(account: account).includes(:creator, :board).map do |event|
+        [ event.action.to_s, event.creator.name, event.board.name, event.eventable_type, event.created_at, event.assignees.map(&:name).sort ]
+      end.sort
+
+      notifications = Notification.where(account: account).includes(:user, :card).map { [ _1.user.name, _1.card.number, _1.source_type, _1.read_at ] }.sort
+      mentions = Mention.where(account: account).includes(:mentioner, :mentionee).map { [ _1.mentioner.name, _1.mentionee.name, _1.source_type ] }.sort
+      users = account.users.where.not(identity: @importer).map { [ _1.name, _1.active, _1.verified_at.present?, _1.identity&.email_address, (_1.role unless _1.owner?) ] }.sort_by(&:to_s)
+
+      { cards:, boards:, events:, notifications:, mentions:, users:, tags: account.tags.pluck(:title).sort, entropy: account.entropy.auto_postpone_period }
+    end
+end
