diff --git a/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb b/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
index 6017f88..3813f4b 100644
--- a/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
+++ b/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
@@ -1,4 +1,85 @@
 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    cards(:logo).update!(description: <<~HTML)
+      <p>Hey #{mention_of(users(:jz))}</p>
+      <action-text-attachment sgid="#{@blob.attachable_sgid}"></action-text-attachment>
+    HTML
+    @rich_text = cards(:logo).description
+  end
+
+  test "exports attachments with global IDs instead of signed ones" do
+    body = exported_body
+
+    assert_includes body, %(gid="gid://#{GlobalID.app}/User/#{users(:jz).id}")
+    assert_includes body, %(gid="gid://#{GlobalID.app}/ActiveStorage::Blob/#{@blob.id}")
+    assert_not_includes body, "sgid="
+  end
+
+  test "imports attachments signed again, pointing to the imported records" do
+    target = accounts(:initech)
+    mapping = Account::DataTransfer::IdMapping.new(salt: "import")
+    imported_blob = ActiveStorage::Blob.create!(account: target, key: "imported", filename: "moon.jpg", content_type: "image/jpeg", byte_size: 1, checksum: "x")
+    mapping.override @blob.id, with: imported_blob.id
+    mapping.override users(:jz).id, with: users(:mike).id
+
+    import_into target, mapping
+    imported = ActionText::RichText.find_by!(account: target)
+
+    assert_equal [ users(:mike), imported_blob ], imported.body.attachables.sort_by { |attachable| attachable.class.name }.reverse
+    assert_includes imported.body.to_html, "/#{target.external_account_id}/rails/active_storage/blobs/redirect/"
+    assert_equal mapping[@rich_text.id], imported.id
+    assert_equal mapping[cards(:logo).id], imported.record_id
+  end
+
+  test "imports never keep signed IDs from the export, or point to unexpected records" do
+    target = accounts(:initech)
+    body = <<~HTML
+      <action-text-attachment sgid="#{users(:david).attachable_sgid}"></action-text-attachment>
+      <action-text-attachment gid="gid://#{GlobalID.app}/Identity/#{identities(:david).id}"></action-text-attachment>
+    HTML
+
+    import_into target, Account::DataTransfer::IdMapping.new(salt: "import"), body: body
+    imported = ActionText::RichText.find_by!(account: target)
+
+    assert_not_includes imported.body.to_html, "sgid="
+    assert imported.body.attachables.all? { |attachable| attachable.is_a?(ActionText::Attachables::MissingAttachable) }
+  end
+
+  private
+    def mention_of(user)
+      %(<action-text-attachment sgid="#{user.attachable_sgid}" content-type="application/vnd.actiontext.mention"></action-text-attachment>)
+    end
+
+    def exported_body
+      read_exported { |zip| JSON.parse(zip.read("data/action_text_rich_texts/#{@rich_text.id}.json"))["body"] }
+    end
+
+    def read_exported
+      io = StringIO.new(String.new(encoding: Encoding::BINARY))
+      writer = ZipFile::Writer.new(io)
+      Account::DataTransfer::ActionText::RichTextRecordSet.new(@account).export(to: writer)
+      writer.close
+
+      yield ZipFile::Reader.new(StringIO.new(io.string))
+    end
+
+    def import_into(target, mapping, body: nil)
+      io = StringIO.new(String.new(encoding: Encoding::BINARY))
+      writer = ZipFile::Writer.new(io)
+      read_exported do |zip|
+        data = JSON.parse(zip.read("data/action_text_rich_texts/#{@rich_text.id}.json"))
+        data["body"] = body if body
+        writer.add_file "data/action_text_rich_texts/#{@rich_text.id}.json", data.to_json
+      end
+      writer.close
+
+      zip = ZipFile::Reader.new(StringIO.new(io.string))
+      record_set = Account::DataTransfer::ActionText::RichTextRecordSet.new(target)
+      record_set.check(from: zip)
+      Current.with_account(target) { record_set.import(from: zip, mapping: mapping) }
+    end
 end
diff --git a/test/models/account/data_transfer/id_mapping_test.rb b/test/models/account/data_transfer/id_mapping_test.rb
new file mode 100644
index 0000000..909c23e
--- /dev/null
+++ b/test/models/account/data_transfer/id_mapping_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Account::DataTransfer::IdMappingTest < ActiveSupport::TestCase
+  setup do
+    @known_id = ActiveRecord::Type::Uuid.generate
+    @unknown_id = ActiveRecord::Type::Uuid.generate
+  end
+
+  test "keeps exported IDs when not remapping" do
+    mapping = Account::DataTransfer::IdMapping.new(salt: "import", remap: false, known_ids: Set[@known_id])
+
+    assert_equal @known_id, mapping[@known_id]
+    assert_nil mapping[nil]
+  end
+
+  test "never keeps IDs of records outside the export" do
+    mapping = Account::DataTransfer::IdMapping.new(salt: "import", remap: false, known_ids: Set[@known_id])
+
+    assert_not_equal @unknown_id, mapping[@unknown_id]
+  end
+
+  test "remaps IDs deterministically per import" do
+    mapping = Account::DataTransfer::IdMapping.new(salt: "import", remap: true, known_ids: Set[@known_id])
+
+    assert_not_equal @known_id, mapping[@known_id]
+    assert_equal mapping[@known_id], Account::DataTransfer::IdMapping.new(salt: "import")[@known_id]
+    assert_not_equal mapping[@known_id], Account::DataTransfer::IdMapping.new(salt: "another import")[@known_id]
+  end
+
+  test "remapped IDs are valid and keep sorting chronologically" do
+    mapping = Account::DataTransfer::IdMapping.new(salt: "import")
+    older = ActiveRecord::Type::Uuid.hex_to_base36("0190f2b3c4d57abc8def0123456789ab")
+    newer = ActiveRecord::Type::Uuid.hex_to_base36("0190f2b3c4d67000800000000000000f")
+
+    assert_match(/\A[0-9a-z]{25}\z/, mapping[older])
+    assert_operator mapping[older], :<, mapping[newer]
+    assert_equal older.first(8), mapping[older].first(8)
+  end
+
+  test "overrides point IDs to existing records" do
+    mapping = Account::DataTransfer::IdMapping.new(salt: "import", remap: false, known_ids: Set[@known_id])
+    mapping.override @known_id, with: @unknown_id
+
+    assert_equal @unknown_id, mapping[@known_id]
+  end
+end
