+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+  end
+
+  test "build creates a zip, marks the export completed and emails its owner" do
+    assert_enqueued_email_with ExportMailer, :completed, args: [ @export ] do
+      @export.build
+    end
+
+    assert @export.completed?
+    assert @export.completed_at.present?
+    assert @export.file.attached?
+    assert_equal "application/zip", @export.file.content_type
+    assert_equal "fizzy-37signals-#{Date.current.iso8601}.zip", @export.file.filename.to_s
+    assert_equal @export.file.byte_size, @export.file.download.bytesize
+    assert_equal Digest::MD5.base64digest(@export.file.download), @export.file.checksum
+  end
+
+  test "build works outside of the account's context" do
+    Current.without_account { @export.build }
+
+    assert @export.completed?
+    assert_equal accounts("37s"), @export.file.blob.account
+  end
+
+  test "a failed build is marked as failed and leaves no file behind" do
+    Account::DataTransfer::Manifest.any_instance.stubs(:export).raises(RuntimeError, "Boom")
+
+    assert_no_difference -> { ActiveStorage::Blob.count } do
+      assert_raises(RuntimeError) { @export.build }
+    end
+
+    assert @export.reload.failed?
+    assert_not @export.file.attached?
+  end
+
+  test "build_later enqueues the job" do
+    assert_enqueued_with job: DataExportJob, args: [ @export ] do
+      @export.build_later
+    end
+  end
+
+  test "exports can be downloaded for a day" do
+    @export.build
+    assert @export.downloadable?
+
+    travel Export::EXPIRATION + 1.minute do
+      assert @export.expired?
+      assert_not @export.downloadable?
+    end
+  end
+
+  test "only the owner can download an export" do
+    assert @export.accessible_to?(users(:kevin))
+    assert_not @export.accessible_to?(users(:jason))
+    assert_not @export.accessible_to?(nil)
+  end
+
+  test "account exports stop being downloadable by owners who are no longer admins" do
+    users(:kevin).update!(role: :member)
+
+    assert_not @export.accessible_to?(users(:kevin))
+  end
+
+  test "the file is only downloadable by the owner" do
+    @export.build
+
+    assert @export.file.blob.accessible_to?(users(:kevin))
+    assert_not @export.file.blob.accessible_to?(users(:david))
+    assert_not @export.file.blob.publicly_accessible?
+  end
+
+  test "cleanup removes expired exports and their files" do
+    @export.build
+    stale = User::DataExport.create!(account: accounts("37s"), user: users(:david), created_at: Export::ABANDONED_AFTER.ago - 1.day)
+    long_running = User::DataExport.create!(account: accounts("37s"), user: users(:david), status: :processing, created_at: 2.days.ago)
+    recent = nil
+
+    travel Export::EXPIRATION + 1.minute do
+      recent = User::DataExport.create!(account: accounts("37s"), user: users(:david))
+
+      assert_enqueued_with job: ActiveStorage::PurgeJob do
+        Export.cleanup
+      end
+    end
+
+    assert_not Export.exists?(@export.id)
+    assert_not Export.exists?(stale.id)
+    assert Export.exists?(recent.id)
+    assert Export.exists?(long_running.id)
+  end
+end
diff --git a/test/models/user/data_export_test.rb b/test/models/user/data_export_test.rb
new file mode 100644
index 0000000..e5049c5
--- /dev/null
+++ b/test/models/user/data_export_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    cards(:logo).update!(description: %(<p>See this</p><action-text-attachment sgid="#{@blob.attachable_sgid}"></action-text-attachment>))
+    cards(:logo).image.attach(io: file_fixture("avatar.png").open, filename: "moon.jpg", content_type: "image/png")
+  end
+
+  test "exports the cards the user can see, with their comments" do
+    read_export do |zip|
+      exported = zip.glob("*.json").map { |path| File.basename(path, ".json").to_i }.sort
+      assert_equal @user.accessible_cards.published.map(&:number).sort, exported
+
+      card = JSON.parse(zip.read("#{cards(:logo).number}.json"))
+      assert_equal cards(:logo).title, card["title"]
+      assert_equal "David", card.dig("creator", "name")
+      assert_equal "david@37signals.com", card.dig("creator", "email_address")
+      assert_equal [ "JZ", "Kevin" ], card["assignees"].map { |assignee| assignee["name"] }.sort
+      assert_equal "I agree.", card["comments"].find { |comment| comment.dig("creator", "name") == "JZ" }.dig("body", "plain_text")
+      assert_includes card.dig("description", "plain_text"), "See this"
+    end
+  end
+
+  test "doesn't export cards from boards the user can't see" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Secret", status: :published)
+    end
+
+    read_export do |zip|
+      titles = zip.glob("*.json").map { |path| JSON.parse(zip.read(path))["title"] }
+      assert_not_includes titles, "Secret"
+    end
+  end
+
+  test "exports drafts only to their creators" do
+    with_current_user(:kevin) { boards(:writebook).cards.create!(title: "Kevin's draft", status: :drafted) }
+    with_current_user(:david) { boards(:writebook).cards.create!(title: "David's draft", status: :drafted) }
+
+    read_export do |zip|
+      titles = zip.glob("*.json").map { |path| JSON.parse(zip.read(path))["title"] }
+      assert_includes titles, "David's draft"
+      assert_not_includes titles, "Kevin's draft"
+    end
+  end
+
+  test "exports every picture and file attached to cards next to them" do
+    read_export do |zip|
+      number = cards(:logo).number
+      card = JSON.parse(zip.read("#{number}.json"))
+
+      image_path = card.dig("image", "path")
+      embed_path = card.dig("description", "attachments", 0, "path")
+
+      assert_equal [ "#{number}/moon (2).jpg", "#{number}/moon.jpg" ], [ image_path, embed_path ].sort
+      assert_equal file_fixture("avatar.png").binread, zip.read(image_path)
+      assert_equal file_fixture("moon.jpg").binread, zip.read(embed_path)
+      assert_includes card.dig("description", "html"), %(url="#{embed_path}")
+      assert_not_includes card.dig("description", "html"), "sgid"
+    end
+  end
+
+  test "is named after the account and the user" do
+    export = User::DataExport.create!(account: accounts("37s"), user: @user)
+    export.build
+
+    assert_equal "fizzy-37signals-david-#{Date.current.iso8601}.zip", export.file.filename.to_s
+  end
+
+  private
+    def read_export
+      export = User::DataExport.create!(account: accounts("37s"), user: @user)
+      export.build
+
+      ZipFile.read_from(export.file.blob) { |zip| yield zip }
+    end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
