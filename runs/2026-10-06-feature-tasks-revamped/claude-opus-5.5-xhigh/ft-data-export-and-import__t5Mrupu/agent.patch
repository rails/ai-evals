@@ -0,0 +1,53 @@
+require "application_system_test_case"
+
+class DataTransferTest < ApplicationSystemTestCase
+  test "exporting an account and importing it as a new one" do
+    sign_in_as(users(:kevin))
+
+    visit account_settings_url
+    perform_enqueued_jobs only: DataExportJob do
+      click_on "Export this account"
+      assert_text "We’re preparing your export"
+    end
+
+    export = Account::Export.last
+    assert export.completed?
+
+    visit account_export_url(export)
+    assert_selector "a#download-link", text: export.file.filename.to_s
+
+    archive = Rails.root.join("tmp", "system-test-export-#{export.id}.zip")
+    File.binwrite(archive, export.file.download)
+
+    visit new_account_import_url(script_name: nil)
+    attach_file "account_import[file]", archive
+
+    perform_enqueued_jobs only: ImportAccountDataJob do
+      click_on "Start import"
+      assert_text "Your account is ready"
+    end
+
+    click_on "Go to 37signals"
+
+    imported = Account::Import.last.account
+    assert_current_path(/\A#{imported.slug}/)
+    visit card_url(cards(:logo).number, script_name: imported.slug)
+    assert_selector "h1", text: cards(:logo).title
+  ensure
+    FileUtils.rm_f(archive) if archive
+  end
+
+  test "exporting your own data from your profile" do
+    sign_in_as(users(:david))
+
+    visit user_url(users(:david))
+    perform_enqueued_jobs only: DataExportJob do
+      click_on "Export my data"
+      assert_text "We’re preparing your export"
+    end
+
+    visit user_url(users(:david))
+    click_on "download it"
+    assert_selector "a#download-link"
+  end
+end
