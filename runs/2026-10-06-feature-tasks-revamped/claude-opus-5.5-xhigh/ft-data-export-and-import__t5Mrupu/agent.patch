+++ b/app/jobs/import_account_data_job.rb
@@ -0,0 +1,16 @@
+# Imports can take hours for big accounts. As a continuation, an interrupted import
+# (e.g. by a deploy) picks up from its last checkpoint instead of starting over.
+class ImportAccountDataJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+  limits_concurrency to: 1, key: ->(import) { import }
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(import)
+    step :process do |step|
+      import.process(start: step.cursor) { |cursor| step.set! cursor }
+    end
+  end
+end
