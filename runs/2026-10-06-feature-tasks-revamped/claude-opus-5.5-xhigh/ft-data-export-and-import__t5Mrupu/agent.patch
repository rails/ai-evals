+require "test_helper"
+
+class ImportAccountDataJobTest < ActiveJob::TestCase
+  setup do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    @import = Current.without_account do
+      Account::Import.new(identity: identities(:mike)).tap do |import|
