+
+    # Log in only when there's a username, so relays that don't take logins work too.
+    if smtp_username = ENV["SMTP_USERNAME"].presence
+      config.action_mailer.smtp_settings.merge!(
+        user_name: smtp_username,
+        password: ENV["SMTP_PASSWORD"],
+        authentication: ENV["SMTP_AUTHENTICATION"].presence || "plain"
