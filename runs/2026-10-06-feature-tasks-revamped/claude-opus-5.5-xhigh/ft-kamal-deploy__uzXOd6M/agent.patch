+++ b/.kamal/secrets
@@ -0,0 +1,30 @@
+# Secrets for the env/secret entries in config/deploy.yml. This file is committed, so never write
+# a credential into it: read each one from your environment, a command, or a password manager.
+#
+# Generate these once, keep them somewhere safe, and reuse them on every deploy:
+#
+#   SECRET_KEY_BASE:   bin/rails secret
+#   VAPID_*_KEY:       bundle exec ruby -r web-push -e 'key = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{key.public_key}", "VAPID_PRIVATE_KEY=#{key.private_key}"'
+#
+# Changing SECRET_KEY_BASE later signs everyone out and breaks images and files already attached
+# to cards and comments.
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Your mail server's credentials. Leave them unset if it doesn't need authentication.
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Keys for browser push notifications, which stay off until these are set.
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+
+# Or fetch them from a password manager instead. Kamal has adapters for 1Password, Bitwarden,
+# LastPass, AWS Secrets Manager and others:
+#
+# SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from MyVault/Fizzy SECRET_KEY_BASE SMTP_USERNAME SMTP_PASSWORD VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY)
+# SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
+# SMTP_USERNAME=$(kamal secrets extract SMTP_USERNAME $SECRETS)
+# SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD $SECRETS)
+# VAPID_PUBLIC_KEY=$(kamal secrets extract VAPID_PUBLIC_KEY $SECRETS)
+# VAPID_PRIVATE_KEY=$(kamal secrets extract VAPID_PRIVATE_KEY $SECRETS)
