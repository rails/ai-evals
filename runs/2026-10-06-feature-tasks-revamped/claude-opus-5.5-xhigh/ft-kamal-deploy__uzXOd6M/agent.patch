diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..48c69b1
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,95 @@
+# Deploy Fizzy to one Linux server with Kamal. A single container runs the web server and the
+# background jobs, keeps its SQLite databases and uploaded files on a persistent volume, and gets
+# HTTPS from kamal-proxy with a Let's Encrypt certificate.
+#
+# Fill in your hostname (x-host) and mail server (env/clear) below and your secrets in
+# .kamal/secrets, then run `bin/kamal setup` for the first deploy and `bin/kamal deploy` after that.
+# See docs/deployment.md for the whole walkthrough.
+
+# The hostname you'll reach Fizzy at. Point its DNS at your server before the first deploy, and
+# keep ports 80 and 443 open: Let's Encrypt needs them to issue the certificate.
+x-host: &host fizzy.example.com
+
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    # Kamal connects to the server over SSH as root (see `ssh` below to change that). Replace the
+    # hostname with the server's IP address if you'd rather connect that way.
+    - *host
+
+proxy:
+  ssl: true
+  host: *host
+
+  # Big account imports may need a larger upload limit (default 1GB) and longer timeout (default 30s).
+  # buffering:
+  #   max_request_body: 10_000_000_000
+  # response_timeout: 300
+
+# Images are built on your machine and pushed to the server over SSH, so you don't need an account
+# with a container registry.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Use arm64 for an ARM server.
+
+env:
+  clear:
+    # Links in emails and notifications point here.
+    APP_HOST: *host
+
+    # Your mail server, which sends sign-in codes and notifications. The username and password go
+    # in .kamal/secrets.
+    SMTP_ADDRESS: smtp.example.com
+    # SMTP_PORT: 587               # Defaults to 587, or 465 with SMTP_TLS.
+    # SMTP_TLS: true               # Connect with TLS (SMTPS) instead of upgrading with STARTTLS.
+    # SMTP_AUTHENTICATION: plain   # Or login, cram_md5.
+    # SMTP_DOMAIN: example.com     # Domain to greet the server with. Defaults to APP_HOST.
+
+    # The sender of every email. Use an address your mail server is allowed to send from.
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+
+    # Run background jobs inside the web server's container.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Web and job processes default to one per CPU core. Lower them on a server short on memory.
+    # WEB_CONCURRENCY: 1
+    # JOB_CONCURRENCY: 1
+
+    # Fizzy hosts one account, created by the first person to sign up. Set this to let anyone sign
+    # up and create their own account.
+    # MULTI_TENANT: true
+
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# The SQLite databases and uploaded files live in /rails/storage, so keep it on a volume that
+# outlives each deploy's container. Back it up: on the server it's in
+# /var/lib/docker/volumes/fizzy_storage/_data.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Keep serving the previous version's assets during a deploy so in-flight pages don't break.
+asset_path: /rails/public/assets
+
+# Cap container logs so they can't fill the disk the databases live on.
+logging:
+  options:
+    max-size: 100m
+
+# Use a non-root SSH user. It must be able to run docker without sudo.
+# ssh:
+#   user: deploy
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs --follow
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
