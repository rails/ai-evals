   config.action_mailer.perform_caching = false
 
+  # Send email through the SMTP server at SMTP_ADDRESS. The connection is upgraded with STARTTLS when
+  # the server offers it; set SMTP_TLS=true for servers that expect TLS from the start (SMTPS).
+  if smtp_address = ENV["SMTP_ADDRESS"].presence
