diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..932052c 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,19 @@
 module TimeHelper
+  # Renders an empty <time> that carries only the raw timestamp. The local-time controller turns it into words
+  # in the viewer's own timezone (see app/javascript/helpers/local_time_helpers.js for the styles), so the markup
+  # is the same for everyone, whenever it was rendered, and safe to cache and share.
+  def local_datetime_tag(datetime, style: :time, data: {}, **attributes)
+    tag.time datetime: local_datetime_attribute(datetime), data: { local_time_target: "time", local_time_style: style, **data }, **attributes
+  end
+
+  private
+    # Times are sent in UTC so the markup doesn't depend on the zone it was rendered in. Dates are calendar days,
+    # not instants, so they stay as they are and read as the same day for everyone.
+    def local_datetime_attribute(datetime)
+      if datetime.acts_like?(:time)
+        datetime.utc.iso8601
+      else
+        datetime.to_date.iso8601
+      end
+    end
 end
