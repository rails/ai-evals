diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..f2c1869
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,170 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+// Turns a <time datetime> rendered by local_datetime_tag (app/helpers/time_helper.rb) into words in the viewer's
+// own timezone. Returns the words as parts (plain strings, plus { value } for the bit worth emphasizing, like the
+// "3" in "3 days ago"), their text, and a full date for the tooltip. Nothing for a missing or invalid datetime.
+export function formatLocalTime(element, now = new Date()) {
+  const time = new LocalTime(element.getAttribute("datetime"))
+
+  if (time.isValid) {
+    const style = STYLES[element.dataset.localTimeStyle] ?? STYLES.datetime
+    const parts = style(time, now)
+
+    return { parts, text: parts.map(textOf).join(""), title: fullDate(time) }
+  }
+}
+
+const STYLES = {
+  // 1:42 PM
+  time: time => [ format(time, { timeStyle: "short" }) ],
+
+  // Sep 12, 2025
+  date: time => [ format(time, { dateStyle: "medium" }) ],
+
+  // 9/12/25, 1:42 PM
+  datetime: time => [ format(time, { dateStyle: "short", timeStyle: "short" }) ],
+
+  // Sep 12, or Sep 12, 2024 outside this year
+  short_date: (time, now) => [ shortDate(time, now) ],
+
+  // Friday, September 12, or Friday, September 12, 2024 outside this year
+  weekday: (time, now) => [ format(time, { weekday: "long", month: "long", day: "numeric", ...yearUnlessCurrent(time, now) }) ],
+
+  // just now, 5 minutes ago, 2 hours ago, and then as days_ago
+  ago: (time, now) => {
+    const minutes = Math.floor((now - time.date) / 60_000)
+
+    if (!time.hasTimeOfDay || minutes >= 24 * 60) return daysAgo(time, now)
+    if (minutes < 1) return [ emphasized("just now") ]
+    if (minutes < 60) return [ emphasized(minutes), ` ${pluralize(minutes, "minute")} ago` ]
+
+    const hours = Math.floor(minutes / 60)
+    return [ emphasized(hours), ` ${pluralize(hours, "hour")} ago` ]
+  },
+
+  // today, yesterday, 5 days ago
+  days_ago: daysAgo,
+
+  // today, tomorrow, in 3 days
+  in_days: inDays,
+
+  // 1:42 PM today, then yesterday or tomorrow, 5 days ago or in 3 days within a week, and Sep 12 beyond that
+  relative: (time, now) => {
+    const days = time.daysBefore(now)
+
+    if (days === 0) return time.hasTimeOfDay ? STYLES.time(time) : [ emphasized("today") ]
+    if (Math.abs(days) >= 7) return [ shortDate(time, now) ]
+    return days > 0 ? daysAgo(time, now) : inDays(time, now)
+  }
+}
+
+function daysAgo(time, now) {
+  const days = time.daysBefore(now)
+
+  if (days <= 0) return [ emphasized("today") ]
+  if (days === 1) return [ emphasized("yesterday") ]
+  return [ emphasized(days), " days ago" ]
+}
+
+function inDays(time, now) {
+  const days = -time.daysBefore(now)
+
+  if (days <= 0) return [ emphasized("today") ]
+  if (days === 1) return [ emphasized("tomorrow") ]
+  return [ "in ", emphasized(days), " days" ]
+}
+
+function shortDate(time, now) {
+  return format(time, { month: "short", day: "numeric", ...yearUnlessCurrent(time, now) })
+}
+
+function yearUnlessCurrent(time, now) {
+  return time.date.getFullYear() === now.getFullYear() ? {} : { year: "numeric" }
+}
+
+function fullDate(time) {
+  return format(time, { dateStyle: "full", timeStyle: "short" })
+}
+
+function emphasized(value) {
+  return { value: String(value) }
+}
+
+function textOf(part) {
+  return typeof part === "string" ? part : part.value
+}
+
+function pluralize(count, word) {
+  return count === 1 ? word : `${word}s`
+}
+
+// A plain date (2025-09-12) is a calendar day rather than an instant: it reads as that same day everywhere, and
+// has no time of day to show.
+class LocalTime {
+  static PLAIN_DATE = /^(\d{4})-(\d{2})-(\d{2})$/
+
+  constructor(datetime) {
+    const plainDate = datetime?.match(LocalTime.PLAIN_DATE)
+
+    if (plainDate) {
+      const [ , year, month, day ] = plainDate.map(Number)
+      this.date = new Date(year, month - 1, day)
+      this.hasTimeOfDay = false
+    } else {
+      this.date = new Date(datetime ?? NaN)
+      this.hasTimeOfDay = true
+    }
+  }
+
+  get isValid() {
+    return !isNaN(this.date)
+  }
+
+  // Positive for days in the past, negative for days ahead
+  daysBefore(now) {
+    return signedDifferenceInDays(this.date, now)
+  }
+}
+
+const formatters = new Map()
+
+function format(time, options) {
+  if (!time.hasTimeOfDay) options = withoutTimeOfDay(options)
+  options = { ...options, timeZone: currentTimeZone() }
+
+  const key = JSON.stringify(options)
+  if (!formatters.has(key)) formatters.set(key, new Intl.DateTimeFormat(LOCALE, options))
+
+  return formatters.get(key).format(time.date)
+}
+
+// Formatters keep the timezone they were built in, while Date picks up a change straight away (the viewer travels,
+// say), so the zone is part of the formatter's key. Looking it up isn't free, so it's done once per batch of times.
+let timeZoneForBatch
+
+function currentTimeZone() {
+  if (!timeZoneForBatch) {
+    timeZoneForBatch = Intl.DateTimeFormat().resolvedOptions().timeZone
+    queueMicrotask(() => timeZoneForBatch = null)
+  }
+
+  return timeZoneForBatch
+}
+
+function withoutTimeOfDay({ timeStyle, hour, minute, ...options }) {
+  return Object.keys(options).length ? options : { dateStyle: "medium" }
+}
+
+// Words around the times are in the page's language, so format in it too, but in the regional flavor the
+// viewer prefers when they have one (en-GB gets a 24-hour clock and 12 Sept).
+const LOCALE = preferredLocaleFor(document.documentElement.lang)
+
+function preferredLocaleFor(language) {
+  if (language) {
+    return navigator.languages?.find(locale => baseLanguageOf(locale) === baseLanguageOf(language)) ?? language
+  }
+}
+
+function baseLanguageOf(locale) {
+  return locale.split("-")[0].toLowerCase()
+}
