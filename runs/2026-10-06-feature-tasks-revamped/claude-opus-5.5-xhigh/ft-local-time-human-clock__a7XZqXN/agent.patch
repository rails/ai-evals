diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..bcd6d8d
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,57 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+// Fills in the <time> elements rendered by local_datetime_tag, in the viewer's own timezone, and keeps the relative
+// ones ("5 minutes ago", "today") current while the page stays open.
+export default class extends Controller {
+  static targets = [ "time" ]
+
+  #timer
+
+  connect() {
+    this.#timer = setInterval(() => this.refresh(), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  timeTargetConnected(target) {
+    this.#render(target)
+  }
+
+  refresh() {
+    this.timeTargets.forEach(target => this.#render(target))
+  }
+
+  // Morphing puts back the server's empty <time>, maybe with a new datetime, without reconnecting the target
+  refreshMorphed({ target }) {
+    if (target.matches?.(this.#timeTargetSelector)) this.#render(target)
+  }
+
+  #render(target) {
+    const formatted = formatLocalTime(target)
+
+    if (formatted && (target.textContent !== formatted.text || target.title !== formatted.title)) {
+      target.replaceChildren(...formatted.parts.map(nodeForPart))
+      target.title = formatted.title
+    }
+  }
+
+  get #timeTargetSelector() {
+    return `[data-${this.identifier}-target~="time"]`
+  }
+}
+
+function nodeForPart(part) {
+  if (typeof part === "string") {
+    return part
+  } else {
+    const value = document.createElement("span")
+    value.className = "local-time-value"
+    value.textContent = part.value
+    return value
+  }
+}
