diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..133f9db
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_datetime_tag leaves the words to the browser" do
+    assert_dom_equal \
+      %(<time datetime="2025-09-12T13:42:00Z" data-local-time-target="time" data-local-time-style="relative"></time>),
+      local_datetime_tag(Time.utc(2025, 9, 12, 13, 42), style: :relative)
+  end
+
+  test "local_datetime_tag renders the same markup whatever the server's timezone" do
+    time = Time.utc(2025, 9, 12, 23, 30)
+
+    tokyo = Time.use_zone("Asia/Tokyo") { local_datetime_tag(time.in_time_zone) }
+    los_angeles = Time.use_zone("America/Los_Angeles") { local_datetime_tag(time.in_time_zone) }
+
+    assert_equal tokyo, los_angeles
+    assert_includes tokyo, %(datetime="2025-09-12T23:30:00Z")
+  end
+
+  test "local_datetime_tag keeps dates as calendar days" do
+    assert_dom_equal \
+      %(<time datetime="2025-09-12" data-local-time-target="time" data-local-time-style="weekday"></time>),
+      local_datetime_tag(Date.new(2025, 9, 12), style: :weekday)
+  end
+
+  test "local_datetime_tag defaults to the time style" do
+    assert_includes local_datetime_tag(Time.utc(2025, 9, 12)), %(data-local-time-style="time")
+  end
+
+  test "local_datetime_tag takes extra attributes and data" do
+    assert_dom_equal \
+      %(<time datetime="2025-09-12T13:42:00Z" class="card__timestamp" data-local-time-target="time" data-local-time-style="date" data-bridge--stamp-target="date"></time>),
+      local_datetime_tag(Time.utc(2025, 9, 12, 13, 42), style: :date, class: "card__timestamp", data: { bridge__stamp_target: "date" })
+  end
+end
diff --git a/test/integration/local_times_test.rb b/test/integration/local_times_test.rb
new file mode 100644
index 0000000..6c35f72
--- /dev/null
+++ b/test/integration/local_times_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class LocalTimesTest < ActionDispatch::IntegrationTest
+  setup do
+    travel_to Time.utc(2025, 9, 14, 4, 30)
+
+    @card = cards(:logo)
+    @card.update_columns(created_at: 2.hours.ago, last_active_at: 2.hours.ago)
+    comments(:logo_agreement_kevin).update_columns(created_at: Time.utc(2025, 9, 14, 2))
+  end
+
+  test "card pages are the same for viewers in any timezone" do
+    sign_in_as :kevin
+
+    assert_equal card_page_in("Asia/Tokyo"), card_page_in("America/Los_Angeles")
+  end
+
+  test "card pages don't depend on when they were rendered" do
+    sign_in_as :kevin
+    now = card_page_in("UTC")
+
+    travel 3.days
+    assert_equal now, card_page_in("UTC")
+  end
+
+  test "published cards are the same for viewers in any timezone" do
+    @card.board.publish
+
+    assert_equal published_card_in("Asia/Tokyo"), published_card_in("America/Los_Angeles")
+  end
+
+  private
+    def card_page_in(timezone)
+      cookies[:timezone] = timezone
+      get card_path(@card)
+      assert_response :success
+      assert_select "time[data-local-time-target]"
+
+      without_per_request_tokens css_select("main").to_html
+    end
+
+    def published_card_in(timezone)
+      cookies[:timezone] = timezone
+      get published_card_path(@card)
+      assert_response :success
+      assert_select "time[data-local-time-target]"
+
+      without_per_request_tokens response.body
+    end
+
+    def without_per_request_tokens(html)
+      html.gsub(/(name="(authenticity_token|csrf-token|csp-nonce)" (value|content)|nonce)="[^"]+"/, "")
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..68f2998
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,90 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:david)
+  end
+
+  test "times read relative to the viewer's own day" do
+    in_timezone "America/New_York" do
+      now = "2025-09-14T17:00:00Z" # Sunday, 1:00 PM in New York
+
+      assert_equal "1:42 PM",    local_time("2025-09-14T17:42:00Z", :relative, now:)
+      assert_equal "yesterday",  local_time("2025-09-14T03:30:00Z", :relative, now:) # 11:30 PM Saturday
+      assert_equal "5 days ago", local_time("2025-09-09T15:00:00Z", :relative, now:)
+      assert_equal "Sep 1",      local_time("2025-09-01T15:00:00Z", :relative, now:)
+      assert_equal "tomorrow",   local_time("2025-09-15T07:00:00Z", :in_days, now:)  # 3 AM overnight
+      assert_equal "in 3 days",  local_time("2025-09-17T15:00:00Z", :in_days, now:)
+    end
+
+    in_timezone "Asia/Tokyo" do
+      assert_equal "12:30 PM", local_time("2025-09-14T03:30:00Z", :relative, now: "2025-09-14T05:00:00Z")
+    end
+  end
+
+  test "dates read as the same day everywhere" do
+    %w[ Asia/Tokyo America/Los_Angeles ].each do |timezone|
+      in_timezone timezone do
+        assert_equal "Friday, September 12", local_time("2025-09-12", :weekday, now: "2025-09-14T12:00:00Z")
+      end
+    end
+  end
+
+  test "card times are filled in by the browser, in the viewer's timezone" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+    card.update_columns(created_at: 3.days.ago, last_active_at: card.entropy.auto_clean_period.seconds.ago + 3.days)
+    comment.update_columns(created_at: Time.utc(2025, 1, 1, 0, 30))
+
+    in_timezone "Asia/Tokyo" do
+      visit card_url(card)
+
+      within ".card-perma .card__meta" do
+        assert_text "ADDED 3 DAYS AGO"
+      end
+      assert_equal "Wednesday, January 1, 2025 at 9:30 AM", find("##{dom_id(comment)} time")["title"]
+      assert_text "Moves to “Not Now” in 3 days if there’s no activity."
+      assert_selector ".bubble", text: /closes in\s+3\s+days/i
+    end
+
+    in_timezone "America/Los_Angeles" do
+      visit card_url(card)
+      assert_equal "Tuesday, December 31, 2024 at 4:30 PM", find("##{dom_id(comment)} time")["title"]
+    end
+  end
+
+  test "times are filled in again when the page is morphed" do
+    visit card_url(cards(:layout))
+    text = first(".card-perma .card__meta time").text
+
+    page.execute_script("Turbo.session.refresh(location.href)")
+
+    assert_no_selector "time[data-local-time-target]:empty", visible: :all, wait: 5
+    assert_equal text, first(".card-perma .card__meta time").text
+  end
+
+  private
+    def in_timezone(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+      yield
+    ensure
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+    end
+
+    def local_time(datetime, style, now:)
+      page.evaluate_async_script(<<~JS, datetime, style.to_s, now)
+        const [ datetime, style, now, done ] = arguments
+
+        import("helpers/local_time_helpers").then(({ formatLocalTime }) => {
+          const time = document.createElement("time")
+          time.setAttribute("datetime", datetime)
+          time.dataset.localTimeStyle = style
+          done(formatLocalTime(time, new Date(now)).text)
+        })
+      JS
+    end
+
+    def dom_id(...)
+      ActionView::RecordIdentifier.dom_id(...)
+    end
+end
