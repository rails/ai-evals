+class AddPlainTextToActionTextRichTexts < ActiveRecord::Migration[8.2]
+  def change
+    add_column :action_text_rich_texts, :plain_text, :text, limit: 4_294_967_295 # LONGTEXT, like body
+
+    reversible do |dir|
+      dir.up { backfill_plain_text }
+    end
+  end
+
+  private
+    def backfill_plain_text
+      ActionText::RichText.reset_column_information
+
+      ActionText::RichText.where(plain_text: nil).find_each do |rich_text|
+        rich_text.update_column :plain_text, rich_text.to_plain_text
+      end
+    end
+end
