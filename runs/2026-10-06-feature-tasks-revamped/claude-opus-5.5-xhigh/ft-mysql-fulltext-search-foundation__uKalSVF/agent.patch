@@ -0,0 +1,32 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="search panel panel--wide borderless unpad flex flex-column gap center margin-block-start">
+  <%= form_with url: search_path, method: :get, role: "search", class: "search__form flex align-center gap-half" do |form| %>
+    <%= form.search_field :q, value: @search.query, class: "input full-width", autofocus: @search.terms.none?, autocomplete: "off",
+          placeholder: "Search titles, descriptions, and comments…", aria: { label: "Search cards" } %>
+
+    <%= tag.button type: :submit, class: "btn btn--circle" do %>
+      <%= icon_tag "search" %> <span class="for-screen-reader">Search</span>
+    <% end %>
+  <% end %>
+
+  <% if @search.terms.none? %>
+    <div class="blank-slate center">Find cards by what’s in their title, description, or comments</div>
+  <% elsif @page.records.none? %>
+    <div class="blank-slate center">No cards match “<%= @search.query %>”</div>
+  <% else %>
+    <div class="search__results flex flex-column gap-half">
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { search: @search, matching_comments: @matching_comments } %>
+      <% end %>
+    </div>
+  <% end %>
+</div>
