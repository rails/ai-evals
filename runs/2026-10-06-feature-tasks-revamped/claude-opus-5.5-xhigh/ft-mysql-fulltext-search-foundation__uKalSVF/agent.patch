+<%= tag.article id: dom_id(card, :search_result), class: "search__result" do %>
+  <div class="search__result-meta flex align-center gap-half txt-x-small txt-subtle">
+    <span class="overflow-ellipsis"><%= card.board.name %></span>
+    <span>#<%= card.number %></span>
+    <% if card.closed? %>
+      <span>Done</span>
+    <% elsif card.postponed? %>
+      <span>Not now</span>
+    <% end %>
+    <%= local_datetime_tag card.created_at, style: :shortdate, class: "flex-item-justify-end" %>
+  </div>
+
+  <h2 class="search__result-title txt-medium margin-none">
+    <%= link_to search_highlight(card.title, search), card, class: "search__result-link" %>
+  </h2>
+
+  <% if excerpt = search_excerpt(card.description.searchable_text, search) %>
+    <p class="search__excerpt txt-small margin-none"><%= excerpt %></p>
+  <% end %>
+
+  <% if (comment = matching_comments[card.id]) && (excerpt = search_excerpt(comment.body.searchable_text, search)) %>
+    <%= link_to card_path(card, anchor: dom_id(comment)), class: "search__excerpt search__excerpt--comment txt-small" do %>
+      <strong><%= comment.creator.name %>:</strong> <%= excerpt %>
+    <% end %>
+  <% end %>
+<% end %>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
