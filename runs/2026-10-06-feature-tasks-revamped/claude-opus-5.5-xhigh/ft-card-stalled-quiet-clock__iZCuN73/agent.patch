diff --git a/test/system/stalled_cards_test.rb b/test/system/stalled_cards_test.rb
new file mode 100644
index 0000000..51887a8
--- /dev/null
+++ b/test/system/stalled_cards_test.rb
@@ -0,0 +1,55 @@
+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "stalled cards say so in their bubble" do
+    card = stall cards(:text), for: 20.days
+
+    visit card_url(card)
+    within "##{dom_id(card, :bubble)}" do
+      assert_selector "[data-bubble-target=top]", text: /stalled for/i
+      assert_selector ".bubble__number", text: "20"
+    end
+  end
+
+  test "stalled cards say so in their bubble on the board" do
+    triaged = stall cards(:text), for: 20.days
+    awaiting_triage = stall cards(:buy_domain), for: 15.days
+
+    visit board_url(boards(:writebook))
+    within "##{dom_id(awaiting_triage, :bubble)}" do
+      assert_selector "[data-bubble-target=top]", text: /stalled for/i
+      assert_selector ".bubble__number", text: "15"
+    end
+
+    # Collapsed columns surface the bubbles of their cards on the column instead
+    assert_selector "##{dom_id(triaged, :bubble)}:not([hidden])", visible: :all
+  end
+
+  test "cards that had a burst but are not stalled yet hide their bubble" do
+    card = stall cards(:text), for: 13.days
+
+    visit card_url(card)
+    assert_selector "##{dom_id(card, :bubble)}[hidden]", visible: :hidden
+  end
+
+  test "closing soon takes precedence over stalled" do
+    card = stall cards(:text), for: 80.days # Its board auto-closes after 90 days
+
+    visit card_url(card)
+    within "##{dom_id(card, :bubble)}" do
+      assert_selector "[data-bubble-target=top]", text: /closes in/i
+      assert_selector ".bubble__number", text: "10"
+    end
+  end
+
+  private
+    def stall(card, for:)
+      Current.set(session: sessions(:david)) { card.toggle_assignment(users(:jz)) }
+      card.update! last_active_at: binding.local_variable_get(:for).ago
+      card
+    end
+end
