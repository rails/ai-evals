diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..7b3b713
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,233 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    freeze_time
+
+    @card = cards(:text) # Its board auto-closes after 90 days, so bursts span 30 days
+  end
+
+  test "three comments from two people within a third of the auto close period are a burst" do
+    comment_on @card, by: :david
+    travel 10.days
+    comment_on @card, by: :kevin
+    travel 19.days
+    comment_on @card, by: :david
+
+    assert @card.burst.present?
+  end
+
+  test "comments from a single person are not a burst" do
+    3.times { comment_on @card, by: :david }
+
+    assert_nil @card.burst
+  end
+
+  test "fewer than three comments are not a burst" do
+    comment_on @card, by: :david
+    comment_on @card, by: :kevin
+
+    assert_nil @card.burst
+  end
+
+  test "comments spread over more than a third of the auto close period are not a burst" do
+    comment_on @card, by: :david
+    travel 15.days
+    comment_on @card, by: :kevin
+    travel 16.days
+    comment_on @card, by: :david
+
+    assert_nil @card.burst
+  end
+
+  test "the burst window follows the board auto close period" do
+    entropies(:writebook_board).update! auto_postpone_period: 30.days
+
+    comment_on @card, by: :david
+    travel 6.days
+    comment_on @card, by: :kevin
+    travel 6.days
+    comment_on @card, by: :david
+
+    assert_nil @card.burst, "12 days is more than a third of 30 days"
+
+    travel 1.day
+    comment_on @card, by: :kevin
+
+    assert @card.burst.present?, "the last three comments landed within 10 days"
+  end
+
+  test "system comments do not count towards a burst" do
+    comment_on @card, by: :david
+    @card.comments.create!(body: "Automated", creator: users(:system))
+    comment_on @card, by: :kevin
+
+    assert_nil @card.burst
+  end
+
+  test "assigning someone is a burst" do
+    @card.toggle_assignment(users(:kevin))
+
+    assert @card.burst.present?
+  end
+
+  test "unassigning someone is not a burst" do
+    @card.toggle_assignment(users(:kevin))
+    @card.burst.destroy!
+    @card.reload
+
+    @card.toggle_assignment(users(:kevin))
+
+    assert_nil @card.burst
+  end
+
+  test "reopening a card is a burst" do
+    card = cards(:shipping)
+    card.reopen
+
+    assert card.burst.present?
+  end
+
+  test "closing a card is not a burst" do
+    @card.close
+
+    assert_nil @card.burst
+  end
+
+  test "a card stalls two weeks after its burst" do
+    @card.toggle_assignment(users(:kevin))
+
+    travel 14.days - 1.second
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 1.second
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "a card without a burst does not stall" do
+    @card.update! last_active_at: 3.weeks.ago
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity after a burst postpones stalling" do
+    @card.toggle_assignment(users(:kevin))
+
+    travel 10.days
+    with_current_user(:kevin) { @card.reactions.create!(content: "👍") }
+
+    travel 10.days
+    assert_not @card.stalled?
+
+    travel 4.days
+    assert @card.stalled?
+  end
+
+  test "any activity on a stalled card resets it" do
+    @card.toggle_assignment(users(:kevin))
+    travel 15.days
+    assert @card.stalled?
+
+    with_current_user(:kevin) { @card.reactions.create!(content: "👍") }
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+    assert_nil @card.reload.burst
+
+    travel 15.days
+    assert_not @card.stalled?, "it takes a new burst to stall again"
+  end
+
+  test "a burst on a stalled card starts a new stall" do
+    @card.toggle_assignment(users(:kevin))
+    travel 15.days
+
+    @card.toggle_assignment(users(:jz))
+    assert_not @card.stalled?
+
+    travel 14.days
+    assert @card.stalled?
+  end
+
+  test "stalled cards are reset by comments" do
+    @card.toggle_assignment(users(:kevin))
+    travel 15.days
+
+    comment_on @card, by: :david
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "postponed cards are not stalled" do
+    @card.toggle_assignment(users(:kevin))
+    @card.postpone
+    travel 15.days
+
+    assert @card.burst.present?
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "closed cards are not stalled" do
+    @card.toggle_assignment(users(:kevin))
+    @card.close
+    travel 15.days
+
+    assert @card.burst.present?
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "stalls_at is when an active card with a burst stalls" do
+    assert_nil @card.stalls_at
+
+    @card.toggle_assignment(users(:kevin))
+    assert_equal 14.days.from_now, @card.stalls_at
+
+    @card.close
+    assert_nil @card.stalls_at
+  end
+
+  test "stalled index" do
+    @card.toggle_assignment(users(:kevin))
+    travel 15.days
+
+    assert_equal [ @card ], Card.indexed_by("stalled").to_a
+  end
+
+  test "touch newly stalled touches cards once they stall" do
+    @card.toggle_assignment(users(:kevin))
+    cards(:buy_domain).toggle_assignment(users(:kevin))
+
+    travel 1.week
+    assert_no_changes -> { @card.reload.updated_at } do
+      Card.touch_newly_stalled
+    end
+
+    travel 1.week + 1.hour
+    cards(:buy_domain).touch
+
+    assert_changes -> { @card.reload.updated_at }, to: Time.current do
+      assert_no_changes -> { cards(:buy_domain).reload.updated_at } do
+        Card.touch_newly_stalled
+      end
+    end
+
+    travel 1.hour
+    assert_no_changes -> { @card.reload.updated_at } do
+      Card.touch_newly_stalled
+    end
+
+    assert @card.stalled?
+    assert cards(:buy_domain).stalled?
+  end
+
+  private
+    def comment_on(card, by:)
+      with_current_user(by) { card.comments.create!(body: "Comment by #{by}") }
+    end
+end
