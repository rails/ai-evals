diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..9348728
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,199 @@
+# Reads ZIP archives of any size from an IO-like object that responds to
+# +read+, +seek+, +tell+ and +size+ (a File, or a ZipFile::RemoteIO for S3).
+#
+# Archives can hold millions of entries, so the central directory is kept in a
+# compact form: for each directory, the entry names are stored in a single
+# string, and their offsets and sizes are packed in another one. Contents are
+# only read on demand, and always streamed.
+class ZipFile::Reader
+  class InvalidArchive < StandardError; end
+  class EntryNotFound < StandardError; end
+  class EntryTooLarge < StandardError; end
+
+  # Large enough for any record, small enough to keep ZIP bombs at bay.
+  MAX_READ_SIZE = 128.megabytes
+  CHUNK_SIZE = 1.megabyte
+
+  Entry = Struct.new(:path, :local_header_offset, :compressed_size, :size, :storage_mode)
+
+  # When set, paths are relative to this folder in the archive, e.g. "export/"
+  attr_accessor :root
+
+  def initialize(io)
+    @io = io
+    @root = ""
+  end
+
+  def exists?(path)
+    find_entry(path).present?
+  end
+
+  # Matches entries like ZipFile::Writer#glob does, returning their sorted paths.
+  def glob(pattern)
+    each_entry(pattern).map(&:path).sort
+  end
+
+  # Yields the entries matching the pattern in the order they appear in the archive.
+  def each_entry(pattern = "*")
+    return enum_for(:each_entry, pattern) unless block_given?
+
+    pattern = "#{root}#{pattern}"
+    literal_prefix = pattern[/\A[^*?\[{\\]*/]
+
+    directories.each_value do |directory|
+      if directory.may_contain?(literal_prefix)
+        directory.each_entry do |entry|
+          yield relative(entry) if File.fnmatch(pattern, entry.path)
+        end
+      end
+    end
+  end
+
+  # Returns the full contents of the entry, or streams them in chunks when given a block.
+  def read(path_or_entry, max_size: MAX_READ_SIZE)
+    entry = entry_for(path_or_entry)
+
+    if block_given?
+      open(entry) { |io| io.each_chunk { |chunk| yield chunk } }
+    elsif entry.size > max_size
+      raise EntryTooLarge, "#{entry.path} is too large (#{entry.size} bytes)"
+    else
+      open(entry) { |io| io.read }
+    end
+  end
+
+  # Yields an IO-like object (responding to +read+, +size+ and +rewind+) with the entry contents.
+  def open(path_or_entry)
+    yield EntryIO.new(self, entry_for(path_or_entry))
+  end
+
+  def extractor_for(entry) # :nodoc:
+    @io.seek(data_offset_for(entry), IO::SEEK_SET)
+    parser.extractor_for(@io, entry)
+  end
+
+  private
+    def entry_for(path_or_entry)
+      if path_or_entry.is_a?(Entry)
+        path_or_entry
+      else
+        find_entry(path_or_entry) || raise(EntryNotFound, "#{path_or_entry} not found in archive")
+      end
+    end
+
+    def find_entry(path)
+      directory_path, _, name = "#{root}#{path}".rpartition("/")
+
+      if entry = directories[directory_path]&.find(name)
+        relative(entry)
+      end
+    end
+
+    def relative(entry)
+      entry.tap { entry.path = entry.path.delete_prefix(root) }
+    end
+
+    def directories
+      @directories ||= {}.tap do |directories|
+        parser.each_entry(@io) do |zip_entry|
+          path = zip_entry.filename.dup.force_encoding(Encoding::UTF_8)
+
+          if path.valid_encoding? && !path.end_with?("/") && !path.include?("\n")
+            directory_path, _, name = path.rpartition("/")
+            directory = directories[directory_path] ||= Directory.new(directory_path)
+            directory.add(name, zip_entry)
+          end
+        end
+      end
+    end
+
+    # The data of an entry starts right after its local header, whose length
+    # depends on the filename and extra fields it contains.
+    def data_offset_for(entry)
+      @io.seek(entry.local_header_offset, IO::SEEK_SET)
+      header = @io.read(Parser::LOCAL_HEADER_SIZE)
+
+      if header.nil? || header.bytesize < Parser::LOCAL_HEADER_SIZE || header.unpack1("V") != Parser::LOCAL_HEADER_SIGNATURE
+        raise InvalidArchive, "#{entry.path} has an invalid local header"
+      end
+
+      filename_length, extra_length = header.byteslice(26, 4).unpack("vv")
+      entry.local_header_offset + Parser::LOCAL_HEADER_SIZE + filename_length + extra_length
+    end
+
+    def parser
+      @parser ||= Parser.new
+    end
+
+    class Directory
+      INFO_FORMAT = "Q<Q<Q<S<".freeze # local header offset, compressed size, uncompressed size, storage mode
+      INFO_SIZE = 26
+
+      def initialize(path)
+        @path = path
+        @path_prefix = path.empty? ? "" : "#{path}/"
+        @names = +""
+        @info = "".b
+      end
+
+      def add(name, zip_entry)
+        @names << name << "\n"
+        @info << [ zip_entry.local_file_header_offset, zip_entry.compressed_size, zip_entry.uncompressed_size, zip_entry.storage_mode ].pack(INFO_FORMAT)
+      end
+
+      def may_contain?(literal_prefix)
+        @path_prefix.start_with?(literal_prefix) || literal_prefix.start_with?(@path_prefix)
+      end
+
+      def each_entry
+        @names.each_line(chomp: true).with_index do |name, index|
+          yield entry_at(index, name)
+        end
+      end
+
+      def find(name)
+        if @names.start_with?("#{name}\n")
+          entry_at(0, name)
+        elsif position = @names.index("\n#{name}\n")
+          entry_at(@names.byteslice(0, position + 1).count("\n"), name)
+        end
+      end
+
+      private
+        def entry_at(index, name)
+          Entry.new("#{@path_prefix}#{name}", *@info.byteslice(index * INFO_SIZE, INFO_SIZE).unpack(INFO_FORMAT))
+        end
+    end
+
+    # Streams the central directory entries one by one, so that we never hold
+    # the whole list of entries as objects in memory.
+    class Parser < ZipKit::FileReader
+      LOCAL_HEADER_SIGNATURE = 0x04034b50
+      LOCAL_HEADER_SIZE = 30
+
+      def each_entry(io)
+        eocd_offset = get_eocd_offset(io, io.size)
+        zip64_end_of_cdir_location = get_zip64_eocd_location(io, eocd_offset)
+
+        entries_count, central_directory_offset, _ = if zip64_end_of_cdir_location
+          num_files_and_central_directory_offset_zip64(io, zip64_end_of_cdir_location)
+        else
+          num_files_and_central_directory_offset(io, eocd_offset)
+        end
+
+        seek(io, central_directory_offset)
+        entries_count.times { yield read_cdir_entry(io) }
+      rescue ReadError, UnsupportedFeature, MissingEOCD, RangeError, ArgumentError => error
+        raise InvalidArchive, "Not a valid ZIP file (#{error.message})"
+      end
+
+      def extractor_for(io, entry)
+        case entry.storage_mode
+        when 0 then StoredReader.new(io, entry.compressed_size)
+        when 8 then InflatingReader.new(io, entry.compressed_size)
+        else
+          raise InvalidArchive, "#{entry.path} uses an unsupported compression method"
+        end
+      end
+    end
+end
diff --git a/app/models/zip_file/reader/entry_io.rb b/app/models/zip_file/reader/entry_io.rb
new file mode 100644
index 0000000..b56a4e5
--- /dev/null
+++ b/app/models/zip_file/reader/entry_io.rb
@@ -0,0 +1,95 @@
+# A read-only IO for the contents of a ZIP entry, decompressing them on the fly.
+class ZipFile::Reader::EntryIO
+  attr_reader :size
+
+  def initialize(reader, entry)
+    @reader = reader
+    @entry = entry
+    @size = entry.size
+    rewind
+  end
+
+  def read(length = nil, outbuf = nil)
+    data = length.nil? ? read_all : read_partial(length)
+
+    if outbuf
+      outbuf.replace(data || "")
+      data && outbuf
+    else
+      data
+    end
+  end
+
+  def each_chunk
+    unless @buffer.empty?
+      yield @buffer.slice!(0..)
+    end
+
+    while chunk = next_chunk
+      yield chunk
+    end
+  end
+
+  def rewind
+    @extractor = nil
+    @buffer = "".b
+    @produced = 0
+    @finished = false
+    0
+  end
+
+  def eof?
+    fill_buffer(1)
+    @buffer.empty?
+  end
+
+  def close
+  end
+
+  private
+    def read_all
+      "".b.tap do |data|
+        each_chunk { |chunk| data << chunk }
+      end
+    end
+
+    def read_partial(length)
+      if length.zero?
+        "".b
+      else
+        fill_buffer(length)
+        @buffer.slice!(0, length) unless @buffer.empty?
+      end
+    end
+
+    def fill_buffer(length)
+      while @buffer.bytesize < length && (chunk = next_chunk)
+        @buffer << chunk
+      end
+    end
+
+    def next_chunk
+      until @finished
+        chunk = extractor.extract(ZipFile::Reader::CHUNK_SIZE)
+
+        if chunk.nil?
+          finish
+        elsif !chunk.empty?
+          @produced += chunk.bytesize
+          raise ZipFile::Reader::InvalidArchive, "#{@entry.path} is larger than declared" if @produced > size
+          return chunk
+        end
+      end
+    rescue Zlib::Error => error
+      raise ZipFile::Reader::InvalidArchive, "#{@entry.path} can't be decompressed (#{error.message})"
+    end
+
+    def finish
+      @finished = true
+      raise ZipFile::Reader::InvalidArchive, "#{@entry.path} is truncated" if @produced != size
+    end
+
+    def extractor
+      @extractor ||= @reader.extractor_for(@entry)
+    end
+end
diff --git a/app/models/zip_file/remote_io.rb b/app/models/zip_file/remote_io.rb
new file mode 100644
index 0000000..858e88f
--- /dev/null
+++ b/app/models/zip_file/remote_io.rb
@@ -0,0 +1,63 @@
+# An IO-like object to read a blob stored in a remote service (S3) with ranged
+# requests, so that archives can be read without downloading them first.
+#
+# Reads are served from a read-ahead buffer, which keeps the number of requests
+# low when reading many small entries stored next to each other.
+class ZipFile::RemoteIO
+  BUFFER_SIZE = 8.megabytes
+
+  attr_reader :size
+
+  def initialize(blob)
+    @blob = blob
+    @size = blob.byte_size
+    @pos = 0
+    @buffer = "".b
+    @buffer_offset = 0
+  end
+
+  def seek(offset, whence = IO::SEEK_SET)
+    raise ArgumentError, "Unsupported seek mode" unless whence == IO::SEEK_SET
+
+    @pos = offset.clamp(0, size)
+    0
+  end
+
+  def tell
+    @pos
+  end
+  alias_method :pos, :tell
+
+  def read(length = nil, outbuf = nil)
+    length ||= size - @pos
+
+    data = if length.zero?
+      "".b
+    elsif @pos < size
+      read_at(@pos, [ length, size - @pos ].min).tap { |chunk| @pos += chunk.bytesize }
+    end
+
+    outbuf ? (data && outbuf.replace(data)) : data
+  end
+
+  private
+    def read_at(offset, length)
+      if buffered?(offset, length)
+        @buffer.byteslice(offset - @buffer_offset, length)
+      elsif length >= BUFFER_SIZE
+        download(offset, length)
+      else
+        @buffer = download(offset, [ BUFFER_SIZE, size - offset ].min)
+        @buffer_offset = offset
+        @buffer.byteslice(0, length)
+      end
+    end
+
+    def buffered?(offset, length)
+      offset >= @buffer_offset && offset + length <= @buffer_offset + @buffer.bytesize
+    end
+
+    def download(offset, length)
+      @blob.service.download_chunk(@blob.key, offset...(offset + length)).b
+    end
+end
