diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
new file mode 100644
index 0000000..4bda717
--- /dev/null
+++ b/test/models/account/export_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @export = Account::Export.create!(account: @account, user: users(:kevin))
+  end
+
+  test "exports every record of the account" do
+    @export.build
+
+    read_export do |zip|
+      account = JSON.parse(zip.read("data/account.json"))
+      assert_equal @account.name, account["name"]
+      assert_equal @account.join_code.code, account.dig("join_code", "code")
+
+      assert_equal @account.boards.ids.sort, ids_in(zip, "boards")
+      assert_equal @account.cards.ids.sort, ids_in(zip, "cards")
+      assert_equal Comment.where(account: @account).ids.sort, ids_in(zip, "comments")
+      assert_equal @account.users.ids.sort, ids_in(zip, "users")
+      assert_equal Event.where(account: @account).ids.sort, ids_in(zip, "events")
+
+      card = JSON.parse(zip.read("data/cards/#{cards(:logo).id}.json"))
+      assert_equal cards(:logo).title, card["title"]
+      assert_equal cards(:logo).number, card["number"]
+    end
+  end
+
+  test "doesn't export records of other accounts" do
+    @export.build
+
+    read_export do |zip|
+      assert_not zip.exists?("data/users/#{users(:mike).id}.json")
+      assert_empty Board.where(id: ids_in(zip, "boards")).where.not(account: @account)
+    end
+  end
+
+  test "exports people with their email addresses" do
+    @export.build
+
+    read_export do |zip|
+      user = JSON.parse(zip.read("data/users/#{users(:david).id}.json"))
+      assert_equal "david@37signals.com", user["email_address"]
+      assert_not user.key?("identity_id")
+    end
+  end
+
+  test "exports stored files along with their blobs" do
+    with_current_user(:david) do
+      cards(:logo).image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    end
+    blob = cards(:logo).image.blob
+
+    @export.build
+
+    read_export do |zip|
+      assert zip.exists?("data/active_storage_blobs/#{blob.id}.json")
+      assert_equal file_fixture("moon.jpg").binread, zip.read("storage/#{blob.key}")
+    end
+  end
+
+  test "doesn't export earlier exports" do
+    earlier = Account::Export.create!(account: @account, user: users(:kevin))
+    earlier.build
+
+    @export.build
+
+    read_export do |zip|
+      assert_not zip.exists?("storage/#{earlier.file.blob.key}")
+      assert_not zip.exists?("data/active_storage_blobs/#{earlier.file.blob.id}.json")
+      assert_not zip.exists?("data/active_storage_attachments/#{earlier.file.attachment.id}.json")
+    end
+  end
+
+  test "exports references to embedded files and mentions as global ids" do
+    blob = nil
+
+    with_current_user(:david) do
+      blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      cards(:logo).update! description: "<p>Look #{ActionText::Attachment.from_attachable(blob).to_html} #{ActionText::Attachment.from_attachable(users(:kevin)).to_html}</p>"
+    end
+
+    @export.build
+
+    read_export do |zip|
+      rich_text = JSON.parse(zip.read("data/action_text_rich_texts/#{cards(:logo).description.id}.json"))
+
+      assert_includes rich_text["body"], %(gid="#{blob.to_global_id}")
+      assert_includes rich_text["body"], %(gid="#{users(:kevin).to_global_id}")
+      assert_not_includes rich_text["body"], "sgid="
+    end
+  end
+
+  private
+    def read_export(&block)
+      ZipFile.read_from(@export.reload.file.blob, &block)
+    end
+
+    def ids_in(zip, table)
+      zip.glob("data/#{table}/*.json").map { |path| File.basename(path, ".json") }.sort
+    end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
