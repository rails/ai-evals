diff --git a/lib/tasks/accounts.rake b/lib/tasks/accounts.rake
new file mode 100644
index 0000000..f0ccba8
--- /dev/null
+++ b/lib/tasks/accounts.rake
@@ -0,0 +1,14 @@
+namespace :accounts do
+  desc "Import an account export into a new account owned by the given person, e.g. bin/rails \"accounts:import[export.zip,you@example.com]\""
+  task :import, %i[ path email_address ] => :environment do |_, args|
+    path = args.fetch(:path)
+    identity = Identity.find_or_create_by!(email_address: args.fetch(:email_address))
+
+    import = File.open(path, "rb") do |file|
+      Account::Import.start(identity: identity, file: { io: file, filename: File.basename(path), content_type: "application/zip" })
+    end
+
+    puts "Importing #{path} into a new account (import #{import.id})."
+    puts "#{identity.email_address} will get an email when it's done."
+  end
+end
diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..267facf
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admins can export the account" do
+    assert_difference -> { Account::Export.count }, 1 do
+      assert_enqueued_with job: Export::BuildJob do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    export = Account::Export.last
+    assert_equal users(:kevin), export.user
+    assert_equal accounts("37s"), export.account
+    assert export.pending?
+  end
+
+  test "members can't export the account" do
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "doesn't start another export while one is in progress" do
+    post account_exports_path
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_redirected_to account_settings_path
+  end
+
+  test "exports are limited per day" do
+    Export::DAILY_LIMIT.times { Account::Export.create!(account: accounts("37s"), user: users(:kevin), status: :completed) }
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_redirected_to account_settings_path
+    assert_match "limit", flash[:alert]
+  end
+
+  test "download a completed export" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    get account_export_path(export)
+
+    assert_response :success
+    assert_select "a#download-link[href*='rails/active_storage']"
+  end
+
+  test "show an export in progress" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+
+    get account_export_path(export)
+
+    assert_response :success
+    assert_select "h2", text: /on its way/
+    assert_select "a#download-link", count: 0
+  end
+
+  test "expired exports can't be downloaded" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    travel 2.days do
+      get account_export_path(export)
+    end
+
+    assert_response :success
+    assert_select "h2", text: /expired/
+    assert_select "a#download-link", count: 0
+  end
+
+  test "only the admin who asked for an export can see it" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    logout_and_sign_in_as :jason
+
+    get account_export_path(export)
+    assert_response :not_found
+  end
+
+  test "the export file can only be downloaded by the admin who asked for it" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :redirect
+
+    logout_and_sign_in_as :jason
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :forbidden
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..7fff876
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+  end
+
+  test "new" do
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :success
+    assert_select "input[type=file][name='account_import[file]']"
+  end
+
+  test "requires signing in" do
+    sign_out
+
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :redirect
+    assert_match %r{/session/new}, response.location
+  end
+
+  test "is only available outside of accounts" do
+    logout_and_sign_in_as :kevin
+
+    get new_account_import_path
+
+    assert_redirected_to root_url
+  end
+
+  test "create starts an import into a new account" do
+    assert_difference -> { Account.count }, 1 do
+      assert_difference -> { Account::Import.count }, 1 do
+        assert_enqueued_with job: Account::ImportJob do
+          untenanted do
+            post account_imports_path, params: { account_import: { file: export_file } }
+          end
+        end
+      end
+    end
+
+    import = Account::Import.last
+    assert_redirected_to account_import_path(import, script_name: "")
+    assert_equal identities(:mike), import.identity
+    assert import.file.attached?
+    assert import.pending?
+  end
+
+  test "create rejects files that aren't ZIP archives" do
+    assert_no_difference -> { Account.count + Account::Import.count } do
+      untenanted do
+        post account_imports_path, params: { account_import: { file: fixture_file_upload("moon.jpg", "image/jpeg") } }
+      end
+    end
+
+    assert_redirected_to new_account_import_path(script_name: "")
+    assert flash[:alert].present?
+  end
+
+  test "create requires a file" do
+    assert_no_difference -> { Account::Import.count } do
+      untenanted do
+        post account_imports_path, params: { account_import: { file: "" } }
+      end
+    end
+
+    assert_redirected_to new_account_import_path(script_name: "")
+  end
+
+  test "can't import when this Fizzy doesn't accept new accounts" do
+    with_multi_tenant_mode(false) do
+      assert_no_difference -> { Account::Import.count } do
+        untenanted do
+          post account_imports_path, params: { account_import: { file: export_file } }
+        end
+      end
+    end
+
+    assert_redirected_to session_menu_path(script_name: nil)
+  end
+
+  test "show an import in progress" do
+    import = Account::Import.start(identity: identities(:mike), file: export_file)
+
+    untenanted do
+      get account_import_path(import)
+    end
+
+    assert_response :success
+    assert_select "h1", text: /Importing/
+  end
+
+  test "show a failed import with the reason" do
+    import = Account::Import.start(identity: identities(:mike), file: export_file)
+    import.fail Account::DataTransfer::IntegrityError.new("The file is broken")
+
+    untenanted do
+      get account_import_path(import)
+    end
+
+    assert_response :success
+    assert_select "h1", text: /failed/
+    assert_select "p", text: "The file is broken."
+  end
+
+  test "can't see the imports of someone else" do
+    import = Account::Import.start(identity: identities(:kevin), file: export_file)
+
+    untenanted do
+      get account_import_path(import)
+    end
+
+    assert_response :not_found
+  end
+
+  private
+    def export_file
+      io = StringIO.new("".b)
+      writer = ZipFile::Writer.new(io)
+      writer.add_file "data/account.json", { name: "Imported" }.to_json
+      writer.close
+
+      Rack::Test::UploadedFile.new(StringIO.new(io.string), "application/zip", true, original_filename: "export.zip")
+    end
+end
