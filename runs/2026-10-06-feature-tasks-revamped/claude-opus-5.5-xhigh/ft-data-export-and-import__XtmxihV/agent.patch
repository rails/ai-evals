+require "test_helper"
+require "rake"
+
+class AccountsRakeTest < ActiveSupport::TestCase
+  setup do
+    Rails.application.load_tasks unless Rake::Task.task_defined?("accounts:import")
+    Rake::Task["accounts:import"].reenable
+    Current.reset
+  end
+
+  test "import starts importing a file into a new account" do
+    path = Rails.root.join("tmp", "accounts_rake_test_#{SecureRandom.hex(4)}.zip")
+    File.binwrite(path, archive)
+
+    assert_difference -> { Account::Import.count }, 1 do
+      assert_enqueued_with job: Account::ImportJob do
+        assert_output(/Importing/) do
+          Rake::Task["accounts:import"].invoke(path.to_s, "newcomer@example.com")
+        end
+      end
+    end
+
+    import = Account::Import.last
+    assert_equal "newcomer@example.com", import.identity.email_address
+    assert import.file.attached?
+  ensure
+    FileUtils.rm_f(path)
+  end
+
+  private
+    def archive
+      io = StringIO.new("".b)
+      writer = ZipFile::Writer.new(io)
+      writer.add_file "data/account.json", { name: "Imported" }.to_json
+      writer.close
+      io.string
+    end
+end
