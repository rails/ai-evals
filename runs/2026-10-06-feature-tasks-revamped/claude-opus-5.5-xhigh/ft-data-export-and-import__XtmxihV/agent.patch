+class Account::DataTransfer::EventRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account)
+    super(account: account, model: Event)
+  end
+
+  private
+    # Assignment events mention the assignees in their particulars
+    def referenced_ids(rows)
+      super.tap do |referenced|
+        rows.each do |row|
+          assignee_ids = row["particulars"].is_a?(Hash) ? Array(row["particulars"]["assignee_ids"]) : []
+
+          assignee_ids.each do |assignee_id|
+            if valid_id?(assignee_id)
+              referenced[User] << assignee_id
+            else
+              raise Account::DataTransfer::IntegrityError, "Some events reference invalid assignees"
+            end
+          end
+        end
+      end
+    end
+end
