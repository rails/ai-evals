diff --git a/app/models/card/exportable.rb b/app/models/card/exportable.rb
new file mode 100644
index 0000000..9d9b258
--- /dev/null
+++ b/app/models/card/exportable.rb
@@ -0,0 +1,125 @@
+# Writes a card into a ZIP archive as "<number>.json", including its comments,
+# with the image and every file attached to the card or its comments stored
+# under "<number>/".
+module Card::Exportable
+  extend ActiveSupport::Concern
+
+  def export_to(zip)
+    files = Card::Exportable::Files.new(self, zip: zip)
+    zip.add_file "#{number}.json", JSON.pretty_generate(export_data(files))
+    files.write
+  end
+
+  private
+    def export_data(files)
+      {
+        id: id,
+        number: number,
+        title: title,
+        url: export_url,
+        board: { id: board.id, name: board.name },
+        column: column&.name,
+        status: status,
+        stage: export_stage,
+        golden: golden?,
+        due_on: due_on,
+        creator: export_user(creator),
+        assignees: assignees.map { |assignee| export_user(assignee) },
+        tags: tags.map(&:title).sort,
+        steps: steps.map { |step| { content: step.content, completed: step.completed } },
+        description: export_rich_text(description, files),
+        image: (files.add(image.blob) if image.attached?),
+        attachments: export_attachments(description, files),
+        closed_at: closed_at,
+        closed_by: (export_user(closed_by) if closed_by),
+        created_at: created_at,
+        updated_at: updated_at,
+        last_active_at: last_active_at,
+        comments: comments.chronologically.includes(:creator, rich_text_body: { embeds_attachments: :blob }).map { |comment| export_comment(comment, files) }
+      }
+    end
+
+    def export_comment(comment, files)
+      {
+        id: comment.id,
+        creator: export_user(comment.creator),
+        body: export_rich_text(comment.body, files),
+        attachments: export_attachments(comment.body, files),
+        created_at: comment.created_at,
+        updated_at: comment.updated_at
+      }
+    end
+
+    def export_stage
+      if drafted?
+        "draft"
+      elsif closed?
+        "done"
+      elsif postponed?
+        "not_now"
+      elsif column
+        "in_column"
+      else
+        "maybe"
+      end
+    end
+
+    def export_user(user)
+      { id: user.id, name: user.name, email_address: user.identity&.email_address }
+    end
+
+    def export_rich_text(rich_text, files)
+      if rich_text&.body.present?
+        { plain_text: rich_text.to_plain_text, html: export_html(rich_text.body, files) }
+      else
+        { plain_text: "", html: "" }
+      end
+    end
+
+    # Rewrites the attachments in the rich text so that they point to the files stored in the archive.
+    def export_html(content, files)
+      content.render_attachments do |attachment|
+        case attachable = attachment.attachable
+        when ActiveStorage::Blob
+          if path = files.add(attachable)
+            export_file_html(attachable, path, caption: attachment.caption)
+          else
+            ERB::Util.html_escape("[#{attachment.caption.presence || attachable.filename}]")
+          end
+        when ActionText::Attachables::RemoteImage, ActionText::Attachables::RemoteVideo
+          ERB::Util.html_escape(attachable.url.to_s)
+        else
+          ERB::Util.html_escape(attachment.to_plain_text)
+        end
+      end.to_html
+    end
+
+    def export_file_html(blob, path, caption:)
+      if blob.image?
+        %(<img src="#{ERB::Util.html_escape(path)}" alt="#{ERB::Util.html_escape(caption.presence || blob.filename.to_s)}">)
+      else
+        %(<a href="#{ERB::Util.html_escape(path)}">#{ERB::Util.html_escape(caption.presence || blob.filename.to_s)}</a>)
+      end
+    end
+
+    def export_attachments(rich_text, files)
+      Array(rich_text&.embeds).filter_map do |attachment|
+        if path = files.add(attachment.blob)
+          {
+            filename: attachment.blob.filename.to_s,
+            content_type: attachment.blob.content_type,
+            byte_size: attachment.blob.byte_size,
+            path: path
+          }
+        end
+      end.uniq
+    end
+
+    def export_url
+      options = ActionMailer::Base.default_url_options
+
+      if options[:host].present?
+        Rails.application.routes.url_helpers.card_url(self, **options, script_name: account.slug)
+      end
+    end
+end
diff --git a/app/models/card/exportable/files.rb b/app/models/card/exportable/files.rb
new file mode 100644
index 0000000..43f29ec
--- /dev/null
+++ b/app/models/card/exportable/files.rb
@@ -0,0 +1,44 @@
+# Tracks the files attached to a card as it gets exported, assigning each one
+# a unique path in the archive, and writes them all once the card is written.
+class Card::Exportable::Files
+  def initialize(card, zip:)
+    @card = card
+    @zip = zip
+    @paths = {}
+    @blobs = {}
+  end
+
+  # Returns the path where the blob will be stored, or nil when its file is missing.
+  def add(blob)
+    @paths[blob.id] ||= begin
+      if blob.service.exist?(blob.key)
+        @blobs[blob.id] = blob
+        unique_path_for(blob)
+      end
+    end
+  end
+
+  def write
+    @blobs.each do |id, blob|
+      @zip.add_file(@paths[id], compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+    end
+  end
+
+  private
+    def unique_path_for(blob)
+      filename = blob.filename.sanitized.presence || "file"
+      basename, extension = File.basename(filename, ".*"), File.extname(filename)
+
+      path = "#{@card.number}/#{filename}"
+      counter = 1
+
+      while @paths.value?(path) || @zip.exists?(path)
+        counter += 1
+        path = "#{@card.number}/#{basename} (#{counter})#{extension}"
+      end
+
+      path
+    end
+end
