+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper, ActiveJob::Continuation::TestHelper
+
+  setup do
+    @source = accounts("37s")
+  end
+
+  test "imports an exported account into a new account" do
+    blob = attach_files_to_cards
+    expected = snapshot_of(@source)
+    archive = export_and_remove(@source)
+
+    import = import_archive(archive, identity: identities(:kevin))
+
+    assert import.completed?, import.failure_reason
+    assert import.completed_at.present?
+    account = import.account
+
+    assert_equal "37signals", account.name
+    assert_not_equal @source.id, account.id
+    assert_equal expected, snapshot_of(account)
+    assert_equal 5, account.cards_count
+
+    card = account.cards.find_by!(number: cards(:logo).number)
+    assert_equal cards(:logo).id, card.id
+    assert_equal file_fixture("moon.jpg").binread, card.image.download
+    assert_equal [ blob.id ], card.description.body.attachables.grep(ActiveStorage::Blob).map(&:id)
+    assert_equal [ users(:kevin).id ], card.description.body.attachables.grep(User).map(&:id)
+    assert_equal file_fixture("avatar.png").binread, card.description.embeds.first.download
+
+    assert_not import.file.attached?
+  end
+
+  test "imports files stored under keys in older formats" do
+    with_current_user(:david) do
+      cards(:logo).image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    end
+
+    blob = cards(:logo).image.blob
+    legacy_key = "#{@source.external_account_id}/#{blob.key}"
+    blob.service.upload(legacy_key, file_fixture("moon.jpg").open)
+    blob.update_column(:key, legacy_key)
+
+    archive = export_and_remove(@source)
+    import = import_archive(archive, identity: identities(:kevin))
+
+    assert import.completed?, import.failure_reason
+    image = import.account.cards.find_by!(number: cards(:logo).number).image
+    assert_match(/\A[0-9a-z]{28}\z/, image.blob.key)
+    assert_equal file_fixture("moon.jpg").binread, image.download
+  end
+
+  test "imports column colors exported in the legacy format" do
+    column_id = columns(:writebook_triage).id
+    archive = export_and_remove(@source)
+
+    archive = rewrite_archive(archive) do |path, content|
+      if path == "data/columns/#{column_id}.json"
+        JSON.parse(content).merge("color" => { "name" => "Lime", "value" => "var(--color-card-4)" }).to_json
+      else
+        content
+      end
+    end
+
+    import = import_archive(archive, identity: identities(:kevin))
+
+    assert import.completed?, import.failure_reason
+    assert_equal Color.for_value("var(--color-card-4)"), Column.find(column_id).color
+  end
+
+  test "process imports right away" do
+    archive = export_and_remove(@source)
+    import = start_import(archive, identity: identities(:kevin))
+
+    import.process
+
+    assert import.reload.completed?, import.failure_reason
+    assert_equal 5, import.account.cards.count
+  end
+
+  test "processing an import without a file fails" do
+    Current.reset
+    account = Account.create!(name: "Empty")
+    import = Account::Import.create!(account: account, identity: identities(:kevin))
+
+    import.process
+
+    assert import.reload.failed?
+    assert_equal "The uploaded file couldn't be found.", import.failure_reason
+    assert_not Account.exists?(account.id)
+  end
+
+  test "imports exports that were unpacked and compressed again" do
+    archive = export_and_remove(@source)
+
+    reader = ZipFile::Reader.new(StringIO.new(archive))
+    archive = archive_with(reader.each_entry.to_h { |entry| [ "fizzy-export/#{entry.path}", reader.read(entry) ] }.merge(
+      "__MACOSX/fizzy-export/data/._account.json" => "AppleDouble",
+      "fizzy-export/.DS_Store" => "Finder"
+    ))
+
+    import = import_archive(archive, identity: identities(:kevin))
+
+    assert import.completed?, import.failure_reason
+    assert_equal 5, import.account.cards.count
+  end
+
+  test "imports references to records that no longer exist" do
+    card_id = cards(:logo).id
+    missing_column_id = uuid
+    archive = export_and_remove(@source)
+
+    archive = rewrite_archive(archive) do |path, content|
+      if path == "data/cards/#{card_id}.json"
+        JSON.parse(content).merge("column_id" => missing_column_id).to_json
+      else
+        content
+      end
+    end
+
+    import = import_archive(archive, identity: identities(:kevin))
+
+    assert import.completed?, import.failure_reason
+    assert_equal missing_column_id, Card.find(card_id).column_id
+  end
+
+  test "people can sign in to the imported account with their email addresses" do
+    archive = export_and_remove(@source)
+
+    import = import_archive(archive, identity: identities(:kevin))
+    account = import.account
+
+    assert_equal identities(:david), account.users.find_by!(name: "David").identity
+    assert_equal identities(:jz), account.users.find_by!(name: "JZ").identity
+    assert account.system_user.present?
+    assert_equal 1, account.users.where(role: :system).count
+  end
+
+  test "the person importing becomes the owner of the new account" do
+    archive = export_and_remove(@source)
+
+    import = import_archive(archive, identity: identities(:kevin))
+    account = import.account
+
+    assert account.users.find_by!(identity: identities(:kevin)).owner?
+    assert account.users.find_by!(identity: identities(:jason)).admin?
+    assert_equal [ identities(:kevin) ], account.users.owner.map(&:identity)
+  end
+
+  test "the person importing gets in even if they weren't in the exported account" do
+    archive = export_and_remove(@source)
+
+    import = import_archive(archive, identity: identities(:mike))
+    user = import.account.users.find_by!(identity: identities(:mike))
+
+    assert user.owner?
+    assert user.verified?
+    assert_includes user.boards, import.account.boards.find(boards(:writebook).id)
+  end
+
+  test "imported cards and comments can be searched" do
+    archive = export_and_remove(@source)
+
+    import = import_archive(archive, identity: identities(:kevin))
+    records = Search::Record.for(import.account.id).where(account_id: import.account.id)
+
+    assert_equal import.account.cards.published.count, records.where(searchable_type: "Card").count
+    assert_equal Comment.where(account: import.account).count, records.where(searchable_type: "Comment").count
+  end
+
+  test "storage used by the imported account is accounted for" do
+    attach_files_to_cards
+    archive = export_and_remove(@source)
+
+    import = import_archive(archive, identity: identities(:kevin))
+
+    expected = file_fixture("moon.jpg").size + file_fixture("avatar.png").size
+    assert_equal expected, import.account.bytes_used
+    assert_equal expected, import.account.boards.find(boards(:writebook).id).bytes_used
+  end
+
+  test "sends an email when the import is done" do
+    archive = export_and_remove(@source)
+
+    import = nil
+    assert_enqueued_email_with ImportMailer, :completed, params: nil, args: ->(args) { import = args.first; true } do
+      import = import_archive(archive, identity: identities(:kevin))
+    end
+  end
+
+  test "an interrupted import continues where it left off" do
+    last_board_file = "data/boards/#{[ boards(:writebook).id, boards(:private).id ].max}.json"
+    archive = export_and_remove(@source)
+
+    import = start_import(archive, identity: identities(:kevin))
+
+    interrupt_job_during_step Account::ImportJob, :import, cursor: [ "boards", last_board_file ] do
+      perform_enqueued_jobs only: Account::ImportJob, at: Time.current
+    end
+
+    assert import.reload.processing?
+    assert_equal 2, import.account.boards.count
+    assert_equal 0, import.account.cards.count
+
+    perform_enqueued_jobs only: Account::ImportJob
+
+    assert import.reload.completed?, import.failure_reason
+    assert_equal 5, import.account.cards.count
+  end
+
+  test "an import can be run again from the start after being stopped halfway" do
+    last_board_file = "data/boards/#{[ boards(:writebook).id, boards(:private).id ].max}.json"
+    archive = export_and_remove(@source)
+    import = start_import(archive, identity: identities(:kevin))
+
+    interrupt_job_during_step Account::ImportJob, :import, cursor: [ "boards", last_board_file ] do
+      perform_enqueued_jobs only: Account::ImportJob, at: Time.current
+    end
+    clear_enqueued_jobs
+
+    Account::ImportJob.perform_now(import)
+
+    assert import.reload.completed?, import.failure_reason
+    assert_equal 2, import.account.boards.count
+    assert_equal 5, import.account.cards.count
+    assert_equal 1, Filter.where(account: import.account).sum { |filter| filter.tags.count }
+  end
+
+  test "importing an account that still exists here fails and leaves nothing behind" do
+    archive = export(@source)
+
+    assert_nothing_left_behind do
+      import = import_archive(archive, identity: identities(:mike))
+
+      assert import.failed?
+      assert_match "already exists in this Fizzy", import.failure_reason
+      assert_nil import.account
+    end
+  end
+
+  test "importing a file that isn't an export fails" do
+    assert_nothing_left_behind do
+      import = import_archive(archive_with("readme.txt" => "Hello"))
+
+      assert import.failed?
+      assert_match "isn't a Fizzy account export", import.failure_reason
+    end
+  end
+
+  test "importing a damaged file fails" do
+    assert_nothing_left_behind do
+      import = import_archive("PK\x03\x04".b + SecureRandom.random_bytes(1000))
+
+      assert import.failed?
+      assert_equal "The file isn't a valid ZIP archive, or it's damaged.", import.failure_reason
+    end
+  end
+
+  test "sends an email when the import fails" do
+    assert_enqueued_email_with ImportMailer, :failed, args: ->(args) { args.first.failed? } do
+      import_archive(archive_with("readme.txt" => "Hello"))
+    end
+  end
+
+  test "records can't reference records of other accounts" do
+    user_id = uuid
+
+    archive = archive_with(
+      "data/account.json" => { name: "Sneaky" },
+      "data/users/#{user_id}.json" => { id: user_id, name: "Sneaky", role: "member", email_address: "mike@37signals.com" },
+      "data/accesses/#{access_id = uuid}.json" => { id: access_id, board_id: boards(:writebook).id, user_id: user_id, involvement: "watching" }
+    )
+
+    assert_nothing_left_behind do
+      import = import_archive(archive)
+
+      assert import.failed?
+      assert_match "reference boards that aren't in the file", import.failure_reason
+    end
+
+    assert_not Access.exists?(access_id)
+  end
+
+  test "attachments can't use files of other accounts" do
+    victim_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("Private"), filename: "private.txt")
+    card_id, board_id, user_id = uuid, uuid, uuid
+
+    archive = archive_with(
+      "data/account.json" => { name: "Sneaky" },
+      "data/users/#{user_id}.json" => { id: user_id, name: "Sneaky", role: "member" },
+      "data/boards/#{board_id}.json" => { id: board_id, name: "Board", creator_id: user_id },
+      "data/cards/#{card_id}.json" => { id: card_id, board_id: board_id, creator_id: user_id, number: 1, status: "published", title: "Card", last_active_at: Time.current },
+      "data/active_storage_attachments/#{attachment_id = uuid}.json" => { id: attachment_id, name: "image", record_type: "Card", record_id: card_id, blob_id: victim_blob.id }
+    )
+
+    assert_nothing_left_behind do
+      assert import_archive(archive).failed?
+    end
+  end
+
+  test "files can't overwrite files of other accounts" do
+    victim_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("Private"), filename: "private.txt")
+
+    archive = archive_with(
+      "data/account.json" => { name: "Sneaky" },
+      "storage/#{victim_blob.key}" => "Overwritten"
+    )
+
+    assert_nothing_left_behind do
+      assert import_archive(archive).failed?
+    end
+
+    assert_equal "Private", victim_blob.download
+  end
+
+  test "rich text can't embed files of other accounts" do
+    victim_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("Private"), filename: "private.txt")
+    user_id, board_id = uuid, uuid
+
+    archive = archive_with(
+      "data/account.json" => { name: "Sneaky" },
+      "data/users/#{user_id}.json" => { id: user_id, name: "Sneaky", role: "member" },
+      "data/boards/#{board_id}.json" => { id: board_id, name: "Board", creator_id: user_id },
+      "data/action_text_rich_texts/#{rich_text_id = uuid}.json" => {
+        id: rich_text_id, name: "public_description", record_type: "Board", record_id: board_id,
+        body: %(<action-text-attachment gid="#{victim_blob.to_global_id}"></action-text-attachment><action-text-attachment sgid="#{victim_blob.attachable_sgid}"></action-text-attachment>)
+      }
+    )
+
+    import = import_archive(archive)
+    assert import.completed?, import.failure_reason
+
+    board = import.account.boards.find(board_id)
+    assert_empty board.public_description.body.attachables.compact.grep(ActiveStorage::Blob)
+  end
+
+  test "records with invalid data fail the import" do
+    archive = archive_with(
+      "data/account.json" => { name: "Sneaky" },
+      "data/users/#{user_id = uuid}.json" => { id: user_id, name: "Sneaky", role: "superuser" }
+    )
+
+    assert_nothing_left_behind do
+      import = import_archive(archive)
+
+      assert import.failed?
+      assert_match "invalid role", import.failure_reason
+    end
+  end
+
+  test "people with repeated email addresses fail the import without creating identities" do
+    archive = archive_with(
+      "data/account.json" => { name: "Twins" },
+      "data/users/#{first_id = uuid}.json" => { id: first_id, name: "One", role: "member", email_address: "twin@example.com" },
+      "data/users/#{second_id = uuid}.json" => { id: second_id, name: "Two", role: "member", email_address: "twin@example.com" }
+    )
+
+    assert_nothing_left_behind do
+      assert import_archive(archive).failed?
+    end
+
+    assert_not Identity.exists?(email_address: "twin@example.com")
+  end
+
+  test "nobody can get into the account while it's being imported" do
+    archive = export_and_remove(@source)
+
+    import = start_import(archive, identity: identities(:kevin))
+
+    assert import.pending?
+    assert_empty import.account.users
+  end
+
+  test "an import that fails at the very end leaves nothing behind" do
+    attach_files_to_cards
+    archive = export_and_remove(@source)
+    Account::DataTransfer::UserRecordSet.any_instance.stubs(:connect_identities).raises(Account::DataTransfer::IntegrityError, "Boom")
+
+    assert_nothing_left_behind do
+      assert_no_difference -> { Storage::Total.count + Storage::Entry.count + Search::Record.for(@source.id).count } do
+        assert import_archive(archive, identity: identities(:kevin)).failed?
+      end
+    end
+  end
+
+  test "stalled imports fail and are rolled back" do
+    archive = export_and_remove(@source)
+    import = start_import(archive, identity: identities(:kevin))
+    account = import.account
+
+    travel Account::Import::STALLED_AFTER + 1.minute do
+      Account::Import.fail_stalled
+    end
+
+    assert import.reload.failed?
+    assert_not Account.exists?(account.id)
+  end
+
+  private
+    def attach_files_to_cards
+      with_current_user(:david) do
+        cards(:logo).image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+        ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png").tap do |blob|
+          cards(:logo).update! description: "<p>Look #{ActionText::Attachment.from_attachable(blob).to_html} #{ActionText::Attachment.from_attachable(users(:kevin)).to_html}</p>"
+        end
+      end
+    end
+
+    def snapshot_of(account)
+      {
+        boards: account.boards.pluck(:id, :name).sort,
+        cards: account.cards.pluck(:id, :number, :title, :status, :board_id, :column_id).sort,
+        comments: Comment.where(account: account).pluck(:id, :card_id, :creator_id).sort,
+        users: account.users.pluck(:id, :name, :active).sort,
+        events: Event.where(account: account).pluck(:id, :action, :eventable_id).sort,
+        accesses: Access.where(account: account).pluck(:id, :board_id, :user_id).sort,
+        columns: Column.where(account: account).pluck(:id, :name, :position).sort,
+        tags: account.tags.pluck(:id, :title).sort,
+        taggings: Tagging.where(account: account).pluck(:id).sort,
+        assignments: Assignment.where(account: account).pluck(:id).sort,
+        reactions: Reaction.where(account: account).pluck(:id, :content).sort,
+        notifications: Notification.where(account: account).pluck(:id).sort,
+        entropy: account.entropy.auto_postpone_period,
+        board_entropies: Entropy.where(account: account, container_type: "Board").pluck(:id, :container_id, :auto_postpone_period).sort,
+        webhooks: Webhook.where(account: account).pluck(:id, :url).sort,
+        filters: Filter.where(account: account).map { |filter| [ filter.id, filter.tag_ids.sort, filter.assignee_ids.sort ] }.sort,
+        rich_texts: ActionText::RichText.where(account: account).pluck(:id, :record_id).sort,
+        blobs: ActiveStorage::Blob.where(account: account).pluck(:id, :filename, :byte_size, :checksum).sort,
+        attachments: ActiveStorage::Attachment.where(account: account).pluck(:id, :record_id, :blob_id).sort
+      }
+    end
+
+    def export(account)
+      export = Account::Export.create!(account: account, user: users(:kevin))
+      export.build
+      export.file.download.tap { export.destroy }
+    end
+
+    def export_and_remove(account)
+      export(account).tap do
+        Current.with_account(account) do
+          Account::DataTransfer::Manifest.new(account).delete_all
+          account.incinerate
+        end
+      end
+    end
+
+    def start_import(archive, identity:)
+      Current.reset
+      Account::Import.start(identity: identity, file: uploaded(archive))
+    end
+
+    def import_archive(archive, identity: identities(:mike))
+      import = nil
+
+      perform_enqueued_jobs only: Account::ImportJob do
+        import = start_import(archive, identity: identity)
+      end
+
+      import.reload
+    end
+
+    def uploaded(data)
+      Rack::Test::UploadedFile.new(StringIO.new(data), "application/zip", true, original_filename: "export.zip")
+    end
+
+    def archive_with(files)
+      io = StringIO.new("".b)
+      writer = ZipFile::Writer.new(io)
+      files.each { |path, content| writer.add_file(path, content.is_a?(String) ? content : content.to_json) }
+      writer.close
+      io.string
+    end
+
+    def rewrite_archive(archive)
+      reader = ZipFile::Reader.new(StringIO.new(archive))
+      archive_with(reader.each_entry.to_h { |entry| [ entry.path, yield(entry.path, reader.read(entry)) ] })
+    end
+
+    def uuid
+      ActiveRecord::Type::Uuid.generate
+    end
+
+    def assert_nothing_left_behind(&block)
+      tables = %w[ accounts users identities boards cards accesses active_storage_blobs active_storage_attachments action_text_rich_texts account_join_codes entropies ]
+      counts = -> { tables.index_with { |table| ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM #{table}") } }
+
+      before = counts.call
+      block.call
+      assert_equal before, counts.call
+    end
+end
diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..6736243
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+  end
+
+  test "build creates the archive, completes the export and emails the person who asked for it" do
+    assert_enqueued_email_with ExportMailer, :completed, args: [ @export ] do
+      @export.build
+    end
+
+    assert @export.reload.completed?
+    assert @export.completed_at.present?
+    assert @export.file.attached?
+    assert @export.downloadable?
+  end
+
+  test "build_later enqueues the job" do
+    assert_enqueued_with job: Export::BuildJob, args: [ @export ] do
+      @export.build_later
+    end
+
+    perform_enqueued_jobs only: Export::BuildJob
+    assert @export.reload.completed?
+  end
+
+  test "a failed build marks the export as failed" do
+    ZipFile.stubs(:create_for).raises(RuntimeError, "Boom")
+
+    assert_no_enqueued_emails do
+      assert_raises(RuntimeError) { @export.build }
+    end
+
+    assert @export.reload.failed?
+    assert_not @export.downloadable?
+  end
+
+  test "exports can be downloaded for a day" do
+    @export.build
+
+    travel 23.hours
+    assert @export.downloadable?
+
+    travel 2.hours
+    assert @export.expired?
+    assert_not @export.downloadable?
+  end
+
+  test "cleanup removes the files of expired exports" do
+    @export.build
+    blob = @export.file.blob
+    recent = User::DataExport.create!(account: accounts("37s"), user: users(:david))
+    recent.build
+
+    travel_to 2.days.from_now do
+      recent.update!(completed_at: 1.hour.ago)
+
+      assert_no_difference -> { Export.count } do
+        Export.cleanup
+      end
+
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not @export.reload.file.attached?
+      assert_not @export.downloadable?
+      assert recent.reload.downloadable?
+    end
+  end
+
+  test "cleanup removes old exports" do
+    @export.build
+
+    travel_to (Export::KEPT_FOR + 1.day).from_now do
+      assert_difference -> { Export.count }, -1 do
+        Export.cleanup
+      end
+    end
+  end
+
+  test "cleanup fails stalled exports so that new ones can be started" do
+    @export.processing!
+
+    travel_to (Export::STALLED_AFTER + 1.hour).from_now do
+      assert_not users(:kevin).exports.building.exists?
+
+      Export.cleanup
+      assert @export.reload.failed?
+    end
+  end
+
+  test "only the person who asked for an export can access it" do
+    assert @export.accessible_to?(users(:kevin))
+    assert_not @export.accessible_to?(users(:jason))
+    assert_not @export.accessible_to?(nil)
+    assert_not @export.publicly_accessible?
+  end
+
+  test "account exports are only accessible to admins" do
+    users(:kevin).update!(role: :member)
+    assert_not @export.reload.accessible_to?(users(:kevin))
+  end
+
+  test "daily limit" do
+    assert_not Account::Export.limit_reached_for?(users(:kevin))
+
+    (Export::DAILY_LIMIT - 1).times { Account::Export.create!(account: accounts("37s"), user: users(:kevin)) }
+    assert Account::Export.limit_reached_for?(users(:kevin))
+    assert_not User::DataExport.limit_reached_for?(users(:kevin))
+
+    travel 25.hours
+    assert_not Account::Export.limit_reached_for?(users(:kevin))
+  end
+end
diff --git a/test/models/user/data_export_test.rb b/test/models/user/data_export_test.rb
new file mode 100644
index 0000000..beb8b4a
--- /dev/null
+++ b/test/models/user/data_export_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @export = User::DataExport.create!(account: accounts("37s"), user: @user)
+  end
+
+  test "exports the cards the person can see" do
+    private_card = others_draft = own_draft = nil
+
+    with_current_user(:kevin) do
+      private_card = boards(:private).cards.create!(title: "Secret plans", status: "published")
+      others_draft = boards(:writebook).cards.create!(title: "Kevin's draft", status: "drafted")
+    end
+
+    with_current_user(:david) do
+      own_draft = boards(:writebook).cards.create!(title: "David's draft", status: "drafted")
+    end
+
+    @export.build
+
+    read_export do |zip|
+      exported_numbers = zip.glob("*.json").map { |path| File.basename(path, ".json").to_i }
+
+      assert_includes exported_numbers, cards(:logo).number
+      assert_includes exported_numbers, own_draft.number
+      assert_not_includes exported_numbers, private_card.number
+      assert_not_includes exported_numbers, others_draft.number
+      assert_equal @user.accessible_cards.published.count + 1, exported_numbers.size
+    end
+  end
+
+  test "exports each card as JSON with its comments" do
+    @export.build
+
+    read_export do |zip|
+      card = JSON.parse(zip.read("#{cards(:logo).number}.json"))
+
+      assert_equal cards(:logo).id, card["id"]
+      assert_equal cards(:logo).title, card["title"]
+      assert_equal "Writebook", card.dig("board", "name")
+      assert_equal "david@37signals.com", card.dig("creator", "email_address")
+      assert_equal cards(:logo).description.to_plain_text, card.dig("description", "plain_text")
+      assert_match %r{/cards/#{cards(:logo).number}\z}, card["url"]
+
+      assert_equal cards(:logo).comments.count, card["comments"].size
+      assert_includes card["comments"].map { |comment| comment.dig("body", "plain_text") }, comments(:logo_agreement_jz).body.to_plain_text
+    end
+  end
+
+  test "exports the pictures and files attached to cards and comments" do
+    with_current_user(:david) do
+      cards(:logo).image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+      embed = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+      cards(:logo).update! description: "<p>Look: #{ActionText::Attachment.from_attachable(embed).to_html}</p>"
+
+      document = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("The plan"), filename: "plan.txt", content_type: "text/plain")
+      cards(:logo).comments.create! body: "<p>Read #{ActionText::Attachment.from_attachable(document).to_html}</p>"
+    end
+
+    @export.build
+
+    read_export do |zip|
+      number = cards(:logo).number
+      card = JSON.parse(zip.read("#{number}.json"))
+
+      assert_equal "#{number}/moon.jpg", card["image"]
+      assert_equal file_fixture("moon.jpg").binread, zip.read("#{number}/moon.jpg")
+
+      assert_equal [ "#{number}/avatar.png" ], card["attachments"].pluck("path")
+      assert_includes card.dig("description", "html"), %(<img src="#{number}/avatar.png")
+      assert_equal file_fixture("avatar.png").binread, zip.read("#{number}/avatar.png")
+
+      comment = card["comments"].find { |comment| comment["attachments"].any? }
+      assert_equal [ "#{number}/plan.txt" ], comment["attachments"].pluck("path")
+      assert_includes comment.dig("body", "html"), %(<a href="#{number}/plan.txt">)
+      assert_equal "The plan", zip.read("#{number}/plan.txt")
+    end
+  end
+
+  test "gives files with the same name different paths" do
+    with_current_user(:david) do
+      first = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("First"), filename: "notes.txt", content_type: "text/plain")
+      second = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("Second"), filename: "notes.txt", content_type: "text/plain")
+      cards(:logo).update! description: "<p>#{ActionText::Attachment.from_attachable(first).to_html} #{ActionText::Attachment.from_attachable(second).to_html}</p>"
+    end
+
+    @export.build
+
+    read_export do |zip|
+      number = cards(:logo).number
+
+      assert_equal [ "#{number}/notes (2).txt", "#{number}/notes.txt" ], zip.glob("#{number}/*")
+      assert_equal %w[ First Second ], zip.glob("#{number}/*").map { |path| zip.read(path) }.sort
+    end
+  end
+
+  test "skips files that are missing from storage" do
+    with_current_user(:david) do
+      cards(:logo).image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    end
+    cards(:logo).image.blob.service.delete(cards(:logo).image.blob.key)
+
+    @export.build
+
+    read_export do |zip|
+      assert_nil JSON.parse(zip.read("#{cards(:logo).number}.json"))["image"]
+      assert_not zip.exists?("#{cards(:logo).number}/moon.jpg")
+    end
+  end
+
+  private
+    def read_export(&block)
+      ZipFile.read_from(@export.reload.file.blob, &block)
+    end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
index 249f23c..ae119cd 100644
--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -37,4 +37,162 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "docs/guide.txt", "docs/readme.txt" ], writer.glob("docs/*.txt")
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
+
+  test "writer tracks the size and checksum of the archive" do
+    io = StringIO.new("".b)
+
+    writer = ZipFile::Writer.new(io)
+    writer.add_file("hello.txt", "Hello, World!")
+    writer.close
+
+    assert_equal io.string.bytesize, writer.byte_size
+    assert_equal Digest::MD5.base64digest(io.string), writer.checksum
+  end
+
+  test "reader reads entries written by the writer" do
+    reader = reader_for(
+      "data/account.json" => '{"name":"37signals"}',
+      "data/cards/1.json" => '{"number":1}',
+      "data/cards/2.json" => '{"number":2}',
+      "storage/abc" => "x" * 3.megabytes
+    )
+
+    assert reader.exists?("data/account.json")
+    assert reader.exists?("data/cards/2.json")
+    assert_not reader.exists?("data/cards/3.json")
+    assert_not reader.exists?("data/account")
+
+    assert_equal '{"name":"37signals"}', reader.read("data/account.json")
+    assert_equal [ "data/cards/1.json", "data/cards/2.json" ], reader.glob("data/cards/*.json")
+    assert_equal [ "data/account.json", "data/cards/1.json", "data/cards/2.json" ], reader.glob("**/*.json")
+    assert_equal "x" * 3.megabytes, reader.read("storage/abc")
+  end
+
+  test "reader streams entries in chunks" do
+    data = SecureRandom.random_bytes(3.megabytes)
+    reader = reader_for("storage/abc" => data)
+
+    chunks = []
+    reader.read("storage/abc") { |chunk| chunks << chunk }
+
+    assert_operator chunks.size, :>, 1
+    assert_equal data, chunks.join
+  end
+
+  test "reader opens entries as IO objects that can be rewound" do
+    reader = reader_for("storage/abc" => "0123456789")
+
+    reader.open("storage/abc") do |io|
+      assert_equal 10, io.size
+      assert_equal "0123", io.read(4)
+      assert_equal "456789", io.read
+      assert_nil io.read(1)
+
+      io.rewind
+      assert_equal "0123456789", io.read
+    end
+  end
+
+  test "reader refuses to read huge entries at once" do
+    reader = reader_for("storage/abc" => "x" * 100)
+
+    assert_raises(ZipFile::Reader::EntryTooLarge) { reader.read("storage/abc", max_size: 10) }
+    assert_raises(ZipFile::Reader::EntryNotFound) { reader.read("storage/missing") }
+  end
+
+  test "reader rejects files that aren't ZIP archives" do
+    reader = ZipFile::Reader.new(StringIO.new("This is not a ZIP file" * 100))
+
+    assert_raises(ZipFile::Reader::InvalidArchive) { reader.glob("*") }
+  end
+
+  test "create archives in storage and read them back" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+
+    ZipFile.create_for(export.file, filename: "export.zip") do |zip|
+      zip.add_file "hello.txt", "Hello, World!"
+    end
+
+    assert export.file.attached?
+    assert_equal "export.zip", export.file.filename.to_s
+    assert_equal export.file.download.bytesize, export.file.byte_size
+    assert_equal Digest::MD5.base64digest(export.file.download), export.file.checksum
+
+    ZipFile.read_from(export.file.blob) do |zip|
+      assert_equal "Hello, World!", zip.read("hello.txt")
+    end
+  end
+
+  test "failing to create an archive leaves nothing behind" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+
+    assert_no_difference -> { ActiveStorage::Blob.count } do
+      assert_raises(RuntimeError) do
+        ZipFile.create_for(export.file, filename: "export.zip") do |zip|
+          zip.add_file "hello.txt", "Hello, World!"
+          raise "Boom"
+        end
+      end
+    end
+
+    assert_not export.reload.file.attached?
+  end
+
+  test "remote IO reads blobs with ranged requests through a read-ahead buffer" do
+    data = SecureRandom.random_bytes(1000)
+    service = FakeRemoteService.new(data)
+    blob = ActiveStorage::Blob.new(key: "abc", byte_size: data.bytesize)
+    blob.stubs(:service).returns(service)
+
+    io = ZipFile::RemoteIO.new(blob)
+    assert_equal 1000, io.size
+
+    io.seek(10)
+    assert_equal data.byteslice(10, 5), io.read(5)
+    assert_equal data.byteslice(15, 5), io.read(5)
+    assert_equal 1, service.requests
+
+    io.seek(995)
+    assert_equal data.byteslice(995, 5), io.read(100)
+    assert_nil io.read(1)
+    assert_equal "", io.read(0)
+  end
+
+  test "reader reads archives through remote IO" do
+    archive = archive_for("data/account.json" => '{"name":"37signals"}', "storage/abc" => "x" * 100)
+    blob = ActiveStorage::Blob.new(key: "abc", byte_size: archive.bytesize)
+    blob.stubs(:service).returns(FakeRemoteService.new(archive))
+
+    reader = ZipFile::Reader.new(ZipFile::RemoteIO.new(blob))
+
+    assert_equal '{"name":"37signals"}', reader.read("data/account.json")
+    assert_equal "x" * 100, reader.read("storage/abc")
+  end
+
+  private
+    class FakeRemoteService
+      attr_reader :requests
+
+      def initialize(data)
+        @data = data
+        @requests = 0
+      end
+
+      def download_chunk(key, range)
+        @requests += 1
+        @data.byteslice(range.begin, range.size)
+      end
+    end
+
+    def archive_for(files)
+      io = StringIO.new("".b)
+      writer = ZipFile::Writer.new(io)
+      files.each { |path, content| writer.add_file(path, content) }
+      writer.close
+      io.string
+    end
+
+    def reader_for(files)
+      ZipFile::Reader.new(StringIO.new(archive_for(files)))
+    end
 end
