+# The stored files, named after the keys of their blobs. They are stored
+# uncompressed: most of them are images and documents that are compressed already.
 class Account::DataTransfer::ActiveStorage::FileRecordSet < Account::DataTransfer::RecordSet
+  PREFIX = "storage/".freeze
+
   def initialize(account)
     super(account: account, model: ::ActiveStorage::Blob)
   end
 
+  def name
+    "storage"
+  end
+
+  def delete_all
+    records.find_each do |blob|
+      blob.service.delete(blob.key)
+    end
+  end
+
   private
     def records
       ::ActiveStorage::Blob.where(account: account).where.not(id: excluded_blob_ids)
@@ -12,4 +26,52 @@ class Account::DataTransfer::ActiveStorage::FileRecordSet < Account::DataTransfe
       ::ActiveStorage::Attachment.where(account: account, record_type: INTERNAL_RECORD_TYPES).select(:blob_id)
     end
 
+    def export_record(blob)
+      if blob.service.exist?(blob.key)
+        zip.add_file("#{PREFIX}#{blob.key}", compress: false) do |file|
+          blob.download { |chunk| file.write(chunk) }
+        end
+      else
+        Rails.logger.warn "[Export] Skipping missing file for blob #{blob.id} (#{blob.key})"
+      end
+    end
+
+    def files
+      zip.each_entry("#{PREFIX}*")
+    end
+
+    # Files can be huge, so progress is reported after each one
+    def batch_size
+      1
+    end
+
+    def check_batch(entries)
+    end
+
+    def import_batch(entries)
+      entries.each do |entry|
+        if blob = blob_for(entry)
+          upload(blob, entry)
+        else
+          raise Account::DataTransfer::IntegrityError, "#{entry.path} doesn't belong to any file in the account"
+        end
+      end
+    end
+
+    def blob_for(entry)
+      original_key = entry.path.delete_prefix(PREFIX)
+      records.find_by(key: Account::DataTransfer::ActiveStorage::BlobRecordSet.key_for(account, original_key))
+    end
+
+    def upload(blob, entry)
+      if entry.size == blob.byte_size
+        zip.open(entry) do |io|
+          blob.service.upload(blob.key, io, checksum: blob.checksum.presence)
+        end
+      else
+        raise Account::DataTransfer::IntegrityError, "#{entry.path} doesn't have the expected size"
+      end
+    rescue ActiveStorage::IntegrityError
+      raise Account::DataTransfer::IntegrityError, "#{entry.path} is damaged"
+    end
 end
diff --git a/app/models/account/data_transfer/entropy_record_set.rb b/app/models/account/data_transfer/entropy_record_set.rb
index dee0db1..e380b7a 100644
--- a/app/models/account/data_transfer/entropy_record_set.rb
+++ b/app/models/account/data_transfer/entropy_record_set.rb
@@ -1,5 +1,37 @@
+# The account's own entropy already exists in the target account, so it gets
+# updated rather than inserted.
 class Account::DataTransfer::EntropyRecordSet < Account::DataTransfer::RecordSet
   def initialize(account)
     super(account: account, model: Entropy)
   end
+
+  private
+    def check_batch(entries)
+      check_conflicts entries.map { |entry| build_row(entry) }.reject { |row| account_entropy?(row) }
+    end
+
+    def import_batch(entries)
+      account_rows, rows = entries.map { |entry| build_row(entry) }.partition { |row| account_entropy?(row) }
+
+      model.transaction do
+        if account_row = account_rows.last
+          account.entropy.update!(auto_postpone_period: account_row["auto_postpone_period"])
+        end
+
+        check_references(rows)
+        insert(rows)
+      end
+    rescue ActiveRecord::RecordInvalid
+      raise Account::DataTransfer::IntegrityError, "The auto close setting for the account is invalid"
+    end
+
+    def row_from(data)
+      super.tap do |row|
+        row["container_id"] = account.id if account_entropy?(row)
+      end
+    end
+
+    def account_entropy?(row)
+      row["container_type"] == "Account"
+    end
 end
