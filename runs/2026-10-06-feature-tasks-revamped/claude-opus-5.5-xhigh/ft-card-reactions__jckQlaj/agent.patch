diff --git a/test/models/account/data_transfer/reaction_record_set_test.rb b/test/models/account/data_transfer/reaction_record_set_test.rb
new file mode 100644
index 0000000..ffb8274
--- /dev/null
+++ b/test/models/account/data_transfer/reaction_record_set_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Account::DataTransfer::ReactionRecordSetTest < ActiveSupport::TestCase
+  test "imports reactions on cards and comments" do
+    card_reaction = build_reaction_data(reactable_type: "Card", reactable_id: cards(:logo).id)
+    comment_reaction = build_reaction_data(reactable_type: "Comment", reactable_id: comments(:logo_1).id)
+
+    record_set.import(from: build_reader(card_reaction, comment_reaction))
+
+    assert_equal cards(:logo), Reaction.find(card_reaction["id"]).reactable
+    assert_equal comments(:logo_1), Reaction.find(comment_reaction["id"]).reactable
+  end
+
+  test "imports comment reactions from exports made before cards could be reacted to" do
+    legacy_reaction = build_reaction_data.merge("comment_id" => comments(:logo_1).id)
+
+    record_set.import(from: build_reader(legacy_reaction))
+
+    reaction = Reaction.find(legacy_reaction["id"])
+    assert_equal comments(:logo_1), reaction.reactable
+    assert_equal importing_account, reaction.account
+  end
+
+  test "check accepts comment reactions from exports made before cards could be reacted to" do
+    legacy_reaction = build_reaction_data.merge("comment_id" => ActiveRecord::Type::Uuid.generate)
+
+    assert_nothing_raised do
+      record_set.check(from: build_reader(legacy_reaction))
+    end
+  end
+
+  test "check rejects reactions referencing existing records" do
+    legacy_reaction = build_reaction_data.merge("comment_id" => comments(:logo_1).id)
+
+    assert_raises(Account::DataTransfer::RecordSet::ConflictError) do
+      record_set.check(from: build_reader(legacy_reaction))
+    end
+  end
+
+  private
+    def record_set
+      Account::DataTransfer::ReactionRecordSet.new(importing_account).tap do |record_set|
+        record_set.importable_model_names = %w[ Card Comment User Reaction ]
+      end
+    end
+
+    def importing_account
+      @importing_account ||= Account.create!(name: "Importing Account", external_account_id: 99999999)
+    end
+
+    def build_reaction_data(**attributes)
+      {
+        "id" => ActiveRecord::Type::Uuid.generate,
+        "account_id" => ActiveRecord::Type::Uuid.generate,
+        "content" => "👍",
+        "reacter_id" => ActiveRecord::Type::Uuid.generate,
+        "created_at" => Time.current.iso8601,
+        "updated_at" => Time.current.iso8601
+      }.merge(attributes.stringify_keys)
+    end
+
+    def build_reader(*records)
+      tempfile = Tempfile.new([ "import_test", ".zip" ])
+      tempfile.binmode
+
+      writer = ZipFile::Writer.new(tempfile)
+      records.each { |data| writer.add_file("data/reactions/#{data['id']}.json", data.to_json) }
+      writer.close
+      tempfile.rewind
+
+      @tempfiles ||= []
+      @tempfiles << tempfile
+
+      ZipFile::Reader.new(tempfile)
+    end
+
+    def teardown
+      @tempfiles&.each { |f| f.close; f.unlink }
+    end
+end
