diff --git a/app/controllers/cards/reactions_controller.rb b/app/controllers/cards/reactions_controller.rb
new file mode 100644
index 0000000..9f46dde
--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,43 @@
+class Cards::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  with_options only: :destroy do
+    before_action :set_reaction
+    before_action :ensure_permission_to_administer_reaction
+  end
+
+  def index
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @card.reactions.create!(params.expect(reaction: :content))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_reaction
+      @reaction = @card.reactions.find(params[:id])
+    end
+
+    def ensure_permission_to_administer_reaction
+      head :forbidden if Current.user != @reaction.reacter
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..b038807
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,27 @@
+module ReactionsHelper
+  def reactions_path_for(reactable)
+    polymorphic_path([ *reactable_nesting(reactable), :reactions ])
+  end
+
+  def new_reaction_path_for(reactable)
+    new_polymorphic_path([ *reactable_nesting(reactable), :reaction ])
+  end
+
+  def reaction_path_for(reaction)
+    polymorphic_path([ *reactable_nesting(reaction.reactable), reaction ])
+  end
+
+  def reaction_url_for(reaction)
+    polymorphic_url([ *reactable_nesting(reaction.reactable), reaction ])
+  end
+
+  private
+    # Reactions live under their card: /cards/:card_id/reactions or /cards/:card_id/comments/:comment_id/reactions
+    def reactable_nesting(reactable)
+      if reactable.is_a?(Card)
+        [ reactable ]
+      else
+        [ reactable.card, reactable ]
+      end
+    end
+end
