+class RequireAccountIdOnAllTenantTables < ActiveRecord::Migration[8.2]
+  # Tables that got a nullable account_id in the first multi-tenant pass.
+  BACKFILLED_TABLES = %i[
+    account_imports account_join_codes boards cards columns comments events filters
+    notification_bundles notifications push_subscriptions steps tags users webhooks
+  ]
+
+  # Tables that hold an account's data but never got an account_id.
+  NEW_TABLES = %i[
+    accesses action_text_rich_texts active_storage_attachments active_storage_blobs
+    active_storage_variant_records assignments board_publications card_activity_spikes
+    card_goldnesses card_not_nows closures entropies mentions pins reactions search_queries
+    storage_totals taggings user_settings watches webhook_delinquency_trackers webhook_deliveries
+  ]
+
+  # Already have an index that leads with account_id.
+  INDEXED_TABLES = %i[ account_imports cards users ]
+
+  def up
+    NEW_TABLES.each do |table|
+      add_column table, :account_id, :uuid unless column_exists?(table, :account_id)
+    end
+
+    # Every table takes its account from its owner, so owners settle before what they own.
+    # Rows whose account can't be found are orphans and get dropped.
+    require_account :users
+    require_account :account_join_codes
+    require_account :account_imports
+
+    %i[ boards filters ].each do |table|
+      require_account table, from: { users: :creator_id }
+    end
+
+    %i[ notification_bundles notifications push_subscriptions search_queries user_settings ].each do |table|
+      require_account table, from: { users: :user_id }
+    end
+
+    %i[ accesses board_publications cards columns events webhooks ].each do |table|
+      require_account table, from: { boards: :board_id }
+    end
+
+    %i[ webhook_delinquency_trackers webhook_deliveries ].each do |table|
+      require_account table, from: { webhooks: :webhook_id }
+    end
+
+    %i[ assignments card_activity_spikes card_goldnesses card_not_nows closures comments pins steps taggings watches ].each do |table|
+      require_account table, from: { cards: :card_id }
+    end
+
+    require_account :mentions,       polymorphic: { source: { "Card" => :cards, "Comment" => :comments } }
+    require_account :reactions,      polymorphic: { reactable: { "Card" => :cards, "Comment" => :comments } }
+    require_account :entropies,      polymorphic: { container: { "Account" => :accounts, "Board" => :boards } }
+    require_account :storage_totals, polymorphic: { owner: { "Account" => :accounts, "Board" => :boards } }
+
+    # Tags only reach an account through the cards they're on.
+    backfill_from_children :tags, :taggings, :tag_id
+    require_account :tags, index: false
+    remove_index :tags, :title, if_exists: true
+    add_index :tags, %i[ account_id title ], unique: true, if_not_exists: true
+
+    require_account :action_text_rich_texts,
+      polymorphic: { record: { "Board" => :boards, "Card" => :cards, "Comment" => :comments } }
+
+    # Blobs belong to whatever they're attached to. Variant and preview images are attached to the
+    # variant record or original blob, so those take a second pass once the originals are settled.
+    # Identity avatars belong to no account, so they go with the orphans.
+    backfill_polymorphic :active_storage_attachments, :record,
+      "Account::Import" => :account_imports, "ActionText::RichText" => :action_text_rich_texts,
+      "Card" => :cards, "Export" => :exports, "User" => :users
+    backfill_from_children :active_storage_blobs, :active_storage_attachments, :blob_id
+    backfill_from_parent :active_storage_variant_records, :active_storage_blobs, :blob_id
+    backfill_polymorphic :active_storage_attachments, :record,
+      "ActiveStorage::Blob" => :active_storage_blobs, "ActiveStorage::VariantRecord" => :active_storage_variant_records
+    backfill_from_children :active_storage_blobs, :active_storage_attachments, :blob_id
+
+    require_account :active_storage_attachments
+    require_account :active_storage_blobs
+    require_account :active_storage_variant_records
+  end
+
+  def down
+    NEW_TABLES.each do |table|
+      remove_column table, :account_id
+    end
+
+    remove_index :tags, %i[ account_id title ]
+    add_index :tags, :title, unique: true
+
+    (BACKFILLED_TABLES - INDEXED_TABLES - %i[ tags ]).each do |table|
+      remove_index table, :account_id
+    end
+
+    BACKFILLED_TABLES.each do |table|
+      change_column_null table, :account_id, true
+    end
+  end
+
+  private
+    def require_account(table, from: {}, polymorphic: {}, index: true)
+      from.each do |parent, foreign_key|
+        backfill_from_parent table, parent, foreign_key
+      end
+
+      polymorphic.each do |association, types|
+        backfill_polymorphic table, association, types
+      end
+
+      delete_orphans table
+      change_column_null table, :account_id, false
+      add_index table, :account_id, if_not_exists: true if index && !table.in?(INDEXED_TABLES)
+    end
+
+    def backfill_polymorphic(table, association, types)
+      types.each do |type, parent|
+        backfill_from_parent table, parent, :"#{association}_id", where: "#{association}_type = #{quote(type)}"
+      end
+    end
+
+    def backfill_from_parent(table, parent, foreign_key, where: nil)
+      parent_account_id = parent == :accounts ? "accounts.id" : "#{parent}.account_id"
+
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (SELECT #{parent_account_id} FROM #{parent} WHERE #{parent}.id = #{table}.#{foreign_key})
+        WHERE #{table}.account_id IS NULL #{"AND #{table}.#{where}" if where}
+      SQL
+    end
+
+    # Takes the account of the oldest child that has one.
+    def backfill_from_children(table, children, foreign_key)
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (
+          SELECT #{children}.account_id FROM #{children}
+          WHERE #{children}.#{foreign_key} = #{table}.id AND #{children}.account_id IS NOT NULL
+          ORDER BY #{children}.created_at, #{children}.id
+          LIMIT 1
+        )
+        WHERE #{table}.account_id IS NULL
+      SQL
+    end
+
+    def delete_orphans(table)
+      execute <<~SQL
+        DELETE FROM #{table}
+        WHERE account_id IS NULL
+          OR NOT EXISTS (SELECT 1 FROM accounts WHERE accounts.id = #{table}.account_id)
+      SQL
+    end
+
+    def quote(value)
+      connection.quote(value)
+    end
+end
