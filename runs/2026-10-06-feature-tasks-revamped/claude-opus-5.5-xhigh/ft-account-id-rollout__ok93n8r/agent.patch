diff --git a/test/models/account_scoping_test.rb b/test/models/account_scoping_test.rb
new file mode 100644
index 0000000..7ba8232
--- /dev/null
+++ b/test/models/account_scoping_test.rb
@@ -0,0 +1,24 @@
+require "test_helper"
+
+class AccountScopingTest < ActiveSupport::TestCase
+  # Tables whose rows don't belong to a single account: accounts themselves, global identity and
+  # authentication records, and filter join tables, which are scoped through the rows they join.
+  UNSCOPED_TABLES = %w[
+    accounts account_external_id_sequences
+    identities identity_access_tokens magic_links sessions action_pack_passkeys
+    assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags
+    ar_internal_metadata schema_migrations
+  ]
+
+  test "every table holding account data has a required, indexed account_id" do
+    connection = ActiveRecord::Base.connection
+
+    (connection.tables - UNSCOPED_TABLES).each do |table|
+      account_id = connection.columns(table).find { it.name == "account_id" }
+
+      assert account_id, "#{table} is missing account_id"
+      assert_not account_id.null, "#{table}.account_id must be required"
+      assert connection.indexes(table).any? { it.columns.first == "account_id" }, "#{table}.account_id must be indexed"
+    end
+  end
+end
diff --git a/test/models/active_storage_account_test.rb b/test/models/active_storage_account_test.rb
new file mode 100644
index 0000000..1b4e64c
--- /dev/null
+++ b/test/models/active_storage_account_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class ActiveStorageAccountTest < ActiveSupport::TestCase
+  test "attachments and their new blobs belong to the account of the record" do
+    Current.account = nil
+    card = cards(:radio)
+
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+    assert_equal accounts(:initech), card.image.attachment.account
+    assert_equal accounts(:initech), card.image.blob.account
+  end
+
+  test "variants belong to the account of their blob" do
+    Current.account = nil
+    user = users(:mike)
+
+    user.avatar.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    variant_record = user.avatar.blob.variant_records.sole
+
+    assert_equal accounts(:initech), variant_record.account
+    assert_equal accounts(:initech), variant_record.image.blob.account
+  end
+
+  test "blobs created on their own belong to the current account" do
+    blob = ActiveStorage::Blob.create_and_upload! io: StringIO.new("x"), filename: "x.txt"
+
+    assert_equal accounts("37s"), blob.account
+  end
+
+  test "rich texts belong to the account of their record" do
+    card = cards(:radio)
+    card.update!(description: "Hello")
+
+    assert_equal accounts(:initech), card.description.account
+  end
+end
