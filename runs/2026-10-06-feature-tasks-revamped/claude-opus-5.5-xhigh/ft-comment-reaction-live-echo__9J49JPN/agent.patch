new file mode 100644
index 0000000..63450c2
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,59 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.ordered.preloaded
+  end
+
+  def new
+    @reaction = Reaction.new
+  end
+
+  def create
+    @reaction = @comment.reactions.new(reaction_params)
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render status: :created }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { render :new, formats: :html, status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reactership
+      head :forbidden unless @reaction.reacter == Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..ccc9813
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,77 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Reactions are rendered inside the cached comment, which is shared by everyone, so whether
+// a reaction belongs to the current user (and can be removed by them) is decided here.
+export default class extends Controller {
+  static targets = [ "content", "deleteButton" ]
+  static classes = [ "deleteable", "expanded", "deleting" ]
+  static values = { reacterId: String }
+
+  #expanded = false
+
+  connect() {
+    this.restore()
+  }
+
+  toggle(event) {
+    if (this.#deleteable && !this.#isFromDeleteButton(event)) {
+      // The whole reaction toggles, including the avatar, which otherwise links to the reacter
+      event.preventDefault()
+      this.#expanded ? this.collapse() : this.expand()
+    }
+  }
+
+  expand() {
+    this.#expanded = true
+    this.restore()
+    this.deleteButtonTarget.focus()
+  }
+
+  collapse(event) {
+    if (this.#expanded) {
+      const hadFocus = this.element.contains(document.activeElement)
+
+      // Collapsing handles Esc, so it shouldn't also take you back to the board
+      event?.preventDefault()
+
+      this.#expanded = false
+      this.restore()
+
+      if (hadFocus) this.contentTarget.focus()
+    }
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.collapse()
+  }
+
+  delete() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  deleted({ detail: { success } }) {
+    if (!success) this.element.classList.remove(this.deletingClass)
+  }
+
+  // Page refreshes morph the element back to the shared markup, so state is re-applied after them
+  restore() {
+    const deleteable = this.#deleteable
+
+    this.element.classList.toggle(this.deleteableClass, deleteable)
+    this.element.classList.toggle(this.expandedClass, deleteable && this.#expanded)
+
+    if (deleteable) {
+      this.contentTarget.setAttribute("role", "button")
+      this.contentTarget.setAttribute("tabindex", "0")
+      this.contentTarget.setAttribute("aria-expanded", this.#expanded)
+    }
+  }
+
+  get #deleteable() {
+    return !!this.reacterIdValue && Current.user?.id === this.reacterIdValue
+  }
+
+  #isFromDeleteButton({ target }) {
+    return this.deleteButtonTarget.contains(target)
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..9a9b05e
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,48 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "input" ]
+  static values = { maxCharacters: { type: Number, default: 16 } }
+
+  insertEmoji({ currentTarget }) {
+    const input = this.inputTarget
+    const emoji = currentTarget.dataset.emoji
+    const start = input.selectionStart ?? input.value.length
+    const end = input.selectionEnd ?? input.value.length
+    const value = input.value.slice(0, start) + emoji + input.value.slice(end)
+
+    if (this.#countCharacters(value) <= this.maxCharactersValue) {
+      input.value = value
+      input.setSelectionRange(start + emoji.length, start + emoji.length)
+    }
+
+    this.focus()
+    this.validate()
+  }
+
+  validate() {
+    const input = this.inputTarget
+
+    if (this.#countCharacters(input.value) > this.maxCharactersValue) {
+      input.setCustomValidity(`Reactions can be up to ${this.maxCharactersValue} characters`)
+      input.reportValidity()
+    } else {
+      input.setCustomValidity("")
+    }
+  }
+
+  focus() {
+    this.inputTarget.focus()
+  }
+
+  // Count what people see as characters, so composed emoji (👍🏽, 👨‍👩‍👧) count as one, matching the server
+  #countCharacters(text) {
+    const normalized = text.trim().replace(/\s+/g, " ")
+
+    if (typeof Intl.Segmenter === "function") {
+      return Array.from(new Intl.Segmenter().segment(normalized)).length
+    } else {
+      return Array.from(normalized).length
+    }
+  }
+}
