@@ -0,0 +1,26 @@
+class Reaction < ApplicationRecord
+  MAX_CHARACTERS = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: -> { it.squish }
+
+  validates :content, presence: true
+  validate :content_is_short
+
+  scope :ordered, -> { order(:created_at, :id) }
+  scope :preloaded, -> { preload(reacter: :account) }
+
+  delegate :card, to: :comment
+  delegate :all_emoji?, to: :content
+
+  private
+    # Count what people see as characters, so that composed emoji (👍🏽, 👨‍👩‍👧) count as one
+    def content_is_short
+      if content && content.grapheme_clusters.size > MAX_CHARACTERS
+        errors.add :content, :too_long, count: MAX_CHARACTERS
+      end
+    end
+end
