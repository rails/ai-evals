@@ -0,0 +1,44 @@
+<%= form_with model: reaction, url: card_comment_reactions_path(comment.card, comment), class: "reaction reaction__form expanded",
+      data: { controller: "form reaction-form morph-guard",
+              reaction_form_max_characters_value: Reaction::MAX_CHARACTERS,
+              action: "submit->form#preventEmptySubmit submit->form#preventComposingSubmit keydown.esc->form#cancel:stop" } do |form| %>
+  <%= form.label :content, for: dom_id(comment, :reaction_content), class: "reaction__form-label reaction__avatar" do %>
+    <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true, class: "btn btn--circle" %>
+    <span class="for-screen-reader">Your reaction, up to <%= Reaction::MAX_CHARACTERS %> characters</span>
+  <% end %>
+
+  <%= form.text_field :content, id: dom_id(comment, :reaction_content), class: "input reaction__input",
+        required: true, autofocus: true, autocomplete: "off",
+        aria: { invalid: reaction.errors.any? || nil }, title: reaction.errors.full_messages.to_sentence.presence,
+        data: { form_target: "input", reaction_form_target: "input", "1p-ignore": "true",
+                validation_message: "Add an emoji or a few words",
+                action: "input->reaction-form#validate compositionstart->form#compositionStart compositionend->form#compositionEnd" } %>
+
+  <div class="reaction__menu" data-controller="dialog" data-action="click@document->dialog#closeOnClickOutside">
+    <button type="button" class="reaction__menu-btn btn btn--circle borderless" title="Pick an emoji" data-action="dialog#toggle">
+      <%= icon_tag "reaction" %>
+      <span class="for-screen-reader">Pick an emoji</span>
+    </button>
+
+    <dialog class="reaction__popup popup popup--align-right panel fill-white shadow" aria-label="Emoji"
+        data-dialog-target="dialog" data-action="keydown.esc->dialog#close:stop keydown.esc->reaction-form#focus">
+      <div class="reaction__emoji-list">
+        <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+          <button type="button" class="btn btn--plain" title="<%= name %>" aria-label="<%= name %>"
+              data-emoji="<%= emoji %>" data-action="reaction-form#insertEmoji dialog#close"><%= emoji %></button>
+        <% end %>
+      </div>
+    </dialog>
+  </div>
+
+  <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle borderless", title: "Add reaction (#{hotkey_label([ "enter" ])})" do %>
+    <%= icon_tag "check" %>
+    <span class="for-screen-reader">Add reaction</span>
+  <% end %>
+
+  <%= link_to card_comment_reactions_path(comment.card, comment), class: "reaction__cancel-btn btn btn--circle borderless",
+        title: "Cancel (#{hotkey_label([ "esc" ])})", data: { form_target: "cancel" } do %>
+    <%= icon_tag "close" %>
+    <span class="for-screen-reader">Cancel</span>
+  <% end %>
+<% end %>
