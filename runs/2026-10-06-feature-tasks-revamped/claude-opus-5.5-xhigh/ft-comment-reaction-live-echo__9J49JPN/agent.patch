+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "comments show their reactions with who left them and a button to add one" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment)} turbo-frame##{dom_id(@comment, :reacting)}.reactions" do
+      assert_select ".reaction", count: 2
+      assert_select "##{dom_id(reactions(:kevin))}[title=?][data-reaction-reacter-id-value=?]", "Kevin", users(:kevin).id, text: /👍/ do
+        assert_select ".reaction__avatar img[title=?]", "Kevin"
+      end
+      assert_select "##{dom_id(reactions(:david))}", text: /Great work!/
+      assert_select "a.reactions__trigger[href=?]", new_card_comment_reaction_path(@card, @comment)
+      assert_select ".reactions__trigger img[src*=boost-color]"
+    end
+  end
+
+  test "cached comments show reactions as they're left, with no per-person markup" do
+    with_actionview_partial_caching do
+      get card_path(@card)
+      assert_select "##{dom_id(@comment)} .reaction", count: 2
+
+      reaction = Current.set(session: sessions(:jz)) { @comment.reactions.create!(content: "🙌") }
+
+      get card_path(@card)
+      assert_select "##{dom_id(@comment)} .reactions__list" do
+        assert_select ".reaction", count: 3
+        assert_select "##{dom_id(reaction)}", text: /🙌/
+      end
+      assert_select ".reaction--deleteable, .reaction.expanded", count: 0
+    end
+  end
+
+  test "system comments don't take reactions" do
+    get card_path(@card)
+
+    assert_select "##{dom_id(comments(:logo_1))} .reactions", count: 0
+  end
+
+  test "new turns the button into an input with confirm and cancel" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :reacting)}" do
+      assert_select ".reactions__list .reaction", count: 2
+      assert_select ".reactions__trigger", count: 0
+      assert_select "form.reaction__form[action=?]", card_comment_reactions_path(@card, @comment) do
+        assert_select "input.reaction__input[name=?][required]", "reaction[content]"
+        assert_select "button.reaction__submit-btn[type=submit]"
+        assert_select "a.reaction__cancel-btn[href=?]", card_comment_reactions_path(@card, @comment)
+        assert_select ".reaction__emoji-list button[data-emoji]", count: EmojiHelper::REACTIONS.size
+      end
+    end
+  end
+
+  test "index shows the strip with the button, as when canceling" do
+    get card_comment_reactions_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :reacting)}" do
+      assert_select ".reaction", count: 2
+      assert_select ".reactions__trigger"
+      assert_select "form.reaction__form", count: 0
+    end
+  end
+
+  test "create puts the reaction in the strip, removes the input and brings the button back" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Ship it! 🚀" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.ordered.last
+    assert_equal users(:kevin), reaction.reacter
+
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reacting) do
+      assert_select "turbo-frame##{dom_id(@comment, :reacting)}" do
+        assert_select ".reaction", count: 3
+        assert_select ".reactions__list > .reaction:last-child##{dom_id(reaction)}", text: /Ship it! 🚀/
+        assert_select ".reactions__trigger"
+        assert_select "form.reaction__form", count: 0
+        assert_select "input[type=text]", count: 0
+      end
+    end
+  end
+
+  test "create with content that's too long keeps the input open" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "This is far too long" } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+    assert_select "turbo-frame##{dom_id(@comment, :reacting)} form.reaction__form" do
+      assert_select "input.reaction__input[value=?][aria-invalid=true]", "This is far too long"
+    end
+  end
+
+  test "create on a card without access" do
+    logout_and_sign_in_as :jason
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "destroy your own reaction" do
+    reaction = reactions(:kevin)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "destroy someone else's reaction is forbidden" do
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, @comment, reactions(:david)), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal [ reactions(:kevin), reactions(:david) ].sort_by(&:created_at).map(&:id), @response.parsed_body.pluck("id")
+
+    json = @response.parsed_body.find { it["id"] == reactions(:kevin).id }
+    assert_equal "👍", json["content"]
+    assert_equal users(:kevin).id, json.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, reactions(:kevin)), json["url"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Great 👍", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "🙌" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "🙌", @comment.reactions.ordered.last.content
+  end
+
+  test "create as JSON with invalid content" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "x" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+    assert_equal [ "is too long (maximum is 16 characters)" ], @response.parsed_body["content"]
+  end
+
+  test "destroy as JSON" do
+    delete card_comment_reaction_path(@card, @comment, reactions(:kevin)), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reactions(:kevin).id)
+  end
+
+  test "destroy someone else's reaction as JSON is forbidden" do
+    delete card_comment_reaction_path(@card, @comment, reactions(:david)), as: :json
+
+    assert_response :forbidden
+    assert Reaction.exists?(reactions(:david).id)
+  end
+
+  test "comment JSON links to its reactions" do
+    get card_comment_path(@card, @comment), as: :json
+
+    assert_equal card_comment_reactions_url(@card, @comment), @response.parsed_body["reactions_url"]
+  end
+end
